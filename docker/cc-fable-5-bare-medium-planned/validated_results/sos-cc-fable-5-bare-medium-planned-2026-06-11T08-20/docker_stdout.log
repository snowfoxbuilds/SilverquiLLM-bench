{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PR2m7ASyZxMBCBsnozDFVG","type":"tool_result","content":"1\t\"\"\"Game setup, helper actions, and the full game loop.\n2\t\n3\tProvides the top-level functions for creating, running, and interacting with\n4\ta game of Magic: The Gathering:\n5\t\n6\t- :func:`create_game` — initialise a full game state for two players.\n7\t- Helper actions — module-level functions for common game operations\n8\t  (``deal_damage``, ``destroy``, ``sacrifice``, ``exile``, ``draw_card``,\n9\t  ``discard``, ``create_token``, ``add_counter``, ``remove_counter``,\n10\t  ``tap``, ``untap``).\n11\t- :func:`run_game` — execute turns until the game ends, returning the winner.\n12\t\"\"\"\n13\t\n14\tfrom __future__ import annotations\n15\t\n16\tfrom typing import TYPE_CHECKING, Any\n17\t\n18\tfrom engine.events import (\n19\t    CreatureDiesReplacementEvent,\n20\t    DealsDamageTriggeredEvent,\n21\t    DrawsCardTriggeredEvent,\n22\t    EntersBattlefieldTriggeredEvent,\n23\t    GainsLifeTriggeredEvent,\n24\t    LosesLifeTriggeredEvent,\n25\t    PermanentDestroyedReplacementEvent,\n26\t    SacrificeReplacementEvent,\n27\t)\n28\tfrom engine.game_state import GameState\n29\tfrom engine.turn import run_turn\n30\tfrom engine.types import Zone\n31\tfrom engine.zones import move_to_zone\n32\t\n33\tif TYPE_CHECKING:\n34\t    from engine.card import CardImpl, Creature\n35\t    from engine.player import Player\n36\t\n37\t\n38\t# Maximum number of turns before the game is considered a draw.\n39\t# Prevents infinite loops in deterministic or stuck game states.\n40\tMAX_TURNS: int = 1000\n41\t\n42\t\n43\t# ---------------------------------------------------------------------------\n44\t# Game creation\n45\t# ---------------------------------------------------------------------------\n46\t\n47\tdef create_game(\n48\t    player1: Player,\n49\t    player2: Player,\n50\t    deck1: list[CardImpl],\n51\t    deck2: list[CardImpl],\n52\t) -> GameState:\n53\t    \"\"\"Create and initialise a new two-player game.\n54\t\n55\t    Steps performed:\n56\t\n57\t    1. Set each player's life total to 20.\n58\t    2. Place *deck1* / *deck2* into the respective player's library zone.\n59\t    3. Shuffle each library.\n60\t    4. Draw 7 cards for each player.\n61\t    5. Set the active player to *player1*.\n62\t\n63\t    Card ownership is set so that each card's ``owner`` and ``controller``\n64\t    point to the player whose deck it came from.\n65\t\n66\t    Parameters:\n67\t        player1: The first player (goes first).\n68\t        player2: The second player.\n69\t        deck1: Cards comprising player1's deck.\n70\t        deck2: Cards comprising player2's deck.\n71\t\n72\t    Returns:\n73\t        A fully initialised :class:`GameState` ready for play.\n74\t    \"\"\"\n75\t    # 1. Set life totals\n76\t    player1.life = 20\n77\t    player2.life = 20\n78\t\n79\t    # 2. Place deck cards into libraries and set ownership\n80\t    library1 = player1.zones[Zone.LIBRARY]\n81\t    for card in deck1:\n82\t        card.owner = player1\n83\t        card.controller = player1\n84\t        library1.add(card)\n85\t\n86\t    library2 = player2.zones[Zone.LIBRARY]\n87\t    for card in deck2:\n88\t        card.owner = player2\n89\t        card.controller = player2\n90\t        library2.add(card)\n91\t\n92\t    # 3. Shuffle libraries\n93\t    library1.shuffle()\n94\t    library2.shuffle()\n95\t\n96\t    # Build the game state\n97\t    game = GameState([player1, player2])\n98\t\n99\t    # 4. Draw 7 cards each\n100\t    for _ in range(7):\n101\t        draw_card(game, player1)\n102\t    for _ in range(7):\n103\t        draw_card(game, player2)\n104\t\n105\t    # 5. Active player is player1 (index 0 — already the default)\n106\t    game.active_player_index = 0\n107\t    game.priority_player_index = 0\n108\t\n109\t    return game\n110\t\n111\t\n112\t# ---------------------------------------------------------------------------\n113\t# Common helper actions\n114\t# ---------------------------------------------------------------------------\n115\t\n116\tdef deal_damage(game: GameState, source: Any, target: Any, amount: int) -> None:\n117\t    \"\"\"Deal *amount* damage from *source* to *target*.\n118\t\n119\t    If *target* has a ``life`` attribute (i.e. is a player), life is reduced.\n120\t    If *target* has a ``damage_marked`` attribute (i.e. is a creature),\n121\t    damage is marked on it.\n122\t\n123\t    Fires :attr:`EventType.DEALS_DAMAGE` via the trigger manager.\n124\t\n125\t    Parameters:\n126\t        game: The current game state.\n127\t        source: The object dealing the damage.\n128\t        target: The player or creature receiving the damage.\n129\t        amount: The amount of damage to deal (must be > 0 to have effect).\n130\t    \"\"\"\n131\t    if amount <= 0:\n132\t        return\n133\t\n134\t    from engine.protection import has_protection_from\n135\t    from engine.types import Keyword\n136\t\n137\t    # Protection prevents damage from sources with the protected-from quality.\n138\t    if has_protection_from(target, source):\n139\t        return\n140\t\n141\t    if hasattr(target, \"life\"):\n142\t        # Target is a player\n143\t        target.life -= amount\n144\t        # Fire damage trigger\n145\t        game.trigger_manager.fire_event(\n146\t            game,\n147\t            DealsDamageTriggeredEvent(source=source, target=target, amount=amount),\n148\t        )\n149\t        # Fire loses-life trigger\n150\t        game.trigger_manager.fire_event(\n151\t            game,\n152\t            LosesLifeTriggeredEvent(player=target, amount=amount),\n153\t        )\n154\t    elif hasattr(target, \"damage_marked\"):\n155\t        # Target is a creature\n156\t        target.damage_marked += amount\n157\t\n158\t        # Track deathtouch damage for SBA rule 704.5h\n159\t        source_kw = getattr(source, \"keywords\", Keyword(0))\n160\t        if Keyword.DEATHTOUCH in source_kw:\n161\t            target.dealt_deathtouch_damage = True\n162\t\n163\t        # Fire damage trigger\n164\t        game.trigger_manager.fire_event(\n165\t            game,\n166\t            DealsDamageTriggeredEvent(source=source, target=target, amount=amount),\n167\t        )\n168\t\n169\t    # Lifelink: controller of source gains life equal to damage dealt\n170\t    source_kw = getattr(source, \"keywords\", Keyword(0))\n171\t    if Keyword.LIFELINK in source_kw:\n172\t        controller = getattr(source, \"controller\", None)\n173\t        if controller is not None and hasattr(controller, \"life\"):\n174\t            controller.life += amount\n175\t\n176\t\n177\tdef destroy(game: GameState, permanent: Any) -> None:\n178\t    \"\"\"Destroy *permanent* — move it from the battlefield to its owner's graveyard.\n179\t\n180\t    Respects replacement effects via :func:`move_to_zone`.\n181\t    Creatures with the ``INDESTRUCTIBLE`` keyword are not destroyed.\n182\t\n183\t    Parameters:\n184\t        game: The current game state.\n185\t        permanent: The permanent to destroy.\n186\t    \"\"\"\n187\t    from engine.types import Keyword\n188\t\n189\t    # Indestructible permanents cannot be destroyed\n190\t    kw = getattr(permanent, \"keywords\", Keyword(0))\n191\t    if Keyword.INDESTRUCTIBLE in kw:\n192\t        return\n193\t\n194\t    controller = getattr(permanent, \"controller\", None)\n195\t    if controller is None:\n196\t        # Fallback: find which player's battlefield contains it\n197\t        for player in game.players:\n198\t            bf = game.get_battlefield(player)\n199\t            if bf.contains(permanent):\n200\t                controller = player\n201\t                break\n202\t    if controller is None:\n203\t        return\n204\t\n205\t    bf = game.get_battlefield(controller)\n206\t    if not bf.contains(permanent):\n207\t        return\n208\t\n209\t    from engine.types import CardType\n210\t\n211\t    card_types = getattr(permanent, \"card_types\", set())\n212\t    is_creature = CardType.CREATURE in card_types\n213\t    owner = getattr(permanent, \"owner\", controller)\n214\t\n215\t    if is_creature:\n216\t        repl_event: CreatureDiesReplacementEvent | PermanentDestroyedReplacementEvent = (\n217\t            CreatureDiesReplacementEvent(\n218\t                creature=permanent, destination=\"graveyard\",\n219\t                controller=controller, owner=owner,\n220\t            )\n221\t        )\n222\t    else:\n223\t        repl_event = PermanentDestroyedReplacementEvent(\n224\t            permanent=permanent, destination=\"graveyard\",\n225\t            controller=controller, owner=owner,\n226\t        )\n227\t\n228\t    move_to_zone(\n229\t        game,\n230\t        permanent,\n231\t        Zone.BATTLEFIELD,\n232\t        Zone.GRAVEYARD,\n233\t        replacement_event=repl_event,\n234\t    )\n235\t\n236\t\n237\tdef sacrifice(game: GameState, player: Player, permanent: Any) -> None:\n238\t    \"\"\"Sacrifice *permanent* — move it from the battlefield to its owner's graveyard.\n239\t\n240\t    Sacrificing cannot be prevented by indestructible or regeneration, but\n241\t    replacement effects that modify zone changes (e.g. \"if this would be\n242\t    put into a graveyard, exile it instead\") still apply via\n243\t    :func:`move_to_zone`.\n244\t\n245\t    Parameters:\n246\t        game: The current game state.\n247\t        player: The player performing the sacrifice.\n248\t        permanent: The permanent to sacrifice.\n249\t    \"\"\"\n250\t    bf = game.get_battlefield(player)\n251\t    if not bf.contains(permanent):\n252\t        return\n253\t\n254\t    owner = getattr(permanent, \"owner\", player)\n255\t    move_to_zone(\n256\t        game,\n257\t        permanent,\n258\t        Zone.BATTLEFIELD,\n259\t        Zone.GRAVEYARD,\n260\t        replacement_event=SacrificeReplacementEvent(\n261\t            permanent=permanent, destination=\"graveyard\",\n262\t            controller=player, owner=owner,\n263\t        ),\n264\t    )\n265\t\n266\t\n267\tdef exile(game: GameState, obj: Any) -> None:\n268\t    \"\"\"Exile *obj* — move it to its owner's exile zone.\n269\t\n270\t    Works for objects on the battlefield, in the graveyard, on the stack,\n271\t    or in hand.\n272\t\n273\t    Parameters:\n274\t        game: The current game state.\n275\t        obj: The game object to exile.\n276\t    \"\"\"\n277\t    # Find which zone the object is currently in\n278\t    source_zone_type = None\n279\t    for player in game.players:\n280\t        for zone_type in Zone:\n281\t            zone = player.zones[zone_type]\n282\t            if zone.contains(obj):\n283\t                source_zone_type = zone_type\n284\t                break\n285\t        if source_zone_type is not None:\n286\t            break\n287\t\n288\t    if source_zone_type is None:\n289\t        return\n290\t\n291\t    move_to_zone(game, obj, source_zone_type, Zone.EXILE)\n292\t\n293\t\n294\tdef draw_card(game: GameState, player: Player) -> Any | None:\n295\t    \"\"\"Draw a card for *player* — move the top card of library to hand.\n296\t\n297\t    If the library is empty, sets ``player.drawn_from_empty_library = True``\n298\t    (SBAs will handle the game loss).\n299\t\n300\t    Fires :attr:`EventType.DRAWS_CARD` via the trigger manager.\n301\t\n302\t    Parameters:\n303\t        game: The current game state.\n304\t        player: The player drawing a card.\n305\t\n306\t    Returns:\n307\t        The drawn card, or ``None`` if the library was empty.\n308\t    \"\"\"\n309\t    library = player.zones[Zone.LIBRARY]\n310\t\n311\t    if len(library) == 0:\n312\t        player.drawn_from_empty_library = True\n313\t        return None\n314\t\n315\t    # Top of library is the last element (index -1)\n316\t    cards = library.top(1)\n317\t    card = cards[0]\n318\t    library.remove(card)\n319\t\n320\t    hand = player.zones[Zone.HAND]\n321\t    hand.add(card)\n322\t\n323\t    # Track cards drawn this turn\n324\t    if not hasattr(player, \"cards_drawn_this_turn\"):\n325\t        player.cards_drawn_this_turn = 0\n326\t    player.cards_drawn_this_turn += 1\n327\t\n328\t    # Fire trigger (only if game has a trigger_manager — may not during setup)\n329\t    if hasattr(game, \"trigger_manager\"):\n330\t        game.trigger_manager.fire_event(\n331\t            game,\n332\t            DrawsCardTriggeredEvent(player=player, card=card),\n333\t        )\n334\t\n335\t    return card\n336\t\n337\t\n338\tdef discard(game: GameState, player: Player, card: Any) -> None:\n339\t    \"\"\"Discard *card* from *player*'s hand to the owner's graveyard.\n340\t\n341\t    Parameters:\n342\t        game: The current game state.\n343\t        player: The player discarding.\n344\t        card: The card to discard (must be in the player's hand).\n345\t    \"\"\"\n346\t    hand = game.get_hand(player)\n347\t    if not hand.contains(card):\n348\t        return\n349\t\n350\t    move_to_zone(game, card, Zone.HAND, Zone.GRAVEYARD)\n351\t\n352\t\n353\tdef create_token(game: GameState, player: Player, token: Any) -> None:\n354\t    \"\"\"Create a token on the battlefield under *player*'s control.\n355\t\n356\t    Sets ``is_token = True`` on the token, along with ``owner`` and\n357\t    ``controller``.  Uses :func:`move_to_zone` for entering-battlefield\n358\t    hooks (trigger/replacement-effect registration and ETB event).\n359\t\n360\t    Parameters:\n361\t        game: The current game state.\n362\t        player: The player who controls the token.\n363\t        token: The token object to place on the battlefield.\n364\t    \"\"\"\n365\t    token.is_token = True\n366\t    token.owner = player\n367\t    token.controller = player\n368\t\n369\t    # Tokens don't come from an existing zone — add directly and fire hooks.\n370\t    # Ordering matches move_to_zone: fire ETB *before* registering the token's\n371\t    # own triggers so a token's ETB trigger doesn't self-fire on entry.\n372\t    battlefield = game.get_battlefield(player)\n373\t    battlefield.add(token)\n374\t\n375\t    game.trigger_manager.fire_event(\n376\t        game,\n377\t        EntersBattlefieldTriggeredEvent(permanent=token, controller=player),\n378\t    )\n379\t\n380\t    # Register triggers/replacement effects after the ETB event.\n381\t    if hasattr(token, \"register_triggers\"):\n382\t        token.register_triggers(game)\n383\t    if hasattr(token, \"register_replacement_effects\"):\n384\t        token.register_replacement_effects(game)\n385\t\n386\t\n387\tdef add_counter(\n388\t    game: GameState,\n389\t    permanent: Any,\n390\t    counter_type: str,\n391\t    amount: int = 1,\n392\t) -> None:\n393\t    \"\"\"Add *amount* counters of *counter_type* to *permanent*.\n394\t\n395\t    Supports ``\"+1/+1\"`` and ``\"-1/-1\"`` counter types via the\n396\t    ``plus_one_counters`` / ``minus_one_counters`` attributes.  For other\n397\t    counter types, uses a generic ``counters`` dict.\n398\t\n399\t    Parameters:\n400\t        game: The current game state.\n401\t        permanent: The permanent to add counters to.\n402\t        counter_type: The type of counter (e.g. ``\"+1/+1\"``, ``\"-1/-1\"``,\n403\t            ``\"loyalty\"``, ``\"charge\"``).\n404\t        amount: Number of counters to add (default 1).\n405\t    \"\"\"\n406\t    if amount <= 0:\n407\t        return\n408\t\n409\t    if counter_type == \"+1/+1\" and hasattr(permanent, \"plus_one_counters\"):\n410\t        permanent.plus_one_counters += amount\n411\t    elif counter_type == \"-1/-1\" and hasattr(permanent, \"minus_one_counters\"):\n412\t        permanent.minus_one_counters += amount\n413\t    elif counter_type == \"loyalty\" and hasattr(permanent, \"loyalty\"):\n414\t        permanent.loyalty += amount\n415\t    else:\n416\t        # Generic counter storage\n417\t        if not hasattr(permanent, \"counters\"):\n418\t            permanent.counters = {}\n419\t        permanent.counters[counter_type] = permanent.counters.get(counter_type, 0) + amount\n420\t\n421\t\n422\tdef remove_counter(\n423\t    game: GameState,\n424\t    permanent: Any,\n425\t    counter_type: str,\n426\t    amount: int = 1,\n427\t) -> None:\n428\t    \"\"\"Remove *amount* counters of *counter_type* from *permanent*.\n429\t\n430\t    Will not reduce below zero.\n431\t\n432\t    Parameters:\n433\t        game: The current game state.\n434\t        permanent: The permanent to remove counters from.\n435\t        counter_type: The type of counter to remove.\n436\t        amount: Number of counters to remove (default 1).\n437\t    \"\"\"\n438\t    if amount <= 0:\n439\t        return\n440\t\n441\t    if counter_type == \"+1/+1\" and hasattr(permanent, \"plus_one_counters\"):\n442\t        permanent.plus_one_counters = max(0, permanent.plus_one_counters - amount)\n443\t    elif counter_type == \"-1/-1\" and hasattr(permanent, \"minus_one_counters\"):\n444\t        permanent.minus_one_counters = max(0, permanent.minus_one_counters - amount)\n445\t    elif counter_type == \"loyalty\" and hasattr(permanent, \"loyalty\"):\n446\t        permanent.loyalty = max(0, permanent.loyalty - amount)\n447\t    else:\n448\t        if hasattr(permanent, \"counters\") and counter_type in permanent.counters:\n449\t            permanent.counters[counter_type] = max(\n450\t                0, permanent.counters[counter_type] - amount\n451\t            )\n452\t\n453\t\n454\tdef tap(game: GameState, permanent: Any) -> None:\n455\t    \"\"\"Tap *permanent* — set ``is_tapped = True``.\n456\t\n457\t    Parameters:\n458\t        game: The current game state.\n459\t        permanent: The permanent to tap.\n460\t    \"\"\"\n461\t    if hasattr(permanent, \"is_tapped\"):\n462\t        permanent.is_tapped = True\n463\t\n464\t\n465\tdef untap(game: GameState, permanent: Any) -> None:\n466\t    \"\"\"Untap *permanent* — set ``is_tapped = False``.\n467\t\n468\t    Parameters:\n469\t        game: The current game state.\n470\t        permanent: The permanent to untap.\n471\t    \"\"\"\n472\t    if hasattr(permanent, \"is_tapped\"):\n473\t        permanent.is_tapped = False\n474\t\n475\t\n476\t# ---------------------------------------------------------------------------\n477\t# Game loop\n478\t# ---------------------------------------------------------------------------\n479\t\n480\tdef run_game(game: GameState) -> Player | None:\n481\t    \"\"\"Run the game loop until the game ends.\n482\t\n483\t    Executes :func:`~engine.turn.run_turn` in a loop, checking\n484\t    :attr:`GameState.is_game_over` after each turn.  State-based actions\n485\t    are resolved before and after each turn to catch game-ending conditions\n486\t    even when the priority loop auto-passes.\n487\t\n488\t    Includes a safety limit of :data:`MAX_TURNS` to prevent infinite loops\n489\t    in deterministic or stuck game states.\n490\t\n491\t    Parameters:\n492\t        game: The game state to run.\n493\t\n494\t    Returns:\n495\t        The winning player, or ``None`` if the game ended in a draw (or\n496\t        hit the turn limit).\n497\t    \"\"\"\n498\t    from engine.state_based_actions import resolve_state_based_actions\n499\t\n500\t    while not game.is_game_over and game.turn_number <= MAX_TURNS:\n501\t        # Check SBAs before the turn (catches pre-existing conditions)\n502\t        resolve_state_based_actions(game)\n503\t        _check_game_over(game)\n504\t        if game.is_game_over:\n505\t            break\n506\t\n507\t        run_turn(game)\n508\t\n509\t        # Check SBAs after the turn\n510\t        resolve_state_based_actions(game)\n511\t        _check_game_over(game)\n512\t\n513\t    return game.winner\n514\t\n515\t\n516\tdef _check_game_over(game: GameState) -> None:\n517\t    \"\"\"Check whether the game has ended and update ``game.is_game_over`` / ``game.winner``.\n518\t\n519\t    The game ends when:\n520\t    - One player has lost (``has_lost``): the other player wins.\n521\t    - Both players have lost: the game is a draw (``winner = None``).\n522\t    - The turn limit is exceeded: the game is a draw.\n523\t    \"\"\"\n524\t    lost_players = [p for p in game.players if p.has_lost]\n525\t\n526\t    if len(lost_players) == len(game.players):\n527\t        # All players have lost — draw\n528\t        game.is_game_over = True\n529\t        game.winner = None\n530\t    elif len(lost_players) == 1:\n531\t        # One player lost — the other wins\n532\t        game.is_game_over = True\n533\t        game.winner = [p for p in game.players if not p.has_lost][0]\n534\t    elif game.turn_number > MAX_TURNS:\n535\t        # Turn limit exceeded — draw\n536\t        game.is_game_over = True\n537\t        game.winner = None\n538\t"}]},"parent_tool_use_id":null,"session_id":"e89db2fe-0d6e-4510-b5e6-a7586e7fc62b","uuid":"cbafb1d9-5ba0-48a2-a03a-533d0eb5e1d5","timestamp":"2026-06-11T08:21:09.314Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/game.py","content":"\"\"\"Game setup, helper actions, and the full game loop.\n\nProvides the top-level functions for creating, running, and interacting with\na game of Magic: The Gathering:\n\n- :func:`create_game` — initialise a full game state for two players.\n- Helper actions — module-level functions for common game operations\n  (``deal_damage``, ``destroy``, ``sacrifice``, ``exile``, ``draw_card``,\n  ``discard``, ``create_token``, ``add_counter``, ``remove_counter``,\n  ``tap``, ``untap``).\n- :func:`run_game` — execute turns until the game ends, returning the winner.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.events import (\n    CreatureDiesReplacementEvent,\n    DealsDamageTriggeredEvent,\n    DrawsCardTriggeredEvent,\n    EntersBattlefieldTriggeredEvent,\n    GainsLifeTriggeredEvent,\n    LosesLifeTriggeredEvent,\n    PermanentDestroyedReplacementEvent,\n    SacrificeReplacementEvent,\n)\nfrom engine.game_state import GameState\nfrom engine.turn import run_turn\nfrom engine.types import Zone\nfrom engine.zones import move_to_zone\n\nif TYPE_CHECKING:\n    from engine.card import CardImpl, Creature\n    from engine.player import Player\n\n\n# Maximum number of turns before the game is considered a draw.\n# Prevents infinite loops in deterministic or stuck game states.\nMAX_TURNS: int = 1000\n\n\n# ---------------------------------------------------------------------------\n# Game creation\n# ---------------------------------------------------------------------------\n\ndef create_game(\n    player1: Player,\n    player2: Player,\n    deck1: list[CardImpl],\n    deck2: list[CardImpl],\n) -> GameState:\n    \"\"\"Create and initialise a new two-player game.\n\n    Steps performed:\n\n    1. Set each player's life total to 20.\n    2. Place *deck1* / *deck2* into the respective player's library zone.\n    3. Shuffle each library.\n    4. Draw 7 cards for each player.\n    5. Set the active player to *player1*.\n\n    Card ownership is set so that each card's ``owner`` and ``controller``\n    point to the player whose deck it came from.\n\n    Parameters:\n        player1: The first player (goes first).\n        player2: The second player.\n        deck1: Cards comprising player1's deck.\n        deck2: Cards comprising player2's deck.\n\n    Returns:\n        A fully initialised :class:`GameState` ready for play.\n    \"\"\"\n    # 1. Set life totals\n    player1.life = 20\n    player2.life = 20\n\n    # 2. Place deck cards into libraries and set ownership\n    library1 = player1.zones[Zone.LIBRARY]\n    for card in deck1:\n        card.owner = player1\n        card.controller = player1\n        library1.add(card)\n\n    library2 = player2.zones[Zone.LIBRARY]\n    for card in deck2:\n        card.owner = player2\n        card.controller = player2\n        library2.add(card)\n\n    # 3. Shuffle libraries\n    library1.shuffle()\n    library2.shuffle()\n\n    # Build the game state\n    game = GameState([player1, player2])\n\n    # 4. Draw 7 cards each\n    for _ in range(7):\n        draw_card(game, player1)\n    for _ in range(7):\n        draw_card(game, player2)\n\n    # 5. Active player is player1 (index 0 — already the default)\n    game.active_player_index = 0\n    game.priority_player_index = 0\n\n    return game\n\n\n# ---------------------------------------------------------------------------\n# Common helper actions\n# ---------------------------------------------------------------------------\n\ndef deal_damage(game: GameState, source: Any, target: Any, amount: int) -> None:\n    \"\"\"Deal *amount* damage from *source* to *target*.\n\n    If *target* has a ``life`` attribute (i.e. is a player), life is reduced.\n    If *target* has a ``damage_marked`` attribute (i.e. is a creature),\n    damage is marked on it.\n\n    Fires :attr:`EventType.DEALS_DAMAGE` via the trigger manager.\n\n    Parameters:\n        game: The current game state.\n        source: The object dealing the damage.\n        target: The player or creature receiving the damage.\n        amount: The amount of damage to deal (must be > 0 to have effect).\n    \"\"\"\n    if amount <= 0:\n        return\n\n    from engine.protection import has_protection_from\n    from engine.types import Keyword\n\n    # Protection prevents damage from sources with the protected-from quality.\n    if has_protection_from(target, source):\n        return\n\n    if hasattr(target, \"life\"):\n        # Target is a player\n        target.life -= amount\n        # Fire damage trigger\n        game.trigger_manager.fire_event(\n            game,\n            DealsDamageTriggeredEvent(source=source, target=target, amount=amount),\n        )\n        # Fire loses-life trigger\n        game.trigger_manager.fire_event(\n            game,\n            LosesLifeTriggeredEvent(player=target, amount=amount),\n        )\n    elif hasattr(target, \"damage_marked\"):\n        # Target is a creature\n        target.damage_marked += amount\n\n        # Track deathtouch damage for SBA rule 704.5h\n        source_kw = getattr(source, \"keywords\", Keyword(0))\n        if Keyword.DEATHTOUCH in source_kw:\n            target.dealt_deathtouch_damage = True\n\n        # Fire damage trigger\n        game.trigger_manager.fire_event(\n            game,\n            DealsDamageTriggeredEvent(source=source, target=target, amount=amount),\n        )\n\n    # Lifelink: controller of source gains life equal to damage dealt\n    source_kw = getattr(source, \"keywords\", Keyword(0))\n    if Keyword.LIFELINK in source_kw:\n        controller = getattr(source, \"controller\", None)\n        if controller is not None and hasattr(controller, \"life\"):\n            controller.life += amount\n\n\ndef destroy(game: GameState, permanent: Any) -> None:\n    \"\"\"Destroy *permanent* — move it from the battlefield to its owner's graveyard.\n\n    Respects replacement effects via :func:`move_to_zone`.\n    Creatures with the ``INDESTRUCTIBLE`` keyword are not destroyed.\n\n    Parameters:\n        game: The current game state.\n        permanent: The permanent to destroy.\n    \"\"\"\n    from engine.types import Keyword\n\n    # Indestructible permanents cannot be destroyed\n    kw = getattr(permanent, \"keywords\", Keyword(0))\n    if Keyword.INDESTRUCTIBLE in kw:\n        return\n\n    controller = getattr(permanent, \"controller\", None)\n    if controller is None:\n        # Fallback: find which player's battlefield contains it\n        for player in game.players:\n            bf = game.get_battlefield(player)\n            if bf.contains(permanent):\n                controller = player\n                break\n    if controller is None:\n        return\n\n    bf = game.get_battlefield(controller)\n    if not bf.contains(permanent):\n        return\n\n    from engine.types import CardType\n\n    card_types = getattr(permanent, \"card_types\", set())\n    is_creature = CardType.CREATURE in card_types\n    owner = getattr(permanent, \"owner\", controller)\n\n    if is_creature:\n        repl_event: CreatureDiesReplacementEvent | PermanentDestroyedReplacementEvent = (\n            CreatureDiesReplacementEvent(\n                creature=permanent, destination=\"graveyard\",\n                controller=controller, owner=owner,\n            )\n        )\n    else:\n        repl_event = PermanentDestroyedReplacementEvent(\n            permanent=permanent, destination=\"graveyard\",\n            controller=controller, owner=owner,\n        )\n\n    move_to_zone(\n        game,\n        permanent,\n        Zone.BATTLEFIELD,\n        Zone.GRAVEYARD,\n        replacement_event=repl_event,\n    )\n\n\ndef sacrifice(game: GameState, player: Player, permanent: Any) -> None:\n    \"\"\"Sacrifice *permanent* — move it from the battlefield to its owner's graveyard.\n\n    Sacrificing cannot be prevented by indestructible or regeneration, but\n    replacement effects that modify zone changes (e.g. \"if this would be\n    put into a graveyard, exile it instead\") still apply via\n    :func:`move_to_zone`.\n\n    Parameters:\n        game: The current game state.\n        player: The player performing the sacrifice.\n        permanent: The permanent to sacrifice.\n    \"\"\"\n    bf = game.get_battlefield(player)\n    if not bf.contains(permanent):\n        return\n\n    owner = getattr(permanent, \"owner\", player)\n    move_to_zone(\n        game,\n        permanent,\n        Zone.BATTLEFIELD,\n        Zone.GRAVEYARD,\n        replacement_event=SacrificeReplacementEvent(\n            permanent=permanent, destination=\"graveyard\",\n            controller=player, owner=owner,\n        ),\n    )\n\n\ndef exile(game: GameState, obj: Any) -> None:\n    \"\"\"Exile *obj* — move it to its owner's exile zone.\n\n    Works for objects on the battlefield, in the graveyard, on the stack,\n    or in hand.\n\n    Parameters:\n        game: The current game state.\n        obj: The game object to exile.\n    \"\"\"\n    # Find which zone the object is currently in\n    source_zone_type = None\n    for player in game.players:\n        for zone_type in Zone:\n            zone = player.zones[zone_type]\n            if zone.contains(obj):\n                source_zone_type = zone_type\n                break\n        if source_zone_type is not None:\n            break\n\n    if source_zone_type is None:\n        return\n\n    move_to_zone(game, obj, source_zone_type, Zone.EXILE)\n\n\ndef draw_card(game: GameState, player: Player) -> Any | None:\n    \"\"\"Draw a card for *player* — move the top card of library to hand.\n\n    If the library is empty, sets ``player.drawn_from_empty_library = True``\n    (SBAs will handle the game loss).\n\n    Fires :attr:`EventType.DRAWS_CARD` via the trigger manager.\n\n    Parameters:\n        game: The current game state.\n        player: The player drawing a card.\n\n    Returns:\n        The drawn card, or ``None`` if the library was empty.\n    \"\"\"\n    library = player.zones[Zone.LIBRARY]\n\n    if len(library) == 0:\n        player.drawn_from_empty_library = True\n        return None\n\n    # Top of library is the last element (index -1)\n    cards = library.top(1)\n    card = cards[0]\n    library.remove(card)\n\n    hand = player.zones[Zone.HAND]\n    hand.add(card)\n\n    # Track cards drawn this turn\n    if not hasattr(player, \"cards_drawn_this_turn\"):\n        player.cards_drawn_this_turn = 0\n    player.cards_drawn_this_turn += 1\n\n    # Fire trigger (only if game has a trigger_manager — may not during setup)\n    if hasattr(game, \"trigger_manager\"):\n        game.trigger_manager.fire_event(\n            game,\n            DrawsCardTriggeredEvent(player=player, card=card),\n        )\n\n    return card\n\n\ndef discard(game: GameState, player: Player, card: Any) -> None:\n    \"\"\"Discard *card* from *player*'s hand to the owner's graveyard.\n\n    Parameters:\n        game: The current game state.\n        player: The player discarding.\n        card: The card to discard (must be in the player's hand).\n    \"\"\"\n    hand = game.get_hand(player)\n    if not hand.contains(card):\n        return\n\n    move_to_zone(game, card, Zone.HAND, Zone.GRAVEYARD)\n\n\ndef create_token(game: GameState, player: Player, token: Any) -> None:\n    \"\"\"Create a token on the battlefield under *player*'s control.\n\n    Sets ``is_token = True`` on the token, along with ``owner`` and\n    ``controller``.  Uses :func:`move_to_zone` for entering-battlefield\n    hooks (trigger/replacement-effect registration and ETB event).\n\n    Parameters:\n        game: The current game state.\n        player: The player who controls the token.\n        token: The token object to place on the battlefield.\n    \"\"\"\n    token.is_token = True\n    token.owner = player\n    token.controller = player\n\n    # Tokens don't come from an existing zone — add directly and fire hooks.\n    # Ordering matches move_to_zone: fire ETB *before* registering the token's\n    # own triggers so a token's ETB trigger doesn't self-fire on entry.\n    battlefield = game.get_battlefield(player)\n    battlefield.add(token)\n\n    game.trigger_manager.fire_event(\n        game,\n        EntersBattlefieldTriggeredEvent(permanent=token, controller=player),\n    )\n\n    # Register triggers/replacement effects after the ETB event.\n    if hasattr(token, \"register_triggers\"):\n        token.register_triggers(game)\n    if hasattr(token, \"register_replacement_effects\"):\n        token.register_replacement_effects(game)\n\n\ndef add_counter(\n    game: GameState,\n    permanent: Any,\n    counter_type: str,\n    amount: int = 1,\n) -> None:\n    \"\"\"Add *amount* counters of *counter_type* to *permanent*.\n\n    Supports ``\"+1/+1\"`` and ``\"-1/-1\"`` counter types via the\n    ``plus_one_counters`` / ``minus_one_counters`` attributes.  For other\n    counter types, uses a generic ``counters`` dict.\n\n    Parameters:\n        game: The current game state.\n        permanent: The permanent to add counters to.\n        counter_type: The type of counter (e.g. ``\"+1/+1\"``, ``\"-1/-1\"``,\n            ``\"loyalty\"``, ``\"charge\"``).\n        amount: Number of counters to add (default 1).\n    \"\"\"\n    if amount <= 0:\n        return\n\n    if counter_type == \"+1/+1\" and hasattr(permanent, \"plus_one_counters\"):\n        permanent.plus_one_counters += amount\n    elif counter_type == \"-1/-1\" and hasattr(permanent, \"minus_one_counters\"):\n        permanent.minus_one_counters += amount\n    elif counter_type == \"loyalty\" and hasattr(permanent, \"loyalty\"):\n        permanent.loyalty += amount\n    else:\n        # Generic counter storage\n        if not hasattr(permanent, \"counters\"):\n            permanent.counters = {}\n        permanent.counters[counter_type] = permanent.counters.get(counter_type, 0) + amount\n\n\ndef remove_counter(\n    game: GameState,\n    permanent: Any,\n    counter_type: str,\n    amount: int = 1,\n) -> None:\n    \"\"\"Remove *amount* counters of *counter_type* from *permanent*.\n\n    Will not reduce below zero.\n\n    Parameters:\n        game: The current game state.\n        permanent: The permanent to remove counters from.\n        counter_type: The type of counter to remove.\n        amount: Number of counters to remove (default 1).\n    \"\"\"\n    if amount <= 0:\n        return\n\n    if counter_type == \"+1/+1\" and hasattr(permanent, \"plus_one_counters\"):\n        permanent.plus_one_counters = max(0, permanent.plus_one_counters - amount)\n    elif counter_type == \"-1/-1\" and hasattr(permanent, \"minus_one_counters\"):\n        permanent.minus_one_counters = max(0, permanent.minus_one_counters - amount)\n    elif counter_type == \"loyalty\" and hasattr(permanent, \"loyalty\"):\n        permanent.loyalty = max(0, permanent.loyalty - amount)\n    else:\n        if hasattr(permanent, \"counters\") and counter_type in permanent.counters:\n            permanent.counters[counter_type] = max(\n                0, permanent.counters[counter_type] - amount\n            )\n\n\ndef tap(game: GameState, permanent: Any) -> None:\n    \"\"\"Tap *permanent* — set ``is_tapped = True``.\n\n    Parameters:\n        game: The current game state.\n        permanent: The permanent to tap.\n    \"\"\"\n    if hasattr(permanent, \"is_tapped\"):\n        permanent.is_tapped = True\n\n\ndef untap(game: GameState, permanent: Any) -> None:\n    \"\"\"Untap *permanent* — set ``is_tapped = False``.\n\n    Parameters:\n        game: The current game state.\n        permanent: The permanent to untap.\n    \"\"\"\n    if hasattr(permanent, \"is_tapped\"):\n        permanent.is_tapped = False\n\n\n# ---------------------------------------------------------------------------\n# Game loop\n# ---------------------------------------------------------------------------\n\ndef run_game(game: GameState) -> Player | None:\n    \"\"\"Run the game loop until the game ends.\n\n    Executes :func:`~engine.turn.run_turn` in a loop, checking\n    :attr:`GameState.is_game_over` after each turn.  State-based actions\n    are resolved before and after each turn to catch game-ending conditions\n    even when the priority loop auto-passes.\n\n    Includes a safety limit of :data:`MAX_TURNS` to prevent infinite loops\n    in deterministic or stuck game states.\n\n    Parameters:\n        game: The game state to run.\n\n    Returns:\n        The winning player, or ``None`` if the game ended in a draw (or\n        hit the turn limit).\n    \"\"\"\n    from engine.state_based_actions import resolve_state_based_actions\n\n    while not game.is_game_over and game.turn_number <= MAX_TURNS:\n        # Check SBAs before the turn (catches pre-existing conditions)\n        resolve_state_based_actions(game)\n        _check_game_over(game)\n        if game.is_game_over:\n            break\n\n        run_turn(game)\n\n        # Check SBAs after the turn\n        resolve_state_based_actions(game)\n        _check_game_over(game)\n\n    return game.winner\n\n\ndef _check_game_over(game: GameState) -> None:\n    \"\"\"Check whether the game has ended and update ``game.is_game_over`` / ``game.winner``.\n\n    The game ends when:\n    - One player has lost (``has_lost``): the other player wins.\n    - Both players have lost: the game is a draw (``winner = None``).\n    - The turn limit is exceeded: the game is a draw.\n    \"\"\"\n    lost_players = [p for p in game.players if p.has_lost]\n\n    if len(lost_players) == len(game.players):\n        # All players have lost — draw\n        game.is_game_over = True\n        game.winner = None\n    elif len(lost_players) == 1:\n        # One player lost — the other wins\n        game.is_game_over = True\n        game.winner = [p for p in game.players if not p.has_lost][0]\n    elif game.turn_number > MAX_TURNS:\n        # Turn limit exceeded — draw\n        game.is_game_over = True\n        game.winner = None\n","numLines":538,"startLine":1,"totalLines":538}}}
{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_0185nUZ2yjUS9RJeHRb3dQsw","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7599,"cache_read_input_tokens":76169,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7599},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e89db2fe-0d6e-4510-b5e6-a7586e7fc62b","uuid":"b561f25c-5da3-4e8f-a09c-bad22a8aee45","request_id":"req_011Cbw9W7yt6y7vB6KQ5A6AH"}
{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_0185nUZ2yjUS9RJeHRb3dQsw","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01GJTnZ2WaEE5q6g2hA7czXx","name":"Read","input":{"file_path":"/workspace/engine/abilities.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7599,"cache_read_input_tokens":76169,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7599},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e89db2fe-0d6e-4510-b5e6-a7586e7fc62b","uuid":"c0abdc3f-b3ec-49ca-9057-27e5dc2b55a7","request_id":"req_011Cbw9W7yt6y7vB6KQ5A6AH"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GJTnZ2WaEE5q6g2hA7czXx","type":"tool_result","content":"1\t\"\"\"Activated abilities system — tap-for-mana, loyalty abilities, and general\n2\tactivated abilities that go on the stack (or resolve immediately for mana\n3\tabilities).\n4\t\n5\tProvides:\n6\t\n7\t- :func:`activate_ability` — verify timing → pay costs → resolve immediately\n8\t  (mana abilities) or push to the stack (non-mana abilities).\n9\t- :func:`tap_cost` — generic tap-cost helper: checks ``not source.is_tapped``\n10\t  and taps the source.\n11\t- :class:`ActivatedAbilityInstance` — a runtime representation of an activated\n12\t  ability with source, controller, cost/effect callables, and metadata.\n13\t- :class:`LoyaltyAbilityInstance` — activated ability variant for planeswalker\n14\t  loyalty abilities with per-turn restriction and loyalty-counter cost.\n15\t\"\"\"\n16\t\n17\tfrom __future__ import annotations\n18\t\n19\tfrom dataclasses import dataclass, field\n20\tfrom typing import TYPE_CHECKING, Any, Callable\n21\t\n22\tfrom engine.casting import is_sorcery_speed\n23\tfrom engine.stack import StackObject\n24\t\n25\tif TYPE_CHECKING:\n26\t    from engine.game_state import GameState\n27\t    from engine.player import Player\n28\t\n29\t\n30\tclass AbilityError(Exception):\n31\t    \"\"\"Raised when an ability activation is illegal.\"\"\"\n32\t\n33\t\n34\t# ---------------------------------------------------------------------------\n35\t# Runtime ability representations\n36\t# ---------------------------------------------------------------------------\n37\t\n38\t@dataclass\n39\tclass ActivatedAbilityInstance:\n40\t    \"\"\"Runtime representation of an activated ability.\n41\t\n42\t    This captures everything needed to activate and resolve an ability:\n43\t    the source permanent, the controlling player, cost/effect callables,\n44\t    and whether the ability is a mana ability.\n45\t\n46\t    Attributes:\n47\t        source: The permanent that has this ability.\n48\t        controller: The player who controls the source.\n49\t        cost: A callable ``(game, source) -> bool`` that checks and pays\n50\t            the cost. Returns ``True`` if the cost was successfully paid,\n51\t            ``False`` otherwise.\n52\t        effect: A callable ``(game) -> None`` that applies the ability's\n53\t            effect when it resolves.\n54\t        is_mana_ability: Whether this is a mana ability (resolves\n55\t            immediately without using the stack).\n56\t        description: Human-readable description of the ability.\n57\t    \"\"\"\n58\t\n59\t    source: Any\n60\t    controller: Any  # Player\n61\t    cost: Callable[..., bool]\n62\t    effect: Callable[..., None]\n63\t    is_mana_ability: bool = False\n64\t    description: str = \"\"\n65\t\n66\t\n67\t@dataclass\n68\tclass LoyaltyAbilityInstance:\n69\t    \"\"\"Runtime representation of a planeswalker loyalty ability.\n70\t\n71\t    Loyalty abilities are activated abilities with special restrictions:\n72\t    they may only be activated at sorcery speed, and only once per turn\n73\t    per source (tracked via ``_activated_this_turn``).\n74\t\n75\t    The cost adjusts the loyalty counters on the source planeswalker.\n76\t\n77\t    Attributes:\n78\t        source: The planeswalker permanent.\n79\t        controller: The player who controls the planeswalker.\n80\t        loyalty_cost: The loyalty adjustment (positive for ``+N``,\n81\t            negative for ``−N``, zero for ``0``).\n82\t        effect: A callable ``(game) -> None`` for the ability's effect.\n83\t        description: Human-readable description.\n84\t    \"\"\"\n85\t\n86\t    source: Any\n87\t    controller: Any  # Player\n88\t    loyalty_cost: int = 0\n89\t    effect: Callable[..., None] = field(default=lambda _game: None)\n90\t    description: str = \"\"\n91\t\n92\t\n93\t# ---------------------------------------------------------------------------\n94\t# Per-turn loyalty tracking\n95\t# ---------------------------------------------------------------------------\n96\t\n97\t# Set of (object_id, turn_number) pairs that have already activated a\n98\t# loyalty ability this turn.  Callers should call\n99\t# ``clear_loyalty_tracking()`` at the start of each turn or manage the\n100\t# set externally.\n101\t_loyalty_activated_this_turn: set[tuple[int, int]] = set()\n102\t\n103\t\n104\tdef clear_loyalty_tracking() -> None:\n105\t    \"\"\"Clear the loyalty-activated-this-turn tracker.\n106\t\n107\t    Should be called at the start of each turn so that planeswalkers may\n108\t    activate loyalty abilities again.\n109\t    \"\"\"\n110\t    _loyalty_activated_this_turn.clear()\n111\t\n112\t\n113\tdef _has_activated_loyalty_this_turn(source: Any, turn_number: int) -> bool:\n114\t    \"\"\"Return ``True`` if *source* already used a loyalty ability this turn.\"\"\"\n115\t    obj_id = getattr(source, \"object_id\", id(source))\n116\t    return (obj_id, turn_number) in _loyalty_activated_this_turn\n117\t\n118\t\n119\tdef _mark_loyalty_activated(source: Any, turn_number: int) -> None:\n120\t    \"\"\"Record that *source* used a loyalty ability this turn.\"\"\"\n121\t    obj_id = getattr(source, \"object_id\", id(source))\n122\t    _loyalty_activated_this_turn.add((obj_id, turn_number))\n123\t\n124\t\n125\t# ---------------------------------------------------------------------------\n126\t# Tap cost helper\n127\t# ---------------------------------------------------------------------------\n128\t\n129\tdef tap_cost(game: GameState, source: Any) -> bool:\n130\t    \"\"\"Generic tap-cost function.\n131\t\n132\t    Checks that the source is not already tapped.  If untapped, taps it\n133\t    (sets ``source.is_tapped = True``) and returns ``True``.  If already\n134\t    tapped, returns ``False`` (cost cannot be paid).\n135\t\n136\t    Parameters:\n137\t        game: The current game state (unused here but kept for a\n138\t            consistent ``(game, source) -> bool`` cost signature).\n139\t        source: The permanent to tap.\n140\t\n141\t    Returns:\n142\t        ``True`` if the cost was successfully paid (source was untapped\n143\t        and is now tapped), ``False`` otherwise.\n144\t    \"\"\"\n145\t    if getattr(source, \"is_tapped\", False):\n146\t        return False\n147\t    source.is_tapped = True\n148\t    return True\n149\t\n150\t\n151\t# ---------------------------------------------------------------------------\n152\t# Activate ability — main entry point\n153\t# ---------------------------------------------------------------------------\n154\t\n155\tdef activate_ability(\n156\t    game: GameState,\n157\t    player: Any,  # Player\n158\t    ability: ActivatedAbilityInstance | LoyaltyAbilityInstance,\n159\t) -> None:\n160\t    \"\"\"Activate an ability.\n161\t\n162\t    Pipeline\n163\t    --------\n164\t    1. **Timing check** — mana abilities bypass timing entirely and\n165\t       resolve immediately.  Regular (non-mana) activated abilities\n166\t       can be activated whenever a player has priority (instant speed);\n167\t       priority enforcement is handled externally by\n168\t       ``priority_loop``, not here.  **Only loyalty abilities** carry\n169\t       a sorcery-speed restriction.\n170\t    2. **Pay costs** — invoke the ability's cost callable.  For loyalty\n171\t       abilities, adjust loyalty counters and enforce once-per-turn.\n172\t    3. **Resolve or push to stack** — mana abilities resolve\n173\t       immediately; all other abilities are pushed onto the game stack\n174\t       as :class:`StackObject` instances.\n175\t\n176\t    Parameters:\n177\t        game: The current game state.\n178\t        player: The player activating the ability.\n179\t        ability: The ability to activate (an\n180\t            :class:`ActivatedAbilityInstance` or\n181\t            :class:`LoyaltyAbilityInstance`).\n182\t\n183\t    Raises:\n184\t        AbilityError: If the activation is illegal (timing, cost, or\n185\t            once-per-turn restriction).\n186\t    \"\"\"\n187\t    if isinstance(ability, LoyaltyAbilityInstance):\n188\t        _activate_loyalty_ability(game, player, ability)\n189\t    elif isinstance(ability, ActivatedAbilityInstance):\n190\t        _activate_regular_ability(game, player, ability)\n191\t    else:\n192\t        raise AbilityError(f\"Unknown ability type: {type(ability)}\")\n193\t\n194\t\n195\t# ---------------------------------------------------------------------------\n196\t# Internal helpers\n197\t# ---------------------------------------------------------------------------\n198\t\n199\tdef _activate_regular_ability(\n200\t    game: GameState,\n201\t    player: Any,\n202\t    ability: ActivatedAbilityInstance,\n203\t) -> None:\n204\t    \"\"\"Activate a regular (non-loyalty) activated ability.\"\"\"\n205\t    # 1. Check \"can't activate\" restriction (e.g. Arrest).\n206\t    if getattr(ability.source, \"_cant_activate\", False):\n207\t        raise AbilityError(\n208\t            \"Cannot activate ability — source's activated abilities are suppressed\"\n209\t        )\n210\t\n211\t    # 2. Pay costs\n212\t    cost_paid = ability.cost(game, ability.source)\n213\t    if not cost_paid:\n214\t        raise AbilityError(\"Cannot activate ability — cost could not be paid\")\n215\t\n216\t    # 3. Resolve or push\n217\t    if ability.is_mana_ability:\n218\t        # Mana abilities resolve immediately without using the stack.\n219\t        ability.effect(game)\n220\t    else:\n221\t        # Push to stack for resolution.\n222\t        stack_obj = StackObject(\n223\t            source=ability.source,\n224\t            controller=player,\n225\t            on_resolve=ability.effect,\n226\t            is_mana_ability=False,\n227\t        )\n228\t        game.stack.push(stack_obj)\n229\t\n230\t\n231\tdef _activate_loyalty_ability(\n232\t    game: GameState,\n233\t    player: Any,\n234\t    ability: LoyaltyAbilityInstance,\n235\t) -> None:\n236\t    \"\"\"Activate a planeswalker loyalty ability.\"\"\"\n237\t    source = ability.source\n238\t\n239\t    # 1. Timing — loyalty abilities are sorcery speed only.\n240\t    if not is_sorcery_speed(game, player):\n241\t        raise AbilityError(\n242\t            \"Cannot activate loyalty ability — sorcery-speed timing not met\"\n243\t        )\n244\t\n245\t    # 2. Once-per-turn restriction.\n246\t    turn_number = getattr(game, \"turn_number\", 0)\n247\t    if _has_activated_loyalty_this_turn(source, turn_number):\n248\t        raise AbilityError(\n249\t            \"Cannot activate loyalty ability — already activated this turn\"\n250\t        )\n251\t\n252\t    # 3. Pay loyalty cost.\n253\t    current_loyalty = getattr(source, \"loyalty\", 0)\n254\t    new_loyalty = current_loyalty + ability.loyalty_cost\n255\t    if new_loyalty < 0:\n256\t        raise AbilityError(\n257\t            f\"Cannot activate loyalty ability — insufficient loyalty \"\n258\t            f\"(have {current_loyalty}, need {-ability.loyalty_cost})\"\n259\t        )\n260\t    source.loyalty = new_loyalty\n261\t\n262\t    # 4. Mark as activated this turn.\n263\t    _mark_loyalty_activated(source, turn_number)\n264\t\n265\t    # 5. Push to stack.\n266\t    stack_obj = StackObject(\n267\t        source=source,\n268\t        controller=player,\n269\t        on_resolve=ability.effect,\n270\t        is_mana_ability=False,\n271\t    )\n272\t    game.stack.push(stack_obj)\n273\t"}]},"parent_tool_use_id":null,"session_id":"e89db2fe-0d6e-4510-b5e6-a7586e7fc62b","uuid":"bacff576-2605-4c53-ab3f-e7f79ac5e999","timestamp":"2026-06-11T08:21:14.657Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/abilities.py","content":"\"\"\"Activated abilities system — tap-for-mana, loyalty abilities, and general\nactivated abilities that go on the stack (or resolve immediately for mana\nabilities).\n\nProvides:\n\n- :func:`activate_ability` — verify timing → pay costs → resolve immediately\n  (mana abilities) or push to the stack (non-mana abilities).\n- :func:`tap_cost` — generic tap-cost helper: checks ``not source.is_tapped``\n  and taps the source.\n- :class:`ActivatedAbilityInstance` — a runtime representation of an activated\n  ability with source, controller, cost/effect callables, and metadata.\n- :class:`LoyaltyAbilityInstance` — activated ability variant for planeswalker\n  loyalty abilities with per-turn restriction and loyalty-counter cost.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom typing import TYPE_CHECKING, Any, Callable\n\nfrom engine.casting import is_sorcery_speed\nfrom engine.stack import StackObject\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\nclass AbilityError(Exception):\n    \"\"\"Raised when an ability activation is illegal.\"\"\"\n\n\n# ---------------------------------------------------------------------------\n# Runtime ability representations\n# ---------------------------------------------------------------------------\n\n@dataclass\nclass ActivatedAbilityInstance:\n    \"\"\"Runtime representation of an activated ability.\n\n    This captures everything needed to activate and resolve an ability:\n    the source permanent, the controlling player, cost/effect callables,\n    and whether the ability is a mana ability.\n\n    Attributes:\n        source: The permanent that has this ability.\n        controller: The player who controls the source.\n        cost: A callable ``(game, source) -> bool`` that checks and pays\n            the cost. Returns ``True`` if the cost was successfully paid,\n            ``False`` otherwise.\n        effect: A callable ``(game) -> None`` that applies the ability's\n            effect when it resolves.\n        is_mana_ability: Whether this is a mana ability (resolves\n            immediately without using the stack).\n        description: Human-readable description of the ability.\n    \"\"\"\n\n    source: Any\n    controller: Any  # Player\n    cost: Callable[..., bool]\n    effect: Callable[..., None]\n    is_mana_ability: bool = False\n    description: str = \"\"\n\n\n@dataclass\nclass LoyaltyAbilityInstance:\n    \"\"\"Runtime representation of a planeswalker loyalty ability.\n\n    Loyalty abilities are activated abilities with special restrictions:\n    they may only be activated at sorcery speed, and only once per turn\n    per source (tracked via ``_activated_this_turn``).\n\n    The cost adjusts the loyalty counters on the source planeswalker.\n\n    Attributes:\n        source: The planeswalker permanent.\n        controller: The player who controls the planeswalker.\n        loyalty_cost: The loyalty adjustment (positive for ``+N``,\n            negative for ``−N``, zero for ``0``).\n        effect: A callable ``(game) -> None`` for the ability's effect.\n        description: Human-readable description.\n    \"\"\"\n\n    source: Any\n    controller: Any  # Player\n    loyalty_cost: int = 0\n    effect: Callable[..., None] = field(default=lambda _game: None)\n    description: str = \"\"\n\n\n# ---------------------------------------------------------------------------\n# Per-turn loyalty tracking\n# ---------------------------------------------------------------------------\n\n# Set of (object_id, turn_number) pairs that have already activated a\n# loyalty ability this turn.  Callers should call\n# ``clear_loyalty_tracking()`` at the start of each turn or manage the\n# set externally.\n_loyalty_activated_this_turn: set[tuple[int, int]] = set()\n\n\ndef clear_loyalty_tracking() -> None:\n    \"\"\"Clear the loyalty-activated-this-turn tracker.\n\n    Should be called at the start of each turn so that planeswalkers may\n    activate loyalty abilities again.\n    \"\"\"\n    _loyalty_activated_this_turn.clear()\n\n\ndef _has_activated_loyalty_this_turn(source: Any, turn_number: int) -> bool:\n    \"\"\"Return ``True`` if *source* already used a loyalty ability this turn.\"\"\"\n    obj_id = getattr(source, \"object_id\", id(source))\n    return (obj_id, turn_number) in _loyalty_activated_this_turn\n\n\ndef _mark_loyalty_activated(source: Any, turn_number: int) -> None:\n    \"\"\"Record that *source* used a loyalty ability this turn.\"\"\"\n    obj_id = getattr(source, \"object_id\", id(source))\n    _loyalty_activated_this_turn.add((obj_id, turn_number))\n\n\n# ---------------------------------------------------------------------------\n# Tap cost helper\n# ---------------------------------------------------------------------------\n\ndef tap_cost(game: GameState, source: Any) -> bool:\n    \"\"\"Generic tap-cost function.\n\n    Checks that the source is not already tapped.  If untapped, taps it\n    (sets ``source.is_tapped = True``) and returns ``True``.  If already\n    tapped, returns ``False`` (cost cannot be paid).\n\n    Parameters:\n        game: The current game state (unused here but kept for a\n            consistent ``(game, source) -> bool`` cost signature).\n        source: The permanent to tap.\n\n    Returns:\n        ``True`` if the cost was successfully paid (source was untapped\n        and is now tapped), ``False`` otherwise.\n    \"\"\"\n    if getattr(source, \"is_tapped\", False):\n        return False\n    source.is_tapped = True\n    return True\n\n\n# ---------------------------------------------------------------------------\n# Activate ability — main entry point\n# ---------------------------------------------------------------------------\n\ndef activate_ability(\n    game: GameState,\n    player: Any,  # Player\n    ability: ActivatedAbilityInstance | LoyaltyAbilityInstance,\n) -> None:\n    \"\"\"Activate an ability.\n\n    Pipeline\n    --------\n    1. **Timing check** — mana abilities bypass timing entirely and\n       resolve immediately.  Regular (non-mana) activated abilities\n       can be activated whenever a player has priority (instant speed);\n       priority enforcement is handled externally by\n       ``priority_loop``, not here.  **Only loyalty abilities** carry\n       a sorcery-speed restriction.\n    2. **Pay costs** — invoke the ability's cost callable.  For loyalty\n       abilities, adjust loyalty counters and enforce once-per-turn.\n    3. **Resolve or push to stack** — mana abilities resolve\n       immediately; all other abilities are pushed onto the game stack\n       as :class:`StackObject` instances.\n\n    Parameters:\n        game: The current game state.\n        player: The player activating the ability.\n        ability: The ability to activate (an\n            :class:`ActivatedAbilityInstance` or\n            :class:`LoyaltyAbilityInstance`).\n\n    Raises:\n        AbilityError: If the activation is illegal (timing, cost, or\n            once-per-turn restriction).\n    \"\"\"\n    if isinstance(ability, LoyaltyAbilityInstance):\n        _activate_loyalty_ability(game, player, ability)\n    elif isinstance(ability, ActivatedAbilityInstance):\n        _activate_regular_ability(game, player, ability)\n    else:\n        raise AbilityError(f\"Unknown ability type: {type(ability)}\")\n\n\n# ---------------------------------------------------------------------------\n# Internal helpers\n# ---------------------------------------------------------------------------\n\ndef _activate_regular_ability(\n    game: GameState,\n    player: Any,\n    ability: ActivatedAbilityInstance,\n) -> None:\n    \"\"\"Activate a regular (non-loyalty) activated ability.\"\"\"\n    # 1. Check \"can't activate\" restriction (e.g. Arrest).\n    if getattr(ability.source, \"_cant_activate\", False):\n        raise AbilityError(\n            \"Cannot activate ability — source's activated abilities are suppressed\"\n        )\n\n    # 2. Pay costs\n    cost_paid = ability.cost(game, ability.source)\n    if not cost_paid:\n        raise AbilityError(\"Cannot activate ability — cost could not be paid\")\n\n    # 3. Resolve or push\n    if ability.is_mana_ability:\n        # Mana abilities resolve immediately without using the stack.\n        ability.effect(game)\n    else:\n        # Push to stack for resolution.\n        stack_obj = StackObject(\n            source=ability.source,\n            controller=player,\n            on_resolve=ability.effect,\n            is_mana_ability=False,\n        )\n        game.stack.push(stack_obj)\n\n\ndef _activate_loyalty_ability(\n    game: GameState,\n    player: Any,\n    ability: LoyaltyAbilityInstance,\n) -> None:\n    \"\"\"Activate a planeswalker loyalty ability.\"\"\"\n    source = ability.source\n\n    # 1. Timing — loyalty abilities are sorcery speed only.\n    if not is_sorcery_speed(game, player):\n        raise AbilityError(\n            \"Cannot activate loyalty ability — sorcery-speed timing not met\"\n        )\n\n    # 2. Once-per-turn restriction.\n    turn_number = getattr(game, \"turn_number\", 0)\n    if _has_activated_loyalty_this_turn(source, turn_number):\n        raise AbilityError(\n            \"Cannot activate loyalty ability — already activated this turn\"\n        )\n\n    # 3. Pay loyalty cost.\n    current_loyalty = getattr(source, \"loyalty\", 0)\n    new_loyalty = current_loyalty + ability.loyalty_cost\n    if new_loyalty < 0:\n        raise AbilityError(\n            f\"Cannot activate loyalty ability — insufficient loyalty \"\n            f\"(have {current_loyalty}, need {-ability.loyalty_cost})\"\n        )\n    source.loyalty = new_loyalty\n\n    # 4. Mark as activated this turn.\n    _mark_loyalty_activated(source, turn_number)\n\n    # 5. Push to stack.\n    stack_obj = StackObject(\n        source=source,\n        controller=player,\n        on_resolve=ability.effect,\n        is_mana_ability=False,\n    )\n    game.stack.push(stack_obj)\n","numLines":273,"startLine":1,"totalLines":273}}}
{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_0185nUZ2yjUS9RJeHRb3dQsw","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01M2HfwbT35co6B8ukiL54Mm","name":"Read","input":{"file_path":"/workspace/engine/player.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7599,"cache_read_input_tokens":76169,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7599},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e89db2fe-0d6e-4510-b5e6-a7586e7fc62b","uuid":"028654b7-a593-43f6-acb9-70ce104e260a","request_id":"req_011Cbw9W7yt6y7vB6KQ5A6AH"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M2HfwbT35co6B8ukiL54Mm","type":"tool_result","content":"1\t\"\"\"Player interface and deterministic test player implementation.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom abc import ABC, abstractmethod\n6\tfrom collections import deque\n7\tfrom typing import Any\n8\t\n9\tfrom engine.mana import ManaPool\n10\tfrom engine.zones import Zones\n11\t\n12\t\n13\tclass ScriptExhaustedError(Exception):\n14\t    \"\"\"Raised when a DeterministicPlayer's script runs out of predetermined answers.\"\"\"\n15\t\n16\t\n17\tclass Player(ABC):\n18\t    \"\"\"Abstract base class for all players in the game.\n19\t\n20\t    Attributes:\n21\t        name: The player's display name.\n22\t        life: Current life total (default 20).\n23\t        zones: Per-player zone containers.\n24\t        mana_pool: The player's mana pool (forward ref; initialized to None until ManaPool is implemented).\n25\t        has_lost: Whether this player has lost the game.\n26\t        land_plays_remaining: Number of land plays remaining this turn.\n27\t        drawn_from_empty_library: Whether this player attempted to draw from an empty library.\n28\t    \"\"\"\n29\t\n30\t    def __init__(self, name: str, life: int = 20) -> None:\n31\t        self.name: str = name\n32\t        self.life: int = life\n33\t        self.zones: Zones = Zones.new_player()\n34\t        self.mana_pool: ManaPool = ManaPool()\n35\t        self.has_lost: bool = False\n36\t        self.land_plays_remaining: int = 1\n37\t        self.drawn_from_empty_library: bool = False\n38\t\n39\t    @abstractmethod\n40\t    def choose_target(self, options: Any, requirement: Any) -> Any:\n41\t        \"\"\"Choose a target from the available options given a requirement.\n42\t\n43\t        Parameters:\n44\t            options: The available targets to choose from.\n45\t            requirement: The targeting requirement to satisfy.\n46\t\n47\t        Returns:\n48\t            The chosen target.\n49\t        \"\"\"\n50\t\n51\t    @abstractmethod\n52\t    def choose(self, options: Any, description: str) -> Any:\n53\t        \"\"\"Choose from a list of options.\n54\t\n55\t        Parameters:\n56\t            options: The available choices.\n57\t            description: Human-readable description of the choice.\n58\t\n59\t        Returns:\n60\t            The chosen option.\n61\t        \"\"\"\n62\t\n63\t    @abstractmethod\n64\t    def choose_yes_no(self, prompt: str) -> bool:\n65\t        \"\"\"Make a yes/no decision.\n66\t\n67\t        Parameters:\n68\t            prompt: Human-readable prompt for the decision.\n69\t\n70\t        Returns:\n71\t            True for yes, False for no.\n72\t        \"\"\"\n73\t\n74\t    @abstractmethod\n75\t    def assign_damage_order(self, attackers_or_blockers: Any) -> list[Any]:\n76\t        \"\"\"Assign a damage ordering to attackers or blockers.\n77\t\n78\t        Parameters:\n79\t            attackers_or_blockers: The creatures to order.\n80\t\n81\t        Returns:\n82\t            An ordered list representing the damage assignment order.\n83\t        \"\"\"\n84\t\n85\t    @abstractmethod\n86\t    def choose_card(self, cards: Any, description: str) -> Any:\n87\t        \"\"\"Choose a card from a collection.\n88\t\n89\t        Parameters:\n90\t            cards: The available cards to choose from.\n91\t            description: Human-readable description of why a card is being chosen.\n92\t\n93\t        Returns:\n94\t            The chosen card.\n95\t        \"\"\"\n96\t\n97\t\n98\tclass DeterministicPlayer(Player):\n99\t    \"\"\"A scripted player for testing that returns predetermined answers.\n100\t\n101\t    Each abstract method call pops the next answer from the front of the\n102\t    script queue. Raises :class:`ScriptExhaustedError` if the script is empty\n103\t    when a choice is requested.\n104\t    \"\"\"\n105\t\n106\t    def __init__(self, name: str, script: list[Any], life: int = 20) -> None:\n107\t        super().__init__(name, life)\n108\t        self._script: deque[Any] = deque(script)\n109\t\n110\t    def _pop(self) -> Any:\n111\t        \"\"\"Pop the next scripted answer from the queue.\n112\t\n113\t        Raises:\n114\t            ScriptExhaustedError: If the script has no remaining answers.\n115\t        \"\"\"\n116\t        if not self._script:\n117\t            raise ScriptExhaustedError(\n118\t                f\"Player {self.name!r} script exhausted — no more predetermined answers\"\n119\t            )\n120\t        return self._script.popleft()\n121\t\n122\t    @property\n123\t    def remaining_choices(self) -> int:\n124\t        \"\"\"Return the number of scripted answers remaining.\"\"\"\n125\t        return len(self._script)\n126\t\n127\t    def choose_target(self, options: Any, requirement: Any) -> Any:\n128\t        \"\"\"Return the next scripted target choice.\"\"\"\n129\t        return self._pop()\n130\t\n131\t    def choose(self, options: Any, description: str) -> Any:\n132\t        \"\"\"Return the next scripted choice.\"\"\"\n133\t        return self._pop()\n134\t\n135\t    def choose_yes_no(self, prompt: str) -> bool:\n136\t        \"\"\"Return the next scripted yes/no decision.\"\"\"\n137\t        return self._pop()\n138\t\n139\t    def assign_damage_order(self, attackers_or_blockers: Any) -> list[Any]:\n140\t        \"\"\"Return the next scripted damage ordering.\"\"\"\n141\t        return self._pop()\n142\t\n143\t    def choose_card(self, cards: Any, description: str) -> Any:\n144\t        \"\"\"Return the next scripted card choice.\"\"\"\n145\t        return self._pop()\n146\t"}]},"parent_tool_use_id":null,"session_id":"e89db2fe-0d6e-4510-b5e6-a7586e7fc62b","uuid":"9645c8f8-551e-402c-b34a-ad3f57b0f123","timestamp":"2026-06-11T08:21:14.727Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/player.py","content":"\"\"\"Player interface and deterministic test player implementation.\"\"\"\n\nfrom __future__ import annotations\n\nfrom abc import ABC, abstractmethod\nfrom collections import deque\nfrom typing import Any\n\nfrom engine.mana import ManaPool\nfrom engine.zones import Zones\n\n\nclass ScriptExhaustedError(Exception):\n    \"\"\"Raised when a DeterministicPlayer's script runs out of predetermined answers.\"\"\"\n\n\nclass Player(ABC):\n    \"\"\"Abstract base class for all players in the game.\n\n    Attributes:\n        name: The player's display name.\n        life: Current life total (default 20).\n        zones: Per-player zone containers.\n        mana_pool: The player's mana pool (forward ref; initialized to None until ManaPool is implemented).\n        has_lost: Whether this player has lost the game.\n        land_plays_remaining: Number of land plays remaining this turn.\n        drawn_from_empty_library: Whether this player attempted to draw from an empty library.\n    \"\"\"\n\n    def __init__(self, name: str, life: int = 20) -> None:\n        self.name: str = name\n        self.life: int = life\n        self.zones: Zones = Zones.new_player()\n        self.mana_pool: ManaPool = ManaPool()\n        self.has_lost: bool = False\n        self.land_plays_remaining: int = 1\n        self.drawn_from_empty_library: bool = False\n\n    @abstractmethod\n    def choose_target(self, options: Any, requirement: Any) -> Any:\n        \"\"\"Choose a target from the available options given a requirement.\n\n        Parameters:\n            options: The available targets to choose from.\n            requirement: The targeting requirement to satisfy.\n\n        Returns:\n            The chosen target.\n        \"\"\"\n\n    @abstractmethod\n    def choose(self, options: Any, description: str) -> Any:\n        \"\"\"Choose from a list of options.\n\n        Parameters:\n            options: The available choices.\n            description: Human-readable description of the choice.\n\n        Returns:\n            The chosen option.\n        \"\"\"\n\n    @abstractmethod\n    def choose_yes_no(self, prompt: str) -> bool:\n        \"\"\"Make a yes/no decision.\n\n        Parameters:\n            prompt: Human-readable prompt for the decision.\n\n        Returns:\n            True for yes, False for no.\n        \"\"\"\n\n    @abstractmethod\n    def assign_damage_order(self, attackers_or_blockers: Any) -> list[Any]:\n        \"\"\"Assign a damage ordering to attackers or blockers.\n\n        Parameters:\n            attackers_or_blockers: The creatures to order.\n\n        Returns:\n            An ordered list representing the damage assignment order.\n        \"\"\"\n\n    @abstractmethod\n    def choose_card(self, cards: Any, description: str) -> Any:\n        \"\"\"Choose a card from a collection.\n\n        Parameters:\n            cards: The available cards to choose from.\n            description: Human-readable description of why a card is being chosen.\n\n        Returns:\n            The chosen card.\n        \"\"\"\n\n\nclass DeterministicPlayer(Player):\n    \"\"\"A scripted player for testing that returns predetermined answers.\n\n    Each abstract method call pops the next answer from the front of the\n    script queue. Raises :class:`ScriptExhaustedError` if the script is empty\n    when a choice is requested.\n    \"\"\"\n\n    def __init__(self, name: str, script: list[Any], life: int = 20) -> None:\n        super().__init__(name, life)\n        self._script: deque[Any] = deque(script)\n\n    def _pop(self) -> Any:\n        \"\"\"Pop the next scripted answer from the queue.\n\n        Raises:\n            ScriptExhaustedError: If the script has no remaining answers.\n        \"\"\"\n        if not self._script:\n            raise ScriptExhaustedError(\n                f\"Player {self.name!r} script exhausted — no more predetermined answers\"\n            )\n        return self._script.popleft()\n\n    @property\n    def remaining_choices(self) -> int:\n        \"\"\"Return the number of scripted answers remaining.\"\"\"\n        return len(self._script)\n\n    def choose_target(self, options: Any, requirement: Any) -> Any:\n        \"\"\"Return the next scripted target choice.\"\"\"\n        return self._pop()\n\n    def choose(self, options: Any, description: str) -> Any:\n        \"\"\"Return the next scripted choice.\"\"\"\n        return self._pop()\n\n    def choose_yes_no(self, prompt: str) -> bool:\n        \"\"\"Return the next scripted yes/no decision.\"\"\"\n        return self._pop()\n\n    def assign_damage_order(self, attackers_or_blockers: Any) -> list[Any]:\n        \"\"\"Return the next scripted damage ordering.\"\"\"\n        return self._pop()\n\n    def choose_card(self, cards: Any, description: str) -> Any:\n        \"\"\"Return the next scripted card choice.\"\"\"\n        return self._pop()\n","numLines":146,"startLine":1,"totalLines":146}}}
