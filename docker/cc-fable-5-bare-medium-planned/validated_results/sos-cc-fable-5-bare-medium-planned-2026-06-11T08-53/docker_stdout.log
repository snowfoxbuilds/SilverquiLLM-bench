---------\n\n    def add(self, mana_type: ManaType, amount: int = 1) -> None:\n        \"\"\"Add *amount* mana of the given type to the pool.\n\n        Parameters:\n            mana_type: The type of mana to add.\n            amount: How many mana to add (must be non-negative).\n        \"\"\"\n        if amount < 0:\n            raise ValueError(f\"Cannot add negative mana: {amount}\")\n        self._pool[mana_type] = self._pool.get(mana_type, 0) + amount\n\n    def empty(self) -> None:\n        \"\"\"Clear the pool — happens at phase/step transitions.\"\"\"\n        for mt in self._pool:\n            self._pool[mt] = 0\n        for mt in self._restricted:\n            self._restricted[mt] = 0\n\n    def add_restricted(self, mana_type: ManaType, amount: int = 1) -> None:\n        \"\"\"Add mana that may only be spent to cast instant/sorcery spells.\"\"\"\n        self.add(mana_type, amount)\n        self._restricted[mana_type] = self._restricted.get(mana_type, 0) + amount\n\n    @staticmethod\n    def _restriction_satisfied(for_spell: Any) -> bool:\n        \"\"\"Return True if restricted mana may pay for *for_spell*.\"\"\"\n        from engine.types import CardType\n\n        types = getattr(for_spell, \"card_types\", set())\n        return bool(types & {CardType.INSTANT, CardType.SORCERY})\n\n    def _available(self, for_spell: Any = None) -> dict[ManaType, int]:\n        \"\"\"The pool view usable for a payment.\n\n        Restricted mana is excluded unless the payment is for an\n        instant/sorcery spell.\n        \"\"\"\n        if for_spell is not None and self._restriction_satisfied(for_spell):\n            return dict(self._pool)\n        return {\n            mt: self._pool.get(mt, 0) - self._restricted.get(mt, 0)\n            for mt in self._pool\n        }\n\n    def total(self) -> int:\n        \"\"\"Return the total amount of mana in the pool across all types.\"\"\"\n        return sum(self._pool.values())\n\n    def get(self, mana_type: ManaType)