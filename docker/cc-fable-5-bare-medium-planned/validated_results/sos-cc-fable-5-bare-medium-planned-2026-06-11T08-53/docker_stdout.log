      return True\n102-\n103-            def _spell_cast_effect(game: Any) -> None:\n104-                \"\"\"Create a 2/1 blue Ninja creature token.\"\"\"\n105-                token = Creature(name='Ninja', base_power=2, base_toughness=1, subtypes={'Ninja'})\n106:                create_token(game, controller, token)\n107-            game.trigger_manager.register(TriggerRegistration(event_type=SpellCastTriggeredEvent, condition=_spell_cast_condition, effect=_spell_cast_effect, source=emblem, controller=controller))\n108-        return [LoyaltyAbility(loyalty_cost=+1, effect=_plus1, description=\"+1: Up to one target creature can't be blocked. Draw, then discard.\"), LoyaltyAbility(loyalty_cost=-2, effect=_minus2, description='−2: Create a 2/1 blue Ninja creature token.'), LoyaltyAbility(loyalty_cost=-9, effect=_minus9, description='−9: Emblem — whenever a player casts a spell, create 2/1 Ninja token.')]","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
