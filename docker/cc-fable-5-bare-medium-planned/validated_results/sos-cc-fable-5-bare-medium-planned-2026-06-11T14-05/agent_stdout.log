roller=q0; q0.zones[Zone.LIBRARY].add(c)\nq0._script.append(None)  # keep everything\nab1 = ral2.get_loyalty_abilities()[0]\nactivate_ability(game2, q0, LoyaltyAbilityInstance(source=ral2, controller=q0, loyalty_cost=1, effect=ab1.effect))\nwhile not game2.stack.is_empty(): resolve_top(game2)\nassert len(q0.zones[Zone.LIBRARY]) == 2 and len(q0.zones[Zone.GRAVEYARD]) == 0\nprint(\"sos_97 smoke OK\")\nEOF\npython3 -m pytest engine_tests/ cards -q 2>&1 | tail -1","description":"sos_97 tests + smoke + full guard"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":131,"cache_creation_input_tokens":384,"cache_read_input_tokens":267765,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":384},"output_tokens":68,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"764317fa-ba6a-468d-853d-2d61b3563ec2","uuid":"c3d8e3a8-12a1-43ae-8083-3f76081a3ecb","request_id":"req_011CbwevRzeLB2TDZPKp2CtP"}
