ts/ cards -q 2>&1 | tail -1","description":"sos_120 smoke + guard"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":167,"cache_read_input_tokens":219204,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":167},"output_tokens":53,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"764317fa-ba6a-468d-853d-2d61b3563ec2","uuid":"25992171-26e9-454e-be4f-8555e63a87a2","request_id":"req_011CbwdycYcFSBqjdkfqASpw"}
