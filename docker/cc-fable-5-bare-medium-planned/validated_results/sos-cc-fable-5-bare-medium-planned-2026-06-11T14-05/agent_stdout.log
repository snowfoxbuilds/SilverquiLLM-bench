ngine/combat.py\n   251 /workspace/engine/continuous_effects.py\n    64 /workspace/engine/creatures.py\n   201 /workspace/engine/events.py\n   537 /workspace/engine/game.py\n   168 /workspace/engine/game_state.py\n   250 /workspace/engine/mana.py\n   145 /workspace/engine/player.py\n   166 /workspace/engine/protection.py\n   165 /workspace/engine/replacement_effects.py\n   227 /workspace/engine/stack.py\n   358 /workspace/engine/state_based_actions.py\n   136 /workspace/engine/triggers.py\n   217 /workspace/engine/turn.py\n   253 /workspace/engine/types.py\n   326 /workspace/engine/zones.py\n  5506 total","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
