{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016GD53xAV74WXA38xhvFyLk","type":"tool_result","content":"1\t\"\"\"Zone containers for managing game objects across game zones.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport random\n6\tfrom typing import TYPE_CHECKING, Any\n7\t\n8\tfrom engine.types import CardType, Zone\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t\n13\t\n14\tclass IllegalMoveError(Exception):\n15\t    \"\"\"Raised when a zone move is illegal (e.g. object not found in source zone).\"\"\"\n16\t\n17\t\n18\tclass ZoneContainer:\n19\t    \"\"\"Wraps an ordered list of game-object references for a single zone.\n20\t\n21\t    Internal list convention: index 0 is the *bottom*, index -1 is the *top*.\n22\t    This matches the intuitive model where ``add(obj, position=\"top\")``\n23\t    appends, and ``top(n)`` returns the last *n* items.\n24\t    \"\"\"\n25\t\n26\t    def __init__(self) -> None:\n27\t        self._objects: list[Any] = []\n28\t\n29\t    # ------------------------------------------------------------------\n30\t    # Mutators\n31\t    # ------------------------------------------------------------------\n32\t\n33\t    def add(self, obj: Any, position: str = \"top\") -> None:\n34\t        \"\"\"Add *obj* to this zone.\n35\t\n36\t        Parameters:\n37\t            obj: The game object to add.\n38\t            position: ``\"top\"`` (default) appends to the end of the internal\n39\t                list; ``\"bottom\"`` inserts at position 0.\n40\t        \"\"\"\n41\t        if position == \"top\":\n42\t            self._objects.append(obj)\n43\t        elif position == \"bottom\":\n44\t            self._objects.insert(0, obj)\n45\t        else:\n46\t            raise ValueError(f\"Invalid position: {position!r}; expected 'top' or 'bottom'\")\n47\t\n48\t    def remove(self, obj: Any) -> None:\n49\t        \"\"\"Remove *obj* from this zone (identity-based lookup).\n50\t\n51\t        Raises:\n52\t            ValueError: If *obj* is not in the zone.\n53\t        \"\"\"\n54\t        for i, item in enumerate(self._objects):\n55\t            if item is obj:\n56\t                del self._objects[i]\n57\t                return\n58\t        raise ValueError(f\"{obj!r} not in zone\")\n59\t\n60\t    def shuffle(self) -> None:\n61\t        \"\"\"Randomly shuffle the contents of this zone (used for libraries).\"\"\"\n62\t        random.shuffle(self._objects)\n63\t\n64\t    # ------------------------------------------------------------------\n65\t    # Queries\n66\t    # ------------------------------------------------------------------\n67\t\n68\t    def contains(self, obj: Any) -> bool:\n69\t        \"\"\"Return ``True`` if *obj* is in this zone (identity-based lookup).\"\"\"\n70\t        return any(item is obj for item in self._objects)\n71\t\n72\t    def get_all(self) -> list[Any]:\n73\t        \"\"\"Return a shallow copy of all objects in order (bottom → top).\"\"\"\n74\t        return list(self._objects)\n75\t\n76\t    def top(self, n: int) -> list[Any]:\n77\t        \"\"\"Return the top *n* items (last *n* in the internal list).\n78\t\n79\t        If *n* >= len, returns all items.  Order is bottom-to-top (same\n80\t        orientation as the internal list).\n81\t        \"\"\"\n82\t        if n <= 0:\n83\t            return []\n84\t        return self._objects[-n:]\n85\t\n86\t    def bottom(self, n: int) -> list[Any]:\n87\t        \"\"\"Return the bottom *n* items (first *n* in the internal list).\n88\t\n89\t        If *n* >= len, returns all items.\n90\t        \"\"\"\n91\t        if n <= 0:\n92\t            return []\n93\t        return self._objects[:n]\n94\t\n95\t    def __len__(self) -> int:\n96\t        return len(self._objects)\n97\t\n98\t    def __repr__(self) -> str:\n99\t        return f\"ZoneContainer({self._objects!r})\"\n100\t\n101\t\n102\tclass Zones:\n103\t    \"\"\"Per-player collection mapping each :class:`Zone` to a :class:`ZoneContainer`.\"\"\"\n104\t\n105\t    def __init__(self, zones: dict[Zone, ZoneContainer]) -> None:\n106\t        self._zones = zones\n107\t\n108\t    @classmethod\n109\t    def new_player(cls) -> Zones:\n110\t        \"\"\"Create a fresh set of empty zones for a player.\"\"\"\n111\t        return cls({zone: ZoneContainer() for zone in Zone})\n112\t\n113\t    def __getitem__(self, zone: Zone) -> ZoneContainer:\n114\t        return self._zones[zone]\n115\t\n116\t    def __contains__(self, zone: Zone) -> bool:\n117\t        return zone in self._zones\n118\t\n119\t    def __repr__(self) -> str:\n120\t        return f\"Zones({self._zones!r})\"\n121\t\n122\t\n123\tdef move_zone(\n124\t    obj: Any,\n125\t    from_zone: ZoneContainer,\n126\t    to_zone: ZoneContainer,\n127\t    position: str = \"top\",\n128\t) -> None:\n129\t    \"\"\"Move *obj* from *from_zone* to *to_zone*.\n130\t\n131\t    Parameters:\n132\t        obj: The game object to move.\n133\t        from_zone: Source :class:`ZoneContainer`.\n134\t        to_zone: Destination :class:`ZoneContainer`.\n135\t        position: ``\"top\"`` (default), ``\"bottom\"``, or ``\"shuffle\"``\n136\t            (add then shuffle the destination).\n137\t\n138\t    Raises:\n139\t        IllegalMoveError: If *obj* is not in *from_zone*.\n140\t    \"\"\"\n141\t    # Moving an object to the same zone it's already in is a no-op.\n142\t    if from_zone is to_zone:\n143\t        return\n144\t\n145\t    if not from_zone.contains(obj):\n146\t        raise IllegalMoveError(\n147\t            f\"Object {obj!r} not found in source zone\"\n148\t        )\n149\t\n150\t    # Validate position *before* mutating either zone so that an invalid\n151\t    # position does not leave the object removed from the source without\n152\t    # being added to the destination.\n153\t    if position not in (\"top\", \"bottom\", \"shuffle\"):\n154\t        raise ValueError(f\"Invalid position: {position!r}; expected 'top', 'bottom', or 'shuffle'\")\n155\t\n156\t    from_zone.remove(obj)\n157\t\n158\t    # Clear transient casting metadata when a card changes zones so that\n159\t    # stale data (e.g. colors_spent from a previous cast) does not leak.\n160\t    if hasattr(obj, \"colors_spent\"):\n161\t        del obj.colors_spent\n162\t\n163\t    if position == \"shuffle\":\n164\t        to_zone.add(obj, position=\"top\")\n165\t        to_zone.shuffle()\n166\t    else:\n167\t        to_zone.add(obj, position=position)\n168\t\n169\t\n170\t# Mapping from replacement-effect destination strings to Zone enum values.\n171\t_DESTINATION_ZONE_MAP: dict[str, Zone] = {\n172\t    \"graveyard\": Zone.GRAVEYARD,\n173\t    \"exile\": Zone.EXILE,\n174\t    \"hand\": Zone.HAND,\n175\t    \"library\": Zone.LIBRARY,\n176\t}\n177\t\n178\t\n179\tdef move_to_zone(\n180\t    game: GameState,\n181\t    card: Any,\n182\t    from_zone: Zone,\n183\t    to_zone: Zone,\n184\t    *,\n185\t    replacement_event: Any | None = None,\n186\t) -> None:\n187\t    \"\"\"High-level zone transition with trigger/replacement-effect hooks.\n188\t\n189\t    Centralises the bookkeeping that was previously duplicated across\n190\t    ``destroy()``, ``sacrifice()``, ``exile()``, ``create_token()``,\n191\t    ``_move_to_graveyard()`` (SBAs), and ``_resolve_spell()`` (casting).\n192\t\n193\t    Steps:\n194\t    1. Consult replacement effects for zone-change redirection (if\n195\t       *replacement_event* is supplied and the card is leaving the\n196\t       battlefield).  The replacement may change the destination zone\n197\t       (e.g. exile instead of graveyard) or set ``prevented = True`` to\n198\t       signal that it handled the zone move directly.\n199\t    2. Remove *card* from the source zone.\n200\t    3. Add *card* to the (possibly redirected) destination zone.\n201\t    4. If leaving the battlefield:\n202\t       a. Fire ``LeavesBattlefieldTriggeredEvent``.\n203\t       b. Fire ``CreatureDiesTriggeredEvent`` if the card is a creature\n204\t          **and** the final destination is the graveyard.\n205\t       c. Unregister triggers and replacement effects (fires happen\n206\t          **before** unregister so self-referencing triggers still match).\n207\t    5. If entering the battlefield:\n208\t       a. Register triggers (``register_triggers``) and replacement\n209\t          effects (``register_replacement_effects``).\n210\t       b. Fire ``EntersBattlefieldTriggeredEvent``.\n211\t\n212\t    Parameters:\n213\t        game: The current game state.\n214\t        card: The game object being moved.\n215\t        from_zone: The :class:`Zone` the card is currently in.\n216\t        to_zone: The intended destination :class:`Zone`.\n217\t        replacement_event: Optional typed replacement-event object\n218\t            (e.g. ``CreatureDiesReplacementEvent``).  When ``None``,\n219\t            no replacement effects are consulted (useful for simple\n220\t            moves like casting resolution or exile-from-graveyard).\n221\t    \"\"\"\n222\t    from engine.events import (\n223\t        CreatureDiesTriggeredEvent,\n224\t        EntersBattlefieldTriggeredEvent,\n225\t        LeavesBattlefieldTriggeredEvent,\n226\t    )\n227\t\n228\t    controller = getattr(card, \"controller\", None)\n229\t    owner = getattr(card, \"owner\", controller)\n230\t\n231\t    leaving_battlefield = from_zone == Zone.BATTLEFIELD\n232\t    entering_battlefield = to_zone == Zone.BATTLEFIELD\n233\t\n234\t    # --- Determine the source player for zone lookup ---\n235\t    # When leaving the battlefield, use the controller's zone.\n236\t    # For other zones (hand, graveyard, etc.), use the owner's zone.\n237\t    if leaving_battlefield:\n238\t        source_player = controller\n239\t    else:\n240\t        source_player = owner\n241\t\n242\t    # Fallback: search all players for the zone containing the card.\n243\t    # Also triggered when the inferred player's zone doesn't contain the card\n244\t    # (e.g. discarding a card that's in a different player's hand than its owner).\n245\t    if source_player is None or not source_player.zones[from_zone].contains(card):\n246\t        for player in game.players:\n247\t            if player.zones[from_zone].contains(card):\n248\t                source_player = player\n249\t                break\n250\t\n251\t    if source_player is None:\n252\t        return  # Card not found anywhere\n253\t\n254\t    source_container = source_player.zones[from_zone]\n255\t    if not source_container.contains(card):\n256\t        return  # Safety: card not in any player's zone\n257\t\n258\t    if owner is None:\n259\t        owner = source_player\n260\t\n261\t    # --- Replacement effects (zone-change redirection) ---\n262\t    dest_zone = to_zone\n263\t    if replacement_event is not None and leaving_battlefield:\n264\t        replacement_event = game.replacement_manager.apply(game, replacement_event)\n265\t        if getattr(replacement_event, \"prevented\", False):\n266\t            return\n267\t        destination_str = getattr(replacement_event, \"destination\", \"graveyard\")\n268\t        dest_zone = _DESTINATION_ZONE_MAP.get(destination_str, to_zone)\n269\t\n270\t    # --- Perform the zone move ---\n271\t    source_container.remove(card)\n272\t\n273\t    # Determine the destination player (always the owner for graveyard/exile/hand/library).\n274\t    if entering_battlefield:\n275\t        dest_player = controller if controller is not None else owner\n276\t    else:\n277\t        dest_player = owner\n278\t\n279\t    dest_player.zones[dest_zone].add(card)\n280\t\n281\t    # --- Leaving battlefield hooks ---\n282\t    if leaving_battlefield:\n283\t        card_types = getattr(card, \"card_types\", set())\n284\t        is_creature = CardType.CREATURE in card_types\n285\t\n286\t        # Fire events BEFORE unregistering (KEY_DECISIONS convention).\n287\t        game.trigger_manager.fire_event(\n288\t            game,\n289\t            LeavesBattlefieldTriggeredEvent(permanent=card, controller=controller),\n290\t        )\n291\t        if is_creature and dest_zone == Zone.GRAVEYARD:\n292\t            game.trigger_manager.fire_event(\n293\t                game,\n294\t                CreatureDiesTriggeredEvent(creature=card, controller=controller, owner=owner),\n295\t            )\n296\t\n297\t        # Now unregister triggers and replacement effects.\n298\t        game.trigger_manager.unregister(card)\n299\t        game.replacement_manager.unregister(card)\n300\t\n301\t    # --- Entering battlefield hooks ---\n302\t    if entering_battlefield:\n303\t        # Fire the ENTERS_BATTLEFIELD event *before* registering the card's\n304\t        # own triggers so that a permanent's ETB trigger does not\n305\t        # retroactively trigger off its own entry.  Other already-registered\n306\t        # triggers that watch for ENTERS_BATTLEFIELD will still fire.\n307\t        game.trigger_manager.fire_event(\n308\t            game,\n309\t            EntersBattlefieldTriggeredEvent(\n310\t                permanent=card,\n311\t                controller=controller if controller is not None else owner,\n312\t            ),\n313\t        )\n314\t        if hasattr(card, \"register_triggers\"):\n315\t            card.register_triggers(game)\n316\t        if hasattr(card, \"register_replacement_effects\"):\n317\t            card.register_replacement_effects(game)\n318\t\n319\t\n320\t# Destination string → Zone for replacement-effect zone redirection.\n321\t_DESTINATION_ZONE_MAP: dict[str, Zone] = {\n322\t    \"graveyard\": Zone.GRAVEYARD,\n323\t    \"exile\": Zone.EXILE,\n324\t    \"hand\": Zone.HAND,\n325\t    \"library\": Zone.LIBRARY,\n326\t}\n327\t"}]},"parent_tool_use_id":null,"session_id":"764317fa-ba6a-468d-853d-2d61b3563ec2","uuid":"a5c06b43-ad21-4e04-89c9-f6190ba9ce6e","timestamp":"2026-06-11T14:07:35.217Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/zones.py","content":"\"\"\"Zone containers for managing game objects across game zones.\"\"\"\n\nfrom __future__ import annotations\n\nimport random\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.types import CardType, Zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\nclass IllegalMoveError(Exception):\n    \"\"\"Raised when a zone move is illegal (e.g. object not found in source zone).\"\"\"\n\n\nclass ZoneContainer:\n    \"\"\"Wraps an ordered list of game-object references for a single zone.\n\n    Internal list convention: index 0 is the *bottom*, index -1 is the *top*.\n    This matches the intuitive model where ``add(obj, position=\"top\")``\n    appends, and ``top(n)`` returns the last *n* items.\n    \"\"\"\n\n    def __init__(self) -> None:\n        self._objects: list[Any] = []\n\n    # ------------------------------------------------------------------\n    # Mutators\n    # ------------------------------------------------------------------\n\n    def add(self, obj: Any, position: str = \"top\") -> None:\n        \"\"\"Add *obj* to this zone.\n\n        Parameters:\n            obj: The game object to add.\n            position: ``\"top\"`` (default) appends to the end of the internal\n                list; ``\"bottom\"`` inserts at position 0.\n        \"\"\"\n        if position == \"top\":\n            self._objects.append(obj)\n        elif position == \"bottom\":\n            self._objects.insert(0, obj)\n        else:\n            raise ValueError(f\"Invalid position: {position!r}; expected 'top' or 'bottom'\")\n\n    def remove(self, obj: Any) -> None:\n        \"\"\"Remove *obj* from this zone (identity-based lookup).\n\n        Raises:\n            ValueError: If *obj* is not in the zone.\n        \"\"\"\n        for i, item in enumerate(self._objects):\n            if item is obj:\n                del self._objects[i]\n                return\n        raise ValueError(f\"{obj!r} not in zone\")\n\n    def shuffle(self) -> None:\n        \"\"\"Randomly shuffle the contents of this zone (used for libraries).\"\"\"\n        random.shuffle(self._objects)\n\n    # ------------------------------------------------------------------\n    # Queries\n    # ------------------------------------------------------------------\n\n    def contains(self, obj: Any) -> bool:\n        \"\"\"Return ``True`` if *obj* is in this zone (identity-based lookup).\"\"\"\n        return any(item is obj for item in self._objects)\n\n    def get_all(self) -> list[Any]:\n        \"\"\"Return a shallow copy of all objects in order (bottom → top).\"\"\"\n        return list(self._objects)\n\n    def top(self, n: int) -> list[Any]:\n        \"\"\"Return the top *n* items (last *n* in the internal list).\n\n        If *n* >= len, returns all items.  Order is bottom-to-top (same\n        orientation as the internal list).\n        \"\"\"\n        if n <= 0:\n            return []\n        return self._objects[-n:]\n\n    def bottom(self, n: int) -> list[Any]:\n        \"\"\"Return the bottom *n* items (first *n* in the internal list).\n\n        If *n* >= len, returns all items.\n        \"\"\"\n        if n <= 0:\n            return []\n        return self._objects[:n]\n\n    def __len__(self) -> int:\n        return len(self._objects)\n\n    def __repr__(self) -> str:\n        return f\"ZoneContainer({self._objects!r})\"\n\n\nclass Zones:\n    \"\"\"Per-player collection mapping each :class:`Zone` to a :class:`ZoneContainer`.\"\"\"\n\n    def __init__(self, zones: dict[Zone, ZoneContainer]) -> None:\n        self._zones = zones\n\n    @classmethod\n    def new_player(cls) -> Zones:\n        \"\"\"Create a fresh set of empty zones for a player.\"\"\"\n        return cls({zone: ZoneContainer() for zone in Zone})\n\n    def __getitem__(self, zone: Zone) -> ZoneContainer:\n        return self._zones[zone]\n\n    def __contains__(self, zone: Zone) -> bool:\n        return zone in self._zones\n\n    def __repr__(self) -> str:\n        return f\"Zones({self._zones!r})\"\n\n\ndef move_zone(\n    obj: Any,\n    from_zone: ZoneContainer,\n    to_zone: ZoneContainer,\n    position: str = \"top\",\n) -> None:\n    \"\"\"Move *obj* from *from_zone* to *to_zone*.\n\n    Parameters:\n        obj: The game object to move.\n        from_zone: Source :class:`ZoneContainer`.\n        to_zone: Destination :class:`ZoneContainer`.\n        position: ``\"top\"`` (default), ``\"bottom\"``, or ``\"shuffle\"``\n            (add then shuffle the destination).\n\n    Raises:\n        IllegalMoveError: If *obj* is not in *from_zone*.\n    \"\"\"\n    # Moving an object to the same zone it's already in is a no-op.\n    if from_zone is to_zone:\n        return\n\n    if not from_zone.contains(obj):\n        raise IllegalMoveError(\n            f\"Object {obj!r} not found in source zone\"\n        )\n\n    # Validate position *before* mutating either zone so that an invalid\n    # position does not leave the object removed from the source without\n    # being added to the destination.\n    if position not in (\"top\", \"bottom\", \"shuffle\"):\n        raise ValueError(f\"Invalid position: {position!r}; expected 'top', 'bottom', or 'shuffle'\")\n\n    from_zone.remove(obj)\n\n    # Clear transient casting metadata when a card changes zones so that\n    # stale data (e.g. colors_spent from a previous cast) does not leak.\n    if hasattr(obj, \"colors_spent\"):\n        del obj.colors_spent\n\n    if position == \"shuffle\":\n        to_zone.add(obj, position=\"top\")\n        to_zone.shuffle()\n    else:\n        to_zone.add(obj, position=position)\n\n\n# Mapping from replacement-effect destination strings to Zone enum values.\n_DESTINATION_ZONE_MAP: dict[str, Zone] = {\n    \"graveyard\": Zone.GRAVEYARD,\n    \"exile\": Zone.EXILE,\n    \"hand\": Zone.HAND,\n    \"library\": Zone.LIBRARY,\n}\n\n\ndef move_to_zone(\n    game: GameState,\n    card: Any,\n    from_zone: Zone,\n    to_zone: Zone,\n    *,\n    replacement_event: Any | None = None,\n) -> None:\n    \"\"\"High-level zone transition with trigger/replacement-effect hooks.\n\n    Centralises the bookkeeping that was previously duplicated across\n    ``destroy()``, ``sacrifice()``, ``exile()``, ``create_token()``,\n    ``_move_to_graveyard()`` (SBAs), and ``_resolve_spell()`` (casting).\n\n    Steps:\n    1. Consult replacement effects for zone-change redirection (if\n       *replacement_event* is supplied and the card is leaving the\n       battlefield).  The replacement may change the destination zone\n       (e.g. exile instead of graveyard) or set ``prevented = True`` to\n       signal that it handled the zone move directly.\n    2. Remove *card* from the source zone.\n    3. Add *card* to the (possibly redirected) destination zone.\n    4. If leaving the battlefield:\n       a. Fire ``LeavesBattlefieldTriggeredEvent``.\n       b. Fire ``CreatureDiesTriggeredEvent`` if the card is a creature\n          **and** the final destination is the graveyard.\n       c. Unregister triggers and replacement effects (fires happen\n          **before** unregister so self-referencing triggers still match).\n    5. If entering the battlefield:\n       a. Register triggers (``register_triggers``) and replacement\n          effects (``register_replacement_effects``).\n       b. Fire ``EntersBattlefieldTriggeredEvent``.\n\n    Parameters:\n        game: The current game state.\n        card: The game object being moved.\n        from_zone: The :class:`Zone` the card is currently in.\n        to_zone: The intended destination :class:`Zone`.\n        replacement_event: Optional typed replacement-event object\n            (e.g. ``CreatureDiesReplacementEvent``).  When ``None``,\n            no replacement effects are consulted (useful for simple\n            moves like casting resolution or exile-from-graveyard).\n    \"\"\"\n    from engine.events import (\n        CreatureDiesTriggeredEvent,\n        EntersBattlefieldTriggeredEvent,\n        LeavesBattlefieldTriggeredEvent,\n    )\n\n    controller = getattr(card, \"controller\", None)\n    owner = getattr(card, \"owner\", controller)\n\n    leaving_battlefield = from_zone == Zone.BATTLEFIELD\n    entering_battlefield = to_zone == Zone.BATTLEFIELD\n\n    # --- Determine the source player for zone lookup ---\n    # When leaving the battlefield, use the controller's zone.\n    # For other zones (hand, graveyard, etc.), use the owner's zone.\n    if leaving_battlefield:\n        source_player = controller\n    else:\n        source_player = owner\n\n    # Fallback: search all players for the zone containing the card.\n    # Also triggered when the inferred player's zone doesn't contain the card\n    # (e.g. discarding a card that's in a different player's hand than its owner).\n    if source_player is None or not source_player.zones[from_zone].contains(card):\n        for player in game.players:\n            if player.zones[from_zone].contains(card):\n                source_player = player\n                break\n\n    if source_player is None:\n        return  # Card not found anywhere\n\n    source_container = source_player.zones[from_zone]\n    if not source_container.contains(card):\n        return  # Safety: card not in any player's zone\n\n    if owner is None:\n        owner = source_player\n\n    # --- Replacement effects (zone-change redirection) ---\n    dest_zone = to_zone\n    if replacement_event is not None and leaving_battlefield:\n        replacement_event = game.replacement_manager.apply(game, replacement_event)\n        if getattr(replacement_event, \"prevented\", False):\n            return\n        destination_str = getattr(replacement_event, \"destination\", \"graveyard\")\n        dest_zone = _DESTINATION_ZONE_MAP.get(destination_str, to_zone)\n\n    # --- Perform the zone move ---\n    source_container.remove(card)\n\n    # Determine the destination player (always the owner for graveyard/exile/hand/library).\n    if entering_battlefield:\n        dest_player = controller if controller is not None else owner\n    else:\n        dest_player = owner\n\n    dest_player.zones[dest_zone].add(card)\n\n    # --- Leaving battlefield hooks ---\n    if leaving_battlefield:\n        card_types = getattr(card, \"card_types\", set())\n        is_creature = CardType.CREATURE in card_types\n\n        # Fire events BEFORE unregistering (KEY_DECISIONS convention).\n        game.trigger_manager.fire_event(\n            game,\n            LeavesBattlefieldTriggeredEvent(permanent=card, controller=controller),\n        )\n        if is_creature and dest_zone == Zone.GRAVEYARD:\n            game.trigger_manager.fire_event(\n                game,\n                CreatureDiesTriggeredEvent(creature=card, controller=controller, owner=owner),\n            )\n\n        # Now unregister triggers and replacement effects.\n        game.trigger_manager.unregister(card)\n        game.replacement_manager.unregister(card)\n\n    # --- Entering battlefield hooks ---\n    if entering_battlefield:\n        # Fire the ENTERS_BATTLEFIELD event *before* registering the card's\n        # own triggers so that a permanent's ETB trigger does not\n        # retroactively trigger off its own entry.  Other already-registered\n        # triggers that watch for ENTERS_BATTLEFIELD will still fire.\n        game.trigger_manager.fire_event(\n            game,\n            EntersBattlefieldTriggeredEvent(\n                permanent=card,\n                controller=controller if controller is not None else owner,\n            ),\n        )\n        if hasattr(card, \"register_triggers\"):\n            card.register_triggers(game)\n        if hasattr(card, \"register_replacement_effects\"):\n            card.register_replacement_effects(game)\n\n\n# Destination string → Zone for replacement-effect zone redirection.\n_DESTINATION_ZONE_MAP: dict[str, Zone] = {\n    \"graveyard\": Zone.GRAVEYARD,\n    \"exile\": Zone.EXILE,\n    \"hand\": Zone.HAND,\n    \"library\": Zone.LIBRARY,\n}\n","numLines":327,"startLine":1,"totalLines":327}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HM4LmKA3BRYQy99zXWFaoq","type":"tool_result","content":"1\t\"\"\"Core enums and type definitions for the SilverquiLLM engine.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport enum\n6\timport re\n7\tfrom dataclasses import dataclass, field\n8\tfrom typing import Any, Callable\n9\t\n10\t\n11\tclass Color(enum.Enum):\n12\t    \"\"\"The five colors of Magic.\"\"\"\n13\t\n14\t    WHITE = \"W\"\n15\t    BLUE = \"U\"\n16\t    BLACK = \"B\"\n17\t    RED = \"R\"\n18\t    GREEN = \"G\"\n19\t\n20\t\n21\t# Single-letter aliases accessible as Color.W, Color.U, etc.\n22\tColor.W = Color.WHITE  # type: ignore[attr-defined]\n23\tColor.U = Color.BLUE  # type: ignore[attr-defined]\n24\tColor.B = Color.BLACK  # type: ignore[attr-defined]\n25\tColor.R = Color.RED  # type: ignore[attr-defined]\n26\tColor.G = Color.GREEN  # type: ignore[attr-defined]\n27\t\n28\t\n29\tclass ManaType(enum.Enum):\n30\t    \"\"\"Mana types including colorless.\"\"\"\n31\t\n32\t    WHITE = \"W\"\n33\t    BLUE = \"U\"\n34\t    BLACK = \"B\"\n35\t    RED = \"R\"\n36\t    GREEN = \"G\"\n37\t    COLORLESS = \"C\"\n38\t\n39\t\n40\tclass Zone(enum.Enum):\n41\t    \"\"\"Game zones.\"\"\"\n42\t\n43\t    BATTLEFIELD = \"battlefield\"\n44\t    HAND = \"hand\"\n45\t    LIBRARY = \"library\"\n46\t    GRAVEYARD = \"graveyard\"\n47\t    EXILE = \"exile\"\n48\t    STACK = \"stack\"\n49\t    COMMAND = \"command\"\n50\t\n51\t\n52\tclass Phase(enum.Enum):\n53\t    \"\"\"Turn phases.\"\"\"\n54\t\n55\t    BEGINNING = \"beginning\"\n56\t    PRECOMBAT_MAIN = \"precombat_main\"\n57\t    COMBAT = \"combat\"\n58\t    POSTCOMBAT_MAIN = \"postcombat_main\"\n59\t    ENDING = \"ending\"\n60\t\n61\t\n62\tclass Step(enum.Enum):\n63\t    \"\"\"Turn steps.\"\"\"\n64\t\n65\t    UNTAP = \"untap\"\n66\t    UPKEEP = \"upkeep\"\n67\t    DRAW = \"draw\"\n68\t    BEGIN_COMBAT = \"begin_combat\"\n69\t    DECLARE_ATTACKERS = \"declare_attackers\"\n70\t    DECLARE_BLOCKERS = \"declare_blockers\"\n71\t    COMBAT_DAMAGE = \"combat_damage\"\n72\t    END_COMBAT = \"end_combat\"\n73\t    END = \"end\"\n74\t    CLEANUP = \"cleanup\"\n75\t\n76\t\n77\tclass CardType(enum.Enum):\n78\t    \"\"\"Card types.\"\"\"\n79\t\n80\t    CREATURE = \"creature\"\n81\t    INSTANT = \"instant\"\n82\t    SORCERY = \"sorcery\"\n83\t    ENCHANTMENT = \"enchantment\"\n84\t    ARTIFACT = \"artifact\"\n85\t    PLANESWALKER = \"planeswalker\"\n86\t    LAND = \"land\"\n87\t\n88\t\n89\tclass Supertype(enum.Enum):\n90\t    \"\"\"Card supertypes.\"\"\"\n91\t\n92\t    BASIC = \"basic\"\n93\t    LEGENDARY = \"legendary\"\n94\t    SNOW = \"snow\"\n95\t\n96\t\n97\tclass Keyword(enum.Flag):\n98\t    \"\"\"Evergreen keyword abilities (combinable via bitwise OR).\"\"\"\n99\t\n100\t    FLYING = enum.auto()\n101\t    FIRST_STRIKE = enum.auto()\n102\t    DOUBLE_STRIKE = enum.auto()\n103\t    DEATHTOUCH = enum.auto()\n104\t    TRAMPLE = enum.auto()\n105\t    LIFELINK = enum.auto()\n106\t    VIGILANCE = enum.auto()\n107\t    REACH = enum.auto()\n108\t    HASTE = enum.auto()\n109\t    FLASH = enum.auto()\n110\t    DEFENDER = enum.auto()\n111\t    HEXPROOF = enum.auto()\n112\t    INDESTRUCTIBLE = enum.auto()\n113\t    MENACE = enum.auto()\n114\t    WARD = enum.auto()\n115\t    PROWESS = enum.auto()\n116\t\n117\t\n118\t# Mapping from pip string to ManaType for parsing\n119\t_PIP_MAP: dict[str, ManaType] = {\n120\t    \"W\": ManaType.WHITE,\n121\t    \"U\": ManaType.BLUE,\n122\t    \"B\": ManaType.BLACK,\n123\t    \"R\": ManaType.RED,\n124\t    \"G\": ManaType.GREEN,\n125\t    \"C\": ManaType.COLORLESS,\n126\t}\n127\t\n128\t# Regex to tokenize a mana cost string like \"{2}{W}{U}\" or \"{X}{X}{R}\"\n129\t_MANA_TOKEN_RE = re.compile(r\"\\{([^}]+)\\}\")\n130\t\n131\t# Regex to detect hybrid mana tokens like \"B/G\", \"W/U\", etc.\n132\t_HYBRID_RE = re.compile(r\"^([WUBRGC])/([WUBRGC])$\")\n133\t\n134\t\n135\t@dataclass(frozen=True)\n136\tclass HybridManaSymbol:\n137\t    \"\"\"A hybrid mana symbol that can be paid with either of two colors.\n138\t\n139\t    For example, ``{B/G}`` is represented as\n140\t    ``HybridManaSymbol(option_a=ManaType.BLACK, option_b=ManaType.GREEN)``.\n141\t    \"\"\"\n142\t\n143\t    option_a: ManaType\n144\t    option_b: ManaType\n145\t\n146\t\n147\t@dataclass(frozen=True)\n148\tclass ManaCost:\n149\t    \"\"\"Represents a mana cost.\n150\t\n151\t    Attributes:\n152\t        generic: The generic (numerical) component of the cost.\n153\t        pips: Mapping of colored/colorless mana pips to their counts.\n154\t        x_count: Number of {X} symbols in the cost.\n155\t        hybrid: List of hybrid mana symbols that can be paid with either option.\n156\t    \"\"\"\n157\t\n158\t    generic: int = 0\n159\t    pips: dict[ManaType, int] = field(default_factory=dict)\n160\t    x_count: int = 0\n161\t    hybrid: list[HybridManaSymbol] = field(default_factory=list)\n162\t\n163\t    @property\n164\t    def cmc(self) -> int:\n165\t        \"\"\"Converted mana cost (total mana value, treating X as 0).\n166\t\n167\t        Each hybrid symbol contributes 1 to the CMC.\n168\t        \"\"\"\n169\t        return self.generic + sum(self.pips.values()) + len(self.hybrid)\n170\t\n171\t    @classmethod\n172\t    def parse(cls, cost_str: str) -> ManaCost:\n173\t        \"\"\"Parse a mana cost string like ``\"{2}{W}{U}\"`` into a ManaCost.\n174\t\n175\t        Supports generic mana (``{N}``), colored pips (``{W}``, ``{U}``, ``{B}``,\n176\t        ``{R}``, ``{G}``), colorless pips (``{C}``), and X costs (``{X}``).\n177\t\n178\t        Raises:\n179\t            ValueError: If *cost_str* is empty, contains no valid tokens, or\n180\t                includes an unrecognised pip symbol.\n181\t        \"\"\"\n182\t        if not cost_str or not cost_str.strip():\n183\t            raise ValueError(f\"Invalid mana cost string: {cost_str!r}\")\n184\t\n185\t        tokens = _MANA_TOKEN_RE.findall(cost_str)\n186\t        if not tokens:\n187\t            raise ValueError(f\"Invalid mana cost string: {cost_str!r}\")\n188\t\n189\t        # Verify that the entire input is consumed by brace tokens (no extra\n190\t        # characters outside braces such as trailing junk or stray spaces).\n191\t        reconstructed = \"\".join(f\"{{{t}}}\" for t in tokens)\n192\t        if reconstructed != cost_str:\n193\t            raise ValueError(f\"Invalid mana cost string: {cost_str!r}\")\n194\t\n195\t        generic = 0\n196\t        pips: dict[ManaType, int] = {}\n197\t        x_count = 0\n198\t        hybrid: list[HybridManaSymbol] = []\n199\t\n200\t        for token in tokens:\n201\t            upper = token.upper()\n202\t            if upper == \"X\":\n203\t                x_count += 1\n204\t            elif upper in _PIP_MAP:\n205\t                mana_type = _PIP_MAP[upper]\n206\t                pips[mana_type] = pips.get(mana_type, 0) + 1\n207\t            else:\n208\t                # Check for hybrid mana like \"B/G\"\n209\t                hybrid_match = _HYBRID_RE.match(upper)\n210\t                if hybrid_match:\n211\t                    a_str, b_str = hybrid_match.group(1), hybrid_match.group(2)\n212\t                    if a_str not in _PIP_MAP or b_str not in _PIP_MAP:\n213\t                        raise ValueError(\n214\t                            f\"Unrecognised mana symbol {token!r} in cost string {cost_str!r}\"\n215\t                        )\n216\t                    hybrid.append(\n217\t                        HybridManaSymbol(\n218\t                            option_a=_PIP_MAP[a_str], option_b=_PIP_MAP[b_str]\n219\t                        )\n220\t                    )\n221\t                else:\n222\t                    # Try to parse as a number (generic mana)\n223\t                    try:\n224\t                        value = int(token)\n225\t                    except ValueError:\n226\t                        raise ValueError(\n227\t                            f\"Unrecognised mana symbol {token!r} in cost string {cost_str!r}\"\n228\t                        ) from None\n229\t                    if value < 0:\n230\t                        raise ValueError(\n231\t                            f\"Negative generic mana {token!r} in cost string {cost_str!r}\"\n232\t                        )\n233\t                    generic += value\n234\t\n235\t        return cls(generic=generic, pips=pips, x_count=x_count, hybrid=hybrid)\n236\t\n237\t\n238\t@dataclass\n239\tclass TargetRequirement:\n240\t    \"\"\"Describes a targeting requirement for a spell or ability.\n241\t\n242\t    Attributes:\n243\t        filter_fn: A callable that accepts a game object and returns True\n244\t            if the object is a legal target.  Filters should evaluate the\n245\t            object's properties at call time (lazy) rather than capturing\n246\t            a snapshot of legal targets when the filter is created.\n247\t        description: Human-readable description of what this targets.\n248\t        zone: The zone in which legal targets must reside.\n249\t    \"\"\"\n250\t\n251\t    filter_fn: Callable[..., Any]\n252\t    description: str\n253\t    zone: Zone\n254\t"}]},"parent_tool_use_id":null,"session_id":"764317fa-ba6a-468d-853d-2d61b3563ec2","uuid":"f55f5d60-130c-4bcc-9d3e-2bab56733fcb","timestamp":"2026-06-11T14:07:35.231Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/types.py","content":"\"\"\"Core enums and type definitions for the SilverquiLLM engine.\"\"\"\n\nfrom __future__ import annotations\n\nimport enum\nimport re\nfrom dataclasses import dataclass, field\nfrom typing import Any, Callable\n\n\nclass Color(enum.Enum):\n    \"\"\"The five colors of Magic.\"\"\"\n\n    WHITE = \"W\"\n    BLUE = \"U\"\n    BLACK = \"B\"\n    RED = \"R\"\n    GREEN = \"G\"\n\n\n# Single-letter aliases accessible as Color.W, Color.U, etc.\nColor.W = Color.WHITE  # type: ignore[attr-defined]\nColor.U = Color.BLUE  # type: ignore[attr-defined]\nColor.B = Color.BLACK  # type: ignore[attr-defined]\nColor.R = Color.RED  # type: ignore[attr-defined]\nColor.G = Color.GREEN  # type: ignore[attr-defined]\n\n\nclass ManaType(enum.Enum):\n    \"\"\"Mana types including colorless.\"\"\"\n\n    WHITE = \"W\"\n    BLUE = \"U\"\n    BLACK = \"B\"\n    RED = \"R\"\n    GREEN = \"G\"\n    COLORLESS = \"C\"\n\n\nclass Zone(enum.Enum):\n    \"\"\"Game zones.\"\"\"\n\n    BATTLEFIELD = \"battlefield\"\n    HAND = \"hand\"\n    LIBRARY = \"library\"\n    GRAVEYARD = \"graveyard\"\n    EXILE = \"exile\"\n    STACK = \"stack\"\n    COMMAND = \"command\"\n\n\nclass Phase(enum.Enum):\n    \"\"\"Turn phases.\"\"\"\n\n    BEGINNING = \"beginning\"\n    PRECOMBAT_MAIN = \"precombat_main\"\n    COMBAT = \"combat\"\n    POSTCOMBAT_MAIN = \"postcombat_main\"\n    ENDING = \"ending\"\n\n\nclass Step(enum.Enum):\n    \"\"\"Turn steps.\"\"\"\n\n    UNTAP = \"untap\"\n    UPKEEP = \"upkeep\"\n    DRAW = \"draw\"\n    BEGIN_COMBAT = \"begin_combat\"\n    DECLARE_ATTACKERS = \"declare_attackers\"\n    DECLARE_BLOCKERS = \"declare_blockers\"\n    COMBAT_DAMAGE = \"combat_damage\"\n    END_COMBAT = \"end_combat\"\n    END = \"end\"\n    CLEANUP = \"cleanup\"\n\n\nclass CardType(enum.Enum):\n    \"\"\"Card types.\"\"\"\n\n    CREATURE = \"creature\"\n    INSTANT = \"instant\"\n    SORCERY = \"sorcery\"\n    ENCHANTMENT = \"enchantment\"\n    ARTIFACT = \"artifact\"\n    PLANESWALKER = \"planeswalker\"\n    LAND = \"land\"\n\n\nclass Supertype(enum.Enum):\n    \"\"\"Card supertypes.\"\"\"\n\n    BASIC = \"basic\"\n    LEGENDARY = \"legendary\"\n    SNOW = \"snow\"\n\n\nclass Keyword(enum.Flag):\n    \"\"\"Evergreen keyword abilities (combinable via bitwise OR).\"\"\"\n\n    FLYING = enum.auto()\n    FIRST_STRIKE = enum.auto()\n    DOUBLE_STRIKE = enum.auto()\n    DEATHTOUCH = enum.auto()\n    TRAMPLE = enum.auto()\n    LIFELINK = enum.auto()\n    VIGILANCE = enum.auto()\n    REACH = enum.auto()\n    HASTE = enum.auto()\n    FLASH = enum.auto()\n    DEFENDER = enum.auto()\n    HEXPROOF = enum.auto()\n    INDESTRUCTIBLE = enum.auto()\n    MENACE = enum.auto()\n    WARD = enum.auto()\n    PROWESS = enum.auto()\n\n\n# Mapping from pip string to ManaType for parsing\n_PIP_MAP: dict[str, ManaType] = {\n    \"W\": ManaType.WHITE,\n    \"U\": ManaType.BLUE,\n    \"B\": ManaType.BLACK,\n    \"R\": ManaType.RED,\n    \"G\": ManaType.GREEN,\n    \"C\": ManaType.COLORLESS,\n}\n\n# Regex to tokenize a mana cost string like \"{2}{W}{U}\" or \"{X}{X}{R}\"\n_MANA_TOKEN_RE = re.compile(r\"\\{([^}]+)\\}\")\n\n# Regex to detect hybrid mana tokens like \"B/G\", \"W/U\", etc.\n_HYBRID_RE = re.compile(r\"^([WUBRGC])/([WUBRGC])$\")\n\n\n@dataclass(frozen=True)\nclass HybridManaSymbol:\n    \"\"\"A hybrid mana symbol that can be paid with either of two colors.\n\n    For example, ``{B/G}`` is represented as\n    ``HybridManaSymbol(option_a=ManaType.BLACK, option_b=ManaType.GREEN)``.\n    \"\"\"\n\n    option_a: ManaType\n    option_b: ManaType\n\n\n@dataclass(frozen=True)\nclass ManaCost:\n    \"\"\"Represents a mana cost.\n\n    Attributes:\n        generic: The generic (numerical) component of the cost.\n        pips: Mapping of colored/colorless mana pips to their counts.\n        x_count: Number of {X} symbols in the cost.\n        hybrid: List of hybrid mana symbols that can be paid with either option.\n    \"\"\"\n\n    generic: int = 0\n    pips: dict[ManaType, int] = field(default_factory=dict)\n    x_count: int = 0\n    hybrid: list[HybridManaSymbol] = field(default_factory=list)\n\n    @property\n    def cmc(self) -> int:\n        \"\"\"Converted mana cost (total mana value, treating X as 0).\n\n        Each hybrid symbol contributes 1 to the CMC.\n        \"\"\"\n        return self.generic + sum(self.pips.values()) + len(self.hybrid)\n\n    @classmethod\n    def parse(cls, cost_str: str) -> ManaCost:\n        \"\"\"Parse a mana cost string like ``\"{2}{W}{U}\"`` into a ManaCost.\n\n        Supports generic mana (``{N}``), colored pips (``{W}``, ``{U}``, ``{B}``,\n        ``{R}``, ``{G}``), colorless pips (``{C}``), and X costs (``{X}``).\n\n        Raises:\n            ValueError: If *cost_str* is empty, contains no valid tokens, or\n                includes an unrecognised pip symbol.\n        \"\"\"\n        if not cost_str or not cost_str.strip():\n            raise ValueError(f\"Invalid mana cost string: {cost_str!r}\")\n\n        tokens = _MANA_TOKEN_RE.findall(cost_str)\n        if not tokens:\n            raise ValueError(f\"Invalid mana cost string: {cost_str!r}\")\n\n        # Verify that the entire input is consumed by brace tokens (no extra\n        # characters outside braces such as trailing junk or stray spaces).\n        reconstructed = \"\".join(f\"{{{t}}}\" for t in tokens)\n        if reconstructed != cost_str:\n            raise ValueError(f\"Invalid mana cost string: {cost_str!r}\")\n\n        generic = 0\n        pips: dict[ManaType, int] = {}\n        x_count = 0\n        hybrid: list[HybridManaSymbol] = []\n\n        for token in tokens:\n            upper = token.upper()\n            if upper == \"X\":\n                x_count += 1\n            elif upper in _PIP_MAP:\n                mana_type = _PIP_MAP[upper]\n                pips[mana_type] = pips.get(mana_type, 0) + 1\n            else:\n                # Check for hybrid mana like \"B/G\"\n                hybrid_match = _HYBRID_RE.match(upper)\n                if hybrid_match:\n                    a_str, b_str = hybrid_match.group(1), hybrid_match.group(2)\n                    if a_str not in _PIP_MAP or b_str not in _PIP_MAP:\n                        raise ValueError(\n                            f\"Unrecognised mana symbol {token!r} in cost string {cost_str!r}\"\n                        )\n                    hybrid.append(\n                        HybridManaSymbol(\n                            option_a=_PIP_MAP[a_str], option_b=_PIP_MAP[b_str]\n                        )\n                    )\n                else:\n                    # Try to parse as a number (generic mana)\n                    try:\n                        value = int(token)\n                    except ValueError:\n                        raise ValueError(\n                            f\"Unrecognised mana symbol {token!r} in cost string {cost_str!r}\"\n                        ) from None\n                    if value < 0:\n                        raise ValueError(\n                            f\"Negative generic mana {token!r} in cost string {cost_str!r}\"\n                        )\n                    generic += value\n\n        return cls(generic=generic, pips=pips, x_count=x_count, hybrid=hybrid)\n\n\n@dataclass\nclass TargetRequirement:\n    \"\"\"Describes a targeting requirement for a spell or ability.\n\n    Attributes:\n        filter_fn: A callable that accepts a game object and returns True\n            if the object is a legal target.  Filters should evaluate the\n            object's properties at call time (lazy) rather than capturing\n            a snapshot of legal targets when the filter is created.\n        description: Human-readable description of what this targets.\n        zone: The zone in which legal targets must reside.\n    \"\"\"\n\n    filter_fn: Callable[..., Any]\n    description: str\n    zone: Zone\n","numLines":254,"startLine":1,"totalLines":254}}}
