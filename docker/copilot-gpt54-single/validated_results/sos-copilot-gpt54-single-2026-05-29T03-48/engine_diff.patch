+    def flip_coins(self, count: int) -> list[bool]:
+        """Flip *count* coins and return their results."""
+        if count <= 0:
+            return []
+        return [self.flip_coin() for _ in range(count)]
+
+    # ------------------------------------------------------------------
+    # Skip-turn support
+    # ------------------------------------------------------------------
+
+    def schedule_skip_next_turns(self, player: Player, count: int) -> None:
+        """Schedule *player* to skip their next *count* turns."""
+        if count <= 0:
+            return
+        try:
+            player_index = self.players.index(player)
+        except ValueError:
+            return
+        self._skipped_turns[player_index] = self._skipped_turns.get(player_index, 0) + count
+
