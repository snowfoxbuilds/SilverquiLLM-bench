+
+    @staticmethod
+    def _current_controller(trigger: TriggerRegistration) -> Player | None:
+        """Return the trigger's current controller for ordering and stack setup."""
+        if trigger.controller_getter is not None:
+            controller = trigger.controller_getter()
+            if controller is not None:
+                return controller
+        return trigger.controller
+
+    def _build_resolve_callback(
+        self,
+        trigger: TriggerRegistration,
+        stack_obj: StackObject,
+    ) -> Callable[[GameState], None]:
+        """Build a resolution callback for a triggered stack object."""
+        def _on_resolve(game: GameState) -> None:
+            validated_targets = self._validate_targets(
+                game,
+                stack_obj.targets,
+                stack_obj.target_requirements,
+            )
+            if stack_obj.target_requirements and not any(
+                target is not None for target in validated_targets
+            ):
+                return
+
+            if hasattr(trigger.source, "__dict__"):
+                trigger.source.chosen_targets = validated_targets
+                trigger.source.triggering_event = stack_obj.triggering_event
+
+            trigger.effect(game)
+
+        return _on_resolve
+
+    def _choose_targets(
+        self,
+        game: GameState,
+        controller: Player,
+        requirements: list[TargetRequirement],
+    ) -> list[Any] | None:
+        """Choose targets for a triggered ability when it is put on the stack."""
+        chosen_targets: list[Any] = []
+        for requirement in requirements:
+            legal_targets = [
+                obj for obj in self._objects_in_zone(game, requirement.zone)
+                if self._is_legal_target(game, obj, requirement)
+            ]
+            if not legal_targets:
+                return None
+            chosen = controller.choose_card(legal_targets, requirement.description)
+            if not self._is_legal_target(game, chosen, requirement):
+                return None
+            chosen_targets.append(chosen)
+        return chosen_targets
+
+    def _validate_targets(
+        self,
+        game: GameState,
+        chosen_targets: list[Any],
+        requirements: list[TargetRequirement],
+    ) -> list[Any]:
+        """Recheck target legality on resolution."""
+        if not requirements:
+            return list(chosen_targets)
+
+        validated_targets: list[Any] = []
+        for idx, requirement in enumerate(requirements):
+            target = chosen_targets[idx] if idx < len(chosen_targets) else None
+            if self._is_legal_target(game, target, requirement):
+                validated_targets.append(target)
+            else:
+                validated_targets.append(None)
+        return validated_targets
+
+    @staticmethod
+    def _objects_in_zone(game: GameState, zone: Zone) -> list[Any]:
+        """Return every object currently in *zone* across all players."""
+        objects: list[Any] = []
+        for player in game.players:
+            objects.extend(player.zones[zone].get_all())
+        return objects
+
+    def _is_legal_target(
+        self,
+        game: GameState,
+        target: Any,
+        requirement: TargetRequirement,
+    ) -> bool:
+        """Return True if *target* currently satisfies *requirement*."""
+        if target is None:
+            return False
+        if target not in self._objects_in_zone(game, requirement.zone):
+            return False
+        filter_fn = getattr(requirement, "filter_fn", None)
+        if filter_fn is not None and not filter_fn(target):
+            return False
+        return True
