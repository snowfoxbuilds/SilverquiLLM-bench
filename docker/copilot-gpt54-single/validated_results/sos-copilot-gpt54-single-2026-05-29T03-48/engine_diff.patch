+        """Return how many future turns *player* will skip."""
+        try:
+            player_index = self.players.index(player)
+        except ValueError:
+            return 0
+        return self._skipped_turns.get(player_index, 0)
+
+    def get_skipped_turns(self, player: Player) -> int:
+        """Alias for :meth:`remaining_skipped_turns`."""
+        return self.remaining_skipped_turns(player)
+
+    def _consume_skip_for_player_index(self, player_index: int) -> bool:
+        """Return True if *player_index* had a pending skipped turn to consume."""
+        remaining = self._skipped_turns.get(player_index, 0)
+        if remaining <= 0:
+            return False
+        if remaining == 1:
+            del self._skipped_turns[player_index]
+        else:
+            self._skipped_turns[player_index] = remaining - 1
+        return True
+
+    def _get_next_turn_player_index(self) -> int:
+        """Return the next player who will actually take a turn.
+
+        Pending skip-next-turn effects consume future turns, including queued
+        extra turns. Normal turn rotation continues to advance across skipped
+        normal turns.
+        """
+        while True:
+            if self.extra_turns:
+                candidate = self.extra_turns.pop(0)
+            else:
+                candidate = self._normal_next_index
+                self._normal_next_index = 1 - self._normal_next_index
+            if not self._consume_skip_for_player_index(candidate):
+                return candidate
