+    def declare_loyalty_targets(
+        self,
+        game: GameState,
+        ability_index: int,
+        player: Player | None = None,
+    ) -> list[Any]:
+        """Choose and store loyalty-ability targets using the controller's chooser.
+
+        Stores the chosen targets on ``chosen_targets`` and the common
+        single-/multi-target backdoor attributes used throughout the current
+        card implementations.
+        """
+        chooser = player if player is not None else self.controller
+        target_specs = self.get_loyalty_targets(game, ability_index)
+        chosen_targets: list[Any] = []
+        if chooser is None or not target_specs:
+            self.chosen_targets = chosen_targets  # type: ignore[attr-defined]
+            self._resolve_targets = chosen_targets  # type: ignore[attr-defined]
+            self._resolve_target = None  # type: ignore[attr-defined]
+            return chosen_targets
+
+        for spec in target_specs:
+            filter_fn = getattr(spec, "filter_fn", None)
+            min_targets = getattr(spec, "min_targets", 1)
+            max_targets = getattr(spec, "max_targets", 1)
+            target = chooser.choose_target(target_specs, spec)
+
+            if max_targets != 1 or min_targets != 1:
+                if target is None:
+                    selected_targets: list[Any] = []
+                elif isinstance(target, (list, tuple, set)):
+                    selected_targets = list(target)
+                else:
+                    selected_targets = [target]
+
+                if len({id(obj) for obj in selected_targets}) != len(selected_targets):
+                    raise ValueError(
+                        "Chosen loyalty targets must be distinct: "
+                        f"{getattr(spec, 'description', '')}"
+                    )
+                if len(selected_targets) < min_targets:
+                    raise ValueError(
+                        "Chosen loyalty targets do not satisfy minimum target count: "
+                        f"{getattr(spec, 'description', '')}"
+                    )
+                if max_targets is not None and len(selected_targets) > max_targets:
+                    raise ValueError(
+                        "Chosen loyalty targets exceed maximum target count: "
+                        f"{getattr(spec, 'description', '')}"
+                    )
+                if filter_fn is not None:
+                    for selected_target in selected_targets:
+                        if not filter_fn(selected_target):
+                            raise ValueError(
+                                "Chosen loyalty target does not satisfy filter: "
+                                f"{getattr(spec, 'description', '')}"
+                            )
