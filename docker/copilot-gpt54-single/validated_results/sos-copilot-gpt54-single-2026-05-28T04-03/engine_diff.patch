+
+            if filter_fn is not None and target is not None and not filter_fn(target):
+                raise ValueError(
+                    "Chosen loyalty target does not satisfy filter: "
+                    f"{getattr(spec, 'description', '')}"
+                )
+            chosen_targets.append(target)
+
+        self.chosen_targets = chosen_targets  # type: ignore[attr-defined]
+        self._resolve_targets = chosen_targets  # type: ignore[attr-defined]
+        self._resolve_target = chosen_targets[0] if chosen_targets else None  # type: ignore[attr-defined]
