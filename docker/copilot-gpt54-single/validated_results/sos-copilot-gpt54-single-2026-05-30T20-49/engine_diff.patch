+def _get_effective_cost(
+    game: GameState,
+    card: CardImpl,
+    controller: Player,
+    base_cost: ManaCost,
+) -> ManaCost:
+    """Return *base_cost* after applying the card's generic cost reduction."""
+    reduction = get_cost_reduction(game, card, controller, base_cost=base_cost)
+    if reduction <= 0:
+        return base_cost
+    return _apply_cost_reduction(base_cost, reduction)
+
+
+def get_target_options(game: GameState, requirement: Any) -> list[Any]:
+    """Return the current legal objects for a target requirement."""
+    zone = getattr(requirement, "zone", None)
+    if zone is None:
+        return []
+
+    filter_fn = getattr(requirement, "filter_fn", None)
+
+    if zone == Zone.STACK:
+        candidates = game.stack.objects()
+    else:
+        candidates = []
+        for player in game.players:
+            if zone == Zone.BATTLEFIELD and filter_fn is not None and filter_fn(player):
+                candidates.append(player)
+            candidates.extend(player.zones[zone].get_all())
+
+    if filter_fn is None:
+        return candidates
+    return [candidate for candidate in candidates if filter_fn(candidate)]
+
+
+def validate_target_choice(
+    options: list[Any],
+    requirement: Any,
+    target: Any,
+    *,
+    allow_none: bool = False,
+) -> bool:
+    """Return whether *target* is a legal choice for *requirement*."""
+    if target is None:
+        return allow_none
+    if target not in options:
+        return False
+    filter_fn = getattr(requirement, "filter_fn", None)
+    if filter_fn is None:
+        return True
+    return bool(filter_fn(target))
+
+
+def _get_granted_casualty_instances(
+    game: GameState,
+    player: Player,
+    card: CardImpl,
+) -> list[tuple[Any, int]]:
+    """Return each battlefield source that grants casualty to *card*."""
+    card_types = getattr(card, "card_types", set())
+    if CardType.INSTANT not in card_types and CardType.SORCERY not in card_types:
+        return []
+
+    instances: list[tuple[Any, int]] = []
+    for permanent in game.get_battlefield(player).get_all():
+        provider = getattr(permanent, "granted_casualty_value_for", None)
+        if not callable(provider):
+            continue
+        value = provider(game, card)
+        if value is None:
+            continue
+        try:
+            casualty_value = int(value)
+        except (TypeError, ValueError):
+            continue
+        if casualty_value > 0:
+            instances.append((permanent, casualty_value))
+
+    return instances
+
+
+def _get_casualty_sacrifice_options(
+    casualty_value: int,
+    permanents: list[Any],
+) -> list[Any]:
+    """Return creatures from *permanents* that may be sacrificed to pay casualty."""
+    eligible: list[Any] = []
+    for permanent in permanents:
+        card_types = getattr(permanent, "card_types", set())
+        if CardType.CREATURE not in card_types:
+            continue
+        power = getattr(permanent, "power", getattr(permanent, "base_power", 0))
+        if power >= casualty_value:
+            eligible.append(permanent)
+    return eligible
+
+
+def _get_target_options_excluding(
+    game: GameState,
+    requirement: Any,
+    *,
+    excluded_battlefield_objects: list[Any] | None = None,
+) -> list[Any]:
+    """Return legal target options while treating some battlefield objects as absent."""
+    options = get_target_options(game, requirement)
+    if not excluded_battlefield_objects:
+        return options
+    if getattr(requirement, "zone", None) != Zone.BATTLEFIELD:
+        return options
+    return [
+        candidate
+        for candidate in options
+        if not any(candidate is excluded for excluded in excluded_battlefield_objects)
+    ]
+
+
+def _choose_copy_targets(
+    game: GameState,
+    controller: Player,
+    original: StackObject,
+    *,
+    excluded_battlefield_objects: list[Any] | None = None,
+) -> list[Any] | None:
+    """Offer new targets for a copied spell."""
+    if not original.targets or not original.target_requirements:
+        return None
+    if not controller.choose_yes_no(
+        f"Choose new targets for copy of {getattr(original.source, 'name', 'that spell')}?"
+    ):
+        return None
+
+    new_targets: list[Any] = []
+    for requirement in original.target_requirements:
+        options = _get_target_options_excluding(
+            game,
+            requirement,
+            excluded_battlefield_objects=excluded_battlefield_objects,
+        )
+        if not options:
+            return None
+        chosen = controller.choose_target(options, requirement)
+        if not validate_target_choice(options, requirement, chosen):
+            raise CastingError(
+                f"Cannot copy {getattr(original.source, 'name', 'that spell')!r} "
+                "— chosen target does not satisfy its target requirement"
+            )
+        new_targets.append(chosen)
+    return new_targets
+
+
+def _plan_granted_casualty(
+    game: GameState,
+    player: Player,
+    card: CardImpl,
+    stack_obj: StackObject,
+) -> list[tuple[Any, list[Any] | None]]:
+    """Plan all granted casualty payments and target choices without mutating state."""
+    casualty_instances = _get_granted_casualty_instances(game, player, card)
+    if not casualty_instances:
+        return []
+
+    available_permanents = list(game.get_battlefield(player).get_all())
+    planned_sacrifices: list[Any] = []
+    casualty_plan: list[tuple[Any, list[Any] | None]] = []
+
+    for source, casualty_value in casualty_instances:
+        eligible = _get_casualty_sacrifice_options(
+            casualty_value,
+            [permanent for permanent in available_permanents if permanent is not source],
+        )
+        if not eligible:
+            continue
+
+        if not player.choose_yes_no(
+            f"Sacrifice a creature with power {casualty_value} or greater "
+            f"for casualty {casualty_value} on {card.name}?"
+        ):
+            continue
+
+        chosen = player.choose_card(
+            eligible,
+            f"Choose a creature to sacrifice for casualty {casualty_value}",
+        )
+        if chosen not in eligible:
+            raise CastingError(
+                f"Cannot cast {card.name!r} — chosen casualty sacrifice is illegal"
+            )
+
+        available_permanents = [
+            permanent for permanent in available_permanents if permanent is not chosen
+        ]
+        planned_sacrifices.append(chosen)
+        new_targets = _choose_copy_targets(
+            game,
+            player,
+            stack_obj,
+            excluded_battlefield_objects=planned_sacrifices,
+        )
+        casualty_plan.append((chosen, new_targets))
+
+    return casualty_plan
+
+
+def _apply_granted_casualty(
+    game: GameState,
+    player: Player,
+    stack_obj: StackObject,
+    casualty_plan: list[tuple[Any, list[Any] | None]],
+) -> None:
+    """Apply prevalidated casualty payments to a just-cast spell."""
+    if not casualty_plan:
+        return
+
+    from engine.game import sacrifice
+
+    for chosen, new_targets in casualty_plan:
+        sacrifice(game, player, chosen)
+        game.stack.push(copy_spell(game, stack_obj, player, new_targets))
+
