--- a/miracle.py	1970-01-01 00:00:00.000000000 +0000
+++ b/miracle.py	2026-05-30 22:59:52.890521315 +0000
@@ -0,0 +1,106 @@
+"""Miracle-granting and miracle-casting helpers."""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any
+
+from engine.types import CardType, ManaCost, Zone
+
+if TYPE_CHECKING:
+    from engine.card import CardImpl
+    from engine.game_state import GameState
+    from engine.player import Player
+
+
+def is_instant_or_sorcery_card(card: Any) -> bool:
+    """Return whether *card* is an instant or sorcery card."""
+    card_types = getattr(card, "card_types", set())
+    return CardType.INSTANT in card_types or CardType.SORCERY in card_types
+
+
+def get_granted_miracle_cost(card: Any) -> ManaCost | None:
+    """Return the card's currently granted miracle cost, if any."""
+    getter = getattr(card, "get_granted_miracle_cost", None)
+    if callable(getter):
+        return getter()
+    return None
+
+
+def card_has_granted_miracle(card: Any) -> bool:
+    """Return whether *card* currently has miracle from any grant."""
+    return get_granted_miracle_cost(card) is not None
+
+
+def refresh_hand_miracle_grants(game: GameState, player: Player | None) -> None:
+    """Recompute miracle grants on cards in *player*'s hand."""
+    if player is None:
+        return
+
+    hand_cards = list(game.get_hand(player).get_all())
+    for card in hand_cards:
+        revoke = getattr(card, "revoke_miracle", None)
+        if callable(revoke):
+            revoke()
+
+    for permanent in game.get_battlefield(player).get_all():
+        provider = getattr(permanent, "granted_miracle_cost_for", None)
+        if not callable(provider):
+            continue
+        for card in hand_cards:
+            cost = provider(game, card)
+            if cost is None:
+                continue
+            grant = getattr(card, "grant_miracle", None)
+            if callable(grant):
+                grant(cost, source=permanent)
+
+
+def can_cast_for_miracle(game: GameState, player: Player, card: CardImpl) -> bool:
+    """Return whether *card* is eligible to be cast for miracle now."""
+    if not game.get_hand(player).contains(card):
+        return False
+    if not card_has_granted_miracle(card):
+        return False
+    return game.is_first_card_drawn_this_turn(player, card)
+
+
+def cast_card_for_miracle(game: GameState, player: Player, card: CardImpl) -> bool:
+    """Cast *card* from hand for its miracle cost if possible."""
+    from engine.casting import CastingError, cast_spell_with_alternative_cost
+
+    miracle_cost = get_granted_miracle_cost(card)
+    if miracle_cost is None or not can_cast_for_miracle(game, player, card):
+        return False
+
+    try:
+        cast_spell_with_alternative_cost(
+            game,
+            player,
+            card,
+            miracle_cost,
+            ignore_timing=True,
+            cast_reason="miracle",
+        )
+    except CastingError:
+        return False
+    return True
+
+
+def offer_miracle_cast(game: GameState, player: Player, card: CardImpl) -> bool:
+    """Offer the player an immediate miracle cast for a just-drawn card."""
+    if not can_cast_for_miracle(game, player, card):
+        return False
+
+    try:
+        should_cast = bool(
+            player.choose_yes_no(
+                f"Cast {getattr(card, 'name', 'that card')} for its miracle cost?"
+            )
+        )
+    except Exception:
+        should_cast = False
+
+    if not should_cast:
+        return False
+
+    return cast_card_for_miracle(game, player, card)
