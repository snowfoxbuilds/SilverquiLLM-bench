+    def set_coin_flip_results(self, results: list[bool]) -> None:
+        """Seed deterministic coin-flip results for this card.
+
+        Results are consumed in order, with ``True`` meaning heads and
+        ``False`` meaning tails.
+        """
+        self._coin_flip_results = deque(bool(result) for result in results)
+
+    def queue_coin_flip_results(self, *results: bool) -> None:
+        """Append deterministic coin-flip results for future flips."""
+        self._coin_flip_results.extend(bool(result) for result in results)
+
+    @staticmethod
+    def _consume_coin_flip_result(holder: Any) -> bool | None:
+        """Pop one queued coin-flip result from *holder*, if present."""
+        if holder is None:
+            return None
+
+        for attr_name in ("_coin_flip_results", "coin_flip_results"):
+            queue = getattr(holder, attr_name, None)
+            if queue is None:
+                continue
+            if isinstance(queue, deque):
+                if queue:
+                    return bool(queue.popleft())
+            elif isinstance(queue, list):
+                if queue:
+                    return bool(queue.pop(0))
+            elif hasattr(queue, "popleft"):
+                try:
+                    return bool(queue.popleft())
+                except IndexError:
+                    continue
+            elif hasattr(queue, "pop") and hasattr(queue, "__len__") and len(queue) > 0:
+                try:
+                    return bool(queue.pop(0))
+                except TypeError:
+                    return bool(queue.pop())
+
+        return None
+
+    def flip_coin(self, game: GameState | None = None, *, player: Player | None = None) -> bool:
+        """Return a coin-flip result.
+
+        Deterministic queues are checked first on this card, then on the
+        passed player, then on this card's controller, then on the game
+        state.  If no queued result is available, a random flip is used.
+        """
+        for holder in (self, player, getattr(self, "controller", None), game):
+            queued_result = self._consume_coin_flip_result(holder)
+            if queued_result is not None:
+                self.last_coin_flip_results = [queued_result]
+                return queued_result
+
+        result = random.choice((True, False))
+        self.last_coin_flip_results = [result]
+        return result
+
+    def flip_coins(self, game: GameState | None, count: int, *, player: Player | None = None) -> list[bool]:
+        """Flip *count* coins and return the ordered results.
+
+        ``True`` represents heads and ``False`` represents tails.
+        """
+        if count <= 0:
+            self.last_coin_flip_results = []
+            return []
+
+        results = [self.flip_coin(game, player=player) for _ in range(count)]
+        self.last_coin_flip_results = list(results)
+        return results
+
 
