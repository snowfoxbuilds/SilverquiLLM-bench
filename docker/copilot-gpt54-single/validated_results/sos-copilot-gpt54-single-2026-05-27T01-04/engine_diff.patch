+    def make_spell_type_mana_restriction(
+        allowed_types: set[CardType] | frozenset[CardType] | tuple[CardType, ...] | list[CardType],
+        *,
+        description: str,
+    ) -> Any:
+        """Return a shared mana restriction for casting spells of *allowed_types*."""
