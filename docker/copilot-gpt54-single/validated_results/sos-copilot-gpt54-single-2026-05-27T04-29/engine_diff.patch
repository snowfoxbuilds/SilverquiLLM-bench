+        return False
+
+    casualty_value = casualty_getter(game, player)
+    if not isinstance(casualty_value, int) or casualty_value <= 0:
+        return False
+
+    battlefield = game.get_battlefield(player)
+    candidates = [
+        permanent
+        for permanent in battlefield.get_all()
+        if CardType.CREATURE in getattr(permanent, "card_types", set())
+        and getattr(permanent, "power", 0) >= casualty_value
+    ]
+    if not candidates:
+        return False
+
+    if not player.choose_yes_no(f"Sacrifice a creature to pay casualty {casualty_value}?"):
+        return False
+
+    chosen_permanent = player.choose_card(
+        candidates,
+        f"Choose a creature with power {casualty_value} or greater to sacrifice",
+    )
+    if chosen_permanent not in candidates:
+        return False
+
+    from engine.game import sacrifice
+
+    sacrifice(game, player, chosen_permanent)
