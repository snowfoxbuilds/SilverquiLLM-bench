+def _coerce_color(value: Any) -> Color | None:
+    """Normalize a color-like value to :class:`Color`."""
+    if isinstance(value, Color):
+        return value
+    if isinstance(value, ManaType):
+        if value is ManaType.COLORLESS:
+            return None
+        return Color(value.value)
+    if isinstance(value, str):
+        normalized = value.strip().upper()
+        if not normalized or normalized == ManaType.COLORLESS.value:
+            return None
+        for color in Color:
+            if color.value == normalized:
+                return color
+    return None
+
+
+def _colors_from_mana_cost(mana_cost: ManaCost | None) -> set[Color]:
+    """Derive a card's colors from its mana cost."""
+    if mana_cost is None:
+        return set()
+    colors: set[Color] = set()
+    for mana_type in getattr(mana_cost, "pips", {}):
+        color = _coerce_color(mana_type)
+        if color is not None:
+            colors.add(color)
+    for hybrid_symbol in getattr(mana_cost, "hybrid", []):
+        for mana_type in (hybrid_symbol.option_a, hybrid_symbol.option_b):
+            color = _coerce_color(mana_type)
+            if color is not None:
+                colors.add(color)
+    return colors
+
+
+def _normalize_colors(colors: Any, mana_cost: ManaCost | None = None) -> set[Color]:
+    """Return a normalized set of :class:`Color` values."""
+    if colors is None:
+        return _colors_from_mana_cost(mana_cost)
+    normalized: set[Color] = set()
+    for value in colors:
+        color = _coerce_color(value)
+        if color is not None:
+            normalized.add(color)
+    return normalized
+
