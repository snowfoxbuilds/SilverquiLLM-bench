+def _find_legal_targets(game: GameState, requirement: Any) -> list[Any]:
+    """Return the legal targets that satisfy *requirement*."""
+    zone = getattr(requirement, "zone", None)
+    filter_fn = getattr(requirement, "filter_fn", None)
+
+    legal_targets: list[Any] = []
+    for player in game.players:
+        try:
+            matches_player = filter_fn(player) if filter_fn is not None else False
+        except Exception:
+            matches_player = False
+        if matches_player:
+            legal_targets.append(player)
+
+    if zone is None:
+        return legal_targets
+
+    if zone is Zone.STACK:
+        zone_objects = game.stack.objects()
+    else:
+        zone_objects = [
+            obj
+            for player in game.players
+            for obj in player.zones[zone].get_all()
+        ]
+
+    for obj in zone_objects:
+        if filter_fn is None or filter_fn(obj):
+            legal_targets.append(obj)
+    return legal_targets
+
+
+def _is_legal_copy_target(source: Any, target: Any) -> bool:
+    """Return ``True`` if *target* may legally be chosen for a copied spell."""
+    from engine.protection import has_protection_from
+
+    return not has_protection_from(target, source)
+
