     def clear(self) -> None:
         """Remove all registered triggers."""
         self._triggers.clear()
+
+    @staticmethod
+    def _get_target_requirements(
+        game: GameState,
+        trigger: TriggerRegistration,
+        event: TriggeredEvent,
+    ) -> list[Any]:
+        if trigger.get_targets is None:
+            return []
+        requirements = trigger.get_targets(game, event)
+        return list(requirements) if requirements else []
+
+    def _choose_targets(
+        self,
+        game: GameState,
+        trigger: TriggerRegistration,
+        target_requirements: list[Any],
+    ) -> list[Any]:
+        if not target_requirements:
+            return []
+
+        chosen_targets: list[Any] = []
+        for requirement in target_requirements:
+            legal_targets = self._find_legal_targets(game, requirement)
+            if not legal_targets:
+                return []
+
+            choice = trigger.controller.choose_target(legal_targets, requirement)
+            if choice not in legal_targets and legal_targets:
+                choice = legal_targets[0]
+            chosen_targets.append(choice)
+        return chosen_targets
+
+    def _make_on_resolve(
+        self,
+        trigger: TriggerRegistration,
+        target_requirements: list[Any],
+        chosen_targets: list[Any],
+    ) -> Callable[[GameState], None]:
+        def _on_resolve(game: GameState) -> None:
+            legal_targets = self._recheck_targets(game, target_requirements, chosen_targets)
+            try:
+                setattr(trigger.source, "chosen_targets", legal_targets)
+            except (AttributeError, TypeError):
+                pass
+            if target_requirements and not legal_targets:
+                return
+            trigger.effect(game)
+
+        return _on_resolve
+
+    @staticmethod
+    def _find_legal_targets(game: GameState, requirement: Any) -> list[Any]:
+        zone = getattr(requirement, "zone", None)
+        filter_fn = getattr(requirement, "filter_fn", None)
+
+        legal_targets: list[Any] = []
+        for player in game.players:
+            try:
+                matches_player = filter_fn(player) if filter_fn is not None else False
+            except Exception:
+                matches_player = False
+            if matches_player:
+                legal_targets.append(player)
+
+        if zone is None:
+            return legal_targets
+
+        for player in game.players:
+            for obj in player.zones[zone].get_all():
+                if filter_fn is None or filter_fn(obj):
+                    legal_targets.append(obj)
+        return legal_targets
+
+    @classmethod
+    def _recheck_targets(
+        cls,
+        game: GameState,
+        target_requirements: list[Any],
+        chosen_targets: list[Any],
+    ) -> list[Any]:
+        if not target_requirements:
+            return list(chosen_targets)
+
+        legal_targets: list[Any] = []
+        for requirement, chosen in zip(target_requirements, chosen_targets):
+            if chosen is None:
+                continue
+            legal_now = cls._find_legal_targets(game, requirement)
+            if any(candidate is chosen for candidate in legal_now):
+                legal_targets.append(chosen)
+        return legal_targets
