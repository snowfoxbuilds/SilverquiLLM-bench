+def _choose_copy_targets(
+    game: GameState,
+    player: Player,
+    original_stack_obj: StackObject,
+) -> list[Any] | None:
+    """Let *player* choose new targets for a copied spell."""
+    requirements = list(getattr(original_stack_obj, "target_requirements", []))
+    if not requirements:
+        requirements = list(getattr(original_stack_obj.source, "get_targets", lambda _game: [])(game))
+    if not requirements:
+        return None
+
+    original_targets = list(getattr(original_stack_obj, "targets", []))
+    new_targets: list[Any] = []
+
+    for index, requirement in enumerate(requirements):
+        legal_targets = [
+            candidate
+            for candidate in _find_legal_targets(game, requirement)
+            if _is_legal_copy_target(original_stack_obj.source, candidate)
+        ]
+        fallback_target = original_targets[index] if index < len(original_targets) else None
+        if not legal_targets:
+            new_targets.append(fallback_target)
+            continue
+
+        chosen_target = player.choose_target(legal_targets, requirement)
+        if chosen_target not in legal_targets:
+            chosen_target = fallback_target
+        new_targets.append(chosen_target)
+
+    if len(original_targets) > len(requirements):
+        new_targets.extend(original_targets[len(requirements):])
+    return new_targets
+
+
+def _pay_casualty_cost(
+    game: GameState,
