+def _get_legal_targets_for_requirement(
+    game: GameState,
+    requirement: Any,
+    *,
+    source: CardImpl | None = None,
+) -> list[Any]:
+    """Return all currently legal objects satisfying *requirement*."""
+    from engine.protection import has_protection_from
+
+    filter_fn = getattr(requirement, "filter_fn", None)
+    zone = getattr(requirement, "zone", None)
+    if zone is None:
+        return []
+
+    legal_targets: list[Any] = []
+    for player in game.players:
+        zone_container = player.zones[zone]
+        for obj in zone_container.get_all():
+            if filter_fn is not None and not filter_fn(obj):
+                continue
+            if source is not None and has_protection_from(obj, source):
+                continue
+            legal_targets.append(obj)
+    return legal_targets
+
+
+def spell_has_legal_targets(game: GameState, card: CardImpl) -> bool:
+    """Return ``True`` if *card* can currently satisfy all target requirements."""
+    target_specs = card.get_targets(game)
+    if not target_specs:
+        return True
+    return all(
+        bool(_get_legal_targets_for_requirement(game, spec, source=card))
+        for spec in target_specs
+    )
