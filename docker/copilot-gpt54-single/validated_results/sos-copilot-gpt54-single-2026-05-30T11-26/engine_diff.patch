+from engine.types import CardType, Color, Keyword, ManaCost, ManaType, Supertype
 
 if TYPE_CHECKING:
     from engine.game_state import GameState
     from engine.player import Player
 
 
+_MANA_TYPE_TO_COLOR: dict[ManaType, Color] = {
+    ManaType.WHITE: Color.WHITE,
+    ManaType.BLUE: Color.BLUE,
+    ManaType.BLACK: Color.BLACK,
+    ManaType.RED: Color.RED,
+    ManaType.GREEN: Color.GREEN,
+}
+
+
+def _normalize_color_symbol(value: Color | ManaType | str) -> Color:
+    """Normalize a color-like value to a :class:`Color`."""
+    if isinstance(value, Color):
+        return value
+    if isinstance(value, ManaType):
+        if value not in _MANA_TYPE_TO_COLOR:
+            raise ValueError(f"{value!r} is not a colored mana type")
+        return _MANA_TYPE_TO_COLOR[value]
+
+    token = str(value).strip().upper()
+    if token in {"WHITE", "W"}:
+        return Color.WHITE
+    if token in {"BLUE", "U"}:
+        return Color.BLUE
+    if token in {"BLACK", "B"}:
+        return Color.BLACK
+    if token in {"RED", "R"}:
+        return Color.RED
+    if token in {"GREEN", "G"}:
+        return Color.GREEN
+    raise ValueError(f"Unrecognized color symbol: {value!r}")
+
+
+def _colors_from_mana_cost(cost: ManaCost | None) -> set[Color]:
+    """Derive a card's color set from its mana cost."""
+    if cost is None:
+        return set()
+
+    colors: set[Color] = set()
+    for mana_type, count in cost.pips.items():
+        if count > 0 and mana_type in _MANA_TYPE_TO_COLOR:
+            colors.add(_MANA_TYPE_TO_COLOR[mana_type])
+    for hybrid in cost.hybrid:
+        if hybrid.option_a in _MANA_TYPE_TO_COLOR:
+            colors.add(_MANA_TYPE_TO_COLOR[hybrid.option_a])
+        if hybrid.option_b in _MANA_TYPE_TO_COLOR:
+            colors.add(_MANA_TYPE_TO_COLOR[hybrid.option_b])
+    return colors
+
+
