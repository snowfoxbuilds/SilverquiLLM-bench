+def _get_granted_casualty_value(
+    game: GameState,
+    player: Player,
+    card: CardImpl,
+) -> int:
+    """Return the casualty value granted to *card* by the player's battlefield."""
+    if not card.card_types & {CardType.INSTANT, CardType.SORCERY}:
+        return 0
+
+    casualty_value = 0
+    for permanent in game.get_battlefield(player).get_all():
+        grant_fn = getattr(permanent, "granted_casualty_value", None)
+        if not callable(grant_fn):
+            continue
+        granted = int(grant_fn(game, card, player) or 0)
+        casualty_value = max(casualty_value, granted)
+    return casualty_value
+
+
+def _get_granted_cost_reduction(
+    game: GameState,
+    player: Player,
+    card: CardImpl,
+    mana_cost: ManaCost | None = None,
+) -> int:
+    """Return total generic mana reduction granted by the player's battlefield."""
+    reduction = 0
+    for permanent in game.get_battlefield(player).get_all():
+        grant_fn = getattr(permanent, "granted_cost_reduction", None)
+        if not callable(grant_fn):
+            continue
+        granted = int(grant_fn(game, card, player, mana_cost) or 0)
+        if granted > 0:
+            reduction += granted
+    return reduction
+
+
+def _get_casualty_candidates(
+    game: GameState,
+    player: Player,
+    casualty_value: int,
+) -> list[Any]:
+    """Return creatures the player may sacrifice to satisfy casualty."""
+    candidates: list[Any] = []
+    for permanent in game.get_battlefield(player).get_all():
+        if CardType.CREATURE not in getattr(permanent, "card_types", set()):
+            continue
+        power = getattr(permanent, "power", getattr(permanent, "base_power", 0))
+        if power >= casualty_value:
+            candidates.append(permanent)
+    return candidates
+
+
+def _get_target_options(game: GameState, requirement: Any) -> list[Any]:
+    """Return currently legal choices for *requirement*."""
+    legal: list[Any] = []
+    filter_fn = getattr(requirement, "filter_fn", None)
+    zone = getattr(requirement, "zone", Zone.BATTLEFIELD)
+
+    if zone == Zone.STACK:
+        for stack_obj in game.stack.objects():
+            if filter_fn is None or filter_fn(stack_obj):
+                legal.append(stack_obj)
+    else:
+        for player in game.players:
+            for obj in player.zones[zone].get_all():
+                if filter_fn is None or filter_fn(obj):
+                    legal.append(obj)
+            if filter_fn is None or filter_fn(player):
+                legal.append(player)
+    return legal
+
+
+def _choose_copy_targets(
+    game: GameState,
+    player: Player,
+    stack_obj: StackObject,
+) -> list[Any] | None:
+    """Optionally choose new targets for a copied spell."""
+    if not stack_obj.targets:
+        return None
+    if not player.choose_yes_no(f"Choose new targets for copy of {stack_obj.source.name}?"):
+        return None
+
+    requirements = list(getattr(stack_obj, "target_requirements", []) or [])
+    new_targets = list(stack_obj.targets)
+    for index, requirement in enumerate(requirements):
+        if index >= len(new_targets):
+            break
+        legal = _get_target_options(game, requirement)
+        original_target = new_targets[index]
+        filter_fn = getattr(requirement, "filter_fn", None)
+        if (
+            original_target is not None
+            and (filter_fn is None or filter_fn(original_target))
+            and original_target not in legal
+        ):
+            legal = [original_target, *legal]
+        if not legal:
+            continue
+        chosen = player.choose_target(legal, requirement)
+        if chosen is None:
+            continue
+        if filter_fn is not None and not filter_fn(chosen):
+            continue
+        new_targets[index] = chosen
+    return new_targets
+
+
+def _pay_casualty_cost(
+    game: GameState,
+    player: Player,
+    card: CardImpl,
+) -> bool:
+    """Pay battlefield-granted casualty as an additional casting cost."""
+    casualty_value = _get_granted_casualty_value(game, player, card)
+    if casualty_value <= 0:
+        return False
+
+    if not player.choose_yes_no(
+        f"Sacrifice a creature with power {casualty_value} or greater for casualty {casualty_value}?"
+    ):
+        return False
+
+    candidates = _get_casualty_candidates(game, player, casualty_value)
+    if not candidates:
+        return False
+
+    chosen = player.choose_card(
+        candidates,
+        f"Choose a creature to sacrifice for casualty {casualty_value}",
+    )
+    if chosen not in candidates:
+        return False
+
+    from engine.game import sacrifice
+
+    sacrifice(game, player, chosen)
+    return True
+
+
+def _push_casualty_copy(
