{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EiLqV6A24p2abaRdai9rbv","type":"tool_result","content":"78\t                   targets=[p1])\n79\t\n80\t        assert emeritus.prepared is False\n81\t\n82\t\n83\tclass TestPreparedSpell:\n84\t    def _activate_stp(self, game: Any, player: Any, emeritus: Any) -> None:\n85\t        ability = emeritus.get_activated_abilities(game)[0]\n86\t        inst = ActivatedAbilityInstance(\n87\t            source=emeritus, controller=player,\n88\t            cost=ability.cost, effect=ability.effect,\n89\t        )\n90\t        activate_ability(game, player, inst)\n91\t        _resolve_top_of_stack(game)\n92\t\n93\t    def test_no_ability_while_unprepared(self) -> None:\n94\t        game = create_game()\n95\t        p1, _p2 = game.players\n96\t        emeritus = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n97\t        set_board_state(game, 0, battlefield=[emeritus])\n98\t        assert emeritus.get_activated_abilities(game) == []\n99\t\n100\t    def test_prepared_exiles_creature_and_grants_life(self) -> None:\n101\t        game = create_game()\n102\t        p1, p2 = game.players\n103\t        emeritus = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n104\t        victim = Creature(name=\"Victim\", owner=p2, controller=p2,\n105\t                          base_power=4, base_toughness=4)\n106\t        victim.card_types = {CardType.CREATURE}\n107\t        set_board_state(game, 0, battlefield=[emeritus],\n108\t                        mana={ManaType.WHITE: 1})\n109\t        set_board_state(game, 1, battlefield=[victim], life=20)\n110\t        emeritus.prepared = True\n111\t        p1._script.append(victim)  # choose_card target for StP\n112\t\n113\t        self._activate_stp(game, p1, emeritus)\n114\t\n115\t        assert victim in p2.zones[Zone.EXILE].get_all()\n116\t        assert p2.life == 24  # gained life equal to victim's power (4)\n117\t        assert emeritus.prepared is False  # unprepared after casting the copy\n118\t\n119\t    def test_prepared_consumed_only_once(self) -> None:\n120\t        game = create_game()\n121\t        p1, p2 = game.players\n122\t        emeritus = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n123\t        victim = Creature(name=\"Victim\", owner=p2, controller=p2,\n124\t                          base_power=1, base_toughness=1)\n125\t        victim.card_types = {CardType.CREATURE}\n126\t        set_board_state(game, 0, battlefield=[emeritus],\n127\t                        mana={ManaType.WHITE: 1})\n128\t        set_board_state(game, 1, battlefield=[victim], life=20)\n129\t        emeritus.prepared = True\n130\t        p1._script.append(victim)\n131\t\n132\t        self._activate_stp(game, p1, emeritus)\n133\t        # After casting, the ability is no longer offered.\n134\t        assert emeritus.get_activated_abilities(game) == []\n135\t"}]},"parent_tool_use_id":null,"session_id":"1404691a-99e3-4d00-a347-c654df745e5c","uuid":"da52ba4a-e3d8-41f6-bb4f-7acd0fbc49de","timestamp":"2026-06-04T03:30:05.223Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/sos/sos_13/tests.py","content":"                   targets=[p1])\n\n        assert emeritus.prepared is False\n\n\nclass TestPreparedSpell:\n    def _activate_stp(self, game: Any, player: Any, emeritus: Any) -> None:\n        ability = emeritus.get_activated_abilities(game)[0]\n        inst = ActivatedAbilityInstance(\n            source=emeritus, controller=player,\n            cost=ability.cost, effect=ability.effect,\n        )\n        activate_ability(game, player, inst)\n        _resolve_top_of_stack(game)\n\n    def test_no_ability_while_unprepared(self) -> None:\n        game = create_game()\n        p1, _p2 = game.players\n        emeritus = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n        set_board_state(game, 0, battlefield=[emeritus])\n        assert emeritus.get_activated_abilities(game) == []\n\n    def test_prepared_exiles_creature_and_grants_life(self) -> None:\n        game = create_game()\n        p1, p2 = game.players\n        emeritus = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n        victim = Creature(name=\"Victim\", owner=p2, controller=p2,\n                          base_power=4, base_toughness=4)\n        victim.card_types = {CardType.CREATURE}\n        set_board_state(game, 0, battlefield=[emeritus],\n                        mana={ManaType.WHITE: 1})\n        set_board_state(game, 1, battlefield=[victim], life=20)\n        emeritus.prepared = True\n        p1._script.append(victim)  # choose_card target for StP\n\n        self._activate_stp(game, p1, emeritus)\n\n        assert victim in p2.zones[Zone.EXILE].get_all()\n        assert p2.life == 24  # gained life equal to victim's power (4)\n        assert emeritus.prepared is False  # unprepared after casting the copy\n\n    def test_prepared_consumed_only_once(self) -> None:\n        game = create_game()\n        p1, p2 = game.players\n        emeritus = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n        victim = Creature(name=\"Victim\", owner=p2, controller=p2,\n                          base_power=1, base_toughness=1)\n        victim.card_types = {CardType.CREATURE}\n        set_board_state(game, 0, battlefield=[emeritus],\n                        mana={ManaType.WHITE: 1})\n        set_board_state(game, 1, battlefield=[victim], life=20)\n        emeritus.prepared = True\n        p1._script.append(victim)\n\n        self._activate_stp(game, p1, emeritus)\n        # After casting, the ability is no longer offered.\n        assert emeritus.get_activated_abilities(game) == []\n","numLines":58,"startLine":78,"totalLines":135}}}
