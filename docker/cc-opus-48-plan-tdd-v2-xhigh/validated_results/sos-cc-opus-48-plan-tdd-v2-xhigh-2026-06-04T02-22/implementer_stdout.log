tains(card):\n                return\n            if not ctrl.choose_yes_no(\n                f\"Cast {getattr(card, 'name', 'card')} for its miracle cost {{2}}?\"\n            ):\n                return\n            cast_for_cost(game, ctrl, card, ManaCost.parse(\"{2}\"))\n\n        game.trigger_manager.register(\n            TriggerRegistration(\n                event_type=DrawsCardTriggeredEvent,\n                condition=_miracle_condition,\n                effect=_miracle_effect,\n                source=self,\n                controller=controller,\n            )\n        )"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":404,"cache_read_input_tokens":127827,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":404},"output_tokens":28,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"1404691a-99e3-4d00-a347-c654df745e5c","uuid":"e480aa02-2501-474d-84f0-aef0be67aa27","request_id":"req_011CbhW8QQ8iH9tyH92Bu4YQ"}
