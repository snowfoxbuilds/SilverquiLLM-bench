{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Bk1SpvXGrYUYYo9xcoZRka","type":"tool_result","content":"1\t\"\"\"Card implementation for Koma, World-Eater.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom typing import TYPE_CHECKING, Any\n4\tfrom engine.card import Creature\n5\tfrom engine.types import Keyword, ManaCost\n6\tfrom engine.events import DealsDamageTriggeredEvent\n7\tif TYPE_CHECKING:\n8\t    from engine.game_state import GameState\n9\t\n10\tclass KomaWorldEater(Creature):\n11\t    \"\"\"Koma, World-Eater — {3}{G}{G}{U}{U} — 8/12 — Legendary Serpent.\n12\t\n13\t    This spell can't be countered.\n14\t    Trample, ward {4}\n15\t    Whenever Koma deals combat damage to a player, create four 3/3 blue\n16\t    Serpent creature tokens named Koma's Coil.\n17\t\n18\t    FDN collector number 121.\n19\t    \"\"\"\n20\t\n21\t    def __init__(self, **kwargs: Any) -> None:\n22\t        kwargs.setdefault('name', 'Koma, World-Eater')\n23\t        kwargs.setdefault('mana_cost', ManaCost.parse('{3}{G}{G}{U}{U}'))\n24\t        kwargs.setdefault('subtypes', {'Serpent'})\n25\t        kwargs.setdefault('supertypes', {'Legendary'})\n26\t        kwargs.setdefault('keywords', Keyword.TRAMPLE | Keyword.WARD)\n27\t        kwargs.setdefault('base_power', 8)\n28\t        kwargs.setdefault('base_toughness', 12)\n29\t        kwargs.setdefault('rules_text', \"This spell can't be countered.\\nTrample, ward {4}\\nWhenever Koma deals combat damage to a player, create four 3/3 blue Serpent creature tokens named Koma's Coil.\")\n30\t        super().__init__(**kwargs)\n31\t        self._cant_be_countered = True\n32\t\n33\t    def register_triggers(self, game: 'GameState') -> None:\n34\t        \"\"\"Register combat damage trigger for Serpent token creation.\"\"\"\n35\t        from engine.card import Creature as _Creature\n36\t        from engine.game import create_token\n37\t        from engine.triggers import TriggerRegistration\n38\t        source = self\n39\t        controller = getattr(self, 'controller', None) or game.active_player\n40\t\n41\t        def _condition(game: Any, event: dict) -> bool:\n42\t            if event.source is not source:\n43\t                return False\n44\t            if not event.is_combat:\n45\t                return False\n46\t            target = event.target\n47\t            return hasattr(target, 'life')\n48\t\n49\t        def _effect(game: 'GameState') -> None:\n50\t            ctrl = getattr(source, 'controller', None)\n51\t            if ctrl is None:\n52\t                return\n53\t            for _ in range(4):\n54\t                token = _Creature(name=\"Koma's Coil\", subtypes={'Serpent'}, base_power=3, base_toughness=3)\n55\t                create_token(game, ctrl, token)\n56\t        game.trigger_manager.register(TriggerRegistration(event_type=DealsDamageTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=controller))\n57\t"}]},"parent_tool_use_id":null,"session_id":"1404691a-99e3-4d00-a347-c654df745e5c","uuid":"1d6cd3e5-ac0b-45f2-a667-45d6937db1ec","timestamp":"2026-06-04T02:46:17.265Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_121/card_impl.py","content":"\"\"\"Card implementation for Koma, World-Eater.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import Creature\nfrom engine.types import Keyword, ManaCost\nfrom engine.events import DealsDamageTriggeredEvent\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\nclass KomaWorldEater(Creature):\n    \"\"\"Koma, World-Eater — {3}{G}{G}{U}{U} — 8/12 — Legendary Serpent.\n\n    This spell can't be countered.\n    Trample, ward {4}\n    Whenever Koma deals combat damage to a player, create four 3/3 blue\n    Serpent creature tokens named Koma's Coil.\n\n    FDN collector number 121.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Koma, World-Eater')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{3}{G}{G}{U}{U}'))\n        kwargs.setdefault('subtypes', {'Serpent'})\n        kwargs.setdefault('supertypes', {'Legendary'})\n        kwargs.setdefault('keywords', Keyword.TRAMPLE | Keyword.WARD)\n        kwargs.setdefault('base_power', 8)\n        kwargs.setdefault('base_toughness', 12)\n        kwargs.setdefault('rules_text', \"This spell can't be countered.\\nTrample, ward {4}\\nWhenever Koma deals combat damage to a player, create four 3/3 blue Serpent creature tokens named Koma's Coil.\")\n        super().__init__(**kwargs)\n        self._cant_be_countered = True\n\n    def register_triggers(self, game: 'GameState') -> None:\n        \"\"\"Register combat damage trigger for Serpent token creation.\"\"\"\n        from engine.card import Creature as _Creature\n        from engine.game import create_token\n        from engine.triggers import TriggerRegistration\n        source = self\n        controller = getattr(self, 'controller', None) or game.active_player\n\n        def _condition(game: Any, event: dict) -> bool:\n            if event.source is not source:\n                return False\n            if not event.is_combat:\n                return False\n            target = event.target\n            return hasattr(target, 'life')\n\n        def _effect(game: 'GameState') -> None:\n            ctrl = getattr(source, 'controller', None)\n            if ctrl is None:\n                return\n            for _ in range(4):\n                token = _Creature(name=\"Koma's Coil\", subtypes={'Serpent'}, base_power=3, base_toughness=3)\n                create_token(game, ctrl, token)\n        game.trigger_manager.register(TriggerRegistration(event_type=DealsDamageTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=controller))\n","numLines":57,"startLine":1,"totalLines":57}}}
