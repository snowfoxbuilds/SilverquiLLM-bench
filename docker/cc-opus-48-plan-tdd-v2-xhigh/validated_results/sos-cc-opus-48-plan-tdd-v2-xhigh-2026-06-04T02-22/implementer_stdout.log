{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FYuXjmf2skc82YmVmjb3jn","type":"tool_result","content":"319\t    \"\"\"\n320\t    from engine.zones import move_to_zone\n321\t\n322\t    # Ensure controller is set\n323\t    card.controller = player\n324\t    if card.owner is None:\n325\t        card.owner = player\n326\t\n327\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n328\t    if not card.can_cast(game):\n329\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n330\t\n331\t    # 2. Locate card in source zone\n332\t    source_zone_container = player.zones[from_zone]\n333\t    if not source_zone_container.contains(card):\n334\t        # Try to find the card in any player's zone\n335\t        source_zone_container = None\n336\t        for p in game.players:\n337\t            z = p.zones[from_zone]\n338\t            if z.contains(card):\n339\t                source_zone_container = z\n340\t                break\n341\t\n342\t    if source_zone_container is None or not source_zone_container.contains(card):\n343\t        raise CastingError(\n344\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n345\t        )\n346\t\n347\t    # Move card from source zone to stack zone\n348\t    stack_zone = player.zones[Zone.STACK]\n349\t    source_zone_container.remove(card)\n350\t    stack_zone.add(card)\n351\t\n352\t    # 3. Choose targets (with rollback on failure)\n353\t    try:\n354\t        target_specs = card.get_targets(game)\n355\t        chosen_targets: list[Any] = []\n356\t        if target_specs:\n357\t            for spec in target_specs:\n358\t                target = player.choose_target(target_specs, spec)\n359\t                # Validate against filter_fn if the spec provides one\n360\t                filter_fn = getattr(spec, \"filter_fn\", None)\n361\t                if filter_fn is not None and target is not None:\n362\t                    if not filter_fn(target):\n363\t                        raise CastingError(\n364\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n365\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n366\t                        )\n367\t                chosen_targets.append(target)\n368\t\n369\t        # Protection check — reject targets that have protection from this spell\n370\t        from engine.protection import has_protection_from\n371\t\n372\t        for target in chosen_targets:\n373\t            if has_protection_from(target, card):\n374\t                raise CastingError(\n375\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n376\t                )\n377\t    except Exception as exc:\n378\t        # Rollback: move card from stack zone back to source zone\n379\t        stack_zone.remove(card)\n380\t        source_zone_container.add(card)\n381\t        raise CastingError(str(exc)) from exc\n382\t\n383\t    # 4. Call on_cast hook\n384\t    card.on_cast(game)\n385\t\n386\t    # 5. Build on_resolve callback and push StackObject\n387\t    stack_obj = StackObject(\n388\t        source=card,\n389\t        controller=player,\n390\t        targets=chosen_targets,\n391\t        on_resolve=lambda g: None,  # replaced below\n392\t    )\n393\t\n394\t    def _on_resolve(g: GameState) -> None:\n395\t        _resolve_spell(g, card, player, stack_obj)\n396\t\n397\t    stack_obj.on_resolve = _on_resolve\n398\t    game.stack.push(stack_obj)\n399\t\n400\t\n401\t# ------------------------------------------------------------------\n402\t# Resolution (called when the stack pops)\n403\t# ------------------------------------------------------------------\n404\t\n405\tdef _resolve_spell(\n406\t    game: GameState,\n407\t    card: CardImpl,\n408\t    player: Player,\n409\t    stack_obj: StackObject,\n410\t) -> None:\n411\t    \"\"\"Resolve *card* cast by *player*.\n412\t\n413\t    1. Call ``card.on_resolve(game, targets=targets)``.\n414\t    2. Remove the card from the stack zone.\n415\t    3. If the card is a permanent type, move it to the battlefield via\n416\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n417\t       registration and the ETB event).\n418\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n419\t    \"\"\"\n420\t    from engine.zones import move_to_zone\n421\t\n422\t    # Read targets from the StackObject — the single source of truth.\n423\t    # Set chosen_targets on the card just before resolution so that\n424\t    # _get_chosen_target helpers (which read via getattr) work.\n425\t    targets = stack_obj.targets\n426\t    if targets is not None:\n427\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n428\t\n429\t    card.on_resolve(game)\n430\t\n431\t    if card.card_types & _PERMANENT_TYPES:\n432\t        # Move from stack to battlefield via move_to_zone, which handles\n433\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n434\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n435\t    else:\n436\t        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n437\t        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n438\t"}]},"parent_tool_use_id":null,"session_id":"1404691a-99e3-4d00-a347-c654df745e5c","uuid":"ce60e33d-b981-4e5a-a635-44b9ad511f88","timestamp":"2026-06-04T03:13:40.861Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Ensure controller is set\n    card.controller = player\n    if card.owner is None:\n        card.owner = player\n\n    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 2. Locate card in source zone\n    source_zone_container = player.zones[from_zone]\n    if not source_zone_container.contains(card):\n        # Try to find the card in any player's zone\n        source_zone_container = None\n        for p in game.players:\n            z = p.zones[from_zone]\n            if z.contains(card):\n                source_zone_container = z\n                break\n\n    if source_zone_container is None or not source_zone_container.contains(card):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n        )\n\n    # Move card from source zone to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    source_zone_container.remove(card)\n    stack_zone.add(card)\n\n    # 3. Choose targets (with rollback on failure)\n    try:\n        target_specs = card.get_targets(game)\n        chosen_targets: list[Any] = []\n        if target_specs:\n            for spec in target_specs:\n                target = player.choose_target(target_specs, spec)\n                # Validate against filter_fn if the spec provides one\n                filter_fn = getattr(spec, \"filter_fn\", None)\n                if filter_fn is not None and target is not None:\n                    if not filter_fn(target):\n                        raise CastingError(\n                            f\"Cannot cast {card.name!r} — chosen target does not \"\n                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                        )\n                chosen_targets.append(target)\n\n        # Protection check — reject targets that have protection from this spell\n        from engine.protection import has_protection_from\n\n        for target in chosen_targets:\n            if has_protection_from(target, card):\n                raise CastingError(\n                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n                )\n    except Exception as exc:\n        # Rollback: move card from stack zone back to source zone\n        stack_zone.remove(card)\n        source_zone_container.add(card)\n        raise CastingError(str(exc)) from exc\n\n    # 4. Call on_cast hook\n    card.on_cast(game)\n\n    # 5. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n\n# ------------------------------------------------------------------\n# Resolution (called when the stack pops)\n# ------------------------------------------------------------------\n\ndef _resolve_spell(\n    game: GameState,\n    card: CardImpl,\n    player: Player,\n    stack_obj: StackObject,\n) -> None:\n    \"\"\"Resolve *card* cast by *player*.\n\n    1. Call ``card.on_resolve(game, targets=targets)``.\n    2. Remove the card from the stack zone.\n    3. If the card is a permanent type, move it to the battlefield via\n       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n       registration and the ETB event).\n    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Read targets from the StackObject — the single source of truth.\n    # Set chosen_targets on the card just before resolution so that\n    # _get_chosen_target helpers (which read via getattr) work.\n    targets = stack_obj.targets\n    if targets is not None:\n        card.chosen_targets = targets  # type: ignore[attr-defined]\n\n    card.on_resolve(game)\n\n    if card.card_types & _PERMANENT_TYPES:\n        # Move from stack to battlefield via move_to_zone, which handles\n        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n    else:\n        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n","numLines":120,"startLine":319,"totalLines":515}}}
