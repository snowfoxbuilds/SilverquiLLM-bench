{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TaL42GXDfQvxdanxZdUp46","type":"tool_result","content":"1\t\"\"\"Replacement effects engine — modifies events in-place with \"instead\" semantics.\n2\t\n3\tUnlike triggered abilities (which go on the stack), replacement effects\n4\tintercept an event *before* it happens and substitute an alternative\n5\toutcome.  Key design differences from triggers:\n6\t\n7\t- **No stack**: replacements are applied inline, not pushed.\n8\t- **\"Instead\" semantics**: the original event is replaced, not supplemented.\n9\t- **Self-replacement prevention**: each effect applies at most once per\n10\t  event to avoid infinite loops.\n11\t- **Player choice**: when multiple replacements apply to the same event,\n12\t  the affected player chooses the order via ``Player.choose``.\n13\t- **Subtype matching**: a replacement registered for a parent event class\n14\t  (e.g. ``MoveToGraveyardReplacementEvent``) fires for any subtype\n15\t  (e.g. ``CreatureDiesReplacementEvent``).\n16\t\n17\tPublic API:\n18\t\n19\t- :class:`ReplacementEffect` — dataclass describing a single replacement.\n20\t- :class:`ReplacementManager` — central registry with ``register``,\n21\t  ``unregister``, and ``apply`` methods.\n22\t\"\"\"\n23\t\n24\tfrom __future__ import annotations\n25\t\n26\tfrom dataclasses import dataclass\n27\tfrom typing import TYPE_CHECKING, Any, Callable\n28\t\n29\tfrom engine.events import ReplacementEvent\n30\t\n31\tif TYPE_CHECKING:\n32\t    from engine.game_state import GameState\n33\t    from engine.player import Player\n34\t\n35\t\n36\t@dataclass\n37\tclass ReplacementEffect:\n38\t    \"\"\"Describes a single replacement effect.\n39\t\n40\t    Attributes:\n41\t        event_type: The event class (or a base class) this replacement\n42\t            watches for.  A replacement registered for a parent class\n43\t            also fires when the event is an instance of a subclass.\n44\t        source: The game object (card / permanent) that owns this effect.\n45\t        condition: Optional callable ``(game, event) -> bool`` that must\n46\t            return ``True`` for the replacement to apply.\n47\t        replacement: Callable ``(game, event) -> event`` that receives the\n48\t            current event object and returns a (possibly modified) version.\n49\t        controller: The player who controls the source.\n50\t    \"\"\"\n51\t\n52\t    event_type: type[ReplacementEvent]\n53\t    source: Any\n54\t    condition: Callable[..., bool] | None\n55\t    replacement: Callable[..., ReplacementEvent]\n56\t    controller: Any = None\n57\t\n58\t\n59\tclass ReplacementManager:\n60\t    \"\"\"Central registry for replacement effects.\"\"\"\n61\t\n62\t    def __init__(self) -> None:\n63\t        self._effects: list[ReplacementEffect] = []\n64\t\n65\t    # ------------------------------------------------------------------\n66\t    # Registration\n67\t    # ------------------------------------------------------------------\n68\t\n69\t    def register(self, effect: ReplacementEffect) -> None:\n70\t        \"\"\"Register a replacement effect.\"\"\"\n71\t        self._effects.append(effect)\n72\t\n73\t    def unregister(self, source: Any) -> None:\n74\t        \"\"\"Remove all replacement effects registered by *source*.\"\"\"\n75\t        self._effects = [e for e in self._effects if e.source is not source]\n76\t\n77\t    # ------------------------------------------------------------------\n78\t    # Application\n79\t    # ------------------------------------------------------------------\n80\t\n81\t    def apply(self, game: GameState, event: ReplacementEvent) -> ReplacementEvent:\n82\t        \"\"\"Apply matching replacement effects to *event*.\n83\t\n84\t        1. Collect all registered effects whose ``event_type`` is a\n85\t           superclass of (or equal to) the event's class and whose\n86\t           ``condition`` returns ``True``.\n87\t        2. If multiple effects match, the affected player chooses the order.\n88\t        3. Each chosen effect's ``replacement`` callable is invoked and\n89\t           the result replaces the current event.\n90\t        4. Each effect applies at most once per invocation.\n91\t\n92\t        Parameters:\n93\t            game: The current game state.\n94\t            event: The typed event object to potentially modify.\n95\t\n96\t        Returns:\n97\t            The (possibly modified) event after all applicable replacements.\n98\t        \"\"\"\n99\t        applied: set[int] = set()\n100\t\n101\t        while True:\n102\t            matching = self._collect_matching(game, event, applied)\n103\t            if not matching:\n104\t                break\n105\t\n106\t            if len(matching) == 1:\n107\t                chosen = matching[0]\n108\t            else:\n109\t                affected = self._get_affected_player(game, event)\n110\t                chosen = affected.choose(matching, \"Choose replacement effect order\")\n111\t\n112\t            applied.add(id(chosen))\n113\t            event = chosen.replacement(game, event)\n114\t\n115\t        return event\n116\t\n117\t    # ------------------------------------------------------------------\n118\t    # Queries\n119\t    # ------------------------------------------------------------------\n120\t\n121\t    def get_effects(self) -> list[ReplacementEffect]:\n122\t        \"\"\"Return a shallow copy of all registered replacement effects.\"\"\"\n123\t        return list(self._effects)\n124\t\n125\t    def get_effects_for_source(self, source: Any) -> list[ReplacementEffect]:\n126\t        \"\"\"Return all effects registered by *source*.\"\"\"\n127\t        return [e for e in self._effects if e.source is source]\n128\t\n129\t    def clear(self) -> None:\n130\t        \"\"\"Remove all registered replacement effects.\"\"\"\n131\t        self._effects.clear()\n132\t\n133\t    # ------------------------------------------------------------------\n134\t    # Internal helpers\n135\t    # ------------------------------------------------------------------\n136\t\n137\t    def _collect_matching(\n138\t        self,\n139\t        game: GameState,\n140\t        event: ReplacementEvent,\n141\t        applied: set[int],\n142\t    ) -> list[ReplacementEffect]:\n143\t        \"\"\"Collect effects matching the event type that haven't been applied.\"\"\"\n144\t        matching: list[ReplacementEffect] = []\n145\t        for effect in self._effects:\n146\t            if id(effect) in applied:\n147\t                continue\n148\t            if not isinstance(event, effect.event_type):\n149\t                continue\n150\t            if effect.condition is not None:\n151\t                if not effect.condition(game, event):\n152\t                    continue\n153\t            matching.append(effect)\n154\t        return matching\n155\t\n156\t    @staticmethod\n157\t    def _get_affected_player(game: GameState, event: ReplacementEvent) -> Any:\n158\t        \"\"\"Determine the affected player for ordering choices.\"\"\"\n159\t        player = getattr(event, \"player\", None)\n160\t        if player is not None:\n161\t            return player\n162\t        controller = getattr(event, \"controller\", None)\n163\t        if controller is not None:\n164\t            return controller\n165\t        return game.active_player\n166\t"}]},"parent_tool_use_id":null,"session_id":"1404691a-99e3-4d00-a347-c654df745e5c","uuid":"f867c01a-4f15-4e41-9f21-1b2966a148de","timestamp":"2026-06-04T02:37:38.831Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/replacement_effects.py","content":"\"\"\"Replacement effects engine — modifies events in-place with \"instead\" semantics.\n\nUnlike triggered abilities (which go on the stack), replacement effects\nintercept an event *before* it happens and substitute an alternative\noutcome.  Key design differences from triggers:\n\n- **No stack**: replacements are applied inline, not pushed.\n- **\"Instead\" semantics**: the original event is replaced, not supplemented.\n- **Self-replacement prevention**: each effect applies at most once per\n  event to avoid infinite loops.\n- **Player choice**: when multiple replacements apply to the same event,\n  the affected player chooses the order via ``Player.choose``.\n- **Subtype matching**: a replacement registered for a parent event class\n  (e.g. ``MoveToGraveyardReplacementEvent``) fires for any subtype\n  (e.g. ``CreatureDiesReplacementEvent``).\n\nPublic API:\n\n- :class:`ReplacementEffect` — dataclass describing a single replacement.\n- :class:`ReplacementManager` — central registry with ``register``,\n  ``unregister``, and ``apply`` methods.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom typing import TYPE_CHECKING, Any, Callable\n\nfrom engine.events import ReplacementEvent\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n@dataclass\nclass ReplacementEffect:\n    \"\"\"Describes a single replacement effect.\n\n    Attributes:\n        event_type: The event class (or a base class) this replacement\n            watches for.  A replacement registered for a parent class\n            also fires when the event is an instance of a subclass.\n        source: The game object (card / permanent) that owns this effect.\n        condition: Optional callable ``(game, event) -> bool`` that must\n            return ``True`` for the replacement to apply.\n        replacement: Callable ``(game, event) -> event`` that receives the\n            current event object and returns a (possibly modified) version.\n        controller: The player who controls the source.\n    \"\"\"\n\n    event_type: type[ReplacementEvent]\n    source: Any\n    condition: Callable[..., bool] | None\n    replacement: Callable[..., ReplacementEvent]\n    controller: Any = None\n\n\nclass ReplacementManager:\n    \"\"\"Central registry for replacement effects.\"\"\"\n\n    def __init__(self) -> None:\n        self._effects: list[ReplacementEffect] = []\n\n    # ------------------------------------------------------------------\n    # Registration\n    # ------------------------------------------------------------------\n\n    def register(self, effect: ReplacementEffect) -> None:\n        \"\"\"Register a replacement effect.\"\"\"\n        self._effects.append(effect)\n\n    def unregister(self, source: Any) -> None:\n        \"\"\"Remove all replacement effects registered by *source*.\"\"\"\n        self._effects = [e for e in self._effects if e.source is not source]\n\n    # ------------------------------------------------------------------\n    # Application\n    # ------------------------------------------------------------------\n\n    def apply(self, game: GameState, event: ReplacementEvent) -> ReplacementEvent:\n        \"\"\"Apply matching replacement effects to *event*.\n\n        1. Collect all registered effects whose ``event_type`` is a\n           superclass of (or equal to) the event's class and whose\n           ``condition`` returns ``True``.\n        2. If multiple effects match, the affected player chooses the order.\n        3. Each chosen effect's ``replacement`` callable is invoked and\n           the result replaces the current event.\n        4. Each effect applies at most once per invocation.\n\n        Parameters:\n            game: The current game state.\n            event: The typed event object to potentially modify.\n\n        Returns:\n            The (possibly modified) event after all applicable replacements.\n        \"\"\"\n        applied: set[int] = set()\n\n        while True:\n            matching = self._collect_matching(game, event, applied)\n            if not matching:\n                break\n\n            if len(matching) == 1:\n                chosen = matching[0]\n            else:\n                affected = self._get_affected_player(game, event)\n                chosen = affected.choose(matching, \"Choose replacement effect order\")\n\n            applied.add(id(chosen))\n            event = chosen.replacement(game, event)\n\n        return event\n\n    # ------------------------------------------------------------------\n    # Queries\n    # ------------------------------------------------------------------\n\n    def get_effects(self) -> list[ReplacementEffect]:\n        \"\"\"Return a shallow copy of all registered replacement effects.\"\"\"\n        return list(self._effects)\n\n    def get_effects_for_source(self, source: Any) -> list[ReplacementEffect]:\n        \"\"\"Return all effects registered by *source*.\"\"\"\n        return [e for e in self._effects if e.source is source]\n\n    def clear(self) -> None:\n        \"\"\"Remove all registered replacement effects.\"\"\"\n        self._effects.clear()\n\n    # ------------------------------------------------------------------\n    # Internal helpers\n    # ------------------------------------------------------------------\n\n    def _collect_matching(\n        self,\n        game: GameState,\n        event: ReplacementEvent,\n        applied: set[int],\n    ) -> list[ReplacementEffect]:\n        \"\"\"Collect effects matching the event type that haven't been applied.\"\"\"\n        matching: list[ReplacementEffect] = []\n        for effect in self._effects:\n            if id(effect) in applied:\n                continue\n            if not isinstance(event, effect.event_type):\n                continue\n            if effect.condition is not None:\n                if not effect.condition(game, event):\n                    continue\n            matching.append(effect)\n        return matching\n\n    @staticmethod\n    def _get_affected_player(game: GameState, event: ReplacementEvent) -> Any:\n        \"\"\"Determine the affected player for ordering choices.\"\"\"\n        player = getattr(event, \"player\", None)\n        if player is not None:\n            return player\n        controller = getattr(event, \"controller\", None)\n        if controller is not None:\n            return controller\n        return game.active_player\n","numLines":166,"startLine":1,"totalLines":166}}}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01N6MNqh4hxcLpm5m3xsNxdz","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01XVmKsDvrw6qrrfbGFnS1UJ","name":"Read","input":{"file_path":"/workspace/engine/basic_lands.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2438,"cache_read_input_tokens":151841,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2438},"output_tokens":43,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"1404691a-99e3-4d00-a347-c654df745e5c","uuid":"70a809a1-44a9-4b6f-8d09-433ca8aca874","request_id":"req_011CbhSeSAfgLsMfzhgy8bty"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XVmKsDvrw6qrrfbGFnS1UJ","type":"tool_result","content":"1\t\"\"\"Basic land implementations — Plains, Island, Swamp, Mountain, Forest.\n2\t\n3\tEach basic land:\n4\t- Subclasses :class:`~engine.card.Land`.\n5\t- Has ``supertypes = {Supertype.BASIC}``.\n6\t- Has a subtype matching its land type (e.g. ``{\"Plains\"}``).\n7\t- Provides a :class:`~engine.card.ManaAbility` that taps to produce\n8\t  one mana of its associated color.\n9\t\n10\tUse :func:`register_basic_lands` to register all five with a\n11\t:class:`~cards.registry.CardRegistry`.\n12\t\"\"\"\n13\t\n14\tfrom __future__ import annotations\n15\t\n16\tfrom typing import TYPE_CHECKING, Any\n17\t\n18\tfrom engine.card import Land, ManaAbility\n19\tfrom engine.types import ManaType, Supertype\n20\t\n21\tif TYPE_CHECKING:\n22\t    from engine.game_state import GameState\n23\t    from engine.player import Player\n24\t\n25\t    from cards.registry import CardRegistry\n26\t\n27\t\n28\t# ---------------------------------------------------------------------------\n29\t# Mana-ability helpers\n30\t# ---------------------------------------------------------------------------\n31\t\n32\tdef _tap_cost(game: GameState, source: Any) -> bool:\n33\t    \"\"\"Generic tap-cost: check untapped, then tap.\n34\t\n35\t    Mirrors :func:`engine.abilities.tap_cost` logic so basic lands\n36\t    can be activated through the abilities system or directly.\n37\t    \"\"\"\n38\t    if getattr(source, \"is_tapped\", False):\n39\t        return False\n40\t    source.is_tapped = True\n41\t    return True\n42\t\n43\t\n44\tdef _make_mana_effect(mana_type: ManaType):\n45\t    \"\"\"Return an effect callable that adds 1 mana of *mana_type* to the controller's pool.\"\"\"\n46\t\n47\t    def _effect(game: GameState) -> None:  # noqa: ARG001 – game needed for signature\n48\t        # The source is captured via the ability's activation context.\n49\t        # However, ManaAbility.mana_produced is called by activate_ability's\n50\t        # effect path.  We need to figure out who the controller is.\n51\t        # This is handled at activation time — see get_mana_abilities below.\n52\t        pass\n53\t\n54\t    return _effect\n55\t\n56\t\n57\t# ---------------------------------------------------------------------------\n58\t# Basic land classes\n59\t# ---------------------------------------------------------------------------\n60\t\n61\tclass Plains(Land):\n62\t    \"\"\"Basic Plains — taps for {W}.\"\"\"\n63\t\n64\t    def __init__(self, **kwargs: Any) -> None:\n65\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n66\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Plains\"}\n67\t        super().__init__(**kwargs)\n68\t\n69\t    def get_mana_abilities(self) -> list[ManaAbility]:\n70\t        \"\"\"Return a single mana ability: {T}: Add {W}.\"\"\"\n71\t        source = self\n72\t\n73\t        def _effect(game: GameState) -> None:\n74\t            controller = source.controller\n75\t            if controller is not None:\n76\t                controller.mana_pool.add(ManaType.WHITE, 1)\n77\t\n78\t        return [\n79\t            ManaAbility(\n80\t                cost=_tap_cost,\n81\t                mana_produced=_effect,\n82\t                description=\"{T}: Add {W}.\",\n83\t            )\n84\t        ]\n85\t\n86\t\n87\tclass Island(Land):\n88\t    \"\"\"Basic Island — taps for {U}.\"\"\"\n89\t\n90\t    def __init__(self, **kwargs: Any) -> None:\n91\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n92\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Island\"}\n93\t        super().__init__(**kwargs)\n94\t\n95\t    def get_mana_abilities(self) -> list[ManaAbility]:\n96\t        \"\"\"Return a single mana ability: {T}: Add {U}.\"\"\"\n97\t        source = self\n98\t\n99\t        def _effect(game: GameState) -> None:\n100\t            controller = source.controller\n101\t            if controller is not None:\n102\t                controller.mana_pool.add(ManaType.BLUE, 1)\n103\t\n104\t        return [\n105\t            ManaAbility(\n106\t                cost=_tap_cost,\n107\t                mana_produced=_effect,\n108\t                description=\"{T}: Add {U}.\",\n109\t            )\n110\t        ]\n111\t\n112\t\n113\tclass Swamp(Land):\n114\t    \"\"\"Basic Swamp — taps for {B}.\"\"\"\n115\t\n116\t    def __init__(self, **kwargs: Any) -> None:\n117\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n118\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Swamp\"}\n119\t        super().__init__(**kwargs)\n120\t\n121\t    def get_mana_abilities(self) -> list[ManaAbility]:\n122\t        \"\"\"Return a single mana ability: {T}: Add {B}.\"\"\"\n123\t        source = self\n124\t\n125\t        def _effect(game: GameState) -> None:\n126\t            controller = source.controller\n127\t            if controller is not None:\n128\t                controller.mana_pool.add(ManaType.BLACK, 1)\n129\t\n130\t        return [\n131\t            ManaAbility(\n132\t                cost=_tap_cost,\n133\t                mana_produced=_effect,\n134\t                description=\"{T}: Add {B}.\",\n135\t            )\n136\t        ]\n137\t\n138\t\n139\tclass Mountain(Land):\n140\t    \"\"\"Basic Mountain — taps for {R}.\"\"\"\n141\t\n142\t    def __init__(self, **kwargs: Any) -> None:\n143\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n144\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Mountain\"}\n145\t        super().__init__(**kwargs)\n146\t\n147\t    def get_mana_abilities(self) -> list[ManaAbility]:\n148\t        \"\"\"Return a single mana ability: {T}: Add {R}.\"\"\"\n149\t        source = self\n150\t\n151\t        def _effect(game: GameState) -> None:\n152\t            controller = source.controller\n153\t            if controller is not None:\n154\t                controller.mana_pool.add(ManaType.RED, 1)\n155\t\n156\t        return [\n157\t            ManaAbility(\n158\t                cost=_tap_cost,\n159\t                mana_produced=_effect,\n160\t                description=\"{T}: Add {R}.\",\n161\t            )\n162\t        ]\n163\t\n164\t\n165\tclass Forest(Land):\n166\t    \"\"\"Basic Forest — taps for {G}.\"\"\"\n167\t\n168\t    def __init__(self, **kwargs: Any) -> None:\n169\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n170\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Forest\"}\n171\t        super().__init__(**kwargs)\n172\t\n173\t    def get_mana_abilities(self) -> list[ManaAbility]:\n174\t        \"\"\"Return a single mana ability: {T}: Add {G}.\"\"\"\n175\t        source = self\n176\t\n177\t        def _effect(game: GameState) -> None:\n178\t            controller = source.controller\n179\t            if controller is not None:\n180\t                controller.mana_pool.add(ManaType.GREEN, 1)\n181\t\n182\t        return [\n183\t            ManaAbility(\n184\t                cost=_tap_cost,\n185\t                mana_produced=_effect,\n186\t                description=\"{T}: Add {G}.\",\n187\t            )\n188\t        ]\n189\t\n190\t\n191\t# ---------------------------------------------------------------------------\n192\t# Registration helper\n193\t# ---------------------------------------------------------------------------\n194\t\n195\tdef register_basic_lands(registry: CardRegistry) -> None:\n196\t    \"\"\"Register all five basic lands with *registry*.\n197\t\n198\t    Each is registered under its canonical name (e.g. ``\"Plains\"``) with\n199\t    :class:`~cards.registry.CardMetadata` reflecting its type line, colors,\n200\t    and lack of mana cost.\n201\t    \"\"\"\n202\t    from cards.registry import CardMetadata\n203\t\n204\t    _BASIC_LANDS: list[tuple[str, type[Land], str]] = [\n205\t        (\"Plains\", Plains, \"W\"),\n206\t        (\"Island\", Island, \"U\"),\n207\t        (\"Swamp\", Swamp, \"B\"),\n208\t        (\"Mountain\", Mountain, \"R\"),\n209\t        (\"Forest\", Forest, \"G\"),\n210\t    ]\n211\t\n212\t    for card_name, impl_class, mana_symbol in _BASIC_LANDS:\n213\t        metadata = CardMetadata(\n214\t            name=card_name,\n215\t            mana_cost_str=\"\",\n216\t            type_line=f\"Basic Land — {card_name}\",\n217\t            oracle_text=f\"({{T}}: Add {{{mana_symbol}}}.)\",\n218\t            power=None,\n219\t            toughness=None,\n220\t            colors=[],\n221\t            keywords=[],\n222\t            rarity=\"common\",\n223\t            set_code=\"\",\n224\t            collector_number=\"\",\n225\t        )\n226\t        registry.register(card_name, impl_class, metadata)\n227\t"}]},"parent_tool_use_id":null,"session_id":"1404691a-99e3-4d00-a347-c654df745e5c","uuid":"5e7e206e-49d2-407f-95fa-16c977b34714","timestamp":"2026-06-04T02:37:41.245Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/basic_lands.py","content":"\"\"\"Basic land implementations — Plains, Island, Swamp, Mountain, Forest.\n\nEach basic land:\n- Subclasses :class:`~engine.card.Land`.\n- Has ``supertypes = {Supertype.BASIC}``.\n- Has a subtype matching its land type (e.g. ``{\"Plains\"}``).\n- Provides a :class:`~engine.card.ManaAbility` that taps to produce\n  one mana of its associated color.\n\nUse :func:`register_basic_lands` to register all five with a\n:class:`~cards.registry.CardRegistry`.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import Land, ManaAbility\nfrom engine.types import ManaType, Supertype\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n    from cards.registry import CardRegistry\n\n\n# ---------------------------------------------------------------------------\n# Mana-ability helpers\n# ---------------------------------------------------------------------------\n\ndef _tap_cost(game: GameState, source: Any) -> bool:\n    \"\"\"Generic tap-cost: check untapped, then tap.\n\n    Mirrors :func:`engine.abilities.tap_cost` logic so basic lands\n    can be activated through the abilities system or directly.\n    \"\"\"\n    if getattr(source, \"is_tapped\", False):\n        return False\n    source.is_tapped = True\n    return True\n\n\ndef _make_mana_effect(mana_type: ManaType):\n    \"\"\"Return an effect callable that adds 1 mana of *mana_type* to the controller's pool.\"\"\"\n\n    def _effect(game: GameState) -> None:  # noqa: ARG001 – game needed for signature\n        # The source is captured via the ability's activation context.\n        # However, ManaAbility.mana_produced is called by activate_ability's\n        # effect path.  We need to figure out who the controller is.\n        # This is handled at activation time — see get_mana_abilities below.\n        pass\n\n    return _effect\n\n\n# ---------------------------------------------------------------------------\n# Basic land classes\n# ---------------------------------------------------------------------------\n\nclass Plains(Land):\n    \"\"\"Basic Plains — taps for {W}.\"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Plains\"}\n        super().__init__(**kwargs)\n\n    def get_mana_abilities(self) -> list[ManaAbility]:\n        \"\"\"Return a single mana ability: {T}: Add {W}.\"\"\"\n        source = self\n\n        def _effect(game: GameState) -> None:\n            controller = source.controller\n            if controller is not None:\n                controller.mana_pool.add(ManaType.WHITE, 1)\n\n        return [\n            ManaAbility(\n                cost=_tap_cost,\n                mana_produced=_effect,\n                description=\"{T}: Add {W}.\",\n            )\n        ]\n\n\nclass Island(Land):\n    \"\"\"Basic Island — taps for {U}.\"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Island\"}\n        super().__init__(**kwargs)\n\n    def get_mana_abilities(self) -> list[ManaAbility]:\n        \"\"\"Return a single mana ability: {T}: Add {U}.\"\"\"\n        source = self\n\n        def _effect(game: GameState) -> None:\n            controller = source.controller\n            if controller is not None:\n                controller.mana_pool.add(ManaType.BLUE, 1)\n\n        return [\n            ManaAbility(\n                cost=_tap_cost,\n                mana_produced=_effect,\n                description=\"{T}: Add {U}.\",\n            )\n        ]\n\n\nclass Swamp(Land):\n    \"\"\"Basic Swamp — taps for {B}.\"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Swamp\"}\n        super().__init__(**kwargs)\n\n    def get_mana_abilities(self) -> list[ManaAbility]:\n        \"\"\"Return a single mana ability: {T}: Add {B}.\"\"\"\n        source = self\n\n        def _effect(game: GameState) -> None:\n            controller = source.controller\n            if controller is not None:\n                controller.mana_pool.add(ManaType.BLACK, 1)\n\n        return [\n            ManaAbility(\n                cost=_tap_cost,\n                mana_produced=_effect,\n                description=\"{T}: Add {B}.\",\n            )\n        ]\n\n\nclass Mountain(Land):\n    \"\"\"Basic Mountain — taps for {R}.\"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Mountain\"}\n        super().__init__(**kwargs)\n\n    def get_mana_abilities(self) -> list[ManaAbility]:\n        \"\"\"Return a single mana ability: {T}: Add {R}.\"\"\"\n        source = self\n\n        def _effect(game: GameState) -> None:\n            controller = source.controller\n            if controller is not None:\n                controller.mana_pool.add(ManaType.RED, 1)\n\n        return [\n            ManaAbility(\n                cost=_tap_cost,\n                mana_produced=_effect,\n                description=\"{T}: Add {R}.\",\n            )\n        ]\n\n\nclass Forest(Land):\n    \"\"\"Basic Forest — taps for {G}.\"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Forest\"}\n        super().__init__(**kwargs)\n\n    def get_mana_abilities(self) -> list[ManaAbility]:\n        \"\"\"Return a single mana ability: {T}: Add {G}.\"\"\"\n        source = self\n\n        def _effect(game: GameState) -> None:\n            controller = source.controller\n            if controller is not None:\n                controller.mana_pool.add(ManaType.GREEN, 1)\n\n        return [\n            ManaAbility(\n                cost=_tap_cost,\n                mana_produced=_effect,\n                description=\"{T}: Add {G}.\",\n            )\n        ]\n\n\n# ---------------------------------------------------------------------------\n# Registration helper\n# ---------------------------------------------------------------------------\n\ndef register_basic_lands(registry: CardRegistry) -> None:\n    \"\"\"Register all five basic lands with *registry*.\n\n    Each is registered under its canonical name (e.g. ``\"Plains\"``) with\n    :class:`~cards.registry.CardMetadata` reflecting its type line, colors,\n    and lack of mana cost.\n    \"\"\"\n    from cards.registry import CardMetadata\n\n    _BASIC_LANDS: list[tuple[str, type[Land], str]] = [\n        (\"Plains\", Plains, \"W\"),\n        (\"Island\", Island, \"U\"),\n        (\"Swamp\", Swamp, \"B\"),\n        (\"Mountain\", Mountain, \"R\"),\n        (\"Forest\", Forest, \"G\"),\n    ]\n\n    for card_name, impl_class, mana_symbol in _BASIC_LANDS:\n        metadata = CardMetadata(\n            name=card_name,\n            mana_cost_str=\"\",\n            type_line=f\"Basic Land — {card_name}\",\n            oracle_text=f\"({{T}}: Add {{{mana_symbol}}}.)\",\n            power=None,\n            toughness=None,\n            colors=[],\n            keywords=[],\n            rarity=\"common\",\n            set_code=\"\",\n            collector_number=\"\",\n        )\n        registry.register(card_name, impl_class, metadata)\n","numLines":227,"startLine":1,"totalLines":227}}}
