{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CZhPFCecVBGsg4xpQCm3Q7","type":"tool_result","content":"1\t\"\"\"Card implementation for Witness Protection.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Aura\n8\tfrom engine.continuous_effects import (\n9\t    ContinuousEffect,\n10\t    DURATION_PERMANENT,\n11\t    Layer,\n12\t    SubLayer,\n13\t)\n14\tfrom engine.types import CardType, Color, Keyword, ManaCost, TargetRequirement, Zone\n15\t\n16\tif TYPE_CHECKING:\n17\t    from engine.game_state import GameState\n18\t\n19\t\n20\tdef _creature_targets(game: Any) -> list[Any]:\n21\t    \"\"\"Return all creatures on the battlefield.\"\"\"\n22\t    targets: list[Any] = []\n23\t    for player in game.players:\n24\t        for obj in game.get_battlefield(player).get_all():\n25\t            if CardType.CREATURE in getattr(obj, \"card_types\", set()):\n26\t                targets.append(obj)\n27\t    return targets\n28\t\n29\t\n30\tdef _is_on_battlefield(game: Any, obj: Any) -> bool:\n31\t    \"\"\"Check if *obj* is on any player's battlefield.\"\"\"\n32\t    for player in game.players:\n33\t        if game.get_battlefield(player).contains(obj):\n34\t            return True\n35\t    return False\n36\t\n37\t\n38\tdef _get_chosen_target(card: Any, game: Any) -> Any:\n39\t    chosen = getattr(card, \"chosen_targets\", None)\n40\t    if chosen:\n41\t        return chosen[0]\n42\t    return getattr(card, \"_resolve_target\", None)\n43\t\n44\t\n45\tclass WitnessProtection(Aura):\n46\t    \"\"\"Witness Protection — {U}.\n47\t\n48\t    Enchant creature.\n49\t    Enchanted creature loses all abilities and is a green and white Citizen\n50\t    creature with base power and toughness 1/1 named Legitimate Businessperson.\n51\t    (It loses all other colors, card types, creature types, and names.)\n52\t    \"\"\"\n53\t\n54\t    def __init__(self, **kwargs: Any) -> None:\n55\t        kwargs.setdefault(\"name\", \"Witness Protection\")\n56\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{U}\"))\n57\t        kwargs.setdefault(\"subtypes\", set())\n58\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Aura\"}\n59\t        kwargs.setdefault(\n60\t            \"rules_text\",\n61\t            \"Enchant creature\\n\"\n62\t            \"Enchanted creature loses all abilities and is a green and white \"\n63\t            \"Citizen creature with base power and toughness 1/1 named \"\n64\t            \"Legitimate Businessperson.\",\n65\t        )\n66\t        super().__init__(**kwargs)\n67\t        self._type_effect_ref: ContinuousEffect | None = None\n68\t        self._color_effect_ref: ContinuousEffect | None = None\n69\t        self._ability_effect_ref: ContinuousEffect | None = None\n70\t        self._pt_effect_ref: ContinuousEffect | None = None\n71\t\n72\t    # -- targeting --------------------------------------------------------\n73\t\n74\t    def get_targets(self, game: GameState) -> list[Any]:\n75\t        targets = _creature_targets(game)\n76\t        if not targets:\n77\t            return []\n78\t        return [\n79\t            TargetRequirement(\n80\t                filter_fn=lambda obj: CardType.CREATURE\n81\t                in getattr(obj, \"card_types\", set()),\n82\t                description=\"enchant creature\",\n83\t                zone=Zone.BATTLEFIELD,\n84\t            )\n85\t        ]\n86\t\n87\t    def can_cast(self, game: GameState) -> bool:\n88\t        return bool(_creature_targets(game))\n89\t\n90\t    # -- resolution -------------------------------------------------------\n91\t\n92\t    def on_resolve(self, game: GameState) -> None:\n93\t        target = _get_chosen_target(self, game)\n94\t        if target is None:\n95\t            return\n96\t        if not _is_on_battlefield(game, target):\n97\t            return\n98\t        # Revalidate that target is still a creature (type may have changed).\n99\t        if CardType.CREATURE not in getattr(target, \"card_types\", set()):\n100\t            return\n101\t        self.attached_to = target\n102\t        self._register_effects(game)\n103\t\n104\t    # -- continuous effects -----------------------------------------------\n105\t    #\n106\t    # Layer 4 (TYPE):  Becomes a Citizen creature (loses other types/subtypes),\n107\t    #                  name becomes \"Legitimate Businessperson\".\n108\t    # Layer 5 (COLOR): Becomes green and white (loses other colors).\n109\t    # Layer 6 (ABILITY): Loses all abilities.\n110\t    # Layer 7b (SET_PT): Base power and toughness become 1/1.\n111\t\n112\t    def apply_continuous_effect(self, game: GameState) -> None:\n113\t        \"\"\"Apply all four layers of the Witness Protection effect.\"\"\"\n114\t        creature = self.attached_to\n115\t        if creature is None or not _is_on_battlefield(game, creature):\n116\t            return\n117\t        if not _is_on_battlefield(game, self):\n118\t            return\n119\t        self._apply_type_change(creature)\n120\t        self._apply_color_change(creature)\n121\t        self._apply_ability_removal(creature)\n122\t        self._apply_pt_set(creature)\n123\t\n124\t    def _apply_type_change(self, creature: Any) -> None:\n125\t        \"\"\"Layer 4: Override name, card types, and subtypes.\"\"\"\n126\t        creature.name = \"Legitimate Businessperson\"\n127\t        creature.card_types = {CardType.CREATURE}\n128\t        creature.subtypes = {\"Citizen\"}\n129\t\n130\t    def _apply_color_change(self, creature: Any) -> None:\n131\t        \"\"\"Layer 5: Override colors to green and white.\"\"\"\n132\t        # Set colors if the permanent tracks them.\n133\t        creature.colors = {Color.GREEN, Color.WHITE}\n134\t\n135\t    def _apply_ability_removal(self, creature: Any) -> None:\n136\t        \"\"\"Layer 6: Remove all abilities.\"\"\"\n137\t        creature.keywords = Keyword(0)\n138\t\n139\t    def _apply_pt_set(self, creature: Any) -> None:\n140\t        \"\"\"Layer 7b: Set base power and toughness to 1/1.\"\"\"\n141\t        creature.modified_power = 1\n142\t        creature.modified_toughness = 1\n143\t\n144\t    def _register_effects(self, game: GameState) -> None:\n145\t        aura_ref = self\n146\t\n147\t        # Layer 4: Type-changing (includes name override)\n148\t        def _apply_type(game: GameState) -> None:\n149\t            if not _is_on_battlefield(game, aura_ref):\n150\t                return\n151\t            creature = aura_ref.attached_to\n152\t            if creature is None or not _is_on_battlefield(game, creature):\n153\t                return\n154\t            aura_ref._apply_type_change(creature)\n155\t\n156\t        type_effect = ContinuousEffect(\n157\t            source=aura_ref,\n158\t            layer=Layer.TYPE,\n159\t            sublayer=None,\n160\t            apply=_apply_type,\n161\t            duration=DURATION_PERMANENT,\n162\t        )\n163\t        self._type_effect_ref = game.effect_manager.add(type_effect)\n164\t\n165\t        # Layer 5: Color-changing\n166\t        def _apply_color(game: GameState) -> None:\n167\t            if not _is_on_battlefield(game, aura_ref):\n168\t                return\n169\t            creature = aura_ref.attached_to\n170\t            if creature is None or not _is_on_battlefield(game, creature):\n171\t                return\n172\t            aura_ref._apply_color_change(creature)\n173\t\n174\t        color_effect = ContinuousEffect(\n175\t            source=aura_ref,\n176\t            layer=Layer.COLOR,\n177\t            sublayer=None,\n178\t            apply=_apply_color,\n179\t            duration=DURATION_PERMANENT,\n180\t        )\n181\t        self._color_effect_ref = game.effect_manager.add(color_effect)\n182\t\n183\t        # Layer 6: Ability removal\n184\t        def _apply_ability(game: GameState) -> None:\n185\t            if not _is_on_battlefield(game, aura_ref):\n186\t                return\n187\t            creature = aura_ref.attached_to\n188\t            if creature is None or not _is_on_battlefield(game, creature):\n189\t                return\n190\t            aura_ref._apply_ability_removal(creature)\n191\t\n192\t        ability_effect = ContinuousEffect(\n193\t            source=aura_ref,\n194\t            layer=Layer.ABILITY,\n195\t            sublayer=None,\n196\t            apply=_apply_ability,\n197\t            duration=DURATION_PERMANENT,\n198\t        )\n199\t        self._ability_effect_ref = game.effect_manager.add(ability_effect)\n200\t\n201\t        # Layer 7b: P/T setting\n202\t        def _apply_pt(game: GameState) -> None:\n203\t            if not _is_on_battlefield(game, aura_ref):\n204\t                return\n205\t            creature = aura_ref.attached_to\n206\t            if creature is None or not _is_on_battlefield(game, creature):\n207\t                return\n208\t            aura_ref._apply_pt_set(creature)\n209\t\n210\t        pt_effect = ContinuousEffect(\n211\t            source=aura_ref,\n212\t            layer=Layer.POWER_TOUGHNESS,\n213\t            sublayer=SubLayer.SET_PT,\n214\t            apply=_apply_pt,\n215\t            duration=DURATION_PERMANENT,\n216\t        )\n217\t        self._pt_effect_ref = game.effect_manager.add(pt_effect)\n218\t\n219\t        # ENGINE LIMITATION: EffectManager._reset_objects() does not restore\n220\t        # the ``name``, ``subtypes``, or ``colors`` attributes.  When this aura\n221\t        # leaves the battlefield the name/subtype/color changes will persist\n222\t        # until engine-level reset support is added for these fields.  The\n223\t        # continuous effect framework's reset-and-reapply cycle handles these\n224\t        # correctly while the aura is attached, but removal is not covered.\n225\t"}]},"parent_tool_use_id":null,"session_id":"1404691a-99e3-4d00-a347-c654df745e5c","uuid":"4a946c5f-58eb-4d5e-8fdf-c16dcf6e6afe","timestamp":"2026-06-04T03:29:26.180Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_168/card_impl.py","content":"\"\"\"Card implementation for Witness Protection.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import Aura\nfrom engine.continuous_effects import (\n    ContinuousEffect,\n    DURATION_PERMANENT,\n    Layer,\n    SubLayer,\n)\nfrom engine.types import CardType, Color, Keyword, ManaCost, TargetRequirement, Zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\ndef _creature_targets(game: Any) -> list[Any]:\n    \"\"\"Return all creatures on the battlefield.\"\"\"\n    targets: list[Any] = []\n    for player in game.players:\n        for obj in game.get_battlefield(player).get_all():\n            if CardType.CREATURE in getattr(obj, \"card_types\", set()):\n                targets.append(obj)\n    return targets\n\n\ndef _is_on_battlefield(game: Any, obj: Any) -> bool:\n    \"\"\"Check if *obj* is on any player's battlefield.\"\"\"\n    for player in game.players:\n        if game.get_battlefield(player).contains(obj):\n            return True\n    return False\n\n\ndef _get_chosen_target(card: Any, game: Any) -> Any:\n    chosen = getattr(card, \"chosen_targets\", None)\n    if chosen:\n        return chosen[0]\n    return getattr(card, \"_resolve_target\", None)\n\n\nclass WitnessProtection(Aura):\n    \"\"\"Witness Protection — {U}.\n\n    Enchant creature.\n    Enchanted creature loses all abilities and is a green and white Citizen\n    creature with base power and toughness 1/1 named Legitimate Businessperson.\n    (It loses all other colors, card types, creature types, and names.)\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"Witness Protection\")\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{U}\"))\n        kwargs.setdefault(\"subtypes\", set())\n        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Aura\"}\n        kwargs.setdefault(\n            \"rules_text\",\n            \"Enchant creature\\n\"\n            \"Enchanted creature loses all abilities and is a green and white \"\n            \"Citizen creature with base power and toughness 1/1 named \"\n            \"Legitimate Businessperson.\",\n        )\n        super().__init__(**kwargs)\n        self._type_effect_ref: ContinuousEffect | None = None\n        self._color_effect_ref: ContinuousEffect | None = None\n        self._ability_effect_ref: ContinuousEffect | None = None\n        self._pt_effect_ref: ContinuousEffect | None = None\n\n    # -- targeting --------------------------------------------------------\n\n    def get_targets(self, game: GameState) -> list[Any]:\n        targets = _creature_targets(game)\n        if not targets:\n            return []\n        return [\n            TargetRequirement(\n                filter_fn=lambda obj: CardType.CREATURE\n                in getattr(obj, \"card_types\", set()),\n                description=\"enchant creature\",\n                zone=Zone.BATTLEFIELD,\n            )\n        ]\n\n    def can_cast(self, game: GameState) -> bool:\n        return bool(_creature_targets(game))\n\n    # -- resolution -------------------------------------------------------\n\n    def on_resolve(self, game: GameState) -> None:\n        target = _get_chosen_target(self, game)\n        if target is None:\n            return\n        if not _is_on_battlefield(game, target):\n            return\n        # Revalidate that target is still a creature (type may have changed).\n        if CardType.CREATURE not in getattr(target, \"card_types\", set()):\n            return\n        self.attached_to = target\n        self._register_effects(game)\n\n    # -- continuous effects -----------------------------------------------\n    #\n    # Layer 4 (TYPE):  Becomes a Citizen creature (loses other types/subtypes),\n    #                  name becomes \"Legitimate Businessperson\".\n    # Layer 5 (COLOR): Becomes green and white (loses other colors).\n    # Layer 6 (ABILITY): Loses all abilities.\n    # Layer 7b (SET_PT): Base power and toughness become 1/1.\n\n    def apply_continuous_effect(self, game: GameState) -> None:\n        \"\"\"Apply all four layers of the Witness Protection effect.\"\"\"\n        creature = self.attached_to\n        if creature is None or not _is_on_battlefield(game, creature):\n            return\n        if not _is_on_battlefield(game, self):\n            return\n        self._apply_type_change(creature)\n        self._apply_color_change(creature)\n        self._apply_ability_removal(creature)\n        self._apply_pt_set(creature)\n\n    def _apply_type_change(self, creature: Any) -> None:\n        \"\"\"Layer 4: Override name, card types, and subtypes.\"\"\"\n        creature.name = \"Legitimate Businessperson\"\n        creature.card_types = {CardType.CREATURE}\n        creature.subtypes = {\"Citizen\"}\n\n    def _apply_color_change(self, creature: Any) -> None:\n        \"\"\"Layer 5: Override colors to green and white.\"\"\"\n        # Set colors if the permanent tracks them.\n        creature.colors = {Color.GREEN, Color.WHITE}\n\n    def _apply_ability_removal(self, creature: Any) -> None:\n        \"\"\"Layer 6: Remove all abilities.\"\"\"\n        creature.keywords = Keyword(0)\n\n    def _apply_pt_set(self, creature: Any) -> None:\n        \"\"\"Layer 7b: Set base power and toughness to 1/1.\"\"\"\n        creature.modified_power = 1\n        creature.modified_toughness = 1\n\n    def _register_effects(self, game: GameState) -> None:\n        aura_ref = self\n\n        # Layer 4: Type-changing (includes name override)\n        def _apply_type(game: GameState) -> None:\n            if not _is_on_battlefield(game, aura_ref):\n                return\n            creature = aura_ref.attached_to\n            if creature is None or not _is_on_battlefield(game, creature):\n                return\n            aura_ref._apply_type_change(creature)\n\n        type_effect = ContinuousEffect(\n            source=aura_ref,\n            layer=Layer.TYPE,\n            sublayer=None,\n            apply=_apply_type,\n            duration=DURATION_PERMANENT,\n        )\n        self._type_effect_ref = game.effect_manager.add(type_effect)\n\n        # Layer 5: Color-changing\n        def _apply_color(game: GameState) -> None:\n            if not _is_on_battlefield(game, aura_ref):\n                return\n            creature = aura_ref.attached_to\n            if creature is None or not _is_on_battlefield(game, creature):\n                return\n            aura_ref._apply_color_change(creature)\n\n        color_effect = ContinuousEffect(\n            source=aura_ref,\n            layer=Layer.COLOR,\n            sublayer=None,\n            apply=_apply_color,\n            duration=DURATION_PERMANENT,\n        )\n        self._color_effect_ref = game.effect_manager.add(color_effect)\n\n        # Layer 6: Ability removal\n        def _apply_ability(game: GameState) -> None:\n            if not _is_on_battlefield(game, aura_ref):\n                return\n            creature = aura_ref.attached_to\n            if creature is None or not _is_on_battlefield(game, creature):\n                return\n            aura_ref._apply_ability_removal(creature)\n\n        ability_effect = ContinuousEffect(\n            source=aura_ref,\n            layer=Layer.ABILITY,\n            sublayer=None,\n            apply=_apply_ability,\n            duration=DURATION_PERMANENT,\n        )\n        self._ability_effect_ref = game.effect_manager.add(ability_effect)\n\n        # Layer 7b: P/T setting\n        def _apply_pt(game: GameState) -> None:\n            if not _is_on_battlefield(game, aura_ref):\n                return\n            creature = aura_ref.attached_to\n            if creature is None or not _is_on_battlefield(game, creature):\n                return\n            aura_ref._apply_pt_set(creature)\n\n        pt_effect = ContinuousEffect(\n            source=aura_ref,\n            layer=Layer.POWER_TOUGHNESS,\n            sublayer=SubLayer.SET_PT,\n            apply=_apply_pt,\n            duration=DURATION_PERMANENT,\n        )\n        self._pt_effect_ref = game.effect_manager.add(pt_effect)\n\n        # ENGINE LIMITATION: EffectManager._reset_objects() does not restore\n        # the ``name``, ``subtypes``, or ``colors`` attributes.  When this aura\n        # leaves the battlefield the name/subtype/color changes will persist\n        # until engine-level reset support is added for these fields.  The\n        # continuous effect framework's reset-and-reapply cycle handles these\n        # correctly while the aura is attached, but removal is not covered.\n","numLines":225,"startLine":1,"totalLines":225}}}
