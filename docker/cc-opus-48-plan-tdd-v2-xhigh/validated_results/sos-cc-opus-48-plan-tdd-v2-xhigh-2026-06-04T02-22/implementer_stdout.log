{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RVMj9PoPXfGhDxJewcpsfc","type":"tool_result","content":"1\t\"\"\"Card implementation for Niv-Mizzet, Visionary.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom typing import TYPE_CHECKING, Any\n4\tfrom engine.card import Creature\n5\tfrom engine.types import Keyword, ManaCost\n6\tfrom engine.events import DealsDamageTriggeredEvent\n7\tif TYPE_CHECKING:\n8\t    from engine.game_state import GameState\n9\t\n10\tclass NivMizzetVisionary(Creature):\n11\t    \"\"\"Niv-Mizzet, Visionary — {4}{U}{R} — 5/5 — Legendary Dragon Wizard.\n12\t\n13\t    Flying\n14\t    You have no maximum hand size.\n15\t    Whenever a source you control deals noncombat damage to an opponent,\n16\t    you draw that many cards.\n17\t\n18\t    FDN collector number 123.\n19\t    \"\"\"\n20\t\n21\t    def __init__(self, **kwargs: Any) -> None:\n22\t        kwargs.setdefault('name', 'Niv-Mizzet, Visionary')\n23\t        kwargs.setdefault('mana_cost', ManaCost.parse('{4}{U}{R}'))\n24\t        kwargs.setdefault('subtypes', {'Dragon', 'Wizard'})\n25\t        kwargs.setdefault('supertypes', {'Legendary'})\n26\t        kwargs.setdefault('keywords', Keyword.FLYING)\n27\t        kwargs.setdefault('base_power', 5)\n28\t        kwargs.setdefault('base_toughness', 5)\n29\t        kwargs.setdefault('rules_text', 'Flying\\nYou have no maximum hand size.\\nWhenever a source you control deals noncombat damage to an opponent, you draw that many cards.')\n30\t        super().__init__(**kwargs)\n31\t\n32\t    def register_triggers(self, game: 'GameState') -> None:\n33\t        \"\"\"Register noncombat damage trigger and no-max-hand-size.\"\"\"\n34\t        from collections import deque\n35\t        from engine.game import draw_card\n36\t        from engine.triggers import TriggerRegistration\n37\t        source = self\n38\t        controller = getattr(self, 'controller', None) or game.active_player\n39\t        controller.no_maximum_hand_size = True\n40\t        _amount_queue: deque[int] = deque()\n41\t\n42\t        def _condition(game: Any, event: dict) -> bool:\n43\t            if event.is_combat:\n44\t                return False\n45\t            dmg_source = event.source\n46\t            if dmg_source is None:\n47\t                return False\n48\t            ctrl = getattr(source, 'controller', None)\n49\t            if ctrl is None:\n50\t                return False\n51\t            src_ctrl = getattr(dmg_source, 'controller', None)\n52\t            if src_ctrl is not ctrl:\n53\t                return False\n54\t            target = event.target\n55\t            if target is None or not hasattr(target, 'life'):\n56\t                return False\n57\t            if target is ctrl:\n58\t                return False\n59\t            _amount_queue.append(event.amount)\n60\t            return True\n61\t\n62\t        def _effect(game: 'GameState') -> None:\n63\t            ctrl = getattr(source, 'controller', None)\n64\t            if ctrl is None:\n65\t                return\n66\t            amount = _amount_queue.popleft() if _amount_queue else 1\n67\t            for _ in range(amount):\n68\t                draw_card(game, ctrl)\n69\t        game.trigger_manager.register(TriggerRegistration(event_type=DealsDamageTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=controller))\n70\t\n71\t    def unregister_triggers(self, game: 'GameState') -> None:\n72\t        \"\"\"Clean up no-max-hand-size on controller.\"\"\"\n73\t        controller = getattr(self, 'controller', None)\n74\t        if controller is not None:\n75\t            controller.no_maximum_hand_size = False\n76\t"}]},"parent_tool_use_id":null,"session_id":"1404691a-99e3-4d00-a347-c654df745e5c","uuid":"20cdf220-2cad-48a3-9157-9e3d527cc377","timestamp":"2026-06-04T02:46:01.958Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_123/card_impl.py","content":"\"\"\"Card implementation for Niv-Mizzet, Visionary.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import Creature\nfrom engine.types import Keyword, ManaCost\nfrom engine.events import DealsDamageTriggeredEvent\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\nclass NivMizzetVisionary(Creature):\n    \"\"\"Niv-Mizzet, Visionary — {4}{U}{R} — 5/5 — Legendary Dragon Wizard.\n\n    Flying\n    You have no maximum hand size.\n    Whenever a source you control deals noncombat damage to an opponent,\n    you draw that many cards.\n\n    FDN collector number 123.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Niv-Mizzet, Visionary')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{4}{U}{R}'))\n        kwargs.setdefault('subtypes', {'Dragon', 'Wizard'})\n        kwargs.setdefault('supertypes', {'Legendary'})\n        kwargs.setdefault('keywords', Keyword.FLYING)\n        kwargs.setdefault('base_power', 5)\n        kwargs.setdefault('base_toughness', 5)\n        kwargs.setdefault('rules_text', 'Flying\\nYou have no maximum hand size.\\nWhenever a source you control deals noncombat damage to an opponent, you draw that many cards.')\n        super().__init__(**kwargs)\n\n    def register_triggers(self, game: 'GameState') -> None:\n        \"\"\"Register noncombat damage trigger and no-max-hand-size.\"\"\"\n        from collections import deque\n        from engine.game import draw_card\n        from engine.triggers import TriggerRegistration\n        source = self\n        controller = getattr(self, 'controller', None) or game.active_player\n        controller.no_maximum_hand_size = True\n        _amount_queue: deque[int] = deque()\n\n        def _condition(game: Any, event: dict) -> bool:\n            if event.is_combat:\n                return False\n            dmg_source = event.source\n            if dmg_source is None:\n                return False\n            ctrl = getattr(source, 'controller', None)\n            if ctrl is None:\n                return False\n            src_ctrl = getattr(dmg_source, 'controller', None)\n            if src_ctrl is not ctrl:\n                return False\n            target = event.target\n            if target is None or not hasattr(target, 'life'):\n                return False\n            if target is ctrl:\n                return False\n            _amount_queue.append(event.amount)\n            return True\n\n        def _effect(game: 'GameState') -> None:\n            ctrl = getattr(source, 'controller', None)\n            if ctrl is None:\n                return\n            amount = _amount_queue.popleft() if _amount_queue else 1\n            for _ in range(amount):\n                draw_card(game, ctrl)\n        game.trigger_manager.register(TriggerRegistration(event_type=DealsDamageTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=controller))\n\n    def unregister_triggers(self, game: 'GameState') -> None:\n        \"\"\"Clean up no-max-hand-size on controller.\"\"\"\n        controller = getattr(self, 'controller', None)\n        if controller is not None:\n            controller.no_maximum_hand_size = False\n","numLines":76,"startLine":1,"totalLines":76}}}
