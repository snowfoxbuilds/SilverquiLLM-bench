{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013PNrvcq4k2fcNLX5mUM5oR","type":"tool_result","content":"1\t\"\"\"Card implementation for Midnight Snack.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom typing import TYPE_CHECKING, Any\n4\tfrom engine.card import Enchantment, Creature, ActivatedAbility\n5\tfrom engine.types import CardType, ManaCost, Zone\n6\tfrom engine.events import EndStepTriggeredEvent\n7\tif TYPE_CHECKING:\n8\t    from engine.game_state import GameState\n9\t\n10\tclass MidnightSnack(Enchantment):\n11\t    \"\"\"Midnight Snack — {2}{B} — Enchantment.\n12\t\n13\t    Raid — At the beginning of your end step, if you attacked this turn,\n14\t    create a Food token.\n15\t    {2}{B}, Sacrifice this enchantment: Target opponent loses X life, where\n16\t    X is the amount of life you gained this turn.\n17\t\n18\t    FDN collector number 65.\n19\t    \"\"\"\n20\t\n21\t    def __init__(self, **kwargs: Any) -> None:\n22\t        kwargs.setdefault('name', 'Midnight Snack')\n23\t        kwargs.setdefault('mana_cost', ManaCost.parse('{2}{B}'))\n24\t        kwargs.setdefault('rules_text', 'Raid — At the beginning of your end step, if you attacked this turn, create a Food token.\\n{2}{B}, Sacrifice this enchantment: Target opponent loses X life, where X is the amount of life you gained this turn.')\n25\t        super().__init__(**kwargs)\n26\t\n27\t    def register_triggers(self, game: 'GameState') -> None:\n28\t        \"\"\"Register end step trigger for Raid Food creation.\"\"\"\n29\t        from engine.triggers import TriggerRegistration\n30\t        from engine.game import create_token\n31\t        source = self\n32\t\n33\t        def _condition(game: Any, event: dict) -> bool:\n34\t            controller = getattr(source, 'controller', None)\n35\t            if controller is None:\n36\t                return False\n37\t            return getattr(controller, 'attacked_this_turn', False)\n38\t\n39\t        def _effect(game: 'GameState') -> None:\n40\t            controller = getattr(source, 'controller', None)\n41\t            if controller is None:\n42\t                return\n43\t            from engine.card import Artifact\n44\t            food = Artifact(name='Food', subtypes={'Food'}, is_token=True)\n45\t            create_token(game, controller, food)\n46\t        controller = getattr(self, 'controller', None) or game.active_player\n47\t        game.trigger_manager.register(TriggerRegistration(event_type=EndStepTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=controller))\n48\t\n49\t    def get_activated_abilities(self, game: 'GameState') -> list:\n50\t        \"\"\"Sacrifice ability: target opponent loses X life.\"\"\"\n51\t        source = self\n52\t\n53\t        def _sac_effect(game: 'GameState') -> None:\n54\t            from engine.game import sacrifice\n55\t            controller = getattr(source, 'controller', None)\n56\t            if controller is None:\n57\t                return\n58\t            life_gained = getattr(controller, 'life_gained_this_turn', 0)\n59\t            sacrifice(game, controller, source)\n60\t            opponents = [p for p in game.players if p is not controller]\n61\t            if opponents and life_gained > 0:\n62\t                target = opponents[0]\n63\t                target.life -= life_gained\n64\t\n65\t        def _sac_cost(game: 'GameState', src=self) -> bool:\n66\t            \"\"\"Pay {2}{B} mana cost for the sacrifice ability.\"\"\"\n67\t            controller = getattr(src, 'controller', None)\n68\t            if controller is None:\n69\t                return False\n70\t            cost = ManaCost.parse('{2}{B}')\n71\t            if not controller.mana_pool.can_pay(cost):\n72\t                return False\n73\t            controller.mana_pool.pay(cost)\n74\t            return True\n75\t        ability = ActivatedAbility(cost=_sac_cost, effect=_sac_effect, description='{2}{B}, Sacrifice this enchantment: Target opponent loses X life, where X is the amount of life you gained this turn.')\n76\t        ability.tap_cost = False\n77\t        return [ability]\n78\t"}]},"parent_tool_use_id":null,"session_id":"1404691a-99e3-4d00-a347-c654df745e5c","uuid":"670d73e1-7eb1-48a5-9c2b-c7d3def24839","timestamp":"2026-06-04T03:07:28.944Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_65/card_impl.py","content":"\"\"\"Card implementation for Midnight Snack.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import Enchantment, Creature, ActivatedAbility\nfrom engine.types import CardType, ManaCost, Zone\nfrom engine.events import EndStepTriggeredEvent\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\nclass MidnightSnack(Enchantment):\n    \"\"\"Midnight Snack — {2}{B} — Enchantment.\n\n    Raid — At the beginning of your end step, if you attacked this turn,\n    create a Food token.\n    {2}{B}, Sacrifice this enchantment: Target opponent loses X life, where\n    X is the amount of life you gained this turn.\n\n    FDN collector number 65.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Midnight Snack')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{2}{B}'))\n        kwargs.setdefault('rules_text', 'Raid — At the beginning of your end step, if you attacked this turn, create a Food token.\\n{2}{B}, Sacrifice this enchantment: Target opponent loses X life, where X is the amount of life you gained this turn.')\n        super().__init__(**kwargs)\n\n    def register_triggers(self, game: 'GameState') -> None:\n        \"\"\"Register end step trigger for Raid Food creation.\"\"\"\n        from engine.triggers import TriggerRegistration\n        from engine.game import create_token\n        source = self\n\n        def _condition(game: Any, event: dict) -> bool:\n            controller = getattr(source, 'controller', None)\n            if controller is None:\n                return False\n            return getattr(controller, 'attacked_this_turn', False)\n\n        def _effect(game: 'GameState') -> None:\n            controller = getattr(source, 'controller', None)\n            if controller is None:\n                return\n            from engine.card import Artifact\n            food = Artifact(name='Food', subtypes={'Food'}, is_token=True)\n            create_token(game, controller, food)\n        controller = getattr(self, 'controller', None) or game.active_player\n        game.trigger_manager.register(TriggerRegistration(event_type=EndStepTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=controller))\n\n    def get_activated_abilities(self, game: 'GameState') -> list:\n        \"\"\"Sacrifice ability: target opponent loses X life.\"\"\"\n        source = self\n\n        def _sac_effect(game: 'GameState') -> None:\n            from engine.game import sacrifice\n            controller = getattr(source, 'controller', None)\n            if controller is None:\n                return\n            life_gained = getattr(controller, 'life_gained_this_turn', 0)\n            sacrifice(game, controller, source)\n            opponents = [p for p in game.players if p is not controller]\n            if opponents and life_gained > 0:\n                target = opponents[0]\n                target.life -= life_gained\n\n        def _sac_cost(game: 'GameState', src=self) -> bool:\n            \"\"\"Pay {2}{B} mana cost for the sacrifice ability.\"\"\"\n            controller = getattr(src, 'controller', None)\n            if controller is None:\n                return False\n            cost = ManaCost.parse('{2}{B}')\n            if not controller.mana_pool.can_pay(cost):\n                return False\n            controller.mana_pool.pay(cost)\n            return True\n        ability = ActivatedAbility(cost=_sac_cost, effect=_sac_effect, description='{2}{B}, Sacrifice this enchantment: Target opponent loses X life, where X is the amount of life you gained this turn.')\n        ability.tap_cost = False\n        return [ability]\n","numLines":78,"startLine":1,"totalLines":78}}}
