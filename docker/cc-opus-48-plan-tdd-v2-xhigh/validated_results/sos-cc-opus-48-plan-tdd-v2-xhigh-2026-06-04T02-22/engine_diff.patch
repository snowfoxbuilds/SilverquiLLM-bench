+def cast_for_cost(
+    game: GameState,
+    player: Player,
+    card: CardImpl,
+    cost: ManaCost,
+    from_zone: Zone = Zone.HAND,
+) -> None:
+    """Cast *card* paying *cost* instead of its printed mana cost.
+
+    Used by alternative-cost mechanics such as miracle, where an effect
+    grants a special casting window and a substitute cost.  The normal
+    sorcery/instant *timing* check is skipped — the casting window is the
+    responsibility of the effect that calls this (e.g. the miracle trigger
+    resolving) — but legality (``can_cast``), targeting, and mana payment
+    are enforced exactly as in :func:`cast_spell`.
+
+    Parameters:
+        game: The current game state.
+        player: The player casting the spell.
+        card: The card to cast.
+        cost: The :class:`ManaCost` to pay in place of the printed cost.
+        from_zone: The zone the card is currently in (default: hand).
+
+    Raises:
+        CastingError: If legality, targeting, or mana payment fails.
+    """
+    # Legality
+    if not card.can_cast(game):
+        raise CastingError(f"Cannot cast {card.name!r} — can_cast returned False")
+
+    # Locate the card in its source zone
+    source_zone = player.zones[from_zone]
+    if not source_zone.contains(card):
+        raise CastingError(
+            f"Cannot cast {card.name!r} — card not in {from_zone.name}"
+        )
+
+    stack_zone = player.zones[Zone.STACK]
+    source_zone.remove(card)
+    stack_zone.add(card)
+
+    if hasattr(card, "colors_spent"):
+        del card.colors_spent
+
+    if card.controller is None:
+        card.controller = player
+
+    # Choose targets (rollback to source zone on failure)
+    try:
+        target_specs = card.get_targets(game)
+        chosen_targets: list[Any] = []
+        if target_specs:
+            from engine.protection import has_protection_from
+
+            for spec in target_specs:
+                target = player.choose_target(target_specs, spec)
+                filter_fn = getattr(spec, "filter_fn", None)
+                if filter_fn is not None and target is not None:
+                    if not filter_fn(target):
+                        raise CastingError(
+                            f"Cannot cast {card.name!r} — chosen target does "
+                            f"not satisfy filter: {getattr(spec, 'description', '')}"
+                        )
+                if target is not None and has_protection_from(target, card):
+                    raise CastingError(
+                        f"Cannot cast {card.name!r} — target has protection "
+                        "from this spell"
+                    )
+                chosen_targets.append(target)
+    except Exception as exc:
+        stack_zone.remove(card)
+        source_zone.add(card)
+        raise CastingError(str(exc)) from exc
+
+    # Mana payment (rollback on failure)
+    if not player.mana_pool.can_pay(cost):
+        stack_zone.remove(card)
+        source_zone.add(card)
+        raise CastingError(
+            f"Cannot cast {card.name!r} — insufficient mana for alternative cost"
+        )
+    pool_before = player.mana_pool.total()
+    player.mana_pool.pay(cost)
+    card.mana_spent = pool_before - player.mana_pool.total()  # type: ignore[attr-defined]
+    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]
+
+    card.on_cast(game)
+
+    stack_obj = StackObject(
+        source=card,
+        controller=player,
+        targets=chosen_targets,
+        on_resolve=lambda g: None,
+    )
+
+    def _on_resolve(g: GameState) -> None:
+        _resolve_spell(g, card, player, stack_obj)
+
+    stack_obj.on_resolve = _on_resolve
+    game.stack.push(stack_obj)
+
+    from engine.events import SpellCastTriggeredEvent
+
+    game.trigger_manager.fire_event(
+        game,
+        SpellCastTriggeredEvent(
+            spell=stack_obj, player=player, card=card, controller=player
+        ),
+    )
+
+
 # ------------------------------------------------------------------
 # Resolution (called when the stack pops)
 # ------------------------------------------------------------------
