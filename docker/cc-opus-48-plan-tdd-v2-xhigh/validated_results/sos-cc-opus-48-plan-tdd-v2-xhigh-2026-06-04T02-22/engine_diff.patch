+def surveil(game: GameState, player: Player, n: int) -> None:
+    """Surveil *n* — look at the top *n* cards of *player*'s library, then
+    put any number of them into their graveyard; the rest stay on top of
+    the library in their current order.
+
+    Each examined card (from the top down) is offered individually via
+    :meth:`Player.choose_yes_no`; a ``True`` answer sends it to the
+    graveyard, ``False`` leaves it on top.
+
+    Parameters:
+        game: The current game state.
+        player: The player surveilling.
+        n: How many cards to look at.
+    """
+    if n <= 0:
+        return
+
+    library = player.zones[Zone.LIBRARY]
+    graveyard = player.zones[Zone.GRAVEYARD]
+
+    # Examine from the top of the library downward.
+    top_cards = list(reversed(library.top(n)))
+    for card in top_cards:
+        name = getattr(card, "name", "card")
+        if player.choose_yes_no(f"Surveil: put {name} into your graveyard?"):
+            library.remove(card)
+            graveyard.add(card)
+
+
+def flip_coin(game: GameState, player: Player) -> bool:
+    """Flip a coin for *player*.  Returns ``True`` for heads, ``False`` tails.
+
+    For deterministic play/testing, if *player* carries a ``_coin_flips``
+    sequence (list or deque) of pending results, the next result is consumed
+    from the front; otherwise the outcome is random.
+    """
+    scripted = getattr(player, "_coin_flips", None)
+    if scripted:
+        if hasattr(scripted, "popleft"):
+            return bool(scripted.popleft())
+        return bool(scripted.pop(0))
+    return random.choice((True, False))
+
