{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MAekBrSQNK7Hhj9oPaHjTP","type":"tool_result","content":"1\t\"\"\"Basic land implementations — Plains, Island, Swamp, Mountain, Forest.\n2\t\n3\tEach basic land:\n4\t- Subclasses :class:`~engine.card.Land`.\n5\t- Has ``supertypes = {Supertype.BASIC}``.\n6\t- Has a subtype matching its land type (e.g. ``{\"Plains\"}``).\n7\t- Provides a :class:`~engine.card.ManaAbility` that taps to produce\n8\t  one mana of its associated color.\n9\t\n10\tUse :func:`register_basic_lands` to register all five with a\n11\t:class:`~cards.registry.CardRegistry`.\n12\t\"\"\"\n13\t\n14\tfrom __future__ import annotations\n15\t\n16\tfrom typing import TYPE_CHECKING, Any\n17\t\n18\tfrom engine.card import Land, ManaAbility\n19\tfrom engine.types import ManaType, Supertype\n20\t\n21\tif TYPE_CHECKING:\n22\t    from engine.game_state import GameState\n23\t    from engine.player import Player\n24\t\n25\t    from cards.registry import CardRegistry\n26\t\n27\t\n28\t# ---------------------------------------------------------------------------\n29\t# Mana-ability helpers\n30\t# ---------------------------------------------------------------------------\n31\t\n32\tdef _tap_cost(game: GameState, source: Any) -> bool:\n33\t    \"\"\"Generic tap-cost: check untapped, then tap.\n34\t\n35\t    Mirrors :func:`engine.abilities.tap_cost` logic so basic lands\n36\t    can be activated through the abilities system or directly.\n37\t    \"\"\"\n38\t    if getattr(source, \"is_tapped\", False):\n39\t        return False\n40\t    source.is_tapped = True\n41\t    return True\n42\t\n43\t\n44\tdef _make_mana_effect(mana_type: ManaType):\n45\t    \"\"\"Return an effect callable that adds 1 mana of *mana_type* to the controller's pool.\"\"\"\n46\t\n47\t    def _effect(game: GameState) -> None:  # noqa: ARG001 – game needed for signature\n48\t        # The source is captured via the ability's activation context.\n49\t        # However, ManaAbility.mana_produced is called by activate_ability's\n50\t        # effect path.  We need to figure out who the controller is.\n51\t        # This is handled at activation time — see get_mana_abilities below.\n52\t        pass\n53\t\n54\t    return _effect\n55\t\n56\t\n57\t# ---------------------------------------------------------------------------\n58\t# Basic land classes\n59\t# ---------------------------------------------------------------------------\n60\t\n61\tclass Plains(Land):\n62\t    \"\"\"Basic Plains — taps for {W}.\"\"\"\n63\t\n64\t    def __init__(self, **kwargs: Any) -> None:\n65\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n66\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Plains\"}\n67\t        super().__init__(**kwargs)\n68\t\n69\t    def get_mana_abilities(self) -> list[ManaAbility]:\n70\t        \"\"\"Return a single mana ability: {T}: Add {W}.\"\"\"\n71\t        source = self\n72\t\n73\t        def _effect(game: GameState) -> None:\n74\t            controller = source.controller\n75\t            if controller is not None:\n76\t                controller.mana_pool.add(ManaType.WHITE, 1)\n77\t\n78\t        return [\n79\t            ManaAbility(\n80\t                cost=_tap_cost,\n81\t                mana_produced=_effect,\n82\t                description=\"{T}: Add {W}.\",\n83\t            )\n84\t        ]\n85\t\n86\t\n87\tclass Island(Land):\n88\t    \"\"\"Basic Island — taps for {U}.\"\"\"\n89\t\n90\t    def __init__(self, **kwargs: Any) -> None:\n91\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n92\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Island\"}\n93\t        super().__init__(**kwargs)\n94\t\n95\t    def get_mana_abilities(self) -> list[ManaAbility]:\n96\t        \"\"\"Return a single mana ability: {T}: Add {U}.\"\"\"\n97\t        source = self\n98\t\n99\t        def _effect(game: GameState) -> None:\n100\t            controller = source.controller\n101\t            if controller is not None:\n102\t                controller.mana_pool.add(ManaType.BLUE, 1)\n103\t\n104\t        return [\n105\t            ManaAbility(\n106\t                cost=_tap_cost,\n107\t                mana_produced=_effect,\n108\t                description=\"{T}: Add {U}.\",\n109\t            )\n110\t        ]\n111\t\n112\t\n113\tclass Swamp(Land):\n114\t    \"\"\"Basic Swamp — taps for {B}.\"\"\"\n115\t\n116\t    def __init__(self, **kwargs: Any) -> None:\n117\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n118\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Swamp\"}\n119\t        super().__init__(**kwargs)\n120\t\n121\t    def get_mana_abilities(self) -> list[ManaAbility]:\n122\t        \"\"\"Return a single mana ability: {T}: Add {B}.\"\"\"\n123\t        source = self\n124\t\n125\t        def _effect(game: GameState) -> None:\n126\t            controller = source.controller\n127\t            if controller is not None:\n128\t                controller.mana_pool.add(ManaType.BLACK, 1)\n129\t\n130\t        return [\n131\t            ManaAbility(\n132\t                cost=_tap_cost,\n133\t                mana_produced=_effect,\n134\t                description=\"{T}: Add {B}.\",\n135\t            )\n136\t        ]\n137\t\n138\t\n139\tclass Mountain(Land):\n140\t    \"\"\"Basic Mountain — taps for {R}.\"\"\"\n141\t\n142\t    def __init__(self, **kwargs: Any) -> None:\n143\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n144\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Mountain\"}\n145\t        super().__init__(**kwargs)\n146\t\n147\t    def get_mana_abilities(self) -> list[ManaAbility]:\n148\t        \"\"\"Return a single mana ability: {T}: Add {R}.\"\"\"\n149\t        source = self\n150\t\n151\t        def _effect(game: GameState) -> None:\n152\t            controller = source.controller\n153\t            if controller is not None:\n154\t                controller.mana_pool.add(ManaType.RED, 1)\n155\t\n156\t        return [\n157\t            ManaAbility(\n158\t                cost=_tap_cost,\n159\t                mana_produced=_effect,\n160\t                description=\"{T}: Add {R}.\",\n161\t            )\n162\t        ]\n163\t\n164\t\n165\tclass Forest(Land):\n166\t    \"\"\"Basic Forest — taps for {G}.\"\"\"\n167\t\n168\t    def __init__(self, **kwargs: Any) -> None:\n169\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n170\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Forest\"}\n171\t        super().__init__(**kwargs)\n172\t\n173\t    def get_mana_abilities(self) -> list[ManaAbility]:\n174\t        \"\"\"Return a single mana ability: {T}: Add {G}.\"\"\"\n175\t        source = self\n176\t\n177\t        def _effect(game: GameState) -> None:\n178\t            controller = source.controller\n179\t            if controller is not None:\n180\t                controller.mana_pool.add(ManaType.GREEN, 1)\n181\t\n182\t        return [\n183\t            ManaAbility(\n184\t                cost=_tap_cost,\n185\t                mana_produced=_effect,\n186\t                description=\"{T}: Add {G}.\",\n187\t            )\n188\t        ]\n189\t\n190\t\n191\t# ---------------------------------------------------------------------------\n192\t# Registration helper\n193\t# ---------------------------------------------------------------------------\n194\t\n195\tdef register_basic_lands(registry: CardRegistry) -> None:\n196\t    \"\"\"Register all five basic lands with *registry*.\n197\t\n198\t    Each is registered under its canonical name (e.g. ``\"Plains\"``) with\n199\t    :class:`~cards.registry.CardMetadata` reflecting its type line, colors,\n200\t    and lack of mana cost.\n201\t    \"\"\"\n202\t    from cards.registry import CardMetadata\n203\t\n204\t    _BASIC_LANDS: list[tuple[str, type[Land], str]] = [\n205\t        (\"Plains\", Plains, \"W\"),\n206\t        (\"Island\", Island, \"U\"),\n207\t        (\"Swamp\", Swamp, \"B\"),\n208\t        (\"Mountain\", Mountain, \"R\"),\n209\t        (\"Forest\", Forest, \"G\"),\n210\t    ]\n211\t\n212\t    for card_name, impl_class, mana_symbol in _BASIC_LANDS:\n213\t        metadata = CardMetadata(\n214\t            name=card_name,\n215\t            mana_cost_str=\"\",\n216\t            type_line=f\"Basic Land — {card_name}\",\n217\t            oracle_text=f\"({{T}}: Add {{{mana_symbol}}}.)\",\n218\t            power=None,\n219\t            toughness=None,\n220\t            colors=[],\n221\t            keywords=[],\n222\t            rarity=\"common\",\n223\t            set_code=\"\",\n224\t            collector_number=\"\",\n225\t        )\n226\t        registry.register(card_name, impl_class, metadata)\n227\t"}]},"parent_tool_use_id":null,"session_id":"29d12edd-e81c-4550-a480-8db127b1d09f","uuid":"497cb512-6b72-41b8-8620-5f132b3bdfcf","timestamp":"2026-06-04T02:24:08.571Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/basic_lands.py","content":"\"\"\"Basic land implementations — Plains, Island, Swamp, Mountain, Forest.\n\nEach basic land:\n- Subclasses :class:`~engine.card.Land`.\n- Has ``supertypes = {Supertype.BASIC}``.\n- Has a subtype matching its land type (e.g. ``{\"Plains\"}``).\n- Provides a :class:`~engine.card.ManaAbility` that taps to produce\n  one mana of its associated color.\n\nUse :func:`register_basic_lands` to register all five with a\n:class:`~cards.registry.CardRegistry`.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import Land, ManaAbility\nfrom engine.types import ManaType, Supertype\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n    from cards.registry import CardRegistry\n\n\n# ---------------------------------------------------------------------------\n# Mana-ability helpers\n# ---------------------------------------------------------------------------\n\ndef _tap_cost(game: GameState, source: Any) -> bool:\n    \"\"\"Generic tap-cost: check untapped, then tap.\n\n    Mirrors :func:`engine.abilities.tap_cost` logic so basic lands\n    can be activated through the abilities system or directly.\n    \"\"\"\n    if getattr(source, \"is_tapped\", False):\n        return False\n    source.is_tapped = True\n    return True\n\n\ndef _make_mana_effect(mana_type: ManaType):\n    \"\"\"Return an effect callable that adds 1 mana of *mana_type* to the controller's pool.\"\"\"\n\n    def _effect(game: GameState) -> None:  # noqa: ARG001 – game needed for signature\n        # The source is captured via the ability's activation context.\n        # However, ManaAbility.mana_produced is called by activate_ability's\n        # effect path.  We need to figure out who the controller is.\n        # This is handled at activation time — see get_mana_abilities below.\n        pass\n\n    return _effect\n\n\n# ---------------------------------------------------------------------------\n# Basic land classes\n# ---------------------------------------------------------------------------\n\nclass Plains(Land):\n    \"\"\"Basic Plains — taps for {W}.\"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Plains\"}\n        super().__init__(**kwargs)\n\n    def get_mana_abilities(self) -> list[ManaAbility]:\n        \"\"\"Return a single mana ability: {T}: Add {W}.\"\"\"\n        source = self\n\n        def _effect(game: GameState) -> None:\n            controller = source.controller\n            if controller is not None:\n                controller.mana_pool.add(ManaType.WHITE, 1)\n\n        return [\n            ManaAbility(\n                cost=_tap_cost,\n                mana_produced=_effect,\n                description=\"{T}: Add {W}.\",\n            )\n        ]\n\n\nclass Island(Land):\n    \"\"\"Basic Island — taps for {U}.\"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Island\"}\n        super().__init__(**kwargs)\n\n    def get_mana_abilities(self) -> list[ManaAbility]:\n        \"\"\"Return a single mana ability: {T}: Add {U}.\"\"\"\n        source = self\n\n        def _effect(game: GameState) -> None:\n            controller = source.controller\n            if controller is not None:\n                controller.mana_pool.add(ManaType.BLUE, 1)\n\n        return [\n            ManaAbility(\n                cost=_tap_cost,\n                mana_produced=_effect,\n                description=\"{T}: Add {U}.\",\n            )\n        ]\n\n\nclass Swamp(Land):\n    \"\"\"Basic Swamp — taps for {B}.\"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Swamp\"}\n        super().__init__(**kwargs)\n\n    def get_mana_abilities(self) -> list[ManaAbility]:\n        \"\"\"Return a single mana ability: {T}: Add {B}.\"\"\"\n        source = self\n\n        def _effect(game: GameState) -> None:\n            controller = source.controller\n            if controller is not None:\n                controller.mana_pool.add(ManaType.BLACK, 1)\n\n        return [\n            ManaAbility(\n                cost=_tap_cost,\n                mana_produced=_effect,\n                description=\"{T}: Add {B}.\",\n            )\n        ]\n\n\nclass Mountain(Land):\n    \"\"\"Basic Mountain — taps for {R}.\"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Mountain\"}\n        super().__init__(**kwargs)\n\n    def get_mana_abilities(self) -> list[ManaAbility]:\n        \"\"\"Return a single mana ability: {T}: Add {R}.\"\"\"\n        source = self\n\n        def _effect(game: GameState) -> None:\n            controller = source.controller\n            if controller is not None:\n                controller.mana_pool.add(ManaType.RED, 1)\n\n        return [\n            ManaAbility(\n                cost=_tap_cost,\n                mana_produced=_effect,\n                description=\"{T}: Add {R}.\",\n            )\n        ]\n\n\nclass Forest(Land):\n    \"\"\"Basic Forest — taps for {G}.\"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Forest\"}\n        super().__init__(**kwargs)\n\n    def get_mana_abilities(self) -> list[ManaAbility]:\n        \"\"\"Return a single mana ability: {T}: Add {G}.\"\"\"\n        source = self\n\n        def _effect(game: GameState) -> None:\n            controller = source.controller\n            if controller is not None:\n                controller.mana_pool.add(ManaType.GREEN, 1)\n\n        return [\n            ManaAbility(\n                cost=_tap_cost,\n                mana_produced=_effect,\n                description=\"{T}: Add {G}.\",\n            )\n        ]\n\n\n# ---------------------------------------------------------------------------\n# Registration helper\n# ---------------------------------------------------------------------------\n\ndef register_basic_lands(registry: CardRegistry) -> None:\n    \"\"\"Register all five basic lands with *registry*.\n\n    Each is registered under its canonical name (e.g. ``\"Plains\"``) with\n    :class:`~cards.registry.CardMetadata` reflecting its type line, colors,\n    and lack of mana cost.\n    \"\"\"\n    from cards.registry import CardMetadata\n\n    _BASIC_LANDS: list[tuple[str, type[Land], str]] = [\n        (\"Plains\", Plains, \"W\"),\n        (\"Island\", Island, \"U\"),\n        (\"Swamp\", Swamp, \"B\"),\n        (\"Mountain\", Mountain, \"R\"),\n        (\"Forest\", Forest, \"G\"),\n    ]\n\n    for card_name, impl_class, mana_symbol in _BASIC_LANDS:\n        metadata = CardMetadata(\n            name=card_name,\n            mana_cost_str=\"\",\n            type_line=f\"Basic Land — {card_name}\",\n            oracle_text=f\"({{T}}: Add {{{mana_symbol}}}.)\",\n            power=None,\n            toughness=None,\n            colors=[],\n            keywords=[],\n            rarity=\"common\",\n            set_code=\"\",\n            collector_number=\"\",\n        )\n        registry.register(card_name, impl_class, metadata)\n","numLines":227,"startLine":1,"totalLines":227}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YXuS7s4GCJEE2r1KTfz37V","type":"tool_result","content":"1\t\"\"\"Protection from qualities — keyword ability implementation.\n2\t\n3\tImplements the 'protection from [quality]' keyword per MTG rules.\n4\tProtection prevents (DEBT mnemonic):\n5\t  - **D**amage from sources with that quality\n6\t  - **E**nchanting/equipping by permanents with that quality\n7\t  - **B**locking by creatures with that quality\n8\t  - **T**argeting by spells/abilities from sources with that quality\n9\t\n10\tPhase 1 supports color-based protection.  The framework is extensible to\n11\tcard-type, subtype, and arbitrary predicate-based protection.\n12\t\"\"\"\n13\t\n14\tfrom __future__ import annotations\n15\t\n16\tfrom dataclasses import dataclass, field\n17\tfrom typing import TYPE_CHECKING, Any, Callable\n18\t\n19\tfrom engine.types import Color, ManaType\n20\t\n21\tif TYPE_CHECKING:\n22\t    pass\n23\t\n24\t\n25\t# ---------------------------------------------------------------------------\n26\t# Colour helpers\n27\t# ---------------------------------------------------------------------------\n28\t\n29\t# Map from ManaType to Color for deriving a card's colours from its mana cost.\n30\t_MANA_TO_COLOR: dict[ManaType, Color] = {\n31\t    ManaType.WHITE: Color.WHITE,\n32\t    ManaType.BLUE: Color.BLUE,\n33\t    ManaType.BLACK: Color.BLACK,\n34\t    ManaType.RED: Color.RED,\n35\t    ManaType.GREEN: Color.GREEN,\n36\t}\n37\t\n38\t\n39\tdef get_colors(obj: Any) -> set[Color]:\n40\t    \"\"\"Return the set of colours of *obj*.\n41\t\n42\t    Colour is determined by:\n43\t    1. An explicit ``colors`` attribute (set or list of :class:`Color`).\n44\t    2. The coloured pips in the object's ``mana_cost``.\n45\t    3. An explicit ``color`` attribute (single :class:`Color`).\n46\t\n47\t    Colourless objects return an empty set.\n48\t    \"\"\"\n49\t    # Explicit colors attribute (takes precedence)\n50\t    if hasattr(obj, \"colors\") and obj.colors is not None:\n51\t        return set(obj.colors)\n52\t\n53\t    # Derive from mana cost pips\n54\t    mana_cost = getattr(obj, \"mana_cost\", None)\n55\t    if mana_cost is not None:\n56\t        pips = getattr(mana_cost, \"pips\", None)\n57\t        if pips:\n58\t            result: set[Color] = set()\n59\t            for mt in pips:\n60\t                if mt in _MANA_TO_COLOR:\n61\t                    result.add(_MANA_TO_COLOR[mt])\n62\t            return result\n63\t\n64\t    # Single color attribute fallback\n65\t    if hasattr(obj, \"color\") and obj.color is not None:\n66\t        return {obj.color}\n67\t\n68\t    return set()\n69\t\n70\t\n71\t# ---------------------------------------------------------------------------\n72\t# ProtectionAbility\n73\t# ---------------------------------------------------------------------------\n74\t\n75\t@dataclass\n76\tclass ProtectionAbility:\n77\t    \"\"\"Represents a 'protection from [quality]' ability.\n78\t\n79\t    The *quality* is typically a :class:`Color`, but the framework supports\n80\t    arbitrary predicates via *predicate*.\n81\t\n82\t    Usage::\n83\t\n84\t        # Colour-based protection\n85\t        pro_red = ProtectionAbility(quality=Color.RED)\n86\t\n87\t        # Custom predicate (e.g. protection from artifacts)\n88\t        pro_artifacts = ProtectionAbility(\n89\t            quality=\"artifacts\",\n90\t            predicate=lambda src: CardType.ARTIFACT in getattr(src, \"card_types\", set()),\n91\t        )\n92\t\n93\t    Attributes:\n94\t        quality: A human-readable label for the quality (often a\n95\t            :class:`Color` enum member).\n96\t        predicate: An optional callable ``(source) -> bool`` that returns\n97\t            ``True`` if *source* has the protected-from quality.  When\n98\t            ``None``, the quality must be a :class:`Color` and the default\n99\t            colour-matching predicate is used.\n100\t    \"\"\"\n101\t\n102\t    quality: Any  # typically Color, but may be str or CardType\n103\t    predicate: Callable[[Any], bool] | None = None\n104\t\n105\t    def matches(self, source: Any) -> bool:\n106\t        \"\"\"Return ``True`` if *source* has the quality this protects from.\"\"\"\n107\t        if self.predicate is not None:\n108\t            return self.predicate(source)\n109\t\n110\t        # Default: colour-based matching\n111\t        if isinstance(self.quality, Color):\n112\t            return self.quality in get_colors(source)\n113\t\n114\t        return False\n115\t\n116\t\n117\t# ---------------------------------------------------------------------------\n118\t# Query helpers — work with any object that has a ``protections`` list\n119\t# ---------------------------------------------------------------------------\n120\t\n121\tdef get_protections(obj: Any) -> list[ProtectionAbility]:\n122\t    \"\"\"Return the list of :class:`ProtectionAbility` on *obj*, or ``[]``.\"\"\"\n123\t    return getattr(obj, \"protections\", [])\n124\t\n125\t\n126\tdef has_protection_from(permanent: Any, source: Any) -> bool:\n127\t    \"\"\"Return ``True`` if *permanent* has protection from *source*.\n128\t\n129\t    Iterates over all :class:`ProtectionAbility` instances on *permanent*\n130\t    and returns ``True`` if any matches *source*.\n131\t    \"\"\"\n132\t    for prot in get_protections(permanent):\n133\t        if prot.matches(source):\n134\t            return True\n135\t    return False\n136\t\n137\t\n138\tdef _is_illegal_target_due_to_protection(target: Any, source: Any) -> bool:\n139\t    \"\"\"Return ``True`` if *target* cannot be targeted by *source* due to protection.\"\"\"\n140\t    return has_protection_from(target, source)\n141\t\n142\t\n143\tdef _is_illegal_block_due_to_protection(attacker: Any, blocker: Any) -> bool:\n144\t    \"\"\"Return ``True`` if *attacker* has protection from *blocker*.\n145\t\n146\t    Protection prevents blocking *by* creatures with that quality —\n147\t    i.e. the attacker is the one with protection, the blocker is checked.\n148\t    \"\"\"\n149\t    return has_protection_from(attacker, blocker)\n150\t\n151\t\n152\tdef _should_prevent_damage(target: Any, source: Any) -> bool:\n153\t    \"\"\"Return ``True`` if damage from *source* to *target* should be prevented.\"\"\"\n154\t    return has_protection_from(target, source)\n155\t\n156\t\n157\tdef _aura_illegal_due_to_protection(aura: Any) -> bool:\n158\t    \"\"\"Return ``True`` if *aura* is illegally attached due to protection.\n159\t\n160\t    An aura is illegal if the enchanted permanent has protection from the\n161\t    aura (checked via the aura's colours / quality).\n162\t    \"\"\"\n163\t    attached = getattr(aura, \"attached_to\", None)\n164\t    if attached is None:\n165\t        return False\n166\t    return has_protection_from(attached, aura)\n167\t"}]},"parent_tool_use_id":null,"session_id":"29d12edd-e81c-4550-a480-8db127b1d09f","uuid":"f6e4dcf7-a1e5-448b-aa31-1564e64b2fdb","timestamp":"2026-06-04T02:24:08.572Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/protection.py","content":"\"\"\"Protection from qualities — keyword ability implementation.\n\nImplements the 'protection from [quality]' keyword per MTG rules.\nProtection prevents (DEBT mnemonic):\n  - **D**amage from sources with that quality\n  - **E**nchanting/equipping by permanents with that quality\n  - **B**locking by creatures with that quality\n  - **T**argeting by spells/abilities from sources with that quality\n\nPhase 1 supports color-based protection.  The framework is extensible to\ncard-type, subtype, and arbitrary predicate-based protection.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom typing import TYPE_CHECKING, Any, Callable\n\nfrom engine.types import Color, ManaType\n\nif TYPE_CHECKING:\n    pass\n\n\n# ---------------------------------------------------------------------------\n# Colour helpers\n# ---------------------------------------------------------------------------\n\n# Map from ManaType to Color for deriving a card's colours from its mana cost.\n_MANA_TO_COLOR: dict[ManaType, Color] = {\n    ManaType.WHITE: Color.WHITE,\n    ManaType.BLUE: Color.BLUE,\n    ManaType.BLACK: Color.BLACK,\n    ManaType.RED: Color.RED,\n    ManaType.GREEN: Color.GREEN,\n}\n\n\ndef get_colors(obj: Any) -> set[Color]:\n    \"\"\"Return the set of colours of *obj*.\n\n    Colour is determined by:\n    1. An explicit ``colors`` attribute (set or list of :class:`Color`).\n    2. The coloured pips in the object's ``mana_cost``.\n    3. An explicit ``color`` attribute (single :class:`Color`).\n\n    Colourless objects return an empty set.\n    \"\"\"\n    # Explicit colors attribute (takes precedence)\n    if hasattr(obj, \"colors\") and obj.colors is not None:\n        return set(obj.colors)\n\n    # Derive from mana cost pips\n    mana_cost = getattr(obj, \"mana_cost\", None)\n    if mana_cost is not None:\n        pips = getattr(mana_cost, \"pips\", None)\n        if pips:\n            result: set[Color] = set()\n            for mt in pips:\n                if mt in _MANA_TO_COLOR:\n                    result.add(_MANA_TO_COLOR[mt])\n            return result\n\n    # Single color attribute fallback\n    if hasattr(obj, \"color\") and obj.color is not None:\n        return {obj.color}\n\n    return set()\n\n\n# ---------------------------------------------------------------------------\n# ProtectionAbility\n# ---------------------------------------------------------------------------\n\n@dataclass\nclass ProtectionAbility:\n    \"\"\"Represents a 'protection from [quality]' ability.\n\n    The *quality* is typically a :class:`Color`, but the framework supports\n    arbitrary predicates via *predicate*.\n\n    Usage::\n\n        # Colour-based protection\n        pro_red = ProtectionAbility(quality=Color.RED)\n\n        # Custom predicate (e.g. protection from artifacts)\n        pro_artifacts = ProtectionAbility(\n            quality=\"artifacts\",\n            predicate=lambda src: CardType.ARTIFACT in getattr(src, \"card_types\", set()),\n        )\n\n    Attributes:\n        quality: A human-readable label for the quality (often a\n            :class:`Color` enum member).\n        predicate: An optional callable ``(source) -> bool`` that returns\n            ``True`` if *source* has the protected-from quality.  When\n            ``None``, the quality must be a :class:`Color` and the default\n            colour-matching predicate is used.\n    \"\"\"\n\n    quality: Any  # typically Color, but may be str or CardType\n    predicate: Callable[[Any], bool] | None = None\n\n    def matches(self, source: Any) -> bool:\n        \"\"\"Return ``True`` if *source* has the quality this protects from.\"\"\"\n        if self.predicate is not None:\n            return self.predicate(source)\n\n        # Default: colour-based matching\n        if isinstance(self.quality, Color):\n            return self.quality in get_colors(source)\n\n        return False\n\n\n# ---------------------------------------------------------------------------\n# Query helpers — work with any object that has a ``protections`` list\n# ---------------------------------------------------------------------------\n\ndef get_protections(obj: Any) -> list[ProtectionAbility]:\n    \"\"\"Return the list of :class:`ProtectionAbility` on *obj*, or ``[]``.\"\"\"\n    return getattr(obj, \"protections\", [])\n\n\ndef has_protection_from(permanent: Any, source: Any) -> bool:\n    \"\"\"Return ``True`` if *permanent* has protection from *source*.\n\n    Iterates over all :class:`ProtectionAbility` instances on *permanent*\n    and returns ``True`` if any matches *source*.\n    \"\"\"\n    for prot in get_protections(permanent):\n        if prot.matches(source):\n            return True\n    return False\n\n\ndef _is_illegal_target_due_to_protection(target: Any, source: Any) -> bool:\n    \"\"\"Return ``True`` if *target* cannot be targeted by *source* due to protection.\"\"\"\n    return has_protection_from(target, source)\n\n\ndef _is_illegal_block_due_to_protection(attacker: Any, blocker: Any) -> bool:\n    \"\"\"Return ``True`` if *attacker* has protection from *blocker*.\n\n    Protection prevents blocking *by* creatures with that quality —\n    i.e. the attacker is the one with protection, the blocker is checked.\n    \"\"\"\n    return has_protection_from(attacker, blocker)\n\n\ndef _should_prevent_damage(target: Any, source: Any) -> bool:\n    \"\"\"Return ``True`` if damage from *source* to *target* should be prevented.\"\"\"\n    return has_protection_from(target, source)\n\n\ndef _aura_illegal_due_to_protection(aura: Any) -> bool:\n    \"\"\"Return ``True`` if *aura* is illegally attached due to protection.\n\n    An aura is illegal if the enchanted permanent has protection from the\n    aura (checked via the aura's colours / quality).\n    \"\"\"\n    attached = getattr(aura, \"attached_to\", None)\n    if attached is None:\n        return False\n    return has_protection_from(attached, aura)\n","numLines":167,"startLine":1,"totalLines":167}}}
