{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VFJZB9Zna3fRjqsaa7K2kY","type":"tool_result","content":"1\t\"\"\"Core enums and type definitions for the SilverquiLLM engine.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport enum\n6\timport re\n7\tfrom dataclasses import dataclass, field\n8\tfrom typing import Any, Callable\n9\t\n10\t\n11\tclass Color(enum.Enum):\n12\t    \"\"\"The five colors of Magic.\"\"\"\n13\t\n14\t    WHITE = \"W\"\n15\t    BLUE = \"U\"\n16\t    BLACK = \"B\"\n17\t    RED = \"R\"\n18\t    GREEN = \"G\"\n19\t\n20\t\n21\t# Single-letter aliases accessible as Color.W, Color.U, etc.\n22\tColor.W = Color.WHITE  # type: ignore[attr-defined]\n23\tColor.U = Color.BLUE  # type: ignore[attr-defined]\n24\tColor.B = Color.BLACK  # type: ignore[attr-defined]\n25\tColor.R = Color.RED  # type: ignore[attr-defined]\n26\tColor.G = Color.GREEN  # type: ignore[attr-defined]\n27\t\n28\t\n29\tclass ManaType(enum.Enum):\n30\t    \"\"\"Mana types including colorless.\"\"\"\n31\t\n32\t    WHITE = \"W\"\n33\t    BLUE = \"U\"\n34\t    BLACK = \"B\"\n35\t    RED = \"R\"\n36\t    GREEN = \"G\"\n37\t    COLORLESS = \"C\"\n38\t\n39\t\n40\tclass Zone(enum.Enum):\n41\t    \"\"\"Game zones.\"\"\"\n42\t\n43\t    BATTLEFIELD = \"battlefield\"\n44\t    HAND = \"hand\"\n45\t    LIBRARY = \"library\"\n46\t    GRAVEYARD = \"graveyard\"\n47\t    EXILE = \"exile\"\n48\t    STACK = \"stack\"\n49\t    COMMAND = \"command\"\n50\t\n51\t\n52\tclass Phase(enum.Enum):\n53\t    \"\"\"Turn phases.\"\"\"\n54\t\n55\t    BEGINNING = \"beginning\"\n56\t    PRECOMBAT_MAIN = \"precombat_main\"\n57\t    COMBAT = \"combat\"\n58\t    POSTCOMBAT_MAIN = \"postcombat_main\"\n59\t    ENDING = \"ending\"\n60\t\n61\t\n62\tclass Step(enum.Enum):\n63\t    \"\"\"Turn steps.\"\"\"\n64\t\n65\t    UNTAP = \"untap\"\n66\t    UPKEEP = \"upkeep\"\n67\t    DRAW = \"draw\"\n68\t    BEGIN_COMBAT = \"begin_combat\"\n69\t    DECLARE_ATTACKERS = \"declare_attackers\"\n70\t    DECLARE_BLOCKERS = \"declare_blockers\"\n71\t    COMBAT_DAMAGE = \"combat_damage\"\n72\t    END_COMBAT = \"end_combat\"\n73\t    END = \"end\"\n74\t    CLEANUP = \"cleanup\"\n75\t\n76\t\n77\tclass CardType(enum.Enum):\n78\t    \"\"\"Card types.\"\"\"\n79\t\n80\t    CREATURE = \"creature\"\n81\t    INSTANT = \"instant\"\n82\t    SORCERY = \"sorcery\"\n83\t    ENCHANTMENT = \"enchantment\"\n84\t    ARTIFACT = \"artifact\"\n85\t    PLANESWALKER = \"planeswalker\"\n86\t    LAND = \"land\"\n87\t\n88\t\n89\tclass Supertype(enum.Enum):\n90\t    \"\"\"Card supertypes.\"\"\"\n91\t\n92\t    BASIC = \"basic\"\n93\t    LEGENDARY = \"legendary\"\n94\t    SNOW = \"snow\"\n95\t\n96\t\n97\tclass Keyword(enum.Flag):\n98\t    \"\"\"Evergreen keyword abilities (combinable via bitwise OR).\"\"\"\n99\t\n100\t    FLYING = enum.auto()\n101\t    FIRST_STRIKE = enum.auto()\n102\t    DOUBLE_STRIKE = enum.auto()\n103\t    DEATHTOUCH = enum.auto()\n104\t    TRAMPLE = enum.auto()\n105\t    LIFELINK = enum.auto()\n106\t    VIGILANCE = enum.auto()\n107\t    REACH = enum.auto()\n108\t    HASTE = enum.auto()\n109\t    FLASH = enum.auto()\n110\t    DEFENDER = enum.auto()\n111\t    HEXPROOF = enum.auto()\n112\t    INDESTRUCTIBLE = enum.auto()\n113\t    MENACE = enum.auto()\n114\t    WARD = enum.auto()\n115\t    PROWESS = enum.auto()\n116\t\n117\t\n118\t# Mapping from pip string to ManaType for parsing\n119\t_PIP_MAP: dict[str, ManaType] = {\n120\t    \"W\": ManaType.WHITE,\n121\t    \"U\": ManaType.BLUE,\n122\t    \"B\": ManaType.BLACK,\n123\t    \"R\": ManaType.RED,\n124\t    \"G\": ManaType.GREEN,\n125\t    \"C\": ManaType.COLORLESS,\n126\t}\n127\t\n128\t# Regex to tokenize a mana cost string like \"{2}{W}{U}\" or \"{X}{X}{R}\"\n129\t_MANA_TOKEN_RE = re.compile(r\"\\{([^}]+)\\}\")\n130\t\n131\t# Regex to detect hybrid mana tokens like \"B/G\", \"W/U\", etc.\n132\t_HYBRID_RE = re.compile(r\"^([WUBRGC])/([WUBRGC])$\")\n133\t\n134\t\n135\t@dataclass(frozen=True)\n136\tclass HybridManaSymbol:\n137\t    \"\"\"A hybrid mana symbol that can be paid with either of two colors.\n138\t\n139\t    For example, ``{B/G}`` is represented as\n140\t    ``HybridManaSymbol(option_a=ManaType.BLACK, option_b=ManaType.GREEN)``.\n141\t    \"\"\"\n142\t\n143\t    option_a: ManaType\n144\t    option_b: ManaType\n145\t\n146\t\n147\t@dataclass(frozen=True)\n148\tclass ManaCost:\n149\t    \"\"\"Represents a mana cost.\n150\t\n151\t    Attributes:\n152\t        generic: The generic (numerical) component of the cost.\n153\t        pips: Mapping of colored/colorless mana pips to their counts.\n154\t        x_count: Number of {X} symbols in the cost.\n155\t        hybrid: List of hybrid mana symbols that can be paid with either option.\n156\t    \"\"\"\n157\t\n158\t    generic: int = 0\n159\t    pips: dict[ManaType, int] = field(default_factory=dict)\n160\t    x_count: int = 0\n161\t    hybrid: list[HybridManaSymbol] = field(default_factory=list)\n162\t\n163\t    @property\n164\t    def cmc(self) -> int:\n165\t        \"\"\"Converted mana cost (total mana value, treating X as 0).\n166\t\n167\t        Each hybrid symbol contributes 1 to the CMC.\n168\t        \"\"\"\n169\t        return self.generic + sum(self.pips.values()) + len(self.hybrid)\n170\t\n171\t    @classmethod\n172\t    def parse(cls, cost_str: str) -> ManaCost:\n173\t        \"\"\"Parse a mana cost string like ``\"{2}{W}{U}\"`` into a ManaCost.\n174\t\n175\t        Supports generic mana (``{N}``), colored pips (``{W}``, ``{U}``, ``{B}``,\n176\t        ``{R}``, ``{G}``), colorless pips (``{C}``), and X costs (``{X}``).\n177\t\n178\t        Raises:\n179\t            ValueError: If *cost_str* is empty, contains no valid tokens, or\n180\t                includes an unrecognised pip symbol.\n181\t        \"\"\"\n182\t        if not cost_str or not cost_str.strip():\n183\t            raise ValueError(f\"Invalid mana cost string: {cost_str!r}\")\n184\t\n185\t        tokens = _MANA_TOKEN_RE.findall(cost_str)\n186\t        if not tokens:\n187\t            raise ValueError(f\"Invalid mana cost string: {cost_str!r}\")\n188\t\n189\t        # Verify that the entire input is consumed by brace tokens (no extra\n190\t        # characters outside braces such as trailing junk or stray spaces).\n191\t        reconstructed = \"\".join(f\"{{{t}}}\" for t in tokens)\n192\t        if reconstructed != cost_str:\n193\t            raise ValueError(f\"Invalid mana cost string: {cost_str!r}\")\n194\t\n195\t        generic = 0\n196\t        pips: dict[ManaType, int] = {}\n197\t        x_count = 0\n198\t        hybrid: list[HybridManaSymbol] = []\n199\t\n200\t        for token in tokens:\n201\t            upper = token.upper()\n202\t            if upper == \"X\":\n203\t                x_count += 1\n204\t            elif upper in _PIP_MAP:\n205\t                mana_type = _PIP_MAP[upper]\n206\t                pips[mana_type] = pips.get(mana_type, 0) + 1\n207\t            else:\n208\t                # Check for hybrid mana like \"B/G\"\n209\t                hybrid_match = _HYBRID_RE.match(upper)\n210\t                if hybrid_match:\n211\t                    a_str, b_str = hybrid_match.group(1), hybrid_match.group(2)\n212\t                    if a_str not in _PIP_MAP or b_str not in _PIP_MAP:\n213\t                        raise ValueError(\n214\t                            f\"Unrecognised mana symbol {token!r} in cost string {cost_str!r}\"\n215\t                        )\n216\t                    hybrid.append(\n217\t                        HybridManaSymbol(\n218\t                            option_a=_PIP_MAP[a_str], option_b=_PIP_MAP[b_str]\n219\t                        )\n220\t                    )\n221\t                else:\n222\t                    # Try to parse as a number (generic mana)\n223\t                    try:\n224\t                        value = int(token)\n225\t                    except ValueError:\n226\t                        raise ValueError(\n227\t                            f\"Unrecognised mana symbol {token!r} in cost string {cost_str!r}\"\n228\t                        ) from None\n229\t                    if value < 0:\n230\t                        raise ValueError(\n231\t                            f\"Negative generic mana {token!r} in cost string {cost_str!r}\"\n232\t                        )\n233\t                    generic += value\n234\t\n235\t        return cls(generic=generic, pips=pips, x_count=x_count, hybrid=hybrid)\n236\t\n237\t\n238\t@dataclass\n239\tclass TargetRequirement:\n240\t    \"\"\"Describes a targeting requirement for a spell or ability.\n241\t\n242\t    Attributes:\n243\t        filter_fn: A callable that accepts a game object and returns True\n244\t            if the object is a legal target.  Filters should evaluate the\n245\t            object's properties at call time (lazy) rather than capturing\n246\t            a snapshot of legal targets when the filter is created.\n247\t        description: Human-readable description of what this targets.\n248\t        zone: The zone in which legal targets must reside.\n249\t    \"\"\"\n250\t\n251\t    filter_fn: Callable[..., Any]\n252\t    description: str\n253\t    zone: Zone\n254\t"}]},"parent_tool_use_id":null,"session_id":"a1b7c704-d004-4a3e-ade9-c0cdca9e5add","uuid":"58dc08df-d6e7-4096-a0cc-026c05ba0d70","timestamp":"2026-06-04T08:42:15.329Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/types.py","content":"\"\"\"Core enums and type definitions for the SilverquiLLM engine.\"\"\"\n\nfrom __future__ import annotations\n\nimport enum\nimport re\nfrom dataclasses import dataclass, field\nfrom typing import Any, Callable\n\n\nclass Color(enum.Enum):\n    \"\"\"The five colors of Magic.\"\"\"\n\n    WHITE = \"W\"\n    BLUE = \"U\"\n    BLACK = \"B\"\n    RED = \"R\"\n    GREEN = \"G\"\n\n\n# Single-letter aliases accessible as Color.W, Color.U, etc.\nColor.W = Color.WHITE  # type: ignore[attr-defined]\nColor.U = Color.BLUE  # type: ignore[attr-defined]\nColor.B = Color.BLACK  # type: ignore[attr-defined]\nColor.R = Color.RED  # type: ignore[attr-defined]\nColor.G = Color.GREEN  # type: ignore[attr-defined]\n\n\nclass ManaType(enum.Enum):\n    \"\"\"Mana types including colorless.\"\"\"\n\n    WHITE = \"W\"\n    BLUE = \"U\"\n    BLACK = \"B\"\n    RED = \"R\"\n    GREEN = \"G\"\n    COLORLESS = \"C\"\n\n\nclass Zone(enum.Enum):\n    \"\"\"Game zones.\"\"\"\n\n    BATTLEFIELD = \"battlefield\"\n    HAND = \"hand\"\n    LIBRARY = \"library\"\n    GRAVEYARD = \"graveyard\"\n    EXILE = \"exile\"\n    STACK = \"stack\"\n    COMMAND = \"command\"\n\n\nclass Phase(enum.Enum):\n    \"\"\"Turn phases.\"\"\"\n\n    BEGINNING = \"beginning\"\n    PRECOMBAT_MAIN = \"precombat_main\"\n    COMBAT = \"combat\"\n    POSTCOMBAT_MAIN = \"postcombat_main\"\n    ENDING = \"ending\"\n\n\nclass Step(enum.Enum):\n    \"\"\"Turn steps.\"\"\"\n\n    UNTAP = \"untap\"\n    UPKEEP = \"upkeep\"\n    DRAW = \"draw\"\n    BEGIN_COMBAT = \"begin_combat\"\n    DECLARE_ATTACKERS = \"declare_attackers\"\n    DECLARE_BLOCKERS = \"declare_blockers\"\n    COMBAT_DAMAGE = \"combat_damage\"\n    END_COMBAT = \"end_combat\"\n    END = \"end\"\n    CLEANUP = \"cleanup\"\n\n\nclass CardType(enum.Enum):\n    \"\"\"Card types.\"\"\"\n\n    CREATURE = \"creature\"\n    INSTANT = \"instant\"\n    SORCERY = \"sorcery\"\n    ENCHANTMENT = \"enchantment\"\n    ARTIFACT = \"artifact\"\n    PLANESWALKER = \"planeswalker\"\n    LAND = \"land\"\n\n\nclass Supertype(enum.Enum):\n    \"\"\"Card supertypes.\"\"\"\n\n    BASIC = \"basic\"\n    LEGENDARY = \"legendary\"\n    SNOW = \"snow\"\n\n\nclass Keyword(enum.Flag):\n    \"\"\"Evergreen keyword abilities (combinable via bitwise OR).\"\"\"\n\n    FLYING = enum.auto()\n    FIRST_STRIKE = enum.auto()\n    DOUBLE_STRIKE = enum.auto()\n    DEATHTOUCH = enum.auto()\n    TRAMPLE = enum.auto()\n    LIFELINK = enum.auto()\n    VIGILANCE = enum.auto()\n    REACH = enum.auto()\n    HASTE = enum.auto()\n    FLASH = enum.auto()\n    DEFENDER = enum.auto()\n    HEXPROOF = enum.auto()\n    INDESTRUCTIBLE = enum.auto()\n    MENACE = enum.auto()\n    WARD = enum.auto()\n    PROWESS = enum.auto()\n\n\n# Mapping from pip string to ManaType for parsing\n_PIP_MAP: dict[str, ManaType] = {\n    \"W\": ManaType.WHITE,\n    \"U\": ManaType.BLUE,\n    \"B\": ManaType.BLACK,\n    \"R\": ManaType.RED,\n    \"G\": ManaType.GREEN,\n    \"C\": ManaType.COLORLESS,\n}\n\n# Regex to tokenize a mana cost string like \"{2}{W}{U}\" or \"{X}{X}{R}\"\n_MANA_TOKEN_RE = re.compile(r\"\\{([^}]+)\\}\")\n\n# Regex to detect hybrid mana tokens like \"B/G\", \"W/U\", etc.\n_HYBRID_RE = re.compile(r\"^([WUBRGC])/([WUBRGC])$\")\n\n\n@dataclass(frozen=True)\nclass HybridManaSymbol:\n    \"\"\"A hybrid mana symbol that can be paid with either of two colors.\n\n    For example, ``{B/G}`` is represented as\n    ``HybridManaSymbol(option_a=ManaType.BLACK, option_b=ManaType.GREEN)``.\n    \"\"\"\n\n    option_a: ManaType\n    option_b: ManaType\n\n\n@dataclass(frozen=True)\nclass ManaCost:\n    \"\"\"Represents a mana cost.\n\n    Attributes:\n        generic: The generic (numerical) component of the cost.\n        pips: Mapping of colored/colorless mana pips to their counts.\n        x_count: Number of {X} symbols in the cost.\n        hybrid: List of hybrid mana symbols that can be paid with either option.\n    \"\"\"\n\n    generic: int = 0\n    pips: dict[ManaType, int] = field(default_factory=dict)\n    x_count: int = 0\n    hybrid: list[HybridManaSymbol] = field(default_factory=list)\n\n    @property\n    def cmc(self) -> int:\n        \"\"\"Converted mana cost (total mana value, treating X as 0).\n\n        Each hybrid symbol contributes 1 to the CMC.\n        \"\"\"\n        return self.generic + sum(self.pips.values()) + len(self.hybrid)\n\n    @classmethod\n    def parse(cls, cost_str: str) -> ManaCost:\n        \"\"\"Parse a mana cost string like ``\"{2}{W}{U}\"`` into a ManaCost.\n\n        Supports generic mana (``{N}``), colored pips (``{W}``, ``{U}``, ``{B}``,\n        ``{R}``, ``{G}``), colorless pips (``{C}``), and X costs (``{X}``).\n\n        Raises:\n            ValueError: If *cost_str* is empty, contains no valid tokens, or\n                includes an unrecognised pip symbol.\n        \"\"\"\n        if not cost_str or not cost_str.strip():\n            raise ValueError(f\"Invalid mana cost string: {cost_str!r}\")\n\n        tokens = _MANA_TOKEN_RE.findall(cost_str)\n        if not tokens:\n            raise ValueError(f\"Invalid mana cost string: {cost_str!r}\")\n\n        # Verify that the entire input is consumed by brace tokens (no extra\n        # characters outside braces such as trailing junk or stray spaces).\n        reconstructed = \"\".join(f\"{{{t}}}\" for t in tokens)\n        if reconstructed != cost_str:\n            raise ValueError(f\"Invalid mana cost string: {cost_str!r}\")\n\n        generic = 0\n        pips: dict[ManaType, int] = {}\n        x_count = 0\n        hybrid: list[HybridManaSymbol] = []\n\n        for token in tokens:\n            upper = token.upper()\n            if upper == \"X\":\n                x_count += 1\n            elif upper in _PIP_MAP:\n                mana_type = _PIP_MAP[upper]\n                pips[mana_type] = pips.get(mana_type, 0) + 1\n            else:\n                # Check for hybrid mana like \"B/G\"\n                hybrid_match = _HYBRID_RE.match(upper)\n                if hybrid_match:\n                    a_str, b_str = hybrid_match.group(1), hybrid_match.group(2)\n                    if a_str not in _PIP_MAP or b_str not in _PIP_MAP:\n                        raise ValueError(\n                            f\"Unrecognised mana symbol {token!r} in cost string {cost_str!r}\"\n                        )\n                    hybrid.append(\n                        HybridManaSymbol(\n                            option_a=_PIP_MAP[a_str], option_b=_PIP_MAP[b_str]\n                        )\n                    )\n                else:\n                    # Try to parse as a number (generic mana)\n                    try:\n                        value = int(token)\n                    except ValueError:\n                        raise ValueError(\n                            f\"Unrecognised mana symbol {token!r} in cost string {cost_str!r}\"\n                        ) from None\n                    if value < 0:\n                        raise ValueError(\n                            f\"Negative generic mana {token!r} in cost string {cost_str!r}\"\n                        )\n                    generic += value\n\n        return cls(generic=generic, pips=pips, x_count=x_count, hybrid=hybrid)\n\n\n@dataclass\nclass TargetRequirement:\n    \"\"\"Describes a targeting requirement for a spell or ability.\n\n    Attributes:\n        filter_fn: A callable that accepts a game object and returns True\n            if the object is a legal target.  Filters should evaluate the\n            object's properties at call time (lazy) rather than capturing\n            a snapshot of legal targets when the filter is created.\n        description: Human-readable description of what this targets.\n        zone: The zone in which legal targets must reside.\n    \"\"\"\n\n    filter_fn: Callable[..., Any]\n    description: str\n    zone: Zone\n","numLines":254,"startLine":1,"totalLines":254}}}
