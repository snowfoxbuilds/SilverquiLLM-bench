{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PsSBowcwrr9BPzHZ7ASeF7","type":"tool_result","content":"1\t\"\"\"Player interface and deterministic test player implementation.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom abc import ABC, abstractmethod\n6\tfrom collections import deque\n7\tfrom typing import Any\n8\t\n9\tfrom engine.mana import ManaPool\n10\tfrom engine.zones import Zones\n11\t\n12\t\n13\tclass ScriptExhaustedError(Exception):\n14\t    \"\"\"Raised when a DeterministicPlayer's script runs out of predetermined answers.\"\"\"\n15\t\n16\t\n17\tclass Player(ABC):\n18\t    \"\"\"Abstract base class for all players in the game.\n19\t\n20\t    Attributes:\n21\t        name: The player's display name.\n22\t        life: Current life total (default 20).\n23\t        zones: Per-player zone containers.\n24\t        mana_pool: The player's mana pool (forward ref; initialized to None until ManaPool is implemented).\n25\t        has_lost: Whether this player has lost the game.\n26\t        land_plays_remaining: Number of land plays remaining this turn.\n27\t        drawn_from_empty_library: Whether this player attempted to draw from an empty library.\n28\t    \"\"\"\n29\t\n30\t    def __init__(self, name: str, life: int = 20) -> None:\n31\t        self.name: str = name\n32\t        self.life: int = life\n33\t        self.zones: Zones = Zones.new_player()\n34\t        self.mana_pool: ManaPool = ManaPool()\n35\t        self.has_lost: bool = False\n36\t        self.land_plays_remaining: int = 1\n37\t        self.drawn_from_empty_library: bool = False\n38\t\n39\t    @abstractmethod\n40\t    def choose_target(self, options: Any, requirement: Any) -> Any:\n41\t        \"\"\"Choose a target from the available options given a requirement.\n42\t\n43\t        Parameters:\n44\t            options: The available targets to choose from.\n45\t            requirement: The targeting requirement to satisfy.\n46\t\n47\t        Returns:\n48\t            The chosen target.\n49\t        \"\"\"\n50\t\n51\t    @abstractmethod\n52\t    def choose(self, options: Any, description: str) -> Any:\n53\t        \"\"\"Choose from a list of options.\n54\t\n55\t        Parameters:\n56\t            options: The available choices.\n57\t            description: Human-readable description of the choice.\n58\t\n59\t        Returns:\n60\t            The chosen option.\n61\t        \"\"\"\n62\t\n63\t    @abstractmethod\n64\t    def choose_yes_no(self, prompt: str) -> bool:\n65\t        \"\"\"Make a yes/no decision.\n66\t\n67\t        Parameters:\n68\t            prompt: Human-readable prompt for the decision.\n69\t\n70\t        Returns:\n71\t            True for yes, False for no.\n72\t        \"\"\"\n73\t\n74\t    @abstractmethod\n75\t    def assign_damage_order(self, attackers_or_blockers: Any) -> list[Any]:\n76\t        \"\"\"Assign a damage ordering to attackers or blockers.\n77\t\n78\t        Parameters:\n79\t            attackers_or_blockers: The creatures to order.\n80\t\n81\t        Returns:\n82\t            An ordered list representing the damage assignment order.\n83\t        \"\"\"\n84\t\n85\t    @abstractmethod\n86\t    def choose_card(self, cards: Any, description: str) -> Any:\n87\t        \"\"\"Choose a card from a collection.\n88\t\n89\t        Parameters:\n90\t            cards: The available cards to choose from.\n91\t            description: Human-readable description of why a card is being chosen.\n92\t\n93\t        Returns:\n94\t            The chosen card.\n95\t        \"\"\"\n96\t\n97\t\n98\tclass DeterministicPlayer(Player):\n99\t    \"\"\"A scripted player for testing that returns predetermined answers.\n100\t\n101\t    Each abstract method call pops the next answer from the front of the\n102\t    script queue. Raises :class:`ScriptExhaustedError` if the script is empty\n103\t    when a choice is requested.\n104\t    \"\"\"\n105\t\n106\t    def __init__(self, name: str, script: list[Any], life: int = 20) -> None:\n107\t        super().__init__(name, life)\n108\t        self._script: deque[Any] = deque(script)\n109\t\n110\t    def _pop(self) -> Any:\n111\t        \"\"\"Pop the next scripted answer from the queue.\n112\t\n113\t        Raises:\n114\t            ScriptExhaustedError: If the script has no remaining answers.\n115\t        \"\"\"\n116\t        if not self._script:\n117\t            raise ScriptExhaustedError(\n118\t                f\"Player {self.name!r} script exhausted — no more predetermined answers\"\n119\t            )\n120\t        return self._script.popleft()\n121\t\n122\t    @property\n123\t    def remaining_choices(self) -> int:\n124\t        \"\"\"Return the number of scripted answers remaining.\"\"\"\n125\t        return len(self._script)\n126\t\n127\t    def choose_target(self, options: Any, requirement: Any) -> Any:\n128\t        \"\"\"Return the next scripted target choice.\"\"\"\n129\t        return self._pop()\n130\t\n131\t    def choose(self, options: Any, description: str) -> Any:\n132\t        \"\"\"Return the next scripted choice.\"\"\"\n133\t        return self._pop()\n134\t\n135\t    def choose_yes_no(self, prompt: str) -> bool:\n136\t        \"\"\"Return the next scripted yes/no decision.\"\"\"\n137\t        return self._pop()\n138\t\n139\t    def assign_damage_order(self, attackers_or_blockers: Any) -> list[Any]:\n140\t        \"\"\"Return the next scripted damage ordering.\"\"\"\n141\t        return self._pop()\n142\t\n143\t    def choose_card(self, cards: Any, description: str) -> Any:\n144\t        \"\"\"Return the next scripted card choice.\"\"\"\n145\t        return self._pop()\n146\t"}]},"parent_tool_use_id":null,"session_id":"a1b7c704-d004-4a3e-ade9-c0cdca9e5add","uuid":"94f7fc13-01e6-44bf-89e9-15ee66e0e161","timestamp":"2026-06-04T08:42:28.901Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/player.py","content":"\"\"\"Player interface and deterministic test player implementation.\"\"\"\n\nfrom __future__ import annotations\n\nfrom abc import ABC, abstractmethod\nfrom collections import deque\nfrom typing import Any\n\nfrom engine.mana import ManaPool\nfrom engine.zones import Zones\n\n\nclass ScriptExhaustedError(Exception):\n    \"\"\"Raised when a DeterministicPlayer's script runs out of predetermined answers.\"\"\"\n\n\nclass Player(ABC):\n    \"\"\"Abstract base class for all players in the game.\n\n    Attributes:\n        name: The player's display name.\n        life: Current life total (default 20).\n        zones: Per-player zone containers.\n        mana_pool: The player's mana pool (forward ref; initialized to None until ManaPool is implemented).\n        has_lost: Whether this player has lost the game.\n        land_plays_remaining: Number of land plays remaining this turn.\n        drawn_from_empty_library: Whether this player attempted to draw from an empty library.\n    \"\"\"\n\n    def __init__(self, name: str, life: int = 20) -> None:\n        self.name: str = name\n        self.life: int = life\n        self.zones: Zones = Zones.new_player()\n        self.mana_pool: ManaPool = ManaPool()\n        self.has_lost: bool = False\n        self.land_plays_remaining: int = 1\n        self.drawn_from_empty_library: bool = False\n\n    @abstractmethod\n    def choose_target(self, options: Any, requirement: Any) -> Any:\n        \"\"\"Choose a target from the available options given a requirement.\n\n        Parameters:\n            options: The available targets to choose from.\n            requirement: The targeting requirement to satisfy.\n\n        Returns:\n            The chosen target.\n        \"\"\"\n\n    @abstractmethod\n    def choose(self, options: Any, description: str) -> Any:\n        \"\"\"Choose from a list of options.\n\n        Parameters:\n            options: The available choices.\n            description: Human-readable description of the choice.\n\n        Returns:\n            The chosen option.\n        \"\"\"\n\n    @abstractmethod\n    def choose_yes_no(self, prompt: str) -> bool:\n        \"\"\"Make a yes/no decision.\n\n        Parameters:\n            prompt: Human-readable prompt for the decision.\n\n        Returns:\n            True for yes, False for no.\n        \"\"\"\n\n    @abstractmethod\n    def assign_damage_order(self, attackers_or_blockers: Any) -> list[Any]:\n        \"\"\"Assign a damage ordering to attackers or blockers.\n\n        Parameters:\n            attackers_or_blockers: The creatures to order.\n\n        Returns:\n            An ordered list representing the damage assignment order.\n        \"\"\"\n\n    @abstractmethod\n    def choose_card(self, cards: Any, description: str) -> Any:\n        \"\"\"Choose a card from a collection.\n\n        Parameters:\n            cards: The available cards to choose from.\n            description: Human-readable description of why a card is being chosen.\n\n        Returns:\n            The chosen card.\n        \"\"\"\n\n\nclass DeterministicPlayer(Player):\n    \"\"\"A scripted player for testing that returns predetermined answers.\n\n    Each abstract method call pops the next answer from the front of the\n    script queue. Raises :class:`ScriptExhaustedError` if the script is empty\n    when a choice is requested.\n    \"\"\"\n\n    def __init__(self, name: str, script: list[Any], life: int = 20) -> None:\n        super().__init__(name, life)\n        self._script: deque[Any] = deque(script)\n\n    def _pop(self) -> Any:\n        \"\"\"Pop the next scripted answer from the queue.\n\n        Raises:\n            ScriptExhaustedError: If the script has no remaining answers.\n        \"\"\"\n        if not self._script:\n            raise ScriptExhaustedError(\n                f\"Player {self.name!r} script exhausted — no more predetermined answers\"\n            )\n        return self._script.popleft()\n\n    @property\n    def remaining_choices(self) -> int:\n        \"\"\"Return the number of scripted answers remaining.\"\"\"\n        return len(self._script)\n\n    def choose_target(self, options: Any, requirement: Any) -> Any:\n        \"\"\"Return the next scripted target choice.\"\"\"\n        return self._pop()\n\n    def choose(self, options: Any, description: str) -> Any:\n        \"\"\"Return the next scripted choice.\"\"\"\n        return self._pop()\n\n    def choose_yes_no(self, prompt: str) -> bool:\n        \"\"\"Return the next scripted yes/no decision.\"\"\"\n        return self._pop()\n\n    def assign_damage_order(self, attackers_or_blockers: Any) -> list[Any]:\n        \"\"\"Return the next scripted damage ordering.\"\"\"\n        return self._pop()\n\n    def choose_card(self, cards: Any, description: str) -> Any:\n        \"\"\"Return the next scripted card choice.\"\"\"\n        return self._pop()\n","numLines":146,"startLine":1,"totalLines":146}}}
