{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01S4L2MQmBNuSjNeoLMPkX8j","type":"tool_result","content":"1\t\"\"\"Test utility helpers for engine validation and benchmark agents.\n2\t\n3\tProvides convenience functions for setting up game states, casting spells,\n4\tadvancing phases, and managing combat in tests.  Each function raises\n5\tdescriptive errors on failure.\n6\t\n7\tFunctions:\n8\t    create_game — convenience wrapper to create a GameState from card lists.\n9\t    set_board_state — directly set zone contents and player state.\n10\t    cast_spell — find card in hand by name, cast, and resolve.\n11\t    advance_to_phase — fast-forward game state to a given phase/step.\n12\t    declare_attackers — advance to combat and declare attackers by name.\n13\t    declare_blockers — assign blockers by name mapping.\n14\t\"\"\"\n15\t\n16\tfrom __future__ import annotations\n17\t\n18\tfrom typing import Any\n19\t\n20\tfrom engine.card import CardImpl, Creature\n21\tfrom engine.casting import cast_spell as _engine_cast_spell\n22\tfrom engine.combat import (\n23\t    CombatState,\n24\t    declare_attackers_step,\n25\t    declare_blockers_step,\n26\t)\n27\tfrom engine.game import create_game as _engine_create_game\n28\tfrom engine.game_state import GameState, _TURN_SEQUENCE\n29\tfrom engine.mana import ManaPool\n30\tfrom engine.player import DeterministicPlayer\n31\tfrom engine.stack import priority_loop\n32\tfrom engine.types import ManaType, Phase, Step, Zone\n33\t\n34\t\n35\tclass TestSetupError(Exception):\n36\t    \"\"\"Raised when a test utility function encounters an invalid setup.\"\"\"\n37\t\n38\t\n39\tdef card_colors(card: Any) -> set[str]:\n40\t    \"\"\"Return a card's colors as single-letter strings, derived from its mana cost.\n41\t\n42\t    Hybrid pips contribute both options. {C} and {X} contribute nothing.\n43\t    Returns an empty set for cards with no mana cost or only colorless/X pips.\n44\t    Used by audited tests that previously asserted against a non-existent\n45\t    ``card.colors`` attribute.\n46\t    \"\"\"\n47\t    colors: set[str] = set()\n48\t    cost = getattr(card, \"mana_cost\", None)\n49\t    if cost is None:\n50\t        return colors\n51\t    for mt in getattr(cost, \"pips\", {}):\n52\t        if mt != ManaType.COLORLESS:\n53\t            colors.add(mt.value)\n54\t    for hybrid in getattr(cost, \"hybrid\", []):\n55\t        if hybrid.option_a != ManaType.COLORLESS:\n56\t            colors.add(hybrid.option_a.value)\n57\t        if hybrid.option_b != ManaType.COLORLESS:\n58\t            colors.add(hybrid.option_b.value)\n59\t    return colors\n60\t\n61\t\n62\t# ---------------------------------------------------------------------------\n63\t# create_game\n64\t# ---------------------------------------------------------------------------\n65\t\n66\t\n67\tdef create_game(\n68\t    deck1: list[CardImpl] | None = None,\n69\t    deck2: list[CardImpl] | None = None,\n70\t    *,\n71\t    player1_name: str = \"Player1\",\n72\t    player2_name: str = \"Player2\",\n73\t    player1_life: int = 20,\n74\t    player2_life: int = 20,\n75\t    scripts: tuple[list[Any], list[Any]] | None = None,\n76\t) -> GameState:\n77\t    \"\"\"Create a new two-player game from card lists.\n78\t\n79\t    This is a convenience wrapper around :func:`engine.game.create_game`\n80\t    that automatically creates :class:`DeterministicPlayer` instances.\n81\t\n82\t    Parameters:\n83\t        deck1: Cards for player 1's deck.  Defaults to empty list.\n84\t        deck2: Cards for player 2's deck.  Defaults to empty list.\n85\t        player1_name: Display name for player 1.\n86\t        player2_name: Display name for player 2.\n87\t        player1_life: Starting life for player 1.\n88\t        player2_life: Starting life for player 2.\n89\t        scripts: Optional tuple of ``(script1, script2)`` for\n90\t            :class:`DeterministicPlayer`.  Defaults to empty lists.\n91\t\n92\t    Returns:\n93\t        A fully initialised :class:`GameState`.\n94\t\n95\t    Raises:\n96\t        TestSetupError: If the inputs are invalid.\n97\t    \"\"\"\n98\t    if deck1 is None:\n99\t        deck1 = []\n100\t    if deck2 is None:\n101\t        deck2 = []\n102\t\n103\t    script1: list[Any] = []\n104\t    script2: list[Any] = []\n105\t    if scripts is not None:\n106\t        script1, script2 = scripts\n107\t\n108\t    p1 = DeterministicPlayer(player1_name, script=script1, life=player1_life)\n109\t    p2 = DeterministicPlayer(player2_name, script=script2, life=player2_life)\n110\t\n111\t    game = _engine_create_game(p1, p2, deck1, deck2)\n112\t\n113\t    # When decks are empty (the convenience default), engine.game.create_game\n114\t    # attempts to draw 7 cards from each empty library, which sets the\n115\t    # drawn_from_empty_library loss flag.  Reset it for the convenience case.\n116\t    for player in game.players:\n117\t        if player.drawn_from_empty_library:\n118\t            player.drawn_from_empty_library = False\n119\t\n120\t    # engine.game.create_game hardcodes life=20; restore custom values.\n121\t    if player1_life != 20:\n122\t        game.players[0].life = player1_life\n123\t    if player2_life != 20:\n124\t        game.players[1].life = player2_life\n125\t\n126\t    return game\n127\t\n128\t\n129\t# ---------------------------------------------------------------------------\n130\t# set_board_state\n131\t# ---------------------------------------------------------------------------\n132\t\n133\t\n134\tdef set_board_state(\n135\t    game: GameState,\n136\t    player_index: int,\n137\t    *,\n138\t    battlefield: list[Any] | None = None,\n139\t    hand: list[Any] | None = None,\n140\t    graveyard: list[Any] | None = None,\n141\t    life: int | None = None,\n142\t    mana: dict[ManaType, int] | None = None,\n143\t) -> None:\n144\t    \"\"\"Directly set zone contents and player state for test setup.\n145\t\n146\t    Replaces the contents of the specified zones (only zones that are\n147\t    explicitly provided are modified — others are left unchanged).\n148\t\n149\t    For each card placed into a zone, ``owner`` and ``controller`` are\n150\t    set to the target player.\n151\t\n152\t    Parameters:\n153\t        game: The game state to modify.\n154\t        player_index: Index of the player (0 or 1).\n155\t        battlefield: Cards/permanents to place on the battlefield.\n156\t        hand: Cards to place in hand.\n157\t        graveyard: Cards to place in graveyard.\n158\t        life: Life total to set (or ``None`` to leave unchanged).\n159\t        mana: Mana to add to the player's pool.  Keys are\n160\t            :class:`ManaType`, values are amounts.\n161\t\n162\t    Raises:\n163\t        TestSetupError: If ``player_index`` is out of range.\n164\t    \"\"\"\n165\t    if player_index < 0 or player_index >= len(game.players):\n166\t        raise TestSetupError(\n167\t            f\"Invalid player_index {player_index} — game has \"\n168\t            f\"{len(game.players)} players (indices 0–{len(game.players) - 1})\"\n169\t        )\n170\t\n171\t    player = game.players[player_index]\n172\t\n173\t    if life is not None:\n174\t        player.life = life\n175\t\n176\t    if mana is not None:\n177\t        player.mana_pool.empty()\n178\t        for mana_type, amount in mana.items():\n179\t            player.mana_pool.add(mana_type, amount)\n180\t\n181\t    if battlefield is not None:\n182\t        _set_zone(game, player, Zone.BATTLEFIELD, battlefield)\n183\t\n184\t    if hand is not None:\n185\t        _set_zone(game, player, Zone.HAND, hand)\n186\t\n187\t    if graveyard is not None:\n188\t        _set_zone(game, player, Zone.GRAVEYARD, graveyard)\n189\t\n190\t\n191\tdef _set_zone(\n192\t    game: GameState,\n193\t    player: Any,\n194\t    zone: Zone,\n195\t    cards: list[Any],\n196\t) -> None:\n197\t    \"\"\"Replace a zone's contents with *cards*, assigning ownership.\"\"\"\n198\t    zone_container = player.zones[zone]\n199\t    # Clear existing contents\n200\t    for obj in zone_container.get_all():\n201\t        zone_container.remove(obj)\n202\t\n203\t    # Add new contents\n204\t    for card in cards:\n205\t        card.owner = player\n206\t        card.controller = player\n207\t        zone_container.add(card)\n208\t\n209\t\n210\t# ---------------------------------------------------------------------------\n211\t# cast_spell\n212\t# ---------------------------------------------------------------------------\n213\t\n214\t\n215\tdef cast_spell(\n216\t    game: GameState,\n217\t    player_index: int,\n218\t    card_name: str,\n219\t    targets: list[Any] | None = None,\n220\t) -> None:\n221\t    \"\"\"Find a card in hand by name, cast it, and pass priority until resolved.\n222\t\n223\t    The function:\n224\t    1. Locates the first card matching *card_name* in the player's hand.\n225\t    2. Sets up the game phase/priority for sorcery-speed casting if needed.\n226\t    3. Calls :func:`engine.casting.cast_spell`.\n227\t    4. Passes priority for both players so the spell resolves.\n228\t\n229\t    Parameters:\n230\t        game: The game state.\n231\t        player_index: Index of the casting player (0 or 1).\n232\t        card_name: Name of the card to find in hand.\n233\t        targets: Optional target list.  If provided, they are scripted\n234\t            into the player's DeterministicPlayer choices.\n235\t\n236\t    Raises:\n237\t        TestSetupError: If the card is not found in hand or casting fails.\n238\t    \"\"\"\n239\t    if player_index < 0 or player_index >= len(game.players):\n240\t        raise TestSetupError(\n241\t            f\"Invalid player_index {player_index} — game has \"\n242\t            f\"{len(game.players)} players\"\n243\t        )\n244\t\n245\t    player = game.players[player_index]\n246\t    hand = game.get_hand(player)\n247\t\n248\t    # Find the card by name\n249\t    card = None\n250\t    for obj in hand.get_all():\n251\t        if getattr(obj, \"name\", None) == card_name:\n252\t            card = obj\n253\t            break\n254\t\n255\t    if card is None:\n256\t        hand_names = [getattr(c, \"name\", repr(c)) for c in hand.get_all()]\n257\t        raise TestSetupError(\n258\t            f\"Card {card_name!r} not found in player {player_index}'s hand. \"\n259\t            f\"Hand contains: {hand_names}\"\n260\t        )\n261\t\n262\t    # Ensure sorcery-speed timing for non-instant spells\n263\t    from engine.types import CardType, Keyword\n264\t\n265\t    is_instant = CardType.INSTANT in getattr(card, \"card_types\", set())\n266\t    has_flash = Keyword.FLASH in getattr(card, \"keywords\", Keyword(0))\n267\t\n268\t    if not is_instant and not has_flash:\n269\t        # Set up sorcery-speed timing: active player, main phase, empty stack\n270\t        game.active_player_index = player_index\n271\t        game.priority_player_index = player_index\n272\t        if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n273\t            game.phase = Phase.PRECOMBAT_MAIN\n274\t            game.step = None\n275\t\n276\t    # Ensure the stack is empty for sorcery-speed\n277\t    if not game.stack.is_empty():\n278\t        raise TestSetupError(\n279\t            f\"Cannot cast {card_name!r} — stack is not empty\"\n280\t        )\n281\t\n282\t    # Script targets into the player's DeterministicPlayer choices so that\n283\t    # engine.casting.cast_spell -> player.choose_target() returns them.\n284\t    if targets and isinstance(player, DeterministicPlayer):\n285\t        for target in reversed(targets):\n286\t            player._script.appendleft(target)\n287\t\n288\t    try:\n289\t        _engine_cast_spell(game, player, card)\n290\t    except Exception as exc:\n291\t        raise TestSetupError(\n292\t            f\"Failed to cast {card_name!r}: {exc}\"\n293\t        ) from exc\n294\t\n295\t    # Pass priority for both players to resolve the spell\n296\t    _resolve_top_of_stack(game)\n297\t\n298\t\n299\tdef _resolve_top_of_stack(game: GameState) -> None:\n300\t    \"\"\"Resolve the top spell/ability on the stack by passing priority.\n301\t\n302\t    Both players pass priority so the top of the stack resolves.\n303\t    Repeats until the stack is empty.\n304\t    \"\"\"\n305\t    from engine.state_based_actions import resolve_state_based_actions\n306\t\n307\t    while not game.stack.is_empty():\n308\t        obj = game.stack.pop()\n309\t        obj.on_resolve(game)\n310\t        resolve_state_based_actions(game)\n311\t\n312\t\n313\t# ---------------------------------------------------------------------------\n314\t# advance_to_phase\n315\t# ---------------------------------------------------------------------------\n316\t\n317\t\n318\tdef advance_to_phase(\n319\t    game: GameState,\n320\t    phase: Phase,\n321\t    step: Step | None = None,\n322\t) -> None:\n323\t    \"\"\"Fast-forward the game state to the specified phase/step.\n324\t\n325\t    Advances by calling :meth:`GameState.advance_phase` until the target\n326\t    phase (and optionally step) is reached.  Priority is not granted during\n327\t    fast-forwarding — this is a direct state manipulation for test setup.\n328\t\n329\t    Parameters:\n330\t        game: The game state to advance.\n331\t        phase: The target phase.\n332\t        step: The target step (or ``None`` for main phases).\n333\t\n334\t    Raises:\n335\t        TestSetupError: If the target phase/step is not found within\n336\t            a full turn cycle (prevents infinite loops).\n337\t    \"\"\"\n338\t    target = (phase, step)\n339\t\n340\t    # Validate that (phase, step) is a valid combination\n341\t    valid_targets = {(p, s) for p, s in _TURN_SEQUENCE}\n342\t    if target not in valid_targets:\n343\t        raise TestSetupError(\n344\t            f\"Invalid phase/step combination: ({phase!r}, {step!r}). \"\n345\t            f\"Valid combinations: {sorted(valid_targets, key=lambda x: str(x))}\"\n346\t        )\n347\t\n348\t    # Already there?\n349\t    if (game.phase, game.step) == target:\n350\t        return\n351\t\n352\t    # Advance up to a full turn's worth of steps to prevent infinite loops\n353\t    max_advances = len(_TURN_SEQUENCE) + 1\n354\t    for _ in range(max_advances):\n355\t        game.advance_phase()\n356\t        if (game.phase, game.step) == target:\n357\t            return\n358\t\n359\t    raise TestSetupError(\n360\t        f\"Could not reach phase/step ({phase!r}, {step!r}) within \"\n361\t        f\"a full turn cycle. Current: ({game.phase!r}, {game.step!r})\"\n362\t    )\n363\t\n364\t\n365\t# ---------------------------------------------------------------------------\n366\t# declare_attackers\n367\t# ---------------------------------------------------------------------------\n368\t\n369\t\n370\tdef declare_attackers(\n371\t    game: GameState,\n372\t    attacker_names: list[str],\n373\t) -> None:\n374\t    \"\"\"Advance to combat and declare attackers by name.\n375\t\n376\t    1. Advances to the Declare Attackers step if not already there.\n377\t    2. Finds creatures on the active player's battlefield matching the\n378\t       given names.\n379\t    3. Scripts the active player's ``choose`` method to return those\n380\t       creatures.\n381\t    4. Calls :func:`engine.combat.declare_attackers_step`.\n382\t\n383\t    Parameters:\n384\t        game: The game state.\n385\t        attacker_names: Names of creatures to declare as attackers.\n386\t\n387\t    Raises:\n388\t        TestSetupError: If any named creature is not found on the\n389\t            active player's battlefield, or if the creature cannot attack.\n390\t    \"\"\"\n391\t    # Advance to declare attackers step\n392\t    if (game.phase, game.step) != (Phase.COMBAT, Step.DECLARE_ATTACKERS):\n393\t        advance_to_phase(game, Phase.COMBAT, Step.DECLARE_ATTACKERS)\n394\t\n395\t    active = game.active_player\n396\t    bf = game.get_battlefield(active)\n397\t\n398\t    # Resolve attacker names to objects\n399\t    attackers: list[Any] = []\n400\t    bf_objects = bf.get_all()\n401\t    for name in attacker_names:\n402\t        found = None\n403\t        for obj in bf_objects:\n404\t            if getattr(obj, \"name\", None) == name and obj not in attackers:\n405\t                found = obj\n406\t                break\n407\t        if found is None:\n408\t            bf_names = [getattr(c, \"name\", repr(c)) for c in bf_objects]\n409\t            raise TestSetupError(\n410\t                f\"Attacker {name!r} not found on active player's battlefield. \"\n411\t                f\"Battlefield contains: {bf_names}\"\n412\t            )\n413\t        attackers.append(found)\n414\t\n415\t    # Script the active player to choose these attackers\n416\t    if isinstance(active, DeterministicPlayer):\n417\t        active._script.appendleft(attackers)\n418\t    else:\n419\t        raise TestSetupError(\n420\t            \"declare_attackers requires active player to be a DeterministicPlayer\"\n421\t        )\n422\t\n423\t    game.combat_state.in_combat = True\n424\t    declare_attackers_step(game)\n425\t\n426\t\n427\t# ---------------------------------------------------------------------------\n428\t# declare_blockers\n429\t# ---------------------------------------------------------------------------\n430\t\n431\t\n432\tdef declare_blockers(\n433\t    game: GameState,\n434\t    assignments: dict[str, list[str]],\n435\t) -> None:\n436\t    \"\"\"Assign blockers by name mapping.\n437\t\n438\t    Parameters:\n439\t        game: The game state.\n440\t        assignments: A mapping of ``{\"attacker_name\": [\"blocker_name\", ...]}``.\n441\t            Each attacker on the active player's battlefield is matched by\n442\t            name, and each blocker on the defending player's battlefield is\n443\t            matched by name.\n444\t\n445\t    Raises:\n446\t        TestSetupError: If any named creature is not found.\n447\t    \"\"\"\n448\t    if (game.phase, game.step) != (Phase.COMBAT, Step.DECLARE_BLOCKERS):\n449\t        advance_to_phase(game, Phase.COMBAT, Step.DECLARE_BLOCKERS)\n450\t\n451\t    active = game.active_player\n452\t    defending = game.non_active_player\n453\t\n454\t    active_bf = game.get_battlefield(active)\n455\t    defending_bf = game.get_battlefield(defending)\n456\t\n457\t    active_objects = active_bf.get_all()\n458\t    defending_objects = defending_bf.get_all()\n459\t\n460\t    # Build mapping of blocker_obj → attacker_obj\n461\t    block_map: dict[Any, Any] = {}\n462\t\n463\t    for attacker_name, blocker_names in assignments.items():\n464\t        # Find attacker\n465\t        attacker = None\n466\t        for obj in active_objects:\n467\t            if getattr(obj, \"name\", None) == attacker_name:\n468\t                attacker = obj\n469\t                break\n470\t        if attacker is None:\n471\t            raise TestSetupError(\n472\t                f\"Attacker {attacker_name!r} not found on active player's battlefield. \"\n473\t                f\"Available: {[getattr(c, 'name', repr(c)) for c in active_objects]}\"\n474\t            )\n475\t\n476\t        for blocker_name in blocker_names:\n477\t            blocker = None\n478\t            for obj in defending_objects:\n479\t                if getattr(obj, \"name\", None) == blocker_name and obj not in block_map:\n480\t                    blocker = obj\n481\t                    break\n482\t            if blocker is None:\n483\t                raise TestSetupError(\n484\t                    f\"Blocker {blocker_name!r} not found on defending player's battlefield. \"\n485\t                    f\"Available: {[getattr(c, 'name', repr(c)) for c in defending_objects]}\"\n486\t                )\n487\t            block_map[blocker] = attacker\n488\t\n489\t    # Script the defending player to choose these block assignments\n490\t    if isinstance(defending, DeterministicPlayer):\n491\t        defending._script.appendleft(block_map)\n492\t    else:\n493\t        raise TestSetupError(\n494\t            \"declare_blockers requires defending player to be a DeterministicPlayer\"\n495\t        )\n496\t\n497\t    declare_blockers_step(game)\n498\t"}]},"parent_tool_use_id":null,"session_id":"a1b7c704-d004-4a3e-ade9-c0cdca9e5add","uuid":"b9d04431-4ded-4804-82db-1a4b774d87c2","timestamp":"2026-06-04T08:44:15.901Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/test_utils.py","content":"\"\"\"Test utility helpers for engine validation and benchmark agents.\n\nProvides convenience functions for setting up game states, casting spells,\nadvancing phases, and managing combat in tests.  Each function raises\ndescriptive errors on failure.\n\nFunctions:\n    create_game — convenience wrapper to create a GameState from card lists.\n    set_board_state — directly set zone contents and player state.\n    cast_spell — find card in hand by name, cast, and resolve.\n    advance_to_phase — fast-forward game state to a given phase/step.\n    declare_attackers — advance to combat and declare attackers by name.\n    declare_blockers — assign blockers by name mapping.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any\n\nfrom engine.card import CardImpl, Creature\nfrom engine.casting import cast_spell as _engine_cast_spell\nfrom engine.combat import (\n    CombatState,\n    declare_attackers_step,\n    declare_blockers_step,\n)\nfrom engine.game import create_game as _engine_create_game\nfrom engine.game_state import GameState, _TURN_SEQUENCE\nfrom engine.mana import ManaPool\nfrom engine.player import DeterministicPlayer\nfrom engine.stack import priority_loop\nfrom engine.types import ManaType, Phase, Step, Zone\n\n\nclass TestSetupError(Exception):\n    \"\"\"Raised when a test utility function encounters an invalid setup.\"\"\"\n\n\ndef card_colors(card: Any) -> set[str]:\n    \"\"\"Return a card's colors as single-letter strings, derived from its mana cost.\n\n    Hybrid pips contribute both options. {C} and {X} contribute nothing.\n    Returns an empty set for cards with no mana cost or only colorless/X pips.\n    Used by audited tests that previously asserted against a non-existent\n    ``card.colors`` attribute.\n    \"\"\"\n    colors: set[str] = set()\n    cost = getattr(card, \"mana_cost\", None)\n    if cost is None:\n        return colors\n    for mt in getattr(cost, \"pips\", {}):\n        if mt != ManaType.COLORLESS:\n            colors.add(mt.value)\n    for hybrid in getattr(cost, \"hybrid\", []):\n        if hybrid.option_a != ManaType.COLORLESS:\n            colors.add(hybrid.option_a.value)\n        if hybrid.option_b != ManaType.COLORLESS:\n            colors.add(hybrid.option_b.value)\n    return colors\n\n\n# ---------------------------------------------------------------------------\n# create_game\n# ---------------------------------------------------------------------------\n\n\ndef create_game(\n    deck1: list[CardImpl] | None = None,\n    deck2: list[CardImpl] | None = None,\n    *,\n    player1_name: str = \"Player1\",\n    player2_name: str = \"Player2\",\n    player1_life: int = 20,\n    player2_life: int = 20,\n    scripts: tuple[list[Any], list[Any]] | None = None,\n) -> GameState:\n    \"\"\"Create a new two-player game from card lists.\n\n    This is a convenience wrapper around :func:`engine.game.create_game`\n    that automatically creates :class:`DeterministicPlayer` instances.\n\n    Parameters:\n        deck1: Cards for player 1's deck.  Defaults to empty list.\n        deck2: Cards for player 2's deck.  Defaults to empty list.\n        player1_name: Display name for player 1.\n        player2_name: Display name for player 2.\n        player1_life: Starting life for player 1.\n        player2_life: Starting life for player 2.\n        scripts: Optional tuple of ``(script1, script2)`` for\n            :class:`DeterministicPlayer`.  Defaults to empty lists.\n\n    Returns:\n        A fully initialised :class:`GameState`.\n\n    Raises:\n        TestSetupError: If the inputs are invalid.\n    \"\"\"\n    if deck1 is None:\n        deck1 = []\n    if deck2 is None:\n        deck2 = []\n\n    script1: list[Any] = []\n    script2: list[Any] = []\n    if scripts is not None:\n        script1, script2 = scripts\n\n    p1 = DeterministicPlayer(player1_name, script=script1, life=player1_life)\n    p2 = DeterministicPlayer(player2_name, script=script2, life=player2_life)\n\n    game = _engine_create_game(p1, p2, deck1, deck2)\n\n    # When decks are empty (the convenience default), engine.game.create_game\n    # attempts to draw 7 cards from each empty library, which sets the\n    # drawn_from_empty_library loss flag.  Reset it for the convenience case.\n    for player in game.players:\n        if player.drawn_from_empty_library:\n            player.drawn_from_empty_library = False\n\n    # engine.game.create_game hardcodes life=20; restore custom values.\n    if player1_life != 20:\n        game.players[0].life = player1_life\n    if player2_life != 20:\n        game.players[1].life = player2_life\n\n    return game\n\n\n# ---------------------------------------------------------------------------\n# set_board_state\n# ---------------------------------------------------------------------------\n\n\ndef set_board_state(\n    game: GameState,\n    player_index: int,\n    *,\n    battlefield: list[Any] | None = None,\n    hand: list[Any] | None = None,\n    graveyard: list[Any] | None = None,\n    life: int | None = None,\n    mana: dict[ManaType, int] | None = None,\n) -> None:\n    \"\"\"Directly set zone contents and player state for test setup.\n\n    Replaces the contents of the specified zones (only zones that are\n    explicitly provided are modified — others are left unchanged).\n\n    For each card placed into a zone, ``owner`` and ``controller`` are\n    set to the target player.\n\n    Parameters:\n        game: The game state to modify.\n        player_index: Index of the player (0 or 1).\n        battlefield: Cards/permanents to place on the battlefield.\n        hand: Cards to place in hand.\n        graveyard: Cards to place in graveyard.\n        life: Life total to set (or ``None`` to leave unchanged).\n        mana: Mana to add to the player's pool.  Keys are\n            :class:`ManaType`, values are amounts.\n\n    Raises:\n        TestSetupError: If ``player_index`` is out of range.\n    \"\"\"\n    if player_index < 0 or player_index >= len(game.players):\n        raise TestSetupError(\n            f\"Invalid player_index {player_index} — game has \"\n            f\"{len(game.players)} players (indices 0–{len(game.players) - 1})\"\n        )\n\n    player = game.players[player_index]\n\n    if life is not None:\n        player.life = life\n\n    if mana is not None:\n        player.mana_pool.empty()\n        for mana_type, amount in mana.items():\n            player.mana_pool.add(mana_type, amount)\n\n    if battlefield is not None:\n        _set_zone(game, player, Zone.BATTLEFIELD, battlefield)\n\n    if hand is not None:\n        _set_zone(game, player, Zone.HAND, hand)\n\n    if graveyard is not None:\n        _set_zone(game, player, Zone.GRAVEYARD, graveyard)\n\n\ndef _set_zone(\n    game: GameState,\n    player: Any,\n    zone: Zone,\n    cards: list[Any],\n) -> None:\n    \"\"\"Replace a zone's contents with *cards*, assigning ownership.\"\"\"\n    zone_container = player.zones[zone]\n    # Clear existing contents\n    for obj in zone_container.get_all():\n        zone_container.remove(obj)\n\n    # Add new contents\n    for card in cards:\n        card.owner = player\n        card.controller = player\n        zone_container.add(card)\n\n\n# ---------------------------------------------------------------------------\n# cast_spell\n# ---------------------------------------------------------------------------\n\n\ndef cast_spell(\n    game: GameState,\n    player_index: int,\n    card_name: str,\n    targets: list[Any] | None = None,\n) -> None:\n    \"\"\"Find a card in hand by name, cast it, and pass priority until resolved.\n\n    The function:\n    1. Locates the first card matching *card_name* in the player's hand.\n    2. Sets up the game phase/priority for sorcery-speed casting if needed.\n    3. Calls :func:`engine.casting.cast_spell`.\n    4. Passes priority for both players so the spell resolves.\n\n    Parameters:\n        game: The game state.\n        player_index: Index of the casting player (0 or 1).\n        card_name: Name of the card to find in hand.\n        targets: Optional target list.  If provided, they are scripted\n            into the player's DeterministicPlayer choices.\n\n    Raises:\n        TestSetupError: If the card is not found in hand or casting fails.\n    \"\"\"\n    if player_index < 0 or player_index >= len(game.players):\n        raise TestSetupError(\n            f\"Invalid player_index {player_index} — game has \"\n            f\"{len(game.players)} players\"\n        )\n\n    player = game.players[player_index]\n    hand = game.get_hand(player)\n\n    # Find the card by name\n    card = None\n    for obj in hand.get_all():\n        if getattr(obj, \"name\", None) == card_name:\n            card = obj\n            break\n\n    if card is None:\n        hand_names = [getattr(c, \"name\", repr(c)) for c in hand.get_all()]\n        raise TestSetupError(\n            f\"Card {card_name!r} not found in player {player_index}'s hand. \"\n            f\"Hand contains: {hand_names}\"\n        )\n\n    # Ensure sorcery-speed timing for non-instant spells\n    from engine.types import CardType, Keyword\n\n    is_instant = CardType.INSTANT in getattr(card, \"card_types\", set())\n    has_flash = Keyword.FLASH in getattr(card, \"keywords\", Keyword(0))\n\n    if not is_instant and not has_flash:\n        # Set up sorcery-speed timing: active player, main phase, empty stack\n        game.active_player_index = player_index\n        game.priority_player_index = player_index\n        if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n            game.phase = Phase.PRECOMBAT_MAIN\n            game.step = None\n\n    # Ensure the stack is empty for sorcery-speed\n    if not game.stack.is_empty():\n        raise TestSetupError(\n            f\"Cannot cast {card_name!r} — stack is not empty\"\n        )\n\n    # Script targets into the player's DeterministicPlayer choices so that\n    # engine.casting.cast_spell -> player.choose_target() returns them.\n    if targets and isinstance(player, DeterministicPlayer):\n        for target in reversed(targets):\n            player._script.appendleft(target)\n\n    try:\n        _engine_cast_spell(game, player, card)\n    except Exception as exc:\n        raise TestSetupError(\n            f\"Failed to cast {card_name!r}: {exc}\"\n        ) from exc\n\n    # Pass priority for both players to resolve the spell\n    _resolve_top_of_stack(game)\n\n\ndef _resolve_top_of_stack(game: GameState) -> None:\n    \"\"\"Resolve the top spell/ability on the stack by passing priority.\n\n    Both players pass priority so the top of the stack resolves.\n    Repeats until the stack is empty.\n    \"\"\"\n    from engine.state_based_actions import resolve_state_based_actions\n\n    while not game.stack.is_empty():\n        obj = game.stack.pop()\n        obj.on_resolve(game)\n        resolve_state_based_actions(game)\n\n\n# ---------------------------------------------------------------------------\n# advance_to_phase\n# ---------------------------------------------------------------------------\n\n\ndef advance_to_phase(\n    game: GameState,\n    phase: Phase,\n    step: Step | None = None,\n) -> None:\n    \"\"\"Fast-forward the game state to the specified phase/step.\n\n    Advances by calling :meth:`GameState.advance_phase` until the target\n    phase (and optionally step) is reached.  Priority is not granted during\n    fast-forwarding — this is a direct state manipulation for test setup.\n\n    Parameters:\n        game: The game state to advance.\n        phase: The target phase.\n        step: The target step (or ``None`` for main phases).\n\n    Raises:\n        TestSetupError: If the target phase/step is not found within\n            a full turn cycle (prevents infinite loops).\n    \"\"\"\n    target = (phase, step)\n\n    # Validate that (phase, step) is a valid combination\n    valid_targets = {(p, s) for p, s in _TURN_SEQUENCE}\n    if target not in valid_targets:\n        raise TestSetupError(\n            f\"Invalid phase/step combination: ({phase!r}, {step!r}). \"\n            f\"Valid combinations: {sorted(valid_targets, key=lambda x: str(x))}\"\n        )\n\n    # Already there?\n    if (game.phase, game.step) == target:\n        return\n\n    # Advance up to a full turn's worth of steps to prevent infinite loops\n    max_advances = len(_TURN_SEQUENCE) + 1\n    for _ in range(max_advances):\n        game.advance_phase()\n        if (game.phase, game.step) == target:\n            return\n\n    raise TestSetupError(\n        f\"Could not reach phase/step ({phase!r}, {step!r}) within \"\n        f\"a full turn cycle. Current: ({game.phase!r}, {game.step!r})\"\n    )\n\n\n# ---------------------------------------------------------------------------\n# declare_attackers\n# ---------------------------------------------------------------------------\n\n\ndef declare_attackers(\n    game: GameState,\n    attacker_names: list[str],\n) -> None:\n    \"\"\"Advance to combat and declare attackers by name.\n\n    1. Advances to the Declare Attackers step if not already there.\n    2. Finds creatures on the active player's battlefield matching the\n       given names.\n    3. Scripts the active player's ``choose`` method to return those\n       creatures.\n    4. Calls :func:`engine.combat.declare_attackers_step`.\n\n    Parameters:\n        game: The game state.\n        attacker_names: Names of creatures to declare as attackers.\n\n    Raises:\n        TestSetupError: If any named creature is not found on the\n            active player's battlefield, or if the creature cannot attack.\n    \"\"\"\n    # Advance to declare attackers step\n    if (game.phase, game.step) != (Phase.COMBAT, Step.DECLARE_ATTACKERS):\n        advance_to_phase(game, Phase.COMBAT, Step.DECLARE_ATTACKERS)\n\n    active = game.active_player\n    bf = game.get_battlefield(active)\n\n    # Resolve attacker names to objects\n    attackers: list[Any] = []\n    bf_objects = bf.get_all()\n    for name in attacker_names:\n        found = None\n        for obj in bf_objects:\n            if getattr(obj, \"name\", None) == name and obj not in attackers:\n                found = obj\n                break\n        if found is None:\n            bf_names = [getattr(c, \"name\", repr(c)) for c in bf_objects]\n            raise TestSetupError(\n                f\"Attacker {name!r} not found on active player's battlefield. \"\n                f\"Battlefield contains: {bf_names}\"\n            )\n        attackers.append(found)\n\n    # Script the active player to choose these attackers\n    if isinstance(active, DeterministicPlayer):\n        active._script.appendleft(attackers)\n    else:\n        raise TestSetupError(\n            \"declare_attackers requires active player to be a DeterministicPlayer\"\n        )\n\n    game.combat_state.in_combat = True\n    declare_attackers_step(game)\n\n\n# ---------------------------------------------------------------------------\n# declare_blockers\n# ---------------------------------------------------------------------------\n\n\ndef declare_blockers(\n    game: GameState,\n    assignments: dict[str, list[str]],\n) -> None:\n    \"\"\"Assign blockers by name mapping.\n\n    Parameters:\n        game: The game state.\n        assignments: A mapping of ``{\"attacker_name\": [\"blocker_name\", ...]}``.\n            Each attacker on the active player's battlefield is matched by\n            name, and each blocker on the defending player's battlefield is\n            matched by name.\n\n    Raises:\n        TestSetupError: If any named creature is not found.\n    \"\"\"\n    if (game.phase, game.step) != (Phase.COMBAT, Step.DECLARE_BLOCKERS):\n        advance_to_phase(game, Phase.COMBAT, Step.DECLARE_BLOCKERS)\n\n    active = game.active_player\n    defending = game.non_active_player\n\n    active_bf = game.get_battlefield(active)\n    defending_bf = game.get_battlefield(defending)\n\n    active_objects = active_bf.get_all()\n    defending_objects = defending_bf.get_all()\n\n    # Build mapping of blocker_obj → attacker_obj\n    block_map: dict[Any, Any] = {}\n\n    for attacker_name, blocker_names in assignments.items():\n        # Find attacker\n        attacker = None\n        for obj in active_objects:\n            if getattr(obj, \"name\", None) == attacker_name:\n                attacker = obj\n                break\n        if attacker is None:\n            raise TestSetupError(\n                f\"Attacker {attacker_name!r} not found on active player's battlefield. \"\n                f\"Available: {[getattr(c, 'name', repr(c)) for c in active_objects]}\"\n            )\n\n        for blocker_name in blocker_names:\n            blocker = None\n            for obj in defending_objects:\n                if getattr(obj, \"name\", None) == blocker_name and obj not in block_map:\n                    blocker = obj\n                    break\n            if blocker is None:\n                raise TestSetupError(\n                    f\"Blocker {blocker_name!r} not found on defending player's battlefield. \"\n                    f\"Available: {[getattr(c, 'name', repr(c)) for c in defending_objects]}\"\n                )\n            block_map[blocker] = attacker\n\n    # Script the defending player to choose these block assignments\n    if isinstance(defending, DeterministicPlayer):\n        defending._script.appendleft(block_map)\n    else:\n        raise TestSetupError(\n            \"declare_blockers requires defending player to be a DeterministicPlayer\"\n        )\n\n    declare_blockers_step(game)\n","numLines":498,"startLine":1,"totalLines":498}}}
