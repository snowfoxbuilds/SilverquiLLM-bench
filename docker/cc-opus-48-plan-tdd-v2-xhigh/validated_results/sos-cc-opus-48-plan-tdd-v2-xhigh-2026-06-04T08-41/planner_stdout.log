{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FkXVFEKYBqJVj65cAAUaVW","type":"tool_result","content":"208\tdef declare_attackers_step(game: GameState) -> None:\n209\t    \"\"\"Declare attackers step: active player chooses creatures to attack with.\n210\t\n211\t    The active player is asked (via :meth:`Player.choose`) to select a set\n212\t    of creatures to attack with.  Each chosen attacker is tapped (unless it\n213\t    has vigilance) and its ``is_attacking`` flag is set.\n214\t\n215\t    Parameters:\n216\t        game: The current game state.  ``game.combat_state`` must exist.\n217\t    \"\"\"\n218\t    combat = game.combat_state\n219\t    combat.in_combat = True\n220\t    active = game.active_player\n221\t    defending = game.non_active_player\n222\t\n223\t    # Gather legal attackers from the active player's battlefield\n224\t    from engine.types import Zone\n225\t    bf = active.zones[Zone.BATTLEFIELD]\n226\t    eligible = [\n227\t        c for c in bf.get_all()\n228\t        if hasattr(c, \"base_power\") and _can_attack(c)\n229\t    ]\n230\t\n231\t    if not eligible:\n232\t        return\n233\t\n234\t    # Active player chooses which creatures to attack with\n235\t    chosen = active.choose(eligible, \"declare attackers\")\n236\t\n237\t    # Normalize to a list\n238\t    if chosen is None:\n239\t        return\n240\t    if not isinstance(chosen, list):\n241\t        chosen = [chosen]\n242\t\n243\t    # Validate and register attackers\n244\t    for attacker in chosen:\n245\t        if attacker not in eligible:\n246\t            continue\n247\t        if not _can_attack(attacker):\n248\t            continue\n249\t\n250\t        combat.attackers[attacker] = defending\n251\t        combat.attacker_blockers[attacker] = []\n252\t        attacker.is_attacking = True\n253\t\n254\t        # Tap the attacker unless it has vigilance\n255\t        kw = getattr(attacker, \"keywords\", Keyword(0))\n256\t        if Keyword.VIGILANCE not in kw:\n257\t            attacker.is_tapped = True\n258\t\n259\t\n260\tdef declare_blockers_step(game: GameState) -> None:\n261\t    \"\"\"Declare blockers step: defending player assigns blockers.\n262\t\n263\t    The defending player is asked (via :meth:`Player.choose`) to assign\n264\t    blockers.  The expected format is a dict mapping blocker → attacker\n265\t    (or blocker → list of attackers for multi-blocking scenarios), but\n266\t    commonly blocker → attacker.\n267\t\n268\t    After blockers are assigned:\n269\t    - Menace check: attackers with menace must be blocked by 2+ creatures.\n270\t    - Flying/reach check is already handled by ``_can_block``.\n271\t    - The attacking player orders blockers for each attacker (for damage\n272\t      assignment).\n273\t\n274\t    Parameters:\n275\t        game: The current game state.\n276\t    \"\"\"\n277\t    combat = game.combat_state"}]},"parent_tool_use_id":null,"session_id":"a1b7c704-d004-4a3e-ade9-c0cdca9e5add","uuid":"bd92d865-4f04-4992-8847-c2b6e4df42f5","timestamp":"2026-06-04T08:43:51.964Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/combat.py","content":"def declare_attackers_step(game: GameState) -> None:\n    \"\"\"Declare attackers step: active player chooses creatures to attack with.\n\n    The active player is asked (via :meth:`Player.choose`) to select a set\n    of creatures to attack with.  Each chosen attacker is tapped (unless it\n    has vigilance) and its ``is_attacking`` flag is set.\n\n    Parameters:\n        game: The current game state.  ``game.combat_state`` must exist.\n    \"\"\"\n    combat = game.combat_state\n    combat.in_combat = True\n    active = game.active_player\n    defending = game.non_active_player\n\n    # Gather legal attackers from the active player's battlefield\n    from engine.types import Zone\n    bf = active.zones[Zone.BATTLEFIELD]\n    eligible = [\n        c for c in bf.get_all()\n        if hasattr(c, \"base_power\") and _can_attack(c)\n    ]\n\n    if not eligible:\n        return\n\n    # Active player chooses which creatures to attack with\n    chosen = active.choose(eligible, \"declare attackers\")\n\n    # Normalize to a list\n    if chosen is None:\n        return\n    if not isinstance(chosen, list):\n        chosen = [chosen]\n\n    # Validate and register attackers\n    for attacker in chosen:\n        if attacker not in eligible:\n            continue\n        if not _can_attack(attacker):\n            continue\n\n        combat.attackers[attacker] = defending\n        combat.attacker_blockers[attacker] = []\n        attacker.is_attacking = True\n\n        # Tap the attacker unless it has vigilance\n        kw = getattr(attacker, \"keywords\", Keyword(0))\n        if Keyword.VIGILANCE not in kw:\n            attacker.is_tapped = True\n\n\ndef declare_blockers_step(game: GameState) -> None:\n    \"\"\"Declare blockers step: defending player assigns blockers.\n\n    The defending player is asked (via :meth:`Player.choose`) to assign\n    blockers.  The expected format is a dict mapping blocker → attacker\n    (or blocker → list of attackers for multi-blocking scenarios), but\n    commonly blocker → attacker.\n\n    After blockers are assigned:\n    - Menace check: attackers with menace must be blocked by 2+ creatures.\n    - Flying/reach check is already handled by ``_can_block``.\n    - The attacking player orders blockers for each attacker (for damage\n      assignment).\n\n    Parameters:\n        game: The current game state.\n    \"\"\"\n    combat = game.combat_state","numLines":70,"startLine":208,"totalLines":557}}}
