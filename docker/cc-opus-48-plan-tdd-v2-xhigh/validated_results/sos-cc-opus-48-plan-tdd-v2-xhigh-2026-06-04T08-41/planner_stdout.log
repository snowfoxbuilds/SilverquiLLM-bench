{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XQUY8shUohn8TtiPeBgNCG","type":"tool_result","content":"1\t\"\"\"Card base classes, CardImpl interface, and supporting dataclasses.\n2\t\n3\tProvides the core class hierarchy for all Magic: The Gathering card types:\n4\t\n5\t- ``GameObject`` — base for anything that can exist in zones.\n6\t- ``CardImpl(GameObject)`` — abstract card implementation with hooks for\n7\t  casting, resolution, targeting, triggers, and abilities.\n8\t- Concrete subclasses: ``Creature``, ``Instant``, ``Sorcery``,\n9\t  ``Enchantment``, ``Aura``, ``Artifact``, ``ArtifactCreature``,\n10\t  ``Planeswalker``, ``Land``.\n11\t- Supporting dataclasses: ``ActivatedAbility``, ``LoyaltyAbility``,\n12\t  ``ManaAbility``, ``ContinuousEffect``, ``Mode``.\n13\t\"\"\"\n14\t\n15\tfrom __future__ import annotations\n16\t\n17\tfrom dataclasses import dataclass\n18\tfrom typing import TYPE_CHECKING, Any, Callable\n19\t\n20\tfrom engine.types import CardType, Keyword, ManaCost, Supertype\n21\t\n22\tif TYPE_CHECKING:\n23\t    from engine.game_state import GameState\n24\t    from engine.player import Player\n25\t\n26\t\n27\t# ---------------------------------------------------------------------------\n28\t# Supporting dataclasses\n29\t# ---------------------------------------------------------------------------\n30\t\n31\t@dataclass\n32\tclass Mode:\n33\t    \"\"\"Represents a single mode of a modal spell or ability.\n34\t\n35\t    Attributes:\n36\t        name: Short label for this mode (e.g. ``\"Destroy target creature\"``).\n37\t        description: Detailed rules text for the mode.\n38\t    \"\"\"\n39\t\n40\t    name: str = \"\"\n41\t    description: str = \"\"\n42\t\n43\t\n44\t@dataclass\n45\tclass ActivatedAbility:\n46\t    \"\"\"An activated ability on a permanent.\n47\t\n48\t    Attributes:\n49\t        cost: A callable that checks/pays the cost given the game state.\n50\t        effect: A callable that applies the effect given the game state.\n51\t        description: Human-readable description of the ability.\n52\t    \"\"\"\n53\t\n54\t    cost: Callable[..., Any]\n55\t    effect: Callable[..., Any]\n56\t    description: str = \"\"\n57\t\n58\t\n59\t@dataclass\n60\tclass LoyaltyAbility:\n61\t    \"\"\"A planeswalker loyalty ability.\n62\t\n63\t    Attributes:\n64\t        loyalty_cost: The loyalty cost (positive for ``+``, negative for ``−``).\n65\t        effect: A callable that applies the ability's effect.\n66\t        description: Human-readable description.\n67\t    \"\"\"\n68\t\n69\t    loyalty_cost: int\n70\t    effect: Callable[..., Any]\n71\t    description: str = \"\"\n72\t\n73\t\n74\t@dataclass\n75\tclass ManaAbility:\n76\t    \"\"\"A mana ability (does not use the stack).\n77\t\n78\t    Attributes:\n79\t        cost: A callable that checks/pays the cost.\n80\t        mana_produced: A callable that returns the mana added.\n81\t        description: Human-readable description.\n82\t    \"\"\"\n83\t\n84\t    cost: Callable[..., Any]\n85\t    mana_produced: Callable[..., Any]\n86\t    description: str = \"\"\n87\t\n88\t\n89\t@dataclass\n90\tclass ContinuousEffect:\n91\t    \"\"\"A continuous effect applied by an enchantment or other source.\n92\t\n93\t    Attributes:\n94\t        apply: A callable that applies the effect to the game state.\n95\t        remove: A callable that removes the effect from the game state.\n96\t        description: Human-readable description.\n97\t    \"\"\"\n98\t\n99\t    apply: Callable[..., Any]\n100\t    remove: Callable[..., Any]\n101\t    description: str = \"\"\n102\t\n103\t\n104\t# ---------------------------------------------------------------------------\n105\t# GameObject — base class for zone-resident objects\n106\t# ---------------------------------------------------------------------------\n107\t\n108\tclass GameObject:\n109\t    \"\"\"Base class for anything that can exist in a zone.\n110\t\n111\t    Each instance receives a unique ``object_id`` via a class-level\n112\t    auto-incrementing counter.\n113\t\n114\t    Attributes:\n115\t        object_id: Unique integer identifier (auto-assigned).\n116\t        owner: The player who owns this object.\n117\t        controller: The player who currently controls this object.\n118\t    \"\"\"\n119\t\n120\t    _next_id: int = 1\n121\t\n122\t    def __init__(self, owner: Player | None = None, controller: Player | None = None) -> None:\n123\t        self.object_id: int = GameObject._next_id\n124\t        GameObject._next_id += 1\n125\t        self.owner: Player | None = owner\n126\t        self.controller: Player | None = controller if controller is not None else owner\n127\t\n128\t    @classmethod\n129\t    def reset_id_counter(cls) -> None:\n130\t        \"\"\"Reset the auto-incrementing counter (useful in tests).\"\"\"\n131\t        cls._next_id = 1\n132\t\n133\t\n134\t# ---------------------------------------------------------------------------\n135\t# CardImpl — abstract card implementation\n136\t# ---------------------------------------------------------------------------\n137\t\n138\tclass CardImpl(GameObject):\n139\t    \"\"\"Abstract base for all card implementations.\n140\t\n141\t    Subclasses should override the ``can_cast``, ``on_cast``, ``on_resolve``,\n142\t    and other hook methods to implement card-specific behaviour.\n143\t\n144\t    Attributes:\n145\t        name: Card name.\n146\t        mana_cost: The card's mana cost.\n147\t        card_types: Set of :class:`~engine.types.CardType` values.\n148\t        subtypes: Set of subtype strings (e.g. ``{\"Elf\", \"Warrior\"}``).\n149\t        supertypes: Set of :class:`~engine.types.Supertype` values.\n150\t        keywords: Combination of :class:`~engine.types.Keyword` flags.\n151\t        rules_text: The card's rules text string.\n152\t    \"\"\"\n153\t\n154\t    def __init__(\n155\t        self,\n156\t        name: str = \"\",\n157\t        mana_cost: ManaCost | None = None,\n158\t        card_types: set[CardType] | None = None,\n159\t        subtypes: set[str] | None = None,\n160\t        supertypes: set[Supertype] | None = None,\n161\t        keywords: Keyword | None = None,\n162\t        rules_text: str = \"\",\n163\t        owner: Player | None = None,\n164\t        controller: Player | None = None,\n165\t    ) -> None:\n166\t        super().__init__(owner=owner, controller=controller)\n167\t        self.name: str = name\n168\t        self.mana_cost: ManaCost = mana_cost if mana_cost is not None else ManaCost()\n169\t        self.card_types: set[CardType] = card_types if card_types is not None else set()\n170\t        self.subtypes: set[str] = subtypes if subtypes is not None else set()\n171\t        self.supertypes: set[Supertype] = supertypes if supertypes is not None else set()\n172\t        self.keywords: Keyword = keywords if keywords is not None else Keyword(0)\n173\t        self.rules_text: str = rules_text\n174\t        # Snapshot original characteristics for continuous-effect reset.\n175\t        self._original_card_types: frozenset[CardType] = frozenset(self.card_types)\n176\t        self._original_keywords: Keyword = self.keywords\n177\t\n178\t    # ------------------------------------------------------------------\n179\t    # Continuous-effect reset support\n180\t    # ------------------------------------------------------------------\n181\t\n182\t    def _reset_characteristics(self) -> None:\n183\t        \"\"\"Reset mutable characteristics to their original (pre-effect) values.\n184\t\n185\t        Called by :meth:`EffectManager.apply_all` before reapplying effects\n186\t        so that the recalculation is idempotent.\n187\t        \"\"\"\n188\t        self.card_types = set(self._original_card_types)\n189\t        self.keywords = self._original_keywords\n190\t\n191\t    # ------------------------------------------------------------------\n192\t    # Hook methods — override in subclasses / card definitions\n193\t    # ------------------------------------------------------------------\n194\t\n195\t    def can_cast(self, game: GameState) -> bool:\n196\t        \"\"\"Return ``True`` if this card can currently be cast.\"\"\"\n197\t        return True\n198\t\n199\t    def cost_reduction(self, game: GameState) -> int:\n200\t        \"\"\"Return the generic mana reduction for casting this card.\n201\t\n202\t        Override in subclasses to implement cost-reduction mechanics\n203\t        (e.g. Embercleave costs {1} less for each attacking creature).\n204\t        The returned value is clamped so that generic mana cannot go below 0.\n205\t        Only reduces generic mana — colored costs are never reduced.\n206\t\n207\t        Returns:\n208\t            Non-negative integer representing generic mana to subtract.\n209\t        \"\"\"\n210\t        return 0\n211\t\n212\t    def on_cast(self, game: GameState) -> None:\n213\t        \"\"\"Called when the card is cast (before it goes on the stack).\"\"\"\n214\t\n215\t    def on_resolve(self, game: GameState) -> None:\n216\t        \"\"\"Called when the spell resolves from the stack.\n217\t\n218\t        Targets are available via ``self.chosen_targets`` — set at\n219\t        resolve-time by :func:`~engine.casting._resolve_spell` from\n220\t        :attr:`StackObject.targets`, or directly by test code.\n221\t        \"\"\"\n222\t\n223\t    def get_targets(self, game: GameState) -> list[Any]:\n224\t        \"\"\"Return a list of legal targets for this card.\"\"\"\n225\t        return []\n226\t\n227\t    def register_triggers(self, game: GameState) -> None:\n228\t        \"\"\"Register any triggered abilities this card provides.\"\"\"\n229\t\n230\t    def register_replacement_effects(self, game: GameState) -> None:\n231\t        \"\"\"Register any replacement effects this card provides.\"\"\"\n232\t\n233\t    def get_activated_abilities(self) -> list[ActivatedAbility]:\n234\t        \"\"\"Return activated abilities this card provides.\"\"\"\n235\t        return []\n236\t\n237\t    def get_modes(self) -> list[Mode]:\n238\t        \"\"\"Return available modes for modal spells/abilities.\n239\t\n240\t        Non-modal cards return an empty list by default.\n241\t        \"\"\"\n242\t        return []\n243\t\n244\t\n245\t# ---------------------------------------------------------------------------\n246\t# Creature\n247\t# ---------------------------------------------------------------------------\n248\t\n249\tclass Creature(CardImpl):\n250\t    \"\"\"A creature card.\n251\t\n252\t    Attributes:\n253\t        base_power: The printed power value (rule 208.1). Immutable after init.\n254\t        base_toughness: The printed toughness value. Immutable after init.\n255\t        modified_power: Current power after continuous effects (Layer 7c), before counters.\n256\t            Reset to ``base_power`` each effect cycle; continuous effects write here.\n257\t        modified_toughness: Current toughness after continuous effects, before counters.\n258\t        damage_marked: Amount of damage currently marked on this creature.\n259\t        is_tapped: Whether the creature is tapped.\n260\t        summoning_sick: Whether the creature has summoning sickness.\n261\t        is_attacking: Combat flag — currently declared as an attacker.\n262\t        is_blocking: Combat flag — currently declared as a blocker.\n263\t        plus_one_counters: Number of +1/+1 counters.\n264\t        minus_one_counters: Number of -1/-1 counters.\n265\t        is_token: Whether this object is a token (for SBA checks).\n266\t    \"\"\"\n267\t\n268\t    def __init__(\n269\t        self,\n270\t        name: str = \"\",\n271\t        mana_cost: ManaCost | None = None,\n272\t        card_types: set[CardType] | None = None,\n273\t        subtypes: set[str] | None = None,\n274\t        supertypes: set[Supertype] | None = None,\n275\t        keywords: Keyword | None = None,\n276\t        rules_text: str = \"\",\n277\t        owner: Player | None = None,\n278\t        controller: Player | None = None,\n279\t        base_power: int = 0,\n280\t        base_toughness: int = 0,\n281\t    ) -> None:\n282\t        # Always include CREATURE in card_types.\n283\t        card_types = (card_types or set()) | {CardType.CREATURE}\n284\t        super().__init__(\n285\t            name=name,\n286\t            mana_cost=mana_cost,\n287\t            card_types=card_types,\n288\t            subtypes=subtypes,\n289\t            supertypes=supertypes,\n290\t            keywords=keywords,\n291\t            rules_text=rules_text,\n292\t            owner=owner,\n293\t            controller=controller,\n294\t        )\n295\t        self.base_power: int = base_power\n296\t        self.base_toughness: int = base_toughness\n297\t        self.modified_power: int = base_power\n298\t        self.modified_toughness: int = base_toughness\n299\t        self.damage_marked: int = 0\n300\t        self.is_tapped: bool = False\n301\t        self.summoning_sick: bool = True\n302\t        self.is_attacking: bool = False\n303\t        self.is_blocking: bool = False\n304\t        self.plus_one_counters: int = 0\n305\t        self.minus_one_counters: int = 0\n306\t        self.is_token: bool = False\n307\t        self.dealt_deathtouch_damage: bool = False\n308\t        self._base_plus_one_counters: int = 0\n309\t        self._base_minus_one_counters: int = 0\n310\t\n311\t    def _reset_characteristics(self) -> None:\n312\t        \"\"\"Reset creature characteristics to pre-effect values.\"\"\"\n313\t        super()._reset_characteristics()\n314\t        self.modified_power = self.base_power\n315\t        self.modified_toughness = self.base_toughness\n316\t        self.plus_one_counters = self._base_plus_one_counters\n317\t        self.minus_one_counters = self._base_minus_one_counters\n318\t        # Reset combat-restriction flags set by continuous effects (e.g. Pacifism).\n319\t        # These are reapplied by active effects during apply_all().\n320\t        self._cant_attack: bool = False\n321\t        self._cant_block: bool = False\n322\t        self._cant_be_blocked: bool = False\n323\t        self._cant_activate: bool = False\n324\t        self._max_attackers_blocked: int = 1\n325\t        # Clear granted protections so they are reapplied by active effects.\n326\t        if hasattr(self, \"protections\"):\n327\t            self.protections = []\n328\t\n329\t    @property\n330\t    def counters(self) -> dict[str, int]:\n331\t        \"\"\"Return a dict-like view of counters on this creature.\"\"\"\n332\t        result: dict[str, int] = {}\n333\t        if self.plus_one_counters > 0:\n334\t            result[\"+1/+1\"] = self.plus_one_counters\n335\t        if self.minus_one_counters > 0:\n336\t            result[\"-1/-1\"] = self.minus_one_counters\n337\t        return result\n338\t\n339\t    @property\n340\t    def power(self) -> int:\n341\t        \"\"\"Current power including counter modifications.\"\"\"\n342\t        return self.modified_power + self.plus_one_counters - self.minus_one_counters\n343\t\n344\t    @property\n345\t    def toughness(self) -> int:\n346\t        \"\"\"Current toughness including counter modifications.\"\"\"\n347\t        return self.modified_toughness + self.plus_one_counters - self.minus_one_counters\n348\t\n349\t\n350\t# ---------------------------------------------------------------------------\n351\t# Instant / Sorcery\n352\t# ---------------------------------------------------------------------------\n353\t\n354\tclass Instant(CardImpl):\n355\t    \"\"\"An instant spell — no extra fields beyond CardImpl.\"\"\"\n356\t\n357\t    def __init__(self, **kwargs: Any) -> None:\n358\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.INSTANT}\n359\t        super().__init__(**kwargs)\n360\t\n361\t\n362\tclass Sorcery(CardImpl):\n363\t    \"\"\"A sorcery spell — no extra fields beyond CardImpl.\"\"\"\n364\t\n365\t    def __init__(self, **kwargs: Any) -> None:\n366\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.SORCERY}\n367\t        super().__init__(**kwargs)\n368\t\n369\t\n370\t# ---------------------------------------------------------------------------\n371\t# Enchantment\n372\t# ---------------------------------------------------------------------------\n373\t\n374\tclass Enchantment(CardImpl):\n375\t    \"\"\"An enchantment card.\n376\t\n377\t    For auras, use the :class:`Aura` subclass which sets ``is_aura = True``.\n378\t    The base ``Enchantment`` class retains the ``attached_to`` attribute for\n379\t    backwards compatibility but marks ``is_aura = False`` so that state-based\n380\t    actions do not treat a non-aura enchantment as an unattached aura.\n381\t\n382\t    Attributes:\n383\t        attached_to: The object this enchantment is attached to (``None``\n384\t            if not an aura or not yet attached).\n385\t        is_aura: ``False`` for regular enchantments; ``True`` for auras.\n386\t    \"\"\"\n387\t\n388\t    is_aura: bool = False\n389\t\n390\t    def __init__(self, attached_to: Any | None = None, **kwargs: Any) -> None:\n391\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ENCHANTMENT}\n392\t        super().__init__(**kwargs)\n393\t        self.attached_to: Any | None = attached_to\n394\t\n395\t    def apply_continuous_effect(self, game: GameState) -> None:\n396\t        \"\"\"Apply the enchantment's continuous effect to the game.\"\"\"\n397\t\n398\t    def on_enchant(self, game: GameState) -> None:\n399\t        \"\"\"Called when this enchantment becomes attached to an object.\"\"\"\n400\t\n401\t    def on_detach(self, game: GameState) -> None:\n402\t        \"\"\"Called when this enchantment is detached from its object.\"\"\"\n403\t\n404\t\n405\tclass Aura(Enchantment):\n406\t    \"\"\"An Aura enchantment — attaches to a permanent on the battlefield.\n407\t\n408\t    Sets ``is_aura = True`` so that state-based actions correctly identify\n409\t    this as an aura (and move it to the graveyard when unattached).\n410\t\n411\t    Attributes:\n412\t        is_aura: Always ``True`` for auras.\n413\t    \"\"\"\n414\t\n415\t    is_aura: bool = True\n416\t\n417\t    def __init__(self, attached_to: Any | None = None, **kwargs: Any) -> None:\n418\t        super().__init__(attached_to=attached_to, **kwargs)\n419\t\n420\t\n421\t# ---------------------------------------------------------------------------\n422\t# Artifact / ArtifactCreature\n423\t# ---------------------------------------------------------------------------\n424\t\n425\tclass Artifact(CardImpl):\n426\t    \"\"\"An artifact card.\n427\t\n428\t    Attributes:\n429\t        is_tapped: Whether the artifact is currently tapped.\n430\t    \"\"\"\n431\t\n432\t    def __init__(self, **kwargs: Any) -> None:\n433\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ARTIFACT}\n434\t        super().__init__(**kwargs)\n435\t        self.is_tapped: bool = False\n436\t\n437\t\n438\tclass ArtifactCreature(Creature):\n439\t    \"\"\"An artifact creature — combines Artifact and Creature types.\n440\t\n441\t    Inherits creature combat stats and behaviour from :class:`Creature`.\n442\t    \"\"\"\n443\t\n444\t    def __init__(self, **kwargs: Any) -> None:\n445\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ARTIFACT, CardType.CREATURE}\n446\t        super().__init__(**kwargs)\n447\t\n448\t\n449\t# ---------------------------------------------------------------------------\n450\t# Planeswalker\n451\t# ---------------------------------------------------------------------------\n452\t\n453\tclass Planeswalker(CardImpl):\n454\t    \"\"\"A planeswalker card.\n455\t\n456\t    Attributes:\n457\t        starting_loyalty: The starting loyalty printed on the card.\n458\t        loyalty: Current loyalty counter value.\n459\t    \"\"\"\n460\t\n461\t    def __init__(\n462\t        self,\n463\t        starting_loyalty: int = 0,\n464\t        **kwargs: Any,\n465\t    ) -> None:\n466\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.PLANESWALKER}\n467\t        super().__init__(**kwargs)\n468\t        self.starting_loyalty: int = starting_loyalty\n469\t        self.loyalty: int = starting_loyalty\n470\t\n471\t    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n472\t        \"\"\"Return the planeswalker's loyalty abilities.\"\"\"\n473\t        return []\n474\t\n475\t\n476\t# ---------------------------------------------------------------------------\n477\t# Land\n478\t# ---------------------------------------------------------------------------\n479\t\n480\tclass Land(CardImpl):\n481\t    \"\"\"A land card.\n482\t\n483\t    Lands are not cast — they are played via a special action. ``can_cast``\n484\t    always returns ``False``.\n485\t\n486\t    Attributes:\n487\t        is_tapped: Whether the land is currently tapped.\n488\t    \"\"\"\n489\t\n490\t    def __init__(self, **kwargs: Any) -> None:\n491\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.LAND}\n492\t        super().__init__(**kwargs)\n493\t        self.is_tapped: bool = False\n494\t\n495\t    def can_cast(self, game: GameState) -> bool:\n496\t        \"\"\"Lands cannot be cast; they are played as a special action.\"\"\"\n497\t        return False\n498\t\n499\t    def get_mana_abilities(self) -> list[ManaAbility]:\n500\t        \"\"\"Return the land's mana abilities.\"\"\"\n501\t        return []\n502\t"}]},"parent_tool_use_id":null,"session_id":"a1b7c704-d004-4a3e-ade9-c0cdca9e5add","uuid":"03a82590-bb72-4342-a2eb-2d24754baf36","timestamp":"2026-06-04T08:41:47.379Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/card.py","content":"\"\"\"Card base classes, CardImpl interface, and supporting dataclasses.\n\nProvides the core class hierarchy for all Magic: The Gathering card types:\n\n- ``GameObject`` — base for anything that can exist in zones.\n- ``CardImpl(GameObject)`` — abstract card implementation with hooks for\n  casting, resolution, targeting, triggers, and abilities.\n- Concrete subclasses: ``Creature``, ``Instant``, ``Sorcery``,\n  ``Enchantment``, ``Aura``, ``Artifact``, ``ArtifactCreature``,\n  ``Planeswalker``, ``Land``.\n- Supporting dataclasses: ``ActivatedAbility``, ``LoyaltyAbility``,\n  ``ManaAbility``, ``ContinuousEffect``, ``Mode``.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom typing import TYPE_CHECKING, Any, Callable\n\nfrom engine.types import CardType, Keyword, ManaCost, Supertype\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n# ---------------------------------------------------------------------------\n# Supporting dataclasses\n# ---------------------------------------------------------------------------\n\n@dataclass\nclass Mode:\n    \"\"\"Represents a single mode of a modal spell or ability.\n\n    Attributes:\n        name: Short label for this mode (e.g. ``\"Destroy target creature\"``).\n        description: Detailed rules text for the mode.\n    \"\"\"\n\n    name: str = \"\"\n    description: str = \"\"\n\n\n@dataclass\nclass ActivatedAbility:\n    \"\"\"An activated ability on a permanent.\n\n    Attributes:\n        cost: A callable that checks/pays the cost given the game state.\n        effect: A callable that applies the effect given the game state.\n        description: Human-readable description of the ability.\n    \"\"\"\n\n    cost: Callable[..., Any]\n    effect: Callable[..., Any]\n    description: str = \"\"\n\n\n@dataclass\nclass LoyaltyAbility:\n    \"\"\"A planeswalker loyalty ability.\n\n    Attributes:\n        loyalty_cost: The loyalty cost (positive for ``+``, negative for ``−``).\n        effect: A callable that applies the ability's effect.\n        description: Human-readable description.\n    \"\"\"\n\n    loyalty_cost: int\n    effect: Callable[..., Any]\n    description: str = \"\"\n\n\n@dataclass\nclass ManaAbility:\n    \"\"\"A mana ability (does not use the stack).\n\n    Attributes:\n        cost: A callable that checks/pays the cost.\n        mana_produced: A callable that returns the mana added.\n        description: Human-readable description.\n    \"\"\"\n\n    cost: Callable[..., Any]\n    mana_produced: Callable[..., Any]\n    description: str = \"\"\n\n\n@dataclass\nclass ContinuousEffect:\n    \"\"\"A continuous effect applied by an enchantment or other source.\n\n    Attributes:\n        apply: A callable that applies the effect to the game state.\n        remove: A callable that removes the effect from the game state.\n        description: Human-readable description.\n    \"\"\"\n\n    apply: Callable[..., Any]\n    remove: Callable[..., Any]\n    description: str = \"\"\n\n\n# ---------------------------------------------------------------------------\n# GameObject — base class for zone-resident objects\n# ---------------------------------------------------------------------------\n\nclass GameObject:\n    \"\"\"Base class for anything that can exist in a zone.\n\n    Each instance receives a unique ``object_id`` via a class-level\n    auto-incrementing counter.\n\n    Attributes:\n        object_id: Unique integer identifier (auto-assigned).\n        owner: The player who owns this object.\n        controller: The player who currently controls this object.\n    \"\"\"\n\n    _next_id: int = 1\n\n    def __init__(self, owner: Player | None = None, controller: Player | None = None) -> None:\n        self.object_id: int = GameObject._next_id\n        GameObject._next_id += 1\n        self.owner: Player | None = owner\n        self.controller: Player | None = controller if controller is not None else owner\n\n    @classmethod\n    def reset_id_counter(cls) -> None:\n        \"\"\"Reset the auto-incrementing counter (useful in tests).\"\"\"\n        cls._next_id = 1\n\n\n# ---------------------------------------------------------------------------\n# CardImpl — abstract card implementation\n# ---------------------------------------------------------------------------\n\nclass CardImpl(GameObject):\n    \"\"\"Abstract base for all card implementations.\n\n    Subclasses should override the ``can_cast``, ``on_cast``, ``on_resolve``,\n    and other hook methods to implement card-specific behaviour.\n\n    Attributes:\n        name: Card name.\n        mana_cost: The card's mana cost.\n        card_types: Set of :class:`~engine.types.CardType` values.\n        subtypes: Set of subtype strings (e.g. ``{\"Elf\", \"Warrior\"}``).\n        supertypes: Set of :class:`~engine.types.Supertype` values.\n        keywords: Combination of :class:`~engine.types.Keyword` flags.\n        rules_text: The card's rules text string.\n    \"\"\"\n\n    def __init__(\n        self,\n        name: str = \"\",\n        mana_cost: ManaCost | None = None,\n        card_types: set[CardType] | None = None,\n        subtypes: set[str] | None = None,\n        supertypes: set[Supertype] | None = None,\n        keywords: Keyword | None = None,\n        rules_text: str = \"\",\n        owner: Player | None = None,\n        controller: Player | None = None,\n    ) -> None:\n        super().__init__(owner=owner, controller=controller)\n        self.name: str = name\n        self.mana_cost: ManaCost = mana_cost if mana_cost is not None else ManaCost()\n        self.card_types: set[CardType] = card_types if card_types is not None else set()\n        self.subtypes: set[str] = subtypes if subtypes is not None else set()\n        self.supertypes: set[Supertype] = supertypes if supertypes is not None else set()\n        self.keywords: Keyword = keywords if keywords is not None else Keyword(0)\n        self.rules_text: str = rules_text\n        # Snapshot original characteristics for continuous-effect reset.\n        self._original_card_types: frozenset[CardType] = frozenset(self.card_types)\n        self._original_keywords: Keyword = self.keywords\n\n    # ------------------------------------------------------------------\n    # Continuous-effect reset support\n    # ------------------------------------------------------------------\n\n    def _reset_characteristics(self) -> None:\n        \"\"\"Reset mutable characteristics to their original (pre-effect) values.\n\n        Called by :meth:`EffectManager.apply_all` before reapplying effects\n        so that the recalculation is idempotent.\n        \"\"\"\n        self.card_types = set(self._original_card_types)\n        self.keywords = self._original_keywords\n\n    # ------------------------------------------------------------------\n    # Hook methods — override in subclasses / card definitions\n    # ------------------------------------------------------------------\n\n    def can_cast(self, game: GameState) -> bool:\n        \"\"\"Return ``True`` if this card can currently be cast.\"\"\"\n        return True\n\n    def cost_reduction(self, game: GameState) -> int:\n        \"\"\"Return the generic mana reduction for casting this card.\n\n        Override in subclasses to implement cost-reduction mechanics\n        (e.g. Embercleave costs {1} less for each attacking creature).\n        The returned value is clamped so that generic mana cannot go below 0.\n        Only reduces generic mana — colored costs are never reduced.\n\n        Returns:\n            Non-negative integer representing generic mana to subtract.\n        \"\"\"\n        return 0\n\n    def on_cast(self, game: GameState) -> None:\n        \"\"\"Called when the card is cast (before it goes on the stack).\"\"\"\n\n    def on_resolve(self, game: GameState) -> None:\n        \"\"\"Called when the spell resolves from the stack.\n\n        Targets are available via ``self.chosen_targets`` — set at\n        resolve-time by :func:`~engine.casting._resolve_spell` from\n        :attr:`StackObject.targets`, or directly by test code.\n        \"\"\"\n\n    def get_targets(self, game: GameState) -> list[Any]:\n        \"\"\"Return a list of legal targets for this card.\"\"\"\n        return []\n\n    def register_triggers(self, game: GameState) -> None:\n        \"\"\"Register any triggered abilities this card provides.\"\"\"\n\n    def register_replacement_effects(self, game: GameState) -> None:\n        \"\"\"Register any replacement effects this card provides.\"\"\"\n\n    def get_activated_abilities(self) -> list[ActivatedAbility]:\n        \"\"\"Return activated abilities this card provides.\"\"\"\n        return []\n\n    def get_modes(self) -> list[Mode]:\n        \"\"\"Return available modes for modal spells/abilities.\n\n        Non-modal cards return an empty list by default.\n        \"\"\"\n        return []\n\n\n# ---------------------------------------------------------------------------\n# Creature\n# ---------------------------------------------------------------------------\n\nclass Creature(CardImpl):\n    \"\"\"A creature card.\n\n    Attributes:\n        base_power: The printed power value (rule 208.1). Immutable after init.\n        base_toughness: The printed toughness value. Immutable after init.\n        modified_power: Current power after continuous effects (Layer 7c), before counters.\n            Reset to ``base_power`` each effect cycle; continuous effects write here.\n        modified_toughness: Current toughness after continuous effects, before counters.\n        damage_marked: Amount of damage currently marked on this creature.\n        is_tapped: Whether the creature is tapped.\n        summoning_sick: Whether the creature has summoning sickness.\n        is_attacking: Combat flag — currently declared as an attacker.\n        is_blocking: Combat flag — currently declared as a blocker.\n        plus_one_counters: Number of +1/+1 counters.\n        minus_one_counters: Number of -1/-1 counters.\n        is_token: Whether this object is a token (for SBA checks).\n    \"\"\"\n\n    def __init__(\n        self,\n        name: str = \"\",\n        mana_cost: ManaCost | None = None,\n        card_types: set[CardType] | None = None,\n        subtypes: set[str] | None = None,\n        supertypes: set[Supertype] | None = None,\n        keywords: Keyword | None = None,\n        rules_text: str = \"\",\n        owner: Player | None = None,\n        controller: Player | None = None,\n        base_power: int = 0,\n        base_toughness: int = 0,\n    ) -> None:\n        # Always include CREATURE in card_types.\n        card_types = (card_types or set()) | {CardType.CREATURE}\n        super().__init__(\n            name=name,\n            mana_cost=mana_cost,\n            card_types=card_types,\n            subtypes=subtypes,\n            supertypes=supertypes,\n            keywords=keywords,\n            rules_text=rules_text,\n            owner=owner,\n            controller=controller,\n        )\n        self.base_power: int = base_power\n        self.base_toughness: int = base_toughness\n        self.modified_power: int = base_power\n        self.modified_toughness: int = base_toughness\n        self.damage_marked: int = 0\n        self.is_tapped: bool = False\n        self.summoning_sick: bool = True\n        self.is_attacking: bool = False\n        self.is_blocking: bool = False\n        self.plus_one_counters: int = 0\n        self.minus_one_counters: int = 0\n        self.is_token: bool = False\n        self.dealt_deathtouch_damage: bool = False\n        self._base_plus_one_counters: int = 0\n        self._base_minus_one_counters: int = 0\n\n    def _reset_characteristics(self) -> None:\n        \"\"\"Reset creature characteristics to pre-effect values.\"\"\"\n        super()._reset_characteristics()\n        self.modified_power = self.base_power\n        self.modified_toughness = self.base_toughness\n        self.plus_one_counters = self._base_plus_one_counters\n        self.minus_one_counters = self._base_minus_one_counters\n        # Reset combat-restriction flags set by continuous effects (e.g. Pacifism).\n        # These are reapplied by active effects during apply_all().\n        self._cant_attack: bool = False\n        self._cant_block: bool = False\n        self._cant_be_blocked: bool = False\n        self._cant_activate: bool = False\n        self._max_attackers_blocked: int = 1\n        # Clear granted protections so they are reapplied by active effects.\n        if hasattr(self, \"protections\"):\n            self.protections = []\n\n    @property\n    def counters(self) -> dict[str, int]:\n        \"\"\"Return a dict-like view of counters on this creature.\"\"\"\n        result: dict[str, int] = {}\n        if self.plus_one_counters > 0:\n            result[\"+1/+1\"] = self.plus_one_counters\n        if self.minus_one_counters > 0:\n            result[\"-1/-1\"] = self.minus_one_counters\n        return result\n\n    @property\n    def power(self) -> int:\n        \"\"\"Current power including counter modifications.\"\"\"\n        return self.modified_power + self.plus_one_counters - self.minus_one_counters\n\n    @property\n    def toughness(self) -> int:\n        \"\"\"Current toughness including counter modifications.\"\"\"\n        return self.modified_toughness + self.plus_one_counters - self.minus_one_counters\n\n\n# ---------------------------------------------------------------------------\n# Instant / Sorcery\n# ---------------------------------------------------------------------------\n\nclass Instant(CardImpl):\n    \"\"\"An instant spell — no extra fields beyond CardImpl.\"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.INSTANT}\n        super().__init__(**kwargs)\n\n\nclass Sorcery(CardImpl):\n    \"\"\"A sorcery spell — no extra fields beyond CardImpl.\"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.SORCERY}\n        super().__init__(**kwargs)\n\n\n# ---------------------------------------------------------------------------\n# Enchantment\n# ---------------------------------------------------------------------------\n\nclass Enchantment(CardImpl):\n    \"\"\"An enchantment card.\n\n    For auras, use the :class:`Aura` subclass which sets ``is_aura = True``.\n    The base ``Enchantment`` class retains the ``attached_to`` attribute for\n    backwards compatibility but marks ``is_aura = False`` so that state-based\n    actions do not treat a non-aura enchantment as an unattached aura.\n\n    Attributes:\n        attached_to: The object this enchantment is attached to (``None``\n            if not an aura or not yet attached).\n        is_aura: ``False`` for regular enchantments; ``True`` for auras.\n    \"\"\"\n\n    is_aura: bool = False\n\n    def __init__(self, attached_to: Any | None = None, **kwargs: Any) -> None:\n        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ENCHANTMENT}\n        super().__init__(**kwargs)\n        self.attached_to: Any | None = attached_to\n\n    def apply_continuous_effect(self, game: GameState) -> None:\n        \"\"\"Apply the enchantment's continuous effect to the game.\"\"\"\n\n    def on_enchant(self, game: GameState) -> None:\n        \"\"\"Called when this enchantment becomes attached to an object.\"\"\"\n\n    def on_detach(self, game: GameState) -> None:\n        \"\"\"Called when this enchantment is detached from its object.\"\"\"\n\n\nclass Aura(Enchantment):\n    \"\"\"An Aura enchantment — attaches to a permanent on the battlefield.\n\n    Sets ``is_aura = True`` so that state-based actions correctly identify\n    this as an aura (and move it to the graveyard when unattached).\n\n    Attributes:\n        is_aura: Always ``True`` for auras.\n    \"\"\"\n\n    is_aura: bool = True\n\n    def __init__(self, attached_to: Any | None = None, **kwargs: Any) -> None:\n        super().__init__(attached_to=attached_to, **kwargs)\n\n\n# ---------------------------------------------------------------------------\n# Artifact / ArtifactCreature\n# ---------------------------------------------------------------------------\n\nclass Artifact(CardImpl):\n    \"\"\"An artifact card.\n\n    Attributes:\n        is_tapped: Whether the artifact is currently tapped.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ARTIFACT}\n        super().__init__(**kwargs)\n        self.is_tapped: bool = False\n\n\nclass ArtifactCreature(Creature):\n    \"\"\"An artifact creature — combines Artifact and Creature types.\n\n    Inherits creature combat stats and behaviour from :class:`Creature`.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ARTIFACT, CardType.CREATURE}\n        super().__init__(**kwargs)\n\n\n# ---------------------------------------------------------------------------\n# Planeswalker\n# ---------------------------------------------------------------------------\n\nclass Planeswalker(CardImpl):\n    \"\"\"A planeswalker card.\n\n    Attributes:\n        starting_loyalty: The starting loyalty printed on the card.\n        loyalty: Current loyalty counter value.\n    \"\"\"\n\n    def __init__(\n        self,\n        starting_loyalty: int = 0,\n        **kwargs: Any,\n    ) -> None:\n        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.PLANESWALKER}\n        super().__init__(**kwargs)\n        self.starting_loyalty: int = starting_loyalty\n        self.loyalty: int = starting_loyalty\n\n    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n        \"\"\"Return the planeswalker's loyalty abilities.\"\"\"\n        return []\n\n\n# ---------------------------------------------------------------------------\n# Land\n# ---------------------------------------------------------------------------\n\nclass Land(CardImpl):\n    \"\"\"A land card.\n\n    Lands are not cast — they are played via a special action. ``can_cast``\n    always returns ``False``.\n\n    Attributes:\n        is_tapped: Whether the land is currently tapped.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.LAND}\n        super().__init__(**kwargs)\n        self.is_tapped: bool = False\n\n    def can_cast(self, game: GameState) -> bool:\n        \"\"\"Lands cannot be cast; they are played as a special action.\"\"\"\n        return False\n\n    def get_mana_abilities(self) -> list[ManaAbility]:\n        \"\"\"Return the land's mana abilities.\"\"\"\n        return []\n","numLines":502,"startLine":1,"totalLines":502}}}
