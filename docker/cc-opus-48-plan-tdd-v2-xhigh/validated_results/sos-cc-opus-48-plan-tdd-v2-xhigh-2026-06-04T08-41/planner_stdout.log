{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VLZXJsuXFk6pJDaNsF7Twx","type":"tool_result","content":"1\t\"\"\"Activated abilities system — tap-for-mana, loyalty abilities, and general\n2\tactivated abilities that go on the stack (or resolve immediately for mana\n3\tabilities).\n4\t\n5\tProvides:\n6\t\n7\t- :func:`activate_ability` — verify timing → pay costs → resolve immediately\n8\t  (mana abilities) or push to the stack (non-mana abilities).\n9\t- :func:`tap_cost` — generic tap-cost helper: checks ``not source.is_tapped``\n10\t  and taps the source.\n11\t- :class:`ActivatedAbilityInstance` — a runtime representation of an activated\n12\t  ability with source, controller, cost/effect callables, and metadata.\n13\t- :class:`LoyaltyAbilityInstance` — activated ability variant for planeswalker\n14\t  loyalty abilities with per-turn restriction and loyalty-counter cost.\n15\t\"\"\"\n16\t\n17\tfrom __future__ import annotations\n18\t\n19\tfrom dataclasses import dataclass, field\n20\tfrom typing import TYPE_CHECKING, Any, Callable\n21\t\n22\tfrom engine.casting import is_sorcery_speed\n23\tfrom engine.stack import StackObject\n24\t\n25\tif TYPE_CHECKING:\n26\t    from engine.game_state import GameState\n27\t    from engine.player import Player\n28\t\n29\t\n30\tclass AbilityError(Exception):\n31\t    \"\"\"Raised when an ability activation is illegal.\"\"\"\n32\t\n33\t\n34\t# ---------------------------------------------------------------------------\n35\t# Runtime ability representations\n36\t# ---------------------------------------------------------------------------\n37\t\n38\t@dataclass\n39\tclass ActivatedAbilityInstance:\n40\t    \"\"\"Runtime representation of an activated ability.\n41\t\n42\t    This captures everything needed to activate and resolve an ability:\n43\t    the source permanent, the controlling player, cost/effect callables,\n44\t    and whether the ability is a mana ability.\n45\t\n46\t    Attributes:\n47\t        source: The permanent that has this ability.\n48\t        controller: The player who controls the source.\n49\t        cost: A callable ``(game, source) -> bool`` that checks and pays\n50\t            the cost. Returns ``True`` if the cost was successfully paid,\n51\t            ``False`` otherwise.\n52\t        effect: A callable ``(game) -> None`` that applies the ability's\n53\t            effect when it resolves.\n54\t        is_mana_ability: Whether this is a mana ability (resolves\n55\t            immediately without using the stack).\n56\t        description: Human-readable description of the ability.\n57\t    \"\"\"\n58\t\n59\t    source: Any\n60\t    controller: Any  # Player\n61\t    cost: Callable[..., bool]\n62\t    effect: Callable[..., None]\n63\t    is_mana_ability: bool = False\n64\t    description: str = \"\"\n65\t\n66\t\n67\t@dataclass\n68\tclass LoyaltyAbilityInstance:\n69\t    \"\"\"Runtime representation of a planeswalker loyalty ability.\n70\t\n71\t    Loyalty abilities are activated abilities with special restrictions:\n72\t    they may only be activated at sorcery speed, and only once per turn\n73\t    per source (tracked via ``_activated_this_turn``).\n74\t\n75\t    The cost adjusts the loyalty counters on the source planeswalker.\n76\t\n77\t    Attributes:\n78\t        source: The planeswalker permanent.\n79\t        controller: The player who controls the planeswalker.\n80\t        loyalty_cost: The loyalty adjustment (positive for ``+N``,\n81\t            negative for ``−N``, zero for ``0``).\n82\t        effect: A callable ``(game) -> None`` for the ability's effect.\n83\t        description: Human-readable description.\n84\t    \"\"\"\n85\t\n86\t    source: Any\n87\t    controller: Any  # Player\n88\t    loyalty_cost: int = 0\n89\t    effect: Callable[..., None] = field(default=lambda _game: None)\n90\t    description: str = \"\"\n91\t\n92\t\n93\t# ---------------------------------------------------------------------------\n94\t# Per-turn loyalty tracking\n95\t# ---------------------------------------------------------------------------\n96\t\n97\t# Set of (object_id, turn_number) pairs that have already activated a\n98\t# loyalty ability this turn.  Callers should call\n99\t# ``clear_loyalty_tracking()`` at the start of each turn or manage the\n100\t# set externally.\n101\t_loyalty_activated_this_turn: set[tuple[int, int]] = set()\n102\t\n103\t\n104\tdef clear_loyalty_tracking() -> None:\n105\t    \"\"\"Clear the loyalty-activated-this-turn tracker.\n106\t\n107\t    Should be called at the start of each turn so that planeswalkers may\n108\t    activate loyalty abilities again.\n109\t    \"\"\"\n110\t    _loyalty_activated_this_turn.clear()\n111\t\n112\t\n113\tdef _has_activated_loyalty_this_turn(source: Any, turn_number: int) -> bool:\n114\t    \"\"\"Return ``True`` if *source* already used a loyalty ability this turn.\"\"\"\n115\t    obj_id = getattr(source, \"object_id\", id(source))\n116\t    return (obj_id, turn_number) in _loyalty_activated_this_turn\n117\t\n118\t\n119\tdef _mark_loyalty_activated(source: Any, turn_number: int) -> None:\n120\t    \"\"\"Record that *source* used a loyalty ability this turn.\"\"\"\n121\t    obj_id = getattr(source, \"object_id\", id(source))\n122\t    _loyalty_activated_this_turn.add((obj_id, turn_number))\n123\t\n124\t\n125\t# ---------------------------------------------------------------------------\n126\t# Tap cost helper\n127\t# ---------------------------------------------------------------------------\n128\t\n129\tdef tap_cost(game: GameState, source: Any) -> bool:\n130\t    \"\"\"Generic tap-cost function.\n131\t\n132\t    Checks that the source is not already tapped.  If untapped, taps it\n133\t    (sets ``source.is_tapped = True``) and returns ``True``.  If already\n134\t    tapped, returns ``False`` (cost cannot be paid).\n135\t\n136\t    Parameters:\n137\t        game: The current game state (unused here but kept for a\n138\t            consistent ``(game, source) -> bool`` cost signature).\n139\t        source: The permanent to tap.\n140\t\n141\t    Returns:\n142\t        ``True`` if the cost was successfully paid (source was untapped\n143\t        and is now tapped), ``False`` otherwise.\n144\t    \"\"\"\n145\t    if getattr(source, \"is_tapped\", False):\n146\t        return False\n147\t    source.is_tapped = True\n148\t    return True\n149\t\n150\t\n151\t# ---------------------------------------------------------------------------\n152\t# Activate ability — main entry point\n153\t# ---------------------------------------------------------------------------\n154\t\n155\tdef activate_ability(\n156\t    game: GameState,\n157\t    player: Any,  # Player\n158\t    ability: ActivatedAbilityInstance | LoyaltyAbilityInstance,\n159\t) -> None:\n160\t    \"\"\"Activate an ability.\n161\t\n162\t    Pipeline\n163\t    --------\n164\t    1. **Timing check** — mana abilities bypass timing entirely and\n165\t       resolve immediately.  Regular (non-mana) activated abilities\n166\t       can be activated whenever a player has priority (instant speed);\n167\t       priority enforcement is handled externally by\n168\t       ``priority_loop``, not here.  **Only loyalty abilities** carry\n169\t       a sorcery-speed restriction.\n170\t    2. **Pay costs** — invoke the ability's cost callable.  For loyalty\n171\t       abilities, adjust loyalty counters and enforce once-per-turn.\n172\t    3. **Resolve or push to stack** — mana abilities resolve\n173\t       immediately; all other abilities are pushed onto the game stack\n174\t       as :class:`StackObject` instances.\n175\t\n176\t    Parameters:\n177\t        game: The current game state.\n178\t        player: The player activating the ability.\n179\t        ability: The ability to activate (an\n180\t            :class:`ActivatedAbilityInstance` or\n181\t            :class:`LoyaltyAbilityInstance`).\n182\t\n183\t    Raises:\n184\t        AbilityError: If the activation is illegal (timing, cost, or\n185\t            once-per-turn restriction).\n186\t    \"\"\"\n187\t    if isinstance(ability, LoyaltyAbilityInstance):\n188\t        _activate_loyalty_ability(game, player, ability)\n189\t    elif isinstance(ability, ActivatedAbilityInstance):\n190\t        _activate_regular_ability(game, player, ability)\n191\t    else:\n192\t        raise AbilityError(f\"Unknown ability type: {type(ability)}\")\n193\t\n194\t\n195\t# ---------------------------------------------------------------------------\n196\t# Internal helpers\n197\t# ---------------------------------------------------------------------------\n198\t\n199\tdef _activate_regular_ability(\n200\t    game: GameState,\n201\t    player: Any,\n202\t    ability: ActivatedAbilityInstance,\n203\t) -> None:\n204\t    \"\"\"Activate a regular (non-loyalty) activated ability.\"\"\"\n205\t    # 1. Check \"can't activate\" restriction (e.g. Arrest).\n206\t    if getattr(ability.source, \"_cant_activate\", False):\n207\t        raise AbilityError(\n208\t            \"Cannot activate ability — source's activated abilities are suppressed\"\n209\t        )\n210\t\n211\t    # 2. Pay costs\n212\t    cost_paid = ability.cost(game, ability.source)\n213\t    if not cost_paid:\n214\t        raise AbilityError(\"Cannot activate ability — cost could not be paid\")\n215\t\n216\t    # 3. Resolve or push\n217\t    if ability.is_mana_ability:\n218\t        # Mana abilities resolve immediately without using the stack.\n219\t        ability.effect(game)\n220\t    else:\n221\t        # Push to stack for resolution.\n222\t        stack_obj = StackObject(\n223\t            source=ability.source,\n224\t            controller=player,\n225\t            on_resolve=ability.effect,\n226\t            is_mana_ability=False,\n227\t        )\n228\t        game.stack.push(stack_obj)\n229\t\n230\t\n231\tdef _activate_loyalty_ability(\n232\t    game: GameState,\n233\t    player: Any,\n234\t    ability: LoyaltyAbilityInstance,\n235\t) -> None:\n236\t    \"\"\"Activate a planeswalker loyalty ability.\"\"\"\n237\t    source = ability.source\n238\t\n239\t    # 1. Timing — loyalty abilities are sorcery speed only.\n240\t    if not is_sorcery_speed(game, player):\n241\t        raise AbilityError(\n242\t            \"Cannot activate loyalty ability — sorcery-speed timing not met\"\n243\t        )\n244\t\n245\t    # 2. Once-per-turn restriction.\n246\t    turn_number = getattr(game, \"turn_number\", 0)\n247\t    if _has_activated_loyalty_this_turn(source, turn_number):\n248\t        raise AbilityError(\n249\t            \"Cannot activate loyalty ability — already activated this turn\"\n250\t        )\n251\t\n252\t    # 3. Pay loyalty cost.\n253\t    current_loyalty = getattr(source, \"loyalty\", 0)\n254\t    new_loyalty = current_loyalty + ability.loyalty_cost\n255\t    if new_loyalty < 0:\n256\t        raise AbilityError(\n257\t            f\"Cannot activate loyalty ability — insufficient loyalty \"\n258\t            f\"(have {current_loyalty}, need {-ability.loyalty_cost})\"\n259\t        )\n260\t    source.loyalty = new_loyalty\n261\t\n262\t    # 4. Mark as activated this turn.\n263\t    _mark_loyalty_activated(source, turn_number)\n264\t\n265\t    # 5. Push to stack.\n266\t    stack_obj = StackObject(\n267\t        source=source,\n268\t        controller=player,\n269\t        on_resolve=ability.effect,\n270\t        is_mana_ability=False,\n271\t    )\n272\t    game.stack.push(stack_obj)\n273\t"}]},"parent_tool_use_id":null,"session_id":"a1b7c704-d004-4a3e-ade9-c0cdca9e5add","uuid":"12789654-ace7-4994-be36-623a420b7cb5","timestamp":"2026-06-04T08:42:58.147Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/abilities.py","content":"\"\"\"Activated abilities system — tap-for-mana, loyalty abilities, and general\nactivated abilities that go on the stack (or resolve immediately for mana\nabilities).\n\nProvides:\n\n- :func:`activate_ability` — verify timing → pay costs → resolve immediately\n  (mana abilities) or push to the stack (non-mana abilities).\n- :func:`tap_cost` — generic tap-cost helper: checks ``not source.is_tapped``\n  and taps the source.\n- :class:`ActivatedAbilityInstance` — a runtime representation of an activated\n  ability with source, controller, cost/effect callables, and metadata.\n- :class:`LoyaltyAbilityInstance` — activated ability variant for planeswalker\n  loyalty abilities with per-turn restriction and loyalty-counter cost.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom typing import TYPE_CHECKING, Any, Callable\n\nfrom engine.casting import is_sorcery_speed\nfrom engine.stack import StackObject\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\nclass AbilityError(Exception):\n    \"\"\"Raised when an ability activation is illegal.\"\"\"\n\n\n# ---------------------------------------------------------------------------\n# Runtime ability representations\n# ---------------------------------------------------------------------------\n\n@dataclass\nclass ActivatedAbilityInstance:\n    \"\"\"Runtime representation of an activated ability.\n\n    This captures everything needed to activate and resolve an ability:\n    the source permanent, the controlling player, cost/effect callables,\n    and whether the ability is a mana ability.\n\n    Attributes:\n        source: The permanent that has this ability.\n        controller: The player who controls the source.\n        cost: A callable ``(game, source) -> bool`` that checks and pays\n            the cost. Returns ``True`` if the cost was successfully paid,\n            ``False`` otherwise.\n        effect: A callable ``(game) -> None`` that applies the ability's\n            effect when it resolves.\n        is_mana_ability: Whether this is a mana ability (resolves\n            immediately without using the stack).\n        description: Human-readable description of the ability.\n    \"\"\"\n\n    source: Any\n    controller: Any  # Player\n    cost: Callable[..., bool]\n    effect: Callable[..., None]\n    is_mana_ability: bool = False\n    description: str = \"\"\n\n\n@dataclass\nclass LoyaltyAbilityInstance:\n    \"\"\"Runtime representation of a planeswalker loyalty ability.\n\n    Loyalty abilities are activated abilities with special restrictions:\n    they may only be activated at sorcery speed, and only once per turn\n    per source (tracked via ``_activated_this_turn``).\n\n    The cost adjusts the loyalty counters on the source planeswalker.\n\n    Attributes:\n        source: The planeswalker permanent.\n        controller: The player who controls the planeswalker.\n        loyalty_cost: The loyalty adjustment (positive for ``+N``,\n            negative for ``−N``, zero for ``0``).\n        effect: A callable ``(game) -> None`` for the ability's effect.\n        description: Human-readable description.\n    \"\"\"\n\n    source: Any\n    controller: Any  # Player\n    loyalty_cost: int = 0\n    effect: Callable[..., None] = field(default=lambda _game: None)\n    description: str = \"\"\n\n\n# ---------------------------------------------------------------------------\n# Per-turn loyalty tracking\n# ---------------------------------------------------------------------------\n\n# Set of (object_id, turn_number) pairs that have already activated a\n# loyalty ability this turn.  Callers should call\n# ``clear_loyalty_tracking()`` at the start of each turn or manage the\n# set externally.\n_loyalty_activated_this_turn: set[tuple[int, int]] = set()\n\n\ndef clear_loyalty_tracking() -> None:\n    \"\"\"Clear the loyalty-activated-this-turn tracker.\n\n    Should be called at the start of each turn so that planeswalkers may\n    activate loyalty abilities again.\n    \"\"\"\n    _loyalty_activated_this_turn.clear()\n\n\ndef _has_activated_loyalty_this_turn(source: Any, turn_number: int) -> bool:\n    \"\"\"Return ``True`` if *source* already used a loyalty ability this turn.\"\"\"\n    obj_id = getattr(source, \"object_id\", id(source))\n    return (obj_id, turn_number) in _loyalty_activated_this_turn\n\n\ndef _mark_loyalty_activated(source: Any, turn_number: int) -> None:\n    \"\"\"Record that *source* used a loyalty ability this turn.\"\"\"\n    obj_id = getattr(source, \"object_id\", id(source))\n    _loyalty_activated_this_turn.add((obj_id, turn_number))\n\n\n# ---------------------------------------------------------------------------\n# Tap cost helper\n# ---------------------------------------------------------------------------\n\ndef tap_cost(game: GameState, source: Any) -> bool:\n    \"\"\"Generic tap-cost function.\n\n    Checks that the source is not already tapped.  If untapped, taps it\n    (sets ``source.is_tapped = True``) and returns ``True``.  If already\n    tapped, returns ``False`` (cost cannot be paid).\n\n    Parameters:\n        game: The current game state (unused here but kept for a\n            consistent ``(game, source) -> bool`` cost signature).\n        source: The permanent to tap.\n\n    Returns:\n        ``True`` if the cost was successfully paid (source was untapped\n        and is now tapped), ``False`` otherwise.\n    \"\"\"\n    if getattr(source, \"is_tapped\", False):\n        return False\n    source.is_tapped = True\n    return True\n\n\n# ---------------------------------------------------------------------------\n# Activate ability — main entry point\n# ---------------------------------------------------------------------------\n\ndef activate_ability(\n    game: GameState,\n    player: Any,  # Player\n    ability: ActivatedAbilityInstance | LoyaltyAbilityInstance,\n) -> None:\n    \"\"\"Activate an ability.\n\n    Pipeline\n    --------\n    1. **Timing check** — mana abilities bypass timing entirely and\n       resolve immediately.  Regular (non-mana) activated abilities\n       can be activated whenever a player has priority (instant speed);\n       priority enforcement is handled externally by\n       ``priority_loop``, not here.  **Only loyalty abilities** carry\n       a sorcery-speed restriction.\n    2. **Pay costs** — invoke the ability's cost callable.  For loyalty\n       abilities, adjust loyalty counters and enforce once-per-turn.\n    3. **Resolve or push to stack** — mana abilities resolve\n       immediately; all other abilities are pushed onto the game stack\n       as :class:`StackObject` instances.\n\n    Parameters:\n        game: The current game state.\n        player: The player activating the ability.\n        ability: The ability to activate (an\n            :class:`ActivatedAbilityInstance` or\n            :class:`LoyaltyAbilityInstance`).\n\n    Raises:\n        AbilityError: If the activation is illegal (timing, cost, or\n            once-per-turn restriction).\n    \"\"\"\n    if isinstance(ability, LoyaltyAbilityInstance):\n        _activate_loyalty_ability(game, player, ability)\n    elif isinstance(ability, ActivatedAbilityInstance):\n        _activate_regular_ability(game, player, ability)\n    else:\n        raise AbilityError(f\"Unknown ability type: {type(ability)}\")\n\n\n# ---------------------------------------------------------------------------\n# Internal helpers\n# ---------------------------------------------------------------------------\n\ndef _activate_regular_ability(\n    game: GameState,\n    player: Any,\n    ability: ActivatedAbilityInstance,\n) -> None:\n    \"\"\"Activate a regular (non-loyalty) activated ability.\"\"\"\n    # 1. Check \"can't activate\" restriction (e.g. Arrest).\n    if getattr(ability.source, \"_cant_activate\", False):\n        raise AbilityError(\n            \"Cannot activate ability — source's activated abilities are suppressed\"\n        )\n\n    # 2. Pay costs\n    cost_paid = ability.cost(game, ability.source)\n    if not cost_paid:\n        raise AbilityError(\"Cannot activate ability — cost could not be paid\")\n\n    # 3. Resolve or push\n    if ability.is_mana_ability:\n        # Mana abilities resolve immediately without using the stack.\n        ability.effect(game)\n    else:\n        # Push to stack for resolution.\n        stack_obj = StackObject(\n            source=ability.source,\n            controller=player,\n            on_resolve=ability.effect,\n            is_mana_ability=False,\n        )\n        game.stack.push(stack_obj)\n\n\ndef _activate_loyalty_ability(\n    game: GameState,\n    player: Any,\n    ability: LoyaltyAbilityInstance,\n) -> None:\n    \"\"\"Activate a planeswalker loyalty ability.\"\"\"\n    source = ability.source\n\n    # 1. Timing — loyalty abilities are sorcery speed only.\n    if not is_sorcery_speed(game, player):\n        raise AbilityError(\n            \"Cannot activate loyalty ability — sorcery-speed timing not met\"\n        )\n\n    # 2. Once-per-turn restriction.\n    turn_number = getattr(game, \"turn_number\", 0)\n    if _has_activated_loyalty_this_turn(source, turn_number):\n        raise AbilityError(\n            \"Cannot activate loyalty ability — already activated this turn\"\n        )\n\n    # 3. Pay loyalty cost.\n    current_loyalty = getattr(source, \"loyalty\", 0)\n    new_loyalty = current_loyalty + ability.loyalty_cost\n    if new_loyalty < 0:\n        raise AbilityError(\n            f\"Cannot activate loyalty ability — insufficient loyalty \"\n            f\"(have {current_loyalty}, need {-ability.loyalty_cost})\"\n        )\n    source.loyalty = new_loyalty\n\n    # 4. Mark as activated this turn.\n    _mark_loyalty_activated(source, turn_number)\n\n    # 5. Push to stack.\n    stack_obj = StackObject(\n        source=source,\n        controller=player,\n        on_resolve=ability.effect,\n        is_mana_ability=False,\n    )\n    game.stack.push(stack_obj)\n","numLines":273,"startLine":1,"totalLines":273}}}
