{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AJwxGCtj942ezQmwjcQdHm","type":"tool_result","content":"1\t\"\"\"Continuous effects and the 7-layer system.\n2\t\n3\tImplements the MTG layer system (rule 613) for applying continuous effects\n4\tin the correct order. Effects are applied in layer order, and within the\n5\tsame layer/sublayer, in timestamp order.\n6\t\n7\tPhase 1 scope:\n8\t  - Layers 4 (type-changing), 6 (ability granting/removing), 7c (P/T\n9\t    modifications), and 7d (P/T from counters) are fully functional.\n10\t  - Layers 1 (copy), 2 (control), 3 (text), and 5 (color) are stubs\n11\t    that iterate effects but delegate to their ``apply`` callables.\n12\t\"\"\"\n13\t\n14\tfrom __future__ import annotations\n15\t\n16\timport enum\n17\tfrom dataclasses import dataclass, field\n18\tfrom typing import TYPE_CHECKING, Any, Callable\n19\t\n20\tif TYPE_CHECKING:\n21\t    from engine.game_state import GameState\n22\t\n23\t\n24\tclass Layer(enum.IntEnum):\n25\t    \"\"\"The 7 layers for applying continuous effects (rule 613).\n26\t\n27\t    Using IntEnum so that effects are naturally sorted by layer order.\n28\t    \"\"\"\n29\t\n30\t    COPY = 1\n31\t    CONTROL = 2\n32\t    TEXT = 3\n33\t    TYPE = 4\n34\t    COLOR = 5\n35\t    ABILITY = 6\n36\t    POWER_TOUGHNESS = 7\n37\t\n38\t\n39\tclass SubLayer(enum.Enum):\n40\t    \"\"\"Sub-layers for layer 7 (power/toughness) effects.\n41\t\n42\t    Per rule 613.4:\n43\t      - 7a: Characteristic-defining abilities that set P/T.\n44\t      - 7b: Effects that set P/T to specific values.\n45\t      - 7c: Effects that modify P/T (e.g. +2/+2).\n46\t      - 7d: P/T changes from counters.\n47\t    \"\"\"\n48\t\n49\t    CHARACTERISTIC_DEFINING = \"7a\"\n50\t    SET_PT = \"7b\"\n51\t    MODIFY_PT = \"7c\"\n52\t    COUNTERS = \"7d\"\n53\t\n54\t\n55\t# Duration constants — sentinels for ContinuousEffect.duration.\n56\tDURATION_PERMANENT = -1\n57\t\"\"\"The effect lasts as long as its source is on the battlefield.\"\"\"\n58\t\n59\tDURATION_END_OF_TURN = 0\n60\t\"\"\"The effect lasts until end of turn (removed during cleanup).\"\"\"\n61\t\n62\t\n63\t@dataclass\n64\tclass ContinuousEffect:\n65\t    \"\"\"A single continuous effect in the layer system.\n66\t\n67\t    Attributes:\n68\t        source: The game object that creates this effect.\n69\t        layer: Which of the 7 layers this effect belongs to.\n70\t        sublayer: Sub-layer within layer 7 (``None`` for layers 1–6).\n71\t        apply: Callable ``(game: GameState) -> None`` that applies the effect.\n72\t        timestamp: Monotonically increasing integer for ordering effects\n73\t            within the same layer. Lower timestamp means earlier.\n74\t        duration: How long the effect lasts.  Use :data:`DURATION_PERMANENT`\n75\t            for static abilities, :data:`DURATION_END_OF_TURN` for until-EOT\n76\t            effects, or a positive integer representing the turn number\n77\t            on which the effect expires (removed when\n78\t            ``game.turn_number > duration``).\n79\t    \"\"\"\n80\t\n81\t    source: Any\n82\t    layer: Layer\n83\t    sublayer: SubLayer | None = None\n84\t    apply: Callable[..., Any] = field(default=lambda _game: None)\n85\t    timestamp: int = 0\n86\t    duration: int = DURATION_PERMANENT\n87\t\n88\t    def _sort_key(self) -> tuple[int, int, int]:\n89\t        \"\"\"Return a sort key: (layer, sublayer-ordinal, timestamp).\n90\t\n91\t        Effects are sorted first by layer, then by sublayer (for layer 7),\n92\t        then by timestamp within the same (layer, sublayer).\n93\t        \"\"\"\n94\t        sublayer_order = _SUBLAYER_ORDER.get(self.sublayer, 0) if self.sublayer else 0\n95\t        return (self.layer.value, sublayer_order, self.timestamp)\n96\t\n97\t\n98\t# Map SubLayer values to a numeric ordering so 7a < 7b < 7c < 7d.\n99\t_SUBLAYER_ORDER: dict[SubLayer, int] = {\n100\t    SubLayer.CHARACTERISTIC_DEFINING: 1,\n101\t    SubLayer.SET_PT: 2,\n102\t    SubLayer.MODIFY_PT: 3,\n103\t    SubLayer.COUNTERS: 4,\n104\t}\n105\t\n106\t\n107\tclass EffectManager:\n108\t    \"\"\"Manages all active continuous effects and applies them in layer order.\n109\t\n110\t    The manager holds a list of :class:`ContinuousEffect` objects and provides\n111\t    methods to add, remove expired effects, and apply them all to the game\n112\t    state in the correct layer/timestamp order.\n113\t    \"\"\"\n114\t\n115\t    def __init__(self) -> None:\n116\t        self._effects: list[ContinuousEffect] = []\n117\t        self._next_timestamp: int = 1\n118\t\n119\t    # ------------------------------------------------------------------\n120\t    # Public API\n121\t    # ------------------------------------------------------------------\n122\t\n123\t    def add(self, effect: ContinuousEffect) -> ContinuousEffect:\n124\t        \"\"\"Add a continuous effect, auto-assigning a timestamp if it's 0.\n125\t\n126\t        Args:\n127\t            effect: The effect to register.\n128\t\n129\t        Returns:\n130\t            The effect (with timestamp populated).\n131\t        \"\"\"\n132\t        if effect.timestamp == 0:\n133\t            effect.timestamp = self._next_timestamp\n134\t            self._next_timestamp += 1\n135\t        else:\n136\t            # Keep _next_timestamp ahead of any manually assigned timestamps.\n137\t            if effect.timestamp >= self._next_timestamp:\n138\t                self._next_timestamp = effect.timestamp + 1\n139\t        self._effects.append(effect)\n140\t        return effect\n141\t\n142\t    def remove(self, effect: ContinuousEffect) -> bool:\n143\t        \"\"\"Remove a specific effect by identity.\n144\t\n145\t        Returns:\n146\t            ``True`` if the effect was found and removed, ``False`` otherwise.\n147\t        \"\"\"\n148\t        for i, e in enumerate(self._effects):\n149\t            if e is effect:\n150\t                self._effects.pop(i)\n151\t                return True\n152\t        return False\n153\t\n154\t    def remove_expired(self, game: GameState) -> int:\n155\t        \"\"\"Remove effects whose duration has expired.\n156\t\n157\t        - ``DURATION_PERMANENT`` (−1): never expires automatically.\n158\t        - ``DURATION_END_OF_TURN`` (0): removed when this method is called\n159\t          (typically during the cleanup step).\n160\t        - Positive integer *n*: removed when ``game.turn_number > n``.\n161\t\n162\t        Args:\n163\t            game: The current game state (used for turn number).\n164\t\n165\t        Returns:\n166\t            The number of effects removed.\n167\t        \"\"\"\n168\t        before = len(self._effects)\n169\t        remaining: list[ContinuousEffect] = []\n170\t        for eff in self._effects:\n171\t            if eff.duration == DURATION_PERMANENT:\n172\t                remaining.append(eff)\n173\t            elif eff.duration == DURATION_END_OF_TURN:\n174\t                # End-of-turn effects are swept away.\n175\t                continue\n176\t            elif game.turn_number > eff.duration:\n177\t                # Turn-numbered expiry.\n178\t                continue\n179\t            else:\n180\t                remaining.append(eff)\n181\t        self._effects = remaining\n182\t        return before - len(self._effects)\n183\t\n184\t    def apply_all(self, game: GameState) -> None:\n185\t        \"\"\"Apply all active effects in layer order, then timestamp order.\n186\t\n187\t        Before applying, all objects on each player's battlefield are reset\n188\t        to their original (pre-effect) characteristics so that calling this\n189\t        method multiple times is idempotent.\n190\t\n191\t        Within each layer (and sublayer for layer 7), effects are applied\n192\t        in timestamp order.  This method should be called whenever the\n193\t        game state needs a fresh recalculation of continuous effects —\n194\t        for example, after state-based actions or any game event that\n195\t        could change the set of applicable effects.\n196\t        \"\"\"\n197\t        # Reset battlefield objects to their base characteristics so that\n198\t        # reapplying effects does not accumulate on top of stale mutations.\n199\t        self._reset_objects(game)\n200\t\n201\t        sorted_effects = sorted(self._effects, key=lambda e: e._sort_key())\n202\t        for effect in sorted_effects:\n203\t            effect.apply(game)\n204\t\n205\t    # ------------------------------------------------------------------\n206\t    # Internal helpers\n207\t    # ------------------------------------------------------------------\n208\t\n209\t    def _reset_objects(self, game: GameState) -> None:\n210\t        \"\"\"Reset all battlefield objects to their original characteristics.\n211\t\n212\t        Iterates over every player's battlefield and calls\n213\t        ``_reset_characteristics()`` on any object that supports it\n214\t        (i.e. :class:`~engine.card.CardImpl` and its subclasses).\n215\t        \"\"\"\n216\t        for player in game.players:\n217\t            for obj in game.get_battlefield(player).get_all():\n218\t                reset = getattr(obj, \"_reset_characteristics\", None)\n219\t                if callable(reset):\n220\t                    reset()\n221\t\n222\t    # ------------------------------------------------------------------\n223\t    # Query helpers\n224\t    # ------------------------------------------------------------------\n225\t\n226\t    @property\n227\t    def effects(self) -> list[ContinuousEffect]:\n228\t        \"\"\"Return a shallow copy of the current effects list.\"\"\"\n229\t        return list(self._effects)\n230\t\n231\t    def get_all(self) -> list[ContinuousEffect]:\n232\t        \"\"\"Return a shallow copy of the current effects list.\"\"\"\n233\t        return list(self._effects)\n234\t\n235\t    def get_effects_for_layer(self, layer: Layer) -> list[ContinuousEffect]:\n236\t        \"\"\"Return effects belonging to a specific layer, in timestamp order.\"\"\"\n237\t        return sorted(\n238\t            [e for e in self._effects if e.layer == layer],\n239\t            key=lambda e: e._sort_key(),\n240\t        )\n241\t\n242\t    def get_effects_by_source(self, source: Any) -> list[ContinuousEffect]:\n243\t        \"\"\"Return all effects created by a given source object.\"\"\"\n244\t        return [e for e in self._effects if e.source is source]\n245\t\n246\t    def clear(self) -> None:\n247\t        \"\"\"Remove all effects.\"\"\"\n248\t        self._effects.clear()\n249\t\n250\t    def __len__(self) -> int:\n251\t        return len(self._effects)\n252\t"}]},"parent_tool_use_id":null,"session_id":"a1b7c704-d004-4a3e-ade9-c0cdca9e5add","uuid":"6c9206d0-873d-4cbe-b13b-1cfb79f5bd73","timestamp":"2026-06-04T08:43:20.759Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/continuous_effects.py","content":"\"\"\"Continuous effects and the 7-layer system.\n\nImplements the MTG layer system (rule 613) for applying continuous effects\nin the correct order. Effects are applied in layer order, and within the\nsame layer/sublayer, in timestamp order.\n\nPhase 1 scope:\n  - Layers 4 (type-changing), 6 (ability granting/removing), 7c (P/T\n    modifications), and 7d (P/T from counters) are fully functional.\n  - Layers 1 (copy), 2 (control), 3 (text), and 5 (color) are stubs\n    that iterate effects but delegate to their ``apply`` callables.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport enum\nfrom dataclasses import dataclass, field\nfrom typing import TYPE_CHECKING, Any, Callable\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\nclass Layer(enum.IntEnum):\n    \"\"\"The 7 layers for applying continuous effects (rule 613).\n\n    Using IntEnum so that effects are naturally sorted by layer order.\n    \"\"\"\n\n    COPY = 1\n    CONTROL = 2\n    TEXT = 3\n    TYPE = 4\n    COLOR = 5\n    ABILITY = 6\n    POWER_TOUGHNESS = 7\n\n\nclass SubLayer(enum.Enum):\n    \"\"\"Sub-layers for layer 7 (power/toughness) effects.\n\n    Per rule 613.4:\n      - 7a: Characteristic-defining abilities that set P/T.\n      - 7b: Effects that set P/T to specific values.\n      - 7c: Effects that modify P/T (e.g. +2/+2).\n      - 7d: P/T changes from counters.\n    \"\"\"\n\n    CHARACTERISTIC_DEFINING = \"7a\"\n    SET_PT = \"7b\"\n    MODIFY_PT = \"7c\"\n    COUNTERS = \"7d\"\n\n\n# Duration constants — sentinels for ContinuousEffect.duration.\nDURATION_PERMANENT = -1\n\"\"\"The effect lasts as long as its source is on the battlefield.\"\"\"\n\nDURATION_END_OF_TURN = 0\n\"\"\"The effect lasts until end of turn (removed during cleanup).\"\"\"\n\n\n@dataclass\nclass ContinuousEffect:\n    \"\"\"A single continuous effect in the layer system.\n\n    Attributes:\n        source: The game object that creates this effect.\n        layer: Which of the 7 layers this effect belongs to.\n        sublayer: Sub-layer within layer 7 (``None`` for layers 1–6).\n        apply: Callable ``(game: GameState) -> None`` that applies the effect.\n        timestamp: Monotonically increasing integer for ordering effects\n            within the same layer. Lower timestamp means earlier.\n        duration: How long the effect lasts.  Use :data:`DURATION_PERMANENT`\n            for static abilities, :data:`DURATION_END_OF_TURN` for until-EOT\n            effects, or a positive integer representing the turn number\n            on which the effect expires (removed when\n            ``game.turn_number > duration``).\n    \"\"\"\n\n    source: Any\n    layer: Layer\n    sublayer: SubLayer | None = None\n    apply: Callable[..., Any] = field(default=lambda _game: None)\n    timestamp: int = 0\n    duration: int = DURATION_PERMANENT\n\n    def _sort_key(self) -> tuple[int, int, int]:\n        \"\"\"Return a sort key: (layer, sublayer-ordinal, timestamp).\n\n        Effects are sorted first by layer, then by sublayer (for layer 7),\n        then by timestamp within the same (layer, sublayer).\n        \"\"\"\n        sublayer_order = _SUBLAYER_ORDER.get(self.sublayer, 0) if self.sublayer else 0\n        return (self.layer.value, sublayer_order, self.timestamp)\n\n\n# Map SubLayer values to a numeric ordering so 7a < 7b < 7c < 7d.\n_SUBLAYER_ORDER: dict[SubLayer, int] = {\n    SubLayer.CHARACTERISTIC_DEFINING: 1,\n    SubLayer.SET_PT: 2,\n    SubLayer.MODIFY_PT: 3,\n    SubLayer.COUNTERS: 4,\n}\n\n\nclass EffectManager:\n    \"\"\"Manages all active continuous effects and applies them in layer order.\n\n    The manager holds a list of :class:`ContinuousEffect` objects and provides\n    methods to add, remove expired effects, and apply them all to the game\n    state in the correct layer/timestamp order.\n    \"\"\"\n\n    def __init__(self) -> None:\n        self._effects: list[ContinuousEffect] = []\n        self._next_timestamp: int = 1\n\n    # ------------------------------------------------------------------\n    # Public API\n    # ------------------------------------------------------------------\n\n    def add(self, effect: ContinuousEffect) -> ContinuousEffect:\n        \"\"\"Add a continuous effect, auto-assigning a timestamp if it's 0.\n\n        Args:\n            effect: The effect to register.\n\n        Returns:\n            The effect (with timestamp populated).\n        \"\"\"\n        if effect.timestamp == 0:\n            effect.timestamp = self._next_timestamp\n            self._next_timestamp += 1\n        else:\n            # Keep _next_timestamp ahead of any manually assigned timestamps.\n            if effect.timestamp >= self._next_timestamp:\n                self._next_timestamp = effect.timestamp + 1\n        self._effects.append(effect)\n        return effect\n\n    def remove(self, effect: ContinuousEffect) -> bool:\n        \"\"\"Remove a specific effect by identity.\n\n        Returns:\n            ``True`` if the effect was found and removed, ``False`` otherwise.\n        \"\"\"\n        for i, e in enumerate(self._effects):\n            if e is effect:\n                self._effects.pop(i)\n                return True\n        return False\n\n    def remove_expired(self, game: GameState) -> int:\n        \"\"\"Remove effects whose duration has expired.\n\n        - ``DURATION_PERMANENT`` (−1): never expires automatically.\n        - ``DURATION_END_OF_TURN`` (0): removed when this method is called\n          (typically during the cleanup step).\n        - Positive integer *n*: removed when ``game.turn_number > n``.\n\n        Args:\n            game: The current game state (used for turn number).\n\n        Returns:\n            The number of effects removed.\n        \"\"\"\n        before = len(self._effects)\n        remaining: list[ContinuousEffect] = []\n        for eff in self._effects:\n            if eff.duration == DURATION_PERMANENT:\n                remaining.append(eff)\n            elif eff.duration == DURATION_END_OF_TURN:\n                # End-of-turn effects are swept away.\n                continue\n            elif game.turn_number > eff.duration:\n                # Turn-numbered expiry.\n                continue\n            else:\n                remaining.append(eff)\n        self._effects = remaining\n        return before - len(self._effects)\n\n    def apply_all(self, game: GameState) -> None:\n        \"\"\"Apply all active effects in layer order, then timestamp order.\n\n        Before applying, all objects on each player's battlefield are reset\n        to their original (pre-effect) characteristics so that calling this\n        method multiple times is idempotent.\n\n        Within each layer (and sublayer for layer 7), effects are applied\n        in timestamp order.  This method should be called whenever the\n        game state needs a fresh recalculation of continuous effects —\n        for example, after state-based actions or any game event that\n        could change the set of applicable effects.\n        \"\"\"\n        # Reset battlefield objects to their base characteristics so that\n        # reapplying effects does not accumulate on top of stale mutations.\n        self._reset_objects(game)\n\n        sorted_effects = sorted(self._effects, key=lambda e: e._sort_key())\n        for effect in sorted_effects:\n            effect.apply(game)\n\n    # ------------------------------------------------------------------\n    # Internal helpers\n    # ------------------------------------------------------------------\n\n    def _reset_objects(self, game: GameState) -> None:\n        \"\"\"Reset all battlefield objects to their original characteristics.\n\n        Iterates over every player's battlefield and calls\n        ``_reset_characteristics()`` on any object that supports it\n        (i.e. :class:`~engine.card.CardImpl` and its subclasses).\n        \"\"\"\n        for player in game.players:\n            for obj in game.get_battlefield(player).get_all():\n                reset = getattr(obj, \"_reset_characteristics\", None)\n                if callable(reset):\n                    reset()\n\n    # ------------------------------------------------------------------\n    # Query helpers\n    # ------------------------------------------------------------------\n\n    @property\n    def effects(self) -> list[ContinuousEffect]:\n        \"\"\"Return a shallow copy of the current effects list.\"\"\"\n        return list(self._effects)\n\n    def get_all(self) -> list[ContinuousEffect]:\n        \"\"\"Return a shallow copy of the current effects list.\"\"\"\n        return list(self._effects)\n\n    def get_effects_for_layer(self, layer: Layer) -> list[ContinuousEffect]:\n        \"\"\"Return effects belonging to a specific layer, in timestamp order.\"\"\"\n        return sorted(\n            [e for e in self._effects if e.layer == layer],\n            key=lambda e: e._sort_key(),\n        )\n\n    def get_effects_by_source(self, source: Any) -> list[ContinuousEffect]:\n        \"\"\"Return all effects created by a given source object.\"\"\"\n        return [e for e in self._effects if e.source is source]\n\n    def clear(self) -> None:\n        \"\"\"Remove all effects.\"\"\"\n        self._effects.clear()\n\n    def __len__(self) -> int:\n        return len(self._effects)\n","numLines":252,"startLine":1,"totalLines":252}}}
