{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0124br8gE5Sa8zBoQky62q1N","type":"tool_result","content":"1\t\"\"\"Mana pool and cost payment logic.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom engine.types import Color, HybridManaSymbol, ManaCost, ManaType\n6\t\n7\t# Map colored ManaTypes to their corresponding Color enum values.\n8\t_MANA_TO_COLOR: dict[ManaType, Color] = {\n9\t    ManaType.WHITE: Color.WHITE,\n10\t    ManaType.BLUE: Color.BLUE,\n11\t    ManaType.BLACK: Color.BLACK,\n12\t    ManaType.RED: Color.RED,\n13\t    ManaType.GREEN: Color.GREEN,\n14\t}\n15\t\n16\t\n17\tclass ManaPool:\n18\t    \"\"\"Tracks available mana for a player.\n19\t\n20\t    Internal storage uses a ``dict[ManaType, int]`` mapping each mana type\n21\t    to its current count.\n22\t    \"\"\"\n23\t\n24\t    def __init__(self) -> None:\n25\t        self._pool: dict[ManaType, int] = {mt: 0 for mt in ManaType}\n26\t        self._last_payment_colors: list[Color] = []\n27\t\n28\t    # ------------------------------------------------------------------\n29\t    # Basic operations\n30\t    # ------------------------------------------------------------------\n31\t\n32\t    def add(self, mana_type: ManaType, amount: int = 1) -> None:\n33\t        \"\"\"Add *amount* mana of the given type to the pool.\n34\t\n35\t        Parameters:\n36\t            mana_type: The type of mana to add.\n37\t            amount: How many mana to add (must be non-negative).\n38\t        \"\"\"\n39\t        if amount < 0:\n40\t            raise ValueError(f\"Cannot add negative mana: {amount}\")\n41\t        self._pool[mana_type] = self._pool.get(mana_type, 0) + amount\n42\t\n43\t    def empty(self) -> None:\n44\t        \"\"\"Clear the pool — happens at phase/step transitions.\"\"\"\n45\t        for mt in self._pool:\n46\t            self._pool[mt] = 0\n47\t\n48\t    def total(self) -> int:\n49\t        \"\"\"Return the total amount of mana in the pool across all types.\"\"\"\n50\t        return sum(self._pool.values())\n51\t\n52\t    def get(self, mana_type: ManaType) -> int:\n53\t        \"\"\"Return the amount of a specific mana type in the pool.\"\"\"\n54\t        return self._pool.get(mana_type, 0)\n55\t\n56\t    @property\n57\t    def last_payment_colors(self) -> list[Color]:\n58\t        \"\"\"Return the distinct colors of mana spent in the last :meth:`pay` call.\n59\t\n60\t        Colorless mana is not a color and is excluded.  The list is sorted\n61\t        by Color enum order for determinism.  Empty if no payment has been\n62\t        made or if all mana spent was colorless.\n63\t        \"\"\"\n64\t        return list(self._last_payment_colors)\n65\t\n66\t    # ------------------------------------------------------------------\n67\t    # Cost payment\n68\t    # ------------------------------------------------------------------\n69\t\n70\t    def can_pay(self, cost: ManaCost) -> bool:\n71\t        \"\"\"Check whether the pool can satisfy *cost*.\n72\t\n73\t        Generic mana can be paid by any type.  X is treated as 0 for\n74\t        ``can_pay`` unless explicitly set in the cost's generic component.\n75\t        Hybrid symbols can be paid with either option; this method uses\n76\t        backtracking to find a valid assignment.\n77\t\n78\t        Returns:\n79\t            True if the pool has enough mana to pay the cost.\n80\t        \"\"\"\n81\t        remaining: dict[ManaType, int] = dict(self._pool)\n82\t\n83\t        # Pay colored/colorless pips first.\n84\t        for mana_type, count in cost.pips.items():\n85\t            if remaining.get(mana_type, 0) < count:\n86\t                return False\n87\t            remaining[mana_type] = remaining.get(mana_type, 0) - count\n88\t\n89\t        # Solve hybrid symbols with backtracking.\n90\t        if cost.hybrid:\n91\t            if not self._can_pay_hybrid(remaining, list(cost.hybrid), 0, cost.generic):\n92\t                return False\n93\t            return True\n94\t\n95\t        # Then check generic — sum of all remaining mana must cover it.\n96\t        return sum(remaining.values()) >= cost.generic\n97\t\n98\t    def pay(self, cost: ManaCost, choices: dict[ManaType, int] | None = None) -> bool:\n99\t        \"\"\"Deduct mana from the pool to pay *cost*.\n100\t\n101\t        Parameters:\n102\t            cost: The mana cost to pay.\n103\t            choices: How to split the generic portion across mana types.\n104\t                If ``None``, auto-pay greedily: pay colored pips first,\n105\t                then hybrid symbols, then generic using colorless first,\n106\t                then excess colored.\n107\t\n108\t        Returns:\n109\t            True if payment succeeded, False if the pool has insufficient mana.\n110\t        \"\"\"\n111\t        if not self.can_pay(cost):\n112\t            return False\n113\t\n114\t        # Work on a copy so we can roll back on failure.\n115\t        working: dict[ManaType, int] = dict(self._pool)\n116\t\n117\t        # 1. Pay colored/colorless pips.\n118\t        for mana_type, count in cost.pips.items():\n119\t            working[mana_type] -= count\n120\t\n121\t        # 2. When explicit generic choices are provided, reserve that mana\n122\t        #    *before* solving hybrids so the solver doesn't steal it.\n123\t        generic_remaining = cost.generic\n124\t        if generic_remaining > 0 and choices is not None:\n125\t            # Reject negative choice amounts — they would create mana.\n126\t            if any(v < 0 for v in choices.values()):\n127\t                return False\n128\t            # Validate choices sum to generic cost.\n129\t            if sum(choices.values()) != generic_remaining:\n130\t                return False\n131\t            for mana_type, amount in choices.items():\n132\t                if working.get(mana_type, 0) < amount:\n133\t                    return False\n134\t                working[mana_type] -= amount\n135\t\n136\t        # 3. Pay hybrid symbols using backtracking to find a valid assignment.\n137\t        #    Generic choices (if any) have already been reserved above,\n138\t        #    so _solve_hybrid sees only the genuinely available mana.\n139\t        if cost.hybrid:\n140\t            generic_for_solver = generic_remaining if choices is None else 0\n141\t            hybrid_assignment = self._solve_hybrid(\n142\t                working, list(cost.hybrid), 0, generic_for_solver,\n143\t            )\n144\t            if hybrid_assignment is None:\n145\t                return False  # pragma: no cover – should not happen after can_pay\n146\t            for mt in hybrid_assignment:\n147\t                working[mt] = working.get(mt, 0) - 1\n148\t\n149\t        # 4. Pay generic cost (auto-pay path — choices already deducted above).\n150\t        if generic_remaining > 0 and choices is None:\n151\t            generic_remaining = self._auto_pay_generic(working, generic_remaining)\n152\t            if generic_remaining > 0:\n153\t                return False  # pragma: no cover – should not happen after can_pay\n154\t\n155\t        # Commit the payment.\n156\t        # Compute colors of mana spent by comparing old pool to new working pool.\n157\t        colors_spent: set[Color] = set()\n158\t        for mt, old_amount in self._pool.items():\n159\t            new_amount = working.get(mt, 0)\n160\t            if new_amount < old_amount and mt in _MANA_TO_COLOR:\n161\t                colors_spent.add(_MANA_TO_COLOR[mt])\n162\t        self._last_payment_colors = sorted(colors_spent, key=lambda c: c.value)\n163\t        self._pool = working\n164\t        return True\n165\t\n166\t    @staticmethod\n167\t    def _can_pay_hybrid(\n168\t        remaining: dict[ManaType, int],\n169\t        hybrids: list[HybridManaSymbol],\n170\t        idx: int,\n171\t        generic: int,\n172\t    ) -> bool:\n173\t        \"\"\"Recursively check if hybrid symbols + generic can be satisfied.\n174\t\n175\t        Uses backtracking: for each hybrid symbol, try option_a then option_b.\n176\t        After all hybrids are assigned, check that remaining mana covers generic.\n177\t        \"\"\"\n178\t        if idx >= len(hybrids):\n179\t            return sum(remaining.values()) >= generic\n180\t\n181\t        sym = hybrids[idx]\n182\t        for option in (sym.option_a, sym.option_b):\n183\t            if remaining.get(option, 0) > 0:\n184\t                remaining[option] -= 1\n185\t                if ManaPool._can_pay_hybrid(remaining, hybrids, idx + 1, generic):\n186\t                    remaining[option] += 1\n187\t                    return True\n188\t                remaining[option] += 1\n189\t        return False\n190\t\n191\t    @staticmethod\n192\t    def _solve_hybrid(\n193\t        remaining: dict[ManaType, int],\n194\t        hybrids: list[HybridManaSymbol],\n195\t        idx: int,\n196\t        generic: int,\n197\t    ) -> list[ManaType] | None:\n198\t        \"\"\"Find a valid assignment for hybrid symbols.\n199\t\n200\t        Returns a list of ManaType choices (one per hybrid symbol) or None\n201\t        if no valid assignment exists.\n202\t        \"\"\"\n203\t        if idx >= len(hybrids):\n204\t            if sum(remaining.values()) >= generic:\n205\t                return []\n206\t            return None\n207\t\n208\t        sym = hybrids[idx]\n209\t        for option in (sym.option_a, sym.option_b):\n210\t            if remaining.get(option, 0) > 0:\n211\t                remaining[option] -= 1\n212\t                result = ManaPool._solve_hybrid(remaining, hybrids, idx + 1, generic)\n213\t                if result is not None:\n214\t                    remaining[option] += 1\n215\t                    return [option] + result\n216\t                remaining[option] += 1\n217\t        return None\n218\t\n219\t    @staticmethod\n220\t    def _auto_pay_generic(working: dict[ManaType, int], amount: int) -> int:\n221\t        \"\"\"Deduct *amount* generic mana from *working*, preferring colorless.\n222\t\n223\t        Returns the remaining unpaid generic amount (0 on success).\n224\t        \"\"\"\n225\t        # Pay with colorless first.\n226\t        if working.get(ManaType.COLORLESS, 0) > 0:\n227\t            take = min(working[ManaType.COLORLESS], amount)\n228\t            working[ManaType.COLORLESS] -= take\n229\t            amount -= take\n230\t\n231\t        # Then pay with each colored type in enum order.\n232\t        for mt in ManaType:\n233\t            if mt is ManaType.COLORLESS:\n234\t                continue\n235\t            if amount <= 0:\n236\t                break\n237\t            if working.get(mt, 0) > 0:\n238\t                take = min(working[mt], amount)\n239\t                working[mt] -= take\n240\t                amount -= take\n241\t\n242\t        return amount\n243\t\n244\t    # ------------------------------------------------------------------\n245\t    # Dunder helpers\n246\t    # ------------------------------------------------------------------\n247\t\n248\t    def __repr__(self) -> str:\n249\t        non_zero = {mt.name: v for mt, v in self._pool.items() if v > 0}\n250\t        return f\"ManaPool({non_zero})\"\n251\t"}]},"parent_tool_use_id":null,"session_id":"a1b7c704-d004-4a3e-ade9-c0cdca9e5add","uuid":"f3e72d8e-cb77-4cf4-b168-d8dffb294db8","timestamp":"2026-06-04T08:42:05.436Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/mana.py","content":"\"\"\"Mana pool and cost payment logic.\"\"\"\n\nfrom __future__ import annotations\n\nfrom engine.types import Color, HybridManaSymbol, ManaCost, ManaType\n\n# Map colored ManaTypes to their corresponding Color enum values.\n_MANA_TO_COLOR: dict[ManaType, Color] = {\n    ManaType.WHITE: Color.WHITE,\n    ManaType.BLUE: Color.BLUE,\n    ManaType.BLACK: Color.BLACK,\n    ManaType.RED: Color.RED,\n    ManaType.GREEN: Color.GREEN,\n}\n\n\nclass ManaPool:\n    \"\"\"Tracks available mana for a player.\n\n    Internal storage uses a ``dict[ManaType, int]`` mapping each mana type\n    to its current count.\n    \"\"\"\n\n    def __init__(self) -> None:\n        self._pool: dict[ManaType, int] = {mt: 0 for mt in ManaType}\n        self._last_payment_colors: list[Color] = []\n\n    # ------------------------------------------------------------------\n    # Basic operations\n    # ------------------------------------------------------------------\n\n    def add(self, mana_type: ManaType, amount: int = 1) -> None:\n        \"\"\"Add *amount* mana of the given type to the pool.\n\n        Parameters:\n            mana_type: The type of mana to add.\n            amount: How many mana to add (must be non-negative).\n        \"\"\"\n        if amount < 0:\n            raise ValueError(f\"Cannot add negative mana: {amount}\")\n        self._pool[mana_type] = self._pool.get(mana_type, 0) + amount\n\n    def empty(self) -> None:\n        \"\"\"Clear the pool — happens at phase/step transitions.\"\"\"\n        for mt in self._pool:\n            self._pool[mt] = 0\n\n    def total(self) -> int:\n        \"\"\"Return the total amount of mana in the pool across all types.\"\"\"\n        return sum(self._pool.values())\n\n    def get(self, mana_type: ManaType) -> int:\n        \"\"\"Return the amount of a specific mana type in the pool.\"\"\"\n        return self._pool.get(mana_type, 0)\n\n    @property\n    def last_payment_colors(self) -> list[Color]:\n        \"\"\"Return the distinct colors of mana spent in the last :meth:`pay` call.\n\n        Colorless mana is not a color and is excluded.  The list is sorted\n        by Color enum order for determinism.  Empty if no payment has been\n        made or if all mana spent was colorless.\n        \"\"\"\n        return list(self._last_payment_colors)\n\n    # ------------------------------------------------------------------\n    # Cost payment\n    # ------------------------------------------------------------------\n\n    def can_pay(self, cost: ManaCost) -> bool:\n        \"\"\"Check whether the pool can satisfy *cost*.\n\n        Generic mana can be paid by any type.  X is treated as 0 for\n        ``can_pay`` unless explicitly set in the cost's generic component.\n        Hybrid symbols can be paid with either option; this method uses\n        backtracking to find a valid assignment.\n\n        Returns:\n            True if the pool has enough mana to pay the cost.\n        \"\"\"\n        remaining: dict[ManaType, int] = dict(self._pool)\n\n        # Pay colored/colorless pips first.\n        for mana_type, count in cost.pips.items():\n            if remaining.get(mana_type, 0) < count:\n                return False\n            remaining[mana_type] = remaining.get(mana_type, 0) - count\n\n        # Solve hybrid symbols with backtracking.\n        if cost.hybrid:\n            if not self._can_pay_hybrid(remaining, list(cost.hybrid), 0, cost.generic):\n                return False\n            return True\n\n        # Then check generic — sum of all remaining mana must cover it.\n        return sum(remaining.values()) >= cost.generic\n\n    def pay(self, cost: ManaCost, choices: dict[ManaType, int] | None = None) -> bool:\n        \"\"\"Deduct mana from the pool to pay *cost*.\n\n        Parameters:\n            cost: The mana cost to pay.\n            choices: How to split the generic portion across mana types.\n                If ``None``, auto-pay greedily: pay colored pips first,\n                then hybrid symbols, then generic using colorless first,\n                then excess colored.\n\n        Returns:\n            True if payment succeeded, False if the pool has insufficient mana.\n        \"\"\"\n        if not self.can_pay(cost):\n            return False\n\n        # Work on a copy so we can roll back on failure.\n        working: dict[ManaType, int] = dict(self._pool)\n\n        # 1. Pay colored/colorless pips.\n        for mana_type, count in cost.pips.items():\n            working[mana_type] -= count\n\n        # 2. When explicit generic choices are provided, reserve that mana\n        #    *before* solving hybrids so the solver doesn't steal it.\n        generic_remaining = cost.generic\n        if generic_remaining > 0 and choices is not None:\n            # Reject negative choice amounts — they would create mana.\n            if any(v < 0 for v in choices.values()):\n                return False\n            # Validate choices sum to generic cost.\n            if sum(choices.values()) != generic_remaining:\n                return False\n            for mana_type, amount in choices.items():\n                if working.get(mana_type, 0) < amount:\n                    return False\n                working[mana_type] -= amount\n\n        # 3. Pay hybrid symbols using backtracking to find a valid assignment.\n        #    Generic choices (if any) have already been reserved above,\n        #    so _solve_hybrid sees only the genuinely available mana.\n        if cost.hybrid:\n            generic_for_solver = generic_remaining if choices is None else 0\n            hybrid_assignment = self._solve_hybrid(\n                working, list(cost.hybrid), 0, generic_for_solver,\n            )\n            if hybrid_assignment is None:\n                return False  # pragma: no cover – should not happen after can_pay\n            for mt in hybrid_assignment:\n                working[mt] = working.get(mt, 0) - 1\n\n        # 4. Pay generic cost (auto-pay path — choices already deducted above).\n        if generic_remaining > 0 and choices is None:\n            generic_remaining = self._auto_pay_generic(working, generic_remaining)\n            if generic_remaining > 0:\n                return False  # pragma: no cover – should not happen after can_pay\n\n        # Commit the payment.\n        # Compute colors of mana spent by comparing old pool to new working pool.\n        colors_spent: set[Color] = set()\n        for mt, old_amount in self._pool.items():\n            new_amount = working.get(mt, 0)\n            if new_amount < old_amount and mt in _MANA_TO_COLOR:\n                colors_spent.add(_MANA_TO_COLOR[mt])\n        self._last_payment_colors = sorted(colors_spent, key=lambda c: c.value)\n        self._pool = working\n        return True\n\n    @staticmethod\n    def _can_pay_hybrid(\n        remaining: dict[ManaType, int],\n        hybrids: list[HybridManaSymbol],\n        idx: int,\n        generic: int,\n    ) -> bool:\n        \"\"\"Recursively check if hybrid symbols + generic can be satisfied.\n\n        Uses backtracking: for each hybrid symbol, try option_a then option_b.\n        After all hybrids are assigned, check that remaining mana covers generic.\n        \"\"\"\n        if idx >= len(hybrids):\n            return sum(remaining.values()) >= generic\n\n        sym = hybrids[idx]\n        for option in (sym.option_a, sym.option_b):\n            if remaining.get(option, 0) > 0:\n                remaining[option] -= 1\n                if ManaPool._can_pay_hybrid(remaining, hybrids, idx + 1, generic):\n                    remaining[option] += 1\n                    return True\n                remaining[option] += 1\n        return False\n\n    @staticmethod\n    def _solve_hybrid(\n        remaining: dict[ManaType, int],\n        hybrids: list[HybridManaSymbol],\n        idx: int,\n        generic: int,\n    ) -> list[ManaType] | None:\n        \"\"\"Find a valid assignment for hybrid symbols.\n\n        Returns a list of ManaType choices (one per hybrid symbol) or None\n        if no valid assignment exists.\n        \"\"\"\n        if idx >= len(hybrids):\n            if sum(remaining.values()) >= generic:\n                return []\n            return None\n\n        sym = hybrids[idx]\n        for option in (sym.option_a, sym.option_b):\n            if remaining.get(option, 0) > 0:\n                remaining[option] -= 1\n                result = ManaPool._solve_hybrid(remaining, hybrids, idx + 1, generic)\n                if result is not None:\n                    remaining[option] += 1\n                    return [option] + result\n                remaining[option] += 1\n        return None\n\n    @staticmethod\n    def _auto_pay_generic(working: dict[ManaType, int], amount: int) -> int:\n        \"\"\"Deduct *amount* generic mana from *working*, preferring colorless.\n\n        Returns the remaining unpaid generic amount (0 on success).\n        \"\"\"\n        # Pay with colorless first.\n        if working.get(ManaType.COLORLESS, 0) > 0:\n            take = min(working[ManaType.COLORLESS], amount)\n            working[ManaType.COLORLESS] -= take\n            amount -= take\n\n        # Then pay with each colored type in enum order.\n        for mt in ManaType:\n            if mt is ManaType.COLORLESS:\n                continue\n            if amount <= 0:\n                break\n            if working.get(mt, 0) > 0:\n                take = min(working[mt], amount)\n                working[mt] -= take\n                amount -= take\n\n        return amount\n\n    # ------------------------------------------------------------------\n    # Dunder helpers\n    # ------------------------------------------------------------------\n\n    def __repr__(self) -> str:\n        non_zero = {mt.name: v for mt, v in self._pool.items() if v > 0}\n        return f\"ManaPool({non_zero})\"\n","numLines":251,"startLine":1,"totalLines":251}}}
