{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018toNXtR9Mva7bUuzNyorYn","type":"tool_result","content":"410\tdef _resolve_spell(\n411\t    game: GameState,\n412\t    card: CardImpl,\n413\t    player: Player,\n414\t    stack_obj: StackObject,\n415\t) -> None:\n416\t    \"\"\"Resolve *card* cast by *player*.\n417\t\n418\t    1. Call ``card.on_resolve(game, targets=targets)``.\n419\t    2. Remove the card from the stack zone.\n420\t    3. If the card is a permanent type, move it to the battlefield via\n421\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n422\t       registration and the ETB event).\n423\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n424\t    \"\"\"\n425\t    from engine.zones import move_to_zone\n426\t\n427\t    # Read targets from the StackObject — the single source of truth.\n428\t    # Set chosen_targets on the card just before resolution so that\n429\t    # _get_chosen_target helpers (which read via getattr) work.\n430\t    targets = stack_obj.targets\n431\t    if targets is not None:\n432\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n433\t\n434\t    card.on_resolve(game)\n435\t\n436\t    if card.card_types & _PERMANENT_TYPES:\n437\t        # Move from stack to battlefield via move_to_zone, which handles\n438\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n439\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n440\t    else:\n441\t        # Instant/sorcery: normally to the graveyard, but an effect may\n442\t        # redirect it to exile (e.g. \"if that spell would be put into your\n443\t        # graveyard, exile it instead\" / Paradigm).\n444\t        dest = Zone.EXILE if getattr(card, \"_exile_on_resolve\", False) else Zone.GRAVEYARD\n445\t        move_to_zone(game, card, Zone.STACK, dest)\n446\t\n447\t\n448\t# ------------------------------------------------------------------\n449\t# Play land (special action — does not use the stack)\n450\t# ------------------------------------------------------------------\n451\t\n452\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n453\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n454\t\n455\t    Requirements (all must hold):\n456\t\n457\t    * *land_card* has :attr:`CardType.LAND`.\n458\t    * *player* is the active player.\n459\t    * Current phase is a main phase.\n460\t    * The stack is empty.\n461\t    * ``player.land_plays_remaining > 0``.\n462\t    * The card is in the player's hand.\n463\t\n464\t    On success the card moves from hand to battlefield and\n465\t    ``land_plays_remaining`` is decremented.\n466\t\n467\t    Raises:\n468\t        CastingError: If any requirement is not met.\n469\t    \"\"\"\n470\t    # Must be a land\n471\t    if CardType.LAND not in land_card.card_types:\n472\t        raise CastingError(\n473\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n474\t        )\n475\t\n476\t    # Sorcery-speed timing (active player, main phase, stack empty)\n477\t    if not is_sorcery_speed(game, player):\n478\t        raise CastingError(\n479\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n480\t            \"during main phase with empty stack\"\n481\t        )\n482\t\n483\t    # Land plays remaining\n484\t    if player.land_plays_remaining <= 0:\n485\t        raise CastingError(\n486\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n487\t        )\n488\t\n489\t    # Card must be in hand\n490\t    hand = game.get_hand(player)\n491\t    if not hand.contains(land_card):\n492\t        raise CastingError(\n493\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n494\t        )\n495\t\n496\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n497\t    if land_card.owner is None:\n498\t        land_card.owner = player\n499\t    land_card.controller = player\n500\t\n501\t    # Move from hand to battlefield via move_to_zone, which fires\n502\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n503\t    from engine.zones import move_to_zone\n504\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n505\t\n506\t    # Decrement land plays\n507\t    player.land_plays_remaining -= 1\n508\t\n509\t\n510\tdef resolve_top(game: GameState) -> None:\n511\t    \"\"\"Resolve the top spell/ability on the stack.\n512\t\n513\t    Pops the top item from the stack, calls its on_resolve callback,\n514\t    then runs state-based actions.  If the stack is empty this is a no-op.\n515\t    \"\"\"\n516\t    if game.stack.is_empty():\n517\t        return\n518\t    from engine.state_based_actions import resolve_state_based_actions\n519\t"}]},"parent_tool_use_id":null,"session_id":"d616a92e-14a8-4e9f-8780-afe29cd109e3","uuid":"f2b430d3-e865-4f93-933b-53424eecae56","timestamp":"2026-06-04T09:18:54.591Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"def _resolve_spell(\n    game: GameState,\n    card: CardImpl,\n    player: Player,\n    stack_obj: StackObject,\n) -> None:\n    \"\"\"Resolve *card* cast by *player*.\n\n    1. Call ``card.on_resolve(game, targets=targets)``.\n    2. Remove the card from the stack zone.\n    3. If the card is a permanent type, move it to the battlefield via\n       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n       registration and the ETB event).\n    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Read targets from the StackObject — the single source of truth.\n    # Set chosen_targets on the card just before resolution so that\n    # _get_chosen_target helpers (which read via getattr) work.\n    targets = stack_obj.targets\n    if targets is not None:\n        card.chosen_targets = targets  # type: ignore[attr-defined]\n\n    card.on_resolve(game)\n\n    if card.card_types & _PERMANENT_TYPES:\n        # Move from stack to battlefield via move_to_zone, which handles\n        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n    else:\n        # Instant/sorcery: normally to the graveyard, but an effect may\n        # redirect it to exile (e.g. \"if that spell would be put into your\n        # graveyard, exile it instead\" / Paradigm).\n        dest = Zone.EXILE if getattr(card, \"_exile_on_resolve\", False) else Zone.GRAVEYARD\n        move_to_zone(game, card, Zone.STACK, dest)\n\n\n# ------------------------------------------------------------------\n# Play land (special action — does not use the stack)\n# ------------------------------------------------------------------\n\ndef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n\n    Requirements (all must hold):\n\n    * *land_card* has :attr:`CardType.LAND`.\n    * *player* is the active player.\n    * Current phase is a main phase.\n    * The stack is empty.\n    * ``player.land_plays_remaining > 0``.\n    * The card is in the player's hand.\n\n    On success the card moves from hand to battlefield and\n    ``land_plays_remaining`` is decremented.\n\n    Raises:\n        CastingError: If any requirement is not met.\n    \"\"\"\n    # Must be a land\n    if CardType.LAND not in land_card.card_types:\n        raise CastingError(\n            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n        )\n\n    # Sorcery-speed timing (active player, main phase, stack empty)\n    if not is_sorcery_speed(game, player):\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — must be active player \"\n            \"during main phase with empty stack\"\n        )\n\n    # Land plays remaining\n    if player.land_plays_remaining <= 0:\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n        )\n\n    # Card must be in hand\n    hand = game.get_hand(player)\n    if not hand.contains(land_card):\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — card not in hand\"\n        )\n\n    # Ensure owner/controller are set so move_to_zone routes correctly.\n    if land_card.owner is None:\n        land_card.owner = player\n    land_card.controller = player\n\n    # Move from hand to battlefield via move_to_zone, which fires\n    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n    from engine.zones import move_to_zone\n    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n\n    # Decrement land plays\n    player.land_plays_remaining -= 1\n\n\ndef resolve_top(game: GameState) -> None:\n    \"\"\"Resolve the top spell/ability on the stack.\n\n    Pops the top item from the stack, calls its on_resolve callback,\n    then runs state-based actions.  If the stack is empty this is a no-op.\n    \"\"\"\n    if game.stack.is_empty():\n        return\n    from engine.state_based_actions import resolve_state_based_actions\n","numLines":110,"startLine":410,"totalLines":523}}}
