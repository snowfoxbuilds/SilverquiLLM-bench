{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ty36Qy3bmv8UtzotYCqEUB","type":"tool_result","content":"338\t\n339\t    if source_zone_container is None or not source_zone_container.contains(card):\n340\t        raise CastingError(\n341\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n342\t        )\n343\t\n344\t    # Move card from source zone to stack zone\n345\t    stack_zone = player.zones[Zone.STACK]\n346\t    source_zone_container.remove(card)\n347\t    stack_zone.add(card)\n348\t\n349\t    # 3. Choose targets (with rollback on failure)\n350\t    try:\n351\t        target_specs = card.get_targets(game)\n352\t        chosen_targets: list[Any] = []\n353\t        if target_specs:\n354\t            for spec in target_specs:\n355\t                target = player.choose_target(target_specs, spec)\n356\t                # Validate against filter_fn if the spec provides one\n357\t                filter_fn = getattr(spec, \"filter_fn\", None)\n358\t                if filter_fn is not None and target is not None:\n359\t                    if not filter_fn(target):\n360\t                        raise CastingError(\n361\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n362\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n363\t                        )\n364\t                chosen_targets.append(target)\n365\t\n366\t        # Protection check — reject targets that have protection from this spell\n367\t        from engine.protection import has_protection_from\n368\t\n369\t        for target in chosen_targets:\n370\t            if has_protection_from(target, card):\n371\t                raise CastingError(\n372\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n373\t                )\n374\t    except Exception as exc:\n375\t        # Rollback: move card from stack zone back to source zone\n376\t        stack_zone.remove(card)\n377\t        source_zone_container.add(card)\n378\t        raise CastingError(str(exc)) from exc\n379\t\n380\t    # 4. Call on_cast hook\n381\t    card.on_cast(game)\n382\t\n383\t    # 5. Build on_resolve callback and push StackObject\n384\t    stack_obj = StackObject(\n385\t        source=card,\n386\t        controller=player,\n387\t        targets=chosen_targets,\n388\t        on_resolve=lambda g: None,  # replaced below\n389\t    )\n390\t\n391\t    def _on_resolve(g: GameState) -> None:\n392\t        _resolve_spell(g, card, player, stack_obj)\n393\t\n394\t    stack_obj.on_resolve = _on_resolve\n395\t    game.stack.push(stack_obj)\n396\t\n397\t    # Fire the \"spell cast\" trigger for free-cast spells as well.\n398\t    from engine.events import SpellCastTriggeredEvent\n399\t\n400\t    game.trigger_manager.fire_event(\n401\t        game,\n402\t        SpellCastTriggeredEvent(spell=card, card=card, player=player, controller=player),\n403\t    )\n404\t\n405\t\n406\t# ------------------------------------------------------------------\n407\t# Resolution (called when the stack pops)\n408\t# ------------------------------------------------------------------\n409\t\n410\tdef _resolve_spell(\n411\t    game: GameState,\n412\t    card: CardImpl,\n413\t    player: Player,\n414\t    stack_obj: StackObject,\n415\t) -> None:\n416\t    \"\"\"Resolve *card* cast by *player*.\n417\t\n418\t    1. Call ``card.on_resolve(game, targets=targets)``.\n419\t    2. Remove the card from the stack zone.\n420\t    3. If the card is a permanent type, move it to the battlefield via\n421\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n422\t       registration and the ETB event).\n423\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n424\t    \"\"\"\n425\t    from engine.zones import move_to_zone\n426\t\n427\t    # Read targets from the StackObject — the single source of truth."}]},"parent_tool_use_id":null,"session_id":"d