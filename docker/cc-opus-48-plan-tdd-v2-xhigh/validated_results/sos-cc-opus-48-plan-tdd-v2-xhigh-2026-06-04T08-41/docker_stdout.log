ers(self, game: GameState) -> None:\n44\t        from engine.triggers import TriggerRegistration\n45\t        source = self\n46\t\n47\t        def _effect(game: GameState) -> None:\n48\t            target = _get_chosen_target(source, game)\n49\t            if target is None:\n50\t                controller = getattr(source, 'controller', None)\n51\t                for player in game.players:\n52\t                    if player is not controller:\n53\t                        target = player\n54\t                        break\n55\t            if target is None:\n56\t                return\n57\t            if hasattr(target, 'zones'):\n58\t                gy = target.zones[Zone.GRAVEYARD]\n59\t                exile = target.zones[Zone.EXILE]\n60\t                for card in gy.get_all():\n61\t                    gy.remove(card)\n62\t                    exile.add(card)\n63\t        controller = getattr(self, 'controller', None) or game.active_player\n64\t        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=_self_etb_condition(self), effect=_effect, source=self, controller=controller))\n65\t"}]},"parent_tool_use_id":null,"session_id":"d616a92e-14a8-4e9f-8780-afe29cd109e3","uuid":"a06d3a75-8763-401b-9e50-7db0ab64148c","timestamp":"2026-06-04T09:20:41.438Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_136/card_impl.py","content":"\"\"\"Card implementation for Angel of Finality.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import ArtifactCreature, Creature\nfrom engine.continuous_effects import ContinuousEffect, DURATION_END_OF_TURN, Layer, SubLayer\nfrom engine.types import CardType, Keyword, ManaCost, Zone\nfrom engine.events import EntersBattlefieldTriggeredEvent\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from cards.registry import CardRegistry\n\ndef _self_etb_condition(source: Any):\n    \"\"\"Return 