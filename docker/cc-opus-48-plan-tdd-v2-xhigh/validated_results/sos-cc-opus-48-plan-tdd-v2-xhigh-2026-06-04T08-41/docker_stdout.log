{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YGgVDRgto9JSxgkJZpez4k","type":"tool_result","content":"1\t\"\"\"Basic land implementations — Plains, Island, Swamp, Mountain, Forest.\n2\t\n3\tEach basic land:\n4\t- Subclasses :class:`~engine.card.Land`.\n5\t- Has ``supertypes = {Supertype.BASIC}``.\n6\t- Has a subtype matching its land type (e.g. ``{\"Plains\"}``).\n7\t- Provides a :class:`~engine.card.ManaAbility` that taps to produce\n8\t  one mana of its associated color.\n9\t\n10\tUse :func:`register_basic_lands` to register all five with a\n11\t:class:`~cards.registry.CardRegistry`.\n12\t\"\"\"\n13\t\n14\tfrom __future__ import annotations\n15\t\n16\tfrom typing import TYPE_CHECKING, Any\n17\t\n18\tfrom engine.card import Land, ManaAbility\n19\tfrom engine.types import ManaType, Supertype\n20\t\n21\tif TYPE_CHECKING:\n22\t    from engine.game_state import GameState\n23\t    from engine.player import Player\n24\t\n25\t    from cards.registry import CardRegistry\n26\t\n27\t\n28\t# ---------------------------------------------------------------------------\n29\t# Mana-ability helpers\n30\t# ---------------------------------------------------------------------------\n31\t\n32\tdef _tap_cost(game: GameState, source: Any) -> bool:\n33\t    \"\"\"Generic tap-cost: check untapped, then tap.\n34\t\n35\t    Mirrors :func:`engine.abilities.tap_cost` logic so basic lands\n36\t    can be activated through the abilities system or directly.\n37\t    \"\"\"\n38\t    if getattr(source, \"is_tapped\", False):\n39\t        return False\n40\t    source.is_tapped = True\n41\t    return True\n42\t\n43\t\n44\tdef _make_mana_effect(mana_type: ManaType):\n45\t    \"\"\"Return an effect callable that adds 1 mana of *mana_type* to the controller's pool.\"\"\"\n46\t\n47\t    def _effect(game: GameState) -> None:  # noqa: ARG001 – game needed for signature\n48\t        # The source is captured via the ability's activation context.\n49\t        # However, ManaAbility.mana_produced is called by activate_ability's\n50\t        # effect path.  We need to figure out who the controller is.\n51\t        # This is handled at activation time — see get_mana_abilities below.\n52\t        pass\n53\t\n54\t    return _effect\n55\t\n56\t\n57\t# ---------------------------------------------------------------------------\n58\t# Basic land classes\n59\t# ---------------------------------------------------------------------------\n60\t\n61\tclass Plains(Land):\n62\t    \"\"\"Basic Plains — taps for {W}.\"\"\"\n63\t\n64\t    def __init__(self, **kwargs: Any) -> None:\n65\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n66\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Plains\"}\n67\t        super().__init__(**kwargs)\n68\t\n69\t    def get_mana_abilities(self) -> list[ManaAbility]:\n70\t        \"\"\"Return a single mana ability: {T}: Add {W}.\"\"\"\n71\t        source = self\n72\t\n73\t        def _effect(game: GameState) -> None:\n74\t            controller = source.controller\n75\t            if controller is not None:\n76\t                controller.mana_pool.add(ManaType.WHITE, 1)\n77\t\n78\t        return [\n79\t            ManaAbility(\n80\t                cost=_tap_cost,\n81\t                mana_produced=_effect,\n82\t                description=\"{T}: Add {W}.\",\n83\t            )\n84\t        ]\n85\t\n86\t\n87\tclass Island(Land):\n88\t    \"\"\"Basic Island — taps for {U}.\"\"\"\n89\t\n90\t    def __init__(self, **kwargs: Any) -> None:\n91\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n92\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Island\"}\n93\t        super().__init__(**kwargs)\n94\t\n95\t    def get_mana_abilities(self) -> list[ManaAbility]:\n96\t        \"\"\"Return a single mana ability: {T}: Add {U}.\"\"\"\n97\t        source = self\n98\t\n99\t        def _effect(game: GameState) -> None:\n100\t            controller = source.controller\n101\t            if controller is not None:\n102\t                controller.mana_pool.add(ManaType.BLUE, 1)\n103\t\n104\t        return [\n105\t            ManaAbility(\n106\t                cost=_tap_cost,\n107\t                mana_produced=_effect,\n108\t                description=\"{T}: Add {U}.\",\n109\t            )\n110\t        ]\n111\t\n112\t\n113\tclass Swamp(Land):\n114\t    \"\"\"Basic Swamp — taps for {B}.\"\"\"\n115\t\n116\t    def __init__(self, **kwargs: Any) -> None:\n117\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n118\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Swamp\"}\n119\t        super().__init__(**kwargs)\n120\t\n121\t    def get_mana_abilities(self) -> list[ManaAbility]:\n122\t        \"\"\"Return a single mana ability: {T}: Add {B}.\"\"\"\n123\t        source = self\n124\t\n125\t        def _effect(game: GameState) -> None:\n126\t            controller = source.controller\n127\t            if controller is not None:\n128\t                controller.mana_pool.add(ManaType.BLACK, 1)\n129\t\n130\t        return [\n131\t            ManaAbility(\n132\t                cost=_tap_cost,\n133\t                mana_produced=_effect,\n134\t                description=\"{T}: Add {B}.\",\n135\t            )\n136\t        ]\n137\t\n138\t\n139\tclass Mountain(Land):\n140\t    \"\"\"Basic Mountain — taps for {R}.\"\"\"\n141\t\n142\t    def __init__(self, **kwargs: Any) -> None:\n143\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n144\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Mountain\"}\n145\t        super().__init__(**kwargs)\n146\t\n147\t    def get_mana_abilities(self) -> list[ManaAbility]:\n148\t        \"\"\"Return a single mana ability: {T}: Add {R}.\"\"\"\n149\t        source = self\n150\t\n151\t        def _effect(game: GameState) -> None:\n152\t            controller = source.controller\n153\t            if controller is not None:\n154\t                controller.mana_pool.add(ManaType.RED, 1)\n155\t\n156\t        return [\n157\t            ManaAbility(\n158\t                cost=_tap_cost,\n159\t                mana_produced=_effect,\n160\t                description=\"{T}: Add {R}.\",\n161\t            )\n162\t        ]\n163\t\n164\t\n165\tclass Forest(Land):\n166\t    \"\"\"Basic Forest — taps for {G}.\"\"\"\n167\t\n168\t    def __init__(self, **kwargs: Any) -> None:\n169\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n170\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Forest\"}\n171\t        super().__init__(**kwargs)\n172\t\n173\t    def get_mana_abilities(self) -> list[ManaAbility]:\n174\t        \"\"\"Return a single mana ability: {T}: Add {G}.\"\"\"\n175\t        source = self\n176\t\n177\t        def _effect(game: GameState) -> None:\n178\t            controller = source.controller\n179\t            if controller is not None:\n180\t                controller.mana_pool.add(ManaType.GREEN, 1)\n181\t\n182\t        return [\n183\t            ManaAbility(\n184\t                cost=_tap_cost,\n185\t                mana_produced=_effect,\n186\t                description=\"{T}: Add {G}.\",\n187\t            )\n188\t        ]\n189\t\n190\t\n191\t# ---------------------------------------------------------------------------\n192\t# Registration helper\n193\t# ---------------------------------------------------------------------------\n194\t\n195\tdef register_basic_lands(registry: CardRegistry) -> None:\n196\t    \"\"\"Register all five basic lands with *registry*.\n197\t\n198\t    Each is registered under its canonical name (e.g. ``\"Plains\"``) with\n199\t    :class:`~cards.registry.CardMetadata` reflecting its type line, colors,\n200\t    and lack of mana cost.\n201\t    \"\"\"\n202\t    from cards.registry import CardMetadata\n203\t\n204\t    _BASIC_LANDS: list[tuple[str, type[Land], str]] = [\n205\t        (\"Plains\", Plains, \"W\"),\n206\t        (\"Island\", Island, \"U\"),\n207\t        (\"Swamp\", Swamp, \"B\"),\n208\t        (\"Mountain\", Mountain, \"R\"),\n209\t        (\"Forest\", Forest, \"G\"),\n210\t    ]\n211\t\n212\t    for card_name, impl_class, mana_symbol in _BASIC_LANDS:\n213\t        metadata = CardMetadata(\n214\t            name=card_name,\n215\t            mana_cost_str=\"\",\n216\t            type_line=f\"Basic Land — {card_name}\",\n217\t            oracle_text=f\"({{T}}: Add {{{mana_symbol}}}.)\",\n218\t            power=None,\n219\t            toughness=None,\n220\t            colors=[],\n221\t            keywords=[],\n222\t            rarity=\"common\",\n223\t            set_code=\"\",\n224\t            collector_number=\"\",\n225\t        )\n226\t        registry.register(card_name, impl_class, metadata)\n227\t"}]},"parent_tool_use_id":null,"session_id":"d616a92e-14a8-4e9f-8780-afe29cd109e3","uuid":"1fa297c7-e77f-4ffa-b314-be7ced5c2e20","timestamp":"2026-06-04T09:27:01.777Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/basic_lands.py","content":"\"\"\"Basic land implementations — Plains, Island, Swamp, Mountain, Forest.\n\nEach basic land:\n- Subclasses :class:`~engine.card.Land`.\n- Has ``supertypes = {Supertype.BASIC}``.\n- Has a subtype matching its land type (e.g. ``{\"Plains\"}``).\n- Provides a :class:`~engine.card.ManaAbility` that taps to produce\n  one mana of its associated color.\n\nUse :func:`register_basic_lands` to register all five with a\n:class:`~cards.registry.CardRegistry`.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import Land, ManaAbility\nfrom engine.types import ManaType, Supertype\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n    from cards.registry import CardRegistry\n\n\n# ---------------------------------------------------------------------------\n# Mana-ability helpers\n# ---------------------------------------------------------------------------\n\ndef _tap_cost(game: GameState, source: Any) -> bool:\n    \"\"\"Generic tap-cost: check untapped, then tap.\n\n    Mirrors :func:`engine.abilities.tap_cost` logic so basic lands\n    can be activated through the abilities system or directly.\n    \"\"\"\n    if getattr(source, \"is_tapped\", False):\n        return False\n    source.is_tapped = True\n    return True\n\n\ndef _make_mana_effect(mana_type: ManaType):\n    \"\"\"Return an effect callable that adds 1 mana of *mana_type* to the controller's pool.\"\"\"\n\n    def _effect(game: GameState) -> None:  # noqa: ARG001 – game needed for signature\n        # The source is captured via the ability's activation context.\n        # However, ManaAbility.mana_produced is called by activate_ability's\n        # effect path.  We need to figure out who the controller is.\n        # This is handled at activation time — see get_mana_abilities below.\n        pass\n\n    return _effect\n\n\n# ---------------------------------------------------------------------------\n# Basic land classes\n# ---------------------------------------------------------------------------\n\nclass Plains(Land):\n    \"\"\"Basic Plains — taps for {W}.\"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Plains\"}\n        super().__init__(**kwargs)\n\n    def get_mana_abilities(self) -> list[ManaAbility]:\n        \"\"\"Return a single mana ability: {T}: Add {W}.\"\"\"\n        source = self\n\n        def _effect(game: GameState) -> None:\n            controller = source.controller\n            if controller is not None:\n                controller.mana_pool.add(ManaType.WHITE, 1)\n\n        return [\n            ManaAbility(\n                cost=_tap_cost,\n                mana_produced=_effect,\n                description=\"{T}: Add {W}.\",\n            )\n        ]\n\n\nclass Island(Land):\n    \"\"\"Basic Island — taps for {U}.\"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Island\"}\n        super().__init__(**kwargs)\n\n    def get_mana_abilities(self) -> list[ManaAbility]:\n        \"\"\"Return a single mana ability: {T}: Add {U}.\"\"\"\n        source = self\n\n        def _effect(game: GameState) -> None:\n            controller = source.controller\n            if controller is not None:\n                controller.mana_pool.add(ManaType.BLUE, 1)\n\n        return [\n            ManaAbility(\n                cost=_tap_cost,\n                mana_produced=_effect,\n                description=\"{T}: Add {U}.\",\n            )\n        ]\n\n\nclass Swamp(Land):\n    \"\"\"Basic Swamp — taps for {B}.\"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Swamp\"}\n        super().__init__(**kwargs)\n\n    def get_mana_abilities(self) -> list[ManaAbility]:\n        \"\"\"Return a single mana ability: {T}: Add {B}.\"\"\"\n        source = self\n\n        def _effect(game: GameState) -> None:\n            controller = source.controller\n            if controller is not None:\n                controller.mana_pool.add(ManaType.BLACK, 1)\n\n        return [\n            ManaAbility(\n                cost=_tap_cost,\n                mana_produced=_effect,\n                description=\"{T}: Add {B}.\",\n            )\n        ]\n\n\nclass Mountain(Land):\n    \"\"\"Basic Mountain — taps for {R}.\"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Mountain\"}\n        super().__init__(**kwargs)\n\n    def get_mana_abilities(self) -> list[ManaAbility]:\n        \"\"\"Return a single mana ability: {T}: Add {R}.\"\"\"\n        source = self\n\n        def _effect(game: GameState) -> None:\n            controller = source.controller\n            if controller is not None:\n                controller.mana_pool.add(ManaType.RED, 1)\n\n        return [\n            ManaAbility(\n                cost=_tap_cost,\n                mana_produced=_effect,\n                description=\"{T}: Add {R}.\",\n            )\n        ]\n\n\nclass Forest(Land):\n    \"\"\"Basic Forest — taps for {G}.\"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Forest\"}\n        super().__init__(**kwargs)\n\n    def get_mana_abilities(self) -> list[ManaAbility]:\n        \"\"\"Return a single mana ability: {T}: Add {G}.\"\"\"\n        source = self\n\n        def _effect(game: GameState) -> None:\n            controller = source.controller\n            if controller is not None:\n                controller.mana_pool.add(ManaType.GREEN, 1)\n\n        return [\n            ManaAbility(\n                cost=_tap_cost,\n                mana_produced=_effect,\n                description=\"{T}: Add {G}.\",\n            )\n        ]\n\n\n# ---------------------------------------------------------------------------\n# Registration helper\n# ---------------------------------------------------------------------------\n\ndef register_basic_lands(registry: CardRegistry) -> None:\n    \"\"\"Register all five basic lands with *registry*.\n\n    Each is registered under its canonical name (e.g. ``\"Plains\"``) with\n    :class:`~cards.registry.CardMetadata` reflecting its type line, colors,\n    and lack of mana cost.\n    \"\"\"\n    from cards.registry import CardMetadata\n\n    _BASIC_LANDS: list[tuple[str, type[Land], str]] = [\n        (\"Plains\", Plains, \"W\"),\n        (\"Island\", Island, \"U\"),\n        (\"Swamp\", Swamp, \"B\"),\n        (\"Mountain\", Mountain, \"R\"),\n        (\"Forest\", Forest, \"G\"),\n    ]\n\n    for card_name, impl_class, mana_symbol in _BASIC_LANDS:\n        metadata = CardMetadata(\n            name=card_name,\n            mana_cost_str=\"\",\n            type_line=f\"Basic Land — {card_name}\",\n            oracle_text=f\"({{T}}: Add {{{mana_symbol}}}.)\",\n            power=None,\n            toughness=None,\n            colors=[],\n            keywords=[],\n            rarity=\"common\",\n            set_code=\"\",\n            collector_number=\"\",\n        )\n        registry.register(card_name, impl_class, metadata)\n","numLines":227,"startLine":1,"totalLines":227}}}
