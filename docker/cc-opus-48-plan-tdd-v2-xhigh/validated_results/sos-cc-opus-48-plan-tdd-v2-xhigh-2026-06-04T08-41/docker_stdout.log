r game.active_player\n        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=_self_etb_condition(self), effect=_effect, source=self, controller=controller))\n","numLines":65,"startLine":1,"totalLines":65}}}
