{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LP4h5wpQQGaKH6hA9Pxner","type":"tool_result","content":"1\t\"\"\"Player interface and deterministic test player implementation.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom abc import ABC, abstractmethod\n6\tfrom collections import deque\n7\tfrom typing import Any\n8\t\n9\tfrom engine.mana import ManaPool\n10\tfrom engine.zones import Zones\n11\t\n12\t\n13\tclass ScriptExhaustedError(Exception):\n14\t    \"\"\"Raised when a DeterministicPlayer's script runs out of predetermined answers.\"\"\"\n15\t\n16\t\n17\tclass Player(ABC):\n18\t    \"\"\"Abstract base class for all players in the game.\n19\t\n20\t    Attributes:\n21\t        name: The player's display name.\n22\t        life: Current life total (default 20).\n23\t        zones: Per-player zone containers.\n24\t        mana_pool: The player's mana pool (forward ref; initialized to None until ManaPool is implemented).\n25\t        has_lost: Whether this player has lost the game.\n26\t        land_plays_remaining: Number of land plays remaining this turn.\n27\t        drawn_from_empty_library: Whether this player attempted to draw from an empty library.\n28\t    \"\"\"\n29\t\n30\t    def __init__(self, name: str, life: int = 20) -> None:\n31\t        self.name: str = name\n32\t        self.life: int = life\n33\t        self.zones: Zones = Zones.new_player()\n34\t        self.mana_pool: ManaPool = ManaPool()\n35\t        self.has_lost: bool = False\n36\t        self.land_plays_remaining: int = 1\n37\t        self.drawn_from_empty_library: bool = False\n38\t\n39\t    @abstractmethod\n40\t    def choose_target(self, options: Any, requirement: Any) -> Any:\n41\t        \"\"\"Choose a target from the available options given a requirement.\n42\t\n43\t        Parameters:\n44\t            options: The available targets to choose from.\n45\t            requirement: The targeting requirement to satisfy.\n46\t\n47\t        Returns:\n48\t            The chosen target.\n49\t        \"\"\"\n50\t\n51\t    @abstractmethod\n52\t    def choose(self, options: Any, description: str) -> Any:\n53\t        \"\"\"Choose from a list of options.\n54\t\n55\t        Parameters:\n56\t            options: The available choices.\n57\t            description: Human-readable description of the choice.\n58\t\n59\t        Returns:\n60\t            The chosen option.\n61\t        \"\"\"\n62\t\n63\t    @abstractmethod\n64\t    def choose_yes_no(self, prompt: str) -> bool:\n65\t        \"\"\"Make a yes/no decision.\n66\t\n67\t        Parameters:\n68\t            prompt: Human-readable prompt for the decision.\n69\t\n70\t        Returns:\n71\t            True for yes, False for no.\n72\t        \"\"\"\n73\t\n74\t    @abstractmethod\n75\t    def assign_damage_order(self, attackers_or_blockers: Any) -> list[Any]:\n76\t        \"\"\"Assign a damage ordering to attackers or blockers.\n77\t\n78\t        Parameters:\n79\t            attackers_or_blockers: The creatures to order.\n80\t\n81\t        Returns:\n82\t            An ordered list representing the damage assignment order.\n83\t        \"\"\"\n84\t\n85\t    @abstractmethod\n86\t    def choose_card(self, cards: Any, description: str) -> Any:\n87\t        \"\"\"Choose a card from a collection.\n88\t\n89\t        Parameters:\n90\t            cards: The available cards to choose from.\n91\t            description: Human-readable description of why a card is being chosen.\n92\t\n93\t        Returns:\n94\t            The chosen card.\n95\t        \"\"\"\n96\t\n97\t\n98\tclass DeterministicPlayer(Player):\n99\t    \"\"\"A scripted player for testing that returns predetermined answers.\n100\t\n101\t    Each abstract method call pops the next answer from the front of the\n102\t    script queue. Raises :class:`ScriptExhaustedError` if the script is empty\n103\t    when a choice is requested.\n104\t    \"\"\"\n105\t\n106\t    def __init__(self, name: str, script: list[Any], life: int = 20) -> None:\n107\t        super().__init__(name, life)\n108\t        self._script: deque[Any] = deque(script)\n109\t\n110\t    def _pop(self) -> Any:\n111\t        \"\"\"Pop the next scripted answer from the queue.\n112\t\n113\t        Raises:\n114\t            ScriptExhaustedError: If the script has no remaining answers.\n115\t        \"\"\"\n116\t        if not self._script:\n117\t            raise ScriptExhaustedError(\n118\t                f\"Player {self.name!r} script exhausted — no more predetermined answers\"\n119\t            )\n120\t        return self._script.popleft()\n121\t\n122\t    @property\n123\t    def remaining_choices(self) -> int:\n124\t        \"\"\"Return the number of scripted answers remaining.\"\"\"\n125\t        return len(self._script)\n126\t\n127\t    def choose_target(self, options: Any, requirement: Any) -> Any:\n128\t        \"\"\"Return the next scripted target choice.\"\"\"\n129\t        return self._pop()\n130\t\n131\t    def choose(self, options: Any, description: str) -> Any:\n132\t        \"\"\"Return the next scripted choice.\"\"\"\n133\t        return self._pop()\n134\t\n135\t    def choose_yes_no(self, prompt: str) -> bool:\n136\t        \"\"\"Return the next scripted yes/no decision.\"\"\"\n137\t        return self._pop()\n138\t\n139\t    def assign_damage_order(self, attackers_or_blockers: Any) -> list[Any]:\n140\t        \"\"\"Return the next scripted damage ordering.\"\"\"\n141\t        return self._pop()\n142\t\n143\t    def choose_card(self, cards: Any, description: str) -> Any:\n144\t        \"\"\"Return the next scripted card choice.\"\"\"\n145\t        return self._pop()\n146\t"}]},"parent_tool_use_id":null,"session_id":"d616a92e-14a8-4e9f-8780-afe29cd109e3","uuid":"3f9b0e40-5145-429c-a6f4-439cae38e4d3","timestamp":"2026-06-04T08:54:53.837Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/player.py","content":"\"\"\"Player interface and deterministic test player implementation.\"\"\"\n\nfrom __future__ import annotations\n\nfrom abc import ABC, abstractmethod\nfrom collections import deque\nfrom typing import Any\n\nfrom engine.mana import ManaPool\nfrom engine.zones import Zones\n\n\nclass ScriptExhaustedError(Exception):\n    \"\"\"Raised when a DeterministicPlayer's script runs out of predetermined answers.\"\"\"\n\n\nclass Player(ABC):\n    \"\"\"Abstract base class for all players in the game.\n\n    Attributes:\n        name: The player's display name.\n        life: Current life total (default 20).\n        zones: Per-player zone containers.\n        mana_pool: The player's mana pool (forward ref; initialized to None until ManaPool is implemented).\n        has_lost: Whether this player has lost the game.\n        land_plays_remaining: Number of land plays remaining this turn.\n        drawn_from_empty_library: Whether this player attempted to draw from an empty library.\n    \"\"\"\n\n    def __init__(self, name: str, life: int = 20) -> None:\n        self.name: str = name\n        self.life: int = life\n        self.zones: Zones = Zones.new_player()\n        self.mana_pool: ManaPool = ManaPool()\n        self.has_lost: bool = False\n        self.land_plays_remaining: int = 1\n        self.drawn_from_empty_library: bool = False\n\n    @abstractmethod\n    def choose_target(self, options: Any, requirement: Any) -> Any:\n        \"\"\"Choose a target from the available options given a requirement.\n\n        Parameters:\n            options: The available targets to choose from.\n            requirement: The targeting requirement to satisfy.\n\n        Returns:\n            The chosen target.\n        \"\"\"\n\n    @abstractmethod\n    def choose(self, options: Any, description: str) -> Any:\n        \"\"\"Choose from a list of options.\n\n        Parameters:\n            options: The available choices.\n            description: Human-readable description of the choice.\n\n        Returns:\n            The chosen option.\n        \"\"\"\n\n    @abstractmethod\n    def choose_yes_no(self, prompt: str) -> bool:\n        \"\"\"Make a yes/no decision.\n\n        Parameters:\n            prompt: Human-readable prompt for the decision.\n\n        Returns:\n            True for yes, False for no.\n        \"\"\"\n\n    @abstractmethod\n    def assign_damage_order(self, attackers_or_blockers: Any) -> list[Any]:\n        \"\"\"Assign a damage ordering to attackers or blockers.\n\n        Parameters:\n            attackers_or_blockers: The creatures to order.\n\n        Returns:\n            An ordered list representing the damage assignment order.\n        \"\"\"\n\n    @abstractmethod\n    def choose_card(self, cards: Any, description: str) -> Any:\n        \"\"\"Choose a card from a collection.\n\n        Parameters:\n            cards: The available cards to choose from.\n            description: Human-readable description of why a card is being chosen.\n\n        Returns:\n            The chosen card.\n        \"\"\"\n\n\nclass DeterministicPlayer(Player):\n    \"\"\"A scripted player for testing that returns predetermined answers.\n\n    Each abstract method call pops the next answer from the front of the\n    script queue. Raises :class:`ScriptExhaustedError` if the script is empty\n    when a choice is requested.\n    \"\"\"\n\n    def __init__(self, name: str, script: list[Any], life: int = 20) -> None:\n        super().__init__(name, life)\n        self._script: deque[Any] = deque(script)\n\n    def _pop(self) -> Any:\n        \"\"\"Pop the next scripted answer from the queue.\n\n        Raises:\n            ScriptExhaustedError: If the script has no remaining answers.\n        \"\"\"\n        if not self._script:\n            raise ScriptExhaustedError(\n                f\"Player {self.name!r} script exhausted — no more predetermined answers\"\n            )\n        return self._script.popleft()\n\n    @property\n    def remaining_choices(self) -> int:\n        \"\"\"Return the number of scripted answers remaining.\"\"\"\n        return len(self._script)\n\n    def choose_target(self, options: Any, requirement: Any) -> Any:\n        \"\"\"Return the next scripted target choice.\"\"\"\n        return self._pop()\n\n    def choose(self, options: Any, description: str) -> Any:\n        \"\"\"Return the next scripted choice.\"\"\"\n        return self._pop()\n\n    def choose_yes_no(self, prompt: str) -> bool:\n        \"\"\"Return the next scripted yes/no decision.\"\"\"\n        return self._pop()\n\n    def assign_damage_order(self, attackers_or_blockers: Any) -> list[Any]:\n        \"\"\"Return the next scripted damage ordering.\"\"\"\n        return self._pop()\n\n    def choose_card(self, cards: Any, description: str) -> Any:\n        \"\"\"Return the next scripted card choice.\"\"\"\n        return self._pop()\n","numLines":146,"startLine":1,"totalLines":146}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K34o47oJmEdYpStMZNV73v","type":"tool_result","content":"1\t\"\"\"Basic land implementations — Plains, Island, Swamp, Mountain, Forest.\n2\t\n3\tEach basic land:\n4\t- Subclasses :class:`~engine.card.Land`.\n5\t- Has ``supertypes = {Supertype.BASIC}``.\n6\t- Has a subtype matching its land type (e.g. ``{\"Plains\"}``).\n7\t- Provides a :class:`~engine.card.ManaAbility` that taps to produce\n8\t  one mana of its associated color.\n9\t\n10\tUse :func:`register_basic_lands` to register all five with a\n11\t:class:`~cards.registry.CardRegistry`.\n12\t\"\"\"\n13\t\n14\tfrom __future__ import annotations\n15\t\n16\tfrom typing import TYPE_CHECKING, Any\n17\t\n18\tfrom engine.card import Land, ManaAbility\n19\tfrom engine.types import ManaType, Supertype\n20\t\n21\tif TYPE_CHECKING:\n22\t    from engine.game_state import GameState\n23\t    from engine.player import Player\n24\t\n25\t    from cards.registry import CardRegistry\n26\t\n27\t\n28\t# ---------------------------------------------------------------------------\n29\t# Mana-ability helpers\n30\t# ---------------------------------------------------------------------------\n31\t\n32\tdef _tap_cost(game: GameState, source: Any) -> bool:\n33\t    \"\"\"Generic tap-cost: check untapped, then tap.\n34\t\n35\t    Mirrors :func:`engine.abilities.tap_cost` logic so basic lands\n36\t    can be activated through the abilities system or directly.\n37\t    \"\"\"\n38\t    if getattr(source, \"is_tapped\", False):\n39\t        return False\n40\t    source.is_tapped = True\n41\t    return True\n42\t\n43\t\n44\tdef _make_mana_effect(mana_type: ManaType):\n45\t    \"\"\"Return an effect callable that adds 1 mana of *mana_type* to the controller's pool.\"\"\"\n46\t\n47\t    def _effect(game: GameState) -> None:  # noqa: ARG001 – game needed for signature\n48\t        # The source is captured via the ability's activation context.\n49\t        # However, ManaAbility.mana_produced is called by activate_ability's\n50\t        # effect path.  We need to figure out who the controller is.\n51\t        # This is handled at activation time — see get_mana_abilities below.\n52\t        pass\n53\t\n54\t    return _effect\n55\t\n56\t\n57\t# ---------------------------------------------------------------------------\n58\t# Basic land classes\n59\t# ---------------------------------------------------------------------------\n60\t\n61\tclass Plains(Land):\n62\t    \"\"\"Basic Plains — taps for {W}.\"\"\"\n63\t\n64\t    def __init__(self, **kwargs: Any) -> None:\n65\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n66\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Plains\"}\n67\t        super().__init__(**kwargs)\n68\t\n69\t    def get_mana_abilities(self) -> list[ManaAbility]:\n70\t        \"\"\"Return a single mana ability: {T}: Add {W}.\"\"\"\n71\t        source = self\n72\t\n73\t        def _effect(game: GameState) -> None:\n74\t            controller = source.controller\n75\t            if controller is not None:\n76\t                controller.mana_pool.add(ManaType.WHITE, 1)\n77\t\n78\t        return [\n79\t            ManaAbility(\n80\t                cost=_tap_cost,\n81\t                mana_produced=_effect,\n82\t                description=\"{T}: Add {W}.\",\n83\t            )\n84\t        ]\n85\t\n86\t\n87\tclass Island(Land):\n88\t    \"\"\"Basic Island — taps for {U}.\"\"\"\n89\t\n90\t    def __init__(self, **kwargs: Any) -> None:\n91\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n92\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Island\"}\n93\t        super().__init__(**kwargs)\n94\t\n95\t    def get_mana_abilities(self) -> list[ManaAbility]:\n96\t        \"\"\"Return a single mana ability: {T}: Add {U}.\"\"\"\n97\t        source = self\n98\t\n99\t        def _effect(game: GameState) -> None:\n100\t            controller = source.controller\n101\t            if controller is not None:\n102\t                controller.mana_pool.add(ManaType.BLUE, 1)\n103\t\n104\t        return [\n105\t            ManaAbility(\n106\t                cost=_tap_cost,\n107\t                mana_produced=_effect,\n108\t                description=\"{T}: Add {U}.\",\n109\t            )\n110\t        ]\n111\t\n112\t\n113\tclass Swamp(Land):\n114\t    \"\"\"Basic Swamp — taps for {B}.\"\"\"\n115\t\n116\t    def __init__(self, **kwargs: Any) -> None:\n117\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n118\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Swamp\"}\n119\t        super().__init__(**kwargs)\n120\t\n121\t    def get_mana_abilities(self) -> list[ManaAbility]:\n122\t        \"\"\"Return a single mana ability: {T}: Add {B}.\"\"\"\n123\t        source = self\n124\t\n125\t        def _effect(game: GameState) -> None:\n126\t            controller = source.controller\n127\t            if controller is not None:\n128\t                controller.mana_pool.add(ManaType.BLACK, 1)\n129\t\n130\t        return [\n131\t            ManaAbility(\n132\t                cost=_tap_cost,\n133\t                mana_produced=_effect,\n134\t                description=\"{T}: Add {B}.\",\n135\t            )\n136\t        ]\n137\t\n138\t\n139\tclass Mountain(Land):\n140\t    \"\"\"Basic Mountain — taps for {R}.\"\"\"\n141\t\n142\t    def __init__(self, **kwargs: Any) -> None:\n143\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n144\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Mountain\"}\n145\t        super().__init__(**kwargs)\n146\t\n147\t    def get_mana_abilities(self) -> list[ManaAbility]:\n148\t        \"\"\"Return a single mana ability: {T}: Add {R}.\"\"\"\n149\t        source = self\n150\t\n151\t        def _effect(game: GameState) -> None:\n152\t            controller = source.controller\n153\t            if controller is not None:\n154\t                controller.mana_pool.add(ManaType.RED, 1)\n155\t\n156\t        return [\n157\t            ManaAbility(\n158\t                cost=_tap_cost,\n159\t                mana_produced=_effect,\n160\t                description=\"{T}: Add {R}.\",\n161\t            )\n162\t        ]\n163\t\n164\t\n165\tclass Forest(Land):\n166\t    \"\"\"Basic Forest — taps for {G}.\"\"\"\n167\t\n168\t    def __init__(self, **kwargs: Any) -> None:\n169\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n170\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Forest\"}\n171\t        super().__init__(**kwargs)\n172\t\n173\t    def get_mana_abilities(self) -> list[ManaAbility]:\n174\t        \"\"\"Return a single mana ability: {T}: Add {G}.\"\"\"\n175\t        source = self\n176\t\n177\t        def _effect(game: GameState) -> None:\n178\t            controller = source.controller\n179\t            if controller is not None:\n180\t                controller.mana_pool.add(ManaType.GREEN, 1)\n181\t\n182\t        return [\n183\t            ManaAbility(\n184\t                cost=_tap_cost,\n185\t                mana_produced=_effect,\n186\t                description=\"{T}: Add {G}.\",\n187\t            )\n188\t        ]\n189\t\n190\t\n191\t# ---------------------------------------------------------------------------\n192\t# Registration helper\n193\t# ---------------------------------------------------------------------------\n194\t\n195\tdef register_basic_lands(registry: CardRegistry) -> None:\n196\t    \"\"\"Register all five basic lands with *registry*.\n197\t\n198\t    Each is registered under its canonical name (e.g. ``\"Plains\"``) with\n199\t    :class:`~cards.registry.CardMetadata` reflecting its type line, colors,\n200\t    and lack of mana cost.\n201\t    \"\"\"\n202\t    from cards.registry import CardMetadata\n203\t\n204\t    _BASIC_LANDS: list[tuple[str, type[Land], str]] = [\n205\t        (\"Plains\", Plains, \"W\"),\n206\t        (\"Island\", Island, \"U\"),\n207\t        (\"Swamp\", Swamp, \"B\"),\n208\t        (\"Mountain\", Mountain, \"R\"),\n209\t        (\"Forest\", Forest, \"G\"),\n210\t    ]\n211\t\n212\t    for card_name, impl_class, mana_symbol in _BASIC_LANDS:\n213\t        metadata = CardMetadata(\n214\t            name=card_name,\n215\t            mana_cost_str=\"\",\n216\t            type_line=f\"Basic Land — {card_name}\",\n217\t            oracle_text=f\"({{T}}: Add {{{mana_symbol}}}.)\",\n218\t            power=None,\n219\t            toughness=None,\n220\t            colors=[],\n221\t            keywords=[],\n222\t            rarity=\"common\",\n223\t            set_code=\"\",\n224\t            collector_number=\"\",\n225\t        )\n226\t        registry.register(card_name, impl_class, metadata)\n227\t"}]},"parent_tool_use_id":null,"session_id":"d616a92e-14a8-4e9f-8780-afe29cd109e3","uuid":"dff351be-eb4b-48ee-bbe0-4c24c16b6858","timestamp":"2026-06-04T08:54:53.838Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/basic_lands.py","content":"\"\"\"Basic land implementations — Plains, Island, Swamp, Mountain, Forest.\n\nEach basic land:\n- Subclasses :class:`~engine.card.Land`.\n- Has ``supertypes = {Supertype.BASIC}``.\n- Has a subtype matching its land type (e.g. ``{\"Plains\"}``).\n- Provides a :class:`~engine.card.ManaAbility` that taps to produce\n  one mana of its associated color.\n\nUse :func:`register_basic_lands` to register all five with a\n:class:`~cards.registry.CardRegistry`.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import Land, ManaAbility\nfrom engine.types import ManaType, Supertype\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n    from cards.registry import CardRegistry\n\n\n# ---------------------------------------------------------------------------\n# Mana-ability helpers\n# ---------------------------------------------------------------------------\n\ndef _tap_cost(game: GameState, source: Any) -> bool:\n    \"\"\"Generic tap-cost: check untapped, then tap.\n\n    Mirrors :func:`engine.abilities.tap_cost` logic so basic lands\n    can be activated through the abilities system or directly.\n    \"\"\"\n    if getattr(source, \"is_tapped\", False):\n        return False\n    source.is_tapped = True\n    return True\n\n\ndef _make_mana_effect(mana_type: ManaType):\n    \"\"\"Return an effect callable that adds 1 mana of *mana_type* to the controller's pool.\"\"\"\n\n    def _effect(game: GameState) -> None:  # noqa: ARG001 – game needed for signature\n        # The source is captured via the ability's activation context.\n        # However, ManaAbility.mana_produced is called by activate_ability's\n        # effect path.  We need to figure out who the controller is.\n        # This is handled at activation time — see get_mana_abilities below.\n        pass\n\n    return _effect\n\n\n# ---------------------------------------------------------------------------\n# Basic land classes\n# ---------------------------------------------------------------------------\n\nclass Plains(Land):\n    \"\"\"Basic Plains — taps for {W}.\"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Plains\"}\n        super().__init__(**kwargs)\n\n    def get_mana_abilities(self) -> list[ManaAbility]:\n        \"\"\"Return a single mana ability: {T}: Add {W}.\"\"\"\n        source = self\n\n        def _effect(game: GameState) -> None:\n            controller = source.controller\n            if controller is not None:\n                controller.mana_pool.add(ManaType.WHITE, 1)\n\n        return [\n            ManaAbility(\n                cost=_tap_cost,\n                mana_produced=_effect,\n                description=\"{T}: Add {W}.\",\n            )\n        ]\n\n\nclass Island(Land):\n    \"\"\"Basic Island — taps for {U}.\"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Island\"}\n        super().__init__(**kwargs)\n\n    def get_mana_abilities(self) -> list[ManaAbility]:\n        \"\"\"Return a single mana ability: {T}: Add {U}.\"\"\"\n        source = self\n\n        def _effect(game: GameState) -> None:\n            controller = source.controller\n            if controller is not None:\n                controller.mana_pool.add(ManaType.BLUE, 1)\n\n        return [\n            ManaAbility(\n                cost=_tap_cost,\n                mana_produced=_effect,\n                description=\"{T}: Add {U}.\",\n            )\n        ]\n\n\nclass Swamp(Land):\n    \"\"\"Basic Swamp — taps for {B}.\"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Swamp\"}\n        super().__init__(**kwargs)\n\n    def get_mana_abilities(self) -> list[ManaAbility]:\n        \"\"\"Return a single mana ability: {T}: Add {B}.\"\"\"\n        source = self\n\n        def _effect(game: GameState) -> None:\n            controller = source.controller\n            if controller is not None:\n                controller.mana_pool.add(ManaType.BLACK, 1)\n\n        return [\n            ManaAbility(\n                cost=_tap_cost,\n                mana_produced=_effect,\n                description=\"{T}: Add {B}.\",\n            )\n        ]\n\n\nclass Mountain(Land):\n    \"\"\"Basic Mountain — taps for {R}.\"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Mountain\"}\n        super().__init__(**kwargs)\n\n    def get_mana_abilities(self) -> list[ManaAbility]:\n        \"\"\"Return a single mana ability: {T}: Add {R}.\"\"\"\n        source = self\n\n        def _effect(game: GameState) -> None:\n            controller = source.controller\n            if controller is not None:\n                controller.mana_pool.add(ManaType.RED, 1)\n\n        return [\n            ManaAbility(\n                cost=_tap_cost,\n                mana_produced=_effect,\n                description=\"{T}: Add {R}.\",\n            )\n        ]\n\n\nclass Forest(Land):\n    \"\"\"Basic Forest — taps for {G}.\"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.BASIC}\n        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Forest\"}\n        super().__init__(**kwargs)\n\n    def get_mana_abilities(self) -> list[ManaAbility]:\n        \"\"\"Return a single mana ability: {T}: Add {G}.\"\"\"\n        source = self\n\n        def _effect(game: GameState) -> None:\n            controller = source.controller\n            if controller is not None:\n                controller.mana_pool.add(ManaType.GREEN, 1)\n\n        return [\n            ManaAbility(\n                cost=_tap_cost,\n                mana_produced=_effect,\n                description=\"{T}: Add {G}.\",\n            )\n        ]\n\n\n# ---------------------------------------------------------------------------\n# Registration helper\n# ---------------------------------------------------------------------------\n\ndef register_basic_lands(registry: CardRegistry) -> None:\n    \"\"\"Register all five basic lands with *registry*.\n\n    Each is registered under its canonical name (e.g. ``\"Plains\"``) with\n    :class:`~cards.registry.CardMetadata` reflecting its type line, colors,\n    and lack of mana cost.\n    \"\"\"\n    from cards.registry import CardMetadata\n\n    _BASIC_LANDS: list[tuple[str, type[Land], str]] = [\n        (\"Plains\", Plains, \"W\"),\n        (\"Island\", Island, \"U\"),\n        (\"Swamp\", Swamp, \"B\"),\n        (\"Mountain\", Mountain, \"R\"),\n        (\"Forest\", Forest, \"G\"),\n    ]\n\n    for card_name, impl_class, mana_symbol in _BASIC_LANDS:\n        metadata = CardMetadata(\n            name=card_name,\n            mana_cost_str=\"\",\n            type_line=f\"Basic Land — {card_name}\",\n            oracle_text=f\"({{T}}: Add {{{mana_symbol}}}.)\",\n            power=None,\n            toughness=None,\n            colors=[],\n            keywords=[],\n            rarity=\"common\",\n            set_code=\"\",\n            collector_number=\"\",\n        )\n        registry.register(card_name, impl_class, metadata)\n","numLines":227,"startLine":1,"totalLines":227}}}
