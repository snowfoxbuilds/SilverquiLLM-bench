{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EgXprxfpEjoVnwi4EdYeag","type":"tool_result","content":"278\tdef cast_spell_free(\n279\t    game: GameState,\n280\t    player: Player,\n281\t    card: CardImpl,\n282\t    from_zone: Zone,\n283\t) -> None:\n284\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n285\t\n286\t    This is used by effects that allow casting from zones other than hand\n287\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n288\t    or cascade.\n289\t\n290\t    Pipeline\n291\t    --------\n292\t    1. **can_cast** — ask the card whether it can legally be cast (same\n293\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n294\t    2. Move *card* from *from_zone* to the stack zone.\n295\t    3. Choose targets (if applicable) with validation and protection check.\n296\t    4. Call ``on_cast`` hook.\n297\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n298\t       resolution normally (permanents → battlefield, non-permanents →\n299\t       graveyard).\n300\t\n301\t    No timing check or mana payment is performed.  The spell goes on the\n302\t    stack and can be responded to normally (e.g. countered).\n303\t\n304\t    If targeting or other post-move checks fail, the card is rolled back\n305\t    to its source zone.\n306\t\n307\t    Parameters:\n308\t        game: The current game state.\n309\t        player: The player casting the spell.\n310\t        card: The card to cast.\n311\t        from_zone: The zone the card is currently in.\n312\t\n313\t    Raises:\n314\t        CastingError: If the card cannot be found in *from_zone* or\n315\t            legality checks fail.\n316\t    \"\"\"\n317\t    from engine.zones import move_to_zone\n318\t\n319\t    # Ensure controller is set\n320\t    card.controller = player\n321\t    if card.owner is None:\n322\t        card.owner = player\n323\t\n324\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n325\t    if not card.can_cast(game):\n326\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n327\t\n328\t    # 2. Locate card in source zone\n329\t    source_zone_container = player.zones[from_zone]\n330\t    if not source_zone_container.contains(card):\n331\t        # Try to find the card in any player's zone\n332\t        source_zone_container = None\n333\t        for p in game.players:\n334\t            z = p.zones[from_zone]\n335\t            if z.contains(card):\n336\t                source_zone_container = z\n337\t                break"}]},"parent_tool_use_id":null,"session_id":"feeb00d4-a69a-45e3-8d4a-c1e07df7c37b","uuid":"83c50689-6d44-49f4-9da1-303a31a1c2f3","timestamp":"2026-06-04T12:28:07.299Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"def cast_spell_free(\n    game: GameState,\n    player: Player,\n    card: CardImpl,\n    from_zone: Zone,\n) -> None:\n    \"\"\"Cast *card* without paying its mana cost, using the stack.\n\n    This is used by effects that allow casting from zones other than hand\n    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n    or cascade.\n\n    Pipeline\n    --------\n    1. **can_cast** — ask the card whether it can legally be cast (same\n       legality as :func:`cast_spell`, minus mana/timing constraints).\n    2. Move *card* from *from_zone* to the stack zone.\n    3. Choose targets (if applicable) with validation and protection check.\n    4. Call ``on_cast`` hook.\n    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n       resolution normally (permanents → battlefield, non-permanents →\n       graveyard).\n\n    No timing check or mana payment is performed.  The spell goes on the\n    stack and can be responded to normally (e.g. countered).\n\n    If targeting or other post-move checks fail, the card is rolled back\n    to its source zone.\n\n    Parameters:\n        game: The current game state.\n        player: The player casting the spell.\n        card: The card to cast.\n        from_zone: The zone the card is currently in.\n\n    Raises:\n        CastingError: If the card cannot be found in *from_zone* or\n            legality checks fail.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Ensure controller is set\n    card.controller = player\n    if card.owner is None:\n        card.owner = player\n\n    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 2. Locate card in source zone\n    source_zone_container = player.zones[from_zone]\n    if not source_zone_container.contains(card):\n        # Try to find the card in any player's zone\n        source_zone_container = None\n        for p in game.players:\n            z = p.zones[from_zone]\n            if z.contains(card):\n                source_zone_container = z\n                break","numLines":60,"startLine":278,"totalLines":525}}}
