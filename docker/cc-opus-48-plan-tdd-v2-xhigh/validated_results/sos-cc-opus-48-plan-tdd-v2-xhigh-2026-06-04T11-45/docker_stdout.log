{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01U3e9zaZAUiuiu7a9qT9QjK","type":"tool_result","content":"412\tdef _resolve_spell(\n413\t    game: GameState,\n414\t    card: CardImpl,\n415\t    player: Player,\n416\t    stack_obj: StackObject,\n417\t) -> None:\n418\t    \"\"\"Resolve *card* cast by *player*.\n419\t\n420\t    1. Call ``card.on_resolve(game, targets=targets)``.\n421\t    2. Remove the card from the stack zone.\n422\t    3. If the card is a permanent type, move it to the battlefield via\n423\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n424\t       registration and the ETB event).\n425\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n426\t    \"\"\"\n427\t    from engine.zones import move_to_zone\n428\t\n429\t    # Read targets from the StackObject — the single source of truth.\n430\t    # Set chosen_targets on the card just before resolution so that\n431\t    # _get_chosen_target helpers (which read via getattr) work.\n432\t    targets = stack_obj.targets\n433\t    if targets is not None:\n434\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n435\t\n436\t    card.on_resolve(game)\n437\t\n438\t    if card.card_types & _PERMANENT_TYPES:\n439\t        # Move from stack to battlefield via move_to_zone, which handles\n440\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n441\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n442\t    elif getattr(card, \"_exile_on_resolve\", False):\n443\t        # \"If that spell would be put into your graveyard, exile it instead.\"\n444\t        move_to_zone(game, card, Zone.STACK, Zone.EXILE)\n445\t    else:\n446\t        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n447\t        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n448\t\n449\t\n450\t# ------------------------------------------------------------------\n451\t# Play land (special action — does not use the stack)"}]},"parent_tool_use_id":null,"session_id":"feeb00d4-a69a-45e3-8d4a-c1e07df7c37b","uuid":"b09afb32-ac22-4c31-bd3b-3b7b2af76ca0","timestamp":"2026-06-04T12:36:04.413Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"def _resolve_spell(\n    game: GameState,\n    card: CardImpl,\n    player: Player,\n    stack_obj: StackObject,\n) -> None:\n    \"\"\"Resolve *card* cast by *player*.\n\n    1. Call ``card.on_resolve(game, targets=targets)``.\n    2. Remove the card from the stack zone.\n    3. If the card is a permanent type, move it to the battlefield via\n       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n       registration and the ETB event).\n    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Read targets from the StackObject — the single source of truth.\n    # Set chosen_targets on the card just before resolution so that\n    # _get_chosen_target helpers (which read via getattr) work.\n    targets = stack_obj.targets\n    if targets is not None:\n        card.chosen_targets = targets  # type: ignore[attr-defined]\n\n    card.on_resolve(game)\n\n    if card.card_types & _PERMANENT_TYPES:\n        # Move from stack to battlefield via move_to_zone, which handles\n        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n    elif getattr(card, \"_exile_on_resolve\", False):\n        # \"If that spell would be put into your graveyard, exile it instead.\"\n        move_to_zone(game, card, Zone.STACK, Zone.EXILE)\n    else:\n        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n\n\n# ------------------------------------------------------------------\n# Play land (special action — does not use the stack)","numLines":40,"startLine":412,"totalLines":525}}}
