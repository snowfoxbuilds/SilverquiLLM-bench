{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013gUM5aw5syScaBjZwFStsR","type":"tool_result","content":"89\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n90\t    \"\"\"Return the generic mana reduction for casting *card*.\n91\t\n92\t    Queries ``card.cost_reduction(game)`` and clamps the result so that\n93\t    the generic portion of the mana cost cannot go below 0.\n94\t\n95\t    This is a simplified single-card self-reduction model.  Full MTG\n96\t    cost-reduction interactions (Trinisphere, multiple reductions from\n97\t    different sources) are deferred.\n98\t    \"\"\"\n99\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n100\t    # casting player even when the card was never explicitly assigned one.\n101\t    prev_controller = card.controller\n102\t    card.controller = controller\n103\t    raw = card.cost_reduction(game)\n104\t    # Other permanents you control may grant cost reduction to this spell\n105\t    # (e.g. Witherbloom granting affinity-for-creatures to your instants\n106\t    # and sorceries).  Sum in any such grants from the battlefield.\n107\t    for obj in game.get_battlefield(controller).get_all():\n108\t        grant = getattr(obj, \"grants_cost_reduction\", None)\n109\t        if grant is not None:\n110\t            raw += grant(game, card, controller)\n111\t    # Restore previous controller in case the caller doesn't want a\n112\t    # side-effect (get_cost_reduction is a query, not a mutation).\n113\t    card.controller = prev_controller\n114\t    generic = card.mana_cost.generic if card.mana_cost else 0\n115\t    return max(0, min(raw, generic))\n116\t\n117\t\n118\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n119\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n120\t    new_generic = max(0, cost.generic - reduction)\n121\t    return ManaCost(\n122\t        generic=new_generic,\n123\t        pips=dict(cost.pips),\n124\t        x_count=cost.x_count,\n125\t        hybrid=list(cost.hybrid),\n126\t    )\n127\t\n128\t\n129\t# ------------------------------------------------------------------\n130\t# Cast spell\n131\t# ------------------------------------------------------------------\n132\t\n133\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:"}]},"parent_tool_use_id":null,"session_id":"feeb00d4-a69a-45e3-8d4a-c1e07df7c37b","uuid":"a464d415-1508-4065-ad3a-77cb63537d9f","timestamp":"2026-06-04T12:16:01.362Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"def get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n    \"\"\"Return the generic mana reduction for casting *card*.\n\n    Queries ``card.cost_reduction(game)`` and clamps the result so that\n    the generic portion of the mana cost cannot go below 0.\n\n    This is a simplified single-card self-reduction model.  Full MTG\n    cost-reduction interactions (Trinisphere, multiple reductions from\n    different sources) are deferred.\n    \"\"\"\n    # Ensure card.controller is set so the hook can reference \"you\" / the\n    # casting player even when the card was never explicitly assigned one.\n    prev_controller = card.controller\n    card.controller = controller\n    raw = card.cost_reduction(game)\n    # Other permanents you control may grant cost reduction to this spell\n    # (e.g. Witherbloom granting affinity-for-creatures to your instants\n    # and sorceries).  Sum in any such grants from the battlefield.\n    for obj in game.get_battlefield(controller).get_all():\n        grant = getattr(obj, \"grants_cost_reduction\", None)\n        if grant is not None:\n            raw += grant(game, card, controller)\n    # Restore previous controller in case the caller doesn't want a\n    # side-effect (get_cost_reduction is a query, not a mutation).\n    card.controller = prev_controller\n    generic = card.mana_cost.generic if card.mana_cost else 0\n    return max(0, min(raw, generic))\n\n\ndef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n    new_generic = max(0, cost.generic - reduction)\n    return ManaCost(\n        generic=new_generic,\n        pips=dict(cost.pips),\n        x_count=cost.x_count,\n        hybrid=list(cost.hybrid),\n    )\n\n\n# ------------------------------------------------------------------\n# Cast spell\n# ------------------------------------------------------------------\n\ndef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:","numLines":45,"startLine":89,"totalLines":525}}}
