{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RLGvzBoiXJ9rBa3sy88Hx5","type":"tool_result","content":"1\t\"\"\"Card implementation for Lightshell Duo.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.types import Keyword, ManaCost, Zone\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t\n13\t\n14\tclass LightshellDuo(Creature):\n15\t    \"\"\"Lightshell Duo — {3}{U} — 3/4 — Rat Otter — Prowess.\n16\t\n17\t    When this creature enters, surveil 2.\n18\t\n19\t    FDN collector number 157.\n20\t    \"\"\"\n21\t\n22\t    def __init__(self, **kwargs: Any) -> None:\n23\t        kwargs.setdefault(\"name\", \"Lightshell Duo\")\n24\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{3}{U}\"))\n25\t        kwargs.setdefault(\"subtypes\", {\"Rat\", \"Otter\"})\n26\t        kwargs.setdefault(\"keywords\", Keyword.PROWESS)\n27\t        kwargs.setdefault(\"base_power\", 3)\n28\t        kwargs.setdefault(\"base_toughness\", 4)\n29\t        kwargs.setdefault(\n30\t            \"rules_text\",\n31\t            \"Prowess\\nWhen this creature enters, surveil 2.\",\n32\t        )\n33\t        super().__init__(**kwargs)\n34\t\n35\t    def on_resolve(self, game: \"GameState\") -> None:\n36\t        \"\"\"ETB: surveil 2.\"\"\"\n37\t        controller = self.controller\n38\t        if controller is None:\n39\t            return\n40\t        library = controller.zones[Zone.LIBRARY]\n41\t        cards = list(library.get_all())\n42\t        if not cards:\n43\t            return\n44\t        top_cards = cards[-min(2, len(cards)):]\n45\t        for card in reversed(top_cards):\n46\t            put_in_gy = controller.choose_yes_no(\n47\t                f\"Surveil: Put {getattr(card, 'name', 'card')} into your graveyard?\"\n48\t            )\n49\t            if put_in_gy:\n50\t                library.remove(card)\n51\t       