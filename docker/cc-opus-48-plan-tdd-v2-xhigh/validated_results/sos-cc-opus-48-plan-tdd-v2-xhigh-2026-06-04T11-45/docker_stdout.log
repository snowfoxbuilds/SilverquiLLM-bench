{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CXhRrBXuwk2e4e2PoJdXW4","type":"tool_result","content":"1\t\"\"\"Card implementation for Progenitus.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom typing import TYPE_CHECKING, Any\n4\tfrom engine.card import Creature\n5\tfrom engine.protection import ProtectionAbility\n6\tfrom engine.events import MoveToGraveyardReplacementEvent\n7\tfrom engine.replacement_effects import ReplacementEffect\n8\tfrom engine.types import ManaCost, Supertype, Zone\n9\tif TYPE_CHECKING:\n10\t    from engine.game_state import GameState\n11\t\n12\tclass Progenitus(Creature):\n13\t    \"\"\"Progenitus — {W}{W}{U}{U}{B}{B}{R}{R}{G}{G} — 10/10 — Legendary Hydra Avatar.\n14\t\n15\t    Protection from everything.\n16\t    If Progenitus would be put into a graveyard from anywhere, reveal\n17\t    Progenitus and shuffle it into its owner's library instead.\n18\t\n19\t    FDN collector number 244.\n20\t    \"\"\"\n21\t\n22\t    def __init__(self, **kwargs: Any) -> None:\n23\t        kwargs.setdefault('name', 'Progenitus')\n24\t        kwargs.setdefault('mana_cost', ManaCost.parse('{W}{W}{U}{U}{B}{B}{R}{R}{G}{G}'))\n25\t        kwargs.setdefault('subtypes', {'Hydra', 'Avatar'})\n26\t        kwargs.setdefault('supertypes', {Supertype.LEGENDARY})\n27\t        kwargs.setdefault('base_power', 10)\n28\t        kwargs.setdefault('base_toughness', 10)\n29\t        kwargs.setdefault('rules_text', \"Protection from everything\\nIf Progenitus would be put into a graveyard from anywhere, reveal Progenitus and shuffle it into its owner's library instead.\")\n30\t        super().__init__(**kwargs)\n31\t        self._init_protection()\n32\t\n33\t    def _init_protection(self) -> None:\n34\t        \"\"\"Set up protection from everything. Called from __init__ and\n35\t        can be re-invoked after characteristic resets.\"\"\"\n36\t        self.protections = [ProtectionAbility(quality='everything', predicate=lambda source: True)]\n37\t\n38\t    def _reset_characteristics(self) -> None:\n39\t        \"\"\"Override to reapply protection from everything after reset.\"\"\"\n40\t        super()._reset_characteristics()\n41\t        self._init_protection()\n42\t\n43\t    def register_replacement_effects(self, game: 'GameState') -> None:\n44\t        \"\"\"Register graveyard-shuffle replacement effect.\n45\t\n46\t        Registers a single :class:`~engine.events.MoveToGraveyardReplacementEvent`\n47\t        handler; the engine's zone-move pipeline dispatches subclass events\n48\t        (creature_dies, sacrifice, etc.) to this parent-type handler automatically.\n49\t        \"\"\"\n50\t        source = self\n51\t\n52\t        def _condition(game: Any, event: dict) -> bool:\n53\t            return event.card is source\n54\t\n55\t        def _replacement(game: Any, event: dict) -> dict:\n56\t            owner = getattr(source, 'owner', None)\n57\t            if owner is not None:\n58\t                library = owner.zones[Zone.LIBRARY]\n59\t                library.add(source)\n60\t                library.shuffle()\n61\t            event.prevented = True\n62\t            return event\n63\t        controller = getattr(self, 'controller', None)\n64\t        game.replacement_manager.register(ReplacementEffect(event_type=MoveToGraveyardReplacementEvent, source=self, condition=_condition, replacement=_replacement, controller=controller))\n65\t"}]},"parent_tool_use_id":null,"session_id":"1f0f0606-b316-4229-9b01-03fec511ba77","uuid":"27fe1138-436f-47ac-967d-9dc8ebfdba51","timestamp":"2026-06-04T11:53:04.938Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_244/card_impl.py","content":"\"\"\"Card implementation for Progenitus.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import Creature\nfrom engine.protection import ProtectionAbility\nfrom engine.events import MoveToGraveyardReplacementEvent\nfrom engine.replacement_effects import ReplacementEffect\nfrom engine.types import ManaCost, Supertype, Zone\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\nclass Progenitus(Creature):\n    \"\"\"Progenitus — {W}{W}{U}{U}{B}{B}{R}{R}{G}{G} — 10/10 — Legendary Hydra Avatar.\n\n    Protection from everything.\n    If Progenitus would be put into a graveyard from anywhere, reveal\n    Progenitus and shuffle it into its owner's library instead.\n\n    FDN collector number 244.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Progenitus')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{W}{W}{U}{U}{B}{B}{R}{R}{G}{G}'))\n        kwargs.setdefault('subtypes', {'Hydra', 'Avatar'})\n        kwargs.setdefault('supertypes', {Supertype.LEGENDARY})\n        kwargs.setdefault('base_power', 10)\n        kwargs.setdefault('base_toughness', 10)\n        kwargs.setdefault('rules_text', \"Protection from everything\\nIf Progenitus would be put into a graveyard from anywhere, reveal Progenitus and shuffle it into its owner's library instead.\")\n        super().__init__(**kwargs)\n        self._init_protection()\n\n    def _init_protection(self) -> None:\n        \"\"\"Set up protection from everything. Called from __init__ and\n        can be re-invoked after characteristic resets.\"\"\"\n        self.protections = [ProtectionAbility(quality='everything', predicate=lambda source: True)]\n\n    def _reset_characteristics(self) -> None:\n        \"\"\"Override to reapply protection from everything after reset.\"\"\"\n        super()._reset_characteristics()\n        self._init_protection()\n\n    def register_replacement_effects(self, game: 'GameState') -> None:\n        \"\"\"Register graveyard-shuffle replacement effect.\n\n        Registers a single :class:`~engine.events.MoveToGraveyardReplacementEvent`\n        handler; the engine's zone-move pipeline dispatches subclass events\n        (creature_dies, sacrifice, etc.) to this parent-type handler automatically.\n        \"\"\"\n        source = self\n\n        def _condition(game: Any, event: dict) -> bool:\n            return event.card is source\n\n        def _replacement(game: Any, event: dict) -> dict:\n            owner = getattr(source, 'owner', None)\n            if owner is not None:\n                library = owner.zones[Zone.LIBRARY]\n                library.add(source)\n                library.shuffle()\n            event.prevented = True\n            return event\n        controller = getattr(self, 'controller', None)\n        game.replacement_manager.register(ReplacementEffect(event_type=MoveToGraveyardReplacementEvent, source=self, condition=_condition, replacement=_replacement, controller=controller))\n","numLines":65,"startLine":1,"totalLines":65}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AF3u98haCG3KygoMgvBHUj","type":"tool_result","content":"1\t\"\"\"Reference test for FDN 244 — Progenitus.\n2\t\n3\tIllustrative test covering **replacement effects** via\n4\t``game.replacement_manager.register()``. Progenitus has a continuous\n5\treplacement that intercepts any ``MoveToGraveyardReplacementEvent``\n6\ttargeting itself and redirects the card to its owner's library instead\n7\tof the graveyard. The replacement callback sets ``event.prevented`` to\n8\tsignal that the engine should skip its own zone move, and returns the\n9\tmodified event.\n10\t\"\"\"\n11\t\n12\tfrom __future__ import annotations\n13\t\n14\tfrom cards.fdn.fdn_244.card_impl import Progenitus\n15\tfrom engine.card import Creature\n16\tfrom engine.events import (\n17\t    CreatureDiesReplacementEvent,\n18\t    MoveToGraveyardReplacementEvent,\n19\t)\n20\tfrom engine.replacement_effects import ReplacementEffect\n21\tfrom engine.types import ManaCost, Supertype, Zone\n22\tfrom test_utils import create_game\n23\t\n24\t\n25\tclass TestProgenitusProperties:\n26\t    \"\"\"Static card data should match the FDN 244 spec.\"\"\"\n27\t\n28\t    def test_name(self) -> None:\n29\t        assert Progenitus(owner=None).name == \"Progenitus\"\n30\t\n31\t    def test_mana_cost(self) -> None:\n32\t        cost = ManaCost.parse(\"{W}{W}{U}{U}{B}{B}{R}{R}{G}{G}\")\n33\t        assert Progenitus(owner=None).mana_cost == cost\n34\t\n35\t    def test_legendary_hydra_avatar(self) -> None:\n36\t        card = Progenitus(owner=None)\n37\t        assert Supertype.LEGENDARY in card.supertypes\n38\t        assert {\"Hydra\", \"Avatar\"} <= card.subtypes\n39\t\n40\t\n41\tclass TestProgenitusReplacementRegistration:\n42\t    \"\"\"register_replacement_effects must wire a ReplacementEffect for\n43\t    MoveToGraveyardReplacementEvent through the replacement_manager.\"\"\"\n44\t\n45\t    def test_registers_one_replacement_effect(self) -> None:\n46\t        game = create_game()\n47\t        p1 = game.players[0]\n48\t        card = Progenitus(owner=p1, controller=p1)\n49\t        before = len(game.replacement_manager._effects)\n50\t        card.register_replacement_effects(game)\n51\t        after = len(game.replacement_manager._effects)\n52\t        assert after - before == 1\n53\t\n54\t    def test_registered_replacement_uses_typed_event_class(self) -> None:\n55\t        \"\"\"The registered ReplacementEffect must use the typed\n56\t        MoveToGraveyardReplacementEvent class, not a string event name.\"\"\"\n57\t        game = create_game()\n58\t        p1 = game.players[0]\n59\t        card = Progenitus(owner=p1, controller=p1)\n60\t        card.register_replacement_effects(game)\n61\t        registered = next(\n62\t            (e for e in game.replacement_manager._effects if e.source is card),\n63\t            None,\n64\t        )\n65\t        assert registered is not None\n66\t        assert isinstance(registered, ReplacementEffect)\n67\t        assert registered.event_type is MoveToGraveyardReplacementEvent\n68\t\n69\t\n70\tclass TestProgenitusGraveyardReplacement:\n71\t    \"\"\"The replacement callback shuffles the card into its owner's\n72\t    library and prevents the move to graveyard.\"\"\"\n73\t\n74\t    def test_replacement_redirects_to_library_and_prevents(self) -> None:\n75\t        game = create_game()\n76\t        p1 = game.players[0]\n77\t        card = Progenitus(owner=p1, controller=p1)\n78\t        card.register_replacement_effects(game)\n79\t        # Use the creature-dies subclass so the event's ``card`` property\n80\t        # resolves to this Progenitus instance (the base class's ``card``\n81\t        # property returns None).\n82\t        event = CreatureDiesReplacementEvent(\n83\t            creature=card,\n84\t            destination=\"graveyard\",\n85\t            controller=p1,\n86\t            owner=p1,\n87\t        )\n88\t        result = game.replacement_manager.apply(game, event)\n89\t        # Replacement callback should return the event with prevented=True\n90\t        # and shuffle the card into the library.\n91\t        assert result.prevented is True\n92\t        library = p1.zones[Zone.LIBRARY]\n93\t        assert library.contains(card)\n94\t\n95\t\n96\t"}]},"parent_tool_use_id":null,"session_id":"1f0f0606-b316-4229-9b01-03fec511ba77","uuid":"ab8a40ad-2f76-4ebc-878b-f1a98369ad7b","timestamp":"2026-06-04T11:53:04.939Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_244/tests.py","content":"\"\"\"Reference test for FDN 244 — Progenitus.\n\nIllustrative test covering **replacement effects** via\n``game.replacement_manager.register()``. Progenitus has a continuous\nreplacement that intercepts any ``MoveToGraveyardReplacementEvent``\ntargeting itself and redirects the card to its owner's library instead\nof the graveyard. The replacement callback sets ``event.prevented`` to\nsignal that the engine should skip its own zone move, and returns the\nmodified event.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom cards.fdn.fdn_244.card_impl import Progenitus\nfrom engine.card import Creature\nfrom engine.events import (\n    CreatureDiesReplacementEvent,\n    MoveToGraveyardReplacementEvent,\n)\nfrom engine.replacement_effects import ReplacementEffect\nfrom engine.types import ManaCost, Supertype, Zone\nfrom test_utils import create_game\n\n\nclass TestProgenitusProperties:\n    \"\"\"Static card data should match the FDN 244 spec.\"\"\"\n\n    def test_name(self) -> None:\n        assert Progenitus(owner=None).name == \"Progenitus\"\n\n    def test_mana_cost(self) -> None:\n        cost = ManaCost.parse(\"{W}{W}{U}{U}{B}{B}{R}{R}{G}{G}\")\n        assert Progenitus(owner=None).mana_cost == cost\n\n    def test_legendary_hydra_avatar(self) -> None:\n        card = Progenitus(owner=None)\n        assert Supertype.LEGENDARY in card.supertypes\n        assert {\"Hydra\", \"Avatar\"} <= card.subtypes\n\n\nclass TestProgenitusReplacementRegistration:\n    \"\"\"register_replacement_effects must wire a ReplacementEffect for\n    MoveToGraveyardReplacementEvent through the replacement_manager.\"\"\"\n\n    def test_registers_one_replacement_effect(self) -> None:\n        game = create_game()\n        p1 = game.players[0]\n        card = Progenitus(owner=p1, controller=p1)\n        before = len(game.replacement_manager._effects)\n        card.register_replacement_effects(game)\n        after = len(game.replacement_manager._effects)\n        assert after - before == 1\n\n    def test_registered_replacement_uses_typed_event_class(self) -> None:\n        \"\"\"The registered ReplacementEffect must use the typed\n        MoveToGraveyardReplacementEvent class, not a string event name.\"\"\"\n        game = create_game()\n        p1 = game.players[0]\n        card = Progenitus(owner=p1, controller=p1)\n        card.register_replacement_effects(game)\n        registered = next(\n            (e for e in game.replacement_manager._effects if e.source is card),\n            None,\n        )\n        assert registered is not None\n        assert isinstance(registered, ReplacementEffect)\n        assert registered.event_type is MoveToGraveyardReplacementEvent\n\n\nclass TestProgenitusGraveyardReplacement:\n    \"\"\"The replacement callback shuffles the card into its owner's\n    library and prevents the move to graveyard.\"\"\"\n\n    def test_replacement_redirects_to_library_and_prevents(self) -> None:\n        game = create_game()\n        p1 = game.players[0]\n        card = Progenitus(owner=p1, controller=p1)\n        card.register_replacement_effects(game)\n        # Use the creature-dies subclass so the event's ``card`` property\n        # resolves to this Progenitus instance (the base class's ``card``\n        # property returns None).\n        event = CreatureDiesReplacementEvent(\n            creature=card,\n            destination=\"graveyard\",\n            controller=p1,\n            owner=p1,\n        )\n        result = game.replacement_manager.apply(game, event)\n        # Replacement callback should return the event with prevented=True\n        # and shuffle the card into the library.\n        assert result.prevented is True\n        library = p1.zones[Zone.LIBRARY]\n        assert library.contains(card)\n\n\n","numLines":96,"startLine":1,"totalLines":96}}}
