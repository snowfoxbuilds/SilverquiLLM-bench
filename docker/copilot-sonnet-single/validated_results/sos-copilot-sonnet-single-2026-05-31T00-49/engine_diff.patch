+def surveil(game: GameState, player: Player, n: int) -> None:
+    """Surveil *n* — look at the top *n* cards; put any into the graveyard, rest on top.
+
+    This simplified implementation automatically puts all surveiled cards back
+    on top (no interactive choice).  Tests that need specific graveyard placement
+    should call ``player.choose`` directly or set up the library order.
+
+    For a deterministic test player, each surveil card generates one
+    ``choose_yes_no`` call: ``True`` → put into graveyard; ``False`` → leave on top.
+
+    Parameters:
+        game: The current game state.
+        player: The player surveiling.
+        n: Number of cards to look at.
+    """
+    library = player.zones[Zone.LIBRARY]
+    graveyard = player.zones[Zone.GRAVEYARD]
+
+    cards = library.top(n)
+    for card in reversed(cards):  # process from top to bottom
+        library.remove(card)
+        keep = True
+        try:
+            keep = not player.choose_yes_no(f"Put {getattr(card, 'name', card)!r} into graveyard?")
+        except Exception:
+            keep = True  # default: keep on top
+        if keep:
+            library.add(card, position="top")
+        else:
+            graveyard.add(card)
+
+
