+def surveil(game: GameState, player: Player, n: int) -> None:
+    """Surveil N — look at the top N cards, put any into the graveyard, rest on top in any order.
+
+    In this implementation the player makes choices via ``player.choose``.
+    Each card is presented individually; the player returns True to keep on
+    top or False to send to the graveyard.  For scripted players the script
+    must provide exactly N boolean answers.
+
+    Parameters:
+        game: The current game state.
+        player: The player surveiling.
+        n: The number of cards to look at.
+    """
+    library = player.zones[Zone.LIBRARY]
+    top_cards = list(reversed(library.top(n)))  # first element is the topmost card
+    keep: list[Any] = []
+    gy = player.zones[Zone.GRAVEYARD]
+
+    for card in top_cards:
+        library.remove(card)
+        try:
+            keep_it = player.choose_yes_no(f"Keep {getattr(card, 'name', '?')} on top (surveil)?")
+        except Exception:
+            keep_it = True  # Default: keep on top
+        if keep_it:
+            keep.append(card)
+        else:
+            gy.add(card)
+
+    # Put kept cards back on top in the same relative order (last kept → bottom of group)
+    for card in reversed(keep):
+        library.add(card, position="top")
+
+
