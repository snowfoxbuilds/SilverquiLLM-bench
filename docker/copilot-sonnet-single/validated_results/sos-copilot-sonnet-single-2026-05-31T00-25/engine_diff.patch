+                "graveyard": Zone.GRAVEYARD,
+                "exile": Zone.EXILE,
+                "hand": Zone.HAND,
+                "library": Zone.LIBRARY,
+            }
+            dest_zone = _DEST_MAP.get(rep_event.destination, Zone.GRAVEYARD)
