+def _validate_ability_targets(
+    ability: ActivatedAbilityInstance | LoyaltyAbilityInstance,
+) -> None:
+    """Raise ``AbilityError`` if any chosen target for *ability* is illegal."""
+    from benchmarks.sos.workspace.engine.protection import get_illegal_target_reason
+
+    target_requirements = list(getattr(ability, "target_requirements", []))
+    chosen_targets = list(getattr(ability, "targets", []))
+    for index, target in enumerate(chosen_targets):
+        if target is None:
+            continue
+        if index < len(target_requirements):
+            filter_fn = getattr(target_requirements[index], "filter_fn", None)
+            if filter_fn is not None and not filter_fn(target):
+                raise AbilityError(
+                    "Cannot activate ability — chosen target does not satisfy filter"
+                )
+        reason = get_illegal_target_reason(target, ability.source)
+        if reason == "hexproof":
+            raise AbilityError("Cannot activate ability — target has hexproof")
+        if reason == "protection":
+            raise AbilityError(
+                "Cannot activate ability — target has protection from this ability"
+            )
+
+
+def _queue_ward_ability_triggers(
+    game: GameState,
+    player: Any,
+    source: Any,
+    stack_obj: StackObject,
+    chosen_targets: list[Any],
+) -> None:
+    """Queue ward checks for targeted activated or loyalty abilities."""
+    for target in chosen_targets:
+        ward_cost_getter = getattr(target, "get_ward_cost", None)
+        if not callable(ward_cost_getter):
+            continue
+        ward_cost = ward_cost_getter()
+        if ward_cost is None:
+            continue
+        target_controller = getattr(target, "controller", None)
+        if target_controller is None or target_controller is player:
+            continue
+
+        def _ward_resolve(
+            g: GameState,
+            *,
+            taxed_player: Any = player,
+            taxed_source: Any = source,
+            taxed_stack_obj: StackObject = stack_obj,
+            cost: Any = ward_cost,
+        ) -> None:
+            if not g.stack.contains(taxed_stack_obj):
+                return
+
+            paid = False
+            if isinstance(cost, ManaCost):
+                can_pay = taxed_player.mana_pool.can_pay(cost)
+                pay_cost = False
+                if can_pay:
+                    pay_cost = taxed_player.choose_yes_no(
+                        f"Pay ward cost {cost} for {getattr(taxed_source, 'name', 'ability')}?"
+                    )
+                if can_pay and pay_cost:
+                    taxed_player.mana_pool.pay(cost)
+                    paid = True
+            elif isinstance(cost, int):
+                can_pay_life = taxed_player.life >= cost
+                pay_cost = False
+                if can_pay_life:
+                    pay_cost = taxed_player.choose_yes_no(
+                        f"Pay ward cost {cost} life for {getattr(taxed_source, 'name', 'ability')}?"
+                    )
+                if can_pay_life and pay_cost:
+                    taxed_player.life -= cost
+                    paid = True
+            elif callable(cost):
+                paid = bool(cost(g, taxed_player, taxed_source, taxed_stack_obj))
+
+            if paid:
+                taxed_source.last_ward_outcome = "paid"  # type: ignore[attr-defined]
+                return
+
+            g.stack.remove(taxed_stack_obj)
+            taxed_source.last_ward_outcome = "countered"  # type: ignore[attr-defined]
+
+        game.stack.push(
+            StackObject(
+                source=target,
+                controller=target_controller,
+                on_resolve=_ward_resolve,
+            )
+        )
