+def can_cast_paradigm_copy(game: GameState, player: Player, card: CardImpl) -> bool:
+    """Return ``True`` if *player* may cast a paradigm copy of *card* now."""
+    if player is not game.active_player:
+        return False
+    if game.phase != Phase.PRECOMBAT_MAIN or game.step is not None:
+        return False
+    if not game.stack.is_empty():
+        return False
+    schedule = _get_paradigm_schedule(game, player, card)
+    if schedule is None:
+        return False
+    if not game.get_exile(player).contains(card):
+        return False
+    try:
+        player_index = game.players.index(player)
+    except ValueError:
+        return False
+    if (
+        schedule.last_cast_turn_number == game.turn_number
+        and schedule.last_cast_active_player_index == game.active_player_index
+        and game.paradigm_window_turn_number == game.turn_number
+        and game.paradigm_window_player_index == player_index
+    ):
+        return False
+
+    has_beginning_window = (
+        game.paradigm_window_turn_number == game.turn_number
+        and game.paradigm_window_player_index == player_index
+        and game.paradigm_window_action_serial == game.paradigm_phase_action_serial
+    )
+    same_phase_new_schedule = (
+        schedule.created_turn_number == game.turn_number
+        and schedule.player_index == player_index
+        and schedule.created_action_serial == game.paradigm_phase_action_serial
+        and (
+            game.paradigm_window_turn_number != game.turn_number
+            or game.paradigm_window_player_index != player_index
+            or schedule.created_action_serial == game.paradigm_window_action_serial + 1
+        )
+    )
+    return has_beginning_window or same_phase_new_schedule
