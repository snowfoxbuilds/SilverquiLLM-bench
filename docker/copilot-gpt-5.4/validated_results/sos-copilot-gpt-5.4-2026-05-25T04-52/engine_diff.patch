+def shuffle_library(
+    game: GameState,
+    player: Player,
+    *,
+    source: Any | None = None,
+    reason: str = "",
+) -> list[Any]:
+    """Shuffle *player*'s library with public tracking and optional determinism."""
+    library = game.get_library(player)
+    before = library.get_all()
+    after = game.choose_shuffle_order(
+        player,
+        before,
+        zone=Zone.LIBRARY,
+        source=source,
+        reason=reason,
+    )
+    for card in before:
+        if library.contains(card):
+            library.remove(card)
+    for card in after:
+        library.add(card)
+    history = game.shuffle_history[-1] if game.shuffle_history else None
+    game.trigger_manager.fire_event(
+        game,
+        LibraryShuffledTriggeredEvent(
+            player=player,
+            zone=Zone.LIBRARY,
+            before=before,
+            after=after,
+            source=source,
+            reason=reason,
+            used_queued_order=bool(history.used_queued_order) if history is not None else False,
+        ),
+    )
+    return after
