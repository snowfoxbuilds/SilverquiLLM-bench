+def _combine_costs(base: ManaCost, extra: ManaCost) -> ManaCost:
+    """Return a new :class:`ManaCost` representing *base* plus *extra*."""
+    pips = dict(base.pips)
+    for mana_type, count in extra.pips.items():
+        pips[mana_type] = pips.get(mana_type, 0) + count
+    return ManaCost(
+        generic=base.generic + extra.generic,
+        pips=pips,
+        x_count=base.x_count + extra.x_count,
+        hybrid=list(base.hybrid) + list(extra.hybrid),
+    )
+
+
+def _cost_payable_by_any_mana_type(cost: ManaCost, card: CardImpl) -> ManaCost:
+    """Return a version of *cost* whose full payment may be made with any mana type."""
+    x_value = max(0, int(getattr(card, "x_value", 0)))
+    total = cost.generic + sum(cost.pips.values()) + sum(
+        symbol.mana_value for symbol in cost.hybrid
+    ) + (cost.x_count * x_value)
+    return ManaCost(generic=total)
+
