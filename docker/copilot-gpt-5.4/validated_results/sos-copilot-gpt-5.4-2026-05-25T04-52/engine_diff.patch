+def is_illegal_target_due_to_hexproof(target: Any, source: Any) -> bool:
+    """Return ``True`` if *target* can't be targeted by *source* due to hexproof.
+
+    Hexproof prevents spells and abilities controlled by an object's opponents
+    from targeting it. The *source* may be either the spell/ability object
+    itself or any object exposing a ``controller`` attribute.
+    """
+    if not has_hexproof(target):
+        return False
+
+    source_controller = getattr(source, "controller", None)
+    if source_controller is None:
+        return False
+
+    target_controller = getattr(target, "controller", None)
+    if target_controller is None and hasattr(target, "zones"):
+        target_controller = target
+    if target_controller is None:
+        target_controller = getattr(target, "owner", None)
+    if target_controller is None:
+        return False
+
+    return source_controller is not target_controller
