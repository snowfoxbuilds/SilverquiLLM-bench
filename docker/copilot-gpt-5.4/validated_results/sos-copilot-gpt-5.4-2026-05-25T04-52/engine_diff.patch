+def _queue_ward_triggers(
+    game: GameState,
+    caster: Player,
+    spell: CardImpl,
+    stack_obj: StackObject,
+    chosen_targets: list[Any],
+) -> None:
+    """Queue ward triggers for any targeted permanents with ward."""
+    for target in chosen_targets:
+        ward_cost_getter = getattr(target, "get_ward_cost", None)
+        if not callable(ward_cost_getter):
+            continue
+        ward_cost = ward_cost_getter()
+        if ward_cost is None:
+            continue
+        target_controller = getattr(target, "controller", None)
+        if target_controller is None or target_controller is caster:
+            continue
+
+        def _ward_resolve(
+            g: GameState,
+            *,
+            taxed_player: Player = caster,
+            taxed_spell: CardImpl = spell,
+            taxed_stack_obj: StackObject = stack_obj,
+            cost: Any = ward_cost,
+        ) -> None:
+            if not g.stack.contains(taxed_stack_obj):
+                return
+
+            paid = False
+            if isinstance(cost, ManaCost):
+                can_pay = taxed_player.mana_pool.can_pay(cost)
+                pay_cost = False
+                if can_pay:
+                    pay_cost = taxed_player.choose_yes_no(
+                        f"Pay ward cost {cost} for {taxed_spell.name}?"
+                    )
+                if can_pay and pay_cost:
+                    taxed_player.mana_pool.pay(cost)
+                    paid = True
+            elif isinstance(cost, int):
+                can_pay_life = taxed_player.life >= cost
+                pay_cost = False
+                if can_pay_life:
+                    pay_cost = taxed_player.choose_yes_no(
+                        f"Pay ward cost {cost} life for {taxed_spell.name}?"
+                    )
+                if can_pay_life and pay_cost:
+                    taxed_player.life -= cost
+                    paid = True
+            elif callable(cost):
+                paid = bool(cost(g, taxed_player, taxed_spell, taxed_stack_obj))
+
+            if paid:
+                taxed_spell.last_ward_outcome = "paid"  # type: ignore[attr-defined]
+                return
+            g.stack.remove(taxed_stack_obj)
+            taxed_spell.last_ward_outcome = "countered"  # type: ignore[attr-defined]
+            destination = Zone.EXILE if taxed_stack_obj.exile_on_resolve else Zone.GRAVEYARD
+            move_to_zone(g, taxed_spell, Zone.STACK, destination)
+
+        game.stack.push(
+            StackObject(
+                source=target,
+                controller=target_controller,
+                on_resolve=_ward_resolve,
+            )
+        )
+
