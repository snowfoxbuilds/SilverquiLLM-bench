+def _fire_becomes_target_events(
+    game: GameState,
+    controller: Player,
+    source: Any,
+    stack_obj: StackObject,
+    chosen_targets: list[Any],
+) -> None:
+    """Fire one target event for each distinct chosen target."""
+    seen: set[int] = set()
+    for target in chosen_targets:
+        if target is None:
+            continue
+        target_id = getattr(target, "object_id", id(target))
+        if target_id in seen:
+            continue
+        seen.add(target_id)
+        game.trigger_manager.fire_event(
+            game,
+            BecomesTargetTriggeredEvent(
+                target=target,
+                source=source,
+                controller=controller,
+                stack_object=stack_obj,
+            ),
+        )
