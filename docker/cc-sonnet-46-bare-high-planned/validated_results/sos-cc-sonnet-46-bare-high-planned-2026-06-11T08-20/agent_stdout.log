{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014csL5CY97zDEkASuXReF3e","type":"tool_result","content":"1\t\"\"\"Card implementation for Secluded Courtyard.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Land, ManaAbility\n8\tfrom engine.types import ManaCost, ManaType\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t\n13\t\n14\tclass SecludedCourtyard(Land):\n15\t    \"\"\"Secluded Courtyard — Land\n16\t\n17\t    As this land enters, choose a creature type.\n18\t    {T}: Add {C}.\n19\t    {T}: Add one mana of any color. Spend this mana only to cast a creature\n20\t    spell of the chosen type or activate an ability of a creature source of\n21\t    the chosen type.\n22\t\n23\t    FDN collector number 267.\n24\t    \"\"\"\n25\t\n26\t    def __init__(self, **kwargs: Any) -> None:\n27\t        kwargs.setdefault(\"name\", \"Secluded Courtyard\")\n28\t        kwargs.setdefault(\n29\t            \"rules_text\",\n30\t            \"As this land enters, choose a creature type.\\n\"\n31\t            \"{T}: Add {C}.\\n\"\n32\t            \"{T}: Add one mana of any color. Spend this mana only to cast \"\n33\t            \"a creature spell of the chosen type or activate an ability of \"\n34\t            \"a creature source of the chosen type.\",\n35\t        )\n36\t        super().__init__(**kwargs)\n37\t        self.chosen_creature_type: str | None = None\n38\t\n39\t    def on_resolve(self, game: Any) -> None:\n40\t        \"\"\"As this land enters, choose a creature type.\n41\t\n42\t        Note: play_land() should ideally call this method (or an equivalent\n43\t        on_enter hook) so the choice is recorded during normal land play.\n44\t        The engine currently does not invoke on_resolve() for lands, so\n45\t        callers must trigger this explicitly.\n46\t        \"\"\"\n47\t        controller = self.controller\n48\t        if controller is not None:\n49\t            # Use controller.choose to pick a creature type.\n50\t            # Signature: choose(options, description)\n51\t            creature_types = [\n52\t                \"Human\", \"Elf\", \"Goblin\", \"Wizard\", \"Soldier\",\n53\t                \"Zombie\", \"Merfolk\", \"Angel\", \"Dragon\", \"Vampire\",\n54\t                \"Beast\", \"Elemental\", \"Knight\", \"Warrior\", \"Rogue\",\n55\t                \"Cleric\", \"Shaman\", \"Druid\", \"Spirit\", \"Demon\",\n56\t                \"Bird\", \"Cat\", \"Dog\", \"Dinosaur\", \"Sliver\",\n57\t            ]\n58\t            choice = controller.choose(\n59\t                creature_types,\n60\t                \"Choose a creature type for Secluded Courtyard\",\n61\t            )\n62\t            self.chosen_creature_type = choice\n63\t\n64\t    def get_mana_abilities(self) -> list[ManaAbility]:\n65\t        source = self\n66\t\n67\t        def _tap_cost(game: Any, src: Any) -> bool:\n68\t            if getattr(src, \"is_tapped\", False):\n69\t                return False\n70\t            src.is_tapped = True\n71\t            return True\n72\t\n73\t        def _colorless_effect(game: Any) -> None:\n74\t            controller = source.controller\n75\t            if controller is not None:\n76\t                controller.mana_pool.add(ManaType.COLORLESS, 1)\n77\t\n78\t        def _any_color_effect(game: Any) -> None:\n79\t            # ENGINE LIMITATION: The engine does not support conditional mana\n80\t            # spending restrictions. This should only be usable to cast creature\n81\t            # spells of the chosen type or activate abilities of creature sources\n82\t            # of the chosen type. The restriction is not enforced here.\n83\t            controller = source.controller\n84\t            if controller is not None:\n85\t                # Produce one mana of any color. Let the controller choose.\n86\t                color_options = [\n87\t                    ManaType.WHITE, ManaType.BLUE, ManaType.BLACK,\n88\t                    ManaType.RED, ManaType.GREEN,\n89\t                ]\n90\t                chosen_color = controller.choose(\n91\t                    color_options,\n92\t                    \"Choose a color of mana to produce\",\n93\t                )\n94\t                controller.mana_pool.add(chosen_color, 1)\n95\t\n96\t        return [\n97\t            ManaAbility(\n98\t                cost=_tap_cost,\n99\t                mana_produced=_colorless_effect,\n100\t                description=\"{T}: Add {C}.\",\n101\t            ),\n102\t            ManaAbility(\n103\t                cost=_tap_cost,\n104\t                mana_produced=_any_color_effect,\n105\t                description=\"{T}: Add one mana of any color (restricted).\",\n106\t            ),\n107\t        ]\n108\t"}]},"parent_tool_use_id":null,"session_id":"8ad560dd-f0de-48bf-a5ec-5012d23eae4b","uuid":"64d63d89-7c15-4bad-b7a9-14517bdcbf6b","timestamp":"2026-06-11T08:37:46.410Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_267/card_impl.py","content":"\"\"\"Card implementation for Secluded Courtyard.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import Land, ManaAbility\nfrom engine.types import ManaCost, ManaType\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\nclass SecludedCourtyard(Land):\n    \"\"\"Secluded Courtyard — Land\n\n    As this land enters, choose a creature type.\n    {T}: Add {C}.\n    {T}: Add one mana of any color. Spend this mana only to cast a creature\n    spell of the chosen type or activate an ability of a creature source of\n    the chosen type.\n\n    FDN collector number 267.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"Secluded Courtyard\")\n        kwargs.setdefault(\n            \"rules_text\",\n            \"As this land enters, choose a creature type.\\n\"\n            \"{T}: Add {C}.\\n\"\n            \"{T}: Add one mana of any color. Spend this mana only to cast \"\n            \"a creature spell of the chosen type or activate an ability of \"\n            \"a creature source of the chosen type.\",\n        )\n        super().__init__(**kwargs)\n        self.chosen_creature_type: str | None = None\n\n    def on_resolve(self, game: Any) -> None:\n        \"\"\"As this land enters, choose a creature type.\n\n        Note: play_land() should ideally call this method (or an equivalent\n        on_enter hook) so the choice is recorded during normal land play.\n        The engine currently does not invoke on_resolve() for lands, so\n        callers must trigger this explicitly.\n        \"\"\"\n        controller = self.controller\n        if controller is not None:\n            # Use controller.choose to pick a creature type.\n            # Signature: choose(options, description)\n            creature_types = [\n                \"Human\", \"Elf\", \"Goblin\", \"Wizard\", \"Soldier\",\n                \"Zombie\", \"Merfolk\", \"Angel\", \"Dragon\", \"Vampire\",\n                \"Beast\", \"Elemental\", \"Knight\", \"Warrior\", \"Rogue\",\n                \"Cleric\", \"Shaman\", \"Druid\", \"Spirit\", \"Demon\",\n                \"Bird\", \"Cat\", \"Dog\", \"Dinosaur\", \"Sliver\",\n            ]\n            choice = controller.choose(\n                creature_types,\n                \"Choose a creature type for Secluded Courtyard\",\n            )\n            self.chosen_creature_type = choice\n\n    def get_mana_abilities(self) -> list[ManaAbility]:\n        source = self\n\n        def _tap_cost(game: Any, src: Any) -> bool:\n            if getattr(src, \"is_tapped\", False):\n                return False\n            src.is_tapped = True\n            return True\n\n        def _colorless_effect(game: Any) -> None:\n            controller = source.controller\n            if controller is not None:\n                controller.mana_pool.add(ManaType.COLORLESS, 1)\n\n        def _any_color_effect(game: Any) -> None:\n            # ENGINE LIMITATION: The engine does not support conditional mana\n            # spending restrictions. This should only be usable to cast creature\n            # spells of the chosen type or activate abilities of creature sources\n            # of the chosen type. The restriction is not enforced here.\n            controller = source.controller\n            if controller is not None:\n                # Produce one mana of any color. Let the controller choose.\n                color_options = [\n                    ManaType.WHITE, ManaType.BLUE, ManaType.BLACK,\n                    ManaType.RED, ManaType.GREEN,\n                ]\n                chosen_color = controller.choose(\n                    color_options,\n                    \"Choose a color of mana to produce\",\n                )\n                controller.mana_pool.add(chosen_color, 1)\n\n        return [\n            ManaAbility(\n                cost=_tap_cost,\n                mana_produced=_colorless_effect,\n                description=\"{T}: Add {C}.\",\n            ),\n            ManaAbility(\n                cost=_tap_cost,\n                mana_produced=_any_color_effect,\n                description=\"{T}: Add one mana of any color (restricted).\",\n            ),\n        ]\n","numLines":108,"startLine":1,"totalLines":108}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015kFLHh4tQwQnvBw9gPk1Mb","type":"tool_result","content":"1\t\"\"\"Casting and resolution pipeline for spells and lands.\n2\t\n3\tProvides the full flow from casting a spell or playing a land through\n4\tresolution:\n5\t\n6\t- :func:`cast_spell` — verify timing & legality → move hand to stack →\n7\t  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n8\t- :func:`play_land` — verify land play remaining → move hand to\n9\t  battlefield → decrement ``land_plays_remaining``.\n10\t- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n11\t  helpers used by the casting pipeline.\n12\t\n13\tResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\n14\tcreated by :func:`cast_spell`:\n15\t\n16\t- Call ``card.on_resolve(game)``.\n17\t- Permanents (creature / enchantment / artifact / planeswalker) move from\n18\t  the stack to the battlefield.\n19\t- Non-permanents (instant / sorcery) move to the graveyard.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import TYPE_CHECKING, Any\n25\t\n26\tfrom engine.card import CardImpl\n27\tfrom engine.stack import StackObject\n28\tfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\n29\tfrom engine.zones import move_zone\n30\t\n31\tif TYPE_CHECKING:\n32\t    from engine.game_state import GameState\n33\t    from engine.player import Player\n34\t\n35\t\n36\t# Card types that represent permanents — these go to the battlefield on resolve.\n37\t_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n38\t    CardType.CREATURE,\n39\t    CardType.ENCHANTMENT,\n40\t    CardType.ARTIFACT,\n41\t    CardType.PLANESWALKER,\n42\t})\n43\t\n44\t\n45\tclass CastingError(Exception):\n46\t    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n47\t\n48\t\n49\t# ------------------------------------------------------------------\n50\t# Timing helpers\n51\t# ------------------------------------------------------------------\n52\t\n53\tdef is_sorcery_speed(game: GameState, player: Player) -> bool:\n54\t    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n55\t\n56\t    Sorcery speed requires all of:\n57\t\n58\t    * *player* is the active player.\n59\t    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n60\t      ``POSTCOMBAT_MAIN``).\n61\t    * The stack is empty.\n62\t    \"\"\"\n63\t    if player is not game.active_player:\n64\t        return False\n65\t    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n66\t        return False\n67\t    if not game.stack.is_empty():\n68\t        return False\n69\t    return True\n70\t\n71\t\n72\tdef can_cast_at_instant_speed(card: CardImpl) -> bool:\n73\t    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n74\t\n75\t    A card has instant-speed timing if it is an instant or has the\n76\t    :attr:`~engine.types.Keyword.FLASH` keyword.\n77\t    \"\"\"\n78\t    if CardType.INSTANT in card.card_types:\n79\t        return True\n80\t    if Keyword.FLASH & card.keywords:\n81\t        return True\n82\t    return False\n83\t\n84\t\n85\t# ------------------------------------------------------------------\n86\t# Cost reduction\n87\t# ------------------------------------------------------------------\n88\t\n89\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n90\t    \"\"\"Return the generic mana reduction for casting *card*.\n91\t\n92\t    Queries ``card.cost_reduction(game)`` and clamps the result so that\n93\t    the generic portion of the mana cost cannot go below 0.\n94\t\n95\t    Also aggregates reductions from battlefield permanents that expose\n96\t    ``spell_cost_reduction(game, spell) -> int`` when the spell is an\n97\t    instant or sorcery.\n98\t    \"\"\"\n99\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n100\t    # casting player even when the card was never explicitly assigned one.\n101\t    prev_controller = card.controller\n102\t    card.controller = controller\n103\t    raw = card.cost_reduction(game)\n104\t    # Restore previous controller in case the caller doesn't want a\n105\t    # side-effect (get_cost_reduction is a query, not a mutation).\n106\t    card.controller = prev_controller\n107\t    generic = card.mana_cost.generic if card.mana_cost else 0\n108\t\n109\t    # E3: aggregate reductions from controller's battlefield permanents for\n110\t    # instant/sorcery spells (e.g. affinity granted by Witherbloom).\n111\t    is_instant_or_sorcery = (\n112\t        CardType.INSTANT in card.card_types or CardType.SORCERY in card.card_types\n113\t    )\n114\t    if is_instant_or_sorcery:\n115\t        bf = game.get_battlefield(controller)\n116\t        for permanent in bf.get_all():\n117\t            hook = getattr(permanent, \"spell_cost_reduction\", None)\n118\t            if hook is not None:\n119\t                try:\n120\t                    raw += hook(game, card)\n121\t                except Exception:\n122\t                    pass\n123\t\n124\t    return max(0, min(raw, generic))\n125\t\n126\t\n127\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n128\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n129\t    new_generic = max(0, cost.generic - reduction)\n130\t    return ManaCost(\n131\t        generic=new_generic,\n132\t        pips=dict(cost.pips),\n133\t        x_count=cost.x_count,\n134\t        hybrid=list(cost.hybrid),\n135\t    )\n136\t\n137\t\n138\t# ------------------------------------------------------------------\n139\t# Cast spell\n140\t# ------------------------------------------------------------------\n141\t\n142\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n143\t    \"\"\"Cast *card* from *player*'s hand.\n144\t\n145\t    Pipeline\n146\t    --------\n147\t    1. **Timing check** — instants (and cards with flash) can be cast\n148\t       whenever the player has priority; everything else requires\n149\t       sorcery-speed timing.\n150\t    2. **can_cast** — ask the card whether it can legally be cast.\n151\t    3. **Hand check** — the card must be in the player's hand.\n152\t    4. **Move hand → stack zone** — remove the card from the hand and\n153\t       place it into the player's stack zone.\n154\t    5. **Choose targets** — if the card specifies targets (via\n155\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n156\t    6. **Mana check / payment** — the player's mana pool must be able to\n157\t       pay the card's mana cost.  If payment fails, the card is rolled\n158\t       back from the stack zone to the hand.\n159\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n160\t    8. **Push StackObject** — push a :class:`StackObject` whose\n161\t       ``on_resolve`` callback handles resolution.\n162\t\n163\t    Raises:\n164\t        CastingError: If any legality check fails.\n165\t    \"\"\"\n166\t    # 1. Timing\n167\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n168\t        raise CastingError(\n169\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n170\t        )\n171\t\n172\t    # 2. can_cast\n173\t    if not card.can_cast(game):\n174\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n175\t\n176\t    # 3. Hand check\n177\t    hand = game.get_hand(player)\n178\t    if not hand.contains(card):\n179\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n180\t\n181\t    # 4. Move card from hand to stack zone\n182\t    stack_zone = player.zones[Zone.STACK]\n183\t    hand.remove(card)\n184\t    stack_zone.add(card)\n185\t\n186\t    # Clear any stale colors_spent from a prior cast before new payment.\n187\t    if hasattr(card, \"colors_spent\"):\n188\t        del card.colors_spent\n189\t\n190\t    # 5. Choose targets\n191\t    target_specs = card.get_targets(game)\n192\t    chosen_targets: list[Any] = []\n193\t    if target_specs:\n194\t        for spec in target_specs:\n195\t            target = player.choose_target(target_specs, spec)\n196\t            # Validate against filter_fn if the spec provides one\n197\t            filter_fn = getattr(spec, \"filter_fn\", None)\n198\t            if filter_fn is not None and target is not None:\n199\t                if not filter_fn(target):\n200\t                    stack_zone.remove(card)\n201\t                    hand.add(card)\n202\t                    raise CastingError(\n203\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n204\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n205\t                    )\n206\t            chosen_targets.append(target)\n207\t\n208\t    # 5b. Protection check — reject targets that have protection from this\n209\t    #     spell (the T in DEBT).\n210\t    from engine.protection import has_protection_from\n211\t\n212\t    for target in chosen_targets:\n213\t        if has_protection_from(target, card):\n214\t            # Rollback: move card from stack zone back to hand\n215\t            stack_zone.remove(card)\n216\t            hand.add(card)\n217\t            raise CastingError(\n218\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n219\t            )\n220\t\n221\t    # Targets are stored on the StackObject (not the card) and passed\n222\t    # through the resolve pipeline via on_resolve(game, targets=...).\n223\t\n224\t    # 6. Mana check / payment (rollback on failure)\n225\t    # Ensure the card knows its controller so that cost_reduction() hooks\n226\t    # (e.g. Embercleave counting attacking creatures you control) see the\n227\t    # casting player, even for cards that were added to hand without an\n228\t    # explicit controller assignment.\n229\t    if card.controller is None:\n230\t        card.controller = player\n231\t    reduction = get_cost_reduction(game, card, player)\n232\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n233\t\n234\t    if not player.mana_pool.can_pay(effective_cost):\n235\t        # Rollback: move card from stack zone back to hand\n236\t        stack_zone.remove(card)\n237\t        hand.add(card)\n238\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n239\t\n240\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n241\t    player.mana_pool.pay(effective_cost)\n242\t\n243\t    # Store colors of mana spent on the card for mechanics like Converge\n244\t    # that care about the colors used to cast the spell.\n245\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n246\t\n247\t    # 7. Call on_cast hook\n248\t    card.on_cast(game)\n249\t\n250\t    # 8. Build on_resolve callback and push StackObject\n251\t    stack_obj = StackObject(\n252\t        source=card,\n253\t        controller=player,\n254\t        targets=chosen_targets,\n255\t        on_resolve=lambda g: None,  # replaced below\n256\t    )\n257\t\n258\t    def _on_resolve(g: GameState) -> None:\n259\t        _resolve_spell(g, card, player, stack_obj)\n260\t\n261\t    stack_obj.on_resolve = _on_resolve\n262\t    game.stack.push(stack_obj)\n263\t\n264\t    # Fire SpellCastTriggeredEvent now that the spell is on the stack.\n265\t    from engine.events import SpellCastTriggeredEvent\n266\t    game.trigger_manager.fire_event(\n267\t        game,\n268\t        SpellCastTriggeredEvent(spell=stack_obj, card=card, controller=player),\n269\t    )\n270\t\n271\t\n272\t# ------------------------------------------------------------------\n273\t# Cast spell without paying mana cost (free-cast from any zone)\n274\t# ------------------------------------------------------------------\n275\t\n276\t\n277\tdef cast_spell_free(\n278\t    game: GameState,\n279\t    player: Player,\n280\t    card: CardImpl,\n281\t    from_zone: Zone,\n282\t) -> None:\n283\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n284\t\n285\t    This is used by effects that allow casting from zones other than hand\n286\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n287\t    or cascade.\n288\t\n289\t    Pipeline\n290\t    --------\n291\t    1. **can_cast** — ask the card whether it can legally be cast (same\n292\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n293\t    2. Move *card* from *from_zone* to the stack zone.\n294\t    3. Choose targets (if applicable) with validation and protection check.\n295\t    4. Call ``on_cast`` hook.\n296\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n297\t       resolution normally (permanents → battlefield, non-permanents →\n298\t       graveyard).\n299\t\n300\t    No timing check or mana payment is performed.  The spell goes on the\n301\t    stack and can be responded to normally (e.g. countered).\n302\t\n303\t    If targeting or other post-move checks fail, the card is rolled back\n304\t    to its source zone.\n305\t\n306\t    Parameters:\n307\t        game: The current game state.\n308\t        player: The player casting the spell.\n309\t        card: The card to cast.\n310\t        from_zone: The zone the card is currently in.\n311\t\n312\t    Raises:\n313\t        CastingError: If the card cannot be found in *from_zone* or\n314\t            legality checks fail.\n315\t    \"\"\"\n316\t    from engine.zones import move_to_zone\n317\t\n318\t    # Ensure controller is set\n319\t    card.controller = player\n320\t    if card.owner is None:\n321\t        card.owner = player\n322\t\n323\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n324\t    if not card.can_cast(game):\n325\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n326\t\n327\t    # 2. Locate card in source zone\n328\t    source_zone_container = player.zones[from_zone]\n329\t    if not source_zone_container.contains(card):\n330\t        # Try to find the card in any player's zone\n331\t        source_zone_container = None\n332\t        for p in game.players:\n333\t            z = p.zones[from_zone]\n334\t            if z.contains(card):\n335\t                source_zone_container = z\n336\t                break\n337\t\n338\t    if source_zone_container is None or not source_zone_container.contains(card):\n339\t        raise CastingError(\n340\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n341\t        )\n342\t\n343\t    # Move card from source zone to stack zone\n344\t    stack_zone = player.zones[Zone.STACK]\n345\t    source_zone_container.remove(card)\n346\t    stack_zone.add(card)\n347\t\n348\t    # 3. Choose targets (with rollback on failure)\n349\t    try:\n350\t        target_specs = card.get_targets(game)\n351\t        chosen_targets: list[Any] = []\n352\t        if target_specs:\n353\t            for spec in target_specs:\n354\t                target = player.choose_target(target_specs, spec)\n355\t                # Validate against filter_fn if the spec provides one\n356\t                filter_fn = getattr(spec, \"filter_fn\", None)\n357\t                if filter_fn is not None and target is not None:\n358\t                    if not filter_fn(target):\n359\t                        raise CastingError(\n360\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n361\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n362\t                        )\n363\t                chosen_targets.append(target)\n364\t\n365\t        # Protection check — reject targets that have protection from this spell\n366\t        from engine.protection import has_protection_from\n367\t\n368\t        for target in chosen_targets:\n369\t            if has_protection_from(target, card):\n370\t                raise CastingError(\n371\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n372\t                )\n373\t    except Exception as exc:\n374\t        # Rollback: move card from stack zone back to source zone\n375\t        stack_zone.remove(card)\n376\t        source_zone_container.add(card)\n377\t        raise CastingError(str(exc)) from exc\n378\t\n379\t    # 4. Call on_cast hook\n380\t    card.on_cast(game)\n381\t\n382\t    # 5. Build on_resolve callback and push StackObject\n383\t    stack_obj = StackObject(\n384\t        source=card,\n385\t        controller=player,\n386\t        targets=chosen_targets,\n387\t        on_resolve=lambda g: None,  # replaced below\n388\t    )\n389\t\n390\t    def _on_resolve(g: GameState) -> None:\n391\t        _resolve_spell(g, card, player, stack_obj)\n392\t\n393\t    stack_obj.on_resolve = _on_resolve\n394\t    game.stack.push(stack_obj)\n395\t\n396\t\n397\t# ------------------------------------------------------------------\n398\t# Resolution (called when the stack pops)\n399\t# ------------------------------------------------------------------\n400\t\n401\tdef _resolve_spell(\n402\t    game: GameState,\n403\t    card: CardImpl,\n404\t    player: Player,\n405\t    stack_obj: StackObject,\n406\t) -> None:\n407\t    \"\"\"Resolve *card* cast by *player*.\n408\t\n409\t    1. Call ``card.on_resolve(game, targets=targets)``.\n410\t    2. Remove the card from the stack zone.\n411\t    3. If the card is a permanent type, move it to the battlefield via\n412\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n413\t       registration and the ETB event).\n414\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n415\t    \"\"\"\n416\t    from engine.zones import move_to_zone\n417\t\n418\t    # Read targets from the StackObject — the single source of truth.\n419\t    # Set chosen_targets on the card just before resolution so that\n420\t    # _get_chosen_target helpers (which read via getattr) work.\n421\t    targets = stack_obj.targets\n422\t    if targets is not None:\n423\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n424\t\n425\t    card.on_resolve(game)\n426\t\n427\t    if card.card_types & _PERMANENT_TYPES:\n428\t        # Move from stack to battlefield via move_to_zone, which handles\n429\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n430\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n431\t    else:\n432\t        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n433\t        # If _exile_instead_of_graveyard is set (e.g. by The Dawning Archaic's\n434\t        # \"cast from graveyard\" trigger), exile it instead.  Deliberate\n435\t        # limitation: does not apply to countered spells (those bypass this path).\n436\t        if getattr(card, \"_exile_instead_of_graveyard\", False):\n437\t            card._exile_instead_of_graveyard = False  # consume flag\n438\t            move_to_zone(game, card, Zone.STACK, Zone.EXILE)\n439\t        else:\n440\t            move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n441\t\n442\t\n443\t# ------------------------------------------------------------------\n444\t# Play land (special action — does not use the stack)\n445\t# ------------------------------------------------------------------\n446\t\n447\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n448\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n449\t\n450\t    Requirements (all must hold):\n451\t\n452\t    * *land_card* has :attr:`CardType.LAND`.\n453\t    * *player* is the active player.\n454\t    * Current phase is a main phase.\n455\t    * The stack is empty.\n456\t    * ``player.land_plays_remaining > 0``.\n457\t    * The card is in the player's hand.\n458\t\n459\t    On success the card moves from hand to battlefield and\n460\t    ``land_plays_remaining`` is decremented.\n461\t\n462\t    Raises:\n463\t        CastingError: If any requirement is not met.\n464\t    \"\"\"\n465\t    # Must be a land\n466\t    if CardType.LAND not in land_card.card_types:\n467\t        raise CastingError(\n468\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n469\t        )\n470\t\n471\t    # Sorcery-speed timing (active player, main phase, stack empty)\n472\t    if not is_sorcery_speed(game, player):\n473\t        raise CastingError(\n474\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n475\t            \"during main phase with empty stack\"\n476\t        )\n477\t\n478\t    # Land plays remaining\n479\t    if player.land_plays_remaining <= 0:\n480\t        raise CastingError(\n481\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n482\t        )\n483\t\n484\t    # Card must be in hand\n485\t    hand = game.get_hand(player)\n486\t    if not hand.contains(land_card):\n487\t        raise CastingError(\n488\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n489\t        )\n490\t\n491\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n492\t    if land_card.owner is None:\n493\t        land_card.owner = player\n494\t    land_card.controller = player\n495\t\n496\t    # Move from hand to battlefield via move_to_zone, which fires\n497\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n498\t    from engine.zones import move_to_zone\n499\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n500\t\n501\t    # Decrement land plays\n502\t    player.land_plays_remaining -= 1\n503\t\n504\t\n505\tdef resolve_top(game: GameState) -> None:\n506\t    \"\"\"Resolve the top spell/ability on the stack.\n507\t\n508\t    Pops the top item from the stack, calls its on_resolve callback,\n509\t    then runs state-based actions.  If the stack is empty this is a no-op.\n510\t    \"\"\"\n511\t    if game.stack.is_empty():\n512\t        return\n513\t    from engine.state_based_actions import resolve_state_based_actions\n514\t\n515\t    obj = game.stack.pop()\n516\t    obj.on_resolve(game)\n517\t    resolve_state_based_actions(game)\n518\t"}]},"parent_tool_use_id":null,"session_id":"8ad560dd-f0de-48bf-a5ec-5012d23eae4b","uuid":"51585993-2bac-410b-abde-d8b4242a3ba9","timestamp":"2026-06-11T08:37:46.414Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"\"\"\"Casting and resolution pipeline for spells and lands.\n\nProvides the full flow from casting a spell or playing a land through\nresolution:\n\n- :func:`cast_spell` — verify timing & legality → move hand to stack →\n  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n- :func:`play_land` — verify land play remaining → move hand to\n  battlefield → decrement ``land_plays_remaining``.\n- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n  helpers used by the casting pipeline.\n\nResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\ncreated by :func:`cast_spell`:\n\n- Call ``card.on_resolve(game)``.\n- Permanents (creature / enchantment / artifact / planeswalker) move from\n  the stack to the battlefield.\n- Non-permanents (instant / sorcery) move to the graveyard.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import CardImpl\nfrom engine.stack import StackObject\nfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\nfrom engine.zones import move_zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n# Card types that represent permanents — these go to the battlefield on resolve.\n_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n    CardType.CREATURE,\n    CardType.ENCHANTMENT,\n    CardType.ARTIFACT,\n    CardType.PLANESWALKER,\n})\n\n\nclass CastingError(Exception):\n    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n\n\n# ------------------------------------------------------------------\n# Timing helpers\n# ------------------------------------------------------------------\n\ndef is_sorcery_speed(game: GameState, player: Player) -> bool:\n    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n\n    Sorcery speed requires all of:\n\n    * *player* is the active player.\n    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n      ``POSTCOMBAT_MAIN``).\n    * The stack is empty.\n    \"\"\"\n    if player is not game.active_player:\n        return False\n    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n        return False\n    if not game.stack.is_empty():\n        return False\n    return True\n\n\ndef can_cast_at_instant_speed(card: CardImpl) -> bool:\n    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n\n    A card has instant-speed timing if it is an instant or has the\n    :attr:`~engine.types.Keyword.FLASH` keyword.\n    \"\"\"\n    if CardType.INSTANT in card.card_types:\n        return True\n    if Keyword.FLASH & card.keywords:\n        return True\n    return False\n\n\n# ------------------------------------------------------------------\n# Cost reduction\n# ------------------------------------------------------------------\n\ndef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n    \"\"\"Return the generic mana reduction for casting *card*.\n\n    Queries ``card.cost_reduction(game)`` and clamps the result so that\n    the generic portion of the mana cost cannot go below 0.\n\n    Also aggregates reductions from battlefield permanents that expose\n    ``spell_cost_reduction(game, spell) -> int`` when the spell is an\n    instant or sorcery.\n    \"\"\"\n    # Ensure card.controller is set so the hook can reference \"you\" / the\n    # casting player even when the card was never explicitly assigned one.\n    prev_controller = card.controller\n    card.controller = controller\n    raw = card.cost_reduction(game)\n    # Restore previous controller in case the caller doesn't want a\n    # side-effect (get_cost_reduction is a query, not a mutation).\n    card.controller = prev_controller\n    generic = card.mana_cost.generic if card.mana_cost else 0\n\n    # E3: aggregate reductions from controller's battlefield permanents for\n    # instant/sorcery spells (e.g. affinity granted by Witherbloom).\n    is_instant_or_sorcery = (\n        CardType.INSTANT in card.card_types or CardType.SORCERY in card.card_types\n    )\n    if is_instant_or_sorcery:\n        bf = game.get_battlefield(controller)\n        for permanent in bf.get_all():\n            hook = getattr(permanent, \"spell_cost_reduction\", None)\n            if hook is not None:\n                try:\n                    raw += hook(game, card)\n                except Exception:\n                    pass\n\n    return max(0, min(raw, generic))\n\n\ndef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n    new_generic = max(0, cost.generic - reduction)\n    return ManaCost(\n        generic=new_generic,\n        pips=dict(cost.pips),\n        x_count=cost.x_count,\n        hybrid=list(cost.hybrid),\n    )\n\n\n# ------------------------------------------------------------------\n# Cast spell\n# ------------------------------------------------------------------\n\ndef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n    \"\"\"Cast *card* from *player*'s hand.\n\n    Pipeline\n    --------\n    1. **Timing check** — instants (and cards with flash) can be cast\n       whenever the player has priority; everything else requires\n       sorcery-speed timing.\n    2. **can_cast** — ask the card whether it can legally be cast.\n    3. **Hand check** — the card must be in the player's hand.\n    4. **Move hand → stack zone** — remove the card from the hand and\n       place it into the player's stack zone.\n    5. **Choose targets** — if the card specifies targets (via\n       :meth:`CardImpl.get_targets`), the player is asked to choose.\n    6. **Mana check / payment** — the player's mana pool must be able to\n       pay the card's mana cost.  If payment fails, the card is rolled\n       back from the stack zone to the hand.\n    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n    8. **Push StackObject** — push a :class:`StackObject` whose\n       ``on_resolve`` callback handles resolution.\n\n    Raises:\n        CastingError: If any legality check fails.\n    \"\"\"\n    # 1. Timing\n    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n        )\n\n    # 2. can_cast\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 3. Hand check\n    hand = game.get_hand(player)\n    if not hand.contains(card):\n        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n\n    # 4. Move card from hand to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    hand.remove(card)\n    stack_zone.add(card)\n\n    # Clear any stale colors_spent from a prior cast before new payment.\n    if hasattr(card, \"colors_spent\"):\n        del card.colors_spent\n\n    # 5. Choose targets\n    target_specs = card.get_targets(game)\n    chosen_targets: list[Any] = []\n    if target_specs:\n        for spec in target_specs:\n            target = player.choose_target(target_specs, spec)\n            # Validate against filter_fn if the spec provides one\n            filter_fn = getattr(spec, \"filter_fn\", None)\n            if filter_fn is not None and target is not None:\n                if not filter_fn(target):\n                    stack_zone.remove(card)\n                    hand.add(card)\n                    raise CastingError(\n                        f\"Cannot cast {card.name!r} — chosen target does not \"\n                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                    )\n            chosen_targets.append(target)\n\n    # 5b. Protection check — reject targets that have protection from this\n    #     spell (the T in DEBT).\n    from engine.protection import has_protection_from\n\n    for target in chosen_targets:\n        if has_protection_from(target, card):\n            # Rollback: move card from stack zone back to hand\n            stack_zone.remove(card)\n            hand.add(card)\n            raise CastingError(\n                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n            )\n\n    # Targets are stored on the StackObject (not the card) and passed\n    # through the resolve pipeline via on_resolve(game, targets=...).\n\n    # 6. Mana check / payment (rollback on failure)\n    # Ensure the card knows its controller so that cost_reduction() hooks\n    # (e.g. Embercleave counting attacking creatures you control) see the\n    # casting player, even for cards that were added to hand without an\n    # explicit controller assignment.\n    if card.controller is None:\n        card.controller = player\n    reduction = get_cost_reduction(game, card, player)\n    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n\n    if not player.mana_pool.can_pay(effective_cost):\n        # Rollback: move card from stack zone back to hand\n        stack_zone.remove(card)\n        hand.add(card)\n        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n\n    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n    player.mana_pool.pay(effective_cost)\n\n    # Store colors of mana spent on the card for mechanics like Converge\n    # that care about the colors used to cast the spell.\n    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n\n    # 7. Call on_cast hook\n    card.on_cast(game)\n\n    # 8. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n    # Fire SpellCastTriggeredEvent now that the spell is on the stack.\n    from engine.events import SpellCastTriggeredEvent\n    game.trigger_manager.fire_event(\n        game,\n        SpellCastTriggeredEvent(spell=stack_obj, card=card, controller=player),\n    )\n\n\n# ------------------------------------------------------------------\n# Cast spell without paying mana cost (free-cast from any zone)\n# ------------------------------------------------------------------\n\n\ndef cast_spell_free(\n    game: GameState,\n    player: Player,\n    card: CardImpl,\n    from_zone: Zone,\n) -> None:\n    \"\"\"Cast *card* without paying its mana cost, using the stack.\n\n    This is used by effects that allow casting from zones other than hand\n    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n    or cascade.\n\n    Pipeline\n    --------\n    1. **can_cast** — ask the card whether it can legally be cast (same\n       legality as :func:`cast_spell`, minus mana/timing constraints).\n    2. Move *card* from *from_zone* to the stack zone.\n    3. Choose targets (if applicable) with validation and protection check.\n    4. Call ``on_cast`` hook.\n    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n       resolution normally (permanents → battlefield, non-permanents →\n       graveyard).\n\n    No timing check or mana payment is performed.  The spell goes on the\n    stack and can be responded to normally (e.g. countered).\n\n    If targeting or other post-move checks fail, the card is rolled back\n    to its source zone.\n\n    Parameters:\n        game: The current game state.\n        player: The player casting the spell.\n        card: The card to cast.\n        from_zone: The zone the card is currently in.\n\n    Raises:\n        CastingError: If the card cannot be found in *from_zone* or\n            legality checks fail.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Ensure controller is set\n    card.controller = player\n    if card.owner is None:\n        card.owner = player\n\n    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 2. Locate card in source zone\n    source_zone_container = player.zones[from_zone]\n    if not source_zone_container.contains(card):\n        # Try to find the card in any player's zone\n        source_zone_container = None\n        for p in game.players:\n            z = p.zones[from_zone]\n            if z.contains(card):\n                source_zone_container = z\n                break\n\n    if source_zone_container is None or not source_zone_container.contains(card):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n        )\n\n    # Move card from source zone to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    source_zone_container.remove(card)\n    stack_zone.add(card)\n\n    # 3. Choose targets (with rollback on failure)\n    try:\n        target_specs = card.get_targets(game)\n        chosen_targets: list[Any] = []\n        if target_specs:\n            for spec in target_specs:\n                target = player.choose_target(target_specs, spec)\n                # Validate against filter_fn if the spec provides one\n                filter_fn = getattr(spec, \"filter_fn\", None)\n                if filter_fn is not None and target is not None:\n                    if not filter_fn(target):\n                        raise CastingError(\n                            f\"Cannot cast {card.name!r} — chosen target does not \"\n                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                        )\n                chosen_targets.append(target)\n\n        # Protection check — reject targets that have protection from this spell\n        from engine.protection import has_protection_from\n\n        for target in chosen_targets:\n            if has_protection_from(target, card):\n                raise CastingError(\n                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n                )\n    except Exception as exc:\n        # Rollback: move card from stack zone back to source zone\n        stack_zone.remove(card)\n        source_zone_container.add(card)\n        raise CastingError(str(exc)) from exc\n\n    # 4. Call on_cast hook\n    card.on_cast(game)\n\n    # 5. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n\n# ------------------------------------------------------------------\n# Resolution (called when the stack pops)\n# ------------------------------------------------------------------\n\ndef _resolve_spell(\n    game: GameState,\n    card: CardImpl,\n    player: Player,\n    stack_obj: StackObject,\n) -> None:\n    \"\"\"Resolve *card* cast by *player*.\n\n    1. Call ``card.on_resolve(game, targets=targets)``.\n    2. Remove the card from the stack zone.\n    3. If the card is a permanent type, move it to the battlefield via\n       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n       registration and the ETB event).\n    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Read targets from the StackObject — the single source of truth.\n    # Set chosen_targets on the card just before resolution so that\n    # _get_chosen_target helpers (which read via getattr) work.\n    targets = stack_obj.targets\n    if targets is not None:\n        card.chosen_targets = targets  # type: ignore[attr-defined]\n\n    card.on_resolve(game)\n\n    if card.card_types & _PERMANENT_TYPES:\n        # Move from stack to battlefield via move_to_zone, which handles\n        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n    else:\n        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n        # If _exile_instead_of_graveyard is set (e.g. by The Dawning Archaic's\n        # \"cast from graveyard\" trigger), exile it instead.  Deliberate\n        # limitation: does not apply to countered spells (those bypass this path).\n        if getattr(card, \"_exile_instead_of_graveyard\", False):\n            card._exile_instead_of_graveyard = False  # consume flag\n            move_to_zone(game, card, Zone.STACK, Zone.EXILE)\n        else:\n            move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n\n\n# ------------------------------------------------------------------\n# Play land (special action — does not use the stack)\n# ------------------------------------------------------------------\n\ndef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n\n    Requirements (all must hold):\n\n    * *land_card* has :attr:`CardType.LAND`.\n    * *player* is the active player.\n    * Current phase is a main phase.\n    * The stack is empty.\n    * ``player.land_plays_remaining > 0``.\n    * The card is in the player's hand.\n\n    On success the card moves from hand to battlefield and\n    ``land_plays_remaining`` is decremented.\n\n    Raises:\n        CastingError: If any requirement is not met.\n    \"\"\"\n    # Must be a land\n    if CardType.LAND not in land_card.card_types:\n        raise CastingError(\n            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n        )\n\n    # Sorcery-speed timing (active player, main phase, stack empty)\n    if not is_sorcery_speed(game, player):\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — must be active player \"\n            \"during main phase with empty stack\"\n        )\n\n    # Land plays remaining\n    if player.land_plays_remaining <= 0:\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n        )\n\n    # Card must be in hand\n    hand = game.get_hand(player)\n    if not hand.contains(land_card):\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — card not in hand\"\n        )\n\n    # Ensure owner/controller are set so move_to_zone routes correctly.\n    if land_card.owner is None:\n        land_card.owner = player\n    land_card.controller = player\n\n    # Move from hand to battlefield via move_to_zone, which fires\n    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n    from engine.zones import move_to_zone\n    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n\n    # Decrement land plays\n    player.land_plays_remaining -= 1\n\n\ndef resolve_top(game: GameState) -> None:\n    \"\"\"Resolve the top spell/ability on the stack.\n\n    Pops the top item from the stack, calls its on_resolve callback,\n    then runs state-based actions.  If the stack is empty this is a no-op.\n    \"\"\"\n    if game.stack.is_empty():\n        return\n    from engine.state_based_actions import resolve_state_based_actions\n\n    obj = game.stack.pop()\n    obj.on_resolve(game)\n    resolve_state_based_actions(game)\n","numLines":518,"startLine":1,"totalLines":518}}}
