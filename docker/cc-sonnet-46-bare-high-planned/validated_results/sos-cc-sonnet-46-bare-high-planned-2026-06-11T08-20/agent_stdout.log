{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TDBVNsUFCsH5HUYp9vZ6yU","type":"tool_result","content":"1\t\"\"\"Card implementation for Chandra, Flameshaper.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom typing import TYPE_CHECKING, Any\n4\tfrom engine.card import Creature, LoyaltyAbility, Planeswalker\n5\tfrom engine.types import CardType, Keyword, ManaCost, ManaType, Supertype, Zone\n6\tfrom engine.events import EndStepTriggeredEvent\n7\tif TYPE_CHECKING:\n8\t    from engine.game_state import GameState\n9\t    from engine.player import Player\n10\t    from cards.registry import CardRegistry\n11\t\n12\tclass ChandraFlameshaper(Planeswalker):\n13\t    \"\"\"Chandra, Flameshaper — {5}{R}{R} — 6 loyalty.\n14\t\n15\t    +2: Add {R}{R}{R}. Exile top three cards. May play one this turn.\n16\t    +1: Create a token copy of target creature you control (has haste,\n17\t        sacrifice at end step).\n18\t    −4: Chandra deals 8 damage divided among any number of target\n19\t        creatures and/or planeswalkers.\n20\t    \"\"\"\n21\t\n22\t    def __init__(self, **kwargs: Any) -> None:\n23\t        kwargs.setdefault('name', 'Chandra, Flameshaper')\n24\t        kwargs.setdefault('mana_cost', ManaCost.parse('{5}{R}{R}'))\n25\t        kwargs.setdefault('starting_loyalty', 6)\n26\t        kwargs.setdefault('supertypes', set())\n27\t        kwargs['supertypes'] = (kwargs.get('supertypes') or set()) | {Supertype.LEGENDARY}\n28\t        kwargs.setdefault('subtypes', set())\n29\t        kwargs['subtypes'] = (kwargs.get('subtypes') or set()) | {'Chandra'}\n30\t        kwargs.setdefault('rules_text', '+2: Add {R}{R}{R}. Exile the top three cards of your library. Choose one. You may play that card this turn.\\n+1: Create a token that\\'s a copy of target creature you control, except it has haste and \"At the beginning of the end step, sacrifice this token.\"\\n−4: Chandra deals 8 damage divided as you choose among any number of target creatures and/or planeswalkers.')\n31\t        super().__init__(**kwargs)\n32\t\n33\t    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n34\t        pw = self\n35\t\n36\t        def _plus2(game: Any) -> None:\n37\t            \"\"\"Add {R}{R}{R}. Exile top 3, may play one this turn.\"\"\"\n38\t            controller = pw.controller\n39\t            if controller is None:\n40\t                return\n41\t            controller.mana_pool.add(ManaType.RED, 3)\n42\t            library = controller.zones[Zone.LIBRARY]\n43\t            exiled_cards: list[Any] = []\n44\t            for _ in range(min(3, len(library))):\n45\t                cards = library.get_all()\n46\t                if cards:\n47\t                    card = cards[-1]\n48\t                    library.remove(card)\n49\t                    exile_zone = controller.zones[Zone.EXILE]\n50\t                    exile_zone.add(card)\n51\t                    exiled_cards.append(card)\n52\t            if exiled_cards:\n53\t                try:\n54\t                    chosen = controller.choose_card(exiled_cards, 'Choose one exiled card to play this turn')\n55\t                except Exception:\n56\t                    chosen = exiled_cards[0]\n57\t                if chosen is not None and chosen in exiled_cards:\n58\t                    chosen._playable_this_turn = True\n59\t                    chosen._playable_by = controller\n60\t\n61\t        def _plus1(game: Any) -> None:\n62\t            \"\"\"Create a token copy of target creature (with haste, sacrifice at end step).\"\"\"\n63\t            from engine.game import create_token\n64\t            from engine.triggers import TriggerRegistration\n65\t            target = getattr(pw, '_resolve_target', None)\n66\t            controller = pw.controller\n67\t            if target is None or controller is None:\n68\t                return\n69\t            token = Creature(name=getattr(target, 'name', 'Token'), base_power=getattr(target, 'base_power', 0), base_toughness=getattr(target, 'base_toughness', 0), subtypes=getattr(target, 'subtypes', set()).copy() if getattr(target, 'subtypes', None) else set(), keywords=getattr(target, 'keywords', Keyword(0)) | Keyword.HASTE)\n70\t            if hasattr(target, 'card_types'):\n71\t                token.card_types = set(target.card_types)\n72\t            create_token(game, controller, token)\n73\t\n74\t            def _eot_condition(game: Any, event: dict) -> bool:\n75\t                return True\n76\t\n77\t            def _eot_effect(game: Any) -> None:\n78\t                \"\"\"Sacrifice the token at end of turn.\"\"\"\n79\t                from engine.game import sacrifice\n80\t                bf = game.get_battlefield(controller)\n81\t                if bf.contains(token):\n82\t                    sacrifice(game, controller, token)\n83\t            game.trigger_manager.register(TriggerRegistration(event_type=EndStepTriggeredEvent, condition=_eot_condition, effect=_eot_effect, source=token, controller=controller))\n84\t\n85\t        def _minus4(game: Any) -> None:\n86\t            \"\"\"Deal 8 damage divided among targets.\"\"\"\n87\t            from engine.game import deal_damage\n88\t            damage_assignments = getattr(pw, '_damage_assignments', None)\n89\t            if damage_assignments:\n90\t                for target, amount in damage_assignments:\n91\t                    deal_damage(game, pw, target, amount)\n92\t                return\n93\t            targets = getattr(pw, '_resolve_targets', None)\n94\t            if targets and len(targets) > 0:\n95\t                damage_per = 8 // len(targets)\n96\t                remainder = 8 % len(targets)\n97\t                for i, t in enumerate(targets):\n98\t                    dmg = damage_per + (1 if i < remainder else 0)\n99\t                    deal_damage(game, pw, t, dmg)\n100\t            else:\n101\t                target = getattr(pw, '_resolve_target', None)\n102\t                if target is not None:\n103\t                    deal_damage(game, pw, target, 8)\n104\t        return [LoyaltyAbility(loyalty_cost=+2, effect=_plus2, description='+2: Add {R}{R}{R}. Exile top 3, choose one to play this turn.'), LoyaltyAbility(loyalty_cost=+1, effect=_plus1, description='+1: Create a hasty token copy of target creature (sacrifice at end step).'), LoyaltyAbility(loyalty_cost=-4, effect=_minus4, description='−4: Deal 8 damage divided among target creatures and/or planeswalkers.')]\n105\t"}]},"parent_tool_use_id":null,"session_id":"8ad560dd-f0de-48bf-a5ec-5012d23eae4b","uuid":"1ede7c29-5dd4-45a8-8ead-81fff5871dc4","timestamp":"2026-06-11T08:54:57.457Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_81/card_impl.py","content":"\"\"\"Card implementation for Chandra, Flameshaper.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import Creature, LoyaltyAbility, Planeswalker\nfrom engine.types import CardType, Keyword, ManaCost, ManaType, Supertype, Zone\nfrom engine.events import EndStepTriggeredEvent\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n    from cards.registry import CardRegistry\n\nclass ChandraFlameshaper(Planeswalker):\n    \"\"\"Chandra, Flameshaper — {5}{R}{R} — 6 loyalty.\n\n    +2: Add {R}{R}{R}. Exile top three cards. May play one this turn.\n    +1: Create a token copy of target creature you control (has haste,\n        sacrifice at end step).\n    −4: Chandra deals 8 damage divided among any number of target\n        creatures and/or planeswalkers.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Chandra, Flameshaper')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{5}{R}{R}'))\n        kwargs.setdefault('starting_loyalty', 6)\n        kwargs.setdefault('supertypes', set())\n        kwargs['supertypes'] = (kwargs.get('supertypes') or set()) | {Supertype.LEGENDARY}\n        kwargs.setdefault('subtypes', set())\n        kwargs['subtypes'] = (kwargs.get('subtypes') or set()) | {'Chandra'}\n        kwargs.setdefault('rules_text', '+2: Add {R}{R}{R}. Exile the top three cards of your library. Choose one. You may play that card this turn.\\n+1: Create a token that\\'s a copy of target creature you control, except it has haste and \"At the beginning of the end step, sacrifice this token.\"\\n−4: Chandra deals 8 damage divided as you choose among any number of target creatures and/or planeswalkers.')\n        super().__init__(**kwargs)\n\n    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n        pw = self\n\n        def _plus2(game: Any) -> None:\n            \"\"\"Add {R}{R}{R}. Exile top 3, may play one this turn.\"\"\"\n            controller = pw.controller\n            if controller is None:\n                return\n            controller.mana_pool.add(ManaType.RED, 3)\n            library = controller.zones[Zone.LIBRARY]\n            exiled_cards: list[Any] = []\n            for _ in range(min(3, len(library))):\n                cards = library.get_all()\n                if cards:\n                    card = cards[-1]\n                    library.remove(card)\n                    exile_zone = controller.zones[Zone.EXILE]\n                    exile_zone.add(card)\n                    exiled_cards.append(card)\n            if exiled_cards:\n                try:\n                    chosen = controller.choose_card(exiled_cards, 'Choose one exiled card to play this turn')\n                except Exception:\n                    chosen = exiled_cards[0]\n                if chosen is not None and chosen in exiled_cards:\n                    chosen._playable_this_turn = True\n                    chosen._playable_by = controller\n\n        def _plus1(game: Any) -> None:\n            \"\"\"Create a token copy of target creature (with haste, sacrifice at end step).\"\"\"\n            from engine.game import create_token\n            from engine.triggers import TriggerRegistration\n            target = getattr(pw, '_resolve_target', None)\n            controller = pw.controller\n            if target is None or controller is None:\n                return\n            token = Creature(name=getattr(target, 'name', 'Token'), base_power=getattr(target, 'base_power', 0), base_toughness=getattr(target, 'base_toughness', 0), subtypes=getattr(target, 'subtypes', set()).copy() if getattr(target, 'subtypes', None) else set(), keywords=getattr(target, 'keywords', Keyword(0)) | Keyword.HASTE)\n            if hasattr(target, 'card_types'):\n                token.card_types = set(target.card_types)\n            create_token(game, controller, token)\n\n            def _eot_condition(game: Any, event: dict) -> bool:\n                return True\n\n            def _eot_effect(game: Any) -> None:\n                \"\"\"Sacrifice the token at end of turn.\"\"\"\n                from engine.game import sacrifice\n                bf = game.get_battlefield(controller)\n                if bf.contains(token):\n                    sacrifice(game, controller, token)\n            game.trigger_manager.register(TriggerRegistration(event_type=EndStepTriggeredEvent, condition=_eot_condition, effect=_eot_effect, source=token, controller=controller))\n\n        def _minus4(game: Any) -> None:\n            \"\"\"Deal 8 damage divided among targets.\"\"\"\n            from engine.game import deal_damage\n            damage_assignments = getattr(pw, '_damage_assignments', None)\n            if damage_assignments:\n                for target, amount in damage_assignments:\n                    deal_damage(game, pw, target, amount)\n                return\n            targets = getattr(pw, '_resolve_targets', None)\n            if targets and len(targets) > 0:\n                damage_per = 8 // len(targets)\n                remainder = 8 % len(targets)\n                for i, t in enumerate(targets):\n                    dmg = damage_per + (1 if i < remainder else 0)\n                    deal_damage(game, pw, t, dmg)\n            else:\n                target = getattr(pw, '_resolve_target', None)\n                if target is not None:\n                    deal_damage(game, pw, target, 8)\n        return [LoyaltyAbility(loyalty_cost=+2, effect=_plus2, description='+2: Add {R}{R}{R}. Exile top 3, choose one to play this turn.'), LoyaltyAbility(loyalty_cost=+1, effect=_plus1, description='+1: Create a hasty token copy of target creature (sacrifice at end step).'), LoyaltyAbility(loyalty_cost=-4, effect=_minus4, description='−4: Deal 8 damage divided among target creatures and/or planeswalkers.')]\n","numLines":105,"startLine":1,"totalLines":105}}}
