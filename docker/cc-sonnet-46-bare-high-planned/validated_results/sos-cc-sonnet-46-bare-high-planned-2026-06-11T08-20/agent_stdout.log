   ctrl = pw.controller","+            if ctrl is None:","+                return","+            target = _get_target(pw)","+            if target is None:","+                return","+            # Validate: must be a creature card in controller's graveyard with MV ≤ 3","+            gy = ctrl.zones[Zone.GRAVEYARD]","+            if not gy.contains(target):","+                return","+            if CardType.CREATURE not in getattr(target, \"card_types\", set()):","+                return","+            mc = getattr(target, \"mana_cost\", None)","+            if mc is not None and mc.cmc > 3:","+                return","+            move_to_zone(game, target, Zone.GRAVEYARD, Zone.BATTLEFIELD)","+","+        def _minus7(game: Any) -> None:","+            \"\"\"Flip 5 coins; target opponent skips next X turns (X = heads).\"\"\"","+            target = _get_target(pw)","+            if target is None or not hasattr(target, \"life\"):","+                return  # target must be a player","+","+            rng = getattr(game, \"rng\", None)","+            if rng is None:","+                rng = random.Random()","+","+            heads = sum(rng.randint(0, 1) for _ in range(5))","+            if heads > 0:","+                current_skips = getattr(target, \"skip_turns\", 0)","+                target.skip_turns = current_skips + heads  # type: ignore[attr-defined]","+","+        return [","+            LoyaltyAbility(loyalty_cost=+1, effect=_plus1, description=\"+1: Surveil 2.\"),","+            LoyaltyAbility(loyalty_cost=-1, effect=_minus1, description=\"−1: Target players each discard a card.\"),","+            LoyaltyAbility(loyalty_cost=-2, effect=_minus2, description=\"−2: Reanimate creature with MV ≤ 3 from graveyard.\"),","+            LoyaltyAbility(loyalty_cost=-7, effect=_minus7, description=\"−7: Flip 5 coins; opponent skips X turns (heads).\"),","+        ]"]}],"originalFile":"\"\"\"Card implementation for Ral Zarek, Guest Lecturer.\"\"\"\n\nfrom __future_