   power = getattr(target, \"power\", getattr(target, \"base_power\", 0))","+","+        # Exile target creature","+        from engine.game import exile","+        exile(game, target)","+","+        # Its controller gains life equal to its power","+        if ctrl is not None and power > 0:","+            ctrl.life += power","+","+","+def _make_inkling_token() -> Creature:","+    \"\"\"Create a 1/1 white-black Inkling creature token with flying.\"\"\"","+    token = Creature(","+        name=\"Inkling\",","+        base_power=1,","+        base_toughness=1,","+        keywords=Keyword.FLYING,","+        subtypes={\"Inkling\"},","+    )","+    return token","+","+","+class EmeritusOfTruceSwordsToPlowshares(Creature):","+    \"\"\"Emeritus of Truce // Swords to Plowshares — {1}{W}{W} // {W}.","+","+    Creature — Cat Cleric 3/3","+    When this creature enters, target player creates a 1/1 white and black","+    Inkling creature token with flying. Then if an opponent controls more","+    creatures than you, this creature becomes prepared.","+    (While it's prepared, you may cast a copy of its spell. Doing so","+    unprepares it.)","+","+    SOS collector number 13.","+    \"\"\"","+","+    def __init__(self, **kwargs: Any) -> None:","+        kwargs.setdefault(\"name\", \"Emeritus of Truce // Swords to Plowshares\")","+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{W}{W}\"))","+        kwargs.setdefault(\"subtypes\", {\"Cat\", \"Cleric\"})","+        kwargs.setdefault(\"supertypes\", set())","+        kwargs.setdefault(\"base_power\", 3)","+        kwargs.setdefault(\"base_toughness\", 3)","+        kwargs.setdefault(","+            \"rules_text\",","+            \"When this creature enters, target player creates a 1/1 white \"","+            \"and black Inkling creature token with flying. Then if an opponent \"","+            \"controls more creatures than you, this creature becomes prepared.\\n\"","+            \"(While it's prepared, you may cast a