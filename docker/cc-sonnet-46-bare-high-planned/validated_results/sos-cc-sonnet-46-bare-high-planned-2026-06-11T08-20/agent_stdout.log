_top_of_stack\n        _resolve_top_of_stack(game)\n\n        # Instant stays in graveyard\n        assert instant in p1.zones[Zone.GRAVEYARD].get_all()"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":648,"cache_read_input_tokens":140204,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":648},"output_tokens":33,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8ad560dd-f0de-48bf-a5ec-5012d23eae4b","uuid":"6f05ad7f-1bd4-47e0-98d8-ad29e6ed2805","request_id":"req_011CbwADymwDqPEDUYgwbpks"}
