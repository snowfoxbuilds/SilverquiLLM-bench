{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GJ4AyExgzZTZsaSMvrMXnm","type":"tool_result","content":"1\t\"\"\"Card implementation for Divine Resilience.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Instant\n8\tfrom engine.continuous_effects import (\n9\t    ContinuousEffect,\n10\t    DURATION_END_OF_TURN,\n11\t    Layer,\n12\t)\n13\tfrom engine.types import CardType, Keyword, ManaCost, TargetRequirement, Zone\n14\t\n15\tif TYPE_CHECKING:\n16\t    from engine.game_state import GameState\n17\t\n18\t\n19\tdef _is_on_battlefield(game: Any, obj: Any) -> bool:\n20\t    \"\"\"Return True if *obj* is on any player's battlefield.\"\"\"\n21\t    for player in game.players:\n22\t        if game.get_battlefield(player).contains(obj):\n23\t            return True\n24\t    return False\n25\t\n26\t\n27\tclass DivineResilience(Instant):\n28\t    \"\"\"Divine Resilience — {W} — Instant.\n29\t\n30\t    Kicker {2}{W}\n31\t    Target creature you control gains indestructible until end of turn.\n32\t    If this spell was kicked, instead any number of target creatures you\n33\t    control gain indestructible until end of turn.\n34\t\n35\t    FDN collector number 10.\n36\t    \"\"\"\n37\t\n38\t    def __init__(self, **kwargs: Any) -> None:\n39\t        kwargs.setdefault(\"name\", \"Divine Resilience\")\n40\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{W}\"))\n41\t        kwargs.setdefault(\n42\t            \"rules_text\",\n43\t            \"Kicker {2}{W}\\n\"\n44\t            \"Target creature you control gains indestructible until end of \"\n45\t            \"turn. If this spell was kicked, instead any number of target \"\n46\t            \"creatures you control gain indestructible until end of turn.\",\n47\t        )\n48\t        super().__init__(**kwargs)\n49\t        self.kicked: bool = False\n50\t        self.kicker_cost: ManaCost = ManaCost.parse(\"{2}{W}\")\n51\t\n52\t    def get_targets(self, game: \"GameState\") -> list[Any]:\n53\t        \"\"\"Target creature(s) you control.\n54\t\n55\t        ENGINE LIMITATION: TargetRequirement does not support variable target\n56\t        counts.  When kicked, we return a single requirement; the casting\n57\t        pipeline should allow the player to choose any number of creatures\n58\t        (the resolve logic handles multiple via ``chosen_targets``).\n59\t        \"\"\"\n60\t        controller = self.controller\n61\t\n62\t        def _filter(obj: Any) -> bool:\n63\t            if CardType.CREATURE not in getattr(obj, \"card_types\", set()):\n64\t                return False\n65\t            return getattr(obj, \"controller\", None) is controller\n66\t\n67\t        return [\n68\t            TargetRequirement(\n69\t                filter_fn=_filter,\n70\t                description=(\n71\t                    \"any number of target creatures you control\"\n72\t                    if self.kicked\n73\t                    else \"target creature you control\"\n74\t                ),\n75\t                zone=Zone.BATTLEFIELD,\n76\t            )\n77\t        ]\n78\t\n79\t    def on_resolve(self, game: \"GameState\") -> None:\n80\t        \"\"\"Grant indestructible until end of turn to chosen target(s).\"\"\"\n81\t        chosen = getattr(self, \"chosen_targets\", None)\n82\t        if not chosen:\n83\t            t = getattr(self, \"_resolve_target\", None)\n84\t            chosen = [t] if t is not None else []\n85\t\n86\t        if not chosen:\n87\t            return\n88\t\n89\t        # If kicked, all chosen targets; otherwise just the first\n90\t        targets = chosen if self.kicked else chosen[:1]\n91\t\n92\t        for target in targets:\n93\t            if not _is_on_battlefield(game, target):\n94\t                continue\n95\t            if CardType.CREATURE not in getattr(target, \"card_types\", set()):\n96\t                continue\n97\t\n98\t            creature_ref = target\n99\t\n100\t            def _apply_indestructible(game: Any, _c=creature_ref) -> None:\n101\t                if not _is_on_battlefield(game, _c):\n102\t                    return\n103\t                _c.keywords = getattr(_c, \"keywords\", Keyword(0)) | Keyword.INDESTRUCTIBLE\n104\t\n105\t            game.effect_manager.add(ContinuousEffect(\n106\t                source=self,\n107\t                layer=Layer.ABILITY,\n108\t                sublayer=None,\n109\t                apply=_apply_indestructible,\n110\t                duration=DURATION_END_OF_TURN,\n111\t            ))\n112\t"}]},"parent_tool_use_id":null,"session_id":"8ad560dd-f0de-48bf-a5ec-5012d23eae4b","uuid":"783b8d67-67e8-4c67-bd20-61404410e3f2","timestamp":"2026-06-11T08:38:07.156Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_10/card_impl.py","content":"\"\"\"Card implementation for Divine Resilience.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import Instant\nfrom engine.continuous_effects import (\n    ContinuousEffect,\n    DURATION_END_OF_TURN,\n    Layer,\n)\nfrom engine.types import CardType, Keyword, ManaCost, TargetRequirement, Zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\ndef _is_on_battlefield(game: Any, obj: Any) -> bool:\n    \"\"\"Return True if *obj* is on any player's battlefield.\"\"\"\n    for player in game.players:\n        if game.get_battlefield(player).contains(obj):\n            return True\n    return False\n\n\nclass DivineResilience(Instant):\n    \"\"\"Divine Resilience — {W} — Instant.\n\n    Kicker {2}{W}\n    Target creature you control gains indestructible until end of turn.\n    If this spell was kicked, instead any number of target creatures you\n    control gain indestructible until end of turn.\n\n    FDN collector number 10.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"Divine Resilience\")\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{W}\"))\n        kwargs.setdefault(\n            \"rules_text\",\n            \"Kicker {2}{W}\\n\"\n            \"Target creature you control gains indestructible until end of \"\n            \"turn. If this spell was kicked, instead any number of target \"\n            \"creatures you control gain indestructible until end of turn.\",\n        )\n        super().__init__(**kwargs)\n        self.kicked: bool = False\n        self.kicker_cost: ManaCost = ManaCost.parse(\"{2}{W}\")\n\n    def get_targets(self, game: \"GameState\") -> list[Any]:\n        \"\"\"Target creature(s) you control.\n\n        ENGINE LIMITATION: TargetRequirement does not support variable target\n        counts.  When kicked, we return a single requirement; the casting\n        pipeline should allow the player to choose any number of creatures\n        (the resolve logic handles multiple via ``chosen_targets``).\n        \"\"\"\n        controller = self.controller\n\n        def _filter(obj: Any) -> bool:\n            if CardType.CREATURE not in getattr(obj, \"card_types\", set()):\n                return False\n            return getattr(obj, \"controller\", None) is controller\n\n        return [\n            TargetRequirement(\n                filter_fn=_filter,\n                description=(\n                    \"any number of target creatures you control\"\n                    if self.kicked\n                    else \"target creature you control\"\n                ),\n                zone=Zone.BATTLEFIELD,\n            )\n        ]\n\n    def on_resolve(self, game: \"GameState\") -> None:\n        \"\"\"Grant indestructible until end of turn to chosen target(s).\"\"\"\n        chosen = getattr(self, \"chosen_targets\", None)\n        if not chosen:\n            t = getattr(self, \"_resolve_target\", None)\n            chosen = [t] if t is not None else []\n\n        if not chosen:\n            return\n\n        # If kicked, all chosen targets; otherwise just the first\n        targets = chosen if self.kicked else chosen[:1]\n\n        for target in targets:\n            if not _is_on_battlefield(game, target):\n                continue\n            if CardType.CREATURE not in getattr(target, \"card_types\", set()):\n                continue\n\n            creature_ref = target\n\n            def _apply_indestructible(game: Any, _c=creature_ref) -> None:\n                if not _is_on_battlefield(game, _c):\n                    return\n                _c.keywords = getattr(_c, \"keywords\", Keyword(0)) | Keyword.INDESTRUCTIBLE\n\n            game.effect_manager.add(ContinuousEffect(\n                source=self,\n                layer=Layer.ABILITY,\n                sublayer=None,\n                apply=_apply_indestructible,\n                duration=DURATION_END_OF_TURN,\n            ))\n","numLines":112,"startLine":1,"totalLines":112}}}
