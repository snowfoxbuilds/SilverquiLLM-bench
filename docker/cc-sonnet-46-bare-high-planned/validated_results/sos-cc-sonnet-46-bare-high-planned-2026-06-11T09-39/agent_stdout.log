{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VYN3d4pLSDEySsS6AZWnQB","type":"tool_result","content":"1\t\"\"\"Card implementation for Wary Thespian.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom typing import TYPE_CHECKING, Any\n4\tfrom engine.card import ArtifactCreature, Creature\n5\tfrom engine.types import CardType, Keyword, ManaCost, Supertype, Zone\n6\tfrom engine.events import CreatureDiesTriggeredEvent, EntersBattlefieldTriggeredEvent\n7\tif TYPE_CHECKING:\n8\t    from engine.game_state import GameState\n9\t    from cards.registry import CardRegistry\n10\t\n11\tdef _self_dies_condition(source: Any):\n12\t    \"\"\"Return a condition callable that matches only when *source* dies.\"\"\"\n13\t\n14\t    def _condition(game: Any, event: dict) -> bool:\n15\t        return event.creature is source\n16\t    return _condition\n17\t\n18\tdef _self_etb_condition(source: Any):\n19\t    \"\"\"Return a condition callable that matches only when *source* enters.\"\"\"\n20\t\n21\t    def _condition(game: Any, event: dict) -> bool:\n22\t        return event.permanent is source\n23\t    return _condition\n24\t\n25\tclass WaryThespian(Creature):\n26\t    \"\"\"Wary Thespian — {1}{G} — 3/1 — Cat Druid\n27\t\n28\t    When this creature enters or dies, surveil 1.\n29\t\n30\t    FDN collector number 235.\n31\t    \"\"\"\n32\t\n33\t    def __init__(self, **kwargs: Any) -> None:\n34\t        kwargs.setdefault('name', 'Wary Thespian')\n35\t        kwargs.setdefault('mana_cost', ManaCost.parse('{1}{G}'))\n36\t        kwargs.setdefault('subtypes', {'Cat', 'Druid'})\n37\t        kwargs.setdefault('base_power', 3)\n38\t        kwargs.setdefault('base_toughness', 1)\n39\t        kwargs.setdefault('rules_text', 'When this creature enters or dies, surveil 1.')\n40\t        super().__init__(**kwargs)\n41\t\n42\t    def register_triggers(self, game: GameState) -> None:\n43\t        from engine.triggers import TriggerRegistration\n44\t        source = self\n45\t\n46\t        def _surveil_effect(game: GameState) -> None:\n47\t            controller = getattr(source, 'controller', None) or getattr(source, 'owner', None)\n48\t            if controller is None:\n49\t                return\n50\t            library = controller.zones[Zone.LIBRARY]\n51\t            if len(library) > 0:\n52\t                card = library.top(1)[0]\n53\t                library.remove(card)\n54\t                graveyard = controller.zones[Zone.GRAVEYARD]\n55\t                graveyard.add(card)\n56\t        controller = getattr(self, 'controller', None) or game.active_player\n57\t        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=_self_etb_condition(self), effect=_surveil_effect, source=self, controller=controller))\n58\t        game.trigger_manager.register(TriggerRegistration(event_type=CreatureDiesTriggeredEvent, condition=_self_dies_condition(self), effect=_surveil_effect, source=self, controller=controller))\n59\t"}]},"parent_tool_use_id":null,"session_id":"2e9c65f7-ddbe-4353-b4d6-7512c729a9ad","uuid":"80ce3806-b168-4d10-9dca-a1a86529177b","timestamp":"2026-06-11T10:09:14.821Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_235/card_impl.py","content":"\"\"\"Card implementation for Wary Thespian.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import ArtifactCreature, Creature\nfrom engine.types import CardType, Keyword, ManaCost, Supertype, Zone\nfrom engine.events import CreatureDiesTriggeredEvent, EntersBattlefieldTriggeredEvent\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from cards.registry import CardRegistry\n\ndef _self_dies_condition(source: Any):\n    \"\"\"Return a condition callable that matches only when *source* dies.\"\"\"\n\n    def _condition(game: Any, event: dict) -> bool:\n        return event.creature is source\n    return _condition\n\ndef _self_etb_condition(source: Any):\n    \"\"\"Return a condition callable that matches only when *source* enters.\"\"\"\n\n    def _condition(game: Any, event: dict) -> bool:\n        return event.permanent is source\n    return _condition\n\nclass WaryThespian(Creature):\n    \"\"\"Wary Thespian — {1}{G} — 3/1 — Cat Druid\n\n    When this creature enters or dies, surveil 1.\n\n    FDN collector number 235.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Wary Thespian')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{1}{G}'))\n        kwargs.setdefault('subtypes', {'Cat', 'Druid'})\n        kwargs.setdefault('base_power', 3)\n        kwargs.setdefault('base_toughness', 1)\n        kwargs.setdefault('rules_text', 'When this creature enters or dies, surveil 1.')\n        super().__init__(**kwargs)\n\n    def register_triggers(self, game: GameState) -> None:\n        from engine.triggers import TriggerRegistration\n        source = self\n\n        def _surveil_effect(game: GameState) -> None:\n            controller = getattr(source, 'controller', None) or getattr(source, 'owner', None)\n            if controller is None:\n                return\n            library = controller.zones[Zone.LIBRARY]\n            if len(library) > 0:\n                card = library.top(1)[0]\n                library.remove(card)\n                graveyard = controller.zones[Zone.GRAVEYARD]\n                graveyard.add(card)\n        controller = getattr(self, 'controller', None) or game.active_player\n        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=_self_etb_condition(self), effect=_surveil_effect, source=self, controller=controller))\n        game.trigger_manager.register(TriggerRegistration(event_type=CreatureDiesTriggeredEvent, condition=_self_dies_condition(self), effect=_surveil_effect, source=self, controller=controller))\n","numLines":59,"startLine":1,"totalLines":59}}}
