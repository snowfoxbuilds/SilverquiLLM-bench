"damage_marked\")\n                ),\n                description=\"any target (player or creature)\",\n                zone=Zone.BATTLEFIELD,\n            ),\n        ]\n\n    def on_resolve(self, game: \"GameState\") -> None:\n        \"\"\"Resolve Together as One — Converge X equals colors of mana spent.\"\"\"\n        from engine.game import deal_damage, draw_card\n\n        colors_spent = getattr(self, \"colors_spent\", [])\n        x = len(set(colors_spent))\n\n        controller = self.controller\n        targets = getattr(self, \"chosen_targets\", [])\n        target_player = targets[0] if len(targets) >= 1 else None\n        any_target = targets[1] if len(targets) >= 2 else None\n\n        # Draw X cards for target player.\n        if target_player is not None and x > 0:\n            for _ in range(x):\n                draw_card(game, target_player)\n\n        # Deal X damage to any target.\n        if any_target is not None and x > 0:\n            deal_damage(game, self, any_target, x)\n\n        # You gain X life.\n        if controller is not None and x > 0:\n            controller.life += x\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":747,"cache_read_input_tokens":98989,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":747},"output_tokens":33,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2e9c65f7-ddbe-4353-b4d6-7512c729a9ad","uuid":"14f5c859-4e91-421d-8189-b8a18f599dbb","request_id":"req_011CbwFmHaCeEWqAwHAV6xUE"}
