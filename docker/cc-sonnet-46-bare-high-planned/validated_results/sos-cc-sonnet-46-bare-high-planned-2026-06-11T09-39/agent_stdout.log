{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GELTvo1LBPWB1WRFDxraEd","type":"tool_result","content":"1\t\"\"\"Card implementation for The Dawning Archaic.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.events import AttacksTriggeredEvent, MoveToGraveyardReplacementEvent\n9\tfrom engine.replacement_effects import ReplacementEffect\n10\tfrom engine.types import CardType, Keyword, ManaCost, Supertype, Zone\n11\t\n12\tif TYPE_CHECKING:\n13\t    from engine.game_state import GameState\n14\t\n15\t\n16\tclass TheDawningArchaic(Creature):\n17\t    \"\"\"The Dawning Archaic — {10} — Legendary Creature — Avatar 7/7.\n18\t\n19\t    This spell costs {1} less to cast for each instant and sorcery card in\n20\t    your graveyard. Reach. Whenever The Dawning Archaic attacks, you may cast\n21\t    target instant or sorcery card from your graveyard without paying its mana\n22\t    cost. If that spell would be put into your graveyard, exile it instead.\n23\t\n24\t    SOS collector number 1.\n25\t    \"\"\"\n26\t\n27\t    def __init__(self, **kwargs: Any) -> None:\n28\t        kwargs.setdefault(\"name\", \"The Dawning Archaic\")\n29\t        kwargs.setdefault(\"mana_cost\", ManaCost(generic=10))\n30\t        kwargs.setdefault(\"subtypes\", {\"Avatar\"})\n31\t        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n32\t        kwargs.setdefault(\"keywords\", Keyword.REACH)\n33\t        kwargs.setdefault(\"base_power\", 7)\n34\t        kwargs.setdefault(\"base_toughness\", 7)\n35\t        kwargs.setdefault(\n36\t            \"rules_text\",\n37\t            \"This spell costs {1} less to cast for each instant and sorcery card in \"\n38\t            \"your graveyard.\\nReach\\nWhenever The Dawning Archaic attacks, you may \"\n39\t            \"cast target instant or sorcery card from your graveyard without paying \"\n40\t            \"its mana cost. If that spell would be put into your graveyard, exile it instead.\",\n41\t        )\n42\t        super().__init__(**kwargs)\n43\t\n44\t    def cost_reduction(self, game: \"GameState\") -> int:\n45\t        \"\"\"1 less per instant/sorcery in your graveyard (generic only).\"\"\"\n46\t        controller = self.controller\n47\t        if controller is None:\n48\t            return 0\n49\t        gy = controller.zones[Zone.GRAVEYARD]\n50\t        count = 0\n51\t        for card in gy.get_all():\n52\t            types = getattr(card, \"card_types\", set())\n53\t            if CardType.INSTANT in types or CardType.SORCERY in types:\n54\t                count += 1\n55\t        return count\n56\t\n57\t    def register_triggers(self, game: \"GameState\") -> None:\n58\t        \"\"\"Register attack trigger — may cast instant/sorcery from graveyard free.\"\"\"\n59\t        from engine.triggers import TriggerRegistration\n60\t\n61\t        source = self\n62\t        controller = getattr(self, \"controller\", None) or game.active_player\n63\t\n64\t        def _attack_condition(game: Any, event: Any) -> bool:\n65\t            return event.creature is source\n66\t\n67\t        def _attack_effect(game: \"GameState\") -> None:\n68\t            ctrl = getattr(source, \"controller\", None)\n69\t            if ctrl is None:\n70\t                return\n71\t\n72\t            # Find instant/sorcery cards in controller's graveyard.\n73\t            gy = ctrl.zones[Zone.GRAVEYARD]\n74\t            legal = [\n75\t                c for c in gy.get_all()\n76\t                if CardType.INSTANT in getattr(c, \"card_types\", set())\n77\t                or CardType.SORCERY in getattr(c, \"card_types\", set())\n78\t            ]\n79\t            if not legal:\n80\t                return\n81\t\n82\t            # Let player choose (or decline by choosing None).\n83\t            try:\n84\t                chosen = ctrl.choose_card(legal, \"Choose an instant/sorcery to cast for free (or None to decline)\")\n85\t            except Exception:\n86\t                return\n87\t\n88\t            if chosen is None or chosen not in legal:\n89\t                return\n90\t\n91\t            # Register one-shot exile-instead replacement for this specific spell.\n92\t            _register_exile_replacement(game, chosen, ctrl)\n93\t\n94\t            # Cast from graveyard for free.\n95\t            from engine.casting import cast_spell_free, CastingError\n96\t            try:\n97\t                cast_spell_free(game, ctrl, chosen, Zone.GRAVEYARD)\n98\t            except CastingError:\n99\t                # If cast fails (e.g. no legal targets), remove the replacement.\n100\t                game.replacement_manager.unregister(chosen)\n101\t\n102\t        game.trigger_manager.register(\n103\t            TriggerRegistration(\n104\t                event_type=AttacksTriggeredEvent,\n105\t                condition=_attack_condition,\n106\t                effect=_attack_effect,\n107\t                source=self,\n108\t                controller=controller,\n109\t            )\n110\t        )\n111\t\n112\t\n113\tdef _register_exile_replacement(\n114\t    game: \"GameState\", spell: Any, controller: Any\n115\t) -> None:\n116\t    \"\"\"Register a one-shot replacement that exiles *spell* instead of graveyard.\"\"\"\n117\t\n118\t    def _condition(game: Any, event: Any) -> bool:\n119\t        # Only applies to this specific spell card moving to graveyard.\n120\t        return getattr(event, \"_source_card\", None) is spell\n121\t\n122\t    def _replacement(game: Any, event: Any) -> Any:\n123\t        event.destination = \"exile\"\n124\t        # Self-unregister after firing once.\n125\t        game.replacement_manager.unregister(spell)\n126\t        return event\n127\t\n128\t    game.replacement_manager.register(\n129\t        ReplacementEffect(\n130\t            event_type=MoveToGraveyardReplacementEvent,\n131\t            source=spell,\n132\t            condition=_condition,\n133\t            replacement=_replacement,\n134\t            controller=controller,\n135\t        )\n136\t    )\n137\t"}]},"parent_tool_use_id":null,"session_id":"2e9c65f7-ddbe-4353-b4d6-7512c729a9ad","uuid":"b01fb35e-8f59-480e-945c-45b8656a9bf8","timestamp":"2026-06-11T10:05:59.740Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/sos/sos_1/card_impl.py","content":"\"\"\"Card implementation for The Dawning Archaic.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import Creature\nfrom engine.events import AttacksTriggeredEvent, MoveToGraveyardReplacementEvent\nfrom engine.replacement_effects import ReplacementEffect\nfrom engine.types import CardType, Keyword, ManaCost, Supertype, Zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\nclass TheDawningArchaic(Creature):\n    \"\"\"The Dawning Archaic — {10} — Legendary Creature — Avatar 7/7.\n\n    This spell costs {1} less to cast for each instant and sorcery card in\n    your graveyard. Reach. Whenever The Dawning Archaic attacks, you may cast\n    target instant or sorcery card from your graveyard without paying its mana\n    cost. If that spell would be put into your graveyard, exile it instead.\n\n    SOS collector number 1.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"The Dawning Archaic\")\n        kwargs.setdefault(\"mana_cost\", ManaCost(generic=10))\n        kwargs.setdefault(\"subtypes\", {\"Avatar\"})\n        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n        kwargs.setdefault(\"keywords\", Keyword.REACH)\n        kwargs.setdefault(\"base_power\", 7)\n        kwargs.setdefault(\"base_toughness\", 7)\n        kwargs.setdefault(\n            \"rules_text\",\n            \"This spell costs {1} less to cast for each instant and sorcery card in \"\n            \"your graveyard.\\nReach\\nWhenever The Dawning Archaic attacks, you may \"\n            \"cast target instant or sorcery card from your graveyard without paying \"\n            \"its mana cost. If that spell would be put into your graveyard, exile it instead.\",\n        )\n        super().__init__(**kwargs)\n\n    def cost_reduction(self, game: \"GameState\") -> int:\n        \"\"\"1 less per instant/sorcery in your graveyard (generic only).\"\"\"\n        controller = self.controller\n        if controller is None:\n            return 0\n        gy = controller.zones[Zone.GRAVEYARD]\n        count = 0\n        for card in gy.get_all():\n            types = getattr(card, \"card_types\", set())\n            if CardType.INSTANT in types or CardType.SORCERY in types:\n                count += 1\n        return count\n\n    def register_triggers(self, game: \"GameState\") -> None:\n        \"\"\"Register attack trigger — may cast instant/sorcery from graveyard free.\"\"\"\n        from engine.triggers import TriggerRegistration\n\n        source = self\n        controller = getattr(self, \"controller\", None) or game.active_player\n\n        def _attack_condition(game: Any, event: Any) -> bool:\n            return event.creature is source\n\n        def _attack_effect(game: \"GameState\") -> None:\n            ctrl = getattr(source, \"controller\", None)\n            if ctrl is None:\n                return\n\n            # Find instant/sorcery cards in controller's graveyard.\n            gy = ctrl.zones[Zone.GRAVEYARD]\n            legal = [\n                c for c in gy.get_all()\n                if CardType.INSTANT in getattr(c, \"card_types\", set())\n                or CardType.SORCERY in getattr(c, \"card_types\", set())\n            ]\n            if not legal:\n                return\n\n            # Let player choose (or decline by choosing None).\n            try:\n                chosen = ctrl.choose_card(legal, \"Choose an instant/sorcery to cast for free (or None to decline)\")\n            except Exception:\n                return\n\n            if chosen is None or chosen not in legal:\n                return\n\n            # Register one-shot exile-instead replacement for this specific spell.\n            _register_exile_replacement(game, chosen, ctrl)\n\n            # Cast from graveyard for free.\n            from engine.casting import cast_spell_free, CastingError\n            try:\n                cast_spell_free(game, ctrl, chosen, Zone.GRAVEYARD)\n            except CastingError:\n                # If cast fails (e.g. no legal targets), remove the replacement.\n                game.replacement_manager.unregister(chosen)\n\n        game.trigger_manager.register(\n            TriggerRegistration(\n                event_type=AttacksTriggeredEvent,\n                condition=_attack_condition,\n                effect=_attack_effect,\n                source=self,\n                controller=controller,\n            )\n        )\n\n\ndef _register_exile_replacement(\n    game: \"GameState\", spell: Any, controller: Any\n) -> None:\n    \"\"\"Register a one-shot replacement that exiles *spell* instead of graveyard.\"\"\"\n\n    def _condition(game: Any, event: Any) -> bool:\n        # Only applies to this specific spell card moving to graveyard.\n        return getattr(event, \"_source_card\", None) is spell\n\n    def _replacement(game: Any, event: Any) -> Any:\n        event.destination = \"exile\"\n        # Self-unregister after firing once.\n        game.replacement_manager.unregister(spell)\n        return event\n\n    game.replacement_manager.register(\n        ReplacementEffect(\n            event_type=MoveToGraveyardReplacementEvent,\n            source=spell,\n            condition=_condition,\n            replacement=_replacement,\n            controller=controller,\n        )\n    )\n","numLines":137,"startLine":1,"totalLines":137}}}
