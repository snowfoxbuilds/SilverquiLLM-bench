{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_01TC6jzuJXMJnhsNXn2EBZAy","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01TMNi55K5KDrwHvkWGj9cxB","name":"Write","input":{"file_path":"/workspace/cards/sos/sos_257/card_impl.py","content":"\"\"\"Card implementation for Great Hall of the Biblioplex.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import ActivatedAbility, Land, ManaAbility\nfrom engine.events import EndStepTriggeredEvent, SpellCastTriggeredEvent\nfrom engine.types import CardType, Keyword, ManaCost, ManaType, Zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\ndef _tap_and_spend_life(game: Any, source: Any) -> bool:\n    \"\"\"Cost: {T}, pay 1 life — tap and pay 1 life.\"\"\"\n    if getattr(source, \"is_tapped\", False):\n        return False\n    controller = source.controller\n    if controller is None:\n        return False\n    if controller.life <= 1:\n        return False\n    source.is_tapped = True\n    controller.life -= 1\n    return True\n\n\nclass GreatHallOfTheBiblioplex(Land):\n    \"\"\"Great Hall of the Biblioplex — Land.\n\n    {T}: Add {C}.\n    {T}, Pay 1 life: Add one mana of any color. Spend this mana only to\n    cast an instant or sorcery spell.\n    {5}: If this land isn't a creature, it becomes a 2/4 Wizard creature\n    with \"Whenever you cast an instant or sorcery spell, this creature\n    gets +1/+0 until end of turn.\" It's still a land.\n\n    SOS collector number 257.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"Great Hall of the Biblioplex\")\n        kwargs.setdefault(\n            \"rules_text\",\n            \"{T}: Add {C}.\\n{T}, Pay 1 life: Add one mana of any color. \"\n            \"Spend this mana only to cast an instant or sorcery spell.\\n\"\n            \"{5}: If this land isn't a creature, it becomes a 2/4 Wizard \"\n            \"creature with \\\"Whenever you cast an instant or sorcery spell, \"\n            \"this creature gets +1/+0 until end of turn.\\\" It's still a land.\",\n        )\n        super().__init__(**kwargs)\n        # Animation state\n        self._animated: bool = False\n        self._animated_power: int = 0\n\n    # ------------------------------------------------------------------\n    # Mana abilities\n    # ------------------------------------------------------------------\n\n    def get_mana_abilities(self) -> list[ManaAbility]:\n        source = self\n\n        def _tap_cost(game: Any, src: Any) -> bool:\n            if getattr(src, \"is_tapped\", False):\n                return False\n            src.is_tapped = True\n            return True\n\n        def _add_colorless(game: Any) -> None:\n            controller = source.controller\n            if controller is not None:\n                controller.mana_pool.add(ManaType.COLORLESS, 1)\n\n        def _add_restricted(game: Any) -> None:\n            \"\"\"Add one mana of any color, restricted to instant/sorcery.\"\"\"\n            controller = source.controller\n            if controller is None:\n                return\n            # Player chooses color; for simplicity, use choose to pick ManaType\n            colors = [ManaType.WHITE, ManaType.BLUE, ManaType.BLACK, ManaType.RED, ManaType.GREEN]\n            try:\n                chosen = controller.choose(colors, \"Choose a color for the restricted mana\")\n            except Exception:\n                chosen = ManaType.COLORLESS\n            if chosen not in colors:\n                chosen = ManaType.COLORLESS\n            # Add as restricted colorless if colorless was chosen, else as restricted colored\n            # For colored restricted mana, we just add normally (engine limitation noted)\n            if chosen == ManaType.COLORLESS:\n                controller.mana_pool.add_restricted(ManaType.COLORLESS, 1)\n            else:\n                # Add restricted colored mana — engine only tracks colorless restriction\n                # as a deliberate limitation; add normally but track via colorless proxy\n                controller.mana_pool.add(chosen, 1)\n                # Mark restriction by also tracking a restriction token\n                controller.mana_pool._restricted_colorless += 0  # no-op for colored\n                # Deliberate limitation: colored restricted mana not fully enforced.\n                # Use _restricted_colorless_colored tracking as best-effort:\n                if not hasattr(controller.mana_pool, \"_restricted_colored_count\"):\n                    controller.mana_pool._restricted_colored_count = 0\n                controller.mana_pool._restricted_colored_count += 1\n\n        return [\n            ManaAbility(\n                cost=_tap_cost,\n                mana_produced=_add_colorless,\n                description=\"{T}: Add {C}.\",\n            ),\n            ManaAbility(\n                cost=_tap_and_spend_life,\n                mana_produced=_add_restricted,\n                description=\"{T}, Pay 1 life: Add one mana of any color (instant/sorcery only).\",\n            ),\n        ]\n\n    # ------------------------------------------------------------------\n    # Activated ability: {5} — animate\n    # ------------------------------------------------------------------\n\n    def get_activated_abilities(self) -> list[ActivatedAbility]:\n        source = self\n\n        def _animate_cost(game: Any, src: Any) -> bool:\n            \"\"\"Pay {5} generic mana.\"\"\"\n            controller = getattr(src, \"controller\", None)\n            if controller is None:\n                return False\n            if CardType.CREATURE in src.card_types:\n                return False  # Already a creature\n            cost = ManaCost(generic=5)\n            if not controller.mana_pool.can_pay(cost):\n                return False\n            controller.mana_pool.pay(cost)\n            return True\n\n        def _animate_effect(game: Any) -> None:\n            \"\"\"Become a 2/4 Wizard creature (still a land).\"\"\"\n            if CardType.CREATURE in source.card_types:\n                return  # Already animated\n\n            # Add creature type\n            source.card_types.add(CardType.CREATURE)\n            source._animated = True\n\n            # Base P/T\n            source.base_power = 2\n            source.base_toughness = 4\n            source.modified_power = 2\n            source.modified_toughness = 4\n            source._animated_power = 2\n            source.damage_marked = 0\n            source.summoning_sick = False  # Already been on battlefield\n\n            # Add Wizard subtype\n            source.subtypes.add(\"Wizard\")\n\n            # Register pump trigger: whenever controller casts an inst/sorc, +1/+0 until EOT\n            _register_pump_trigger(game, source)\n\n        return [\n            ActivatedAbility(\n                cost=_animate_cost,\n                effect=_animate_effect,\n                description=\"{5}: Become a 2/4 Wizard creature until end of turn (still a land).\",\n            )\n        ]\n\n\ndef _register_pump_trigger(game: \"GameState\", source: Any) -> None:\n    \"\"\"Register the +1/+0 until EOT pump trigger for the animated Great Hall.\"\"\"\n    from engine.triggers import TriggerRegistration\n\n    controller = source.controller\n\n    def _cast_condition(game: Any, event: Any) -> bool:\n        if event.controller is not source.controller:\n            return False\n        card = event.card\n        if card is None:\n            return False\n        types = getattr(card, \"card_types\", set())\n        return CardType.INSTANT in types or CardType.SORCERY in types\n\n    def _cast_effect(game: Any) -> None:\n        \"\"\"Apply +1/+0 until end of turn.\"\"\"\n        source._animated_power = getattr(source, \"_animated_power\", 2) + 1\n        source.modified_power = source._animated_power\n        # Register an end-step cleanup to remove one +1/+0 pump at EOT.\n        _register_eot_cleanup(game, source)\n\n    def _eot_condition(game: Any, event: Any) -> bool:\n        return True\n\n    def _eot_effect(game: Any) -> None:\n        \"\"\"Remove all pump at end of turn — reset to base 2.\"\"\"\n        source._animated_power = 2\n        source.modified_power = 2\n\n    game.trigger_manager.register(\n        TriggerRegistration(\n            event_type=SpellCastTriggeredEvent,\n            condition=_cast_condition,\n            effect=_cast_effect,\n            source=source,\n            controller=controller,\n        )\n    )\n    # One EOT reset trigger to clean up all pump at EOT\n    game.trigger_manager.register(\n        TriggerRegistration(\n            event_type=EndStepTriggeredEvent,\n            condition=_eot_condition,\n            effect=_eot_effect,\n            source=source,\n            controller=controller,\n        )\n    )\n\n\ndef _register_eot_cleanup(game: \"GameState\", source: Any) -> None:\n    \"\"\"No-op: pump cleanup is handled by the single EOT trigger registered at animation.\"\"\"\n    pass\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":293,"cache_read_input_tokens":156508,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":293},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2e9c65f7-ddbe-4353-b4d6-7512c729a9ad","uuid":"13956bc4-8139-4f0f-a5ff-555494e37c58","request_id":"req_011CbwGfXgUNGXpZtv43bCwm"}
