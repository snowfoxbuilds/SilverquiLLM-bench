{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011fcYQzpsjbWrEUFQTicKjQ","type":"tool_result","content":"404\tdef _resolve_spell(\n405\t    game: GameState,\n406\t    card: CardImpl,\n407\t    player: Player,\n408\t    stack_obj: StackObject,\n409\t) -> None:\n410\t    \"\"\"Resolve *card* cast by *player*.\n411\t\n412\t    1. Call ``card.on_resolve(game, targets=targets)``.\n413\t    2. Remove the card from the stack zone.\n414\t    3. If the card is a permanent type, move it to the battlefield via\n415\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n416\t       registration and the ETB event).\n417\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n418\t    \"\"\"\n419\t    from engine.zones import move_to_zone\n420\t\n421\t    # Read targets from the StackObject — the single source of truth.\n422\t    # Set chosen_targets on the card just before resolution so that\n423\t    # _get_chosen_target helpers (which read via getattr) work.\n424\t    targets = stack_obj.targets\n425\t    if targets is not None:\n426\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n427\t\n428\t    card.on_resolve(game)\n429\t\n430\t    if card.card_types & _PERMANENT_TYPES:\n431\t        # Move from stack to battlefield via move_to_zone, which handles\n432\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n433\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n434\t    else:\n435\t        # Instant/sorcery: move from stack to graveyard (or exile if redirected).\n436\t        # Apply registered MoveToGraveyardReplacementEvent replacements so that\n437\t        # effects like \"if this spell would be put into a graveyard, exile it\n438\t        # instead\" are honoured at spell resolution.\n439\t        from engine.events import MoveToGraveyardReplacementEvent\n440\t\n441\t        owner = getattr(card, \"owner\", player)\n442\t        repl_event: MoveToGraveyardReplacementEvent = MoveToGraveyardReplacementEvent(\n443\t            destination=\"graveyard\", controller=player, owner=owner\n444\t        )\n445\t        # Attach the specific card so replacement conditions can identify it.\n446\t        repl_event._source_card = card  # type: ignore[attr-defined]\n447\t        repl_event = game.replacement_manager.apply(game, repl_event)\n448\t        if getattr(repl_event, \"prevented\", False):\n449\t            # Replacement already handled the zone move.\n450\t            pass\n451\t        else:\n452\t            dest_str = getattr(repl_event, \"destination\", \"graveyard\")\n453\t            _DEST: dict[str, Zone] = {\n454\t                \"graveyard\": Zone.GRAVEYARD,\n455\t                \"exile\": Zone.EXILE,\n456\t                \"hand\": Zone.HAND,\n457\t                \"library\": Zone.LIBRARY,\n458\t            }\n459\t            dest = _DEST.get(dest_str, Zone.GRAVEYARD)\n460\t            move_to_zone(game, card, Zone.STACK, dest)\n461\t\n462\t\n463\t# ------------------------------------------------------------------"}]},"parent_tool_use_id":null,"session_id":"2e9c65f7-ddbe-4353-b4d6-7512c729a9ad","uuid":"d49651e9-bf7b-499f-94e3-0a319bd870b8","timestamp":"2026-06-11T10:05:50.115Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"def _resolve_spell(\n    game: GameState,\n    card: CardImpl,\n    player: Player,\n    stack_obj: StackObject,\n) -> None:\n    \"\"\"Resolve *card* cast by *player*.\n\n    1. Call ``card.on_resolve(game, targets=targets)``.\n    2. Remove the card from the stack zone.\n    3. If the card is a permanent type, move it to the battlefield via\n       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n       registration and the ETB event).\n    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Read targets from the StackObject — the single source of truth.\n    # Set chosen_targets on the card just before resolution so that\n    # _get_chosen_target helpers (which read via getattr) work.\n    targets = stack_obj.targets\n    if targets is not None:\n        card.chosen_targets = targets  # type: ignore[attr-defined]\n\n    card.on_resolve(game)\n\n    if card.card_types & _PERMANENT_TYPES:\n        # Move from stack to battlefield via move_to_zone, which handles\n        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n    else:\n        # Instant/sorcery: move from stack to graveyard (or exile if redirected).\n        # Apply registered MoveToGraveyardReplacementEvent replacements so that\n        # effects like \"if this spell would be put into a graveyard, exile it\n        # instead\" are honoured at spell resolution.\n        from engine.events import MoveToGraveyardReplacementEvent\n\n        owner = getattr(card, \"owner\", player)\n        repl_event: MoveToGraveyardReplacementEvent = MoveToGraveyardReplacementEvent(\n            destination=\"graveyard\", controller=player, owner=owner\n        )\n        # Attach the specific card so replacement conditions can identify it.\n        repl_event._source_card = card  # type: ignore[attr-defined]\n        repl_event = game.replacement_manager.apply(game, repl_event)\n        if getattr(repl_event, \"prevented\", False):\n            # Replacement already handled the zone move.\n            pass\n        else:\n            dest_str = getattr(repl_event, \"destination\", \"graveyard\")\n            _DEST: dict[str, Zone] = {\n                \"graveyard\": Zone.GRAVEYARD,\n                \"exile\": Zone.EXILE,\n                \"hand\": Zone.HAND,\n                \"library\": Zone.LIBRARY,\n            }\n            dest = _DEST.get(dest_str, Zone.GRAVEYARD)\n            move_to_zone(game, card, Zone.STACK, dest)\n\n\n# ------------------------------------------------------------------","numLines":60,"startLine":404,"totalLines":538}}}
