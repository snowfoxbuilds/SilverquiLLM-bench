{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_01VZqEWYt2xHgkjwhfakXnVZ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01RnXaggMW4pviVQwBdBhaL6","name":"Write","input":{"file_path":"/workspace/cards/sos/sos_201/card_impl.py","content":"\"\"\"Card implementation for Lorehold, the Historian.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import Creature\nfrom engine.types import CardType, Keyword, ManaCost, Supertype, Zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\nclass LoreholdTheHistorian(Creature):\n    \"\"\"Lorehold, the Historian — {3}{R}{W} — Legendary Creature — Elder Dragon 5/5.\n\n    Flying, haste.\n    Each instant and sorcery card in your hand has miracle {2}.\n    At the beginning of each opponent's upkeep, you may discard a card. If\n    you do, draw a card.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"Lorehold, the Historian\")\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{3}{R}{W}\"))\n        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n        kwargs.setdefault(\"subtypes\", {\"Elder\", \"Dragon\"})\n        kwargs.setdefault(\"keywords\", Keyword.FLYING | Keyword.HASTE)\n        kwargs.setdefault(\"base_power\", 5)\n        kwargs.setdefault(\"base_toughness\", 5)\n        kwargs.setdefault(\n            \"rules_text\",\n            \"Flying, haste\\n\"\n            \"Each instant and sorcery card in your hand has miracle {2}.\\n\"\n            \"At the beginning of each opponent's upkeep, you may discard a card. \"\n            \"If you do, draw a card.\",\n        )\n        super().__init__(**kwargs)\n        # Maps id(player) → turn_number of last miracle offer to prevent double-offering.\n        self._miracle_offered_turn: dict[int, int] = {}\n\n    def register_triggers(self, game: \"GameState\") -> None:\n        from engine.events import BeginningOfUpkeepTriggeredEvent, DrawsCardTriggeredEvent\n        from engine.triggers import TriggerRegistration\n\n        source = self\n        controller = getattr(self, \"controller\", None) or game.active_player\n\n        # --- Miracle trigger: fires when controller draws a card ---\n        def _draw_condition(g: Any, event: Any) -> bool:\n            ctrl = getattr(source, \"controller\", None)\n            return ctrl is not None and event.player is ctrl\n\n        def _draw_effect(g: \"GameState\") -> None:\n            from engine.casting import cast_spell_free\n\n            ctrl = getattr(source, \"controller\", None)\n            if ctrl is None:\n                return\n\n            # Only offer miracle once per turn (first draw this turn).\n            cur_turn = g.turn_number\n            if source._miracle_offered_turn.get(id(ctrl)) == cur_turn:\n                return\n\n            # Check if Lorehold is still on the battlefield.\n            if not g.get_battlefield(ctrl).contains(source):\n                return\n\n            # Find instants/sorceries in hand that can receive the miracle offer.\n            hand = g.get_hand(ctrl)\n            hand_cards = hand.get_all()\n            miracle_candidates = [\n                c for c in hand_cards\n                if (CardType.INSTANT in getattr(c, \"card_types\", set())\n                    or CardType.SORCERY in getattr(c, \"card_types\", set()))\n            ]\n            if not miracle_candidates:\n                return\n\n            # Mark that we've offered miracle this turn.\n            source._miracle_offered_turn[id(ctrl)] = cur_turn\n\n            # Offer each candidate (player may miracle at most one — the drawn card\n            # if it's an instant/sorcery).  Per Miracle rules, only the drawn card\n            # may be miracled; offer it first if present in candidates.\n            # event.card is the just-drawn card.\n            drawn = getattr(g.stack, \"_last_event_card\", None)  # fallback\n            # We track the drawn card via the trigger event which was captured.\n            # Use miracle_candidates limited to the drawn card if it qualifies.\n            miracle_card = None\n            for c in miracle_candidates:\n                if c is getattr(_draw_effect, \"_drawn_card\", None):\n                    miracle_card = c\n                    break\n            # Fallback: if we can't identify the drawn card, offer the last candidate.\n            if miracle_card is None and miracle_candidates:\n                miracle_card = miracle_candidates[-1]\n\n            # The drawn card is provided via the event — we need to reference it.\n            # Since _draw_effect closes over `source` but not `event`, we use a\n            # module-level closure trick via the trigger closure.\n            # Actually the draw event has `event.card` — we access it via a separate\n            # per-fire closure below.\n            pass\n\n        # Re-implement as a closure that captures event.card properly.\n        def _draw_condition2(g: Any, event: Any) -> bool:\n            ctrl = getattr(source, \"controller\", None)\n            return ctrl is not None and event.player is ctrl\n\n        def _make_draw_effect(source_ref: Any) -> Any:\n            def _draw_effect2(g: \"GameState\", event: Any = None) -> None:\n                from engine.casting import cast_spell_free\n\n                ctrl = getattr(source_ref, \"controller\", None)\n                if ctrl is None:\n                    return\n\n                cur_turn = g.turn_number\n                if source_ref._miracle_offered_turn.get(id(ctrl)) == cur_turn:\n                    return\n\n                if not g.get_battlefield(ctrl).contains(source_ref):\n                    return\n\n                source_ref._miracle_offered_turn[id(ctrl)] = cur_turn\n\n            return _draw_effect2\n\n        # Check how trigger effects receive the event — look at existing implementations.\n        # In the engine, the effect is called as `effect(game)` (no event arg).\n        # So we can't directly access event.card inside the effect.\n        # We'll use a shared mutable cell to pass the drawn card.\n        _last_drawn: list[Any] = [None]\n\n        def _draw_cond_final(g: Any, event: Any) -> bool:\n            ctrl = getattr(source, \"controller\", None)\n            if ctrl is None or event.player is not ctrl:\n                return False\n            _last_drawn[0] = event.card\n            return True\n\n        def _draw_eff_final(g: \"GameState\") -> None:\n            from engine.casting import cast_spell_free\n\n            ctrl = getattr(source, \"controller\", None)\n            if ctrl is None:\n                return\n\n            cur_turn = g.turn_number\n            if source._miracle_offered_turn.get(id(ctrl)) == cur_turn:\n                return\n\n            if not g.get_battlefield(ctrl).contains(source):\n                return\n\n            drawn_card = _last_drawn[0]\n            if drawn_card is None:\n                return\n\n            # Check if drawn card is instant or sorcery and still in hand.\n            if (CardType.INSTANT not in getattr(drawn_card, \"card_types\", set())\n                    and CardType.SORCERY not in getattr(drawn_card, \"card_types\", set())):\n                return\n\n            hand = g.get_hand(ctrl)\n            if not hand.contains(drawn_card):\n                return\n\n            source._miracle_offered_turn[id(ctrl)] = cur_turn\n\n            try:\n                want = ctrl.choose_yes_no(\n                    f\"Cast {getattr(drawn_card, 'name', 'card')} for miracle cost {{2}}?\"\n                )\n            except Exception:\n                want = False\n\n            if not want:\n                return\n\n            miracle_cost = ManaCost(generic=2)\n            is_is = True  # instants/sorceries get restricted mana too\n            if not ctrl.mana_pool.can_pay(miracle_cost, for_instant_sorcery=is_is):\n                return\n\n            ctrl.mana_pool.pay(miracle_cost, for_instant_sorcery=is_is)\n            try:\n                cast_spell_free(g, ctrl, drawn_card, Zone.HAND)\n            except Exception:\n                # Refund mana on failure.\n                ctrl.mana_pool.add(ManaCost._to_mana_type_generic(miracle_cost), 2)\n\n        game.trigger_manager.register(\n            TriggerRegistration(\n                event_type=DrawsCardTriggeredEvent,\n                condition=_draw_cond_final,\n                effect=_draw_eff_final,\n                source=self,\n                controller=controller,\n            )\n        )\n\n        # --- Opponent upkeep loot trigger ---\n        def _upkeep_condition(g: Any, event: Any) -> bool:\n            ctrl = getattr(source, \"controller\", None)\n            if ctrl is None:\n                return False\n            if not g.get_battlefield(ctrl).contains(source):\n                return False\n            # Fire on opponents' upkeeps only.\n            return g.active_player is not ctrl\n\n        def _upkeep_effect(g: \"GameState\") -> None:\n            from engine.game import discard, draw_card\n\n            ctrl = getattr(source, \"controller\", None)\n            if ctrl is None:\n                return\n\n            hand = g.get_hand(ctrl)\n            hand_cards = hand.get_all()\n            if not hand_cards:\n                return\n\n            try:\n                want = ctrl.choose_yes_no(\"Discard a card to draw a card?\")\n            except Exception:\n                want = False\n\n            if not want:\n                return\n\n            try:\n                card_to_discard = ctrl.choose_card(hand_cards, \"Choose a card to discard\")\n            except Exception:\n                card_to_discard = hand_cards[0]\n\n            if card_to_discard is None:\n                return\n\n            discard(g, ctrl, card_to_discard)\n            draw_card(g, ctrl)\n\n        game.trigger_manager.register(\n            TriggerRegistration(\n                event_type=BeginningOfUpkeepTriggeredEvent,\n                condition=_upkeep_condition,\n                effect=_upkeep_effect,\n                source=self,\n                controller=controller,\n            )\n        )\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":182,"cache_read_input_tokens":66686,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":182},"output_tokens":54,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8a32b7f0-be82-4ad8-afb4-a624c81177bb","uuid":"9db2c9ca-a0b2-4673-8fd8-2eee2a68ae93","request_id":"req_011CbwLNUbB6faSzPrWBV8UA"}
