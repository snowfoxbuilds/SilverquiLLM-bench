{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018azUMh2McAkw6ycYuxtMmT","type":"tool_result","content":"1\t\"\"\"Mana pool and cost payment logic.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom engine.types import Color, HybridManaSymbol, ManaCost, ManaType\n6\t\n7\t# Map colored ManaTypes to their corresponding Color enum values.\n8\t_MANA_TO_COLOR: dict[ManaType, Color] = {\n9\t    ManaType.WHITE: Color.WHITE,\n10\t    ManaType.BLUE: Color.BLUE,\n11\t    ManaType.BLACK: Color.BLACK,\n12\t    ManaType.RED: Color.RED,\n13\t    ManaType.GREEN: Color.GREEN,\n14\t}\n15\t\n16\t\n17\tclass ManaPool:\n18\t    \"\"\"Tracks available mana for a player.\n19\t\n20\t    Internal storage uses a ``dict[ManaType, int]`` mapping each mana type\n21\t    to its current count.\n22\t    \"\"\"\n23\t\n24\t    def __init__(self) -> None:\n25\t        self._pool: dict[ManaType, int] = {mt: 0 for mt in ManaType}\n26\t        # Restricted mana: only usable to cast instant or sorcery spells.\n27\t        self._restricted: dict[ManaType, int] = {mt: 0 for mt in ManaType}\n28\t        self._last_payment_colors: list[Color] = []\n29\t\n30\t    # ------------------------------------------------------------------\n31\t    # Basic operations\n32\t    # ------------------------------------------------------------------\n33\t\n34\t    def add(self, mana_type: ManaType, amount: int = 1) -> None:\n35\t        \"\"\"Add *amount* mana of the given type to the pool.\n36\t\n37\t        Parameters:\n38\t            mana_type: The type of mana to add.\n39\t            amount: How many mana to add (must be non-negative).\n40\t        \"\"\"\n41\t        if amount < 0:\n42\t            raise ValueError(f\"Cannot add negative mana: {amount}\")\n43\t        self._pool[mana_type] = self._pool.get(mana_type, 0) + amount\n44\t\n45\t    def add_restricted(self, mana_type: ManaType, amount: int = 1) -> None:\n46\t        \"\"\"Add *amount* restricted mana (usable only to cast instant/sorcery spells).\"\"\"\n47\t        if amount < 0:\n48\t            raise ValueError(f\"Cannot add negative mana: {amount}\")\n49\t        self._restricted[mana_type] = self._restricted.get(mana_type, 0) + amount\n50\t\n51\t    def restricted_total(self) -> int:\n52\t        \"\"\"Return total restricted mana across all types.\"\"\"\n53\t        return sum(self._restricted.values())\n54\t\n55\t    def empty(self) -> None:\n56\t        \"\"\"Clear the pool — happens at phase/step transitions.\"\"\"\n57\t        for mt in self._pool:\n58\t            self._pool[mt] = 0\n59\t        for mt in self._restricted:\n60\t            self._restricted[mt] = 0\n61\t\n62\t    def total(self) -> int:\n63\t        \"\"\"Return the total amount of mana in the pool across all types.\"\"\"\n64\t        return sum(self._pool.values())\n65\t\n66\t    def get(self, mana_type: ManaType) -> int:\n67\t        \"\"\"Return the amount of a specific mana type in the pool.\"\"\"\n68\t        return self._pool.get(mana_type, 0)\n69\t\n70\t    @property\n71\t    def last_payment_colors(self) -> list[Color]:\n72\t        \"\"\"Return the distinct colors of mana spent in the last :meth:`pay` call.\n73\t\n74\t        Colorless mana is not a color and is excluded.  The list is sorted\n75\t        by Color enum order for determinism.  Empty if no payment has been\n76\t        made or if all mana spent was colorless.\n77\t        \"\"\"\n78\t        return list(self._last_payment_colors)\n79\t\n80\t    # ------------------------------------------------------------------\n81\t    # Cost payment\n82\t    # ------------------------------------------------------------------\n83\t\n84\t    def can_pay(self, cost: ManaCost, for_instant_sorcery: bool = False) -> bool:\n85\t        \"\"\"Check whether the pool can satisfy *cost*.\n86\t\n87\t        Generic mana can be paid by any type.  X is treated as 0 for\n88\t        ``can_pay`` unless explicitly set in the cost's generic component.\n89\t        Hybrid symbols can be paid with either option; this method uses\n90\t        backtracking to find a valid assignment.\n91\t\n92\t        Parameters:\n93\t            for_instant_sorcery: If True, restricted mana is included in\n94\t                the available pool (it may only be used for instant/sorcery).\n95\t\n96\t        Returns:\n97\t            True if the pool has enough mana to pay the cost.\n98\t        \"\"\"\n99\t        if for_instant_sorcery:\n100\t            remaining: dict[ManaType, int] = {\n101\t                mt: self._pool.get(mt, 0) + self._restricted.get(mt, 0)\n102\t                for mt in ManaType\n103\t            }\n104\t        else:\n105\t            remaining: dict[ManaType, int] = dict(self._pool)\n106\t\n107\t        # Pay colored/colorless pips first.\n108\t        for mana_type, count in cost.pips.items():\n109\t            if remaining.get(mana_type, 0) < count:\n110\t                return False\n111\t            remaining[mana_type] = remaining.get(mana_type, 0) - count\n112\t\n113\t        # Solve hybrid symbols with backtracking.\n114\t        if cost.hybrid:\n115\t            if not self._can_pay_hybrid(remaining, list(cost.hybrid), 0, cost.generic):\n116\t                return False\n117\t            return True\n118\t\n119\t        # Then check generic — sum of all remaining mana must cover it.\n120\t        return sum(remaining.values()) >= cost.generic\n121\t\n122\t    def pay(\n123\t        self,\n124\t        cost: ManaCost,\n125\t        choices: dict[ManaType, int] | None = None,\n126\t        for_instant_sorcery: bool = False,\n127\t    ) -> bool:\n128\t        \"\"\"Deduct mana from the pool to pay *cost*.\n129\t\n130\t        Parameters:\n131\t            cost: The mana cost to pay.\n132\t            choices: How to split the generic portion across mana types.\n133\t                If ``None``, auto-pay greedily: pay colored pips first,\n134\t                then hybrid symbols, then generic using colorless first,\n135\t                then excess colored.\n136\t            for_instant_sorcery: If True, restricted mana is included\n137\t                in the available pool for payment.\n138\t\n139\t        Returns:\n140\t            True if payment succeeded, False if the pool has insufficient mana.\n141\t        \"\"\"\n142\t        if not self.can_pay(cost, for_instant_sorcery=for_instant_sorcery):\n143\t            return False\n144\t\n145\t        # Work on a combined copy so existing payment logic is unchanged.\n146\t        if for_instant_sorcery:\n147\t            pool_snapshot = dict(self._pool)\n148\t            restricted_snapshot = dict(self._restricted)\n149\t            working: dict[ManaType, int] = {\n150\t                mt: self._pool.get(mt, 0) + self._restricted.get(mt, 0)\n151\t                for mt in ManaType\n152\t            }\n153\t        else:\n154\t            working: dict[ManaType, int] = dict(self._pool)\n155\t\n156\t        # 1. Pay colored/colorless pips.\n157\t        for mana_type, count in cost.pips.items():\n158\t            working[mana_type] -= count\n159\t\n160\t        # 2. When explicit generic choices are provided, reserve that mana\n161\t        #    *before* solving hybrids so the solver doesn't steal it.\n162\t        generic_remaining = cost.generic\n163\t        if generic_remaining > 0 and choices is not None:\n164\t            # Reject negative choice amounts — they would create mana.\n165\t            if any(v < 0 for v in choices.values()):\n166\t                return False\n167\t            # Validate choices sum to generic cost.\n168\t            if sum(choices.values()) != generic_remaining:\n169\t                return False\n170\t            for mana_type, amount in choices.items():\n171\t                if working.get(mana_type, 0) < amount:\n172\t                    return False\n173\t                working[mana_type] -= amount\n174\t\n175\t        # 3. Pay hybrid symbols using backtracking to find a valid assignment.\n176\t        #    Generic choices (if any) have already been reserved above,\n177\t        #    so _solve_hybrid sees only the genuinely available mana.\n178\t        if cost.hybrid:\n179\t            generic_for_solver = generic_remaining if choices is None else 0\n180\t            hybrid_assignment = self._solve_hybrid(\n181\t                working, list(cost.hybrid), 0, generic_for_solver,\n182\t            )\n183\t            if hybrid_assignment is None:\n184\t                return False  # pragma: no cover – should not happen after can_pay\n185\t            for mt in hybrid_assignment:\n186\t                working[mt] = working.get(mt, 0) - 1\n187\t\n188\t        # 4. Pay generic cost (auto-pay path — choices already deducted above).\n189\t        if generic_remaining > 0 and choices is None:\n190\t            generic_remaining = self._auto_pay_generic(working, generic_remaining)\n191\t            if generic_remaining > 0:\n192\t                return False  # pragma: no cover – should not happen after can_pay\n193\t\n194\t        # Commit the payment.\n195\t        if for_instant_sorcery:\n196\t            # Distribute the payment: drain from _pool first, then _restricted.\n197\t            colors_spent: set[Color] = set()\n198\t            new_pool: dict[ManaType, int] = dict(pool_snapshot)\n199\t            new_restricted: dict[ManaType, int] = dict(restricted_snapshot)\n200\t            for mt in ManaType:\n201\t                old_combined = pool_snapshot.get(mt, 0) + restricted_snapshot.get(mt, 0)\n202\t                new_combined = working.get(mt, 0)\n203\t                drained = old_combined - new_combined\n204\t                if drained <= 0:\n205\t                    continue\n206\t                pool_has = pool_snapshot.get(mt, 0)\n207\t                from_pool = min(drained, pool_has)\n208\t                from_restricted = drained - from_pool\n209\t                new_pool[mt] = pool_has - from_pool\n210\t                new_restricted[mt] = restricted_snapshot.get(mt, 0) - from_restricted\n211\t                if from_pool > 0 and mt in _MANA_TO_COLOR:\n212\t                    colors_spent.add(_MANA_TO_COLOR[mt])\n213\t                if from_restricted > 0 and mt in _MANA_TO_COLOR:\n214\t                    colors_spent.add(_MANA_TO_COLOR[mt])\n215\t            self._last_payment_colors = sorted(colors_spent, key=lambda c: c.value)\n216\t            self._pool = new_pool\n217\t            self._restricted = new_restricted\n218\t        else:\n219\t            # Compute colors of mana spent by comparing old pool to new working pool.\n220\t            colors_spent: set[Color] = set()\n221\t            for mt, old_amount in self._pool.items():\n222\t                new_amount = working.get(mt, 0)\n223\t                if new_amount < old_amount and mt in _MANA_TO_COLOR:\n224\t                    colors_spent.add(_MANA_TO_COLOR[mt])\n225\t            self._last_payment_colors = sorted(colors_spent, key=lambda c: c.value)\n226\t            self._pool = working\n227\t        return True\n228\t\n229\t    @staticmethod\n230\t    def _can_pay_hybrid(\n231\t        remaining: dict[ManaType, int],\n232\t        hybrids: list[HybridManaSymbol],\n233\t        idx: int,\n234\t        generic: int,\n235\t    ) -> bool:\n236\t        \"\"\"Recursively check if hybrid symbols + generic can be satisfied.\n237\t\n238\t        Uses backtracking: for each hybrid symbol, try option_a then option_b.\n239\t        After all hybrids are assigned, check that remaining mana covers generic.\n240\t        \"\"\"\n241\t        if idx >= len(hybrids):\n242\t            return sum(remaining.values()) >= generic\n243\t\n244\t        sym = hybrids[idx]\n245\t        for option in (sym.option_a, sym.option_b):\n246\t            if remaining.get(option, 0) > 0:\n247\t                remaining[option] -= 1\n248\t                if ManaPool._can_pay_hybrid(remaining, hybrids, idx + 1, generic):\n249\t                    remaining[option] += 1\n250\t                    return True\n251\t                remaining[option] += 1\n252\t        return False\n253\t\n254\t    @staticmethod\n255\t    def _solve_hybrid(\n256\t        remaining: dict[ManaType, int],\n257\t        hybrids: list[HybridManaSymbol],\n258\t        idx: int,\n259\t        generic: int,\n260\t    ) -> list[ManaType] | None:\n261\t        \"\"\"Find a valid assignment for hybrid symbols.\n262\t\n263\t        Returns a list of ManaType choices (one per hybrid symbol) or None\n264\t        if no valid assignment exists.\n265\t        \"\"\"\n266\t        if idx >= len(hybrids):\n267\t            if sum(remaining.values()) >= generic:\n268\t                return []\n269\t            return None\n270\t\n271\t        sym = hybrids[idx]\n272\t        for option in (sym.option_a, sym.option_b):\n273\t            if remaining.get(option, 0) > 0:\n274\t                remaining[option] -= 1\n275\t                result = ManaPool._solve_hybrid(remaining, hybrids, idx + 1, generic)\n276\t                if result is not None:\n277\t                    remaining[option] += 1\n278\t                    return [option] + result\n279\t                remaining[option] += 1\n280\t        return None\n281\t\n282\t    @staticmethod\n283\t    def _auto_pay_generic(working: dict[ManaType, int], amount: int) -> int:\n284\t        \"\"\"Deduct *amount* generic mana from *working*, preferring colorless.\n285\t\n286\t        Returns the remaining unpaid generic amount (0 on success).\n287\t        \"\"\"\n288\t        # Pay with colorless first.\n289\t        if working.get(ManaType.COLORLESS, 0) > 0:\n290\t            take = min(working[ManaType.COLORLESS], amount)\n291\t            working[ManaType.COLORLESS] -= take\n292\t            amount -= take\n293\t\n294\t        # Then pay with each colored type in enum order.\n295\t        for mt in ManaType:\n296\t            if mt is ManaType.COLORLESS:\n297\t                continue\n298\t            if amount <= 0:\n299\t                break\n300\t            if working.get(mt, 0) > 0:\n301\t                take = min(working[mt], amount)\n302\t                working[mt] -= take\n303\t                amount -= take\n304\t\n305\t        return amount\n306\t\n307\t    # ------------------------------------------------------------------\n308\t    # Dunder helpers\n309\t    # ------------------------------------------------------------------\n310\t\n311\t    def __repr__(self) -> str:\n312\t        non_zero = {mt.name: v for mt, v in self._pool.items() if v > 0}\n313\t        return f\"ManaPool({non_zero})\"\n314\t"}]},"parent_tool_use_id":null,"session_id":"8a32b7f0-be82-4ad8-afb4-a624c81177bb","uuid":"db3a3c14-d0f7-4b8e-8df7-6c8f9f77a08c","timestamp":"2026-06-11T10:39:48.371Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/mana.py","content":"\"\"\"Mana pool and cost payment logic.\"\"\"\n\nfrom __future__ import annotations\n\nfrom engine.types import Color, HybridManaSymbol, ManaCost, ManaType\n\n# Map colored ManaTypes to their corresponding Color enum values.\n_MANA_TO_COLOR: dict[ManaType, Color] = {\n    ManaType.WHITE: Color.WHITE,\n    ManaType.BLUE: Color.BLUE,\n    ManaType.BLACK: Color.BLACK,\n    ManaType.RED: Color.RED,\n    ManaType.GREEN: Color.GREEN,\n}\n\n\nclass ManaPool:\n    \"\"\"Tracks available mana for a player.\n\n    Internal storage uses a ``dict[ManaType, int]`` mapping each mana type\n    to its current count.\n    \"\"\"\n\n    def __init__(self) -> None:\n        self._pool: dict[ManaType, int] = {mt: 0 for mt in ManaType}\n        # Restricted mana: only usable to cast instant or sorcery spells.\n        self._restricted: dict[ManaType, int] = {mt: 0 for mt in ManaType}\n        self._last_payment_colors: list[Color] = []\n\n    # ------------------------------------------------------------------\n    # Basic operations\n    # ------------------------------------------------------------------\n\n    def add(self, mana_type: ManaType, amount: int = 1) -> None:\n        \"\"\"Add *amount* mana of the given type to the pool.\n\n        Parameters:\n            mana_type: The type of mana to add.\n            amount: How many mana to add (must be non-negative).\n        \"\"\"\n        if amount < 0:\n            raise ValueError(f\"Cannot add negative mana: {amount}\")\n        self._pool[mana_type] = self._pool.get(mana_type, 0) + amount\n\n    def add_restricted(self, mana_type: ManaType, amount: int = 1) -> None:\n        \"\"\"Add *amount* restricted mana (usable only to cast instant/sorcery spells).\"\"\"\n        if amount < 0:\n            raise ValueError(f\"Cannot add negative mana: {amount}\")\n        self._restricted[mana_type] = self._restricted.get(mana_type, 0) + amount\n\n    def restricted_total(self) -> int:\n        \"\"\"Return total restricted mana across all types.\"\"\"\n        return sum(self._restricted.values())\n\n    def empty(self) -> None:\n        \"\"\"Clear the pool — happens at phase/step transitions.\"\"\"\n        for mt in self._pool:\n            self._pool[mt] = 0\n        for mt in self._restricted:\n            self._restricted[mt] = 0\n\n    def total(self) -> int:\n        \"\"\"Return the total amount of mana in the pool across all types.\"\"\"\n        return sum(self._pool.values())\n\n    def get(self, mana_type: ManaType) -> int:\n        \"\"\"Return the amount of a specific mana type in the pool.\"\"\"\n        return self._pool.get(mana_type, 0)\n\n    @property\n    def last_payment_colors(self) -> list[Color]:\n        \"\"\"Return the distinct colors of mana spent in the last :meth:`pay` call.\n\n        Colorless mana is not a color and is excluded.  The list is sorted\n        by Color enum order for determinism.  Empty if no payment has been\n        made or if all mana spent was colorless.\n        \"\"\"\n        return list(self._last_payment_colors)\n\n    # ------------------------------------------------------------------\n    # Cost payment\n    # ------------------------------------------------------------------\n\n    def can_pay(self, cost: ManaCost, for_instant_sorcery: bool = False) -> bool:\n        \"\"\"Check whether the pool can satisfy *cost*.\n\n        Generic mana can be paid by any type.  X is treated as 0 for\n        ``can_pay`` unless explicitly set in the cost's generic component.\n        Hybrid symbols can be paid with either option; this method uses\n        backtracking to find a valid assignment.\n\n        Parameters:\n            for_instant_sorcery: If True, restricted mana is included in\n                the available pool (it may only be used for instant/sorcery).\n\n        Returns:\n            True if the pool has enough mana to pay the cost.\n        \"\"\"\n        if for_instant_sorcery:\n            remaining: dict[ManaType, int] = {\n                mt: self._pool.get(mt, 0) + self._restricted.get(mt, 0)\n                for mt in ManaType\n            }\n        else:\n            remaining: dict[ManaType, int] = dict(self._pool)\n\n        # Pay colored/colorless pips first.\n        for mana_type, count in cost.pips.items():\n            if remaining.get(mana_type, 0) < count:\n                return False\n            remaining[mana_type] = remaining.get(mana_type, 0) - count\n\n        # Solve hybrid symbols with backtracking.\n        if cost.hybrid:\n            if not self._can_pay_hybrid(remaining, list(cost.hybrid), 0, cost.generic):\n                return False\n            return True\n\n        # Then check generic — sum of all remaining mana must cover it.\n        return sum(remaining.values()) >= cost.generic\n\n    def pay(\n        self,\n        cost: ManaCost,\n        choices: dict[ManaType, int] | None = None,\n        for_instant_sorcery: bool = False,\n    ) -> bool:\n        \"\"\"Deduct mana from the pool to pay *cost*.\n\n        Parameters:\n            cost: The mana cost to pay.\n            choices: How to split the generic portion across mana types.\n                If ``None``, auto-pay greedily: pay colored pips first,\n                then hybrid symbols, then generic using colorless first,\n                then excess colored.\n            for_instant_sorcery: If True, restricted mana is included\n                in the available pool for payment.\n\n        Returns:\n            True if payment succeeded, False if the pool has insufficient mana.\n        \"\"\"\n        if not self.can_pay(cost, for_instant_sorcery=for_instant_sorcery):\n            return False\n\n        # Work on a combined copy so existing payment logic is unchanged.\n        if for_instant_sorcery:\n            pool_snapshot = dict(self._pool)\n            restricted_snapshot = dict(self._restricted)\n            working: dict[ManaType, int] = {\n                mt: self._pool.get(mt, 0) + self._restricted.get(mt, 0)\n                for mt in ManaType\n            }\n        else:\n            working: dict[ManaType, int] = dict(self._pool)\n\n        # 1. Pay colored/colorless pips.\n        for mana_type, count in cost.pips.items():\n            working[mana_type] -= count\n\n        # 2. When explicit generic choices are provided, reserve that mana\n        #    *before* solving hybrids so the solver doesn't steal it.\n        generic_remaining = cost.generic\n        if generic_remaining > 0 and choices is not None:\n            # Reject negative choice amounts — they would create mana.\n            if any(v < 0 for v in choices.values()):\n                return False\n            # Validate choices sum to generic cost.\n            if sum(choices.values()) != generic_remaining:\n                return False\n            for mana_type, amount in choices.items():\n                if working.get(mana_type, 0) < amount:\n                    return False\n                working[mana_type] -= amount\n\n        # 3. Pay hybrid symbols using backtracking to find a valid assignment.\n        #    Generic choices (if any) have already been reserved above,\n        #    so _solve_hybrid sees only the genuinely available mana.\n        if cost.hybrid:\n            generic_for_solver = generic_remaining if choices is None else 0\n            hybrid_assignment = self._solve_hybrid(\n                working, list(cost.hybrid), 0, generic_for_solver,\n            )\n            if hybrid_assignment is None:\n                return False  # pragma: no cover – should not happen after can_pay\n            for mt in hybrid_assignment:\n                working[mt] = working.get(mt, 0) - 1\n\n        # 4. Pay generic cost (auto-pay path — choices already deducted above).\n        if generic_remaining > 0 and choices is None:\n            generic_remaining = self._auto_pay_generic(working, generic_remaining)\n            if generic_remaining > 0:\n                return False  # pragma: no cover – should not happen after can_pay\n\n        # Commit the payment.\n        if for_instant_sorcery:\n            # Distribute the payment: drain from _pool first, then _restricted.\n            colors_spent: set[Color] = set()\n            new_pool: dict[ManaType, int] = dict(pool_snapshot)\n            new_restricted: dict[ManaType, int] = dict(restricted_snapshot)\n            for mt in ManaType:\n                old_combined = pool_snapshot.get(mt, 0) + restricted_snapshot.get(mt, 0)\n                new_combined = working.get(mt, 0)\n                drained = old_combined - new_combined\n                if drained <= 0:\n                    continue\n                pool_has = pool_snapshot.get(mt, 0)\n                from_pool = min(drained, pool_has)\n                from_restricted = drained - from_pool\n                new_pool[mt] = pool_has - from_pool\n                new_restricted[mt] = restricted_snapshot.get(mt, 0) - from_restricted\n                if from_pool > 0 and mt in _MANA_TO_COLOR:\n                    colors_spent.add(_MANA_TO_COLOR[mt])\n                if from_restricted > 0 and mt in _MANA_TO_COLOR:\n                    colors_spent.add(_MANA_TO_COLOR[mt])\n            self._last_payment_colors = sorted(colors_spent, key=lambda c: c.value)\n            self._pool = new_pool\n            self._restricted = new_restricted\n        else:\n            # Compute colors of mana spent by comparing old pool to new working pool.\n            colors_spent: set[Color] = set()\n            for mt, old_amount in self._pool.items():\n                new_amount = working.get(mt, 0)\n                if new_amount < old_amount and mt in _MANA_TO_COLOR:\n                    colors_spent.add(_MANA_TO_COLOR[mt])\n            self._last_payment_colors = sorted(colors_spent, key=lambda c: c.value)\n            self._pool = working\n        return True\n\n    @staticmethod\n    def _can_pay_hybrid(\n        remaining: dict[ManaType, int],\n        hybrids: list[HybridManaSymbol],\n        idx: int,\n        generic: int,\n    ) -> bool:\n        \"\"\"Recursively check if hybrid symbols + generic can be satisfied.\n\n        Uses backtracking: for each hybrid symbol, try option_a then option_b.\n        After all hybrids are assigned, check that remaining mana covers generic.\n        \"\"\"\n        if idx >= len(hybrids):\n            return sum(remaining.values()) >= generic\n\n        sym = hybrids[idx]\n        for option in (sym.option_a, sym.option_b):\n            if remaining.get(option, 0) > 0:\n                remaining[option] -= 1\n                if ManaPool._can_pay_hybrid(remaining, hybrids, idx + 1, generic):\n                    remaining[option] += 1\n                    return True\n                remaining[option] += 1\n        return False\n\n    @staticmethod\n    def _solve_hybrid(\n        remaining: dict[ManaType, int],\n        hybrids: list[HybridManaSymbol],\n        idx: int,\n        generic: int,\n    ) -> list[ManaType] | None:\n        \"\"\"Find a valid assignment for hybrid symbols.\n\n        Returns a list of ManaType choices (one per hybrid symbol) or None\n        if no valid assignment exists.\n        \"\"\"\n        if idx >= len(hybrids):\n            if sum(remaining.values()) >= generic:\n                return []\n            return None\n\n        sym = hybrids[idx]\n        for option in (sym.option_a, sym.option_b):\n            if remaining.get(option, 0) > 0:\n                remaining[option] -= 1\n                result = ManaPool._solve_hybrid(remaining, hybrids, idx + 1, generic)\n                if result is not None:\n                    remaining[option] += 1\n                    return [option] + result\n                remaining[option] += 1\n        return None\n\n    @staticmethod\n    def _auto_pay_generic(working: dict[ManaType, int], amount: int) -> int:\n        \"\"\"Deduct *amount* generic mana from *working*, preferring colorless.\n\n        Returns the remaining unpaid generic amount (0 on success).\n        \"\"\"\n        # Pay with colorless first.\n        if working.get(ManaType.COLORLESS, 0) > 0:\n            take = min(working[ManaType.COLORLESS], amount)\n            working[ManaType.COLORLESS] -= take\n            amount -= take\n\n        # Then pay with each colored type in enum order.\n        for mt in ManaType:\n            if mt is ManaType.COLORLESS:\n                continue\n            if amount <= 0:\n                break\n            if working.get(mt, 0) > 0:\n                take = min(working[mt], amount)\n                working[mt] -= take\n                amount -= take\n\n        return amount\n\n    # ------------------------------------------------------------------\n    # Dunder helpers\n    # ------------------------------------------------------------------\n\n    def __repr__(self) -> str:\n        non_zero = {mt.name: v for mt, v in self._pool.items() if v > 0}\n        return f\"ManaPool({non_zero})\"\n","numLines":314,"startLine":1,"totalLines":314}}}
