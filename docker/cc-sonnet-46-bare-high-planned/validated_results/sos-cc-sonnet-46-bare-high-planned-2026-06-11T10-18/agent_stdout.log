} equal to countered spell's mana value at next main phase.\"\"\"","-    game, p1, p2, sculpt, target = _setup_counter_scenario(with_wizard=True)","+    from engine.casting import cast_spell as _cast","+    from engine.player import DeterministicPlayer"," ","+    game = create_game()","+    p1 = game.players[0]","+    p2 = game.players[1]","+","+    sculpt = ManaSculpt()","+    target = SimpleInstant()  # mana cost {2}{U} = MV 3","     wizard = WizardCreature()","-    set_board_state(game, 0, hand=[sculpt], battlefield=[wizard])"," ","+    set_board_state(game, 1, hand=[target])","+    advance_to_phase(game, Phase.PRECOMBAT_MAIN)","+    game.active_player_index = 1","+    p2.mana_pool.add(ManaType.BLUE, 1)","+    p2.mana_pool.add(ManaType.COLORLESS, 2)","+    _cast(game, p2, target)","+","+    set_board_state(game, 0, hand=[sculpt], battlefield=[wizard])","     p1.mana_pool.add(ManaType.BLUE, 2)","     p1.mana_pool.add(ManaType.COLORLESS, 1)"," ","-    from engine.casting import cast_spell as _cast","-    from engine.player import DeterministicPlayer","     if isinstance(p1, DeterministicPlayer):","         p1._script.appendleft(game.stack.peek())"," ","     _cast(game, p1, sculpt)","     _resolve_top_of_stack(game)"," ","-    # Target instant was {2}{U} = 3 mana value","-    # Advance to next turn's precombat main phase for p1","-    game.empty_mana_pools()","-    game.active_player_index = 0","-    advance_to_phase(game, Phase.PRECOMBAT_MAIN)","-","-    # The delayed trigger should have fired and added 3 colorless","+    # Advance to the NEXT turn's precombat main phase for p1","+    _advance_to_next_precombat_main(game, p1)","     _resolve_top_of_stack(game)","+","+    # {2}{U} = 3 mana → 3 colorless added","     assert p1.mana_pool.get(ManaType.COLORLESS) == 3"]}],"originalFile":"\"\"\"Tests for Mana Sculpt (sos_57).\"\"\"\n\nfrom __future__ import annotations\n\nfrom cards.sos.sos_57.card_impl import ManaSculpt\nfrom engine.card import Creature, Instant\nfrom engine.stack import StackObject\nfrom engine.types import ManaCost, ManaType, Phase, Zone\nfrom test_utils import advance_to_phase, create_game, set_board_state, _resolve_top_of_stack\n\n\nclass SimpleInstant(Instant):\n    def __init__(self, **kwargs):\n        kwargs.setdefault(\"name\", \"TargetInstant\")\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{2}{U}\"))\n        super().__init__(**kwargs)\n\n    def on_resolve(self, game):\n        pass\n\n\nclass WizardCreature(Creature):\n    def __init__(self, **kwargs):\n        kwargs.setdefault(\"name\", \"Wizard\")\n        kwargs.setdefault(\"subtypes\", {\"Wizard\"})\n        kwargs.setdefault(\"base_power\", 1)\n        kwargs.setdefault(\"base_toughness\", 2)\n        super().__init__(**kwargs)\n\n\ndef _setup_counter_scenario(with_wizard=False):\n    \"\"\"Return (game, p1, sculpt, target_instant) ready to counter.\"\"\"\n    from engine.casting import cast_spell as _cast\n\n    game = create_game()\n    p1 = game.players[0]\n    p2 = game.players[1]\n\n    sculpt = ManaSculpt()\n    target = SimpleInstant()\n\n    # Put target in p2's hand, sculpt in p1's hand\n    set_board_state(game, 1, hand=[target])\n    set_board_state(game, 0, hand=[sculpt])\n\n    if with_wizard:\n        wizard = WizardCreature()\n        set_board_state(game, 0, battlefield=[wizard])\n\n    advance_to_phase(game, Phase.PRECOMBAT_MAIN)\n    game.active_player_index = 1  # p2's turn\n\n    # p2 casts target instant onto the stack\n    p2.mana_pool.add(ManaType.BLUE, 1)\n    p2.mana_pool.add(ManaType.COLORLESS, 2)\n    _cast(game, p2, target)\n\n    return game, p1, p2, sculpt, target\n\n\ndef test_counters_target_spell():\n    \"\"\"Mana Sculpt counters the target spell.\"\"\"\n    game, p1, p2, sculpt, target = _setup_counter_scenario()\n\n    # Sculpt is in hand, cast it targeting the instant on stack\n    p1.mana_pool.add(ManaType.BLUE, 2)\n    p1.mana_pool.add(ManaType.COLORLESS, 1)\n\n    # Put sculpt in p1 hand for casting\n    set_board_state(game, 0, hand=[sculpt])\n    advance_to_phase(game, Phase.PRECOMBAT_MAIN)\n\n    from engine.casting import cast_spell as _cast\n    from engine.player import DeterministicPlayer\n\n    # Sculpt the stack: target is already on the stack\n    if isinstance(p1, DeterministicPlayer):\n        p1._script.appendleft(game.stack.peek())  # target = top of stack\n\n    _cast(game, p1, sculpt)\n    _resolve_top_of_stack(game)\n\n    # Target should be in graveyard, not on stack\n    assert target in game.get_graveyard(p2).get_all()\n    assert all(so.source is not target for so in game.stack.objects())\n\n\ndef test_no_mana_if_no_wizard():\n    \"\"\"No delayed mana when controller doesn't control a Wizard.\"\"\"\n    game, p1, p2, sculpt, target = _setup_counter_scenario(with_wizard=False)\n\n    set_board_state(game, 0, hand=[sculpt])\n    advance_to_phase(game, Phase.PRECOMBAT_MAIN)\n    p1.mana_pool.add(ManaType.BLUE, 2)\n    p1.mana_pool.add(ManaType.COLORLESS, 1)\n\n    from engine.casting import cast_spell as _cast\n    from engine.player import DeterministicPlayer\n    if isinstance(p1, DeterministicPlayer):\n        p1._script.appendleft(game.stack.peek())\n\n    _cast(game, p1, sculpt)\n    _resolve_top_of_stack(game)\n\n    # Advance to p1's next main phase\n    advance_to_phase(game, Phase.POSTCOMBAT_MAIN)\n    # Mana pool should be empty (no trigger fired)\n    assert p1.mana_pool.get(ManaType.COLORLESS) == 0\n\n\ndef test_mana_added_on_next_main_phase_with_wizard():\n    \"\"\"With a Wizard, add {C} equal to countered spell's mana value at next main phase.\"\"\"\n    game, p1, p2, sculpt, target = _setup_counter_scenario(with_wizard=True)\n\n    wizard = WizardCreature()\n    set_board_state(game, 0, hand=[sculpt], battlefield=[wizard])\n\n    p1.mana_pool.add(ManaType.BLUE, 2)\n    p1.mana_pool.add(ManaType.COLORLESS, 1)\n\n    from engine.casting import cast_spell as _cast\n    from engine.player import DeterministicPlayer\n    if isinstance(p1, DeterministicPlayer):\n        p1._script.appendleft(game.stack.peek())\n\n    _cast(game, p1, sculpt)\n    _resolve_top_of_stack(game)\n\n    # Target instant was {2}{U} = 3 mana value\n    # Advance to next turn's precombat main phase for p1\n    game.empty_mana_pools()\n    game.active_player_index = 0\n    advance_to_phase(game, Phase.PRECOMBAT_MAIN)\n\n    # The delayed trigger should have fired and added 3 colorless\n    _resolve_top_of_stack(game)\n    assert p1.mana_pool.get(ManaType.COLORLESS) == 3\n","userModified":false}}
