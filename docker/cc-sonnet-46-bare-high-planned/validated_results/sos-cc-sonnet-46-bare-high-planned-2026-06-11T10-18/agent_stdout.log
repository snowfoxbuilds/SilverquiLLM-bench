null,\n  \"loyalty\": null,\n  \"colors\": [\n    \"R\"\n  ],\n  \"keywords\": [\n    \"Paradigm\"\n  ],\n  \"rarity\": \"mythic\",\n  \"set_code\": \"sos\",\n  \"collector_number\": \"120\",\n  \"complexity_tier\": \"complex\"\n}\n\n=== SOS 201 ===\n{\n  \"name\": \"Lorehold, the Historian\",\n  \"mana_cost\": \"{3}{R}{W}\",\n  \"type_line\": \"Legendary Creature — Elder Dragon\",\n  \"oracle_text\": \"Flying, haste\\nEach instant and sorcery card in your hand has miracle {2}. (You may cast a card for its miracle cost when you draw it if it's the first card you drew this turn.)\\nAt the beginning of each opponent's upkeep, you may discard a card. If you do, draw a card.\",\n  \"power\": \"5\",\n  \"toughness\": \"5\",\n  \"loyalty\": null,\n  \"colors\": [\n    \"R\",\n    \"W\"\n  ],\n  \"keywords\": [\n    \"Flying\",\n    \"Haste\"\n  ],\n  \"rarity\": \"mythic\",\n  \"set_code\": \"sos\",\n  \"collector_number\": \"201\",\n  \"complexity_tier\": \"expert\"\n}\n\n=== SOS 226 ===\n{\n  \"name\": \"Silverquill, the Disputant\",\n  \"mana_cost\": \"{2}{W}{B}\",\n  \"type_line\": \"Legendary Creature — Elder Dragon\",\n  \"oracle_text\": \"Flying, vigilance\\nEach instant and sorcery spell you cast has casualty 1. (As you cast that spell, you may sacrifice a creature with power 1 or greater. When you do, copy the spell and you may choose new targets for the copy.)\",\n  \"power\": \"4\",\n  \"toughness\": \"4\",\n  \"loyalty\": null,\n  \"colors\": [\n    \"B\",\n    \"W\"\n  ],\n  \"keywords\": [\n    \"Flying\",\n    \"Vigilance\"\n  ],\n  \"rarity\": \"mythic\",\n  \"set_code\": \"sos\",\n  \"collector_number\": \"226\",\n  \"complexity_tier\": \"medium\"\n}\n\n=== SOS 245 ===\n{\n  \"name\": \"Witherbloom, the Balancer\",\n  \"mana_cost\": \"{6}{B}{G}\",\n  \"type_line\": \"Legendary Creature — Elder Dragon\",\n  \"oracle_text\": \"Affinity for creatures (This spell costs {1} less to cast for each creature you control.)\\nFlying, deathtouch\\nInstant and sorcery