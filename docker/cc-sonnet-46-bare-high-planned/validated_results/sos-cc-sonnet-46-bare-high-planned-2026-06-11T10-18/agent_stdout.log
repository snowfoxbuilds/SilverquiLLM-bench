{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XbHjdjLWVoyUsErLgop6fN","type":"tool_result","content":"110\t\n111\t    def test_unregister_removes_all_triggers_for_source(self, players: list[DeterministicPlayer]) -> None:\n112\t        \"\"\"unregister(source) should remove every trigger whose source is that object.\"\"\"\n113\t        tm = TriggerManager()\n114\t        bear = Creature(name='Bear', owner=players[0], controller=players[0])\n115\t        elf = Creature(name='Elf', owner=players[0], controller=players[0])\n116\t        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, bear, players[0]))\n117\t        tm.register(_make_trigger(CreatureDiesTriggeredEvent, bear, players[0]))\n118\t        tm.register(_make_trigger(AttacksTriggeredEvent, elf, players[0]))\n119\t        tm.unregister(bear)\n120\t        remaining = tm.get_triggers()\n121\t        assert len(remaining) == 1\n122\t        assert remaining[0].source is elf\n123\t\n124\t    def test_unregister_is_identity_based(self, players: list[DeterministicPlayer]) -> None:\n125\t        \"\"\"Unregister uses `is` (identity), not `==` (equality).\"\"\"\n126\t        tm = TriggerManager()\n127\t        bear1 = Creature(name='Bear', owner=players[0], controller=players[0])\n128\t        bear2 = Creature(name='Bear', owner=players[0], controller=players[0])\n129\t        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, bear1, players[0]))\n130\t        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, bear2, players[0]))\n131\t        tm.unregister(bear1)\n132\t        assert len(tm.get_triggers()) == 1\n133\t        assert tm.get_triggers()[0].source is bear2\n134\t\n135\t    def test_unregister_nonexistent_source_is_noop(self) -> None:\n136\t        \"\"\"Unregistering a source with no triggers should not raise.\"\"\"\n137\t        tm = TriggerManager()\n138\t        tm.unregister(object())\n139\t        assert tm.get_triggers() == []\n140\t\n141\t    def test_unregister_leaves_other_sources_intact(self, players: list[DeterministicPlayer]) -> None:\n142\t        \"\"\"After unregister, triggers from other sources must remain.\"\"\"\n143\t        tm = TriggerManager()\n144\t        bear = Creature(name='Bear', owner=players[0], controller=players[0])\n145\t        elf = Creature(name='Elf', owner=players[1], controller=players[1])\n146\t        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, bear, players[0]))\n147\t        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, elf, players[1]))\n148\t        tm.unregister(bear)\n149\t        assert len(tm.get_triggers()) == 1\n150\t        assert tm.get_triggers()[0].source is elf\n151\t\n152\tclass TestTriggerManagerGetTriggersForSource:\n153\t    \"\"\"get_triggers_for_source filters by source identity.\"\"\"\n154\t\n155\t    def test_returns_only_matching_source(self, players: list[DeterministicPlayer]) -> None:\n156\t        tm = TriggerManager()\n157\t        bear = Creature(name='Bear', owner=players[0], controller=players[0])\n158\t        elf = Creature(name='Elf', owner=players[0], controller=players[0])\n159\t        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, bear, players[0]))\n160\t        tm.register(_make_trigger(CreatureDiesTriggeredEvent, bear, players[0]))\n161\t        tm.register(_make_trigger(AttacksTriggeredEvent, elf, players[0]))\n162\t        bear_triggers = tm.get_triggers_for_source(bear)\n163\t        assert len(bear_triggers) == 2\n164\t        assert all((t.source is bear for t in bear_triggers))\n165\t\n166\t    def test_returns_empty_for_unknown_source(self) -> None:\n167\t        tm = TriggerManager()\n168\t        assert tm.get_triggers_for_source(object()) == []\n169\t"}]},"parent_tool_use_id":null,"session_id":"8a32b7f0-be82-4ad8-afb4-a624c81177bb","uuid":"f1cc81da-6125-4c66-84e3-3936822b8096","timestamp":"2026-06-11T10:26:24.749Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine_tests/test_triggers.py","content":"\n    def test_unregister_removes_all_triggers_for_source(self, players: list[DeterministicPlayer]) -> None:\n        \"\"\"unregister(source) should remove every trigger whose source is that object.\"\"\"\n        tm = TriggerManager()\n        bear = Creature(name='Bear', owner=players[0], controller=players[0])\n        elf = Creature(name='Elf', owner=players[0], controller=players[0])\n        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, bear, players[0]))\n        tm.register(_make_trigger(CreatureDiesTriggeredEvent, bear, players[0]))\n        tm.register(_make_trigger(AttacksTriggeredEvent, elf, players[0]))\n        tm.unregister(bear)\n        remaining = tm.get_triggers()\n        assert len(remaining) == 1\n        assert remaining[0].source is elf\n\n    def test_unregister_is_identity_based(self, players: list[DeterministicPlayer]) -> None:\n        \"\"\"Unregister uses `is` (identity), not `==` (equality).\"\"\"\n        tm = TriggerManager()\n        bear1 = Creature(name='Bear', owner=players[0], controller=players[0])\n        bear2 = Creature(name='Bear', owner=players[0], controller=players[0])\n        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, bear1, players[0]))\n        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, bear2, players[0]))\n        tm.unregister(bear1)\n        assert len(tm.get_triggers()) == 1\n        assert tm.get_triggers()[0].source is bear2\n\n    def test_unregister_nonexistent_source_is_noop(self) -> None:\n        \"\"\"Unregistering a source with no triggers should not raise.\"\"\"\n        tm = TriggerManager()\n        tm.unregister(object())\n        assert tm.get_triggers() == []\n\n    def test_unregister_leaves_other_sources_intact(self, players: list[DeterministicPlayer]) -> None:\n        \"\"\"After unregister, triggers from other sources must remain.\"\"\"\n        tm = TriggerManager()\n        bear = Creature(name='Bear', owner=players[0], controller=players[0])\n        elf = Creature(name='Elf', owner=players[1], controller=players[1])\n        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, bear, players[0]))\n        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, elf, players[1]))\n        tm.unregister(bear)\n        assert len(tm.get_triggers()) == 1\n        assert tm.get_triggers()[0].source is elf\n\nclass TestTriggerManagerGetTriggersForSource:\n    \"\"\"get_triggers_for_source filters by source identity.\"\"\"\n\n    def test_returns_only_matching_source(self, players: list[DeterministicPlayer]) -> None:\n        tm = TriggerManager()\n        bear = Creature(name='Bear', owner=players[0], controller=players[0])\n        elf = Creature(name='Elf', owner=players[0], controller=players[0])\n        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, bear, players[0]))\n        tm.register(_make_trigger(CreatureDiesTriggeredEvent, bear, players[0]))\n        tm.register(_make_trigger(AttacksTriggeredEvent, elf, players[0]))\n        bear_triggers = tm.get_triggers_for_source(bear)\n        assert len(bear_triggers) == 2\n        assert all((t.source is bear for t in bear_triggers))\n\n    def test_returns_empty_for_unknown_source(self) -> None:\n        tm = TriggerManager()\n        assert tm.get_triggers_for_source(object()) == []\n","numLines":60,"startLine":110,"totalLines":580}}}
