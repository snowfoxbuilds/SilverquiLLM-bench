{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UQhjKz6TVsYxpLfecLBtqY","type":"tool_result","content":"276\tdef cast_spell_free(\n277\t    game: GameState,\n278\t    player: Player,\n279\t    card: CardImpl,\n280\t    from_zone: Zone,\n281\t) -> None:\n282\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n283\t\n284\t    This is used by effects that allow casting from zones other than hand\n285\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n286\t    or cascade.\n287\t\n288\t    Pipeline\n289\t    --------\n290\t    1. **can_cast** — ask the card whether it can legally be cast (same\n291\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n292\t    2. Move *card* from *from_zone* to the stack zone.\n293\t    3. Choose targets (if applicable) with validation and protection check.\n294\t    4. Call ``on_cast`` hook.\n295\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n296\t       resolution normally (permanents → battlefield, non-permanents →\n297\t       graveyard).\n298\t\n299\t    No timing check or mana payment is performed.  The spell goes on the\n300\t    stack and can be responded to normally (e.g. countered).\n301\t\n302\t    If targeting or other post-move checks fail, the card is rolled back\n303\t    to its source zone.\n304\t\n305\t    Parameters:\n306\t        game: The current game state.\n307\t        player: The player casting the spell.\n308\t        card: The card to cast.\n309\t        from_zone: The zone the card is currently in.\n310\t\n311\t    Raises:\n312\t        CastingError: If the card cannot be found in *from_zone* or\n313\t            legality checks fail.\n314\t    \"\"\"\n315\t    from engine.zones import move_to_zone\n316\t\n317\t    # Ensure controller is set\n318\t    card.controller = player\n319\t    if card.owner is None:\n320\t        card.owner = player\n321\t\n322\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n323\t    if not card.can_cast(game):\n324\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n325\t\n326\t    # 2. Locate card in source zone\n327\t    source_zone_container = player.zones[from_zone]\n328\t    if not source_zone_container.contains(card):\n329\t        # Try to find the card in any player's zone\n330\t        source_zone_container = None\n331\t        for p in game.players:\n332\t            z = p.zones[from_zone]\n333\t            if z.contains(card):\n334\t                source_zone_container = z\n335\t                break"}]},"parent_tool_use_id":null,"session_id":"8a32b7f0-be82-4ad8-afb4-a624c81177bb","uuid":"ba6cf2c2-5681-4b7f-8269-05a8d636e440","timestamp":"2026-06-11T10:42:27.683Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"def cast_spell_free(\n    game: GameState,\n    player: Player,\n    card: CardImpl,\n    from_zone: Zone,\n) -> None:\n    \"\"\"Cast *card* without paying its mana cost, using the stack.\n\n    This is used by effects that allow casting from zones other than hand\n    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n    or cascade.\n\n    Pipeline\n    --------\n    1. **can_cast** — ask the card whether it can legally be cast (same\n       legality as :func:`cast_spell`, minus mana/timing constraints).\n    2. Move *card* from *from_zone* to the stack zone.\n    3. Choose targets (if applicable) with validation and protection check.\n    4. Call ``on_cast`` hook.\n    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n       resolution normally (permanents → battlefield, non-permanents →\n       graveyard).\n\n    No timing check or mana payment is performed.  The spell goes on the\n    stack and can be responded to normally (e.g. countered).\n\n    If targeting or other post-move checks fail, the card is rolled back\n    to its source zone.\n\n    Parameters:\n        game: The current game state.\n        player: The player casting the spell.\n        card: The card to cast.\n        from_zone: The zone the card is currently in.\n\n    Raises:\n        CastingError: If the card cannot be found in *from_zone* or\n            legality checks fail.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Ensure controller is set\n    card.controller = player\n    if card.owner is None:\n        card.owner = player\n\n    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 2. Locate card in source zone\n    source_zone_container = player.zones[from_zone]\n    if not source_zone_container.contains(card):\n        # Try to find the card in any player's zone\n        source_zone_container = None\n        for p in game.players:\n            z = p.zones[from_zone]\n            if z.contains(card):\n                source_zone_container = z\n                break","numLines":60,"startLine":276,"totalLines":517}}}
