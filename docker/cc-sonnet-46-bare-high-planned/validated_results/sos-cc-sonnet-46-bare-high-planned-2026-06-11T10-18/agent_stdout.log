{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_01RTgiL1VQoarXCRtQnW5ET7","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01ErSAeeNBHudFqpj9MUJGcy","name":"Write","input":{"file_path":"/workspace/cards/sos/sos_1/tests.py","content":"\"\"\"Tests for The Dawning Archaic (sos_1).\"\"\"\n\nfrom __future__ import annotations\n\nimport pytest\n\nfrom cards.sos.sos_1.card_impl import TheDawningArchaic\nfrom engine.card import Creature, Instant, Sorcery\nfrom engine.types import ManaCost, ManaType, Phase, Zone\nfrom test_utils import advance_to_phase, create_game, declare_attackers, set_board_state\n\n\nclass SimpleInstant(Instant):\n    def __init__(self, **kwargs):\n        kwargs.setdefault(\"name\", \"SimpleInstant\")\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{U}\"))\n        super().__init__(**kwargs)\n\n    def on_resolve(self, game):\n        pass\n\n\nclass SimpleSorcery(Sorcery):\n    def __init__(self, **kwargs):\n        kwargs.setdefault(\"name\", \"SimpleSorcery\")\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{2}\"))\n        super().__init__(**kwargs)\n\n    def on_resolve(self, game):\n        pass\n\n\ndef test_cost_reduction_counts_instants_sorceries():\n    \"\"\"Costs {1} less per instant/sorcery in graveyard.\"\"\"\n    archaic = TheDawningArchaic()\n    game = create_game()\n    p1 = game.players[0]\n    set_board_state(game, 0, graveyard=[SimpleInstant(), SimpleInstant(), SimpleSorcery()])\n    archaic.controller = p1\n    assert archaic.cost_reduction(game) == 3\n\n\ndef test_cost_reduction_zero_empty_graveyard():\n    \"\"\"No reduction when graveyard is empty.\"\"\"\n    archaic = TheDawningArchaic()\n    game = create_game()\n    p1 = game.players[0]\n    archaic.controller = p1\n    assert archaic.cost_reduction(game) == 0\n\n\ndef test_reach_keyword():\n    \"\"\"Archaic has Reach.\"\"\"\n    from engine.types import Keyword\n    archaic = TheDawningArchaic()\n    assert Keyword.REACH in archaic.keywords\n\n\ndef test_attack_trigger_casts_from_graveyard():\n    \"\"\"Attacking fires trigger; card from graveyard is cast free.\"\"\"\n    archaic = TheDawningArchaic()\n    archaic.summoning_sick = False\n\n    game = create_game()\n    p1 = game.players[0]\n    p2 = game.players[1]\n\n    target_instant = SimpleInstant()\n    set_board_state(game, 0, battlefield=[archaic], graveyard=[target_instant])\n\n    # Script p1 to choose target_instant\n    from engine.player import DeterministicPlayer\n    if isinstance(p1, DeterministicPlayer):\n        p1._script.appendleft(target_instant)\n\n    declare_attackers(game, [\"The Dawning Archaic\"])\n\n    # The instant should have been cast; it's either resolved or on the stack\n    # At minimum, it should no longer be in the graveyard\n    gy_cards = game.get_graveyard(p1).get_all()\n    exile_cards = game.get_exile(p1).get_all()\n    # Card was cast from graveyard (moved away from graveyard)\n    assert target_instant not in gy_cards\n\n\ndef test_spell_exiled_instead_of_graveyard():\n    \"\"\"After being cast from graveyard via Archaic, spell goes to exile not graveyard.\"\"\"\n    archaic = TheDawningArchaic()\n    archaic.summoning_sick = False\n\n    game = create_game()\n    p1 = game.players[0]\n\n    target_sorcery = SimpleSorcery()\n    # Sorcery resolves normally; set up main phase timing\n    advance_to_phase(game, Phase.COMBAT, None)\n\n    set_board_state(game, 0, battlefield=[archaic], graveyard=[target_sorcery])\n\n    from engine.player import DeterministicPlayer\n    if isinstance(p1, DeterministicPlayer):\n        p1._script.appendleft(target_sorcery)\n\n    declare_attackers(game, [\"The Dawning Archaic\"])\n\n    # Resolve any triggers/spells on stack\n    from test_utils import _resolve_top_of_stack\n    _resolve_top_of_stack(game)\n\n    # The sorcery should be in exile, not in graveyard\n    assert target_sorcery not in game.get_graveyard(p1).get_all()\n    assert target_sorcery in game.get_exile(p1).get_all()\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":211,"cache_read_input_tokens":108570,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":211},"output_tokens":52,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8a32b7f0-be82-4ad8-afb4-a624c81177bb","uuid":"6e8872f5-d14c-432e-a814-dc12666bb87f","request_id":"req_011CbwJygUnVCfb1QwzPiKuL"}
