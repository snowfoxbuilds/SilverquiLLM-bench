{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RDYHtTuojoT6UMjXJcrZFR","type":"tool_result","content":"1\t\"\"\"Card implementation for Sphinx's Tutelage.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom typing import TYPE_CHECKING, Any\n4\tfrom engine.card import ActivatedAbility, Artifact, Creature, Enchantment, Instant, ManaAbility, Sorcery\n5\tfrom engine.continuous_effects import ContinuousEffect, DURATION_END_OF_TURN, DURATION_PERMANENT, Layer, SubLayer\n6\tfrom engine.types import CardType, Color, HybridManaSymbol, Keyword, ManaCost, ManaType, Supertype, Zone\n7\tfrom engine.events import DrawsCardTriggeredEvent\n8\tif TYPE_CHECKING:\n9\t    from engine.game_state import GameState\n10\t    from cards.registry import CardRegistry\n11\t\n12\tdef _get_colors_of_permanent(obj: Any) -> set[Color]:\n13\t    \"\"\"Return the set of MTG colors for a permanent based on its mana cost.\"\"\"\n14\t    from engine.protection import get_colors\n15\t    return get_colors(obj)\n16\t\n17\tclass SphinxsTutelage(Enchantment):\n18\t    \"\"\"Sphinx's Tutelage — {2}{U} — Enchantment\n19\t\n20\t    Whenever you draw a card, target opponent mills two cards, then if\n21\t    two nonland cards that share a color were milled this way, repeat\n22\t    this process.\n23\t\n24\t    {5}{U}: Draw a card, then discard a card.\n25\t\n26\t    SPG collector number 75.\n27\t    \"\"\"\n28\t\n29\t    def __init__(self, **kwargs: Any) -> None:\n30\t        kwargs.setdefault('name', \"Sphinx's Tutelage\")\n31\t        kwargs.setdefault('mana_cost', ManaCost.parse('{2}{U}'))\n32\t        kwargs.setdefault('rules_text', 'Whenever you draw a card, target opponent mills two cards, then if two nonland cards that share a color were milled this way, repeat this process.\\n{5}{U}: Draw a card, then discard a card.')\n33\t        super().__init__(**kwargs)\n34\t\n35\t    @staticmethod\n36\t    def _mill(game: Any, player: Any, count: int) -> list[Any]:\n37\t        \"\"\"Mill *count* cards from *player*'s library to graveyard.\n38\t\n39\t        Returns the list of milled cards.\n40\t        \"\"\"\n41\t        milled: list[Any] = []\n42\t        library = player.zones[Zone.LIBRARY]\n43\t        graveyard = player.zones[Zone.GRAVEYARD]\n44\t        for _ in range(count):\n45\t            if len(library) == 0:\n46\t                break\n47\t            cards = library.top(1)\n48\t            card = cards[0]\n49\t            library.remove(card)\n50\t            graveyard.add(card)\n51\t            milled.append(card)\n52\t        return milled\n53\t\n54\t    @staticmethod\n55\t    def _shared_color_among_nonlands(cards: list[Any]) -> bool:\n56\t        \"\"\"Return True if two nonland cards in *cards* share a colour.\"\"\"\n57\t        nonlands = [c for c in cards if CardType.LAND not in getattr(c, 'card_types', set())]\n58\t        if len(nonlands) < 2:\n59\t            return False\n60\t        color_sets = [_get_colors_of_permanent(c) for c in nonlands]\n61\t        for i in range(len(color_sets)):\n62\t            for j in range(i + 1, len(color_sets)):\n63\t                if color_sets[i] & color_sets[j]:\n64\t                    return True\n65\t        return False\n66\t\n67\t    def register_triggers(self, game: Any) -> None:\n68\t        from engine.triggers import TriggerRegistration\n69\t        source = self\n70\t\n71\t        def _condition(g: Any, event: dict) -> bool:\n72\t            \"\"\"Fire when the controller draws a card.\"\"\"\n73\t            controller = source.controller or source.owner\n74\t            return event.player is controller\n75\t\n76\t        def _effect(g: Any) -> None:\n77\t            controller = source.controller or source.owner\n78\t            if controller is None:\n79\t                return\n80\t            opponent = None\n81\t            for p in g.players:\n82\t                if p is not controller:\n83\t                    opponent = p\n84\t                    break\n85\t            if opponent is None:\n86\t                return\n87\t            max_iterations = 100\n88\t            for _ in range(max_iterations):\n89\t                milled = SphinxsTutelage._mill(g, opponent, 2)\n90\t                if len(milled) < 2:\n91\t                    break\n92\t                if not SphinxsTutelage._shared_color_among_nonlands(milled):\n93\t                    break\n94\t        reg = TriggerRegistration(event_type=DrawsCardTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=source.controller or source.owner)\n95\t        game.trigger_manager.register(reg)\n96\t\n97\t    def get_activated_abilities(self) -> list[ActivatedAbility]:\n98\t        source = self\n99\t\n100\t        def _cost(game: Any, src: Any) -> bool:\n101\t            controller = getattr(src, 'controller', None)\n102\t            if controller is None:\n103\t                return False\n104\t            cost = ManaCost.parse('{5}{U}')\n105\t            if not controller.mana_pool.can_pay(cost):\n106\t                return False\n107\t            controller.mana_pool.pay(cost)\n108\t            return True\n109\t\n110\t        def _effect(game: Any) -> None:\n111\t            from engine.game import draw_card, discard\n112\t            controller = source.controller or source.owner\n113\t            if controller is None:\n114\t                return\n115\t            card_drawn = draw_card(game, controller)\n116\t            hand = controller.zones[Zone.HAND]\n117\t            cards_in_hand = hand.get_all()\n118\t            if cards_in_hand:\n119\t                to_discard = cards_in_hand[0]\n120\t                discard(game, controller, to_discard)\n121\t        return [ActivatedAbility(cost=_cost, effect=_effect, description='{5}{U}: Draw a card, then discard a card.')]\n122\t"}]},"parent_tool_use_id":null,"session_id":"8a32b7f0-be82-4ad8-afb4-a624c81177bb","uuid":"18b507ef-f7ea-4f76-b7ab-3d568e50a9d1","timestamp":"2026-06-11T10:42:59.659Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/spg_75/card_impl.py","content":"\"\"\"Card implementation for Sphinx's Tutelage.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import ActivatedAbility, Artifact, Creature, Enchantment, Instant, ManaAbility, Sorcery\nfrom engine.continuous_effects import ContinuousEffect, DURATION_END_OF_TURN, DURATION_PERMANENT, Layer, SubLayer\nfrom engine.types import CardType, Color, HybridManaSymbol, Keyword, ManaCost, ManaType, Supertype, Zone\nfrom engine.events import DrawsCardTriggeredEvent\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from cards.registry import CardRegistry\n\ndef _get_colors_of_permanent(obj: Any) -> set[Color]:\n    \"\"\"Return the set of MTG colors for a permanent based on its mana cost.\"\"\"\n    from engine.protection import get_colors\n    return get_colors(obj)\n\nclass SphinxsTutelage(Enchantment):\n    \"\"\"Sphinx's Tutelage — {2}{U} — Enchantment\n\n    Whenever you draw a card, target opponent mills two cards, then if\n    two nonland cards that share a color were milled this way, repeat\n    this process.\n\n    {5}{U}: Draw a card, then discard a card.\n\n    SPG collector number 75.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', \"Sphinx's Tutelage\")\n        kwargs.setdefault('mana_cost', ManaCost.parse('{2}{U}'))\n        kwargs.setdefault('rules_text', 'Whenever you draw a card, target opponent mills two cards, then if two nonland cards that share a color were milled this way, repeat this process.\\n{5}{U}: Draw a card, then discard a card.')\n        super().__init__(**kwargs)\n\n    @staticmethod\n    def _mill(game: Any, player: Any, count: int) -> list[Any]:\n        \"\"\"Mill *count* cards from *player*'s library to graveyard.\n\n        Returns the list of milled cards.\n        \"\"\"\n        milled: list[Any] = []\n        library = player.zones[Zone.LIBRARY]\n        graveyard = player.zones[Zone.GRAVEYARD]\n        for _ in range(count):\n            if len(library) == 0:\n                break\n            cards = library.top(1)\n            card = cards[0]\n            library.remove(card)\n            graveyard.add(card)\n            milled.append(card)\n        return milled\n\n    @staticmethod\n    def _shared_color_among_nonlands(cards: list[Any]) -> bool:\n        \"\"\"Return True if two nonland cards in *cards* share a colour.\"\"\"\n        nonlands = [c for c in cards if CardType.LAND not in getattr(c, 'card_types', set())]\n        if len(nonlands) < 2:\n            return False\n        color_sets = [_get_colors_of_permanent(c) for c in nonlands]\n        for i in range(len(color_sets)):\n            for j in range(i + 1, len(color_sets)):\n                if color_sets[i] & color_sets[j]:\n                    return True\n        return False\n\n    def register_triggers(self, game: Any) -> None:\n        from engine.triggers import TriggerRegistration\n        source = self\n\n        def _condition(g: Any, event: dict) -> bool:\n            \"\"\"Fire when the controller draws a card.\"\"\"\n            controller = source.controller or source.owner\n            return event.player is controller\n\n        def _effect(g: Any) -> None:\n            controller = source.controller or source.owner\n            if controller is None:\n                return\n            opponent = None\n            for p in g.players:\n                if p is not controller:\n                    opponent = p\n                    break\n            if opponent is None:\n                return\n            max_iterations = 100\n            for _ in range(max_iterations):\n                milled = SphinxsTutelage._mill(g, opponent, 2)\n                if len(milled) < 2:\n                    break\n                if not SphinxsTutelage._shared_color_among_nonlands(milled):\n                    break\n        reg = TriggerRegistration(event_type=DrawsCardTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=source.controller or source.owner)\n        game.trigger_manager.register(reg)\n\n    def get_activated_abilities(self) -> list[ActivatedAbility]:\n        source = self\n\n        def _cost(game: Any, src: Any) -> bool:\n            controller = getattr(src, 'controller', None)\n            if controller is None:\n                return False\n            cost = ManaCost.parse('{5}{U}')\n            if not controller.mana_pool.can_pay(cost):\n                return False\n            controller.mana_pool.pay(cost)\n            return True\n\n        def _effect(game: Any) -> None:\n            from engine.game import draw_card, discard\n            controller = source.controller or source.owner\n            if controller is None:\n                return\n            card_drawn = draw_card(game, controller)\n            hand = controller.zones[Zone.HAND]\n            cards_in_hand = hand.get_all()\n            if cards_in_hand:\n                to_discard = cards_in_hand[0]\n                discard(game, controller, to_discard)\n        return [ActivatedAbility(cost=_cost, effect=_effect, description='{5}{U}: Draw a card, then discard a card.')]\n","numLines":122,"startLine":1,"totalLines":122}}}
