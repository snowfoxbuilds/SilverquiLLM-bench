{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NMhJADboqyYxThB5UmviMn","type":"tool_result","content":"1\t\"\"\"Turn execution loop for the SilverquiLLM engine.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport warnings\n6\tfrom typing import TYPE_CHECKING\n7\t\n8\tif TYPE_CHECKING:\n9\t    from engine.game_state import GameState\n10\t\n11\tfrom engine.stack import priority_loop\n12\tfrom engine.types import Phase, Step, Zone\n13\t\n14\t\n15\t# Maximum hand size — players discard down to this during cleanup.\n16\tMAX_HAND_SIZE: int = 7\n17\t\n18\t\n19\t# Steps/phases where priority is given to players.\n20\t# In MTG, players do NOT receive priority during Untap and Cleanup (normally).\n21\t_NO_PRIORITY_STEPS: set[tuple[Phase, Step | None]] = {\n22\t    (Phase.BEGINNING, Step.UNTAP),\n23\t    (Phase.ENDING, Step.CLEANUP),\n24\t}\n25\t\n26\t\n27\tdef _do_untap_step(game: GameState) -> None:\n28\t    \"\"\"Perform untap step actions: untap all permanents controlled by the active player.\n29\t\n30\t    Per MTG rules, the active player untaps all permanents they control\n31\t    during their untap step. Summoning sickness is also cleared at this point.\n32\t    \"\"\"\n33\t    active = game.active_player\n34\t    bf = active.zones[Zone.BATTLEFIELD]\n35\t    for obj in bf.get_all():\n36\t        if hasattr(obj, \"is_tapped\"):\n37\t            obj.is_tapped = False\n38\t        if hasattr(obj, \"summoning_sick\"):\n39\t            obj.summoning_sick = False\n40\t\n41\t    # Reset land plays for the active player\n42\t    active.land_plays_remaining = 1\n43\t\n44\t\n45\tdef _do_draw_step(game: GameState) -> None:\n46\t    \"\"\"Perform draw step actions: active player draws a card.\n47\t\n48\t    In a two-player game, the starting player (the player who takes\n49\t    turn 1) skips their draw step on that first turn.  This is per\n50\t    MTG comprehensive rules §103.7a.\n51\t    \"\"\"\n52\t    # The starting player skips their draw on turn 1.\n53\t    if game.turn_number == 1 and game.active_player_index == 0:\n54\t        return\n55\t\n56\t    from engine.game import draw_card\n57\t\n58\t    draw_card(game, game.active_player)\n59\t\n60\t\n61\tdef _do_combat_step(game: GameState, step: Step) -> None:\n62\t    \"\"\"Dispatch combat sub-steps to the appropriate combat functions.\n63\t\n64\t    Parameters:\n65\t        game: The current game state.\n66\t        step: The combat step to execute.\n67\t    \"\"\"\n68\t    from engine.combat import (\n69\t        combat_damage_step,\n70\t        declare_attackers_step,\n71\t        declare_blockers_step,\n72\t        end_combat_step,\n73\t    )\n74\t\n75\t    if step == Step.DECLARE_ATTACKERS:\n76\t        declare_attackers_step(game)\n77\t    elif step == Step.DECLARE_BLOCKERS:\n78\t        declare_blockers_step(game)\n79\t    elif step == Step.COMBAT_DAMAGE:\n80\t        combat_damage_step(game)\n81\t    elif step == Step.END_COMBAT:\n82\t        end_combat_step(game)\n83\t\n84\t\n85\tdef _do_cleanup_step(game: GameState) -> None:\n86\t    \"\"\"Perform the cleanup step (MTG rule §514).\n87\t\n88\t    The cleanup step executes the following actions in order:\n89\t\n90\t    1. Active player discards down to maximum hand size (7) using\n91\t       :meth:`Player.choose_card`.\n92\t    2. Remove all \"until end of turn\" continuous effects via\n93\t       :meth:`EffectManager.remove_expired`, then reapply remaining\n94\t       effects for a consistent game state.\n95\t    3. Clear damage marked on all creatures on the battlefield.\n96\t    4. Clear combat-related flags (``dealt_deathtouch_damage``,\n97\t       ``is_attacking``, ``is_blocking``) and reset the combat state.\n98\t    5. Empty all players' mana pools.\n99\t    6. Check state-based actions.\n100\t    7. If triggers fired during cleanup (e.g. from discarding), process\n101\t       them (give priority, resolve stack) and perform another cleanup step.\n102\t    \"\"\"\n103\t    from engine.game import discard as _discard\n104\t    from engine.player import ScriptExhaustedError\n105\t    from engine.state_based_actions import resolve_state_based_actions\n106\t\n107\t    # --- Step 1: Discard to hand size ---\n108\t    active = game.active_player\n109\t    hand = active.zones[Zone.HAND]\n110\t    while len(hand) > MAX_HAND_SIZE:\n111\t        cards_in_hand = hand.get_all()\n112\t        if not cards_in_hand:\n113\t            break  # safety guard\n114\t        try:\n115\t            chosen = active.choose_card(cards_in_hand, \"discard to hand size\")\n116\t        except (ScriptExhaustedError, NotImplementedError) as exc:\n117\t            # Player implementation doesn't support choose_card or script\n118\t            # was exhausted.  Discard deterministically from end.\n119\t            chosen = cards_in_hand[-1]\n120\t            exc_name = type(exc).__name__\n121\t            warnings.warn(\n122\t                f\"{exc_name} during cleanup discard for {active.name}; \"\n123\t                f\"auto-discarding {chosen.name}\"\n124\t            )\n125\t        if chosen is not None and hand.contains(chosen):\n126\t            _discard(game, active, chosen)\n127\t        else:\n128\t            # If choose_card returns something invalid, discard the last card\n129\t            # to avoid an infinite loop.\n130\t            _discard(game, active, cards_in_hand[-1])\n131\t\n132\t    # --- Step 2: Remove \"until end of turn\" continuous effects ---\n133\t    if hasattr(game, \"effect_manager\"):\n134\t        game.effect_manager.remove_expired(game)\n135\t        # Reapply remaining effects so the game state is consistent.\n136\t        game.effect_manager.apply_all(game)\n137\t\n138\t    # --- Step 3: Clear damage on all creatures ---\n139\t    for player in game.players:\n140\t        bf = player.zones[Zone.BATTLEFIELD]\n141\t        for obj in bf.get_all():\n142\t            if hasattr(obj, \"damage_marked\"):\n143\t                obj.damage_marked = 0\n144\t\n145\t    # --- Step 4: Clear combat flags ---\n146\t    for player in game.players:\n147\t        bf = player.zones[Zone.BATTLEFIELD]\n148\t        for obj in bf.get_all():\n149\t            if hasattr(obj, \"dealt_deathtouch_damage\"):\n150\t                obj.dealt_deathtouch_damage = False\n151\t            if hasattr(obj, \"is_attacking\"):\n152\t                obj.is_attacking = False\n153\t            if hasattr(obj, \"is_blocking\"):\n154\t                obj.is_blocking = False\n155\t    # Reset the CombatState itself.\n156\t    if hasattr(game, \"combat_state\"):\n157\t        game.combat_state.clear()\n158\t\n159\t    # --- Step 5: Empty mana pools ---\n160\t    game.empty_mana_pools()\n161\t\n162\t    # --- Step 6: Check state-based actions ---\n163\t    sba_happened = resolve_state_based_actions(game)\n164\t\n165\t    # --- Step 7: If SBAs were performed or triggers fired, process & repeat ---\n166\t    # Rule 514.3a: if state-based actions were performed or triggered abilities\n167\t    # triggered during cleanup, another cleanup step occurs.\n168\t    if sba_happened or not game.stack.is_empty():\n169\t        # Triggers were placed on the stack — give priority and resolve.\n170\t        priority_loop(game)\n171\t        # After resolving, perform another cleanup step (recursive).\n172\t        _do_cleanup_step(game)\n173\t\n174\t\n175\tdef run_turn(game: GameState) -> None:\n176\t    \"\"\"Execute a full turn, iterating through all phases/steps.\n177\t\n178\t    At each priority point (every phase/step except Untap and Cleanup),\n179\t    :func:`priority_loop` is called.  Turn-based actions are performed\n180\t    at the appropriate steps:\n181\t\n182\t    - **Untap**: Untap all permanents, clear summoning sickness, reset\n183\t      land plays.\n184\t    - **Draw**: Active player draws a card.\n185\t    - **Combat**: Delegate to combat system functions.\n186\t    - **Cleanup**: Clear damage, remove expired effects.\n187\t\n188\t    After the last step (Cleanup), the turn number is incremented and\n189\t    the active player swaps via :meth:`GameState.advance_phase`.\n190\t\n191\t    Parameters:\n192\t        game: The game state to advance through one complete turn.\n193\t    \"\"\"\n194\t    start_turn = game.turn_number\n195\t\n196\t    while game.turn_number == start_turn:\n197\t        current = (game.phase, game.step)\n198\t\n199\t        # Perform turn-based actions for the current step\n200\t        if current == (Phase.BEGINNING, Step.UNTAP):\n201\t            _do_untap_step(game)\n202\t        elif current == (Phase.BEGINNING, Step.UPKEEP):\n203\t            from engine.events import BeginningOfUpkeepTriggeredEvent\n204\t            game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n205\t        elif current == (Phase.BEGINNING, Step.DRAW):\n206\t            _do_draw_step(game)\n207\t        elif game.phase == Phase.COMBAT and game.step is not None:\n208\t            _do_combat_step(game, game.step)\n209\t        elif current == (Phase.ENDING, Step.CLEANUP):\n210\t            _do_cleanup_step(game)\n211\t\n212\t        # Grant priority at this phase/step unless it's Untap or Cleanup.\n213\t        if current not in _NO_PRIORITY_STEPS:\n214\t            priority_loop(game)\n215\t\n216\t        # Advance to the next phase/step (or to next turn).\n217\t        game.advance_phase()\n218\t"}]},"parent_tool_use_id":null,"session_id":"8a32b7f0-be82-4ad8-afb4-a624c81177bb","uuid":"161ac796-9334-4706-9399-400500d678a9","timestamp":"2026-06-11T10:19:43.765Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/turn.py","content":"\"\"\"Turn execution loop for the SilverquiLLM engine.\"\"\"\n\nfrom __future__ import annotations\n\nimport warnings\nfrom typing import TYPE_CHECKING\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\nfrom engine.stack import priority_loop\nfrom engine.types import Phase, Step, Zone\n\n\n# Maximum hand size — players discard down to this during cleanup.\nMAX_HAND_SIZE: int = 7\n\n\n# Steps/phases where priority is given to players.\n# In MTG, players do NOT receive priority during Untap and Cleanup (normally).\n_NO_PRIORITY_STEPS: set[tuple[Phase, Step | None]] = {\n    (Phase.BEGINNING, Step.UNTAP),\n    (Phase.ENDING, Step.CLEANUP),\n}\n\n\ndef _do_untap_step(game: GameState) -> None:\n    \"\"\"Perform untap step actions: untap all permanents controlled by the active player.\n\n    Per MTG rules, the active player untaps all permanents they control\n    during their untap step. Summoning sickness is also cleared at this point.\n    \"\"\"\n    active = game.active_player\n    bf = active.zones[Zone.BATTLEFIELD]\n    for obj in bf.get_all():\n        if hasattr(obj, \"is_tapped\"):\n            obj.is_tapped = False\n        if hasattr(obj, \"summoning_sick\"):\n            obj.summoning_sick = False\n\n    # Reset land plays for the active player\n    active.land_plays_remaining = 1\n\n\ndef _do_draw_step(game: GameState) -> None:\n    \"\"\"Perform draw step actions: active player draws a card.\n\n    In a two-player game, the starting player (the player who takes\n    turn 1) skips their draw step on that first turn.  This is per\n    MTG comprehensive rules §103.7a.\n    \"\"\"\n    # The starting player skips their draw on turn 1.\n    if game.turn_number == 1 and game.active_player_index == 0:\n        return\n\n    from engine.game import draw_card\n\n    draw_card(game, game.active_player)\n\n\ndef _do_combat_step(game: GameState, step: Step) -> None:\n    \"\"\"Dispatch combat sub-steps to the appropriate combat functions.\n\n    Parameters:\n        game: The current game state.\n        step: The combat step to execute.\n    \"\"\"\n    from engine.combat import (\n        combat_damage_step,\n        declare_attackers_step,\n        declare_blockers_step,\n        end_combat_step,\n    )\n\n    if step == Step.DECLARE_ATTACKERS:\n        declare_attackers_step(game)\n    elif step == Step.DECLARE_BLOCKERS:\n        declare_blockers_step(game)\n    elif step == Step.COMBAT_DAMAGE:\n        combat_damage_step(game)\n    elif step == Step.END_COMBAT:\n        end_combat_step(game)\n\n\ndef _do_cleanup_step(game: GameState) -> None:\n    \"\"\"Perform the cleanup step (MTG rule §514).\n\n    The cleanup step executes the following actions in order:\n\n    1. Active player discards down to maximum hand size (7) using\n       :meth:`Player.choose_card`.\n    2. Remove all \"until end of turn\" continuous effects via\n       :meth:`EffectManager.remove_expired`, then reapply remaining\n       effects for a consistent game state.\n    3. Clear damage marked on all creatures on the battlefield.\n    4. Clear combat-related flags (``dealt_deathtouch_damage``,\n       ``is_attacking``, ``is_blocking``) and reset the combat state.\n    5. Empty all players' mana pools.\n    6. Check state-based actions.\n    7. If triggers fired during cleanup (e.g. from discarding), process\n       them (give priority, resolve stack) and perform another cleanup step.\n    \"\"\"\n    from engine.game import discard as _discard\n    from engine.player import ScriptExhaustedError\n    from engine.state_based_actions import resolve_state_based_actions\n\n    # --- Step 1: Discard to hand size ---\n    active = game.active_player\n    hand = active.zones[Zone.HAND]\n    while len(hand) > MAX_HAND_SIZE:\n        cards_in_hand = hand.get_all()\n        if not cards_in_hand:\n            break  # safety guard\n        try:\n            chosen = active.choose_card(cards_in_hand, \"discard to hand size\")\n        except (ScriptExhaustedError, NotImplementedError) as exc:\n            # Player implementation doesn't support choose_card or script\n            # was exhausted.  Discard deterministically from end.\n            chosen = cards_in_hand[-1]\n            exc_name = type(exc).__name__\n            warnings.warn(\n                f\"{exc_name} during cleanup discard for {active.name}; \"\n                f\"auto-discarding {chosen.name}\"\n            )\n        if chosen is not None and hand.contains(chosen):\n            _discard(game, active, chosen)\n        else:\n            # If choose_card returns something invalid, discard the last card\n            # to avoid an infinite loop.\n            _discard(game, active, cards_in_hand[-1])\n\n    # --- Step 2: Remove \"until end of turn\" continuous effects ---\n    if hasattr(game, \"effect_manager\"):\n        game.effect_manager.remove_expired(game)\n        # Reapply remaining effects so the game state is consistent.\n        game.effect_manager.apply_all(game)\n\n    # --- Step 3: Clear damage on all creatures ---\n    for player in game.players:\n        bf = player.zones[Zone.BATTLEFIELD]\n        for obj in bf.get_all():\n            if hasattr(obj, \"damage_marked\"):\n                obj.damage_marked = 0\n\n    # --- Step 4: Clear combat flags ---\n    for player in game.players:\n        bf = player.zones[Zone.BATTLEFIELD]\n        for obj in bf.get_all():\n            if hasattr(obj, \"dealt_deathtouch_damage\"):\n                obj.dealt_deathtouch_damage = False\n            if hasattr(obj, \"is_attacking\"):\n                obj.is_attacking = False\n            if hasattr(obj, \"is_blocking\"):\n                obj.is_blocking = False\n    # Reset the CombatState itself.\n    if hasattr(game, \"combat_state\"):\n        game.combat_state.clear()\n\n    # --- Step 5: Empty mana pools ---\n    game.empty_mana_pools()\n\n    # --- Step 6: Check state-based actions ---\n    sba_happened = resolve_state_based_actions(game)\n\n    # --- Step 7: If SBAs were performed or triggers fired, process & repeat ---\n    # Rule 514.3a: if state-based actions were performed or triggered abilities\n    # triggered during cleanup, another cleanup step occurs.\n    if sba_happened or not game.stack.is_empty():\n        # Triggers were placed on the stack — give priority and resolve.\n        priority_loop(game)\n        # After resolving, perform another cleanup step (recursive).\n        _do_cleanup_step(game)\n\n\ndef run_turn(game: GameState) -> None:\n    \"\"\"Execute a full turn, iterating through all phases/steps.\n\n    At each priority point (every phase/step except Untap and Cleanup),\n    :func:`priority_loop` is called.  Turn-based actions are performed\n    at the appropriate steps:\n\n    - **Untap**: Untap all permanents, clear summoning sickness, reset\n      land plays.\n    - **Draw**: Active player draws a card.\n    - **Combat**: Delegate to combat system functions.\n    - **Cleanup**: Clear damage, remove expired effects.\n\n    After the last step (Cleanup), the turn number is incremented and\n    the active player swaps via :meth:`GameState.advance_phase`.\n\n    Parameters:\n        game: The game state to advance through one complete turn.\n    \"\"\"\n    start_turn = game.turn_number\n\n    while game.turn_number == start_turn:\n        current = (game.phase, game.step)\n\n        # Perform turn-based actions for the current step\n        if current == (Phase.BEGINNING, Step.UNTAP):\n            _do_untap_step(game)\n        elif current == (Phase.BEGINNING, Step.UPKEEP):\n            from engine.events import BeginningOfUpkeepTriggeredEvent\n            game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n        elif current == (Phase.BEGINNING, Step.DRAW):\n            _do_draw_step(game)\n        elif game.phase == Phase.COMBAT and game.step is not None:\n            _do_combat_step(game, game.step)\n        elif current == (Phase.ENDING, Step.CLEANUP):\n            _do_cleanup_step(game)\n\n        # Grant priority at this phase/step unless it's Untap or Cleanup.\n        if current not in _NO_PRIORITY_STEPS:\n            priority_loop(game)\n\n        # Advance to the next phase/step (or to next turn).\n        game.advance_phase()\n","numLines":218,"startLine":1,"totalLines":218}}}
