{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CB9jDhMV3tWf2HsM3oZNJe","type":"tool_result","content":"1\t\"\"\"Mana pool and cost payment logic.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom engine.types import Color, HybridManaSymbol, ManaCost, ManaType\n6\t\n7\t# Map colored ManaTypes to their corresponding Color enum values.\n8\t_MANA_TO_COLOR: dict[ManaType, Color] = {\n9\t    ManaType.WHITE: Color.WHITE,\n10\t    ManaType.BLUE: Color.BLUE,\n11\t    ManaType.BLACK: Color.BLACK,\n12\t    ManaType.RED: Color.RED,\n13\t    ManaType.GREEN: Color.GREEN,\n14\t}\n15\t\n16\t\n17\tclass ManaPool:\n18\t    \"\"\"Tracks available mana for a player.\n19\t\n20\t    Internal storage uses a ``dict[ManaType, int]`` mapping each mana type\n21\t    to its current count.\n22\t    \"\"\"\n23\t\n24\t    def __init__(self) -> None:\n25\t        self._pool: dict[ManaType, int] = {mt: 0 for mt in ManaType}\n26\t        self._last_payment_colors: list[Color] = []\n27\t        # Mana restricted to paying for instant/sorcery spells (e.g. Great Hall).\n28\t        self._restricted_instant_sorcery: dict[ManaType, int] = {mt: 0 for mt in ManaType}\n29\t        # Set True by the casting pipeline when paying for an instant/sorcery.\n30\t        self._instant_sorcery_context: bool = False\n31\t\n32\t    # ------------------------------------------------------------------\n33\t    # Basic operations\n34\t    # ------------------------------------------------------------------\n35\t\n36\t    def add(self, mana_type: ManaType, amount: int = 1) -> None:\n37\t        \"\"\"Add *amount* mana of the given type to the pool.\n38\t\n39\t        Parameters:\n40\t            mana_type: The type of mana to add.\n41\t            amount: How many mana to add (must be non-negative).\n42\t        \"\"\"\n43\t        if amount < 0:\n44\t            raise ValueError(f\"Cannot add negative mana: {amount}\")\n45\t        self._pool[mana_type] = self._pool.get(mana_type, 0) + amount\n46\t\n47\t    def add_restricted(self, mana_type: ManaType, amount: int = 1) -> None:\n48\t        \"\"\"Add mana that may only be used to cast instant/sorcery spells.\n49\t\n50\t        Used by Great Hall of the Biblioplex's second mana ability.\n51\t        \"\"\"\n52\t        if amount < 0:\n53\t            raise ValueError(f\"Cannot add negative restricted mana: {amount}\")\n54\t        self._restricted_instant_sorcery[mana_type] = (\n55\t            self._restricted_instant_sorcery.get(mana_type, 0) + amount\n56\t        )\n57\t\n58\t    def empty(self) -> None:\n59\t        \"\"\"Clear the pool — happens at phase/step transitions.\"\"\"\n60\t        for mt in self._pool:\n61\t            self._pool[mt] = 0\n62\t        for mt in self._restricted_instant_sorcery:\n63\t            self._restricted_instant_sorcery[mt] = 0\n64\t\n65\t    def total(self) -> int:\n66\t        \"\"\"Return the total amount of mana in the pool across all types.\"\"\"\n67\t        return sum(self._pool.values())\n68\t\n69\t    def get(self, mana_type: ManaType) -> int:\n70\t        \"\"\"Return the amount of a specific mana type in the pool.\"\"\"\n71\t        return self._pool.get(mana_type, 0)\n72\t\n73\t    @property\n74\t    def last_payment_colors(self) -> list[Color]:\n75\t        \"\"\"Return the distinct colors of mana spent in the last :meth:`pay` call.\n76\t\n77\t        Colorless mana is not a color and is excluded.  The list is sorted\n78\t        by Color enum order for determinism.  Empty if no payment has been\n79\t        made or if all mana spent was colorless.\n80\t        \"\"\"\n81\t        return list(self._last_payment_colors)\n82\t\n83\t    # ------------------------------------------------------------------\n84\t    # Cost payment\n85\t    # ------------------------------------------------------------------\n86\t\n87\t    def can_pay(self, cost: ManaCost) -> bool:\n88\t        \"\"\"Check whether the pool can satisfy *cost*.\n89\t\n90\t        Generic mana can be paid by any type.  X is treated as 0 for\n91\t        ``can_pay`` unless explicitly set in the cost's generic component.\n92\t        Hybrid symbols can be paid with either option; this method uses\n93\t        backtracking to find a valid assignment.\n94\t\n95\t        When ``_instant_sorcery_context`` is True, restricted mana is\n96\t        included in the available pool (it can pay for instants/sorceries).\n97\t\n98\t        Returns:\n99\t            True if the pool has enough mana to pay the cost.\n100\t        \"\"\"\n101\t        remaining: dict[ManaType, int] = dict(self._pool)\n102\t        if self._instant_sorcery_context:\n103\t            for mt, amt in self._restricted_instant_sorcery.items():\n104\t                remaining[mt] = remaining.get(mt, 0) + amt\n105\t\n106\t        # Pay colored/colorless pips first.\n107\t        for mana_type, count in cost.pips.items():\n108\t            if remaining.get(mana_type, 0) < count:\n109\t                return False\n110\t            remaining[mana_type] = remaining.get(mana_type, 0) - count\n111\t\n112\t        # Solve hybrid symbols with backtracking.\n113\t        if cost.hybrid:\n114\t            if not self._can_pay_hybrid(remaining, list(cost.hybrid), 0, cost.generic):\n115\t                return False\n116\t            return True\n117\t\n118\t        # Then check generic — sum of all remaining mana must cover it.\n119\t        return sum(remaining.values()) >= cost.generic\n120\t\n121\t    def pay(self, cost: ManaCost, choices: dict[ManaType, int] | None = None) -> bool:\n122\t        \"\"\"Deduct mana from the pool to pay *cost*.\n123\t\n124\t        Parameters:\n125\t            cost: The mana cost to pay.\n126\t            choices: How to split the generic portion across mana types.\n127\t                If ``None``, auto-pay greedily: pay colored pips first,\n128\t                then hybrid symbols, then generic using colorless first,\n129\t                then excess colored.\n130\t\n131\t        Returns:\n132\t            True if payment succeeded, False if the pool has insufficient mana.\n133\t        \"\"\"\n134\t        if not self.can_pay(cost):\n135\t            return False\n136\t\n137\t        # Work on a copy so we can roll back on failure.\n138\t        # Include restricted mana in working pool when in instant/sorcery context.\n139\t        working: dict[ManaType, int] = dict(self._pool)\n140\t        if self._instant_sorcery_context:\n141\t            for mt, amt in self._restricted_instant_sorcery.items():\n142\t                working[mt] = working.get(mt, 0) + amt\n143\t\n144\t        # 1. Pay colored/colorless pips.\n145\t        for mana_type, count in cost.pips.items():\n146\t            working[mana_type] -= count\n147\t\n148\t        # 2. When explicit generic choices are provided, reserve that mana\n149\t        #    *before* solving hybrids so the solver doesn't steal it.\n150\t        generic_remaining = cost.generic\n151\t        if generic_remaining > 0 and choices is not None:\n152\t            # Reject negative choice amounts — they would create mana.\n153\t            if any(v < 0 for v in choices.values()):\n154\t                return False\n155\t            # Validate choices sum to generic cost.\n156\t            if sum(choices.values()) != generic_remaining:\n157\t                return False\n158\t            for mana_type, amount in choices.items():\n159\t                if working.get(mana_type, 0) < amount:\n160\t                    return False\n161\t                working[mana_type] -= amount\n162\t\n163\t        # 3. Pay hybrid symbols using backtracking to find a valid assignment.\n164\t        #    Generic choices (if any) have already been reserved above,\n165\t        #    so _solve_hybrid sees only the genuinely available mana.\n166\t        if cost.hybrid:\n167\t            generic_for_solver = generic_remaining if choices is None else 0\n168\t            hybrid_assignment = self._solve_hybrid(\n169\t                working, list(cost.hybrid), 0, generic_for_solver,\n170\t            )\n171\t            if hybrid_assignment is None:\n172\t                return False  # pragma: no cover – should not happen after can_pay\n173\t            for mt in hybrid_assignment:\n174\t                working[mt] = working.get(mt, 0) - 1\n175\t\n176\t        # 4. Pay generic cost (auto-pay path — choices already deducted above).\n177\t        if generic_remaining > 0 and choices is None:\n178\t            generic_remaining = self._auto_pay_generic(working, generic_remaining)\n179\t            if generic_remaining > 0:\n180\t                return False  # pragma: no cover – should not happen after can_pay\n181\t\n182\t        # Commit the payment.\n183\t        # Compute colors of mana spent by comparing old pool to new working pool.\n184\t        colors_spent: set[Color] = set()\n185\t        if self._instant_sorcery_context:\n186\t            # working includes restricted mana; split back into _pool / _restricted.\n187\t            # Preference: deduct unrestricted first, restricted only as overflow.\n188\t            new_pool: dict[ManaType, int] = {}\n189\t            new_restricted: dict[ManaType, int] = {}\n190\t            for mt in ManaType:\n191\t                old_unrestricted = self._pool.get(mt, 0)\n192\t                old_restricted = self._restricted_instant_sorcery.get(mt, 0)\n193\t                remaining_combined = working.get(mt, 0)\n194\t                used_total = (old_unrestricted + old_restricted) - remaining_combined\n195\t                used_from_unrestricted = min(used_total, old_unrestricted)\n196\t                used_from_restricted = used_total - used_from_unrestricted\n197\t                new_pool[mt] = old_unrestricted - used_from_unrestricted\n198\t                new_restricted[mt] = old_restricted - used_from_restricted\n199\t                if used_from_unrestricted > 0 and mt in _MANA_TO_COLOR:\n200\t                    colors_spent.add(_MANA_TO_COLOR[mt])\n201\t                if used_from_restricted > 0 and mt in _MANA_TO_COLOR:\n202\t                    colors_spent.add(_MANA_TO_COLOR[mt])\n203\t            self._pool = new_pool\n204\t            self._restricted_instant_sorcery = new_restricted\n205\t        else:\n206\t            for mt, old_amount in self._pool.items():\n207\t                new_amount = working.get(mt, 0)\n208\t                if new_amount < old_amount and mt in _MANA_TO_COLOR:\n209\t                    colors_spent.add(_MANA_TO_COLOR[mt])\n210\t            self._pool = working\n211\t        self._last_payment_colors = sorted(colors_spent, key=lambda c: c.value)\n212\t        return True\n213\t\n214\t    @staticmethod\n215\t    def _can_pay_hybrid(\n216\t        remaining: dict[ManaType, int],\n217\t        hybrids: list[HybridManaSymbol],\n218\t        idx: int,\n219\t        generic: int,\n220\t    ) -> bool:\n221\t        \"\"\"Recursively check if hybrid symbols + generic can be satisfied.\n222\t\n223\t        Uses backtracking: for each hybrid symbol, try option_a then option_b.\n224\t        After all hybrids are assigned, check that remaining mana covers generic.\n225\t        \"\"\"\n226\t        if idx >= len(hybrids):\n227\t            return sum(remaining.values()) >= generic\n228\t\n229\t        sym = hybrids[idx]\n230\t        for option in (sym.option_a, sym.option_b):\n231\t            if remaining.get(option, 0) > 0:\n232\t                remaining[option] -= 1\n233\t                if ManaPool._can_pay_hybrid(remaining, hybrids, idx + 1, generic):\n234\t                    remaining[option] += 1\n235\t                    return True\n236\t                remaining[option] += 1\n237\t        return False\n238\t\n239\t    @staticmethod\n240\t    def _solve_hybrid(\n241\t        remaining: dict[ManaType, int],\n242\t        hybrids: list[HybridManaSymbol],\n243\t        idx: int,\n244\t        generic: int,\n245\t    ) -> list[ManaType] | None:\n246\t        \"\"\"Find a valid assignment for hybrid symbols.\n247\t\n248\t        Returns a list of ManaType choices (one per hybrid symbol) or None\n249\t        if no valid assignment exists.\n250\t        \"\"\"\n251\t        if idx >= len(hybrids):\n252\t            if sum(remaining.values()) >= generic:\n253\t                return []\n254\t            return None\n255\t\n256\t        sym = hybrids[idx]\n257\t        for option in (sym.option_a, sym.option_b):\n258\t            if remaining.get(option, 0) > 0:\n259\t                remaining[option] -= 1\n260\t                result = ManaPool._solve_hybrid(remaining, hybrids, idx + 1, generic)\n261\t                if result is not None:\n262\t                    remaining[option] += 1\n263\t                    return [option] + result\n264\t                remaining[option] += 1\n265\t        return None\n266\t\n267\t    @staticmethod\n268\t    def _auto_pay_generic(working: dict[ManaType, int], amount: int) -> int:\n269\t        \"\"\"Deduct *amount* generic mana from *working*, preferring colorless.\n270\t\n271\t        Returns the remaining unpaid generic amount (0 on success).\n272\t        \"\"\"\n273\t        # Pay with colorless first.\n274\t        if working.get(ManaType.COLORLESS, 0) > 0:\n275\t            take = min(working[ManaType.COLORLESS], amount)\n276\t            working[ManaType.COLORLESS] -= take\n277\t            amount -= take\n278\t\n279\t        # Then pay with each colored type in enum order.\n280\t        for mt in ManaType:\n281\t            if mt is ManaType.COLORLESS:\n282\t                continue\n283\t            if amount <= 0:\n284\t                break\n285\t            if working.get(mt, 0) > 0:\n286\t                take = min(working[mt], amount)\n287\t                working[mt] -= take\n288\t                amount -= take\n289\t\n290\t        return amount\n291\t\n292\t    # ------------------------------------------------------------------\n293\t    # Dunder helpers\n294\t    # ------------------------------------------------------------------\n295\t\n296\t    def __repr__(self) -> str:\n297\t        non_zero = {mt.name: v for mt, v in self._pool.items() if v > 0}\n298\t        return f\"ManaPool({non_zero})\"\n299\t"}]},"parent_tool_use_id":null,"session_id":"ecc45bba-5220-4378-9482-c0a0c3fff5e1","uuid":"62b16244-bce4-4ba9-ad45-28afa8d4ca44","timestamp":"2026-06-11T07:12:12.415Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/mana.py","content":"\"\"\"Mana pool and cost payment logic.\"\"\"\n\nfrom __future__ import annotations\n\nfrom engine.types import Color, HybridManaSymbol, ManaCost, ManaType\n\n# Map colored ManaTypes to their corresponding Color enum values.\n_MANA_TO_COLOR: dict[ManaType, Color] = {\n    ManaType.WHITE: Color.WHITE,\n    ManaType.BLUE: Color.BLUE,\n    ManaType.BLACK: Color.BLACK,\n    ManaType.RED: Color.RED,\n    ManaType.GREEN: Color.GREEN,\n}\n\n\nclass ManaPool:\n    \"\"\"Tracks available mana for a player.\n\n    Internal storage uses a ``dict[ManaType, int]`` mapping each mana type\n    to its current count.\n    \"\"\"\n\n    def __init__(self) -> None:\n        self._pool: dict[ManaType, int] = {mt: 0 for mt in ManaType}\n        self._last_payment_colors: list[Color] = []\n        # Mana restricted to paying for instant/sorcery spells (e.g. Great Hall).\n        self._restricted_instant_sorcery: dict[ManaType, int] = {mt: 0 for mt in ManaType}\n        # Set True by the casting pipeline when paying for an instant/sorcery.\n        self._instant_sorcery_context: bool = False\n\n    # ------------------------------------------------------------------\n    # Basic operations\n    # ------------------------------------------------------------------\n\n    def add(self, mana_type: ManaType, amount: int = 1) -> None:\n        \"\"\"Add *amount* mana of the given type to the pool.\n\n        Parameters:\n            mana_type: The type of mana to add.\n            amount: How many mana to add (must be non-negative).\n        \"\"\"\n        if amount < 0:\n            raise ValueError(f\"Cannot add negative mana: {amount}\")\n        self._pool[mana_type] = self._pool.get(mana_type, 0) + amount\n\n    def add_restricted(self, mana_type: ManaType, amount: int = 1) -> None:\n        \"\"\"Add mana that may only be used to cast instant/sorcery spells.\n\n        Used by Great Hall of the Biblioplex's second mana ability.\n        \"\"\"\n        if amount < 0:\n            raise ValueError(f\"Cannot add negative restricted mana: {amount}\")\n        self._restricted_instant_sorcery[mana_type] = (\n            self._restricted_instant_sorcery.get(mana_type, 0) + amount\n        )\n\n    def empty(self) -> None:\n        \"\"\"Clear the pool — happens at phase/step transitions.\"\"\"\n        for mt in self._pool:\n            self._pool[mt] = 0\n        for mt in self._restricted_instant_sorcery:\n            self._restricted_instant_sorcery[mt] = 0\n\n    def total(self) -> int:\n        \"\"\"Return the total amount of mana in the pool across all types.\"\"\"\n        return sum(self._pool.values())\n\n    def get(self, mana_type: ManaType) -> int:\n        \"\"\"Return the amount of a specific mana type in the pool.\"\"\"\n        return self._pool.get(mana_type, 0)\n\n    @property\n    def last_payment_colors(self) -> list[Color]:\n        \"\"\"Return the distinct colors of mana spent in the last :meth:`pay` call.\n\n        Colorless mana is not a color and is excluded.  The list is sorted\n        by Color enum order for determinism.  Empty if no payment has been\n        made or if all mana spent was colorless.\n        \"\"\"\n        return list(self._last_payment_colors)\n\n    # ------------------------------------------------------------------\n    # Cost payment\n    # ------------------------------------------------------------------\n\n    def can_pay(self, cost: ManaCost) -> bool:\n        \"\"\"Check whether the pool can satisfy *cost*.\n\n        Generic mana can be paid by any type.  X is treated as 0 for\n        ``can_pay`` unless explicitly set in the cost's generic component.\n        Hybrid symbols can be paid with either option; this method uses\n        backtracking to find a valid assignment.\n\n        When ``_instant_sorcery_context`` is True, restricted mana is\n        included in the available pool (it can pay for instants/sorceries).\n\n        Returns:\n            True if the pool has enough mana to pay the cost.\n        \"\"\"\n        remaining: dict[ManaType, int] = dict(self._pool)\n        if self._instant_sorcery_context:\n            for mt, amt in self._restricted_instant_sorcery.items():\n                remaining[mt] = remaining.get(mt, 0) + amt\n\n        # Pay colored/colorless pips first.\n        for mana_type, count in cost.pips.items():\n            if remaining.get(mana_type, 0) < count:\n                return False\n            remaining[mana_type] = remaining.get(mana_type, 0) - count\n\n        # Solve hybrid symbols with backtracking.\n        if cost.hybrid:\n            if not self._can_pay_hybrid(remaining, list(cost.hybrid), 0, cost.generic):\n                return False\n            return True\n\n        # Then check generic — sum of all remaining mana must cover it.\n        return sum(remaining.values()) >= cost.generic\n\n    def pay(self, cost: ManaCost, choices: dict[ManaType, int] | None = None) -> bool:\n        \"\"\"Deduct mana from the pool to pay *cost*.\n\n        Parameters:\n            cost: The mana cost to pay.\n            choices: How to split the generic portion across mana types.\n                If ``None``, auto-pay greedily: pay colored pips first,\n                then hybrid symbols, then generic using colorless first,\n                then excess colored.\n\n        Returns:\n            True if payment succeeded, False if the pool has insufficient mana.\n        \"\"\"\n        if not self.can_pay(cost):\n            return False\n\n        # Work on a copy so we can roll back on failure.\n        # Include restricted mana in working pool when in instant/sorcery context.\n        working: dict[ManaType, int] = dict(self._pool)\n        if self._instant_sorcery_context:\n            for mt, amt in self._restricted_instant_sorcery.items():\n                working[mt] = working.get(mt, 0) + amt\n\n        # 1. Pay colored/colorless pips.\n        for mana_type, count in cost.pips.items():\n            working[mana_type] -= count\n\n        # 2. When explicit generic choices are provided, reserve that mana\n        #    *before* solving hybrids so the solver doesn't steal it.\n        generic_remaining = cost.generic\n        if generic_remaining > 0 and choices is not None:\n            # Reject negative choice amounts — they would create mana.\n            if any(v < 0 for v in choices.values()):\n                return False\n            # Validate choices sum to generic cost.\n            if sum(choices.values()) != generic_remaining:\n                return False\n            for mana_type, amount in choices.items():\n                if working.get(mana_type, 0) < amount:\n                    return False\n                working[mana_type] -= amount\n\n        # 3. Pay hybrid symbols using backtracking to find a valid assignment.\n        #    Generic choices (if any) have already been reserved above,\n        #    so _solve_hybrid sees only the genuinely available mana.\n        if cost.hybrid:\n            generic_for_solver = generic_remaining if choices is None else 0\n            hybrid_assignment = self._solve_hybrid(\n                working, list(cost.hybrid), 0, generic_for_solver,\n            )\n            if hybrid_assignment is None:\n                return False  # pragma: no cover – should not happen after can_pay\n            for mt in hybrid_assignment:\n                working[mt] = working.get(mt, 0) - 1\n\n        # 4. Pay generic cost (auto-pay path — choices already deducted above).\n        if generic_remaining > 0 and choices is None:\n            generic_remaining = self._auto_pay_generic(working, generic_remaining)\n            if generic_remaining > 0:\n                return False  # pragma: no cover – should not happen after can_pay\n\n        # Commit the payment.\n        # Compute colors of mana spent by comparing old pool to new working pool.\n        colors_spent: set[Color] = set()\n        if self._instant_sorcery_context:\n            # working includes restricted mana; split back into _pool / _restricted.\n            # Preference: deduct unrestricted first, restricted only as overflow.\n            new_pool: dict[ManaType, int] = {}\n            new_restricted: dict[ManaType, int] = {}\n            for mt in ManaType:\n                old_unrestricted = self._pool.get(mt, 0)\n                old_restricted = self._restricted_instant_sorcery.get(mt, 0)\n                remaining_combined = working.get(mt, 0)\n                used_total = (old_unrestricted + old_restricted) - remaining_combined\n                used_from_unrestricted = min(used_total, old_unrestricted)\n                used_from_restricted = used_total - used_from_unrestricted\n                new_pool[mt] = old_unrestricted - used_from_unrestricted\n                new_restricted[mt] = old_restricted - used_from_restricted\n                if used_from_unrestricted > 0 and mt in _MANA_TO_COLOR:\n                    colors_spent.add(_MANA_TO_COLOR[mt])\n                if used_from_restricted > 0 and mt in _MANA_TO_COLOR:\n                    colors_spent.add(_MANA_TO_COLOR[mt])\n            self._pool = new_pool\n            self._restricted_instant_sorcery = new_restricted\n        else:\n            for mt, old_amount in self._pool.items():\n                new_amount = working.get(mt, 0)\n                if new_amount < old_amount and mt in _MANA_TO_COLOR:\n                    colors_spent.add(_MANA_TO_COLOR[mt])\n            self._pool = working\n        self._last_payment_colors = sorted(colors_spent, key=lambda c: c.value)\n        return True\n\n    @staticmethod\n    def _can_pay_hybrid(\n        remaining: dict[ManaType, int],\n        hybrids: list[HybridManaSymbol],\n        idx: int,\n        generic: int,\n    ) -> bool:\n        \"\"\"Recursively check if hybrid symbols + generic can be satisfied.\n\n        Uses backtracking: for each hybrid symbol, try option_a then option_b.\n        After all hybrids are assigned, check that remaining mana covers generic.\n        \"\"\"\n        if idx >= len(hybrids):\n            return sum(remaining.values()) >= generic\n\n        sym = hybrids[idx]\n        for option in (sym.option_a, sym.option_b):\n            if remaining.get(option, 0) > 0:\n                remaining[option] -= 1\n                if ManaPool._can_pay_hybrid(remaining, hybrids, idx + 1, generic):\n                    remaining[option] += 1\n                    return True\n                remaining[option] += 1\n        return False\n\n    @staticmethod\n    def _solve_hybrid(\n        remaining: dict[ManaType, int],\n        hybrids: list[HybridManaSymbol],\n        idx: int,\n        generic: int,\n    ) -> list[ManaType] | None:\n        \"\"\"Find a valid assignment for hybrid symbols.\n\n        Returns a list of ManaType choices (one per hybrid symbol) or None\n        if no valid assignment exists.\n        \"\"\"\n        if idx >= len(hybrids):\n            if sum(remaining.values()) >= generic:\n                return []\n            return None\n\n        sym = hybrids[idx]\n        for option in (sym.option_a, sym.option_b):\n            if remaining.get(option, 0) > 0:\n                remaining[option] -= 1\n                result = ManaPool._solve_hybrid(remaining, hybrids, idx + 1, generic)\n                if result is not None:\n                    remaining[option] += 1\n                    return [option] + result\n                remaining[option] += 1\n        return None\n\n    @staticmethod\n    def _auto_pay_generic(working: dict[ManaType, int], amount: int) -> int:\n        \"\"\"Deduct *amount* generic mana from *working*, preferring colorless.\n\n        Returns the remaining unpaid generic amount (0 on success).\n        \"\"\"\n        # Pay with colorless first.\n        if working.get(ManaType.COLORLESS, 0) > 0:\n            take = min(working[ManaType.COLORLESS], amount)\n            working[ManaType.COLORLESS] -= take\n            amount -= take\n\n        # Then pay with each colored type in enum order.\n        for mt in ManaType:\n            if mt is ManaType.COLORLESS:\n                continue\n            if amount <= 0:\n                break\n            if working.get(mt, 0) > 0:\n                take = min(working[mt], amount)\n                working[mt] -= take\n                amount -= take\n\n        return amount\n\n    # ------------------------------------------------------------------\n    # Dunder helpers\n    # ------------------------------------------------------------------\n\n    def __repr__(self) -> str:\n        non_zero = {mt.name: v for mt, v in self._pool.items() if v > 0}\n        return f\"ManaPool({non_zero})\"\n","numLines":299,"startLine":1,"totalLines":299}}}
