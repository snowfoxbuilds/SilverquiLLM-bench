effects if e.source is source]\n\n    def clear(self) -> None:\n        \"\"\"Remove all effects.\"\"\"\n        self._effects.clear()\n\n    def __len__(self) -> int:\n        return len(self._effects)\n","numLines":44,"startLine":209,"totalLines":252}}}
