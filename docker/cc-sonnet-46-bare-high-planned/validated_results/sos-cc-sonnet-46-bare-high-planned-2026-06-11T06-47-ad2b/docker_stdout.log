{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CM9NXY7bRnphanNafCUekH","type":"tool_result","content":"345\t    # Move card from source zone to stack zone\n346\t    stack_zone = player.zones[Zone.STACK]\n347\t    source_zone_container.remove(card)\n348\t    stack_zone.add(card)\n349\t\n350\t    # 3. Choose targets (with rollback on failure)\n351\t    try:\n352\t        target_specs = card.get_targets(game)\n353\t        chosen_targets: list[Any] = []\n354\t        if target_specs:\n355\t            for spec in target_specs:\n356\t                target = player.choose_target(target_specs, spec)\n357\t                # Validate against filter_fn if the spec provides one\n358\t                filter_fn = getattr(spec, \"filter_fn\", None)\n359\t                if filter_fn is not None and target is not None:\n360\t                    if not filter_fn(target):\n361\t                        raise CastingError(\n362\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n363\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n364\t                        )\n365\t                chosen_targets.append(target)\n366\t\n367\t        # Protection check — reject targets that have protection from this spell\n368\t        from engine.protection import has_protection_from\n369\t\n370\t        for target in chosen_targets:\n371\t            if has_protection_from(target, card):\n372\t                raise CastingError(\n373\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n374\t                )\n375\t    except Exception as exc:\n376\t        # Rollback: move card from stack zone back to source zone\n377\t        stack_zone.remove(card)\n378\t        source_zone_container.add(card)\n379\t        raise CastingError(str(exc)) from exc\n380\t\n381\t    # 4. Call on_cast hook\n382\t    card.on_cast(game)\n383\t\n384\t    # 5. Build on_resolve callback and push StackObject\n385\t    stack_obj = StackObject(\n386\t        source=card,\n387\t        controller=player,\n388\t        targets=chosen_targets,\n389\t        on_resolve=lambda g: None,  # replaced below\n390\t    )\n391\t\n392\t    def _on_resolve(g: GameState) -> None:\n393\t        _resolve_spell(g, card, player, stack_obj)\n394\t\n395\t    stack_obj.on_resolve = _on_resolve\n396\t    game.stack.push(stack_obj)\n397\t\n398\t\n399\t# ------------------------------------------------------------------\n400\t# Resolution (called when the stack pops)\n401\t# ------------------------------------------------------------------\n402\t\n403\tdef _resolve_spell(\n404\t    game: GameState,\n405\t    card: CardImpl,\n406\t    player: Player,\n407\t    stack_obj: StackObject,\n408\t) -> None:\n409\t    \"\"\"Resolve *card* cast by *player*.\n410\t\n411\t    1. Call ``card.on_resolve(game, targets=targets)``.\n412\t    2. Remove the card from the stack zone.\n413\t    3. If the card is a permanent type, move it to the battlefield via\n414\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n415\t       registration and the ETB event).\n416\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n417\t    \"\"\"\n418\t    from engine.zones import move_to_zone\n419\t\n420\t    # Read targets from the StackObject — the single source of truth.\n421\t    # Set chosen_targets on the card just before resolution so that\n422\t    # _get_chosen_target helpers (which read via getattr) work.\n423\t    targets = stack_obj.targets\n424\t    if targets is not None:"}]},"parent_tool_use_id":null,"session_id":"ecc45bba-5220-4378-9482-c0a0c3fff5e1","uuid":"af0621ed-42a4-434d-a2e3-2bfb1354c23c","timestamp":"2026-06-11T07:25:17.789Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"    # Move card from source zone to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    source_zone_container.remove(card)\n    stack_zone.add(card)\n\n    # 3. Choose targets (with rollback on failure)\n    try:\n        target_specs = card.get_targets(game)\n        chosen_targets: list[Any] = []\n        if target_specs:\n            for spec in target_specs:\n                target = player.choose_target(target_specs, spec)\n                # Validate against filter_fn if the spec provides one\n                filter_fn = getattr(spec, \"filter_fn\", None)\n                if filter_fn is not None and target is not None:\n                    if not filter_fn(target):\n                        raise CastingError(\n                            f\"Cannot cast {card.name!r} — chosen target does not \"\n                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                        )\n                chosen_targets.append(target)\n\n        # Protection check — reject targets that have protection from this spell\n        from engine.protection import has_protection_from\n\n        for target in chosen_targets:\n            if has_protection_from(target, card):\n                raise CastingError(\n                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n                )\n    except Exception as exc:\n        # Rollback: move card from stack zone back to source zone\n        stack_zone.remove(card)\n        source_zone_container.add(card)\n        raise CastingError(str(exc)) from exc\n\n    # 4. Call on_cast hook\n    card.on_cast(game)\n\n    # 5. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n\n# ------------------------------------------------------------------\n# Resolution (called when the stack pops)\n# ------------------------------------------------------------------\n\ndef _resolve_spell(\n    game: GameState,\n    card: CardImpl,\n    player: Player,\n    stack_obj: StackObject,\n) -> None:\n    \"\"\"Resolve *card* cast by *player*.\n\n    1. Call ``card.on_resolve(game, targets=targets)``.\n    2. Remove the card from the stack zone.\n    3. If the card is a permanent type, move it to the battlefield via\n       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n       registration and the ETB event).\n    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Read targets from the StackObject — the single source of truth.\n    # Set chosen_targets on the card just before resolution so that\n    # _get_chosen_target helpers (which read via getattr) work.\n    targets = stack_obj.targets\n    if targets is not None:","numLines":80,"startLine":345,"totalLines":513}}}
