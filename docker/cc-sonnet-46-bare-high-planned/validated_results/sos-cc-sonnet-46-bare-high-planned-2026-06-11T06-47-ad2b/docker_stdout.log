{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0187W9hwmpNaWTE22iMJciCN","type":"tool_result","content":"246\t\n247\t    # 7. Call on_cast hook\n248\t    card.on_cast(game)\n249\t\n250\t    # 8. Build on_resolve callback and push StackObject\n251\t    stack_obj = StackObject(\n252\t        source=card,\n253\t        controller=player,\n254\t        targets=chosen_targets,\n255\t        on_resolve=lambda g: None,  # replaced below\n256\t    )\n257\t\n258\t    def _on_resolve(g: GameState) -> None:\n259\t        _resolve_spell(g, card, player, stack_obj)\n260\t\n261\t    stack_obj.on_resolve = _on_resolve\n262\t    game.stack.push(stack_obj)\n263\t\n264\t    # E1: Fire SpellCastTriggeredEvent after spell is on the stack.\n265\t    # Copies (via copy_spell) do not go through cast_spell, so they\n266\t    # correctly do not re-fire this event.\n267\t    from engine.events import SpellCastTriggeredEvent\n268\t    game.trigger_manager.fire_event(\n269\t        game,\n270\t        SpellCastTriggeredEvent(spell=stack_obj, card=card, controller=player),\n271\t    )\n272\t\n273\t\n274\t# ------------------------------------------------------------------\n275\t# Cast spell without paying mana cost (free-cast from any zone)\n276\t# ------------------------------------------------------------------\n277\t\n278\t\n279\tdef cast_spell_free(\n280\t    game: GameState,\n281\t    player: Player,\n282\t    card: CardImpl,\n283\t    from_zone: Zone,\n284\t) -> None:\n285\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n286\t\n287\t    This is used by effects that allow casting from zones other than hand\n288\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n289\t    or cascade.\n290\t\n291\t    Pipeline\n292\t    --------\n293\t    1. **can_cast** — ask the card whether it can legally be cast (same\n294\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n295\t    2. Move *card* from *from_zone* to the stack zone.\n296\t    3. Choose targets (if applicable) with validation and protection check.\n297\t    4. Call ``on_cast`` hook.\n298\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n299\t       resolution normally (permanents → battlefield, non-permanents →\n300\t       graveyard).\n301\t\n302\t    No timing check or mana payment is performed.  The spell goes on the\n303\t    stack and can be responded to normally (e.g. countered).\n304\t\n305\t    If targeting or other post-move checks fail, the card is rolled back\n306\t    to its source zone.\n307\t\n308\t    Parameters:\n309\t        game: The current game state.\n310\t        player: The player casting the spell.\n311\t        card: The card to cast.\n312\t        from_zone: The zone the card is currently in.\n313\t\n314\t    Raises:\n315\t        CastingError: If the card cannot be found in *from_zone* or\n316\t            legality checks fail.\n317\t    \"\"\"\n318\t    from engine.zones import move_to_zone\n319\t\n320\t    # Ensure controller is set\n321\t    card.controller = player\n322\t    if card.owner is None:\n323\t        card.owner = player\n324\t\n325\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n326\t    if not card.can_cast(game):\n327\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n328\t\n329\t    # 2. Locate card in source zone\n330\t    source_zone_container = player.zones[from_zone]\n331\t    if not source_zone_container.contains(card):\n332\t        # Try to find the card in any player's zone\n333\t        source_zone_container = None\n334\t        for p in game.players:\n335\t            z = p.zones[from_zone]\n336\t            if z.contains(card):\n337\t                source_zone_container = z\n338\t                break\n339\t\n340\t    if source_zone_container is None or not source_zone_container.contains(card):\n341\t        raise CastingError(\n342\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n343\t        )\n344\t\n345\t    # Move card from source zone to stack zone"}]},"parent_tool_use_id":null,"session_id":"ecc45bba-5220-4378-9482-c0a0c3fff5e1","uuid":"56adfc25-f5f2-40b7-b3d1-077e7a5ce9fb","timestamp":"2026-06-11T07:25:09.835Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"\n    # 7. Call on_cast hook\n    card.on_cast(game)\n\n    # 8. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n    # E1: Fire SpellCastTriggeredEvent after spell is on the stack.\n    # Copies (via copy_spell) do not go through cast_spell, so they\n    # correctly do not re-fire this event.\n    from engine.events import SpellCastTriggeredEvent\n    game.trigger_manager.fire_event(\n        game,\n        SpellCastTriggeredEvent(spell=stack_obj, card=card, controller=player),\n    )\n\n\n# ------------------------------------------------------------------\n# Cast spell without paying mana cost (free-cast from any zone)\n# ------------------------------------------------------------------\n\n\ndef cast_spell_free(\n    game: GameState,\n    player: Player,\n    card: CardImpl,\n    from_zone: Zone,\n) -> None:\n    \"\"\"Cast *card* without paying its mana cost, using the stack.\n\n    This is used by effects that allow casting from zones other than hand\n    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n    or cascade.\n\n    Pipeline\n    --------\n    1. **can_cast** — ask the card whether it can legally be cast (same\n       legality as :func:`cast_spell`, minus mana/timing constraints).\n    2. Move *card* from *from_zone* to the stack zone.\n    3. Choose targets (if applicable) with validation and protection check.\n    4. Call ``on_cast`` hook.\n    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n       resolution normally (permanents → battlefield, non-permanents →\n       graveyard).\n\n    No timing check or mana payment is performed.  The spell goes on the\n    stack and can be responded to normally (e.g. countered).\n\n    If targeting or other post-move checks fail, the card is rolled back\n    to its source zone.\n\n    Parameters:\n        game: The current game state.\n        player: The player casting the spell.\n        card: The card to cast.\n        from_zone: The zone the card is currently in.\n\n    Raises:\n        CastingError: If the card cannot be found in *from_zone* or\n            legality checks fail.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Ensure controller is set\n    card.controller = player\n    if card.owner is None:\n        card.owner = player\n\n    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 2. Locate card in source zone\n    source_zone_container = player.zones[from_zone]\n    if not source_zone_container.contains(card):\n        # Try to find the card in any player's zone\n        source_zone_container = None\n        for p in game.players:\n            z = p.zones[from_zone]\n            if z.contains(card):\n                source_zone_container = z\n                break\n\n    if source_zone_container is None or not source_zone_container.contains(card):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n        )\n\n    # Move card from source zone to stack zone","numLines":100,"startLine":246,"totalLines":513}}}
