{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014Q1L4WcKKevgDMHCf8x6ad","type":"tool_result","content":"400\t# Resolution (called when the stack pops)\n401\t# ------------------------------------------------------------------\n402\t\n403\tdef _resolve_spell(\n404\t    game: GameState,\n405\t    card: CardImpl,\n406\t    player: Player,\n407\t    stack_obj: StackObject,\n408\t) -> None:\n409\t    \"\"\"Resolve *card* cast by *player*.\n410\t\n411\t    1. Call ``card.on_resolve(game, targets=targets)``.\n412\t    2. Remove the card from the stack zone.\n413\t    3. If the card is a permanent type, move it to the battlefield via\n414\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n415\t       registration and the ETB event).\n416\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n417\t    \"\"\"\n418\t    from engine.zones import move_to_zone\n419\t\n420\t    # Read targets from the StackObject — the single source of truth.\n421\t    # Set chosen_targets on the card just before resolution so that\n422\t    # _get_chosen_target helpers (which read via getattr) work.\n423\t    targets = stack_obj.targets\n424\t    if targets is not None:\n425\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n426\t\n427\t    card.on_resolve(game)\n428\t\n429\t    if card.card_types & _PERMANENT_TYPES:\n430\t        # Move from stack to battlefield via move_to_zone, which handles\n431\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n432\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n433\t    else:\n434\t        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n435\t        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n436\t\n437\t\n438\t# ------------------------------------------------------------------\n439\t# Play land (special action — does not use the stack)"}]},"parent_tool_use_id":null,"session_id":"ecc45bba-5220-4378-9482-c0a0c3fff5e1","uuid":"38cbc1f1-007b-42b2-84fb-7a9a9b48f55d","timestamp":"2026-06-11T07:35:34.836Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"# Resolution (called when the stack pops)\n# ------------------------------------------------------------------\n\ndef _resolve_spell(\n    game: GameState,\n    card: CardImpl,\n    player: Player,\n    stack_obj: StackObject,\n) -> None:\n    \"\"\"Resolve *card* cast by *player*.\n\n    1. Call ``card.on_resolve(game, targets=targets)``.\n    2. Remove the card from the stack zone.\n    3. If the card is a permanent type, move it to the battlefield via\n       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n       registration and the ETB event).\n    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Read targets from the StackObject — the single source of truth.\n    # Set chosen_targets on the card just before resolution so that\n    # _get_chosen_target helpers (which read via getattr) work.\n    targets = stack_obj.targets\n    if targets is not None:\n        card.chosen_targets = targets  # type: ignore[attr-defined]\n\n    card.on_resolve(game)\n\n    if card.card_types & _PERMANENT_TYPES:\n        # Move from stack to battlefield via move_to_zone, which handles\n        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n    else:\n        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n\n\n# ------------------------------------------------------------------\n# Play land (special action — does not use the stack)","numLines":40,"startLine":400,"totalLines":513}}}
