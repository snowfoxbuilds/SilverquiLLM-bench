 when only colorless mana spent — nothing happens.\"\"\"\n        game = create_game()\n        p1 = game.players[0]\n        p2 = game.players[1]\n        card = TogetherAsOne()\n        set_board_state(game, 0, hand=[card], mana={ManaType.COLORLESS: 6})\n        from engine.casting import cast_spell as _cast\n        from engine.player import DeterministicPlayer\n        p1._script.appendleft(p2)   # target player\n        p1._script.appendleft(p2)   # any target (damage)\n        game.active_player_index = 0\n        game.phase = __import__('engine.types', fromlist=['Phase']).Phase.PRECOMBAT_MAIN\n        game.step = None\n        _cast(game, p1, card)\n        # resolve\n        from test_utils import _resolve_top_of_stack\n        _resolve_top_of_stack(game)\n        assert p2.life == 20  # 0 damage\n        assert p1.life == 20  # 0 life gain\n\n    def test_x_two_two_colors(self) -> None:\n        \"\"\"X=2 when 2 colors spent.\"\"\"\n        game = create_game()\n        p1 = game.players[0]\n        p2 = game.players[1]\n        card = TogetherAsOne()\n        set_board_state(game, 0, hand=[card], mana={ManaType.WHITE: 3, ManaType.BLUE: 3})\n        from engine.casting import cast_spell as _cast\n        from engine.types import ManaCost\n        from engine.player import DeterministicPlayer\n        p1._script.appendleft(p2)  # target player for draw\n        p1._script.appendleft(p2)  # any target for damage\n        game.active_player_index = 0\n        from engine.types import Phase\n        game.phase = Phase.PRECOMBAT_MAIN\n        game.step = None\n        _cast(game, p1, card)\n        from test_utils import _resolve_top_of_stack\n        _resolve_top_of_stack(game)\n        assert p1.life == 22   # gained 2 life\n        assert p2.life == 18   # took 2 damage\n\n    def test_x_three_three_colors(self) -> None:\n        \"\"\"X=3 with 3 colors spent.\"\"\"\n        game = create_game()\n        p1 = game.players[0]\n        p2 = game.players[1]\n        card = TogetherAsOne()\n        set_board_state(game, 0, hand=[card], mana={ManaType.WHITE: 2, ManaType.BLUE: 2, ManaType.BLACK: 2})\n        from engine.player import DeterministicPlayer\n        p1._script.appendleft(p1)  # target player draws\n        p1._script.appendleft(p2)  # any target for damage\n        game.active_player_index = 0\n        from engine.types import Phase\n        game.phase = Phase.PRECOMBAT_MAIN\n        game.step = None\n        from engine.casting import cast_spell as _cast\n        _cast(game, p1, card)\n        # p1 hand should be empty after spell went to stack\n        from test_utils import _resolve_top_of_stack\n        _resolve_top_of_stack(game)\n        assert p1.life == 23   # gained 3 life\n        assert p2.life == 17   # took 3 damage\n        # p1 drew 3 cards\n        hand = p1.zones[Zone.HAND]\n        # hand was empty before draw; after: 3 cards\n        assert len(hand) == 3\n\n    def test_damage_to_creature(self) -> None:\n        \"\"\"Can deal damage to a creature target.\"\"\"\n        from engine.card import Creature\n        game = create_game()\n        p1 = game.players[0]\n        p2 = game.players[1]\n        bear = Creature(name=\"Bear\", base_power=2, base_toughness=2)\n        set_board_state(game, 1, battlefield=[bear])\n        card = TogetherAsOne()\n        set_board_state(game, 0, hand=[card], mana={ManaType.WHITE: 3, ManaType.GREEN: 3})\n        from engine.player import DeterministicPlayer\n        p1._script.appendleft(p2)   # target player\n        p1._script.appendleft(bear) # damage to creature\n        game.active_player_index = 0\n        from engine.types import Phase\n        game.phase = Phase.PRECOMBAT_MAIN\n        game.step = None\n        from engine.casting import cast_spell as _cast\n        _cast(game, p1, card)\n        from test_utils import _resolve_top_of_stack\n        _resolve_top_of_stack(game)\n        assert bear.damage_marked == 2  # X=2 damage to creature\n        as