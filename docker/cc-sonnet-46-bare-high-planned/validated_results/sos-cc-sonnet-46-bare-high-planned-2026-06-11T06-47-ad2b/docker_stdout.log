     \"attacks, you may cast target instant or sorcery card from your \"\n            \"graveyard without paying its mana cost. If that spell would be \"\n            \"put into your graveyard, exile it instead.\",\n        )\n        super().__init__(**kwargs)\n\n    def cost_reduction(self, game: \"GameState\") -> int:\n        \"\"\"Costs {1} less per instant/sorcery in controller's graveyard.\"\"\"\n        controller = self.controller\n        if controller is None:\n            return 0\n        graveyard = game.get_graveyard(controller)\n        count = sum(\n            1 for card in graveyard.get_all()\n            if CardType.INSTANT in getattr(card, \"card_types\", set())\n            or CardType.SORCERY in getattr(card, \"card_types\", set())\n        )\n        return count\n\n    def register_triggers(self, game: \"GameState\") -> None:\n        \"\"\"Register attack trigger: may cast instant/sorcery from graveyard for free.\"\"\"\n        from engine.casting import cast_spell_free\n        from engine.events import AttacksTriggeredEvent\n        from engine.replacement_effects import ReplacementEffect\n        from engine.events import MoveToGraveyardReplacementEvent\n        from engine.triggers import TriggerRegistration\n\n        source = self\n        controller = getattr(self, \"controller\", None) or game.active_player\n\n        def _condition(game: Any, event: Any) -> bool:\n            return event.creature is source\n\n        def _effect(game: \"GameState\") -> None:\n            ctrl = getattr(source, \"controller\", None)\n            if ctrl is None:\n                return\n            graveyard = game.get_graveyard(ctrl)\n            legal = [\n                c for c in graveyard.get_all()\n                if CardType.INSTANT in getattr(c, \"card_types\", set())\n                or CardType.SORCERY in getattr(c, \"card_types\", set())\n            ]\n            if not legal:\n                return\n            # Prompt: \"may cast\" — if script is exhausted, skip\n            try:\n                chosen = ctrl.choose_card(legal, \"cast from graveyard for free?\")\n            except Exception:\n                return\n            if chosen is None:\n                return\n            if chosen not in legal:\n                return\n\n            # Register exile-instead replacement for this specific spell.\n            # It applies if the chosen card would go to the graveyard after resolving.\n            _register_exile_instead(game, ctrl, chosen)\n\n            try:\n                cast_spell_free(game, ctrl, chosen, Zone.GRAVEYARD)\n            except Exception:\n                # If free cast fails (e.g. no legal target), clean up replacement.\n                game.replacement_manager.unregister(chosen)\n\n        game.trigger_manager.register(\n            TriggerRegistration(\n                event_type=AttacksTriggeredEvent,\n                condition=_condition,\n                effect=_effect,\n                source=self,\n                controller=controller,\n            )\n        )\n\n\ndef _register_exile_instead(\n    game: Any, controller: Any, spell_card: Any\n) -> None:\n    \"\"\"Register a one-shot replacement: if spell_card goes to graveyard, exile it instead.\"\"\"\n    from engine.events import MoveToGraveyardReplacementEvent\n    from engine.replacement_effects import ReplacementEffect\n\n    def _condition(game: Any, event: Any) -> bool:\n        return event.card is spell_card\n\n    def _replacement(game: Any, event: Any) -> Any:\n        # Redirect to exile.\n        owner = getattr(spell_card, \"owner\", controller)\n        if owner is not None:\n            # Move from current zone to exile (manually — replacement sets destination)\n            event.destination = \"exile\"\n        return event\n\n    game.replacement_manager.register(\n        ReplacementEffect(\n            event_type=MoveToGraveyardReplacementEvent,\n            source=spell_card,\n            condition=_condition,\n            replacement=_replacement,\n            controller=controller,\n        )\n    )\n","structuredPatch":[{"oldStart":2,"oldLines":15,"newStart":2,"newLines":140,"lines":[" "," from __future__ import annotations"," ","-from engine.card import CardImpl","+from typing import TYPE_CHECKING, Any"," ","-from typing import TYPE_CHECKING","+from engine.card import Creature","+from engine.types import CardType, Keyword, ManaCost, Supertype, Zone"," "," if TYPE_CHECKING:","     from engine.game_state import GameState"," "," ","-class TheDawningArchaic(CardImpl):","-    \"\"\"TODO: Implement The Dawning Archaic.\"\"\"","+class TheDawningArchaic(Creature):","+    \"\"\"The Dawning Archaic — {10} — 7/7 Legendary Avatar."," ","-    pass","+    This spell costs {1} less to cast for each instant and sorcery card","+    in your graveyard.","+    Reach","+    Whenever The Dawning Archaic attacks, you may cast target instant or","+    sorcery card from your graveyard without paying its mana cost. If that","+    spell would be put into your graveyard, exile it instead.","+","+    SOS collector number 1.","+    \"\"\"","+","+    def __init__(self, **kwargs: Any) -> None:","+        kwargs.setdefault(\"name\", \"The Dawning Archaic\")","+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{10}\"))","+        kwargs.setdefault(\"subtypes\", {\"Avatar\"})","+        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})","+        kwargs.setdefault(\"base_power\", 7)","+        kwargs.setdefault(\"base_toughness\", 7)","+        kwargs.setdefault(\"keywords\", Keyword.REACH)","+        kwargs.setdefault(","+            \"rules_text\",","+            \"This spell costs {1} less to cast for each instant and sorcery \"","+            \"card in your graveyard.\\nReach\\nWhenever The Dawning Archaic \"","+            \"attacks, you may cast target instant or sorcery card from your \"","+            \"graveyard without paying its mana cost. If that spell would be \"","+            \"put into your graveyard, exile it instead.\",","+        )","+        super().__init__(**kwargs)","+","+    def cost_reduction(self, game: \"GameState\") -> int:","+        \"\"\"Costs {1} less per instant/sorcery in controller's graveyard.\"\"\"","+        controller = self.controller","+        if controller is None:","+            return 0","+        graveyard = game.get_graveyard(controller)","+        count = sum(","+            1 for card in graveyard.get_all()","+            if CardType.INSTANT in getattr(card, \"card_types\", set())","+            or CardType.SORCERY in getattr(card, \"card_types\", set())","+        )","+        return count","+","+    def register_triggers(self, game: \"GameState\") -> None:","+        \"\"\"Register attack trigger: may cast instant/sorcery from graveyard for free.\"\"\"","+        from engine.casting import cast_spell_free","+        from engine.events import AttacksTriggeredEvent","+        from engine.replacement_effects import ReplacementEffect","+        from engine.events import MoveToGraveyardReplacementEvent","+        from engine.triggers import TriggerRegistration","+","+        source = self","+        controller = getattr(self, \"controller\", None) or game.active_player","+","+        def _condition(game: Any, event: Any) -> bool:","+            return event.creature is source","+","+        def _effect(game: \"GameState\") -> None:","+            ctrl = getattr(source, \"controller\", None)","+            if ctrl is None:","+                return","+            graveyard = game.get_graveyard(ctrl)","+            legal = [","+                c for c in graveyard.get_all()","+                if CardType.INSTANT in getattr(c, \"card_types\", set())","+                or CardType.SORCERY in getattr(c, \"card_types\", set())","+            ]","+            if not legal:","+                return","+            # Prompt: \"may cast\" — if script is exhausted, skip","+            try:","+                chosen = ctrl.choose_card(legal, \"cast from graveyard for free?\")","+            except Exception:","+                return","+            if chosen is None:","+                return","+            if chosen not in legal:","+                return","+","+            # Register exile-instead replacement for this specific spell.","+            # It applies if the chosen card would go to the graveyard after resolving.","+            _register_exile_instead(game, ctrl, chosen)","+","+            try:","+                cast_spell_free(game, ctrl, chosen, Zone.GRAVEYARD)","+            except Exception:","+                # If free cast fails (e.g. no legal target), clean up replacement.","+                game.replacement_manager.unregister(chosen)","+","+        game.trigger_manager.register(","+            TriggerRegistration(","+                event_type=AttacksTriggeredEvent,","+                condition=_condition,","+                effect=_effect,","+                source=self,","+                controller=controller,","+            )","+        )","+","+","+def _register_exile_instead(","+    game: Any, controller: Any, spell_card: Any","+) -> None:","+    \"\"\"Register a one-shot replacement: if spell_card goes to graveyard, exile it instead.\"\"\"","+    from engine.events import MoveToGraveyardReplacementEvent","+    from engine.replacement_effects import ReplacementEffect","+","+    def _condition(game: Any, event: Any) -> bool:","+        return event.card is spell_card","+","+    def _replacement(game: Any, event: Any) -> Any:","+        # Redirect to exile.","+        owner = getattr(spell_card, \"owner\", controller)","+        if owner is not None:","+            # Move from current zone to exile (manually — replacement sets destination)","+            event.destination = \"exile\"","+        return event","+","+    game.replacement_manager.register(","+        ReplacementEffect(","+            event_type=MoveToGraveyardReplacementEvent,","+            source=spell_card,","+            condition=_condition,","+            replacement=_replacement,","+            controller=controller,","+        )","+    )"]}],"originalFile":"\"\"\"Card implementation for The Dawning Archaic.\"\"\"\n\nfrom __future__ import annotations\n\nfrom engine.card import CardImpl\n\nfrom typing import TYPE_CHECKING\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\nclass TheDawningArchaic(CardImpl):\n    \"\"\"TODO: Implement The Dawning Archaic.\"\"\"\n\n    pass\n","userModified":false}}
