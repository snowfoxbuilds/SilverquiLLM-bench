ataclass\n64\tclass DrawsCardTriggeredEvent(TriggeredEvent):\n65\t    player: Any = None\n66\t    card: Any = None\n67\t\n68\t\n69\t@dataclass\n70\tclass BeginningOfUpkeepTriggeredEvent(TriggeredEvent):\n71\t    pass\n72\t\n73\t\n74\t@dataclass\n75\tclass BeginningOfPrecombatMainTriggeredEvent(TriggeredEvent):\n76\t    pass\n77\t\n78\t\n79\t@dataclass\n80\tclass BeginningOfCombatTriggeredEvent(TriggeredEvent):\n81\t    pass\n82\t\n83\t\n84\t@dataclass\n85\tclass EndOfTurnTriggeredEvent(TriggeredEvent):\n86\t    pass\n87\t\n88\t\n89\t@dataclass\n90\tclass EndStepTriggeredEvent(TriggeredEvent):\n91\t    player: Any = None\n92\t\n93\t\n94\t@dataclass\n95\tclass CreatureDiesTriggeredEvent(TriggeredEvent):\n96\t    creature: Any = None\n97\t    controller: Any = None\n98\t    owner: Any = None\n99\t\n100\t\n101\t@dataclass\n102\tclass SpellCastTriggeredEvent(TriggeredEvent):\n103\t    spell: Any = None\n104\t    player: Any = None\n105\t    card: Any = None\n106\t    controller: Any = None\n107\t\n108\t\n109\t@dataclass\n110\tclass AttacksTriggeredEvent(TriggeredEvent):\n111\t    creature: Any = None\n112\t    attacker: Any = None\n113\t\n114\t\n115\t@dataclass\n116\tclass BlocksTriggeredEvent(TriggeredEvent):\n117\t    creature: Any = None\n118\t\n119\t\n120\t@dataclass\n121\tclass CounterAddedTriggeredEvent(TriggeredEvent):\n122\t    permanent: Any = None\n123\t    counter_type: Any = None\n124\t    amount: int = 0\n125\t\n126\t\n127\t# ---------------------------------------------------------------------------\n128\t# Replacement events\n129\t# ---------------------------------------------------------------------------\n130\t\n131\t@dataclass\n132\tclass ReplacementEvent:\n133\t    \"\"\"Base class for all replacement-effect events.\"\"\"\n134\t\n135\t\n136\t@dataclass\n137\tclass MoveToGraveyardReplacementEvent(ReplacementEvent):\n138\t    \"\"\"Any permanent moving to a graveyard.\n139\t\n140\t    Subclass this for specific causes (destruction, sacrifice, etc.).\n14