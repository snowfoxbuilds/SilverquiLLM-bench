     set_board_state(game, 0, graveyard=[])"," ","-        # No instant/sorcery in GY — trigger fires but choose_card not called","-        # (no cards to choose from); the effect returns early.","         declare_attackers(game, [\"The Dawning Archaic\"])","         from test_utils import _resolve_top_of_stack","         _resolve_top_of_stack(game)","-        # Nothing changed","         assert game.get_graveyard(p1).get_all() == []"," ","-    def test_exile_instead_applies_after_resolution(self) -> None:","-        \"\"\"Spell cast from GY via trigger goes to exile after resolving.\"\"\"","+    def test_decline_cast_keeps_spell_in_graveyard(self) -> None:","+        \"\"\"Declining the cast (choose_card returns None) leaves spell in GY.\"\"\"","         game = create_game()","         p1, p2 = game.players","         archaic = TheDawningArchaic()","         archaic.summoning_sick = False","+        inst = Instant(name=\"Inst\", mana_cost=ManaCost.parse(\"{2}\"))","+        _put_on_battlefield(game, 0, archaic)","+        set_board_state(game, 0, graveyard=[inst])"," ","-        class SimpleInstant(Instant):","-            def __init__(self, **kw):","-                kw.setdefault(\"name\", \"Simple\")","-                kw.setdefault(\"mana_cost\", ManaCost.parse(\"{1}\"))","-                super().__init__(**kw)","-            def on_resolve(self, g):","-                pass  # no effect","+        # Script None to decline","+        p1._script.appendleft(None)"," ","-        inst = SimpleInstant()","-        set_board_state(game, 0, battlefield=[archaic], graveyard=[inst])","-        p1._script.appendleft(inst)","-","         declare_attackers(game, [\"The Dawning Archaic\"])","         from test_utils import _resolve_top_of_stack","         _resolve_top_of_stack(game)"," ","-        assert game.get_exile(p1).contains(inst)","-        assert not game.get_graveyard(p1).contains(inst)","+        # Spell still in graveyard","+        assert game.get_graveyard(p1).contains(inst)"]}],"originalFile":"\"\"\"Tests for The Dawning Archaic (sos_1).\"\"\"\n\nfrom __future__ import annotations\n\nfrom cards.sos.sos_1.card_impl import TheDawningArchaic\nfrom engine.card import Creature, Instant, Sorcery\nfrom engine.types import CardType, Keyword, ManaCost, ManaType, Phase, Zone\nfrom test_utils import create_game, declare_attackers, set_board_state\n\n\nclass TestTheDawningArchaicProperties:\n    def test_name(self) -> None:\n        assert TheDawningArchaic().name == \"The Dawning Archaic\"\n\n    def test_stats(self) -> None:\n        c = TheDawningArchaic()\n        assert c.base_power == 7\n        assert c.base_toughness == 7\n\n    def test_reach(self) -> None:\n        assert Keyword.REACH in TheDawningArchaic().keywords\n\n\nclass TestCostReduction:\n    def test_reduction_counts_instants_and_sorceries(self) -> None:\n        game = create_game()\n        p1 = game.players[0]\n        archaic = TheDawningArchaic()\n        set_board_state(game, 0, battlefield=[archaic])\n        # Add 3 instants/sorceries to graveyard\n        a = Instant(name=\"A\", mana_cost=ManaCost.parse(\"{1}\"))\n        b = Sorcery(name=\"B\", mana_cost=ManaCost.parse(\"{2}\"))\n        c = Creature(name=\"C\", base_power=1, base_toughness=1)\n        set_board_state(game, 0, graveyard=[a, b, c])\n        assert archaic.cost_reduction(game) == 2  # only instant + sorcery\n\n    def test_no_reduction_empty_graveyard(self) -> None:\n        game = create_game()\n        p1 = game.players[0]\n        archaic = TheDawningArchaic()\n        set_board_state(game, 0, battlefield=[archaic])\n        set_board_state(game, 0, graveyard=[])\n        assert archaic.cost_reduction(game) == 0\n\n\nclass TestAttackTrigger:\n    def test_cast_instant_from_graveyard_on_attack(self) -> None:\n        \"\"\"When The Dawning Archaic attacks, cast instant from GY for free.\"\"\"\n        from engine.card import Instant\n        game = create_game()\n        p1, p2 = game.players\n\n        archaic = TheDawningArchaic()\n        archaic.summoning_sick = False\n        inst = Instant(name=\"MyInstant\", mana_cost=ManaCost.parse(\"{3}\"))\n\n        set_board_state(game, 0, battlefield=[archaic], graveyard=[inst])\n        game.players[1].life = 20\n\n        # Script: choose the instant from graveyard\n        p1._script.appendleft(inst)\n\n        declare_attackers(game, [\"The Dawning Archaic\"])\n\n        # Resolve the attack trigger (which put a StackObject on the stack)\n        from test_utils import _resolve_top_of_stack\n        _resolve_top_of_stack(game)\n\n        # Instant went to exile (exile-instead), not graveyard\n        exile = game.get_exile(p1)\n        graveyard = game.get_graveyard(p1)\n        assert exile.contains(inst)\n        assert not graveyard.contains(inst)\n\n    def test_empty_graveyard_trigger_still_fires_but_no_cast(self) -> None:\n        \"\"\"Trigger fires even with empty GY; no cast since no legal targets.\"\"\"\n        game = create_game()\n        p1, p2 = game.players\n        archaic = TheDawningArchaic()\n        archaic.summoning_sick = False\n        set_board_state(game, 0, battlefield=[archaic], graveyard=[])\n\n        # No instant/sorcery in GY — trigger fires but choose_card not called\n        # (no cards to choose from); the effect returns early.\n        declare_attackers(game, [\"The Dawning Archaic\"])\n        from test_utils import _resolve_top_of_stack\n        _resolve_top_of_stack(game)\n        # Nothing changed\n        assert game.get_graveyard(p1).get_all() == []\n\n    def test_exile_instead_applies_after_resolution(self) -> None:\n        \"\"\"Spell cast from GY via trigger goes to exile after resolving.\"\"\"\n        game = create_game()\n        p1, p2 = game.players\n        archaic = TheDawningArchaic()\n        archaic.summoning_sick = False\n\n        class SimpleInstant(Instant):\n            def __init__(self, **kw):\n                kw.setdefault(\"name\", \"Simple\")\n                kw.setdefault(\"mana_cost\", ManaCost.parse(\"{1}\"))\n                super().__init__(**kw)\n            def on_resolve(self, g):\n                pass  # no effect\n\n        inst = SimpleInstant()\n        set_board_state(game, 0, battlefield=[archaic], graveyard=[inst])\n        p1._script.appendleft(inst)\n\n        declare_attackers(game, [\"The Dawning Archaic\"])\n        from test_utils import _resolve_top_of_stack\n        _resolve_top_of_stack(game)\n\n        assert game.get_exile(p1).contains(inst)\n        assert not game.get_graveyard(p1).contains(inst)\n","userModified":false}}
