{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PqwwU74YoggU42iaiaXygG","type":"tool_result","content":"1\t\"\"\"Triggered abilities system — event-driven trigger registration and firing.\n2\t\n3\tProvides the core mechanism for registering triggered abilities and firing\n4\tevents that push matching triggers onto the stack:\n5\t\n6\t- :class:`TriggerRegistration` — dataclass describing a single trigger.\n7\t- :class:`TriggerManager` — central registry for triggers with APNAP-ordered\n8\t  event firing.\n9\t\n10\tEvent types live in :mod:`engine.events` as typed dataclasses.\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\tfrom dataclasses import dataclass, field\n16\tfrom typing import TYPE_CHECKING, Any, Callable\n17\t\n18\tfrom engine.events import TriggeredEvent\n19\tfrom engine.stack import StackObject\n20\t\n21\tif TYPE_CHECKING:\n22\t    from engine.game_state import GameState\n23\t    from engine.player import Player\n24\t\n25\t\n26\t@dataclass\n27\tclass TriggerRegistration:\n28\t    \"\"\"Describes a single triggered ability.\n29\t\n30\t    Attributes:\n31\t        event_type: The event class (or a base class) this trigger watches.\n32\t            The trigger fires for any fired event that is an instance of\n33\t            this class, including instances of subclasses.\n34\t        condition: Optional callable ``(game, event) -> bool`` that must\n35\t            return ``True`` for the trigger to fire.  ``None`` means the\n36\t            trigger always fires for its event type.\n37\t        effect: Callable ``(game) -> None`` executed when the trigger\n38\t            resolves (becomes the :attr:`StackObject.on_resolve` callback).\n39\t        source: The game object (card / permanent) that owns this trigger.\n40\t        controller: The player who controls the source at the time of\n41\t            registration.\n42\t    \"\"\"\n43\t\n44\t    event_type: type[TriggeredEvent]\n45\t    condition: Callable[..., bool] | None\n46\t    effect: Callable[..., None]\n47\t    source: Any\n48\t    controller: Player\n49\t\n50\t\n51\tclass TriggerManager:\n52\t    \"\"\"Central registry for triggered abilities.\n53\t\n54\t    Triggers are registered when a permanent enters the battlefield (or\n55\t    via other game actions) and unregistered when the source leaves.\n56\t\n57\t    :meth:`fire_event` checks all registered triggers of a matching\n58\t    event type, evaluates their conditions, and pushes matching triggers\n59\t    onto the game stack as :class:`StackObject` instances.  Triggers are\n60\t    ordered according to APNAP (Active Player, Non-Active Player):\n61\t\n62\t    * Active player's triggers are pushed first (end up on the bottom\n63\t      of the batch).\n64\t    * Non-active player's triggers are pushed second (end up on top).\n65\t    * Within the same player, triggers are pushed in registration order\n66\t      (controller would normally choose; for now we use registration\n67\t      order as a deterministic default).\n68\t    \"\"\"\n69\t\n70\t    def __init__(self) -> None:\n71\t        self._triggers: list[TriggerRegistration] = []\n72\t\n73\t    def register(self, trigger: TriggerRegistration) -> None:\n74\t        \"\"\"Register a triggered ability.\"\"\"\n75\t        self._triggers.append(trigger)\n76\t\n77\t    def unregister(self, source: Any) -> None:\n78\t        \"\"\"Remove all triggers registered by *source* (identity-based).\"\"\"\n79\t        self._triggers = [t for t in self._triggers if t.source is not source]\n80\t\n81\t    def fire_event(self, game: GameState, event: TriggeredEvent) -> None:\n82\t        \"\"\"Fire an event and push all matching triggers onto the stack.\n83\t\n84\t        Parameters:\n85\t            game: The current game state.\n86\t            event: The typed event object.  Triggers registered for the\n87\t                event's class or any of its parent classes will fire.\n88\t\n89\t        Matching triggers are pushed in APNAP order:\n90\t\n91\t        1. Active player's matching triggers (in registration order).\n92\t        2. Non-active player's matching triggers (in registration order).\n93\t        \"\"\"\n94\t        matching: list[TriggerRegistration] = []\n95\t        for trigger in self._triggers:\n96\t            if not isinstance(event, trigger.event_type):\n97\t                continue\n98\t            if trigger.condition is not None:\n99\t                if not trigger.condition(game, event):\n100\t                    continue\n101\t            matching.append(trigger)\n102\t\n103\t        if not matching:\n104\t            return\n105\t\n106\t        active_player = game.active_player\n107\t        active_triggers: list[TriggerRegistration] = []\n108\t        non_active_triggers: list[TriggerRegistration] = []\n109\t\n110\t        for trigger in matching:\n111\t            if trigger.controller is active_player:\n112\t                active_triggers.append(trigger)\n113\t            else:\n114\t                non_active_triggers.append(trigger)\n115\t\n116\t        ordered = active_triggers + non_active_triggers\n117\t\n118\t        for trigger in ordered:\n119\t            stack_obj = StackObject(\n120\t                source=trigger.source,\n121\t                controller=trigger.controller,\n122\t                on_resolve=trigger.effect,\n123\t            )\n124\t            game.stack.push(stack_obj)\n125\t\n126\t    def get_triggers(self) -> list[TriggerRegistration]:\n127\t        \"\"\"Return a shallow copy of all registered triggers.\"\"\"\n128\t        return list(self._triggers)\n129\t\n130\t    def get_triggers_for_source(self, source: Any) -> list[TriggerRegistration]:\n131\t        \"\"\"Return all triggers registered by *source* (identity-based).\"\"\"\n132\t        return [t for t in self._triggers if t.source is source]\n133\t\n134\t    def clear(self) -> None:\n135\t        \"\"\"Remove all registered triggers.\"\"\"\n136\t        self._triggers.clear()\n137\t"}]},"parent_tool_use_id":null,"session_id":"ecc45bba-5220-4378-9482-c0a0c3fff5e1","uuid":"f66de839-b6d6-4b90-967a-e958ef31a699","timestamp":"2026-06-11T06:48:10.159Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/triggers.py","content":"\"\"\"Triggered abilities system — event-driven trigger registration and firing.\n\nProvides the core mechanism for registering triggered abilities and firing\nevents that push matching triggers onto the stack:\n\n- :class:`TriggerRegistration` — dataclass describing a single trigger.\n- :class:`TriggerManager` — central registry for triggers with APNAP-ordered\n  event firing.\n\nEvent types live in :mod:`engine.events` as typed dataclasses.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom typing import TYPE_CHECKING, Any, Callable\n\nfrom engine.events import TriggeredEvent\nfrom engine.stack import StackObject\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n@dataclass\nclass TriggerRegistration:\n    \"\"\"Describes a single triggered ability.\n\n    Attributes:\n        event_type: The event class (or a base class) this trigger watches.\n            The trigger fires for any fired event that is an instance of\n            this class, including instances of subclasses.\n        condition: Optional callable ``(game, event) -> bool`` that must\n            return ``True`` for the trigger to fire.  ``None`` means the\n            trigger always fires for its event type.\n        effect: Callable ``(game) -> None`` executed when the trigger\n            resolves (becomes the :attr:`StackObject.on_resolve` callback).\n        source: The game object (card / permanent) that owns this trigger.\n        controller: The player who controls the source at the time of\n            registration.\n    \"\"\"\n\n    event_type: type[TriggeredEvent]\n    condition: Callable[..., bool] | None\n    effect: Callable[..., None]\n    source: Any\n    controller: Player\n\n\nclass TriggerManager:\n    \"\"\"Central registry for triggered abilities.\n\n    Triggers are registered when a permanent enters the battlefield (or\n    via other game actions) and unregistered when the source leaves.\n\n    :meth:`fire_event` checks all registered triggers of a matching\n    event type, evaluates their conditions, and pushes matching triggers\n    onto the game stack as :class:`StackObject` instances.  Triggers are\n    ordered according to APNAP (Active Player, Non-Active Player):\n\n    * Active player's triggers are pushed first (end up on the bottom\n      of the batch).\n    * Non-active player's triggers are pushed second (end up on top).\n    * Within the same player, triggers are pushed in registration order\n      (controller would normally choose; for now we use registration\n      order as a deterministic default).\n    \"\"\"\n\n    def __init__(self) -> None:\n        self._triggers: list[TriggerRegistration] = []\n\n    def register(self, trigger: TriggerRegistration) -> None:\n        \"\"\"Register a triggered ability.\"\"\"\n        self._triggers.append(trigger)\n\n    def unregister(self, source: Any) -> None:\n        \"\"\"Remove all triggers registered by *source* (identity-based).\"\"\"\n        self._triggers = [t for t in self._triggers if t.source is not source]\n\n    def fire_event(self, game: GameState, event: TriggeredEvent) -> None:\n        \"\"\"Fire an event and push all matching triggers onto the stack.\n\n        Parameters:\n            game: The current game state.\n            event: The typed event object.  Triggers registered for the\n                event's class or any of its parent classes will fire.\n\n        Matching triggers are pushed in APNAP order:\n\n        1. Active player's matching triggers (in registration order).\n        2. Non-active player's matching triggers (in registration order).\n        \"\"\"\n        matching: list[TriggerRegistration] = []\n        for trigger in self._triggers:\n            if not isinstance(event, trigger.event_type):\n                continue\n            if trigger.condition is not None:\n                if not trigger.condition(game, event):\n                    continue\n            matching.append(trigger)\n\n        if not matching:\n            return\n\n        active_player = game.active_player\n        active_triggers: list[TriggerRegistration] = []\n        non_active_triggers: list[TriggerRegistration] = []\n\n        for trigger in matching:\n            if trigger.controller is active_player:\n                active_triggers.append(trigger)\n            else:\n                non_active_triggers.append(trigger)\n\n        ordered = active_triggers + non_active_triggers\n\n        for trigger in ordered:\n            stack_obj = StackObject(\n                source=trigger.source,\n                controller=trigger.controller,\n                on_resolve=trigger.effect,\n            )\n            game.stack.push(stack_obj)\n\n    def get_triggers(self) -> list[TriggerRegistration]:\n        \"\"\"Return a shallow copy of all registered triggers.\"\"\"\n        return list(self._triggers)\n\n    def get_triggers_for_source(self, source: Any) -> list[TriggerRegistration]:\n        \"\"\"Return all triggers registered by *source* (identity-based).\"\"\"\n        return [t for t in self._triggers if t.source is source]\n\n    def clear(self) -> None:\n        \"\"\"Remove all registered triggers.\"\"\"\n        self._triggers.clear()\n","numLines":137,"startLine":1,"totalLines":137}}}
