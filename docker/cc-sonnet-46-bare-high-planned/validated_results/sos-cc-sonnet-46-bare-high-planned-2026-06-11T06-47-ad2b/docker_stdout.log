{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01B7TbQ1zxubXE4qTyffstpx","type":"tool_result","content":"130\t\n131\t# ------------------------------------------------------------------\n132\t# Cast spell\n133\t# ------------------------------------------------------------------\n134\t\n135\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n136\t    \"\"\"Cast *card* from *player*'s hand.\n137\t\n138\t    Pipeline\n139\t    --------\n140\t    1. **Timing check** — instants (and cards with flash) can be cast\n141\t       whenever the player has priority; everything else requires\n142\t       sorcery-speed timing.\n143\t    2. **can_cast** — ask the card whether it can legally be cast.\n144\t    3. **Hand check** — the card must be in the player's hand.\n145\t    4. **Move hand → stack zone** — remove the card from the hand and\n146\t       place it into the player's stack zone.\n147\t    5. **Choose targets** — if the card specifies targets (via\n148\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n149\t    6. **Mana check / payment** — the player's mana pool must be able to\n150\t       pay the card's mana cost.  If payment fails, the card is rolled\n151\t       back from the stack zone to the hand.\n152\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n153\t    8. **Push StackObject** — push a :class:`StackObject` whose\n154\t       ``on_resolve`` callback handles resolution.\n155\t\n156\t    Raises:\n157\t        CastingError: If any legality check fails.\n158\t    \"\"\"\n159\t    # 1. Timing\n160\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n161\t        raise CastingError(\n162\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n163\t        )\n164\t\n165\t    # 2. can_cast\n166\t    if not card.can_cast(game):\n167\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n168\t\n169\t    # 3. Hand check\n170\t    hand = game.get_hand(player)\n171\t    if not hand.contains(card):\n172\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n173\t\n174\t    # 4. Move card from hand to stack zone\n175\t    stack_zone = player.zones[Zone.STACK]\n176\t    hand.remove(card)\n177\t    stack_zone.add(card)\n178\t\n179\t    # Clear any stale colors_spent from a prior cast before new payment.\n180\t    if hasattr(card, \"colors_spent\"):\n181\t        del card.colors_spent\n182\t\n183\t    # 5. Choose targets\n184\t    target_specs = card.get_targets(game)\n185\t    chosen_targets: list[Any] = []\n186\t    if target_specs:\n187\t        for spec in target_specs:\n188\t            target = player.choose_target(target_specs, spec)\n189\t            # Validate against filter_fn if the spec provides one\n190\t            filter_fn = getattr(spec, \"filter_fn\", None)\n191\t            if filter_fn is not None and target is not None:\n192\t                if not filter_fn(target):\n193\t                    stack_zone.remove(card)\n194\t                    hand.add(card)\n195\t                    raise CastingError(\n196\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n197\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n198\t                    )\n199\t            chosen_targets.append(target)\n200\t\n201\t    # 5b. Protection check — reject targets that have protection from this\n202\t    #     spell (the T in DEBT).\n203\t    from engine.protection import has_protection_from\n204\t\n205\t    for target in chosen_targets:\n206\t        if has_protection_from(target, card):\n207\t            # Rollback: move card from stack zone back to hand\n208\t            stack_zone.remove(card)\n209\t            hand.add(card)\n210\t            raise CastingError(\n211\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n212\t            )\n213\t\n214\t    # Targets are stored on the StackObject (not the card) and passed\n215\t    # through the resolve pipeline via on_resolve(game, targets=...).\n216\t\n217\t    # 6. Mana check / payment (rollback on failure)\n218\t    # Ensure the card knows its controller so that cost_reduction() hooks\n219\t    # (e.g. Embercleave counting attacking creatures you control) see the\n220\t    # casting player, even for cards that were added to hand without an\n221\t    # explicit controller assignment.\n222\t    if card.controller is None:\n223\t        card.controller = player\n224\t    reduction = get_cost_reduction(game, card, player)\n225\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n226\t\n227\t    # Set restricted-mana context so the mana pool includes restricted mana\n228\t    # when paying for instants/sorceries (Great Hall of the Biblioplex).\n229\t    player.mana_pool._instant_sorcery_context = ("}]},"parent_tool_use_id":null,"session_id":"ecc45bba-5220-4378-9482-c0a0c3fff5e1","uuid":"41e8a8d0-f2af-49da-9c9c-a7a126abbe76","timestamp":"2026-06-11T07:25:06.363Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"\n# ------------------------------------------------------------------\n# Cast spell\n# ------------------------------------------------------------------\n\ndef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n    \"\"\"Cast *card* from *player*'s hand.\n\n    Pipeline\n    --------\n    1. **Timing check** — instants (and cards with flash) can be cast\n       whenever the player has priority; everything else requires\n       sorcery-speed timing.\n    2. **can_cast** — ask the card whether it can legally be cast.\n    3. **Hand check** — the card must be in the player's hand.\n    4. **Move hand → stack zone** — remove the card from the hand and\n       place it into the player's stack zone.\n    5. **Choose targets** — if the card specifies targets (via\n       :meth:`CardImpl.get_targets`), the player is asked to choose.\n    6. **Mana check / payment** — the player's mana pool must be able to\n       pay the card's mana cost.  If payment fails, the card is rolled\n       back from the stack zone to the hand.\n    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n    8. **Push StackObject** — push a :class:`StackObject` whose\n       ``on_resolve`` callback handles resolution.\n\n    Raises:\n        CastingError: If any legality check fails.\n    \"\"\"\n    # 1. Timing\n    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n        )\n\n    # 2. can_cast\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 3. Hand check\n    hand = game.get_hand(player)\n    if not hand.contains(card):\n        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n\n    # 4. Move card from hand to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    hand.remove(card)\n    stack_zone.add(card)\n\n    # Clear any stale colors_spent from a prior cast before new payment.\n    if hasattr(card, \"colors_spent\"):\n        del card.colors_spent\n\n    # 5. Choose targets\n    target_specs = card.get_targets(game)\n    chosen_targets: list[Any] = []\n    if target_specs:\n        for spec in target_specs:\n            target = player.choose_target(target_specs, spec)\n            # Validate against filter_fn if the spec provides one\n            filter_fn = getattr(spec, \"filter_fn\", None)\n            if filter_fn is not None and target is not None:\n                if not filter_fn(target):\n                    stack_zone.remove(card)\n                    hand.add(card)\n                    raise CastingError(\n                        f\"Cannot cast {card.name!r} — chosen target does not \"\n                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                    )\n            chosen_targets.append(target)\n\n    # 5b. Protection check — reject targets that have protection from this\n    #     spell (the T in DEBT).\n    from engine.protection import has_protection_from\n\n    for target in chosen_targets:\n        if has_protection_from(target, card):\n            # Rollback: move card from stack zone back to hand\n            stack_zone.remove(card)\n            hand.add(card)\n            raise CastingError(\n                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n            )\n\n    # Targets are stored on the StackObject (not the card) and passed\n    # through the resolve pipeline via on_resolve(game, targets=...).\n\n    # 6. Mana check / payment (rollback on failure)\n    # Ensure the card knows its controller so that cost_reduction() hooks\n    # (e.g. Embercleave counting attacking creatures you control) see the\n    # casting player, even for cards that were added to hand without an\n    # explicit controller assignment.\n    if card.controller is None:\n        card.controller = player\n    reduction = get_cost_reduction(game, card, player)\n    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n\n    # Set restricted-mana context so the mana pool includes restricted mana\n    # when paying for instants/sorceries (Great Hall of the Biblioplex).\n    player.mana_pool._instant_sorcery_context = (","numLines":100,"startLine":130,"totalLines":513}}}
