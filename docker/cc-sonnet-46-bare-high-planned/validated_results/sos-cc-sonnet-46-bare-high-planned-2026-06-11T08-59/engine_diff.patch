+    is_instant_or_sorcery = bool(card.card_types & {CardType.INSTANT, CardType.SORCERY})
+    saved_restricted: dict = {}
+    if is_instant_or_sorcery and player.mana_pool._restricted_is_mana:
+        saved_restricted = dict(player.mana_pool._restricted_is_mana)
+        for mt, amt in saved_restricted.items():
+            player.mana_pool._pool[mt] = player.mana_pool._pool.get(mt, 0) + amt
+        player.mana_pool._restricted_is_mana.clear()
+
     if not player.mana_pool.can_pay(effective_cost):
         # Rollback: move card from stack zone back to hand
         stack_zone.remove(card)
         hand.add(card)
+        # Restore restricted mana on rollback
+        if saved_restricted:
+            for mt, amt in saved_restricted.items():
+                player.mana_pool._pool[mt] -= amt
+            player.mana_pool._restricted_is_mana = saved_restricted
