+    Also aggregates reductions from the caster's battlefield permanents
+    that expose ``spell_cost_reduction(game, spell) -> int`` for
+    instant/sorcery spells (e.g. affinity granted by Witherbloom).
     """
     # Ensure card.controller is set so the hook can reference "you" / the
     # casting player even when the card was never explicitly assigned one.
     prev_controller = card.controller
     card.controller = controller
     raw = card.cost_reduction(game)
+
+    # Aggregate battlefield reductions (instant/sorcery only).
+    is_instant_or_sorcery = bool(
+        card.card_types & {CardType.INSTANT, CardType.SORCERY}
+    )
+    if is_instant_or_sorcery:
+        for permanent in game.get_battlefield(controller).get_all():
+            fn = getattr(permanent, "spell_cost_reduction", None)
+            if fn is not None and permanent is not card:
+                try:
+                    raw += fn(game, card)
+                except Exception:
+                    pass
+
     # Restore previous controller in case the caller doesn't want a
