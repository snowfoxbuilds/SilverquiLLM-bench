+        # Instant/sorcery: consult replacement effects before moving to graveyard.
+        # This supports effects like "if that spell would go to your graveyard,
+        # exile it instead" (e.g. Dawning Archaic trigger).
+        from engine.events import SpellMovesToGraveyardReplacementEvent
+        from engine.zones import _DESTINATION_ZONE_MAP
