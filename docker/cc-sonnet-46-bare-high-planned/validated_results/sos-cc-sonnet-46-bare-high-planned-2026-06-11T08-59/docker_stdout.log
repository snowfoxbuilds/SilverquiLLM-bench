{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QTdr5pgQvF4WkMta6x1vbU","type":"tool_result","content":"60\t        \"\"\"Return the number of objects on the stack.\"\"\"\n61\t        return len(self._items)\n62\t\n63\t    def is_empty(self) -> bool:\n64\t        \"\"\"Return ``True`` if the stack contains no objects.\"\"\"\n65\t        return len(self._items) == 0\n66\t\n67\t    def objects(self) -> list[StackObject]:\n68\t        \"\"\"Return all stack objects ordered from top to bottom.\"\"\"\n69\t        return list(reversed(self._items))\n70\t\n71\t\n72\tdef copy_spell(\n73\t    game: GameState,\n74\t    original: StackObject,\n75\t    controller: Player,\n76\t    new_targets: list[Any] | None = None,\n77\t) -> StackObject:\n78\t    \"\"\"Create a copy of a spell on the stack (for storm and similar effects).\n79\t\n80\t    Shallow-copies the source card so the copy has independent state\n81\t    (chosen_targets, etc.) while sharing class method bindings.  Binds\n82\t    on_resolve to call the copied card's on_resolve directly — no zone\n83\t    movement, which is correct for spell copies.\n84\t\n85\t    Args:\n86\t        game: The current game state.\n87\t        original: The StackObject being copied.\n88\t        controller: The player who controls the copy.\n89\t        new_targets: Optional replacement targets.  If ``None``, the\n90\t            original's target list is cloned.\n91\t\n92\t    Returns:\n93\t        A new StackObject representing the copy ready to be pushed.\n94\t    \"\"\"\n95\t    copied_card = copy.copy(original.source)\n96\t    copied_card.controller = controller\n97\t    copied_card.owner = getattr(original.source, \"owner\", controller)\n98\t\n99\t    targets = new_targets if new_targets is not None else list(original.targets)\n100\t\n101\t    copy_obj = StackObject(\n102\t        source=copied_card,\n103\t        controller=controller,\n104\t        targets=targets,\n105\t    )\n106\t\n107\t    def _copy_resolve(g: GameState) -> None:\n108\t        copied_card.chosen_targets = copy_obj.targets\n109\t        copied_card.on_resolve(g)\n110\t\n111\t    copy_obj.on_resolve = _copy_resolve\n112\t    return copy_obj\n113\t\n114\t\n115\tdef check_state_based_actions(game: GameState) -> None:\n116\t    \"\"\"Check and perform all state-based actions until the game state is stable.\n117\t\n118\t    This is a convenience wrapper around\n119\t    :func:`engine.state_based_actions.resolve_state_based_actions` that"}]},"parent_tool_use_id":null,"session_id":"d92b6c43-7322-4b8d-bfe2-1d1f7f4c24eb","uuid":"a72e8b67-035d-4406-8bf7-6ceb766ee88c","timestamp":"2026-06-11T09:20:14.709Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/stack.py","content":"        \"\"\"Return the number of objects on the stack.\"\"\"\n        return len(self._items)\n\n    def is_empty(self) -> bool:\n        \"\"\"Return ``True`` if the stack contains no objects.\"\"\"\n        return len(self._items) == 0\n\n    def objects(self) -> list[StackObject]:\n        \"\"\"Return all stack objects ordered from top to bottom.\"\"\"\n        return list(reversed(self._items))\n\n\ndef copy_spell(\n    game: GameState,\n    original: StackObject,\n    controller: Player,\n    new_targets: list[Any] | None = None,\n) -> StackObject:\n    \"\"\"Create a copy of a spell on the stack (for storm and similar effects).\n\n    Shallow-copies the source card so the copy has independent state\n    (chosen_targets, etc.) while sharing class method bindings.  Binds\n    on_resolve to call the copied card's on_resolve directly — no zone\n    movement, which is correct for spell copies.\n\n    Args:\n        game: The current game state.\n        original: The StackObject being copied.\n        controller: The player who controls the copy.\n        new_targets: Optional replacement targets.  If ``None``, the\n            original's target list is cloned.\n\n    Returns:\n        A new StackObject representing the copy ready to be pushed.\n    \"\"\"\n    copied_card = copy.copy(original.source)\n    copied_card.controller = controller\n    copied_card.owner = getattr(original.source, \"owner\", controller)\n\n    targets = new_targets if new_targets is not None else list(original.targets)\n\n    copy_obj = StackObject(\n        source=copied_card,\n        controller=controller,\n        targets=targets,\n    )\n\n    def _copy_resolve(g: GameState) -> None:\n        copied_card.chosen_targets = copy_obj.targets\n        copied_card.on_resolve(g)\n\n    copy_obj.on_resolve = _copy_resolve\n    return copy_obj\n\n\ndef check_state_based_actions(game: GameState) -> None:\n    \"\"\"Check and perform all state-based actions until the game state is stable.\n\n    This is a convenience wrapper around\n    :func:`engine.state_based_actions.resolve_state_based_actions` that","numLines":60,"startLine":60,"totalLines":228}}}
