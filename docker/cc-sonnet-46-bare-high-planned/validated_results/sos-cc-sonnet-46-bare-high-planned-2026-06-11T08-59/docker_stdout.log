{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Lqppd1ApRejuNP7xyPhcmV","type":"tool_result","content":"270\t    def _on_resolve(g: GameState) -> None:\n271\t        _resolve_spell(g, card, player, stack_obj)\n272\t\n273\t    stack_obj.on_resolve = _on_resolve\n274\t    game.stack.push(stack_obj)\n275\t\n276\t    # Fire SpellCastTriggeredEvent after spell is on the stack.\n277\t    # Copies made by copy_spell do NOT go through cast_spell, so they\n278\t    # correctly do not re-fire this event.\n279\t    from engine.events import SpellCastTriggeredEvent\n280\t    game.trigger_manager.fire_event(\n281\t        game,\n282\t        SpellCastTriggeredEvent(spell=stack_obj, card=card, controller=player),\n283\t    )\n284\t\n285\t\n286\t# ------------------------------------------------------------------\n287\t# Cast spell without paying mana cost (free-cast from any zone)\n288\t# ------------------------------------------------------------------\n289\t\n290\t\n291\tdef cast_spell_free(\n292\t    game: GameState,\n293\t    player: Player,\n294\t    card: CardImpl,\n295\t    from_zone: Zone,\n296\t) -> None:\n297\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n298\t\n299\t    This is used by effects that allow casting from zones other than hand\n300\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n301\t    or cascade.\n302\t\n303\t    Pipeline\n304\t    --------\n305\t    1. **can_cast** — ask the card whether it can legally be cast (same\n306\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n307\t    2. Move *card* from *from_zone* to the stack zone.\n308\t    3. Choose targets (if applicable) with validation and protection check.\n309\t    4. Call ``on_cast`` hook.\n310\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n311\t       resolution normally (permanents → battlefield, non-permanents →\n312\t       graveyard).\n313\t\n314\t    No timing check or mana payment is performed.  The spell goes on the\n315\t    stack and can be responded to normally (e.g. countered).\n316\t\n317\t    If targeting or other post-move checks fail, the card is rolled back\n318\t    to its source zone.\n319\t\n320\t    Parameters:\n321\t        game: The current game state.\n322\t        player: The player casting the spell.\n323\t        card: The card to cast.\n324\t        from_zone: The zone the card is currently in.\n325\t\n326\t    Raises:\n327\t        CastingError: If the card cannot be found in *from_zone* or\n328\t            legality checks fail.\n329\t    \"\"\"\n330\t    from engine.zones import move_to_zone\n331\t\n332\t    # Ensure controller is set\n333\t    card.controller = player\n334\t    if card.owner is None:\n335\t        card.owner = player\n336\t\n337\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n338\t    if not card.can_cast(game):\n339\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n340\t\n341\t    # 2. Locate card in source zone\n342\t    source_zone_container = player.zones[from_zone]\n343\t    if not source_zone_container.contains(card):\n344\t        # Try to find the card in any player's zone\n345\t        source_zone_container = None\n346\t        for p in game.players:\n347\t            z = p.zones[from_zone]\n348\t            if z.contains(card):\n349\t                source_zone_container = z"}]},"parent_tool_use_id":null,"session_id":"d92b6c43-7322-4b8d-bfe2-1d1f7f4c24eb","uuid":"a00c48fe-4aaa-4f56-b9fc-74c8bbffbbd0","timestamp":"2026-06-11T09:20:14.222Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n    # Fire SpellCastTriggeredEvent after spell is on the stack.\n    # Copies made by copy_spell do NOT go through cast_spell, so they\n    # correctly do not re-fire this event.\n    from engine.events import SpellCastTriggeredEvent\n    game.trigger_manager.fire_event(\n        game,\n        SpellCastTriggeredEvent(spell=stack_obj, card=card, controller=player),\n    )\n\n\n# ------------------------------------------------------------------\n# Cast spell without paying mana cost (free-cast from any zone)\n# ------------------------------------------------------------------\n\n\ndef cast_spell_free(\n    game: GameState,\n    player: Player,\n    card: CardImpl,\n    from_zone: Zone,\n) -> None:\n    \"\"\"Cast *card* without paying its mana cost, using the stack.\n\n    This is used by effects that allow casting from zones other than hand\n    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n    or cascade.\n\n    Pipeline\n    --------\n    1. **can_cast** — ask the card whether it can legally be cast (same\n       legality as :func:`cast_spell`, minus mana/timing constraints).\n    2. Move *card* from *from_zone* to the stack zone.\n    3. Choose targets (if applicable) with validation and protection check.\n    4. Call ``on_cast`` hook.\n    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n       resolution normally (permanents → battlefield, non-permanents →\n       graveyard).\n\n    No timing check or mana payment is performed.  The spell goes on the\n    stack and can be responded to normally (e.g. countered).\n\n    If targeting or other post-move checks fail, the card is rolled back\n    to its source zone.\n\n    Parameters:\n        game: The current game state.\n        player: The player casting the spell.\n        card: The card to cast.\n        from_zone: The zone the card is currently in.\n\n    Raises:\n        CastingError: If the card cannot be found in *from_zone* or\n            legality checks fail.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Ensure controller is set\n    card.controller = player\n    if card.owner is None:\n        card.owner = player\n\n    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 2. Locate card in source zone\n    source_zone_container = player.zones[from_zone]\n    if not source_zone_container.contains(card):\n        # Try to find the card in any player's zone\n        source_zone_container = None\n        for p in game.players:\n            z = p.zones[from_zone]\n            if z.contains(card):\n                source_zone_container = z","numLines":80,"startLine":270,"totalLines":542}}}
