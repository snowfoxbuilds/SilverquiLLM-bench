{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DDjPJYaKD23CR7Ke8m4unZ","type":"tool_result","content":"130\t\n131\t    # ------------------------------------------------------------------\n132\t    # Phase/step progression\n133\t    # ------------------------------------------------------------------\n134\t\n135\t    def advance_phase(self) -> None:\n136\t        \"\"\"Advance to the next phase/step in MTG turn order.\n137\t\n138\t        At the end of CLEANUP, the turn number is incremented and the\n139\t        active player swaps (2-player assumption).  Mana pools are\n140\t        emptied on every transition.\n141\t        \"\"\"\n142\t        current = (self.phase, self.step)\n143\t        idx = _TURN_SEQUENCE.index(current)\n144\t\n145\t        if idx + 1 < len(_TURN_SEQUENCE):\n146\t            # Move to next phase/step within the same turn.\n147\t            next_phase, next_step = _TURN_SEQUENCE[idx + 1]\n148\t            self.phase = next_phase\n149\t            self.step = next_step\n150\t        else:\n151\t            # End of turn — wrap around.\n152\t            self.turn_number += 1\n153\t            if self.extra_turns:\n154\t                # ENGINE LIMITATION: Extra turns queue (FIFO). Pop the\n155\t                # next player seat index; that player gets the next turn.\n156\t                # Normal rotation is NOT advanced — extra turns are\n157\t                # inserted before the normal next turn.\n158\t                self.active_player_index = self.extra_turns.pop(0)\n159\t            else:\n160\t                next_idx = self._normal_next_index\n161\t                next_player = self.players[next_idx]\n162\t                skip = getattr(next_player, \"skip_turns\", 0)\n163\t                if skip > 0:\n164\t                    # This player's turn is skipped — current active player\n165\t                    # takes another turn (deliberate limitation: 2-player only).\n166\t                    next_player.skip_turns = skip - 1\n167\t                    # active_player_index stays the same; _normal_next_index\n168\t                    # keeps pointing at next_player so they play after skips end.\n169\t                else:\n170\t                    self.active_player_index = next_idx\n171\t                    self._normal_next_index = 1 - self._normal_next_index\n172\t            self.priority_player_index = self.active_player_index\n173\t            self.phase = _TURN_SEQUENCE[0][0]\n174\t            self.step = _TURN_SEQUENCE[0][1]\n175\t\n176\t        self.empty_mana_pools()\n177\t\n178\t        # Fire BeginningOfPrecombatMainTriggeredEvent when entering the\n179\t        # precombat main phase so mana added by handlers survives into the\n180\t        # main phase (the pool was just emptied above).\n181\t        if self.phase == Phase.PRECOMBAT_MAIN:\n182\t            from engine.events import BeginningOfPrecombatMainTriggeredEvent\n183\t            self.trigger_manager.fire_event(\n184\t                self, BeginningOfPrecombatMainTriggeredEvent()\n185\t            )\n186\t\n187\t    def empty_mana_pools(self) -> None:\n188\t        \"\"\"Empty all players' mana pools — called on each phase/step transition.\"\"\"\n189\t        for player in self.players:\n190\t            player.mana_pool.empty()\n191\t"}]},"parent_tool_use_id":null,"session_id":"d92b6c43-7322-4b8d-bfe2-1d1f7f4c24eb","uuid":"5bad47ed-a97f-473e-9e6b-dd64131cd1a0","timestamp":"2026-06-11T09:33:12.658Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/game_state.py","content":"\n    # ------------------------------------------------------------------\n    # Phase/step progression\n    # ------------------------------------------------------------------\n\n    def advance_phase(self) -> None:\n        \"\"\"Advance to the next phase/step in MTG turn order.\n\n        At the end of CLEANUP, the turn number is incremented and the\n        active player swaps (2-player assumption).  Mana pools are\n        emptied on every transition.\n        \"\"\"\n        current = (self.phase, self.step)\n        idx = _TURN_SEQUENCE.index(current)\n\n        if idx + 1 < len(_TURN_SEQUENCE):\n            # Move to next phase/step within the same turn.\n            next_phase, next_step = _TURN_SEQUENCE[idx + 1]\n            self.phase = next_phase\n            self.step = next_step\n        else:\n            # End of turn — wrap around.\n            self.turn_number += 1\n            if self.extra_turns:\n                # ENGINE LIMITATION: Extra turns queue (FIFO). Pop the\n                # next player seat index; that player gets the next turn.\n                # Normal rotation is NOT advanced — extra turns are\n                # inserted before the normal next turn.\n                self.active_player_index = self.extra_turns.pop(0)\n            else:\n                next_idx = self._normal_next_index\n                next_player = self.players[next_idx]\n                skip = getattr(next_player, \"skip_turns\", 0)\n                if skip > 0:\n                    # This player's turn is skipped — current active player\n                    # takes another turn (deliberate limitation: 2-player only).\n                    next_player.skip_turns = skip - 1\n                    # active_player_index stays the same; _normal_next_index\n                    # keeps pointing at next_player so they play after skips end.\n                else:\n                    self.active_player_index = next_idx\n                    self._normal_next_index = 1 - self._normal_next_index\n            self.priority_player_index = self.active_player_index\n            self.phase = _TURN_SEQUENCE[0][0]\n            self.step = _TURN_SEQUENCE[0][1]\n\n        self.empty_mana_pools()\n\n        # Fire BeginningOfPrecombatMainTriggeredEvent when entering the\n        # precombat main phase so mana added by handlers survives into the\n        # main phase (the pool was just emptied above).\n        if self.phase == Phase.PRECOMBAT_MAIN:\n            from engine.events import BeginningOfPrecombatMainTriggeredEvent\n            self.trigger_manager.fire_event(\n                self, BeginningOfPrecombatMainTriggeredEvent()\n            )\n\n    def empty_mana_pools(self) -> None:\n        \"\"\"Empty all players' mana pools — called on each phase/step transition.\"\"\"\n        for player in self.players:\n            player.mana_pool.empty()\n","numLines":62,"startLine":130,"totalLines":191}}}
