{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01S37o9mSofLo6Cc8NX9DqzY","type":"tool_result","content":"1\t\"\"\"Card implementation for The Dawning Archaic.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.types import CardType, Keyword, ManaCost, Supertype, Zone\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t\n13\t\n14\tclass TheDawningArchaic(Creature):\n15\t    \"\"\"The Dawning Archaic — {10} — 7/7 — Legendary Avatar.\n16\t\n17\t    This spell costs {1} less to cast for each instant and sorcery card\n18\t    in your graveyard.\n19\t    Reach\n20\t    Whenever The Dawning Archaic attacks, you may cast target instant or\n21\t    sorcery card from your graveyard without paying its mana cost. If that\n22\t    spell would be put into your graveyard, exile it instead.\n23\t\n24\t    SOS collector number 1.\n25\t    \"\"\"\n26\t\n27\t    def __init__(self, **kwargs: Any) -> None:\n28\t        kwargs.setdefault(\"name\", \"The Dawning Archaic\")\n29\t        kwargs.setdefault(\"mana_cost\", ManaCost(generic=10))\n30\t        kwargs.setdefault(\"base_power\", 7)\n31\t        kwargs.setdefault(\"base_toughness\", 7)\n32\t        kwargs.setdefault(\"keywords\", Keyword.REACH)\n33\t        kwargs.setdefault(\"subtypes\", {\"Avatar\"})\n34\t        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n35\t        kwargs.setdefault(\n36\t            \"rules_text\",\n37\t            \"This spell costs {1} less to cast for each instant and sorcery \"\n38\t            \"card in your graveyard.\\nReach\\nWhenever The Dawning Archaic attacks, \"\n39\t            \"you may cast target instant or sorcery card from your graveyard without \"\n40\t            \"paying its mana cost. If that spell would be put into your graveyard, \"\n41\t            \"exile it instead.\",\n42\t        )\n43\t        super().__init__(**kwargs)\n44\t\n45\t    def cost_reduction(self, game: \"GameState\") -> int:\n46\t        \"\"\"Costs {1} less for each instant or sorcery in your graveyard.\"\"\"\n47\t        controller = self.controller\n48\t        if controller is None:\n49\t            return 0\n50\t        graveyard = game.get_graveyard(controller)\n51\t        return sum(\n52\t            1\n53\t            for c in graveyard.get_all()\n54\t            if CardType.INSTANT in getattr(c, \"card_types\", set())\n55\t            or CardType.SORCERY in getattr(c, \"card_types\", set())\n56\t        )\n57\t\n58\t    def register_triggers(self, game: \"GameState\") -> None:\n59\t        \"\"\"Register the attack trigger for graveyard free-cast.\"\"\"\n60\t        from engine.events import AttacksTriggeredEvent\n61\t        from engine.triggers import TriggerRegistration\n62\t\n63\t        source = self\n64\t        controller = getattr(self, \"controller\", None) or game.active_player\n65\t\n66\t        def _condition(g: Any, event: Any) -> bool:\n67\t            return event.creature is source\n68\t\n69\t        def _effect(g: \"GameState\") -> None:\n70\t            ctrl = getattr(source, \"controller\", None)\n71\t            if ctrl is None:\n72\t                return\n73\t\n74\t            graveyard = g.get_graveyard(ctrl)\n75\t            castable = [\n76\t                c\n77\t                for c in graveyard.get_all()\n78\t                if CardType.INSTANT in getattr(c, \"card_types\", set())\n79\t                or CardType.SORCERY in getattr(c, \"card_types\", set())\n80\t            ]\n81\t\n82\t            if not castable:\n83\t                return\n84\t\n85\t            # Auto-select if only one legal target; otherwise prompt player.\n86\t            if len(castable) == 1:\n87\t                chosen = castable[0]\n88\t                # Still let player opt in via \"may\"\n89\t                try:\n90\t                    if not ctrl.choose_yes_no(\n91\t                        f\"Cast {getattr(chosen, 'name', 'card')} from graveyard for free?\"\n92\t                    ):\n93\t                        return\n94\t                except Exception:\n95\t                    return\n96\t            else:\n97\t                # Player chooses; None means decline\n98\t                try:\n99\t                    if not ctrl.choose_yes_no(\"Cast an instant/sorcery from graveyard?\"):\n100\t                        return\n101\t                    chosen = ctrl.choose_card(castable, \"Choose instant/sorcery to cast\")\n102\t                except Exception:\n103\t                    return\n104\t\n105\t            if chosen is None:\n106\t                return\n107\t\n108\t            # Register exile-instead replacement before casting.\n109\t            _register_exile_replacement(g, chosen, source)\n110\t\n111\t            from engine.casting import cast_spell_free\n112\t            try:\n113\t                cast_spell_free(g, ctrl, chosen, Zone.GRAVEYARD)\n114\t            except Exception:\n115\t                pass\n116\t\n117\t        game.trigger_manager.register(\n118\t            TriggerRegistration(\n119\t                event_type=AttacksTriggeredEvent,\n120\t                condition=_condition,\n121\t                effect=_effect,\n122\t                source=self,\n123\t                controller=controller,\n124\t            )\n125\t        )\n126\t\n127\t\n128\tdef _register_exile_replacement(\n129\t    game: \"GameState\", spell: Any, source: Any\n130\t) -> None:\n131\t    \"\"\"Register a one-shot replacement: exile *spell* instead of going to graveyard.\"\"\"\n132\t    from engine.events import SpellMovesToGraveyardReplacementEvent\n133\t    from engine.replacement_effects import ReplacementEffect\n134\t\n135\t    # Deliberate limitation: uses SpellMovesToGraveyardReplacementEvent so only\n136\t    # non-permanent spells resolving from the stack are intercepted.\n137\t    active = [True]  # one-shot flag\n138\t\n139\t    def _condition(g: Any, event: Any) -> bool:\n140\t        return active[0] and event.spell is spell\n141\t\n142\t    def _replacement(g: Any, event: Any) -> Any:\n143\t        active[0] = False\n144\t        event.destination = \"exile\"\n145\t        return event\n146\t\n147\t    game.replacement_manager.register(\n148\t        ReplacementEffect(\n149\t            event_type=SpellMovesToGraveyardReplacementEvent,\n150\t            source=source,\n151\t            condition=_condition,\n152\t            replacement=_replacement,\n153\t            controller=getattr(source, \"controller\", None),\n154\t        )\n155\t    )\n156\t"}]},"parent_tool_use_id":null,"session_id":"d92b6c43-7322-4b8d-bfe2-1d1f7f4c24eb","uuid":"3fc00881-f5e5-4681-a9e8-c9d6ce05adb0","timestamp":"2026-06-11T09:20:19.663Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/sos/sos_1/card_impl.py","content":"\"\"\"Card implementation for The Dawning Archaic.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import Creature\nfrom engine.types import CardType, Keyword, ManaCost, Supertype, Zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\nclass TheDawningArchaic(Creature):\n    \"\"\"The Dawning Archaic — {10} — 7/7 — Legendary Avatar.\n\n    This spell costs {1} less to cast for each instant and sorcery card\n    in your graveyard.\n    Reach\n    Whenever The Dawning Archaic attacks, you may cast target instant or\n    sorcery card from your graveyard without paying its mana cost. If that\n    spell would be put into your graveyard, exile it instead.\n\n    SOS collector number 1.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"The Dawning Archaic\")\n        kwargs.setdefault(\"mana_cost\", ManaCost(generic=10))\n        kwargs.setdefault(\"base_power\", 7)\n        kwargs.setdefault(\"base_toughness\", 7)\n        kwargs.setdefault(\"keywords\", Keyword.REACH)\n        kwargs.setdefault(\"subtypes\", {\"Avatar\"})\n        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n        kwargs.setdefault(\n            \"rules_text\",\n            \"This spell costs {1} less to cast for each instant and sorcery \"\n            \"card in your graveyard.\\nReach\\nWhenever The Dawning Archaic attacks, \"\n            \"you may cast target instant or sorcery card from your graveyard without \"\n            \"paying its mana cost. If that spell would be put into your graveyard, \"\n            \"exile it instead.\",\n        )\n        super().__init__(**kwargs)\n\n    def cost_reduction(self, game: \"GameState\") -> int:\n        \"\"\"Costs {1} less for each instant or sorcery in your graveyard.\"\"\"\n        controller = self.controller\n        if controller is None:\n            return 0\n        graveyard = game.get_graveyard(controller)\n        return sum(\n            1\n            for c in graveyard.get_all()\n            if CardType.INSTANT in getattr(c, \"card_types\", set())\n            or CardType.SORCERY in getattr(c, \"card_types\", set())\n        )\n\n    def register_triggers(self, game: \"GameState\") -> None:\n        \"\"\"Register the attack trigger for graveyard free-cast.\"\"\"\n        from engine.events import AttacksTriggeredEvent\n        from engine.triggers import TriggerRegistration\n\n        source = self\n        controller = getattr(self, \"controller\", None) or game.active_player\n\n        def _condition(g: Any, event: Any) -> bool:\n            return event.creature is source\n\n        def _effect(g: \"GameState\") -> None:\n            ctrl = getattr(source, \"controller\", None)\n            if ctrl is None:\n                return\n\n            graveyard = g.get_graveyard(ctrl)\n            castable = [\n                c\n                for c in graveyard.get_all()\n                if CardType.INSTANT in getattr(c, \"card_types\", set())\n                or CardType.SORCERY in getattr(c, \"card_types\", set())\n            ]\n\n            if not castable:\n                return\n\n            # Auto-select if only one legal target; otherwise prompt player.\n            if len(castable) == 1:\n                chosen = castable[0]\n                # Still let player opt in via \"may\"\n                try:\n                    if not ctrl.choose_yes_no(\n                        f\"Cast {getattr(chosen, 'name', 'card')} from graveyard for free?\"\n                    ):\n                        return\n                except Exception:\n                    return\n            else:\n                # Player chooses; None means decline\n                try:\n                    if not ctrl.choose_yes_no(\"Cast an instant/sorcery from graveyard?\"):\n                        return\n                    chosen = ctrl.choose_card(castable, \"Choose instant/sorcery to cast\")\n                except Exception:\n                    return\n\n            if chosen is None:\n                return\n\n            # Register exile-instead replacement before casting.\n            _register_exile_replacement(g, chosen, source)\n\n            from engine.casting import cast_spell_free\n            try:\n                cast_spell_free(g, ctrl, chosen, Zone.GRAVEYARD)\n            except Exception:\n                pass\n\n        game.trigger_manager.register(\n            TriggerRegistration(\n                event_type=AttacksTriggeredEvent,\n                condition=_condition,\n                effect=_effect,\n                source=self,\n                controller=controller,\n            )\n        )\n\n\ndef _register_exile_replacement(\n    game: \"GameState\", spell: Any, source: Any\n) -> None:\n    \"\"\"Register a one-shot replacement: exile *spell* instead of going to graveyard.\"\"\"\n    from engine.events import SpellMovesToGraveyardReplacementEvent\n    from engine.replacement_effects import ReplacementEffect\n\n    # Deliberate limitation: uses SpellMovesToGraveyardReplacementEvent so only\n    # non-permanent spells resolving from the stack are intercepted.\n    active = [True]  # one-shot flag\n\n    def _condition(g: Any, event: Any) -> bool:\n        return active[0] and event.spell is spell\n\n    def _replacement(g: Any, event: Any) -> Any:\n        active[0] = False\n        event.destination = \"exile\"\n        return event\n\n    game.replacement_manager.register(\n        ReplacementEffect(\n            event_type=SpellMovesToGraveyardReplacementEvent,\n            source=source,\n            condition=_condition,\n            replacement=_replacement,\n            controller=getattr(source, \"controller\", None),\n        )\n    )\n","numLines":156,"startLine":1,"totalLines":156}}}
