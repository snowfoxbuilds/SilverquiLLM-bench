\"","+    \"\"\"Register: whenever controller casts IS spell while animated, +1/+0 until EOT.\"\"\"","     from engine.continuous_effects import (","         ContinuousEffect, DURATION_END_OF_TURN, Layer, SubLayer,","     )"]},{"oldStart":159,"oldLines":11,"newStart":186,"newLines":11,"lines":["     from engine.triggers import TriggerRegistration"," ","     def _condition(g: Any, event: Any) -> bool:","+        if not land._animated:","+            return False","         caster = getattr(event, \"controller\", None)","         if caster is not getattr(land, \"controller\", None):","             return False","-        if not land._animated:","-            return False","         card = getattr(event, \"card\", None)","         if card is None:","             return False"]},{"oldStart":172,"oldLines":7,"newStart":199,"newLines":7,"lines":["     def _effect(g: \"GameState\") -> None:","         if not land._animated:","             return","-        # Add a +1/+0 until-EOT continuous effect.","+","         def _apply(g2: \"GameState\") -> None:","             land.modified_power += 1"," "]}],"originalFile":"\"\"\"Card implementation for Great Hall of the Biblioplex.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import Land, ManaAbility, ActivatedAbility\nfrom engine.types import CardType, ManaCost, ManaType\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\nclass GreatHallOfTheBiblioplex(Land):\n    \"\"\"{T}: Add {C}.\n    {T}, Pay 1 life: Add one mana of any color. Spend this mana only to cast\n    an instant or sorcery spell.\n    {5}: If this land isn't a creature, it becomes a 2/4 Wizard creature with\n    \"Whenever you cast an instant or sorcery spell, this creature gets +1/+0\n    until end of turn.\" It's still a land.\n\n    SOS collector number 257.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"Great Hall of the Biblioplex\")\n        kwargs.setdefault(\n            \"rules_text\",\n            \"{T}: Add {C}.\\n{T}, Pay 1 life: Add one mana of any color. Spend \"\n            \"this mana only to cast an instant or sorcery spell.\\n{5}: If this \"\n            \"land isn't a creature, it becomes a 2/4 Wizard creature with \"\n            '\"Whenever you cast an instant or sorcery spell, this creature gets '\n            '+1/+0 until end of turn.\" It\\'s still a land.',\n        )\n        super().__init__(**kwargs)\n        # Creature stats (used after animation)\n        self._animated = False\n        self.base_power = 0\n        self.base_toughness = 0\n        self.modified_power = 0\n        self.modified_toughness = 0\n        self.damage_marked = 0\n        self.is_tapped = False\n        self.summoning_sick = False\n        self.is_attacking = False\n        self.is_blocking = False\n        self.plus_one_counters = 0\n        self.minus_one_counters = 0\n\n    # -- Mana abilities -------------------------------------------------------\n\n    def get_mana_abilities(self) -> list[ManaAbility]:\n        land = self\n\n        def _tap_colorless_cost(g: Any) -> bool:\n            if land.is_tapped:\n                return False\n            land.is_tapped = True\n            return True\n\n        def _tap_colorless_mana(g: Any) -> None:\n            ctrl = getattr(land, \"controller\", None)\n            if ctrl is not None:\n                ctrl.mana_pool.add(ManaType.COLORLESS, 1)\n\n        def _tap_life_cost(g: Any) -> bool:\n            ctrl = getattr(land, \"controller\", None)\n            if land.is_tapped or ctrl is None or ctrl.life < 1:\n                return False\n            land.is_tapped = True\n            ctrl.life -= 1\n            return True\n\n        def _tap_life_mana(g: Any) -> None:\n            \"\"\"Add one restricted colored mana (instant/sorcery only).\"\"\"\n            ctrl = getattr(land, \"controller\", None)\n            if ctrl is None:\n                return\n            # Player chooses color; script via choose_card or choose.\n            color_options = [\n                ManaType.WHITE, ManaType.BLUE, ManaType.BLACK,\n                ManaType.RED, ManaType.GREEN,\n            ]\n            try:\n                chosen = ctrl.choose_card(color_options, \"Choose a color for restricted mana\")\n            except Exception:\n                chosen = ManaType.COLORLESS\n            if chosen not in color_options:\n                chosen = color_options[0]\n            # add_restricted stores it separately from the main pool\n            ctrl.mana_pool.add_restricted(chosen, 1)\n\n        return [\n            ManaAbility(\n                cost=_tap_colorless_cost,\n                mana_produced=_tap_colorless_mana,\n                description=\"{T}: Add {C}.\",\n            ),\n            ManaAbility(\n                cost=_tap_life_cost,\n                mana_produced=_tap_life_mana,\n                description=\"{T}, Pay 1 life: Add one mana of any color (instant/sorcery only).\",\n            ),\n        ]\n\n    # -- Activated abilities --------------------------------------------------\n\n    def get_activated_abilities(self) -> list[ActivatedAbility]:\n        land = self\n\n        def _animate_cost(g: Any) -> bool:\n            ctrl = getattr(land, \"controller\", None)\n            if ctrl is None:\n                return False\n            if land._animated:\n                return False  # already a creature\n            if not ctrl.mana_pool.can_pay(ManaCost(generic=5)):\n                return False\n            ctrl.mana_pool.pay(ManaCost(generic=5))\n            return True\n\n        def _animate_effect(g: Any) -> None:\n            if land._animated:\n                return\n            land._animated = True\n            # Mutate in place: add Creature type, set base P/T, add Wizard subtype.\n            land.card_types = land.card_types | {CardType.CREATURE}\n            land.base_power = 2\n            land.base_toughness = 4\n            land.modified_power = 2\n            land.modified_toughness = 4\n            land.subtypes = getattr(land, \"subtypes\", set()) | {\"Wizard\"}\n            # Register pump trigger (E1: SpellCastTriggeredEvent)\n            _register_pump_trigger(g, land)\n\n        return [\n            ActivatedAbility(\n                cost=_animate_cost,\n                effect=_animate_effect,\n                description=\"{5}: Animate into 2/4 Wizard creature until end of game.\",\n            ),\n        ]\n\n    @property\n    def power(self) -> int:\n        return self.modified_power + self.plus_one_counters - self.minus_one_counters\n\n    @property\n    def toughness(self) -> int:\n        return self.modified_toughness + self.plus_one_counters - self.minus_one_counters\n\n\ndef _register_pump_trigger(game: \"GameState\", land: GreatHallOfTheBiblioplex) -> None:\n    \"\"\"Register: whenever controller casts instant/sorcery, +1/+0 until EOT.\"\"\"\n    from engine.continuous_effects import (\n        ContinuousEffect, DURATION_END_OF_TURN, Layer, SubLayer,\n    )\n    from engine.events import SpellCastTriggeredEvent\n    from engine.triggers import TriggerRegistration\n\n    def _condition(g: Any, event: Any) -> bool:\n        caster = getattr(event, \"controller\", None)\n        if caster is not getattr(land, \"controller\", None):\n            return False\n        if not land._animated:\n            return False\n        card = getattr(event, \"card\", None)\n        if card is None:\n            return False\n        return bool(getattr(card, \"card_types\", set()) & {CardType.INSTANT, CardType.SORCERY})\n\n    def _effect(g: \"GameState\") -> None:\n        if not land._animated:\n            return\n        # Add a +1/+0 until-EOT continuous effect.\n        def _apply(g2: \"GameState\") -> None:\n            land.modified_power += 1\n\n        eff = ContinuousEffect(\n            source=land,\n            layer=Layer.POWER_TOUGHNESS,\n            sublayer=SubLayer.MODIFY_PT,\n            apply=_apply,\n            duration=DURATION_END_OF_TURN,\n        )\n        g.effect_manager.add(eff)\n        g.effect_manager.apply_all(g)\n\n    game.trigger_manager.register(\n        TriggerRegistration(\n            event_type=SpellCastTriggeredEvent,\n            condition=_condition,\n            effect=_effect,\n            source=land,\n            controller=getattr(land, \"controller\", None),\n        )\n    )\n","userModified":false}}
