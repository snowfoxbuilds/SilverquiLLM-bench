 = 5: draw 5, deal 5, gain 5.\"\"\"","+    game = _game_with_library_cards(n=10)","+    p0, p1 = game.players"," ","+    card = TogetherAsOne()","     card.controller = p0","     card.colors_spent = [","         ManaType.WHITE, ManaType.BLUE, ManaType.BLACK, ManaType.RED, ManaType.GREEN","     ]","     card.chosen_targets = [p1, p1]"," ","+    p0.life = 20","+    p1.life = 20","     hand_before = len(game.get_hand(p1).get_all())","+","     card.on_resolve(game)"," ","     assert len(game.get_hand(p1).get_all()) == hand_before + 5","-    assert p1.life == 15  # took 5 damage","-    assert p0.life == 25  # gained 5 life","+    assert p1.life == 15","+    assert p0.life == 25"," "," "," def test_damage_to_creature():","     \"\"\"X damage can target a creature.\"\"\"","-    game, card = _make_game_with_card()","-    p0 = game.players[0]","-    p1 = game.players[1]","+    game = _game_with_library_cards()","+    p0, p1 = game.players"," ","     creature = Creature(name=\"Bear\", base_power=2, base_toughness=2)","     set_board_state(game, 1, battlefield=[creature])","-    p0.life = 20"," ","+    card = TogetherAsOne()","     card.controller = p0","     card.colors_spent = [ManaType.RED]  # X = 1","     card.chosen_targets = [p0, creature]"," ","+    p0.life = 20","     card.on_resolve(game)"," ","     assert creature.damage_marked == 1","-    assert p0.life == 21  # gained 1","+    assert p0.life == 21  # gained 1 life"]}],"originalFile":"\"\"\"Tests for Together as One (sos_4).\"\"\"\n\nfrom __future__ import annotations\n\nimport pytest\n\nfrom cards.sos.sos_4.card_impl import TogetherAsOne\nfrom engine.card import Creature\nfrom engine.types import ManaCost, ManaType, Phase, Zone\nfrom test_utils import create_game, set_board_state\n\n\ndef _make_game_with_card():\n    \"\"\"Set up a game where player 0 has Together as One in hand.\"\"\"\n    card = TogetherAsOne()\n    game = create_game()\n    set_board_state(game, 0, hand=[card])\n    game.phase = Phase.PRECOMBAT_MAIN\n    game.step = None\n    game.active_player_index = 0\n    return game, card\n\n\ndef test_x_equals_two_colors():\n    \"\"\"With two colors of mana spent, X = 2.\"\"\"\n    game, card = _make_game_with_card()\n    p0 = game.players[0]\n    p1 = game.players[1]\n    # Pay with WU (2 colors)\n    p0.mana_pool.add(ManaType.WHITE, 1)\n    p0.mana_pool.add(ManaType.BLUE, 5)\n    p0.life = 20\n    p1.life = 20\n\n    from engine.player import DeterministicPlayer\n    # Targets: p1 draws, p1 takes damage\n    p0._script.appendleft(p0)   # target player = p0 draws\n    p0._script.appendleft(p1)   # any target = p1 takes damage\n\n    from engine.casting import cast_spell\n    # Pay WU + generic to trigger 2-color converge\n    p0.mana_pool.pay(ManaCost(generic=5, pips={ManaType.WHITE: 1}),\n                     choices={ManaType.BLUE: 5})\n    # Manually set colors_spent to simulate 2-color payment\n    card.colors_spent = [ManaType.WHITE, ManaType.BLUE]\n    card.chosen_targets = [p0, p1]\n\n    # Directly resolve to verify behavior without full cast pipeline\n    from engine.game import deal_damage, draw_card\n\n    game.stack  # ensure game is set up\n    hand_before = len(game.get_hand(p0).get_all())\n\n    card.controller = p0\n    card.on_resolve(game)\n\n    # p0 drew 2 cards (x=2, colors=W,U)\n    assert len(game.get_hand(p0).get_all()) == hand_before + 2\n    # p1 took 2 damage\n    assert p1.life == 18\n    # p0 gained 2 life (started at 20, now 22, since damage doesn't hit p0)\n    assert p0.life == 22\n\n\ndef test_x_equals_zero_colorless():\n    \"\"\"With only colorless mana spent, X = 0 (all effects do nothing).\"\"\"\n    game, card = _make_game_with_card()\n    p0 = game.players[0]\n    p1 = game.players[1]\n    p0.life = 20\n    p1.life = 20\n\n    card.controller = p0\n    card.colors_spent = []  # no colors\n    card.chosen_targets = [p1, p0]\n\n    hand_before = len(game.get_hand(p0).get_all())\n    card.on_resolve(game)\n\n    # Nothing should change (X=0)\n    assert len(game.get_hand(p0).get_all()) == hand_before\n    assert p0.life == 20\n    assert p1.life == 20\n\n\ndef test_x_equals_five_max():\n    \"\"\"With five colors spent, X = 5.\"\"\"\n    game, card = _make_game_with_card()\n    p0 = game.players[0]\n    p1 = game.players[1]\n    p0.life = 20\n    p1.life = 20\n\n    card.controller = p0\n    card.colors_spent = [\n        ManaType.WHITE, ManaType.BLUE, ManaType.BLACK, ManaType.RED, ManaType.GREEN\n    ]\n    card.chosen_targets = [p1, p1]\n\n    hand_before = len(game.get_hand(p1).get_all())\n    card.on_resolve(game)\n\n    assert len(game.get_hand(p1).get_all()) == hand_before + 5\n    assert p1.life == 15  # took 5 damage\n    assert p0.life == 25  # gained 5 life\n\n\ndef test_damage_to_creature():\n    \"\"\"X damage can target a creature.\"\"\"\n    game, card = _make_game_with_card()\n    p0 = game.players[0]\n    p1 = game.players[1]\n\n    creature = Creature(name=\"Bear\", base_power=2, base_toughness=2)\n    set_board_state(game, 1, battlefield=[creature])\n    p0.life = 20\n\n    card.controller = p0\n    card.colors_spent = [ManaType.RED]  # X = 1\n    card.chosen_targets = [p0, creature]\n\n    card.on_resolve(game)\n\n    assert creature.damage_marked == 1\n    assert p0.life == 21  # gained 1\n","userModified":false}}
