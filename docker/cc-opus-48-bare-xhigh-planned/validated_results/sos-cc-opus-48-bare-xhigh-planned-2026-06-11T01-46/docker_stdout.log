equence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":311,"cache_read_input_tokens":314732,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":311},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4fef623c-942b-4e62-9572-a5757d885aba","uuid":"b903aca5-5572-47b4-82ad-754fe19a0b35","request_id":"req_011CbvfpoNxVDtnE9uyQAEFj"}
