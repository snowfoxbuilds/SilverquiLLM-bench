urn 4 (intent: reduce fully to {B}),\n47\t        but the engine's get_cost_reduction() clamps to min(4, generic=3)=3,\n48\t        yielding {B}{B}. Full alternative-cost support (removing colored\n49\t        pips) would require engine changes beyond current scope.\n50\t        \"\"\"\n51\t        total_creatures = 0\n52\t        for player in game.players:\n53\t            bf = game.get_battlefield(player)\n54\t            for obj in bf.get_all():\n55\t                if CardType.CREATURE in getattr(obj, \"card_types\", set()):\n56\t                    total_creatures += 1\n57\t        if total_creatures >= 13:\n58\t            return 4  # Intent: reduce to {B}; engine limitation applies\n59\t        return 0\n60\t\n61\t    def on_resolve(self, game: \"GameState\") -> None:\n62\t        \"\"\"Each player sacrifices thirteen creatures of their choice.\"\"\"\n63\t        from engine.game import sacrifice\n64\t\n65\t        for player in game.players:\n66\t            bf = game.get_battlefield(player)\n67\t            for _ in range(13):\n68\t                creatures = [\n69\t                    c for c in bf.get_all()\n70\t                    if CardType.CREATURE in getattr(c, \"card_types\", set())\n71\t                ]\n72\t                if not creatures:\n73\t                    break\n74\t                try:\n75\t                    chosen = player.choose_card(creatures, \"sacrifice a creature\")\n76\t                except Exception:\n77\t                    chosen = creatures[-1] if creatures else None\n78\t                if chosen is not None:\n79\t                    sacrifice(game, player, chosen)\n80\t\n81\t===== fdn_194 =====\n82\tEtali, Primal Storm\n83\tLegendary Creature — Elder Dinosaur\n84\tWhenever Etali attacks, exile the top card of each player's library, then you may cast any number of spells from among those cards without paying their mana costs.\n85\t--- impl ---\n86\t\"\"\"Card implementation for Etali, Primal Storm.\"\"\"\n87\tfrom __future__ import annotations\n88\tfrom typing import TYPE_CHECKING, Any\n89\tfrom engine.card import Creature\n90\tfrom engine.types import CardType, ManaCost, Zone\n91\tfrom engine.events import AttacksTriggeredEvent\n92\tif TYPE_CHECKING:\n93\t    from engine.game_state import GameState\n94\t\n95\tclass EtaliPrimalStorm(Creature):\n96\t    \"\"\"Etali, Primal Storm — {4}{R}{R} — 6/6 — Legendary Elder Dinosaur.\n97\t\n98\t    Whenever Etali attacks, exile the top card of each player's library,\n99\t    then you may cast any number of spells from among those cards without\n100\t    paying their mana costs.\n101\t\n102\t    FDN collector number 194.\n103\t    \"\"\"\n104\t\n105\t    def __init__(self, **kwargs: Any) -> None:\n106\t        kwargs.setdefault('name', 'Etali, Primal Storm')\n107\t        kwargs.setdefault('mana_cost', ManaCost.parse('{4}{R}{R}'))\n108\t        kwargs.setdefault('subtypes', {'Elder', 'Dinosaur'})\n109\t        kwargs.setdefault('supertypes', {'Legendary'})\n110\t        kwargs.setdefault('base_power', 6)\n111\t        kwargs.setdefault('base_toughness', 6)\n112\t        kwargs.setdefault('rules_text', \"Whenever Etali attacks, exile the top card of each player's library, then you may cast any number of spells from among those cards without paying their mana costs.\")\n113\t        super().__init__(**kwargs)\n114\t\n115\t    def register_triggers(self, game: 'GameState') -> None:\n116\t        \"\"\"Register attack trigger for exile-and-cast.\"\"\"\n117\t        from engine.triggers import TriggerRegistration\n118\t        from engine.zones import move_to_zone\n119\t        from engine.casting import cast_spell_free\n120\t        source = self\n121\t        controller = getattr(self, 'controller', None) or game.active_player\n122\t\n123\t        def _condition(game: Any, event: dict) -> bool:\n124\t            return event.creature is source\n125\t\n126\t        def _effect(game: 'GameState') -> None:\n127\t            ctrl = getattr(source, 'controller', None)\n128\t            if ctrl is None:\n129\t                return\n130\t            exiled_cards: list = []\n131\t            for player in game.players:\n132\t                library = player.zones[Zone.LIBRARY]\n133\t                cards = library.get_all()\n134\t                if cards:\n135\t                    top_card = cards[-1]\n136\t                    move_to_zone(game, top_card, Zone.LIBRARY, Zone.EXILE)\n137\t                    exiled_cards.append(top_card)\n138\t            # Filter out lands — Etali can only cast nonland cards\n139\t            castable = [c for c in exiled_cards if CardType.LAND not in getattr(c, 'card_types', set())]\n140\t            for card in castable:\n141\t                try:\n142\t                    if ctrl.choose_yes_no(f\"Cast {getattr(card, 'name', 'card')} without paying its mana cost?\"):\n143\t                        # Use the proper cast pipeline — spell goes on the\n144\t                        # stack and can be responded to (e.g. countered).\n145\t                        cast_spell_free(game, ctrl, card, Zone.EXILE)\n146\t                except Exception:\n147\t                    pass\n148\t        game.trigger_manager.register(TriggerRegistration(event_type=AttacksTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=controller))\n149\t\n150\t===== fdn_161 =====\n151\tOmniscience\n152\tEnchantment\n153\tYou may cast spells from your hand without paying their mana costs.\n154\t--- impl ---\n155\t\"\"\"Card implementation for Omniscience.\"\"\"\n156\t\n157\tfrom __future__ import annotations\n158\t\n159\tfrom typing import TYPE_CHECKING, Any\n160\t\n161\tfrom engine.card import Enchantment\n162\tfrom engine.continuous_effects import (\n163\t    ContinuousEffect,\n164\t    DURATION_PERMANENT,\n165\t    Layer,\n166\t)\n167\tfrom engine.types import ManaCost\n168\t\n169\tif TYPE_CHECKING:\n170\t    from engine.game_state import GameState\n171\t\n172\t\n173\tdef _is_on_battlefield(game: Any, obj: Any) -> bool:\n174\t    \"\"\"Return True if *obj* is on any player's battlefield.\"\"\"\n175\t    for player in game.players:\n176\t        if game.get_battlefield(player).contains(obj):\n177\t            return True\n178\t    return False\n179\t\n180\t\n181\tclass Omniscience(Enchantment):\n182\t    \"\"\"Omniscience — {7}{U}{U}{U} — Enchantment.\n183\t\n184\t    You may cast spells from your hand without paying their mana costs.\n185\t\n186\t    FDN collector number 161.\n187\t    \"\"\"\n188\t\n189\t    def __init__(self, **kwargs: Any) -> None:\n190\t        kwargs.setdefault(\"name\", \"Omniscience\")\n191\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{7}{U}{U}{U}\"))\n192\t        kwargs.setdefault(\n193\t            \"rules_text\",\n194\t            \"You may cast spells from your hand without paying their mana costs.\",\n195\t        )\n196\t        super().__init__(**kwargs)\n197\t\n198\t    def apply_continuous_effect(self, game: \"GameState\") -> None:\n199\t        \"\"\"Register continuous effect for free casting.\"\"\"\n200\t        source = self\n201\t\n202\t        def _apply(game: Any) -> None:\n203\t            # ENGINE LIMITATION: The engine doesn't have a \"cast without\n204\t            # paying mana cost\" hook. This is a marker effect that the\n205\t            # casting system would need to consult.\n206\t            if not _is_on_battlefield(game, source):\n207\t                return\n208\t            ctrl = getattr(source, \"controller\", None)\n209\t            if ctrl is not None:\n210\t                ctrl._omniscience_active = True\n211\t\n212\t        game.effect_manager.add(ContinuousEffect(\n213\t            source=self,\n214\t            layer=Layer.ABILITY,\n215\t            sublayer=None,\n216\t            apply=_apply,\n217\t            duration=DURATION_PERMANENT,\n218\t        ))\n219\t\n220\t===== fdn_248 =====\n221\tThousand-Year Storm\n222\tEnchantment\n223\tWhenever you cast an instant or sorcery spell, copy it for each other instant and sorcery spell you've cast before it this turn. You may choose new targets for the copies.\n224\t--- impl ---\n225\t\"\"\"Card implementation for Thousand-Year Storm.\"\"\"\n226\tfrom __future__ import annotations\n227\tfrom typing import TYPE_CHECKING, Any\n228\tfrom engine.card import Enchantment\n229\tfrom engine.types import CardType, ManaCost\n230\tfrom engine.events import SpellCastTriggeredEvent\n231\tif TYPE_CHECKING:\n232\t    from engine.game_state import GameState\n233\t\n234\t\n235\tclass ThousandYearStorm(Enchantment):\n236\t    \"\"\"Thousand-Year Storm — {4}{U}{R} — Enchantment.\n237\t\n238\t    Whenever you cast an instant or sorcery spell, copy it for each\n239\t    other instant and sorcery spell you've cast before it this turn.\n240\t    You may choose new targets for the copies.\n241\t\n242\t    FDN collector number 248.\n243\t    \"\"\"\n244\t\n245\t    def __init__(self, **kwargs: Any) -> None:\n246\t        kwargs.setdefault('name', 'Thousand-Year Storm')\n247\t        kwargs.setdefault('mana_cost', ManaCost.parse('{4}{U}{R}'))\n248\t        kwargs.setdefault(\n249\t            'rules_text',\n250\t            \"Whenever you cast an instant or sorcery spell, copy it for each \"\n251\t            \"other instant and sorcery spell you've cast before it this turn. \"\n252\t            \"You may choose new targets for the copies.\",\n253\t        )\n254\t        super().__init__(**kwargs)\n255\t\n256\t    def register_triggers(self, game: 'GameState') -> None:\n257\t        from engine.stack import copy_spell\n258\t        from engine.triggers import TriggerRegistration\n259\t\n260\t        source = self\n261\t        controller = getattr(self, 'controller', None) or game.active_player\n262\t        source._storm_count: int = 0\n263\t        source._last_turn: int = getattr(game, 'turn_number', 0)\n264\t\n265\t        def _condition(game: Any, event: Any) -> bool:\n266\t            ctrl = getattr(source, 'controller', None)\n267\t            caster = getattr(event, 'player', None) or getattr(event, 'controller', None)\n268\t            if caster is not ctrl:\n269\t                return False\n270\t            spell = getattr(event, 'spell', None) or getattr(event, 'card', None)\n271\t            if spell is None:\n272\t                return False\n273\t            card_types = getattr(spell, 'card_types', set())\n274\t            if not card_types & {CardType.INSTANT, CardType.SORCERY}:\n275\t                return False\n276\t            current_turn = getattr(game, 'turn_number', 0)\n277\t            if current_turn != source._last_turn:\n278\t                source._storm_count = 0\n279\t                source._last_turn = current_turn\n280\t            source._pending_spell = spell\n281\t            return True\n282\t\n283\t        def _effect(game: 'GameState') -> None:\n284\t            copies_to_make = source._storm_count\n285\t            source._storm_count += 1\n286\t            if copies_to_make <= 0:\n287\t                return\n288\t            ctrl = getattr(source, 'controller', None)\n289\t            if ctrl is None:\n290\t                return\n291\t            pending_spell = getattr(source, '_pending_spell', None)\n292\t            if pending_spell is None:\n293\t                return\n294\t            original_so = None\n295\t            for so in game.stack._items:\n296\t                if so.source is pending_spell:\n297\t                    original_so = so\n298\t                    break\n299\t            if original_so is None:\n300\t                return\n301\t            for _ in range(copies_to_make):\n302\t                new_targets: list[Any] | None = None\n303\t                if original_so.targets:\n304\t                    if ctrl.choose_yes_no(\n305\t                        f\"Choose new targets for copy of {original_so.source.name}?\"\n306\t                    ):\n307\t                        requirements = getattr(\n308\t                            original_so.source, 'get_targets', lambda _: []\n309\t                        )(game)\n310\t                        new_targets = []\n311\t                        for req in requirements:\n312\t                            legal: list[Any] = []\n313\t                            for p in game.players:\n314\t                                for obj in game.get_battlefield(p).get_all():\n315\t                                    if req.filter_fn(obj):\n316\t                                        legal.append(obj)\n317\t                                if req.filter_fn(p):\n318\t                                    legal.append(p)\n319\t                            if legal:\n320\t                                chosen = ctrl.choose_target(legal, req)\n321\t                                new_targets.append(chosen)\n322\t                copy_obj = copy_spell(game, original_so, ctrl, new_targets)\n323\t                game.stack.push(copy_obj)\n324\t\n325\t        game.trigger_manager.register(TriggerRegistration(\n326\t            event_type=SpellCastTriggeredEvent,\n327\t            condition=_condition,\n328\t            effect=_effect,\n329\t            source=self,\n330\t            controller=controller,\n331\t        ))\n332\t\n333\t===== fdn_235 =====\n334\tWary Thespian\n335\tCreature — Cat Druid\n336\tWhen this creature enters or dies, surveil 1. (Look at the top card of your library. You may put it into your graveyard.)\n337\t--- impl ---\n338\t\"\"\"Card implementation for Wary Thespian.\"\"\"\n339\tfrom __future__ import annotations\n340\tfrom typing import TYPE_CHECKING, Any\n341\tfrom engine.card import ArtifactCreature, Creature\n342\tfrom engine.types import CardType, Keyword, ManaCost, Supertype, Zone\n343\tfrom engine.events import CreatureDiesTriggeredEvent, EntersBattlefieldTriggeredEvent\n344\tif TYPE_CHECKING:\n345\t    from engine.game_state import GameState\n346\t    from cards.registry import CardRegistry\n347\t\n348\tdef _self_dies_condition(source: Any):\n349\t    \"\"\"Return a condition callable that matches only when *source* dies.\"\"\"\n350\t\n351\t    def _condition(game: Any, event: dict) -> bool:\n352\t        return event.creature is source\n353\t    return _condition\n354\t\n355\tdef _self_etb_condition(source: Any):\n356\t    \"\"\"Return a condition callable that matches only when *source* enters.\"\"\"\n357\t\n358\t    def _condition(game: Any, event: dict) -> bool:\n359\t        return event.permanent is source\n360\t    return _condition\n361\t\n362\tclass WaryThespian(Creature):\n363\t    \"\"\"Wary Thespian — {1}{G} — 3/1 — Cat Druid\n364\t\n365\t    When this creature enters or dies, surveil 1.\n366\t\n367\t    FDN collector number 235.\n368\t    \"\"\"\n369\t\n370\t    def __init__(self, **kwargs: Any) -> None:\n371\t        kwargs.setdefault('name', 'Wary Thespian')\n372\t        kwargs.setdefault('mana_cost', ManaCost.parse('{1}{G}'))\n373\t        kwargs.setdefault('subtypes', {'Cat', 'Druid'})\n374\t        kwargs.setdefault('base_power', 3)\n375\t        kwargs.setdefault('base_toughness', 1)\n376\t        kwargs.setdefault('rules_text', 'When this creature enters or dies, surveil 1.')\n377\t        super().__init__(**kwargs)\n378\t\n379\t    def register_triggers(self, game: GameState) -> None:\n380\t        from engine.triggers import TriggerRegistration\n381\t        source = self\n382\t\n383\t        def _surveil_effect(game: GameState) -> None:\n384\t            controller = getattr(source, 'controller', None) or getattr(source, 'owner', None)\n385\t            if controller is None:\n386\t                return\n387\t            library = controller.zones[Zone.LIBRARY]\n388\t            if len(library) > 0:\n389\t                card = library.top(1)[0]\n390\t                library.remove(card)\n391\t                graveyard = controller.zones[Zone.GRAVEYARD]\n392\t                graveyard.add(card)\n393\t        controller = getattr(self, 'controller', None) or game.active_player\n394\t        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=_self_etb_condition(self), effect=_surveil_effect, source=self, controller=controller))\n395\t        game.trigger_manager.register(TriggerRegistration(event_type=CreatureDiesTriggeredEvent, condition=_self_dies_condition(self), effect=_surveil_effect, source=self, controller=controller))\n396\t\n397\t===== fdn_81 =====\n398\tChandra, Flameshaper\n399\tLegendary Planeswalker — Chandra\n400\t+2: Add {R}{R}{R}. Exile the top three cards of your library. Choose one. You may play that card this turn.\n401\t+1: Create a token that's a copy of target creature you control, except it has haste and \"At the beginning of the end step, sacrifice this token.\"\n402\t−4: Chandra deals 8 damage divided as you choose among any number of target creatures and/or planeswalkers.\n403\t--- impl ---\n404\t\"\"\"Card implementation for Chandra, Flameshaper.\"\"\"\n405\tfrom __future__ import annotations\n406\tfrom typing import TYPE_CHECKING, Any\n407\tfrom engine.card import Creature, LoyaltyAbility, Planeswalker\n408\tfrom engine.types import CardType, Keyword, ManaCost, ManaType, Supertype, Zone\n409\tfrom engine.events import EndStepTriggeredEvent\n410\tif TYPE_CHECKING:\n411\t    from engine.game_state import GameState\n412\t    from engine.player import Player\n413\t    from cards.registry import CardRegistry\n414\t\n415\tclass ChandraFlameshaper(Planeswalker):\n416\t    \"\"\"Chandra, Flameshaper — {5}{R}{R} — 6 loyalty.\n417\t\n418\t    +2: Add {R}{R}{R}. Exile top three cards. May play one this turn.\n419\t    +1: Create a token copy of target creature you control (has haste,\n420\t        sacrifice at end step).\n421\t    −4: Chandra deals 8 damage divided among any number of target\n422\t        creatures and/or planeswalkers.\n423\t    \"\"\"\n424\t\n425\t    def __init__(self, **kwargs: Any) -> None:\n426\t        kwargs.setdefault('name', 'Chandra, Flameshaper')\n427\t        kwargs.setdefault('mana_cost', ManaCost.parse('{5}{R}{R}'))\n428\t        kwargs.setdefault('starting_loyalty', 6)\n429\t        kwargs.setdefault('supertypes', set())\n430\t        kwargs['supertypes'] = (kwargs.get('supertypes') or set()) | {Supertype.LEGENDARY}\n431\t        kwargs.setdefault('subtypes', set())\n432\t        kwargs['subtypes'] = (kwargs.get('subtypes') or set()) | {'Chandra'}\n433\t        kwargs.setdefault('rules_text', '+2: Add {R}{R}{R}. Exile the top three cards of your library. Choose one. You may play that card this turn.\\n+1: Create a token that\\'s a copy of target creature you control, except it has haste and \"At the beginning of the end step, sacrifice this token.\"\\n−4: Chandra deals 8 damage divided as you choose among any number of target creatures and/or planeswalkers.')\n434\t        super().__init__(**kwargs)\n435\t\n436\t    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n437\t        pw = self\n438\t\n439\t        def _plus2(game: Any) -> None:\n440\t            \"\"\"Add {R}{R}{R}. Exile top 3, may play one this turn.\"\"\"\n441\t            controller = pw.controller\n442\t            if controller is None:\n443\t                return\n444\t            controller.mana_pool.add(ManaType.RED, 3)\n445\t            library = controller.zones[Zone.LIBRARY]\n446\t            exiled_cards: list[Any] = []\n447\t            for _ in range(min(3, len(library))):\n448\t                cards = library.get_all()\n449\t                if cards:\n450\t                    card = cards[-1]\n451\t                    library.remove(card)\n452\t                    exile_zone = controller.zones[Zone.EXILE]\n453\t                    exile_zone.add(card)\n454\t                    exiled_cards.append(card)\n455\t            if exiled_cards:\n456\t                try:\n457\t                    chosen = controller.choose_card(exiled_cards, 'Choose one exiled card to play this turn')\n458\t                except Exception:\n459\t                    chosen = exiled_cards[0]\n460\t                if chosen is not None and chosen in exiled_cards:\n461\t                    chosen._playable_this_turn = True\n462\t                    chosen._playable_by = controller\n463\t\n464\t        def _plus1(game: Any) -> None:\n465\t            \"\"\"Create a token copy of target creature (with haste, sacrifice at end step).\"\"\"\n466\t            from engine.game import create_token\n467\t            from engine.triggers import TriggerRegistration\n468\t            target = getattr(pw, '_resolve_target', None)\n469\t            controller = pw.controller\n470\t            if target is None or controller is None:\n471\t                return\n472\t            token = Creature(name=getattr(target, 'name', 'Token'), base_power=getattr(target, 'base_power', 0), base_toughness=getattr(target, 'base_toughness', 0), subtypes=getattr(target, 'subtypes', set()).copy() if getattr(target, 'subtypes', None) else set(), keywords=getattr(target, 'keywords', Keyword(0)) | Keyword.HASTE)\n473\t            if hasattr(target, 'card_types'):\n474\t                token.card_types = set(target.card_types)\n475\t            create_token(game, controller, token)\n476\t\n477\t            def _eot_condition(game: Any, event: dict) -> bool:\n478\t                return True\n479\t\n480\t            def _eot_effect(game: Any) -> None:\n481\t                \"\"\"Sacrifice the token at end of turn.\"\"\"\n482\t                from engine.game import sacrifice\n483\t                bf = game.get_battlefield(controller)\n484\t                if bf.contains(token):\n485\t                    sacrifice(game, controller, token)\n486\t            game.trigger_manager.register(TriggerRegistration(event_type=EndStepTriggeredEvent, condition=_eot_condition, effect=_eot_effect, source=token, controller=controller))\n487\t\n488\t        def _minus4(game: Any) -> None:\n489\t            \"\"\"Deal 8 damage divided among targets.\"\"\"\n490\t            from engine.game import deal_damage\n491\t            damage_assignments = getattr(pw, '_damage_assignments', None)\n492\t            if damage_assignments:\n493\t                for target, amount in damage_assignments:\n494\t                    deal_damage(game, pw, target, amount)\n495\t                return\n496\t            targets = getattr(pw, '_resolve_targets', None)\n497\t            if targets and len(targets) > 0:\n498\t                damage_per = 8 // len(targets)\n499\t                remainder = 8 % len(targets)\n500\t                for i, t in enumerate(targets):\n501\t                    dmg = damage_per + (1 if i < remainder else 0)\n502\t                    deal_damage(game, pw, t, dmg)\n503\t            else:\n504\t                target = getattr(pw, '_resolve_target', None)\n505\t                if target is not None:\n506\t                    deal_damage(game, pw, target, 8)\n507\t        return [LoyaltyAbility(loyalty_cost=+2, effect=_plus2, description='+2: Add {R}{R}{R}. Exile top 3, choose one to play this turn.'), LoyaltyAbility(loyalty_cost=+1, effect=_plus1, description='+1: Create a hasty token copy of target creature (sacrifice at end step).'), LoyaltyAbility(loyalty_cost=-4, effect=_minus4, description='−4: Deal 8 damage divided among target creatures and/or planeswalkers.')]\n508\t\n509\t===== fdn_244 =====\n510\tProgenitus\n511\tLegendary Creature — Hydra Avatar\n512\tProtection from everything\n513\tIf Progenitus would be put into a graveyard from anywhere, reveal Progenitus and shuffle it into its owner's library instead.\n514\t--- impl ---\n515\t\"\"\"Card implementation for Progenitus.\"\"\"\n516\tfrom __future__ import annotations\n517\tfrom typing import TYPE_CHECKING, Any\n518\tfrom engine.card import Creature\n519\tfrom engine.protection import ProtectionAbility\n520\tfrom engine.events import MoveToGraveyardReplacementEvent\n521\tfrom engine.replacement_effects import ReplacementEffect\n522\tfrom engine.types import ManaCost, Supertype, Zone\n523\tif TYPE_CHECKING:\n524\t    from engine.game_state import GameState\n525\t\n526\tclass Progenitus(Creature):\n527\t    \"\"\"Progenitus — {W}{W}{U}{U}{B}{B}{R}{R}{G}{G} — 10/10 — Legendary Hydra Avatar.\n528\t\n529\t    Protection from everything.\n530\t    If Progenitus would be put into a graveyard from anywhere, reveal\n531\t    Progenitus and shuffle it into its owner's library instead.\n532\t\n533\t    FDN collector number 244.\n534\t    \"\"\"\n535\t\n536\t    def __init__(self, **kwargs: Any) -> None:\n537\t        kwargs.setdefault('name', 'Progenitus')\n538\t        kwargs.setdefault('mana_cost', ManaCost.parse('{W}{W}{U}{U}{B}{B}{R}{R}{G}{G}'))\n539\t        kwargs.setdefault('subtypes', {'Hydra', 'Avatar'})\n540\t        kwargs.setdefault('supertypes', {Supertype.LEGENDARY})\n541\t        kwargs.setdefault('base_power', 10)\n542\t        kwargs.setdefault('base_toughness', 10)\n543\t        kwargs.setdefault('rules_text', \"Protection from everything\\nIf Progenitus would be put into a graveyard from anywhere, reveal Progenitus and shuffle it into its owner's library instead.\")\n544\t        super().__init__(**kwargs)\n545\t        self._init_protection()\n546\t\n547\t    def _init_protection(self) -> None:\n548\t        \"\"\"Set up protection from everything. Called from __init__ and\n549\t        can be re-invoked after characteristic resets.\"\"\"\n550\t        self.protections = [ProtectionAbility(quality='everything', predicate=lambda source: True)]\n551\t\n552\t    def _reset_characteristics(self) -> None:\n553\t        \"\"\"Override to reapply protection from everything after reset.\"\"\"\n554\t        super()._reset_characteristics()\n555\t        self._init_protection()\n556\t\n557\t    def register_replacement_effects(self, game: 'GameState') -> None:\n558\t        \"\"\"Register graveyard-shuffle replacement effect.\n559\t\n560\t        Registers a single :class:`~engine.events.MoveToGraveyardReplacementEvent`\n561\t        handler; the engine's zone-move pipeline dispatches subclass events\n562\t        (creature_dies, sacrifice, etc.) to this parent-type handler automatically.\n563\t        \"\"\"\n564\t        source = self\n565\t\n566\t        def _condition(game: Any, event: dict) -> bool:\n567\t            return event.card is source\n568\t\n569\t        def _replacement(game: Any, event: dict) -> dict:\n570\t            owner = getattr(source, 'owner', None)\n571\t            if owner is not None:\n572\t                library = owner.zones[Zone.LIBRARY]\n573\t                library.add(source)\n574\t                library.shuffle()\n575\t            event.prevented = True\n576\t            return event\n577\t        controller = getattr(self, 'controller', None)\n578\t        game.replacement_manager.register(ReplacementEffect(event_type=MoveToGraveyardReplacementEvent, source=self, condition=_condition, replacement=_replacement, controller=controller))\n579\t\n580\t===== fdn_137 =====\n581\tAuthority of the Consuls\n582\tEnchantment\n583\tCreatures your opponents control enter tapped.\n584\tWhenever a creature an opponent controls enters, you gain 1 life.\n585\t--- impl ---\n586\t\"\"\"Card implementation for Authority of the Consuls.\"\"\"\n587\tfrom __future__ import annotations\n588\tfrom dataclasses import dataclass\n589\tfrom typing import TYPE_CHECKING, Any\n590\tfrom engine.card import ActivatedAbility, Creature, Enchantment\n591\tfrom engine.continuous_effects import ContinuousEffect, DURATION_PERMANENT, Layer, SubLayer\n592\tfrom engine.types import CardType, Keyword, ManaCost, TargetRequirement, Zone\n593\tfrom engine.events import EntersBattlefieldTriggeredEvent, GainsLifeTriggeredEvent\n594\tif TYPE_CHECKING:\n595\t    from engine.game_state import GameState\n596\t    from cards.registry import CardRegistry\n597\t\n598\tdef _is_on_battlefield(game: Any, obj: Any) -> bool:\n599\t    \"\"\"Check if *obj* is on any player's battlefield.\"\"\"\n600\t    for player in game.players:\n601\t        if game.get_battlefield(player).contains(obj):\n602\t            return True\n603\t    return False\n604\t\n605\tclass AuthorityOfTheConsuls(Enchantment):\n606\t    \"\"\"Authority of the Consuls — {W} — Creatures opponents control enter tapped.\n607\t\n608\t    Whenever a creature an opponent controls enters, you gain 1 life.\n609\t\n610\t    FDN collector number 137.\n611\t    \"\"\"\n612\t\n613\t    def __init__(self, **kwargs: Any) -> None:\n614\t        kwargs.setdefault('name', 'Authority of the Consuls')\n615\t        kwargs.setdefault('mana_cost', ManaCost.parse('{W}'))\n616\t        kwargs.setdefault('rules_text', 'Creatures your opponents control enter tapped.\\nWhenever a creature an opponent controls enters, you gain 1 life.')\n617\t        super().__init__(**kwargs)\n618\t        self._effect_ref: ContinuousEffect | None = None\n619\t\n620\t    def on_resolve(self, game: GameState) -> None:\n621\t        self._register_effect(game)\n622\t\n623\t    def _register_effect(self, game: GameState) -> None:\n624\t        enchantment_ref = self\n625\t\n626\t        def _apply(game: GameState) -> None:\n627\t            controller = enchantment_ref.controller\n628\t            if controller is None:\n629\t                return\n630\t            if not _is_on_battlefield(game, enchantment_ref):\n631\t                return\n632\t            for player in game.players:\n633\t                if player is controller:\n634\t                    continue\n635\t                for obj in game.get_battlefield(player).get_all():\n636\t                    if CardType.CREATURE in getattr(obj, 'card_types', set()):\n637\t                        if getattr(obj, 'summoning_sick', False):\n638\t                            obj.is_tapped = True\n639\t        effect = ContinuousEffect(source=enchantment_ref, layer=Layer.ABILITY, sublayer=None, apply=_apply, duration=DURATION_PERMANENT)\n640\t        self._effect_ref = game.effect_manager.add(effect)\n641\t\n642\t    def register_triggers(self, game: GameState) -> None:\n643\t        from engine.triggers import TriggerRegistration\n644\t        source = self\n645\t\n646\t        def _condition(game: Any, event: dict) -> bool:\n647\t            permanent = event.permanent\n648\t            if permanent is None:\n649\t                return False\n650\t            controller = source.controller\n651\t            if controller is None:\n652\t                return False\n653\t            perm_controller = getattr(permanent, 'controller', None)\n654\t            if perm_controller is controller:\n655\t                return False\n656\t            return CardType.CREATURE in getattr(permanent, 'card_types', set())\n657\t\n658\t        def _effect(game: GameState) -> None:\n659\t            controller = source.controller\n660\t            if controller is None:\n661\t                return\n662\t            if hasattr(controller, 'life'):\n663\t                controller.life += 1\n664\t                game.trigger_manager.fire_event(game, GainsLifeTriggeredEvent(player=controller, amount=1))\n665\t        controller = getattr(self, 'controller', None) or game.active_player\n666\t        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=controller))\n667\t\n668\t    def register_replacement_effects(self, game: GameState) -> None:\n669\t        if self._effect_ref is None:\n670\t            self._register_effect(game)\n671\t\n672\t===== fdn_44 =====\n673\tKaito, Cunning Infiltrator\n674\tLegendary Planeswalker — Kaito\n675\tWhenever a creature you control deals combat damage to a player, put a loyalty counter on Kaito.\n676\t+1: Up to one target creature you control can't be blocked this turn. Draw a card, then discard a card.\n677\t−2: Create a 2/1 blue Ninja creature token.\n678\t−9: You get an emblem with \"Whenever a player casts a spell, you create a 2/1 blue Ninja creature token.\"\n679\t--- impl ---\n680\t\"\"\"Card implementation for Kaito, Cunning Infiltrator.\"\"\"\n681\tfrom __future__ import annotations\n682\tfrom typing import TYPE_CHECKING, Any\n683\tfrom engine.card import Creature, LoyaltyAbility, Planeswalker\n684\tfrom engine.types import CardType, Keyword, ManaCost, ManaType, Supertype, Zone\n685\tfrom engine.events import DealsDamageTriggeredEvent, SpellCastTriggeredEvent\n686\tif TYPE_CHECKING:\n687\t    from engine.game_state import GameState\n688\t    from engine.player import Player\n689\t    from cards.registry import CardRegistry\n690\t\n691\tclass KaitoCunningInfiltrator(Planeswalker):\n692\t    \"\"\"Kaito, Cunning Infiltrator — {1}{U}{U} — 3 loyalty.\n693\t\n694\t    Whenever a creature you control deals combat damage to a player, put a\n695\t    loyalty counter on Kaito.\n696\t    +1: Up to one target creature you control can't be blocked this turn.\n697\t        Draw a card, then discard a card.\n698\t    −2: Create a 2/1 blue Ninja creature token.\n699\t    −9: You get an emblem with \"Whenever a player casts a spell, you create\n700\t        a 2/1 blue Ninja creature token.\"\n701\t    \"\"\"\n702\t\n703\t    def __init__(self, **kwargs: Any) -> None:\n704\t        kwargs.setdefault('name', 'Kaito, Cunning Infiltrator')\n705\t        kwargs.setdefault('mana_cost', ManaCost.parse('{1}{U}{U}'))\n706\t        kwargs.setdefault('starting_loyalty', 3)\n707\t        kwargs.setdefault('supertypes', set())\n708\t        kwargs['supertypes'] = (kwargs.get('supertypes') or set()) | {Supertype.LEGENDARY}\n709\t        kwargs.setdefault('subtypes', set())\n710\t        kwargs['subtypes'] = (kwargs.get('subtypes') or set()) | {'Kaito'}\n711\t        kwargs.setdefault('rules_text', 'Whenever a creature you control deals combat damage to a player, put a loyalty counter on Kaito.\\n+1: Up to one target creature you control can\\'t be blocked this turn. Draw a card, then discard a card.\\n−2: Create a 2/1 blue Ninja creature token.\\n−9: You get an emblem with \"Whenever a player casts a spell, you create a 2/1 blue Ninja creature token.\"')\n712\t        super().__init__(**kwargs)\n713\t\n714\t    def register_triggers(self, game: Any) -> None:\n715\t        \"\"\"Register passive: combat damage to a player → loyalty counter.\"\"\"\n716\t        from engine.game import add_counter\n717\t        from engine.triggers import TriggerRegistration\n718\t        pw = self\n719\t        controller = getattr(self, 'controller', None) or game.active_player\n720\t\n721\t        def _combat_damage_condition(game: Any, event: dict) -> bool:\n722\t            \"\"\"Fire when a creature controlled by Kaito's controller deals damage to a player.\"\"\"\n723\t            source = event.source\n724\t            target = event.target\n725\t            if not event.combat:\n726\t                return False\n727\t            if source is None or target is None:\n728\t                return False\n729\t            source_types = getattr(source, 'card_types', set())\n730\t            if CardType.CREATURE not in source_types:\n731\t                return False\n732\t            if getattr(source, 'controller', None) is not pw.controller:\n733\t                return False\n734\t            if not hasattr(target, 'life'):\n735\t                return False\n736\t            return True\n737\t\n738\t        def _combat_damage_effect(game: Any) -> None:\n739\t            \"\"\"Put a loyalty counter on Kaito.\"\"\"\n740\t            add_counter(game, pw, 'loyalty', 1)\n741\t        game.trigger_manager.register(TriggerRegistration(event_type=DealsDamageTriggeredEvent, condition=_combat_damage_condition, effect=_combat_damage_effect, source=self, controller=controller))\n742\t\n743\t    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n744\t        pw = self\n745\t\n746\t        def _plus1(game: Any) -> None:\n747\t            \"\"\"Up to one target creature can't be blocked. Draw then discard.\"\"\"\n748\t            from engine.game import discard, draw_card\n749\t            target = getattr(pw, '_resolve_target', None)\n750\t            if target is not None:\n751\t                target._cant_be_blocked = True\n752\t            controller = pw.controller\n753\t            if controller is not None:\n754\t                drawn = draw_card(game, controller)\n755\t                hand = controller.zones[Zone.HAND]\n756\t                cards_in_hand = hand.get_all()\n757\t                if cards_in_hand:\n758\t                    card_to_discard = cards_in_hand[-1]\n759\t                    discard(game, controller, card_to_discard)\n760\t\n761\t        def _minus2(game: Any) -> None:\n762\t            \"\"\"Create a 2/1 blue Ninja creature token.\"\"\"\n763\t            from engine.game import create_token\n764\t            controller = pw.controller\n765\t            if controller is not None:\n766\t                token = Creature(name='Ninja', base_power=2, base_toughness=1, subtypes={'Ninja'})\n767\t                create_token(game, controller, token)\n768\t\n769\t        def _minus9(game: Any) -> None:\n770\t            \"\"\"Emblem — whenever a player casts a spell, create a 2/1 Ninja token.\"\"\"\n771\t            from engine.triggers import TriggerRegistration\n772\t            from engine.game import create_token\n773\t            controller = pw.controller\n774\t            if controller is None:\n775\t                return\n776\t            emblem = type('Emblem', (), {'name': 'Kaito Emblem'})()\n777\t\n778\t            def _spell_cast_condition(game: Any, event: dict) -> bool:\n779\t                \"\"\"Always fires when any player casts a spell.\"\"\"\n780\t                return True\n781\t\n782\t            def _spell_cast_effect(game: Any) -> None:\n783\t                \"\"\"Create a 2/1 blue Ninja creature token.\"\"\"\n784\t                token = Creature(name='Ninja', base_power=2, base_toughness=1, subtypes={'Ninja'})\n785\t                create_token(game, controller, token)\n786\t            game.trigger_manager.register(TriggerRegistration(event_type=SpellCastTriggeredEvent, condition=_spell_cast_condition, effect=_spell_cast_effect, source=emblem, controller=controller))\n787\t        return [LoyaltyAbility(loyalty_cost=+1, effect=_plus1, description=\"+1: Up to one target creature can't be blocked. Draw, then discard.\"), LoyaltyAbility(loyalty_cost=-2, effect=_minus2, description='−2: Create a 2/1 blue Ninja creature token.'), LoyaltyAbility(loyalty_cost=-9, effect=_minus9, description='−9: Emblem — whenever a player casts a spell, create 2/1 Ninja token.')]\n788\t\n789\t===== fdn_48 =====\n790\tRefute\n791\tInstant\n792\tCounter target spell. Draw a card, then discard a card.\n793\t--- impl ---\n794\t\"\"\"Card implementation for Refute.\"\"\"\n795\t\n796\tfrom __future__ import annotations\n797\t\n798\tfrom typing import TYPE_CHECKING, Any\n799\t\n800\tfrom engine.card import Instant\n801\tfrom engine.types import ManaCost, TargetRequirement, Zone\n802\t\n803\tif TYPE_CHECKING:\n804\t    from engine.game_state import GameState\n805\t\n806\t\n807\tdef _get_chosen_target(card: Any, game: Any) -> Any:\n808\t    \"\"\"Retrieve the first chosen target for a spell.\"\"\"\n809\t    chosen = getattr(card, \"chosen_targets\", None)\n810\t    if chosen:\n811\t        return chosen[0]\n812\t    return getattr(card, \"_resolve_target\", None)\n813\t\n814\t\n815\tdef _counter_spell(game: \"GameState\", stack_obj: Any) -> None:\n816\t    \"\"\"Counter a spell — remove from stack and move card to graveyard.\"\"\"\n817\t    from engine.stack import StackObject\n818\t\n819\t    if not isinstance(stack_obj, StackObject):\n820\t        return\n821\t\n822\t    card = stack_obj.source\n823\t    stack_items = game.stack._items  # noqa: SLF001\n824\t    found = False\n825\t    for i, item in enumerate(stack_items):\n826\t        if item is stack_obj:\n827\t            stack_items.pop(i)\n828\t            found = True\n829\t            break\n830\t\n831\t    if not found:\n832\t        return\n833\t\n834\t    controller = stack_obj.controller\n835\t    owner = getattr(card, \"owner\", controller)\n836\t\n837\t    if controller is not None:\n838\t        stack_zone = controller.zones[Zone.STACK]\n839\t        if stack_zone.contains(card):\n840\t            stack_zone.remove(card)\n841\t\n842\t    if owner is not None:\n843\t        graveyard = owner.zones[Zone.GRAVEYARD]\n844\t        graveyard.add(card)\n845\t\n846\t\n847\tclass Refute(Instant):\n848\t    \"\"\"Refute — {1}{U}{U} — Instant.\n849\t\n850\t    Counter target spell. Draw a card, then discard a card.\n851\t\n852\t    FDN collector number 48.\n853\t    \"\"\"\n854\t\n855\t    def __init__(self, **kwargs: Any) -> None:\n856\t        kwargs.setdefault(\"name\", \"Refute\")\n857\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{U}{U}\"))\n858\t        kwargs.setdefault(\n859\t            \"rules_text\",\n860\t            \"Counter target spell. Draw a card, then discard a card.\",\n861\t        )\n862\t        super().__init__(**kwargs)\n863\t\n864\t    def can_cast(self, game: \"GameState\") -> bool:\n865\t        \"\"\"Cannot cast unless there's a spell on the stack to counter.\"\"\"\n866\t        from engine.stack import StackObject\n867\t\n868\t        for stack_obj in game.stack.objects():\n869\t            source = stack_obj.source\n870\t            if source is self:\n871\t                continue\n872\t            # Only target spells (not triggered/activated abilities)\n873\t            if getattr(stack_obj, \"is_spell\", True):\n874\t                return True\n875\t        return False\n876\t\n877\t    def get_targets(self, game: \"GameState\") -> list:\n878\t        \"\"\"Target spell on the stack.\"\"\"\n879\t        from engine.stack import StackObject\n880\t\n881\t        targets = []\n882\t        for stack_obj in game.stack.objects():\n883\t            source = stack_obj.source\n884\t            if source is self:\n885\t                continue\n886\t            if getattr(stack_obj, \"is_spell\", True):\n887\t                targets.append(stack_obj)\n888\t        if not targets:\n889\t            return []\n890\t        return [\n891\t            TargetRequirement(\n892\t                filter_fn=lambda obj: obj is not self and getattr(obj, \"is_spell\", True),\n893\t                description=\"target spell\",\n894\t                zone=Zone.STACK,\n895\t            )\n896\t        ]\n897\t\n898\t    def on_resolve(self, game: \"GameState\") -> None:\n899\t        \"\"\"Counter target spell, then draw a card, then discard a card.\"\"\"\n900\t        from engine.game import discard, draw_card\n901\t\n902\t        target = _get_chosen_target(self, game)\n903\t        # Single-target spell fizzles if target is illegal\n904\t        if target is None:\n905\t            return\n906\t        if target is not None:\n907\t            _counter_spell(game, target)\n908\t\n909\t        controller = self.controller\n910\t        if controller is None:\n911\t            return\n912\t\n913\t        # Draw a card\n914\t        draw_card(game, controller)\n915\t\n916\t        # Discard a card\n917\t        hand = controller.zones[Zone.HAND]\n918\t        cards_in_hand = list(hand.get_all())\n919\t        if cards_in_hand:\n920\t            try:\n921\t                chosen = controller.choose_card(\n922\t                    cards_in_hand, \"Choose a card to discard\"\n923\t                )\n924\t            except Exception:\n925\t                chosen = cards_in_hand[0] if cards_in_hand else None\n926\t            if chosen is not None:\n927\t                discard(game, controller, chosen)\n928\t\n929\t"}]},"parent_tool_use_id":null,"session_id":"88686e67-15f6-420e-923b-5a5a834e5552","uuid":"fdd6e1d1-5848-4f4f-a169-cb018a737bed","timestamp":"2026-06-10T07:47:22.353Z","tool_use_result":{"type":"text","file":{"filePath":"/home/node/.claude/projects/-workspace/88686e67-15f6-420e-923b-5a5a834e5552/tool-results/bcwb3d242.txt","content":"===== fdn_57 =====\nBlasphemous Edict\nSorcery\nYou may pay {B} rather than pay this spell's mana cost if there are thirteen or more creatures on the battlefield.\nEach player sacrifices thirteen creatures of their choice.\n--- impl ---\n\"\"\"Card implementation for Blasphemous Edict.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import Sorcery\nfrom engine.types import CardType, ManaCost, Zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\nclass BlasphemousEdict(Sorcery):\n    \"\"\"Blasphemous Edict — {3}{B}{B} — Sorcery.\n\n    You may pay {B} rather than pay this spell's mana cost if there are\n    thirteen or more creatures on the battlefield.\n    Each player sacrifices thirteen creatures of their choice.\n\n    FDN collector number 57.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"Blasphemous Edict\")\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{3}{B}{B}\"))\n        kwargs.setdefault(\n            \"rules_text\",\n            \"You may pay {B} rather than pay this spell's mana cost if \"\n            \"there are thirteen or more creatures on the battlefield.\\n\"\n            \"Each player sacrifices thirteen creatures of their choice.\",\n        )\n        super().__init__(**kwargs)\n\n    def cost_reduction(self, game: \"GameState\") -> int:\n        \"\"\"Allow alternative cost of {B} if 13+ creatures on battlefield.\n\n        The alternative cost should make total cost {B}. The original cost is\n        {3}{B}{B} (generic=3, pips={B:2}). cost_reduction only reduces\n        the generic portion. We return 4 (intent: reduce fully to {B}),\n        but the engine's get_cost_reduction() clamps to min(4, generic=3)=3,\n        yielding {B}{B}. Full alternative-cost support (removing colored\n        pips) would require engine changes beyond current scope.\n        \"\"\"\n        total_creatures = 0\n        for player in game.players:\n            bf = game.get_battlefield(player)\n            for obj in bf.get_all():\n                if CardType.CREATURE in getattr(obj, \"card_types\", set()):\n                    total_creatures += 1\n        if total_creatures >= 13:\n            return 4  # Intent: reduce to {B}; engine limitation applies\n        return 0\n\n    def on_resolve(self, game: \"GameState\") -> None:\n        \"\"\"Each player sacrifices thirteen creatures of their choice.\"\"\"\n        from engine.game import sacrifice\n\n        for player in game.players:\n            bf = game.get_battlefield(player)\n            for _ in range(13):\n                creatures = [\n                    c for c in bf.get_all()\n                    if CardType.CREATURE in getattr(c, \"card_types\", set())\n                ]\n                if not creatures:\n                    break\n                try:\n                    chosen = player.choose_card(creatures, \"sacrifice a creature\")\n                except Exception:\n                    chosen = creatures[-1] if creatures else None\n                if chosen is not None:\n                    sacrifice(game, player, chosen)\n\n===== fdn_194 =====\nEtali, Primal Storm\nLegendary Creature — Elder Dinosaur\nWhenever Etali attacks, exile the top card of each player's library, then you may cast any number of spells from among those cards without paying their mana costs.\n--- impl ---\n\"\"\"Card implementation for Etali, Primal Storm.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import Creature\nfrom engine.types import CardType, ManaCost, Zone\nfrom engine.events import AttacksTriggeredEvent\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\nclass EtaliPrimalStorm(Creature):\n    \"\"\"Etali, Primal Storm — {4}{R}{R} — 6/6 — Legendary Elder Dinosaur.\n\n    Whenever Etali attacks, exile the top card of each player's library,\n    then you may cast any number of spells from among those cards without\n    paying their mana costs.\n\n    FDN collector number 194.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Etali, Primal Storm')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{4}{R}{R}'))\n        kwargs.setdefault('subtypes', {'Elder', 'Dinosaur'})\n        kwargs.setdefault('supertypes', {'Legendary'})\n        kwargs.setdefault('base_power', 6)\n        kwargs.setdefault('base_toughness', 6)\n        kwargs.setdefault('rules_text', \"Whenever Etali attacks, exile the top card of each player's library, then you may cast any number of spells from among those cards without paying their mana costs.\")\n        super().__init__(**kwargs)\n\n    def register_triggers(self, game: 'GameState') -> None:\n        \"\"\"Register attack trigger for exile-and-cast.\"\"\"\n        from engine.triggers import TriggerRegistration\n        from engine.zones import move_to_zone\n        from engine.casting import cast_spell_free\n        source = self\n        controller = getattr(self, 'controller', None) or game.active_player\n\n        def _condition(game: Any, event: dict) -> bool:\n            return event.creature is source\n\n        def _effect(game: 'GameState') -> None:\n            ctrl = getattr(source, 'controller', None)\n            if ctrl is None:\n                return\n            exiled_cards: list = []\n            for player in game.players:\n                library = player.zones[Zone.LIBRARY]\n                cards = library.get_all()\n                if cards:\n                    top_card = cards[-1]\n                    move_to_zone(game, top_card, Zone.LIBRARY, Zone.EXILE)\n                    exiled_cards.append(top_card)\n            # Filter out lands — Etali can only cast nonland cards\n            castable = [c for c in exiled_cards if CardType.LAND not in getattr(c, 'card_types', set())]\n            for card in castable:\n                try:\n                    if ctrl.choose_yes_no(f\"Cast {getattr(card, 'name', 'card')} without paying its mana cost?\"):\n                        # Use the proper cast pipeline — spell goes on the\n                        # stack and can be responded to (e.g. countered).\n                        cast_spell_free(game, ctrl, card, Zone.EXILE)\n                except Exception:\n                    pass\n        game.trigger_manager.register(TriggerRegistration(event_type=AttacksTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=controller))\n\n===== fdn_161 =====\nOmniscience\nEnchantment\nYou may cast spells from your hand without paying their mana costs.\n--- impl ---\n\"\"\"Card implementation for Omniscience.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import Enchantment\nfrom engine.continuous_effects import (\n    ContinuousEffect,\n    DURATION_PERMANENT,\n    Layer,\n)\nfrom engine.types import ManaCost\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\ndef _is_on_battlefield(game: Any, obj: Any) -> bool:\n    \"\"\"Return True if *obj* is on any player's battlefield.\"\"\"\n    for player in game.players:\n        if game.get_battlefield(player).contains(obj):\n            return True\n    return False\n\n\nclass Omniscience(Enchantment):\n    \"\"\"Omniscience — {7}{U}{U}{U} — Enchantment.\n\n    You may cast spells from your hand without paying their mana costs.\n\n    FDN collector number 161.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"Omniscience\")\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{7}{U}{U}{U}\"))\n        kwargs.setdefault(\n            \"rules_text\",\n            \"You may cast spells from your hand without paying their mana costs.\",\n        )\n        super().__init__(**kwargs)\n\n    def apply_continuous_effect(self, game: \"GameState\") -> None:\n        \"\"\"Register continuous effect for free casting.\"\"\"\n        source = self\n\n        def _apply(game: Any) -> None:\n            # ENGINE LIMITATION: The engine doesn't have a \"cast without\n            # paying mana cost\" hook. This is a marker effect that the\n            # casting system would need to consult.\n            if not _is_on_battlefield(game, source):\n                return\n            ctrl = getattr(source, \"controller\", None)\n            if ctrl is not None:\n                ctrl._omniscience_active = True\n\n        game.effect_manager.add(ContinuousEffect(\n            source=self,\n            layer=Layer.ABILITY,\n            sublayer=None,\n            apply=_apply,\n            duration=DURATION_PERMANENT,\n        ))\n\n===== fdn_248 =====\nThousand-Year Storm\nEnchantment\nWhenever you cast an instant or sorcery spell, copy it for each other instant and sorcery spell you've cast before it this turn. You may choose new targets for the copies.\n--- impl ---\n\"\"\"Card implementation for Thousand-Year Storm.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import Enchantment\nfrom engine.types import CardType, ManaCost\nfrom engine.events import SpellCastTriggeredEvent\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\nclass ThousandYearStorm(Enchantment):\n    \"\"\"Thousand-Year Storm — {4}{U}{R} — Enchantment.\n\n    Whenever you cast an instant or sorcery spell, copy it for each\n    other instant and sorcery spell you've cast before it this turn.\n    You may choose new targets for the copies.\n\n    FDN collector number 248.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Thousand-Year Storm')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{4}{U}{R}'))\n        kwargs.setdefault(\n            'rules_text',\n            \"Whenever you cast an instant or sorcery spell, copy it for each \"\n            \"other instant and sorcery spell you've cast before it this turn. \"\n            \"You may choose new targets for the copies.\",\n        )\n        super().__init__(**kwargs)\n\n    def register_triggers(self, game: 'GameState') -> None:\n        from engine.stack import copy_spell\n        from engine.triggers import TriggerRegistration\n\n        source = self\n        controller = getattr(self, 'controller', None) or game.active_player\n        source._storm_count: int = 0\n        source._last_turn: int = getattr(game, 'turn_number', 0)\n\n        def _condition(game: Any, event: Any) -> bool:\n            ctrl = getattr(source, 'controller', None)\n            caster = getattr(event, 'player', None) or getattr(event, 'controller', None)\n            if caster is not ctrl:\n                return False\n            spell = getattr(event, 'spell', None) or getattr(event, 'card', None)\n            if spell is None:\n                return False\n            card_types = getattr(spell, 'card_types', set())\n            if not card_types & {CardType.INSTANT, CardType.SORCERY}:\n                return False\n            current_turn = getattr(game, 'turn_number', 0)\n            if current_turn != source._last_turn:\n                source._storm_count = 0\n                source._last_turn = current_turn\n            source._pending_spell = spell\n            return True\n\n        def _effect(game: 'GameState') -> None:\n            copies_to_make = source._storm_count\n            source._storm_count += 1\n            if copies_to_make <= 0:\n                return\n            ctrl = getattr(source, 'controller', None)\n            if ctrl is None:\n                return\n            pending_spell = getattr(source, '_pending_spell', None)\n            if pending_spell is None:\n                return\n            original_so = None\n            for so in game.stack._items:\n                if so.source is pending_spell:\n                    original_so = so\n                    break\n            if original_so is None:\n                return\n            for _ in range(copies_to_make):\n                new_targets: list[Any] | None = None\n                if original_so.targets:\n                    if ctrl.choose_yes_no(\n                        f\"Choose new targets for copy of {original_so.source.name}?\"\n                    ):\n                        requirements = getattr(\n                            original_so.source, 'get_targets', lambda _: []\n                        )(game)\n                        new_targets = []\n                        for req in requirements:\n                            legal: list[Any] = []\n                            for p in game.players:\n                                for obj in game.get_battlefield(p).get_all():\n                                    if req.filter_fn(obj):\n                                        legal.append(obj)\n                                if req.filter_fn(p):\n                                    legal.append(p)\n                            if legal:\n                                chosen = ctrl.choose_target(legal, req)\n                                new_targets.append(chosen)\n                copy_obj = copy_spell(game, original_so, ctrl, new_targets)\n                game.stack.push(copy_obj)\n\n        game.trigger_manager.register(TriggerRegistration(\n            event_type=SpellCastTriggeredEvent,\n            condition=_condition,\n            effect=_effect,\n            source=self,\n            controller=controller,\n        ))\n\n===== fdn_235 =====\nWary Thespian\nCreature — Cat Druid\nWhen this creature enters or dies, surveil 1. (Look at the top card of your library. You may put it into your graveyard.)\n--- impl ---\n\"\"\"Card implementation for Wary Thespian.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import ArtifactCreature, Creature\nfrom engine.types import CardType, Keyword, ManaCost, Supertype, Zone\nfrom engine.events import CreatureDiesTriggeredEvent, EntersBattlefieldTriggeredEvent\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from cards.registry import CardRegistry\n\ndef _self_dies_condition(source: Any):\n    \"\"\"Return a condition callable that matches only when *source* dies.\"\"\"\n\n    def _condition(game: Any, event: dict) -> bool:\n        return event.creature is source\n    return _condition\n\ndef _self_etb_condition(source: Any):\n    \"\"\"Return a condition callable that matches only when *source* enters.\"\"\"\n\n    def _condition(game: Any, event: dict) -> bool:\n        return event.permanent is source\n    return _condition\n\nclass WaryThespian(Creature):\n    \"\"\"Wary Thespian — {1}{G} — 3/1 — Cat Druid\n\n    When this creature enters or dies, surveil 1.\n\n    FDN collector number 235.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Wary Thespian')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{1}{G}'))\n        kwargs.setdefault('subtypes', {'Cat', 'Druid'})\n        kwargs.setdefault('base_power', 3)\n        kwargs.setdefault('base_toughness', 1)\n        kwargs.setdefault('rules_text', 'When this creature enters or dies, surveil 1.')\n        super().__init__(**kwargs)\n\n    def register_triggers(self, game: GameState) -> None:\n        from engine.triggers import TriggerRegistration\n        source = self\n\n        def _surveil_effect(game: GameState) -> None:\n            controller = getattr(source, 'controller', None) or getattr(source, 'owner', None)\n            if controller is None:\n                return\n            library = controller.zones[Zone.LIBRARY]\n            if len(library) > 0:\n                card = library.top(1)[0]\n                library.remove(card)\n                graveyard = controller.zones[Zone.GRAVEYARD]\n                graveyard.add(card)\n        controller = getattr(self, 'controller', None) or game.active_player\n        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=_self_etb_condition(self), effect=_surveil_effect, source=self, controller=controller))\n        game.trigger_manager.register(TriggerRegistration(event_type=CreatureDiesTriggeredEvent, condition=_self_dies_condition(self), effect=_surveil_effect, source=self, controller=controller))\n\n===== fdn_81 =====\nChandra, Flameshaper\nLegendary Planeswalker — Chandra\n+2: Add {R}{R}{R}. Exile the top three cards of your library. Choose one. You may play that card this turn.\n+1: Create a token that's a copy of target creature you control, except it has haste and \"At the beginning of the end step, sacrifice this token.\"\n−4: Chandra deals 8 damage divided as you choose among any number of target creatures and/or planeswalkers.\n--- impl ---\n\"\"\"Card implementation for Chandra, Flameshaper.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import Creature, LoyaltyAbility, Planeswalker\nfrom engine.types import CardType, Keyword, ManaCost, ManaType, Supertype, Zone\nfrom engine.events import EndStepTriggeredEvent\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n    from cards.registry import CardRegistry\n\nclass ChandraFlameshaper(Planeswalker):\n    \"\"\"Chandra, Flameshaper — {5}{R}{R} — 6 loyalty.\n\n    +2: Add {R}{R}{R}. Exile top three cards. May play one this turn.\n    +1: Create a token copy of target creature you control (has haste,\n        sacrifice at end step).\n    −4: Chandra deals 8 damage divided among any number of target\n        creatures and/or planeswalkers.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Chandra, Flameshaper')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{5}{R}{R}'))\n        kwargs.setdefault('starting_loyalty', 6)\n        kwargs.setdefault('supertypes', set())\n        kwargs['supertypes'] = (kwargs.get('supertypes') or set()) | {Supertype.LEGENDARY}\n        kwargs.setdefault('subtypes', set())\n        kwargs['subtypes'] = (kwargs.get('subtypes') or set()) | {'Chandra'}\n        kwargs.setdefault('rules_text', '+2: Add {R}{R}{R}. Exile the top three cards of your library. Choose one. You may play that card this turn.\\n+1: Create a token that\\'s a copy of target creature you control, except it has haste and \"At the beginning of the end step, sacrifice this token.\"\\n−4: Chandra deals 8 damage divided as you choose among any number of target creatures and/or planeswalkers.')\n        super().__init__(**kwargs)\n\n    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n        pw = self\n\n        def _plus2(game: Any) -> None:\n            \"\"\"Add {R}{R}{R}. Exile top 3, may play one this turn.\"\"\"\n            controller = pw.controller\n            if controller is None:\n                return\n            controller.mana_pool.add(ManaType.RED, 3)\n            library = controller.zones[Zone.LIBRARY]\n            exiled_cards: list[Any] = []\n            for _ in range(min(3, len(library))):\n                cards = library.get_all()\n                if cards:\n                    card = cards[-1]\n                    library.remove(card)\n                    exile_zone = controller.zones[Zone.EXILE]\n                    exile_zone.add(card)\n                    exiled_cards.append(card)\n            if exiled_cards:\n                try:\n                    chosen = controller.choose_card(exiled_cards, 'Choose one exiled card to play this turn')\n                except Exception:\n                    chosen = exiled_cards[0]\n                if chosen is not None and chosen in exiled_cards:\n                    chosen._playable_this_turn = True\n                    chosen._playable_by = controller\n\n        def _plus1(game: Any) -> None:\n            \"\"\"Create a token copy of target creature (with haste, sacrifice at end step).\"\"\"\n            from engine.game import create_token\n            from engine.triggers import TriggerRegistration\n            target = getattr(pw, '_resolve_target', None)\n            controller = pw.controller\n            if target is None or controller is None:\n                return\n            token = Creature(name=getattr(target, 'name', 'Token'), base_power=getattr(target, 'base_power', 0), base_toughness=getattr(target, 'base_toughness', 0), subtypes=getattr(target, 'subtypes', set()).copy() if getattr(target, 'subtypes', None) else set(), keywords=getattr(target, 'keywords', Keyword(0)) | Keyword.HASTE)\n            if hasattr(target, 'card_types'):\n                token.card_types = set(target.card_types)\n            create_token(game, controller, token)\n\n            def _eot_condition(game: Any, event: dict) -> bool:\n                return True\n\n            def _eot_effect(game: Any) -> None:\n                \"\"\"Sacrifice the token at end of turn.\"\"\"\n                from engine.game import sacrifice\n                bf = game.get_battlefield(controller)\n                if bf.contains(token):\n                    sacrifice(game, controller, token)\n            game.trigger_manager.register(TriggerRegistration(event_type=EndStepTriggeredEvent, condition=_eot_condition, effect=_eot_effect, source=token, controller=controller))\n\n        def _minus4(game: Any) -> None:\n            \"\"\"Deal 8 damage divided among targets.\"\"\"\n            from engine.game import deal_damage\n            damage_assignments = getattr(pw, '_damage_assignments', None)\n            if damage_assignments:\n                for target, amount in damage_assignments:\n                    deal_damage(game, pw, target, amount)\n                return\n            targets = getattr(pw, '_resolve_targets', None)\n            if targets and len(targets) > 0:\n                damage_per = 8 // len(targets)\n                remainder = 8 % len(targets)\n                for i, t in enumerate(targets):\n                    dmg = damage_per + (1 if i < remainder else 0)\n                    deal_damage(game, pw, t, dmg)\n            else:\n                target = getattr(pw, '_resolve_target', None)\n                if target is not None:\n                    deal_damage(game, pw, target, 8)\n        return [LoyaltyAbility(loyalty_cost=+2, effect=_plus2, description='+2: Add {R}{R}{R}. Exile top 3, choose one to play this turn.'), LoyaltyAbility(loyalty_cost=+1, effect=_plus1, description='+1: Create a hasty token copy of target creature (sacrifice at end step).'), LoyaltyAbility(loyalty_cost=-4, effect=_minus4, description='−4: Deal 8 damage divided among target creatures and/or planeswalkers.')]\n\n===== fdn_244 =====\nProgenitus\nLegendary Creature — Hydra Avatar\nProtection from everything\nIf Progenitus would be put into a graveyard from anywhere, reveal Progenitus and shuffle it into its owner's library instead.\n--- impl ---\n\"\"\"Card implementation for Progenitus.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import Creature\nfrom engine.protection import ProtectionAbility\nfrom engine.events import MoveToGraveyardReplacementEvent\nfrom engine.replacement_effects import ReplacementEffect\nfrom engine.types import ManaCost, Supertype, Zone\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\nclass Progenitus(Creature):\n    \"\"\"Progenitus — {W}{W}{U}{U}{B}{B}{R}{R}{G}{G} — 10/10 — Legendary Hydra Avatar.\n\n    Protection from everything.\n    If Progenitus would be put into a graveyard from anywhere, reveal\n    Progenitus and shuffle it into its owner's library instead.\n\n    FDN collector number 244.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Progenitus')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{W}{W}{U}{U}{B}{B}{R}{R}{G}{G}'))\n        kwargs.setdefault('subtypes', {'Hydra', 'Avatar'})\n        kwargs.setdefault('supertypes', {Supertype.LEGENDARY})\n        kwargs.setdefault('base_power', 10)\n        kwargs.setdefault('base_toughness', 10)\n        kwargs.setdefault('rules_text', \"Protection from everything\\nIf Progenitus would be put into a graveyard from anywhere, reveal Progenitus and shuffle it into its owner's library instead.\")\n        super().__init__(**kwargs)\n        self._init_protection()\n\n    def _init_protection(self) -> None:\n        \"\"\"Set up protection from everything. Called from __init__ and\n        can be re-invoked after characteristic resets.\"\"\"\n        self.protections = [ProtectionAbility(quality='everything', predicate=lambda source: True)]\n\n    def _reset_characteristics(self) -> None:\n        \"\"\"Override to reapply protection from everything after reset.\"\"\"\n        super()._reset_characteristics()\n        self._init_protection()\n\n    def register_replacement_effects(self, game: 'GameState') -> None:\n        \"\"\"Register graveyard-shuffle replacement effect.\n\n        Registers a single :class:`~engine.events.MoveToGraveyardReplacementEvent`\n        handler; the engine's zone-move pipeline dispatches subclass events\n        (creature_dies, sacrifice, etc.) to this parent-type handler automatically.\n        \"\"\"\n        source = self\n\n        def _condition(game: Any, event: dict) -> bool:\n            return event.card is source\n\n        def _replacement(game: Any, event: dict) -> dict:\n            owner = getattr(source, 'owner', None)\n            if owner is not None:\n                library = owner.zones[Zone.LIBRARY]\n                library.add(source)\n                library.shuffle()\n            event.prevented = True\n            return event\n        controller = getattr(self, 'controller', None)\n        game.replacement_manager.register(ReplacementEffect(event_type=MoveToGraveyardReplacementEvent, source=self, condition=_condition, replacement=_replacement, controller=controller))\n\n===== fdn_137 =====\nAuthority of the Consuls\nEnchantment\nCreatures your opponents control enter tapped.\nWhenever a creature an opponent controls enters, you gain 1 life.\n--- impl ---\n\"\"\"Card implementation for Authority of the Consuls.\"\"\"\nfrom __future__ import annotations\nfrom dataclasses import dataclass\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import ActivatedAbility, Creature, Enchantment\nfrom engine.continuous_effects import ContinuousEffect, DURATION_PERMANENT, Layer, SubLayer\nfrom engine.types import CardType, Keyword, ManaCost, TargetRequirement, Zone\nfrom engine.events import EntersBattlefieldTriggeredEvent, GainsLifeTriggeredEvent\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from cards.registry import CardRegistry\n\ndef _is_on_battlefield(game: Any, obj: Any) -> bool:\n    \"\"\"Check if *obj* is on any player's battlefield.\"\"\"\n    for player in game.players:\n        if game.get_battlefield(player).contains(obj):\n            return True\n    return False\n\nclass AuthorityOfTheConsuls(Enchantment):\n    \"\"\"Authority of the Consuls — {W} — Creatures opponents control enter tapped.\n\n    Whenever a creature an opponent controls enters, you gain 1 life.\n\n    FDN collector number 137.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Authority of the Consuls')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{W}'))\n        kwargs.setdefault('rules_text', 'Creatures your opponents control enter tapped.\\nWhenever a creature an opponent controls enters, you gain 1 life.')\n        super().__init__(**kwargs)\n        self._effect_ref: ContinuousEffect | None = None\n\n    def on_resolve(self, game: GameState) -> None:\n        self._register_effect(game)\n\n    def _register_effect(self, game: GameState) -> None:\n        enchantment_ref = self\n\n        def _apply(game: GameState) -> None:\n            controller = enchantment_ref.controller\n            if controller is None:\n                return\n            if not _is_on_battlefield(game, enchantment_ref):\n                return\n            for player in game.players:\n                if player is controller:\n                    continue\n                for obj in game.get_battlefield(player).get_all():\n                    if CardType.CREATURE in getattr(obj, 'card_types', set()):\n                        if getattr(obj, 'summoning_sick', False):\n                            obj.is_tapped = True\n        effect = ContinuousEffect(source=enchantment_ref, layer=Layer.ABILITY, sublayer=None, apply=_apply, duration=DURATION_PERMANENT)\n        self._effect_ref = game.effect_manager.add(effect)\n\n    def register_triggers(self, game: GameState) -> None:\n        from engine.triggers import TriggerRegistration\n        source = self\n\n        def _condition(game: Any, event: dict) -> bool:\n            permanent = event.permanent\n            if permanent is None:\n                return False\n            controller = source.controller\n            if controller is None:\n                return False\n            perm_controller = getattr(permanent, 'controller', None)\n            if perm_controller is controller:\n                return False\n            return CardType.CREATURE in getattr(permanent, 'card_types', set())\n\n        def _effect(game: GameState) -> None:\n            controller = source.controller\n            if controller is None:\n                return\n            if hasattr(controller, 'life'):\n                controller.life += 1\n                game.trigger_manager.fire_event(game, GainsLifeTriggeredEvent(player=controller, amount=1))\n        controller = getattr(self, 'controller', None) or game.active_player\n        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=controller))\n\n    def register_replacement_effects(self, game: GameState) -> None:\n        if self._effect_ref is None:\n            self._register_effect(game)\n\n===== fdn_44 =====\nKaito, Cunning Infiltrator\nLegendary Planeswalker — Kaito\nWhenever a creature you control deals combat damage to a player, put a loyalty counter on Kaito.\n+1: Up to one target creature you control can't be blocked this turn. Draw a card, then discard a card.\n−2: Create a 2/1 blue Ninja creature token.\n−9: You get an emblem with \"Whenever a player casts a spell, you create a 2/1 blue Ninja creature token.\"\n--- impl ---\n\"\"\"Card implementation for Kaito, Cunning Infiltrator.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import Creature, LoyaltyAbility, Planeswalker\nfrom engine.types import CardType, Keyword, ManaCost, ManaType, Supertype, Zone\nfrom engine.events import DealsDamageTriggeredEvent, SpellCastTriggeredEvent\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n    from cards.registry import CardRegistry\n\nclass KaitoCunningInfiltrator(Planeswalker):\n    \"\"\"Kaito, Cunning Infiltrator — {1}{U}{U} — 3 loyalty.\n\n    Whenever a creature you control deals combat damage to a player, put a\n    loyalty counter on Kaito.\n    +1: Up to one target creature you control can't be blocked this turn.\n        Draw a card, then discard a card.\n    −2: Create a 2/1 blue Ninja creature token.\n    −9: You get an emblem with \"Whenever a player casts a spell, you create\n        a 2/1 blue Ninja creature token.\"\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Kaito, Cunning Infiltrator')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{1}{U}{U}'))\n        kwargs.setdefault('starting_loyalty', 3)\n        kwargs.setdefault('supertypes', set())\n        kwargs['supertypes'] = (kwargs.get('supertypes') or set()) | {Supertype.LEGENDARY}\n        kwargs.setdefault('subtypes', set())\n        kwargs['subtypes'] = (kwargs.get('subtypes') or set()) | {'Kaito'}\n        kwargs.setdefault('rules_text', 'Whenever a creature you control deals combat damage to a player, put a loyalty counter on Kaito.\\n+1: Up to one target creature you control can\\'t be blocked this turn. Draw a card, then discard a card.\\n−2: Create a 2/1 blue Ninja creature token.\\n−9: You get an emblem with \"Whenever a player casts a spell, you create a 2/1 blue Ninja creature token.\"')\n        super().__init__(**kwargs)\n\n    def register_triggers(self, game: Any) -> None:\n        \"\"\"Register passive: combat damage to a player → loyalty counter.\"\"\"\n        from engine.game import add_counter\n        from engine.triggers import TriggerRegistration\n        pw = self\n        controller = getattr(self, 'controller', None) or game.active_player\n\n        def _combat_damage_condition(game: Any, event: dict) -> bool:\n            \"\"\"Fire when a creature controlled by Kaito's controller deals damage to a player.\"\"\"\n            source = event.source\n            target = event.target\n            if not event.combat:\n                return False\n            if source is None or target is None:\n                return False\n            source_types = getattr(source, 'card_types', set())\n            if CardType.CREATURE not in source_types:\n                return False\n            if getattr(source, 'controller', None) is not pw.controller:\n                return False\n            if not hasattr(target, 'life'):\n                return False\n            return True\n\n        def _combat_damage_effect(game: Any) -> None:\n            \"\"\"Put a loyalty counter on Kaito.\"\"\"\n            add_counter(game, pw, 'loyalty', 1)\n        game.trigger_manager.register(TriggerRegistration(event_type=DealsDamageTriggeredEvent, condition=_combat_damage_condition, effect=_combat_damage_effect, source=self, controller=controller))\n\n    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n        pw = self\n\n        def _plus1(game: Any) -> None:\n            \"\"\"Up to one target creature can't be blocked. Draw then discard.\"\"\"\n            from engine.game import discard, draw_card\n            target = getattr(pw, '_resolve_target', None)\n            if target is not None:\n                target._cant_be_blocked = True\n            controller = pw.controller\n            if controller is not None:\n                drawn = draw_card(game, controller)\n                hand = controller.zones[Zone.HAND]\n                cards_in_hand = hand.get_all()\n                if cards_in_hand:\n                    card_to_discard = cards_in_hand[-1]\n                    discard(game, controller, card_to_discard)\n\n        def _minus2(game: Any) -> None:\n            \"\"\"Create a 2/1 blue Ninja creature token.\"\"\"\n            from engine.game import create_token\n            controller = pw.controller\n            if controller is not None:\n                token = Creature(name='Ninja', base_power=2, base_toughness=1, subtypes={'Ninja'})\n                create_token(game, controller, token)\n\n        def _minus9(game: Any) -> None:\n            \"\"\"Emblem — whenever a player casts a spell, create a 2/1 Ninja token.\"\"\"\n            from engine.triggers import TriggerRegistration\n            from engine.game import create_token\n            controller = pw.controller\n            if controller is None:\n                return\n            emblem = type('Emblem', (), {'name': 'Kaito Emblem'})()\n\n            def _spell_cast_condition(game: Any, event: dict) -> bool:\n                \"\"\"Always fires when any player casts a spell.\"\"\"\n                return True\n\n            def _spell_cast_effect(game: Any) -> None:\n                \"\"\"Create a 2/1 blue Ninja creature token.\"\"\"\n                token = Creature(name='Ninja', base_power=2, base_toughness=1, subtypes={'Ninja'})\n                create_token(game, controller, token)\n            game.trigger_manager.register(TriggerRegistration(event_type=SpellCastTriggeredEvent, condition=_spell_cast_condition, effect=_spell_cast_effect, source=emblem, controller=controller))\n        return [LoyaltyAbility(loyalty_cost=+1, effect=_plus1, description=\"+1: Up to one target creature can't be blocked. Draw, then discard.\"), LoyaltyAbility(loyalty_cost=-2, effect=_minus2, description='−2: Create a 2/1 blue Ninja creature token.'), LoyaltyAbility(loyalty_cost=-9, effect=_minus9, description='−9: Emblem — whenever a player casts a spell, create 2/1 Ninja token.')]\n\n===== fdn_48 =====\nRefute\nInstant\nCounter target spell. Draw a card, then discard a card.\n--- impl ---\n\"\"\"Card implementation for Refute.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import Instant\nfrom engine.types import ManaCost, TargetRequirement, Zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\ndef _get_chosen_target(card: Any, game: Any) -> Any:\n    \"\"\"Retrieve the first chosen target for a spell.\"\"\"\n    chosen = getattr(card, \"chosen_targets\", None)\n    if chosen:\n        return chosen[0]\n    return getattr(card, \"_resolve_target\", None)\n\n\ndef _counter_spell(game: \"GameState\", stack_obj: Any) -> None:\n    \"\"\"Counter a spell — remove from stack and move card to graveyard.\"\"\"\n    from engine.stack import StackObject\n\n    if not isinstance(stack_obj, StackObject):\n        return\n\n    card = stack_obj.source\n    stack_items = game.stack._items  # noqa: SLF001\n    found = False\n    for i, item in enumerate(stack_items):\n        if item is stack_obj:\n            stack_items.pop(i)\n            found = True\n            break\n\n    if not found:\n        return\n\n    controller = stack_obj.controller\n    owner = getattr(card, \"owner\", controller)\n\n    if controller is not None:\n        stack_zone = controller.zones[Zone.STACK]\n        if stack_zone.contains(card):\n            stack_zone.remove(card)\n\n    if owner is not None:\n        graveyard = owner.zones[Zone.GRAVEYARD]\n        graveyard.add(card)\n\n\nclass Refute(Instant):\n    \"\"\"Refute — {1}{U}{U} — Instant.\n\n    Counter target spell. Draw a card, then discard a card.\n\n    FDN collector number 48.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"Refute\")\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{U}{U}\"))\n        kwargs.setdefault(\n            \"rules_text\",\n            \"Counter target spell. Draw a card, then discard a card.\",\n        )\n        super().__init__(**kwargs)\n\n    def can_cast(self, game: \"GameState\") -> bool:\n        \"\"\"Cannot cast unless there's a spell on the stack to counter.\"\"\"\n        from engine.stack import StackObject\n\n        for stack_obj in game.stack.objects():\n            source = stack_obj.source\n            if source is self:\n                continue\n            # Only target spells (not triggered/activated abilities)\n            if getattr(stack_obj, \"is_spell\", True):\n                return True\n        return False\n\n    def get_targets(self, game: \"GameState\") -> list:\n        \"\"\"Target spell on the stack.\"\"\"\n        from engine.stack import StackObject\n\n        targets = []\n        for stack_obj in game.stack.objects():\n            source = stack_obj.source\n            if source is self:\n                continue\n            if getattr(stack_obj, \"is_spell\", True):\n                targets.append(stack_obj)\n        if not targets:\n            return []\n        return [\n            TargetRequirement(\n                filter_fn=lambda obj: obj is not self and getattr(obj, \"is_spell\", True),\n                description=\"target spell\",\n                zone=Zone.STACK,\n            )\n        ]\n\n    def on_resolve(self, game: \"GameState\") -> None:\n        \"\"\"Counter target spell, then draw a card, then discard a card.\"\"\"\n        from engine.game import discard, draw_card\n\n        target = _get_chosen_target(self, game)\n        # Single-target spell fizzles if target is illegal\n        if target is None:\n            return\n        if target is not None:\n            _counter_spell(game, target)\n\n        controller = self.controller\n        if controller is None:\n            return\n\n        # Draw a card\n        draw_card(game, controller)\n\n        # Discard a card\n        hand = controller.zones[Zone.HAND]\n        cards_in_hand = list(hand.get_all())\n        if cards_in_hand:\n            try:\n                chosen = controller.choose_card(\n                    cards_in_hand, \"Choose a card to discard\"\n                )\n            except Exception:\n                chosen = cards_in_hand[0] if cards_in_hand else None\n            if chosen is not None:\n                discard(game, controller, chosen)\n\n","numLines":929,"startLine":1,"totalLines":929}}}
