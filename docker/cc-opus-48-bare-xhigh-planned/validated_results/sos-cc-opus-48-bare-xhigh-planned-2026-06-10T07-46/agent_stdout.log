{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01DiBMtCFLoBecsQbSf6Aw6x","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LvzW5X6Tikd7UEjz8M66YU","name":"Read","input":{"file_path":"/workspace/engine/abilities.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12356,"cache_read_input_tokens":83761,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12356},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"88686e67-15f6-420e-923b-5a5a834e5552","uuid":"0615871a-1fa4-4fc9-958e-d1190353344a","request_id":"req_011CbuD63TopCzimVautomnb"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LvzW5X6Tikd7UEjz8M66YU","type":"tool_result","content":"1\t\"\"\"Activated abilities system — tap-for-mana, loyalty abilities, and general\n2\tactivated abilities that go on the stack (or resolve immediately for mana\n3\tabilities).\n4\t\n5\tProvides:\n6\t\n7\t- :func:`activate_ability` — verify timing → pay costs → resolve immediately\n8\t  (mana abilities) or push to the stack (non-mana abilities).\n9\t- :func:`tap_cost` — generic tap-cost helper: checks ``not source.is_tapped``\n10\t  and taps the source.\n11\t- :class:`ActivatedAbilityInstance` — a runtime representation of an activated\n12\t  ability with source, controller, cost/effect callables, and metadata.\n13\t- :class:`LoyaltyAbilityInstance` — activated ability variant for planeswalker\n14\t  loyalty abilities with per-turn restriction and loyalty-counter cost.\n15\t\"\"\"\n16\t\n17\tfrom __future__ import annotations\n18\t\n19\tfrom dataclasses import dataclass, field\n20\tfrom typing import TYPE_CHECKING, Any, Callable\n21\t\n22\tfrom engine.casting import is_sorcery_speed\n23\tfrom engine.stack import StackObject\n24\t\n25\tif TYPE_CHECKING:\n26\t    from engine.game_state import GameState\n27\t    from engine.player import Player\n28\t\n29\t\n30\tclass AbilityError(Exception):\n31\t    \"\"\"Raised when an ability activation is illegal.\"\"\"\n32\t\n33\t\n34\t# ---------------------------------------------------------------------------\n35\t# Runtime ability representations\n36\t# ---------------------------------------------------------------------------\n37\t\n38\t@dataclass\n39\tclass ActivatedAbilityInstance:\n40\t    \"\"\"Runtime representation of an activated ability.\n41\t\n42\t    This captures everything needed to activate and resolve an ability:\n43\t    the source permanent, the controlling player, cost/effect callables,\n44\t    and whether the ability is a mana ability.\n45\t\n46\t    Attributes:\n47\t        source: The permanent that has this ability.\n48\t        controller: The player who controls the source.\n49\t        cost: A callable ``(game, source) -> bool`` that checks and pays\n50\t            the cost. Returns ``True`` if the cost was successfully paid,\n51\t            ``False`` otherwise.\n52\t        effect: A callable ``(game) -> None`` that applies the ability's\n53\t            effect when it resolves.\n54\t        is_mana_ability: Whether this is a mana ability (resolves\n55\t            immediately without using the stack).\n56\t        description: Human-readable description of the ability.\n57\t    \"\"\"\n58\t\n59\t    source: Any\n60\t    controller: Any  # Player\n61\t    cost: Callable[..., bool]\n62\t    effect: Callable[..., None]\n63\t    is_mana_ability: bool = False\n64\t    description: str = \"\"\n65\t\n66\t\n67\t@dataclass\n68\tclass LoyaltyAbilityInstance:\n69\t    \"\"\"Runtime representation of a planeswalker loyalty ability.\n70\t\n71\t    Loyalty abilities are activated abilities with special restrictions:\n72\t    they may only be activated at sorcery speed, and only once per turn\n73\t    per source (tracked via ``_activated_this_turn``).\n74\t\n75\t    The cost adjusts the loyalty counters on the source planeswalker.\n76\t\n77\t    Attributes:\n78\t        source: The planeswalker permanent.\n79\t        controller: The player who controls the planeswalker.\n80\t        loyalty_cost: The loyalty adjustment (positive for ``+N``,\n81\t            negative for ``−N``, zero for ``0``).\n82\t        effect: A callable ``(game) -> None`` for the ability's effect.\n83\t        description: Human-readable description.\n84\t    \"\"\"\n85\t\n86\t    source: Any\n87\t    controller: Any  # Player\n88\t    loyalty_cost: int = 0\n89\t    effect: Callable[..., None] = field(default=lambda _game: None)\n90\t    description: str = \"\"\n91\t\n92\t\n93\t# ---------------------------------------------------------------------------\n94\t# Per-turn loyalty tracking\n95\t# ---------------------------------------------------------------------------\n96\t\n97\t# Set of (object_id, turn_number) pairs that have already activated a\n98\t# loyalty ability this turn.  Callers should call\n99\t# ``clear_loyalty_tracking()`` at the start of each turn or manage the\n100\t# set externally.\n101\t_loyalty_activated_this_turn: set[tuple[int, int]] = set()\n102\t\n103\t\n104\tdef clear_loyalty_tracking() -> None:\n105\t    \"\"\"Clear the loyalty-activated-this-turn tracker.\n106\t\n107\t    Should be called at the start of each turn so that planeswalkers may\n108\t    activate loyalty abilities again.\n109\t    \"\"\"\n110\t    _loyalty_activated_this_turn.clear()\n111\t\n112\t\n113\tdef _has_activated_loyalty_this_turn(source: Any, turn_number: int) -> bool:\n114\t    \"\"\"Return ``True`` if *source* already used a loyalty ability this turn.\"\"\"\n115\t    obj_id = getattr(source, \"object_id\", id(source))\n116\t    return (obj_id, turn_number) in _loyalty_activated_this_turn\n117\t\n118\t\n119\tdef _mark_loyalty_activated(source: Any, turn_number: int) -> None:\n120\t    \"\"\"Record that *source* used a loyalty ability this turn.\"\"\"\n121\t    obj_id = getattr(source, \"object_id\", id(source))\n122\t    _loyalty_activated_this_turn.add((obj_id, turn_number))\n123\t\n124\t\n125\t# ---------------------------------------------------------------------------\n126\t# Tap cost helper\n127\t# ---------------------------------------------------------------------------\n128\t\n129\tdef tap_cost(game: GameState, source: Any) -> bool:\n130\t    \"\"\"Generic tap-cost function.\n131\t\n132\t    Checks that the source is not already tapped.  If untapped, taps it\n133\t    (sets ``source.is_tapped = True``) and returns ``True``.  If already\n134\t    tapped, returns ``False`` (cost cannot be paid).\n135\t\n136\t    Parameters:\n137\t        game: The current game state (unused here but kept for a\n138\t            consistent ``(game, source) -> bool`` cost signature).\n139\t        source: The permanent to tap.\n140\t\n141\t    Returns:\n142\t        ``True`` if the cost was successfully paid (source was untapped\n143\t        and is now tapped), ``False`` otherwise.\n144\t    \"\"\"\n145\t    if getattr(source, \"is_tapped\", False):\n146\t        return False\n147\t    source.is_tapped = True\n148\t    return True\n149\t\n150\t\n151\t# ---------------------------------------------------------------------------\n152\t# Activate ability — main entry point\n153\t# ---------------------------------------------------------------------------\n154\t\n155\tdef activate_ability(\n156\t    game: GameState,\n157\t    player: Any,  # Player\n158\t    ability: ActivatedAbilityInstance | LoyaltyAbilityInstance,\n159\t) -> None:\n160\t    \"\"\"Activate an ability.\n161\t\n162\t    Pipeline\n163\t    --------\n164\t    1. **Timing check** — mana abilities bypass timing entirely and\n165\t       resolve immediately.  Regular (non-mana) activated abilities\n166\t       can be activated whenever a player has priority (instant speed);\n167\t       priority enforcement is handled externally by\n168\t       ``priority_loop``, not here.  **Only loyalty abilities** carry\n169\t       a sorcery-speed restriction.\n170\t    2. **Pay costs** — invoke the ability's cost callable.  For loyalty\n171\t       abilities, adjust loyalty counters and enforce once-per-turn.\n172\t    3. **Resolve or push to stack** — mana abilities resolve\n173\t       immediately; all other abilities are pushed onto the game stack\n174\t       as :class:`StackObject` instances.\n175\t\n176\t    Parameters:\n177\t        game: The current game state.\n178\t        player: The player activating the ability.\n179\t        ability: The ability to activate (an\n180\t            :class:`ActivatedAbilityInstance` or\n181\t            :class:`LoyaltyAbilityInstance`).\n182\t\n183\t    Raises:\n184\t        AbilityError: If the activation is illegal (timing, cost, or\n185\t            once-per-turn restriction).\n186\t    \"\"\"\n187\t    if isinstance(ability, LoyaltyAbilityInstance):\n188\t        _activate_loyalty_ability(game, player, ability)\n189\t    elif isinstance(ability, ActivatedAbilityInstance):\n190\t        _activate_regular_ability(game, player, ability)\n191\t    else:\n192\t        raise AbilityError(f\"Unknown ability type: {type(ability)}\")\n193\t\n194\t\n195\t# ---------------------------------------------------------------------------\n196\t# Internal helpers\n197\t# ---------------------------------------------------------------------------\n198\t\n199\tdef _activate_regular_ability(\n200\t    game: GameState,\n201\t    player: Any,\n202\t    ability: ActivatedAbilityInstance,\n203\t) -> None:\n204\t    \"\"\"Activate a regular (non-loyalty) activated ability.\"\"\"\n205\t    # 1. Check \"can't activate\" restriction (e.g. Arrest).\n206\t    if getattr(ability.source, \"_cant_activate\", False):\n207\t        raise AbilityError(\n208\t            \"Cannot activate ability — source's activated abilities are suppressed\"\n209\t        )\n210\t\n211\t    # 2. Pay costs\n212\t    cost_paid = ability.cost(game, ability.source)\n213\t    if not cost_paid:\n214\t        raise AbilityError(\"Cannot activate ability — cost could not be paid\")\n215\t\n216\t    # 3. Resolve or push\n217\t    if ability.is_mana_ability:\n218\t        # Mana abilities resolve immediately without using the stack.\n219\t        ability.effect(game)\n220\t    else:\n221\t        # Push to stack for resolution.\n222\t        stack_obj = StackObject(\n223\t            source=ability.source,\n224\t            controller=player,\n225\t            on_resolve=ability.effect,\n226\t            is_mana_ability=False,\n227\t        )\n228\t        game.stack.push(stack_obj)\n229\t\n230\t\n231\tdef _activate_loyalty_ability(\n232\t    game: GameState,\n233\t    player: Any,\n234\t    ability: LoyaltyAbilityInstance,\n235\t) -> None:\n236\t    \"\"\"Activate a planeswalker loyalty ability.\"\"\"\n237\t    source = ability.source\n238\t\n239\t    # 1. Timing — loyalty abilities are sorcery speed only.\n240\t    if not is_sorcery_speed(game, player):\n241\t        raise AbilityError(\n242\t            \"Cannot activate loyalty ability — sorcery-speed timing not met\"\n243\t        )\n244\t\n245\t    # 2. Once-per-turn restriction.\n246\t    turn_number = getattr(game, \"turn_number\", 0)\n247\t    if _has_activated_loyalty_this_turn(source, turn_number):\n248\t        raise AbilityError(\n249\t            \"Cannot activate loyalty ability — already activated this turn\"\n250\t        )\n251\t\n252\t    # 3. Pay loyalty cost.\n253\t    current_loyalty = getattr(source, \"loyalty\", 0)\n254\t    new_loyalty = current_loyalty + ability.loyalty_cost\n255\t    if new_loyalty < 0:\n256\t        raise AbilityError(\n257\t            f\"Cannot activate loyalty ability — insufficient loyalty \"\n258\t            f\"(have {current_loyalty}, need {-ability.loyalty_cost})\"\n259\t        )\n260\t    source.loyalty = new_loyalty\n261\t\n262\t    # 4. Mark as activated this turn.\n263\t    _mark_loyalty_activated(source, turn_number)\n264\t\n265\t    # 5. Push to stack.\n266\t    stack_obj = StackObject(\n267\t        source=source,\n268\t        controller=player,\n269\t        on_resolve=ability.effect,\n270\t        is_mana_ability=False,\n271\t    )\n272\t    game.stack.push(stack_obj)\n273\t"}]},"parent_tool_use_id":null,"session_id":"88686e67-15f6-420e-923b-5a5a834e5552","uuid":"4a5969b7-a6b6-4d6c-99d6-650a0b514eea","timestamp":"2026-06-10T07:47:02.241Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/abilities.py","content":"\"\"\"Activated abilities system — tap-for-mana, loyalty abilities, and general\nactivated abilities that go on the stack (or resolve immediately for mana\nabilities).\n\nProvides:\n\n- :func:`activate_ability` — verify timing → pay costs → resolve immediately\n  (mana abilities) or push to the stack (non-mana abilities).\n- :func:`tap_cost` — generic tap-cost helper: checks ``not source.is_tapped``\n  and taps the source.\n- :class:`ActivatedAbilityInstance` — a runtime representation of an activated\n  ability with source, controller, cost/effect callables, and metadata.\n- :class:`LoyaltyAbilityInstance` — activated ability variant for planeswalker\n  loyalty abilities with per-turn restriction and loyalty-counter cost.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom typing import TYPE_CHECKING, Any, Callable\n\nfrom engine.casting import is_sorcery_speed\nfrom engine.stack import StackObject\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\nclass AbilityError(Exception):\n    \"\"\"Raised when an ability activation is illegal.\"\"\"\n\n\n# ---------------------------------------------------------------------------\n# Runtime ability representations\n# ---------------------------------------------------------------------------\n\n@dataclass\nclass ActivatedAbilityInstance:\n    \"\"\"Runtime representation of an activated ability.\n\n    This captures everything needed to activate and resolve an ability:\n    the source permanent, the controlling player, cost/effect callables,\n    and whether the ability is a mana ability.\n\n    Attributes:\n        source: The permanent that has this ability.\n        controller: The player who controls the source.\n        cost: A callable ``(game, source) -> bool`` that checks and pays\n            the cost. Returns ``True`` if the cost was successfully paid,\n            ``False`` otherwise.\n        effect: A callable ``(game) -> None`` that applies the ability's\n            effect when it resolves.\n        is_mana_ability: Whether this is a mana ability (resolves\n            immediately without using the stack).\n        description: Human-readable description of the ability.\n    \"\"\"\n\n    source: Any\n    controller: Any  # Player\n    cost: Callable[..., bool]\n    effect: Callable[..., None]\n    is_mana_ability: bool = False\n    description: str = \"\"\n\n\n@dataclass\nclass LoyaltyAbilityInstance:\n    \"\"\"Runtime representation of a planeswalker loyalty ability.\n\n    Loyalty abilities are activated abilities with special restrictions:\n    they may only be activated at sorcery speed, and only once per turn\n    per source (tracked via ``_activated_this_turn``).\n\n    The cost adjusts the loyalty counters on the source planeswalker.\n\n    Attributes:\n        source: The planeswalker permanent.\n        controller: The player who controls the planeswalker.\n        loyalty_cost: The loyalty adjustment (positive for ``+N``,\n            negative for ``−N``, zero for ``0``).\n        effect: A callable ``(game) -> None`` for the ability's effect.\n        description: Human-readable description.\n    \"\"\"\n\n    source: Any\n    controller: Any  # Player\n    loyalty_cost: int = 0\n    effect: Callable[..., None] = field(default=lambda _game: None)\n    description: str = \"\"\n\n\n# ---------------------------------------------------------------------------\n# Per-turn loyalty tracking\n# ---------------------------------------------------------------------------\n\n# Set of (object_id, turn_number) pairs that have already activated a\n# loyalty ability this turn.  Callers should call\n# ``clear_loyalty_tracking()`` at the start of each turn or manage the\n# set externally.\n_loyalty_activated_this_turn: set[tuple[int, int]] = set()\n\n\ndef clear_loyalty_tracking() -> None:\n    \"\"\"Clear the loyalty-activated-this-turn tracker.\n\n    Should be called at the start of each turn so that planeswalkers may\n    activate loyalty abilities again.\n    \"\"\"\n    _loyalty_activated_this_turn.clear()\n\n\ndef _has_activated_loyalty_this_turn(source: Any, turn_number: int) -> bool:\n    \"\"\"Return ``True`` if *source* already used a loyalty ability this turn.\"\"\"\n    obj_id = getattr(source, \"object_id\", id(source))\n    return (obj_id, turn_number) in _loyalty_activated_this_turn\n\n\ndef _mark_loyalty_activated(source: Any, turn_number: int) -> None:\n    \"\"\"Record that *source* used a loyalty ability this turn.\"\"\"\n    obj_id = getattr(source, \"object_id\", id(source))\n    _loyalty_activated_this_turn.add((obj_id, turn_number))\n\n\n# ---------------------------------------------------------------------------\n# Tap cost helper\n# ---------------------------------------------------------------------------\n\ndef tap_cost(game: GameState, source: Any) -> bool:\n    \"\"\"Generic tap-cost function.\n\n    Checks that the source is not already tapped.  If untapped, taps it\n    (sets ``source.is_tapped = True``) and returns ``True``.  If already\n    tapped, returns ``False`` (cost cannot be paid).\n\n    Parameters:\n        game: The current game state (unused here but kept for a\n            consistent ``(game, source) -> bool`` cost signature).\n        source: The permanent to tap.\n\n    Returns:\n        ``True`` if the cost was successfully paid (source was untapped\n        and is now tapped), ``False`` otherwise.\n    \"\"\"\n    if getattr(source, \"is_tapped\", False):\n        return False\n    source.is_tapped = True\n    return True\n\n\n# ---------------------------------------------------------------------------\n# Activate ability — main entry point\n# ---------------------------------------------------------------------------\n\ndef activate_ability(\n    game: GameState,\n    player: Any,  # Player\n    ability: ActivatedAbilityInstance | LoyaltyAbilityInstance,\n) -> None:\n    \"\"\"Activate an ability.\n\n    Pipeline\n    --------\n    1. **Timing check** — mana abilities bypass timing entirely and\n       resolve immediately.  Regular (non-mana) activated abilities\n       can be activated whenever a player has priority (instant speed);\n       priority enforcement is handled externally by\n       ``priority_loop``, not here.  **Only loyalty abilities** carry\n       a sorcery-speed restriction.\n    2. **Pay costs** — invoke the ability's cost callable.  For loyalty\n       abilities, adjust loyalty counters and enforce once-per-turn.\n    3. **Resolve or push to stack** — mana abilities resolve\n       immediately; all other abilities are pushed onto the game stack\n       as :class:`StackObject` instances.\n\n    Parameters:\n        game: The current game state.\n        player: The player activating the ability.\n        ability: The ability to activate (an\n            :class:`ActivatedAbilityInstance` or\n            :class:`LoyaltyAbilityInstance`).\n\n    Raises:\n        AbilityError: If the activation is illegal (timing, cost, or\n            once-per-turn restriction).\n    \"\"\"\n    if isinstance(ability, LoyaltyAbilityInstance):\n        _activate_loyalty_ability(game, player, ability)\n    elif isinstance(ability, ActivatedAbilityInstance):\n        _activate_regular_ability(game, player, ability)\n    else:\n        raise AbilityError(f\"Unknown ability type: {type(ability)}\")\n\n\n# ---------------------------------------------------------------------------\n# Internal helpers\n# ---------------------------------------------------------------------------\n\ndef _activate_regular_ability(\n    game: GameState,\n    player: Any,\n    ability: ActivatedAbilityInstance,\n) -> None:\n    \"\"\"Activate a regular (non-loyalty) activated ability.\"\"\"\n    # 1. Check \"can't activate\" restriction (e.g. Arrest).\n    if getattr(ability.source, \"_cant_activate\", False):\n        raise AbilityError(\n            \"Cannot activate ability — source's activated abilities are suppressed\"\n        )\n\n    # 2. Pay costs\n    cost_paid = ability.cost(game, ability.source)\n    if not cost_paid:\n        raise AbilityError(\"Cannot activate ability — cost could not be paid\")\n\n    # 3. Resolve or push\n    if ability.is_mana_ability:\n        # Mana abilities resolve immediately without using the stack.\n        ability.effect(game)\n    else:\n        # Push to stack for resolution.\n        stack_obj = StackObject(\n            source=ability.source,\n            controller=player,\n            on_resolve=ability.effect,\n            is_mana_ability=False,\n        )\n        game.stack.push(stack_obj)\n\n\ndef _activate_loyalty_ability(\n    game: GameState,\n    player: Any,\n    ability: LoyaltyAbilityInstance,\n) -> None:\n    \"\"\"Activate a planeswalker loyalty ability.\"\"\"\n    source = ability.source\n\n    # 1. Timing — loyalty abilities are sorcery speed only.\n    if not is_sorcery_speed(game, player):\n        raise AbilityError(\n            \"Cannot activate loyalty ability — sorcery-speed timing not met\"\n        )\n\n    # 2. Once-per-turn restriction.\n    turn_number = getattr(game, \"turn_number\", 0)\n    if _has_activated_loyalty_this_turn(source, turn_number):\n        raise AbilityError(\n            \"Cannot activate loyalty ability — already activated this turn\"\n        )\n\n    # 3. Pay loyalty cost.\n    current_loyalty = getattr(source, \"loyalty\", 0)\n    new_loyalty = current_loyalty + ability.loyalty_cost\n    if new_loyalty < 0:\n        raise AbilityError(\n            f\"Cannot activate loyalty ability — insufficient loyalty \"\n            f\"(have {current_loyalty}, need {-ability.loyalty_cost})\"\n        )\n    source.loyalty = new_loyalty\n\n    # 4. Mark as activated this turn.\n    _mark_loyalty_activated(source, turn_number)\n\n    # 5. Push to stack.\n    stack_obj = StackObject(\n        source=source,\n        controller=player,\n        on_resolve=ability.effect,\n        is_mana_ability=False,\n    )\n    game.stack.push(stack_obj)\n","numLines":273,"startLine":1,"totalLines":273}}}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01DiBMtCFLoBecsQbSf6Aw6x","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011FT1qGNt6AxXR7EDx2kFAg","name":"Read","input":{"file_path":"/workspace/engine/turn.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12356,"cache_read_input_tokens":83761,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12356},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"88686e67-15f6-420e-923b-5a5a834e5552","uuid":"15f5e2c1-42c3-4a3a-9c97-6205675966cc","request_id":"req_011CbuD63TopCzimVautomnb"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011FT1qGNt6AxXR7EDx2kFAg","type":"tool_result","content":"1\t\"\"\"Turn execution loop for the SilverquiLLM engine.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport warnings\n6\tfrom typing import TYPE_CHECKING\n7\t\n8\tif TYPE_CHECKING:\n9\t    from engine.game_state import GameState\n10\t\n11\tfrom engine.stack import priority_loop\n12\tfrom engine.types import Phase, Step, Zone\n13\t\n14\t\n15\t# Maximum hand size — players discard down to this during cleanup.\n16\tMAX_HAND_SIZE: int = 7\n17\t\n18\t\n19\t# Steps/phases where priority is given to players.\n20\t# In MTG, players do NOT receive priority during Untap and Cleanup (normally).\n21\t_NO_PRIORITY_STEPS: set[tuple[Phase, Step | None]] = {\n22\t    (Phase.BEGINNING, Step.UNTAP),\n23\t    (Phase.ENDING, Step.CLEANUP),\n24\t}\n25\t\n26\t\n27\tdef _do_untap_step(game: GameState) -> None:\n28\t    \"\"\"Perform untap step actions: untap all permanents controlled by the active player.\n29\t\n30\t    Per MTG rules, the active player untaps all permanents they control\n31\t    during their untap step. Summoning sickness is also cleared at this point.\n32\t    \"\"\"\n33\t    active = game.active_player\n34\t    bf = active.zones[Zone.BATTLEFIELD]\n35\t    for obj in bf.get_all():\n36\t        if hasattr(obj, \"is_tapped\"):\n37\t            obj.is_tapped = False\n38\t        if hasattr(obj, \"summoning_sick\"):\n39\t            obj.summoning_sick = False\n40\t\n41\t    # Reset land plays for the active player\n42\t    active.land_plays_remaining = 1\n43\t\n44\t\n45\tdef _do_draw_step(game: GameState) -> None:\n46\t    \"\"\"Perform draw step actions: active player draws a card.\n47\t\n48\t    In a two-player game, the starting player (the player who takes\n49\t    turn 1) skips their draw step on that first turn.  This is per\n50\t    MTG comprehensive rules §103.7a.\n51\t    \"\"\"\n52\t    # The starting player skips their draw on turn 1.\n53\t    if game.turn_number == 1 and game.active_player_index == 0:\n54\t        return\n55\t\n56\t    from engine.game import draw_card\n57\t\n58\t    draw_card(game, game.active_player)\n59\t\n60\t\n61\tdef _do_combat_step(game: GameState, step: Step) -> None:\n62\t    \"\"\"Dispatch combat sub-steps to the appropriate combat functions.\n63\t\n64\t    Parameters:\n65\t        game: The current game state.\n66\t        step: The combat step to execute.\n67\t    \"\"\"\n68\t    from engine.combat import (\n69\t        combat_damage_step,\n70\t        declare_attackers_step,\n71\t        declare_blockers_step,\n72\t        end_combat_step,\n73\t    )\n74\t\n75\t    if step == Step.DECLARE_ATTACKERS:\n76\t        declare_attackers_step(game)\n77\t    elif step == Step.DECLARE_BLOCKERS:\n78\t        declare_blockers_step(game)\n79\t    elif step == Step.COMBAT_DAMAGE:\n80\t        combat_damage_step(game)\n81\t    elif step == Step.END_COMBAT:\n82\t        end_combat_step(game)\n83\t\n84\t\n85\tdef _do_cleanup_step(game: GameState) -> None:\n86\t    \"\"\"Perform the cleanup step (MTG rule §514).\n87\t\n88\t    The cleanup step executes the following actions in order:\n89\t\n90\t    1. Active player discards down to maximum hand size (7) using\n91\t       :meth:`Player.choose_card`.\n92\t    2. Remove all \"until end of turn\" continuous effects via\n93\t       :meth:`EffectManager.remove_expired`, then reapply remaining\n94\t       effects for a consistent game state.\n95\t    3. Clear damage marked on all creatures on the battlefield.\n96\t    4. Clear combat-related flags (``dealt_deathtouch_damage``,\n97\t       ``is_attacking``, ``is_blocking``) and reset the combat state.\n98\t    5. Empty all players' mana pools.\n99\t    6. Check state-based actions.\n100\t    7. If triggers fired during cleanup (e.g. from discarding), process\n101\t       them (give priority, resolve stack) and perform another cleanup step.\n102\t    \"\"\"\n103\t    from engine.game import discard as _discard\n104\t    from engine.player import ScriptExhaustedError\n105\t    from engine.state_based_actions import resolve_state_based_actions\n106\t\n107\t    # --- Step 1: Discard to hand size ---\n108\t    active = game.active_player\n109\t    hand = active.zones[Zone.HAND]\n110\t    while len(hand) > MAX_HAND_SIZE:\n111\t        cards_in_hand = hand.get_all()\n112\t        if not cards_in_hand:\n113\t            break  # safety guard\n114\t        try:\n115\t            chosen = active.choose_card(cards_in_hand, \"discard to hand size\")\n116\t        except (ScriptExhaustedError, NotImplementedError) as exc:\n117\t            # Player implementation doesn't support choose_card or script\n118\t            # was exhausted.  Discard deterministically from end.\n119\t            chosen = cards_in_hand[-1]\n120\t            exc_name = type(exc).__name__\n121\t            warnings.warn(\n122\t                f\"{exc_name} during cleanup discard for {active.name}; \"\n123\t                f\"auto-discarding {chosen.name}\"\n124\t            )\n125\t        if chosen is not None and hand.contains(chosen):\n126\t            _discard(game, active, chosen)\n127\t        else:\n128\t            # If choose_card returns something invalid, discard the last card\n129\t            # to avoid an infinite loop.\n130\t            _discard(game, active, cards_in_hand[-1])\n131\t\n132\t    # --- Step 2: Remove \"until end of turn\" continuous effects ---\n133\t    if hasattr(game, \"effect_manager\"):\n134\t        game.effect_manager.remove_expired(game)\n135\t        # Reapply remaining effects so the game state is consistent.\n136\t        game.effect_manager.apply_all(game)\n137\t\n138\t    # --- Step 3: Clear damage on all creatures ---\n139\t    for player in game.players:\n140\t        bf = player.zones[Zone.BATTLEFIELD]\n141\t        for obj in bf.get_all():\n142\t            if hasattr(obj, \"damage_marked\"):\n143\t                obj.damage_marked = 0\n144\t\n145\t    # --- Step 4: Clear combat flags ---\n146\t    for player in game.players:\n147\t        bf = player.zones[Zone.BATTLEFIELD]\n148\t        for obj in bf.get_all():\n149\t            if hasattr(obj, \"dealt_deathtouch_damage\"):\n150\t                obj.dealt_deathtouch_damage = False\n151\t            if hasattr(obj, \"is_attacking\"):\n152\t                obj.is_attacking = False\n153\t            if hasattr(obj, \"is_blocking\"):\n154\t                obj.is_blocking = False\n155\t    # Reset the CombatState itself.\n156\t    if hasattr(game, \"combat_state\"):\n157\t        game.combat_state.clear()\n158\t\n159\t    # --- Step 5: Empty mana pools ---\n160\t    game.empty_mana_pools()\n161\t\n162\t    # --- Step 6: Check state-based actions ---\n163\t    sba_happened = resolve_state_based_actions(game)\n164\t\n165\t    # --- Step 7: If SBAs were performed or triggers fired, process & repeat ---\n166\t    # Rule 514.3a: if state-based actions were performed or triggered abilities\n167\t    # triggered during cleanup, another cleanup step occurs.\n168\t    if sba_happened or not game.stack.is_empty():\n169\t        # Triggers were placed on the stack — give priority and resolve.\n170\t        priority_loop(game)\n171\t        # After resolving, perform another cleanup step (recursive).\n172\t        _do_cleanup_step(game)\n173\t\n174\t\n175\tdef run_turn(game: GameState) -> None:\n176\t    \"\"\"Execute a full turn, iterating through all phases/steps.\n177\t\n178\t    At each priority point (every phase/step except Untap and Cleanup),\n179\t    :func:`priority_loop` is called.  Turn-based actions are performed\n180\t    at the appropriate steps:\n181\t\n182\t    - **Untap**: Untap all permanents, clear summoning sickness, reset\n183\t      land plays.\n184\t    - **Draw**: Active player draws a card.\n185\t    - **Combat**: Delegate to combat system functions.\n186\t    - **Cleanup**: Clear damage, remove expired effects.\n187\t\n188\t    After the last step (Cleanup), the turn number is incremented and\n189\t    the active player swaps via :meth:`GameState.advance_phase`.\n190\t\n191\t    Parameters:\n192\t        game: The game state to advance through one complete turn.\n193\t    \"\"\"\n194\t    start_turn = game.turn_number\n195\t\n196\t    while game.turn_number == start_turn:\n197\t        current = (game.phase, game.step)\n198\t\n199\t        # Perform turn-based actions for the current step\n200\t        if current == (Phase.BEGINNING, Step.UNTAP):\n201\t            _do_untap_step(game)\n202\t        elif current == (Phase.BEGINNING, Step.UPKEEP):\n203\t            from engine.events import BeginningOfUpkeepTriggeredEvent\n204\t            game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n205\t        elif current == (Phase.BEGINNING, Step.DRAW):\n206\t            _do_draw_step(game)\n207\t        elif game.phase == Phase.COMBAT and game.step is not None:\n208\t            _do_combat_step(game, game.step)\n209\t        elif current == (Phase.ENDING, Step.CLEANUP):\n210\t            _do_cleanup_step(game)\n211\t\n212\t        # Grant priority at this phase/step unless it's Untap or Cleanup.\n213\t        if current not in _NO_PRIORITY_STEPS:\n214\t            priority_loop(game)\n215\t\n216\t        # Advance to the next phase/step (or to next turn).\n217\t        game.advance_phase()\n218\t"}]},"parent_tool_use_id":null,"session_id":"88686e67-15f6-420e-923b-5a5a834e5552","uuid":"15cd71a1-4c18-4792-a384-64577c88dd15","timestamp":"2026-06-10T07:47:02.643Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/turn.py","content":"\"\"\"Turn execution loop for the SilverquiLLM engine.\"\"\"\n\nfrom __future__ import annotations\n\nimport warnings\nfrom typing import TYPE_CHECKING\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\nfrom engine.stack import priority_loop\nfrom engine.types import Phase, Step, Zone\n\n\n# Maximum hand size — players discard down to this during cleanup.\nMAX_HAND_SIZE: int = 7\n\n\n# Steps/phases where priority is given to players.\n# In MTG, players do NOT receive priority during Untap and Cleanup (normally).\n_NO_PRIORITY_STEPS: set[tuple[Phase, Step | None]] = {\n    (Phase.BEGINNING, Step.UNTAP),\n    (Phase.ENDING, Step.CLEANUP),\n}\n\n\ndef _do_untap_step(game: GameState) -> None:\n    \"\"\"Perform untap step actions: untap all permanents controlled by the active player.\n\n    Per MTG rules, the active player untaps all permanents they control\n    during their untap step. Summoning sickness is also cleared at this point.\n    \"\"\"\n    active = game.active_player\n    bf = active.zones[Zone.BATTLEFIELD]\n    for obj in bf.get_all():\n        if hasattr(obj, \"is_tapped\"):\n            obj.is_tapped = False\n        if hasattr(obj, \"summoning_sick\"):\n            obj.summoning_sick = False\n\n    # Reset land plays for the active player\n    active.land_plays_remaining = 1\n\n\ndef _do_draw_step(game: GameState) -> None:\n    \"\"\"Perform draw step actions: active player draws a card.\n\n    In a two-player game, the starting player (the player who takes\n    turn 1) skips their draw step on that first turn.  This is per\n    MTG comprehensive rules §103.7a.\n    \"\"\"\n    # The starting player skips their draw on turn 1.\n    if game.turn_number == 1 and game.active_player_index == 0:\n        return\n\n    from engine.game import draw_card\n\n    draw_card(game, game.active_player)\n\n\ndef _do_combat_step(game: GameState, step: Step) -> None:\n    \"\"\"Dispatch combat sub-steps to the appropriate combat functions.\n\n    Parameters:\n        game: The current game state.\n        step: The combat step to execute.\n    \"\"\"\n    from engine.combat import (\n        combat_damage_step,\n        declare_attackers_step,\n        declare_blockers_step,\n        end_combat_step,\n    )\n\n    if step == Step.DECLARE_ATTACKERS:\n        declare_attackers_step(game)\n    elif step == Step.DECLARE_BLOCKERS:\n        declare_blockers_step(game)\n    elif step == Step.COMBAT_DAMAGE:\n        combat_damage_step(game)\n    elif step == Step.END_COMBAT:\n        end_combat_step(game)\n\n\ndef _do_cleanup_step(game: GameState) -> None:\n    \"\"\"Perform the cleanup step (MTG rule §514).\n\n    The cleanup step executes the following actions in order:\n\n    1. Active player discards down to maximum hand size (7) using\n       :meth:`Player.choose_card`.\n    2. Remove all \"until end of turn\" continuous effects via\n       :meth:`EffectManager.remove_expired`, then reapply remaining\n       effects for a consistent game state.\n    3. Clear damage marked on all creatures on the battlefield.\n    4. Clear combat-related flags (``dealt_deathtouch_damage``,\n       ``is_attacking``, ``is_blocking``) and reset the combat state.\n    5. Empty all players' mana pools.\n    6. Check state-based actions.\n    7. If triggers fired during cleanup (e.g. from discarding), process\n       them (give priority, resolve stack) and perform another cleanup step.\n    \"\"\"\n    from engine.game import discard as _discard\n    from engine.player import ScriptExhaustedError\n    from engine.state_based_actions import resolve_state_based_actions\n\n    # --- Step 1: Discard to hand size ---\n    active = game.active_player\n    hand = active.zones[Zone.HAND]\n    while len(hand) > MAX_HAND_SIZE:\n        cards_in_hand = hand.get_all()\n        if not cards_in_hand:\n            break  # safety guard\n        try:\n            chosen = active.choose_card(cards_in_hand, \"discard to hand size\")\n        except (ScriptExhaustedError, NotImplementedError) as exc:\n            # Player implementation doesn't support choose_card or script\n            # was exhausted.  Discard deterministically from end.\n            chosen = cards_in_hand[-1]\n            exc_name = type(exc).__name__\n            warnings.warn(\n                f\"{exc_name} during cleanup discard for {active.name}; \"\n                f\"auto-discarding {chosen.name}\"\n            )\n        if chosen is not None and hand.contains(chosen):\n            _discard(game, active, chosen)\n        else:\n            # If choose_card returns something invalid, discard the last card\n            # to avoid an infinite loop.\n            _discard(game, active, cards_in_hand[-1])\n\n    # --- Step 2: Remove \"until end of turn\" continuous effects ---\n    if hasattr(game, \"effect_manager\"):\n        game.effect_manager.remove_expired(game)\n        # Reapply remaining effects so the game state is consistent.\n        game.effect_manager.apply_all(game)\n\n    # --- Step 3: Clear damage on all creatures ---\n    for player in game.players:\n        bf = player.zones[Zone.BATTLEFIELD]\n        for obj in bf.get_all():\n            if hasattr(obj, \"damage_marked\"):\n                obj.damage_marked = 0\n\n    # --- Step 4: Clear combat flags ---\n    for player in game.players:\n        bf = player.zones[Zone.BATTLEFIELD]\n        for obj in bf.get_all():\n            if hasattr(obj, \"dealt_deathtouch_damage\"):\n                obj.dealt_deathtouch_damage = False\n            if hasattr(obj, \"is_attacking\"):\n                obj.is_attacking = False\n            if hasattr(obj, \"is_blocking\"):\n                obj.is_blocking = False\n    # Reset the CombatState itself.\n    if hasattr(game, \"combat_state\"):\n        game.combat_state.clear()\n\n    # --- Step 5: Empty mana pools ---\n    game.empty_mana_pools()\n\n    # --- Step 6: Check state-based actions ---\n    sba_happened = resolve_state_based_actions(game)\n\n    # --- Step 7: If SBAs were performed or triggers fired, process & repeat ---\n    # Rule 514.3a: if state-based actions were performed or triggered abilities\n    # triggered during cleanup, another cleanup step occurs.\n    if sba_happened or not game.stack.is_empty():\n        # Triggers were placed on the stack — give priority and resolve.\n        priority_loop(game)\n        # After resolving, perform another cleanup step (recursive).\n        _do_cleanup_step(game)\n\n\ndef run_turn(game: GameState) -> None:\n    \"\"\"Execute a full turn, iterating through all phases/steps.\n\n    At each priority point (every phase/step except Untap and Cleanup),\n    :func:`priority_loop` is called.  Turn-based actions are performed\n    at the appropriate steps:\n\n    - **Untap**: Untap all permanents, clear summoning sickness, reset\n      land plays.\n    - **Draw**: Active player draws a card.\n    - **Combat**: Delegate to combat system functions.\n    - **Cleanup**: Clear damage, remove expired effects.\n\n    After the last step (Cleanup), the turn number is incremented and\n    the active player swaps via :meth:`GameState.advance_phase`.\n\n    Parameters:\n        game: The game state to advance through one complete turn.\n    \"\"\"\n    start_turn = game.turn_number\n\n    while game.turn_number == start_turn:\n        current = (game.phase, game.step)\n\n        # Perform turn-based actions for the current step\n        if current == (Phase.BEGINNING, Step.UNTAP):\n            _do_untap_step(game)\n        elif current == (Phase.BEGINNING, Step.UPKEEP):\n            from engine.events import BeginningOfUpkeepTriggeredEvent\n            game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n        elif current == (Phase.BEGINNING, Step.DRAW):\n            _do_draw_step(game)\n        elif game.phase == Phase.COMBAT and game.step is not None:\n            _do_combat_step(game, game.step)\n        elif current == (Phase.ENDING, Step.CLEANUP):\n            _do_cleanup_step(game)\n\n        # Grant priority at this phase/step unless it's Untap or Cleanup.\n        if current not in _NO_PRIORITY_STEPS:\n            priority_loop(game)\n\n        # Advance to the next phase/step (or to next turn).\n        game.advance_phase()\n","numLines":218,"startLine":1,"totalLines":218}}}
