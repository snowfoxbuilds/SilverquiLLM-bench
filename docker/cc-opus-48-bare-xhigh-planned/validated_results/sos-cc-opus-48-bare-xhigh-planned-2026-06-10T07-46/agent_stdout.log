nt` recording; restricted-mana support in `ManaPool`; `game.rng` and `player.skip_turns` with skip handling in `advance_phase`.\n\n**Deviations & deliberate card-local limitations** are logged in `/workspace/KEY_DECISIONS.md` — notably: the engine never fires self-ETB triggers (so sos_13's enter effect runs in `on_resolve`), no end-of-turn event exists (sos_257's pump resets at upkeep), and replacements aren't consulted for stack→graveyard (sos_1 uses a flag instead). Each was chosen as the smallest correct change rather than a speculative subsystem.","stop_reason":"end_turn","session_id":"88686e67-15f6-420e-923b-5a5a834e5552","total_cost_usd":27.72883325000001,"usage":{"input_tokens":11952,"cache_creation_input_tokens":400423,"cache_read_input_tokens":37665505,"output_tokens":245219,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":400423,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":1013,"cache_read_input_tokens":420693,"cache_creation_input_tokens":684,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":684},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-haiku-4-5-20251001":{"inputTokens":476,"outputTokens":14,"cacheReadInputTokens":0,"cacheCreationInputTokens":0,"webSearchRequests":0,"costUSD":0.000546,"contextWindow":200000,"maxOutputTokens":32000},"claude-opus-4-8":{"inputTokens":11954,"outputTokens":245337,"cacheReadInputTokens":38000722,"cacheCreationInputTokens":405557,"webSearchRequests":0,"costUSD":27.72828725000001,"contextWindow":200000,"maxOutputTokens":64000}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","uuid":"90e4564c-bb63-4a8f-844c-96eaecefaec9"}
