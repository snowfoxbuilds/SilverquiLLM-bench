 mana of the given type to the pool.\n\n        Parameters:\n            mana_type: The type of mana to add.\n            amount: How many mana to add (must be non-negative).\n        \"\"\"\n        if amount < 0:\n            raise ValueError(f\"Cannot add negative mana: {amount}\")\n        self._pool[mana_type] = self._pool.get(mana_type, 0) + amount\n\n    def add_restricted(self, mana_type: ManaType, amount: int = 1) -> None:\n        \"\"\"Add mana that may only be spent to cast an instant or sorcery spell.\n\n        The mana is added to the pool like normal mana but is also tracked in\n        ``_restricted`` so that :meth:`can_pay` / :meth:`pay` exclude it when\n        paying for anything other than an instant or sorcery (callers pass\n        ``restricted_ok=True`` for instant/sorcery casts).\n        \"\"\"\n        if amount < 0:\n            raise ValueError(f\"Cannot add negative mana: {amount}\")\n        self._pool[mana_type] = self._pool.get(mana_type, 0) + amount\n        self._restricted[mana_type] = self._restricted.get(mana_type, 0) + amount\n\n    def _usable_pool(self, restricted_ok: bool) -> dict[ManaType, int]:\n        \"\"\"Return the mana available to a payment.\n\n        When *restricted_ok* is ``True`` the full pool is available; otherwise\n        instant/sorcery-only mana is excluded.\n        \"\"\"\n        if restricted_ok:\n            return dict(self._pool)\n        return {\n            mt: self._pool.get(mt, 0) - self._restricted.get(mt, 0)\n            for mt in self._pool\n        }\n\n    def empty(self) -> None:\n        \"\"\"Clear the pool — happens at phase/step transitions.\"\"\"\n        for mt in self._pool:\n            self._pool[mt] = 0\n        for mt in self._restricted:\n            self._restricted[mt] = 0"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8167,"cache_read_input_tokens":252515,"cache_creation":{"