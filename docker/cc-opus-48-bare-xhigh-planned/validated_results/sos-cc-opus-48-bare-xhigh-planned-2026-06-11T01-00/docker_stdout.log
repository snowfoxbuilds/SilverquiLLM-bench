n    game2.advance_phase()\n    if game2.turn_number!=last:\n        last=game2.turn_number; rec[last]=game2.active_player_index\n    if last>=6: break\nprint('turn->active:', {k:rec[k] for k in sorted(rec)})\n# p1 skips turns 2,3,4 -> p0 takes them; p1 first plays turn 5\nassert rec[2]==0 and rec[3]==0 and rec[4]==0 and rec[5]==1\nprint('smoke OK')\n\" && python3 -m pytest engine_tests/ -q 2>&1 | tail -2","description":"Smoke check sos_97 reanimation ETB + skip rotation, engine tests"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":320,"cache_read_input_tokens":394384,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":320},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8da52e5e-8a7f-49b6-ba2f-528c6b227c8c","uuid":"cbf9887d-0722-4180-8460-8a78df3e514c","request_id":"req_011CbvdBTFixoCNQhyiGBTuK"}
