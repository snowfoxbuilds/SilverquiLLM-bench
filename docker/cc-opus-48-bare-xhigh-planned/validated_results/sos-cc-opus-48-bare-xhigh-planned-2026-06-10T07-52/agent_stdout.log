ll in hand', g2.get_hand(q0).contains_by_name if False else any(c.name=='Keep' for c in g2.get_hand(q0).get_all()))\nassert any(c.name=='Keep' for c in g2.get_hand(q0).get_all())\nassert not any(c.name=='Top' for c in g2.get_hand(q0).get_all())  # did not draw\n\n# Empty hand loot -> no crash, no draw\ng3=create_game(); r0,r1=g3.players\nl3=LoreholdTheHistorian(owner=r0,controller=r0)\nset_board_state(g3,0,battlefield=[l3], hand=[])\nl3.register_triggers(g3)\n_lib_add(g3,0,[CardImpl(name='T2')])\ng3.active_player_index=1\ng3.trigger_manager.fire_event(g3, BeginningOfUpkeepTriggeredEvent())\n_resolve_all(g3)\nprint('empty-hand loot: no draw', not any(c.name=='T2' for c in g3.get_hand(r0).get_all()))\nassert not any(c.name=='T2' for c in g3.get_hand(r0).get_all())\nprint('SMOKE OK')\n\""},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":298,"cache_read_input_tokens":382742,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":298},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"17ee38e2-4349-4787-adbd-29e4e2a327e9","uuid":"c09a803b-57b6-49c2-8bae-a3d9f9fcac5e","request_id":"req_011CbuH2C1cQsxmSa34xzz5x"}
