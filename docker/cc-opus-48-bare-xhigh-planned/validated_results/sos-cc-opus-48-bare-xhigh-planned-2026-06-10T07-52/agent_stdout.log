Impl\n\nfrom typing import TYPE_CHECKING\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\nclass RalZarekGuestLecturer(CardImpl):\n    \"\"\"TODO: Implement Ral Zarek, Guest Lecturer.\"\"\"\n\n    pass\n","userModified":false}}
