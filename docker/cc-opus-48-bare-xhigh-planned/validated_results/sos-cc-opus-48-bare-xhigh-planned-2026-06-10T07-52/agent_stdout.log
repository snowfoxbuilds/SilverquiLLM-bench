{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KDFwa8Uo3TimQMaLsB8svn","type":"tool_result","content":"1\t\"\"\"Central game state and turn/phase/step progression.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import Any\n6\t\n7\tfrom engine.combat import CombatState\n8\tfrom engine.continuous_effects import EffectManager\n9\tfrom engine.player import Player\n10\tfrom engine.replacement_effects import ReplacementManager\n11\tfrom engine.stack import Stack\n12\tfrom engine.triggers import TriggerManager\n13\tfrom engine.types import Phase, Step, Zone\n14\tfrom engine.zones import ZoneContainer\n15\t\n16\t# Ordered list of (Phase, Step | None) representing a full MTG turn.\n17\t_TURN_SEQUENCE: list[tuple[Phase, Step | None]] = [\n18\t    # Beginning phase\n19\t    (Phase.BEGINNING, Step.UNTAP),\n20\t    (Phase.BEGINNING, Step.UPKEEP),\n21\t    (Phase.BEGINNING, Step.DRAW),\n22\t    # Precombat main phase\n23\t    (Phase.PRECOMBAT_MAIN, None),\n24\t    # Combat phase\n25\t    (Phase.COMBAT, Step.BEGIN_COMBAT),\n26\t    (Phase.COMBAT, Step.DECLARE_ATTACKERS),\n27\t    (Phase.COMBAT, Step.DECLARE_BLOCKERS),\n28\t    (Phase.COMBAT, Step.COMBAT_DAMAGE),\n29\t    (Phase.COMBAT, Step.END_COMBAT),\n30\t    # Postcombat main phase\n31\t    (Phase.POSTCOMBAT_MAIN, None),\n32\t    # Ending phase\n33\t    (Phase.ENDING, Step.END),\n34\t    (Phase.ENDING, Step.CLEANUP),\n35\t]\n36\t\n37\t\n38\tclass GameState:\n39\t    \"\"\"Central game-state object tracking all mutable game information.\n40\t\n41\t    Attributes:\n42\t        players: The list of players in the game.\n43\t        active_player_index: Index of the current active player.\n44\t        priority_player_index: Index of the player who currently has priority.\n45\t        phase: Current phase of the turn.\n46\t        step: Current step within the phase (``None`` for main phases).\n47\t        turn_number: The current turn number (1-indexed).\n48\t        stack: The game stack for spells and abilities.\n49\t        trigger_manager: Central registry for triggered abilities.\n50\t        replacement_manager: Central registry for replacement effects.\n51\t        effect_manager: Manager for continuous effects and the layer system.\n52\t        is_game_over: Whether the game has ended.\n53\t        winner: The winning player, or ``None`` if the game is ongoing / draw.\n54\t    \"\"\"\n55\t\n56\t    def __init__(self, players: list[Player]) -> None:\n57\t        if len(players) < 2:\n58\t            raise ValueError(\"GameState requires at least 2 players\")\n59\t        if len(players) > 2:\n60\t            raise ValueError(\"GameState supports exactly 2 players\")\n61\t\n62\t        self.players: list[Player] = players\n63\t        self.active_player_index: int = 0\n64\t        self.priority_player_index: int = 0\n65\t        self.phase: Phase = Phase.BEGINNING\n66\t        self.step: Step | None = Step.UNTAP\n67\t        self.turn_number: int = 1\n68\t        self.stack: Stack = Stack()\n69\t        self.trigger_manager: TriggerManager = TriggerManager()\n70\t        self.replacement_manager: ReplacementManager = ReplacementManager()\n71\t        self.effect_manager: EffectManager = EffectManager()\n72\t        self.combat_state: CombatState = CombatState()\n73\t        self.is_game_over: bool = False\n74\t        self.winner: Player | None = None\n75\t        # ENGINE LIMITATION: Extra turns queue (FIFO of player seat indices).\n76\t        # Complex interactions ('skip your next turn', multiple extra turns\n77\t        # from different sources) are not fully handled.\n78\t        self.extra_turns: list[int] = []\n79\t        # Tracks normal turn rotation independently of extra turns.\n80\t        # Extra turns are truly *inserted* — they don't advance the\n81\t        # normal rotation.  When extras are exhausted the game picks up\n82\t        # from _normal_next_index.\n83\t        self._normal_next_index: int = 1\n84\t\n85\t    # ------------------------------------------------------------------\n86\t    # Player properties\n87\t    # ------------------------------------------------------------------\n88\t\n89\t    @property\n90\t    def active_player(self) -> Player:\n91\t        \"\"\"Return the currently active player.\"\"\"\n92\t        return self.players[self.active_player_index]\n93\t\n94\t    @property\n95\t    def priority_player(self) -> Player:\n96\t        \"\"\"Return the player who currently has priority.\"\"\"\n97\t        return self.players[self.priority_player_index]\n98\t\n99\t    @property\n100\t    def non_active_player(self) -> Player:\n101\t        \"\"\"Return the non-active player (2-player assumption for v1).\"\"\"\n102\t        return self.players[1 - self.active_player_index]\n103\t\n104\t    # ------------------------------------------------------------------\n105\t    # Zone accessors\n106\t    # ------------------------------------------------------------------\n107\t\n108\t    def get_battlefield(self, player: Player) -> ZoneContainer:\n109\t        \"\"\"Return the battlefield zone for *player*.\"\"\"\n110\t        return player.zones[Zone.BATTLEFIELD]\n111\t\n112\t    def get_hand(self, player: Player) -> ZoneContainer:\n113\t        \"\"\"Return the hand zone for *player*.\"\"\"\n114\t        return player.zones[Zone.HAND]\n115\t\n116\t    def get_graveyard(self, player: Player) -> ZoneContainer:\n117\t        \"\"\"Return the graveyard zone for *player*.\"\"\"\n118\t        return player.zones[Zone.GRAVEYARD]\n119\t\n120\t    def get_library(self, player: Player) -> ZoneContainer:\n121\t        \"\"\"Return the library zone for *player*.\"\"\"\n122\t        return player.zones[Zone.LIBRARY]\n123\t\n124\t    def get_exile(self, player: Player) -> ZoneContainer:\n125\t        \"\"\"Return the exile zone for *player*.\"\"\"\n126\t        return player.zones[Zone.EXILE]\n127\t\n128\t    # ------------------------------------------------------------------\n129\t    # Phase/step progression\n130\t    # ------------------------------------------------------------------\n131\t\n132\t    def advance_phase(self) -> None:\n133\t        \"\"\"Advance to the next phase/step in MTG turn order.\n134\t\n135\t        At the end of CLEANUP, the turn number is incremented and the\n136\t        active player swaps (2-player assumption).  Mana pools are\n137\t        emptied on every transition.\n138\t        \"\"\"\n139\t        current = (self.phase, self.step)\n140\t        idx = _TURN_SEQUENCE.index(current)\n141\t\n142\t        if idx + 1 < len(_TURN_SEQUENCE):\n143\t            # Move to next phase/step within the same turn.\n144\t            next_phase, next_step = _TURN_SEQUENCE[idx + 1]\n145\t            self.phase = next_phase\n146\t            self.step = next_step\n147\t        else:\n148\t            # End of turn — wrap around.\n149\t            self.turn_number += 1\n150\t            if self.extra_turns:\n151\t                # ENGINE LIMITATION: Extra turns queue (FIFO). Pop the\n152\t                # next player seat index; that player gets the next turn.\n153\t                # Normal rotation is NOT advanced — extra turns are\n154\t                # inserted before the normal next turn.\n155\t                self.active_player_index = self.extra_turns.pop(0)\n156\t            else:\n157\t                self.active_player_index = self._normal_next_index\n158\t                self._normal_next_index = 1 - self._normal_next_index\n159\t            self.priority_player_index = self.active_player_index\n160\t            self.phase = _TURN_SEQUENCE[0][0]\n161\t            self.step = _TURN_SEQUENCE[0][1]\n162\t\n163\t        self.empty_mana_pools()\n164\t\n165\t    def empty_mana_pools(self) -> None:\n166\t        \"\"\"Empty all players' mana pools — called on each phase/step transition.\"\"\"\n167\t        for player in self.players:\n168\t            player.mana_pool.empty()\n169\t"}]},"parent_tool_use_id":null,"session_id":"17ee38e2-4349-4787-adbd-29e4e2a327e9","uuid":"59d0aedf-adb2-45c6-b11f-d432d746b7da","timestamp":"2026-06-10T07:53:11.235Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/game_state.py","content":"\"\"\"Central game state and turn/phase/step progression.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any\n\nfrom engine.combat import CombatState\nfrom engine.continuous_effects import EffectManager\nfrom engine.player import Player\nfrom engine.replacement_effects import ReplacementManager\nfrom engine.stack import Stack\nfrom engine.triggers import TriggerManager\nfrom engine.types import Phase, Step, Zone\nfrom engine.zones import ZoneContainer\n\n# Ordered list of (Phase, Step | None) representing a full MTG turn.\n_TURN_SEQUENCE: list[tuple[Phase, Step | None]] = [\n    # Beginning phase\n    (Phase.BEGINNING, Step.UNTAP),\n    (Phase.BEGINNING, Step.UPKEEP),\n    (Phase.BEGINNING, Step.DRAW),\n    # Precombat main phase\n    (Phase.PRECOMBAT_MAIN, None),\n    # Combat phase\n    (Phase.COMBAT, Step.BEGIN_COMBAT),\n    (Phase.COMBAT, Step.DECLARE_ATTACKERS),\n    (Phase.COMBAT, Step.DECLARE_BLOCKERS),\n    (Phase.COMBAT, Step.COMBAT_DAMAGE),\n    (Phase.COMBAT, Step.END_COMBAT),\n    # Postcombat main phase\n    (Phase.POSTCOMBAT_MAIN, None),\n    # Ending phase\n    (Phase.ENDING, Step.END),\n    (Phase.ENDING, Step.CLEANUP),\n]\n\n\nclass GameState:\n    \"\"\"Central game-state object tracking all mutable game information.\n\n    Attributes:\n        players: The list of players in the game.\n        active_player_index: Index of the current active player.\n        priority_player_index: Index of the player who currently has priority.\n        phase: Current phase of the turn.\n        step: Current step within the phase (``None`` for main phases).\n        turn_number: The current turn number (1-indexed).\n        stack: The game stack for spells and abilities.\n        trigger_manager: Central registry for triggered abilities.\n        replacement_manager: Central registry for replacement effects.\n        effect_manager: Manager for continuous effects and the layer system.\n        is_game_over: Whether the game has ended.\n        winner: The winning player, or ``None`` if the game is ongoing / draw.\n    \"\"\"\n\n    def __init__(self, players: list[Player]) -> None:\n        if len(players) < 2:\n            raise ValueError(\"GameState requires at least 2 players\")\n        if len(players) > 2:\n            raise ValueError(\"GameState supports exactly 2 players\")\n\n        self.players: list[Player] = players\n        self.active_player_index: int = 0\n        self.priority_player_index: int = 0\n        self.phase: Phase = Phase.BEGINNING\n        self.step: Step | None = Step.UNTAP\n        self.turn_number: int = 1\n        self.stack: Stack = Stack()\n        self.trigger_manager: TriggerManager = TriggerManager()\n        self.replacement_manager: ReplacementManager = ReplacementManager()\n        self.effect_manager: EffectManager = EffectManager()\n        self.combat_state: CombatState = CombatState()\n        self.is_game_over: bool = False\n        self.winner: Player | None = None\n        # ENGINE LIMITATION: Extra turns queue (FIFO of player seat indices).\n        # Complex interactions ('skip your next turn', multiple extra turns\n        # from different sources) are not fully handled.\n        self.extra_turns: list[int] = []\n        # Tracks normal turn rotation independently of extra turns.\n        # Extra turns are truly *inserted* — they don't advance the\n        # normal rotation.  When extras are exhausted the game picks up\n        # from _normal_next_index.\n        self._normal_next_index: int = 1\n\n    # ------------------------------------------------------------------\n    # Player properties\n    # ------------------------------------------------------------------\n\n    @property\n    def active_player(self) -> Player:\n        \"\"\"Return the currently active player.\"\"\"\n        return self.players[self.active_player_index]\n\n    @property\n    def priority_player(self) -> Player:\n        \"\"\"Return the player who currently has priority.\"\"\"\n        return self.players[self.priority_player_index]\n\n    @property\n    def non_active_player(self) -> Player:\n        \"\"\"Return the non-active player (2-player assumption for v1).\"\"\"\n        return self.players[1 - self.active_player_index]\n\n    # ------------------------------------------------------------------\n    # Zone accessors\n    # ------------------------------------------------------------------\n\n    def get_battlefield(self, player: Player) -> ZoneContainer:\n        \"\"\"Return the battlefield zone for *player*.\"\"\"\n        return player.zones[Zone.BATTLEFIELD]\n\n    def get_hand(self, player: Player) -> ZoneContainer:\n        \"\"\"Return the hand zone for *player*.\"\"\"\n        return player.zones[Zone.HAND]\n\n    def get_graveyard(self, player: Player) -> ZoneContainer:\n        \"\"\"Return the graveyard zone for *player*.\"\"\"\n        return player.zones[Zone.GRAVEYARD]\n\n    def get_library(self, player: Player) -> ZoneContainer:\n        \"\"\"Return the library zone for *player*.\"\"\"\n        return player.zones[Zone.LIBRARY]\n\n    def get_exile(self, player: Player) -> ZoneContainer:\n        \"\"\"Return the exile zone for *player*.\"\"\"\n        return player.zones[Zone.EXILE]\n\n    # ------------------------------------------------------------------\n    # Phase/step progression\n    # ------------------------------------------------------------------\n\n    def advance_phase(self) -> None:\n        \"\"\"Advance to the next phase/step in MTG turn order.\n\n        At the end of CLEANUP, the turn number is incremented and the\n        active player swaps (2-player assumption).  Mana pools are\n        emptied on every transition.\n        \"\"\"\n        current = (self.phase, self.step)\n        idx = _TURN_SEQUENCE.index(current)\n\n        if idx + 1 < len(_TURN_SEQUENCE):\n            # Move to next phase/step within the same turn.\n            next_phase, next_step = _TURN_SEQUENCE[idx + 1]\n            self.phase = next_phase\n            self.step = next_step\n        else:\n            # End of turn — wrap around.\n            self.turn_number += 1\n            if self.extra_turns:\n                # ENGINE LIMITATION: Extra turns queue (FIFO). Pop the\n                # next player seat index; that player gets the next turn.\n                # Normal rotation is NOT advanced — extra turns are\n                # inserted before the normal next turn.\n                self.active_player_index = self.extra_turns.pop(0)\n            else:\n                self.active_player_index = self._normal_next_index\n                self._normal_next_index = 1 - self._normal_next_index\n            self.priority_player_index = self.active_player_index\n            self.phase = _TURN_SEQUENCE[0][0]\n            self.step = _TURN_SEQUENCE[0][1]\n\n        self.empty_mana_pools()\n\n    def empty_mana_pools(self) -> None:\n        \"\"\"Empty all players' mana pools — called on each phase/step transition.\"\"\"\n        for player in self.players:\n            player.mana_pool.empty()\n","numLines":169,"startLine":1,"totalLines":169}}}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_013zDtMMHMWcXkHKpCJYVuqG","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01C8YQJriCQaToEt5wFi2yfr","name":"Read","input":{"file_path":"/workspace/engine/stack.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":17810,"cache_read_input_tokens":38858,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":17810},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"17ee38e2-4349-4787-adbd-29e4e2a327e9","uuid":"875a88b5-5c96-4f63-82ce-8a3a85a2b8c5","request_id":"req_011CbuDZD2HPkLTsn5xAYa2q"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C8YQJriCQaToEt5wFi2yfr","type":"tool_result","content":"1\t\"\"\"The spell/ability stack with LIFO resolution and priority passing.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport copy\n6\tfrom dataclasses import dataclass, field\n7\tfrom typing import TYPE_CHECKING, Any, Callable\n8\t\n9\tif TYPE_CHECKING:\n10\t    from engine.game_state import GameState\n11\t    from engine.player import Player\n12\t\n13\t\n14\t@dataclass\n15\tclass StackObject:\n16\t    \"\"\"An object on the stack representing a spell or ability.\n17\t\n18\t    Attributes:\n19\t        source: The card or ability that created this stack object.\n20\t        controller: The player who controls this stack object.\n21\t        targets: The chosen targets for the spell/ability.\n22\t        on_resolve: Callback invoked when this object resolves.\n23\t        is_mana_ability: Whether this is a mana ability (resolves immediately).\n24\t    \"\"\"\n25\t\n26\t    source: Any\n27\t    controller: Player\n28\t    targets: list[Any] = field(default_factory=list)\n29\t    on_resolve: Callable[[GameState], None] = field(default=lambda _game: None)\n30\t    is_mana_ability: bool = False\n31\t\n32\t\n33\tclass Stack:\n34\t    \"\"\"The game stack — a LIFO structure for spells and abilities.\n35\t\n36\t    The internal list stores objects with the last element being the top\n37\t    of the stack (most recently pushed).\n38\t    \"\"\"\n39\t\n40\t    def __init__(self) -> None:\n41\t        self._items: list[StackObject] = []\n42\t\n43\t    def push(self, obj: StackObject) -> None:\n44\t        \"\"\"Push *obj* onto the top of the stack.\"\"\"\n45\t        self._items.append(obj)\n46\t\n47\t    def pop(self) -> StackObject:\n48\t        \"\"\"Remove and return the top object from the stack.\n49\t\n50\t        Raises:\n51\t            IndexError: If the stack is empty.\n52\t        \"\"\"\n53\t        return self._items.pop()\n54\t\n55\t    def peek(self) -> StackObject | None:\n56\t        \"\"\"Return the top object without removing it, or ``None`` if empty.\"\"\"\n57\t        return self._items[-1] if self._items else None\n58\t\n59\t    def __len__(self) -> int:\n60\t        \"\"\"Return the number of objects on the stack.\"\"\"\n61\t        return len(self._items)\n62\t\n63\t    def is_empty(self) -> bool:\n64\t        \"\"\"Return ``True`` if the stack contains no objects.\"\"\"\n65\t        return len(self._items) == 0\n66\t\n67\t    def objects(self) -> list[StackObject]:\n68\t        \"\"\"Return all stack objects ordered from top to bottom.\"\"\"\n69\t        return list(reversed(self._items))\n70\t\n71\t\n72\tdef copy_spell(\n73\t    game: GameState,\n74\t    original: StackObject,\n75\t    controller: Player,\n76\t    new_targets: list[Any] | None = None,\n77\t) -> StackObject:\n78\t    \"\"\"Create a copy of a spell on the stack (for storm and similar effects).\n79\t\n80\t    Shallow-copies the source card so the copy has independent state\n81\t    (chosen_targets, etc.) while sharing class method bindings.  Binds\n82\t    on_resolve to call the copied card's on_resolve directly — no zone\n83\t    movement, which is correct for spell copies.\n84\t\n85\t    Args:\n86\t        game: The current game state.\n87\t        original: The StackObject being copied.\n88\t        controller: The player who controls the copy.\n89\t        new_targets: Optional replacement targets.  If ``None``, the\n90\t            original's target list is cloned.\n91\t\n92\t    Returns:\n93\t        A new StackObject representing the copy ready to be pushed.\n94\t    \"\"\"\n95\t    copied_card = copy.copy(original.source)\n96\t    copied_card.controller = controller\n97\t    copied_card.owner = getattr(original.source, \"owner\", controller)\n98\t\n99\t    targets = new_targets if new_targets is not None else list(original.targets)\n100\t\n101\t    copy_obj = StackObject(\n102\t        source=copied_card,\n103\t        controller=controller,\n104\t        targets=targets,\n105\t    )\n106\t\n107\t    def _copy_resolve(g: GameState) -> None:\n108\t        copied_card.chosen_targets = copy_obj.targets\n109\t        copied_card.on_resolve(g)\n110\t\n111\t    copy_obj.on_resolve = _copy_resolve\n112\t    return copy_obj\n113\t\n114\t\n115\tdef check_state_based_actions(game: GameState) -> None:\n116\t    \"\"\"Check and perform all state-based actions until the game state is stable.\n117\t\n118\t    This is a convenience wrapper around\n119\t    :func:`engine.state_based_actions.resolve_state_based_actions` that\n120\t    maintains the original ``-> None`` call-site contract used by\n121\t    :func:`priority_loop`.  For the single-pass boolean API, import\n122\t    :func:`~engine.state_based_actions.check_state_based_actions` directly\n123\t    from :mod:`engine.state_based_actions`.\n124\t    \"\"\"\n125\t    from engine.state_based_actions import resolve_state_based_actions\n126\t\n127\t    resolve_state_based_actions(game)\n128\t\n129\t\n130\tdef _get_legal_actions(game: GameState, player: Player) -> list[Any]:\n131\t    \"\"\"Return the legal actions available to *player*.\n132\t\n133\t    Placeholder — returns an empty list until spells/abilities are\n134\t    implemented in later items.\n135\t    \"\"\"\n136\t    return []\n137\t\n138\t\n139\tdef _handle_priority(game: GameState, player: Player) -> bool:\n140\t    \"\"\"Give priority to *player* and let them act or pass.\n141\t\n142\t    Returns ``True`` if the player passed priority, ``False`` if they\n143\t    took an action (in which case the priority loop restarts).\n144\t\n145\t    When the stack is non-empty, the player is always asked via\n146\t    :meth:`Player.choose` so they can respond.  When the stack is empty\n147\t    and no legal actions exist, the player auto-passes.\n148\t    \"\"\"\n149\t    actions = _get_legal_actions(game, player)\n150\t\n151\t    # Auto-pass when there is nothing to respond to and no actions.\n152\t    if not actions and game.stack.is_empty():\n153\t        return True\n154\t\n155\t    options = actions + [\"pass\"]\n156\t    choice = player.choose(options, \"priority: choose action or pass\")\n157\t\n158\t    if choice == \"pass\":\n159\t        return True\n160\t\n161\t    # Mana abilities resolve immediately without using the stack.\n162\t    if isinstance(choice, StackObject) and choice.is_mana_ability:\n163\t        choice.on_resolve(game)\n164\t        return False\n165\t\n166\t    # Regular spell / ability — push onto the stack.\n167\t    if isinstance(choice, StackObject):\n168\t        game.stack.push(choice)\n169\t\n170\t    return False\n171\t\n172\t\n173\tdef priority_loop(game: GameState) -> None:\n174\t    \"\"\"Run the priority-passing loop for the current phase/step.\n175\t\n176\t    Flow\n177\t    ----\n178\t    1. Active player gets priority.  They may play spells/abilities\n179\t       (pushed to stack) or pass.\n180\t    2. When a player takes an action they **retain** priority (MTG rule:\n181\t       the player who just acted gets to respond first).\n182\t    3. When a player passes, priority moves to the other player.\n183\t    4. If both players pass in succession with the stack **non-empty**,\n184\t       the top of the stack is resolved (``pop`` → ``on_resolve(game)``),\n185\t       state-based actions are checked, and the active player receives\n186\t       priority again.\n187\t    5. If both players pass with the stack **empty**, return (the game\n188\t       advances to the next phase/step).\n189\t\n190\t    ``game.priority_player_index`` is kept in sync throughout so that\n191\t    :pyattr:`GameState.priority_player` always reflects who currently\n192\t    holds priority.\n193\t\n194\t    Player decisions come from :meth:`Player.choose`.  When no legal\n195\t    actions exist and the stack is empty, the player auto-passes without\n196\t    being asked.\n197\t    \"\"\"\n198\t    while True:\n199\t        # Active player receives priority at the start of each\n200\t        # resolution round.\n201\t        current_index = game.active_player_index\n202\t        game.priority_player_index = current_index\n203\t        consecutive_passes = 0\n204\t\n205\t        while consecutive_passes < 2:\n206\t            player = game.players[current_index]\n207\t            game.priority_player_index = current_index\n208\t\n209\t            passed = _handle_priority(game, player)\n210\t\n211\t            if passed:\n212\t                consecutive_passes += 1\n213\t                # Priority moves to the other player.\n214\t                current_index = 1 - current_index\n215\t            else:\n216\t                # Player took an action — they retain priority.\n217\t                consecutive_passes = 0\n218\t\n219\t        # Both players passed consecutively.\n220\t        if game.stack.is_empty():\n221\t            return  # Advance to next phase/step\n222\t\n223\t        # Resolve top of stack (LIFO).\n224\t        obj = game.stack.pop()\n225\t        obj.on_resolve(game)\n226\t        check_state_based_actions(game)\n227\t        # Active player receives priority again — outer loop continues.\n228\t"}]},"parent_tool_use_id":null,"session_id":"17ee38e2-4349-4787-adbd-29e4e2a327e9","uuid":"ad9bd096-0d2c-49b9-9a28-abfe4a0c20ab","timestamp":"2026-06-10T07:53:11.665Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/stack.py","content":"\"\"\"The spell/ability stack with LIFO resolution and priority passing.\"\"\"\n\nfrom __future__ import annotations\n\nimport copy\nfrom dataclasses import dataclass, field\nfrom typing import TYPE_CHECKING, Any, Callable\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n@dataclass\nclass StackObject:\n    \"\"\"An object on the stack representing a spell or ability.\n\n    Attributes:\n        source: The card or ability that created this stack object.\n        controller: The player who controls this stack object.\n        targets: The chosen targets for the spell/ability.\n        on_resolve: Callback invoked when this object resolves.\n        is_mana_ability: Whether this is a mana ability (resolves immediately).\n    \"\"\"\n\n    source: Any\n    controller: Player\n    targets: list[Any] = field(default_factory=list)\n    on_resolve: Callable[[GameState], None] = field(default=lambda _game: None)\n    is_mana_ability: bool = False\n\n\nclass Stack:\n    \"\"\"The game stack — a LIFO structure for spells and abilities.\n\n    The internal list stores objects with the last element being the top\n    of the stack (most recently pushed).\n    \"\"\"\n\n    def __init__(self) -> None:\n        self._items: list[StackObject] = []\n\n    def push(self, obj: StackObject) -> None:\n        \"\"\"Push *obj* onto the top of the stack.\"\"\"\n        self._items.append(obj)\n\n    def pop(self) -> StackObject:\n        \"\"\"Remove and return the top object from the stack.\n\n        Raises:\n            IndexError: If the stack is empty.\n        \"\"\"\n        return self._items.pop()\n\n    def peek(self) -> StackObject | None:\n        \"\"\"Return the top object without removing it, or ``None`` if empty.\"\"\"\n        return self._items[-1] if self._items else None\n\n    def __len__(self) -> int:\n        \"\"\"Return the number of objects on the stack.\"\"\"\n        return len(self._items)\n\n    def is_empty(self) -> bool:\n        \"\"\"Return ``True`` if the stack contains no objects.\"\"\"\n        return len(self._items) == 0\n\n    def objects(self) -> list[StackObject]:\n        \"\"\"Return all stack objects ordered from top to bottom.\"\"\"\n        return list(reversed(self._items))\n\n\ndef copy_spell(\n    game: GameState,\n    original: StackObject,\n    controller: Player,\n    new_targets: list[Any] | None = None,\n) -> StackObject:\n    \"\"\"Create a copy of a spell on the stack (for storm and similar effects).\n\n    Shallow-copies the source card so the copy has independent state\n    (chosen_targets, etc.) while sharing class method bindings.  Binds\n    on_resolve to call the copied card's on_resolve directly — no zone\n    movement, which is correct for spell copies.\n\n    Args:\n        game: The current game state.\n        original: The StackObject being copied.\n        controller: The player who controls the copy.\n        new_targets: Optional replacement targets.  If ``None``, the\n            original's target list is cloned.\n\n    Returns:\n        A new StackObject representing the copy ready to be pushed.\n    \"\"\"\n    copied_card = copy.copy(original.source)\n    copied_card.controller = controller\n    copied_card.owner = getattr(original.source, \"owner\", controller)\n\n    targets = new_targets if new_targets is not None else list(original.targets)\n\n    copy_obj = StackObject(\n        source=copied_card,\n        controller=controller,\n        targets=targets,\n    )\n\n    def _copy_resolve(g: GameState) -> None:\n        copied_card.chosen_targets = copy_obj.targets\n        copied_card.on_resolve(g)\n\n    copy_obj.on_resolve = _copy_resolve\n    return copy_obj\n\n\ndef check_state_based_actions(game: GameState) -> None:\n    \"\"\"Check and perform all state-based actions until the game state is stable.\n\n    This is a convenience wrapper around\n    :func:`engine.state_based_actions.resolve_state_based_actions` that\n    maintains the original ``-> None`` call-site contract used by\n    :func:`priority_loop`.  For the single-pass boolean API, import\n    :func:`~engine.state_based_actions.check_state_based_actions` directly\n    from :mod:`engine.state_based_actions`.\n    \"\"\"\n    from engine.state_based_actions import resolve_state_based_actions\n\n    resolve_state_based_actions(game)\n\n\ndef _get_legal_actions(game: GameState, player: Player) -> list[Any]:\n    \"\"\"Return the legal actions available to *player*.\n\n    Placeholder — returns an empty list until spells/abilities are\n    implemented in later items.\n    \"\"\"\n    return []\n\n\ndef _handle_priority(game: GameState, player: Player) -> bool:\n    \"\"\"Give priority to *player* and let them act or pass.\n\n    Returns ``True`` if the player passed priority, ``False`` if they\n    took an action (in which case the priority loop restarts).\n\n    When the stack is non-empty, the player is always asked via\n    :meth:`Player.choose` so they can respond.  When the stack is empty\n    and no legal actions exist, the player auto-passes.\n    \"\"\"\n    actions = _get_legal_actions(game, player)\n\n    # Auto-pass when there is nothing to respond to and no actions.\n    if not actions and game.stack.is_empty():\n        return True\n\n    options = actions + [\"pass\"]\n    choice = player.choose(options, \"priority: choose action or pass\")\n\n    if choice == \"pass\":\n        return True\n\n    # Mana abilities resolve immediately without using the stack.\n    if isinstance(choice, StackObject) and choice.is_mana_ability:\n        choice.on_resolve(game)\n        return False\n\n    # Regular spell / ability — push onto the stack.\n    if isinstance(choice, StackObject):\n        game.stack.push(choice)\n\n    return False\n\n\ndef priority_loop(game: GameState) -> None:\n    \"\"\"Run the priority-passing loop for the current phase/step.\n\n    Flow\n    ----\n    1. Active player gets priority.  They may play spells/abilities\n       (pushed to stack) or pass.\n    2. When a player takes an action they **retain** priority (MTG rule:\n       the player who just acted gets to respond first).\n    3. When a player passes, priority moves to the other player.\n    4. If both players pass in succession with the stack **non-empty**,\n       the top of the stack is resolved (``pop`` → ``on_resolve(game)``),\n       state-based actions are checked, and the active player receives\n       priority again.\n    5. If both players pass with the stack **empty**, return (the game\n       advances to the next phase/step).\n\n    ``game.priority_player_index`` is kept in sync throughout so that\n    :pyattr:`GameState.priority_player` always reflects who currently\n    holds priority.\n\n    Player decisions come from :meth:`Player.choose`.  When no legal\n    actions exist and the stack is empty, the player auto-passes without\n    being asked.\n    \"\"\"\n    while True:\n        # Active player receives priority at the start of each\n        # resolution round.\n        current_index = game.active_player_index\n        game.priority_player_index = current_index\n        consecutive_passes = 0\n\n        while consecutive_passes < 2:\n            player = game.players[current_index]\n            game.priority_player_index = current_index\n\n            passed = _handle_priority(game, player)\n\n            if passed:\n                consecutive_passes += 1\n                # Priority moves to the other player.\n                current_index = 1 - current_index\n            else:\n                # Player took an action — they retain priority.\n                consecutive_passes = 0\n\n        # Both players passed consecutively.\n        if game.stack.is_empty():\n            return  # Advance to next phase/step\n\n        # Resolve top of stack (LIFO).\n        obj = game.stack.pop()\n        obj.on_resolve(game)\n        check_state_based_actions(game)\n        # Active player receives priority again — outer loop continues.\n","numLines":228,"startLine":1,"totalLines":228}}}
