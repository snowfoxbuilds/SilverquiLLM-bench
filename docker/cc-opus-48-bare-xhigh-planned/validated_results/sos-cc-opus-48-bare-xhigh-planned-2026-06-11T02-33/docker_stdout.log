and \"\n            \"sorcery spells you cast have affinity for creatures.\",\n        )\n        super().__init__(**kwargs)\n\n    def cost_reduction(self, game: \"GameState\") -> int:\n        \"\"\"Affinity for creatures — its own self-reduction (generic only).\n\n        While being cast it is on the stack, so it does not count itself.\n        \"\"\"\n        return _creatures_controlled(game, self.controller)\n\n    def spell_cost_reduction(self, game: \"GameState\", spell: Any) -> int:\n        \"\"\"Grant affinity for creatures to your instant/sorcery spells.\n\n        Aggregated into other spells' costs by ``get_cost_reduction`` (E3),\n        which only invokes this hook for the controller's instant/sorcery\n        spells.\n        \"\"\"\n        return _creatures_controlled(game, self.controller)\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3014,"cache_read_input_tokens":213043,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3014},"output_tokens":64,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ce88d08d-e354-48ee-a9e8-a33d7aea2b51","uuid":"34c8230a-09fe-4114-8f17-f4caf4db548e","request_id":"req_011Cbvi3Go3Dw39fzZ5QETRt"}
