\n    def test_x_equals_one(self):\n        game = create_game()\n        p1, p2 = game.players\n        _fill_library(game, 0, 3)\n        card = TogetherAsOne(owner=p1, controller=p1)\n        card.colors_spent = [Color.RED]  # X = 1\n        card.chosen_targets = [p2, p2]\n        card.on_resolve(game)\n        assert p2.life == 19  # 1 damage\n        assert p1.life == 21  # 1 life gained\n        assert len(p2.zones[Zone.HAND].get_all()) == 1  # p2 drew 1\n","structuredPatch":[{"oldStart":80,"oldLines":7,"newStart":80,"newLines":7,"lines":["     def test_x_equals_one(self):","         game = create_game()","         p1, p2 = game.players","-        _fill_library(game, 0, 3)","+        _fill_library(game, 1, 3)  # p2 is the draw target","         card = TogetherAsOne(owner=p1, controller=p1)","         card.colors_spent = [Color.RED]  # X = 1","         card.chosen_targets = [p2, p2]"]}],"userModified":false,"replaceAll":false}}
