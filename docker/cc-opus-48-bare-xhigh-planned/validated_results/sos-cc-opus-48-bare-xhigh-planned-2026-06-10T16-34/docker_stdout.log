{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017r3m6WabhbR72oQWXUmZKp","type":"tool_result","content":"1\t\"\"\"Casting and resolution pipeline for spells and lands.\n2\t\n3\tProvides the full flow from casting a spell or playing a land through\n4\tresolution:\n5\t\n6\t- :func:`cast_spell` — verify timing & legality → move hand to stack →\n7\t  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n8\t- :func:`play_land` — verify land play remaining → move hand to\n9\t  battlefield → decrement ``land_plays_remaining``.\n10\t- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n11\t  helpers used by the casting pipeline.\n12\t\n13\tResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\n14\tcreated by :func:`cast_spell`:\n15\t\n16\t- Call ``card.on_resolve(game)``.\n17\t- Permanents (creature / enchantment / artifact / planeswalker) move from\n18\t  the stack to the battlefield.\n19\t- Non-permanents (instant / sorcery) move to the graveyard.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import TYPE_CHECKING, Any\n25\t\n26\tfrom engine.card import CardImpl\n27\tfrom engine.stack import StackObject\n28\tfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\n29\tfrom engine.zones import move_zone\n30\t\n31\tif TYPE_CHECKING:\n32\t    from engine.game_state import GameState\n33\t    from engine.player import Player\n34\t\n35\t\n36\t# Card types that represent permanents — these go to the battlefield on resolve.\n37\t_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n38\t    CardType.CREATURE,\n39\t    CardType.ENCHANTMENT,\n40\t    CardType.ARTIFACT,\n41\t    CardType.PLANESWALKER,\n42\t})\n43\t\n44\t\n45\tclass CastingError(Exception):\n46\t    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n47\t\n48\t\n49\t# ------------------------------------------------------------------\n50\t# Timing helpers\n51\t# ------------------------------------------------------------------\n52\t\n53\tdef is_sorcery_speed(game: GameState, player: Player) -> bool:\n54\t    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n55\t\n56\t    Sorcery speed requires all of:\n57\t\n58\t    * *player* is the active player.\n59\t    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n60\t      ``POSTCOMBAT_MAIN``).\n61\t    * The stack is empty.\n62\t    \"\"\"\n63\t    if player is not game.active_player:\n64\t        return False\n65\t    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n66\t        return False\n67\t    if not game.stack.is_empty():\n68\t        return False\n69\t    return True\n70\t\n71\t\n72\tdef can_cast_at_instant_speed(card: CardImpl) -> bool:\n73\t    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n74\t\n75\t    A card has instant-speed timing if it is an instant or has the\n76\t    :attr:`~engine.types.Keyword.FLASH` keyword.\n77\t    \"\"\"\n78\t    if CardType.INSTANT in card.card_types:\n79\t        return True\n80\t    if Keyword.FLASH & card.keywords:\n81\t        return True\n82\t    return False\n83\t\n84\t\n85\t# ------------------------------------------------------------------\n86\t# Cost reduction\n87\t# ------------------------------------------------------------------\n88\t\n89\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n90\t    \"\"\"Return the generic mana reduction for casting *card*.\n91\t\n92\t    Queries ``card.cost_reduction(game)`` and clamps the result so that\n93\t    the generic portion of the mana cost cannot go below 0.\n94\t\n95\t    This is a simplified single-card self-reduction model.  Full MTG\n96\t    cost-reduction interactions (Trinisphere, multiple reductions from\n97\t    different sources) are deferred.\n98\t    \"\"\"\n99\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n100\t    # casting player even when the card was never explicitly assigned one.\n101\t    prev_controller = card.controller\n102\t    card.controller = controller\n103\t    raw = card.cost_reduction(game)\n104\t    # Restore previous controller in case the caller doesn't want a\n105\t    # side-effect (get_cost_reduction is a query, not a mutation).\n106\t    card.controller = prev_controller\n107\t    generic = card.mana_cost.generic if card.mana_cost else 0\n108\t    return max(0, min(raw, generic))\n109\t\n110\t\n111\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n112\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n113\t    new_generic = max(0, cost.generic - reduction)\n114\t    return ManaCost(\n115\t        generic=new_generic,\n116\t        pips=dict(cost.pips),\n117\t        x_count=cost.x_count,\n118\t        hybrid=list(cost.hybrid),\n119\t    )\n120\t\n121\t\n122\t# ------------------------------------------------------------------\n123\t# Cast spell\n124\t# ------------------------------------------------------------------\n125\t\n126\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n127\t    \"\"\"Cast *card* from *player*'s hand.\n128\t\n129\t    Pipeline\n130\t    --------\n131\t    1. **Timing check** — instants (and cards with flash) can be cast\n132\t       whenever the player has priority; everything else requires\n133\t       sorcery-speed timing.\n134\t    2. **can_cast** — ask the card whether it can legally be cast.\n135\t    3. **Hand check** — the card must be in the player's hand.\n136\t    4. **Move hand → stack zone** — remove the card from the hand and\n137\t       place it into the player's stack zone.\n138\t    5. **Choose targets** — if the card specifies targets (via\n139\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n140\t    6. **Mana check / payment** — the player's mana pool must be able to\n141\t       pay the card's mana cost.  If payment fails, the card is rolled\n142\t       back from the stack zone to the hand.\n143\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n144\t    8. **Push StackObject** — push a :class:`StackObject` whose\n145\t       ``on_resolve`` callback handles resolution.\n146\t\n147\t    Raises:\n148\t        CastingError: If any legality check fails.\n149\t    \"\"\"\n150\t    # 1. Timing\n151\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n152\t        raise CastingError(\n153\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n154\t        )\n155\t\n156\t    # 2. can_cast\n157\t    if not card.can_cast(game):\n158\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n159\t\n160\t    # 3. Hand check\n161\t    hand = game.get_hand(player)\n162\t    if not hand.contains(card):\n163\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n164\t\n165\t    # 4. Move card from hand to stack zone\n166\t    stack_zone = player.zones[Zone.STACK]\n167\t    hand.remove(card)\n168\t    stack_zone.add(card)\n169\t\n170\t    # Clear any stale colors_spent from a prior cast before new payment.\n171\t    if hasattr(card, \"colors_spent\"):\n172\t        del card.colors_spent\n173\t\n174\t    # 5. Choose targets\n175\t    target_specs = card.get_targets(game)\n176\t    chosen_targets: list[Any] = []\n177\t    if target_specs:\n178\t        for spec in target_specs:\n179\t            target = player.choose_target(target_specs, spec)\n180\t            # Validate against filter_fn if the spec provides one\n181\t            filter_fn = getattr(spec, \"filter_fn\", None)\n182\t            if filter_fn is not None and target is not None:\n183\t                if not filter_fn(target):\n184\t                    stack_zone.remove(card)\n185\t                    hand.add(card)\n186\t                    raise CastingError(\n187\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n188\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n189\t                    )\n190\t            chosen_targets.append(target)\n191\t\n192\t    # 5b. Protection check — reject targets that have protection from this\n193\t    #     spell (the T in DEBT).\n194\t    from engine.protection import has_protection_from\n195\t\n196\t    for target in chosen_targets:\n197\t        if has_protection_from(target, card):\n198\t            # Rollback: move card from stack zone back to hand\n199\t            stack_zone.remove(card)\n200\t            hand.add(card)\n201\t            raise CastingError(\n202\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n203\t            )\n204\t\n205\t    # Targets are stored on the StackObject (not the card) and passed\n206\t    # through the resolve pipeline via on_resolve(game, targets=...).\n207\t\n208\t    # 6. Mana check / payment (rollback on failure)\n209\t    # Ensure the card knows its controller so that cost_reduction() hooks\n210\t    # (e.g. Embercleave counting attacking creatures you control) see the\n211\t    # casting player, even for cards that were added to hand without an\n212\t    # explicit controller assignment.\n213\t    if card.controller is None:\n214\t        card.controller = player\n215\t    reduction = get_cost_reduction(game, card, player)\n216\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n217\t\n218\t    if not player.mana_pool.can_pay(effective_cost):\n219\t        # Rollback: move card from stack zone back to hand\n220\t        stack_zone.remove(card)\n221\t        hand.add(card)\n222\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n223\t\n224\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n225\t    player.mana_pool.pay(effective_cost)\n226\t\n227\t    # Store colors of mana spent on the card for mechanics like Converge\n228\t    # that care about the colors used to cast the spell.\n229\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n230\t\n231\t    # 7. Call on_cast hook\n232\t    card.on_cast(game)\n233\t\n234\t    # 8. Build on_resolve callback and push StackObject\n235\t    stack_obj = StackObject(\n236\t        source=card,\n237\t        controller=player,\n238\t        targets=chosen_targets,\n239\t        on_resolve=lambda g: None,  # replaced below\n240\t    )\n241\t\n242\t    def _on_resolve(g: GameState) -> None:\n243\t        _resolve_spell(g, card, player, stack_obj)\n244\t\n245\t    stack_obj.on_resolve = _on_resolve\n246\t    game.stack.push(stack_obj)\n247\t\n248\t\n249\t# ------------------------------------------------------------------\n250\t# Cast spell without paying mana cost (free-cast from any zone)\n251\t# ------------------------------------------------------------------\n252\t\n253\t\n254\tdef cast_spell_free(\n255\t    game: GameState,\n256\t    player: Player,\n257\t    card: CardImpl,\n258\t    from_zone: Zone,\n259\t) -> None:\n260\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n261\t\n262\t    This is used by effects that allow casting from zones other than hand\n263\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n264\t    or cascade.\n265\t\n266\t    Pipeline\n267\t    --------\n268\t    1. **can_cast** — ask the card whether it can legally be cast (same\n269\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n270\t    2. Move *card* from *from_zone* to the stack zone.\n271\t    3. Choose targets (if applicable) with validation and protection check.\n272\t    4. Call ``on_cast`` hook.\n273\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n274\t       resolution normally (permanents → battlefield, non-permanents →\n275\t       graveyard).\n276\t\n277\t    No timing check or mana payment is performed.  The spell goes on the\n278\t    stack and can be responded to normally (e.g. countered).\n279\t\n280\t    If targeting or other post-move checks fail, the card is rolled back\n281\t    to its source zone.\n282\t\n283\t    Parameters:\n284\t        game: The current game state.\n285\t        player: The player casting the spell.\n286\t        card: The card to cast.\n287\t        from_zone: The zone the card is currently in.\n288\t\n289\t    Raises:\n290\t        CastingError: If the card cannot be found in *from_zone* or\n291\t            legality checks fail.\n292\t    \"\"\"\n293\t    from engine.zones import move_to_zone\n294\t\n295\t    # Ensure controller is set\n296\t    card.controller = player\n297\t    if card.owner is None:\n298\t        card.owner = player\n299\t\n300\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n301\t    if not card.can_cast(game):\n302\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n303\t\n304\t    # 2. Locate card in source zone\n305\t    source_zone_container = player.zones[from_zone]\n306\t    if not source_zone_container.contains(card):\n307\t        # Try to find the card in any player's zone\n308\t        source_zone_container = None\n309\t        for p in game.players:\n310\t            z = p.zones[from_zone]\n311\t            if z.contains(card):\n312\t                source_zone_container = z\n313\t                break\n314\t\n315\t    if source_zone_container is None or not source_zone_container.contains(card):\n316\t        raise CastingError(\n317\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n318\t        )\n319\t\n320\t    # Move card from source zone to stack zone\n321\t    stack_zone = player.zones[Zone.STACK]\n322\t    source_zone_container.remove(card)\n323\t    stack_zone.add(card)\n324\t\n325\t    # 3. Choose targets (with rollback on failure)\n326\t    try:\n327\t        target_specs = card.get_targets(game)\n328\t        chosen_targets: list[Any] = []\n329\t        if target_specs:\n330\t            for spec in target_specs:\n331\t                target = player.choose_target(target_specs, spec)\n332\t                # Validate against filter_fn if the spec provides one\n333\t                filter_fn = getattr(spec, \"filter_fn\", None)\n334\t                if filter_fn is not None and target is not None:\n335\t                    if not filter_fn(target):\n336\t                        raise CastingError(\n337\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n338\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n339\t                        )\n340\t                chosen_targets.append(target)\n341\t\n342\t        # Protection check — reject targets that have protection from this spell\n343\t        from engine.protection import has_protection_from\n344\t\n345\t        for target in chosen_targets:\n346\t            if has_protection_from(target, card):\n347\t                raise CastingError(\n348\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n349\t                )\n350\t    except Exception as exc:\n351\t        # Rollback: move card from stack zone back to source zone\n352\t        stack_zone.remove(card)\n353\t        source_zone_container.add(card)\n354\t        raise CastingError(str(exc)) from exc\n355\t\n356\t    # 4. Call on_cast hook\n357\t    card.on_cast(game)\n358\t\n359\t    # 5. Build on_resolve callback and push StackObject\n360\t    stack_obj = StackObject(\n361\t        source=card,\n362\t        controller=player,\n363\t        targets=chosen_targets,\n364\t        on_resolve=lambda g: None,  # replaced below\n365\t    )\n366\t\n367\t    def _on_resolve(g: GameState) -> None:\n368\t        _resolve_spell(g, card, player, stack_obj)\n369\t\n370\t    stack_obj.on_resolve = _on_resolve\n371\t    game.stack.push(stack_obj)\n372\t\n373\t\n374\t# ------------------------------------------------------------------\n375\t# Resolution (called when the stack pops)\n376\t# ------------------------------------------------------------------\n377\t\n378\tdef _resolve_spell(\n379\t    game: GameState,\n380\t    card: CardImpl,\n381\t    player: Player,\n382\t    stack_obj: StackObject,\n383\t) -> None:\n384\t    \"\"\"Resolve *card* cast by *player*.\n385\t\n386\t    1. Call ``card.on_resolve(game, targets=targets)``.\n387\t    2. Remove the card from the stack zone.\n388\t    3. If the card is a permanent type, move it to the battlefield via\n389\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n390\t       registration and the ETB event).\n391\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n392\t    \"\"\"\n393\t    from engine.zones import move_to_zone\n394\t\n395\t    # Read targets from the StackObject — the single source of truth.\n396\t    # Set chosen_targets on the card just before resolution so that\n397\t    # _get_chosen_target helpers (which read via getattr) work.\n398\t    targets = stack_obj.targets\n399\t    if targets is not None:\n400\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n401\t\n402\t    card.on_resolve(game)\n403\t\n404\t    if card.card_types & _PERMANENT_TYPES:\n405\t        # Move from stack to battlefield via move_to_zone, which handles\n406\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n407\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n408\t    else:\n409\t        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n410\t        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n411\t\n412\t\n413\t# ------------------------------------------------------------------\n414\t# Play land (special action — does not use the stack)\n415\t# ------------------------------------------------------------------\n416\t\n417\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n418\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n419\t\n420\t    Requirements (all must hold):\n421\t\n422\t    * *land_card* has :attr:`CardType.LAND`.\n423\t    * *player* is the active player.\n424\t    * Current phase is a main phase.\n425\t    * The stack is empty.\n426\t    * ``player.land_plays_remaining > 0``.\n427\t    * The card is in the player's hand.\n428\t\n429\t    On success the card moves from hand to battlefield and\n430\t    ``land_plays_remaining`` is decremented.\n431\t\n432\t    Raises:\n433\t        CastingError: If any requirement is not met.\n434\t    \"\"\"\n435\t    # Must be a land\n436\t    if CardType.LAND not in land_card.card_types:\n437\t        raise CastingError(\n438\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n439\t        )\n440\t\n441\t    # Sorcery-speed timing (active player, main phase, stack empty)\n442\t    if not is_sorcery_speed(game, player):\n443\t        raise CastingError(\n444\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n445\t            \"during main phase with empty stack\"\n446\t        )\n447\t\n448\t    # Land plays remaining\n449\t    if player.land_plays_remaining <= 0:\n450\t        raise CastingError(\n451\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n452\t        )\n453\t\n454\t    # Card must be in hand\n455\t    hand = game.get_hand(player)\n456\t    if not hand.contains(land_card):\n457\t        raise CastingError(\n458\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n459\t        )\n460\t\n461\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n462\t    if land_card.owner is None:\n463\t        land_card.owner = player\n464\t    land_card.controller = player\n465\t\n466\t    # Move from hand to battlefield via move_to_zone, which fires\n467\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n468\t    from engine.zones import move_to_zone\n469\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n470\t\n471\t    # Decrement land plays\n472\t    player.land_plays_remaining -= 1\n473\t\n474\t\n475\tdef resolve_top(game: GameState) -> None:\n476\t    \"\"\"Resolve the top spell/ability on the stack.\n477\t\n478\t    Pops the top item from the stack, calls its on_resolve callback,\n479\t    then runs state-based actions.  If the stack is empty this is a no-op.\n480\t    \"\"\"\n481\t    if game.stack.is_empty():\n482\t        return\n483\t    from engine.state_based_actions import resolve_state_based_actions\n484\t\n485\t    obj = game.stack.pop()\n486\t    obj.on_resolve(game)\n487\t    resolve_state_based_actions(game)\n488\t"}]},"parent_tool_use_id":null,"session_id":"25473cdc-0503-4b45-9076-b9d3fca79f4a","uuid":"8a41c554-a068-4acd-a079-a4fc7631b83a","timestamp":"2026-06-10T16:34:22.242Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"\"\"\"Casting and resolution pipeline for spells and lands.\n\nProvides the full flow from casting a spell or playing a land through\nresolution:\n\n- :func:`cast_spell` — verify timing & legality → move hand to stack →\n  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n- :func:`play_land` — verify land play remaining → move hand to\n  battlefield → decrement ``land_plays_remaining``.\n- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n  helpers used by the casting pipeline.\n\nResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\ncreated by :func:`cast_spell`:\n\n- Call ``card.on_resolve(game)``.\n- Permanents (creature / enchantment / artifact / planeswalker) move from\n  the stack to the battlefield.\n- Non-permanents (instant / sorcery) move to the graveyard.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import CardImpl\nfrom engine.stack import StackObject\nfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\nfrom engine.zones import move_zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n# Card types that represent permanents — these go to the battlefield on resolve.\n_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n    CardType.CREATURE,\n    CardType.ENCHANTMENT,\n    CardType.ARTIFACT,\n    CardType.PLANESWALKER,\n})\n\n\nclass CastingError(Exception):\n    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n\n\n# ------------------------------------------------------------------\n# Timing helpers\n# ------------------------------------------------------------------\n\ndef is_sorcery_speed(game: GameState, player: Player) -> bool:\n    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n\n    Sorcery speed requires all of:\n\n    * *player* is the active player.\n    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n      ``POSTCOMBAT_MAIN``).\n    * The stack is empty.\n    \"\"\"\n    if player is not game.active_player:\n        return False\n    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n        return False\n    if not game.stack.is_empty():\n        return False\n    return True\n\n\ndef can_cast_at_instant_speed(card: CardImpl) -> bool:\n    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n\n    A card has instant-speed timing if it is an instant or has the\n    :attr:`~engine.types.Keyword.FLASH` keyword.\n    \"\"\"\n    if CardType.INSTANT in card.card_types:\n        return True\n    if Keyword.FLASH & card.keywords:\n        return True\n    return False\n\n\n# ------------------------------------------------------------------\n# Cost reduction\n# ------------------------------------------------------------------\n\ndef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n    \"\"\"Return the generic mana reduction for casting *card*.\n\n    Queries ``card.cost_reduction(game)`` and clamps the result so that\n    the generic portion of the mana cost cannot go below 0.\n\n    This is a simplified single-card self-reduction model.  Full MTG\n    cost-reduction interactions (Trinisphere, multiple reductions from\n    different sources) are deferred.\n    \"\"\"\n    # Ensure card.controller is set so the hook can reference \"you\" / the\n    # casting player even when the card was never explicitly assigned one.\n    prev_controller = card.controller\n    card.controller = controller\n    raw = card.cost_reduction(game)\n    # Restore previous controller in case the caller doesn't want a\n    # side-effect (get_cost_reduction is a query, not a mutation).\n    card.controller = prev_controller\n    generic = card.mana_cost.generic if card.mana_cost else 0\n    return max(0, min(raw, generic))\n\n\ndef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n    new_generic = max(0, cost.generic - reduction)\n    return ManaCost(\n        generic=new_generic,\n        pips=dict(cost.pips),\n        x_count=cost.x_count,\n        hybrid=list(cost.hybrid),\n    )\n\n\n# ------------------------------------------------------------------\n# Cast spell\n# ------------------------------------------------------------------\n\ndef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n    \"\"\"Cast *card* from *player*'s hand.\n\n    Pipeline\n    --------\n    1. **Timing check** — instants (and cards with flash) can be cast\n       whenever the player has priority; everything else requires\n       sorcery-speed timing.\n    2. **can_cast** — ask the card whether it can legally be cast.\n    3. **Hand check** — the card must be in the player's hand.\n    4. **Move hand → stack zone** — remove the card from the hand and\n       place it into the player's stack zone.\n    5. **Choose targets** — if the card specifies targets (via\n       :meth:`CardImpl.get_targets`), the player is asked to choose.\n    6. **Mana check / payment** — the player's mana pool must be able to\n       pay the card's mana cost.  If payment fails, the card is rolled\n       back from the stack zone to the hand.\n    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n    8. **Push StackObject** — push a :class:`StackObject` whose\n       ``on_resolve`` callback handles resolution.\n\n    Raises:\n        CastingError: If any legality check fails.\n    \"\"\"\n    # 1. Timing\n    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n        )\n\n    # 2. can_cast\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 3. Hand check\n    hand = game.get_hand(player)\n    if not hand.contains(card):\n        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n\n    # 4. Move card from hand to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    hand.remove(card)\n    stack_zone.add(card)\n\n    # Clear any stale colors_spent from a prior cast before new payment.\n    if hasattr(card, \"colors_spent\"):\n        del card.colors_spent\n\n    # 5. Choose targets\n    target_specs = card.get_targets(game)\n    chosen_targets: list[Any] = []\n    if target_specs:\n        for spec in target_specs:\n            target = player.choose_target(target_specs, spec)\n            # Validate against filter_fn if the spec provides one\n            filter_fn = getattr(spec, \"filter_fn\", None)\n            if filter_fn is not None and target is not None:\n                if not filter_fn(target):\n                    stack_zone.remove(card)\n                    hand.add(card)\n                    raise CastingError(\n                        f\"Cannot cast {card.name!r} — chosen target does not \"\n                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                    )\n            chosen_targets.append(target)\n\n    # 5b. Protection check — reject targets that have protection from this\n    #     spell (the T in DEBT).\n    from engine.protection import has_protection_from\n\n    for target in chosen_targets:\n        if has_protection_from(target, card):\n            # Rollback: move card from stack zone back to hand\n            stack_zone.remove(card)\n            hand.add(card)\n            raise CastingError(\n                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n            )\n\n    # Targets are stored on the StackObject (not the card) and passed\n    # through the resolve pipeline via on_resolve(game, targets=...).\n\n    # 6. Mana check / payment (rollback on failure)\n    # Ensure the card knows its controller so that cost_reduction() hooks\n    # (e.g. Embercleave counting attacking creatures you control) see the\n    # casting player, even for cards that were added to hand without an\n    # explicit controller assignment.\n    if card.controller is None:\n        card.controller = player\n    reduction = get_cost_reduction(game, card, player)\n    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n\n    if not player.mana_pool.can_pay(effective_cost):\n        # Rollback: move card from stack zone back to hand\n        stack_zone.remove(card)\n        hand.add(card)\n        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n\n    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n    player.mana_pool.pay(effective_cost)\n\n    # Store colors of mana spent on the card for mechanics like Converge\n    # that care about the colors used to cast the spell.\n    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n\n    # 7. Call on_cast hook\n    card.on_cast(game)\n\n    # 8. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n\n# ------------------------------------------------------------------\n# Cast spell without paying mana cost (free-cast from any zone)\n# ------------------------------------------------------------------\n\n\ndef cast_spell_free(\n    game: GameState,\n    player: Player,\n    card: CardImpl,\n    from_zone: Zone,\n) -> None:\n    \"\"\"Cast *card* without paying its mana cost, using the stack.\n\n    This is used by effects that allow casting from zones other than hand\n    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n    or cascade.\n\n    Pipeline\n    --------\n    1. **can_cast** — ask the card whether it can legally be cast (same\n       legality as :func:`cast_spell`, minus mana/timing constraints).\n    2. Move *card* from *from_zone* to the stack zone.\n    3. Choose targets (if applicable) with validation and protection check.\n    4. Call ``on_cast`` hook.\n    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n       resolution normally (permanents → battlefield, non-permanents →\n       graveyard).\n\n    No timing check or mana payment is performed.  The spell goes on the\n    stack and can be responded to normally (e.g. countered).\n\n    If targeting or other post-move checks fail, the card is rolled back\n    to its source zone.\n\n    Parameters:\n        game: The current game state.\n        player: The player casting the spell.\n        card: The card to cast.\n        from_zone: The zone the card is currently in.\n\n    Raises:\n        CastingError: If the card cannot be found in *from_zone* or\n            legality checks fail.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Ensure controller is set\n    card.controller = player\n    if card.owner is None:\n        card.owner = player\n\n    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 2. Locate card in source zone\n    source_zone_container = player.zones[from_zone]\n    if not source_zone_container.contains(card):\n        # Try to find the card in any player's zone\n        source_zone_container = None\n        for p in game.players:\n            z = p.zones[from_zone]\n            if z.contains(card):\n                source_zone_container = z\n                break\n\n    if source_zone_container is None or not source_zone_container.contains(card):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n        )\n\n    # Move card from source zone to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    source_zone_container.remove(card)\n    stack_zone.add(card)\n\n    # 3. Choose targets (with rollback on failure)\n    try:\n        target_specs = card.get_targets(game)\n        chosen_targets: list[Any] = []\n        if target_specs:\n            for spec in target_specs:\n                target = player.choose_target(target_specs, spec)\n                # Validate against filter_fn if the spec provides one\n                filter_fn = getattr(spec, \"filter_fn\", None)\n                if filter_fn is not None and target is not None:\n                    if not filter_fn(target):\n                        raise CastingError(\n                            f\"Cannot cast {card.name!r} — chosen target does not \"\n                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                        )\n                chosen_targets.append(target)\n\n        # Protection check — reject targets that have protection from this spell\n        from engine.protection import has_protection_from\n\n        for target in chosen_targets:\n            if has_protection_from(target, card):\n                raise CastingError(\n                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n                )\n    except Exception as exc:\n        # Rollback: move card from stack zone back to source zone\n        stack_zone.remove(card)\n        source_zone_container.add(card)\n        raise CastingError(str(exc)) from exc\n\n    # 4. Call on_cast hook\n    card.on_cast(game)\n\n    # 5. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n\n# ------------------------------------------------------------------\n# Resolution (called when the stack pops)\n# ------------------------------------------------------------------\n\ndef _resolve_spell(\n    game: GameState,\n    card: CardImpl,\n    player: Player,\n    stack_obj: StackObject,\n) -> None:\n    \"\"\"Resolve *card* cast by *player*.\n\n    1. Call ``card.on_resolve(game, targets=targets)``.\n    2. Remove the card from the stack zone.\n    3. If the card is a permanent type, move it to the battlefield via\n       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n       registration and the ETB event).\n    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Read targets from the StackObject — the single source of truth.\n    # Set chosen_targets on the card just before resolution so that\n    # _get_chosen_target helpers (which read via getattr) work.\n    targets = stack_obj.targets\n    if targets is not None:\n        card.chosen_targets = targets  # type: ignore[attr-defined]\n\n    card.on_resolve(game)\n\n    if card.card_types & _PERMANENT_TYPES:\n        # Move from stack to battlefield via move_to_zone, which handles\n        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n    else:\n        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n\n\n# ------------------------------------------------------------------\n# Play land (special action — does not use the stack)\n# ------------------------------------------------------------------\n\ndef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n\n    Requirements (all must hold):\n\n    * *land_card* has :attr:`CardType.LAND`.\n    * *player* is the active player.\n    * Current phase is a main phase.\n    * The stack is empty.\n    * ``player.land_plays_remaining > 0``.\n    * The card is in the player's hand.\n\n    On success the card moves from hand to battlefield and\n    ``land_plays_remaining`` is decremented.\n\n    Raises:\n        CastingError: If any requirement is not met.\n    \"\"\"\n    # Must be a land\n    if CardType.LAND not in land_card.card_types:\n        raise CastingError(\n            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n        )\n\n    # Sorcery-speed timing (active player, main phase, stack empty)\n    if not is_sorcery_speed(game, player):\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — must be active player \"\n            \"during main phase with empty stack\"\n        )\n\n    # Land plays remaining\n    if player.land_plays_remaining <= 0:\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n        )\n\n    # Card must be in hand\n    hand = game.get_hand(player)\n    if not hand.contains(land_card):\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — card not in hand\"\n        )\n\n    # Ensure owner/controller are set so move_to_zone routes correctly.\n    if land_card.owner is None:\n        land_card.owner = player\n    land_card.controller = player\n\n    # Move from hand to battlefield via move_to_zone, which fires\n    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n    from engine.zones import move_to_zone\n    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n\n    # Decrement land plays\n    player.land_plays_remaining -= 1\n\n\ndef resolve_top(game: GameState) -> None:\n    \"\"\"Resolve the top spell/ability on the stack.\n\n    Pops the top item from the stack, calls its on_resolve callback,\n    then runs state-based actions.  If the stack is empty this is a no-op.\n    \"\"\"\n    if game.stack.is_empty():\n        return\n    from engine.state_based_actions import resolve_state_based_actions\n\n    obj = game.stack.pop()\n    obj.on_resolve(game)\n    resolve_state_based_actions(game)\n","numLines":488,"startLine":1,"totalLines":488}}}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_019mD3Kmd2fxFqibcXj1dvdd","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01XssmUApprUJVXdHTAZFEEA","name":"Read","input":{"file_path":"/workspace/engine/events.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":131,"cache_creation_input_tokens":3434,"cache_read_input_tokens":35444,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3434},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"25473cdc-0503-4b45-9076-b9d3fca79f4a","uuid":"bf5b9290-888e-4120-b4f0-d79d76f514a2","request_id":"req_011CbuuJPQMPhohPUfhHEQkG"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XssmUApprUJVXdHTAZFEEA","type":"tool_result","content":"1\t\"\"\"Typed event objects for triggered abilities and replacement effects.\n2\t\n3\tTriggered events are passed to :meth:`TriggerManager.fire_event` and\n4\tforwarded to trigger condition callables.\n5\t\n6\tReplacement events are passed to :meth:`ReplacementManager.apply` and\n7\tforwarded to replacement condition/replacement callables.  Subclassing\n8\tencodes event-type hierarchy so a replacement registered for a parent\n9\ttype (e.g. ``MoveToGraveyardReplacementEvent``) also fires for\n10\tsubtypes (e.g. ``CreatureDiesReplacementEvent``).\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\tfrom dataclasses import dataclass\n16\tfrom typing import Any\n17\t\n18\t\n19\t# ---------------------------------------------------------------------------\n20\t# Triggered events\n21\t# ---------------------------------------------------------------------------\n22\t\n23\t@dataclass\n24\tclass TriggeredEvent:\n25\t    \"\"\"Base class for all triggered-ability events.\"\"\"\n26\t\n27\t\n28\t@dataclass\n29\tclass EntersBattlefieldTriggeredEvent(TriggeredEvent):\n30\t    permanent: Any = None\n31\t    controller: Any = None\n32\t    card: Any = None\n33\t    creature: Any = None\n34\t\n35\t\n36\t@dataclass\n37\tclass LeavesBattlefieldTriggeredEvent(TriggeredEvent):\n38\t    permanent: Any = None\n39\t    controller: Any = None\n40\t\n41\t\n42\t@dataclass\n43\tclass DealsDamageTriggeredEvent(TriggeredEvent):\n44\t    source: Any = None\n45\t    target: Any = None\n46\t    amount: int = 0\n47\t    is_combat: bool = False\n48\t    combat: bool = False\n49\t\n50\t\n51\t@dataclass\n52\tclass LosesLifeTriggeredEvent(TriggeredEvent):\n53\t    player: Any = None\n54\t    amount: int = 0\n55\t\n56\t\n57\t@dataclass\n58\tclass GainsLifeTriggeredEvent(TriggeredEvent):\n59\t    player: Any = None\n60\t    amount: int = 0\n61\t\n62\t\n63\t@dataclass\n64\tclass DrawsCardTriggeredEvent(TriggeredEvent):\n65\t    player: Any = None\n66\t    card: Any = None\n67\t\n68\t\n69\t@dataclass\n70\tclass BeginningOfUpkeepTriggeredEvent(TriggeredEvent):\n71\t    pass\n72\t\n73\t\n74\t@dataclass\n75\tclass BeginningOfCombatTriggeredEvent(TriggeredEvent):\n76\t    pass\n77\t\n78\t\n79\t@dataclass\n80\tclass EndOfTurnTriggeredEvent(TriggeredEvent):\n81\t    pass\n82\t\n83\t\n84\t@dataclass\n85\tclass EndStepTriggeredEvent(TriggeredEvent):\n86\t    player: Any = None\n87\t\n88\t\n89\t@dataclass\n90\tclass CreatureDiesTriggeredEvent(TriggeredEvent):\n91\t    creature: Any = None\n92\t    controller: Any = None\n93\t    owner: Any = None\n94\t\n95\t\n96\t@dataclass\n97\tclass SpellCastTriggeredEvent(TriggeredEvent):\n98\t    spell: Any = None\n99\t    player: Any = None\n100\t    card: Any = None\n101\t    controller: Any = None\n102\t\n103\t\n104\t@dataclass\n105\tclass AttacksTriggeredEvent(TriggeredEvent):\n106\t    creature: Any = None\n107\t    attacker: Any = None\n108\t\n109\t\n110\t@dataclass\n111\tclass BlocksTriggeredEvent(TriggeredEvent):\n112\t    creature: Any = None\n113\t\n114\t\n115\t@dataclass\n116\tclass CounterAddedTriggeredEvent(TriggeredEvent):\n117\t    permanent: Any = None\n118\t    counter_type: Any = None\n119\t    amount: int = 0\n120\t\n121\t\n122\t# ---------------------------------------------------------------------------\n123\t# Replacement events\n124\t# ---------------------------------------------------------------------------\n125\t\n126\t@dataclass\n127\tclass ReplacementEvent:\n128\t    \"\"\"Base class for all replacement-effect events.\"\"\"\n129\t\n130\t\n131\t@dataclass\n132\tclass MoveToGraveyardReplacementEvent(ReplacementEvent):\n133\t    \"\"\"Any permanent moving to a graveyard.\n134\t\n135\t    Subclass this for specific causes (destruction, sacrifice, etc.).\n136\t    A replacement registered for this type also fires for all subtypes.\n137\t\n138\t    ``destination`` may be