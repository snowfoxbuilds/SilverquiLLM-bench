     def __init__(self) -> None:
         self._pool: dict[ManaType, int] = {mt: 0 for mt in ManaType}
         self._last_payment_colors: list[Color] = []
+        # Amount of each mana type that may be spent ONLY to cast an instant or
+        # sorcery spell (e.g. Great Hall of the Biblioplex).  Tracked alongside
+        # the pool; enforcement happens in cast_spell via reserve_restricted().
+        self._restricted: dict[ManaType, int] = {mt: 0 for mt in ManaType}
 
     # ------------------------------------------------------------------
     # Basic operations
     # ------------------------------------------------------------------
 
-    def add(self, mana_type: ManaType, amount: int = 1) -> None:
+    def add(self, mana_type: ManaType, amount: int = 1, restricted: bool = False) -> None:
         """Add *amount* mana of the given type to the pool.
 
         Parameters:
             mana_type: The type of mana to add.
             amount: How many mana to add (must be non-negative).
+            restricted: If ``True``, this mana may only be spent to cast an
+                instant or sorcery spell (tracked via ``_restricted``).
         """
         if amount < 0:
             raise ValueError(f"Cannot add negative mana: {amount}")
         self._pool[mana_type] = self._pool.get(mana_type, 0) + amount
+        if restricted:
+            self._restricted[mana_type] = self._restricted.get(mana_type, 0) + amount
 
     def empty(self) -> None:
         """Clear the pool — happens at phase/step transitions."""
         for mt in self._pool:
             self._pool[mt] = 0
+        for mt in self._restricted:
+            self._restricted[mt] = 0
+
+    # ------------------------------------------------------------------
+    # Restricted (instant/sorcery-only) mana
+    # ------------------------------------------------------------------
+
+    def has_restricted(self) -> bool:
+        """Return ``True`` if the pool holds any instant/sorcery-only mana."""
+        return any(v > 0 for v in self._restricted.values())
+
+    def reserve_restricted(self) -> dict[ManaType, int]:
+        """Temporarily remove instant/sorcery-only mana from the spendable pool.
+
+        Returns a mapping of the amounts removed so they can be restored with
+        :meth:`restore_restricted`.  Used by ``cast_spell`` to forbid spending
+        restricted mana on spells that are not instants or sorceries.
+        """
+        removed: dict[ManaType, int] = {}
+        for mt, amt in self._restricted.items():
+            take = min(amt, self._pool.get(mt, 0))
+            if take > 0:
+                self._pool[mt] -= take
+                removed[mt] = take
+        return removed
+
+    def restore_restricted(self, removed: dict[ManaType, int]) -> None:
+        """Restore mana previously removed by :meth:`reserve_restricted`."""
+        for mt, amt in removed.items():
+            self._pool[mt] = self._pool.get(mt, 0) + amt
 
     def total(self) -> int:
         """Return the total amount of mana in the pool across all types."""
