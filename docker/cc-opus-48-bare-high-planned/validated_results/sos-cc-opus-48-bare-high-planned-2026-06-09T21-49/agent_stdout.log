\n            cast_spell(game, 0, \"Small Spell\")\n        except Exception:\n            pass\n        hand = [getattr(c, \"name\", \"\") for c in game.get_hand(p0).get_all()]\n        assert \"Small Spell\" in hand\n","structuredPatch":[],"originalFile":null,"userModified":false}}
