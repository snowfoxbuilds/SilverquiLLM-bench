ine changes beyond current scope.\n45\t        \"\"\"\n46\t        total_creatures = 0\n47\t        for player in game.players:\n48\t            bf = game.get_battlefield(player)\n49\t            for obj in bf.get_all():\n50\t                if CardType.CREATURE in getattr(obj, \"card_types\", set()):\n51\t                    total_creatures += 1\n52\t        if total_creatures >= 13:\n53\t            return 4  # Intent: reduce to {B}; engine limitation applies\n54\t        return 0\n55\t\n56\t    def on_resolve(self, game: \"GameState\") -> None:\n57\t        \"\"\"Each player sacrifices thirteen creatures of their choice.\"\"\"\n58\t        from engine.game import sacrifice\n59\t\n60\t        for player in game.players:\n61\t            bf = game.get_battlefield(player)\n62\t            for _ in range(13):\n63\t                creatures = [\n64\t                    c for c in bf.get_all()\n65\t                    if CardType.CREATURE in getattr(c, \"card_types\", set())\n66\t                ]\n67\t                if not creatures:\n68\t                    break\n69\t                try:\n70\t                    chosen = player.choose_card(creatures, \"sacrifice a creature\")\n71\t                except Exception:\n72\t                    chosen = creatures[-1] if creatures else None\n73\t                if chosen is not None:\n74\t                    sacrifice(game, player, chosen)\n75\t\n76\t===== fdn_194 IMPL =====\n77\t\"\"\"Card implementation for Etali, Primal Storm.\"\"\"\n78\tfrom __future__ import annotations\n79\tfrom typing import TYPE_CHECKING, Any\n80\tfrom engine.card import Creature\n81\tfrom engine.types import CardType, ManaCost, Zone\n82\tfrom engine.events import AttacksTriggeredEvent\n83\tif TYPE_CHECKING:\n84\t    from engine.game_state import GameState\n85\t\n86\tclass EtaliPrimalStorm(Creature):\n87\t    \"\"\"Etali, Primal Storm — {4}{R}{R} — 6/6 — Legendary Elder Dinosaur.\n88\t\n89\t    Whenever Etali attacks, exile the top card of each player's library,\n90\t    then you may cast any number of spells from among those cards without\n91\t    paying their mana costs.\n92\t\n93\t    FDN collector number 194.\n94\t    \"\"\"\n95\t\n96\t    def __init__(self, **kwargs: Any) -> None:\n97\t        kwargs.setdefault('name', 'Etali, Primal Storm')\n98\t        kwargs.setdefault('mana_cost', ManaCost.parse('{4}{R}{R}'))\n99\t        kwargs.setdefault('subtypes', {'Elder', 'Dinosaur'})\n100\t        kwargs.setdefault('supertypes', {'Legendary'})\n101\t        kwargs.setdefault('base_power', 6)\n102\t        kwargs.setdefault('base_toughness', 6)\n103\t        kwargs.setdefault('rules_text', \"Whenever Etali attacks, exile the top card of each player's library, then you may cast any number of spells from among those cards without paying their mana costs.\")\n104\t        super().__init__(**kwargs)\n105\t\n106\t    def register_triggers(self, game: 'GameState') -> None:\n107\t        \"\"\"Register attack trigger for exile-and-cast.\"\"\"\n108\t        from engine.triggers import TriggerRegistration\n109\t        from engine.zones import move_to_zone\n110\t        from engine.casting import cast_spell_free\n111\t        source = self\n112\t        controller = getattr(self, 'controller', None) or game.active_player\n113\t\n114\t        def _condition(game: Any, event: dict) -> bool:\n115\t            return event.creature is source\n116\t\n117\t        def _effect(game: 'GameState') -> None:\n118\t            ctrl = getattr(source, 'controller', None)\n119\t            if ctrl is None:\n120\t                return\n121\t            exiled_cards: list = []\n122\t            for player in game.players:\n123\t                library = player.zones[Zone.LIBRARY]\n124\t                cards = library.get_all()\n125\t                if cards:\n126\t                    top_card = cards[-1]\n127\t                    move_to_zone(game, top_card, Zone.LIBRARY, Zone.EXILE)\n128\t                    exiled_cards.append(top_card)\n129\t            # Filter out lands — Etali can only cast nonland cards\n130\t            castable = [c for c in exiled_cards if CardType.LAND not in getattr(c, 'card_types', set())]\n131\t            for card in castable:\n132\t                try:\n133\t                    if ctrl.choose_yes_no(f\"Cast {getattr(card, 'name', 'card')} without paying its mana cost?\"):\n134\t                        # Use the proper cast pipeline — spell goes on the\n135\t                        # stack and can be responded to (e.g. countered).\n136\t                        cast_spell_free(game, ctrl, card, Zone.EXILE)\n137\t                except Exception:\n138\t                    pass\n139\t        game.trigger_manager.register(TriggerRegistration(event_type=AttacksTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=controller))\n140\t\n141\t===== fdn_161 IMPL =====\n142\t\"\"\"Card implementation for Omniscience.\"\"\"\n143\t\n144\tfrom __future__ import annotations\n145\t\n146\tfrom typing import TYPE_CHECKING, Any\n147\t\n148\tfrom engine.card import Enchantment\n149\tfrom engine.continuous_effects import (\n150\t    ContinuousEffect,\n151\t    DURATION_PERMANENT,\n152\t    Layer,\n153\t)\n154\tfrom engine.types import ManaCost\n155\t\n156\tif TYPE_CHECKING:\n157\t    from engine.game_state import GameState\n158\t\n159\t\n160\tdef _is_on_battlefield(game: Any, obj: Any) -> bool:\n161\t    \"\"\"Return True if *obj* is on any player's battlefield.\"\"\"\n162\t    for player in game.players:\n163\t        if game.get_battlefield(player).contains(obj):\n164\t            return True\n165\t    return False\n166\t\n167\t\n168\tclass Omniscience(Enchantment):\n169\t    \"\"\"Omniscience — {7}{U}{U}{U} — Enchantment.\n170\t\n171\t    You may cast spells from your hand without paying their mana costs.\n172\t\n173\t    FDN collector number 161.\n174\t    \"\"\"\n175\t\n176\t    def __init__(self, **kwargs: Any) -> None:\n177\t        kwargs.setdefault(\"name\", \"Omniscience\")\n178\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{7}{U}{U}{U}\"))\n179\t        kwargs.setdefault(\n180\t            \"rules_text\",\n181\t            \"You may cast spells from your hand without paying their mana costs.\",\n182\t        )\n183\t        super().__init__(**kwargs)\n184\t\n185\t    def apply_continuous_effect(self, game: \"GameState\") -> None:\n186\t        \"\"\"Register continuous effect for free casting.\"\"\"\n187\t        source = self\n188\t\n189\t        def _apply(game: Any) -> None:\n190\t            # ENGINE LIMITATION: The engine doesn't have a \"cast without\n191\t            # paying mana cost\" hook. This is a marker effect that the\n192\t            # casting system would need to consult.\n193\t            if not _is_on_battlefield(game, source):\n194\t                return\n195\t            ctrl = getattr(source, \"controller\", None)\n196\t            if ctrl is not None:\n197\t                ctrl._omniscience_active = True\n198\t\n199\t        game.effect_manager.add(ContinuousEffect(\n200\t            source=self,\n201\t            layer=Layer.ABILITY,\n202\t            sublayer=None,\n203\t            apply=_apply,\n204\t            duration=DURATION_PERMANENT,\n205\t        ))\n206\t\n207\t===== fdn_248 IMPL =====\n208\t\"\"\"Card implementation for Thousand-Year Storm.\"\"\"\n209\tfrom __future__ import annotations\n210\tfrom typing import TYPE_CHECKING, Any\n211\tfrom engine.card import Enchantment\n212\tfrom engine.types import CardType, ManaCost\n213\tfrom engine.events import SpellCastTriggeredEvent\n214\tif TYPE_CHECKING:\n215\t    from engine.game_state import GameState\n216\t\n217\t\n218\tclass ThousandYearStorm(Enchantment):\n219\t    \"\"\"Thousand-Year Storm — {4}{U}{R} — Enchantment.\n220\t\n221\t    Whenever you cast an instant or sorcery spell, copy it for each\n222\t    other instant and sorcery spell you've cast before it this turn.\n223\t    You may choose new targets for the copies.\n224\t\n225\t    FDN collector number 248.\n226\t    \"\"\"\n227\t\n228\t    def __init__(self, **kwargs: Any) -> None:\n229\t        kwargs.setdefault('name', 'Thousand-Year Storm')\n230\t        kwargs.setdefault('mana_cost', ManaCost.parse('{4}{U}{R}'))\n231\t        kwargs.setdefault(\n232\t            'rules_text',\n233\t            \"Whenever you cast an instant or sorcery spell, copy it for each \"\n234\t            \"other instant and sorcery spell you've cast before it this turn. \"\n235\t            \"You may choose new targets for the copies.\",\n236\t        )\n237\t        super().__init__(**kwargs)\n238\t\n239\t    def register_triggers(self, game: 'GameState') -> None:\n240\t        from engine.stack import copy_spell\n241\t        from engine.triggers import TriggerRegistration\n242\t\n243\t        source = self\n244\t        controller = getattr(self, 'controller', None) or game.active_player\n245\t        source._storm_count: int = 0\n246\t        source._last_turn: int = getattr(game, 'turn_number', 0)\n247\t\n248\t        def _condition(game: Any, event: Any) -> bool:\n249\t            ctrl = getattr(source, 'controller', None)\n250\t            caster = getattr(event, 'player', None) or getattr(event, 'controller', None)\n251\t            if caster is not ctrl:\n252\t                return False\n253\t            spell = getattr(event, 'spell', None) or getattr(event, 'card', None)\n254\t            if spell is None:\n255\t                return False\n256\t            card_types = getattr(spell, 'card_types', set())\n257\t            if not card_types & {CardType.INSTANT, CardType.SORCERY}:\n258\t                return False\n259\t            current_turn = getattr(game, 'turn_number', 0)\n260\t            if current_turn != source._last_turn:\n261\t                source._storm_count = 0\n262\t                source._last_turn = current_turn\n263\t            source._pending_spell = spell\n264\t            return True\n265\t\n266\t        def _effect(game: 'GameState') -> None:\n267\t            copies_to_make = source._storm_count\n268\t            source._storm_count += 1\n269\t            if copies_to_make <= 0:\n270\t                return\n271\t            ctrl = getattr(source, 'controller', None)\n272\t            if ctrl is None:\n273\t                return\n274\t            pending_spell = getattr(source, '_pending_spell', None)\n275\t            if pending_spell is None:\n276\t                return\n277\t            original_so = None\n278\t            for so in game.stack._items:\n279\t                if so.source is pending_spell:\n280\t                    original_so = so\n281\t                    break\n282\t            if original_so is None:\n283\t                return\n284\t            for _ in range(copies_to_make):\n285\t                new_targets: list[Any] | None = None\n286\t                if original_so.targets:\n287\t                    if ctrl.choose_yes_no(\n288\t                        f\"Choose new targets for copy of {original_so.source.name}?\"\n289\t                    ):\n290\t                        requirements = getattr(\n291\t                            original_so.source, 'get_targets', lambda _: []\n292\t                        )(game)\n293\t                        new_targets = []\n294\t                        for req in requirements:\n295\t                            legal: list[Any] = []\n296\t                            for p in game.players:\n297\t                                for obj in game.get_battlefield(p).get_all():\n298\t                                    if req.filter_fn(obj):\n299\t                                        legal.append(obj)\n300\t                                if req.filter_fn(p):\n301\t                                    legal.append(p)\n302\t                            if legal:\n303\t                                chosen = ctrl.choose_target(legal, req)\n304\t                                new_targets.append(chosen)\n305\t                copy_obj = copy_spell(game, original_so, ctrl, new_targets)\n306\t                game.stack.push(copy_obj)\n307\t\n308\t        game.trigger_manager.register(TriggerRegistration(\n309\t            event_type=SpellCastTriggeredEvent,\n310\t            condition=_condition,\n311\t            effect=_effect,\n312\t            source=self,\n313\t            controller=controller,\n314\t        ))\n315\t\n316\t===== fdn_235 IMPL =====\n317\t\"\"\"Card implementation for Wary Thespian.\"\"\"\n318\tfrom __future__ import annotations\n319\tfrom typing import TYPE_CHECKING, Any\n320\tfrom engine.card import ArtifactCreature, Creature\n321\tfrom engine.types import CardType, Keyword, ManaCost, Supertype, Zone\n322\tfrom engine.events import CreatureDiesTriggeredEvent, EntersBattlefieldTriggeredEvent\n323\tif TYPE_CHECKING:\n324\t    from engine.game_state import GameState\n325\t    from cards.registry import CardRegistry\n326\t\n327\tdef _self_dies_condition(source: Any):\n328\t    \"\"\"Return a condition callable that matches only when *source* dies.\"\"\"\n329\t\n330\t    def _condition(game: Any, event: dict) -> bool:\n331\t        return event.creature is source\n332\t    return _condition\n333\t\n334\tdef _self_etb_condition(source: Any):\n335\t    \"\"\"Return a condition callable that matches only when *source* enters.\"\"\"\n336\t\n337\t    def _condition(game: Any, event: dict) -> bool:\n338\t        return event.permanent is source\n339\t    return _condition\n340\t\n341\tclass WaryThespian(Creature):\n342\t    \"\"\"Wary Thespian — {1}{G} — 3/1 — Cat Druid\n343\t\n344\t    When this creature enters or dies, surveil 1.\n345\t\n346\t    FDN collector number 235.\n347\t    \"\"\"\n348\t\n349\t    def __init__(self, **kwargs: Any) -> None:\n350\t        kwargs.setdefault('name', 'Wary Thespian')\n351\t        kwargs.setdefault('mana_cost', ManaCost.parse('{1}{G}'))\n352\t        kwargs.setdefault('subtypes', {'Cat', 'Druid'})\n353\t        kwargs.setdefault('base_power', 3)\n354\t        kwargs.setdefault('base_toughness', 1)\n355\t        kwargs.setdefault('rules_text', 'When this creature enters or dies, surveil 1.')\n356\t        super().__init__(**kwargs)\n357\t\n358\t    def register_triggers(self, game: GameState) -> None:\n359\t        from engine.triggers import TriggerRegistration\n360\t        source = self\n361\t\n362\t        def _surveil_effect(game: GameState) -> None:\n363\t            controller = getattr(source, 'controller', None) or getattr(source, 'owner', None)\n364\t            if controller is None:\n365\t                return\n366\t            library = controller.zones[Zone.LIBRARY]\n367\t            if len(library) > 0:\n368\t                card = library.top(1)[0]\n369\t                library.remove(card)\n370\t                graveyard = controller.zones[Zone.GRAVEYARD]\n371\t                graveyard.add(card)\n372\t        controller = getattr(self, 'controller', None) or game.active_player\n373\t        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=_self_etb_condition(self), effect=_surveil_effect, source=self, controller=controller))\n374\t        game.trigger_manager.register(TriggerRegistration(event_type=CreatureDiesTriggeredEvent, condition=_self_dies_condition(self), effect=_surveil_effect, source=self, controller=controller))\n375\t\n376\t===== fdn_81 IMPL =====\n377\t\"\"\"Card implementation for Chandra, Flameshaper.\"\"\"\n378\tfrom __future__ import annotations\n379\tfrom typing import TYPE_CHECKING, Any\n380\tfrom engine.card import Creature, LoyaltyAbility, Planeswalker\n381\tfrom engine.types import CardType, Keyword, ManaCost, ManaType, Supertype, Zone\n382\tfrom engine.events import EndStepTriggeredEvent\n383\tif TYPE_CHECKING:\n384\t    from engine.game_state import GameState\n385\t    from engine.player import Player\n386\t    from cards.registry import CardRegistry\n387\t\n388\tclass ChandraFlameshaper(Planeswalker):\n389\t    \"\"\"Chandra, Flameshaper — {5}{R}{R} — 6 loyalty.\n390\t\n391\t    +2: Add {R}{R}{R}. Exile top three cards. May play one this turn.\n392\t    +1: Create a token copy of target creature you control (has haste,\n393\t        sacrifice at end step).\n394\t    −4: Chandra deals 8 damage divided among any number of target\n395\t        creatures and/or planeswalkers.\n396\t    \"\"\"\n397\t\n398\t    def __init__(self, **kwargs: Any) -> None:\n399\t        kwargs.setdefault('name', 'Chandra, Flameshaper')\n400\t        kwargs.setdefault('mana_cost', ManaCost.parse('{5}{R}{R}'))\n401\t        kwargs.setdefault('starting_loyalty', 6)\n402\t        kwargs.setdefault('supertypes', set())\n403\t        kwargs['supertypes'] = (kwargs.get('supertypes') or set()) | {Supertype.LEGENDARY}\n404\t        kwargs.setdefault('subtypes', set())\n405\t        kwargs['subtypes'] = (kwargs.get('subtypes') or set()) | {'Chandra'}\n406\t        kwargs.setdefault('rules_text', '+2: Add {R}{R}{R}. Exile the top three cards of your library. Choose one. You may play that card this turn.\\n+1: Create a token that\\'s a copy of target creature you control, except it has haste and \"At the beginning of the end step, sacrifice this token.\"\\n−4: Chandra deals 8 damage divided as you choose among any number of target creatures and/or planeswalkers.')\n407\t        super().__init__(**kwargs)\n408\t\n409\t    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n410\t        pw = self\n411\t\n412\t        def _plus2(game: Any) -> None:\n413\t            \"\"\"Add {R}{R}{R}. Exile top 3, may play one this turn.\"\"\"\n414\t            controller = pw.controller\n415\t            if controller is None:\n416\t                return\n417\t            controller.mana_pool.add(ManaType.RED, 3)\n418\t            library = controller.zones[Zone.LIBRARY]\n419\t            exiled_cards: list[Any] = []\n420\t            for _ in range(min(3, len(library))):\n421\t                cards = library.get_all()\n422\t                if cards:\n423\t                    card = cards[-1]\n424\t                    library.remove(card)\n425\t                    exile_zone = controller.zones[Zone.EXILE]\n426\t                    exile_zone.add(card)\n427\t                    exiled_cards.append(card)\n428\t            if exiled_cards:\n429\t                try:\n430\t                    chosen = controller.choose_card(exiled_cards, 'Choose one exiled card to play this turn')\n431\t                except Exception:\n432\t                    chosen = exiled_cards[0]\n433\t                if chosen is not None and chosen in exiled_cards:\n434\t                    chosen._playable_this_turn = True\n435\t                    chosen._playable_by = controller\n436\t\n437\t        def _plus1(game: Any) -> None:\n438\t            \"\"\"Create a token copy of target creature (with haste, sacrifice at end step).\"\"\"\n439\t            from engine.game import create_token\n440\t            from engine.triggers import TriggerRegistration\n441\t            target = getattr(pw, '_resolve_target', None)\n442\t            controller = pw.controller\n443\t            if target is None or controller is None:\n444\t                return\n445\t            token = Creature(name=getattr(target, 'name', 'Token'), base_power=getattr(target, 'base_power', 0), base_toughness=getattr(target, 'base_toughness', 0), subtypes=getattr(target, 'subtypes', set()).copy() if getattr(target, 'subtypes', None) else set(), keywords=getattr(target, 'keywords', Keyword(0)) | Keyword.HASTE)\n446\t            if hasattr(target, 'card_types'):\n447\t                token.card_types = set(target.card_types)\n448\t            create_token(game, controller, token)\n449\t\n450\t            def _eot_condition(game: Any, event: dict) -> bool:\n451\t                return True\n452\t\n453\t            def _eot_effect(game: Any) -> None:\n454\t                \"\"\"Sacrifice the token at end of turn.\"\"\"\n455\t                from engine.game import sacrifice\n456\t                bf = game.get_battlefield(controller)\n457\t                if bf.contains(token):\n458\t                    sacrifice(game, controller, token)\n459\t            game.trigger_manager.register(TriggerRegistration(event_type=EndStepTriggeredEvent, condition=_eot_condition, effect=_eot_effect, source=token, controller=controller))\n460\t\n461\t        def _minus4(game: Any) -> None:\n462\t            \"\"\"Deal 8 damage divided among targets.\"\"\"\n463\t            from engine.game import deal_damage\n464\t            damage_assignments = getattr(pw, '_damage_assignments', None)\n465\t            if damage_assignments:\n466\t                for target, amount in damage_assignments:\n467\t                    deal_damage(game, pw, target, amount)\n468\t                return\n469\t            targets = getattr(pw, '_resolve_targets', None)\n470\t            if targets and len(targets) > 0:\n471\t                damage_per = 8 // len(targets)\n472\t                remainder = 8 % len(targets)\n473\t                for i, t in enumerate(targets):\n474\t                    dmg = damage_per + (1 if i < remainder else 0)\n475\t                    deal_damage(game, pw, t, dmg)\n476\t            else:\n477\t                target = getattr(pw, '_resolve_target', None)\n478\t                if target is not None:\n479\t                    deal_damage(game, pw, target, 8)\n480\t        return [LoyaltyAbility(loyalty_cost=+2, effect=_plus2, description='+2: Add {R}{R}{R}. Exile top 3, choose one to play this turn.'), LoyaltyAbility(loyalty_cost=+1, effect=_plus1, description='+1: Create a hasty token copy of target creature (sacrifice at end step).'), LoyaltyAbility(loyalty_cost=-4, effect=_minus4, description='−4: Deal 8 damage divided among target creatures and/or planeswalkers.')]\n481\t\n482\t===== fdn_244 IMPL =====\n483\t\"\"\"Card implementation for Progenitus.\"\"\"\n484\tfrom __future__ import annotations\n485\tfrom typing import TYPE_CHECKING, Any\n486\tfrom engine.card import Creature\n487\tfrom engine.protection import ProtectionAbility\n488\tfrom engine.events import MoveToGraveyardReplacementEvent\n489\tfrom engine.replacement_effects import ReplacementEffect\n490\tfrom engine.types import ManaCost, Supertype, Zone\n491\tif TYPE_CHECKING:\n492\t    from engine.game_state import GameState\n493\t\n494\tclass Progenitus(Creature):\n495\t    \"\"\"Progenitus — {W}{W}{U}{U}{B}{B}{R}{R}{G}{G} — 10/10 — Legendary Hydra Avatar.\n496\t\n497\t    Protection from everything.\n498\t    If Progenitus would be put into a graveyard from anywhere, reveal\n499\t    Progenitus and shuffle it into its owner's library instead.\n500\t\n501\t    FDN collector number 244.\n502\t    \"\"\"\n503\t\n504\t    def __init__(self, **kwargs: Any) -> None:\n505\t        kwargs.setdefault('name', 'Progenitus')\n506\t        kwargs.setdefault('mana_cost', ManaCost.parse('{W}{W}{U}{U}{B}{B}{R}{R}{G}{G}'))\n507\t        kwargs.setdefault('subtypes', {'Hydra', 'Avatar'})\n508\t        kwargs.setdefault('supertypes', {Supertype.LEGENDARY})\n509\t        kwargs.setdefault('base_power', 10)\n510\t        kwargs.setdefault('base_toughness', 10)\n511\t        kwargs.setdefault('rules_text', \"Protection from everything\\nIf Progenitus would be put into a graveyard from anywhere, reveal Progenitus and shuffle it into its owner's library instead.\")\n512\t        super().__init__(**kwargs)\n513\t        self._init_protection()\n514\t\n515\t    def _init_protection(self) -> None:\n516\t        \"\"\"Set up protection from everything. Called from __init__ and\n517\t        can be re-invoked after characteristic resets.\"\"\"\n518\t        self.protections = [ProtectionAbility(quality='everything', predicate=lambda source: True)]\n519\t\n520\t    def _reset_characteristics(self) -> None:\n521\t        \"\"\"Override to reapply protection from everything after reset.\"\"\"\n522\t        super()._reset_characteristics()\n523\t        self._init_protection()\n524\t\n525\t    def register_replacement_effects(self, game: 'GameState') -> None:\n526\t        \"\"\"Register graveyard-shuffle replacement effect.\n527\t\n528\t        Registers a single :class:`~engine.events.MoveToGraveyardReplacementEvent`\n529\t        handler; the engine's zone-move pipeline dispatches subclass events\n530\t        (creature_dies, sacrifice, etc.) to this parent-type handler automatically.\n531\t        \"\"\"\n532\t        source = self\n533\t\n534\t        def _condition(game: Any, event: dict) -> bool:\n535\t            return event.card is source\n536\t\n537\t        def _replacement(game: Any, event: dict) -> dict:\n538\t            owner = getattr(source, 'owner', None)\n539\t            if owner is not None:\n540\t                library = owner.zones[Zone.LIBRARY]\n541\t                library.add(source)\n542\t                library.shuffle()\n543\t            event.prevented = True\n544\t            return event\n545\t        controller = getattr(self, 'controller', None)\n546\t        game.replacement_manager.register(ReplacementEffect(event_type=MoveToGraveyardReplacementEvent, source=self, condition=_condition, replacement=_replacement, controller=controller))\n547\t\n548\t===== fdn_137 IMPL =====\n549\t\"\"\"Card implementation for Authority of the Consuls.\"\"\"\n550\tfrom __future__ import annotations\n551\tfrom dataclasses import dataclass\n552\tfrom typing import TYPE_CHECKING, Any\n553\tfrom engine.card import ActivatedAbility, Creature, Enchantment\n554\tfrom engine.continuous_effects import ContinuousEffect, DURATION_PERMANENT, Layer, SubLayer\n555\tfrom engine.types import CardType, Keyword, ManaCost, TargetRequirement, Zone\n556\tfrom engine.events import EntersBattlefieldTriggeredEvent, GainsLifeTriggeredEvent\n557\tif TYPE_CHECKING:\n558\t    from engine.game_state import GameState\n559\t    from cards.registry import CardRegistry\n560\t\n561\tdef _is_on_battlefield(game: Any, obj: Any) -> bool:\n562\t    \"\"\"Check if *obj* is on any player's battlefield.\"\"\"\n563\t    for player in game.players:\n564\t        if game.get_battlefield(player).contains(obj):\n565\t            return True\n566\t    return False\n567\t\n568\tclass AuthorityOfTheConsuls(Enchantment):\n569\t    \"\"\"Authority of the Consuls — {W} — Creatures opponents control enter tapped.\n570\t\n571\t    Whenever a creature an opponent controls enters, you gain 1 life.\n572\t\n573\t    FDN collector number 137.\n574\t    \"\"\"\n575\t\n576\t    def __init__(self, **kwargs: Any) -> None:\n577\t        kwargs.setdefault('name', 'Authority of the Consuls')\n578\t        kwargs.setdefault('mana_cost', ManaCost.parse('{W}'))\n579\t        kwargs.setdefault('rules_text', 'Creatures your opponents control enter tapped.\\nWhenever a creature an opponent controls enters, you gain 1 life.')\n580\t        super().__init__(**kwargs)\n581\t        self._effect_ref: ContinuousEffect | None = None\n582\t\n583\t    def on_resolve(self, game: GameState) -> None:\n584\t        self._register_effect(game)\n585\t\n586\t    def _register_effect(self, game: GameState) -> None:\n587\t        enchantment_ref = self\n588\t\n589\t        def _apply(game: GameState) -> None:\n590\t            controller = enchantment_ref.controller\n591\t            if controller is None:\n592\t                return\n593\t            if not _is_on_battlefield(game, enchantment_ref):\n594\t                return\n595\t            for player in game.players:\n596\t                if player is controller:\n597\t                    continue\n598\t                for obj in game.get_battlefield(player).get_all():\n599\t                    if CardType.CREATURE in getattr(obj, 'card_types', set()):\n600\t                        if getattr(obj, 'summoning_sick', False):\n601\t                            obj.is_tapped = True\n602\t        effect = ContinuousEffect(source=enchantment_ref, layer=Layer.ABILITY, sublayer=None, apply=_apply, duration=DURATION_PERMANENT)\n603\t        self._effect_ref = game.effect_manager.add(effect)\n604\t\n605\t    def register_triggers(self, game: GameState) -> None:\n606\t        from engine.triggers import TriggerRegistration\n607\t        source = self\n608\t\n609\t        def _condition(game: Any, event: dict) -> bool:\n610\t            permanent = event.permanent\n611\t            if permanent is None:\n612\t                return False\n613\t            controller = source.controller\n614\t            if controller is None:\n615\t                return False\n616\t            perm_controller = getattr(permanent, 'controller', None)\n617\t            if perm_controller is controller:\n618\t                return False\n619\t            return CardType.CREATURE in getattr(permanent, 'card_types', set())\n620\t\n621\t        def _effect(game: GameState) -> None:\n622\t            controller = source.controller\n623\t            if controller is None:\n624\t                return\n625\t            if hasattr(controller, 'life'):\n626\t                controller.life += 1\n627\t                game.trigger_manager.fire_event(game, GainsLifeTriggeredEvent(player=controller, amount=1))\n628\t        controller = getattr(self, 'controller', None) or game.active_player\n629\t        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=controller))\n630\t\n631\t    def register_replacement_effects(self, game: GameState) -> None:\n632\t        if self._effect_ref is None:\n633\t            self._register_effect(game)\n634\t\n635\t===== fdn_44 IMPL =====\n636\t\"\"\"Card implementation for Kaito, Cunning Infiltrator.\"\"\"\n637\tfrom __future__ import annotations\n638\tfrom typing import TYPE_CHECKING, Any\n639\tfrom engine.card import Creature, LoyaltyAbility, Planeswalker\n640\tfrom engine.types import CardType, Keyword, ManaCost, ManaType, Supertype, Zone\n641\tfrom engine.events import DealsDamageTriggeredEvent, SpellCastTriggeredEvent\n642\tif TYPE_CHECKING:\n643\t    from engine.game_state import GameState\n644\t    from engine.player import Player\n645\t    from cards.registry import CardRegistry\n646\t\n647\tclass KaitoCunningInfiltrator(Planeswalker):\n648\t    \"\"\"Kaito, Cunning Infiltrator — {1}{U}{U} — 3 loyalty.\n649\t\n650\t    Whenever a creature you control deals combat damage to a player, put a\n651\t    loyalty counter on Kaito.\n652\t    +1: Up to one target creature you control can't be blocked this turn.\n653\t        Draw a card, then discard a card.\n654\t    −2: Create a 2/1 blue Ninja creature token.\n655\t    −9: You get an emblem with \"Whenever a player casts a spell, you create\n656\t        a 2/1 blue Ninja creature token.\"\n657\t    \"\"\"\n658\t\n659\t    def __init__(self, **kwargs: Any) -> None:\n660\t        kwargs.setdefault('name', 'Kaito, Cunning Infiltrator')\n661\t        kwargs.setdefault('mana_cost', ManaCost.parse('{1}{U}{U}'))\n662\t        kwargs.setdefault('starting_loyalty', 3)\n663\t        kwargs.setdefault('supertypes', set())\n664\t        kwargs['supertypes'] = (kwargs.get('supertypes') or set()) | {Supertype.LEGENDARY}\n665\t        kwargs.setdefault('subtypes', set())\n666\t        kwargs['subtypes'] = (kwargs.get('subtypes') or set()) | {'Kaito'}\n667\t        kwargs.setdefault('rules_text', 'Whenever a creature you control deals combat damage to a player, put a loyalty counter on Kaito.\\n+1: Up to one target creature you control can\\'t be blocked this turn. Draw a card, then discard a card.\\n−2: Create a 2/1 blue Ninja creature token.\\n−9: You get an emblem with \"Whenever a player casts a spell, you create a 2/1 blue Ninja creature token.\"')\n668\t        super().__init__(**kwargs)\n669\t\n670\t    def register_triggers(self, game: Any) -> None:\n671\t        \"\"\"Register passive: combat damage to a player → loyalty counter.\"\"\"\n672\t        from engine.game import add_counter\n673\t        from engine.triggers import TriggerRegistration\n674\t        pw = self\n675\t        controller = getattr(self, 'controller', None) or game.active_player\n676\t\n677\t        def _combat_damage_condition(game: Any, event: dict) -> bool:\n678\t            \"\"\"Fire when a creature controlled by Kaito's controller deals damage to a player.\"\"\"\n679\t            source = event.source\n680\t            target = event.target\n681\t            if not event.combat:\n682\t                return False\n683\t            if source is None or target is None:\n684\t                return False\n685\t            source_types = getattr(source, 'card_types', set())\n686\t            if CardType.CREATURE not in source_types:\n687\t                return False\n688\t            if getattr(source, 'controller', None) is not pw.controller:\n689\t                return False\n690\t            if not hasattr(target, 'life'):\n691\t                return False\n692\t            return True\n693\t\n694\t        def _combat_damage_effect(game: Any) -> None:\n695\t            \"\"\"Put a loyalty counter on Kaito.\"\"\"\n696\t            add_counter(game, pw, 'loyalty', 1)\n697\t        game.trigger_manager.register(TriggerRegistration(event_type=DealsDamageTriggeredEvent, condition=_combat_damage_condition, effect=_combat_damage_effect, source=self, controller=controller))\n698\t\n699\t    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n700\t        pw = self\n701\t\n702\t        def _plus1(game: Any) -> None:\n703\t            \"\"\"Up to one target creature can't be blocked. Draw then discard.\"\"\"\n704\t            from engine.game import discard, draw_card\n705\t            target = getattr(pw, '_resolve_target', None)\n706\t            if target is not None:\n707\t                target._cant_be_blocked = True\n708\t            controller = pw.controller\n709\t            if controller is not None:\n710\t                drawn = draw_card(game, controller)\n711\t                hand = controller.zones[Zone.HAND]\n712\t                cards_in_hand = hand.get_all()\n713\t                if cards_in_hand:\n714\t                    card_to_discard = cards_in_hand[-1]\n715\t                    discard(game, controller, card_to_discard)\n716\t\n717\t        def _minus2(game: Any) -> None:\n718\t            \"\"\"Create a 2/1 blue Ninja creature token.\"\"\"\n719\t            from engine.game import create_token\n720\t            controller = pw.controller\n721\t            if controller is not None:\n722\t                token = Creature(name='Ninja', base_power=2, base_toughness=1, subtypes={'Ninja'})\n723\t                create_token(game, controller, token)\n724\t\n725\t        def _minus9(game: Any) -> None:\n726\t            \"\"\"Emblem — whenever a player casts a spell, create a 2/1 Ninja token.\"\"\"\n727\t            from engine.triggers import TriggerRegistration\n728\t            from engine.game import create_token\n729\t            controller = pw.controller\n730\t            if controller is None:\n731\t                return\n732\t            emblem = type('Emblem', (), {'name': 'Kaito Emblem'})()\n733\t\n734\t            def _spell_cast_condition(game: Any, event: dict) -> bool:\n735\t                \"\"\"Always fires when any player casts a spell.\"\"\"\n736\t                return True\n737\t\n738\t            def _spell_cast_effect(game: Any) -> None:\n739\t                \"\"\"Create a 2/1 blue Ninja creature token.\"\"\"\n740\t                token = Creature(name='Ninja', base_power=2, base_toughness=1, subtypes={'Ninja'})\n741\t                create_token(game, controller, token)\n742\t            game.trigger_manager.register(TriggerRegistration(event_type=SpellCastTriggeredEvent, condition=_spell_cast_condition, effect=_spell_cast_effect, source=emblem, controller=controller))\n743\t        return [LoyaltyAbility(loyalty_cost=+1, effect=_plus1, description=\"+1: Up to one target creature can't be blocked. Draw, then discard.\"), LoyaltyAbility(loyalty_cost=-2, effect=_minus2, description='−2: Create a 2/1 blue Ninja creature token.'), LoyaltyAbility(loyalty_cost=-9, effect=_minus9, description='−9: Emblem — whenever a player casts a spell, create 2/1 Ninja token.')]\n744\t\n745\t===== fdn_48 IMPL =====\n746\t\"\"\"Card implementation for Refute.\"\"\"\n747\t\n748\tfrom __future__ import annotations\n749\t\n750\tfrom typing import TYPE_CHECKING, Any\n751\t\n752\tfrom engine.card import Instant\n753\tfrom engine.types import ManaCost, TargetRequirement, Zone\n754\t\n755\tif TYPE_CHECKING:\n756\t    from engine.game_state import GameState\n757\t\n758\t\n759\tdef _get_chosen_target(card: Any, game: Any) -> Any:\n760\t    \"\"\"Retrieve the first chosen target for a spell.\"\"\"\n761\t    chosen = getattr(card, \"chosen_targets\", None)\n762\t    if chosen:\n763\t        return chosen[0]\n764\t    return getattr(card, \"_resolve_target\", None)\n765\t\n766\t\n767\tdef _counter_spell(game: \"GameState\", stack_obj: Any) -> None:\n768\t    \"\"\"Counter a spell — remove from stack and move card to graveyard.\"\"\"\n769\t    from engine.stack import StackObject\n770\t\n771\t    if not isinstance(stack_obj, StackObject):\n772\t        return\n773\t\n774\t    card = stack_obj.source\n775\t    stack_items = game.stack._items  # noqa: SLF001\n776\t    found = False\n777\t    for i, item in enumerate(stack_items):\n778\t        if item is stack_obj:\n779\t            stack_items.pop(i)\n780\t            found = True\n781\t            break\n782\t\n783\t    if not found:\n784\t        return\n785\t\n786\t    controller = stack_obj.controller\n787\t    owner = getattr(card, \"owner\", controller)\n788\t\n789\t    if controller is not None:\n790\t        stack_zone = controller.zones[Zone.STACK]\n791\t        if stack_zone.contains(card):\n792\t            stack_zone.remove(card)\n793\t\n794\t    if owner is not None:\n795\t        graveyard = owner.zones[Zone.GRAVEYARD]\n796\t        graveyard.add(card)\n797\t\n798\t\n799\tclass Refute(Instant):\n800\t    \"\"\"Refute — {1}{U}{U} — Instant.\n801\t\n802\t    Counter target spell. Draw a card, then discard a card.\n803\t\n804\t    FDN collector number 48.\n805\t    \"\"\"\n806\t\n807\t    def __init__(self, **kwargs: Any) -> None:\n808\t        kwargs.setdefault(\"name\", \"Refute\")\n809\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{U}{U}\"))\n810\t        kwargs.setdefault(\n811\t            \"rules_text\",\n812\t            \"Counter target spell. Draw a card, then discard a card.\",\n813\t        )\n814\t        super().__init__(**kwargs)\n815\t\n816\t    def can_cast(self, game: \"GameState\") -> bool:\n817\t        \"\"\"Cannot cast unless there's a spell on the stack to counter.\"\"\"\n818\t        from engine.stack import StackObject\n819\t\n820\t        for stack_obj in game.stack.objects():\n821\t            source = stack_obj.source\n822\t            if source is self:\n823\t                continue\n824\t            # Only target spells (not triggered/activated abilities)\n825\t            if getattr(stack_obj, \"is_spell\", True):\n826\t                return True\n827\t        return False\n828\t\n829\t    def get_targets(self, game: \"GameState\") -> list:\n830\t        \"\"\"Target spell on the stack.\"\"\"\n831\t        from engine.stack import StackObject\n832\t\n833\t        targets = []\n834\t        for stack_obj in game.stack.objects():\n835\t            source = stack_obj.source\n836\t            if source is self:\n837\t                continue\n838\t            if getattr(stack_obj, \"is_spell\", True):\n839\t                targets.append(stack_obj)\n840\t        if not targets:\n841\t            return []\n842\t        return [\n843\t            TargetRequirement(\n844\t                filter_fn=lambda obj: obj is not self and getattr(obj, \"is_spell\", True),\n845\t                description=\"target spell\",\n846\t                zone=Zone.STACK,\n847\t            )\n848\t        ]\n849\t\n850\t    def on_resolve(self, game: \"GameState\") -> None:\n851\t        \"\"\"Counter target spell, then draw a card, then discard a card.\"\"\"\n852\t        from engine.game import discard, draw_card\n853\t\n854\t        target = _get_chosen_target(self, game)\n855\t        # Single-target spell fizzles if target is illegal\n856\t        if target is None:\n857\t            return\n858\t        if target is not None:\n859\t            _counter_spell(game, target)\n860\t\n861\t        controller = self.controller\n862\t        if controller is None:\n863\t            return\n864\t\n865\t        # Draw a card\n866\t        draw_card(game, controller)\n867\t\n868\t        # Discard a card\n869\t        hand = controller.zones[Zone.HAND]\n870\t        cards_in_hand = list(hand.get_all())\n871\t        if cards_in_hand:\n872\t            try:\n873\t                chosen = controller.choose_card(\n874\t                    cards_in_hand, \"Choose a card to discard\"\n875\t                )\n876\t            except Exception:\n877\t                chosen = cards_in_hand[0] if cards_in_hand else None\n878\t            if chosen is not None:\n879\t                discard(game, controller, chosen)\n880\t\n881\t"}]},"parent_tool_use_id":null,"session_id":"1a75e57b-d845-4814-b1a9-adfaef121449","uuid":"4f8e8feb-a595-43d0-a9b3-3e4efdeb0296","timestamp":"2026-06-09T21:50:44.873Z","tool_use_result":{"type":"text","file":{"filePath":"/home/node/.claude/projects/-workspace/1a75e57b-d845-4814-b1a9-adfaef121449/tool-results/bh6n1zdwy.txt","content":"===== fdn_57 IMPL =====\n\"\"\"Card implementation for Blasphemous Edict.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import Sorcery\nfrom engine.types import CardType, ManaCost, Zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\nclass BlasphemousEdict(Sorcery):\n    \"\"\"Blasphemous Edict — {3}{B}{B} — Sorcery.\n\n    You may pay {B} rather than pay this spell's mana cost if there are\n    thirteen or more creatures on the battlefield.\n    Each player sacrifices thirteen creatures of their choice.\n\n    FDN collector number 57.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"Blasphemous Edict\")\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{3}{B}{B}\"))\n        kwargs.setdefault(\n            \"rules_text\",\n            \"You may pay {B} rather than pay this spell's mana cost if \"\n            \"there are thirteen or more creatures on the battlefield.\\n\"\n            \"Each player sacrifices thirteen creatures of their choice.\",\n        )\n        super().__init__(**kwargs)\n\n    def cost_reduction(self, game: \"GameState\") -> int:\n        \"\"\"Allow alternative cost of {B} if 13+ creatures on battlefield.\n\n        The alternative cost should make total cost {B}. The original cost is\n        {3}{B}{B} (generic=3, pips={B:2}). cost_reduction only reduces\n        the generic portion. We return 4 (intent: reduce fully to {B}),\n        but the engine's get_cost_reduction() clamps to min(4, generic=3)=3,\n        yielding {B}{B}. Full alternative-cost support (removing colored\n        pips) would require engine changes beyond current scope.\n        \"\"\"\n        total_creatures = 0\n        for player in game.players:\n            bf = game.get_battlefield(player)\n            for obj in bf.get_all():\n                if CardType.CREATURE in getattr(obj, \"card_types\", set()):\n                    total_creatures += 1\n        if total_creatures >= 13:\n            return 4  # Intent: reduce to {B}; engine limitation applies\n        return 0\n\n    def on_resolve(self, game: \"GameState\") -> None:\n        \"\"\"Each player sacrifices thirteen creatures of their choice.\"\"\"\n        from engine.game import sacrifice\n\n        for player in game.players:\n            bf = game.get_battlefield(player)\n            for _ in range(13):\n                creatures = [\n                    c for c in bf.get_all()\n                    if CardType.CREATURE in getattr(c, \"card_types\", set())\n                ]\n                if not creatures:\n                    break\n                try:\n                    chosen = player.choose_card(creatures, \"sacrifice a creature\")\n                except Exception:\n                    chosen = creatures[-1] if creatures else None\n                if chosen is not None:\n                    sacrifice(game, player, chosen)\n\n===== fdn_194 IMPL =====\n\"\"\"Card implementation for Etali, Primal Storm.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import Creature\nfrom engine.types import CardType, ManaCost, Zone\nfrom engine.events import AttacksTriggeredEvent\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\nclass EtaliPrimalStorm(Creature):\n    \"\"\"Etali, Primal Storm — {4}{R}{R} — 6/6 — Legendary Elder Dinosaur.\n\n    Whenever Etali attacks, exile the top card of each player's library,\n    then you may cast any number of spells from among those cards without\n    paying their mana costs.\n\n    FDN collector number 194.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Etali, Primal Storm')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{4}{R}{R}'))\n        kwargs.setdefault('subtypes', {'Elder', 'Dinosaur'})\n        kwargs.setdefault('supertypes', {'Legendary'})\n        kwargs.setdefault('base_power', 6)\n        kwargs.setdefault('base_toughness', 6)\n        kwargs.setdefault('rules_text', \"Whenever Etali attacks, exile the top card of each player's library, then you may cast any number of spells from among those cards without paying their mana costs.\")\n        super().__init__(**kwargs)\n\n    def register_triggers(self, game: 'GameState') -> None:\n        \"\"\"Register attack trigger for exile-and-cast.\"\"\"\n        from engine.triggers import TriggerRegistration\n        from engine.zones import move_to_zone\n        from engine.casting import cast_spell_free\n        source = self\n        controller = getattr(self, 'controller', None) or game.active_player\n\n        def _condition(game: Any, event: dict) -> bool:\n            return event.creature is source\n\n        def _effect(game: 'GameState') -> None:\n            ctrl = getattr(source, 'controller', None)\n            if ctrl is None:\n                return\n            exiled_cards: list = []\n            for player in game.players:\n                library = player.zones[Zone.LIBRARY]\n                cards = library.get_all()\n                if cards:\n                    top_card = cards[-1]\n                    move_to_zone(game, top_card, Zone.LIBRARY, Zone.EXILE)\n                    exiled_cards.append(top_card)\n            # Filter out lands — Etali can only cast nonland cards\n            castable = [c for c in exiled_cards if CardType.LAND not in getattr(c, 'card_types', set())]\n            for card in castable:\n                try:\n                    if ctrl.choose_yes_no(f\"Cast {getattr(card, 'name', 'card')} without paying its mana cost?\"):\n                        # Use the proper cast pipeline — spell goes on the\n                        # stack and can be responded to (e.g. countered).\n                        cast_spell_free(game, ctrl, card, Zone.EXILE)\n                except Exception:\n                    pass\n        game.trigger_manager.register(TriggerRegistration(event_type=AttacksTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=controller))\n\n===== fdn_161 IMPL =====\n\"\"\"Card implementation for Omniscience.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import Enchantment\nfrom engine.continuous_effects import (\n    ContinuousEffect,\n    DURATION_PERMANENT,\n    Layer,\n)\nfrom engine.types import ManaCost\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\ndef _is_on_battlefield(game: Any, obj: Any) -> bool:\n    \"\"\"Return True if *obj* is on any player's battlefield.\"\"\"\n    for player in game.players:\n        if game.get_battlefield(player).contains(obj):\n            return True\n    return False\n\n\nclass Omniscience(Enchantment):\n    \"\"\"Omniscience — {7}{U}{U}{U} — Enchantment.\n\n    You may cast spells from your hand without paying their mana costs.\n\n    FDN collector number 161.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"Omniscience\")\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{7}{U}{U}{U}\"))\n        kwargs.setdefault(\n            \"rules_text\",\n            \"You may cast spells from your hand without paying their mana costs.\",\n        )\n        super().__init__(**kwargs)\n\n    def apply_continuous_effect(self, game: \"GameState\") -> None:\n        \"\"\"Register continuous effect for free casting.\"\"\"\n        source = self\n\n        def _apply(game: Any) -> None:\n            # ENGINE LIMITATION: The engine doesn't have a \"cast without\n            # paying mana cost\" hook. This is a marker effect that the\n            # casting system would need to consult.\n            if not _is_on_battlefield(game, source):\n                return\n            ctrl = getattr(source, \"controller\", None)\n            if ctrl is not None:\n                ctrl._omniscience_active = True\n\n        game.effect_manager.add(ContinuousEffect(\n            source=self,\n            layer=Layer.ABILITY,\n            sublayer=None,\n            apply=_apply,\n            duration=DURATION_PERMANENT,\n        ))\n\n===== fdn_248 IMPL =====\n\"\"\"Card implementation for Thousand-Year Storm.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import Enchantment\nfrom engine.types import CardType, ManaCost\nfrom engine.events import SpellCastTriggeredEvent\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\nclass ThousandYearStorm(Enchantment):\n    \"\"\"Thousand-Year Storm — {4}{U}{R} — Enchantment.\n\n    Whenever you cast an instant or sorcery spell, copy it for each\n    other instant and sorcery spell you've cast before it this turn.\n    You may choose new targets for the copies.\n\n    FDN collector number 248.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Thousand-Year Storm')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{4}{U}{R}'))\n        kwargs.setdefault(\n            'rules_text',\n            \"Whenever you cast an instant or sorcery spell, copy it for each \"\n            \"other instant and sorcery spell you've cast before it this turn. \"\n            \"You may choose new targets for the copies.\",\n        )\n        super().__init__(**kwargs)\n\n    def register_triggers(self, game: 'GameState') -> None:\n        from engine.stack import copy_spell\n        from engine.triggers import TriggerRegistration\n\n        source = self\n        controller = getattr(self, 'controller', None) or game.active_player\n        source._storm_count: int = 0\n        source._last_turn: int = getattr(game, 'turn_number', 0)\n\n        def _condition(game: Any, event: Any) -> bool:\n            ctrl = getattr(source, 'controller', None)\n            caster = getattr(event, 'player', None) or getattr(event, 'controller', None)\n            if caster is not ctrl:\n                return False\n            spell = getattr(event, 'spell', None) or getattr(event, 'card', None)\n            if spell is None:\n                return False\n            card_types = getattr(spell, 'card_types', set())\n            if not card_types & {CardType.INSTANT, CardType.SORCERY}:\n                return False\n            current_turn = getattr(game, 'turn_number', 0)\n            if current_turn != source._last_turn:\n                source._storm_count = 0\n                source._last_turn = current_turn\n            source._pending_spell = spell\n            return True\n\n        def _effect(game: 'GameState') -> None:\n            copies_to_make = source._storm_count\n            source._storm_count += 1\n            if copies_to_make <= 0:\n                return\n            ctrl = getattr(source, 'controller', None)\n            if ctrl is None:\n                return\n            pending_spell = getattr(source, '_pending_spell', None)\n            if pending_spell is None:\n                return\n            original_so = None\n            for so in game.stack._items:\n                if so.source is pending_spell:\n                    original_so = so\n                    break\n            if original_so is None:\n                return\n            for _ in range(copies_to_make):\n                new_targets: list[Any] | None = None\n                if original_so.targets:\n                    if ctrl.choose_yes_no(\n                        f\"Choose new targets for copy of {original_so.source.name}?\"\n                    ):\n                        requirements = getattr(\n                            original_so.source, 'get_targets', lambda _: []\n                        )(game)\n                        new_targets = []\n                        for req in requirements:\n                            legal: list[Any] = []\n                            for p in game.players:\n                                for obj in game.get_battlefield(p).get_all():\n                                    if req.filter_fn(obj):\n                                        legal.append(obj)\n                                if req.filter_fn(p):\n                                    legal.append(p)\n                            if legal:\n                                chosen = ctrl.choose_target(legal, req)\n                                new_targets.append(chosen)\n                copy_obj = copy_spell(game, original_so, ctrl, new_targets)\n                game.stack.push(copy_obj)\n\n        game.trigger_manager.register(TriggerRegistration(\n            event_type=SpellCastTriggeredEvent,\n            condition=_condition,\n            effect=_effect,\n            source=self,\n            controller=controller,\n        ))\n\n===== fdn_235 IMPL =====\n\"\"\"Card implementation for Wary Thespian.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import ArtifactCreature, Creature\nfrom engine.types import CardType, Keyword, ManaCost, Supertype, Zone\nfrom engine.events import CreatureDiesTriggeredEvent, EntersBattlefieldTriggeredEvent\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from cards.registry import CardRegistry\n\ndef _self_dies_condition(source: Any):\n    \"\"\"Return a condition callable that matches only when *source* dies.\"\"\"\n\n    def _condition(game: Any, event: dict) -> bool:\n        return event.creature is source\n    return _condition\n\ndef _self_etb_condition(source: Any):\n    \"\"\"Return a condition callable that matches only when *source* enters.\"\"\"\n\n    def _condition(game: Any, event: dict) -> bool:\n        return event.permanent is source\n    return _condition\n\nclass WaryThespian(Creature):\n    \"\"\"Wary Thespian — {1}{G} — 3/1 — Cat Druid\n\n    When this creature enters or dies, surveil 1.\n\n    FDN collector number 235.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Wary Thespian')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{1}{G}'))\n        kwargs.setdefault('subtypes', {'Cat', 'Druid'})\n        kwargs.setdefault('base_power', 3)\n        kwargs.setdefault('base_toughness', 1)\n        kwargs.setdefault('rules_text', 'When this creature enters or dies, surveil 1.')\n        super().__init__(**kwargs)\n\n    def register_triggers(self, game: GameState) -> None:\n        from engine.triggers import TriggerRegistration\n        source = self\n\n        def _surveil_effect(game: GameState) -> None:\n            controller = getattr(source, 'controller', None) or getattr(source, 'owner', None)\n            if controller is None:\n                return\n            library = controller.zones[Zone.LIBRARY]\n            if len(library) > 0:\n                card = library.top(1)[0]\n                library.remove(card)\n                graveyard = controller.zones[Zone.GRAVEYARD]\n                graveyard.add(card)\n        controller = getattr(self, 'controller', None) or game.active_player\n        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=_self_etb_condition(self), effect=_surveil_effect, source=self, controller=controller))\n        game.trigger_manager.register(TriggerRegistration(event_type=CreatureDiesTriggeredEvent, condition=_self_dies_condition(self), effect=_surveil_effect, source=self, controller=controller))\n\n===== fdn_81 IMPL =====\n\"\"\"Card implementation for Chandra, Flameshaper.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import Creature, LoyaltyAbility, Planeswalker\nfrom engine.types import CardType, Keyword, ManaCost, ManaType, Supertype, Zone\nfrom engine.events import EndStepTriggeredEvent\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n    from cards.registry import CardRegistry\n\nclass ChandraFlameshaper(Planeswalker):\n    \"\"\"Chandra, Flameshaper — {5}{R}{R} — 6 loyalty.\n\n    +2: Add {R}{R}{R}. Exile top three cards. May play one this turn.\n    +1: Create a token copy of target creature you control (has haste,\n        sacrifice at end step).\n    −4: Chandra deals 8 damage divided among any number of target\n        creatures and/or planeswalkers.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Chandra, Flameshaper')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{5}{R}{R}'))\n        kwargs.setdefault('starting_loyalty', 6)\n        kwargs.setdefault('supertypes', set())\n        kwargs['supertypes'] = (kwargs.get('supertypes') or set()) | {Supertype.LEGENDARY}\n        kwargs.setdefault('subtypes', set())\n        kwargs['subtypes'] = (kwargs.get('subtypes') or set()) | {'Chandra'}\n        kwargs.setdefault('rules_text', '+2: Add {R}{R}{R}. Exile the top three cards of your library. Choose one. You may play that card this turn.\\n+1: Create a token that\\'s a copy of target creature you control, except it has haste and \"At the beginning of the end step, sacrifice this token.\"\\n−4: Chandra deals 8 damage divided as you choose among any number of target creatures and/or planeswalkers.')\n        super().__init__(**kwargs)\n\n    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n        pw = self\n\n        def _plus2(game: Any) -> None:\n            \"\"\"Add {R}{R}{R}. Exile top 3, may play one this turn.\"\"\"\n            controller = pw.controller\n            if controller is None:\n                return\n            controller.mana_pool.add(ManaType.RED, 3)\n            library = controller.zones[Zone.LIBRARY]\n            exiled_cards: list[Any] = []\n            for _ in range(min(3, len(library))):\n                cards = library.get_all()\n                if cards:\n                    card = cards[-1]\n                    library.remove(card)\n                    exile_zone = controller.zones[Zone.EXILE]\n                    exile_zone.add(card)\n                    exiled_cards.append(card)\n            if exiled_cards:\n                try:\n                    chosen = controller.choose_card(exiled_cards, 'Choose one exiled card to play this turn')\n                except Exception:\n                    chosen = exiled_cards[0]\n                if chosen is not None and chosen in exiled_cards:\n                    chosen._playable_this_turn = True\n                    chosen._playable_by = controller\n\n        def _plus1(game: Any) -> None:\n            \"\"\"Create a token copy of target creature (with haste, sacrifice at end step).\"\"\"\n            from engine.game import create_token\n            from engine.triggers import TriggerRegistration\n            target = getattr(pw, '_resolve_target', None)\n            controller = pw.controller\n            if target is None or controller is None:\n                return\n            token = Creature(name=getattr(target, 'name', 'Token'), base_power=getattr(target, 'base_power', 0), base_toughness=getattr(target, 'base_toughness', 0), subtypes=getattr(target, 'subtypes', set()).copy() if getattr(target, 'subtypes', None) else set(), keywords=getattr(target, 'keywords', Keyword(0)) | Keyword.HASTE)\n            if hasattr(target, 'card_types'):\n                token.card_types = set(target.card_types)\n            create_token(game, controller, token)\n\n            def _eot_condition(game: Any, event: dict) -> bool:\n                return True\n\n            def _eot_effect(game: Any) -> None:\n                \"\"\"Sacrifice the token at end of turn.\"\"\"\n                from engine.game import sacrifice\n                bf = game.get_battlefield(controller)\n                if bf.contains(token):\n                    sacrifice(game, controller, token)\n            game.trigger_manager.register(TriggerRegistration(event_type=EndStepTriggeredEvent, condition=_eot_condition, effect=_eot_effect, source=token, controller=controller))\n\n        def _minus4(game: Any) -> None:\n            \"\"\"Deal 8 damage divided among targets.\"\"\"\n            from engine.game import deal_damage\n            damage_assignments = getattr(pw, '_damage_assignments', None)\n            if damage_assignments:\n                for target, amount in damage_assignments:\n                    deal_damage(game, pw, target, amount)\n                return\n            targets = getattr(pw, '_resolve_targets', None)\n            if targets and len(targets) > 0:\n                damage_per = 8 // len(targets)\n                remainder = 8 % len(targets)\n                for i, t in enumerate(targets):\n                    dmg = damage_per + (1 if i < remainder else 0)\n                    deal_damage(game, pw, t, dmg)\n            else:\n                target = getattr(pw, '_resolve_target', None)\n                if target is not None:\n                    deal_damage(game, pw, target, 8)\n        return [LoyaltyAbility(loyalty_cost=+2, effect=_plus2, description='+2: Add {R}{R}{R}. Exile top 3, choose one to play this turn.'), LoyaltyAbility(loyalty_cost=+1, effect=_plus1, description='+1: Create a hasty token copy of target creature (sacrifice at end step).'), LoyaltyAbility(loyalty_cost=-4, effect=_minus4, description='−4: Deal 8 damage divided among target creatures and/or planeswalkers.')]\n\n===== fdn_244 IMPL =====\n\"\"\"Card implementation for Progenitus.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import Creature\nfrom engine.protection import ProtectionAbility\nfrom engine.events import MoveToGraveyardReplacementEvent\nfrom engine.replacement_effects import ReplacementEffect\nfrom engine.types import ManaCost, Supertype, Zone\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\nclass Progenitus(Creature):\n    \"\"\"Progenitus — {W}{W}{U}{U}{B}{B}{R}{R}{G}{G} — 10/10 — Legendary Hydra Avatar.\n\n    Protection from everything.\n    If Progenitus would be put into a graveyard from anywhere, reveal\n    Progenitus and shuffle it into its owner's library instead.\n\n    FDN collector number 244.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Progenitus')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{W}{W}{U}{U}{B}{B}{R}{R}{G}{G}'))\n        kwargs.setdefault('subtypes', {'Hydra', 'Avatar'})\n        kwargs.setdefault('supertypes', {Supertype.LEGENDARY})\n        kwargs.setdefault('base_power', 10)\n        kwargs.setdefault('base_toughness', 10)\n        kwargs.setdefault('rules_text', \"Protection from everything\\nIf Progenitus would be put into a graveyard from anywhere, reveal Progenitus and shuffle it into its owner's library instead.\")\n        super().__init__(**kwargs)\n        self._init_protection()\n\n    def _init_protection(self) -> None:\n        \"\"\"Set up protection from everything. Called from __init__ and\n        can be re-invoked after characteristic resets.\"\"\"\n        self.protections = [ProtectionAbility(quality='everything', predicate=lambda source: True)]\n\n    def _reset_characteristics(self) -> None:\n        \"\"\"Override to reapply protection from everything after reset.\"\"\"\n        super()._reset_characteristics()\n        self._init_protection()\n\n    def register_replacement_effects(self, game: 'GameState') -> None:\n        \"\"\"Register graveyard-shuffle replacement effect.\n\n        Registers a single :class:`~engine.events.MoveToGraveyardReplacementEvent`\n        handler; the engine's zone-move pipeline dispatches subclass events\n        (creature_dies, sacrifice, etc.) to this parent-type handler automatically.\n        \"\"\"\n        source = self\n\n        def _condition(game: Any, event: dict) -> bool:\n            return event.card is source\n\n        def _replacement(game: Any, event: dict) -> dict:\n            owner = getattr(source, 'owner', None)\n            if owner is not None:\n                library = owner.zones[Zone.LIBRARY]\n                library.add(source)\n                library.shuffle()\n            event.prevented = True\n            return event\n        controller = getattr(self, 'controller', None)\n        game.replacement_manager.register(ReplacementEffect(event_type=MoveToGraveyardReplacementEvent, source=self, condition=_condition, replacement=_replacement, controller=controller))\n\n===== fdn_137 IMPL =====\n\"\"\"Card implementation for Authority of the Consuls.\"\"\"\nfrom __future__ import annotations\nfrom dataclasses import dataclass\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import ActivatedAbility, Creature, Enchantment\nfrom engine.continuous_effects import ContinuousEffect, DURATION_PERMANENT, Layer, SubLayer\nfrom engine.types import CardType, Keyword, ManaCost, TargetRequirement, Zone\nfrom engine.events import EntersBattlefieldTriggeredEvent, GainsLifeTriggeredEvent\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from cards.registry import CardRegistry\n\ndef _is_on_battlefield(game: Any, obj: Any) -> bool:\n    \"\"\"Check if *obj* is on any player's battlefield.\"\"\"\n    for player in game.players:\n        if game.get_battlefield(player).contains(obj):\n            return True\n    return False\n\nclass AuthorityOfTheConsuls(Enchantment):\n    \"\"\"Authority of the Consuls — {W} — Creatures opponents control enter tapped.\n\n    Whenever a creature an opponent controls enters, you gain 1 life.\n\n    FDN collector number 137.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Authority of the Consuls')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{W}'))\n        kwargs.setdefault('rules_text', 'Creatures your opponents control enter tapped.\\nWhenever a creature an opponent controls enters, you gain 1 life.')\n        super().__init__(**kwargs)\n        self._effect_ref: ContinuousEffect | None = None\n\n    def on_resolve(self, game: GameState) -> None:\n        self._register_effect(game)\n\n    def _register_effect(self, game: GameState) -> None:\n        enchantment_ref = self\n\n        def _apply(game: GameState) -> None:\n            controller = enchantment_ref.controller\n            if controller is None:\n                return\n            if not _is_on_battlefield(game, enchantment_ref):\n                return\n            for player in game.players:\n                if player is controller:\n                    continue\n                for obj in game.get_battlefield(player).get_all():\n                    if CardType.CREATURE in getattr(obj, 'card_types', set()):\n                        if getattr(obj, 'summoning_sick', False):\n                            obj.is_tapped = True\n        effect = ContinuousEffect(source=enchantment_ref, layer=Layer.ABILITY, sublayer=None, apply=_apply, duration=DURATION_PERMANENT)\n        self._effect_ref = game.effect_manager.add(effect)\n\n    def register_triggers(self, game: GameState) -> None:\n        from engine.triggers import TriggerRegistration\n        source = self\n\n        def _condition(game: Any, event: dict) -> bool:\n            permanent = event.permanent\n            if permanent is None:\n                return False\n            controller = source.controller\n            if controller is None:\n                return False\n            perm_controller = getattr(permanent, 'controller', None)\n            if perm_controller is controller:\n                return False\n            return CardType.CREATURE in getattr(permanent, 'card_types', set())\n\n        def _effect(game: GameState) -> None:\n            controller = source.controller\n            if controller is None:\n                return\n            if hasattr(controller, 'life'):\n                controller.life += 1\n                game.trigger_manager.fire_event(game, GainsLifeTriggeredEvent(player=controller, amount=1))\n        controller = getattr(self, 'controller', None) or game.active_player\n        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=controller))\n\n    def register_replacement_effects(self, game: GameState) -> None:\n        if self._effect_ref is None:\n            self._register_effect(game)\n\n===== fdn_44 IMPL =====\n\"\"\"Card implementation for Kaito, Cunning Infiltrator.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import Creature, LoyaltyAbility, Planeswalker\nfrom engine.types import CardType, Keyword, ManaCost, ManaType, Supertype, Zone\nfrom engine.events import DealsDamageTriggeredEvent, SpellCastTriggeredEvent\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n    from cards.registry import CardRegistry\n\nclass KaitoCunningInfiltrator(Planeswalker):\n    \"\"\"Kaito, Cunning Infiltrator — {1}{U}{U} — 3 loyalty.\n\n    Whenever a creature you control deals combat damage to a player, put a\n    loyalty counter on Kaito.\n    +1: Up to one target creature you control can't be blocked this turn.\n        Draw a card, then discard a card.\n    −2: Create a 2/1 blue Ninja creature token.\n    −9: You get an emblem with \"Whenever a player casts a spell, you create\n        a 2/1 blue Ninja creature token.\"\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Kaito, Cunning Infiltrator')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{1}{U}{U}'))\n        kwargs.setdefault('starting_loyalty', 3)\n        kwargs.setdefault('supertypes', set())\n        kwargs['supertypes'] = (kwargs.get('supertypes') or set()) | {Supertype.LEGENDARY}\n        kwargs.setdefault('subtypes', set())\n        kwargs['subtypes'] = (kwargs.get('subtypes') or set()) | {'Kaito'}\n        kwargs.setdefault('rules_text', 'Whenever a creature you control deals combat damage to a player, put a loyalty counter on Kaito.\\n+1: Up to one target creature you control can\\'t be blocked this turn. Draw a card, then discard a card.\\n−2: Create a 2/1 blue Ninja creature token.\\n−9: You get an emblem with \"Whenever a player casts a spell, you create a 2/1 blue Ninja creature token.\"')\n        super().__init__(**kwargs)\n\n    def register_triggers(self, game: Any) -> None:\n        \"\"\"Register passive: combat damage to a player → loyalty counter.\"\"\"\n        from engine.game import add_counter\n        from engine.triggers import TriggerRegistration\n        pw = self\n        controller = getattr(self, 'controller', None) or game.active_player\n\n        def _combat_damage_condition(game: Any, event: dict) -> bool:\n            \"\"\"Fire when a creature controlled by Kaito's controller deals damage to a player.\"\"\"\n            source = event.source\n            target = event.target\n            if not event.combat:\n                return False\n            if source is None or target is None:\n                return False\n            source_types = getattr(source, 'card_types', set())\n            if CardType.CREATURE not in source_types:\n                return False\n            if getattr(source, 'controller', None) is not pw.controller:\n                return False\n            if not hasattr(target, 'life'):\n                return False\n            return True\n\n        def _combat_damage_effect(game: Any) -> None:\n            \"\"\"Put a loyalty counter on Kaito.\"\"\"\n            add_counter(game, pw, 'loyalty', 1)\n        game.trigger_manager.register(TriggerRegistration(event_type=DealsDamageTriggeredEvent, condition=_combat_damage_condition, effect=_combat_damage_effect, source=self, controller=controller))\n\n    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n        pw = self\n\n        def _plus1(game: Any) -> None:\n            \"\"\"Up to one target creature can't be blocked. Draw then discard.\"\"\"\n            from engine.game import discard, draw_card\n            target = getattr(pw, '_resolve_target', None)\n            if target is not None:\n                target._cant_be_blocked = True\n            controller = pw.controller\n            if controller is not None:\n                drawn = draw_card(game, controller)\n                hand = controller.zones[Zone.HAND]\n                cards_in_hand = hand.get_all()\n                if cards_in_hand:\n                    card_to_discard = cards_in_hand[-1]\n                    discard(game, controller, card_to_discard)\n\n        def _minus2(game: Any) -> None:\n            \"\"\"Create a 2/1 blue Ninja creature token.\"\"\"\n            from engine.game import create_token\n            controller = pw.controller\n            if controller is not None:\n                token = Creature(name='Ninja', base_power=2, base_toughness=1, subtypes={'Ninja'})\n                create_token(game, controller, token)\n\n        def _minus9(game: Any) -> None:\n            \"\"\"Emblem — whenever a player casts a spell, create a 2/1 Ninja token.\"\"\"\n            from engine.triggers import TriggerRegistration\n            from engine.game import create_token\n            controller = pw.controller\n            if controller is None:\n                return\n            emblem = type('Emblem', (), {'name': 'Kaito Emblem'})()\n\n            def _spell_cast_condition(game: Any, event: dict) -> bool:\n                \"\"\"Always fires when any player casts a spell.\"\"\"\n                return True\n\n            def _spell_cast_effect(game: Any) -> None:\n                \"\"\"Create a 2/1 blue Ninja creature token.\"\"\"\n                token = Creature(name='Ninja', base_power=2, base_toughness=1, subtypes={'Ninja'})\n                create_token(game, controller, token)\n            game.trigger_manager.register(TriggerRegistration(event_type=SpellCastTriggeredEvent, condition=_spell_cast_condition, effect=_spell_cast_effect, source=emblem, controller=controller))\n        return [LoyaltyAbility(loyalty_cost=+1, effect=_plus1, description=\"+1: Up to one target creature can't be blocked. Draw, then discard.\"), LoyaltyAbility(loyalty_cost=-2, effect=_minus2, description='−2: Create a 2/1 blue Ninja creature token.'), LoyaltyAbility(loyalty_cost=-9, effect=_minus9, description='−9: Emblem — whenever a player casts a spell, create 2/1 Ninja token.')]\n\n===== fdn_48 IMPL =====\n\"\"\"Card implementation for Refute.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import Instant\nfrom engine.types import ManaCost, TargetRequirement, Zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\ndef _get_chosen_target(card: Any, game: Any) -> Any:\n    \"\"\"Retrieve the first chosen target for a spell.\"\"\"\n    chosen = getattr(card, \"chosen_targets\", None)\n    if chosen:\n        return chosen[0]\n    return getattr(card, \"_resolve_target\", None)\n\n\ndef _counter_spell(game: \"GameState\", stack_obj: Any) -> None:\n    \"\"\"Counter a spell — remove from stack and move card to graveyard.\"\"\"\n    from engine.stack import StackObject\n\n    if not isinstance(stack_obj, StackObject):\n        return\n\n    card = stack_obj.source\n    stack_items = game.stack._items  # noqa: SLF001\n    found = False\n    for i, item in enumerate(stack_items):\n        if item is stack_obj:\n            stack_items.pop(i)\n            found = True\n            break\n\n    if not found:\n        return\n\n    controller = stack_obj.controller\n    owner = getattr(card, \"owner\", controller)\n\n    if controller is not None:\n        stack_zone = controller.zones[Zone.STACK]\n        if stack_zone.contains(card):\n            stack_zone.remove(card)\n\n    if owner is not None:\n        graveyard = owner.zones[Zone.GRAVEYARD]\n        graveyard.add(card)\n\n\nclass Refute(Instant):\n    \"\"\"Refute — {1}{U}{U} — Instant.\n\n    Counter target spell. Draw a card, then discard a card.\n\n    FDN collector number 48.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"Refute\")\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{U}{U}\"))\n        kwargs.setdefault(\n            \"rules_text\",\n            \"Counter target spell. Draw a card, then discard a card.\",\n        )\n        super().__init__(**kwargs)\n\n    def can_cast(self, game: \"GameState\") -> bool:\n        \"\"\"Cannot cast unless there's a spell on the stack to counter.\"\"\"\n        from engine.stack import StackObject\n\n        for stack_obj in game.stack.objects():\n            source = stack_obj.source\n            if source is self:\n                continue\n            # Only target spells (not triggered/activated abilities)\n            if getattr(stack_obj, \"is_spell\", True):\n                return True\n        return False\n\n    def get_targets(self, game: \"GameState\") -> list:\n        \"\"\"Target spell on the stack.\"\"\"\n        from engine.stack import StackObject\n\n        targets = []\n        for stack_obj in game.stack.objects():\n            source = stack_obj.source\n            if source is self:\n                continue\n            if getattr(stack_obj, \"is_spell\", True):\n                targets.append(stack_obj)\n        if not targets:\n            return []\n        return [\n            TargetRequirement(\n                filter_fn=lambda obj: obj is not self and getattr(obj, \"is_spell\", True),\n                description=\"target spell\",\n                zone=Zone.STACK,\n            )\n        ]\n\n    def on_resolve(self, game: \"GameState\") -> None:\n        \"\"\"Counter target spell, then draw a card, then discard a card.\"\"\"\n        from engine.game import discard, draw_card\n\n        target = _get_chosen_target(self, game)\n        # Single-target spell fizzles if target is illegal\n        if target is None:\n            return\n        if target is not None:\n            _counter_spell(game, target)\n\n        controller = self.controller\n        if controller is None:\n            return\n\n        # Draw a card\n        draw_card(game, controller)\n\n        # Discard a card\n        hand = controller.zones[Zone.HAND]\n        cards_in_hand = list(hand.get_all())\n        if cards_in_hand:\n            try:\n                chosen = controller.choose_card(\n                    cards_in_hand, \"Choose a card to discard\"\n                )\n            except Exception:\n                chosen = cards_in_hand[0] if cards_in_hand else None\n            if chosen is not None:\n                discard(game, controller, chosen)\n\n","numLines":881,"startLine":1,"totalLines":881}}}
