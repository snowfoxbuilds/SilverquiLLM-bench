icted mana is excluded unless the spell being cast is an\n        instant or sorcery.\n        \"\"\"\n        if instant_or_sorcery:\n            return dict(self._pool)\n        return {\n            mt: self._pool[mt] - self._restricted.get(mt, 0) for mt in self._pool\n        }"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8218,"cache_read_input_tokens":205250,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8218},"output_tokens":55,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"1a75e57b-d845-4814-b1a9-adfaef121449","uuid":"1a5528a5-9a2e-4b2d-8db0-8b104166186e","request_id":"req_011CbtSeorvtbUsKmy7ppsVy"}
