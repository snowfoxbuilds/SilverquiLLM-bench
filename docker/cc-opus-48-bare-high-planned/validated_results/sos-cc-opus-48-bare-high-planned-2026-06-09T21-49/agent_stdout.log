      activate_ability(game, player, ability)\nengine_tests/test_abilities.py:352:        ability = ActivatedAbilityInstance(\nengine_tests/test_abilities.py:358:        activate_ability(game, player, ability)\nengine_tests/test_abilities.py:366:        ability = ActivatedAbilityInstance(\nengine_tests/test_abilities.py:372:        activate_ability(game, player, ability)\nengine_tests/test_abilities.py:381:        ability = ActivatedAbilityInstance(","is_error":false}]},"parent_tool_use_id":null,"session_id":"1a75e57b-d845-4814-b1a9-adfaef121449","uuid":"032c30af-a730-4676-a83c-0e8d515bc1dc","timestamp":"2026-06-09T21:51:05.431Z","tool_use_result":{"stdout":"\"\"\"Tests for engine/abilities.py — Activated abilities system.\n\nCovers:\n- ActivatedAbilityInstance dataclass construction and fields.\n- LoyaltyAbilityInstance dataclass construction and fields.\n- activate_ability: mana ability → resolves immediately (no stack), effect applied.\n- activate_ability: non-mana ability → pushes StackObject to stack.\n- tap_cost: succeeds when untapped, fails when already tapped, sets is_tapped.\n- Timing checks: regular activated abilities work at instant speed (no sorcery restriction).\n- Mana abilities bypass timing checks entirely (resolve immediately).\n- Only loyalty abilities have sorcery-speed restriction.\n- LoyaltyAbility: loyalty counter adjustment (+N, −N).\n- LoyaltyAbility: once-per-turn restriction.\n- LoyaltyAbility: once-per-turn resets after clear_loyalty_tracking.\n- LoyaltyAbility: insufficient loyalty for −N cost → AbilityError.\n- Cost payment failure → AbilityError, no stack entry.\n- Integration: land tap-for-mana → mana added and card tapped.\n- Multiple abilities on the same source.\n- Edge cases: unknown ability type, zero loyalty cost, etc.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport pytest\n\nfrom engine.abilities import (\n    AbilityError,\n    ActivatedAbilityInstance,\n    LoyaltyAbilityInstance,\n    activate_ability,\n    clear_loyalty_tracking,\n    tap_cost,\n)\nfrom engine.card import Land, Planeswalker\nfrom engine.game_state import GameState\nfrom engine.mana import ManaPool\nfrom engine.player import DeterministicPlayer\nfrom engine.stack import StackObject\nfrom engine.types import ManaType, Phase, Step\n\n\n# ---------------------------------------------------------------------------\n# Helpers / Fixtures\n# ---------------------------------------------------------------------------\n\n\n@pytest.fixture(autouse=True)\ndef _reset_loyalty_tracker():\n    \"\"\"Ensure the module-level loyalty tracker is clean for every test.\"\"\"\n    clear_loyalty_tracking()\n    yield\n    clear_loyalty_tracking()\n\n\ndef _make_game(\n    *,\n    p1_script: list | None = None,\n    p2_script: list | None = None,\n    phase: Phase = Phase.PRECOMBAT_MAIN,\n    step: Step | None = None,\n) -> GameState:\n    \"\"\"Create a minimal 2-player GameState at the specified phase/step.\"\"\"\n    p1 = DeterministicPlayer(\"Alice\", p1_script or [])\n    p2 = DeterministicPlayer(\"Bob\", p2_script or [])\n    game = GameState([p1, p2])\n    game.phase = phase\n    game.step = step\n    return game\n\n\ndef _sorcery_speed_game() -> GameState:\n    \"\"\"Return a game where sorcery-speed timing is met for the active player.\"\"\"\n    return _make_game(phase=Phase.PRECOMBAT_MAIN, step=None)\n\n\ndef _instant_speed_game() -> GameState:\n    \"\"\"Return a game where sorcery-speed timing is NOT met (combat phase).\"\"\"\n    return _make_game(phase=Phase.COMBAT, step=Step.DECLARE_ATTACKERS)\n\n\n=== grep priority_loop usage in engine_tests ===\nengine_tests/test_abilities.py:4:- ActivatedAbilityInstance dataclass construction and fields.\nengine_tests/test_abilities.py:5:- LoyaltyAbilityInstance dataclass construction and fields.\nengine_tests/test_abilities.py:6:- activate_ability: mana ability → resolves immediately (no stack), effect applied.\nengine_tests/test_abilities.py:7:- activate_ability: non-mana ability → pushes StackObject to stack.\nengine_tests/test_abilities.py:28:    ActivatedAbilityInstance,\nengine_tests/test_abilities.py:29:    LoyaltyAbilityInstance,\nengine_tests/test_abilities.py:30:    activate_ability,\nengine_tests/test_abilities.py:82:# ActivatedAbilityInstance — construction\nengine_tests/test_abilities.py:86:class TestActivatedAbilityInstanceConstruction:\nengine_tests/test_abilities.py:87:    \"\"\"ActivatedAbilityInstance dataclass stores all expected fields.\"\"\"\nengine_tests/test_abilities.py:94:        ability = ActivatedAbilityInstance(\nengine_tests/test_abilities.py:112:        ability = ActivatedAbilityInstance(\nengine_tests/test_abilities.py:123:# LoyaltyAbilityInstance — construction\nengine_tests/test_abilities.py:127:class TestLoyaltyAbilityInstanceConstruction:\nengine_tests/test_abilities.py:128:    \"\"\"LoyaltyAbilityInstance dataclass stores all expected fields.\"\"\"\nengine_tests/test_abilities.py:134:        ability = LoyaltyAbilityInstance(\nengine_tests/test_abilities.py:150:        ability = LoyaltyAbilityInstance(\nengine_tests/test_abilities.py:209:# activate_ability — mana ability (resolves immediately)\nengine_tests/test_abilities.py:221:        ability = ActivatedAbilityInstance(\nengine_tests/test_abilities.py:228:        activate_ability(game, player, ability)\nengine_tests/test_abilities.py:236:        ability = ActivatedAbilityInstance(\nengine_tests/test_abilities.py:243:        activate_ability(game, player, ability)\nengine_tests/test_abilities.py:252:        ability = ActivatedAbilityInstance(\nengine_tests/test_abilities.py:260:        activate_ability(game, player, ability)\nengine_tests/test_abilities.py:269:        ability = ActivatedAbilityInstance(\nengine_tests/test_abilities.py:277:        activate_ability(game, non_active, ability)\nengine_tests/test_abilities.py:286:        ability = ActivatedAbilityInstance(\nengine_tests/test_abilities.py:294:            activate_ability(game, player, ability)\nengine_tests/test_abilities.py:298:# activate_ability — non-mana ability (pushes to stack)\nengine_tests/test_abilities.py:309:        ability = ActivatedAbilityInstance(\nengine_tests/test_abilities.py:316:        activate_ability(game, player, ability)\nengine_tests/test_abilities.py:323:        ability = ActivatedAbilityInstance(\nengine_tests/test_abilities.py:329:        activate_ability(game, player, ability)\nengine_tests/test_abilities.py:337:        ability = ActivatedAbilityInstance(\nengine_tests/test_abilities.py:343:        activate_ability(game, player, ability)\nengine_tests/test_abilities.py:352:        ability = ActivatedAbilityInstance(\nengine_tests/test_abilities.py:358:        activate_ability(game, player, ability)\nengine_tests/test_abilities.py:366:        ability = ActivatedAbilityInstance(\nengine_tests/test_abilities.py:372:        activate_ability(game, player, ability)\nengine_tests/test_abilities.py:381:        ability = ActivatedAbilityInstance(","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
