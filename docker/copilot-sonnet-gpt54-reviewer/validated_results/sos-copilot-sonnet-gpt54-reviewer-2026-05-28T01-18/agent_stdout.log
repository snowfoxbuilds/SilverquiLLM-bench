1. from engine.card import Land
2. from engine.events import SpellCastTriggeredEvent
3. from engine.types import CardType, ManaCost, ManaType, Phase, Step
4. from test_utils import create_game, set_board_state, advance_to_phase
5. 
6. from .card_impl import GreatHallOfTheBiblioplex
7. 
8. 
9. def test_great_hall_basic_land_properties():
10.     card = GreatHallOfTheBiblioplex()
11.     assert isinstance(card, Land)
12.     assert card.name == "Great Hall of the Biblioplex"
13.     assert card.mana_cost == ManaCost()
14.     assert CardType.LAND in card.card_types
15.     assert "Add {C}" in card.rules_text
16. 
17. 
18. def test_great_hall_has_two_mana_abilities():
19.     card = GreatHallOfTheBiblioplex()
20.     abilities = card.get_mana_abilities()
21.     assert len(abilities) == 2
22.     descriptions = [ab.description for ab in abilities]
23.     assert "{T}: Add {C}." in descriptions
24.     assert "{T}, Pay 1 life: Add one mana of any color." in descriptions
25. 
26. 
27. def test_first_mana_ability_adds_colorless_and_taps():
28.     game = create_game()
29.     player = game.players[0]
30.     hall = GreatHallOfTheBiblioplex(owner=player)
31.     set_board_state(game, battlefield={player: [hall]})
32. 
33.     mana_ability = hall.get_mana_abilities()[0]
34.     assert hall.is_tapped is False
35. 
36.     assert mana_ability.cost(game, hall) is True
37.     mana_ability.mana_produced(game)
38. 
39.     assert hall.is_tapped is True
40.     assert player.mana_pool.colorless == 1
41. 
42. 
43. def test_second_mana_ability_costs_life_and_adds_mana():
44.     game = create_game()
45.     player = game.players[0]
46.     hall = GreatHallOfTheBiblioplex(owner=player)
47.     set_board_state(game, battlefield={player: [hall]})
48. 
49.     start_life = player.life
50.     mana_ability = hall.get_mana_abilities()[1]
51. 
52.     assert mana_ability.cost(game, hall) is True
53.     mana_ability.mana_produced(game)
54. 
55.     assert hall.is_tapped is True
56.     assert player.life == start_life - 1
57.     total_mana = (
58.         player.mana_pool.white
59.         + player.mana_pool.blue
60.         + player.mana_pool.black
61.         + player.mana_pool.red
62.         + player.mana_pool.green
63.         + player.mana_pool.colorless
64.     )
65.     assert total_mana == 1
66. 
