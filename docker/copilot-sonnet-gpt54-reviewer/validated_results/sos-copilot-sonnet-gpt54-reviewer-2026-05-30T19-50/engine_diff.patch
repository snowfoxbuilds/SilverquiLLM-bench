 # Cost reduction
 # ------------------------------------------------------------------
 
+def get_external_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:
+    """Return total generic mana reduction granted to *card* by permanents on the battlefield.
+
+    Any permanent that implements ``grants_cost_reduction(game, spell_card)``
+    may contribute cost reduction to spells being cast by their controller.
+    This supports effects like Witherbloom, the Balancer granting affinity
+    for creatures to instants and sorceries cast by their controller.
+    """
+    from engine.types import Zone
+
+    total = 0
+    battlefield = controller.zones[Zone.BATTLEFIELD]
+    for permanent in battlefield.get_all():
+        hook = getattr(permanent, "grants_cost_reduction", None)
+        if hook is not None:
+            try:
+                amount = hook(game, card)
+                if amount and amount > 0:
+                    total += amount
+            except Exception:
+                pass
+    return total
+
+
 def get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:
     """Return the generic mana reduction for casting *card*.
 
     Queries ``card.cost_reduction(game)`` and clamps the result so that
     the generic portion of the mana cost cannot go below 0.
 
-    This is a simplified single-card self-reduction model.  Full MTG
-    cost-reduction interactions (Trinisphere, multiple reductions from
-    different sources) are deferred.
+    Also queries permanents on the controller's battlefield for any
+    external cost reductions granted via ``grants_cost_reduction(game, card)``
+    (e.g. Witherbloom, the Balancer granting affinity to instants/sorceries).
     """
     # Ensure card.controller is set so the hook can reference "you" / the
     # casting player even when the card was never explicitly assigned one.
@@ -104,6 +128,8 @@
     # Restore previous controller in case the caller doesn't want a
     # side-effect (get_cost_reduction is a query, not a mutation).
     card.controller = prev_controller
+    # Add external reductions from battlefield permanents.
+    raw += get_external_cost_reduction(game, card, controller)
     generic = card.mana_cost.generic if card.mana_cost else 0
     return max(0, min(raw, generic))
 
@@ -245,6 +271,15 @@
     stack_obj.on_resolve = _on_resolve
     game.stack.push(stack_obj)
 
+    # Fire SpellCastTriggeredEvent so triggers like "whenever you cast a spell"
