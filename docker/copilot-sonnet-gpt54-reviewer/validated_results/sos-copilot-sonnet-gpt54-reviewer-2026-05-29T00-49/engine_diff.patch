+def gain_life(game: GameState, player: Any, amount: int) -> None:
+    """Grant *player* *amount* life and fire :class:`GainsLifeTriggeredEvent`.
+
+    Parameters:
+        game: The current game state.
+        player: The player gaining life (must have a ``life`` attribute).
+        amount: The amount of life to gain (must be > 0 to have effect).
+    """
+    if amount <= 0:
+        return
+    if not hasattr(player, "life"):
+        return
+    player.life += amount
+    if hasattr(game, "trigger_manager"):
