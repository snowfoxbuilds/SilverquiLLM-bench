{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Syyms941JAfKKrWmrxsMuC","type":"tool_result","content":"1\t\"\"\"Card implementation for Witherbloom, the Balancer.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.types import CardType, Keyword, ManaCost, Supertype\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t\n13\t\n14\tclass WitherbloomTheBalancer(Creature):\n15\t    \"\"\"Witherbloom, the Balancer — {6}{B}{G} — Legendary Creature — Elder Dragon 5/5.\n16\t\n17\t    Flying, deathtouch\n18\t    Affinity for creatures (this spell costs {1} less to cast for each\n19\t    creature you control).\n20\t    Instant and sorcery spells you cast have affinity for creatures.\n21\t    \"\"\"\n22\t\n23\t    def __init__(self, **kwargs: Any) -> None:\n24\t        kwargs.setdefault(\"name\", \"Witherbloom, the Balancer\")\n25\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{6}{B}{G}\"))\n26\t        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n27\t        kwargs.setdefault(\"subtypes\", {\"Elder\", \"Dragon\"})\n28\t        kwargs.setdefault(\"keywords\", Keyword.FLYING | Keyword.DEATHTOUCH)\n29\t        kwargs.setdefault(\"base_power\", 5)\n30\t        kwargs.setdefault(\"base_toughness\", 5)\n31\t        kwargs.setdefault(\n32\t            \"rules_text\",\n33\t            \"Flying, deathtouch\\n\"\n34\t            \"Affinity for creatures\\n\"\n35\t            \"Instant and sorcery spells you cast have affinity for creatures.\",\n36\t        )\n37\t        super().__init__(**kwargs)\n38\t\n39\t    def _count_controller_creatures(self, game: \"GameState\") -> int:\n40\t        \"\"\"Return the number of creatures controlled by self.controller on the battlefield.\"\"\"\n41\t        ctrl = getattr(self, \"controller\", None)\n42\t        if ctrl is None:\n43\t            return 0\n44\t        bf = game.get_battlefield(ctrl)\n45\t        return sum(\n46\t            1\n47\t            for card in bf.get_all()\n48\t            if CardType.CREATURE in getattr(card, \"card_types\", set())\n49\t        )\n50\t\n51\t    def cost_reduction(self, game: \"GameState\") -> int:\n52\t        \"\"\"Return the number of creatures the controller controls (affinity for creatures).\"\"\"\n53\t        return self._count_controller_creatures(game)\n54\t\n55\t    def get_affinity_cost_reduction(self, spell: Any, game: \"GameState\") -> int:\n56\t        \"\"\"Return the creature-count cost reduction for instant/sorcery spells.\n57\t\n58\t        If *spell* is an instant or sorcery controlled by the same controller\n59\t        as this permanent, returns the number of creatures that controller\n60\t        controls. Otherwise returns 0.\n61\t\n62\t        Parameters:\n63\t            spell: The spell card to evaluate.\n64\t            game: The current game state.\n65\t        \"\"\"\n66\t        # Guard: uncontrolled Witherbloom grants nothing.\n67\t        ctrl = getattr(self, \"controller\", None)\n68\t        if ctrl is None:\n69\t            return 0\n70\t\n71\t        # Only grant to spells controlled by the same controller.\n72\t        spell_ctrl = getattr(spell, \"controller\", None)\n73\t        if spell_ctrl is not ctrl:\n74\t            return 0\n75\t\n76\t        # Only instants and sorceries qualify.\n77\t        card_types = getattr(spell, \"card_types\", set())\n78\t        if CardType.INSTANT not in card_types and CardType.SORCERY not in card_types:\n79\t            return 0\n80\t\n81\t        return self._count_controller_creatures(game)\n82\t"}]},"parent_tool_use_id":"toolu_01UJKMjqL9d5KRnRnDXJ1wSL","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c","uuid":"0aa4e72a-4072-4fbe-95d3-d9f7065b4ce4","timestamp":"2026-05-28T08:54:02.235Z","subagent_type":"Reviewer","task_description":"Reviewer for sos_245"}
