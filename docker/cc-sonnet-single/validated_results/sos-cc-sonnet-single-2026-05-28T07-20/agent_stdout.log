"\"\n50\t+\n51\t+    def __init__(self, **kwargs: Any) -> None:\n52\t+        kwargs.setdefault(\"name\", \"Great Hall of the Biblioplex\")\n53\t+        kwargs.setdefault(\n54\t+            \"rules_text\",\n55\t+            \"{T}: Add {C}.\\n\"\n56\t+            \"{T}, Pay 1 life: Add one mana of any color. Spend this mana only \"\n57\t+            \"to cast an instant or sorcery spell.\\n\"\n58\t+            \"{5}: If this land isn't a creature, it becomes a 2/4 Wizard \"\n59\t+            \"creature with \\\"Whenever you cast an instant or sorcery spell, this \"\n60\t+            \"creature gets +1/+0 until end of turn.\\\" It's still a land.\",\n61\t+        )\n62\t+        super().__init__(**kwargs)\n63\t+        # Creature tracking\n64\t+        self.is_creature: bool = False\n65\t+        # Power/toughness (only meaningful after creature transformation)\n66\t+        self.base_power: int = 0\n67\t+        self.base_toughness: int = 0\n68\t+        self.modified_power: int = 0\n69\t+        self.modified_toughness: int = 0\n70\t+        # Temporary power bonuses from instant/sorcery casts\n71\t+        self.power_bonus: int = 0\n72\t+        # Track whether the spell-cast trigger has been registered\n73\t+        self._trigger_registered: bool = False\n74\t+\n75\t+    # ------------------------------------------------------------------\n76\t+    # Mana abilities\n77\t+    # ------------------------------------------------------------------\n78\t+\n79\t+    def get_mana_abilities(self) -> list[ManaAbility]:\n80\t+        \"\"\"Return the two mana abilities: tap for colorless, tap + 1 life for any color.\"\"\"\n81\t+        source = self\n82\t+\n83\t+        # --- Ability 1: {T}: Add {C} ---\n84\t+        def _colorless_effect(game: Any) -> None:\n85\t+            controller = source.controller\n86\t+            if controller is not None:\n87\t+                controller.mana_pool.add(ManaType.COLORLESS, 1)\n88\t+\n89\t+        # --- Ability 2: {T}, Pay 1 life: Add one mana of any color ---\n90\t+        def _life_cost(game: Any, src: Any) -> bool:\n91\t+            \"\"\"Tap the source and pay 1 life.\"\"\"\n92\t+            if getattr(src, \"is_tapped\", False):\n93\t+                return False\n94\t+            src.is_tapped = True\n95\t+            # Pay 1 life from the controller\n96\t+            controller = getattr(src, \"controller\", None)\n97\t+            if controller is not None:\n98\t+                controller.life -= 1\n99\t+            return True\n100\t+\n101\t+        def _colored_effect(game: Any) -> None:\n102\t+            \"\"\"Produce one mana of any color (controller chooses).\"\"\"\n103\t+            controller = source.controller\n104\t+            if controller is None:\n105\t+                return\n106\t+            color_options = [\n107\t+                ManaType.WHITE,\n108\t+                ManaType.BLUE,\n109\t+                ManaType.BLACK,\n110\t+                ManaType.RED,\n111\t+                ManaType.GREEN,\n112\t+            ]\n113\t+            try:\n114\t+                chosen_color = controller.choose(color_options, \"Choose a color of mana to produce\")\n115\t+            except Exception:\n116\t+                chosen_color = ManaType.WHITE\n117\t+            controller.mana_pool.add(chosen_color, 1)\n118\t+\n119\t+        return [\n120\t+            ManaAbility(\n121\t+                cost=_tap_cost,\n122\t+                mana_produced=_colorless_effect,\n123\t+                description=\"{T}: Add {C}.\",\n124\t+            ),\n125\t+            ManaAbility(\n126\t+                cost=_life_cost,\n127\t+                mana_produced=_colored_effect,\n128\t+                description=\"{T}, Pay 1 life: Add one mana of any color.\",\n129\t+            ),\n130\t+        ]\n131\t+\n132\t+    # ------------------------------------------------------------------\n133\t+    # Activated abilities\n134\t+    # ------------------------------------------------------------------\n135\t+\n136\t+    def get_activated_abilities(self) -> list[ActivatedAbility]:\n137\t+        \"\"\"Return the {5} creature-transformation ability.\"\"\"\n138\t+        source = self\n139\t+\n140\t+        def _transform_cost(game: Any, src: Any) -> bool:\n141\t+            \"\"\"Pay {5} generic mana.\"\"\"\n142\t+            controller = getattr(src, \"controller\", None)\n143\t+            if controller is None:\n144\t+                return False\n145\t+            cost = ManaCost(generic=5)\n146\t+            if not controller.mana_pool.can_pay(cost):\n147\t+                return False\n148\t+            controller.mana_pool.pay(cost)\n149\t+            return True\n150\t+\n151\t+        def _transform_effect(game: Any) -> None:\n152\t+            \"\"\"If not already a creature, become a 2/4 Wizard creature.\"\"\"\n153\t+            source.activate_creature_form(game)\n154\t+\n155\t+        return [\n156\t+            ActivatedAbility(\n157\t+                cost=_transform_cost,\n158\t+                effect=_transform_effect,\n159\t+                description=(\n160\t+                    \"{5}: If this land isn't a creature, it becomes a 2/4 Wizard \"\n161\t+                    \"creature with the instant/sorcery trigger. It's still a land.\"\n162\t+                ),\n163\t+            )\n164\t+        ]\n165\t+\n166\t+    # ------------------------------------------------------------------\n167\t+    # Continuous-effect reset support\n168\t+    # ------------------------------------------------------------------\n169\t+\n170\t+    def _reset_characteristics(self) -> None:\n171\t+        \"\"\"Reset mutable characteristics to their original (pre-effect) values.\n172\t+\n173\t+        Called by :meth:`EffectManager.apply_all` before reapplying effects.\n174\t+        When in creature form, also resets modified_power/toughness to base values.\n175\t+        \"\"\"\n176\t+        super()._reset_characteristics()\n177\t+        if self.is_creature:\n178\t+            self.modified_power = self.base_power\n179\t+            self.modified_toughness = self.base_toughness\n180\t+\n181\t+    # ------------------------------------------------------------------\n182\t+    # Creature transformation\n183\t+    # ------------------------------------------------------------------\n184\t+\n185\t+    def activate_creature_form(self, game: Any) -> None:\n186\t+        \"\"\"Transform this land into a 2/4 Wizard creature (one-time, idempotent).\"\"\"\n187\t+        if self.is_creature:\n188\t+            # Already a creature — no-op\n189\t+            return\n190\t+        self.is_creature = True\n191\t+        self.card_types.add(CardType.CREATURE)\n192\t+        self.base_power = 2\n193\t+        self.base_toughness = 4\n194\t+        self.modified_power = 2\n195\t+        self.modified_toughness = 4\n196\t+        self.subtypes.add(\"Wizard\")\n197\t+        # Register the trigger now that we're a creature\n198\t+        self._register_spell_cast_trigger(game)\n199\t+\n200\t+    # ------------------------------------------------------------------\n201\t+    # Trigger registration\n202\t+    # ------------------------------------------------------------------\n203\t+\n204\t+    def _register_spell_cast_trigger(self, game: Any) -> None:\n205\t+        \"\"\"Register the SpellCastTriggeredEvent trigger for +1/+0 until end of turn.\"\"\"\n206\t+        if self._trigger_registered:\n207\t+            return\n208\t+        source = self\n209\t+        controller = getattr(self, \"controller\", None)\n210\t+        if controller is None:\n211\t+            return\n212\t+\n213\t+        def _condition(game: Any, event: SpellCastTriggeredEvent) -> bool:\n214\t+            \"\"\"Fire only when this card is a creature and an instant/sorcery is cast.\"\"\"\n215\t+            if not source.is_creature:\n216\t+                return False\n217\t+            spell = event.spell\n218\t+            if spell is None:\n219\t+                return False\n220\t+            spell_types = getattr(spell, \"card_types\", set())\n221\t+            is_instant_or_sorcery = (\n222\t+                CardType.INSTANT in spell_types or CardType.SORCERY in spell_types\n223\t+            )\n224\t+            if not is_instant_or_sorcery:\n225\t+                return False\n226\t+            return True\n227\t+\n228\t+        def _effect(game: Any) -> None:\n229\t+            \"\"\"Grant +1/+0 until end of turn via a DURATION_END_OF_TURN continuous effect.\"\"\"\n230\t+            def _apply(g: Any) -> None:\n231\t+                source.modified_power += 1\n232\t+\n233\t+            game.effect_manager.add(\n234\t+                ContinuousEffect(\n235\t+                    source=source,\n236\t+                    layer=Layer.POWER_TOUGHNESS,\n237\t+                    sublayer=SubLayer.MODIFY_PT,\n238\t+                    apply=_apply,\n239\t+                    duration=DURATION_END_OF_TURN,\n240\t+                )\n241\t+            )\n242\t+            # Immediately apply all effects so modified_power is up to date.\n243\t+            game.effect_manager.apply_all(game)\n244\t+\n245\t+        game.trigger_manager.register(\n246\t+            TriggerRegistration(\n247\t+                event_type=SpellCastTriggeredEvent,\n248\t+                condition=_condition,\n249\t+                effect=_effect,\n250\t+                source=self,\n251\t+                controller=controller,\n252\t+            )\n253\t+        )\n254\t+        self._trigger_registered = True\n255\t+\n256\t+    def register_triggers(self, game: Any) -> None:\n257\t+        \"\"\"Register triggers; only the spell-cast trigger applies, and only after creature transformation.\"\"\"\n258\t+        if self.is_creature and not self._trigger_registered:\n259\t+            self._register_spell_cast_trigger(game)\n260\t+        # If not yet a creature, do nothing — the trigger is registered on transformation\n261\t"}]},"parent_tool_use_id":"toolu_0