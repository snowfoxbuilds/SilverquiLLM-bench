{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WfP1ajwVSorYfL1c94BpCy","type":"tool_result","content":"1\t\"\"\"Tests for SOS 97 — Ral Zarek, Guest Lecturer.\n2\t\n3\tCoverage:\n4\t- Static properties: name, mana cost, Planeswalker type/subtypes, starting loyalty\n5\t- +1 ability: surveil 2 (top cards optionally to graveyard, rest on library)\n6\t- +1 ability: loyalty increases from 3 to 4\n7\t- -1 ability: loyalty decreases from 3 to 2; each targeted player discards\n8\t- -1 ability: \"any number of target players\" — works for 0, 1, or 2 players\n9\t- -2 ability: loyalty decreases from 3 to 1; creature with mana value ≤3 from\n10\t  controller's graveyard is returned to the battlefield\n11\t- -2 ability: does NOT return a creature with mana value > 3\n12\t- -7 ability: loyalty decreases from 3 to -4 (needs starting loyalty ≥ 7 or test\n13\t  with inflated loyalty); coins flipped, opponent skips X turns where X = heads\n14\t\"\"\"\n15\t\n16\tfrom __future__ import annotations\n17\t\n18\timport pytest\n19\t\n20\tfrom cards.sos.sos_97.card_impl import RalZarekGuestLecturer\n21\tfrom engine.card import Creature, LoyaltyAbility, Planeswalker\n22\tfrom engine.types import CardType, ManaCost, ManaType, Supertype, Zone\n23\tfrom test_utils import create_game, set_board_state\n24\t\n25\t\n26\t# ---------------------------------------------------------------------------\n27\t# Helpers\n28\t# ---------------------------------------------------------------------------\n29\t\n30\t\n31\tdef _make_creature(name: str, cmc: int = 2, owner=None, controller=None) -> Creature:\n32\t    \"\"\"Create a minimal creature with a predictable mana cost for mana value testing.\"\"\"\n33\t    cost = ManaCost(generic=cmc) if cmc > 0 else ManaCost()\n34\t    c = Creature(\n35\t        name=name,\n36\t        mana_cost=cost,\n37\t        base_power=2,\n38\t        base_toughness=2,\n39\t        owner=owner,\n40\t        controller=controller,\n41\t    )\n42\t    return c\n43\t\n44\t\n45\tdef _activate_loyalty_ability(pw: RalZarekGuestLecturer, ability_index: int, game) -> None:\n46\t    \"\"\"Activate the nth loyalty ability on pw (0-indexed), adjusting loyalty.\"\"\"\n47\t    abilities = pw.get_loyalty_abilities()\n48\t    ability = abilities[ability_index]\n49\t    pw.loyalty += ability.loyalty_cost\n50\t    ability.effect(game)\n51\t\n52\t\n53\t# ---------------------------------------------------------------------------\n54\t# Static property tests\n55\t# ---------------------------------------------------------------------------\n56\t\n57\t\n58\tclass TestRalZarekGuestLecturerProperties:\n59\t    \"\"\"Static card data should match the SOS 97 spec.\"\"\"\n60\t\n61\t    def test_name(self) -> None:\n62\t        card = RalZarekGuestLecturer(owner=None)\n63\t        assert card.name == \"Ral Zarek, Guest Lecturer\"\n64\t\n65\t    def test_mana_cost(self) -> None:\n66\t        card = RalZarekGuestLecturer(owner=None)\n67\t        assert card.mana_cost == ManaCost.parse(\"{1}{B}{B}\")\n68\t\n69\t    def test_is_planeswalker(self) -> None:\n70\t        card = RalZarekGuestLecturer(owner=None)\n71\t        assert isinstance(card, Planeswalker)\n72\t        assert CardType.PLANESWALKER in card.card_types\n73\t\n74\t    def test_ral_subtype(self) -> None:\n75\t        card = RalZarekGuestLecturer(owner=None)\n76\t        assert \"Ral\" in card.subtypes\n77\t\n78\t    def test_legendary_supertype(self) -> None:\n79\t        card = RalZarekGuestLecturer(owner=None)\n80\t        assert Supertype.LEGENDARY in card.supertypes\n81\t\n82\t    def test_starting_loyalty_three(self) -> None:\n83\t        card = RalZarekGuestLecturer(owner=None)\n84\t        assert card.starting_loyalty == 3\n85\t\n86\t    def test_initial_loyalty_equals_starting(self) -> None:\n87\t        card = RalZarekGuestLecturer(owner=None)\n88\t        assert card.loyalty == card.starting_loyalty\n89\t\n90\t    def test_exposes_loyalty_abilities(self) -> None:\n91\t        card = RalZarekGuestLecturer(owner=None)\n92\t        abilities = card.get_loyalty_abilities()\n93\t        assert isinstance(abilities, list)\n94\t        assert len(abilities) == 4  # +1, -1, -2, -7\n95\t\n96\t    def test_loyalty_ability_types(self) -> None:\n97\t        card = RalZarekGuestLecturer(owner=None)\n98\t        for ability in card.get_loyalty_abilities():\n99\t            assert isinstance(ability, LoyaltyAbility)\n100\t\n101\t    def test_ability_loyalty_costs(self) -> None:\n102\t        card = RalZarekGuestLecturer(owner=None)\n103\t        costs = [a.loyalty_cost for a in card.get_loyalty_abilities()]\n104\t        assert +1 in costs\n105\t        assert -1 in costs\n106\t        assert -2 in costs\n107\t        assert -7 in costs\n108\t\n109\t\n110\t# ---------------------------------------------------------------------------\n111\t# +1 ability: Surveil 2 — loyalty adjustment\n112\t# ---------------------------------------------------------------------------\n113\t\n114\t\n115\tclass TestRalZarekPlusOneAbility:\n116\t    \"\"\"The +1 ability: Surveil 2, and loyalty goes from 3 → 4.\"\"\"\n117\t\n118\t    def test_plus1_increases_loyalty_from_3_to_4(self) -> None:\n119\t        game = create_game()\n120\t        p1 = game.players[0]\n121\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n122\t        assert pw.loyalty == 3\n123\t        _activate_loyalty_ability(pw, 0, game)\n124\t        assert pw.loyalty == 4\n125\t\n126\t    def test_plus1_surveil_sends_top_card_to_graveyard_when_scripted_yes(self) -> None:\n127\t        \"\"\"When the player chooses to put both library cards into the graveyard.\"\"\"\n128\t        game = create_game(scripts=([True, True], []))\n129\t        p1 = game.players[0]\n130\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n131\t\n132\t        # Put 3 cards in library so top 2 can be surveiled.\n133\t        lib_card_a = _make_creature(\"Card A\", owner=p1)\n134\t        lib_card_b = _make_creature(\"Card B\", owner=p1)\n135\t        lib_card_c = _make_creature(\"Card C\", owner=p1)\n136\t        p1.zones[Zone.LIBRARY].add(lib_card_c)  # bottom\n137\t        p1.zones[Zone.LIBRARY].add(lib_card_b)  # middle\n138\t        p1.zones[Zone.LIBRARY].add(lib_card_a)  # top\n139\t\n140\t        graveyard_before = len(p1.zones[Zone.GRAVEYARD].get_all())\n141\t        _activate_loyalty_ability(pw, 0, game)\n142\t\n143\t        graveyard_after = len(p1.zones[Zone.GRAVEYARD].get_all())\n144\t        # Two yes answers → both top cards go to graveyard.\n145\t        assert graveyard_after == graveyard_before + 2\n146\t\n147\t    def test_plus1_surveil_keeps_card_on_library_when_scripted_no(self) -> None:\n148\t        \"\"\"When the player chooses NOT to put either card into the graveyard.\"\"\"\n149\t        game = create_game(scripts=([False, False], []))\n150\t        p1 = game.players[0]\n151\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n152\t\n153\t        lib_card_a = _make_creature(\"Card A\", owner=p1)\n154\t        lib_card_b = _make_creature(\"Card B\", owner=p1)\n155\t        p1.zones[Zone.LIBRARY].add(lib_card_b)  # bottom\n156\t        p1.zones[Zone.LIBRARY].add(lib_card_a)  # top\n157\t\n158\t        lib_count_before = len(p1.zones[Zone.LIBRARY].get_all())\n159\t        gy_count_before = len(p1.zones[Zone.GRAVEYARD].get_all())\n160\t        _activate_loyalty_ability(pw, 0, game)\n161\t\n162\t        assert len(p1.zones[Zone.GRAVEYARD].get_all()) == gy_count_before\n163\t        assert len(p1.zones[Zone.LIBRARY].get_all()) == lib_count_before\n164\t\n165\t    def test_plus1_surveil_partial_send_to_graveyard(self) -> None:\n166\t        \"\"\"When the player puts one of two cards into the graveyard.\"\"\"\n167\t        game = create_game(scripts=([True, False], []))\n168\t        p1 = game.players[0]\n169\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n170\t\n171\t        lib_card_a = _make_creature(\"Card A\", owner=p1)\n172\t        lib_card_b = _make_creature(\"Card B\", owner=p1)\n173\t        p1.zones[Zone.LIBRARY].add(lib_card_b)\n174\t        p1.zones[Zone.LIBRARY].add(lib_card_a)\n175\t\n176\t        _activate_loyalty_ability(pw, 0, game)\n177\t\n178\t        gy = p1.zones[Zone.GRAVEYARD].get_all()\n179\t        lib = p1.zones[Zone.LIBRARY].get_all()\n180\t        # Exactly one card should have moved to graveyard.\n181\t        assert len(gy) == 1\n182\t        assert len(lib) == 1\n183\t\n184\t    def test_plus1_surveil_empty_library_does_not_raise(self) -> None:\n185\t        \"\"\"With an empty library, the surveil no-ops gracefully.\"\"\"\n186\t        game = create_game()\n187\t        p1 = game.players[0]\n188\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n189\t        # Library already empty.\n190\t        _activate_loyalty_ability(pw, 0, game)\n191\t        assert pw.loyalty == 4  # Loyalty still updated.\n192\t\n193\t\n194\t# ---------------------------------------------------------------------------\n195\t# -1 ability: Discard\n196\t# ---------------------------------------------------------------------------\n197\t\n198\t\n199\tclass TestRalZarekMinusOneAbility:\n200\t    \"\"\"The -1 ability: any number of target players each discard a card.\"\"\"\n201\t\n202\t    def test_minus1_decreases_loyalty_from_3_to_2(self) -> None:\n203\t        game = create_game()\n204\t        p1 = game.players[0]\n205\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n206\t        assert pw.loyalty == 3\n207\t        _activate_loyalty_ability(pw, 1, game)\n208\t        assert pw.loyalty == 2\n209\t\n210\t    def test_minus1_targeted_player_discards_one_card(self) -> None:\n211\t        game = create_game()\n212\t        p1 = game.players[0]\n213\t        p2 = game.players[1]\n214\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n215\t\n216\t        hand_card = _make_creature(\"Hand Card\", owner=p2)\n217\t        set_board_state(game, 1, hand=[hand_card])\n218\t\n219\t        # Script: p2 chooses their hand card to discard.\n220\t        from engine.player import DeterministicPlayer\n221\t        if isinstance(p2, DeterministicPlayer):\n222\t            p2._script.append(hand_card)\n223\t\n224\t        pw.chosen_targets = [p2]\n225\t        _activate_loyalty_ability(pw, 1, game)\n226\t\n227\t        assert len(p2.zones[Zone.HAND].get_all()) == 0\n228\t        assert p2.zones[Zone.GRAVEYARD].contains(hand_card)\n229\t\n230\t    def test_minus1_with_no_targets_is_a_noop(self) -> None:\n231\t        \"\"\"With no chosen targets, the -1 ability does not raise.\"\"\"\n232\t        game = create_game()\n233\t        p1 = game.players[0]\n234\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n235\t        pw.chosen_targets = []\n236\t        _activate_loyalty_ability(pw, 1, game)\n237\t        assert pw.loyalty == 2\n238\t\n239\t    def test_minus1_multiple_players_each_discard(self) -> None:\n240\t        \"\"\"Both players lose a card when both are targeted.\"\"\"\n241\t        game = create_game()\n242\t        p1 = game.players[0]\n243\t        p2 = game.players[1]\n244\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n245\t\n246\t        card1 = _make_creature(\"P1 Card\", owner=p1)\n247\t        card2 = _make_creature(\"P2 Card\", owner=p2)\n248\t        set_board_state(game, 0, hand=[card1])\n249\t        set_board_state(game, 1, hand=[card2])\n250\t\n251\t        from engine.player import DeterministicPlayer\n252\t        if isinstance(p1, DeterministicPlayer):\n253\t            p1._script.append(card1)\n254\t        if isinstance(p2, DeterministicPlayer):\n255\t            p2._script.append(card2)\n256\t\n257\t        pw.chosen_targets = [p1, p2]\n258\t        _activate_loyalty_ability(pw, 1, game)\n259\t\n260\t        assert len(p1.zones[Zone.HAND].get_all()) == 0\n261\t        assert len(p2.zones[Zone.HAND].get_all()) == 0\n262\t\n263\t\n264\t# ---------------------------------------------------------------------------\n265\t# -2 ability: Reanimate creature with mana value ≤ 3\n266\t# ---------------------------------------------------------------------------\n267\t\n268\t\n269\tclass TestRalZarekMinusTwoAbility:\n270\t    \"\"\"The -2 ability: return target creature card with mana value ≤3 from\n271\t    controller's graveyard to the battlefield.\"\"\"\n272\t\n273\t    def test_minus2_decreases_loyalty_from_3_to_1(self) -> None:\n274\t        game = create_game()\n275\t        p1 = game.players[0]\n276\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n277\t        assert pw.loyalty == 3\n278\t        _activate_loyalty_ability(pw, 2, game)\n279\t        assert pw.loyalty == 1\n280\t\n281\t    def test_minus2_returns_mv3_creature_to_battlefield(self) -> None:\n282\t        \"\"\"A creature with MV exactly 3 should be returned to the battlefield.\"\"\"\n283\t        game = create_game()\n284\t        p1 = game.players[0]\n285\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n286\t\n287\t        # Creature with mana value 3 (generic 3)\n288\t        grave_creature = _make_creature(\"Graveyard Bear\", cmc=3, owner=p1, controller=p1)\n289\t        set_board_state(game, 0, graveyard=[grave_creature])\n290\t\n291\t        pw.chosen_targets = [grave_creature]\n292\t        _activate_loyalty_ability(pw, 2, game)\n293\t\n294\t        assert p1.zones[Zone.BATTLEFIELD].contains(grave_creature)\n295\t        assert not p1.zones[Zone.GRAVEYARD].contains(grave_creature)\n296\t\n297\t    def test_minus2_returns_mv1_creature_to_battlefield(self) -> None:\n298\t        \"\"\"A creature with MV 1 (≤3) should be returned.\"\"\"\n299\t        game = create_game()\n300\t        p1 = game.players[0]\n301\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n302\t\n303\t        cheap_creature = _make_creature(\"Cheap Bear\", cmc=1, owner=p1, controller=p1)\n304\t        set_board_state(game, 0, graveyard=[cheap_creature])\n305\t\n306\t        pw.chosen_targets = [cheap_creature]\n307\t        _activate_loyalty_ability(pw, 2, game)\n308\t\n309\t        assert p1.zones[Zone.BATTLEFIELD].contains(cheap_creature)\n310\t\n311\t    def test_minus2_does_not_return_mv4_creature(self) -> None:\n312\t        \"\"\"A creature with MV 4 (> 3) must NOT be returned — the ability should\n313\t        only work on legal targets (MV ≤ 3).  If the card is set as the chosen\n314\t        target but fails the filter, it stays in the graveyard.\"\"\"\n315\t        game = create_game()\n316\t        p1 = game.players[0]\n317\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n318\t\n319\t        big_creature = _make_creature(\"Big Creature\", cmc=4, owner=p1, controller=p1)\n320\t        set_board_state(game, 0, graveyard=[big_creature])\n321\t\n322\t        pw.chosen_targets = [big_creature]\n323\t        _activate_loyalty_ability(pw, 2, game)\n324\t\n325\t        # Card must remain in graveyard (target was illegal).\n326\t        assert p1.zones[Zone.GRAVEYARD].contains(big_creature)\n327\t        assert not p1.zones[Zone.BATTLEFIELD].contains(big_creature)\n328\t\n329\t    def test_minus2_does_not_return_mv5_creature(self) -> None:\n330\t        \"\"\"A creature with MV 5 must NOT be returned.\"\"\"\n331\t        game = create_game()\n332\t        p1 = game.players[0]\n333\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n334\t\n335\t        big_creature = _make_creature(\"Massive Creature\", cmc=5, owner=p1, controller=p1)\n336\t        set_board_state(game, 0, graveyard=[big_creature])\n337\t\n338\t        pw.chosen_targets = [big_creature]\n339\t        _activate_loyalty_ability(pw, 2, game)\n340\t\n341\t        assert p1.zones[Zone.GRAVEYARD].contains(big_creature)\n342\t        assert not p1.zones[Zone.BATTLEFIELD].contains(big_creature)\n343\t\n344\t    def test_minus2_with_no_target_does_not_raise(self) -> None:\n345\t        \"\"\"With no chosen target, -2 resolves without crashing.\"\"\"\n346\t        game = create_game()\n347\t        p1 = game.players[0]\n348\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n349\t        pw.chosen_targets = []\n350\t        _activate_loyalty_ability(pw, 2, game)\n351\t        assert pw.loyalty == 1\n352\t\n353\t\n354\t# ---------------------------------------------------------------------------\n355\t# -7 ability: Coin-flip ultimatum\n356\t# ---------------------------------------------------------------------------\n357\t\n358\t\n359\tclass TestRalZarekMinusSevenAbility:\n360\t    \"\"\"The -7 ability: flip five coins; target opponent skips X turns\n361\t    where X = number of heads.\"\"\"\n362\t\n363\t    def test_minus7_correct_loyalty_cost(self) -> None:\n364\t        card = RalZarekGuestLecturer(owner=None)\n365\t        abilities = card.get_loyalty_abilities()\n366\t        ult = next(a for a in abilities if a.loyalty_cost == -7)\n367\t        assert ult.loyalty_cost == -7\n368\t\n369\t    def test_minus7_loyalty_adjustment(self) -> None:\n370\t        \"\"\"Verify loyalty change: starting at 3, after -7 = -4.\"\"\"\n371\t        game = create_game()\n372\t        p1 = game.players[0]\n373\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n374\t        # Inflate loyalty to allow the ability to \"activate\".\n375\t        pw.loyalty = 7  # ensure we can pay -7\n376\t        _activate_loyalty_ability(pw, 3, game)\n377\t        assert pw.loyalty == 0\n378\t\n379\t    def test_minus7_all_heads_skips_five_turns(self) -> None:\n380\t        \"\"\"If all 5 coins come up heads, the opponent skips 5 turns.\"\"\"\n381\t        import unittest.mock as mock\n382\t\n383\t        game = create_game()\n384\t        p1 = game.players[0]\n385\t        p2 = game.players[1]\n386\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n387\t        pw.loyalty = 7\n388\t\n389\t        pw.chosen_targets = [p2]\n390\t        # Patch random.random (or coin flip) to always return heads (1 / True).\n391\t        with mock.patch(\"random.random\", return_value=0.0):  # < 0.5 → heads\n392\t            _activate_loyalty_ability(pw, 3, game)\n393\t\n394\t        # Opponent should have 5 turns skipped queued.\n395\t        # Implementation may store skipped turns in extra_turns, a skip_turns\n396\t        # counter, or similar engine attribute.\n397\t        # We check at least one of the common patterns:\n398\t        turns_skipped = getattr(p2, \"turns_to_skip\", None)\n399\t        extra_turns_list = getattr(game, \"extra_turns\", [])\n400\t        # At least one observable change must reflect 5 turns skipped.\n401\t        # Accept either a dedicated skip counter or an empty extra_turns queue\n402\t        # (since \"skip\" ≠ \"extra turn\", a dedicated attribute is expected).\n403\t        assert turns_skipped is not None, (\n404\t            \"p2 should have a 'turns_to_skip' attribute after -7 with 5 heads\"\n405\t        )\n406\t        assert turns_skipped == 5\n407\t\n408\t    def test_minus7_all_tails_skips_zero_turns(self) -> None:\n409\t        \"\"\"If all 5 coins come up tails (X=0), the opponent skips 0 turns.\"\"\"\n410\t        import unittest.mock as mock\n411\t\n412\t        game = create_game()\n413\t        p1 = game.players[0]\n414\t        p2 = game.players[1]\n415\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n416\t        pw.loyalty = 7\n417\t\n418\t        pw.chosen_targets = [p2]\n419\t        # Patch so coins always return tails (0 heads).\n420\t        with mock.patch(\"random.random\", return_value=1.0):  # >= 0.5 → tails\n421\t            _activate_loyalty_ability(pw, 3, game)\n422\t\n423\t        turns_skipped = getattr(p2, \"turns_to_skip\", 0)\n424\t        assert turns_skipped == 0\n425\t"}]},"parent_tool_use_id":"toolu_01KGckbwVgnerVgeUKPVhYLc","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c","uuid":"ab66fe93-73e2-45b4-a340-10eeae251fdd","timestamp":"2026-05-28T08:05:32.219Z","subagent_type":"Reviewer","task_descr