{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MVDDuNnLCfjygafgmkQMZH","type":"tool_result","content":"1\t\"\"\"Card implementation for Authority of the Consuls.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom dataclasses import dataclass\n4\tfrom typing import TYPE_CHECKING, Any\n5\tfrom engine.card import ActivatedAbility, Creature, Enchantment\n6\tfrom engine.continuous_effects import ContinuousEffect, DURATION_PERMANENT, Layer, SubLayer\n7\tfrom engine.types import CardType, Keyword, ManaCost, TargetRequirement, Zone\n8\tfrom engine.events import EntersBattlefieldTriggeredEvent, GainsLifeTriggeredEvent\n9\tif TYPE_CHECKING:\n10\t    from engine.game_state import GameState\n11\t    from cards.registry import CardRegistry\n12\t\n13\tdef _is_on_battlefield(game: Any, obj: Any) -> bool:\n14\t    \"\"\"Check if *obj* is on any player's battlefield.\"\"\"\n15\t    for player in game.players:\n16\t        if game.get_battlefield(player).contains(obj):\n17\t            return True\n18\t    return False\n19\t\n20\tclass AuthorityOfTheConsuls(Enchantment):\n21\t    \"\"\"Authority of the Consuls — {W} — Creatures opponents control enter tapped.\n22\t\n23\t    Whenever a creature an opponent controls enters, you gain 1 life.\n24\t\n25\t    FDN collector number 137.\n26\t    \"\"\"\n27\t\n28\t    def __init__(self, **kwargs: Any) -> None:\n29\t        kwargs.setdefault('name', 'Authority of the Consuls')\n30\t        kwargs.setdefault('mana_cost', ManaCost.parse('{W}'))\n31\t        kwargs.setdefault('rules_text', 'Creatures your opponents control enter tapped.\\nWhenever a creature an opponent controls enters, you gain 1 life.')\n32\t        super().__init__(**kwargs)\n33\t        self._effect_ref: ContinuousEffect | None = None\n34\t\n35\t    def on_resolve(self, game: GameState) -> None:\n36\t        self._register_effect(game)\n37\t\n38\t    def _register_effect(self, game: GameState) -> None:\n39\t        enchantment_ref = self\n40\t\n41\t        def _apply(game: GameState) -> None:\n42\t            controller = enchantment_ref.controller\n43\t            if controller is None:\n44\t                return\n45\t            if not _is_on_battlefield(game, enchantment_ref):\n46\t                return\n47\t            for player in game.players:\n48\t                if player is controller:\n49\t                    continue\n50\t                for obj in game.get_battlefield(player).get_all():\n51\t                    if CardType.CREATURE in getattr(obj, 'card_types', set()):\n52\t                        if getattr(obj, 'summoning_sick', False):\n53\t                            obj.is_tapped = True\n54\t        effect = ContinuousEffect(source=enchantment_ref, layer=Layer.ABILITY, sublayer=None, apply=_apply, duration=DURATION_PERMANENT)\n55\t        self._effect_ref = game.effect_manager.add(effect)\n56\t\n57\t    def register_triggers(self, game: GameState) -> None:\n58\t        from engine.triggers import TriggerRegistration\n59\t        source = self\n60\t\n61\t        def _condition(game: Any, event: dict) -> bool:\n62\t            permanent = event.permanent\n63\t            if permanent is None:\n64\t                return False\n65\t            controller = source.controller\n66\t            if controller is None:\n67\t                return False\n68\t            perm_controller = getattr(permanent, 'controller', None)\n69\t            if perm_controller is controller:\n70\t                return False\n71\t            return CardType.CREATURE in getattr(permanent, 'card_types', set())\n72\t\n73\t        def _effect(game: GameState) -> None:\n74\t            controller = source.controller\n75\t            if controller is None:\n76\t                return\n77\t            if hasattr(controller, 'life'):\n78\t                controller.life += 1\n79\t                game.trigger_manager.fire_event(game, GainsLifeTriggeredEvent(player=controller, amount=1))\n80\t        controller = getattr(self, 'controller', None) or game.active_player\n81\t        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=controller))\n82\t\n83\t    def register_replacement_effects(self, game: GameState) -> None:\n84\t        if self._effect_ref is None:\n85\t            self._register_effect(game)\n86\t"}]},"parent_tool_use_id":"toolu_011EdJhQVPPicVEUuXu1EjcT","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c","uuid":"b88a2526-2274-42d0-9165-061750f21148","timestamp":"2026-05-28T07:36:48.004Z","subagent_type":"Reviewer","task_description":"Reviewer for sos_4"}
