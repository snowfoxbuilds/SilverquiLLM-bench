{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DPCiXTpLnSyX3XTyX7BNdh","type":"tool_result","content":"1\t\"\"\"Turn execution loop for the SilverquiLLM engine.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport warnings\n6\tfrom typing import TYPE_CHECKING\n7\t\n8\tif TYPE_CHECKING:\n9\t    from engine.game_state import GameState\n10\t\n11\tfrom engine.stack import priority_loop\n12\tfrom engine.types import Phase, Step, Zone\n13\t\n14\t\n15\t# Maximum hand size — players discard down to this during cleanup.\n16\tMAX_HAND_SIZE: int = 7\n17\t\n18\t\n19\t# Steps/phases where priority is given to players.\n20\t# In MTG, players do NOT receive priority during Untap and Cleanup (normally).\n21\t_NO_PRIORITY_STEPS: set[tuple[Phase, Step | None]] = {\n22\t    (Phase.BEGINNING, Step.UNTAP),\n23\t    (Phase.ENDING, Step.CLEANUP),\n24\t}\n25\t\n26\t\n27\tdef _do_untap_step(game: GameState) -> None:\n28\t    \"\"\"Perform untap step actions: untap all permanents controlled by the active player.\n29\t\n30\t    Per MTG rules, the active player untaps all permanents they control\n31\t    during their untap step. Summoning sickness is also cleared at this point.\n32\t    \"\"\"\n33\t    active = game.active_player\n34\t    bf = active.zones[Zone.BATTLEFIELD]\n35\t    for obj in bf.get_all():\n36\t        if hasattr(obj, \"is_tapped\"):\n37\t            obj.is_tapped = False\n38\t        if hasattr(obj, \"summoning_sick\"):\n39\t            obj.summoning_sick = False\n40\t\n41\t    # Reset land plays for the active player\n42\t    active.land_plays_remaining = 1\n43\t\n44\t    # Reset the cards-drawn counter for the new turn (used by miracle tracking).\n45\t    active.cards_drawn_this_turn = 0\n46\t\n47\t\n48\tdef _do_draw_step(game: GameState) -> None:\n49\t    \"\"\"Perform draw step actions: active player draws a card.\n50\t\n51\t    In a two-player game, the starting player (the player who takes\n52\t    turn 1) skips their draw step on that first turn.  This is per\n53\t    MTG comprehensive rules §103.7a.\n54\t    \"\"\"\n55\t    # The starting player skips their draw on turn 1.\n56\t    if game.turn_number == 1 and game.active_player_index == 0:\n57\t        return\n58\t\n59\t    from engine.game import draw_card\n60\t\n61\t    draw_card(game, game.active_player)\n62\t\n63\t\n64\tdef _do_combat_step(game: GameState, step: Step) -> None:\n65\t    \"\"\"Dispatch combat sub-steps to the appropriate combat functions.\n66\t\n67\t    Parameters:\n68\t        game: The current game state.\n69\t        step: The combat step to execute.\n70\t    \"\"\"\n71\t    from engine.combat import (\n72\t        combat_damage_step,\n73\t        declare_attackers_step,\n74\t        declare_blockers_step,\n75\t        end_combat_step,\n76\t    )\n77\t\n78\t    if step == Step.DECLARE_ATTACKERS:\n79\t        declare_attackers_step(game)\n80\t    elif step == Step.DECLARE_BLOCKERS:"}]},"parent_tool_use_id":"toolu_01APFPyzDJRnKVZbMCsaQmw3","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c","uuid":"dbb35d3e-8237-48cb-ab1e-3234142af372","timestamp":"2026-05-28T09:02:52.462Z","subagent_type":"Reviewer","task_description":"Reviewer for sos_257"}
