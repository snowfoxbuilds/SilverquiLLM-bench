{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JMfheyhPs6JKn5G55d1bFM","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_120/card_impl.py b/cards/sos/sos_120/card_impl.py\n2\tindex fd0c1f4..0424fba 100644\n3\t--- a/cards/sos/sos_120/card_impl.py\n4\t+++ b/cards/sos/sos_120/card_impl.py\n5\t@@ -1,16 +1,240 @@\n6\t-\"\"\"Card implementation for Improvisation Capstone.\"\"\"\n7\t+\"\"\"Card implementation for Improvisation Capstone (SOS 120).\"\"\"\n8\t \n9\t from __future__ import annotations\n10\t \n11\t-from engine.card import CardImpl\n12\t+from typing import TYPE_CHECKING, Any\n13\t \n14\t-from typing import TYPE_CHECKING\n15\t+from engine.card import Sorcery\n16\t+from engine.types import CardType, ManaCost, Phase, Zone\n17\t \n18\t if TYPE_CHECKING:\n19\t     from engine.game_state import GameState\n20\t \n21\t \n22\t-class ImprovisationCapstone(CardImpl):\n23\t-    \"\"\"TODO: Implement Improvisation Capstone.\"\"\"\n24\t+class ImprovisationCapstone(Sorcery):\n25\t+    \"\"\"Improvisation Capstone — {5}{R}{R} — Sorcery — Lesson.\n26\t \n27\t-    pass\n28\t+    Exile cards from the top of your library until you exile cards with total\n29\t+    mana value 4 or greater. You may cast any number of spells from among them\n30\t+    without paying their mana costs.\n31\t+    Paradigm (Then exile this spell. After you first resolve a spell with this\n32\t+    name, you may cast a copy of it from exile without paying its mana cost at\n33\t+    the beginning of each of your first main phases.)\n34\t+\n35\t+    SOS collector number 120.\n36\t+    \"\"\"\n37\t+\n38\t+    has_paradigm_triggered: bool = False\n39\t+\n40\t+    def __init__(self, **kwargs: Any) -> None:\n41\t+        kwargs.setdefault(\"name\", \"Improvisation Capstone\")\n42\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{5}{R}{R}\"))\n43\t+        kwargs.setdefault(\"subtypes\", {\"Lesson\"})\n44\t+        kwargs.setdefault(\n45\t+            \"rules_text\",\n46\t+            \"Exile cards from the top of your library until you exile cards \"\n47\t+            \"with total mana value 4 or greater. You may cast any number of \"\n48\t+            \"spells from among them without paying their mana costs.\\nParadigm \"\n49\t+            \"(Then exile this spell. After you first resolve a spell with this \"\n50\t+            \"name, you may cast a copy of it from exile without paying its mana \"\n51\t+            \"cost at the beginning of each of your first main phases.)\",\n52\t+        )\n53\t+        super().__init__(**kwargs)\n54\t+        # Instance-level flag so each instance tracks itself independently.\n55\t+        self.has_paradigm_triggered: bool = False\n56\t+\n57\t+    # ------------------------------------------------------------------\n58\t+    # Resolution\n59\t+    # ------------------------------------------------------------------\n60\t+\n61\t+    def on_resolve(self, game: \"GameState\") -> None:\n62\t+        \"\"\"Resolve Improvisation Capstone.\n63\t+\n64\t+        1. Exile cards from the top of the controller's library until the\n65\t+           cumulative mana value is 4 or greater.\n66\t+        2. Offer free casts of those exiled cards.\n67\t+        3. Exile this spell (Paradigm).\n68\t+        4. Register the recurring beginning-of-main-phase trigger (once).\n69\t+        5. Set has_paradigm_triggered = True.\n70\t+        \"\"\"\n71\t+        controller = self.controller\n72\t+        if controller is None:\n73\t+            return\n74\t+\n75\t+        # --- Step 1: Exile cards from library until total MV >= 4 ---\n76\t+        library = game.get_library(controller)\n77\t+        exile = game.get_exile(controller)\n78\t+        exiled_cards: list[Any] = []\n79\t+        total_mv = 0\n80\t+\n81\t+        while total_mv < 4:\n82\t+            lib_objects = library.get_all()\n83\t+            if not lib_objects:\n84\t+                break\n85\t+            # Top of library is last in the list (index -1).\n86\t+            top_card = lib_objects[-1]\n87\t+            mana_cost = getattr(top_card, \"mana_cost\", None)\n88\t+            mv = mana_cost.cmc if mana_cost is not None else 0\n89\t+\n90\t+            # Move from library to exile.\n91\t+            library.remove(top_card)\n92\t+            exile.add(top_card)\n93\t+            exiled_cards.append(top_card)\n94\t+            total_mv += mv\n95\t+\n96\t+        # --- Step 2: Offer free casts of the exiled cards ---\n97\t+        self._offer_free_casts(game, controller, exiled_cards)\n98\t+\n99\t+        # --- Step 3: Exile this spell (Paradigm) ---\n100\t+        self._exile_self(game, controller)\n101\t+\n102\t+        # --- Step 4 & 5: Register paradigm trigger (first time only) ---\n103\t+        if not self.has_paradigm_triggered:\n104\t+            self._register_paradigm_trigger(game, controller)\n105\t+        self.has_paradigm_triggered = True\n106\t+\n107\t+    # ------------------------------------------------------------------\n108\t+    # Helpers\n109\t+    # ------------------------------------------------------------------\n110\t+\n111\t+    def _offer_free_casts(\n112\t+        self,\n113\t+        game: \"GameState\",\n114\t+        controller: Any,\n115\t+        exiled_cards: list[Any],\n116\t+    ) -> None:\n117\t+        \"\"\"Offer the controller a free cast of each card in *exiled_cards*.\"\"\"\n118\t+        if not exiled_cards:\n119\t+            return\n120\t+\n121\t+        # Build a list of castable spells (non-land only).\n122\t+        castable = [\n123\t+            c for c in exiled_cards\n124\t+            if CardType.LAND not in getattr(c, \"card_types\", set())\n125\t+        ]\n126\t+        if not castable:\n127\t+            return\n128\t+\n129\t+        # The controller may cast any number — iterate until they decline.\n130\t+        remaining = list(castable)\n131\t+        while remaining:\n132\t+            # Ask if the controller wants to cast a spell.\n133\t+            try:\n134\t+                wants_to_cast = controller.choose_yes_no(\n135\t+                    \"You may cast a spell from among the exiled cards without \"\n136\t+                    \"paying its mana cost.\"\n137\t+                )\n138\t+            except Exception:\n139\t+                # Default to no when no scripted answer is available so we\n140\t+                # do not enter an infinite loop.\n141\t+                break\n142\t+\n143\t+            if not wants_to_cast:\n144\t+                break\n145\t+\n146\t+            # Ask which spell to cast.\n147\t+            try:\n148\t+                chosen = controller.choose(\n149\t+                    remaining,\n150\t+                    \"Choose a spell to cast for free from exile\",\n151\t+                )\n152\t+            except Exception:\n153\t+                chosen = remaining[0]\n154\t+\n155\t+            if chosen is None or chosen not in remaining:\n156\t+                break\n157\t+\n158\t+            remaining.remove(chosen)\n159\t+\n160\t+            # Cast the chosen spell from exile using the free-cast pipeline.\n161\t+            try:\n162\t+                from engine.casting import cast_spell_free\n163\t+                cast_spell_free(game, controller, chosen, Zone.EXILE)\n164\t+            except Exception:\n165\t+                pass\n166\t+\n167\t+    def _exile_self(self, game: \"GameState\", controller: Any) -> None:\n168\t+        \"\"\"Move this spell from wherever it is to exile (Paradigm).\"\"\"\n169\t+        owner = getattr(self, \"owner\", controller) or controller\n170\t+\n171\t+        # Search all zones for self and move to exile.\n172\t+        dest_exile = owner.zones[Zone.EXILE]\n173\t+\n174\t+        for player in game.players:\n175\t+            for zone in Zone:\n176\t+                if zone == Zone.EXILE:\n177\t+                    continue\n178\t+                try:\n179\t+                    zone_container = player.zones[zone]\n180\t+                    if zone_container.contains(self):\n181\t+                        zone_container.remove(self)\n182\t+                        dest_exile.add(self)\n183\t+                        return\n184\t+                except (KeyError, AttributeError):\n185\t+                    continue\n186\t+\n187\t+        # If the spell is already in exile or not found anywhere — no-op.\n188\t+\n189\t+    def _register_paradigm_trigger(\n190\t+        self,\n191\t+        game: \"GameState\",\n192\t+        controller: Any,\n193\t+    ) -> None:\n194\t+        \"\"\"Register the recurring beginning-of-main-phase trigger.\n195\t+\n196\t+        At the beginning of each of the controller's precombat main phases,\n197\t+        they may cast a copy of this spell from exile without paying its\n198\t+        mana cost.\n199\t+        \"\"\"\n200\t+        from engine.events import BeginningOfMainPhaseTriggeredEvent\n201\t+        from engine.triggers import TriggerRegistration\n202\t+\n203\t+        source = self\n204\t+\n205\t+        def _condition(\n206\t+            g: \"GameState\", event: BeginningOfMainPhaseTriggeredEvent\n207\t+        ) -> bool:\n208\t+            # Fire only for the controller's precombat main phase.\n209\t+            return (\n210\t+                event.active_player is controller\n211\t+                and event.phase == Phase.PRECOMBAT_MAIN\n212\t+            )\n213\t+\n214\t+        def _effect(g: \"GameState\") -> None:\n215\t+            \"\"\"Offer the controller a free cast of a copy from exile.\"\"\"\n216\t+            try:\n217\t+                wants_to_cast = controller.choose_yes_no(\n218\t+                    \"You may cast a copy of Improvisation Capstone from exile \"\n219\t+                    \"without paying its mana cost.\"\n220\t+                )\n221\t+            except Exception:\n222\t+                wants_to_cast = False\n223\t+\n224\t+            if not wants_to_cast:\n225\t+                return\n226\t+\n227\t+            # Create a copy of the spell and cast it for free.\n228\t+            copy = ImprovisationCapstone(\n229\t+                owner=controller, controller=controller\n230\t+            )\n231\t+            # The copy is placed in the controller's exile zone before casting.\n232\t+            controller.zones[Zone.EXILE].add(copy)\n233\t+            try:\n234\t+                from engine.casting import cast_spell_free\n235\t+                cast_spell_free(g, controller, copy, Zone.EXILE)\n236\t+            except Exception:\n237\t+                # If casting failed, remove the copy from exile.\n238\t+                try:\n239\t+                    controller.zones[Zone.EXILE].remove(copy)\n240\t+                except Exception:\n241\t+                    pass\n242\t+\n243\t+        game.trigger_manager.register(\n244\t+            TriggerRegistration(\n245\t+                event_type=BeginningOfMainPhaseTriggeredEvent,\n246\t+                condition=_condition,\n247\t+                effect=_effect,\n248\t+                source=source,\n249\t+                controller=controller,\n250\t+            )\n251\t+        )\n252\tdiff --git a/engine/casting.py b/engine/casting.py\n253\tindex 5d8acca..440b56f 100644\n254\t--- a/engine/casting.py\n255\t+++ b/engine/casting.py\n256\t@@ -406,8 +406,23 @@ def _resolve_spell(\n257\t         # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n258\t         move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n259\t     else:\n260\t-        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n261\t-        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n262\t+        # Instant/sorcery: check for \"exile instead of graveyard\" replacement\n263\t+        # effects registered on this specific card before routing it to\n264\t+        # its destination zone.\n265\t+        from engine.events import MoveToGraveyardReplacementEvent\n266\t+        controller = getattr(card, \"controller\", player)\n267\t+        owner = getattr(card, \"owner\", player)\n268\t+        replacement_event = MoveToGraveyardReplacementEvent(\n269\t+            destination=\"graveyard\",\n270\t+            controller=controller,\n271\t+            owner=owner,\n272\t+        )\n273\t+        # Store card reference so conditions can match on it\n274\t+        replacement_event.card_obj = card  # type: ignore[attr-defined]\n275\t+        replacement_event = game.replacement_manager.apply(game, replacement_event)\n276\t+        destination_str = getattr(replacement_event, \"destination\", \"graveyard\")\n277\t+        destination_zone = Zone.GRAVEYARD if destination_str == \"graveyard\" else Zone.EXILE\n278\t+        move_to_zone(game, card, Zone.STACK, destination_zone)\n279\t \n280\t \n281\t # ------------------------------------------------------------------\n282\tdiff --git a/run_manifest.json b/run_manifest.json\n283\tindex f6735dd..f71972e 100644\n284\t--- a/run_manifest.json\n285\t+++ b/run_manifest.json\n286\t@@ -12,4 +12,4 @@\n287\t     \"245\",\n288\t     \"257\"\n289\t   ]\n290\t-}\n291\t\\ No newline at end of file\n292\t+}\n293\t"}]},"parent_tool_use_id":"toolu_012Bcc4JYG6hJa8Trzue8gF3","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c","uuid":"8aa1a1ce-b261-46e4-b402-f7550568fc78","timestamp":"2026-05-28T08:15:41.720Z","subagent_type":"Reviewer","task_description":"Reviewer for sos_120"}
