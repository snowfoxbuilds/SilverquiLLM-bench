ules_text\",\n47\t+            \"This spell costs {1} less to cast for each instant and sorcery \"\n48\t+            \"card in your graveyard.\\nReach\\nWhenever The Dawning Archaic \"\n49\t+            \"attacks, you may cast target instant or sorcery card from your \"\n50\t+            \"graveyard without paying its mana cost. If that spell would be \"\n51\t+            \"put into your graveyard, exile it instead.\",\n52\t+        )\n53\t+        # Ensure supertypes includes LEGENDARY.\n54\t+        supertypes: set[Supertype] = (kwargs.get(\"supertypes\") or set()) | {Supertype.LEGENDARY}\n55\t+        kwargs[\"supertypes\"] = supertypes\n56\t+        super().__init__(**kwargs)\n57\t+\n58\t+    # ------------------------------------------------------------------\n59\t+    # Cost reduction\n60\t+    # ------------------------------------------------------------------\n61\t+\n62\t+    def cost_reduction(self, game: \"GameState\") -> int:\n63\t+        \"\"\"Return count of instant and sorcery cards in controller's graveyard.\"\"\"\n64\t+        controller = self.controller\n65\t+        if controller is None:\n66\t+            return 0\n67\t+        graveyard = game.get_graveyard(controller)\n68\t+        count = 0\n69\t+        for card in graveyard.get_all():\n70\t+            card_types = getattr(card, \"card_types\", set())\n71\t+            if CardType.INSTANT in card_types or CardType.SORCERY in card_types:\n72\t+                count += 1\n73\t+        return count\n74\t+\n75\t+    # ------------------------------------------------------------------\n76\t+    # Triggers\n77\t+    # ------------------------------------------------------------------\n78\t+\n79\t+    def register_triggers(self, game: \"GameState\") -> None:\n80\t+        \"\"\"Register the attack trigger for casting from graveyard.\"\"\"\n81\t+        from engine.events import AttacksTriggeredEvent\n82\t+        from engine.triggers import TriggerRegistration\n83\t+\n84\t+        source = self\n85\t+        controller = getattr(self, \"controller\", None) or game.active_player\n86\t+\n87\t+        def _condition(game: \"GameState\", event: Any) -> bool:\n88\t+            return event.creature is source or event.attacker is source\n89\t+\n90\t+        def _effect(game: \"GameState\") -> None:\n91\t+            from engine.casting import cast_spell_free\n92\t+            from engine.events import MoveToGraveyardReplacementEvent\n93\t+            from engine.replacement_effects import ReplacementEffect\n94\t+\n95\t+            ctrl = getattr(source, \"controller\", None)\n96\t+            if ctrl is None:\n97\t+                return\n98\t+            graveyard = game.get_graveyard(ctrl)\n99\t+            # Find all instants and sorceries in the graveyard.\n100\t+            candidates = [\n101\t+                c for c in graveyard.get_all()\n102\t+                if CardType.INSTANT in getattr(c, \"card_types\", set())\n103\t+                or CardType.SORCERY in getattr(c, \"card_types\", set())\n104\t+            ]\n105\t+            if not candidates:\n106\t+                return\n107\t+\n108\t+            # The cast is optional — ask the controller if they want to cast.\n109\t+            try:\n110\t+                wants_to_cast = ctrl.choose_yes_no(\n111\t+                    \"You may cast target instant or sorcery from your graveyard \"\n112\t+                    \"without paying its mana cost.\"\n113\t+                )\n114\t+            except Exception:\n115\t+                # Default to yes when no scripted answer is available.\n116\t+                wants_to_cast = True\n117\t+\n118\t+            if not wants_to_cast:\n119\t+                return\n120\t+\n121\t+            # Choose which spell to cast.\n122\t+            try:\n123\t+                chosen = ctrl.choose(\n124\t+                    candidates,\n125\t+                    \"Choose instant or sorcery to cast from graveyard\",\n126\t+                )\n127\t+            except Exception:\n128\t+                chosen = candidates[0]\n129\t+            if chosen is None:\n130\t+                return\n131\t+\n132\t+            # Register a replacement effect so that if the chosen spell would\n133\t+            # be put into the graveyard after resolving, it goes to exile instead.\n134\t+            # This satisfies the oracle text: \"If that spell would be put into\n135\t+            # your graveyard, exile it instead.\"\n136\t+            chosen_card = chosen  # close over the specific card chosen\n137\t+\n138\t+            def _exile_replacement(\n139\t+                g: \"GameState\", event: MoveToGraveyardReplacementEvent\n140\t+            ) -> MoveToGraveyardReplacementEvent:\n141\t+                event.destination = \"exile\"\n142\t+                return event\n143\t+\n144\t+            def _replacement_condition(\n145\t+                g: \"GameState\", event: MoveToGraveyardReplacementEvent\n146\t+            ) -> bool:\n147\t+                # Fire only for this specific card being moved from the stack.\n148\t+                return (\n149\t+                    getattr(event, \"card_obj\", None) is chosen_card\n150\t+                    or getattr(event, \"card\", None) is chosen_card\n151\t+                )\n152\t+\n153\t+            replacement = ReplacementEffect(\n154\t+                event_type=MoveToGraveyardReplacementEvent,\n155\t+                source=chosen_card,\n156\t+                condition=_replacement_condition,\n157\t+                replacement=_exile_replacement,\n158\t+                controller=ctrl,\n159\t+            )\n160\t+            game.replacement_manager.register(replacement)\n161\t+\n162\t+            # Cast the chosen spell using the free-cast pipeline — it goes on\n163\t+            # the stack and can be countered, responded to, and resolves normally.\n164\t+            try:\n165\t+                cast_spell_free(game, ctrl, chosen, Zone.GRAVEYARD)\n166\t+            except Exception:\n167\t+                # If casting fails (e.g. targeting failed), remove the\n168\t+                # replacement effect we just registered.\n169\t+                game.replacement_manager.unregister(chosen_card)\n170\t+\n171\t+        game.trigger_manager.register(\n172\t+            TriggerRegistration(\n173\t+                event_type=AttacksTriggeredEvent,\n174\t+                condition=_condition,\n175\t+                effect=_effect,\n176\t+                source=self,\n177\t+                controller=controller,\n178\t+            )\n179\t+        )\n180\tdiff --git a/engine/casting.py b/engine/casting.py\n181\tindex 5d8acca..440b56f 100644\n182\t--- a/engine/casting.py\n183\t+++ b/engine/casting.py\n184\t@@ -406,8 +406,23 @@ def _resolve_spell(\n185\t         # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n186\t         move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n187\t     else:\n188\t-        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n189\t-        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n190\t+        # Instant/sorcery: check for \"exile instead of graveyard\" replacement\n191\t+        # effects registered on this specific card before routing it to\n192\t+        # its destination zone.\n193\t+        from engine.events import MoveToGraveyardReplacementEvent\n194\t+        controller = getattr(card, \"controller\", player)\n195\t+        owner = getattr(card, \"owner\", player)\n196\t+        replacement_event = MoveToGraveyardReplacementEvent(\n197\t+            destination=\"graveyard\",\n198\t+            controller=controller,\n199\t+            owner=owner,\n200\t+        )\n201\t+        # Store card reference so conditions can match on it\n202\t+        replacement_event.card_obj = card  # type: ignore[attr-defined]\n203\t+        replacement_event = game.replacement_manager.apply(game, replacement_event)\n204\t+        destination_str = getattr(replacement_event, \"destination\", \"graveyard\")\n205\t+        destination_zone = Zone.GRAVEYARD if destination_str == \"graveyard\" else Zone.EXILE\n206\t+        move_to_zone(game, card, Zone.STACK, destination_zone)\n207\t \n208\t \n209\t # ------------------------------------------------------------------\n210\t"}]},"parent_tool_use_id":"toolu_01DFXXYC7K6ejGetounKEpig","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c","uuid":"eb4cd0f9-9840-4466-ac57-8d59f200a208","timestamp":"2026-05-28T07:30:46.347Z","subagent_type":"Implementer","task_description":"Implementer revision for sos_1"}
