{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E2HrPdSCMoE9aovBj5u4om","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_13/card_impl.py b/cards/sos/sos_13/card_impl.py\n2\tindex 765fb45..e6f37fc 100644\n3\t--- a/cards/sos/sos_13/card_impl.py\n4\t+++ b/cards/sos/sos_13/card_impl.py\n5\t@@ -1,16 +1,160 @@\n6\t-\"\"\"Card implementation for Emeritus of Truce // Swords to Plowshares.\"\"\"\n7\t+\"\"\"Card implementation for Emeritus of Truce // Swords to Plowshares (SOS #13).\"\"\"\n8\t \n9\t from __future__ import annotations\n10\t \n11\t-from engine.card import CardImpl\n12\t+from typing import TYPE_CHECKING, Any\n13\t \n14\t-from typing import TYPE_CHECKING\n15\t+from engine.card import Creature\n16\t+from engine.events import EntersBattlefieldTriggeredEvent, GainsLifeTriggeredEvent\n17\t+from engine.types import CardType, Keyword, ManaCost, Supertype\n18\t \n19\t if TYPE_CHECKING:\n20\t     from engine.game_state import GameState\n21\t \n22\t \n23\t-class EmeritusOfTruceSwordsToPlowshares(CardImpl):\n24\t-    \"\"\"TODO: Implement Emeritus of Truce // Swords to Plowshares.\"\"\"\n25\t+class EmeritusOfTruceSwordsToPlowshares(Creature):\n26\t+    \"\"\"Emeritus of Truce // Swords to Plowshares — {1}{W}{W} — 3/3 — Legendary Creature — Cat Cleric.\n27\t \n28\t-    pass\n29\t+    When this creature enters, target player creates a 1/1 white and black\n30\t+    Inkling creature token with flying. Then if an opponent controls more\n31\t+    creatures than you, this creature becomes prepared.\n32\t+\n33\t+    (While it's prepared, you may cast a copy of its spell — Swords to\n34\t+    Plowshares: exile target creature, its controller gains life equal to\n35\t+    that creature's power. Doing so unprepares it.)\n36\t+\n37\t+    SOS collector number 13.\n38\t+    \"\"\"\n39\t+\n40\t+    def __init__(self, **kwargs: Any) -> None:\n41\t+        kwargs.setdefault(\"name\", \"Emeritus of Truce // Swords to Plowshares\")\n42\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{W}{W}\"))\n43\t+        kwargs.setdefault(\"subtypes\", {\"Cat\", \"Cleric\"})\n44\t+        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n45\t+        kwargs.setdefault(\"keywords\", Keyword(0))\n46\t+        kwargs.setdefault(\"base_power\", 3)\n47\t+        kwargs.setdefault(\"base_toughness\", 3)\n48\t+        kwargs.setdefault(\n49\t+            \"rules_text\",\n50\t+            \"When this creature enters, target player creates a 1/1 white \"\n51\t+            \"and black Inkling creature token with flying. Then if an opponent \"\n52\t+            \"controls more creatures than you, this creature becomes prepared. \"\n53\t+            \"(While it's prepared, you may cast a copy of its spell. Doing so \"\n54\t+            \"unprepares it.)\",\n55\t+        )\n56\t+        super().__init__(**kwargs)\n57\t+        # Prepared mechanic state — starts unprepared.\n58\t+        self.is_prepared: bool = False\n59\t+\n60\t+    # ------------------------------------------------------------------\n61\t+    # ETB trigger\n62\t+    # ------------------------------------------------------------------\n63\t+\n64\t+    def register_triggers(self, game: \"GameState\") -> None:\n65\t+        \"\"\"Register the enters-the-battlefield trigger.\"\"\"\n66\t+        from engine.triggers import TriggerRegistration\n67\t+\n68\t+        source = self\n69\t+\n70\t+        def _condition(game: Any, event: Any) -> bool:\n71\t+            \"\"\"Only fire when this specific permanent enters.\"\"\"\n72\t+            return event.permanent is source\n73\t+\n74\t+        def _effect(game: \"GameState\") -> None:\n75\t+            \"\"\"Create a 1/1 flying Inkling token for a target player, then\n76\t+            check if prepared condition is met.\"\"\"\n77\t+            from engine.game import create_token\n78\t+\n79\t+            ctrl = getattr(source, \"controller\", None)\n80\t+            if ctrl is None:\n81\t+                return\n82\t+\n83\t+            # Choose target player — default to controller if no script.\n84\t+            target_player = ctrl\n85\t+            try:\n86\t+                target_player = ctrl.choose(game.players, \"target player\")\n87\t+            except Exception:\n88\t+                target_player = ctrl\n89\t+\n90\t+            # Create the 1/1 white and black Inkling creature token with flying.\n91\t+            token = Creature(\n92\t+                name=\"Inkling\",\n93\t+                subtypes={\"Inkling\"},\n94\t+                keywords=Keyword.FLYING,\n95\t+                base_power=1,\n96\t+                base_toughness=1,\n97\t+            )\n98\t+            create_token(game, target_player, token)\n99\t+\n100\t+            # Check prepared condition: any opponent controls strictly more\n101\t+            # creatures than this card's controller.\n102\t+            my_creature_count = _count_creatures(game, ctrl)\n103\t+            for player in game.players:\n104\t+                if player is ctrl:\n105\t+                    continue\n106\t+                opp_count = _count_creatures(game, player)\n107\t+                if opp_count > my_creature_count:\n108\t+                    source.is_prepared = True\n109\t+                    return\n110\t+            # No opponent has more — remain unprepared.\n111\t+\n112\t+        controller = getattr(self, \"controller\", None) or game.active_player\n113\t+        game.trigger_manager.register(\n114\t+            TriggerRegistration(\n115\t+                event_type=EntersBattlefieldTriggeredEvent,\n116\t+                condition=_condition,\n117\t+                effect=_effect,\n118\t+                source=self,\n119\t+                controller=controller,\n120\t+            )\n121\t+        )\n122\t+\n123\t+    # ------------------------------------------------------------------\n124\t+    # Swords to Plowshares spell copy\n125\t+    # ------------------------------------------------------------------\n126\t+\n127\t+    def cast_prepared_spell(self, game: \"GameState\", target_creature: Any) -> None:\n128\t+        \"\"\"Cast the Swords to Plowshares copy while prepared.\n129\t+\n130\t+        If not prepared, this is a no-op.\n131\t+        If prepared:\n132\t+        - Exile the target creature from the battlefield.\n133\t+        - Its controller gains life equal to the creature's base_power.\n134\t+        - Set is_prepared = False.\n135\t+        \"\"\"\n136\t+        if not self.is_prepared:\n137\t+            return\n138\t+\n139\t+        from engine.game import exile\n140\t+\n141\t+        # Record power BEFORE exile (in case exile modifies state).\n142\t+        power = getattr(target_creature, \"base_power\", 0)\n143\t+        target_controller = getattr(target_creature, \"controller\", None)\n144\t+\n145\t+        # Exile the creature.\n146\t+        exile(game, target_creature)\n147\t+\n148\t+        # Grant life to the exiled creature's controller.\n149\t+        if target_controller is not None and power > 0:\n150\t+            target_controller.life += power\n151\t+            game.trigger_manager.fire_event(\n152\t+                game,\n153\t+                GainsLifeTriggeredEvent(player=target_controller, amount=power),\n154\t+            )\n155\t+\n156\t+        # Unprepare.\n157\t+        self.is_prepared = False\n158\t+\n159\t+\n160\t+# ---------------------------------------------------------------------------\n161\t+# Helper\n162\t+# ---------------------------------------------------------------------------\n163\t+\n164\t+def _count_creatures(game: \"GameState\", player: Any) -> int:\n165\t+    \"\"\"Return the number of creatures on the battlefield controlled by *player*.\"\"\"\n166\t+    battlefield = game.get_battlefield(player)\n167\t+    count = 0\n168\t+    for obj in battlefield.get_all():\n169\t+        if CardType.CREATURE in getattr(obj, \"card_types\", set()):\n170\t+            count += 1\n171\t+    return count\n172\t"}]},"parent_tool_use_id":"toolu_01PSL5zdmZ29bNzbJU6XaLj5","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c","uuid":"6a49d2f8-abae-4545-926a-b30c3d5559b3","timestamp":"2026-05-28T07:46:44.243Z","subagent_type":"Reviewer","task_description":"Reviewer for sos_13"}
