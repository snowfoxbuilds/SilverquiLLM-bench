{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ArxS1ERZ3caAutM7kwcBCc","type":"tool_result","content":"1\t\"\"\"Card implementation for Emeritus of Truce // Swords to Plowshares (SOS #13).\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.events import EntersBattlefieldTriggeredEvent, GainsLifeTriggeredEvent\n9\tfrom engine.types import CardType, Keyword, ManaCost, Supertype\n10\t\n11\tif TYPE_CHECKING:\n12\t    from engine.game_state import GameState\n13\t\n14\t\n15\tclass EmeritusOfTruceSwordsToPlowshares(Creature):\n16\t    \"\"\"Emeritus of Truce // Swords to Plowshares — {1}{W}{W} — 3/3 — Legendary Creature — Cat Cleric.\n17\t\n18\t    When this creature enters, target player creates a 1/1 white and black\n19\t    Inkling creature token with flying. Then if an opponent controls more\n20\t    creatures than you, this creature becomes prepared.\n21\t\n22\t    (While it's prepared, you may cast a copy of its spell — Swords to\n23\t    Plowshares: exile target creature, its controller gains life equal to\n24\t    that creature's power. Doing so unprepares it.)\n25\t\n26\t    SOS collector number 13.\n27\t    \"\"\"\n28\t\n29\t    def __init__(self, **kwargs: Any) -> None:\n30\t        kwargs.setdefault(\"name\", \"Emeritus of Truce // Swords to Plowshares\")\n31\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{W}{W}\"))\n32\t        kwargs.setdefault(\"subtypes\", {\"Cat\", \"Cleric\"})\n33\t        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n34\t        kwargs.setdefault(\"keywords\", Keyword(0))\n35\t        kwargs.setdefault(\"base_power\", 3)\n36\t        kwargs.setdefault(\"base_toughness\", 3)\n37\t        kwargs.setdefault(\n38\t            \"rules_text\",\n39\t            \"When this creature enters, target player creates a 1/1 white \"\n40\t            \"and black Inkling creature token with flying. Then if an opponent \"\n41\t            \"controls more creatures than you, this creature becomes prepared. \"\n42\t            \"(While it's prepared, you may cast a copy of its spell. Doing so \"\n43\t            \"unprepares it.)\",\n44\t        )\n45\t        super().__init__(**kwargs)\n46\t        # Prepared mechanic state — starts unprepared.\n47\t        self.is_prepared: bool = False\n48\t\n49\t    # ------------------------------------------------------------------\n50\t    # ETB trigger\n51\t    # ------------------------------------------------------------------\n52\t\n53\t    def register_triggers(self, game: \"GameState\") -> None:\n54\t        \"\"\"Register the enters-the-battlefield trigger.\"\"\"\n55\t        from engine.triggers import TriggerRegistration\n56\t\n57\t        source = self\n58\t\n59\t        def _condition(game: Any, event: Any) -> bool:\n60\t            \"\"\"Only fire when this specific permanent enters.\"\"\"\n61\t            return event.permanent is source\n62\t\n63\t        def _effect(game: \"GameState\") -> None:\n64\t            \"\"\"Create a 1/1 flying Inkling token for a target player, then\n65\t            check if prepared condition is met.\"\"\"\n66\t            from engine.game import create_token\n67\t\n68\t            ctrl = getattr(source, \"controller\", None)\n69\t            if ctrl is None:\n70\t                return\n71\t\n72\t            # Choose target player — default to controller if no script.\n73\t            target_player = ctrl\n74\t            try:\n75\t                target_player = ctrl.choose(game.players, \"target player\")\n76\t            except Exception:\n77\t                target_player = ctrl\n78\t\n79\t            # Create the 1/1 white and black Inkling creature token with flying.\n80\t            token = Creature(\n81\t                name=\"Inkling\",\n82\t                subtypes={\"Inkling\"},\n83\t                keywords=Keyword.FLYING,\n84\t                base_power=1,\n85\t                base_toughness=1,\n86\t            )\n87\t            create_token(game, target_player, token)\n88\t\n89\t            # Check prepared condition: any opponent controls strictly more\n90\t            # creatures than this card's controller.\n91\t            my_creature_count = _count_creatures(game, ctrl)\n92\t            for player in game.players:\n93\t                if player is ctrl:\n94\t                    continue\n95\t                opp_count = _count_creatures(game, player)\n96\t                if opp_count > my_creature_count:\n97\t                    source.is_prepared = True\n98\t                    return\n99\t            # No opponent has more — remain unprepared.\n100\t\n101\t        controller = getattr(self, \"controller\", None) or game.active_player\n102\t        game.trigger_manager.register(\n103\t            TriggerRegistration(\n104\t                event_type=EntersBattlefieldTriggeredEvent,\n105\t                condition=_condition,\n106\t                effect=_effect,\n107\t                source=self,\n108\t                controller=controller,\n109\t            )\n110\t        )\n111\t\n112\t    # ------------------------------------------------------------------\n113\t    # Swords to Plowshares spell copy\n114\t    # ------------------------------------------------------------------\n115\t\n116\t    def cast_prepared_spell(self, game: \"GameState\", target_creature: Any) -> None:\n117\t        \"\"\"Cast the Swords to Plowshares copy while prepared.\n118\t\n119\t        If not prepared, this is a no-op.\n120\t        If prepared:\n121\t        - Exile the target creature from the battlefield.\n122\t        - Its controller gains life equal to the creature's base_power.\n123\t        - Set is_prepared = False.\n124\t        \"\"\"\n125\t        if not self.is_prepared:\n126\t            return\n127\t\n128\t        from engine.game import exile\n129\t\n130\t        # Record power BEFORE exile (in case exile modifies state).\n131\t        power = getattr(target_creature, \"base_power\", 0)\n132\t        target_controller = getattr(target_creature, \"controller\", None)\n133\t\n134\t        # Exile the creature.\n135\t        exile(game, target_creature)\n136\t\n137\t        # Grant life to the exiled creature's controller.\n138\t        if target_controller is not None and power > 0:\n139\t            target_controller.life += power\n140\t            game.trigger_manager.fire_event(\n141\t                game,\n142\t                GainsLifeTriggeredEvent(player=target_controller, amount=power),\n143\t            )\n144\t\n145\t        # Unprepare.\n146\t        self.is_prepared = False\n147\t\n148\t\n149\t# ---------------------------------------------------------------------------\n150\t# Helper\n151\t# ---------------------------------------------------------------------------\n152\t\n153\tdef _count_creatures(game: \"GameState\", player: Any) -> int:\n154\t    \"\"\"Return the number of creatures on the battlefield controlled by *player*.\"\"\"\n155\t    battlefield = game.get_battlefield(player)\n156\t    count = 0\n157\t    for obj in battlefield.get_all():\n158\t        if CardType.CREATURE in getattr(obj, \"card_types\", set()):\n159\t            count += 1\n160\t    return count\n161\t"}]},"parent_tool_use_id":"toolu_01HgzLdpMVtRV8CxJEvbBeFj","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c","uuid":"2310b2b5-43a7-471d-a1cd-b8736be207d1","timestamp":"2026-05-28T07:47:45.018Z","subagent_type":"Implementer","task_description":"Implementer revision for sos_13"}
