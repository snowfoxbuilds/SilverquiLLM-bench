{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YXuiPGXhHEv5y621CkxF5u","type":"tool_result","content":"100\t    if deck2 is None:\n101\t        deck2 = []\n102\t\n103\t    script1: list[Any] = []\n104\t    script2: list[Any] = []\n105\t    if scripts is not None:\n106\t        script1, script2 = scripts\n107\t\n108\t    p1 = DeterministicPlayer(player1_name, script=script1, life=player1_life)\n109\t    p2 = DeterministicPlayer(player2_name, script=script2, life=player2_life)\n110\t\n111\t    game = _engine_create_game(p1, p2, deck1, deck2)\n112\t\n113\t    # When decks are empty (the convenience default), engine.game.create_game\n114\t    # attempts to draw 7 cards from each empty library, which sets the\n115\t    # drawn_from_empty_library loss flag.  Reset it for the convenience case.\n116\t    for player in game.players:\n117\t        if player.drawn_from_empty_library:\n118\t            player.drawn_from_empty_library = False\n119\t\n120\t    # engine.game.create_game hardcodes life=20; restore custom values.\n121\t    if player1_life != 20:\n122\t        game.players[0].life = player1_life\n123\t    if player2_life != 20:\n124\t        game.players[1].life = player2_life\n125\t\n126\t    return game\n127\t\n128\t\n129\t# ---------------------------------------------------------------------------\n130\t# set_board_state\n131\t# ---------------------------------------------------------------------------\n132\t\n133\t\n134\tdef set_board_state(\n135\t    game: GameState,\n136\t    player_index: int,\n137\t    *,\n138\t    battlefield: list[Any] | None = None,\n139\t    hand: list[Any] | None = None,\n140\t    graveyard: list[Any] | None = None,\n141\t    life: int | None = None,\n142\t    mana: dict[ManaType, int] | None = None,\n143\t) -> None:\n144\t    \"\"\"Directly set zone contents and player state for test setup.\n145\t\n146\t    Replaces the contents of the specified zones (only zones that are\n147\t    explicitly provided are modified — others are left unchanged).\n148\t\n149\t    For each card placed into a zone, ``owner`` and ``controller`` are\n150\t    set to the target player.\n151\t\n152\t    Parameters:\n153\t        game: The game state to modify.\n154\t        player_index: Index of the player (0 or 1).\n155\t        battlefield: Cards/permanents to place on the battlefield.\n156\t        hand: Cards to place in hand.\n157\t        graveyard: Cards to place in graveyard.\n158\t        life: Life total to set (or ``None`` to leave unchanged).\n159\t        mana: Mana to add to the player's pool.  Keys are\n160\t            :class:`ManaType`, values are amounts.\n161\t\n162\t    Raises:\n163\t        TestSetupError: If ``player_index`` is out of range.\n164\t    \"\"\"\n165\t    if player_index < 0 or player_index >= len(game.players):\n166\t        raise TestSetupError(\n167\t            f\"Invalid player_index {player_index} — game has \"\n168\t            f\"{len(game.players)} players (indices 0–{len(game.players) - 1})\"\n169\t        )\n170\t\n171\t    player = game.players[player_index]\n172\t\n173\t    if life is not None:\n174\t        player.life = life\n175\t\n176\t    if mana is not None:\n177\t        player.mana_pool.empty()\n178\t        for mana_type, amount in mana.items():\n179\t            player.mana_pool.add(mana_type, amount)\n180\t\n181\t    if battlefield is not None:\n182\t        _set_zone(game, player, Zone.BATTLEFIELD, battlefield)\n183\t\n184\t    if hand is not None:\n185\t        _set_zone(game, player, Zone.HAND, hand)\n186\t\n187\t    if graveyard is not None:\n188\t        _set_zone(game, player, Zone.GRAVEYARD, graveyard)\n189\t\n190\t\n191\tdef _set_zone(\n192\t    game: GameState,\n193\t    player: Any,\n194\t    zone: Zone,\n195\t    cards: list[Any],\n196\t) -> None:\n197\t    \"\"\"Replace a zone's contents with *cards*, assigning ownership.\"\"\"\n198\t    zone_container = player.zones[zone]\n199\t    # Clear existing contents\n200\t    for obj in zone_container.get_all():\n201\t        zone_container.remove(obj)\n202\t\n203\t    # Add new contents\n204\t    for card in cards:\n205\t        card.owner = player\n206\t        card.controller = player\n207\t        zone_container.add(card)\n208\t\n209\t\n210\t# ---------------------------------------------------------------------------\n211\t# cast_spell\n212\t# ---------------------------------------------------------------------------\n213\t\n214\t\n215\tdef cast_spell(\n216\t    game: GameState,\n217\t    player_index: int,\n218\t    card_name: str,\n219\t    targets: list[Any] | None = None,\n220\t) -> None:\n221\t    \"\"\"Find a card in hand by name, cast it, and pass priority until resolved.\n222\t\n223\t    The function:\n224\t    1. Locates the first card matching *card_name* in the player's hand.\n225\t    2. Sets up the game phase/priority for sorcery-speed casting if needed.\n226\t    3. Calls :func:`engine.casting.cast_spell`.\n227\t    4. Passes priority for both players so the spell resolves.\n228\t\n229\t    Parameters:\n230\t        game: The game state.\n231\t        player_index: Index of the casting player (0 or 1).\n232\t        card_name: Name of the card to find in hand.\n233\t        targets: Optional target list.  If provided, they are scripted\n234\t            into the player's DeterministicPlayer choices.\n235\t\n236\t    Raises:\n237\t        TestSetupError: If the card is not found in hand or casting fails.\n238\t    \"\"\"\n239\t    if player_index < 0 or player_index >= len(game.players):\n240\t        raise TestSetupError(\n241\t            f\"Invalid player_index {player_index} — game has \"\n242\t            f\"{len(game.players)} players\"\n243\t        )\n244\t\n245\t    player = game.players[player_index]\n246\t    hand = game.get_hand(player)\n247\t\n248\t    # Find the card by name\n249\t    card = None\n250\t    for obj in hand.get_all():\n251\t        if getattr(obj, \"name\", None) == card_name:\n252\t            card = obj\n253\t            break\n254\t\n255\t    if card is None:\n256\t        hand_names = [getattr(c, \"name\", repr(c)) for c in hand.get_all()]\n257\t        raise TestSetupError(\n258\t            f\"Card {card_name!r} not found in player {player_index}'s hand. \"\n259\t            f\"Hand contains: {hand_names}\"\n260\t        )\n261\t\n262\t    # Ensure sorcery-speed timing for non-instant spells\n263\t    from engine.types import CardType, Keyword\n264\t\n265\t    is_instant = CardType.INSTANT in getattr(card, \"card_types\", set())\n266\t    has_flash = Keyword.FLASH in getattr(card, \"keywords\", Keyword(0))\n267\t\n268\t    if not is_instant and not has_flash:\n269\t        # Set up sorcery-speed timing: active player, main phase, empty stack\n270\t        game.active_player_index = player_index\n271\t        game.priority_player_index = player_index\n272\t        if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n273\t            game.phase = Phase.PRECOMBAT_MAIN\n274\t            game.step = None\n275\t\n276\t    # Ensure the stack is empty for sorcery-speed\n277\t    if not game.stack.is_empty():\n278\t        raise TestSetupError(\n279\t            f\"Cannot cast {card_name!r} — stack is not empty\"\n280\t        )\n281\t\n282\t    # Script targets into the player's DeterministicPlayer choices so that\n283\t    # engine.casting.cast_spell -> player.choose_target() returns them.\n284\t    if targets and isinstance(player, DeterministicPlayer):\n285\t        for target in reversed(targets):\n286\t            player._script.appendleft(target)\n287\t\n288\t    try:\n289\t        _engine_cast_spell(game, player, card)\n290\t    except Exception as exc:\n291\t        raise TestSetupError(\n292\t            f\"Failed to cast {card_name!r}: {exc}\"\n293\t        ) from exc\n294\t\n295\t    # Pass priority for both players to resolve the spell\n296\t    _resolve_top_of_stack(game)\n297\t\n298\t\n299\tdef _resolve_top_of_stack(game: GameState) -> None:"}]},"parent_tool_use_id":"toolu_01RGCd9dZX3bnKjwtNkPpxgY","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c","uuid":"b7f6bfe6-378a-459c-823d-067faa040741","timestamp":"2026-05-28T08:20:38.192Z","subagent_type":"Tester","task_description":"Tester for sos_201"}
