{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Vjpgw2r1uAKY1VhPiDfYya","type":"tool_result","content":"300\t        self.is_tapped: bool = False\n301\t        self.summoning_sick: bool = True\n302\t        self.is_attacking: bool = False\n303\t        self.is_blocking: bool = False\n304\t        self.plus_one_counters: int = 0\n305\t        self.minus_one_counters: int = 0\n306\t        self.is_token: bool = False\n307\t        self.dealt_deathtouch_damage: bool = False\n308\t        self._base_plus_one_counters: int = 0\n309\t        self._base_minus_one_counters: int = 0\n310\t\n311\t    def _reset_characteristics(self) -> None:\n312\t        \"\"\"Reset creature characteristics to pre-effect values.\"\"\"\n313\t        super()._reset_characteristics()\n314\t        self.modified_power = self.base_power\n315\t        self.modified_toughness = self.base_toughness\n316\t        self.plus_one_counters = self._base_plus_one_counters\n317\t        self.minus_one_counters = self._base_minus_one_counters\n318\t        # Reset combat-restriction flags set by continuous effects (e.g. Pacifism).\n319\t        # These are reapplied by active effects during apply_all().\n320\t        self._cant_attack: bool = False\n321\t        self._cant_block: bool = False\n322\t        self._cant_be_blocked: bool = False\n323\t        self._cant_activate: bool = False\n324\t        self._max_attackers_blocked: int = 1\n325\t        # Clear granted protections so they are reapplied by active effects.\n326\t        if hasattr(self, \"protections\"):\n327\t            self.protections = []\n328\t\n329\t    @property\n330\t    def counters(self) -> dict[str, int]:\n331\t        \"\"\"Return a dict-like view of counters on this creature.\"\"\"\n332\t        result: dict[str, int] = {}\n333\t        if self.plus_one_counters > 0:\n334\t            result[\"+1/+1\"] = self.plus_one_counters\n335\t        if self.minus_one_counters > 0:\n336\t            result[\"-1/-1\"] = self.minus_one_counters\n337\t        return result\n338\t\n339\t    @property\n340\t    def power(self) -> int:\n341\t        \"\"\"Current power including counter modifications.\"\"\"\n342\t        return self.modified_power + self.plus_one_counters - self.minus_one_counters\n343\t\n344\t    @property\n345\t    def toughness(self) -> int:\n346\t        \"\"\"Current toughness including counter modifications.\"\"\"\n347\t        return self.modified_toughness + self.plus_one_counters - self.minus_one_counters\n348\t\n349\t\n350\t# ---------------------------------------------------------------------------\n351\t# Instant / Sorcery\n352\t# ---------------------------------------------------------------------------\n353\t\n354\tclass Instant(CardImpl):\n355\t    \"\"\"An instant spell — no extra fields beyond CardImpl.\"\"\"\n356\t\n357\t    def __init__(self, **kwargs: Any) -> None:\n358\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.INSTANT}\n359\t        super().__init__(**kwargs)\n360\t\n361\t\n362\tclass Sorcery(CardImpl):\n363\t    \"\"\"A sorcery spell — no extra fields beyond CardImpl.\"\"\"\n364\t\n365\t    def __init__(self, **kwargs: Any) -> None:\n366\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.SORCERY}\n367\t        super().__init__(**kwargs)\n368\t\n369\t\n370\t# ---------------------------------------------------------------------------\n371\t# Enchantment\n372\t# ---------------------------------------------------------------------------\n373\t\n374\tclass Enchantment(CardImpl):\n375\t    \"\"\"An enchantment card.\n376\t\n377\t    For auras, use the :class:`Aura` subclass which sets ``is_aura = True``.\n378\t    The base ``Enchantment`` class retains the ``attached_to`` attribute for\n379\t    backwards compatibility but marks ``is_aura = False`` so that state-based\n380\t    actions do not treat a non-aura enchantment as an unattached aura.\n381\t\n382\t    Attributes:\n383\t        attached_to: The object this enchantment is attached to (``None``\n384\t            if not an aura or not yet attached).\n385\t        is_aura: ``False`` for regular enchantments; ``True`` for auras.\n386\t    \"\"\"\n387\t\n388\t    is_aura: bool = False\n389\t\n390\t    def __init__(self, attached_to: Any | None = None, **kwargs: Any) -> None:\n391\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ENCHANTMENT}\n392\t        super().__init__(**kwargs)\n393\t        self.attached_to: Any | None = attached_to\n394\t\n395\t    def apply_continuous_effect(self, game: GameState) -> None:\n396\t        \"\"\"Apply the enchantment's continuous effect to the game.\"\"\"\n397\t\n398\t    def on_enchant(self, game: GameState) -> None:\n399\t        \"\"\"Called when this enchantment becomes attached to an object.\"\"\"\n400\t\n401\t    def on_detach(self, game: GameState) -> None:\n402\t        \"\"\"Called when this enchantment is detached from its object.\"\"\"\n403\t\n404\t\n405\tclass Aura(Enchantment):\n406\t    \"\"\"An Aura enchantment — attaches to a permanent on the battlefield.\n407\t\n408\t    Sets ``is_aura = True`` so that state-based actions correctly identify\n409\t    this as an aura (and move it to the graveyard when unattached).\n410\t\n411\t    Attributes:\n412\t        is_aura: Always ``True`` for auras.\n413\t    \"\"\"\n414\t\n415\t    is_aura: bool = True\n416\t\n417\t    def __init__(self, attached_to: Any | None = None, **kwargs: Any) -> None:\n418\t        super().__init__(attached_to=attached_to, **kwargs)\n419\t\n420\t\n421\t# ---------------------------------------------------------------------------\n422\t# Artifact / ArtifactCreature\n423\t# ---------------------------------------------------------------------------\n424\t\n425\tclass Artifact(CardImpl):\n426\t    \"\"\"An artifact card.\n427\t\n428\t    Attributes:\n429\t        is_tapped: Whether the artifact is currently tapped.\n430\t    \"\"\"\n431\t\n432\t    def __init__(self, **kwargs: Any) -> None:\n433\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ARTIFACT}\n434\t        super().__init__(**kwargs)\n435\t        self.is_tapped: bool = False\n436\t\n437\t\n438\tclass ArtifactCreature(Creature):\n439\t    \"\"\"An artifact creature — combines Artifact and Creature types.\n440\t\n441\t    Inherits creature combat stats and behaviour from :class:`Creature`.\n442\t    \"\"\"\n443\t\n444\t    def __init__(self, **kwargs: Any) -> None:\n445\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ARTIFACT, CardType.CREATURE}\n446\t        super().__init__(**kwargs)\n447\t\n448\t\n449\t# ---------------------------------------------------------------------------\n450\t# Planeswalker\n451\t# ---------------------------------------------------------------------------\n452\t\n453\tclass Planeswalker(CardImpl):\n454\t    \"\"\"A planeswalker card.\n455\t\n456\t    Attributes:\n457\t        starting_loyalty: The starting loyalty printed on the card.\n458\t        loyalty: Current loyalty counter value.\n459\t    \"\"\"\n460\t\n461\t    def __init__(\n462\t        self,\n463\t        starting_loyalty: int = 0,\n464\t        **kwargs: Any,\n465\t    ) -> None:\n466\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.PLANESWALKER}\n467\t        super().__init__(**kwargs)\n468\t        self.starting_loyalty: int = starting_loyalty\n469\t        self.loyalty: int = starting_loyalty\n470\t\n471\t    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n472\t        \"\"\"Return the planeswalker's loyalty abilities.\"\"\"\n473\t        return []\n474\t\n475\t\n476\t# ---------------------------------------------------------------------------\n477\t# Land\n478\t# ---------------------------------------------------------------------------\n479\t\n480\tclass Land(CardImpl):\n481\t    \"\"\"A land card.\n482\t\n483\t    L