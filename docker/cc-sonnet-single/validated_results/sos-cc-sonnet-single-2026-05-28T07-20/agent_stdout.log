{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Rikf92kLnPav5FuBiFFUMy","type":"tool_result","content":"1\t\"\"\"Tests for sos_257 — Great Hall of the Biblioplex.\n2\t\n3\tCovers:\n4\t  - Static card properties (name, Land type, no mana cost)\n5\t  - Tap for colorless mana (mana_ability_colorless)\n6\t  - Tap + pay 1 life for any-color mana (restricted to instant/sorcery)\n7\t  - Activation of the {5} ability that turns the land into a 2/4 Wizard\n8\t  - That the card is not a creature initially\n9\t  - After {5} activation: becomes a creature with LAND still in card_types\n10\t  - Power 2, toughness 4 when a creature\n11\t  - Wizard subtype when a creature\n12\t  - Repeated {5} activation is a no-op (already a creature)\n13\t  - Trigger: casting an instant/sorcery grants +1/+0 until end of turn to\n14\t    the creature\n15\t\"\"\"\n16\t\n17\tfrom __future__ import annotations\n18\t\n19\timport pytest\n20\t\n21\tfrom cards.sos.sos_257.card_impl import GreatHallOfTheBiblioplex\n22\tfrom engine.card import CardImpl, Creature, Instant, Land, ManaAbility\n23\tfrom engine.events import SpellCastTriggeredEvent\n24\tfrom engine.types import CardType, ManaType, ManaCost, Zone\n25\tfrom test_utils import create_game, set_board_state\n26\t\n27\t\n28\t# ---------------------------------------------------------------------------\n29\t# Static-property tests\n30\t# ---------------------------------------------------------------------------\n31\t\n32\tclass TestGreatHallProperties:\n33\t    \"\"\"Card metadata must match the sos_257 spec.\"\"\"\n34\t\n35\t    def test_name(self) -> None:\n36\t        card = GreatHallOfTheBiblioplex(owner=None)\n37\t        assert card.name == \"Great Hall of the Biblioplex\"\n38\t\n39\t    def test_is_land_subclass(self) -> None:\n40\t        card = GreatHallOfTheBiblioplex(owner=None)\n41\t        assert isinstance(card, Land)\n42\t\n43\t    def test_has_land_card_type(self) -> None:\n44\t        card = GreatHallOfTheBiblioplex(owner=None)\n45\t        assert CardType.LAND in card.card_types\n46\t\n47\t    def test_no_mana_cost(self) -> None:\n48\t        \"\"\"Lands have no mana cost — the mana_cost should equal an empty ManaCost.\"\"\"\n49\t        card = GreatHallOfTheBiblioplex(owner=None)\n50\t        assert card.mana_cost == ManaCost()\n51\t\n52\t    def test_is_not_creature_initially(self) -> None:\n53\t        \"\"\"Before any activation, the card is not a creature.\"\"\"\n54\t        card = GreatHallOfTheBiblioplex(owner=None)\n55\t        assert CardType.CREATURE not in card.card_types\n56\t\n57\t    def test_no_power_toughness_initially(self) -> None:\n58\t        \"\"\"Before creature transformation, base_power/toughness are absent or 0.\"\"\"\n59\t        card = GreatHallOfTheBiblioplex(owner=None)\n60\t        # base_power/toughness should be absent or equal to 0 (not yet a creature)\n61\t        assert not hasattr(card, \"base_power\") or card.base_power == 0\n62\t        assert not hasattr(card, \"base_toughness\") or card.base_toughness == 0\n63\t\n64\t\n65\t# ---------------------------------------------------------------------------\n66\t# Mana-ability tests\n67\t# ---------------------------------------------------------------------------\n68\t\n69\tclass TestGreatHallManaAbilities:\n70\t    \"\"\"get_mana_abilities() must return two mana abilities.\"\"\"\n71\t\n72\t    def test_returns_two_mana_abilities(self) -> None:\n73\t        card = GreatHallOfTheBiblioplex(owner=None)\n74\t        abilities = card.get_mana_abilities()\n75\t        assert len(abilities) == 2\n76\t\n77\t    def test_each_ability_is_mana_ability(self) -> None:\n78\t        card = GreatHallOfTheBiblioplex(owner=None)\n79\t        for ability in card.get_mana_abilities():\n80\t            assert isinstance(ability, ManaAbility)\n81\t\n82\t    def test_colorless_ability_adds_colorless_mana(self) -> None:\n83\t        \"\"\"First mana ability: tap for colorless ({C}).\"\"\"\n84\t        game = create_game()\n85\t        p1 = game.players[0]\n86\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n87\t        card.is_tapped = False\n88\t\n89\t        # Find and invoke the colorless mana ability\n90\t        abilities = card.get_mana_abilities()\n91\t        # The colorless ability should be identifiable by tapping the source and\n92\t        # producing COLORLESS mana.\n93\t        colorless_ability = abilities[0]\n94\t        before = p1.mana_pool.get(ManaType.COLORLESS)\n95\t        # Pay cost (tap)\n96\t        colorless_ability.cost(game, card)\n97\t        # Produce mana\n98\t        colorless_ability.mana_produced(game)\n99\t        assert p1.mana_pool.get(ManaType.COLORLESS) == before + 1\n100\t\n101\t    def test_colorless_ability_taps_source(self) -> None:\n102\t        \"\"\"Invoking the colorless mana ability taps the land.\"\"\"\n103\t        game = create_game()\n104\t        p1 = game.players[0]\n105\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n106\t        card.is_tapped = False\n107\t\n108\t        ability = card.get_mana_abilities()[0]\n109\t        ability.cost(game, card)\n110\t        assert card.is_tapped is True\n111\t\n112\t    def test_colorless_ability_fails_if_already_tapped(self) -> None:\n113\t        \"\"\"Tapping an already-tapped land fails (returns False).\"\"\"\n114\t        game = create_game()\n115\t        p1 = game.players[0]\n116\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n117\t        card.is_tapped = True\n118\t\n119\t        ability = card.get_mana_abilities()[0]\n120\t        result = ability.cost(game, card)\n121\t        assert result is False\n122\t\n123\t    def test_life_ability_pays_one_life(self) -> None:\n124\t        \"\"\"Second mana ability: {T}, pay 1 life — life total decreases by 1.\"\"\"\n125\t        game = create_game()\n126\t        p1 = game.players[0]\n127\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n128\t        card.is_tapped = False\n129\t        starting_life = p1.life\n130\t\n131\t        ability = card.get_mana_abilities()[1]\n132\t        ability.cost(game, card)\n133\t        assert p1.life == starting_life - 1\n134\t\n135\t    def test_life_ability_taps_source(self) -> None:\n136\t        \"\"\"The life-pay ability also taps the land as part of its cost.\"\"\"\n137\t        game = create_game()\n138\t        p1 = game.players[0]\n139\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n140\t        card.is_tapped = False\n141\t\n142\t        ability = card.get_mana_abilities()[1]\n143\t        ability.cost(game, card)\n144\t        assert card.is_tapped is True\n145\t\n146\t    def test_life_ability_produces_a_colored_mana(self) -> None:\n147\t        \"\"\"Second mana ability: produces mana that can be any color.\"\"\"\n148\t        game = create_game()\n149\t        p1 = game.players[0]\n150\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n151\t        card.is_tapped = False\n152\t\n153\t        before_total = p1.mana_pool.total()\n154\t        ability = card.get_mana_abilities()[1]\n155\t        ability.cost(game, card)\n156\t        ability.mana_produced(game)\n157\t        # At least one mana was added to the pool\n158\t        assert p1.mana_pool.total() > before_total\n159\t\n160\t\n161\t# ---------------------------------------------------------------------------\n162\t# Activated-ability (creature transformation) tests\n163\t# ---------------------------------------------------------------------------\n164\t\n165\tclass TestGreatHallCreatureTransformation:\n166\t    \"\"\"The {5} activated ability transforms the land into a 2/4 Wizard creature.\"\"\"\n167\t\n168\t    def test_get_activated_abilities_returns_at_least_one(self) -> None:\n169\t        card = GreatHallOfTheBiblioplex(owner=None)\n170\t        abilities = card.get_activated_abilities()\n171\t        assert len(abilities) >= 1\n172\t\n173\t    def test_activate_creature_ability_adds_creature_type(self) -> None:\n174\t        \"\"\"{5}: land becomes a 2/4 Wizard creature — CardType.CREATURE added.\"\"\"\n175\t        game = create_game()\n176\t        p1 = game.players[0]\n177\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n178\t        game.get_battlefield(p1).add(card)\n179\t        set_board_state(game, 0, mana={ManaType.COLORLESS: 5})\n180\t\n181\t        # Find the creature-transformation ability (described with \"5\" or similar)\n182\t        abilities = card.get_activated_abilities()\n183\t        assert len(abilities) >= 1\n184\t        transform_ability = abilities[0]\n185\t\n186\t        # Pay cost and apply effect\n187\t        transform_ability.cost(game, card)\n188\t        transform_ability.effect(game)\n189\t\n190\t        assert CardType.CREATURE in card.card_types\n191\t\n192\t    def test_still_a_land_after_transformation(self) -> None:\n193\t        \"\"\"After transformation the permanent still has CardType.LAND.\"\"\"\n194\t        game = create_game()\n195\t        p1 = game.players[0]\n196\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n197\t        game.get_battlefield(p1).add(card)\n198\t        set_board_state(game, 0, mana={ManaType.COLORLESS: 5})\n199\t\n200\t        abilities = card.get_activated_abilities()\n201\t        transform_ability = abilities[0]\n202\t        transform_ability.cost(game, card)\n203\t        transform_ability.effect(game)\n204\t\n205\t        assert CardType.LAND in card.card_types\n206\t\n207\t    def test_power_is_2_after_transformation(self) -> None:\n208\t        \"\"\"After transformation the creature's base power is 2.\"\"\"\n209\t        game = create_game()\n210\t        p1 = game.players[0]\n211\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n212\t        game.get_battlefield(p1).add(card)\n213\t        set_board_state(game, 0, mana={ManaType.COLORLESS: 5})\n214\t\n215\t        abilities = card.get_activated_abilities()\n216\t        transform_ability = abilities[0]\n217\t        transform_ability.cost(game, card)\n218\t        transform_ability.effect(game)\n219\t\n220\t        assert getattr(card, \"base_power\", None) == 2\n221\t\n222\t    def test_toughness_is_4_after_transformation(self) -> None:\n223\t        \"\"\"After transformation the creature's base toughness is 4.\"\"\"\n224\t        game = create_game()\n225\t        p1 = game.players[0]\n226\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n227\t        game.get_battlefield(p1).add(card)\n228\t        set_board_state(game, 0, mana={ManaType.COLORLESS: 5})\n229\t\n230\t        abilities = card.get_activated_abilities()\n231\t        transform_ability = abilities[0]\n232\t        transform_ability.cost(game, card)\n233\t        transform_ability.effect(game)\n234\t\n235\t        assert getattr(card, \"base_toughness\", None) == 4\n236\t\n237\t    def test_wizard_subtype_after_transformation(self) -> None:\n238\t        \"\"\"After transformation the card has 'Wizard' subtype.\"\"\"\n239\t        game = create_game()\n240\t        p1 = game.players[0]\n241\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n242\t        game.get_battlefield(p1).add(card)\n243\t        set_board_state(game, 0, mana={ManaType.COLORLESS: 5})\n244\t\n245\t        abilities = card.get_activated_abilities()\n246\t        transform_ability = abilities[0]\n247\t        transform_ability.cost(game, card)\n248\t        transform_ability.effect(game)\n249\t\n250\t        assert \"Wizard\" in card.subtypes\n251\t\n252\t    def test_repeated_activation_no_change(self) -> None:\n253\t        \"\"\"Activating {5} a second time when already a creature is a no-op.\"\"\"\n254\t        game = create_game()\n255\t        p1 = game.players[0]\n256\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n257\t        game.get_battlefield(p1).add(card)\n258\t        set_board_state(game, 0, mana={ManaType.COLORLESS: 5})\n259\t\n260\t        abilities = card.get_activated_abilities()\n261\t        transform_ability = abilities[0]\n262\t\n263\t        # First activation\n264\t        transform_ability.cost(game, card)\n265\t        transform_ability.effect(game)\n266\t        assert CardType.CREATURE in card.card_types\n267\t\n268\t        # Now manually refund mana and try again — it should be a no-op\n269\t        set_board_state(game, 0, mana={ManaType.COLORLESS: 5})\n270\t        transform_ability.effect(game)\n271\t        # Still a creature (and only one), not duplicated or errored\n272\t        assert CardType.CREATURE in card.card_types\n273\t        assert CardType.LAND in card.card_types\n274\t\n275\t\n276\t# ---------------------------------------------------------------------------\n277\t# Trigger tests — instant/sorcery cast grants +1/+0 while a creature\n278\t# ---------------------------------------------------------------------------\n279\t\n280\tclass TestGreatHallInstantSorceryTrigger:\n281\t    \"\"\"While a creature, casting an instant or sorcery gives +1/+0 until end of turn.\"\"\"\n282\t\n283\t    def _make_creature_hall(self, game, player):\n284\t        \"\"\"Helper: put the Hall on the battlefield and transform it.\"\"\"\n285\t        card = GreatHallOfTheBiblioplex(owner=player, controller=player)\n286\t        game.get_battlefield(player).add(card)\n287\t        abilities = card.get_activated_abilities()\n288\t        transform_ability = abilities[0]\n289\t        # Bypass cost to just invoke the effect directly\n290\t        transform_ability.effect(game)\n291\t        # Register triggers now that it is a creature\n292\t        card.register_triggers(game)\n293\t        return card\n294\t\n295\t    def test_register_triggers_does_not_raise(self) -> None:\n296\t        \"\"\"register_triggers should not raise even before transformation.\"\"\"\n297\t        game = create_game()\n298\t        p1 = game.players[0]\n299\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n300\t        card.register_triggers(game)  # should not raise\n301\t\n302\t    def test_instant_cast_triggers_power_boost(self) -> None:\n303\t        \"\"\"Casting an instant fires the trigger; power increases by 1.\"\"\"\n304\t        game = create_game()\n305\t        p1 = game.players[0]\n306\t        hall = self._make_creature_hall(game, p1)\n307\t\n308\t        # Verify it is a creature with readable power\n309\t        assert CardType.CREATURE in hall.card_types\n310\t        initial_power = getattr(hall, \"modified_power\", getattr(hall, \"base_power\", 2))\n311\t\n312\t        # Simulate casting an instant\n313\t        instant = Instant(name=\"Test Bolt\", owner=p1, controller=p1)\n314\t        instant.card_types = {CardType.INSTANT}\n315\t        event = SpellCastTriggeredEvent(spell=instant, player=p1, controller=p1)\n316\t        game.trigger_manager.fire_event(game, event)\n317\t\n318\t        # Resolve the trigger from the stack\n319\t        if game.stack.size() > 0:\n320\t            stack_obj = game.stack.peek()\n321\t            stack_obj.on_resolve(game)\n322\t            game.stack.pop()\n323\t\n324\t        after_power = getattr(hall, \"modified_power\", getattr(hall, \"base_power\", 2))\n325\t        assert after_power == initial_power + 1\n326\t\n327\t    def test_sorcery_cast_triggers_power_boost(self) -> None:\n328\t        \"\"\"Casting a sorcery also triggers the +1/+0 boost.\"\"\"\n329\t        game = create_game()\n330\t        p1 = game.players[0]\n331\t        hall = self._make_creature_hall(game, p1)\n332\t\n333\t        initial_power = getattr(hall, \"modified_power\", getattr(hall, \"base_power\", 2))\n334\t\n335\t        from engine.card import Sorcery\n336\t        sorcery = Sorcery(name=\"Test Sorcery\", owner=p1, controller=p1)\n337\t        sorcery.card_types = {CardType.SORCERY}\n338\t        event = SpellCastTriggeredEvent(spell=sorcery, player=p1, controller=p1)\n339\t        game.trigger_manager.fire_event(game, event)\n340\t\n341\t        if game.stack.size() > 0:\n342\t            stack_obj = game.stack.peek()\n343\t            stack_obj.on_resolve(game)\n344\t            game.stack.pop()\n345\t\n346\t        after_power = getattr(hall, \"modified_power\", getattr(hall, \"base_power\", 2))\n347\t        assert after_power == initial_power + 1\n348\t\n349\t    def test_non_instant_sorcery_does_not_trigger(self) -> None:\n350\t        \"\"\"Casting a creature (not an instant/sorcery) must NOT trigger the boost.\"\"\"\n351\t        game = create_game()\n352\t        p1 = game.players[0]\n353\t        hall = self._make_creature_hall(game, p1)\n354\t\n355\t        initial_power = getattr(hall, \"modified_power\", getattr(hall, \"base_power\", 2))\n356\t\n357\t        # Fire a SpellCastTriggeredEvent for a creature spell\n358\t        creature = Creature(\n359\t            name=\"Test Bear\", owner=p1, controller=p1,\n360\t            base_power=2, base_toughness=2,\n361\t        )\n362\t        creature.card_types = {CardType.CREATURE}\n363\t        event = SpellCastTriggeredEvent(spell=creature, player=p1, controller=p1)\n364\t        stack_before = game.stack.size()\n365\t        game.trigger_manager.fire_event(game, event)\n366\t\n367\t        # No trigger should have been pushed to the stack for this event\n368\t        assert game.stack.size() == stack_before\n369\t\n370\t        after_power = getattr(hall, \"modified_power\", getattr(hall, \"base_power\", 2))\n371\t        assert after_power == initial_power\n372\t\n373\t    def test_trigger_not_registered_before_transformation(self) -> None:\n374\t        \"\"\"Before becoming a creature, casting instants/sorceries must not trigger the boost.\"\"\"\n375\t        game = create_game()\n376\t        p1 = game.players[0]\n377\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n378\t        game.get_battlefield(p1).add(card)\n379\t        card.register_triggers(game)\n380\t\n381\t        # Fire an instant cast event — hall is NOT yet a creature\n382\t        instant = Instant(name=\"Test Bolt\", owner=p1, controller=p1)\n383\t        instant.card_types = {CardType.INSTANT}\n384\t        event = SpellCastTriggeredEvent(spell=instant, player=p1, controller=p1)\n385\t        stack_before = game.stack.size()\n386\t        game.trigger_manager.fire_event(game, event)\n387\t\n388\t        # No ability trigger should fire for a non-creature land\n389\t        assert game.stack.size() == stack_before\n390\t"}]},"parent_tool_use_id":"toolu_018gjm6gXoP3ttDG6nSEoCUn","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c","uuid":"346c195e-0b19-4ddd-ab76-ae6cfab3abd1","timestamp":"2026-05-28T08:59:23.691Z","subagent_type":"Implementer","task_description":"Implementer for sos_257"}
