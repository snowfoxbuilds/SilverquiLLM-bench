{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019BjrcfA1KxpXJRFcsqBELV","type":"tool_result","content":"1\t\"\"\"Card implementation for Bushwhack.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\tfrom typing import TYPE_CHECKING, Any\n5\tfrom engine.card import Creature, Instant, Mode, Sorcery\n6\tfrom engine.continuous_effects import (\n7\t    ContinuousEffect,\n8\t    DURATION_END_OF_TURN,\n9\t    Layer,\n10\t    SubLayer,\n11\t)\n12\tfrom engine.types import CardType, Keyword, ManaCost, Zone\n13\tif TYPE_CHECKING:\n14\t    from engine.game_state import GameState\n15\t\n16\t    from cards.registry import CardRegistry\n17\t\n18\tdef _get_controller(card: Any) -> Any:\n19\t    \"\"\"Return the controller of a card, or None.\"\"\"\n20\t    return getattr(card, \"controller\", None)\n21\tdef _get_target(card: Any) -> Any:\n22\t    \"\"\"Return the first chosen target or the _resolve_target fallback.\"\"\"\n23\t    chosen = getattr(card, \"chosen_targets\", None)\n24\t    if chosen:\n25\t        return chosen[0]\n26\t    return getattr(card, \"_resolve_target\", None)\n27\tdef _get_targets(card: Any) -> list[Any]:\n28\t    \"\"\"Return chosen targets list.\"\"\"\n29\t    return getattr(card, \"chosen_targets\", []) or []\n30\t\n31\tclass Bushwhack(Sorcery):\n32\t    \"\"\"Bushwhack — {G} — Choose one.\n33\t\n34\t    - Search your library for a basic land card, reveal it, put it into\n35\t      your hand, then shuffle.\n36\t    - Target creature you control fights target creature you don't control.\n37\t\n38\t    FDN collector number 215.\n39\t    \"\"\"\n40\t\n41\t    def __init__(self, **kwargs: Any) -> None:\n42\t        kwargs.setdefault(\"name\", \"Bushwhack\")\n43\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{G}\"))\n44\t        kwargs.setdefault(\n45\t            \"rules_text\",\n46\t            \"Choose one —\\n\"\n47\t            \"• Search your library for a basic land card, reveal it, put it into your hand, then shuffle.\\n\"\n48\t            \"• Target creature you control fights target creature you don't control.\",\n49\t        )\n50\t        super().__init__(**kwargs)\n51\t        self.chosen_mode: int | None = None\n52\t\n53\t    def get_modes(self) -> list[Mode]:\n54\t        return [\n55\t            Mode(name=\"Land Search\", description=\"Search your library for a basic land card, reveal it, put it into your hand, then shuffle.\"),\n56\t            Mode(name=\"Fight\", description=\"Target creature you control fights target creature you don't control.\"),\n57\t        ]\n58\t\n59\t    def on_resolve(self, game: GameState) -> None:\n60\t        mode = self.chosen_mode\n61\t        if mode is None:\n62\t            return\n63\t        controller = _get_controller(self)\n64\t        if controller is None:\n65\t            return\n66\t        if mode == 0:\n67\t            # Search library for a basic land.\n68\t            from engine.types import Supertype\n69\t            library = controller.zones[Zone.LIBRARY]\n70\t            found = False\n71\t            for card in library.get_all():\n72\t                if (CardType.LAND in getattr(card, \"card_types\", set())\n73\t                        and Supertype.BASIC in getattr(card, \"supertypes\", set())):\n74\t                    library.remove(card)\n75\t                    controller.zones[Zone.HAND].add(card)\n76\t                    found = True\n77\t                    break\n78\t            library.shuffle()\n79\t        elif mode == 1:\n80\t            # Fight\n81\t            from engine.game import deal_damage\n82\t            targets = _get_targets(self)\n83\t            if len(targets) >= 2:\n84\t                a, b = targets[0], targets[1]\n85\t                deal_damage(game, a, b, getattr(a, \"power\", 0))\n86\t                deal_damage(game, b, a, getattr(b, \"power\", 0))\n87\t"}]},"parent_tool_use_id":"toolu_01WCFp6ydLbtYch5PGnC6zGM","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c","uuid":"50dfcde8-90c3-490a-b566-e90837c5a145","timestamp":"2026-05-28T08:56:03.025Z","subagent_type":"Tester","task_description":"Tester for sos_257"}
