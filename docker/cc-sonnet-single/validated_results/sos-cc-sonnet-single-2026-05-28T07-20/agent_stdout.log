{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AS8P63ymgpgNUVgvGd5t8d","type":"tool_result","content":"1\t\"\"\"Card implementation for Mana Sculpt (SOS 57).\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Instant\n8\tfrom engine.types import CardType, ManaCost, ManaType, TargetRequirement, Zone\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t\n13\t\n14\tclass ManaSculpt(Instant):\n15\t    \"\"\"Mana Sculpt — {1}{U}{U} — Instant.\n16\t\n17\t    Counter target spell. If you control a Wizard, add an amount of {C}\n18\t    equal to the mana value of the countered spell at the beginning of\n19\t    your next main phase.\n20\t\n21\t    SOS collector number 57.\n22\t    \"\"\"\n23\t\n24\t    def __init__(self, **kwargs: Any) -> None:\n25\t        kwargs.setdefault(\"name\", \"Mana Sculpt\")\n26\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{U}{U}\"))\n27\t        kwargs.setdefault(\n28\t            \"rules_text\",\n29\t            \"Counter target spell. If you control a Wizard, add an amount \"\n30\t            \"of {C} equal to the mana value of the countered spell at the \"\n31\t            \"beginning of your next main phase.\",\n32\t        )\n33\t        super().__init__(**kwargs)\n34\t\n35\t    # ------------------------------------------------------------------\n36\t    # Targeting\n37\t    # ------------------------------------------------------------------\n38\t\n39\t    def get_targets(self, game: \"GameState\") -> list[Any]:\n40\t        \"\"\"Return a single targeting requirement: a spell on the stack.\"\"\"\n41\t        return [\n42\t            TargetRequirement(\n43\t                filter_fn=lambda obj: True,\n44\t                description=\"target spell\",\n45\t                zone=Zone.STACK,\n46\t            )\n47\t        ]\n48\t\n49\t    # ------------------------------------------------------------------\n50\t    # Resolution\n51\t    # ------------------------------------------------------------------\n52\t\n53\t    def on_resolve(self, game: \"GameState\") -> None:\n54\t        \"\"\"Counter the target spell. If we control a Wizard, register\n55\t        a delayed trigger to add {C} equal to the countered spell's CMC\n56\t        at the beginning of our next main phase.\"\"\"\n57\t        from engine.events import BeginningOfMainPhaseTriggeredEvent\n58\t        from engine.triggers import TriggerRegistration\n59\t\n60\t        chosen_targets = getattr(self, \"chosen_targets\", [])\n61\t        if not chosen_targets:\n62\t            return\n63\t\n64\t        target = chosen_targets[0]\n65\t\n66\t        # Determine the mana value of the countered spell before removing it.\n67\t        source_card = getattr(target, \"source\", None)\n68\t        if source_card is not None:\n69\t            mana_cost = getattr(source_card, \"mana_cost\", None)\n70\t        else:\n71\t            mana_cost = None\n72\t        countered_cmc: int = mana_cost.cmc if mana_cost is not None else 0\n73\t\n74\t        # Remove the target from the stack (counter it).\n75\t        game.stack._items = [\n76\t            item for item in game.stack._items if item is not target\n77\t        ]\n78\t\n79\t        # Check if the controller controls a Wizard.\n80\t        controller = self.controller\n81\t        if controller is None:\n82\t            return\n83\t\n84\t        has_wizard = self._controller_has_wizard(game, controller)\n85\t        if not has_wizard:\n86\t            return\n87\t\n88\t        # Register a one-shot delayed trigger for the beginning of the\n89\t        # controller's next main phase.\n90\t        source = self\n91\t        cmc_to_add = countered_cmc\n92\t\n93\t        def _delayed_mana_effect(g: \"GameState\") -> None:\n94\t            if cmc_to_add > 0:\n95\t                controller.mana_pool.add(ManaType.COLORLESS, cmc_to_add)\n96\t            # Unregister this one-shot trigger after it fires.\n97\t            g.trigger_manager.unregister(source)\n98\t\n99\t        def _condition(g: \"GameState\", event: BeginningOfMainPhaseTriggeredEvent) -> bool:\n100\t            # Fire only for the controller's main phase.\n101\t            return event.active_player is controller\n102\t\n103\t        game.trigger_manager.register(\n104\t            TriggerRegistration(\n105\t                event_type=BeginningOfMainPhaseTriggeredEvent,\n106\t                condition=_condition,\n107\t                effect=_delayed_mana_effect,\n108\t                source=source,\n109\t                controller=controller,\n110\t            )\n111\t        )\n112\t\n113\t    # ------------------------------------------------------------------\n114\t    # Helpers\n115\t    # ------------------------------------------------------------------\n116\t\n117\t    @staticmethod\n118\t    def _controller_has_wizard(game: \"GameState\", controller: Any) -> bool:\n119\t        \"\"\"Return True if the controller has a Wizard on the battlefield.\"\"\"\n120\t        bf = game.get_battlefield(controller)\n121\t        for permanent in bf.get_all():\n122\t            subtypes = getattr(permanent, \"subtypes\", set())\n123\t            if \"Wizard\" in subtypes:\n124\t                return True\n125\t        return False\n126\t"}]},"parent_tool_use_id":"toolu_01LecSts4rPXvibnZHbF98B2","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c","uuid":"80abda6f-b1a6-4790-9e8d-36c02eec05ba","timestamp":"2026-05-28T08:13:22.537Z","subagent_type":"Implementer","task_description":"Implementer for sos_120"}
