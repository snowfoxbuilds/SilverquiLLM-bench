{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SByq72rbVhSQGHUUx58d4W","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_257/card_impl.py b/cards/sos/sos_257/card_impl.py\n2\tindex e5f8e2f..9fabbdf 100644\n3\t--- a/cards/sos/sos_257/card_impl.py\n4\t+++ b/cards/sos/sos_257/card_impl.py\n5\t@@ -1,16 +1,216 @@\n6\t-\"\"\"Card implementation for Great Hall of the Biblioplex.\"\"\"\n7\t+\"\"\"Card implementation for Great Hall of the Biblioplex (sos_257).\"\"\"\n8\t \n9\t from __future__ import annotations\n10\t \n11\t-from engine.card import CardImpl\n12\t+from typing import TYPE_CHECKING, Any\n13\t \n14\t-from typing import TYPE_CHECKING\n15\t+from engine.card import ActivatedAbility, Land, ManaAbility\n16\t+from engine.events import SpellCastTriggeredEvent\n17\t+from engine.triggers import TriggerRegistration\n18\t+from engine.types import CardType, ManaCost, ManaType\n19\t \n20\t if TYPE_CHECKING:\n21\t     from engine.game_state import GameState\n22\t \n23\t \n24\t-class GreatHallOfTheBiblioplex(CardImpl):\n25\t-    \"\"\"TODO: Implement Great Hall of the Biblioplex.\"\"\"\n26\t+def _tap_cost(game: Any, source: Any) -> bool:\n27\t+    \"\"\"Generic tap-cost: check untapped, then tap. Returns False if already tapped.\"\"\"\n28\t+    if getattr(source, \"is_tapped\", False):\n29\t+        return False\n30\t+    source.is_tapped = True\n31\t+    return True\n32\t \n33\t-    pass\n34\t+\n35\t+class GreatHallOfTheBiblioplex(Land):\n36\t+    \"\"\"{T}: Add {C}.\n37\t+    {T}, Pay 1 life: Add one mana of any color.\n38\t+    {5}: If this land isn't a creature, it becomes a 2/4 Wizard creature\n39\t+    with \"Whenever you cast an instant or sorcery spell, this creature gets\n40\t+    +1/+0 until end of turn.\" It's still a land.\n41\t+\n42\t+    SOS collector number 257.\n43\t+    \"\"\"\n44\t+\n45\t+    def __init__(self, **kwargs: Any) -> None:\n46\t+        kwargs.setdefault(\"name\", \"Great Hall of the Biblioplex\")\n47\t+        kwargs.setdefault(\n48\t+            \"rules_text\",\n49\t+            \"{T}: Add {C}.\\n\"\n50\t+            \"{T}, Pay 1 life: Add one mana of any color. Spend this mana only \"\n51\t+            \"to cast an instant or sorcery spell.\\n\"\n52\t+            \"{5}: If this land isn't a creature, it becomes a 2/4 Wizard \"\n53\t+            \"creature with \\\"Whenever you cast an instant or sorcery spell, this \"\n54\t+            \"creature gets +1/+0 until end of turn.\\\" It's still a land.\",\n55\t+        )\n56\t+        super().__init__(**kwargs)\n57\t+        # Creature tracking\n58\t+        self.is_creature: bool = False\n59\t+        # Power/toughness (only meaningful after creature transformation)\n60\t+        self.base_power: int = 0\n61\t+        self.base_toughness: int = 0\n62\t+        self.modified_power: int = 0\n63\t+        self.modified_toughness: int = 0\n64\t+        # Temporary power bonuses from instant/sorcery casts\n65\t+        self.power_bonus: int = 0\n66\t+        # Track whether the spell-cast trigger has been registered\n67\t+        self._trigger_registered: bool = False\n68\t+\n69\t+    # ------------------------------------------------------------------\n70\t+    # Mana abilities\n71\t+    # ------------------------------------------------------------------\n72\t+\n73\t+    def get_mana_abilities(self) -> list[ManaAbility]:\n74\t+        \"\"\"Return the two mana abilities: tap for colorless, tap + 1 life for any color.\"\"\"\n75\t+        source = self\n76\t+\n77\t+        # --- Ability 1: {T}: Add {C} ---\n78\t+        def _colorless_effect(game: Any) -> None:\n79\t+            controller = source.controller\n80\t+            if controller is not None:\n81\t+                controller.mana_pool.add(ManaType.COLORLESS, 1)\n82\t+\n83\t+        # --- Ability 2: {T}, Pay 1 life: Add one mana of any color ---\n84\t+        def _life_cost(game: Any, src: Any) -> bool:\n85\t+            \"\"\"Tap the source and pay 1 life.\"\"\"\n86\t+            if getattr(src, \"is_tapped\", False):\n87\t+                return False\n88\t+            src.is_tapped = True\n89\t+            # Pay 1 life from the controller\n90\t+            controller = getattr(src, \"controller\", None)\n91\t+            if controller is not None:\n92\t+                controller.life -= 1\n93\t+            return True\n94\t+\n95\t+        def _colored_effect(game: Any) -> None:\n96\t+            \"\"\"Produce one mana of any color (controller chooses).\"\"\"\n97\t+            controller = source.controller\n98\t+            if controller is None:\n99\t+                return\n100\t+            color_options = [\n101\t+                ManaType.WHITE,\n102\t+                ManaType.BLUE,\n103\t+                ManaType.BLACK,\n104\t+                ManaType.RED,\n105\t+                ManaType.GREEN,\n106\t+            ]\n107\t+            try:\n108\t+                chosen_color = controller.choose(color_options, \"Choose a color of mana to produce\")\n109\t+            except Exception:\n110\t+                chosen_color = ManaType.WHITE\n111\t+            controller.mana_pool.add(chosen_color, 1)\n112\t+\n113\t+        return [\n114\t+            ManaAbility(\n115\t+                cost=_tap_cost,\n116\t+                mana_produced=_colorless_effect,\n117\t+                description=\"{T}: Add {C}.\",\n118\t+            ),\n119\t+            ManaAbility(\n120\t+                cost=_life_cost,\n121\t+                mana_produced=_colored_effect,\n122\t+                description=\"{T}, Pay 1 life: Add one mana of any color.\",\n123\t+            ),\n124\t+        ]\n125\t+\n126\t+    # ------------------------------------------------------------------\n127\t+    # Activated abilities\n128\t+    # ------------------------------------------------------------------\n129\t+\n130\t+    def get_activated_abilities(self) -> list[ActivatedAbility]:\n131\t+        \"\"\"Return the {5} creature-transformation ability.\"\"\"\n132\t+        source = self\n133\t+\n134\t+        def _transform_cost(game: Any, src: Any) -> bool:\n135\t+            \"\"\"Pay {5} generic mana.\"\"\"\n136\t+            controller = getattr(src, \"controller\", None)\n137\t+            if controller is None:\n138\t+                return False\n139\t+            cost = ManaCost(generic=5)\n140\t+            if not controller.mana_pool.can_pay(cost):\n141\t+                return False\n142\t+            controller.mana_pool.pay(cost)\n143\t+            return True\n144\t+\n145\t+        def _transform_effect(game: Any) -> None:\n146\t+            \"\"\"If not already a creature, become a 2/4 Wizard creature.\"\"\"\n147\t+            source.activate_creature_form(game)\n148\t+\n149\t+        return [\n150\t+            ActivatedAbility(\n151\t+                cost=_transform_cost,\n152\t+                effect=_transform_effect,\n153\t+                description=(\n154\t+                    \"{5}: If this land isn't a creature, it becomes a 2/4 Wizard \"\n155\t+                    \"creature with the instant/sorcery trigger. It's still a land.\"\n156\t+                ),\n157\t+            )\n158\t+        ]\n159\t+\n160\t+    # ------------------------------------------------------------------\n161\t+    # Creature transformation\n162\t+    # ------------------------------------------------------------------\n163\t+\n164\t+    def activate_creature_form(self, game: Any) -> None:\n165\t+        \"\"\"Transform this land into a 2/4 Wizard creature (one-time, idempotent).\"\"\"\n166\t+        if self.is_creature:\n167\t+            # Already a creature — no-op\n168\t+            return\n169\t+        self.is_creature = True\n170\t+        self.card_types.add(CardType.CREATURE)\n171\t+        self.base_power = 2\n172\t+        self.base_toughness = 4\n173\t+        self.modified_power = 2\n174\t+        self.modified_toughness = 4\n175\t+        self.subtypes.add(\"Wizard\")\n176\t+        # Register the trigger now that we're a creature\n177\t+        self._register_spell_cast_trigger(game)\n178\t+\n179\t+    # ------------------------------------------------------------------\n180\t+    # Trigger registration\n181\t+    # ------------------------------------------------------------------\n182\t+\n183\t+    def _register_spell_cast_trigger(self, game: Any) -> None:\n184\t+        \"\"\"Register the SpellCastTriggeredEvent trigger for +1/+0 until end of turn.\"\"\"\n185\t+        if self._trigger_registered:\n186\t+            return\n187\t+        source = self\n188\t+        controller = getattr(self, \"controller\", None)\n189\t+        if controller is None:\n190\t+            return\n191\t+\n192\t+        def _condition(game: Any, event: SpellCastTriggeredEvent) -> bool:\n193\t+            \"\"\"Fire only when this card is a creature and an instant/sorcery is cast.\"\"\"\n194\t+            if not source.is_creature:\n195\t+                return False\n196\t+            spell = event.spell\n197\t+            if spell is None:\n198\t+                return False\n199\t+            spell_types = getattr(spell, \"card_types\", set())\n200\t+            is_instant_or_sorcery = (\n201\t+                CardType.INSTANT in spell_types or CardType.SORCERY in spell_types\n202\t+            )\n203\t+            if not is_instant_or_sorcery:\n204\t+                return False\n205\t+            return True\n206\t+\n207\t+        def _effect(game: Any) -> None:\n208\t+            \"\"\"Grant +1/+0 until end of turn.\"\"\"\n209\t+            source.power_bonus += 1\n210\t+            source.modified_power = source.base_power + source.power_bonus\n211\t+\n212\t+        game.trigger_manager.register(\n213\t+            TriggerRegistration(\n214\t+                event_type=SpellCastTriggeredEvent,\n215\t+                condition=_condition,\n216\t+                effect=_effect,\n217\t+                source=self,\n218\t+                controller=controller,\n219\t+            )\n220\t+        )\n221\t+        self._trigger_registered = True\n222\t+\n223\t+    def register_triggers(self, game: Any) -> None:\n224\t+        \"\"\"Register triggers; only the spell-cast trigger applies, and only after creature transformation.\"\"\"\n225\t+        if self.is_creature and not self._trigger_registered:\n226\t+            self._register_spell_cast_trigger(game)\n227\t+        # If not yet a creature, do nothing — the trigger is registered on transformation\n228\t"}]},"parent_tool_use_id":"toolu_01APFPyzDJRnKVZbMCsaQmw3","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c","uuid":"024962a2-57e8-4ac0-a775-25dad60ea377","timestamp":"2026-05-28T09:02:00.974Z","subagent_type":"Reviewer","task_description":"Reviewer for sos_257"}
