{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012xSr7QFkjtr8AqXJKdsY2p","type":"tool_result","content":"1\t\"\"\"Tests for SOS 57 — Mana Sculpt.\n2\t\n3\tMana Sculpt is an Instant ({1}{U}{U}) with two effects:\n4\t1. Counter target spell.\n5\t2. If you control a Wizard, add an amount of {C} equal to the countered\n6\t   spell's mana value at the beginning of your next main phase.\n7\t\n8\tTest philosophy:\n9\t- Static properties are checked directly from the card object.\n10\t- Counterspell effect is exercised by placing a StackObject manually on\n11\t  the stack and calling on_resolve with the StackObject as the chosen target.\n12\t- The Wizard conditional is checked by examining the battlefield for Wizard\n13\t  subtypes; tests run in both the with-Wizard and without-Wizard branches.\n14\t- Mana amount tests inspect the controller's mana pool after the delayed\n15\t  effect fires, or inspect trigger registration details.\n16\t\"\"\"\n17\t\n18\tfrom __future__ import annotations\n19\t\n20\timport pytest\n21\t\n22\tfrom cards.sos.sos_57.card_impl import ManaSculpt\n23\tfrom engine.card import CardImpl, Creature, Instant\n24\tfrom engine.stack import Stack, StackObject\n25\tfrom engine.types import CardType, ManaCost, ManaType, TargetRequirement, Zone\n26\tfrom test_utils import create_game, set_board_state\n27\t\n28\t\n29\t# ---------------------------------------------------------------------------\n30\t# Helpers\n31\t# ---------------------------------------------------------------------------\n32\t\n33\tdef _make_wizard(game, player, name: str = \"Test Wizard\") -> Creature:\n34\t    \"\"\"Return a tapped-in Wizard creature in player's battlefield.\"\"\"\n35\t    wizard = Creature(\n36\t        name=name,\n37\t        owner=player,\n38\t        controller=player,\n39\t        base_power=1,\n40\t        base_toughness=1,\n41\t    )\n42\t    wizard.subtypes = {\"Wizard\"}\n43\t    game.get_battlefield(player).add(wizard)\n44\t    return wizard\n45\t\n46\t\n47\tdef _make_stack_spell(player, mana_cost_str: str, name: str = \"Target Spell\") -> StackObject:\n48\t    \"\"\"Return a StackObject on the stack representing a target spell.\"\"\"\n49\t    source_card = CardImpl(\n50\t        name=name,\n51\t        mana_cost=ManaCost.parse(mana_cost_str),\n52\t        card_types={CardType.INSTANT},\n53\t        owner=player,\n54\t        controller=player,\n55\t    )\n56\t    return StackObject(\n57\t        source=source_card,\n58\t        controller=player,\n59\t        on_resolve=lambda _game: None,\n60\t    )\n61\t\n62\t\n63\t# ---------------------------------------------------------------------------\n64\t# Static properties\n65\t# ---------------------------------------------------------------------------\n66\t\n67\tclass TestManaSculptProperties:\n68\t    \"\"\"Static card data must match the SOS 57 spec.\"\"\"\n69\t\n70\t    def test_name(self) -> None:\n71\t        card = ManaSculpt(owner=None)\n72\t        assert card.name == \"Mana Sculpt\"\n73\t\n74\t    def test_is_instant(self) -> None:\n75\t        card = ManaSculpt(owner=None)\n76\t        assert isinstance(card, Instant)\n77\t\n78\t    def test_has_instant_card_type(self) -> None:\n79\t        card = ManaSculpt(owner=None)\n80\t        assert CardType.INSTANT in card.card_types\n81\t\n82\t    def test_mana_cost(self) -> None:\n83\t        card = ManaSculpt(owner=None)\n84\t        assert card.mana_cost == ManaCost.parse(\"{1}{U}{U}\")\n85\t\n86\t    def test_mana_cost_cmc(self) -> None:\n87\t        card = ManaSculpt(owner=None)\n88\t        assert card.mana_cost.cmc == 3\n89\t\n90\t\n91\t# ---------------------------------------------------------------------------\n92\t# Targeting\n93\t# ---------------------------------------------------------------------------\n94\t\n95\tclass TestManaSculptTargeting:\n96\t    \"\"\"get_targets() must declare exactly one target on the stack.\"\"\"\n97\t\n98\t    def test_returns_one_target_requirement(self) -> None:\n99\t        game = create_game()\n100\t        card = ManaSculpt(owner=None)\n101\t        reqs = card.get_targets(game)\n102\t        assert isinstance(reqs, list)\n103\t        assert len(reqs) == 1\n104\t\n105\t    def test_target_requirement_is_correct_type(self) -> None:\n106\t        game = create_game()\n107\t        card = ManaSculpt(owner=None)\n108\t        req = card.get_targets(game)[0]\n109\t        assert isinstance(req, TargetRequirement)\n110\t\n111\t    def test_target_zone_is_stack(self) -> None:\n112\t        game = create_game()\n113\t        card = ManaSculpt(owner=None)\n114\t        req = card.get_targets(game)[0]\n115\t        assert req.zone == Zone.STACK\n116\t\n117\t    def test_target_filter_accepts_stack_spell(self) -> None:\n118\t        game = create_game()\n119\t        p1 = game.players[0]\n120\t        card = ManaSculpt(owner=p1, controller=p1)\n121\t        req = card.get_targets(game)[0]\n122\t        # A spell on the stack should pass the filter.\n123\t        target_spell = _make_stack_spell(p1, \"{2}{R}\")\n124\t        game.stack.push(target_spell)\n125\t        assert req.filter_fn(target_spell) is True\n126\t\n127\t\n128\t# ---------------------------------------------------------------------------\n129\t# Counterspell effect — removes target from stack\n130\t# ---------------------------------------------------------------------------\n131\t\n132\tclass TestManaSculptCounterspell:\n133\t    \"\"\"on_resolve with a chosen target must remove that StackObject from the stack.\"\"\"\n134\t\n135\t    def test_counters_target_spell_removes_from_stack(self) -> None:\n136\t        game = create_game()\n137\t        p1 = game.players[0]\n138\t        target = _make_stack_spell(p1, \"{2}{R}\", \"Fireball\")\n139\t        game.stack.push(target)\n140\t        assert len(game.stack) == 1\n141\t\n142\t        spell = ManaSculpt(owner=p1, controller=p1)\n143\t        spell.chosen_targets = [target]\n144\t        spell.on_resolve(game)\n145\t\n146\t        assert len(game.stack) == 0\n147\t\n148\t    def test_countered_spell_no_longer_in_stack_items(self) -> None:\n149\t        game = create_game()\n150\t        p1 = game.players[0]\n151\t        target = _make_stack_spell(p1, \"{3}\", \"Giant Growth\")\n152\t        game.stack.push(target)\n153\t\n154\t        spell = ManaSculpt(owner=p1, controller=p1)\n155\t        spell.chosen_targets = [target]\n156\t        spell.on_resolve(game)\n157\t\n158\t        remaining = game.stack.objects()\n159\t        assert target not in remaining\n160\t\n161\t    def test_counters_only_target_spell_leaves_other_spells(self) -> None:\n162\t        \"\"\"Only the chosen target is removed; other stack items remain.\"\"\"\n163\t        game = create_game()\n164\t        p1 = game.players[0]\n165\t        other = _make_stack_spell(p1, \"{1}{W}\", \"Other Spell\")\n166\t        target = _make_stack_spell(p1, \"{2}{R}\", \"Fireball\")\n167\t        game.stack.push(other)\n168\t        game.stack.push(target)\n169\t\n170\t        spell = ManaSculpt(owner=p1, controller=p1)\n171\t        spell.chosen_targets = [target]\n172\t        spell.on_resolve(game)\n173\t\n174\t        remaining = game.stack.objects()\n175\t        assert target not in remaining\n176\t        assert other in remaining\n177\t\n178\t    def test_no_target_is_a_noop(self) -> None:\n179\t        \"\"\"With no chosen_targets, on_resolve must not raise.\"\"\"\n180\t        game = create_game()\n181\t        p1 = game.players[0]\n182\t        spell = ManaSculpt(owner=p1, controller=p1)\n183\t        spell.chosen_targets = []\n184\t        spell.on_resolve(game)  # Should not raise\n185\t\n186\t\n187\t# ---------------------------------------------------------------------------\n188\t# Without a Wizard — no delayed mana\n189\t# ---------------------------------------------------------------------------\n190\t\n191\tclass TestManaSculptNoWizard:\n192\t    \"\"\"Without a Wizard on the battlefield, no delayed mana trigger is registered.\"\"\"\n193\t\n194\t    def test_no_trigger_registered_without_wizard(self) -> None:\n195\t        game = create_game()\n196\t        p1 = game.players[0]\n197\t        # No Wizard on battlefield.\n198\t        target = _make_stack_spell(p1, \"{2}{R}\", \"Fireball\")\n199\t        game.stack.push(target)\n200\t\n201\t        before = len(game.trigger_manager.get_triggers())\n202\t        spell = ManaSculpt(owner=p1, controller=p1)\n203\t        spell.chosen_targets = [target]\n204\t        spell.on_resolve(game)\n205\t\n206\t        after = len(game.trigger_manager.get_triggers())\n207\t        assert after == before\n208\t\n209\t    def test_no_mana_added_without_wizard(self) -> None:\n210\t        \"\"\"No mana is added to the pool immediately on resolve without a Wizard.\"\"\"\n211\t        game = create_game()\n212\t        p1 = game.players[0]\n213\t        target = _make_stack_spell(p1, \"{2}{R}\", \"Fireball\")\n214\t        game.stack.push(target)\n215\t\n216\t        spell = ManaSculpt(owner=p1, controller=p1)\n217\t        spell.chosen_targets = [target]\n218\t        spell.on_resolve(game)\n219\t\n220\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 0\n221\t\n222\t\n223\t# ---------------------------------------------------------------------------\n224\t# With a Wizard — delayed mana trigger registered\n225\t# ---------------------------------------------------------------------------\n226\t\n227\tclass TestManaSculptWithWizard:\n228\t    \"\"\"With a Wizard on the battlefield, a delayed trigger for main-phase mana is registered.\"\"\"\n229\t\n230\t    def test_trigger_registered_when_wizard_present(self) -> None:\n231\t        game = create_game()\n232\t        p1 = game.players[0]\n233\t        _make_wizard(game, p1)\n234\t\n235\t        target = _make_stack_spell(p1, \"{2}{R}\", \"Fireball\")\n236\t        game.stack.push(target)\n237\t\n238\t        before = len(game.trigger_manager.get_triggers())\n239\t        spell = ManaSculpt(owner=p1, controller=p1)\n240\t        spell.chosen_targets = [target]\n241\t        spell.on_resolve(game)\n242\t\n243\t        after = len(game.trigger_manager.get_triggers())\n244\t        assert after > before\n245\t\n246\t    def test_trigger_registered_exactly_one_when_wizard_present(self) -> None:\n247\t        game = create_game()\n248\t        p1 = game.players[0]\n249\t        _make_wizard(game, p1)\n250\t\n251\t        target = _make_stack_spell(p1, \"{2}{R}\", \"Fireball\")\n252\t        game.stack.push(target)\n253\t\n254\t        before = len(game.trigger_manager.get_triggers())\n255\t        spell = ManaSculpt(owner=p1, controller=p1)\n256\t        spell.chosen_targets = [target]\n257\t        spell.on_resolve(game)\n258\t\n259\t        after = len(game.trigger_manager.get_triggers())\n260\t        assert after - before == 1\n261\t\n262\t    def test_trigger_is_controlled_by_caster(self) -> None:\n263\t        game = create_game()\n264\t        p1 = game.players[0]\n265\t        _make_wizard(game, p1)\n266\t\n267\t        target = _make_stack_spell(p1, \"{2}{R}\", \"Fireball\")\n268\t        game.stack.push(target)\n269\t\n270\t        spell = ManaSculpt(owner=p1, controller=p1)\n271\t        spell.chosen_targets = [target]\n272\t        spell.on_resolve(game)\n273\t\n274\t        triggers = game.trigger_manager.get_triggers()\n275\t        assert any(t.controller is p1 for t in triggers)\n276\t\n277\t    def test_no_trigger_when_opponent_has_wizard_not_controller(self) -> None:\n278\t        \"\"\"The Wizard condition checks the controller's battlefield, not the opponent's.\"\"\"\n279\t        game = create_game()\n280\t        p1 = game.players[0]\n281\t        p2 = game.players[1]\n282\t        _make_wizard(game, p2)  # opponent has Wizard, not the caster\n283\t\n284\t        target = _make_stack_spell(p1, \"{2}{R}\", \"Fireball\")\n285\t        game.stack.push(target)\n286\t\n287\t        before = len(game.trigger_manager.get_triggers())\n288\t        spell = ManaSculpt(owner=p1, controller=p1)\n289\t        spell.chosen_targets = [target]\n290\t        spell.on_resolve(game)\n291\t\n292\t        after = len(game.trigger_manager.get_triggers())\n293\t        assert after == before\n294\t\n295\t\n296\t# ---------------------------------------------------------------------------\n297\t# Mana amount equals mana value of countered spell\n298\t# ---------------------------------------------------------------------------\n299\t\n300\tclass TestManaSculptManaAmount:\n301\t    \"\"\"The amount of {C} added must equal the mana value of the countered spell.\"\"\"\n302\t\n303\t    def _resolve_and_fire(self, game, p1, countered_cmc: int, mana_cost_str: str) -> None:\n304\t        \"\"\"Helper: resolve Mana Sculpt countering a spell, then fire the delayed trigger.\"\"\"\n305\t        _make_wizard(game, p1)\n306\t        target = _make_stack_spell(p1, mana_cost_str)\n307\t        game.stack.push(target)\n308\t\n309\t        spell = ManaSculpt(owner=p1, controller=p1)\n310\t        spell.chosen_targets = [target]\n311\t        spell.on_resolve(game)\n312\t\n313\t        # The delayed trigger should now be registered.\n314\t        # Fire it by directly invoking the registered trigger's effect.\n315\t        triggers = game.trigger_manager.get_triggers()\n316\t        assert len(triggers) >= 1\n317\t        # Invoke the most recently registered trigger's effect (the delayed mana one).\n318\t        trigger = triggers[-1]\n319\t        trigger.effect(game)\n320\t\n321\t    def test_mana_added_equals_cmc_of_countered_spell_cmc3(self) -> None:\n322\t        \"\"\"Countering a 3-CMC spell with Wizard → 3 {C} added.\"\"\"\n323\t        game = create_game()\n324\t        p1 = game.players[0]\n325\t        self._resolve_and_fire(game, p1, 3, \"{2}{R}\")\n326\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 3\n327\t\n328\t    def test_mana_added_equals_cmc_of_countered_spell_cmc5(self) -> None:\n329\t        \"\"\"Countering a 5-CMC spell with Wizard → 5 {C} added.\"\"\"\n330\t        game = create_game()\n331\t        p1 = game.players[0]\n332\t        self._resolve_and_fire(game, p1, 5, \"{3}{G}{G}\")\n333\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 5\n334\t\n335\t    def test_mana_added_equals_cmc_of_countered_spell_cmc1(self) -> None:\n336\t        \"\"\"Countering a 1-CMC spell with Wizard → 1 {C} added.\"\"\"\n337\t        game = create_game()\n338\t        p1 = game.players[0]\n339\t        self._resolve_and_fire(game, p1, 1, \"{U}\")\n340\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 1\n341\t\n342\t    def test_mana_added_is_colorless_not_colored(self) -> None:\n343\t        \"\"\"The mana added must be colorless ({C}), not any colored type.\"\"\"\n344\t        game = create_game()\n345\t        p1 = game.players[0]\n346\t        self._resolve_and_fire(game, p1, 3, \"{2}{R}\")\n347\t        # Colorless pool is 3.\n348\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 3\n349\t        # No blue, white, black, red, or green mana is added.\n350\t        assert p1.mana_pool.get(ManaType.BLUE) == 0\n351\t        assert p1.mana_pool.get(ManaType.RED) == 0\n352\t        assert p1.mana_pool.get(ManaType.GREEN) == 0\n353\t        assert p1.mana_pool.get(ManaType.WHITE) == 0\n354\t        assert p1.mana_pool.get(ManaType.BLACK) == 0\n355\t\n356\t    def test_mana_amount_zero_cmc_spell(self) -> None:\n357\t        \"\"\"Countering a 0-CMC spell → 0 mana added (no {C} produced).\"\"\"\n358\t        game = create_game()\n359\t        p1 = game.players[0]\n360\t\n361\t        _make_wizard(game, p1)\n362\t        # Build a 0-CMC card manually (no standard parse for empty cost,\n363\t        # so use a ManaCost with generic=0 and no pips).\n364\t        source_card = CardImpl(\n365\t            name=\"Free Spell\",\n366\t            mana_cost=ManaCost(generic=0),\n367\t            card_types={CardType.INSTANT},\n368\t            owner=p1,\n369\t            controller=p1,\n370\t        )\n371\t        target = StackObject(\n372\t            source=source_card,\n373\t            controller=p1,\n374\t            on_resolve=lambda _game: None,\n375\t        )\n376\t        game.stack.push(target)\n377\t\n378\t        spell = ManaSculpt(owner=p1, controller=p1)\n379\t        spell.chosen_targets = [target]\n380\t        spell.on_resolve(game)\n381\t\n382\t        triggers = game.trigger_manager.get_triggers()\n383\t        assert len(triggers) >= 1\n384\t        trigger = triggers[-1]\n385\t        trigger.effect(game)\n386\t\n387\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 0\n388\t"}]},"parent_tool_use_id":"toolu_011xz6oLC5Frvp92ie79V1tq","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c","uuid":"34b02a3e-5df7-4e00-9239-eb6ddca30d20","timestamp":"2026-05-28T07:53:16.291Z","subagent_type":"Implementer","task_description":"Implementer for sos_57"}
