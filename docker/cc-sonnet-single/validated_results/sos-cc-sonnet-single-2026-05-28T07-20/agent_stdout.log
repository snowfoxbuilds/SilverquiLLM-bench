{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01B4Ngc5FptCxvucwGTxadGk","type":"tool_result","content":"1\t\"\"\"Card implementation for Great Hall of the Biblioplex (sos_257).\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import ActivatedAbility, Land, ManaAbility\n8\tfrom engine.continuous_effects import (\n9\t    ContinuousEffect,\n10\t    DURATION_END_OF_TURN,\n11\t    Layer,\n12\t    SubLayer,\n13\t)\n14\tfrom engine.events import SpellCastTriggeredEvent\n15\tfrom engine.triggers import TriggerRegistration\n16\tfrom engine.types import CardType, ManaCost, ManaType\n17\t\n18\tif TYPE_CHECKING:\n19\t    from engine.game_state import GameState\n20\t\n21\t\n22\tdef _tap_cost(game: Any, source: Any) -> bool:\n23\t    \"\"\"Generic tap-cost: check untapped, then tap. Returns False if already tapped.\"\"\"\n24\t    if getattr(source, \"is_tapped\", False):\n25\t        return False\n26\t    source.is_tapped = True\n27\t    return True\n28\t\n29\t\n30\tclass GreatHallOfTheBiblioplex(Land):\n31\t    \"\"\"{T}: Add {C}.\n32\t    {T}, Pay 1 life: Add one mana of any color.\n33\t    {5}: If this land isn't a creature, it becomes a 2/4 Wizard creature\n34\t    with \"Whenever you cast an instant or sorcery spell, this creature gets\n35\t    +1/+0 until end of turn.\" It's still a land.\n36\t\n37\t    SOS collector number 257.\n38\t    \"\"\"\n39\t\n40\t    def __init__(self, **kwargs: Any) -> None:\n41\t        kwargs.setdefault(\"name\", \"Great Hall of the Biblioplex\")\n42\t        kwargs.setdefault(\n43\t            \"rules_text\",\n44\t            \"{T}: Add {C}.\\n\"\n45\t            \"{T}, Pay 1 life: Add one mana of any color. Spend this mana only \"\n46\t            \"to cast an instant or sorcery spell.\\n\"\n47\t            \"{5}: If this land isn't a creature, it becomes a 2/4 Wizard \"\n48\t            \"creature with \\\"Whenever you cast an instant or sorcery spell, this \"\n49\t            \"creature gets +1/+0 until end of turn.\\\" It's still a land.\",\n50\t        )\n51\t        super().__init__(**kwargs)\n52\t        # Creature tracking\n53\t        self.is_creature: bool = False\n54\t        # Power/toughness (only meaningful after creature transformation)\n55\t        self.base_power: int = 0\n56\t        self.base_toughness: int = 0\n57\t        self.modified_power: int = 0\n58\t        self.modified_toughness: int = 0\n59\t        # Temporary power bonuses from instant/sorcery casts\n60\t        self.power_bonus: int = 0\n61\t        # Track whether the spell-cast trigger has been registered\n62\t        self._trigger_registered: bool = False\n63\t\n64\t    # ------------------------------------------------------------------\n65\t    # Mana abilities\n66\t    # ------------------------------------------------------------------\n67\t\n68\t    def get_mana_abilities(self) -> list[ManaAbility]:\n69\t        \"\"\"Return the two mana abilities: tap for colorless, tap + 1 life for any color.\"\"\"\n70\t        source = self\n71\t\n72\t        # --- Ability 1: {T}: Add {C} ---\n73\t        def _colorless_effect(game: Any) -> None:\n74\t            controller = source.controller\n75\t            if controller is not None:\n76\t                controller.mana_pool.add(ManaType.COLORLESS, 1)\n77\t\n78\t        # --- Ability 2: {T}, Pay 1 life: Add one mana of any color ---\n79\t        def _life_cost(game: Any, src: Any) -> bool:\n80\t            \"\"\"Tap the source and pay 1 life.\"\"\"\n81\t            if getattr(src, \"is_tapped\", False):\n82\t                return False\n83\t            src.is_tapped = True\n84\t            # Pay 1 life from the controller\n85\t            controller = getattr(src, \"controller\", None)\n86\t            if controller is not None:\n87\t                controller.life -= 1\n88\t            return True\n89\t\n90\t        def _colored_effect(game: Any) -> None:\n91\t            \"\"\"Produce one mana of any color (controller chooses).\"\"\"\n92\t            controller = source.controller\n93\t            if controller is None:\n94\t                return\n95\t            color_options = [\n96\t                ManaType.WHITE,\n97\t                ManaType.BLUE,\n98\t                ManaType.BLACK,\n99\t                ManaType.RED,\n100\t                ManaType.GREEN,\n101\t            ]\n102\t            try:\n103\t                chosen_color = controller.choose(color_options, \"Choose a color of mana to produce\")\n104\t            except Exception:\n105\t                chosen_color = ManaType.WHITE\n106\t            controller.mana_pool.add(chosen_color, 1)\n107\t\n108\t        return [\n109\t            ManaAbility(\n110\t                cost=_tap_cost,\n111\t                mana_produced=_colorless_effect,\n112\t                description=\"{T}: Add {C}.\",\n113\t            ),\n114\t            ManaAbility(\n115\t                cost=_life_cost,\n116\t                mana_produced=_colored_effect,\n117\t                description=\"{T}, Pay 1 life: Add one mana of any color.\",\n118\t            ),\n119\t        ]\n120\t\n121\t    # ------------------------------------------------------------------\n122\t    # Activated abilities\n123\t    # ------------------------------------------------------------------\n124\t\n125\t    def get_activated_abilities(self) -> list[ActivatedAbility]:\n126\t        \"\"\"Return the {5} creature-transformation ability.\"\"\"\n127\t        source = self\n128\t\n129\t        def _transform_cost(game: Any, src: Any) -> bool:\n130\t            \"\"\"Pay {5} generic mana.\"\"\"\n131\t            controller = getattr(src, \"controller\", None)\n132\t            if controller is None:\n133\t                return False\n134\t            cost = ManaCost(generic=5)\n135\t            if not controller.mana_pool.can_pay(cost):\n136\t                return False\n137\t            controller.mana_pool.pay(cost)\n138\t            return True\n139\t\n140\t        def _transform_effect(game: Any) -> None:\n141\t            \"\"\"If not already a creature, become a 2/4 Wizard creature.\"\"\"\n142\t            source.activate_creature_form(game)\n143\t\n144\t        return [\n145\t            ActivatedAbility(\n146\t                cost=_transform_cost,\n147\t                effect=_transform_effect,\n148\t                description=(\n149\t                    \"{5}: If this land isn't a creature, it becomes a 2/4 Wizard \"\n150\t                    \"creature with the instant/sorcery trigger. It's still a land.\"\n151\t                ),\n152\t            )\n153\t        ]\n154\t\n155\t    # ------------------------------------------------------------------\n156\t    # Continuous-effect reset support\n157\t    # ------------------------------------------------------------------\n158\t\n159\t    def _reset_characteristics(self) -> None:\n160\t        \"\"\"Reset mutable characteristics to their original (pre-effect) values.\n161\t\n162\t        Called by :meth:`EffectManager.apply_all` before reapplying effects.\n163\t        When in creature form, also resets modified_power/toughness to base values.\n164\t        \"\"\"\n165\t        super()._reset_characteristics()\n166\t        if self.is_creature:\n167\t            self.modified_power = self.base_power\n168\t            self.modified_toughness = self.base_toughness\n169\t\n170\t    # ------------------------------------------------------------------\n171\t    # Creature transformation\n172\t    # ------------------------------------------------------------------\n173\t\n174\t    def activate_creature_form(self, game: Any) -> None:\n175\t        \"\"\"Transform this land into a 2/4 Wizard creature (one-time, idempotent).\"\"\"\n176\t        if self.is_creature:\n177\t            # Already a creature — no-op\n178\t            return\n179\t        self.is_creature = True\n180\t        self.card_types.add(CardType.CREATURE)\n181\t        self.base_power = 2\n182\t        self.base_toughness = 4\n183\t        self.modified_power = 2\n184\t        self.modified_toughness = 4\n185\t        self.subtypes.add(\"Wizard\")\n186\t        # Register the trigger now that we're a creature\n187\t        self._register_spell_cast_trigger(game)\n188\t\n189\t    # ------------------------------------------------------------------\n190\t    # Trigger registration\n191\t    # ------------------------------------------------------------------\n192\t\n193\t    def _register_spell_cast_trigger(self, game: Any) -> None:\n194\t        \"\"\"Register the SpellCastTriggeredEvent trigger for +1/+0 until end of turn.\"\"\"\n195\t        if self._trigger_registered:\n196\t            return\n197\t        source = self\n198\t        controller = getattr(self, \"controller\", None)\n199\t        if controller is None:\n200\t            return\n201\t\n202\t        def _condition(game: Any, event: SpellCastTriggeredEvent) -> bool:\n203\t            \"\"\"Fire only when this card is a creature and an instant/sorcery is cast.\"\"\"\n204\t            if not source.is_creature:\n205\t                return False\n206\t            spell = event.spell\n207\t            if spell is None:\n208\t                return False\n209\t            spell_types = getattr(spell, \"card_types\", set())\n210\t            is_instant_or_sorcery = (\n211\t                CardType.INSTANT in spell_types or CardType.SORCERY in spell_types\n212\t            )\n213\t            if not is_instant_or_sorcery:\n214\t                return False\n215\t            return True\n216\t\n217\t        def _effect(game: Any) -> None:\n218\t            \"\"\"Grant +1/+0 until end of turn via a DURATION_END_OF_TURN continuous effect.\"\"\"\n219\t            def _apply(g: Any) -> None:\n220\t                source.modified_power += 1\n221\t\n222\t            game.effect_manager.add(\n223\t                ContinuousEffect(\n224\t                    source=source,\n225\t                    layer=Layer.POWER_TOUGHNESS,\n226\t                    sublayer=SubLayer.MODIFY_PT,\n227\t                    apply=_apply,\n228\t                    duration=DURATION_END_OF_TURN,\n229\t                )\n230\t            )\n231\t            # Immediately apply all effects so modified_power is up to date.\n232\t            game.effect_manager.apply_all(game)\n233\t\n234\t        game.trigger_manager.register(\n235\t            TriggerRegistration(\n236\t                event_type=SpellCastTriggeredEvent,\n237\t                condition=_condition,\n238\t                effect=_effect,\n239\t                source=self,\n240\t                controller=controller,\n241\t            )\n242\t        )\n243\t        self._trigger_registered = True\n244\t\n245\t    def register_triggers(self, game: Any) -> None:\n246\t        \"\"\"Register triggers; only the spell-cast trigger applies, and only after creature transformation.\"\"\"\n247\t        if self.is_creature and not self._trigger_registered:\n248\t            self._register_spell_cast_trigger(game)\n249\t        # If not yet a creature, do nothing — the trigger is registered on transformation\n250\t"}]},"parent_tool_use_id":"toolu_01G2e598QbNSk9fWuA5YScYP","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c","uuid":"9f1de37a-19ac-47cd-98e5-bb6408292105","timestamp":"2026-05-28T09:05:47.587Z","subagent_type":"Implementer","task_description":"Implementer revision for sos_257"}
