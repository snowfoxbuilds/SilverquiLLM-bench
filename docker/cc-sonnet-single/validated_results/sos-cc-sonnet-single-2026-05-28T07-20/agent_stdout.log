{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VzPBLE1gG6dTEkfZVirNMT","type":"tool_result","content":"diff --git a/cards/sos/sos_201/card_impl.py b/cards/sos/sos_201/card_impl.py\nindex 7b52d28..f19d963 100644\n--- a/cards/sos/sos_201/card_impl.py\n+++ b/cards/sos/sos_201/card_impl.py\n@@ -2,15 +2,121 @@\n \n from __future__ import annotations\n \n-from engine.card import CardImpl\n+from typing import TYPE_CHECKING, Any\n \n-from typing import TYPE_CHECKING\n+from engine.card import Creature\n+from engine.types import CardType, Keyword, ManaCost, ManaType, Supertype\n \n if TYPE_CHECKING:\n     from engine.game_state import GameState\n \n \n-class LoreholdTheHistorian(CardImpl):\n-    \"\"\"TODO: Implement Lorehold, the Historian.\"\"\"\n+class LoreholdTheHistorian(Creature):\n+    \"\"\"Lorehold, the Historian — {3}{R}{W} — Legendary Creature — Elder Dragon.\n \n-    pass\n+    Flying, haste\n+    Each instant and sorcery card in your hand has miracle {2}.\n+    At the beginning of each opponent's upkeep, you may discard a card.\n+    If you do, draw a card.\n+    \"\"\"\n+\n+    def __init__(self, **kwargs: Any) -> None:\n+        kwargs.setdefault(\"name\", \"Lorehold, the Historian\")\n+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{3}{R}{W}\"))\n+        kwargs.setdefault(\n+            \"supertypes\",\n+            {Supertype.LEGENDARY},\n+        )\n+        kwargs.setdefault(\"subtypes\", {\"Elder\", \"Dragon\"})\n+        kwargs.setdefault(\"keywords\", Keyword.FLYING | Keyword.HASTE)\n+        kwargs.setdefault(\"base_power\", 5)\n+        kwargs.setdefault(\"base_toughness\", 5)\n+        kwargs.setdefault(\n+            \"rules_text\",\n+            \"Flying, haste\\n\"\n+            \"Each instant and sorcery card in your hand has miracle {2}.\\n\"\n+            \"At the beginning of each opponent's upkeep, you may discard a card. \"\n+            \"If you do, draw a card.\",\n+        )\n+        super().__init__(**kwargs)\n+\n+    def get_miracle_cost(self, card: Any) -> ManaCost | None:\n+        \"\"\"Return the miracle cost {2} for instants and sorceries owned by controller.\n+\n+        Returns ManaCost({2}) if card is an instant or sorcery controlled by\n+        the same player as this permanent.  Returns None otherwise.\n+        \"\"\"\n+        # Only grant miracle to cards controlled/owned by our controller.\n+        ctrl = getattr(self, \"controller\", None)\n+        if ctrl is None:\n+            return None\n+        card_ctrl = getattr(card, \"controller\", None) or getattr(card, \"owner\", None)\n+        if card_ctrl is not None and ctrl is not card_ctrl:\n+            return None\n+\n+        card_types = getattr(card, \"card_types\", set())\n+        if CardType.INSTANT in card_types or CardType.SORCERY in card_types:\n+            return ManaCost.parse(\"{2}\")\n+        return None\n+\n+    def register_triggers(self, game: \"GameState\") -> None:\n+        \"\"\"Register the opponent-upkeep trigger.\"\"\"\n+        from engine.triggers import TriggerRegistration\n+        from engine.events import BeginningOfUpkeepTriggeredEvent\n+        from engine.game import draw_card, discard\n+        from engine.player import ScriptExhaustedError\n+\n+        source = self\n+        controller = getattr(self, \"controller\", None) or game.active_player\n+\n+        def _condition(game: \"GameState\", event: Any) -> bool:\n+            \"\"\"Fire only during an opponent's upkeep (not our controller's).\"\"\"\n+            ctrl = getattr(source, \"controller\", None)\n+            if ctrl is None:\n+                return False\n+            # Active player is the player whose upkeep it is.\n+            # We want to fire when it is NOT our controller's upkeep.\n+            return game.active_player is not ctrl\n+\n+        def _effect(game: \"GameState\") -> None:\n+            ctrl = getattr(source, \"controller\", None)\n+            if ctrl is None:\n+                return\n+            # May discard a card\n+            try:\n+                wants_to_discard = ctrl.choose_yes_no(\n+                    \"Lorehold, the Historian: Discard a card to draw a card?\"\n+                )\n+            except (ScriptExhaustedError, Exception):\n+                wants_to_discard = True  # default to yes if no answer scripted\n+\n+            if not wants_to_discard:\n+                return\n+\n+            # Discard a card from hand\n+            hand = game.get_hand(ctrl)\n+            hand_cards = hand.get_all()\n+            if not hand_cards:\n+                return  # nothing to discard\n+\n+            try:\n+                chosen = ctrl.choose_card(hand_cards, \"Choose a card to discard\")\n+            except (ScriptExhaustedError, Exception):\n+                chosen = hand_cards[0] if hand_cards else None\n+\n+            if chosen is None:\n+                return\n+\n+            discard(game, ctrl, chosen)\n+            # Draw a card\n+            draw_card(game, ctrl)\n+\n+        game.trigger_manager.register(\n+            TriggerRegistration(\n+                event_type=BeginningOfUpkeepTriggeredEvent,\n+                condition=_condition,\n+                effect=_effect,\n+                source=self,\n+                controller=controller,\n+            )\n+        )\ndiff --git a/engine/turn.py b/engine/turn.py\nindex 0335418..0e4d84f 100644\n--- a/engine/turn.py\n+++ b/engine/turn.py\n@@ -41,6 +41,9 @@ def _do_untap_step(game: GameState) -> None:\n     # Reset land plays for the active player\n     active.land_plays_remaining = 1\n \n+    # Reset the cards-drawn counter for the new turn (used by miracle tracking).\n+    active.cards_drawn_this_turn = 0\n+\n \n def _do_draw_step(game: GameState) -> None:\n     \"\"\"Perform draw step actions: active player draws a card.","is_error":false}]},"parent_tool_use_id":"toolu_01Cc519EKUkA8Y7CJ3yoCEZq","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c","uuid":"4428a56a-e9f4-48b9-b688-48c5c5f673fd","timestamp":"2026-05-28T08:36:01.751Z","subagent_type":"Implementer","task_description":"Implementer revision for sos_201"}
{"type":"system","subtype":"task_progress","task_id":"a25076e1e475ac07e","tool_use_id":"toolu_01Cc519EKUkA8Y7CJ3yoCEZq","description":"Writing /tmp/coordinator-run/sos_201/impl-revised-rationale.md","subagent_type":"Implementer","usage":{"total_tokens":21333,"tool_uses":11,"duration_ms":42283},"last_tool_name":"Write","uuid":"2df5cfa7-c87a-4c1b-a338-7dc6afe72e7c","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c"}
{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_01CwycQFHeu3KWHrZWmYsrBS","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012Z746PJXKQpN9rLJduaJqR","name":"Write","input":{"file_path":"/tmp/coordinator-run/sos_201/impl-revised-rationale.md","content":"# Revised Implementation Rationale for sos_201 (Lorehold, the Historian)\n\n## Strict fixes applied\n\n### Fix 1: `get_miracle_cost` controller guard (card_impl.py line ~51)\n\n**Problem:** When `self.controller` is `None`, the original guard `if ctrl is not None and ...`\nwas skipped entirely, causing the method to fall through and grant miracle to any instant/sorcery,\nincluding opponent cards.\n\n**Fix:** Added an early-return `if ctrl is None: return None` before the `card_ctrl` check.\nThen changed the remaining guard to `if card_ctrl is not None and ctrl is not card_ctrl: return None`,\nwhich correctly handles the case where the card itself has no tracked controller (e.g., a card\nin a test stub that only has `owner` set).\n\n**Rationale:** An uncontrolled permanent cannot grant abilities; returning `None` immediately\nis the correct defensive behaviour and matches MTG rules.\n\n### Fix 2: `cards_drawn_this_turn` reset in `engine/turn.py`\n\n**Problem:** The counter on `Player` was never reset between turns, meaning after turn 1 the\nmiracle check (first-card-drawn-this-turn) would never fire correctly.\n\n**Fix:** Added `active.cards_drawn_this_turn = 0` inside `_do_untap_step`, alongside the\nexisting `active.land_plays_remaining = 1` reset. The untap step is the correct MTG-rules\nlocation for per-turn resets.\n\n## Advisory items (acknowledged, not changed)\n\n- Unused `ManaType` import: left in place for now to minimise the revision diff scope;\n  can be cleaned up in a later pass.\n- Redundant `stack.size()` method: noted as advisory; no action taken in this revision.\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1839,"cache_read_input_tokens":19185,"cache_creation":{"ephemeral_5m_input_tokens":1839,"ephemeral_1h_input_tokens":0},"output_tokens":55,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01Cc519EKUkA8Y7CJ3yoCEZq","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c","uuid":"ecb65b62-6349-4634-b74c-bc6b3c6f3c1d","request_id":"req_011CbUfK67MNtsiYRVq81xDo","subagent_type":"Implementer","task_description":"Implementer revision for sos_201"}
