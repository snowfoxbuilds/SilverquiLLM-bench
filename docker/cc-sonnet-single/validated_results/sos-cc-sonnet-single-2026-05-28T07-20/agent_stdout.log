{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_01DbTSEocDW4nSe2SZ9pB6jr","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018prLFjDGKEmDk8tp2qHqpe","name":"Read","input":{"file_path":"/workspace/engine/casting.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":4045,"cache_read_input_tokens":30643,"cache_creation":{"ephemeral_5m_input_tokens":4045,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01UJKMjqL9d5KRnRnDXJ1wSL","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c","uuid":"d0016549-6982-46ed-b717-7d12fcdb79bd","request_id":"req_011CbUghodR2CMWt9EfXQjMz","subagent_type":"Reviewer","task_description":"Reviewer for sos_245"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018prLFjDGKEmDk8tp2qHqpe","type":"tool_result","content":"1\t\"\"\"Casting and resolution pipeline for spells and lands.\n2\t\n3\tProvides the full flow from casting a spell or playing a land through\n4\tresolution:\n5\t\n6\t- :func:`cast_spell` — verify timing & legality → move hand to stack →\n7\t  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n8\t- :func:`play_land` — verify land play remaining → move hand to\n9\t  battlefield → decrement ``land_plays_remaining``.\n10\t- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n11\t  helpers used by the casting pipeline.\n12\t\n13\tResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\n14\tcreated by :func:`cast_spell`:\n15\t\n16\t- Call ``card.on_resolve(game)``.\n17\t- Permanents (creature / enchantment / artifact / planeswalker) move from\n18\t  the stack to the battlefield.\n19\t- Non-permanents (instant / sorcery) move to the graveyard.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import TYPE_CHECKING, Any\n25\t\n26\tfrom engine.card import CardImpl\n27\tfrom engine.events import SpellCastTriggeredEvent\n28\tfrom engine.stack import StackObject\n29\tfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\n30\tfrom engine.zones import move_zone\n31\t\n32\tif TYPE_CHECKING:\n33\t    from engine.game_state import GameState\n34\t    from engine.player import Player\n35\t\n36\t\n37\t# Card types that represent permanents — these go to the battlefield on resolve.\n38\t_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n39\t    CardType.CREATURE,\n40\t    CardType.ENCHANTMENT,\n41\t    CardType.ARTIFACT,\n42\t    CardType.PLANESWALKER,\n43\t})\n44\t\n45\t\n46\tclass CastingError(Exception):\n47\t    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n48\t\n49\t\n50\t# ------------------------------------------------------------------\n51\t# Timing helpers\n52\t# ------------------------------------------------------------------\n53\t\n54\tdef is_sorcery_speed(game: GameState, player: Player) -> bool:\n55\t    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n56\t\n57\t    Sorcery speed requires all of:\n58\t\n59\t    * *player* is the active player.\n60\t    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n61\t      ``POSTCOMBAT_MAIN``).\n62\t    * The stack is empty.\n63\t    \"\"\"\n64\t    if player is not game.active_player:\n65\t        return False\n66\t    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n67\t        return False\n68\t    if not game.stack.is_empty():\n69\t        return False\n70\t    return True\n71\t\n72\t\n73\tdef can_cast_at_instant_speed(card: CardImpl) -> bool:\n74\t    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n75\t\n76\t    A card has instant-speed timing if it is an instant or has the\n77\t    :attr:`~engine.types.Keyword.FLASH` keyword.\n78\t    \"\"\"\n79\t    if CardType.INSTANT in card.card_types:\n80\t        return True\n81\t    if Keyword.FLASH & card.keywords:\n82\t        return True\n83\t    return False\n84\t\n85\t\n86\t# ------------------------------------------------------------------\n87\t# Cost reduction\n88\t# ------------------------------------------------------------------\n89\t\n90\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n91\t    \"\"\"Return the generic mana reduction for casting *card*.\n92\t\n93\t    Queries ``card.cost_reduction(game)`` and clamps the result so that\n94\t    the generic portion of the mana cost cannot go below 0.\n95\t\n96\t    This is a simplified single-card self-reduction model.  Full MTG\n97\t    cost-reduction interactions (Trinisphere, multiple reductions from\n98\t    different sources) are deferred.\n99\t    \"\"\"\n100\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n101\t    # casting player even when the card was never explicitly assigned one.\n102\t    prev_controller = card.controller\n103\t    card.controller = controller\n104\t    raw = card.cost_reduction(game)\n105\t    # Restore previous controller in case the caller doesn't want a\n106\t    # side-effect (get_cost_reduction is a query, not a mutation).\n107\t    card.controller = prev_controller\n108\t    generic = card.mana_cost.generic if card.mana_cost else 0\n109\t    return max(0, min(raw, generic))\n110\t\n111\t\n112\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n113\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n114\t    new_generic = max(0, cost.generic - reduction)\n115\t    return ManaCost(\n116\t        generic=new_generic,\n117\t        pips=dict(cost.pips),\n118\t        x_count=cost.x_count,\n119\t        hybrid=list(cost.hybrid),\n120\t    )\n121\t\n122\t\n123\t# ------------------------------------------------------------------\n124\t# Cast spell\n125\t# ------------------------------------------------------------------\n126\t\n127\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n128\t    \"\"\"Cast *card* from *player*'s hand.\n129\t\n130\t    Pipeline\n131\t    --------\n132\t    1. **Timing check** — instants (and cards with flash) can be cast\n133\t       whenever the player has priority; everything else requires\n134\t       sorcery-speed timing.\n135\t    2. **can_cast** — ask the card whether it can legally be cast.\n136\t    3. **Hand check** — the card must be in the player's hand.\n137\t    4. **Move hand → stack zone** — remove the card from the hand and\n138\t       place it into the player's stack zone.\n139\t    5. **Choose targets** — if the card specifies targets (via\n140\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n141\t    6. **Mana check / payment** — the player's mana pool must be able to\n142\t       pay the card's mana cost.  If payment fails, the card is rolled\n143\t       back from the stack zone to the hand.\n144\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n145\t    8. **Push StackObject** — push a :class:`StackObject` whose\n146\t       ``on_resolve`` callback handles resolution.\n147\t\n148\t    Raises:\n149\t        CastingError: If any legality check fails.\n150\t    \"\"\"\n151\t    # 1. Timing\n152\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n153\t        raise CastingError(\n154\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n155\t        )\n156\t\n157\t    # 2. can_cast\n158\t    if not card.can_cast(game):\n159\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n160\t\n161\t    # 3. Hand check\n162\t    hand = game.get_hand(player)\n163\t    if not hand.contains(card):\n164\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n165\t\n166\t    # 4. Move card from hand to stack zone\n167\t    stack_zone = player.zones[Zone.STACK]\n168\t    hand.remove(card)\n169\t    stack_zone.add(card)\n170\t\n171\t    # Clear any stale colors_spent from a prior cast before new payment.\n172\t    if hasattr(card, \"colors_spent\"):\n173\t        del card.colors_spent\n174\t\n175\t    # 5. Choose targets\n176\t    target_specs = card.get_targets(game)\n177\t    chosen_targets: list[Any] = []\n178\t    if target_specs:\n179\t        for spec in target_specs:\n180\t            target = player.choose_target(target_specs, spec)\n181\t            # Validate against filter_fn if the spec provides one\n182\t            filter_fn = getattr(spec, \"filter_fn\", None)\n183\t            if filter_fn is not None and target is not None:\n184\t                if not filter_fn(target):\n185\t                    stack_zone.remove(card)\n186\t                    hand.add(card)\n187\t                    raise CastingError(\n188\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n189\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n190\t                    )\n191\t            chosen_targets.append(target)\n192\t\n193\t    # 5b. Protection check — reject targets that have protection from this\n194\t    #     spell (the T in DEBT).\n195\t    from engine.protection import has_protection_from\n196\t\n197\t    for target in chosen_targets:\n198\t        if has_protection_from(target, card):\n199\t            # Rollback: move card from stack zone back to hand\n200\t            stack_zone.remove(card)\n201\t            hand.add(card)\n202\t            raise CastingError(\n203\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n204\t            )\n205\t\n206\t    # Targets are stored on the StackObject (not the card) and passed\n207\t    # through the resolve pipeline via on_resolve(game, targets=...).\n208\t\n209\t    # 6. Mana check / payment (rollback on failure)\n210\t    # Ensure the card knows its controller so that cost_reduction() hooks\n211\t    # (e.g. Embercleave counting attacking creatures you control) see the\n212\t    # casting player, even for cards that were added to hand without an\n213\t    # explicit controller assignment.\n214\t    if card.controller is None:\n215\t        card.controller = player\n216\t    reduction = get_cost_reduction(game, card, player)\n217\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n218\t\n219\t    if not player.mana_pool.can_pay(effective_cost):\n220\t        # Rollback: move card from stack zone back to hand\n221\t        stack_zone.remove(card)\n222\t        hand.add(card)\n223\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n224\t\n225\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n226\t    player.mana_pool.pay(effective_cost)\n227\t\n228\t    # Store colors of mana spent on the card for mechanics like Converge\n229\t    # that care about the colors used to cast the spell.\n230\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n231\t\n232\t    # 7. Call on_cast hook\n233\t    card.on_cast(game)\n234\t\n235\t    # 8. Build on_resolve callback and push StackObject\n236\t    stack_obj = StackObject(\n237\t        source=card,\n238\t        controller=player,\n239\t        targets=chosen_targets,\n240\t        on_resolve=lambda g: None,  # replaced below\n241\t    )\n242\t\n243\t    def _on_resolve(g: GameState) -> None:\n244\t        _resolve_spell(g, card, player, stack_obj)\n245\t\n246\t    stack_obj.on_resolve = _on_resolve\n247\t    game.stack.push(stack_obj)\n248\t\n249\t    # 9. Fire SpellCastTriggeredEvent so permanents can react to the cast.\n250\t    game.trigger_manager.fire_event(\n251\t        game,\n252\t        SpellCastTriggeredEvent(spell=card, player=player, card=card, controller=player),\n253\t    )\n254\t\n255\t\n256\t# ------------------------------------------------------------------\n257\t# Cast spell without paying mana cost (free-cast from any zone)\n258\t# ------------------------------------------------------------------\n259\t\n260\t\n261\tdef cast_spell_free(\n262\t    game: GameState,\n263\t    player: Player,\n264\t    card: CardImpl,\n265\t    from_zone: Zone,\n266\t) -> None:\n267\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n268\t\n269\t    This is used by effects that allow casting from zones other than hand\n270\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n271\t    or cascade.\n272\t\n273\t    Pipeline\n274\t    --------\n275\t    1. **can_cast** — ask the card whether it can legally be cast (same\n276\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n277\t    2. Move *card* from *from_zone* to the stack zone.\n278\t    3. Choose targets (if applicable) with validation and protection check.\n279\t    4. Call ``on_cast`` hook.\n280\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n281\t       resolution normally (permanents → battlefield, non-permanents →\n282\t       graveyard).\n283\t\n284\t    No timing check or mana payment is performed.  The spell goes on the\n285\t    stack and can be responded to normally (e.g. countered).\n286\t\n287\t    If targeting or other post-move checks fail, the card is rolled back\n288\t    to its source zone.\n289\t\n290\t    Parameters:\n291\t        game: The current game state.\n292\t        player: The player casting the spell.\n293\t        card: The card to cast.\n294\t        from_zone: The zone the card is currently in.\n295\t\n296\t    Raises:\n297\t        CastingError: If the card cannot be found in *from_zone* or\n298\t            legality checks fail.\n299\t    \"\"\"\n300\t    from engine.zones import move_to_zone\n301\t\n302\t    # Ensure controller is set\n303\t    card.controller = player\n304\t    if card.owner is None:\n305\t        card.owner = player\n306\t\n307\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n308\t    if not card.can_cast(game):\n309\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n310\t\n311\t    # 2. Locate card in source zone\n312\t    source_zone_container = player.zones[from_zone]\n313\t    if not source_zone_container.contains(card):\n314\t        # Try to find the card in any player's zone\n315\t        source_zone_container = None\n316\t        for p in game.players:\n317\t            z = p.zones[from_zone]\n318\t            if z.contains(card):\n319\t                source_zone_container = z\n320\t                break\n321\t\n322\t    if source_zone_container is None or not source_zone_container.contains(card):\n323\t        raise CastingError(\n324\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n325\t        )\n326\t\n327\t    # Move card from source zone to stack zone\n328\t    stack_zone = player.zones[Zone.STACK]\n329\t    source_zone_container.remove(card)\n330\t    stack_zone.add(card)\n331\t\n332\t    # 3. Choose targets (with rollback on failure)\n333\t    try:\n334\t        target_specs = card.get_targets(game)\n335\t        chosen_targets: list[Any] = []\n336\t        if target_specs:\n337\t            for spec in target_specs:\n338\t                target = player.choose_target(target_specs, spec)\n339\t                # Validate against filter_fn if the spec provides one\n340\t                filter_fn = getattr(spec, \"filter_fn\", None)\n341\t                if filter_fn is not None and target is not None:\n342\t                    if not filter_fn(target):\n343\t                        raise CastingError(\n344\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n345\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n346\t                        )\n347\t                chosen_targets.append(target)\n348\t\n349\t        # Protection check — reject targets that have protection from this spell\n350\t        from engine.protection import has_protection_from\n351\t\n352\t        for target in chosen_targets:\n353\t            if has_protection_from(target, card):\n354\t                raise CastingError(\n355\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n356\t                )\n357\t    except Exception as exc:\n358\t        # Rollback: move card from stack zone back to source zone\n359\t        stack_zone.remove(card)\n360\t        source_zone_container.add(card)\n361\t        raise CastingError(str(exc)) from exc\n362\t\n363\t    # 4. Call on_cast hook\n364\t    card.on_cast(game)\n365\t\n366\t    # 5. Build on_resolve callback and push StackObject\n367\t    stack_obj = StackObject(\n368\t        source=card,\n369\t        controller=player,\n370\t        targets=chosen_targets,\n371\t        on_resolve=lambda g: None,  # replaced below\n372\t    )\n373\t\n374\t    def _on_resolve(g: GameState) -> None:\n375\t        _resolve_spell(g, card, player, stack_obj)\n376\t\n377\t    stack_obj.on_resolve = _on_resolve\n378\t    game.stack.push(stack_obj)\n379\t\n380\t\n381\t# ------------------------------------------------------------------\n382\t# Resolution (called when the stack pops)\n383\t# ------------------------------------------------------------------\n384\t\n385\tdef _resolve_spell(\n386\t    game: GameState,\n387\t    card: CardImpl,\n388\t    player: Player,\n389\t    stack_obj: StackObject,\n390\t) -> None:\n391\t    \"\"\"Resolve *card* cast by *player*.\n392\t\n393\t    1. Call ``card.on_resolve(game, targets=targets)``.\n394\t    2. Remove the card from the stack zone.\n395\t    3. If the card is a permanent type, move it to the battlefield via\n396\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n397\t       registration and the ETB event).\n398\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n399\t    \"\"\"\n400\t    from engine.zones import move_to_zone\n401\t\n402\t    # Read targets from the StackObject — the single source of truth.\n403\t    # Set chosen_targets on the card just before resolution so that\n404\t    # _get_chosen_target helpers (which read via getattr) work.\n405\t    targets = stack_obj.targets\n406\t    if targets is not None:\n407\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n408\t\n409\t    card.on_resolve(game)\n410\t\n411\t    if card.card_types & _PERMANENT_TYPES:\n412\t        # Move from stack to battlefield via move_to_zone, which handles\n413\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n414\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n415\t    else:\n416\t        # Instant/sorcery: check for \"exile instead of graveyard\" replacement\n417\t        # effects registered on this specific card before routing it to\n418\t        # its destination zone.\n419\t        from engine.events import MoveToGraveyardReplacementEvent\n420\t        controller = getattr(card, \"controller\", player)\n421\t        owner = getattr(card, \"owner\", player)\n422\t        replacement_event = MoveToGraveyardReplacementEvent(\n423\t            destination=\"graveyard\",\n424\t            controller=controller,\n425\t            owner=owner,\n426\t        )\n427\t        # Store card reference so conditions can match on it\n428\t        replacement_event.card_obj = card  # type: ignore[attr-defined]\n429\t        replacement_event = game.replacement_manager.apply(game, replacement_event)\n430\t        destination_str = getattr(replacement_event, \"destination\", \"graveyard\")\n431\t        destination_zone = Zone.GRAVEYARD if destination_str == \"graveyard\" else Zone.EXILE\n432\t        move_to_zone(game, card, Zone.STACK, destination_zone)\n433\t\n434\t\n435\t# ------------------------------------------------------------------\n436\t# Play land (special action — does not use the stack)\n437\t# ------------------------------------------------------------------\n438\t\n439\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n440\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n441\t\n442\t    Requirements (all must hold):\n443\t\n444\t    * *land_card* has :attr:`CardType.LAND`.\n445\t    * *player* is the active player.\n446\t    * Current phase is a main phase.\n447\t    * The stack is empty.\n448\t    * ``player.land_plays_remaining > 0``.\n449\t    * The card is in the player's hand.\n450\t\n451\t    On success the card moves from hand to battlefield and\n452\t    ``land_plays_remaining`` is decremented.\n453\t\n454\t    Raises:\n455\t        CastingError: If any requirement is not met.\n456\t    \"\"\"\n457\t    # Must be a land\n458\t    if CardType.LAND not in land_card.card_types:\n459\t        raise CastingError(\n460\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n461\t        )\n462\t\n463\t    # Sorcery-speed timing (active player, main phase, stack empty)\n464\t    if not is_sorcery_speed(game, player):\n465\t        raise CastingError(\n466\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n467\t            \"during main phase with empty stack\"\n468\t        )\n469\t\n470\t    # Land plays remaining\n471\t    if player.land_plays_remaining <= 0:\n472\t        raise CastingError(\n473\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n474\t        )\n475\t\n476\t    # Card must be in hand\n477\t    hand = game.get_hand(player)\n478\t    if not hand.contains(land_card):\n479\t        raise CastingError(\n480\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n481\t        )\n482\t\n483\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n484\t    if land_card.owner is None:\n485\t        land_card.owner = player\n486\t    land_card.controller = player\n487\t\n488\t    # Move from hand to battlefield via move_to_zone, which fires\n489\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n490\t    from engine.zones import move_to_zone\n491\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n492\t\n493\t    # Decrement land plays\n494\t    player.land_plays_remaining -= 1\n495\t\n496\t\n497\tdef resolve_top(game: GameState) -> None:\n498\t    \"\"\"Resolve the top spell/ability on the stack.\n499\t\n500\t    Pops the top item from the stack, calls its on_resolve callback,\n501\t    then runs state-based actions.  If the stack is empty this is a no-op.\n502\t    \"\"\"\n503\t    if game.stack.is_empty():\n504\t        return\n505\t    from engine.state_based_actions import resolve_state_based_actions\n506\t\n507\t    obj = game.stack.pop()\n508\t    obj.on_resolve(game)\n509\t    resolve_state_based_actions(game)\n510\t"}]},"parent_tool_use_id":"toolu_01UJKMjqL9d5KRnRnDXJ1wSL","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c","uuid":"e2ee333b-4606-424d-833a-2e1a988c650d","timestamp":"2026-05-28T08:54:20.385Z","subagent_type":"Reviewer","task_description":"Reviewer for sos_245"}
