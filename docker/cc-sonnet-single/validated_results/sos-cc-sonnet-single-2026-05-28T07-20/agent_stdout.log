{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018HZL8XwJszdxXLHvKznGJQ","type":"tool_result","content":"1\t\"\"\"Tests for sos_201 — Lorehold, the Historian.\n2\t\n3\tTests cover:\n4\t- Static card properties (name, mana cost, P/T, keywords, supertypes, subtypes)\n5\t- Card type and color correctness\n6\t- Miracle-cost grant: instants and sorceries in hand have miracle {2}; other\n7\t  card types do not\n8\t- Opponent upkeep trigger registration and firing\n9\t- Trigger fires for opponent's upkeep, not for controller's own upkeep\n10\t- Discard-then-draw effect: when the controller discards a card, they draw one\n11\t- Decline to discard: if the controller says \"no\", no draw occurs\n12\t\"\"\"\n13\t\n14\tfrom __future__ import annotations\n15\t\n16\timport pytest\n17\t\n18\tfrom cards.sos.sos_201.card_impl import LoreholdTheHistorian\n19\tfrom engine.card import Creature, Instant, Sorcery\n20\tfrom engine.events import BeginningOfUpkeepTriggeredEvent\n21\tfrom engine.types import (\n22\t    CardType,\n23\t    Keyword,\n24\t    ManaCost,\n25\t    ManaType,\n26\t    Supertype,\n27\t    Zone,\n28\t)\n29\tfrom test_utils import create_game, set_board_state\n30\t\n31\t\n32\t# ---------------------------------------------------------------------------\n33\t# Static properties\n34\t# ---------------------------------------------------------------------------\n35\t\n36\t\n37\tclass TestLoreholdStaticProperties:\n38\t    \"\"\"Static card data must match the sos_201 spec.\"\"\"\n39\t\n40\t    def test_name(self) -> None:\n41\t        card = LoreholdTheHistorian(owner=None)\n42\t        assert card.name == \"Lorehold, the Historian\"\n43\t\n44\t    def test_is_creature(self) -> None:\n45\t        card = LoreholdTheHistorian(owner=None)\n46\t        assert isinstance(card, Creature)\n47\t        assert CardType.CREATURE in card.card_types\n48\t\n49\t    def test_mana_cost(self) -> None:\n50\t        card = LoreholdTheHistorian(owner=None)\n51\t        assert card.mana_cost == ManaCost.parse(\"{3}{R}{W}\")\n52\t\n53\t    def test_power(self) -> None:\n54\t        card = LoreholdTheHistorian(owner=None)\n55\t        assert card.base_power == 5\n56\t\n57\t    def test_toughness(self) -> None:\n58\t        card = LoreholdTheHistorian(owner=None)\n59\t        assert card.base_toughness == 5\n60\t\n61\t    def test_has_flying(self) -> None:\n62\t        card = LoreholdTheHistorian(owner=None)\n63\t        assert Keyword.FLYING in card.keywords\n64\t\n65\t    def test_has_haste(self) -> None:\n66\t        card = LoreholdTheHistorian(owner=None)\n67\t        assert Keyword.HASTE in card.keywords\n68\t\n69\t    def test_is_legendary(self) -> None:\n70\t        card = LoreholdTheHistorian(owner=None)\n71\t        assert Supertype.LEGENDARY in card.supertypes\n72\t\n73\t    def test_is_elder_dragon(self) -> None:\n74\t        card = LoreholdTheHistorian(owner=None)\n75\t        assert \"Elder\" in card.subtypes\n76\t        assert \"Dragon\" in card.subtypes\n77\t\n78\t    def test_colors_include_red(self) -> None:\n79\t        \"\"\"The card is red/white: mana cost must contain a red pip.\"\"\"\n80\t        card = LoreholdTheHistorian(owner=None)\n81\t        assert ManaType.RED in card.mana_cost.pips\n82\t\n83\t    def test_colors_include_white(self) -> None:\n84\t        \"\"\"The card is red/white: mana cost must contain a white pip.\"\"\"\n85\t        card = LoreholdTheHistorian(owner=None)\n86\t        assert ManaType.WHITE in card.mana_cost.pips\n87\t\n88\t\n89\t# ---------------------------------------------------------------------------\n90\t# Miracle-cost grant\n91\t# ---------------------------------------------------------------------------\n92\t\n93\t\n94\tclass TestLoreholdMiracleCostGrant:\n95\t    \"\"\"Each instant and sorcery in the controller's hand has miracle {2}.\"\"\"\n96\t\n97\t    def test_get_miracle_cost_returns_callable_or_manacost(self) -> None:\n98\t        \"\"\"The card exposes a way to determine miracle cost for hand cards.\"\"\"\n99\t        card = LoreholdTheHistorian(owner=None)\n100\t        # Must have a get_miracle_cost method\n101\t        assert hasattr(card, \"get_miracle_cost\"), (\n102\t            \"LoreholdTheHistorian must implement get_miracle_cost(card)\"\n103\t        )\n104\t\n105\t    def test_instant_in_hand_has_miracle_cost_two(self) -> None:\n106\t        \"\"\"An instant card should receive miracle cost {2}.\"\"\"\n107\t        game = create_game()\n108\t        p1 = game.players[0]\n109\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n110\t        instant = Instant(name=\"Test Instant\", owner=p1, controller=p1)\n111\t        # Place both on battlefield/hand as appropriate\n112\t        game.get_battlefield(p1).add(lorehold)\n113\t        game.get_hand(p1).add(instant)\n114\t        lorehold.register_triggers(game)\n115\t\n116\t        miracle_cost = lorehold.get_miracle_cost(instant)\n117\t        assert miracle_cost == ManaCost.parse(\"{2}\"), (\n118\t            f\"Expected miracle cost {{2}} for instant, got {miracle_cost!r}\"\n119\t        )\n120\t\n121\t    def test_sorcery_in_hand_has_miracle_cost_two(self) -> None:\n122\t        \"\"\"A sorcery card should receive miracle cost {2}.\"\"\"\n123\t        game = create_game()\n124\t        p1 = game.players[0]\n125\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n126\t        sorcery = Sorcery(name=\"Test Sorcery\", owner=p1, controller=p1)\n127\t        game.get_battlefield(p1).add(lorehold)\n128\t        game.get_hand(p1).add(sorcery)\n129\t        lorehold.register_triggers(game)\n130\t\n131\t        miracle_cost = lorehold.get_miracle_cost(sorcery)\n132\t        assert miracle_cost == ManaCost.parse(\"{2}\"), (\n133\t            f\"Expected miracle cost {{2}} for sorcery, got {miracle_cost!r}\"\n134\t        )\n135\t\n136\t    def test_creature_does_not_get_miracle_cost(self) -> None:\n137\t        \"\"\"A creature card should NOT receive a miracle cost.\"\"\"\n138\t        game = create_game()\n139\t        p1 = game.players[0]\n140\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n141\t        creature = Creature(name=\"Test Bear\", base_power=2, base_toughness=2,\n142\t                            owner=p1, controller=p1)\n143\t        game.get_battlefield(p1).add(lorehold)\n144\t        game.get_hand(p1).add(creature)\n145\t        lorehold.register_triggers(game)\n146\t\n147\t        miracle_cost = lorehold.get_miracle_cost(creature)\n148\t        assert miracle_cost is None, (\n149\t            f\"Expected None for creature, got {miracle_cost!r}\"\n150\t        )\n151\t\n152\t    def test_miracle_cost_not_granted_to_opponent_cards(self) -> None:\n153\t        \"\"\"Only cards in the controller's hand get the miracle benefit.\"\"\"\n154\t        game = create_game()\n155\t        p1 = game.players[0]\n156\t        p2 = game.players[1]\n157\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n158\t        instant = Instant(name=\"Opponent Instant\", owner=p2, controller=p2)\n159\t        game.get_battlefield(p1).add(lorehold)\n160\t        game.get_hand(p2).add(instant)\n161\t        lorehold.register_triggers(game)\n162\t\n163\t        # The miracle cost query for opponent's card should return None\n164\t        miracle_cost = lorehold.get_miracle_cost(instant)\n165\t        assert miracle_cost is None, (\n166\t            \"Miracle {2} should not apply to opponent's cards\"\n167\t        )\n168\t\n169\t\n170\t# ---------------------------------------------------------------------------\n171\t# Opponent upkeep trigger — registration\n172\t# ---------------------------------------------------------------------------\n173\t\n174\t\n175\tclass TestLoreholdOpponentUpkeepTriggerRegistration:\n176\t    \"\"\"register_triggers must register exactly one upkeep-watching trigger.\"\"\"\n177\t\n178\t    def test_registers_upkeep_trigger_on_battlefield(self) -> None:\n179\t        game = create_game()\n180\t        p1 = game.players[0]\n181\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n182\t        set_board_state(game, 0, battlefield=[lorehold])\n183\t        lorehold.register_triggers(game)\n184\t\n185\t        upkeep_triggers = [\n186\t            t for t in game.trigger_manager.get_triggers()\n187\t            if t.event_type is BeginningOfUpkeepTriggeredEvent\n188\t        ]\n189\t        assert len(upkeep_triggers) >= 1, (\n190\t            \"Expected at least one BeginningOfUpkeepTriggeredEvent trigger\"\n191\t        )\n192\t\n193\t    def test_trigger_source_is_lorehold(self) -> None:\n194\t        game = create_game()\n195\t        p1 = game.players[0]\n196\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n197\t        set_board_state(game, 0, battlefield=[lorehold])\n198\t        lorehold.register_triggers(game)\n199\t\n200\t        upkeep_triggers = [\n201\t            t for t in game.trigger_manager.get_triggers()\n202\t            if t.event_type is BeginningOfUpkeepTriggeredEvent\n203\t        ]\n204\t        sources = [t.source for t in upkeep_triggers]\n205\t        assert lorehold in sources\n206\t\n207\t\n208\t# ---------------------------------------------------------------------------\n209\t# Opponent upkeep trigger — fires for opponent, not controller\n210\t# ---------------------------------------------------------------------------\n211\t\n212\t\n213\tclass TestLoreholdOpponentUpkeepTriggerFiring:\n214\t    \"\"\"Trigger must fire only during opponent's upkeep step.\"\"\"\n215\t\n216\t    def test_trigger_does_not_fire_on_controllers_own_upkeep(self) -> None:\n217\t        \"\"\"When it is p1's (controller's) upkeep, no trigger should fire.\"\"\"\n218\t        game = create_game()\n219\t        p1 = game.players[0]\n220\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n221\t        set_board_state(game, 0, battlefield=[lorehold])\n222\t        lorehold.register_triggers(game)\n223\t\n224\t        # p1 is active player (index 0 by default)\n225\t        game.active_player_index = 0\n226\t        before = game.stack.size()\n227\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n228\t        after = game.stack.size()\n229\t\n230\t        assert after == before, (\n231\t            \"Lorehold trigger should NOT fire during controller's own upkeep\"\n232\t        )\n233\t\n234\t    def test_trigger_fires_on_opponents_upkeep(self) -> None:\n235\t        \"\"\"When it is p2's (opponent's) upkeep, the trigger should fire.\"\"\"\n236\t        # Script p1 to answer 'yes' to the discard prompt, then provide a card.\n237\t        game = create_game()\n238\t        p1 = game.players[0]\n239\t        p2 = game.players[1]\n240\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n241\t        set_board_state(game, 0, battlefield=[lorehold])\n242\t        lorehold.register_triggers(game)\n243\t\n244\t        # Make p2 the active player (their upkeep)\n245\t        game.active_player_index = 1\n246\t        before = game.stack.size()\n247\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n248\t        after = game.stack.size()\n249\t\n250\t        assert after > before, (\n251\t            \"Lorehold trigger MUST fire during opponent's upkeep\"\n252\t        )\n253\t\n254\t\n255\t# ---------------------------------------------------------------------------\n256\t# Discard-then-draw effect\n257\t# ---------------------------------------------------------------------------\n258\t\n259\t\n260\tclass TestLoreholdDiscardDrawEffect:\n261\t    \"\"\"When the trigger resolves and controller discards, they draw a card.\"\"\"\n262\t\n263\t    def _setup_game_with_lorehold_on_board(self):\n264\t        \"\"\"Return (game, p1, p2, lorehold) with lorehold on p1's battlefield.\"\"\"\n265\t        game = create_game()\n266\t        p1 = game.players[0]\n267\t        p2 = game.players[1]\n268\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n269\t        set_board_state(game, 0, battlefield=[lorehold])\n270\t        lorehold.register_triggers(game)\n271\t        return game, p1, p2, lorehold\n272\t\n273\t    def test_discarding_results_in_drawing_a_card(self) -> None:\n274\t        \"\"\"If controller discards, net hand size stays the same (+1 draw, -1 discard).\"\"\"\n275\t        game, p1, p2, lorehold = self._setup_game_with_lorehold_on_board()\n276\t\n277\t        # Put two cards in p1's hand, one in library\n278\t        discard_card = Instant(name=\"Discard Target\", owner=p1, controller=p1)\n279\t        hand_card = Creature(name=\"Hand Filler\", base_power=1, base_toughness=1,\n280\t                             owner=p1, controller=p1)\n281\t        draw_card = Sorcery(name=\"Library Top\", owner=p1, controller=p1)\n282\t        set_board_state(game, 0, hand=[discard_card, hand_card])\n283\t        # Put a card in p1's library to draw\n284\t        p1.zones[Zone.LIBRARY].add(draw_card)\n285\t\n286\t        hand_before = len(game.get_hand(p1).get_all())  # 2\n287\t\n288\t        # Script p1: yes to discard, then choose discard_card\n289\t        from engine.player import DeterministicPlayer\n290\t        from collections import deque\n291\t        p1._script = deque([True, discard_card])\n292\t\n293\t        # Make p2 the active player and fire the upkeep event\n294\t        game.active_player_index = 1\n295\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n296\t\n297\t        # Resolve the trigger\n298\t        while not game.stack.is_empty():\n299\t            obj = game.stack.pop()\n300\t            obj.on_resolve(game)\n301\t\n302\t        hand_after = len(game.get_hand(p1).get_all())\n303\t        # Discarded 1, drew 1 → net 0\n304\t        assert hand_after == hand_before, (\n305\t            f\"Expected hand size unchanged after discard+draw, \"\n306\t            f\"was {hand_before} before and {hand_after} after\"\n307\t        )\n308\t\n309\t    def test_discarded_card_goes_to_graveyard(self) -> None:\n310\t        \"\"\"The discarded card must end up in the graveyard.\"\"\"\n311\t        game, p1, p2, lorehold = self._setup_game_with_lorehold_on_board()\n312\t\n313\t        discard_card = Instant(name=\"Discard Me\", owner=p1, controller=p1)\n314\t        draw_card = Sorcery(name=\"Library Top\", owner=p1, controller=p1)\n315\t        set_board_state(game, 0, hand=[discard_card])\n316\t        p1.zones[Zone.LIBRARY].add(draw_card)\n317\t\n318\t        from collections import deque\n319\t        p1._script = deque([True, discard_card])\n320\t\n321\t        game.active_player_index = 1\n322\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n323\t\n324\t        while not game.stack.is_empty():\n325\t            obj = game.stack.pop()\n326\t            obj.on_resolve(game)\n327\t\n328\t        graveyard = game.get_graveyard(p1).get_all()\n329\t        assert discard_card in graveyard, (\n330\t            \"Discarded card should be in the graveyard\"\n331\t        )\n332\t\n333\t    def test_declining_to_discard_means_no_draw(self) -> None:\n334\t        \"\"\"If the controller says no to discarding, they must not draw.\"\"\"\n335\t        game, p1, p2, lorehold = self._setup_game_with_lorehold_on_board()\n336\t\n337\t        hand_card = Instant(name=\"Keeper\", owner=p1, controller=p1)\n338\t        set_board_state(game, 0, hand=[hand_card])\n339\t        # Leave library empty so a draw would be detectable (drawn_from_empty flag)\n340\t\n341\t        from collections import deque\n342\t        p1._script = deque([False])  # decline to discard\n343\t\n344\t        hand_before = len(game.get_hand(p1).get_all())\n345\t\n346\t        game.active_player_index = 1\n347\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n348\t\n349\t        while not game.stack.is_empty():\n350\t            obj = game.stack.pop()\n351\t            obj.on_resolve(game)\n352\t\n353\t        hand_after = len(game.get_hand(p1).get_all())\n354\t        assert hand_after == hand_before, (\n355\t            \"Declining to discard must not change hand size\"\n356\t        )\n357\t\n358\t    def test_declining_to_discard_does_not_attempt_library_draw(self) -> None:\n359\t        \"\"\"Declining discard must not set the drawn_from_empty_library flag.\"\"\"\n360\t        game, p1, p2, lorehold = self._setup_game_with_lorehold_on_board()\n361\t\n362\t        from collections import deque\n363\t        p1._script = deque([False])  # decline to discard\n364\t\n365\t        game.active_player_index = 1\n366\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n367\t\n368\t        while not game.stack.is_empty():\n369\t            obj = game.stack.pop()\n370\t            obj.on_resolve(game)\n371\t\n372\t        assert not p1.drawn_from_empty_library, (\n373\t            \"No draw should occur when discard is declined\"\n374\t        )\n375\t"}]},"parent_tool_use_id":"toolu_01Xbffb1HtwnqxQB4uaScsyi","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c","uuid":"6e6c36fe-3ae9-49ef-9bd0-915de713db84","timestamp":"2026-05-28T08:33:49.414Z","subagent_type":"Reviewer","task_description":"Reviewer for sos_201"}
