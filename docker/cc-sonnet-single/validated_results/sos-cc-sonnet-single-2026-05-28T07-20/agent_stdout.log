{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0147USKvBCNzCmqR1Jsu8D7A","type":"tool_result","content":"1\t\"\"\"Central game state and turn/phase/step progression.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import Any\n6\t\n7\tfrom engine.combat import CombatState\n8\tfrom engine.continuous_effects import EffectManager\n9\tfrom engine.player import Player\n10\tfrom engine.replacement_effects import ReplacementManager\n11\tfrom engine.stack import Stack\n12\tfrom engine.triggers import TriggerManager\n13\tfrom engine.types import Phase, Step, Zone\n14\tfrom engine.zones import ZoneContainer\n15\t\n16\t# Ordered list of (Phase, Step | None) representing a full MTG turn.\n17\t_TURN_SEQUENCE: list[tuple[Phase, Step | None]] = [\n18\t    # Beginning phase\n19\t    (Phase.BEGINNING, Step.UNTAP),\n20\t    (Phase.BEGINNING, Step.UPKEEP),\n21\t    (Phase.BEGINNING, Step.DRAW),\n22\t    # Precombat main phase\n23\t    (Phase.PRECOMBAT_MAIN, None),\n24\t    # Combat phase\n25\t    (Phase.COMBAT, Step.BEGIN_COMBAT),\n26\t    (Phase.COMBAT, Step.DECLARE_ATTACKERS),\n27\t    (Phase.COMBAT, Step.DECLARE_BLOCKERS),\n28\t    (Phase.COMBAT, Step.COMBAT_DAMAGE),\n29\t    (Phase.COMBAT, Step.END_COMBAT),\n30\t    # Postcombat main phase\n31\t    (Phase.POSTCOMBAT_MAIN, None),\n32\t    # Ending phase\n33\t    (Phase.ENDING, Step.END),\n34\t    (Phase.ENDING, Step.CLEANUP),\n35\t]\n36\t\n37\t\n38\tclass GameState:\n39\t    \"\"\"Central game-state object tracking all mutable game information.\n40\t\n41\t    Attributes:\n42\t        players: The list of players in the game.\n43\t        active_player_index: Index of the current active player.\n44\t        priority_player_index: Index of the player who currently has priority.\n45\t        phase: Current phase of the turn.\n46\t        step: Current step within the phase (``None`` for main phases).\n47\t        turn_number: The current turn number (1-indexed).\n48\t        stack: The game stack for spells and abilities.\n49\t        trigger_manager: Central registry for triggered abilities.\n50\t        replacement_manager: Central registry for replacement effects.\n51\t        effect_manager: Manager for continuous effects and the layer system.\n52\t        is_game_over: Whether the game has ended.\n53\t        winner: The winning player, or ``None`` if the game is ongoing / draw.\n54\t    \"\"\"\n55\t\n56\t    def __init__(self, players: list[Player]) -> None:\n57\t        if len(players) < 2:\n58\t            raise ValueError(\"GameState requires at least 2 players\")\n59\t        if len(players) > 2:\n60\t            raise ValueError(\"GameState supports exactly 2 players\")\n61\t\n62\t        self.players: list[Player] = players\n63\t        self.active_player_index: int = 0\n64\t        self.priority_player_index: int = 0\n65\t        self.phase: Phase = Phase.BEGINNING\n66\t        self.step: Step | None = Step.UNTAP\n67\t        self.turn_number: int = 1\n68\t        self.stack: Stack = Stack()\n69\t        self.trigger_manager: TriggerManager = TriggerManager()\n70\t        self.replacement_manager: ReplacementManager = ReplacementManager()\n71\t        self.effect_manager: EffectManager = EffectManager()\n72\t        self.combat_state: CombatState = CombatState()\n73\t        self.is_game_over: bool = False\n74\t        self.winner: Player | None = None\n75\t        # ENGINE LIMITATION: Extra turns queue (FIFO of player seat indices).\n76\t        # Complex interactions ('skip your next turn', multiple extra turns\n77\t        # from different sources) are not fully handled.\n78\t        self.extra_turns: list[int] = []\n79\t        # Tracks normal turn rotation independently of extra turns.\n80\t        # Extra turns are truly *inserted* — they don't advance the\n81\t        # normal rotation.  When extras are exhausted the game picks up\n82\t        # from _normal_next_index.\n83\t        self._normal_next_index: int = 1\n84\t        # Game-scoped set of card names that have registered their Paradigm\n85\t        # trigger.  Keyed by (controller_id, card_name) so each controller's\n86\t        # first resolution is tracked independently.\n87\t        self.paradigm_registered: set[tuple[int, str]] = set()\n88\t\n89\t    # ------------------------------------------------------------------\n90\t    # Player properties\n91\t    # ------------------------------------------------------------------\n92\t\n93\t    @property\n94\t    def active_player(self) -> Player:\n95\t        \"\"\"Return the currently active player.\"\"\"\n96\t        return self.players[self.active_player_index]\n97\t\n98\t    @property\n99\t    def priority_player(self) -> Player:\n100\t        \"\"\"Return the player who currently has priority.\"\"\"\n101\t        return self.players[self.priority_player_index]\n102\t\n103\t    @property\n104\t    def non_active_player(self) -> Player:\n105\t        \"\"\"Return the non-active player (2-player assumption for v1).\"\"\"\n106\t        return self.players[1 - self.active_player_index]\n107\t\n108\t    # ------------------------------------------------------------------\n109\t    # Zone accessors\n110\t    # ------------------------------------------------------------------\n111\t\n112\t    def get_battlefield(self, player: Player) -> ZoneContainer:\n113\t        \"\"\"Return the battlefield zone for *player*.\"\"\"\n114\t        return player.zones[Zone.BATTLEFIELD]\n115\t\n116\t    def get_hand(self, player: Player) -> ZoneContainer:\n117\t        \"\"\"Return the hand zone for *player*.\"\"\"\n118\t        return player.zones[Zone.HAND]\n119\t\n120\t    def get_graveyard(self, player: Player) -> ZoneContainer:\n121\t        \"\"\"Return the graveyard zone for *player*.\"\"\"\n122\t        return player.zones[Zone.GRAVEYARD]\n123\t\n124\t    def get_library(self, player: Player) -> ZoneContainer:\n125\t        \"\"\"Return the library zone for *player*.\"\"\"\n126\t        return player.zones[Zone.LIBRARY]\n127\t\n128\t    def get_exile(self, player: Player) -> ZoneContainer:\n129\t        \"\"\"Return the exile zone for *player*.\"\"\"\n130\t        return player.zones[Zone.EXILE]\n131\t\n132\t    # ------------------------------------------------------------------\n133\t    # Phase/step progression\n134\t    # ------------------------------------------------------------------\n135\t\n136\t    def advance_phase(self) -> None:\n137\t        \"\"\"Advance to the next phase/step in MTG turn order.\n138\t\n139\t        At the end of CLEANUP, the turn number is incremented and the\n140\t        active player swaps (2-player assumption).  Mana pools are\n141\t        emptied on every transition.\n142\t        \"\"\"\n143\t        current = (self.phase, self.step)\n144\t        idx = _TURN_SEQUENCE.index(current)\n145\t\n146\t        if idx + 1 < len(_TURN_SEQUENCE):\n147\t            # Move to next phase/step within the same turn.\n148\t            next_phase, next_step = _TURN_SEQUENCE[idx + 1]\n149\t            self.phase = next_phase\n150\t            self.step = next_step\n151\t        else:\n152\t            # End of turn — wrap around.\n153\t            self.turn_number += 1\n154\t            if self.extra_turns:\n155\t                # ENGINE LIMITATION: Extra turns queue (FIFO). Pop the\n156\t                # next player seat index; that player gets the next turn.\n157\t                # Normal rotation is NOT advanced — extra turns are\n158\t                # inserted before the normal next turn.\n159\t                self.active_player_index = self.extra_turns.pop(0)\n160\t            else:\n161\t                self.active_player_index = self._normal_next_index\n162\t                self._normal_next_index = 1 - self._normal_next_index\n163\t            self.priority_player_index = self.active_player_index\n164\t            self.phase = _TURN_SEQUENCE[0][0]\n165\t            self.step = _TURN_SEQUENCE[0][1]\n166\t\n167\t        self.empty_mana_pools()\n168\t\n169\t    def empty_mana_pools(self) -> None:\n170\t        \"\"\"Empty all players' mana pools — called on each phase/step transition.\"\"\"\n171\t        for player in self.players:\n172\t            player.mana_pool.empty()\n173\t"}]},"parent_tool_use_id":"toolu_01S4fNW57avaPadQXpKSq7YV","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c","uuid":"04478e89-69ee-4a78-93a8-01f9f9a36c61","timestamp":"2026-05-28T08:37:47.664Z","subagent_type":"Tester","task_description":"Tester for sos_226"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014FHYc17nvmP8UuWjhnBkRn","type":"tool_result","content":"1\t\"\"\"The spell/ability stack with LIFO resolution and priority passing.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport copy\n6\tfrom dataclasses import dataclass, field\n7\tfrom typing import TYPE_CHECKING, Any, Callable\n8\t\n9\tif TYPE_CHECKING:\n10\t    from engine.game_state import GameState\n11\t    from engine.player import Player\n12\t\n13\t\n14\t@dataclass\n15\tclass StackObject:\n16\t    \"\"\"An object on the stack representing a spell or ability.\n17\t\n18\t    Attributes:\n19\t        source: The card or ability that created this stack object.\n20\t        controller: The player who controls this stack object.\n21\t        targets: The chosen targets for the spell/ability.\n22\t        on_resolve: Callback invoked when this object resolves.\n23\t        is_mana_ability: Whether this is a mana ability (resolves immediately).\n24\t    \"\"\"\n25\t\n26\t    source: Any\n27\t    controller: Player\n28\t    targets: list[Any] = field(default_factory=list)\n29\t    on_resolve: Callable[[GameState], None] = field(default=lambda _game: None)\n30\t    is_mana_ability: bool = False\n31\t\n32\t\n33\tclass Stack:\n34\t    \"\"\"The game stack — a LIFO structure for spells and abilities.\n35\t\n36\t    The internal list stores objects with the last element being the top\n37\t    of the stack (most recently pushed).\n38\t    \"\"\"\n39\t\n40\t    def __init__(self) -> None:\n41\t        self._items: list[StackObject] = []\n42\t\n43\t    def push(self, obj: StackObject) -> None:\n44\t        \"\"\"Push *obj* onto the top of the stack.\"\"\"\n45\t        self._items.append(obj)\n46\t\n47\t    def pop(self) -> StackObject:\n48\t        \"\"\"Remove and return the top object from the stack.\n49\t\n50\t        Raises:\n51\t            IndexError: If the stack is empty.\n52\t        \"\"\"\n53\t        return self._items.pop()\n54\t\n55\t    def peek(self) -> StackObject | None:\n56\t        \"\"\"Return the top object without removing it, or ``None`` if empty.\"\"\"\n57\t        return self._items[-1] if self._items else None\n58\t\n59\t    def __len__(self) -> int:\n60\t        \"\"\"Return the number of objects on the stack.\"\"\"\n61\t        return len(self._items)\n62\t\n63\t    def size(self) -> int:\n64\t        \"\"\"Return the number of objects on the stack.\"\"\"\n65\t        return len(self._items)\n66\t\n67\t    def is_empty(self) -> bool:\n68\t        \"\"\"Return ``True`` if the stack contains no objects.\"\"\"\n69\t        return len(self._items) == 0\n70\t\n71\t    def objects(self) -> list[StackObject]:\n72\t        \"\"\"Return all stack objects ordered from top to bottom.\"\"\"\n73\t        return list(reversed(self._items))\n74\t\n75\t\n76\tdef copy_spell(\n77\t    game: GameState,\n78\t    original: StackObject,\n79\t    controller: Player,\n80\t    new_targets: list[Any] | None = None,\n81\t) -> StackObject:\n82\t    \"\"\"Create a copy of a spell on the stack (for storm and similar effects).\n83\t\n84\t    Shallow-copies the source card so the copy has independent state\n85\t    (chosen_targets, etc.) while sharing class method bindings.  Binds\n86\t    on_resolve to call the copied card's on_resolve directly — no zone\n87\t    movement, which is correct for spell copies.\n88\t\n89\t    Args:\n90\t        game: The current game state.\n91\t        original: The StackObject being copied.\n92\t        controller: The player who controls the copy.\n93\t        new_targets: Optional replacement targets.  If ``None``, the\n94\t            original's target list is cloned.\n95\t\n96\t    Returns:\n97\t        A new StackObject representing the copy ready to be pushed.\n98\t    \"\"\"\n99\t    copied_card = copy.copy(original.source)\n100\t    copied_card.controller = controller\n101\t    copied_card.owner = getattr(original.source, \"owner\", controller)\n102\t\n103\t    targets = new_targets if new_targets is not None else list(original.targets)\n104\t\n105\t    copy_obj = StackObject(\n106\t        source=copied_card,\n107\t        controller=controller,\n108\t        targets=targets,\n109\t    )\n110\t\n111\t    def _copy_resolve(g: GameState) -> None:\n112\t        copied_card.chosen_targets = copy_obj.targets\n113\t        copied_card.on_resolve(g)\n114\t\n115\t    copy_obj.on_resolve = _copy_resolve\n116\t    return copy_obj\n117\t\n118\t\n119\tdef check_state_based_actions(game: GameState) -> None:\n120\t    \"\"\"Check and perform all state-based actions until the game state is stable.\n121\t\n122\t    This is a convenience wrapper around\n123\t    :func:`engine.state_based_actions.resolve_state_based_actions` that\n124\t    maintains the original ``-> None`` call-site contract used by\n125\t    :func:`priority_loop`.  For the single-pass boolean API, import\n126\t    :func:`~engine.state_based_actions.check_state_based_actions` directly\n127\t    from :mod:`engine.state_based_actions`.\n128\t    \"\"\"\n129\t    from engine.state_based_actions import resolve_state_based_actions\n130\t\n131\t    resolve_state_based_actions(game)\n132\t\n133\t\n134\tdef _get_legal_actions(game: GameState, player: Player) -> list[Any]:\n135\t    \"\"\"Return the legal actions available to *player*.\n136\t\n137\t    Placeholder — returns an empty list until spells/abilities are\n138\t    implemented in later items.\n139\t    \"\"\"\n140\t    return []\n141\t\n142\t\n143\tdef _handle_priority(game: GameState, player: Player) -> bool:\n144\t    \"\"\"Give priority to *player* and let them act or pass.\n145\t\n146\t    Returns ``True`` if the player passed priority, ``False`` if they\n147\t    took an action (in which case the priority loop restarts).\n148\t\n149\t    When the stack is non-empty, the player is always asked via\n150\t    :meth:`Player.choose` so they can respond.  When the stack is empty\n151\t    and no legal actions exist, the player auto-passes.\n152\t    \"\"\"\n153\t    actions = _get_legal_actions(game, player)\n154\t\n155\t    # Auto-pass when there is nothing to respond to and no actions.\n156\t    if not actions and game.stack.is_empty():\n157\t        return True\n158\t\n159\t    options = actions + [\"pass\"]\n160\t    choice = player.choose(options, \"priority: choose action or pass\")\n161\t\n162\t    if choice == \"pass\":\n163\t        return True\n164\t\n165\t    # Mana abilities resolve immediately without using the stack.\n166\t    if isinstance(choice, StackObject) and choice.is_mana_ability:\n167\t        choice.on_resolve(game)\n168\t        return False\n169\t\n170\t    # Regular spell / ability — push onto the stack.\n171\t    if isinstance(choice, StackObject):\n172\t        game.stack.push(choice)\n173\t\n174\t    return False\n175\t\n176\t\n177\tdef priority_loop(game: GameState) -> None:\n178\t    \"\"\"Run the priority-passing loop for the current phase/step.\n179\t\n180\t    Flow\n181\t    ----\n182\t    1. Active player gets priority.  They may play spells/abilities\n183\t       (pushed to stack) or pass.\n184\t    2. When a player takes an action they **retain** priority (MTG rule:\n185\t       the player who just acted gets to respond first).\n186\t    3. When a player passes, priority moves to the other player.\n187\t    4. If both players pass in succession with the stack **non-empty**,\n188\t       the top of the stack is resolved (``pop`` → ``on_resolve(game)``),\n189\t       state-based actions are checked, and the active player receives\n190\t       priority again.\n191\t    5. If both players pass with the stack **empty**, return (the game\n192\t       advances to the next phase/step).\n193\t\n194\t    ``game.priority_player_index`` is kept in sync throughout so that\n195\t    :pyattr:`GameState.priority_player` always reflects who currently\n196\t    holds priority.\n197\t\n198\t    Player decisions come from :meth:`Player.choose`.  When no legal\n199\t    actions exist and the stack is empty, the player auto-passes without\n200\t    being asked.\n201\t    \"\"\"\n202\t    while True:\n203\t        # Active player receives priority at the start of each\n204\t        # resolution round.\n205\t        current_index = game.active_player_index\n206\t        game.priority_player_index = current_index\n207\t        consecutive_passes = 0\n208\t\n209\t        while consecutive_passes < 2:\n210\t            player = game.players[current_index]\n211\t            game.priority_player_index = current_index\n212\t\n213\t            passed = _handle_priority(game, player)\n214\t\n215\t            if passed:\n216\t                consecutive_passes += 1\n217\t                # Priority moves to the other player.\n218\t                current_index = 1 - current_index\n219\t            else:\n220\t                # Player took an action — they retain priority.\n221\t                consecutive_passes = 0\n222\t\n223\t        # Both players passed consecutively.\n224\t        if game.stack.is_empty():\n225\t            return  # Advance to next phase/step\n226\t\n227\t        # Resolve top of stack (LIFO).\n228\t        obj = game.stack.pop()\n229\t        obj.on_resolve(game)\n230\t        check_state_based_actions(game)\n231\t        # Active player receives priority again — outer loop continues.\n232\t"}]},"parent_tool_use_id":"toolu_01S4fNW57avaPadQXpKSq7YV","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c","uuid":"ef893ed5-6e42-470e-9f9b-87aaa6e4acc4","timestamp":"2026-05-28T08:37:47.664Z","subagent_type":"Tester","task_description":"Tester for sos_226"}
