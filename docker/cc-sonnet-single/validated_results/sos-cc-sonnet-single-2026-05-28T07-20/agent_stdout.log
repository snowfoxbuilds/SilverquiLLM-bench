{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LEWvAhTqrBfXjF959uGhMf","type":"tool_result","content":"1\t\"\"\"Tests for SOS 1 — The Dawning Archaic.\n2\t\n3\tRequirements under test:\n4\t1. Static properties: Legendary Creature - Avatar, 7/7, colorless (mana cost {10}),\n5\t   Legendary supertype, Reach keyword.\n6\t2. Cost reduction: costs {1} less for each instant/sorcery in controller's graveyard.\n7\t3. Attack trigger: whenever it attacks, controller may cast target instant or sorcery\n8\t   from their graveyard without paying its mana cost.\n9\t4. Exile-instead replacement: if the graveyard-cast spell would be put into the\n10\t   graveyard, exile it instead.\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\timport pytest\n16\t\n17\tfrom cards.sos.sos_1.card_impl import TheDawningArchaic\n18\tfrom engine.card import Creature, Instant, Sorcery\n19\tfrom engine.events import AttacksTriggeredEvent\n20\tfrom engine.triggers import TriggerRegistration\n21\tfrom engine.types import CardType, Keyword, ManaCost, ManaType, Supertype, Zone\n22\tfrom test_utils import create_game, set_board_state\n23\t\n24\t\n25\t# ---------------------------------------------------------------------------\n26\t# Static card properties\n27\t# ---------------------------------------------------------------------------\n28\t\n29\t\n30\tclass TestTheDawningArchaicProperties:\n31\t    \"\"\"Static characteristics should match the SOS 1 card spec.\"\"\"\n32\t\n33\t    def test_is_creature(self) -> None:\n34\t        card = TheDawningArchaic(owner=None)\n35\t        assert isinstance(card, Creature)\n36\t\n37\t    def test_name(self) -> None:\n38\t        assert TheDawningArchaic(owner=None).name == \"The Dawning Archaic\"\n39\t\n40\t    def test_mana_cost(self) -> None:\n41\t        assert TheDawningArchaic(owner=None).mana_cost == ManaCost.parse(\"{10}\")\n42\t\n43\t    def test_base_power(self) -> None:\n44\t        assert TheDawningArchaic(owner=None).base_power == 7\n45\t\n46\t    def test_base_toughness(self) -> None:\n47\t        assert TheDawningArchaic(owner=None).base_toughness == 7\n48\t\n49\t    def test_has_reach_keyword(self) -> None:\n50\t        assert Keyword.REACH in TheDawningArchaic(owner=None).keywords\n51\t\n52\t    def test_is_legendary(self) -> None:\n53\t        assert Supertype.LEGENDARY in TheDawningArchaic(owner=None).supertypes\n54\t\n55\t    def test_has_avatar_subtype(self) -> None:\n56\t        assert \"Avatar\" in TheDawningArchaic(owner=None).subtypes\n57\t\n58\t    def test_creature_card_type(self) -> None:\n59\t        assert CardType.CREATURE in TheDawningArchaic(owner=None).card_types\n60\t\n61\t\n62\t# ---------------------------------------------------------------------------\n63\t# Cost reduction — counted from controller's graveyard\n64\t# ---------------------------------------------------------------------------\n65\t\n66\t\n67\tclass TestTheDawningArchaicCostReduction:\n68\t    \"\"\"cost_reduction() returns the count of instant+sorcery cards in the\n69\t    controller's graveyard.\"\"\"\n70\t\n71\t    def test_zero_when_graveyard_is_empty(self) -> None:\n72\t        game = create_game()\n73\t        p1 = game.players[0]\n74\t        card = TheDawningArchaic(owner=p1, controller=p1)\n75\t        assert card.cost_reduction(game) == 0\n76\t\n77\t    def test_one_instant_gives_reduction_of_one(self) -> None:\n78\t        game = create_game()\n79\t        p1 = game.players[0]\n80\t        instant = Instant(\n81\t            name=\"Lightning Bolt\",\n82\t            owner=p1,\n83\t            controller=p1,\n84\t        )\n85\t        set_board_state(game, 0, graveyard=[instant])\n86\t        card = TheDawningArchaic(owner=p1, controller=p1)\n87\t        assert card.cost_reduction(game) == 1\n88\t\n89\t    def test_one_sorcery_gives_reduction_of_one(self) -> None:\n90\t        game = create_game()\n91\t        p1 = game.players[0]\n92\t        sorcery = Sorcery(\n93\t            name=\"Divination\",\n94\t            owner=p1,\n95\t            controller=p1,\n96\t        )\n97\t        set_board_state(game, 0, graveyard=[sorcery])\n98\t        card = TheDawningArchaic(owner=p1, controller=p1)\n99\t        assert card.cost_reduction(game) == 1\n100\t\n101\t    def test_multiple_instants_and_sorceries_counted(self) -> None:\n102\t        game = create_game()\n103\t        p1 = game.players[0]\n104\t        instant1 = Instant(name=\"Counterspell\", owner=p1, controller=p1)\n105\t        instant2 = Instant(name=\"Giant Growth\", owner=p1, controller=p1)\n106\t        sorcery1 = Sorcery(name=\"Cultivate\", owner=p1, controller=p1)\n107\t        set_board_state(game, 0, graveyard=[instant1, instant2, sorcery1])\n108\t        card = TheDawningArchaic(owner=p1, controller=p1)\n109\t        assert card.cost_reduction(game) == 3\n110\t\n111\t    def test_creature_in_graveyard_not_counted(self) -> None:\n112\t        game = create_game()\n113\t        p1 = game.players[0]\n114\t        creature = Creature(name=\"Grizzly Bears\", base_power=2, base_toughness=2,\n115\t                            owner=p1, controller=p1)\n116\t        set_board_state(game, 0, graveyard=[creature])\n117\t        card = TheDawningArchaic(owner=p1, controller=p1)\n118\t        assert card.cost_reduction(game) == 0\n119\t\n120\t    def test_mixed_types_only_instant_sorcery_counted(self) -> None:\n121\t        \"\"\"Creatures mixed with instants: only instants/sorceries count.\"\"\"\n122\t        game = create_game()\n123\t        p1 = game.players[0]\n124\t        instant = Instant(name=\"Shock\", owner=p1, controller=p1)\n125\t        creature = Creature(name=\"Goblin Guide\", base_power=2, base_toughness=2,\n126\t                            owner=p1, controller=p1)\n127\t        set_board_state(game, 0, graveyard=[instant, creature])\n128\t        card = TheDawningArchaic(owner=p1, controller=p1)\n129\t        assert card.cost_reduction(game) == 1\n130\t\n131\t    def test_opponent_graveyard_not_counted(self) -> None:\n132\t        \"\"\"Only the controller's graveyard matters, not opponent's.\"\"\"\n133\t        game = create_game()\n134\t        p1 = game.players[0]\n135\t        p2 = game.players[1]\n136\t        instant = Instant(name=\"Shock\", owner=p2, controller=p2)\n137\t        set_board_state(game, 1, graveyard=[instant])\n138\t        card = TheDawningArchaic(owner=p1, controller=p1)\n139\t        assert card.cost_reduction(game) == 0\n140\t\n141\t    def test_no_controller_returns_zero(self) -> None:\n142\t        \"\"\"If controller is None, cost_reduction must return 0 (not crash).\"\"\"\n143\t        game = create_game()\n144\t        card = TheDawningArchaic(owner=None)\n145\t        result = card.cost_reduction(game)\n146\t        assert result == 0\n147\t\n148\t    def test_cost_reduction_capped_at_base_generic(self) -> None:\n149\t        \"\"\"With 12 instant/sorceries in graveyard, the engine clamps cost\n150\t        to 0 (cost_reduction is allowed to exceed the base generic cost;\n151\t        the engine does the clamping). We just verify reduction >= 10 so\n152\t        the card becomes free.\"\"\"\n153\t        game = create_game()\n154\t        p1 = game.players[0]\n155\t        graveyard_cards = [\n156\t            Instant(name=f\"Spell {i}\", owner=p1, controller=p1)\n157\t            for i in range(12)\n158\t        ]\n159\t        set_board_state(game, 0, graveyard=graveyard_cards)\n160\t        card = TheDawningArchaic(owner=p1, controller=p1)\n161\t        assert card.cost_reduction(game) >= 10\n162\t\n163\t\n164\t# ---------------------------------------------------------------------------\n165\t# Attack trigger — registration\n166\t# ---------------------------------------------------------------------------\n167\t\n168\t\n169\tclass TestTheDawningArchaicTriggerRegistration:\n170\t    \"\"\"register_triggers() must wire an AttacksTriggeredEvent trigger.\"\"\"\n171\t\n172\t    def test_registers_at_least_one_trigger_on_etb(self) -> None:\n173\t        game = create_game()\n174\t        p1 = game.players[0]\n175\t        card = TheDawningArchaic(owner=p1, controller=p1)\n176\t        before = len(game.trigger_manager.get_triggers())\n177\t        card.register_triggers(game)\n178\t        after = len(game.trigger_manager.get_triggers())\n179\t        assert after > before\n180\t\n181\t    def test_registered_trigger_is_for_attacks_event(self) -> None:\n182\t        game = create_game()\n183\t        p1 = game.players[0]\n184\t        card = TheDawningArchaic(owner=p1, controller=p1)\n185\t        card.register_triggers(game)\n186\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n187\t        event_types = [t.event_type for t in triggers]\n188\t        assert AttacksTriggeredEvent in event_types\n189\t\n190\t    def test_trigger_condition_fires_only_for_self(self) -> None:\n191\t        \"\"\"The trigger condition must match only when this card is the attacker.\"\"\"\n192\t        game = create_game()\n193\t        p1 = game.players[0]\n194\t        card = TheDawningArchaic(owner=p1, controller=p1)\n195\t        card.register_triggers(game)\n196\t\n197\t        triggers = [\n198\t            t for t in game.trigger_manager.get_triggers_for_source(card)\n199\t            if t.event_type is AttacksTriggeredEvent\n200\t        ]\n201\t        assert triggers, \"No AttacksTriggeredEvent trigger registered\"\n202\t        trigger = triggers[0]\n203\t\n204\t        other = Creature(name=\"Other Creature\", base_power=2, base_toughness=2)\n205\t        event_self = AttacksTriggeredEvent(creature=card, attacker=card)\n206\t        event_other = AttacksTriggeredEvent(creature=other, attacker=other)\n207\t\n208\t        if trigger.condition is not None:\n209\t            assert trigger.condition(game, event_self) is True\n210\t            assert trigger.condition(game, event_other) is False\n211\t\n212\t\n213\t# ---------------------------------------------------------------------------\n214\t# Attack trigger — effect: cast from graveyard\n215\t# ---------------------------------------------------------------------------\n216\t\n217\t\n218\tclass TestTheDawningArchaicAttackEffect:\n219\t    \"\"\"When the attack trigger resolves, it should enable casting an instant\n220\t    or sorcery from the graveyard without paying mana cost.\"\"\"\n221\t\n222\t    def test_trigger_effect_runs_without_raising_on_empty_graveyard(self) -> None:\n223\t        \"\"\"With no instants/sorceries in graveyard, effect must not crash.\"\"\"\n224\t        game = create_game()\n225\t        p1 = game.players[0]\n226\t        card = TheDawningArchaic(owner=p1, controller=p1)\n227\t        card.register_triggers(game)\n228\t\n229\t        triggers = [\n230\t            t for t in game.trigger_manager.get_triggers_for_source(card)\n231\t            if t.event_type is AttacksTriggeredEvent\n232\t        ]\n233\t        assert triggers\n234\t        # Invoke the trigger effect directly (simulating stack resolution).\n235\t        triggers[0].effect(game)\n236\t\n237\t    def test_trigger_moves_instant_from_graveyard_to_stack_or_exile(self) -> None:\n238\t        \"\"\"After the trigger resolves with an instant in the graveyard,\n239\t        the instant should no longer be in the graveyard (it was cast or exiled).\"\"\"\n240\t        game = create_game()\n241\t        p1 = game.players[0]\n242\t        instant = Instant(name=\"Shock\", owner=p1, controller=p1)\n243\t        set_board_state(game, 0, graveyard=[instant])\n244\t        card = TheDawningArchaic(owner=p1, controller=p1)\n245\t        card.register_triggers(game)\n246\t\n247\t        triggers = [\n248\t            t for t in game.trigger_manager.get_triggers_for_source(card)\n249\t            if t.event_type is AttacksTriggeredEvent\n250\t        ]\n251\t        assert triggers\n252\t        triggers[0].effect(game)\n253\t\n254\t        # After resolution, the instant must have left the graveyard.\n255\t        graveyard = game.get_graveyard(p1)\n256\t        # The card may be on the stack, battlefield, or exile — but not graveyard.\n257\t        assert not graveyard.contains(instant)\n258\t\n259\t\n260\t# ---------------------------------------------------------------------------\n261\t# Exile-instead replacement\n262\t# ---------------------------------------------------------------------------\n263\t\n264\t\n265\tclass TestTheDawningArchaicExileReplacement:\n266\t    \"\"\"When the graveyard-cast spell would go to graveyard, exile it instead.\n267\t\n268\t    The card registers (or arranges for) a replacement effect that redirects\n269\t    that particular spell from graveyard to exile.\n270\t    \"\"\"\n271\t\n272\t    def test_spell_cast_via_trigger_goes_to_exile_not_graveyard(self) -> None:\n273\t        \"\"\"The overall contract: a spell cast via the attack trigger that\n274\t        would normally go to the graveyard ends up in exile instead.\"\"\"\n275\t        game = create_game()\n276\t        p1 = game.players[0]\n277\t\n278\t        # A simple sorcery that does nothing on resolution — it will end up\n279\t        # in the graveyard by default if no replacement is applied.\n280\t        class _NoopSorcery(Sorcery):\n281\t            def on_resolve(self, game):  # type: ignore[override]\n282\t                pass\n283\t\n284\t        sorcery = _NoopSorcery(name=\"Noop Sorcery\", owner=p1, controller=p1)\n285\t        set_board_state(game, 0, graveyard=[sorcery])\n286\t\n287\t        card = TheDawningArchaic(owner=p1, controller=p1)\n288\t        card.register_triggers(game)\n289\t\n290\t        triggers = [\n291\t            t for t in game.trigger_manager.get_triggers_for_source(card)\n292\t            if t.event_type is AttacksTriggeredEvent\n293\t        ]\n294\t        assert triggers\n295\t        triggers[0].effect(game)\n296\t\n297\t        # After the trigger effect runs, the sorcery must NOT be in the\n298\t        # graveyard (it was moved elsewhere — stack, exile, etc.).\n299\t        graveyard = game.get_graveyard(p1)\n300\t        assert not graveyard.contains(sorcery)\n301\t"}]},"parent_tool_use_id":"toolu_01888PDpT65h8bYdpL8FstJV","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c","uuid":"ab8aa729-f04a-436d-abd7-01b26aa1af08","timestamp":"2026-05-28T07:39:27.720Z","subagent_type":"Tester","task_description":"Tester for sos_13"}
