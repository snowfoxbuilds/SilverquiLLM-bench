15\t      ]\n116\t    },\n117\t    {\n118\t      \"card\": \"sos_4\",\n119\t      \"tests\": [\n120\t        {\n121\t          \"path\": \"cards/sos/sos_4/tests.py\",\n122\t          \"summary\": \"Tests for sos_4 Together as One: static properties, colors_spent converge attribute, on_resolve with X=0/1/3/5, creature vs player damage, life gain to controller\"\n123\t        }\n124\t      ],\n125\t      \"implementation\": [\n126\t        {\n127\t          \"path\": \"cards/sos/sos_4/card_impl.py\",\n128\t          \"summary\": \"TogetherAsOne: Sorcery with colors_spent, on_resolve draws X cards, deals X damage, controller gains X life with GainsLifeTriggeredEvent fired\"\n129\t        }\n130\t      ]\n131\t    },\n132\t    {\n133\t      \"card\": \"sos_57\",\n134\t      \"tests\": [\n135\t        {\n136\t          \"path\": \"cards/sos/sos_57/tests.py\",\n137\t          \"summary\": \"tests for sos_57 Mana Sculpt: static properties, counterspell effect (removes from stack), Wizard conditional for delayed mana trigger registration, and mana amount equal to countered spell's CMC\"\n138\t        }\n139\t      ],\n140\t      \"implementation\": [\n141\t        {\n142\t          \"path\": \"cards/sos/sos_57/card_impl.py\",\n143\t          \"summary\": \"ManaSculpt: Instant that counters target spell from stack and registers a one-shot BeginningOfMainPhaseTriggeredEvent trigger for colorless mana equal to countered spell's CMC if controller has a Wizard\"\n144\t        },\n145\t        {\n146\t          \"path\": \"engine/events.py\",\n147\t          \"summary\": \"Added BeginningOfMainPhaseTriggeredEvent dataclass with active_player and phase fields\"\n148\t        },\n149\t        {\n150\t          \"path\": \"engine/turn.py\",\n151\t          \"summary\": \"Fire BeginningOfMainPhaseTriggeredEvent at the start of PRECOMBAT_MAIN and POSTCOMBAT_MAIN phases in run_turn()\"\n152\t        }\n153\t      ]\n154\t    },\n155\t    {\n156\t      \"card\": \"sos_97\",\n157\t      