{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013EAm3gEDpwNhJm5kW4zN4Q","type":"tool_result","content":"1\t\"\"\"Reference test for FDN 215 — Bushwhack.\n2\t\n3\tIllustrative test covering **modal-choice / mode selection** mechanics.\n4\tBushwhack is a \"Choose one\" sorcery; the active mode is recorded on the\n5\tcard as ``chosen_mode`` (an int index into ``get_modes()``) and\n6\t``on_resolve`` dispatches on that value.\n7\t\"\"\"\n8\t\n9\tfrom __future__ import annotations\n10\t\n11\tfrom cards.fdn.fdn_215.card_impl import Bushwhack\n12\tfrom engine.card import Mode, Sorcery\n13\tfrom engine.types import CardType, ManaCost, Supertype, Zone\n14\tfrom test_utils import create_game\n15\t\n16\t\n17\tclass TestBushwhackProperties:\n18\t    \"\"\"Static card data should match the FDN 215 spec.\"\"\"\n19\t\n20\t    def test_is_sorcery(self) -> None:\n21\t        card = Bushwhack(owner=None)\n22\t        assert isinstance(card, Sorcery)\n23\t\n24\t    def test_name(self) -> None:\n25\t        assert Bushwhack(owner=None).name == \"Bushwhack\"\n26\t\n27\t    def test_mana_cost(self) -> None:\n28\t        assert Bushwhack(owner=None).mana_cost == ManaCost.parse(\"{G}\")\n29\t\n30\t\n31\tclass TestBushwhackModalDeclaration:\n32\t    \"\"\"get_modes() should declare exactly two modes.\"\"\"\n33\t\n34\t    def test_returns_two_modes(self) -> None:\n35\t        modes = Bushwhack(owner=None).get_modes()\n36\t        assert len(modes) == 2\n37\t\n38\t    def test_each_mode_is_mode_instance(self) -> None:\n39\t        modes = Bushwhack(owner=None).get_modes()\n40\t        for m in modes:\n41\t            assert isinstance(m, Mode)\n42\t\n43\t\n44\tclass TestBushwhackModeSelection:\n45\t    \"\"\"chosen_mode drives the on_resolve branch.\"\"\"\n46\t\n47\t    def test_chosen_mode_defaults_to_none(self) -> None:\n48\t        card = Bushwhack(owner=None)\n49\t        assert card.chosen_mode is None\n50\t\n51\t    def test_chosen_mode_zero_runs_land_search(self) -> None:\n52\t        \"\"\"Mode 0 = search library for a basic land. With no basic lands\n53\t        in the library, the search no-ops but does not raise.\"\"\"\n54\t        from engine.card import CardImpl\n55\t\n56\t        game = create_game()\n57\t        p1 = game.players[0]\n58\t        # Library is empty — search will find nothing but should not crash.\n59\t        card = Bushwhack(owner=p1, controller=p1)\n60\t        card.chosen_mode = 0\n61\t        card.on_resolve(game)\n62\t        # No card moved to hand.\n63\t        assert len(p1.zones[Zone.HAND].get_all()) == 0\n64\t\n65\t    def test_chosen_mode_one_runs_fight_branch(self) -> None:\n66\t        \"\"\"Mode 1 = fight. With no chosen_targets, the fight branch no-ops.\"\"\"\n67\t        game = create_game()\n68\t        p1 = game.players[0]\n69\t        card = Bushwhack(owner=p1, controller=p1)\n70\t        card.chosen_mode = 1\n71\t        # No chosen_targets — fight branch exits without dealing damage.\n72\t        card.on_resolve(game)\n73\t\n74\t    def test_no_mode_skips_resolution(self) -> None:\n75\t        \"\"\"When chosen_mode is None, on_resolve returns immediately.\"\"\"\n76\t        game = create_game()\n77\t        p1 = game.players[0]\n78\t        card = Bushwhack(owner=p1, controller=p1)\n79\t        # chosen_mode left as None.\n80\t        card.on_resolve(game)\n81\t        assert len(p1.zones[Zone.HAND].get_all()) == 0\n82\t"}]},"parent_tool_use_id":"toolu_01VeYD15FWMP324ZP62Sv5vg","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c","uuid":"ccc57517-3a17-4ede-8b7b-bf53e32d88b6","timestamp":"2026-05-28T07:49:34.497Z","subagent_type":"Tester","task_description":"Tester for sos_57"}
