{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DYNVQCnXjWmqHi4PYWMZYU","type":"tool_result","content":"1\t\"\"\"Card implementation for The Dawning Archaic (SOS 1).\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.types import CardType, Keyword, ManaCost, Supertype, Zone\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t\n13\t\n14\tclass TheDawningArchaic(Creature):\n15\t    \"\"\"The Dawning Archaic — {10} — Legendary Creature — Avatar — 7/7.\n16\t\n17\t    This spell costs {1} less to cast for each instant and sorcery card in\n18\t    your graveyard.\n19\t    Reach\n20\t    Whenever The Dawning Archaic attacks, you may cast target instant or\n21\t    sorcery card from your graveyard without paying its mana cost.  If that\n22\t    spell would be put into your graveyard, exile it instead.\n23\t\n24\t    SOS collector number 1.\n25\t    \"\"\"\n26\t\n27\t    def __init__(self, **kwargs: Any) -> None:\n28\t        kwargs.setdefault(\"name\", \"The Dawning Archaic\")\n29\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{10}\"))\n30\t        kwargs.setdefault(\"base_power\", 7)\n31\t        kwargs.setdefault(\"base_toughness\", 7)\n32\t        kwargs.setdefault(\"keywords\", Keyword.REACH)\n33\t        kwargs.setdefault(\"subtypes\", {\"Avatar\"})\n34\t        kwargs.setdefault(\n35\t            \"rules_text\",\n36\t            \"This spell costs {1} less to cast for each instant and sorcery \"\n37\t            \"card in your graveyard.\\nReach\\nWhenever The Dawning Archaic \"\n38\t            \"attacks, you may cast target instant or sorcery card from your \"\n39\t            \"graveyard without paying its mana cost. If that spell would be \"\n40\t            \"put into your graveyard, exile it instead.\",\n41\t        )\n42\t        # Ensure supertypes includes LEGENDARY.\n43\t        supertypes: set[Supertype] = (kwargs.get(\"supertypes\") or set()) | {Supertype.LEGENDARY}\n44\t        kwargs[\"supertypes\"] = supertypes\n45\t        super().__init__(**kwargs)\n46\t\n47\t    # ------------------------------------------------------------------\n48\t    # Cost reduction\n49\t    # ------------------------------------------------------------------\n50\t\n51\t    def cost_reduction(self, game: \"GameState\") -> int:\n52\t        \"\"\"Return count of instant and sorcery cards in controller's graveyard.\"\"\"\n53\t        controller = self.controller\n54\t        if controller is None:\n55\t            return 0\n56\t        graveyard = game.get_graveyard(controller)\n57\t        count = 0\n58\t        for card in graveyard.get_all():\n59\t            card_types = getattr(card, \"card_types\", set())\n60\t            if CardType.INSTANT in card_types or CardType.SORCERY in card_types:\n61\t                count += 1\n62\t        return count\n63\t\n64\t    # ------------------------------------------------------------------\n65\t    # Triggers\n66\t    # ------------------------------------------------------------------\n67\t\n68\t    def register_triggers(self, game: \"GameState\") -> None:\n69\t        \"\"\"Register the attack trigger for casting from graveyard.\"\"\"\n70\t        from engine.events import AttacksTriggeredEvent\n71\t        from engine.triggers import TriggerRegistration\n72\t\n73\t        source = self\n74\t        controller = getattr(self, \"controller\", None) or game.active_player\n75\t\n76\t        def _condition(game: \"GameState\", event: Any) -> bool:\n77\t            return event.creature is source or event.attacker is source\n78\t\n79\t        def _effect(game: \"GameState\") -> None:\n80\t            ctrl = getattr(source, \"controller\", None)\n81\t            if ctrl is None:\n82\t                return\n83\t            graveyard = game.get_graveyard(ctrl)\n84\t            # Find the first instant or sorcery in the graveyard.\n85\t            candidates = [\n86\t                c for c in graveyard.get_all()\n87\t                if CardType.INSTANT in getattr(c, \"card_types\", set())\n88\t                or CardType.SORCERY in getattr(c, \"card_types\", set())\n89\t            ]\n90\t            if not candidates:\n91\t                return\n92\t            # Choose the spell to cast (deterministic: first candidate).\n93\t            try:\n94\t                chosen = ctrl.choose(candidates, \"Choose instant or sorcery to cast from graveyard\")\n95\t            except Exception:\n96\t                chosen = candidates[0]\n97\t            if chosen is None:\n98\t                return\n99\t            # Move the chosen spell from graveyard to exile\n100\t            # (implementing \"cast from graveyard, exile instead of graveyard\").\n101\t            exile_zone = ctrl.zones[Zone.EXILE]\n102\t            try:\n103\t                graveyard.remove(chosen)\n104\t                exile_zone.add(chosen)\n105\t            except Exception:\n106\t                pass\n107\t\n108\t        game.trigger_manager.register(\n109\t            TriggerRegistration(\n110\t                event_type=AttacksTriggeredEvent,\n111\t                condition=_condition,\n112\t                effect=_effect,\n113\t                source=self,\n114\t                controller=controller,\n115\t            )\n116\t        )\n117\t"}]},"parent_tool_use_id":"toolu_01UcC3bg9WrVK4sjPExo4PoM","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c","uuid":"de942fbf-0ec3-43f4-bd1a-4f8892914978","timestamp":"2026-05-28T07:27:03.251Z","subagent_type":"Reviewer","task_description":"Reviewer for sos_1"}
