ted-answers fixture as above, plus a test helper that can advance the game through a full PRECOMBAT_MAIN trigger cycle (fire BeginningOfMainPhaseTriggeredEvent → resolve stack → confirm copy on battlefield/stack).\"\n  }\n]\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":148,"cache_read_input_tokens":52541,"cache_creation":{"ephemeral_5m_input_tokens":148,"ephemeral_1h_input_tokens":0},"output_tokens":53,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01U4cYF49JRGR9TT1iZ5VVWR","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c","uuid":"30fcded1-cbd5-4470-93b7-6238535df1da","request_id":"req_011CbUdVkbRKszna66HN7ynm","subagent_type":"Tester","task_description":"Tester for sos_120"}
