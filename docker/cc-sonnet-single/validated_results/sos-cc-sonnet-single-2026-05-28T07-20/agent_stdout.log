{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MmLP1TqMzrH9hiswRUGV8W","type":"tool_result","content":"1\t\"\"\"Card implementation for Silverquill, the Disputant.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.types import CardType, Keyword, ManaCost, Supertype\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t\n13\t\n14\tclass SilverquillTheDisputant(Creature):\n15\t    \"\"\"Silverquill, the Disputant — {2}{W}{B} — Legendary Creature — Elder Dragon.\n16\t\n17\t    Flying, vigilance\n18\t    Each instant and sorcery spell you cast has casualty 1. (As you cast that\n19\t    spell, you may sacrifice a creature with power 1 or greater. When you do,\n20\t    copy the spell and you may choose new targets for the copy.)\n21\t    \"\"\"\n22\t\n23\t    def __init__(self, **kwargs: Any) -> None:\n24\t        kwargs.setdefault(\"name\", \"Silverquill, the Disputant\")\n25\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{2}{W}{B}\"))\n26\t        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n27\t        kwargs.setdefault(\"subtypes\", {\"Elder\", \"Dragon\"})\n28\t        kwargs.setdefault(\"keywords\", Keyword.FLYING | Keyword.VIGILANCE)\n29\t        kwargs.setdefault(\"base_power\", 4)\n30\t        kwargs.setdefault(\"base_toughness\", 4)\n31\t        kwargs.setdefault(\n32\t            \"rules_text\",\n33\t            \"Flying, vigilance\\n\"\n34\t            \"Each instant and sorcery spell you cast has casualty 1. \"\n35\t            \"(As you cast that spell, you may sacrifice a creature with power 1 \"\n36\t            \"or greater. When you do, copy the spell and you may choose new \"\n37\t            \"targets for the copy.)\",\n38\t        )\n39\t        super().__init__(**kwargs)\n40\t\n41\t    def get_casualty_value(self, card: Any) -> int | None:\n42\t        \"\"\"Return 1 if *card* is an instant or sorcery controlled by this card's controller.\n43\t\n44\t        Returns None (falsy) for non-instant/sorcery cards, opponent's cards,\n45\t        or when this permanent has no controller.\n46\t        \"\"\"\n47\t        # Guard: uncontrolled Silverquill grants nothing.\n48\t        ctrl = getattr(self, \"controller\", None)\n49\t        if ctrl is None:\n50\t            return None\n51\t\n52\t        # Only grant casualty to spells controlled by this dragon's controller.\n53\t        card_ctrl = getattr(card, \"controller\", None) or getattr(card, \"owner\", None)\n54\t        if card_ctrl is not None and card_ctrl is not ctrl:\n55\t            return None\n56\t\n57\t        # Only instants and sorceries qualify.\n58\t        card_types = getattr(card, \"card_types\", set())\n59\t        if CardType.INSTANT in card_types or CardType.SORCERY in card_types:\n60\t            return 1\n61\t\n62\t        return None\n63\t\n64\t    def _apply_casualty_for_spell(self, game: \"GameState\", spell: Any) -> None:\n65\t        \"\"\"Apply the casualty 1 mechanic for *spell* if applicable.\n66\t\n67\t        Casualty 1 only applies to instants and sorceries.  If there are no\n68\t        eligible creatures with power >= 1 on the controller's battlefield,\n69\t        the casualty offer is skipped.  Otherwise the controller is asked\n70\t        whether they want to sacrifice a creature; if yes they choose which\n71\t        creature (power >= 1) to sacrifice, the creature goes to the\n72\t        graveyard, and a copy of the spell is pushed onto the stack.\n73\t\n74\t        Parameters:\n75\t            game: The current game state.\n76\t            spell: The card being cast (must be instant or sorcery for casualty\n77\t                to apply).\n78\t        \"\"\"\n79\t        from engine.game import sacrifice\n80\t        from engine.player import ScriptExhaustedError\n81\t        from engine.stack import StackObject, copy_spell\n82\t\n83\t        # Casualty only applies to instants and sorceries.\n84\t        card_types = getattr(spell, \"card_types\", set())\n85\t        if CardType.INSTANT not in card_types and CardType.SORCERY not in card_types:\n86\t            return\n87\t\n88\t        # Resolve controller: use spell.controller as the primary source.\n89\t        # Only skip if spell.controller is actually None — do not silently fall\n90\t        # back to self.controller, which would incorrectly apply casualty to\n91\t        # uncontrolled or opponent spells.\n92\t        ctrl = spell.controller\n93\t        if ctrl is None:\n94\t            return\n95\t\n96\t        # Only apply casualty when the spell's controller matches Silverquill's\n97\t        # controller.  Opponent's spells must not trigger this effect.\n98\t        if ctrl is not self.controller:\n99\t            return\n100\t\n101\t        # Collect eligible sacrifice targets: creatures with power >= 1\n102\t        # controlled by ctrl that are on the battlefield.\n103\t        # Silverquill itself is excluded — it cannot be its own casualty sacrifice.\n104\t        bf = game.get_battlefield(ctrl)\n105\t        eligibles = [\n106\t            c for c in bf.get_all()\n107\t            if (\n108\t                c is not self\n109\t                and CardType.CREATURE in getattr(c, \"card_types\", set())\n110\t                and getattr(c, \"power\", getattr(c, \"base_power\", 0)) >= 1\n111\t            )\n112\t        ]\n113\t\n114\t        # If no eligible creatures, casualty cannot be used.\n115\t        if not eligibles:\n116\t            return\n117\t\n118\t        # Ask the controller if they want to use casualty.\n119\t        try:\n120\t            wants_casualty = ctrl.choose_yes_no(\n121\t                \"Silverquill, the Disputant: Sacrifice a creature for casualty 1?\"\n122\t            )\n123\t        except ScriptExhaustedError:\n124\t            wants_casualty = False\n125\t\n126\t        if not wants_casualty:\n127\t            return\n128\t\n129\t        # Ask which creature to sacrifice.\n130\t        try:\n131\t            chosen = ctrl.choose_card(eligibles, \"Choose a creature to sacrifice for casualty 1\")\n132\t        except ScriptExhaustedError:\n133\t            chosen = eligibles[0] if eligibles else None\n134\t\n135\t        if chosen is None:\n136\t            return\n137\t\n138\t        # Sacrifice the chosen creature.\n139\t        sacrifice(game, ctrl, chosen)\n140\t\n141\t        # Use the engine's copy_spell utility (via a temporary StackObject wrapper)\n142\t        # so the copy has independent mutable state and avoids shared-state bugs.\n143\t        original_targets = list(getattr(spell, \"chosen_targets\", []))\n144\t        temp_stack_obj = StackObject(\n145\t            source=spell,\n146\t            controller=ctrl,\n147\t            targets=original_targets,\n148\t        )\n149\t        copy_obj = copy_spell(game, temp_stack_obj, ctrl)\n150\t        game.stack.push(copy_obj)\n151\t\n152\t    def register_triggers(self, game: \"GameState\") -> None:\n153\t        \"\"\"Register a trigger so each instant/sorcery the controller casts has casualty 1.\"\"\"\n154\t        from engine.events import SpellCastTriggeredEvent\n155\t        from engine.triggers import TriggerRegistration\n156\t\n157\t        source = self\n158\t\n159\t        # Use a mutable container to pass the matched spell from _condition to\n160\t        # _effect since the TriggerRegistration effect receives only (game).\n161\t        _pending: list[Any] = []\n162\t\n163\t        def _condition(g: \"GameState\", event: Any) -> bool:\n164\t            # Silverquill must still be on the battlefield.\n165\t            ctrl = source.controller\n166\t            if ctrl is None:\n167\t                return False\n168\t            on_bf = any(\n169\t                g.get_battlefield(p).contains(source) for p in g.players\n170\t            )\n171\t            if not on_bf:\n172\t                return False\n173\t\n174\t            # Only fire for instant/sorcery spells cast by Silverquill's controller.\n175\t            spell = getattr(event, \"spell\", None) or getattr(event, \"card\", None)\n176\t            if spell is None:\n177\t                return False\n178\t            spell_ctrl = getattr(spell, \"controller\", None)\n179\t            if spell_ctrl is not ctrl:\n180\t                return False\n181\t            card_types = getattr(spell, \"card_types\", set())\n182\t            if CardType.INSTANT not in card_types and CardType.SORCERY not in card_types:\n183\t                return False\n184\t\n185\t            # Capture spell reference so _effect can invoke casualty.\n186\t            _pending.clear()\n187\t            _pending.append(spell)\n188\t            return True\n189\t\n190\t        def _effect(g: \"GameState\") -> None:\n191\t            if not _pending:\n192\t                return\n193\t            spell = _pending.pop()\n194\t            source._apply_casualty_for_spell(g, spell)\n195\t\n196\t        ctrl = getattr(self, \"controller\", None) or game.active_player\n197\t        game.trigger_manager.register(\n198\t            TriggerRegistration(\n199\t                event_type=SpellCastTriggeredEvent,\n200\t                condition=_condition,\n201\t                effect=_effect,\n202\t                source=self,\n203\t                controller=ctrl,\n204\t            )\n205\t        )\n206\t"}]},"parent_tool_use_id":"toolu_01X8orE9WxHdL5WPGzSBonbq","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c","uuid":"1c6688f1-916e-41ef-9213-af8030055ba1","timestamp":"2026-05-28T08:52:00.864Z","subagent_type":"Implementer","task_description":"Implementer for sos_245"}
