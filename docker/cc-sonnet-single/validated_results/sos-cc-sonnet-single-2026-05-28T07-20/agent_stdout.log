          \"summary\": \"tests for sos_13 Emeritus of Truce // Swords to Plowshares: static properties, ETB trigger registration/effect (Inkling token creation), prepared mechanic state, and cast_prepared_spell (exile + life gain using current power)\"\n43\t        }\n44\t      ],\n45\t      \"implementation\": [\n46\t        {\n47\t          \"path\": \"cards/sos/sos_13/card_impl.py\",\n48\t          \"summary\": \"EmeritusOfTruceSwordsToPlowshares: revised cast_prepared_spell to use current in-game power (getattr power fallback to base_power) instead of base_power for life gain, per Swords to Plowshares rule 701.13a\"\n49\t        }\n50\t      ]\n51\t    },\n52\t    {\n53\t      \"card\": \"sos_4\",\n54\t      \"tests\": [\n55\t        {\n56\t          \"path\": \"cards/sos/sos_4/tests.py\",\n57\t          \"summary\": \"Tests for sos_4 Together as One: static properties, colors_spent converge attribute, on_resolve with X=0/1/3/5, creature vs player damage, life gain to controller\"\n58\t        }\n59\t      ],\n60\t      \"implementation\": [\n61\t        {\n62\t          \"path\": \"cards/sos/sos_4/card_impl.py\",\n63\t          \"summary\": \"TogetherAsOne: Sorcery with colors_spent, on_resolve draws X cards, deals X damage, controller gains X life with GainsLifeTriggeredEvent fired\"\n64\t        }\n65\t      ]\n66\t    },\n67\t    {\n68\t      \"card\": \"sos_57\",\n69\t      \"tests\": [\n70\t        {\n71\t          \"path\": \"cards/sos/sos_57/tests.py\",\n72\t          \"summary\": \"tests for sos_57 Mana Sculpt: static properties, counterspell effect (removes from stack), Wizard conditional for delayed mana trigger registration, and mana amount equal to countered spell's CMC\"\n73\t        }\n74\t      ],\n75\t      \"implementation\": [\n76\t        {\n77\t          \"path\": \"cards/sos/sos_57/card_impl.py\",\n78\t          \"summary\": \"ManaSculpt: Instant that counters target spell from stack and registers a one-shot BeginningOfMainPhaseTriggeredEve