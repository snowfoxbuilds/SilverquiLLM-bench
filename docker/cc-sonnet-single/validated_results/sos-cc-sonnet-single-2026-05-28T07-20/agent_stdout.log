{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018Ce5HYwzfxh3hjSAY7Fuq8","type":"tool_result","content":"1\t\"\"\"Card implementation for The Dawning Archaic (SOS 1).\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.types import CardType, Keyword, ManaCost, Supertype, Zone\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t\n13\t\n14\tclass TheDawningArchaic(Creature):\n15\t    \"\"\"The Dawning Archaic — {10} — Legendary Creature — Avatar — 7/7.\n16\t\n17\t    This spell costs {1} less to cast for each instant and sorcery card in\n18\t    your graveyard.\n19\t    Reach\n20\t    Whenever The Dawning Archaic attacks, you may cast target instant or\n21\t    sorcery card from your graveyard without paying its mana cost.  If that\n22\t    spell would be put into your graveyard, exile it instead.\n23\t\n24\t    SOS collector number 1.\n25\t    \"\"\"\n26\t\n27\t    def __init__(self, **kwargs: Any) -> None:\n28\t        kwargs.setdefault(\"name\", \"The Dawning Archaic\")\n29\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{10}\"))\n30\t        kwargs.setdefault(\"base_power\", 7)\n31\t        kwargs.setdefault(\"base_toughness\", 7)\n32\t        kwargs.setdefault(\"keywords\", Keyword.REACH)\n33\t        kwargs.setdefault(\"subtypes\", {\"Avatar\"})\n34\t        kwargs.setdefault(\n35\t            \"rules_text\",\n36\t            \"This spell costs {1} less to cast for each instant and sorcery \"\n37\t            \"card in your graveyard.\\nReach\\nWhenever The Dawning Archaic \"\n38\t            \"attacks, you may cast target instant or sorcery card from your \"\n39\t            \"graveyard without paying its mana cost. If that spell would be \"\n40\t            \"put into your graveyard, exile it instead.\",\n41\t        )\n42\t        # Ensure supertypes includes LEGENDARY.\n43\t        supertypes: set[Supertype] = (kwargs.get(\"supertypes\") or set()) | {Supertype.LEGENDARY}\n44\t        kwargs[\"supertypes\"] = supertypes\n45\t        super().__init__(**kwargs)\n46\t\n47\t    # ------------------------------------------------------------------\n48\t    # Cost reduction\n49\t    # ------------------------------------------------------------------\n50\t\n51\t    def cost_reduction(self, game: \"GameState\") -> int:\n52\t        \"\"\"Return count of instant and sorcery cards in controller's graveyard.\"\"\"\n53\t        controller = self.controller\n54\t        if controller is None:\n55\t            return 0\n56\t        graveyard = game.get_graveyard(controller)\n57\t        count = 0\n58\t        for card in graveyard.get_all():\n59\t            card_types = getattr(card, \"card_types\", set())\n60\t            if CardType.INSTANT in card_types or CardType.SORCERY in card_types:\n61\t                count += 1\n62\t        return count\n63\t\n64\t    # ------------------------------------------------------------------\n65\t    # Triggers\n66\t    # ------------------------------------------------------------------\n67\t\n68\t    def register_triggers(self, game: \"GameState\") -> None:\n69\t        \"\"\"Register the attack trigger for casting from graveyard.\"\"\"\n70\t        from engine.events import AttacksTriggeredEvent\n71\t        from engine.triggers import TriggerRegistration\n72\t\n73\t        source = self\n74\t        controller = getattr(self, \"controller\", None) or game.active_player\n75\t\n76\t        def _condition(game: \"GameState\", event: Any) -> bool:\n77\t            return event.creature is source or event.attacker is source\n78\t\n79\t        def _effect(game: \"GameState\") -> None:\n80\t            from engine.casting import cast_spell_free\n81\t            from engine.events import MoveToGraveyardReplacementEvent\n82\t            from engine.replacement_effects import ReplacementEffect\n83\t\n84\t            ctrl = getattr(source, \"controller\", None)\n85\t            if ctrl is None:\n86\t                return\n87\t            graveyard = game.get_graveyard(ctrl)\n88\t            # Find all instants and sorceries in the graveyard.\n89\t            candidates = [\n90\t                c for c in graveyard.get_all()\n91\t                if CardType.INSTANT in getattr(c, \"card_types\", set())\n92\t                or CardType.SORCERY in getattr(c, \"card_types\", set())\n93\t            ]\n94\t            if not candidates:\n95\t                return\n96\t\n97\t            # The cast is optional — ask the controller if they want to cast.\n98\t            try:\n99\t                wants_to_cast = ctrl.choose_yes_no(\n100\t                    \"You may cast target instant or sorcery from your graveyard \"\n101\t                    \"without paying its mana cost.\"\n102\t                )\n103\t            except Exception:\n104\t                # Default to yes when no scripted answer is available.\n105\t                wants_to_cast = True\n106\t\n107\t            if not wants_to_cast:\n108\t                return\n109\t\n110\t            # Choose which spell to cast.\n111\t            try:\n112\t                chosen = ctrl.choose(\n113\t                    candidates,\n114\t                    \"Choose instant or sorcery to cast from graveyard\",\n115\t                )\n116\t            except Exception:\n117\t                chosen = candidates[0]\n118\t            if chosen is None:\n119\t                return\n120\t\n121\t            # Register a replacement effect so that if the chosen spell would\n122\t            # be put into the graveyard after resolving, it goes to exile instead.\n123\t            # This satisfies the oracle text: \"If that spell would be put into\n124\t            # your graveyard, exile it instead.\"\n125\t            chosen_card = chosen  # close over the specific card chosen\n126\t\n127\t            def _exile_replacement(\n128\t                g: \"GameState\", event: MoveToGraveyardReplacementEvent\n129\t            ) -> MoveToGraveyardReplacementEvent:\n130\t                event.destination = \"exile\"\n131\t                return event\n132\t\n133\t            def _replacement_condition(\n134\t                g: \"GameState\", event: MoveToGraveyardReplacementEvent\n135\t            ) -> bool:\n136\t                # Fire only for this specific card being moved from the stack.\n137\t                return (\n138\t                    getattr(event, \"card_obj\", None) is chosen_card\n139\t                    or getattr(event, \"card\", None) is chosen_card\n140\t                )\n141\t\n142\t            replacement = ReplacementEffect(\n143\t                event_type=MoveToGraveyardReplacementEvent,\n144\t                source=chosen_card,\n145\t                condition=_replacement_condition,\n146\t                replacement=_exile_replacement,\n147\t                controller=ctrl,\n148\t            )\n149\t            game.replacement_manager.register(replacement)\n150\t\n151\t            # Cast the chosen spell using the free-cast pipeline — it goes on\n152\t            # the stack and can be countered, responded to, and resolves normally.\n153\t            try:\n154\t                cast_spell_free(game, ctrl, chosen, Zone.GRAVEYARD)\n155\t            except Exception:\n156\t                # If casting fails (e.g. targeting failed), remove the\n157\t                # replacement effect we just registered.\n158\t                game.replacement_manager.unregister(chosen_card)\n159\t\n160\t        game.trigger_manager.register(\n161\t            TriggerRegistration(\n162\t                event_type=AttacksTriggeredEvent,\n163\t                condition=_condition,\n164\t                effect=_effect,\n165\t                source=self,\n166\t                controller=controller,\n167\t            )\n168\t        )\n169\t"}]},"parent_tool_use_id":"toolu_011xz6oLC5Frvp92ie79V1tq","session_id":"eab38cf5-7da5-43e8-ba85-a59c2942584c","uuid":"764180c4-9ed9-4c6a-b316-d502d5792ac5","timestamp":"2026-05-28T07:53:42.481Z","subagent_type":"Implementer","task_description":"Implementer for sos_57"}
