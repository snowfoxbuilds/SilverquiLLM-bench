{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01L9K4aDJ7pmAuwyqQ2D121P","type":"tool_result","content":"1\t\"\"\"Tests for SOS 257 — Great Hall of the Biblioplex.\n2\t\n3\tCovers:\n4\t- Static card properties (name, type line, no mana cost, card type LAND)\n5\t- can_cast returns False (lands are not cast)\n6\t- get_mana_abilities returns at least 2 mana abilities\n7\t- First mana ability: {T} produces {C} (colorless mana)\n8\t- First mana ability: tapping once works; second tap fails (already tapped)\n9\t- Second mana ability: {T} + pay 1 life produces one mana of any color\n10\t- Second mana ability: uses life payment (controller loses 1 life)\n11\t- Second mana ability: land must not already be tapped\n12\t- get_activated_abilities returns at least 1 activated ability\n13\t- Activated ability ({5}): if not a creature, makes it a 2/4 Wizard creature-land\n14\t- Activated ability ({5}): card_types includes both LAND and CREATURE after activation\n15\t- Activated ability ({5}): subtypes include \"Wizard\" after activation\n16\t- Activated ability ({5}): base_power becomes 2, base_toughness becomes 4 after activation\n17\t- Activated ability ({5}): if already a creature, ability does nothing (idempotent guard)\n18\t- Activated ability ({5}): costs 5 generic mana (description or cost structure)\n19\t- Wizard creature mode: register_triggers provides a SpellCastTriggeredEvent trigger\n20\t- Wizard creature mode trigger: fires when controller casts an instant\n21\t- Wizard creature mode trigger: fires when controller casts a sorcery\n22\t- Wizard creature mode trigger: does not fire for opponent's instants/sorceries\n23\t- Wizard creature mode trigger: effect grants +1/+0 until end of turn\n24\t\"\"\"\n25\t\n26\tfrom __future__ import annotations\n27\t\n28\timport pytest\n29\t\n30\tfrom cards.sos.sos_257.card_impl import GreatHallOfTheBiblioplex\n31\tfrom engine.card import Land, Creature, Instant, Sorcery\n32\tfrom engine.events import SpellCastTriggeredEvent\n33\tfrom engine.types import CardType, ManaCost, ManaType, Zone\n34\tfrom test_utils import create_game, set_board_state\n35\t\n36\t\n37\t# ---------------------------------------------------------------------------\n38\t# Static card property tests\n39\t# ---------------------------------------------------------------------------\n40\t\n41\t\n42\tclass TestGreatHallProperties:\n43\t    \"\"\"Static card data should match the SOS 257 spec.\"\"\"\n44\t\n45\t    def test_is_land(self) -> None:\n46\t        card = GreatHallOfTheBiblioplex(owner=None)\n47\t        assert isinstance(card, Land)\n48\t\n49\t    def test_name(self) -> None:\n50\t        card = GreatHallOfTheBiblioplex(owner=None)\n51\t        assert card.name == \"Great Hall of the Biblioplex\"\n52\t\n53\t    def test_no_mana_cost(self) -> None:\n54\t        \"\"\"Lands have no mana cost — mana_cost should be empty/zero CMC.\"\"\"\n55\t        card = GreatHallOfTheBiblioplex(owner=None)\n56\t        assert card.mana_cost.cmc == 0\n57\t\n58\t    def test_card_type_land(self) -> None:\n59\t        card = GreatHallOfTheBiblioplex(owner=None)\n60\t        assert CardType.LAND in card.card_types\n61\t\n62\t    def test_can_cast_returns_false(self) -> None:\n63\t        \"\"\"Lands cannot be cast; they are played as a special action.\"\"\"\n64\t        game = create_game()\n65\t        card = GreatHallOfTheBiblioplex(owner=None)\n66\t        assert card.can_cast(game) is False\n67\t\n68\t\n69\t# ---------------------------------------------------------------------------\n70\t# Mana ability 1: {T} → Add {C}\n71\t# ---------------------------------------------------------------------------\n72\t\n73\t\n74\tclass TestGreatHallColorlessManaAbility:\n75\t    \"\"\"{T}: Add {C} — the basic colorless mana ability.\"\"\"\n76\t\n77\t    def test_has_at_least_two_mana_abilities(self) -> None:\n78\t        card = GreatHallOfTheBiblioplex(owner=None)\n79\t        abilities = card.get_mana_abilities()\n80\t        assert len(abilities) >= 2\n81\t\n82\t    def test_first_ability_adds_colorless_mana(self) -> None:\n83\t        \"\"\"Activating the first ability while untapped adds {C} to the pool.\"\"\"\n84\t        game = create_game()\n85\t        p1 = game.players[0]\n86\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n87\t        card.is_tapped = False\n88\t\n89\t        ability = card.get_mana_abilities()[0]\n90\t        # Pay the tap cost\n91\t        paid = ability.cost(game, card)\n92\t        assert paid is True, \"Cost should succeed on an untapped land\"\n93\t        # Activate the mana effect\n94\t        ability.mana_produced(game)\n95\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 1\n96\t\n97\t    def test_first_ability_taps_the_land(self) -> None:\n98\t        \"\"\"After activating {T}: Add {C}, the land becomes tapped.\"\"\"\n99\t        game = create_game()\n100\t        p1 = game.players[0]\n101\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n102\t        card.is_tapped = False\n103\t\n104\t        ability = card.get_mana_abilities()[0]\n105\t        ability.cost(game, card)\n106\t        assert card.is_tapped is True\n107\t\n108\t    def test_first_ability_fails_when_already_tapped(self) -> None:\n109\t        \"\"\"The cost of {T} cannot be paid if the land is already tapped.\"\"\"\n110\t        game = create_game()\n111\t        p1 = game.players[0]\n112\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n113\t        card.is_tapped = True\n114\t\n115\t        ability = card.get_mana_abilities()[0]\n116\t        paid = ability.cost(game, card)\n117\t        assert paid is False\n118\t\n119\t\n120\t# ---------------------------------------------------------------------------\n121\t# Mana ability 2: {T}, Pay 1 life → Add one mana of any color\n122\t# ---------------------------------------------------------------------------\n123\t\n124\t\n125\tclass TestGreatHallColoredManaAbility:\n126\t    \"\"\"{T}, Pay 1 life: Add one mana of any color (restricted to instants/sorceries).\"\"\"\n127\t\n128\t    def test_second_ability_costs_life(self) -> None:\n129\t        \"\"\"Activating the second ability should reduce life by 1.\"\"\"\n130\t        game = create_game()\n131\t        p1 = game.players[0]\n132\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n133\t        card.is_tapped = False\n134\t        starting_life = p1.life\n135\t\n136\t        ability = card.get_mana_abilities()[1]\n137\t        paid = ability.cost(game, card)\n138\t        assert paid is True, \"Cost should succeed on an untapped land with >0 life\"\n139\t        assert p1.life == starting_life - 1\n140\t\n141\t    def test_second_ability_taps_the_land(self) -> None:\n142\t        \"\"\"After activating the second mana ability, the land should be tapped.\"\"\"\n143\t        game = create_game()\n144\t        p1 = game.players[0]\n145\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n146\t        card.is_tapped = False\n147\t\n148\t        ability = card.get_mana_abilities()[1]\n149\t        ability.cost(game, card)\n150\t        assert card.is_tapped is True\n151\t\n152\t    def test_second_ability_adds_colored_mana(self) -> None:\n153\t        \"\"\"The second ability should add at least 1 total mana after mana_produced fires.\"\"\"\n154\t        game = create_game()\n155\t        p1 = game.players[0]\n156\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n157\t        card.is_tapped = False\n158\t\n159\t        ability = card.get_mana_abilities()[1]\n160\t        ability.cost(game, card)\n161\t        ability.mana_produced(game)\n162\t\n163\t        # At least 1 colored mana should have been added (which specific color\n164\t        # depends on the implementation's default; we only check total colored >=1)\n165\t        colored_total = sum(\n166\t            p1.mana_pool.get(mt)\n167\t            for mt in (ManaType.WHITE, ManaType.BLUE, ManaType.BLACK,\n168\t                       ManaType.RED, ManaType.GREEN)\n169\t        )\n170\t        assert colored_total >= 1\n171\t\n172\t    def test_second_ability_fails_when_already_tapped(self) -> None:\n173\t        \"\"\"The second mana ability's tap cost fails if already tapped.\"\"\"\n174\t        game = create_game()\n175\t        p1 = game.players[0]\n176\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n177\t        card.is_tapped = True\n178\t\n179\t        ability = card.get_mana_abilities()[1]\n180\t        paid = ability.cost(game, card)\n181\t        assert paid is False\n182\t\n183\t    def test_second_ability_does_not_add_colorless(self) -> None:\n184\t        \"\"\"The second ability produces colored mana, not colorless.\"\"\"\n185\t        game = create_game()\n186\t        p1 = game.players[0]\n187\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n188\t        card.is_tapped = False\n189\t\n190\t        # Record colorless before\n191\t        colorless_before = p1.mana_pool.get(ManaType.COLORLESS)\n192\t        ability = card.get_mana_abilities()[1]\n193\t        ability.cost(game, card)\n194\t        ability.mana_produced(game)\n195\t\n196\t        # Colorless mana should not have increased\n197\t        assert p1.mana_pool.get(ManaType.COLORLESS) == colorless_before\n198\t\n199\t\n200\t# ---------------------------------------------------------------------------\n201\t# Activated ability: {5} — animate this land into a 2/4 Wizard creature\n202\t# ---------------------------------------------------------------------------\n203\t\n204\t\n205\tclass TestGreatHallAnimationAbility:\n206\t    \"\"\"{5}: If this land isn't a creature, it becomes a 2/4 Wizard creature-land.\"\"\"\n207\t\n208\t    def test_has_at_least_one_activated_ability(self) -> None:\n209\t        card = GreatHallOfTheBiblioplex(owner=None)\n210\t        abilities = card.get_activated_abilities()\n211\t        assert len(abilities) >= 1\n212\t\n213\t    def test_animation_ability_requires_five_generic_mana(self) -> None:\n214\t        \"\"\"The animation ability's cost requires {5} generic mana.\"\"\"\n215\t        game = create_game()\n216\t        p1 = game.players[0]\n217\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n218\t        # Give exactly 4 mana — should fail\n219\t        p1.mana_pool.add(ManaType.COLORLESS, 4)\n220\t        ability = card.get_activated_abilities()[0]\n221\t        paid = ability.cost(game, card)\n222\t        assert paid is False, \"4 generic mana is insufficient for {5}\"\n223\t\n224\t    def test_animation_ability_succeeds_with_five_mana(self) -> None:\n225\t        \"\"\"The animation ability's cost succeeds when {5} generic mana is available.\"\"\"\n226\t        game = create_game()\n227\t        p1 = game.players[0]\n228\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n229\t        p1.mana_pool.add(ManaType.COLORLESS, 5)\n230\t        ability = card.get_activated_abilities()[0]\n231\t        paid = ability.cost(game, card)\n232\t        assert paid is True\n233\t\n234\t    def test_animation_adds_creature_type_to_land(self) -> None:\n235\t        \"\"\"After the ability resolves, the land has both LAND and CREATURE card types.\"\"\"\n236\t        game = create_game()\n237\t        p1 = game.players[0]\n238\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n239\t        # Not a creature before\n240\t        assert CardType.CREATURE not in card.card_types\n241\t\n242\t        p1.mana_pool.add(ManaType.COLORLESS, 5)\n243\t        ability = card.get_activated_abilities()[0]\n244\t        ability.cost(game, card)\n245\t        ability.effect(game)\n246\t\n247\t        assert CardType.CREATURE in card.card_types\n248\t        assert CardType.LAND in card.card_types\n249\t\n250\t    def test_animation_sets_power_to_two(self) -> None:\n251\t        \"\"\"After animation, the creature-land has power 2.\"\"\"\n252\t        game = create_game()\n253\t        p1 = game.players[0]\n254\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n255\t\n256\t        p1.mana_pool.add(ManaType.COLORLESS, 5)\n257\t        ability = card.get_activated_abilities()[0]\n258\t        ability.cost(game, card)\n259\t        ability.effect(game)\n260\t\n261\t        # Power should be accessible; check modified_power or base_power\n262\t        power = getattr(card, \"modified_power\", getattr(card, \"base_power\", None))\n263\t        assert power is not None, \"Animated land should have a power attribute\"\n264\t        assert power == 2\n265\t\n266\t    def test_animation_sets_toughness_to_four(self) -> None:\n267\t        \"\"\"After animation, the creature-land has toughness 4.\"\"\"\n268\t        game = create_game()\n269\t        p1 = game.players[0]\n270\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n271\t\n272\t        p1.mana_pool.add(ManaType.COLORLESS, 5)\n273\t        ability = card.get_activated_abilities()[0]\n274\t        ability.cost(game, card)\n275\t        ability.effect(game)\n276\t\n277\t        toughness = getattr(card, \"modified_toughness\", getattr(card, \"base_toughness\", None))\n278\t        assert toughness is not None, \"Animated land should have a toughness attribute\"\n279\t        assert toughness == 4\n280\t\n281\t    def test_animation_adds_wizard_subtype(self) -> None:\n282\t        \"\"\"After animation, the creature-land has the 'Wizard' subtype.\"\"\"\n283\t        game = create_game()\n284\t        p1 = game.players[0]\n285\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n286\t\n287\t        p1.mana_pool.add(ManaType.COLORLESS, 5)\n288\t        ability = card.get_activated_abilities()[0]\n289\t        ability.cost(game, card)\n290\t        ability.effect(game)\n291\t\n292\t        assert \"Wizard\" in card.subtypes\n293\t\n294\t    def test_animation_does_nothing_if_already_creature(self) -> None:\n295\t        \"\"\"If the land is already a creature, activating the ability is a no-op.\"\"\"\n296\t        game = create_game()\n297\t        p1 = game.players[0]\n298\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n299\t\n300\t        # Animate it once\n301\t        p1.mana_pool.add(ManaType.COLORLESS, 5)\n302\t        ability = card.get_activated_abilities()[0]\n303\t        ability.cost(game, card)\n304\t        ability.effect(game)\n305\t\n306\t        # Record state after first animation\n307\t        power_after_first = getattr(card, \"modified_power\", getattr(card, \"base_power\", 2))\n308\t\n309\t        # Attempt to activate again (already a creature — should be blocked)\n310\t        # Reset mana and try\n311\t        p1.mana_pool.add(ManaType.COLORLESS, 5)\n312\t        # The cost may or may not succeed; we check that the effect does not\n313\t        # add a second stack of the ability (no duplicate types / no error)\n314\t        ability.effect(game)\n315\t\n316\t        # CREATURE type should still be present (exactly once conceptually)\n317\t        assert CardType.CREATURE in card.card_types\n318\t        # Power should be the same (no double-stacking)\n319\t        power_after_second = getattr(card, \"modified_power\", getattr(card, \"base_power\", 2))\n320\t        assert power_after_second == power_after_first\n321\t\n322\t\n323\t# ---------------------------------------------------------------------------\n324\t# Wizard creature mode: triggered ability (instant/sorcery cast → +1/+0 EOT)\n325\t# ---------------------------------------------------------------------------\n326\t\n327\t\n328\tclass TestGreatHallWizardTrigger:\n329\t    \"\"\"When animated, registers 'whenever you cast an instant or sorcery spell,\n330\t    this creature gets +1/+0 until end of turn' trigger.\"\"\"\n331\t\n332\t    def test_register_triggers_registers_spell_cast_trigger_after_animation(self) -> None:\n333\t        \"\"\"After register_triggers is called post-animation, a SpellCastTriggeredEvent\n334\t        trigger should exist for this card.\"\"\"\n335\t        game = create_game()\n336\t        p1 = game.players[0]\n337\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n338\t\n339\t        # Animate the land first\n340\t        p1.mana_pool.add(ManaType.COLORLESS, 5)\n341\t        ability = card.get_activated_abilities()[0]\n342\t        ability.cost(game, card)\n343\t        ability.effect(game)\n344\t\n345\t        # Register triggers (called when the card 'enters as creature')\n346\t        card.register_triggers(game)\n347\t\n348\t        spell_cast_triggers = [\n349\t            t for t in game.trigger_manager._triggers\n350\t            if t.event_type is SpellCastTriggeredEvent and t.source is card\n351\t        ]\n352\t        assert len(spell_cast_triggers) >= 1\n353\t\n354\t    def test_wizard_trigger_condition_true_for_controller_instant(self) -> None:\n355\t        \"\"\"The trigger condition should be True when controller casts an instant.\"\"\"\n356\t        game = create_game()\n357\t        p1 = game.players[0]\n358\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n359\t\n360\t        # Animate\n361\t        p1.mana_pool.add(ManaType.COLORLESS, 5)\n362\t        ability = card.get_activated_abilities()[0]\n363\t        ability.cost(game, card)\n364\t        ability.effect(game)\n365\t        card.register_triggers(game)\n366\t\n367\t        trigger = next(\n368\t            (t for t in game.trigger_manager._triggers\n369\t             if t.event_type is SpellCastTriggeredEvent and t.source is card),\n370\t            None,\n371\t        )\n372\t        assert trigger is not None\n373\t\n374\t        instant = Instant(name=\"Lightning Bolt\")\n375\t        event = SpellCastTriggeredEvent(spell=None, player=p1, card=instant)\n376\t        result = trigger.condition is None or trigger.condition(game, event)\n377\t        assert result is True\n378\t\n379\t    def test_wizard_trigger_condition_true_for_controller_sorcery(self) -> None:\n380\t        \"\"\"The trigger condition should be True when controller casts a sorcery.\"\"\"\n381\t        game = create_game()\n382\t        p1 = game.players[0]\n383\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n384\t\n385\t        p1.mana_pool.add(ManaType.COLORLESS, 5)\n386\t        ability = card.get_activated_abilities()[0]\n387\t        ability.cost(game, card)\n388\t        ability.effect(game)\n389\t        card.register_triggers(game)\n390\t\n391\t        trigger = next(\n392\t            (t for t in game.trigger_manager._triggers\n393\t             if t.event_type is SpellCastTriggeredEvent and t.source is card),\n394\t            None,\n395\t        )\n396\t        assert trigger is not None\n397\t\n398\t        sorcery = Sorcery(name=\"Divination\")\n399\t        event = SpellCastTriggeredEvent(spell=None, player=p1, card=sorcery)\n400\t        result = trigger.condition is None or trigger.condition(game, event)\n401\t        assert result is True\n402\t\n403\t    def test_wizard_trigger_condition_false_for_opponent_instant(self) -> None:\n404\t        \"\"\"The trigger should NOT fire when the opponent casts an instant.\"\"\"\n405\t        game = create_game()\n406\t        p1 = game.players[0]\n407\t        p2 = game.players[1]\n408\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n409\t\n410\t        p1.mana_pool.add(ManaType.COLORLESS, 5)\n411\t        ability = card.get_activated_abilities()[0]\n412\t        ability.cost(game, card)\n413\t        ability.effect(game)\n414\t        card.register_triggers(game)\n415\t\n416\t        trigger = next(\n417\t            (t for t in game.trigger_manager._triggers\n418\t             if t.event_type is SpellCastTriggeredEvent and t.source is card),\n419\t            None,\n420\t        )\n421\t        assert trigger is not None\n422\t\n423\t        if trigger.condition is None:\n424\t            pytest.skip(\"condition is None — cannot verify controller filtering\")\n425\t\n426\t        instant = Instant(name=\"Opponent's Bolt\")\n427\t        event = SpellCastTriggeredEvent(spell=None, player=p2, card=instant)\n428\t        assert trigger.condition(game, event) is False\n429\t\n430\t    def test_wizard_trigger_condition_false_for_controller_creature(self) -> None:\n431\t        \"\"\"The trigger should NOT fire when controller casts a creature spell.\"\"\"\n432\t        game = create_game()\n433\t        p1 = game.players[0]\n434\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n435\t\n436\t        p1.mana_pool.add(ManaType.COLORLESS, 5)\n437\t        ability = card.get_activated_abilities()[0]\n438\t        ability.cost(game, card)\n439\t        ability.effect(game)\n440\t        card.register_triggers(game)\n441\t\n442\t        trigger = next(\n443\t            (t for t in game.trigger_manager._triggers\n444\t             if t.event_type is SpellCastTriggeredEvent and t.source is card),\n445\t            None,\n446\t        )\n447\t        assert trigger is not None\n448\t\n449\t        if trigger.condition is None:\n450\t            pytest.skip(\"condition is None — cannot verify type filtering\")\n451\t\n452\t        creature = Creature(name=\"Grizzly Bears\", base_power=2, base_toughness=2)\n453\t        event = SpellCastTriggeredEvent(spell=None, player=p1, card=creature)\n454\t        assert trigger.condition(game, event) is False\n455\t\n456\t    def test_wizard_trigger_effect_grants_plus_one_power(self) -> None:\n457\t        \"\"\"When the trigger resolves, the Wizard creature-land gets +1/+0 EOT.\"\"\"\n458\t        game = create_game()\n459\t        p1 = game.players[0]\n460\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n461\t        game.get_battlefield(p1).add(card)\n462\t\n463\t        # Animate the land into a creature\n464\t        p1.mana_pool.add(ManaType.COLORLESS, 5)\n465\t        ability = card.get_activated_abilities()[0]\n466\t        ability.cost(game, card)\n467\t        ability.effect(game)\n468\t        card.register_triggers(game)\n469\t\n470\t        trigger = next(\n471\t            (t for t in game.trigger_manager._triggers\n472\t             if t.event_type is SpellCastTriggeredEvent and t.source is card),\n473\t            None,\n474\t        )\n475\t        assert trigger is not None\n476\t\n477\t        # Record power before trigger fires\n478\t        power_before = getattr(card, \"modified_power\", getattr(card, \"base_power\", 2))\n479\t\n480\t        # Execute trigger effect\n481\t        trigger.effect(game)\n482\t\n483\t        # Power should be +1 higher after trigger\n484\t        power_after = getattr(card, \"modified_power\", getattr(card, \"base_power\", 2))\n485\t        assert power_after == power_before + 1\n486\t"}]},"parent_tool_use_id":"toolu_0146Q6RpgiEyNuPHVyWYqKBR","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"d221e80e-ebcd-4a4e-9576-1c54511076ba","timestamp":"2026-05-28T01:46:48.067Z","subagent_type":"Implementer","task_description":"Revision round for sos_257"}
