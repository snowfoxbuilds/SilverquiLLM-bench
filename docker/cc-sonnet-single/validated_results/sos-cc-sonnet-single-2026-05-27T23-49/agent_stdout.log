{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GCe91fHJjcHpyHoj42Gqn2","type":"tool_result","content":"1\t\"\"\"Tests for SOS 13 — Emeritus of Truce // Swords to Plowshares.\n2\t\n3\tEmeritus of Truce is a {1}{W}{W} 3/3 Cat Cleric Creature with the \"Prepared\"\n4\tkeyword.  The spell half is Swords to Plowshares, a {W} Instant.\n5\t\n6\tETB trigger (front face):\n7\t  1. Target player creates a 1/1 white and black Inkling creature token\n8\t     with flying.\n9\t  2. Then if an opponent controls more creatures than you, this creature\n10\t     becomes prepared.\n11\t\n12\tPrepared mechanic:\n13\t  While prepared, you may cast a copy of its spell (Swords to Plowshares).\n14\t  Doing so unprepares it.\n15\t\n16\tTest strategy:\n17\t  - Static properties: name, mana cost, P/T, card type, subtypes.\n18\t  - is_prepared attribute defaults to False.\n19\t  - ETB trigger is registered via register_triggers.\n20\t  - ETB trigger condition fires only when THIS creature enters.\n21\t  - ETB effect: creates a 1/1 Inkling token with flying on target player's\n22\t    battlefield.\n23\t  - Token has correct properties (power 1, toughness 1, Flying keyword,\n24\t    Inkling subtype).\n25\t  - Prepared condition: becomes prepared when opponent controls more creatures.\n26\t  - Prepared condition: does NOT become prepared when you are not behind.\n27\t  - Casting the spell copy while prepared unprepares the creature.\n28\t  - No-op / no copy is cast when not prepared.\n29\t  - Targeting API: get_targets returns at least one requirement (for a player).\n30\t\"\"\"\n31\t\n32\tfrom __future__ import annotations\n33\t\n34\timport pytest\n35\t\n36\tfrom cards.sos.sos_13.card_impl import EmeritusOfTruceSwordsToPlowshares\n37\tfrom engine.card import Creature, Instant\n38\tfrom engine.events import EntersBattlefieldTriggeredEvent\n39\tfrom engine.triggers import TriggerRegistration\n40\tfrom engine.types import CardType, Keyword, ManaCost, Zone\n41\tfrom test_utils import create_game, set_board_state\n42\t\n43\t\n44\t# ---------------------------------------------------------------------------\n45\t# Helpers\n46\t# ---------------------------------------------------------------------------\n47\t\n48\tdef _make_card(game=None, *, owner_idx: int = 0):\n49\t    \"\"\"Create an EmeritusOfTruceSwordsToPlowshares with owner/controller set.\"\"\"\n50\t    if game is None:\n51\t        game = create_game()\n52\t    player = game.players[owner_idx]\n53\t    card = EmeritusOfTruceSwordsToPlowshares(owner=player, controller=player)\n54\t    return game, card\n55\t\n56\t\n57\tdef _inkling_tokens_on(game, player_idx: int) -> list:\n58\t    \"\"\"Return all Inkling tokens on *player_idx*'s battlefield.\"\"\"\n59\t    player = game.players[player_idx]\n60\t    bf = game.get_battlefield(player)\n61\t    return [\n62\t        obj for obj in bf.get_all()\n63\t        if getattr(obj, \"is_token\", False)\n64\t        and \"Inkling\" in getattr(obj, \"subtypes\", set())\n65\t    ]\n66\t\n67\t\n68\t# ---------------------------------------------------------------------------\n69\t# Static property tests\n70\t# ---------------------------------------------------------------------------\n71\t\n72\t\n73\tclass TestEmeritusOfTruceProperties:\n74\t    \"\"\"Static card data must match the SOS 13 spec.\"\"\"\n75\t\n76\t    def test_is_creature(self) -> None:\n77\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n78\t        assert isinstance(card, Creature)\n79\t\n80\t    def test_name(self) -> None:\n81\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n82\t        # Name may be the front face or the combined DFC name.\n83\t        assert \"Emeritus of Truce\" in card.name\n84\t\n85\t    def test_mana_cost(self) -> None:\n86\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n87\t        assert card.mana_cost == ManaCost.parse(\"{1}{W}{W}\")\n88\t\n89\t    def test_power(self) -> None:\n90\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n91\t        assert card.base_power == 3\n92\t\n93\t    def test_toughness(self) -> None:\n94\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n95\t        assert card.base_toughness == 3\n96\t\n97\t    def test_card_type_is_creature(self) -> None:\n98\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n99\t        assert CardType.CREATURE in card.card_types\n100\t\n101\t    def test_cat_subtype(self) -> None:\n102\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n103\t        assert \"Cat\" in card.subtypes\n104\t\n105\t    def test_cleric_subtype(self) -> None:\n106\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n107\t        assert \"Cleric\" in card.subtypes\n108\t\n109\t\n110\t# ---------------------------------------------------------------------------\n111\t# Prepared attribute initialisation\n112\t# ---------------------------------------------------------------------------\n113\t\n114\t\n115\tclass TestEmeritusOfTrucePreparedAttribute:\n116\t    \"\"\"is_prepared must default to False on a freshly created card.\"\"\"\n117\t\n118\t    def test_is_prepared_defaults_to_false(self) -> None:\n119\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n120\t        assert card.is_prepared is False\n121\t\n122\t\n123\t\n124\t# ---------------------------------------------------------------------------\n125\t# ETB trigger registration\n126\t# ---------------------------------------------------------------------------\n127\t\n128\t\n129\tclass TestEmeritusETBTriggerRegistration:\n130\t    \"\"\"register_triggers must register an EntersBattlefieldTriggeredEvent trigger.\"\"\"\n131\t\n132\t    def test_registers_at_least_one_trigger(self) -> None:\n133\t        game, card = _make_card()\n134\t        before = len(game.trigger_manager._triggers)\n135\t        card.register_triggers(game)\n136\t        after = len(game.trigger_manager._triggers)\n137\t        assert after > before\n138\t\n139\t    def test_registers_etb_trigger(self) -> None:\n140\t        \"\"\"At least one trigger must watch EntersBattlefieldTriggeredEvent.\"\"\"\n141\t        game, card = _make_card()\n142\t        card.register_triggers(game)\n143\t        triggers = game.trigger_manager._triggers\n144\t        etb_triggers = [\n145\t            t for t in triggers\n146\t            if t.source is card\n147\t            and issubclass(t.event_type, EntersBattlefieldTriggeredEvent)\n148\t        ]\n149\t        assert len(etb_triggers) >= 1\n150\t\n151\t    def test_trigger_source_is_card(self) -> None:\n152\t        game, card = _make_card()\n153\t        card.register_triggers(game)\n154\t        triggers = [t for t in game.trigger_manager._triggers if t.source is card]\n155\t        assert len(triggers) >= 1\n156\t        assert triggers[0].source is card\n157\t\n158\t    def test_trigger_condition_fires_only_for_self(self) -> None:\n159\t        \"\"\"The ETB trigger condition must match only when THIS card enters.\"\"\"\n160\t        game, card = _make_card()\n161\t        card.register_triggers(game)\n162\t        etb_triggers = [\n163\t            t for t in game.trigger_manager._triggers\n164\t            if t.source is card\n165\t            and issubclass(t.event_type, EntersBattlefieldTriggeredEvent)\n166\t        ]\n167\t        assert len(etb_triggers) >= 1\n168\t        trigger = etb_triggers[0]\n169\t        if trigger.condition is not None:\n170\t            # Must fire for self\n171\t            event_self = EntersBattlefieldTriggeredEvent(permanent=card)\n172\t            assert trigger.condition(game, event_self) is True\n173\t            # Must NOT fire for a different creature\n174\t            other = Creature(name=\"Bear\", base_power=2, base_toughness=2)\n175\t            event_other = EntersBattlefieldTriggeredEvent(permanent=other)\n176\t            assert trigger.condition(game, event_other) is False\n177\t\n178\t\n179\t# ---------------------------------------------------------------------------\n180\t# ETB effect: Inkling token creation\n181\t# ---------------------------------------------------------------------------\n182\t\n183\t\n184\tclass TestEmeritusETBTokenCreation:\n185\t    \"\"\"The ETB effect creates a 1/1 white and black Inkling token with flying.\"\"\"\n186\t\n187\t    def test_etb_creates_exactly_one_token(self) -> None:\n188\t        \"\"\"Exactly one Inkling token is created per ETB.\"\"\"\n189\t        game, card = _make_card()\n190\t        p1 = game.players[0]\n191\t        card.chosen_targets = [p1]  # target player\n192\t        card.is_prepared = False    # no prepared condition check yet\n193\t        before_bf = len(game.get_battlefield(p1).get_all())\n194\t        card.on_resolve(game)\n195\t        after_bf = len(game.get_battlefield(p1).get_all())\n196\t        # At least one permanent (the token) was added\n197\t        assert after_bf >= before_bf + 1\n198\t\n199\t    def test_inkling_token_has_flying(self) -> None:\n200\t        \"\"\"The created Inkling token must have the Flying keyword.\"\"\"\n201\t        game, card = _make_card()\n202\t        p1 = game.players[0]\n203\t        card.chosen_targets = [p1]\n204\t        card.on_resolve(game)\n205\t        inklings = _inkling_tokens_on(game, 0)\n206\t        assert len(inklings) >= 1\n207\t        tok = inklings[0]\n208\t        assert Keyword.FLYING in tok.keywords\n209\t\n210\t    def test_inkling_token_is_1_1(self) -> None:\n211\t        \"\"\"The Inkling token must be a 1/1 creature.\"\"\"\n212\t        game, card = _make_card()\n213\t        p1 = game.players[0]\n214\t        card.chosen_targets = [p1]\n215\t        card.on_resolve(game)\n216\t        inklings = _inkling_tokens_on(game, 0)\n217\t        assert len(inklings) >= 1\n218\t        tok = inklings[0]\n219\t        assert tok.base_power == 1\n220\t        assert tok.base_toughness == 1\n221\t\n222\t    def test_inkling_token_is_marked_as_token(self) -> None:\n223\t        \"\"\"The created token must have is_token == True.\"\"\"\n224\t        game, card = _make_card()\n225\t        p1 = game.players[0]\n226\t        card.chosen_targets = [p1]\n227\t        card.on_resolve(game)\n228\t        inklings = _inkling_tokens_on(game, 0)\n229\t        assert len(inklings) >= 1\n230\t        assert inklings[0].is_token is True\n231\t\n232\t    def test_inkling_token_on_target_player_battlefield(self) -> None:\n233\t        \"\"\"When target is opponent, the token lands on the opponent's battlefield.\"\"\"\n234\t        game, card = _make_card()\n235\t        p1 = game.players[0]\n236\t        p2 = game.players[1]\n237\t        card.chosen_targets = [p2]  # target the opponent\n238\t        card.on_resolve(game)\n239\t        inklings_p2 = _inkling_tokens_on(game, 1)\n240\t        assert len(inklings_p2) >= 1\n241\t\n242\t    def test_inkling_token_has_inkling_subtype(self) -> None:\n243\t        \"\"\"The token's subtype must include 'Inkling'.\"\"\"\n244\t        game, card = _make_card()\n245\t        p1 = game.players[0]\n246\t        card.chosen_targets = [p1]\n247\t        card.on_resolve(game)\n248\t        inklings = _inkling_tokens_on(game, 0)\n249\t        assert len(inklings) >= 1\n250\t        assert \"Inkling\" in inklings[0].subtypes\n251\t\n252\t\n253\t# ---------------------------------------------------------------------------\n254\t# Prepared condition: becomes prepared based on creature counts\n255\t# ---------------------------------------------------------------------------\n256\t\n257\t\n258\tclass TestEmeritusOfTrucePreparedCondition:\n259\t    \"\"\"The creature becomes prepared only when opponent controls more creatures.\"\"\"\n260\t\n261\t    def test_becomes_prepared_when_opponent_has_more_creatures(self) -> None:\n262\t        \"\"\"After ETB: if opponent controls more creatures, card becomes prepared.\"\"\"\n263\t        game, card = _make_card()\n264\t        p1 = game.players[0]\n265\t        p2 = game.players[1]\n266\t        # Give opponent 2 creatures; p1 has only the card itself (which just entered)\n267\t        bear1 = Creature(name=\"Bear1\", base_power=2, base_toughness=2, owner=p2, controller=p2)\n268\t        bear2 = Creature(name=\"Bear2\", base_power=2, base_toughness=2, owner=p2, controller=p2)\n269\t        set_board_state(game, 1, battlefield=[bear1, bear2])\n270\t        # p1 has 0 creatures before ETB token creation\n271\t        card.chosen_targets = [p1]\n272\t        card.on_resolve(game)\n273\t        assert card.is_prepared is True\n274\t\n275\t    def test_not_prepared_when_creature_counts_equal(self) -> None:\n276\t        \"\"\"If you have as many creatures as your opponent, card is NOT prepared.\"\"\"\n277\t        game, card = _make_card()\n278\t        p1 = game.players[0]\n279\t        p2 = game.players[1]\n280\t        # p1 has the card itself on the battlefield\n281\t        game.get_battlefield(p1).add(card)\n282\t        # p2 has exactly one creature too\n283\t        bear = Creature(name=\"Bear\", base_power=2, base_toughness=2, owner=p2, controller=p2)\n284\t        set_board_state(game, 1, battlefield=[bear])\n285\t        card.chosen_targets = [p1]\n286\t        card.on_resolve(game)\n287\t        assert card.is_prepared is False\n288\t\n289\t    def test_not_prepared_when_you_have_more_creatures(self) -> None:\n290\t        \"\"\"If you control more creatures than opponent, card is NOT prepared.\"\"\"\n291\t        game, card = _make_card()\n292\t        p1 = game.players[0]\n293\t        p2 = game.players[1]\n294\t        # p1 has 2 creatures; p2 has none\n295\t        extra = Creature(name=\"Extra\", base_power=1, base_toughness=1, owner=p1, controller=p1)\n296\t        game.get_battlefield(p1).add(card)\n297\t        game.get_battlefield(p1).add(extra)\n298\t        card.chosen_targets = [p1]\n299\t        card.on_resolve(game)\n300\t        assert card.is_prepared is False\n301\t\n302\t    def test_not_prepared_when_opponent_has_zero_creatures(self) -> None:\n303\t        \"\"\"With empty board and no opponent creatures, card is NOT prepared.\"\"\"\n304\t        game, card = _make_card()\n305\t        p1 = game.players[0]\n306\t        # p1 just created a token, so may have 1 creature; opponent has 0\n307\t        # Either way, opponent does NOT have more creatures\n308\t        card.chosen_targets = [p1]\n309\t        card.on_resolve(game)\n310\t        assert card.is_prepared is False\n311\t\n312\t\n313\t# ---------------------------------------------------------------------------\n314\t# Prepared mechanic: casting the spell copy\n315\t# ---------------------------------------------------------------------------\n316\t\n317\t\n318\tclass TestEmeritusOfTruceCastSpellWhenPrepared:\n319\t    \"\"\"While prepared, the controller may cast a copy of Swords to Plowshares.\"\"\"\n320\t\n321\t    def test_cast_prepared_spell_unprepares_card(self) -> None:\n322\t        \"\"\"After casting the spell copy from prepared state, is_prepared becomes False.\"\"\"\n323\t        game, card = _make_card()\n324\t        p1 = game.players[0]\n325\t        card.is_prepared = True\n326\t        # Place a target creature for Swords to Plowshares\n327\t        target = Creature(\n328\t            name=\"Target\",\n329\t            base_power=3,\n330\t            base_toughness=3,\n331\t            owner=p1,\n332\t            controller=p1,\n333\t        )\n334\t        game.get_battlefield(p1).add(target)\n335\t        # Cast the prepared spell; implementation must set is_prepared = False\n336\t        card.cast_prepared_spell(game)\n337\t        assert card.is_prepared is False\n338\t\n339\t    def test_cast_prepared_spell_noop_when_not_prepared(self) -> None:\n340\t        \"\"\"Calling cast_prepared_spell when not prepared must not raise.\"\"\"\n341\t        game, card = _make_card()\n342\t        card.is_prepared = False\n343\t        # Must not raise even without a valid target\n344\t        card.cast_prepared_spell(game)\n345\t        assert card.is_prepared is False\n346\t\n347\t    def test_prepared_spell_accesses_spell_side(self) -> None:\n348\t        \"\"\"The card exposes a spell_side that represents Swords to Plowshares.\"\"\"\n349\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n350\t        # The spell side must be present and be an Instant-type representation\n351\t        spell = getattr(card, \"spell_side\", None)\n352\t        assert spell is not None\n353\t\n354\t    def test_prepared_spell_name_is_swords_to_plowshares(self) -> None:\n355\t        \"\"\"The spell side must be named 'Swords to Plowshares'.\"\"\"\n356\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n357\t        spell = getattr(card, \"spell_side\", None)\n358\t        assert spell is not None\n359\t        spell_name = getattr(spell, \"name\", None) or getattr(spell, \"spell_name\", None)\n360\t        assert spell_name == \"Swords to Plowshares\"\n361\t\n362\t\n363\t# ---------------------------------------------------------------------------\n364\t# Targeting API\n365\t# ---------------------------------------------------------------------------\n366\t\n367\t\n368\tclass TestEmeritusOfTruceTargeting:\n369\t    \"\"\"get_targets must declare a targeting requirement for the Inkling token\n370\t    recipient (a player).\"\"\"\n371\t\n372\t    def test_get_targets_returns_list(self) -> None:\n373\t        game = create_game()\n374\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n375\t        result = card.get_targets(game)\n376\t        assert isinstance(result, list)\n377\t\n378\t    def test_get_targets_returns_at_least_one_requirement(self) -> None:\n379\t        \"\"\"Must declare at least one target (a player for the token).\"\"\"\n380\t        game = create_game()\n381\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n382\t        result = card.get_targets(game)\n383\t        assert len(result) >= 1\n384\t\n385\t    def test_no_chosen_targets_does_not_raise(self) -> None:\n386\t        \"\"\"on_resolve with no chosen_targets must not raise.\"\"\"\n387\t        game = create_game()\n388\t        p1 = game.players[0]\n389\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n390\t        # No chosen_targets — should be a graceful no-op\n391\t        card.on_resolve(game)\n392\t"}]},"parent_tool_use_id":"toolu_01Szf1o2Ha8JSCfYUHvHLQDr","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"d30d7a0e-9517-44eb-b5d7-b21570f48e0b","timestamp":"2026-05-28T00:17:52.428Z","subagent_type":"Tester","task_description":"Tester re-invoke for sos_13 untestable items"}
