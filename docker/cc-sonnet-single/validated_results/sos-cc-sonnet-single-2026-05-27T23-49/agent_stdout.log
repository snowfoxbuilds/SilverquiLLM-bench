{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UqJvdr4ztj4BJqBsXCLwb3","type":"tool_result","content":"1\t\"\"\"Card implementation for Lorehold, the Historian (SOS 201).\n2\t\n3\tLorehold, the Historian — {3}{R}{W} — Legendary Creature — Elder Dragon — 5/5\n4\t\n5\tFlying, haste\n6\tEach instant and sorcery card in your hand has miracle {2}.\n7\t(You may cast a card for its miracle cost when you draw it if it's the\n8\tfirst card you drew this turn.)\n9\tAt the beginning of each opponent's upkeep, you may discard a card.\n10\tIf you do, draw a card.\n11\t\n12\tSOS collector number 201.\n13\t\"\"\"\n14\t\n15\tfrom __future__ import annotations\n16\t\n17\tfrom typing import TYPE_CHECKING, Any\n18\t\n19\tfrom engine.card import Creature\n20\tfrom engine.events import BeginningOfUpkeepTriggeredEvent, LeavesBattlefieldTriggeredEvent\n21\tfrom engine.triggers import TriggerRegistration\n22\tfrom engine.types import CardType, Keyword, ManaCost, Supertype, Zone\n23\t\n24\tif TYPE_CHECKING:\n25\t    from engine.game_state import GameState\n26\t\n27\t\n28\t_MIRACLE_COST = ManaCost.parse(\"{2}\")\n29\t\n30\t\n31\tdef _is_instant_or_sorcery(card: Any) -> bool:\n32\t    \"\"\"Return True if *card* is an instant or sorcery.\"\"\"\n33\t    card_types = getattr(card, \"card_types\", set())\n34\t    return CardType.INSTANT in card_types or CardType.SORCERY in card_types\n35\t\n36\t\n37\tclass LoreholdTheHistorian(Creature):\n38\t    \"\"\"Lorehold, the Historian — {3}{R}{W} — Legendary Creature — Elder Dragon — 5/5.\n39\t\n40\t    Flying, haste\n41\t    Each instant and sorcery card in your hand has miracle {2}.\n42\t    At the beginning of each opponent's upkeep, you may discard a card.\n43\t    If you do, draw a card.\n44\t    \"\"\"\n45\t\n46\t    def __init__(self, **kwargs: Any) -> None:\n47\t        kwargs.setdefault(\"name\", \"Lorehold, the Historian\")\n48\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{3}{R}{W}\"))\n49\t        kwargs.setdefault(\"base_power\", 5)\n50\t        kwargs.setdefault(\"base_toughness\", 5)\n51\t        kwargs.setdefault(\"supertypes\", set())\n52\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.LEGENDARY}\n53\t        kwargs.setdefault(\"subtypes\", set())\n54\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Elder\", \"Dragon\"}\n55\t        kwargs.setdefault(\"keywords\", Keyword(0))\n56\t        kwargs[\"keywords\"] = kwargs[\"keywords\"] | Keyword.FLYING | Keyword.HASTE\n57\t        kwargs.setdefault(\n58\t            \"rules_text\",\n59\t            \"Flying, haste\\n\"\n60\t            \"Each instant and sorcery card in your hand has miracle {2}.\\n\"\n61\t            \"At the beginning of each opponent's upkeep, you may discard a card. \"\n62\t            \"If you do, draw a card.\",\n63\t        )\n64\t        super().__init__(**kwargs)\n65\t        # Storage for the original ZoneContainer.add so we can restore it.\n66\t        self._original_hand_add: Any = None\n67\t        self._hooked_hand_zone: Any = None  # reference to the patched zone\n68\t\n69\t    # ------------------------------------------------------------------\n70\t    # Miracle granting — hook the controller's hand zone\n71\t    # ------------------------------------------------------------------\n72\t\n73\t    def _apply_miracle_hook(self, game: \"GameState\") -> None:\n74\t        \"\"\"Install a hook on the controller's HAND zone that tags instants and\n75\t        sorceries with miracle_cost = {2} when they enter the zone.\n76\t\n77\t        Also immediately tags all existing instants/sorceries in the hand.\n78\t        \"\"\"\n79\t        controller = getattr(self, \"controller\", None)\n80\t        if controller is None:\n81\t            return\n82\t        hand = controller.zones[Zone.HAND]\n83\t\n84\t        # Tag cards already in hand.\n85\t        for card in hand.get_all():\n86\t            if _is_instant_or_sorcery(card):\n87\t                card.miracle_cost = _MIRACLE_COST\n88\t\n89\t        # Patch the add method to tag future additions.\n90\t        # Guard against double-patching.\n91\t        if self._hooked_hand_zone is hand:\n92\t            return\n93\t\n94\t        source = self  # capture for closure\n95\t\n96\t        original_add = hand.add\n97\t\n98\t        def _patched_add(obj: Any, position: str = \"top\") -> None:\n99\t            original_add(obj, position)\n100\t            # Only grant miracle while Lorehold is still on the battlefield.\n101\t            # source._hooked_hand_zone is set to None by _remove_miracle_hook()\n102\t            # when Lorehold leaves, so this acts as a battlefield-presence guard.\n103\t            if source._hooked_hand_zone is not None and _is_instant_or_sorcery(obj):\n104\t                obj.miracle_cost = _MIRACLE_COST\n105\t\n106\t        hand.add = _patched_add  # type: ignore[method-assign]\n107\t        self._original_hand_add = original_add\n108\t        self._hooked_hand_zone = hand\n109\t\n110\t    def _remove_miracle_hook(self) -> None:\n111\t        \"\"\"Restore the original add method on the hand zone (cleanup).\"\"\"\n112\t        if self._hooked_hand_zone is not None and self._original_hand_add is not None:\n113\t            self._hooked_hand_zone.add = self._original_hand_add  # type: ignore[method-assign]\n114\t        self._hooked_hand_zone = None\n115\t        self._original_hand_add = None\n116\t\n117\t    # ------------------------------------------------------------------\n118\t    # Trigger registration\n119\t    # ------------------------------------------------------------------\n120\t\n121\t    def register_triggers(self, game: \"GameState\") -> None:\n122\t        \"\"\"Register the opponent-upkeep loot trigger and miracle-grant hook.\"\"\"\n123\t        from engine.game import draw_card, discard as engine_discard\n124\t\n125\t        source = self\n126\t        controller = getattr(self, \"controller\", None)\n127\t        if controller is None:\n128\t            controller = game.active_player\n129\t\n130\t        # --- Miracle granting ---\n131\t        self._apply_miracle_hook(game)\n132\t\n133\t        # --- Upkeep loot trigger ---\n134\t        def _condition(g: \"GameState\", event: Any) -> bool:\n135\t            ctrl = getattr(source, \"controller\", None)\n136\t            if ctrl is None:\n137\t                return False\n138\t            # Fires on opponent's upkeep — active player is NOT the controller.\n139\t            return g.active_player is not ctrl\n140\t\n141\t        def _effect(g: \"GameState\") -> None:\n142\t            ctrl = getattr(source, \"controller\", None)\n143\t            if ctrl is None:\n144\t                return\n145\t            # Ask controller if they want to discard\n146\t            try:\n147\t                wants_discard = ctrl.choose_yes_no(\n148\t                    \"Discard a card? (Lorehold, the Historian)\"\n149\t                )\n150\t            except Exception:\n151\t                wants_discard = True\n152\t\n153\t            if not wants_discard:\n154\t                return\n155\t\n156\t            # Choose a card to discard from hand\n157\t            hand = g.get_hand(ctrl)\n158\t            cards_in_hand = hand.get_all()\n159\t            if not cards_in_hand:\n160\t                # No cards to discard — ability fizzles gracefully.\n161\t                return\n162\t\n163\t            try:\n164\t                chosen = ctrl.choose_card(\n165\t                    cards_in_hand, \"Choose a card to discard (Lorehold)\"\n166\t                )\n167\t            except Exception:\n168\t                chosen = cards_in_hand[0] if cards_in_hand else None\n169\t\n170\t            if chosen is None or not hand.contains(chosen):\n171\t                return\n172\t\n173\t            engine_discard(g, ctrl, chosen)\n174\t            draw_card(g, ctrl)\n175\t\n176\t        game.trigger_manager.register(\n177\t            TriggerRegistration(\n178\t                event_type=BeginningOfUpkeepTriggeredEvent,\n179\t                condition=_condition,\n180\t                effect=_effect,\n181\t                source=self,\n182\t                controller=controller,\n183\t            )\n184\t        )\n185\t\n186\t        # --- Leaves-battlefield cleanup: remove miracle hook when Lorehold leaves ---\n187\t        def _leaves_condition(g: \"GameState\", event: Any) -> bool:\n188\t            return event.permanent is source\n189\t\n190\t        def _leaves_effect(g: \"GameState\") -> None:\n191\t            source._remove_miracle_hook()\n192\t\n193\t        game.trigger_manager.register(\n194\t            TriggerRegistration(\n195\t                event_type=LeavesBattlefieldTriggeredEvent,\n196\t                condition=_leaves_condition,\n197\t                effect=_leaves_effect,\n198\t                source=self,\n199\t                controller=controller,\n200\t            )\n201\t        )\n202\t"}]},"parent_tool_use_id":"toolu_015FRP8E9s1RB98j7LTVrPbY","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"9b50499e-e13a-4da6-93e3-26dc891835bc","timestamp":"2026-05-28T01:12:04.972Z","subagent_type":"Tester","task_description":"Tester for sos_226"}
