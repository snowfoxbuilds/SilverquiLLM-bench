{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01L4iTmJQQG9kaM93qpyyjDk","type":"tool_result","content":"1\t\"\"\"Card implementation for The Dawning Archaic (SOS #1).\n2\t\n3\tThe Dawning Archaic — {10} — Legendary Creature — Avatar — 7/7\n4\t\n5\tThis spell costs {1} less to cast for each instant and sorcery card in\n6\tyour graveyard.\n7\tReach\n8\tWhenever The Dawning Archaic attacks, you may cast target instant or\n9\tsorcery card from your graveyard without paying its mana cost. If that\n10\tspell would be put into your graveyard, exile it instead.\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\tfrom typing import TYPE_CHECKING, Any\n16\t\n17\tfrom engine.card import Creature\n18\tfrom engine.events import AttacksTriggeredEvent\n19\tfrom engine.replacement_effects import ReplacementEffect\n20\tfrom engine.stack import StackObject\n21\tfrom engine.triggers import TriggerRegistration\n22\tfrom engine.types import CardType, Keyword, ManaCost, Supertype, Zone\n23\t\n24\tif TYPE_CHECKING:\n25\t    from engine.game_state import GameState\n26\t\n27\t\n28\tclass TheDawningArchaic(Creature):\n29\t    \"\"\"The Dawning Archaic — {10} — Legendary Creature — Avatar — 7/7.\"\"\"\n30\t\n31\t    def __init__(self, **kwargs: Any) -> None:\n32\t        kwargs.setdefault(\"name\", \"The Dawning Archaic\")\n33\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{10}\"))\n34\t        kwargs.setdefault(\"subtypes\", {\"Avatar\"})\n35\t        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n36\t        kwargs.setdefault(\"keywords\", Keyword.REACH)\n37\t        kwargs.setdefault(\"base_power\", 7)\n38\t        kwargs.setdefault(\"base_toughness\", 7)\n39\t        kwargs.setdefault(\n40\t            \"rules_text\",\n41\t            \"This spell costs {1} less to cast for each instant and sorcery card \"\n42\t            \"in your graveyard.\\nReach\\nWhenever The Dawning Archaic attacks, you \"\n43\t            \"may cast target instant or sorcery card from your graveyard without \"\n44\t            \"paying its mana cost. If that spell would be put into your graveyard, \"\n45\t            \"exile it instead.\",\n46\t        )\n47\t        super().__init__(**kwargs)\n48\t\n49\t    # ------------------------------------------------------------------\n50\t    # Cost reduction\n51\t    # ------------------------------------------------------------------\n52\t\n53\t    def cost_reduction(self, game: \"GameState\") -> int:\n54\t        \"\"\"Return {1} less per instant/sorcery card in controller's graveyard.\n55\t\n56\t        Capped at the generic mana component (10) so cost never goes negative.\n57\t        \"\"\"\n58\t        controller = self.controller\n59\t        if controller is None:\n60\t            return 0\n61\t\n62\t        graveyard = game.get_graveyard(controller)\n63\t        count = 0\n64\t        for card in graveyard.get_all():\n65\t            card_types = getattr(card, \"card_types\", set())\n66\t            if CardType.INSTANT in card_types or CardType.SORCERY in card_types:\n67\t                count += 1\n68\t\n69\t        # Cap at the generic portion of the mana cost (10)\n70\t        generic = self.mana_cost.generic if self.mana_cost else 0\n71\t        return min(count, generic)\n72\t\n73\t    # ------------------------------------------------------------------\n74\t    # Triggered abilities\n75\t    # ------------------------------------------------------------------\n76\t\n77\t    def register_triggers(self, game: \"GameState\") -> None:\n78\t        \"\"\"Register: whenever this creature attacks, cast an instant/sorcery\n79\t        from your graveyard without paying its mana cost.\n80\t        \"\"\"\n81\t        source = self\n82\t        controller = self.controller\n83\t\n84\t        def _condition(g: \"GameState\", event: AttacksTriggeredEvent) -> bool:\n85\t            return event.creature is source\n86\t\n87\t        def _effect(g: \"GameState\") -> None:\n88\t            _attack_trigger_effect(g, source)\n89\t\n90\t        game.trigger_manager.register(\n91\t            TriggerRegistration(\n92\t                event_type=AttacksTriggeredEvent,\n93\t                condition=_condition,\n94\t                effect=_effect,\n95\t                source=source,\n96\t                controller=controller,\n97\t            )\n98\t        )\n99\t\n100\t    # ------------------------------------------------------------------\n101\t    # Replacement effects (registered when this enters the battlefield,\n102\t    # but the main replacement for free-cast spells is registered inline\n103\t    # in the trigger effect below)\n104\t    # ------------------------------------------------------------------\n105\t\n106\t    def register_replacement_effects(self, game: \"GameState\") -> None:\n107\t        \"\"\"No permanent replacement effects on this card.\n108\t\n109\t        The free-cast exile replacement is registered transiently by the\n110\t        attack trigger effect for the specific cast spell.\n111\t        \"\"\"\n112\t\n113\t\n114\t# ---------------------------------------------------------------------------\n115\t# Helper — attack trigger effect\n116\t# ---------------------------------------------------------------------------\n117\t\n118\t\n119\tdef _attack_trigger_effect(game: \"GameState\", source: \"TheDawningArchaic\") -> None:\n120\t    \"\"\"Cast an instant or sorcery from the controller's graveyard for free.\n121\t\n122\t    If no instants/sorceries are in the graveyard, this is a no-op.\n123\t    After resolution, the spell goes to exile instead of the graveyard.\n124\t    \"\"\"\n125\t    controller = source.controller\n126\t    if controller is None:\n127\t        return\n128\t\n129\t    graveyard = game.get_graveyard(controller)\n130\t    # Find the first instant or sorcery in the graveyard\n131\t    target_spell = None\n132\t    for card in graveyard.get_all():\n133\t        card_types = getattr(card, \"card_types\", set())\n134\t        if CardType.INSTANT in card_types or CardType.SORCERY in card_types:\n135\t            target_spell = card\n136\t            break\n137\t\n138\t    if target_spell is None:\n139\t        return\n140\t\n141\t    spell = target_spell\n142\t\n143\t    # Ensure owner/controller are set\n144\t    if spell.owner is None:\n145\t        spell.owner = controller\n146\t    spell.controller = controller\n147\t\n148\t    # Move spell from graveyard to the stack zone\n149\t    graveyard.remove(spell)\n150\t    stack_zone = controller.zones[Zone.STACK]\n151\t    stack_zone.add(spell)\n152\t\n153\t    # Build a custom on_resolve that:\n154\t    # 1. Calls the spell's own on_resolve (its effect)\n155\t    # 2. Moves the spell to exile instead of graveyard\n156\t    def _free_cast_resolve(g: \"GameState\") -> None:\n157\t        # Remove from stack zone first\n158\t        try:\n159\t            stack_zone.remove(spell)\n160\t        except ValueError:\n161\t            pass  # Already moved somehow\n162\t\n163\t        # Call the spell's own resolution effect\n164\t        spell.on_resolve(g)\n165\t\n166\t        # Determine where the spell currently is — if it's a permanent type\n167\t        # it would have gone to battlefield, but instants/sorceries should\n168\t        # go to exile instead of graveyard\n169\t        _PERMANENT_TYPES = frozenset({\n170\t            CardType.CREATURE,\n171\t            CardType.ENCHANTMENT,\n172\t            CardType.ARTIFACT,\n173\t            CardType.PLANESWALKER,\n174\t        })\n175\t        if spell.card_types & _PERMANENT_TYPES:\n176\t            # Permanents go to battlefield — move there\n177\t            dest_player = spell.controller if spell.controller is not None else spell.owner\n178\t            if dest_player is not None:\n179\t                dest_player.zones[Zone.BATTLEFIELD].add(spell)\n180\t        else:\n181\t            # Non-permanent: send to exile instead of graveyard\n182\t            owner = spell.owner if spell.owner is not None else controller\n183\t            owner.zones[Zone.EXILE].add(spell)\n184\t\n185\t    stack_obj = StackObject(\n186\t        source=spell,\n187\t        controller=controller,\n188\t        targets=[],\n189\t        on_resolve=_free_cast_resolve,\n190\t    )\n191\t\n192\t    game.stack.push(stack_obj)\n193\t"}]},"parent_tool_use_id":"toolu_01FsV91fbok3wekxSXFobmHU","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"dffcff9a-a2cc-4bd6-a231-96dcb06ae50c","timestamp":"2026-05-27T23:56:47.398Z","subagent_type":"Reviewer","task_description":"Reviewer for sos_1"}
