{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014NdS4Xi3JKDz3AJUA7EEfs","type":"tool_result","content":"1\t\"\"\"Card implementation for Thousand-Year Storm.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom typing import TYPE_CHECKING, Any\n4\tfrom engine.card import Enchantment\n5\tfrom engine.types import CardType, ManaCost\n6\tfrom engine.events import SpellCastTriggeredEvent\n7\tif TYPE_CHECKING:\n8\t    from engine.game_state import GameState\n9\t\n10\t\n11\tclass ThousandYearStorm(Enchantment):\n12\t    \"\"\"Thousand-Year Storm — {4}{U}{R} — Enchantment.\n13\t\n14\t    Whenever you cast an instant or sorcery spell, copy it for each\n15\t    other instant and sorcery spell you've cast before it this turn.\n16\t    You may choose new targets for the copies.\n17\t\n18\t    FDN collector number 248.\n19\t    \"\"\"\n20\t\n21\t    def __init__(self, **kwargs: Any) -> None:\n22\t        kwargs.setdefault('name', 'Thousand-Year Storm')\n23\t        kwargs.setdefault('mana_cost', ManaCost.parse('{4}{U}{R}'))\n24\t        kwargs.setdefault(\n25\t            'rules_text',\n26\t            \"Whenever you cast an instant or sorcery spell, copy it for each \"\n27\t            \"other instant and sorcery spell you've cast before it this turn. \"\n28\t            \"You may choose new targets for the copies.\",\n29\t        )\n30\t        super().__init__(**kwargs)\n31\t\n32\t    def register_triggers(self, game: 'GameState') -> None:\n33\t        from engine.stack import copy_spell\n34\t        from engine.triggers import TriggerRegistration\n35\t\n36\t        source = self\n37\t        controller = getattr(self, 'controller', None) or game.active_player\n38\t        source._storm_count: int = 0\n39\t        source._last_turn: int = getattr(game, 'turn_number', 0)\n40\t\n41\t        def _condition(game: Any, event: Any) -> bool:\n42\t            ctrl = getattr(source, 'controller', None)\n43\t            caster = getattr(event, 'player', None) or getattr(event, 'controller', None)\n44\t            if caster is not ctrl:\n45\t                return False\n46\t            spell = getattr(event, 'spell', None) or getattr(event, 'card', None)\n47\t            if spell is None:\n48\t                return False\n49\t            card_types = getattr(spell, 'card_types', set())\n50\t            if not card_types & {CardType.INSTANT, CardType.SORCERY}:\n51\t                return False\n52\t            current_turn = getattr(game, 'turn_number', 0)\n53\t            if current_turn != source._last_turn:\n54\t                source._storm_count = 0\n55\t                source._last_turn = current_turn\n56\t            source._pending_spell = spell\n57\t            return True\n58\t\n59\t        def _effect(game: 'GameState') -> None:\n60\t            copies_to_make = source._storm_count\n61\t            source._storm_count += 1\n62\t            if copies_to_make <= 0:\n63\t                return\n64\t            ctrl = getattr(source, 'controller', None)\n65\t            if ctrl is None:\n66\t                return\n67\t            pending_spell = getattr(source, '_pending_spell', None)\n68\t            if pending_spell is None:\n69\t                return\n70\t            original_so = None\n71\t            for so in game.stack._items:\n72\t                if so.source is pending_spell:\n73\t                    original_so = so\n74\t                    break\n75\t            if original_so is None:\n76\t                return\n77\t            for _ in range(copies_to_make):\n78\t                new_targets: list[Any] | None = None\n79\t                if original_so.targets:\n80\t                    if ctrl.choose_yes_no(\n81\t                        f\"Choose new targets for copy of {original_so.source.name}?\"\n82\t                    ):\n83\t                        requirements = getattr(\n84\t                            original_so.source, 'get_targets', lambda _: []\n85\t                        )(game)\n86\t                        new_targets = []\n87\t                        for req in requirements:\n88\t                            legal: list[Any] = []\n89\t                            for p in game.players:\n90\t                                for obj in game.get_battlefield(p).get_all():\n91\t                                    if req.filter_fn(obj):\n92\t                                        legal.append(obj)\n93\t                                if req.filter_fn(p):\n94\t                                    legal.append(p)\n95\t                            if legal:\n96\t                                chosen = ctrl.choose_target(legal, req)\n97\t                                new_targets.append(chosen)\n98\t                copy_obj = copy_spell(game, original_so, ctrl, new_targets)\n99\t                game.stack.push(copy_obj)\n100\t\n101\t        game.trigger_manager.register(TriggerRegistration(\n102\t            event_type=SpellCastTriggeredEvent,\n103\t            condition=_condition,\n104\t            effect=_effect,\n105\t            source=self,\n106\t            controller=controller,\n107\t        ))\n108\t"}]},"parent_tool_use_id":"toolu_01JVqNS9Hqi2uvrE94ipz5bt","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"47d7fc68-f1ce-4b55-8258-dbcdddd79191","timestamp":"2026-05-28T01:15:58.764Z","subagent_type":"Implementer","task_description":"Implementer for sos_226"}
