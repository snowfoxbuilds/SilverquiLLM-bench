{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01V3o18MRpoUdSTsXUz9CU2F","type":"tool_result","content":"1\t\"\"\"Card implementation for Adventuring Gear.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom typing import TYPE_CHECKING, Any\n4\tfrom engine.card import ActivatedAbility, Artifact\n5\tfrom engine.continuous_effects import ContinuousEffect, DURATION_PERMANENT, Layer, SubLayer\n6\tfrom engine.types import Keyword, ManaCost\n7\tfrom engine.events import EntersBattlefieldTriggeredEvent\n8\tif TYPE_CHECKING:\n9\t    from engine.game_state import GameState\n10\t    from cards.registry import CardRegistry\n11\t\n12\tdef _make_equip_ability(equipment: Artifact, generic_cost: int) -> ActivatedAbility:\n13\t    \"\"\"Return an :class:`ActivatedAbility` representing *Equip {N}*.\n14\t\n15\t    The ability pays *generic_cost* generic mana from the controller's mana\n16\t    pool, then calls ``equipment.equip(target, game)`` to attach the\n17\t    equipment to a target creature.  Equip is sorcery-speed only (the engine\n18\t    should enforce timing; we document the restriction in the description).\n19\t\n20\t    The target creature is read from ``equipment._current_target`` which the\n21\t    game engine is expected to set before calling the ability's effect.\n22\t    \"\"\"\n23\t    source = equipment\n24\t\n25\t    def _cost(game: Any, src: Any) -> bool:\n26\t        controller = getattr(src, 'controller', None)\n27\t        if controller is None:\n28\t            return False\n29\t        if controller.mana_pool.total() < generic_cost:\n30\t            return False\n31\t        controller.mana_pool.pay(ManaCost(generic=generic_cost))\n32\t        return True\n33\t\n34\t    def _effect(game: Any) -> None:\n35\t        target = getattr(source, '_current_target', None)\n36\t        if target is not None:\n37\t            source.equip(target, game)\n38\t    return ActivatedAbility(cost=_cost, effect=_effect, description=f'Equip {{{generic_cost}}} (sorcery speed)')\n39\t\n40\tdef _is_on_battlefield(game: Any, obj: Any) -> bool:\n41\t    for player in game.players:\n42\t        if game.get_battlefield(player).contains(obj):\n43\t            return True\n44\t    return False\n45\t\n46\tclass AdventuringGear(Artifact):\n47\t    \"\"\"Adventuring Gear — {1} — Landfall — Whenever a land you control enters,\n48\t    equipped creature gets +2/+2 until end of turn. Equip {1}.\"\"\"\n49\t\n50\t    def __init__(self, **kwargs: Any) -> None:\n51\t        kwargs.setdefault('name', 'Adventuring Gear')\n52\t        kwargs.setdefault('mana_cost', ManaCost.parse('{1}'))\n53\t        kwargs.setdefault('subtypes', set())\n54\t        kwargs['subtypes'] = (kwargs.get('subtypes') or set()) | {'Equipment'}\n55\t        kwargs.setdefault('rules_text', 'Landfall — Whenever a land you control enters, equipped creature gets +2/+2 until end of turn.\\nEquip {1}')\n56\t        super().__init__(**kwargs)\n57\t        self.attached_to: Any | None = None\n58\t\n59\t    def get_activated_abilities(self) -> list[ActivatedAbility]:\n60\t        return [_make_equip_ability(self, generic_cost=1)]\n61\t\n62\t    def equip(self, target: Any, game: Any) -> None:\n63\t        \"\"\"Attach this equipment to *target* creature.\"\"\"\n64\t        self.attached_to = target\n65\t\n66\t    def register_triggers(self, game: Any) -> None:\n67\t        \"\"\"Register landfall trigger: whenever a land you control enters,\n68\t        equipped creature gets +2/+2 until end of turn.\"\"\"\n69\t        from engine.triggers import TriggerRegistration\n70\t        source = self\n71\t\n72\t        def _condition(game: Any, event: dict) -> bool:\n73\t            \"\"\"Check if a land entered under this equipment's controller.\"\"\"\n74\t            permanent = event.permanent\n75\t            if permanent is None:\n76\t                return False\n77\t            from engine.types import CardType as _CT\n78\t            if _CT.LAND not in getattr(permanent, 'card_types', set()):\n79\t                return False\n80\t            controller = getattr(source, 'controller', None)\n81\t            perm_controller = event.controller or getattr(permanent, 'controller', None)\n82\t            return controller is not None and perm_controller is controller\n83\t\n84\t        def _effect(game: Any) -> None:\n85\t            \"\"\"Give equipped creature +2/+2 until end of turn.\"\"\"\n86\t            creature = source.attached_to\n87\t            if creature is None or not _is_on_battlefield(game, creature):\n88\t                return\n89\t            equip_ref = source\n90\t\n91\t            def _apply_landfall_pt(game: Any) -> None:\n92\t                if not _is_on_battlefield(game, equip_ref):\n93\t                    return\n94\t                c = equip_ref.attached_to\n95\t                if c is not creature:\n96\t                    return\n97\t                if c is None or not _is_on_battlefield(game, c):\n98\t                    return\n99\t                c.modified_power += 2\n100\t                c.modified_toughness += 2\n101\t            game.effect_manager.add(ContinuousEffect(source=equip_ref, layer=Layer.POWER_TOUGHNESS, sublayer=SubLayer.MODIFY_PT, apply=_apply_landfall_pt, duration=DURATION_PERMANENT))\n102\t        controller = getattr(self, 'controller', None) or game.active_player\n103\t        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=controller))\n104\t"}]},"parent_tool_use_id":"toolu_01QTHZ9RYgmYJYYrHMdM5GwN","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"5a9c7d61-0d65-489f-9b4f-c65327ff9638","timestamp":"2026-05-28T01:37:17.484Z","subagent_type":"Tester","task_description":"Tester for sos_257"}
