{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D9U61Mx74Krbu9mbmjdqkv","type":"tool_result","content":"1\t\"\"\"Card implementation for Improvisation Capstone (SOS 120).\n2\t\n3\tImprovisation Capstone — {5}{R}{R} — Sorcery — Lesson\n4\t\n5\tExile cards from the top of your library until you exile cards with total\n6\tmana value 4 or greater. You may cast any number of spells from among them\n7\twithout paying their mana costs.\n8\t\n9\tParadigm (Then exile this spell. After you first resolve a spell with this\n10\tname, you may cast a copy of it from exile without paying its mana cost at\n11\tthe beginning of each of your first main phases.)\n12\t\"\"\"\n13\t\n14\tfrom __future__ import annotations\n15\t\n16\tfrom typing import TYPE_CHECKING, Any\n17\t\n18\tfrom engine.card import Sorcery\n19\tfrom engine.events import BeginningOfMainPhaseTriggeredEvent\n20\tfrom engine.triggers import TriggerRegistration\n21\tfrom engine.types import CardType, ManaCost, Zone\n22\t\n23\tif TYPE_CHECKING:\n24\t    from engine.game_state import GameState\n25\t\n26\t\n27\t# ---------------------------------------------------------------------------\n28\t# Phase restriction for observability (coordinator directive)\n29\t# ---------------------------------------------------------------------------\n30\t\n31\t_PARADIGM_PHASE = \"PRECOMBAT_MAIN\"\n32\t\n33\t\n34\tclass ImprovisationCapstone(Sorcery):\n35\t    \"\"\"Improvisation Capstone — {5}{R}{R} — Sorcery — Lesson.\n36\t\n37\t    SOS collector number 120.\n38\t    \"\"\"\n39\t\n40\t    # Observability attribute per coordinator directive\n41\t    paradigm_phase_restriction: str = _PARADIGM_PHASE\n42\t\n43\t    def __init__(self, **kwargs: Any) -> None:\n44\t        kwargs.setdefault(\"name\", \"Improvisation Capstone\")\n45\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{5}{R}{R}\"))\n46\t        kwargs.setdefault(\"subtypes\", {\"Lesson\"})\n47\t        kwargs.setdefault(\n48\t            \"rules_text\",\n49\t            \"Exile cards from the top of your library until you exile cards \"\n50\t            \"with total mana value 4 or greater. You may cast any number of \"\n51\t            \"spells from among them without paying their mana costs.\\n\"\n52\t            \"Paradigm (Then exile this spell. After you first resolve a spell \"\n53\t            \"with this name, you may cast a copy of it from exile without \"\n54\t            \"paying its mana cost at the beginning of each of your first main phases.)\",\n55\t        )\n56\t        super().__init__(**kwargs)\n57\t        # Paradigm observability flag (coordinator directive)\n58\t        self.paradigm_resolved: bool = False\n59\t\n60\t    # ------------------------------------------------------------------\n61\t    # Main effect\n62\t    # ------------------------------------------------------------------\n63\t\n64\t    def on_resolve(self, game: \"GameState\") -> None:\n65\t        \"\"\"Exile cards from library top until total MV >= 4; offer free casts.\"\"\"\n66\t        controller = self.controller\n67\t        if controller is None:\n68\t            return\n69\t\n70\t        library = controller.zones[Zone.LIBRARY]\n71\t        exile = controller.zones[Zone.EXILE]\n72\t\n73\t        # --- Exile cards until total MV >= 4 ---\n74\t        total_mv = 0\n75\t        exiled_cards: list[Any] = []\n76\t\n77\t        while True:\n78\t            all_cards = library.get_all()\n79\t            if not all_cards:\n80\t                break\n81\t            # Top of library is the last element (index -1)\n82\t            top_card = all_cards[-1]\n83\t            # Move card from library to exile\n84\t            library.remove(top_card)\n85\t            exile.add(top_card)\n86\t            exiled_cards.append(top_card)\n87\t\n88\t            # Accumulate mana value\n89\t            mana_cost = getattr(top_card, \"mana_cost\", None)\n90\t            mv = mana_cost.cmc if mana_cost is not None else 0\n91\t            total_mv += mv\n92\t\n93\t            if total_mv >= 4:\n94\t                break\n95\t\n96\t        # --- Offer free casts for any number of the exiled cards ---\n97\t        # UNVERIFIED: any number of free casts offered\n98\t        # In a full game, the controller would be given the option to cast\n99\t        # each exiled card for free. Here we track them for observability.\n100\t        # The cards are already in exile — a real implementation would call\n101\t        # cast_spell_free for each card the player chooses to cast.\n102\t        if exiled_cards and controller is not None:\n103\t            _offer_free_casts(game, controller, exiled_cards)\n104\t\n105\t        # --- Paradigm: exile this spell and register the recurring trigger ---\n106\t        self._paradigm_resolve(game)\n107\t\n108\t    # ------------------------------------------------------------------\n109\t    # Paradigm logic\n110\t    # ------------------------------------------------------------------\n111\t\n112\t    def _paradigm_resolve(self, game: \"GameState\") -> None:\n113\t        \"\"\"Handle Paradigm: exile self, register recurring main-phase trigger.\"\"\"\n114\t        controller = self.controller\n115\t        owner = self.owner if self.owner is not None else controller\n116\t\n117\t        # Move self from graveyard to exile (Paradigm self-exile).\n118\t        # The engine may have already moved us to the graveyard — find us.\n119\t        if owner is not None:\n120\t            graveyard = owner.zones[Zone.GRAVEYARD]\n121\t            exile = owner.zones[Zone.EXILE]\n122\t            if graveyard.contains(self):\n123\t                graveyard.remove(self)\n124\t                exile.add(self)\n125\t            # If we're not in the graveyard (e.g. engine moved us elsewhere),\n126\t            # don't double-add; just ensure we're in exile.\n127\t            elif not exile.contains(self):\n128\t                exile.add(self)\n129\t\n130\t        # Guard: only register the recurring trigger on first resolution.\n131\t        if self.paradigm_resolved:\n132\t            return\n133\t\n134\t        self.paradigm_resolved = True\n135\t\n136\t        if controller is None:\n137\t            return\n138\t\n139\t        _register_paradigm_trigger(game, self, controller)\n140\t\n141\t\n142\t# ---------------------------------------------------------------------------\n143\t# Helpers\n144\t# ---------------------------------------------------------------------------\n145\t\n146\t\n147\tdef _offer_free_casts(\n148\t    game: \"GameState\",\n149\t    controller: Any,\n150\t    exiled_cards: list[Any],\n151\t) -> None:\n152\t    \"\"\"Offer the controller a free cast of each card in *exiled_cards*.\n153\t\n154\t    In a real game engine this would loop and let the player cast any number\n155\t    of the exiled cards for free. Here we attempt a cast for each card the\n156\t    player wants to cast, using try/except for test compatibility.\n157\t\n158\t    UNVERIFIED: any number of free casts offered\n159\t    \"\"\"\n160\t    from engine.casting import cast_spell_free  # local import to avoid circulars\n161\t\n162\t    for card in exiled_cards:\n163\t        # Ask the player if they want to cast this card for free.\n164\t        try:\n165\t            proceed = controller.choose_yes_no(\n166\t                f\"Cast {getattr(card, 'name', card)} for free?\"\n167\t            )\n168\t        except Exception:\n169\t            # Default: do not auto-cast in test contexts without scripts.\n170\t            proceed = False\n171\t\n172\t        if not proceed:\n173\t            continue\n174\t\n175\t        # Only cast if the card is still in exile (it was placed there above).\n176\t        exile = controller.zones[Zone.EXILE]\n177\t        if not exile.contains(card):\n178\t            continue\n179\t\n180\t        if card.owner is None:\n181\t            card.owner = controller\n182\t        card.controller = controller\n183\t\n184\t        cast_spell_free(game, controller, card, Zone.EXILE)\n185\t\n186\t\n187\tdef _register_paradigm_trigger(\n188\t    game: \"GameState\",\n189\t    spell: \"ImprovisationCapstone\",\n190\t    controller: Any,\n191\t) -> None:\n192\t    \"\"\"Register the recurring Paradigm trigger for Improvisation Capstone.\n193\t\n194\t    Fires at the beginning of each of the controller's PRECOMBAT_MAIN phases.\n195\t    When it fires, the controller may cast a copy of Improvisation Capstone\n196\t    from exile without paying its mana cost.\n197\t    \"\"\"\n198\t    source = spell\n199\t\n200\t    def _condition(g: \"GameState\", event: BeginningOfMainPhaseTriggeredEvent) -> bool:\n201\t        \"\"\"Fire only for controller's main phase (PRECOMBAT_MAIN).\"\"\"\n202\t        return event.player is controller\n203\t\n204\t    def _effect(g: \"GameState\") -> None:\n205\t        \"\"\"Offer the controller a free cast of Improvisation Capstone from exile.\"\"\"\n206\t        _paradigm_free_cast(g, source, controller)\n207\t\n208\t    game.trigger_manager.register(\n209\t        TriggerRegistration(\n210\t            event_type=BeginningOfMainPhaseTriggeredEvent,\n211\t            condition=_condition,\n212\t            effect=_effect,\n213\t            source=source,\n214\t            controller=controller,\n215\t        )\n216\t    )\n217\t\n218\t\n219\tdef _paradigm_free_cast(\n220\t    game: \"GameState\",\n221\t    original: \"ImprovisationCapstone\",\n222\t    controller: Any,\n223\t) -> None:\n224\t    \"\"\"Cast a copy of Improvisation Capstone from exile without paying its mana cost.\n225\t\n226\t    For simplicity, this casts the original exiled card rather than a true copy,\n227\t    since a full copy mechanism is out of scope.\n228\t    # UNVERIFIED: cast copy vs original\n229\t    \"\"\"\n230\t    from engine.casting import cast_spell_free  # local import to avoid circulars\n231\t\n232\t    # Find Improvisation Capstone in controller's exile zone.\n233\t    exile = controller.zones[Zone.EXILE]\n234\t    cards_in_exile = exile.get_all()\n235\t\n236\t    capstone = None\n237\t    for card in cards_in_exile:\n238\t        if card is original or getattr(card, \"name\", \"\") == \"Improvisation Capstone\":\n239\t            capstone = card\n240\t            break\n241\t\n242\t    if capstone is None:\n243\t        return\n244\t\n245\t    # May ability — ask the player.\n246\t    try:\n247\t        proceed = controller.choose_yes_no(\n248\t            \"Cast Improvisation Capstone from exile without paying its mana cost?\"\n249\t        )\n250\t    except Exception:\n251\t        # Default: auto-yes in test contexts without scripted choices.\n252\t        proceed = True\n253\t\n254\t    if not proceed:\n255\t        return\n256\t\n257\t    if capstone.owner is None:\n258\t        capstone.owner = controller\n259\t    capstone.controller = controller\n260\t\n261\t    cast_spell_free(game, controller, capstone, Zone.EXILE)\n262\t"}]},"parent_tool_use_id":"toolu_018W5msMc4snNkXsB1RqC4SD","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"15e811c8-02df-4542-8ad4-8305d53bec43","timestamp":"2026-05-28T00:54:18.040Z","subagent_type":"Implementer","task_description":"Revision round for sos_120"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0198aF5W2t2zVoT1iYtoPhWx","type":"tool_result","content":"1\t\"\"\"Typed event objects for triggered abilities and replacement effects.\n2\t\n3\tTriggered events are passed to :meth:`TriggerManager.fire_event` and\n4\tforwarded to trigger condition callables.\n5\t\n6\tReplacement events are passed to :meth:`ReplacementManager.apply` and\n7\tforwarded to replacement condition/replacement callables.  Subclassing\n8\tencodes event-type hierarchy so a replacement registered for a parent\n9\ttype (e.g. ``MoveToGraveyardReplacementEvent``) also fires for\n10\tsubtypes (e.g. ``CreatureDiesReplacementEvent``).\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\tfrom dataclasses import dataclass\n16\tfrom typing import Any\n17\t\n18\t\n19\t# ---------------------------------------------------------------------------\n20\t# Triggered events\n21\t# ---------------------------------------------------------------------------\n22\t\n23\t@dataclass\n24\tclass TriggeredEvent:\n25\t    \"\"\"Base class for all triggered-ability events.\"\"\"\n26\t\n27\t\n28\t@dataclass\n29\tclass EntersBattlefieldTriggeredEvent(TriggeredEvent):\n30\t    permanent: Any = None\n31\t    controller: Any = None\n32\t    card: Any = None\n33\t    creature: Any = None\n34\t\n35\t\n36\t@dataclass\n37\tclass LeavesBattlefieldTriggeredEvent(TriggeredEvent):\n38\t    permanent: Any = None\n39\t    controller: Any = None\n40\t\n41\t\n42\t@dataclass\n43\tclass DealsDamageTriggeredEvent(TriggeredEvent):\n44\t    source: Any = None\n45\t    target: Any = None\n46\t    amount: int = 0\n47\t    is_combat: bool = False\n48\t    combat: bool = False\n49\t\n50\t\n51\t@dataclass\n52\tclass LosesLifeTriggeredEvent(TriggeredEvent):\n53\t    player: Any = None\n54\t    amount: int = 0\n55\t\n56\t\n57\t@dataclass\n58\tclass GainsLifeTriggeredEvent(TriggeredEvent):\n59\t    player: Any = None\n60\t    amount: int = 0\n61\t\n62\t\n63\t@dataclass\n64\tclass DrawsCardTriggeredEvent(TriggeredEvent):\n65\t    player: Any = None\n66\t    card: Any = None\n67\t\n68\t\n69\t@dataclass\n70\tclass BeginningOfUpkeepTriggeredEvent(TriggeredEvent):\n71\t    pass\n72\t\n73\t\n74\t@dataclass\n75\tclass BeginningOfCombatTriggeredEvent(TriggeredEvent):\n76\t    pass\n77\t\n78\t\n79\t@dataclass\n80\tclass EndOfTurnTriggeredEvent(TriggeredEvent):\n81\t    pass\n82\t\n83\t\n84\t@dataclass\n85\tclass EndStepTriggeredEvent(TriggeredEvent):\n86\t    player: Any = None\n87\t\n88\t\n89\t@dataclass\n90\tclass CreatureDiesTriggeredEvent(TriggeredEvent):\n91\t    creature: Any = None\n92\t    controller: Any = None\n93\t    owner: Any = None\n94\t\n95\t\n96\t@dataclass\n97\tclass SpellCastTriggeredEvent(TriggeredEvent):\n98\t    spell: Any = None\n99\t    player: Any = None\n100\t    card: Any = None\n101\t    controller: Any = None\n102\t\n103\t\n104\t@dataclass\n105\tclass AttacksTriggeredEvent(TriggeredEvent):\n106\t    creature: Any = None\n107\t    attacker: Any = None\n108\t\n109\t\n110\t@dataclass\n111\tclass BlocksTriggeredEvent(TriggeredEvent):\n112\t    creature: Any = None\n113\t\n114\t\n115\t@dataclass\n116\tclass CounterAddedTriggeredEvent(TriggeredEvent):\n117\t    permanent: Any = None\n118\t    counter_type: Any = None\n119\t    amount: int = 0\n120\t\n121\t\n122\t@dataclass\n123\tclass BeginningOfMainPhaseTriggeredEvent(TriggeredEvent):\n124\t    \"\"\"Fired at the start of the PRECOMBAT_MAIN phase.\"\"\"\n125\t\n126\t    player: Any = None\n127\t\n128\t\n129\t# ---------------------------------------------------------------------------\n130\t# Replacement events\n131\t# ---------------------------------------------------------------------------\n132\t\n133\t@dataclass\n134\tclass ReplacementEvent:\n135\t    \"\"\"Base class for all replacement-effect events.\"\"\"\n136\t\n137\t\n138\t@dataclass\n139\tclass MoveToGraveyardReplacementEvent(ReplacementEvent):\n140\t    \"\"\"Any permanent moving to a graveyard.\n141\t\n142\t    Subclass this for specific causes (destruction, sacrifice, etc.).\n143\t    A replacement registered for this type also fires for all subtypes.\n144\t\n145\t    ``destination`` may be mutated by a replacement to redirect the\n146\t    permanent to a different zone (``\"exile\"``, ``\"library\"``, ``\"hand\"``).\n147\t    Set ``prevented = True`` to signal that the replacement handled the\n148\t    zone move itself and the engine should skip its own move.\n149\t    \"\"\"\n150\t\n151\t    destination: str = \"graveyard\"\n152\t    controller: Any = None\n153\t    owner: Any = None\n154\t    prevented: bool = False\n155\t\n156\t    @property\n157\t    def card(self) -> Any:\n158\t        \"\"\"The object moving to the graveyard (overridden by subclasses).\"\"\"\n159\t        return None\n160\t\n161\t\n162\t@dataclass\n163\tclass CreatureDiesReplacementEvent(MoveToGraveyardReplacementEvent):\n164\t    \"\"\"A creature going to the graveyard via destruction or lethal damage.\"\"\"\n165\t\n166\t    creature: Any = None\n167\t\n168\t    @property\n169\t    def card(self) -> Any:\n170\t        return self.creature\n171\t\n172\t\n173\t@dataclass\n174\tclass PermanentDestroyedReplacementEvent(MoveToGraveyardReplacementEvent):\n175\t    \"\"\"A non-creature permanent going to the graveyard via destruction.\"\"\"\n176\t\n177\t    permanent: Any = None\n178\t\n179\t    @property\n180\t    def card(self) -> Any:\n181\t        return self.permanent\n182\t\n183\t\n184\t@dataclass\n185\tclass SacrificeReplacementEvent(MoveToGraveyardReplacementEvent):\n186\t    \"\"\"A permanent going to the graveyard via sacrifice.\"\"\"\n187\t\n188\t    permanent: Any = None\n189\t\n190\t    @property\n191\t    def card(self) -> Any:\n192\t        return self.permanent\n193\t\n194\t\n195\t@dataclass\n196\tclass CreateTokenReplacementEvent(ReplacementEvent):\n197\t    \"\"\"An effect about to create one or more tokens.\"\"\"\n198\t\n199\t    player: Any = None\n200\t    count: int = 1\n201\t\n202\t\n203\t@dataclass\n204\tclass AddCounterReplacementEvent(ReplacementEvent):\n205\t    \"\"\"An effect about to add one or more counters to a permanent.\"\"\"\n206\t\n207\t    permanent: Any = None\n208\t    amount: int = 1\n209\t"}]},"parent_tool_use_id":"toolu_018W5msMc4snNkXsB1RqC4SD","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"296a0007-dab4-47d9-9090-727578298b9d","timestamp":"2026-05-28T00:54:18.040Z","subagent_type":"Implementer","task_description":"Revision round for sos_120"}
