{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SMaNLxFZPzZqVASxaQFtX7","type":"tool_result","content":"1\t\"\"\"Card implementation for Ambush Wolf.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom typing import TYPE_CHECKING, Any\n4\tfrom engine.card import ArtifactCreature, Creature\n5\tfrom engine.continuous_effects import ContinuousEffect, DURATION_END_OF_TURN, Layer, SubLayer\n6\tfrom engine.types import CardType, Keyword, ManaCost, Zone\n7\tfrom engine.events import EntersBattlefieldTriggeredEvent\n8\tif TYPE_CHECKING:\n9\t    from engine.game_state import GameState\n10\t    from cards.registry import CardRegistry\n11\t\n12\tdef _self_etb_condition(source: Any):\n13\t    \"\"\"Return a condition callable that matches only when *source* enters.\"\"\"\n14\t\n15\t    def _condition(game: Any, event: dict) -> bool:\n16\t        return event.permanent is source\n17\t    return _condition\n18\t\n19\tdef _get_chosen_target(card: Any, game: Any) -> Any:\n20\t    chosen = getattr(card, 'chosen_targets', None)\n21\t    if chosen:\n22\t        return chosen[0]\n23\t    return getattr(card, '_resolve_target', None)\n24\t\n25\tclass AmbushWolf(Creature):\n26\t    \"\"\"Ambush Wolf — {2}{G} — 4/2 — Wolf — Flash\n27\t\n28\t    When this creature enters, exile up to one target card from a graveyard.\n29\t\n30\t    FDN collector number 98.\n31\t    \"\"\"\n32\t\n33\t    def __init__(self, **kwargs: Any) -> None:\n34\t        kwargs.setdefault('name', 'Ambush Wolf')\n35\t        kwargs.setdefault('mana_cost', ManaCost.parse('{2}{G}'))\n36\t        kwargs.setdefault('subtypes', {'Wolf'})\n37\t        kwargs.setdefault('keywords', Keyword.FLASH)\n38\t        kwargs.setdefault('base_power', 4)\n39\t        kwargs.setdefault('base_toughness', 2)\n40\t        kwargs.setdefault('rules_text', 'Flash\\nWhen this creature enters, exile up to one target card from a graveyard.')\n41\t        super().__init__(**kwargs)\n42\t\n43\t    def register_triggers(self, game: GameState) -> None:\n44\t        from engine.triggers import TriggerRegistration\n45\t        source = self\n46\t\n47\t        def _effect(game: GameState) -> None:\n48\t            target = _get_chosen_target(source, game)\n49\t            if target is None:\n50\t                return\n51\t            for player in game.players:\n52\t                gy = player.zones[Zone.GRAVEYARD]\n53\t                if gy.contains(target):\n54\t                    gy.remove(target)\n55\t                    owner = getattr(target, 'owner', player)\n56\t                    owner.zones[Zone.EXILE].add(target)\n57\t                    return\n58\t        controller = getattr(self, 'controller', None) or game.active_player\n59\t        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=_self_etb_condition(self), effect=_effect, source=self, controller=controller))\n60\t"}]},"parent_tool_use_id":"toolu_01LkcWR1HxHKpCqu5oUyMLGu","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"0276cad4-51e0-4a36-a1ab-33f22795aa59","timestamp":"2026-05-28T00:15:28.804Z","subagent_type":"Implementer","task_description":"Implementer for sos_13"}
