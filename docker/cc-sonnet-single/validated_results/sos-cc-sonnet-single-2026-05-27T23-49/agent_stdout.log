{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_01VPuBHqBieJnsvdf8wh9EEr","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Xm2z8sstT8HYvRyhYyhjdX","name":"Read","input":{"file_path":"/workspace/engine/turn.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":4158,"cache_read_input_tokens":13851,"cache_creation":{"ephemeral_5m_input_tokens":4158,"ephemeral_1h_input_tokens":0},"output_tokens":44,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01HHrusMb65YDLKTUU3AyBr2","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"e4c065dd-66f2-4d43-bf1e-32d5ceec8fd0","request_id":"req_011CbU2N18yae22YmfohsuNk","subagent_type":"Reviewer","task_description":"Reviewer for sos_57"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Xm2z8sstT8HYvRyhYyhjdX","type":"tool_result","content":"1\t\"\"\"Turn execution loop for the SilverquiLLM engine.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport warnings\n6\tfrom typing import TYPE_CHECKING\n7\t\n8\tif TYPE_CHECKING:\n9\t    from engine.game_state import GameState\n10\t\n11\tfrom engine.stack import priority_loop\n12\tfrom engine.types import Phase, Step, Zone\n13\t\n14\t\n15\t# Maximum hand size — players discard down to this during cleanup.\n16\tMAX_HAND_SIZE: int = 7\n17\t\n18\t\n19\t# Steps/phases where priority is given to players.\n20\t# In MTG, players do NOT receive priority during Untap and Cleanup (normally).\n21\t_NO_PRIORITY_STEPS: set[tuple[Phase, Step | None]] = {\n22\t    (Phase.BEGINNING, Step.UNTAP),\n23\t    (Phase.ENDING, Step.CLEANUP),\n24\t}\n25\t\n26\t\n27\tdef _do_untap_step(game: GameState) -> None:\n28\t    \"\"\"Perform untap step actions: untap all permanents controlled by the active player.\n29\t\n30\t    Per MTG rules, the active player untaps all permanents they control\n31\t    during their untap step. Summoning sickness is also cleared at this point.\n32\t    \"\"\"\n33\t    active = game.active_player\n34\t    bf = active.zones[Zone.BATTLEFIELD]\n35\t    for obj in bf.get_all():\n36\t        if hasattr(obj, \"is_tapped\"):\n37\t            obj.is_tapped = False\n38\t        if hasattr(obj, \"summoning_sick\"):\n39\t            obj.summoning_sick = False\n40\t\n41\t    # Reset land plays for the active player\n42\t    active.land_plays_remaining = 1\n43\t\n44\t\n45\tdef _do_draw_step(game: GameState) -> None:\n46\t    \"\"\"Perform draw step actions: active player draws a card.\n47\t\n48\t    In a two-player game, the starting player (the player who takes\n49\t    turn 1) skips their draw step on that first turn.  This is per\n50\t    MTG comprehensive rules §103.7a.\n51\t    \"\"\"\n52\t    # The starting player skips their draw on turn 1.\n53\t    if game.turn_number == 1 and game.active_player_index == 0:\n54\t        return\n55\t\n56\t    from engine.game import draw_card\n57\t\n58\t    draw_card(game, game.active_player)\n59\t\n60\t\n61\tdef _do_combat_step(game: GameState, step: Step) -> None:\n62\t    \"\"\"Dispatch combat sub-steps to the appropriate combat functions.\n63\t\n64\t    Parameters:\n65\t        game: The current game state.\n66\t        step: The combat step to execute.\n67\t    \"\"\"\n68\t    from engine.combat import (\n69\t        combat_damage_step,\n70\t        declare_attackers_step,\n71\t        declare_blockers_step,\n72\t        end_combat_step,\n73\t    )\n74\t\n75\t    if step == Step.DECLARE_ATTACKERS:\n76\t        declare_attackers_step(game)\n77\t    elif step == Step.DECLARE_BLOCKERS:\n78\t        declare_blockers_step(game)\n79\t    elif step == Step.COMBAT_DAMAGE:\n80\t        combat_damage_step(game)\n81\t    elif step == Step.END_COMBAT:\n82\t        end_combat_step(game)\n83\t\n84\t\n85\tdef _do_cleanup_step(game: GameState) -> None:\n86\t    \"\"\"Perform the cleanup step (MTG rule §514).\n87\t\n88\t    The cleanup step executes the following actions in order:\n89\t\n90\t    1. Active player discards down to maximum hand size (7) using\n91\t       :meth:`Player.choose_card`.\n92\t    2. Remove all \"until end of turn\" continuous effects via\n93\t       :meth:`EffectManager.remove_expired`, then reapply remaining\n94\t       effects for a consistent game state.\n95\t    3. Clear damage marked on all creatures on the battlefield.\n96\t    4. Clear combat-related flags (``dealt_deathtouch_damage``,\n97\t       ``is_attacking``, ``is_blocking``) and reset the combat state.\n98\t    5. Empty all players' mana pools.\n99\t    6. Check state-based actions.\n100\t    7. If triggers fired during cleanup (e.g. from discarding), process\n101\t       them (give priority, resolve stack) and perform another cleanup step.\n102\t    \"\"\"\n103\t    from engine.game import discard as _discard\n104\t    from engine.player import ScriptExhaustedError\n105\t    from engine.state_based_actions import resolve_state_based_actions\n106\t\n107\t    # --- Step 1: Discard to hand size ---\n108\t    active = game.active_player\n109\t    hand = active.zones[Zone.HAND]\n110\t    while len(hand) > MAX_HAND_SIZE:\n111\t        cards_in_hand = hand.get_all()\n112\t        if not cards_in_hand:\n113\t            break  # safety guard\n114\t        try:\n115\t            chosen = active.choose_card(cards_in_hand, \"discard to hand size\")\n116\t        except (ScriptExhaustedError, NotImplementedError) as exc:\n117\t            # Player implementation doesn't support choose_card or script\n118\t            # was exhausted.  Discard deterministically from end.\n119\t            chosen = cards_in_hand[-1]\n120\t            exc_name = type(exc).__name__\n121\t            warnings.warn(\n122\t                f\"{exc_name} during cleanup discard for {active.name}; \"\n123\t                f\"auto-discarding {chosen.name}\"\n124\t            )\n125\t        if chosen is not None and hand.contains(chosen):\n126\t            _discard(game, active, chosen)\n127\t        else:\n128\t            # If choose_card returns something invalid, discard the last card\n129\t            # to avoid an infinite loop.\n130\t            _discard(game, active, cards_in_hand[-1])\n131\t\n132\t    # --- Step 2: Remove \"until end of turn\" continuous effects ---\n133\t    if hasattr(game, \"effect_manager\"):\n134\t        game.effect_manager.remove_expired(game)\n135\t        # Reapply remaining effects so the game state is consistent.\n136\t        game.effect_manager.apply_all(game)\n137\t\n138\t    # --- Step 3: Clear damage on all creatures ---\n139\t    for player in game.players:\n140\t        bf = player.zones[Zone.BATTLEFIELD]\n141\t        for obj in bf.get_all():\n142\t            if hasattr(obj, \"damage_marked\"):\n143\t                obj.damage_marked = 0\n144\t\n145\t    # --- Step 4: Clear combat flags ---\n146\t    for player in game.players:\n147\t        bf = player.zones[Zone.BATTLEFIELD]\n148\t        for obj in bf.get_all():\n149\t            if hasattr(obj, \"dealt_deathtouch_damage\"):\n150\t                obj.dealt_deathtouch_damage = False\n151\t            if hasattr(obj, \"is_attacking\"):\n152\t                obj.is_attacking = False\n153\t            if hasattr(obj, \"is_blocking\"):\n154\t                obj.is_blocking = False\n155\t    # Reset the CombatState itself.\n156\t    if hasattr(game, \"combat_state\"):\n157\t        game.combat_state.clear()\n158\t\n159\t    # --- Step 5: Empty mana pools ---\n160\t    game.empty_mana_pools()\n161\t\n162\t    # --- Step 6: Check state-based actions ---\n163\t    sba_happened = resolve_state_based_actions(game)\n164\t\n165\t    # --- Step 7: If SBAs were performed or triggers fired, process & repeat ---\n166\t    # Rule 514.3a: if state-based actions were performed or triggered abilities\n167\t    # triggered during cleanup, another cleanup step occurs.\n168\t    if sba_happened or not game.stack.is_empty():\n169\t        # Triggers were placed on the stack — give priority and resolve.\n170\t        priority_loop(game)\n171\t        # After resolving, perform another cleanup step (recursive).\n172\t        _do_cleanup_step(game)\n173\t\n174\t\n175\tdef run_turn(game: GameState) -> None:\n176\t    \"\"\"Execute a full turn, iterating through all phases/steps.\n177\t\n178\t    At each priority point (every phase/step except Untap and Cleanup),\n179\t    :func:`priority_loop` is called.  Turn-based actions are performed\n180\t    at the appropriate steps:\n181\t\n182\t    - **Untap**: Untap all permanents, clear summoning sickness, reset\n183\t      land plays.\n184\t    - **Draw**: Active player draws a card.\n185\t    - **Combat**: Delegate to combat system functions.\n186\t    - **Cleanup**: Clear damage, remove expired effects.\n187\t\n188\t    After the last step (Cleanup), the turn number is incremented and\n189\t    the active player swaps via :meth:`GameState.advance_phase`.\n190\t\n191\t    Parameters:\n192\t        game: The game state to advance through one complete turn.\n193\t    \"\"\"\n194\t    start_turn = game.turn_number\n195\t\n196\t    while game.turn_number == start_turn:\n197\t        current = (game.phase, game.step)\n198\t\n199\t        # Perform turn-based actions for the current step\n200\t        if current == (Phase.BEGINNING, Step.UNTAP):\n201\t            _do_untap_step(game)\n202\t        elif current == (Phase.BEGINNING, Step.UPKEEP):\n203\t            from engine.events import BeginningOfUpkeepTriggeredEvent\n204\t            game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n205\t        elif current == (Phase.PRECOMBAT_MAIN, None):\n206\t            from engine.events import BeginningOfMainPhaseTriggeredEvent\n207\t            game.trigger_manager.fire_event(\n208\t                game, BeginningOfMainPhaseTriggeredEvent(player=game.active_player)\n209\t            )\n210\t        elif current == (Phase.BEGINNING, Step.DRAW):\n211\t            _do_draw_step(game)\n212\t        elif game.phase == Phase.COMBAT and game.step is not None:\n213\t            _do_combat_step(game, game.step)\n214\t        elif current == (Phase.ENDING, Step.CLEANUP):\n215\t            _do_cleanup_step(game)\n216\t\n217\t        # Grant priority at this phase/step unless it's Untap or Cleanup.\n218\t        if current not in _NO_PRIORITY_STEPS:\n219\t            priority_loop(game)\n220\t\n221\t        # Advance to the next phase/step (or to next turn).\n222\t        game.advance_phase()\n223\t"}]},"parent_tool_use_id":"toolu_01HHrusMb65YDLKTUU3AyBr2","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"32c18a94-eb88-4ca1-894d-2027a246d984","timestamp":"2026-05-28T00:31:31.262Z","subagent_type":"Reviewer","task_description":"Reviewer for sos_57"}
{"type":"system","subtype":"task_progress","task_id":"a6460a862598bb70f","tool_use_id":"toolu_01HHrusMb65YDLKTUU3AyBr2","description":"Reading cards/sos/sos_57/tests.py","subagent_type":"Reviewer","usage":{"total_tokens":18296,"tool_uses":9,"duration_ms":11198},"last_tool_name":"Read","uuid":"a3164318-1f06-437a-9698-02eac823009e","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b"}
{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_01VPuBHqBieJnsvdf8wh9EEr","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_016q3TMMYVpxqo4u9SkM1HyQ","name":"Read","input":{"file_path":"/workspace/cards/sos/sos_57/tests.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":4158,"cache_read_input_tokens":13851,"cache_creation":{"ephemeral_5m_input_tokens":4158,"ephemeral_1h_input_tokens":0},"output_tokens":44,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01HHrusMb65YDLKTUU3AyBr2","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"3a6ecf76-3b2e-44ee-a77d-2b81bbb80c60","request_id":"req_011CbU2N18yae22YmfohsuNk","subagent_type":"Reviewer","task_description":"Reviewer for sos_57"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016q3TMMYVpxqo4u9SkM1HyQ","type":"tool_result","content":"1\t\"\"\"Tests for SOS 57 — Mana Sculpt.\n2\t\n3\tCovers:\n4\t- Static card properties (name, mana cost, type)\n5\t- Targeting API: get_targets returns a TargetRequirement for any spell on the stack\n6\t- can_cast: returns False when no valid target on the stack\n7\t- on_resolve: counters target spell (removes from stack, moves card to owner's graveyard)\n8\t- on_resolve without a Wizard: no mana bonus\n9\t- on_resolve with a Wizard: registers/schedules {C} equal to countered spell's CMC\n10\t- Mana amount equals the mana value (CMC) of the countered spell\n11\t- No chosen target: on_resolve is a graceful no-op\n12\t- Wizard check: only creatures with subtype \"Wizard\" on controller's battlefield count\n13\t\"\"\"\n14\t\n15\tfrom __future__ import annotations\n16\t\n17\timport pytest\n18\t\n19\tfrom cards.sos.sos_57.card_impl import ManaSculpt\n20\tfrom engine.card import Creature, Instant, Sorcery\n21\tfrom engine.types import CardType, ManaCost, ManaType, Zone, TargetRequirement\n22\tfrom engine.stack import StackObject\n23\tfrom test_utils import create_game, set_board_state\n24\t\n25\t\n26\t# ---------------------------------------------------------------------------\n27\t# Helper\n28\t# ---------------------------------------------------------------------------\n29\t\n30\tdef _make_wizard(name: str = \"Test Wizard\") -> Creature:\n31\t    \"\"\"Create a simple creature with the Wizard subtype.\"\"\"\n32\t    c = Creature(name=name, base_power=2, base_toughness=2)\n33\t    c.subtypes = {\"Wizard\"}\n34\t    return c\n35\t\n36\t\n37\tdef _push_spell(game, player, card) -> StackObject:\n38\t    \"\"\"Put card on the stack so it can be targeted.\"\"\"\n39\t    stack_obj = StackObject(source=card, controller=player)\n40\t    # Also place it in the player's stack zone so _counter_spell can find it.\n41\t    player.zones[Zone.STACK].add(card)\n42\t    game.stack.push(stack_obj)\n43\t    return stack_obj\n44\t\n45\t\n46\t# ---------------------------------------------------------------------------\n47\t# Static card properties\n48\t# ---------------------------------------------------------------------------\n49\t\n50\tclass TestManaSculptProperties:\n51\t    \"\"\"Static card data should match the SOS 57 spec.\"\"\"\n52\t\n53\t    def test_is_instant(self) -> None:\n54\t        card = ManaSculpt(owner=None)\n55\t        assert isinstance(card, Instant)\n56\t\n57\t    def test_name(self) -> None:\n58\t        card = ManaSculpt(owner=None)\n59\t        assert card.name == \"Mana Sculpt\"\n60\t\n61\t    def test_mana_cost(self) -> None:\n62\t        card = ManaSculpt(owner=None)\n63\t        assert card.mana_cost == ManaCost.parse(\"{1}{U}{U}\")\n64\t\n65\t    def test_card_type_is_instant(self) -> None:\n66\t        card = ManaSculpt(owner=None)\n67\t        assert CardType.INSTANT in card.card_types\n68\t\n69\t\n70\t# ---------------------------------------------------------------------------\n71\t# Targeting\n72\t# ---------------------------------------------------------------------------\n73\t\n74\tclass TestManaSculptTargeting:\n75\t    \"\"\"get_targets returns a single TargetRequirement for any spell on the stack.\"\"\"\n76\t\n77\t    def test_get_targets_returns_list(self) -> None:\n78\t        game = create_game()\n79\t        card = ManaSculpt(owner=None)\n80\t        result = card.get_targets(game)\n81\t        assert isinstance(result, list)\n82\t\n83\t    def test_get_targets_returns_one_requirement(self) -> None:\n84\t        game = create_game()\n85\t        card = ManaSculpt(owner=None)\n86\t        result = card.get_targets(game)\n87\t        assert len(result) == 1\n88\t\n89\t    def test_get_targets_requirement_is_target_requirement(self) -> None:\n90\t        game = create_game()\n91\t        card = ManaSculpt(owner=None)\n92\t        req = card.get_targets(game)[0]\n93\t        assert isinstance(req, TargetRequirement)\n94\t\n95\t    def test_target_zone_is_stack(self) -> None:\n96\t        game = create_game()\n97\t        card = ManaSculpt(owner=None)\n98\t        req = card.get_targets(game)[0]\n99\t        assert req.zone == Zone.STACK\n100\t\n101\t    def test_target_filter_accepts_spell_stack_object(self) -> None:\n102\t        \"\"\"The filter should accept a StackObject whose source is a spell.\"\"\"\n103\t        game = create_game()\n104\t        p1 = game.players[0]\n105\t        card = ManaSculpt(owner=p1, controller=p1)\n106\t        req = card.get_targets(game)[0]\n107\t\n108\t        spell = Sorcery(name=\"Divination\", mana_cost=ManaCost.parse(\"{2}{U}\"))\n109\t        stack_obj = StackObject(source=spell, controller=p1)\n110\t        assert req.filter_fn(stack_obj) is True\n111\t\n112\t    def test_target_filter_rejects_self(self) -> None:\n113\t        \"\"\"The filter must reject the ManaSculpt spell itself from targeting itself.\"\"\"\n114\t        game = create_game()\n115\t        p1 = game.players[0]\n116\t        card = ManaSculpt(owner=p1, controller=p1)\n117\t        req = card.get_targets(game)[0]\n118\t        self_obj = StackObject(source=card, controller=p1)\n119\t        assert req.filter_fn(self_obj) is False\n120\t\n121\t\n122\t# ---------------------------------------------------------------------------\n123\t# Countering the spell\n124\t# ---------------------------------------------------------------------------\n125\t\n126\tclass TestManaSculptCountersSpell:\n127\t    \"\"\"on_resolve removes the target spell from the stack and puts it in graveyard.\"\"\"\n128\t\n129\t    def test_on_resolve_removes_target_from_stack(self) -> None:\n130\t        game = create_game()\n131\t        p1 = game.players[0]\n132\t        p2 = game.players[1]\n133\t\n134\t        # Opponent's spell on the stack.\n135\t        opp_spell = Sorcery(name=\"Wrath\", mana_cost=ManaCost.parse(\"{2}{W}{W}\"))\n136\t        opp_spell.owner = p2\n137\t        target_stack_obj = _push_spell(game, p2, opp_spell)\n138\t\n139\t        counterspell = ManaSculpt(owner=p1, controller=p1)\n140\t        counterspell.chosen_targets = [target_stack_obj]\n141\t        counterspell.on_resolve(game)\n142\t\n143\t        assert game.stack.is_empty()\n144\t\n145\t    def test_on_resolve_moves_countered_spell_to_graveyard(self) -> None:\n146\t        game = create_game()\n147\t        p1 = game.players[0]\n148\t        p2 = game.players[1]\n149\t\n150\t        opp_spell = Sorcery(name=\"Wrath\", mana_cost=ManaCost.parse(\"{2}{W}{W}\"))\n151\t        opp_spell.owner = p2\n152\t        target_stack_obj = _push_spell(game, p2, opp_spell)\n153\t\n154\t        counterspell = ManaSculpt(owner=p1, controller=p1)\n155\t        counterspell.chosen_targets = [target_stack_obj]\n156\t        counterspell.on_resolve(game)\n157\t\n158\t        assert game.get_graveyard(p2).contains(opp_spell)\n159\t\n160\t    def test_on_resolve_no_target_is_noop(self) -> None:\n161\t        \"\"\"If there's no chosen target, on_resolve must not raise.\"\"\"\n162\t        game = create_game()\n163\t        p1 = game.players[0]\n164\t        card = ManaSculpt(owner=p1, controller=p1)\n165\t        # chosen_targets is empty or not set\n166\t        card.chosen_targets = []\n167\t        card.on_resolve(game)  # must not raise\n168\t\n169\t    def test_on_resolve_without_chosen_targets_attribute_is_noop(self) -> None:\n170\t        \"\"\"If chosen_targets attr is absent, on_resolve must not raise.\"\"\"\n171\t        game = create_game()\n172\t        p1 = game.players[0]\n173\t        card = ManaSculpt(owner=p1, controller=p1)\n174\t        card.on_resolve(game)  # must not raise\n175\t\n176\t\n177\t# ---------------------------------------------------------------------------\n178\t# No-Wizard: no mana bonus\n179\t# ---------------------------------------------------------------------------\n180\t\n181\tclass TestManaSculptNoWizardNoBonusMana:\n182\t    \"\"\"Without a Wizard on the battlefield, no mana is added.\"\"\"\n183\t\n184\t    def test_no_wizard_no_pending_mana(self) -> None:\n185\t        \"\"\"With no Wizard controlled, no mana should be pending or added.\"\"\"\n186\t        game = create_game()\n187\t        p1 = game.players[0]\n188\t        p2 = game.players[1]\n189\t\n190\t        # Ensure no Wizards on p1's battlefield.\n191\t        bear = Creature(name=\"Grizzly Bears\", base_power=2, base_toughness=2)\n192\t        bear.subtypes = {\"Bear\"}\n193\t        set_board_state(game, 0, battlefield=[bear])\n194\t\n195\t        opp_spell = Sorcery(name=\"Inferno\", mana_cost=ManaCost.parse(\"{4}{R}\"))\n196\t        opp_spell.owner = p2\n197\t        target_stack_obj = _push_spell(game, p2, opp_spell)\n198\t\n199\t        counterspell = ManaSculpt(owner=p1, controller=p1)\n200\t        counterspell.chosen_targets = [target_stack_obj]\n201\t        mana_before = p1.mana_pool.get(ManaType.COLORLESS)\n202\t        counterspell.on_resolve(game)\n203\t\n204\t        # Mana pool should not have increased immediately.\n205\t        mana_after = p1.mana_pool.get(ManaType.COLORLESS)\n206\t        assert mana_after == mana_before\n207\t\n208\t    def test_no_wizard_no_trigger_registered(self) -> None:\n209\t        \"\"\"Without a Wizard, no trigger should be registered for main-phase mana.\"\"\"\n210\t        game = create_game()\n211\t        p1 = game.players[0]\n212\t        p2 = game.players[1]\n213\t\n214\t        opp_spell = Sorcery(name=\"Divination\", mana_cost=ManaCost.parse(\"{2}{U}\"))\n215\t        opp_spell.owner = p2\n216\t        target_stack_obj = _push_spell(game, p2, opp_spell)\n217\t\n218\t        counterspell = ManaSculpt(owner=p1, controller=p1)\n219\t        counterspell.chosen_targets = [target_stack_obj]\n220\t\n221\t        triggers_before = len(game.trigger_manager.get_triggers())\n222\t        counterspell.on_resolve(game)\n223\t        triggers_after = len(game.trigger_manager.get_triggers())\n224\t\n225\t        assert triggers_after == triggers_before\n226\t\n227\t\n228\t# ---------------------------------------------------------------------------\n229\t# Wizard present: mana bonus scheduled\n230\t# ---------------------------------------------------------------------------\n231\t\n232\tclass TestManaSculptWizardBonusMana:\n233\t    \"\"\"With a Wizard controlled, {C} equal to countered spell's CMC is scheduled.\"\"\"\n234\t\n235\t    def test_wizard_triggers_mana_registration(self) -> None:\n236\t        \"\"\"With a Wizard present, a trigger or pending state is registered.\"\"\"\n237\t        game = create_game()\n238\t        p1 = game.players[0]\n239\t        p2 = game.players[1]\n240\t\n241\t        wizard = _make_wizard()\n242\t        wizard.owner = p1\n243\t        wizard.controller = p1\n244\t        set_board_state(game, 0, battlefield=[wizard])\n245\t\n246\t        opp_spell = Sorcery(name=\"Divination\", mana_cost=ManaCost.parse(\"{2}{U}\"))\n247\t        opp_spell.owner = p2\n248\t        target_stack_obj = _push_spell(game, p2, opp_spell)\n249\t\n250\t        counterspell = ManaSculpt(owner=p1, controller=p1)\n251\t        counterspell.chosen_targets = [target_stack_obj]\n252\t\n253\t        triggers_before = len(game.trigger_manager.get_triggers())\n254\t        counterspell.on_resolve(game)\n255\t        triggers_after = len(game.trigger_manager.get_triggers())\n256\t\n257\t        # A trigger (for the mana-at-main-phase effect) should have been registered.\n258\t        assert triggers_after > triggers_before\n259\t\n260\t    def test_mana_amount_equals_countered_spell_cmc(self) -> None:\n261\t        \"\"\"The mana added equals the CMC of the countered spell.\"\"\"\n262\t        game = create_game()\n263\t        p1 = game.players[0]\n264\t        p2 = game.players[1]\n265\t\n266\t        wizard = _make_wizard()\n267\t        wizard.owner = p1\n268\t        wizard.controller = p1\n269\t        set_board_state(game, 0, battlefield=[wizard])\n270\t\n271\t        # Spell with CMC 5 (3 generic + 1R + 1G = 5)\n272\t        opp_spell = Creature(\n273\t            name=\"Big Bear\",\n274\t            mana_cost=ManaCost.parse(\"{3}{R}{G}\"),\n275\t            base_power=5, base_toughness=5,\n276\t        )\n277\t        opp_spell.owner = p2\n278\t        target_stack_obj = _push_spell(game, p2, opp_spell)\n279\t\n280\t        counterspell = ManaSculpt(owner=p1, controller=p1)\n281\t        counterspell.chosen_targets = [target_stack_obj]\n282\t        counterspell.on_resolve(game)\n283\t\n284\t        # The pending mana attribute should record the CMC (5).\n285\t        pending = getattr(counterspell, \"pending_mana_amount\", None)\n286\t        assert pending == 5, (\n287\t            f\"Expected pending_mana_amount == 5 (CMC of countered spell), got {pending!r}\"\n288\t        )\n289\t\n290\t    def test_mana_amount_equals_zero_for_free_spell(self) -> None:\n291\t        \"\"\"For a zero-cost spell, the mana bonus is 0 {C}.\"\"\"\n292\t        game = create_game()\n293\t        p1 = game.players[0]\n294\t        p2 = game.players[1]\n295\t\n296\t        wizard = _make_wizard()\n297\t        wizard.owner = p1\n298\t        wizard.controller = p1\n299\t        set_board_state(game, 0, battlefield=[wizard])\n300\t\n301\t        free_spell = Instant(name=\"Ancestral Vision\", mana_cost=ManaCost())\n302\t        free_spell.owner = p2\n303\t        target_stack_obj = _push_spell(game, p2, free_spell)\n304\t\n305\t        counterspell = ManaSculpt(owner=p1, controller=p1)\n306\t        counterspell.chosen_targets = [target_stack_obj]\n307\t        counterspell.on_resolve(game)\n308\t\n309\t        pending = getattr(counterspell, \"pending_mana_amount\", None)\n310\t        assert pending == 0 or pending is None, (\n311\t            f\"Expected pending_mana_amount == 0 for a free spell, got {pending!r}\"\n312\t        )\n313\t\n314\t    def test_wizard_check_uses_controller_battlefield(self) -> None:\n315\t        \"\"\"Only the caster's battlefield is checked for a Wizard, not the opponent's.\"\"\"\n316\t        game = create_game()\n317\t        p1 = game.players[0]\n318\t        p2 = game.players[1]\n319\t\n320\t        # Wizard on OPPONENT's battlefield, not p1's.\n321\t        opp_wizard = _make_wizard(\"Opponent's Wizard\")\n322\t        opp_wizard.owner = p2\n323\t        opp_wizard.controller = p2\n324\t        set_board_state(game, 1, battlefield=[opp_wizard])\n325\t\n326\t        opp_spell = Sorcery(name=\"Shock\", mana_cost=ManaCost.parse(\"{R}\"))\n327\t        opp_spell.owner = p2\n328\t        target_stack_obj = _push_spell(game, p2, opp_spell)\n329\t\n330\t        counterspell = ManaSculpt(owner=p1, controller=p1)\n331\t        counterspell.chosen_targets = [target_stack_obj]\n332\t\n333\t        triggers_before = len(game.trigger_manager.get_triggers())\n334\t        counterspell.on_resolve(game)\n335\t        triggers_after = len(game.trigger_manager.get_triggers())\n336\t\n337\t        # No trigger should have been registered because p1 doesn't control a Wizard.\n338\t        assert triggers_after == triggers_before\n339\t\n340\t    def test_non_wizard_creature_does_not_trigger_bonus(self) -> None:\n341\t        \"\"\"A creature without the Wizard subtype should not enable the bonus.\"\"\"\n342\t        game = create_game()\n343\t        p1 = game.players[0]\n344\t        p2 = game.players[1]\n345\t\n346\t        non_wizard = Creature(name=\"Soldier\", base_power=2, base_toughness=2)\n347\t        non_wizard.subtypes = {\"Human\", \"Soldier\"}\n348\t        non_wizard.owner = p1\n349\t        non_wizard.controller = p1\n350\t        set_board_state(game, 0, battlefield=[non_wizard])\n351\t\n352\t        opp_spell = Sorcery(name=\"Brainstorm\", mana_cost=ManaCost.parse(\"{U}\"))\n353\t        opp_spell.owner = p2\n354\t        target_stack_obj = _push_spell(game, p2, opp_spell)\n355\t\n356\t        counterspell = ManaSculpt(owner=p1, controller=p1)\n357\t        counterspell.chosen_targets = [target_stack_obj]\n358\t\n359\t        triggers_before = len(game.trigger_manager.get_triggers())\n360\t        counterspell.on_resolve(game)\n361\t        triggers_after = len(game.trigger_manager.get_triggers())\n362\t\n363\t        assert triggers_after == triggers_before\n364\t\n365\t    def test_wizard_present_trigger_fires_at_main_phase(self) -> None:\n366\t        \"\"\"The registered trigger fires at beginning of next main phase and adds mana.\"\"\"\n367\t        from engine.events import BeginningOfMainPhaseTriggeredEvent  # Added by implementer\n368\t\n369\t        game = create_game()\n370\t        p1 = game.players[0]\n371\t        p2 = game.players[1]\n372\t\n373\t        wizard = _make_wizard()\n374\t        wizard.owner = p1\n375\t        wizard.controller = p1\n376\t        set_board_state(game, 0, battlefield=[wizard])\n377\t\n378\t        # CMC of the spell = 3 (1 generic + 1U + 1U = 3)\n379\t        opp_spell = Instant(name=\"Counterspell\", mana_cost=ManaCost.parse(\"{U}{U}\"))\n380\t        opp_spell.owner = p2\n381\t        target_stack_obj = _push_spell(game, p2, opp_spell)\n382\t\n383\t        counterspell = ManaSculpt(owner=p1, controller=p1)\n384\t        counterspell.chosen_targets = [target_stack_obj]\n385\t        counterspell.on_resolve(game)\n386\t\n387\t        # Simulate beginning of main phase event\n388\t        mana_before = p1.mana_pool.get(ManaType.COLORLESS)\n389\t        game.trigger_manager.fire_event(\n390\t            game, BeginningOfMainPhaseTriggeredEvent(player=p1)\n391\t        )\n392\t        # Resolve the triggered ability from the stack\n393\t        while not game.stack.is_empty():\n394\t            obj = game.stack.pop()\n395\t            obj.on_resolve(game)\n396\t\n397\t        mana_after = p1.mana_pool.get(ManaType.COLORLESS)\n398\t        # Spell CMC is 2 ({U}{U}), so 2 colorless should be added.\n399\t        assert mana_after - mana_before == 2\n400\t\n401\t    def test_trigger_is_one_shot(self) -> None:\n402\t        \"\"\"The main-phase mana trigger fires only once and then unregisters.\"\"\"\n403\t        from engine.events import BeginningOfMainPhaseTriggeredEvent  # Added by implementer\n404\t\n405\t        game = create_game()\n406\t        p1 = game.players[0]\n407\t        p2 = game.players[1]\n408\t\n409\t        wizard = _make_wizard()\n410\t        wizard.owner = p1\n411\t        wizard.controller = p1\n412\t        set_board_state(game, 0, battlefield=[wizard])\n413\t\n414\t        opp_spell = Sorcery(name=\"Terror\", mana_cost=ManaCost.parse(\"{1}{B}\"))\n415\t        opp_spell.owner = p2\n416\t        target_stack_obj = _push_spell(game, p2, opp_spell)\n417\t\n418\t        counterspell = ManaSculpt(owner=p1, controller=p1)\n419\t        counterspell.chosen_targets = [target_stack_obj]\n420\t        counterspell.on_resolve(game)\n421\t\n422\t        # Fire first main-phase event.\n423\t        game.trigger_manager.fire_event(\n424\t            game, BeginningOfMainPhaseTriggeredEvent(player=p1)\n425\t        )\n426\t        while not game.stack.is_empty():\n427\t            obj = game.stack.pop()\n428\t            obj.on_resolve(game)\n429\t\n430\t        mana_after_first = p1.mana_pool.get(ManaType.COLORLESS)\n431\t\n432\t        # Fire second main-phase event — trigger should not fire again.\n433\t        game.trigger_manager.fire_event(\n434\t            game, BeginningOfMainPhaseTriggeredEvent(player=p1)\n435\t        )\n436\t        while not game.stack.is_empty():\n437\t            obj = game.stack.pop()\n438\t            obj.on_resolve(game)\n439\t\n440\t        mana_after_second = p1.mana_pool.get(ManaType.COLORLESS)\n441\t        # Mana should not have increased on the second firing.\n442\t        assert mana_after_second == mana_after_first\n443\t"}]},"parent_tool_use_id":"toolu_01HHrusMb65YDLKTUU3AyBr2","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"64bc3d5d-e8a6-4cd9-b2c2-a361a7280c84","timestamp":"2026-05-28T00:31:31.594Z","subagent_type":"Reviewer","task_description":"Reviewer for sos_57"}
