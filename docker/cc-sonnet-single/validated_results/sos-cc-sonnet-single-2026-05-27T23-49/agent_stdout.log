{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Je8TitbC1voqZecMsHKrf6","type":"tool_result","content":"1\t\"\"\"Card implementation for Essence Scatter.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\tfrom typing import TYPE_CHECKING, Any\n5\tfrom engine.card import Instant, Sorcery\n6\tfrom engine.continuous_effects import (\n7\t    ContinuousEffect,\n8\t    DURATION_END_OF_TURN,\n9\t    Layer,\n10\t    SubLayer,\n11\t)\n12\tfrom engine.types import CardType, Keyword, ManaCost, TargetRequirement, Zone\n13\tif TYPE_CHECKING:\n14\t    from engine.game_state import GameState\n15\t\n16\t    from cards.registry import CardRegistry\n17\t\n18\tdef _get_chosen_target(card: Any, game: Any) -> Any:\n19\t    \"\"\"Retrieve the first chosen target for a spell.\n20\t\n21\t    Looks for ``chosen_targets`` (set by :func:`cast_spell` during the\n22\t    real casting pipeline) first, then falls back to the test-backdoor\n23\t    attribute ``_resolve_target``.\n24\t    \"\"\"\n25\t    chosen = getattr(card, \"chosen_targets\", None)\n26\t    if chosen:\n27\t        return chosen[0]\n28\t    return getattr(card, \"_resolve_target\", None)\n29\tdef _counter_spell(game: GameState, stack_obj: Any) -> None:\n30\t    \"\"\"Counter a spell — remove it from the stack and move the card to\n31\t    its owner's graveyard.\n32\t    \"\"\"\n33\t    from engine.stack import StackObject\n34\t\n35\t    if not isinstance(stack_obj, StackObject):\n36\t        return\n37\t\n38\t    card = stack_obj.source\n39\t\n40\t    # Check if the stack object is actually on the stack; if not, fizzle.\n41\t    stack_items = game.stack._items  # noqa: SLF001\n42\t    found = False\n43\t    for i, item in enumerate(stack_items):\n44\t        if item is stack_obj:\n45\t            stack_items.pop(i)\n46\t            found = True\n47\t            break\n48\t\n49\t    if not found:\n50\t        return\n51\t\n52\t    controller = stack_obj.controller\n53\t    owner = getattr(card, \"owner\", controller)\n54\t\n55\t    if controller is not None:\n56\t        stack_zone = controller.zones[Zone.STACK]\n57\t        if stack_zone.contains(card):\n58\t            stack_zone.remove(card)\n59\t\n60\t    if owner is not None:\n61\t        graveyard = owner.zones[Zone.GRAVEYARD]\n62\t        graveyard.add(card)\n63\t\n64\tclass EssenceScatter(Instant):\n65\t    \"\"\"Essence Scatter — {1}{U} — Counter target creature spell.\n66\t\n67\t    FDN collector number 153.\n68\t    \"\"\"\n69\t\n70\t    def __init__(self, **kwargs: Any) -> None:\n71\t        kwargs.setdefault(\"name\", \"Essence Scatter\")\n72\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{U}\"))\n73\t        kwargs.setdefault(\"rules_text\", \"Counter target creature spell.\")\n74\t        super().__init__(**kwargs)\n75\t\n76\t    def can_cast(self, game: GameState) -> bool:\n77\t        \"\"\"Cannot cast unless a creature spell is on the stack.\"\"\"\n78\t        for stack_obj in game.stack.objects():\n79\t            source = stack_obj.source\n80\t            if source is self:\n81\t                continue\n82\t            card_types = getattr(source, \"card_types\", set())\n83\t            if CardType.CREATURE in card_types:\n84\t                return True\n85\t        return False\n86\t\n87\t    def get_targets(self, game: GameState) -> list[Any]:\n88\t        \"\"\"Target creature spell on the stack.\"\"\"\n89\t        targets: list[Any] = []\n90\t        for stack_obj in game.stack.objects():\n91\t            source = stack_obj.source\n92\t            if source is self:\n93\t                continue\n94\t            card_types = getattr(source, \"card_types\", set())\n95\t            if CardType.CREATURE in card_types:\n96\t                targets.append(stack_obj)\n97\t        if not targets:\n98\t            return []\n99\t        return [\n100\t            TargetRequirement(\n101\t                filter_fn=lambda obj: CardType.CREATURE in getattr(getattr(obj, \"source\", obj), \"card_types\", set()),\n102\t                description=\"target creature spell\",\n103\t                zone=Zone.STACK,\n104\t            )\n105\t        ]\n106\t\n107\t    def on_resolve(self, game: GameState) -> None:\n108\t        \"\"\"Counter the target creature spell.\"\"\"\n109\t        target = _get_chosen_target(self, game)\n110\t        if target is None:\n111\t            return\n112\t        _counter_spell(game, target)\n113\t"}]},"parent_tool_use_id":"toolu_01CBr3rFfMgJhEkfiQQT64Ak","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"0131397f-0350-421d-94af-0e744a05111d","timestamp":"2026-05-28T00:28:47.466Z","subagent_type":"Implementer","task_description":"Implementer for sos_57"}
