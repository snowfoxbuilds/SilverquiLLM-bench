{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Jmq16gPhHdh2DRWbSWfwAG","type":"tool_result","content":"50\t        kwargs.setdefault(\"base_toughness\", 5)\n51\t        kwargs.setdefault(\"supertypes\", set())\n52\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.LEGENDARY}\n53\t        kwargs.setdefault(\"subtypes\", set())\n54\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Elder\", \"Dragon\"}\n55\t        kwargs.setdefault(\"keywords\", Keyword(0))\n56\t        kwargs[\"keywords\"] = kwargs[\"keywords\"] | Keyword.FLYING | Keyword.HASTE\n57\t        kwargs.setdefault(\n58\t            \"rules_text\",\n59\t            \"Flying, haste\\n\"\n60\t            \"Each instant and sorcery card in your hand has miracle {2}.\\n\"\n61\t            \"At the beginning of each opponent's upkeep, you may discard a card. \"\n62\t            \"If you do, draw a card.\",\n63\t        )\n64\t        super().__init__(**kwargs)\n65\t        # Storage for the original ZoneContainer.add so we can restore it.\n66\t        self._original_hand_add: Any = None\n67\t        self._hooked_hand_zone: Any = None  # reference to the patched zone\n68\t\n69\t    # ------------------------------------------------------------------\n70\t    # Miracle granting — hook the controller's hand zone\n71\t    # ------------------------------------------------------------------\n72\t\n73\t    def _apply_miracle_hook(self, game: \"GameState\") -> None:\n74\t        \"\"\"Install a hook on the controller's HAND zone that tags instants and\n75\t        sorceries with miracle_cost = {2} when they enter the zone.\n76\t\n77\t        Also immediately tags all existing instants/sorceries in the hand.\n78\t        \"\"\"\n79\t        controller = getattr(self, \"controller\", None)\n80\t        if controller is None:\n81\t            return\n82\t        hand = controller.zones[Zone.HAND]\n83\t\n84\t        # Tag cards already in hand.\n85\t        for card in hand.get_all():\n86\t            if _is_instant_or_sorcery(card):\n87\t                card.miracle_cost = _MIRACLE_COST\n88\t\n89\t        # Patch the add method to tag future additions.\n90\t        # Guard against double-patching.\n91\t        if self._hooked_hand_zone is hand:\n92\t            return\n93\t\n94\t        source = self  # capture for closure\n95\t\n96\t        original_add = hand.add\n97\t\n98\t        def _patched_add(obj: Any, position: str = \"top\") -> None:\n99\t            original_add(obj, position)\n100\t            # Only grant miracle while Lorehold is still on the battlefield.\n101\t            # source._hooked_hand_zone is set to None by _remove_miracle_hook()\n102\t            # when Lorehold leaves, so this acts as a battlefield-presence guard.\n103\t            if source._hooked_hand_zone is not None and _is_instant_or_sorcery(obj):\n104\t                obj.miracle_cost = _MIRACLE_COST\n105\t\n106\t        hand.add = _patched_add  # type: ignore[method-assign]\n107\t        self._original_hand_add = original_add\n108\t        self._hooked_hand_zone = hand\n109\t\n110\t    def _remove_miracle_hook(self) -> None:\n111\t        \"\"\"Restore the original add method on the hand zone (cleanup).\"\"\"\n112\t        if self._hooked_hand_zone is not None and self._original_hand_add is not None:\n113\t            self._hooked_hand_zone.add = self._original_hand_add  # type: ignore[method-assign]\n114\t        self._hooked_hand_zone = None\n115\t        self._original_hand_add = None\n116\t\n117\t    # ------------------------------------------------------------------\n118\t    # Trigger registration\n119\t    # ------------------------------------------------------------------\n120\t\n121\t    def register_triggers(self, game: \"GameState\") -> None:\n122\t        \"\"\"Register the opponent-upkeep loot trigger and miracle-grant hook.\"\"\"\n123\t        from engine.game import draw_card, discard as engine_discard\n124\t\n125\t        source = self\n126\t        controller = getattr(self, \"controller\", None)\n127\t        if controller is None:\n128\t            controller = game.active_player\n129\t\n130\t        # --- Miracle granting ---\n131\t        self._apply_miracle_hook(game)\n132\t\n133\t        # --- Upkeep loot trigger ---\n134\t        def _condition(g: \"GameState\", event: Any) -> bool:\n135\t            ctrl = getattr(source, \"controller\", None)\n136\t            if ctrl is None:\n137\t                return False\n138\t            # Fires on opponent's upkeep — active player is NOT the controller.\n139\t            return g.active_player is not ctrl\n140\t\n141\t        def _effect(g: \"GameState\") -> None:\n142\t            ctrl = getattr(source, \"controller\", None)\n143\t            if ctrl is None:\n144\t                return\n145\t            # Ask controller if they want to discard\n146\t            try:\n147\t                wants_discard = ctrl.choose_yes_no(\n148\t                    \"Discard a card? (Lorehold, the Historian)\"\n149\t                )"}]},"parent_tool_use_id":"toolu_012s7dMnBNeeuBuVB5j2ytoq","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"d7110bd2-85aa-470c-93d0-cd4ea8cd7a6d","timestamp":"2026-05-28T01:32:30.856Z","subagent_type":"Reviewer","task_description":"Reviewer for sos_245"}
