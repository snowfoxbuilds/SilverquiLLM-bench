{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E1o3qfdK5j58Y99ZkDheFy","type":"tool_result","content":"1\t\"\"\"Tests for SOS 201 — Lorehold, the Historian.\n2\t\n3\tRequirements under test:\n4\t1. Static card properties (name, mana cost, type, P/T, supertypes, subtypes).\n5\t2. Keywords: Flying and Haste.\n6\t3. Upkeep trigger: fires at the beginning of each opponent's upkeep.\n7\t4. Upkeep trigger: optional discard — if player says yes, a card is discarded.\n8\t5. Upkeep trigger: if discard happened, draw a card.\n9\t6. Upkeep trigger: if player says no, no discard and no draw.\n10\t7. Upkeep trigger: fires on opponent's upkeep, NOT controller's own upkeep.\n11\t8. Miracle granting: each instant and sorcery in controller's hand gains miracle {2}.\n12\t9. Miracle cost: the granted miracle cost is exactly {2}.\n13\t10. Miracle granting: non-instant/sorcery cards in hand are NOT given miracle.\n14\t\"\"\"\n15\t\n16\tfrom __future__ import annotations\n17\t\n18\timport pytest\n19\t\n20\tfrom cards.sos.sos_201.card_impl import LoreholdTheHistorian\n21\tfrom engine.card import Creature, Instant, Sorcery\n22\tfrom engine.events import BeginningOfUpkeepTriggeredEvent\n23\tfrom engine.triggers import TriggerRegistration\n24\tfrom engine.types import CardType, Keyword, ManaCost, ManaType, Supertype, Zone\n25\tfrom test_utils import create_game, set_board_state\n26\t\n27\t\n28\t# ---------------------------------------------------------------------------\n29\t# Static card properties\n30\t# ---------------------------------------------------------------------------\n31\t\n32\tclass TestLoreholdStaticProperties:\n33\t    \"\"\"Lorehold, the Historian must match the card spec exactly.\"\"\"\n34\t\n35\t    def test_name(self) -> None:\n36\t        card = LoreholdTheHistorian(owner=None)\n37\t        assert card.name == \"Lorehold, the Historian\"\n38\t\n39\t    def test_mana_cost(self) -> None:\n40\t        card = LoreholdTheHistorian(owner=None)\n41\t        assert card.mana_cost == ManaCost.parse(\"{3}{R}{W}\")\n42\t\n43\t    def test_is_creature(self) -> None:\n44\t        card = LoreholdTheHistorian(owner=None)\n45\t        assert isinstance(card, Creature)\n46\t        assert CardType.CREATURE in card.card_types\n47\t\n48\t    def test_is_legendary(self) -> None:\n49\t        card = LoreholdTheHistorian(owner=None)\n50\t        assert Supertype.LEGENDARY in card.supertypes\n51\t\n52\t    def test_subtypes_include_elder_dragon(self) -> None:\n53\t        card = LoreholdTheHistorian(owner=None)\n54\t        assert \"Elder\" in card.subtypes or \"Dragon\" in card.subtypes or (\n55\t            \"Elder Dragon\" in \" \".join(card.subtypes) or\n56\t            {\"Elder\", \"Dragon\"} <= card.subtypes\n57\t        )\n58\t\n59\t    def test_power_is_5(self) -> None:\n60\t        card = LoreholdTheHistorian(owner=None)\n61\t        assert card.base_power == 5\n62\t\n63\t    def test_toughness_is_5(self) -> None:\n64\t        card = LoreholdTheHistorian(owner=None)\n65\t        assert card.base_toughness == 5\n66\t\n67\t\n68\t# ---------------------------------------------------------------------------\n69\t# Keywords\n70\t# ---------------------------------------------------------------------------\n71\t\n72\tclass TestLoreholdKeywords:\n73\t    \"\"\"Flying and Haste are both required.\"\"\"\n74\t\n75\t    def test_has_flying(self) -> None:\n76\t        card = LoreholdTheHistorian(owner=None)\n77\t        assert Keyword.FLYING in card.keywords\n78\t\n79\t    def test_has_haste(self) -> None:\n80\t        card = LoreholdTheHistorian(owner=None)\n81\t        assert Keyword.HASTE in card.keywords\n82\t\n83\t\n84\t# ---------------------------------------------------------------------------\n85\t# Upkeep trigger registration\n86\t# ---------------------------------------------------------------------------\n87\t\n88\tclass TestLoreholdUpkeepTriggerRegistration:\n89\t    \"\"\"register_triggers must wire a BeginningOfUpkeepTriggeredEvent trigger.\"\"\"\n90\t\n91\t    def test_registers_at_least_one_trigger(self) -> None:\n92\t        game = create_game()\n93\t        p1 = game.players[0]\n94\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n95\t        before = len(game.trigger_manager.get_triggers())\n96\t        card.register_triggers(game)\n97\t        after = len(game.trigger_manager.get_triggers())\n98\t        assert after > before\n99\t\n100\t    def test_registers_upkeep_trigger_type(self) -> None:\n101\t        game = create_game()\n102\t        p1 = game.players[0]\n103\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n104\t        card.register_triggers(game)\n105\t        upkeep_triggers = [\n106\t            t for t in game.trigger_manager.get_triggers()\n107\t            if t.source is card and t.event_type is BeginningOfUpkeepTriggeredEvent\n108\t        ]\n109\t        assert len(upkeep_triggers) >= 1\n110\t\n111\t    def test_unregister_removes_triggers(self) -> None:\n112\t        game = create_game()\n113\t        p1 = game.players[0]\n114\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n115\t        card.register_triggers(game)\n116\t        count_before = len(game.trigger_manager.get_triggers_for_source(card))\n117\t        assert count_before > 0\n118\t        game.trigger_manager.unregister(card)\n119\t        assert len(game.trigger_manager.get_triggers_for_source(card)) == 0\n120\t\n121\t\n122\t# ---------------------------------------------------------------------------\n123\t# Upkeep trigger — fires only on opponent's upkeep\n124\t# ---------------------------------------------------------------------------\n125\t\n126\tclass TestLoreholdUpkeepTriggerCondition:\n127\t    \"\"\"The trigger should fire on opponent's upkeep, not controller's upkeep.\"\"\"\n128\t\n129\t    def test_trigger_fires_on_opponent_upkeep(self) -> None:\n130\t        \"\"\"When an upkeep event fires and the active player is the opponent,\n131\t        the trigger should be placed on the stack.\"\"\"\n132\t        game = create_game()\n133\t        p1 = game.players[0]   # controller of Lorehold\n134\t        p2 = game.players[1]   # opponent\n135\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n136\t        card.register_triggers(game)\n137\t\n138\t        # Simulate opponent's upkeep — active player is p2\n139\t        game.active_player_index = 1\n140\t        before_stack = len(game.stack.objects())\n141\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n142\t        after_stack = len(game.stack.objects())\n143\t        assert after_stack > before_stack, (\n144\t            \"Upkeep trigger should fire on opponent's upkeep\"\n145\t        )\n146\t\n147\t    def test_trigger_does_not_fire_on_controller_upkeep(self) -> None:\n148\t        \"\"\"When active player is the controller (p1), the trigger must NOT fire.\n149\t\n150\t        We first verify that the trigger fires on the opponent's upkeep (showing\n151\t        the trigger IS registered), then verify it does NOT fire when controller\n152\t        is the active player.\n153\t        \"\"\"\n154\t        game = create_game()\n155\t        p1 = game.players[0]   # controller of Lorehold\n156\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n157\t        card.register_triggers(game)\n158\t\n159\t        # First verify at least one trigger is registered (precondition)\n160\t        assert len(game.trigger_manager.get_triggers_for_source(card)) > 0, (\n161\t            \"Prerequisite: trigger must be registered before testing condition\"\n162\t        )\n163\t\n164\t        # Active player is p1 (the controller) — this is p1's own upkeep\n165\t        game.active_player_index = 0\n166\t        before_stack = len(game.stack.objects())\n167\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n168\t        after_stack = len(game.stack.objects())\n169\t        assert after_stack == before_stack, (\n170\t            \"Upkeep trigger must NOT fire on controller's own upkeep\"\n171\t        )\n172\t\n173\t\n174\t# ---------------------------------------------------------------------------\n175\t# Upkeep trigger effect — discard/draw loot\n176\t# ---------------------------------------------------------------------------\n177\t\n178\tclass TestLoreholdUpkeepTriggerEffect:\n179\t    \"\"\"When the trigger resolves: optional discard + conditional draw.\"\"\"\n180\t\n181\t    def _setup_with_hand_card(self, game, player_idx: int):\n182\t        \"\"\"Put a card in p1's hand so they have something to discard.\"\"\"\n183\t        dummy = Instant(name=\"Dummy\", mana_cost=ManaCost.parse(\"{1}\"))\n184\t        hand = game.players[player_idx].zones[Zone.HAND]\n185\t        hand.add(dummy)\n186\t        return dummy\n187\t\n188\t    def _setup_library_card(self, game, player_idx: int):\n189\t        \"\"\"Put a card in p1's library so draw has something to get.\"\"\"\n190\t        top_card = Sorcery(name=\"Library Top\", mana_cost=ManaCost.parse(\"{1}\"))\n191\t        library = game.players[player_idx].zones[Zone.LIBRARY]\n192\t        library.add(top_card)\n193\t        return top_card\n194\t\n195\t    def test_discard_yes_removes_card_from_hand(self) -> None:\n196\t        \"\"\"Choosing yes: the discarded card moves from hand to graveyard.\"\"\"\n197\t        game = create_game()\n198\t        p1 = game.players[0]\n199\t        dummy = self._setup_with_hand_card(game, 0)\n200\t        self._setup_library_card(game, 0)\n201\t\n202\t        # Simulate opponent's upkeep\n203\t        game.active_player_index = 1\n204\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n205\t        card.register_triggers(game)\n206\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n207\t\n208\t        # Resolve the trigger from the stack\n209\t        assert not game.stack.is_empty()\n210\t        stack_obj = game.stack.pop()\n211\t\n212\t        # Script p1 to say \"yes\" and pick dummy to discard\n213\t        from engine.player import DeterministicPlayer\n214\t        p1._script.appendleft(dummy)   # choose_card for the discard\n215\t        p1._script.appendleft(True)    # choose_yes_no → yes\n216\t\n217\t        stack_obj.on_resolve(game)\n218\t\n219\t        graveyard = game.get_graveyard(p1)\n220\t        hand = game.get_hand(p1)\n221\t        assert graveyard.contains(dummy), \"Discarded card should be in graveyard\"\n222\t        assert not hand.contains(dummy), \"Discarded card should not remain in hand\"\n223\t\n224\t    def test_discard_yes_draws_a_card(self) -> None:\n225\t        \"\"\"Choosing yes to discard: controller draws exactly one card.\"\"\"\n226\t        game = create_game()\n227\t        p1 = game.players[0]\n228\t        self._setup_with_hand_card(game, 0)\n229\t        drawn_card = self._setup_library_card(game, 0)\n230\t\n231\t        game.active_player_index = 1\n232\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n233\t        card.register_triggers(game)\n234\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n235\t\n236\t        assert not game.stack.is_empty()\n237\t        stack_obj = game.stack.pop()\n238\t\n239\t        hand_before = list(game.get_hand(p1).get_all())\n240\t        # Script yes + the discard choice\n241\t        dummy = [c for c in game.get_hand(p1).get_all()][0]\n242\t        p1._script.appendleft(dummy)\n243\t        p1._script.appendleft(True)\n244\t\n245\t        stack_obj.on_resolve(game)\n246\t\n247\t        hand_after = game.get_hand(p1).get_all()\n248\t        # Hand loses dummy (discarded), gains drawn_card — net size change is 0\n249\t        # but drawn_card must be present\n250\t        assert drawn_card in hand_after, \"Draw should put the library-top card in hand\"\n251\t\n252\t    def test_discard_no_does_not_discard_or_draw(self) -> None:\n253\t        \"\"\"Choosing no: hand and library remain unchanged.\"\"\"\n254\t        game = create_game()\n255\t        p1 = game.players[0]\n256\t        dummy = self._setup_with_hand_card(game, 0)\n257\t        self._setup_library_card(game, 0)\n258\t\n259\t        game.active_player_index = 1\n260\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n261\t        card.register_triggers(game)\n262\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n263\t\n264\t        assert not game.stack.is_empty()\n265\t        stack_obj = game.stack.pop()\n266\t\n267\t        hand_size_before = len(game.get_hand(p1).get_all())\n268\t        library_size_before = len(game.players[0].zones[Zone.LIBRARY].get_all())\n269\t\n270\t        # Script no\n271\t        p1._script.appendleft(False)  # choose_yes_no → no\n272\t\n273\t        stack_obj.on_resolve(game)\n274\t\n275\t        hand_size_after = len(game.get_hand(p1).get_all())\n276\t        library_size_after = len(game.players[0].zones[Zone.LIBRARY].get_all())\n277\t        assert hand_size_after == hand_size_before, \"No discard → hand unchanged\"\n278\t        assert library_size_after == library_size_before, \"No discard → no draw → library unchanged\"\n279\t\n280\t    def test_discard_yes_empty_hand_skips_draw(self) -> None:\n281\t        \"\"\"If controller has no cards to discard, no discard occurs and no draw either.\"\"\"\n282\t        game = create_game()\n283\t        p1 = game.players[0]\n284\t        # p1 has an empty hand — nothing to discard\n285\t        self._setup_library_card(game, 0)\n286\t\n287\t        game.active_player_index = 1\n288\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n289\t        card.register_triggers(game)\n290\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n291\t\n292\t        if game.stack.is_empty():\n293\t            return  # trigger may not fire if no valid discardable card\n294\t\n295\t        stack_obj = game.stack.pop()\n296\t        # Even if player says yes, with no cards in hand nothing should crash\n297\t        p1._script.appendleft(True)  # choose_yes_no → yes (no cards to choose)\n298\t        try:\n299\t            stack_obj.on_resolve(game)\n300\t        except Exception:\n301\t            pass  # Any no-op or graceful exit is acceptable here\n302\t        # Post-condition: game is still in a valid state\n303\t        assert not game.is_game_over\n304\t\n305\t\n306\t# ---------------------------------------------------------------------------\n307\t# Miracle — granting miracle {2} to instants and sorceries in hand\n308\t# ---------------------------------------------------------------------------\n309\t\n310\tclass TestLoreholdMiracleGrant:\n311\t    \"\"\"Lorehold grants miracle {2} to each instant/sorcery in controller's hand.\"\"\"\n312\t\n313\t    def test_instant_in_hand_has_miracle_cost_attribute(self) -> None:\n314\t        \"\"\"An instant in the controller's hand should gain a miracle cost of {2}.\"\"\"\n315\t        game = create_game()\n316\t        p1 = game.players[0]\n317\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n318\t        game.get_battlefield(p1).add(lorehold)\n319\t        lorehold.register_triggers(game)\n320\t\n321\t        instant = Instant(name=\"Test Instant\", mana_cost=ManaCost.parse(\"{3}{R}\"))\n322\t        instant.owner = p1\n323\t        instant.controller = p1\n324\t        game.get_hand(p1).add(instant)\n325\t\n326\t        # The card should now have a miracle cost of {2} detectable on the card object\n327\t        miracle_cost = getattr(instant, \"miracle_cost\", None)\n328\t        assert miracle_cost is not None, (\n329\t            \"Instant in hand should have miracle_cost set by Lorehold\"\n330\t        )\n331\t        assert miracle_cost == ManaCost.parse(\"{2}\"), (\n332\t            f\"Miracle cost should be {{2}}, got {miracle_cost}\"\n333\t        )\n334\t\n335\t    def test_sorcery_in_hand_has_miracle_cost_attribute(self) -> None:\n336\t        \"\"\"A sorcery in the controller's hand should gain a miracle cost of {2}.\"\"\"\n337\t        game = create_game()\n338\t        p1 = game.players[0]\n339\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n340\t        game.get_battlefield(p1).add(lorehold)\n341\t        lorehold.register_triggers(game)\n342\t\n343\t        sorc = Sorcery(name=\"Test Sorcery\", mana_cost=ManaCost.parse(\"{5}{W}\"))\n344\t        sorc.owner = p1\n345\t        sorc.controller = p1\n346\t        game.get_hand(p1).add(sorc)\n347\t\n348\t        miracle_cost = getattr(sorc, \"miracle_cost\", None)\n349\t        assert miracle_cost is not None, (\n350\t            \"Sorcery in hand should have miracle_cost set by Lorehold\"\n351\t        )\n352\t        assert miracle_cost == ManaCost.parse(\"{2}\"), (\n353\t            f\"Miracle cost should be {{2}}, got {miracle_cost}\"\n354\t        )\n355\t\n356\t    def test_creature_in_hand_does_not_get_miracle(self) -> None:\n357\t        \"\"\"Non-instant/sorcery cards (creatures, etc.) must NOT gain miracle.\"\"\"\n358\t        game = create_game()\n359\t        p1 = game.players[0]\n360\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n361\t        game.get_battlefield(p1).add(lorehold)\n362\t        lorehold.register_triggers(game)\n363\t\n364\t        creature = Creature(\n365\t            name=\"Test Bear\", base_power=2, base_toughness=2,\n366\t            mana_cost=ManaCost.parse(\"{1}{G}\"),\n367\t            owner=p1, controller=p1,\n368\t        )\n369\t        game.get_hand(p1).add(creature)\n370\t\n371\t        miracle_cost = getattr(creature, \"miracle_cost\", None)\n372\t        # Either None (never set) or not the {2} miracle — creatures must not have it\n373\t        # from Lorehold\n374\t        assert miracle_cost is None or not (\n375\t            miracle_cost == ManaCost.parse(\"{2}\")\n376\t        ), \"Creature must NOT receive miracle from Lorehold\"\n377\t\n378\t    def test_miracle_cost_is_exactly_two_generic(self) -> None:\n379\t        \"\"\"The miracle cost granted is exactly {2} (two generic mana).\"\"\"\n380\t        game = create_game()\n381\t        p1 = game.players[0]\n382\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n383\t        game.get_battlefield(p1).add(lorehold)\n384\t        lorehold.register_triggers(game)\n385\t\n386\t        instant = Instant(name=\"Fancy Bolt\", mana_cost=ManaCost.parse(\"{2}{R}{R}\"))\n387\t        instant.owner = p1\n388\t        instant.controller = p1\n389\t        game.get_hand(p1).add(instant)\n390\t\n391\t        miracle_cost = getattr(instant, \"miracle_cost\", None)\n392\t        assert miracle_cost is not None\n393\t        expected = ManaCost.parse(\"{2}\")\n394\t        assert miracle_cost == expected, f\"Expected {{2}}, got {miracle_cost}\"\n395\t"}]},"parent_tool_use_id":"toolu_01DescKLr458SyfoTkUSzTT3","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"52ae95bc-dc97-42c2-8c17-c3be72916dca","timestamp":"2026-05-28T01:03:42.486Z","subagent_type":"Implementer","task_description":"Implementer for sos_201"}
