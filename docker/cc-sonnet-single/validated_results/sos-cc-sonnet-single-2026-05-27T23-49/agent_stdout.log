\n115\t        }\n116\t      ],\n117\t      \"implementation\": [\n118\t        {\n119\t          \"path\": \"cards/sos/sos_4/card_impl.py\",\n120\t          \"summary\": \"TogetherAsOne Sorcery with colors_spent converge attribute, get_targets returning two requirements, on_resolve applying draw/damage/life-gain for X = colors_spent\"\n121\t        }\n122\t      ]\n123\t    },\n124\t    {\n125\t      \"card\": \"sos_57\",\n126\t      \"tests\": [\n127\t        {\n128\t          \"path\": \"/workspace/cards/sos/sos_57/tests.py\",\n129\t          \"summary\": \"tests for sos_57 Mana Sculpt — static properties, targeting API, counterspell mechanics, Wizard check, BeginningOfMainPhaseTriggeredEvent one-shot mana scheduling\"\n130\t        }\n131\t      ],\n132\t      \"implementation\": [\n133\t        {\n134\t          \"path\": \"cards/sos/sos_57/card_impl.py\",\n135\t          \"summary\": \"ManaSculpt Instant — counters target spell, schedules colorless mana (mana_spent if available, else CMC) at next main phase (pre- or postcombat) if controller has a Wizard\"\n136\t        },\n137\t        {\n138\t          \"path\": \"engine/events.py\",\n139\t          \"summary\": \"Added BeginningOfMainPhaseTriggeredEvent with player attribute\"\n140\t        },\n141\t        {\n142\t          \"path\": \"engine/turn.py\",\n143\t          \"summary\": \"Fire BeginningOfMainPhaseTriggeredEvent at both PRECOMBAT_MAIN and POSTCOMBAT_MAIN phase starts\"\n144\t        }\n145\t      ]\n146\t    },\n147\t    {\n148\t      \"card\": \"sos_97\",\n149\t      \"tests\": [\n150\t        {\n151\t          \"path\": \"/workspace/cards/sos/sos_97/tests.py\",\n152\t          \"summary\": \"tests for sos_97 Ral Zarek Guest Lecturer — static properties, loyalty abilities, surveil 2, discard any players, return creature from controller's graveyard only, coin-flip turn-skip ultimate using target_opponent\"\n153\t        }\n154\t      ],\n155\t      \"implementation\": [\n156\t        {\n157\t   