{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JUQ7GtqFJJeKSkwKoPXz6k","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_201/card_impl.py b/cards/sos/sos_201/card_impl.py\n2\tindex 7b52d28..805d71c 100644\n3\t--- a/cards/sos/sos_201/card_impl.py\n4\t+++ b/cards/sos/sos_201/card_impl.py\n5\t@@ -1,16 +1,183 @@\n6\t-\"\"\"Card implementation for Lorehold, the Historian.\"\"\"\n7\t+\"\"\"Card implementation for Lorehold, the Historian (SOS 201).\n8\t+\n9\t+Lorehold, the Historian — {3}{R}{W} — Legendary Creature — Elder Dragon — 5/5\n10\t+\n11\t+Flying, haste\n12\t+Each instant and sorcery card in your hand has miracle {2}.\n13\t+(You may cast a card for its miracle cost when you draw it if it's the\n14\t+first card you drew this turn.)\n15\t+At the beginning of each opponent's upkeep, you may discard a card.\n16\t+If you do, draw a card.\n17\t+\n18\t+SOS collector number 201.\n19\t+\"\"\"\n20\t \n21\t from __future__ import annotations\n22\t \n23\t-from engine.card import CardImpl\n24\t+from typing import TYPE_CHECKING, Any\n25\t \n26\t-from typing import TYPE_CHECKING\n27\t+from engine.card import Creature\n28\t+from engine.events import BeginningOfUpkeepTriggeredEvent\n29\t+from engine.triggers import TriggerRegistration\n30\t+from engine.types import CardType, Keyword, ManaCost, Supertype, Zone\n31\t \n32\t if TYPE_CHECKING:\n33\t     from engine.game_state import GameState\n34\t \n35\t \n36\t-class LoreholdTheHistorian(CardImpl):\n37\t-    \"\"\"TODO: Implement Lorehold, the Historian.\"\"\"\n38\t+_MIRACLE_COST = ManaCost.parse(\"{2}\")\n39\t+\n40\t+\n41\t+def _is_instant_or_sorcery(card: Any) -> bool:\n42\t+    \"\"\"Return True if *card* is an instant or sorcery.\"\"\"\n43\t+    card_types = getattr(card, \"card_types\", set())\n44\t+    return CardType.INSTANT in card_types or CardType.SORCERY in card_types\n45\t+\n46\t+\n47\t+class LoreholdTheHistorian(Creature):\n48\t+    \"\"\"Lorehold, the Historian — {3}{R}{W} — Legendary Creature — Elder Dragon — 5/5.\n49\t+\n50\t+    Flying, haste\n51\t+    Each instant and sorcery card in your hand has miracle {2}.\n52\t+    At the beginning of each opponent's upkeep, you may discard a card.\n53\t+    If you do, draw a card.\n54\t+    \"\"\"\n55\t+\n56\t+    def __init__(self, **kwargs: Any) -> None:\n57\t+        kwargs.setdefault(\"name\", \"Lorehold, the Historian\")\n58\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{3}{R}{W}\"))\n59\t+        kwargs.setdefault(\"base_power\", 5)\n60\t+        kwargs.setdefault(\"base_toughness\", 5)\n61\t+        kwargs.setdefault(\"supertypes\", set())\n62\t+        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.LEGENDARY}\n63\t+        kwargs.setdefault(\"subtypes\", set())\n64\t+        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Elder\", \"Dragon\"}\n65\t+        kwargs.setdefault(\"keywords\", Keyword(0))\n66\t+        kwargs[\"keywords\"] = kwargs[\"keywords\"] | Keyword.FLYING | Keyword.HASTE\n67\t+        kwargs.setdefault(\n68\t+            \"rules_text\",\n69\t+            \"Flying, haste\\n\"\n70\t+            \"Each instant and sorcery card in your hand has miracle {2}.\\n\"\n71\t+            \"At the beginning of each opponent's upkeep, you may discard a card. \"\n72\t+            \"If you do, draw a card.\",\n73\t+        )\n74\t+        super().__init__(**kwargs)\n75\t+        # Storage for the original ZoneContainer.add so we can restore it.\n76\t+        self._original_hand_add: Any = None\n77\t+        self._hooked_hand_zone: Any = None  # reference to the patched zone\n78\t+\n79\t+    # ------------------------------------------------------------------\n80\t+    # Miracle granting — hook the controller's hand zone\n81\t+    # ------------------------------------------------------------------\n82\t+\n83\t+    def _apply_miracle_hook(self, game: \"GameState\") -> None:\n84\t+        \"\"\"Install a hook on the controller's HAND zone that tags instants and\n85\t+        sorceries with miracle_cost = {2} when they enter the zone.\n86\t+\n87\t+        Also immediately tags all existing instants/sorceries in the hand.\n88\t+        \"\"\"\n89\t+        controller = getattr(self, \"controller\", None)\n90\t+        if controller is None:\n91\t+            return\n92\t+        hand = controller.zones[Zone.HAND]\n93\t+\n94\t+        # Tag cards already in hand.\n95\t+        for card in hand.get_all():\n96\t+            if _is_instant_or_sorcery(card):\n97\t+                card.miracle_cost = _MIRACLE_COST\n98\t+\n99\t+        # Patch the add method to tag future additions.\n100\t+        # Guard against double-patching.\n101\t+        if self._hooked_hand_zone is hand:\n102\t+            return\n103\t+\n104\t+        source = self  # capture for closure\n105\t+\n106\t+        original_add = hand.add\n107\t+\n108\t+        def _patched_add(obj: Any, position: str = \"top\") -> None:\n109\t+            original_add(obj, position)\n110\t+            # If Lorehold is still on the battlefield (or at least registered),\n111\t+            # tag instants and sorceries.\n112\t+            if _is_instant_or_sorcery(obj):\n113\t+                obj.miracle_cost = _MIRACLE_COST\n114\t+\n115\t+        hand.add = _patched_add  # type: ignore[method-assign]\n116\t+        self._original_hand_add = original_add\n117\t+        self._hooked_hand_zone = hand\n118\t+\n119\t+    def _remove_miracle_hook(self) -> None:\n120\t+        \"\"\"Restore the original add method on the hand zone (cleanup).\"\"\"\n121\t+        if self._hooked_hand_zone is not None and self._original_hand_add is not None:\n122\t+            self._hooked_hand_zone.add = self._original_hand_add  # type: ignore[method-assign]\n123\t+        self._hooked_hand_zone = None\n124\t+        self._original_hand_add = None\n125\t+\n126\t+    # ------------------------------------------------------------------\n127\t+    # Trigger registration\n128\t+    # ------------------------------------------------------------------\n129\t+\n130\t+    def register_triggers(self, game: \"GameState\") -> None:\n131\t+        \"\"\"Register the opponent-upkeep loot trigger and miracle-grant hook.\"\"\"\n132\t+        from engine.game import draw_card, discard as engine_discard\n133\t+\n134\t+        source = self\n135\t+        controller = getattr(self, \"controller\", None)\n136\t+        if controller is None:\n137\t+            controller = game.active_player\n138\t+\n139\t+        # --- Miracle granting ---\n140\t+        self._apply_miracle_hook(game)\n141\t+\n142\t+        # --- Upkeep loot trigger ---\n143\t+        def _condition(g: \"GameState\", event: Any) -> bool:\n144\t+            ctrl = getattr(source, \"controller\", None)\n145\t+            if ctrl is None:\n146\t+                return False\n147\t+            # Fires on opponent's upkeep — active player is NOT the controller.\n148\t+            return g.active_player is not ctrl\n149\t+\n150\t+        def _effect(g: \"GameState\") -> None:\n151\t+            ctrl = getattr(source, \"controller\", None)\n152\t+            if ctrl is None:\n153\t+                return\n154\t+            # Ask controller if they want to discard\n155\t+            try:\n156\t+                wants_discard = ctrl.choose_yes_no(\n157\t+                    \"Discard a card? (Lorehold, the Historian)\"\n158\t+                )\n159\t+            except Exception:\n160\t+                wants_discard = True\n161\t+\n162\t+            if not wants_discard:\n163\t+                return\n164\t+\n165\t+            # Choose a card to discard from hand\n166\t+            hand = g.get_hand(ctrl)\n167\t+            cards_in_hand = hand.get_all()\n168\t+            if not cards_in_hand:\n169\t+                # No cards to discard — ability fizzles gracefully.\n170\t+                return\n171\t+\n172\t+            try:\n173\t+                chosen = ctrl.choose_card(\n174\t+                    cards_in_hand, \"Choose a card to discard (Lorehold)\"\n175\t+                )\n176\t+            except Exception:\n177\t+                chosen = cards_in_hand[0] if cards_in_hand else None\n178\t+\n179\t+            if chosen is None or not hand.contains(chosen):\n180\t+                return\n181\t+\n182\t+            engine_discard(g, ctrl, chosen)\n183\t+            draw_card(g, ctrl)\n184\t \n185\t-    pass\n186\t+        game.trigger_manager.register(\n187\t+            TriggerRegistration(\n188\t+                event_type=BeginningOfUpkeepTriggeredEvent,\n189\t+                condition=_condition,\n190\t+                effect=_effect,\n191\t+                source=self,\n192\t+                controller=controller,\n193\t+            )\n194\t+        )\n195\t"}]},"parent_tool_use_id":"toolu_01H8LN2dJbU21PkUPXkkGcET","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"1503a33b-3610-40e9-9251-75954ebd3671","timestamp":"2026-05-28T01:07:13.373Z","subagent_type":"Reviewer","task_description":"Reviewer for sos_201"}
