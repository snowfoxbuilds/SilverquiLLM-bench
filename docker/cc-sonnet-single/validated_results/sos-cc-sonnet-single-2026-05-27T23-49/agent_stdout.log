{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XAnxthq2cghzXz1iDHd3y1","type":"tool_result","content":"1\t\"\"\"Card implementation for Emeritus of Truce // Swords to Plowshares (SOS #13).\n2\t\n3\tEmeritus of Truce — {1}{W}{W} — 3/3 — Cat Cleric — Creature\n4\t\n5\tWhen this creature enters, target player creates a 1/1 white and black\n6\tInkling creature token with flying.  Then if an opponent controls more\n7\tcreatures than you, this creature becomes prepared.\n8\t\n9\tPrepared mechanic:\n10\t  While prepared, you may cast a copy of its spell (Swords to Plowshares).\n11\t  Doing so unprepares it.\n12\t\n13\tSwords to Plowshares — {W} — Instant\n14\t  Exile target creature. Its controller gains life equal to its power.\n15\t\"\"\"\n16\t\n17\tfrom __future__ import annotations\n18\t\n19\tfrom typing import TYPE_CHECKING, Any\n20\t\n21\tfrom engine.card import CardImpl, Creature, Instant\n22\tfrom engine.events import EntersBattlefieldTriggeredEvent\n23\tfrom engine.triggers import TriggerRegistration\n24\tfrom engine.types import CardType, Keyword, ManaCost, TargetRequirement, Zone\n25\t\n26\tif TYPE_CHECKING:\n27\t    from engine.game_state import GameState\n28\t\n29\t\n30\t# ---------------------------------------------------------------------------\n31\t# Swords to Plowshares — the spell side\n32\t# ---------------------------------------------------------------------------\n33\t\n34\tclass _SwordsToPlowshares(Instant):\n35\t    \"\"\"Swords to Plowshares — {W} — Instant.\n36\t\n37\t    Exile target creature. Its controller gains life equal to its power.\n38\t    This is the spell side of Emeritus of Truce.\n39\t    \"\"\"\n40\t\n41\t    def __init__(self, **kwargs: Any) -> None:\n42\t        kwargs.setdefault(\"name\", \"Swords to Plowshares\")\n43\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{W}\"))\n44\t        kwargs.setdefault(\n45\t            \"rules_text\",\n46\t            \"Exile target creature. Its controller gains life equal to its power.\",\n47\t        )\n48\t        super().__init__(**kwargs)\n49\t\n50\t\n51\t# ---------------------------------------------------------------------------\n52\t# Inkling token factory\n53\t# ---------------------------------------------------------------------------\n54\t\n55\tdef _make_inkling_token(owner: Any, controller: Any) -> Creature:\n56\t    \"\"\"Create a 1/1 white and black Inkling creature token with flying.\"\"\"\n57\t    token = Creature(\n58\t        name=\"Inkling\",\n59\t        mana_cost=ManaCost(),\n60\t        subtypes={\"Inkling\"},\n61\t        keywords=Keyword.FLYING,\n62\t        base_power=1,\n63\t        base_toughness=1,\n64\t        owner=owner,\n65\t        controller=controller,\n66\t    )\n67\t    token.is_token = True\n68\t    # Colors: white and black\n69\t    token.colors = {\"W\", \"B\"}\n70\t    return token\n71\t\n72\t\n73\t# ---------------------------------------------------------------------------\n74\t# Main card class\n75\t# ---------------------------------------------------------------------------\n76\t\n77\tclass EmeritusOfTruceSwordsToPlowshares(Creature):\n78\t    \"\"\"Emeritus of Truce // Swords to Plowshares — {1}{W}{W} — 3/3 — Cat Cleric.\n79\t\n80\t    ETB: target player creates a 1/1 white and black Inkling creature token\n81\t    with flying.  Then if an opponent controls more creatures than you, this\n82\t    creature becomes prepared.\n83\t\n84\t    Prepared: you may cast a copy of Swords to Plowshares (exile target\n85\t    creature; its controller gains life equal to its power).  Doing so\n86\t    unprepares this creature.\n87\t    \"\"\"\n88\t\n89\t    def __init__(self, **kwargs: Any) -> None:\n90\t        kwargs.setdefault(\"name\", \"Emeritus of Truce // Swords to Plowshares\")\n91\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{W}{W}\"))\n92\t        kwargs.setdefault(\"subtypes\", {\"Cat\", \"Cleric\"})\n93\t        kwargs.setdefault(\"base_power\", 3)\n94\t        kwargs.setdefault(\"base_toughness\", 3)\n95\t        kwargs.setdefault(\n96\t            \"rules_text\",\n97\t            \"When this creature enters, target player creates a 1/1 white and \"\n98\t            \"black Inkling creature token with flying. Then if an opponent \"\n99\t            \"controls more creatures than you, this creature becomes prepared. \"\n100\t            \"(While it's prepared, you may cast a copy of its spell. Doing so \"\n101\t            \"unprepares it.)\",\n102\t        )\n103\t        super().__init__(**kwargs)\n104\t\n105\t        # Prepared state\n106\t        self.is_prepared: bool = False\n107\t\n108\t        # Spell side — Swords to Plowshares\n109\t        self.spell_side: _SwordsToPlowshares = _SwordsToPlowshares()\n110\t\n111\t    # ------------------------------------------------------------------\n112\t    # Targeting API\n113\t    # ------------------------------------------------------------------\n114\t\n115\t    def get_targets(self, game: \"GameState\") -> list[Any]:\n116\t        \"\"\"Return a targeting requirement: a player to receive the Inkling token.\"\"\"\n117\t        # The target is a player (any player)\n118\t        return [\n119\t            TargetRequirement(\n120\t                filter_fn=lambda obj: obj in game.players,\n121\t                description=\"target player\",\n122\t                zone=Zone.BATTLEFIELD,  # zone is conceptually 'any' for players\n123\t            )\n124\t        ]\n125\t\n126\t    # ------------------------------------------------------------------\n127\t    # ETB resolution\n128\t    # ------------------------------------------------------------------\n129\t\n130\t    def on_resolve(self, game: \"GameState\") -> None:\n131\t        \"\"\"ETB effect: create Inkling token for target player; check prepared.\"\"\"\n132\t        chosen = getattr(self, \"chosen_targets\", None)\n133\t        if not chosen:\n134\t            return\n135\t\n136\t        target_player = chosen[0]\n137\t\n138\t        # Step 1: Target player creates a 1/1 white and black Inkling token\n139\t        # with flying.\n140\t        from engine.game import create_token\n141\t        token = _make_inkling_token(owner=target_player, controller=target_player)\n142\t        create_token(game, target_player, token)\n143\t\n144\t        # Step 2: If an opponent controls more creatures than you, become prepared.\n145\t        controller = getattr(self, \"controller\", None)\n146\t        if controller is None:\n147\t            return\n148\t\n149\t        my_creature_count = _count_creatures_controlled_by(game, controller)\n150\t        opponent_max = _max_opponent_creature_count(game, controller)\n151\t\n152\t        if opponent_max > my_creature_count:\n153\t            self.is_prepared = True\n154\t\n155\t    # ------------------------------------------------------------------\n156\t    # Trigger registration\n157\t    # ------------------------------------------------------------------\n158\t\n159\t    def register_triggers(self, game: \"GameState\") -> None:\n160\t        \"\"\"Register the ETB trigger.\"\"\"\n161\t        source = self\n162\t        controller = getattr(self, \"controller\", None) or game.active_player\n163\t\n164\t        def _condition(g: \"GameState\", event: EntersBattlefieldTriggeredEvent) -> bool:\n165\t            return event.permanent is source\n166\t\n167\t        def _effect(g: \"GameState\") -> None:\n168\t            source.on_resolve(g)\n169\t\n170\t        game.trigger_manager.register(\n171\t            TriggerRegistration(\n172\t                event_type=EntersBattlefieldTriggeredEvent,\n173\t                condition=_condition,\n174\t                effect=_effect,\n175\t                source=source,\n176\t                controller=controller,\n177\t            )\n178\t        )\n179\t\n180\t    # ------------------------------------------------------------------\n181\t    # Prepared mechanic: cast spell copy\n182\t    # ------------------------------------------------------------------\n183\t\n184\t    def cast_prepared_spell(self, game: \"GameState\") -> None:\n185\t        \"\"\"Cast a copy of Swords to Plowshares if this creature is prepared.\n186\t\n187\t        Exiles the first valid target creature found on the battlefield and\n188\t        grants its controller life equal to its power.  Sets is_prepared to\n189\t        False regardless of whether a target was found.\n190\t        \"\"\"\n191\t        if not self.is_prepared:\n192\t            return\n193\t\n194\t        # Unprepare first (Swords to Plowshares copy has been \"cast\").\n195\t        self.is_prepared = False\n196\t\n197\t        # Find a target creature on any battlefield.\n198\t        target = _find_any_creature(game)\n199\t        if target is None:\n200\t            return\n201\t\n202\t        # Exile the target creature and give its controller life = power.\n203\t        _exile_creature_give_life(game, target)\n204\t\n205\t\n206\t# ---------------------------------------------------------------------------\n207\t# Helper functions\n208\t# ---------------------------------------------------------------------------\n209\t\n210\tdef _count_creatures_controlled_by(game: Any, player: Any) -> int:\n211\t    \"\"\"Return the number of creatures player controls on the battlefield.\"\"\"\n212\t    bf = game.get_battlefield(player)\n213\t    return sum(\n214\t        1 for obj in bf.get_all()\n215\t        if CardType.CREATURE in getattr(obj, \"card_types\", set())\n216\t    )\n217\t\n218\t\n219\tdef _max_opponent_creature_count(game: Any, player: Any) -> int:\n220\t    \"\"\"Return the maximum creature count among any single opponent.\"\"\"\n221\t    max_count = 0\n222\t    for p in game.players:\n223\t        if p is player:\n224\t            continue\n225\t        count = _count_creatures_controlled_by(game, p)\n226\t        if count > max_count:\n227\t            max_count = count\n228\t    return max_count\n229\t\n230\t\n231\tdef _find_any_creature(game: Any) -> Any:\n232\t    \"\"\"Return the first creature found on any player's battlefield, or None.\"\"\"\n233\t    for player in game.players:\n234\t        bf = game.get_battlefield(player)\n235\t        for obj in bf.get_all():\n236\t            if CardType.CREATURE in getattr(obj, \"card_types\", set()):\n237\t                return obj\n238\t    return None\n239\t\n240\t\n241\tdef _exile_creature_give_life(game: Any, creature: Any) -> None:\n242\t    \"\"\"Exile *creature* and grant its controller life equal to its power.\"\"\"\n243\t    from engine.game import exile\n244\t\n245\t    power = getattr(creature, \"power\", 0)\n246\t    ctrl = getattr(creature, \"controller\", None)\n247\t\n248\t    exile(game, creature)\n249\t\n250\t    if ctrl is not None and power > 0:\n251\t        ctrl.life += power\n252\t"}]},"parent_tool_use_id":"toolu_01Szf1o2Ha8JSCfYUHvHLQDr","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"a7198555-2a6c-4c83-ad83-d1914488c2d9","timestamp":"2026-05-28T00:17:50.264Z","subagent_type":"Tester","task_description":"Tester re-invoke for sos_13 untestable items"}
