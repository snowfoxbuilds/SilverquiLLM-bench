{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CEbr27pqxDPrHMLunV32Re","type":"tool_result","content":"1\t\"\"\"Card implementation for Vampire Gourmand.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom typing import TYPE_CHECKING, Any\n4\tfrom engine.card import Creature\n5\tfrom engine.types import CardType, ManaCost, Zone\n6\tfrom engine.events import AttacksTriggeredEvent\n7\tif TYPE_CHECKING:\n8\t    from engine.game_state import GameState\n9\t\n10\tclass VampireGourmand(Creature):\n11\t    \"\"\"Vampire Gourmand — {1}{B} — 2/2 — Vampire.\n12\t\n13\t    Whenever this creature attacks, you may sacrifice another creature.\n14\t    If you do, draw a card and this creature can't be blocked this turn.\n15\t\n16\t    FDN collector number 74.\n17\t    \"\"\"\n18\t\n19\t    def __init__(self, **kwargs: Any) -> None:\n20\t        kwargs.setdefault('name', 'Vampire Gourmand')\n21\t        kwargs.setdefault('mana_cost', ManaCost.parse('{1}{B}'))\n22\t        kwargs.setdefault('subtypes', {'Vampire'})\n23\t        kwargs.setdefault('base_power', 2)\n24\t        kwargs.setdefault('base_toughness', 2)\n25\t        kwargs.setdefault('rules_text', \"Whenever this creature attacks, you may sacrifice another creature. If you do, draw a card and this creature can't be blocked this turn.\")\n26\t        super().__init__(**kwargs)\n27\t\n28\t    def register_triggers(self, game: 'GameState') -> None:\n29\t        \"\"\"Register attack trigger for sacrifice/draw/unblockable.\"\"\"\n30\t        from engine.triggers import TriggerRegistration\n31\t        from engine.game import draw_card, sacrifice\n32\t        source = self\n33\t\n34\t        def _condition(game: Any, event: dict) -> bool:\n35\t            return event.creature is source\n36\t\n37\t        def _effect(game: 'GameState') -> None:\n38\t            controller = getattr(source, 'controller', None)\n39\t            if controller is None:\n40\t                return\n41\t            bf = game.get_battlefield(controller)\n42\t            candidates = [c for c in bf.get_all() if CardType.CREATURE in getattr(c, 'card_types', set()) and c is not source]\n43\t            if not candidates:\n44\t                return\n45\t            try:\n46\t                chosen = controller.choose_card(candidates, 'sacrifice a creature for draw + unblockable')\n47\t            except Exception:\n48\t                chosen = candidates[0] if candidates else None\n49\t            if chosen is None:\n50\t                return\n51\t            sacrifice(game, controller, chosen)\n52\t            draw_card(game, controller)\n53\t            source._cant_be_blocked = True\n54\t        controller = getattr(self, 'controller', None) or game.active_player\n55\t        game.trigger_manager.register(TriggerRegistration(event_type=AttacksTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=controller))\n56\t"}]},"parent_tool_use_id":"toolu_011XS3NnFVFPcGNqAtULLC3m","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"2fecde53-4ac0-4c0c-a335-11c72eda9056","timestamp":"2026-05-27T23:51:06.548Z","subagent_type":"Tester","task_description":"Tester for sos_1"}
