{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01T571ZWzQ1CKotrzqKnbxUi","type":"tool_result","content":"1\t\"\"\"Tests for SOS 97 — Ral Zarek, Guest Lecturer.\n2\t\n3\tCovers:\n4\t- Static properties: name, mana cost, card type, subtypes, supertypes, loyalty\n5\t- get_loyalty_abilities() returns exactly 3 abilities with correct loyalty costs\n6\t- +1: Surveil 2 — looks at top 2 library cards, moves chosen to graveyard\n7\t- −1: Any number of target players each discard a card\n8\t- −2: Return target creature card with mana value <= 3 from graveyard to battlefield\n9\t- −7: Flip 5 coins; target opponent skips X turns where X = heads count\n10\t- Loyalty tracking: each ability adjusts loyalty by its cost\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\timport pytest\n16\t\n17\tfrom cards.sos.sos_97.card_impl import RalZarekGuestLecturer\n18\tfrom engine.card import Creature, LoyaltyAbility, Planeswalker\n19\tfrom engine.types import CardType, ManaCost, ManaType, Supertype, Zone\n20\tfrom test_utils import create_game, set_board_state\n21\t\n22\t\n23\t# ---------------------------------------------------------------------------\n24\t# Static property tests\n25\t# ---------------------------------------------------------------------------\n26\t\n27\tclass TestRalZarekProperties:\n28\t    \"\"\"Static card data should match the sos_97 spec.\"\"\"\n29\t\n30\t    def test_is_planeswalker(self) -> None:\n31\t        card = RalZarekGuestLecturer(owner=None)\n32\t        assert isinstance(card, Planeswalker)\n33\t\n34\t    def test_name(self) -> None:\n35\t        assert RalZarekGuestLecturer(owner=None).name == \"Ral Zarek, Guest Lecturer\"\n36\t\n37\t    def test_mana_cost(self) -> None:\n38\t        assert RalZarekGuestLecturer(owner=None).mana_cost == ManaCost.parse(\"{1}{B}{B}\")\n39\t\n40\t    def test_planeswalker_card_type(self) -> None:\n41\t        card = RalZarekGuestLecturer(owner=None)\n42\t        assert CardType.PLANESWALKER in card.card_types\n43\t\n44\t    def test_legendary_supertype(self) -> None:\n45\t        card = RalZarekGuestLecturer(owner=None)\n46\t        assert Supertype.LEGENDARY in card.supertypes\n47\t\n48\t    def test_ral_subtype(self) -> None:\n49\t        card = RalZarekGuestLecturer(owner=None)\n50\t        assert \"Ral\" in card.subtypes\n51\t\n52\t    def test_starting_loyalty_three(self) -> None:\n53\t        card = RalZarekGuestLecturer(owner=None)\n54\t        assert card.starting_loyalty == 3\n55\t\n56\t\n57\t# ---------------------------------------------------------------------------\n58\t# Loyalty ability declaration tests\n59\t# ---------------------------------------------------------------------------\n60\t\n61\tclass TestRalZarekLoyaltyAbilities:\n62\t    \"\"\"get_loyalty_abilities() should return exactly 3 LoyaltyAbility instances.\"\"\"\n63\t\n64\t    def test_returns_list_of_three(self) -> None:\n65\t        card = RalZarekGuestLecturer(owner=None)\n66\t        abilities = card.get_loyalty_abilities()\n67\t        assert isinstance(abilities, list)\n68\t        assert len(abilities) == 3\n69\t\n70\t    def test_plus_one_ability_cost(self) -> None:\n71\t        \"\"\"First ability is +1 (Surveil 2).\"\"\"\n72\t        abilities = RalZarekGuestLecturer(owner=None).get_loyalty_abilities()\n73\t        assert abilities[0].loyalty_cost == +1\n74\t\n75\t    def test_minus_one_ability_cost(self) -> None:\n76\t        \"\"\"Second ability is −1 (discard).\"\"\"\n77\t        abilities = RalZarekGuestLecturer(owner=None).get_loyalty_abilities()\n78\t        assert abilities[1].loyalty_cost == -1\n79\t\n80\t    def test_minus_two_ability_cost(self) -> None:\n81\t        \"\"\"Third ability is −2 (return creature from graveyard).\"\"\"\n82\t        abilities = RalZarekGuestLecturer(owner=None).get_loyalty_abilities()\n83\t        assert abilities[2].loyalty_cost == -2\n84\t\n85\t    def test_fourth_ability_cost_minus_seven(self) -> None:\n86\t        \"\"\"Card has a −7 ability (coin-flip turn-skip); it must be in the list.\"\"\"\n87\t        abilities = RalZarekGuestLecturer(owner=None).get_loyalty_abilities()\n88\t        costs = [a.loyalty_cost for a in abilities]\n89\t        assert -7 in costs\n90\t\n91\t\n92\t# ---------------------------------------------------------------------------\n93\t# +1 Surveil 2 tests\n94\t# ---------------------------------------------------------------------------\n95\t\n96\tclass TestRalZarekSurveil:\n97\t    \"\"\"+1: Surveil 2 — look at top 2, keep or send to graveyard.\"\"\"\n98\t\n99\t    def _setup(self):\n100\t        \"\"\"Return a game and a placed Ral on player 0's battlefield.\"\"\"\n101\t        game = create_game()\n102\t        p1 = game.players[0]\n103\t        ral = RalZarekGuestLecturer(owner=p1, controller=p1)\n104\t        set_board_state(game, 0, battlefield=[ral])\n105\t        return game, p1, ral\n106\t\n107\t    def test_surveil_moves_chosen_card_to_graveyard(self) -> None:\n108\t        \"\"\"When controller says 'yes' to the first card, it goes to graveyard.\"\"\"\n109\t        game, p1, ral = self._setup()\n110\t        # Put two cards on top of library.\n111\t        c1 = Creature(name=\"Card A\", base_power=1, base_toughness=1, owner=p1)\n112\t        c2 = Creature(name=\"Card B\", base_power=1, base_toughness=1, owner=p1)\n113\t        library = p1.zones[Zone.LIBRARY]\n114\t        library.add(c1)\n115\t        library.add(c2)  # c2 is now on top\n116\t\n117\t        # Script: send c2 to graveyard (True), keep c1 in library (False).\n118\t        p1._script.append(True)\n119\t        p1._script.append(False)\n120\t\n121\t        abilities = ral.get_loyalty_abilities()\n122\t        plus_one = abilities[0]\n123\t        plus_one.effect(game)\n124\t\n125\t        graveyard = p1.zones[Zone.GRAVEYARD]\n126\t        assert graveyard.contains(c2), \"Top card chosen for graveyard should be in graveyard\"\n127\t        assert library.contains(c1), \"Card kept should remain in library\"\n128\t\n129\t    def test_surveil_card_kept_stays_in_library(self) -> None:\n130\t        \"\"\"When controller says 'no' to a card, it remains in the library.\"\"\"\n131\t        game, p1, ral = self._setup()\n132\t        c1 = Creature(name=\"Keeper\", base_power=2, base_toughness=2, owner=p1)\n133\t        library = p1.zones[Zone.LIBRARY]\n134\t        library.add(c1)\n135\t\n136\t        # Script: keep c1 (False → don't send to graveyard).\n137\t        p1._script.append(False)\n138\t\n139\t        abilities = ral.get_loyalty_abilities()\n140\t        plus_one = abilities[0]\n141\t        plus_one.effect(game)\n142\t\n143\t        assert library.contains(c1), \"Kept card should remain in library\"\n144\t\n145\t    def test_surveil_with_empty_library_does_not_raise(self) -> None:\n146\t        \"\"\"Surveil with no cards in library is a no-op (no error).\"\"\"\n147\t        game, p1, ral = self._setup()\n148\t        # Library is empty.\n149\t        abilities = ral.get_loyalty_abilities()\n150\t        plus_one = abilities[0]\n151\t        plus_one.effect(game)  # Must not raise.\n152\t\n153\t    def test_surveil_only_looks_at_up_to_two_cards(self) -> None:\n154\t        \"\"\"Surveil 2 only inspects top 2 cards, not the full library.\"\"\"\n155\t        game, p1, ral = self._setup()\n156\t        library = p1.zones[Zone.LIBRARY]\n157\t        cards = [\n158\t            Creature(name=f\"Card {i}\", base_power=1, base_toughness=1, owner=p1)\n159\t            for i in range(5)\n160\t        ]\n161\t        for c in cards:\n162\t            library.add(c)\n163\t\n164\t        # Send both surveiled cards to graveyard.\n165\t        p1._script.append(True)\n166\t        p1._script.append(True)\n167\t\n168\t        initial_size = len(library)\n169\t        abilities = ral.get_loyalty_abilities()\n170\t        plus_one = abilities[0]\n171\t        plus_one.effect(game)\n172\t\n173\t        graveyard = p1.zones[Zone.GRAVEYARD]\n174\t        assert len(graveyard) == 2, \"Exactly 2 cards should be surveiled to graveyard\"\n175\t        assert len(library) == initial_size - 2\n176\t\n177\t\n178\t# ---------------------------------------------------------------------------\n179\t# −1 Discard ability tests\n180\t# ---------------------------------------------------------------------------\n181\t\n182\tclass TestRalZarekDiscard:\n183\t    \"\"\"−1: Any number of target players each discard a card.\"\"\"\n184\t\n185\t    def _setup(self):\n186\t        game = create_game()\n187\t        p1 = game.players[0]\n188\t        p2 = game.players[1]\n189\t        ral = RalZarekGuestLecturer(owner=p1, controller=p1)\n190\t        set_board_state(game, 0, battlefield=[ral])\n191\t        return game, p1, p2, ral\n192\t\n193\t    def test_targeted_player_discards_a_card(self) -> None:\n194\t        \"\"\"The targeted player (p1) loses one card from hand.\"\"\"\n195\t        game, p1, p2, ral = self._setup()\n196\t        hand_card = Creature(name=\"Discard Me\", base_power=1, base_toughness=1, owner=p1)\n197\t        set_board_state(game, 0, hand=[hand_card])\n198\t\n199\t        # Script: p1 discards hand_card.\n200\t        p1._script.append(hand_card)\n201\t\n202\t        abilities = ral.get_loyalty_abilities()\n203\t        minus_one = abilities[1]\n204\t        # Set targets to p1 (targeting self is legal for \"any number of target players\").\n205\t        ral._resolve_targets = [p1]\n206\t        minus_one.effect(game)\n207\t\n208\t        graveyard = p1.zones[Zone.GRAVEYARD]\n209\t        assert graveyard.contains(hand_card), \"Discarded card should be in graveyard\"\n210\t\n211\t    def test_opponent_discards_a_card(self) -> None:\n212\t        \"\"\"The targeted opponent loses one card from their hand.\"\"\"\n213\t        game, p1, p2, ral = self._setup()\n214\t        opp_card = Creature(name=\"Opp Card\", base_power=1, base_toughness=1, owner=p2)\n215\t        set_board_state(game, 1, hand=[opp_card])\n216\t\n217\t        # Script: p2 discards opp_card.\n218\t        p2._script.append(opp_card)\n219\t\n220\t        abilities = ral.get_loyalty_abilities()\n221\t        minus_one = abilities[1]\n222\t        ral._resolve_targets = [p2]\n223\t        minus_one.effect(game)\n224\t\n225\t        graveyard = p2.zones[Zone.GRAVEYARD]\n226\t        assert graveyard.contains(opp_card), \"Opponent's discarded card should be in their graveyard\"\n227\t\n228\t    def test_no_targets_is_a_noop(self) -> None:\n229\t        \"\"\"With zero targets chosen, no discard occurs and no error is raised.\"\"\"\n230\t        game, p1, p2, ral = self._setup()\n231\t        hand_card = Creature(name=\"Safe Card\", base_power=1, base_toughness=1, owner=p1)\n232\t        set_board_state(game, 0, hand=[hand_card])\n233\t\n234\t        abilities = ral.get_loyalty_abilities()\n235\t        minus_one = abilities[1]\n236\t        ral._resolve_targets = []\n237\t        minus_one.effect(game)\n238\t\n239\t        assert p1.zones[Zone.HAND].contains(hand_card), \"Card should stay in hand when no targets\"\n240\t\n241\t    def test_multiple_players_each_discard(self) -> None:\n242\t        \"\"\"When both players are targeted, each discards a card.\"\"\"\n243\t        game, p1, p2, ral = self._setup()\n244\t        p1_card = Creature(name=\"P1 Discard\", base_power=1, base_toughness=1, owner=p1)\n245\t        p2_card = Creature(name=\"P2 Discard\", base_power=1, base_toughness=1, owner=p2)\n246\t        set_board_state(game, 0, hand=[p1_card])\n247\t        set_board_state(game, 1, hand=[p2_card])\n248\t\n249\t        # Script: p1 discards p1_card, p2 discards p2_card.\n250\t        p1._script.append(p1_card)\n251\t        p2._script.append(p2_card)\n252\t\n253\t        abilities = ral.get_loyalty_abilities()\n254\t        minus_one = abilities[1]\n255\t        ral._resolve_targets = [p1, p2]\n256\t        minus_one.effect(game)\n257\t\n258\t        assert p1.zones[Zone.GRAVEYARD].contains(p1_card)\n259\t        assert p2.zones[Zone.GRAVEYARD].contains(p2_card)\n260\t\n261\t\n262\t# ---------------------------------------------------------------------------\n263\t# −2 Return creature from graveyard to battlefield\n264\t# ---------------------------------------------------------------------------\n265\t\n266\tclass TestRalZarekGraveyardReturn:\n267\t    \"\"\"−2: Return target creature card with MV <= 3 from your graveyard to battlefield.\"\"\"\n268\t\n269\t    def _setup(self):\n270\t        game = create_game()\n271\t        p1 = game.players[0]\n272\t        ral = RalZarekGuestLecturer(owner=p1, controller=p1)\n273\t        set_board_state(game, 0, battlefield=[ral])\n274\t        return game, p1, ral\n275\t\n276\t    def test_creature_with_mv_three_or_less_returns_to_battlefield(self) -> None:\n277\t        \"\"\"A creature with CMC 3 in the graveyard enters the battlefield.\"\"\"\n278\t        game, p1, ral = self._setup()\n279\t        small_creature = Creature(\n280\t            name=\"Small Dude\",\n281\t            base_power=2,\n282\t            base_toughness=2,\n283\t            owner=p1,\n284\t            controller=p1,\n285\t            mana_cost=ManaCost.parse(\"{1}{B}{B}\"),  # CMC 3\n286\t        )\n287\t        set_board_state(game, 0, graveyard=[small_creature])\n288\t\n289\t        abilities = ral.get_loyalty_abilities()\n290\t        minus_two = abilities[2]\n291\t        ral._resolve_target = small_creature\n292\t        minus_two.effect(game)\n293\t\n294\t        battlefield = game.get_battlefield(p1)\n295\t        assert battlefield.contains(small_creature), \"Creature should enter the battlefield\"\n296\t\n297\t    def test_creature_moved_out_of_graveyard(self) -> None:\n298\t        \"\"\"After returning, the creature is no longer in the graveyard.\"\"\"\n299\t        game, p1, ral = self._setup()\n300\t        creature = Creature(\n301\t            name=\"Cheap Creature\",\n302\t            base_power=1,\n303\t            base_toughness=1,\n304\t            owner=p1,\n305\t            controller=p1,\n306\t            mana_cost=ManaCost.parse(\"{B}\"),  # CMC 1\n307\t        )\n308\t        set_board_state(game, 0, graveyard=[creature])\n309\t\n310\t        abilities = ral.get_loyalty_abilities()\n311\t        minus_two = abilities[2]\n312\t        ral._resolve_target = creature\n313\t        minus_two.effect(game)\n314\t\n315\t        graveyard = game.get_graveyard(p1)\n316\t        assert not graveyard.contains(creature), \"Creature should no longer be in graveyard\"\n317\t\n318\t    def test_no_target_is_a_noop(self) -> None:\n319\t        \"\"\"If no target is set, the ability does nothing and does not raise.\"\"\"\n320\t        game, p1, ral = self._setup()\n321\t        abilities = ral.get_loyalty_abilities()\n322\t        minus_two = abilities[2]\n323\t        ral._resolve_target = None\n324\t        minus_two.effect(game)  # Must not raise.\n325\t\n326\t\n327\t# ---------------------------------------------------------------------------\n328\t# −7 Coin-flip turn-skip tests\n329\t# ---------------------------------------------------------------------------\n330\t\n331\tclass TestRalZarekUltimate:\n332\t    \"\"\"−7: Flip five coins; opponent skips X turns where X = heads.\"\"\"\n333\t\n334\t    def _setup(self):\n335\t        game = create_game()\n336\t        p1 = game.players[0]\n337\t        p2 = game.players[1]\n338\t        ral = RalZarekGuestLecturer(owner=p1, controller=p1)\n339\t        set_board_state(game, 0, battlefield=[ral])\n340\t        return game, p1, p2, ral\n341\t\n342\t    def _find_minus_seven(self, ral: RalZarekGuestLecturer) -> LoyaltyAbility:\n343\t        abilities = ral.get_loyalty_abilities()\n344\t        for a in abilities:\n345\t            if a.loyalty_cost == -7:\n346\t                return a\n347\t        raise AssertionError(\"No −7 ability found on Ral Zarek, Guest Lecturer\")\n348\t\n349\t    def test_ultimate_exists_with_minus_seven_cost(self) -> None:\n350\t        \"\"\"The −7 ultimate ability must be declared.\"\"\"\n351\t        _, _, _, ral = self._setup()\n352\t        self._find_minus_seven(ral)  # Raises if not found.\n353\t\n354\t    def test_ultimate_with_all_heads_skips_five_turns(self) -> None:\n355\t        \"\"\"Five heads → opponent skips 5 turns (5 extra turn slots for p1).\"\"\"\n356\t        game, p1, p2, ral = self._setup()\n357\t        minus_seven = self._find_minus_seven(ral)\n358\t        ral._resolve_target = p2\n359\t        # Patch coin flip to always return heads (True = heads).\n360\t        ral._coin_flip_results = [True, True, True, True, True]\n361\t        before_extra = len(game.extra_turns)\n362\t        minus_seven.effect(game)\n363\t        after_extra = len(game.extra_turns)\n364\t        # 5 turns skipped for opponent = 5 extra turns granted to p1 (or 5 extra entries).\n365\t        # Accept either: extra_turns grew by 5, or p2.skipped_turns attribute set to 5.\n366\t        if hasattr(p2, \"skipped_turns\"):\n367\t            assert p2.skipped_turns >= 5\n368\t        else:\n369\t            assert after_extra - before_extra == 5\n370\t\n371\t    def test_ultimate_with_all_tails_skips_zero_turns(self) -> None:\n372\t        \"\"\"Five tails → X=0, opponent skips no turns.\"\"\"\n373\t        game, p1, p2, ral = self._setup()\n374\t        minus_seven = self._find_minus_seven(ral)\n375\t        ral._resolve_target = p2\n376\t        ral._coin_flip_results = [False, False, False, False, False]\n377\t        before_extra = len(game.extra_turns)\n378\t        minus_seven.effect(game)\n379\t        after_extra = len(game.extra_turns)\n380\t        if hasattr(p2, \"skipped_turns\"):\n381\t            assert p2.skipped_turns == 0\n382\t        else:\n383\t            assert after_extra == before_extra\n384\t\n385\t    def test_ultimate_no_target_does_not_raise(self) -> None:\n386\t        \"\"\"If no target is provided, the ultimate is a no-op and doesn't crash.\"\"\"\n387\t        game, p1, p2, ral = self._setup()\n388\t        minus_seven = self._find_minus_seven(ral)\n389\t        ral._resolve_target = None\n390\t        ral._coin_flip_results = [True, True, True, True, True]\n391\t        minus_seven.effect(game)  # Must not raise.\n392\t\n393\t\n394\t# ---------------------------------------------------------------------------\n395\t# Loyalty counter adjustment tests\n396\t# ---------------------------------------------------------------------------\n397\t\n398\tclass TestRalZarekLoyaltyTracking:\n399\t    \"\"\"Each activated ability adjusts loyalty by its declared cost.\"\"\"\n400\t\n401\t    def _place_ral(self, game, player, starting_loyalty=10):\n402\t        ral = RalZarekGuestLecturer(owner=player, controller=player)\n403\t        ral.loyalty = starting_loyalty\n404\t        set_board_state(game, game.players.index(player), battlefield=[ral])\n405\t        return ral\n406\t\n407\t    def test_plus_one_increases_loyalty(self) -> None:\n408\t        game = create_game()\n409\t        p1 = game.players[0]\n410\t        ral = self._place_ral(game, p1, starting_loyalty=5)\n411\t        # Library must have cards; script says don't send to graveyard.\n412\t        library = p1.zones[Zone.LIBRARY]\n413\t        c1 = Creature(name=\"C1\", base_power=1, base_toughness=1, owner=p1)\n414\t        c2 = Creature(name=\"C2\", base_power=1, base_toughness=1, owner=p1)\n415\t        library.add(c1)\n416\t        library.add(c2)\n417\t        p1._script.append(False)\n418\t        p1._script.append(False)\n419\t\n420\t        abilities = ral.get_loyalty_abilities()\n421\t        plus_one = abilities[0]\n422\t        before = ral.loyalty\n423\t        # Loyalty is adjusted by the ability dispatch layer, not the effect itself.\n424\t        # The LoyaltyAbility.loyalty_cost attribute signals the cost.\n425\t        # We test that activating + manually adjusting matches the spec.\n426\t        ral.loyalty += plus_one.loyalty_cost\n427\t        assert ral.loyalty == before + 1\n428\t\n429\t    def test_minus_one_decreases_loyalty(self) -> None:\n430\t        game = create_game()\n431\t        p1 = game.players[0]\n432\t        ral = self._place_ral(game, p1, starting_loyalty=5)\n433\t        abilities = ral.get_loyalty_abilities()\n434\t        minus_one = abilities[1]\n435\t        before = ral.loyalty\n436\t        ral.loyalty += minus_one.loyalty_cost\n437\t        assert ral.loyalty == before - 1\n438\t\n439\t    def test_minus_two_decreases_loyalty(self) -> None:\n440\t        game = create_game()\n441\t        p1 = game.players[0]\n442\t        ral = self._place_ral(game, p1, starting_loyalty=5)\n443\t        abilities = ral.get_loyalty_abilities()\n444\t        minus_two = abilities[2]\n445\t        before = ral.loyalty\n446\t        ral.loyalty += minus_two.loyalty_cost\n447\t        assert ral.loyalty == before - 2\n448\t"}]},"parent_tool_use_id":"toolu_01WR1fbN4mqAZRUeHepbCzKC","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"fd3bf134-a604-4d48-b818-a413836ac9eb","timestamp":"2026-05-28T00:42:38.584Z","subagent_type":"Tester","task_description":"Tester fix for sos_97 dispute"}
