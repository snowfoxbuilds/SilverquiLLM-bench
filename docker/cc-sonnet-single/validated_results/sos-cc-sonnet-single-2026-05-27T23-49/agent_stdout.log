{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0196WbfeVqznj9hQA3BRpENJ","type":"tool_result","content":"1\t\"\"\"Tests for SOS 1 — The Dawning Archaic.\n2\t\n3\tCovers:\n4\t- Static card properties (name, mana cost, P/T, type line, keywords, supertypes)\n5\t- Cost reduction: {1} less per instant/sorcery in controller's graveyard\n6\t- Cost reduction counts only instants/sorceries, not other card types\n7\t- Cost reduction is capped at the generic mana component (cannot go negative)\n8\t- Attack trigger: registered on entering the battlefield via register_triggers\n9\t- Attack trigger fires only when this creature attacks (not other creatures)\n10\t- Attack trigger enables free-cast of instant/sorcery from graveyard\n11\t- Replacement: free-cast spell that would go to graveyard goes to exile instead\n12\t\"\"\"\n13\t\n14\tfrom __future__ import annotations\n15\t\n16\timport pytest\n17\t\n18\tfrom cards.sos.sos_1.card_impl import TheDawningArchaic\n19\tfrom engine.card import Creature, Instant, Sorcery, Land, Enchantment\n20\tfrom engine.events import AttacksTriggeredEvent\n21\tfrom engine.triggers import TriggerRegistration\n22\tfrom engine.types import CardType, Keyword, ManaCost, ManaType, Supertype, Zone\n23\tfrom test_utils import create_game, set_board_state, declare_attackers\n24\t\n25\t\n26\t# ---------------------------------------------------------------------------\n27\t# Static card property tests\n28\t# ---------------------------------------------------------------------------\n29\t\n30\t\n31\tclass TestTheDawningArchaicProperties:\n32\t    \"\"\"Static card data should match the SOS 1 spec.\"\"\"\n33\t\n34\t    def test_is_creature(self) -> None:\n35\t        card = TheDawningArchaic(owner=None)\n36\t        assert isinstance(card, Creature)\n37\t\n38\t    def test_name(self) -> None:\n39\t        card = TheDawningArchaic(owner=None)\n40\t        assert card.name == \"The Dawning Archaic\"\n41\t\n42\t    def test_mana_cost(self) -> None:\n43\t        card = TheDawningArchaic(owner=None)\n44\t        assert card.mana_cost == ManaCost.parse(\"{10}\")\n45\t\n46\t    def test_power(self) -> None:\n47\t        card = TheDawningArchaic(owner=None)\n48\t        assert card.base_power == 7\n49\t\n50\t    def test_toughness(self) -> None:\n51\t        card = TheDawningArchaic(owner=None)\n52\t        assert card.base_toughness == 7\n53\t\n54\t    def test_has_reach(self) -> None:\n55\t        card = TheDawningArchaic(owner=None)\n56\t        assert Keyword.REACH in card.keywords\n57\t\n58\t    def test_is_legendary(self) -> None:\n59\t        card = TheDawningArchaic(owner=None)\n60\t        assert Supertype.LEGENDARY in card.supertypes\n61\t\n62\t    def test_creature_card_type(self) -> None:\n63\t        card = TheDawningArchaic(owner=None)\n64\t        assert CardType.CREATURE in card.card_types\n65\t\n66\t    def test_avatar_subtype(self) -> None:\n67\t        card = TheDawningArchaic(owner=None)\n68\t        assert \"Avatar\" in card.subtypes\n69\t\n70\t\n71\t# ---------------------------------------------------------------------------\n72\t# Cost reduction tests\n73\t# ---------------------------------------------------------------------------\n74\t\n75\t\n76\tclass TestTheDawningArchaicCostReduction:\n77\t    \"\"\"cost_reduction() returns {1} per instant/sorcery in the graveyard.\"\"\"\n78\t\n79\t    def test_no_graveyard_cards_no_reduction(self) -> None:\n80\t        game = create_game()\n81\t        p1 = game.players[0]\n82\t        card = TheDawningArchaic(owner=p1, controller=p1)\n83\t        # Empty graveyard → no reduction\n84\t        assert card.cost_reduction(game) == 0\n85\t\n86\t    def test_one_instant_in_graveyard_reduces_by_one(self) -> None:\n87\t        game = create_game()\n88\t        p1 = game.players[0]\n89\t        card = TheDawningArchaic(owner=p1, controller=p1)\n90\t        instant = Instant(name=\"Lightning Bolt\")\n91\t        set_board_state(game, 0, graveyard=[instant])\n92\t        assert card.cost_reduction(game) == 1\n93\t\n94\t    def test_one_sorcery_in_graveyard_reduces_by_one(self) -> None:\n95\t        game = create_game()\n96\t        p1 = game.players[0]\n97\t        card = TheDawningArchaic(owner=p1, controller=p1)\n98\t        sorcery = Sorcery(name=\"Divination\")\n99\t        set_board_state(game, 0, graveyard=[sorcery])\n100\t        assert card.cost_reduction(game) == 1\n101\t\n102\t    def test_multiple_instants_and_sorceries_reduce_each(self) -> None:\n103\t        game = create_game()\n104\t        p1 = game.players[0]\n105\t        card = TheDawningArchaic(owner=p1, controller=p1)\n106\t        graveyard_cards = [\n107\t            Instant(name=\"Bolt\"),\n108\t            Instant(name=\"Shock\"),\n109\t            Sorcery(name=\"Wrath\"),\n110\t            Sorcery(name=\"Divination\"),\n111\t        ]\n112\t        set_board_state(game, 0, graveyard=graveyard_cards)\n113\t        assert card.cost_reduction(game) == 4\n114\t\n115\t    def test_non_instant_sorcery_cards_do_not_contribute(self) -> None:\n116\t        \"\"\"Creatures, lands, enchantments in graveyard don't reduce cost.\"\"\"\n117\t        game = create_game()\n118\t        p1 = game.players[0]\n119\t        card = TheDawningArchaic(owner=p1, controller=p1)\n120\t        bear = Creature(name=\"Grizzly Bears\", base_power=2, base_toughness=2)\n121\t        forest = Land(name=\"Forest\")\n122\t        ench = Enchantment(name=\"Pacifism\")\n123\t        set_board_state(game, 0, graveyard=[bear, forest, ench])\n124\t        assert card.cost_reduction(game) == 0\n125\t\n126\t    def test_mixed_graveyard_counts_only_instants_and_sorceries(self) -> None:\n127\t        game = create_game()\n128\t        p1 = game.players[0]\n129\t        card = TheDawningArchaic(owner=p1, controller=p1)\n130\t        instant = Instant(name=\"Bolt\")\n131\t        bear = Creature(name=\"Bear\", base_power=2, base_toughness=2)\n132\t        set_board_state(game, 0, graveyard=[instant, bear])\n133\t        assert card.cost_reduction(game) == 1\n134\t\n135\t    def test_ten_instants_reduces_full_cost(self) -> None:\n136\t        \"\"\"10 instants/sorceries → reduce the full {10} generic cost to {0}.\"\"\"\n137\t        game = create_game()\n138\t        p1 = game.players[0]\n139\t        card = TheDawningArchaic(owner=p1, controller=p1)\n140\t        graveyard_cards = [Instant(name=f\"Spell{i}\") for i in range(10)]\n141\t        set_board_state(game, 0, graveyard=graveyard_cards)\n142\t        # Reduction capped at the card's 10 generic mana\n143\t        assert card.cost_reduction(game) == 10\n144\t\n145\t    def test_more_than_ten_instants_capped_at_ten(self) -> None:\n146\t        \"\"\"Reduction cannot exceed the generic mana component (10).\"\"\"\n147\t        game = create_game()\n148\t        p1 = game.players[0]\n149\t        card = TheDawningArchaic(owner=p1, controller=p1)\n150\t        graveyard_cards = [Instant(name=f\"Spell{i}\") for i in range(15)]\n151\t        set_board_state(game, 0, graveyard=graveyard_cards)\n152\t        # Max reduction is 10 (the generic portion of the mana cost)\n153\t        assert card.cost_reduction(game) <= 10\n154\t\n155\t    def test_opponent_graveyard_does_not_contribute(self) -> None:\n156\t        \"\"\"Only the controller's own graveyard counts.\"\"\"\n157\t        game = create_game()\n158\t        p1 = game.players[0]\n159\t        card = TheDawningArchaic(owner=p1, controller=p1)\n160\t        # Put instants in opponent's graveyard, not controller's\n161\t        set_board_state(game, 1, graveyard=[Instant(name=\"Bolt\"), Instant(name=\"Shock\")])\n162\t        # Controller's graveyard is empty → no reduction\n163\t        assert card.cost_reduction(game) == 0\n164\t\n165\t    def test_cast_cost_reduced_by_graveyard(self) -> None:\n166\t        \"\"\"Integration: with instants in graveyard, can cast for reduced cost.\"\"\"\n167\t        game = create_game()\n168\t        p1 = game.players[0]\n169\t        # Put 9 instants in graveyard so the 10-cost becomes 1\n170\t        graveyard_cards = [Instant(name=f\"Spell{i}\") for i in range(9)]\n171\t        card = TheDawningArchaic(owner=None)\n172\t        set_board_state(game, 0,\n173\t                        hand=[card],\n174\t                        graveyard=graveyard_cards,\n175\t                        mana={ManaType.COLORLESS: 1})\n176\t        # With 9 instants in GY, cost is {10} - 9 = {1} — exactly enough mana\n177\t        from test_utils import cast_spell as test_cast_spell\n178\t        test_cast_spell(game, 0, \"The Dawning Archaic\")\n179\t        # Successfully resolved to battlefield\n180\t        assert game.get_battlefield(p1).contains(card)\n181\t\n182\t\n183\t# ---------------------------------------------------------------------------\n184\t# Attack trigger registration tests\n185\t# ---------------------------------------------------------------------------\n186\t\n187\t\n188\tclass TestTheDawningArchaicTriggerRegistration:\n189\t    \"\"\"register_triggers() must wire an AttacksTriggeredEvent trigger.\"\"\"\n190\t\n191\t    def test_registers_at_least_one_trigger(self) -> None:\n192\t        game = create_game()\n193\t        p1 = game.players[0]\n194\t        card = TheDawningArchaic(owner=p1, controller=p1)\n195\t        before = len(game.trigger_manager.get_triggers())\n196\t        card.register_triggers(game)\n197\t        after = len(game.trigger_manager.get_triggers())\n198\t        assert after > before\n199\t\n200\t    def test_registers_attacks_trigger(self) -> None:\n201\t        \"\"\"At least one registered trigger must watch AttacksTriggeredEvent.\"\"\"\n202\t        game = create_game()\n203\t        p1 = game.players[0]\n204\t        card = TheDawningArchaic(owner=p1, controller=p1)\n205\t        card.register_triggers(game)\n206\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n207\t        attack_triggers = [\n208\t            t for t in triggers\n209\t            if issubclass(t.event_type, AttacksTriggeredEvent)\n210\t        ]\n211\t        assert len(attack_triggers) >= 1\n212\t\n213\t    def test_trigger_source_is_card(self) -> None:\n214\t        game = create_game()\n215\t        p1 = game.players[0]\n216\t        card = TheDawningArchaic(owner=p1, controller=p1)\n217\t        card.register_triggers(game)\n218\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n219\t        attack_triggers = [\n220\t            t for t in triggers\n221\t            if issubclass(t.event_type, AttacksTriggeredEvent)\n222\t        ]\n223\t        assert len(attack_triggers) >= 1\n224\t        assert attack_triggers[0].source is card\n225\t\n226\t    def test_trigger_condition_is_self_only(self) -> None:\n227\t        \"\"\"The trigger must only fire when THIS creature attacks, not any attacker.\"\"\"\n228\t        game = create_game()\n229\t        p1 = game.players[0]\n230\t        card = TheDawningArchaic(owner=p1, controller=p1)\n231\t        card.register_triggers(game)\n232\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n233\t        attack_triggers = [\n234\t            t for t in triggers\n235\t            if issubclass(t.event_type, AttacksTriggeredEvent)\n236\t        ]\n237\t        assert len(attack_triggers) >= 1\n238\t        trigger = attack_triggers[0]\n239\t        if trigger.condition is not None:\n240\t            # Must match when `creature` is the card itself\n241\t            event_self = AttacksTriggeredEvent(creature=card)\n242\t            assert trigger.condition(game, event_self) is True\n243\t            # Must NOT match when a different creature attacks\n244\t            other = Creature(name=\"Other Creature\", base_power=2, base_toughness=2)\n245\t            event_other = AttacksTriggeredEvent(creature=other)\n246\t            assert trigger.condition(game, event_other) is False\n247\t\n248\t\n249\t# ---------------------------------------------------------------------------\n250\t# Attack trigger effect — free-cast from graveyard\n251\t# ---------------------------------------------------------------------------\n252\t\n253\t\n254\tclass TestTheDawningArchaicAttackTriggerEffect:\n255\t    \"\"\"The attack trigger allows free-casting an instant/sorcery from the graveyard.\"\"\"\n256\t\n257\t    def test_attack_trigger_casts_instant_from_graveyard(self) -> None:\n258\t        \"\"\"When the attack trigger fires, it casts an instant from the graveyard.\"\"\"\n259\t        game = create_game()\n260\t        p1 = game.players[0]\n261\t        card = TheDawningArchaic(owner=p1, controller=p1)\n262\t        # Put a cheap instant in the graveyard as the target\n263\t        instant = Instant(name=\"Lightning Bolt\")\n264\t        set_board_state(game, 0, graveyard=[instant])\n265\t        card.register_triggers(game)\n266\t\n267\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n268\t        attack_triggers = [\n269\t            t for t in triggers\n270\t            if issubclass(t.event_type, AttacksTriggeredEvent)\n271\t        ]\n272\t        assert len(attack_triggers) >= 1\n273\t        trigger = attack_triggers[0]\n274\t\n275\t        # Fire the effect directly — simulates the trigger resolving\n276\t        trigger.effect(game)\n277\t\n278\t        # The instant should no longer be in the graveyard\n279\t        assert not game.get_graveyard(p1).contains(instant)\n280\t\n281\t    def test_attack_trigger_no_op_with_empty_graveyard(self) -> None:\n282\t        \"\"\"If the graveyard has no instants/sorceries, the trigger resolves gracefully.\"\"\"\n283\t        game = create_game()\n284\t        p1 = game.players[0]\n285\t        card = TheDawningArchaic(owner=p1, controller=p1)\n286\t        set_board_state(game, 0, graveyard=[])\n287\t        card.register_triggers(game)\n288\t\n289\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n290\t        attack_triggers = [\n291\t            t for t in triggers\n292\t            if issubclass(t.event_type, AttacksTriggeredEvent)\n293\t        ]\n294\t        assert len(attack_triggers) >= 1\n295\t        trigger = attack_triggers[0]\n296\t\n297\t        # Should not raise even with empty graveyard\n298\t        trigger.effect(game)\n299\t\n300\t    def test_attack_trigger_fires_on_attacking(self) -> None:\n301\t        \"\"\"Declaring this creature as an attacker fires the attack trigger.\"\"\"\n302\t        game = create_game()\n303\t        p1 = game.players[0]\n304\t        card = TheDawningArchaic(owner=p1, controller=p1)\n305\t        # Prevent summoning sickness so it can attack\n306\t        card.summoning_sick = False\n307\t        card.is_tapped = False\n308\t        set_board_state(game, 0, battlefield=[card])\n309\t        card.register_triggers(game)\n310\t\n311\t        before_stack_size = len(game.stack.objects())\n312\t        # Fire the trigger manager with an AttacksTriggeredEvent for this card\n313\t        from engine.events import AttacksTriggeredEvent as ATE\n314\t        game.trigger_manager.fire_event(game, ATE(creature=card))\n315\t\n316\t        # A trigger should have been pushed to the stack\n317\t        assert len(game.stack.objects()) > before_stack_size\n318\t\n319\t    def test_other_creature_attack_does_not_fire_trigger(self) -> None:\n320\t        \"\"\"An AttacksTriggeredEvent for a different creature does NOT fire the trigger.\"\"\"\n321\t        game = create_game()\n322\t        p1 = game.players[0]\n323\t        card = TheDawningArchaic(owner=p1, controller=p1)\n324\t        card.register_triggers(game)\n325\t\n326\t        other = Creature(name=\"Bear\", base_power=2, base_toughness=2, owner=p1, controller=p1)\n327\t        before_stack_size = len(game.stack.objects())\n328\t        from engine.events import AttacksTriggeredEvent as ATE\n329\t        game.trigger_manager.fire_event(game, ATE(creature=other))\n330\t\n331\t        # Trigger should NOT have fired — stack unchanged\n332\t        assert len(game.stack.objects()) == before_stack_size\n333\t\n334\t\n335\t# ---------------------------------------------------------------------------\n336\t# Exile replacement effect\n337\t# ---------------------------------------------------------------------------\n338\t\n339\t\n340\tclass TestTheDawningArchaicExileReplacement:\n341\t    \"\"\"Instants/sorceries cast via the attack trigger go to exile, not graveyard.\"\"\"\n342\t\n343\t    def test_free_cast_spell_goes_to_exile_not_graveyard(self) -> None:\n344\t        \"\"\"A spell cast via the attack trigger and resolved goes to exile instead of graveyard.\"\"\"\n345\t        game = create_game()\n346\t        p1 = game.players[0]\n347\t        card = TheDawningArchaic(owner=p1, controller=p1)\n348\t        # The sorcery starts in the graveyard; after free-cast + resolve it should go to exile\n349\t        sorcery = Sorcery(name=\"Divination\", owner=p1)\n350\t        set_board_state(game, 0, graveyard=[sorcery])\n351\t        card.register_triggers(game)\n352\t\n353\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n354\t        attack_triggers = [\n355\t            t for t in triggers\n356\t            if issubclass(t.event_type, AttacksTriggeredEvent)\n357\t        ]\n358\t        assert len(attack_triggers) >= 1\n359\t        trigger = attack_triggers[0]\n360\t\n361\t        # Fire the trigger effect\n362\t        trigger.effect(game)\n363\t        # Resolve any items pushed onto the stack by the free-cast\n364\t        while not game.stack.is_empty():\n365\t            obj = game.stack.pop()\n366\t            obj.on_resolve(game)\n367\t\n368\t        # The spell must NOT be in the graveyard\n369\t        assert not game.get_graveyard(p1).contains(sorcery)\n370\t\n371\t    def test_free_cast_spell_is_in_exile_after_resolution(self) -> None:\n372\t        \"\"\"The spell cast via the trigger ends up in exile after resolving.\"\"\"\n373\t        game = create_game()\n374\t        p1 = game.players[0]\n375\t        card = TheDawningArchaic(owner=p1, controller=p1)\n376\t        instant = Instant(name=\"Lightning Bolt\", owner=p1)\n377\t        set_board_state(game, 0, graveyard=[instant])\n378\t        card.register_triggers(game)\n379\t\n380\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n381\t        attack_triggers = [\n382\t            t for t in triggers\n383\t            if issubclass(t.event_type, AttacksTriggeredEvent)\n384\t        ]\n385\t        assert len(attack_triggers) >= 1\n386\t        trigger = attack_triggers[0]\n387\t\n388\t        trigger.effect(game)\n389\t        # Resolve the free cast\n390\t        while not game.stack.is_empty():\n391\t            obj = game.stack.pop()\n392\t            obj.on_resolve(game)\n393\t\n394\t        # Spell must be in exile\n395\t        exile_zone = p1.zones[Zone.EXILE]\n396\t        assert exile_zone.contains(instant)\n397\t"}]},"parent_tool_use_id":"toolu_01A34n7tFhobSMjjakbUA9Uq","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"0fb18c2a-3172-4637-befd-597caa4316c8","timestamp":"2026-05-27T23:58:15.555Z","subagent_type":"Implementer","task_description":"Revision round for sos_1"}
