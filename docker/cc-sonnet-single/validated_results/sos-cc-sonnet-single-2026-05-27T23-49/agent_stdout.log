{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EAvJ52xRDyP1SKX2RwCLhT","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_57/card_impl.py b/cards/sos/sos_57/card_impl.py\n2\tindex 732a555..4c67c9e 100644\n3\t--- a/cards/sos/sos_57/card_impl.py\n4\t+++ b/cards/sos/sos_57/card_impl.py\n5\t@@ -1,16 +1,184 @@\n6\t-\"\"\"Card implementation for Mana Sculpt.\"\"\"\n7\t+\"\"\"Card implementation for Mana Sculpt (SOS 57).\"\"\"\n8\t \n9\t from __future__ import annotations\n10\t \n11\t-from engine.card import CardImpl\n12\t+from typing import TYPE_CHECKING, Any\n13\t \n14\t-from typing import TYPE_CHECKING\n15\t+from engine.card import Instant\n16\t+from engine.types import CardType, ManaCost, ManaType, TargetRequirement, Zone\n17\t \n18\t if TYPE_CHECKING:\n19\t     from engine.game_state import GameState\n20\t \n21\t \n22\t-class ManaSculpt(CardImpl):\n23\t-    \"\"\"TODO: Implement Mana Sculpt.\"\"\"\n24\t+def _get_chosen_target(card: Any, game: Any) -> Any:\n25\t+    \"\"\"Retrieve the first chosen target for a spell.\"\"\"\n26\t+    chosen = getattr(card, \"chosen_targets\", None)\n27\t+    if chosen:\n28\t+        return chosen[0]\n29\t+    return getattr(card, \"_resolve_target\", None)\n30\t \n31\t-    pass\n32\t+\n33\t+def _counter_spell(game: \"GameState\", stack_obj: Any) -> None:\n34\t+    \"\"\"Counter a spell — remove from stack and move card to graveyard.\"\"\"\n35\t+    from engine.stack import StackObject\n36\t+\n37\t+    if not isinstance(stack_obj, StackObject):\n38\t+        return\n39\t+\n40\t+    card = stack_obj.source\n41\t+\n42\t+    # Remove from the stack\n43\t+    stack_items = game.stack._items  # noqa: SLF001\n44\t+    found = False\n45\t+    for i, item in enumerate(stack_items):\n46\t+        if item is stack_obj:\n47\t+            stack_items.pop(i)\n48\t+            found = True\n49\t+            break\n50\t+\n51\t+    if not found:\n52\t+        return\n53\t+\n54\t+    controller = stack_obj.controller\n55\t+    owner = getattr(card, \"owner\", controller)\n56\t+\n57\t+    # Remove from the player's stack zone\n58\t+    if controller is not None:\n59\t+        stack_zone = controller.zones[Zone.STACK]\n60\t+        if stack_zone.contains(card):\n61\t+            stack_zone.remove(card)\n62\t+\n63\t+    # Move to owner's graveyard\n64\t+    if owner is not None:\n65\t+        graveyard = owner.zones[Zone.GRAVEYARD]\n66\t+        graveyard.add(card)\n67\t+\n68\t+\n69\t+def _controls_wizard(player: Any) -> bool:\n70\t+    \"\"\"Return True if *player* controls at least one Wizard on their battlefield.\"\"\"\n71\t+    try:\n72\t+        bf = player.zones[Zone.BATTLEFIELD]\n73\t+    except (KeyError, TypeError, AttributeError):\n74\t+        return False\n75\t+    for obj in bf.get_all():\n76\t+        subtypes = getattr(obj, \"subtypes\", set())\n77\t+        if \"Wizard\" in subtypes:\n78\t+            controller = getattr(obj, \"controller\", None)\n79\t+            # Only count if actually controlled by this player\n80\t+            if controller is None or controller is player:\n81\t+                return True\n82\t+    return False\n83\t+\n84\t+\n85\t+class ManaSculpt(Instant):\n86\t+    \"\"\"Mana Sculpt — {1}{U}{U} — Instant.\n87\t+\n88\t+    Counter target spell. If you control a Wizard, add an amount of {C}\n89\t+    equal to the amount of mana spent to cast that spell at the beginning\n90\t+    of your next main phase.\n91\t+\n92\t+    SOS collector number 57.\n93\t+    \"\"\"\n94\t+\n95\t+    def __init__(self, **kwargs: Any) -> None:\n96\t+        kwargs.setdefault(\"name\", \"Mana Sculpt\")\n97\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{U}{U}\"))\n98\t+        kwargs.setdefault(\n99\t+            \"rules_text\",\n100\t+            \"Counter target spell. If you control a Wizard, add an amount \"\n101\t+            \"of {C} equal to the amount of mana spent to cast that spell at \"\n102\t+            \"the beginning of your next main phase.\",\n103\t+        )\n104\t+        super().__init__(**kwargs)\n105\t+        # Tracks the amount of colorless mana to add at next main phase.\n106\t+        self.pending_mana_amount: int | None = None\n107\t+\n108\t+    def can_cast(self, game: \"GameState\") -> bool:\n109\t+        \"\"\"Can only cast if there is a valid target spell on the stack.\"\"\"\n110\t+        for stack_obj in game.stack.objects():\n111\t+            source = getattr(stack_obj, \"source\", None)\n112\t+            if source is self:\n113\t+                continue\n114\t+            # Any spell on the stack is a valid target\n115\t+            card_types = getattr(source, \"card_types\", set())\n116\t+            is_spell = bool(card_types - {CardType.LAND})\n117\t+            if is_spell:\n118\t+                return True\n119\t+        return False\n120\t+\n121\t+    def get_targets(self, game: \"GameState\") -> list[Any]:\n122\t+        \"\"\"Return a TargetRequirement for any spell on the stack.\"\"\"\n123\t+        source_self = self\n124\t+\n125\t+        def _filter(obj: Any) -> bool:\n126\t+            # Reject if this is ManaSculpt itself\n127\t+            src = getattr(obj, \"source\", obj)\n128\t+            if src is source_self:\n129\t+                return False\n130\t+            # Accept any StackObject whose source is a spell\n131\t+            from engine.stack import StackObject\n132\t+            if not isinstance(obj, StackObject):\n133\t+                return False\n134\t+            card_types = getattr(src, \"card_types\", set())\n135\t+            is_spell = bool(card_types - {CardType.LAND})\n136\t+            return is_spell\n137\t+\n138\t+        return [\n139\t+            TargetRequirement(\n140\t+                filter_fn=_filter,\n141\t+                description=\"target spell\",\n142\t+                zone=Zone.STACK,\n143\t+            )\n144\t+        ]\n145\t+\n146\t+    def on_resolve(self, game: \"GameState\") -> None:\n147\t+        \"\"\"Counter target spell. If you control a Wizard, schedule mana bonus.\"\"\"\n148\t+        target = _get_chosen_target(self, game)\n149\t+        if target is None:\n150\t+            return\n151\t+\n152\t+        # Get the CMC of the countered spell before countering\n153\t+        source_card = getattr(target, \"source\", None)\n154\t+        mana_cost = getattr(source_card, \"mana_cost\", None) if source_card is not None else None\n155\t+        cmc = mana_cost.cmc if mana_cost is not None else 0\n156\t+\n157\t+        # Counter the spell\n158\t+        _counter_spell(game, target)\n159\t+\n160\t+        # Check if controller controls a Wizard\n161\t+        controller = self.controller\n162\t+        if controller is None:\n163\t+            return\n164\t+\n165\t+        if not _controls_wizard(controller):\n166\t+            return\n167\t+\n168\t+        # Schedule the mana bonus at the beginning of next main phase\n169\t+        self.pending_mana_amount = cmc\n170\t+        spell_impl = self\n171\t+\n172\t+        from engine.events import BeginningOfMainPhaseTriggeredEvent\n173\t+        from engine.triggers import TriggerRegistration\n174\t+\n175\t+        def _condition(game: \"GameState\", event: BeginningOfMainPhaseTriggeredEvent) -> bool:\n176\t+            \"\"\"Only fire for the controller's main phase.\"\"\"\n177\t+            return event.player is controller\n178\t+\n179\t+        def _effect(game: \"GameState\") -> None:\n180\t+            \"\"\"Add the pending colorless mana to the controller's mana pool.\"\"\"\n181\t+            amount = getattr(spell_impl, \"pending_mana_amount\", 0) or 0\n182\t+            if amount > 0:\n183\t+                controller.mana_pool.add(ManaType.COLORLESS, amount)\n184\t+            # Unregister this trigger so it only fires once\n185\t+            game.trigger_manager.unregister(spell_impl)\n186\t+\n187\t+        game.trigger_manager.register(\n188\t+            TriggerRegistration(\n189\t+                event_type=BeginningOfMainPhaseTriggeredEvent,\n190\t+                condition=_condition,\n191\t+                effect=_effect,\n192\t+                source=spell_impl,\n193\t+                controller=controller,\n194\t+            )\n195\t+        )\n196\tdiff --git a/engine/events.py b/engine/events.py\n197\tindex 9f38fa2..d0289c6 100644\n198\t--- a/engine/events.py\n199\t+++ b/engine/events.py\n200\t@@ -119,6 +119,13 @@ class CounterAddedTriggeredEvent(TriggeredEvent):\n201\t     amount: int = 0\n202\t \n203\t \n204\t+@dataclass\n205\t+class BeginningOfMainPhaseTriggeredEvent(TriggeredEvent):\n206\t+    \"\"\"Fired at the start of the PRECOMBAT_MAIN phase.\"\"\"\n207\t+\n208\t+    player: Any = None\n209\t+\n210\t+\n211\t # ---------------------------------------------------------------------------\n212\t # Replacement events\n213\t # ---------------------------------------------------------------------------\n214\tdiff --git a/engine/turn.py b/engine/turn.py\n215\tindex e400349..a9852f2 100644\n216\t--- a/engine/turn.py\n217\t+++ b/engine/turn.py\n218\t@@ -202,6 +202,11 @@ def run_turn(game: GameState) -> None:\n219\t         elif current == (Phase.BEGINNING, Step.UPKEEP):\n220\t             from engine.events import BeginningOfUpkeepTriggeredEvent\n221\t             game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n222\t+        elif current == (Phase.PRECOMBAT_MAIN, None):\n223\t+            from engine.events import BeginningOfMainPhaseTriggeredEvent\n224\t+            game.trigger_manager.fire_event(\n225\t+                game, BeginningOfMainPhaseTriggeredEvent(player=game.active_player)\n226\t+            )\n227\t         elif current == (Phase.BEGINNING, Step.DRAW):\n228\t             _do_draw_step(game)\n229\t         elif game.phase == Phase.COMBAT and game.step is not None:\n230\tdiff --git a/run_manifest.json b/run_manifest.json\n231\tindex f6735dd..2ebf927 100644\n232\t--- a/run_manifest.json\n233\t+++ b/run_manifest.json\n234\t@@ -1,6 +1,8 @@\n235\t {\n236\t-  \"benchmark_set\": \"sos\",\n237\t-  \"cards\": [\n238\t+  \"timeout_seconds\": 360000,\n239\t+  \"deadline_utc\": \"2026-06-01T03:49:39Z\",\n240\t+  \"docker_image\": \"silverquillm-cc-sonnet-single:latest\",\n241\t+  \"card_filter\": [\n242\t     \"1\",\n243\t     \"4\",\n244\t     \"13\",\n245\t@@ -11,5 +13,6 @@\n246\t     \"226\",\n247\t     \"245\",\n248\t     \"257\"\n249\t-  ]\n250\t-}\n251\t\\ No newline at end of file\n252\t+  ],\n253\t+  \"benchmark_set\": \"sos\"\n254\t+}\n255\t"}]},"parent_tool_use_id":"toolu_01HHrusMb65YDLKTUU3AyBr2","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"ecf15dd2-f4f2-460e-8c48-7c69b58f127e","timestamp":"2026-05-28T00:31:22.661Z","subagent_type":"Reviewer","task_description":"Reviewer for sos_57"}
