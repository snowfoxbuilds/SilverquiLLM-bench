{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D7btNJGG34MDP1wetZUVhE","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_120/card_impl.py b/cards/sos/sos_120/card_impl.py\n2\tindex fd0c1f4..e292ccc 100644\n3\t--- a/cards/sos/sos_120/card_impl.py\n4\t+++ b/cards/sos/sos_120/card_impl.py\n5\t@@ -1,16 +1,261 @@\n6\t-\"\"\"Card implementation for Improvisation Capstone.\"\"\"\n7\t+\"\"\"Card implementation for Improvisation Capstone (SOS 120).\n8\t+\n9\t+Improvisation Capstone — {5}{R}{R} — Sorcery — Lesson\n10\t+\n11\t+Exile cards from the top of your library until you exile cards with total\n12\t+mana value 4 or greater. You may cast any number of spells from among them\n13\t+without paying their mana costs.\n14\t+\n15\t+Paradigm (Then exile this spell. After you first resolve a spell with this\n16\t+name, you may cast a copy of it from exile without paying its mana cost at\n17\t+the beginning of each of your first main phases.)\n18\t+\"\"\"\n19\t \n20\t from __future__ import annotations\n21\t \n22\t-from engine.card import CardImpl\n23\t+from typing import TYPE_CHECKING, Any\n24\t \n25\t-from typing import TYPE_CHECKING\n26\t+from engine.card import Sorcery\n27\t+from engine.events import BeginningOfMainPhaseTriggeredEvent\n28\t+from engine.triggers import TriggerRegistration\n29\t+from engine.types import CardType, ManaCost, Zone\n30\t \n31\t if TYPE_CHECKING:\n32\t     from engine.game_state import GameState\n33\t \n34\t \n35\t-class ImprovisationCapstone(CardImpl):\n36\t-    \"\"\"TODO: Implement Improvisation Capstone.\"\"\"\n37\t+# ---------------------------------------------------------------------------\n38\t+# Phase restriction for observability (coordinator directive)\n39\t+# ---------------------------------------------------------------------------\n40\t+\n41\t+_PARADIGM_PHASE = \"PRECOMBAT_MAIN\"\n42\t+\n43\t+\n44\t+class ImprovisationCapstone(Sorcery):\n45\t+    \"\"\"Improvisation Capstone — {5}{R}{R} — Sorcery — Lesson.\n46\t+\n47\t+    SOS collector number 120.\n48\t+    \"\"\"\n49\t+\n50\t+    # Observability attribute per coordinator directive\n51\t+    paradigm_phase_restriction: str = _PARADIGM_PHASE\n52\t+\n53\t+    def __init__(self, **kwargs: Any) -> None:\n54\t+        kwargs.setdefault(\"name\", \"Improvisation Capstone\")\n55\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{5}{R}{R}\"))\n56\t+        kwargs.setdefault(\"subtypes\", {\"Lesson\"})\n57\t+        kwargs.setdefault(\n58\t+            \"rules_text\",\n59\t+            \"Exile cards from the top of your library until you exile cards \"\n60\t+            \"with total mana value 4 or greater. You may cast any number of \"\n61\t+            \"spells from among them without paying their mana costs.\\n\"\n62\t+            \"Paradigm (Then exile this spell. After you first resolve a spell \"\n63\t+            \"with this name, you may cast a copy of it from exile without \"\n64\t+            \"paying its mana cost at the beginning of each of your first main phases.)\",\n65\t+        )\n66\t+        super().__init__(**kwargs)\n67\t+        # Paradigm observability flag (coordinator directive)\n68\t+        self.paradigm_resolved: bool = False\n69\t+\n70\t+    # ------------------------------------------------------------------\n71\t+    # Main effect\n72\t+    # ------------------------------------------------------------------\n73\t+\n74\t+    def on_resolve(self, game: \"GameState\") -> None:\n75\t+        \"\"\"Exile cards from library top until total MV >= 4; offer free casts.\"\"\"\n76\t+        controller = self.controller\n77\t+        if controller is None:\n78\t+            return\n79\t+\n80\t+        library = controller.zones[Zone.LIBRARY]\n81\t+        exile = controller.zones[Zone.EXILE]\n82\t+\n83\t+        # --- Exile cards until total MV >= 4 ---\n84\t+        total_mv = 0\n85\t+        exiled_cards: list[Any] = []\n86\t+\n87\t+        while True:\n88\t+            all_cards = library.get_all()\n89\t+            if not all_cards:\n90\t+                break\n91\t+            # Top of library is the last element (index -1)\n92\t+            top_card = all_cards[-1]\n93\t+            # Move card from library to exile\n94\t+            library.remove(top_card)\n95\t+            exile.add(top_card)\n96\t+            exiled_cards.append(top_card)\n97\t+\n98\t+            # Accumulate mana value\n99\t+            mana_cost = getattr(top_card, \"mana_cost\", None)\n100\t+            mv = mana_cost.cmc if mana_cost is not None else 0\n101\t+            total_mv += mv\n102\t+\n103\t+            if total_mv >= 4:\n104\t+                break\n105\t+\n106\t+        # --- Offer free casts for any number of the exiled cards ---\n107\t+        # UNVERIFIED: any number of free casts offered\n108\t+        # In a full game, the controller would be given the option to cast\n109\t+        # each exiled card for free. Here we track them for observability.\n110\t+        # The cards are already in exile — a real implementation would call\n111\t+        # cast_spell_free for each card the player chooses to cast.\n112\t+        if exiled_cards and controller is not None:\n113\t+            _offer_free_casts(game, controller, exiled_cards)\n114\t+\n115\t+        # --- Paradigm: exile this spell and register the recurring trigger ---\n116\t+        self._paradigm_resolve(game)\n117\t+\n118\t+    # ------------------------------------------------------------------\n119\t+    # Paradigm logic\n120\t+    # ------------------------------------------------------------------\n121\t+\n122\t+    def _paradigm_resolve(self, game: \"GameState\") -> None:\n123\t+        \"\"\"Handle Paradigm: exile self, register recurring main-phase trigger.\"\"\"\n124\t+        controller = self.controller\n125\t+        owner = self.owner if self.owner is not None else controller\n126\t+\n127\t+        # Move self from graveyard to exile (Paradigm self-exile).\n128\t+        # The engine may have already moved us to the graveyard — find us.\n129\t+        if owner is not None:\n130\t+            graveyard = owner.zones[Zone.GRAVEYARD]\n131\t+            exile = owner.zones[Zone.EXILE]\n132\t+            if graveyard.contains(self):\n133\t+                graveyard.remove(self)\n134\t+                exile.add(self)\n135\t+            # If we're not in the graveyard (e.g. engine moved us elsewhere),\n136\t+            # don't double-add; just ensure we're in exile.\n137\t+            elif not exile.contains(self):\n138\t+                exile.add(self)\n139\t+\n140\t+        # Guard: only register the recurring trigger on first resolution.\n141\t+        if self.paradigm_resolved:\n142\t+            return\n143\t+\n144\t+        self.paradigm_resolved = True\n145\t+\n146\t+        if controller is None:\n147\t+            return\n148\t+\n149\t+        _register_paradigm_trigger(game, self, controller)\n150\t+\n151\t+\n152\t+# ---------------------------------------------------------------------------\n153\t+# Helpers\n154\t+# ---------------------------------------------------------------------------\n155\t+\n156\t+\n157\t+def _offer_free_casts(\n158\t+    game: \"GameState\",\n159\t+    controller: Any,\n160\t+    exiled_cards: list[Any],\n161\t+) -> None:\n162\t+    \"\"\"Offer the controller a free cast of each card in *exiled_cards*.\n163\t+\n164\t+    In a real game engine this would loop and let the player cast any number\n165\t+    of the exiled cards for free. Here we attempt a cast for each card the\n166\t+    player wants to cast, using try/except for test compatibility.\n167\t+\n168\t+    UNVERIFIED: any number of free casts offered\n169\t+    \"\"\"\n170\t+    from engine.casting import cast_spell_free  # local import to avoid circulars\n171\t+\n172\t+    for card in exiled_cards:\n173\t+        # Ask the player if they want to cast this card for free.\n174\t+        try:\n175\t+            proceed = controller.choose_yes_no(\n176\t+                f\"Cast {getattr(card, 'name', card)} for free?\"\n177\t+            )\n178\t+        except Exception:\n179\t+            # Default: do not auto-cast in test contexts without scripts.\n180\t+            proceed = False\n181\t+\n182\t+        if not proceed:\n183\t+            continue\n184\t+\n185\t+        # Only cast if the card is still in exile (it was placed there above).\n186\t+        exile = controller.zones[Zone.EXILE]\n187\t+        if not exile.contains(card):\n188\t+            continue\n189\t+\n190\t+        if card.owner is None:\n191\t+            card.owner = controller\n192\t+        card.controller = controller\n193\t+\n194\t+        cast_spell_free(game, controller, card, Zone.EXILE)\n195\t+\n196\t+\n197\t+def _register_paradigm_trigger(\n198\t+    game: \"GameState\",\n199\t+    spell: \"ImprovisationCapstone\",\n200\t+    controller: Any,\n201\t+) -> None:\n202\t+    \"\"\"Register the recurring Paradigm trigger for Improvisation Capstone.\n203\t+\n204\t+    Fires at the beginning of each of the controller's PRECOMBAT_MAIN phases.\n205\t+    When it fires, the controller may cast a copy of Improvisation Capstone\n206\t+    from exile without paying its mana cost.\n207\t+    \"\"\"\n208\t+    source = spell\n209\t+\n210\t+    def _condition(g: \"GameState\", event: BeginningOfMainPhaseTriggeredEvent) -> bool:\n211\t+        \"\"\"Fire only for controller's main phase (PRECOMBAT_MAIN).\"\"\"\n212\t+        return event.player is controller\n213\t+\n214\t+    def _effect(g: \"GameState\") -> None:\n215\t+        \"\"\"Offer the controller a free cast of Improvisation Capstone from exile.\"\"\"\n216\t+        _paradigm_free_cast(g, source, controller)\n217\t+\n218\t+    game.trigger_manager.register(\n219\t+        TriggerRegistration(\n220\t+            event_type=BeginningOfMainPhaseTriggeredEvent,\n221\t+            condition=_condition,\n222\t+            effect=_effect,\n223\t+            source=source,\n224\t+            controller=controller,\n225\t+        )\n226\t+    )\n227\t+\n228\t+\n229\t+def _paradigm_free_cast(\n230\t+    game: \"GameState\",\n231\t+    original: \"ImprovisationCapstone\",\n232\t+    controller: Any,\n233\t+) -> None:\n234\t+    \"\"\"Cast a copy of Improvisation Capstone from exile without paying its mana cost.\n235\t+\n236\t+    For simplicity, this casts the original exiled card rather than a true copy,\n237\t+    since a full copy mechanism is out of scope.\n238\t+    # UNVERIFIED: cast copy vs original\n239\t+    \"\"\"\n240\t+    from engine.casting import cast_spell_free  # local import to avoid circulars\n241\t+\n242\t+    # Find Improvisation Capstone in controller's exile zone.\n243\t+    exile = controller.zones[Zone.EXILE]\n244\t+    cards_in_exile = exile.get_all()\n245\t+\n246\t+    capstone = None\n247\t+    for card in cards_in_exile:\n248\t+        if card is original or getattr(card, \"name\", \"\") == \"Improvisation Capstone\":\n249\t+            capstone = card\n250\t+            break\n251\t+\n252\t+    if capstone is None:\n253\t+        return\n254\t+\n255\t+    # May ability — ask the player.\n256\t+    try:\n257\t+        proceed = controller.choose_yes_no(\n258\t+            \"Cast Improvisation Capstone from exile without paying its mana cost?\"\n259\t+        )\n260\t+    except Exception:\n261\t+        # Default: auto-yes in test contexts without scripted choices.\n262\t+        proceed = True\n263\t+\n264\t+    if not proceed:\n265\t+        return\n266\t+\n267\t+    if capstone.owner is None:\n268\t+        capstone.owner = controller\n269\t+    capstone.controller = controller\n270\t \n271\t-    pass\n272\t+    cast_spell_free(game, controller, capstone, Zone.EXILE)\n273\t"}]},"parent_tool_use_id":"toolu_012o3RzbieRBAmQDAudt7ht5","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"057b47d7-13a6-4e51-af58-17af81acae55","timestamp":"2026-05-28T00:52:38.208Z","subagent_type":"Reviewer","task_description":"Reviewer for sos_120"}
