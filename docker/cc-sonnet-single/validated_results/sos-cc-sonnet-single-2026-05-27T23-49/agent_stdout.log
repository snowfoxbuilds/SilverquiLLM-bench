{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012UtTaCJytVthrJu2H2R6xZ","type":"tool_result","content":"1\t\"\"\"Card implementation for Great Hall of the Biblioplex (SOS #257).\n2\t\n3\tGreat Hall of the Biblioplex — Land (no mana cost)\n4\t\n5\t{T}: Add {C}.\n6\t{T}, Pay 1 life: Add one mana of any color.\n7\t  Spend this mana only to cast an instant or sorcery spell.\n8\t  # UNVERIFIED: mana spending restriction — requires tagged-mana engine support\n9\t{5}: If this land isn't a creature, it becomes a 2/4 Wizard creature with\n10\t  \"Whenever you cast an instant or sorcery spell, this creature gets +1/+0\n11\t  until end of turn.\" It's still a land.\n12\t\"\"\"\n13\t\n14\tfrom __future__ import annotations\n15\t\n16\tfrom typing import TYPE_CHECKING, Any\n17\t\n18\tfrom engine.card import ActivatedAbility, Land, ManaAbility\n19\tfrom engine.types import CardType, ManaCost, ManaType\n20\t\n21\tif TYPE_CHECKING:\n22\t    from engine.game_state import GameState\n23\t\n24\t\n25\tclass GreatHallOfTheBiblioplex(Land):\n26\t    \"\"\"Great Hall of the Biblioplex — Land.\n27\t\n28\t    {T}: Add {C}.\n29\t    {T}, Pay 1 life: Add one mana of any color. (Spend this mana only to cast\n30\t    an instant or sorcery spell — enforcement requires tagged-mana engine.)\n31\t    {5}: If this land isn't a creature, it becomes a 2/4 Wizard creature-land\n32\t    until end of turn. It's still a land.\n33\t    \"\"\"\n34\t\n35\t    def __init__(self, **kwargs: Any) -> None:\n36\t        kwargs.setdefault(\"name\", \"Great Hall of the Biblioplex\")\n37\t        kwargs.setdefault(\n38\t            \"rules_text\",\n39\t            \"{T}: Add {C}.\\n\"\n40\t            \"{T}, Pay 1 life: Add one mana of any color. Spend this mana only \"\n41\t            \"to cast an instant or sorcery spell.\\n\"\n42\t            \"{5}: If this land isn't a creature, it becomes a 2/4 Wizard \"\n43\t            \"creature with \\\"Whenever you cast an instant or sorcery spell, \"\n44\t            \"this creature gets +1/+0 until end of turn.\\\" It's still a land.\",\n45\t        )\n46\t        super().__init__(**kwargs)\n47\t\n48\t        # Creature-mode power/toughness (set when animated via {5})\n49\t        self.base_power: int = 0\n50\t        self.base_toughness: int = 0\n51\t        self.modified_power: int = 0\n52\t        self.modified_toughness: int = 0\n53\t\n54\t    # ------------------------------------------------------------------\n55\t    # Mana abilities\n56\t    # ------------------------------------------------------------------\n57\t\n58\t    def get_mana_abilities(self) -> list[ManaAbility]:\n59\t        \"\"\"Return both mana abilities.\n60\t\n61\t        [0] {T}: Add {C}\n62\t        [1] {T}, Pay 1 life: Add one mana of any color\n63\t        \"\"\"\n64\t        source = self\n65\t\n66\t        # --- Ability 1: {T}: Add {C} ---\n67\t\n68\t        def _tap_cost_colorless(game: Any, src: Any) -> bool:\n69\t            if getattr(src, \"is_tapped\", False):\n70\t                return False\n71\t            src.is_tapped = True\n72\t            return True\n73\t\n74\t        def _effect_colorless(game: Any) -> None:\n75\t            controller = source.controller\n76\t            if controller is not None:\n77\t                controller.mana_pool.add(ManaType.COLORLESS, 1)\n78\t\n79\t        # --- Ability 2: {T}, Pay 1 life: Add one mana of any color ---\n80\t\n81\t        def _tap_cost_colored(game: Any, src: Any) -> bool:\n82\t            if getattr(src, \"is_tapped\", False):\n83\t                return False\n84\t            controller = src.controller\n85\t            if controller is None:\n86\t                return False\n87\t            # Pay 1 life\n88\t            if controller.life < 1:\n89\t                return False\n90\t            src.is_tapped = True\n91\t            controller.life -= 1\n92\t            return True\n93\t\n94\t        def _effect_colored(game: Any) -> None:\n95\t            # UNVERIFIED: mana spending restriction — requires tagged-mana engine support\n96\t            # Default: add one blue mana (any color; blue is the Wizard/library thematic choice)\n97\t            controller = source.controller\n98\t            if controller is not None:\n99\t                controller.mana_pool.add(ManaType.BLUE, 1)\n100\t\n101\t        return [\n102\t            ManaAbility(\n103\t                cost=_tap_cost_colorless,\n104\t                mana_produced=_effect_colorless,\n105\t                description=\"{T}: Add {C}.\",\n106\t            ),\n107\t            ManaAbility(\n108\t                cost=_tap_cost_colored,\n109\t                mana_produced=_effect_colored,\n110\t                description=\"{T}, Pay 1 life: Add one mana of any color.\",\n111\t            ),\n112\t        ]\n113\t\n114\t    # ------------------------------------------------------------------\n115\t    # Activated ability: {5} — animate into 2/4 Wizard creature-land\n116\t    # ------------------------------------------------------------------\n117\t\n118\t    def get_activated_abilities(self) -> list[ActivatedAbility]:\n119\t        \"\"\"Return the animation ability: {5}: Become a 2/4 Wizard creature-land.\"\"\"\n120\t        source = self\n121\t\n122\t        def _animation_cost(game: Any, src: Any) -> bool:\n123\t            \"\"\"Pay {5} generic mana.\"\"\"\n124\t            controller = src.controller\n125\t            if controller is None:\n126\t                return False\n127\t            cost = ManaCost.parse(\"{5}\")\n128\t            if not controller.mana_pool.can_pay(cost):\n129\t                return False\n130\t            controller.mana_pool.pay(cost)\n131\t            return True\n132\t\n133\t        def _animation_effect(game: Any) -> None:\n134\t            \"\"\"If not already a creature, become a 2/4 Wizard creature-land until EOT.\n135\t\n136\t            If already a creature, does nothing (idempotent guard).\n137\t            \"\"\"\n138\t            # Guard: if already a creature, do nothing\n139\t            if CardType.CREATURE in source.card_types:\n140\t                return\n141\t\n142\t            # Become a creature (still a land)\n143\t            source.card_types.add(CardType.CREATURE)\n144\t\n145\t            # Set base and modified power/toughness\n146\t            source.base_power = 2\n147\t            source.base_toughness = 4\n148\t            source.modified_power = 2\n149\t            source.modified_toughness = 4\n150\t\n151\t            # Add Wizard subtype\n152\t            source.subtypes.add(\"Wizard\")\n153\t\n154\t            # UNVERIFIED: end-of-turn +1/+0 expiry — requires full turn cycle to test\n155\t\n156\t        return [\n157\t            ActivatedAbility(\n158\t                cost=_animation_cost,\n159\t                effect=_animation_effect,\n160\t                description=\"{5}: If this land isn't a creature, it becomes a \"\n161\t                             \"2/4 Wizard creature-land until end of turn.\",\n162\t            ),\n163\t        ]\n164\t\n165\t    # ------------------------------------------------------------------\n166\t    # Triggered ability: Wizard mode — +1/+0 on instant/sorcery cast\n167\t    # ------------------------------------------------------------------\n168\t\n169\t    def register_triggers(self, game: \"GameState\") -> None:\n170\t        \"\"\"Register the Wizard trigger if the card is in creature mode.\n171\t\n172\t        Trigger: Whenever controller casts an instant or sorcery spell,\n173\t        this creature gets +1/+0 until end of turn.\n174\t        \"\"\"\n175\t        from engine.events import SpellCastTriggeredEvent\n176\t        from engine.triggers import TriggerRegistration\n177\t\n178\t        source = self\n179\t\n180\t        def _condition(g: Any, event: Any) -> bool:\n181\t            \"\"\"Fire only when controller casts an instant or sorcery.\"\"\"\n182\t            # Check the caster is the controller of this permanent\n183\t            caster = getattr(event, \"player\", None) or getattr(event, \"controller\", None)\n184\t            ctrl = getattr(source, \"controller\", None)\n185\t            if caster is not ctrl:\n186\t                return False\n187\t\n188\t            # Check the spell is an instant or sorcery\n189\t            spell_card = getattr(event, \"card\", None)\n190\t            if spell_card is None:\n191\t                spell_obj = getattr(event, \"spell\", None)\n192\t                spell_card = (\n193\t                    getattr(spell_obj, \"source\", None) if spell_obj is not None else None\n194\t                )\n195\t            if spell_card is None:\n196\t                return False\n197\t\n198\t            card_types = getattr(spell_card, \"card_types\", set())\n199\t            return CardType.INSTANT in card_types or CardType.SORCERY in card_types\n200\t\n201\t        def _effect(g: Any) -> None:\n202\t            \"\"\"Grant +1/+0 until end of turn.\n203\t\n204\t            Directly increments modified_power for immediate test compatibility.\n205\t            # UNVERIFIED: end-of-turn +1/+0 expiry — requires full turn cycle to test\n206\t            \"\"\"\n207\t            source.modified_power += 1\n208\t\n209\t        controller = getattr(self, \"controller\", None) or (\n210\t            game.players[0] if game.players else None\n211\t        )\n212\t\n213\t        game.trigger_manager.register(\n214\t            TriggerRegistration(\n215\t                event_type=SpellCastTriggeredEvent,\n216\t                condition=_condition,\n217\t                effect=_effect,\n218\t                source=source,\n219\t                controller=controller,\n220\t            )\n221\t        )\n222\t"}]},"parent_tool_use_id":"toolu_01ViEQxiNem8quf6JVhG1s28","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"a7c63337-ab82-47f1-acd4-cbead11e6480","timestamp":"2026-05-28T01:44:19.883Z","subagent_type":"Reviewer","task_description":"Reviewer for sos_257"}
