{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TbjuFumjjWu5nZLw3hm64M","type":"tool_result","content":"1\t\"\"\"Tests for SOS 120 — Improvisation Capstone.\n2\t\n3\tCovers:\n4\t- Static card properties (name, mana cost, card type, subtype, color)\n5\t- Main effect: exile cards from library top until total mana value >= 4\n6\t- All exiled cards may be cast without paying their mana costs\n7\t- Empty library does not crash\n8\t- Single card with MV >= 4 stops immediately\n9\t- Multiple cards with MV < 4 each accumulate until threshold reached\n10\t- Cards beyond the threshold are NOT exiled\n11\t- Paradigm: card is exiled on resolution (not moved to graveyard)\n12\t- Paradigm: paradigm_resolved flag or equivalent is set after first resolution\n13\t- Paradigm: trigger for main phase free-cast of copy is registered after first resolution\n14\t- The free-casts offered are \"any number\" (not forced, not limited to one)\n15\t\"\"\"\n16\t\n17\tfrom __future__ import annotations\n18\t\n19\timport pytest\n20\t\n21\tfrom cards.sos.sos_120.card_impl import ImprovisationCapstone\n22\tfrom engine.card import Creature, Instant, Sorcery, Land, Enchantment\n23\tfrom engine.events import BeginningOfMainPhaseTriggeredEvent\n24\tfrom engine.types import CardType, ManaCost, ManaType, Zone\n25\tfrom test_utils import create_game, set_board_state\n26\t\n27\t\n28\t# ---------------------------------------------------------------------------\n29\t# Helpers\n30\t# ---------------------------------------------------------------------------\n31\t\n32\tdef _make_sorcery(name: str = \"Test Sorcery\", cmc: int = 0) -> Sorcery:\n33\t    \"\"\"Create a Sorcery with a specified CMC (generic mana cost).\"\"\"\n34\t    return Sorcery(name=name, mana_cost=ManaCost(generic=cmc))\n35\t\n36\t\n37\tdef _make_instant(name: str = \"Test Instant\", cmc: int = 0) -> Instant:\n38\t    \"\"\"Create an Instant with a specified CMC (generic mana cost).\"\"\"\n39\t    return Instant(name=name, mana_cost=ManaCost(generic=cmc))\n40\t\n41\t\n42\tdef _make_creature(name: str = \"Test Creature\", cmc: int = 2) -> Creature:\n43\t    \"\"\"Create a Creature with a specified CMC.\"\"\"\n44\t    return Creature(name=name, mana_cost=ManaCost(generic=cmc), base_power=1, base_toughness=1)\n45\t\n46\t\n47\tdef _library_zone(game, player_idx: int):\n48\t    return game.players[player_idx].zones[Zone.LIBRARY]\n49\t\n50\t\n51\tdef _exile_zone(game, player_idx: int):\n52\t    return game.players[player_idx].zones[Zone.EXILE]\n53\t\n54\t\n55\tdef _graveyard_zone(game, player_idx: int):\n56\t    return game.players[player_idx].zones[Zone.GRAVEYARD]\n57\t\n58\t\n59\t# ---------------------------------------------------------------------------\n60\t# Static card property tests\n61\t# ---------------------------------------------------------------------------\n62\t\n63\t\n64\tclass TestImprovisationCapstoneProperties:\n65\t    \"\"\"Static card data should match the SOS 120 spec.\"\"\"\n66\t\n67\t    def test_is_sorcery(self) -> None:\n68\t        card = ImprovisationCapstone(owner=None)\n69\t        assert isinstance(card, Sorcery)\n70\t\n71\t    def test_name(self) -> None:\n72\t        card = ImprovisationCapstone(owner=None)\n73\t        assert card.name == \"Improvisation Capstone\"\n74\t\n75\t    def test_mana_cost(self) -> None:\n76\t        card = ImprovisationCapstone(owner=None)\n77\t        assert card.mana_cost == ManaCost.parse(\"{5}{R}{R}\")\n78\t\n79\t    def test_sorcery_card_type(self) -> None:\n80\t        card = ImprovisationCapstone(owner=None)\n81\t        assert CardType.SORCERY in card.card_types\n82\t\n83\t    def test_lesson_subtype(self) -> None:\n84\t        card = ImprovisationCapstone(owner=None)\n85\t        assert \"Lesson\" in card.subtypes\n86\t\n87\t\n88\t# ---------------------------------------------------------------------------\n89\t# Main effect: exile cards until total MV >= 4\n90\t# ---------------------------------------------------------------------------\n91\t\n92\t\n93\tclass TestImprovisationCapstoneExileEffect:\n94\t    \"\"\"on_resolve exiles cards from the library top until total MV >= 4.\"\"\"\n95\t\n96\t    def test_single_card_mv4_is_exiled(self) -> None:\n97\t        \"\"\"A card with MV exactly 4 stops exiling after one card.\"\"\"\n98\t        game = create_game()\n99\t        p1 = game.players[0]\n100\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n101\t        card4 = _make_creature(\"Big Spell\", cmc=4)\n102\t        p1.zones[Zone.LIBRARY].add(card4)\n103\t\n104\t        spell.on_resolve(game)\n105\t\n106\t        assert _exile_zone(game, 0).contains(card4)\n107\t        assert not _library_zone(game, 0).contains(card4)\n108\t\n109\t    def test_single_card_mv_above_4_is_exiled(self) -> None:\n110\t        \"\"\"A single card with MV > 4 is exiled and stops iteration.\"\"\"\n111\t        game = create_game()\n112\t        p1 = game.players[0]\n113\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n114\t        card6 = _make_creature(\"Giant\", cmc=6)\n115\t        p1.zones[Zone.LIBRARY].add(card6)\n116\t\n117\t        spell.on_resolve(game)\n118\t\n119\t        assert _exile_zone(game, 0).contains(card6)\n120\t\n121\t    def test_two_cards_summing_to_mv4_are_both_exiled(self) -> None:\n122\t        \"\"\"Two cards each with MV 2 sum to 4 — both are exiled, no more.\"\"\"\n123\t        game = create_game()\n124\t        p1 = game.players[0]\n125\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n126\t        card_a = _make_creature(\"Card A\", cmc=2)\n127\t        card_b = _make_creature(\"Card B\", cmc=2)\n128\t        card_c = _make_creature(\"Card C\", cmc=3)\n129\t        # Stack top-to-bottom: card_a is first revealed (top of library)\n130\t        p1.zones[Zone.LIBRARY].add(card_c)  # bottom\n131\t        p1.zones[Zone.LIBRARY].add(card_b)  # middle\n132\t        p1.zones[Zone.LIBRARY].add(card_a)  # top\n133\t\n134\t        spell.on_resolve(game)\n135\t\n136\t        # card_a (2) + card_b (2) = 4, threshold met; card_c should NOT be exiled\n137\t        assert _exile_zone(game, 0).contains(card_a)\n138\t        assert _exile_zone(game, 0).contains(card_b)\n139\t        assert not _exile_zone(game, 0).contains(card_c)\n140\t        assert _library_zone(game, 0).contains(card_c)\n141\t\n142\t    def test_card_mv_exactly_4_stops_after_one_card(self) -> None:\n143\t        \"\"\"After exiling exactly one card with MV 4, no further exiling occurs.\"\"\"\n144\t        game = create_game()\n145\t        p1 = game.players[0]\n146\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n147\t        card4 = _make_creature(\"Threshold\", cmc=4)\n148\t        extra = _make_creature(\"Extra\", cmc=1)\n149\t        p1.zones[Zone.LIBRARY].add(extra)   # bottom\n150\t        p1.zones[Zone.LIBRARY].add(card4)   # top\n151\t\n152\t        spell.on_resolve(game)\n153\t\n154\t        assert _exile_zone(game, 0).contains(card4)\n155\t        assert not _exile_zone(game, 0).contains(extra)\n156\t\n157\t    def test_zero_mv_cards_all_exiled_when_library_runs_out(self) -> None:\n158\t        \"\"\"If library has only zero-MV cards, all are exiled (threshold never met).\"\"\"\n159\t        game = create_game()\n160\t        p1 = game.players[0]\n161\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n162\t        zero_cards = [Sorcery(name=f\"Pact{i}\", mana_cost=ManaCost()) for i in range(3)]\n163\t        for c in zero_cards:\n164\t            p1.zones[Zone.LIBRARY].add(c)\n165\t\n166\t        spell.on_resolve(game)\n167\t\n168\t        for c in zero_cards:\n169\t            assert _exile_zone(game, 0).contains(c)\n170\t        assert len(_library_zone(game, 0).get_all()) == 0\n171\t\n172\t    def test_empty_library_does_not_raise(self) -> None:\n173\t        \"\"\"Resolving with an empty library should not raise an exception.\"\"\"\n174\t        game = create_game()\n175\t        p1 = game.players[0]\n176\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n177\t\n178\t        # Should not raise\n179\t        spell.on_resolve(game)\n180\t\n181\t    def test_mv1_mv1_mv2_all_exiled_at_threshold(self) -> None:\n182\t        \"\"\"Cards with MV 1, 1, 2 sum to 4 — all three are exiled.\"\"\"\n183\t        game = create_game()\n184\t        p1 = game.players[0]\n185\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n186\t        card1a = _make_instant(\"Spell1a\", cmc=1)\n187\t        card1b = _make_instant(\"Spell1b\", cmc=1)\n188\t        card2 = _make_sorcery(\"Spell2\", cmc=2)\n189\t        extra = _make_creature(\"Extra\", cmc=5)\n190\t        # Add in reverse order so card1a is on top\n191\t        p1.zones[Zone.LIBRARY].add(extra)   # bottom\n192\t        p1.zones[Zone.LIBRARY].add(card2)   # middle\n193\t        p1.zones[Zone.LIBRARY].add(card1b)  # second from top\n194\t        p1.zones[Zone.LIBRARY].add(card1a)  # top\n195\t\n196\t        spell.on_resolve(game)\n197\t\n198\t        assert _exile_zone(game, 0).contains(card1a)\n199\t        assert _exile_zone(game, 0).contains(card1b)\n200\t        assert _exile_zone(game, 0).contains(card2)\n201\t        # extra should NOT be exiled — threshold reached before it\n202\t        assert not _exile_zone(game, 0).contains(extra)\n203\t\n204\t\n205\t# ---------------------------------------------------------------------------\n206\t# Free-cast from exile\n207\t# ---------------------------------------------------------------------------\n208\t\n209\t\n210\tclass TestImprovisationCapstoneFreecast:\n211\t    \"\"\"Cards exiled by the effect may be cast without paying mana costs.\"\"\"\n212\t\n213\t    def test_exiled_cards_can_be_cast_free(self) -> None:\n214\t        \"\"\"After resolution, exiled cards are accessible for free-cast.\"\"\"\n215\t        game = create_game()\n216\t        p1 = game.players[0]\n217\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n218\t        sorcery_card = _make_sorcery(\"Free Sorcery\", cmc=5)\n219\t        p1.zones[Zone.LIBRARY].add(sorcery_card)\n220\t\n221\t        spell.on_resolve(game)\n222\t\n223\t        # The card is in exile and castable — verify it landed in exile\n224\t        assert _exile_zone(game, 0).contains(sorcery_card)\n225\t\n226\t    def test_exiled_cards_have_free_cast_flag_or_equivalent(self) -> None:\n227\t        \"\"\"The implementation marks exiled cards as free-castable, or records them\n228\t        on the spell for the player to choose from. At minimum, they end up in exile.\"\"\"\n229\t        game = create_game()\n230\t        p1 = game.players[0]\n231\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n232\t        card = _make_creature(\"Target\", cmc=3)\n233\t        p1.zones[Zone.LIBRARY].add(card)\n234\t\n235\t        spell.on_resolve(game)\n236\t\n237\t        exile = _exile_zone(game, 0)\n238\t        assert exile.contains(card)\n239\t\n240\t\n241\t# ---------------------------------------------------------------------------\n242\t# Paradigm — self-exile on resolution\n243\t# ---------------------------------------------------------------------------\n244\t\n245\t\n246\tclass TestImprovisationCapstoneParadigmSelfExile:\n247\t    \"\"\"Paradigm: the spell exiles itself when it resolves.\"\"\"\n248\t\n249\t    def test_card_is_not_in_graveyard_after_resolution(self) -> None:\n250\t        \"\"\"After resolving, the card should NOT be in the graveyard (Paradigm exiles it).\"\"\"\n251\t        game = create_game()\n252\t        p1 = game.players[0]\n253\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n254\t        # Simulate normal casting path: card was in hand, now resolves\n255\t        p1.zones[Zone.GRAVEYARD].add(spell)  # as if engine moved it there\n256\t\n257\t        spell.on_resolve(game)\n258\t\n259\t        # If card ended up in graveyard before on_resolve returned,\n260\t        # it should have been moved to exile\n261\t        assert not _graveyard_zone(game, 0).contains(spell)\n262\t\n263\t    def test_card_is_in_exile_after_paradigm_resolution(self) -> None:\n264\t        \"\"\"After resolving, the card is in its owner's exile zone (Paradigm).\"\"\"\n265\t        game = create_game()\n266\t        p1 = game.players[0]\n267\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n268\t        p1.zones[Zone.GRAVEYARD].add(spell)\n269\t\n270\t        spell.on_resolve(game)\n271\t\n272\t        exile = _exile_zone(game, 0)\n273\t        # Either the card is in exile, or the card's on_resolve handles\n274\t        # self-exile via a replacement/callback\n275\t        # At minimum, it should not be in the graveyard\n276\t        assert not _graveyard_zone(game, 0).contains(spell)\n277\t\n278\t    def test_paradigm_resolved_flag_set_after_first_resolution(self) -> None:\n279\t        \"\"\"After first resolution, some flag/state indicates Paradigm has triggered.\"\"\"\n280\t        game = create_game()\n281\t        p1 = game.players[0]\n282\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n283\t        p1.zones[Zone.GRAVEYARD].add(spell)\n284\t\n285\t        spell.on_resolve(game)\n286\t\n287\t        # The implementation must track that this paradigm has been activated.\n288\t        # Common convention: paradigm_resolved attribute on the card, or a\n289\t        # class-level set of player_ids that resolved it.\n290\t        resolved = (\n291\t            getattr(spell, \"paradigm_resolved\", False)\n292\t            or getattr(p1, \"_paradigm_improvisation_capstone\", False)\n293\t            or len(game.trigger_manager.get_triggers()) > 0\n294\t        )\n295\t        assert resolved, (\n296\t            \"Expected some indication that Paradigm resolved: \"\n297\t            \"paradigm_resolved flag, player-level marker, or a registered trigger\"\n298\t        )\n299\t\n300\t\n301\t# ---------------------------------------------------------------------------\n302\t# Paradigm — trigger for recurring free-cast at main phase\n303\t# ---------------------------------------------------------------------------\n304\t\n305\t\n306\tclass TestImprovisationCapstoneParadigmTrigger:\n307\t    \"\"\"Paradigm: after first resolution, a trigger fires at the beginning of\n308\t    each precombat main phase so the player may cast a copy for free.\"\"\"\n309\t\n310\t    def test_paradigm_registers_main_phase_trigger_after_resolve(self) -> None:\n311\t        \"\"\"Resolving Improvisation Capstone must register a BeginningOfMainPhase trigger.\"\"\"\n312\t        game = create_game()\n313\t        p1 = game.players[0]\n314\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n315\t        p1.zones[Zone.GRAVEYARD].add(spell)\n316\t\n317\t        before = len(game.trigger_manager.get_triggers())\n318\t        spell.on_resolve(game)\n319\t        after = len(game.trigger_manager.get_triggers())\n320\t\n321\t        assert after > before, (\n322\t            \"Expected at least one new trigger registered after Paradigm resolution\"\n323\t        )\n324\t\n325\t    def test_paradigm_trigger_fires_on_main_phase_event(self) -> None:\n326\t        \"\"\"The registered trigger must respond to BeginningOfMainPhaseTriggeredEvent.\"\"\"\n327\t        game = create_game()\n328\t        p1 = game.players[0]\n329\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n330\t        p1.zones[Zone.GRAVEYARD].add(spell)\n331\t        spell.on_resolve(game)\n332\t\n333\t        triggers = game.trigger_manager.get_triggers()\n334\t        main_phase_triggers = [\n335\t            t for t in triggers\n336\t            if issubclass(t.event_type, BeginningOfMainPhaseTriggeredEvent)\n337\t        ]\n338\t        assert len(main_phase_triggers) >= 1, (\n339\t            \"Expected a BeginningOfMainPhaseTriggeredEvent trigger after Paradigm\"\n340\t        )\n341\t\n342\t    def test_paradigm_trigger_condition_matches_controller(self) -> None:\n343\t        \"\"\"The Paradigm trigger should fire for the controller's main phase, not the opponent's.\"\"\"\n344\t        game = create_game()\n345\t        p1 = game.players[0]\n346\t        p2 = game.players[1]\n347\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n348\t        p1.zones[Zone.GRAVEYARD].add(spell)\n349\t        spell.on_resolve(game)\n350\t\n351\t        triggers = game.trigger_manager.get_triggers()\n352\t        main_phase_triggers = [\n353\t            t for t in triggers\n354\t            if issubclass(t.event_type, BeginningOfMainPhaseTriggeredEvent)\n355\t        ]\n356\t\n357\t        if not main_phase_triggers:\n358\t            pytest.skip(\"No main phase trigger registered — tested separately\")\n359\t\n360\t        trigger = main_phase_triggers[0]\n361\t        if trigger.condition is None:\n362\t            return  # No condition means always fires; acceptable\n363\t\n364\t        # Must match p1's main phase\n365\t        event_p1 = BeginningOfMainPhaseTriggeredEvent(player=p1)\n366\t        assert trigger.condition(game, event_p1) is True\n367\t\n368\t        # Must NOT match p2's main phase\n369\t        event_p2 = BeginningOfMainPhaseTriggeredEvent(player=p2)\n370\t        assert trigger.condition(game, event_p2) is False\n371\t\n372\t    def test_paradigm_trigger_fires_on_controller_main_phase(self) -> None:\n373\t        \"\"\"Firing BeginningOfMainPhaseTriggeredEvent for the controller pushes the trigger.\"\"\"\n374\t        game = create_game()\n375\t        p1 = game.players[0]\n376\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n377\t        p1.zones[Zone.GRAVEYARD].add(spell)\n378\t        spell.on_resolve(game)\n379\t\n380\t        stack_before = len(game.stack.objects())\n381\t        game.trigger_manager.fire_event(\n382\t            game, BeginningOfMainPhaseTriggeredEvent(player=p1)\n383\t        )\n384\t        stack_after = len(game.stack.objects())\n385\t\n386\t        assert stack_after > stack_before, (\n387\t            \"Expected Paradigm trigger to push something onto the stack \"\n388\t            \"at the beginning of the controller's main phase\"\n389\t        )\n390\t\n391\t    def test_paradigm_trigger_does_not_fire_for_opponent_main_phase(self) -> None:\n392\t        \"\"\"The Paradigm trigger should not fire for the opponent's main phase.\"\"\"\n393\t        game = create_game()\n394\t        p1 = game.players[0]\n395\t        p2 = game.players[1]\n396\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n397\t        p1.zones[Zone.GRAVEYARD].add(spell)\n398\t        spell.on_resolve(game)\n399\t\n400\t        stack_before = len(game.stack.objects())\n401\t        game.trigger_manager.fire_event(\n402\t            game, BeginningOfMainPhaseTriggeredEvent(player=p2)\n403\t        )\n404\t        stack_after = len(game.stack.objects())\n405\t\n406\t        assert stack_after == stack_before, (\n407\t            \"Paradigm trigger should NOT fire for opponent's main phase\"\n408\t        )\n409\t"}]},"parent_tool_use_id":"toolu_01LW1BNc6CoXS78pX9RyGxVm","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"a56b3570-04d4-4103-9f58-335d6b0e3253","timestamp":"2026-05-28T00:50:15.922Z","subagent_type":"Implementer","task_description":"Implementer for sos_120"}
