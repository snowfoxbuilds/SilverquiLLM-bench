{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_01V63LzvUZAU4bgyYvfn9Hmu","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01AtKzUywaZ7DsmcTHLeurPM","name":"Read","input":{"file_path":"/workspace/engine/casting.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":8302,"cache_read_input_tokens":17623,"cache_creation":{"ephemeral_5m_input_tokens":8302,"ephemeral_1h_input_tokens":0},"output_tokens":51,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_012s7dMnBNeeuBuVB5j2ytoq","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"9c0e71ff-3e5c-41ef-98c6-ce4469727272","request_id":"req_011CbU6x8jHxrdz5Zngib4MQ","subagent_type":"Reviewer","task_description":"Reviewer for sos_245"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AtKzUywaZ7DsmcTHLeurPM","type":"tool_result","content":"1\t\"\"\"Casting and resolution pipeline for spells and lands.\n2\t\n3\tProvides the full flow from casting a spell or playing a land through\n4\tresolution:\n5\t\n6\t- :func:`cast_spell` — verify timing & legality → move hand to stack →\n7\t  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n8\t- :func:`play_land` — verify land play remaining → move hand to\n9\t  battlefield → decrement ``land_plays_remaining``.\n10\t- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n11\t  helpers used by the casting pipeline.\n12\t\n13\tResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\n14\tcreated by :func:`cast_spell`:\n15\t\n16\t- Call ``card.on_resolve(game)``.\n17\t- Permanents (creature / enchantment / artifact / planeswalker) move from\n18\t  the stack to the battlefield.\n19\t- Non-permanents (instant / sorcery) move to the graveyard.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import TYPE_CHECKING, Any\n25\t\n26\tfrom engine.card import CardImpl\n27\tfrom engine.stack import StackObject\n28\tfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\n29\tfrom engine.zones import move_zone\n30\t\n31\tif TYPE_CHECKING:\n32\t    from engine.game_state import GameState\n33\t    from engine.player import Player\n34\t\n35\t\n36\t# Card types that represent permanents — these go to the battlefield on resolve.\n37\t_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n38\t    CardType.CREATURE,\n39\t    CardType.ENCHANTMENT,\n40\t    CardType.ARTIFACT,\n41\t    CardType.PLANESWALKER,\n42\t})\n43\t\n44\t\n45\tclass CastingError(Exception):\n46\t    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n47\t\n48\t\n49\t# ------------------------------------------------------------------\n50\t# Timing helpers\n51\t# ------------------------------------------------------------------\n52\t\n53\tdef is_sorcery_speed(game: GameState, player: Player) -> bool:\n54\t    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n55\t\n56\t    Sorcery speed requires all of:\n57\t\n58\t    * *player* is the active player.\n59\t    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n60\t      ``POSTCOMBAT_MAIN``).\n61\t    * The stack is empty.\n62\t    \"\"\"\n63\t    if player is not game.active_player:\n64\t        return False\n65\t    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n66\t        return False\n67\t    if not game.stack.is_empty():\n68\t        return False\n69\t    return True\n70\t\n71\t\n72\tdef can_cast_at_instant_speed(card: CardImpl) -> bool:\n73\t    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n74\t\n75\t    A card has instant-speed timing if it is an instant or has the\n76\t    :attr:`~engine.types.Keyword.FLASH` keyword.\n77\t    \"\"\"\n78\t    if CardType.INSTANT in card.card_types:\n79\t        return True\n80\t    if Keyword.FLASH & card.keywords:\n81\t        return True\n82\t    return False\n83\t\n84\t\n85\t# ------------------------------------------------------------------\n86\t# Cost reduction\n87\t# ------------------------------------------------------------------\n88\t\n89\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n90\t    \"\"\"Return the generic mana reduction for casting *card*.\n91\t\n92\t    Queries ``card.cost_reduction(game)`` and clamps the result so that\n93\t    the generic portion of the mana cost cannot go below 0.\n94\t\n95\t    Also consults ``game.active_cost_reducers`` — a list of reducer dicts\n96\t    added by permanent abilities (e.g. Witherbloom granting affinity for\n97\t    creatures to instants/sorceries).  Each dict has:\n98\t        ``condition``: callable(card) -> bool\n99\t        ``reduction``: callable(game, controller) -> int\n100\t    \"\"\"\n101\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n102\t    # casting player even when the card was never explicitly assigned one.\n103\t    prev_controller = card.controller\n104\t    card.controller = controller\n105\t    raw = card.cost_reduction(game)\n106\t    # Restore previous controller in case the caller doesn't want a\n107\t    # side-effect (get_cost_reduction is a query, not a mutation).\n108\t    card.controller = prev_controller\n109\t\n110\t    # Consult active_cost_reducers from permanents on the battlefield.\n111\t    active_reducers = getattr(game, \"active_cost_reducers\", [])\n112\t    for reducer in active_reducers:\n113\t        try:\n114\t            condition = reducer.get(\"condition\")\n115\t            if condition is not None and not condition(card):\n116\t                continue\n117\t            reduction_fn = reducer.get(\"reduction\")\n118\t            if reduction_fn is not None:\n119\t                raw += reduction_fn(game, controller)\n120\t        except Exception:\n121\t            pass\n122\t\n123\t    generic = card.mana_cost.generic if card.mana_cost else 0\n124\t    return max(0, min(raw, generic))\n125\t\n126\t\n127\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n128\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n129\t    new_generic = max(0, cost.generic - reduction)\n130\t    return ManaCost(\n131\t        generic=new_generic,\n132\t        pips=dict(cost.pips),\n133\t        x_count=cost.x_count,\n134\t        hybrid=list(cost.hybrid),\n135\t    )\n136\t\n137\t\n138\t# ------------------------------------------------------------------\n139\t# Cast spell\n140\t# ------------------------------------------------------------------\n141\t\n142\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n143\t    \"\"\"Cast *card* from *player*'s hand.\n144\t\n145\t    Pipeline\n146\t    --------\n147\t    1. **Timing check** — instants (and cards with flash) can be cast\n148\t       whenever the player has priority; everything else requires\n149\t       sorcery-speed timing.\n150\t    2. **can_cast** — ask the card whether it can legally be cast.\n151\t    3. **Hand check** — the card must be in the player's hand.\n152\t    4. **Move hand → stack zone** — remove the card from the hand and\n153\t       place it into the player's stack zone.\n154\t    5. **Choose targets** — if the card specifies targets (via\n155\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n156\t    6. **Mana check / payment** — the player's mana pool must be able to\n157\t       pay the card's mana cost.  If payment fails, the card is rolled\n158\t       back from the stack zone to the hand.\n159\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n160\t    8. **Push StackObject** — push a :class:`StackObject` whose\n161\t       ``on_resolve`` callback handles resolution.\n162\t\n163\t    Raises:\n164\t        CastingError: If any legality check fails.\n165\t    \"\"\"\n166\t    # 1. Timing\n167\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n168\t        raise CastingError(\n169\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n170\t        )\n171\t\n172\t    # 2. can_cast\n173\t    if not card.can_cast(game):\n174\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n175\t\n176\t    # 3. Hand check\n177\t    hand = game.get_hand(player)\n178\t    if not hand.contains(card):\n179\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n180\t\n181\t    # 4. Move card from hand to stack zone\n182\t    stack_zone = player.zones[Zone.STACK]\n183\t    hand.remove(card)\n184\t    stack_zone.add(card)\n185\t\n186\t    # Clear any stale colors_spent from a prior cast before new payment.\n187\t    if hasattr(card, \"colors_spent\"):\n188\t        del card.colors_spent\n189\t\n190\t    # 5. Choose targets\n191\t    target_specs = card.get_targets(game)\n192\t    chosen_targets: list[Any] = []\n193\t    if target_specs:\n194\t        for spec in target_specs:\n195\t            target = player.choose_target(target_specs, spec)\n196\t            # Validate against filter_fn if the spec provides one\n197\t            filter_fn = getattr(spec, \"filter_fn\", None)\n198\t            if filter_fn is not None and target is not None:\n199\t                if not filter_fn(target):\n200\t                    stack_zone.remove(card)\n201\t                    hand.add(card)\n202\t                    raise CastingError(\n203\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n204\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n205\t                    )\n206\t            chosen_targets.append(target)\n207\t\n208\t    # 5b. Protection check — reject targets that have protection from this\n209\t    #     spell (the T in DEBT).\n210\t    from engine.protection import has_protection_from\n211\t\n212\t    for target in chosen_targets:\n213\t        if has_protection_from(target, card):\n214\t            # Rollback: move card from stack zone back to hand\n215\t            stack_zone.remove(card)\n216\t            hand.add(card)\n217\t            raise CastingError(\n218\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n219\t            )\n220\t\n221\t    # Targets are stored on the StackObject (not the card) and passed\n222\t    # through the resolve pipeline via on_resolve(game, targets=...).\n223\t\n224\t    # 6. Mana check / payment (rollback on failure)\n225\t    # Ensure the card knows its controller so that cost_reduction() hooks\n226\t    # (e.g. Embercleave counting attacking creatures you control) see the\n227\t    # casting player, even for cards that were added to hand without an\n228\t    # explicit controller assignment.\n229\t    if card.controller is None:\n230\t        card.controller = player\n231\t    reduction = get_cost_reduction(game, card, player)\n232\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n233\t\n234\t    if not player.mana_pool.can_pay(effective_cost):\n235\t        # Rollback: move card from stack zone back to hand\n236\t        stack_zone.remove(card)\n237\t        hand.add(card)\n238\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n239\t\n240\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n241\t    player.mana_pool.pay(effective_cost)\n242\t\n243\t    # Store colors of mana spent on the card for mechanics like Converge\n244\t    # that care about the colors used to cast the spell.\n245\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n246\t\n247\t    # 7. Call on_cast hook\n248\t    card.on_cast(game)\n249\t\n250\t    # 8. Build on_resolve callback and push StackObject\n251\t    stack_obj = StackObject(\n252\t        source=card,\n253\t        controller=player,\n254\t        targets=chosen_targets,\n255\t        on_resolve=lambda g: None,  # replaced below\n256\t    )\n257\t\n258\t    def _on_resolve(g: GameState) -> None:\n259\t        _resolve_spell(g, card, player, stack_obj)\n260\t\n261\t    stack_obj.on_resolve = _on_resolve\n262\t    game.stack.push(stack_obj)\n263\t\n264\t\n265\t# ------------------------------------------------------------------\n266\t# Cast spell without paying mana cost (free-cast from any zone)\n267\t# ------------------------------------------------------------------\n268\t\n269\t\n270\tdef cast_spell_free(\n271\t    game: GameState,\n272\t    player: Player,\n273\t    card: CardImpl,\n274\t    from_zone: Zone,\n275\t) -> None:\n276\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n277\t\n278\t    This is used by effects that allow casting from zones other than hand\n279\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n280\t    or cascade.\n281\t\n282\t    Pipeline\n283\t    --------\n284\t    1. **can_cast** — ask the card whether it can legally be cast (same\n285\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n286\t    2. Move *card* from *from_zone* to the stack zone.\n287\t    3. Choose targets (if applicable) with validation and protection check.\n288\t    4. Call ``on_cast`` hook.\n289\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n290\t       resolution normally (permanents → battlefield, non-permanents →\n291\t       graveyard).\n292\t\n293\t    No timing check or mana payment is performed.  The spell goes on the\n294\t    stack and can be responded to normally (e.g. countered).\n295\t\n296\t    If targeting or other post-move checks fail, the card is rolled back\n297\t    to its source zone.\n298\t\n299\t    Parameters:\n300\t        game: The current game state.\n301\t        player: The player casting the spell.\n302\t        card: The card to cast.\n303\t        from_zone: The zone the card is currently in.\n304\t\n305\t    Raises:\n306\t        CastingError: If the card cannot be found in *from_zone* or\n307\t            legality checks fail.\n308\t    \"\"\"\n309\t    from engine.zones import move_to_zone\n310\t\n311\t    # Ensure controller is set\n312\t    card.controller = player\n313\t    if card.owner is None:\n314\t        card.owner = player\n315\t\n316\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n317\t    if not card.can_cast(game):\n318\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n319\t\n320\t    # 2. Locate card in source zone\n321\t    source_zone_container = player.zones[from_zone]\n322\t    if not source_zone_container.contains(card):\n323\t        # Try to find the card in any player's zone\n324\t        source_zone_container = None\n325\t        for p in game.players:\n326\t            z = p.zones[from_zone]\n327\t            if z.contains(card):\n328\t                source_zone_container = z\n329\t                break\n330\t\n331\t    if source_zone_container is None or not source_zone_container.contains(card):\n332\t        raise CastingError(\n333\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n334\t        )\n335\t\n336\t    # Move card from source zone to stack zone\n337\t    stack_zone = player.zones[Zone.STACK]\n338\t    source_zone_container.remove(card)\n339\t    stack_zone.add(card)\n340\t\n341\t    # 3. Choose targets (with rollback on failure)\n342\t    try:\n343\t        target_specs = card.get_targets(game)\n344\t        chosen_targets: list[Any] = []\n345\t        if target_specs:\n346\t            for spec in target_specs:\n347\t                target = player.choose_target(target_specs, spec)\n348\t                # Validate against filter_fn if the spec provides one\n349\t                filter_fn = getattr(spec, \"filter_fn\", None)\n350\t                if filter_fn is not None and target is not None:\n351\t                    if not filter_fn(target):\n352\t                        raise CastingError(\n353\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n354\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n355\t                        )\n356\t                chosen_targets.append(target)\n357\t\n358\t        # Protection check — reject targets that have protection from this spell\n359\t        from engine.protection import has_protection_from\n360\t\n361\t        for target in chosen_targets:\n362\t            if has_protection_from(target, card):\n363\t                raise CastingError(\n364\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n365\t                )\n366\t    except Exception as exc:\n367\t        # Rollback: move card from stack zone back to source zone\n368\t        stack_zone.remove(card)\n369\t        source_zone_container.add(card)\n370\t        raise CastingError(str(exc)) from exc\n371\t\n372\t    # 4. Call on_cast hook\n373\t    card.on_cast(game)\n374\t\n375\t    # 5. Build on_resolve callback and push StackObject\n376\t    stack_obj = StackObject(\n377\t        source=card,\n378\t        controller=player,\n379\t        targets=chosen_targets,\n380\t        on_resolve=lambda g: None,  # replaced below\n381\t    )\n382\t\n383\t    def _on_resolve(g: GameState) -> None:\n384\t        _resolve_spell(g, card, player, stack_obj)\n385\t\n386\t    stack_obj.on_resolve = _on_resolve\n387\t    game.stack.push(stack_obj)\n388\t\n389\t\n390\t# ------------------------------------------------------------------\n391\t# Resolution (called when the stack pops)\n392\t# ------------------------------------------------------------------\n393\t\n394\tdef _resolve_spell(\n395\t    game: GameState,\n396\t    card: CardImpl,\n397\t    player: Player,\n398\t    stack_obj: StackObject,\n399\t) -> None:\n400\t    \"\"\"Resolve *card* cast by *player*.\n401\t\n402\t    1. Call ``card.on_resolve(game, targets=targets)``.\n403\t    2. Remove the card from the stack zone.\n404\t    3. If the card is a permanent type, move it to the battlefield via\n405\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n406\t       registration and the ETB event).\n407\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n408\t    \"\"\"\n409\t    from engine.zones import move_to_zone\n410\t\n411\t    # Read targets from the StackObject — the single source of truth.\n412\t    # Set chosen_targets on the card just before resolution so that\n413\t    # _get_chosen_target helpers (which read via getattr) work.\n414\t    targets = stack_obj.targets\n415\t    if targets is not None:\n416\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n417\t\n418\t    card.on_resolve(game)\n419\t\n420\t    if card.card_types & _PERMANENT_TYPES:\n421\t        # Move from stack to battlefield via move_to_zone, which handles\n422\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n423\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n424\t    elif getattr(card, \"exile_on_resolve\", False):\n425\t        # Cards with exile_on_resolve=True (e.g. Paradigm spells) go to exile\n426\t        # instead of the graveyard after resolving.\n427\t        move_to_zone(game, card, Zone.STACK, Zone.EXILE)\n428\t    else:\n429\t        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n430\t        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n431\t\n432\t\n433\t# ------------------------------------------------------------------\n434\t# Play land (special action — does not use the stack)\n435\t# ------------------------------------------------------------------\n436\t\n437\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n438\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n439\t\n440\t    Requirements (all must hold):\n441\t\n442\t    * *land_card* has :attr:`CardType.LAND`.\n443\t    * *player* is the active player.\n444\t    * Current phase is a main phase.\n445\t    * The stack is empty.\n446\t    * ``player.land_plays_remaining > 0``.\n447\t    * The card is in the player's hand.\n448\t\n449\t    On success the card moves from hand to battlefield and\n450\t    ``land_plays_remaining`` is decremented.\n451\t\n452\t    Raises:\n453\t        CastingError: If any requirement is not met.\n454\t    \"\"\"\n455\t    # Must be a land\n456\t    if CardType.LAND not in land_card.card_types:\n457\t        raise CastingError(\n458\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n459\t        )\n460\t\n461\t    # Sorcery-speed timing (active player, main phase, stack empty)\n462\t    if not is_sorcery_speed(game, player):\n463\t        raise CastingError(\n464\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n465\t            \"during main phase with empty stack\"\n466\t        )\n467\t\n468\t    # Land plays remaining\n469\t    if player.land_plays_remaining <= 0:\n470\t        raise CastingError(\n471\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n472\t        )\n473\t\n474\t    # Card must be in hand\n475\t    hand = game.get_hand(player)\n476\t    if not hand.contains(land_card):\n477\t        raise CastingError(\n478\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n479\t        )\n480\t\n481\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n482\t    if land_card.owner is None:\n483\t        land_card.owner = player\n484\t    land_card.controller = player\n485\t\n486\t    # Move from hand to battlefield via move_to_zone, which fires\n487\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n488\t    from engine.zones import move_to_zone\n489\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n490\t\n491\t    # Decrement land plays\n492\t    player.land_plays_remaining -= 1\n493\t\n494\t\n495\tdef resolve_top(game: GameState) -> None:\n496\t    \"\"\"Resolve the top spell/ability on the stack.\n497\t\n498\t    Pops the top item from the stack, calls its on_resolve callback,\n499\t    then runs state-based actions.  If the stack is empty this is a no-op.\n500\t    \"\"\"\n501\t    if game.stack.is_empty():\n502\t        return\n503\t    from engine.state_based_actions import resolve_state_based_actions\n504\t\n505\t    obj = game.stack.pop()\n506\t    obj.on_resolve(game)\n507\t    resolve_state_based_actions(game)\n508\t"}]},"parent_tool_use_id":"toolu_012s7dMnBNeeuBuVB5j2ytoq","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"bacf3d0d-4478-4184-b932-46b0ca5a6a67","timestamp":"2026-05-28T01:31:41.658Z","subagent_type":"Reviewer","task_description":"Reviewer for sos_245"}
