{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018cSeFrqiH4ZvnHH6WUsGMX","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_13/card_impl.py b/cards/sos/sos_13/card_impl.py\n2\tindex 765fb45..a78842e 100644\n3\t--- a/cards/sos/sos_13/card_impl.py\n4\t+++ b/cards/sos/sos_13/card_impl.py\n5\t@@ -1,16 +1,251 @@\n6\t-\"\"\"Card implementation for Emeritus of Truce // Swords to Plowshares.\"\"\"\n7\t+\"\"\"Card implementation for Emeritus of Truce // Swords to Plowshares (SOS #13).\n8\t+\n9\t+Emeritus of Truce — {1}{W}{W} — 3/3 — Cat Cleric — Creature\n10\t+\n11\t+When this creature enters, target player creates a 1/1 white and black\n12\t+Inkling creature token with flying.  Then if an opponent controls more\n13\t+creatures than you, this creature becomes prepared.\n14\t+\n15\t+Prepared mechanic:\n16\t+  While prepared, you may cast a copy of its spell (Swords to Plowshares).\n17\t+  Doing so unprepares it.\n18\t+\n19\t+Swords to Plowshares — {W} — Instant\n20\t+  Exile target creature. Its controller gains life equal to its power.\n21\t+\"\"\"\n22\t \n23\t from __future__ import annotations\n24\t \n25\t-from engine.card import CardImpl\n26\t+from typing import TYPE_CHECKING, Any\n27\t \n28\t-from typing import TYPE_CHECKING\n29\t+from engine.card import CardImpl, Creature, Instant\n30\t+from engine.events import EntersBattlefieldTriggeredEvent\n31\t+from engine.triggers import TriggerRegistration\n32\t+from engine.types import CardType, Keyword, ManaCost, TargetRequirement, Zone\n33\t \n34\t if TYPE_CHECKING:\n35\t     from engine.game_state import GameState\n36\t \n37\t \n38\t-class EmeritusOfTruceSwordsToPlowshares(CardImpl):\n39\t-    \"\"\"TODO: Implement Emeritus of Truce // Swords to Plowshares.\"\"\"\n40\t+# ---------------------------------------------------------------------------\n41\t+# Swords to Plowshares — the spell side\n42\t+# ---------------------------------------------------------------------------\n43\t+\n44\t+class _SwordsToPlowshares(Instant):\n45\t+    \"\"\"Swords to Plowshares — {W} — Instant.\n46\t+\n47\t+    Exile target creature. Its controller gains life equal to its power.\n48\t+    This is the spell side of Emeritus of Truce.\n49\t+    \"\"\"\n50\t+\n51\t+    def __init__(self, **kwargs: Any) -> None:\n52\t+        kwargs.setdefault(\"name\", \"Swords to Plowshares\")\n53\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{W}\"))\n54\t+        kwargs.setdefault(\n55\t+            \"rules_text\",\n56\t+            \"Exile target creature. Its controller gains life equal to its power.\",\n57\t+        )\n58\t+        super().__init__(**kwargs)\n59\t+\n60\t+\n61\t+# ---------------------------------------------------------------------------\n62\t+# Inkling token factory\n63\t+# ---------------------------------------------------------------------------\n64\t+\n65\t+def _make_inkling_token(owner: Any, controller: Any) -> Creature:\n66\t+    \"\"\"Create a 1/1 white and black Inkling creature token with flying.\"\"\"\n67\t+    token = Creature(\n68\t+        name=\"Inkling\",\n69\t+        mana_cost=ManaCost(),\n70\t+        subtypes={\"Inkling\"},\n71\t+        keywords=Keyword.FLYING,\n72\t+        base_power=1,\n73\t+        base_toughness=1,\n74\t+        owner=owner,\n75\t+        controller=controller,\n76\t+    )\n77\t+    token.is_token = True\n78\t+    # Colors: white and black\n79\t+    token.colors = {\"W\", \"B\"}\n80\t+    return token\n81\t+\n82\t+\n83\t+# ---------------------------------------------------------------------------\n84\t+# Main card class\n85\t+# ---------------------------------------------------------------------------\n86\t+\n87\t+class EmeritusOfTruceSwordsToPlowshares(Creature):\n88\t+    \"\"\"Emeritus of Truce // Swords to Plowshares — {1}{W}{W} — 3/3 — Cat Cleric.\n89\t+\n90\t+    ETB: target player creates a 1/1 white and black Inkling creature token\n91\t+    with flying.  Then if an opponent controls more creatures than you, this\n92\t+    creature becomes prepared.\n93\t+\n94\t+    Prepared: you may cast a copy of Swords to Plowshares (exile target\n95\t+    creature; its controller gains life equal to its power).  Doing so\n96\t+    unprepares this creature.\n97\t+    \"\"\"\n98\t+\n99\t+    def __init__(self, **kwargs: Any) -> None:\n100\t+        kwargs.setdefault(\"name\", \"Emeritus of Truce // Swords to Plowshares\")\n101\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{W}{W}\"))\n102\t+        kwargs.setdefault(\"subtypes\", {\"Cat\", \"Cleric\"})\n103\t+        kwargs.setdefault(\"base_power\", 3)\n104\t+        kwargs.setdefault(\"base_toughness\", 3)\n105\t+        kwargs.setdefault(\n106\t+            \"rules_text\",\n107\t+            \"When this creature enters, target player creates a 1/1 white and \"\n108\t+            \"black Inkling creature token with flying. Then if an opponent \"\n109\t+            \"controls more creatures than you, this creature becomes prepared. \"\n110\t+            \"(While it's prepared, you may cast a copy of its spell. Doing so \"\n111\t+            \"unprepares it.)\",\n112\t+        )\n113\t+        super().__init__(**kwargs)\n114\t+\n115\t+        # Prepared state\n116\t+        self.is_prepared: bool = False\n117\t+\n118\t+        # Spell side — Swords to Plowshares\n119\t+        self.spell_side: _SwordsToPlowshares = _SwordsToPlowshares()\n120\t+\n121\t+    # ------------------------------------------------------------------\n122\t+    # Targeting API\n123\t+    # ------------------------------------------------------------------\n124\t+\n125\t+    def get_targets(self, game: \"GameState\") -> list[Any]:\n126\t+        \"\"\"Return a targeting requirement: a player to receive the Inkling token.\"\"\"\n127\t+        # The target is a player (any player)\n128\t+        return [\n129\t+            TargetRequirement(\n130\t+                filter_fn=lambda obj: obj in game.players,\n131\t+                description=\"target player\",\n132\t+                zone=Zone.BATTLEFIELD,  # zone is conceptually 'any' for players\n133\t+            )\n134\t+        ]\n135\t+\n136\t+    # ------------------------------------------------------------------\n137\t+    # ETB resolution\n138\t+    # ------------------------------------------------------------------\n139\t+\n140\t+    def on_resolve(self, game: \"GameState\") -> None:\n141\t+        \"\"\"ETB effect: create Inkling token for target player; check prepared.\"\"\"\n142\t+        chosen = getattr(self, \"chosen_targets\", None)\n143\t+        if not chosen:\n144\t+            return\n145\t+\n146\t+        target_player = chosen[0]\n147\t+\n148\t+        # Step 1: Target player creates a 1/1 white and black Inkling token\n149\t+        # with flying.\n150\t+        from engine.game import create_token\n151\t+        token = _make_inkling_token(owner=target_player, controller=target_player)\n152\t+        create_token(game, target_player, token)\n153\t+\n154\t+        # Step 2: If an opponent controls more creatures than you, become prepared.\n155\t+        controller = getattr(self, \"controller\", None)\n156\t+        if controller is None:\n157\t+            return\n158\t+\n159\t+        my_creature_count = _count_creatures_controlled_by(game, controller)\n160\t+        opponent_max = _max_opponent_creature_count(game, controller)\n161\t+\n162\t+        if opponent_max > my_creature_count:\n163\t+            self.is_prepared = True\n164\t+\n165\t+    # ------------------------------------------------------------------\n166\t+    # Trigger registration\n167\t+    # ------------------------------------------------------------------\n168\t+\n169\t+    def register_triggers(self, game: \"GameState\") -> None:\n170\t+        \"\"\"Register the ETB trigger.\"\"\"\n171\t+        source = self\n172\t+        controller = getattr(self, \"controller\", None) or game.active_player\n173\t+\n174\t+        def _condition(g: \"GameState\", event: EntersBattlefieldTriggeredEvent) -> bool:\n175\t+            return event.permanent is source\n176\t+\n177\t+        def _effect(g: \"GameState\") -> None:\n178\t+            source.on_resolve(g)\n179\t+\n180\t+        game.trigger_manager.register(\n181\t+            TriggerRegistration(\n182\t+                event_type=EntersBattlefieldTriggeredEvent,\n183\t+                condition=_condition,\n184\t+                effect=_effect,\n185\t+                source=source,\n186\t+                controller=controller,\n187\t+            )\n188\t+        )\n189\t+\n190\t+    # ------------------------------------------------------------------\n191\t+    # Prepared mechanic: cast spell copy\n192\t+    # ------------------------------------------------------------------\n193\t+\n194\t+    def cast_prepared_spell(self, game: \"GameState\") -> None:\n195\t+        \"\"\"Cast a copy of Swords to Plowshares if this creature is prepared.\n196\t+\n197\t+        Exiles the first valid target creature found on the battlefield and\n198\t+        grants its controller life equal to its power.  Sets is_prepared to\n199\t+        False regardless of whether a target was found.\n200\t+        \"\"\"\n201\t+        if not self.is_prepared:\n202\t+            return\n203\t+\n204\t+        # Unprepare first (Swords to Plowshares copy has been \"cast\").\n205\t+        self.is_prepared = False\n206\t+\n207\t+        # Find a target creature on any battlefield.\n208\t+        target = _find_any_creature(game)\n209\t+        if target is None:\n210\t+            return\n211\t+\n212\t+        # Exile the target creature and give its controller life = power.\n213\t+        _exile_creature_give_life(game, target)\n214\t+\n215\t+\n216\t+# ---------------------------------------------------------------------------\n217\t+# Helper functions\n218\t+# ---------------------------------------------------------------------------\n219\t+\n220\t+def _count_creatures_controlled_by(game: Any, player: Any) -> int:\n221\t+    \"\"\"Return the number of creatures player controls on the battlefield.\"\"\"\n222\t+    bf = game.get_battlefield(player)\n223\t+    return sum(\n224\t+        1 for obj in bf.get_all()\n225\t+        if CardType.CREATURE in getattr(obj, \"card_types\", set())\n226\t+    )\n227\t+\n228\t+\n229\t+def _max_opponent_creature_count(game: Any, player: Any) -> int:\n230\t+    \"\"\"Return the maximum creature count among any single opponent.\"\"\"\n231\t+    max_count = 0\n232\t+    for p in game.players:\n233\t+        if p is player:\n234\t+            continue\n235\t+        count = _count_creatures_controlled_by(game, p)\n236\t+        if count > max_count:\n237\t+            max_count = count\n238\t+    return max_count\n239\t+\n240\t+\n241\t+def _find_any_creature(game: Any) -> Any:\n242\t+    \"\"\"Return the first creature found on any player's battlefield, or None.\"\"\"\n243\t+    for player in game.players:\n244\t+        bf = game.get_battlefield(player)\n245\t+        for obj in bf.get_all():\n246\t+            if CardType.CREATURE in getattr(obj, \"card_types\", set()):\n247\t+                return obj\n248\t+    return None\n249\t+\n250\t+\n251\t+def _exile_creature_give_life(game: Any, creature: Any) -> None:\n252\t+    \"\"\"Exile *creature* and grant its controller life equal to its power.\"\"\"\n253\t+    from engine.game import exile\n254\t+\n255\t+    power = getattr(creature, \"power\", 0)\n256\t+    ctrl = getattr(creature, \"controller\", None)\n257\t+\n258\t+    exile(game, creature)\n259\t \n260\t-    pass\n261\t+    if ctrl is not None and power > 0:\n262\t+        ctrl.life += power\n263\t"}]},"parent_tool_use_id":"toolu_01MRW3tw2ySHqz2NZkSQo5wW","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"7c6bf930-f373-4358-8db1-9f99d17b9c48","timestamp":"2026-05-28T00:19:21.302Z","subagent_type":"Reviewer","task_description":"Reviewer for sos_13"}
