{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W5d6EuYXAdxM1gHGSH863k","type":"tool_result","content":"1\t\"\"\"Card implementation for Cephalid Inkmage.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.continuous_effects import (\n9\t    ContinuousEffect,\n10\t    DURATION_PERMANENT,\n11\t    Layer,\n12\t)\n13\tfrom engine.types import Keyword, ManaCost, Zone\n14\t\n15\tif TYPE_CHECKING:\n16\t    from engine.game_state import GameState\n17\t\n18\t\n19\tdef _is_on_battlefield(game: Any, obj: Any) -> bool:\n20\t    \"\"\"Return True if *obj* is on any player's battlefield.\"\"\"\n21\t    for player in game.players:\n22\t        if game.get_battlefield(player).contains(obj):\n23\t            return True\n24\t    return False\n25\t\n26\t\n27\tclass CephalidInkmage(Creature):\n28\t    \"\"\"Cephalid Inkmage — {2}{U} — 2/2 — Octopus Wizard.\n29\t\n30\t    When this creature enters, surveil 3.\n31\t    Threshold — This creature can't be blocked as long as there are seven\n32\t    or more cards in your graveyard.\n33\t\n34\t    FDN collector number 32.\n35\t    \"\"\"\n36\t\n37\t    def __init__(self, **kwargs: Any) -> None:\n38\t        kwargs.setdefault(\"name\", \"Cephalid Inkmage\")\n39\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{2}{U}\"))\n40\t        kwargs.setdefault(\"subtypes\", {\"Octopus\", \"Wizard\"})\n41\t        kwargs.setdefault(\"base_power\", 2)\n42\t        kwargs.setdefault(\"base_toughness\", 2)\n43\t        kwargs.setdefault(\n44\t            \"rules_text\",\n45\t            \"When this creature enters, surveil 3.\\n\"\n46\t            \"Threshold — This creature can't be blocked as long as there \"\n47\t            \"are seven or more cards in your graveyard.\",\n48\t        )\n49\t        super().__init__(**kwargs)\n50\t        self._unblockable_effect_ref: ContinuousEffect | None = None\n51\t\n52\t    def on_resolve(self, game: \"GameState\") -> None:\n53\t        \"\"\"ETB: surveil 3.\"\"\"\n54\t        controller = self.controller\n55\t        if controller is None:\n56\t            return\n57\t        library = controller.zones[Zone.LIBRARY]\n58\t        cards = list(library.get_all())\n59\t        if not cards:\n60\t            return\n61\t        # Surveil 3: look at top 3 cards (top is end of list)\n62\t        top_cards = cards[-min(3, len(cards)):]\n63\t        for card in reversed(top_cards):\n64\t            put_in_gy = controller.choose_yes_no(\n65\t                f\"Surveil: Put {getattr(card, 'name', 'card')} into your graveyard?\"\n66\t            )\n67\t            if put_in_gy:\n68\t                library.remove(card)\n69\t                controller.zones[Zone.GRAVEYARD].add(card)\n70\t\n71\t    def register_triggers(self, game: \"GameState\") -> None:\n72\t        \"\"\"Register threshold unblockable continuous effect.\"\"\"\n73\t        source = self\n74\t\n75\t        def _apply_unblockable(game: Any) -> None:\n76\t            ctrl = getattr(source, \"controller\", None)\n77\t            if ctrl is None:\n78\t                return\n79\t            if not _is_on_battlefield(game, source):\n80\t                return\n81\t            # Threshold: 7+ cards in graveyard\n82\t            graveyard = ctrl.zones[Zone.GRAVEYARD]\n83\t            gy_count = len(list(graveyard.get_all()))\n84\t            if gy_count >= 7:\n85\t                # ENGINE LIMITATION: \"can't be blocked\" is modeled as a flag\n86\t                # on the creature. The engine may not fully support this in\n87\t                # combat resolution.\n88\t                source.unblockable = True\n89\t            else:\n90\t                source.unblockable = False\n91\t\n92\t        self._unblockable_effect_ref = game.effect_manager.add(ContinuousEffect(\n93\t            source=self,\n94\t            layer=Layer.ABILITY,\n95\t            sublayer=None,\n96\t            apply=_apply_unblockable,\n97\t            duration=DURATION_PERMANENT,\n98\t        ))\n99\t\n100\t    def unregister_triggers(self, game: \"GameState\") -> None:\n101\t        \"\"\"Clean up unblockable effect when leaving battlefield.\"\"\"\n102\t        if self._unblockable_effect_ref is not None:\n103\t            game.effect_manager.remove(self._unblockable_effect_ref)\n104\t            self._unblockable_effect_ref = None\n105\t        self.unblockable = False\n106\t"}]},"parent_tool_use_id":"toolu_01863j2wBNqM4G15CCufN2JX","session_id":"bc7916e9-61b8-4183-92a0-8e53a58e330b","uuid":"c5473040-6cec-411a-8874-b17eca13ba81","timestamp":"2026-05-28T00:35:59.698Z","subagent_type":"Tester","task_description":"Tester for sos_97"}
