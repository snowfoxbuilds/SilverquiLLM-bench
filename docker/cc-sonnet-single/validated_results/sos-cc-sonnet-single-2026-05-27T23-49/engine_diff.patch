--- a/casting.py	2026-05-25 16:43:11.728292087 +0000
+++ b/casting.py	2026-05-28 01:34:12.317313783 +0000
@@ -92,9 +92,11 @@
     Queries ``card.cost_reduction(game)`` and clamps the result so that
     the generic portion of the mana cost cannot go below 0.
 
-    This is a simplified single-card self-reduction model.  Full MTG
-    cost-reduction interactions (Trinisphere, multiple reductions from
-    different sources) are deferred.
+    Also consults ``game.active_cost_reducers`` — a list of reducer dicts
+    added by permanent abilities (e.g. Witherbloom granting affinity for
+    creatures to instants/sorceries).  Each dict has:
+        ``condition``: callable(card) -> bool
+        ``reduction``: callable(game, controller) -> int
     """
     # Ensure card.controller is set so the hook can reference "you" / the
     # casting player even when the card was never explicitly assigned one.
@@ -104,6 +106,25 @@
     # Restore previous controller in case the caller doesn't want a
     # side-effect (get_cost_reduction is a query, not a mutation).
     card.controller = prev_controller
+
+    # Consult active_cost_reducers from permanents on the battlefield.
+    active_reducers = getattr(game, "active_cost_reducers", [])
+    for reducer in active_reducers:
+        condition = reducer.get("condition")
+        reduction_fn = reducer.get("reduction")
+        try:
+            if condition is not None and not condition(card):
+                continue
+        except (AttributeError, TypeError):
+            # Malformed condition callable — skip this reducer entry.
+            continue
+        try:
+            if reduction_fn is not None:
+                raw += reduction_fn(game, controller)
+        except (AttributeError, TypeError):
+            # Malformed reduction callable — skip this reducer entry.
+            continue
+
     generic = card.mana_cost.generic if card.mana_cost else 0
     return max(0, min(raw, generic))
 
@@ -405,6 +426,10 @@
         # Move from stack to battlefield via move_to_zone, which handles
         # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.
         move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)
+    elif getattr(card, "exile_on_resolve", False):
+        # Cards with exile_on_resolve=True (e.g. Paradigm spells) go to exile
+        # instead of the graveyard after resolving.
+        move_to_zone(game, card, Zone.STACK, Zone.EXILE)
     else:
         # Instant/sorcery: move from stack to graveyard via move_to_zone.
         move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)
