rn game.active_player\n\n        # p2's next two turns are skipped, so p1 takes the next two turns\n        # and only then does p2 get one.\n        assert _next_turn_active() is p1\n        assert _next_turn_active() is p1\n        assert _next_turn_active() is p2\n        assert p2.skip_turns == 0\n        # Normal rotation resumes afterwards.\n        assert _next_turn_active() is p1\n        assert _next_turn_active() is p2"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":297,"cache_creation_input_tokens":2863,"cache_read_input_tokens":337280,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2863},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"78fe79ca-00fe-4179-aa95-c5eccecb1b0f","uuid":"6cd33e93-5ec9-40c2-a89c-20bf241a79bb","request_id":"req_011CbvpeafkEx1n1SWzk7ZZv"}
