{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BEMqkLcVkVHwsrpAKELVP4","type":"tool_result","content":"1\t\"\"\"Typed event objects for triggered abilities and replacement effects.\n2\t\n3\tTriggered events are passed to :meth:`TriggerManager.fire_event` and\n4\tforwarded to trigger condition callables.\n5\t\n6\tReplacement events are passed to :meth:`ReplacementManager.apply` and\n7\tforwarded to replacement condition/replacement callables.  Subclassing\n8\tencodes event-type hierarchy so a replacement registered for a parent\n9\ttype (e.g. ``MoveToGraveyardReplacementEvent``) also fires for\n10\tsubtypes (e.g. ``CreatureDiesReplacementEvent``).\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\tfrom dataclasses import dataclass\n16\tfrom typing import Any\n17\t\n18\t\n19\t# ---------------------------------------------------------------------------\n20\t# Triggered events\n21\t# ---------------------------------------------------------------------------\n22\t\n23\t@dataclass\n24\tclass TriggeredEvent:\n25\t    \"\"\"Base class for all triggered-ability events.\"\"\"\n26\t\n27\t\n28\t@dataclass\n29\tclass EntersBattlefieldTriggeredEvent(TriggeredEvent):\n30\t    permanent: Any = None\n31\t    controller: Any = None\n32\t    card: Any = None\n33\t    creature: Any = None\n34\t\n35\t\n36\t@dataclass\n37\tclass LeavesBattlefieldTriggeredEvent(TriggeredEvent):\n38\t    permanent: Any = None\n39\t    controller: Any = None\n40\t\n41\t\n42\t@dataclass\n43\tclass DealsDamageTriggeredEvent(TriggeredEvent):\n44\t    source: Any = None\n45\t    target: Any = None\n46\t    amount: int = 0\n47\t    is_combat: bool = False\n48\t    combat: bool = False\n49\t\n50\t\n51\t@dataclass\n52\tclass LosesLifeTriggeredEvent(TriggeredEvent):\n53\t    player: Any = None\n54\t    amount: int = 0\n55\t\n56\t\n57\t@dataclass\n58\tclass GainsLifeTriggeredEvent(TriggeredEvent):\n59\t    player: Any = None\n60\t    amount: int = 0\n61\t\n62\t\n63\t@dataclass\n64\tclass DrawsCardTriggeredEvent(TriggeredEvent):\n65\t    player: Any = None\n66\t    card: Any = None\n67\t\n68\t\n69\t@dataclass\n70\tclass BeginningOfUpkeepTriggeredEvent(TriggeredEvent):\n71\t    pass\n72\t\n73\t\n74\t@dataclass\n75\tclass BeginningOfCombatTriggeredEvent(TriggeredEvent):\n76\t    pass\n77\t\n78\t\n79\t@dataclass\n80\tclass EndOfTurnTriggeredEvent(TriggeredEvent):\n81\t    pass\n82\t\n83\t\n84\t@dataclass\n85\tclass EndStepTriggeredEvent(TriggeredEvent):\n86\t    player: Any = None\n87\t\n88\t\n89\t@dataclass\n90\tclass CreatureDiesTriggeredEvent(TriggeredEvent):\n91\t    creature: Any = None\n92\t    controller: Any = None\n93\t    owner: Any = None\n94\t\n95\t\n96\t@dataclass\n97\tclass SpellCastTriggeredEvent(TriggeredEvent):\n98\t    spell: Any = None\n99\t    player: Any = None\n100\t    card: Any = None\n101\t    controller: Any = None\n102\t\n103\t\n104\t@dataclass\n105\tclass AttacksTriggeredEvent(TriggeredEvent):\n106\t    creature: Any = None\n107\t    attacker: Any = None\n108\t\n109\t\n110\t@dataclass\n111\tclass BlocksTriggeredEvent(TriggeredEvent):\n112\t    creature: Any = None\n113\t\n114\t\n115\t@dataclass\n116\tclass CounterAddedTriggeredEvent(TriggeredEvent):\n117\t    permanent: Any = None\n118\t    counter_type: Any = None\n119\t    amount: int = 0\n120\t\n121\t\n122\t# ---------------------------------------------------------------------------\n123\t# Replacement events\n124\t# ---------------------------------------------------------------------------\n125\t\n126\t@dataclass\n127\tclass ReplacementEvent:\n128\t    \"\"\"Base class for all replacement-effect events.\"\"\"\n129\t\n130\t\n131\t@dataclass\n132\tclass MoveToGraveyardReplacementEvent(ReplacementEvent):\n133\t    \"\"\"Any permanent moving to a graveyard.\n134\t\n135\t    Subclass this for specific causes (destruction, sacrifice, etc.).\n136\t    A replacement registered for this type also fires for all subtypes.\n137\t\n138\t    ``destination`` may be mutated by a replacement to redirect the\n139\t    permanent to a different zone (``\"exile\"``, ``\"library\"``, ``\"hand\"``).\n140\t    Set ``prevented = True`` to signal that the replacement handled the\n141\t    zone move itself and the engine should skip its own move.\n142\t    \"\"\"\n143\t\n144\t    destination: str = \"graveyard\"\n145\t    controller: Any = None\n146\t    owner: Any = None\n147\t    prevented: bool = False\n148\t\n149\t    @property\n150\t    def card(self) -> Any:\n151\t        \"\"\"The object moving to the graveyard (overridden by subclasses).\"\"\"\n152\t        return None\n153\t\n154\t\n155\t@dataclass\n156\tclass CreatureDiesReplacementEvent(MoveToGraveyardReplacementEvent):\n157\t    \"\"\"A creature going to the graveyard via destruction or lethal damage.\"\"\"\n158\t\n159\t    creature: Any = None\n160\t\n161\t    @property\n162\t    def card(self) -> Any:\n163\t        return self.creature\n164\t\n165\t\n166\t@dataclass\n167\tclass PermanentDestroyedReplacementEvent(MoveToGraveyardReplacementEvent):\n168\t    \"\"\"A non-creature permanent going to the graveyard via destruction.\"\"\"\n169\t\n170\t    permanent: Any = None\n171\t\n172\t    @property\n173\t    def card(self) -> Any:\n174\t        return self.permanent\n175\t\n176\t\n177\t@dataclass\n178\tclass SacrificeReplacementEvent(MoveToGraveyardReplacementEvent):\n179\t    \"\"\"A permanent going to the graveyard via sacrifice.\"\"\"\n180\t\n181\t    permanent: Any = None\n182\t\n183\t    @property\n184\t    def card(self) -> Any:\n185\t        return self.permanent\n186\t\n187\t\n188\t@dataclass\n189\tclass CreateTokenReplacementEvent(ReplacementEvent):\n190\t    \"\"\"An effect about to create one or more tokens.\"\"\"\n191\t\n192\t    player: Any = None\n193\t    count: int = 1\n194\t\n195\t\n196\t@dataclass\n197\tclass AddCounterReplacementEvent(ReplacementEvent):\n198\t    \"\"\"An effect about to add one or more counters to a permanent.\"\"\"\n199\t\n200\t    permanent: Any = None\n201\t    amount: int = 1\n202\t"}]},"parent_tool_use_id":null,"session_id":"78fe79ca-00fe-4179-aa95-c5eccecb1b0f","uuid":"4c734755-1d07-4ee7-a71c-65448a26bfa3","timestamp":"2026-06-11T03:29:36.853Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/events.py","content":"\"\"\"Typed event objects for triggered abilities and replacement effects.\n\nTriggered events are passed to :meth:`TriggerManager.fire_event` and\nforwarded to trigger condition callables.\n\nReplacement events are passed to :meth:`ReplacementManager.apply` and\nforwarded to replacement condition/replacement callables.  Subclassing\nencodes event-type hierarchy so a replacement registered for a parent\ntype (e.g. ``MoveToGraveyardReplacementEvent``) also fires for\nsubtypes (e.g. ``CreatureDiesReplacementEvent``).\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom typing import Any\n\n\n# ---------------------------------------------------------------------------\n# Triggered events\n# ---------------------------------------------------------------------------\n\n@dataclass\nclass TriggeredEvent:\n    \"\"\"Base class for all triggered-ability events.\"\"\"\n\n\n@dataclass\nclass EntersBattlefieldTriggeredEvent(TriggeredEvent):\n    permanent: Any = None\n    controller: Any = None\n    card: Any = None\n    creature: Any = None\n\n\n@dataclass\nclass LeavesBattlefieldTriggeredEvent(TriggeredEvent):\n    permanent: Any = None\n    controller: Any = None\n\n\n@dataclass\nclass DealsDamageTriggeredEvent(TriggeredEvent):\n    source: Any = None\n    target: Any = None\n    amount: int = 0\n    is_combat: bool = False\n    combat: bool = False\n\n\n@dataclass\nclass LosesLifeTriggeredEvent(TriggeredEvent):\n    player: Any = None\n    amount: int = 0\n\n\n@dataclass\nclass GainsLifeTriggeredEvent(TriggeredEvent):\n    player: Any = None\n    amount: int = 0\n\n\n@dataclass\nclass DrawsCardTriggeredEvent(TriggeredEvent):\n    player: Any = None\n    card: Any = None\n\n\n@dataclass\nclass BeginningOfUpkeepTriggeredEvent(TriggeredEvent):\n    pass\n\n\n@dataclass\nclass BeginningOfCombatTriggeredEvent(TriggeredEvent):\n    pass\n\n\n@dataclass\nclass EndOfTurnTriggeredEvent(TriggeredEvent):\n    pass\n\n\n@dataclass\nclass EndStepTriggeredEvent(TriggeredEvent):\n    player: Any = None\n\n\n@dataclass\nclass CreatureDiesTriggeredEvent(TriggeredEvent):\n    creature: Any = None\n    controller: Any = None\n    owner: Any = None\n\n\n@dataclass\nclass SpellCastTriggeredEvent(TriggeredEvent):\n    spell: Any = None\n    player: Any = None\n    card: Any = None\n    controller: Any = None\n\n\n@dataclass\nclass AttacksTriggeredEvent(TriggeredEvent):\n    creature: Any = None\n    attacker: Any = None\n\n\n@dataclass\nclass BlocksTriggeredEvent(TriggeredEvent):\n    creature: Any = None\n\n\n@dataclass\nclass CounterAddedTriggeredEvent(TriggeredEvent):\n    permanent: Any = None\n    counter_type: Any = None\n    amount: int = 0\n\n\n# ---------------------------------------------------------------------------\n# Replacement events\n# ---------------------------------------------------------------------------\n\n@dataclass\nclass ReplacementEvent:\n    \"\"\"Base class for all replacement-effect events.\"\"\"\n\n\n@dataclass\nclass MoveToGraveyardReplacementEvent(ReplacementEvent):\n    \"\"\"Any permanent moving to a graveyard.\n\n    Subclass this for specific causes (destruction, sacrifice, etc.).\n    A replacement registered for this type also fires for all subtypes.\n\n    ``destination`` may be mutated by a replacement to redirect the\n    permanent to a different zone (``\"exile\"``, ``\"library\"``, ``\"hand\"``).\n    Set ``prevented = True`` to signal that the replacement handled the\n    zone move itself and the engine should skip its own move.\n    \"\"\"\n\n    destination: str = \"graveyard\"\n    controller: Any = None\n    owner: Any = None\n    prevented: bool = False\n\n    @property\n    def card(self) -> Any:\n        \"\"\"The object moving to the graveyard (overridden by subclasses).\"\"\"\n        return None\n\n\n@dataclass\nclass CreatureDiesReplacementEvent(MoveToGraveyardReplacementEvent):\n    \"\"\"A creature going to the graveyard via destruction or lethal damage.\"\"\"\n\n    creature: Any = None\n\n    @property\n    def card(self) -> Any:\n        return self.creature\n\n\n@dataclass\nclass PermanentDestroyedReplacementEvent(MoveToGraveyardReplacementEvent):\n    \"\"\"A non-creature permanent going to the graveyard via destruction.\"\"\"\n\n    permanent: Any = None\n\n    @property\n    def card(self) -> Any:\n        return self.permanent\n\n\n@dataclass\nclass SacrificeReplacementEvent(MoveToGraveyardReplacementEvent):\n    \"\"\"A permanent going to the graveyard via sacrifice.\"\"\"\n\n    permanent: Any = None\n\n    @property\n    def card(self) -> Any:\n        return self.permanent\n\n\n@dataclass\nclass CreateTokenReplacementEvent(ReplacementEvent):\n    \"\"\"An effect about to create one or more tokens.\"\"\"\n\n    player: Any = None\n    count: int = 1\n\n\n@dataclass\nclass AddCounterReplacementEvent(ReplacementEvent):\n    \"\"\"An effect about to add one or more counters to a permanent.\"\"\"\n\n    permanent: Any = None\n    amount: int = 1\n","numLines":202,"startLine":1,"totalLines":202}}}
