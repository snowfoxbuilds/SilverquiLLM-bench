ty — cost could not be paid\")\n\n    # 3. Resolve or push\n    if ability.is_mana_ability:\n        # Mana abilities resolve immediately without using the stack.\n        ability.effect(game)\n    else:\n        # Push to stack for resolution.\n        stack_obj = StackObject(\n            source=ability.source,\n            controller=player,\n            targets=list(targets) if targets else [],\n            on_resolve=ability.effect,\n            is_mana_ability=False,\n        )\n        if targets is not None:\n            stack_obj.on_resolve = _with_chosen_targets(\n                ability.source, stack_obj, ability.effect\n            )\n        game.stack.push(stack_obj)"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1373,"cache_read_input_tokens":331301,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1373},"output_tokens":52,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"78fe79ca-00fe-4179-aa95-c5eccecb1b0f","uuid":"6f7fabca-423a-43c0-8177-1ae356317c19","request_id":"req_011CbvpWJWvcKZqbDo7TP4v3"}
