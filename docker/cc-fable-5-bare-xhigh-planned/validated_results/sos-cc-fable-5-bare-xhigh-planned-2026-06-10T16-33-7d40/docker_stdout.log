{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SzBoJJV7YDQk9LJzp4iwpC","type":"tool_result","content":"1\t\"\"\"Card implementation for Imprisoned in the Moon.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Aura\n8\tfrom engine.continuous_effects import (\n9\t    ContinuousEffect,\n10\t    DURATION_PERMANENT,\n11\t    Layer,\n12\t)\n13\tfrom engine.types import CardType, Keyword, ManaCost, TargetRequirement, Zone\n14\t\n15\tif TYPE_CHECKING:\n16\t    from engine.game_state import GameState\n17\t\n18\t\n19\tdef _is_on_battlefield(game: Any, obj: Any) -> bool:\n20\t    \"\"\"Check if *obj* is on any player's battlefield.\"\"\"\n21\t    for player in game.players:\n22\t        if game.get_battlefield(player).contains(obj):\n23\t            return True\n24\t    return False\n25\t\n26\t\n27\tdef _get_chosen_target(card: Any, game: Any) -> Any:\n28\t    chosen = getattr(card, \"chosen_targets\", None)\n29\t    if chosen:\n30\t        return chosen[0]\n31\t    return getattr(card, \"_resolve_target\", None)\n32\t\n33\t\n34\tdef _creature_land_planeswalker_targets(game: Any) -> list[Any]:\n35\t    \"\"\"Return creatures, lands, and planeswalkers on the battlefield.\"\"\"\n36\t    targets: list[Any] = []\n37\t    for player in game.players:\n38\t        for obj in game.get_battlefield(player).get_all():\n39\t            ctypes = getattr(obj, \"card_types\", set())\n40\t            if (\n41\t                CardType.CREATURE in ctypes\n42\t                or CardType.LAND in ctypes\n43\t                or CardType.PLANESWALKER in ctypes\n44\t            ):\n45\t                targets.append(obj)\n46\t    return targets\n47\t\n48\t\n49\tclass ImprisonedInTheMoon(Aura):\n50\t    \"\"\"Imprisoned in the Moon — {2}{U}.\n51\t\n52\t    Enchant creature, land, or planeswalker.\n53\t    Enchanted permanent is a colorless land with \"{T}: Add {C}\" and loses\n54\t    all other card types and abilities.\n55\t    \"\"\"\n56\t\n57\t    def __init__(self, **kwargs: Any) -> None:\n58\t        kwargs.setdefault(\"name\", \"Imprisoned in the Moon\")\n59\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{2}{U}\"))\n60\t        kwargs.setdefault(\"subtypes\", set())\n61\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Aura\"}\n62\t        kwargs.setdefault(\n63\t            \"rules_text\",\n64\t            \"Enchant creature, land, or planeswalker\\n\"\n65\t            \"Enchanted permanent is a colorless land with \"\n66\t            '\"{T}: Add {C}\" and loses all other card types and abilities.',\n67\t        )\n68\t        super().__init__(**kwargs)\n69\t        self._type_effect_ref: ContinuousEffect | None = None\n70\t        self._color_effect_ref: ContinuousEffect | None = None\n71\t        self._ability_effect_ref: ContinuousEffect | None = None\n72\t\n73\t    # -- targeting --------------------------------------------------------\n74\t\n75\t    def get_targets(self, game: GameState) -> list[Any]:\n76\t        targets = _creature_land_planeswalker_targets(game)\n77\t        if not targets:\n78\t            return []\n79\t        return [\n80\t            TargetRequirement(\n81\t                filter_fn=lambda obj: bool(\n82\t                    getattr(obj, \"card_types\", set())\n83\t                    & {CardType.CREATURE, CardType.LAND, CardType.PLANESWALKER}\n84\t                ),\n85\t                description=\"enchant creature, land, or planeswalker\",\n86\t                zone=Zone.BATTLEFIELD,\n87\t            )\n88\t        ]\n89\t\n90\t    def can_cast(self, game: GameState) -> bool:\n91\t        return bool(_creature_land_planeswalker_targets(game))\n92\t\n93\t    # -- resolution -------------------------------------------------------\n94\t\n95\t    def on_resolve(self, game: GameState) -> None:\n96\t        target = _get_chosen_target(self, game)\n97\t        if target is None:\n98\t            return\n99\t        if not _is_on_battlefield(game, target):\n100\t            return\n101\t        # Revalidate that target is still a creature, land, or planeswalker.\n102\t        ctypes = getattr(target, \"card_types\", set())\n103\t        if not (ctypes & {CardType.CREATURE, CardType.LAND, CardType.PLANESWALKER}):\n104\t            return\n105\t        self.attached_to = target\n106\t        self._register_effects(game)\n107\t\n108\t    # -- continuous effects -----------------------------------------------\n109\t    #\n110\t    # Layer 4 (TYPE): The permanent becomes a land, losing all other card\n111\t    #   types and subtypes.\n112\t    # Layer 5 (COLOR): The permanent becomes colorless.\n113\t    # Layer 6 (ABILITY): The permanent loses all abilities.\n114\t    #\n115\t    # The card also grants \"{T}: Add {C}\" — see ENGINE LIMITATION below.\n116\t\n117\t    def apply_continuous_effect(self, game: GameState) -> None:\n118\t        \"\"\"Apply type-changing, color, and ability-removal effects.\"\"\"\n119\t        perm = self.attached_to\n120\t        if perm is None or not _is_on_battlefield(game, perm):\n121\t            return\n122\t        if not _is_on_battlefield(game, self):\n123\t            return\n124\t        self._apply_type_change(perm)\n125\t        self._apply_color_change(perm)\n126\t        self._apply_ability_removal(perm)\n127\t\n128\t    def _apply_type_change(self, perm: Any) -> None:\n129\t        \"\"\"Layer 4: Becomes a land, loses other card types.\"\"\"\n130\t        perm.card_types = {CardType.LAND}\n131\t        perm.subtypes = set()\n132\t\n133\t    def _apply_color_change(self, perm: Any) -> None:\n134\t        \"\"\"Layer 5: Becomes colorless.\"\"\"\n135\t        if hasattr(perm, \"colors\"):\n136\t            perm.colors = set()\n137\t\n138\t    def _apply_ability_removal(self, perm: Any) -> None:\n139\t        \"\"\"Layer 6: Loses all abilities.\"\"\"\n140\t        perm.keywords = Keyword(0)\n141\t        # Mark permanent as having lost abilities for combat/activation checks.\n142\t        # Guard behind type checks — only creatures can attack/block.\n143\t        if CardType.CREATURE in getattr(perm, \"card_types\", set()):\n144\t            perm._cant_attack = True  # type: ignore[attr-defined]\n145\t            perm._cant_block = True  # type: ignore[attr-defined]\n146\t        if hasattr(perm, \"_cant_activate\"):\n147\t            perm._cant_activate = True  # type: ignore[attr-defined]\n148\t        perm._imprisoned = True  # type: ignore[attr-defined]\n149\t\n150\t    def _register_effects(self, game: GameState) -> None:\n151\t        aura_ref = self\n152\t\n153\t        # Layer 4: Type-changing effect\n154\t        def _apply_type(game: GameState) -> None:\n155\t            if not _is_on_battlefield(game, aura_ref):\n156\t                return\n157\t            perm = aura_ref.attached_to\n158\t            if perm is None or not _is_on_battlefield(game, perm):\n159\t                return\n160\t            aura_ref._apply_type_change(perm)\n161\t\n162\t        type_effect = ContinuousEffect(\n163\t            source=aura_ref,\n164\t            layer=Layer.TYPE,\n165\t            sublayer=None,\n166\t            apply=_apply_type,\n167\t            duration=DURATION_PERMANENT,\n168\t        )\n169\t        self._type_effect_ref = game.effect_manager.add(type_effect)\n170\t\n171\t        # Layer 5: Color-changing effect (colorless)\n172\t        def _apply_color(game: GameState) -> None:\n173\t            if not _is_on_battlefield(game, aura_ref):\n174\t                return\n175\t            perm = aura_ref.attached_to\n176\t            if perm is None or not _is_on_battlefield(game, perm):\n177\t                return\n178\t            aura_ref._apply_color_change(perm)\n179\t\n180\t        color_effect = ContinuousEffect(\n181\t            source=aura_ref,\n182\t            layer=Layer.COLOR,\n183\t            sublayer=None,\n184\t            apply=_apply_color,\n185\t            duration=DURATION_PERMANENT,\n186\t        )\n187\t        self._color_effect_ref = game.effect_manager.add(color_effect)\n188\t\n189\t        # Layer 6: Ability-removal effect\n190\t        def _apply_ability(game: GameState) -> None:\n191\t            if not _is_on_battlefield(game, aura_ref):\n192\t                return\n193\t            perm = aura_ref.attached_to\n194\t            if perm is None or not _is_on_battlefield(game, perm):\n195\t                return\n196\t            aura_ref._apply_ability_removal(perm)\n197\t\n198\t        ability_effect = ContinuousEffect(\n199\t            source=aura_ref,\n200\t            layer=Layer.ABILITY,\n201\t            sublayer=None,\n202\t            apply=_apply_ability,\n203\t            duration=DURATION_PERMANENT,\n204\t        )\n205\t        self._ability_effect_ref = game.effect_manager.add(ability_effect)\n206\t\n207\t        # ENGINE LIMITATION: The enchanted permanent should gain the mana\n208\t        # ability \"{T}: Add {C}\".  Implementing this properly requires engine\n209\t        # support for dynamically granting activated mana abilities to\n210\t        # permanents via continuous effects.  Currently the engine has no\n211\t        # mechanism to inject a ManaAbility into an arbitrary permanent at\n212\t        # the continuous-effect layer.\n213\t"}]},"parent_tool_use_id":null,"session_id":"91030fde-ab39-43e5-99c8-7491eecaa6bd","uuid":"9ebea858-0a22-410e-a905-4bb327c452cb","timestamp":"2026-06-10T16:54:00.071Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_156/card_impl.py","content":"\"\"\"Card implementation for Imprisoned in the Moon.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import Aura\nfrom engine.continuous_effects import (\n    ContinuousEffect,\n    DURATION_PERMANENT,\n    Layer,\n)\nfrom engine.types import CardType, Keyword, ManaCost, TargetRequirement, Zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\ndef _is_on_battlefield(game: Any, obj: Any) -> bool:\n    \"\"\"Check if *obj* is on any player's battlefield.\"\"\"\n    for player in game.players:\n        if game.get_battlefield(player).contains(obj):\n            return True\n    return False\n\n\ndef _get_chosen_target(card: Any, game: Any) -> Any:\n    chosen = getattr(card, \"chosen_targets\", None)\n    if chosen:\n        return chosen[0]\n    return getattr(card, \"_resolve_target\", None)\n\n\ndef _creature_land_planeswalker_targets(game: Any) -> list[Any]:\n    \"\"\"Return creatures, lands, and planeswalkers on the battlefield.\"\"\"\n    targets: list[Any] = []\n    for player in game.players:\n        for obj in game.get_battlefield(player).get_all():\n            ctypes = getattr(obj, \"card_types\", set())\n            if (\n                CardType.CREATURE in ctypes\n                or CardType.LAND in ctypes\n                or CardType.PLANESWALKER in ctypes\n            ):\n                targets.append(obj)\n    return targets\n\n\nclass ImprisonedInTheMoon(Aura):\n    \"\"\"Imprisoned in the Moon — {2}{U}.\n\n    Enchant creature, land, or planeswalker.\n    Enchanted permanent is a colorless land with \"{T}: Add {C}\" and loses\n    all other card types and abilities.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"Imprisoned in the Moon\")\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{2}{U}\"))\n        kwargs.setdefault(\"subtypes\", set())\n        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Aura\"}\n        kwargs.setdefault(\n            \"rules_text\",\n            \"Enchant creature, land, or planeswalker\\n\"\n            \"Enchanted permanent is a colorless land with \"\n            '\"{T}: Add {C}\" and loses all other card types and abilities.',\n        )\n        super().__init__(**kwargs)\n        self._type_effect_ref: ContinuousEffect | None = None\n        self._color_effect_ref: ContinuousEffect | None = None\n        self._ability_effect_ref: ContinuousEffect | None = None\n\n    # -- targeting --------------------------------------------------------\n\n    def get_targets(self, game: GameState) -> list[Any]:\n        targets = _creature_land_planeswalker_targets(game)\n        if not targets:\n            return []\n        return [\n            TargetRequirement(\n                filter_fn=lambda obj: bool(\n                    getattr(obj, \"card_types\", set())\n                    & {CardType.CREATURE, CardType.LAND, CardType.PLANESWALKER}\n                ),\n                description=\"enchant creature, land, or planeswalker\",\n                zone=Zone.BATTLEFIELD,\n            )\n        ]\n\n    def can_cast(self, game: GameState) -> bool:\n        return bool(_creature_land_planeswalker_targets(game))\n\n    # -- resolution -------------------------------------------------------\n\n    def on_resolve(self, game: GameState) -> None:\n        target = _get_chosen_target(self, game)\n        if target is None:\n            return\n        if not _is_on_battlefield(game, target):\n            return\n        # Revalidate that target is still a creature, land, or planeswalker.\n        ctypes = getattr(target, \"card_types\", set())\n        if not (ctypes & {CardType.CREATURE, CardType.LAND, CardType.PLANESWALKER}):\n            return\n        self.attached_to = target\n        self._register_effects(game)\n\n    # -- continuous effects -----------------------------------------------\n    #\n    # Layer 4 (TYPE): The permanent becomes a land, losing all other card\n    #   types and subtypes.\n    # Layer 5 (COLOR): The permanent becomes colorless.\n    # Layer 6 (ABILITY): The permanent loses all abilities.\n    #\n    # The card also grants \"{T}: Add {C}\" — see ENGINE LIMITATION below.\n\n    def apply_continuous_effect(self, game: GameState) -> None:\n        \"\"\"Apply type-changing, color, and ability-removal effects.\"\"\"\n        perm = self.attached_to\n        if perm is None or not _is_on_battlefield(game, perm):\n            return\n        if not _is_on_battlefield(game, self):\n            return\n        self._apply_type_change(perm)\n        self._apply_color_change(perm)\n        self._apply_ability_removal(perm)\n\n    def _apply_type_change(self, perm: Any) -> None:\n        \"\"\"Layer 4: Becomes a land, loses other card types.\"\"\"\n        perm.card_types = {CardType.LAND}\n        perm.subtypes = set()\n\n    def _apply_color_change(self, perm: Any) -> None:\n        \"\"\"Layer 5: Becomes colorless.\"\"\"\n        if hasattr(perm, \"colors\"):\n            perm.colors = set()\n\n    def _apply_ability_removal(self, perm: Any) -> None:\n        \"\"\"Layer 6: Loses all abilities.\"\"\"\n        perm.keywords = Keyword(0)\n        # Mark permanent as having lost abilities for combat/activation checks.\n        # Guard behind type checks — only creatures can attack/block.\n        if CardType.CREATURE in getattr(perm, \"card_types\", set()):\n            perm._cant_attack = True  # type: ignore[attr-defined]\n            perm._cant_block = True  # type: ignore[attr-defined]\n        if hasattr(perm, \"_cant_activate\"):\n            perm._cant_activate = True  # type: ignore[attr-defined]\n        perm._imprisoned = True  # type: ignore[attr-defined]\n\n    def _register_effects(self, game: GameState) -> None:\n        aura_ref = self\n\n        # Layer 4: Type-changing effect\n        def _apply_type(game: GameState) -> None:\n            if not _is_on_battlefield(game, aura_ref):\n                return\n            perm = aura_ref.attached_to\n            if perm is None or not _is_on_battlefield(game, perm):\n                return\n            aura_ref._apply_type_change(perm)\n\n        type_effect = ContinuousEffect(\n            source=aura_ref,\n            layer=Layer.TYPE,\n            sublayer=None,\n            apply=_apply_type,\n            duration=DURATION_PERMANENT,\n        )\n        self._type_effect_ref = game.effect_manager.add(type_effect)\n\n        # Layer 5: Color-changing effect (colorless)\n        def _apply_color(game: GameState) -> None:\n            if not _is_on_battlefield(game, aura_ref):\n                return\n            perm = aura_ref.attached_to\n            if perm is None or not _is_on_battlefield(game, perm):\n                return\n            aura_ref._apply_color_change(perm)\n\n        color_effect = ContinuousEffect(\n            source=aura_ref,\n            layer=Layer.COLOR,\n            sublayer=None,\n            apply=_apply_color,\n            duration=DURATION_PERMANENT,\n        )\n        self._color_effect_ref = game.effect_manager.add(color_effect)\n\n        # Layer 6: Ability-removal effect\n        def _apply_ability(game: GameState) -> None:\n            if not _is_on_battlefield(game, aura_ref):\n                return\n            perm = aura_ref.attached_to\n            if perm is None or not _is_on_battlefield(game, perm):\n                return\n            aura_ref._apply_ability_removal(perm)\n\n        ability_effect = ContinuousEffect(\n            source=aura_ref,\n            layer=Layer.ABILITY,\n            sublayer=None,\n            apply=_apply_ability,\n            duration=DURATION_PERMANENT,\n        )\n        self._ability_effect_ref = game.effect_manager.add(ability_effect)\n\n        # ENGINE LIMITATION: The enchanted permanent should gain the mana\n        # ability \"{T}: Add {C}\".  Implementing this properly requires engine\n        # support for dynamically granting activated mana abilities to\n        # permanents via continuous effects.  Currently the engine has no\n        # mechanism to inject a ManaAbility into an arbitrary permanent at\n        # the continuous-effect layer.\n","numLines":213,"startLine":1,"totalLines":213}}}
