rn = 0\n165\t\n166\t    def _select_next_active_player(self) -> None:\n167\t        \"\"\"Pick who takes the next turn (extra-turns queue, then rotation).\n168\t\n169\t        ENGINE LIMITATION: Extra turns queue (FIFO). Pop the next player\n170\t        seat index; that player gets the next turn.  Normal rotation is\n171\t        NOT advanced — extra turns are inserted before the normal next turn.\n172\t        \"\"\"\n173\t        if self.extra_turns:\n174\t            self.active_player_index = self.extra_turns.pop(0)\n175\t        else:\n176\t            self.active_player_index = self._normal_next_index\n177\t            self._normal_next_index = 1 - self._normal_next_index\n178\t\n179\t        self.empty_mana_pools()\n180\t\n181\t        # Fire the precombat-main event from this single chokepoint so it\n182\t        # behaves identically whether a turn runs normally or the state is\n183\t        # advanced directly.  Fired after empty_mana_pools() so mana a\n184\t        # handler adds survives into the main phase.\n185\t        if self.phase == Phase.PRECOMBAT_MAIN:\n186\t            from engine.events import BeginningOfPrecombatMainTriggeredEvent\n187\t\n188\t            self.trigger_manager.fire_event(\n189\t                self, BeginningOfPrecombatMainTriggeredEvent()\n190\t            )\n191\t\n192\t    def empty_mana_pools(self) -> None:\n193\t        \"\"\"Empty all players' mana pools — called on each phase/step transition.\"\"\"\n194\t        for player in self.players:\n195\t            player.mana_pool.empty()\n196\t"}]},"parent_tool_use_id":null,"session_id":"7ce0e410-080e-42f6-b0e7-fdb5c9b29b22","uuid":"d1520628-33fb-40b9-9467-3fcdb690aeca","timestamp":"2026-06-11T05:58:30.043Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/game_state.py","content":"    # ------------------------------------------------------------------\n\n    def advance_phase(self) -> None:\n        \"\"\"Advance to the next phase/step in MTG turn order.\n\n        At the end of CLEANUP, the turn number is incremented and the\n        active player swaps (2-player assumption).  Mana pools are\n        emptied on every transition.\n        \"\"\"\n        current = (self.phase, self.step)\n        idx = _TURN_SEQUENCE.index(current)\n\n        if idx + 1 < len(_TURN_SEQUENCE):\n            # Move to next phase/step within the same turn.\n            next_phase, next_step = _TURN_SEQUENCE[idx + 1]\n            self.phase = next_phase\n            self.step = next_step\n        else:\n            # End of turn — wrap around.\n            self.turn_number += 1\n            self._select_next_active_player()\n            # Skip-turns support (\"target opponent skips their next X\n            # turns\"): a player with pending skip_turns forfeits each\n            # skipped turn.  Each pass decrements someone's counter, so\n            # this always terminates.\n            while getattr(self.players[self.active_player_index], \"skip_turns\", 0) > 0:\n                self.players[self.active_player_index].skip_turns -= 1\n                self._select_next_active_player()\n            self.priority_player_index = self.active_player_index\n            self.phase = _TURN_SEQUENCE[0][0]\n            self.step = _TURN_SEQUENCE[0][1]\n            # New turn — reset per-turn draw tracking (used by \"first card\n            # you drew this turn\" mechanics such as miracle).\n            for player in self.players:\n                player.cards_drawn_this_turn = 0\n\n    def _select_next_active_player(self) -> None:\n        \"\"\"Pick who takes the next turn (extra-turns queue, then rotation).\n\n        ENGINE LIMITATION: Extra turns queue (FIFO). Pop the next player\n        seat index; that player gets the next turn.  Normal rotation is\n        NOT advanced — extra turns are inserted before the normal next turn.\n        \"\"\"\n        if self.extra_turns:\n            self.active_player_index = self.extra_turns.pop(0)\n        else:\n            self.active_player_index = self._normal_next_index\n            self._normal_next_index = 1 - self._normal_next_index\n\n        self.empty_mana_pools()\n\n        # Fire the precombat-main event from this single chokepoint so it\n        # behaves identically whether a turn runs normally or the state is\n        # advanced directly.  Fired after empty_mana_pools() so mana a\n        # handler adds survives into the main phase.\n        if self.phase == Phase.PRECOMBAT_MAIN:\n            from engine.events import BeginningOfPrecombatMainTriggeredEvent\n\n            self.trigger_manager.fire_event(\n                self, BeginningOfPrecombatMainTriggeredEvent()\n            )\n\n    def empty_mana_pools(self) -> None:\n        \"\"\"Empty all players' mana pools — called on each phase/step transition.\"\"\"\n        for player in self.players:\n            player.mana_pool.empty()\n","numLines":67,"startLine":130,"totalLines":196}}}
