turn self._pool.get(mana_type, 0) + self._restricted_pool.get(mana_type, 0)\n\n    def get_restricted(self, mana_type: ManaType) -> int:\n        \"\"\"Return the instant/sorcery-restricted amount of a mana type.\"\"\"\n        return self._restricted_pool.get(mana_type, 0)\n\n    def _merged_pool(self, allow_restricted: bool) -> dict[ManaType, int]:\n        \"\"\"Return the mana available for a payment.\n\n        Restricted mana is included only when *allow_restricted* is true.\n        \"\"\"\n        merged = dict(self._pool)\n        if allow_restricted:\n            for mt, amount in self._restricted_pool.items():\n                merged[mt] = merged.get(mt, 0) + amount\n        return merged"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8094,"cache_read_input_tokens":218537,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8094},"output_tokens":52,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"7ce0e410-080e-42f6-b0e7-fdb5c9b29b22","uuid":"6cf57ce9-e28d-4398-a66b-b3fb1328fe49","request_id":"req_011CbvvtW6FmFf16hesspjqU"}
