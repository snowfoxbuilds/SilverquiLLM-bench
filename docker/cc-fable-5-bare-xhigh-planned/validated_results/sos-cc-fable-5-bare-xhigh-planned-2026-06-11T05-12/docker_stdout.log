{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012R1UHKQ4vH2YWQb4Scnpqk","type":"tool_result","content":"1\t\"\"\"Mana pool and cost payment logic.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom engine.types import Color, HybridManaSymbol, ManaCost, ManaType\n6\t\n7\t# Map colored ManaTypes to their corresponding Color enum values.\n8\t_MANA_TO_COLOR: dict[ManaType, Color] = {\n9\t    ManaType.WHITE: Color.WHITE,\n10\t    ManaType.BLUE: Color.BLUE,\n11\t    ManaType.BLACK: Color.BLACK,\n12\t    ManaType.RED: Color.RED,\n13\t    ManaType.GREEN: Color.GREEN,\n14\t}\n15\t\n16\t\n17\tclass ManaPool:\n18\t    \"\"\"Tracks available mana for a player.\n19\t\n20\t    Internal storage uses a ``dict[ManaType, int]`` mapping each mana type\n21\t    to its current count.\n22\t    \"\"\"\n23\t\n24\t    def __init__(self) -> None:\n25\t        self._pool: dict[ManaType, int] = {mt: 0 for mt in ManaType}\n26\t        self._last_payment_colors: list[Color] = []\n27\t\n28\t    # ------------------------------------------------------------------\n29\t    # Basic operations\n30\t    # ------------------------------------------------------------------\n31\t\n32\t    def add(self, mana_type: ManaType, amount: int = 1) -> None:\n33\t        \"\"\"Add *amount* mana of the given type to the pool.\n34\t\n35\t        Parameters:\n36\t            mana_type: The type of mana to add.\n37\t            amount: How many mana to add (must be non-negative).\n38\t        \"\"\"\n39\t        if amount < 0:\n40\t            raise ValueError(f\"Cannot add negative mana: {amount}\")\n41\t        self._pool[mana_type] = self._pool.get(mana_type, 0) + amount\n42\t\n43\t    def empty(self) -> None:\n44\t        \"\"\"Clear the pool — happens at phase/step transitions.\"\"\"\n45\t        for mt in self._pool:\n46\t            self._pool[mt] = 0\n47\t\n48\t    def total(self) -> int:\n49\t        \"\"\"Return the total amount of mana in the pool across all types.\"\"\"\n50\t        return sum(self._pool.values())\n51\t\n52\t    def get(self, mana_type: ManaType) -> int:\n53\t        \"\"\"Return the amount of a specific mana type in the pool.\"\"\"\n54\t        return self._pool.get(mana_type, 0)\n55\t\n56\t    @property\n57\t    def last_payment_colors(self) -> list[Color]:\n58\t        \"\"\"Return the distinct colors of mana spent in the last :meth:`pay` call.\n59\t\n60\t        Colorless mana is not a color and is excluded.  The list is sorted\n61\t        by Color enum order for determinism.  Empty if no payment has been\n62\t        made or if all mana spent was colorless.\n63\t        \"\"\"\n64\t        return list(self._last_payment_colors)\n65\t\n66\t    # ------------------------------------------------------------------\n67\t    # Cost payment\n68\t    # ------------------------------------------------------------------\n69\t\n70\t    def can_pay(self, cost: ManaCost) -> bool:\n71\t        \"\"\"Check whether the pool can satisfy *cost*.\n72\t\n73\t        Generic mana can be paid by any type.  X is treated as 0 for\n74\t        ``can_pay`` unless explicitly set in the cost's generic component.\n75\t        Hybrid symbols can be paid with either option; this method uses\n76\t        backtracking to find a valid assignment.\n77\t\n78\t        Returns:\n79\t            True if the pool has enough mana to pay the cost.\n80\t        \"\"\"\n81\t        remaining: dict[ManaType, int] = dict(self._pool)\n82\t\n83\t        # Pay colored/colorless pips first.\n84\t        for mana_type, count in cost.pips.items():\n85\t            if remaining.get(mana_type, 0) < count:\n86\t                return False\n87\t            remaining[mana_type] = remaining.get(mana_type, 0) - count\n88\t\n89\t        # Solve hybrid symbols with backtracking.\n90\t        if cost.hybrid:\n91\t            if not self._can_pay_hybrid(remaining, list(cost.hybrid), 0, cost.generic):\n92\t                return False\n93\t            return True\n94\t\n95\t        # Then check generic — sum of all remaining mana must cover it.\n96\t        return sum(remaining.values()) >= cost.generic\n97\t\n98\t    def pay(self, cost: ManaCost, choices: dict[ManaType, int] | None = None) -> bool:\n99\t        \"\"\"Deduct mana from the pool to pay *cost*.\n100\t\n101\t        Parameters:\n102\t            cost: The mana cost to pay.\n103\t            choices: How to split the generic portion across mana types.\n104\t                If ``None``, auto-pay greedily: pay colored pips first,\n105\t                then hybrid symbols, then generic using colorless first,\n106\t                then excess colored.\n107\t\n108\t        Returns:\n109\t            True if payment succeeded, False if the pool has insufficient mana.\n110\t        \"\"\"\n111\t        if not self.can_pay(cost):\n112\t            return False\n113\t\n114\t        # Work on a copy so we can roll back on failure.\n115\t        working: dict[ManaType, int] = dict(self._pool)\n116\t\n117\t        # 1. Pay colored/colorless pips.\n118\t        for mana_type, count in cost.pips.items():\n119\t            working[mana_type] -= count\n120\t\n121\t        # 2. When explicit generic choices are provided, reserve that mana\n122\t        #    *before* solving hybrids so the solver doesn't steal it.\n123\t        generic_remaining = cost.generic\n124\t        if generic_remaining > 0 and choices is not None:\n125\t            # Reject negative choice amounts — they would create mana.\n126\t            if any(v < 0 for v in choices.values()):\n127\t                return False\n128\t            # Validate choices sum to generic cost.\n129\t            if sum(choices.values()) != generic_remaining:\n130\t                return False\n131\t            for mana_type, amount in choices.items():\n132\t                if working.get(mana_type, 0) < amount:\n133\t                    return False\n134\t                working[mana_type] -= amount\n135\t\n136\t        # 3. Pay hybrid symbols using backtracking to find a valid assignment.\n137\t        #    Generic choices (if any) have already been reserved above,\n138\t        #    so _solve_hybrid sees only the genuinely available mana.\n139\t        if cost.hybrid:\n140\t            generic_for_solver = generic_remaining if choices is None else 0\n141\t            hybrid_assignment = self._solve_hybrid(\n142\t                working, list(cost.hybrid), 0, generic_for_solver,\n143\t            )\n144\t            if hybrid_assignment is None:\n145\t                return False  # pragma: no cover – should not happen after can_pay\n146\t            for mt in hybrid_assignment:\n147\t                working[mt] = working.get(mt, 0) - 1\n148\t\n149\t        # 4. Pay generic cost (auto-pay path — choices already deducted above).\n150\t        if generic_remaining > 0 and choices is None:\n151\t            generic_remaining = self._auto_pay_generic(working, generic_remaining)\n152\t            if generic_remaining > 0:\n153\t                return False  # pragma: no cover – should not happen after can_pay\n154\t\n155\t        # Commit the payment.\n156\t        # Compute colors of mana spent by comparing old pool to new working pool.\n157\t        colors_spent: set[Color] = set()\n158\t        for mt, old_amount in self._pool.items():\n159\t            new_amount = working.get(mt, 0)\n160\t            if new_amount < old_amount and mt in _MANA_TO_COLOR:\n161\t                colors_spent.add(_MANA_TO_COLOR[mt])\n162\t        self._last_payment_colors = sorted(colors_spent, key=lambda c: c.value)\n163\t        self._pool = working\n164\t        return True\n165\t\n166\t    @staticmethod\n167\t    def _can_pay_hybrid(\n168\t        remaining: dict[ManaType, int],\n169\t        hybrids: list[HybridManaSymbol],\n170\t        idx: int,\n171\t        generic: int,\n172\t    ) -> bool:\n173\t        \"\"\"Recursively check if hybrid symbols + generic can be satisfied.\n174\t\n175\t        Uses backtracking: for each hybrid symbol, try option_a then option_b.\n176\t        After all hybrids are assigned, check that remaining mana covers generic.\n177\t        \"\"\"\n178\t        if idx >= len(hybrids):\n179\t            return sum(remaining.values()) >= generic\n180\t\n181\t        sym = hybrids[idx]\n182\t        for option in (sym.option_a, sym.option_b):\n183\t            if remaining.get(option, 0) > 0:\n184\t                remaining[option] -= 1\n185\t                if ManaPool._can_pay_hybrid(remaining, hybrids, idx + 1, generic):\n186\t                    remaining[option] += 1\n187\t                    return True\n188\t                remaining[option] += 1\n189\t        return False\n190\t\n191\t    @staticmethod\n192\t    def _solve_hybrid(\n193\t        remaining: dict[ManaType, int],\n194\t        hybrids: list[HybridManaSymbol],\n195\t        idx: int,\n196\t        generic: int,\n197\t    ) -> list[ManaType] | None:\n198\t        \"\"\"Find a valid assignment for hybrid symbols.\n199\t\n200\t        Returns a list of ManaType choices (one per hybrid symbol) or None\n201\t        if no valid assignment exists.\n202\t        \"\"\"\n203\t        if idx >= len(hybrids):\n204\t            if sum(remaining.values()) >= generic:\n205\t                return []\n206\t            return None\n207\t\n208\t        sym = hybrids[idx]\n209\t        for option in (sym.option_a, sym.option_b):\n210\t            if remaining.get(option, 0) > 0:\n211\t                remaining[option] -= 1\n212\t                result = ManaPool._solve_hybrid(remaining, hybrids, idx + 1, generic)\n213\t                if result is not None:\n214\t                    remaining[option] += 1\n215\t                    return [option] + result\n216\t                remaining[option] += 1\n217\t        return None\n218\t\n219\t    @staticmethod\n220\t    def _auto_pay_generic(working: dict[ManaType, int], amount: int) -> int:\n221\t        \"\"\"Deduct *amount* generic mana from *working*, preferring colorless.\n222\t\n223\t        Returns the remaining unpaid generic amount (0 on success).\n224\t        \"\"\"\n225\t        # Pay with colorless first.\n226\t        if working.get(ManaType.COLORLESS, 0) > 0:\n227\t            take = min(working[ManaType.COLORLESS], amount)\n228\t            working[ManaType.COLORLESS] -= take\n229\t            amount -= take\n230\t\n231\t        # Then pay with each colored type in enum order.\n232\t        for mt in ManaType:\n233\t            if mt is ManaType.COLORLESS:\n234\t                continue\n235\t            if amount <= 0:\n236\t                break\n237\t            if working.get(mt, 0) > 0:\n238\t                take = min(working[mt], amount)\n239\t                working[mt] -= take\n240\t                amount -= take\n241\t\n242\t        return amount\n243\t\n244\t    # ------------------------------------------------------------------\n245\t    # Dunder helpers\n246\t    # ------------------------------------------------------------------\n247\t\n248\t    def __repr__(self) -> str:\n249\t        non_zero = {mt.name: v for mt, v in self._pool.items() if v > 0}\n250\t        return f\"ManaPool({non_zero})\"\n251\t"}]},"parent_tool_use_id":null,"session_id":"7ce0e410-080e-42f6-b0e7-fdb5c9b29b22","uuid":"9b95a148-9188-49e2-9c27-57a3d1dcedaf","timestamp":"2026-06-11T05:13:29.885Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/mana.py","content":"\"\"\"Mana pool and cost payment logic.\"\"\"\n\nfrom __future__ import annotations\n\nfrom engine.types import Color, HybridManaSymbol, ManaCost, ManaType\n\n# Map colored ManaTypes to their corresponding Color enum values.\n_MANA_TO_COLOR: dict[ManaType, Color] = {\n    ManaType.WHITE: Color.WHITE,\n    ManaType.BLUE: Color.BLUE,\n    ManaType.BLACK: Color.BLACK,\n    ManaType.RED: Color.RED,\n    ManaType.GREEN: Color.GREEN,\n}\n\n\nclass ManaPool:\n    \"\"\"Tracks available mana for a player.\n\n    Internal storage uses a ``dict[ManaType, int]`` mapping each mana type\n    to its current count.\n    \"\"\"\n\n    def __init__(self) -> None:\n        self._pool: dict[ManaType, int] = {mt: 0 for mt in ManaType}\n        self._last_payment_colors: list[Color] = []\n\n    # ------------------------------------------------------------------\n    # Basic operations\n    # ------------------------------------------------------------------\n\n    def add(self, mana_type: ManaType, amount: int = 1) -> None:\n        \"\"\"Add *amount* mana of the given type to the pool.\n\n        Parameters:\n            mana_type: The type of mana to add.\n            amount: How many mana to add (must be non-negative).\n        \"\"\"\n        if amount < 0:\n            raise ValueError(f\"Cannot add negative mana: {amount}\")\n        self._pool[mana_type] = self._pool.get(mana_type, 0) + amount\n\n    def empty(self) -> None:\n        \"\"\"Clear the pool — happens at phase/step transitions.\"\"\"\n        for mt in self._pool:\n            self._pool[mt] = 0\n\n    def total(self) -> int:\n        \"\"\"Return the total amount of mana in the pool across all types.\"\"\"\n        return sum(self._pool.values())\n\n    def get(self, mana_type: ManaType) -> int:\n        \"\"\"Return the amount of a specific mana type in the pool.\"\"\"\n        return self._pool.get(mana_type, 0)\n\n    @property\n    def last_payment_colors(self) -> list[Color]:\n        \"\"\"Return the distinct colors of mana spent in the last :meth:`pay` call.\n\n        Colorless mana is not a color and is excluded.  The list is sorted\n        by Color enum order for determinism.  Empty if no payment has been\n        made or if all mana spent was colorless.\n        \"\"\"\n        return list(self._last_payment_colors)\n\n    # ------------------------------------------------------------------\n    # Cost payment\n    # ------------------------------------------------------------------\n\n    def can_pay(self, cost: ManaCost) -> bool:\n        \"\"\"Check whether the pool can satisfy *cost*.\n\n        Generic mana can be paid by any type.  X is treated as 0 for\n        ``can_pay`` unless explicitly set in the cost's generic component.\n        Hybrid symbols can be paid with either option; this method uses\n        backtracking to find a valid assignment.\n\n        Returns:\n            True if the pool has enough mana to pay the cost.\n        \"\"\"\n        remaining: dict[ManaType, int] = dict(self._pool)\n\n        # Pay colored/colorless pips first.\n        for mana_type, count in cost.pips.items():\n            if remaining.get(mana_type, 0) < count:\n                return False\n            remaining[mana_type] = remaining.get(mana_type, 0) - count\n\n        # Solve hybrid symbols with backtracking.\n        if cost.hybrid:\n            if not self._can_pay_hybrid(remaining, list(cost.hybrid), 0, cost.generic):\n                return False\n            return True\n\n        # Then check generic — sum of all remaining mana must cover it.\n        return sum(remaining.values()) >= cost.generic\n\n    def pay(self, cost: ManaCost, choices: dict[ManaType, int] | None = None) -> bool:\n        \"\"\"Deduct mana from the pool to pay *cost*.\n\n        Parameters:\n            cost: The mana cost to pay.\n            choices: How to split the generic portion across mana types.\n                If ``None``, auto-pay greedily: pay colored pips first,\n                then hybrid symbols, then generic using colorless first,\n                then excess colored.\n\n        Returns:\n            True if payment succeeded, False if the pool has insufficient mana.\n        \"\"\"\n        if not self.can_pay(cost):\n            return False\n\n        # Work on a copy so we can roll back on failure.\n        working: dict[ManaType, int] = dict(self._pool)\n\n        # 1. Pay colored/colorless pips.\n        for mana_type, count in cost.pips.items():\n            working[mana_type] -= count\n\n        # 2. When explicit generic choices are provided, reserve that mana\n        #    *before* solving hybrids so the solver doesn't steal it.\n        generic_remaining = cost.generic\n        if generic_remaining > 0 and choices is not None:\n            # Reject negative choice amounts — they would create mana.\n            if any(v < 0 for v in choices.values()):\n                return False\n            # Validate choices sum to generic cost.\n            if sum(choices.values()) != generic_remaining:\n                return False\n            for mana_type, amount in choices.items():\n                if working.get(mana_type, 0) < amount:\n                    return False\n                working[mana_type] -= amount\n\n        # 3. Pay hybrid symbols using backtracking to find a valid assignment.\n        #    Generic choices (if any) have already been reserved above,\n        #    so _solve_hybrid sees only the genuinely available mana.\n        if cost.hybrid:\n            generic_for_solver = generic_remaining if choices is None else 0\n            hybrid_assignment = self._solve_hybrid(\n                working, list(cost.hybrid), 0, generic_for_solver,\n            )\n            if hybrid_assignment is None:\n                return False  # pragma: no cover – should not happen after can_pay\n            for mt in hybrid_assignment:\n                working[mt] = working.get(mt, 0) - 1\n\n        # 4. Pay generic cost (auto-pay path — choices already deducted above).\n        if generic_remaining > 0 and choices is None:\n            generic_remaining = self._auto_pay_generic(working, generic_remaining)\n            if generic_remaining > 0:\n                return False  # pragma: no cover – should not happen after can_pay\n\n        # Commit the payment.\n        # Compute colors of mana spent by comparing old pool to new working pool.\n        colors_spent: set[Color] = set()\n        for mt, old_amount in self._pool.items():\n            new_amount = working.get(mt, 0)\n            if new_amount < old_amount and mt in _MANA_TO_COLOR:\n                colors_spent.add(_MANA_TO_COLOR[mt])\n        self._last_payment_colors = sorted(colors_spent, key=lambda c: c.value)\n        self._pool = working\n        return True\n\n    @staticmethod\n    def _can_pay_hybrid(\n        remaining: dict[ManaType, int],\n        hybrids: list[HybridManaSymbol],\n        idx: int,\n        generic: int,\n    ) -> bool:\n        \"\"\"Recursively check if hybrid symbols + generic can be satisfied.\n\n        Uses backtracking: for each hybrid symbol, try option_a then option_b.\n        After all hybrids are assigned, check that remaining mana covers generic.\n        \"\"\"\n        if idx >= len(hybrids):\n            return sum(remaining.values()) >= generic\n\n        sym = hybrids[idx]\n        for option in (sym.option_a, sym.option_b):\n            if remaining.get(option, 0) > 0:\n                remaining[option] -= 1\n                if ManaPool._can_pay_hybrid(remaining, hybrids, idx + 1, generic):\n                    remaining[option] += 1\n                    return True\n                remaining[option] += 1\n        return False\n\n    @staticmethod\n    def _solve_hybrid(\n        remaining: dict[ManaType, int],\n        hybrids: list[HybridManaSymbol],\n        idx: int,\n        generic: int,\n    ) -> list[ManaType] | None:\n        \"\"\"Find a valid assignment for hybrid symbols.\n\n        Returns a list of ManaType choices (one per hybrid symbol) or None\n        if no valid assignment exists.\n        \"\"\"\n        if idx >= len(hybrids):\n            if sum(remaining.values()) >= generic:\n                return []\n            return None\n\n        sym = hybrids[idx]\n        for option in (sym.option_a, sym.option_b):\n            if remaining.get(option, 0) > 0:\n                remaining[option] -= 1\n                result = ManaPool._solve_hybrid(remaining, hybrids, idx + 1, generic)\n                if result is not None:\n                    remaining[option] += 1\n                    return [option] + result\n                remaining[option] += 1\n        return None\n\n    @staticmethod\n    def _auto_pay_generic(working: dict[ManaType, int], amount: int) -> int:\n        \"\"\"Deduct *amount* generic mana from *working*, preferring colorless.\n\n        Returns the remaining unpaid generic amount (0 on success).\n        \"\"\"\n        # Pay with colorless first.\n        if working.get(ManaType.COLORLESS, 0) > 0:\n            take = min(working[ManaType.COLORLESS], amount)\n            working[ManaType.COLORLESS] -= take\n            amount -= take\n\n        # Then pay with each colored type in enum order.\n        for mt in ManaType:\n            if mt is ManaType.COLORLESS:\n                continue\n            if amount <= 0:\n                break\n            if working.get(mt, 0) > 0:\n                take = min(working[mt], amount)\n                working[mt] -= take\n                amount -= take\n\n        return amount\n\n    # ------------------------------------------------------------------\n    # Dunder helpers\n    # ------------------------------------------------------------------\n\n    def __repr__(self) -> str:\n        non_zero = {mt.name: v for mt, v in self._pool.items() if v > 0}\n        return f\"ManaPool({non_zero})\"\n","numLines":251,"startLine":1,"totalLines":251}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012tC6fnbthHcqj8aLMVQ2aK","type":"tool_result","content":"1\t\"\"\"Core enums and type definitions for the SilverquiLLM engine.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport enum\n6\timport re\n7\tfrom dataclasses import dataclass, field\n8\tfrom typing import Any, Callable\n9\t\n10\t\n11\tclass Color(enum.Enum):\n12\t    \"\"\"The five colors of Magic.\"\"\"\n13\t\n14\t    WHITE = \"W\"\n15\t    BLUE = \"U\"\n16\t    BLACK = \"B\"\n17\t    RED = \"R\"\n18\t    GREEN = \"G\"\n19\t\n20\t\n21\t# Single-letter aliases accessible as Color.W, Color.U, etc.\n22\tColor.W = Color.WHITE  # type: ignore[attr-defined]\n23\tColor.U = Color.BLUE  # type: ignore[attr-defined]\n24\tColor.B = Color.BLACK  # type: ignore[attr-defined]\n25\tColor.R = Color.RED  # type: ignore[attr-defined]\n26\tColor.G = Color.GREEN  # type: ignore[attr-defined]\n27\t\n28\t\n29\tclass ManaType(enum.Enum):\n30\t    \"\"\"Mana types including colorless.\"\"\"\n31\t\n32\t    WHITE = \"W\"\n33\t    BLUE = \"U\"\n34\t    BLACK = \"B\"\n35\t    RED = \"R\"\n36\t    GREEN = \"G\"\n37\t    COLORLESS = \"C\"\n38\t\n39\t\n40\tclass Zone(enum.Enum):\n41\t    \"\"\"Game zones.\"\"\"\n42\t\n43\t    BATTLEFIELD = \"battlefield\"\n44\t    HAND = \"hand\"\n45\t    LIBRARY = \"library\"\n46\t    GRAVEYARD = \"graveyard\"\n47\t    EXILE = \"exile\"\n48\t    STACK = \"stack\"\n49\t    COMMAND = \"command\"\n50\t\n51\t\n52\tclass Phase(enum.Enum):\n53\t    \"\"\"Turn phases.\"\"\"\n54\t\n55\t    BEGINNING = \"beginning\"\n56\t    PRECOMBAT_MAIN = \"precombat_main\"\n57\t    COMBAT = \"combat\"\n58\t    POSTCOMBAT_MAIN = \"postcombat_main\"\n59\t    ENDING = \"ending\"\n60\t\n61\t\n62\tclass Step(enum.Enum):\n63\t    \"\"\"Turn steps.\"\"\"\n64\t\n65\t    UNTAP = \"untap\"\n66\t    UPKEEP = \"upkeep\"\n67\t    DRAW = \"draw\"\n68\t    BEGIN_COMBAT = \"begin_combat\"\n69\t    DECLARE_ATTACKERS = \"declare_attackers\"\n70\t    DECLARE_BLOCKERS = \"declare_blockers\"\n71\t    COMBAT_DAMAGE = \"combat_damage\"\n72\t    END_COMBAT = \"end_combat\"\n73\t    END = \"end\"\n74\t    CLEANUP = \"cleanup\"\n75\t\n76\t\n77\tclass CardType(enum.Enum):\n78\t    \"\"\"Card types.\"\"\"\n79\t\n80\t    CREATURE = \"creature\"\n81\t    INSTANT = \"instant\"\n82\t    SORCERY = \"sorcery\"\n83\t    ENCHANTMENT = \"enchantment\"\n84\t    ARTIFACT = \"artifact\"\n85\t    PLANESWALKER = \"planeswalker\"\n86\t    LAND = \"land\"\n87\t\n88\t\n89\tclass Supertype(enum.Enum):\n90\t    \"\"\"Card supertypes.\"\"\"\n91\t\n92\t    BASIC = \"basic\"\n93\t    LEGENDARY = \"legendary\"\n94\t    SNOW = \"snow\"\n95\t\n96\t\n97\tclass Keyword(enum.Flag):\n98\t    \"\"\"Evergreen keyword abilities (combinable via bitwise OR).\"\"\"\n99\t\n100\t    FLYING = enum.auto()\n101\t    FIRST_STRIKE = enum.auto()\n102\t    DOUBLE_STRIKE = enum.auto()\n103\t    DEATHTOUCH = enum.auto()\n104\t    TRAMPLE = enum.auto()\n105\t    LIFELINK = enum.auto()\n106\t    VIGILANCE = enum.auto()\n107\t    REACH = enum.auto()\n108\t    HASTE = enum.auto()\n109\t    FLASH = enum.auto()\n110\t    DEFENDER = enum.auto()\n111\t    HEXPROOF = enum.auto()\n112\t    INDESTRUCTIBLE = enum.auto()\n113\t    MENACE = enum.auto()\n114\t    WARD = enum.auto()\n115\t    PROWESS = enum.auto()\n116\t\n117\t\n118\t# Mapping from pip string to ManaType for parsing\n119\t_PIP_MAP: dict[str, ManaType] = {\n120\t    \"W\": ManaType.WHITE,\n121\t    \"U\": ManaType.BLUE,\n122\t    \"B\": ManaType.BLACK,\n123\t    \"R\": ManaType.RED,\n124\t    \"G\": ManaType.GREEN,\n125\t    \"C\": ManaType.COLORLESS,\n126\t}\n127\t\n128\t# Regex to tokenize a mana cost string like \"{2}{W}{U}\" or \"{X}{X}{R}\"\n129\t_MANA_TOKEN_RE = re.compile(r\"\\{([^}]+)\\}\")\n130\t\n131\t# Regex to detect hybrid mana tokens like \"B/G\", \"W/U\", etc.\n132\t_HYBRID_RE = re.compile(r\"^([WUBRGC])/([WUBRGC])$\")\n133\t\n134\t\n135\t@dataclass(frozen=True)\n136\tclass HybridManaSymbol:\n137\t    \"\"\"A hybrid mana symbol that can be paid with either of two colors.\n138\t\n139\t    For example, ``{B/G}`` is represented as\n140\t    ``HybridManaSymbol(option_a=ManaType.BLACK, option_b=ManaType.GREEN)``.\n141\t    \"\"\"\n142\t\n143\t    option_a: ManaType\n144\t    option_b: ManaType\n145\t\n146\t\n147\t@dataclass(frozen=True)\n148\tclass ManaCost:\n149\t    \"\"\"Represents a mana cost.\n150\t\n151\t    Attributes:\n152\t        generic: The generic (numerical) component of the cost.\n153\t        pips: Mapping of colored/colorless mana pips to their counts.\n154\t        x_count: Number of {X} symbols in the cost.\n155\t        hybrid: List of hybrid mana symbols that can be paid with either option.\n156\t    \"\"\"\n157\t\n158\t    generic: int = 0\n159\t    pips: dict[ManaType, int] = field(default_factory=dict)\n160\t    x_count: int = 0\n161\t    hybrid: list[HybridManaSymbol] = field(default_factory=list)\n162\t\n163\t    @property\n164\t    def cmc(self) -> int:\n165\t        \"\"\"Converted mana cost (total mana value, treating X as 0).\n166\t\n167\t        Each hybrid symbol contributes 1 to the CMC.\n168\t        \"\"\"\n169\t        return self.generic + sum(self.pips.values()) + len(self.hybrid)\n170\t\n171\t    @classmethod\n172\t    def parse(cls, cost_str: str) -> ManaCost:\n173\t        \"\"\"Parse a mana cost string like ``\"{2}{W}{U}\"`` into a ManaCost.\n174\t\n175\t        Supports generic mana (``{N}``), colored pips (``{W}``, ``{U}``, ``{B}``,\n176\t        ``{R}``, ``{G}``), colorless pips (``{C}``), and X costs (``{X}``).\n177\t\n178\t        Raises:\n179\t            ValueError: If *cost_str* is empty, contains no valid tokens, or\n180\t                includes an unrecognised pip symbol.\n181\t        \"\"\"\n182\t        if not cost_str or not cost_str.strip():\n183\t            raise ValueError(f\"Invalid mana cost string: {cost_str!r}\")\n184\t\n185\t        tokens = _MANA_TOKEN_RE.findall(cost_str)\n186\t        if not tokens:\n187\t            raise ValueError(f\"Invalid mana cost string: {cost_str!r}\")\n188\t\n189\t        # Verify that the entire input is consumed by brace tokens (no extra\n190\t        # characters outside braces such as trailing junk or stray spaces).\n191\t        reconstructed = \"\".join(f\"{{{t}}}\" for t in tokens)\n192\t        if reconstructed != cost_str:\n193\t            raise ValueError(f\"Invalid mana cost string: {cost_str!r}\")\n194\t\n195\t        generic = 0\n196\t        pips: dict[ManaType, int] = {}\n197\t        x_count = 0\n198\t        hybrid: list[HybridManaSymbol] = []\n199\t\n200\t        for token in tokens:\n201\t            upper = token.upper()\n202\t            if upper == \"X\":\n203\t                x_count += 1\n204\t            elif upper in _PIP_MAP:\n205\t                mana_type = _PIP_MAP[upper]\n206\t                pips[mana_type] = pips.get(mana_type, 0) + 1\n207\t            else:\n208\t                # Check for hybrid mana like \"B/G\"\n209\t                hybrid_match = _HYBRID_RE.match(upper)\n210\t                if hybrid_match:\n211\t                    a_str, b_str = hybrid_match.group(1), hybrid_match.group(2)\n212\t                    if a_str not in _PIP_MAP or b_str not in _PIP_MAP:\n213\t                        raise ValueError(\n214\t                            f\"Unrecognised mana symbol {token!r} in cost string {cost_str!r}\"\n215\t                        )\n216\t                    hybrid.append(\n217\t                        HybridManaSymbol(\n218\t                            option_a=_PIP_MAP[a_str], option_b=_PIP_MAP[b_str]\n219\t                        )\n220\t                    )\n221\t                else:\n222\t                    # Try to parse as a number (generic mana)\n223\t                    try:\n224\t                        value = int(token)\n225\t                    except ValueError:\n226\t                        raise ValueError(\n227\t                            f\"Unrecognised mana symbol {token!r} in cost string {cost_str!r}\"\n228\t                        ) from None\n229\t                    if value < 0:\n230\t                        raise ValueError(\n231\t                            f\"Negative generic mana {token!r} in cost string {cost_str!r}\"\n232\t                        )\n233\t                    generic += value\n234\t\n235\t        return cls(generic=generic, pips=pips, x_count=x_count, hybrid=hybrid)\n236\t\n237\t\n238\t@dataclass\n239\tclass TargetRequirement:\n240\t    \"\"\"Describes a targeting requirement for a spell or ability.\n241\t\n242\t    Attributes:\n243\t        filter_fn: A callable that accepts a game object and returns True\n244\t            if the object is a legal target.  Filters should evaluate the\n245\t            object's properties at call time (lazy) rather than capturing\n246\t            a snapshot of legal targets when the filter is created.\n247\t        description: Human-readable description of what this targets.\n248\t        zone: The zone in which legal targets must reside.\n249\t    \"\"\"\n250\t\n251\t    filter_fn: Callable[..., Any]\n252\t    description: str\n253\t    zone: Zone\n254\t"}]},"parent_tool_use_id":null,"session_id":"7ce0e410-080e-42f6-b0e7-fdb5c9b29b22","uuid":"fd4fbaec-3482-4467-a6e5-d37bbd003076","timestamp":"2026-06-11T05:13:29.889Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/types.py","content":"\"\"\"Core enums and type definitions for the SilverquiLLM engine.\"\"\"\n\nfrom __future__ import annotations\n\nimport enum\nimport re\nfrom dataclasses import dataclass, field\nfrom typing import Any, Callable\n\n\nclass Color(enum.Enum):\n    \"\"\"The five colors of Magic.\"\"\"\n\n    WHITE = \"W\"\n    BLUE = \"U\"\n    BLACK = \"B\"\n    RED = \"R\"\n    GREEN = \"G\"\n\n\n# Single-letter aliases accessible as Color.W, Color.U, etc.\nColor.W = Color.WHITE  # type: ignore[attr-defined]\nColor.U = Color.BLUE  # type: ignore[attr-defined]\nColor.B = Color.BLACK  # type: ignore[attr-defined]\nColor.R = Color.RED  # type: ignore[attr-defined]\nColor.G = Color.GREEN  # type: ignore[attr-defined]\n\n\nclass ManaType(enum.Enum):\n    \"\"\"Mana types including colorless.\"\"\"\n\n    WHITE = \"W\"\n    BLUE = \"U\"\n    BLACK = \"B\"\n    RED = \"R\"\n    GREEN = \"G\"\n    COLORLESS = \"C\"\n\n\nclass Zone(enum.Enum):\n    \"\"\"Game zones.\"\"\"\n\n    BATTLEFIELD = \"battlefield\"\n    HAND = \"hand\"\n    LIBRARY = \"library\"\n    GRAVEYARD = \"graveyard\"\n    EXILE = \"exile\"\n    STACK = \"stack\"\n    COMMAND = \"command\"\n\n\nclass Phase(enum.Enum):\n    \"\"\"Turn phases.\"\"\"\n\n    BEGINNING = \"beginning\"\n    PRECOMBAT_MAIN = \"precombat_main\"\n    COMBAT = \"combat\"\n    POSTCOMBAT_MAIN = \"postcombat_main\"\n    ENDING = \"ending\"\n\n\nclass Step(enum.Enum):\n    \"\"\"Turn steps.\"\"\"\n\n    UNTAP = \"untap\"\n    UPKEEP = \"upkeep\"\n    DRAW = \"draw\"\n    BEGIN_COMBAT = \"begin_combat\"\n    DECLARE_ATTACKERS = \"declare_attackers\"\n    DECLARE_BLOCKERS = \"declare_blockers\"\n    COMBAT_DAMAGE = \"combat_damage\"\n    END_COMBAT = \"end_combat\"\n    END = \"end\"\n    CLEANUP = \"cleanup\"\n\n\nclass CardType(enum.Enum):\n    \"\"\"Card types.\"\"\"\n\n    CREATURE = \"creature\"\n    INSTANT = \"instant\"\n    SORCERY = \"sorcery\"\n    ENCHANTMENT = \"enchantment\"\n    ARTIFACT = \"artifact\"\n    PLANESWALKER = \"planeswalker\"\n    LAND = \"land\"\n\n\nclass Supertype(enum.Enum):\n    \"\"\"Card supertypes.\"\"\"\n\n    BASIC = \"basic\"\n    LEGENDARY = \"legendary\"\n    SNOW = \"snow\"\n\n\nclass Keyword(enum.Flag):\n    \"\"\"Evergreen keyword abilities (combinable via bitwise OR).\"\"\"\n\n    FLYING = enum.auto()\n    FIRST_STRIKE = enum.auto()\n    DOUBLE_STRIKE = enum.auto()\n    DEATHTOUCH = enum.auto()\n    TRAMPLE = enum.auto()\n    LIFELINK = enum.auto()\n    VIGILANCE = enum.auto()\n    REACH = enum.auto()\n    HASTE = enum.auto()\n    FLASH = enum.auto()\n    DEFENDER = enum.auto()\n    HEXPROOF = enum.auto()\n    INDESTRUCTIBLE = enum.auto()\n    MENACE = enum.auto()\n    WARD = enum.auto()\n    PROWESS = enum.auto()\n\n\n# Mapping from pip string to ManaType for parsing\n_PIP_MAP: dict[str, ManaType] = {\n    \"W\": ManaType.WHITE,\n    \"U\": ManaType.BLUE,\n    \"B\": ManaType.BLACK,\n    \"R\": ManaType.RED,\n    \"G\": ManaType.GREEN,\n    \"C\": ManaType.COLORLESS,\n}\n\n# Regex to tokenize a mana cost string like \"{2}{W}{U}\" or \"{X}{X}{R}\"\n_MANA_TOKEN_RE = re.compile(r\"\\{([^}]+)\\}\")\n\n# Regex to detect hybrid mana tokens like \"B/G\", \"W/U\", etc.\n_HYBRID_RE = re.compile(r\"^([WUBRGC])/([WUBRGC])$\")\n\n\n@dataclass(frozen=True)\nclass HybridManaSymbol:\n    \"\"\"A hybrid mana symbol that can be paid with either of two colors.\n\n    For example, ``{B/G}`` is represented as\n    ``HybridManaSymbol(option_a=ManaType.BLACK, option_b=ManaType.GREEN)``.\n    \"\"\"\n\n    option_a: ManaType\n    option_b: ManaType\n\n\n@dataclass(frozen=True)\nclass ManaCost:\n    \"\"\"Represents a mana cost.\n\n    Attributes:\n        generic: The generic (numerical) component of the cost.\n        pips: Mapping of colored/colorless mana pips to their counts.\n        x_count: Number of {X} symbols in the cost.\n        hybrid: List of hybrid mana symbols that can be paid with either option.\n    \"\"\"\n\n    generic: int = 0\n    pips: dict[ManaType, int] = field(default_factory=dict)\n    x_count: int = 0\n    hybrid: list[HybridManaSymbol] = field(default_factory=list)\n\n    @property\n    def cmc(self) -> int:\n        \"\"\"Converted mana cost (total mana value, treating X as 0).\n\n        Each hybrid symbol contributes 1 to the CMC.\n        \"\"\"\n        return self.generic + sum(self.pips.values()) + len(self.hybrid)\n\n    @classmethod\n    def parse(cls, cost_str: str) -> ManaCost:\n        \"\"\"Parse a mana cost string like ``\"{2}{W}{U}\"`` into a ManaCost.\n\n        Supports generic mana (``{N}``), colored pips (``{W}``, ``{U}``, ``{B}``,\n        ``{R}``, ``{G}``), colorless pips (``{C}``), and X costs (``{X}``).\n\n        Raises:\n            ValueError: If *cost_str* is empty, contains no valid tokens, or\n                includes an unrecognised pip symbol.\n        \"\"\"\n        if not cost_str or not cost_str.strip():\n            raise ValueError(f\"Invalid mana cost string: {cost_str!r}\")\n\n        tokens = _MANA_TOKEN_RE.findall(cost_str)\n        if not tokens:\n            raise ValueError(f\"Invalid mana cost string: {cost_str!r}\")\n\n        # Verify that the entire input is consumed by brace tokens (no extra\n        # characters outside braces such as trailing junk or stray spaces).\n        reconstructed = \"\".join(f\"{{{t}}}\" for t in tokens)\n        if reconstructed != cost_str:\n            raise ValueError(f\"Invalid mana cost string: {cost_str!r}\")\n\n        generic = 0\n        pips: dict[ManaType, int] = {}\n        x_count = 0\n        hybrid: list[HybridManaSymbol] = []\n\n        for token in tokens:\n            upper = token.upper()\n            if upper == \"X\":\n                x_count += 1\n            elif upper in _PIP_MAP:\n                mana_type = _PIP_MAP[upper]\n                pips[mana_type] = pips.get(mana_type, 0) + 1\n            else:\n                # Check for hybrid mana like \"B/G\"\n                hybrid_match = _HYBRID_RE.match(upper)\n                if hybrid_match:\n                    a_str, b_str = hybrid_match.group(1), hybrid_match.group(2)\n                    if a_str not in _PIP_MAP or b_str not in _PIP_MAP:\n                        raise ValueError(\n                            f\"Unrecognised mana symbol {token!r} in cost string {cost_str!r}\"\n                        )\n                    hybrid.append(\n                        HybridManaSymbol(\n                            option_a=_PIP_MAP[a_str], option_b=_PIP_MAP[b_str]\n                        )\n                    )\n                else:\n                    # Try to parse as a number (generic mana)\n                    try:\n                        value = int(token)\n                    except ValueError:\n                        raise ValueError(\n                            f\"Unrecognised mana symbol {token!r} in cost string {cost_str!r}\"\n                        ) from None\n                    if value < 0:\n                        raise ValueError(\n                            f\"Negative generic mana {token!r} in cost string {cost_str!r}\"\n                        )\n                    generic += value\n\n        return cls(generic=generic, pips=pips, x_count=x_count, hybrid=hybrid)\n\n\n@dataclass\nclass TargetRequirement:\n    \"\"\"Describes a targeting requirement for a spell or ability.\n\n    Attributes:\n        filter_fn: A callable that accepts a game object and returns True\n            if the object is a legal target.  Filters should evaluate the\n            object's properties at call time (lazy) rather than capturing\n            a snapshot of legal targets when the filter is created.\n        description: Human-readable description of what this targets.\n        zone: The zone in which legal targets must reside.\n    \"\"\"\n\n    filter_fn: Callable[..., Any]\n    description: str\n    zone: Zone\n","numLines":254,"startLine":1,"totalLines":254}}}
