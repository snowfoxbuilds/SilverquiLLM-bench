+def ActivateAbility(
+    game: GameState,
+    player: Any,  # Player
+    source: Any,
+    index: int,
+    targets: list[Any] | None = None,
+) -> None:
+    """Activate *source*'s printed ability by index through the engine.
+
+    Printed abilities are indexed in card order across the card hooks:
+    mana abilities (``get_mana_abilities``) first, then activated abilities
+    (``get_activated_abilities``), then loyalty abilities
+    (``get_loyalty_abilities``).  The matching ability is wrapped in the
+    appropriate runtime instance and passed to :func:`activate_ability`,
+    so mana abilities resolve immediately and everything else is pushed
+    onto the stack (resolve via ``priority_loop``).
+
+    Parameters:
+        game: The current game state.
+        player: The activating player.
+        source: The permanent whose ability is being activated.
+        index: Printed ability index (see above).
+        targets: Optional targets for the ability.  They are stored on
+            ``source.chosen_targets`` just before the effect runs.
+
+    Raises:
+        AbilityError: If *index* is out of range or activation is illegal.
+    """
+    mana = list(source.get_mana_abilities()) if hasattr(source, "get_mana_abilities") else []
+    activated = list(source.get_activated_abilities()) if hasattr(source, "get_activated_abilities") else []
+    loyalty = list(source.get_loyalty_abilities()) if hasattr(source, "get_loyalty_abilities") else []
+
+    n_mana, n_activated = len(mana), len(activated)
+    total = n_mana + n_activated + len(loyalty)
+    if index < 0 or index >= total:
+        raise AbilityError(
+            f"Ability index {index} out of range — {source!r} has {total} abilities"
+        )
+
+    instance: ActivatedAbilityInstance | LoyaltyAbilityInstance
+    if index < n_mana:
+        ability = mana[index]
+        effect = ability.mana_produced
+        if targets is not None:
+            effect = _with_targets(source, targets, effect)
+        instance = ActivatedAbilityInstance(
+            source=source,
+            controller=player,
+            cost=ability.cost,
+            effect=effect,
+            is_mana_ability=True,
+            description=ability.description,
+        )
+    elif index < n_mana + n_activated:
+        ability = activated[index - n_mana]
+        effect = ability.effect
+        if targets is not None:
+            effect = _with_targets(source, targets, effect)
+        instance = ActivatedAbilityInstance(
+            source=source,
+            controller=player,
+            cost=ability.cost,
+            effect=effect,
+            is_mana_ability=False,
+            description=ability.description,
+        )
+    else:
+        ability = loyalty[index - n_mana - n_activated]
+        effect = _with_targets(source, targets if targets is not None else [], ability.effect)
+        instance = LoyaltyAbilityInstance(
+            source=source,
+            controller=player,
+            loyalty_cost=ability.loyalty_cost,
+            effect=effect,
+            description=ability.description,
+        )
+
+    activate_ability(game, player, instance)
+
+
+def _with_targets(
+    source: Any,
+    targets: list[Any],
+    effect: Callable[..., None],
+) -> Callable[..., None]:
+    """Wrap *effect* so the activation's targets are visible on the source.
+
+    Sets ``source.chosen_targets`` right before the effect runs (mirroring
+    how spell resolution exposes targets to ``on_resolve``).
+    """
+
+    def _effect(game: GameState) -> None:
+        source.chosen_targets = targets
+        effect(game)
+
+    return _effect
+
+
