{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BeP4BHJwvQ9SJzAm9gHHPD","type":"tool_result","content":"1\t\"\"\"Triggered abilities system — event-driven trigger registration and firing.\n2\t\n3\tProvides the core mechanism for registering triggered abilities and firing\n4\tevents that push matching triggers onto the stack:\n5\t\n6\t- :class:`TriggerRegistration` — dataclass describing a single trigger.\n7\t- :class:`TriggerManager` — central registry for triggers with APNAP-ordered\n8\t  event firing.\n9\t\n10\tEvent types live in :mod:`engine.events` as typed dataclasses.\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\tfrom dataclasses import dataclass, field\n16\tfrom typing import TYPE_CHECKING, Any, Callable\n17\t\n18\tfrom engine.events import TriggeredEvent\n19\tfrom engine.stack import StackObject\n20\t\n21\tif TYPE_CHECKING:\n22\t    from engine.game_state import GameState\n23\t    from engine.player import Player\n24\t\n25\t\n26\t@dataclass\n27\tclass TriggerRegistration:\n28\t    \"\"\"Describes a single triggered ability.\n29\t\n30\t    Attributes:\n31\t        event_type: The event class (or a base class) this trigger watches.\n32\t            The trigger fires for any fired event that is an instance of\n33\t            this class, including instances of subclasses.\n34\t        condition: Optional callable ``(game, event) -> bool`` that must\n35\t            return ``True`` for the trigger to fire.  ``None`` means the\n36\t            trigger always fires for its event type.\n37\t        effect: Callable ``(game) -> None`` executed when the trigger\n38\t            resolves (becomes the :attr:`StackObject.on_resolve` callback).\n39\t        source: The game object (card / permanent) that owns this trigger.\n40\t        controller: The player who controls the source at the time of\n41\t            registration.\n42\t    \"\"\"\n43\t\n44\t    event_type: type[TriggeredEvent]\n45\t    condition: Callable[..., bool] | None\n46\t    effect: Callable[..., None]\n47\t    source: Any\n48\t    controller: Player\n49\t\n50\t\n51\tclass TriggerManager:\n52\t    \"\"\"Central registry for triggered abilities.\n53\t\n54\t    Triggers are registered when a permanent enters the battlefield (or\n55\t    via other game actions) and unregistered when the source leaves.\n56\t\n57\t    :meth:`fire_event` checks all registered triggers of a matching\n58\t    event type, evaluates their conditions, and pushes matching triggers\n59\t    onto the game stack as :class:`StackObject` instances.  Triggers are\n60\t    ordered according to APNAP (Active Player, Non-Active Player):\n61\t\n62\t    * Active player's triggers are pushed first (end up on the bottom\n63\t      of the batch).\n64\t    * Non-active player's triggers are pushed second (end up on top).\n65\t    * Within the same player, triggers are pushed in registration order\n66\t      (controller would normally choose; for now we use registration\n67\t      order as a deterministic default).\n68\t    \"\"\"\n69\t\n70\t    def __init__(self) -> None:\n71\t        self._triggers: list[TriggerRegistration] = []\n72\t\n73\t    def register(self, trigger: TriggerRegistration) -> None:\n74\t        \"\"\"Register a triggered ability.\"\"\"\n75\t        self._triggers.append(trigger)\n76\t\n77\t    def unregister(self, source: Any) -> None:\n78\t        \"\"\"Remove all triggers registered by *source* (identity-based).\"\"\"\n79\t        self._triggers = [t for t in self._triggers if t.source is not source]\n80\t\n81\t    def fire_event(self, game: GameState, event: TriggeredEvent) -> None:\n82\t        \"\"\"Fire an event and push all matching triggers onto the stack.\n83\t\n84\t        Parameters:\n85\t            game: The current game state.\n86\t            event: The typed event object.  Triggers registered for the\n87\t                event's class or any of its parent classes will fire.\n88\t\n89\t        Matching triggers are pushed in APNAP order:\n90\t\n91\t        1. Active player's matching triggers (in registration order).\n92\t        2. Non-active player's matching triggers (in registration order).\n93\t        \"\"\"\n94\t        matching: list[TriggerRegistration] = []\n95\t        for trigger in self._triggers:\n96\t            if not isinstance(event, trigger.event_type):\n97\t                continue\n98\t            if trigger.condition is not None:\n99\t                if not trigger.condition(game, event):\n100\t                    continue\n101\t            matching.append(trigger)\n102\t\n103\t        if not matching:\n104\t            return\n105\t\n106\t        active_player = game.active_player\n107\t        active_triggers: list[TriggerRegistration] = []\n108\t        non_active_triggers: list[TriggerRegistration] = []\n109\t\n110\t        for trigger in matching:\n111\t            if trigger.controller is active_player:\n112\t                active_triggers.append(trigger)\n113\t            else:\n114\t                non_active_triggers.append(trigger)\n115\t\n116\t        ordered = active_triggers + non_active_triggers\n117\t\n118\t        for trigger in ordered:\n119\t            stack_obj = StackObject(\n120\t                source=trigger.source,\n121\t                controller=trigger.controller,\n122\t                on_resolve=trigger.effect,\n123\t            )\n124\t            game.stack.push(stack_obj)\n125\t\n126\t    def get_triggers(self) -> list[TriggerRegistration]:\n127\t        \"\"\"Return a shallow copy of all registered triggers.\"\"\"\n128\t        return list(self._triggers)\n129\t\n130\t    def get_triggers_for_source(self, source: Any) -> list[TriggerRegistration]:\n131\t        \"\"\"Return all triggers registered by *source* (identity-based).\"\"\"\n132\t        return [t for t in self._triggers if t.source is source]\n133\t\n134\t    def clear(self) -> None:\n135\t        \"\"\"Remove all registered triggers.\"\"\"\n136\t        self._triggers.clear()\n137\t"}]},"parent_tool_use_id":null,"session_id":"5fb6b059-d3b5-4b61-b723-cd48424c37bd","uuid":"2845c037-cc7b-4b80-8b72-3cc9eae5b9b1","timestamp":"2026-06-11T01:18:08.344Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/triggers.py","content":"\"\"\"Triggered abilities system — event-driven trigger registration and firing.\n\nProvides the core mechanism for registering triggered abilities and firing\nevents that push matching triggers onto the stack:\n\n- :class:`TriggerRegistration` — dataclass describing a single trigger.\n- :class:`TriggerManager` — central registry for triggers with APNAP-ordered\n  event firing.\n\nEvent types live in :mod:`engine.events` as typed dataclasses.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom typing import TYPE_CHECKING, Any, Callable\n\nfrom engine.events import TriggeredEvent\nfrom engine.stack import StackObject\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n@dataclass\nclass TriggerRegistration:\n    \"\"\"Describes a single triggered ability.\n\n    Attributes:\n        event_type: The event class (or a base class) this trigger watches.\n            The trigger fires for any fired event that is an instance of\n            this class, including instances of subclasses.\n        condition: Optional callable ``(game, event) -> bool`` that must\n            return ``True`` for the trigger to fire.  ``None`` means the\n            trigger always fires for its event type.\n        effect: Callable ``(game) -> None`` executed when the trigger\n            resolves (becomes the :attr:`StackObject.on_resolve` callback).\n        source: The game object (card / permanent) that owns this trigger.\n        controller: The player who controls the source at the time of\n            registration.\n    \"\"\"\n\n    event_type: type[TriggeredEvent]\n    condition: Callable[..., bool] | None\n    effect: Callable[..., None]\n    source: Any\n    controller: Player\n\n\nclass TriggerManager:\n    \"\"\"Central registry for triggered abilities.\n\n    Triggers are registered when a permanent enters the battlefield (or\n    via other game actions) and unregistered when the source leaves.\n\n    :meth:`fire_event` checks all registered triggers of a matching\n    event type, evaluates their conditions, and pushes matching triggers\n    onto the game stack as :class:`StackObject` instances.  Triggers are\n    ordered according to APNAP (Active Player, Non-Active Player):\n\n    * Active player's triggers are pushed first (end up on the bottom\n      of the batch).\n    * Non-active player's triggers are pushed second (end up on top).\n    * Within the same player, triggers are pushed in registration order\n      (controller would normally choose; for now we use registration\n      order as a deterministic default).\n    \"\"\"\n\n    def __init__(self) -> None:\n        self._triggers: list[TriggerRegistration] = []\n\n    def register(self, trigger: TriggerRegistration) -> None:\n        \"\"\"Register a triggered ability.\"\"\"\n        self._triggers.append(trigger)\n\n    def unregister(self, source: Any) -> None:\n        \"\"\"Remove all triggers registered by *source* (identity-based).\"\"\"\n        self._triggers = [t for t in self._triggers if t.source is not source]\n\n    def fire_event(self, game: GameState, event: TriggeredEvent) -> None:\n        \"\"\"Fire an event and push all matching triggers onto the stack.\n\n        Parameters:\n            game: The current game state.\n            event: The typed event object.  Triggers registered for the\n                event's class or any of its parent classes will fire.\n\n        Matching triggers are pushed in APNAP order:\n\n        1. Active player's matching triggers (in registration order).\n        2. Non-active player's matching triggers (in registration order).\n        \"\"\"\n        matching: list[TriggerRegistration] = []\n        for trigger in self._triggers:\n            if not isinstance(event, trigger.event_type):\n                continue\n            if trigger.condition is not None:\n                if not trigger.condition(game, event):\n                    continue\n            matching.append(trigger)\n\n        if not matching:\n            return\n\n        active_player = game.active_player\n        active_triggers: list[TriggerRegistration] = []\n        non_active_triggers: list[TriggerRegistration] = []\n\n        for trigger in matching:\n            if trigger.controller is active_player:\n                active_triggers.append(trigger)\n            else:\n                non_active_triggers.append(trigger)\n\n        ordered = active_triggers + non_active_triggers\n\n        for trigger in ordered:\n            stack_obj = StackObject(\n                source=trigger.source,\n                controller=trigger.controller,\n                on_resolve=trigger.effect,\n            )\n            game.stack.push(stack_obj)\n\n    def get_triggers(self) -> list[TriggerRegistration]:\n        \"\"\"Return a shallow copy of all registered triggers.\"\"\"\n        return list(self._triggers)\n\n    def get_triggers_for_source(self, source: Any) -> list[TriggerRegistration]:\n        \"\"\"Return all triggers registered by *source* (identity-based).\"\"\"\n        return [t for t in self._triggers if t.source is source]\n\n    def clear(self) -> None:\n        \"\"\"Remove all registered triggers.\"\"\"\n        self._triggers.clear()\n","numLines":137,"startLine":1,"totalLines":137}}}
{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_01JC9dDfDAUeJeUNAbnNmYW6","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01FQix3ewgo5Tv5YB2pmx7bs","name":"Read","input":{"file_path":"/workspace/engine/game_state.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4465,"cache_read_input_tokens":59578,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4465},"output_tokens":62,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5fb6b059-d3b5-4b61-b723-cd48424c37bd","uuid":"17b4d0a4-9050-4f53-8742-86aab8a06345","request_id":"req_011CbvbFBb2TnFa79fSTPqEJ"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FQix3ewgo5Tv5YB2pmx7bs","type":"tool_result","content":"1\t\"\"\"Central game state and turn/phase/step progression.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import Any\n6\t\n7\tfrom engine.combat import CombatState\n8\tfrom engine.continuous_effects import EffectManager\n9\tfrom engine.player import Player\n10\tfrom engine.replacement_effects import ReplacementManager\n11\tfrom engine.stack import Stack\n12\tfrom engine.triggers import TriggerManager\n13\tfrom engine.types import Phase, Step, Zone\n14\tfrom engine.zones import ZoneContainer\n15\t\n16\t# Ordered list of (Phase, Step | None) representing a full MTG turn.\n17\t_TURN_SEQUENCE: list[tuple[Phase, Step | None]] = [\n18\t    # Beginning phase\n19\t    (Phase.BEGINNING, Step.UNTAP),\n20\t    (Phase.BEGINNING, Step.UPKEEP),\n21\t    (Phase.BEGINNING, Step.DRAW),\n22\t    # Precombat main phase\n23\t    (Phase.PRECOMBAT_MAIN, None),\n24\t    # Combat phase\n25\t    (Phase.COMBAT, Step.BEGIN_COMBAT),\n26\t    (Phase.COMBAT, Step.DECLARE_ATTACKERS),\n27\t    (Phase.COMBAT, Step.DECLARE_BLOCKERS),\n28\t    (Phase.COMBAT, Step.COMBAT_DAMAGE),\n29\t    (Phase.COMBAT, Step.END_COMBAT),\n30\t    # Postcombat main phase\n31\t    (Phase.POSTCOMBAT_MAIN, None),\n32\t    # Ending phase\n33\t    (Phase.ENDING, Step.END),\n34\t    (Phase.ENDING, Step.CLEANUP),\n35\t]\n36\t\n37\t\n38\tclass GameState:\n39\t    \"\"\"Central game-state object tracking all mutable game information.\n40\t\n41\t    Attributes:\n42\t        players: The list of players in the game.\n43\t        active_player_index: Index of the current active player.\n44\t        priority_player_index: Index of the player who currently has priority.\n45\t        phase: Current phase of the turn.\n46\t        step: Current step within the phase (``None`` for main phases).\n47\t        turn_number: The current turn number (1-indexed).\n48\t        stack: The game stack for spells and abilities.\n49\t        trigger_manager: Central registry for triggered abilities.\n50\t        replacement_manager: Central registry for replacement effects.\n51\t        effect_manager: Manager for continuous effects and the layer system.\n52\t        is_game_over: Whether the game has ended.\n53\t        winner: The winning player, or ``None`` if the game is ongoing / draw.\n54\t    \"\"\"\n55\t\n56\t    def __init__(self, players: list[Player]) -> None:\n57\t        if len(players) < 2:\n58\t            raise ValueError(\"GameState requires at least 2 players\")\n59\t        if len(players) > 2:\n60\t            raise ValueError(\"GameState supports exactly 2 players\")\n61\t\n62\t        self.players: list[Player] = players\n63\t        self.active_player_index: int = 0\n64\t        self.priority_player_index: int = 0\n65\t        self.phase: Phase = Phase.BEGINNING\n66\t        self.step: Step | None = Step.UNTAP\n67\t        self.turn_number: int = 1\n68\t        self.stack: Stack = Stack()\n69\t        self.trigger_manager: TriggerManager = TriggerManager()\n70\t        self.replacement_manager: ReplacementManager = ReplacementManager()\n71\t        self.effect_manager: EffectManager = EffectManager()\n72\t        self.combat_state: CombatState = CombatState()\n73\t        self.is_game_over: bool = False\n74\t        self.winner: Player | None = None\n75\t        # ENGINE LIMITATION: Extra turns queue (FIFO of player seat indices).\n76\t        # Complex interactions ('skip your next turn', multiple extra turns\n77\t        # from different sources) are not fully handled.\n78\t        self.extra_turns: list[int] = []\n79\t        # Tracks normal turn rotation independently of extra turns.\n80\t        # Extra turns are truly *inserted* — they don't advance the\n81\t        # normal rotation.  When extras are exhausted the game picks up\n82\t        # from _normal_next_index.\n83\t        self._normal_next_index: int = 1\n84\t\n85\t    # ------------------------------------------------------------------\n86\t    # Player properties\n87\t    # ------------------------------------------------------------------\n88\t\n89\t    @property\n90\t    def active_player(self) -> Player:\n91\t        \"\"\"Return the currently active player.\"\"\"\n92\t        return self.players[self.active_player_index]\n93\t\n94\t    @property\n95\t    def priority_player(self) -> Player:\n96\t        \"\"\"Return the player who currently has priority.\"\"\"\n97\t        return self.players[self.priority_player_index]\n98\t\n99\t    @property\n100\t    def non_active_player(self) -> Player:\n101\t        \"\"\"Return the non-active player (2-player assumption for v1).\"\"\"\n102\t        return self.players[1 - self.active_player_index]\n103\t\n104\t    # ------------------------------------------------------------------\n105\t    # Zone accessors\n106\t    # ------------------------------------------------------------------\n107\t\n108\t    def get_battlefield(self, player: Player) -> ZoneContainer:\n109\t        \"\"\"Return the battlefield zone for *player*.\"\"\"\n110\t        return player.zones[Zone.BATTLEFIELD]\n111\t\n112\t    def get_hand(self, player: Player) -> ZoneContainer:\n113\t        \"\"\"Return the hand zone for *player*.\"\"\"\n114\t        return player.zones[Zone.HAND]\n115\t\n116\t    def get_graveyard(self, player: Player) -> ZoneContainer:\n117\t        \"\"\"Return the graveyard zone for *player*.\"\"\"\n118\t        return player.zones[Zone.GRAVEYARD]\n119\t\n120\t    def get_library(self, player: Player) -> ZoneContainer:\n121\t        \"\"\"Return the library zone for *player*.\"\"\"\n122\t        return player.zones[Zone.LIBRARY]\n123\t\n124\t    def get_exile(self, player: Player) -> ZoneContainer:\n125\t        \"\"\"Return the exile zone for *player*.\"\"\"\n126\t        return player.zones[Zone.EXILE]\n127\t\n128\t    # ------------------------------------------------------------------\n129\t    # Phase/step progression\n130\t    # ------------------------------------------------------------------\n131\t\n132\t    def advance_phase(self) -> None:\n133\t        \"\"\"Advance to the next phase/step in MTG turn order.\n134\t\n135\t        At the end of CLEANUP, the turn number is incremented and the\n136\t        active player swaps (2-player assumption).  Mana pools are\n137\t        emptied on every transition.\n138\t        \"\"\"\n139\t        current = (self.phase, self.step)\n140\t        idx = _TURN_SEQUENCE.index(current)\n141\t\n142\t        if idx + 1 < len(_TURN_SEQUENCE):\n143\t            # Move to next phase/step within the same turn.\n144\t            next_phase, next_step = _TURN_SEQUENCE[idx + 1]\n145\t            self.phase = next_phase\n146\t            self.step = next_step\n147\t        else:\n148\t            # End of turn — wrap around.\n149\t            self.turn_number += 1\n150\t            if self.extra_turns:\n151\t                # ENGINE LIMITATION: Extra turns queue (FIFO). Pop the\n152\t                # next player seat index; that player gets the next turn.\n153\t                # Normal rotation is NOT advanced — extra turns are\n154\t                # inserted before the normal next turn.\n155\t                self.active_player_index = self.extra_turns.pop(0)\n156\t            else:\n157\t                self.active_player_index = self._normal_next_index\n158\t                self._normal_next_index = 1 - self._normal_next_index\n159\t            self.priority_player_index = self.active_player_index\n160\t            self.phase = _TURN_SEQUENCE[0][0]\n161\t            self.step = _TURN_SEQUENCE[0][1]\n162\t\n163\t        self.empty_mana_pools()\n164\t\n165\t    def empty_mana_pools(self) -> None:\n166\t        \"\"\"Empty all players' mana pools — called on each phase/step transition.\"\"\"\n167\t        for player in self.players:\n168\t            player.mana_pool.empty()\n169\t"}]},"parent_tool_use_id":null,"session_id":"5fb6b059-d3b5-4b61-b723-cd48424c37bd","uuid":"57197b59-602c-43b6-9a5c-c2828d27ce3c","timestamp":"2026-06-11T01:18:13.216Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/game_state.py","content":"\"\"\"Central game state and turn/phase/step progression.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any\n\nfrom engine.combat import CombatState\nfrom engine.continuous_effects import EffectManager\nfrom engine.player import Player\nfrom engine.replacement_effects import ReplacementManager\nfrom engine.stack import Stack\nfrom engine.triggers import TriggerManager\nfrom engine.types import Phase, Step, Zone\nfrom engine.zones import ZoneContainer\n\n# Ordered list of (Phase, Step | None) representing a full MTG turn.\n_TURN_SEQUENCE: list[tuple[Phase, Step | None]] = [\n    # Beginning phase\n    (Phase.BEGINNING, Step.UNTAP),\n    (Phase.BEGINNING, Step.UPKEEP),\n    (Phase.BEGINNING, Step.DRAW),\n    # Precombat main phase\n    (Phase.PRECOMBAT_MAIN, None),\n    # Combat phase\n    (Phase.COMBAT, Step.BEGIN_COMBAT),\n    (Phase.COMBAT, Step.DECLARE_ATTACKERS),\n    (Phase.COMBAT, Step.DECLARE_BLOCKERS),\n    (Phase.COMBAT, Step.COMBAT_DAMAGE),\n    (Phase.COMBAT, Step.END_COMBAT),\n    # Postcombat main phase\n    (Phase.POSTCOMBAT_MAIN, None),\n    # Ending phase\n    (Phase.ENDING, Step.END),\n    (Phase.ENDING, Step.CLEANUP),\n]\n\n\nclass GameState:\n    \"\"\"Central game-state object tracking all mutable game information.\n\n    Attributes:\n        players: The list of players in the game.\n        active_player_index: Index of the current active player.\n        priority_player_index: Index of the player who currently has priority.\n        phase: Current phase of the turn.\n        step: Current step within the phase (``None`` for main phases).\n        turn_number: The current turn number (1-indexed).\n        stack: The game stack for spells and abilities.\n        trigger_manager: Central registry for triggered abilities.\n        replacement_manager: Central registry for replacement effects.\n        effect_manager: Manager for continuous effects and the layer system.\n        is_game_over: Whether the game has ended.\n        winner: The winning player, or ``None`` if the game is ongoing / draw.\n    \"\"\"\n\n    def __init__(self, players: list[Player]) -> None:\n        if len(players) < 2:\n            raise ValueError(\"GameState requires at least 2 players\")\n        if len(players) > 2:\n            raise ValueError(\"GameState supports exactly 2 players\")\n\n        self.players: list[Player] = players\n        self.active_player_index: int = 0\n        self.priority_player_index: int = 0\n        self.phase: Phase = Phase.BEGINNING\n        self.step: Step | None = Step.UNTAP\n        self.turn_number: int = 1\n        self.stack: Stack = Stack()\n        self.trigger_manager: TriggerManager = TriggerManager()\n        self.replacement_manager: ReplacementManager = ReplacementManager()\n        self.effect_manager: EffectManager = EffectManager()\n        self.combat_state: CombatState = CombatState()\n        self.is_game_over: bool = False\n        self.winner: Player | None = None\n        # ENGINE LIMITATION: Extra turns queue (FIFO of player seat indices).\n        # Complex interactions ('skip your next turn', multiple extra turns\n        # from different sources) are not fully handled.\n        self.extra_turns: list[int] = []\n        # Tracks normal turn rotation independently of extra turns.\n        # Extra turns are truly *inserted* — they don't advance the\n        # normal rotation.  When extras are exhausted the game picks up\n        # from _normal_next_index.\n        self._normal_next_index: int = 1\n\n    # ------------------------------------------------------------------\n    # Player properties\n    # ------------------------------------------------------------------\n\n    @property\n    def active_player(self) -> Player:\n        \"\"\"Return the currently active player.\"\"\"\n        return self.players[self.active_player_index]\n\n    @property\n    def priority_player(self) -> Player:\n        \"\"\"Return the player who currently has priority.\"\"\"\n        return self.players[self.priority_player_index]\n\n    @property\n    def non_active_player(self) -> Player:\n        \"\"\"Return the non-active player (2-player assumption for v1).\"\"\"\n        return self.players[1 - self.active_player_index]\n\n    # ------------------------------------------------------------------\n    # Zone accessors\n    # ------------------------------------------------------------------\n\n    def get_battlefield(self, player: Player) -> ZoneContainer:\n        \"\"\"Return the battlefield zone for *player*.\"\"\"\n        return player.zones[Zone.BATTLEFIELD]\n\n    def get_hand(self, player: Player) -> ZoneContainer:\n        \"\"\"Return the hand zone for *player*.\"\"\"\n        return player.zones[Zone.HAND]\n\n    def get_graveyard(self, player: Player) -> ZoneContainer:\n        \"\"\"Return the graveyard zone for *player*.\"\"\"\n        return player.zones[Zone.GRAVEYARD]\n\n    def get_library(self, player: Player) -> ZoneContainer:\n        \"\"\"Return the library zone for *player*.\"\"\"\n        return player.zones[Zone.LIBRARY]\n\n    def get_exile(self, player: Player) -> ZoneContainer:\n        \"\"\"Return the exile zone for *player*.\"\"\"\n        return player.zones[Zone.EXILE]\n\n    # ------------------------------------------------------------------\n    # Phase/step progression\n    # ------------------------------------------------------------------\n\n    def advance_phase(self) -> None:\n        \"\"\"Advance to the next phase/step in MTG turn order.\n\n        At the end of CLEANUP, the turn number is incremented and the\n        active player swaps (2-player assumption).  Mana pools are\n        emptied on every transition.\n        \"\"\"\n        current = (self.phase, self.step)\n        idx = _TURN_SEQUENCE.index(current)\n\n        if idx + 1 < len(_TURN_SEQUENCE):\n            # Move to next phase/step within the same turn.\n            next_phase, next_step = _TURN_SEQUENCE[idx + 1]\n            self.phase = next_phase\n            self.step = next_step\n        else:\n            # End of turn — wrap around.\n            self.turn_number += 1\n            if self.extra_turns:\n                # ENGINE LIMITATION: Extra turns queue (FIFO). Pop the\n                # next player seat index; that player gets the next turn.\n                # Normal rotation is NOT advanced — extra turns are\n                # inserted before the normal next turn.\n                self.active_player_index = self.extra_turns.pop(0)\n            else:\n                self.active_player_index = self._normal_next_index\n                self._normal_next_index = 1 - self._normal_next_index\n            self.priority_player_index = self.active_player_index\n            self.phase = _TURN_SEQUENCE[0][0]\n            self.step = _TURN_SEQUENCE[0][1]\n\n        self.empty_mana_pools()\n\n    def empty_mana_pools(self) -> None:\n        \"\"\"Empty all players' mana pools — called on each phase/step transition.\"\"\"\n        for player in self.players:\n            player.mana_pool.empty()\n","numLines":169,"startLine":1,"totalLines":169}}}
