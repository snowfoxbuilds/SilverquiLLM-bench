{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_017yBoUUBraxckZN753KpE21","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_016TEMMQgpaWhwfdy9Xdq34b","name":"Bash","input":{"command":"python3 - <<'EOF'\nfrom test_utils import create_game, set_board_state\nfrom cards.sos.sos_201.card_impl import LoreholdTheHistorian\nfrom engine.card import Creature, Instant\nfrom engine.game import draw_card\nfrom engine.stack import priority_loop\nfrom engine.types import ManaCost, ManaType\n\nclass Probe(Instant):\n    def __init__(self, **kw):\n        kw.setdefault(\"name\", \"Probe\"); kw.setdefault(\"mana_cost\", ManaCost.parse(\"{4}\"))\n        super().__init__(**kw)\n    def on_resolve(self, game):\n        self.controller.life += 3\n\n# Turn N: creature eats first draw. Turn N+1: instant is first draw -> miracle.\ngame = create_game()\np1, p2 = game.players\nlh = LoreholdTheHistorian(owner=None)\nset_board_state(game, 0, battlefield=[lh], mana={ManaType.COLORLESS: 2})\nlh.register_triggers(game)\nbear = Creature(name=\"Bear\", base_power=1, base_toughness=1); bear.owner = p1\nprobe = Probe(); probe.owner = p1\nlib = game.get_library(p1)\nlib.add(probe); lib.add(bear)  # bear on top\ndraw_card(game, p1)            # turn N first draw: creature, no miracle\nassert game.stack.is_empty()\ngame.turn_number += 1          # new turn\np1.mana_pool.add(ManaType.COLORLESS, 2)\np1._script.extend([\"pass\", True, \"pass\"]); p2._script.extend([\"pass\", \"pass\"])\ndraw_card(game, p1)            # turn N+1 first draw: instant -> miracle\npriority_loop(game)\nassert p1.life == 23, p1.life\nprint(\"smoke OK: first-draw tracking resets on a new turn\")\nEOF\npython3 -m pytest engine_tests/ cards/sos -q 2>&1 | tail -1","description":"Turn-reset miracle smoke, full guard"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":296,"cache_read_input_tokens"