ne)","+        if ctrl is None or caster is not ctrl:","+            return False","+        spell = getattr(event, \"card\", None)","+        return bool(","+            getattr(spell, \"card_types\", set()) & {CardType.INSTANT, CardType.SORCERY}","+        )","+","+    def _effect(game: GameState) -> None:","+        def _apply(game: Any) -> None:","+            source.modified_power += 1","+","+        game.effect_manager.add(","+            ContinuousEffect(","+                source=source,","+                layer=Layer.POWER_TOUGHNESS,","+                sublayer=SubLayer.MODIFY_PT,","+                apply=_apply,","+                duration=DURATION_END_OF_TURN,","+            )","+        )","+        game.effect_manager.apply_all(game)","+","+    game.trigger_manager.register(","+        TriggerRegistration(","+            event_type=SpellCastTriggeredEvent,","+            condition=_condition,","+            effect=_effect,","+            source=source,","+            controller=getattr(source, \"controller\", None) or game.active_player,","+        )","+    )"]}],"originalFile":"\"\"\"Card implementation for Great Hall of the Biblioplex.\"\"\"\n\nfrom __future__ import annotations\n\nfrom engine.card import CardImpl\n\nfrom typing import TYPE_CHECKING\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\nclass GreatHallOfTheBiblioplex(CardImpl):\n    \"\"\"TODO: Implement Great Hall of the Biblioplex.\"\"\"\n\n    pass\n","userModified":false}}
