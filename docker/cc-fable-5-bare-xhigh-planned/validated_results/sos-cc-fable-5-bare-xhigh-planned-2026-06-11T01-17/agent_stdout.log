description=\"any target\",\n                zone=Zone.BATTLEFIELD,\n            ),\n        ]\n\n    def on_resolve(self, game: GameState) -> None:\n        \"\"\"Draw X / deal X / gain X, where X = colors of mana spent.\"\"\"\n        from engine.game import deal_damage, draw_card\n\n        x = len(set(getattr(self, \"colors_spent\", []) or []))\n\n        chosen = getattr(self, \"chosen_targets\", None) or []\n        player_target = chosen[0] if len(chosen) > 0 else None\n        damage_target = chosen[1] if len(chosen) > 1 else None\n\n        if player_target is not None and hasattr(player_target, \"life\"):\n            for _ in range(x):\n                draw_card(game, player_target)\n\n        if damage_target is not None:\n            deal_damage(game, self, damage_target, x)\n\n        controller = self.controller\n        if controller is not None and x > 0:\n            controller.life += x\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":268,"cache_read_input_tokens":146566,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":268},"output_tokens":69,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5fb6b059-d3b5-4b61-b723-cd48424c37bd","uuid":"8a8efe32-785e-4c06-87f8-32654d1d9ab9","request_id":"req_011CbvbcxRNn4vhQwPABZiG8"}
