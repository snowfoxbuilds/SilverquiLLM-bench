       def _apply(game: Any) -> None:\n                if _is_on_battlefield(game, creature_ref):\n                    creature_ref.modified_power += 1\n            game.effect_manager.add(ContinuousEffect(source=source, layer=Layer.POWER_TOUGHNESS, sublayer=SubLayer.MODIFY_PT, apply=_apply, duration=DURATION_END_OF_TURN))\n        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=controller))\n===\n/workspace/engine_tests/test_continuous_effects.py:11:- EffectManager.apply_all: correct layer ordering, sublayer ordering for layer 7,\n/workspace/engine_tests/test_continuous_effects.py:387:# EffectManager — apply_all\n/workspace/engine_tests/test_continuous_effects.py:392:    \"\"\"Verify EffectManager.apply_all ordering and execution.\"\"\"\n/workspace/engine_tests/test_continuous_effects.py:394:    def test_apply_all_empty_no_error(self, manager: EffectManager, game: GameState):\n/workspace/engine_tests/test_continuous_effects.py:396:        manager.apply_all(game)  # should not raise","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
