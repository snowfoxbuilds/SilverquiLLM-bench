 → AbilityError.\n- Cost payment failure → AbilityError, no stack entry.\n- Integration: land tap-for-mana → mana added and card tapped.\n- Multiple abilities on the same source.\n- Edge cases: unknown ability type, zero loyalty cost, etc.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport pytest\n\nfrom engine.abilities import (\n    AbilityError,\n    ActivatedAbilityInstance,\n    LoyaltyAbilityInstance,\n    activate_ability,\n    clear_loyalty_tracking,\n    tap_cost,\n)\nfrom engine.card import Land, Planeswalker\nfrom engine.game_state import GameState\nfrom engine.mana import ManaPool\nfrom engine.player import DeterministicPlayer\nfrom engine.stack import StackObject\nfrom engine.types import ManaType, Phase, Step\n\n\n# ---------------------------------------------------------------------------\n# Helpers / Fixtures\n# ---------------------------------------------------------------------------\n\n\n@pytest.fixture(autouse=True)\ndef _reset_loyalty_tracker():\n    \"\"\"Ensure the module-level loyalty tracker is clean for every test.\"\"\"\n    clear_loyalty_tracking()\n    yield\n    clear_loyalty_tracking()\n\n\ndef _make_game(\n    *,\n    p1_script: list | None = None,\n    p2_script: list | None = None,\n    phase: Phase = Phase.PRECOMBAT_MAIN,\n    step: Step | None = None,\n) -> GameState:\n    \"\"\"Create a minimal 2-player GameState at the specified phase/step.\"\"\"\n    p1 = DeterministicPlayer(\"Alice\", p1_script or [])\n    p2 = DeterministicPlayer(\"Bob\", p2_script or [])\n    game = GameState([p1, p2])\n    game.phase = phase\n    game.step = step\n    return game\n\n\ndef _sorcery_speed_game() -> GameState:\n    \"\"\"Return a game where sorcery-speed timing is met for the active player.\"\"\"\n    return _make_game(phase=Phase.PRECOMBAT_MAIN, step=None)\n\n\ndef _instant_speed_game() -> GameState:\n    \"\"\"Return a game where sorcery-speed timing is NOT met (combat phase).\"\"\"\n    return _make_game(phase=Phase.COMBAT, step=Step.DECLARE_ATTACKERS)\n\n\n----\n/workspace/engine_tests/test_card.py:252:    def test_get_activated_abilities_returns_empty_list(self) -> None:\n/workspace/engine_tests/test_card.py:253:        \"\"\"get_activated_abilities should return an empty list by default.\"\"\"\n/workspace/engine_tests/test_card.py:255:        assert card.get_activated_abilities() == []\n/workspace/engine_tests/test_abilities.py:4:- ActivatedAbilityInstance dataclass construction and fields.\n/workspace/engine_tests/test_abilities.py:5:- LoyaltyAbilityInstance dataclass construction and fields.\n/workspace/engine_tests/test_abilities.py:6:- activate_ability: mana ability → resolves immediately (no stack), effect applied.\n/workspace/engine_tests/test_abilities.py:7:- activate_ability: non-mana ability → pushes StackObject to stack.\n/workspace/engine_tests/test_abilities.py:28:    ActivatedAbilityInstance,\n/workspace/engine_tests/test_abilities.py:29:    LoyaltyAbilityInstance,\n/workspace/engine_tests/test_abilities.py:30:    activate_ability,\n/workspace/engine_tests/test_abilities.py:82:# ActivatedAbilityInstance — construction\n/workspace/engine_tests/test_abilities.py:86:class TestActivatedAbilityInstanceConstruction:\n/workspace/engine_tests/test_abilities.py:87:    \"\"\"ActivatedAbilityInstance dataclass stores all expected fields.\"\"\"\n/workspace/engine_tests/test_abilities.py:94:        ability = ActivatedAbilityInstance(\n/workspace/engine_tests/test_abilities.py:112:        ability = ActivatedAbilityInstance(\n/workspace/engine_tests/test_abilities.py:123:# LoyaltyAbilityInstance — construction\n/workspace/engine_tests/test_abilities.py:127:class TestLoyaltyAbilityInstanceConstruction:\n/workspace/engine_tests/test_abilities.py:128:    \"\"\"LoyaltyAbilityInstance dataclass stores all expected fields.\"\"\"\n/workspace/engine_tests/test_abilities.py:134:        ability = LoyaltyAbilityInstance(\n/workspace/engine_tests/test_abilities.py:150:        ability = LoyaltyAbilityInstance(\n/workspace/engine_tests/test_abilities.py:209:# activate_ability — mana ability (resolves immediately)\n/workspace/engine_tests/test_abilities.py:221:        ability = ActivatedAbilityInstance(\n/workspace/engine_tests/test_abilities.py:228:        activate_ability(game, player, ability)\n/workspace/engine_tests/test_abilities.py:236:        ability = ActivatedAbilityInstance(\n/workspace/engine_tests/test_abilities.py:243:        activate_ability(game, player, ability)\n/workspace/engine_tests/test_abilities.py:252:        ability = ActivatedAbilityInstance(\n/workspace/engine_tests/test_abilities.py:260:        activate_ability(game, player, ability)\n/workspace/engine_tests/test_abilities.py:269:        ability = ActivatedAbilityInstance(\n/workspace/engine_tests/test_abilities.py:277:        activate_ability(game, non_active, ability)\n/workspace/engine_tests/test_abilities.py:286:        ability = ActivatedAbilityInstance(\n/workspace/engine_tests/test_abilities.py:294:            activate_ability(game, player, ability)\n/workspace/engine_tests/test_abilities.py:298:# activate_ability — non-mana ability (pushes to stack)\n/workspace/engine_tests/test_abilities.py:309:        ability = ActivatedAbilityInstance(\n/workspace/engine_tests/test_abilities.py:316:        activate_ability(game, player, ability)\n/workspace/engine_tests/test_abilities.py:323:        ability = ActivatedAbilityInstance(\n/workspace/engine_tests/test_abilities.py:329:        activate_ability(game, player, ability)\n/workspace/engine_tests/test_abilities.py:337:        ability = ActivatedAbilityInstance(\n/workspace/engine_tests/test_abilities.py:343:        activate_ability(game, player, ability)\n/workspace/engine_tests/test_abilities.py:352:        ability = ActivatedAbilityInstance(\n/workspace/engine_tests/test_abilities.py:358:        activate_ability(game, player, ability)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
