    description=\"any target\",\n                zone=Zone.BATTLEFIELD,\n            ),\n        ]\n\n    def on_resolve(self, game: GameState) -> None:\n        \"\"\"Draw X, deal X damage, gain X life — X = colors of mana spent.\"\"\"\n        from engine.game import deal_damage, draw_card\n\n        x = len(set(getattr(self, \"colors_spent\", []) or []))\n\n        chosen = getattr(self, \"chosen_targets\", None) or []\n        draw_target = chosen[0] if len(chosen) > 0 else None\n        damage_target = chosen[1] if len(chosen) > 1 else None\n\n        if draw_target is not None and hasattr(draw_target, \"life\"):\n            for _ in range(x):\n                draw_card(game, draw_target)\n\n        if damage_target is not None:\n            deal_damage(game, self, damage_target, x)\n\n        controller = self.controller\n        if controller is not None and hasattr(controller, \"life\"):\n            controller.life += x\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":427,"cache_read_input_tokens":142492,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":427},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"75cf876e-0070-4da1-a9bb-823668fe208a","uuid":"5ce0abd1-9011-4666-a978-15b5f6b69ad5","request_id":"req_011CbuAbFHv9HNAikeVnNCU8"}
