s.setdefault('base_power', 4)\n        kwargs.setdefault('base_toughness', 3)\n        kwargs.setdefault('rules_text', 'When this creature enters, return target permanent card from your graveyard to your hand.')\n        super().__init__(**kwargs)\n\n    def register_triggers(self, game: GameState) -> None:\n        from engine.triggers import TriggerRegistration\n        source = self\n\n        def _effect(game: GameState) -> None:\n            target = _get_chosen_target(source, game)\n            controller = getattr(source, 'controller', None)\n            if target is None or controller is None:\n                return\n            gy = controller.zones[Zone.GRAVEYARD]\n            if gy.contains(target):\n                gy.remove(target)\n                controller.zones[Zone.HAND].add(target)\n        controller = getattr(self, 'controller', None) or game.active_player\n        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=_self_etb_condition(self), effect=_effect, source=self, controller=controller))","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
