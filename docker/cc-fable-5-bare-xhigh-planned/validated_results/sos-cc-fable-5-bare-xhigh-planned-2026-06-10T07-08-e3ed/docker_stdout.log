ert n_caps == 1, n_caps  # only the original, in exile\nassert p1.zones[Zone.EXILE].contains(cap)\nprint('smoke OK')\n\" && python3 -m pytest engine_tests/ cards/ -q 2>&1 | tail -1","description":"sos_120 smoke check across turns, full guard"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":167,"cache_read_input_tokens":234688,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":167},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"35d9a150-b7c5-4977-937b-f1cc9a0f0ea7","uuid":"87c51bbc-1da2-4736-9826-b82d53184d39","request_id":"req_011CbuC2XPbky218SKHFMhp9"}
