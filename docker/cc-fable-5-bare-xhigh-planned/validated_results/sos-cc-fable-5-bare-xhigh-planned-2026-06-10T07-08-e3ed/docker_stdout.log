lity.targets is not None:","+            source.chosen_targets = targets","+        effect(g)","+","     stack_obj = StackObject(","         source=source,","         controller=player,","-        on_resolve=ability.effect,","+        targets=targets,","+        on_resolve=_resolve,","         is_mana_ability=False,","     )","     game.stack.push(stack_obj)","+","+","+# ---------------------------------------------------------------------------","+# Printed-ability activation helper","+# ---------------------------------------------------------------------------","+","+def activate_loyalty_ability_by_index(","+    game: GameState,","+    player: Any,","+    source: Any,","+    index: int,","+    targets: list[Any] | None = None,","+) -> None:","+    \"\"\"Activate the *index*-th printed loyalty ability of *source*.","+","+    Bridges the printed :class:`engine.card.LoyaltyAbility` dataclasses","+    (returned by ``get_loyalty_abilities``) to the runtime","+    :class:`LoyaltyAbilityInstance` consumed by :func:`activate_ability`.","+    Abilities are addressed by printed index.","+","+    Raises:","+        AbilityError: If *source* has no printed loyalty ability at *index*","+            or the activation is illegal (timing, loyalty, once-per-turn).","+    \"\"\"","+    printed = getattr(source, \"get_loyalty_abilities\", lambda: [])()","+    if index < 0 or index >= len(printed):","+        raise AbilityError(","+            f\"{getattr(source, 'name', source)!r} has no loyalty ability \"","+            f\"at index {index}\"","+        )","+    ability = printed[index]","+    instance = LoyaltyAbilityInstance(","+        source=source,","+        controller=player,","+        loyalty_cost=ability.loyalty_cost,","+        effect=ability.effect,","+        description=ability.description,","+        targets=targets,","+    )","+    activate_ability(game, player, instance)"]}],"userModified":false,"replaceAll":false}}
