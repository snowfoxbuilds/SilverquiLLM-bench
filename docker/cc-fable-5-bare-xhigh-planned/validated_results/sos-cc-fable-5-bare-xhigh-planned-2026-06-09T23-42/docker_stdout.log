       if not ctrl.choose_yes_no(\n                f\"Casualty — sacrifice a creature to copy {pending.name}?\"\n            ):\n                return\n            chosen = ctrl.choose_card(candidates, \"Choose a creature to sacrifice\")\n            if chosen is None or not bf.contains(chosen):\n                return\n            sacrifice(game, ctrl, chosen)\n\n            # Find the original spell still on the stack.\n            original_so = None\n            for so in game.stack._items:  # noqa: SLF001 — fdn_248 pattern\n                if so.source is pending:\n                    original_so = so\n                    break\n            if original_so is None:\n                return  # spell left the stack (e.g. countered) — no copy\n\n            new_targets: list[Any] | None = None\n            if original_so.targets:\n                if ctrl.choose_yes_no(\n                    f\"Choose new targets for copy of {pending.name}?\"\n                ):\n                    requirements = getattr(pending, \"get_targets\", lambda _: [])(game)\n                    new_targets = []\n                    for req in requirements:\n                        legal: list[Any] = []\n                        for p in game.players:\n                            for obj in game.get_battlefield(p).get_all():\n                                if req.filter_fn(obj):\n                                    legal.append(obj)\n                            if req.filter_fn(p):\n                                legal.append(p)\n                        if legal:\n                            new_targets.append(ctrl.choose_target(legal, req))\n            copy_obj = copy_spell(game, original_so, ctrl, new_targets)\n            game.stack.push(copy_obj)\n\n        game.trigger_manager.register(\n            TriggerRegistration(\n                event_type=SpellCastTriggeredEvent,\n                condition=_condition,\n                effect=_effect,\n                source=self,\n            