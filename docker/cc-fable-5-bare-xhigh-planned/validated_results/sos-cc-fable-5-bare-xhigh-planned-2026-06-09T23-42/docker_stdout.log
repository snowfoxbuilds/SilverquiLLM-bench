layers.index(target)\n            game.skip_turns[idx] = game.skip_turns.get(idx, 0) + heads\n\n        return [\n            LoyaltyAbility(loyalty_cost=+1, effect=_plus1, description=\"+1: Surveil 2.\"),\n            LoyaltyAbility(\n                loyalty_cost=-1,\n                effect=_minus1,\n                description=\"−1: Any number of target players each discard a card.\",\n            ),\n            LoyaltyAbility(\n                loyalty_cost=-2,\n                effect=_minus2,\n                description=(\n                    \"−2: Return target creature card with mana value 3 or \"\n                    \"less from your graveyard to the battlefield.\"\n                ),\n            ),\n            LoyaltyAbility(\n                loyalty_cost=-7,\n                effect=_minus7,\n                description=(\n                    \"−7: Flip five coins. Target opponent skips their next \"\n                    \"X turns, where X is the number of heads.\"\n                ),\n            ),\n        ]\n","structuredPatch":[{"oldStart":2,"oldLines":15,"newStart":2,"newLines":153,"lines":[" "," from __future__ import annotations"," ","-from engine.card import CardImpl","+import random","+from typing import TYPE_CHECKING, Any"," ","-from typing import TYPE_CHECKING","+from engine.card import LoyaltyAbility, Planeswalker","+from engine.types import CardType, ManaCost, Supertype, Zone"," "," if TYPE_CHECKING:","     from engine.game_state import GameState"," "," ","-class RalZarekGuestLecturer(CardImpl):","-    \"\"\"TODO: Implement Ral Zarek, Guest Lecturer.\"\"\"","+class RalZarekGuestLecturer(Planeswalker):","+    \"\"\"Ral Zarek, Guest Lecturer — {1}{B}{B} — loyalty 3 — Legendary","+    Planeswalker — Ral."," ","-    pass","+    +1: Surveil 2.","+    −1: Any number of target players each discard a card.","+    −2: Return target creature card with mana value 3 or less from your","+        graveyard to the battlefield.","+    −7: Flip five coins. T