      controller = self.controller\n        if controller is None:\n            return\n\n        # Use colors_spent attribute (set during casting or by test setup).\n        count = self.colors_spent\n\n        for _ in range(count):\n            token = Creature(\n                name=\"Saproling\",\n                subtypes={\"Saproling\"},\n                base_power=1,\n                base_toughness=1,\n            )\n            create_token(game, controller, token)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
