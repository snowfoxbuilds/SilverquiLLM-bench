":2,"cache_creation_input_tokens":134,"cache_read_input_tokens":289820,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":134},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"61a2af5c-d600-4497-9e1f-4081c4861a6a","uuid":"5641e485-ae7b-4045-a2cd-a7e69cdedfbf","request_id":"req_011Cbv1fqpssE7kmcgef16AW"}
