{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_018xJ7suiFxZso7b7KGQGm2j","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01BYUAQ2rV3CSX7BN1nWqRqJ","name":"Read","input":{"file_path":"/workspace/engine/abilities.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1936,"cache_read_input_tokens":84885,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1936},"output_tokens":9,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"61a2af5c-d600-4497-9e1f-4081c4861a6a","uuid":"19a1bd7d-492a-437b-b1d3-fa6394ee9e21","request_id":"req_011CbuxpmiUPbeUBxg65DYEf"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BYUAQ2rV3CSX7BN1nWqRqJ","type":"tool_result","content":"1\t\"\"\"Activated abilities system — tap-for-mana, loyalty abilities, and general\n2\tactivated abilities that go on the stack (or resolve immediately for mana\n3\tabilities).\n4\t\n5\tProvides:\n6\t\n7\t- :func:`activate_ability` — verify timing → pay costs → resolve immediately\n8\t  (mana abilities) or push to the stack (non-mana abilities).\n9\t- :func:`tap_cost` — generic tap-cost helper: checks ``not source.is_tapped``\n10\t  and taps the source.\n11\t- :class:`ActivatedAbilityInstance` — a runtime representation of an activated\n12\t  ability with source, controller, cost/effect callables, and metadata.\n13\t- :class:`LoyaltyAbilityInstance` — activated ability variant for planeswalker\n14\t  loyalty abilities with per-turn restriction and loyalty-counter cost.\n15\t\"\"\"\n16\t\n17\tfrom __future__ import annotations\n18\t\n19\tfrom dataclasses import dataclass, field\n20\tfrom typing import TYPE_CHECKING, Any, Callable\n21\t\n22\tfrom engine.casting import is_sorcery_speed\n23\tfrom engine.stack import StackObject\n24\t\n25\tif TYPE_CHECKING:\n26\t    from engine.game_state import GameState\n27\t    from engine.player import Player\n28\t\n29\t\n30\tclass AbilityError(Exception):\n31\t    \"\"\"Raised when an ability activation is illegal.\"\"\"\n32\t\n33\t\n34\t# ---------------------------------------------------------------------------\n35\t# Runtime ability representations\n36\t# ---------------------------------------------------------------------------\n37\t\n38\t@dataclass\n39\tclass ActivatedAbilityInstance:\n40\t    \"\"\"Runtime representation of an activated ability.\n41\t\n42\t    This captures everything needed to activate and resolve an ability:\n43\t    the source permanent, the controlling player, cost/effect callables,\n44\t    and whether the ability is a mana ability.\n45\t\n46\t    Attributes:\n47\t        source: The permanent that has this ability.\n48\t        controller: The player who controls the source.\n49\t        cost: A callable ``(game, source) -> bool`` that checks and pays\n50\t            the cost. Returns ``True`` if the cost was successfully paid,\n51\t            ``False`` otherwise.\n52\t        effect: A callable ``(game) -> None`` that applies the ability's\n53\t            effect when it resolves.\n54\t        is_mana_ability: Whether this is a mana ability (resolves\n55\t            immediately without using the stack).\n56\t        description: Human-readable description of the ability.\n57\t    \"\"\"\n58\t\n59\t    source: Any\n60\t    controller: Any  # Player\n61\t    cost: Callable[..., bool]\n62\t    effect: Callable[..., None]\n63\t    is_mana_ability: bool = False\n64\t    description: str = \"\"\n65\t\n66\t\n67\t@dataclass\n68\tclass LoyaltyAbilityInstance:\n69\t    \"\"\"Runtime representation of a planeswalker loyalty ability.\n70\t\n71\t    Loyalty abilities are activated abilities with special restrictions:\n72\t    they may only be activated at sorcery speed, and only once per turn\n73\t    per source (tracked via ``_activated_this_turn``).\n74\t\n75\t    The cost adjusts the loyalty counters on the source planeswalker.\n76\t\n77\t    Attributes:\n78\t        source: The planeswalker permanent.\n79\t        controller: The player who controls the planeswalker.\n80\t        loyalty_cost: The loyalty adjustment (positive for ``+N``,\n81\t            negative for ``−N``, zero for ``0``).\n82\t        effect: A callable ``(game) -> None`` for the ability's effect.\n83\t        description: Human-readable description.\n84\t    \"\"\"\n85\t\n86\t    source: Any\n87\t    controller: Any  # Player\n88\t    loyalty_cost: int = 0\n89\t    effect: Callable[..., None] = field(default=lambda _game: None)\n90\t    description: str = \"\"\n91\t\n92\t\n93\t# ---------------------------------------------------------------------------\n94\t# Per-turn loyalty tracking\n95\t# ---------------------------------------------------------------------------\n96\t\n97\t# Set of (object_id, turn_number) pairs that have already activated a\n98\t# loyalty ability this turn.  Callers should call\n99\t# ``clear_loyalty_tracking()`` at the start of each turn or manage the\n100\t# set externally.\n101\t_loyalty_activated_this_turn: set[tuple[int, int]] = set()\n102\t\n103\t\n104\tdef clear_loyalty_tracking() -> None:\n105\t    \"\"\"Clear the loyalty-activated-this-turn tracker.\n106\t\n107\t    Should be called at the start of each turn so that planeswalkers may\n108\t    activate loyalty abilities again.\n109\t    \"\"\"\n110\t    _loyalty_activated_this_turn.clear()\n111\t\n112\t\n113\tdef _has_activated_loyalty_this_turn(source: Any, turn_number: int) -> bool:\n114\t    \"\"\"Return ``True`` if *source* already used a loyalty ability this turn.\"\"\"\n115\t    obj_id = getattr(source, \"object_id\", id(source))\n116\t    return (obj_id, turn_number) in _loyalty_activated_this_turn\n117\t\n118\t\n119\tdef _mark_loyalty_activated(source: Any, turn_number: int) -> None:\n120\t    \"\"\"Record that *source* used a loyalty ability this turn.\"\"\"\n121\t    obj_id = getattr(source, \"object_id\", id(source))\n122\t    _loyalty_activated_this_turn.add((obj_id, turn_number))\n123\t\n124\t\n125\t# ---------------------------------------------------------------------------\n126\t# Tap cost helper\n127\t# ---------------------------------------------------------------------------\n128\t\n129\tdef tap_cost(game: GameState, source: Any) -> bool:\n130\t    \"\"\"Generic tap-cost function.\n131\t\n132\t    Checks that the source is not already tapped.  If untapped, taps it\n133\t    (sets ``source.is_tapped = True``) and returns ``True``.  If already\n134\t    tapped, returns ``False`` (cost cannot be paid).\n135\t\n136\t    Parameters:\n137\t        game: The current game state (unused here but kept for a\n138\t            consistent ``(game, source) -> bool`` cost signature).\n139\t        source: The permanent to tap.\n140\t\n141\t    Returns:\n142\t        ``True`` if the cost was successfully paid (source was untapped\n143\t        and is now tapped), ``False`` otherwise.\n144\t    \"\"\"\n145\t    if getattr(source, \"is_tapped\", False):\n146\t        return False\n147\t    source.is_tapped = True\n148\t    return True\n149\t\n150\t\n151\t# ---------------------------------------------------------------------------\n152\t# Activate ability — main entry point\n153\t# ---------------------------------------------------------------------------\n154\t\n155\tdef activate_ability(\n156\t    game: GameState,\n157\t    player: Any,  # Player\n158\t    ability: ActivatedAbilityInstance | LoyaltyAbilityInstance,\n159\t) -> None:\n160\t    \"\"\"Activate an ability.\n161\t\n162\t    Pipeline\n163\t    --------\n164\t    1. **Timing check** — mana abilities bypass timing entirely and\n165\t       resolve immediately.  Regular (non-mana) activated abilities\n166\t       can be activated whenever a player has priority (instant speed);\n167\t       priority enforcement is handled externally by\n168\t       ``priority_loop``, not here.  **Only loyalty abilities** carry\n169\t       a sorcery-speed restriction.\n170\t    2. **Pay costs** — invoke the ability's cost callable.  For loyalty\n171\t       abilities, adjust loyalty counters and enforce once-per-turn.\n172\t    3. **Resolve or push to stack** — mana abilities resolve\n173\t       immediately; all other abilities are pushed onto the game stack\n174\t       as :class:`StackObject` instances.\n175\t\n176\t    Parameters:\n177\t        game: The current game state.\n178\t        player: The player activating the ability.\n179\t        ability: The ability to activate (an\n180\t            :class:`ActivatedAbilityInstance` or\n181\t            :class:`LoyaltyAbilityInstance`).\n182\t\n183\t    Raises:\n184\t        AbilityError: If the activation is illegal (timing, cost, or\n185\t            once-per-turn restriction).\n186\t    \"\"\"\n187\t    if isinstance(ability, LoyaltyAbilityInstance):\n188\t        _activate_loyalty_ability(game, player, ability)\n189\t    elif isinstance(ability, ActivatedAbilityInstance):\n190\t        _activate_regular_ability(game, player, ability)\n191\t    else:\n192\t        raise AbilityError(f\"Unknown ability type: {type(ability)}\")\n193\t\n194\t\n195\t# ---------------------------------------------------------------------------\n196\t# Internal helpers\n197\t# ---------------------------------------------------------------------------\n198\t\n199\tdef _activate_regular_ability(\n200\t    game: GameState,\n201\t    player: Any,\n202\t    ability: ActivatedAbilityInstance,\n203\t) -> None:\n204\t    \"\"\"Activate a regular (non-loyalty) activated ability.\"\"\"\n205\t    # 1. Check \"can't activate\" restriction (e.g. Arrest).\n206\t    if getattr(ability.source, \"_cant_activate\", False):\n207\t        raise AbilityError(\n208\t            \"Cannot activate ability — source's activated abilities are suppressed\"\n209\t        )\n210\t\n211\t    # 2. Pay costs\n212\t    cost_paid = ability.cost(game, ability.source)\n213\t    if not cost_paid:\n214\t        raise AbilityError(\"Cannot activate ability — cost could not be paid\")\n215\t\n216\t    # 3. Resolve or push\n217\t    if ability.is_mana_ability:\n218\t        # Mana abilities resolve immediately without using the stack.\n219\t        ability.effect(game)\n220\t    else:\n221\t        # Push to stack for resolution.\n222\t        stack_obj = StackObject(\n223\t            source=ability.source,\n224\t            controller=player,\n225\t            on_resolve=ability.effect,\n226\t            is_mana_ability=False,\n227\t        )\n228\t        game.stack.push(stack_obj)\n229\t\n230\t\n231\tdef _activate_loyalty_ability(\n232\t    game: GameState,\n233\t    player: Any,\n234\t    ability: LoyaltyAbilityInstance,\n235\t) -> None:\n236\t    \"\"\"Activate a planeswalker loyalty ability.\"\"\"\n237\t    source = ability.source\n238\t\n239\t    # 1. Timing — loyalty abilities are sorcery speed only.\n240\t    if not is_sorcery_speed(game, player):\n241\t        raise AbilityError(\n242\t            \"Cannot activate loyalty ability — sorcery-speed timing not met\"\n243\t        )\n244\t\n245\t    # 2. Once-per-turn restriction.\n246\t    turn_number = getattr(game, \"turn_number\", 0)\n247\t    if _has_activated_loyalty_this_turn(source, turn_number):\n248\t        raise AbilityError(\n249\t            \"Cannot activate loyalty ability — already activated this turn\"\n250\t        )\n251\t\n252\t    # 3. Pay loyalty cost.\n253\t    current_loyalty = getattr(source, \"loyalty\", 0)\n254\t    new_loyalty = current_loyalty + ability.loyalty_cost\n255\t    if new_loyalty < 0:\n256\t        raise AbilityError(\n257\t            f\"Cannot activate loyalty ability — insufficient loyalty \"\n258\t            f\"(have {current_loyalty}, need {-ability.loyalty_cost})\"\n259\t        )\n260\t    source.loyalty = new_loyalty\n261\t\n262\t    # 4. Mark as activated this turn.\n263\t    _mark_loyalty_activated(source, turn_number)\n264\t\n265\t    # 5. Push to stack.\n266\t    stack_obj = StackObject(\n267\t        source=source,\n268\t        controller=player,\n269\t        on_resolve=ability.effect,\n270\t        is_mana_ability=False,\n271\t    )\n272\t    game.stack.push(stack_obj)\n273\t"}]},"parent_tool_use_id":null,"session_id":"61a2af5c-d600-4497-9e1f-4081c4861a6a","uuid":"f9b2c53f-d69f-41a9-baaf-ad0b38bcd285","timestamp":"2026-06-10T17:20:37.373Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/abilities.py","content":"\"\"\"Activated abilities system — tap-for-mana, loyalty abilities, and general\nactivated abilities that go on the stack (or resolve immediately for mana\nabilities).\n\nProvides:\n\n- :func:`activate_ability` — verify timing → pay costs → resolve immediately\n  (mana abilities) or push to the stack (non-mana abilities).\n- :func:`tap_cost` — generic tap-cost helper: checks ``not source.is_tapped``\n  and taps the source.\n- :class:`ActivatedAbilityInstance` — a runtime representation of an activated\n  ability with source, controller, cost/effect callables, and metadata.\n- :class:`LoyaltyAbilityInstance` — activated ability variant for planeswalker\n  loyalty abilities with per-turn restriction and loyalty-counter cost.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom typing import TYPE_CHECKING, Any, Callable\n\nfrom engine.casting import is_sorcery_speed\nfrom engine.stack import StackObject\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\nclass AbilityError(Exception):\n    \"\"\"Raised when an ability activation is illegal.\"\"\"\n\n\n# ---------------------------------------------------------------------------\n# Runtime ability representations\n# ---------------------------------------------------------------------------\n\n@dataclass\nclass ActivatedAbilityInstance:\n    \"\"\"Runtime representation of an activated ability.\n\n    This captures everything needed to activate and resolve an ability:\n    the source permanent, the controlling player, cost/effect callables,\n    and whether the ability is a mana ability.\n\n    Attributes:\n        source: The permanent that has this ability.\n        controller: The player who controls the source.\n        cost: A callable ``(game, source) -> bool`` that checks and pays\n            the cost. Returns ``True`` if the cost was successfully paid,\n            ``False`` otherwise.\n        effect: A callable ``(game) -> None`` that applies the ability's\n            effect when it resolves.\n        is_mana_ability: Whether this is a mana ability (resolves\n            immediately without using the stack).\n        description: Human-readable description of the ability.\n    \"\"\"\n\n    source: Any\n    controller: Any  # Player\n    cost: Callable[..., bool]\n    effect: Callable[..., None]\n    is_mana_ability: bool = False\n    description: str = \"\"\n\n\n@dataclass\nclass LoyaltyAbilityInstance:\n    \"\"\"Runtime representation of a planeswalker loyalty ability.\n\n    Loyalty abilities are activated abilities with special restrictions:\n    they may only be activated at sorcery speed, and only once per turn\n    per source (tracked via ``_activated_this_turn``).\n\n    The cost adjusts the loyalty counters on the source planeswalker.\n\n    Attributes:\n        source: The planeswalker permanent.\n        controller: The player who controls the planeswalker.\n        loyalty_cost: The loyalty adjustment (positive for ``+N``,\n            negative for ``−N``, zero for ``0``).\n        effect: A callable ``(game) -> None`` for the ability's effect.\n        description: Human-readable description.\n    \"\"\"\n\n    source: Any\n    controller: Any  # Player\n    loyalty_cost: int = 0\n    effect: Callable[..., None] = field(default=lambda _game: None)\n    description: str = \"\"\n\n\n# ---------------------------------------------------------------------------\n# Per-turn loyalty tracking\n# ---------------------------------------------------------------------------\n\n# Set of (object_id, turn_number) pairs that have already activated a\n# loyalty ability this turn.  Callers should call\n# ``clear_loyalty_tracking()`` at the start of each turn or manage the\n# set externally.\n_loyalty_activated_this_turn: set[tuple[int, int]] = set()\n\n\ndef clear_loyalty_tracking() -> None:\n    \"\"\"Clear the loyalty-activated-this-turn tracker.\n\n    Should be called at the start of each turn so that planeswalkers may\n    activate loyalty abilities again.\n    \"\"\"\n    _loyalty_activated_this_turn.clear()\n\n\ndef _has_activated_loyalty_this_turn(source: Any, turn_number: int) -> bool:\n    \"\"\"Return ``True`` if *source* already used a loyalty ability this turn.\"\"\"\n    obj_id = getattr(source, \"object_id\", id(source))\n    return (obj_id, turn_number) in _loyalty_activated_this_turn\n\n\ndef _mark_loyalty_activated(source: Any, turn_number: int) -> None:\n    \"\"\"Record that *source* used a loyalty ability this turn.\"\"\"\n    obj_id = getattr(source, \"object_id\", id(source))\n    _loyalty_activated_this_turn.add((obj_id, turn_number))\n\n\n# ---------------------------------------------------------------------------\n# Tap cost helper\n# ---------------------------------------------------------------------------\n\ndef tap_cost(game: GameState, source: Any) -> bool:\n    \"\"\"Generic tap-cost function.\n\n    Checks that the source is not already tapped.  If untapped, taps it\n    (sets ``source.is_tapped = True``) and returns ``True``.  If already\n    tapped, returns ``False`` (cost cannot be paid).\n\n    Parameters:\n        game: The current game state (unused here but kept for a\n            consistent ``(game, source) -> bool`` cost signature).\n        source: The permanent to tap.\n\n    Returns:\n        ``True`` if the cost was successfully paid (source was untapped\n        and is now tapped), ``False`` otherwise.\n    \"\"\"\n    if getattr(source, \"is_tapped\", False):\n        return False\n    source.is_tapped = True\n    return True\n\n\n# ---------------------------------------------------------------------------\n# Activate ability — main entry point\n# ---------------------------------------------------------------------------\n\ndef activate_ability(\n    game: GameState,\n    player: Any,  # Player\n    ability: ActivatedAbilityInstance | LoyaltyAbilityInstance,\n) -> None:\n    \"\"\"Activate an ability.\n\n    Pipeline\n    --------\n    1. **Timing check** — mana abilities bypass timing entirely and\n       resolve immediately.  Regular (non-mana) activated abilities\n       can be activated whenever a player has priority (instant speed);\n       priority enforcement is handled externally by\n       ``priority_loop``, not here.  **Only loyalty abilities** carry\n       a sorcery-speed restriction.\n    2. **Pay costs** — invoke the ability's cost callable.  For loyalty\n       abilities, adjust loyalty counters and enforce once-per-turn.\n    3. **Resolve or push to stack** — mana abilities resolve\n       immediately; all other abilities are pushed onto the game stack\n       as :class:`StackObject` instances.\n\n    Parameters:\n        game: The current game state.\n        player: The player activating the ability.\n        ability: The ability to activate (an\n            :class:`ActivatedAbilityInstance` or\n            :class:`LoyaltyAbilityInstance`).\n\n    Raises:\n        AbilityError: If the activation is illegal (timing, cost, or\n            once-per-turn restriction).\n    \"\"\"\n    if isinstance(ability, LoyaltyAbilityInstance):\n        _activate_loyalty_ability(game, player, ability)\n    elif isinstance(ability, ActivatedAbilityInstance):\n        _activate_regular_ability(game, player, ability)\n    else:\n        raise AbilityError(f\"Unknown ability type: {type(ability)}\")\n\n\n# ---------------------------------------------------------------------------\n# Internal helpers\n# ---------------------------------------------------------------------------\n\ndef _activate_regular_ability(\n    game: GameState,\n    player: Any,\n    ability: ActivatedAbilityInstance,\n) -> None:\n    \"\"\"Activate a regular (non-loyalty) activated ability.\"\"\"\n    # 1. Check \"can't activate\" restriction (e.g. Arrest).\n    if getattr(ability.source, \"_cant_activate\", False):\n        raise AbilityError(\n            \"Cannot activate ability — source's activated abilities are suppressed\"\n        )\n\n    # 2. Pay costs\n    cost_paid = ability.cost(game, ability.source)\n    if not cost_paid:\n        raise AbilityError(\"Cannot activate ability — cost could not be paid\")\n\n    # 3. Resolve or push\n    if ability.is_mana_ability:\n        # Mana abilities resolve immediately without using the stack.\n        ability.effect(game)\n    else:\n        # Push to stack for resolution.\n        stack_obj = StackObject(\n            source=ability.source,\n            controller=player,\n            on_resolve=ability.effect,\n            is_mana_ability=False,\n        )\n        game.stack.push(stack_obj)\n\n\ndef _activate_loyalty_ability(\n    game: GameState,\n    player: Any,\n    ability: LoyaltyAbilityInstance,\n) -> None:\n    \"\"\"Activate a planeswalker loyalty ability.\"\"\"\n    source = ability.source\n\n    # 1. Timing — loyalty abilities are sorcery speed only.\n    if not is_sorcery_speed(game, player):\n        raise AbilityError(\n            \"Cannot activate loyalty ability — sorcery-speed timing not met\"\n        )\n\n    # 2. Once-per-turn restriction.\n    turn_number = getattr(game, \"turn_number\", 0)\n    if _has_activated_loyalty_this_turn(source, turn_number):\n        raise AbilityError(\n            \"Cannot activate loyalty ability — already activated this turn\"\n        )\n\n    # 3. Pay loyalty cost.\n    current_loyalty = getattr(source, \"loyalty\", 0)\n    new_loyalty = current_loyalty + ability.loyalty_cost\n    if new_loyalty < 0:\n        raise AbilityError(\n            f\"Cannot activate loyalty ability — insufficient loyalty \"\n            f\"(have {current_loyalty}, need {-ability.loyalty_cost})\"\n        )\n    source.loyalty = new_loyalty\n\n    # 4. Mark as activated this turn.\n    _mark_loyalty_activated(source, turn_number)\n\n    # 5. Push to stack.\n    stack_obj = StackObject(\n        source=source,\n        controller=player,\n        on_resolve=ability.effect,\n        is_mana_ability=False,\n    )\n    game.stack.push(stack_obj)\n","numLines":273,"startLine":1,"totalLines":273}}}
{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_018xJ7suiFxZso7b7KGQGm2j","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01FiRDDVLdsrx7GuNdvHyDVW","name":"Read","input":{"file_path":"/workspace/engine/zones.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1936,"cache_read_input_tokens":84885,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1936},"output_tokens":9,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"61a2af5c-d600-4497-9e1f-4081c4861a6a","uuid":"688ab47b-50e3-46a2-bfc4-9232494a7b69","request_id":"req_011CbuxpmiUPbeUBxg65DYEf"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FiRDDVLdsrx7GuNdvHyDVW","type":"tool_result","content":"1\t\"\"\"Zone containers for managing game objects across game zones.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport random\n6\tfrom typing import TYPE_CHECKING, Any\n7\t\n8\tfrom engine.types import CardType, Zone\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t\n13\t\n14\tclass IllegalMoveError(Exception):\n15\t    \"\"\"Raised when a zone move is illegal (e.g. object not found in source zone).\"\"\"\n16\t\n17\t\n18\tclass ZoneContainer:\n19\t    \"\"\"Wraps an ordered list of game-object references for a single zone.\n20\t\n21\t    Internal list convention: index 0 is the *bottom*, index -1 is the *top*.\n22\t    This matches the intuitive model where ``add(obj, position=\"top\")``\n23\t    appends, and ``top(n)`` returns the last *n* items.\n24\t    \"\"\"\n25\t\n26\t    def __init__(self) -> None:\n27\t        self._objects: list[Any] = []\n28\t\n29\t    # ------------------------------------------------------------------\n30\t    # Mutators\n31\t    # ------------------------------------------------------------------\n32\t\n33\t    def add(self, obj: Any, position: str = \"top\") -> None:\n34\t        \"\"\"Add *obj* to this zone.\n35\t\n36\t        Parameters:\n37\t            obj: The game object to add.\n38\t            position: ``\"top\"`` (default) appends to the end of the internal\n39\t                list; ``\"bottom\"`` inserts at position 0.\n40\t        \"\"\"\n41\t        if position == \"top\":\n42\t            self._objects.append(obj)\n43\t        elif position == \"bottom\":\n44\t            self._objects.insert(0, obj)\n45\t        else:\n46\t            raise ValueError(f\"Invalid position: {position!r}; expected 'top' or 'bottom'\")\n47\t\n48\t    def remove(self, obj: Any) -> None:\n49\t        \"\"\"Remove *obj* from this zone (identity-based lookup).\n50\t\n51\t        Raises:\n52\t            ValueError: If *obj* is not in the zone.\n53\t        \"\"\"\n54\t        for i, item in enumerate(self._objects):\n55\t            if item is obj:\n56\t                del self._objects[i]\n57\t                return\n58\t        raise ValueError(f\"{obj!r} not in zone\")\n59\t\n60\t    def shuffle(self) -> None:\n61\t        \"\"\"Randomly shuffle the contents of this zone (used for libraries).\"\"\"\n62\t        random.shuffle(self._objects)\n63\t\n64\t    # ------------------------------------------------------------------\n65\t    # Queries\n66\t    # ------------------------------------------------------------------\n67\t\n68\t    def contains(self, obj: Any) -> bool:\n69\t        \"\"\"Return ``True`` if *obj* is in this zone (identity-based lookup).\"\"\"\n70\t        return any(item is obj for item in self._objects)\n71\t\n72\t    def get_all(self) -> list[Any]:\n73\t        \"\"\"Return a shallow copy of all objects in order (bottom → top).\"\"\"\n74\t        return list(self._objects)\n75\t\n76\t    def top(self, n: int) -> list[Any]:\n77\t        \"\"\"Return the top *n* items (last *n* in the internal list).\n78\t\n79\t        If *n* >= len, returns all items.  Order is bottom-to-top (same\n80\t        orientation as the internal list).\n81\t        \"\"\"\n82\t        if n <= 0:\n83\t            return []\n84\t        return self._objects[-n:]\n85\t\n86\t    def bottom(self, n: int) -> list[Any]:\n87\t        \"\"\"Return the bottom *n* items (first *n* in the internal list).\n88\t\n89\t        If *n* >= len, returns all items.\n90\t        \"\"\"\n91\t        if n <= 0:\n92\t            return []\n93\t        return self._objects[:n]\n94\t\n95\t    def __len__(self) -> int:\n96\t        return len(self._objects)\n97\t\n98\t    def __repr__(self) -> str:\n99\t        return f\"ZoneContainer({self._objects!r})\"\n100\t\n101\t\n102\tclass Zones:\n103\t    \"\"\"Per-player collection mapping each :class:`Zone` to a :class:`ZoneContainer`.\"\"\"\n104\t\n105\t    def __init__(self, zones: dict[Zone, ZoneContainer]) -> None:\n106\t        self._zones = zones\n107\t\n108\t    @classmethod\n109\t    def new_player(cls) -> Zones:\n110\t        \"\"\"Create a fresh set of empty zones for a player.\"\"\"\n111\t        return cls({zone: ZoneContainer() for zone in Zone})\n112\t\n113\t    def __getitem__(self, zone: Zone) -> ZoneContainer:\n114\t        return self._zones[zone]\n115\t\n116\t    def __contains__(self, zone: Zone) -> bool:\n117\t        return zone in self._zones\n118\t\n119\t    def __repr__(self) -> str:\n120\t        return f\"Zones({self._zones!r})\"\n121\t\n122\t\n123\tdef move_zone(\n124\t    obj: Any,\n125\t    from_zone: ZoneContainer,\n126\t    to_zone: ZoneContainer,\n127\t    position: str = \"top\",\n128\t) -> None:\n129\t    \"\"\"Move *obj* from *from_zone* to *to_zone*.\n130\t\n131\t    Parameters:\n132\t        obj: The game object to move.\n133\t        from_zone: Source :class:`ZoneContainer`.\n134\t        to_zone: Destination :class:`ZoneContainer`.\n135\t        position: ``\"top\"`` (default), ``\"bottom\"``, or ``\"shuffle\"``\n136\t            (add then shuffle the destination).\n137\t\n138\t    Raises:\n139\t        IllegalMoveError: If *obj* is not in *from_zone*.\n140\t    \"\"\"\n141\t    # Moving an object to the same zone it's already in is a no-op.\n142\t    if from_zone is to_zone:\n143\t        return\n144\t\n145\t    if not from_zone.contains(obj):\n146\t        raise IllegalMoveError(\n147\t            f\"Object {obj!r} not found in source zone\"\n148\t        )\n149\t\n150\t    # Validate position *before* mutating either zone so that an invalid\n151\t    # position does not leave the object removed from the source without\n152\t    # being added to the destination.\n153\t    if position not in (\"top\", \"bottom\", \"shuffle\"):\n154\t        raise ValueError(f\"Invalid position: {position!r}; expected 'top', 'bottom', or 'shuffle'\")\n155\t\n156\t    from_zone.remove(obj)\n157\t\n158\t    # Clear transient casting metadata when a card changes zones so that\n159\t    # stale data (e.g. colors_spent from a previous cast) does not leak.\n160\t    if hasattr(obj, \"colors_spent\"):\n161\t        del obj.colors_spent\n162\t\n163\t    if position == \"shuffle\":\n164\t        to_zone.add(obj, position=\"top\")\n165\t        to_zone.shuffle()\n166\t    else:\n167\t        to_zone.add(obj, position=position)\n168\t\n169\t\n170\t# Mapping from replacement-effect destination strings to Zone enum values.\n171\t_DESTINATION_ZONE_MAP: dict[str, Zone] = {\n172\t    \"graveyard\": Zone.GRAVEYARD,\n173\t    \"exile\": Zone.EXILE,\n174\t    \"hand\": Zone.HAND,\n175\t    \"library\": Zone.LIBRARY,\n176\t}\n177\t\n178\t\n179\tdef move_to_zone(\n180\t    game: GameState,\n181\t    card: Any,\n182\t    from_zone: Zone,\n183\t    to_zone: Zone,\n184\t    *,\n185\t    replacement_event: Any | None = None,\n186\t) -> None:\n187\t    \"\"\"High-level zone transition with trigger/replacement-effect hooks.\n188\t\n189\t    Centralises the bookkeeping that was previously duplicated across\n190\t    ``destroy()``, ``sacrifice()``, ``exile()``, ``create_token()``,\n191\t    ``_move_to_graveyard()`` (SBAs), and ``_resolve_spell()`` (casting).\n192\t\n193\t    Steps:\n194\t    1. Consult replacement effects for zone-change redirection (if\n195\t       *replacement_event* is supplied and the card is leaving the\n196\t       battlefield).  The replacement may change the destination zone\n197\t       (e.g. exile instead of graveyard) or set ``prevented = True`` to\n198\t       signal that it handled the zone move directly.\n199\t    2. Remove *card* from the source zone.\n200\t    3. Add *card* to the (possibly redirected) destination zone.\n201\t    4. If leaving the battlefield:\n202\t       a. Fire ``LeavesBattlefieldTriggeredEvent``.\n203\t       b. Fire ``CreatureDiesTriggeredEvent`` if the card is a creature\n204\t          **and** the final destination is the graveyard.\n205\t       c. Unregister triggers and replacement effects (fires happen\n206\t          **before** unregister so self-referencing triggers still match).\n207\t    5. If entering the battlefield:\n208\t       a. Register triggers (``register_triggers``) and replacement\n209\t          effects (``register_replacement_effects``).\n210\t       b. Fire ``EntersBattlefieldTriggeredEvent``.\n211\t\n212\t    Parameters:\n213\t        game: The current game state.\n214\t        card: The game object being moved.\n215\t        from_zone: The :class:`Zone` the card is currently in.\n216\t        to_zone: The intended destination :class:`Zone`.\n217\t        replacement_event: Optional typed replacement-event object\n218\t            (e.g. ``CreatureDiesReplacementEvent``).  When ``None``,\n219\t            no replacement effects are consulted (useful for simple\n220\t            moves like casting resolution or exile-from-graveyard).\n221\t    \"\"\"\n222\t    from engine.events import (\n223\t        CreatureDiesTriggeredEvent,\n224\t        EntersBattlefieldTriggeredEvent,\n225\t        LeavesBattlefieldTriggeredEvent,\n226\t    )\n227\t\n228\t    controller = getattr(card, \"controller\", None)\n229\t    owner = getattr(card, \"owner\", controller)\n230\t\n231\t    leaving_battlefield = from_zone == Zone.BATTLEFIELD\n232\t    entering_battlefield = to_zone == Zone.BATTLEFIELD\n233\t\n234\t    # --- Determine the source player for zone lookup ---\n235\t    # When leaving the battlefield, use the controller's zone.\n236\t    # For other zones (hand, graveyard, etc.), use the owner's zone.\n237\t    if leaving_battlefield:\n238\t        source_player = controller\n239\t    else:\n240\t        source_player = owner\n241\t\n242\t    # Fallback: search all players for the zone containing the card.\n243\t    # Also triggered when the inferred player's zone doesn't contain the card\n244\t    # (e.g. discarding a card that's in a different player's hand than its owner).\n245\t    if source_player is None or not source_player.zones[from_zone].contains(card):\n246\t        for player in game.players:\n247\t            if player.zones[from_zone].contains(card):\n248\t                source_player = player\n249\t                break\n250\t\n251\t    if source_player is None:\n252\t        return  # Card not found anywhere\n253\t\n254\t    source_container = source_player.zones[from_zone]\n255\t    if not source_container.contains(card):\n256\t        return  # Safety: card not in any player's zone\n257\t\n258\t    if owner is None:\n259\t        owner = source_player\n260\t\n261\t    # --- Replacement effects (zone-change redirection) ---\n262\t    dest_zone = to_zone\n263\t    if replacement_event is not None and leaving_battlefield:\n264\t        replacement_event = game.replacement_manager.apply(game, replacement_event)\n265\t        if getattr(replacement_event, \"prevented\", False):\n266\t            return\n267\t        destination_str = getattr(replacement_event, \"destination\", \"graveyard\")\n268\t        dest_zone = _DESTINATION_ZONE_MAP.get(destination_str, to_zone)\n269\t\n270\t    # --- Perform the zone move ---\n271\t    source_container.remove(card)\n272\t\n273\t    # Determine the destination player (always the owner for graveyard/exile/hand/library).\n274\t    if entering_battlefield:\n275\t        dest_player = controller if controller is not None else owner\n276\t    else:\n277\t        dest_player = owner\n278\t\n279\t    dest_player.zones[dest_zone].add(card)\n280\t\n281\t    # --- Leaving battlefield hooks ---\n282\t    if leaving_battlefield:\n283\t        card_types = getattr(card, \"card_types\", set())\n284\t        is_creature = CardType.CREATURE in card_types\n285\t\n286\t        # Fire events BEFORE unregistering (KEY_DECISIONS convention).\n287\t        game.trigger_manager.fire_event(\n288\t            game,\n289\t            LeavesBattlefieldTriggeredEvent(permanent=card, controller=controller),\n290\t        )\n291\t        if is_creature and dest_zone == Zone.GRAVEYARD:\n292\t            game.trigger_manager.fire_event(\n293\t                game,\n294\t                CreatureDiesTriggeredEvent(creature=card, controller=controller, owner=owner),\n295\t            )\n296\t\n297\t        # Now unregister triggers and replacement effects.\n298\t        game.trigger_manager.unregister(card)\n299\t        game.replacement_manager.unregister(card)\n300\t\n301\t    # --- Entering battlefield hooks ---\n302\t    if entering_battlefield:\n303\t        # Fire the ENTERS_BATTLEFIELD event *before* registering the card's\n304\t        # own triggers so that a permanent's ETB trigger does not\n305\t        # retroactively trigger off its own entry.  Other already-registered\n306\t        # triggers that watch for ENTERS_BATTLEFIELD will still fire.\n307\t        game.trigger_manager.fire_event(\n308\t            game,\n309\t            EntersBattlefieldTriggeredEvent(\n310\t                permanent=card,\n311\t                controller=controller if controller is not None else owner,\n312\t            ),\n313\t        )\n314\t        if hasattr(card, \"register_triggers\"):\n315\t            card.register_triggers(game)\n316\t        if hasattr(card, \"register_replacement_effects\"):\n317\t            card.register_replacement_effects(game)\n318\t\n319\t\n320\t# Destination string → Zone for replacement-effect zone redirection.\n321\t_DESTINATION_ZONE_MAP: dict[str, Zone] = {\n322\t    \"graveyard\": Zone.GRAVEYARD,\n323\t    \"exile\": Zone.EXILE,\n324\t    \"hand\": Zone.HAND,\n325\t    \"library\": Zone.LIBRARY,\n326\t}\n327\t"}]},"parent_tool_use_id":null,"session_id":"61a2af5c-d600-4497-9e1f-4081c4861a6a","uuid":"c70c85bb-28eb-4372-9212-93eba91c6366","timestamp":"2026-06-10T17:20:37.466Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/zones.py","content":"\"\"\"Zone containers for managing game objects across game zones.\"\"\"\n\nfrom __future__ import annotations\n\nimport random\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.types import CardType, Zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\nclass IllegalMoveError(Exception):\n    \"\"\"Raised when a zone move is illegal (e.g. object not found in source zone).\"\"\"\n\n\nclass ZoneContainer:\n    \"\"\"Wraps an ordered list of game-object references for a single zone.\n\n    Internal list convention: index 0 is the *bottom*, index -1 is the *top*.\n    This matches the intuitive model where ``add(obj, position=\"top\")``\n    appends, and ``top(n)`` returns the last *n* items.\n    \"\"\"\n\n    def __init__(self) -> None:\n        self._objects: list[Any] = []\n\n    # ------------------------------------------------------------------\n    # Mutators\n    # ------------------------------------------------------------------\n\n    def add(self, obj: Any, position: str = \"top\") -> None:\n        \"\"\"Add *obj* to this zone.\n\n        Parameters:\n            obj: The game object to add.\n            position: ``\"top\"`` (default) appends to the end of the internal\n                list; ``\"bottom\"`` inserts at position 0.\n        \"\"\"\n        if position == \"top\":\n            self._objects.append(obj)\n        elif position == \"bottom\":\n            self._objects.insert(0, obj)\n        else:\n            raise ValueError(f\"Invalid position: {position!r}; expected 'top' or 'bottom'\")\n\n    def remove(self, obj: Any) -> None:\n        \"\"\"Remove *obj* from this zone (identity-based lookup).\n\n        Raises:\n            ValueError: If *obj* is not in the zone.\n        \"\"\"\n        for i, item in enumerate(self._objects):\n            if item is obj:\n                del self._objects[i]\n                return\n        raise ValueError(f\"{obj!r} not in zone\")\n\n    def shuffle(self) -> None:\n        \"\"\"Randomly shuffle the contents of this zone (used for libraries).\"\"\"\n        random.shuffle(self._objects)\n\n    # ------------------------------------------------------------------\n    # Queries\n    # ------------------------------------------------------------------\n\n    def contains(self, obj: Any) -> bool:\n        \"\"\"Return ``True`` if *obj* is in this zone (identity-based lookup).\"\"\"\n        return any(item is obj for item in self._objects)\n\n    def get_all(self) -> list[Any]:\n        \"\"\"Return a shallow copy of all objects in order (bottom → top).\"\"\"\n        return list(self._objects)\n\n    def top(self, n: int) -> list[Any]:\n        \"\"\"Return the top *n* items (last *n* in the internal list).\n\n        If *n* >= len, returns all items.  Order is bottom-to-top (same\n        orientation as the internal list).\n        \"\"\"\n        if n <= 0:\n            return []\n        return self._objects[-n:]\n\n    def bottom(self, n: int) -> list[Any]:\n        \"\"\"Return the bottom *n* items (first *n* in the internal list).\n\n        If *n* >= len, returns all items.\n        \"\"\"\n        if n <= 0:\n            return []\n        return self._objects[:n]\n\n    def __len__(self) -> int:\n        return len(self._objects)\n\n    def __repr__(self) -> str:\n        return f\"ZoneContainer({self._objects!r})\"\n\n\nclass Zones:\n    \"\"\"Per-player collection mapping each :class:`Zone` to a :class:`ZoneContainer`.\"\"\"\n\n    def __init__(self, zones: dict[Zone, ZoneContainer]) -> None:\n        self._zones = zones\n\n    @classmethod\n    def new_player(cls) -> Zones:\n        \"\"\"Create a fresh set of empty zones for a player.\"\"\"\n        return cls({zone: ZoneContainer() for zone in Zone})\n\n    def __getitem__(self, zone: Zone) -> ZoneContainer:\n        return self._zones[zone]\n\n    def __contains__(self, zone: Zone) -> bool:\n        return zone in self._zones\n\n    def __repr__(self) -> str:\n        return f\"Zones({self._zones!r})\"\n\n\ndef move_zone(\n    obj: Any,\n    from_zone: ZoneContainer,\n    to_zone: ZoneContainer,\n    position: str = \"top\",\n) -> None:\n    \"\"\"Move *obj* from *from_zone* to *to_zone*.\n\n    Parameters:\n        obj: The game object to move.\n        from_zone: Source :class:`ZoneContainer`.\n        to_zone: Destination :class:`ZoneContainer`.\n        position: ``\"top\"`` (default), ``\"bottom\"``, or ``\"shuffle\"``\n            (add then shuffle the destination).\n\n    Raises:\n        IllegalMoveError: If *obj* is not in *from_zone*.\n    \"\"\"\n    # Moving an object to the same zone it's already in is a no-op.\n    if from_zone is to_zone:\n        return\n\n    if not from_zone.contains(obj):\n        raise IllegalMoveError(\n            f\"Object {obj!r} not found in source zone\"\n        )\n\n    # Validate position *before* mutating either zone so that an invalid\n    # position does not leave the object removed from the source without\n    # being added to the destination.\n    if position not in (\"top\", \"bottom\", \"shuffle\"):\n        raise ValueError(f\"Invalid position: {position!r}; expected 'top', 'bottom', or 'shuffle'\")\n\n    from_zone.remove(obj)\n\n    # Clear transient casting metadata when a card changes zones so that\n    # stale data (e.g. colors_spent from a previous cast) does not leak.\n    if hasattr(obj, \"colors_spent\"):\n        del obj.colors_spent\n\n    if position == \"shuffle\":\n        to_zone.add(obj, position=\"top\")\n        to_zone.shuffle()\n    else:\n        to_zone.add(obj, position=position)\n\n\n# Mapping from replacement-effect destination strings to Zone enum values.\n_DESTINATION_ZONE_MAP: dict[str, Zone] = {\n    \"graveyard\": Zone.GRAVEYARD,\n    \"exile\": Zone.EXILE,\n    \"hand\": Zone.HAND,\n    \"library\": Zone.LIBRARY,\n}\n\n\ndef move_to_zone(\n    game: GameState,\n    card: Any,\n    from_zone: Zone,\n    to_zone: Zone,\n    *,\n    replacement_event: Any | None = None,\n) -> None:\n    \"\"\"High-level zone transition with trigger/replacement-effect hooks.\n\n    Centralises the bookkeeping that was previously duplicated across\n    ``destroy()``, ``sacrifice()``, ``exile()``, ``create_token()``,\n    ``_move_to_graveyard()`` (SBAs), and ``_resolve_spell()`` (casting).\n\n    Steps:\n    1. Consult replacement effects for zone-change redirection (if\n       *replacement_event* is supplied and the card is leaving the\n       battlefield).  The replacement may change the destination zone\n       (e.g. exile instead of graveyard) or set ``prevented = True`` to\n       signal that it handled the zone move directly.\n    2. Remove *card* from the source zone.\n    3. Add *card* to the (possibly redirected) destination zone.\n    4. If leaving the battlefield:\n       a. Fire ``LeavesBattlefieldTriggeredEvent``.\n       b. Fire ``CreatureDiesTriggeredEvent`` if the card is a creature\n          **and** the final destination is the graveyard.\n       c. Unregister triggers and replacement effects (fires happen\n          **before** unregister so self-referencing triggers still match).\n    5. If entering the battlefield:\n       a. Register triggers (``register_triggers``) and replacement\n          effects (``register_replacement_effects``).\n       b. Fire ``EntersBattlefieldTriggeredEvent``.\n\n    Parameters:\n        game: The current game state.\n        card: The game object being moved.\n        from_zone: The :class:`Zone` the card is currently in.\n        to_zone: The intended destination :class:`Zone`.\n        replacement_event: Optional typed replacement-event object\n            (e.g. ``CreatureDiesReplacementEvent``).  When ``None``,\n            no replacement effects are consulted (useful for simple\n            moves like casting resolution or exile-from-graveyard).\n    \"\"\"\n    from engine.events import (\n        CreatureDiesTriggeredEvent,\n        EntersBattlefieldTriggeredEvent,\n        LeavesBattlefieldTriggeredEvent,\n    )\n\n    controller = getattr(card, \"controller\", None)\n    owner = getattr(card, \"owner\", controller)\n\n    leaving_battlefield = from_zone == Zone.BATTLEFIELD\n    entering_battlefield = to_zone == Zone.BATTLEFIELD\n\n    # --- Determine the source player for zone lookup ---\n    # When leaving the battlefield, use the controller's zone.\n    # For other zones (hand, graveyard, etc.), use the owner's zone.\n    if leaving_battlefield:\n        source_player = controller\n    else:\n        source_player = owner\n\n    # Fallback: search all players for the zone containing the card.\n    # Also triggered when the inferred player's zone doesn't contain the card\n    # (e.g. discarding a card that's in a different player's hand than its owner).\n    if source_player is None or not source_player.zones[from_zone].contains(card):\n        for player in game.players:\n            if player.zones[from_zone].contains(card):\n                source_player = player\n                break\n\n    if source_player is None:\n        return  # Card not found anywhere\n\n    source_container = source_player.zones[from_zone]\n    if not source_container.contains(card):\n        return  # Safety: card not in any player's zone\n\n    if owner is None:\n        owner = source_player\n\n    # --- Replacement effects (zone-change redirection) ---\n    dest_zone = to_zone\n    if replacement_event is not None and leaving_battlefield:\n        replacement_event = game.replacement_manager.apply(game, replacement_event)\n        if getattr(replacement_event, \"prevented\", False):\n            return\n        destination_str = getattr(replacement_event, \"destination\", \"graveyard\")\n        dest_zone = _DESTINATION_ZONE_MAP.get(destination_str, to_zone)\n\n    # --- Perform the zone move ---\n    source_container.remove(card)\n\n    # Determine the destination player (always the owner for graveyard/exile/hand/library).\n    if entering_battlefield:\n        dest_player = controller if controller is not None else owner\n    else:\n        dest_player = owner\n\n    dest_player.zones[dest_zone].add(card)\n\n    # --- Leaving battlefield hooks ---\n    if leaving_battlefield:\n        card_types = getattr(card, \"card_types\", set())\n        is_creature = CardType.CREATURE in card_types\n\n        # Fire events BEFORE unregistering (KEY_DECISIONS convention).\n        game.trigger_manager.fire_event(\n            game,\n            LeavesBattlefieldTriggeredEvent(permanent=card, controller=controller),\n        )\n        if is_creature and dest_zone == Zone.GRAVEYARD:\n            game.trigger_manager.fire_event(\n                game,\n                CreatureDiesTriggeredEvent(creature=card, controller=controller, owner=owner),\n            )\n\n        # Now unregister triggers and replacement effects.\n        game.trigger_manager.unregister(card)\n        game.replacement_manager.unregister(card)\n\n    # --- Entering battlefield hooks ---\n    if entering_battlefield:\n        # Fire the ENTERS_BATTLEFIELD event *before* registering the card's\n        # own triggers so that a permanent's ETB trigger does not\n        # retroactively trigger off its own entry.  Other already-registered\n        # triggers that watch for ENTERS_BATTLEFIELD will still fire.\n        game.trigger_manager.fire_event(\n            game,\n            EntersBattlefieldTriggeredEvent(\n                permanent=card,\n                controller=controller if controller is not None else owner,\n            ),\n        )\n        if hasattr(card, \"register_triggers\"):\n            card.register_triggers(game)\n        if hasattr(card, \"register_replacement_effects\"):\n            card.register_replacement_effects(game)\n\n\n# Destination string → Zone for replacement-effect zone redirection.\n_DESTINATION_ZONE_MAP: dict[str, Zone] = {\n    \"graveyard\": Zone.GRAVEYARD,\n    \"exile\": Zone.EXILE,\n    \"hand\": Zone.HAND,\n    \"library\": Zone.LIBRARY,\n}\n","numLines":327,"startLine":1,"totalLines":327}}}
