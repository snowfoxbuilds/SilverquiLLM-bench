ve_player","+        game.trigger_manager.register(","+            TriggerRegistration(","+                event_type=SpellCastTriggeredEvent,","+                condition=_pump_condition,","+                effect=_pump_effect,","+                source=self,","+                controller=controller,","+            )","+        )"]}],"originalFile":"\"\"\"Card implementation for Great Hall of the Biblioplex.\"\"\"\n\nfrom __future__ import annotations\n\nfrom engine.card import CardImpl\n\nfrom typing import TYPE_CHECKING\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\nclass GreatHallOfTheBiblioplex(CardImpl):\n    \"\"\"TODO: Implement Great Hall of the Biblioplex.\"\"\"\n\n    pass\n","userModified":false}}
