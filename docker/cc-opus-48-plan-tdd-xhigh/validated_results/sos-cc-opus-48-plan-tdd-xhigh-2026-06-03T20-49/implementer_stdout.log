{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UqYrsY4YyJmSJZYVgesNRN","type":"tool_result","content":"126\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n127\t    new_generic = max(0, cost.generic - reduction)\n128\t    return ManaCost(\n129\t        generic=new_generic,\n130\t        pips=dict(cost.pips),\n131\t        x_count=cost.x_count,\n132\t        hybrid=list(cost.hybrid),\n133\t    )\n134\t\n135\t\n136\t# ------------------------------------------------------------------\n137\t# Cast spell\n138\t# ------------------------------------------------------------------\n139\t\n140\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n141\t    \"\"\"Cast *card* from *player*'s hand.\n142\t\n143\t    Pipeline\n144\t    --------\n145\t    1. **Timing check** — instants (and cards with flash) can be cast\n146\t       whenever the player has priority; everything else requires\n147\t       sorcery-speed timing.\n148\t    2. **can_cast** — ask the card whether it can legally be cast.\n149\t    3. **Hand check** — the card must be in the player's hand.\n150\t    4. **Move hand → stack zone** — remove the card from the hand and\n151\t       place it into the player's stack zone.\n152\t    5. **Choose targets** — if the card specifies targets (via\n153\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n154\t    6. **Mana check / payment** — the player's mana pool must be able to\n155\t       pay the card's mana cost.  If payment fails, the card is rolled\n156\t       back from the stack zone to the hand.\n157\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n158\t    8. **Push StackObject** — push a :class:`StackObject` whose\n159\t       ``on_resolve`` callback handles resolution.\n160\t\n161\t    Raises:\n162\t        CastingError: If any legality check fails.\n163\t    \"\"\"\n164\t    # 1. Timing\n165\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n166\t        raise CastingError(\n167\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n168\t        )\n169\t\n170\t    # 2. can_cast\n171\t    if not card.can_cast(game):\n172\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n173\t\n174\t    # 3. Hand check\n175\t    hand = game.get_hand(player)\n176\t    if not hand.contains(card):\n177\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n178\t\n179\t    # 4. Move card from hand to stack zone\n180\t    stack_zone = player.zones[Zone.STACK]\n181\t    hand.remove(card)\n182\t    stack_zone.add(card)\n183\t\n184\t    # Clear any stale colors_spent from a prior cast before new payment.\n185\t    if hasattr(card, \"colors_spent\"):\n186\t        del card.colors_spent\n187\t\n188\t    # 5. Choose targets\n189\t    target_specs = card.get_targets(game)\n190\t    chosen_targets: list[Any] = []\n191\t    if target_specs:\n192\t        for spec in target_specs:\n193\t            target = player.choose_target(target_specs, spec)\n194\t            # Validate against filter_fn if the spec provides one\n195\t            filter_fn = getattr(spec, \"filter_fn\", None)\n196\t            if filter_fn is not None and target is not None:\n197\t                if not filter_fn(target):\n198\t                    stack_zone.remove(card)\n199\t                    hand.add(card)\n200\t                    raise CastingError("}]},"parent_tool_use_id":null,"session_id":"a8998a71-cb9f-462b-a621-0c4f4edc8cf2","uuid":"f271e360-9509-47af-8013-2fbc48592417","timestamp":"2026-06-03T21:19:14.984Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n    new_generic = max(0, cost.generic - reduction)\n    return ManaCost(\n        generic=new_generic,\n        pips=dict(cost.pips),\n        x_count=cost.x_count,\n        hybrid=list(cost.hybrid),\n    )\n\n\n# ------------------------------------------------------------------\n# Cast spell\n# ------------------------------------------------------------------\n\ndef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n    \"\"\"Cast *card* from *player*'s hand.\n\n    Pipeline\n    --------\n    1. **Timing check** — instants (and cards with flash) can be cast\n       whenever the player has priority; everything else requires\n       sorcery-speed timing.\n    2. **can_cast** — ask the card whether it can legally be cast.\n    3. **Hand check** — the card must be in the player's hand.\n    4. **Move hand → stack zone** — remove the card from the hand and\n       place it into the player's stack zone.\n    5. **Choose targets** — if the card specifies targets (via\n       :meth:`CardImpl.get_targets`), the player is asked to choose.\n    6. **Mana check / payment** — the player's mana pool must be able to\n       pay the card's mana cost.  If payment fails, the card is rolled\n       back from the stack zone to the hand.\n    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n    8. **Push StackObject** — push a :class:`StackObject` whose\n       ``on_resolve`` callback handles resolution.\n\n    Raises:\n        CastingError: If any legality check fails.\n    \"\"\"\n    # 1. Timing\n    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n        )\n\n    # 2. can_cast\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 3. Hand check\n    hand = game.get_hand(player)\n    if not hand.contains(card):\n        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n\n    # 4. Move card from hand to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    hand.remove(card)\n    stack_zone.add(card)\n\n    # Clear any stale colors_spent from a prior cast before new payment.\n    if hasattr(card, \"colors_spent\"):\n        del card.colors_spent\n\n    # 5. Choose targets\n    target_specs = card.get_targets(game)\n    chosen_targets: list[Any] = []\n    if target_specs:\n        for spec in target_specs:\n            target = player.choose_target(target_specs, spec)\n            # Validate against filter_fn if the spec provides one\n            filter_fn = getattr(spec, \"filter_fn\", None)\n            if filter_fn is not None and target is not None:\n                if not filter_fn(target):\n                    stack_zone.remove(card)\n                    hand.add(card)\n                    raise CastingError(","numLines":75,"startLine":126,"totalLines":526}}}
