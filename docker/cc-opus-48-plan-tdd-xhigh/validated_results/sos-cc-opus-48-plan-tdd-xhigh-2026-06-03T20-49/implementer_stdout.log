l,"session_id":"a8998a71-cb9f-462b-a621-0c4f4edc8cf2","uuid":"7a0cc6d0-86d7-47de-a6c5-f6fcafc753d0","timestamp":"2026-06-03T21:36:58.447Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/game.py","content":"    Fires :attr:`EventType.DRAWS_CARD` via the trigger manager.\n\n    Parameters:\n        game: The current game state.\n        player: The player drawing a card.\n\n    Returns:\n        The drawn card, or ``None`` if the library was empty.\n    \"\"\"\n    library = player.zones[Zone.LIBRARY]\n\n    if len(library) == 0:\n        player.drawn_from_empty_library = True\n        return None\n\n    # Top of library is the last element (index -1)\n    cards = library.top(1)\n    card = cards[0]\n    library.remove(card)\n\n    hand = player.zones[Zone.HAND]\n    hand.add(card)\n\n    # Track cards drawn this turn\n    if not hasattr(player, \"cards_drawn_this_turn\"):\n        player.cards_drawn_this_turn = 0\n    player.cards_drawn_this_turn += 1\n\n    # Fire trigger (only if game has a trigger_manager — may not during setup)\n    if hasattr(game, \"trigger_manager\"):\n        game.trigger_manager.fire_event(\n            game,\n            DrawsCardTriggeredEvent(player=player, card=card),\n        )\n\n    return card\n\n\ndef surveil(game: GameState, player: Player, n: int) -> None:\n    \"\"\"Surveil *n* — look at the top *n* cards of *player*'s library, then put\n    any number of them into the graveyard and leave the rest on top.\n\n    For each looked-at card (top first) the player chooses ``\"graveyard\"`` or\n    ``\"top\"`` via :meth:`Player.choose`; only ``\"graveyard\"`` moves the card.\n    Cards kept on top retain their relative order.\n    \"\"\"\n    if n <= 0:\n        return\n    library = player.zones[Zone.LIBRARY]\n    if len(library) == 0:","numLines":50,"startLine":300,"totalLines":562}}}
