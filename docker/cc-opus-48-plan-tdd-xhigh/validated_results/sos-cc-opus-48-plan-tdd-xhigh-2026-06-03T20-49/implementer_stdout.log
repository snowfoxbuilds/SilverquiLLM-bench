{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0188xbF4spVMCXWAWykqDorH","type":"tool_result","content":"1\t\"\"\"Tests for SOS 226 — Silverquill, the Disputant.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom cards.sos.sos_226.card_impl import SilverquillTheDisputant\n6\tfrom engine.card import Creature, Sorcery\n7\tfrom engine.types import Keyword, ManaCost, ManaType, Supertype, Zone\n8\tfrom test_utils import create_game, cast_spell, set_board_state\n9\t\n10\t\n11\tclass _Lifebloom(Sorcery):\n12\t    \"\"\"A no-target sorcery: gain 2 life on resolve.\"\"\"\n13\t\n14\t    def __init__(self, **kwargs):\n15\t        kwargs.setdefault(\"name\", \"Lifebloom\")\n16\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{W}\"))\n17\t        super().__init__(**kwargs)\n18\t\n19\t    def on_resolve(self, game):\n20\t        if self.controller is not None:\n21\t            self.controller.life += 2\n22\t\n23\t\n24\tdef _bear(name=\"Bear\"):\n25\t    return Creature(name=name, base_power=2, base_toughness=2)\n26\t\n27\t\n28\tdef _setup(control_silverquill=True, extra_bf=None):\n29\t    game = create_game()\n30\t    p0 = game.players[0]\n31\t    bf = []\n32\t    sq = None\n33\t    if control_silverquill:\n34\t        sq = SilverquillTheDisputant(owner=None)\n35\t        bf.append(sq)\n36\t    if extra_bf:\n37\t        bf.extend(extra_bf)\n38\t    set_board_state(game, 0, hand=[_Lifebloom(owner=None)], battlefield=bf,\n39\t                    mana={ManaType.WHITE: 1, ManaType.COLORLESS: 1}, life=20)\n40\t    if sq is not None:\n41\t        sq.register_triggers(game)\n42\t    return game, p0, sq\n43\t\n44\t\n45\tclass TestProperties:\n46\t    def test_is_creature(self):\n47\t        assert isinstance(SilverquillTheDisputant(owner=None), Creature)\n48\t\n49\t    def test_name(self):\n50\t        assert SilverquillTheDisputant(owner=None).name == \"Silverquill, the Disputant\"\n51\t\n52\t    def test_mana_cost(self):\n53\t        assert SilverquillTheDisputant(owner=None).mana_cost == ManaCost.parse(\"{2}{W}{B}\")\n54\t\n55\t    def test_power_toughness(self):\n56\t        c = SilverquillTheDisputant(owner=None)\n57\t        assert c.base_power == 4 and c.base_toughness == 4\n58\t\n59\t    def test_keywords(self):\n60\t        kw = SilverquillTheDisputant(owner=None).keywords\n61\t        assert Keyword.FLYING in kw and Keyword.VIGILANCE in kw\n62\t\n63\t    def test_legendary(self):\n64\t        assert Supertype.LEGENDARY in SilverquillTheDisputant(owner=None).supertypes\n65\t\n66\t\n67\tclass TestCasualty:\n68\t    def test_sacrifice_copies_spell(self):\n69\t        bear = _bear()\n70\t        game, p0, sq = _setup(extra_bf=[bear])\n71\t        p0._script.append(True)   # apply casualty?\n72\t        p0._script.append(bear)   # sacrifice the bear\n73\t        cast_spell(game, 0, \"Lifebloom\")\n74\t        # Original + copy both gained 2 life.\n75\t        assert p0.life == 24\n76\t        assert bear in p0.zones[Zone.GRAVEYARD].get_all()\n77\t\n78\t    def test_decline_casualty_no_copy(self):\n79\t        bear = _bear()\n80\t        game, p0, sq = _setup(extra_bf=[bear])\n81\t        p0._script.append(False)  # decline casualty\n82\t        cast_spell(game, 0, \"Lifebloom\")\n83\t        assert p0.life == 22  # only the original resolved\n84\t        assert bear not in p0.zones[Zone.GRAVEYARD].get_all()\n85\t\n86\t    def test_no_silverquill_no_casualty(self):\n87\t        bear = _bear()\n88\t        game, p0, sq = _setup(control_silverquill=False, extra_bf=[bear])\n89\t        cast_spell(game, 0, \"Lifebloom\")\n90\t        assert p0.life == 22\n91\t        assert bear not in p0.zones[Zone.GRAVEYARD].get_all()\n92\t"}]},"parent_tool_use_id":null,"session_id":"a8998a71-cb9f-462b-a621-0c4f4edc8cf2","uuid":"0ae08f1d-6fc8-446e-9ff1-f965ca57bb46","timestamp":"2026-06-03T21:37:39.567Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/sos/sos_226/tests.py","content":"\"\"\"Tests for SOS 226 — Silverquill, the Disputant.\"\"\"\n\nfrom __future__ import annotations\n\nfrom cards.sos.sos_226.card_impl import SilverquillTheDisputant\nfrom engine.card import Creature, Sorcery\nfrom engine.types import Keyword, ManaCost, ManaType, Supertype, Zone\nfrom test_utils import create_game, cast_spell, set_board_state\n\n\nclass _Lifebloom(Sorcery):\n    \"\"\"A no-target sorcery: gain 2 life on resolve.\"\"\"\n\n    def __init__(self, **kwargs):\n        kwargs.setdefault(\"name\", \"Lifebloom\")\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{W}\"))\n        super().__init__(**kwargs)\n\n    def on_resolve(self, game):\n        if self.controller is not None:\n            self.controller.life += 2\n\n\ndef _bear(name=\"Bear\"):\n    return Creature(name=name, base_power=2, base_toughness=2)\n\n\ndef _setup(control_silverquill=True, extra_bf=None):\n    game = create_game()\n    p0 = game.players[0]\n    bf = []\n    sq = None\n    if control_silverquill:\n        sq = SilverquillTheDisputant(owner=None)\n        bf.append(sq)\n    if extra_bf:\n        bf.extend(extra_bf)\n    set_board_state(game, 0, hand=[_Lifebloom(owner=None)], battlefield=bf,\n                    mana={ManaType.WHITE: 1, ManaType.COLORLESS: 1}, life=20)\n    if sq is not None:\n        sq.register_triggers(game)\n    return game, p0, sq\n\n\nclass TestProperties:\n    def test_is_creature(self):\n        assert isinstance(SilverquillTheDisputant(owner=None), Creature)\n\n    def test_name(self):\n        assert SilverquillTheDisputant(owner=None).name == \"Silverquill, the Disputant\"\n\n    def test_mana_cost(self):\n        assert SilverquillTheDisputant(owner=None).mana_cost == ManaCost.parse(\"{2}{W}{B}\")\n\n    def test_power_toughness(self):\n        c = SilverquillTheDisputant(owner=None)\n        assert c.base_power == 4 and c.base_toughness == 4\n\n    def test_keywords(self):\n        kw = SilverquillTheDisputant(owner=None).keywords\n        assert Keyword.FLYING in kw and Keyword.VIGILANCE in kw\n\n    def test_legendary(self):\n        assert Supertype.LEGENDARY in SilverquillTheDisputant(owner=None).supertypes\n\n\nclass TestCasualty:\n    def test_sacrifice_copies_spell(self):\n        bear = _bear()\n        game, p0, sq = _setup(extra_bf=[bear])\n        p0._script.append(True)   # apply casualty?\n        p0._script.append(bear)   # sacrifice the bear\n        cast_spell(game, 0, \"Lifebloom\")\n        # Original + copy both gained 2 life.\n        assert p0.life == 24\n        assert bear in p0.zones[Zone.GRAVEYARD].get_all()\n\n    def test_decline_casualty_no_copy(self):\n        bear = _bear()\n        game, p0, sq = _setup(extra_bf=[bear])\n        p0._script.append(False)  # decline casualty\n        cast_spell(game, 0, \"Lifebloom\")\n        assert p0.life == 22  # only the original resolved\n        assert bear not in p0.zones[Zone.GRAVEYARD].get_all()\n\n    def test_no_silverquill_no_casualty(self):\n        bear = _bear()\n        game, p0, sq = _setup(control_silverquill=False, extra_bf=[bear])\n        cast_spell(game, 0, \"Lifebloom\")\n        assert p0.life == 22\n        assert bear not in p0.zones[Zone.GRAVEYARD].get_all()\n","numLines":92,"startLine":1,"totalLines":92}}}
