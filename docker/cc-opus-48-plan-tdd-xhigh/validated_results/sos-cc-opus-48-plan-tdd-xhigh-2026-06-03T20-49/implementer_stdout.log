{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011ihjEnwG1Y7GonQwtHiagN","type":"tool_result","content":"40\t\n41\t\n42\t# ---------------------------------------------------------------------------\n43\t# Helpers / Fixtures\n44\t# ---------------------------------------------------------------------------\n45\t\n46\t\n47\t@pytest.fixture(autouse=True)\n48\tdef _reset_loyalty_tracker():\n49\t    \"\"\"Ensure the module-level loyalty tracker is clean for every test.\"\"\"\n50\t    clear_loyalty_tracking()\n51\t    yield\n52\t    clear_loyalty_tracking()\n53\t\n54\t\n55\tdef _make_game(\n56\t    *,\n57\t    p1_script: list | None = None,\n58\t    p2_script: list | None = None,\n59\t    phase: Phase = Phase.PRECOMBAT_MAIN,\n60\t    step: Step | None = None,\n61\t) -> GameState:\n62\t    \"\"\"Create a minimal 2-player GameState at the specified phase/step.\"\"\"\n63\t    p1 = DeterministicPlayer(\"Alice\", p1_script or [])\n64\t    p2 = DeterministicPlayer(\"Bob\", p2_script or [])\n65\t    game = GameState([p1, p2])\n66\t    game.phase = phase\n67\t    game.step = step\n68\t    return game\n69\t\n70\t\n71\tdef _sorcery_speed_game() -> GameState:\n72\t    \"\"\"Return a game where sorcery-speed timing is met for the active player.\"\"\"\n73\t    return _make_game(phase=Phase.PRECOMBAT_MAIN, step=None)\n74\t\n75\t\n76\tdef _instant_speed_game() -> GameState:\n77\t    \"\"\"Return a game where sorcery-speed timing is NOT met (combat phase).\"\"\"\n78\t    return _make_game(phase=Phase.COMBAT, step=Step.DECLARE_ATTACKERS)\n79\t\n80\t\n81\t# ---------------------------------------------------------------------------\n82\t# ActivatedAbilityInstance — construction\n83\t# ---------------------------------------------------------------------------\n84\t\n85\t\n86\tclass TestActivatedAbilityInstanceConstruction:\n87\t    \"\"\"ActivatedAbilityInstance dataclass stores all expected fields.\"\"\"\n88\t\n89\t    def test_fields_assigned(self):\n90\t        source = object()\n91\t        controller = DeterministicPlayer(\"Alice\", [])\n92\t        cost = lambda g, s: True\n93\t        effect = lambda g: None\n94\t        ability = ActivatedAbilityInstance(\n95\t            source=source,\n96\t            controller=controller,\n97\t            cost=cost,\n98\t            effect=effect,\n99\t            is_mana_ability=True,\n100\t            description=\"Tap for mana\",\n101\t        )\n102\t        assert ability.source is source\n103\t        assert ability.controller is controller\n104\t        assert ability.cost is cost\n105\t        assert ability.effect is effect\n106\t        assert ability.is_mana_ability is True\n107\t        assert ability.description == \"Tap for mana\"\n108\t\n109\t    def test_defaults(self):\n110\t        source = object()\n111\t        controller = DeterministicPlayer(\"Alice\", [])\n112\t        ability = ActivatedAbilityInstance(\n113\t            source=source,\n114\t            controller=controller,\n115\t            cost=lambda g, s: True,\n116\t            effect=lambda g: None,\n117\t        )\n118\t        assert ability.is_mana_ability is False\n119\t        assert ability.description == \"\"\n120\t\n121\t\n122\t# ---------------------------------------------------------------------------\n123\t# LoyaltyAbilityInstance — construction\n124\t# ---------------------------------------------------------------------------\n125\t\n126\t\n127\tclass TestLoyaltyAbilityInstanceConstruction:\n128\t    \"\"\"LoyaltyAbilityInstance dataclass stores all expected fields.\"\"\"\n129\t"}]},"parent_tool_use_id":null,"session_id":"a8998a71-cb9f-462b-a621-0c4f4edc8cf2","uuid":"7421cc39-2561-4c5d-9957-a0ede20e8e2b","timestamp":"2026-06-03T21:31:46.196Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine_tests/test_abilities.py","content":"\n\n# ---------------------------------------------------------------------------\n# Helpers / Fixtures\n# ---------------------------------------------------------------------------\n\n\n@pytest.fixture(autouse=True)\ndef _reset_loyalty_tracker():\n    \"\"\"Ensure the module-level loyalty tracker is clean for every test.\"\"\"\n    clear_loyalty_tracking()\n    yield\n    clear_loyalty_tracking()\n\n\ndef _make_game(\n    *,\n    p1_script: list | None = None,\n    p2_script: list | None = None,\n    phase: Phase = Phase.PRECOMBAT_MAIN,\n    step: Step | None = None,\n) -> GameState:\n    \"\"\"Create a minimal 2-player GameState at the specified phase/step.\"\"\"\n    p1 = DeterministicPlayer(\"Alice\", p1_script or [])\n    p2 = DeterministicPlayer(\"Bob\", p2_script or [])\n    game = GameState([p1, p2])\n    game.phase = phase\n    game.step = step\n    return game\n\n\ndef _sorcery_speed_game() -> GameState:\n    \"\"\"Return a game where sorcery-speed timing is met for the active player.\"\"\"\n    return _make_game(phase=Phase.PRECOMBAT_MAIN, step=None)\n\n\ndef _instant_speed_game() -> GameState:\n    \"\"\"Return a game where sorcery-speed timing is NOT met (combat phase).\"\"\"\n    return _make_game(phase=Phase.COMBAT, step=Step.DECLARE_ATTACKERS)\n\n\n# ---------------------------------------------------------------------------\n# ActivatedAbilityInstance — construction\n# ---------------------------------------------------------------------------\n\n\nclass TestActivatedAbilityInstanceConstruction:\n    \"\"\"ActivatedAbilityInstance dataclass stores all expected fields.\"\"\"\n\n    def test_fields_assigned(self):\n        source = object()\n        controller = DeterministicPlayer(\"Alice\", [])\n        cost = lambda g, s: True\n        effect = lambda g: None\n        ability = ActivatedAbilityInstance(\n            source=source,\n            controller=controller,\n            cost=cost,\n            effect=effect,\n            is_mana_ability=True,\n            description=\"Tap for mana\",\n        )\n        assert ability.source is source\n        assert ability.controller is controller\n        assert ability.cost is cost\n        assert ability.effect is effect\n        assert ability.is_mana_ability is True\n        assert ability.description == \"Tap for mana\"\n\n    def test_defaults(self):\n        source = object()\n        controller = DeterministicPlayer(\"Alice\", [])\n        ability = ActivatedAbilityInstance(\n            source=source,\n            controller=controller,\n            cost=lambda g, s: True,\n            effect=lambda g: None,\n        )\n        assert ability.is_mana_ability is False\n        assert ability.description == \"\"\n\n\n# ---------------------------------------------------------------------------\n# LoyaltyAbilityInstance — construction\n# ---------------------------------------------------------------------------\n\n\nclass TestLoyaltyAbilityInstanceConstruction:\n    \"\"\"LoyaltyAbilityInstance dataclass stores all expected fields.\"\"\"\n","numLines":90,"startLine":40,"totalLines":977}}}
