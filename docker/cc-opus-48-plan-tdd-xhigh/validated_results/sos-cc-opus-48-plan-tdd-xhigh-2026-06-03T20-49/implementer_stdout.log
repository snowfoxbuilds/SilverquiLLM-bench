{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0171pQ5wHeEBhvst565z4FXi","type":"tool_result","content":"1\t\"\"\"Tests for SOS 57 — Mana Sculpt.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom cards.sos.sos_57.card_impl import ManaSculpt\n6\tfrom engine.card import Creature, Instant, Sorcery\n7\tfrom engine.casting import cast_spell as engine_cast\n8\tfrom engine.events import BeginningOfMainPhaseTriggeredEvent\n9\tfrom engine.stack import StackObject\n10\tfrom engine.types import ManaCost, ManaType, Zone\n11\tfrom test_utils import create_game, set_board_state, _resolve_top_of_stack\n12\t\n13\t\n14\tdef _wizard(name=\"Wizard\"):\n15\t    return Creature(name=name, subtypes={\"Wizard\"}, base_power=1, base_toughness=1)\n16\t\n17\t\n18\tdef _put_spell_on_stack(game, owner, name=\"Big Spell\", cost=\"{3}{R}\"):\n19\t    \"\"\"Simulate an opponent's spell already on the stack.\"\"\"\n20\t    spell = Sorcery(name=name, mana_cost=ManaCost.parse(cost))\n21\t    spell.owner = owner\n22\t    spell.controller = owner\n23\t    owner.zones[Zone.STACK].add(spell)\n24\t    obj = StackObject(source=spell, controller=owner)\n25\t    game.stack.push(obj)\n26\t    return spell, obj\n27\t\n28\t\n29\tclass TestProperties:\n30\t    def test_is_instant(self):\n31\t        assert isinstance(ManaSculpt(owner=None), Instant)\n32\t\n33\t    def test_name(self):\n34\t        assert ManaSculpt(owner=None).name == \"Mana Sculpt\"\n35\t\n36\t    def test_mana_cost(self):\n37\t        assert ManaSculpt(owner=None).mana_cost == ManaCost.parse(\"{1}{U}{U}\")\n38\t\n39\t\n40\tclass TestCounter:\n41\t    def test_counters_target_spell(self):\n42\t        game = create_game()\n43\t        p0, p1 = game.players\n44\t        spell, obj = _put_spell_on_stack(game, p1)\n45\t        ms = ManaSculpt(owner=None)\n46\t        set_board_state(game, 0, hand=[ms],\n47\t                        mana={ManaType.BLUE: 2, ManaType.COLORLESS: 1})\n48\t        p0._script.append(obj)  # choose_target\n49\t        engine_cast(game, p0, ms)\n50\t        # Resolve Mana Sculpt (top of stack).\n51\t        top = game.stack.pop()\n52\t        top.on_resolve(game)\n53\t        # Countered spell is now in its owner's graveyard, off the stack.\n54\t        assert spell in p1.zones[Zone.GRAVEYARD].get_all()\n55\t        assert all(o.source is not spell for o in game.stack.objects())\n56\t\n57\t\n58\tclass TestDelayedMana:\n59\t    def _counter_with_wizard(self, game, control_wizard, cost=\"{3}{R}\"):\n60\t        p0, p1 = game.players\n61\t        spell, obj = _put_spell_on_stack(game, p1, cost=cost)\n62\t        ms = ManaSculpt(owner=None)\n63\t        bf = [_wizard()] if control_wizard else []\n64\t        set_board_state(game, 0, hand=[ms], battlefield=bf,\n65\t                        mana={ManaType.BLUE: 2, ManaType.COLORLESS: 1})\n66\t        p0._script.append(obj)\n67\t        engine_cast(game, p0, ms)\n68\t        top = game.stack.pop()\n69\t        top.on_resolve(game)\n70\t        return ms\n71\t\n72\t    def test_wizard_adds_colorless_at_next_main_phase(self):\n73\t        game = create_game()\n74\t        p0 = game.players[0]\n75\t        self._counter_with_wizard(game, control_wizard=True, cost=\"{3}{R}\")\n76\t        # cmc of countered spell = 4 -> {C}{C}{C}{C} at next main phase.\n77\t        p0.mana_pool.empty()\n78\t        game.trigger_manager.fire_event(\n79\t            game, BeginningOfMainPhaseTriggeredEvent(player=p0, is_precombat=True))\n80\t        _resolve_top_of_stack(game)\n81\t        assert p0.mana_pool.get(ManaType.COLORLESS) == 4\n82\t\n83\t    def test_no_wizard_no_mana(self):\n84\t        game = create_game()\n85\t        p0 = game.players[0]\n86\t        self._counter_with_wizard(game, control_wizard=False)\n87\t        p0.mana_pool.empty()\n88\t        game.trigger_manager.fire_event(\n89\t            game, BeginningOfMainPhaseTriggeredEvent(player=p0, is_precombat=True))\n90\t        _resolve_top_of_stack(game)\n91\t        assert p0.mana_pool.get(ManaType.COLORLESS) == 0\n92\t\n93\t    def test_mana_only_for_controller(self):\n94\t        game = create_game()\n95\t        p0, p1 = game.players\n96\t        self._counter_with_wizard(game, control_wizard=True)\n97\t        p0.mana_pool.empty()\n98\t        # Opponent's main phase should not grant the mana.\n99\t        game.trigger_manager.fire_event(\n100\t            game, BeginningOfMainPhaseTriggeredEvent(player=p1, is_precombat=True))\n101\t        _resolve_top_of_stack(game)\n102\t        assert p0.mana_pool.get(ManaType.COLORLESS) == 0\n103\t\n104\t    def test_delayed_mana_is_one_shot(self):\n105\t        game = create_game()\n106\t        p0 = game.players[0]\n107\t        self._counter_with_wizard(game, control_wizard=True, cost=\"{3}{R}\")\n108\t        game.trigger_manager.fire_event(\n109\t            game, BeginningOfMainPhaseTriggeredEvent(player=p0, is_precombat=True))\n110\t        _resolve_top_of_stack(game)\n111\t        p0.mana_pool.empty()\n112\t        # A subsequent main phase should not add more mana.\n113\t        game.trigger_manager.fire_event(\n114\t            game, BeginningOfMainPhaseTriggeredEvent(player=p0, is_precombat=False))\n115\t        _resolve_top_of_stack(game)\n116\t        assert p0.mana_pool.get(ManaType.COLORLESS) == 0\n117\t"}]},"parent_tool_use_id":null,"session_id":"a8998a71-cb9f-462b-a621-0c4f4edc8cf2","uuid":"43de3b79-72bc-408a-b043-9f81876dd19b","timestamp":"2026-06-03T21:37:05.243Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/sos/sos_57/tests.py","content":"\"\"\"Tests for SOS 57 — Mana Sculpt.\"\"\"\n\nfrom __future__ import annotations\n\nfrom cards.sos.sos_57.card_impl import ManaSculpt\nfrom engine.card import Creature, Instant, Sorcery\nfrom engine.casting import cast_spell as engine_cast\nfrom engine.events import BeginningOfMainPhaseTriggeredEvent\nfrom engine.stack import StackObject\nfrom engine.types import ManaCost, ManaType, Zone\nfrom test_utils import create_game, set_board_state, _resolve_top_of_stack\n\n\ndef _wizard(name=\"Wizard\"):\n    return Creature(name=name, subtypes={\"Wizard\"}, base_power=1, base_toughness=1)\n\n\ndef _put_spell_on_stack(game, owner, name=\"Big Spell\", cost=\"{3}{R}\"):\n    \"\"\"Simulate an opponent's spell already on the stack.\"\"\"\n    spell = Sorcery(name=name, mana_cost=ManaCost.parse(cost))\n    spell.owner = owner\n    spell.controller = owner\n    owner.zones[Zone.STACK].add(spell)\n    obj = StackObject(source=spell, controller=owner)\n    game.stack.push(obj)\n    return spell, obj\n\n\nclass TestProperties:\n    def test_is_instant(self):\n        assert isinstance(ManaSculpt(owner=None), Instant)\n\n    def test_name(self):\n        assert ManaSculpt(owner=None).name == \"Mana Sculpt\"\n\n    def test_mana_cost(self):\n        assert ManaSculpt(owner=None).mana_cost == ManaCost.parse(\"{1}{U}{U}\")\n\n\nclass TestCounter:\n    def test_counters_target_spell(self):\n        game = create_game()\n        p0, p1 = game.players\n        spell, obj = _put_spell_on_stack(game, p1)\n        ms = ManaSculpt(owner=None)\n        set_board_state(game, 0, hand=[ms],\n                        mana={ManaType.BLUE: 2, ManaType.COLORLESS: 1})\n        p0._script.append(obj)  # choose_target\n        engine_cast(game, p0, ms)\n        # Resolve Mana Sculpt (top of stack).\n        top = game.stack.pop()\n        top.on_resolve(game)\n        # Countered spell is now in its owner's graveyard, off the stack.\n        assert spell in p1.zones[Zone.GRAVEYARD].get_all()\n        assert all(o.source is not spell for o in game.stack.objects())\n\n\nclass TestDelayedMana:\n    def _counter_with_wizard(self, game, control_wizard, cost=\"{3}{R}\"):\n        p0, p1 = game.players\n        spell, obj = _put_spell_on_stack(game, p1, cost=cost)\n        ms = ManaSculpt(owner=None)\n        bf = [_wizard()] if control_wizard else []\n        set_board_state(game, 0, hand=[ms], battlefield=bf,\n                        mana={ManaType.BLUE: 2, ManaType.COLORLESS: 1})\n        p0._script.append(obj)\n        engine_cast(game, p0, ms)\n        top = game.stack.pop()\n        top.on_resolve(game)\n        return ms\n\n    def test_wizard_adds_colorless_at_next_main_phase(self):\n        game = create_game()\n        p0 = game.players[0]\n        self._counter_with_wizard(game, control_wizard=True, cost=\"{3}{R}\")\n        # cmc of countered spell = 4 -> {C}{C}{C}{C} at next main phase.\n        p0.mana_pool.empty()\n        game.trigger_manager.fire_event(\n            game, BeginningOfMainPhaseTriggeredEvent(player=p0, is_precombat=True))\n        _resolve_top_of_stack(game)\n        assert p0.mana_pool.get(ManaType.COLORLESS) == 4\n\n    def test_no_wizard_no_mana(self):\n        game = create_game()\n        p0 = game.players[0]\n        self._counter_with_wizard(game, control_wizard=False)\n        p0.mana_pool.empty()\n        game.trigger_manager.fire_event(\n            game, BeginningOfMainPhaseTriggeredEvent(player=p0, is_precombat=True))\n        _resolve_top_of_stack(game)\n        assert p0.mana_pool.get(ManaType.COLORLESS) == 0\n\n    def test_mana_only_for_controller(self):\n        game = create_game()\n        p0, p1 = game.players\n        self._counter_with_wizard(game, control_wizard=True)\n        p0.mana_pool.empty()\n        # Opponent's main phase should not grant the mana.\n        game.trigger_manager.fire_event(\n            game, BeginningOfMainPhaseTriggeredEvent(player=p1, is_precombat=True))\n        _resolve_top_of_stack(game)\n        assert p0.mana_pool.get(ManaType.COLORLESS) == 0\n\n    def test_delayed_mana_is_one_shot(self):\n        game = create_game()\n        p0 = game.players[0]\n        self._counter_with_wizard(game, control_wizard=True, cost=\"{3}{R}\")\n        game.trigger_manager.fire_event(\n            game, BeginningOfMainPhaseTriggeredEvent(player=p0, is_precombat=True))\n        _resolve_top_of_stack(game)\n        p0.mana_pool.empty()\n        # A subsequent main phase should not add more mana.\n        game.trigger_manager.fire_event(\n            game, BeginningOfMainPhaseTriggeredEvent(player=p0, is_precombat=False))\n        _resolve_top_of_stack(game)\n        assert p0.mana_pool.get(ManaType.COLORLESS) == 0\n","numLines":117,"startLine":1,"totalLines":117}}}
