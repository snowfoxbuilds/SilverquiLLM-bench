{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SrKMo5ucY6mjJri8vaPm76","type":"tool_result","content":"30\t    Per MTG rules, the active player untaps all permanents they control\n31\t    during their untap step. Summoning sickness is also cleared at this point.\n32\t    \"\"\"\n33\t    active = game.active_player\n34\t    bf = active.zones[Zone.BATTLEFIELD]\n35\t    for obj in bf.get_all():\n36\t        if hasattr(obj, \"is_tapped\"):\n37\t            obj.is_tapped = False\n38\t        if hasattr(obj, \"summoning_sick\"):\n39\t            obj.summoning_sick = False\n40\t\n41\t    # Reset land plays for the active player\n42\t    active.land_plays_remaining = 1\n43\t\n44\t    # Reset first-draw tracking for the turn so that \"the first card you\n45\t    # drew this turn\" (miracle) can be detected reliably.\n46\t    active.cards_drawn_this_turn = 0\n47\t\n48\t\n49\tdef _do_draw_step(game: GameState) -> None:\n50\t    \"\"\"Perform draw step actions: active player draws a card.\n51\t\n52\t    In a two-player game, the starting player (the player who takes\n53\t    turn 1) skips their draw step on that first turn.  This is per\n54\t    MTG comprehensive rules §103.7a.\n55\t    \"\"\"\n56\t    # The starting player skips their draw on turn 1.\n57\t    if game.turn_number == 1 and game.active_player_index == 0:\n58\t        return\n59\t\n60\t    from engine.game import draw_card\n61\t\n62\t    draw_card(game, game.active_player)\n63\t\n64\t\n65\tdef _do_combat_step(game: GameState, step: Step) -> None:\n66\t    \"\"\"Dispatch combat sub-steps to the appropriate combat functions.\n67\t\n68\t    Parameters:\n69\t        game: The current game state.\n70\t        step: The combat step to execute.\n71\t    \"\"\"\n72\t    from engine.combat import (\n73\t        combat_damage_step,\n74\t        declare_attackers_step,\n75\t        declare_blockers_step,\n76\t        end_combat_step,\n77\t    )\n78\t\n79\t    if step == Step.DECLARE_ATTACKERS:\n80\t        declare_attackers_step(game)\n81\t    elif step == Step.DECLARE_BLOCKERS:\n82\t        declare_blockers_step(game)\n83\t    elif step == Step.COMBAT_DAMAGE:\n84\t        combat_damage_step(game)\n85\t    elif step == Step.END_COMBAT:\n86\t        end_combat_step(game)\n87\t\n88\t\n89\tdef _do_cleanup_step(game: GameState) -> None:\n90\t    \"\"\"Perform the cleanup step (MTG rule §514).\n91\t\n92\t    The cleanup step executes the following actions in order:\n93\t\n94\t    1. Active player discards down to maximum hand size (7) using\n95\t       :meth:`Player.choose_card`.\n96\t    2. Remove all \"until end of turn\" continuous effects via\n97\t       :meth:`EffectManager.remove_expired`, then reapply remaining\n98\t       effects for a consistent game state.\n99\t    3. Clear damage marked on all creatures on the battlefield.\n100\t    4. Clear combat-related flags (``dealt_deathtouch_damage``,\n101\t       ``is_attacking``, ``is_blocking``) and reset the combat state.\n102\t    5. Empty all players' mana pools.\n103\t    6. Check state-based actions.\n104\t    7. If triggers fired during cleanup (e.g. from discarding), process\n105\t       them (give priority, resolve stack) and perform another cleanup step.\n106\t    \"\"\"\n107\t    from engine.game import discard as _discard\n108\t    from engine.player import ScriptExhaustedError\n109\t    from engine.state_based_actions import resolve_state_based_actions\n110\t\n111\t    # --- Step 1: Discard to hand size ---\n112\t    active = game.active_player\n113\t    hand = active.zones[Zone.HAND]\n114\t    while len(hand) > MAX_HAND_SIZE:\n115\t        cards_in_hand = hand.get_all()\n116\t        if not cards_in_hand:\n117\t            break  # safety guard\n118\t        try:\n119\t            chosen = active.choose_card(cards_in_hand, \"discard to hand size\")"}]},"parent_tool_use_id":null,"session_id":"a8998a71-cb9f-462b-a621-0c4f4edc8cf2","uuid":"081cf927-ee45-4a25-8421-b5c8cb841013","timestamp":"2026-06-03T21:36:58.789Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/turn.py","content":"    Per MTG rules, the active player untaps all permanents they control\n    during their untap step. Summoning sickness is also cleared at this point.\n    \"\"\"\n    active = game.active_player\n    bf = active.zones[Zone.BATTLEFIELD]\n    for obj in bf.get_all():\n        if hasattr(obj, \"is_tapped\"):\n            obj.is_tapped = False\n        if hasattr(obj, \"summoning_sick\"):\n            obj.summoning_sick = False\n\n    # Reset land plays for the active player\n    active.land_plays_remaining = 1\n\n    # Reset first-draw tracking for the turn so that \"the first card you\n    # drew this turn\" (miracle) can be detected reliably.\n    active.cards_drawn_this_turn = 0\n\n\ndef _do_draw_step(game: GameState) -> None:\n    \"\"\"Perform draw step actions: active player draws a card.\n\n    In a two-player game, the starting player (the player who takes\n    turn 1) skips their draw step on that first turn.  This is per\n    MTG comprehensive rules §103.7a.\n    \"\"\"\n    # The starting player skips their draw on turn 1.\n    if game.turn_number == 1 and game.active_player_index == 0:\n        return\n\n    from engine.game import draw_card\n\n    draw_card(game, game.active_player)\n\n\ndef _do_combat_step(game: GameState, step: Step) -> None:\n    \"\"\"Dispatch combat sub-steps to the appropriate combat functions.\n\n    Parameters:\n        game: The current game state.\n        step: The combat step to execute.\n    \"\"\"\n    from engine.combat import (\n        combat_damage_step,\n        declare_attackers_step,\n        declare_blockers_step,\n        end_combat_step,\n    )\n\n    if step == Step.DECLARE_ATTACKERS:\n        declare_attackers_step(game)\n    elif step == Step.DECLARE_BLOCKERS:\n        declare_blockers_step(game)\n    elif step == Step.COMBAT_DAMAGE:\n        combat_damage_step(game)\n    elif step == Step.END_COMBAT:\n        end_combat_step(game)\n\n\ndef _do_cleanup_step(game: GameState) -> None:\n    \"\"\"Perform the cleanup step (MTG rule §514).\n\n    The cleanup step executes the following actions in order:\n\n    1. Active player discards down to maximum hand size (7) using\n       :meth:`Player.choose_card`.\n    2. Remove all \"until end of turn\" continuous effects via\n       :meth:`EffectManager.remove_expired`, then reapply remaining\n       effects for a consistent game state.\n    3. Clear damage marked on all creatures on the battlefield.\n    4. Clear combat-related flags (``dealt_deathtouch_damage``,\n       ``is_attacking``, ``is_blocking``) and reset the combat state.\n    5. Empty all players' mana pools.\n    6. Check state-based actions.\n    7. If triggers fired during cleanup (e.g. from discarding), process\n       them (give priority, resolve stack) and perform another cleanup step.\n    \"\"\"\n    from engine.game import discard as _discard\n    from engine.player import ScriptExhaustedError\n    from engine.state_based_actions import resolve_state_based_actions\n\n    # --- Step 1: Discard to hand size ---\n    active = game.active_player\n    hand = active.zones[Zone.HAND]\n    while len(hand) > MAX_HAND_SIZE:\n        cards_in_hand = hand.get_all()\n        if not cards_in_hand:\n            break  # safety guard\n        try:\n            chosen = active.choose_card(cards_in_hand, \"discard to hand size\")","numLines":90,"startLine":30,"totalLines":238}}}
