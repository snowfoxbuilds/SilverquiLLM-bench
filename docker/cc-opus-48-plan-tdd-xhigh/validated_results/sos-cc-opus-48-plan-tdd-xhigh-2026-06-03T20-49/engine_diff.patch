+def cast_spell_alt_cost(
+    game: GameState,
+    player: Player,
+    card: CardImpl,
+    from_zone: Zone,
+    alt_cost: ManaCost,
+) -> None:
+    """Cast *card* from *from_zone* paying *alt_cost* instead of its mana cost.
+
+    Used by alternative-cost mechanics such as miracle: the card is cast as a
+    normal spell (goes on the stack, can be responded to, fires the
+    "whenever you cast a spell" event), but the player pays *alt_cost* rather
+    than the printed ``card.mana_cost``.
+
+    No sorcery-speed timing check is performed — alternative-cost casts of
+    this kind are special actions/triggers that grant their own timing
+    permission.  Cost reduction is not applied to the alternative cost.
+
+    Raises:
+        CastingError: If legality, location, targeting, or mana checks fail.
+    """
+    # 1. can_cast legality (timing is granted by the alt-cost permission).
+    if not card.can_cast(game):
+        raise CastingError(f"Cannot cast {card.name!r} — can_cast returned False")
+
+    # 2. Locate card in source zone.
+    source_zone_container = player.zones[from_zone]
+    if not source_zone_container.contains(card):
+        raise CastingError(
+            f"Cannot cast {card.name!r} — card not found in {from_zone.name}"
+        )
+
+    # 3. Move card from source zone to stack zone.
+    stack_zone = player.zones[Zone.STACK]
+    source_zone_container.remove(card)
+    stack_zone.add(card)
+
+    # Clear any stale colors_spent from a prior cast before new payment.
+    if hasattr(card, "colors_spent"):
+        del card.colors_spent
+
+    if card.controller is None:
+        card.controller = player
+    if card.owner is None:
+        card.owner = player
+
+    # 4. Choose targets (with rollback on failure).
+    try:
+        target_specs = card.get_targets(game)
+        chosen_targets: list[Any] = []
+        if target_specs:
+            for spec in target_specs:
+                target = player.choose_target(target_specs, spec)
+                filter_fn = getattr(spec, "filter_fn", None)
+                if filter_fn is not None and target is not None:
+                    if not filter_fn(target):
+                        raise CastingError(
+                            f"Cannot cast {card.name!r} — chosen target does not "
+                            f"satisfy filter: {getattr(spec, 'description', '')}"
+                        )
+                chosen_targets.append(target)
+
+        from engine.protection import has_protection_from
+
+        for target in chosen_targets:
+            if has_protection_from(target, card):
+                raise CastingError(
+                    f"Cannot cast {card.name!r} — target has protection from this spell"
+                )
+    except Exception as exc:
+        stack_zone.remove(card)
+        source_zone_container.add(card)
+        raise CastingError(str(exc)) from exc
+
+    # 5. Mana check / payment of the alternative cost (rollback on failure).
+    if not player.mana_pool.can_pay(alt_cost):
+        stack_zone.remove(card)
+        source_zone_container.add(card)
+        raise CastingError(f"Cannot cast {card.name!r} — insufficient mana")
+
+    player.mana_pool.pay(alt_cost)
+    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]
+
+    # 6. Call on_cast hook.
+    card.on_cast(game)
+
+    # 7. Push StackObject.
+    stack_obj = StackObject(
+        source=card,
+        controller=player,
+        targets=chosen_targets,
