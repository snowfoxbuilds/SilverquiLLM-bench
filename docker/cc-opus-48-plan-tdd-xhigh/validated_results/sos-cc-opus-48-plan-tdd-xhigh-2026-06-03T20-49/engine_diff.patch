+def surveil(game: GameState, player: Player, n: int) -> None:
+    """Surveil *n* — look at the top *n* cards of *player*'s library, then put
+    any number of them into the graveyard and leave the rest on top.
+
+    For each looked-at card (top first) the player chooses ``"graveyard"`` or
+    ``"top"`` via :meth:`Player.choose`; only ``"graveyard"`` moves the card.
+    Cards kept on top retain their relative order.
+    """
+    if n <= 0:
+        return
+    library = player.zones[Zone.LIBRARY]
+    if len(library) == 0:
+        return
+
+    looked = list(reversed(library.top(n)))  # top-first
+    for card in looked:
+        choice = player.choose(
+            ["top", "graveyard"],
+            f"surveil: {getattr(card, 'name', '?')}",
+        )
+        if choice == "graveyard":
+            move_to_zone(game, card, Zone.LIBRARY, Zone.GRAVEYARD)
+
+
