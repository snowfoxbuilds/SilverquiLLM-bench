{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CaJVPBYyjUL39JyyvisXbn","type":"tool_result","content":"1\t\"\"\"Card implementation for Progenitus.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom typing import TYPE_CHECKING, Any\n4\tfrom engine.card import Creature\n5\tfrom engine.protection import ProtectionAbility\n6\tfrom engine.events import MoveToGraveyardReplacementEvent\n7\tfrom engine.replacement_effects import ReplacementEffect\n8\tfrom engine.types import ManaCost, Supertype, Zone\n9\tif TYPE_CHECKING:\n10\t    from engine.game_state import GameState\n11\t\n12\tclass Progenitus(Creature):\n13\t    \"\"\"Progenitus — {W}{W}{U}{U}{B}{B}{R}{R}{G}{G} — 10/10 — Legendary Hydra Avatar.\n14\t\n15\t    Protection from everything.\n16\t    If Progenitus would be put into a graveyard from anywhere, reveal\n17\t    Progenitus and shuffle it into its owner's library instead.\n18\t\n19\t    FDN collector number 244.\n20\t    \"\"\"\n21\t\n22\t    def __init__(self, **kwargs: Any) -> None:\n23\t        kwargs.setdefault('name', 'Progenitus')\n24\t        kwargs.setdefault('mana_cost', ManaCost.parse('{W}{W}{U}{U}{B}{B}{R}{R}{G}{G}'))\n25\t        kwargs.setdefault('subtypes', {'Hydra', 'Avatar'})\n26\t        kwargs.setdefault('supertypes', {Supertype.LEGENDARY})\n27\t        kwargs.setdefault('base_power', 10)\n28\t        kwargs.setdefault('base_toughness', 10)\n29\t        kwargs.setdefault('rules_text', \"Protection from everything\\nIf Progenitus would be put into a graveyard from anywhere, reveal Progenitus and shuffle it into its owner's library instead.\")\n30\t        super().__init__(**kwargs)\n31\t        self._init_protection()\n32\t\n33\t    def _init_protection(self) -> None:\n34\t        \"\"\"Set up protection from everything. Called from __init__ and\n35\t        can be re-invoked after characteristic resets.\"\"\"\n36\t        self.protections = [ProtectionAbility(quality='everything', predicate=lambda source: True)]\n37\t\n38\t    def _reset_characteristics(self) -> None:\n39\t        \"\"\"Override to reapply protection from everything after reset.\"\"\"\n40\t        super()._reset_characteristics()\n41\t        self._init_protection()\n42\t\n43\t    def register_replacement_effects(self, game: 'GameState') -> None:\n44\t        \"\"\"Register graveyard-shuffle replacement effect.\n45\t\n46\t        Registers a single :class:`~engine.events.MoveToGraveyardReplacementEvent`\n47\t        handler; the engine's zone-move pipeline dispatches subclass events\n48\t        (creature_dies, sacrifice, etc.) to this parent-type handler automatically.\n49\t        \"\"\"\n50\t        source = self\n51\t\n52\t        def _condition(game: Any, event: dict) -> bool:\n53\t            return event.card is source\n54\t\n55\t        def _replacement(game: Any, event: dict) -> dict:\n56\t            owner = getattr(source, 'owner', None)\n57\t            if owner is not None:\n58\t                library = owner.zones[Zone.LIBRARY]\n59\t                library.add(source)\n60\t                library.shuffle()\n61\t            event.prevented = True\n62\t            return event\n63\t        controller = getattr(self, 'controller', None)\n64\t        game.replacement_manager.register(ReplacementEffect(event_type=MoveToGraveyardReplacementEvent, source=self, condition=_condition, replacement=_replacement, controller=controller))\n65\t"}]},"parent_tool_use_id":null,"session_id":"acdbccee-58c7-42ed-bbbd-0f2ff960a258","uuid":"6b53c10e-9397-43bc-af7a-9e2bcfe66ed6","timestamp":"2026-06-03T20:51:00.681Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_244/card_impl.py","content":"\"\"\"Card implementation for Progenitus.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import Creature\nfrom engine.protection import ProtectionAbility\nfrom engine.events import MoveToGraveyardReplacementEvent\nfrom engine.replacement_effects import ReplacementEffect\nfrom engine.types import ManaCost, Supertype, Zone\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\nclass Progenitus(Creature):\n    \"\"\"Progenitus — {W}{W}{U}{U}{B}{B}{R}{R}{G}{G} — 10/10 — Legendary Hydra Avatar.\n\n    Protection from everything.\n    If Progenitus would be put into a graveyard from anywhere, reveal\n    Progenitus and shuffle it into its owner's library instead.\n\n    FDN collector number 244.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Progenitus')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{W}{W}{U}{U}{B}{B}{R}{R}{G}{G}'))\n        kwargs.setdefault('subtypes', {'Hydra', 'Avatar'})\n        kwargs.setdefault('supertypes', {Supertype.LEGENDARY})\n        kwargs.setdefault('base_power', 10)\n        kwargs.setdefault('base_toughness', 10)\n        kwargs.setdefault('rules_text', \"Protection from everything\\nIf Progenitus would be put into a graveyard from anywhere, reveal Progenitus and shuffle it into its owner's library instead.\")\n        super().__init__(**kwargs)\n        self._init_protection()\n\n    def _init_protection(self) -> None:\n        \"\"\"Set up protection from everything. Called from __init__ and\n        can be re-invoked after characteristic resets.\"\"\"\n        self.protections = [ProtectionAbility(quality='everything', predicate=lambda source: True)]\n\n    def _reset_characteristics(self) -> None:\n        \"\"\"Override to reapply protection from everything after reset.\"\"\"\n        super()._reset_characteristics()\n        self._init_protection()\n\n    def register_replacement_effects(self, game: 'GameState') -> None:\n        \"\"\"Register graveyard-shuffle replacement effect.\n\n        Registers a single :class:`~engine.events.MoveToGraveyardReplacementEvent`\n        handler; the engine's zone-move pipeline dispatches subclass events\n        (creature_dies, sacrifice, etc.) to this parent-type handler automatically.\n        \"\"\"\n        source = self\n\n        def _condition(game: Any, event: dict) -> bool:\n            return event.card is source\n\n        def _replacement(game: Any, event: dict) -> dict:\n            owner = getattr(source, 'owner', None)\n            if owner is not None:\n                library = owner.zones[Zone.LIBRARY]\n                library.add(source)\n                library.shuffle()\n            event.prevented = True\n            return event\n        controller = getattr(self, 'controller', None)\n        game.replacement_manager.register(ReplacementEffect(event_type=MoveToGraveyardReplacementEvent, source=self, condition=_condition, replacement=_replacement, controller=controller))\n","numLines":65,"startLine":1,"totalLines":65}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Kd4uDEjgxv1Bvtm6mvvcgA","type":"tool_result","content":"1\t# Test Utilities API Reference\n2\t\n3\tHelper functions for writing card tests. Import from `test_utils`.\n4\t\n5\t## Functions\n6\t\n7\t### `create_game`\n8\t\n9\t`create_game(deck1=None, deck2=None, *, player1_life=20, player2_life=20, scripts=None) -> GameState`\n10\t\n11\tCreate a two-player game with `DeterministicPlayer` instances. Decks default to empty lists.\n12\t\n13\t```python\n14\tfrom test_utils import create_game\n15\tgame = create_game(player1_life=25)\n16\t```\n17\t\n18\t### `set_board_state`\n19\t\n20\t`set_board_state(game, player_index, *, battlefield=None, hand=None, graveyard=None, life=None, mana=None) -> None`\n21\t\n22\tSet zone contents and player state. Only zones explicitly provided are modified.\n23\t\n24\t- **hand / battlefield / graveyard** — `list` of card objects.\n25\t- **mana** — `dict[ManaType, int]`.\n26\t\n27\t```python\n28\tfrom test_utils import create_game, set_board_state\n29\tfrom engine.types import ManaType\n30\tfrom cards.fdn.fdn_13.card_impl import FleetingFlight\n31\tfrom engine.card import Creature\n32\t\n33\tgame = create_game()\n34\tset_board_state(game, 0, hand=[FleetingFlight(owner=None)], mana={ManaType.WHITE: 2})\n35\tbear = Creature(name=\"Grizzly Bears\", base_power=2, base_toughness=2)\n36\tset_board_state(game, 1, battlefield=[bear], life=15)\n37\t```\n38\t\n39\t### `cast_spell`\n40\t\n41\t`cast_spell(game, player_index, card_name, targets=None) -> None`\n42\t\n43\tFind a card in hand by name, cast it, and resolve. Sets sorcery-speed timing automatically.\n44\t\n45\t```python\n46\tfrom test_utils import create_game, set_board_state, cast_spell\n47\tfrom engine.types import ManaType\n48\tfrom cards.fdn.fdn_13.card_impl import FleetingFlight\n49\t\n50\tgame = create_game()\n51\tset_board_state(game, 0, hand=[FleetingFlight(owner=None)], mana={ManaType.WHITE: 2})\n52\tcast_spell(game, 0, \"Fleeting Flight\")\n53\t```\n54\t\n55\t### `advance_to_phase`\n56\t\n57\t`advance_to_phase(game, phase, step=None) -> None`\n58\t\n59\tFast-forward to the specified phase/step without granting priority.\n60\t\n61\t```python\n62\tfrom test_utils import create_game, advance_to_phase\n63\tfrom engine.types import Phase, Step\n64\t\n65\tgame = create_game()\n66\tadvance_to_phase(game, Phase.COMBAT, Step.DECLARE_ATTACKERS)\n67\t```\n68\t\n69\t### `declare_attackers`\n70\t\n71\t`declare_attackers(game, attacker_names) -> None`\n72\t\n73\tAdvance to combat and declare creatures as attackers by name from the active player's battlefield.\n74\t\n75\t```python\n76\tfrom test_utils import create_game, set_board_state, declare_attackers\n77\tfrom engine.card import Creature\n78\t\n79\tgame = create_game()\n80\tbear = Creature(name=\"Grizzly Bears\", base_power=2, base_toughness=2)\n81\tset_board_state(game, 0, battlefield=[bear])\n82\tdeclare_attackers(game, [\"Grizzly Bears\"])\n83\t```\n84\t\n85\t### `declare_blockers`\n86\t\n87\t`declare_blockers(game, assignments) -> None`\n88\t\n89\tAssign blockers by name mapping: `{\"attacker_name\": [\"blocker_name\", ...]}`.\n90\t\n91\t```python\n92\tfrom test_utils import create_game, set_board_state, declare_attackers, declare_blockers\n93\tfrom engine.card import Creature\n94\t\n95\tgame = create_game()\n96\tbear = Creature(name=\"Grizzly Bears\", base_power=2, base_toughness=2)\n97\twall = Creature(name=\"Wall of Wood\", base_power=0, base_toughness=3)\n98\tset_board_state(game, 0, battlefield=[bear])\n99\tset_board_state(game, 1, battlefield=[wall])\n100\tdeclare_attackers(game, [\"Grizzly Bears\"])\n101\tdeclare_blockers(game, {\"Grizzly Bears\": [\"Wall of Wood\"]})\n102\t```\n103\t\n104\t## Test Structure\n105\t\n106\t```python\n107\timport pytest\n108\tfrom test_utils import create_game, set_board_state, cast_spell\n109\tfrom cards.sos.sos_1.card_impl import TheDawningArchaic\n110\tfrom engine.types import ManaType\n111\t\n112\tclass TestTheDawningArchaic:\n113\t    def test_basic_cast(self):\n114\t        game = create_game()\n115\t        set_board_state(game, 0, hand=[TheDawningArchaic(owner=None)],\n116\t                        mana={ManaType.COLORLESS: 10})\n117\t        cast_spell(game, 0, \"The Dawning Archaic\")\n118\t        assert game.players[0].life == 20\n119\t```\n120\t\n121\t## Constraints\n122\t\n123\t- **Max 30 tests per card.**\n124\t- Import helpers from `test_utils`.\n125\t- Import card implementations from `cards.sos.sos_<N>.card_impl` (SOS cards you\n126\t  are building) or `cards.fdn.fdn_<N>.card_impl` (FDN reference cards).\n127\t"}]},"parent_tool_use_id":null,"session_id":"acdbccee-58c7-42ed-bbbd-0f2ff960a258","uuid":"393860af-dd4b-46d9-9a4e-0d9a254cd12d","timestamp":"2026-06-03T20:51:00.681Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/test_utils.md","content":"# Test Utilities API Reference\n\nHelper functions for writing card tests. Import from `test_utils`.\n\n## Functions\n\n### `create_game`\n\n`create_game(deck1=None, deck2=None, *, player1_life=20, player2_life=20, scripts=None) -> GameState`\n\nCreate a two-player game with `DeterministicPlayer` instances. Decks default to empty lists.\n\n```python\nfrom test_utils import create_game\ngame = create_game(player1_life=25)\n```\n\n### `set_board_state`\n\n`set_board_state(game, player_index, *, battlefield=None, hand=None, graveyard=None, life=None, mana=None) -> None`\n\nSet zone contents and player state. Only zones explicitly provided are modified.\n\n- **hand / battlefield / graveyard** — `list` of card objects.\n- **mana** — `dict[ManaType, int]`.\n\n```python\nfrom test_utils import create_game, set_board_state\nfrom engine.types import ManaType\nfrom cards.fdn.fdn_13.card_impl import FleetingFlight\nfrom engine.card import Creature\n\ngame = create_game()\nset_board_state(game, 0, hand=[FleetingFlight(owner=None)], mana={ManaType.WHITE: 2})\nbear = Creature(name=\"Grizzly Bears\", base_power=2, base_toughness=2)\nset_board_state(game, 1, battlefield=[bear], life=15)\n```\n\n### `cast_spell`\n\n`cast_spell(game, player_index, card_name, targets=None) -> None`\n\nFind a card in hand by name, cast it, and resolve. Sets sorcery-speed timing automatically.\n\n```python\nfrom test_utils import create_game, set_board_state, cast_spell\nfrom engine.types import ManaType\nfrom cards.fdn.fdn_13.card_impl import FleetingFlight\n\ngame = create_game()\nset_board_state(game, 0, hand=[FleetingFlight(owner=None)], mana={ManaType.WHITE: 2})\ncast_spell(game, 0, \"Fleeting Flight\")\n```\n\n### `advance_to_phase`\n\n`advance_to_phase(game, phase, step=None) -> None`\n\nFast-forward to the specified phase/step without granting priority.\n\n```python\nfrom test_utils import create_game, advance_to_phase\nfrom engine.types import Phase, Step\n\ngame = create_game()\nadvance_to_phase(game, Phase.COMBAT, Step.DECLARE_ATTACKERS)\n```\n\n### `declare_attackers`\n\n`declare_attackers(game, attacker_names) -> None`\n\nAdvance to combat and declare creatures as attackers by name from the active player's battlefield.\n\n```python\nfrom test_utils import create_game, set_board_state, declare_attackers\nfrom engine.card import Creature\n\ngame = create_game()\nbear = Creature(name=\"Grizzly Bears\", base_power=2, base_toughness=2)\nset_board_state(game, 0, battlefield=[bear])\ndeclare_attackers(game, [\"Grizzly Bears\"])\n```\n\n### `declare_blockers`\n\n`declare_blockers(game, assignments) -> None`\n\nAssign blockers by name mapping: `{\"attacker_name\": [\"blocker_name\", ...]}`.\n\n```python\nfrom test_utils import create_game, set_board_state, declare_attackers, declare_blockers\nfrom engine.card import Creature\n\ngame = create_game()\nbear = Creature(name=\"Grizzly Bears\", base_power=2, base_toughness=2)\nwall = Creature(name=\"Wall of Wood\", base_power=0, base_toughness=3)\nset_board_state(game, 0, battlefield=[bear])\nset_board_state(game, 1, battlefield=[wall])\ndeclare_attackers(game, [\"Grizzly Bears\"])\ndeclare_blockers(game, {\"Grizzly Bears\": [\"Wall of Wood\"]})\n```\n\n## Test Structure\n\n```python\nimport pytest\nfrom test_utils import create_game, set_board_state, cast_spell\nfrom cards.sos.sos_1.card_impl import TheDawningArchaic\nfrom engine.types import ManaType\n\nclass TestTheDawningArchaic:\n    def test_basic_cast(self):\n        game = create_game()\n        set_board_state(game, 0, hand=[TheDawningArchaic(owner=None)],\n                        mana={ManaType.COLORLESS: 10})\n        cast_spell(game, 0, \"The Dawning Archaic\")\n        assert game.players[0].life == 20\n```\n\n## Constraints\n\n- **Max 30 tests per card.**\n- Import helpers from `test_utils`.\n- Import card implementations from `cards.sos.sos_<N>.card_impl` (SOS cards you\n  are building) or `cards.fdn.fdn_<N>.card_impl` (FDN reference cards).\n","numLines":127,"startLine":1,"totalLines":127}}}
