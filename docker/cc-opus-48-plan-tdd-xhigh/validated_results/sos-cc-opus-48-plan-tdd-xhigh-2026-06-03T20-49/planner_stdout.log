{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SzqpQ1iutC76hrLBjocZx5","type":"tool_result","content":"1\t\"\"\"Card implementation for Thousand-Year Storm.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom typing import TYPE_CHECKING, Any\n4\tfrom engine.card import Enchantment\n5\tfrom engine.types import CardType, ManaCost\n6\tfrom engine.events import SpellCastTriggeredEvent\n7\tif TYPE_CHECKING:\n8\t    from engine.game_state import GameState\n9\t\n10\t\n11\tclass ThousandYearStorm(Enchantment):\n12\t    \"\"\"Thousand-Year Storm — {4}{U}{R} — Enchantment.\n13\t\n14\t    Whenever you cast an instant or sorcery spell, copy it for each\n15\t    other instant and sorcery spell you've cast before it this turn.\n16\t    You may choose new targets for the copies.\n17\t\n18\t    FDN collector number 248.\n19\t    \"\"\"\n20\t\n21\t    def __init__(self, **kwargs: Any) -> None:\n22\t        kwargs.setdefault('name', 'Thousand-Year Storm')\n23\t        kwargs.setdefault('mana_cost', ManaCost.parse('{4}{U}{R}'))\n24\t        kwargs.setdefault(\n25\t            'rules_text',\n26\t            \"Whenever you cast an instant or sorcery spell, copy it for each \"\n27\t            \"other instant and sorcery spell you've cast before it this turn. \"\n28\t            \"You may choose new targets for the copies.\",\n29\t        )\n30\t        super().__init__(**kwargs)\n31\t\n32\t    def register_triggers(self, game: 'GameState') -> None:\n33\t        from engine.stack import copy_spell\n34\t        from engine.triggers import TriggerRegistration\n35\t\n36\t        source = self\n37\t        controller = getattr(self, 'controller', None) or game.active_player\n38\t        source._storm_count: int = 0\n39\t        source._last_turn: int = getattr(game, 'turn_number', 0)\n40\t\n41\t        def _condition(game: Any, event: Any) -> bool:\n42\t            ctrl = getattr(source, 'controller', None)\n43\t            caster = getattr(event, 'player', None