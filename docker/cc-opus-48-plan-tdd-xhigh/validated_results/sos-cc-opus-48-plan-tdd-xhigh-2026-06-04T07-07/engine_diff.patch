+    if not player.mana_pool.can_pay(alt_cost):
+        stack_zone.remove(card)
+        hand.add(card)
+        raise CastingError(f"Cannot cast {card.name!r} — insufficient mana for alt cost")
+    player.mana_pool.pay(alt_cost)
+
+    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]
+    card.mana_spent = player.mana_pool.last_payment_total  # type: ignore[attr-defined]
+
+    # 7. on_cast hook
+    card.on_cast(game)
+
+    # 8. Build on_resolve callback and push StackObject
