{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PQEZVULANyJ4NJ8NPGe7Lu","type":"tool_result","content":"530\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n531\t    \"\"\"\n532\t    from engine.zones import move_to_zone\n533\t\n534\t    # Read targets from the StackObject — the single source of truth.\n535\t    # Set chosen_targets on the card just before resolution so that\n536\t    # _get_chosen_target helpers (which read via getattr) work.\n537\t    targets = stack_obj.targets\n538\t    if targets is not None:\n539\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n540\t\n541\t    card.on_resolve(game)\n542\t\n543\t    if card.card_types & _PERMANENT_TYPES:\n544\t        # Move from stack to battlefield via move_to_zone, which handles\n545\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n546\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n547\t    else:\n548\t        # Instant/sorcery: consult replacement effects (\"if that spell would\n549\t        # be put into your graveyard, exile it instead\") before moving the\n550\t        # card off the stack.  With no replacement registered this is a no-op\n551\t        # and the spell goes to the graveyard as before.\n552\t        from engine.events import SpellToGraveyardReplacementEvent\n553\t        from engine.zones import _DESTINATION_ZONE_MAP\n554\t\n555\t        owner = getattr(card, \"owner\", None) or player\n556\t        repl = game.replacement_manager.apply(\n557\t            game,\n558\t            SpellToGraveyardReplacementEvent(\n559\t                spell=card, controller=player, owner=owner\n560\t            ),\n561\t        )\n562\t        if getattr(repl, \"prevented\", False):\n563\t            stack_container = owner.zones[Zone.STACK]\n564\t            if stack_container.contains(card):\n565\t                stack_container.remove(card)\n566\t            return\n567\t        dest = _DESTINATION_ZONE_MAP.get(\n568\t            getattr(repl, \"destination\", \"graveyard\"), Zone.GRAVEYARD\n569\t        )\n570\t        move_to_zone(game, card, Zone.STACK, dest)\n571\t\n572\t\n573\t# ------------------------------------------------------------------\n574\t# Play land (special action — does not use the stack)\n575\t# ------------------------------------------------------------------\n576\t\n577\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n578\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n579\t\n580\t    Requirements (all must hold):\n581\t\n582\t    * *land_card* has :attr:`CardType.LAND`.\n583\t    * *player* is the active player.\n584\t    * Current phase is a main phase.\n585\t    * The stack is empty.\n586\t    * ``player.land_plays_remaining > 0``.\n587\t    * The card is in the player's hand.\n588\t\n589\t    On success the card moves from hand to battlefield and\n590\t    ``land_plays_remaining`` is decremented.\n591\t\n592\t    Raises:\n593\t        CastingError: If any requirement is not met.\n594\t    \"\"\"\n595\t    # Must be a land\n596\t    if CardType.LAND not in land_card.card_types:\n597\t        raise CastingError(\n598\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n599\t        )\n600\t\n601\t    # Sorcery-speed timing (active player, main phase, stack empty)\n602\t    if not is_sorcery_speed(game, player):\n603\t        raise CastingError(\n604\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n605\t            \"during main phase with empty stack\"\n606\t        )\n607\t\n608\t    # Land plays remaining\n609\t    if player.land_plays_remaining <= 0:\n610\t        raise CastingError(\n611\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n612\t        )\n613\t\n614\t    # Card must be in hand\n615\t    hand = game.get_hand(player)\n616\t    if not hand.contains(land_card):\n617\t        raise CastingError(\n618\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n619\t        )\n620\t\n621\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n622\t    if land_card.owner is None:\n623\t        land_card.owner = player\n624\t    land_card.controller = player\n625\t\n626\t    # Move from hand to battlefield via move_to_zone, which fires\n627\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n628\t    from engine.zones import move_to_zone\n629\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n630\t\n631\t    # Decrement land plays\n632\t    player.land_plays_remaining -= 1\n633\t\n634\t\n635\tdef resolve_top(game: GameState) -> None:\n636\t    \"\"\"Resolve the top spell/ability on the stack.\n637\t\n638\t    Pops the top item from the stack, calls its on_resolve callback,\n639\t    then runs state-based actions.  If the stack is empty this is a no-op."}]},"parent_tool_use_id":null,"session_id":"ccba73e9-54b6-4808-89ce-87e442914ff8","uuid":"c9b732f5-3555-4b43-b947-b8637d923518","timestamp":"2026-06-04T08:34:05.318Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Read targets from the StackObject — the single source of truth.\n    # Set chosen_targets on the card just before resolution so that\n    # _get_chosen_target helpers (which read via getattr) work.\n    targets = stack_obj.targets\n    if targets is not None:\n        card.chosen_targets = targets  # type: ignore[attr-defined]\n\n    card.on_resolve(game)\n\n    if card.card_types & _PERMANENT_TYPES:\n        # Move from stack to battlefield via move_to_zone, which handles\n        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n    else:\n        # Instant/sorcery: consult replacement effects (\"if that spell would\n        # be put into your graveyard, exile it instead\") before moving the\n        # card off the stack.  With no replacement registered this is a no-op\n        # and the spell goes to the graveyard as before.\n        from engine.events import SpellToGraveyardReplacementEvent\n        from engine.zones import _DESTINATION_ZONE_MAP\n\n        owner = getattr(card, \"owner\", None) or player\n        repl = game.replacement_manager.apply(\n            game,\n            SpellToGraveyardReplacementEvent(\n                spell=card, controller=player, owner=owner\n            ),\n        )\n        if getattr(repl, \"prevented\", False):\n            stack_container = owner.zones[Zone.STACK]\n            if stack_container.contains(card):\n                stack_container.remove(card)\n            return\n        dest = _DESTINATION_ZONE_MAP.get(\n            getattr(repl, \"destination\", \"graveyard\"), Zone.GRAVEYARD\n        )\n        move_to_zone(game, card, Zone.STACK, dest)\n\n\n# ------------------------------------------------------------------\n# Play land (special action — does not use the stack)\n# ------------------------------------------------------------------\n\ndef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n\n    Requirements (all must hold):\n\n    * *land_card* has :attr:`CardType.LAND`.\n    * *player* is the active player.\n    * Current phase is a main phase.\n    * The stack is empty.\n    * ``player.land_plays_remaining > 0``.\n    * The card is in the player's hand.\n\n    On success the card moves from hand to battlefield and\n    ``land_plays_remaining`` is decremented.\n\n    Raises:\n        CastingError: If any requirement is not met.\n    \"\"\"\n    # Must be a land\n    if CardType.LAND not in land_card.card_types:\n        raise CastingError(\n            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n        )\n\n    # Sorcery-speed timing (active player, main phase, stack empty)\n    if not is_sorcery_speed(game, player):\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — must be active player \"\n            \"during main phase with empty stack\"\n        )\n\n    # Land plays remaining\n    if player.land_plays_remaining <= 0:\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n        )\n\n    # Card must be in hand\n    hand = game.get_hand(player)\n    if not hand.contains(land_card):\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — card not in hand\"\n        )\n\n    # Ensure owner/controller are set so move_to_zone routes correctly.\n    if land_card.owner is None:\n        land_card.owner = player\n    land_card.controller = player\n\n    # Move from hand to battlefield via move_to_zone, which fires\n    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n    from engine.zones import move_to_zone\n    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n\n    # Decrement land plays\n    player.land_plays_remaining -= 1\n\n\ndef resolve_top(game: GameState) -> None:\n    \"\"\"Resolve the top spell/ability on the stack.\n\n    Pops the top item from the stack, calls its on_resolve callback,\n    then runs state-based actions.  If the stack is empty this is a no-op.","numLines":110,"startLine":530,"totalLines":648}}}
