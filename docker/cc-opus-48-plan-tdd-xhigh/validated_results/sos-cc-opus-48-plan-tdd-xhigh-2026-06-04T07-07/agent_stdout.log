nd(p1).get_all()) - hand_before == 0\n        assert p2.life == 20\n        assert p1.life == 20\n\n    def test_damage_can_target_a_creature(self) -> None:\n        spell = TogetherAsOne(owner=None)\n        creature = Creature(name=\"Victim\", base_power=2, base_toughness=4)\n        game = create_game()\n        p1, p2 = game.players\n        set_board_state(game, 0, hand=[spell])\n        set_board_state(game, 1, battlefield=[creature])\n        _fill_library(game, 0, 5)\n        # Two colors -> X=2.\n        set_board_state(game, 0, mana={ManaType.RED: 3, ManaType.GREEN: 3})\n        cast_spell(game, 0, \"Together as One\", targets=[p1, creature])\n        assert creature.damage_marked == 2\n\n","structuredPatch":[{"oldStart":44,"oldLines":10,"newStart":44,"newLines":10,"lines":["         # {6} paid with W,U,B (2 each) -> 3 distinct colors -> X=3.","         set_board_state(game, 0, mana={ManaType.WHITE: 2, ManaType.BLUE: 2,","                                        ManaType.BLACK: 2})","-        hand_before = len(game.get_hand(p1).get_all())","+        lib_before = len(game.players[0].zones[Zone.LIBRARY])","         # Target player0 to draw, player1 takes the damage.","         cast_spell(game, 0, \"Together as One\", targets=[p1, p2])","-        assert len(game.get_hand(p1).get_all()) - hand_before == 3","+        assert lib_before - len(game.players[0].zones[Zone.LIBRARY]) == 3","         assert p2.life == 17","         assert p1.life == 23"," "]}],"userModified":false,"replaceAll":false}}
