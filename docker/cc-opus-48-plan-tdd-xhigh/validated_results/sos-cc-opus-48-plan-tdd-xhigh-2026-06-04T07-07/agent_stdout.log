mbda o: hasattr(o, \"life\") or hasattr(o, \"damage_marked\"),\n                description=\"any target\",\n                zone=Zone.BATTLEFIELD,\n            ),\n        ]\n\n    def on_resolve(self, game: \"GameState\") -> None:\n        \"\"\"Resolve converge: draw X, deal X damage, gain X life.\"\"\"\n        from engine.game import deal_damage, draw_card\n\n        cs = self.colors_spent\n        x = len(cs) if isinstance(cs, list) else int(cs or 0)\n\n        chosen = getattr(self, \"chosen_targets\", None) or []\n        draw_player = chosen[0] if len(chosen) >= 1 else None\n        damage_target = chosen[1] if len(chosen) >= 2 else None\n\n        if x <= 0:\n            return\n\n        if draw_player is not None:\n            for _ in range(x):\n                draw_card(game, draw_player)\n\n        if damage_target is not None:\n            deal_damage(game, self, damage_target, x)\n\n        controller = self.controller\n        if controller is not None and hasattr(controller, \"life\"):\n            controller.life += x\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":314,"cache_read_input_tokens":113719,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":314},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ccba73e9-54b6-4808-89ce-87e442914ff8","uuid":"2a6f5fc4-4007-40fb-ad84-be9417ef663e","request_id":"req_011CbhqiuEPVy9YmsgtnhNkg"}
