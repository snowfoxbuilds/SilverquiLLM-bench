{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019MDLBmvMpfMCcB33PRzuQ4","type":"tool_result","content":"1\t\"\"\"Central game state and turn/phase/step progression.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import Any\n6\t\n7\tfrom engine.combat import CombatState\n8\tfrom engine.continuous_effects import EffectManager\n9\tfrom engine.player import Player\n10\tfrom engine.replacement_effects import ReplacementManager\n11\tfrom engine.stack import Stack\n12\tfrom engine.triggers import TriggerManager\n13\tfrom engine.types import Phase, Step, Zone\n14\tfrom engine.zones import ZoneContainer\n15\t\n16\t# Ordered list of (Phase, Step | None) representing a full MTG turn.\n17\t_TURN_SEQUENCE: list[tuple[Phase, Step | None]] = [\n18\t    # Beginning phase\n19\t    (Phase.BEGINNING, Step.UNTAP),\n20\t    (Phase.BEGINNING, Step.UPKEEP),\n21\t    (Phase.BEGINNING, Step.DRAW),\n22\t    # Precombat main phase\n23\t    (Phase.PRECOMBAT_MAIN, None),\n24\t    # Combat phase\n25\t    (Phase.COMBAT, Step.BEGIN_COMBAT),\n26\t    (Phase.COMBAT, Step.DECLARE_ATTACKERS),\n27\t    (Phase.COMBAT, Step.DECLARE_BLOCKERS),\n28\t    (Phase.COMBAT, Step.COMBAT_DAMAGE),\n29\t    (Phase.COMBAT, Step.END_COMBAT),\n30\t    # Postcombat main phase\n31\t    (Phase.POSTCOMBAT_MAIN, None),\n32\t    # Ending phase\n33\t    (Phase.ENDING, Step.END),\n34\t    (Phase.ENDING, Step.CLEANUP),\n35\t]\n36\t\n37\t\n38\tclass GameState:\n39\t    \"\"\"Central game-state object tracking all mutable game information.\n40\t\n41\t    Attributes:\n42\t        players: The list of players in the game.\n43\t        active_player_index: Index of the current active player.\n44\t        priority_player_index: Index of the player who currently has priority.\n45\t        phase: Current phase of the turn.\n46\t        step: Current step within the phase (``None`` for main phases).\n47\t        turn_number: The current turn number (1-indexed).\n48\t        stack: The game stack for spells and abilities.\n49\t        trigger_manager: Central registry for triggered abilities.\n50\t        replacement_manager: Central registry for replacement effects.\n51\t        effect_manager: Manager for continuous effects and the layer system.\n52\t        is_game_over: Whether the game has ended.\n53\t        winner: The winning player, or ``None`` if the game is ongoing / draw.\n54\t    \"\"\"\n55\t\n56\t    def __init__(self, players: list[Player]) -> None:\n57\t        if len(players) < 2:\n58\t            raise ValueError(\"GameState requires at least 2 players\")\n59\t        if len(players) > 2:\n60\t            raise ValueError(\"GameState supports exactly 2 players\")\n61\t\n62\t        self.players: list[Player] = players\n63\t        self.active_player_index: int = 0\n64\t        self.priority_player_index: int = 0\n65\t        self.phase: Phase = Phase.BEGINNING\n66\t        self.step: Step | None = Step.UNTAP\n67\t        self.turn_number: int = 1\n68\t        self.stack: Stack = Stack()\n69\t        self.trigger_manager: TriggerManager = TriggerManager()\n70\t        self.replacement_manager: ReplacementManager = ReplacementManager()\n71\t        self.effect_manager: EffectManager = EffectManager()\n72\t        self.combat_state: CombatState = CombatState()\n73\t        self.is_game_over: bool = False\n74\t        self.winner: Player | None = None\n75\t        # ENGINE LIMITATION: Extra turns queue (FIFO of player seat indices).\n76\t        # Complex interactions ('skip your next turn', multiple extra turns\n77\t        # from different sources) are not fully handled.\n78\t        self.extra_turns: list[int] = []\n79\t        # Tracks normal turn rotation independently of extra turns.\n80\t        # Extra turns are truly *inserted* — they don't advance the\n81\t        # normal rotation.  When extras are exhausted the game picks up\n82\t        # from _normal_next_index.\n83\t        self._normal_next_index: int = 1\n84\t\n85\t    # ------------------------------------------------------------------\n86\t    # Player properties\n87\t    # ------------------------------------------------------------------\n88\t\n89\t    @property\n90\t    def active_player(self) -> Player:\n91\t        \"\"\"Return the currently active player.\"\"\"\n92\t        return self.players[self.active_player_index]\n93\t\n94\t    @property\n95\t    def priority_player(self) -> Player:\n96\t        \"\"\"Return the player who currently has priority.\"\"\"\n97\t        return self.players[self.priority_player_index]\n98\t\n99\t    @property\n100\t    def non_active_player(self) -> Player:\n101\t        \"\"\"Return the non-active player (2-player assumption for v1).\"\"\"\n102\t        return self.players[1 - self.active_player_index]\n103\t\n104\t    # ------------------------------------------------------------------\n105\t    # Zone accessors\n106\t    # ------------------------------------------------------------------\n107\t\n108\t    def get_battlefield(self, player: Player) -> ZoneContainer:\n109\t        \"\"\"Return the battlefield zone for *player*.\"\"\"\n110\t        return player.zones[Zone.BATTLEFIELD]\n111\t\n112\t    def get_hand(self, player: Player) -> ZoneContainer:\n113\t        \"\"\"Return the hand zone for *player*.\"\"\"\n114\t        return player.zones[Zone.HAND]\n115\t\n116\t    def get_graveyard(self, player: Player) -> ZoneContainer:\n117\t        \"\"\"Return the graveyard zone for *player*.\"\"\"\n118\t        return player.zones[Zone.GRAVEYARD]\n119\t\n120\t    def get_library(self, player: Player) -> ZoneContainer:\n121\t        \"\"\"Return the library zone for *player*.\"\"\"\n122\t        return player.zones[Zone.LIBRARY]\n123\t\n124\t    def get_exile(self, player: Player) -> ZoneContainer:\n125\t        \"\"\"Return the exile zone for *player*.\"\"\"\n126\t        return player.zones[Zone.EXILE]\n127\t\n128\t    # ------------------------------------------------------------------\n129\t    # Phase/step progression\n130\t    # ------------------------------------------------------------------\n131\t\n132\t    def advance_phase(self) -> None:\n133\t        \"\"\"Advance to the next phase/step in MTG turn order.\n134\t\n135\t        At the end of CLEANUP, the turn number is incremented and the\n136\t        active player swaps (2-player assumption).  Mana pools are\n137\t        emptied on every transition.\n138\t        \"\"\"\n139\t        current = (self.phase, self.step)\n140\t        idx = _TURN_SEQUENCE.index(current)\n141\t\n142\t        if idx + 1 < len(_TURN_SEQUENCE):\n143\t            # Move to next phase/step within the same turn.\n144\t            next_phase, next_step = _TURN_SEQUENCE[idx + 1]\n145\t            self.phase = next_phase\n146\t            self.step = next_step\n147\t        else:\n148\t            # End of turn — wrap around.\n149\t            self.turn_number += 1\n150\t            if self.extra_turns:\n151\t                # ENGINE LIMITATION: Extra turns queue (FIFO). Pop the\n152\t                # next player seat index; that player gets the next turn.\n153\t                # Normal rotation is NOT advanced — extra turns are\n154\t                # inserted before the normal next turn.\n155\t                self.active_player_index = self.extra_turns.pop(0)\n156\t            else:\n157\t                self.active_player_index = self._normal_next_index\n158\t                self._normal_next_index = 1 - self._normal_next_index\n159\t            self.priority_player_index = self.active_player_index\n160\t            self.phase = _TURN_SEQUENCE[0][0]\n161\t            self.step = _TURN_SEQUENCE[0][1]\n162\t\n163\t        self.empty_mana_pools()\n164\t\n165\t    def empty_mana_pools(self) -> None:\n166\t        \"\"\"Empty all players' mana pools — called on each phase/step transition.\"\"\"\n167\t        for player in self.players:\n168\t            player.mana_pool.empty()\n169\t"}]},"parent_tool_use_id":null,"session_id":"c2218e3f-f535-4885-8855-1c8d61867b45","uuid":"7303dd7c-d31f-4ee9-b1bf-26f618ba4ec0","timestamp":"2026-06-04T07:15:50.657Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/game_state.py","content":"\"\"\"Central game state and turn/phase/step progression.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any\n\nfrom engine.combat import CombatState\nfrom engine.continuous_effects import EffectManager\nfrom engine.player import Player\nfrom engine.replacement_effects import ReplacementManager\nfrom engine.stack import Stack\nfrom engine.triggers import TriggerManager\nfrom engine.types import Phase, Step, Zone\nfrom engine.zones import ZoneContainer\n\n# Ordered list of (Phase, Step | None) representing a full MTG turn.\n_TURN_SEQUENCE: list[tuple[Phase, Step | None]] = [\n    # Beginning phase\n    (Phase.BEGINNING, Step.UNTAP),\n    (Phase.BEGINNING, Step.UPKEEP),\n    (Phase.BEGINNING, Step.DRAW),\n    # Precombat main phase\n    (Phase.PRECOMBAT_MAIN, None),\n    # Combat phase\n    (Phase.COMBAT, Step.BEGIN_COMBAT),\n    (Phase.COMBAT, Step.DECLARE_ATTACKERS),\n    (Phase.COMBAT, Step.DECLARE_BLOCKERS),\n    (Phase.COMBAT, Step.COMBAT_DAMAGE),\n    (Phase.COMBAT, Step.END_COMBAT),\n    # Postcombat main phase\n    (Phase.POSTCOMBAT_MAIN, None),\n    # Ending phase\n    (Phase.ENDING, Step.END),\n    (Phase.ENDING, Step.CLEANUP),\n]\n\n\nclass GameState:\n    \"\"\"Central game-state object tracking all mutable game information.\n\n    Attributes:\n        players: The list of players in the game.\n        active_player_index: Index of the current active player.\n        priority_player_index: Index of the player who currently has priority.\n        phase: Current phase of the turn.\n        step: Current step within the phase (``None`` for main phases).\n        turn_number: The current turn number (1-indexed).\n        stack: The game stack for spells and abilities.\n        trigger_manager: Central registry for triggered abilities.\n        replacement_manager: Central registry for replacement effects.\n        effect_manager: Manager for continuous effects and the layer system.\n        is_game_over: Whether the game has ended.\n        winner: The winning player, or ``None`` if the game is ongoing / draw.\n    \"\"\"\n\n    def __init__(self, players: list[Player]) -> None:\n        if len(players) < 2:\n            raise ValueError(\"GameState requires at least 2 players\")\n        if len(players) > 2:\n            raise ValueError(\"GameState supports exactly 2 players\")\n\n        self.players: list[Player] = players\n        self.active_player_index: int = 0\n        self.priority_player_index: int = 0\n        self.phase: Phase = Phase.BEGINNING\n        self.step: Step | None = Step.UNTAP\n        self.turn_number: int = 1\n        self.stack: Stack = Stack()\n        self.trigger_manager: TriggerManager = TriggerManager()\n        self.replacement_manager: ReplacementManager = ReplacementManager()\n        self.effect_manager: EffectManager = EffectManager()\n        self.combat_state: CombatState = CombatState()\n        self.is_game_over: bool = False\n        self.winner: Player | None = None\n        # ENGINE LIMITATION: Extra turns queue (FIFO of player seat indices).\n        # Complex interactions ('skip your next turn', multiple extra turns\n        # from different sources) are not fully handled.\n        self.extra_turns: list[int] = []\n        # Tracks normal turn rotation independently of extra turns.\n        # Extra turns are truly *inserted* — they don't advance the\n        # normal rotation.  When extras are exhausted the game picks up\n        # from _normal_next_index.\n        self._normal_next_index: int = 1\n\n    # ------------------------------------------------------------------\n    # Player properties\n    # ------------------------------------------------------------------\n\n    @property\n    def active_player(self) -> Player:\n        \"\"\"Return the currently active player.\"\"\"\n        return self.players[self.active_player_index]\n\n    @property\n    def priority_player(self) -> Player:\n        \"\"\"Return the player who currently has priority.\"\"\"\n        return self.players[self.priority_player_index]\n\n    @property\n    def non_active_player(self) -> Player:\n        \"\"\"Return the non-active player (2-player assumption for v1).\"\"\"\n        return self.players[1 - self.active_player_index]\n\n    # ------------------------------------------------------------------\n    # Zone accessors\n    # ------------------------------------------------------------------\n\n    def get_battlefield(self, player: Player) -> ZoneContainer:\n        \"\"\"Return the battlefield zone for *player*.\"\"\"\n        return player.zones[Zone.BATTLEFIELD]\n\n    def get_hand(self, player: Player) -> ZoneContainer:\n        \"\"\"Return the hand zone for *player*.\"\"\"\n        return player.zones[Zone.HAND]\n\n    def get_graveyard(self, player: Player) -> ZoneContainer:\n        \"\"\"Return the graveyard zone for *player*.\"\"\"\n        return player.zones[Zone.GRAVEYARD]\n\n    def get_library(self, player: Player) -> ZoneContainer:\n        \"\"\"Return the library zone for *player*.\"\"\"\n        return player.zones[Zone.LIBRARY]\n\n    def get_exile(self, player: Player) -> ZoneContainer:\n        \"\"\"Return the exile zone for *player*.\"\"\"\n        return player.zones[Zone.EXILE]\n\n    # ------------------------------------------------------------------\n    # Phase/step progression\n    # ------------------------------------------------------------------\n\n    def advance_phase(self) -> None:\n        \"\"\"Advance to the next phase/step in MTG turn order.\n\n        At the end of CLEANUP, the turn number is incremented and the\n        active player swaps (2-player assumption).  Mana pools are\n        emptied on every transition.\n        \"\"\"\n        current = (self.phase, self.step)\n        idx = _TURN_SEQUENCE.index(current)\n\n        if idx + 1 < len(_TURN_SEQUENCE):\n            # Move to next phase/step within the same turn.\n            next_phase, next_step = _TURN_SEQUENCE[idx + 1]\n            self.phase = next_phase\n            self.step = next_step\n        else:\n            # End of turn — wrap around.\n            self.turn_number += 1\n            if self.extra_turns:\n                # ENGINE LIMITATION: Extra turns queue (FIFO). Pop the\n                # next player seat index; that player gets the next turn.\n                # Normal rotation is NOT advanced — extra turns are\n                # inserted before the normal next turn.\n                self.active_player_index = self.extra_turns.pop(0)\n            else:\n                self.active_player_index = self._normal_next_index\n                self._normal_next_index = 1 - self._normal_next_index\n            self.priority_player_index = self.active_player_index\n            self.phase = _TURN_SEQUENCE[0][0]\n            self.step = _TURN_SEQUENCE[0][1]\n\n        self.empty_mana_pools()\n\n    def empty_mana_pools(self) -> None:\n        \"\"\"Empty all players' mana pools — called on each phase/step transition.\"\"\"\n        for player in self.players:\n            player.mana_pool.empty()\n","numLines":169,"startLine":1,"totalLines":169}}}
