{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AajevLPpnfVQfS1q1Uvrku","type":"tool_result","content":"275\tdef cast_with_alternative_cost(\n276\t    game: GameState, player: Player, card: CardImpl, alt_cost: ManaCost\n277\t) -> None:\n278\t    \"\"\"Cast *card* from *player*'s hand paying *alt_cost* instead of its mana cost.\n279\t\n280\t    Mirrors :func:`cast_spell` (timing, legality, targeting, protection,\n281\t    on_cast, push, spell-cast trigger) but pays the supplied *alt_cost*\n282\t    rather than ``card.mana_cost``.  Used by alternative-cost mechanics such\n283\t    as miracle.\n284\t\n285\t    Raises:\n286\t        CastingError: If any legality check fails or the pool cannot pay\n287\t            *alt_cost*.\n288\t    \"\"\"\n289\t    # 1. Timing\n290\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n291\t        raise CastingError(\n292\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n293\t        )\n294\t\n295\t    # 2. can_cast\n296\t    if not card.can_cast(game):\n297\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n298\t\n299\t    # 3. Hand check\n300\t    hand = game.get_hand(player)\n301\t    if not hand.contains(card):\n302\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n303\t\n304\t    # 4. Move card from hand to stack zone\n305\t    stack_zone = player.zones[Zone.STACK]\n306\t    hand.remove(card)\n307\t    stack_zone.add(card)\n308\t\n309\t    # Clear any stale colors_spent from a prior cast before new payment.\n310\t    if hasattr(card, \"colors_spent\"):\n311\t        del card.colors_spent\n312\t\n313\t    # 5. Choose targets\n314\t    target_specs = card.get_targets(game)\n315\t    chosen_targets: list[Any] = []\n316\t    if target_specs:\n317\t        for spec in target_specs:\n318\t            target = player.choose_target(target_specs, spec)\n319\t            filter_fn = getattr(spec, \"filter_fn\", None)\n320\t            if filter_fn is not None and target is not None:\n321\t                if not filter_fn(target):\n322\t                    stack_zone.remove(card)\n323\t                    hand.add(card)\n324\t                    raise CastingError(\n325\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n326\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n327\t                    )\n328\t            chosen_targets.append(target)\n329\t\n330\t    # 5b. Protection check\n331\t    from engine.protection import has_protection_from\n332\t\n333\t    for target in chosen_targets:\n334\t        if has_protection_from(target, card):\n335\t            stack_zone.remove(card)\n336\t            hand.add(card)\n337\t            raise CastingError(\n338\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n339\t            )\n340\t\n341\t    # 6. Pay the alternative cost (rollback on failure)\n342\t    if card.controller is None:\n343\t        card.controller = player\n344\t    if not player.mana_pool.can_pay(alt_cost):\n345\t        stack_zone.remove(card)\n346\t        hand.add(card)\n347\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana for alt cost\")\n348\t    player.mana_pool.pay(alt_cost)\n349\t\n350\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n351\t    card.mana_spent = player.mana_pool.last_payment_total  # type: ignore[attr-defined]\n352\t\n353\t    # 7. on_cast hook\n354\t    card.on_cast(game)\n355\t\n356\t    # 8. Build on_resolve callback and push StackObject\n357\t    stack_obj = StackObject(\n358\t        source=card,\n359\t        controller=player,\n360\t        targets=chosen_targets,\n361\t        on_resolve=lambda g: None,\n362\t    )\n363\t\n364\t    def _on_resolve(g: GameState) -> None:"}]},"parent_tool_use_id":null,"session_id":"ccba73e9-54b6-4808-89ce-87e442914ff8","uuid":"79b10fbd-7fe4-485e-97ad-28f2825d4a6c","timestamp":"2026-06-04T08:23:33.735Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"def cast_with_alternative_cost(\n    game: GameState, player: Player, card: CardImpl, alt_cost: ManaCost\n) -> None:\n    \"\"\"Cast *card* from *player*'s hand paying *alt_cost* instead of its mana cost.\n\n    Mirrors :func:`cast_spell` (timing, legality, targeting, protection,\n    on_cast, push, spell-cast trigger) but pays the supplied *alt_cost*\n    rather than ``card.mana_cost``.  Used by alternative-cost mechanics such\n    as miracle.\n\n    Raises:\n        CastingError: If any legality check fails or the pool cannot pay\n            *alt_cost*.\n    \"\"\"\n    # 1. Timing\n    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n        )\n\n    # 2. can_cast\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 3. Hand check\n    hand = game.get_hand(player)\n    if not hand.contains(card):\n        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n\n    # 4. Move card from hand to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    hand.remove(card)\n    stack_zone.add(card)\n\n    # Clear any stale colors_spent from a prior cast before new payment.\n    if hasattr(card, \"colors_spent\"):\n        del card.colors_spent\n\n    # 5. Choose targets\n    target_specs = card.get_targets(game)\n    chosen_targets: list[Any] = []\n    if target_specs:\n        for spec in target_specs:\n            target = player.choose_target(target_specs, spec)\n            filter_fn = getattr(spec, \"filter_fn\", None)\n            if filter_fn is not None and target is not None:\n                if not filter_fn(target):\n                    stack_zone.remove(card)\n                    hand.add(card)\n                    raise CastingError(\n                        f\"Cannot cast {card.name!r} — chosen target does not \"\n                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                    )\n            chosen_targets.append(target)\n\n    # 5b. Protection check\n    from engine.protection import has_protection_from\n\n    for target in chosen_targets:\n        if has_protection_from(target, card):\n            stack_zone.remove(card)\n            hand.add(card)\n            raise CastingError(\n                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n            )\n\n    # 6. Pay the alternative cost (rollback on failure)\n    if card.controller is None:\n        card.controller = player\n    if not player.mana_pool.can_pay(alt_cost):\n        stack_zone.remove(card)\n        hand.add(card)\n        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana for alt cost\")\n    player.mana_pool.pay(alt_cost)\n\n    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n    card.mana_spent = player.mana_pool.last_payment_total  # type: ignore[attr-defined]\n\n    # 7. on_cast hook\n    card.on_cast(game)\n\n    # 8. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,\n    )\n\n    def _on_resolve(g: GameState) -> None:","numLines":90,"startLine":275,"totalLines":648}}}
