             layer=Layer.POWER_TOUGHNESS,","+                    sublayer=SubLayer.MODIFY_PT,","+                    apply=_buff,","+                    duration=DURATION_END_OF_TURN,","+                )","+            )","+","+        controller = getattr(self, \"controller\", None) or game.active_player","+        game.trigger_manager.register(","+            TriggerRegistration(","+                event_type=SpellCastTriggeredEvent,","+                condition=_condition,","+                effect=_effect,","+                source=self,","+                controller=controller,","+            )","+        )"]}],"originalFile":"\"\"\"Card implementation for Great Hall of the Biblioplex.\"\"\"\n\nfrom __future__ import annotations\n\nfrom engine.card import CardImpl\n\nfrom typing import TYPE_CHECKING\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\nclass GreatHallOfTheBiblioplex(CardImpl):\n    \"\"\"TODO: Implement Great Hall of the Biblioplex.\"\"\"\n\n    pass\n","userModified":false}}
