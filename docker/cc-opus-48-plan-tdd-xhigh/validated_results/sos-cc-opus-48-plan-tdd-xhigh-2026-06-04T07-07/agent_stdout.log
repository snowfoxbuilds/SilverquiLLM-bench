{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YRTFfoKipTvq6Bq6MfA9TN","type":"tool_result","content":"179\tdef move_to_zone(\n180\t    game: GameState,\n181\t    card: Any,\n182\t    from_zone: Zone,\n183\t    to_zone: Zone,\n184\t    *,\n185\t    replacement_event: Any | None = None,\n186\t) -> None:\n187\t    \"\"\"High-level zone transition with trigger/replacement-effect hooks.\n188\t\n189\t    Centralises the bookkeeping that was previously duplicated across\n190\t    ``destroy()``, ``sacrifice()``, ``exile()``, ``create_token()``,\n191\t    ``_move_to_graveyard()`` (SBAs), and ``_resolve_spell()`` (casting).\n192\t\n193\t    Steps:\n194\t    1. Consult replacement effects for zone-change redirection (if\n195\t       *replacement_event* is supplied and the card is leaving the\n196\t       battlefield).  The replacement may change the destination zone\n197\t       (e.g. exile instead of graveyard) or set ``prevented = True`` to\n198\t       signal that it handled the zone move directly.\n199\t    2. Remove *card* from the source zone.\n200\t    3. Add *card* to the (possibly redirected) destination zone.\n201\t    4. If leaving the battlefield:\n202\t       a. Fire ``LeavesBattlefieldTriggeredEvent``.\n203\t       b. Fire ``CreatureDiesTriggeredEvent`` if the card is a creature\n204\t          **and** the final destination is the graveyard.\n205\t       c. Unregister triggers and replacement effects (fires happen\n206\t          **before** unregister so self-referencing triggers still match).\n207\t    5. If entering the battlefield:\n208\t       a. Register triggers (``register_triggers``) and replacement\n209\t          effects (``register_replacement_effects``).\n210\t       b. Fire ``EntersBattlefieldTriggeredEvent``.\n211\t\n212\t    Parameters:\n213\t        game: The current game state.\n214\t        card: The game object being moved.\n215\t        from_zone: The :class:`Zone` the card is currently in.\n216\t        to_zone: The intended destination :class:`Zone`.\n217\t        replacement_event: Optional typed replacement-event object\n218\t            (e.g. ``CreatureDiesReplacementEvent``).  When ``None``,\n219\t            no replacement effects are consulted (useful for simple\n220\t            moves like casting resolution or exile-from-graveyard).\n221\t    \"\"\"\n222\t    from engine.events import (\n223\t        CreatureDiesTriggeredEvent,\n224\t        EntersBattlefieldTriggeredEvent,\n225\t        LeavesBattlefieldTriggeredEvent,\n226\t    )\n227\t\n228\t    controller = getattr(card, \"controller\", None)\n229\t    owner = getattr(card, \"owner\", controller)\n230\t\n231\t    leaving_battlefield = from_zone == Zone.BATTLEFIELD\n232\t    entering_battlefield = to_zone == Zone.BATTLEFIELD\n233\t\n234\t    # --- Determine the source player for zone lookup ---\n235\t    # When leaving the battlefield, use the controller's zone.\n236\t    # For other zones (hand, graveyard, etc.), use the owner's zone.\n237\t    if leaving_battlefield:\n238\t        source_player = controller\n239\t    else:\n240\t        source_player = owner\n241\t\n242\t    # Fallback: search all players for the zone containing the card.\n243\t    # Also triggered when the inferred player's zone doesn't contain the card\n244\t    # (e.g. discarding a card that's in a different player's hand than its owner).\n245\t    if source_player is None or not source_player.zones[from_zone].contains(card):\n246\t        for player in game.players:\n247\t            if player.zones[from_zone].contains(card):\n248\t                source_player = player\n249\t                break\n250\t\n251\t    if source_player is None:\n252\t        return  # Card not found anywhere\n253\t\n254\t    source_container = source_player.zones[from_zone]\n255\t    if not source_container.contains(card):\n256\t        return  # Safety: card not in any player's zone\n257\t\n258\t    if owner is None:\n259\t        owner = source_player\n260\t\n261\t    # --- Replacement effects (zone-change redirection) ---\n262\t    dest_zone = to_zone\n263\t    if replacement_event is not None and leaving_battlefield:\n264\t        replacement_event = game.replacement_manager.apply(game, replacement_event)\n265\t        if getattr(replacement_event, \"prevented\", False):\n266\t            return\n267\t        destination_str = getattr(replacement_event, \"destination\", \"graveyard\")\n268\t        dest_zone = _DESTINATION_ZONE_MAP.get(destination_str, to_zone)"}]},"parent_tool_use_id":null,"session_id":"ccba73e9-54b6-4808-89ce-87e442914ff8","uuid":"b3c98873-8d8f-4804-a940-39f0b3a5ffec","timestamp":"2026-06-04T08:29:46.702Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/zones.py","content":"def move_to_zone(\n    game: GameState,\n    card: Any,\n    from_zone: Zone,\n    to_zone: Zone,\n    *,\n    replacement_event: Any | None = None,\n) -> None:\n    \"\"\"High-level zone transition with trigger/replacement-effect hooks.\n\n    Centralises the bookkeeping that was previously duplicated across\n    ``destroy()``, ``sacrifice()``, ``exile()``, ``create_token()``,\n    ``_move_to_graveyard()`` (SBAs), and ``_resolve_spell()`` (casting).\n\n    Steps:\n    1. Consult replacement effects for zone-change redirection (if\n       *replacement_event* is supplied and the card is leaving the\n       battlefield).  The replacement may change the destination zone\n       (e.g. exile instead of graveyard) or set ``prevented = True`` to\n       signal that it handled the zone move directly.\n    2. Remove *card* from the source zone.\n    3. Add *card* to the (possibly redirected) destination zone.\n    4. If leaving the battlefield:\n       a. Fire ``LeavesBattlefieldTriggeredEvent``.\n       b. Fire ``CreatureDiesTriggeredEvent`` if the card is a creature\n          **and** the final destination is the graveyard.\n       c. Unregister triggers and replacement effects (fires happen\n          **before** unregister so self-referencing triggers still match).\n    5. If entering the battlefield:\n       a. Register triggers (``register_triggers``) and replacement\n          effects (``register_replacement_effects``).\n       b. Fire ``EntersBattlefieldTriggeredEvent``.\n\n    Parameters:\n        game: The current game state.\n        card: The game object being moved.\n        from_zone: The :class:`Zone` the card is currently in.\n        to_zone: The intended destination :class:`Zone`.\n        replacement_event: Optional typed replacement-event object\n            (e.g. ``CreatureDiesReplacementEvent``).  When ``None``,\n            no replacement effects are consulted (useful for simple\n            moves like casting resolution or exile-from-graveyard).\n    \"\"\"\n    from engine.events import (\n        CreatureDiesTriggeredEvent,\n        EntersBattlefieldTriggeredEvent,\n        LeavesBattlefieldTriggeredEvent,\n    )\n\n    controller = getattr(card, \"controller\", None)\n    owner = getattr(card, \"owner\", controller)\n\n    leaving_battlefield = from_zone == Zone.BATTLEFIELD\n    entering_battlefield = to_zone == Zone.BATTLEFIELD\n\n    # --- Determine the source player for zone lookup ---\n    # When leaving the battlefield, use the controller's zone.\n    # For other zones (hand, graveyard, etc.), use the owner's zone.\n    if leaving_battlefield:\n        source_player = controller\n    else:\n        source_player = owner\n\n    # Fallback: search all players for the zone containing the card.\n    # Also triggered when the inferred player's zone doesn't contain the card\n    # (e.g. discarding a card that's in a different player's hand than its owner).\n    if source_player is None or not source_player.zones[from_zone].contains(card):\n        for player in game.players:\n            if player.zones[from_zone].contains(card):\n                source_player = player\n                break\n\n    if source_player is None:\n        return  # Card not found anywhere\n\n    source_container = source_player.zones[from_zone]\n    if not source_container.contains(card):\n        return  # Safety: card not in any player's zone\n\n    if owner is None:\n        owner = source_player\n\n    # --- Replacement effects (zone-change redirection) ---\n    dest_zone = to_zone\n    if replacement_event is not None and leaving_battlefield:\n        replacement_event = game.replacement_manager.apply(game, replacement_event)\n        if getattr(replacement_event, \"prevented\", False):\n            return\n        destination_str = getattr(replacement_event, \"destination\", \"graveyard\")\n        dest_zone = _DESTINATION_ZONE_MAP.get(destination_str, to_zone)","numLines":90,"startLine":179,"totalLines":327}}}
