fault(\"keywords\", Keyword.WARD)\n        kwargs.setdefault(\"base_power\", 5)\n        kwargs.setdefault(\"base_toughness\", 5)\n        kwargs.setdefault(\n            \"rules_text\",\n            \"This spell costs {1} less to cast for each instant and sorcery \"\n            \"card in your graveyard.\\nWard {2}\",\n        )\n        super().__init__(**kwargs)\n        self.ward_cost = ManaCost(generic=2)\n\n    def cost_reduction(self, game: \"GameState\") -> int:\n        \"\"\"Reduce cost by {1} for each instant/sorcery in graveyard.\"\"\"\n        controller = self.controller\n        if controller is None:\n            return 0\n        graveyard = controller.zones[Zone.GRAVEYARD]\n        count = 0\n        for card in graveyard.get_all():\n            card_types = getattr(card, \"card_types\", set())\n            if CardType.INSTANT in card_types or CardType.SORCERY in card_types:\n                count += 1\n        return count","is_error":false}]},"parent_tool_use_id":null,"session_id":"ccba73e9-54b6-4808-89ce-87e442914ff8","uuid":"15fe42ae-3a30-4558-9436-7ffd0f189d65","timestamp":"2026-06-04T07:49:06.777Z","tool_use_result":{"stdout":"{\n  \"name\": \"The Dawning Archaic\",\n  \"mana_cost\": \"{10}\",\n  \"type_line\": \"Legendary Creature — Avatar\",\n  \"oracle_text\": \"This spell costs {1} less to cast for each instant and sorcery card in your graveyard.\\nReach\\nWhenever The Dawning Archaic attacks, you may cast target instant or sorcery card from your graveyard without paying its mana cost. If that spell would be put into your graveyard, exile it instead.\",\n  \"power\": \"7\",\n  \"toughness\": \"7\",\n  \"loyalty\": null,\n  \"colors\": [],\n  \"keywords\": [\n    \"Reach\"\n  ],\n  \"rarity\": \"mythic\",\n  \"set_code\": \"sos\",\n  \"collector_number\": \"1\",\n  \"complexity_tier\": \"complex\"\n}\n===IMPL===\n\"\"\"Card implementation for The Dawning Archaic.\"\"\"\n\nfrom __future__ import annotations\n\nfrom engine.card import CardIm