{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011w7m69RgzbHaAbiqFzPePG","type":"tool_result","content":"300\t\n301\t    Raises:\n302\t        CastingError: If the card cannot be found in *from_zone* or\n303\t            legality checks fail.\n304\t    \"\"\"\n305\t    from engine.zones import move_to_zone\n306\t\n307\t    # Ensure controller is set\n308\t    card.controller = player\n309\t    if card.owner is None:\n310\t        card.owner = player\n311\t\n312\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n313\t    if not card.can_cast(game):\n314\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n315\t\n316\t    # 2. Locate card in source zone\n317\t    source_zone_container = player.zones[from_zone]\n318\t    if not source_zone_container.contains(card):\n319\t        # Try to find the card in any player's zone\n320\t        source_zone_container = None\n321\t        for p in game.players:\n322\t            z = p.zones[from_zone]\n323\t            if z.contains(card):\n324\t                source_zone_container = z\n325\t                break\n326\t\n327\t    if source_zone_container is None or not source_zone_container.contains(card):\n328\t        raise CastingError(\n329\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n330\t        )\n331\t\n332\t    # Move card from source zone to stack zone\n333\t    stack_zone = player.zones[Zone.STACK]\n334\t    source_zone_container.remove(card)\n335\t    stack_zone.add(card)\n336\t\n337\t    # 3. Choose targets (with rollback on failure)\n338\t    try:\n339\t        target_specs = card.get_targets(game)\n340\t        chosen_targets: list[Any] = []\n341\t        if target_specs:\n342\t            for spec in target_specs:\n343\t                target = player.choose_target(target_specs, spec)\n344\t                # Validate against filter_fn if the spec provides one\n345\t                filter_fn = getattr(spec, \"filter_fn\", None)\n346\t                if filter_fn is not None and target is not None:\n347\t                    if not filter_fn(target):\n348\t                        raise CastingError(\n349\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n350\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n351\t                        )\n352\t                chosen_targets.append(target)\n353\t\n354\t        # Protection check — reject targets that have protection from this spell\n355\t        from engine.protection import has_protection_from\n356\t\n357\t        for target in chosen_targets:\n358\t            if has_protection_from(target, card):\n359\t                raise CastingError(\n360\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n361\t                )\n362\t    except Exception as exc:\n363\t        # Rollback: move card from stack zone back to source zone\n364\t        stack_zone.remove(card)\n365\t        source_zone_container.add(card)\n366\t        raise CastingError(str(exc)) from exc\n367\t\n368\t    # 4. Call on_cast hook\n369\t    card.on_cast(game)\n370\t\n371\t    # 5. Build on_resolve callback and push StackObject\n372\t    stack_obj = StackObject(\n373\t        source=card,\n374\t        controller=player,\n375\t        targets=chosen_targets,\n376\t        on_resolve=lambda g: None,  # replaced below\n377\t    )\n378\t\n379\t    def _on_resolve(g: GameState) -> None:\n380\t        _resolve_spell(g, card, player, stack_obj)\n381\t\n382\t    stack_obj.on_resolve = _on_resolve\n383\t    game.stack.push(stack_obj)\n384\t\n385\t\n386\t# ------------------------------------------------------------------\n387\t# Resolution (called when the stack pops)\n388\t# ------------------------------------------------------------------\n389\t\n390\tdef _resolve_spell(\n391\t    game: GameState,\n392\t    card: CardImpl,\n393\t    player: Player,\n394\t    stack_obj: StackObject,\n395\t) -> None:\n396\t    \"\"\"Resolve *card* cast by *player*.\n397\t\n398\t    1. Call ``card.on_resolve(game, targets=targets)``.\n399\t    2. Remove the card from the stack zone.\n400\t    3. If the card is a permanent type, move it to the battlefield via\n401\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n402\t       registration and the ETB event).\n403\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n404\t    \"\"\"\n405\t    from engine.zones import move_to_zone\n406\t\n407\t    # Read targets from the StackObject — the single source of truth.\n408\t    # Set chosen_targets on the card just before resolution so that\n409\t    # _get_chosen_target helpers (which read via getattr) work."}]},"parent_tool_use_id":null,"session_id":"ccba73e9-54b6-4808-89ce-87e442914ff8","uuid":"aa17053e-73fa-432e-9021-3f905ca3ff85","timestamp":"2026-06-04T07:33:58.563Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"\n    Raises:\n        CastingError: If the card cannot be found in *from_zone* or\n            legality checks fail.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Ensure controller is set\n    card.controller = player\n    if card.owner is None:\n        card.owner = player\n\n    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 2. Locate card in source zone\n    source_zone_container = player.zones[from_zone]\n    if not source_zone_container.contains(card):\n        # Try to find the card in any player's zone\n        source_zone_container = None\n        for p in game.players:\n            z = p.zones[from_zone]\n            if z.contains(card):\n                source_zone_container = z\n                break\n\n    if source_zone_container is None or not source_zone_container.contains(card):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n        )\n\n    # Move card from source zone to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    source_zone_container.remove(card)\n    stack_zone.add(card)\n\n    # 3. Choose targets (with rollback on failure)\n    try:\n        target_specs = card.get_targets(game)\n        chosen_targets: list[Any] = []\n        if target_specs:\n            for spec in target_specs:\n                target = player.choose_target(target_specs, spec)\n                # Validate against filter_fn if the spec provides one\n                filter_fn = getattr(spec, \"filter_fn\", None)\n                if filter_fn is not None and target is not None:\n                    if not filter_fn(target):\n                        raise CastingError(\n                            f\"Cannot cast {card.name!r} — chosen target does not \"\n                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                        )\n                chosen_targets.append(target)\n\n        # Protection check — reject targets that have protection from this spell\n        from engine.protection import has_protection_from\n\n        for target in chosen_targets:\n            if has_protection_from(target, card):\n                raise CastingError(\n                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n                )\n    except Exception as exc:\n        # Rollback: move card from stack zone back to source zone\n        stack_zone.remove(card)\n        source_zone_container.add(card)\n        raise CastingError(str(exc)) from exc\n\n    # 4. Call on_cast hook\n    card.on_cast(game)\n\n    # 5. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n\n# ------------------------------------------------------------------\n# Resolution (called when the stack pops)\n# ------------------------------------------------------------------\n\ndef _resolve_spell(\n    game: GameState,\n    card: CardImpl,\n    player: Player,\n    stack_obj: StackObject,\n) -> None:\n    \"\"\"Resolve *card* cast by *player*.\n\n    1. Call ``card.on_resolve(game, targets=targets)``.\n    2. Remove the card from the stack zone.\n    3. If the card is a permanent type, move it to the battlefield via\n       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n       registration and the ETB event).\n    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Read targets from the StackObject — the single source of truth.\n    # Set chosen_targets on the card just before resolution so that\n    # _get_chosen_target helpers (which read via getattr) work.","numLines":110,"startLine":300,"totalLines":500}}}
