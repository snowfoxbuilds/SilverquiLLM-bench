{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E9hXTf95cHywKtqXJgZM1t","type":"tool_result","content":"120\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n121\t    new_generic = max(0, cost.generic - reduction)\n122\t    return ManaCost(\n123\t        generic=new_generic,\n124\t        pips=dict(cost.pips),\n125\t        x_count=cost.x_count,\n126\t        hybrid=list(cost.hybrid),\n127\t    )\n128\t\n129\t\n130\t# ------------------------------------------------------------------\n131\t# Cast spell\n132\t# ------------------------------------------------------------------\n133\t\n134\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n135\t    \"\"\"Cast *card* from *player*'s hand.\n136\t\n137\t    Pipeline\n138\t    --------\n139\t    1. **Timing check** — instants (and cards with flash) can be cast\n140\t       whenever the player has priority; everything else requires\n141\t       sorcery-speed timing.\n142\t    2. **can_cast** — ask the card whether it can legally be cast.\n143\t    3. **Hand check** — the card must be in the player's hand.\n144\t    4. **Move hand → stack zone** — remove the card from the hand and\n145\t       place it into the player's stack zone.\n146\t    5. **Choose targets** — if the card specifies targets (via\n147\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n148\t    6. **Mana check / payment** — the player's mana pool must be able to\n149\t       pay the card's mana cost.  If payment fails, the card is rolled\n150\t       back from the stack zone to the hand.\n151\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n152\t    8. **Push StackObject** — push a :class:`StackObject` whose\n153\t       ``on_resolve`` callback handles resolution.\n154\t\n155\t    Raises:\n156\t        CastingError: If any legality check fails.\n157\t    \"\"\"\n158\t    # 1. Timing\n159\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n160\t        raise CastingError(\n161\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n162\t        )\n163\t\n164\t    # 2. can_cast\n165\t    if not card.can_cast(game):\n166\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n167\t\n168\t    # 3. Hand check\n169\t    hand = game.get_hand(player)\n170\t    if not hand.contains(card):\n171\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n172\t\n173\t    # 4. Move card from hand to stack zone\n174\t    stack_zone = player.zones[Zone.STACK]\n175\t    hand.remove(card)\n176\t    stack_zone.add(card)\n177\t\n178\t    # Clear any stale colors_spent from a prior cast before new payment.\n179\t    if hasattr(card, \"colors_spent\"):\n180\t        del card.colors_spent\n181\t\n182\t    # 5. Choose targets\n183\t    target_specs = card.get_targets(game)\n184\t    chosen_targets: list[Any] = []\n185\t    if target_specs:\n186\t        for spec in target_specs:\n187\t            target = player.choose_target(target_specs, spec)\n188\t            # Validate against filter_fn if the spec provides one\n189\t            filter_fn = getattr(spec, \"filter_fn\", None)\n190\t            if filter_fn is not None and target is not None:\n191\t                if not filter_fn(target):\n192\t                    stack_zone.remove(card)\n193\t                    hand.add(card)\n194\t                    raise CastingError(\n195\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n196\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n197\t                    )\n198\t            chosen_targets.append(target)\n199\t\n200\t    # 5b. Protection check — reject targets that have protection from this\n201\t    #     spell (the T in DEBT).\n202\t    from engine.protection import has_protection_from\n203\t\n204\t    for target in chosen_targets:\n205\t        if has_protection_from(target, card):\n206\t            # Rollback: move card from stack zone back to hand\n207\t            stack_zone.remove(card)\n208\t            hand.add(card)\n209\t            raise CastingError(\n210\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n211\t            )\n212\t\n213\t    # Targets are stored on the StackObject (not the card) and passed\n214\t    # through the resolve pipeline via on_resolve(game, targets=...).\n215\t\n216\t    # 6. Mana check / payment (rollback on failure)\n217\t    # Ensure the card knows its controller so that cost_reduction() hooks\n218\t    # (e.g. Embercleave counting attacking creatures you control) see the\n219\t    # casting player, even for cards that were added to hand without an\n220\t    # explicit controller assignment.\n221\t    if card.controller is None:\n222\t        card.controller = player\n223\t    reduction = get_cost_reduction(game, card, player)\n224\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n225\t\n226\t    if not player.mana_pool.can_pay(effective_cost):\n227\t        # Rollback: move card from stack zone back to hand\n228\t        stack_zone.remove(card)\n229\t        hand.add(card)\n230\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n231\t\n232\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n233\t    player.mana_pool.pay(effective_cost)\n234\t\n235\t    # Store colors of mana spent on the card for mechanics like Converge\n236\t    # that care about the colors used to cast the spell.\n237\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n238\t\n239\t    # Store total amount of mana spent for mechanics that count it\n240\t    # (e.g. \"add mana equal to the amount of mana spent to cast that spell\").\n241\t    card.mana_spent = player.mana_pool.last_payment_total  # type: ignore[attr-defined]\n242\t\n243\t    # 7. Call on_cast hook\n244\t    card.on_cast(game)\n245\t\n246\t    # 8. Build on_resolve callback and push StackObject\n247\t    stack_obj = StackObject(\n248\t        source=card,\n249\t        controller=player,\n250\t        targets=chosen_targets,\n251\t        on_resolve=lambda g: None,  # replaced below\n252\t    )\n253\t\n254\t    def _on_resolve(g: GameState) -> None:\n255\t        _resolve_spell(g, card, player, stack_obj)\n256\t\n257\t    stack_obj.on_resolve = _on_resolve\n258\t    game.stack.push(stack_obj)\n259\t\n260\t    # Fire the \"whenever a player casts a spell\" trigger.\n261\t    from engine.events import SpellCastTriggeredEvent\n262\t    game.trigger_manager.fire_event(\n263\t        game,\n264\t        SpellCastTriggeredEvent(\n265\t            spell=stack_obj, player=player, card=card, controller=player\n266\t        ),\n267\t    )\n268\t\n269\t\n270\t# ------------------------------------------------------------------\n271\t# Cast spell for an alternative cost (e.g. miracle)\n272\t# ------------------------------------------------------------------\n273\t\n274\t\n275\tdef cast_with_alternative_cost(\n276\t    game: GameState, player: Player, card: CardImpl, alt_cost: ManaCost\n277\t) -> None:\n278\t    \"\"\"Cast *card* from *player*'s hand paying *alt_cost* instead of its mana cost.\n279\t"}]},"parent_tool_use_id":null,"session_id":"ccba73e9-54b6-4808-89ce-87e442914ff8","uuid":"b303f6e5-0ced-4f5e-8ce1-cba0582311fd","timestamp":"2026-06-04T08:38:03.027Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n    new_generic = max(0, cost.generic - reduction)\n    return ManaCost(\n        generic=new_generic,\n        pips=dict(cost.pips),\n        x_count=cost.x_count,\n        hybrid=list(cost.hybrid),\n    )\n\n\n# ------------------------------------------------------------------\n# Cast spell\n# ------------------------------------------------------------------\n\ndef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n    \"\"\"Cast *card* from *player*'s hand.\n\n    Pipeline\n    --------\n    1. **Timing check** — instants (and cards with flash) can be cast\n       whenever the player has priority; everything else requires\n       sorcery-speed timing.\n    2. **can_cast** — ask the card whether it can legally be cast.\n    3. **Hand check** — the card must be in the player's hand.\n    4. **Move hand → stack zone** — remove the card from the hand and\n       place it into the player's stack zone.\n    5. **Choose targets** — if the card specifies targets (via\n       :meth:`CardImpl.get_targets`), the player is asked to choose.\n    6. **Mana check / payment** — the player's mana pool must be able to\n       pay the card's mana cost.  If payment fails, the card is rolled\n       back from the stack zone to the hand.\n    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n    8. **Push StackObject** — push a :class:`StackObject` whose\n       ``on_resolve`` callback handles resolution.\n\n    Raises:\n        CastingError: If any legality check fails.\n    \"\"\"\n    # 1. Timing\n    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n        )\n\n    # 2. can_cast\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 3. Hand check\n    hand = game.get_hand(player)\n    if not hand.contains(card):\n        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n\n    # 4. Move card from hand to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    hand.remove(card)\n    stack_zone.add(card)\n\n    # Clear any stale colors_spent from a prior cast before new payment.\n    if hasattr(card, \"colors_spent\"):\n        del card.colors_spent\n\n    # 5. Choose targets\n    target_specs = card.get_targets(game)\n    chosen_targets: list[Any] = []\n    if target_specs:\n        for spec in target_specs:\n            target = player.choose_target(target_specs, spec)\n            # Validate against filter_fn if the spec provides one\n            filter_fn = getattr(spec, \"filter_fn\", None)\n            if filter_fn is not None and target is not None:\n                if not filter_fn(target):\n                    stack_zone.remove(card)\n                    hand.add(card)\n                    raise CastingError(\n                        f\"Cannot cast {card.name!r} — chosen target does not \"\n                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                    )\n            chosen_targets.append(target)\n\n    # 5b. Protection check — reject targets that have protection from this\n    #     spell (the T in DEBT).\n    from engine.protection import has_protection_from\n\n    for target in chosen_targets:\n        if has_protection_from(target, card):\n            # Rollback: move card from stack zone back to hand\n            stack_zone.remove(card)\n            hand.add(card)\n            raise CastingError(\n                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n            )\n\n    # Targets are stored on the StackObject (not the card) and passed\n    # through the resolve pipeline via on_resolve(game, targets=...).\n\n    # 6. Mana check / payment (rollback on failure)\n    # Ensure the card knows its controller so that cost_reduction() hooks\n    # (e.g. Embercleave counting attacking creatures you control) see the\n    # casting player, even for cards that were added to hand without an\n    # explicit controller assignment.\n    if card.controller is None:\n        card.controller = player\n    reduction = get_cost_reduction(game, card, player)\n    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n\n    if not player.mana_pool.can_pay(effective_cost):\n        # Rollback: move card from stack zone back to hand\n        stack_zone.remove(card)\n        hand.add(card)\n        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n\n    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n    player.mana_pool.pay(effective_cost)\n\n    # Store colors of mana spent on the card for mechanics like Converge\n    # that care about the colors used to cast the spell.\n    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n\n    # Store total amount of mana spent for mechanics that count it\n    # (e.g. \"add mana equal to the amount of mana spent to cast that spell\").\n    card.mana_spent = player.mana_pool.last_payment_total  # type: ignore[attr-defined]\n\n    # 7. Call on_cast hook\n    card.on_cast(game)\n\n    # 8. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n    # Fire the \"whenever a player casts a spell\" trigger.\n    from engine.events import SpellCastTriggeredEvent\n    game.trigger_manager.fire_event(\n        game,\n        SpellCastTriggeredEvent(\n            spell=stack_obj, player=player, card=card, controller=player\n        ),\n    )\n\n\n# ------------------------------------------------------------------\n# Cast spell for an alternative cost (e.g. miracle)\n# ------------------------------------------------------------------\n\n\ndef cast_with_alternative_cost(\n    game: GameState, player: Player, card: CardImpl, alt_cost: ManaCost\n) -> None:\n    \"\"\"Cast *card* from *player*'s hand paying *alt_cost* instead of its mana cost.\n","numLines":160,"startLine":120,"totalLines":648}}}
