{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JwD8LN2Bvw1tfW3wvANaNp","type":"tool_result","content":"1\t\"\"\"Card registry and metadata for mapping card names to implementations.\n2\t\n3\tProvides:\n4\t- ``CardMetadata`` — dataclass holding Scryfall-sourced card data.\n5\t- ``CardRegistry`` — maps card names to ``(impl_class, metadata)`` pairs.\n6\t- ``default_registry`` — module-level singleton registry instance.\n7\t\"\"\"\n8\t\n9\tfrom __future__ import annotations\n10\t\n11\tfrom dataclasses import dataclass, field\n12\tfrom typing import TYPE_CHECKING, Any\n13\t\n14\tfrom engine.card import CardImpl\n15\t\n16\tif TYPE_CHECKING:\n17\t    from engine.player import Player\n18\t\n19\t\n20\t@dataclass\n21\tclass CardMetadata:\n22\t    \"\"\"Card metadata sourced from Scryfall or similar data providers.\n23\t\n24\t    Attributes:\n25\t        name: Card name (e.g. ``\"Lightning Bolt\"``).\n26\t        mana_cost_str: Raw mana cost string (e.g. ``\"{R}\"``).\n27\t        type_line: Full type line (e.g. ``\"Instant\"``).\n28\t        oracle_text: Oracle rules text.\n29\t        power: Power as a string (``None`` for non-creatures).\n30\t        toughness: Toughness as a string (``None`` for non-creatures).\n31\t        colors: List of color letters (e.g. ``[\"R\"]``).\n32\t        keywords: List of keyword ability strings (e.g. ``[\"Flying\", \"Haste\"]``).\n33\t        rarity: Rarity string (e.g. ``\"common\"``, ``\"rare\"``).\n34\t        set_code: Set code (e.g. ``\"fdn\"``).\n35\t        collector_number: Collector number within the set.\n36\t    \"\"\"\n37\t\n38\t    name: str = \"\"\n39\t    mana_cost_str: str = \"\"\n40\t    type_line: str = \"\"\n41\t    oracle_text: str = \"\"\n42\t    power: str | None = None\n43\t    toughness: str | None = None\n44\t    colors: list[str] = field(default_factory=list)\n45\t    keywords: list[str] = field(default_factory=list)\n46\t    rarity: str = \"\"\n47\t    set_code: str = \"\"\n48\t    collector_number: str = \"\"\n49\t\n50\t\n51\tclass CardRegistry:\n52\t    \"\"\"Registry mapping card names to implementation classes and metadata.\n53\t\n54\t    Supports registering, looking up, creating instances, and listing cards.\n55\t    \"\"\"\n56\t\n57\t    def __init__(self) -> None:\n58\t        self._entries: dict[str, tuple[type[CardImpl], CardMetadata]] = {}\n59\t\n60\t    def register(\n61\t        self,\n62\t        name: str,\n63\t        impl_class: type[CardImpl],\n64\t        metadata: CardMetadata | None = None,\n65\t    ) -> None:\n66\t        \"\"\"Register a card implementation with optional metadata.\n67\t\n68\t        Args:\n69\t            name: The card name (case-sensitive).\n70\t            impl_class: The :class:`~engine.card.CardImpl` subclass for\n71\t                this card.\n72\t            metadata: Optional :class:`CardMetadata` for the card.  If\n73\t                ``None``, a default ``CardMetadata(name=name)`` is stored.\n74\t        \"\"\"\n75\t        if metadata is None:\n76\t            metadata = CardMetadata(name=name)\n77\t        self._entries[name] = (impl_class, metadata)\n78\t\n79\t    def get(self, name: str) -> tuple[type[CardImpl], CardMetadata]:\n80\t        \"\"\"Look up a card by name.\n81\t\n82\t        Args:\n83\t            name: The card name.\n84\t\n85\t        Returns:\n86\t            A ``(impl_class, metadata)`` tuple.\n87\t\n88\t        Raises:\n89\t            KeyError: If *name* is not registered.\n90\t        \"\"\"\n91\t        if name not in self._entries:\n92\t            raise KeyError(f\"Card not registered: {name!r}\")\n93\t        return self._entries[name]\n94\t\n95\t    def create_instance(self, name: str, owner: Player | None = None) -> CardImpl:\n96\t        \"\"\"Create a new card instance from the registry.\n97\t\n98\t        Args:\n99\t            name: The card name.\n100\t            owner: The player who owns the card.\n101\t\n102\t        Returns:\n103\t            A new :class:`~engine.card.CardImpl` instance.\n104\t\n105\t        Raises:\n106\t            KeyError: If *name* is not registered.\n107\t        \"\"\"\n108\t        impl_class, _metadata = self.get(name)\n109\t        return impl_class(name=name, owner=owner)\n110\t\n111\t    def list_all(self) -> list[str]:\n112\t        \"\"\"Return a sorted list of all registered card names.\"\"\"\n113\t        return sorted(self._entries.keys())\n114\t\n115\t    def __contains__(self, name: str) -> bool:\n116\t        \"\"\"Return ``True`` if *name* is registered.\"\"\"\n117\t        return name in self._entries\n118\t\n119\t    def __len__(self) -> int:\n120\t        \"\"\"Return the number of registered cards.\"\"\"\n121\t        return len(self._entries)\n122\t\n123\t\n124\t# Module-level default registry instance.\n125\tdefault_registry: CardRegistry = CardRegistry()\n126\t"}]},"parent_tool_use_id":null,"session_id":"ccba73e9-54b6-4808-89ce-87e442914ff8","uuid":"590c01c3-d622-46c5-98c2-d7c5d091af6a","timestamp":"2026-06-04T08:08:23.604Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/registry.py","content":"\"\"\"Card registry and metadata for mapping card names to implementations.\n\nProvides:\n- ``CardMetadata`` — dataclass holding Scryfall-sourced card data.\n- ``CardRegistry`` — maps card names to ``(impl_class, metadata)`` pairs.\n- ``default_registry`` — module-level singleton registry instance.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import CardImpl\n\nif TYPE_CHECKING:\n    from engine.player import Player\n\n\n@dataclass\nclass CardMetadata:\n    \"\"\"Card metadata sourced from Scryfall or similar data providers.\n\n    Attributes:\n        name: Card name (e.g. ``\"Lightning Bolt\"``).\n        mana_cost_str: Raw mana cost string (e.g. ``\"{R}\"``).\n        type_line: Full type line (e.g. ``\"Instant\"``).\n        oracle_text: Oracle rules text.\n        power: Power as a string (``None`` for non-creatures).\n        toughness: Toughness as a string (``None`` for non-creatures).\n        colors: List of color letters (e.g. ``[\"R\"]``).\n        keywords: List of keyword ability strings (e.g. ``[\"Flying\", \"Haste\"]``).\n        rarity: Rarity string (e.g. ``\"common\"``, ``\"rare\"``).\n        set_code: Set code (e.g. ``\"fdn\"``).\n        collector_number: Collector number within the set.\n    \"\"\"\n\n    name: str = \"\"\n    mana_cost_str: str = \"\"\n    type_line: str = \"\"\n    oracle_text: str = \"\"\n    power: str | None = None\n    toughness: str | None = None\n    colors: list[str] = field(default_factory=list)\n    keywords: list[str] = field(default_factory=list)\n    rarity: str = \"\"\n    set_code: str = \"\"\n    collector_number: str = \"\"\n\n\nclass CardRegistry:\n    \"\"\"Registry mapping card names to implementation classes and metadata.\n\n    Supports registering, looking up, creating instances, and listing cards.\n    \"\"\"\n\n    def __init__(self) -> None:\n        self._entries: dict[str, tuple[type[CardImpl], CardMetadata]] = {}\n\n    def register(\n        self,\n        name: str,\n        impl_class: type[CardImpl],\n        metadata: CardMetadata | None = None,\n    ) -> None:\n        \"\"\"Register a card implementation with optional metadata.\n\n        Args:\n            name: The card name (case-sensitive).\n            impl_class: The :class:`~engine.card.CardImpl` subclass for\n                this card.\n            metadata: Optional :class:`CardMetadata` for the card.  If\n                ``None``, a default ``CardMetadata(name=name)`` is stored.\n        \"\"\"\n        if metadata is None:\n            metadata = CardMetadata(name=name)\n        self._entries[name] = (impl_class, metadata)\n\n    def get(self, name: str) -> tuple[type[CardImpl], CardMetadata]:\n        \"\"\"Look up a card by name.\n\n        Args:\n            name: The card name.\n\n        Returns:\n            A ``(impl_class, metadata)`` tuple.\n\n        Raises:\n            KeyError: If *name* is not registered.\n        \"\"\"\n        if name not in self._entries:\n            raise KeyError(f\"Card not registered: {name!r}\")\n        return self._entries[name]\n\n    def create_instance(self, name: str, owner: Player | None = None) -> CardImpl:\n        \"\"\"Create a new card instance from the registry.\n\n        Args:\n            name: The card name.\n            owner: The player who owns the card.\n\n        Returns:\n            A new :class:`~engine.card.CardImpl` instance.\n\n        Raises:\n            KeyError: If *name* is not registered.\n        \"\"\"\n        impl_class, _metadata = self.get(name)\n        return impl_class(name=name, owner=owner)\n\n    def list_all(self) -> list[str]:\n        \"\"\"Return a sorted list of all registered card names.\"\"\"\n        return sorted(self._entries.keys())\n\n    def __contains__(self, name: str) -> bool:\n        \"\"\"Return ``True`` if *name* is registered.\"\"\"\n        return name in self._entries\n\n    def __len__(self) -> int:\n        \"\"\"Return the number of registered cards.\"\"\"\n        return len(self._entries)\n\n\n# Module-level default registry instance.\ndefault_registry: CardRegistry = CardRegistry()\n","numLines":126,"startLine":1,"totalLines":126}}}
