{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WJBcbfvfpEammcKW9YCQQ9","type":"tool_result","content":"130\t# ---------------------------------------------------------------------------\n131\t\n132\t@dataclass\n133\tclass ReplacementEvent:\n134\t    \"\"\"Base class for all replacement-effect events.\"\"\"\n135\t\n136\t\n137\t@dataclass\n138\tclass MoveToGraveyardReplacementEvent(ReplacementEvent):\n139\t    \"\"\"Any permanent moving to a graveyard.\n140\t\n141\t    Subclass this for specific causes (destruction, sacrifice, etc.).\n142\t    A replacement registered for this type also fires for all subtypes.\n143\t\n144\t    ``destination`` may be mutated by a replacement to redirect the\n145\t    permanent to a different zone (``\"exile\"``, ``\"library\"``, ``\"hand\"``).\n146\t    Set ``prevented = True`` to signal that the replacement handled the\n147\t    zone move itself and the engine should skip its own move.\n148\t    \"\"\"\n149\t\n150\t    destination: str = \"graveyard\"\n151\t    controller: Any = None\n152\t    owner: Any = None\n153\t    prevented: bool = False\n154\t\n155\t    @property\n156\t    def card(self) -> Any:\n157\t        \"\"\"The object moving to the graveyard (overridden by subclasses).\"\"\"\n158\t        return None\n159\t\n160\t\n161\t@dataclass\n162\tclass CreatureDiesReplacementEvent(MoveToGraveyardReplacementEvent):\n163\t    \"\"\"A creature going to the graveyard via destruction or lethal damage.\"\"\"\n164\t\n165\t    creature: Any = None\n166\t\n167\t    @property\n168\t    def card(self) -> Any:\n169\t        return self.creature\n170\t\n171\t\n172\t@dataclass\n173\tclass PermanentDestroyedReplacementEvent(MoveToGraveyardReplacementEvent):\n174\t    \"\"\"A non-creature permanent going to the graveyard via destruction.\"\"\"\n175\t\n176\t    permanent: Any = None\n177\t\n178\t    @property\n179\t    def card(self) -> Any:\n180\t        return self.permanent\n181\t\n182\t\n183\t@dataclass\n184\tclass SacrificeReplacementEvent(MoveToGraveyardReplacementEvent):\n185\t    \"\"\"A permanent going to the graveyard via sacrifice.\"\"\"\n186\t\n187\t    permanent: Any = None\n188\t\n189\t    @property\n190\t    def card(self) -> Any:\n191\t        return self.permanent\n192\t\n193\t\n194\t@dataclass\n195\tclass SpellToGraveyardReplacementEvent(MoveToGraveyardReplacementEvent):\n196\t    \"\"\"An instant/sorcery spell about to be put into a graveyard on resolution.\n197\t\n198\t    Fired by ``_resolve_spell`` so that \"if that spell would be put into your\n199\t    graveyard, exile it instead\"-style effects can redirect the resolving\n200\t    spell.  A replacement registered for the parent\n201\t    ``MoveToGraveyardReplacementEvent`` also matches this subtype.\n202\t    \"\"\"\n203\t\n204\t    spell: Any = None\n205\t\n206\t    @property\n207\t    def card(self) -> Any:\n208\t        return self.spell\n209\t"}]},"parent_tool_use_id":null,"session_id":"ccba73e9-54b6-4808-89ce-87e442914ff8","uuid":"f944f580-720f-4b8d-91ae-ca8971d4a8e5","timestamp":"2026-06-04T08:36:22.584Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/events.py","content":"# ---------------------------------------------------------------------------\n\n@dataclass\nclass ReplacementEvent:\n    \"\"\"Base class for all replacement-effect events.\"\"\"\n\n\n@dataclass\nclass MoveToGraveyardReplacementEvent(ReplacementEvent):\n    \"\"\"Any permanent moving to a graveyard.\n\n    Subclass this for specific causes (destruction, sacrifice, etc.).\n    A replacement registered for this type also fires for all subtypes.\n\n    ``destination`` may be mutated by a replacement to redirect the\n    permanent to a different zone (``\"exile\"``, ``\"library\"``, ``\"hand\"``).\n    Set ``prevented = True`` to signal that the replacement handled the\n    zone move itself and the engine should skip its own move.\n    \"\"\"\n\n    destination: str = \"graveyard\"\n    controller: Any = None\n    owner: Any = None\n    prevented: bool = False\n\n    @property\n    def card(self) -> Any:\n        \"\"\"The object moving to the graveyard (overridden by subclasses).\"\"\"\n        return None\n\n\n@dataclass\nclass CreatureDiesReplacementEvent(MoveToGraveyardReplacementEvent):\n    \"\"\"A creature going to the graveyard via destruction or lethal damage.\"\"\"\n\n    creature: Any = None\n\n    @property\n    def card(self) -> Any:\n        return self.creature\n\n\n@dataclass\nclass PermanentDestroyedReplacementEvent(MoveToGraveyardReplacementEvent):\n    \"\"\"A non-creature permanent going to the graveyard via destruction.\"\"\"\n\n    permanent: Any = None\n\n    @property\n    def card(self) -> Any:\n        return self.permanent\n\n\n@dataclass\nclass SacrificeReplacementEvent(MoveToGraveyardReplacementEvent):\n    \"\"\"A permanent going to the graveyard via sacrifice.\"\"\"\n\n    permanent: Any = None\n\n    @property\n    def card(self) -> Any:\n        return self.permanent\n\n\n@dataclass\nclass SpellToGraveyardReplacementEvent(MoveToGraveyardReplacementEvent):\n    \"\"\"An instant/sorcery spell about to be put into a graveyard on resolution.\n\n    Fired by ``_resolve_spell`` so that \"if that spell would be put into your\n    graveyard, exile it instead\"-style effects can redirect the resolving\n    spell.  A replacement registered for the parent\n    ``MoveToGraveyardReplacementEvent`` also matches this subtype.\n    \"\"\"\n\n    spell: Any = None\n\n    @property\n    def card(self) -> Any:\n        return self.spell\n","numLines":80,"startLine":130,"totalLines":225}}}
