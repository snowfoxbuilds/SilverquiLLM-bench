{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W9moYKrM4bpDyHQpX9jwns","type":"tool_result","content":"1\t\"\"\"Reference test for FDN 244 — Progenitus.\n2\t\n3\tIllustrative test covering **replacement effects** via\n4\t``game.replacement_manager.register()``. Progenitus has a continuous\n5\treplacement that intercepts any ``MoveToGraveyardReplacementEvent``\n6\ttargeting itself and redirects the card to its owner's library instead\n7\tof the graveyard. The replacement callback sets ``event.prevented`` to\n8\tsignal that the engine should skip its own zone move, and returns the\n9\tmodified event.\n10\t\"\"\"\n11\t\n12\tfrom __future__ import annotations\n13\t\n14\tfrom cards.fdn.fdn_244.card_impl import Progenitus\n15\tfrom engine.card import Creature\n16\tfrom engine.events import (\n17\t    CreatureDiesReplacementEvent,\n18\t    MoveToGraveyardReplacementEvent,\n19\t)\n20\tfrom engine.replacement_effects import ReplacementEffect\n21\tfrom engine.types import ManaCost, Supertype, Zone\n22\tfrom test_utils import create_game\n23\t\n24\t\n25\tclass TestProgenitusProperties:\n26\t    \"\"\"Static card data should match the FDN 244 spec.\"\"\"\n27\t\n28\t    def test_name(self) -> None:\n29\t        assert Progenitus(owner=None).name == \"Progenitus\"\n30\t\n31\t    def test_mana_cost(self) -> None:\n32\t        cost = ManaCost.parse(\"{W}{W}{U}{U}{B}{B}{R}{R}{G}{G}\")\n33\t        assert Progenitus(owner=None).mana_cost == cost\n34\t\n35\t    def test_legendary_hydra_avatar(self) -> None:\n36\t        card = Progenitus(owner=None)\n37\t        assert Supertype.LEGENDARY in card.supertypes\n38\t        assert {\"Hydra\", \"Avatar\"} <= card.subtypes\n39\t\n40\t\n41\tclass TestProgenitusReplacementRegistration:\n42\t    \"\"\"register_replacement_effects must wire a ReplacementEffect for\n43\t    MoveToGraveyardReplacementEvent through the replacement_manager.\"\"\"\n44\t\n45\t    def test_registers_one_replacement_effect(self) -> None:\n46\t        game = create_game()\n47\t        p1 = game.players[0]\n48\t        card = Progenitus(owner=p1, controller=p1)\n49\t        before = len(game.replacement_manager._effects)\n50\t        card.register_replacement_effects(game)\n51\t        after = len(game.replacement_manager._effects)\n52\t        assert after - before == 1\n53\t\n54\t    def test_registered_replacement_uses_typed_event_class(self) -> None:\n55\t        \"\"\"The registered ReplacementEffect must use the typed\n56\t        MoveToGraveyardReplacementEvent class, not a string event name.\"\"\"\n57\t        game = create_game()\n58\t        p1 = game.players[0]\n59\t        card = Progenitus(owner=p1, controller=p1)\n60\t        card.register_replacement_effects(game)\n61\t        registered = next(\n62\t            (e for e in game.replacement_manager._effects if e.source is card),\n63\t            None,\n64\t        )\n65\t        assert registered is not None\n66\t        assert isinstance(registered, ReplacementEffect)\n67\t        assert registered.event_type is MoveToGraveyardReplacementEvent\n68\t\n69\t\n70\tclass TestProgenitusGraveyardReplacement:\n71\t    \"\"\"The replacement callback shuffles the card into its owner's\n72\t    library and prevents the move to graveyard.\"\"\"\n73\t\n74\t    def test_replacement_redirects_to_library_and_prevents(self) -> None:\n75\t        game = create_game()\n76\t        p1 = game.players[0]\n77\t        card = Progenitus(owner=p1, controller=p1)\n78\t        card.register_replacement_effects(game)\n79\t        # Use the creature-dies subclass so the event's ``card`` property\n80\t        # resolves to this Progenitus instance (the base class's ``card``\n81\t        # property returns None).\n82\t        event = CreatureDiesReplacementEvent(\n83\t            creature=card,\n84\t            destination=\"graveyard\",\n85\t            controller=p1,\n86\t            owner=p1,\n87\t        )\n88\t        result = game.replacement_manager.apply(game, event)\n89\t        # Replacement callback should return the event with prevented=True\n90\t        # and shuffle the card into the library.\n91\t        assert result.prevented is True\n92\t        library = p1.zones[Zone.LIBRARY]\n93\t        assert library.contains(card)\n94\t\n95\t\n96\t"}]},"parent_tool_use_id":null,"session_id":"ccba73e9-54b6-4808-89ce-87e442914ff8","uuid":"f13334a9-6bfc-48b4-bc78-61845e26d577","timestamp":"2026-06-04T07:30:05.184Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_244/tests.py","content":"\"\"\"Reference test for FDN 244 — Progenitus.\n\nIllustrative test covering **replacement effects** via\n``game.replacement_manager.register()``. Progenitus has a continuous\nreplacement that intercepts any ``MoveToGraveyardReplacementEvent``\ntargeting itself and redirects the card to its owner's library instead\nof the graveyard. The replacement callback sets ``event.prevented`` to\nsignal that the engine should skip its own zone move, and returns the\nmodified event.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom cards.fdn.fdn_244.card_impl import Progenitus\nfrom engine.card import Creature\nfrom engine.events import (\n    CreatureDiesReplacementEvent,\n    MoveToGraveyardReplacementEvent,\n)\nfrom engine.replacement_effects import ReplacementEffect\nfrom engine.types import ManaCost, Supertype, Zone\nfrom test_utils import create_game\n\n\nclass TestProgenitusProperties:\n    \"\"\"Static card data should match the FDN 244 spec.\"\"\"\n\n    def test_name(self) -> None:\n        assert Progenitus(owner=None).name == \"Progenitus\"\n\n    def test_mana_cost(self) -> None:\n        cost = ManaCost.parse(\"{W}{W}{U}{U}{B}{B}{R}{R}{G}{G}\")\n        assert Progenitus(owner=None).mana_cost == cost\n\n    def test_legendary_hydra_avatar(self) -> None:\n        card = Progenitus(owner=None)\n        assert Supertype.LEGENDARY in card.supertypes\n        assert {\"Hydra\", \"Avatar\"} <= card.subtypes\n\n\nclass TestProgenitusReplacementRegistration:\n    \"\"\"register_replacement_effects must wire a ReplacementEffect for\n    MoveToGraveyardReplacementEvent through the replacement_manager.\"\"\"\n\n    def test_registers_one_replacement_effect(self) -> None:\n        game = create_game()\n        p1 = game.players[0]\n        card = Progenitus(owner=p1, controller=p1)\n        before = len(game.replacement_manager._effects)\n        card.register_replacement_effects(game)\n        after = len(game.replacement_manager._effects)\n        assert after - before == 1\n\n    def test_registered_replacement_uses_typed_event_class(self) -> None:\n        \"\"\"The registered ReplacementEffect must use the typed\n        MoveToGraveyardReplacementEvent class, not a string event name.\"\"\"\n        game = create_game()\n        p1 = game.players[0]\n        card = Progenitus(owner=p1, controller=p1)\n        card.register_replacement_effects(game)\n        registered = next(\n            (e for e in game.replacement_manager._effects if e.source is card),\n            None,\n        )\n        assert registered is not None\n        assert isinstance(registered, ReplacementEffect)\n        assert registered.event_type is MoveToGraveyardReplacementEvent\n\n\nclass TestProgenitusGraveyardReplacement:\n    \"\"\"The replacement callback shuffles the card into its owner's\n    library and prevents the move to graveyard.\"\"\"\n\n    def test_replacement_redirects_to_library_and_prevents(self) -> None:\n        game = create_game()\n        p1 = game.players[0]\n        card = Progenitus(owner=p1, controller=p1)\n        card.register_replacement_effects(game)\n        # Use the creature-dies subclass so the event's ``card`` property\n        # resolves to this Progenitus instance (the base class's ``card``\n        # property returns None).\n        event = CreatureDiesReplacementEvent(\n            creature=card,\n            destination=\"graveyard\",\n            controller=p1,\n            owner=p1,\n        )\n        result = game.replacement_manager.apply(game, event)\n        # Replacement callback should return the event with prevented=True\n        # and shuffle the card into the library.\n        assert result.prevented is True\n        library = p1.zones[Zone.LIBRARY]\n        assert library.contains(card)\n\n\n","numLines":96,"startLine":1,"totalLines":96}}}
