{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QGwHG5GF1hVzzPFEUgL3Vc","type":"tool_result","content":"500\t    stack_obj.on_resolve = _on_resolve\n501\t    game.stack.push(stack_obj)\n502\t\n503\t    # Fire the \"whenever a player casts a spell\" trigger.\n504\t    from engine.events import SpellCastTriggeredEvent\n505\t    game.trigger_manager.fire_event(\n506\t        game,\n507\t        SpellCastTriggeredEvent(\n508\t            spell=stack_obj, player=player, card=card, controller=player\n509\t        ),\n510\t    )\n511\t\n512\t\n513\t# ------------------------------------------------------------------\n514\t# Resolution (called when the stack pops)\n515\t# ------------------------------------------------------------------\n516\t\n517\tdef _resolve_spell(\n518\t    game: GameState,\n519\t    card: CardImpl,\n520\t    player: Player,\n521\t    stack_obj: StackObject,\n522\t) -> None:\n523\t    \"\"\"Resolve *card* cast by *player*.\n524\t\n525\t    1. Call ``card.on_resolve(game, targets=targets)``.\n526\t    2. Remove the card from the stack zone.\n527\t    3. If the card is a permanent type, move it to the battlefield via\n528\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n529\t       registration and the ETB event).\n530\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n531\t    \"\"\"\n532\t    from engine.zones import move_to_zone\n533\t\n534\t    # Read targets from the StackObject — the single source of truth.\n535\t    # Set chosen_targets on the card just before resolution so that\n536\t    # _get_chosen_target helpers (which read via getattr) work.\n537\t    targets = stack_obj.targets\n538\t    if targets is not None:\n539\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n540\t\n541\t    card.on_resolve(game)\n542\t\n543\t    if card.card_types & _PERMANENT_TYPES:\n544\t        # Move from stack to battlefield via move_to_zone, which handles\n545\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n546\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n547\t    else:\n548\t        # Instant/sorcery: consult replacement effects (\"if that spell would\n549\t        # be put into your graveyard, exile it instead\") before moving the\n550\t        # card off the stack.  With no replacement registered this is a no-op\n551\t        # and the spell goes to the graveyard as before.\n552\t        from engine.events import SpellToGraveyardReplacementEvent\n553\t        from engine.zones import _DESTINATION_ZONE_MAP\n554\t\n555\t        owner = getattr(card, \"owner\", None) or player\n556\t        repl = game.replacement_manager.apply(\n557\t            game,\n558\t            SpellToGraveyardReplacementEvent(\n559\t                spell=card, controller=player, owner=owner\n560\t            ),\n561\t        )\n562\t        if getattr(repl, \"prevented\", False):\n563\t            stack_container = owner.zones[Zone.STACK]\n564\t            if stack_container.contains(card):\n565\t                stack_container.remove(card)\n566\t            return\n567\t        dest = _DESTINATION_ZONE_MAP.get(\n568\t            getattr(repl, \"destination\", \"graveyard\"), Zone.GRAVEYARD\n569\t        )\n570\t        move_to_zone(game, card, Zone.STACK, dest)\n571\t\n572\t\n573\t# ------------------------------------------------------------------\n574\t# Play land (special action — does not use the stack)\n575\t# ------------------------------------------------------------------\n576\t\n577\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n578\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n579\t\n580\t    Requirements (all must hold):\n581\t\n582\t    * *land_card* has :attr:`CardType.LAND`.\n583\t    * *player* is the active player.\n584\t    * Current phase is a main phase.\n585\t    * The stack is empty.\n586\t    * ``player.land_plays_remaining > 0``.\n587\t    * The card is in the player's hand.\n588\t\n589\t    On success the card moves from hand to battlefield and"}]},"parent_tool_use_id":null,"session_id":"ccba73e9-54b6-4808-89ce-87e442914ff8","uuid":"a3709846-6c8c-4322-a257-955d1d8de16a","timestamp":"2026-06-04T08:31:40.583Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n    # Fire the \"whenever a player casts a spell\" trigger.\n    from engine.events import SpellCastTriggeredEvent\n    game.trigger_manager.fire_event(\n        game,\n        SpellCastTriggeredEvent(\n            spell=stack_obj, player=player, card=card, controller=player\n        ),\n    )\n\n\n# ------------------------------------------------------------------\n# Resolution (called when the stack pops)\n# ------------------------------------------------------------------\n\ndef _resolve_spell(\n    game: GameState,\n    card: CardImpl,\n    player: Player,\n    stack_obj: StackObject,\n) -> None:\n    \"\"\"Resolve *card* cast by *player*.\n\n    1. Call ``card.on_resolve(game, targets=targets)``.\n    2. Remove the card from the stack zone.\n    3. If the card is a permanent type, move it to the battlefield via\n       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n       registration and the ETB event).\n    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Read targets from the StackObject — the single source of truth.\n    # Set chosen_targets on the card just before resolution so that\n    # _get_chosen_target helpers (which read via getattr) work.\n    targets = stack_obj.targets\n    if targets is not None:\n        card.chosen_targets = targets  # type: ignore[attr-defined]\n\n    card.on_resolve(game)\n\n    if card.card_types & _PERMANENT_TYPES:\n        # Move from stack to battlefield via move_to_zone, which handles\n        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n    else:\n        # Instant/sorcery: consult replacement effects (\"if that spell would\n        # be put into your graveyard, exile it instead\") before moving the\n        # card off the stack.  With no replacement registered this is a no-op\n        # and the spell goes to the graveyard as before.\n        from engine.events import SpellToGraveyardReplacementEvent\n        from engine.zones import _DESTINATION_ZONE_MAP\n\n        owner = getattr(card, \"owner\", None) or player\n        repl = game.replacement_manager.apply(\n            game,\n            SpellToGraveyardReplacementEvent(\n                spell=card, controller=player, owner=owner\n            ),\n        )\n        if getattr(repl, \"prevented\", False):\n            stack_container = owner.zones[Zone.STACK]\n            if stack_container.contains(card):\n                stack_container.remove(card)\n            return\n        dest = _DESTINATION_ZONE_MAP.get(\n            getattr(repl, \"destination\", \"graveyard\"), Zone.GRAVEYARD\n        )\n        move_to_zone(game, card, Zone.STACK, dest)\n\n\n# ------------------------------------------------------------------\n# Play land (special action — does not use the stack)\n# ------------------------------------------------------------------\n\ndef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n\n    Requirements (all must hold):\n\n    * *land_card* has :attr:`CardType.LAND`.\n    * *player* is the active player.\n    * Current phase is a main phase.\n    * The stack is empty.\n    * ``player.land_plays_remaining > 0``.\n    * The card is in the player's hand.\n\n    On success the card moves from hand to battlefield and","numLines":90,"startLine":500,"totalLines":648}}}
