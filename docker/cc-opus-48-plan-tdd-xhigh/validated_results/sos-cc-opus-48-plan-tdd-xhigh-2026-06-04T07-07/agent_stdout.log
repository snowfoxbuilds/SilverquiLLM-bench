{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HMsD2UZGax69TUJ9ex3nth","type":"tool_result","content":"1\t\"\"\"Card implementation for High-Society Hunter.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom typing import TYPE_CHECKING, Any\n4\tfrom engine.card import Creature\n5\tfrom engine.types import CardType, Keyword, ManaCost, Zone\n6\tfrom engine.events import AttacksTriggeredEvent, CreatureDiesTriggeredEvent\n7\tif TYPE_CHECKING:\n8\t    from engine.game_state import GameState\n9\t\n10\tclass HighSocietyHunter(Creature):\n11\t    \"\"\"High-Society Hunter — {3}{B}{B} — 5/3 — Vampire Noble — Flying.\n12\t\n13\t    Whenever this creature attacks, you may sacrifice another creature.\n14\t    If you do, put a +1/+1 counter on this creature.\n15\t    Whenever another nontoken creature dies, draw a card.\n16\t\n17\t    FDN collector number 61.\n18\t    \"\"\"\n19\t\n20\t    def __init__(self, **kwargs: Any) -> None:\n21\t        kwargs.setdefault('name', 'High-Society Hunter')\n22\t        kwargs.setdefault('mana_cost', ManaCost.parse('{3}{B}{B}'))\n23\t        kwargs.setdefault('subtypes', {'Vampire', 'Noble'})\n24\t        kwargs.setdefault('keywords', Keyword.FLYING)\n25\t        kwargs.setdefault('base_power', 5)\n26\t        kwargs.setdefault('base_toughness', 3)\n27\t        kwargs.setdefault('rules_text', 'Flying\\nWhenever this creature attacks, you may sacrifice another creature. If you do, put a +1/+1 counter on this creature.\\nWhenever another nontoken creature dies, draw a card.')\n28\t        super().__init__(**kwargs)\n29\t\n30\t    def register_triggers(self, game: 'GameState') -> None:\n31\t        \"\"\"Register attack trigger (sacrifice for +1/+1 counter) and death\n32\t        trigger (draw when another nontoken creature dies).\"\"\"\n33\t        from engine.game import add_counter, draw_card, sacrifice\n34\t        from engine.triggers import TriggerRegistration\n35\t        source = self\n36\t\n37\t        def _attack_condition(game: Any, event: dict) -> bool:\n38\t            \"\"\"Fire when this creature attacks.\"\"\"\n39\t            return event.creature is source\n40\t\n41\t        def _attack_effect(game: 'GameState') -> None:\n42\t            \"\"\"May sacrifice another creature; if so, add +1/+1 counter.\"\"\"\n43\t            controller = getattr(source, 'controller', None)\n44\t            if controller is None:\n45\t                return\n46\t            battlefield = game.get_battlefield(controller)\n47\t            candidates = [c for c in battlefield.get_all() if CardType.CREATURE in getattr(c, 'card_types', set()) and c is not source]\n48\t            if not candidates:\n49\t                return\n50\t            try:\n51\t                chosen = controller.choose_card(candidates, 'sacrifice a creature for +1/+1 counter')\n52\t            except Exception:\n53\t                chosen = None\n54\t            if chosen is None:\n55\t                return\n56\t            sacrifice(game, controller, chosen)\n57\t            add_counter(game, source, '+1/+1', 1)\n58\t            if hasattr(source, '_base_plus_one_counters'):\n59\t                source._base_plus_one_counters = source.plus_one_counters\n60\t\n61\t        def _dies_condition(game: Any, event: dict) -> bool:\n62\t            \"\"\"Fire when another nontoken creature dies.\"\"\"\n63\t            creature = event.creature\n64\t            if creature is source:\n65\t                return False\n66\t            if getattr(creature, 'is_token', False):\n67\t                return False\n68\t            return True\n69\t\n70\t        def _dies_effect(game: 'GameState') -> None:\n71\t            \"\"\"Draw a card.\"\"\"\n72\t            controller = getattr(source, 'controller', None) or getattr(source, 'owner', None)\n73\t            if controller is not None:\n74\t                draw_card(game, controller)\n75\t        controller = getattr(self, 'controller', None) or game.active_player\n76\t        game.trigger_manager.register(TriggerRegistration(event_type=AttacksTriggeredEvent, condition=_attack_condition, effect=_attack_effect, source=self, controller=controller))\n77\t        game.trigger_manager.register(TriggerRegistration(event_type=CreatureDiesTriggeredEvent, condition=_dies_condition, effect=_dies_effect, source=self, controller=controller))\n78\t"}]},"parent_tool_use_id":null,"session_id":"ccba73e9-54b6-4808-89ce-87e442914ff8","uuid":"2a8c7f51-e9ea-4169-86d4-60d76eb14443","timestamp":"2026-06-04T07:53:13.509Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_61/card_impl.py","content":"\"\"\"Card implementation for High-Society Hunter.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import Creature\nfrom engine.types import CardType, Keyword, ManaCost, Zone\nfrom engine.events import AttacksTriggeredEvent, CreatureDiesTriggeredEvent\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\nclass HighSocietyHunter(Creature):\n    \"\"\"High-Society Hunter — {3}{B}{B} — 5/3 — Vampire Noble — Flying.\n\n    Whenever this creature attacks, you may sacrifice another creature.\n    If you do, put a +1/+1 counter on this creature.\n    Whenever another nontoken creature dies, draw a card.\n\n    FDN collector number 61.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'High-Society Hunter')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{3}{B}{B}'))\n        kwargs.setdefault('subtypes', {'Vampire', 'Noble'})\n        kwargs.setdefault('keywords', Keyword.FLYING)\n        kwargs.setdefault('base_power', 5)\n        kwargs.setdefault('base_toughness', 3)\n        kwargs.setdefault('rules_text', 'Flying\\nWhenever this creature attacks, you may sacrifice another creature. If you do, put a +1/+1 counter on this creature.\\nWhenever another nontoken creature dies, draw a card.')\n        super().__init__(**kwargs)\n\n    def register_triggers(self, game: 'GameState') -> None:\n        \"\"\"Register attack trigger (sacrifice for +1/+1 counter) and death\n        trigger (draw when another nontoken creature dies).\"\"\"\n        from engine.game import add_counter, draw_card, sacrifice\n        from engine.triggers import TriggerRegistration\n        source = self\n\n        def _attack_condition(game: Any, event: dict) -> bool:\n            \"\"\"Fire when this creature attacks.\"\"\"\n            return event.creature is source\n\n        def _attack_effect(game: 'GameState') -> None:\n            \"\"\"May sacrifice another creature; if so, add +1/+1 counter.\"\"\"\n            controller = getattr(source, 'controller', None)\n            if controller is None:\n                return\n            battlefield = game.get_battlefield(controller)\n            candidates = [c for c in battlefield.get_all() if CardType.CREATURE in getattr(c, 'card_types', set()) and c is not source]\n            if not candidates:\n                return\n            try:\n                chosen = controller.choose_card(candidates, 'sacrifice a creature for +1/+1 counter')\n            except Exception:\n                chosen = None\n            if chosen is None:\n                return\n            sacrifice(game, controller, chosen)\n            add_counter(game, source, '+1/+1', 1)\n            if hasattr(source, '_base_plus_one_counters'):\n                source._base_plus_one_counters = source.plus_one_counters\n\n        def _dies_condition(game: Any, event: dict) -> bool:\n            \"\"\"Fire when another nontoken creature dies.\"\"\"\n            creature = event.creature\n            if creature is source:\n                return False\n            if getattr(creature, 'is_token', False):\n                return False\n            return True\n\n        def _dies_effect(game: 'GameState') -> None:\n            \"\"\"Draw a card.\"\"\"\n            controller = getattr(source, 'controller', None) or getattr(source, 'owner', None)\n            if controller is not None:\n                draw_card(game, controller)\n        controller = getattr(self, 'controller', None) or game.active_player\n        game.trigger_manager.register(TriggerRegistration(event_type=AttacksTriggeredEvent, condition=_attack_condition, effect=_attack_effect, source=self, controller=controller))\n        game.trigger_manager.register(TriggerRegistration(event_type=CreatureDiesTriggeredEvent, condition=_dies_condition, effect=_dies_effect, source=self, controller=controller))\n","numLines":78,"startLine":1,"totalLines":78}}}
