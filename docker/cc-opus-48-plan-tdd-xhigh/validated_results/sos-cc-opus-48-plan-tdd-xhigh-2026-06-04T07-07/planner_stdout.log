style activated abilities.\"\"\"\n34\t        source = self\n35\t\n36\t        def _cost_scout(game: 'GameState') -> bool:\n37\t            ctrl = getattr(source, 'controller', None)\n38\t            if ctrl is None:\n39\t                return False\n40\t            return ctrl.mana_pool.pay(ManaCost.parse('{1}{R}'))\n41\t\n42\t        def _effect_scout(game: 'GameState') -> None:\n43\t            if 'Scout' not in getattr(source, 'subtypes', set()):\n44\t                return\n45\t            source.subtypes = {'Human', 'Faerie', 'Detective'}\n46\t            source._kellan_has_detective_trigger = True\n47\t\n48\t        def _cost_detective(game: 'GameState') -> bool:\n49\t            ctrl = getattr(source, 'controller', None)\n50\t            if ctrl is None:\n51\t                return False\n52\t            return ctrl.mana_pool.pay(ManaCost.parse('{2}{R}'))\n53\t\n54\t        def _effect_detective(game: 'GameState') -> None:\n55\t            if 'Detective' not in getattr(source, 'subtypes', set()):\n56\t                return\n57\t            source.subtypes = {'Human', 'Faerie', 'Rogue'}\n58\t            source.modified_power = 3\n59\t            source.modified_toughness = 2\n60\t            source.keywords = (getattr(source, 'keywords', None) or Keyword(0)) | Keyword.DOUBLE_STRIKE\n61\t        return [ActivatedAbility(cost=_cost_scout, effect=_effect_scout, description='{1}{R}: Become Detective with combat damage exile ability.'), ActivatedAbility(cost=_cost_detective, effect=_effect_detective, description='{2}{R}: Become 3/2 Rogue with double strike.')]\n62\t\n63\t    def register_triggers(self, game: 'GameState') -> None:\n64\t        \"\"\"Register combat damage trigger for Detective mode.\"\"\"\n65\t        from engine.triggers import TriggerRegistration\n66\t        source = self\n67\t        controller = getattr(self, 'controller', None) or game.active_player\n68\t\n69\t        def _condition(game: Any, event: dict) -> bool:\n70\t            if not getattr(source, '_kellan_has_detective_trigger', False):\n71\t                return False\n72\t            if event.source is not source:\n73\t                return False\n74\t            target = event.target\n75\t            if not hasattr(target, 'life'):\n76\t                return False\n77\t            return getattr(event, 'is_combat', True)\n78\t\n79\t        def _effect(game: 'GameState') -> None:\n80\t            ctrl = getattr(source, 'controller', None)\n81\t            if ctrl is None:\n82\t                return\n83\t            library = ctrl.zones[Zone.LIBRARY]\n84\t            cards = list(library.get_all())\n85\t            if not cards:\n86\t                return\n87\t            top_card = cards[-1]\n88\t            from engine.zones import move_to_zone\n89\t            move_to_zone(game, top_card, Zone.LIBRARY, Zone.EXILE)\n90\t            top_card._playable_this_turn = True\n91\t        game.trigger_manager.register(TriggerRegistration(event_type=DealsDamageTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=controller))\n92\t"}]},"parent_tool_use_id":null,"session_id":"c2218e3f-f535-4885-8855-1c8d61867b45","uuid":"9a990946-fed4-4c07-ad92-3c3cad6f4674","timestamp":"2026-06-04T07:12:39.467Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_91/card_impl.py","content":"\"\"\"Card implementation for Kellan, Planar Trailblazer.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import ActivatedAbility, Creature\nfrom engine.types import Keyword, ManaCost, Supertype, Zone\nfrom engine.events import DealsDamageTriggeredEvent\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\nclass KellanPlanarTrailblazer(Creature):\n    \"\"\"Kellan, Planar Trailblazer — {R} — 2/1 — Legendary Human Faerie Scout.\n\n    {1}{R}: If Kellan is a Scout, it becomes a Human Faerie Detective and\n    gains \"Whenever Kellan deals combat damage to a player, exile the top\n    card of your library. You may play that card this turn.\"\n    {2}{R}: If Kellan is a Detective, it becomes a 3/2 Human Faerie Rogue\n    and gains double strike.\n\n    FDN collector number 91.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Kellan, Planar Trailblazer')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{R}'))\n        kwargs.setdefault('supertypes', {Supertype.LEGENDARY})\n        kwargs.setdefault('subtypes', {'Human', 'Faerie', 'Scout'})\n        kwargs.setdefault('base_power', 2)\n        kwargs.setdefault('base_toughness', 1)\n        kwargs.setdefault('rules_text', '{1}{R}: If Kellan is a Scout, it becomes a Human Faerie Detective and gains \"Whenever Kellan deals combat damage to a player, exile the top card of your library. You may play that card this turn.\"\\n{2}{R}: If Kellan is a Detective, it becomes a 3/2 Human Faerie Rogue and gains double strike.')\n        super().__init__(**kwargs)\n\n    def get_activated_abilities(self) -> list[ActivatedAbility]:\n        \"\"\"Return the two level-up style activated abilities.\"\"\"\n        source = self\n\n        def _cost_scout(game: 'GameState') -> bool:\n            ctrl = getattr(source, 'controller', None)\n            if ctrl is None:\n                return False\n            return ctrl.mana_pool.pay(ManaCost.parse('{1}{R}'))\n\n        def _effect_scout(game: 'GameState') -> None:\n            if 'Scout' not in getattr(source, 'subtypes', set()):\n                return\n            source.subtypes = {'Human', 'Faerie', 'Detective'}\n            source._kellan_has_detective_trigger = True\n\n        def _cost_detective(game: 'GameState') -> bool:\n            ctrl = getattr(source, 'controller', None)\n            if ctrl is None:\n                return False\n            return ctrl.mana_pool.pay(ManaCost.parse('{2}{R}'))\n\n        def _effect_detective(game: 'GameState') -> None:\n            if 'Detective' not in getattr(source, 'subtypes', set()):\n                return\n            source.subtypes = {'Human', 'Faerie', 'Rogue'}\n            source.modified_power = 3\n            source.modified_toughness = 2\n            source.keywords = (getattr(source, 'keywords', None) or Keyword(0)) | Keyword.DOUBLE_STRIKE\n        return [ActivatedAbility(cost=_cost_scout, effect=_effect_scout, description='{1}{R}: Become Detective with combat damage exile ability.'), ActivatedAbility(cost=_cost_detective, effect=_effect_detective, description='{2}{R}: Become 3/2 Rogue with double strike.')]\n\n    def register_triggers(self, game: 'GameState') -> None:\n        \"\"\"Register combat damage trigger for Detective mode.\"\"\"\n        from engine.triggers import TriggerRegistration\n        source = self\n        controller = getattr(self, 'controller', None) or game.active_player\n\n        def _condition(game: Any, event: dict) -> bool:\n            if not getattr(source, '_kellan_has_detective_trigger', False):\n                return False\n            if event.source is not source:\n                return False\n            target = event.target\n            if not hasattr(target, 'life'):\n                return False\n            return getattr(event, 'is_combat', True)\n\n        def _effect(game: 'GameState') -> None:\n            ctrl = getattr(source, 'controller', None)\n            if ctrl is None:\n                return\n            library = ctrl.zones[Zone.LIBRARY]\n            cards = list(library.get_all())\n            if not cards:\n                return\n            top_card = cards[-1]\n            from engine.zones import move_to_zone\n            move_to_zone(game, top_card, Zone.LIBRARY, Zone.EXILE)\n            top_card._playable_this_turn = True\n        game.trigger_manager.register(TriggerRegistration(event_type=DealsDamageTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=controller))\n","numLines":92,"startLine":1,"totalLines":92}}}
