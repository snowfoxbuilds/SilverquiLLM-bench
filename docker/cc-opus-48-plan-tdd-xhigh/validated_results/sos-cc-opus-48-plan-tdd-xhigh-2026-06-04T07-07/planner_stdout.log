{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XiKU3zbTSi6jWxkSTvgJFn","type":"tool_result","content":"1\t\"\"\"Triggered abilities system — event-driven trigger registration and firing.\n2\t\n3\tProvides the core mechanism for registering triggered abilities and firing\n4\tevents that push matching triggers onto the stack:\n5\t\n6\t- :class:`TriggerRegistration` — dataclass describing a single trigger.\n7\t- :class:`TriggerManager` — central registry for triggers with APNAP-ordered\n8\t  event firing.\n9\t\n10\tEvent types live in :mod:`engine.events` as typed dataclasses.\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\tfrom dataclasses import dataclass, field\n16\tfrom typing import TYPE_CHECKING, Any, Callable\n17\t\n18\tfrom engine.events import TriggeredEvent\n19\tfrom engine.stack import StackObject\n20\t\n21\tif TYPE_CHECKING:\n22\t    from engine.game_state import GameState\n23\t    from engine.player import Player\n24\t\n25\t\n26\t@dataclass\n27\tclass TriggerRegistration:\n28\t    \"\"\"Describes a single triggered ability.\n29\t\n30\t    Attributes:\n31\t        event_type: The event class (or a base class) this trigger watches.\n32\t            The trigger fires for any fired event that is an instance of\n33\t            this class, including instances of subclasses.\n34\t        condition: Optional callable ``(game, event) -> bool`` that must\n35\t            return ``True`` for the trigger to fire.  ``None`` means the\n36\t            trigger always fires for its event type.\n37\t        effect: Callable ``(game) -> None`` executed when the trigger\n38\t            resolves (becomes the :attr:`StackObject.on_resolve` callback).\n39\t        source: The game object (card / permanent) that owns this trigger.\n40\t        controller: The player who controls the source at the time of\n41\t            registration.\n42\t    \"\"\"\n43\t\n44\t    event_type: type[TriggeredEvent]\n45\t    condition: Callable[..., bool] | None\n46\t    effect: Callable[..., None]\n47\t    source: Any\n48\t    controller: Player\n49\t\n50\t\n51\tclass TriggerManager:\n52\t    \"\"\"Central registry for triggered abilities.\n53\t\n54\t    Triggers are registered when a permanent enters the battlefield (or\n55\t    via other game actions) and unregistered when the source leaves.\n56\t\n57\t    :meth:`fire_event` checks all registered triggers of a matching\n58\t    event type, evaluates their conditions, and pushes matching triggers\n59\t    onto the game stack as :class:`StackObject` instances.  Triggers are\n60\t    ordered according to APNAP (Active Player, Non-Active Player):\n61\t\n62\t    * Active player's triggers are pushed first (end up on the bottom\n63\t      of the batch).\n64\t    * Non-active player's triggers are pushed second (end up on top).\n65\t    * Within the same player, triggers are pushed in registration order\n66\t      (controller would normally choose; for now we use registration\n67\t      order as a deterministic default).\n68\t    \"\"\"\n69\t\n70\t    def __init__(self) -> None:\n71\t        self._triggers: list[TriggerRegistration] = []\n72\t\n73\t    def register(self, trigger: TriggerRegistration) -> None:\n74\t        \"\"\"Register a triggered ability.\"\"\"\n75\t        self._triggers.append(trigger)\n76\t\n77\t    def unregister(self, source: Any) -> None:\n78\t        \"\"\"Remove all triggers registered by *source* (identity-based).\"\"\"\n79\t        self._triggers = [t for t in self._triggers if t.source is not source]\n80\t\n81\t    def fire_event(self, game: GameState, event: TriggeredEvent) -> None:\n82\t        \"\"\"Fire an event and push all matching triggers onto the stack.\n83\t\n84\t        Parameters:\n85\t            game: The current game state.\n86\t            event: The typed event object.  Triggers registered for the\n87\t                event's class or any of its parent classes will fire.\n88\t\n89\t        Matching triggers are pushed in APNAP order:\n90\t\n91\t        1. Active player's matching triggers (in registration order).\n92\t        2. Non-active player's matching triggers (in registration order).\n93\t        \"\"\"\n94\t        matching: list[TriggerRegistration] = []\n95\t        for trigger in self._triggers:\n96\t            if not isinstance(event, trigger.event_type):\n97\t                continue\n98\t            if trigger.condition is not None:\n99\t                if not trigger.condition(game, event):\n100\t                    continue\n101\t            matching.append(trigger)\n102\t\n103\t        if not matching:\n104\t            return\n105\t\n106\t        active_player = game.active_player\n107\t        active_triggers: list[TriggerRegistration] = []\n108\t        non_active_triggers: list[TriggerRegistration] = []\n109\t\n110\t        for trigger in matching:\n111\t            if trigger.controller is active_player:\n112\t                active_triggers.append(trigger)\n113\t            else:\n114\t                non_active_triggers.append(trigger)\n115\t\n116\t        ordered = active_triggers + non_active_triggers\n117\t\n118\t        for trigger in ordered:\n119\t            stack_obj = StackObject(\n120\t                source=trigger.source,\n121\t                controller=trigger.controller,\n122\t                on_resolve=trigger.effect,\n123\t            )\n124\t            game.stack.push(stack_obj)\n125\t\n126\t    def get_triggers(self) -> list[TriggerRegistration]:\n127\t        \"\"\"Return a shallow copy of all registered triggers.\"\"\"\n128\t        return list(self._triggers)\n129\t\n130\t    def get_triggers_for_source(self, source: Any) -> list[TriggerRegistration]:\n131\t        \"\"\"Return all triggers registered by *source* (identity-based).\"\"\"\n132\t        return [t for t in self._triggers if t.source is source]\n133\t\n134\t    def clear(self) -> None:\n135\t        \"\"\"Remove all registered triggers.\"\"\"\n136\t        self._triggers.clear()\n137\t"}]},"parent_tool_use_id":null,"session_id":"c2218e3f-f535-4885-8855-1c8d61867b45","uuid":"84ca307a-d851-4636-8cdd-7a299b14c78f","timestamp":"2026-06-04T07:08:27.393Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/triggers.py","content":"\"\"\"Triggered abilities system — event-driven trigger registration and firing.\n\nProvides the core mechanism for registering triggered abilities and firing\nevents that push matching triggers onto the stack:\n\n- :class:`TriggerRegistration` — dataclass describing a single trigger.\n- :class:`TriggerManager` — central registry for triggers with APNAP-ordered\n  event firing.\n\nEvent types live in :mod:`engine.events` as typed dataclasses.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom typing import TYPE_CHECKING, Any, Callable\n\nfrom engine.events import TriggeredEvent\nfrom engine.stack import StackObject\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n@dataclass\nclass TriggerRegistration:\n    \"\"\"Describes a single triggered ability.\n\n    Attributes:\n        event_type: The event class (or a base class) this trigger watches.\n            The trigger fires for any fired event that is an instance of\n            this class, including instances of subclasses.\n        condition: Optional callable ``(game, event) -> bool`` that must\n            return ``True`` for the trigger to fire.  ``None`` means the\n            trigger always fires for its event type.\n        effect: Callable ``(game) -> None`` executed when the trigger\n            resolves (becomes the :attr:`StackObject.on_resolve` callback).\n        source: The game object (card / permanent) that owns this trigger.\n        controller: The player who controls the source at the time of\n            registration.\n    \"\"\"\n\n    event_type: type[TriggeredEvent]\n    condition: Callable[..., bool] | None\n    effect: Callable[..., None]\n    source: Any\n    controller: Player\n\n\nclass TriggerManager:\n    \"\"\"Central registry for triggered abilities.\n\n    Triggers are registered when a permanent enters the battlefield (or\n    via other game actions) and unregistered when the source leaves.\n\n    :meth:`fire_event` checks all registered triggers of a matching\n    event type, evaluates their conditions, and pushes matching triggers\n    onto the game stack as :class:`StackObject` instances.  Triggers are\n    ordered according to APNAP (Active Player, Non-Active Player):\n\n    * Active player's triggers are pushed first (end up on the bottom\n      of the batch).\n    * Non-active player's triggers are pushed second (end up on top).\n    * Within the same player, triggers are pushed in registration order\n      (controller would normally choose; for now we use registration\n      order as a deterministic default).\n    \"\"\"\n\n    def __init__(self) -> None:\n        self._triggers: list[TriggerRegistration] = []\n\n    def register(self, trigger: TriggerRegistration) -> None:\n        \"\"\"Register a triggered ability.\"\"\"\n        self._triggers.append(trigger)\n\n    def unregister(self, source: Any) -> None:\n        \"\"\"Remove all triggers registered by *source* (identity-based).\"\"\"\n        self._triggers = [t for t in self._triggers if t.source is not source]\n\n    def fire_event(self, game: GameState, event: TriggeredEvent) -> None:\n        \"\"\"Fire an event and push all matching triggers onto the stack.\n\n        Parameters:\n            game: The current game state.\n            event: The typed event object.  Triggers registered for the\n                event's class or any of its parent classes will fire.\n\n        Matching triggers are pushed in APNAP order:\n\n        1. Active player's matching triggers (in registration order).\n        2. Non-active player's matching triggers (in registration order).\n        \"\"\"\n        matching: list[TriggerRegistration] = []\n        for trigger in self._triggers:\n            if not isinstance(event, trigger.event_type):\n                continue\n            if trigger.condition is not None:\n                if not trigger.condition(game, event):\n                    continue\n            matching.append(trigger)\n\n        if not matching:\n            return\n\n        active_player = game.active_player\n        active_triggers: list[TriggerRegistration] = []\n        non_active_triggers: list[TriggerRegistration] = []\n\n        for trigger in matching:\n            if trigger.controller is active_player:\n                active_triggers.append(trigger)\n            else:\n                non_active_triggers.append(trigger)\n\n        ordered = active_triggers + non_active_triggers\n\n        for trigger in ordered:\n            stack_obj = StackObject(\n                source=trigger.source,\n                controller=trigger.controller,\n                on_resolve=trigger.effect,\n            )\n            game.stack.push(stack_obj)\n\n    def get_triggers(self) -> list[TriggerRegistration]:\n        \"\"\"Return a shallow copy of all registered triggers.\"\"\"\n        return list(self._triggers)\n\n    def get_triggers_for_source(self, source: Any) -> list[TriggerRegistration]:\n        \"\"\"Return all triggers registered by *source* (identity-based).\"\"\"\n        return [t for t in self._triggers if t.source is source]\n\n    def clear(self) -> None:\n        \"\"\"Remove all registered triggers.\"\"\"\n        self._triggers.clear()\n","numLines":137,"startLine":1,"totalLines":137}}}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01MUx5MDwktZGEhsYUMTseWG","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_017XXGmg5C5Pb2tHcnCyGaFu","name":"Read","input":{"file_path":"/workspace/engine/replacement_effects.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2027,"cache_read_input_tokens":44970,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2027},"output_tokens":44,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c2218e3f-f535-4885-8855-1c8d61867b45","uuid":"55a76471-22d8-4bc6-948c-f43b53f812ec","request_id":"req_011CbhoJB8BSo6S8jNpCLc8R"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017XXGmg5C5Pb2tHcnCyGaFu","type":"tool_result","content":"1\t\"\"\"Replacement effects engine — modifies events in-place with \"instead\" semantics.\n2\t\n3\tUnlike triggered abilities (which go on the stack), replacement effects\n4\tintercept an event *before* it happens and substitute an alternative\n5\toutcome.  Key design differences from triggers:\n6\t\n7\t- **No stack**: replacements are applied inline, not pushed.\n8\t- **\"Instead\" semantics**: the original event is replaced, not supplemented.\n9\t- **Self-replacement prevention**: each effect applies at most once per\n10\t  event to avoid infinite loops.\n11\t- **Player choice**: when multiple replacements apply to the same event,\n12\t  the affected player chooses the order via ``Player.choose``.\n13\t- **Subtype matching**: a replacement registered for a parent event class\n14\t  (e.g. ``MoveToGraveyardReplacementEvent``) fires for any subtype\n15\t  (e.g. ``CreatureDiesReplacementEvent``).\n16\t\n17\tPublic API:\n18\t\n19\t- :class:`ReplacementEffect` — dataclass describing a single replacement.\n20\t- :class:`ReplacementManager` — central registry with ``register``,\n21\t  ``unregister``, and ``apply`` methods.\n22\t\"\"\"\n23\t\n24\tfrom __future__ import annotations\n25\t\n26\tfrom dataclasses import dataclass\n27\tfrom typing import TYPE_CHECKING, Any, Callable\n28\t\n29\tfrom engine.events import ReplacementEvent\n30\t\n31\tif TYPE_CHECKING:\n32\t    from engine.game_state import GameState\n33\t    from engine.player import Player\n34\t\n35\t\n36\t@dataclass\n37\tclass ReplacementEffect:\n38\t    \"\"\"Describes a single replacement effect.\n39\t\n40\t    Attributes:\n41\t        event_type: The event class (or a base class) this replacement\n42\t            watches for.  A replacement registered for a parent class\n43\t            also fires when the event is an instance of a subclass.\n44\t        source: The game object (card / permanent) that owns this effect.\n45\t        condition: Optional callable ``(game, event) -> bool`` that must\n46\t            return ``True`` for the replacement to apply.\n47\t        replacement: Callable ``(game, event) -> event`` that receives the\n48\t            current event object and returns a (possibly modified) version.\n49\t        controller: The player who controls the source.\n50\t    \"\"\"\n51\t\n52\t    event_type: type[ReplacementEvent]\n53\t    source: Any\n54\t    condition: Callable[..., bool] | None\n55\t    replacement: Callable[..., ReplacementEvent]\n56\t    controller: Any = None\n57\t\n58\t\n59\tclass ReplacementManager:\n60\t    \"\"\"Central registry for replacement effects.\"\"\"\n61\t\n62\t    def __init__(self) -> None:\n63\t        self._effects: list[ReplacementEffect] = []\n64\t\n65\t    # ------------------------------------------------------------------\n66\t    # Registration\n67\t    # ------------------------------------------------------------------\n68\t\n69\t    def register(self, effect: ReplacementEffect) -> None:\n70\t        \"\"\"Register a replacement effect.\"\"\"\n71\t        self._effects.append(effect)\n72\t\n73\t    def unregister(self, source: Any) -> None:\n74\t        \"\"\"Remove all replacement effects registered by *source*.\"\"\"\n75\t        self._effects = [e for e in self._effects if e.source is not source]\n76\t\n77\t    # ------------------------------------------------------------------\n78\t    # Application\n79\t    # ------------------------------------------------------------------\n80\t\n81\t    def apply(self, game: GameState, event: ReplacementEvent) -> ReplacementEvent:\n82\t        \"\"\"Apply matching replacement effects to *event*.\n83\t\n84\t        1. Collect all registered effects whose ``event_type`` is a\n85\t           superclass of (or equal to) the event's class and whose\n86\t           ``condition`` returns ``True``.\n87\t        2. If multiple effects match, the affected player chooses the order.\n88\t        3. Each chosen effect's ``replacement`` callable is invoked and\n89\t           the result replaces the current event.\n90\t        4. Each effect applies at most once per invocation.\n91\t\n92\t        Parameters:\n93\t            game: The current game state.\n94\t            event: The typed event object to potentially modify.\n95\t\n96\t        Returns:\n97\t            The (possibly modified) event after all applicable replacements.\n98\t        \"\"\"\n99\t        applied: set[int] = set()\n100\t\n101\t        while True:\n102\t            matching = self._collect_matching(game, event, applied)\n103\t            if not matching:\n104\t                break\n105\t\n106\t            if len(matching) == 1:\n107\t                chosen = matching[0]\n108\t            else:\n109\t                affected = self._get_affected_player(game, event)\n110\t                chosen = affected.choose(matching, \"Choose replacement effect order\")\n111\t\n112\t            applied.add(id(chosen))\n113\t            event = chosen.replacement(game, event)\n114\t\n115\t        return event\n116\t\n117\t    # ------------------------------------------------------------------\n118\t    # Queries\n119\t    # ------------------------------------------------------------------\n120\t\n121\t    def get_effects(self) -> list[ReplacementEffect]:\n122\t        \"\"\"Return a shallow copy of all registered replacement effects.\"\"\"\n123\t        return list(self._effects)\n124\t\n125\t    def get_effects_for_source(self, source: Any) -> list[ReplacementEffect]:\n126\t        \"\"\"Return all effects registered by *source*.\"\"\"\n127\t        return [e for e in self._effects if e.source is source]\n128\t\n129\t    def clear(self) -> None:\n130\t        \"\"\"Remove all registered replacement effects.\"\"\"\n131\t        self._effects.clear()\n132\t\n133\t    # ------------------------------------------------------------------\n134\t    # Internal helpers\n135\t    # ------------------------------------------------------------------\n136\t\n137\t    def _collect_matching(\n138\t        self,\n139\t        game: GameState,\n140\t        event: ReplacementEvent,\n141\t        applied: set[int],\n142\t    ) -> list[ReplacementEffect]:\n143\t        \"\"\"Collect effects matching the event type that haven't been applied.\"\"\"\n144\t        matching: list[ReplacementEffect] = []\n145\t        for effect in self._effects:\n146\t            if id(effect) in applied:\n147\t                continue\n148\t            if not isinstance(event, effect.event_type):\n149\t                continue\n150\t            if effect.condition is not None:\n151\t                if not effect.condition(game, event):\n152\t                    continue\n153\t            matching.append(effect)\n154\t        return matching\n155\t\n156\t    @staticmethod\n157\t    def _get_affected_player(game: GameState, event: ReplacementEvent) -> Any:\n158\t        \"\"\"Determine the affected player for ordering choices.\"\"\"\n159\t        player = getattr(event, \"player\", None)\n160\t        if player is not None:\n161\t            return player\n162\t        controller = getattr(event, \"controller\", None)\n163\t        if controller is not None:\n164\t            return controller\n165\t        return game.active_player\n166\t"}]},"parent_tool_use_id":null,"session_id":"c2218e3f-f535-4885-8855-1c8d61867b45","uuid":"37777c89-362e-4078-ac81-0b554d4694b1","timestamp":"2026-06-04T07:08:29.462Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/replacement_effects.py","content":"\"\"\"Replacement effects engine — modifies events in-place with \"instead\" semantics.\n\nUnlike triggered abilities (which go on the stack), replacement effects\nintercept an event *before* it happens and substitute an alternative\noutcome.  Key design differences from triggers:\n\n- **No stack**: replacements are applied inline, not pushed.\n- **\"Instead\" semantics**: the original event is replaced, not supplemented.\n- **Self-replacement prevention**: each effect applies at most once per\n  event to avoid infinite loops.\n- **Player choice**: when multiple replacements apply to the same event,\n  the affected player chooses the order via ``Player.choose``.\n- **Subtype matching**: a replacement registered for a parent event class\n  (e.g. ``MoveToGraveyardReplacementEvent``) fires for any subtype\n  (e.g. ``CreatureDiesReplacementEvent``).\n\nPublic API:\n\n- :class:`ReplacementEffect` — dataclass describing a single replacement.\n- :class:`ReplacementManager` — central registry with ``register``,\n  ``unregister``, and ``apply`` methods.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom typing import TYPE_CHECKING, Any, Callable\n\nfrom engine.events import ReplacementEvent\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n@dataclass\nclass ReplacementEffect:\n    \"\"\"Describes a single replacement effect.\n\n    Attributes:\n        event_type: The event class (or a base class) this replacement\n            watches for.  A replacement registered for a parent class\n            also fires when the event is an instance of a subclass.\n        source: The game object (card / permanent) that owns this effect.\n        condition: Optional callable ``(game, event) -> bool`` that must\n            return ``True`` for the replacement to apply.\n        replacement: Callable ``(game, event) -> event`` that receives the\n            current event object and returns a (possibly modified) version.\n        controller: The player who controls the source.\n    \"\"\"\n\n    event_type: type[ReplacementEvent]\n    source: Any\n    condition: Callable[..., bool] | None\n    replacement: Callable[..., ReplacementEvent]\n    controller: Any = None\n\n\nclass ReplacementManager:\n    \"\"\"Central registry for replacement effects.\"\"\"\n\n    def __init__(self) -> None:\n        self._effects: list[ReplacementEffect] = []\n\n    # ------------------------------------------------------------------\n    # Registration\n    # ------------------------------------------------------------------\n\n    def register(self, effect: ReplacementEffect) -> None:\n        \"\"\"Register a replacement effect.\"\"\"\n        self._effects.append(effect)\n\n    def unregister(self, source: Any) -> None:\n        \"\"\"Remove all replacement effects registered by *source*.\"\"\"\n        self._effects = [e for e in self._effects if e.source is not source]\n\n    # ------------------------------------------------------------------\n    # Application\n    # ------------------------------------------------------------------\n\n    def apply(self, game: GameState, event: ReplacementEvent) -> ReplacementEvent:\n        \"\"\"Apply matching replacement effects to *event*.\n\n        1. Collect all registered effects whose ``event_type`` is a\n           superclass of (or equal to) the event's class and whose\n           ``condition`` returns ``True``.\n        2. If multiple effects match, the affected player chooses the order.\n        3. Each chosen effect's ``replacement`` callable is invoked and\n           the result replaces the current event.\n        4. Each effect applies at most once per invocation.\n\n        Parameters:\n            game: The current game state.\n            event: The typed event object to potentially modify.\n\n        Returns:\n            The (possibly modified) event after all applicable replacements.\n        \"\"\"\n        applied: set[int] = set()\n\n        while True:\n            matching = self._collect_matching(game, event, applied)\n            if not matching:\n                break\n\n            if len(matching) == 1:\n                chosen = matching[0]\n            else:\n                affected = self._get_affected_player(game, event)\n                chosen = affected.choose(matching, \"Choose replacement effect order\")\n\n            applied.add(id(chosen))\n            event = chosen.replacement(game, event)\n\n        return event\n\n    # ------------------------------------------------------------------\n    # Queries\n    # ------------------------------------------------------------------\n\n    def get_effects(self) -> list[ReplacementEffect]:\n        \"\"\"Return a shallow copy of all registered replacement effects.\"\"\"\n        return list(self._effects)\n\n    def get_effects_for_source(self, source: Any) -> list[ReplacementEffect]:\n        \"\"\"Return all effects registered by *source*.\"\"\"\n        return [e for e in self._effects if e.source is source]\n\n    def clear(self) -> None:\n        \"\"\"Remove all registered replacement effects.\"\"\"\n        self._effects.clear()\n\n    # ------------------------------------------------------------------\n    # Internal helpers\n    # ------------------------------------------------------------------\n\n    def _collect_matching(\n        self,\n        game: GameState,\n        event: ReplacementEvent,\n        applied: set[int],\n    ) -> list[ReplacementEffect]:\n        \"\"\"Collect effects matching the event type that haven't been applied.\"\"\"\n        matching: list[ReplacementEffect] = []\n        for effect in self._effects:\n            if id(effect) in applied:\n                continue\n            if not isinstance(event, effect.event_type):\n                continue\n            if effect.condition is not None:\n                if not effect.condition(game, event):\n                    continue\n            matching.append(effect)\n        return matching\n\n    @staticmethod\n    def _get_affected_player(game: GameState, event: ReplacementEvent) -> Any:\n        \"\"\"Determine the affected player for ordering choices.\"\"\"\n        player = getattr(event, \"player\", None)\n        if player is not None:\n            return player\n        controller = getattr(event, \"controller\", None)\n        if controller is not None:\n            return controller\n        return game.active_player\n","numLines":166,"startLine":1,"totalLines":166}}}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_019mMfVz65CAdeFBN1nHvjma","type":"message","role":"assistant","content":[{"type":"text","text":"Now let me read casting, zones, mana, and game_state which are central."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2389,"cache_read_input_tokens":46997,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2389},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c2218e3f-f535-4885-8855-1c8d61867b45","uuid":"86b17d6a-2f23-40ef-a886-cff4c48187f2","request_id":"req_011CbhoJL3hPp7iCYMNvJuo8"}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_019mMfVz65CAdeFBN1nHvjma","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01G63PJ2weFCmVhUk4qC4895","name":"Read","input":{"file_path":"/workspace/engine/casting.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2389,"cache_read_input_tokens":46997,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2389},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c2218e3f-f535-4885-8855-1c8d61867b45","uuid":"74b58833-3b7e-43d0-9f42-e16b71cc2560","request_id":"req_011CbhoJL3hPp7iCYMNvJuo8"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01G63PJ2weFCmVhUk4qC4895","type":"tool_result","content":"1\t\"\"\"Casting and resolution pipeline for spells and lands.\n2\t\n3\tProvides the full flow from casting a spell or playing a land through\n4\tresolution:\n5\t\n6\t- :func:`cast_spell` — verify timing & legality → move hand to stack →\n7\t  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n8\t- :func:`play_land` — verify land play remaining → move hand to\n9\t  battlefield → decrement ``land_plays_remaining``.\n10\t- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n11\t  helpers used by the casting pipeline.\n12\t\n13\tResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\n14\tcreated by :func:`cast_spell`:\n15\t\n16\t- Call ``card.on_resolve(game)``.\n17\t- Permanents (creature / enchantment / artifact / planeswalker) move from\n18\t  the stack to the battlefield.\n19\t- Non-permanents (instant / sorcery) move to the graveyard.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import TYPE_CHECKING, Any\n25\t\n26\tfrom engine.card import CardImpl\n27\tfrom engine.stack import StackObject\n28\tfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\n29\tfrom engine.zones import move_zone\n30\t\n31\tif TYPE_CHECKING:\n32\t    from engine.game_state import GameState\n33\t    from engine.player import Player\n34\t\n35\t\n36\t# Card types that represent permanents — these go to the battlefield on resolve.\n37\t_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n38\t    CardType.CREATURE,\n39\t    CardType.ENCHANTMENT,\n40\t    CardType.ARTIFACT,\n41\t    CardType.PLANESWALKER,\n42\t})\n43\t\n44\t\n45\tclass CastingError(Exception):\n46\t    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n47\t\n48\t\n49\t# ------------------------------------------------------------------\n50\t# Timing helpers\n51\t# ------------------------------------------------------------------\n52\t\n53\tdef is_sorcery_speed(game: GameState, player: Player) -> bool:\n54\t    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n55\t\n56\t    Sorcery speed requires all of:\n57\t\n58\t    * *player* is the active player.\n59\t    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n60\t      ``POSTCOMBAT_MAIN``).\n61\t    * The stack is empty.\n62\t    \"\"\"\n63\t    if player is not game.active_player:\n64\t        return False\n65\t    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n66\t        return False\n67\t    if not game.stack.is_empty():\n68\t        return False\n69\t    return True\n70\t\n71\t\n72\tdef can_cast_at_instant_speed(card: CardImpl) -> bool:\n73\t    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n74\t\n75\t    A card has instant-speed timing if it is an instant or has the\n76\t    :attr:`~engine.types.Keyword.FLASH` keyword.\n77\t    \"\"\"\n78\t    if CardType.INSTANT in card.card_types:\n79\t        return True\n80\t    if Keyword.FLASH & card.keywords:\n81\t        return True\n82\t    return False\n83\t\n84\t\n85\t# ------------------------------------------------------------------\n86\t# Cost reduction\n87\t# ------------------------------------------------------------------\n88\t\n89\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n90\t    \"\"\"Return the generic mana reduction for casting *card*.\n91\t\n92\t    Queries ``card.cost_reduction(game)`` and clamps the result so that\n93\t    the generic portion of the mana cost cannot go below 0.\n94\t\n95\t    This is a simplified single-card self-reduction model.  Full MTG\n96\t    cost-reduction interactions (Trinisphere, multiple reductions from\n97\t    different sources) are deferred.\n98\t    \"\"\"\n99\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n100\t    # casting player even when the card was never explicitly assigned one.\n101\t    prev_controller = card.controller\n102\t    card.controller = controller\n103\t    raw = card.cost_reduction(game)\n104\t    # Restore previous controller in case the caller doesn't want a\n105\t    # side-effect (get_cost_reduction is a query, not a mutation).\n106\t    card.controller = prev_controller\n107\t    generic = card.mana_cost.generic if card.mana_cost else 0\n108\t    return max(0, min(raw, generic))\n109\t\n110\t\n111\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n112\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n113\t    new_generic = max(0, cost.generic - reduction)\n114\t    return ManaCost(\n115\t        generic=new_generic,\n116\t        pips=dict(cost.pips),\n117\t        x_count=cost.x_count,\n118\t        hybrid=list(cost.hybrid),\n119\t    )\n120\t\n121\t\n122\t# ------------------------------------------------------------------\n123\t# Cast spell\n124\t# ------------------------------------------------------------------\n125\t\n126\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n127\t    \"\"\"Cast *card* from *player*'s hand.\n128\t\n129\t    Pipeline\n130\t    --------\n131\t    1. **Timing check** — instants (and cards with flash) can be cast\n132\t       whenever the player has priority; everything else requires\n133\t       sorcery-speed timing.\n134\t    2. **can_cast** — ask the card whether it can legally be cast.\n135\t    3. **Hand check** — the card must be in the player's hand.\n136\t    4. **Move hand → stack zone** — remove the card from the hand and\n137\t       place it into the player's stack zone.\n138\t    5. **Choose targets** — if the card specifies targets (via\n139\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n140\t    6. **Mana check / payment** — the player's mana pool must be able to\n141\t       pay the card's mana cost.  If payment fails, the card is rolled\n142\t       back from the stack zone to the hand.\n143\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n144\t    8. **Push StackObject** — push a :class:`StackObject` whose\n145\t       ``on_resolve`` callback handles resolution.\n146\t\n147\t    Raises:\n148\t        CastingError: If any legality check fails.\n149\t    \"\"\"\n150\t    # 1. Timing\n151\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n152\t        raise CastingError(\n153\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n154\t        )\n155\t\n156\t    # 2. can_cast\n157\t    if not card.can_cast(game):\n158\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n159\t\n160\t    # 3. Hand check\n161\t    hand = game.get_hand(player)\n162\t    if not hand.contains(card):\n163\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n164\t\n165\t    # 4. Move card from hand to stack zone\n166\t    stack_zone = player.zones[Zone.STACK]\n167\t    hand.remove(card)\n168\t    stack_zone.add(card)\n169\t\n170\t    # Clear any stale colors_spent from a prior cast before new payment.\n171\t    if hasattr(card, \"colors_spent\"):\n172\t        del card.colors_spent\n173\t\n174\t    # 5. Choose targets\n175\t    target_specs = card.get_targets(game)\n176\t    chosen_targets: list[Any] = []\n177\t    if target_specs:\n178\t        for spec in target_specs:\n179\t            target = player.choose_target(target_specs, spec)\n180\t            # Validate against filter_fn if the spec provides one\n181\t            filter_fn = getattr(spec, \"filter_fn\", None)\n182\t            if filter_fn is not None and target is not None:\n183\t                if not filter_fn(target):\n184\t                    stack_zone.remove(card)\n185\t                    hand.add(card)\n186\t                    raise CastingError(\n187\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n188\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n189\t                    )\n190\t            chosen_targets.append(target)\n191\t\n192\t    # 5b. Protection check — reject targets that have protection from this\n193\t    #     spell (the T in DEBT).\n194\t    from engine.protection import has_protection_from\n195\t\n196\t    for target in chosen_targets:\n197\t        if has_protection_from(target, card):\n198\t            # Rollback: move card from stack zone back to hand\n199\t            stack_zone.remove(card)\n200\t            hand.add(card)\n201\t            raise CastingError(\n202\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n203\t            )\n204\t\n205\t    # Targets are stored on the StackObject (not the card) and passed\n206\t    # through the resolve pipeline via on_resolve(game, targets=...).\n207\t\n208\t    # 6. Mana check / payment (rollback on failure)\n209\t    # Ensure the card knows its controller so that cost_reduction() hooks\n210\t    # (e.g. Embercleave counting attacking creatures you control) see the\n211\t    # casting player, even for cards that were added to hand without an\n212\t    # explicit controller assignment.\n213\t    if card.controller is None:\n214\t        card.controller = player\n215\t    reduction = get_cost_reduction(game, card, player)\n216\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n217\t\n218\t    if not player.mana_pool.can_pay(effective_cost):\n219\t        # Rollback: move card from stack zone back to hand\n220\t        stack_zone.remove(card)\n221\t        hand.add(card)\n222\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n223\t\n224\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n225\t    player.mana_pool.pay(effective_cost)\n226\t\n227\t    # Store colors of mana spent on the card for mechanics like Converge\n228\t    # that care about the colors used to cast the spell.\n229\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n230\t\n231\t    # 7. Call on_cast hook\n232\t    card.on_cast(game)\n233\t\n234\t    # 8. Build on_resolve callback and push StackObject\n235\t    stack_obj = StackObject(\n236\t        source=card,\n237\t        controller=player,\n238\t        targets=chosen_targets,\n239\t        on_resolve=lambda g: None,  # replaced below\n240\t    )\n241\t\n242\t    def _on_resolve(g: GameState) -> None:\n243\t        _resolve_spell(g, card, player, stack_obj)\n244\t\n245\t    stack_obj.on_resolve = _on_resolve\n246\t    game.stack.push(stack_obj)\n247\t\n248\t\n249\t# ------------------------------------------------------------------\n250\t# Cast spell without paying mana cost (free-cast from any zone)\n251\t# ------------------------------------------------------------------\n252\t\n253\t\n254\tdef cast_spell_free(\n255\t    game: GameState,\n256\t    player: Player,\n257\t    card: CardImpl,\n258\t    from_zone: Zone,\n259\t) -> None:\n260\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n261\t\n262\t    This is used by effects that allow casting from zones other than hand\n263\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n264\t    or cascade.\n265\t\n266\t    Pipeline\n267\t    --------\n268\t    1. **can_cast** — ask the card whether it can legally be cast (same\n269\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n270\t    2. Move *card* from *from_zone* to the stack zone.\n271\t    3. Choose targets (if applicable) with validation and protection check.\n272\t    4. Call ``on_cast`` hook.\n273\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n274\t       resolution normally (permanents → battlefield, non-permanents →\n275\t       graveyard).\n276\t\n277\t    No timing check or mana payment is performed.  The spell goes on the\n278\t    stack and can be responded to normally (e.g. countered).\n279\t\n280\t    If targeting or other post-move checks fail, the card is rolled back\n281\t    to its source zone.\n282\t\n283\t    Parameters:\n284\t        game: The current game state.\n285\t        player: The player casting the spell.\n286\t        card: The card to cast.\n287\t        from_zone: The zone the card is currently in.\n288\t\n289\t    Raises:\n290\t        CastingError: If the card cannot be found in *from_zone* or\n291\t            legality checks fail.\n292\t    \"\"\"\n293\t    from engine.zones import move_to_zone\n294\t\n295\t    # Ensure controller is set\n296\t    card.controller = player\n297\t    if card.owner is None:\n298\t        card.owner = player\n299\t\n300\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n301\t    if not card.can_cast(game):\n302\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n303\t\n304\t    # 2. Locate card in source zone\n305\t    source_zone_container = player.zones[from_zone]\n306\t    if not source_zone_container.contains(card):\n307\t        # Try to find the card in any player's zone\n308\t        source_zone_container = None\n309\t        for p in game.players:\n310\t            z = p.zones[from_zone]\n311\t            if z.contains(card):\n312\t                source_zone_container = z\n313\t                break\n314\t\n315\t    if source_zone_container is None or not source_zone_container.contains(card):\n316\t        raise CastingError(\n317\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n318\t        )\n319\t\n320\t    # Move card from source zone to stack zone\n321\t    stack_zone = player.zones[Zone.STACK]\n322\t    source_zone_container.remove(card)\n323\t    stack_zone.add(card)\n324\t\n325\t    # 3. Choose targets (with rollback on failure)\n326\t    try:\n327\t        target_specs = card.get_targets(game)\n328\t        chosen_targets: list[Any] = []\n329\t        if target_specs:\n330\t            for spec in target_specs:\n331\t                target = player.choose_target(target_specs, spec)\n332\t                # Validate against filter_fn if the spec provides one\n333\t                filter_fn = getattr(spec, \"filter_fn\", None)\n334\t                if filter_fn is not None and target is not None:\n335\t                    if not filter_fn(target):\n336\t                        raise CastingError(\n337\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n338\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n339\t                        )\n340\t                chosen_targets.append(target)\n341\t\n342\t        # Protection check — reject targets that have protection from this spell\n343\t        from engine.protection import has_protection_from\n344\t\n345\t        for target in chosen_targets:\n346\t            if has_protection_from(target, card):\n347\t                raise CastingError(\n348\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n349\t                )\n350\t    except Exception as exc:\n351\t        # Rollback: move card from stack zone back to source zone\n352\t        stack_zone.remove(card)\n353\t        source_zone_container.add(card)\n354\t        raise CastingError(str(exc)) from exc\n355\t\n356\t    # 4. Call on_cast hook\n357\t    card.on_cast(game)\n358\t\n359\t    # 5. Build on_resolve callback and push StackObject\n360\t    stack_obj = StackObject(\n361\t        source=card,\n362\t        controller=player,\n363\t        targets=chosen_targets,\n364\t        on_resolve=lambda g: None,  # replaced below\n365\t    )\n366\t\n367\t    def _on_resolve(g: GameState) -> None:\n368\t        _resolve_spell(g, card, player, stack_obj)\n369\t\n370\t    stack_obj.on_resolve = _on_resolve\n371\t    game.stack.push(stack_obj)\n372\t\n373\t\n374\t# ------------------------------------------------------------------\n375\t# Resolution (called when the stack pops)\n376\t# ------------------------------------------------------------------\n377\t\n378\tdef _resolve_spell(\n379\t    game: GameState,\n380\t    card: CardImpl,\n381\t    player: Player,\n382\t    stack_obj: StackObject,\n383\t) -> None:\n384\t    \"\"\"Resolve *card* cast by *player*.\n385\t\n386\t    1. Call ``card.on_resolve(game, targets=targets)``.\n387\t    2. Remove the card from the stack zone.\n388\t    3. If the card is a permanent type, move it to the battlefield via\n389\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n390\t       registration and the ETB event).\n391\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n392\t    \"\"\"\n393\t    from engine.zones import move_to_zone\n394\t\n395\t    # Read targets from the StackObject — the single source of truth.\n396\t    # Set chosen_targets on the card just before resolution so that\n397\t    # _get_chosen_target helpers (which read via getattr) work.\n398\t    targets = stack_obj.targets\n399\t    if targets is not None:\n400\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n401\t\n402\t    card.on_resolve(game)\n403\t\n404\t    if card.card_types & _PERMANENT_TYPES:\n405\t        # Move from stack to battlefield via move_to_zone, which handles\n406\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n407\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n408\t    else:\n409\t        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n410\t        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n411\t\n412\t\n413\t# ------------------------------------------------------------------\n414\t# Play land (special action — does not use the stack)\n415\t# ------------------------------------------------------------------\n416\t\n417\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n418\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n419\t\n420\t    Requirements (all must hold):\n421\t\n422\t    * *land_card* has :attr:`CardType.LAND`.\n423\t    * *player* is the active player.\n424\t    * Current phase is a main phase.\n425\t    * The stack is empty.\n426\t    * ``player.land_plays_remaining > 0``.\n427\t    * The card is in the player's hand.\n428\t\n429\t    On success the card moves from hand to battlefield and\n430\t    ``land_plays_remaining`` is decremented.\n431\t\n432\t    Raises:\n433\t        CastingError: If any requirement is not met.\n434\t    \"\"\"\n435\t    # Must be a land\n436\t    if CardType.LAND not in land_card.card_types:\n437\t        raise CastingError(\n438\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n439\t        )\n440\t\n441\t    # Sorcery-speed timing (active player, main phase, stack empty)\n442\t    if not is_sorcery_speed(game, player):\n443\t        raise CastingError(\n444\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n445\t            \"during main phase with empty stack\"\n446\t        )\n447\t\n448\t    # Land plays remaining\n449\t    if player.land_plays_remaining <= 0:\n450\t        raise CastingError(\n451\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n452\t        )\n453\t\n454\t    # Card must be in hand\n455\t    hand = game.get_hand(player)\n456\t    if not hand.contains(land_card):\n457\t        raise CastingError(\n458\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n459\t        )\n460\t\n461\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n462\t    if land_card.owner is None:\n463\t        land_card.owner = player\n464\t    land_card.controller = player\n465\t\n466\t    # Move from hand to battlefield via move_to_zone, which fires\n467\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n468\t    from engine.zones import move_to_zone\n469\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n470\t\n471\t    # Decrement land plays\n472\t    player.land_plays_remaining -= 1\n473\t\n474\t\n475\tdef resolve_top(game: GameState) -> None:\n476\t    \"\"\"Resolve the top spell/ability on the stack.\n477\t\n478\t    Pops the top item from the stack, calls its on_resolve callback,\n479\t    then runs state-based actions.  If the stack is empty this is a no-op.\n480\t    \"\"\"\n481\t    if game.stack.is_empty():\n482\t        return\n483\t    from engine.state_based_actions import resolve_state_based_actions\n484\t\n485\t    obj = game.stack.pop()\n486\t    obj.on_resolve(game)\n487\t    resolve_state_based_actions(game)\n488\t"}]},"parent_tool_use_id":null,"session_id":"c2218e3f-f535-4885-8855-1c8d61867b45","uuid":"997ec7d3-ad8d-4ea6-8f12-b688f4e98b67","timestamp":"2026-06-04T07:08:33.971Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"\"\"\"Casting and resolution pipeline for spells and lands.\n\nProvides the full flow from casting a spell or playing a land through\nresolution:\n\n- :func:`cast_spell` — verify timing & legality → move hand to stack →\n  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n- :func:`play_land` — verify land play remaining → move hand to\n  battlefield → decrement ``land_plays_remaining``.\n- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n  helpers used by the casting pipeline.\n\nResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\ncreated by :func:`cast_spell`:\n\n- Call ``card.on_resolve(game)``.\n- Permanents (creature / enchantment / artifact / planeswalker) move from\n  the stack to the battlefield.\n- Non-permanents (instant / sorcery) move to the graveyard.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import CardImpl\nfrom engine.stack import StackObject\nfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\nfrom engine.zones import move_zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n# Card types that represent permanents — these go to the battlefield on resolve.\n_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n    CardType.CREATURE,\n    CardType.ENCHANTMENT,\n    CardType.ARTIFACT,\n    CardType.PLANESWALKER,\n})\n\n\nclass CastingError(Exception):\n    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n\n\n# ------------------------------------------------------------------\n# Timing helpers\n# ------------------------------------------------------------------\n\ndef is_sorcery_speed(game: GameState, player: Player) -> bool:\n    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n\n    Sorcery speed requires all of:\n\n    * *player* is the active player.\n    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n      ``POSTCOMBAT_MAIN``).\n    * The stack is empty.\n    \"\"\"\n    if player is not game.active_player:\n        return False\n    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n        return False\n    if not game.stack.is_empty():\n        return False\n    return True\n\n\ndef can_cast_at_instant_speed(card: CardImpl) -> bool:\n    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n\n    A card has instant-speed timing if it is an instant or has the\n    :attr:`~engine.types.Keyword.FLASH` keyword.\n    \"\"\"\n    if CardType.INSTANT in card.card_types:\n        return True\n    if Keyword.FLASH & card.keywords:\n        return True\n    return False\n\n\n# ------------------------------------------------------------------\n# Cost reduction\n# ------------------------------------------------------------------\n\ndef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n    \"\"\"Return the generic mana reduction for casting *card*.\n\n    Queries ``card.cost_reduction(game)`` and clamps the result so that\n    the generic portion of the mana cost cannot go below 0.\n\n    This is a simplified single-card self-reduction model.  Full MTG\n    cost-reduction interactions (Trinisphere, multiple reductions from\n    different sources) are deferred.\n    \"\"\"\n    # Ensure card.controller is set so the hook can reference \"you\" / the\n    # casting player even when the card was never explicitly assigned one.\n    prev_controller = card.controller\n    card.controller = controller\n    raw = card.cost_reduction(game)\n    # Restore previous controller in case the caller doesn't want a\n    # side-effect (get_cost_reduction is a query, not a mutation).\n    card.controller = prev_controller\n    generic = card.mana_cost.generic if card.mana_cost else 0\n    return max(0, min(raw, generic))\n\n\ndef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n    new_generic = max(0, cost.generic - reduction)\n    return ManaCost(\n        generic=new_generic,\n        pips=dict(cost.pips),\n        x_count=cost.x_count,\n        hybrid=list(cost.hybrid),\n    )\n\n\n# ------------------------------------------------------------------\n# Cast spell\n# ------------------------------------------------------------------\n\ndef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n    \"\"\"Cast *card* from *player*'s hand.\n\n    Pipeline\n    --------\n    1. **Timing check** — instants (and cards with flash) can be cast\n       whenever the player has priority; everything else requires\n       sorcery-speed timing.\n    2. **can_cast** — ask the card whether it can legally be cast.\n    3. **Hand check** — the card must be in the player's hand.\n    4. **Move hand → stack zone** — remove the card from the hand and\n       place it into the player's stack zone.\n    5. **Choose targets** — if the card specifies targets (via\n       :meth:`CardImpl.get_targets`), the player is asked to choose.\n    6. **Mana check / payment** — the player's mana pool must be able to\n       pay the card's mana cost.  If payment fails, the card is rolled\n       back from the stack zone to the hand.\n    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n    8. **Push StackObject** — push a :class:`StackObject` whose\n       ``on_resolve`` callback handles resolution.\n\n    Raises:\n        CastingError: If any legality check fails.\n    \"\"\"\n    # 1. Timing\n    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n        )\n\n    # 2. can_cast\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 3. Hand check\n    hand = game.get_hand(player)\n    if not hand.contains(card):\n        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n\n    # 4. Move card from hand to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    hand.remove(card)\n    stack_zone.add(card)\n\n    # Clear any stale colors_spent from a prior cast before new payment.\n    if hasattr(card, \"colors_spent\"):\n        del card.colors_spent\n\n    # 5. Choose targets\n    target_specs = card.get_targets(game)\n    chosen_targets: list[Any] = []\n    if target_specs:\n        for spec in target_specs:\n            target = player.choose_target(target_specs, spec)\n            # Validate against filter_fn if the spec provides one\n            filter_fn = getattr(spec, \"filter_fn\", None)\n            if filter_fn is not None and target is not None:\n                if not filter_fn(target):\n                    stack_zone.remove(card)\n                    hand.add(card)\n                    raise CastingError(\n                        f\"Cannot cast {card.name!r} — chosen target does not \"\n                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                    )\n            chosen_targets.append(target)\n\n    # 5b. Protection check — reject targets that have protection from this\n    #     spell (the T in DEBT).\n    from engine.protection import has_protection_from\n\n    for target in chosen_targets:\n        if has_protection_from(target, card):\n            # Rollback: move card from stack zone back to hand\n            stack_zone.remove(card)\n            hand.add(card)\n            raise CastingError(\n                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n            )\n\n    # Targets are stored on the StackObject (not the card) and passed\n    # through the resolve pipeline via on_resolve(game, targets=...).\n\n    # 6. Mana check / payment (rollback on failure)\n    # Ensure the card knows its controller so that cost_reduction() hooks\n    # (e.g. Embercleave counting attacking creatures you control) see the\n    # casting player, even for cards that were added to hand without an\n    # explicit controller assignment.\n    if card.controller is None:\n        card.controller = player\n    reduction = get_cost_reduction(game, card, player)\n    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n\n    if not player.mana_pool.can_pay(effective_cost):\n        # Rollback: move card from stack zone back to hand\n        stack_zone.remove(card)\n        hand.add(card)\n        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n\n    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n    player.mana_pool.pay(effective_cost)\n\n    # Store colors of mana spent on the card for mechanics like Converge\n    # that care about the colors used to cast the spell.\n    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n\n    # 7. Call on_cast hook\n    card.on_cast(game)\n\n    # 8. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n\n# ------------------------------------------------------------------\n# Cast spell without paying mana cost (free-cast from any zone)\n# ------------------------------------------------------------------\n\n\ndef cast_spell_free(\n    game: GameState,\n    player: Player,\n    card: CardImpl,\n    from_zone: Zone,\n) -> None:\n    \"\"\"Cast *card* without paying its mana cost, using the stack.\n\n    This is used by effects that allow casting from zones other than hand\n    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n    or cascade.\n\n    Pipeline\n    --------\n    1. **can_cast** — ask the card whether it can legally be cast (same\n       legality as :func:`cast_spell`, minus mana/timing constraints).\n    2. Move *card* from *from_zone* to the stack zone.\n    3. Choose targets (if applicable) with validation and protection check.\n    4. Call ``on_cast`` hook.\n    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n       resolution normally (permanents → battlefield, non-permanents →\n       graveyard).\n\n    No timing check or mana payment is performed.  The spell goes on the\n    stack and can be responded to normally (e.g. countered).\n\n    If targeting or other post-move checks fail, the card is rolled back\n    to its source zone.\n\n    Parameters:\n        game: The current game state.\n        player: The player casting the spell.\n        card: The card to cast.\n        from_zone: The zone the card is currently in.\n\n    Raises:\n        CastingError: If the card cannot be found in *from_zone* or\n            legality checks fail.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Ensure controller is set\n    card.controller = player\n    if card.owner is None:\n        card.owner = player\n\n    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 2. Locate card in source zone\n    source_zone_container = player.zones[from_zone]\n    if not source_zone_container.contains(card):\n        # Try to find the card in any player's zone\n        source_zone_container = None\n        for p in game.players:\n            z = p.zones[from_zone]\n            if z.contains(card):\n                source_zone_container = z\n                break\n\n    if source_zone_container is None or not source_zone_container.contains(card):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n        )\n\n    # Move card from source zone to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    source_zone_container.remove(card)\n    stack_zone.add(card)\n\n    # 3. Choose targets (with rollback on failure)\n    try:\n        target_specs = card.get_targets(game)\n        chosen_targets: list[Any] = []\n        if target_specs:\n            for spec in target_specs:\n                target = player.choose_target(target_specs, spec)\n                # Validate against filter_fn if the spec provides one\n                filter_fn = getattr(spec, \"filter_fn\", None)\n                if filter_fn is not None and target is not None:\n                    if not filter_fn(target):\n                        raise CastingError(\n                            f\"Cannot cast {card.name!r} — chosen target does not \"\n                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                        )\n                chosen_targets.append(target)\n\n        # Protection check — reject targets that have protection from this spell\n        from engine.protection import has_protection_from\n\n        for target in chosen_targets:\n            if has_protection_from(target, card):\n                raise CastingError(\n                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n                )\n    except Exception as exc:\n        # Rollback: move card from stack zone back to source zone\n        stack_zone.remove(card)\n        source_zone_container.add(card)\n        raise CastingError(str(exc)) from exc\n\n    # 4. Call on_cast hook\n    card.on_cast(game)\n\n    # 5. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n\n# ------------------------------------------------------------------\n# Resolution (called when the stack pops)\n# ------------------------------------------------------------------\n\ndef _resolve_spell(\n    game: GameState,\n    card: CardImpl,\n    player: Player,\n    stack_obj: StackObject,\n) -> None:\n    \"\"\"Resolve *card* cast by *player*.\n\n    1. Call ``card.on_resolve(game, targets=targets)``.\n    2. Remove the card from the stack zone.\n    3. If the card is a permanent type, move it to the battlefield via\n       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n       registration and the ETB event).\n    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Read targets from the StackObject — the single source of truth.\n    # Set chosen_targets on the card just before resolution so that\n    # _get_chosen_target helpers (which read via getattr) work.\n    targets = stack_obj.targets\n    if targets is not None:\n        card.chosen_targets = targets  # type: ignore[attr-defined]\n\n    card.on_resolve(game)\n\n    if card.card_types & _PERMANENT_TYPES:\n        # Move from stack to battlefield via move_to_zone, which handles\n        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n    else:\n        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n\n\n# ------------------------------------------------------------------\n# Play land (special action — does not use the stack)\n# ------------------------------------------------------------------\n\ndef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n\n    Requirements (all must hold):\n\n    * *land_card* has :attr:`CardType.LAND`.\n    * *player* is the active player.\n    * Current phase is a main phase.\n    * The stack is empty.\n    * ``player.land_plays_remaining > 0``.\n    * The card is in the player's hand.\n\n    On success the card moves from hand to battlefield and\n    ``land_plays_remaining`` is decremented.\n\n    Raises:\n        CastingError: If any requirement is not met.\n    \"\"\"\n    # Must be a land\n    if CardType.LAND not in land_card.card_types:\n        raise CastingError(\n            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n        )\n\n    # Sorcery-speed timing (active player, main phase, stack empty)\n    if not is_sorcery_speed(game, player):\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — must be active player \"\n            \"during main phase with empty stack\"\n        )\n\n    # Land plays remaining\n    if player.land_plays_remaining <= 0:\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n        )\n\n    # Card must be in hand\n    hand = game.get_hand(player)\n    if not hand.contains(land_card):\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — card not in hand\"\n        )\n\n    # Ensure owner/controller are set so move_to_zone routes correctly.\n    if land_card.owner is None:\n        land_card.owner = player\n    land_card.controller = player\n\n    # Move from hand to battlefield via move_to_zone, which fires\n    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n    from engine.zones import move_to_zone\n    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n\n    # Decrement land plays\n    player.land_plays_remaining -= 1\n\n\ndef resolve_top(game: GameState) -> None:\n    \"\"\"Resolve the top spell/ability on the stack.\n\n    Pops the top item from the stack, calls its on_resolve callback,\n    then runs state-based actions.  If the stack is empty this is a no-op.\n    \"\"\"\n    if game.stack.is_empty():\n        return\n    from engine.state_based_actions import resolve_state_based_actions\n\n    obj = game.stack.pop()\n    obj.on_resolve(game)\n    resolve_state_based_actions(game)\n","numLines":488,"startLine":1,"totalLines":488}}}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01PWHtnxszfmANv72a3LDqq1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JCfsgFSCLgfHnf1Q7g3PAg","name":"Read","input":{"file_path":"/workspace/engine/zones.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7603,"cache_read_input_tokens":49386,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7603},"output_tokens":46,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c2218e3f-f535-4885-8855-1c8d61867b45","uuid":"881c0903-8d90-4541-8ec4-d38773c62ee6","request_id":"req_011CbhoJfLK5mEfMjktxDL2A"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JCfsgFSCLgfHnf1Q7g3PAg","type":"tool_result","content":"1\t\"\"\"Zone containers for managing game objects across game zones.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport random\n6\tfrom typing import TYPE_CHECKING, Any\n7\t\n8\tfrom engine.types import CardType, Zone\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t\n13\t\n14\tclass IllegalMoveError(Exception):\n15\t    \"\"\"Raised when a zone move is illegal (e.g. object not found in source zone).\"\"\"\n16\t\n17\t\n18\tclass ZoneContainer:\n19\t    \"\"\"Wraps an ordered list of game-object references for a single zone.\n20\t\n21\t    Internal list convention: index 0 is the *bottom*, index -1 is the *top*.\n22\t    This matches the intuitive model where ``add(obj, position=\"top\")``\n23\t    appends, and ``top(n)`` returns the last *n* items.\n24\t    \"\"\"\n25\t\n26\t    def __init__(self) -> None:\n27\t        self._objects: list[Any] = []\n28\t\n29\t    # ------------------------------------------------------------------\n30\t    # Mutators\n31\t    # ------------------------------------------------------------------\n32\t\n33\t    def add(self, obj: Any, position: str = \"top\") -> None:\n34\t        \"\"\"Add *obj* to this zone.\n35\t\n36\t        Parameters:\n37\t            obj: The game object to add.\n38\t            position: ``\"top\"`` (default) appends to the end of the internal\n39\t                list; ``\"bottom\"`` inserts at position 0.\n40\t        \"\"\"\n41\t        if position == \"top\":\n42\t            self._objects.append(obj)\n43\t        elif position == \"bottom\":\n44\t            self._objects.insert(0, obj)\n45\t        else:\n46\t            raise ValueError(f\"Invalid position: {position!r}; expected 'top' or 'bottom'\")\n47\t\n48\t    def remove(self, obj: Any) -> None:\n49\t        \"\"\"Remove *obj* from this zone (identity-based lookup).\n50\t\n51\t        Raises:\n52\t            ValueError: If *obj* is not in the zone.\n53\t        \"\"\"\n54\t        for i, item in enumerate(self._objects):\n55\t            if item is obj:\n56\t                del self._objects[i]\n57\t                return\n58\t        raise ValueError(f\"{obj!r} not in zone\")\n59\t\n60\t    def shuffle(self) -> None:\n61\t        \"\"\"Randomly shuffle the contents of this zone (used for libraries).\"\"\"\n62\t        random.shuffle(self._objects)\n63\t\n64\t    # ------------------------------------------------------------------\n65\t    # Queries\n66\t    # ------------------------------------------------------------------\n67\t\n68\t    def contains(self, obj: Any) -> bool:\n69\t        \"\"\"Return ``True`` if *obj* is in this zone (identity-based lookup).\"\"\"\n70\t        return any(item is obj for item in self._objects)\n71\t\n72\t    def get_all(self) -> list[Any]:\n73\t        \"\"\"Return a shallow copy of all objects in order (bottom → top).\"\"\"\n74\t        return list(self._objects)\n75\t\n76\t    def top(self, n: int) -> list[Any]:\n77\t        \"\"\"Return the top *n* items (last *n* in the internal list).\n78\t\n79\t        If *n* >= len, returns all items.  Order is bottom-to-top (same\n80\t        orientation as the internal list).\n81\t        \"\"\"\n82\t        if n <= 0:\n83\t            return []\n84\t        return self._objects[-n:]\n85\t\n86\t    def bottom(self, n: int) -> list[Any]:\n87\t        \"\"\"Return the bottom *n* items (first *n* in the internal list).\n88\t\n89\t        If *n* >= len, returns all items.\n90\t        \"\"\"\n91\t        if n <= 0:\n92\t            return []\n93\t        return self._objects[:n]\n94\t\n95\t    def __len__(self) -> int:\n96\t        return len(self._objects)\n97\t\n98\t    def __repr__(self) -> str:\n99\t        return f\"ZoneContainer({self._objects!r})\"\n100\t\n101\t\n102\tclass Zones:\n103\t    \"\"\"Per-player collection mapping each :class:`Zone` to a :class:`ZoneContainer`.\"\"\"\n104\t\n105\t    def __init__(self, zones: dict[Zone, ZoneContainer]) -> None:\n106\t        self._zones = zones\n107\t\n108\t    @classmethod\n109\t    def new_player(cls) -> Zones:\n110\t        \"\"\"Create a fresh set of empty zones for a player.\"\"\"\n111\t        return cls({zone: ZoneContainer() for zone in Zone})\n112\t\n113\t    def __getitem__(self, zone: Zone) -> ZoneContainer:\n114\t        return self._zones[zone]\n115\t\n116\t    def __contains__(self, zone: Zone) -> bool:\n117\t        return zone in self._zones\n118\t\n119\t    def __repr__(self) -> str:\n120\t        return f\"Zones({self._zones!r})\"\n121\t\n122\t\n123\tdef move_zone(\n124\t    obj: Any,\n125\t    from_zone: ZoneContainer,\n126\t    to_zone: ZoneContainer,\n127\t    position: str = \"top\",\n128\t) -> None:\n129\t    \"\"\"Move *obj* from *from_zone* to *to_zone*.\n130\t\n131\t    Parameters:\n132\t        obj: The game object to move.\n133\t        from_zone: Source :class:`ZoneContainer`.\n134\t        to_zone: Destination :class:`ZoneContainer`.\n135\t        position: ``\"top\"`` (default), ``\"bottom\"``, or ``\"shuffle\"``\n136\t            (add then shuffle the destination).\n137\t\n138\t    Raises:\n139\t        IllegalMoveError: If *obj* is not in *from_zone*.\n140\t    \"\"\"\n141\t    # Moving an object to the same zone it's already in is a no-op.\n142\t    if from_zone is to_zone:\n143\t        return\n144\t\n145\t    if not from_zone.contains(obj):\n146\t        raise IllegalMoveError(\n147\t            f\"Object {obj!r} not found in source zone\"\n148\t        )\n149\t\n150\t    # Validate position *before* mutating either zone so that an invalid\n151\t    # position does not leave the object removed from the source without\n152\t    # being added to the destination.\n153\t    if position not in (\"top\", \"bottom\", \"shuffle\"):\n154\t        raise ValueError(f\"Invalid position: {position!r}; expected 'top', 'bottom', or 'shuffle'\")\n155\t\n156\t    from_zone.remove(obj)\n157\t\n158\t    # Clear transient casting metadata when a card changes zones so that\n159\t    # stale data (e.g. colors_spent from a previous cast) does not leak.\n160\t    if hasattr(obj, \"colors_spent\"):\n161\t        del obj.colors_spent\n162\t\n163\t    if position == \"shuffle\":\n164\t        to_zone.add(obj, position=\"top\")\n165\t        to_zone.shuffle()\n166\t    else:\n167\t        to_zone.add(obj, position=position)\n168\t\n169\t\n170\t# Mapping from replacement-effect destination strings to Zone enum values.\n171\t_DESTINATION_ZONE_MAP: dict[str, Zone] = {\n172\t    \"graveyard\": Zone.GRAVEYARD,\n173\t    \"exile\": Zone.EXILE,\n174\t    \"hand\": Zone.HAND,\n175\t    \"library\": Zone.LIBRARY,\n176\t}\n177\t\n178\t\n179\tdef move_to_zone(\n180\t    game: GameState,\n181\t    card: Any,\n182\t    from_zone: Zone,\n183\t    to_zone: Zone,\n184\t    *,\n185\t    replacement_event: Any | None = None,\n186\t) -> None:\n187\t    \"\"\"High-level zone transition with trigger/replacement-effect hooks.\n188\t\n189\t    Centralises the bookkeeping that was previously duplicated across\n190\t    ``destroy()``, ``sacrifice()``, ``exile()``, ``create_token()``,\n191\t    ``_move_to_graveyard()`` (SBAs), and ``_resolve_spell()`` (casting).\n192\t\n193\t    Steps:\n194\t    1. Consult replacement effects for zone-change redirection (if\n195\t       *replacement_event* is supplied and the card is leaving the\n196\t       battlefield).  The replacement may change the destination zone\n197\t       (e.g. exile instead of graveyard) or set ``prevented = True`` to\n198\t       signal that it handled the zone move directly.\n199\t    2. Remove *card* from the source zone.\n200\t    3. Add *card* to the (possibly redirected) destination zone.\n201\t    4. If leaving the battlefield:\n202\t       a. Fire ``LeavesBattlefieldTriggeredEvent``.\n203\t       b. Fire ``CreatureDiesTriggeredEvent`` if the card is a creature\n204\t          **and** the final destination is the graveyard.\n205\t       c. Unregister triggers and replacement effects (fires happen\n206\t          **before** unregister so self-referencing triggers still match).\n207\t    5. If entering the battlefield:\n208\t       a. Register triggers (``register_triggers``) and replacement\n209\t          effects (``register_replacement_effects``).\n210\t       b. Fire ``EntersBattlefieldTriggeredEvent``.\n211\t\n212\t    Parameters:\n213\t        game: The current game state.\n214\t        card: The game object being moved.\n215\t        from_zone: The :class:`Zone` the card is currently in.\n216\t        to_zone: The intended destination :class:`Zone`.\n217\t        replacement_event: Optional typed replacement-event object\n218\t            (e.g. ``CreatureDiesReplacementEvent``).  When ``None``,\n219\t            no replacement effects are consulted (useful for simple\n220\t            moves like casting resolution or exile-from-graveyard).\n221\t    \"\"\"\n222\t    from engine.events import (\n223\t        CreatureDiesTriggeredEvent,\n224\t        EntersBattlefieldTriggeredEvent,\n225\t        LeavesBattlefieldTriggeredEvent,\n226\t    )\n227\t\n228\t    controller = getattr(card, \"controller\", None)\n229\t    owner = getattr(card, \"owner\", controller)\n230\t\n231\t    leaving_battlefield = from_zone == Zone.BATTLEFIELD\n232\t    entering_battlefield = to_zone == Zone.BATTLEFIELD\n233\t\n234\t    # --- Determine the source player for zone lookup ---\n235\t    # When leaving the battlefield, use the controller's zone.\n236\t    # For other zones (hand, graveyard, etc.), use the owner's zone.\n237\t    if leaving_battlefield:\n238\t        source_player = controller\n239\t    else:\n240\t        source_player = owner\n241\t\n242\t    # Fallback: search all players for the zone containing the card.\n243\t    # Also triggered when the inferred player's zone doesn't contain the card\n244\t    # (e.g. discarding a card that's in a different player's hand than its owner).\n245\t    if source_player is None or not source_player.zones[from_zone].contains(card):\n246\t        for player in game.players:\n247\t            if player.zones[from_zone].contains(card):\n248\t                source_player = player\n249\t                break\n250\t\n251\t    if source_player is None:\n252\t        return  # Card not found anywhere\n253\t\n254\t    source_container = source_player.zones[from_zone]\n255\t    if not source_container.contains(card):\n256\t        return  # Safety: card not in any player's zone\n257\t\n258\t    if owner is None:\n259\t        owner = source_player\n260\t\n261\t    # --- Replacement effects (zone-change redirection) ---\n262\t    dest_zone = to_zone\n263\t    if replacement_event is not None and leaving_battlefield:\n264\t        replacement_event = game.replacement_manager.apply(game, replacement_event)\n265\t        if getattr(replacement_event, \"prevented\", False):\n266\t            return\n267\t        destination_str = getattr(replacement_event, \"destination\", \"graveyard\")\n268\t        dest_zone = _DESTINATION_ZONE_MAP.get(destination_str, to_zone)\n269\t\n270\t    # --- Perform the zone move ---\n271\t    source_container.remove(card)\n272\t\n273\t    # Determine the destination player (always the owner for graveyard/exile/hand/library).\n274\t    if entering_battlefield:\n275\t        dest_player = controller if controller is not None else owner\n276\t    else:\n277\t        dest_player = owner\n278\t\n279\t    dest_player.zones[dest_zone].add(card)\n280\t\n281\t    # --- Leaving battlefield hooks ---\n282\t    if leaving_battlefield:\n283\t        card_types = getattr(card, \"card_types\", set())\n284\t        is_creature = CardType.CREATURE in card_types\n285\t\n286\t        # Fire events BEFORE unregistering (KEY_DECISIONS convention).\n287\t        game.trigger_manager.fire_event(\n288\t            game,\n289\t            LeavesBattlefieldTriggeredEvent(permanent=card, controller=controller),\n290\t        )\n291\t        if is_creature and dest_zone == Zone.GRAVEYARD:\n292\t            game.trigger_manager.fire_event(\n293\t                game,\n294\t                CreatureDiesTriggeredEvent(creature=card, controller=controller, owner=owner),\n295\t            )\n296\t\n297\t        # Now unregister triggers and replacement effects.\n298\t        game.trigger_manager.unregister(card)\n299\t        game.replacement_manager.unregister(card)\n300\t\n301\t    # --- Entering battlefield hooks ---\n302\t    if entering_battlefield:\n303\t        # Fire the ENTERS_BATTLEFIELD event *before* registering the card's\n304\t        # own triggers so that a permanent's ETB trigger does not\n305\t        # retroactively trigger off its own entry.  Other already-registered\n306\t        # triggers that watch for ENTERS_BATTLEFIELD will still fire.\n307\t        game.trigger_manager.fire_event(\n308\t            game,\n309\t            EntersBattlefieldTriggeredEvent(\n310\t                permanent=card,\n311\t                controller=controller if controller is not None else owner,\n312\t            ),\n313\t        )\n314\t        if hasattr(card, \"register_triggers\"):\n315\t            card.register_triggers(game)\n316\t        if hasattr(card, \"register_replacement_effects\"):\n317\t            card.register_replacement_effects(game)\n318\t\n319\t\n320\t# Destination string → Zone for replacement-effect zone redirection.\n321\t_DESTINATION_ZONE_MAP: dict[str, Zone] = {\n322\t    \"graveyard\": Zone.GRAVEYARD,\n323\t    \"exile\": Zone.EXILE,\n324\t    \"hand\": Zone.HAND,\n325\t    \"library\": Zone.LIBRARY,\n326\t}\n327\t"}]},"parent_tool_use_id":null,"session_id":"c2218e3f-f535-4885-8855-1c8d61867b45","uuid":"82f6a572-c1a8-495d-ab4f-565dab451086","timestamp":"2026-06-04T07:08:36.069Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/zones.py","content":"\"\"\"Zone containers for managing game objects across game zones.\"\"\"\n\nfrom __future__ import annotations\n\nimport random\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.types import CardType, Zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\nclass IllegalMoveError(Exception):\n    \"\"\"Raised when a zone move is illegal (e.g. object not found in source zone).\"\"\"\n\n\nclass ZoneContainer:\n    \"\"\"Wraps an ordered list of game-object references for a single zone.\n\n    Internal list convention: index 0 is the *bottom*, index -1 is the *top*.\n    This matches the intuitive model where ``add(obj, position=\"top\")``\n    appends, and ``top(n)`` returns the last *n* items.\n    \"\"\"\n\n    def __init__(self) -> None:\n        self._objects: list[Any] = []\n\n    # ------------------------------------------------------------------\n    # Mutators\n    # ------------------------------------------------------------------\n\n    def add(self, obj: Any, position: str = \"top\") -> None:\n        \"\"\"Add *obj* to this zone.\n\n        Parameters:\n            obj: The game object to add.\n            position: ``\"top\"`` (default) appends to the end of the internal\n                list; ``\"bottom\"`` inserts at position 0.\n        \"\"\"\n        if position == \"top\":\n            self._objects.append(obj)\n        elif position == \"bottom\":\n            self._objects.insert(0, obj)\n        else:\n            raise ValueError(f\"Invalid position: {position!r}; expected 'top' or 'bottom'\")\n\n    def remove(self, obj: Any) -> None:\n        \"\"\"Remove *obj* from this zone (identity-based lookup).\n\n        Raises:\n            ValueError: If *obj* is not in the zone.\n        \"\"\"\n        for i, item in enumerate(self._objects):\n            if item is obj:\n                del self._objects[i]\n                return\n        raise ValueError(f\"{obj!r} not in zone\")\n\n    def shuffle(self) -> None:\n        \"\"\"Randomly shuffle the contents of this zone (used for libraries).\"\"\"\n        random.shuffle(self._objects)\n\n    # ------------------------------------------------------------------\n    # Queries\n    # ------------------------------------------------------------------\n\n    def contains(self, obj: Any) -> bool:\n        \"\"\"Return ``True`` if *obj* is in this zone (identity-based lookup).\"\"\"\n        return any(item is obj for item in self._objects)\n\n    def get_all(self) -> list[Any]:\n        \"\"\"Return a shallow copy of all objects in order (bottom → top).\"\"\"\n        return list(self._objects)\n\n    def top(self, n: int) -> list[Any]:\n        \"\"\"Return the top *n* items (last *n* in the internal list).\n\n        If *n* >= len, returns all items.  Order is bottom-to-top (same\n        orientation as the internal list).\n        \"\"\"\n        if n <= 0:\n            return []\n        return self._objects[-n:]\n\n    def bottom(self, n: int) -> list[Any]:\n        \"\"\"Return the bottom *n* items (first *n* in the internal list).\n\n        If *n* >= len, returns all items.\n        \"\"\"\n        if n <= 0:\n            return []\n        return self._objects[:n]\n\n    def __len__(self) -> int:\n        return len(self._objects)\n\n    def __repr__(self) -> str:\n        return f\"ZoneContainer({self._objects!r})\"\n\n\nclass Zones:\n    \"\"\"Per-player collection mapping each :class:`Zone` to a :class:`ZoneContainer`.\"\"\"\n\n    def __init__(self, zones: dict[Zone, ZoneContainer]) -> None:\n        self._zones = zones\n\n    @classmethod\n    def new_player(cls) -> Zones:\n        \"\"\"Create a fresh set of empty zones for a player.\"\"\"\n        return cls({zone: ZoneContainer() for zone in Zone})\n\n    def __getitem__(self, zone: Zone) -> ZoneContainer:\n        return self._zones[zone]\n\n    def __contains__(self, zone: Zone) -> bool:\n        return zone in self._zones\n\n    def __repr__(self) -> str:\n        return f\"Zones({self._zones!r})\"\n\n\ndef move_zone(\n    obj: Any,\n    from_zone: ZoneContainer,\n    to_zone: ZoneContainer,\n    position: str = \"top\",\n) -> None:\n    \"\"\"Move *obj* from *from_zone* to *to_zone*.\n\n    Parameters:\n        obj: The game object to move.\n        from_zone: Source :class:`ZoneContainer`.\n        to_zone: Destination :class:`ZoneContainer`.\n        position: ``\"top\"`` (default), ``\"bottom\"``, or ``\"shuffle\"``\n            (add then shuffle the destination).\n\n    Raises:\n        IllegalMoveError: If *obj* is not in *from_zone*.\n    \"\"\"\n    # Moving an object to the same zone it's already in is a no-op.\n    if from_zone is to_zone:\n        return\n\n    if not from_zone.contains(obj):\n        raise IllegalMoveError(\n            f\"Object {obj!r} not found in source zone\"\n        )\n\n    # Validate position *before* mutating either zone so that an invalid\n    # position does not leave the object removed from the source without\n    # being added to the destination.\n    if position not in (\"top\", \"bottom\", \"shuffle\"):\n        raise ValueError(f\"Invalid position: {position!r}; expected 'top', 'bottom', or 'shuffle'\")\n\n    from_zone.remove(obj)\n\n    # Clear transient casting metadata when a card changes zones so that\n    # stale data (e.g. colors_spent from a previous cast) does not leak.\n    if hasattr(obj, \"colors_spent\"):\n        del obj.colors_spent\n\n    if position == \"shuffle\":\n        to_zone.add(obj, position=\"top\")\n        to_zone.shuffle()\n    else:\n        to_zone.add(obj, position=position)\n\n\n# Mapping from replacement-effect destination strings to Zone enum values.\n_DESTINATION_ZONE_MAP: dict[str, Zone] = {\n    \"graveyard\": Zone.GRAVEYARD,\n    \"exile\": Zone.EXILE,\n    \"hand\": Zone.HAND,\n    \"library\": Zone.LIBRARY,\n}\n\n\ndef move_to_zone(\n    game: GameState,\n    card: Any,\n    from_zone: Zone,\n    to_zone: Zone,\n    *,\n    replacement_event: Any | None = None,\n) -> None:\n    \"\"\"High-level zone transition with trigger/replacement-effect hooks.\n\n    Centralises the bookkeeping that was previously duplicated across\n    ``destroy()``, ``sacrifice()``, ``exile()``, ``create_token()``,\n    ``_move_to_graveyard()`` (SBAs), and ``_resolve_spell()`` (casting).\n\n    Steps:\n    1. Consult replacement effects for zone-change redirection (if\n       *replacement_event* is supplied and the card is leaving the\n       battlefield).  The replacement may change the destination zone\n       (e.g. exile instead of graveyard) or set ``prevented = True`` to\n       signal that it handled the zone move directly.\n    2. Remove *card* from the source zone.\n    3. Add *card* to the (possibly redirected) destination zone.\n    4. If leaving the battlefield:\n       a. Fire ``LeavesBattlefieldTriggeredEvent``.\n       b. Fire ``CreatureDiesTriggeredEvent`` if the card is a creature\n          **and** the final destination is the graveyard.\n       c. Unregister triggers and replacement effects (fires happen\n          **before** unregister so self-referencing triggers still match).\n    5. If entering the battlefield:\n       a. Register triggers (``register_triggers``) and replacement\n          effects (``register_replacement_effects``).\n       b. Fire ``EntersBattlefieldTriggeredEvent``.\n\n    Parameters:\n        game: The current game state.\n        card: The game object being moved.\n        from_zone: The :class:`Zone` the card is currently in.\n        to_zone: The intended destination :class:`Zone`.\n        replacement_event: Optional typed replacement-event object\n            (e.g. ``CreatureDiesReplacementEvent``).  When ``None``,\n            no replacement effects are consulted (useful for simple\n            moves like casting resolution or exile-from-graveyard).\n    \"\"\"\n    from engine.events import (\n        CreatureDiesTriggeredEvent,\n        EntersBattlefieldTriggeredEvent,\n        LeavesBattlefieldTriggeredEvent,\n    )\n\n    controller = getattr(card, \"controller\", None)\n    owner = getattr(card, \"owner\", controller)\n\n    leaving_battlefield = from_zone == Zone.BATTLEFIELD\n    entering_battlefield = to_zone == Zone.BATTLEFIELD\n\n    # --- Determine the source player for zone lookup ---\n    # When leaving the battlefield, use the controller's zone.\n    # For other zones (hand, graveyard, etc.), use the owner's zone.\n    if leaving_battlefield:\n        source_player = controller\n    else:\n        source_player = owner\n\n    # Fallback: search all players for the zone containing the card.\n    # Also triggered when the inferred player's zone doesn't contain the card\n    # (e.g. discarding a card that's in a different player's hand than its owner).\n    if source_player is None or not source_player.zones[from_zone].contains(card):\n        for player in game.players:\n            if player.zones[from_zone].contains(card):\n                source_player = player\n                break\n\n    if source_player is None:\n        return  # Card not found anywhere\n\n    source_container = source_player.zones[from_zone]\n    if not source_container.contains(card):\n        return  # Safety: card not in any player's zone\n\n    if owner is None:\n        owner = source_player\n\n    # --- Replacement effects (zone-change redirection) ---\n    dest_zone = to_zone\n    if replacement_event is not None and leaving_battlefield:\n        replacement_event = game.replacement_manager.apply(game, replacement_event)\n        if getattr(replacement_event, \"prevented\", False):\n            return\n        destination_str = getattr(replacement_event, \"destination\", \"graveyard\")\n        dest_zone = _DESTINATION_ZONE_MAP.get(destination_str, to_zone)\n\n    # --- Perform the zone move ---\n    source_container.remove(card)\n\n    # Determine the destination player (always the owner for graveyard/exile/hand/library).\n    if entering_battlefield:\n        dest_player = controller if controller is not None else owner\n    else:\n        dest_player = owner\n\n    dest_player.zones[dest_zone].add(card)\n\n    # --- Leaving battlefield hooks ---\n    if leaving_battlefield:\n        card_types = getattr(card, \"card_types\", set())\n        is_creature = CardType.CREATURE in card_types\n\n        # Fire events BEFORE unregistering (KEY_DECISIONS convention).\n        game.trigger_manager.fire_event(\n            game,\n            LeavesBattlefieldTriggeredEvent(permanent=card, controller=controller),\n        )\n        if is_creature and dest_zone == Zone.GRAVEYARD:\n            game.trigger_manager.fire_event(\n                game,\n                CreatureDiesTriggeredEvent(creature=card, controller=controller, owner=owner),\n            )\n\n        # Now unregister triggers and replacement effects.\n        game.trigger_manager.unregister(card)\n        game.replacement_manager.unregister(card)\n\n    # --- Entering battlefield hooks ---\n    if entering_battlefield:\n        # Fire the ENTERS_BATTLEFIELD event *before* registering the card's\n        # own triggers so that a permanent's ETB trigger does not\n        # retroactively trigger off its own entry.  Other already-registered\n        # triggers that watch for ENTERS_BATTLEFIELD will still fire.\n        game.trigger_manager.fire_event(\n            game,\n            EntersBattlefieldTriggeredEvent(\n                permanent=card,\n                controller=controller if controller is not None else owner,\n            ),\n        )\n        if hasattr(card, \"register_triggers\"):\n            card.register_triggers(game)\n        if hasattr(card, \"register_replacement_effects\"):\n            card.register_replacement_effects(game)\n\n\n# Destination string → Zone for replacement-effect zone redirection.\n_DESTINATION_ZONE_MAP: dict[str, Zone] = {\n    \"graveyard\": Zone.GRAVEYARD,\n    \"exile\": Zone.EXILE,\n    \"hand\": Zone.HAND,\n    \"library\": Zone.LIBRARY,\n}\n","numLines":327,"startLine":1,"totalLines":327}}}
