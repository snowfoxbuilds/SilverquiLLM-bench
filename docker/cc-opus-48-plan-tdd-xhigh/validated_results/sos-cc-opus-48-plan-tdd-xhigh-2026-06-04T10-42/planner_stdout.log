, then discard a card.\\n−2: Create a 2/1 blue Ninja creature token.\\n−9: You get an emblem with \"Whenever a player casts a spell, you create a 2/1 blue Ninja creature token.\"')\n33\t        super().__init__(**kwargs)\n34\t\n35\t    def register_triggers(self, game: Any) -> None:\n36\t        \"\"\"Register passive: combat damage to a player → loyalty counter.\"\"\"\n37\t        from engine.game import add_counter\n38\t        from engine.triggers import TriggerRegistration\n39\t        pw = self\n40\t        controller = getattr(self, 'controller', None) or game.active_player\n41\t\n42\t        def _combat_damage_condition(game: Any, event: dict) -> bool:\n43\t            \"\"\"Fire when a creature controlled by Kaito's controller deals damage to a player.\"\"\"\n44\t            source = event.source\n45\t            target = event.target\n46\t            if not event.combat:\n47\t                return False\n48\t            if source is None or target is None:\n49\t                return False\n50\t            source_types = getattr(source, 'card_types', set())\n51\t            if CardType.CREATURE not in source_types:\n52\t                return False\n53\t            if getattr(source, 'controller', None) is not pw.controller:\n54\t                return False\n55\t            if not hasattr(target, 'life'):\n56\t                return False\n57\t            return True\n58\t\n59\t        def _combat_damage_effect(game: Any) -> None:\n60\t            \"\"\"Put a loyalty counter on Kaito.\"\"\"\n61\t            add_counter(game, pw, 'loyalty', 1)\n62\t        game.trigger_manager.register(TriggerRegistration(event_type=DealsDamageTriggeredEvent, condition=_combat_damage_condition, effect=_combat_damage_effect, source=self, controller=controller))\n63\t\n64\t    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n65\t        pw = self\n66\t\n67\t        def _plus1(game: Any) -> None:\n68\t            \"\"\"Up to one target creature can't be blocked. Draw