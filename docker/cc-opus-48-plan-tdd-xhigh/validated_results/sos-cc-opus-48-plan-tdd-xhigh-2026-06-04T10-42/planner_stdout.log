{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Jc5EN4SCV2TyoCvtxd7SRF","type":"tool_result","content":"1\t\"\"\"State-based actions checker and resolver.\n2\t\n3\tState-based actions (SBAs) are game rules that are checked and applied\n4\tautomatically whenever a player would receive priority.  They are checked\n5\trepeatedly until no more actions are taken, at which point triggered\n6\tabilities are placed on the stack.\n7\t\n8\tReferences: MTG Comprehensive Rules §704.\n9\t\"\"\"\n10\t\n11\tfrom __future__ import annotations\n12\t\n13\tfrom collections import defaultdict\n14\tfrom typing import TYPE_CHECKING, Any\n15\t\n16\tfrom engine.events import CreatureDiesReplacementEvent\n17\tfrom engine.types import CardType, Supertype, Zone\n18\tfrom engine.zones import ZoneContainer\n19\t\n20\tif TYPE_CHECKING:\n21\t    from engine.game_state import GameState\n22\t    from engine.player import Player\n23\t\n24\t\n25\t# ---------------------------------------------------------------------------\n26\t# Internal helpers\n27\t# ---------------------------------------------------------------------------\n28\t\n29\tdef _battlefield(game: GameState, player: Player) -> ZoneContainer:\n30\t    \"\"\"Return *player*'s battlefield zone.\"\"\"\n31\t    return player.zones[Zone.BATTLEFIELD]\n32\t\n33\t\n34\tdef _graveyard(game: GameState, player: Player) -> ZoneContainer:\n35\t    \"\"\"Return *player*'s graveyard zone.\"\"\"\n36\t    return player.zones[Zone.GRAVEYARD]\n37\t\n38\t\n39\tdef _move_to_graveyard(game: GameState, player: Player, obj: Any) -> None:\n40\t    \"\"\"Move *obj* from the battlefield to its owner's graveyard (or a\n41\t    replacement destination).\n42\t\n43\t    Delegates to :func:`~engine.zones.move_to_zone` which handles\n44\t    replacement effects, event firing (``LEAVES_BATTLEFIELD``,\n45\t    ``CREATURE_DIES``), and trigger/effect unregistration.\n46\t    \"\"\"\n47\t    from engine.zones import move_to_zone\n48\t\n49\t    bf = _battlefield(game, player)\n50\t    if bf.contains(obj):\n51\t        controller = getattr(obj, \"controller\", player)\n52\t        owner = getattr(obj, \"owner\", controller)\n53\t        move_to_zone(\n54\t            game,\n55\t            obj,\n56\t            Zone.BATTLEFIELD,\n57\t            Zone.GRAVEYARD,\n58\t            replacement_event=CreatureDiesReplacementEvent(\n59\t                creature=obj, destination=\"graveyard\",\n60\t                controller=controller, owner=owner,\n61\t            ),\n62\t        )\n63\t\n64\t\n65\t\n66\tdef _owner_of(game: GameState, obj: Any) -> Player:\n67\t    \"\"\"Return the owner of *obj*.\n68\t\n69\t    Falls back to checking which player's battlefield contains the object,\n70\t    then defaults to the first player.\n71\t    \"\"\"\n72\t    if hasattr(obj, \"owner\"):\n73\t        return obj.owner\n74\t    # Fallback: check each player's battlefield\n75\t    for player in game.players:\n76\t        if _battlefield(game, player).contains(obj):\n77\t            return player\n78\t    return game.players[0]\n79\t\n80\t\n81\t# ---------------------------------------------------------------------------\n82\t# Individual SBA checks\n83\t# ---------------------------------------------------------------------------\n84\t\n85\tdef _sba_player_life_zero(game: GameState) -> bool:\n86\t    \"\"\"A player with 0 or less life loses the game.\"\"\"\n87\t    action_taken = False\n88\t    for player in game.players:\n89\t        if player.life <= 0 and not player.has_lost:\n90\t            player.has_lost = True\n91\t            action_taken = True\n92\t    return action_taken\n93\t\n94\t\n95\tdef _sba_creature_zero_toughness(game: GameState) -> bool:\n96\t    \"\"\"A creature with toughness 0 or less is put into its owner's graveyard.\"\"\"\n97\t    action_taken = False\n98\t    to_remove: list[tuple[Player, Any]] = []\n99\t    for player in game.players:\n100\t        for obj in _battlefield(game, player).get_all():\n101\t            if hasattr(obj, \"toughness\") and obj.toughness <= 0:\n102\t                to_remove.append((player, obj))\n103\t    for player, obj in to_remove:\n104\t        _move_to_graveyard(game, player, obj)\n105\t        action_taken = True\n106\t    return action_taken\n107\t\n108\t\n109\tdef _sba_creature_lethal_damage(game: GameState) -> bool:\n110\t    \"\"\"A creature with lethal damage marked on it is destroyed (moved to graveyard).\n111\t\n112\t    Lethal damage means ``damage_marked >= toughness`` (rule 704.5g) or the\n113\t    creature has been dealt damage by a source with deathtouch and has any\n114\t    damage marked on it (rule 704.5h).  Creatures with the ``indestructible``\n115\t    keyword are skipped.\n116\t    \"\"\"\n117\t    action_taken = False\n118\t    to_remove: list[tuple[Player, Any]] = []\n119\t    for player in game.players:\n120\t        for obj in _battlefield(game, player).get_all():\n121\t            if not hasattr(obj, \"toughness\") or not hasattr(obj, \"damage_marked\"):\n122\t                continue\n123\t\n124\t            # Skip indestructible creatures\n125\t            if hasattr(obj, \"keywords\"):\n126\t                from engine.types import Keyword\n127\t\n128\t                if Keyword.INDESTRUCTIBLE in obj.keywords:\n129\t                    continue\n130\t\n131\t            lethal = obj.damage_marked >= obj.toughness\n132\t            # Rule 704.5h: creature dealt damage by a deathtouch source\n133\t            deathtouch_lethal = (\n134\t                getattr(obj, \"dealt_deathtouch_damage\", False)\n135\t                and obj.damage_marked > 0\n136\t            )\n137\t\n138\t            if lethal or deathtouch_lethal:\n139\t                to_remove.append((player, obj))\n140\t\n141\t    for player, obj in to_remove:\n142\t        _move_to_graveyard(game, player, obj)\n143\t        action_taken = True\n144\t    return action_taken\n145\t\n146\t\n147\tdef _sba_draw_from_empty_library(game: GameState) -> bool:\n148\t    \"\"\"A player who attempted to draw from an empty library loses the game.\"\"\"\n149\t    action_taken = False\n150\t    for player in game.players:\n151\t        if (\n152\t            hasattr(player, \"drawn_from_empty_library\")\n153\t            and player.drawn_from_empty_library\n154\t            and not player.has_lost\n155\t        ):\n156\t            player.has_lost = True\n157\t            action_taken = True\n158\t    return action_taken\n159\t\n160\t\n161\tdef _sba_legend_rule(game: GameState) -> bool:\n162\t    \"\"\"If a player controls 2+ legendaries with the same name, they choose one to keep.\n163\t\n164\t    The player is asked to choose which legendary permanent to keep via\n165\t    ``player.choose()``.  All others are moved to the graveyard.\n166\t    \"\"\"\n167\t    action_taken = False\n168\t    for player in game.players:\n169\t        bf = _battlefield(game, player)\n170\t        legendaries: dict[str, list[Any]] = defaultdict(list)\n171\t        for obj in bf.get_all():\n172\t            if (\n173\t                hasattr(obj, \"supertypes\")\n174\t                and Supertype.LEGENDARY in obj.supertypes\n175\t                and hasattr(obj, \"name\")\n176\t            ):\n177\t                legendaries[obj.name].append(obj)\n178\t        for name, objs in legendaries.items():\n179\t            if len(objs) >= 2:\n180\t                # Let the player choose which to keep\n181\t                keep = player.choose(objs, f\"legend rule: choose which {name!r} to keep\")\n182\t                for obj in objs:\n183\t                    if obj is not keep:\n184\t                        _move_to_graveyard(game, player, obj)\n185\t                action_taken = True\n186\t    return action_taken\n187\t\n188\t\n189\tdef _sba_token_not_on_battlefield(game: GameState) -> bool:\n190\t    \"\"\"Tokens that are not on the battlefield cease to exist (removed from game).\n191\t\n192\t    Checks all non-battlefield zones for tokens and removes them entirely.\n193\t    \"\"\"\n194\t    action_taken = False\n195\t    non_battlefield_zones = [\n196\t        Zone.HAND,\n197\t        Zone.GRAVEYARD,\n198\t        Zone.LIBRARY,\n199\t        Zone.EXILE,\n200\t        Zone.STACK,\n201\t        Zone.COMMAND,\n202\t    ]\n203\t    for player in game.players:\n204\t        for zone_type in non_battlefield_zones:\n205\t            zone = player.zones[zone_type]\n206\t            tokens = [\n207\t                obj\n208\t                for obj in zone.get_all()\n209\t                if hasattr(obj, \"is_token\") and obj.is_token\n210\t            ]\n211\t            for token in tokens:\n212\t                zone.remove(token)\n213\t                action_taken = True\n214\t    return action_taken\n215\t\n216\t\n217\tdef _attachment_illegal_due_to_protection(obj: Any) -> bool:\n218\t    \"\"\"Return ``True`` if *obj* (aura or equipment) is illegally attached due to protection.\"\"\"\n219\t    attached = getattr(obj, \"attached_to\", None)\n220\t    if attached is None:\n221\t        return False\n222\t    from engine.protection import has_protection_from\n223\t    return has_protection_from(attached, obj)\n224\t\n225\t\n226\tdef _sba_aura_unattached(game: GameState) -> bool:\n227\t    \"\"\"An Aura or Equipment not attached to a legal object is put into its\n228\t    owner's graveyard.\n229\t\n230\t    An attachment is considered illegally attached if:\n231\t    - It has an ``attached_to`` attribute that is ``None``, OR\n232\t    - The object it is attached to is no longer on the battlefield, OR\n233\t    - The enchanted/equipped permanent has protection from the attachment.\n234\t    \"\"\"\n235\t    action_taken = False\n236\t    to_remove: list[tuple[Player, Any]] = []\n237\t\n238\t    # Collect all objects on all battlefields for checking attachment legality\n239\t    all_on_battlefield: set[int] = set()\n240\t    for player in game.players:\n241\t        for obj in _battlefield(game, player).get_all():\n242\t            all_on_battlefield.add(id(obj))\n243\t\n244\t    to_unattach: list[Any] = []  # Equipment just becomes unattached\n245\t\n246\t    for player in game.players:\n247\t        for obj in _battlefield(game, player).get_all():\n248\t            is_aura = getattr(obj, \"is_aura\", False)\n249\t            is_equipment = getattr(obj, \"is_equipment\", False)\n250\t            if not hasattr(obj, \"attached_to\"):\n251\t                continue\n252\t            if is_aura:\n253\t                target = obj.attached_to\n254\t                if target is None or id(target) not in all_on_battlefield:\n255\t                    to_remove.append((player, obj))\n256\t                elif _attachment_illegal_due_to_protection(obj):\n257\t                    to_remove.append((player, obj))\n258\t            elif is_equipment:\n259\t                target = obj.attached_to\n260\t                if target is not None and _attachment_illegal_due_to_protection(obj):\n261\t                    to_unattach.append(obj)\n262\t\n263\t    for player, obj in to_remove:\n264\t        _move_to_graveyard(game, player, obj)\n265\t        action_taken = True\n266\t    for obj in to_unattach:\n267\t        obj.attached_to = None\n268\t        action_taken = True\n269\t    return action_taken\n270\t\n271\t\n272\tdef _sba_counter_annihilation(game: GameState) -> bool:\n273\t    \"\"\"+1/+1 and -1/-1 counters on the same permanent annihilate in pairs.\"\"\"\n274\t    action_taken = False\n275\t    for player in game.players:\n276\t        for obj in _battlefield(game, player).get_all():\n277\t            if (\n278\t                hasattr(obj, \"plus_one_counters\")\n279\t                and hasattr(obj, \"minus_one_counters\")\n280\t            ):\n281\t                plus = obj.plus_one_counters\n282\t                minus = obj.minus_one_counters\n283\t                if plus > 0 and minus > 0:\n284\t                    annihilate = min(plus, minus)\n285\t                    obj.plus_one_counters -= annihilate\n286\t                    obj.minus_one_counters -= annihilate\n287\t                    action_taken = True\n288\t    return action_taken\n289\t\n290\t\n291\t# ---------------------------------------------------------------------------\n292\t# Public API\n293\t# ---------------------------------------------------------------------------\n294\t\n295\tdef check_state_based_actions(game: GameState) -> bool:\n296\t    \"\"\"Perform a single pass of all state-based actions.\n297\t\n298\t    Returns ``True`` if any action was taken during this pass.  The caller\n299\t    should invoke this repeatedly until it returns ``False`` to ensure the\n300\t    game state is fully stable.\n301\t    \"\"\"\n302\t    action_taken = False\n303\t    # Player with 0 or less life loses\n304\t    action_taken = _sba_player_life_zero(game) or action_taken\n305\t    # Creature with toughness 0 or less → graveyard\n306\t    action_taken = _sba_creature_zero_toughness(game) or action_taken\n307\t    # Creature with lethal damage → destroyed\n308\t    action_taken = _sba_creature_lethal_damage(game) or action_taken\n309\t    # Player who drew from empty library loses\n310\t    action_taken = _sba_draw_from_empty_library(game) or action_taken\n311\t    # Legend rule\n312\t    action_taken = _sba_legend_rule(game) or action_taken\n313\t    # Token not on battlefield → ceases to exist\n314\t    action_taken = _sba_token_not_on_battlefield(game) or action_taken\n315\t    # Aura not attached to legal object → graveyard\n316\t    action_taken = _sba_aura_unattached(game) or action_taken\n317\t    # +1/+1 and -1/-1 counter annihilation\n318\t    action_taken = _sba_counter_annihilation(game) or action_taken\n319\t    return action_taken\n320\t\n321\t\n322\tdef resolve_state_based_actions(game: GameState) -> bool:\n323\t    \"\"\"Run state-based actions in a loop until no more actions are taken.\n324\t\n325\t    After each SBA stabilisation pass, any triggered abilities that were\n326\t    queued during processing are left on the stack.  Per MTG rule 704.3,\n327\t    the SBA loop must repeat if new triggers were placed on the stack\n328\t    (because those triggers may cause further SBAs when resolved, and\n329\t    the game state must be fully stable before a player receives priority).\n330\t\n331\t    The outer loop: repeat { run SBA passes until stable; record whether\n332\t    new triggers were pushed onto the stack during those passes } until\n333\t    no SBAs were performed **and** no new triggers were queued.\n334\t\n335\t    Returns ``True`` if any SBAs were performed during the entire process,\n336\t    ``False`` if the game state was already stable.\n337\t    \"\"\"\n338\t    any_performed = False\n339\t    while True:\n340\t        # Snapshot the stack size before SBA passes so we can detect new\n341\t        # triggers that were pushed during processing.\n342\t        stack_size_before = len(game.stack)\n343\t\n344\t        # Inner loop: run SBA checks until no more actions are taken.\n345\t        sba_this_round = False\n346\t        while check_state_based_actions(game):\n347\t            sba_this_round = True\n348\t            any_performed = True\n349\t\n350\t        # Detect whether any triggers were queued during this round.\n351\t        triggers_queued = len(game.stack) > stack_size_before\n352\t\n353\t        # If nothing happened this round (no SBAs and no new triggers),\n354\t        # the game state is fully stable.\n355\t        if not sba_this_round and not triggers_queued:\n356\t            break\n357\t\n358\t    return any_performed\n359\t"}]},"parent_tool_use_id":null,"session_id":"157c1218-aaa3-4975-9584-69f1851ce3b2","uuid":"b1dcbaa0-8f63-44a5-8772-0c6f8a4ffab7","timestamp":"2026-06-04T10:47:52.380Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/state_based_actions.py","content":"\"\"\"State-based actions checker and resolver.\n\nState-based actions (SBAs) are game rules that are checked and applied\nautomatically whenever a player would receive priority.  They are checked\nrepeatedly until no more actions are taken, at which point triggered\nabilities are placed on the stack.\n\nReferences: MTG Comprehensive Rules §704.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections import defaultdict\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.events import CreatureDiesReplacementEvent\nfrom engine.types import CardType, Supertype, Zone\nfrom engine.zones import ZoneContainer\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n# ---------------------------------------------------------------------------\n# Internal helpers\n# ---------------------------------------------------------------------------\n\ndef _battlefield(game: GameState, player: Player) -> ZoneContainer:\n    \"\"\"Return *player*'s battlefield zone.\"\"\"\n    return player.zones[Zone.BATTLEFIELD]\n\n\ndef _graveyard(game: GameState, player: Player) -> ZoneContainer:\n    \"\"\"Return *player*'s graveyard zone.\"\"\"\n    return player.zones[Zone.GRAVEYARD]\n\n\ndef _move_to_graveyard(game: GameState, player: Player, obj: Any) -> None:\n    \"\"\"Move *obj* from the battlefield to its owner's graveyard (or a\n    replacement destination).\n\n    Delegates to :func:`~engine.zones.move_to_zone` which handles\n    replacement effects, event firing (``LEAVES_BATTLEFIELD``,\n    ``CREATURE_DIES``), and trigger/effect unregistration.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    bf = _battlefield(game, player)\n    if bf.contains(obj):\n        controller = getattr(obj, \"controller\", player)\n        owner = getattr(obj, \"owner\", controller)\n        move_to_zone(\n            game,\n            obj,\n            Zone.BATTLEFIELD,\n            Zone.GRAVEYARD,\n            replacement_event=CreatureDiesReplacementEvent(\n                creature=obj, destination=\"graveyard\",\n                controller=controller, owner=owner,\n            ),\n        )\n\n\n\ndef _owner_of(game: GameState, obj: Any) -> Player:\n    \"\"\"Return the owner of *obj*.\n\n    Falls back to checking which player's battlefield contains the object,\n    then defaults to the first player.\n    \"\"\"\n    if hasattr(obj, \"owner\"):\n        return obj.owner\n    # Fallback: check each player's battlefield\n    for player in game.players:\n        if _battlefield(game, player).contains(obj):\n            return player\n    return game.players[0]\n\n\n# ---------------------------------------------------------------------------\n# Individual SBA checks\n# ---------------------------------------------------------------------------\n\ndef _sba_player_life_zero(game: GameState) -> bool:\n    \"\"\"A player with 0 or less life loses the game.\"\"\"\n    action_taken = False\n    for player in game.players:\n        if player.life <= 0 and not player.has_lost:\n            player.has_lost = True\n            action_taken = True\n    return action_taken\n\n\ndef _sba_creature_zero_toughness(game: GameState) -> bool:\n    \"\"\"A creature with toughness 0 or less is put into its owner's graveyard.\"\"\"\n    action_taken = False\n    to_remove: list[tuple[Player, Any]] = []\n    for player in game.players:\n        for obj in _battlefield(game, player).get_all():\n            if hasattr(obj, \"toughness\") and obj.toughness <= 0:\n                to_remove.append((player, obj))\n    for player, obj in to_remove:\n        _move_to_graveyard(game, player, obj)\n        action_taken = True\n    return action_taken\n\n\ndef _sba_creature_lethal_damage(game: GameState) -> bool:\n    \"\"\"A creature with lethal damage marked on it is destroyed (moved to graveyard).\n\n    Lethal damage means ``damage_marked >= toughness`` (rule 704.5g) or the\n    creature has been dealt damage by a source with deathtouch and has any\n    damage marked on it (rule 704.5h).  Creatures with the ``indestructible``\n    keyword are skipped.\n    \"\"\"\n    action_taken = False\n    to_remove: list[tuple[Player, Any]] = []\n    for player in game.players:\n        for obj in _battlefield(game, player).get_all():\n            if not hasattr(obj, \"toughness\") or not hasattr(obj, \"damage_marked\"):\n                continue\n\n            # Skip indestructible creatures\n            if hasattr(obj, \"keywords\"):\n                from engine.types import Keyword\n\n                if Keyword.INDESTRUCTIBLE in obj.keywords:\n                    continue\n\n            lethal = obj.damage_marked >= obj.toughness\n            # Rule 704.5h: creature dealt damage by a deathtouch source\n            deathtouch_lethal = (\n                getattr(obj, \"dealt_deathtouch_damage\", False)\n                and obj.damage_marked > 0\n            )\n\n            if lethal or deathtouch_lethal:\n                to_remove.append((player, obj))\n\n    for player, obj in to_remove:\n        _move_to_graveyard(game, player, obj)\n        action_taken = True\n    return action_taken\n\n\ndef _sba_draw_from_empty_library(game: GameState) -> bool:\n    \"\"\"A player who attempted to draw from an empty library loses the game.\"\"\"\n    action_taken = False\n    for player in game.players:\n        if (\n            hasattr(player, \"drawn_from_empty_library\")\n            and player.drawn_from_empty_library\n            and not player.has_lost\n        ):\n            player.has_lost = True\n            action_taken = True\n    return action_taken\n\n\ndef _sba_legend_rule(game: GameState) -> bool:\n    \"\"\"If a player controls 2+ legendaries with the same name, they choose one to keep.\n\n    The player is asked to choose which legendary permanent to keep via\n    ``player.choose()``.  All others are moved to the graveyard.\n    \"\"\"\n    action_taken = False\n    for player in game.players:\n        bf = _battlefield(game, player)\n        legendaries: dict[str, list[Any]] = defaultdict(list)\n        for obj in bf.get_all():\n            if (\n                hasattr(obj, \"supertypes\")\n                and Supertype.LEGENDARY in obj.supertypes\n                and hasattr(obj, \"name\")\n            ):\n                legendaries[obj.name].append(obj)\n        for name, objs in legendaries.items():\n            if len(objs) >= 2:\n                # Let the player choose which to keep\n                keep = player.choose(objs, f\"legend rule: choose which {name!r} to keep\")\n                for obj in objs:\n                    if obj is not keep:\n                        _move_to_graveyard(game, player, obj)\n                action_taken = True\n    return action_taken\n\n\ndef _sba_token_not_on_battlefield(game: GameState) -> bool:\n    \"\"\"Tokens that are not on the battlefield cease to exist (removed from game).\n\n    Checks all non-battlefield zones for tokens and removes them entirely.\n    \"\"\"\n    action_taken = False\n    non_battlefield_zones = [\n        Zone.HAND,\n        Zone.GRAVEYARD,\n        Zone.LIBRARY,\n        Zone.EXILE,\n        Zone.STACK,\n        Zone.COMMAND,\n    ]\n    for player in game.players:\n        for zone_type in non_battlefield_zones:\n            zone = player.zones[zone_type]\n            tokens = [\n                obj\n                for obj in zone.get_all()\n                if hasattr(obj, \"is_token\") and obj.is_token\n            ]\n            for token in tokens:\n                zone.remove(token)\n                action_taken = True\n    return action_taken\n\n\ndef _attachment_illegal_due_to_protection(obj: Any) -> bool:\n    \"\"\"Return ``True`` if *obj* (aura or equipment) is illegally attached due to protection.\"\"\"\n    attached = getattr(obj, \"attached_to\", None)\n    if attached is None:\n        return False\n    from engine.protection import has_protection_from\n    return has_protection_from(attached, obj)\n\n\ndef _sba_aura_unattached(game: GameState) -> bool:\n    \"\"\"An Aura or Equipment not attached to a legal object is put into its\n    owner's graveyard.\n\n    An attachment is considered illegally attached if:\n    - It has an ``attached_to`` attribute that is ``None``, OR\n    - The object it is attached to is no longer on the battlefield, OR\n    - The enchanted/equipped permanent has protection from the attachment.\n    \"\"\"\n    action_taken = False\n    to_remove: list[tuple[Player, Any]] = []\n\n    # Collect all objects on all battlefields for checking attachment legality\n    all_on_battlefield: set[int] = set()\n    for player in game.players:\n        for obj in _battlefield(game, player).get_all():\n            all_on_battlefield.add(id(obj))\n\n    to_unattach: list[Any] = []  # Equipment just becomes unattached\n\n    for player in game.players:\n        for obj in _battlefield(game, player).get_all():\n            is_aura = getattr(obj, \"is_aura\", False)\n            is_equipment = getattr(obj, \"is_equipment\", False)\n            if not hasattr(obj, \"attached_to\"):\n                continue\n            if is_aura:\n                target = obj.attached_to\n                if target is None or id(target) not in all_on_battlefield:\n                    to_remove.append((player, obj))\n                elif _attachment_illegal_due_to_protection(obj):\n                    to_remove.append((player, obj))\n            elif is_equipment:\n                target = obj.attached_to\n                if target is not None and _attachment_illegal_due_to_protection(obj):\n                    to_unattach.append(obj)\n\n    for player, obj in to_remove:\n        _move_to_graveyard(game, player, obj)\n        action_taken = True\n    for obj in to_unattach:\n        obj.attached_to = None\n        action_taken = True\n    return action_taken\n\n\ndef _sba_counter_annihilation(game: GameState) -> bool:\n    \"\"\"+1/+1 and -1/-1 counters on the same permanent annihilate in pairs.\"\"\"\n    action_taken = False\n    for player in game.players:\n        for obj in _battlefield(game, player).get_all():\n            if (\n                hasattr(obj, \"plus_one_counters\")\n                and hasattr(obj, \"minus_one_counters\")\n            ):\n                plus = obj.plus_one_counters\n                minus = obj.minus_one_counters\n                if plus > 0 and minus > 0:\n                    annihilate = min(plus, minus)\n                    obj.plus_one_counters -= annihilate\n                    obj.minus_one_counters -= annihilate\n                    action_taken = True\n    return action_taken\n\n\n# ---------------------------------------------------------------------------\n# Public API\n# ---------------------------------------------------------------------------\n\ndef check_state_based_actions(game: GameState) -> bool:\n    \"\"\"Perform a single pass of all state-based actions.\n\n    Returns ``True`` if any action was taken during this pass.  The caller\n    should invoke this repeatedly until it returns ``False`` to ensure the\n    game state is fully stable.\n    \"\"\"\n    action_taken = False\n    # Player with 0 or less life loses\n    action_taken = _sba_player_life_zero(game) or action_taken\n    # Creature with toughness 0 or less → graveyard\n    action_taken = _sba_creature_zero_toughness(game) or action_taken\n    # Creature with lethal damage → destroyed\n    action_taken = _sba_creature_lethal_damage(game) or action_taken\n    # Player who drew from empty library loses\n    action_taken = _sba_draw_from_empty_library(game) or action_taken\n    # Legend rule\n    action_taken = _sba_legend_rule(game) or action_taken\n    # Token not on battlefield → ceases to exist\n    action_taken = _sba_token_not_on_battlefield(game) or action_taken\n    # Aura not attached to legal object → graveyard\n    action_taken = _sba_aura_unattached(game) or action_taken\n    # +1/+1 and -1/-1 counter annihilation\n    action_taken = _sba_counter_annihilation(game) or action_taken\n    return action_taken\n\n\ndef resolve_state_based_actions(game: GameState) -> bool:\n    \"\"\"Run state-based actions in a loop until no more actions are taken.\n\n    After each SBA stabilisation pass, any triggered abilities that were\n    queued during processing are left on the stack.  Per MTG rule 704.3,\n    the SBA loop must repeat if new triggers were placed on the stack\n    (because those triggers may cause further SBAs when resolved, and\n    the game state must be fully stable before a player receives priority).\n\n    The outer loop: repeat { run SBA passes until stable; record whether\n    new triggers were pushed onto the stack during those passes } until\n    no SBAs were performed **and** no new triggers were queued.\n\n    Returns ``True`` if any SBAs were performed during the entire process,\n    ``False`` if the game state was already stable.\n    \"\"\"\n    any_performed = False\n    while True:\n        # Snapshot the stack size before SBA passes so we can detect new\n        # triggers that were pushed during processing.\n        stack_size_before = len(game.stack)\n\n        # Inner loop: run SBA checks until no more actions are taken.\n        sba_this_round = False\n        while check_state_based_actions(game):\n            sba_this_round = True\n            any_performed = True\n\n        # Detect whether any triggers were queued during this round.\n        triggers_queued = len(game.stack) > stack_size_before\n\n        # If nothing happened this round (no SBAs and no new triggers),\n        # the game state is fully stable.\n        if not sba_this_round and not triggers_queued:\n            break\n\n    return any_performed\n","numLines":359,"startLine":1,"totalLines":359}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LEKg7KVUD4sVpd3DsB7jcq","type":"tool_result","content":"1\t\"\"\"Tests for extra turns infrastructure (FIFO queue in GameState).\n2\t\n3\tCovers:\n4\t- extra_turns attribute initialisation\n5\t- Granting an extra turn to the active player (consecutive turns)\n6\t- Normal turn order resumes after the extra turn is consumed\n7\t- Multiple extra turns queued in FIFO order\n8\t- Extra turns for different players interleave correctly\n9\t- Adding an extra turn *during* an extra turn\n10\t- Edge cases: empty queue, priority reset, turn number increments\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\timport pytest\n16\t\n17\tfrom engine.game_state import GameState\n18\tfrom engine.player import DeterministicPlayer\n19\tfrom engine.types import Phase, Step\n20\t\n21\t\n22\t# ---------------------------------------------------------------------------\n23\t# Helpers\n24\t# ---------------------------------------------------------------------------\n25\t\n26\t\n27\tdef _make_game() -> GameState:\n28\t    \"\"\"Create a minimal 2-player GameState for extra-turn tests.\"\"\"\n29\t    p0 = DeterministicPlayer(\"Alice\", [])\n30\t    p1 = DeterministicPlayer(\"Bob\", [])\n31\t    for p in (p0, p1):\n32\t        p.life = 20\n33\t    return GameState([p0, p1])\n34\t\n35\t\n36\tdef _end_turn(game: GameState) -> None:\n37\t    \"\"\"Fast-forward to CLEANUP and advance, simulating end-of-turn.\"\"\"\n38\t    game.phase = Phase.ENDING\n39\t    game.step = Step.CLEANUP\n40\t    game.advance_phase()\n41\t\n42\t\n43\t# ---------------------------------------------------------------------------\n44\t# Attribute initialisation\n45\t# ---------------------------------------------------------------------------\n46\t\n47\t\n48\tclass TestExtraTurnsAttribute:\n49\t    \"\"\"GameState.extra_turns should be an empty list by default.\"\"\"\n50\t\n51\t    def test_extra_turns_initialized_empty(self):\n52\t        game = _make_game()\n53\t        assert game.extra_turns == []\n54\t\n55\t    def test_extra_turns_is_mutable_list(self):\n56\t        game = _make_game()\n57\t        assert isinstance(game.extra_turns, list)\n58\t        # Should be appendable like a normal list\n59\t        game.extra_turns.append(0)\n60\t        assert len(game.extra_turns) == 1\n61\t\n62\t\n63\t# ---------------------------------------------------------------------------\n64\t# Single extra turn granted\n65\t# ---------------------------------------------------------------------------\n66\t\n67\t\n68\tclass TestExtraTurnGranted:\n69\t    \"\"\"Appending a player seat to extra_turns gives them the next turn.\"\"\"\n70\t\n71\t    def test_active_player_gets_consecutive_turn(self):\n72\t        \"\"\"Player 0 queues an extra turn; they should take turn 2.\"\"\"\n73\t        game = _make_game()\n74\t        assert game.active_player_index == 0\n75\t        game.extra_turns.append(0)\n76\t\n77\t        _end_turn(game)\n78\t\n79\t        assert game.active_player_index == 0\n80\t        assert game.turn_number == 2\n81\t        assert game.extra_turns == []\n82\t\n83\t    def test_opponent_gets_extra_turn(self):\n84\t        \"\"\"An effect grants player 1 an extra turn during player 0's turn.\"\"\"\n85\t        game = _make_game()\n86\t        game.extra_turns.append(1)\n87\t\n88\t        _end_turn(game)\n89\t\n90\t        assert game.active_player_index == 1\n91\t        assert game.turn_number == 2\n92\t        assert game.extra_turns == []\n93\t\n94\t    def test_turn_number_increments_on_extra_turn(self):\n95\t        \"\"\"Extra turns still increment the turn counter.\"\"\"\n96\t        game = _make_game()\n97\t        game.extra_turns.append(0)\n98\t\n99\t        _end_turn(game)\n100\t        assert game.turn_number == 2\n101\t\n102\t        _end_turn(game)\n103\t        assert game.turn_number == 3\n104\t\n105\t\n106\t# ---------------------------------------------------------------------------\n107\t# Normal turn order resumes after extra turn\n108\t# ---------------------------------------------------------------------------\n109\t\n110\t\n111\tclass TestNormalOrderResumes:\n112\t    \"\"\"After extra turns are exhausted, the normal alternation resumes.\"\"\"\n113\t\n114\t    def test_resumes_to_opponent_after_self_extra_turn(self):\n115\t        game = _make_game()\n116\t        game.extra_turns.append(0)\n117\t\n118\t        _end_turn(game)  # turn 2: extra for P0\n119\t        assert game.active_player_index == 0\n120\t\n121\t        _end_turn(game)  # turn 3: normal -> P1\n122\t        assert game.active_player_index == 1\n123\t\n124\t    def test_resumes_after_opponent_extra_turn(self):\n125\t        \"\"\"After P1 takes an inserted extra turn, normal rotation resumes\n126\t        from where it left off — P0 was the last *normal* active player,\n127\t        so the next normal turn belongs to P1 (P0 → P1(extra) → P1(normal)).\"\"\"\n128\t        game = _make_game()\n129\t        game.extra_turns.append(1)\n130\t\n131\t        _end_turn(game)  # turn 2: extra for P1\n132\t        assert game.active_player_index == 1\n133\t\n134\t        _end_turn(game)  # turn 3: normal rotation from P0 → P1\n135\t        assert game.active_player_index == 1\n136\t\n137\t    def test_empty_queue_normal_alternation(self):\n138\t        \"\"\"With no extra turns queued, turns alternate normally.\"\"\"\n139\t        game = _make_game()\n140\t\n141\t        _end_turn(game)\n142\t        assert game.active_player_index == 1\n143\t\n144\t        _end_turn(game)\n145\t        assert game.active_player_index == 0\n146\t\n147\t\n148\t# ---------------------------------------------------------------------------\n149\t# Multiple extra turns — FIFO ordering\n150\t# ---------------------------------------------------------------------------\n151\t\n152\t\n153\tclass TestMultipleExtraTurnsFIFO:\n154\t    \"\"\"Multiple extra turns must be processed first-in, first-out.\"\"\"\n155\t\n156\t    def test_two_extra_turns_same_player(self):\n157\t        game = _make_game()\n158\t        game.extra_turns.extend([0, 0])\n159\t\n160\t        _end_turn(game)\n161\t        assert game.active_player_index == 0\n162\t        assert len(game.extra_turns) == 1\n163\t\n164\t        _end_turn(game)\n165\t        assert game.active_player_index == 0\n166\t        assert game.extra_turns == []\n167\t\n168\t        _end_turn(game)  # normal: -> P1\n169\t        assert game.active_player_index == 1\n170\t\n171\t    def test_fifo_different_players(self):\n172\t        \"\"\"Queue [P0, P1] — P0's extra first, then P1's extra.\"\"\"\n173\t        game = _make_game()\n174\t        game.extra_turns.extend([0, 1])\n175\t\n176\t        _end_turn(game)\n177\t        assert game.active_player_index == 0\n178\t\n179\t        _end_turn(game)\n180\t        assert game.active_player_index == 1\n181\t\n182\t    def test_three_extras_interleaved(self):\n183\t        \"\"\"Queue [P0, P1, P0] — should pop in that exact order.\"\"\"\n184\t        game = _make_game()\n185\t        game.extra_turns.extend([0, 1, 0])\n186\t\n187\t        results = []\n188\t        for _ in range(3):\n189\t            _end_turn(game)\n190\t            results.append(game.active_player_index)\n191\t\n192\t        assert results == [0, 1, 0]\n193\t        assert game.extra_turns == []\n194\t\n195\t    def test_normal_order_resumes_after_all_extras_consumed(self):\n196\t        \"\"\"After [P0, P1] extras, normal alternation resumes from the last\n197\t        *normal* turn (P0), so next normal turn is P1.\"\"\"\n198\t        game = _make_game()\n199\t        game.extra_turns.extend([0, 1])\n200\t\n201\t        _end_turn(game)  # extra P0\n202\t        _end_turn(game)  # extra P1\n203\t\n204\t        _end_turn(game)  # normal: P0 was last normal → P1\n205\t        assert game.active_player_index == 1\n206\t\n207\t\n208\t# ---------------------------------------------------------------------------\n209\t# Extra turn during an extra turn\n210\t# ---------------------------------------------------------------------------\n211\t\n212\t\n213\tclass TestExtraTurnDuringExtraTurn:\n214\t    \"\"\"Queueing an extra turn while taking an extra turn should work.\"\"\"\n215\t\n216\t    def test_queue_extra_during_extra(self):\n217\t        \"\"\"P0 gets an extra turn, then during that extra turn queues another.\"\"\"\n218\t        game = _make_game()\n219\t        game.extra_turns.append(0)\n220\t\n221\t        _end_turn(game)  # extra turn for P0\n222\t        assert game.active_player_index == 0\n223\t\n224\t        # During the extra turn, another extra turn is granted\n225\t        game.extra_turns.append(0)\n226\t\n227\t        _end_turn(game)  # second extra for P0\n228\t        assert game.active_player_index == 0\n229\t\n230\t        _end_turn(game)  # normal -> P1\n231\t        assert game.active_player_index == 1\n232\t\n233\t    def test_queue_opponent_extra_during_own_extra(self):\n234\t        \"\"\"P0 takes extra turn, queues extra for P1 during it.\n235\t        Normal rotation still tracks P0 as last normal, so after\n236\t        extras: P0(extra) → P1(extra) → P1(normal).\"\"\"\n237\t        game = _make_game()\n238\t        game.extra_turns.append(0)\n239\t\n240\t        _end_turn(game)\n241\t        assert game.active_player_index == 0\n242\t\n243\t        game.extra_turns.append(1)\n244\t\n245\t        _end_turn(game)\n246\t        assert game.active_player_index == 1\n247\t\n248\t        _end_turn(game)  # normal: P0 was last normal → P1\n249\t        assert game.active_player_index == 1\n250\t\n251\t\n252\t# ---------------------------------------------------------------------------\n253\t# Priority and phase reset on extra turn\n254\t# ---------------------------------------------------------------------------\n255\t\n256\t\n257\tclass TestPriorityAndPhaseReset:\n258\t    \"\"\"On a new turn (including extra), priority and phase should reset.\"\"\"\n259\t\n260\t    def test_priority_set_to_active_player_on_extra_turn(self):\n261\t        game = _make_game()\n262\t        game.extra_turns.append(0)\n263\t        game.priority_player_index = 1  # opponent had priority\n264\t\n265\t        _end_turn(game)\n266\t\n267\t        assert game.priority_player_index == 0\n268\t\n269\t    def test_phase_resets_to_beginning_on_extra_turn(self):\n270\t        game = _make_game()\n271\t        game.extra_turns.append(0)\n272\t\n273\t        _end_turn(game)\n274\t\n275\t        assert game.phase == Phase.BEGINNING\n276\t        assert game.step == Step.UNTAP\n277\t"}]},"parent_tool_use_id":null,"session_id":"157c1218-aaa3-4975-9584-69f1851ce3b2","uuid":"dcdbfccc-2d03-4ace-9aa3-b5d445f0249e","timestamp":"2026-06-04T10:47:52.380Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine_tests/test_extra_turns.py","content":"\"\"\"Tests for extra turns infrastructure (FIFO queue in GameState).\n\nCovers:\n- extra_turns attribute initialisation\n- Granting an extra turn to the active player (consecutive turns)\n- Normal turn order resumes after the extra turn is consumed\n- Multiple extra turns queued in FIFO order\n- Extra turns for different players interleave correctly\n- Adding an extra turn *during* an extra turn\n- Edge cases: empty queue, priority reset, turn number increments\n\"\"\"\n\nfrom __future__ import annotations\n\nimport pytest\n\nfrom engine.game_state import GameState\nfrom engine.player import DeterministicPlayer\nfrom engine.types import Phase, Step\n\n\n# ---------------------------------------------------------------------------\n# Helpers\n# ---------------------------------------------------------------------------\n\n\ndef _make_game() -> GameState:\n    \"\"\"Create a minimal 2-player GameState for extra-turn tests.\"\"\"\n    p0 = DeterministicPlayer(\"Alice\", [])\n    p1 = DeterministicPlayer(\"Bob\", [])\n    for p in (p0, p1):\n        p.life = 20\n    return GameState([p0, p1])\n\n\ndef _end_turn(game: GameState) -> None:\n    \"\"\"Fast-forward to CLEANUP and advance, simulating end-of-turn.\"\"\"\n    game.phase = Phase.ENDING\n    game.step = Step.CLEANUP\n    game.advance_phase()\n\n\n# ---------------------------------------------------------------------------\n# Attribute initialisation\n# ---------------------------------------------------------------------------\n\n\nclass TestExtraTurnsAttribute:\n    \"\"\"GameState.extra_turns should be an empty list by default.\"\"\"\n\n    def test_extra_turns_initialized_empty(self):\n        game = _make_game()\n        assert game.extra_turns == []\n\n    def test_extra_turns_is_mutable_list(self):\n        game = _make_game()\n        assert isinstance(game.extra_turns, list)\n        # Should be appendable like a normal list\n        game.extra_turns.append(0)\n        assert len(game.extra_turns) == 1\n\n\n# ---------------------------------------------------------------------------\n# Single extra turn granted\n# ---------------------------------------------------------------------------\n\n\nclass TestExtraTurnGranted:\n    \"\"\"Appending a player seat to extra_turns gives them the next turn.\"\"\"\n\n    def test_active_player_gets_consecutive_turn(self):\n        \"\"\"Player 0 queues an extra turn; they should take turn 2.\"\"\"\n        game = _make_game()\n        assert game.active_player_index == 0\n        game.extra_turns.append(0)\n\n        _end_turn(game)\n\n        assert game.active_player_index == 0\n        assert game.turn_number == 2\n        assert game.extra_turns == []\n\n    def test_opponent_gets_extra_turn(self):\n        \"\"\"An effect grants player 1 an extra turn during player 0's turn.\"\"\"\n        game = _make_game()\n        game.extra_turns.append(1)\n\n        _end_turn(game)\n\n        assert game.active_player_index == 1\n        assert game.turn_number == 2\n        assert game.extra_turns == []\n\n    def test_turn_number_increments_on_extra_turn(self):\n        \"\"\"Extra turns still increment the turn counter.\"\"\"\n        game = _make_game()\n        game.extra_turns.append(0)\n\n        _end_turn(game)\n        assert game.turn_number == 2\n\n        _end_turn(game)\n        assert game.turn_number == 3\n\n\n# ---------------------------------------------------------------------------\n# Normal turn order resumes after extra turn\n# ---------------------------------------------------------------------------\n\n\nclass TestNormalOrderResumes:\n    \"\"\"After extra turns are exhausted, the normal alternation resumes.\"\"\"\n\n    def test_resumes_to_opponent_after_self_extra_turn(self):\n        game = _make_game()\n        game.extra_turns.append(0)\n\n        _end_turn(game)  # turn 2: extra for P0\n        assert game.active_player_index == 0\n\n        _end_turn(game)  # turn 3: normal -> P1\n        assert game.active_player_index == 1\n\n    def test_resumes_after_opponent_extra_turn(self):\n        \"\"\"After P1 takes an inserted extra turn, normal rotation resumes\n        from where it left off — P0 was the last *normal* active player,\n        so the next normal turn belongs to P1 (P0 → P1(extra) → P1(normal)).\"\"\"\n        game = _make_game()\n        game.extra_turns.append(1)\n\n        _end_turn(game)  # turn 2: extra for P1\n        assert game.active_player_index == 1\n\n        _end_turn(game)  # turn 3: normal rotation from P0 → P1\n        assert game.active_player_index == 1\n\n    def test_empty_queue_normal_alternation(self):\n        \"\"\"With no extra turns queued, turns alternate normally.\"\"\"\n        game = _make_game()\n\n        _end_turn(game)\n        assert game.active_player_index == 1\n\n        _end_turn(game)\n        assert game.active_player_index == 0\n\n\n# ---------------------------------------------------------------------------\n# Multiple extra turns — FIFO ordering\n# ---------------------------------------------------------------------------\n\n\nclass TestMultipleExtraTurnsFIFO:\n    \"\"\"Multiple extra turns must be processed first-in, first-out.\"\"\"\n\n    def test_two_extra_turns_same_player(self):\n        game = _make_game()\n        game.extra_turns.extend([0, 0])\n\n        _end_turn(game)\n        assert game.active_player_index == 0\n        assert len(game.extra_turns) == 1\n\n        _end_turn(game)\n        assert game.active_player_index == 0\n        assert game.extra_turns == []\n\n        _end_turn(game)  # normal: -> P1\n        assert game.active_player_index == 1\n\n    def test_fifo_different_players(self):\n        \"\"\"Queue [P0, P1] — P0's extra first, then P1's extra.\"\"\"\n        game = _make_game()\n        game.extra_turns.extend([0, 1])\n\n        _end_turn(game)\n        assert game.active_player_index == 0\n\n        _end_turn(game)\n        assert game.active_player_index == 1\n\n    def test_three_extras_interleaved(self):\n        \"\"\"Queue [P0, P1, P0] — should pop in that exact order.\"\"\"\n        game = _make_game()\n        game.extra_turns.extend([0, 1, 0])\n\n        results = []\n        for _ in range(3):\n            _end_turn(game)\n            results.append(game.active_player_index)\n\n        assert results == [0, 1, 0]\n        assert game.extra_turns == []\n\n    def test_normal_order_resumes_after_all_extras_consumed(self):\n        \"\"\"After [P0, P1] extras, normal alternation resumes from the last\n        *normal* turn (P0), so next normal turn is P1.\"\"\"\n        game = _make_game()\n        game.extra_turns.extend([0, 1])\n\n        _end_turn(game)  # extra P0\n        _end_turn(game)  # extra P1\n\n        _end_turn(game)  # normal: P0 was last normal → P1\n        assert game.active_player_index == 1\n\n\n# ---------------------------------------------------------------------------\n# Extra turn during an extra turn\n# ---------------------------------------------------------------------------\n\n\nclass TestExtraTurnDuringExtraTurn:\n    \"\"\"Queueing an extra turn while taking an extra turn should work.\"\"\"\n\n    def test_queue_extra_during_extra(self):\n        \"\"\"P0 gets an extra turn, then during that extra turn queues another.\"\"\"\n        game = _make_game()\n        game.extra_turns.append(0)\n\n        _end_turn(game)  # extra turn for P0\n        assert game.active_player_index == 0\n\n        # During the extra turn, another extra turn is granted\n        game.extra_turns.append(0)\n\n        _end_turn(game)  # second extra for P0\n        assert game.active_player_index == 0\n\n        _end_turn(game)  # normal -> P1\n        assert game.active_player_index == 1\n\n    def test_queue_opponent_extra_during_own_extra(self):\n        \"\"\"P0 takes extra turn, queues extra for P1 during it.\n        Normal rotation still tracks P0 as last normal, so after\n        extras: P0(extra) → P1(extra) → P1(normal).\"\"\"\n        game = _make_game()\n        game.extra_turns.append(0)\n\n        _end_turn(game)\n        assert game.active_player_index == 0\n\n        game.extra_turns.append(1)\n\n        _end_turn(game)\n        assert game.active_player_index == 1\n\n        _end_turn(game)  # normal: P0 was last normal → P1\n        assert game.active_player_index == 1\n\n\n# ---------------------------------------------------------------------------\n# Priority and phase reset on extra turn\n# ---------------------------------------------------------------------------\n\n\nclass TestPriorityAndPhaseReset:\n    \"\"\"On a new turn (including extra), priority and phase should reset.\"\"\"\n\n    def test_priority_set_to_active_player_on_extra_turn(self):\n        game = _make_game()\n        game.extra_turns.append(0)\n        game.priority_player_index = 1  # opponent had priority\n\n        _end_turn(game)\n\n        assert game.priority_player_index == 0\n\n    def test_phase_resets_to_beginning_on_extra_turn(self):\n        game = _make_game()\n        game.extra_turns.append(0)\n\n        _end_turn(game)\n\n        assert game.phase == Phase.BEGINNING\n        assert game.step == Step.UNTAP\n","numLines":277,"startLine":1,"totalLines":277}}}
