{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016CPJ8xTzLL8sp4btgNajZb","type":"tool_result","content":"1\t\"\"\"Triggered abilities system — event-driven trigger registration and firing.\n2\t\n3\tProvides the core mechanism for registering triggered abilities and firing\n4\tevents that push matching triggers onto the stack:\n5\t\n6\t- :class:`TriggerRegistration` — dataclass describing a single trigger.\n7\t- :class:`TriggerManager` — central registry for triggers with APNAP-ordered\n8\t  event firing.\n9\t\n10\tEvent types live in :mod:`engine.events` as typed dataclasses.\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\tfrom dataclasses import dataclass, field\n16\tfrom typing import TYPE_CHECKING, Any, Callable\n17\t\n18\tfrom engine.events import TriggeredEvent\n19\tfrom engine.stack import StackObject\n20\t\n21\tif TYPE_CHECKING:\n22\t    from engine.game_state import GameState\n23\t    from engine.player import Player\n24\t\n25\t\n26\t@dataclass\n27\tclass TriggerRegistration:\n28\t    \"\"\"Describes a single triggered ability.\n29\t\n30\t    Attributes:\n31\t        event_type: The event class (or a base class) this trigger watches.\n32\t            The trigger fires for any fired event that is an instance of\n33\t            this class, including instances of subclasses.\n34\t        condition: Optional callable ``(game, event) -> bool`` that must\n35\t            return ``True`` for the trigger to fire.  ``None`` means the\n36\t            trigger always fires for its event type.\n37\t        effect: Callable ``(game) -> None`` executed when the trigger\n38\t            resolves (becomes the :attr:`StackObject.on_resolve` callback).\n39\t        source: The game object (card / permanent) that owns this trigger.\n40\t        controller: The player who controls the source at the time of\n41\t            registration.\n42\t    \"\"\"\n43\t\n44\t    event_type: type[TriggeredEvent]\n45\t    condition: Callable[..., bool] | None\n46\t    effect: Callable[..., None]\n47\t    source: Any\n48\t    controller: Player\n49\t\n50\t\n51\tclass TriggerManager:\n52\t    \"\"\"Central registry for triggered abilities.\n53\t\n54\t    Triggers are registered when a permanent enters the battlefield (or\n55\t    via other game actions) and unregistered when the source leaves.\n56\t\n57\t    :meth:`fire_event` checks all registered triggers of a matching\n58\t    event type, evaluates their conditions, and pushes matching triggers\n59\t    onto the game stack as :class:`StackObject` instances.  Triggers are\n60\t    ordered according to APNAP (Active Player, Non-Active Player):\n61\t\n62\t    * Active player's triggers are pushed first (end up on the bottom\n63\t      of the batch).\n64\t    * Non-active player's triggers are pushed second (end up on top).\n65\t    * Within the same player, triggers are pushed in registration order\n66\t      (controller would normally choose; for now we use registration\n67\t      order as a deterministic default).\n68\t    \"\"\"\n69\t\n70\t    def __init__(self) -> None:\n71\t        self._triggers: list[TriggerRegistration] = []\n72\t\n73\t    def register(self, trigger: TriggerRegistration) -> None:\n74\t        \"\"\"Register a triggered ability.\"\"\"\n75\t        self._triggers.append(trigger)\n76\t\n77\t    def unregister(self, source: Any) -> None:\n78\t        \"\"\"Remove all triggers registered by *source* (identity-based).\"\"\"\n79\t        self._triggers = [t for t in self._triggers if t.source is not source]\n80\t\n81\t    def fire_event(self, game: GameState, event: TriggeredEvent) -> None:\n82\t        \"\"\"Fire an event and push all matching triggers onto the stack.\n83\t\n84\t        Parameters:\n85\t            game: The current game state.\n86\t            event: The typed event object.  Triggers registered for the\n87\t                event's class or any of its parent classes will fire.\n88\t\n89\t        Matching triggers are pushed in APNAP order:\n90\t\n91\t        1. Active player's matching triggers (in registration order).\n92\t        2. Non-active player's matching triggers (in registration order).\n93\t        \"\"\"\n94\t        matching: list[TriggerRegistration] = []\n95\t        for trigger in self._triggers:\n96\t            if not isinstance(event, trigger.event_type):\n97\t                continue\n98\t            if trigger.condition is not None:\n99\t                if not trigger.condition(game, event):\n100\t                    continue\n101\t            matching.append(trigger)\n102\t\n103\t        if not matching:\n104\t            return\n105\t\n106\t        active_player = game.active_player\n107\t        active_triggers: list[TriggerRegistration] = []\n108\t        non_active_triggers: list[TriggerRegistration] = []\n109\t\n110\t        for trigger in matching:\n111\t            if trigger.controller is active_player:\n112\t                active_triggers.append(trigger)\n113\t            else:\n114\t                non_active_triggers.append(trigger)\n115\t\n116\t        ordered = active_triggers + non_active_triggers\n117\t\n118\t        for trigger in ordered:\n119\t            stack_obj = StackObject(\n120\t                source=trigger.source,\n121\t                controller=trigger.controller,\n122\t                on_resolve=trigger.effect,\n123\t            )\n124\t            game.stack.push(stack_obj)\n125\t\n126\t    def get_triggers(self) -> list[TriggerRegistration]:\n127\t        \"\"\"Return a shallow copy of all registered triggers.\"\"\"\n128\t        return list(self._triggers)\n129\t\n130\t    def get_triggers_for_source(self, source: Any) -> list[TriggerRegistration]:\n131\t        \"\"\"Return all triggers registered by *source* (identity-based).\"\"\"\n132\t        return [t for t in self._triggers if t.source is source]\n133\t\n134\t    def clear(self) -> None:\n135\t        \"\"\"Remove all registered triggers.\"\"\"\n136\t        self._triggers.clear()\n137\t"}]},"parent_tool_use_id":null,"session_id":"157c1218-aaa3-4975-9584-69f1851ce3b2","uuid":"88b5c8d6-980f-4982-a853-f22c079a407e","timestamp":"2026-06-04T10:49:46.501Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/triggers.py","content":"\"\"\"Triggered abilities system — event-driven trigger registration and firing.\n\nProvides the core mechanism for registering triggered abilities and firing\nevents that push matching triggers onto the stack:\n\n- :class:`TriggerRegistration` — dataclass describing a single trigger.\n- :class:`TriggerManager` — central registry for triggers with APNAP-ordered\n  event firing.\n\nEvent types live in :mod:`engine.events` as typed dataclasses.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom typing import TYPE_CHECKING, Any, Callable\n\nfrom engine.events import TriggeredEvent\nfrom engine.stack import StackObject\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n@dataclass\nclass TriggerRegistration:\n    \"\"\"Describes a single triggered ability.\n\n    Attributes:\n        event_type: The event class (or a base class) this trigger watches.\n            The trigger fires for any fired event that is an instance of\n            this class, including instances of subclasses.\n        condition: Optional callable ``(game, event) -> bool`` that must\n            return ``True`` for the trigger to fire.  ``None`` means the\n            trigger always fires for its event type.\n        effect: Callable ``(game) -> None`` executed when the trigger\n            resolves (becomes the :attr:`StackObject.on_resolve` callback).\n        source: The game object (card / permanent) that owns this trigger.\n        controller: The player who controls the source at the time of\n            registration.\n    \"\"\"\n\n    event_type: type[TriggeredEvent]\n    condition: Callable[..., bool] | None\n    effect: Callable[..., None]\n    source: Any\n    controller: Player\n\n\nclass TriggerManager:\n    \"\"\"Central registry for triggered abilities.\n\n    Triggers are registered when a permanent enters the battlefield (or\n    via other game actions) and unregistered when the source leaves.\n\n    :meth:`fire_event` checks all registered triggers of a matching\n    event type, evaluates their conditions, and pushes matching triggers\n    onto the game stack as :class:`StackObject` instances.  Triggers are\n    ordered according to APNAP (Active Player, Non-Active Player):\n\n    * Active player's triggers are pushed first (end up on the bottom\n      of the batch).\n    * Non-active player's triggers are pushed second (end up on top).\n    * Within the same player, triggers are pushed in registration order\n      (controller would normally choose; for now we use registration\n      order as a deterministic default).\n    \"\"\"\n\n    def __init__(self) -> None:\n        self._triggers: list[TriggerRegistration] = []\n\n    def register(self, trigger: TriggerRegistration) -> None:\n        \"\"\"Register a triggered ability.\"\"\"\n        self._triggers.append(trigger)\n\n    def unregister(self, source: Any) -> None:\n        \"\"\"Remove all triggers registered by *source* (identity-based).\"\"\"\n        self._triggers = [t for t in self._triggers if t.source is not source]\n\n    def fire_event(self, game: GameState, event: TriggeredEvent) -> None:\n        \"\"\"Fire an event and push all matching triggers onto the stack.\n\n        Parameters:\n            game: The current game state.\n            event: The typed event object.  Triggers registered for the\n                event's class or any of its parent classes will fire.\n\n        Matching triggers are pushed in APNAP order:\n\n        1. Active player's matching triggers (in registration order).\n        2. Non-active player's matching triggers (in registration order).\n        \"\"\"\n        matching: list[TriggerRegistration] = []\n        for trigger in self._triggers:\n            if not isinstance(event, trigger.event_type):\n                continue\n            if trigger.condition is not None:\n                if not trigger.condition(game, event):\n                    continue\n            matching.append(trigger)\n\n        if not matching:\n            return\n\n        active_player = game.active_player\n        active_triggers: list[TriggerRegistration] = []\n        non_active_triggers: list[TriggerRegistration] = []\n\n        for trigger in matching:\n            if trigger.controller is active_player:\n                active_triggers.append(trigger)\n            else:\n                non_active_triggers.append(trigger)\n\n        ordered = active_triggers + non_active_triggers\n\n        for trigger in ordered:\n            stack_obj = StackObject(\n                source=trigger.source,\n                controller=trigger.controller,\n                on_resolve=trigger.effect,\n            )\n            game.stack.push(stack_obj)\n\n    def get_triggers(self) -> list[TriggerRegistration]:\n        \"\"\"Return a shallow copy of all registered triggers.\"\"\"\n        return list(self._triggers)\n\n    def get_triggers_for_source(self, source: Any) -> list[TriggerRegistration]:\n        \"\"\"Return all triggers registered by *source* (identity-based).\"\"\"\n        return [t for t in self._triggers if t.source is source]\n\n    def clear(self) -> None:\n        \"\"\"Remove all registered triggers.\"\"\"\n        self._triggers.clear()\n","numLines":137,"startLine":1,"totalLines":137}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HvsznQgyHddT6mbLA33QbB","type":"tool_result","content":"1\t\"\"\"Player interface and deterministic test player implementation.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom abc import ABC, abstractmethod\n6\tfrom collections import deque\n7\tfrom typing import Any\n8\t\n9\tfrom engine.mana import ManaPool\n10\tfrom engine.zones import Zones\n11\t\n12\t\n13\tclass ScriptExhaustedError(Exception):\n14\t    \"\"\"Raised when a DeterministicPlayer's script runs out of predetermined answers.\"\"\"\n15\t\n16\t\n17\tclass Player(ABC):\n18\t    \"\"\"Abstract base class for all players in the game.\n19\t\n20\t    Attributes:\n21\t        name: The player's display name.\n22\t        life: Current life total (default 20).\n23\t        zones: Per-player zone containers.\n24\t        mana_pool: The player's mana pool (forward ref; initialized to None until ManaPool is implemented).\n25\t        has_lost: Whether this player has lost the game.\n26\t        land_plays_remaining: Number of land plays remaining this turn.\n27\t        drawn_from_empty_library: Whether this player attempted to draw from an empty library.\n28\t    \"\"\"\n29\t\n30\t    def __init__(self, name: str, life: int = 20) -> None:\n31\t        self.name: str = name\n32\t        self.life: int = life\n33\t        self.zones: Zones = Zones.new_player()\n34\t        self.mana_pool: ManaPool = ManaPool()\n35\t        self.has_lost: bool = False\n36\t        self.land_plays_remaining: int = 1\n37\t        self.drawn_from_empty_library: bool = False\n38\t\n39\t    @abstractmethod\n40\t    def choose_target(self, options: Any, requirement: Any) -> Any:\n41\t        \"\"\"Choose a target from the available options given a requirement.\n42\t\n43\t        Parameters:\n44\t            options: The available targets to choose from.\n45\t            requirement: The targeting requirement to satisfy.\n46\t\n47\t        Returns:\n48\t            The chosen target.\n49\t        \"\"\"\n50\t\n51\t    @abstractmethod\n52\t    def choose(self, options: Any, description: str) -> Any:\n53\t        \"\"\"Choose from a list of options.\n54\t\n55\t        Parameters:\n56\t            options: The available choices.\n57\t            description: Human-readable description of the choice.\n58\t\n59\t        Returns:\n60\t            The chosen option.\n61\t        \"\"\"\n62\t\n63\t    @abstractmethod\n64\t    def choose_yes_no(self, prompt: str) -> bool:\n65\t        \"\"\"Make a yes/no decision.\n66\t\n67\t        Parameters:\n68\t            prompt: Human-readable prompt for the decision.\n69\t\n70\t        Returns:\n71\t            True for yes, False for no.\n72\t        \"\"\"\n73\t\n74\t    @abstractmethod\n75\t    def assign_damage_order(self, attackers_or_blockers: Any) -> list[Any]:\n76\t        \"\"\"Assign a damage ordering to attackers or blockers.\n77\t\n78\t        Parameters:\n79\t            attackers_or_blockers: The creatures to order.\n80\t\n81\t        Returns:\n82\t            An ordered list representing the damage assignment order.\n83\t        \"\"\"\n84\t\n85\t    @abstractmethod\n86\t    def choose_card(self, cards: Any, description: str) -> Any:\n87\t        \"\"\"Choose a card from a collection.\n88\t\n89\t        Parameters:\n90\t            cards: The available cards to choose from.\n91\t            description: Human-readable description of why a card is being chosen.\n92\t\n93\t        Returns:\n94\t            The chosen card.\n95\t        \"\"\"\n96\t\n97\t\n98\tclass DeterministicPlayer(Player):\n99\t    \"\"\"A scripted player for testing that returns predetermined answers.\n100\t\n101\t    Each abstract method call pops the next answer from the front of the\n102\t    script queue. Raises :class:`ScriptExhaustedError` if the script is empty\n103\t    when a choice is requested.\n104\t    \"\"\"\n105\t\n106\t    def __init__(self, name: str, script: list[Any], life: int = 20) -> None:\n107\t        super().__init__(name, life)\n108\t        self._script: deque[Any] = deque(script)\n109\t\n110\t    def _pop(self) -> Any:\n111\t        \"\"\"Pop the next scripted answer from the queue.\n112\t\n113\t        Raises:\n114\t            ScriptExhaustedError: If the script has no remaining answers.\n115\t        \"\"\"\n116\t        if not self._script:\n117\t            raise ScriptExhaustedError(\n118\t                f\"Player {self.name!r} script exhausted — no more predetermined answers\"\n119\t            )\n120\t        return self._script.popleft()\n121\t\n122\t    @property\n123\t    def remaining_choices(self) -> int:\n124\t        \"\"\"Return the number of scripted answers remaining.\"\"\"\n125\t        return len(self._script)\n126\t\n127\t    def choose_target(self, options: Any, requirement: Any) -> Any:\n128\t        \"\"\"Return the next scripted target choice.\"\"\"\n129\t        return self._pop()\n130\t\n131\t    def choose(self, options: Any, description: str) -> Any:\n132\t        \"\"\"Return the next scripted choice.\"\"\"\n133\t        return self._pop()\n134\t\n135\t    def choose_yes_no(self, prompt: str) -> bool:\n136\t        \"\"\"Return the next scripted yes/no decision.\"\"\"\n137\t        return self._pop()\n138\t\n139\t    def assign_damage_order(self, attackers_or_blockers: Any) -> list[Any]:\n140\t        \"\"\"Return the next scripted damage ordering.\"\"\"\n141\t        return self._pop()\n142\t\n143\t    def choose_card(self, cards: Any, description: str) -> Any:\n144\t        \"\"\"Return the next scripted card choice.\"\"\"\n145\t        return self._pop()\n146\t"}]},"parent_tool_use_id":null,"session_id":"157c1218-aaa3-4975-9584-69f1851ce3b2","uuid":"d0922488-c175-43f1-b6b2-faeebfc6ce2f","timestamp":"2026-06-04T10:49:46.502Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/player.py","content":"\"\"\"Player interface and deterministic test player implementation.\"\"\"\n\nfrom __future__ import annotations\n\nfrom abc import ABC, abstractmethod\nfrom collections import deque\nfrom typing import Any\n\nfrom engine.mana import ManaPool\nfrom engine.zones import Zones\n\n\nclass ScriptExhaustedError(Exception):\n    \"\"\"Raised when a DeterministicPlayer's script runs out of predetermined answers.\"\"\"\n\n\nclass Player(ABC):\n    \"\"\"Abstract base class for all players in the game.\n\n    Attributes:\n        name: The player's display name.\n        life: Current life total (default 20).\n        zones: Per-player zone containers.\n        mana_pool: The player's mana pool (forward ref; initialized to None until ManaPool is implemented).\n        has_lost: Whether this player has lost the game.\n        land_plays_remaining: Number of land plays remaining this turn.\n        drawn_from_empty_library: Whether this player attempted to draw from an empty library.\n    \"\"\"\n\n    def __init__(self, name: str, life: int = 20) -> None:\n        self.name: str = name\n        self.life: int = life\n        self.zones: Zones = Zones.new_player()\n        self.mana_pool: ManaPool = ManaPool()\n        self.has_lost: bool = False\n        self.land_plays_remaining: int = 1\n        self.drawn_from_empty_library: bool = False\n\n    @abstractmethod\n    def choose_target(self, options: Any, requirement: Any) -> Any:\n        \"\"\"Choose a target from the available options given a requirement.\n\n        Parameters:\n            options: The available targets to choose from.\n            requirement: The targeting requirement to satisfy.\n\n        Returns:\n            The chosen target.\n        \"\"\"\n\n    @abstractmethod\n    def choose(self, options: Any, description: str) -> Any:\n        \"\"\"Choose from a list of options.\n\n        Parameters:\n            options: The available choices.\n            description: Human-readable description of the choice.\n\n        Returns:\n            The chosen option.\n        \"\"\"\n\n    @abstractmethod\n    def choose_yes_no(self, prompt: str) -> bool:\n        \"\"\"Make a yes/no decision.\n\n        Parameters:\n            prompt: Human-readable prompt for the decision.\n\n        Returns:\n            True for yes, False for no.\n        \"\"\"\n\n    @abstractmethod\n    def assign_damage_order(self, attackers_or_blockers: Any) -> list[Any]:\n        \"\"\"Assign a damage ordering to attackers or blockers.\n\n        Parameters:\n            attackers_or_blockers: The creatures to order.\n\n        Returns:\n            An ordered list representing the damage assignment order.\n        \"\"\"\n\n    @abstractmethod\n    def choose_card(self, cards: Any, description: str) -> Any:\n        \"\"\"Choose a card from a collection.\n\n        Parameters:\n            cards: The available cards to choose from.\n            description: Human-readable description of why a card is being chosen.\n\n        Returns:\n            The chosen card.\n        \"\"\"\n\n\nclass DeterministicPlayer(Player):\n    \"\"\"A scripted player for testing that returns predetermined answers.\n\n    Each abstract method call pops the next answer from the front of the\n    script queue. Raises :class:`ScriptExhaustedError` if the script is empty\n    when a choice is requested.\n    \"\"\"\n\n    def __init__(self, name: str, script: list[Any], life: int = 20) -> None:\n        super().__init__(name, life)\n        self._script: deque[Any] = deque(script)\n\n    def _pop(self) -> Any:\n        \"\"\"Pop the next scripted answer from the queue.\n\n        Raises:\n            ScriptExhaustedError: If the script has no remaining answers.\n        \"\"\"\n        if not self._script:\n            raise ScriptExhaustedError(\n                f\"Player {self.name!r} script exhausted — no more predetermined answers\"\n            )\n        return self._script.popleft()\n\n    @property\n    def remaining_choices(self) -> int:\n        \"\"\"Return the number of scripted answers remaining.\"\"\"\n        return len(self._script)\n\n    def choose_target(self, options: Any, requirement: Any) -> Any:\n        \"\"\"Return the next scripted target choice.\"\"\"\n        return self._pop()\n\n    def choose(self, options: Any, description: str) -> Any:\n        \"\"\"Return the next scripted choice.\"\"\"\n        return self._pop()\n\n    def choose_yes_no(self, prompt: str) -> bool:\n        \"\"\"Return the next scripted yes/no decision.\"\"\"\n        return self._pop()\n\n    def assign_damage_order(self, attackers_or_blockers: Any) -> list[Any]:\n        \"\"\"Return the next scripted damage ordering.\"\"\"\n        return self._pop()\n\n    def choose_card(self, cards: Any, description: str) -> Any:\n        \"\"\"Return the next scripted card choice.\"\"\"\n        return self._pop()\n","numLines":146,"startLine":1,"totalLines":146}}}
