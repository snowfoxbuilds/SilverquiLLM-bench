{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011nh1DaUv6WWt7FzGhUZWzk","type":"tool_result","content":"280\tdef cast_spell_free(\n281\t    game: GameState,\n282\t    player: Player,\n283\t    card: CardImpl,\n284\t    from_zone: Zone,\n285\t) -> None:\n286\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n287\t\n288\t    This is used by effects that allow casting from zones other than hand\n289\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n290\t    or cascade.\n291\t\n292\t    Pipeline\n293\t    --------\n294\t    1. **can_cast** — ask the card whether it can legally be cast (same\n295\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n296\t    2. Move *card* from *from_zone* to the stack zone.\n297\t    3. Choose targets (if applicable) with validation and protection check.\n298\t    4. Call ``on_cast`` hook.\n299\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n300\t       resolution normally (permanents → battlefield, non-permanents →\n301\t       graveyard).\n302\t\n303\t    No timing check or mana payment is performed.  The spell goes on the\n304\t    stack and can be responded to normally (e.g. countered).\n305\t\n306\t    If targeting or other post-move checks fail, the card is rolled back\n307\t    to its source zone.\n308\t\n309\t    Parameters:\n310\t        game: The current game state.\n311\t        player: The player casting the spell.\n312\t        card: The card to cast.\n313\t        from_zone: The zone the card is currently in.\n314\t\n315\t    Raises:\n316\t        CastingError: If the card cannot be found in *from_zone* or\n317\t            legality checks fail.\n318\t    \"\"\"\n319\t    from engine.zones import move_to_zone\n320\t\n321\t    # Ensure controller is set\n322\t    card.controller = player\n323\t    if card.owner is None:\n324\t        card.owner = player\n325\t\n326\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n327\t    if not card.can_cast(game):\n328\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n329\t\n330\t    # 2. Locate card in source zone\n331\t    source_zone_container = player.zones[from_zone]\n332\t    if not source_zone_container.contains(card):\n333\t        # Try to find the card in any player's zone\n334\t        source_zone_container = None\n335\t        for p in game.players:\n336\t            z = p.zones[from_zone]\n337\t            if z.contains(card):\n338\t                source_zone_container = z\n339\t                break\n340\t\n341\t    if source_zone_container is None or not source_zone_container.contains(card):\n342\t        raise CastingError(\n343\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n344\t        )\n345\t\n346\t    # Move card from source zone to stack zone\n347\t    stack_zone = player.zones[Zone.STACK]\n348\t    source_zone_container.remove(card)\n349\t    stack_zone.add(card)\n350\t\n351\t    # 3. Choose targets (with rollback on failure)\n352\t    try:\n353\t        target_specs = card.get_targets(game)\n354\t        chosen_targets: list[Any] = []\n355\t        if target_specs:\n356\t            for spec in target_specs:\n357\t                target = player.choose_target(target_specs, spec)\n358\t                # Validate against filter_fn if the spec provides one\n359\t                filter_fn = getattr(spec, \"filter_fn\", None)\n360\t                if filter_fn is not None and target is not None:\n361\t                    if not filter_fn(target):\n362\t                        raise CastingError(\n363\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n364\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n365\t                        )\n366\t                chosen_targets.append(target)\n367\t\n368\t        # Protection check — reject targets that have protection from this spell\n369\t        from engine.protection import has_protection_from\n370\t\n371\t        for target in chosen_targets:\n372\t            if has_protection_from(target, card):\n373\t                raise CastingError(\n374\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n375\t                )\n376\t    except Exception as exc:\n377\t        # Rollback: move card from stack zone back to source zone\n378\t        stack_zone.remove(card)\n379\t        source_zone_container.add(card)\n380\t        raise CastingError(str(exc)) from exc\n381\t\n382\t    # 4. Call on_cast hook\n383\t    card.on_cast(game)\n384\t\n385\t    # 5. Build on_resolve callback and push StackObject\n386\t    stack_obj = StackObject(\n387\t        source=card,\n388\t        controller=player,\n389\t        targets=chosen_targets,\n390\t        on_resolve=lambda g: None,  # replaced below\n391\t    )\n392\t\n393\t    def _on_resolve(g: GameState) -> None:\n394\t        _resolve_spell(g, card, player, stack_obj)\n395\t\n396\t    stack_obj.on_resolve = _on_resolve\n397\t    game.stack.push(stack_obj)\n398\t\n399\t    # A spell cast from any zone (exile, graveyard, etc.) is still a cast and\n400\t    # fires the \"whenever you cast a spell\" event.\n401\t    from engine.events import SpellCastTriggeredEvent\n402\t\n403\t    game.trigger_manager.fire_event(\n404\t        game,\n405\t        SpellCastTriggeredEvent(\n406\t            spell=stack_obj, player=player, card=card, controller=player\n407\t        ),\n408\t    )\n409\t\n410\t\n411\t# ------------------------------------------------------------------\n412\t# Resolution (called when the stack pops)\n413\t# ------------------------------------------------------------------\n414\t"}]},"parent_tool_use_id":null,"session_id":"6b0c2803-fb7f-4347-8991-d01b6c022fd2","uuid":"2f249a8c-cefd-441e-aa23-f562aaa01e4c","timestamp":"2026-06-04T11:35:20.323Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"def cast_spell_free(\n    game: GameState,\n    player: Player,\n    card: CardImpl,\n    from_zone: Zone,\n) -> None:\n    \"\"\"Cast *card* without paying its mana cost, using the stack.\n\n    This is used by effects that allow casting from zones other than hand\n    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n    or cascade.\n\n    Pipeline\n    --------\n    1. **can_cast** — ask the card whether it can legally be cast (same\n       legality as :func:`cast_spell`, minus mana/timing constraints).\n    2. Move *card* from *from_zone* to the stack zone.\n    3. Choose targets (if applicable) with validation and protection check.\n    4. Call ``on_cast`` hook.\n    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n       resolution normally (permanents → battlefield, non-permanents →\n       graveyard).\n\n    No timing check or mana payment is performed.  The spell goes on the\n    stack and can be responded to normally (e.g. countered).\n\n    If targeting or other post-move checks fail, the card is rolled back\n    to its source zone.\n\n    Parameters:\n        game: The current game state.\n        player: The player casting the spell.\n        card: The card to cast.\n        from_zone: The zone the card is currently in.\n\n    Raises:\n        CastingError: If the card cannot be found in *from_zone* or\n            legality checks fail.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Ensure controller is set\n    card.controller = player\n    if card.owner is None:\n        card.owner = player\n\n    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 2. Locate card in source zone\n    source_zone_container = player.zones[from_zone]\n    if not source_zone_container.contains(card):\n        # Try to find the card in any player's zone\n        source_zone_container = None\n        for p in game.players:\n            z = p.zones[from_zone]\n            if z.contains(card):\n                source_zone_container = z\n                break\n\n    if source_zone_container is None or not source_zone_container.contains(card):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n        )\n\n    # Move card from source zone to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    source_zone_container.remove(card)\n    stack_zone.add(card)\n\n    # 3. Choose targets (with rollback on failure)\n    try:\n        target_specs = card.get_targets(game)\n        chosen_targets: list[Any] = []\n        if target_specs:\n            for spec in target_specs:\n                target = player.choose_target(target_specs, spec)\n                # Validate against filter_fn if the spec provides one\n                filter_fn = getattr(spec, \"filter_fn\", None)\n                if filter_fn is not None and target is not None:\n                    if not filter_fn(target):\n                        raise CastingError(\n                            f\"Cannot cast {card.name!r} — chosen target does not \"\n                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                        )\n                chosen_targets.append(target)\n\n        # Protection check — reject targets that have protection from this spell\n        from engine.protection import has_protection_from\n\n        for target in chosen_targets:\n            if has_protection_from(target, card):\n                raise CastingError(\n                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n                )\n    except Exception as exc:\n        # Rollback: move card from stack zone back to source zone\n        stack_zone.remove(card)\n        source_zone_container.add(card)\n        raise CastingError(str(exc)) from exc\n\n    # 4. Call on_cast hook\n    card.on_cast(game)\n\n    # 5. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n    # A spell cast from any zone (exile, graveyard, etc.) is still a cast and\n    # fires the \"whenever you cast a spell\" event.\n    from engine.events import SpellCastTriggeredEvent\n\n    game.trigger_manager.fire_event(\n        game,\n        SpellCastTriggeredEvent(\n            spell=stack_obj, player=player, card=card, controller=player\n        ),\n    )\n\n\n# ------------------------------------------------------------------\n# Resolution (called when the stack pops)\n# ------------------------------------------------------------------\n","numLines":135,"startLine":280,"totalLines":540}}}
