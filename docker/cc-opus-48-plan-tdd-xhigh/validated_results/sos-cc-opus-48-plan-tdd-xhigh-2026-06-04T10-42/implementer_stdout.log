{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019GGPjY2uP5t61omiYcH3rz","type":"tool_result","content":"137\t# Replacement events\n138\t# ---------------------------------------------------------------------------\n139\t\n140\t@dataclass\n141\tclass ReplacementEvent:\n142\t    \"\"\"Base class for all replacement-effect events.\"\"\"\n143\t\n144\t\n145\t@dataclass\n146\tclass MoveToGraveyardReplacementEvent(ReplacementEvent):\n147\t    \"\"\"Any permanent moving to a graveyard.\n148\t\n149\t    Subclass this for specific causes (destruction, sacrifice, etc.).\n150\t    A replacement registered for this type also fires for all subtypes.\n151\t\n152\t    ``destination`` may be mutated by a replacement to redirect the\n153\t    permanent to a different zone (``\"exile\"``, ``\"library\"``, ``\"hand\"``).\n154\t    Set ``prevented = True`` to signal that the replacement handled the\n155\t    zone move itself and the engine should skip its own move.\n156\t    \"\"\"\n157\t\n158\t    destination: str = \"graveyard\"\n159\t    controller: Any = None\n160\t    owner: Any = None\n161\t    prevented: bool = False\n162\t\n163\t    @property\n164\t    def card(self) -> Any:\n165\t        \"\"\"The object moving to the graveyard (overridden by subclasses).\"\"\"\n166\t        return None\n167\t\n168\t\n169\t@dataclass\n170\tclass CreatureDiesReplacementEvent(MoveToGraveyardReplacementEvent):\n171\t    \"\"\"A creature going to the graveyard via destruction or lethal damage.\"\"\"\n172\t\n173\t    creature: Any = None\n174\t\n175\t    @property\n176\t    def card(self) -> Any:\n177\t        return self.creature\n178\t\n179\t\n180\t@dataclass\n181\tclass PermanentDestroyedReplacementEvent(MoveToGraveyardReplacementEvent):\n182\t    \"\"\"A non-creature permanent going to the graveyard via destruction.\"\"\"\n183\t\n184\t    permanent: Any = None\n185\t\n186\t    @property\n187\t    def card(self) -> Any:\n188\t        return self.permanent\n189\t\n190\t\n191\t@dataclass\n192\tclass SacrificeReplacementEvent(MoveToGraveyardReplacementEvent):\n193\t    \"\"\"A permanent going to the graveyard via sacrifice.\"\"\"\n194\t\n195\t    permanent: Any = None\n196\t\n197\t    @property\n198\t    def card(self) -> Any:\n199\t        return self.permanent\n200\t\n201\t\n202\t@dataclass\n203\tclass SpellResolvesToGraveyardReplacementEvent(MoveToGraveyardReplacementEvent):\n204\t    \"\"\"A resolved instant/sorcery about to be put into its owner's graveyard.\n205\t\n206\t    Cards that read \"if this spell would be put into a graveyard this turn,\n207\t    exile it instead\" register a replacement for this event.  ``destination``\n208\t    may be mutated to redirect the card (e.g. ``\"exile\"``).\n209\t    \"\"\"\n210\t\n211\t    spell: Any = None\n212\t\n213\t    @property\n214\t    def card(self) -> Any:\n215\t        return self.spell\n216\t\n217\t\n218\t@dataclass\n219\tclass CreateTokenReplacementEvent(ReplacementEvent):\n220\t    \"\"\"An effect about to create one or more tokens.\"\"\"\n221\t\n222\t    player: Any = None\n223\t    count: int = 1\n224\t\n225\t\n226\t@dataclass\n227\tclass AddCounterReplacementEvent(ReplacementEvent):\n228\t    \"\"\"An effect about to add one or more counters to a permanent.\"\"\"\n229\t\n230\t    permanent: Any = None\n231\t    amount: int = 1"}]},"parent_tool_use_id":null,"session_id":"6b0c2803-fb7f-4347-8991-d01b6c022fd2","uuid":"a54e5cc8-311c-472f-b9d8-b2268cf39838","timestamp":"2026-06-04T11:35:05.722Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/events.py","content":"# Replacement events\n# ---------------------------------------------------------------------------\n\n@dataclass\nclass ReplacementEvent:\n    \"\"\"Base class for all replacement-effect events.\"\"\"\n\n\n@dataclass\nclass MoveToGraveyardReplacementEvent(ReplacementEvent):\n    \"\"\"Any permanent moving to a graveyard.\n\n    Subclass this for specific causes (destruction, sacrifice, etc.).\n    A replacement registered for this type also fires for all subtypes.\n\n    ``destination`` may be mutated by a replacement to redirect the\n    permanent to a different zone (``\"exile\"``, ``\"library\"``, ``\"hand\"``).\n    Set ``prevented = True`` to signal that the replacement handled the\n    zone move itself and the engine should skip its own move.\n    \"\"\"\n\n    destination: str = \"graveyard\"\n    controller: Any = None\n    owner: Any = None\n    prevented: bool = False\n\n    @property\n    def card(self) -> Any:\n        \"\"\"The object moving to the graveyard (overridden by subclasses).\"\"\"\n        return None\n\n\n@dataclass\nclass CreatureDiesReplacementEvent(MoveToGraveyardReplacementEvent):\n    \"\"\"A creature going to the graveyard via destruction or lethal damage.\"\"\"\n\n    creature: Any = None\n\n    @property\n    def card(self) -> Any:\n        return self.creature\n\n\n@dataclass\nclass PermanentDestroyedReplacementEvent(MoveToGraveyardReplacementEvent):\n    \"\"\"A non-creature permanent going to the graveyard via destruction.\"\"\"\n\n    permanent: Any = None\n\n    @property\n    def card(self) -> Any:\n        return self.permanent\n\n\n@dataclass\nclass SacrificeReplacementEvent(MoveToGraveyardReplacementEvent):\n    \"\"\"A permanent going to the graveyard via sacrifice.\"\"\"\n\n    permanent: Any = None\n\n    @property\n    def card(self) -> Any:\n        return self.permanent\n\n\n@dataclass\nclass SpellResolvesToGraveyardReplacementEvent(MoveToGraveyardReplacementEvent):\n    \"\"\"A resolved instant/sorcery about to be put into its owner's graveyard.\n\n    Cards that read \"if this spell would be put into a graveyard this turn,\n    exile it instead\" register a replacement for this event.  ``destination``\n    may be mutated to redirect the card (e.g. ``\"exile\"``).\n    \"\"\"\n\n    spell: Any = None\n\n    @property\n    def card(self) -> Any:\n        return self.spell\n\n\n@dataclass\nclass CreateTokenReplacementEvent(ReplacementEvent):\n    \"\"\"An effect about to create one or more tokens.\"\"\"\n\n    player: Any = None\n    count: int = 1\n\n\n@dataclass\nclass AddCounterReplacementEvent(ReplacementEvent):\n    \"\"\"An effect about to add one or more counters to a permanent.\"\"\"\n\n    permanent: Any = None\n    amount: int = 1","numLines":95,"startLine":137,"totalLines":232}}}
