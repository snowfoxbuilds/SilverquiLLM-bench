{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011N7JWWDc3pzoG1xoKHjMrc","type":"tool_result","content":"476\tdef flip_coin(game: GameState, player: Player) -> bool:\n477\t    \"\"\"Flip a coin for *player*; return ``True`` for heads.\n478\t\n479\t    Modeled via :meth:`Player.choose_yes_no` so the outcome is\n480\t    deterministic and scriptable (heads == yes).\n481\t\n482\t    Parameters:\n483\t        game: The current game state.\n484\t        player: The player flipping the coin (and calling it).\n485\t\n486\t    Returns:\n487\t        ``True`` if the flip comes up heads, ``False`` for tails.\n488\t    \"\"\"\n489\t    return bool(player.choose_yes_no(\"Coin flip: heads?\"))\n490\t\n491\t\n492\tdef surveil(game: GameState, player: Player, n: int) -> None:\n493\t    \"\"\"Surveil *n* — look at the top *n* cards of *player*'s library and,\n494\t    for each, choose to keep it on top or put it into the graveyard.\n495\t\n496\t    For each of the top *n* cards (top-first), :meth:`Player.choose_yes_no`\n497\t    decides whether to keep it on top (``True``) or move it to the\n498\t    graveyard (``False``). Kept cards retain their relative order.\n499\t\n500\t    Parameters:\n501\t        game: The current game state.\n502\t        player: The player surveilling.\n503\t        n: The number of cards to look at.\n504\t    \"\"\"\n505\t    if n <= 0:\n506\t        return\n507\t\n508\t    library = player.zones[Zone.LIBRARY]\n509\t    graveyard = player.zones[Zone.GRAVEYARD]\n510\t\n511\t    # library.top(n) returns bottom-to-top; reverse so we process the\n512\t    # actual top card first.\n513\t    for card in reversed(library.top(n)):\n514\t        if not library.contains(card):\n515\t            continue\n516\t        keep = player.choose_yes_no(\n517\t            f\"Surveil: keep {getattr(card, 'name', 'card')} on top?\"\n518\t        )\n519\t        if not keep:\n520\t            library.remove(card)\n521\t            graveyard.add(card)\n522\t\n523\t\n524\t# ---------------------------------------------------------------------------\n525\t# Game loop\n526\t# ---------------------------------------------------------------------------\n527\t\n528\tdef run_game(game: GameState) -> Player | None:\n529\t    \"\"\"Run the game loop until the game ends.\n530\t\n531\t    Executes :func:`~engine.turn.run_turn` in a loop, checking\n532\t    :attr:`GameState.is_game_over` after each turn.  State-based actions\n533\t    are resolved before and after each turn to catch game-ending conditions\n534\t    even when the priority loop auto-passes.\n535\t"}]},"parent_tool_use_id":null,"session_id":"6b0c2803-fb7f-4347-8991-d01b6c022fd2","uuid":"80ee72bf-b5d7-486c-80e8-70e87378e38c","timestamp":"2026-06-04T11:38:11.987Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/game.py","content":"def flip_coin(game: GameState, player: Player) -> bool:\n    \"\"\"Flip a coin for *player*; return ``True`` for heads.\n\n    Modeled via :meth:`Player.choose_yes_no` so the outcome is\n    deterministic and scriptable (heads == yes).\n\n    Parameters:\n        game: The current game state.\n        player: The player flipping the coin (and calling it).\n\n    Returns:\n        ``True`` if the flip comes up heads, ``False`` for tails.\n    \"\"\"\n    return bool(player.choose_yes_no(\"Coin flip: heads?\"))\n\n\ndef surveil(game: GameState, player: Player, n: int) -> None:\n    \"\"\"Surveil *n* — look at the top *n* cards of *player*'s library and,\n    for each, choose to keep it on top or put it into the graveyard.\n\n    For each of the top *n* cards (top-first), :meth:`Player.choose_yes_no`\n    decides whether to keep it on top (``True``) or move it to the\n    graveyard (``False``). Kept cards retain their relative order.\n\n    Parameters:\n        game: The current game state.\n        player: The player surveilling.\n        n: The number of cards to look at.\n    \"\"\"\n    if n <= 0:\n        return\n\n    library = player.zones[Zone.LIBRARY]\n    graveyard = player.zones[Zone.GRAVEYARD]\n\n    # library.top(n) returns bottom-to-top; reverse so we process the\n    # actual top card first.\n    for card in reversed(library.top(n)):\n        if not library.contains(card):\n            continue\n        keep = player.choose_yes_no(\n            f\"Surveil: keep {getattr(card, 'name', 'card')} on top?\"\n        )\n        if not keep:\n            library.remove(card)\n            graveyard.add(card)\n\n\n# ---------------------------------------------------------------------------\n# Game loop\n# ---------------------------------------------------------------------------\n\ndef run_game(game: GameState) -> Player | None:\n    \"\"\"Run the game loop until the game ends.\n\n    Executes :func:`~engine.turn.run_turn` in a loop, checking\n    :attr:`GameState.is_game_over` after each turn.  State-based actions\n    are resolved before and after each turn to catch game-ending conditions\n    even when the priority loop auto-passes.\n","numLines":60,"startLine":476,"totalLines":586}}}
