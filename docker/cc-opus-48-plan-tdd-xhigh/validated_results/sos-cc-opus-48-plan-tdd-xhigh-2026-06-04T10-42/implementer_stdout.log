------------------------------------------------\n192\t    # Hook methods — override in subclasses / card definitions\n193\t    # ------------------------------------------------------------------\n194\t\n195\t    def can_cast(self, game: GameState) -> bool:\n196\t        \"\"\"Return ``True`` if this card can currently be cast.\"\"\"\n197\t        return True\n198\t\n199\t    def cost_reduction(self, game: GameState) -> int:\n200\t        \"\"\"Return the generic mana reduction for casting this card.\n201\t\n202\t        Override in subclasses to implement cost-reduction mechanics\n203\t        (e.g. Embercleave costs {1} less for each attacking creature).\n204\t        The returned value is clamped so that generic mana cannot go below 0.\n205\t        Only reduces generic mana — colored costs are never reduced.\n206\t\n207\t        Returns:\n208\t            Non-negative integer representing generic mana to subtract.\n209\t        \"\"\"\n210\t        return 0\n211\t\n212\t    def static_cost_reduction(\n213\t        self, game: GameState, spell: \"CardImpl\", controller: Player\n214\t    ) -> int:\n215\t        \"\"\"Generic reduction this permanent grants to *other* spells.\n216\t\n217\t        Override in a permanent (on the battlefield) that reduces the cost\n218\t        of spells its controller casts — e.g. granting affinity to your\n219\t        instants and sorceries.  Called for every battlefield permanent the\n220\t        casting player controls, so the implementation should return 0 when\n221\t        *spell* does not match the permanent's condition.\n222\t\n223\t        Returns:\n224\t            Non-negative generic reduction to add (clamped to generic later).\n225\t        \"\"\"\n226\t        return 0\n227\t\n228\t    def on_cast(self, game: GameState) -> None:\n229\t        \"\"\"Called when the card is cast (before it goes on the stack).\"\"\"\n230\t\n231\t    def on_resolve(self, game: GameState) -> None:\n232\t        \"\"\"Called when the spell resolves from the stack.\n233\t\n234\t        Targets are available via ``self.chosen_targets`` — set at\n235\t        resolve-time by :func:`~engine.casting._resolve_spell` from\n236\t        :attr:`StackObject.targets`, or directly by test code.\n237\t        \"\"\"\n238\t\n239\t    def get_targets(self, game: GameState) -> list[Any]:\n240\t        \"\"\"Return a list of legal targets for this card.\"\"\"\n241\t        return []\n242\t\n243\t    def register_triggers(self, game: GameState) -> None:\n244\t        \"\"\"Register any triggered abilities this card provides.\"\"\"\n245\t\n246\t    def register_replacement_effects(self, game: GameState) -> None:\n247\t        \"\"\"Register any replacement effects this card provides.\"\"\"\n248\t\n249\t    def get_activated_abilities(self) -> list[ActivatedAbility]:\n250\t        \"\"\"Return activated abilities this card provides.\"\"\"\n251\t        return []\n252\t\n253\t    def get_modes(self) -> list[Mode]:\n254\t        \"\"\"Return available modes for modal spells/abilities.\n255\t\n256\t        Non-modal cards return an empty list by default.\n257\t        \"\"\"\n258\t        return []\n259\t\n260\t\n261\t# ---------------------------------------------------------------------------\n262\t# Creature\n263\t# ---------------------------------------------------------------------------\n264\t\n265\tclass Creature(CardImpl):\n266\t    \"\"\"A creature card.\n267\t\n268\t    Attributes:\n269\t        base_power: The printed power value (rule 208.1). Immutable after init.\n270\t        base_toughness: The printed toughness value. Immutable after init.\n271\t        modified_power: Current power after continuous effects (Layer 7c), before counters.\n272\t            Reset to ``base_power`` each effect cycle; continuous effects write here.\n273\t        modified_toughness: Current toughness after continuous effects, before counters.\n274\t        damage_marked: Amount of damage currently marked on this creature.\n275\t        is_tapped: Whether the creature is tapped.\n276\t        summoning_sick: Whether the creature has summoning sickness.\n277\t        is_attacking: Combat flag — currently declared as an attacker."}]},"parent_tool_use_id":null,"session_id":"6b0c2803-fb7f-4347-8991-d01b6c022fd2","uuid":"6fc51e5b-5da1-457b-a2cb-5bc42ac2a126","timestamp":"2026-06-04T11:14:44.189Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/card.py","content":"        card_types: set[CardType] | None = None,\n        subtypes: set[str] | None = None,\n        supertypes: set[Supertype] | None = None,\n        keywords: Keyword | None = None,\n        rules_text: str = \"\",\n        owner: Player | None = None,\n        controller: Player | None = None,\n    ) -> None:\n        super().__init__(owner=owner, controller=controller)\n        self.name: str = name\n        self.mana_cost: ManaCost = mana_cost if mana_cost is not None else ManaCost()\n        self.card_types: set[CardType] = card_types if card_types is not None else set()\n        self.subtypes: set[str] = subtypes if subtypes is not None else set()\n        self.supertypes: set[Supertype] = supertypes if supertypes is not None else set()\n        self.keywords: Keyword = keywords if keywords is not None else Keyword(0)\n        self.rules_text: str = rules_text\n        # Snapshot original characteristics for continuous-effect reset.\n        self._original_card_types: frozenset[CardType] = frozenset(self.card_types)\n        self._original_keywords: Keyword = self.keywords\n\n    # ------------------------------------------------------------------\n    # Continuous-effect reset support\n    # ------------------------------------------------------------------\n\n    def _reset_characteristics(self) -> None:\n        \"\"\"Reset mutable characteristics to their original (pre-effect) values.\n\n        Called by :meth:`EffectManager.apply_all` before reapplying effects\n        so that the recalculation is id