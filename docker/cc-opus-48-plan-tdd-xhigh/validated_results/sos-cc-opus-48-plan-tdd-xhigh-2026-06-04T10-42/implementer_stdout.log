{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AK4eZJc6p2vLvDdag759V1","type":"tool_result","content":"210\t    for target in chosen_targets:\n211\t        if has_protection_from(target, card):\n212\t            # Rollback: move card from stack zone back to hand\n213\t            stack_zone.remove(card)\n214\t            hand.add(card)\n215\t            raise CastingError(\n216\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n217\t            )\n218\t\n219\t    # Targets are stored on the StackObject (not the card) and passed\n220\t    # through the resolve pipeline via on_resolve(game, targets=...).\n221\t\n222\t    # 6. Mana check / payment (rollback on failure)\n223\t    # Ensure the card knows its controller so that cost_reduction() hooks\n224\t    # (e.g. Embercleave counting attacking creatures you control) see the\n225\t    # casting player, even for cards that were added to hand without an\n226\t    # explicit controller assignment.\n227\t    if card.controller is None:\n228\t        card.controller = player\n229\t    reduction = get_cost_reduction(game, card, player)\n230\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n231\t\n232\t    if not player.mana_pool.can_pay(effective_cost):\n233\t        # Rollback: move card from stack zone back to hand\n234\t        stack_zone.remove(card)\n235\t        hand.add(card)\n236\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n237\t\n238\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n239\t    player.mana_pool.pay(effective_cost)\n240\t\n241\t    # Store colors of mana spent on the card for mechanics like Converge\n242\t    # that care about the colors used to cast the spell.\n243\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n244\t\n245\t    # 7. Call on