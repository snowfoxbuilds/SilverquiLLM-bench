{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011tRFaj34HsWG7DUSSheTVB","type":"tool_result","content":"415\tdef _resolve_spell(\n416\t    game: GameState,\n417\t    card: CardImpl,\n418\t    player: Player,\n419\t    stack_obj: StackObject,\n420\t) -> None:\n421\t    \"\"\"Resolve *card* cast by *player*.\n422\t\n423\t    1. Call ``card.on_resolve(game, targets=targets)``.\n424\t    2. Remove the card from the stack zone.\n425\t    3. If the card is a permanent type, move it to the battlefield via\n426\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n427\t       registration and the ETB event).\n428\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n429\t    \"\"\"\n430\t    from engine.zones import move_to_zone\n431\t\n432\t    # Read targets from the StackObject — the single source of truth.\n433\t    # Set chosen_targets on the card just before resolution so that\n434\t    # _get_chosen_target helpers (which read via getattr) work.\n435\t    targets = stack_obj.targets\n436\t    if targets is not None:\n437\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n438\t\n439\t    card.on_resolve(game)\n440\t\n441\t    if card.card_types & _PERMANENT_TYPES:\n442\t        # Move from stack to battlefield via move_to_zone, which handles\n443\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n444\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n445\t    else:\n446\t        # Instant/sorcery: move from stack to graveyard. Consult replacement\n447\t        # effects first so cards reading \"if this spell would be put into a\n448\t        # graveyard, exile it instead\" can redirect the destination. The\n449\t        # stack→graveyard move does not pass through the battlefield, so\n450\t        # move_to_zone would not consult replacements on its own.\n451\t        from engine.events import SpellResolvesToGraveyardReplacementEvent\n452\t        from engine.zones import _DESTINATION_ZONE_MAP\n453\t\n454\t        ev = SpellResolvesToGraveyardReplacementEvent(\n455\t            spell=card,\n456\t            controller=player,\n457\t            owner=card.owner,\n458\t        )\n459\t        ev = game.replacement_manager.apply(game, ev)\n460\t        if not getattr(ev, \"prevented\", False):\n461\t            dest = _DESTINATION_ZONE_MAP.get(ev.destination, Zone.GRAVEYARD)\n462\t            move_to_zone(game, card, Zone.STACK, dest)\n463\t\n464\t\n465\t# ------------------------------------------------------------------\n466\t# Play land (special action — does not use the stack)\n467\t# ------------------------------------------------------------------\n468\t\n469\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n470\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n471\t\n472\t    Requirements (all must hold):\n473\t\n474\t    * *land_card* has :attr:`CardType.LAND`.\n475\t    * *player* is the active player.\n476\t    * Current phase is a main phase.\n477\t    * The stack is empty.\n478\t    * ``player.land_plays_remaining > 0``.\n479\t    * The card is in the player's hand.\n480\t\n481\t    On success the card moves from hand to battlefield and\n482\t    ``land_plays_remaining`` is decremented.\n483\t\n484\t    Raises:\n485\t        CastingError: If any requirement is not met.\n486\t    \"\"\"\n487\t    # Must be a land\n488\t    if CardType.LAND not in land_card.card_types:\n489\t        raise CastingError(\n490\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n491\t        )\n492\t\n493\t    # Sorcery-speed timing (active player, main phase, stack empty)\n494\t    if not is_sorcery_speed(game, player):\n495\t        raise CastingError(\n496\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n497\t            \"during main phase with empty stack\"\n498\t        )\n499\t\n500\t    # Land plays remaining\n501\t    if player.land_plays_remaining <= 0:\n502\t        raise CastingError(\n503\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n504\t        )\n505\t\n506\t    # Card must be in hand\n507\t    hand = game.get_hand(player)\n508\t    if not hand.contains(land_card):\n509\t        raise CastingError(\n510\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n511\t        )\n512\t\n513\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n514\t    if land_card.owner is None:\n515\t        land_card.owner = player\n516\t    land_card.controller = player\n517\t\n518\t    # Move from hand to battlefield via move_to_zone, which fires\n519\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n520\t    from engine.zones import move_to_zone\n521\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n522\t\n523\t    # Decrement land plays\n524\t    player.land_plays_remaining -= 1"}]},"parent_tool_use_id":null,"session_id":"6b0c2803-fb7f-4347-8991-d01b6c022fd2","uuid":"9517462b-6c45-4982-a9d9-aff9f6537fbd","timestamp":"2026-06-04T11:35:01.999Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"def _resolve_spell(\n    game: GameState,\n    card: CardImpl,\n    player: Player,\n    stack_obj: StackObject,\n) -> None:\n    \"\"\"Resolve *card* cast by *player*.\n\n    1. Call ``card.on_resolve(game, targets=targets)``.\n    2. Remove the card from the stack zone.\n    3. If the card is a permanent type, move it to the battlefield via\n       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n       registration and the ETB event).\n    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Read targets from the StackObject — the single source of truth.\n    # Set chosen_targets on the card just before resolution so that\n    # _get_chosen_target helpers (which read via getattr) work.\n    targets = stack_obj.targets\n    if targets is not None:\n        card.chosen_targets = targets  # type: ignore[attr-defined]\n\n    card.on_resolve(game)\n\n    if card.card_types & _PERMANENT_TYPES:\n        # Move from stack to battlefield via move_to_zone, which handles\n        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n    else:\n        # Instant/sorcery: move from stack to graveyard. Consult replacement\n        # effects first so cards reading \"if this spell would be put into a\n        # graveyard, exile it instead\" can redirect the destination. The\n        # stack→graveyard move does not pass through the battlefield, so\n        # move_to_zone would not consult replacements on its own.\n        from engine.events import SpellResolvesToGraveyardReplacementEvent\n        from engine.zones import _DESTINATION_ZONE_MAP\n\n        ev = SpellResolvesToGraveyardReplacementEvent(\n            spell=card,\n            controller=player,\n            owner=card.owner,\n        )\n        ev = game.replacement_manager.apply(game, ev)\n        if not getattr(ev, \"prevented\", False):\n            dest = _DESTINATION_ZONE_MAP.get(ev.destination, Zone.GRAVEYARD)\n            move_to_zone(game, card, Zone.STACK, dest)\n\n\n# ------------------------------------------------------------------\n# Play land (special action — does not use the stack)\n# ------------------------------------------------------------------\n\ndef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n\n    Requirements (all must hold):\n\n    * *land_card* has :attr:`CardType.LAND`.\n    * *player* is the active player.\n    * Current phase is a main phase.\n    * The stack is empty.\n    * ``player.land_plays_remaining > 0``.\n    * The card is in the player's hand.\n\n    On success the card moves from hand to battlefield and\n    ``land_plays_remaining`` is decremented.\n\n    Raises:\n        CastingError: If any requirement is not met.\n    \"\"\"\n    # Must be a land\n    if CardType.LAND not in land_card.card_types:\n        raise CastingError(\n            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n        )\n\n    # Sorcery-speed timing (active player, main phase, stack empty)\n    if not is_sorcery_speed(game, player):\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — must be active player \"\n            \"during main phase with empty stack\"\n        )\n\n    # Land plays remaining\n    if player.land_plays_remaining <= 0:\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n        )\n\n    # Card must be in hand\n    hand = game.get_hand(player)\n    if not hand.contains(land_card):\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — card not in hand\"\n        )\n\n    # Ensure owner/controller are set so move_to_zone routes correctly.\n    if land_card.owner is None:\n        land_card.owner = player\n    land_card.controller = player\n\n    # Move from hand to battlefield via move_to_zone, which fires\n    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n    from engine.zones import move_to_zone\n    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n\n    # Decrement land plays\n    player.land_plays_remaining -= 1","numLines":110,"startLine":415,"totalLines":540}}}
