{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C6RMgBv1s2p6jMyET784cF","type":"tool_result","content":"1\t\"\"\"Card implementation for Gorehorn Raider.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.types import ManaCost, TargetRequirement, Zone\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t\n13\t\n14\tclass GorehornRaider(Creature):\n15\t    \"\"\"Gorehorn Raider — {4}{R} — 4/4 — Minotaur Pirate.\n16\t\n17\t    Raid — When this creature enters, if you attacked this turn, this\n18\t    creature deals 2 damage to any target.\n19\t\n20\t    FDN collector number 89.\n21\t    \"\"\"\n22\t\n23\t    def __init__(self, **kwargs: Any) -> None:\n24\t        kwargs.setdefault(\"name\", \"Gorehorn Raider\")\n25\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{4}{R}\"))\n26\t        kwargs.setdefault(\"subtypes\", {\"Minotaur\", \"Pirate\"})\n27\t        kwargs.setdefault(\"base_power\", 4)\n28\t        kwargs.setdefault(\"base_toughness\", 4)\n29\t        kwargs.setdefault(\n30\t            \"rules_text\",\n31\t            \"Raid — When this creature enters, if you attacked this turn, \"\n32\t            \"this creature deals 2 damage to any target.\",\n33\t        )\n34\t        super().__init__(**kwargs)\n35\t\n36\t    def on_resolve(self, game: \"GameState\") -> None:\n37\t        \"\"\"ETB: Raid — deal 2 damage to any target if attacked this turn.\"\"\"\n38\t        from engine.game import deal_damage\n39\t\n40\t        controller = self.controller\n41\t        if controller is None:\n42\t            return\n43\t\n44\t        attacked_this_turn = getattr(game, \"attacked_this_turn\", False)\n45\t        if not attacked_this_turn:\n46\t            combat = getattr(game, \"combat\", None)\n47\t            if combat is not None:\n48\t                attackers = getattr(combat, \"attackers\", [])\n49\t                for attacker in attackers:\n50\t                    if getattr(attacker, \"controller\", None) is controller:\n51\t                        attacked_this_turn = True\n52\t                        break\n53\t        if not attacked_this_turn:\n54\t            attacked_this_turn = getattr(controller, \"attacked_this_turn\", False)\n55\t\n56\t        if not attacked_this_turn:\n57\t            return\n58\t\n59\t        # Any target: creatures on battlefield + players\n60\t        from engine.types import CardType\n61\t        targets: list = list(game.players)\n62\t        for player in game.players:\n63\t            bf = game.get_battlefield(player)\n64\t            for obj in bf.get_all():\n65\t                if CardType.CREATURE in getattr(obj, \"card_types\", set()):\n66\t                    targets.append(obj)\n67\t\n68\t        if not targets:\n69\t            return\n70\t\n71\t        try:\n72\t            chosen = controller.choose_card(targets, \"target for 2 damage\")\n73\t        except Exception:\n74\t            chosen = targets[0]\n75\t\n76\t        if chosen is not None:\n77\t            deal_damage(game, self, chosen, 2)\n78\t"}]},"parent_tool_use_id":null,"session_id":"6b0c2803-fb7f-4347-8991-d01b6c022fd2","uuid":"0b2e22fa-6af8-42da-94c9-dc17b2fc043d","timestamp":"2026-06-04T11:06:12.050Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_89/card_impl.py","content":"\"\"\"Card implementation for Gorehorn Raider.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import Creature\nfrom engine.types import ManaCost, TargetRequirement, Zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\nclass GorehornRaider(Creature):\n    \"\"\"Gorehorn Raider — {4}{R} — 4/4 — Minotaur Pirate.\n\n    Raid — When this creature enters, if you attacked this turn, this\n    creature deals 2 damage to any target.\n\n    FDN collector number 89.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"Gorehorn Raider\")\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{4}{R}\"))\n        kwargs.setdefault(\"subtypes\", {\"Minotaur\", \"Pirate\"})\n        kwargs.setdefault(\"base_power\", 4)\n        kwargs.setdefault(\"base_toughness\", 4)\n        kwargs.setdefault(\n            \"rules_text\",\n            \"Raid — When this creature enters, if you attacked this turn, \"\n            \"this creature deals 2 damage to any target.\",\n        )\n        super().__init__(**kwargs)\n\n    def on_resolve(self, game: \"GameState\") -> None:\n        \"\"\"ETB: Raid — deal 2 damage to any target if attacked this turn.\"\"\"\n        from engine.game import deal_damage\n\n        controller = self.controller\n        if controller is None:\n            return\n\n        attacked_this_turn = getattr(game, \"attacked_this_turn\", False)\n        if not attacked_this_turn:\n            combat = getattr(game, \"combat\", None)\n            if combat is not None:\n                attackers = getattr(combat, \"attackers\", [])\n                for attacker in attackers:\n                    if getattr(attacker, \"controller\", None) is controller:\n                        attacked_this_turn = True\n                        break\n        if not attacked_this_turn:\n            attacked_this_turn = getattr(controller, \"attacked_this_turn\", False)\n\n        if not attacked_this_turn:\n            return\n\n        # Any target: creatures on battlefield + players\n        from engine.types import CardType\n        targets: list = list(game.players)\n        for player in game.players:\n            bf = game.get_battlefield(player)\n            for obj in bf.get_all():\n                if CardType.CREATURE in getattr(obj, \"card_types\", set()):\n                    targets.append(obj)\n\n        if not targets:\n            return\n\n        try:\n            chosen = controller.choose_card(targets, \"target for 2 damage\")\n        except Exception:\n            chosen = targets[0]\n\n        if chosen is not None:\n            deal_damage(game, self, chosen, 2)\n","numLines":78,"startLine":1,"totalLines":78}}}
