{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TFBmR3GiEKD2eEgJqQd2WD","type":"tool_result","content":"121\t    # ------------------------------------------------------------------\n122\t\n123\t    def add(self, effect: ContinuousEffect) -> ContinuousEffect:\n124\t        \"\"\"Add a continuous effect, auto-assigning a timestamp if it's 0.\n125\t\n126\t        Args:\n127\t            effect: The effect to register.\n128\t\n129\t        Returns:\n130\t            The effect (with timestamp populated).\n131\t        \"\"\"\n132\t        if effect.timestamp == 0:\n133\t            effect.timestamp = self._next_timestamp\n134\t            self._next_timestamp += 1\n135\t        else:\n136\t            # Keep _next_timestamp ahead of any manually assigned timestamps.\n137\t            if effect.timestamp >= self._next_timestamp:\n138\t                self._next_timestamp = effect.timestamp + 1\n139\t        self._effects.append(effect)\n140\t        return effect\n141\t\n142\t    def remove(self, effect: ContinuousEffect) -> bool:\n143\t        \"\"\"Remove a specific effect by identity.\n144\t\n145\t        Returns:\n146\t            ``True`` if the effect was found and removed, ``False`` otherwise.\n147\t        \"\"\"\n148\t        for i, e in enumerate(self._effects):\n149\t            if e is effect:\n150\t                self._effects.pop(i)\n151\t                return True\n152\t        return False\n153\t\n154\t    def remove_expired(self, game: GameState) -> int:\n155\t        \"\"\"Remove effects whose duration has expired.\n156\t\n157\t        - ``DURATION_PERMANENT`` (−1): never expires automatically.\n158\t        - ``DURATION_END_OF_TURN`` (0): removed when this method is called\n159\t          (typically during the cleanup step).\n160\t        - Positive integer *n*: removed when ``game.turn_number > n``.\n161\t\n162\t        Args:\n163\t            game: The current game state (used for turn number).\n164\t\n165\t        Returns:\n166\t            The number of effects removed.\n167\t        \"\"\"\n168\t        before = len(self._effects)\n169\t        remaining: list[ContinuousEffect] = []\n170\t        for eff in self._effects:\n171\t            if eff.duration == DURATION_PERMANENT:\n172\t                remaining.append(eff)\n173\t            elif eff.duration == DURATION_END_OF_TURN:\n174\t                # End-of-turn effects are swept away.\n175\t                continue\n176\t            elif game.turn_number > eff.duration:\n177\t                # Turn-numbered expiry.\n178\t                continue\n179\t            else:\n180\t                remaining.append(eff)\n181\t        self._effects = remaining\n182\t        return before - len(self._effects)\n183\t\n184\t    def apply_all(self, game: GameState) -> None:\n185\t        \"\"\"Apply all active effects in layer order, then timestamp order.\n186\t\n187\t        Before applying, all objects on each player's battlefield are reset\n188\t        to their original (pre-effect) characteristics so that calling this\n189\t        method multiple times is idempotent.\n190\t\n191\t        Within each layer (and sublayer for layer 7), effects are applied\n192\t        in timestamp order.  This method should be called whenever the\n193\t        game state needs a fresh recalculation of continuous effects —\n194\t        for example, after state-based actions or any game event that\n195\t        could change the set of applicable effects.\n196\t        \"\"\"\n197\t        # Reset battlefield objects to their base characteristics so that\n198\t        # reapplying effects does not accumulate on top of stale mutations.\n199\t        self._reset_objects(game)\n200\t\n201\t        sorted_effects = sorted(self._effects, key=lambda e: e._sort_key())\n202\t        for effect in sorted_effects:\n203\t            effect.apply(game)\n204\t\n205\t    # ------------------------------------------------------------------\n206\t    # Internal helpers\n207\t    # ------------------------------------------------------------------\n208\t\n209\t    def _reset_objects(self, game: GameState) -> None:\n210\t        \"\"\"Reset all battlefield objects to their original characteristics."}]},"parent_tool_use_id":null,"session_id":"6b0c2803-fb7f-4347-8991-d01b6c022fd2","uuid":"9935b846-e78e-47a0-9959-b36595ff41d8","timestamp":"2026-06-04T11:16:55.041Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/continuous_effects.py","content":"    # ------------------------------------------------------------------\n\n    def add(self, effect: ContinuousEffect) -> ContinuousEffect:\n        \"\"\"Add a continuous effect, auto-assigning a timestamp if it's 0.\n\n        Args:\n            effect: The effect to register.\n\n        Returns:\n            The effect (with timestamp populated).\n        \"\"\"\n        if effect.timestamp == 0:\n            effect.timestamp = self._next_timestamp\n            self._next_timestamp += 1\n        else:\n            # Keep _next_timestamp ahead of any manually assigned timestamps.\n            if effect.timestamp >= self._next_timestamp:\n                self._next_timestamp = effect.timestamp + 1\n        self._effects.append(effect)\n        return effect\n\n    def remove(self, effect: ContinuousEffect) -> bool:\n        \"\"\"Remove a specific effect by identity.\n\n        Returns:\n            ``True`` if the effect was found and removed, ``False`` otherwise.\n        \"\"\"\n        for i, e in enumerate(self._effects):\n            if e is effect:\n                self._effects.pop(i)\n                return True\n        return False\n\n    def remove_expired(self, game: GameState) -> int:\n        \"\"\"Remove effects whose duration has expired.\n\n        - ``DURATION_PERMANENT`` (−1): never expires automatically.\n        - ``DURATION_END_OF_TURN`` (0): removed when this method is called\n          (typically during the cleanup step).\n        - Positive integer *n*: removed when ``game.turn_number > n``.\n\n        Args:\n            game: The current game state (used for turn number).\n\n        Returns:\n            The number of effects removed.\n        \"\"\"\n        before = len(self._effects)\n        remaining: list[ContinuousEffect] = []\n        for eff in self._effects:\n            if eff.duration == DURATION_PERMANENT:\n                remaining.append(eff)\n            elif eff.duration == DURATION_END_OF_TURN:\n                # End-of-turn effects are swept away.\n                continue\n            elif game.turn_number > eff.duration:\n                # Turn-numbered expiry.\n                continue\n            else:\n                remaining.append(eff)\n        self._effects = remaining\n        return before - len(self._effects)\n\n    def apply_all(self, game: GameState) -> None:\n        \"\"\"Apply all active effects in layer order, then timestamp order.\n\n        Before applying, all objects on each player's battlefield are reset\n        to their original (pre-effect) characteristics so that calling this\n        method multiple times is idempotent.\n\n        Within each layer (and sublayer for layer 7), effects are applied\n        in timestamp order.  This method should be called whenever the\n        game state needs a fresh recalculation of continuous effects —\n        for example, after state-based actions or any game event that\n        could change the set of applicable effects.\n        \"\"\"\n        # Reset battlefield objects to their base characteristics so that\n        # reapplying effects does not accumulate on top of stale mutations.\n        self._reset_objects(game)\n\n        sorted_effects = sorted(self._effects, key=lambda e: e._sort_key())\n        for effect in sorted_effects:\n            effect.apply(game)\n\n    # ------------------------------------------------------------------\n    # Internal helpers\n    # ------------------------------------------------------------------\n\n    def _reset_objects(self, game: GameState) -> None:\n        \"\"\"Reset all battlefield objects to their original characteristics.","numLines":90,"startLine":121,"totalLines":252}}}
