{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01A5ukcHCUuyL9kNbjxZCo7M","type":"tool_result","content":"89\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n90\t    \"\"\"Return the generic mana reduction for casting *card*.\n91\t\n92\t    Queries ``card.cost_reduction(game)`` and clamps the result so that\n93\t    the generic portion of the mana cost cannot go below 0.\n94\t\n95\t    This is a simplified single-card self-reduction model.  Full MTG\n96\t    cost-reduction interactions (Trinisphere, multiple reductions from\n97\t    different sources) are deferred.\n98\t    \"\"\"\n99\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n100\t    # casting player even when the card was never explicitly assigned one.\n101\t    prev_controller = card.controller\n102\t    card.controller = controller\n103\t    raw = card.cost_reduction(game)\n104\t    # Restore previous controller in case the caller doesn't want a\n105\t    # side-effect (get_cost_reduction is a query, not a mutation).\n106\t    card.controller = prev_controller\n107\t\n108\t    # Permanents the controller has on the battlefield may reduce the cost\n109\t    # of other spells they cast (e.g. granting affinity to your I/S).\n110\t    for perm in controller.zones[Zone.BATTLEFIELD].get_all():\n111\t        hook = getattr(perm, \"static_cost_reduction\", None)\n112\t        if hook is None:\n113\t            continue\n114\t        try:\n115\t            raw += hook(game, card, controller)\n116\t        except TypeError:\n117\t            # A non-CardImpl object happens to expose a differently-shaped\n118\t            # attribute named static_cost_reduction — ignore it.\n119\t            continue\n120\t\n121\t    generic = card.mana_cost.generic if card.mana_cost else 0\n122\t    return max(0, min(raw, generic))\n123\t\n124\t\n125\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n126\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n127\t    new_generic = max(0, cost.generic - reduction)\n128\t    return ManaCost("}]},"parent_tool_use_id":null,"session_id":"6b0c2803-fb7f-4347-8991-d01b6c022fd2","uuid":"9208edf5-bec4-4526-a222-99674960a599","timestamp":"2026-06-04T11:18:28.168Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"def get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n    \"\"\"Return the generic mana reduction for casting *card*.\n\n    Queries ``card.cost_reduction(game)`` and clamps the result so that\n    the generic portion of the mana cost cannot go below 0.\n\n    This is a simplified single-card self-reduction model.  Full MTG\n    cost-reduction interactions (Trinisphere, multiple reductions from\n    different sources) are deferred.\n    \"\"\"\n    # Ensure card.controller is set so the hook can reference \"you\" / the\n    # casting player even when the card was never explicitly assigned one.\n    prev_controller = card.controller\n    card.controller = controller\n    raw = card.cost_reduction(game)\n    # Restore previous controller in case the caller doesn't want a\n    # side-effect (get_cost_reduction is a query, not a mutation).\n    card.controller = prev_controller\n\n    # Permanents the controller has on the battlefield may reduce the cost\n    # of other spells they cast (e.g. granting affinity to your I/S).\n    for perm in controller.zones[Zone.BATTLEFIELD].get_all():\n        hook = getattr(perm, \"static_cost_reduction\", None)\n        if hook is None:\n            continue\n        try:\n            raw += hook(game, card, controller)\n        except TypeError:\n            # A non-CardImpl object happens to expose a differently-shaped\n            # attribute named static_cost_reduction — ignore it.\n            continue\n\n    generic = card.mana_cost.generic if card.mana_cost else 0\n    return max(0, min(raw, generic))\n\n\ndef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n    new_generic = max(0, cost.generic - reduction)\n    return ManaCost(","numLines":40,"startLine":89,"totalLines":540}}}
