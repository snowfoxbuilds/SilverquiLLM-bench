     zone=Zone.BATTLEFIELD,\n            ),\n        ]\n\n    def on_resolve(self, game: \"GameState\") -> None:\n        \"\"\"Converge: X = colors of mana spent. Draw/damage/gain X.\"\"\"\n        from engine.game import deal_damage, draw_card\n\n        controller = self.controller\n        if controller is None:\n            return\n\n        x = len(getattr(self, \"colors_spent\", []))\n\n        chosen = getattr(self, \"chosen_targets\", None) or []\n        target_player = chosen[0] if len(chosen) >= 1 else None\n        any_target = chosen[1] if len(chosen) >= 2 else None\n\n        if x <= 0:\n            return\n\n        if target_player is not None:\n            for _ in range(x):\n                draw_card(game, target_player)\n\n        if any_target is not None:\n            deal_damage(game, self, any_target, x)\n\n        controller.life += x\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":494,"cache_read_input_tokens":125517,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":494},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6b0c2803-fb7f-4347-8991-d01b6c022fd2","uuid":"24de759a-c332-47bc-99b9-a63473e6e305","request_id":"req_011Cbi7W7eWHPogGyXBUiBtQ"}
