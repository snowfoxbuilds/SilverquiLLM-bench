elf, game: GameState) -> None:\n44\t        from engine.triggers import TriggerRegistration\n45\t        source = self\n46\t\n47\t        def _effect(game: GameState) -> None:\n48\t            target = _get_chosen_target(source, game)\n49\t            if target is None:\n50\t                return\n51\t            for player in game.players:\n52\t                gy = player.zones[Zone.GRAVEYARD]\n53\t                if gy.contains(target):\n54\t                    gy.remove(target)\n55\t                    owner = getattr(target, 'owner', player)\n56\t                    owner.zones[Zone.EXILE].add(target)\n57\t                    return\n58\t        controller = getattr(self, 'controller', None) or game.active_player\n59\t        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=_self_etb_condition(self), effect=_effect, source=self, controller=controller))\n60\t"}]},"parent_tool_use_id":null,"session_id":"6b0c2803-fb7f-4347-8991-d01b6c022fd2","uuid":"fd03ea9b-5e7d-4ac6-ac1e-55a14a8e3ded","timestamp":"2026-06-04T11:28:32.320Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_98/card_impl.py","content":"\"\"\"Card implementation for Ambush Wolf.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import ArtifactCreature, Creature\nfrom engine.continuous_effects import ContinuousEffect, DURATION_END_OF_TURN, Layer, SubLayer\nfrom engine.types import CardType, Keyword, ManaCost, Zone\nfrom engine.events import EntersBattlefieldTriggeredEvent\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from cards.registry import CardRegistry\n\ndef _self_etb_condition(source: Any):\n    \"\"\"Return a condition callable that matches only when *source* enters.\"\"\"\n\n    def _condition(game: Any, event: dict) -> bool:\n        return event.permanent is source\n    return _condition\n\ndef _get_chosen_target(card: Any, game: Any) -> Any:\n    chosen = getattr(card, 'chosen_targets', None)\n    if chosen:\n        return chosen[0]\n    return getattr(card, '_resolve_target', None)\n\nclass AmbushWolf(Creature):\n    \"\"\"Ambush Wolf — {2}{G} — 4/2 — Wolf — Flash\n\n    When this creature enters, exile up to one target card from a graveyard.\n\n    FDN collector number 98.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Ambush Wolf')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{2}{G}'))\n        kwargs.setdefault('subtypes', {'Wolf'})\n        kwargs.setdefault('keywords', Keyword.FLASH)\n        kwargs.setdefault('base_power', 4)\n        kwargs.setdefault('base_toughness', 2)\n        kwargs.setdefault('rules_text', 'Flash\\nWhen this creature enters, exile up to one target card from a graveyard.')\n        super().__init__(**kwargs)\n\n    def register_triggers(self, game: GameState) -> None:\n        from engine.triggers import TriggerRegistration\n        source = self\n\n        def _effect(game: GameState) -> None:\n            target = _get_chosen_target(source, game)\n            if target is None:\n                return\n            for player in game.players:\n                gy = player.zones[Zone.GRAVEYARD]\n                if gy.contains(target):\n                    gy.remove(target)\n                    owner = getattr(target, 'owner', player)\n                    owner.zones[Zone.EXILE].add(target)\n                    return\n        controller = getattr(self, 'controller', None) or game.active_player\n        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=_self_etb_condition(self), effect=_effect, source=self, controller=controller))\n","numLines":60,"startLine":1,"totalLines":60}}}
