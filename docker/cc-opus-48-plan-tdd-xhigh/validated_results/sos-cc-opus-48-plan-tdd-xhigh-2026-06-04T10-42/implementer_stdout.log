{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JHT6QNeokqRD8v8AErj8jh","type":"tool_result","content":"1\t\"\"\"Game setup, helper actions, and the full game loop.\n2\t\n3\tProvides the top-level functions for creating, running, and interacting with\n4\ta game of Magic: The Gathering:\n5\t\n6\t- :func:`create_game` — initialise a full game state for two players.\n7\t- Helper actions — module-level functions for common game operations\n8\t  (``deal_damage``, ``destroy``, ``sacrifice``, ``exile``, ``draw_card``,\n9\t  ``discard``, ``create_token``, ``add_counter``, ``remove_counter``,\n10\t  ``tap``, ``untap``).\n11\t- :func:`run_game` — execute turns until the game ends, returning the winner.\n12\t\"\"\"\n13\t\n14\tfrom __future__ import annotations\n15\t\n16\tfrom typing import TYPE_CHECKING, Any\n17\t\n18\tfrom engine.events import (\n19\t    CreatureDiesReplacementEvent,\n20\t    DealsDamageTriggeredEvent,\n21\t    DrawsCardTriggeredEvent,\n22\t    EntersBattlefieldTriggeredEvent,\n23\t    GainsLifeTriggeredEvent,\n24\t    LosesLifeTriggeredEvent,\n25\t    PermanentDestroyedReplacementEvent,\n26\t    SacrificeReplacementEvent,\n27\t)\n28\tfrom engine.game_state import GameState\n29\tfrom engine.turn import run_turn\n30\tfrom engine.types import Zone\n31\tfrom engine.zones import move_to_zone\n32\t\n33\tif TYPE_CHECKING:\n34\t    from engine.card import CardImpl, Creature\n35\t    from engine.player import Player\n36\t\n37\t\n38\t# Maximum number of turns before the game is considered a draw.\n39\t# Prevents infinite loops in deterministic or stuck game states.\n40\tMAX_TURNS: int = 1000\n41\t\n42\t\n43\t# ---------------------------------------------------------------------------\n44\t# Game creation\n45\t# ---------------------------------------------------------------------------\n46\t\n47\tdef create_game(\n48\t    player1: Player,\n49\t    player2: Player,\n50\t    deck1: list[CardImpl],\n51\t    deck2: list[CardImpl],\n52\t) -> GameState:\n53\t    \"\"\"Create and initialise a new two-player game.\n54\t\n55\t    Steps performed:\n56\t\n57\t    1. Set each player's life total to 20.\n58\t    2. Place *deck1* / *deck2* into the respective player's library zone.\n59\t    3. Shuffle each library.\n60\t    4. Draw 7 cards for each player.\n61\t    5. Set the active player to *player1*.\n62\t\n63\t    Card ownership is set so that each card's ``owner`` and ``controller``\n64\t    point to the player whose deck it came from.\n65\t\n66\t    Parameters:\n67\t        player1: The first player (goes first).\n68\t        player2: The second player.\n69\t        deck1: Cards comprising player1's deck.\n70\t        deck2: Cards comprising player2's deck.\n71\t\n72\t    Returns:\n73\t        A fully initialised :class:`GameState` ready for play.\n74\t    \"\"\"\n75\t    # 1. Set life totals\n76\t    player1.life = 20\n77\t    player2.life = 20\n78\t\n79\t    # 2. Place deck cards into libraries and set ownership\n80\t    library1 = player1.zones[Zone.LIBRARY]\n81\t    for card in deck1:\n82\t        card.owner = player1\n83\t        card.controller = player1\n84\t        library1.add(card)\n85\t\n86\t    library2 = player2.zones[Zone.LIBRARY]\n87\t    for card in deck2:\n88\t        card.owner = player2\n89\t        card.controller = player2\n90\t        library2.add(card)\n91\t\n92\t    # 3. Shuffle libraries\n93\t    library1.shuffle()\n94\t    library2.shuffle()\n95\t\n96\t    # Build the game state\n97\t    game = GameState([player1, player2])\n98\t\n99\t    # 4. Draw 7 cards each\n100\t    for _ in range(7):\n101\t        draw_card(game, player1)\n102\t    for _ in range(7):\n103\t        draw_card(game, player2)\n104\t\n105\t    # 5. Active player is player1 (index 0 — already the default)\n106\t    game.active_player_index = 0\n107\t    game.priority_player_index = 0\n108\t\n109\t    return game\n110\t\n111\t\n112\t# ---------------------------------------------------------------------------\n113\t# Common helper actions\n114\t# ---------------------------------------------------------------------------\n115\t\n116\tdef deal_damage(game: GameState, source: Any, target: Any, amount: int) -> None:\n117\t    \"\"\"Deal *amount* damage from *source* to *target*.\n118\t\n119\t    If *target* has a ``life`` attribute (i.e. is a player), life is reduced.\n120\t    If *target* has a ``damage_marked`` attribute (i.e. is a creature),\n121\t    damage is marked on it.\n122\t\n123\t    Fires :attr:`EventType.DEALS_DAMAGE` via the trigger manager.\n124\t\n125\t    Parameters:\n126\t        game: The current game state.\n127\t        source: The object dealing the damage.\n128\t        target: The player or creature receiving the damage.\n129\t        amount: The amount of damage to deal (must be > 0 to have effect).\n130\t    \"\"\"\n131\t    if amount <= 0:\n132\t        return\n133\t\n134\t    from engine.protection import has_protection_from\n135\t    from engine.types import Keyword\n136\t\n137\t    # Protection prevents damage from sources with the protected-from quality.\n138\t    if has_protection_from(target, source):\n139\t        return\n140\t\n141\t    if hasattr(target, \"life\"):\n142\t        # Target is a player\n143\t        target.life -= amount\n144\t        # Fire damage trigger\n145\t        game.trigger_manager.fire_event(\n146\t            game,\n147\t            DealsDamageTriggeredEvent(source=source, target=target, amount=amount),\n148\t        )\n149\t        # Fire loses-life trigger\n150\t        game.trigger_manager.fire_event(\n151\t            game,\n152\t            LosesLifeTriggeredEvent(player=target, amount=amount),\n153\t        )\n154\t    elif hasattr(target, \"damage_marked\"):\n155\t        # Target is a creature\n156\t        target.damage_marked += amount\n157\t\n158\t        # Track deathtouch damage for SBA rule 704.5h\n159\t        source_kw = getattr(source, \"keywords\", Keyword(0))\n160\t        if Keyword.DEATHTOUCH in source_kw:\n161\t            target.dealt_deathtouch_damage = True\n162\t\n163\t        # Fire damage trigger\n164\t        game.trigger_manager.fire_event(\n165\t            game,\n166\t            DealsDamageTriggeredEvent(source=source, target=target, amount=amount),\n167\t        )\n168\t\n169\t    # Lifelink: controller of source gains life equal to damage dealt\n170\t    source_kw = getattr(source, \"keywords\", Keyword(0))\n171\t    if Keyword.LIFELINK in source_kw:\n172\t        controller = getattr(source, \"controller\", None)\n173\t        if controller is not None and hasattr(controller, \"life\"):\n174\t            controller.life += amount\n175\t\n176\t\n177\tdef destroy(game: GameState, permanent: Any) -> None:\n178\t    \"\"\"Destroy *permanent* — move it from the battlefield to its owner's graveyard.\n179\t\n180\t    Respects replacement effects via :func:`move_to_zone`.\n181\t    Creatures with the ``INDESTRUCTIBLE`` keyword are not destroyed.\n182\t\n183\t    Parameters:\n184\t        game: The current game state.\n185\t        permanent: The permanent to destroy.\n186\t    \"\"\"\n187\t    from engine.types import Keyword\n188\t\n189\t    # Indestructible permanents cannot be destroyed\n190\t    kw = getattr(permanent, \"keywords\", Keyword(0))\n191\t    if Keyword.INDESTRUCTIBLE in kw:\n192\t        return\n193\t\n194\t    controller = getattr(permanent, \"controller\", None)\n195\t    if controller is None:\n196\t        # Fallback: find which player's battlefield contains it\n197\t        for player in game.players:\n198\t            bf = game.get_battlefield(player)\n199\t            if bf.contains(permanent):\n200\t                controller = player\n201\t                break\n202\t    if controller is None:\n203\t        return\n204\t\n205\t    bf = game.get_battlefield(controller)\n206\t    if not bf.contains(permanent):\n207\t        return\n208\t\n209\t    from engine.types import CardType\n210\t\n211\t    card_types = getattr(permanent, \"card_types\", set())\n212\t    is_creature = CardType.CREATURE in card_types\n213\t    owner = getattr(permanent, \"owner\", controller)\n214\t\n215\t    if is_creature:\n216\t        repl_event: CreatureDiesReplacementEvent | PermanentDestroyedReplacementEvent = (\n217\t            CreatureDiesReplacementEvent(\n218\t                creature=permanent, destination=\"graveyard\",\n219\t                controller=controller, owner=owner,\n220\t            )\n221\t        )\n222\t    else:\n223\t        repl_event = PermanentDestroyedReplacementEvent(\n224\t            permanent=permanent, destination=\"graveyard\",\n225\t            controller=controller, owner=owner,\n226\t        )\n227\t\n228\t    move_to_zone(\n229\t        game,\n230\t        permanent,\n231\t        Zone.BATTLEFIELD,\n232\t        Zone.GRAVEYARD,\n233\t        replacement_event=repl_event,\n234\t    )\n235\t\n236\t\n237\tdef sacrifice(game: GameState, player: Player, permanent: Any) -> None:\n238\t    \"\"\"Sacrifice *permanent* — move it from the battlefield to its owner's graveyard.\n239\t\n240\t    Sacrificing cannot be prevented by indestructible or regeneration, but\n241\t    replacement effects that modify zone changes (e.g. \"if this would be\n242\t    put into a graveyard, exile it instead\") still apply via\n243\t    :func:`move_to_zone`.\n244\t\n245\t    Parameters:\n246\t        game: The current game state.\n247\t        player: The player performing the sacrifice.\n248\t        permanent: The permanent to sacrifice.\n249\t    \"\"\"\n250\t    bf = game.get_battlefield(player)\n251\t    if not bf.contains(permanent):\n252\t        return\n253\t\n254\t    owner = getattr(permanent, \"owner\", player)\n255\t    move_to_zone(\n256\t        game,\n257\t        permanent,\n258\t        Zone.BATTLEFIELD,\n259\t        Zone.GRAVEYARD,\n260\t        replacement_event=SacrificeReplacementEvent(\n261\t            permanent=permanent, destination=\"graveyard\",\n262\t            controller=player, owner=owner,\n263\t        ),\n264\t    )\n265\t\n266\t\n267\tdef exile(game: GameState, obj: Any) -> None:\n268\t    \"\"\"Exile *obj* — move it to its owner's exile zone.\n269\t\n270\t    Works for objects on the battlefield, in the graveyard, on the stack,\n271\t    or in hand.\n272\t\n273\t    Parameters:\n274\t        game: The current game state.\n275\t        obj: The game object to exile.\n276\t    \"\"\"\n277\t    # Find which zone the object is currently in\n278\t    source_zone_type = None\n279\t    for player in game.players:\n280\t        for zone_type in Zone:\n281\t            zone = player.zones[zone_type]\n282\t            if zone.contains(obj):\n283\t                source_zone_type = zone_type\n284\t                break\n285\t        if source_zone_type is not None:\n286\t            break\n287\t\n288\t    if source_zone_type is None:\n289\t        return\n290\t\n291\t    move_to_zone(game, obj, source_zone_type, Zone.EXILE)\n292\t\n293\t\n294\tdef draw_card(game: GameState, player: Player) -> Any | None:\n295\t    \"\"\"Draw a card for *player* — move the top card of library to hand.\n296\t\n297\t    If the library is empty, sets ``player.drawn_from_empty_library = True``\n298\t    (SBAs will handle the game loss).\n299\t\n300\t    Fires :attr:`EventType.DRAWS_CARD` via the trigger manager.\n301\t\n302\t    Parameters:\n303\t        game: The current game state.\n304\t        player: The player drawing a card.\n305\t\n306\t    Returns:\n307\t        The drawn card, or ``None`` if the library was empty.\n308\t    \"\"\"\n309\t    library = player.zones[Zone.LIBRARY]\n310\t\n311\t    if len(library) == 0:\n312\t        player.drawn_from_empty_library = True\n313\t        return None\n314\t\n315\t    # Top of library is the last element (index -1)\n316\t    cards = library.top(1)\n317\t    card = cards[0]\n318\t    library.remove(card)\n319\t\n320\t    hand = player.zones[Zone.HAND]\n321\t    hand.add(card)\n322\t\n323\t    # Track cards drawn this turn\n324\t    if not hasattr(player, \"cards_drawn_this_turn\"):\n325\t        player.cards_drawn_this_turn = 0\n326\t    player.cards_drawn_this_turn += 1\n327\t\n328\t    # Fire trigger (only if game has a trigger_manager — may not during setup)\n329\t    if hasattr(game, \"trigger_manager\"):\n330\t        game.trigger_manager.fire_event(\n331\t            game,\n332\t            DrawsCardTriggeredEvent(player=player, card=card),\n333\t        )\n334\t\n335\t    return card\n336\t\n337\t\n338\tdef discard(game: GameState, player: Player, card: Any) -> None:\n339\t    \"\"\"Discard *card* from *player*'s hand to the owner's graveyard.\n340\t\n341\t    Parameters:\n342\t        game: The current game state.\n343\t        player: The player discarding.\n344\t        card: The card to discard (must be in the player's hand).\n345\t    \"\"\"\n346\t    hand = game.get_hand(player)\n347\t    if not hand.contains(card):\n348\t        return\n349\t\n350\t    move_to_zone(game, card, Zone.HAND, Zone.GRAVEYARD)\n351\t\n352\t\n353\tdef create_token(game: GameState, player: Player, token: Any) -> None:\n354\t    \"\"\"Create a token on the battlefield under *player*'s control.\n355\t\n356\t    Sets ``is_token = True`` on the token, along with ``owner`` and\n357\t    ``controller``.  Uses :func:`move_to_zone` for entering-battlefield\n358\t    hooks (trigger/replacement-effect registration and ETB event).\n359\t\n360\t    Parameters:\n361\t        game: The current game state.\n362\t        player: The player who controls the token.\n363\t        token: The token object to place on the battlefield.\n364\t    \"\"\"\n365\t    token.is_token = True\n366\t    token.owner = player\n367\t    token.controller = player\n368\t\n369\t    # Tokens don't come from an existing zone — add directly and fire hooks.\n370\t    # Ordering matches move_to_zone: fire ETB *before* registering the token's\n371\t    # own triggers so a token's ETB trigger doesn't self-fire on entry.\n372\t    battlefield = game.get_battlefield(player)\n373\t    battlefield.add(token)\n374\t\n375\t    game.trigger_manager.fire_event(\n376\t        game,\n377\t        EntersBattlefieldTriggeredEvent(permanent=token, controller=player),\n378\t    )\n379\t\n380\t    # Register triggers/replacement effects after the ETB event.\n381\t    if hasattr(token, \"register_triggers\"):\n382\t        token.register_triggers(game)\n383\t    if hasattr(token, \"register_replacement_effects\"):\n384\t        token.register_replacement_effects(game)\n385\t\n386\t\n387\tdef add_counter(\n388\t    game: GameState,\n389\t    permanent: Any,\n390\t    counter_type: str,\n391\t    amount: int = 1,\n392\t) -> None:\n393\t    \"\"\"Add *amount* counters of *counter_type* to *permanent*.\n394\t\n395\t    Supports ``\"+1/+1\"`` and ``\"-1/-1\"`` counter types via the\n396\t    ``plus_one_counters`` / ``minus_one_counters`` attributes.  For other\n397\t    counter types, uses a generic ``counters`` dict.\n398\t\n399\t    Parameters:\n400\t        game: The current game state.\n401\t        permanent: The permanent to add counters to.\n402\t        counter_type: The type of counter (e.g. ``\"+1/+1\"``, ``\"-1/-1\"``,\n403\t            ``\"loyalty\"``, ``\"charge\"``).\n404\t        amount: Number of counters to add (default 1).\n405\t    \"\"\"\n406\t    if amount <= 0:\n407\t        return\n408\t\n409\t    if counter_type == \"+1/+1\" and hasattr(permanent, \"plus_one_counters\"):\n410\t        permanent.plus_one_counters += amount\n411\t    elif counter_type == \"-1/-1\" and hasattr(permanent, \"minus_one_counters\"):\n412\t        permanent.minus_one_counters += amount\n413\t    elif counter_type == \"loyalty\" and hasattr(permanent, \"loyalty\"):\n414\t        permanent.loyalty += amount\n415\t    else:\n416\t        # Generic counter storage\n417\t        if not hasattr(permanent, \"counters\"):\n418\t            permanent.counters = {}\n419\t        permanent.counters[counter_type] = permanent.counters.get(counter_type, 0) + amount\n420\t\n421\t\n422\tdef remove_counter(\n423\t    game: GameState,\n424\t    permanent: Any,\n425\t    counter_type: str,\n426\t    amount: int = 1,\n427\t) -> None:\n428\t    \"\"\"Remove *amount* counters of *counter_type* from *permanent*.\n429\t\n430\t    Will not reduce below zero.\n431\t\n432\t    Parameters:\n433\t        game: The current game state.\n434\t        permanent: The permanent to remove counters from.\n435\t        counter_type: The type of counter to remove.\n436\t        amount: Number of counters to remove (default 1).\n437\t    \"\"\"\n438\t    if amount <= 0:\n439\t        return\n440\t\n441\t    if counter_type == \"+1/+1\" and hasattr(permanent, \"plus_one_counters\"):\n442\t        permanent.plus_one_counters = max(0, permanent.plus_one_counters - amount)\n443\t    elif counter_type == \"-1/-1\" and hasattr(permanent, \"minus_one_counters\"):\n444\t        permanent.minus_one_counters = max(0, permanent.minus_one_counters - amount)\n445\t    elif counter_type == \"loyalty\" and hasattr(permanent, \"loyalty\"):\n446\t        permanent.loyalty = max(0, permanent.loyalty - amount)\n447\t    else:\n448\t        if hasattr(permanent, \"counters\") and counter_type in permanent.counters:\n449\t            permanent.counters[counter_type] = max(\n450\t                0, permanent.counters[counter_type] - amount\n451\t            )\n452\t\n453\t\n454\tdef tap(game: GameState, permanent: Any) -> None:\n455\t    \"\"\"Tap *permanent* — set ``is_tapped = True``.\n456\t\n457\t    Parameters:\n458\t        game: The current game state.\n459\t        permanent: The permanent to tap.\n460\t    \"\"\"\n461\t    if hasattr(permanent, \"is_tapped\"):\n462\t        permanent.is_tapped = True\n463\t\n464\t\n465\tdef untap(game: GameState, permanent: Any) -> None:\n466\t    \"\"\"Untap *permanent* — set ``is_tapped = False``.\n467\t\n468\t    Parameters:\n469\t        game: The current game state.\n470\t        permanent: The permanent to untap.\n471\t    \"\"\"\n472\t    if hasattr(permanent, \"is_tapped\"):\n473\t        permanent.is_tapped = False\n474\t\n475\t\n476\t# ---------------------------------------------------------------------------\n477\t# Game loop\n478\t# ---------------------------------------------------------------------------\n479\t\n480\tdef run_game(game: GameState) -> Player | None:\n481\t    \"\"\"Run the game loop until the game ends.\n482\t\n483\t    Executes :func:`~engine.turn.run_turn` in a loop, checking\n484\t    :attr:`GameState.is_game_over` after each turn.  State-based actions\n485\t    are resolved before and after each turn to catch game-ending conditions\n486\t    even when the priority loop auto-passes.\n487\t\n488\t    Includes a safety limit of :data:`MAX_TURNS` to prevent infinite loops\n489\t    in deterministic or stuck game states.\n490\t\n491\t    Parameters:\n492\t        game: The game state to run.\n493\t\n494\t    Returns:\n495\t        The winning player, or ``None`` if the game ended in a draw (or\n496\t        hit the turn limit).\n497\t    \"\"\"\n498\t    from engine.state_based_actions import resolve_state_based_actions\n499\t\n500\t    while not game.is_game_over and game.turn_number <= MAX_TURNS:\n501\t        # Check SBAs before the turn (catches pre-existing conditions)\n502\t        resolve_state_based_actions(game)\n503\t        _check_game_over(game)\n504\t        if game.is_game_over:\n505\t            break\n506\t\n507\t        run_turn(game)\n508\t\n509\t        # Check SBAs after the turn\n510\t        resolve_state_based_actions(game)\n511\t        _check_game_over(game)\n512\t\n513\t    return game.winner\n514\t\n515\t\n516\tdef _check_game_over(game: GameState) -> None:\n517\t    \"\"\"Check whether the game has ended and update ``game.is_game_over`` / ``game.winner``.\n518\t\n519\t    The game ends when:\n520\t    - One player has lost (``has_lost``): the other player wins.\n521\t    - Both players have lost: the game is a draw (``winner = None``).\n522\t    - The turn limit is exceeded: the game is a draw.\n523\t    \"\"\"\n524\t    lost_players = [p for p in game.players if p.has_lost]\n525\t\n526\t    if len(lost_players) == len(game.players):\n527\t        # All players have lost — draw\n528\t        game.is_game_over = True\n529\t        game.winner = None\n530\t    elif len(lost_players) == 1:\n531\t        # One player lost — the other wins\n532\t        game.is_game_over = True\n533\t        game.winner = [p for p in game.players if not p.has_lost][0]\n534\t    elif game.turn_number > MAX_TURNS:\n535\t        # Turn limit exceeded — draw\n536\t        game.is_game_over = True\n537\t        game.winner = None\n538\t"}]},"parent_tool_use_id":null,"session_id":"6b0c2803-fb7f-4347-8991-d01b6c022fd2","uuid":"1bfe4986-d08f-4c14-aa51-fd93ab00af94","timestamp":"2026-06-04T11:03:57.014Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/game.py","content":"\"\"\"Game setup, helper actions, and the full game loop.\n\nProvides the top-level functions for creating, running, and interacting with\na game of Magic: The Gathering:\n\n- :func:`create_game` — initialise a full game state for two players.\n- Helper actions — module-level functions for common game operations\n  (``deal_damage``, ``destroy``, ``sacrifice``, ``exile``, ``draw_card``,\n  ``discard``, ``create_token``, ``add_counter``, ``remove_counter``,\n  ``tap``, ``untap``).\n- :func:`run_game` — execute turns until the game ends, returning the winner.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.events import (\n    CreatureDiesReplacementEvent,\n    DealsDamageTriggeredEvent,\n    DrawsCardTriggeredEvent,\n    EntersBattlefieldTriggeredEvent,\n    GainsLifeTriggeredEvent,\n    LosesLifeTriggeredEvent,\n    PermanentDestroyedReplacementEvent,\n    SacrificeReplacementEvent,\n)\nfrom engine.game_state import GameState\nfrom engine.turn import run_turn\nfrom engine.types import Zone\nfrom engine.zones import move_to_zone\n\nif TYPE_CHECKING:\n    from engine.card import CardImpl, Creature\n    from engine.player import Player\n\n\n# Maximum number of turns before the game is considered a draw.\n# Prevents infinite loops in deterministic or stuck game states.\nMAX_TURNS: int = 1000\n\n\n# ---------------------------------------------------------------------------\n# Game creation\n# ---------------------------------------------------------------------------\n\ndef create_game(\n    player1: Player,\n    player2: Player,\n    deck1: list[CardImpl],\n    deck2: list[CardImpl],\n) -> GameState:\n    \"\"\"Create and initialise a new two-player game.\n\n    Steps performed:\n\n    1. Set each player's life total to 20.\n    2. Place *deck1* / *deck2* into the respective player's library zone.\n    3. Shuffle each library.\n    4. Draw 7 cards for each player.\n    5. Set the active player to *player1*.\n\n    Card ownership is set so that each card's ``owner`` and ``controller``\n    point to the player whose deck it came from.\n\n    Parameters:\n        player1: The first player (goes first).\n        player2: The second player.\n        deck1: Cards comprising player1's deck.\n        deck2: Cards comprising player2's deck.\n\n    Returns:\n        A fully initialised :class:`GameState` ready for play.\n    \"\"\"\n    # 1. Set life totals\n    player1.life = 20\n    player2.life = 20\n\n    # 2. Place deck cards into libraries and set ownership\n    library1 = player1.zones[Zone.LIBRARY]\n    for card in deck1:\n        card.owner = player1\n        card.controller = player1\n        library1.add(card)\n\n    library2 = player2.zones[Zone.LIBRARY]\n    for card in deck2:\n        card.owner = player2\n        card.controller = player2\n        library2.add(card)\n\n    # 3. Shuffle libraries\n    library1.shuffle()\n    library2.shuffle()\n\n    # Build the game state\n    game = GameState([player1, player2])\n\n    # 4. Draw 7 cards each\n    for _ in range(7):\n        draw_card(game, player1)\n    for _ in range(7):\n        draw_card(game, player2)\n\n    # 5. Active player is player1 (index 0 — already the default)\n    game.active_player_index = 0\n    game.priority_player_index = 0\n\n    return game\n\n\n# ---------------------------------------------------------------------------\n# Common helper actions\n# ---------------------------------------------------------------------------\n\ndef deal_damage(game: GameState, source: Any, target: Any, amount: int) -> None:\n    \"\"\"Deal *amount* damage from *source* to *target*.\n\n    If *target* has a ``life`` attribute (i.e. is a player), life is reduced.\n    If *target* has a ``damage_marked`` attribute (i.e. is a creature),\n    damage is marked on it.\n\n    Fires :attr:`EventType.DEALS_DAMAGE` via the trigger manager.\n\n    Parameters:\n        game: The current game state.\n        source: The object dealing the damage.\n        target: The player or creature receiving the damage.\n        amount: The amount of damage to deal (must be > 0 to have effect).\n    \"\"\"\n    if amount <= 0:\n        return\n\n    from engine.protection import has_protection_from\n    from engine.types import Keyword\n\n    # Protection prevents damage from sources with the protected-from quality.\n    if has_protection_from(target, source):\n        return\n\n    if hasattr(target, \"life\"):\n        # Target is a player\n        target.life -= amount\n        # Fire damage trigger\n        game.trigger_manager.fire_event(\n            game,\n            DealsDamageTriggeredEvent(source=source, target=target, amount=amount),\n        )\n        # Fire loses-life trigger\n        game.trigger_manager.fire_event(\n            game,\n            LosesLifeTriggeredEvent(player=target, amount=amount),\n        )\n    elif hasattr(target, \"damage_marked\"):\n        # Target is a creature\n        target.damage_marked += amount\n\n        # Track deathtouch damage for SBA rule 704.5h\n        source_kw = getattr(source, \"keywords\", Keyword(0))\n        if Keyword.DEATHTOUCH in source_kw:\n            target.dealt_deathtouch_damage = True\n\n        # Fire damage trigger\n        game.trigger_manager.fire_event(\n            game,\n            DealsDamageTriggeredEvent(source=source, target=target, amount=amount),\n        )\n\n    # Lifelink: controller of source gains life equal to damage dealt\n    source_kw = getattr(source, \"keywords\", Keyword(0))\n    if Keyword.LIFELINK in source_kw:\n        controller = getattr(source, \"controller\", None)\n        if controller is not None and hasattr(controller, \"life\"):\n            controller.life += amount\n\n\ndef destroy(game: GameState, permanent: Any) -> None:\n    \"\"\"Destroy *permanent* — move it from the battlefield to its owner's graveyard.\n\n    Respects replacement effects via :func:`move_to_zone`.\n    Creatures with the ``INDESTRUCTIBLE`` keyword are not destroyed.\n\n    Parameters:\n        game: The current game state.\n        permanent: The permanent to destroy.\n    \"\"\"\n    from engine.types import Keyword\n\n    # Indestructible permanents cannot be destroyed\n    kw = getattr(permanent, \"keywords\", Keyword(0))\n    if Keyword.INDESTRUCTIBLE in kw:\n        return\n\n    controller = getattr(permanent, \"controller\", None)\n    if controller is None:\n        # Fallback: find which player's battlefield contains it\n        for player in game.players:\n            bf = game.get_battlefield(player)\n            if bf.contains(permanent):\n                controller = player\n                break\n    if controller is None:\n        return\n\n    bf = game.get_battlefield(controller)\n    if not bf.contains(permanent):\n        return\n\n    from engine.types import CardType\n\n    card_types = getattr(permanent, \"card_types\", set())\n    is_creature = CardType.CREATURE in card_types\n    owner = getattr(permanent, \"owner\", controller)\n\n    if is_creature:\n        repl_event: CreatureDiesReplacementEvent | PermanentDestroyedReplacementEvent = (\n            CreatureDiesReplacementEvent(\n                creature=permanent, destination=\"graveyard\",\n                controller=controller, owner=owner,\n            )\n        )\n    else:\n        repl_event = PermanentDestroyedReplacementEvent(\n            permanent=permanent, destination=\"graveyard\",\n            controller=controller, owner=owner,\n        )\n\n    move_to_zone(\n        game,\n        permanent,\n        Zone.BATTLEFIELD,\n        Zone.GRAVEYARD,\n        replacement_event=repl_event,\n    )\n\n\ndef sacrifice(game: GameState, player: Player, permanent: Any) -> None:\n    \"\"\"Sacrifice *permanent* — move it from the battlefield to its owner's graveyard.\n\n    Sacrificing cannot be prevented by indestructible or regeneration, but\n    replacement effects that modify zone changes (e.g. \"if this would be\n    put into a graveyard, exile it instead\") still apply via\n    :func:`move_to_zone`.\n\n    Parameters:\n        game: The current game state.\n        player: The player performing the sacrifice.\n        permanent: The permanent to sacrifice.\n    \"\"\"\n    bf = game.get_battlefield(player)\n    if not bf.contains(permanent):\n        return\n\n    owner = getattr(permanent, \"owner\", player)\n    move_to_zone(\n        game,\n        permanent,\n        Zone.BATTLEFIELD,\n        Zone.GRAVEYARD,\n        replacement_event=SacrificeReplacementEvent(\n            permanent=permanent, destination=\"graveyard\",\n            controller=player, owner=owner,\n        ),\n    )\n\n\ndef exile(game: GameState, obj: Any) -> None:\n    \"\"\"Exile *obj* — move it to its owner's exile zone.\n\n    Works for objects on the battlefield, in the graveyard, on the stack,\n    or in hand.\n\n    Parameters:\n        game: The current game state.\n        obj: The game object to exile.\n    \"\"\"\n    # Find which zone the object is currently in\n    source_zone_type = None\n    for player in game.players:\n        for zone_type in Zone:\n            zone = player.zones[zone_type]\n            if zone.contains(obj):\n                source_zone_type = zone_type\n                break\n        if source_zone_type is not None:\n            break\n\n    if source_zone_type is None:\n        return\n\n    move_to_zone(game, obj, source_zone_type, Zone.EXILE)\n\n\ndef draw_card(game: GameState, player: Player) -> Any | None:\n    \"\"\"Draw a card for *player* — move the top card of library to hand.\n\n    If the library is empty, sets ``player.drawn_from_empty_library = True``\n    (SBAs will handle the game loss).\n\n    Fires :attr:`EventType.DRAWS_CARD` via the trigger manager.\n\n    Parameters:\n        game: The current game state.\n        player: The player drawing a card.\n\n    Returns:\n        The drawn card, or ``None`` if the library was empty.\n    \"\"\"\n    library = player.zones[Zone.LIBRARY]\n\n    if len(library) == 0:\n        player.drawn_from_empty_library = True\n        return None\n\n    # Top of library is the last element (index -1)\n    cards = library.top(1)\n    card = cards[0]\n    library.remove(card)\n\n    hand = player.zones[Zone.HAND]\n    hand.add(card)\n\n    # Track cards drawn this turn\n    if not hasattr(player, \"cards_drawn_this_turn\"):\n        player.cards_drawn_this_turn = 0\n    player.cards_drawn_this_turn += 1\n\n    # Fire trigger (only if game has a trigger_manager — may not during setup)\n    if hasattr(game, \"trigger_manager\"):\n        game.trigger_manager.fire_event(\n            game,\n            DrawsCardTriggeredEvent(player=player, card=card),\n        )\n\n    return card\n\n\ndef discard(game: GameState, player: Player, card: Any) -> None:\n    \"\"\"Discard *card* from *player*'s hand to the owner's graveyard.\n\n    Parameters:\n        game: The current game state.\n        player: The player discarding.\n        card: The card to discard (must be in the player's hand).\n    \"\"\"\n    hand = game.get_hand(player)\n    if not hand.contains(card):\n        return\n\n    move_to_zone(game, card, Zone.HAND, Zone.GRAVEYARD)\n\n\ndef create_token(game: GameState, player: Player, token: Any) -> None:\n    \"\"\"Create a token on the battlefield under *player*'s control.\n\n    Sets ``is_token = True`` on the token, along with ``owner`` and\n    ``controller``.  Uses :func:`move_to_zone` for entering-battlefield\n    hooks (trigger/replacement-effect registration and ETB event).\n\n    Parameters:\n        game: The current game state.\n        player: The player who controls the token.\n        token: The token object to place on the battlefield.\n    \"\"\"\n    token.is_token = True\n    token.owner = player\n    token.controller = player\n\n    # Tokens don't come from an existing zone — add directly and fire hooks.\n    # Ordering matches move_to_zone: fire ETB *before* registering the token's\n    # own triggers so a token's ETB trigger doesn't self-fire on entry.\n    battlefield = game.get_battlefield(player)\n    battlefield.add(token)\n\n    game.trigger_manager.fire_event(\n        game,\n        EntersBattlefieldTriggeredEvent(permanent=token, controller=player),\n    )\n\n    # Register triggers/replacement effects after the ETB event.\n    if hasattr(token, \"register_triggers\"):\n        token.register_triggers(game)\n    if hasattr(token, \"register_replacement_effects\"):\n        token.register_replacement_effects(game)\n\n\ndef add_counter(\n    game: GameState,\n    permanent: Any,\n    counter_type: str,\n    amount: int = 1,\n) -> None:\n    \"\"\"Add *amount* counters of *counter_type* to *permanent*.\n\n    Supports ``\"+1/+1\"`` and ``\"-1/-1\"`` counter types via the\n    ``plus_one_counters`` / ``minus_one_counters`` attributes.  For other\n    counter types, uses a generic ``counters`` dict.\n\n    Parameters:\n        game: The current game state.\n        permanent: The permanent to add counters to.\n        counter_type: The type of counter (e.g. ``\"+1/+1\"``, ``\"-1/-1\"``,\n            ``\"loyalty\"``, ``\"charge\"``).\n        amount: Number of counters to add (default 1).\n    \"\"\"\n    if amount <= 0:\n        return\n\n    if counter_type == \"+1/+1\" and hasattr(permanent, \"plus_one_counters\"):\n        permanent.plus_one_counters += amount\n    elif counter_type == \"-1/-1\" and hasattr(permanent, \"minus_one_counters\"):\n        permanent.minus_one_counters += amount\n    elif counter_type == \"loyalty\" and hasattr(permanent, \"loyalty\"):\n        permanent.loyalty += amount\n    else:\n        # Generic counter storage\n        if not hasattr(permanent, \"counters\"):\n            permanent.counters = {}\n        permanent.counters[counter_type] = permanent.counters.get(counter_type, 0) + amount\n\n\ndef remove_counter(\n    game: GameState,\n    permanent: Any,\n    counter_type: str,\n    amount: int = 1,\n) -> None:\n    \"\"\"Remove *amount* counters of *counter_type* from *permanent*.\n\n    Will not reduce below zero.\n\n    Parameters:\n        game: The current game state.\n        permanent: The permanent to remove counters from.\n        counter_type: The type of counter to remove.\n        amount: Number of counters to remove (default 1).\n    \"\"\"\n    if amount <= 0:\n        return\n\n    if counter_type == \"+1/+1\" and hasattr(permanent, \"plus_one_counters\"):\n        permanent.plus_one_counters = max(0, permanent.plus_one_counters - amount)\n    elif counter_type == \"-1/-1\" and hasattr(permanent, \"minus_one_counters\"):\n        permanent.minus_one_counters = max(0, permanent.minus_one_counters - amount)\n    elif counter_type == \"loyalty\" and hasattr(permanent, \"loyalty\"):\n        permanent.loyalty = max(0, permanent.loyalty - amount)\n    else:\n        if hasattr(permanent, \"counters\") and counter_type in permanent.counters:\n            permanent.counters[counter_type] = max(\n                0, permanent.counters[counter_type] - amount\n            )\n\n\ndef tap(game: GameState, permanent: Any) -> None:\n    \"\"\"Tap *permanent* — set ``is_tapped = True``.\n\n    Parameters:\n        game: The current game state.\n        permanent: The permanent to tap.\n    \"\"\"\n    if hasattr(permanent, \"is_tapped\"):\n        permanent.is_tapped = True\n\n\ndef untap(game: GameState, permanent: Any) -> None:\n    \"\"\"Untap *permanent* — set ``is_tapped = False``.\n\n    Parameters:\n        game: The current game state.\n        permanent: The permanent to untap.\n    \"\"\"\n    if hasattr(permanent, \"is_tapped\"):\n        permanent.is_tapped = False\n\n\n# ---------------------------------------------------------------------------\n# Game loop\n# ---------------------------------------------------------------------------\n\ndef run_game(game: GameState) -> Player | None:\n    \"\"\"Run the game loop until the game ends.\n\n    Executes :func:`~engine.turn.run_turn` in a loop, checking\n    :attr:`GameState.is_game_over` after each turn.  State-based actions\n    are resolved before and after each turn to catch game-ending conditions\n    even when the priority loop auto-passes.\n\n    Includes a safety limit of :data:`MAX_TURNS` to prevent infinite loops\n    in deterministic or stuck game states.\n\n    Parameters:\n        game: The game state to run.\n\n    Returns:\n        The winning player, or ``None`` if the game ended in a draw (or\n        hit the turn limit).\n    \"\"\"\n    from engine.state_based_actions import resolve_state_based_actions\n\n    while not game.is_game_over and game.turn_number <= MAX_TURNS:\n        # Check SBAs before the turn (catches pre-existing conditions)\n        resolve_state_based_actions(game)\n        _check_game_over(game)\n        if game.is_game_over:\n            break\n\n        run_turn(game)\n\n        # Check SBAs after the turn\n        resolve_state_based_actions(game)\n        _check_game_over(game)\n\n    return game.winner\n\n\ndef _check_game_over(game: GameState) -> None:\n    \"\"\"Check whether the game has ended and update ``game.is_game_over`` / ``game.winner``.\n\n    The game ends when:\n    - One player has lost (``has_lost``): the other player wins.\n    - Both players have lost: the game is a draw (``winner = None``).\n    - The turn limit is exceeded: the game is a draw.\n    \"\"\"\n    lost_players = [p for p in game.players if p.has_lost]\n\n    if len(lost_players) == len(game.players):\n        # All players have lost — draw\n        game.is_game_over = True\n        game.winner = None\n    elif len(lost_players) == 1:\n        # One player lost — the other wins\n        game.is_game_over = True\n        game.winner = [p for p in game.players if not p.has_lost][0]\n    elif game.turn_number > MAX_TURNS:\n        # Turn limit exceeded — draw\n        game.is_game_over = True\n        game.winner = None\n","numLines":538,"startLine":1,"totalLines":538}}}
