{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012H6ebqbZb298VR8FxZRQrf","type":"tool_result","content":"1\t\"\"\"Replacement effects engine — modifies events in-place with \"instead\" semantics.\n2\t\n3\tUnlike triggered abilities (which go on the stack), replacement effects\n4\tintercept an event *before* it happens and substitute an alternative\n5\toutcome.  Key design differences from triggers:\n6\t\n7\t- **No stack**: replacements are applied inline, not pushed.\n8\t- **\"Instead\" semantics**: the original event is replaced, not supplemented.\n9\t- **Self-replacement prevention**: each effect applies at most once per\n10\t  event to avoid infinite loops.\n11\t- **Player choice**: when multiple replacements apply to the same event,\n12\t  the affected player chooses the order via ``Player.choose``.\n13\t- **Subtype matching**: a replacement registered for a parent event class\n14\t  (e.g. ``MoveToGraveyardReplacementEvent``) fires for any subtype\n15\t  (e.g. ``CreatureDiesReplacementEvent``).\n16\t\n17\tPublic API:\n18\t\n19\t- :class:`ReplacementEffect` — dataclass describing a single replacement.\n20\t- :class:`ReplacementManager` — central registry with ``register``,\n21\t  ``unregister``, and ``apply`` methods.\n22\t\"\"\"\n23\t\n24\tfrom __future__ import annotations\n25\t\n26\tfrom dataclasses import dataclass\n27\tfrom typing import TYPE_CHECKING, Any, Callable\n28\t\n29\tfrom engine.events import ReplacementEvent\n30\t\n31\tif TYPE_CHECKING:\n32\t    from engine.game_state import GameState\n33\t    from engine.player import Player\n34\t\n35\t\n36\t@dataclass\n37\tclass ReplacementEffect:\n38\t    \"\"\"Describes a single replacement effect.\n39\t\n40\t    Attributes:\n41\t        event_type: The event class (or a base class) this replacement\n42\t            watches for.  A replacement registered for a parent class\n43\t            also fires when the event is an instance of a subclass.\n44\t        source: The game object (card / permanent) that owns this effect.\n45\t        condition: Optional callable ``(game, event) -> bool`` that must\n46\t            return ``True`` for the replacement to apply.\n47\t        replacement: Callable ``(game, event) -> event`` that receives the\n48\t            current event object and returns a (possibly modified) version.\n49\t        controller: The player who controls the source.\n50\t    \"\"\"\n51\t\n52\t    event_type: type[ReplacementEvent]\n53\t    source: Any\n54\t    condition: Callable[..., bool] | None\n55\t    replacement: Callable[..., ReplacementEvent]\n56\t    controller: Any = None\n57\t\n58\t\n59\tclass ReplacementManager:\n60\t    \"\"\"Central registry for replacement effects.\"\"\"\n61\t\n62\t    def __init__(self) -> None:\n63\t        self._effects: list[ReplacementEffect] = []\n64\t\n65\t    # ------------------------------------------------------------------\n66\t    # Registration\n67\t    # ------------------------------------------------------------------\n68\t\n69\t    def register(self, effect: ReplacementEffect) -> None:\n70\t        \"\"\"Register a replacement effect.\"\"\"\n71\t        self._effects.append(effect)\n72\t\n73\t    def unregister(self, source: Any) -> None:\n74\t        \"\"\"Remove all replacement effects registered by *source*.\"\"\"\n75\t        self._effects = [e for e in self._effects if e.source is not source]\n76\t\n77\t    # ------------------------------------------------------------------\n78\t    # Application\n79\t    # ------------------------------------------------------------------\n80\t\n81\t    def apply(self, game: GameState, event: ReplacementEvent) -> ReplacementEvent:\n82\t        \"\"\"Apply matching replacement effects to *event*.\n83\t\n84\t        1. Collect all registered effects whose ``event_type`` is a\n85\t           superclass of (or equal to) the event's class and whose\n86\t           ``condition`` returns ``True``.\n87\t        2. If multiple effects match, the affected player chooses the order.\n88\t        3. Each chosen effect's ``replacement`` callable is invoked and\n89\t           the result replaces the current event.\n90\t        4. Each effect applies at most once per invocation.\n91\t\n92\t        Parameters:\n93\t            game: The current game state.\n94\t            event: The typed event object to potentially modify.\n95\t\n96\t        Returns:\n97\t            The (possibly modified) event after all applicable replacements.\n98\t        \"\"\"\n99\t        applied: set[int] = set()\n100\t\n101\t        while True:\n102\t            matching = self._collect_matching(game, event, applied)\n103\t            if not matching:\n104\t                break\n105\t\n106\t            if len(matching) == 1:\n107\t                chosen = matching[0]\n108\t            else:\n109\t                affected = self._get_affected_player(game, event)\n110\t                chosen = affected.choose(matching, \"Choose replacement effect order\")\n111\t\n112\t            applied.add(id(chosen))\n113\t            event = chosen.replacement(game, event)\n114\t\n115\t        return event\n116\t\n117\t    # ------------------------------------------------------------------\n118\t    # Queries\n119\t    # ------------------------------------------------------------------\n120\t\n121\t    def get_effects(self) -> list[ReplacementEffect]:\n122\t        \"\"\"Return a shallow copy of all registered replacement effects.\"\"\"\n123\t        return list(self._effects)\n124\t\n125\t    def get_effects_for_source(self, source: Any) -> list[ReplacementEffect]:\n126\t        \"\"\"Return all effects registered by *source*.\"\"\"\n127\t        return [e for e in self._effects if e.source is source]\n128\t\n129\t    def clear(self) -> None:\n130\t        \"\"\"Remove all registered replacement effects.\"\"\"\n131\t        self._effects.clear()\n132\t\n133\t    # ------------------------------------------------------------------\n134\t    # Internal helpers\n135\t    # ------------------------------------------------------------------\n136\t\n137\t    def _collect_matching(\n138\t        self,\n139\t        game: GameState,\n140\t        event: ReplacementEvent,\n141\t        applied: set[int],\n142\t    ) -> list[ReplacementEffect]:\n143\t        \"\"\"Collect effects matching the event type that haven't been applied.\"\"\"\n144\t        matching: list[ReplacementEffect] = []\n145\t        for effect in self._effects:\n146\t            if id(effect) in applied:\n147\t                continue\n148\t            if not isinstance(event, effect.event_type):\n149\t                continue\n150\t            if effect.condition is not None:\n151\t                if not effect.condition(game, event):\n152\t                    continue\n153\t            matching.append(effect)\n154\t        return matching\n155\t\n156\t    @staticmethod\n157\t    def _get_affected_player(game: GameState, event: ReplacementEvent) -> Any:\n158\t        \"\"\"Determine the affected player for ordering choices.\"\"\"\n159\t        player = getattr(event, \"player\", None)\n160\t        if player is not None:\n161\t            return player\n162\t        controller = getattr(event, \"controller\", None)\n163\t        if controller is not None:\n164\t            return controller\n165\t        return game.active_player\n166\t"}]},"parent_tool_use_id":null,"session_id":"6b0c2803-fb7f-4347-8991-d01b6c022fd2","uuid":"b77da56f-c506-4cb1-bf5d-baaad7acfe25","timestamp":"2026-06-04T10:56:52.383Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/replacement_effects.py","content":"\"\"\"Replacement effects engine — modifies events in-place with \"instead\" semantics.\n\nUnlike triggered abilities (which go on the stack), replacement effects\nintercept an event *before* it happens and substitute an alternative\noutcome.  Key design differences from triggers:\n\n- **No stack**: replacements are applied inline, not pushed.\n- **\"Instead\" semantics**: the original event is replaced, not supplemented.\n- **Self-replacement prevention**: each effect applies at most once per\n  event to avoid infinite loops.\n- **Player choice**: when multiple replacements apply to the same event,\n  the affected player chooses the order via ``Player.choose``.\n- **Subtype matching**: a replacement registered for a parent event class\n  (e.g. ``MoveToGraveyardReplacementEvent``) fires for any subtype\n  (e.g. ``CreatureDiesReplacementEvent``).\n\nPublic API:\n\n- :class:`ReplacementEffect` — dataclass describing a single replacement.\n- :class:`ReplacementManager` — central registry with ``register``,\n  ``unregister``, and ``apply`` methods.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom typing import TYPE_CHECKING, Any, Callable\n\nfrom engine.events import ReplacementEvent\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n@dataclass\nclass ReplacementEffect:\n    \"\"\"Describes a single replacement effect.\n\n    Attributes:\n        event_type: The event class (or a base class) this replacement\n            watches for.  A replacement registered for a parent class\n            also fires when the event is an instance of a subclass.\n        source: The game object (card / permanent) that owns this effect.\n        condition: Optional callable ``(game, event) -> bool`` that must\n            return ``True`` for the replacement to apply.\n        replacement: Callable ``(game, event) -> event`` that receives the\n            current event object and returns a (possibly modified) version.\n        controller: The player who controls the source.\n    \"\"\"\n\n    event_type: type[ReplacementEvent]\n    source: Any\n    condition: Callable[..., bool] | None\n    replacement: Callable[..., ReplacementEvent]\n    controller: Any = None\n\n\nclass ReplacementManager:\n    \"\"\"Central registry for replacement effects.\"\"\"\n\n    def __init__(self) -> None:\n        self._effects: list[ReplacementEffect] = []\n\n    # ------------------------------------------------------------------\n    # Registration\n    # ------------------------------------------------------------------\n\n    def register(self, effect: ReplacementEffect) -> None:\n        \"\"\"Register a replacement effect.\"\"\"\n        self._effects.append(effect)\n\n    def unregister(self, source: Any) -> None:\n        \"\"\"Remove all replacement effects registered by *source*.\"\"\"\n        self._effects = [e for e in self._effects if e.source is not source]\n\n    # ------------------------------------------------------------------\n    # Application\n    # ------------------------------------------------------------------\n\n    def apply(self, game: GameState, event: ReplacementEvent) -> ReplacementEvent:\n        \"\"\"Apply matching replacement effects to *event*.\n\n        1. Collect all registered effects whose ``event_type`` is a\n           superclass of (or equal to) the event's class and whose\n           ``condition`` returns ``True``.\n        2. If multiple effects match, the affected player chooses the order.\n        3. Each chosen effect's ``replacement`` callable is invoked and\n           the result replaces the current event.\n        4. Each effect applies at most once per invocation.\n\n        Parameters:\n            game: The current game state.\n            event: The typed event object to potentially modify.\n\n        Returns:\n            The (possibly modified) event after all applicable replacements.\n        \"\"\"\n        applied: set[int] = set()\n\n        while True:\n            matching = self._collect_matching(game, event, applied)\n            if not matching:\n                break\n\n            if len(matching) == 1:\n                chosen = matching[0]\n            else:\n                affected = self._get_affected_player(game, event)\n                chosen = affected.choose(matching, \"Choose replacement effect order\")\n\n            applied.add(id(chosen))\n            event = chosen.replacement(game, event)\n\n        return event\n\n    # ------------------------------------------------------------------\n    # Queries\n    # ------------------------------------------------------------------\n\n    def get_effects(self) -> list[ReplacementEffect]:\n        \"\"\"Return a shallow copy of all registered replacement effects.\"\"\"\n        return list(self._effects)\n\n    def get_effects_for_source(self, source: Any) -> list[ReplacementEffect]:\n        \"\"\"Return all effects registered by *source*.\"\"\"\n        return [e for e in self._effects if e.source is source]\n\n    def clear(self) -> None:\n        \"\"\"Remove all registered replacement effects.\"\"\"\n        self._effects.clear()\n\n    # ------------------------------------------------------------------\n    # Internal helpers\n    # ------------------------------------------------------------------\n\n    def _collect_matching(\n        self,\n        game: GameState,\n        event: ReplacementEvent,\n        applied: set[int],\n    ) -> list[ReplacementEffect]:\n        \"\"\"Collect effects matching the event type that haven't been applied.\"\"\"\n        matching: list[ReplacementEffect] = []\n        for effect in self._effects:\n            if id(effect) in applied:\n                continue\n            if not isinstance(event, effect.event_type):\n                continue\n            if effect.condition is not None:\n                if not effect.condition(game, event):\n                    continue\n            matching.append(effect)\n        return matching\n\n    @staticmethod\n    def _get_affected_player(game: GameState, event: ReplacementEvent) -> Any:\n        \"\"\"Determine the affected player for ordering choices.\"\"\"\n        player = getattr(event, \"player\", None)\n        if player is not None:\n            return player\n        controller = getattr(event, \"controller\", None)\n        if controller is not None:\n            return controller\n        return game.active_player\n","numLines":166,"startLine":1,"totalLines":166}}}
