{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SRvytCqYNQTdudeWB4kEEp","type":"tool_result","content":"200\t                    raise CastingError(\n201\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n202\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n203\t                    )\n204\t            chosen_targets.append(target)\n205\t\n206\t    # 5b. Protection check — reject targets that have protection from this\n207\t    #     spell (the T in DEBT).\n208\t    from engine.protection import has_protection_from\n209\t\n210\t    for target in chosen_targets:\n211\t        if has_protection_from(target, card):\n212\t            # Rollback: move card from stack zone back to hand\n213\t            stack_zone.remove(card)\n214\t            hand.add(card)\n215\t            raise CastingError(\n216\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n217\t            )\n218\t\n219\t    # Targets are stored on the StackObject (not the card) and passed\n220\t    # through the resolve pipeline via on_resolve(game, targets=...).\n221\t\n222\t    # 6. Mana check / payment (rollback on failure)\n223\t    # Ensure the card knows its controller so that cost_reduction() hooks\n224\t    # (e.g. Embercleave counting attacking creatures you control) see the\n225\t    # casting player, even for cards that were added to hand without an\n226\t    # explicit controller assignment.\n227\t    if card.controller is None:\n228\t        card.controller = player\n229\t    reduction = get_cost_reduction(game, card, player)\n230\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n231\t\n232\t    if not player.mana_pool.can_pay(effective_cost):\n233\t        # Rollback: move card from stack zone back to hand\n234\t        stack_zone.remove(card)\n235\t        hand.add(card)\n236\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n237\t\n238\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n239\t    player.mana_pool.pay(effective_cost)\n240\t\n241\t    # Store colors of mana spent on the card for mechanics like Converge\n242\t    # that care about the colors used to cast the spell.\n243\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n244\t\n245\t    # 7. Call on_cast hook\n246\t    card.on_cast(game)\n247\t\n248\t    # 8. Build on_resolve callback and push StackObject\n249\t    stack_obj = StackObject(\n250\t        source=card,\n251\t        controller=player,\n252\t        targets=chosen_targets,\n253\t        on_resolve=lambda g: None,  # replaced below\n254\t    )\n255\t\n256\t    def _on_resolve(g: GameState) -> None:\n257\t        _resolve_spell(g, card, player, stack_obj)\n258\t\n259\t    stack_obj.on_resolve = _on_resolve\n260\t    game.stack.push(stack_obj)\n261\t\n262\t    # Fire the \"whenever you cast a spell\" event so cards that listen for\n263\t    # spell casts (e.g. casualty, Wizard pump) can trigger.  No-op unless a\n264\t    # trigger is registered for SpellCastTriggeredEvent.\n265\t    from engine.events import SpellCastTriggeredEvent\n266\t\n267\t    game.trigger_manager.fire_event(\n268\t        game,\n269\t        SpellCastTriggeredEvent(\n270\t            spell=stack_obj, player=player, card=card, controller=player\n271\t        ),\n272\t    )\n273\t\n274\t\n275\t# ------------------------------------------------------------------\n276\t# Cast spell without paying mana cost (free-cast from any zone)\n277\t# ------------------------------------------------------------------\n278\t\n279\t\n280\tdef cast_spell_free(\n281\t    game: GameState,\n282\t    player: Player,\n283\t    card: CardImpl,\n284\t    from_zone: Zone,\n285\t) -> None:\n286\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n287\t\n288\t    This is used by effects that allow casting from zones other than hand\n289\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n290\t    or cascade.\n291\t\n292\t    Pipeline\n293\t    --------\n294\t    1. **can_cast** — ask the card whether it can legally be cast (same\n295\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n296\t    2. Move *card* from *from_zone* to the stack zone.\n297\t    3. Choose targets (if applicable) with validation and protection check.\n298\t    4. Call ``on_cast`` hook.\n299\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n300\t       resolution normally (permanents → battlefield, non-permanents →\n301\t       graveyard).\n302\t\n303\t    No timing check or mana payment is performed.  The spell goes on the\n304\t    stack and can be responded to normally (e.g. countered).\n305\t\n306\t    If targeting or other post-move checks fail, the card is rolled back\n307\t    to its source zone.\n308\t\n309\t    Parameters:\n310\t        game: The current game state.\n311\t        player: The player casting the spell.\n312\t        card: The card to cast.\n313\t        from_zone: The zone the card is currently in.\n314\t\n315\t    Raises:\n316\t        CastingError: If the card cannot be found in *from_zone* or\n317\t            legality checks fail.\n318\t    \"\"\"\n319\t    from engine.zones import move_to_zone\n320\t\n321\t    # Ensure controller is set\n322\t    card.controller = player\n323\t    if card.owner is None:\n324\t        card.owner = player\n325\t\n326\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n327\t    if not card.can_cast(game):\n328\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n329\t"}]},"parent_tool_use_id":null,"session_id":"6b0c2803-fb7f-4347-8991-d01b6c022fd2","uuid":"c6d52b45-630b-4ff2-9d87-a0d2049bb4b1","timestamp":"2026-06-04T11:05:48.187Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"                    raise CastingError(\n                        f\"Cannot cast {card.name!r} — chosen target does not \"\n                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                    )\n            chosen_targets.append(target)\n\n    # 5b. Protection check — reject targets that have protection from this\n    #     spell (the T in DEBT).\n    from engine.protection import has_protection_from\n\n    for target in chosen_targets:\n        if has_protection_from(target, card):\n            # Rollback: move card from stack zone back to hand\n            stack_zone.remove(card)\n            hand.add(card)\n            raise CastingError(\n                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n            )\n\n    # Targets are stored on the StackObject (not the card) and passed\n    # through the resolve pipeline via on_resolve(game, targets=...).\n\n    # 6. Mana check / payment (rollback on failure)\n    # Ensure the card knows its controller so that cost_reduction() hooks\n    # (e.g. Embercleave counting attacking creatures you control) see the\n    # casting player, even for cards that were added to hand without an\n    # explicit controller assignment.\n    if card.controller is None:\n        card.controller = player\n    reduction = get_cost_reduction(game, card, player)\n    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n\n    if not player.mana_pool.can_pay(effective_cost):\n        # Rollback: move card from stack zone back to hand\n        stack_zone.remove(card)\n        hand.add(card)\n        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n\n    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n    player.mana_pool.pay(effective_cost)\n\n    # Store colors of mana spent on the card for mechanics like Converge\n    # that care about the colors used to cast the spell.\n    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n\n    # 7. Call on_cast hook\n    card.on_cast(game)\n\n    # 8. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n    # Fire the \"whenever you cast a spell\" event so cards that listen for\n    # spell casts (e.g. casualty, Wizard pump) can trigger.  No-op unless a\n    # trigger is registered for SpellCastTriggeredEvent.\n    from engine.events import SpellCastTriggeredEvent\n\n    game.trigger_manager.fire_event(\n        game,\n        SpellCastTriggeredEvent(\n            spell=stack_obj, player=player, card=card, controller=player\n        ),\n    )\n\n\n# ------------------------------------------------------------------\n# Cast spell without paying mana cost (free-cast from any zone)\n# ------------------------------------------------------------------\n\n\ndef cast_spell_free(\n    game: GameState,\n    player: Player,\n    card: CardImpl,\n    from_zone: Zone,\n) -> None:\n    \"\"\"Cast *card* without paying its mana cost, using the stack.\n\n    This is used by effects that allow casting from zones other than hand\n    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n    or cascade.\n\n    Pipeline\n    --------\n    1. **can_cast** — ask the card whether it can legally be cast (same\n       legality as :func:`cast_spell`, minus mana/timing constraints).\n    2. Move *card* from *from_zone* to the stack zone.\n    3. Choose targets (if applicable) with validation and protection check.\n    4. Call ``on_cast`` hook.\n    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n       resolution normally (permanents → battlefield, non-permanents →\n       graveyard).\n\n    No timing check or mana payment is performed.  The spell goes on the\n    stack and can be responded to normally (e.g. countered).\n\n    If targeting or other post-move checks fail, the card is rolled back\n    to its source zone.\n\n    Parameters:\n        game: The current game state.\n        player: The player casting the spell.\n        card: The card to cast.\n        from_zone: The zone the card is currently in.\n\n    Raises:\n        CastingError: If the card cannot be found in *from_zone* or\n            legality checks fail.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Ensure controller is set\n    card.controller = player\n    if card.owner is None:\n        card.owner = player\n\n    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n","numLines":130,"startLine":200,"totalLines":540}}}
