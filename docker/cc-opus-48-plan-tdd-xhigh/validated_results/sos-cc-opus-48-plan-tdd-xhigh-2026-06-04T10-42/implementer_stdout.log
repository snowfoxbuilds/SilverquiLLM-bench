_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n    # Fire the \"whenever you cast a spell\" event so cards that listen for\n    # spell casts (e.g. casualty, Wizard pump) can trigger.  No-op unless a\n    # trigger is registered for SpellCastTriggeredEvent.\n    from engine.events import SpellCastTriggeredEvent\n\n    game.trigger_manager.fire_event(\n        game,\n        SpellCastTriggeredEvent(\n            spell=stack_obj, player=player, card=card, controller=player\n        ),\n    )\n\n\n# ------------------------------------------------------------------\n# Cast spell without paying mana cost (free-cast from any zone)\n# ------------------------------------------------------------------\n\n\ndef cast_spell_free(\n    game: GameState,\n    player: Player,\n    card: CardImpl,\n    from_zone: Zone,\n) -> None:\n    \"\"\"Cast *card* without paying its mana cost, using the stack.\n\n    This is used by effects that allow casting from zones other than hand\n    (e.g. exile) without paying mana costs — such as Etali, Primal Storm","numLines":80,"startLine":210,"totalLines":540}}}
