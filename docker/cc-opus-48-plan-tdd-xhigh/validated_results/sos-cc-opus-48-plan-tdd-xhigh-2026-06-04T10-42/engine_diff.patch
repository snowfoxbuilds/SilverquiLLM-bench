+def flip_coin(game: GameState, player: Player) -> bool:
+    """Flip a coin for *player*; return ``True`` for heads.
+
+    Modeled via :meth:`Player.choose_yes_no` so the outcome is
+    deterministic and scriptable (heads == yes).
+
+    Parameters:
+        game: The current game state.
+        player: The player flipping the coin (and calling it).
+
+    Returns:
+        ``True`` if the flip comes up heads, ``False`` for tails.
+    """
+    return bool(player.choose_yes_no("Coin flip: heads?"))
+
+
+def surveil(game: GameState, player: Player, n: int) -> None:
+    """Surveil *n* — look at the top *n* cards of *player*'s library and,
+    for each, choose to keep it on top or put it into the graveyard.
+
+    For each of the top *n* cards (top-first), :meth:`Player.choose_yes_no`
+    decides whether to keep it on top (``True``) or move it to the
+    graveyard (``False``). Kept cards retain their relative order.
+
+    Parameters:
+        game: The current game state.
+        player: The player surveilling.
+        n: The number of cards to look at.
+    """
+    if n <= 0:
+        return
+
+    library = player.zones[Zone.LIBRARY]
+    graveyard = player.zones[Zone.GRAVEYARD]
+
+    # library.top(n) returns bottom-to-top; reverse so we process the
+    # actual top card first.
+    for card in reversed(library.top(n)):
+        if not library.contains(card):
+            continue
+        keep = player.choose_yes_no(
+            f"Surveil: keep {getattr(card, 'name', 'card')} on top?"
+        )
+        if not keep:
+            library.remove(card)
+            graveyard.add(card)
+
+
