e.\"\"\"\n\n    def __init__(self, **kwargs):\n        kwargs.setdefault(\"name\", 'Pox Plague')\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse('{B}{B}{B}{B}{B}'))\n        kwargs.setdefault(\"card_types\", {CardType.SORCERY})\n        super().__init__(**kwargs)\n        self.colors = ['B']\n\n\nclass PullFromTheGrave(Sorcery):\n    \"\"\"Stub for Pull from the Grave.\"\"\"\n\n    def __init__(self, **kwargs):\n        kwargs.setdefault(\"name\", 'Pull from the Grave')\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse('{2}{B}'))\n        kwargs.setdefault(\"card_types\", {CardType.SORCERY})\n        super().__init__(**kwargs)\n        self.colors = ['B']\n\n\nclass RabidAttack(Instant):\n    \"\"\"Stub for Rabid Attack.\"\"\"\n\n    def __init__(self, **kwargs):\n        kwargs.setdefault(\"name\", 'Rabid Attack')\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse('{1}{B}'))\n        kwargs.setdefault(\"card_types\", {CardType.INSTANT})\n        super().__init__(**kwargs)\n        self.colors = ['B']\n\n\nclass RalZarekGuestLecturer(Planeswalker):\n    \"\"\"Stub for Ral Zarek, Guest Lecturer.\"\"\"\n\n    def __init__(self, **kwargs):\n        kwargs.setdefault(\"name\", 'Ral Zarek, Guest Lecturer')\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse('{1}{B}{B}'))\n        kwargs.setdefault(\"card_types\", {CardType.PLANESWALKER})\n        kwargs.setdefault(\"subtypes\", {'Ral'})\n        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n        kwargs.setdefault(\"starting_loyalty\", 3)\n        super().__init__(**kwargs)\n        self.colors = ['B']\n\n\nclass ScathingShadelockVenomousWords(Creature):\n    \"\"\"Stub for Scathing Shadelock // Venomous Words.\"\"\"\n\n    def __init__(self, **kwargs):\n        kwargs.setdefault(\"name\", 'Scathing Shadelock // Venomous Words')\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse('{4}{B}'))\n        kwargs.setdefault(\"card_types\", {CardType.CREATURE})\n        kwargs.setdefault(\"subtypes\", {'Snake', 'Warlock'})\n        kwargs.setdefault(\"base_power\", 4)\n        kwargs.setdefault(\"base_toughness\", 6)\n        super().__init__(**kwargs)\n        self.colors = ['B']\n\n\nclass SchemingSilvertongueSignInBlood(Creature):\n    \"\"\"Stub for Scheming Silvertongue // Sign in Blood.\"\"\"\n\n    def __init__(self, **kwargs):\n        kwargs.setdefault(\"name\", 'Scheming Silvertongue // Sign in Blood')\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse('{1}{B}'))\n        kwargs.setdefault(\"card_types\", {CardType.CREATURE})\n        kwargs.setdefault(\"subtypes\", {'Vampire', 'Warlock'})\n        kwargs.setdefault(\"base_power\", 1)","numLines":1285,"startLine":1,"totalLines":8820,"truncatedByTokenCap":true}}}
