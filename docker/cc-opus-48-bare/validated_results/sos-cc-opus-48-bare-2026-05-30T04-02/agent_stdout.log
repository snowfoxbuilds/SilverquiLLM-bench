{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0127LDUKreByVz2j43G2WD79","type":"tool_result","content":"120\t    return max(0, min(raw, generic))\n121\t\n122\t\n123\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n124\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n125\t    new_generic = max(0, cost.generic - reduction)\n126\t    return ManaCost(\n127\t        generic=new_generic,\n128\t        pips=dict(cost.pips),\n129\t        x_count=cost.x_count,\n130\t        hybrid=list(cost.hybrid),\n131\t    )\n132\t\n133\t\n134\t# ------------------------------------------------------------------\n135\t# Cast spell\n136\t# ------------------------------------------------------------------\n137\t\n138\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n139\t    \"\"\"Cast *card* from *player*'s hand.\n140\t\n141\t    Pipeline\n142\t    --------\n143\t    1. **Timing check** — instants (and cards with flash) can be cast\n144\t       whenever the player has priority; everything else requires\n145\t       sorcery-speed timing.\n146\t    2. **can_cast** — ask the card whether it can legally be cast.\n147\t    3. **Hand check** — the card must be in the player's hand.\n148\t    4. **Move hand → stack zone** — remove the card from the hand and\n149\t       place it into the player's stack zone.\n150\t    5. **Choose targets** — if the card specifies targets (via\n151\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n152\t    6. **Mana check / payment** — the player's mana pool must be able to\n153\t       pay the card's mana cost.  If payment fails, the card is rolled\n154\t       back from the stack zone to the hand.\n155\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n156\t    8. **Push StackObject** — push a :class:`StackObject` whose\n157\t       ``on_resolve`` callback handles resolution.\n158\t\n159\t    Raises:\n160\t        CastingError: If any legality check fails.\n161\t    \"\"\"\n162\t    # 1. Timing\n163\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n164\t        raise CastingError(\n165\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n166\t        )\n167\t\n168\t    # 2. can_cast\n169\t    if not card.can_cast(game):\n170\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n171\t\n172\t    # 3. Hand check\n173\t    hand = game.get_hand(player)\n174\t    if not hand.contains(card):\n175\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n176\t\n177\t    # 4. Move card from hand to stack zone\n178\t    stack_zone = player.zones[Zone.STACK]\n179\t    hand.remove(card)\n180\t    stack_zone.add(card)\n181\t\n182\t    # Clear any stale colors_spent from a prior cast before new payment.\n183\t    if hasattr(card, \"colors_spent\"):\n184\t        del card.colors_spent\n185\t\n186\t    # 5. Choose targets\n187\t    target_specs = card.get_targets(game)\n188\t    chosen_targets: list[Any] = []\n189\t    if target_specs:\n190\t        for spec in target_specs:\n191\t            target = player.choose_target(target_specs, spec)\n192\t            # Validate against filter_fn if the spec provides one\n193\t            filter_fn = getattr(spec, \"filter_fn\", None)\n194\t            if filter_fn is not None and target is not None:\n195\t                if not filter_fn(target):\n196\t                    stack_zone.remove(card)\n197\t                    hand.add(card)\n198\t                    raise CastingError(\n199\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n200\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n201\t                    )\n202\t            chosen_targets.append(target)\n203\t\n204\t    # 5b. Protection check — reject targets that have protection from this\n205\t    #     spell (the T in DEBT).\n206\t    from engine.protection import has_protection_from\n207\t\n208\t    for target in chosen_targets:\n209\t        if has_protection_from(target, card):\n210\t            # Rollback: move card from stack zone back to hand\n211\t            stack_zone.remove(card)\n212\t            hand.add(card)\n213\t            raise CastingError(\n214\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n215\t            )\n216\t\n217\t    # Targets are stored on the StackObject (not the card) and passed\n218\t    # through the resolve pipeline via on_resolve(game, targets=...).\n219\t\n220\t    # 6. Mana check / payment (rollback on failure)\n221\t    # Ensure the card knows its controller so that cost_reduction() hooks\n222\t    # (e.g. Embercleave counting attacking creatures you control) see the\n223\t    # casting player, even for cards that were added to hand without an\n224\t    # explicit controller assignment.\n225\t    if card.controller is None:\n226\t        card.controller = player\n227\t    reduction = get_cost_reduction(game, card, player)\n228\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n229\t\n230\t    if not player.mana_pool.can_pay(effective_cost):\n231\t        # Rollback: move card from stack zone back to hand\n232\t        stack_zone.remove(card)\n233\t        hand.add(card)\n234\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n235\t\n236\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n237\t    player.mana_pool.pay(effective_cost)\n238\t\n239\t    # Store colors of mana spent on the card for mechanics like Converge\n240\t    # that care about the colors used to cast the spell.\n241\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n242\t\n243\t    # Store the amount of mana spent to cast the spell (for mechanics like\n244\t    # Mana Sculpt that add mana equal to what was paid for a countered spell).\n245\t    card.mana_spent = effective_cost.cmc  # type: ignore[attr-defined]\n246\t\n247\t    # 7. Call on_cast hook\n248\t    card.on_cast(game)\n249\t\n250\t    # 8. Build on_resolve callback and push StackObject\n251\t    stack_obj = StackObject(\n252\t        source=card,\n253\t        controller=player,\n254\t        targets=chosen_targets,\n255\t        on_resolve=lambda g: None,  # replaced below\n256\t    )\n257\t\n258\t    def _on_resolve(g: GameState) -> None:\n259\t        _resolve_spell(g, card, player, stack_obj)\n260\t\n261\t    stack_obj.on_resolve = _on_resolve\n262\t    game.stack.push(stack_obj)\n263\t\n264\t    # Spell-cast triggers (e.g. casualty, prowess) fire after the spell is on\n265\t    # the stack, so their triggered abilities are placed above it and resolve\n266\t    # first.  Firing with no registered spell-cast triggers is a no-op.\n267\t    game.trigger_manager.fire_event(\n268\t        game,\n269\t        SpellCastTriggeredEvent(\n270\t            spell=stack_obj, player=player, card=card, controller=player\n271\t        ),\n272\t    )\n273\t\n274\t\n275\t# ------------------------------------------------------------------\n276\t# Cast spell without paying mana cost (free-cast from any zone)\n277\t# ------------------------------------------------------------------\n278\t\n279\t"}]},"parent_tool_use_id":null,"session_id":"b76fbb6d-7052-44e0-893e-8a2c1cc9d4a6","uuid":"f7b84754-15c6-4312-96fd-021607da75da","timestamp":"2026-05-30T04:56:57.936Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"    return max(0, min(raw, generic))\n\n\ndef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n    new_generic = max(0, cost.generic - reduction)\n    return ManaCost(\n        generic=new_generic,\n        pips=dict(cost.pips),\n        x_count=cost.x_count,\n        hybrid=list(cost.hybrid),\n    )\n\n\n# ------------------------------------------------------------------\n# Cast spell\n# ------------------------------------------------------------------\n\ndef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n    \"\"\"Cast *card* from *player*'s hand.\n\n    Pipeline\n    --------\n    1. **Timing check** — instants (and cards with flash) can be cast\n       whenever the player has priority; everything else requires\n       sorcery-speed timing.\n    2. **can_cast** — ask the card whether it can legally be cast.\n    3. **Hand check** — the card must be in the player's hand.\n    4. **Move hand → stack zone** — remove the card from the hand and\n       place it into the player's stack zone.\n    5. **Choose targets** — if the card specifies targets (via\n       :meth:`CardImpl.get_targets`), the player is asked to choose.\n    6. **Mana check / payment** — the player's mana pool must be able to\n       pay the card's mana cost.  If payment fails, the card is rolled\n       back from the stack zone to the hand.\n    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n    8. **Push StackObject** — push a :class:`StackObject` whose\n       ``on_resolve`` callback handles resolution.\n\n    Raises:\n        CastingError: If any legality check fails.\n    \"\"\"\n    # 1. Timing\n    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n        )\n\n    # 2. can_cast\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 3. Hand check\n    hand = game.get_hand(player)\n    if not hand.contains(card):\n        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n\n    # 4. Move card from hand to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    hand.remove(card)\n    stack_zone.add(card)\n\n    # Clear any stale colors_spent from a prior cast before new payment.\n    if hasattr(card, \"colors_spent\"):\n        del card.colors_spent\n\n    # 5. Choose targets\n    target_specs = card.get_targets(game)\n    chosen_targets: list[Any] = []\n    if target_specs:\n        for spec in target_specs:\n            target = player.choose_target(target_specs, spec)\n            # Validate against filter_fn if the spec provides one\n            filter_fn = getattr(spec, \"filter_fn\", None)\n            if filter_fn is not None and target is not None:\n                if not filter_fn(target):\n                    stack_zone.remove(card)\n                    hand.add(card)\n                    raise CastingError(\n                        f\"Cannot cast {card.name!r} — chosen target does not \"\n                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                    )\n            chosen_targets.append(target)\n\n    # 5b. Protection check — reject targets that have protection from this\n    #     spell (the T in DEBT).\n    from engine.protection import has_protection_from\n\n    for target in chosen_targets:\n        if has_protection_from(target, card):\n            # Rollback: move card from stack zone back to hand\n            stack_zone.remove(card)\n            hand.add(card)\n            raise CastingError(\n                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n            )\n\n    # Targets are stored on the StackObject (not the card) and passed\n    # through the resolve pipeline via on_resolve(game, targets=...).\n\n    # 6. Mana check / payment (rollback on failure)\n    # Ensure the card knows its controller so that cost_reduction() hooks\n    # (e.g. Embercleave counting attacking creatures you control) see the\n    # casting player, even for cards that were added to hand without an\n    # explicit controller assignment.\n    if card.controller is None:\n        card.controller = player\n    reduction = get_cost_reduction(game, card, player)\n    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n\n    if not player.mana_pool.can_pay(effective_cost):\n        # Rollback: move card from stack zone back to hand\n        stack_zone.remove(card)\n        hand.add(card)\n        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n\n    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n    player.mana_pool.pay(effective_cost)\n\n    # Store colors of mana spent on the card for mechanics like Converge\n    # that care about the colors used to cast the spell.\n    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n\n    # Store the amount of mana spent to cast the spell (for mechanics like\n    # Mana Sculpt that add mana equal to what was paid for a countered spell).\n    card.mana_spent = effective_cost.cmc  # type: ignore[attr-defined]\n\n    # 7. Call on_cast hook\n    card.on_cast(game)\n\n    # 8. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n    # Spell-cast triggers (e.g. casualty, prowess) fire after the spell is on\n    # the stack, so their triggered abilities are placed above it and resolve\n    # first.  Firing with no registered spell-cast triggers is a no-op.\n    game.trigger_manager.fire_event(\n        game,\n        SpellCastTriggeredEvent(\n            spell=stack_obj, player=player, card=card, controller=player\n        ),\n    )\n\n\n# ------------------------------------------------------------------\n# Cast spell without paying mana cost (free-cast from any zone)\n# ------------------------------------------------------------------\n\n","numLines":160,"startLine":120,"totalLines":530}}}
