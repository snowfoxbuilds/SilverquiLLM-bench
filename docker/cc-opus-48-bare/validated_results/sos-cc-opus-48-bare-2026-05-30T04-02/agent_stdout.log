{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012ae9ya2iT7iwZ7ftbBJzcy","type":"tool_result","content":"1\t\"\"\"Card implementation for Bushwhack.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\tfrom typing import TYPE_CHECKING, Any\n5\tfrom engine.card import Creature, Instant, Mode, Sorcery\n6\tfrom engine.continuous_effects import (\n7\t    ContinuousEffect,\n8\t    DURATION_END_OF_TURN,\n9\t    Layer,\n10\t    SubLayer,\n11\t)\n12\tfrom engine.types import CardType, Keyword, ManaCost, Zone\n13\tif TYPE_CHECKING:\n14\t    from engine.game_state import GameState\n15\t\n16\t    from cards.registry import CardRegistry\n17\t\n18\tdef _get_controller(card: Any) -> Any:\n19\t    \"\"\"Return the controller of a card, or None.\"\"\"\n20\t    return getattr(card, \"controller\", None)\n21\tdef _get_target(card: Any) -> Any:\n22\t    \"\"\"Return the first chosen target or the _resolve_target fallback.\"\"\"\n23\t    chosen = getattr(card, \"chosen_targets\", None)\n24\t    if chosen:\n25\t        return chosen[0]\n26\t    return getattr(card, \"_resolve_target\", None)\n27\tdef _get_targets(card: Any) -> list[Any]:\n28\t    \"\"\"Return chosen targets list.\"\"\"\n29\t    return getattr(card, \"chosen_targets\", []) or []\n30\t\n31\tclass Bushwhack(Sorcery):\n32\t    \"\"\"Bushwhack — {G} — Choose one.\n33\t\n34\t    - Search your library for a basic land card, reveal it, put it into\n35\t      your hand, then shuffle.\n36\t    - Target creature you control fights target creature you don't control.\n37\t\n38\t    FDN collector number 215.\n39\t    \"\"\"\n40\t\n41\t    def __init__(self, **kwargs: Any) -> None:\n42\t        kwargs.setdefault(\"name\", \"Bushwhack\")\n43\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{G}\"))\n44\t        kwargs.setdefault(\n45\t            \"rules_text\",\n46\t            \"Choose one —\\n\"\n47\t            \"• Search your library for a basic land card, reveal it, put it into your hand, then shuffle.\\n\"\n48\t            \"• Target creature you control fights target creature you don't control.\",\n49\t        )\n50\t        super().__init__(**kwargs)\n51\t        self.chosen_mode: int | None = None\n52\t\n53\t    def get_modes(self) -> list[Mode]:\n54\t        return [\n55\t            Mode(name=\"Land Search\", description=\"Search your library for a basic land card, reveal it, put it into your hand, then shuffle.\"),\n56\t            Mode(name=\"Fight\", description=\"Target creature you control fights target creature you don't control.\"),\n57\t        ]\n58\t\n59\t    def on_resolve(self, game: GameState) -> None:\n60\t        mode = self.chosen_mode\n61\t        if mode is None:\n62\t            return\n63\t        controller = _get_controller(self)\n64\t        if controller is None:\n65\t            return\n66\t        if mode == 0:\n67\t            # Search library for a basic land.\n68\t            from engine.types import Supertype\n69\t            library = controller.zones[Zone.LIBRARY]\n70\t            found = False\n71\t            for card in library.get_all():\n72\t                if (CardType.LAND in getattr(card, \"card_types\", set())\n73\t                        and Supertype.BASIC in getattr(card, \"supertypes\", set())):\n74\t                    library.remove(card)\n75\t                    controller.zones[Zone.HAND].add(card)\n76\t                    found = True\n77\t                    break\n78\t            library.shuffle()\n79\t        elif mode == 1:\n80\t            # Fight\n81\t            from engine.game import deal_damage\n82\t            targets = _get_targets(self)\n83\t            if len(targets) >= 2:\n84\t                a, b = targets[0], targets[1]\n85\t                deal_damage(game, a, b, getattr(a, \"power\", 0))\n86\t                deal_damage(game, b, a, getattr(b, \"power\", 0))\n87\t"}]},"parent_tool_use_id":null,"session_id":"b76fbb6d-7052-44e0-893e-8a2c1cc9d4a6","uuid":"d3a6a541-6084-4ab4-b060-c5b6664f19f2","timestamp":"2026-05-30T04:04:54.851Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_215/card_impl.py","content":"\"\"\"Card implementation for Bushwhack.\"\"\"\n\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import Creature, Instant, Mode, Sorcery\nfrom engine.continuous_effects import (\n    ContinuousEffect,\n    DURATION_END_OF_TURN,\n    Layer,\n    SubLayer,\n)\nfrom engine.types import CardType, Keyword, ManaCost, Zone\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n    from cards.registry import CardRegistry\n\ndef _get_controller(card: Any) -> Any:\n    \"\"\"Return the controller of a card, or None.\"\"\"\n    return getattr(card, \"controller\", None)\ndef _get_target(card: Any) -> Any:\n    \"\"\"Return the first chosen target or the _resolve_target fallback.\"\"\"\n    chosen = getattr(card, \"chosen_targets\", None)\n    if chosen:\n        return chosen[0]\n    return getattr(card, \"_resolve_target\", None)\ndef _get_targets(card: Any) -> list[Any]:\n    \"\"\"Return chosen targets list.\"\"\"\n    return getattr(card, \"chosen_targets\", []) or []\n\nclass Bushwhack(Sorcery):\n    \"\"\"Bushwhack — {G} — Choose one.\n\n    - Search your library for a basic land card, reveal it, put it into\n      your hand, then shuffle.\n    - Target creature you control fights target creature you don't control.\n\n    FDN collector number 215.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"Bushwhack\")\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{G}\"))\n        kwargs.setdefault(\n            \"rules_text\",\n            \"Choose one —\\n\"\n            \"• Search your library for a basic land card, reveal it, put it into your hand, then shuffle.\\n\"\n            \"• Target creature you control fights target creature you don't control.\",\n        )\n        super().__init__(**kwargs)\n        self.chosen_mode: int | None = None\n\n    def get_modes(self) -> list[Mode]:\n        return [\n            Mode(name=\"Land Search\", description=\"Search your library for a basic land card, reveal it, put it into your hand, then shuffle.\"),\n            Mode(name=\"Fight\", description=\"Target creature you control fights target creature you don't control.\"),\n        ]\n\n    def on_resolve(self, game: GameState) -> None:\n        mode = self.chosen_mode\n        if mode is None:\n            return\n        controller = _get_controller(self)\n        if controller is None:\n            return\n        if mode == 0:\n            # Search library for a basic land.\n            from engine.types import Supertype\n            library = controller.zones[Zone.LIBRARY]\n            found = False\n            for card in library.get_all():\n                if (CardType.LAND in getattr(card, \"card_types\", set())\n                        and Supertype.BASIC in getattr(card, \"supertypes\", set())):\n                    library.remove(card)\n                    controller.zones[Zone.HAND].add(card)\n                    found = True\n                    break\n            library.shuffle()\n        elif mode == 1:\n            # Fight\n            from engine.game import deal_damage\n            targets = _get_targets(self)\n            if len(targets) >= 2:\n                a, b = targets[0], targets[1]\n                deal_damage(game, a, b, getattr(a, \"power\", 0))\n                deal_damage(game, b, a, getattr(b, \"power\", 0))\n","numLines":87,"startLine":1,"totalLines":87}}}
