{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017cdSRhbguSChSvwu6C49Lb","type":"tool_result","content":"1\t\"\"\"Typed event objects for triggered abilities and replacement effects.\n2\t\n3\tTriggered events are passed to :meth:`TriggerManager.fire_event` and\n4\tforwarded to trigger condition callables.\n5\t\n6\tReplacement events are passed to :meth:`ReplacementManager.apply` and\n7\tforwarded to replacement condition/replacement callables.  Subclassing\n8\tencodes event-type hierarchy so a replacement registered for a parent\n9\ttype (e.g. ``MoveToGraveyardReplacementEvent``) also fires for\n10\tsubtypes (e.g. ``CreatureDiesReplacementEvent``).\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\tfrom dataclasses import dataclass\n16\tfrom typing import Any\n17\t\n18\t\n19\t# ---------------------------------------------------------------------------\n20\t# Triggered events\n21\t# ---------------------------------------------------------------------------\n22\t\n23\t@dataclass\n24\tclass TriggeredEvent:\n25\t    \"\"\"Base class for all triggered-ability events.\"\"\"\n26\t\n27\t\n28\t@dataclass\n29\tclass EntersBattlefieldTriggeredEvent(TriggeredEvent):\n30\t    permanent: Any = None\n31\t    controller: Any = None\n32\t    card: Any = None\n33\t    creature: Any = None\n34\t\n35\t\n36\t@dataclass\n37\tclass LeavesBattlefieldTriggeredEvent(TriggeredEvent):\n38\t    permanent: Any = None\n39\t    controller: Any = None\n40\t\n41\t\n42\t@dataclass\n43\tclass DealsDamageTriggeredEvent(TriggeredEvent):\n44\t    source: Any = None\n45\t    target: Any = None\n46\t    amount: int = 0\n47\t    is_combat: bool = False\n48\t    combat: bool = False\n49\t\n50\t\n51\t@dataclass\n52\tclass LosesLifeTriggeredEvent(TriggeredEvent):\n53\t    player: Any = None\n54\t    amount: int = 0\n55\t\n56\t\n57\t@dataclass\n58\tclass GainsLifeTriggeredEvent(TriggeredEvent):\n59\t    player: Any = None\n60\t    amount: int = 0\n61\t\n62\t\n63\t@dataclass\n64\tclass DrawsCardTriggeredEvent(TriggeredEvent):\n65\t    player: Any = None\n66\t    card: Any = None\n67\t\n68\t\n69\t@dataclass\n70\tclass BeginningOfUpkeepTriggeredEvent(TriggeredEvent):\n71\t    player: Any = None\n72\t\n73\t\n74\t@dataclass\n75\tclass BeginningOfMainPhaseTriggeredEvent(TriggeredEvent):\n76\t    \"\"\"Fired at the start of a main phase (precombat or postcombat).\n77\t\n78\t    ``player`` is the active player whose main phase is beginning;\n79\t    ``phase`` is the :class:`~engine.types.Phase` (``PRECOMBAT_MAIN`` or\n80\t    ``POSTCOMBAT_MAIN``).  Used by delayed effects such as Mana Sculpt's\n81\t    \"at the beginning of your next main phase\" and Paradigm's recast.\n82\t    \"\"\"\n83\t\n84\t    player: Any = None\n85\t    phase: Any = None\n86\t\n87\t\n88\t@dataclass\n89\tclass BeginningOfCombatTriggeredEvent(TriggeredEvent):\n90\t    pass\n91\t\n92\t\n93\t@dataclass\n94\tclass EndOfTurnTriggeredEvent(TriggeredEvent):\n95\t    pass\n96\t\n97\t\n98\t@dataclass\n99\tclass EndStepTriggeredEvent(TriggeredEvent):\n100\t    player: Any = None\n101\t\n102\t\n103\t@dataclass\n104\tclass CreatureDiesTriggeredEvent(TriggeredEvent):\n105\t    creature: Any = None\n106\t    controller: Any = None\n107\t    owner: Any = None\n108\t\n109\t\n110\t@dataclass\n111\tclass SpellCastTriggeredEvent(TriggeredEvent):\n112\t    spell: Any = None\n113\t    player: Any = None\n114\t    card: Any = None\n115\t    controller: Any = None\n116\t\n117\t\n118\t@dataclass\n119\tclass AttacksTriggeredEvent(TriggeredEvent):\n120\t    creature: Any = None\n121\t    attacker: Any = None\n122\t\n123\t\n124\t@dataclass\n125\tclass BlocksTriggeredEvent(TriggeredEvent):\n126\t    creature: Any = None\n127\t\n128\t\n129\t@dataclass\n130\tclass CounterAddedTriggeredEvent(TriggeredEvent):\n131\t    permanent: Any = None\n132\t    counter_type: Any = None\n133\t    amount: int = 0\n134\t\n135\t\n136\t# ---------------------------------------------------------------------------\n137\t# Replacement events\n138\t# ---------------------------------------------------------------------------\n139\t\n140\t@dataclass\n141\tclass ReplacementEvent:\n142\t    \"\"\"Base class for all replacement-effect events.\"\"\"\n143\t\n144\t\n145\t@dataclass\n146\tclass MoveToGraveyardReplacementEvent(ReplacementEvent):\n147\t    \"\"\"Any permanent moving to a graveyard.\n148\t\n149\t    Subclass this for specific causes (destruction, sacrifice, etc.).\n150\t    A replacement registered for this type also fires for all subtypes.\n151\t\n152\t    ``destination`` may be mutated by a replacement to redirect the\n153\t    permanent to a different zone (``\"exile\"``, ``\"library\"``, ``\"hand\"``).\n154\t    Set ``prevented = True`` to signal that the replacement handled the\n155\t    zone move itself and the engine should skip its own move.\n156\t    \"\"\"\n157\t\n158\t    destination: str = \"graveyard\"\n159\t    controller: Any = None\n160\t    owner: Any = None\n161\t    prevented: bool = False\n162\t\n163\t    @property\n164\t    def card(self) -> Any:\n165\t        \"\"\"The object moving to the graveyard (overridden by subclasses).\"\"\"\n166\t        return None\n167\t\n168\t\n169\t@dataclass\n170\tclass CreatureDiesReplacementEvent(MoveToGraveyardReplacementEvent):\n171\t    \"\"\"A creature going to the graveyard via destruction or lethal damage.\"\"\"\n172\t\n173\t    creature: Any = None\n174\t\n175\t    @property\n176\t    def card(self) -> Any:\n177\t        return self.creature\n178\t\n179\t\n180\t@dataclass\n181\tclass PermanentDestroyedReplacementEvent(MoveToGraveyardReplacementEvent):\n182\t    \"\"\"A non-creature permanent going to the graveyard via destruction.\"\"\"\n183\t\n184\t    permanent: Any = None\n185\t\n186\t    @property\n187\t    def card(self) -> Any:\n188\t        return self.permanent\n189\t\n190\t\n191\t@dataclass\n192\tclass SacrificeReplacementEvent(MoveToGraveyardReplacementEvent):\n193\t    \"\"\"A permanent going to the graveyard via sacrifice.\"\"\"\n194\t\n195\t    permanent: Any = None\n196\t\n197\t    @property\n198\t    def card(self) -> Any:\n199\t        return self.permanent\n200\t\n201\t\n202\t@dataclass\n203\tclass CreateTokenReplacementEvent(ReplacementEvent):\n204\t    \"\"\"An effect about to create one or more tokens.\"\"\"\n205\t\n206\t    player: Any = None\n207\t    count: int = 1\n208\t\n209\t\n210\t@dataclass\n211\tclass AddCounterReplacementEvent(ReplacementEvent):\n212\t    \"\"\"An effect about to add one or more counters to a permanent.\"\"\"\n213\t\n214\t    permanent: Any = None\n215\t    amount: int = 1\n216\t"}]},"parent_tool_use_id":null,"session_id":"b76fbb6d-7052-44e0-893e-8a2c1cc9d4a6","uuid":"c2786a1e-c3e8-4892-8673-1e48f9d434a6","timestamp":"2026-05-30T04:46:20.342Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/events.py","content":"\"\"\"Typed event objects for triggered abilities and replacement effects.\n\nTriggered events are passed to :meth:`TriggerManager.fire_event` and\nforwarded to trigger condition callables.\n\nReplacement events are passed to :meth:`ReplacementManager.apply` and\nforwarded to replacement condition/replacement callables.  Subclassing\nencodes event-type hierarchy so a replacement registered for a parent\ntype (e.g. ``MoveToGraveyardReplacementEvent``) also fires for\nsubtypes (e.g. ``CreatureDiesReplacementEvent``).\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom typing import Any\n\n\n# ---------------------------------------------------------------------------\n# Triggered events\n# ---------------------------------------------------------------------------\n\n@dataclass\nclass TriggeredEvent:\n    \"\"\"Base class for all triggered-ability events.\"\"\"\n\n\n@dataclass\nclass EntersBattlefieldTriggeredEvent(TriggeredEvent):\n    permanent: Any = None\n    controller: Any = None\n    card: Any = None\n    creature: Any = None\n\n\n@dataclass\nclass LeavesBattlefieldTriggeredEvent(TriggeredEvent):\n    permanent: Any = None\n    controller: Any = None\n\n\n@dataclass\nclass DealsDamageTriggeredEvent(TriggeredEvent):\n    source: Any = None\n    target: Any = None\n    amount: int = 0\n    is_combat: bool = False\n    combat: bool = False\n\n\n@dataclass\nclass LosesLifeTriggeredEvent(TriggeredEvent):\n    player: Any = None\n    amount: int = 0\n\n\n@dataclass\nclass GainsLifeTriggeredEvent(TriggeredEvent):\n    player: Any = None\n    amount: int = 0\n\n\n@dataclass\nclass DrawsCardTriggeredEvent(TriggeredEvent):\n    player: Any = None\n    card: Any = None\n\n\n@dataclass\nclass BeginningOfUpkeepTriggeredEvent(TriggeredEvent):\n    player: Any = None\n\n\n@dataclass\nclass BeginningOfMainPhaseTriggeredEvent(TriggeredEvent):\n    \"\"\"Fired at the start of a main phase (precombat or postcombat).\n\n    ``player`` is the active player whose main phase is beginning;\n    ``phase`` is the :class:`~engine.types.Phase` (``PRECOMBAT_MAIN`` or\n    ``POSTCOMBAT_MAIN``).  Used by delayed effects such as Mana Sculpt's\n    \"at the beginning of your next main phase\" and Paradigm's recast.\n    \"\"\"\n\n    player: Any = None\n    phase: Any = None\n\n\n@dataclass\nclass BeginningOfCombatTriggeredEvent(TriggeredEvent):\n    pass\n\n\n@dataclass\nclass EndOfTurnTriggeredEvent(TriggeredEvent):\n    pass\n\n\n@dataclass\nclass EndStepTriggeredEvent(TriggeredEvent):\n    player: Any = None\n\n\n@dataclass\nclass CreatureDiesTriggeredEvent(TriggeredEvent):\n    creature: Any = None\n    controller: Any = None\n    owner: Any = None\n\n\n@dataclass\nclass SpellCastTriggeredEvent(TriggeredEvent):\n    spell: Any = None\n    player: Any = None\n    card: Any = None\n    controller: Any = None\n\n\n@dataclass\nclass AttacksTriggeredEvent(TriggeredEvent):\n    creature: Any = None\n    attacker: Any = None\n\n\n@dataclass\nclass BlocksTriggeredEvent(TriggeredEvent):\n    creature: Any = None\n\n\n@dataclass\nclass CounterAddedTriggeredEvent(TriggeredEvent):\n    permanent: Any = None\n    counter_type: Any = None\n    amount: int = 0\n\n\n# ---------------------------------------------------------------------------\n# Replacement events\n# ---------------------------------------------------------------------------\n\n@dataclass\nclass ReplacementEvent:\n    \"\"\"Base class for all replacement-effect events.\"\"\"\n\n\n@dataclass\nclass MoveToGraveyardReplacementEvent(ReplacementEvent):\n    \"\"\"Any permanent moving to a graveyard.\n\n    Subclass this for specific causes (destruction, sacrifice, etc.).\n    A replacement registered for this type also fires for all subtypes.\n\n    ``destination`` may be mutated by a replacement to redirect the\n    permanent to a different zone (``\"exile\"``, ``\"library\"``, ``\"hand\"``).\n    Set ``prevented = True`` to signal that the replacement handled the\n    zone move itself and the engine should skip its own move.\n    \"\"\"\n\n    destination: str = \"graveyard\"\n    controller: Any = None\n    owner: Any = None\n    prevented: bool = False\n\n    @property\n    def card(self) -> Any:\n        \"\"\"The object moving to the graveyard (overridden by subclasses).\"\"\"\n        return None\n\n\n@dataclass\nclass CreatureDiesReplacementEvent(MoveToGraveyardReplacementEvent):\n    \"\"\"A creature going to the graveyard via destruction or lethal damage.\"\"\"\n\n    creature: Any = None\n\n    @property\n    def card(self) -> Any:\n        return self.creature\n\n\n@dataclass\nclass PermanentDestroyedReplacementEvent(MoveToGraveyardReplacementEvent):\n    \"\"\"A non-creature permanent going to the graveyard via destruction.\"\"\"\n\n    permanent: Any = None\n\n    @property\n    def card(self) -> Any:\n        return self.permanent\n\n\n@dataclass\nclass SacrificeReplacementEvent(MoveToGraveyardReplacementEvent):\n    \"\"\"A permanent going to the graveyard via sacrifice.\"\"\"\n\n    permanent: Any = None\n\n    @property\n    def card(self) -> Any:\n        return self.permanent\n\n\n@dataclass\nclass CreateTokenReplacementEvent(ReplacementEvent):\n    \"\"\"An effect about to create one or more tokens.\"\"\"\n\n    player: Any = None\n    count: int = 1\n\n\n@dataclass\nclass AddCounterReplacementEvent(ReplacementEvent):\n    \"\"\"An effect about to add one or more counters to a permanent.\"\"\"\n\n    permanent: Any = None\n    amount: int = 1\n","numLines":216,"startLine":1,"totalLines":216}}}
