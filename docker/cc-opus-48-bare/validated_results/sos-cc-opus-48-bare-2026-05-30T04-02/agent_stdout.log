{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WZYMvdVqNoz88atrLVuSDV","type":"tool_result","content":"1\t\"\"\"Tests for cast_spell_free — casting without paying mana costs via the stack.\n2\t\n3\tVerifies:\n4\t- cast_spell_free places the spell on the stack (not directly resolving it)\n5\t- The spell can be countered while on the stack\n6\t- On resolution, permanents go to battlefield, non-permanents to graveyard\n7\t- No mana payment is required\n8\t- The card's source zone (e.g., exile) is handled correctly\n9\t- on_resolve is called only when the spell actually resolves from the stack\n10\t\"\"\"\n11\t\n12\tfrom __future__ import annotations\n13\t\n14\timport pytest\n15\t\n16\tfrom engine.card import (\n17\t    Creature,\n18\t    Instant,\n19\t    Sorcery,\n20\t)\n21\tfrom engine.casting import cast_spell_free\n22\tfrom engine.game_state import GameState\n23\tfrom engine.player import DeterministicPlayer\n24\tfrom engine.stack import StackObject\n25\tfrom engine.types import CardType, ManaCost, ManaType, Phase, Zone\n26\t\n27\t\n28\t# ---------------------------------------------------------------------------\n29\t# Helpers\n30\t# ---------------------------------------------------------------------------\n31\t\n32\tdef _make_game(\n33\t    *,\n34\t    p1_script: list | None = None,\n35\t    p2_script: list | None = None,\n36\t    phase: Phase = Phase.PRECOMBAT_MAIN,\n37\t) -> GameState:\n38\t    \"\"\"Create a minimal 2-player GameState at the specified phase.\"\"\"\n39\t    p1 = DeterministicPlayer(\"Alice\", p1_script or [])\n40\t    p2 = DeterministicPlayer(\"Bob\", p2_script or [])\n41\t    game = GameState([p1, p2])\n42\t    game.phase = phase\n43\t    return game\n44\t\n45\t\n46\tdef _put_in_exile(game: GameState, player_idx: int, card) -> None:\n47\t    \"\"\"Place a card in the player's exile zone.\"\"\"\n48\t    player = game.players[player_idx]\n49\t    player.zones[Zone.EXILE].add(card)\n50\t\n51\t\n52\t# ---------------------------------------------------------------------------\n53\t# Tests: cast_spell_free puts spell on the stack\n54\t# ---------------------------------------------------------------------------\n55\t\n56\tclass TestCastSpellFreePutsOnStack:\n57\t    \"\"\"cast_spell_free must place the spell on the stack, not resolve immediately.\"\"\"\n58\t\n59\t    def test_creature_goes_on_stack(self):\n60\t        \"\"\"A creature cast for free should appear on the stack.\"\"\"\n61\t        game = _make_game()\n62\t        player = game.players[0]\n63\t        bear = Creature(\n64\t            name=\"Grizzly Bears\",\n65\t            mana_cost=ManaCost(generic=1, pips={ManaType.GREEN: 1}),\n66\t            base_power=2, base_toughness=2,\n67\t        )\n68\t        _put_in_exile(game, 0, bear)\n69\t\n70\t        cast_spell_free(game, player, bear, from_zone=Zone.EXILE)\n71\t\n72\t        assert not game.stack.is_empty()\n73\t        top = game.stack.peek()\n74\t        assert top is not None\n75\t        assert top.source is bear\n76\t        assert top.controller is player\n77\t\n78\t    def test_sorcery_goes_on_stack(self):\n79\t        \"\"\"A sorcery cast for free should appear on the stack.\"\"\"\n80\t        game = _make_game()\n81\t        player = game.players[0]\n82\t        spell = Sorcery(\n83\t            name=\"Divination\",\n84\t            mana_cost=ManaCost(generic=2, pips={ManaType.BLUE: 1}),\n85\t        )\n86\t        _put_in_exile(game, 0, spell)\n87\t\n88\t        cast_spell_free(game, player, spell, from_zone=Zone.EXILE)\n89\t\n90\t        assert not game.stack.is_empty()\n91\t        top = game.stack.peek()\n92\t        assert top.source is spell\n93\t\n94\t    def test_instant_goes_on_stack(self):\n95\t        \"\"\"An instant cast for free should appear on the stack.\"\"\"\n96\t        game = _make_game()\n97\t        player = game.players[0]\n98\t        bolt = Instant(\n99\t            name=\"Lightning Bolt\",\n100\t            mana_cost=ManaCost(pips={ManaType.RED: 1}),\n101\t        )\n102\t        _put_in_exile(game, 0, bolt)\n103\t\n104\t        cast_spell_free(game, player, bolt, from_zone=Zone.EXILE)\n105\t\n106\t        assert not game.stack.is_empty()\n107\t        top = game.stack.peek()\n108\t        assert top.source is bolt\n109\t\n110\t\n111\t# ---------------------------------------------------------------------------\n112\t# Tests: No mana required\n113\t# ---------------------------------------------------------------------------\n114\t\n115\tclass TestCastSpellFreeNoManaRequired:\n116\t    \"\"\"cast_spell_free should not require or consume mana.\"\"\"\n117\t\n118\t    def test_expensive_creature_cast_with_empty_mana_pool(self):\n119\t        \"\"\"A 6-mana creature can be cast for free with zero mana available.\"\"\"\n120\t        game = _make_game()\n121\t        player = game.players[0]\n122\t        # Player has no mana in pool\n123\t        big_creature = Creature(\n124\t            name=\"Colossal Dreadmaw\",\n125\t            mana_cost=ManaCost(generic=4, pips={ManaType.GREEN: 2}),\n126\t            base_power=6, base_toughness=6,\n127\t        )\n128\t        _put_in_exile(game, 0, big_creature)\n129\t\n130\t        # Should not raise — no mana needed\n131\t        cast_spell_free(game, player, big_creature, from_zone=Zone.EXILE)\n132\t\n133\t        assert not game.stack.is_empty()\n134\t        assert game.stack.peek().source is big_creature\n135\t\n136\t\n137\t# ---------------------------------------------------------------------------\n138\t# Tests: Resolution behavior\n139\t# ---------------------------------------------------------------------------\n140\t\n141\tclass TestCastSpellFreeResolution:\n142\t    \"\"\"When the stack object resolves, it should behave like a normal spell.\"\"\"\n143\t\n144\t    def test_creature_resolves_to_battlefield(self):\n145\t        \"\"\"A creature that resolves from cast_spell_free goes to battlefield.\"\"\"\n146\t        game = _make_game()\n147\t        player = game.players[0]\n148\t        bear = Creature(\n149\t            name=\"Grizzly Bears\",\n150\t            mana_cost=ManaCost(generic=1, pips={ManaType.GREEN: 1}),\n151\t            base_power=2, base_toughness=2,\n152\t        )\n153\t        _put_in_exile(game, 0, bear)\n154\t\n155\t        cast_spell_free(game, player, bear, from_zone=Zone.EXILE)\n156\t        obj = game.stack.pop()\n157\t        obj.on_resolve(game)\n158\t\n159\t        assert game.get_battlefield(player).contains(bear)\n160\t\n161\t    def test_sorcery_resolves_to_graveyard(self):\n162\t        \"\"\"A sorcery that resolves from cast_spell_free goes to graveyard.\"\"\"\n163\t        game = _make_game()\n164\t        player = game.players[0]\n165\t        spell = Sorcery(\n166\t            name=\"Lava Axe\",\n167\t            mana_cost=ManaCost(generic=4, pips={ManaType.RED: 1}),\n168\t        )\n169\t        _put_in_exile(game, 0, spell)\n170\t\n171\t        cast_spell_free(game, player, spell, from_zone=Zone.EXILE)\n172\t        obj = game.stack.pop()\n173\t        obj.on_resolve(game)\n174\t\n175\t        assert game.get_graveyard(player).contains(spell)\n176\t\n177\t    def test_on_resolve_hook_called(self):\n178\t        \"\"\"The card's on_resolve method should be called during resolution.\"\"\"\n179\t        game = _make_game()\n180\t        player = game.players[0]\n181\t        resolved_flag = []\n182\t\n183\t        class TrackerSorcery(Sorcery):\n184\t            def on_resolve(self, game):\n185\t                resolved_flag.append(True)\n186\t\n187\t        spell = TrackerSorcery(\n188\t            name=\"Tracker\",\n189\t            mana_cost=ManaCost(pips={ManaType.BLUE: 1}),\n190\t        )\n191\t        _put_in_exile(game, 0, spell)\n192\t\n193\t        cast_spell_free(game, player, spell, from_zone=Zone.EXILE)\n194\t\n195\t        # on_resolve should NOT have been called yet (spell is on stack)\n196\t        assert resolved_flag == []\n197\t\n198\t        obj = game.stack.pop()\n199\t        obj.on_resolve(game)\n200\t\n201\t        # Now on_resolve should have been called\n202\t        assert resolved_flag == [True]\n203\t\n204\t\n205\t# ---------------------------------------------------------------------------\n206\t# Tests: Counterspell interaction (the key requirement)\n207\t# ---------------------------------------------------------------------------\n208\t\n209\tclass TestCastSpellFreeCounterable:\n210\t    \"\"\"A spell cast via cast_spell_free must be counterable on the stack.\n211\t\n212\t    This is the primary requirement from the TODO: the spell goes through\n213\t    the stack so effects like Counterspell can target it.\n214\t    \"\"\"\n215\t\n216\t    def test_spell_is_on_stack_and_can_be_removed_before_resolving(self):\n217\t        \"\"\"Simulates countering: pop the spell off the stack without resolving.\n218\t\n219\t        If the spell bypassed the stack (old behavior), it would never be\n220\t        visible on the stack and could not be interacted with.\n221\t        \"\"\"\n222\t        game = _make_game()\n223\t        player = game.players[0]\n224\t        spell = Sorcery(\n225\t            name=\"Explosive Vegetation\",\n226\t            mana_cost=ManaCost(generic=3, pips={ManaType.GREEN: 1}),\n227\t        )\n228\t        _put_in_exile(game, 0, spell)\n229\t\n230\t        cast_spell_free(game, player, spell, from_zone=Zone.EXILE)\n231\t\n232\t        # The spell is on the stack — an opponent could counter it\n233\t        assert not game.stack.is_empty()\n234\t        stack_obj = game.stack.peek()\n235\t        assert stack_obj.source is spell\n236\t\n237\t        # Simulate counter: remove from stack, move to graveyard\n238\t        countered_obj = game.stack.pop()\n239\t        assert countered_obj.source is spell\n240\t        # After countering, the spell should NOT be on the battlefield\n241\t        assert not game.get_battlefield(player).contains(spell)\n242\t\n243\t    def test_multiple_free_casts_all_go_on_stack(self):\n244\t        \"\"\"When multiple spells are cast for free, all should be on the stack.\n245\t\n246\t        This allows an opponent to counter any of them individually.\n247\t        \"\"\"\n248\t        game = _make_game()\n249\t        player = game.players[0]\n250\t        spell_a = Sorcery(name=\"Spell A\", mana_cost=ManaCost(generic=1))\n251\t        spell_b = Creature(\n252\t            name=\"Spell B\",\n253\t            mana_cost=ManaCost(generic=2),\n254\t            base_power=2, base_toughness=2,\n255\t        )\n256\t        _put_in_exile(game, 0, spell_a)\n257\t        _put_in_exile(game, 0, spell_b)\n258\t\n259\t        cast_spell_free(game, player, spell_a, from_zone=Zone.EXILE)\n260\t        cast_spell_free(game, player, spell_b, from_zone=Zone.EXILE)\n261\t\n262\t        assert len(game.stack) == 2\n263\t\n264\t    def test_countered_spell_does_not_resolve(self):\n265\t        \"\"\"A spell removed from the stack (countered) should not call on_resolve.\"\"\"\n266\t        game = _make_game()\n267\t        player = game.players[0]\n268\t        resolved_flag = []\n269\t\n270\t        class TrackerCreature(Creature):\n271\t            def on_resolve(self, game):\n272\t                resolved_flag.append(True)\n273\t\n274\t        critter = TrackerCreature(\n275\t            name=\"Tracker Beast\",\n276\t            mana_cost=ManaCost(generic=3, pips={ManaType.GREEN: 1}),\n277\t            base_power=4, base_toughness=4,\n278\t        )\n279\t        _put_in_exile(game, 0, critter)\n280\t\n281\t        cast_spell_free(game, player, critter, from_zone=Zone.EXILE)\n282\t\n283\t        # Counter it — just pop without calling on_resolve\n284\t        game.stack.pop()\n285\t\n286\t        assert resolved_flag == []\n287\t        assert not game.get_battlefield(player).contains(critter)\n288\t\n289\t\n290\t# ---------------------------------------------------------------------------\n291\t# Tests: Real counterspell integration\n292\t# ---------------------------------------------------------------------------\n293\t\n294\tclass TestCastSpellFreeCounteredByRealCounter:\n295\t    \"\"\"Integration tests using the engine's _counter_spell mechanic.\n296\t\n297\t    These prove that a Counterspell-style effect can properly target and\n298\t    counter a spell placed on the stack via cast_spell_free.\n299\t    \"\"\"\n300\t\n301\t    def test_counter_spell_removes_free_cast_from_stack_to_graveyard(self):\n302\t        \"\"\"_counter_spell targeting a free-cast spell removes it and moves card to graveyard.\"\"\"\n303\t        from cards.fdn.fdn_160.card_impl import _counter_spell\n304\t\n305\t        game = _make_game()\n306\t        player = game.players[0]\n307\t        spell = Sorcery(\n308\t            name=\"Explosive Vegetation\",\n309\t            mana_cost=ManaCost(generic=3, pips={ManaType.GREEN: 1}),\n310\t        )\n311\t        spell.owner = player\n312\t        _put_in_exile(game, 0, spell)\n313\t\n314\t        cast_spell_free(game, player, spell, from_zone=Zone.EXILE)\n315\t\n316\t        # The spell is on the stack\n317\t        assert not game.stack.is_empty()\n318\t        stack_obj = game.stack.peek()\n319\t        assert stack_obj.source is spell\n320\t\n321\t        # Use the real _counter_spell function to counter it\n322\t        _counter_spell(game, stack_obj)\n323\t\n324\t        # After countering: stack is empty, spell is in owner's graveyard\n325\t        assert game.stack.is_empty()\n326\t        assert game.get_graveyard(player).contains(spell)\n327\t        assert not game.get_battlefield(player).contains(spell)\n328\t\n329\t    def test_counter_spell_prevents_on_resolve_from_firing(self):\n330\t        \"\"\"A countered free-cast spell's on_resolve never executes.\"\"\"\n331\t        from cards.fdn.fdn_160.card_impl import _counter_spell\n332\t\n333\t        game = _make_game()\n334\t        player = game.players[0]\n335\t        resolved_flag = []\n336\t\n337\t        class TrackerSorcery(Sorcery):\n338\t            def on_resolve(self, game):\n339\t                resolved_flag.append(True)\n340\t\n341\t        spell = TrackerSorcery(\n342\t            name=\"Tracked Spell\",\n343\t            mana_cost=ManaCost(generic=2, pips={ManaType.BLUE: 1}),\n344\t        )\n345\t        spell.owner = player\n346\t        _put_in_exile(game, 0, spell)\n347\t\n348\t        cast_spell_free(game, player, spell, from_zone=Zone.EXILE)\n349\t        stack_obj = game.stack.peek()\n350\t\n351\t        # Counter it using the real counter mechanic\n352\t        _counter_spell(game, stack_obj)\n353\t\n354\t        # on_resolve should never have been called\n355\t        assert resolved_flag == []\n356\t\n357\t    def test_counter_creature_free_cast_prevents_battlefield_entry(self):\n358\t        \"\"\"A creature countered after cast_spell_free never enters the battlefield.\"\"\"\n359\t        from cards.fdn.fdn_160.card_impl import _counter_spell\n360\t\n361\t        game = _make_game()\n362\t        player = game.players[0]\n363\t        creature = Creature(\n364\t            name=\"Colossal Dreadmaw\",\n365\t            mana_cost=ManaCost(generic=4, pips={ManaType.GREEN: 2}),\n366\t            base_power=6, base_toughness=6,\n367\t        )\n368\t        creature.owner = player\n369\t        _put_in_exile(game, 0, creature)\n370\t\n371\t        cast_spell_free(game, player, creature, from_zone=Zone.EXILE)\n372\t        stack_obj = game.stack.peek()\n373\t\n374\t        _counter_spell(game, stack_obj)\n375\t\n376\t        # Creature should be in graveyard, not battlefield\n377\t        assert game.stack.is_empty()\n378\t        assert game.get_graveyard(player).contains(creature)\n379\t        assert not game.get_battlefield(player).contains(creature)\n380\t\n381\t    def test_counter_targets_specific_spell_among_multiple_on_stack(self):\n382\t        \"\"\"When multiple free-cast spells are on the stack, counter targets only one.\"\"\"\n383\t        from cards.fdn.fdn_160.card_impl import _counter_spell\n384\t\n385\t        game = _make_game()\n386\t        player = game.players[0]\n387\t\n388\t        spell_a = Sorcery(name=\"Spell A\", mana_cost=ManaCost(generic=1))\n389\t        spell_a.owner = player\n390\t        spell_b = Sorcery(name=\"Spell B\", mana_cost=ManaCost(generic=2))\n391\t        spell_b.owner = player\n392\t\n393\t        _put_in_exile(game, 0, spell_a)\n394\t        _put_in_exile(game, 0, spell_b)\n395\t\n396\t        cast_spell_free(game, player, spell_a, from_zone=Zone.EXILE)\n397\t        cast_spell_free(game, player, spell_b, from_zone=Zone.EXILE)\n398\t\n399\t        assert len(game.stack) == 2\n400\t\n401\t        # Counter only spell_a (the bottom spell)\n402\t        # Find its stack object\n403\t        all_objs = game.stack.objects()\n404\t        spell_a_obj = next(obj for obj in all_objs if obj.source is spell_a)\n405\t\n406\t        _counter_spell(game, spell_a_obj)\n407\t\n408\t        # Only spell_a countered; spell_b remains on stack\n409\t        assert len(game.stack) == 1\n410\t        assert game.stack.peek().source is spell_b\n411\t        assert game.get_graveyard(player).contains(spell_a)\n412\t        assert not game.get_graveyard(player).contains(spell_b)\n413\t"}]},"parent_tool_use_id":"toolu_01X6Ryuijvq29Av9gGTdruzn","session_id":"b76fbb6d-7052-44e0-893e-8a2c1cc9d4a6","uuid":"1041b6ae-7391-49e0-81fd-0c4f18a50d79","timestamp":"2026-05-30T04:55:05.577Z","subagent_type":"Explore","task_description":"Research token creation and ETB triggers"}
