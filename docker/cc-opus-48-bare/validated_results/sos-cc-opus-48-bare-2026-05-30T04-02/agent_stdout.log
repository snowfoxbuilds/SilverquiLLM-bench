{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0115uZZ5FejtSXTuyKL7FLz9","type":"tool_result","content":"1\t\"\"\"Card implementation for Mana Sculpt.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Instant\n8\tfrom engine.types import ManaCost, ManaType, TargetRequirement, Zone\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t\n13\t\n14\tdef _get_chosen_target(card: Any, game: Any) -> Any:\n15\t    \"\"\"Retrieve the first chosen target for a spell.\"\"\"\n16\t    chosen = getattr(card, \"chosen_targets\", None)\n17\t    if chosen:\n18\t        return chosen[0]\n19\t    return getattr(card, \"_resolve_target\", None)\n20\t\n21\t\n22\tdef _counter_spell(game: \"GameState\", stack_obj: Any) -> None:\n23\t    \"\"\"Counter a spell — remove from stack and move its card to the graveyard.\"\"\"\n24\t    from engine.stack import StackObject\n25\t\n26\t    if not isinstance(stack_obj, StackObject):\n27\t        return\n28\t\n29\t    if not game.stack.remove(stack_obj):\n30\t        return\n31\t\n32\t    card = stack_obj.source\n33\t    controller = stack_obj.controller\n34\t    owner = getattr(card, \"owner\", controller)\n35\t\n36\t    if controller is not None:\n37\t        stack_zone = controller.zones[Zone.STACK]\n38\t        if stack_zone.contains(card):\n39\t            stack_zone.remove(card)\n40\t\n41\t    if owner is not None:\n42\t        owner.zones[Zone.GRAVEYARD].add(card)\n43\t\n44\t\n45\tdef _controls_wizard(player: Any) -> bool:\n46\t    \"\"\"Return True if *player* controls a creature with the Wizard subtype.\"\"\"\n47\t    from engine.types import CardType\n48\t\n49\t    for obj in player.zones[Zone.BATTLEFIELD].get_all():\n50\t        types = getattr(obj, \"card_types\", set())\n51\t        if CardType.CREATURE in types and \"Wizard\" in getattr(obj, \"subtypes\", set()):\n52\t            return True\n53\t    return False\n54\t\n55\t\n56\tdef _spell_mana_spent(card: Any) -> int:\n57\t    \"\"\"Return the amount of mana spent to cast *card* (falls back to CMC).\"\"\"\n58\t    spent = getattr(card, \"mana_spent\", None)\n59\t    if spent is not None:\n60\t        return int(spent)\n61\t    cost = getattr(card, \"mana_cost\", None)\n62\t    return cost.cmc if cost is not None else 0\n63\t\n64\t\n65\tdef _register_delayed_mana(game: \"GameState\", controller: Any, amount: int) -> None:\n66\t    \"\"\"Register a one-shot trigger to add {C} at the controller's next main phase.\"\"\"\n67\t    from engine.events import BeginningOfMainPhaseTriggeredEvent\n68\t    from engine.triggers import TriggerRegistration\n69\t\n70\t    sentinel = object()  # unique source so we can unregister exactly this trigger\n71\t\n72\t    def _condition(game: Any, event: Any) -> bool:\n73\t        return getattr(event, \"player\", None) is controller\n74\t\n75\t    def _effect(game: \"GameState\") -> None:\n76\t        controller.mana_pool.add(ManaType.COLORLESS, amount)\n77\t        game.trigger_manager.unregister(sentinel)\n78\t\n79\t    game.trigger_manager.register(\n80\t        TriggerRegistration(\n81\t            event_type=BeginningOfMainPhaseTriggeredEvent,\n82\t            condition=_condition,\n83\t            effect=_effect,\n84\t            source=sentinel,\n85\t            controller=controller,\n86\t        )\n87\t    )\n88\t\n89\t\n90\tclass ManaSculpt(Instant):\n91\t    \"\"\"Mana Sculpt — {1}{U}{U} — Instant.\n92\t\n93\t    Counter target spell.  If you control a Wizard, add an amount of {C}\n94\t    equal to the amount of mana spent to cast that spell at the beginning\n95\t    of your next main phase.\n96\t    \"\"\"\n97\t\n98\t    def __init__(self, **kwargs: Any) -> None:\n99\t        kwargs.setdefault(\"name\", \"Mana Sculpt\")\n100\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{U}{U}\"))\n101\t        kwargs.setdefault(\n102\t            \"rules_text\",\n103\t            \"Counter target spell. If you control a Wizard, add an amount \"\n104\t            \"of {C} equal to the amount of mana spent to cast that spell at \"\n105\t            \"the beginning of your next main phase.\",\n106\t        )\n107\t        super().__init__(**kwargs)\n108\t        self.colors = [\"U\"]\n109\t\n110\t    def can_cast(self, game: \"GameState\") -> bool:\n111\t        \"\"\"Cannot cast unless there's a spell on the stack to counter.\"\"\"\n112\t        for stack_obj in game.stack.objects():\n113\t            if stack_obj.source is self:\n114\t                continue\n115\t            if getattr(stack_obj, \"is_spell\", True):\n116\t                return True\n117\t        return False\n118\t\n119\t    def get_targets(self, game: \"GameState\") -> list[Any]:\n120\t        \"\"\"Target a spell on the stack.\"\"\"\n121\t        targets = [\n122\t            stack_obj\n123\t            for stack_obj in game.stack.objects()\n124\t            if stack_obj.source is not self and getattr(stack_obj, \"is_spell\", True)\n125\t        ]\n126\t        if not targets:\n127\t            return []\n128\t        return [\n129\t            TargetRequirement(\n130\t                filter_fn=lambda obj: obj is not self\n131\t                and getattr(obj, \"is_spell\", True),\n132\t                description=\"target spell\",\n133\t                zone=Zone.STACK,\n134\t            )\n135\t        ]\n136\t\n137\t    def on_resolve(self, game: \"GameState\") -> None:\n138\t        \"\"\"Counter the target spell and, with a Wizard, set up delayed mana.\"\"\"\n139\t        target = _get_chosen_target(self, game)\n140\t        if target is None:\n141\t            return\n142\t\n143\t        mana_spent = _spell_mana_spent(getattr(target, \"source\", None))\n144\t        _counter_spell(game, target)\n145\t\n146\t        controller = self.controller\n147\t        if controller is None:\n148\t            return\n149\t        if _controls_wizard(controller) and mana_spent > 0:\n150\t            _register_delayed_mana(game, controller, mana_spent)\n151\t"}]},"parent_tool_use_id":null,"session_id":"b76fbb6d-7052-44e0-893e-8a2c1cc9d4a6","uuid":"473e80ef-e379-44d8-96a7-e56f650004fc","timestamp":"2026-05-30T05:06:12.313Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/sos/sos_57/card_impl.py","content":"\"\"\"Card implementation for Mana Sculpt.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import Instant\nfrom engine.types import ManaCost, ManaType, TargetRequirement, Zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\ndef _get_chosen_target(card: Any, game: Any) -> Any:\n    \"\"\"Retrieve the first chosen target for a spell.\"\"\"\n    chosen = getattr(card, \"chosen_targets\", None)\n    if chosen:\n        return chosen[0]\n    return getattr(card, \"_resolve_target\", None)\n\n\ndef _counter_spell(game: \"GameState\", stack_obj: Any) -> None:\n    \"\"\"Counter a spell — remove from stack and move its card to the graveyard.\"\"\"\n    from engine.stack import StackObject\n\n    if not isinstance(stack_obj, StackObject):\n        return\n\n    if not game.stack.remove(stack_obj):\n        return\n\n    card = stack_obj.source\n    controller = stack_obj.controller\n    owner = getattr(card, \"owner\", controller)\n\n    if controller is not None:\n        stack_zone = controller.zones[Zone.STACK]\n        if stack_zone.contains(card):\n            stack_zone.remove(card)\n\n    if owner is not None:\n        owner.zones[Zone.GRAVEYARD].add(card)\n\n\ndef _controls_wizard(player: Any) -> bool:\n    \"\"\"Return True if *player* controls a creature with the Wizard subtype.\"\"\"\n    from engine.types import CardType\n\n    for obj in player.zones[Zone.BATTLEFIELD].get_all():\n        types = getattr(obj, \"card_types\", set())\n        if CardType.CREATURE in types and \"Wizard\" in getattr(obj, \"subtypes\", set()):\n            return True\n    return False\n\n\ndef _spell_mana_spent(card: Any) -> int:\n    \"\"\"Return the amount of mana spent to cast *card* (falls back to CMC).\"\"\"\n    spent = getattr(card, \"mana_spent\", None)\n    if spent is not None:\n        return int(spent)\n    cost = getattr(card, \"mana_cost\", None)\n    return cost.cmc if cost is not None else 0\n\n\ndef _register_delayed_mana(game: \"GameState\", controller: Any, amount: int) -> None:\n    \"\"\"Register a one-shot trigger to add {C} at the controller's next main phase.\"\"\"\n    from engine.events import BeginningOfMainPhaseTriggeredEvent\n    from engine.triggers import TriggerRegistration\n\n    sentinel = object()  # unique source so we can unregister exactly this trigger\n\n    def _condition(game: Any, event: Any) -> bool:\n        return getattr(event, \"player\", None) is controller\n\n    def _effect(game: \"GameState\") -> None:\n        controller.mana_pool.add(ManaType.COLORLESS, amount)\n        game.trigger_manager.unregister(sentinel)\n\n    game.trigger_manager.register(\n        TriggerRegistration(\n            event_type=BeginningOfMainPhaseTriggeredEvent,\n            condition=_condition,\n            effect=_effect,\n            source=sentinel,\n            controller=controller,\n        )\n    )\n\n\nclass ManaSculpt(Instant):\n    \"\"\"Mana Sculpt — {1}{U}{U} — Instant.\n\n    Counter target spell.  If you control a Wizard, add an amount of {C}\n    equal to the amount of mana spent to cast that spell at the beginning\n    of your next main phase.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"Mana Sculpt\")\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{U}{U}\"))\n        kwargs.setdefault(\n            \"rules_text\",\n            \"Counter target spell. If you control a Wizard, add an amount \"\n            \"of {C} equal to the amount of mana spent to cast that spell at \"\n            \"the beginning of your next main phase.\",\n        )\n        super().__init__(**kwargs)\n        self.colors = [\"U\"]\n\n    def can_cast(self, game: \"GameState\") -> bool:\n        \"\"\"Cannot cast unless there's a spell on the stack to counter.\"\"\"\n        for stack_obj in game.stack.objects():\n            if stack_obj.source is self:\n                continue\n            if getattr(stack_obj, \"is_spell\", True):\n                return True\n        return False\n\n    def get_targets(self, game: \"GameState\") -> list[Any]:\n        \"\"\"Target a spell on the stack.\"\"\"\n        targets = [\n            stack_obj\n            for stack_obj in game.stack.objects()\n            if stack_obj.source is not self and getattr(stack_obj, \"is_spell\", True)\n        ]\n        if not targets:\n            return []\n        return [\n            TargetRequirement(\n                filter_fn=lambda obj: obj is not self\n                and getattr(obj, \"is_spell\", True),\n                description=\"target spell\",\n                zone=Zone.STACK,\n            )\n        ]\n\n    def on_resolve(self, game: \"GameState\") -> None:\n        \"\"\"Counter the target spell and, with a Wizard, set up delayed mana.\"\"\"\n        target = _get_chosen_target(self, game)\n        if target is None:\n            return\n\n        mana_spent = _spell_mana_spent(getattr(target, \"source\", None))\n        _counter_spell(game, target)\n\n        controller = self.controller\n        if controller is None:\n            return\n        if _controls_wizard(controller) and mana_spent > 0:\n            _register_delayed_mana(game, controller, mana_spent)\n","numLines":151,"startLine":1,"totalLines":151}}}
