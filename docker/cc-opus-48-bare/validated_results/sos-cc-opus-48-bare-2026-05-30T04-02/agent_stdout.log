{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RxkKf3rZc8Hrfx8M2cnvHh","type":"tool_result","content":"1\t\"\"\"Casting and resolution pipeline for spells and lands.\n2\t\n3\tProvides the full flow from casting a spell or playing a land through\n4\tresolution:\n5\t\n6\t- :func:`cast_spell` — verify timing & legality → move hand to stack →\n7\t  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n8\t- :func:`play_land` — verify land play remaining → move hand to\n9\t  battlefield → decrement ``land_plays_remaining``.\n10\t- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n11\t  helpers used by the casting pipeline.\n12\t\n13\tResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\n14\tcreated by :func:`cast_spell`:\n15\t\n16\t- Call ``card.on_resolve(game)``.\n17\t- Permanents (creature / enchantment / artifact / planeswalker) move from\n18\t  the stack to the battlefield.\n19\t- Non-permanents (instant / sorcery) move to the graveyard.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import TYPE_CHECKING, Any\n25\t\n26\tfrom engine.card import CardImpl\n27\tfrom engine.events import SpellCastTriggeredEvent\n28\tfrom engine.stack import StackObject\n29\tfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\n30\tfrom engine.zones import move_zone\n31\t\n32\tif TYPE_CHECKING:\n33\t    from engine.game_state import GameState\n34\t    from engine.player import Player\n35\t\n36\t\n37\t# Card types that represent permanents — these go to the battlefield on resolve.\n38\t_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n39\t    CardType.CREATURE,\n40\t    CardType.ENCHANTMENT,\n41\t    CardType.ARTIFACT,\n42\t    CardType.PLANESWALKER,\n43\t})\n44\t\n45\t\n46\tclass CastingError(Exception):\n47\t    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n48\t\n49\t\n50\t# ------------------------------------------------------------------\n51\t# Timing helpers\n52\t# ------------------------------------------------------------------\n53\t\n54\tdef is_sorcery_speed(game: GameState, player: Player) -> bool:\n55\t    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n56\t\n57\t    Sorcery speed requires all of:\n58\t\n59\t    * *player* is the active player.\n60\t    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n61\t      ``POSTCOMBAT_MAIN``).\n62\t    * The stack is empty.\n63\t    \"\"\"\n64\t    if player is not game.active_player:\n65\t        return False\n66\t    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n67\t        return False\n68\t    if not game.stack.is_empty():\n69\t        return False\n70\t    return True\n71\t\n72\t\n73\tdef can_cast_at_instant_speed(card: CardImpl) -> bool:\n74\t    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n75\t\n76\t    A card has instant-speed timing if it is an instant or has the\n77\t    :attr:`~engine.types.Keyword.FLASH` keyword.\n78\t    \"\"\"\n79\t    if CardType.INSTANT in card.card_types:\n80\t        return True\n81\t    if Keyword.FLASH & card.keywords:\n82\t        return True\n83\t    return False\n84\t\n85\t\n86\t# ------------------------------------------------------------------\n87\t# Cost reduction\n88\t# ------------------------------------------------------------------\n89\t\n90\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n91\t    \"\"\"Return the generic mana reduction for casting *card*.\n92\t\n93\t    Queries ``card.cost_reduction(game)`` and clamps the result so that\n94\t    the generic portion of the mana cost cannot go below 0.\n95\t\n96\t    This is a simplified single-card self-reduction model.  Full MTG\n97\t    cost-reduction interactions (Trinisphere, multiple reductions from\n98\t    different sources) are deferred.\n99\t    \"\"\"\n100\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n101\t    # casting player even when the card was never explicitly assigned one.\n102\t    prev_controller = card.controller\n103\t    card.controller = controller\n104\t    raw = card.cost_reduction(game)\n105\t    # Restore previous controller in case the caller doesn't want a\n106\t    # side-effect (get_cost_reduction is a query, not a mutation).\n107\t    card.controller = prev_controller\n108\t    generic = card.mana_cost.generic if card.mana_cost else 0\n109\t    return max(0, min(raw, generic))\n110\t\n111\t\n112\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n113\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n114\t    new_generic = max(0, cost.generic - reduction)\n115\t    return ManaCost(\n116\t        generic=new_generic,\n117\t        pips=dict(cost.pips),\n118\t        x_count=cost.x_count,\n119\t        hybrid=list(cost.hybrid),\n120\t    )\n121\t\n122\t\n123\t# ------------------------------------------------------------------\n124\t# Cast spell\n125\t# ------------------------------------------------------------------\n126\t\n127\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n128\t    \"\"\"Cast *card* from *player*'s hand.\n129\t\n130\t    Pipeline\n131\t    --------\n132\t    1. **Timing check** — instants (and cards with flash) can be cast\n133\t       whenever the player has priority; everything else requires\n134\t       sorcery-speed timing.\n135\t    2. **can_cast** — ask the card whether it can legally be cast.\n136\t    3. **Hand check** — the card must be in the player's hand.\n137\t    4. **Move hand → stack zone** — remove the card from the hand and\n138\t       place it into the player's stack zone.\n139\t    5. **Choose targets** — if the card specifies targets (via\n140\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n141\t    6. **Mana check / payment** — the player's mana pool must be able to\n142\t       pay the card's mana cost.  If payment fails, the card is rolled\n143\t       back from the stack zone to the hand.\n144\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n145\t    8. **Push StackObject** — push a :class:`StackObject` whose\n146\t       ``on_resolve`` callback handles resolution.\n147\t\n148\t    Raises:\n149\t        CastingError: If any legality check fails.\n150\t    \"\"\"\n151\t    # 1. Timing\n152\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n153\t        raise CastingError(\n154\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n155\t        )\n156\t\n157\t    # 2. can_cast\n158\t    if not card.can_cast(game):\n159\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n160\t\n161\t    # 3. Hand check\n162\t    hand = game.get_hand(player)\n163\t    if not hand.contains(card):\n164\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n165\t\n166\t    # 4. Move card from hand to stack zone\n167\t    stack_zone = player.zones[Zone.STACK]\n168\t    hand.remove(card)\n169\t    stack_zone.add(card)\n170\t\n171\t    # Clear any stale colors_spent from a prior cast before new payment.\n172\t    if hasattr(card, \"colors_spent\"):\n173\t        del card.colors_spent\n174\t\n175\t    # 5. Choose targets\n176\t    target_specs = card.get_targets(game)\n177\t    chosen_targets: list[Any] = []\n178\t    if target_specs:\n179\t        for spec in target_specs:\n180\t            target = player.choose_target(target_specs, spec)\n181\t            # Validate against filter_fn if the spec provides one\n182\t            filter_fn = getattr(spec, \"filter_fn\", None)\n183\t            if filter_fn is not None and target is not None:\n184\t                if not filter_fn(target):\n185\t                    stack_zone.remove(card)\n186\t                    hand.add(card)\n187\t                    raise CastingError(\n188\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n189\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n190\t                    )\n191\t            chosen_targets.append(target)\n192\t\n193\t    # 5b. Protection check — reject targets that have protection from this\n194\t    #     spell (the T in DEBT).\n195\t    from engine.protection import has_protection_from\n196\t\n197\t    for target in chosen_targets:\n198\t        if has_protection_from(target, card):\n199\t            # Rollback: move card from stack zone back to hand\n200\t            stack_zone.remove(card)\n201\t            hand.add(card)\n202\t            raise CastingError(\n203\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n204\t            )\n205\t\n206\t    # Targets are stored on the StackObject (not the card) and passed\n207\t    # through the resolve pipeline via on_resolve(game, targets=...).\n208\t\n209\t    # 6. Mana check / payment (rollback on failure)\n210\t    # Ensure the card knows its controller so that cost_reduction() hooks\n211\t    # (e.g. Embercleave counting attacking creatures you control) see the\n212\t    # casting player, even for cards that were added to hand without an\n213\t    # explicit controller assignment.\n214\t    if card.controller is None:\n215\t        card.controller = player\n216\t    reduction = get_cost_reduction(game, card, player)\n217\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n218\t\n219\t    if not player.mana_pool.can_pay(effective_cost):\n220\t        # Rollback: move card from stack zone back to hand\n221\t        stack_zone.remove(card)\n222\t        hand.add(card)\n223\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n224\t\n225\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n226\t    player.mana_pool.pay(effective_cost)\n227\t\n228\t    # Store colors of mana spent on the card for mechanics like Converge\n229\t    # that care about the colors used to cast the spell.\n230\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n231\t\n232\t    # Store the amount of mana spent to cast the spell (for mechanics like\n233\t    # Mana Sculpt that add mana equal to what was paid for a countered spell).\n234\t    card.mana_spent = effective_cost.cmc  # type: ignore[attr-defined]\n235\t\n236\t    # 7. Call on_cast hook\n237\t    card.on_cast(game)\n238\t\n239\t    # 8. Build on_resolve callback and push StackObject\n240\t    stack_obj = StackObject(\n241\t        source=card,\n242\t        controller=player,\n243\t        targets=chosen_targets,\n244\t        on_resolve=lambda g: None,  # replaced below\n245\t    )\n246\t\n247\t    def _on_resolve(g: GameState) -> None:\n248\t        _resolve_spell(g, card, player, stack_obj)\n249\t\n250\t    stack_obj.on_resolve = _on_resolve\n251\t    game.stack.push(stack_obj)\n252\t\n253\t    # Spell-cast triggers (e.g. casualty, prowess) fire after the spell is on\n254\t    # the stack, so their triggered abilities are placed above it and resolve\n255\t    # first.  Firing with no registered spell-cast triggers is a no-op.\n256\t    game.trigger_manager.fire_event(\n257\t        game,\n258\t        SpellCastTriggeredEvent(\n259\t            spell=stack_obj, player=player, card=card, controller=player\n260\t        ),\n261\t    )\n262\t\n263\t\n264\t# ------------------------------------------------------------------\n265\t# Cast spell without paying mana cost (free-cast from any zone)\n266\t# ------------------------------------------------------------------\n267\t\n268\t\n269\tdef cast_spell_free(\n270\t    game: GameState,\n271\t    player: Player,\n272\t    card: CardImpl,\n273\t    from_zone: Zone,\n274\t) -> None:\n275\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n276\t\n277\t    This is used by effects that allow casting from zones other than hand\n278\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n279\t    or cascade.\n280\t\n281\t    Pipeline\n282\t    --------\n283\t    1. **can_cast** — ask the card whether it can legally be cast (same\n284\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n285\t    2. Move *card* from *from_zone* to the stack zone.\n286\t    3. Choose targets (if applicable) with validation and protection check.\n287\t    4. Call ``on_cast`` hook.\n288\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n289\t       resolution normally (permanents → battlefield, non-permanents →\n290\t       graveyard).\n291\t\n292\t    No timing check or mana payment is performed.  The spell goes on the\n293\t    stack and can be responded to normally (e.g. countered).\n294\t\n295\t    If targeting or other post-move checks fail, the card is rolled back\n296\t    to its source zone.\n297\t\n298\t    Parameters:\n299\t        game: The current game state.\n300\t        player: The player casting the spell.\n301\t        card: The card to cast.\n302\t        from_zone: The zone the card is currently in.\n303\t\n304\t    Raises:\n305\t        CastingError: If the card cannot be found in *from_zone* or\n306\t            legality checks fail.\n307\t    \"\"\"\n308\t    from engine.zones import move_to_zone\n309\t\n310\t    # Ensure controller is set\n311\t    card.controller = player\n312\t    if card.owner is None:\n313\t        card.owner = player\n314\t\n315\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n316\t    if not card.can_cast(game):\n317\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n318\t\n319\t    # 2. Locate card in source zone\n320\t    source_zone_container = player.zones[from_zone]\n321\t    if not source_zone_container.contains(card):\n322\t        # Try to find the card in any player's zone\n323\t        source_zone_container = None\n324\t        for p in game.players:\n325\t            z = p.zones[from_zone]\n326\t            if z.contains(card):\n327\t                source_zone_container = z\n328\t                break\n329\t\n330\t    if source_zone_container is None or not source_zone_container.contains(card):\n331\t        raise CastingError(\n332\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n333\t        )\n334\t\n335\t    # Move card from source zone to stack zone\n336\t    stack_zone = player.zones[Zone.STACK]\n337\t    source_zone_container.remove(card)\n338\t    stack_zone.add(card)\n339\t\n340\t    # 3. Choose targets (with rollback on failure)\n341\t    try:\n342\t        target_specs = card.get_targets(game)\n343\t        chosen_targets: list[Any] = []\n344\t        if target_specs:\n345\t            for spec in target_specs:\n346\t                target = player.choose_target(target_specs, spec)\n347\t                # Validate against filter_fn if the spec provides one\n348\t                filter_fn = getattr(spec, \"filter_fn\", None)\n349\t                if filter_fn is not None and target is not None:\n350\t                    if not filter_fn(target):\n351\t                        raise CastingError(\n352\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n353\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n354\t                        )\n355\t                chosen_targets.append(target)\n356\t\n357\t        # Protection check — reject targets that have protection from this spell\n358\t        from engine.protection import has_protection_from\n359\t\n360\t        for target in chosen_targets:\n361\t            if has_protection_from(target, card):\n362\t                raise CastingError(\n363\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n364\t                )\n365\t    except Exception as exc:\n366\t        # Rollback: move card from stack zone back to source zone\n367\t        stack_zone.remove(card)\n368\t        source_zone_container.add(card)\n369\t        raise CastingError(str(exc)) from exc\n370\t\n371\t    # 4. Call on_cast hook\n372\t    card.on_cast(game)\n373\t\n374\t    # 5. Build on_resolve callback and push StackObject\n375\t    stack_obj = StackObject(\n376\t        source=card,\n377\t        controller=player,\n378\t        targets=chosen_targets,\n379\t        on_resolve=lambda g: None,  # replaced below\n380\t    )\n381\t\n382\t    def _on_resolve(g: GameState) -> None:\n383\t        _resolve_spell(g, card, player, stack_obj)\n384\t\n385\t    stack_obj.on_resolve = _on_resolve\n386\t    game.stack.push(stack_obj)\n387\t\n388\t    # Fire spell-cast triggers for free-cast spells too (e.g. a spell cast\n389\t    # from the graveyard still triggers \"whenever you cast\" abilities).\n390\t    game.trigger_manager.fire_event(\n391\t        game,\n392\t        SpellCastTriggeredEvent(\n393\t            spell=stack_obj, player=player, card=card, controller=player\n394\t        ),\n395\t    )\n396\t\n397\t\n398\t# ------------------------------------------------------------------\n399\t# Resolution (called when the stack pops)\n400\t# ------------------------------------------------------------------\n401\t\n402\tdef _resolve_spell(\n403\t    game: GameState,\n404\t    card: CardImpl,\n405\t    player: Player,\n406\t    stack_obj: StackObject,\n407\t) -> None:\n408\t    \"\"\"Resolve *card* cast by *player*.\n409\t\n410\t    1. Call ``card.on_resolve(game, targets=targets)``.\n411\t    2. Remove the card from the stack zone.\n412\t    3. If the card is a permanent type, move it to the battlefield via\n413\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n414\t       registration and the ETB event).\n415\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n416\t    \"\"\"\n417\t    from engine.zones import move_to_zone\n418\t\n419\t    # Read targets from the StackObject — the single source of truth.\n420\t    # Set chosen_targets on the card just before resolution so that\n421\t    # _get_chosen_target helpers (which read via getattr) work.\n422\t    targets = stack_obj.targets\n423\t    if targets is not None:\n424\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n425\t\n426\t    card.on_resolve(game)\n427\t\n428\t    if card.card_types & _PERMANENT_TYPES:\n429\t        # Move from stack to battlefield via move_to_zone, which handles\n430\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n431\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n432\t    else:\n433\t        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n434\t        # A spell cast under an \"if it would be put into your graveyard,\n435\t        # exile it instead\" effect (e.g. The Dawning Archaic) is redirected.\n436\t        dest = (\n437\t            Zone.EXILE\n438\t            if getattr(card, \"_exile_instead_of_graveyard\", False)\n439\t            else Zone.GRAVEYARD\n440\t        )\n441\t        move_to_zone(game, card, Zone.STACK, dest)\n442\t\n443\t\n444\t# ------------------------------------------------------------------\n445\t# Play land (special action — does not use the stack)\n446\t# ------------------------------------------------------------------\n447\t\n448\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n449\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n450\t\n451\t    Requirements (all must hold):\n452\t\n453\t    * *land_card* has :attr:`CardType.LAND`.\n454\t    * *player* is the active player.\n455\t    * Current phase is a main phase.\n456\t    * The stack is empty.\n457\t    * ``player.land_plays_remaining > 0``.\n458\t    * The card is in the player's hand.\n459\t\n460\t    On success the card moves from hand to battlefield and\n461\t    ``land_plays_remaining`` is decremented.\n462\t\n463\t    Raises:\n464\t        CastingError: If any requirement is not met.\n465\t    \"\"\"\n466\t    # Must be a land\n467\t    if CardType.LAND not in land_card.card_types:\n468\t        raise CastingError(\n469\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n470\t        )\n471\t\n472\t    # Sorcery-speed timing (active player, main phase, stack empty)\n473\t    if not is_sorcery_speed(game, player):\n474\t        raise CastingError(\n475\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n476\t            \"during main phase with empty stack\"\n477\t        )\n478\t\n479\t    # Land plays remaining\n480\t    if player.land_plays_remaining <= 0:\n481\t        raise CastingError(\n482\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n483\t        )\n484\t\n485\t    # Card must be in hand\n486\t    hand = game.get_hand(player)\n487\t    if not hand.contains(land_card):\n488\t        raise CastingError(\n489\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n490\t        )\n491\t\n492\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n493\t    if land_card.owner is None:\n494\t        land_card.owner = player\n495\t    land_card.controller = player\n496\t\n497\t    # Move from hand to battlefield via move_to_zone, which fires\n498\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n499\t    from engine.zones import move_to_zone\n500\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n501\t\n502\t    # Decrement land plays\n503\t    player.land_plays_remaining -= 1\n504\t\n505\t\n506\tdef resolve_top(game: GameState) -> None:\n507\t    \"\"\"Resolve the top spell/ability on the stack.\n508\t\n509\t    Pops the top item from the stack, calls its on_resolve callback,\n510\t    then runs state-based actions.  If the stack is empty this is a no-op.\n511\t    \"\"\"\n512\t    if game.stack.is_empty():\n513\t        return\n514\t    from engine.state_based_actions import resolve_state_based_actions\n515\t\n516\t    obj = game.stack.pop()\n517\t    obj.on_resolve(game)\n518\t    resolve_state_based_actions(game)\n519\t"}]},"parent_tool_use_id":null,"session_id":"b76fbb6d-7052-44e0-893e-8a2c1cc9d4a6","uuid":"6b4c2e1e-b0b1-4f1e-a081-ebfc56857cc5","timestamp":"2026-05-30T04:30:10.620Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"\"\"\"Casting and resolution pipeline for spells and lands.\n\nProvides the full flow from casting a spell or playing a land through\nresolution:\n\n- :func:`cast_spell` — verify timing & legality → move hand to stack →\n  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n- :func:`play_land` — verify land play remaining → move hand to\n  battlefield → decrement ``land_plays_remaining``.\n- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n  helpers used by the casting pipeline.\n\nResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\ncreated by :func:`cast_spell`:\n\n- Call ``card.on_resolve(game)``.\n- Permanents (creature / enchantment / artifact / planeswalker) move from\n  the stack to the battlefield.\n- Non-permanents (instant / sorcery) move to the graveyard.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import CardImpl\nfrom engine.events import SpellCastTriggeredEvent\nfrom engine.stack import StackObject\nfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\nfrom engine.zones import move_zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n# Card types that represent permanents — these go to the battlefield on resolve.\n_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n    CardType.CREATURE,\n    CardType.ENCHANTMENT,\n    CardType.ARTIFACT,\n    CardType.PLANESWALKER,\n})\n\n\nclass CastingError(Exception):\n    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n\n\n# ------------------------------------------------------------------\n# Timing helpers\n# ------------------------------------------------------------------\n\ndef is_sorcery_speed(game: GameState, player: Player) -> bool:\n    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n\n    Sorcery speed requires all of:\n\n    * *player* is the active player.\n    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n      ``POSTCOMBAT_MAIN``).\n    * The stack is empty.\n    \"\"\"\n    if player is not game.active_player:\n        return False\n    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n        return False\n    if not game.stack.is_empty():\n        return False\n    return True\n\n\ndef can_cast_at_instant_speed(card: CardImpl) -> bool:\n    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n\n    A card has instant-speed timing if it is an instant or has the\n    :attr:`~engine.types.Keyword.FLASH` keyword.\n    \"\"\"\n    if CardType.INSTANT in card.card_types:\n        return True\n    if Keyword.FLASH & card.keywords:\n        return True\n    return False\n\n\n# ------------------------------------------------------------------\n# Cost reduction\n# ------------------------------------------------------------------\n\ndef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n    \"\"\"Return the generic mana reduction for casting *card*.\n\n    Queries ``card.cost_reduction(game)`` and clamps the result so that\n    the generic portion of the mana cost cannot go below 0.\n\n    This is a simplified single-card self-reduction model.  Full MTG\n    cost-reduction interactions (Trinisphere, multiple reductions from\n    different sources) are deferred.\n    \"\"\"\n    # Ensure card.controller is set so the hook can reference \"you\" / the\n    # casting player even when the card was never explicitly assigned one.\n    prev_controller = card.controller\n    card.controller = controller\n    raw = card.cost_reduction(game)\n    # Restore previous controller in case the caller doesn't want a\n    # side-effect (get_cost_reduction is a query, not a mutation).\n    card.controller = prev_controller\n    generic = card.mana_cost.generic if card.mana_cost else 0\n    return max(0, min(raw, generic))\n\n\ndef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n    new_generic = max(0, cost.generic - reduction)\n    return ManaCost(\n        generic=new_generic,\n        pips=dict(cost.pips),\n        x_count=cost.x_count,\n        hybrid=list(cost.hybrid),\n    )\n\n\n# ------------------------------------------------------------------\n# Cast spell\n# ------------------------------------------------------------------\n\ndef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n    \"\"\"Cast *card* from *player*'s hand.\n\n    Pipeline\n    --------\n    1. **Timing check** — instants (and cards with flash) can be cast\n       whenever the player has priority; everything else requires\n       sorcery-speed timing.\n    2. **can_cast** — ask the card whether it can legally be cast.\n    3. **Hand check** — the card must be in the player's hand.\n    4. **Move hand → stack zone** — remove the card from the hand and\n       place it into the player's stack zone.\n    5. **Choose targets** — if the card specifies targets (via\n       :meth:`CardImpl.get_targets`), the player is asked to choose.\n    6. **Mana check / payment** — the player's mana pool must be able to\n       pay the card's mana cost.  If payment fails, the card is rolled\n       back from the stack zone to the hand.\n    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n    8. **Push StackObject** — push a :class:`StackObject` whose\n       ``on_resolve`` callback handles resolution.\n\n    Raises:\n        CastingError: If any legality check fails.\n    \"\"\"\n    # 1. Timing\n    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n        )\n\n    # 2. can_cast\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 3. Hand check\n    hand = game.get_hand(player)\n    if not hand.contains(card):\n        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n\n    # 4. Move card from hand to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    hand.remove(card)\n    stack_zone.add(card)\n\n    # Clear any stale colors_spent from a prior cast before new payment.\n    if hasattr(card, \"colors_spent\"):\n        del card.colors_spent\n\n    # 5. Choose targets\n    target_specs = card.get_targets(game)\n    chosen_targets: list[Any] = []\n    if target_specs:\n        for spec in target_specs:\n            target = player.choose_target(target_specs, spec)\n            # Validate against filter_fn if the spec provides one\n            filter_fn = getattr(spec, \"filter_fn\", None)\n            if filter_fn is not None and target is not None:\n                if not filter_fn(target):\n                    stack_zone.remove(card)\n                    hand.add(card)\n                    raise CastingError(\n                        f\"Cannot cast {card.name!r} — chosen target does not \"\n                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                    )\n            chosen_targets.append(target)\n\n    # 5b. Protection check — reject targets that have protection from this\n    #     spell (the T in DEBT).\n    from engine.protection import has_protection_from\n\n    for target in chosen_targets:\n        if has_protection_from(target, card):\n            # Rollback: move card from stack zone back to hand\n            stack_zone.remove(card)\n            hand.add(card)\n            raise CastingError(\n                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n            )\n\n    # Targets are stored on the StackObject (not the card) and passed\n    # through the resolve pipeline via on_resolve(game, targets=...).\n\n    # 6. Mana check / payment (rollback on failure)\n    # Ensure the card knows its controller so that cost_reduction() hooks\n    # (e.g. Embercleave counting attacking creatures you control) see the\n    # casting player, even for cards that were added to hand without an\n    # explicit controller assignment.\n    if card.controller is None:\n        card.controller = player\n    reduction = get_cost_reduction(game, card, player)\n    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n\n    if not player.mana_pool.can_pay(effective_cost):\n        # Rollback: move card from stack zone back to hand\n        stack_zone.remove(card)\n        hand.add(card)\n        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n\n    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n    player.mana_pool.pay(effective_cost)\n\n    # Store colors of mana spent on the card for mechanics like Converge\n    # that care about the colors used to cast the spell.\n    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n\n    # Store the amount of mana spent to cast the spell (for mechanics like\n    # Mana Sculpt that add mana equal to what was paid for a countered spell).\n    card.mana_spent = effective_cost.cmc  # type: ignore[attr-defined]\n\n    # 7. Call on_cast hook\n    card.on_cast(game)\n\n    # 8. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n    # Spell-cast triggers (e.g. casualty, prowess) fire after the spell is on\n    # the stack, so their triggered abilities are placed above it and resolve\n    # first.  Firing with no registered spell-cast triggers is a no-op.\n    game.trigger_manager.fire_event(\n        game,\n        SpellCastTriggeredEvent(\n            spell=stack_obj, player=player, card=card, controller=player\n        ),\n    )\n\n\n# ------------------------------------------------------------------\n# Cast spell without paying mana cost (free-cast from any zone)\n# ------------------------------------------------------------------\n\n\ndef cast_spell_free(\n    game: GameState,\n    player: Player,\n    card: CardImpl,\n    from_zone: Zone,\n) -> None:\n    \"\"\"Cast *card* without paying its mana cost, using the stack.\n\n    This is used by effects that allow casting from zones other than hand\n    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n    or cascade.\n\n    Pipeline\n    --------\n    1. **can_cast** — ask the card whether it can legally be cast (same\n       legality as :func:`cast_spell`, minus mana/timing constraints).\n    2. Move *card* from *from_zone* to the stack zone.\n    3. Choose targets (if applicable) with validation and protection check.\n    4. Call ``on_cast`` hook.\n    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n       resolution normally (permanents → battlefield, non-permanents →\n       graveyard).\n\n    No timing check or mana payment is performed.  The spell goes on the\n    stack and can be responded to normally (e.g. countered).\n\n    If targeting or other post-move checks fail, the card is rolled back\n    to its source zone.\n\n    Parameters:\n        game: The current game state.\n        player: The player casting the spell.\n        card: The card to cast.\n        from_zone: The zone the card is currently in.\n\n    Raises:\n        CastingError: If the card cannot be found in *from_zone* or\n            legality checks fail.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Ensure controller is set\n    card.controller = player\n    if card.owner is None:\n        card.owner = player\n\n    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 2. Locate card in source zone\n    source_zone_container = player.zones[from_zone]\n    if not source_zone_container.contains(card):\n        # Try to find the card in any player's zone\n        source_zone_container = None\n        for p in game.players:\n            z = p.zones[from_zone]\n            if z.contains(card):\n                source_zone_container = z\n                break\n\n    if source_zone_container is None or not source_zone_container.contains(card):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n        )\n\n    # Move card from source zone to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    source_zone_container.remove(card)\n    stack_zone.add(card)\n\n    # 3. Choose targets (with rollback on failure)\n    try:\n        target_specs = card.get_targets(game)\n        chosen_targets: list[Any] = []\n        if target_specs:\n            for spec in target_specs:\n                target = player.choose_target(target_specs, spec)\n                # Validate against filter_fn if the spec provides one\n                filter_fn = getattr(spec, \"filter_fn\", None)\n                if filter_fn is not None and target is not None:\n                    if not filter_fn(target):\n                        raise CastingError(\n                            f\"Cannot cast {card.name!r} — chosen target does not \"\n                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                        )\n                chosen_targets.append(target)\n\n        # Protection check — reject targets that have protection from this spell\n        from engine.protection import has_protection_from\n\n        for target in chosen_targets:\n            if has_protection_from(target, card):\n                raise CastingError(\n                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n                )\n    except Exception as exc:\n        # Rollback: move card from stack zone back to source zone\n        stack_zone.remove(card)\n        source_zone_container.add(card)\n        raise CastingError(str(exc)) from exc\n\n    # 4. Call on_cast hook\n    card.on_cast(game)\n\n    # 5. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n    # Fire spell-cast triggers for free-cast spells too (e.g. a spell cast\n    # from the graveyard still triggers \"whenever you cast\" abilities).\n    game.trigger_manager.fire_event(\n        game,\n        SpellCastTriggeredEvent(\n            spell=stack_obj, player=player, card=card, controller=player\n        ),\n    )\n\n\n# ------------------------------------------------------------------\n# Resolution (called when the stack pops)\n# ------------------------------------------------------------------\n\ndef _resolve_spell(\n    game: GameState,\n    card: CardImpl,\n    player: Player,\n    stack_obj: StackObject,\n) -> None:\n    \"\"\"Resolve *card* cast by *player*.\n\n    1. Call ``card.on_resolve(game, targets=targets)``.\n    2. Remove the card from the stack zone.\n    3. If the card is a permanent type, move it to the battlefield via\n       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n       registration and the ETB event).\n    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Read targets from the StackObject — the single source of truth.\n    # Set chosen_targets on the card just before resolution so that\n    # _get_chosen_target helpers (which read via getattr) work.\n    targets = stack_obj.targets\n    if targets is not None:\n        card.chosen_targets = targets  # type: ignore[attr-defined]\n\n    card.on_resolve(game)\n\n    if card.card_types & _PERMANENT_TYPES:\n        # Move from stack to battlefield via move_to_zone, which handles\n        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n    else:\n        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n        # A spell cast under an \"if it would be put into your graveyard,\n        # exile it instead\" effect (e.g. The Dawning Archaic) is redirected.\n        dest = (\n            Zone.EXILE\n            if getattr(card, \"_exile_instead_of_graveyard\", False)\n            else Zone.GRAVEYARD\n        )\n        move_to_zone(game, card, Zone.STACK, dest)\n\n\n# ------------------------------------------------------------------\n# Play land (special action — does not use the stack)\n# ------------------------------------------------------------------\n\ndef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n\n    Requirements (all must hold):\n\n    * *land_card* has :attr:`CardType.LAND`.\n    * *player* is the active player.\n    * Current phase is a main phase.\n    * The stack is empty.\n    * ``player.land_plays_remaining > 0``.\n    * The card is in the player's hand.\n\n    On success the card moves from hand to battlefield and\n    ``land_plays_remaining`` is decremented.\n\n    Raises:\n        CastingError: If any requirement is not met.\n    \"\"\"\n    # Must be a land\n    if CardType.LAND not in land_card.card_types:\n        raise CastingError(\n            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n        )\n\n    # Sorcery-speed timing (active player, main phase, stack empty)\n    if not is_sorcery_speed(game, player):\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — must be active player \"\n            \"during main phase with empty stack\"\n        )\n\n    # Land plays remaining\n    if player.land_plays_remaining <= 0:\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n        )\n\n    # Card must be in hand\n    hand = game.get_hand(player)\n    if not hand.contains(land_card):\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — card not in hand\"\n        )\n\n    # Ensure owner/controller are set so move_to_zone routes correctly.\n    if land_card.owner is None:\n        land_card.owner = player\n    land_card.controller = player\n\n    # Move from hand to battlefield via move_to_zone, which fires\n    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n    from engine.zones import move_to_zone\n    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n\n    # Decrement land plays\n    player.land_plays_remaining -= 1\n\n\ndef resolve_top(game: GameState) -> None:\n    \"\"\"Resolve the top spell/ability on the stack.\n\n    Pops the top item from the stack, calls its on_resolve callback,\n    then runs state-based actions.  If the stack is empty this is a no-op.\n    \"\"\"\n    if game.stack.is_empty():\n        return\n    from engine.state_based_actions import resolve_state_based_actions\n\n    obj = game.stack.pop()\n    obj.on_resolve(game)\n    resolve_state_based_actions(game)\n","numLines":519,"startLine":1,"totalLines":519}}}
