{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AaqQQKevqEgzBH4Gb2dyRk","type":"tool_result","content":"1\t\"\"\"Card implementation for Progenitus.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom typing import TYPE_CHECKING, Any\n4\tfrom engine.card import Creature\n5\tfrom engine.protection import ProtectionAbility\n6\tfrom engine.events import MoveToGraveyardReplacementEvent\n7\tfrom engine.replacement_effects import ReplacementEffect\n8\tfrom engine.types import ManaCost, Supertype, Zone\n9\tif TYPE_CHECKING:\n10\t    from engine.game_state import GameState\n11\t\n12\tclass Progenitus(Creature):\n13\t    \"\"\"Progenitus — {W}{W}{U}{U}{B}{B}{R}{R}{G}{G} — 10/10 — Legendary Hydra Avatar.\n14\t\n15\t    Protection from everything.\n16\t    If Progenitus would be put into a graveyard from anywhere, reveal\n17\t    Progenitus and shuffle it into its owner's library instead.\n18\t\n19\t    FDN collector number 244.\n20\t    \"\"\"\n21\t\n22\t    def __init__(self, **kwargs: Any) -> None:\n23\t        kwargs.setdefault('name', 'Progenitus')\n24\t        kwargs.setdefault('mana_cost', ManaCost.parse('{W}{W}{U}{U}{B}{B}{R}{R}{G}{G}'))\n25\t        kwargs.setdefault('subtypes', {'Hydra', 'Avatar'})\n26\t        kwargs.setdefault('supertypes', {Supertype.LEGENDARY})\n27\t        kwargs.setdefault('base_power', 10)\n28\t        kwargs.setdefault('base_toughness', 10)\n29\t        kwargs.setdefault('rules_text', \"Protection from everything\\nIf Progenitus would be put into a graveyard from anywhere, reveal Progenitus and shuffle it into its owner's library instead.\")\n30\t        super().__init__(**kwargs)\n31\t        self._init_protection()\n32\t\n33\t    def _init_protection(self) -> None:\n34\t        \"\"\"Set up protection from everything. Called from __init__ and\n35\t        can be re-invoked after characteristic resets.\"\"\"\n36\t        self.protections = [ProtectionAbility(quality='everything', predicate=lambda source: True)]\n37\t\n38\t    def _reset_characteristics(self) -> None:\n39\t        \"\"\"Override to reapply protection from everything after reset.\"\"\"\n40\t        super()._reset_characteristics()\n41\t        self._init_protection()\n42\t\n43\t    def register_replacement_effects(self, game: 'GameState') -> None:\n44\t        \"\"\"Register graveyard-shuffle replacement effect.\n45\t\n46\t        Registers a single :class:`~engine.events.MoveToGraveyardReplacementEvent`\n47\t        handler; the engine's zone-move pipeline dispatches subclass events\n48\t        (creature_dies, sacrifice, etc.) to this parent-type handler automatically.\n49\t        \"\"\"\n50\t        source = self\n51\t\n52\t        def _condition(game: Any, event: dict) -> bool:\n53\t            return event.card is source\n54\t\n55\t        def _replacement(game: Any, event: dict) -> dict:\n56\t            owner = getattr(source, 'owner', None)\n57\t            if owner is not None:\n58\t                library = owner.zones[Zone.LIBRARY]\n59\t                library.add(source)\n60\t                library.shuffle()\n61\t            event.prevented = True\n62\t            return event\n63\t        controller = getattr(self, 'controller', None)\n64\t        game.replacement_manager.register(ReplacementEffect(event_type=MoveToGraveyardReplacementEvent, source=self, condition=_condition, replacement=_replacement, controller=controller))\n65\t"}]},"parent_tool_use_id":null,"session_id":"b76fbb6d-7052-44e0-893e-8a2c1cc9d4a6","uuid":"f5871507-7cbc-481f-b60f-bd36874cac20","timestamp":"2026-05-30T04:08:29.693Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_244/card_impl.py","content":"\"\"\"Card implementation for Progenitus.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import Creature\nfrom engine.protection import ProtectionAbility\nfrom engine.events import MoveToGraveyardReplacementEvent\nfrom engine.replacement_effects import ReplacementEffect\nfrom engine.types import ManaCost, Supertype, Zone\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\nclass Progenitus(Creature):\n    \"\"\"Progenitus — {W}{W}{U}{U}{B}{B}{R}{R}{G}{G} — 10/10 — Legendary Hydra Avatar.\n\n    Protection from everything.\n    If Progenitus would be put into a graveyard from anywhere, reveal\n    Progenitus and shuffle it into its owner's library instead.\n\n    FDN collector number 244.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Progenitus')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{W}{W}{U}{U}{B}{B}{R}{R}{G}{G}'))\n        kwargs.setdefault('subtypes', {'Hydra', 'Avatar'})\n        kwargs.setdefault('supertypes', {Supertype.LEGENDARY})\n        kwargs.setdefault('base_power', 10)\n        kwargs.setdefault('base_toughness', 10)\n        kwargs.setdefault('rules_text', \"Protection from everything\\nIf Progenitus would be put into a graveyard from anywhere, reveal Progenitus and shuffle it into its owner's library instead.\")\n        super().__init__(**kwargs)\n        self._init_protection()\n\n    def _init_protection(self) -> None:\n        \"\"\"Set up protection from everything. Called from __init__ and\n        can be re-invoked after characteristic resets.\"\"\"\n        self.protections = [ProtectionAbility(quality='everything', predicate=lambda source: True)]\n\n    def _reset_characteristics(self) -> None:\n        \"\"\"Override to reapply protection from everything after reset.\"\"\"\n        super()._reset_characteristics()\n        self._init_protection()\n\n    def register_replacement_effects(self, game: 'GameState') -> None:\n        \"\"\"Register graveyard-shuffle replacement effect.\n\n        Registers a single :class:`~engine.events.MoveToGraveyardReplacementEvent`\n        handler; the engine's zone-move pipeline dispatches subclass events\n        (creature_dies, sacrifice, etc.) to this parent-type handler automatically.\n        \"\"\"\n        source = self\n\n        def _condition(game: Any, event: dict) -> bool:\n            return event.card is source\n\n        def _replacement(game: Any, event: dict) -> dict:\n            owner = getattr(source, 'owner', None)\n            if owner is not None:\n                library = owner.zones[Zone.LIBRARY]\n                library.add(source)\n                library.shuffle()\n            event.prevented = True\n            return event\n        controller = getattr(self, 'controller', None)\n        game.replacement_manager.register(ReplacementEffect(event_type=MoveToGraveyardReplacementEvent, source=self, condition=_condition, replacement=_replacement, controller=controller))\n","numLines":65,"startLine":1,"totalLines":65}}}
