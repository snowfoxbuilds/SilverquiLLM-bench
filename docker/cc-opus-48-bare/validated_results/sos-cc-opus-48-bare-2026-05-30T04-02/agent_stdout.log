{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_0197ciKk4PdwwRps6We52a9E","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015ZHUNCzDQXpppJx6K58HDB","name":"Read","input":{"file_path":"/workspace/engine/casting.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3234,"cache_read_input_tokens":60564,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3234},"output_tokens":40,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b76fbb6d-7052-44e0-893e-8a2c1cc9d4a6","uuid":"2ec78020-b98f-45af-85f9-d3d642d4fbc5","request_id":"req_011CbYAUuTKHq6HZupf58H5V"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015ZHUNCzDQXpppJx6K58HDB","type":"tool_result","content":"1\t\"\"\"Casting and resolution pipeline for spells and lands.\n2\t\n3\tProvides the full flow from casting a spell or playing a land through\n4\tresolution:\n5\t\n6\t- :func:`cast_spell` — verify timing & legality → move hand to stack →\n7\t  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n8\t- :func:`play_land` — verify land play remaining → move hand to\n9\t  battlefield → decrement ``land_plays_remaining``.\n10\t- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n11\t  helpers used by the casting pipeline.\n12\t\n13\tResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\n14\tcreated by :func:`cast_spell`:\n15\t\n16\t- Call ``card.on_resolve(game)``.\n17\t- Permanents (creature / enchantment / artifact / planeswalker) move from\n18\t  the stack to the battlefield.\n19\t- Non-permanents (instant / sorcery) move to the graveyard.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import TYPE_CHECKING, Any\n25\t\n26\tfrom engine.card import CardImpl\n27\tfrom engine.events import SpellCastTriggeredEvent\n28\tfrom engine.stack import StackObject\n29\tfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\n30\tfrom engine.zones import move_zone\n31\t\n32\tif TYPE_CHECKING:\n33\t    from engine.game_state import GameState\n34\t    from engine.player import Player\n35\t\n36\t\n37\t# Card types that represent permanents — these go to the battlefield on resolve.\n38\t_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n39\t    CardType.CREATURE,\n40\t    CardType.ENCHANTMENT,\n41\t    CardType.ARTIFACT,\n42\t    CardType.PLANESWALKER,\n43\t})\n44\t\n45\t\n46\tclass CastingError(Exception):\n47\t    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n48\t\n49\t\n50\t# ------------------------------------------------------------------\n51\t# Timing helpers\n52\t# ------------------------------------------------------------------\n53\t\n54\tdef is_sorcery_speed(game: GameState, player: Player) -> bool:\n55\t    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n56\t\n57\t    Sorcery speed requires all of:\n58\t\n59\t    * *player* is the active player.\n60\t    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n61\t      ``POSTCOMBAT_MAIN``).\n62\t    * The stack is empty.\n63\t    \"\"\"\n64\t    if player is not game.active_player:\n65\t        return False\n66\t    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n67\t        return False\n68\t    if not game.stack.is_empty():\n69\t        return False\n70\t    return True\n71\t\n72\t\n73\tdef can_cast_at_instant_speed(card: CardImpl) -> bool:\n74\t    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n75\t\n76\t    A card has instant-speed timing if it is an instant or has the\n77\t    :attr:`~engine.types.Keyword.FLASH` keyword.\n78\t    \"\"\"\n79\t    if CardType.INSTANT in card.card_types:\n80\t        return True\n81\t    if Keyword.FLASH & card.keywords:\n82\t        return True\n83\t    return False\n84\t\n85\t\n86\t# ------------------------------------------------------------------\n87\t# Cost reduction\n88\t# ------------------------------------------------------------------\n89\t\n90\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n91\t    \"\"\"Return the generic mana reduction for casting *card*.\n92\t\n93\t    Queries ``card.cost_reduction(game)`` and clamps the result so that\n94\t    the generic portion of the mana cost cannot go below 0.\n95\t\n96\t    This is a simplified single-card self-reduction model.  Full MTG\n97\t    cost-reduction interactions (Trinisphere, multiple reductions from\n98\t    different sources) are deferred.\n99\t    \"\"\"\n100\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n101\t    # casting player even when the card was never explicitly assigned one.\n102\t    prev_controller = card.controller\n103\t    card.controller = controller\n104\t    raw = card.cost_reduction(game)\n105\t    # Restore previous controller in case the caller doesn't want a\n106\t    # side-effect (get_cost_reduction is a query, not a mutation).\n107\t    card.controller = prev_controller\n108\t\n109\t    # External cost-reduction effects from permanents on the battlefield\n110\t    # (e.g. \"instant and sorcery spells you cast have affinity for creatures\").\n111\t    for player in game.players:\n112\t        for permanent in player.zones[Zone.BATTLEFIELD].get_all():\n113\t            if permanent is card:\n114\t                continue\n115\t            hook = getattr(permanent, \"spell_cost_reduction\", None)\n116\t            if hook is not None:\n117\t                raw += hook(game, card, controller)\n118\t\n119\t    generic = card.mana_cost.generic if card.mana_cost else 0\n120\t    return max(0, min(raw, generic))\n121\t\n122\t\n123\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n124\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n125\t    new_generic = max(0, cost.generic - reduction)\n126\t    return ManaCost(\n127\t        generic=new_generic,\n128\t        pips=dict(cost.pips),\n129\t        x_count=cost.x_count,\n130\t        hybrid=list(cost.hybrid),\n131\t    )\n132\t\n133\t\n134\t# ------------------------------------------------------------------\n135\t# Cast spell\n136\t# ------------------------------------------------------------------\n137\t\n138\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n139\t    \"\"\"Cast *card* from *player*'s hand.\n140\t\n141\t    Pipeline\n142\t    --------\n143\t    1. **Timing check** — instants (and cards with flash) can be cast\n144\t       whenever the player has priority; everything else requires\n145\t       sorcery-speed timing.\n146\t    2. **can_cast** — ask the card whether it can legally be cast.\n147\t    3. **Hand check** — the card must be in the player's hand.\n148\t    4. **Move hand → stack zone** — remove the card from the hand and\n149\t       place it into the player's stack zone.\n150\t    5. **Choose targets** — if the card specifies targets (via\n151\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n152\t    6. **Mana check / payment** — the player's mana pool must be able to\n153\t       pay the card's mana cost.  If payment fails, the card is rolled\n154\t       back from the stack zone to the hand.\n155\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n156\t    8. **Push StackObject** — push a :class:`StackObject` whose\n157\t       ``on_resolve`` callback handles resolution.\n158\t\n159\t    Raises:\n160\t        CastingError: If any legality check fails.\n161\t    \"\"\"\n162\t    # 1. Timing\n163\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n164\t        raise CastingError(\n165\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n166\t        )\n167\t\n168\t    # 2. can_cast\n169\t    if not card.can_cast(game):\n170\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n171\t\n172\t    # 3. Hand check\n173\t    hand = game.get_hand(player)\n174\t    if not hand.contains(card):\n175\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n176\t\n177\t    # 4. Move card from hand to stack zone\n178\t    stack_zone = player.zones[Zone.STACK]\n179\t    hand.remove(card)\n180\t    stack_zone.add(card)\n181\t\n182\t    # Clear any stale colors_spent from a prior cast before new payment.\n183\t    if hasattr(card, \"colors_spent\"):\n184\t        del card.colors_spent\n185\t\n186\t    # 5. Choose targets\n187\t    target_specs = card.get_targets(game)\n188\t    chosen_targets: list[Any] = []\n189\t    if target_specs:\n190\t        for spec in target_specs:\n191\t            target = player.choose_target(target_specs, spec)\n192\t            # Validate against filter_fn if the spec provides one\n193\t            filter_fn = getattr(spec, \"filter_fn\", None)\n194\t            if filter_fn is not None and target is not None:\n195\t                if not filter_fn(target):\n196\t                    stack_zone.remove(card)\n197\t                    hand.add(card)\n198\t                    raise CastingError(\n199\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n200\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n201\t                    )\n202\t            chosen_targets.append(target)\n203\t\n204\t    # 5b. Protection check — reject targets that have protection from this\n205\t    #     spell (the T in DEBT).\n206\t    from engine.protection import has_protection_from\n207\t\n208\t    for target in chosen_targets:\n209\t        if has_protection_from(target, card):\n210\t            # Rollback: move card from stack zone back to hand\n211\t            stack_zone.remove(card)\n212\t            hand.add(card)\n213\t            raise CastingError(\n214\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n215\t            )\n216\t\n217\t    # Targets are stored on the StackObject (not the card) and passed\n218\t    # through the resolve pipeline via on_resolve(game, targets=...).\n219\t\n220\t    # 6. Mana check / payment (rollback on failure)\n221\t    # Ensure the card knows its controller so that cost_reduction() hooks\n222\t    # (e.g. Embercleave counting attacking creatures you control) see the\n223\t    # casting player, even for cards that were added to hand without an\n224\t    # explicit controller assignment.\n225\t    if card.controller is None:\n226\t        card.controller = player\n227\t    reduction = get_cost_reduction(game, card, player)\n228\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n229\t\n230\t    if not player.mana_pool.can_pay(effective_cost):\n231\t        # Rollback: move card from stack zone back to hand\n232\t        stack_zone.remove(card)\n233\t        hand.add(card)\n234\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n235\t\n236\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n237\t    player.mana_pool.pay(effective_cost)\n238\t\n239\t    # Store colors of mana spent on the card for mechanics like Converge\n240\t    # that care about the colors used to cast the spell.\n241\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n242\t\n243\t    # Store the amount of mana spent to cast the spell (for mechanics like\n244\t    # Mana Sculpt that add mana equal to what was paid for a countered spell).\n245\t    card.mana_spent = effective_cost.cmc  # type: ignore[attr-defined]\n246\t\n247\t    # 7. Call on_cast hook\n248\t    card.on_cast(game)\n249\t\n250\t    # 8. Build on_resolve callback and push StackObject\n251\t    stack_obj = StackObject(\n252\t        source=card,\n253\t        controller=player,\n254\t        targets=chosen_targets,\n255\t        on_resolve=lambda g: None,  # replaced below\n256\t    )\n257\t\n258\t    def _on_resolve(g: GameState) -> None:\n259\t        _resolve_spell(g, card, player, stack_obj)\n260\t\n261\t    stack_obj.on_resolve = _on_resolve\n262\t    game.stack.push(stack_obj)\n263\t\n264\t    # Spell-cast triggers (e.g. casualty, prowess) fire after the spell is on\n265\t    # the stack, so their triggered abilities are placed above it and resolve\n266\t    # first.  Firing with no registered spell-cast triggers is a no-op.\n267\t    game.trigger_manager.fire_event(\n268\t        game,\n269\t        SpellCastTriggeredEvent(\n270\t            spell=stack_obj, player=player, card=card, controller=player\n271\t        ),\n272\t    )\n273\t\n274\t\n275\t# ------------------------------------------------------------------\n276\t# Cast spell without paying mana cost (free-cast from any zone)\n277\t# ------------------------------------------------------------------\n278\t\n279\t\n280\tdef cast_spell_free(\n281\t    game: GameState,\n282\t    player: Player,\n283\t    card: CardImpl,\n284\t    from_zone: Zone,\n285\t) -> None:\n286\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n287\t\n288\t    This is used by effects that allow casting from zones other than hand\n289\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n290\t    or cascade.\n291\t\n292\t    Pipeline\n293\t    --------\n294\t    1. **can_cast** — ask the card whether it can legally be cast (same\n295\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n296\t    2. Move *card* from *from_zone* to the stack zone.\n297\t    3. Choose targets (if applicable) with validation and protection check.\n298\t    4. Call ``on_cast`` hook.\n299\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n300\t       resolution normally (permanents → battlefield, non-permanents →\n301\t       graveyard).\n302\t\n303\t    No timing check or mana payment is performed.  The spell goes on the\n304\t    stack and can be responded to normally (e.g. countered).\n305\t\n306\t    If targeting or other post-move checks fail, the card is rolled back\n307\t    to its source zone.\n308\t\n309\t    Parameters:\n310\t        game: The current game state.\n311\t        player: The player casting the spell.\n312\t        card: The card to cast.\n313\t        from_zone: The zone the card is currently in.\n314\t\n315\t    Raises:\n316\t        CastingError: If the card cannot be found in *from_zone* or\n317\t            legality checks fail.\n318\t    \"\"\"\n319\t    from engine.zones import move_to_zone\n320\t\n321\t    # Ensure controller is set\n322\t    card.controller = player\n323\t    if card.owner is None:\n324\t        card.owner = player\n325\t\n326\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n327\t    if not card.can_cast(game):\n328\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n329\t\n330\t    # 2. Locate card in source zone\n331\t    source_zone_container = player.zones[from_zone]\n332\t    if not source_zone_container.contains(card):\n333\t        # Try to find the card in any player's zone\n334\t        source_zone_container = None\n335\t        for p in game.players:\n336\t            z = p.zones[from_zone]\n337\t            if z.contains(card):\n338\t                source_zone_container = z\n339\t                break\n340\t\n341\t    if source_zone_container is None or not source_zone_container.contains(card):\n342\t        raise CastingError(\n343\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n344\t        )\n345\t\n346\t    # Move card from source zone to stack zone\n347\t    stack_zone = player.zones[Zone.STACK]\n348\t    source_zone_container.remove(card)\n349\t    stack_zone.add(card)\n350\t\n351\t    # 3. Choose targets (with rollback on failure)\n352\t    try:\n353\t        target_specs = card.get_targets(game)\n354\t        chosen_targets: list[Any] = []\n355\t        if target_specs:\n356\t            for spec in target_specs:\n357\t                target = player.choose_target(target_specs, spec)\n358\t                # Validate against filter_fn if the spec provides one\n359\t                filter_fn = getattr(spec, \"filter_fn\", None)\n360\t                if filter_fn is not None and target is not None:\n361\t                    if not filter_fn(target):\n362\t                        raise CastingError(\n363\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n364\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n365\t                        )\n366\t                chosen_targets.append(target)\n367\t\n368\t        # Protection check — reject targets that have protection from this spell\n369\t        from engine.protection import has_protection_from\n370\t\n371\t        for target in chosen_targets:\n372\t            if has_protection_from(target, card):\n373\t                raise CastingError(\n374\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n375\t                )\n376\t    except Exception as exc:\n377\t        # Rollback: move card from stack zone back to source zone\n378\t        stack_zone.remove(card)\n379\t        source_zone_container.add(card)\n380\t        raise CastingError(str(exc)) from exc\n381\t\n382\t    # 4. Call on_cast hook\n383\t    card.on_cast(game)\n384\t\n385\t    # 5. Build on_resolve callback and push StackObject\n386\t    stack_obj = StackObject(\n387\t        source=card,\n388\t        controller=player,\n389\t        targets=chosen_targets,\n390\t        on_resolve=lambda g: None,  # replaced below\n391\t    )\n392\t\n393\t    def _on_resolve(g: GameState) -> None:\n394\t        _resolve_spell(g, card, player, stack_obj)\n395\t\n396\t    stack_obj.on_resolve = _on_resolve\n397\t    game.stack.push(stack_obj)\n398\t\n399\t    # Fire spell-cast triggers for free-cast spells too (e.g. a spell cast\n400\t    # from the graveyard still triggers \"whenever you cast\" abilities).\n401\t    game.trigger_manager.fire_event(\n402\t        game,\n403\t        SpellCastTriggeredEvent(\n404\t            spell=stack_obj, player=player, card=card, controller=player\n405\t        ),\n406\t    )\n407\t\n408\t\n409\t# ------------------------------------------------------------------\n410\t# Resolution (called when the stack pops)\n411\t# ------------------------------------------------------------------\n412\t\n413\tdef _resolve_spell(\n414\t    game: GameState,\n415\t    card: CardImpl,\n416\t    player: Player,\n417\t    stack_obj: StackObject,\n418\t) -> None:\n419\t    \"\"\"Resolve *card* cast by *player*.\n420\t\n421\t    1. Call ``card.on_resolve(game, targets=targets)``.\n422\t    2. Remove the card from the stack zone.\n423\t    3. If the card is a permanent type, move it to the battlefield via\n424\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n425\t       registration and the ETB event).\n426\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n427\t    \"\"\"\n428\t    from engine.zones import move_to_zone\n429\t\n430\t    # Read targets from the StackObject — the single source of truth.\n431\t    # Set chosen_targets on the card just before resolution so that\n432\t    # _get_chosen_target helpers (which read via getattr) work.\n433\t    targets = stack_obj.targets\n434\t    if targets is not None:\n435\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n436\t\n437\t    card.on_resolve(game)\n438\t\n439\t    if card.card_types & _PERMANENT_TYPES:\n440\t        # Move from stack to battlefield via move_to_zone, which handles\n441\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n442\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n443\t    else:\n444\t        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n445\t        # A spell cast under an \"if it would be put into your graveyard,\n446\t        # exile it instead\" effect (e.g. The Dawning Archaic) is redirected.\n447\t        dest = (\n448\t            Zone.EXILE\n449\t            if getattr(card, \"_exile_instead_of_graveyard\", False)\n450\t            else Zone.GRAVEYARD\n451\t        )\n452\t        move_to_zone(game, card, Zone.STACK, dest)\n453\t\n454\t\n455\t# ------------------------------------------------------------------\n456\t# Play land (special action — does not use the stack)\n457\t# ------------------------------------------------------------------\n458\t\n459\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n460\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n461\t\n462\t    Requirements (all must hold):\n463\t\n464\t    * *land_card* has :attr:`CardType.LAND`.\n465\t    * *player* is the active player.\n466\t    * Current phase is a main phase.\n467\t    * The stack is empty.\n468\t    * ``player.land_plays_remaining > 0``.\n469\t    * The card is in the player's hand.\n470\t\n471\t    On success the card moves from hand to battlefield and\n472\t    ``land_plays_remaining`` is decremented.\n473\t\n474\t    Raises:\n475\t        CastingError: If any requirement is not met.\n476\t    \"\"\"\n477\t    # Must be a land\n478\t    if CardType.LAND not in land_card.card_types:\n479\t        raise CastingError(\n480\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n481\t        )\n482\t\n483\t    # Sorcery-speed timing (active player, main phase, stack empty)\n484\t    if not is_sorcery_speed(game, player):\n485\t        raise CastingError(\n486\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n487\t            \"during main phase with empty stack\"\n488\t        )\n489\t\n490\t    # Land plays remaining\n491\t    if player.land_plays_remaining <= 0:\n492\t        raise CastingError(\n493\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n494\t        )\n495\t\n496\t    # Card must be in hand\n497\t    hand = game.get_hand(player)\n498\t    if not hand.contains(land_card):\n499\t        raise CastingError(\n500\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n501\t        )\n502\t\n503\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n504\t    if land_card.owner is None:\n505\t        land_card.owner = player\n506\t    land_card.controller = player\n507\t\n508\t    # Move from hand to battlefield via move_to_zone, which fires\n509\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n510\t    from engine.zones import move_to_zone\n511\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n512\t\n513\t    # Decrement land plays\n514\t    player.land_plays_remaining -= 1\n515\t\n516\t\n517\tdef resolve_top(game: GameState) -> None:\n518\t    \"\"\"Resolve the top spell/ability on the stack.\n519\t\n520\t    Pops the top item from the stack, calls its on_resolve callback,\n521\t    then runs state-based actions.  If the stack is empty this is a no-op.\n522\t    \"\"\"\n523\t    if game.stack.is_empty():\n524\t        return\n525\t    from engine.state_based_actions import resolve_state_based_actions\n526\t\n527\t    obj = game.stack.pop()\n528\t    obj.on_resolve(game)\n529\t    resolve_state_based_actions(game)\n530\t"}]},"parent_tool_use_id":null,"session_id":"b76fbb6d-7052-44e0-893e-8a2c1cc9d4a6","uuid":"df9bead5-6400-45e1-91c8-064b1bcc88c1","timestamp":"2026-05-30T05:00:25.017Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"\"\"\"Casting and resolution pipeline for spells and lands.\n\nProvides the full flow from casting a spell or playing a land through\nresolution:\n\n- :func:`cast_spell` — verify timing & legality → move hand to stack →\n  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n- :func:`play_land` — verify land play remaining → move hand to\n  battlefield → decrement ``land_plays_remaining``.\n- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n  helpers used by the casting pipeline.\n\nResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\ncreated by :func:`cast_spell`:\n\n- Call ``card.on_resolve(game)``.\n- Permanents (creature / enchantment / artifact / planeswalker) move from\n  the stack to the battlefield.\n- Non-permanents (instant / sorcery) move to the graveyard.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import CardImpl\nfrom engine.events import SpellCastTriggeredEvent\nfrom engine.stack import StackObject\nfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\nfrom engine.zones import move_zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n# Card types that represent permanents — these go to the battlefield on resolve.\n_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n    CardType.CREATURE,\n    CardType.ENCHANTMENT,\n    CardType.ARTIFACT,\n    CardType.PLANESWALKER,\n})\n\n\nclass CastingError(Exception):\n    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n\n\n# ------------------------------------------------------------------\n# Timing helpers\n# ------------------------------------------------------------------\n\ndef is_sorcery_speed(game: GameState, player: Player) -> bool:\n    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n\n    Sorcery speed requires all of:\n\n    * *player* is the active player.\n    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n      ``POSTCOMBAT_MAIN``).\n    * The stack is empty.\n    \"\"\"\n    if player is not game.active_player:\n        return False\n    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n        return False\n    if not game.stack.is_empty():\n        return False\n    return True\n\n\ndef can_cast_at_instant_speed(card: CardImpl) -> bool:\n    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n\n    A card has instant-speed timing if it is an instant or has the\n    :attr:`~engine.types.Keyword.FLASH` keyword.\n    \"\"\"\n    if CardType.INSTANT in card.card_types:\n        return True\n    if Keyword.FLASH & card.keywords:\n        return True\n    return False\n\n\n# ------------------------------------------------------------------\n# Cost reduction\n# ------------------------------------------------------------------\n\ndef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n    \"\"\"Return the generic mana reduction for casting *card*.\n\n    Queries ``card.cost_reduction(game)`` and clamps the result so that\n    the generic portion of the mana cost cannot go below 0.\n\n    This is a simplified single-card self-reduction model.  Full MTG\n    cost-reduction interactions (Trinisphere, multiple reductions from\n    different sources) are deferred.\n    \"\"\"\n    # Ensure card.controller is set so the hook can reference \"you\" / the\n    # casting player even when the card was never explicitly assigned one.\n    prev_controller = card.controller\n    card.controller = controller\n    raw = card.cost_reduction(game)\n    # Restore previous controller in case the caller doesn't want a\n    # side-effect (get_cost_reduction is a query, not a mutation).\n    card.controller = prev_controller\n\n    # External cost-reduction effects from permanents on the battlefield\n    # (e.g. \"instant and sorcery spells you cast have affinity for creatures\").\n    for player in game.players:\n        for permanent in player.zones[Zone.BATTLEFIELD].get_all():\n            if permanent is card:\n                continue\n            hook = getattr(permanent, \"spell_cost_reduction\", None)\n            if hook is not None:\n                raw += hook(game, card, controller)\n\n    generic = card.mana_cost.generic if card.mana_cost else 0\n    return max(0, min(raw, generic))\n\n\ndef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n    new_generic = max(0, cost.generic - reduction)\n    return ManaCost(\n        generic=new_generic,\n        pips=dict(cost.pips),\n        x_count=cost.x_count,\n        hybrid=list(cost.hybrid),\n    )\n\n\n# ------------------------------------------------------------------\n# Cast spell\n# ------------------------------------------------------------------\n\ndef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n    \"\"\"Cast *card* from *player*'s hand.\n\n    Pipeline\n    --------\n    1. **Timing check** — instants (and cards with flash) can be cast\n       whenever the player has priority; everything else requires\n       sorcery-speed timing.\n    2. **can_cast** — ask the card whether it can legally be cast.\n    3. **Hand check** — the card must be in the player's hand.\n    4. **Move hand → stack zone** — remove the card from the hand and\n       place it into the player's stack zone.\n    5. **Choose targets** — if the card specifies targets (via\n       :meth:`CardImpl.get_targets`), the player is asked to choose.\n    6. **Mana check / payment** — the player's mana pool must be able to\n       pay the card's mana cost.  If payment fails, the card is rolled\n       back from the stack zone to the hand.\n    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n    8. **Push StackObject** — push a :class:`StackObject` whose\n       ``on_resolve`` callback handles resolution.\n\n    Raises:\n        CastingError: If any legality check fails.\n    \"\"\"\n    # 1. Timing\n    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n        )\n\n    # 2. can_cast\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 3. Hand check\n    hand = game.get_hand(player)\n    if not hand.contains(card):\n        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n\n    # 4. Move card from hand to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    hand.remove(card)\n    stack_zone.add(card)\n\n    # Clear any stale colors_spent from a prior cast before new payment.\n    if hasattr(card, \"colors_spent\"):\n        del card.colors_spent\n\n    # 5. Choose targets\n    target_specs = card.get_targets(game)\n    chosen_targets: list[Any] = []\n    if target_specs:\n        for spec in target_specs:\n            target = player.choose_target(target_specs, spec)\n            # Validate against filter_fn if the spec provides one\n            filter_fn = getattr(spec, \"filter_fn\", None)\n            if filter_fn is not None and target is not None:\n                if not filter_fn(target):\n                    stack_zone.remove(card)\n                    hand.add(card)\n                    raise CastingError(\n                        f\"Cannot cast {card.name!r} — chosen target does not \"\n                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                    )\n            chosen_targets.append(target)\n\n    # 5b. Protection check — reject targets that have protection from this\n    #     spell (the T in DEBT).\n    from engine.protection import has_protection_from\n\n    for target in chosen_targets:\n        if has_protection_from(target, card):\n            # Rollback: move card from stack zone back to hand\n            stack_zone.remove(card)\n            hand.add(card)\n            raise CastingError(\n                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n            )\n\n    # Targets are stored on the StackObject (not the card) and passed\n    # through the resolve pipeline via on_resolve(game, targets=...).\n\n    # 6. Mana check / payment (rollback on failure)\n    # Ensure the card knows its controller so that cost_reduction() hooks\n    # (e.g. Embercleave counting attacking creatures you control) see the\n    # casting player, even for cards that were added to hand without an\n    # explicit controller assignment.\n    if card.controller is None:\n        card.controller = player\n    reduction = get_cost_reduction(game, card, player)\n    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n\n    if not player.mana_pool.can_pay(effective_cost):\n        # Rollback: move card from stack zone back to hand\n        stack_zone.remove(card)\n        hand.add(card)\n        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n\n    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n    player.mana_pool.pay(effective_cost)\n\n    # Store colors of mana spent on the card for mechanics like Converge\n    # that care about the colors used to cast the spell.\n    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n\n    # Store the amount of mana spent to cast the spell (for mechanics like\n    # Mana Sculpt that add mana equal to what was paid for a countered spell).\n    card.mana_spent = effective_cost.cmc  # type: ignore[attr-defined]\n\n    # 7. Call on_cast hook\n    card.on_cast(game)\n\n    # 8. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n    # Spell-cast triggers (e.g. casualty, prowess) fire after the spell is on\n    # the stack, so their triggered abilities are placed above it and resolve\n    # first.  Firing with no registered spell-cast triggers is a no-op.\n    game.trigger_manager.fire_event(\n        game,\n        SpellCastTriggeredEvent(\n            spell=stack_obj, player=player, card=card, controller=player\n        ),\n    )\n\n\n# ------------------------------------------------------------------\n# Cast spell without paying mana cost (free-cast from any zone)\n# ------------------------------------------------------------------\n\n\ndef cast_spell_free(\n    game: GameState,\n    player: Player,\n    card: CardImpl,\n    from_zone: Zone,\n) -> None:\n    \"\"\"Cast *card* without paying its mana cost, using the stack.\n\n    This is used by effects that allow casting from zones other than hand\n    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n    or cascade.\n\n    Pipeline\n    --------\n    1. **can_cast** — ask the card whether it can legally be cast (same\n       legality as :func:`cast_spell`, minus mana/timing constraints).\n    2. Move *card* from *from_zone* to the stack zone.\n    3. Choose targets (if applicable) with validation and protection check.\n    4. Call ``on_cast`` hook.\n    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n       resolution normally (permanents → battlefield, non-permanents →\n       graveyard).\n\n    No timing check or mana payment is performed.  The spell goes on the\n    stack and can be responded to normally (e.g. countered).\n\n    If targeting or other post-move checks fail, the card is rolled back\n    to its source zone.\n\n    Parameters:\n        game: The current game state.\n        player: The player casting the spell.\n        card: The card to cast.\n        from_zone: The zone the card is currently in.\n\n    Raises:\n        CastingError: If the card cannot be found in *from_zone* or\n            legality checks fail.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Ensure controller is set\n    card.controller = player\n    if card.owner is None:\n        card.owner = player\n\n    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 2. Locate card in source zone\n    source_zone_container = player.zones[from_zone]\n    if not source_zone_container.contains(card):\n        # Try to find the card in any player's zone\n        source_zone_container = None\n        for p in game.players:\n            z = p.zones[from_zone]\n            if z.contains(card):\n                source_zone_container = z\n                break\n\n    if source_zone_container is None or not source_zone_container.contains(card):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n        )\n\n    # Move card from source zone to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    source_zone_container.remove(card)\n    stack_zone.add(card)\n\n    # 3. Choose targets (with rollback on failure)\n    try:\n        target_specs = card.get_targets(game)\n        chosen_targets: list[Any] = []\n        if target_specs:\n            for spec in target_specs:\n                target = player.choose_target(target_specs, spec)\n                # Validate against filter_fn if the spec provides one\n                filter_fn = getattr(spec, \"filter_fn\", None)\n                if filter_fn is not None and target is not None:\n                    if not filter_fn(target):\n                        raise CastingError(\n                            f\"Cannot cast {card.name!r} — chosen target does not \"\n                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                        )\n                chosen_targets.append(target)\n\n        # Protection check — reject targets that have protection from this spell\n        from engine.protection import has_protection_from\n\n        for target in chosen_targets:\n            if has_protection_from(target, card):\n                raise CastingError(\n                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n                )\n    except Exception as exc:\n        # Rollback: move card from stack zone back to source zone\n        stack_zone.remove(card)\n        source_zone_container.add(card)\n        raise CastingError(str(exc)) from exc\n\n    # 4. Call on_cast hook\n    card.on_cast(game)\n\n    # 5. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n    # Fire spell-cast triggers for free-cast spells too (e.g. a spell cast\n    # from the graveyard still triggers \"whenever you cast\" abilities).\n    game.trigger_manager.fire_event(\n        game,\n        SpellCastTriggeredEvent(\n            spell=stack_obj, player=player, card=card, controller=player\n        ),\n    )\n\n\n# ------------------------------------------------------------------\n# Resolution (called when the stack pops)\n# ------------------------------------------------------------------\n\ndef _resolve_spell(\n    game: GameState,\n    card: CardImpl,\n    player: Player,\n    stack_obj: StackObject,\n) -> None:\n    \"\"\"Resolve *card* cast by *player*.\n\n    1. Call ``card.on_resolve(game, targets=targets)``.\n    2. Remove the card from the stack zone.\n    3. If the card is a permanent type, move it to the battlefield via\n       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n       registration and the ETB event).\n    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Read targets from the StackObject — the single source of truth.\n    # Set chosen_targets on the card just before resolution so that\n    # _get_chosen_target helpers (which read via getattr) work.\n    targets = stack_obj.targets\n    if targets is not None:\n        card.chosen_targets = targets  # type: ignore[attr-defined]\n\n    card.on_resolve(game)\n\n    if card.card_types & _PERMANENT_TYPES:\n        # Move from stack to battlefield via move_to_zone, which handles\n        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n    else:\n        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n        # A spell cast under an \"if it would be put into your graveyard,\n        # exile it instead\" effect (e.g. The Dawning Archaic) is redirected.\n        dest = (\n            Zone.EXILE\n            if getattr(card, \"_exile_instead_of_graveyard\", False)\n            else Zone.GRAVEYARD\n        )\n        move_to_zone(game, card, Zone.STACK, dest)\n\n\n# ------------------------------------------------------------------\n# Play land (special action — does not use the stack)\n# ------------------------------------------------------------------\n\ndef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n\n    Requirements (all must hold):\n\n    * *land_card* has :attr:`CardType.LAND`.\n    * *player* is the active player.\n    * Current phase is a main phase.\n    * The stack is empty.\n    * ``player.land_plays_remaining > 0``.\n    * The card is in the player's hand.\n\n    On success the card moves from hand to battlefield and\n    ``land_plays_remaining`` is decremented.\n\n    Raises:\n        CastingError: If any requirement is not met.\n    \"\"\"\n    # Must be a land\n    if CardType.LAND not in land_card.card_types:\n        raise CastingError(\n            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n        )\n\n    # Sorcery-speed timing (active player, main phase, stack empty)\n    if not is_sorcery_speed(game, player):\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — must be active player \"\n            \"during main phase with empty stack\"\n        )\n\n    # Land plays remaining\n    if player.land_plays_remaining <= 0:\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n        )\n\n    # Card must be in hand\n    hand = game.get_hand(player)\n    if not hand.contains(land_card):\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — card not in hand\"\n        )\n\n    # Ensure owner/controller are set so move_to_zone routes correctly.\n    if land_card.owner is None:\n        land_card.owner = player\n    land_card.controller = player\n\n    # Move from hand to battlefield via move_to_zone, which fires\n    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n    from engine.zones import move_to_zone\n    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n\n    # Decrement land plays\n    player.land_plays_remaining -= 1\n\n\ndef resolve_top(game: GameState) -> None:\n    \"\"\"Resolve the top spell/ability on the stack.\n\n    Pops the top item from the stack, calls its on_resolve callback,\n    then runs state-based actions.  If the stack is empty this is a no-op.\n    \"\"\"\n    if game.stack.is_empty():\n        return\n    from engine.state_based_actions import resolve_state_based_actions\n\n    obj = game.stack.pop()\n    obj.on_resolve(game)\n    resolve_state_based_actions(game)\n","numLines":530,"startLine":1,"totalLines":530}}}
