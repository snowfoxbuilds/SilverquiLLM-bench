{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VuGSzu4X2jwcWAzskVBqMU","type":"tool_result","content":"1\t\"\"\"Tests for extra turns infrastructure (FIFO queue in GameState).\n2\t\n3\tCovers:\n4\t- extra_turns attribute initialisation\n5\t- Granting an extra turn to the active player (consecutive turns)\n6\t- Normal turn order resumes after the extra turn is consumed\n7\t- Multiple extra turns queued in FIFO order\n8\t- Extra turns for different players interleave correctly\n9\t- Adding an extra turn *during* an extra turn\n10\t- Edge cases: empty queue, priority reset, turn number increments\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\timport pytest\n16\t\n17\tfrom engine.game_state import GameState\n18\tfrom engine.player import DeterministicPlayer\n19\tfrom engine.types import Phase, Step\n20\t\n21\t\n22\t# ---------------------------------------------------------------------------\n23\t# Helpers\n24\t# ---------------------------------------------------------------------------\n25\t\n26\t\n27\tdef _make_game() -> GameState:\n28\t    \"\"\"Create a minimal 2-player GameState for extra-turn tests.\"\"\"\n29\t    p0 = DeterministicPlayer(\"Alice\", [])\n30\t    p1 = DeterministicPlayer(\"Bob\", [])\n31\t    for p in (p0, p1):\n32\t        p.life = 20\n33\t    return GameState([p0, p1])\n34\t\n35\t\n36\tdef _end_turn(game: GameState) -> None:\n37\t    \"\"\"Fast-forward to CLEANUP and advance, simulating end-of-turn.\"\"\"\n38\t    game.phase = Phase.ENDING\n39\t    game.step = Step.CLEANUP\n40\t    game.advance_phase()\n41\t\n42\t\n43\t# ---------------------------------------------------------------------------\n44\t# Attribute initialisation\n45\t# ---------------------------------------------------------------------------\n46\t\n47\t\n48\tclass TestExtraTurnsAttribute:\n49\t    \"\"\"GameState.extra_turns should be an empty list by default.\"\"\"\n50\t\n51\t    def test_extra_turns_initialized_empty(self):\n52\t        game = _make_game()\n53\t        assert game.extra_turns == []\n54\t\n55\t    def test_extra_turns_is_mutable_list(self):\n56\t        game = _make_game()\n57\t        assert isinstance(game.extra_turns, list)\n58\t        # Should be appendable like a normal list\n59\t        game.extra_turns.append(0)\n60\t        assert len(game.extra_turns) == 1\n61\t\n62\t\n63\t# ---------------------------------------------------------------------------\n64\t# Single extra turn granted\n65\t# ---------------------------------------------------------------------------\n66\t\n67\t\n68\tclass TestExtraTurnGranted:\n69\t    \"\"\"Appending a player seat to extra_turns gives them the next turn.\"\"\"\n70\t\n71\t    def test_active_player_gets_consecutive_turn(self):\n72\t        \"\"\"Player 0 queues an extra turn; they should take turn 2.\"\"\"\n73\t        game = _make_game()\n74\t        assert game.active_player_index == 0\n75\t        game.extra_turns.append(0)\n76\t\n77\t        _end_turn(game)\n78\t\n79\t        assert game.active_player_index == 0\n80\t        assert game.turn_number == 2\n81\t        assert game.extra_turns == []\n82\t\n83\t    def test_opponent_gets_extra_turn(self):\n84\t        \"\"\"An effect grants player 1 an extra turn during player 0's turn.\"\"\"\n85\t        game = _make_game()\n86\t        game.extra_turns.append(1)\n87\t\n88\t        _end_turn(game)\n89\t\n90\t        assert game.active_player_index == 1\n91\t        assert game.turn_number == 2\n92\t        assert game.extra_turns == []\n93\t\n94\t    def test_turn_number_increments_on_extra_turn(self):\n95\t        \"\"\"Extra turns still increment the turn counter.\"\"\"\n96\t        game = _make_game()\n97\t        game.extra_turns.append(0)\n98\t\n99\t        _end_turn(game)\n100\t        assert game.turn_number == 2\n101\t\n102\t        _end_turn(game)\n103\t        assert game.turn_number == 3\n104\t\n105\t\n106\t# ---------------------------------------------------------------------------\n107\t# Normal turn order resumes after extra turn\n108\t# ---------------------------------------------------------------------------\n109\t\n110\t\n111\tclass TestNormalOrderResumes:\n112\t    \"\"\"After extra turns are exhausted, the normal alternation resumes.\"\"\"\n113\t\n114\t    def test_resumes_to_opponent_after_self_extra_turn(self):\n115\t        game = _make_game()\n116\t        game.extra_turns.append(0)\n117\t\n118\t        _end_turn(game)  # turn 2: extra for P0\n119\t        assert game.active_player_index == 0\n120\t\n121\t        _end_turn(game)  # turn 3: normal -> P1\n122\t        assert game.active_player_index == 1\n123\t\n124\t    def test_resumes_after_opponent_extra_turn(self):\n125\t        \"\"\"After P1 takes an inserted extra turn, normal rotation resumes\n126\t        from where it left off — P0 was the last *normal* active player,\n127\t        so the next normal turn belongs to P1 (P0 → P1(extra) → P1(normal)).\"\"\"\n128\t        game = _make_game()\n129\t        game.extra_turns.append(1)\n130\t\n131\t        _end_turn(game)  # turn 2: extra for P1\n132\t        assert game.active_player_index == 1\n133\t\n134\t        _end_turn(game)  # turn 3: normal rotation from P0 → P1\n135\t        assert game.active_player_index == 1\n136\t\n137\t    def test_empty_queue_normal_alternation(self):\n138\t        \"\"\"With no extra turns queued, turns alternate normally.\"\"\"\n139\t        game = _make_game()\n140\t\n141\t        _end_turn(game)\n142\t        assert game.active_player_index == 1\n143\t\n144\t        _end_turn(game)\n145\t        assert game.active_player_index == 0\n146\t\n147\t\n148\t# ---------------------------------------------------------------------------\n149\t# Multiple extra turns — FIFO ordering\n150\t# ---------------------------------------------------------------------------\n151\t\n152\t\n153\tclass TestMultipleExtraTurnsFIFO:\n154\t    \"\"\"Multiple extra turns must be processed first-in, first-out.\"\"\"\n155\t\n156\t    def test_two_extra_turns_same_player(self):\n157\t        game = _make_game()\n158\t        game.extra_turns.extend([0, 0])\n159\t\n160\t        _end_turn(game)\n161\t        assert game.active_player_index == 0\n162\t        assert len(game.extra_turns) == 1\n163\t\n164\t        _end_turn(game)\n165\t        assert game.active_player_index == 0\n166\t        assert game.extra_turns == []\n167\t\n168\t        _end_turn(game)  # normal: -> P1\n169\t        assert game.active_player_index == 1\n170\t\n171\t    def test_fifo_different_players(self):\n172\t        \"\"\"Queue [P0, P1] — P0's extra first, then P1's extra.\"\"\"\n173\t        game = _make_game()\n174\t        game.extra_turns.extend([0, 1])\n175\t\n176\t        _end_turn(game)\n177\t        assert game.active_player_index == 0\n178\t\n179\t        _end_turn(game)\n180\t        assert game.active_player_index == 1\n181\t\n182\t    def test_three_extras_interleaved(self):\n183\t        \"\"\"Queue [P0, P1, P0] — should pop in that exact order.\"\"\"\n184\t        game = _make_game()\n185\t        game.extra_turns.extend([0, 1, 0])\n186\t\n187\t        results = []\n188\t        for _ in range(3):\n189\t            _end_turn(game)\n190\t            results.append(game.active_player_index)\n191\t\n192\t        assert results == [0, 1, 0]\n193\t        assert game.extra_turns == []\n194\t\n195\t    def test_normal_order_resumes_after_all_extras_consumed(self):\n196\t        \"\"\"After [P0, P1] extras, normal alternation resumes from the last\n197\t        *normal* turn (P0), so next normal turn is P1.\"\"\"\n198\t        game = _make_game()\n199\t        game.extra_turns.extend([0, 1])\n200\t\n201\t        _end_turn(game)  # extra P0\n202\t        _end_turn(game)  # extra P1\n203\t\n204\t        _end_turn(game)  # normal: P0 was last normal → P1\n205\t        assert game.active_player_index == 1\n206\t\n207\t\n208\t# ---------------------------------------------------------------------------\n209\t# Extra turn during an extra turn\n210\t# ---------------------------------------------------------------------------\n211\t\n212\t\n213\tclass TestExtraTurnDuringExtraTurn:\n214\t    \"\"\"Queueing an extra turn while taking an extra turn should work.\"\"\"\n215\t\n216\t    def test_queue_extra_during_extra(self):\n217\t        \"\"\"P0 gets an extra turn, then during that extra turn queues another.\"\"\"\n218\t        game = _make_game()\n219\t        game.extra_turns.append(0)\n220\t\n221\t        _end_turn(game)  # extra turn for P0\n222\t        assert game.active_player_index == 0\n223\t\n224\t        # During the extra turn, another extra turn is granted\n225\t        game.extra_turns.append(0)\n226\t\n227\t        _end_turn(game)  # second extra for P0\n228\t        assert game.active_player_index == 0\n229\t\n230\t        _end_turn(game)  # normal -> P1\n231\t        assert game.active_player_index == 1\n232\t\n233\t    def test_queue_opponent_extra_during_own_extra(self):\n234\t        \"\"\"P0 takes extra turn, queues extra for P1 during it.\n235\t        Normal rotation still tracks P0 as last normal, so after\n236\t        extras: P0(extra) → P1(extra) → P1(normal).\"\"\"\n237\t        game = _make_game()\n238\t        game.extra_turns.append(0)\n239\t\n240\t        _end_turn(game)\n241\t        assert game.active_player_index == 0\n242\t\n243\t        game.extra_turns.append(1)\n244\t\n245\t        _end_turn(game)\n246\t        assert game.active_player_index == 1\n247\t\n248\t        _end_turn(game)  # normal: P0 was last normal → P1\n249\t        assert game.active_player_index == 1\n250\t\n251\t\n252\t# ---------------------------------------------------------------------------\n253\t# Priority and phase reset on extra turn\n254\t# ---------------------------------------------------------------------------\n255\t\n256\t\n257\tclass TestPriorityAndPhaseReset:\n258\t    \"\"\"On a new turn (including extra), priority and phase should reset.\"\"\"\n259\t\n260\t    def test_priority_set_to_active_player_on_extra_turn(self):\n261\t        game = _make_game()\n262\t        game.extra_turns.append(0)\n263\t        game.priority_player_index = 1  # opponent had priority\n264\t\n265\t        _end_turn(game)\n266\t\n267\t        assert game.priority_player_index == 0\n268\t\n269\t    def test_phase_resets_to_beginning_on_extra_turn(self):\n270\t        game = _make_game()\n271\t        game.extra_turns.append(0)\n272\t\n273\t        _end_turn(game)\n274\t\n275\t        assert game.phase == Phase.BEGINNING\n276\t        assert game.step == Step.UNTAP\n277\t"}]},"parent_tool_use_id":null,"session_id":"b76fbb6d-7052-44e0-893e-8a2c1cc9d4a6","uuid":"0361be36-456e-4fcb-bb70-3d0341ca675c","timestamp":"2026-05-30T04:18:46.246Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine_tests/test_extra_turns.py","content":"\"\"\"Tests for extra turns infrastructure (FIFO queue in GameState).\n\nCovers:\n- extra_turns attribute initialisation\n- Granting an extra turn to the active player (consecutive turns)\n- Normal turn order resumes after the extra turn is consumed\n- Multiple extra turns queued in FIFO order\n- Extra turns for different players interleave correctly\n- Adding an extra turn *during* an extra turn\n- Edge cases: empty queue, priority reset, turn number increments\n\"\"\"\n\nfrom __future__ import annotations\n\nimport pytest\n\nfrom engine.game_state import GameState\nfrom engine.player import DeterministicPlayer\nfrom engine.types import Phase, Step\n\n\n# ---------------------------------------------------------------------------\n# Helpers\n# ---------------------------------------------------------------------------\n\n\ndef _make_game() -> GameState:\n    \"\"\"Create a minimal 2-player GameState for extra-turn tests.\"\"\"\n    p0 = DeterministicPlayer(\"Alice\", [])\n    p1 = DeterministicPlayer(\"Bob\", [])\n    for p in (p0, p1):\n        p.life = 20\n    return GameState([p0, p1])\n\n\ndef _end_turn(game: GameState) -> None:\n    \"\"\"Fast-forward to CLEANUP and advance, simulating end-of-turn.\"\"\"\n    game.phase = Phase.ENDING\n    game.step = Step.CLEANUP\n    game.advance_phase()\n\n\n# ---------------------------------------------------------------------------\n# Attribute initialisation\n# ---------------------------------------------------------------------------\n\n\nclass TestExtraTurnsAttribute:\n    \"\"\"GameState.extra_turns should be an empty list by default.\"\"\"\n\n    def test_extra_turns_initialized_empty(self):\n        game = _make_game()\n        assert game.extra_turns == []\n\n    def test_extra_turns_is_mutable_list(self):\n        game = _make_game()\n        assert isinstance(game.extra_turns, list)\n        # Should be appendable like a normal list\n        game.extra_turns.append(0)\n        assert len(game.extra_turns) == 1\n\n\n# ---------------------------------------------------------------------------\n# Single extra turn granted\n# ---------------------------------------------------------------------------\n\n\nclass TestExtraTurnGranted:\n    \"\"\"Appending a player seat to extra_turns gives them the next turn.\"\"\"\n\n    def test_active_player_gets_consecutive_turn(self):\n        \"\"\"Player 0 queues an extra turn; they should take turn 2.\"\"\"\n        game = _make_game()\n        assert game.active_player_index == 0\n        game.extra_turns.append(0)\n\n        _end_turn(game)\n\n        assert game.active_player_index == 0\n        assert game.turn_number == 2\n        assert game.extra_turns == []\n\n    def test_opponent_gets_extra_turn(self):\n        \"\"\"An effect grants player 1 an extra turn during player 0's turn.\"\"\"\n        game = _make_game()\n        game.extra_turns.append(1)\n\n        _end_turn(game)\n\n        assert game.active_player_index == 1\n        assert game.turn_number == 2\n        assert game.extra_turns == []\n\n    def test_turn_number_increments_on_extra_turn(self):\n        \"\"\"Extra turns still increment the turn counter.\"\"\"\n        game = _make_game()\n        game.extra_turns.append(0)\n\n        _end_turn(game)\n        assert game.turn_number == 2\n\n        _end_turn(game)\n        assert game.turn_number == 3\n\n\n# ---------------------------------------------------------------------------\n# Normal turn order resumes after extra turn\n# ---------------------------------------------------------------------------\n\n\nclass TestNormalOrderResumes:\n    \"\"\"After extra turns are exhausted, the normal alternation resumes.\"\"\"\n\n    def test_resumes_to_opponent_after_self_extra_turn(self):\n        game = _make_game()\n        game.extra_turns.append(0)\n\n        _end_turn(game)  # turn 2: extra for P0\n        assert game.active_player_index == 0\n\n        _end_turn(game)  # turn 3: normal -> P1\n        assert game.active_player_index == 1\n\n    def test_resumes_after_opponent_extra_turn(self):\n        \"\"\"After P1 takes an inserted extra turn, normal rotation resumes\n        from where it left off — P0 was the last *normal* active player,\n        so the next normal turn belongs to P1 (P0 → P1(extra) → P1(normal)).\"\"\"\n        game = _make_game()\n        game.extra_turns.append(1)\n\n        _end_turn(game)  # turn 2: extra for P1\n        assert game.active_player_index == 1\n\n        _end_turn(game)  # turn 3: normal rotation from P0 → P1\n        assert game.active_player_index == 1\n\n    def test_empty_queue_normal_alternation(self):\n        \"\"\"With no extra turns queued, turns alternate normally.\"\"\"\n        game = _make_game()\n\n        _end_turn(game)\n        assert game.active_player_index == 1\n\n        _end_turn(game)\n        assert game.active_player_index == 0\n\n\n# ---------------------------------------------------------------------------\n# Multiple extra turns — FIFO ordering\n# ---------------------------------------------------------------------------\n\n\nclass TestMultipleExtraTurnsFIFO:\n    \"\"\"Multiple extra turns must be processed first-in, first-out.\"\"\"\n\n    def test_two_extra_turns_same_player(self):\n        game = _make_game()\n        game.extra_turns.extend([0, 0])\n\n        _end_turn(game)\n        assert game.active_player_index == 0\n        assert len(game.extra_turns) == 1\n\n        _end_turn(game)\n        assert game.active_player_index == 0\n        assert game.extra_turns == []\n\n        _end_turn(game)  # normal: -> P1\n        assert game.active_player_index == 1\n\n    def test_fifo_different_players(self):\n        \"\"\"Queue [P0, P1] — P0's extra first, then P1's extra.\"\"\"\n        game = _make_game()\n        game.extra_turns.extend([0, 1])\n\n        _end_turn(game)\n        assert game.active_player_index == 0\n\n        _end_turn(game)\n        assert game.active_player_index == 1\n\n    def test_three_extras_interleaved(self):\n        \"\"\"Queue [P0, P1, P0] — should pop in that exact order.\"\"\"\n        game = _make_game()\n        game.extra_turns.extend([0, 1, 0])\n\n        results = []\n        for _ in range(3):\n            _end_turn(game)\n            results.append(game.active_player_index)\n\n        assert results == [0, 1, 0]\n        assert game.extra_turns == []\n\n    def test_normal_order_resumes_after_all_extras_consumed(self):\n        \"\"\"After [P0, P1] extras, normal alternation resumes from the last\n        *normal* turn (P0), so next normal turn is P1.\"\"\"\n        game = _make_game()\n        game.extra_turns.extend([0, 1])\n\n        _end_turn(game)  # extra P0\n        _end_turn(game)  # extra P1\n\n        _end_turn(game)  # normal: P0 was last normal → P1\n        assert game.active_player_index == 1\n\n\n# ---------------------------------------------------------------------------\n# Extra turn during an extra turn\n# ---------------------------------------------------------------------------\n\n\nclass TestExtraTurnDuringExtraTurn:\n    \"\"\"Queueing an extra turn while taking an extra turn should work.\"\"\"\n\n    def test_queue_extra_during_extra(self):\n        \"\"\"P0 gets an extra turn, then during that extra turn queues another.\"\"\"\n        game = _make_game()\n        game.extra_turns.append(0)\n\n        _end_turn(game)  # extra turn for P0\n        assert game.active_player_index == 0\n\n        # During the extra turn, another extra turn is granted\n        game.extra_turns.append(0)\n\n        _end_turn(game)  # second extra for P0\n        assert game.active_player_index == 0\n\n        _end_turn(game)  # normal -> P1\n        assert game.active_player_index == 1\n\n    def test_queue_opponent_extra_during_own_extra(self):\n        \"\"\"P0 takes extra turn, queues extra for P1 during it.\n        Normal rotation still tracks P0 as last normal, so after\n        extras: P0(extra) → P1(extra) → P1(normal).\"\"\"\n        game = _make_game()\n        game.extra_turns.append(0)\n\n        _end_turn(game)\n        assert game.active_player_index == 0\n\n        game.extra_turns.append(1)\n\n        _end_turn(game)\n        assert game.active_player_index == 1\n\n        _end_turn(game)  # normal: P0 was last normal → P1\n        assert game.active_player_index == 1\n\n\n# ---------------------------------------------------------------------------\n# Priority and phase reset on extra turn\n# ---------------------------------------------------------------------------\n\n\nclass TestPriorityAndPhaseReset:\n    \"\"\"On a new turn (including extra), priority and phase should reset.\"\"\"\n\n    def test_priority_set_to_active_player_on_extra_turn(self):\n        game = _make_game()\n        game.extra_turns.append(0)\n        game.priority_player_index = 1  # opponent had priority\n\n        _end_turn(game)\n\n        assert game.priority_player_index == 0\n\n    def test_phase_resets_to_beginning_on_extra_turn(self):\n        game = _make_game()\n        game.extra_turns.append(0)\n\n        _end_turn(game)\n\n        assert game.phase == Phase.BEGINNING\n        assert game.step == Step.UNTAP\n","numLines":277,"startLine":1,"totalLines":277}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SHW7czFtpCuoXwDm9F4w23","type":"tool_result","content":"1\t\"\"\"Tests for engine/triggers.py — Triggered abilities system.\n2\t\n3\tVerifies:\n4\t- EventType enum members and values.\n5\t- TriggerRegistration dataclass construction and fields.\n6\t- TriggerManager register/unregister/get_triggers/get_triggers_for_source/clear.\n7\t- TriggerManager.fire_event pushes StackObjects for matching triggers.\n8\t- fire_event with non-matching event type → nothing pushed.\n9\t- Condition filtering: triggers only fire when condition returns True.\n10\t- Condition filtering: triggers do NOT fire when condition returns False.\n11\t- fire_event data parameter passed to condition.\n12\t- APNAP ordering: active player triggers pushed first (bottom), non-active on top.\n13\t- Registration-order preserved within same player.\n14\t- Unregister removes all triggers for a source (identity-based).\n15\t- Integration: GameState.trigger_manager is TriggerManager instance.\n16\t- ETB scenario: card enters battlefield → register_triggers → fire event → StackObject.\n17\t- Unregister on leave → fire event → nothing.\n18\t- Multiple triggers from different sources for same event → all pushed.\n19\t- Data dict forwarded to condition callable.\n20\t\"\"\"\n21\tfrom __future__ import annotations\n22\timport pytest\n23\tfrom engine.card import CardImpl, Creature\n24\tfrom engine.game_state import GameState\n25\tfrom engine.player import DeterministicPlayer\n26\tfrom engine.stack import StackObject\n27\tfrom engine.triggers import TriggerManager, TriggerRegistration\n28\tfrom engine.types import Zone\n29\tfrom engine.events import AttacksTriggeredEvent, BeginningOfUpkeepTriggeredEvent, CreatureDiesTriggeredEvent, DealsDamageTriggeredEvent, EndOfTurnTriggeredEvent, EntersBattlefieldTriggeredEvent, GainsLifeTriggeredEvent, SpellCastTriggeredEvent\n30\t\n31\t@pytest.fixture()\n32\tdef players() -> list[DeterministicPlayer]:\n33\t    \"\"\"Create two DeterministicPlayers.\"\"\"\n34\t    return [DeterministicPlayer('Alice', script=[]), DeterministicPlayer('Bob', script=[])]\n35\t\n36\t@pytest.fixture()\n37\tdef game(players: list[DeterministicPlayer]) -> GameState:\n38\t    \"\"\"Create a GameState with two players.\"\"\"\n39\t    return GameState(players)\n40\t\n41\tdef _make_trigger(event_type: type, source: object, controller: DeterministicPlayer, *, condition=None, effect=None) -> TriggerRegistration:\n42\t    \"\"\"Convenience to build a TriggerRegistration with sensible defaults.\"\"\"\n43\t    return TriggerRegistration(event_type=event_type, condition=condition, effect=effect or (lambda g: None), source=source, controller=controller)\n44\t\n45\tclass TestTriggerRegistration:\n46\t    \"\"\"TriggerRegistration dataclass stores all fields correctly.\"\"\"\n47\t\n48\t    def test_construction_with_all_fields(self, players: list[DeterministicPlayer]) -> None:\n49\t        \"\"\"All five required fields are stored on construction.\"\"\"\n50\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n51\t        cond = lambda g, d: True\n52\t        effect = lambda g: None\n53\t        reg = TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=cond, effect=effect, source=source, controller=players[0])\n54\t        assert reg.event_type is EntersBattlefieldTriggeredEvent\n55\t        assert reg.condition is cond\n56\t        assert reg.effect is effect\n57\t        assert reg.source is source\n58\t        assert reg.controller is players[0]\n59\t\n60\t    def test_condition_none_allowed(self, players: list[DeterministicPlayer]) -> None:\n61\t        \"\"\"condition=None means 'always fires for event type'.\"\"\"\n62\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n63\t        reg = TriggerRegistration(event_type=CreatureDiesTriggeredEvent, condition=None, effect=lambda g: None, source=source, controller=players[0])\n64\t        assert reg.condition is None\n65\t\n66\t    def test_source_can_be_any_object(self, players: list[DeterministicPlayer]) -> None:\n67\t        \"\"\"source field accepts any game object (not just Creature).\"\"\"\n68\t        source = object()\n69\t        reg = _make_trigger(SpellCastTriggeredEvent, source, players[0])\n70\t        assert reg.source is source\n71\t\n72\tclass TestTriggerManagerBasic:\n73\t    \"\"\"TriggerManager register, unregister, get_triggers, get_triggers_for_source, clear.\"\"\"\n74\t\n75\t    def test_initial_empty(self) -> None:\n76\t        \"\"\"A new TriggerManager has no triggers.\"\"\"\n77\t        tm = TriggerManager()\n78\t        assert tm.get_triggers() == []\n79\t\n80\t    def test_register_adds_trigger(self, players: list[DeterministicPlayer]) -> None:\n81\t        \"\"\"register() should add the trigger to the internal list.\"\"\"\n82\t        tm = TriggerManager()\n83\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n84\t        reg = _make_trigger(EntersBattlefieldTriggeredEvent, source, players[0])\n85\t        tm.register(reg)\n86\t        assert len(tm.get_triggers()) == 1\n87\t        assert tm.get_triggers()[0] is reg\n88\t\n89\t    def test_register_multiple_triggers(self, players: list[DeterministicPlayer]) -> None:\n90\t        \"\"\"Multiple registrations should accumulate.\"\"\"\n91\t        tm = TriggerManager()\n92\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n93\t        r1 = _make_trigger(EntersBattlefieldTriggeredEvent, source, players[0])\n94\t        r2 = _make_trigger(CreatureDiesTriggeredEvent, source, players[0])\n95\t        tm.register(r1)\n96\t        tm.register(r2)\n97\t        assert len(tm.get_triggers()) == 2\n98\t\n99\t    def test_get_triggers_returns_copy(self, players: list[DeterministicPlayer]) -> None:\n100\t        \"\"\"get_triggers() should return a shallow copy — mutating it does not affect the manager.\"\"\"\n101\t        tm = TriggerManager()\n102\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n103\t        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, source, players[0]))\n104\t        copy = tm.get_triggers()\n105\t        copy.clear()\n106\t        assert len(tm.get_triggers()) == 1\n107\t\n108\tclass TestTriggerManagerUnregister:\n109\t    \"\"\"Unregister removes all triggers for a given source object.\"\"\"\n110\t\n111\t    def test_unregister_removes_all_triggers_for_source(self, players: list[DeterministicPlayer]) -> None:\n112\t        \"\"\"unregister(source) should remove every trigger whose source is that object.\"\"\"\n113\t        tm = TriggerManager()\n114\t        bear = Creature(name='Bear', owner=players[0], controller=players[0])\n115\t        elf = Creature(name='Elf', owner=players[0], controller=players[0])\n116\t        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, bear, players[0]))\n117\t        tm.register(_make_trigger(CreatureDiesTriggeredEvent, bear, players[0]))\n118\t        tm.register(_make_trigger(AttacksTriggeredEvent, elf, players[0]))\n119\t        tm.unregister(bear)\n120\t        remaining = tm.get_triggers()\n121\t        assert len(remaining) == 1\n122\t        assert remaining[0].source is elf\n123\t\n124\t    def test_unregister_is_identity_based(self, players: list[DeterministicPlayer]) -> None:\n125\t        \"\"\"Unregister uses `is` (identity), not `==` (equality).\"\"\"\n126\t        tm = TriggerManager()\n127\t        bear1 = Creature(name='Bear', owner=players[0], controller=players[0])\n128\t        bear2 = Creature(name='Bear', owner=players[0], controller=players[0])\n129\t        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, bear1, players[0]))\n130\t        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, bear2, players[0]))\n131\t        tm.unregister(bear1)\n132\t        assert len(tm.get_triggers()) == 1\n133\t        assert tm.get_triggers()[0].source is bear2\n134\t\n135\t    def test_unregister_nonexistent_source_is_noop(self) -> None:\n136\t        \"\"\"Unregistering a source with no triggers should not raise.\"\"\"\n137\t        tm = TriggerManager()\n138\t        tm.unregister(object())\n139\t        assert tm.get_triggers() == []\n140\t\n141\t    def test_unregister_leaves_other_sources_intact(self, players: list[DeterministicPlayer]) -> None:\n142\t        \"\"\"After unregister, triggers from other sources must remain.\"\"\"\n143\t        tm = TriggerManager()\n144\t        bear = Creature(name='Bear', owner=players[0], controller=players[0])\n145\t        elf = Creature(name='Elf', owner=players[1], controller=players[1])\n146\t        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, bear, players[0]))\n147\t        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, elf, players[1]))\n148\t        tm.unregister(bear)\n149\t        assert len(tm.get_triggers()) == 1\n150\t        assert tm.get_triggers()[0].source is elf\n151\t\n152\tclass TestTriggerManagerGetTriggersForSource:\n153\t    \"\"\"get_triggers_for_source filters by source identity.\"\"\"\n154\t\n155\t    def test_returns_only_matching_source(self, players: list[DeterministicPlayer]) -> None:\n156\t        tm = TriggerManager()\n157\t        bear = Creature(name='Bear', owner=players[0], controller=players[0])\n158\t        elf = Creature(name='Elf', owner=players[0], controller=players[0])\n159\t        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, bear, players[0]))\n160\t        tm.register(_make_trigger(CreatureDiesTriggeredEvent, bear, players[0]))\n161\t        tm.register(_make_trigger(AttacksTriggeredEvent, elf, players[0]))\n162\t        bear_triggers = tm.get_triggers_for_source(bear)\n163\t        assert len(bear_triggers) == 2\n164\t        assert all((t.source is bear for t in bear_triggers))\n165\t\n166\t    def test_returns_empty_for_unknown_source(self) -> None:\n167\t        tm = TriggerManager()\n168\t        assert tm.get_triggers_for_source(object()) == []\n169\t\n170\tclass TestTriggerManagerClear:\n171\t    \"\"\"clear() removes all triggers.\"\"\"\n172\t\n173\t    def test_clear_empties_all(self, players: list[DeterministicPlayer]) -> None:\n174\t        tm = TriggerManager()\n175\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n176\t        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, source, players[0]))\n177\t        tm.register(_make_trigger(CreatureDiesTriggeredEvent, source, players[0]))\n178\t        tm.clear()\n179\t        assert tm.get_triggers() == []\n180\t\n181\tclass TestFireEvent:\n182\t    \"\"\"fire_event pushes matching triggers onto the game stack.\"\"\"\n183\t\n184\t    def test_matching_trigger_pushes_stack_object(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n185\t        \"\"\"A registered ETB trigger fires when ENTERS_BATTLEFIELD is fired.\"\"\"\n186\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n187\t        game.trigger_manager.register(_make_trigger(EntersBattlefieldTriggeredEvent, source, players[0]))\n188\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n189\t        assert not game.stack.is_empty()\n190\t        stack_obj = game.stack.peek()\n191\t        assert isinstance(stack_obj, StackObject)\n192\t        assert stack_obj.source is source\n193\t        assert stack_obj.controller is players[0]\n194\t\n195\t    def test_stack_object_on_resolve_invokes_effect(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n196\t        \"\"\"The StackObject's on_resolve should call the trigger's effect callback.\"\"\"\n197\t        calls: list[str] = []\n198\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n199\t        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=None, effect=lambda g: calls.append('resolved'), source=source, controller=players[0]))\n200\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n201\t        stack_obj = game.stack.pop()\n202\t        stack_obj.on_resolve(game)\n203\t        assert calls == ['resolved']\n204\t\n205\t    def test_non_matching_event_type_pushes_nothing(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n206\t        \"\"\"Firing a different event type should not push any StackObject.\"\"\"\n207\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n208\t        game.trigger_manager.register(_make_trigger(EntersBattlefieldTriggeredEvent, source, players[0]))\n209\t        game.trigger_manager.fire_event(game, CreatureDiesTriggeredEvent())\n210\t        assert game.stack.is_empty()\n211\t\n212\t    def test_no_registered_triggers_pushes_nothing(self, game: GameState) -> None:\n213\t        \"\"\"Firing an event with no registered triggers should leave the stack empty.\"\"\"\n214\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n215\t        assert game.stack.is_empty()\n216\t\n217\t    def test_condition_true_fires_trigger(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n218\t        \"\"\"When condition returns True, the trigger should fire.\"\"\"\n219\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n220\t        game.trigger_manager.register(TriggerRegistration(event_type=DealsDamageTriggeredEvent, condition=lambda g, event: True, effect=lambda g: None, source=source, controller=players[0]))\n221\t        game.trigger_manager.fire_event(game, DealsDamageTriggeredEvent(amount=3))\n222\t        assert not game.stack.is_empty()\n223\t\n224\t    def test_condition_false_does_not_fire_trigger(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n225\t        \"\"\"When condition returns False, the trigger should NOT fire.\"\"\"\n226\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n227\t        game.trigger_manager.register(TriggerRegistration(event_type=DealsDamageTriggeredEvent, condition=lambda g, event: False, effect=lambda g: None, source=source, controller=players[0]))\n228\t        game.trigger_manager.fire_event(game, DealsDamageTriggeredEvent(amount=3))\n229\t        assert game.stack.is_empty()\n230\t\n231\t    def test_condition_none_always_fires(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n232\t        \"\"\"A trigger with condition=None should always fire for matching event.\"\"\"\n233\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n234\t        game.trigger_manager.register(_make_trigger(GainsLifeTriggeredEvent, source, players[0], condition=None))\n235\t        game.trigger_manager.fire_event(game, GainsLifeTriggeredEvent())\n236\t        assert not game.stack.is_empty()\n237\t\n238\t    def test_condition_receives_data_dict(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n239\t        \"\"\"The condition callable should receive (game, event) where event is the typed event object.\"\"\"\n240\t        received_args: list[tuple] = []\n241\t\n242\t        def cond(g, e):\n243\t            received_args.append((g, e))\n244\t            return True\n245\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n246\t        game.trigger_manager.register(TriggerRegistration(event_type=DealsDamageTriggeredEvent, condition=cond, effect=lambda g: None, source=source, controller=players[0]))\n247\t        event = DealsDamageTriggeredEvent(amount=5)\n248\t        game.trigger_manager.fire_event(game, event)\n249\t        assert len(received_args) == 1\n250\t        assert received_args[0][0] is game\n251\t        assert received_args[0][1] is event\n252\t\n253\t    def test_fire_event_without_data_passes_empty_dict(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n254\t        \"\"\"Calling fire_event passes the typed event object to condition.\"\"\"\n255\t        received_data: list = []\n256\t\n257\t        def cond(g, e):\n258\t            received_data.append(e)\n259\t            return True\n260\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n261\t        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=cond, effect=lambda g: None, source=source, controller=players[0]))\n262\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n263\t        assert len(received_data) == 1\n264\t        assert isinstance(received_data[0], EntersBattlefieldTriggeredEvent)\n265\t\n266\t    def test_multiple_triggers_same_event_all_pushed(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n267\t        \"\"\"Three triggers for the same event → three StackObjects pushed.\"\"\"\n268\t        sources = []\n269\t        for i in range(3):\n270\t            src = Creature(name=f'Bear{i}', owner=players[0], controller=players[0])\n271\t            sources.append(src)\n272\t            game.trigger_manager.register(_make_trigger(EntersBattlefieldTriggeredEvent, src, players[0]))\n273\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n274\t        assert len(game.stack.objects()) == 3\n275\t\n276\t    def test_mixed_matching_and_nonmatching_only_matching_pushed(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n277\t        \"\"\"Only triggers matching the fired event type should be pushed.\"\"\"\n278\t        src_etb = Creature(name='ETB', owner=players[0], controller=players[0])\n279\t        src_die = Creature(name='DIE', owner=players[0], controller=players[0])\n280\t        game.trigger_manager.register(_make_trigger(EntersBattlefieldTriggeredEvent, src_etb, players[0]))\n281\t        game.trigger_manager.register(_make_trigger(CreatureDiesTriggeredEvent, src_die, players[0]))\n282\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n283\t        assert len(game.stack.objects()) == 1\n284\t        assert game.stack.peek().source is src_etb\n285\t\n286\t    def test_condition_uses_data_to_filter(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n287\t        \"\"\"Condition can inspect data dict to decide whether to fire.\"\"\"\n288\t        source = Creature(name='Lifelinker', owner=players[0], controller=players[0])\n289\t        game.trigger_manager.register(TriggerRegistration(event_type=GainsLifeTriggeredEvent, condition=lambda g, event: event.amount >= 5, effect=lambda g: None, source=source, controller=players[0]))\n290\t        game.trigger_manager.fire_event(game, GainsLifeTriggeredEvent(amount=3))\n291\t        assert game.stack.is_empty()\n292\t        game.trigger_manager.fire_event(game, GainsLifeTriggeredEvent(amount=5))\n293\t        assert not game.stack.is_empty()\n294\t\n295\tclass TestAPNAPOrdering:\n296\t    \"\"\"APNAP: Active player's triggers pushed first (bottom), non-active player's on top.\"\"\"\n297\t\n298\t    def test_active_player_triggers_at_bottom_non_active_on_top(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n299\t        \"\"\"Active player's triggers end up at the bottom of the stack batch;\n300\t        non-active player's triggers are on top (resolve first).\"\"\"\n301\t        active = players[game.active_player_index]\n302\t        non_active = players[1 - game.active_player_index]\n303\t        active_src = Creature(name='A', owner=active, controller=active)\n304\t        nap_src = Creature(name='N', owner=non_active, controller=non_active)\n305\t        game.trigger_manager.register(_make_trigger(BeginningOfUpkeepTriggeredEvent, active_src, active))\n306\t        game.trigger_manager.register(_make_trigger(BeginningOfUpkeepTriggeredEvent, nap_src, non_active))\n307\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n308\t        stack_objs = game.stack.objects()\n309\t        assert len(stack_objs) == 2\n310\t        assert stack_objs[0].controller is non_active\n311\t        assert stack_objs[1].controller is active\n312\t\n313\t    def test_apnap_ordering_regardless_of_registration_order(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n314\t        \"\"\"APNAP ordering should hold even if non-active player's trigger is registered first.\"\"\"\n315\t        active = players[game.active_player_index]\n316\t        non_active = players[1 - game.active_player_index]\n317\t        active_src = Creature(name='A', owner=active, controller=active)\n318\t        nap_src = Creature(name='N', owner=non_active, controller=non_active)\n319\t        game.trigger_manager.register(_make_trigger(EndOfTurnTriggeredEvent, nap_src, non_active))\n320\t        game.trigger_manager.register(_make_trigger(EndOfTurnTriggeredEvent, active_src, active))\n321\t        game.trigger_manager.fire_event(game, EndOfTurnTriggeredEvent())\n322\t        stack_objs = game.stack.objects()\n323\t        assert len(stack_objs) == 2\n324\t        assert stack_objs[0].controller is non_active\n325\t        assert stack_objs[1].controller is active\n326\t\n327\t    def test_registration_order_preserved_within_same_player(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n328\t        \"\"\"Triggers from the same player maintain registration order (pushed in that order).\"\"\"\n329\t        active = players[game.active_player_index]\n330\t        src1 = Creature(name='First', owner=active, controller=active)\n331\t        src2 = Creature(name='Second', owner=active, controller=active)\n332\t        game.trigger_manager.register(_make_trigger(BeginningOfUpkeepTriggeredEvent, src1, active))\n333\t        game.trigger_manager.register(_make_trigger(BeginningOfUpkeepTriggeredEvent, src2, active))\n334\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n335\t        stack_objs = game.stack.objects()\n336\t        assert len(stack_objs) == 2\n337\t        assert stack_objs[0].source is src2\n338\t        assert stack_objs[1].source is src1\n339\t\n340\t    def test_apnap_with_multiple_triggers_per_player(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n341\t        \"\"\"With multiple triggers per player, all active player's come before non-active's.\"\"\"\n342\t        active = players[game.active_player_index]\n343\t        non_active = players[1 - game.active_player_index]\n344\t        a1 = Creature(name='A1', owner=active, controller=active)\n345\t        a2 = Creature(name='A2', owner=active, controller=active)\n346\t        n1 = Creature(name='N1', owner=non_active, controller=non_active)\n347\t        n2 = Creature(name='N2', owner=non_active, controller=non_active)\n348\t        game.trigger_manager.register(_make_trigger(EndOfTurnTriggeredEvent, a1, active))\n349\t        game.trigger_manager.register(_make_trigger(EndOfTurnTriggeredEvent, n1, non_active))\n350\t        game.trigger_manager.register(_make_trigger(EndOfTurnTriggeredEvent, a2, active))\n351\t        game.trigger_manager.register(_make_trigger(EndOfTurnTriggeredEvent, n2, non_active))\n352\t        game.trigger_manager.fire_event(game, EndOfTurnTriggeredEvent())\n353\t        stack_objs = game.stack.objects()\n354\t        assert len(stack_objs) == 4\n355\t        assert stack_objs[0].controller is non_active\n356\t        assert stack_objs[1].controller is non_active\n357\t        assert stack_objs[2].controller is active\n358\t        assert stack_objs[3].controller is active\n359\t\n360\tclass TestGameStateIntegration:\n361\t    \"\"\"GameState has a trigger_manager attribute.\"\"\"\n362\t\n363\t    def test_game_state_has_trigger_manager(self, game: GameState) -> None:\n364\t        \"\"\"GameState should have a trigger_manager attribute that is a TriggerManager.\"\"\"\n365\t        assert hasattr(game, 'trigger_manager')\n366\t        assert isinstance(game.trigger_manager, TriggerManager)\n367\t\n368\t    def test_trigger_manager_starts_empty(self, game: GameState) -> None:\n369\t        \"\"\"A fresh GameState's trigger_manager should have no registered triggers.\"\"\"\n370\t        assert game.trigger_manager.get_triggers() == []\n371\t\n372\t    def test_trigger_manager_usable_via_game_state(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n373\t        \"\"\"Triggers registered via game.trigger_manager should fire via game.trigger_manager.\"\"\"\n374\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n375\t        game.trigger_manager.register(_make_trigger(EntersBattlefieldTriggeredEvent, source, players[0]))\n376\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n377\t        assert not game.stack.is_empty()\n378\t\n379\tclass TestETBIntegration:\n380\t    \"\"\"End-to-end: card with ETB trigger → battlefield → fire event → StackObject.\"\"\"\n381\t\n382\t    def test_etb_trigger_full_flow(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n383\t        \"\"\"Simulate: card enters battlefield, registers trigger, fire ETB, verify StackObject, resolve.\"\"\"\n384\t        etb_resolved: list[str] = []\n385\t\n386\t        class ETBCreature(Creature):\n387\t\n388\t            def register_triggers(self, g: GameState) -> None:\n389\t                reg = TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=None, effect=lambda game: etb_resolved.append(self.name), source=self, controller=self.controller)\n390\t                g.trigger_manager.register(reg)\n391\t        p = players[0]\n392\t        card = ETBCreature(name='Ravenous Chupacabra', owner=p, controller=p)\n393\t        game.get_battlefield(p).add(card)\n394\t        card.register_triggers(game)\n395\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n396\t        assert not game.stack.is_empty()\n397\t        stack_obj = game.stack.pop()\n398\t        assert stack_obj.source is card\n399\t        assert stack_obj.controller is p\n400\t        stack_obj.on_resolve(game)\n401\t        assert etb_resolved == ['Ravenous Chupacabra']\n402\t\n403\t    def test_etb_trigger_card_is_on_battlefield(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n404\t        \"\"\"The card should actually be on the battlefield when the trigger fires.\"\"\"\n405\t        on_battlefield_during_fire: list[bool] = []\n406\t\n407\t        class ETBCreature(Creature):\n408\t\n409\t            def register_triggers(self, g: GameState) -> None:\n410\t                card_ref = self\n411\t\n412\t                def check_condition(game_state, event):\n413\t                    bf = game_state.get_battlefield(card_ref.controller)\n414\t                    on_battlefield_during_fire.append(bf.contains(card_ref))\n415\t                    return True\n416\t                g.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=check_condition, effect=lambda g: None, source=self, controller=self.controller))\n417\t        p = players[0]\n418\t        card = ETBCreature(name='Chup', owner=p, controller=p)\n419\t        game.get_battlefield(p).add(card)\n420\t        card.register_triggers(game)\n421\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n422\t        assert on_battlefield_during_fire == [True]\n423\t\n424\t    def test_unregister_on_leave_battlefield(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n425\t        \"\"\"When a source leaves the battlefield and is unregistered, firing does nothing.\"\"\"\n426\t\n427\t        class ETBCreature(Creature):\n428\t\n429\t            def register_triggers(self, g: GameState) -> None:\n430\t                g.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=None, effect=lambda g: None, source=self, controller=self.controller))\n431\t        p = players[0]\n432\t        card = ETBCreature(name='Chupacabra', owner=p, controller=p)\n433\t        game.get_battlefield(p).add(card)\n434\t        card.register_triggers(game)\n435\t        assert len(game.trigger_manager.get_triggers()) == 1\n436\t        game.get_battlefield(p).remove(card)\n437\t        game.trigger_manager.unregister(card)\n438\t        assert len(game.trigger_manager.get_triggers()) == 0\n439\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n440\t        assert game.stack.is_empty()\n441\t\n442\t    def test_etb_with_data_parameter(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n443\t        \"\"\"ETB trigger condition can inspect data dict to filter (e.g., which creature entered).\"\"\"\n444\t        fired: list[str] = []\n445\t        p = players[0]\n446\t        bear = Creature(name='Bear', owner=p, controller=p)\n447\t        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=lambda g, event: event.creature is bear, effect=lambda g: fired.append('bear_entered'), source=bear, controller=p))\n448\t        other = Creature(name='Elf', owner=p, controller=p)\n449\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent(creature=other))\n450\t        assert game.stack.is_empty()\n451\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent(creature=bear))\n452\t        assert not game.stack.is_empty()\n453\t\n454\tclass TestAutoTriggerRegistrationViaResolve:\n455\t    \"\"\"Verify triggers are automatically registered when a permanent enters\n456\t    the battlefield through the real casting/resolution pipeline — NOT by\n457\t    manually calling card.register_triggers(game).\n458\t    \"\"\"\n459\t\n460\t    def test_resolve_spell_auto_registers_triggers(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n461\t        \"\"\"Cast a creature with an ETB trigger, resolve it, fire event,\n462\t        verify the trigger fires and pushes a StackObject automatically.\n463\t        \"\"\"\n464\t        from engine.casting import cast_spell\n465\t        from engine.types import ManaCost, ManaType, Phase\n466\t        etb_fired: list[str] = []\n467\t\n468\t        class ETBBeast(Creature):\n469\t\n470\t            def register_triggers(self, g: GameState) -> None:\n471\t                g.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=None, effect=lambda game: etb_fired.append(self.name), source=self, controller=self.controller))\n472\t        p = players[0]\n473\t        cost = ManaCost(generic=1)\n474\t        card = ETBBeast(name='Hollowhenge Beast', mana_cost=cost, owner=p, controller=p)\n475\t        game.get_hand(p).add(card)\n476\t        game.phase = Phase.PRECOMBAT_MAIN\n477\t        game.step = None\n478\t        p.mana_pool.add(ManaType.COLORLESS, 5)\n479\t        cast_spell(game, p, card)\n480\t        assert not game.stack.is_empty(), 'Spell should be on the stack after casting'\n481\t        spell_obj = game.stack.pop()\n482\t        spell_obj.on_resolve(game)\n483\t        assert game.get_battlefield(p).contains(card)\n484\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n485\t        assert len(triggers) == 1, 'register_triggers should have been called automatically'\n486\t        assert triggers[0].event_type is EntersBattlefieldTriggeredEvent\n487\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n488\t        assert not game.stack.is_empty(), 'ETB trigger should push a StackObject'\n489\t        trigger_obj = game.stack.pop()\n490\t        assert trigger_obj.source is card\n491\t        assert trigger_obj.controller is p\n492\t        trigger_obj.on_resolve(game)\n493\t        assert etb_fired == ['Hollowhenge Beast']\n494\t\n495\t    def test_play_land_auto_registers_triggers(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n496\t        \"\"\"Play a land with triggers via play_land, verify triggers are\n497\t        auto-registered without manual register_triggers call.\n498\t        \"\"\"\n499\t        from engine.card import Land\n500\t        from engine.casting import play_land\n501\t        from engine.types import Phase\n502\t        etb_fired: list[str] = []\n503\t\n504\t        class TriggerLand(Land):\n505\t\n506\t            def register_triggers(self, g: GameState) -> None:\n507\t                g.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=None, effect=lambda game: etb_fired.append(self.name), source=self, controller=self.controller))\n508\t        p = players[0]\n509\t        land = TriggerLand(name='Valakut', owner=p, controller=p)\n510\t        game.get_hand(p).add(land)\n511\t        game.phase = Phase.PRECOMBAT_MAIN\n512\t        game.step = None\n513\t        p.land_plays_remaining = 1\n514\t        play_land(game, p, land)\n515\t        assert game.get_battlefield(p).contains(land)\n516\t        triggers = game.trigger_manager.get_triggers_for_source(land)\n517\t        assert len(triggers) == 1\n518\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n519\t        assert not game.stack.is_empty()\n520\t\n521\tclass TestAutoTriggerUnregistrationViaLeave:\n522\t    \"\"\"Verify triggers are automatically unregistered when a permanent\n523\t    leaves the battlefield through the real engine paths (e.g., SBA\n524\t    moving a creature to the graveyard) — NOT by manually calling\n525\t    game.trigger_manager.unregister(card).\n526\t    \"\"\"\n527\t\n528\t    def test_sba_lethal_damage_auto_unregisters_triggers(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n529\t        \"\"\"A creature with triggers takes lethal damage → SBA moves it to\n530\t        graveyard → triggers should be automatically unregistered.\n531\t        \"\"\"\n532\t        from engine.casting import cast_spell\n533\t        from engine.state_based_actions import check_state_based_actions\n534\t        from engine.types import ManaCost, ManaType, Phase\n535\t\n536\t        class ETBCreature(Creature):\n537\t\n538\t            def register_triggers(self, g: GameState) -> None:\n539\t                g.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=None, effect=lambda game: None, source=self, controller=self.controller))\n540\t        p = players[0]\n541\t        cost = ManaCost(generic=1)\n542\t        card = ETBCreature(name='Fragile Golem', mana_cost=cost, owner=p, controller=p, base_power=2, base_toughness=2)\n543\t        game.get_hand(p).add(card)\n544\t        game.phase = Phase.PRECOMBAT_MAIN\n545\t        game.step = None\n546\t        p.mana_pool.add(ManaType.COLORLESS, 5)\n547\t        cast_spell(game, p, card)\n548\t        spell_obj = game.stack.pop()\n549\t        spell_obj.on_resolve(game)\n550\t        assert len(game.trigger_manager.get_triggers_for_source(card)) == 1\n551\t        assert game.get_battlefield(p).contains(card)\n552\t        card.damage_marked = 5\n553\t        check_state_based_actions(game)\n554\t        assert not game.get_battlefield(p).contains(card)\n555\t        assert len(game.trigger_manager.get_triggers_for_source(card)) == 0\n556\t        assert len(game.trigger_manager.get_triggers()) == 0\n557\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n558\t        assert game.stack.is_empty(), 'Trigger should have been auto-unregistered when creature left battlefield'\n559\t\n560\t    def test_sba_zero_toughness_auto_unregisters_triggers(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n561\t        \"\"\"A creature with 0 toughness is removed by SBA → triggers auto-unregistered.\"\"\"\n562\t        from engine.state_based_actions import check_state_based_actions\n563\t\n564\t        class ETBCreature(Creature):\n565\t\n566\t            def register_triggers(self, g: GameState) -> None:\n567\t                g.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=None, effect=lambda game: None, source=self, controller=self.controller))\n568\t        p = players[0]\n569\t        card = ETBCreature(name='Doomed Construct', owner=p, controller=p, base_power=3, base_toughness=1)\n570\t        game.get_battlefield(p).add(card)\n571\t        card.register_triggers(game)\n572\t        assert len(game.trigger_manager.get_triggers_for_source(card)) == 1\n573\t        card.minus_one_counters = 1\n574\t        assert card.toughness == 0\n575\t        check_state_based_actions(game)\n576\t        assert not game.get_battlefield(p).contains(card)\n577\t        assert len(game.trigger_manager.get_triggers_for_source(card)) == 0\n578\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n579\t        assert game.stack.is_empty()\n580\t"}]},"parent_tool_use_id":null,"session_id":"b76fbb6d-7052-44e0-893e-8a2c1cc9d4a6","uuid":"fd86d384-3f0d-4a9e-99ef-7355b6a26245","timestamp":"2026-05-30T04:18:46.389Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine_tests/test_triggers.py","content":"\"\"\"Tests for engine/triggers.py — Triggered abilities system.\n\nVerifies:\n- EventType enum members and values.\n- TriggerRegistration dataclass construction and fields.\n- TriggerManager register/unregister/get_triggers/get_triggers_for_source/clear.\n- TriggerManager.fire_event pushes StackObjects for matching triggers.\n- fire_event with non-matching event type → nothing pushed.\n- Condition filtering: triggers only fire when condition returns True.\n- Condition filtering: triggers do NOT fire when condition returns False.\n- fire_event data parameter passed to condition.\n- APNAP ordering: active player triggers pushed first (bottom), non-active on top.\n- Registration-order preserved within same player.\n- Unregister removes all triggers for a source (identity-based).\n- Integration: GameState.trigger_manager is TriggerManager instance.\n- ETB scenario: card enters battlefield → register_triggers → fire event → StackObject.\n- Unregister on leave → fire event → nothing.\n- Multiple triggers from different sources for same event → all pushed.\n- Data dict forwarded to condition callable.\n\"\"\"\nfrom __future__ import annotations\nimport pytest\nfrom engine.card import CardImpl, Creature\nfrom engine.game_state import GameState\nfrom engine.player import DeterministicPlayer\nfrom engine.stack import StackObject\nfrom engine.triggers import TriggerManager, TriggerRegistration\nfrom engine.types import Zone\nfrom engine.events import AttacksTriggeredEvent, BeginningOfUpkeepTriggeredEvent, CreatureDiesTriggeredEvent, DealsDamageTriggeredEvent, EndOfTurnTriggeredEvent, EntersBattlefieldTriggeredEvent, GainsLifeTriggeredEvent, SpellCastTriggeredEvent\n\n@pytest.fixture()\ndef players() -> list[DeterministicPlayer]:\n    \"\"\"Create two DeterministicPlayers.\"\"\"\n    return [DeterministicPlayer('Alice', script=[]), DeterministicPlayer('Bob', script=[])]\n\n@pytest.fixture()\ndef game(players: list[DeterministicPlayer]) -> GameState:\n    \"\"\"Create a GameState with two players.\"\"\"\n    return GameState(players)\n\ndef _make_trigger(event_type: type, source: object, controller: DeterministicPlayer, *, condition=None, effect=None) -> TriggerRegistration:\n    \"\"\"Convenience to build a TriggerRegistration with sensible defaults.\"\"\"\n    return TriggerRegistration(event_type=event_type, condition=condition, effect=effect or (lambda g: None), source=source, controller=controller)\n\nclass TestTriggerRegistration:\n    \"\"\"TriggerRegistration dataclass stores all fields correctly.\"\"\"\n\n    def test_construction_with_all_fields(self, players: list[DeterministicPlayer]) -> None:\n        \"\"\"All five required fields are stored on construction.\"\"\"\n        source = Creature(name='Bear', owner=players[0], controller=players[0])\n        cond = lambda g, d: True\n        effect = lambda g: None\n        reg = TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=cond, effect=effect, source=source, controller=players[0])\n        assert reg.event_type is EntersBattlefieldTriggeredEvent\n        assert reg.condition is cond\n        assert reg.effect is effect\n        assert reg.source is source\n        assert reg.controller is players[0]\n\n    def test_condition_none_allowed(self, players: list[DeterministicPlayer]) -> None:\n        \"\"\"condition=None means 'always fires for event type'.\"\"\"\n        source = Creature(name='Bear', owner=players[0], controller=players[0])\n        reg = TriggerRegistration(event_type=CreatureDiesTriggeredEvent, condition=None, effect=lambda g: None, source=source, controller=players[0])\n        assert reg.condition is None\n\n    def test_source_can_be_any_object(self, players: list[DeterministicPlayer]) -> None:\n        \"\"\"source field accepts any game object (not just Creature).\"\"\"\n        source = object()\n        reg = _make_trigger(SpellCastTriggeredEvent, source, players[0])\n        assert reg.source is source\n\nclass TestTriggerManagerBasic:\n    \"\"\"TriggerManager register, unregister, get_triggers, get_triggers_for_source, clear.\"\"\"\n\n    def test_initial_empty(self) -> None:\n        \"\"\"A new TriggerManager has no triggers.\"\"\"\n        tm = TriggerManager()\n        assert tm.get_triggers() == []\n\n    def test_register_adds_trigger(self, players: list[DeterministicPlayer]) -> None:\n        \"\"\"register() should add the trigger to the internal list.\"\"\"\n        tm = TriggerManager()\n        source = Creature(name='Bear', owner=players[0], controller=players[0])\n        reg = _make_trigger(EntersBattlefieldTriggeredEvent, source, players[0])\n        tm.register(reg)\n        assert len(tm.get_triggers()) == 1\n        assert tm.get_triggers()[0] is reg\n\n    def test_register_multiple_triggers(self, players: list[DeterministicPlayer]) -> None:\n        \"\"\"Multiple registrations should accumulate.\"\"\"\n        tm = TriggerManager()\n        source = Creature(name='Bear', owner=players[0], controller=players[0])\n        r1 = _make_trigger(EntersBattlefieldTriggeredEvent, source, players[0])\n        r2 = _make_trigger(CreatureDiesTriggeredEvent, source, players[0])\n        tm.register(r1)\n        tm.register(r2)\n        assert len(tm.get_triggers()) == 2\n\n    def test_get_triggers_returns_copy(self, players: list[DeterministicPlayer]) -> None:\n        \"\"\"get_triggers() should return a shallow copy — mutating it does not affect the manager.\"\"\"\n        tm = TriggerManager()\n        source = Creature(name='Bear', owner=players[0], controller=players[0])\n        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, source, players[0]))\n        copy = tm.get_triggers()\n        copy.clear()\n        assert len(tm.get_triggers()) == 1\n\nclass TestTriggerManagerUnregister:\n    \"\"\"Unregister removes all triggers for a given source object.\"\"\"\n\n    def test_unregister_removes_all_triggers_for_source(self, players: list[DeterministicPlayer]) -> None:\n        \"\"\"unregister(source) should remove every trigger whose source is that object.\"\"\"\n        tm = TriggerManager()\n        bear = Creature(name='Bear', owner=players[0], controller=players[0])\n        elf = Creature(name='Elf', owner=players[0], controller=players[0])\n        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, bear, players[0]))\n        tm.register(_make_trigger(CreatureDiesTriggeredEvent, bear, players[0]))\n        tm.register(_make_trigger(AttacksTriggeredEvent, elf, players[0]))\n        tm.unregister(bear)\n        remaining = tm.get_triggers()\n        assert len(remaining) == 1\n        assert remaining[0].source is elf\n\n    def test_unregister_is_identity_based(self, players: list[DeterministicPlayer]) -> None:\n        \"\"\"Unregister uses `is` (identity), not `==` (equality).\"\"\"\n        tm = TriggerManager()\n        bear1 = Creature(name='Bear', owner=players[0], controller=players[0])\n        bear2 = Creature(name='Bear', owner=players[0], controller=players[0])\n        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, bear1, players[0]))\n        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, bear2, players[0]))\n        tm.unregister(bear1)\n        assert len(tm.get_triggers()) == 1\n        assert tm.get_triggers()[0].source is bear2\n\n    def test_unregister_nonexistent_source_is_noop(self) -> None:\n        \"\"\"Unregistering a source with no triggers should not raise.\"\"\"\n        tm = TriggerManager()\n        tm.unregister(object())\n        assert tm.get_triggers() == []\n\n    def test_unregister_leaves_other_sources_intact(self, players: list[DeterministicPlayer]) -> None:\n        \"\"\"After unregister, triggers from other sources must remain.\"\"\"\n        tm = TriggerManager()\n        bear = Creature(name='Bear', owner=players[0], controller=players[0])\n        elf = Creature(name='Elf', owner=players[1], controller=players[1])\n        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, bear, players[0]))\n        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, elf, players[1]))\n        tm.unregister(bear)\n        assert len(tm.get_triggers()) == 1\n        assert tm.get_triggers()[0].source is elf\n\nclass TestTriggerManagerGetTriggersForSource:\n    \"\"\"get_triggers_for_source filters by source identity.\"\"\"\n\n    def test_returns_only_matching_source(self, players: list[DeterministicPlayer]) -> None:\n        tm = TriggerManager()\n        bear = Creature(name='Bear', owner=players[0], controller=players[0])\n        elf = Creature(name='Elf', owner=players[0], controller=players[0])\n        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, bear, players[0]))\n        tm.register(_make_trigger(CreatureDiesTriggeredEvent, bear, players[0]))\n        tm.register(_make_trigger(AttacksTriggeredEvent, elf, players[0]))\n        bear_triggers = tm.get_triggers_for_source(bear)\n        assert len(bear_triggers) == 2\n        assert all((t.source is bear for t in bear_triggers))\n\n    def test_returns_empty_for_unknown_source(self) -> None:\n        tm = TriggerManager()\n        assert tm.get_triggers_for_source(object()) == []\n\nclass TestTriggerManagerClear:\n    \"\"\"clear() removes all triggers.\"\"\"\n\n    def test_clear_empties_all(self, players: list[DeterministicPlayer]) -> None:\n        tm = TriggerManager()\n        source = Creature(name='Bear', owner=players[0], controller=players[0])\n        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, source, players[0]))\n        tm.register(_make_trigger(CreatureDiesTriggeredEvent, source, players[0]))\n        tm.clear()\n        assert tm.get_triggers() == []\n\nclass TestFireEvent:\n    \"\"\"fire_event pushes matching triggers onto the game stack.\"\"\"\n\n    def test_matching_trigger_pushes_stack_object(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n        \"\"\"A registered ETB trigger fires when ENTERS_BATTLEFIELD is fired.\"\"\"\n        source = Creature(name='Bear', owner=players[0], controller=players[0])\n        game.trigger_manager.register(_make_trigger(EntersBattlefieldTriggeredEvent, source, players[0]))\n        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n        assert not game.stack.is_empty()\n        stack_obj = game.stack.peek()\n        assert isinstance(stack_obj, StackObject)\n        assert stack_obj.source is source\n        assert stack_obj.controller is players[0]\n\n    def test_stack_object_on_resolve_invokes_effect(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n        \"\"\"The StackObject's on_resolve should call the trigger's effect callback.\"\"\"\n        calls: list[str] = []\n        source = Creature(name='Bear', owner=players[0], controller=players[0])\n        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=None, effect=lambda g: calls.append('resolved'), source=source, controller=players[0]))\n        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n        stack_obj = game.stack.pop()\n        stack_obj.on_resolve(game)\n        assert calls == ['resolved']\n\n    def test_non_matching_event_type_pushes_nothing(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n        \"\"\"Firing a different event type should not push any StackObject.\"\"\"\n        source = Creature(name='Bear', owner=players[0], controller=players[0])\n        game.trigger_manager.register(_make_trigger(EntersBattlefieldTriggeredEvent, source, players[0]))\n        game.trigger_manager.fire_event(game, CreatureDiesTriggeredEvent())\n        assert game.stack.is_empty()\n\n    def test_no_registered_triggers_pushes_nothing(self, game: GameState) -> None:\n        \"\"\"Firing an event with no registered triggers should leave the stack empty.\"\"\"\n        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n        assert game.stack.is_empty()\n\n    def test_condition_true_fires_trigger(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n        \"\"\"When condition returns True, the trigger should fire.\"\"\"\n        source = Creature(name='Bear', owner=players[0], controller=players[0])\n        game.trigger_manager.register(TriggerRegistration(event_type=DealsDamageTriggeredEvent, condition=lambda g, event: True, effect=lambda g: None, source=source, controller=players[0]))\n        game.trigger_manager.fire_event(game, DealsDamageTriggeredEvent(amount=3))\n        assert not game.stack.is_empty()\n\n    def test_condition_false_does_not_fire_trigger(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n        \"\"\"When condition returns False, the trigger should NOT fire.\"\"\"\n        source = Creature(name='Bear', owner=players[0], controller=players[0])\n        game.trigger_manager.register(TriggerRegistration(event_type=DealsDamageTriggeredEvent, condition=lambda g, event: False, effect=lambda g: None, source=source, controller=players[0]))\n        game.trigger_manager.fire_event(game, DealsDamageTriggeredEvent(amount=3))\n        assert game.stack.is_empty()\n\n    def test_condition_none_always_fires(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n        \"\"\"A trigger with condition=None should always fire for matching event.\"\"\"\n        source = Creature(name='Bear', owner=players[0], controller=players[0])\n        game.trigger_manager.register(_make_trigger(GainsLifeTriggeredEvent, source, players[0], condition=None))\n        game.trigger_manager.fire_event(game, GainsLifeTriggeredEvent())\n        assert not game.stack.is_empty()\n\n    def test_condition_receives_data_dict(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n        \"\"\"The condition callable should receive (game, event) where event is the typed event object.\"\"\"\n        received_args: list[tuple] = []\n\n        def cond(g, e):\n            received_args.append((g, e))\n            return True\n        source = Creature(name='Bear', owner=players[0], controller=players[0])\n        game.trigger_manager.register(TriggerRegistration(event_type=DealsDamageTriggeredEvent, condition=cond, effect=lambda g: None, source=source, controller=players[0]))\n        event = DealsDamageTriggeredEvent(amount=5)\n        game.trigger_manager.fire_event(game, event)\n        assert len(received_args) == 1\n        assert received_args[0][0] is game\n        assert received_args[0][1] is event\n\n    def test_fire_event_without_data_passes_empty_dict(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n        \"\"\"Calling fire_event passes the typed event object to condition.\"\"\"\n        received_data: list = []\n\n        def cond(g, e):\n            received_data.append(e)\n            return True\n        source = Creature(name='Bear', owner=players[0], controller=players[0])\n        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=cond, effect=lambda g: None, source=source, controller=players[0]))\n        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n        assert len(received_data) == 1\n        assert isinstance(received_data[0], EntersBattlefieldTriggeredEvent)\n\n    def test_multiple_triggers_same_event_all_pushed(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n        \"\"\"Three triggers for the same event → three StackObjects pushed.\"\"\"\n        sources = []\n        for i in range(3):\n            src = Creature(name=f'Bear{i}', owner=players[0], controller=players[0])\n            sources.append(src)\n            game.trigger_manager.register(_make_trigger(EntersBattlefieldTriggeredEvent, src, players[0]))\n        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n        assert len(game.stack.objects()) == 3\n\n    def test_mixed_matching_and_nonmatching_only_matching_pushed(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n        \"\"\"Only triggers matching the fired event type should be pushed.\"\"\"\n        src_etb = Creature(name='ETB', owner=players[0], controller=players[0])\n        src_die = Creature(name='DIE', owner=players[0], controller=players[0])\n        game.trigger_manager.register(_make_trigger(EntersBattlefieldTriggeredEvent, src_etb, players[0]))\n        game.trigger_manager.register(_make_trigger(CreatureDiesTriggeredEvent, src_die, players[0]))\n        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n        assert len(game.stack.objects()) == 1\n        assert game.stack.peek().source is src_etb\n\n    def test_condition_uses_data_to_filter(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n        \"\"\"Condition can inspect data dict to decide whether to fire.\"\"\"\n        source = Creature(name='Lifelinker', owner=players[0], controller=players[0])\n        game.trigger_manager.register(TriggerRegistration(event_type=GainsLifeTriggeredEvent, condition=lambda g, event: event.amount >= 5, effect=lambda g: None, source=source, controller=players[0]))\n        game.trigger_manager.fire_event(game, GainsLifeTriggeredEvent(amount=3))\n        assert game.stack.is_empty()\n        game.trigger_manager.fire_event(game, GainsLifeTriggeredEvent(amount=5))\n        assert not game.stack.is_empty()\n\nclass TestAPNAPOrdering:\n    \"\"\"APNAP: Active player's triggers pushed first (bottom), non-active player's on top.\"\"\"\n\n    def test_active_player_triggers_at_bottom_non_active_on_top(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n        \"\"\"Active player's triggers end up at the bottom of the stack batch;\n        non-active player's triggers are on top (resolve first).\"\"\"\n        active = players[game.active_player_index]\n        non_active = players[1 - game.active_player_index]\n        active_src = Creature(name='A', owner=active, controller=active)\n        nap_src = Creature(name='N', owner=non_active, controller=non_active)\n        game.trigger_manager.register(_make_trigger(BeginningOfUpkeepTriggeredEvent, active_src, active))\n        game.trigger_manager.register(_make_trigger(BeginningOfUpkeepTriggeredEvent, nap_src, non_active))\n        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n        stack_objs = game.stack.objects()\n        assert len(stack_objs) == 2\n        assert stack_objs[0].controller is non_active\n        assert stack_objs[1].controller is active\n\n    def test_apnap_ordering_regardless_of_registration_order(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n        \"\"\"APNAP ordering should hold even if non-active player's trigger is registered first.\"\"\"\n        active = players[game.active_player_index]\n        non_active = players[1 - game.active_player_index]\n        active_src = Creature(name='A', owner=active, controller=active)\n        nap_src = Creature(name='N', owner=non_active, controller=non_active)\n        game.trigger_manager.register(_make_trigger(EndOfTurnTriggeredEvent, nap_src, non_active))\n        game.trigger_manager.register(_make_trigger(EndOfTurnTriggeredEvent, active_src, active))\n        game.trigger_manager.fire_event(game, EndOfTurnTriggeredEvent())\n        stack_objs = game.stack.objects()\n        assert len(stack_objs) == 2\n        assert stack_objs[0].controller is non_active\n        assert stack_objs[1].controller is active\n\n    def test_registration_order_preserved_within_same_player(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n        \"\"\"Triggers from the same player maintain registration order (pushed in that order).\"\"\"\n        active = players[game.active_player_index]\n        src1 = Creature(name='First', owner=active, controller=active)\n        src2 = Creature(name='Second', owner=active, controller=active)\n        game.trigger_manager.register(_make_trigger(BeginningOfUpkeepTriggeredEvent, src1, active))\n        game.trigger_manager.register(_make_trigger(BeginningOfUpkeepTriggeredEvent, src2, active))\n        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n        stack_objs = game.stack.objects()\n        assert len(stack_objs) == 2\n        assert stack_objs[0].source is src2\n        assert stack_objs[1].source is src1\n\n    def test_apnap_with_multiple_triggers_per_player(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n        \"\"\"With multiple triggers per player, all active player's come before non-active's.\"\"\"\n        active = players[game.active_player_index]\n        non_active = players[1 - game.active_player_index]\n        a1 = Creature(name='A1', owner=active, controller=active)\n        a2 = Creature(name='A2', owner=active, controller=active)\n        n1 = Creature(name='N1', owner=non_active, controller=non_active)\n        n2 = Creature(name='N2', owner=non_active, controller=non_active)\n        game.trigger_manager.register(_make_trigger(EndOfTurnTriggeredEvent, a1, active))\n        game.trigger_manager.register(_make_trigger(EndOfTurnTriggeredEvent, n1, non_active))\n        game.trigger_manager.register(_make_trigger(EndOfTurnTriggeredEvent, a2, active))\n        game.trigger_manager.register(_make_trigger(EndOfTurnTriggeredEvent, n2, non_active))\n        game.trigger_manager.fire_event(game, EndOfTurnTriggeredEvent())\n        stack_objs = game.stack.objects()\n        assert len(stack_objs) == 4\n        assert stack_objs[0].controller is non_active\n        assert stack_objs[1].controller is non_active\n        assert stack_objs[2].controller is active\n        assert stack_objs[3].controller is active\n\nclass TestGameStateIntegration:\n    \"\"\"GameState has a trigger_manager attribute.\"\"\"\n\n    def test_game_state_has_trigger_manager(self, game: GameState) -> None:\n        \"\"\"GameState should have a trigger_manager attribute that is a TriggerManager.\"\"\"\n        assert hasattr(game, 'trigger_manager')\n        assert isinstance(game.trigger_manager, TriggerManager)\n\n    def test_trigger_manager_starts_empty(self, game: GameState) -> None:\n        \"\"\"A fresh GameState's trigger_manager should have no registered triggers.\"\"\"\n        assert game.trigger_manager.get_triggers() == []\n\n    def test_trigger_manager_usable_via_game_state(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n        \"\"\"Triggers registered via game.trigger_manager should fire via game.trigger_manager.\"\"\"\n        source = Creature(name='Bear', owner=players[0], controller=players[0])\n        game.trigger_manager.register(_make_trigger(EntersBattlefieldTriggeredEvent, source, players[0]))\n        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n        assert not game.stack.is_empty()\n\nclass TestETBIntegration:\n    \"\"\"End-to-end: card with ETB trigger → battlefield → fire event → StackObject.\"\"\"\n\n    def test_etb_trigger_full_flow(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n        \"\"\"Simulate: card enters battlefield, registers trigger, fire ETB, verify StackObject, resolve.\"\"\"\n        etb_resolved: list[str] = []\n\n        class ETBCreature(Creature):\n\n            def register_triggers(self, g: GameState) -> None:\n                reg = TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=None, effect=lambda game: etb_resolved.append(self.name), source=self, controller=self.controller)\n                g.trigger_manager.register(reg)\n        p = players[0]\n        card = ETBCreature(name='Ravenous Chupacabra', owner=p, controller=p)\n        game.get_battlefield(p).add(card)\n        card.register_triggers(game)\n        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n        assert not game.stack.is_empty()\n        stack_obj = game.stack.pop()\n        assert stack_obj.source is card\n        assert stack_obj.controller is p\n        stack_obj.on_resolve(game)\n        assert etb_resolved == ['Ravenous Chupacabra']\n\n    def test_etb_trigger_card_is_on_battlefield(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n        \"\"\"The card should actually be on the battlefield when the trigger fires.\"\"\"\n        on_battlefield_during_fire: list[bool] = []\n\n        class ETBCreature(Creature):\n\n            def register_triggers(self, g: GameState) -> None:\n                card_ref = self\n\n                def check_condition(game_state, event):\n                    bf = game_state.get_battlefield(card_ref.controller)\n                    on_battlefield_during_fire.append(bf.contains(card_ref))\n                    return True\n                g.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=check_condition, effect=lambda g: None, source=self, controller=self.controller))\n        p = players[0]\n        card = ETBCreature(name='Chup', owner=p, controller=p)\n        game.get_battlefield(p).add(card)\n        card.register_triggers(game)\n        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n        assert on_battlefield_during_fire == [True]\n\n    def test_unregister_on_leave_battlefield(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n        \"\"\"When a source leaves the battlefield and is unregistered, firing does nothing.\"\"\"\n\n        class ETBCreature(Creature):\n\n            def register_triggers(self, g: GameState) -> None:\n                g.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=None, effect=lambda g: None, source=self, controller=self.controller))\n        p = players[0]\n        card = ETBCreature(name='Chupacabra', owner=p, controller=p)\n        game.get_battlefield(p).add(card)\n        card.register_triggers(game)\n        assert len(game.trigger_manager.get_triggers()) == 1\n        game.get_battlefield(p).remove(card)\n        game.trigger_manager.unregister(card)\n        assert len(game.trigger_manager.get_triggers()) == 0\n        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n        assert game.stack.is_empty()\n\n    def test_etb_with_data_parameter(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n        \"\"\"ETB trigger condition can inspect data dict to filter (e.g., which creature entered).\"\"\"\n        fired: list[str] = []\n        p = players[0]\n        bear = Creature(name='Bear', owner=p, controller=p)\n        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=lambda g, event: event.creature is bear, effect=lambda g: fired.append('bear_entered'), source=bear, controller=p))\n        other = Creature(name='Elf', owner=p, controller=p)\n        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent(creature=other))\n        assert game.stack.is_empty()\n        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent(creature=bear))\n        assert not game.stack.is_empty()\n\nclass TestAutoTriggerRegistrationViaResolve:\n    \"\"\"Verify triggers are automatically registered when a permanent enters\n    the battlefield through the real casting/resolution pipeline — NOT by\n    manually calling card.register_triggers(game).\n    \"\"\"\n\n    def test_resolve_spell_auto_registers_triggers(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n        \"\"\"Cast a creature with an ETB trigger, resolve it, fire event,\n        verify the trigger fires and pushes a StackObject automatically.\n        \"\"\"\n        from engine.casting import cast_spell\n        from engine.types import ManaCost, ManaType, Phase\n        etb_fired: list[str] = []\n\n        class ETBBeast(Creature):\n\n            def register_triggers(self, g: GameState) -> None:\n                g.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=None, effect=lambda game: etb_fired.append(self.name), source=self, controller=self.controller))\n        p = players[0]\n        cost = ManaCost(generic=1)\n        card = ETBBeast(name='Hollowhenge Beast', mana_cost=cost, owner=p, controller=p)\n        game.get_hand(p).add(card)\n        game.phase = Phase.PRECOMBAT_MAIN\n        game.step = None\n        p.mana_pool.add(ManaType.COLORLESS, 5)\n        cast_spell(game, p, card)\n        assert not game.stack.is_empty(), 'Spell should be on the stack after casting'\n        spell_obj = game.stack.pop()\n        spell_obj.on_resolve(game)\n        assert game.get_battlefield(p).contains(card)\n        triggers = game.trigger_manager.get_triggers_for_source(card)\n        assert len(triggers) == 1, 'register_triggers should have been called automatically'\n        assert triggers[0].event_type is EntersBattlefieldTriggeredEvent\n        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n        assert not game.stack.is_empty(), 'ETB trigger should push a StackObject'\n        trigger_obj = game.stack.pop()\n        assert trigger_obj.source is card\n        assert trigger_obj.controller is p\n        trigger_obj.on_resolve(game)\n        assert etb_fired == ['Hollowhenge Beast']\n\n    def test_play_land_auto_registers_triggers(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n        \"\"\"Play a land with triggers via play_land, verify triggers are\n        auto-registered without manual register_triggers call.\n        \"\"\"\n        from engine.card import Land\n        from engine.casting import play_land\n        from engine.types import Phase\n        etb_fired: list[str] = []\n\n        class TriggerLand(Land):\n\n            def register_triggers(self, g: GameState) -> None:\n                g.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=None, effect=lambda game: etb_fired.append(self.name), source=self, controller=self.controller))\n        p = players[0]\n        land = TriggerLand(name='Valakut', owner=p, controller=p)\n        game.get_hand(p).add(land)\n        game.phase = Phase.PRECOMBAT_MAIN\n        game.step = None\n        p.land_plays_remaining = 1\n        play_land(game, p, land)\n        assert game.get_battlefield(p).contains(land)\n        triggers = game.trigger_manager.get_triggers_for_source(land)\n        assert len(triggers) == 1\n        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n        assert not game.stack.is_empty()\n\nclass TestAutoTriggerUnregistrationViaLeave:\n    \"\"\"Verify triggers are automatically unregistered when a permanent\n    leaves the battlefield through the real engine paths (e.g., SBA\n    moving a creature to the graveyard) — NOT by manually calling\n    game.trigger_manager.unregister(card).\n    \"\"\"\n\n    def test_sba_lethal_damage_auto_unregisters_triggers(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n        \"\"\"A creature with triggers takes lethal damage → SBA moves it to\n        graveyard → triggers should be automatically unregistered.\n        \"\"\"\n        from engine.casting import cast_spell\n        from engine.state_based_actions import check_state_based_actions\n        from engine.types import ManaCost, ManaType, Phase\n\n        class ETBCreature(Creature):\n\n            def register_triggers(self, g: GameState) -> None:\n                g.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=None, effect=lambda game: None, source=self, controller=self.controller))\n        p = players[0]\n        cost = ManaCost(generic=1)\n        card = ETBCreature(name='Fragile Golem', mana_cost=cost, owner=p, controller=p, base_power=2, base_toughness=2)\n        game.get_hand(p).add(card)\n        game.phase = Phase.PRECOMBAT_MAIN\n        game.step = None\n        p.mana_pool.add(ManaType.COLORLESS, 5)\n        cast_spell(game, p, card)\n        spell_obj = game.stack.pop()\n        spell_obj.on_resolve(game)\n        assert len(game.trigger_manager.get_triggers_for_source(card)) == 1\n        assert game.get_battlefield(p).contains(card)\n        card.damage_marked = 5\n        check_state_based_actions(game)\n        assert not game.get_battlefield(p).contains(card)\n        assert len(game.trigger_manager.get_triggers_for_source(card)) == 0\n        assert len(game.trigger_manager.get_triggers()) == 0\n        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n        assert game.stack.is_empty(), 'Trigger should have been auto-unregistered when creature left battlefield'\n\n    def test_sba_zero_toughness_auto_unregisters_triggers(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n        \"\"\"A creature with 0 toughness is removed by SBA → triggers auto-unregistered.\"\"\"\n        from engine.state_based_actions import check_state_based_actions\n\n        class ETBCreature(Creature):\n\n            def register_triggers(self, g: GameState) -> None:\n                g.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=None, effect=lambda game: None, source=self, controller=self.controller))\n        p = players[0]\n        card = ETBCreature(name='Doomed Construct', owner=p, controller=p, base_power=3, base_toughness=1)\n        game.get_battlefield(p).add(card)\n        card.register_triggers(game)\n        assert len(game.trigger_manager.get_triggers_for_source(card)) == 1\n        card.minus_one_counters = 1\n        assert card.toughness == 0\n        check_state_based_actions(game)\n        assert not game.get_battlefield(p).contains(card)\n        assert len(game.trigger_manager.get_triggers_for_source(card)) == 0\n        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n        assert game.stack.is_empty()\n","numLines":580,"startLine":1,"totalLines":580}}}
