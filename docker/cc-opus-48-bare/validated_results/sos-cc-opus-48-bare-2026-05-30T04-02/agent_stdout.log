{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017cGTbkBoYjssbPu1yqVDDo","type":"tool_result","content":"1\t\"\"\"Card implementation for Dreadwing Scavenger.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom typing import TYPE_CHECKING, Any\n4\tfrom engine.card import Creature\n5\tfrom engine.continuous_effects import ContinuousEffect, DURATION_PERMANENT, Layer, SubLayer\n6\tfrom engine.types import Keyword, ManaCost, Zone\n7\tfrom engine.events import AttacksTriggeredEvent\n8\tif TYPE_CHECKING:\n9\t    from engine.game_state import GameState\n10\t\n11\tdef _is_on_battlefield(game: Any, obj: Any) -> bool:\n12\t    \"\"\"Return True if *obj* is on any player's battlefield.\"\"\"\n13\t    for player in game.players:\n14\t        if game.get_battlefield(player).contains(obj):\n15\t            return True\n16\t    return False\n17\t\n18\tclass DreadwingScavenger(Creature):\n19\t    \"\"\"Dreadwing Scavenger — {1}{U}{B} — 2/2 — Nightmare Bird.\n20\t\n21\t    Flying\n22\t    Whenever this creature enters or attacks, draw a card, then discard\n23\t    a card.\n24\t    Threshold — This creature gets +1/+1 and has deathtouch as long as\n25\t    there are seven or more cards in your graveyard.\n26\t\n27\t    FDN collector number 118.\n28\t    \"\"\"\n29\t\n30\t    def __init__(self, **kwargs: Any) -> None:\n31\t        kwargs.setdefault('name', 'Dreadwing Scavenger')\n32\t        kwargs.setdefault('mana_cost', ManaCost.parse('{1}{U}{B}'))\n33\t        kwargs.setdefault('subtypes', {'Nightmare', 'Bird'})\n34\t        kwargs.setdefault('keywords', Keyword.FLYING)\n35\t        kwargs.setdefault('base_power', 2)\n36\t        kwargs.setdefault('base_toughness', 2)\n37\t        kwargs.setdefault('rules_text', 'Flying\\nWhenever this creature enters or attacks, draw a card, then discard a card.\\nThreshold — This creature gets +1/+1 and has deathtouch as long as there are seven or more cards in your graveyard.')\n38\t        super().__init__(**kwargs)\n39\t        self._threshold_effect_ref: ContinuousEffect | None = None\n40\t\n41\t    def on_resolve(self, game: 'GameState') -> None:\n42\t        \"\"\"ETB: draw a card, then discard a card.\"\"\"\n43\t        from engine.game import draw_card, discard\n44\t        controller = self.controller\n45\t        if controller is None:\n46\t            return\n47\t        draw_card(game, controller)\n48\t        hand = list(controller.zones[Zone.HAND].get_all())\n49\t        if hand:\n50\t            try:\n51\t                chosen = controller.choose_card(hand, 'card to discard')\n52\t            except Exception:\n53\t                chosen = hand[0]\n54\t            if chosen is not None:\n55\t                discard(game, controller, chosen)\n56\t\n57\t    def register_triggers(self, game: 'GameState') -> None:\n58\t        \"\"\"Register attack trigger (loot) and threshold continuous effect.\"\"\"\n59\t        from engine.game import draw_card, discard\n60\t        from engine.triggers import TriggerRegistration\n61\t        source = self\n62\t        controller = getattr(self, 'controller', None) or game.active_player\n63\t\n64\t        def _attack_condition(game: Any, event: dict) -> bool:\n65\t            return event.creature is source\n66\t\n67\t        def _attack_effect(game: 'GameState') -> None:\n68\t            ctrl = getattr(source, 'controller', None)\n69\t            if ctrl is None:\n70\t                return\n71\t            draw_card(game, ctrl)\n72\t            hand = list(ctrl.zones[Zone.HAND].get_all())\n73\t            if hand:\n74\t                try:\n75\t                    chosen = ctrl.choose_card(hand, 'card to discard')\n76\t                except Exception:\n77\t                    chosen = hand[0]\n78\t                if chosen is not None:\n79\t                    discard(game, ctrl, chosen)\n80\t        game.trigger_manager.register(TriggerRegistration(event_type=AttacksTriggeredEvent, condition=_attack_condition, effect=_attack_effect, source=self, controller=controller))\n81\t\n82\t        def _apply_threshold(game: Any) -> None:\n83\t            ctrl = getattr(source, 'controller', None)\n84\t            if ctrl is None:\n85\t                return\n86\t            if not _is_on_battlefield(game, source):\n87\t                return\n88\t            graveyard = ctrl.zones[Zone.GRAVEYARD]\n89\t            gy_count = len(list(graveyard.get_all()))\n90\t            if gy_count >= 7:\n91\t                source.modified_power += 1\n92\t                source.modified_toughness += 1\n93\t                source.keywords = (getattr(source, 'keywords', None) or Keyword(0)) | Keyword.DEATHTOUCH\n94\t        self._threshold_effect_ref = game.effect_manager.add(ContinuousEffect(source=self, layer=Layer.POWER_TOUGHNESS, sublayer=SubLayer.MODIFY_PT, apply=_apply_threshold, duration=DURATION_PERMANENT))\n95\t\n96\t    def unregister_triggers(self, game: 'GameState') -> None:\n97\t        \"\"\"Clean up threshold effect when leaving battlefield.\"\"\"\n98\t        if self._threshold_effect_ref is not None:\n99\t            game.effect_manager.remove(self._threshold_effect_ref)\n100\t            self._threshold_effect_ref = None\n101\t"}]},"parent_tool_use_id":null,"session_id":"b76fbb6d-7052-44e0-893e-8a2c1cc9d4a6","uuid":"2bebd713-82fc-414f-b728-2798dc391b11","timestamp":"2026-05-30T04:38:03.881Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_118/card_impl.py","content":"\"\"\"Card implementation for Dreadwing Scavenger.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import Creature\nfrom engine.continuous_effects import ContinuousEffect, DURATION_PERMANENT, Layer, SubLayer\nfrom engine.types import Keyword, ManaCost, Zone\nfrom engine.events import AttacksTriggeredEvent\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\ndef _is_on_battlefield(game: Any, obj: Any) -> bool:\n    \"\"\"Return True if *obj* is on any player's battlefield.\"\"\"\n    for player in game.players:\n        if game.get_battlefield(player).contains(obj):\n            return True\n    return False\n\nclass DreadwingScavenger(Creature):\n    \"\"\"Dreadwing Scavenger — {1}{U}{B} — 2/2 — Nightmare Bird.\n\n    Flying\n    Whenever this creature enters or attacks, draw a card, then discard\n    a card.\n    Threshold — This creature gets +1/+1 and has deathtouch as long as\n    there are seven or more cards in your graveyard.\n\n    FDN collector number 118.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Dreadwing Scavenger')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{1}{U}{B}'))\n        kwargs.setdefault('subtypes', {'Nightmare', 'Bird'})\n        kwargs.setdefault('keywords', Keyword.FLYING)\n        kwargs.setdefault('base_power', 2)\n        kwargs.setdefault('base_toughness', 2)\n        kwargs.setdefault('rules_text', 'Flying\\nWhenever this creature enters or attacks, draw a card, then discard a card.\\nThreshold — This creature gets +1/+1 and has deathtouch as long as there are seven or more cards in your graveyard.')\n        super().__init__(**kwargs)\n        self._threshold_effect_ref: ContinuousEffect | None = None\n\n    def on_resolve(self, game: 'GameState') -> None:\n        \"\"\"ETB: draw a card, then discard a card.\"\"\"\n        from engine.game import draw_card, discard\n        controller = self.controller\n        if controller is None:\n            return\n        draw_card(game, controller)\n        hand = list(controller.zones[Zone.HAND].get_all())\n        if hand:\n            try:\n                chosen = controller.choose_card(hand, 'card to discard')\n            except Exception:\n                chosen = hand[0]\n            if chosen is not None:\n                discard(game, controller, chosen)\n\n    def register_triggers(self, game: 'GameState') -> None:\n        \"\"\"Register attack trigger (loot) and threshold continuous effect.\"\"\"\n        from engine.game import draw_card, discard\n        from engine.triggers import TriggerRegistration\n        source = self\n        controller = getattr(self, 'controller', None) or game.active_player\n\n        def _attack_condition(game: Any, event: dict) -> bool:\n            return event.creature is source\n\n        def _attack_effect(game: 'GameState') -> None:\n            ctrl = getattr(source, 'controller', None)\n            if ctrl is None:\n                return\n            draw_card(game, ctrl)\n            hand = list(ctrl.zones[Zone.HAND].get_all())\n            if hand:\n                try:\n                    chosen = ctrl.choose_card(hand, 'card to discard')\n                except Exception:\n                    chosen = hand[0]\n                if chosen is not None:\n                    discard(game, ctrl, chosen)\n        game.trigger_manager.register(TriggerRegistration(event_type=AttacksTriggeredEvent, condition=_attack_condition, effect=_attack_effect, source=self, controller=controller))\n\n        def _apply_threshold(game: Any) -> None:\n            ctrl = getattr(source, 'controller', None)\n            if ctrl is None:\n                return\n            if not _is_on_battlefield(game, source):\n                return\n            graveyard = ctrl.zones[Zone.GRAVEYARD]\n            gy_count = len(list(graveyard.get_all()))\n            if gy_count >= 7:\n                source.modified_power += 1\n                source.modified_toughness += 1\n                source.keywords = (getattr(source, 'keywords', None) or Keyword(0)) | Keyword.DEATHTOUCH\n        self._threshold_effect_ref = game.effect_manager.add(ContinuousEffect(source=self, layer=Layer.POWER_TOUGHNESS, sublayer=SubLayer.MODIFY_PT, apply=_apply_threshold, duration=DURATION_PERMANENT))\n\n    def unregister_triggers(self, game: 'GameState') -> None:\n        \"\"\"Clean up threshold effect when leaving battlefield.\"\"\"\n        if self._threshold_effect_ref is not None:\n            game.effect_manager.remove(self._threshold_effect_ref)\n            self._threshold_effect_ref = None\n","numLines":101,"startLine":1,"totalLines":101}}}
