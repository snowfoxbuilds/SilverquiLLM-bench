{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MJZEG44ZqxU4Es89ApaHGY","type":"tool_result","content":"1\t\"\"\"Typed event objects for triggered abilities and replacement effects.\n2\t\n3\tTriggered events are passed to :meth:`TriggerManager.fire_event` and\n4\tforwarded to trigger condition callables.\n5\t\n6\tReplacement events are passed to :meth:`ReplacementManager.apply` and\n7\tforwarded to replacement condition/replacement callables.  Subclassing\n8\tencodes event-type hierarchy so a replacement registered for a parent\n9\ttype (e.g. ``MoveToGraveyardReplacementEvent``) also fires for\n10\tsubtypes (e.g. ``CreatureDiesReplacementEvent``).\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\tfrom dataclasses import dataclass\n16\tfrom typing import Any\n17\t\n18\t\n19\t# ---------------------------------------------------------------------------\n20\t# Triggered events\n21\t# ---------------------------------------------------------------------------\n22\t\n23\t@dataclass\n24\tclass TriggeredEvent:\n25\t    \"\"\"Base class for all triggered-ability events.\"\"\"\n26\t\n27\t\n28\t@dataclass\n29\tclass EntersBattlefieldTriggeredEvent(TriggeredEvent):\n30\t    permanent: Any = None\n31\t    controller: Any = None\n32\t    card: Any = None\n33\t    creature: Any = None\n34\t\n35\t\n36\t@dataclass\n37\tclass LeavesBattlefieldTriggeredEvent(TriggeredEvent):\n38\t    permanent: Any = None\n39\t    controller: Any = None\n40\t\n41\t\n42\t@dataclass\n43\tclass DealsDamageTriggeredEvent(TriggeredEvent):\n44\t    source: Any = None\n45\t    target: Any = None\n46\t    amount: int = 0\n47\t    is_combat: bool = False\n48\t    combat: bool = False\n49\t\n50\t\n51\t@dataclass\n52\tclass LosesLifeTriggeredEvent(TriggeredEvent):\n53\t    player: Any = None\n54\t    amount: int = 0\n55\t\n56\t\n57\t@dataclass\n58\tclass GainsLifeTriggeredEvent(TriggeredEvent):\n59\t    player: Any = None\n60\t    amount: int = 0\n61\t\n62\t\n63\t@dataclass\n64\tclass DrawsCardTriggeredEvent(TriggeredEvent):\n65\t    player: Any = None\n66\t    card: Any = None\n67\t\n68\t\n69\t@dataclass\n70\tclass BeginningOfUpkeepTriggeredEvent(TriggeredEvent):\n71\t    pass\n72\t\n73\t\n74\t@dataclass\n75\tclass BeginningOfCombatTriggeredEvent(TriggeredEvent):\n76\t    pass\n77\t\n78\t\n79\t@dataclass\n80\tclass EndOfTurnTriggeredEvent(TriggeredEvent):\n81\t    pass\n82\t\n83\t\n84\t@dataclass\n85\tclass EndStepTriggeredEvent(TriggeredEvent):\n86\t    player: Any = None\n87\t\n88\t\n89\t@dataclass\n90\tclass CreatureDiesTriggeredEvent(TriggeredEvent):\n91\t    creature: Any = None\n92\t    controller: Any = None\n93\t    owner: Any = None\n94\t\n95\t\n96\t@dataclass\n97\tclass SpellCastTriggeredEvent(TriggeredEvent):\n98\t    spell: Any = None\n99\t    player: Any = None\n100\t    card: Any = None\n101\t    controller: Any = None\n102\t\n103\t\n104\t@dataclass\n105\tclass AttacksTriggeredEvent(TriggeredEvent):\n106\t    creature: Any = None\n107\t    attacker: Any = None\n108\t\n109\t\n110\t@dataclass\n111\tclass BlocksTriggeredEvent(TriggeredEvent):\n112\t    creature: Any = None\n113\t\n114\t\n115\t@dataclass\n116\tclass CounterAddedTriggeredEvent(TriggeredEvent):\n117\t    permanent: Any = None\n118\t    counter_type: Any = None\n119\t    amount: int = 0\n120\t\n121\t\n122\t# ---------------------------------------------------------------------------\n123\t# Replacement events\n124\t# ---------------------------------------------------------------------------\n125\t\n126\t@dataclass\n127\tclass ReplacementEvent:\n128\t    \"\"\"Base class for all replacement-effect events.\"\"\"\n129\t\n130\t\n131\t@dataclass\n132\tclass MoveToGraveyardReplacementEvent(ReplacementEvent):\n133\t    \"\"\"Any permanent moving to a graveyard.\n134\t\n135\t    Subclass this for specific causes (destruction, sacrifice, etc.).\n136\t    A replacement registered for this type also fires for all subtypes.\n137\t\n138\t    ``destination`` may be mutated by a replacement to redirect the\n139\t    permanent to a different zone (``\"exile\"``, ``\"library\"``, ``\"hand\"``).\n140\t    Set ``prevented = True`` to signal that the replacement handled the\n141\t    zone move itself and the engine should skip its own move.\n142\t    \"\"\"\n143\t\n144\t    destination: str = \"graveyard\"\n145\t    controller: Any = None\n146\t    owner: Any = None\n147\t    prevented: bool = False\n148\t\n149\t    @property\n150\t    def card(self) -> Any:\n151\t        \"\"\"The object moving to the graveyard (overridden by subclasses).\"\"\"\n152\t        return None\n153\t\n154\t\n155\t@dataclass\n156\tclass CreatureDiesReplacementEvent(MoveToGraveyardReplacementEvent):\n157\t    \"\"\"A creature going to the graveyard via destruction or lethal damage.\"\"\"\n158\t\n159\t    creature: Any = None\n160\t\n161\t    @property\n162\t    def card(self) -> Any:\n163\t        return self.creature\n164\t\n165\t\n166\t@dataclass\n167\tclass PermanentDestroyedReplacementEvent(MoveToGraveyardReplacementEvent):\n168\t    \"\"\"A non-creature permanent going to the graveyard via destruction.\"\"\"\n169\t\n170\t    permanent: Any = None\n171\t\n172\t    @property\n173\t    def card(self) -> Any:\n174\t        return self.permanent\n175\t\n176\t\n177\t@dataclass\n178\tclass SacrificeReplacementEvent(MoveToGraveyardReplacementEvent):\n179\t    \"\"\"A permanent going to the graveyard via sacrifice.\"\"\"\n180\t\n181\t    permanent: Any = None\n182\t\n183\t    @property\n184\t    def card(self) -> Any:\n185\t        return self.permanent\n186\t\n187\t\n188\t@dataclass\n189\tclass CreateTokenReplacementEvent(ReplacementEvent):\n190\t    \"\"\"An effect about to create one or more tokens.\"\"\"\n191\t\n192\t    player: Any = None\n193\t    count: int = 1\n194\t\n195\t\n196\t@dataclass\n197\tclass AddCounterReplacementEvent(ReplacementEvent):\n198\t    \"\"\"An effect about to add one or more counters to a permanent.\"\"\"\n199\t\n200\t    permanent: Any = None\n201\t    amount: int = 1\n202\t"}]},"parent_tool_use_id":null,"session_id":"b76fbb6d-7052-44e0-893e-8a2c1cc9d4a6","uuid":"62c20822-b22d-4b0c-9af5-6b66ce30a15e","timestamp":"2026-05-30T04:08:14.241Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/events.py","content":"\"\"\"Typed event objects for triggered abilities and replacement effects.\n\nTriggered events are passed to :meth:`TriggerManager.fire_event` and\nforwarded to trigger condition callables.\n\nReplacement events are passed to :meth:`ReplacementManager.apply` and\nforwarded to replacement condition/replacement callables.  Subclassing\nencodes event-type hierarchy so a replacement registered for a parent\ntype (e.g. ``MoveToGraveyardReplacementEvent``) also fires for\nsubtypes (e.g. ``CreatureDiesReplacementEvent``).\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom typing import Any\n\n\n# ---------------------------------------------------------------------------\n# Triggered events\n# ---------------------------------------------------------------------------\n\n@dataclass\nclass TriggeredEvent:\n    \"\"\"Base class for all triggered-ability events.\"\"\"\n\n\n@dataclass\nclass EntersBattlefieldTriggeredEvent(TriggeredEvent):\n    permanent: Any = None\n    controller: Any = None\n    card: Any = None\n    creature: Any = None\n\n\n@dataclass\nclass LeavesBattlefieldTriggeredEvent(TriggeredEvent):\n    permanent: Any = None\n    controller: Any = None\n\n\n@dataclass\nclass DealsDamageTriggeredEvent(TriggeredEvent):\n    source: Any = None\n    target: Any = None\n    amount: int = 0\n    is_combat: bool = False\n    combat: bool = False\n\n\n@dataclass\nclass LosesLifeTriggeredEvent(TriggeredEvent):\n    player: Any = None\n    amount: int = 0\n\n\n@dataclass\nclass GainsLifeTriggeredEvent(TriggeredEvent):\n    player: Any = None\n    amount: int = 0\n\n\n@dataclass\nclass DrawsCardTriggeredEvent(TriggeredEvent):\n    player: Any = None\n    card: Any = None\n\n\n@dataclass\nclass BeginningOfUpkeepTriggeredEvent(TriggeredEvent):\n    pass\n\n\n@dataclass\nclass BeginningOfCombatTriggeredEvent(TriggeredEvent):\n    pass\n\n\n@dataclass\nclass EndOfTurnTriggeredEvent(TriggeredEvent):\n    pass\n\n\n@dataclass\nclass EndStepTriggeredEvent(TriggeredEvent):\n    player: Any = None\n\n\n@dataclass\nclass CreatureDiesTriggeredEvent(TriggeredEvent):\n    creature: Any = None\n    controller: Any = None\n    owner: Any = None\n\n\n@dataclass\nclass SpellCastTriggeredEvent(TriggeredEvent):\n    spell: Any = None\n    player: Any = None\n    card: Any = None\n    controller: Any = None\n\n\n@dataclass\nclass AttacksTriggeredEvent(TriggeredEvent):\n    creature: Any = None\n    attacker: Any = None\n\n\n@dataclass\nclass BlocksTriggeredEvent(TriggeredEvent):\n    creature: Any = None\n\n\n@dataclass\nclass CounterAddedTriggeredEvent(TriggeredEvent):\n    permanent: Any = None\n    counter_type: Any = None\n    amount: int = 0\n\n\n# ---------------------------------------------------------------------------\n# Replacement events\n# ---------------------------------------------------------------------------\n\n@dataclass\nclass ReplacementEvent:\n    \"\"\"Base class for all replacement-effect events.\"\"\"\n\n\n@dataclass\nclass MoveToGraveyardReplacementEvent(ReplacementEvent):\n    \"\"\"Any permanent moving to a graveyard.\n\n    Subclass this for specific causes (destruction, sacrifice, etc.).\n    A replacement registered for this type also fires for all subtypes.\n\n    ``destination`` may be mutated by a replacement to redirect the\n    permanent to a different zone (``\"exile\"``, ``\"library\"``, ``\"hand\"``).\n    Set ``prevented = True`` to signal that the replacement handled the\n    zone move itself and the engine should skip its own move.\n    \"\"\"\n\n    destination: str = \"graveyard\"\n    controller: Any = None\n    owner: Any = None\n    prevented: bool = False\n\n    @property\n    def card(self) -> Any:\n        \"\"\"The object moving to the graveyard (overridden by subclasses).\"\"\"\n        return None\n\n\n@dataclass\nclass CreatureDiesReplacementEvent(MoveToGraveyardReplacementEvent):\n    \"\"\"A creature going to the graveyard via destruction or lethal damage.\"\"\"\n\n    creature: Any = None\n\n    @property\n    def card(self) -> Any:\n        return self.creature\n\n\n@dataclass\nclass PermanentDestroyedReplacementEvent(MoveToGraveyardReplacementEvent):\n    \"\"\"A non-creature permanent going to the graveyard via destruction.\"\"\"\n\n    permanent: Any = None\n\n    @property\n    def card(self) -> Any:\n        return self.permanent\n\n\n@dataclass\nclass SacrificeReplacementEvent(MoveToGraveyardReplacementEvent):\n    \"\"\"A permanent going to the graveyard via sacrifice.\"\"\"\n\n    permanent: Any = None\n\n    @property\n    def card(self) -> Any:\n        return self.permanent\n\n\n@dataclass\nclass CreateTokenReplacementEvent(ReplacementEvent):\n    \"\"\"An effect about to create one or more tokens.\"\"\"\n\n    player: Any = None\n    count: int = 1\n\n\n@dataclass\nclass AddCounterReplacementEvent(ReplacementEvent):\n    \"\"\"An effect about to add one or more counters to a permanent.\"\"\"\n\n    permanent: Any = None\n    amount: int = 1\n","numLines":202,"startLine":1,"totalLines":202}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SbASK4f1GBby3rRPh2WNqZ","type":"tool_result","content":"1\t\"\"\"Triggered abilities system — event-driven trigger registration and firing.\n2\t\n3\tProvides the core mechanism for registering triggered abilities and firing\n4\tevents that push matching triggers onto the stack:\n5\t\n6\t- :class:`TriggerRegistration` — dataclass describing a single trigger.\n7\t- :class:`TriggerManager` — central registry for triggers with APNAP-ordered\n8\t  event firing.\n9\t\n10\tEvent types live in :mod:`engine.events` as typed dataclasses.\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\tfrom dataclasses import dataclass, field\n16\tfrom typing import TYPE_CHECKING, Any, Callable\n17\t\n18\tfrom engine.events import TriggeredEvent\n19\tfrom engine.stack import StackObject\n20\t\n21\tif TYPE_CHECKING:\n22\t    from engine.game_state import GameState\n23\t    from engine.player import Player\n24\t\n25\t\n26\t@dataclass\n27\tclass TriggerRegistration:\n28\t    \"\"\"Describes a single triggered ability.\n29\t\n30\t    Attributes:\n31\t        event_type: The event class (or a base class) this trigger watches.\n32\t            The trigger fires for any fired event that is an instance of\n33\t            this class, including instances of subclasses.\n34\t        condition: Optional callable ``(game, event) -> bool`` that must\n35\t            return ``True`` for the trigger to fire.  ``None`` means the\n36\t            trigger always fires for its event type.\n37\t        effect: Callable ``(game) -> None`` executed when the trigger\n38\t            resolves (becomes the :attr:`StackObject.on_resolve` callback).\n39\t        source: The game object (card / permanent) that owns this trigger.\n40\t        controller: The player who controls the source at the time of\n41\t            registration.\n42\t    \"\"\"\n43\t\n44\t    event_type: type[TriggeredEvent]\n45\t    condition: Callable[..., bool] | None\n46\t    effect: Callable[..., None]\n47\t    source: Any\n48\t    controller: Player\n49\t\n50\t\n51\tclass TriggerManager:\n52\t    \"\"\"Central registry for triggered abilities.\n53\t\n54\t    Triggers are registered when a permanent enters the battlefield (or\n55\t    via other game actions) and unregistered when the source leaves.\n56\t\n57\t    :meth:`fire_event` checks all registered triggers of a matching\n58\t    event type, evaluates their conditions, and pushes matching triggers\n59\t    onto the game stack as :class:`StackObject` instances.  Triggers are\n60\t    ordered according to APNAP (Active Player, Non-Active Player):\n61\t\n62\t    * Active player's triggers are pushed first (end up on the bottom\n63\t      of the batch).\n64\t    * Non-active player's triggers are pushed second (end up on top).\n65\t    * Within the same player, triggers are pushed in registration order\n66\t      (controller would normally choose; for now we use registration\n67\t      order as a deterministic default).\n68\t    \"\"\"\n69\t\n70\t    def __init__(self) -> None:\n71\t        self._triggers: list[TriggerRegistration] = []\n72\t\n73\t    def register(self, trigger: TriggerRegistration) -> None:\n74\t        \"\"\"Register a triggered ability.\"\"\"\n75\t        self._triggers.append(trigger)\n76\t\n77\t    def unregister(self, source: Any) -> None:\n78\t        \"\"\"Remove all triggers registered by *source* (identity-based).\"\"\"\n79\t        self._triggers = [t for t in self._triggers if t.source is not source]\n80\t\n81\t    def fire_event(self, game: GameState, event: TriggeredEvent) -> None:\n82\t        \"\"\"Fire an event and push all matching triggers onto the stack.\n83\t\n84\t        Parameters:\n85\t            game: The current game state.\n86\t            event: The typed event object.  Triggers registered for the\n87\t                event's class or any of its parent classes will fire.\n88\t\n89\t        Matching triggers are pushed in APNAP order:\n90\t\n91\t        1. Active player's matching triggers (in registration order).\n92\t        2. Non-active player's matching triggers (in registration order).\n93\t        \"\"\"\n94\t        matching: list[TriggerRegistration] = []\n95\t        for trigger in self._triggers:\n96\t            if not isinstance(event, trigger.event_type):\n97\t                continue\n98\t            if trigger.condition is not None:\n99\t                if not trigger.condition(game, event):\n100\t                    continue\n101\t            matching.append(trigger)\n102\t\n103\t        if not matching:\n104\t            return\n105\t\n106\t        active_player = game.active_player\n107\t        active_triggers: list[TriggerRegistration] = []\n108\t        non_active_triggers: list[TriggerRegistration] = []\n109\t\n110\t        for trigger in matching:\n111\t            if trigger.controller is active_player:\n112\t                active_triggers.append(trigger)\n113\t            else:\n114\t                non_active_triggers.append(trigger)\n115\t\n116\t        ordered = active_triggers + non_active_triggers\n117\t\n118\t        for trigger in ordered:\n119\t            stack_obj = StackObject(\n120\t                source=trigger.source,\n121\t                controller=trigger.controller,\n122\t                on_resolve=trigger.effect,\n123\t            )\n124\t            game.stack.push(stack_obj)\n125\t\n126\t    def get_triggers(self) -> list[TriggerRegistration]:\n127\t        \"\"\"Return a shallow copy of all registered triggers.\"\"\"\n128\t        return list(self._triggers)\n129\t\n130\t    def get_triggers_for_source(self, source: Any) -> list[TriggerRegistration]:\n131\t        \"\"\"Return all triggers registered by *source* (identity-based).\"\"\"\n132\t        return [t for t in self._triggers if t.source is source]\n133\t\n134\t    def clear(self) -> None:\n135\t        \"\"\"Remove all registered triggers.\"\"\"\n136\t        self._triggers.clear()\n137\t"}]},"parent_tool_use_id":null,"session_id":"b76fbb6d-7052-44e0-893e-8a2c1cc9d4a6","uuid":"c656ec5e-a448-4c54-ac8b-8a7c5955483f","timestamp":"2026-05-30T04:08:14.243Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/triggers.py","content":"\"\"\"Triggered abilities system — event-driven trigger registration and firing.\n\nProvides the core mechanism for registering triggered abilities and firing\nevents that push matching triggers onto the stack:\n\n- :class:`TriggerRegistration` — dataclass describing a single trigger.\n- :class:`TriggerManager` — central registry for triggers with APNAP-ordered\n  event firing.\n\nEvent types live in :mod:`engine.events` as typed dataclasses.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom typing import TYPE_CHECKING, Any, Callable\n\nfrom engine.events import TriggeredEvent\nfrom engine.stack import StackObject\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n@dataclass\nclass TriggerRegistration:\n    \"\"\"Describes a single triggered ability.\n\n    Attributes:\n        event_type: The event class (or a base class) this trigger watches.\n            The trigger fires for any fired event that is an instance of\n            this class, including instances of subclasses.\n        condition: Optional callable ``(game, event) -> bool`` that must\n            return ``True`` for the trigger to fire.  ``None`` means the\n            trigger always fires for its event type.\n        effect: Callable ``(game) -> None`` executed when the trigger\n            resolves (becomes the :attr:`StackObject.on_resolve` callback).\n        source: The game object (card / permanent) that owns this trigger.\n        controller: The player who controls the source at the time of\n            registration.\n    \"\"\"\n\n    event_type: type[TriggeredEvent]\n    condition: Callable[..., bool] | None\n    effect: Callable[..., None]\n    source: Any\n    controller: Player\n\n\nclass TriggerManager:\n    \"\"\"Central registry for triggered abilities.\n\n    Triggers are registered when a permanent enters the battlefield (or\n    via other game actions) and unregistered when the source leaves.\n\n    :meth:`fire_event` checks all registered triggers of a matching\n    event type, evaluates their conditions, and pushes matching triggers\n    onto the game stack as :class:`StackObject` instances.  Triggers are\n    ordered according to APNAP (Active Player, Non-Active Player):\n\n    * Active player's triggers are pushed first (end up on the bottom\n      of the batch).\n    * Non-active player's triggers are pushed second (end up on top).\n    * Within the same player, triggers are pushed in registration order\n      (controller would normally choose; for now we use registration\n      order as a deterministic default).\n    \"\"\"\n\n    def __init__(self) -> None:\n        self._triggers: list[TriggerRegistration] = []\n\n    def register(self, trigger: TriggerRegistration) -> None:\n        \"\"\"Register a triggered ability.\"\"\"\n        self._triggers.append(trigger)\n\n    def unregister(self, source: Any) -> None:\n        \"\"\"Remove all triggers registered by *source* (identity-based).\"\"\"\n        self._triggers = [t for t in self._triggers if t.source is not source]\n\n    def fire_event(self, game: GameState, event: TriggeredEvent) -> None:\n        \"\"\"Fire an event and push all matching triggers onto the stack.\n\n        Parameters:\n            game: The current game state.\n            event: The typed event object.  Triggers registered for the\n                event's class or any of its parent classes will fire.\n\n        Matching triggers are pushed in APNAP order:\n\n        1. Active player's matching triggers (in registration order).\n        2. Non-active player's matching triggers (in registration order).\n        \"\"\"\n        matching: list[TriggerRegistration] = []\n        for trigger in self._triggers:\n            if not isinstance(event, trigger.event_type):\n                continue\n            if trigger.condition is not None:\n                if not trigger.condition(game, event):\n                    continue\n            matching.append(trigger)\n\n        if not matching:\n            return\n\n        active_player = game.active_player\n        active_triggers: list[TriggerRegistration] = []\n        non_active_triggers: list[TriggerRegistration] = []\n\n        for trigger in matching:\n            if trigger.controller is active_player:\n                active_triggers.append(trigger)\n            else:\n                non_active_triggers.append(trigger)\n\n        ordered = active_triggers + non_active_triggers\n\n        for trigger in ordered:\n            stack_obj = StackObject(\n                source=trigger.source,\n                controller=trigger.controller,\n                on_resolve=trigger.effect,\n            )\n            game.stack.push(stack_obj)\n\n    def get_triggers(self) -> list[TriggerRegistration]:\n        \"\"\"Return a shallow copy of all registered triggers.\"\"\"\n        return list(self._triggers)\n\n    def get_triggers_for_source(self, source: Any) -> list[TriggerRegistration]:\n        \"\"\"Return all triggers registered by *source* (identity-based).\"\"\"\n        return [t for t in self._triggers if t.source is source]\n\n    def clear(self) -> None:\n        \"\"\"Remove all registered triggers.\"\"\"\n        self._triggers.clear()\n","numLines":137,"startLine":1,"totalLines":137}}}
