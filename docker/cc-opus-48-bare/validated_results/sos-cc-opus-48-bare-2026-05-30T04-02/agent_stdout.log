{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016k2RkySaLV6UoZYJRVTUXM","type":"tool_result","content":"330\t        top = game.stack.peek()\n331\t        assert top is not None\n332\t        assert top.source is source\n333\t\n334\t    def test_stack_object_has_correct_controller(self):\n335\t        game = _sorcery_speed_game()\n336\t        player = game.players[0]\n337\t        ability = ActivatedAbilityInstance(\n338\t            source=object(),\n339\t            controller=player,\n340\t            cost=lambda g, s: True,\n341\t            effect=lambda g: None,\n342\t        )\n343\t        activate_ability(game, player, ability)\n344\t        top = game.stack.peek()\n345\t        assert top.controller is player\n346\t\n347\t    def test_stack_object_on_resolve_is_ability_effect(self):\n348\t        game = _sorcery_speed_game()\n349\t        player = game.players[0]\n350\t        resolved = []\n351\t        effect = lambda g: resolved.append(\"resolved\")\n352\t        ability = ActivatedAbilityInstance(\n353\t            source=object(),\n354\t            controller=player,\n355\t            cost=lambda g, s: True,\n356\t            effect=effect,\n357\t        )\n358\t        activate_ability(game, player, ability)\n359\t        top = game.stack.peek()\n360\t        top.on_resolve(game)\n361\t        assert resolved == [\"resolved\"]\n362\t\n363\t    def test_stack_object_is_not_mana_ability(self):\n364\t        game = _sorcery_speed_game()\n365\t        player = game.players[0]\n366\t        ability = ActivatedAbilityInstance(\n367\t            source=object(),\n368\t            controller=player,\n369\t            cost=lambda g, s: True,\n370\t            effect=lambda g: None,\n371\t        )\n372\t        activate_ability(game, player, ability)\n373\t        top = game.stack.peek()\n374\t        assert top.is_mana_ability is False\n375\t\n376\t    def test_effect_not_called_on_activation(self):\n377\t        \"\"\"Non-mana abilities effect should NOT be called immediately.\"\"\"\n378\t        game = _sorcery_speed_game()\n379\t        player = game.players[0]\n380\t        effect_called = []\n381\t        ability = ActivatedAbilityInstance(\n382\t            source=object(),\n383\t            controller=player,\n384\t            cost=lambda g, s: True,\n385\t            effect=lambda g: effect_called.append(True),\n386\t        )\n387\t        activate_ability(game, player, ability)\n388\t        assert len(effect_called) == 0\n389\t\n390\t\n391\t# ---------------------------------------------------------------------------\n392\t# Timing checks for non-mana abilities\n393\t# ---------------------------------------------------------------------------\n394\t\n395\t\n396\tclass TestNonManaAbilityTiming:\n397\t    \"\"\"Regular (non-mana) activated abilities work at instant speed.\n398\t\n399\t    They can be activated whenever a player has priority — during any\n400\t    phase/step, even with items on the stack.  Priority enforcement is\n401\t    handled externally by ``priority_loop``, not by ``activate_ability``.\n402\t    Only *loyalty* abilities carry a sorcery-speed restriction.\n403\t    \"\"\"\n404\t\n405\t    def test_allowed_during_combat(self):\n406\t        \"\"\"Regular abilities can be activated during combat (instant speed).\"\"\"\n407\t        game = _instant_speed_game()\n408\t        player = game.players[0]\n409\t        ability = ActivatedAbilityInstance(\n410\t            source=object(),\n411\t            controller=player,\n412\t            cost=lambda g, s: True,\n413\t            effect=lambda g: None,\n414\t            is_mana_ability=False,\n415\t        )\n416\t        # Should not raise — regular abilities are instant speed.\n417\t        activate_ability(game, player, ability)\n418\t        assert not game.stack.is_empty()\n419\t\n420\t    def test_allowed_when_stack_not_empty(self):\n421\t        \"\"\"Regular abilities can be activated even when the stack has items.\"\"\"\n422\t        game = _sorcery_speed_game()\n423\t        player = game.players[0]\n424\t        # Put something on the stack.\n425\t        game.stack.push(StackObject(source=object(), controller=player))\n426\t        ability = ActivatedAbilityInstance(\n427\t            source=object(),\n428\t            controller=player,\n429\t            cost=lambda g, s: True,\n430\t            effect=lambda g: None,\n431\t            is_mana_ability=False,\n432\t        )\n433\t        # Should not raise — regular abilities work at instant speed.\n434\t        activate_ability(game, player, ability)\n435\t        # Stack should now have 2 items (the existing one + the new ability).\n436\t        assert game.stack.peek() is not None\n437\t\n438\t    def test_allowed_for_non_active_player(self):\n439\t        \"\"\"Regular abilities can be activated by non-active player (with priority).\"\"\"\n440\t        game = _sorcery_speed_game()\n441\t        non_active = game.players[1]\n442\t        ability = ActivatedAbilityInstance(\n443\t            source=object(),\n444\t            controller=non_active,\n445\t            cost=lambda g, s: True,\n446\t            effect=lambda g: None,\n447\t            is_mana_ability=False,\n448\t        )\n449\t        # Should not raise — priority enforcement is external.\n450\t        activate_ability(game, non_active, ability)\n451\t        assert not game.stack.is_empty()\n452\t\n453\t    def test_allowed_during_end_step(self):\n454\t        \"\"\"Regular abilities can be activated during the end step.\"\"\"\n455\t        game = _make_game(phase=Phase.ENDING, step=Step.END)\n456\t        player = game.players[0]\n457\t        ability = ActivatedAbilityInstance(\n458\t            source=object(),\n459\t            controller=player,\n460\t            cost=lambda g, s: True,\n461\t            effect=lambda g: None,\n462\t            is_mana_ability=False,\n463\t        )\n464\t        activate_ability(game, player, ability)\n465\t        assert not game.stack.is_empty()\n466\t\n467\t\n468\t# ---------------------------------------------------------------------------\n469\t# Cost payment failure\n470\t# ---------------------------------------------------------------------------\n471\t\n472\t\n473\tclass TestCostPaymentFailure:\n474\t    \"\"\"If cost returns False, AbilityError is raised and nothing is pushed.\"\"\"\n475\t\n476\t    def test_cost_failure_raises_ability_error(self):\n477\t        game = _sorcery_speed_game()\n478\t        player = game.players[0]\n479\t        ability = ActivatedAbilityInstance(\n480\t            source=object(),\n481\t            controller=player,\n482\t            cost=lambda g, s: False,\n483\t            effect=lambda g: None,\n484\t        )\n485\t        with pytest.raises(AbilityError, match=\"cost could not be paid\"):\n486\t            activate_ability(game, player, ability)\n487\t\n488\t    def test_cost_failure_leaves_stack_empty(self):\n489\t        game = _sorcery_speed_game()\n490\t        player = game.players[0]\n491\t        ability = ActivatedAbilityInstance(\n492\t            source=object(),\n493\t            controller=player,\n494\t            cost=lambda g, s: False,\n495\t            effect=lambda g: None,\n496\t        )\n497\t        with pytest.raises(AbilityError):\n498\t            activate_ability(game, player, ability)\n499\t        assert game.stack.is_empty()\n500\t\n501\t    def test_cost_failure_effect_not_called(self):\n502\t        game = _sorcery_speed_game()\n503\t        player = game.players[0]\n504\t        effect_called = []\n505\t        ability = ActivatedAbilityInstance(\n506\t            source=object(),\n507\t            controller=player,\n508\t            cost=lambda g, s: False,\n509\t            effect=lambda g: effect_called.append(True),\n510\t        )\n511\t        with pytest.raises(AbilityError):\n512\t            activate_ability(game, player, ability)\n513\t        assert len(effect_called) == 0\n514\t\n515\t\n516\t# ---------------------------------------------------------------------------\n517\t# LoyaltyAbility — positive cost (+N)\n518\t# ---------------------------------------------------------------------------\n519\t\n520\t\n521\tclass TestLoyaltyAbilityPositiveCost:\n522\t    \"\"\"Loyalty ability with positive cost increases loyalty counters.\"\"\"\n523\t\n524\t    def test_positive_loyalty_cost_increases_loyalty(self):\n525\t        game = _sorcery_speed_game()\n526\t        player = game.players[0]\n527\t        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=3)\n528\t        ability = LoyaltyAbilityInstance(\n529\t            source=pw,\n530\t            controller=player,\n531\t            loyalty_cost=2,\n532\t            effect=lambda g: None,\n533\t        )\n534\t        activate_ability(game, player, ability)\n535\t        assert pw.loyalty == 5\n536\t\n537\t    def test_positive_cost_pushes_to_stack(self):\n538\t        game = _sorcery_speed_game()\n539\t        player = game.players[0]\n540\t        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=3)\n541\t        ability = LoyaltyAbilityInstance(\n542\t            source=pw,\n543\t            controller=player,\n544\t            loyalty_cost=1,\n545\t            effect=lambda g: None,\n546\t        )\n547\t        activate_ability(game, player, ability)\n548\t        assert not game.stack.is_empty()\n549\t"}]},"parent_tool_use_id":null,"session_id":"b76fbb6d-7052-44e0-893e-8a2c1cc9d4a6","uuid":"2e2bf7a9-52be-4d91-8cad-43c7599af3bc","timestamp":"2026-05-30T05:19:05.462Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine_tests/test_abilities.py","content":"        top = game.stack.peek()\n        assert top is not None\n        assert top.source is source\n\n    def test_stack_object_has_correct_controller(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        ability = ActivatedAbilityInstance(\n            source=object(),\n            controller=player,\n            cost=lambda g, s: True,\n            effect=lambda g: None,\n        )\n        activate_ability(game, player, ability)\n        top = game.stack.peek()\n        assert top.controller is player\n\n    def test_stack_object_on_resolve_is_ability_effect(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        resolved = []\n        effect = lambda g: resolved.append(\"resolved\")\n        ability = ActivatedAbilityInstance(\n            source=object(),\n            controller=player,\n            cost=lambda g, s: True,\n            effect=effect,\n        )\n        activate_ability(game, player, ability)\n        top = game.stack.peek()\n        top.on_resolve(game)\n        assert resolved == [\"resolved\"]\n\n    def test_stack_object_is_not_mana_ability(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        ability = ActivatedAbilityInstance(\n            source=object(),\n            controller=player,\n            cost=lambda g, s: True,\n            effect=lambda g: None,\n        )\n        activate_ability(game, player, ability)\n        top = game.stack.peek()\n        assert top.is_mana_ability is False\n\n    def test_effect_not_called_on_activation(self):\n        \"\"\"Non-mana abilities effect should NOT be called immediately.\"\"\"\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        effect_called = []\n        ability = ActivatedAbilityInstance(\n            source=object(),\n            controller=player,\n            cost=lambda g, s: True,\n            effect=lambda g: effect_called.append(True),\n        )\n        activate_ability(game, player, ability)\n        assert len(effect_called) == 0\n\n\n# ---------------------------------------------------------------------------\n# Timing checks for non-mana abilities\n# ---------------------------------------------------------------------------\n\n\nclass TestNonManaAbilityTiming:\n    \"\"\"Regular (non-mana) activated abilities work at instant speed.\n\n    They can be activated whenever a player has priority — during any\n    phase/step, even with items on the stack.  Priority enforcement is\n    handled externally by ``priority_loop``, not by ``activate_ability``.\n    Only *loyalty* abilities carry a sorcery-speed restriction.\n    \"\"\"\n\n    def test_allowed_during_combat(self):\n        \"\"\"Regular abilities can be activated during combat (instant speed).\"\"\"\n        game = _instant_speed_game()\n        player = game.players[0]\n        ability = ActivatedAbilityInstance(\n            source=object(),\n            controller=player,\n            cost=lambda g, s: True,\n            effect=lambda g: None,\n            is_mana_ability=False,\n        )\n        # Should not raise — regular abilities are instant speed.\n        activate_ability(game, player, ability)\n        assert not game.stack.is_empty()\n\n    def test_allowed_when_stack_not_empty(self):\n        \"\"\"Regular abilities can be activated even when the stack has items.\"\"\"\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        # Put something on the stack.\n        game.stack.push(StackObject(source=object(), controller=player))\n        ability = ActivatedAbilityInstance(\n            source=object(),\n            controller=player,\n            cost=lambda g, s: True,\n            effect=lambda g: None,\n            is_mana_ability=False,\n        )\n        # Should not raise — regular abilities work at instant speed.\n        activate_ability(game, player, ability)\n        # Stack should now have 2 items (the existing one + the new ability).\n        assert game.stack.peek() is not None\n\n    def test_allowed_for_non_active_player(self):\n        \"\"\"Regular abilities can be activated by non-active player (with priority).\"\"\"\n        game = _sorcery_speed_game()\n        non_active = game.players[1]\n        ability = ActivatedAbilityInstance(\n            source=object(),\n            controller=non_active,\n            cost=lambda g, s: True,\n            effect=lambda g: None,\n            is_mana_ability=False,\n        )\n        # Should not raise — priority enforcement is external.\n        activate_ability(game, non_active, ability)\n        assert not game.stack.is_empty()\n\n    def test_allowed_during_end_step(self):\n        \"\"\"Regular abilities can be activated during the end step.\"\"\"\n        game = _make_game(phase=Phase.ENDING, step=Step.END)\n        player = game.players[0]\n        ability = ActivatedAbilityInstance(\n            source=object(),\n            controller=player,\n            cost=lambda g, s: True,\n            effect=lambda g: None,\n            is_mana_ability=False,\n        )\n        activate_ability(game, player, ability)\n        assert not game.stack.is_empty()\n\n\n# ---------------------------------------------------------------------------\n# Cost payment failure\n# ---------------------------------------------------------------------------\n\n\nclass TestCostPaymentFailure:\n    \"\"\"If cost returns False, AbilityError is raised and nothing is pushed.\"\"\"\n\n    def test_cost_failure_raises_ability_error(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        ability = ActivatedAbilityInstance(\n            source=object(),\n            controller=player,\n            cost=lambda g, s: False,\n            effect=lambda g: None,\n        )\n        with pytest.raises(AbilityError, match=\"cost could not be paid\"):\n            activate_ability(game, player, ability)\n\n    def test_cost_failure_leaves_stack_empty(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        ability = ActivatedAbilityInstance(\n            source=object(),\n            controller=player,\n            cost=lambda g, s: False,\n            effect=lambda g: None,\n        )\n        with pytest.raises(AbilityError):\n            activate_ability(game, player, ability)\n        assert game.stack.is_empty()\n\n    def test_cost_failure_effect_not_called(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        effect_called = []\n        ability = ActivatedAbilityInstance(\n            source=object(),\n            controller=player,\n            cost=lambda g, s: False,\n            effect=lambda g: effect_called.append(True),\n        )\n        with pytest.raises(AbilityError):\n            activate_ability(game, player, ability)\n        assert len(effect_called) == 0\n\n\n# ---------------------------------------------------------------------------\n# LoyaltyAbility — positive cost (+N)\n# ---------------------------------------------------------------------------\n\n\nclass TestLoyaltyAbilityPositiveCost:\n    \"\"\"Loyalty ability with positive cost increases loyalty counters.\"\"\"\n\n    def test_positive_loyalty_cost_increases_loyalty(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=3)\n        ability = LoyaltyAbilityInstance(\n            source=pw,\n            controller=player,\n            loyalty_cost=2,\n            effect=lambda g: None,\n        )\n        activate_ability(game, player, ability)\n        assert pw.loyalty == 5\n\n    def test_positive_cost_pushes_to_stack(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=3)\n        ability = LoyaltyAbilityInstance(\n            source=pw,\n            controller=player,\n            loyalty_cost=1,\n            effect=lambda g: None,\n        )\n        activate_ability(game, player, ability)\n        assert not game.stack.is_empty()\n","numLines":220,"startLine":330,"totalLines":977}}}
