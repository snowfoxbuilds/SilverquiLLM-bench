{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XP9ABwZECCt74VCrCeC7m4","type":"tool_result","content":"1\t\"\"\"Typed event objects for triggered abilities and replacement effects.\n2\t\n3\tTriggered events are passed to :meth:`TriggerManager.fire_event` and\n4\tforwarded to trigger condition callables.\n5\t\n6\tReplacement events are passed to :meth:`ReplacementManager.apply` and\n7\tforwarded to replacement condition/replacement callables.  Subclassing\n8\tencodes event-type hierarchy so a replacement registered for a parent\n9\ttype (e.g. ``MoveToGraveyardReplacementEvent``) also fires for\n10\tsubtypes (e.g. ``CreatureDiesReplacementEvent``).\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\tfrom dataclasses import dataclass\n16\tfrom typing import Any\n17\t\n18\t\n19\t# ---------------------------------------------------------------------------\n20\t# Triggered events\n21\t# ---------------------------------------------------------------------------\n22\t\n23\t@dataclass\n24\tclass TriggeredEvent:\n25\t    \"\"\"Base class for all triggered-ability events.\"\"\"\n26\t\n27\t\n28\t@dataclass\n29\tclass EntersBattlefieldTriggeredEvent(TriggeredEvent):\n30\t    permanent: Any = None\n31\t    controller: Any = None\n32\t    card: Any = None\n33\t    creature: Any = None\n34\t\n35\t\n36\t@dataclass\n37\tclass LeavesBattlefieldTriggeredEvent(TriggeredEvent):\n38\t    permanent: Any = None\n39\t    controller: Any = None\n40\t\n41\t\n42\t@dataclass\n43\tclass DealsDamageTriggeredEvent(TriggeredEvent):\n44\t    source: Any = None\n45\t    target: Any = None\n46\t    amount: int = 0\n47\t    is_combat: bool = False\n48\t    combat: bool = False\n49\t\n50\t\n51\t@dataclass\n52\tclass LosesLifeTriggeredEvent(TriggeredEvent):\n53\t    player: Any = None\n54\t    amount: int = 0\n55\t\n56\t\n57\t@dataclass\n58\tclass GainsLifeTriggeredEvent(TriggeredEvent):\n59\t    player: Any = None\n60\t    amount: int = 0\n61\t\n62\t\n63\t@dataclass\n64\tclass DrawsCardTriggeredEvent(TriggeredEvent):\n65\t    player: Any = None\n66\t    card: Any = None\n67\t\n68\t\n69\t@dataclass\n70\tclass BeginningOfUpkeepTriggeredEvent(TriggeredEvent):\n71\t    player: Any = None\n72\t\n73\t\n74\t@dataclass\n75\tclass BeginningOfMainPhaseTriggeredEvent(TriggeredEvent):\n76\t    \"\"\"Fired at the start of a main phase (precombat or postcombat).\n77\t\n78\t    ``player`` is the active player whose main phase is beginning;\n79\t    ``phase`` is the :class:`~engine.types.Phase` (``PRECOMBAT_MAIN`` or\n80\t    ``POSTCOMBAT_MAIN``).  Used by delayed effects such as Mana Sculpt's\n81\t    \"at the beginning of your next main phase\" and Paradigm's recast.\n82\t    \"\"\"\n83\t\n84\t    player: Any = None\n85\t    phase: Any = None\n86\t\n87\t\n88\t@dataclass\n89\tclass BeginningOfCombatTriggeredEvent(TriggeredEvent):\n90\t    pass\n91\t\n92\t\n93\t@dataclass\n94\tclass EndOfTurnTriggeredEvent(TriggeredEvent):\n95\t    pass\n96\t\n97\t\n98\t@dataclass\n99\tclass EndStepTriggeredEvent(TriggeredEvent):\n100\t    player: Any = None\n101\t\n102\t\n103\t@dataclass\n104\tclass CreatureDiesTriggeredEvent(TriggeredEvent):\n105\t    creature: Any = None\n106\t    controller: Any = None\n107\t    owner: Any = None\n108\t\n109\t\n110\t@dataclass\n111\tclass SpellCastTriggeredEvent(TriggeredEvent):\n112\t    spell: Any = None\n113\t    player: Any = None\n114\t    card: Any = None\n115\t    controller: Any = None\n116\t\n117\t\n118\t@dataclass\n119\tclass AttacksTriggeredEvent(TriggeredEvent):\n120\t    creature: Any = None\n121\t    attacker: Any = None\n122\t\n123\t\n124\t@dataclass\n125\tclass BlocksTriggeredEvent(TriggeredEvent):\n126\t    creature: Any = None\n127\t\n128\t\n129\t@dataclass\n130\tclass CounterAddedTriggeredEvent(TriggeredEvent):\n131\t    permanent: Any = None\n132\t    counter_type: Any = None\n133\t    amount: int = 0\n134\t\n135\t\n136\t# ---------------------------------------------------------------------------\n137\t# Replacement events\n138\t# ---------------------------------------------------------------------------\n139\t\n140\t@dataclass\n141\tclass ReplacementEvent:\n142\t    \"\"\"Base class for all replacement-effect events.\"\"\"\n143\t\n144\t\n145\t@dataclass\n146\tclass MoveToGraveyardReplacementEvent(ReplacementEvent):\n147\t    \"\"\"Any permanent moving to a graveyard.\n148\t\n149\t    Subclass this for specific causes (destruction, sacrifice, etc.).\n150\t    A replacement registered for this type also fires for all subtypes.\n151\t\n152\t    ``destination`` may be mutated by a replacement to redirect the\n153\t    permanent to a different zone (``\"exile\"``, ``\"library\"``, ``\"hand\"``).\n154\t    Set ``prevented = True`` to signal that the replacement handled the\n155\t    zone move itself and the engine should skip its own move.\n156\t    \"\"\"\n157\t\n158\t    destination: str = \"graveyard\"\n159\t    controller: Any = None\n160\t    owner: Any = None\n161\t    prevented: bool = False\n162\t\n163\t    @property\n164\t    def card(self) -> Any:\n165\t        \"\"\"The object moving to the graveyard (overridden by subclasses).\"\"\"\n166\t        return None\n167\t\n168\t\n169\t@dataclass\n170\tclass CreatureDiesReplacementEvent(MoveToGraveyardReplacementEvent):\n171\t    \"\"\"A creature going to the graveyard via destruction or lethal damage.\"\"\"\n172\t\n173\t    creature: Any = None\n174\t\n175\t    @property\n176\t    def card(self) -> Any:\n177\t        return self.creature\n178\t\n179\t\n180\t@dataclass\n181\tclass PermanentDestroyedReplacementEvent(MoveToGraveyardReplacementEvent):\n182\t    \"\"\"A non-creature permanent going to the graveyard via destruction.\"\"\"\n183\t\n184\t    permanent: Any = None\n185\t\n186\t    @property\n187\t    def card(self) -> Any:\n188\t        return self.permanent\n189\t\n190\t\n191\t@dataclass\n192\tclass SacrificeReplacementEvent(MoveToGraveyardReplacementEvent):\n193\t    \"\"\"A permanent going to the graveyard via sacrifice.\"\"\"\n194\t\n195\t    permanent: Any = None\n196\t\n197\t    @property\n198\t    def card(self) -> Any:\n199\t        return self.permanent\n200\t\n201\t\n202\t@dataclass\n203\tclass CreateTokenReplacementEvent(ReplacementEvent):\n204\t    \"\"\"An effect about to create one or more tokens.\"\"\"\n205\t\n206\t    player: Any = None\n207\t    count: int = 1\n208\t\n209\t\n210\t@dataclass\n211\tclass AddCounterReplacementEvent(ReplacementEvent):\n212\t    \"\"\"An effect about to add one or more counters to a permanent.\"\"\"\n213\t\n214\t    permanent: Any = None\n215\t    amount: int = 1\n216\t"}]},"parent_tool_use_id":"toolu_01X6Ryuijvq29Av9gGTdruzn","session_id":"b76fbb6d-7052-44e0-893e-8a2c1cc9d4a6","uuid":"0193a580-624b-492a-b896-abc76508dad3","timestamp":"2026-05-30T04:54:34.612Z","subagent_type":"Explore","task_description":"Research token creation and ETB triggers"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RVpYBfvCWA79N9GxfDLU7A","type":"tool_result","content":"1\t\"\"\"Casting and resolution pipeline for spells and lands.\n2\t\n3\tProvides the full flow from casting a spell or playing a land through\n4\tresolution:\n5\t\n6\t- :func:`cast_spell` — verify timing & legality → move hand to stack →\n7\t  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n8\t- :func:`play_land` — verify land play remaining → move hand to\n9\t  battlefield → decrement ``land_plays_remaining``.\n10\t- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n11\t  helpers used by the casting pipeline.\n12\t\n13\tResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\n14\tcreated by :func:`cast_spell`:\n15\t\n16\t- Call ``card.on_resolve(game)``.\n17\t- Permanents (creature / enchantment / artifact / planeswalker) move from\n18\t  the stack to the battlefield.\n19\t- Non-permanents (instant / sorcery) move to the graveyard.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import TYPE_CHECKING, Any\n25\t\n26\tfrom engine.card import CardImpl\n27\tfrom engine.events import SpellCastTriggeredEvent\n28\tfrom engine.stack import StackObject\n29\tfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\n30\tfrom engine.zones import move_zone\n31\t\n32\tif TYPE_CHECKING:\n33\t    from engine.game_state import GameState\n34\t    from engine.player import Player\n35\t\n36\t\n37\t# Card types that represent permanents — these go to the battlefield on resolve.\n38\t_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n39\t    CardType.CREATURE,\n40\t    CardType.ENCHANTMENT,\n41\t    CardType.ARTIFACT,\n42\t    CardType.PLANESWALKER,\n43\t})\n44\t\n45\t\n46\tclass CastingError(Exception):\n47\t    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n48\t\n49\t\n50\t# ------------------------------------------------------------------\n51\t# Timing helpers\n52\t# ------------------------------------------------------------------\n53\t\n54\tdef is_sorcery_speed(game: GameState, player: Player) -> bool:\n55\t    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n56\t\n57\t    Sorcery speed requires all of:\n58\t\n59\t    * *player* is the active player.\n60\t    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n61\t      ``POSTCOMBAT_MAIN``).\n62\t    * The stack is empty.\n63\t    \"\"\"\n64\t    if player is not game.active_player:\n65\t        return False\n66\t    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n67\t        return False\n68\t    if not game.stack.is_empty():\n69\t        return False\n70\t    return True\n71\t\n72\t\n73\tdef can_cast_at_instant_speed(card: CardImpl) -> bool:\n74\t    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n75\t\n76\t    A card has instant-speed timing if it is an instant or has the\n77\t    :attr:`~engine.types.Keyword.FLASH` keyword.\n78\t    \"\"\"\n79\t    if CardType.INSTANT in card.card_types:\n80\t        return True\n81\t    if Keyword.FLASH & card.keywords:\n82\t        return True\n83\t    return False\n84\t\n85\t\n86\t# ------------------------------------------------------------------\n87\t# Cost reduction\n88\t# ------------------------------------------------------------------\n89\t\n90\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n91\t    \"\"\"Return the generic mana reduction for casting *card*.\n92\t\n93\t    Queries ``card.cost_reduction(game)`` and clamps the result so that\n94\t    the generic portion of the mana cost cannot go below 0.\n95\t\n96\t    This is a simplified single-card self-reduction model.  Full MTG\n97\t    cost-reduction interactions (Trinisphere, multiple reductions from\n98\t    different sources) are deferred.\n99\t    \"\"\"\n100\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n101\t    # casting player even when the card was never explicitly assigned one.\n102\t    prev_controller = card.controller\n103\t    card.controller = controller\n104\t    raw = card.cost_reduction(game)\n105\t    # Restore previous controller in case the caller doesn't want a\n106\t    # side-effect (get_cost_reduction is a query, not a mutation).\n107\t    card.controller = prev_controller\n108\t\n109\t    # External cost-reduction effects from permanents on the battlefield\n110\t    # (e.g. \"instant and sorcery spells you cast have affinity for creatures\").\n111\t    for player in game.players:\n112\t        for permanent in player.zones[Zone.BATTLEFIELD].get_all():\n113\t            if permanent is card:\n114\t                continue\n115\t            hook = getattr(permanent, \"spell_cost_reduction\", None)\n116\t            if hook is not None:\n117\t                raw += hook(game, card, controller)\n118\t\n119\t    generic = card.mana_cost.generic if card.mana_cost else 0\n120\t    return max(0, min(raw, generic))\n121\t\n122\t\n123\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n124\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n125\t    new_generic = max(0, cost.generic - reduction)\n126\t    return ManaCost(\n127\t        generic=new_generic,\n128\t        pips=dict(cost.pips),\n129\t        x_count=cost.x_count,\n130\t        hybrid=list(cost.hybrid),\n131\t    )\n132\t\n133\t\n134\t# ------------------------------------------------------------------\n135\t# Cast spell\n136\t# ------------------------------------------------------------------\n137\t\n138\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n139\t    \"\"\"Cast *card* from *player*'s hand.\n140\t\n141\t    Pipeline\n142\t    --------\n143\t    1. **Timing check** — instants (and cards with flash) can be cast\n144\t       whenever the player has priority; everything else requires\n145\t       sorcery-speed timing.\n146\t    2. **can_cast** — ask the card whether it can legally be cast.\n147\t    3. **Hand check** — the card must be in the player's hand.\n148\t    4. **Move hand → stack zone** — remove the card from the hand and\n149\t       place it into the player's stack zone.\n150\t    5. **Choose targets** — if the card specifies targets (via\n151\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n152\t    6. **Mana check / payment** — the player's mana pool must be able to\n153\t       pay the card's mana cost.  If payment fails, the card is rolled\n154\t       back from the stack zone to the hand.\n155\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n156\t    8. **Push StackObject** — push a :class:`StackObject` whose\n157\t       ``on_resolve`` callback handles resolution.\n158\t\n159\t    Raises:\n160\t        CastingError: If any legality check fails.\n161\t    \"\"\"\n162\t    # 1. Timing\n163\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n164\t        raise CastingError(\n165\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n166\t        )\n167\t\n168\t    # 2. can_cast\n169\t    if not card.can_cast(game):\n170\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n171\t\n172\t    # 3. Hand check\n173\t    hand = game.get_hand(player)\n174\t    if not hand.contains(card):\n175\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n176\t\n177\t    # 4. Move card from hand to stack zone\n178\t    stack_zone = player.zones[Zone.STACK]\n179\t    hand.remove(card)\n180\t    stack_zone.add(card)\n181\t\n182\t    # Clear any stale colors_spent from a prior cast before new payment.\n183\t    if hasattr(card, \"colors_spent\"):\n184\t        del card.colors_spent\n185\t\n186\t    # 5. Choose targets\n187\t    target_specs = card.get_targets(game)\n188\t    chosen_targets: list[Any] = []\n189\t    if target_specs:\n190\t        for spec in target_specs:\n191\t            target = player.choose_target(target_specs, spec)\n192\t            # Validate against filter_fn if the spec provides one\n193\t            filter_fn = getattr(spec, \"filter_fn\", None)\n194\t            if filter_fn is not None and target is not None:\n195\t                if not filter_fn(target):\n196\t                    stack_zone.remove(card)\n197\t                    hand.add(card)\n198\t                    raise CastingError(\n199\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n200\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n201\t                    )\n202\t            chosen_targets.append(target)\n203\t\n204\t    # 5b. Protection check — reject targets that have protection from this\n205\t    #     spell (the T in DEBT).\n206\t    from engine.protection import has_protection_from\n207\t\n208\t    for target in chosen_targets:\n209\t        if has_protection_from(target, card):\n210\t            # Rollback: move card from stack zone back to hand\n211\t            stack_zone.remove(card)\n212\t            hand.add(card)\n213\t            raise CastingError(\n214\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n215\t            )\n216\t\n217\t    # Targets are stored on the StackObject (not the card) and passed\n218\t    # through the resolve pipeline via on_resolve(game, targets=...).\n219\t\n220\t    # 6. Mana check / payment (rollback on failure)\n221\t    # Ensure the card knows its controller so that cost_reduction() hooks\n222\t    # (e.g. Embercleave counting attacking creatures you control) see the\n223\t    # casting player, even for cards that were added to hand without an\n224\t    # explicit controller assignment.\n225\t    if card.controller is None:\n226\t        card.controller = player\n227\t    reduction = get_cost_reduction(game, card, player)\n228\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n229\t\n230\t    if not player.mana_pool.can_pay(effective_cost):\n231\t        # Rollback: move card from stack zone back to hand\n232\t        stack_zone.remove(card)\n233\t        hand.add(card)\n234\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n235\t\n236\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n237\t    player.mana_pool.pay(effective_cost)\n238\t\n239\t    # Store colors of mana spent on the card for mechanics like Converge\n240\t    # that care about the colors used to cast the spell.\n241\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n242\t\n243\t    # Store the amount of mana spent to cast the spell (for mechanics like\n244\t    # Mana Sculpt that add mana equal to what was paid for a countered spell).\n245\t    card.mana_spent = effective_cost.cmc  # type: ignore[attr-defined]\n246\t\n247\t    # 7. Call on_cast hook\n248\t    card.on_cast(game)\n249\t\n250\t    # 8. Build on_resolve callback and push StackObject\n251\t    stack_obj = StackObject(\n252\t        source=card,\n253\t        controller=player,\n254\t        targets=chosen_targets,\n255\t        on_resolve=lambda g: None,  # replaced below\n256\t    )\n257\t\n258\t    def _on_resolve(g: GameState) -> None:\n259\t        _resolve_spell(g, card, player, stack_obj)\n260\t\n261\t    stack_obj.on_resolve = _on_resolve\n262\t    game.stack.push(stack_obj)\n263\t\n264\t    # Spell-cast triggers (e.g. casualty, prowess) fire after the spell is on\n265\t    # the stack, so their triggered abilities are placed above it and resolve\n266\t    # first.  Firing with no registered spell-cast triggers is a no-op.\n267\t    game.trigger_manager.fire_event(\n268\t        game,\n269\t        SpellCastTriggeredEvent(\n270\t            spell=stack_obj, player=player, card=card, controller=player\n271\t        ),\n272\t    )\n273\t\n274\t\n275\t# ------------------------------------------------------------------\n276\t# Cast spell without paying mana cost (free-cast from any zone)\n277\t# ------------------------------------------------------------------\n278\t\n279\t\n280\tdef cast_spell_free(\n281\t    game: GameState,\n282\t    player: Player,\n283\t    card: CardImpl,\n284\t    from_zone: Zone,\n285\t) -> None:\n286\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n287\t\n288\t    This is used by effects that allow casting from zones other than hand\n289\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n290\t    or cascade.\n291\t\n292\t    Pipeline\n293\t    --------\n294\t    1. **can_cast** — ask the card whether it can legally be cast (same\n295\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n296\t    2. Move *card* from *from_zone* to the stack zone.\n297\t    3. Choose targets (if applicable) with validation and protection check.\n298\t    4. Call ``on_cast`` hook.\n299\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n300\t       resolution normally (permanents → battlefield, non-permanents →\n301\t       graveyard).\n302\t\n303\t    No timing check or mana payment is performed.  The spell goes on the\n304\t    stack and can be responded to normally (e.g. countered).\n305\t\n306\t    If targeting or other post-move checks fail, the card is rolled back\n307\t    to its source zone.\n308\t\n309\t    Parameters:\n310\t        game: The current game state.\n311\t        player: The player casting the spell.\n312\t        card: The card to cast.\n313\t        from_zone: The zone the card is currently in.\n314\t\n315\t    Raises:\n316\t        CastingError: If the card cannot be found in *from_zone* or\n317\t            legality checks fail.\n318\t    \"\"\"\n319\t    from engine.zones import move_to_zone\n320\t\n321\t    # Ensure controller is set\n322\t    card.controller = player\n323\t    if card.owner is None:\n324\t        card.owner = player\n325\t\n326\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n327\t    if not card.can_cast(game):\n328\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n329\t\n330\t    # 2. Locate card in source zone\n331\t    source_zone_container = player.zones[from_zone]\n332\t    if not source_zone_container.contains(card):\n333\t        # Try to find the card in any player's zone\n334\t        source_zone_container = None\n335\t        for p in game.players:\n336\t            z = p.zones[from_zone]\n337\t            if z.contains(card):\n338\t                source_zone_container = z\n339\t                break\n340\t\n341\t    if source_zone_container is None or not source_zone_container.contains(card):\n342\t        raise CastingError(\n343\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n344\t        )\n345\t\n346\t    # Move card from source zone to stack zone\n347\t    stack_zone = player.zones[Zone.STACK]\n348\t    source_zone_container.remove(card)\n349\t    stack_zone.add(card)\n350\t\n351\t    # 3. Choose targets (with rollback on failure)\n352\t    try:\n353\t        target_specs = card.get_targets(game)\n354\t        chosen_targets: list[Any] = []\n355\t        if target_specs:\n356\t            for spec in target_specs:\n357\t                target = player.choose_target(target_specs, spec)\n358\t                # Validate against filter_fn if the spec provides one\n359\t                filter_fn = getattr(spec, \"filter_fn\", None)\n360\t                if filter_fn is not None and target is not None:\n361\t                    if not filter_fn(target):\n362\t                        raise CastingError(\n363\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n364\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n365\t                        )\n366\t                chosen_targets.append(target)\n367\t\n368\t        # Protection check — reject targets that have protection from this spell\n369\t        from engine.protection import has_protection_from\n370\t\n371\t        for target in chosen_targets:\n372\t            if has_protection_from(target, card):\n373\t                raise CastingError(\n374\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n375\t                )\n376\t    except Exception as exc:\n377\t        # Rollback: move card from stack zone back to source zone\n378\t        stack_zone.remove(card)\n379\t        source_zone_container.add(card)\n380\t        raise CastingError(str(exc)) from exc\n381\t\n382\t    # 4. Call on_cast hook\n383\t    card.on_cast(game)\n384\t\n385\t    # 5. Build on_resolve callback and push StackObject\n386\t    stack_obj = StackObject(\n387\t        source=card,\n388\t        controller=player,\n389\t        targets=chosen_targets,\n390\t        on_resolve=lambda g: None,  # replaced below\n391\t    )\n392\t\n393\t    def _on_resolve(g: GameState) -> None:\n394\t        _resolve_spell(g, card, player, stack_obj)\n395\t\n396\t    stack_obj.on_resolve = _on_resolve\n397\t    game.stack.push(stack_obj)\n398\t\n399\t    # Fire spell-cast triggers for free-cast spells too (e.g. a spell cast\n400\t    # from the graveyard still triggers \"whenever you cast\" abilities).\n401\t    game.trigger_manager.fire_event(\n402\t        game,\n403\t        SpellCastTriggeredEvent(\n404\t            spell=stack_obj, player=player, card=card, controller=player\n405\t        ),\n406\t    )\n407\t\n408\t\n409\t# ------------------------------------------------------------------\n410\t# Resolution (called when the stack pops)\n411\t# ------------------------------------------------------------------\n412\t\n413\tdef _resolve_spell(\n414\t    game: GameState,\n415\t    card: CardImpl,\n416\t    player: Player,\n417\t    stack_obj: StackObject,\n418\t) -> None:\n419\t    \"\"\"Resolve *card* cast by *player*.\n420\t\n421\t    1. Call ``card.on_resolve(game, targets=targets)``.\n422\t    2. Remove the card from the stack zone.\n423\t    3. If the card is a permanent type, move it to the battlefield via\n424\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n425\t       registration and the ETB event).\n426\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n427\t    \"\"\"\n428\t    from engine.zones import move_to_zone\n429\t\n430\t    # Read targets from the StackObject — the single source of truth.\n431\t    # Set chosen_targets on the card just before resolution so that\n432\t    # _get_chosen_target helpers (which read via getattr) work.\n433\t    targets = stack_obj.targets\n434\t    if targets is not None:\n435\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n436\t\n437\t    card.on_resolve(game)\n438\t\n439\t    if card.card_types & _PERMANENT_TYPES:\n440\t        # Move from stack to battlefield via move_to_zone, which handles\n441\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n442\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n443\t    else:\n444\t        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n445\t        # A spell cast under an \"if it would be put into your graveyard,\n446\t        # exile it instead\" effect (e.g. The Dawning Archaic) is redirected.\n447\t        dest = (\n448\t            Zone.EXILE\n449\t            if getattr(card, \"_exile_instead_of_graveyard\", False)\n450\t            else Zone.GRAVEYARD\n451\t        )\n452\t        move_to_zone(game, card, Zone.STACK, dest)\n453\t\n454\t\n455\t# ------------------------------------------------------------------\n456\t# Play land (special action — does not use the stack)\n457\t# ------------------------------------------------------------------\n458\t\n459\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n460\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n461\t\n462\t    Requirements (all must hold):\n463\t\n464\t    * *land_card* has :attr:`CardType.LAND`.\n465\t    * *player* is the active player.\n466\t    * Current phase is a main phase.\n467\t    * The stack is empty.\n468\t    * ``player.land_plays_remaining > 0``.\n469\t    * The card is in the player's hand.\n470\t\n471\t    On success the card moves from hand to battlefield and\n472\t    ``land_plays_remaining`` is decremented.\n473\t\n474\t    Raises:\n475\t        CastingError: If any requirement is not met.\n476\t    \"\"\"\n477\t    # Must be a land\n478\t    if CardType.LAND not in land_card.card_types:\n479\t        raise CastingError(\n480\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n481\t        )\n482\t\n483\t    # Sorcery-speed timing (active player, main phase, stack empty)\n484\t    if not is_sorcery_speed(game, player):\n485\t        raise CastingError(\n486\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n487\t            \"during main phase with empty stack\"\n488\t        )\n489\t\n490\t    # Land plays remaining\n491\t    if player.land_plays_remaining <= 0:\n492\t        raise CastingError(\n493\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n494\t        )\n495\t\n496\t    # Card must be in hand\n497\t    hand = game.get_hand(player)\n498\t    if not hand.contains(land_card):\n499\t        raise CastingError(\n500\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n501\t        )\n502\t\n503\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n504\t    if land_card.owner is None:\n505\t        land_card.owner = player\n506\t    land_card.controller = player\n507\t\n508\t    # Move from hand to battlefield via move_to_zone, which fires\n509\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n510\t    from engine.zones import move_to_zone\n511\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n512\t\n513\t    # Decrement land plays\n514\t    player.land_plays_remaining -= 1\n515\t\n516\t\n517\tdef resolve_top(game: GameState) -> None:\n518\t    \"\"\"Resolve the top spell/ability on the stack.\n519\t\n520\t    Pops the top item from the stack, calls its on_resolve callback,\n521\t    then runs state-based actions.  If the stack is empty this is a no-op.\n522\t    \"\"\"\n523\t    if game.stack.is_empty():\n524\t        return\n525\t    from engine.state_based_actions import resolve_state_based_actions\n526\t\n527\t    obj = game.stack.pop()\n528\t    obj.on_resolve(game)\n529\t    resolve_state_based_actions(game)\n530\t"}]},"parent_tool_use_id":"toolu_01X6Ryuijvq29Av9gGTdruzn","session_id":"b76fbb6d-7052-44e0-893e-8a2c1cc9d4a6","uuid":"a515644c-4ca6-4e7e-8c00-9f618d829fa2","timestamp":"2026-05-30T04:54:34.613Z","subagent_type":"Explore","task_description":"Research token creation and ETB triggers"}
