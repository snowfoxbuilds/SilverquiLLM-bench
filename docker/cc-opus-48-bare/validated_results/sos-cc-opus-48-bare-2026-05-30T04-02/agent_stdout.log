{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ThUCWkZ3qYHuPNTo4sWQyg","type":"tool_result","content":"1\t\"\"\"Card base classes, CardImpl interface, and supporting dataclasses.\n2\t\n3\tProvides the core class hierarchy for all Magic: The Gathering card types:\n4\t\n5\t- ``GameObject`` — base for anything that can exist in zones.\n6\t- ``CardImpl(GameObject)`` — abstract card implementation with hooks for\n7\t  casting, resolution, targeting, triggers, and abilities.\n8\t- Concrete subclasses: ``Creature``, ``Instant``, ``Sorcery``,\n9\t  ``Enchantment``, ``Aura``, ``Artifact``, ``ArtifactCreature``,\n10\t  ``Planeswalker``, ``Land``.\n11\t- Supporting dataclasses: ``ActivatedAbility``, ``LoyaltyAbility``,\n12\t  ``ManaAbility``, ``ContinuousEffect``, ``Mode``.\n13\t\"\"\"\n14\t\n15\tfrom __future__ import annotations\n16\t\n17\tfrom dataclasses import dataclass\n18\tfrom typing import TYPE_CHECKING, Any, Callable\n19\t\n20\tfrom engine.types import CardType, Keyword, ManaCost, Supertype\n21\t\n22\tif TYPE_CHECKING:\n23\t    from engine.game_state import GameState\n24\t    from engine.player import Player\n25\t\n26\t\n27\t# ---------------------------------------------------------------------------\n28\t# Supporting dataclasses\n29\t# ---------------------------------------------------------------------------\n30\t\n31\t@dataclass\n32\tclass Mode:\n33\t    \"\"\"Represents a single mode of a modal spell or ability.\n34\t\n35\t    Attributes:\n36\t        name: Short label for this mode (e.g. ``\"Destroy target creature\"``).\n37\t        description: Detailed rules text for the mode.\n38\t    \"\"\"\n39\t\n40\t    name: str = \"\"\n41\t    description: str = \"\"\n42\t\n43\t\n44\t@dataclass\n45\tclass ActivatedAbility:\n46\t    \"\"\"An activated ability on a permanent.\n47\t\n48\t    Attributes:\n49\t        cost: A callable that checks/pays the cost given the game state.\n50\t        effect: A callable that applies the effect given the game state.\n51\t        description: Human-readable description of the ability.\n52\t    \"\"\"\n53\t\n54\t    cost: Callable[..., Any]\n55\t    effect: Callable[..., Any]\n56\t    description: str = \"\"\n57\t\n58\t\n59\t@dataclass\n60\tclass LoyaltyAbility:\n61\t    \"\"\"A planeswalker loyalty ability.\n62\t\n63\t    Attributes:\n64\t        loyalty_cost: The loyalty cost (positive for ``+``, negative for ``−``).\n65\t        effect: A callable that applies the ability's effect.\n66\t        description: Human-readable description.\n67\t    \"\"\"\n68\t\n69\t    loyalty_cost: int\n70\t    effect: Callable[..., Any]\n71\t    description: str = \"\"\n72\t\n73\t\n74\t@dataclass\n75\tclass ManaAbility:\n76\t    \"\"\"A mana ability (does not use the stack).\n77\t\n78\t    Attributes:\n79\t        cost: A callable that checks/pays the cost.\n80\t        mana_produced: A callable that returns the mana added.\n81\t        description: Human-readable description.\n82\t    \"\"\"\n83\t\n84\t    cost: Callable[..., Any]\n85\t    mana_produced: Callable[..., Any]\n86\t    description: str = \"\"\n87\t\n88\t\n89\t@dataclass\n90\tclass ContinuousEffect:\n91\t    \"\"\"A continuous effect applied by an enchantment or other source.\n92\t\n93\t    Attributes:\n94\t        apply: A callable that applies the effect to the game state.\n95\t        remove: A callable that removes the effect from the game state.\n96\t        description: Human-readable description.\n97\t    \"\"\"\n98\t\n99\t    apply: Callable[..., Any]\n100\t    remove: Callable[..., Any]\n101\t    description: str = \"\"\n102\t\n103\t\n104\t# ---------------------------------------------------------------------------\n105\t# GameObject — base class for zone-resident objects\n106\t# ---------------------------------------------------------------------------\n107\t\n108\tclass GameObject:\n109\t    \"\"\"Base class for anything that can exist in a zone.\n110\t\n111\t    Each instance receives a unique ``object_id`` via a class-level\n112\t    auto-incrementing counter.\n113\t\n114\t    Attributes:\n115\t        object_id: Unique integer identifier (auto-assigned).\n116\t        owner: The player who owns this object.\n117\t        controller: The player who currently controls this object.\n118\t    \"\"\"\n119\t\n120\t    _next_id: int = 1\n121\t\n122\t    def __init__(self, owner: Player | None = None, controller: Player | None = None) -> None:\n123\t        self.object_id: int = GameObject._next_id\n124\t        GameObject._next_id += 1\n125\t        self.owner: Player | None = owner\n126\t        self.controller: Player | None = controller if controller is not None else owner\n127\t\n128\t    @classmethod\n129\t    def reset_id_counter(cls) -> None:\n130\t        \"\"\"Reset the auto-incrementing counter (useful in tests).\"\"\"\n131\t        cls._next_id = 1\n132\t\n133\t\n134\t# ---------------------------------------------------------------------------\n135\t# CardImpl — abstract card implementation\n136\t# ---------------------------------------------------------------------------\n137\t\n138\tclass CardImpl(GameObject):\n139\t    \"\"\"Abstract base for all card implementations.\n140\t\n141\t    Subclasses should override the ``can_cast``, ``on_cast``, ``on_resolve``,\n142\t    and other hook methods to implement card-specific behaviour.\n143\t\n144\t    Attributes:\n145\t        name: Card name.\n146\t        mana_cost: The card's mana cost.\n147\t        card_types: Set of :class:`~engine.types.CardType` values.\n148\t        subtypes: Set of subtype strings (e.g. ``{\"Elf\", \"Warrior\"}``).\n149\t        supertypes: Set of :class:`~engine.types.Supertype` values.\n150\t        keywords: Combination of :class:`~engine.types.Keyword` flags.\n151\t        rules_text: The card's rules text string.\n152\t    \"\"\"\n153\t\n154\t    def __init__(\n155\t        self,\n156\t        name: str = \"\",\n157\t        mana_cost: ManaCost | None = None,\n158\t        card_types: set[CardType] | None = None,\n159\t        subtypes: set[str] | None = None,\n160\t        supertypes: set[Supertype] | None = None,\n161\t        keywords: Keyword | None = None,\n162\t        rules_text: str = \"\",\n163\t        owner: Player | None = None,\n164\t        controller: Player | None = None,\n165\t    ) -> None:\n166\t        super().__init__(owner=owner, controller=controller)\n167\t        self.name: str = name\n168\t        self.mana_cost: ManaCost = mana_cost if mana_cost is not None else ManaCost()\n169\t        self.card_types: set[CardType] = card_types if card_types is not None else set()\n170\t        self.subtypes: set[str] = subtypes if subtypes is not None else set()\n171\t        self.supertypes: set[Supertype] = supertypes if supertypes is not None else set()\n172\t        self.keywords: Keyword = keywords if keywords is not None else Keyword(0)\n173\t        self.rules_text: str = rules_text\n174\t        # Snapshot original characteristics for continuous-effect reset.\n175\t        self._original_card_types: frozenset[CardType] = frozenset(self.card_types)\n176\t        self._original_keywords: Keyword = self.keywords\n177\t\n178\t    # ------------------------------------------------------------------\n179\t    # Continuous-effect reset support\n180\t    # ------------------------------------------------------------------\n181\t\n182\t    def _reset_characteristics(self) -> None:\n183\t        \"\"\"Reset mutable characteristics to their original (pre-effect) values.\n184\t\n185\t        Called by :meth:`EffectManager.apply_all` before reapplying effects\n186\t        so that the recalculation is idempotent.\n187\t        \"\"\"\n188\t        self.card_types = set(self._original_card_types)\n189\t        self.keywords = self._original_keywords\n190\t\n191\t    # ------------------------------------------------------------------\n192\t    # Hook methods — override in subclasses / card definitions\n193\t    # ------------------------------------------------------------------\n194\t\n195\t    def can_cast(self, game: GameState) -> bool:\n196\t        \"\"\"Return ``True`` if this card can currently be cast.\"\"\"\n197\t        return True\n198\t\n199\t    def cost_reduction(self, game: GameState) -> int:\n200\t        \"\"\"Return the generic mana reduction for casting this card.\n201\t\n202\t        Override in subclasses to implement cost-reduction mechanics\n203\t        (e.g. Embercleave costs {1} less for each attacking creature).\n204\t        The returned value is clamped so that generic mana cannot go below 0.\n205\t        Only reduces generic mana — colored costs are never reduced.\n206\t\n207\t        Returns:\n208\t            Non-negative integer representing generic mana to subtract.\n209\t        \"\"\"\n210\t        return 0\n211\t\n212\t    def spell_cost_reduction(\n213\t        self, game: GameState, card: \"CardImpl\", controller: Player\n214\t    ) -> int:\n215\t        \"\"\"Extra generic reduction this permanent grants to another spell.\n216\t\n217\t        Consulted (while this card is on the battlefield) for every spell\n218\t        being cast, enabling effects like \"instant and sorcery spells you\n219\t        cast have affinity for creatures\".  ``card`` is the spell being\n220\t        cast and ``controller`` is the player casting it.  Defaults to 0.\n221\t        \"\"\"\n222\t        return 0\n223\t\n224\t    def on_cast(self, game: GameState) -> None:\n225\t        \"\"\"Called when the card is cast (before it goes on the stack).\"\"\"\n226\t\n227\t    def on_resolve(self, game: GameState) -> None:\n228\t        \"\"\"Called when the spell resolves from the stack.\n229\t\n230\t        Targets are available via ``self.chosen_targets`` — set at\n231\t        resolve-time by :func:`~engine.casting._resolve_spell` from\n232\t        :attr:`StackObject.targets`, or directly by test code.\n233\t        \"\"\"\n234\t\n235\t    def get_targets(self, game: GameState) -> list[Any]:\n236\t        \"\"\"Return a list of legal targets for this card.\"\"\"\n237\t        return []\n238\t\n239\t    def register_triggers(self, game: GameState) -> None:\n240\t        \"\"\"Register any triggered abilities this card provides.\"\"\"\n241\t\n242\t    def register_replacement_effects(self, game: GameState) -> None:\n243\t        \"\"\"Register any replacement effects this card provides.\"\"\"\n244\t\n245\t    def get_activated_abilities(self) -> list[ActivatedAbility]:\n246\t        \"\"\"Return activated abilities this card provides.\"\"\"\n247\t        return []\n248\t\n249\t    def get_modes(self) -> list[Mode]:\n250\t        \"\"\"Return available modes for modal spells/abilities.\n251\t\n252\t        Non-modal cards return an empty list by default.\n253\t        \"\"\"\n254\t        return []\n255\t\n256\t\n257\t# ---------------------------------------------------------------------------\n258\t# Creature\n259\t# ---------------------------------------------------------------------------\n260\t\n261\tclass Creature(CardImpl):\n262\t    \"\"\"A creature card.\n263\t\n264\t    Attributes:\n265\t        base_power: The printed power value (rule 208.1). Immutable after init.\n266\t        base_toughness: The printed toughness value. Immutable after init.\n267\t        modified_power: Current power after continuous effects (Layer 7c), before counters.\n268\t            Reset to ``base_power`` each effect cycle; continuous effects write here.\n269\t        modified_toughness: Current toughness after continuous effects, before counters.\n270\t        damage_marked: Amount of damage currently marked on this creature.\n271\t        is_tapped: Whether the creature is tapped.\n272\t        summoning_sick: Whether the creature has summoning sickness.\n273\t        is_attacking: Combat flag — currently declared as an attacker.\n274\t        is_blocking: Combat flag — currently declared as a blocker.\n275\t        plus_one_counters: Number of +1/+1 counters.\n276\t        minus_one_counters: Number of -1/-1 counters.\n277\t        is_token: Whether this object is a token (for SBA checks).\n278\t    \"\"\"\n279\t\n280\t    def __init__(\n281\t        self,\n282\t        name: str = \"\",\n283\t        mana_cost: ManaCost | None = None,\n284\t        card_types: set[CardType] | None = None,\n285\t        subtypes: set[str] | None = None,\n286\t        supertypes: set[Supertype] | None = None,\n287\t        keywords: Keyword | None = None,\n288\t        rules_text: str = \"\",\n289\t        owner: Player | None = None,\n290\t        controller: Player | None = None,\n291\t        base_power: int = 0,\n292\t        base_toughness: int = 0,\n293\t    ) -> None:\n294\t        # Always include CREATURE in card_types.\n295\t        card_types = (card_types or set()) | {CardType.CREATURE}\n296\t        super().__init__(\n297\t            name=name,\n298\t            mana_cost=mana_cost,\n299\t            card_types=card_types,\n300\t            subtypes=subtypes,\n301\t            supertypes=supertypes,\n302\t            keywords=keywords,\n303\t            rules_text=rules_text,\n304\t            owner=owner,\n305\t            controller=controller,\n306\t        )\n307\t        self.base_power: int = base_power\n308\t        self.base_toughness: int = base_toughness\n309\t        self.modified_power: int = base_power\n310\t        self.modified_toughness: int = base_toughness\n311\t        self.damage_marked: int = 0\n312\t        self.is_tapped: bool = False\n313\t        self.summoning_sick: bool = True\n314\t        self.is_attacking: bool = False\n315\t        self.is_blocking: bool = False\n316\t        self.plus_one_counters: int = 0\n317\t        self.minus_one_counters: int = 0\n318\t        self.is_token: bool = False\n319\t        self.dealt_deathtouch_damage: bool = False\n320\t        self._base_plus_one_counters: int = 0\n321\t        self._base_minus_one_counters: int = 0\n322\t\n323\t    def _reset_characteristics(self) -> None:\n324\t        \"\"\"Reset creature characteristics to pre-effect values.\"\"\"\n325\t        super()._reset_characteristics()\n326\t        self.modified_power = self.base_power\n327\t        self.modified_toughness = self.base_toughness\n328\t        self.plus_one_counters = self._base_plus_one_counters\n329\t        self.minus_one_counters = self._base_minus_one_counters\n330\t        # Reset combat-restriction flags set by continuous effects (e.g. Pacifism).\n331\t        # These are reapplied by active effects during apply_all().\n332\t        self._cant_attack: bool = False\n333\t        self._cant_block: bool = False\n334\t        self._cant_be_blocked: bool = False\n335\t        self._cant_activate: bool = False\n336\t        self._max_attackers_blocked: int = 1\n337\t        # Clear granted protections so they are reapplied by active effects.\n338\t        if hasattr(self, \"protections\"):\n339\t            self.protections = []\n340\t\n341\t    @property\n342\t    def counters(self) -> dict[str, int]:\n343\t        \"\"\"Return a dict-like view of counters on this creature.\"\"\"\n344\t        result: dict[str, int] = {}\n345\t        if self.plus_one_counters > 0:\n346\t            result[\"+1/+1\"] = self.plus_one_counters\n347\t        if self.minus_one_counters > 0:\n348\t            result[\"-1/-1\"] = self.minus_one_counters\n349\t        return result\n350\t\n351\t    @property\n352\t    def power(self) -> int:\n353\t        \"\"\"Current power including counter modifications.\"\"\"\n354\t        return self.modified_power + self.plus_one_counters - self.minus_one_counters\n355\t\n356\t    @property\n357\t    def toughness(self) -> int:\n358\t        \"\"\"Current toughness including counter modifications.\"\"\"\n359\t        return self.modified_toughness + self.plus_one_counters - self.minus_one_counters\n360\t\n361\t\n362\t# ---------------------------------------------------------------------------\n363\t# Instant / Sorcery\n364\t# ---------------------------------------------------------------------------\n365\t\n366\tclass Instant(CardImpl):\n367\t    \"\"\"An instant spell — no extra fields beyond CardImpl.\"\"\"\n368\t\n369\t    def __init__(self, **kwargs: Any) -> None:\n370\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.INSTANT}\n371\t        super().__init__(**kwargs)\n372\t\n373\t\n374\tclass Sorcery(CardImpl):\n375\t    \"\"\"A sorcery spell — no extra fields beyond CardImpl.\"\"\"\n376\t\n377\t    def __init__(self, **kwargs: Any) -> None:\n378\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.SORCERY}\n379\t        super().__init__(**kwargs)\n380\t\n381\t\n382\t# ---------------------------------------------------------------------------\n383\t# Enchantment\n384\t# ---------------------------------------------------------------------------\n385\t\n386\tclass Enchantment(CardImpl):\n387\t    \"\"\"An enchantment card.\n388\t\n389\t    For auras, use the :class:`Aura` subclass which sets ``is_aura = True``.\n390\t    The base ``Enchantment`` class retains the ``attached_to`` attribute for\n391\t    backwards compatibility but marks ``is_aura = False`` so that state-based\n392\t    actions do not treat a non-aura enchantment as an unattached aura.\n393\t\n394\t    Attributes:\n395\t        attached_to: The object this enchantment is attached to (``None``\n396\t            if not an aura or not yet attached).\n397\t        is_aura: ``False`` for regular enchantments; ``True`` for auras.\n398\t    \"\"\"\n399\t\n400\t    is_aura: bool = False\n401\t\n402\t    def __init__(self, attached_to: Any | None = None, **kwargs: Any) -> None:\n403\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ENCHANTMENT}\n404\t        super().__init__(**kwargs)\n405\t        self.attached_to: Any | None = attached_to\n406\t\n407\t    def apply_continuous_effect(self, game: GameState) -> None:\n408\t        \"\"\"Apply the enchantment's continuous effect to the game.\"\"\"\n409\t\n410\t    def on_enchant(self, game: GameState) -> None:\n411\t        \"\"\"Called when this enchantment becomes attached to an object.\"\"\"\n412\t\n413\t    def on_detach(self, game: GameState) -> None:\n414\t        \"\"\"Called when this enchantment is detached from its object.\"\"\"\n415\t\n416\t\n417\tclass Aura(Enchantment):\n418\t    \"\"\"An Aura enchantment — attaches to a permanent on the battlefield.\n419\t\n420\t    Sets ``is_aura = True`` so that state-based actions correctly identify\n421\t    this as an aura (and move it to the graveyard when unattached).\n422\t\n423\t    Attributes:\n424\t        is_aura: Always ``True`` for auras.\n425\t    \"\"\"\n426\t\n427\t    is_aura: bool = True\n428\t\n429\t    def __init__(self, attached_to: Any | None = None, **kwargs: Any) -> None:\n430\t        super().__init__(attached_to=attached_to, **kwargs)\n431\t\n432\t\n433\t# ---------------------------------------------------------------------------\n434\t# Artifact / ArtifactCreature\n435\t# ---------------------------------------------------------------------------\n436\t\n437\tclass Artifact(CardImpl):\n438\t    \"\"\"An artifact card.\n439\t\n440\t    Attributes:\n441\t        is_tapped: Whether the artifact is currently tapped.\n442\t    \"\"\"\n443\t\n444\t    def __init__(self, **kwargs: Any) -> None:\n445\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ARTIFACT}\n446\t        super().__init__(**kwargs)\n447\t        self.is_tapped: bool = False\n448\t\n449\t\n450\tclass ArtifactCreature(Creature):\n451\t    \"\"\"An artifact creature — combines Artifact and Creature types.\n452\t\n453\t    Inherits creature combat stats and behaviour from :class:`Creature`.\n454\t    \"\"\"\n455\t\n456\t    def __init__(self, **kwargs: Any) -> None:\n457\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ARTIFACT, CardType.CREATURE}\n458\t        super().__init__(**kwargs)\n459\t\n460\t\n461\t# ---------------------------------------------------------------------------\n462\t# Planeswalker\n463\t# ---------------------------------------------------------------------------\n464\t\n465\tclass Planeswalker(CardImpl):\n466\t    \"\"\"A planeswalker card.\n467\t\n468\t    Attributes:\n469\t        starting_loyalty: The starting loyalty printed on the card.\n470\t        loyalty: Current loyalty counter value.\n471\t    \"\"\"\n472\t\n473\t    def __init__(\n474\t        self,\n475\t        starting_loyalty: int = 0,\n476\t        **kwargs: Any,\n477\t    ) -> None:\n478\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.PLANESWALKER}\n479\t        super().__init__(**kwargs)\n480\t        self.starting_loyalty: int = starting_loyalty\n481\t        self.loyalty: int = starting_loyalty\n482\t\n483\t    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n484\t        \"\"\"Return the planeswalker's loyalty abilities.\"\"\"\n485\t        return []\n486\t\n487\t\n488\t# ---------------------------------------------------------------------------\n489\t# Land\n490\t# ---------------------------------------------------------------------------\n491\t\n492\tclass Land(CardImpl):\n493\t    \"\"\"A land card.\n494\t\n495\t    Lands are not cast — they are played via a special action. ``can_cast``\n496\t    always returns ``False``.\n497\t\n498\t    Attributes:\n499\t        is_tapped: Whether the land is currently tapped.\n500\t    \"\"\"\n501\t\n502\t    def __init__(self, **kwargs: Any) -> None:\n503\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.LAND}\n504\t        super().__init__(**kwargs)\n505\t        self.is_tapped: bool = False\n506\t\n507\t    def can_cast(self, game: GameState) -> bool:\n508\t        \"\"\"Lands cannot be cast; they are played as a special action.\"\"\"\n509\t        return False\n510\t\n511\t    def get_mana_abilities(self) -> list[ManaAbility]:\n512\t        \"\"\"Return the land's mana abilities.\"\"\"\n513\t        return []\n514\t"}]},"parent_tool_use_id":null,"session_id":"b76fbb6d-7052-44e0-893e-8a2c1cc9d4a6","uuid":"49c4300b-4826-4ed5-9522-b1cd71b296f8","timestamp":"2026-05-30T05:00:03.248Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/card.py","content":"\"\"\"Card base classes, CardImpl interface, and supporting dataclasses.\n\nProvides the core class hierarchy for all Magic: The Gathering card types:\n\n- ``GameObject`` — base for anything that can exist in zones.\n- ``CardImpl(GameObject)`` — abstract card implementation with hooks for\n  casting, resolution, targeting, triggers, and abilities.\n- Concrete subclasses: ``Creature``, ``Instant``, ``Sorcery``,\n  ``Enchantment``, ``Aura``, ``Artifact``, ``ArtifactCreature``,\n  ``Planeswalker``, ``Land``.\n- Supporting dataclasses: ``ActivatedAbility``, ``LoyaltyAbility``,\n  ``ManaAbility``, ``ContinuousEffect``, ``Mode``.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom typing import TYPE_CHECKING, Any, Callable\n\nfrom engine.types import CardType, Keyword, ManaCost, Supertype\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n# ---------------------------------------------------------------------------\n# Supporting dataclasses\n# ---------------------------------------------------------------------------\n\n@dataclass\nclass Mode:\n    \"\"\"Represents a single mode of a modal spell or ability.\n\n    Attributes:\n        name: Short label for this mode (e.g. ``\"Destroy target creature\"``).\n        description: Detailed rules text for the mode.\n    \"\"\"\n\n    name: str = \"\"\n    description: str = \"\"\n\n\n@dataclass\nclass ActivatedAbility:\n    \"\"\"An activated ability on a permanent.\n\n    Attributes:\n        cost: A callable that checks/pays the cost given the game state.\n        effect: A callable that applies the effect given the game state.\n        description: Human-readable description of the ability.\n    \"\"\"\n\n    cost: Callable[..., Any]\n    effect: Callable[..., Any]\n    description: str = \"\"\n\n\n@dataclass\nclass LoyaltyAbility:\n    \"\"\"A planeswalker loyalty ability.\n\n    Attributes:\n        loyalty_cost: The loyalty cost (positive for ``+``, negative for ``−``).\n        effect: A callable that applies the ability's effect.\n        description: Human-readable description.\n    \"\"\"\n\n    loyalty_cost: int\n    effect: Callable[..., Any]\n    description: str = \"\"\n\n\n@dataclass\nclass ManaAbility:\n    \"\"\"A mana ability (does not use the stack).\n\n    Attributes:\n        cost: A callable that checks/pays the cost.\n        mana_produced: A callable that returns the mana added.\n        description: Human-readable description.\n    \"\"\"\n\n    cost: Callable[..., Any]\n    mana_produced: Callable[..., Any]\n    description: str = \"\"\n\n\n@dataclass\nclass ContinuousEffect:\n    \"\"\"A continuous effect applied by an enchantment or other source.\n\n    Attributes:\n        apply: A callable that applies the effect to the game state.\n        remove: A callable that removes the effect from the game state.\n        description: Human-readable description.\n    \"\"\"\n\n    apply: Callable[..., Any]\n    remove: Callable[..., Any]\n    description: str = \"\"\n\n\n# ---------------------------------------------------------------------------\n# GameObject — base class for zone-resident objects\n# ---------------------------------------------------------------------------\n\nclass GameObject:\n    \"\"\"Base class for anything that can exist in a zone.\n\n    Each instance receives a unique ``object_id`` via a class-level\n    auto-incrementing counter.\n\n    Attributes:\n        object_id: Unique integer identifier (auto-assigned).\n        owner: The player who owns this object.\n        controller: The player who currently controls this object.\n    \"\"\"\n\n    _next_id: int = 1\n\n    def __init__(self, owner: Player | None = None, controller: Player | None = None) -> None:\n        self.object_id: int = GameObject._next_id\n        GameObject._next_id += 1\n        self.owner: Player | None = owner\n        self.controller: Player | None = controller if controller is not None else owner\n\n    @classmethod\n    def reset_id_counter(cls) -> None:\n        \"\"\"Reset the auto-incrementing counter (useful in tests).\"\"\"\n        cls._next_id = 1\n\n\n# ---------------------------------------------------------------------------\n# CardImpl — abstract card implementation\n# ---------------------------------------------------------------------------\n\nclass CardImpl(GameObject):\n    \"\"\"Abstract base for all card implementations.\n\n    Subclasses should override the ``can_cast``, ``on_cast``, ``on_resolve``,\n    and other hook methods to implement card-specific behaviour.\n\n    Attributes:\n        name: Card name.\n        mana_cost: The card's mana cost.\n        card_types: Set of :class:`~engine.types.CardType` values.\n        subtypes: Set of subtype strings (e.g. ``{\"Elf\", \"Warrior\"}``).\n        supertypes: Set of :class:`~engine.types.Supertype` values.\n        keywords: Combination of :class:`~engine.types.Keyword` flags.\n        rules_text: The card's rules text string.\n    \"\"\"\n\n    def __init__(\n        self,\n        name: str = \"\",\n        mana_cost: ManaCost | None = None,\n        card_types: set[CardType] | None = None,\n        subtypes: set[str] | None = None,\n        supertypes: set[Supertype] | None = None,\n        keywords: Keyword | None = None,\n        rules_text: str = \"\",\n        owner: Player | None = None,\n        controller: Player | None = None,\n    ) -> None:\n        super().__init__(owner=owner, controller=controller)\n        self.name: str = name\n        self.mana_cost: ManaCost = mana_cost if mana_cost is not None else ManaCost()\n        self.card_types: set[CardType] = card_types if card_types is not None else set()\n        self.subtypes: set[str] = subtypes if subtypes is not None else set()\n        self.supertypes: set[Supertype] = supertypes if supertypes is not None else set()\n        self.keywords: Keyword = keywords if keywords is not None else Keyword(0)\n        self.rules_text: str = rules_text\n        # Snapshot original characteristics for continuous-effect reset.\n        self._original_card_types: frozenset[CardType] = frozenset(self.card_types)\n        self._original_keywords: Keyword = self.keywords\n\n    # ------------------------------------------------------------------\n    # Continuous-effect reset support\n    # ------------------------------------------------------------------\n\n    def _reset_characteristics(self) -> None:\n        \"\"\"Reset mutable characteristics to their original (pre-effect) values.\n\n        Called by :meth:`EffectManager.apply_all` before reapplying effects\n        so that the recalculation is idempotent.\n        \"\"\"\n        self.card_types = set(self._original_card_types)\n        self.keywords = self._original_keywords\n\n    # ------------------------------------------------------------------\n    # Hook methods — override in subclasses / card definitions\n    # ------------------------------------------------------------------\n\n    def can_cast(self, game: GameState) -> bool:\n        \"\"\"Return ``True`` if this card can currently be cast.\"\"\"\n        return True\n\n    def cost_reduction(self, game: GameState) -> int:\n        \"\"\"Return the generic mana reduction for casting this card.\n\n        Override in subclasses to implement cost-reduction mechanics\n        (e.g. Embercleave costs {1} less for each attacking creature).\n        The returned value is clamped so that generic mana cannot go below 0.\n        Only reduces generic mana — colored costs are never reduced.\n\n        Returns:\n            Non-negative integer representing generic mana to subtract.\n        \"\"\"\n        return 0\n\n    def spell_cost_reduction(\n        self, game: GameState, card: \"CardImpl\", controller: Player\n    ) -> int:\n        \"\"\"Extra generic reduction this permanent grants to another spell.\n\n        Consulted (while this card is on the battlefield) for every spell\n        being cast, enabling effects like \"instant and sorcery spells you\n        cast have affinity for creatures\".  ``card`` is the spell being\n        cast and ``controller`` is the player casting it.  Defaults to 0.\n        \"\"\"\n        return 0\n\n    def on_cast(self, game: GameState) -> None:\n        \"\"\"Called when the card is cast (before it goes on the stack).\"\"\"\n\n    def on_resolve(self, game: GameState) -> None:\n        \"\"\"Called when the spell resolves from the stack.\n\n        Targets are available via ``self.chosen_targets`` — set at\n        resolve-time by :func:`~engine.casting._resolve_spell` from\n        :attr:`StackObject.targets`, or directly by test code.\n        \"\"\"\n\n    def get_targets(self, game: GameState) -> list[Any]:\n        \"\"\"Return a list of legal targets for this card.\"\"\"\n        return []\n\n    def register_triggers(self, game: GameState) -> None:\n        \"\"\"Register any triggered abilities this card provides.\"\"\"\n\n    def register_replacement_effects(self, game: GameState) -> None:\n        \"\"\"Register any replacement effects this card provides.\"\"\"\n\n    def get_activated_abilities(self) -> list[ActivatedAbility]:\n        \"\"\"Return activated abilities this card provides.\"\"\"\n        return []\n\n    def get_modes(self) -> list[Mode]:\n        \"\"\"Return available modes for modal spells/abilities.\n\n        Non-modal cards return an empty list by default.\n        \"\"\"\n        return []\n\n\n# ---------------------------------------------------------------------------\n# Creature\n# ---------------------------------------------------------------------------\n\nclass Creature(CardImpl):\n    \"\"\"A creature card.\n\n    Attributes:\n        base_power: The printed power value (rule 208.1). Immutable after init.\n        base_toughness: The printed toughness value. Immutable after init.\n        modified_power: Current power after continuous effects (Layer 7c), before counters.\n            Reset to ``base_power`` each effect cycle; continuous effects write here.\n        modified_toughness: Current toughness after continuous effects, before counters.\n        damage_marked: Amount of damage currently marked on this creature.\n        is_tapped: Whether the creature is tapped.\n        summoning_sick: Whether the creature has summoning sickness.\n        is_attacking: Combat flag — currently declared as an attacker.\n        is_blocking: Combat flag — currently declared as a blocker.\n        plus_one_counters: Number of +1/+1 counters.\n        minus_one_counters: Number of -1/-1 counters.\n        is_token: Whether this object is a token (for SBA checks).\n    \"\"\"\n\n    def __init__(\n        self,\n        name: str = \"\",\n        mana_cost: ManaCost | None = None,\n        card_types: set[CardType] | None = None,\n        subtypes: set[str] | None = None,\n        supertypes: set[Supertype] | None = None,\n        keywords: Keyword | None = None,\n        rules_text: str = \"\",\n        owner: Player | None = None,\n        controller: Player | None = None,\n        base_power: int = 0,\n        base_toughness: int = 0,\n    ) -> None:\n        # Always include CREATURE in card_types.\n        card_types = (card_types or set()) | {CardType.CREATURE}\n        super().__init__(\n            name=name,\n            mana_cost=mana_cost,\n            card_types=card_types,\n            subtypes=subtypes,\n            supertypes=supertypes,\n            keywords=keywords,\n            rules_text=rules_text,\n            owner=owner,\n            controller=controller,\n        )\n        self.base_power: int = base_power\n        self.base_toughness: int = base_toughness\n        self.modified_power: int = base_power\n        self.modified_toughness: int = base_toughness\n        self.damage_marked: int = 0\n        self.is_tapped: bool = False\n        self.summoning_sick: bool = True\n        self.is_attacking: bool = False\n        self.is_blocking: bool = False\n        self.plus_one_counters: int = 0\n        self.minus_one_counters: int = 0\n        self.is_token: bool = False\n        self.dealt_deathtouch_damage: bool = False\n        self._base_plus_one_counters: int = 0\n        self._base_minus_one_counters: int = 0\n\n    def _reset_characteristics(self) -> None:\n        \"\"\"Reset creature characteristics to pre-effect values.\"\"\"\n        super()._reset_characteristics()\n        self.modified_power = self.base_power\n        self.modified_toughness = self.base_toughness\n        self.plus_one_counters = self._base_plus_one_counters\n        self.minus_one_counters = self._base_minus_one_counters\n        # Reset combat-restriction flags set by continuous effects (e.g. Pacifism).\n        # These are reapplied by active effects during apply_all().\n        self._cant_attack: bool = False\n        self._cant_block: bool = False\n        self._cant_be_blocked: bool = False\n        self._cant_activate: bool = False\n        self._max_attackers_blocked: int = 1\n        # Clear granted protections so they are reapplied by active effects.\n        if hasattr(self, \"protections\"):\n            self.protections = []\n\n    @property\n    def counters(self) -> dict[str, int]:\n        \"\"\"Return a dict-like view of counters on this creature.\"\"\"\n        result: dict[str, int] = {}\n        if self.plus_one_counters > 0:\n            result[\"+1/+1\"] = self.plus_one_counters\n        if self.minus_one_counters > 0:\n            result[\"-1/-1\"] = self.minus_one_counters\n        return result\n\n    @property\n    def power(self) -> int:\n        \"\"\"Current power including counter modifications.\"\"\"\n        return self.modified_power + self.plus_one_counters - self.minus_one_counters\n\n    @property\n    def toughness(self) -> int:\n        \"\"\"Current toughness including counter modifications.\"\"\"\n        return self.modified_toughness + self.plus_one_counters - self.minus_one_counters\n\n\n# ---------------------------------------------------------------------------\n# Instant / Sorcery\n# ---------------------------------------------------------------------------\n\nclass Instant(CardImpl):\n    \"\"\"An instant spell — no extra fields beyond CardImpl.\"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.INSTANT}\n        super().__init__(**kwargs)\n\n\nclass Sorcery(CardImpl):\n    \"\"\"A sorcery spell — no extra fields beyond CardImpl.\"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.SORCERY}\n        super().__init__(**kwargs)\n\n\n# ---------------------------------------------------------------------------\n# Enchantment\n# ---------------------------------------------------------------------------\n\nclass Enchantment(CardImpl):\n    \"\"\"An enchantment card.\n\n    For auras, use the :class:`Aura` subclass which sets ``is_aura = True``.\n    The base ``Enchantment`` class retains the ``attached_to`` attribute for\n    backwards compatibility but marks ``is_aura = False`` so that state-based\n    actions do not treat a non-aura enchantment as an unattached aura.\n\n    Attributes:\n        attached_to: The object this enchantment is attached to (``None``\n            if not an aura or not yet attached).\n        is_aura: ``False`` for regular enchantments; ``True`` for auras.\n    \"\"\"\n\n    is_aura: bool = False\n\n    def __init__(self, attached_to: Any | None = None, **kwargs: Any) -> None:\n        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ENCHANTMENT}\n        super().__init__(**kwargs)\n        self.attached_to: Any | None = attached_to\n\n    def apply_continuous_effect(self, game: GameState) -> None:\n        \"\"\"Apply the enchantment's continuous effect to the game.\"\"\"\n\n    def on_enchant(self, game: GameState) -> None:\n        \"\"\"Called when this enchantment becomes attached to an object.\"\"\"\n\n    def on_detach(self, game: GameState) -> None:\n        \"\"\"Called when this enchantment is detached from its object.\"\"\"\n\n\nclass Aura(Enchantment):\n    \"\"\"An Aura enchantment — attaches to a permanent on the battlefield.\n\n    Sets ``is_aura = True`` so that state-based actions correctly identify\n    this as an aura (and move it to the graveyard when unattached).\n\n    Attributes:\n        is_aura: Always ``True`` for auras.\n    \"\"\"\n\n    is_aura: bool = True\n\n    def __init__(self, attached_to: Any | None = None, **kwargs: Any) -> None:\n        super().__init__(attached_to=attached_to, **kwargs)\n\n\n# ---------------------------------------------------------------------------\n# Artifact / ArtifactCreature\n# ---------------------------------------------------------------------------\n\nclass Artifact(CardImpl):\n    \"\"\"An artifact card.\n\n    Attributes:\n        is_tapped: Whether the artifact is currently tapped.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ARTIFACT}\n        super().__init__(**kwargs)\n        self.is_tapped: bool = False\n\n\nclass ArtifactCreature(Creature):\n    \"\"\"An artifact creature — combines Artifact and Creature types.\n\n    Inherits creature combat stats and behaviour from :class:`Creature`.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ARTIFACT, CardType.CREATURE}\n        super().__init__(**kwargs)\n\n\n# ---------------------------------------------------------------------------\n# Planeswalker\n# ---------------------------------------------------------------------------\n\nclass Planeswalker(CardImpl):\n    \"\"\"A planeswalker card.\n\n    Attributes:\n        starting_loyalty: The starting loyalty printed on the card.\n        loyalty: Current loyalty counter value.\n    \"\"\"\n\n    def __init__(\n        self,\n        starting_loyalty: int = 0,\n        **kwargs: Any,\n    ) -> None:\n        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.PLANESWALKER}\n        super().__init__(**kwargs)\n        self.starting_loyalty: int = starting_loyalty\n        self.loyalty: int = starting_loyalty\n\n    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n        \"\"\"Return the planeswalker's loyalty abilities.\"\"\"\n        return []\n\n\n# ---------------------------------------------------------------------------\n# Land\n# ---------------------------------------------------------------------------\n\nclass Land(CardImpl):\n    \"\"\"A land card.\n\n    Lands are not cast — they are played via a special action. ``can_cast``\n    always returns ``False``.\n\n    Attributes:\n        is_tapped: Whether the land is currently tapped.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.LAND}\n        super().__init__(**kwargs)\n        self.is_tapped: bool = False\n\n    def can_cast(self, game: GameState) -> bool:\n        \"\"\"Lands cannot be cast; they are played as a special action.\"\"\"\n        return False\n\n    def get_mana_abilities(self) -> list[ManaAbility]:\n        \"\"\"Return the land's mana abilities.\"\"\"\n        return []\n","numLines":514,"startLine":1,"totalLines":514}}}
