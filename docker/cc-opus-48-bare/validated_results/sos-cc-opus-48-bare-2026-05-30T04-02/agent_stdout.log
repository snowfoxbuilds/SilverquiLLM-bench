{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JgFHFW1eeLrnXLGFQfqL2X","type":"tool_result","content":"1\t\"\"\"Card implementation for Meteor Golem.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom typing import TYPE_CHECKING, Any\n4\tfrom engine.card import ArtifactCreature, Creature\n5\tfrom engine.continuous_effects import ContinuousEffect, DURATION_END_OF_TURN, Layer, SubLayer\n6\tfrom engine.types import CardType, Keyword, ManaCost, Zone\n7\tfrom engine.events import EntersBattlefieldTriggeredEvent\n8\tif TYPE_CHECKING:\n9\t    from engine.game_state import GameState\n10\t    from cards.registry import CardRegistry\n11\t\n12\tdef _self_etb_condition(source: Any):\n13\t    \"\"\"Return a condition callable that matches only when *source* enters.\"\"\"\n14\t\n15\t    def _condition(game: Any, event: dict) -> bool:\n16\t        return event.permanent is source\n17\t    return _condition\n18\t\n19\tdef _get_chosen_target(card: Any, game: Any) -> Any:\n20\t    chosen = getattr(card, 'chosen_targets', None)\n21\t    if chosen:\n22\t        return chosen[0]\n23\t    return getattr(card, '_resolve_target', None)\n24\t\n25\tdef _is_on_battlefield(game: Any, card: Any) -> bool:\n26\t    \"\"\"Check if *card* is on any player's battlefield.\"\"\"\n27\t    for player in game.players:\n28\t        if game.get_battlefield(player).contains(card):\n29\t            return True\n30\t    return False\n31\t\n32\tclass MeteorGolem(ArtifactCreature):\n33\t    \"\"\"Meteor Golem — {7} — 3/3 — Golem\n34\t\n35\t    When this creature enters, destroy target nonland permanent an opponent controls.\n36\t\n37\t    FDN collector number 256.\n38\t    \"\"\"\n39\t\n40\t    def __init__(self, **kwargs: Any) -> None:\n41\t        kwargs.setdefault('name', 'Meteor Golem')\n42\t        kwargs.setdefault('mana_cost', ManaCost.parse('{7}'))\n43\t        kwargs.setdefault('subtypes', {'Golem'})\n44\t        kwargs.setdefault('base_power', 3)\n45\t        kwargs.setdefault('base_toughness', 3)\n46\t        kwargs.setdefault('rules_text', 'When this creature enters, destroy target nonland permanent an opponent controls.')\n47\t        super().__init__(**kwargs)\n48\t\n49\t    def register_triggers(self, game: GameState) -> None:\n50\t        from engine.triggers import TriggerRegistration\n51\t        from engine.game import destroy\n52\t        source = self\n53\t\n54\t        def _effect(game: GameState) -> None:\n55\t            target = _get_chosen_target(source, game)\n56\t            if target is not None and _is_on_battlefield(game, target):\n57\t                destroy(game, target)\n58\t        controller = getattr(self, 'controller', None) or game.active_player\n59\t        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=_self_etb_condition(self), effect=_effect, source=self, controller=controller))\n60\t"}]},"parent_tool_use_id":"toolu_01X6Ryuijvq29Av9gGTdruzn","session_id":"b76fbb6d-7052-44e0-893e-8a2c1cc9d4a6","uuid":"6467b3ee-dacc-4045-ad56-e5008b35010d","timestamp":"2026-05-30T04:55:00.444Z","subagent_type":"Explore","task_description":"Research token creation and ETB triggers"}
