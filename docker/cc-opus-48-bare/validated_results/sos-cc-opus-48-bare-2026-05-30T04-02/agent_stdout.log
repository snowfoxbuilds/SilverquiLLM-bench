{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XjqXvMd1LJ2DfUHqjkJZ8G","type":"tool_result","content":"1\t\"\"\"Card implementation for Leyline Axe.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\tfrom typing import TYPE_CHECKING, Any\n5\tfrom engine.card import ActivatedAbility, Artifact\n6\tfrom engine.continuous_effects import (\n7\t    ContinuousEffect,\n8\t    DURATION_PERMANENT,\n9\t    Layer,\n10\t    SubLayer,\n11\t)\n12\tfrom engine.types import Keyword, ManaCost\n13\tif TYPE_CHECKING:\n14\t    from engine.game_state import GameState\n15\t\n16\t    from cards.registry import CardRegistry\n17\t\n18\tdef _make_equip_ability(\n19\t    equipment: Artifact,\n20\t    generic_cost: int,\n21\t) -> ActivatedAbility:\n22\t    \"\"\"Return an :class:`ActivatedAbility` representing *Equip {N}*.\n23\t\n24\t    The ability pays *generic_cost* generic mana from the controller's mana\n25\t    pool, then calls ``equipment.equip(target, game)`` to attach the\n26\t    equipment to a target creature.  Equip is sorcery-speed only (the engine\n27\t    should enforce timing; we document the restriction in the description).\n28\t\n29\t    The target creature is read from ``equipment._current_target`` which the\n30\t    game engine is expected to set before calling the ability's effect.\n31\t    \"\"\"\n32\t    source = equipment\n33\t\n34\t    def _cost(game: Any, src: Any) -> bool:\n35\t        controller = getattr(src, \"controller\", None)\n36\t        if controller is None:\n37\t            return False\n38\t        if controller.mana_pool.total() < generic_cost:\n39\t            return False\n40\t        controller.mana_pool.pay(ManaCost(generic=generic_cost))\n41\t        return True\n42\t\n43\t    def _effect(game: Any) -> None:\n44\t        target = getattr(source, \"_current_target\", None)\n45\t        if target is not None:\n46\t            source.equip(target, game)\n47\t\n48\t    return ActivatedAbility(\n49\t        cost=_cost,\n50\t        effect=_effect,\n51\t        description=f\"Equip {{{generic_cost}}} (sorcery speed)\",\n52\t    )\n53\tdef _is_on_battlefield(game: Any, obj: Any) -> bool:\n54\t    for player in game.players:\n55\t        if game.get_battlefield(player).contains(obj):\n56\t            return True\n57\t    return False\n58\t\n59\tclass LeylineAxe(Artifact):\n60\t    \"\"\"Leyline Axe — {4} — Equipped creature gets +1/+1 and has double strike\n61\t    and trample. Equip {3}.\"\"\"\n62\t\n63\t    def __init__(self, **kwargs: Any) -> None:\n64\t        kwargs.setdefault(\"name\", \"Leyline Axe\")\n65\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{4}\"))\n66\t        kwargs.setdefault(\"subtypes\", set())\n67\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Equipment\"}\n68\t        kwargs.setdefault(\n69\t            \"rules_text\",\n70\t            \"If this card is in your opening hand, you may begin the game \"\n71\t            \"with it on the battlefield.\\n\"\n72\t            \"Equipped creature gets +1/+1 and has double strike and trample.\\n\"\n73\t            \"Equip {3}\",\n74\t        )\n75\t        super().__init__(**kwargs)\n76\t        self.attached_to: Any | None = None\n77\t        self._pt_effect_ref: ContinuousEffect | None = None\n78\t        self._ability_effect_ref: ContinuousEffect | None = None\n79\t\n80\t    def get_activated_abilities(self) -> list[ActivatedAbility]:\n81\t        return [_make_equip_ability(self, generic_cost=3)]\n82\t\n83\t    def equip(self, target: Any, game: Any) -> None:\n84\t        self.attached_to = target\n85\t        self._register_effect(game)\n86\t\n87\t    def _register_effect(self, game: Any) -> None:\n88\t        equip_ref = self\n89\t\n90\t        def _apply_pt(game: Any) -> None:\n91\t            if not _is_on_battlefield(game, equip_ref):\n92\t                return\n93\t            creature = equip_ref.attached_to\n94\t            if creature is None or not _is_on_battlefield(game, creature):\n95\t                return\n96\t            creature.modified_power += 1\n97\t            creature.modified_toughness += 1\n98\t\n99\t        def _apply_ability(game: Any) -> None:\n100\t            if not _is_on_battlefield(game, equip_ref):\n101\t                return\n102\t            creature = equip_ref.attached_to\n103\t            if creature is None or not _is_on_battlefield(game, creature):\n104\t                return\n105\t            creature.keywords = creature.keywords | Keyword.DOUBLE_STRIKE | Keyword.TRAMPLE\n106\t\n107\t        if self._pt_effect_ref is None:\n108\t            pt_effect = ContinuousEffect(\n109\t                source=equip_ref,\n110\t                layer=Layer.POWER_TOUGHNESS,\n111\t                sublayer=SubLayer.MODIFY_PT,\n112\t                apply=_apply_pt,\n113\t                duration=DURATION_PERMANENT,\n114\t            )\n115\t            self._pt_effect_ref = game.effect_manager.add(pt_effect)\n116\t\n117\t        if self._ability_effect_ref is None:\n118\t            ability_effect = ContinuousEffect(\n119\t                source=equip_ref,\n120\t                layer=Layer.ABILITY,\n121\t                sublayer=None,\n122\t                apply=_apply_ability,\n123\t                duration=DURATION_PERMANENT,\n124\t            )\n125\t            self._ability_effect_ref = game.effect_manager.add(ability_effect)\n126\t"}]},"parent_tool_use_id":null,"session_id":"b76fbb6d-7052-44e0-893e-8a2c1cc9d4a6","uuid":"3f33e57c-6765-4aba-a9e9-a7e46822f3b8","timestamp":"2026-05-30T04:42:51.106Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_129/card_impl.py","content":"\"\"\"Card implementation for Leyline Axe.\"\"\"\n\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import ActivatedAbility, Artifact\nfrom engine.continuous_effects import (\n    ContinuousEffect,\n    DURATION_PERMANENT,\n    Layer,\n    SubLayer,\n)\nfrom engine.types import Keyword, ManaCost\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n    from cards.registry import CardRegistry\n\ndef _make_equip_ability(\n    equipment: Artifact,\n    generic_cost: int,\n) -> ActivatedAbility:\n    \"\"\"Return an :class:`ActivatedAbility` representing *Equip {N}*.\n\n    The ability pays *generic_cost* generic mana from the controller's mana\n    pool, then calls ``equipment.equip(target, game)`` to attach the\n    equipment to a target creature.  Equip is sorcery-speed only (the engine\n    should enforce timing; we document the restriction in the description).\n\n    The target creature is read from ``equipment._current_target`` which the\n    game engine is expected to set before calling the ability's effect.\n    \"\"\"\n    source = equipment\n\n    def _cost(game: Any, src: Any) -> bool:\n        controller = getattr(src, \"controller\", None)\n        if controller is None:\n            return False\n        if controller.mana_pool.total() < generic_cost:\n            return False\n        controller.mana_pool.pay(ManaCost(generic=generic_cost))\n        return True\n\n    def _effect(game: Any) -> None:\n        target = getattr(source, \"_current_target\", None)\n        if target is not None:\n            source.equip(target, game)\n\n    return ActivatedAbility(\n        cost=_cost,\n        effect=_effect,\n        description=f\"Equip {{{generic_cost}}} (sorcery speed)\",\n    )\ndef _is_on_battlefield(game: Any, obj: Any) -> bool:\n    for player in game.players:\n        if game.get_battlefield(player).contains(obj):\n            return True\n    return False\n\nclass LeylineAxe(Artifact):\n    \"\"\"Leyline Axe — {4} — Equipped creature gets +1/+1 and has double strike\n    and trample. Equip {3}.\"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"Leyline Axe\")\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{4}\"))\n        kwargs.setdefault(\"subtypes\", set())\n        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Equipment\"}\n        kwargs.setdefault(\n            \"rules_text\",\n            \"If this card is in your opening hand, you may begin the game \"\n            \"with it on the battlefield.\\n\"\n            \"Equipped creature gets +1/+1 and has double strike and trample.\\n\"\n            \"Equip {3}\",\n        )\n        super().__init__(**kwargs)\n        self.attached_to: Any | None = None\n        self._pt_effect_ref: ContinuousEffect | None = None\n        self._ability_effect_ref: ContinuousEffect | None = None\n\n    def get_activated_abilities(self) -> list[ActivatedAbility]:\n        return [_make_equip_ability(self, generic_cost=3)]\n\n    def equip(self, target: Any, game: Any) -> None:\n        self.attached_to = target\n        self._register_effect(game)\n\n    def _register_effect(self, game: Any) -> None:\n        equip_ref = self\n\n        def _apply_pt(game: Any) -> None:\n            if not _is_on_battlefield(game, equip_ref):\n                return\n            creature = equip_ref.attached_to\n            if creature is None or not _is_on_battlefield(game, creature):\n                return\n            creature.modified_power += 1\n            creature.modified_toughness += 1\n\n        def _apply_ability(game: Any) -> None:\n            if not _is_on_battlefield(game, equip_ref):\n                return\n            creature = equip_ref.attached_to\n            if creature is None or not _is_on_battlefield(game, creature):\n                return\n            creature.keywords = creature.keywords | Keyword.DOUBLE_STRIKE | Keyword.TRAMPLE\n\n        if self._pt_effect_ref is None:\n            pt_effect = ContinuousEffect(\n                source=equip_ref,\n                layer=Layer.POWER_TOUGHNESS,\n                sublayer=SubLayer.MODIFY_PT,\n                apply=_apply_pt,\n                duration=DURATION_PERMANENT,\n            )\n            self._pt_effect_ref = game.effect_manager.add(pt_effect)\n\n        if self._ability_effect_ref is None:\n            ability_effect = ContinuousEffect(\n                source=equip_ref,\n                layer=Layer.ABILITY,\n                sublayer=None,\n                apply=_apply_ability,\n                duration=DURATION_PERMANENT,\n            )\n            self._ability_effect_ref = game.effect_manager.add(ability_effect)\n","numLines":126,"startLine":1,"totalLines":126}}}
