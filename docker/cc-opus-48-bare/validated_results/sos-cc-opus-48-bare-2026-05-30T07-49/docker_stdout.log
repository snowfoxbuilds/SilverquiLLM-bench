{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PsYvBMZsNbgyhuddN6teDg","type":"tool_result","content":"1\t\"\"\"Card implementation for Ambush Wolf.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom typing import TYPE_CHECKING, Any\n4\tfrom engine.card import ArtifactCreature, Creature\n5\tfrom engine.continuous_effects import ContinuousEffect, DURATION_END_OF_TURN, Layer, SubLayer\n6\tfrom engine.types import CardType, Keyword, ManaCost, Zone\n7\tfrom engine.events import EntersBattlefieldTriggeredEvent\n8\tif TYPE_CHECKING:\n9\t    from engine.game_state import GameState\n10\t    from cards.registry import CardRegistry\n11\t\n12\tdef _self_etb_condition(source: Any):\n13\t    \"\"\"Return a condition callable that matches only when *source* enters.\"\"\"\n14\t\n15\t    def _condition(game: Any, event: dict) -> bool:\n16\t        return event.permanent is source\n17\t    return _condition\n18\t\n19\tdef _get_chosen_target(card: Any, game: Any) -> Any:\n20\t    chosen = getattr(card, 'chosen_targets', None)\n21\t    if chosen:\n22\t        return chosen[0]\n23\t    return getattr(card, '_resolve_target', None)\n24\t\n25\tclass AmbushWolf(Creature):\n26\t    \"\"\"Ambush Wolf — {2}{G} — 4/2 — Wolf — Flash\n27\t\n28\t    When this creature enters, exile up to one target card from a graveyard.\n29\t\n30\t    FDN collector number 98.\n31\t    \"\"\"\n32\t\n33\t    def __init__(self, **kwargs: Any) -> None:\n34\t        kwargs.setdefault('name', 'Ambush Wolf')\n35\t        kwargs.setdefault('mana_cost', ManaCost.parse('{2}{G}'))\n36\t        kwargs.setdefault('subtypes', {'Wolf'})\n37\t        kwargs.setdefault('keywords', Keyword.FLASH)\n38\t        kwargs.setdefault('base_power', 4)\n39\t        kwargs.setdefault('base_toughness', 2)\n40\t        kwargs.setdefault('rules_text', 'Flash\\nWhen this creature enters, exile up to one target card from a graveyard.')\n41\t        super().__init__(**kwargs)\n42\t\n43\t    def register_triggers(self, game: GameState) -> None:\n44\t        from engine.triggers import TriggerRegistration\n45\t        source = self\n46\t\n47\t        def _effect(game: GameState) -> None:\n48\t            target = _get_chosen_target(source, game)\n49\t            if target is None:\n50\t                return\n51\t            for player in game.players:\n52\t                gy = player.zones[Zone.GRAVEYARD]\n53\t                if gy.contains(target):\n54\t                    gy.remove(target)\n55\t                    owner = getattr(target, 'owner', player)\n56\t                    owner.zones[Zone.EXILE].add(target)\n57\t                    return\n58\t        controller = getattr(self, 'controller', None) or game.active_player\n59\t        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=_self_etb_condition(self), effect=_effect, source=self, controller=controller))\n60\t"}]},"parent_tool_use_id":null,"session_id":"7182fe58-6bea-420a-b90d-6a2af4b380c1","uuid":"ed4834d5-44f7-4337-aa85-93a3e44ff4d4","timestamp":"2026-05-30T08:49:39.414Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_98/card_impl.py","content":"\"\"\"Card implementation for Ambush Wolf.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import ArtifactCreature, Creature\nfrom engine.continuous_effects import ContinuousEffect, DURATION_END_OF_TURN, Layer, SubLayer\nfrom engine.types import CardType, Keyword, ManaCost, Zone\nfrom engine.events import EntersBattlefieldTriggeredEvent\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from cards.registry import CardRegistry\n\ndef _self_etb_condition(source: Any):\n    \"\"\"Return a condition callable that matches only when *source* enters.\"\"\"\n\n    def _condition(game: Any, event: dict) -> bool:\n        return event.permanent is source\n    return _condition\n\ndef _get_chosen_target(card: Any, game: Any) -> Any:\n    chosen = getattr(card, 'chosen_targets', None)\n    if chosen:\n        return chosen[0]\n    return getattr(card, '_resolve_target', None)\n\nclass AmbushWolf(Creature):\n    \"\"\"Ambush Wolf — {2}{G} — 4/2 — Wolf — Flash\n\n    When this creature enters, exile up to one target card from a graveyard.\n\n    FDN collector number 98.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Ambush Wolf')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{2}{G}'))\n        kwargs.setdefault('subtypes', {'Wolf'})\n        kwargs.setdefault('keywords', Keyword.FLASH)\n        kwargs.setdefault('base_power', 4)\n        kwargs.setdefault('base_toughness', 2)\n        kwargs.setdefault('rules_text', 'Flash\\nWhen this creature enters, exile up to one target card from a graveyard.')\n        super().__init__(**kwargs)\n\n    def register_triggers(self, game: GameState) -> None:\n        from engine.triggers import TriggerRegistration\n        source = self\n\n        def _effect(game: GameState) -> None:\n            target = _get_chosen_target(source, game)\n            if target is None:\n                return\n            for player in game.players:\n                gy = player.zones[Zone.GRAVEYARD]\n                if gy.contains(target):\n                    gy.remove(target)\n                    owner = getattr(target, 'owner', player)\n                    owner.zones[Zone.EXILE].add(target)\n                    return\n        controller = getattr(self, 'controller', None) or game.active_player\n        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=_self_etb_condition(self), effect=_effect, source=self, controller=controller))\n","numLines":60,"startLine":1,"totalLines":60}}}
