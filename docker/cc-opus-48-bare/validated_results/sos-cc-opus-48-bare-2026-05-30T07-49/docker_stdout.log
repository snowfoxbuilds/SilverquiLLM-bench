{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QgDT1TRPq4WB3XANqyD8SR","type":"tool_result","content":"1\t\"\"\"Card implementation for Witness Protection.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Aura\n8\tfrom engine.continuous_effects import (\n9\t    ContinuousEffect,\n10\t    DURATION_PERMANENT,\n11\t    Layer,\n12\t    SubLayer,\n13\t)\n14\tfrom engine.types import CardType, Color, Keyword, ManaCost, TargetRequirement, Zone\n15\t\n16\tif TYPE_CHECKING:\n17\t    from engine.game_state import GameState\n18\t\n19\t\n20\tdef _creature_targets(game: Any) -> list[Any]:\n21\t    \"\"\"Return all creatures on the battlefield.\"\"\"\n22\t    targets: list[Any] = []\n23\t    for player in game.players:\n24\t        for obj in game.get_battlefield(player).get_all():\n25\t            if CardType.CREATURE in getattr(obj, \"card_types\", set()):\n26\t                targets.append(obj)\n27\t    return targets\n28\t\n29\t\n30\tdef _is_on_battlefield(game: Any, obj: Any) -> bool:\n31\t    \"\"\"Check if *obj* is on any player's battlefield.\"\"\"\n32\t    for player in game.players:\n33\t        if game.get_battlefield(player).contains(obj):\n34\t            return True\n35\t    return False\n36\t\n37\t\n38\tdef _get_chosen_target(card: Any, game: Any) -> Any:\n39\t    chosen = getattr(card, \"chosen_targets\", None)\n40\t    if chosen:\n41\t        return chosen[0]\n42\t    return getattr(card, \"_resolve_target\", None)\n43\t\n44\t\n45\tclass WitnessProtection(Aura):\n46\t    \"\"\"Witness Protection — {U}.\n47\t\n48\t    Enchant creature.\n49\t    Enchanted creature loses all abilities and is a green and white Citizen\n50\t    creature with base power and toughness 1/1 named Legitimate Businessperson.\n51\t    (It loses all other colors, card types, creature types, and names.)\n52\t    \"\"\"\n53\t\n54\t    def __init__(self, **kwargs: Any) -> None:\n55\t        kwargs.setdefault(\"name\", \"Witness Protection\")\n56\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{U}\"))\n57\t        kwargs.setdefault(\"subtypes\", set())\n58\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Aura\"}\n59\t        kwargs.setdefault(\n60\t            \"rules_text\",\n61\t            \"Enchant creature\\n\"\n62\t            \"Enchanted creature loses all abilities and is a green and white \"\n63\t            \"Citizen creature with base power and toughness 1/1 named \"\n64\t            \"Legitimate Businessperson.\",\n65\t        )\n66\t        super().__init__(**kwargs)\n67\t        self._type_effect_ref: ContinuousEffect | None = None\n68\t        self._color_effect_ref: ContinuousEffect | None = None\n69\t        self._ability_effect_ref: ContinuousEffect | None = None\n70\t        self._pt_effect_ref: ContinuousEffect | None = None\n71\t\n72\t    # -- targeting --------------------------------------------------------\n73\t\n74\t    def get_targets(self, game: GameState) -> list[Any]:\n75\t        targets = _creature_targets(game)\n76\t        if not targets:\n77\t            return []\n78\t        return [\n79\t            TargetRequirement(\n80\t                filter_fn=lambda obj: CardType.CREATURE\n81\t                in getattr(obj, \"card_types\", set()),\n82\t                description=\"enchant creature\",\n83\t                zone=Zone.BATTLEFIELD,\n84\t            )\n85\t        ]\n86\t\n87\t    def can_cast(self, game: GameState) -> bool:\n88\t        return bool(_creature_targets(game))\n89\t\n90\t    # -- resolution -------------------------------------------------------\n91\t\n92\t    def on_resolve(self, game: GameState) -> None:\n93\t        target = _get_chosen_target(self, game)\n94\t        if target is None:\n95\t            return\n96\t        if not _is_on_battlefield(game, target):\n97\t            return\n98\t        # Revalidate that target is still a creature (type may have changed).\n99\t        if CardType.CREATURE not in getattr(target, \"card_types\", set()):\n100\t            return\n101\t        self.attached_to = target\n102\t        self._register_effects(game)\n103\t\n104\t    # -- continuous effects -----------------------------------------------\n105\t    #\n106\t    # Layer 4 (TYPE):  Becomes a Citizen creature (loses other types/subtypes),\n107\t    #                  name becomes \"Legitimate Businessperson\".\n108\t    # Layer 5 (COLOR): Becomes green and white (loses other colors).\n109\t    # Layer 6 (ABILITY): Loses all abilities.\n110\t    # Layer 7b (SET_PT): Base power and toughness become 1/1.\n111\t\n112\t    def apply_continuous_effect(self, game: GameState) -> None:\n113\t        \"\"\"Apply all four layers of the Witness Protection effect.\"\"\"\n114\t        creature = self.attached_to\n115\t        if creature is None or not _is_on_battlefield(game, creature):\n116\t            return\n117\t        if not _is_on_battlefield(game, self):\n118\t            return\n119\t        self._apply_type_change(creature)\n120\t        self._apply_color_change(creature)\n121\t        self._apply_ability_removal(creature)\n122\t        self._apply_pt_set(creature)\n123\t\n124\t    def _apply_type_change(self, creature: Any) -> None:\n125\t        \"\"\"Layer 4: Override name, card types, and subtypes.\"\"\"\n126\t        creature.name = \"Legitimate Businessperson\"\n127\t        creature.card_types = {CardType.CREATURE}\n128\t        creature.subtypes = {\"Citizen\"}\n129\t\n130\t    def _apply_color_change(self, creature: Any) -> None:\n131\t        \"\"\"Layer 5: Override colors to green and white.\"\"\"\n132\t        # Set colors if the permanent tracks them.\n133\t        creature.colors = {Color.GREEN, Color.WHITE}\n134\t\n135\t    def _apply_ability_removal(self, creature: Any) -> None:\n136\t        \"\"\"Layer 6: Remove all abilities.\"\"\"\n137\t        creature.keywords = Keyword(0)\n138\t\n139\t    def _apply_pt