{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FFwyfsHaVDNRoyy9gdCqtr","type":"tool_result","content":"1\t\"\"\"Card implementation for Witherbloom, the Balancer.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.types import CardType, Keyword, ManaCost, Supertype\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t\n13\t\n14\tdef _is_on_battlefield(game: Any, obj: Any) -> bool:\n15\t    for player in game.players:\n16\t        if game.get_battlefield(player).contains(obj):\n17\t            return True\n18\t    return False\n19\t\n20\t\n21\tdef _is_instant_or_sorcery(obj: Any) -> bool:\n22\t    types = getattr(obj, \"card_types\", set())\n23\t    return CardType.INSTANT in types or CardType.SORCERY in types\n24\t\n25\t\n26\tdef _count_creatures(game: Any, player: Any) -> int:\n27\t    return sum(\n28\t        1\n29\t        for obj in game.get_battlefield(player).get_all()\n30\t        if CardType.CREATURE in getattr(obj, \"card_types\", set())\n31\t    )\n32\t\n33\t\n34\tclass WitherbloomTheBalancer(Creature):\n35\t    \"\"\"Witherbloom, the Balancer — {6}{B}{G} — 5/5 — Legendary Elder Dragon.\n36\t\n37\t    Affinity for creatures (this spell costs {1} less to cast for each\n38\t    creature you control).  Flying, deathtouch.  Instant and sorcery spells\n39\t    you cast have affinity for creatures.\n40\t\n41\t    SOS collector number 245.\n42\t    \"\"\"\n43\t\n44\t    def __init__(self, **kwargs: Any) -> None:\n45\t        kwargs.setdefault(\"name\", \"Witherbloom, the Balancer\")\n46\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{6}{B}{G}\"))\n47\t        kwargs.setdefault(\"subtypes\", {\"Elder\", \"Dragon\"})\n48\t        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n49\t        kwargs.setdefault(\"keywords\", Keyword.FLYING | Keyword.DEATHTOUCH)\n50\t        kwargs.setdefault(\"base_power\", 5)\n51\t        kwargs.setdefault(\"base_toughness\", 5)\n52\t        kwargs.setdefault(\n53\t            \"rules_text\",\n54\t            \"Affinity for creatures\\nFlying, deathtouch\\nInstant and sorcery \"\n55\t            \"spells you cast have affinity for creatures.\",\n56\t        )\n57\t        super().__init__(**kwargs)\n58\t\n59\t    def cost_reduction(self, game: \"GameState\") -> int:\n60\t        \"\"\"Affinity for creatures — {1} less per creature you control.\"\"\"\n61\t        controller = self.controller\n62\t        if controller is None:\n63\t            return 0\n64\t        return _count_creatures(game, controller)\n65\t\n66\t    def static_cost_reduction(\n67\t        self, game: \"GameState\", spell: Any, spell_controller: Any\n68\t    ) -> int:\n69\t        \"\"\"Grant affinity for creatures to the controller's instant/sorcery spells.\"\"\"\n70\t        if not _is_on_battlefield(game, self):\n71\t            return 0\n72\t        controller = self.controller\n73\t        if controller is None or spell_controller is not controller:\n74\t            return 0\n75\t        if not _is_instant_or_sorcery(spell):\n76\t            return 0\n77\t        return _count_creatures(game, spell_controller)\n78\t"}]},"parent_tool_use_id":null,"session_id":"7182fe58-6bea-420a-b90d-6a2af4b380c1","uuid":"2503a935-1d0d-4988-b63e-47428d3b587a","timestamp":"2026-05-30T08:49:29.280Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/sos/sos_245/card_impl.py","content":"\"\"\"Card implementation for Witherbloom, the Balancer.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import Creature\nfrom engine.types import CardType, Keyword, ManaCost, Supertype\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\ndef _is_on_battlefield(game: Any, obj: Any) -> bool:\n    for player in game.players:\n        if game.get_battlefield(player).contains(obj):\n            return True\n    return False\n\n\ndef _is_instant_or_sorcery(obj: Any) -> bool:\n    types = getattr(obj, \"card_types\", set())\n    return CardType.INSTANT in types or CardType.SORCERY in types\n\n\ndef _count_creatures(game: Any, player: Any) -> int:\n    return sum(\n        1\n        for obj in game.get_battlefield(player).get_all()\n        if CardType.CREATURE in getattr(obj, \"card_types\", set())\n    )\n\n\nclass WitherbloomTheBalancer(Creature):\n    \"\"\"Witherbloom, the Balancer — {6}{B}{G} — 5/5 — Legendary Elder Dragon.\n\n    Affinity for creatures (this spell costs {1} less to cast for each\n    creature you control).  Flying, deathtouch.  Instant and sorcery spells\n    you cast have affinity for creatures.\n\n    SOS collector number 245.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"Witherbloom, the Balancer\")\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{6}{B}{G}\"))\n        kwargs.setdefault(\"subtypes\", {\"Elder\", \"Dragon\"})\n        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n        kwargs.setdefault(\"keywords\", Keyword.FLYING | Keyword.DEATHTOUCH)\n        kwargs.setdefault(\"base_power\", 5)\n        kwargs.setdefault(\"base_toughness\", 5)\n        kwargs.setdefault(\n            \"rules_text\",\n            \"Affinity for creatures\\nFlying, deathtouch\\nInstant and sorcery \"\n            \"spells you cast have affinity for creatures.\",\n        )\n        super().__init__(**kwargs)\n\n    def cost_reduction(self, game: \"GameState\") -> int:\n        \"\"\"Affinity for creatures — {1} less per creature you control.\"\"\"\n        controller = self.controller\n        if controller is None:\n            return 0\n        return _count_creatures(game, controller)\n\n    def static_cost_reduction(\n        self, game: \"GameState\", spell: Any, spell_controller: Any\n    ) -> int:\n        \"\"\"Grant affinity for creatures to the controller's instant/sorcery spells.\"\"\"\n        if not _is_on_battlefield(game, self):\n            return 0\n        controller = self.controller\n        if controller is None or spell_controller is not controller:\n            return 0\n        if not _is_instant_or_sorcery(spell):\n            return 0\n        return _count_creatures(game, spell_controller)\n","numLines":78,"startLine":1,"totalLines":78}}}
