, ctrl)","+","+        game.trigger_manager.register(","+            TriggerRegistration(","+                event_type=BeginningOfMainPhaseTriggeredEvent,","+                condition=_condition,","+                effect=_effect,","+                source=self,","+                controller=controller,","+            )","+        )"]}],"originalFile":"\"\"\"Card implementation for Improvisation Capstone.\"\"\"\n\nfrom __future__ import annotations\n\nfrom engine.card import CardImpl\n\nfrom typing import TYPE_CHECKING\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\nclass ImprovisationCapstone(CardImpl):\n    \"\"\"TODO: Implement Improvisation Capstone.\"\"\"\n\n    pass\n","userModified":false}}
