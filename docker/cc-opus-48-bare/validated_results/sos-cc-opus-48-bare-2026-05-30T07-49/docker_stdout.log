{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E9ExwQKJfkMYFZBEpBDW9m","type":"tool_result","content":"520\t\n521\tclass TestLoyaltyAbilityPositiveCost:\n522\t    \"\"\"Loyalty ability with positive cost increases loyalty counters.\"\"\"\n523\t\n524\t    def test_positive_loyalty_cost_increases_loyalty(self):\n525\t        game = _sorcery_speed_game()\n526\t        player = game.players[0]\n527\t        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=3)\n528\t        ability = LoyaltyAbilityInstance(\n529\t            source=pw,\n530\t            controller=player,\n531\t            loyalty_cost=2,\n532\t            effect=lambda g: None,\n533\t        )\n534\t        activate_ability(game, player, ability)\n535\t        assert pw.loyalty == 5\n536\t\n537\t    def test_positive_cost_pushes_to_stack(self):\n538\t        game = _sorcery_speed_game()\n539\t        player = game.players[0]\n540\t        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=3)\n541\t        ability = LoyaltyAbilityInstance(\n542\t            source=pw,\n543\t            controller=player,\n544\t            loyalty_cost=1,\n545\t            effect=lambda g: None,\n546\t        )\n547\t        activate_ability(game, player, ability)\n548\t        assert not game.stack.is_empty()\n549\t\n550\t\n551\t# ---------------------------------------------------------------------------\n552\t# LoyaltyAbility — negative cost (−N)\n553\t# ---------------------------------------------------------------------------\n554\t\n555\t\n556\tclass TestLoyaltyAbilityNegativeCost:\n557\t    \"\"\"Loyalty ability with negative cost decreases loyalty counters.\"\"\"\n558\t\n559\t    def test_negative_loyalty_cost_decreases_loyalty(self):\n560\t        game = _sorcery_speed_game()\n561\t        player = game.players[0]\n562\t        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=5)\n563\t        ability = LoyaltyAbilityInstance(\n564\t            source=pw,\n565\t            controller=player,\n566\t            loyalty_cost=-3,\n567\t            effect=lambda g: None,\n568\t        )\n569\t        activate_ability(game, player, ability)\n570\t        assert pw.loyalty == 2\n571\t\n572\t    def test_negative_cost_exact_loyalty(self):\n573\t        \"\"\"Using -N when loyalty == N should succeed and set loyalty to 0.\"\"\"\n574\t        game = _sorcery_speed_game()\n575\t        player = game.players[0]\n576\t        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=4)\n577\t        ability = LoyaltyAbilityInstance(\n578\t            source=pw,\n579\t            controller=player,\n580\t            loyalty_cost=-4,\n581\t            effect=lambda g: None,\n582\t        )\n583\t        activate_ability(game, player, ability)\n584\t        assert pw.loyalty == 0\n585\t\n586\t    def test_insufficient_loyalty_raises(self):\n587\t        \"\"\"Cannot activate −N if source loyalty < N.\"\"\"\n588\t        game = _sorcery_speed_game()\n589\t        player = game.players[0]\n590\t        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=2)\n591\t        ability = LoyaltyAbilityInstance(\n592\t            source=pw,\n593\t            controller=player,\n594\t            loyalty_cost=-5,\n595\t            effect=lambda g: None,\n596\t        )\n597\t        with pytest.raises(AbilityError, match=\"insufficient loyalty\"):\n598\t            activate_ability(game, player, ability)\n599\t\n600\t    def test_insufficient_loyalty_no_stack_entry(self):\n601\t        game = _sorcery_speed_game()\n602\t        player = game.players[0]\n603\t        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=1)\n604\t        ability = LoyaltyAbilityInstance(\n605\t            source=pw,\n606\t            controller=player,\n607\t            loyalty_cost=-3,\n608\t            effect=lambda g: None,\n609\t        )\n610\t        with pytest.raises(AbilityError):\n611\t            activate_ability(game, player, ability)\n612\t        assert game.stack.is_empty()\n613\t\n614\t    def test_insufficient_loyalty_does_not_change_loyalty(self):\n615\t        game = _sorcery_speed_game()\n616\t        player = game.players[0]\n617\t        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=2)\n618\t        ability = LoyaltyAbilityInstance(\n619\t            source=pw,\n620\t            controller=player,\n621\t            loyalty_cost=-5,\n622\t            effect=lambda g: None,\n623\t        )\n624\t        with pytest.raises(AbilityError):\n625\t            activate_ability(game, player, ability)\n626\t        assert pw.loyalty == 2  # unchanged\n627\t\n628\t\n629\t# ---------------------------------------------------------------------------\n630\t# LoyaltyAbility — zero cost\n631\t# ---------------------------------------------------------------------------\n632\t\n633\t\n634\tclass TestLoyaltyAbilityZeroCost:\n635\t    \"\"\"Loyalty ability with zero cost leaves loyalty unchanged.\"\"\"\n636\t\n637\t    def test_zero_loyalty_cost_does_not_change_loyalty(self):\n638\t        game = _sorcery_speed_game()\n639\t        player = game.players[0]"}]},"parent_tool_use_id":null,"session_id":"7182fe58-6bea-420a-b90d-6a2af4b380c1","uuid":"d421669b-17ae-4b7e-8002-ce7ffa5a9026","timestamp":"2026-05-30T08:08:45.493Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine_tests/test_abilities.py","content":"\nclass TestLoyaltyAbilityPositiveCost:\n    \"\"\"Loyalty ability with positive cost increases loyalty counters.\"\"\"\n\n    def test_positive_loyalty_cost_increases_loyalty(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=3)\n        ability = LoyaltyAbilityInstance(\n            source=pw,\n            controller=player,\n            loyalty_cost=2,\n            effect=lambda g: None,\n        )\n        activate_ability(game, player, ability)\n        assert pw.loyalty == 5\n\n    def test_positive_cost_pushes_to_stack(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=3)\n        ability = LoyaltyAbilityInstance(\n            source=pw,\n            controller=player,\n            loyalty_cost=1,\n            effect=lambda g: None,\n        )\n        activate_ability(game, player, ability)\n        assert not game.stack.is_empty()\n\n\n# ---------------------------------------------------------------------------\n# LoyaltyAbility — negative cost (−N)\n# ---------------------------------------------------------------------------\n\n\nclass TestLoyaltyAbilityNegativeCost:\n    \"\"\"Loyalty ability with negative cost decreases loyalty counters.\"\"\"\n\n    def test_negative_loyalty_cost_decreases_loyalty(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=5)\n        ability = LoyaltyAbilityInstance(\n            source=pw,\n            controller=player,\n            loyalty_cost=-3,\n            effect=lambda g: None,\n        )\n        activate_ability(game, player, ability)\n        assert pw.loyalty == 2\n\n    def test_negative_cost_exact_loyalty(self):\n        \"\"\"Using -N when loyalty == N should succeed and set loyalty to 0.\"\"\"\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=4)\n        ability = LoyaltyAbilityInstance(\n            source=pw,\n            controller=player,\n            loyalty_cost=-4,\n            effect=lambda g: None,\n        )\n        activate_ability(game, player, ability)\n        assert pw.loyalty == 0\n\n    def test_insufficient_loyalty_raises(self):\n        \"\"\"Cannot activate −N if source loyalty < N.\"\"\"\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=2)\n        ability = LoyaltyAbilityInstance(\n            source=pw,\n            controller=player,\n            loyalty_cost=-5,\n            effect=lambda g: None,\n        )\n        with pytest.raises(AbilityError, match=\"insufficient loyalty\"):\n            activate_ability(game, player, ability)\n\n    def test_insufficient_loyalty_no_stack_entry(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=1)\n        ability = LoyaltyAbilityInstance(\n            source=pw,\n            controller=player,\n            loyalty_cost=-3,\n            effect=lambda g: None,\n        )\n        with pytest.raises(AbilityError):\n            activate_ability(game, player, ability)\n        assert game.stack.is_empty()\n\n    def test_insufficient_loyalty_does_not_change_loyalty(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=2)\n        ability = LoyaltyAbilityInstance(\n            source=pw,\n            controller=player,\n            loyalty_cost=-5,\n            effect=lambda g: None,\n        )\n        with pytest.raises(AbilityError):\n            activate_ability(game, player, ability)\n        assert pw.loyalty == 2  # unchanged\n\n\n# ---------------------------------------------------------------------------\n# LoyaltyAbility — zero cost\n# ---------------------------------------------------------------------------\n\n\nclass TestLoyaltyAbilityZeroCost:\n    \"\"\"Loyalty ability with zero cost leaves loyalty unchanged.\"\"\"\n\n    def test_zero_loyalty_cost_does_not_change_loyalty(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]","numLines":120,"startLine":520,"totalLines":977}}}
