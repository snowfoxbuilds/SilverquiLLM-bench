{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019PxgpZAAwNX1fUxNzPQoGb","type":"tool_result","content":"1\t\"\"\"Casting and resolution pipeline for spells and lands.\n2\t\n3\tProvides the full flow from casting a spell or playing a land through\n4\tresolution:\n5\t\n6\t- :func:`cast_spell` — verify timing & legality → move hand to stack →\n7\t  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n8\t- :func:`play_land` — verify land play remaining → move hand to\n9\t  battlefield → decrement ``land_plays_remaining``.\n10\t- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n11\t  helpers used by the casting pipeline.\n12\t\n13\tResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\n14\tcreated by :func:`cast_spell`:\n15\t\n16\t- Call ``card.on_resolve(game)``.\n17\t- Permanents (creature / enchantment / artifact / planeswalker) move from\n18\t  the stack to the battlefield.\n19\t- Non-permanents (instant / sorcery) move to the graveyard.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import TYPE_CHECKING, Any\n25\t\n26\tfrom engine.card import CardImpl\n27\tfrom engine.stack import StackObject\n28\tfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\n29\tfrom engine.zones import move_zone\n30\t\n31\tif TYPE_CHECKING:\n32\t    from engine.game_state import GameState\n33\t    from engine.player import Player\n34\t\n35\t\n36\t# Card types that represent permanents — these go to the battlefield on resolve.\n37\t_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n38\t    CardType.CREATURE,\n39\t    CardType.ENCHANTMENT,\n40\t    CardType.ARTIFACT,\n41\t    CardType.PLANESWALKER,\n42\t})\n43\t\n44\t\n45\tclass CastingError(Exception):\n46\t    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n47\t\n48\t\n49\t# ------------------------------------------------------------------\n50\t# Timing helpers\n51\t# ------------------------------------------------------------------\n52\t\n53\tdef is_sorcery_speed(game: GameState, player: Player) -> bool:\n54\t    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n55\t\n56\t    Sorcery speed requires all of:\n57\t\n58\t    * *player* is the active player.\n59\t    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n60\t      ``POSTCOMBAT_MAIN``).\n61\t    * The stack is empty.\n62\t    \"\"\"\n63\t    if player is not game.active_player:\n64\t        return False\n65\t    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n66\t        return False\n67\t    if not game.stack.is_empty():\n68\t        return False\n69\t    return True\n70\t\n71\t\n72\tdef can_cast_at_instant_speed(card: CardImpl) -> bool:\n73\t    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n74\t\n75\t    A card has instant-speed timing if it is an instant or has the\n76\t    :attr:`~engine.types.Keyword.FLASH` keyword.\n77\t    \"\"\"\n78\t    if CardType.INSTANT in card.card_types:\n79\t        return True\n80\t    if Keyword.FLASH & card.keywords:\n81\t        return True\n82\t    return False\n83\t\n84\t\n85\t# ------------------------------------------------------------------\n86\t# Cost reduction\n87\t# ------------------------------------------------------------------\n88\t\n89\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n90\t    \"\"\"Return the generic mana reduction for casting *card*.\n91\t\n92\t    Queries ``card.cost_reduction(game)`` and clamps the result so that\n93\t    the generic portion of the mana cost cannot go below 0.\n94\t\n95\t    This is a simplified single-card self-reduction model.  Full MTG\n96\t    cost-reduction interactions (Trinisphere, multiple reductions from\n97\t    different sources) are deferred.\n98\t    \"\"\"\n99\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n100\t    # casting player even when the card was never explicitly assigned one.\n101\t    prev_controller = card.controller\n102\t    card.controller = controller\n103\t    raw = card.cost_reduction(game)\n104\t    # Restore previous controller in case the caller doesn't want a\n105\t    # side-effect (get_cost_reduction is a query, not a mutation).\n106\t    card.controller = prev_controller\n107\t    # Add cost reductions granted by other permanents on the battlefield\n108\t    # (e.g. an effect that gives \"your instant and sorcery spells have\n109\t    # affinity for creatures\").\n110\t    raw += _external_cost_reduction(game, card, controller)\n111\t    generic = card.mana_cost.generic if card.mana_cost else 0\n112\t    return max(0, min(raw, generic))\n113\t\n114\t\n115\tdef _external_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n116\t    \"\"\"Sum generic cost reductions granted to *card* by other permanents.\n117\t\n118\t    A permanent grants an external reduction by implementing\n119\t    ``static_cost_reduction(game, spell, spell_controller) -> int``.  This\n120\t    lets one permanent reduce the cost of *other* spells (the self-only\n121\t    reduction lives on :meth:`CardImpl.cost_reduction`).\n122\t    \"\"\"\n123\t    total = 0\n124\t    for perm in game.get_battlefield(controller).get_all():\n125\t        if perm is card:\n126\t            continue\n127\t        hook = getattr(perm, \"static_cost_reduction\", None)\n128\t        if hook is None:\n129\t            continue\n130\t        amount = hook(game, card, controller)\n131\t        if amount:\n132\t            total += amount\n133\t    return total\n134\t\n135\t\n136\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n137\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n138\t    new_generic = max(0, cost.generic - reduction)\n139\t    return ManaCost(\n140\t        generic=new_generic,\n141\t        pips=dict(cost.pips),\n142\t        x_count=cost.x_count,\n143\t        hybrid=list(cost.hybrid),\n144\t    )\n145\t\n146\t\n147\t# ------------------------------------------------------------------\n148\t# Cast spell\n149\t# ------------------------------------------------------------------\n150\t\n151\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n152\t    \"\"\"Cast *card* from *player*'s hand.\n153\t\n154\t    Pipeline\n155\t    --------\n156\t    1. **Timing check** — instants (and cards with flash) can be cast\n157\t       whenever the player has priority; everything else requires\n158\t       sorcery-speed timing.\n159\t    2. **can_cast** — ask the card whether it can legally be cast.\n160\t    3. **Hand check** — the card must be in the player's hand.\n161\t    4. **Move hand → stack zone** — remove the card from the hand and\n162\t       place it into the player's stack zone.\n163\t    5. **Choose targets** — if the card specifies targets (via\n164\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n165\t    6. **Mana check / payment** — the player's mana pool must be able to\n166\t       pay the card's mana cost.  If payment fails, the card is rolled\n167\t       back from the stack zone to the hand.\n168\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n169\t    8. **Push StackObject** — push a :class:`StackObject` whose\n170\t       ``on_resolve`` callback handles resolution.\n171\t\n172\t    Raises:\n173\t        CastingError: If any legality check fails.\n174\t    \"\"\"\n175\t    # 1. Timing\n176\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n177\t        raise CastingError(\n178\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n179\t        )\n180\t\n181\t    # 2. can_cast\n182\t    if not card.can_cast(game):\n183\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n184\t\n185\t    # 3. Hand check\n186\t    hand = game.get_hand(player)\n187\t    if not hand.contains(card):\n188\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n189\t\n190\t    # 4. Move card from hand to stack zone\n191\t    stack_zone = player.zones[Zone.STACK]\n192\t    hand.remove(card)\n193\t    stack_zone.add(card)\n194\t\n195\t    # Clear any stale colors_spent from a prior cast before new payment.\n196\t    if hasattr(card, \"colors_spent\"):\n197\t        del card.colors_spent\n198\t\n199\t    # 5. Choose targets\n200\t    target_specs = card.get_targets(game)\n201\t    chosen_targets: list[Any] = []\n202\t    if target_specs:\n203\t        for spec in target_specs:\n204\t            target = player.choose_target(target_specs, spec)\n205\t            # Validate against filter_fn if the spec provides one\n206\t            filter_fn = getattr(spec, \"filter_fn\", None)\n207\t            if filter_fn is not None and target is not None:\n208\t                if not filter_fn(target):\n209\t                    stack_zone.remove(card)\n210\t                    hand.add(card)\n211\t                    raise CastingError(\n212\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n213\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n214\t                    )\n215\t            chosen_targets.append(target)\n216\t\n217\t    # 5b. Protection check — reject targets that have protection from this\n218\t    #     spell (the T in DEBT).\n219\t    from engine.protection import has_protection_from\n220\t\n221\t    for target in chosen_targets:\n222\t        if has_protection_from(target, card):\n223\t            # Rollback: move card from stack zone back to hand\n224\t            stack_zone.remove(card)\n225\t            hand.add(card)\n226\t            raise CastingError(\n227\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n228\t            )\n229\t\n230\t    # Targets are stored on the StackObject (not the card) and passed\n231\t    # through the resolve pipeline via on_resolve(game, targets=...).\n232\t\n233\t    # 6. Mana check / payment (rollback on failure)\n234\t    # Ensure the card knows its controller so that cost_reduction() hooks\n235\t    # (e.g. Embercleave counting attacking creatures you control) see the\n236\t    # casting player, even for cards that were added to hand without an\n237\t    # explicit controller assignment.\n238\t    if card.controller is None:\n239\t        card.controller = player\n240\t    reduction = get_cost_reduction(game, card, player)\n241\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n242\t\n243\t    if not player.mana_pool.can_pay(effective_cost):\n244\t        # Rollback: move card from stack zone back to hand\n245\t        stack_zone.remove(card)\n246\t        hand.add(card)\n247\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n248\t\n249\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n250\t    player.mana_pool.pay(effective_cost)\n251\t\n252\t    # Store colors of mana spent on the card for mechanics like Converge\n253\t    # that care about the colors used to cast the spell.\n254\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n255\t    # Store the total mana spent for mechanics that add mana \"equal to the\n256\t    # mana spent to cast it\" (e.g. Mana Sculpt).\n257\t    card.mana_spent = player.mana_pool.last_payment_total  # type: ignore[attr-defined]\n258\t\n259\t    # 7. Call on_cast hook\n260\t    card.on_cast(game)\n261\t\n262\t    # 8. Build on_resolve callback and push StackObject\n263\t    stack_obj = StackObject(\n264\t        source=card,\n265\t        controller=player,\n266\t        targets=chosen_targets,\n267\t        on_resolve=lambda g: None,  # replaced below\n268\t    )\n269\t\n270\t    def _on_resolve(g: GameState) -> None:\n271\t        _resolve_spell(g, card, player, stack_obj)\n272\t\n273\t    stack_obj.on_resolve = _on_resolve\n274\t    game.stack.push(stack_obj)\n275\t\n276\t    # 9. Fire \"whenever you cast ...\" triggers.  The spell is now on the\n277\t    # stack; any triggers go on top of it (resolving before the spell).\n278\t    _fire_spell_cast(game, card, player)\n279\t\n280\t\n281\t# ------------------------------------------------------------------\n282\t# Cast spell without paying mana cost (free-cast from any zone)\n283\t# ------------------------------------------------------------------\n284\t\n285\t\n286\tdef cast_spell_free(\n287\t    game: GameState,\n288\t    player: Player,\n289\t    card: CardImpl,\n290\t    from_zone: Zone,\n291\t) -> None:\n292\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n293\t\n294\t    This is used by effects that allow casting from zones other than hand\n295\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n296\t    or cascade.\n297\t\n298\t    Pipeline\n299\t    --------\n300\t    1. **can_cast** — ask the card whether it can legally be cast (same\n301\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n302\t    2. Move *card* from *from_zone* to the stack zone.\n303\t    3. Choose targets (if applicable) with validation and protection check.\n304\t    4. Call ``on_cast`` hook.\n305\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n306\t       resolution normally (permanents → battlefield, non-permanents →\n307\t       graveyard).\n308\t\n309\t    No timing check or mana payment is performed.  The spell goes on the\n310\t    stack and can be responded to normally (e.g. countered).\n311\t\n312\t    If targeting or other post-move checks fail, the card is rolled back\n313\t    to its source zone.\n314\t\n315\t    Parameters:\n316\t        game: The current game state.\n317\t        player: The player casting the spell.\n318\t        card: The card to cast.\n319\t        from_zone: The zone the card is currently in.\n320\t\n321\t    Raises:\n322\t        CastingError: If the card cannot be found in *from_zone* or\n323\t            legality checks fail.\n324\t    \"\"\"\n325\t    from engine.zones import move_to_zone\n326\t\n327\t    # Ensure controller is set\n328\t    card.controller = player\n329\t    if card.owner is None:\n330\t        card.owner = player\n331\t\n332\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n333\t    if not card.can_cast(game):\n334\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n335\t\n336\t    # 2. Locate card in source zone\n337\t    source_zone_container = player.zones[from_zone]\n338\t    if not source_zone_container.contains(card):\n339\t        # Try to find the card in any player's zone\n340\t        source_zone_container = None\n341\t        for p in game.players:\n342\t            z = p.zones[from_zone]\n343\t            if z.contains(card):\n344\t                source_zone_container = z\n345\t                break\n346\t\n347\t    if source_zone_container is None or not source_zone_container.contains(card):\n348\t        raise CastingError(\n349\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n350\t        )\n351\t\n352\t    # Move card from source zone to stack zone\n353\t    stack_zone = player.zones[Zone.STACK]\n354\t    source_zone_container.remove(card)\n355\t    stack_zone.add(card)\n356\t\n357\t    # 3. Choose targets (with rollback on failure)\n358\t    try:\n359\t        target_specs = card.get_targets(game)\n360\t        chosen_targets: list[Any] = []\n361\t        if target_specs:\n362\t            for spec in target_specs:\n363\t                target = player.choose_target(target_specs, spec)\n364\t                # Validate against filter_fn if the spec provides one\n365\t                filter_fn = getattr(spec, \"filter_fn\", None)\n366\t                if filter_fn is not None and target is not None:\n367\t                    if not filter_fn(target):\n368\t                        raise CastingError(\n369\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n370\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n371\t                        )\n372\t                chosen_targets.append(target)\n373\t\n374\t        # Protection check — reject targets that have protection from this spell\n375\t        from engine.protection import has_protection_from\n376\t\n377\t        for target in chosen_targets:\n378\t            if has_protection_from(target, card):\n379\t                raise CastingError(\n380\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n381\t                )\n382\t    except Exception as exc:\n383\t        # Rollback: move card from stack zone back to source zone\n384\t        stack_zone.remove(card)\n385\t        source_zone_container.add(card)\n386\t        raise CastingError(str(exc)) from exc\n387\t\n388\t    # No mana was paid for a free cast.\n389\t    card.mana_spent = 0  # type: ignore[attr-defined]\n390\t\n391\t    # 4. Call on_cast hook\n392\t    card.on_cast(game)\n393\t\n394\t    # 5. Build on_resolve callback and push StackObject\n395\t    stack_obj = StackObject(\n396\t        source=card,\n397\t        controller=player,\n398\t        targets=chosen_targets,\n399\t        on_resolve=lambda g: None,  # replaced below\n400\t    )\n401\t\n402\t    def _on_resolve(g: GameState) -> None:\n403\t        _resolve_spell(g, card, player, stack_obj)\n404\t\n405\t    stack_obj.on_resolve = _on_resolve\n406\t    game.stack.push(stack_obj)\n407\t\n408\t    # 6. Fire \"whenever you cast ...\" triggers (free casting is still casting).\n409\t    _fire_spell_cast(game, card, player)\n410\t\n411\t\n412\t# ------------------------------------------------------------------\n413\t# Spell-cast trigger helper\n414\t# ------------------------------------------------------------------\n415\t\n416\tdef _fire_spell_cast(game: GameState, card: CardImpl, player: Player) -> None:\n417\t    \"\"\"Fire a :class:`SpellCastTriggeredEvent` for *card* cast by *player*.\n418\t\n419\t    Triggers that watch for \"whenever you cast ...\" self-guard on their\n420\t    own source being on the battlefield, so firing globally is safe.\n421\t    \"\"\"\n422\t    from engine.events import SpellCastTriggeredEvent\n423\t\n424\t    game.trigger_manager.fire_event(\n425\t        game,\n426\t        SpellCastTriggeredEvent(\n427\t            spell=card, player=player, card=card, controller=player\n428\t        ),\n429\t    )\n430\t\n431\t\n432\t# ------------------------------------------------------------------\n433\t# Resolution (called when the stack pops)\n434\t# ------------------------------------------------------------------\n435\t\n436\tdef _resolve_spell(\n437\t    game: GameState,\n438\t    card: CardImpl,\n439\t    player: Player,\n440\t    stack_obj: StackObject,\n441\t) -> None:\n442\t    \"\"\"Resolve *card* cast by *player*.\n443\t\n444\t    1. Call ``card.on_resolve(game, targets=targets)``.\n445\t    2. Remove the card from the stack zone.\n446\t    3. If the card is a permanent type, move it to the battlefield via\n447\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n448\t       registration and the ETB event).\n449\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n450\t    \"\"\"\n451\t    from engine.zones import move_to_zone\n452\t\n453\t    # Read targets from the StackObject — the single source of truth.\n454\t    # Set chosen_targets on the card just before resolution so that\n455\t    # _get_chosen_target helpers (which read via getattr) work.\n456\t    targets = stack_obj.targets\n457\t    if targets is not None:\n458\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n459\t\n460\t    card.on_resolve(game)\n461\t\n462\t    if card.card_types & _PERMANENT_TYPES:\n463\t        # Move from stack to battlefield via move_to_zone, which handles\n464\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n465\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n466\t    elif getattr(card, \"_exile_instead_of_graveyard\", False):\n467\t        # Replacement effect: \"if this spell would be put into your\n468\t        # graveyard, exile it instead\" (e.g. The Dawning Archaic, Paradigm).\n469\t        card._exile_instead_of_graveyard = False\n470\t        move_to_zone(game, card, Zone.STACK, Zone.EXILE)\n471\t    else:\n472\t        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n473\t        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n474\t\n475\t\n476\t# ------------------------------------------------------------------\n477\t# Play land (special action — does not use the stack)\n478\t# ------------------------------------------------------------------\n479\t\n480\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n481\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n482\t\n483\t    Requirements (all must hold):\n484\t\n485\t    * *land_card* has :attr:`CardType.LAND`.\n486\t    * *player* is the active player.\n487\t    * Current phase is a main phase.\n488\t    * The stack is empty.\n489\t    * ``player.land_plays_remaining > 0``.\n490\t    * The card is in the player's hand.\n491\t\n492\t    On success the card moves from hand to battlefield and\n493\t    ``land_plays_remaining`` is decremented.\n494\t\n495\t    Raises:\n496\t        CastingError: If any requirement is not met.\n497\t    \"\"\"\n498\t    # Must be a land\n499\t    if CardType.LAND not in land_card.card_types:\n500\t        raise CastingError(\n501\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n502\t        )\n503\t\n504\t    # Sorcery-speed timing (active player, main phase, stack empty)\n505\t    if not is_sorcery_speed(game, player):\n506\t        raise CastingError(\n507\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n508\t            \"during main phase with empty stack\"\n509\t        )\n510\t\n511\t    # Land plays remaining\n512\t    if player.land_plays_remaining <= 0:\n513\t        raise CastingError(\n514\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n515\t        )\n516\t\n517\t    # Card must be in hand\n518\t    hand = game.get_hand(player)\n519\t    if not hand.contains(land_card):\n520\t        raise CastingError(\n521\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n522\t        )\n523\t\n524\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n525\t    if land_card.owner is None:\n526\t        land_card.owner = player\n527\t    land_card.controller = player\n528\t\n529\t    # Move from hand to battlefield via move_to_zone, which fires\n530\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n531\t    from engine.zones import move_to_zone\n532\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n533\t\n534\t    # Decrement land plays\n535\t    player.land_plays_remaining -= 1\n536\t\n537\t\n538\tdef resolve_top(game: GameState) -> None:\n539\t    \"\"\"Resolve the top spell/ability on the stack.\n540\t\n541\t    Pops the top item from the stack, calls its on_resolve callback,\n542\t    then runs state-based actions.  If the stack is empty this is a no-op.\n543\t    \"\"\"\n544\t    if game.stack.is_empty():\n545\t        return\n546\t    from engine.state_based_actions import resolve_state_based_actions\n547\t\n548\t    obj = game.stack.pop()\n549\t    obj.on_resolve(game)\n550\t    resolve_state_based_actions(game)\n551\t"}]},"parent_tool_use_id":null,"session_id":"7182fe58-6bea-420a-b90d-6a2af4b380c1","uuid":"521b4b8e-d60a-40c5-b00d-5befcb294c39","timestamp":"2026-05-30T08:16:56.427Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"\"\"\"Casting and resolution pipeline for spells and lands.\n\nProvides the full flow from casting a spell or playing a land through\nresolution:\n\n- :func:`cast_spell` — verify timing & legality → move hand to stack →\n  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n- :func:`play_land` — verify land play remaining → move hand to\n  battlefield → decrement ``land_plays_remaining``.\n- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n  helpers used by the casting pipeline.\n\nResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\ncreated by :func:`cast_spell`:\n\n- Call ``card.on_resolve(game)``.\n- Permanents (creature / enchantment / artifact / planeswalker) move from\n  the stack to the battlefield.\n- Non-permanents (instant / sorcery) move to the graveyard.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import CardImpl\nfrom engine.stack import StackObject\nfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\nfrom engine.zones import move_zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n# Card types that represent permanents — these go to the battlefield on resolve.\n_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n    CardType.CREATURE,\n    CardType.ENCHANTMENT,\n    CardType.ARTIFACT,\n    CardType.PLANESWALKER,\n})\n\n\nclass CastingError(Exception):\n    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n\n\n# ------------------------------------------------------------------\n# Timing helpers\n# ------------------------------------------------------------------\n\ndef is_sorcery_speed(game: GameState, player: Player) -> bool:\n    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n\n    Sorcery speed requires all of:\n\n    * *player* is the active player.\n    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n      ``POSTCOMBAT_MAIN``).\n    * The stack is empty.\n    \"\"\"\n    if player is not game.active_player:\n        return False\n    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n        return False\n    if not game.stack.is_empty():\n        return False\n    return True\n\n\ndef can_cast_at_instant_speed(card: CardImpl) -> bool:\n    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n\n    A card has instant-speed timing if it is an instant or has the\n    :attr:`~engine.types.Keyword.FLASH` keyword.\n    \"\"\"\n    if CardType.INSTANT in card.card_types:\n        return True\n    if Keyword.FLASH & card.keywords:\n        return True\n    return False\n\n\n# ------------------------------------------------------------------\n# Cost reduction\n# ------------------------------------------------------------------\n\ndef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n    \"\"\"Return the generic mana reduction for casting *card*.\n\n    Queries ``card.cost_reduction(game)`` and clamps the result so that\n    the generic portion of the mana cost cannot go below 0.\n\n    This is a simplified single-card self-reduction model.  Full MTG\n    cost-reduction interactions (Trinisphere, multiple reductions from\n    different sources) are deferred.\n    \"\"\"\n    # Ensure card.controller is set so the hook can reference \"you\" / the\n    # casting player even when the card was never explicitly assigned one.\n    prev_controller = card.controller\n    card.controller = controller\n    raw = card.cost_reduction(game)\n    # Restore previous controller in case the caller doesn't want a\n    # side-effect (get_cost_reduction is a query, not a mutation).\n    card.controller = prev_controller\n    # Add cost reductions granted by other permanents on the battlefield\n    # (e.g. an effect that gives \"your instant and sorcery spells have\n    # affinity for creatures\").\n    raw += _external_cost_reduction(game, card, controller)\n    generic = card.mana_cost.generic if card.mana_cost else 0\n    return max(0, min(raw, generic))\n\n\ndef _external_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n    \"\"\"Sum generic cost reductions granted to *card* by other permanents.\n\n    A permanent grants an external reduction by implementing\n    ``static_cost_reduction(game, spell, spell_controller) -> int``.  This\n    lets one permanent reduce the cost of *other* spells (the self-only\n    reduction lives on :meth:`CardImpl.cost_reduction`).\n    \"\"\"\n    total = 0\n    for perm in game.get_battlefield(controller).get_all():\n        if perm is card:\n            continue\n        hook = getattr(perm, \"static_cost_reduction\", None)\n        if hook is None:\n            continue\n        amount = hook(game, card, controller)\n        if amount:\n            total += amount\n    return total\n\n\ndef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n    new_generic = max(0, cost.generic - reduction)\n    return ManaCost(\n        generic=new_generic,\n        pips=dict(cost.pips),\n        x_count=cost.x_count,\n        hybrid=list(cost.hybrid),\n    )\n\n\n# ------------------------------------------------------------------\n# Cast spell\n# ------------------------------------------------------------------\n\ndef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n    \"\"\"Cast *card* from *player*'s hand.\n\n    Pipeline\n    --------\n    1. **Timing check** — instants (and cards with flash) can be cast\n       whenever the player has priority; everything else requires\n       sorcery-speed timing.\n    2. **can_cast** — ask the card whether it can legally be cast.\n    3. **Hand check** — the card must be in the player's hand.\n    4. **Move hand → stack zone** — remove the card from the hand and\n       place it into the player's stack zone.\n    5. **Choose targets** — if the card specifies targets (via\n       :meth:`CardImpl.get_targets`), the player is asked to choose.\n    6. **Mana check / payment** — the player's mana pool must be able to\n       pay the card's mana cost.  If payment fails, the card is rolled\n       back from the stack zone to the hand.\n    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n    8. **Push StackObject** — push a :class:`StackObject` whose\n       ``on_resolve`` callback handles resolution.\n\n    Raises:\n        CastingError: If any legality check fails.\n    \"\"\"\n    # 1. Timing\n    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n        )\n\n    # 2. can_cast\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 3. Hand check\n    hand = game.get_hand(player)\n    if not hand.contains(card):\n        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n\n    # 4. Move card from hand to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    hand.remove(card)\n    stack_zone.add(card)\n\n    # Clear any stale colors_spent from a prior cast before new payment.\n    if hasattr(card, \"colors_spent\"):\n        del card.colors_spent\n\n    # 5. Choose targets\n    target_specs = card.get_targets(game)\n    chosen_targets: list[Any] = []\n    if target_specs:\n        for spec in target_specs:\n            target = player.choose_target(target_specs, spec)\n            # Validate against filter_fn if the spec provides one\n            filter_fn = getattr(spec, \"filter_fn\", None)\n            if filter_fn is not None and target is not None:\n                if not filter_fn(target):\n                    stack_zone.remove(card)\n                    hand.add(card)\n                    raise CastingError(\n                        f\"Cannot cast {card.name!r} — chosen target does not \"\n                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                    )\n            chosen_targets.append(target)\n\n    # 5b. Protection check — reject targets that have protection from this\n    #     spell (the T in DEBT).\n    from engine.protection import has_protection_from\n\n    for target in chosen_targets:\n        if has_protection_from(target, card):\n            # Rollback: move card from stack zone back to hand\n            stack_zone.remove(card)\n            hand.add(card)\n            raise CastingError(\n                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n            )\n\n    # Targets are stored on the StackObject (not the card) and passed\n    # through the resolve pipeline via on_resolve(game, targets=...).\n\n    # 6. Mana check / payment (rollback on failure)\n    # Ensure the card knows its controller so that cost_reduction() hooks\n    # (e.g. Embercleave counting attacking creatures you control) see the\n    # casting player, even for cards that were added to hand without an\n    # explicit controller assignment.\n    if card.controller is None:\n        card.controller = player\n    reduction = get_cost_reduction(game, card, player)\n    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n\n    if not player.mana_pool.can_pay(effective_cost):\n        # Rollback: move card from stack zone back to hand\n        stack_zone.remove(card)\n        hand.add(card)\n        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n\n    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n    player.mana_pool.pay(effective_cost)\n\n    # Store colors of mana spent on the card for mechanics like Converge\n    # that care about the colors used to cast the spell.\n    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n    # Store the total mana spent for mechanics that add mana \"equal to the\n    # mana spent to cast it\" (e.g. Mana Sculpt).\n    card.mana_spent = player.mana_pool.last_payment_total  # type: ignore[attr-defined]\n\n    # 7. Call on_cast hook\n    card.on_cast(game)\n\n    # 8. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n    # 9. Fire \"whenever you cast ...\" triggers.  The spell is now on the\n    # stack; any triggers go on top of it (resolving before the spell).\n    _fire_spell_cast(game, card, player)\n\n\n# ------------------------------------------------------------------\n# Cast spell without paying mana cost (free-cast from any zone)\n# ------------------------------------------------------------------\n\n\ndef cast_spell_free(\n    game: GameState,\n    player: Player,\n    card: CardImpl,\n    from_zone: Zone,\n) -> None:\n    \"\"\"Cast *card* without paying its mana cost, using the stack.\n\n    This is used by effects that allow casting from zones other than hand\n    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n    or cascade.\n\n    Pipeline\n    --------\n    1. **can_cast** — ask the card whether it can legally be cast (same\n       legality as :func:`cast_spell`, minus mana/timing constraints).\n    2. Move *card* from *from_zone* to the stack zone.\n    3. Choose targets (if applicable) with validation and protection check.\n    4. Call ``on_cast`` hook.\n    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n       resolution normally (permanents → battlefield, non-permanents →\n       graveyard).\n\n    No timing check or mana payment is performed.  The spell goes on the\n    stack and can be responded to normally (e.g. countered).\n\n    If targeting or other post-move checks fail, the card is rolled back\n    to its source zone.\n\n    Parameters:\n        game: The current game state.\n        player: The player casting the spell.\n        card: The card to cast.\n        from_zone: The zone the card is currently in.\n\n    Raises:\n        CastingError: If the card cannot be found in *from_zone* or\n            legality checks fail.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Ensure controller is set\n    card.controller = player\n    if card.owner is None:\n        card.owner = player\n\n    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 2. Locate card in source zone\n    source_zone_container = player.zones[from_zone]\n    if not source_zone_container.contains(card):\n        # Try to find the card in any player's zone\n        source_zone_container = None\n        for p in game.players:\n            z = p.zones[from_zone]\n            if z.contains(card):\n                source_zone_container = z\n                break\n\n    if source_zone_container is None or not source_zone_container.contains(card):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n        )\n\n    # Move card from source zone to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    source_zone_container.remove(card)\n    stack_zone.add(card)\n\n    # 3. Choose targets (with rollback on failure)\n    try:\n        target_specs = card.get_targets(game)\n        chosen_targets: list[Any] = []\n        if target_specs:\n            for spec in target_specs:\n                target = player.choose_target(target_specs, spec)\n                # Validate against filter_fn if the spec provides one\n                filter_fn = getattr(spec, \"filter_fn\", None)\n                if filter_fn is not None and target is not None:\n                    if not filter_fn(target):\n                        raise CastingError(\n                            f\"Cannot cast {card.name!r} — chosen target does not \"\n                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                        )\n                chosen_targets.append(target)\n\n        # Protection check — reject targets that have protection from this spell\n        from engine.protection import has_protection_from\n\n        for target in chosen_targets:\n            if has_protection_from(target, card):\n                raise CastingError(\n                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n                )\n    except Exception as exc:\n        # Rollback: move card from stack zone back to source zone\n        stack_zone.remove(card)\n        source_zone_container.add(card)\n        raise CastingError(str(exc)) from exc\n\n    # No mana was paid for a free cast.\n    card.mana_spent = 0  # type: ignore[attr-defined]\n\n    # 4. Call on_cast hook\n    card.on_cast(game)\n\n    # 5. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n    # 6. Fire \"whenever you cast ...\" triggers (free casting is still casting).\n    _fire_spell_cast(game, card, player)\n\n\n# ------------------------------------------------------------------\n# Spell-cast trigger helper\n# ------------------------------------------------------------------\n\ndef _fire_spell_cast(game: GameState, card: CardImpl, player: Player) -> None:\n    \"\"\"Fire a :class:`SpellCastTriggeredEvent` for *card* cast by *player*.\n\n    Triggers that watch for \"whenever you cast ...\" self-guard on their\n    own source being on the battlefield, so firing globally is safe.\n    \"\"\"\n    from engine.events import SpellCastTriggeredEvent\n\n    game.trigger_manager.fire_event(\n        game,\n        SpellCastTriggeredEvent(\n            spell=card, player=player, card=card, controller=player\n        ),\n    )\n\n\n# ------------------------------------------------------------------\n# Resolution (called when the stack pops)\n# ------------------------------------------------------------------\n\ndef _resolve_spell(\n    game: GameState,\n    card: CardImpl,\n    player: Player,\n    stack_obj: StackObject,\n) -> None:\n    \"\"\"Resolve *card* cast by *player*.\n\n    1. Call ``card.on_resolve(game, targets=targets)``.\n    2. Remove the card from the stack zone.\n    3. If the card is a permanent type, move it to the battlefield via\n       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n       registration and the ETB event).\n    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Read targets from the StackObject — the single source of truth.\n    # Set chosen_targets on the card just before resolution so that\n    # _get_chosen_target helpers (which read via getattr) work.\n    targets = stack_obj.targets\n    if targets is not None:\n        card.chosen_targets = targets  # type: ignore[attr-defined]\n\n    card.on_resolve(game)\n\n    if card.card_types & _PERMANENT_TYPES:\n        # Move from stack to battlefield via move_to_zone, which handles\n        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n    elif getattr(card, \"_exile_instead_of_graveyard\", False):\n        # Replacement effect: \"if this spell would be put into your\n        # graveyard, exile it instead\" (e.g. The Dawning Archaic, Paradigm).\n        card._exile_instead_of_graveyard = False\n        move_to_zone(game, card, Zone.STACK, Zone.EXILE)\n    else:\n        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n\n\n# ------------------------------------------------------------------\n# Play land (special action — does not use the stack)\n# ------------------------------------------------------------------\n\ndef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n\n    Requirements (all must hold):\n\n    * *land_card* has :attr:`CardType.LAND`.\n    * *player* is the active player.\n    * Current phase is a main phase.\n    * The stack is empty.\n    * ``player.land_plays_remaining > 0``.\n    * The card is in the player's hand.\n\n    On success the card moves from hand to battlefield and\n    ``land_plays_remaining`` is decremented.\n\n    Raises:\n        CastingError: If any requirement is not met.\n    \"\"\"\n    # Must be a land\n    if CardType.LAND not in land_card.card_types:\n        raise CastingError(\n            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n        )\n\n    # Sorcery-speed timing (active player, main phase, stack empty)\n    if not is_sorcery_speed(game, player):\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — must be active player \"\n            \"during main phase with empty stack\"\n        )\n\n    # Land plays remaining\n    if player.land_plays_remaining <= 0:\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n        )\n\n    # Card must be in hand\n    hand = game.get_hand(player)\n    if not hand.contains(land_card):\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — card not in hand\"\n        )\n\n    # Ensure owner/controller are set so move_to_zone routes correctly.\n    if land_card.owner is None:\n        land_card.owner = player\n    land_card.controller = player\n\n    # Move from hand to battlefield via move_to_zone, which fires\n    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n    from engine.zones import move_to_zone\n    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n\n    # Decrement land plays\n    player.land_plays_remaining -= 1\n\n\ndef resolve_top(game: GameState) -> None:\n    \"\"\"Resolve the top spell/ability on the stack.\n\n    Pops the top item from the stack, calls its on_resolve callback,\n    then runs state-based actions.  If the stack is empty this is a no-op.\n    \"\"\"\n    if game.stack.is_empty():\n        return\n    from engine.state_based_actions import resolve_state_based_actions\n\n    obj = game.stack.pop()\n    obj.on_resolve(game)\n    resolve_state_based_actions(game)\n","numLines":551,"startLine":1,"totalLines":551}}}
