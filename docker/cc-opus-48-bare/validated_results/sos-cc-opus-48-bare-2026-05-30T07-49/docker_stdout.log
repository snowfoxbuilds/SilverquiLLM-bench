{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XyiY1werayi6T8EE3urcGg","type":"tool_result","content":"315\t    Parameters:\n316\t        game: The current game state.\n317\t        player: The player casting the spell.\n318\t        card: The card to cast.\n319\t        from_zone: The zone the card is currently in.\n320\t\n321\t    Raises:\n322\t        CastingError: If the card cannot be found in *from_zone* or\n323\t            legality checks fail.\n324\t    \"\"\"\n325\t    from engine.zones import move_to_zone\n326\t\n327\t    # Ensure controller is set\n328\t    card.controller = player\n329\t    if card.owner is None:\n330\t        card.owner = player\n331\t\n332\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n333\t    if not card.can_cast(game):\n334\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n335\t\n336\t    # 2. Locate card in source zone\n337\t    source_zone_container = player.zones[from_zone]\n338\t    if not source_zone_container.contains(card):\n339\t        # Try to find the card in any player's zone\n340\t        source_zone_container = None\n341\t        for p in game.players:\n342\t            z = p.zones[from_zone]\n343\t            if z.contains(card):\n344\t                source_zone_container = z\n345\t                break\n346\t\n347\t    if source_zone_container is None or not source_zone_container.contains(card):\n348\t        raise CastingError(\n349\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n350\t        )\n351\t\n352\t    # Move card from source zone to stack zone\n353\t    stack_zone = player.zones[Zone.STACK]\n354\t    source_zone_container.remove(card)\n355\t    stack_zone.add(card)\n356\t\n357\t    # 3. Choose targets (with rollback on failure)\n358\t    try:\n359\t        target_specs = card.get_targets(game)\n360\t        chosen_targets: list[Any] = []\n361\t        if target_specs:\n362\t            for spec in target_specs:\n363\t                target = player.choose_target(target_specs, spec)\n364\t                # Validate against filter_fn if the spec provides one\n365\t                filter_fn = getattr(spec, \"filter_fn\", None)\n366\t                if filter_fn is not None and target is not None:\n367\t                    if not filter_fn(target):\n368\t                        raise CastingError(\n369\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n370\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n371\t                        )\n372\t                chosen_targets.append(target)\n373\t\n374\t        # Protection check — reject targets that have protection from this spell\n375\t        from engine.protection import has_protection_from\n376\t\n377\t        for target in chosen_targets:\n378\t            if has_protection_from(target, card):\n379\t                raise CastingError(\n380\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n381\t                )\n382\t    except Exception as exc:\n383\t        # Rollback: move card from stack zone back to source zone\n384\t        stack_zone.remove(card)\n385\t        source_zone_container.add(card)\n386\t        raise CastingError(str(exc)) from exc\n387\t\n388\t    # No mana was paid for a free cast.\n389\t    card.mana_spent = 0  # type: ignore[attr-defined]\n390\t\n391\t    # 4. Call on_cast hook\n392\t    card.on_cast(game)\n393\t\n394\t    # 5. Build on_resolve callback and push StackObject\n395\t    stack_obj = StackObject(\n396\t        source=card,\n397\t        controller=player,\n398\t        targets=chosen_targets,\n399\t        on_resolve=lambda g: None,  # replaced below\n400\t    )\n401\t\n402\t    def _on_resolve(g: GameState) -> None:\n403\t        _resolve_spell(g, card, player, stack_obj)\n404\t\n405\t    stack_obj.on_resolve = _on_resolve\n406\t    game.stack.push(stack_obj)\n407\t\n408\t    # 6. Fire \"whenever you cast ...\" triggers (free casting is still casting).\n409\t    _fire_spell_cast(game, card, player)\n410\t\n411\t\n412\t# ------------------------------------------------------------------\n413\t# Spell-cast trigger helper\n414\t# ------------------------------------------------------------------\n415\t\n416\tdef _fire_spell_cast(game: GameState, card: CardImpl, player: Player) -> None:\n417\t    \"\"\"Fire a :class:`SpellCastTriggeredEvent` for *card* cast by *player*.\n418\t\n419\t    Triggers that watch for \"whenever you cast ...\" self-guard on their\n420\t    own source being on the battlefield, so firing globally is safe.\n421\t    \"\"\"\n422\t    from engine.events import SpellCastTriggeredEvent\n423\t\n424\t    game.trigger_manager.fire_event(\n425\t        game,\n426\t        SpellCastTriggeredEvent(\n427\t            spell=card, player=player, card=card, controller=player\n428\t        ),\n429\t    )\n430\t\n431\t\n432\t# ------------------------------------------------------------------\n433\t# Resolution (called when the stack pops)\n434\t# ------------------------------------------------------------------"}]},"parent_tool_use_id":null,"session_id":"7182fe58-6bea-420a-b90d-6a2af4b380c1","uuid":"4443b0ec-3b28-4c58-86d8-e7f0cdf76a00","timestamp":"2026-05-30T08:31:14.319Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"    Parameters:\n        game: The current game state.\n        player: The player casting the spell.\n        card: The card to cast.\n        from_zone: The zone the card is currently in.\n\n    Raises:\n        CastingError: If the card cannot be found in *from_zone* or\n            legality checks fail.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Ensure controller is set\n    card.controller = player\n    if card.owner is None:\n        card.owner = player\n\n    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 2. Locate card in source zone\n    source_zone_container = player.zones[from_zone]\n    if not source_zone_container.contains(card):\n        # Try to find the card in any player's zone\n        source_zone_container = None\n        for p in game.players:\n            z = p.zones[from_zone]\n            if z.contains(card):\n                source_zone_container = z\n                break\n\n    if source_zone_container is None or not source_zone_container.contains(card):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n        )\n\n    # Move card from source zone to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    source_zone_container.remove(card)\n    stack_zone.add(card)\n\n    # 3. Choose targets (with rollback on failure)\n    try:\n        target_specs = card.get_targets(game)\n        chosen_targets: list[Any] = []\n        if target_specs:\n            for spec in target_specs:\n                target = player.choose_target(target_specs, spec)\n                # Validate against filter_fn if the spec provides one\n                filter_fn = getattr(spec, \"filter_fn\", None)\n                if filter_fn is not None and target is not None:\n                    if not filter_fn(target):\n                        raise CastingError(\n                            f\"Cannot cast {card.name!r} — chosen target does not \"\n                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                        )\n                chosen_targets.append(target)\n\n        # Protection check — reject targets that have protection from this spell\n        from engine.protection import has_protection_from\n\n        for target in chosen_targets:\n            if has_protection_from(target, card):\n                raise CastingError(\n                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n                )\n    except Exception as exc:\n        # Rollback: move card from stack zone back to source zone\n        stack_zone.remove(card)\n        source_zone_container.add(card)\n        raise CastingError(str(exc)) from exc\n\n    # No mana was paid for a free cast.\n    card.mana_spent = 0  # type: ignore[attr-defined]\n\n    # 4. Call on_cast hook\n    card.on_cast(game)\n\n    # 5. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n    # 6. Fire \"whenever you cast ...\" triggers (free casting is still casting).\n    _fire_spell_cast(game, card, player)\n\n\n# ------------------------------------------------------------------\n# Spell-cast trigger helper\n# ------------------------------------------------------------------\n\ndef _fire_spell_cast(game: GameState, card: CardImpl, player: Player) -> None:\n    \"\"\"Fire a :class:`SpellCastTriggeredEvent` for *card* cast by *player*.\n\n    Triggers that watch for \"whenever you cast ...\" self-guard on their\n    own source being on the battlefield, so firing globally is safe.\n    \"\"\"\n    from engine.events import SpellCastTriggeredEvent\n\n    game.trigger_manager.fire_event(\n        game,\n        SpellCastTriggeredEvent(\n            spell=card, player=player, card=card, controller=player\n        ),\n    )\n\n\n# ------------------------------------------------------------------\n# Resolution (called when the stack pops)\n# ------------------------------------------------------------------","numLines":120,"startLine":315,"totalLines":551}}}
