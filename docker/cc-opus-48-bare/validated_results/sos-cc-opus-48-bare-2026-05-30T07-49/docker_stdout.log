reature=attacker, attacker=attacker)\n270\t            )\n271\t\n272\t\n273\tdef declare_blockers_step(game: GameState) -> None:\n274\t    \"\"\"Declare blockers step: defending player assigns blockers.\n275\t\n276\t    The defending player is asked (via :meth:`Player.choose`) to assign\n277\t    blockers.  The expected format is a dict mapping blocker → attacker\n278\t    (or blocker → list of attackers for multi-blocking scenarios), but\n279\t    commonly blocker → attacker.\n280\t\n281\t    After blockers are assigned:\n282\t    - Menace check: attackers with menace must be blocked by 2+ creatures.\n283\t    - Flying/reach check is already handled by ``_can_block``.\n284\t    - The attacking player orders blockers for each attacker (for damage\n285\t      assignment).\n286\t\n287\t    Parameters:\n288\t        game: The current game state.\n289\t    \"\"\"\n290\t    combat = game.combat_state\n291\t\n292\t    if not combat.attackers:\n293\t        return\n294\t\n295\t    defending = game.non_active_player\n296\t    active = game.active_player\n297\t\n298\t    from engine.types import Zone\n299\t    bf_defending = defending.zones[Zone.BATTLEFIELD]\n300\t    eligible_blockers = [\n301\t        c for c in bf_defending.get_all()\n302\t        if hasattr(c, \"base_power\") and not getattr(c, \"is_tapped\", False)\n303\t    ]\n304\t\n305\t    if not eligible_blockers:\n306\t        return\n307\t\n308\t    # Defending player chooses block assignments\n309\t    # Expected format: dict mapping blocker → attacker (or list of attackers)"}]},"parent_tool_use_id":null,"session_id":"7182fe58-6bea-420a-b90d-6a2af4b380c1","uuid":"e0e7ed77-0ac0-4596-9df8-d10b0514e34d","timestamp":"2026-05-30T08:32:27.422Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/combat.py","content":"    active = game.active_player\n    defending = game.non_active_player\n\n    # Gather legal attackers from the active player's battlefield\n    from engine.types import Zone\n    bf = active.zones[Zone.BATTLEFIELD]\n    eligible = [\n        c for c in bf.get_all()\n        if hasattr(c, \"base_power\") and _can_attack(c)\n    ]\n\n    if not eligible:\n        return\n\n    # Active player chooses which creatures to attack with\n    chosen = active.choose(eligible, \"declare attackers\")\n\n    # Normalize to a list\n    if chosen is None:\n        return\n    if not isinstance(chosen, list):\n        chosen = [chosen]\n\n    # Validate and register attackers\n    declared: list[Any] = []\n    for attacker in chosen:\n        if attacker not in eligible:\n            continue\n        if not _can_attack(attacker):\n            continue\n\n        combat.attackers[attacker] = defending\n        combat.attacker_blockers[attacker] = []\n        attacker.is_attacking = True\n        declared.append(attacker)\n\n        # Tap the attacker unless it has vigilance\n        kw = getattr(attacker, \"keywords\", Keyword(0))\n        if Keyword.VIGILANCE not in kw:\n            attacker.is_tapped = True\n\n    # Fire \"whenever this creature attacks\" triggers for each declared\n    # attacker.  All attack triggers are placed on the stack together,\n    # after attacker declaration (MTG rule 508.2).\n    if declared:\n        from engine.events import AttacksTriggeredEvent\n\n        for attacker in declared:\n            game.trigger_manager.fire_event(\n                game, AttacksTriggeredEvent(creature=attacker, attacker=attacker)\n            )\n\n\ndef declare_blockers_step(game: GameState) -> None:\n    \"\"\"Declare blockers step: defending player assigns blockers.\n\n    The defending player is asked (via :meth:`Player.choose`) to assign\n    blockers.  The expected format is a dict mapping blocker → attacker\n    (or blocker → list of attackers for multi-blocking scenarios), but\n    commonly blocker → attacker.\n\n    After blockers are assigned:\n    - Menace check: attackers with menace must be blocked by 2+ creatures.\n    - Flying/reach check is already handled by ``_can_block``.\n    - The attacking player orders blockers for each attacker (for damage\n      assignment).\n\n    Parameters:\n        game: The current game state.\n    \"\"\"\n    combat = game.combat_state\n\n    if not combat.attackers:\n        return\n\n    defending = game.non_active_player\n    active = game.active_player\n\n    from engine.types import Zone\n    bf_defending = defending.zones[Zone.BATTLEFIELD]\n    eligible_blockers = [\n        c for c in bf_defending.get_all()\n        if hasattr(c, \"base_power\") and not getattr(c, \"is_tapped\", False)\n    ]\n\n    if not eligible_blockers:\n        return\n\n    # Defending player chooses block assignments\n    # Expected format: dict mapping blocker → attacker (or list of attackers)","numLines":90,"startLine":220,"totalLines":570}}}
