{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J7siuELCcHa6XTDZmD5gcf","type":"tool_result","content":"diff --git a/engine/casting.py b/engine/casting.py\nindex 5d8acca..4ca5143 100644\n--- a/engine/casting.py\n+++ b/engine/casting.py\n@@ -104,10 +104,35 @@ def get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> i\n     # Restore previous controller in case the caller doesn't want a\n     # side-effect (get_cost_reduction is a query, not a mutation).\n     card.controller = prev_controller\n+    # Add cost reductions granted by other permanents on the battlefield\n+    # (e.g. an effect that gives \"your instant and sorcery spells have\n+    # affinity for creatures\").\n+    raw += _external_cost_reduction(game, card, controller)\n     generic = card.mana_cost.generic if card.mana_cost else 0\n     return max(0, min(raw, generic))\n \n \n+def _external_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n+    \"\"\"Sum generic cost reductions granted to *card* by other permanents.\n+\n+    A permanent grants an external reduction by implementing\n+    ``static_cost_reduction(game, spell, spell_controller) -> int``.  This\n+    lets one permanent reduce the cost of *other* spells (the self-only\n+    reduction lives on :meth:`CardImpl.cost_reduction`).\n+    \"\"\"\n+    total = 0\n+    for perm in game.get_battlefield(controller).get_all():\n+        if perm is card:\n+            continue\n+        hook = getattr(perm, \"static_cost_reduction\", None)\n+        if hook is None:\n+            continue\n+        amount = hook(game, card, controller)\n+        if amount:\n+            total += amount\n+    return total\n+\n+\n def _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n     \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n     new_generic = max(0, cost.generic - reduction)\n@@ -227,6 +252,9 @@ def cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n     # Store colors of mana spent on the card for mechanics like Converge\n     # that care about the colors used to cast the spell.\n     card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n+    # Store the total mana spent for mechanics that add mana \"equal to the\n+    # mana spent to cast it\" (e.g. Mana Sculpt).\n+    card.mana_spent = player.mana_pool.last_payment_total  # type: ignore[attr-defined]\n \n     # 7. Call on_cast hook\n     card.on_cast(game)\n@@ -245,6 +273,10 @@ def cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n     stack_obj.on_resolve = _on_resolve\n     game.stack.push(stack_obj)\n \n+    # 9. Fire \"whenever you cast ...\" triggers.  The spell is now on the\n+    # stack; any triggers go on top of it (resolving before the spell).\n+    _fire_spell_cast(game, card, player)\n+\n \n # ------------------------------------------------------------------\n # Cast spell without paying mana cost (free-cast from any zone)\n@@ -353,6 +385,9 @@ def cast_spell_free(\n         source_zone_container.add(card)\n         raise CastingError(str(exc)) from exc\n \n+    # No mana was paid for a free cast.\n+    card.mana_spent = 0  # type: ignore[attr-defined]\n+\n     # 4. Call on_cast hook\n     card.on_cast(game)\n \n@@ -370,6 +405,29 @@ def cast_spell_free(\n     stack_obj.on_resolve = _on_resolve\n     game.stack.push(stack_obj)\n \n+    # 6. Fire \"whenever you cast ...\" triggers (free casting is still casting).\n+    _fire_spell_cast(game, card, player)\n+\n+\n+# ------------------------------------------------------------------\n+# Spell-cast trigger helper\n+# ------------------------------------------------------------------\n+\n+def _fire_spell_cast(game: GameState, card: CardImpl, player: Player) -> None:\n+    \"\"\"Fire a :class:`SpellCastTriggeredEvent` for *card* cast by *player*.\n+\n+    Triggers that watch for \"whenever you cast ...\" self-guard on their\n+    own source being on the battlefield, so firing globally is safe.\n+    \"\"\"\n+    from engine.events import SpellCastTriggeredEvent\n+\n+    game.trigger_manager.fire_event(\n+        game,\n+        SpellCastTriggeredEvent(\n+            spell=card, player=player, card=card, controller=player\n+        ),\n+    )\n+\n \n # ------------------------------------------------------------------\n # Resolution (called when the stack pops)\n@@ -405,6 +463,11 @@ def _resolve_spell(\n         # Move from stack to battlefield via move_to_zone, which handles\n         # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n         move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n+    elif getattr(card, \"_exile_instead_of_graveyard\", False):\n+        # Replacement effect: \"if this spell would be put into your\n+        # graveyard, exile it instead\" (e.g. The Dawning Archaic, Paradigm).\n+        card._exile_instead_of_graveyard = False\n+        move_to_zone(game, card, Zone.STACK, Zone.EXILE)\n     else:\n         # Instant/sorcery: move from stack to graveyard via move_to_zone.\n         move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\ndiff --git a/engine/combat.py b/engine/combat.py\nindex d2dc47f..98eccdf 100644\n--- a/engine/combat.py\n+++ b/engine/combat.py\n@@ -241,6 +241,7 @@ def declare_attackers_step(game: GameState) -> None:\n         chosen = [chosen]\n \n     # Validate and register attackers\n+    declared: list[Any] = []\n     for attacker in chosen:\n         if attacker not in eligible:\n             continue\n@@ -250,12 +251,24 @@ def declare_attackers_step(game: GameState) -> None:\n         combat.attackers[attacker] = defending\n         combat.attacker_blockers[attacker] = []\n         attacker.is_attacking = True\n+        declared.append(attacker)\n \n         # Tap the attacker unless it has vigilance\n         kw = getattr(attacker, \"keywords\", Keyword(0))\n         if Keyword.VIGILANCE n