{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016aX65zJ6eSLugHcCLj6DZg","type":"tool_result","content":"1\t\"\"\"Player interface and deterministic test player implementation.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom abc import ABC, abstractmethod\n6\tfrom collections import deque\n7\tfrom typing import Any\n8\t\n9\tfrom engine.mana import ManaPool\n10\tfrom engine.zones import Zones\n11\t\n12\t\n13\tclass ScriptExhaustedError(Exception):\n14\t    \"\"\"Raised when a DeterministicPlayer's script runs out of predetermined answers.\"\"\"\n15\t\n16\t\n17\tclass Player(ABC):\n18\t    \"\"\"Abstract base class for all players in the game.\n19\t\n20\t    Attributes:\n21\t        name: The player's display name.\n22\t        life: Current life total (default 20).\n23\t        zones: Per-player zone containers.\n24\t        mana_pool: The player's mana pool (forward ref; initialized to None until ManaPool is implemented).\n25\t        has_lost: Whether this player has lost the game.\n26\t        land_plays_remaining: Number of land plays remaining this turn.\n27\t        drawn_from_empty_library: Whether this player attempted to draw from an empty library.\n28\t    \"\"\"\n29\t\n30\t    def __init__(self, name: str, life: int = 20) -> None:\n31\t        self.name: str = name\n32\t        self.life: int = life\n33\t        self.zones: Zones = Zones.new_player()\n34\t        self.mana_pool: ManaPool = ManaPool()\n35\t        self.has_lost: bool = False\n36\t        self.land_plays_remaining: int = 1\n37\t        self.drawn_from_empty_library: bool = False\n38\t\n39\t    @abstractmethod\n40\t    def choose_target(self, options: Any, requirement: Any) -> Any:\n41\t        \"\"\"Choose a target from the available options given a requirement.\n42\t\n43\t        Parameters:\n44\t            options: The available targets to choose from.\n45\t            requirement: The targeting requirement to satisfy.\n46\t\n47\t        Returns:\n48\t            The chosen target.\n49\t        \"\"\"\n50\t\n51\t    @abstractmethod\n52\t    def choose(self, options: Any, description: str) -> Any:\n53\t        \"\"\"Choose from a list of options.\n54\t\n55\t        Parameters:\n56\t            options: The available choices.\n57\t            description: Human-readable description of the choice.\n58\t\n59\t        Returns:\n60\t            The chosen option.\n61\t        \"\"\"\n62\t\n63\t    @abstractmethod\n64\t    def choose_yes_no(self, prompt: str) -> bool:\n65\t        \"\"\"Make a yes/no decision.\n66\t\n67\t        Parameters:\n68\t            prompt: Human-readable prompt for the decision.\n69\t\n70\t        Returns:\n71\t            True for yes, False for no.\n72\t        \"\"\"\n73\t\n74\t    @abstractmethod\n75\t    def assign_damage_order(self, attackers_or_blockers: Any) -> list[Any]:\n76\t        \"\"\"Assign a damage ordering to attackers or blockers.\n77\t\n78\t        Parameters:\n79\t            attackers_or_blockers: The creatures to order.\n80\t\n81\t        Returns:\n82\t            An ordered list representing the damage assignment order.\n83\t        \"\"\"\n84\t\n85\t    @abstractmethod\n86\t    def choose_card(self, cards: Any, description: str) -> Any:\n87\t        \"\"\"Choose a card from a collection.\n88\t\n89\t        Parameters:\n90\t            cards: The available cards to choose from.\n91\t            description: Human-readable description of why a card is being chosen.\n92\t\n93\t        Returns:\n94\t            The chosen card.\n95\t        \"\"\"\n96\t\n97\t\n98\tclass DeterministicPlayer(Player):\n99\t    \"\"\"A scripted player for testing that returns predetermined answers.\n100\t\n101\t    Each abstract method call pops the next answer from the front of the\n102\t    script queue. Raises :class:`ScriptExhaustedError` if the script is empty\n103\t    when a choice is requested.\n104\t    \"\"\"\n105\t\n106\t    def __init__(self, name: str, script: list[Any], life: int = 20) -> None:\n107\t        super().__init__(name, life)\n108\t        self._script: deque[Any] = deque(script)\n109\t\n110\t    def _pop(self) -> Any:\n111\t        \"\"\"Pop the next scripted answer from the queue.\n112\t\n113\t        Raises:\n114\t            ScriptExhaustedError: If the script has no remaining answers.\n115\t        \"\"\"\n116\t        if not self._script:\n117\t            raise ScriptExhaustedError(\n118\t                f\"Player {self.name!r} script exhausted — no more predetermined answers\"\n119\t            )\n120\t        return self._script.popleft()\n121\t\n122\t    @property\n123\t    def remaining_choices(self) -> int:\n124\t        \"\"\"Return the number of scripted answers remaining.\"\"\"\n125\t        return len(self._script)\n126\t\n127\t    def choose_target(self, options: Any, requirement: Any) -> Any:\n128\t        \"\"\"Return the next scripted target choice.\"\"\"\n129\t        return self._pop()\n130\t\n131\t    def choose(self, options: Any, description: str) -> Any:\n132\t        \"\"\"Return the next scripted choice.\"\"\"\n133\t        return self._pop()\n134\t\n135\t    def choose_yes_no(self, prompt: str) -> bool:\n136\t        \"\"\"Return the next scripted yes/no decision.\"\"\"\n137\t        return self._pop()\n138\t\n139\t    def assign_damage_order(self, attackers_or_blockers: Any) -> list[Any]:\n140\t        \"\"\"Return the next scripted damage ordering.\"\"\"\n141\t        return self._pop()\n142\t\n143\t    def choose_card(self, cards: Any, description: str) -> Any:\n144\t        \"\"\"Return the next scripted card choice.\"\"\"\n145\t        return self._pop()\n146\t"}]},"parent_tool_use_id":null,"session_id":"7182fe58-6bea-420a-b90d-6a2af4b380c1","uuid":"ae06ffea-6fe3-4735-8c7a-976ff5cdeacf","timestamp":"2026-05-30T07:50:41.445Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/player.py","content":"\"\"\"Player interface and deterministic test player implementation.\"\"\"\n\nfrom __future__ import annotations\n\nfrom abc import ABC, abstractmethod\nfrom collections import deque\nfrom typing import Any\n\nfrom engine.mana import ManaPool\nfrom engine.zones import Zones\n\n\nclass ScriptExhaustedError(Exception):\n    \"\"\"Raised when a DeterministicPlayer's script runs out of predetermined answers.\"\"\"\n\n\nclass Player(ABC):\n    \"\"\"Abstract base class for all players in the game.\n\n    Attributes:\n        name: The player's display name.\n        life: Current life total (default 20).\n        zones: Per-player zone containers.\n        mana_pool: The player's mana pool (forward ref; initialized to None until ManaPool is implemented).\n        has_lost: Whether this player has lost the game.\n        land_plays_remaining: Number of land plays remaining this turn.\n        drawn_from_empty_library: Whether this player attempted to draw from an empty library.\n    \"\"\"\n\n    def __init__(self, name: str, life: int = 20) -> None:\n        self.name: str = name\n        self.life: int = life\n        self.zones: Zones = Zones.new_player()\n        self.mana_pool: ManaPool = ManaPool()\n        self.has_lost: bool = False\n        self.land_plays_remaining: int = 1\n        self.drawn_from_empty_library: bool = False\n\n    @abstractmethod\n    def choose_target(self, options: Any, requirement: Any) -> Any:\n        \"\"\"Choose a target from the available options given a requirement.\n\n        Parameters:\n            options: The available targets to choose from.\n            requirement: The targeting requirement to satisfy.\n\n        Returns:\n            The chosen target.\n        \"\"\"\n\n    @abstractmethod\n    def choose(self, options: Any, description: str) -> Any:\n        \"\"\"Choose from a list of options.\n\n        Parameters:\n            options: The available choices.\n            description: Human-readable description of the choice.\n\n        Returns:\n            The chosen option.\n        \"\"\"\n\n    @abstractmethod\n    def choose_yes_no(self, prompt: str) -> bool:\n        \"\"\"Make a yes/no decision.\n\n        Parameters:\n            prompt: Human-readable prompt for the decision.\n\n        Returns:\n            True for yes, False for no.\n        \"\"\"\n\n    @abstractmethod\n    def assign_damage_order(self, attackers_or_blockers: Any) -> list[Any]:\n        \"\"\"Assign a damage ordering to attackers or blockers.\n\n        Parameters:\n            attackers_or_blockers: The creatures to order.\n\n        Returns:\n            An ordered list representing the damage assignment order.\n        \"\"\"\n\n    @abstractmethod\n    def choose_card(self, cards: Any, description: str) -> Any:\n        \"\"\"Choose a card from a collection.\n\n        Parameters:\n            cards: The available cards to choose from.\n            description: Human-readable description of why a card is being chosen.\n\n        Returns:\n            The chosen card.\n        \"\"\"\n\n\nclass DeterministicPlayer(Player):\n    \"\"\"A scripted player for testing that returns predetermined answers.\n\n    Each abstract method call pops the next answer from the front of the\n    script queue. Raises :class:`ScriptExhaustedError` if the script is empty\n    when a choice is requested.\n    \"\"\"\n\n    def __init__(self, name: str, script: list[Any], life: int = 20) -> None:\n        super().__init__(name, life)\n        self._script: deque[Any] = deque(script)\n\n    def _pop(self) -> Any:\n        \"\"\"Pop the next scripted answer from the queue.\n\n        Raises:\n            ScriptExhaustedError: If the script has no remaining answers.\n        \"\"\"\n        if not self._script:\n            raise ScriptExhaustedError(\n                f\"Player {self.name!r} script exhausted — no more predetermined answers\"\n            )\n        return self._script.popleft()\n\n    @property\n    def remaining_choices(self) -> int:\n        \"\"\"Return the number of scripted answers remaining.\"\"\"\n        return len(self._script)\n\n    def choose_target(self, options: Any, requirement: Any) -> Any:\n        \"\"\"Return the next scripted target choice.\"\"\"\n        return self._pop()\n\n    def choose(self, options: Any, description: str) -> Any:\n        \"\"\"Return the next scripted choice.\"\"\"\n        return self._pop()\n\n    def choose_yes_no(self, prompt: str) -> bool:\n        \"\"\"Return the next scripted yes/no decision.\"\"\"\n        return self._pop()\n\n    def assign_damage_order(self, attackers_or_blockers: Any) -> list[Any]:\n        \"\"\"Return the next scripted damage ordering.\"\"\"\n        return self._pop()\n\n    def choose_card(self, cards: Any, description: str) -> Any:\n        \"\"\"Return the next scripted card choice.\"\"\"\n        return self._pop()\n","numLines":146,"startLine":1,"totalLines":146}}}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01QbLZx5Jq1ppFzN26vsUpqw","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014zY8MdVxXPKWmPGY5gFcEm","name":"Read","input":{"file_path":"/workspace/engine/abilities.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2002,"cache_read_input_tokens":109176,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2002},"output_tokens":59,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"7182fe58-6bea-420a-b90d-6a2af4b380c1","uuid":"a1d518e0-6771-4035-8c6e-0772d644c739","request_id":"req_011CbYPUPv4xo4Mgt3fjFEHW"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014zY8MdVxXPKWmPGY5gFcEm","type":"tool_result","content":"1\t\"\"\"Activated abilities system — tap-for-mana, loyalty abilities, and general\n2\tactivated abilities that go on the stack (or resolve immediately for mana\n3\tabilities).\n4\t\n5\tProvides:\n6\t\n7\t- :func:`activate_ability` — verify timing → pay costs → resolve immediately\n8\t  (mana abilities) or push to the stack (non-mana abilities).\n9\t- :func:`tap_cost` — generic tap-cost helper: checks ``not source.is_tapped``\n10\t  and taps the source.\n11\t- :class:`ActivatedAbilityInstance` — a runtime representation of an activated\n12\t  ability with source, controller, cost/effect callables, and metadata.\n13\t- :class:`LoyaltyAbilityInstance` — activated ability variant for planeswalker\n14\t  loyalty abilities with per-turn restriction and loyalty-counter cost.\n15\t\"\"\"\n16\t\n17\tfrom __future__ import annotations\n18\t\n19\tfrom dataclasses import dataclass, field\n20\tfrom typing import TYPE_CHECKING, Any, Callable\n21\t\n22\tfrom engine.casting import is_sorcery_speed\n23\tfrom engine.stack import StackObject\n24\t\n25\tif TYPE_CHECKING:\n26\t    from engine.game_state import GameState\n27\t    from engine.player import Player\n28\t\n29\t\n30\tclass AbilityError(Exception):\n31\t    \"\"\"Raised when an ability activation is illegal.\"\"\"\n32\t\n33\t\n34\t# ---------------------------------------------------------------------------\n35\t# Runtime ability representations\n36\t# ---------------------------------------------------------------------------\n37\t\n38\t@dataclass\n39\tclass ActivatedAbilityInstance:\n40\t    \"\"\"Runtime representation of an activated ability.\n41\t\n42\t    This captures everything needed to activate and resolve an ability:\n43\t    the source permanent, the controlling player, cost/effect callables,\n44\t    and whether the ability is a mana ability.\n45\t\n46\t    Attributes:\n47\t        source: The permanent that has this ability.\n48\t        controller: The player who controls the source.\n49\t        cost: A callable ``(game, source) -> bool`` that checks and pays\n50\t            the cost. Returns ``True`` if the cost was successfully paid,\n51\t            ``False`` otherwise.\n52\t        effect: A callable ``(game) -> None`` that applies the ability's\n53\t            effect when it resolves.\n54\t        is_mana_ability: Whether this is a mana ability (resolves\n55\t            immediately without using the stack).\n56\t        description: Human-readable description of the ability.\n57\t    \"\"\"\n58\t\n59\t    source: Any\n60\t    controller: Any  # Player\n61\t    cost: Callable[..., bool]\n62\t    effect: Callable[..., None]\n63\t    is_mana_ability: bool = False\n64\t    description: str = \"\"\n65\t\n66\t\n67\t@dataclass\n68\tclass LoyaltyAbilityInstance:\n69\t    \"\"\"Runtime representation of a planeswalker loyalty ability.\n70\t\n71\t    Loyalty abilities are activated abilities with special restrictions:\n72\t    they may only be activated at sorcery speed, and only once per turn\n73\t    per source (tracked via ``_activated_this_turn``).\n74\t\n75\t    The cost adjusts the loyalty counters on the source planeswalker.\n76\t\n77\t    Attributes:\n78\t        source: The planeswalker permanent.\n79\t        controller: The player who controls the planeswalker.\n80\t        loyalty_cost: The loyalty adjustment (positive for ``+N``,\n81\t            negative for ``−N``, zero for ``0``).\n82\t        effect: A callable ``(game) -> None`` for the ability's effect.\n83\t        description: Human-readable description.\n84\t    \"\"\"\n85\t\n86\t    source: Any\n87\t    controller: Any  # Player\n88\t    loyalty_cost: int = 0\n89\t    effect: Callable[..., None] = field(default=lambda _game: None)\n90\t    description: str = \"\"\n91\t\n92\t\n93\t# ---------------------------------------------------------------------------\n94\t# Per-turn loyalty tracking\n95\t# ---------------------------------------------------------------------------\n96\t\n97\t# Set of (object_id, turn_number) pairs that have already activated a\n98\t# loyalty ability this turn.  Callers should call\n99\t# ``clear_loyalty_tracking()`` at the start of each turn or manage the\n100\t# set externally.\n101\t_loyalty_activated_this_turn: set[tuple[int, int]] = set()\n102\t\n103\t\n104\tdef clear_loyalty_tracking() -> None:\n105\t    \"\"\"Clear the loyalty-activated-this-turn tracker.\n106\t\n107\t    Should be called at the start of each turn so that planeswalkers may\n108\t    activate loyalty abilities again.\n109\t    \"\"\"\n110\t    _loyalty_activated_this_turn.clear()\n111\t\n112\t\n113\tdef _has_activated_loyalty_this_turn(source: Any, turn_number: int) -> bool:\n114\t    \"\"\"Return ``True`` if *source* already used a loyalty ability this turn.\"\"\"\n115\t    obj_id = getattr(source, \"object_id\", id(source))\n116\t    return (obj_id, turn_number) in _loyalty_activated_this_turn\n117\t\n118\t\n119\tdef _mark_loyalty_activated(source: Any, turn_number: int) -> None:\n120\t    \"\"\"Record that *source* used a loyalty ability this turn.\"\"\"\n121\t    obj_id = getattr(source, \"object_id\", id(source))\n122\t    _loyalty_activated_this_turn.add((obj_id, turn_number))\n123\t\n124\t\n125\t# ---------------------------------------------------------------------------\n126\t# Tap cost helper\n127\t# ---------------------------------------------------------------------------\n128\t\n129\tdef tap_cost(game: GameState, source: Any) -> bool:\n130\t    \"\"\"Generic tap-cost function.\n131\t\n132\t    Checks that the source is not already tapped.  If untapped, taps it\n133\t    (sets ``source.is_tapped = True``) and returns ``True``.  If already\n134\t    tapped, returns ``False`` (cost cannot be paid).\n135\t\n136\t    Parameters:\n137\t        game: The current game state (unused here but kept for a\n138\t            consistent ``(game, source) -> bool`` cost signature).\n139\t        source: The permanent to tap.\n140\t\n141\t    Returns:\n142\t        ``True`` if the cost was successfully paid (source was untapped\n143\t        and is now tapped), ``False`` otherwise.\n144\t    \"\"\"\n145\t    if getattr(source, \"is_tapped\", False):\n146\t        return False\n147\t    source.is_tapped = True\n148\t    return True\n149\t\n150\t\n151\t# ---------------------------------------------------------------------------\n152\t# Activate ability — main entry point\n153\t# ---------------------------------------------------------------------------\n154\t\n155\tdef activate_ability(\n156\t    game: GameState,\n157\t    player: Any,  # Player\n158\t    ability: ActivatedAbilityInstance | LoyaltyAbilityInstance,\n159\t) -> None:\n160\t    \"\"\"Activate an ability.\n161\t\n162\t    Pipeline\n163\t    --------\n164\t    1. **Timing check** — mana abilities bypass timing entirely and\n165\t       resolve immediately.  Regular (non-mana) activated abilities\n166\t       can be activated whenever a player has priority (instant speed);\n167\t       priority enforcement is handled externally by\n168\t       ``priority_loop``, not here.  **Only loyalty abilities** carry\n169\t       a sorcery-speed restriction.\n170\t    2. **Pay costs** — invoke the ability's cost callable.  For loyalty\n171\t       abilities, adjust loyalty counters and enforce once-per-turn.\n172\t    3. **Resolve or push to stack** — mana abilities resolve\n173\t       immediately; all other abilities are pushed onto the game stack\n174\t       as :class:`StackObject` instances.\n175\t\n176\t    Parameters:\n177\t        game: The current game state.\n178\t        player: The player activating the ability.\n179\t        ability: The ability to activate (an\n180\t            :class:`ActivatedAbilityInstance` or\n181\t            :class:`LoyaltyAbilityInstance`).\n182\t\n183\t    Raises:\n184\t        AbilityError: If the activation is illegal (timing, cost, or\n185\t            once-per-turn restriction).\n186\t    \"\"\"\n187\t    if isinstance(ability, LoyaltyAbilityInstance):\n188\t        _activate_loyalty_ability(game, player, ability)\n189\t    elif isinstance(ability, ActivatedAbilityInstance):\n190\t        _activate_regular_ability(game, player, ability)\n191\t    else:\n192\t        raise AbilityError(f\"Unknown ability type: {type(ability)}\")\n193\t\n194\t\n195\t# ---------------------------------------------------------------------------\n196\t# Internal helpers\n197\t# ---------------------------------------------------------------------------\n198\t\n199\tdef _activate_regular_ability(\n200\t    game: GameState,\n201\t    player: Any,\n202\t    ability: ActivatedAbilityInstance,\n203\t) -> None:\n204\t    \"\"\"Activate a regular (non-loyalty) activated ability.\"\"\"\n205\t    # 1. Check \"can't activate\" restriction (e.g. Arrest).\n206\t    if getattr(ability.source, \"_cant_activate\", False):\n207\t        raise AbilityError(\n208\t            \"Cannot activate ability — source's activated abilities are suppressed\"\n209\t        )\n210\t\n211\t    # 2. Pay costs\n212\t    cost_paid = ability.cost(game, ability.source)\n213\t    if not cost_paid:\n214\t        raise AbilityError(\"Cannot activate ability — cost could not be paid\")\n215\t\n216\t    # 3. Resolve or push\n217\t    if ability.is_mana_ability:\n218\t        # Mana abilities resolve immediately without using the stack.\n219\t        ability.effect(game)\n220\t    else:\n221\t        # Push to stack for resolution.\n222\t        stack_obj = StackObject(\n223\t            source=ability.source,\n224\t            controller=player,\n225\t            on_resolve=ability.effect,\n226\t            is_mana_ability=False,\n227\t        )\n228\t        game.stack.push(stack_obj)\n229\t\n230\t\n231\tdef _activate_loyalty_ability(\n232\t    game: GameState,\n233\t    player: Any,\n234\t    ability: LoyaltyAbilityInstance,\n235\t) -> None:\n236\t    \"\"\"Activate a planeswalker loyalty ability.\"\"\"\n237\t    source = ability.source\n238\t\n239\t    # 1. Timing — loyalty abilities are sorcery speed only.\n240\t    if not is_sorcery_speed(game, player):\n241\t        raise AbilityError(\n242\t            \"Cannot activate loyalty ability — sorcery-speed timing not met\"\n243\t        )\n244\t\n245\t    # 2. Once-per-turn restriction.\n246\t    turn_number = getattr(game, \"turn_number\", 0)\n247\t    if _has_activated_loyalty_this_turn(source, turn_number):\n248\t        raise AbilityError(\n249\t            \"Cannot activate loyalty ability — already activated this turn\"\n250\t        )\n251\t\n252\t    # 3. Pay loyalty cost.\n253\t    current_loyalty = getattr(source, \"loyalty\", 0)\n254\t    new_loyalty = current_loyalty + ability.loyalty_cost\n255\t    if new_loyalty < 0:\n256\t        raise AbilityError(\n257\t            f\"Cannot activate loyalty ability — insufficient loyalty \"\n258\t            f\"(have {current_loyalty}, need {-ability.loyalty_cost})\"\n259\t        )\n260\t    source.loyalty = new_loyalty\n261\t\n262\t    # 4. Mark as activated this turn.\n263\t    _mark_loyalty_activated(source, turn_number)\n264\t\n265\t    # 5. Push to stack.\n266\t    stack_obj = StackObject(\n267\t        source=source,\n268\t        controller=player,\n269\t        on_resolve=ability.effect,\n270\t        is_mana_ability=False,\n271\t    )\n272\t    game.stack.push(stack_obj)\n273\t"}]},"parent_tool_use_id":null,"session_id":"7182fe58-6bea-420a-b90d-6a2af4b380c1","uuid":"2f327ac1-d36e-4391-8851-646cbf3b98ef","timestamp":"2026-05-30T07:50:43.610Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/abilities.py","content":"\"\"\"Activated abilities system — tap-for-mana, loyalty abilities, and general\nactivated abilities that go on the stack (or resolve immediately for mana\nabilities).\n\nProvides:\n\n- :func:`activate_ability` — verify timing → pay costs → resolve immediately\n  (mana abilities) or push to the stack (non-mana abilities).\n- :func:`tap_cost` — generic tap-cost helper: checks ``not source.is_tapped``\n  and taps the source.\n- :class:`ActivatedAbilityInstance` — a runtime representation of an activated\n  ability with source, controller, cost/effect callables, and metadata.\n- :class:`LoyaltyAbilityInstance` — activated ability variant for planeswalker\n  loyalty abilities with per-turn restriction and loyalty-counter cost.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom typing import TYPE_CHECKING, Any, Callable\n\nfrom engine.casting import is_sorcery_speed\nfrom engine.stack import StackObject\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\nclass AbilityError(Exception):\n    \"\"\"Raised when an ability activation is illegal.\"\"\"\n\n\n# ---------------------------------------------------------------------------\n# Runtime ability representations\n# ---------------------------------------------------------------------------\n\n@dataclass\nclass ActivatedAbilityInstance:\n    \"\"\"Runtime representation of an activated ability.\n\n    This captures everything needed to activate and resolve an ability:\n    the source permanent, the controlling player, cost/effect callables,\n    and whether the ability is a mana ability.\n\n    Attributes:\n        source: The permanent that has this ability.\n        controller: The player who controls the source.\n        cost: A callable ``(game, source) -> bool`` that checks and pays\n            the cost. Returns ``True`` if the cost was successfully paid,\n            ``False`` otherwise.\n        effect: A callable ``(game) -> None`` that applies the ability's\n            effect when it resolves.\n        is_mana_ability: Whether this is a mana ability (resolves\n            immediately without using the stack).\n        description: Human-readable description of the ability.\n    \"\"\"\n\n    source: Any\n    controller: Any  # Player\n    cost: Callable[..., bool]\n    effect: Callable[..., None]\n    is_mana_ability: bool = False\n    description: str = \"\"\n\n\n@dataclass\nclass LoyaltyAbilityInstance:\n    \"\"\"Runtime representation of a planeswalker loyalty ability.\n\n    Loyalty abilities are activated abilities with special restrictions:\n    they may only be activated at sorcery speed, and only once per turn\n    per source (tracked via ``_activated_this_turn``).\n\n    The cost adjusts the loyalty counters on the source planeswalker.\n\n    Attributes:\n        source: The planeswalker permanent.\n        controller: The player who controls the planeswalker.\n        loyalty_cost: The loyalty adjustment (positive for ``+N``,\n            negative for ``−N``, zero for ``0``).\n        effect: A callable ``(game) -> None`` for the ability's effect.\n        description: Human-readable description.\n    \"\"\"\n\n    source: Any\n    controller: Any  # Player\n    loyalty_cost: int = 0\n    effect: Callable[..., None] = field(default=lambda _game: None)\n    description: str = \"\"\n\n\n# ---------------------------------------------------------------------------\n# Per-turn loyalty tracking\n# ---------------------------------------------------------------------------\n\n# Set of (object_id, turn_number) pairs that have already activated a\n# loyalty ability this turn.  Callers should call\n# ``clear_loyalty_tracking()`` at the start of each turn or manage the\n# set externally.\n_loyalty_activated_this_turn: set[tuple[int, int]] = set()\n\n\ndef clear_loyalty_tracking() -> None:\n    \"\"\"Clear the loyalty-activated-this-turn tracker.\n\n    Should be called at the start of each turn so that planeswalkers may\n    activate loyalty abilities again.\n    \"\"\"\n    _loyalty_activated_this_turn.clear()\n\n\ndef _has_activated_loyalty_this_turn(source: Any, turn_number: int) -> bool:\n    \"\"\"Return ``True`` if *source* already used a loyalty ability this turn.\"\"\"\n    obj_id = getattr(source, \"object_id\", id(source))\n    return (obj_id, turn_number) in _loyalty_activated_this_turn\n\n\ndef _mark_loyalty_activated(source: Any, turn_number: int) -> None:\n    \"\"\"Record that *source* used a loyalty ability this turn.\"\"\"\n    obj_id = getattr(source, \"object_id\", id(source))\n    _loyalty_activated_this_turn.add((obj_id, turn_number))\n\n\n# ---------------------------------------------------------------------------\n# Tap cost helper\n# ---------------------------------------------------------------------------\n\ndef tap_cost(game: GameState, source: Any) -> bool:\n    \"\"\"Generic tap-cost function.\n\n    Checks that the source is not already tapped.  If untapped, taps it\n    (sets ``source.is_tapped = True``) and returns ``True``.  If already\n    tapped, returns ``False`` (cost cannot be paid).\n\n    Parameters:\n        game: The current game state (unused here but kept for a\n            consistent ``(game, source) -> bool`` cost signature).\n        source: The permanent to tap.\n\n    Returns:\n        ``True`` if the cost was successfully paid (source was untapped\n        and is now tapped), ``False`` otherwise.\n    \"\"\"\n    if getattr(source, \"is_tapped\", False):\n        return False\n    source.is_tapped = True\n    return True\n\n\n# ---------------------------------------------------------------------------\n# Activate ability — main entry point\n# ---------------------------------------------------------------------------\n\ndef activate_ability(\n    game: GameState,\n    player: Any,  # Player\n    ability: ActivatedAbilityInstance | LoyaltyAbilityInstance,\n) -> None:\n    \"\"\"Activate an ability.\n\n    Pipeline\n    --------\n    1. **Timing check** — mana abilities bypass timing entirely and\n       resolve immediately.  Regular (non-mana) activated abilities\n       can be activated whenever a player has priority (instant speed);\n       priority enforcement is handled externally by\n       ``priority_loop``, not here.  **Only loyalty abilities** carry\n       a sorcery-speed restriction.\n    2. **Pay costs** — invoke the ability's cost callable.  For loyalty\n       abilities, adjust loyalty counters and enforce once-per-turn.\n    3. **Resolve or push to stack** — mana abilities resolve\n       immediately; all other abilities are pushed onto the game stack\n       as :class:`StackObject` instances.\n\n    Parameters:\n        game: The current game state.\n        player: The player activating the ability.\n        ability: The ability to activate (an\n            :class:`ActivatedAbilityInstance` or\n            :class:`LoyaltyAbilityInstance`).\n\n    Raises:\n        AbilityError: If the activation is illegal (timing, cost, or\n            once-per-turn restriction).\n    \"\"\"\n    if isinstance(ability, LoyaltyAbilityInstance):\n        _activate_loyalty_ability(game, player, ability)\n    elif isinstance(ability, ActivatedAbilityInstance):\n        _activate_regular_ability(game, player, ability)\n    else:\n        raise AbilityError(f\"Unknown ability type: {type(ability)}\")\n\n\n# ---------------------------------------------------------------------------\n# Internal helpers\n# ---------------------------------------------------------------------------\n\ndef _activate_regular_ability(\n    game: GameState,\n    player: Any,\n    ability: ActivatedAbilityInstance,\n) -> None:\n    \"\"\"Activate a regular (non-loyalty) activated ability.\"\"\"\n    # 1. Check \"can't activate\" restriction (e.g. Arrest).\n    if getattr(ability.source, \"_cant_activate\", False):\n        raise AbilityError(\n            \"Cannot activate ability — source's activated abilities are suppressed\"\n        )\n\n    # 2. Pay costs\n    cost_paid = ability.cost(game, ability.source)\n    if not cost_paid:\n        raise AbilityError(\"Cannot activate ability — cost could not be paid\")\n\n    # 3. Resolve or push\n    if ability.is_mana_ability:\n        # Mana abilities resolve immediately without using the stack.\n        ability.effect(game)\n    else:\n        # Push to stack for resolution.\n        stack_obj = StackObject(\n            source=ability.source,\n            controller=player,\n            on_resolve=ability.effect,\n            is_mana_ability=False,\n        )\n        game.stack.push(stack_obj)\n\n\ndef _activate_loyalty_ability(\n    game: GameState,\n    player: Any,\n    ability: LoyaltyAbilityInstance,\n) -> None:\n    \"\"\"Activate a planeswalker loyalty ability.\"\"\"\n    source = ability.source\n\n    # 1. Timing — loyalty abilities are sorcery speed only.\n    if not is_sorcery_speed(game, player):\n        raise AbilityError(\n            \"Cannot activate loyalty ability — sorcery-speed timing not met\"\n        )\n\n    # 2. Once-per-turn restriction.\n    turn_number = getattr(game, \"turn_number\", 0)\n    if _has_activated_loyalty_this_turn(source, turn_number):\n        raise AbilityError(\n            \"Cannot activate loyalty ability — already activated this turn\"\n        )\n\n    # 3. Pay loyalty cost.\n    current_loyalty = getattr(source, \"loyalty\", 0)\n    new_loyalty = current_loyalty + ability.loyalty_cost\n    if new_loyalty < 0:\n        raise AbilityError(\n            f\"Cannot activate loyalty ability — insufficient loyalty \"\n            f\"(have {current_loyalty}, need {-ability.loyalty_cost})\"\n        )\n    source.loyalty = new_loyalty\n\n    # 4. Mark as activated this turn.\n    _mark_loyalty_activated(source, turn_number)\n\n    # 5. Push to stack.\n    stack_obj = StackObject(\n        source=source,\n        controller=player,\n        on_resolve=ability.effect,\n        is_mana_ability=False,\n    )\n    game.stack.push(stack_obj)\n","numLines":273,"startLine":1,"totalLines":273}}}
