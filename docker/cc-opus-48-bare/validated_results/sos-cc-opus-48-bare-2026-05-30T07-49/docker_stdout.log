{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018vbaHnn4jXLQmNEKum8YCf","type":"tool_result","content":"1\t===== FDN 13 SPEC =====\n2\t{\n3\t  \"name\": \"Fleeting Flight\",\n4\t  \"mana_cost\": \"{W}\",\n5\t  \"type_line\": \"Instant\",\n6\t  \"oracle_text\": \"Put a +1/+1 counter on target creature. It gains flying until end of turn. Prevent all combat damage that would be dealt to it this turn.\",\n7\t  \"power\": null,\n8\t  \"toughness\": null,\n9\t  \"loyalty\": null,\n10\t  \"colors\": [\n11\t    \"W\"\n12\t  ],\n13\t  \"keywords\": [],\n14\t  \"rarity\": \"common\",\n15\t  \"set_code\": \"fdn\",\n16\t  \"collector_number\": \"13\",\n17\t  \"complexity_tier\": \"medium\"\n18\t}\n19\t\n20\t===== FDN 13 IMPL =====\n21\t\"\"\"Card implementation for Fleeting Flight.\"\"\"\n22\t\n23\tfrom __future__ import annotations\n24\t\n25\tfrom typing import TYPE_CHECKING, Any\n26\t\n27\tfrom engine.card import Instant\n28\tfrom engine.continuous_effects import (\n29\t    ContinuousEffect,\n30\t    DURATION_END_OF_TURN,\n31\t    Layer,\n32\t)\n33\tfrom engine.types import CardType, Keyword, ManaCost, TargetRequirement, Zone\n34\t\n35\tif TYPE_CHECKING:\n36\t    from engine.game_state import GameState\n37\t\n38\t\n39\tdef _is_on_battlefield(game: Any, obj: Any) -> bool:\n40\t    \"\"\"Return True if *obj* is on any player's battlefield.\"\"\"\n41\t    for player in game.players:\n42\t        if game.get_battlefield(player).contains(obj):\n43\t            return True\n44\t    return False\n45\t\n46\t\n47\tclass FleetingFlight(Instant):\n48\t    \"\"\"Fleeting Flight — {W} — Instant.\n49\t\n50\t    Put a +1/+1 counter on target creature. It gains flying until end of\n51\t    turn. Prevent all combat damage that would be dealt to it this turn.\n52\t\n53\t    FDN collector number 13.\n54\t    \"\"\"\n55\t\n56\t    def __init__(self, **kwargs: Any) -> None:\n57\t        kwargs.setdefault(\"name\", \"Fleeting Flight\")\n58\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{W}\"))\n59\t        kwargs.setdefault(\n60\t            \"rules_text\",\n61\t            \"Put a +1/+1 counter on target creature. It gains flying \"\n62\t            \"until end of turn. Prevent all combat damage that would be \"\n63\t            \"dealt to it this turn.\",\n64\t        )\n65\t        super().__init__(**kwargs)\n66\t\n67\t    def get_targets(self, game: \"GameState\") -> list[Any]:\n68\t        \"\"\"Target creature.\"\"\"\n69\t        return [\n70\t            TargetRequirement(\n71\t                filter_fn=lambda obj: CardType.CREATURE in getattr(obj, \"card_types\", set()),\n72\t                description=\"target creature\",\n73\t                zone=Zone.BATTLEFIELD,\n74\t            )\n75\t        ]\n76\t\n77\t    def on_resolve(self, game: \"GameState\") -> None:\n78\t        \"\"\"Put +1/+1 counter, grant flying until EOT, prevent combat damage.\"\"\"\n79\t        chosen = getattr(self, \"chosen_targets\", None)\n80\t        target = chosen[0] if chosen else getattr(self, \"_resolve_target\", None)\n81\t        if target is None:\n82\t            return\n83\t\n84\t        if not _is_on_battlefield(game, target):\n85\t            return\n86\t        if CardType.CREATURE not in getattr(target, \"card_types\", set()):\n87\t            return\n88\t\n89\t        # +1/+1 counter\n90\t        from engine.game import add_counter\n91\t\n92\t        add_counter(game, target, \"+1/+1\", 1)\n93\t        # Sync original counters per KEY_DECISIONS\n94\t        if hasattr(target, \"_base_plus_one_counters\"):\n95\t            target._base_plus_one_counters = target.plus_one_counters\n96\t\n97\t        # Flying until end of turn\n98\t        creature_ref = target\n99\t\n100\t        def _apply_flying(game: Any) -> None:\n101\t            if not _is_on_battlefield(game, creature_ref):\n102\t                return\n103\t            creature_ref.keywords = getattr(\n104\t                creature_ref, \"keywords\", Keyword(0)\n105\t            ) | Keyword.FLYING\n106\t\n107\t        game.effect_manager.add(ContinuousEffect(\n108\t            source=self,\n109\t            layer=Layer.ABILITY,\n110\t            sublayer=None,\n111\t            apply=_apply_flying,\n112\t            duration=DURATION_END_OF_TURN,\n113\t        ))\n114\t\n115\t        # ENGINE LIMITATION: \"Prevent all combat damage that would be dealt\n116\t        # to it this turn\" requires a damage prevention shield / replacement\n117\t        # effect, which the engine does not support. The flag is set on the\n118\t        # creature but will only work if the combat system checks it.\n119\t        creature_ref.combat_damage_prevented = True\n120\t\n121\t===== FDN 13 TESTS =====\n122\t\"\"\"Reference test for FDN 13 — Fleeting Flight.\n123\t\n124\tIllustrative test covering **target selection / validation**. Fleeting\n125\tFlight is a targeted instant: ``get_targets()`` returns a\n126\t``TargetRequirement`` describing what is legal, and the cast pipeline\n127\tpopulates ``chosen_targets`` with the player's selection. ``on_resolve``\n128\treads ``chosen_targets`` and applies the effect to the chosen target.\n129\t\"\"\"\n130\t\n131\tfrom __future__ import annotations\n132\t\n133\tfrom cards.fdn.fdn_13.card_impl import FleetingFlight\n134\tfrom engine.card import Creature, Instant\n135\tfrom engine.types import (\n136\t    CardType,\n137\t    Keyword,\n138\t    ManaCost,\n139\t    TargetRequirement,\n140\t    Zone,\n141\t)\n142\tfrom test_utils import create_game\n143\t\n144\t\n145\tclass TestFleetingFlightProperties:\n146\t    \"\"\"Static card data should match the FDN 13 spec.\"\"\"\n147\t\n148\t    def test_is_instant(self) -> None:\n149\t        assert isinstance(FleetingFlight(owner=None), Instant)\n150\t\n151\t    def test_name(self) -> None:\n152\t        assert FleetingFlight(owner=None).name == \"Fleeting Flight\"\n153\t\n154\t    def test_mana_cost(self) -> None:\n155\t        assert FleetingFlight(owner=None).mana_cost == ManaCost.parse(\"{W}\")\n156\t\n157\t\n158\tclass TestFleetingFlightTargeting:\n159\t    \"\"\"get_targets() advertises a single creature target on the battlefield.\"\"\"\n160\t\n161\t    def test_returns_single_target_requirement(self) -> None:\n162\t        game = create_game()\n163\t        reqs = FleetingFlight(owner=None).get_targets(game)\n164\t        assert isinstance(reqs, list)\n165\t        assert len(reqs) == 1\n166\t        assert isinstance(reqs[0], TargetRequirement)\n167\t\n168\t    def test_target_zone_is_battlefield(self) -> None:\n169\t        game = create_game()\n170\t        req = FleetingFlight(owner=None).get_targets(game)[0]\n171\t        assert req.zone == Zone.BATTLEFIELD\n172\t\n173\t    def test_target_filter_accepts_creature(self) -> None:\n174\t        \"\"\"The filter must accept creatures and reject non-creatures.\"\"\"\n175\t        game = create_game()\n176\t        req = FleetingFlight(owner=None).get_targets(game)[0]\n177\t\n178\t        creature = Creature(name=\"Test Bear\", base_power=2, base_toughness=2)\n179\t        creature.card_types = {CardType.CREATURE}\n180\t        non_creature = Creature(name=\"Not a creature\")  # no card_types\n181\t        non_creature.card_types = set()\n182\t\n183\t        assert req.filter_fn(creature) is True\n184\t        assert req.filter_fn(non_creature) is False\n185\t\n186\t\n187\tclass TestFleetingFlightResolution:\n188\t    \"\"\"on_resolve reads chosen_targets and applies the effect.\"\"\"\n189\t\n190\t    def test_no_target_is_a_noop(self) -> None:\n191\t        game = create_game()\n192\t        p1 = game.players[0]\n193\t        spell = FleetingFlight(owner=p1, controller=p1)\n194\t        # chosen_targets is unset — resolution must not raise.\n195\t        spell.on_resolve(game)\n196\t\n197\t    def test_chosen_target_receives_counter_and_flying(self) -> None:\n198\t        game = create_game()\n199\t        p1 = game.players[0]\n200\t\n201\t        # Put a vanilla bear on the battlefield as the target.\n202\t        bear = Creature(\n203\t            name=\"Grizzly Bears\",\n204\t            owner=p1,\n205\t            controller=p1,\n206\t            base_power=2,\n207\t            base_toughness=2,\n208\t        )\n209\t        bear.card_types = {CardType.CREATURE}\n210\t        game.get_battlefield(p1).add(bear)\n211\t\n212\t        spell = FleetingFlight(owner=p1, controller=p1)\n213\t        # The cast pipeline would set chosen_targets; we set it directly\n214\t        # to validate that on_resolve reads it correctly.\n215\t        spell.chosen_targets = [bear]\n216\t        before = bear.plus_one_counters\n217\t        spell.on_resolve(game)\n218\t        # +1/+1 counter applied to the chosen target.\n219\t        assert bear.plus_one_counters == before + 1\n220\t        # Damage-prevention flag set per the card's \"prevent all combat\n221\t        # damage\" clause.\n222\t        assert bear.combat_damage_prevented is True\n223\t\n224\t===== FDN 142 SPEC =====\n225\t{\n226\t  \"name\": \"Healer's Hawk\",\n227\t  \"mana_cost\": \"{W}\",\n228\t  \"type_line\": \"Creature — Bird\",\n229\t  \"oracle_text\": \"Flying\\nLifelink (Damage dealt by this creature also causes you to gain that much life.)\",\n230\t  \"power\": \"1\",\n231\t  \"toughness\": \"1\",\n232\t  \"loyalty\": null,\n233\t  \"colors\": [\n234\t    \"W\"\n235\t  ],\n236\t  \"keywords\": [\n237\t    \"Flying\",\n238\t    \"Lifelink\"\n239\t  ],\n240\t  \"rarity\": \"common\",\n241\t  \"set_code\": \"fdn\",\n242\t  \"collector_number\": \"142\",\n243\t  \"complexity_tier\": \"medium\"\n244\t}\n245\t\n246\t===== FDN 142 IMPL =====\n247\t\"\"\"Card implementation for Healer's Hawk.\"\"\"\n248\t\n249\tfrom __future__ import annotations\n250\tfrom typing import TYPE_CHECKING\n251\t\n252\tfrom engine.creatures import make_vanilla\n253\tfrom engine.types import Keyword\n254\t\n255\tif TYPE_CHECKING:\n256\t    from cards.registry import CardRegistry\n257\t\n258\tHealersHawk = make_vanilla(\n259\t    \"Healer's Hawk\", \"{W}\", 1, 1,\n260\t    keywords=Keyword.FLYING | Keyword.LIFELINK,\n261\t    creature_types={\"Bird\"},\n262\t)\n263\t\n264\t===== FDN 142 TESTS =====\n265\t\"\"\"Reference test for FDN 142 — Healer's Hawk.\n266\t\n267\tIllustrative test covering **blocker declaration / blocking restrictions**.\n268\tHealer's Hawk is a 1/1 with Flying + Lifelink. The flying keyword\n269\trestricts which creatures can legally block it: per the rules, a flying\n270\tattacker can only be blocked by creatures with flying or reach. The\n271\tengine encodes this in :func:`engine.combat._can_block`.\n272\t\"\"\"\n273\t\n274\tfrom __future__ import annotations\n275\t\n276\tfrom cards.fdn.fdn_142.card_impl import HealersHawk\n277\tfrom engine.card import Creature\n278\tfrom engine.combat import _can_block\n279\tfrom engine.types import Keyword, ManaCost\n280\t\n281\t\n282\tclass TestHealersHawkProperties:\n283\t    \"\"\"Static card data should match the FDN 142 spec.\"\"\"\n284\t\n285\t    def test_is_creature(self) -> None:\n286\t        assert isinstance(HealersHawk(owner=None), Creature)\n287\t\n288\t    def test_name(self) -> None:\n289\t        assert HealersHawk(owner=None).name == \"Healer's Hawk\"\n290\t\n291\t    def test_mana_cost(self) -> None:\n292\t        assert HealersHawk(owner=None).mana_cost == ManaCost.parse(\"{W}\")\n293\t\n294\t    def test_power_toughness(self) -> None:\n295\t        card = HealersHawk(owner=None)\n296\t        assert card.base_power == 1\n297\t        assert card.base_toughness == 1\n298\t\n299\t    def test_has_flying_and_lifelink(self) -> None:\n300\t        kw = HealersHawk(owner=None).keywords\n301\t        assert Keyword.FLYING in kw\n302\t        assert Keyword.LIFELINK in kw\n303\t\n304\t\n305\tclass TestHealersHawkBlockerRules:\n306\t    \"\"\"Flying restricts which creatures can legally block this attacker.\"\"\"\n307\t\n308\t    @staticmethod\n309\t    def _ground_creature() -> Creature:\n310\t        c = Creature(name=\"Ground Bear\", base_power=2, base_toughness=2)\n311\t        c.keywords = Keyword(0)\n312\t        c.is_tapped = False\n313\t        return c\n314\t\n315\t    @staticmethod\n316\t    def _flying_creature() -> Creature:\n317\t        c = Creature(name=\"Air Bear\", base_power=2, base_toughness=2)\n318\t        c.keywords = Keyword.FLYING\n319\t        c.is_tapped = False\n320\t        return c\n321\t\n322\t    @staticmethod\n323\t    def _reach_creature() -> Creature:\n324\t        c = Creature(name=\"Spider\", base_power=1, base_toughness=4)\n325\t        c.keywords = Keyword.REACH\n326\t        c.is_tapped = False\n327\t        return c\n328\t\n329\t    def test_ground_creature_cannot_block_flying_attacker(self) -> None:\n330\t        attacker = HealersHawk(owner=None)\n331\t        blocker = self._ground_creature()\n332\t        assert _can_block(blocker, attacker) is False\n333\t\n334\t    def test_flying_blocker_can_block_flying_attacker(self) -> None:\n335\t        attacker = HealersHawk(owner=None)\n336\t        blocker = self._flying_creature()\n337\t        assert _can_block(blocker, attacker) is True\n338\t\n339\t    def test_reach_blocker_can_block_flying_attacker(self) -> None:\n340\t        attacker = HealersHawk(owner=None)\n341\t        blocker = self._reach_creature()\n342\t        assert _can_block(blocker, attacker) is True\n343\t\n344\t    def test_tapped_creature_cannot_block(self) -> None:\n345\t        \"\"\"Tapped creatures cannot be declared as blockers at all.\"\"\"\n346\t        attacker = HealersHawk(owner=None)\n347\t        blocker = self._flying_creature()\n348\t        blocker.is_tapped = True\n349\t        assert _can_block(blocker, attacker) is False\n350\t\n351\t===== FDN 205 SPEC =====\n352\t{\n353\t  \"name\": \"Wardens of the Cycle\",\n354\t  \"mana_cost\": \"{3}{B}{G}\",\n355\t  \"type_line\": \"Creature — Treefolk\",\n356\t  \"oracle_text\": \"Converge — When this creature enters, create a 1/1 green Saproling creature token for each color of mana spent to cast it.\",\n357\t  \"power\": \"4\",\n358\t  \"toughness\": \"4\",\n359\t  \"loyalty\": null,\n360\t  \"colors\": [\n361\t    \"B\",\n362\t    \"G\"\n363\t  ],\n364\t  \"keywords\": [\n365\t    \"Converge\"\n366\t  ],\n367\t  \"rarity\": \"uncommon\",\n368\t  \"set_code\": \"fdn\",\n369\t  \"collector_number\": \"205\",\n370\t  \"complexity_tier\": \"medium\"\n371\t}\n372\t\n373\t===== FDN 205 IMPL =====\n374\t\"\"\"Card implementation for Wardens of the Cycle (FDN #205 slot).\n375\t\n376\tDemonstrates converge / mana-color tracking.  Wardens of the Cycle is a\n377\tmulticolor creature whose enter-the-battlefield ability creates a number\n378\tof 1/1 Saproling tokens equal to the number of distinct colors of mana\n379\tspent to cast it (converge mechanic).\n380\t\"\"\"\n381\t\n382\tfrom __future__ import annotations\n383\t\n384\tfrom typing import TYPE_CHECKING, Any\n385\t\n386\tfrom engine.card import Creature\n387\tfrom engine.types import CardType, Keyword, ManaCost\n388\t\n389\tif TYPE_CHECKING:\n390\t    from engine.game_state import GameState\n391\t\n392\t\n393\tclass WardensOfTheCycle(Creature):\n394\t    \"\"\"Wardens of the Cycle — {3}{B}{G} — 4/4 — Treefolk.\n395\t\n396\t    Converge — When this creature enters, create a 1/1 green Saproling\n397\t    creature token for each color of mana spent to cast it.\n398\t\n399\t    FDN collector number 205 (reference slot for converge/mana-color tracking).\n400\t    \"\"\"\n401\t\n402\t    def __init__(self, **kwargs: Any) -> None:\n403\t        kwargs.setdefault(\"name\", \"Wardens of the Cycle\")\n404\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{3}{B}{G}\"))\n405\t        kwargs.setdefault(\"subtypes\", {\"Treefolk\"})\n406\t        kwargs.setdefault(\"keywords\", Keyword(0))\n407\t        kwargs.setdefault(\"base_power\", 4)\n408\t        kwargs.setdefault(\"base_toughness\", 4)\n409\t        kwargs.setdefault(\n410\t            \"rules_text\",\n411\t            \"Converge — When this creature enters, create a 1/1 green \"\n412\t            \"Saproling creature token for each color of mana spent to cast it.\",\n413\t        )\n414\t        super().__init__(**kwargs)\n415\t        # Tracks colors spent when cast (set externally by cast logic or tests).\n416\t        self.colors_spent: int = 0\n417\t\n418\t    def on_resolve(self, game: \"GameState\") -> None:\n419\t        \"\"\"ETB: create Saproling tokens equal to distinct colors of mana spent.\"\"\"\n420\t        from engine.game import create_token\n421\t\n422\t        controller = self.controller\n423\t        if controller is None:\n424\t            return\n425\t\n426\t        # Use colors_spent attribute (set during casting or by test setup).\n427\t        count = self.colors_spent\n428\t\n429\t        for _ in range(count):\n430\t            token = Creature(\n431\t                name=\"Saproling\",\n432\t                subtypes={\"Saproling\"},\n433\t                base_power=1,\n434\t                base_toughness=1,\n435\t            )\n436\t            create_token(game, controller, token)\n437\t\n438\t===== FDN 205 TESTS =====\n439\t\"\"\"Reference test for FDN 205 — Wardens of the Cycle.\n440\t\n441\tIllustrative test covering the **converge** / mana-color tracking mechanic.\n442\tThe number of distinct colors of mana spent to cast this creature\n443\tdetermines how many Saproling tokens enter the battlefield. The engine\n444\trecords this on the card as ``colors_spent`` during cost payment; the\n445\tcard's ``on_resolve`` reads that value to drive token creation.\n446\t\"\"\"\n447\t\n448\tfrom __future__ import annotations\n449\t\n450\tfrom cards.fdn.fdn_205.card_impl import WardensOfTheCycle\n451\tfrom engine.card import Creature\n452\tfrom engine.types import ManaCost, Zone\n453\tfrom test_utils import create_game\n454\t\n455\t\n456\tclass TestWardensProperties:\n457\t    \"\"\"Static card data should match the FDN 205 spec.\"\"\"\n458\t\n459\t    def test_name(self) -> None:\n460\t        card = WardensOfTheCycle(owner=None)\n461\t        assert card.name == \"Wardens of the Cycle\"\n462\t\n463\t    def test_mana_cost(self) -> None:\n464\t        card = WardensOfTheCycle(owner=None)\n465\t        assert card.mana_cost == ManaCost.parse(\"{3}{B}{G}\")\n466\t\n467\t    def test_power_toughness(self) -> None:\n468\t        card = WardensOfTheCycle(owner=None)\n469\t        assert card.base_power == 4\n470\t        assert card.base_toughness == 4\n471\t\n472\t\n473\tclass TestWardensConverge:\n474\t    \"\"\"Converge: one Saproling per distinct color spent.\n475\t\n476\t    The cast pipeline writes ``colors_spent`` onto the card from the\n477\t    payer's ``mana_pool.last_payment_colors``; the card reads it on\n478\t    resolution. These tests bypass the cast pipeline and set\n479\t    ``colors_spent`` directly so the converge logic can be exercised\n480\t    in isolation.\n481\t    \"\"\"\n482\t\n483\t    def test_colors_spent_defaults_to_zero(self) -> None:\n484\t        card = WardensOfTheCycle(owner=None)\n485\t        assert card.colors_spent == 0\n486\t\n487\t    def test_two_colors_creates_two_saprolings(self) -> None:\n488\t        game = create_game()\n489\t        p1 = game.players[0]\n490\t        card = WardensOfTheCycle(owner=p1, controller=p1)\n491\t        card.colors_spent = 2  # BG payment example\n492\t        before = len(game.get_battlefield(p1).get_all())\n493\t        card.on_resolve(game)\n494\t        after = len(game.get_battlefield(p1).get_all())\n495\t        assert after - before == 2\n496\t\n497\t    def test_five_colors_creates_five_saprolings(self) -> None:\n498\t        game = create_game()\n499\t        p1 = game.players[0]\n500\t        card = WardensOfTheCycle(owner=p1, controller=p1)\n501\t        card.colors_spent = 5  # WUBRG payment example\n502\t        before = len(game.get_battlefield(p1).get_all())\n503\t        card.on_resolve(game)\n504\t        after = len(game.get_battlefield(p1).get_all())\n505\t        assert after - before == 5\n506\t\n507\t    def test_tokens_are_one_one_saprolings(self) -> None:\n508\t        game = create_game()\n509\t        p1 = game.players[0]\n510\t        card = WardensOfTheCycle(owner=p1, controller=p1)\n511\t        card.colors_spent = 1\n512\t        card.on_resolve(game)\n513\t        bf_creatures = [\n514\t            obj for obj in game.get_battlefield(p1).get_all()\n515\t            if isinstance(obj, Creature) and \"Saproling\" in getattr(obj, \"subtypes\", set())\n516\t        ]\n517\t        assert len(bf_creatures) == 1\n518\t        tok = bf_creatures[0]\n519\t        assert tok.base_power == 1\n520\t        assert tok.base_toughness == 1\n521\t\n522\t===== FDN 215 SPEC =====\n523\t{\n524\t  \"name\": \"Bushwhack\",\n525\t  \"mana_cost\": \"{G}\",\n526\t  \"type_line\": \"Sorcery\",\n527\t  \"oracle_text\": \"Choose one —\\n• Search your library for a basic land card, reveal it, put it into your hand, then shuffle.\\n• Target creature you control fights target creature you don't control. (Each deals damage equal to its power to the other.)\",\n528\t  \"power\": null,\n529\t  \"toughness\": null,\n530\t  \"loyalty\": null,\n531\t  \"colors\": [\n532\t    \"G\"\n533\t  ],\n534\t  \"keywords\": [\n535\t    \"Fight\"\n536\t  ],\n537\t  \"rarity\": \"common\",\n538\t  \"set_code\": \"fdn\",\n539\t  \"collector_number\": \"215\",\n540\t  \"complexity_tier\": \"medium\"\n541\t}\n542\t\n543\t===== FDN 215 IMPL =====\n544\t\"\"\"Card implementation for Bushwhack.\"\"\"\n545\t\n546\tfrom __future__ import annotations\n547\tfrom typing import TYPE_CHECKING, Any\n548\tfrom engine.card import Creature, Instant, Mode, Sorcery\n549\tfrom engine.continuous_effects import (\n550\t    ContinuousEffect,\n551\t    DURATION_END_OF_TURN,\n552\t    Layer,\n553\t    SubLayer,\n554\t)\n555\tfrom engine.types import CardType, Keyword, ManaCost, Zone\n556\tif TYPE_CHECKING:\n557\t    from engine.game_state import GameState\n558\t\n559\t    from cards.registry import CardRegistry\n560\t\n561\tdef _get_controller(card: Any) -> Any:\n562\t    \"\"\"Return the controller of a card, or None.\"\"\"\n563\t    return getattr(card, \"controller\", None)\n564\tdef _get_target(card: Any) -> Any:\n565\t    \"\"\"Return the first chosen target or the _resolve_target fallback.\"\"\"\n566\t    chosen = getattr(card, \"chosen_targets\", None)\n567\t    if chosen:\n568\t        return chosen[0]\n569\t    return getattr(card, \"_resolve_target\", None)\n570\tdef _get_targets(card: Any) -> list[Any]:\n571\t    \"\"\"Return chosen targets list.\"\"\"\n572\t    return getattr(card, \"chosen_targets\", []) or []\n573\t\n574\tclass Bushwhack(Sorcery):\n575\t    \"\"\"Bushwhack — {G} — Choose one.\n576\t\n577\t    - Search your library for a basic land card, reveal it, put it into\n578\t      your hand, then shuffle.\n579\t    - Target creature you control fights target creature you don't control.\n580\t\n581\t    FDN collector number 215.\n582\t    \"\"\"\n583\t\n584\t    def __init__(self, **kwargs: Any) -> None:\n585\t        kwargs.setdefault(\"name\", \"Bushwhack\")\n586\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{G}\"))\n587\t        kwargs.setdefault(\n588\t            \"rules_text\",\n589\t            \"Choose one —\\n\"\n590\t            \"• Search your library for a basic land card, reveal it, put it into your hand, then shuffle.\\n\"\n591\t            \"• Target creature you control fights target creature you don't control.\",\n592\t        )\n593\t        super().__init__(**kwargs)\n594\t        self.chosen_mode: int | None = None\n595\t\n596\t    def get_modes(self) -> list[Mode]:\n597\t        return [\n598\t            Mode(name=\"Land Search\", description=\"Search your library for a basic land card, reveal it, put it into your hand, then shuffle.\"),\n599\t            Mode(name=\"Fight\", description=\"Target creature you control fights target creature you don't control.\"),\n600\t        ]\n601\t\n602\t    def on_resolve(self, game: GameState) -> None:\n603\t        mode = self.chosen_mode\n604\t        if mode is None:\n605\t            return\n606\t        controller = _get_controller(self)\n607\t        if controller is None:\n608\t            return\n609\t        if mode == 0:\n610\t            # Search library for a basic land.\n611\t            from engine.types import Supertype\n612\t            library = controller.zones[Zone.LIBRARY]\n613\t            found = False\n614\t            for card in library.get_all():\n615\t                if (CardType.LAND in getattr(card, \"card_types\", set())\n616\t                        and Supertype.BASIC in getattr(card, \"supertypes\", set())):\n617\t                    library.remove(card)\n618\t                    controller.zones[Zone.HAND].add(card)\n619\t                    found = True\n620\t                    break\n621\t            library.shuffle()\n622\t        elif mode == 1:\n623\t            # Fight\n624\t            from engine.game import deal_damage\n625\t            targets = _get_targets(self)\n626\t            if len(targets) >= 2:\n627\t                a, b = targets[0], targets[1]\n628\t                deal_damage(game, a, b, getattr(a, \"power\", 0))\n629\t                deal_damage(game, b, a, getattr(b, \"power\", 0))\n630\t\n631\t===== FDN 215 TESTS =====\n632\t\"\"\"Reference test for FDN 215 — Bushwhack.\n633\t\n634\tIllustrative test covering **modal-choice / mode selection** mechanics.\n635\tBushwhack is a \"Choose one\" sorcery; the active mode is recorded on the\n636\tcard as ``chosen_mode`` (an int index into ``get_modes()``) and\n637\t``on_resolve`` dispatches on that value.\n638\t\"\"\"\n639\t\n640\tfrom __future__ import annotations\n641\t\n642\tfrom cards.fdn.fdn_215.card_impl import Bushwhack\n643\tfrom engine.card import Mode, Sorcery\n644\tfrom engine.types import CardType, ManaCost, Supertype, Zone\n645\tfrom test_utils import create_game\n646\t\n647\t\n648\tclass TestBushwhackProperties:\n649\t    \"\"\"Static card data should match the FDN 215 spec.\"\"\"\n650\t\n651\t    def test_is_sorcery(self) -> None:\n652\t        card = Bushwhack(owner=None)\n653\t        assert isinstance(card, Sorcery)\n654\t\n655\t    def test_name(self) -> None:\n656\t        assert Bushwhack(owner=None).name == \"Bushwhack\"\n657\t\n658\t    def test_mana_cost(self) -> None:\n659\t        assert Bushwhack(owner=None).mana_cost == ManaCost.parse(\"{G}\")\n660\t\n661\t\n662\tclass TestBushwhackModalDeclaration:\n663\t    \"\"\"get_modes() should declare exactly two modes.\"\"\"\n664\t\n665\t    def test_returns_two_modes(self) -> None:\n666\t        modes = Bushwhack(owner=None).get_modes()\n667\t        assert len(modes) == 2\n668\t\n669\t    def test_each_mode_is_mode_instance(self) -> None:\n670\t        modes = Bushwhack(owner=None).get_modes()\n671\t        for m in modes:\n672\t            assert isinstance(m, Mode)\n673\t\n674\t\n675\tclass TestBushwhackModeSelection:\n676\t    \"\"\"chosen_mode drives the on_resolve branch.\"\"\"\n677\t\n678\t    def test_chosen_mode_defaults_to_none(self) -> None:\n679\t        card = Bushwhack(owner=None)\n680\t        assert card.chosen_mode is None\n681\t\n682\t    def test_chosen_mode_zero_runs_land_search(self) -> None:\n683\t        \"\"\"Mode 0 = search library for a basic land. With no basic lands\n684\t        in the library, the search no-ops but does not raise.\"\"\"\n685\t        from engine.card import CardImpl\n686\t\n687\t        game = create_game()\n688\t        p1 = game.players[0]\n689\t        # Library is empty — search will find nothing but should not crash.\n690\t        card = Bushwhack(owner=p1, controller=p1)\n691\t        card.chosen_mode = 0\n692\t        card.on_resolve(game)\n693\t        # No card moved to hand.\n694\t        assert len(p1.zones[Zone.HAND].get_all()) == 0\n695\t\n696\t    def test_chosen_mode_one_runs_fight_branch(self) -> None:\n697\t        \"\"\"Mode 1 = fight. With no chosen_targets, the fight branch no-ops.\"\"\"\n698\t        game = create_game()\n699\t        p1 = game.players[0]\n700\t        card = Bushwhack(owner=p1, controller=p1)\n701\t        card.chosen_mode = 1\n702\t        # No chosen_targets — fight branch exits without dealing damage.\n703\t        card.on_resolve(game)\n704\t\n705\t    def test_no_mode_skips_resolution(self) -> None:\n706\t        \"\"\"When chosen_mode is None, on_resolve returns immediately.\"\"\"\n707\t        game = create_game()\n708\t        p1 = game.players[0]\n709\t        card = Bushwhack(owner=p1, controller=p1)\n710\t        # chosen_mode left as None.\n711\t        card.on_resolve(game)\n712\t        assert len(p1.zones[Zone.HAND].get_all()) == 0\n713\t\n714\t===== FDN 244 SPEC =====\n715\t{\n716\t  \"name\": \"Progenitus\",\n717\t  \"mana_cost\": \"{W}{W}{U}{U}{B}{B}{R}{R}{G}{G}\",\n718\t  \"type_line\": \"Legendary Creature — Hydra Avatar\",\n719\t  \"oracle_text\": \"Protection from everything\\nIf Progenitus would be put into a graveyard from anywhere, reveal Progenitus and shuffle it into its owner's library instead.\",\n720\t  \"power\": \"10\",\n721\t  \"toughness\": \"10\",\n722\t  \"loyalty\": null,\n723\t  \"colors\": [\n724\t    \"B\",\n725\t    \"G\",\n726\t    \"R\",\n727\t    \"U\",\n728\t    \"W\"\n729\t  ],\n730\t  \"keywords\": [\n731\t    \"Protection\"\n732\t  ],\n733\t  \"rarity\": \"mythic\",\n734\t  \"set_code\": \"fdn\",\n735\t  \"collector_number\": \"244\",\n736\t  \"complexity_tier\": \"medium\"\n737\t}\n738\t\n739\t===== FDN 244 IMPL =====\n740\t\"\"\"Card implementation for Progenitus.\"\"\"\n741\tfrom __future__ import annotations\n742\tfrom typing import TYPE_CHECKING, Any\n743\tfrom engine.card import Creature\n744\tfrom engine.protection import ProtectionAbility\n745\tfrom engine.events import MoveToGraveyardReplacementEvent\n746\tfrom engine.replacement_effects import ReplacementEffect\n747\tfrom engine.types import ManaCost, Supertype, Zone\n748\tif TYPE_CHECKING:\n749\t    from engine.game_state import GameState\n750\t\n751\tclass Progenitus(Creature):\n752\t    \"\"\"Progenitus — {W}{W}{U}{U}{B}{B}{R}{R}{G}{G} — 10/10 — Legendary Hydra Avatar.\n753\t\n754\t    Protection from everything.\n755\t    If Progenitus would be put into a graveyard from anywhere, reveal\n756\t    Progenitus and shuffle it into its owner's library instead.\n757\t\n758\t    FDN collector number 244.\n759\t    \"\"\"\n760\t\n761\t    def __init__(self, **kwargs: Any) -> None:\n762\t        kwargs.setdefault('name', 'Progenitus')\n763\t        kwargs.setdefault('mana_cost', ManaCost.parse('{W}{W}{U}{U}{B}{B}{R}{R}{G}{G}'))\n764\t        kwargs.setdefault('subtypes', {'Hydra', 'Avatar'})\n765\t        kwargs.setdefault('supertypes', {Supertype.LEGENDARY})\n766\t        kwargs.setdefault('base_power', 10)\n767\t        kwargs.setdefault('base_toughness', 10)\n768\t        kwargs.setdefault('rules_text', \"Protection from everything\\nIf Progenitus would be put into a graveyard from anywhere, reveal Progenitus and shuffle it into its owner's library instead.\")\n769\t        super().__init__(**kwargs)\n770\t        self._init_protection()\n771\t\n772\t    def _init_protection(self) -> None:\n773\t        \"\"\"Set up protection from everything. Called from __init__ and\n774\t        can be re-invoked after characteristic resets.\"\"\"\n775\t        self.protections = [ProtectionAbility(quality='everything', predicate=lambda source: True)]\n776\t\n777\t    def _reset_characteristics(self) -> None:\n778\t        \"\"\"Override to reapply protection from everything after reset.\"\"\"\n779\t        super()._reset_characteristics()\n780\t        self._init_protection()\n781\t\n782\t    def register_replacement_effects(self, game: 'GameState') -> None:\n783\t        \"\"\"Register graveyard-shuffle replacement effect.\n784\t\n785\t        Registers a single :class:`~engine.events.MoveToGraveyardReplacementEvent`\n786\t        handler; the engine's zone-move pipeline dispatches subclass events\n787\t        (creature_dies, sacrifice, etc.) to this parent-type handler automatically.\n788\t        \"\"\"\n789\t        source = self\n790\t\n791\t        def _condition(game: Any, event: dict) -> bool:\n792\t            return event.card is source\n793\t\n794\t        def _replacement(game: Any, event: dict) -> dict:\n795\t            owner = getattr(source, 'owner', None)\n796\t            if owner is not None:\n797\t                library = owner.zones[Zone.LIBRARY]\n798\t                library.add(source)\n799\t                library.shuffle()\n800\t            event.prevented = True\n801\t            return event\n802\t        controller = getattr(self, 'controller', None)\n803\t        game.replacement_manager.register(ReplacementEffect(event_type=MoveToGraveyardReplacementEvent, source=self, condition=_condition, replacement=_replacement, controller=controller))\n804\t\n805\t===== FDN 244 TESTS =====\n806\t\"\"\"Reference test for FDN 244 — Progenitus.\n807\t\n808\tIllustrative test covering **replacement effects** via\n809\t``game.replacement_manager.register()``. Progenitus has a continuous\n810\treplacement that intercepts any ``MoveToGraveyardReplacementEvent``\n811\ttargeting itself and redirects the card to its owner's library instead\n812\tof the graveyard. The replacement callback sets ``event.prevented`` to\n813\tsignal that the engine should skip its own zone move, and returns the\n814\tmodified event.\n815\t\"\"\"\n816\t\n817\tfrom __future__ import annotations\n818\t\n819\tfrom cards.fdn.fdn_244.card_impl import Progenitus\n820\tfrom engine.card import Creature\n821\tfrom engine.events import (\n822\t    CreatureDiesReplacementEvent,\n823\t    MoveToGraveyardReplacementEvent,\n824\t)\n825\tfrom engine.replacement_effects import ReplacementEffect\n826\tfrom engine.types import ManaCost, Supertype, Zone\n827\tfrom test_utils import create_game\n828\t\n829\t\n830\tclass TestProgenitusProperties:\n831\t    \"\"\"Static card data should match the FDN 244 spec.\"\"\"\n832\t\n833\t    def test_name(self) -> None:\n834\t        assert Progenitus(owner=None).name == \"Progenitus\"\n835\t\n836\t    def test_mana_cost(self) -> None:\n837\t        cost = ManaCost.parse(\"{W}{W}{U}{U}{B}{B}{R}{R}{G}{G}\")\n838\t        assert Progenitus(owner=None).mana_cost == cost\n839\t\n840\t    def test_legendary_hydra_avatar(self) -> None:\n841\t        card = Progenitus(owner=None)\n842\t        assert Supertype.LEGENDARY in card.supertypes\n843\t        assert {\"Hydra\", \"Avatar\"} <= card.subtypes\n844\t\n845\t\n846\tclass TestProgenitusReplacementRegistration:\n847\t    \"\"\"register_replacement_effects must wire a ReplacementEffect for\n848\t    MoveToGraveyardReplacementEvent through the replacement_manager.\"\"\"\n849\t\n850\t    def test_registers_one_replacement_effect(self) -> None:\n851\t        game = create_game()\n852\t        p1 = game.players[0]\n853\t        card = Progenitus(owner=p1, controller=p1)\n854\t        before = len(game.replacement_manager._effects)\n855\t        card.register_replacement_effects(game)\n856\t        after = len(game.replacement_manager._effects)\n857\t        assert after - before == 1\n858\t\n859\t    def test_registered_replacement_uses_typed_event_class(self) -> None:\n860\t        \"\"\"The registered ReplacementEffect must use the typed\n861\t        MoveToGraveyardReplacementEvent class, not a string event name.\"\"\"\n862\t        game = create_game()\n863\t        p1 = game.players[0]\n864\t        card = Progenitus(owner=p1, controller=p1)\n865\t        card.register_replacement_effects(game)\n866\t        registered = next(\n867\t            (e for e in game.replacement_manager._effects if e.source is card),\n868\t            None,\n869\t        )\n870\t        assert registered is not None\n871\t        assert isinstance(registered, ReplacementEffect)\n872\t        assert registered.event_type is MoveToGraveyardReplacementEvent\n873\t\n874\t\n875\tclass TestProgenitusGraveyardReplacement:\n876\t    \"\"\"The replacement callback shuffles the card into its owner's\n877\t    library and prevents the move to graveyard.\"\"\"\n878\t\n879\t    def test_replacement_redirects_to_library_and_prevents(self) -> None:\n880\t        game = create_game()\n881\t        p1 = game.players[0]\n882\t        card = Progenitus(owner=p1, controller=p1)\n883\t        card.register_replacement_effects(game)\n884\t        # Use the creature-dies subclass so the event's ``card`` property\n885\t        # resolves to this Progenitus instance (the base class's ``card``\n886\t        # property returns None).\n887\t        event = CreatureDiesReplacementEvent(\n888\t            creature=card,\n889\t            destination=\"graveyard\",\n890\t            controller=p1,\n891\t            owner=p1,\n892\t        )\n893\t        result = game.replacement_manager.apply(game, event)\n894\t        # Replacement callback should return the event with prevented=True\n895\t        # and shuffle the card into the library.\n896\t        assert result.prevented is True\n897\t        library = p1.zones[Zone.LIBRARY]\n898\t        assert library.contains(card)\n899\t\n900\t\n901\t\n902\t"}]},"parent_tool_use_id":null,"session_id":"7182fe58-6bea-420a-b90d-6a2af4b380c1","uuid":"21da0f33-47fc-4dbb-bb1c-983796d5d9d2","timestamp":"2026-05-30T07:49:57.238Z","tool_use_result":{"type":"text","file":{"filePath":"/home/node/.claude/projects/-workspace/7182fe58-6bea-420a-b90d-6a2af4b380c1/tool-results/brrg3un98.txt","content":"===== FDN 13 SPEC =====\n{\n  \"name\": \"Fleeting Flight\",\n  \"mana_cost\": \"{W}\",\n  \"type_line\": \"Instant\",\n  \"oracle_text\": \"Put a +1/+1 counter on target creature. It gains flying until end of turn. Prevent all combat damage that would be dealt to it this turn.\",\n  \"power\": null,\n  \"toughness\": null,\n  \"loyalty\": null,\n  \"colors\": [\n    \"W\"\n  ],\n  \"keywords\": [],\n  \"rarity\": \"common\",\n  \"set_code\": \"fdn\",\n  \"collector_number\": \"13\",\n  \"complexity_tier\": \"medium\"\n}\n\n===== FDN 13 IMPL =====\n\"\"\"Card implementation for Fleeting Flight.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import Instant\nfrom engine.continuous_effects import (\n    ContinuousEffect,\n    DURATION_END_OF_TURN,\n    Layer,\n)\nfrom engine.types import CardType, Keyword, ManaCost, TargetRequirement, Zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\ndef _is_on_battlefield(game: Any, obj: Any) -> bool:\n    \"\"\"Return True if *obj* is on any player's battlefield.\"\"\"\n    for player in game.players:\n        if game.get_battlefield(player).contains(obj):\n            return True\n    return False\n\n\nclass FleetingFlight(Instant):\n    \"\"\"Fleeting Flight — {W} — Instant.\n\n    Put a +1/+1 counter on target creature. It gains flying until end of\n    turn. Prevent all combat damage that would be dealt to it this turn.\n\n    FDN collector number 13.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"Fleeting Flight\")\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{W}\"))\n        kwargs.setdefault(\n            \"rules_text\",\n            \"Put a +1/+1 counter on target creature. It gains flying \"\n            \"until end of turn. Prevent all combat damage that would be \"\n            \"dealt to it this turn.\",\n        )\n        super().__init__(**kwargs)\n\n    def get_targets(self, game: \"GameState\") -> list[Any]:\n        \"\"\"Target creature.\"\"\"\n        return [\n            TargetRequirement(\n                filter_fn=lambda obj: CardType.CREATURE in getattr(obj, \"card_types\", set()),\n                description=\"target creature\",\n                zone=Zone.BATTLEFIELD,\n            )\n        ]\n\n    def on_resolve(self, game: \"GameState\") -> None:\n        \"\"\"Put +1/+1 counter, grant flying until EOT, prevent combat damage.\"\"\"\n        chosen = getattr(self, \"chosen_targets\", None)\n        target = chosen[0] if chosen else getattr(self, \"_resolve_target\", None)\n        if target is None:\n            return\n\n        if not _is_on_battlefield(game, target):\n            return\n        if CardType.CREATURE not in getattr(target, \"card_types\", set()):\n            return\n\n        # +1/+1 counter\n        from engine.game import add_counter\n\n        add_counter(game, target, \"+1/+1\", 1)\n        # Sync original counters per KEY_DECISIONS\n        if hasattr(target, \"_base_plus_one_counters\"):\n            target._base_plus_one_counters = target.plus_one_counters\n\n        # Flying until end of turn\n        creature_ref = target\n\n        def _apply_flying(game: Any) -> None:\n            if not _is_on_battlefield(game, creature_ref):\n                return\n            creature_ref.keywords = getattr(\n                creature_ref, \"keywords\", Keyword(0)\n            ) | Keyword.FLYING\n\n        game.effect_manager.add(ContinuousEffect(\n            source=self,\n            layer=Layer.ABILITY,\n            sublayer=None,\n            apply=_apply_flying,\n            duration=DURATION_END_OF_TURN,\n        ))\n\n        # ENGINE LIMITATION: \"Prevent all combat damage that would be dealt\n        # to it this turn\" requires a damage prevention shield / replacement\n        # effect, which the engine does not support. The flag is set on the\n        # creature but will only work if the combat system checks it.\n        creature_ref.combat_damage_prevented = True\n\n===== FDN 13 TESTS =====\n\"\"\"Reference test for FDN 13 — Fleeting Flight.\n\nIllustrative test covering **target selection / validation**. Fleeting\nFlight is a targeted instant: ``get_targets()`` returns a\n``TargetRequirement`` describing what is legal, and the cast pipeline\npopulates ``chosen_targets`` with the player's selection. ``on_resolve``\nreads ``chosen_targets`` and applies the effect to the chosen target.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom cards.fdn.fdn_13.card_impl import FleetingFlight\nfrom engine.card import Creature, Instant\nfrom engine.types import (\n    CardType,\n    Keyword,\n    ManaCost,\n    TargetRequirement,\n    Zone,\n)\nfrom test_utils import create_game\n\n\nclass TestFleetingFlightProperties:\n    \"\"\"Static card data should match the FDN 13 spec.\"\"\"\n\n    def test_is_instant(self) -> None:\n        assert isinstance(FleetingFlight(owner=None), Instant)\n\n    def test_name(self) -> None:\n        assert FleetingFlight(owner=None).name == \"Fleeting Flight\"\n\n    def test_mana_cost(self) -> None:\n        assert FleetingFlight(owner=None).mana_cost == ManaCost.parse(\"{W}\")\n\n\nclass TestFleetingFlightTargeting:\n    \"\"\"get_targets() advertises a single creature target on the battlefield.\"\"\"\n\n    def test_returns_single_target_requirement(self) -> None:\n        game = create_game()\n        reqs = FleetingFlight(owner=None).get_targets(game)\n        assert isinstance(reqs, list)\n        assert len(reqs) == 1\n        assert isinstance(reqs[0], TargetRequirement)\n\n    def test_target_zone_is_battlefield(self) -> None:\n        game = create_game()\n        req = FleetingFlight(owner=None).get_targets(game)[0]\n        assert req.zone == Zone.BATTLEFIELD\n\n    def test_target_filter_accepts_creature(self) -> None:\n        \"\"\"The filter must accept creatures and reject non-creatures.\"\"\"\n        game = create_game()\n        req = FleetingFlight(owner=None).get_targets(game)[0]\n\n        creature = Creature(name=\"Test Bear\", base_power=2, base_toughness=2)\n        creature.card_types = {CardType.CREATURE}\n        non_creature = Creature(name=\"Not a creature\")  # no card_types\n        non_creature.card_types = set()\n\n        assert req.filter_fn(creature) is True\n        assert req.filter_fn(non_creature) is False\n\n\nclass TestFleetingFlightResolution:\n    \"\"\"on_resolve reads chosen_targets and applies the effect.\"\"\"\n\n    def test_no_target_is_a_noop(self) -> None:\n        game = create_game()\n        p1 = game.players[0]\n        spell = FleetingFlight(owner=p1, controller=p1)\n        # chosen_targets is unset — resolution must not raise.\n        spell.on_resolve(game)\n\n    def test_chosen_target_receives_counter_and_flying(self) -> None:\n        game = create_game()\n        p1 = game.players[0]\n\n        # Put a vanilla bear on the battlefield as the target.\n        bear = Creature(\n            name=\"Grizzly Bears\",\n            owner=p1,\n            controller=p1,\n            base_power=2,\n            base_toughness=2,\n        )\n        bear.card_types = {CardType.CREATURE}\n        game.get_battlefield(p1).add(bear)\n\n        spell = FleetingFlight(owner=p1, controller=p1)\n        # The cast pipeline would set chosen_targets; we set it directly\n        # to validate that on_resolve reads it correctly.\n        spell.chosen_targets = [bear]\n        before = bear.plus_one_counters\n        spell.on_resolve(game)\n        # +1/+1 counter applied to the chosen target.\n        assert bear.plus_one_counters == before + 1\n        # Damage-prevention flag set per the card's \"prevent all combat\n        # damage\" clause.\n        assert bear.combat_damage_prevented is True\n\n===== FDN 142 SPEC =====\n{\n  \"name\": \"Healer's Hawk\",\n  \"mana_cost\": \"{W}\",\n  \"type_line\": \"Creature — Bird\",\n  \"oracle_text\": \"Flying\\nLifelink (Damage dealt by this creature also causes you to gain that much life.)\",\n  \"power\": \"1\",\n  \"toughness\": \"1\",\n  \"loyalty\": null,\n  \"colors\": [\n    \"W\"\n  ],\n  \"keywords\": [\n    \"Flying\",\n    \"Lifelink\"\n  ],\n  \"rarity\": \"common\",\n  \"set_code\": \"fdn\",\n  \"collector_number\": \"142\",\n  \"complexity_tier\": \"medium\"\n}\n\n===== FDN 142 IMPL =====\n\"\"\"Card implementation for Healer's Hawk.\"\"\"\n\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING\n\nfrom engine.creatures import make_vanilla\nfrom engine.types import Keyword\n\nif TYPE_CHECKING:\n    from cards.registry import CardRegistry\n\nHealersHawk = make_vanilla(\n    \"Healer's Hawk\", \"{W}\", 1, 1,\n    keywords=Keyword.FLYING | Keyword.LIFELINK,\n    creature_types={\"Bird\"},\n)\n\n===== FDN 142 TESTS =====\n\"\"\"Reference test for FDN 142 — Healer's Hawk.\n\nIllustrative test covering **blocker declaration / blocking restrictions**.\nHealer's Hawk is a 1/1 with Flying + Lifelink. The flying keyword\nrestricts which creatures can legally block it: per the rules, a flying\nattacker can only be blocked by creatures with flying or reach. The\nengine encodes this in :func:`engine.combat._can_block`.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom cards.fdn.fdn_142.card_impl import HealersHawk\nfrom engine.card import Creature\nfrom engine.combat import _can_block\nfrom engine.types import Keyword, ManaCost\n\n\nclass TestHealersHawkProperties:\n    \"\"\"Static card data should match the FDN 142 spec.\"\"\"\n\n    def test_is_creature(self) -> None:\n        assert isinstance(HealersHawk(owner=None), Creature)\n\n    def test_name(self) -> None:\n        assert HealersHawk(owner=None).name == \"Healer's Hawk\"\n\n    def test_mana_cost(self) -> None:\n        assert HealersHawk(owner=None).mana_cost == ManaCost.parse(\"{W}\")\n\n    def test_power_toughness(self) -> None:\n        card = HealersHawk(owner=None)\n        assert card.base_power == 1\n        assert card.base_toughness == 1\n\n    def test_has_flying_and_lifelink(self) -> None:\n        kw = HealersHawk(owner=None).keywords\n        assert Keyword.FLYING in kw\n        assert Keyword.LIFELINK in kw\n\n\nclass TestHealersHawkBlockerRules:\n    \"\"\"Flying restricts which creatures can legally block this attacker.\"\"\"\n\n    @staticmethod\n    def _ground_creature() -> Creature:\n        c = Creature(name=\"Ground Bear\", base_power=2, base_toughness=2)\n        c.keywords = Keyword(0)\n        c.is_tapped = False\n        return c\n\n    @staticmethod\n    def _flying_creature() -> Creature:\n        c = Creature(name=\"Air Bear\", base_power=2, base_toughness=2)\n        c.keywords = Keyword.FLYING\n        c.is_tapped = False\n        return c\n\n    @staticmethod\n    def _reach_creature() -> Creature:\n        c = Creature(name=\"Spider\", base_power=1, base_toughness=4)\n        c.keywords = Keyword.REACH\n        c.is_tapped = False\n        return c\n\n    def test_ground_creature_cannot_block_flying_attacker(self) -> None:\n        attacker = HealersHawk(owner=None)\n        blocker = self._ground_creature()\n        assert _can_block(blocker, attacker) is False\n\n    def test_flying_blocker_can_block_flying_attacker(self) -> None:\n        attacker = HealersHawk(owner=None)\n        blocker = self._flying_creature()\n        assert _can_block(blocker, attacker) is True\n\n    def test_reach_blocker_can_block_flying_attacker(self) -> None:\n        attacker = HealersHawk(owner=None)\n        blocker = self._reach_creature()\n        assert _can_block(blocker, attacker) is True\n\n    def test_tapped_creature_cannot_block(self) -> None:\n        \"\"\"Tapped creatures cannot be declared as blockers at all.\"\"\"\n        attacker = HealersHawk(owner=None)\n        blocker = self._flying_creature()\n        blocker.is_tapped = True\n        assert _can_block(blocker, attacker) is False\n\n===== FDN 205 SPEC =====\n{\n  \"name\": \"Wardens of the Cycle\",\n  \"mana_cost\": \"{3}{B}{G}\",\n  \"type_line\": \"Creature — Treefolk\",\n  \"oracle_text\": \"Converge — When this creature enters, create a 1/1 green Saproling creature token for each color of mana spent to cast it.\",\n  \"power\": \"4\",\n  \"toughness\": \"4\",\n  \"loyalty\": null,\n  \"colors\": [\n    \"B\",\n    \"G\"\n  ],\n  \"keywords\": [\n    \"Converge\"\n  ],\n  \"rarity\": \"uncommon\",\n  \"set_code\": \"fdn\",\n  \"collector_number\": \"205\",\n  \"complexity_tier\": \"medium\"\n}\n\n===== FDN 205 IMPL =====\n\"\"\"Card implementation for Wardens of the Cycle (FDN #205 slot).\n\nDemonstrates converge / mana-color tracking.  Wardens of the Cycle is a\nmulticolor creature whose enter-the-battlefield ability creates a number\nof 1/1 Saproling tokens equal to the number of distinct colors of mana\nspent to cast it (converge mechanic).\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import Creature\nfrom engine.types import CardType, Keyword, ManaCost\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\nclass WardensOfTheCycle(Creature):\n    \"\"\"Wardens of the Cycle — {3}{B}{G} — 4/4 — Treefolk.\n\n    Converge — When this creature enters, create a 1/1 green Saproling\n    creature token for each color of mana spent to cast it.\n\n    FDN collector number 205 (reference slot for converge/mana-color tracking).\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"Wardens of the Cycle\")\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{3}{B}{G}\"))\n        kwargs.setdefault(\"subtypes\", {\"Treefolk\"})\n        kwargs.setdefault(\"keywords\", Keyword(0))\n        kwargs.setdefault(\"base_power\", 4)\n        kwargs.setdefault(\"base_toughness\", 4)\n        kwargs.setdefault(\n            \"rules_text\",\n            \"Converge — When this creature enters, create a 1/1 green \"\n            \"Saproling creature token for each color of mana spent to cast it.\",\n        )\n        super().__init__(**kwargs)\n        # Tracks colors spent when cast (set externally by cast logic or tests).\n        self.colors_spent: int = 0\n\n    def on_resolve(self, game: \"GameState\") -> None:\n        \"\"\"ETB: create Saproling tokens equal to distinct colors of mana spent.\"\"\"\n        from engine.game import create_token\n\n        controller = self.controller\n        if controller is None:\n            return\n\n        # Use colors_spent attribute (set during casting or by test setup).\n        count = self.colors_spent\n\n        for _ in range(count):\n            token = Creature(\n                name=\"Saproling\",\n                subtypes={\"Saproling\"},\n                base_power=1,\n                base_toughness=1,\n            )\n            create_token(game, controller, token)\n\n===== FDN 205 TESTS =====\n\"\"\"Reference test for FDN 205 — Wardens of the Cycle.\n\nIllustrative test covering the **converge** / mana-color tracking mechanic.\nThe number of distinct colors of mana spent to cast this creature\ndetermines how many Saproling tokens enter the battlefield. The engine\nrecords this on the card as ``colors_spent`` during cost payment; the\ncard's ``on_resolve`` reads that value to drive token creation.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom cards.fdn.fdn_205.card_impl import WardensOfTheCycle\nfrom engine.card import Creature\nfrom engine.types import ManaCost, Zone\nfrom test_utils import create_game\n\n\nclass TestWardensProperties:\n    \"\"\"Static card data should match the FDN 205 spec.\"\"\"\n\n    def test_name(self) -> None:\n        card = WardensOfTheCycle(owner=None)\n        assert card.name == \"Wardens of the Cycle\"\n\n    def test_mana_cost(self) -> None:\n        card = WardensOfTheCycle(owner=None)\n        assert card.mana_cost == ManaCost.parse(\"{3}{B}{G}\")\n\n    def test_power_toughness(self) -> None:\n        card = WardensOfTheCycle(owner=None)\n        assert card.base_power == 4\n        assert card.base_toughness == 4\n\n\nclass TestWardensConverge:\n    \"\"\"Converge: one Saproling per distinct color spent.\n\n    The cast pipeline writes ``colors_spent`` onto the card from the\n    payer's ``mana_pool.last_payment_colors``; the card reads it on\n    resolution. These tests bypass the cast pipeline and set\n    ``colors_spent`` directly so the converge logic can be exercised\n    in isolation.\n    \"\"\"\n\n    def test_colors_spent_defaults_to_zero(self) -> None:\n        card = WardensOfTheCycle(owner=None)\n        assert card.colors_spent == 0\n\n    def test_two_colors_creates_two_saprolings(self) -> None:\n        game = create_game()\n        p1 = game.players[0]\n        card = WardensOfTheCycle(owner=p1, controller=p1)\n        card.colors_spent = 2  # BG payment example\n        before = len(game.get_battlefield(p1).get_all())\n        card.on_resolve(game)\n        after = len(game.get_battlefield(p1).get_all())\n        assert after - before == 2\n\n    def test_five_colors_creates_five_saprolings(self) -> None:\n        game = create_game()\n        p1 = game.players[0]\n        card = WardensOfTheCycle(owner=p1, controller=p1)\n        card.colors_spent = 5  # WUBRG payment example\n        before = len(game.get_battlefield(p1).get_all())\n        card.on_resolve(game)\n        after = len(game.get_battlefield(p1).get_all())\n        assert after - before == 5\n\n    def test_tokens_are_one_one_saprolings(self) -> None:\n        game = create_game()\n        p1 = game.players[0]\n        card = WardensOfTheCycle(owner=p1, controller=p1)\n        card.colors_spent = 1\n        card.on_resolve(game)\n        bf_creatures = [\n            obj for obj in game.get_battlefield(p1).get_all()\n            if isinstance(obj, Creature) and \"Saproling\" in getattr(obj, \"subtypes\", set())\n        ]\n        assert len(bf_creatures) == 1\n        tok = bf_creatures[0]\n        assert tok.base_power == 1\n        assert tok.base_toughness == 1\n\n===== FDN 215 SPEC =====\n{\n  \"name\": \"Bushwhack\",\n  \"mana_cost\": \"{G}\",\n  \"type_line\": \"Sorcery\",\n  \"oracle_text\": \"Choose one —\\n• Search your library for a basic land card, reveal it, put it into your hand, then shuffle.\\n• Target creature you control fights target creature you don't control. (Each deals damage equal to its power to the other.)\",\n  \"power\": null,\n  \"toughness\": null,\n  \"loyalty\": null,\n  \"colors\": [\n    \"G\"\n  ],\n  \"keywords\": [\n    \"Fight\"\n  ],\n  \"rarity\": \"common\",\n  \"set_code\": \"fdn\",\n  \"collector_number\": \"215\",\n  \"complexity_tier\": \"medium\"\n}\n\n===== FDN 215 IMPL =====\n\"\"\"Card implementation for Bushwhack.\"\"\"\n\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import Creature, Instant, Mode, Sorcery\nfrom engine.continuous_effects import (\n    ContinuousEffect,\n    DURATION_END_OF_TURN,\n    Layer,\n    SubLayer,\n)\nfrom engine.types import CardType, Keyword, ManaCost, Zone\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n    from cards.registry import CardRegistry\n\ndef _get_controller(card: Any) -> Any:\n    \"\"\"Return the controller of a card, or None.\"\"\"\n    return getattr(card, \"controller\", None)\ndef _get_target(card: Any) -> Any:\n    \"\"\"Return the first chosen target or the _resolve_target fallback.\"\"\"\n    chosen = getattr(card, \"chosen_targets\", None)\n    if chosen:\n        return chosen[0]\n    return getattr(card, \"_resolve_target\", None)\ndef _get_targets(card: Any) -> list[Any]:\n    \"\"\"Return chosen targets list.\"\"\"\n    return getattr(card, \"chosen_targets\", []) or []\n\nclass Bushwhack(Sorcery):\n    \"\"\"Bushwhack — {G} — Choose one.\n\n    - Search your library for a basic land card, reveal it, put it into\n      your hand, then shuffle.\n    - Target creature you control fights target creature you don't control.\n\n    FDN collector number 215.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"Bushwhack\")\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{G}\"))\n        kwargs.setdefault(\n            \"rules_text\",\n            \"Choose one —\\n\"\n            \"• Search your library for a basic land card, reveal it, put it into your hand, then shuffle.\\n\"\n            \"• Target creature you control fights target creature you don't control.\",\n        )\n        super().__init__(**kwargs)\n        self.chosen_mode: int | None = None\n\n    def get_modes(self) -> list[Mode]:\n        return [\n            Mode(name=\"Land Search\", description=\"Search your library for a basic land card, reveal it, put it into your hand, then shuffle.\"),\n            Mode(name=\"Fight\", description=\"Target creature you control fights target creature you don't control.\"),\n        ]\n\n    def on_resolve(self, game: GameState) -> None:\n        mode = self.chosen_mode\n        if mode is None:\n            return\n        controller = _get_controller(self)\n        if controller is None:\n            return\n        if mode == 0:\n            # Search library for a basic land.\n            from engine.types import Supertype\n            library = controller.zones[Zone.LIBRARY]\n            found = False\n            for card in library.get_all():\n                if (CardType.LAND in getattr(card, \"card_types\", set())\n                        and Supertype.BASIC in getattr(card, \"supertypes\", set())):\n                    library.remove(card)\n                    controller.zones[Zone.HAND].add(card)\n                    found = True\n                    break\n            library.shuffle()\n        elif mode == 1:\n            # Fight\n            from engine.game import deal_damage\n            targets = _get_targets(self)\n            if len(targets) >= 2:\n                a, b = targets[0], targets[1]\n                deal_damage(game, a, b, getattr(a, \"power\", 0))\n                deal_damage(game, b, a, getattr(b, \"power\", 0))\n\n===== FDN 215 TESTS =====\n\"\"\"Reference test for FDN 215 — Bushwhack.\n\nIllustrative test covering **modal-choice / mode selection** mechanics.\nBushwhack is a \"Choose one\" sorcery; the active mode is recorded on the\ncard as ``chosen_mode`` (an int index into ``get_modes()``) and\n``on_resolve`` dispatches on that value.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom cards.fdn.fdn_215.card_impl import Bushwhack\nfrom engine.card import Mode, Sorcery\nfrom engine.types import CardType, ManaCost, Supertype, Zone\nfrom test_utils import create_game\n\n\nclass TestBushwhackProperties:\n    \"\"\"Static card data should match the FDN 215 spec.\"\"\"\n\n    def test_is_sorcery(self) -> None:\n        card = Bushwhack(owner=None)\n        assert isinstance(card, Sorcery)\n\n    def test_name(self) -> None:\n        assert Bushwhack(owner=None).name == \"Bushwhack\"\n\n    def test_mana_cost(self) -> None:\n        assert Bushwhack(owner=None).mana_cost == ManaCost.parse(\"{G}\")\n\n\nclass TestBushwhackModalDeclaration:\n    \"\"\"get_modes() should declare exactly two modes.\"\"\"\n\n    def test_returns_two_modes(self) -> None:\n        modes = Bushwhack(owner=None).get_modes()\n        assert len(modes) == 2\n\n    def test_each_mode_is_mode_instance(self) -> None:\n        modes = Bushwhack(owner=None).get_modes()\n        for m in modes:\n            assert isinstance(m, Mode)\n\n\nclass TestBushwhackModeSelection:\n    \"\"\"chosen_mode drives the on_resolve branch.\"\"\"\n\n    def test_chosen_mode_defaults_to_none(self) -> None:\n        card = Bushwhack(owner=None)\n        assert card.chosen_mode is None\n\n    def test_chosen_mode_zero_runs_land_search(self) -> None:\n        \"\"\"Mode 0 = search library for a basic land. With no basic lands\n        in the library, the search no-ops but does not raise.\"\"\"\n        from engine.card import CardImpl\n\n        game = create_game()\n        p1 = game.players[0]\n        # Library is empty — search will find nothing but should not crash.\n        card = Bushwhack(owner=p1, controller=p1)\n        card.chosen_mode = 0\n        card.on_resolve(game)\n        # No card moved to hand.\n        assert len(p1.zones[Zone.HAND].get_all()) == 0\n\n    def test_chosen_mode_one_runs_fight_branch(self) -> None:\n        \"\"\"Mode 1 = fight. With no chosen_targets, the fight branch no-ops.\"\"\"\n        game = create_game()\n        p1 = game.players[0]\n        card = Bushwhack(owner=p1, controller=p1)\n        card.chosen_mode = 1\n        # No chosen_targets — fight branch exits without dealing damage.\n        card.on_resolve(game)\n\n    def test_no_mode_skips_resolution(self) -> None:\n        \"\"\"When chosen_mode is None, on_resolve returns immediately.\"\"\"\n        game = create_game()\n        p1 = game.players[0]\n        card = Bushwhack(owner=p1, controller=p1)\n        # chosen_mode left as None.\n        card.on_resolve(game)\n        assert len(p1.zones[Zone.HAND].get_all()) == 0\n\n===== FDN 244 SPEC =====\n{\n  \"name\": \"Progenitus\",\n  \"mana_cost\": \"{W}{W}{U}{U}{B}{B}{R}{R}{G}{G}\",\n  \"type_line\": \"Legendary Creature — Hydra Avatar\",\n  \"oracle_text\": \"Protection from everything\\nIf Progenitus would be put into a graveyard from anywhere, reveal Progenitus and shuffle it into its owner's library instead.\",\n  \"power\": \"10\",\n  \"toughness\": \"10\",\n  \"loyalty\": null,\n  \"colors\": [\n    \"B\",\n    \"G\",\n    \"R\",\n    \"U\",\n    \"W\"\n  ],\n  \"keywords\": [\n    \"Protection\"\n  ],\n  \"rarity\": \"mythic\",\n  \"set_code\": \"fdn\",\n  \"collector_number\": \"244\",\n  \"complexity_tier\": \"medium\"\n}\n\n===== FDN 244 IMPL =====\n\"\"\"Card implementation for Progenitus.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import Creature\nfrom engine.protection import ProtectionAbility\nfrom engine.events import MoveToGraveyardReplacementEvent\nfrom engine.replacement_effects import ReplacementEffect\nfrom engine.types import ManaCost, Supertype, Zone\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\nclass Progenitus(Creature):\n    \"\"\"Progenitus — {W}{W}{U}{U}{B}{B}{R}{R}{G}{G} — 10/10 — Legendary Hydra Avatar.\n\n    Protection from everything.\n    If Progenitus would be put into a graveyard from anywhere, reveal\n    Progenitus and shuffle it into its owner's library instead.\n\n    FDN collector number 244.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Progenitus')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{W}{W}{U}{U}{B}{B}{R}{R}{G}{G}'))\n        kwargs.setdefault('subtypes', {'Hydra', 'Avatar'})\n        kwargs.setdefault('supertypes', {Supertype.LEGENDARY})\n        kwargs.setdefault('base_power', 10)\n        kwargs.setdefault('base_toughness', 10)\n        kwargs.setdefault('rules_text', \"Protection from everything\\nIf Progenitus would be put into a graveyard from anywhere, reveal Progenitus and shuffle it into its owner's library instead.\")\n        super().__init__(**kwargs)\n        self._init_protection()\n\n    def _init_protection(self) -> None:\n        \"\"\"Set up protection from everything. Called from __init__ and\n        can be re-invoked after characteristic resets.\"\"\"\n        self.protections = [ProtectionAbility(quality='everything', predicate=lambda source: True)]\n\n    def _reset_characteristics(self) -> None:\n        \"\"\"Override to reapply protection from everything after reset.\"\"\"\n        super()._reset_characteristics()\n        self._init_protection()\n\n    def register_replacement_effects(self, game: 'GameState') -> None:\n        \"\"\"Register graveyard-shuffle replacement effect.\n\n        Registers a single :class:`~engine.events.MoveToGraveyardReplacementEvent`\n        handler; the engine's zone-move pipeline dispatches subclass events\n        (creature_dies, sacrifice, etc.) to this parent-type handler automatically.\n        \"\"\"\n        source = self\n\n        def _condition(game: Any, event: dict) -> bool:\n            return event.card is source\n\n        def _replacement(game: Any, event: dict) -> dict:\n            owner = getattr(source, 'owner', None)\n            if owner is not None:\n                library = owner.zones[Zone.LIBRARY]\n                library.add(source)\n                library.shuffle()\n            event.prevented = True\n            return event\n        controller = getattr(self, 'controller', None)\n        game.replacement_manager.register(ReplacementEffect(event_type=MoveToGraveyardReplacementEvent, source=self, condition=_condition, replacement=_replacement, controller=controller))\n\n===== FDN 244 TESTS =====\n\"\"\"Reference test for FDN 244 — Progenitus.\n\nIllustrative test covering **replacement effects** via\n``game.replacement_manager.register()``. Progenitus has a continuous\nreplacement that intercepts any ``MoveToGraveyardReplacementEvent``\ntargeting itself and redirects the card to its owner's library instead\nof the graveyard. The replacement callback sets ``event.prevented`` to\nsignal that the engine should skip its own zone move, and returns the\nmodified event.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom cards.fdn.fdn_244.card_impl import Progenitus\nfrom engine.card import Creature\nfrom engine.events import (\n    CreatureDiesReplacementEvent,\n    MoveToGraveyardReplacementEvent,\n)\nfrom engine.replacement_effects import ReplacementEffect\nfrom engine.types import ManaCost, Supertype, Zone\nfrom test_utils import create_game\n\n\nclass TestProgenitusProperties:\n    \"\"\"Static card data should match the FDN 244 spec.\"\"\"\n\n    def test_name(self) -> None:\n        assert Progenitus(owner=None).name == \"Progenitus\"\n\n    def test_mana_cost(self) -> None:\n        cost = ManaCost.parse(\"{W}{W}{U}{U}{B}{B}{R}{R}{G}{G}\")\n        assert Progenitus(owner=None).mana_cost == cost\n\n    def test_legendary_hydra_avatar(self) -> None:\n        card = Progenitus(owner=None)\n        assert Supertype.LEGENDARY in card.supertypes\n        assert {\"Hydra\", \"Avatar\"} <= card.subtypes\n\n\nclass TestProgenitusReplacementRegistration:\n    \"\"\"register_replacement_effects must wire a ReplacementEffect for\n    MoveToGraveyardReplacementEvent through the replacement_manager.\"\"\"\n\n    def test_registers_one_replacement_effect(self) -> None:\n        game = create_game()\n        p1 = game.players[0]\n        card = Progenitus(owner=p1, controller=p1)\n        before = len(game.replacement_manager._effects)\n        card.register_replacement_effects(game)\n        after = len(game.replacement_manager._effects)\n        assert after - before == 1\n\n    def test_registered_replacement_uses_typed_event_class(self) -> None:\n        \"\"\"The registered ReplacementEffect must use the typed\n        MoveToGraveyardReplacementEvent class, not a string event name.\"\"\"\n        game = create_game()\n        p1 = game.players[0]\n        card = Progenitus(owner=p1, controller=p1)\n        card.register_replacement_effects(game)\n        registered = next(\n            (e for e in game.replacement_manager._effects if e.source is card),\n            None,\n        )\n        assert registered is not None\n        assert isinstance(registered, ReplacementEffect)\n        assert registered.event_type is MoveToGraveyardReplacementEvent\n\n\nclass TestProgenitusGraveyardReplacement:\n    \"\"\"The replacement callback shuffles the card into its owner's\n    library and prevents the move to graveyard.\"\"\"\n\n    def test_replacement_redirects_to_library_and_prevents(self) -> None:\n        game = create_game()\n        p1 = game.players[0]\n        card = Progenitus(owner=p1, controller=p1)\n        card.register_replacement_effects(game)\n        # Use the creature-dies subclass so the event's ``card`` property\n        # resolves to this Progenitus instance (the base class's ``card``\n        # property returns None).\n        event = CreatureDiesReplacementEvent(\n            creature=card,\n            destination=\"graveyard\",\n            controller=p1,\n            owner=p1,\n        )\n        result = game.replacement_manager.apply(game, event)\n        # Replacement callback should return the event with prevented=True\n        # and shuffle the card into the library.\n        assert result.prevented is True\n        library = p1.zones[Zone.LIBRARY]\n        assert library.contains(card)\n\n\n\n","numLines":902,"startLine":1,"totalLines":902}}}
