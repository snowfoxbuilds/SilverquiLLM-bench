{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015WZdzStDYmXFB1Xvj92g23","type":"tool_result","content":"434\t# ------------------------------------------------------------------\n435\t\n436\tdef _resolve_spell(\n437\t    game: GameState,\n438\t    card: CardImpl,\n439\t    player: Player,\n440\t    stack_obj: StackObject,\n441\t) -> None:\n442\t    \"\"\"Resolve *card* cast by *player*.\n443\t\n444\t    1. Call ``card.on_resolve(game, targets=targets)``.\n445\t    2. Remove the card from the stack zone.\n446\t    3. If the card is a permanent type, move it to the battlefield via\n447\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n448\t       registration and the ETB event).\n449\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n450\t    \"\"\"\n451\t    from engine.zones import move_to_zone\n452\t\n453\t    # Read targets from the StackObject — the single source of truth.\n454\t    # Set chosen_targets on the card just before resolution so that\n455\t    # _get_chosen_target helpers (which read via getattr) work.\n456\t    targets = stack_obj.targets\n457\t    if targets is not None:\n458\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n459\t\n460\t    card.on_resolve(game)\n461\t\n462\t    if card.card_types & _PERMANENT_TYPES:\n463\t        # Move from stack to battlefield via move_to_zone, which handles\n464\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n465\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n466\t    elif getattr(card, \"_exile_instead_of_graveyard\", False):\n467\t        # Replacement effect: \"if this spell would be put into your\n468\t        # graveyard, exile it instead\" (e.g. The Dawning Archaic, Paradigm).\n469\t        card._exile_instead_of_graveyard = False\n470\t        move_to_zone(game, card, Zone.STACK, Zone.EXILE)\n471\t    else:\n472\t        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n473\t        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n474\t\n475\t\n476\t# ------------------------------------------------------------------\n477\t# Play land (special action — does not use the stack)\n478\t# ------------------------------------------------------------------\n479\t\n480\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n481\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n482\t\n483\t    Requirements (all must hold):\n484\t\n485\t    * *land_card* has :attr:`CardType.LAND`.\n486\t    * *player* is the active player.\n487\t    * Current phase is a main phase.\n488\t    * The stack is empty.\n489\t    * ``player.land_plays_remaining > 0``.\n490\t    * The card is in the player's hand.\n491\t\n492\t    On success the card moves from hand to battlefield and\n493\t    ``land_plays_remaining`` is decremented."}]},"parent_tool_use_id":null,"session_id":"7182fe58-6bea-420a-b90d-6a2af4b380c1","uuid":"d4be6089-1288-46fe-896e-3f02ff705685","timestamp":"2026-05-30T08:31:19.912Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"# ------------------------------------------------------------------\n\ndef _resolve_spell(\n    game: GameState,\n    card: CardImpl,\n    player: Player,\n    stack_obj: StackObject,\n) -> None:\n    \"\"\"Resolve *card* cast by *player*.\n\n    1. Call ``card.on_resolve(game, targets=targets)``.\n    2. Remove the card from the stack zone.\n    3. If the card is a permanent type, move it to the battlefield via\n       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n       registration and the ETB event).\n    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Read targets from the StackObject — the single source of truth.\n    # Set chosen_targets on the card just before resolution so that\n    # _get_chosen_target helpers (which read via getattr) work.\n    targets = stack_obj.targets\n    if targets is not None:\n        card.chosen_targets = targets  # type: ignore[attr-defined]\n\n    card.on_resolve(game)\n\n    if card.card_types & _PERMANENT_TYPES:\n        # Move from stack to battlefield via move_to_zone, which handles\n        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n    elif getattr(card, \"_exile_instead_of_graveyard\", False):\n        # Replacement effect: \"if this spell would be put into your\n        # graveyard, exile it instead\" (e.g. The Dawning Archaic, Paradigm).\n        card._exile_instead_of_graveyard = False\n        move_to_zone(game, card, Zone.STACK, Zone.EXILE)\n    else:\n        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n\n\n# ------------------------------------------------------------------\n# Play land (special action — does not use the stack)\n# ------------------------------------------------------------------\n\ndef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n\n    Requirements (all must hold):\n\n    * *land_card* has :attr:`CardType.LAND`.\n    * *player* is the active player.\n    * Current phase is a main phase.\n    * The stack is empty.\n    * ``player.land_plays_remaining > 0``.\n    * The card is in the player's hand.\n\n    On success the card moves from hand to battlefield and\n    ``land_plays_remaining`` is decremented.","numLines":60,"startLine":434,"totalLines":551}}}
