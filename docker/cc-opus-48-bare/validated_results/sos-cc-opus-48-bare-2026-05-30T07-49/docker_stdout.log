{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018iWgLAARnUa3nha7eZfjt7","type":"tool_result","content":"1\t\"\"\"Protection from qualities — keyword ability implementation.\n2\t\n3\tImplements the 'protection from [quality]' keyword per MTG rules.\n4\tProtection prevents (DEBT mnemonic):\n5\t  - **D**amage from sources with that quality\n6\t  - **E**nchanting/equipping by permanents with that quality\n7\t  - **B**locking by creatures with that quality\n8\t  - **T**argeting by spells/abilities from sources with that quality\n9\t\n10\tPhase 1 supports color-based protection.  The framework is extensible to\n11\tcard-type, subtype, and arbitrary predicate-based protection.\n12\t\"\"\"\n13\t\n14\tfrom __future__ import annotations\n15\t\n16\tfrom dataclasses import dataclass, field\n17\tfrom typing import TYPE_CHECKING, Any, Callable\n18\t\n19\tfrom engine.types import Color, ManaType\n20\t\n21\tif TYPE_CHECKING:\n22\t    pass\n23\t\n24\t\n25\t# ---------------------------------------------------------------------------\n26\t# Colour helpers\n27\t# ---------------------------------------------------------------------------\n28\t\n29\t# Map from ManaType to Color for deriving a card's colours from its mana cost.\n30\t_MANA_TO_COLOR: dict[ManaType, Color] = {\n31\t    ManaType.WHITE: Color.WHITE,\n32\t    ManaType.BLUE: Color.BLUE,\n33\t    ManaType.BLACK: Color.BLACK,\n34\t    ManaType.RED: Color.RED,\n35\t    ManaType.GREEN: Color.GREEN,\n36\t}\n37\t\n38\t\n39\tdef get_colors(obj: Any) -> set[Color]:\n40\t    \"\"\"Return the set of colours of *obj*.\n41\t\n42\t    Colour is determined by:\n43\t    1. An explicit ``colors`` attribute (set or list of :class:`Color`).\n44\t    2. The coloured pips in the object's ``mana_cost``.\n45\t    3. An explicit ``color`` attribute (single :class:`Color`).\n46\t\n47\t    Colourless objects return an empty set.\n48\t    \"\"\"\n49\t    # Explicit colors attribute (takes precedence)\n50\t    if hasattr(obj, \"colors\") and obj.colors is not None:\n51\t        return set(obj.colors)\n52\t\n53\t    # Derive from mana cost pips\n54\t    mana_cost = getattr(obj, \"mana_cost\", None)\n55\t    if mana_cost is not None:\n56\t        pips = getattr(mana_cost, \"pips\", None)\n57\t        if pips:\n58\t            result: set[Color] = set()\n59\t            for mt in pips:\n60\t                if mt in _MANA_TO_COLOR:\n61\t                    result.add(_MANA_TO_COLOR[mt])\n62\t            return result\n63\t\n64\t    # Single color attribute fallback\n65\t    if hasattr(obj, \"color\") and obj.color is not None:\n66\t        return {obj.color}\n67\t\n68\t    return set()\n69\t\n70\t\n71\t# ---------------------------------------------------------------------------\n72\t# ProtectionAbility\n73\t# ---------------------------------------------------------------------------\n74\t\n75\t@dataclass\n76\tclass ProtectionAbility:\n77\t    \"\"\"Represents a 'protection from [quality]' ability.\n78\t\n79\t    The *quality* is typically a :class:`Color`, but the framework supports\n80\t    arbitrary predicates via *predicate*.\n81\t\n82\t    Usage::\n83\t\n84\t        # Colour-based protection\n85\t        pro_red = ProtectionAbility(quality=Color.RED)\n86\t\n87\t        # Custom predicate (e.g. protection from artifacts)\n88\t        pro_artifacts = ProtectionAbility(\n89\t            quality=\"artifacts\",\n90\t            predicate=lambda src: CardType.ARTIFACT in getattr(src, \"card_types\", set()),\n91\t        )\n92\t\n93\t    Attributes:\n94\t        quality: A human-readable label for the quality (often a\n95\t            :class:`Color` enum member).\n96\t        predicate: An optional callable ``(source) -> bool`` that returns\n97\t            ``True`` if *source* has the protected-from quality.  When\n98\t            ``None``, the quality must be a :class:`Color` and the default\n99\t            colour-matching predicate is used.\n100\t    \"\"\"\n101\t\n102\t    quality: Any  # typically Color, but may be str or CardType\n103\t    predicate: Callable[[Any], bool] | None = None\n104\t\n105\t    def matches(self, source: Any) -> bool:\n106\t        \"\"\"Return ``True`` if *source* has the quality this protects from.\"\"\"\n107\t        if self.predicate is not None:\n108\t            return self.predicate(source)\n109\t\n110\t        # Default: colour-based matching\n111\t        if isinstance(self.quality, Color):\n112\t            return self.quality in get_colors(source)\n113\t\n114\t        return False\n115\t\n116\t\n117\t# ---------------------------------------------------------------------------\n118\t# Query helpers — work with any object that has a ``protections`` list\n119\t# ---------------------------------------------------------------------------\n120\t\n121\tdef get_protections(obj: Any) -> list[ProtectionAbility]:\n122\t    \"\"\"Return the list of :class:`ProtectionAbility` on *obj*, or ``[]``.\"\"\"\n123\t    return getattr(obj, \"protections\", [])\n124\t\n125\t\n126\tdef has_protection_from(permanent: Any, source: Any) -> bool:\n127\t    \"\"\"Return ``True`` if *permanent* has protection from *source*.\n128\t\n129\t    Iterates over all :class:`ProtectionAbility` instances on *permanent*\n130\t    and returns ``True`` if any matches *source*.\n131\t    \"\"\"\n132\t    for prot in get_protections(permanent):\n133\t        if prot.matches(source):\n134\t            return True\n135\t    return False\n136\t\n137\t\n138\tdef _is_illegal_target_due_to_protection(target: Any, source: Any) -> bool:\n139\t    \"\"\"Return ``True`` if *target* cannot be targeted by *source* due to protection.\"\"\"\n140\t    return has_protection_from(target, source)\n141\t\n142\t\n143\tdef _is_illegal_block_due_to_protection(attacker: Any, blocker: Any) -> bool:\n144\t    \"\"\"Return ``True`` if *attacker* has protection from *blocker*.\n145\t\n146\t    Protection prevents blocking *by* creatures with that quality —\n147\t    i.e. the attacker is the one with protection, the blocker is checked.\n148\t    \"\"\"\n149\t    return has_protection_from(attacker, blocker)\n150\t\n151\t\n152\tdef _should_prevent_damage(target: Any, source: Any) -> bool:\n153\t    \"\"\"Return ``True`` if damage from *source* to *target* should be prevented.\"\"\"\n154\t    return has_protection_from(target, source)\n155\t\n156\t\n157\tdef _aura_illegal_due_to_protection(aura: Any) -> bool:\n158\t    \"\"\"Return ``True`` if *aura* is illegally attached due to protection.\n159\t\n160\t    An aura is illegal if the enchanted permanent has protection from the\n161\t    aura (checked via the aura's colours / quality).\n162\t    \"\"\"\n163\t    attached = getattr(aura, \"attached_to\", None)\n164\t    if attached is None:\n165\t        return False\n166\t    return has_protection_from(attached, aura)\n167\t"}]},"parent_tool_use_id":null,"session_id":"7182fe58-6bea-420a-b90d-6a2af4b380c1","uuid":"eff49094-dd0b-4bc4-aaca-df613611d70d","timestamp":"2026-05-30T07:51:11.398Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/protection.py","content":"\"\"\"Protection from qualities — keyword ability implementation.\n\nImplements the 'protection from [quality]' keyword per MTG rules.\nProtection prevents (DEBT mnemonic):\n  - **D**amage from sources with that quality\n  - **E**nchanting/equipping by permanents with that quality\n  - **B**locking by creatures with that quality\n  - **T**argeting by spells/abilities from sources with that quality\n\nPhase 1 supports color-based protection.  The framework is extensible to\ncard-type, subtype, and arbitrary predicate-based protection.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom typing import TYPE_CHECKING, Any, Callable\n\nfrom engine.types import Color, ManaType\n\nif TYPE_CHECKING:\n    pass\n\n\n# ---------------------------------------------------------------------------\n# Colour helpers\n# ---------------------------------------------------------------------------\n\n# Map from ManaType to Color for deriving a card's colours from its mana cost.\n_MANA_TO_COLOR: dict[ManaType, Color] = {\n    ManaType.WHITE: Color.WHITE,\n    ManaType.BLUE: Color.BLUE,\n    ManaType.BLACK: Color.BLACK,\n    ManaType.RED: Color.RED,\n    ManaType.GREEN: Color.GREEN,\n}\n\n\ndef get_colors(obj: Any) -> set[Color]:\n    \"\"\"Return the set of colours of *obj*.\n\n    Colour is determined by:\n    1. An explicit ``colors`` attribute (set or list of :class:`Color`).\n    2. The coloured pips in the object's ``mana_cost``.\n    3. An explicit ``color`` attribute (single :class:`Color`).\n\n    Colourless objects return an empty set.\n    \"\"\"\n    # Explicit colors attribute (takes precedence)\n    if hasattr(obj, \"colors\") and obj.colors is not None:\n        return set(obj.colors)\n\n    # Derive from mana cost pips\n    mana_cost = getattr(obj, \"mana_cost\", None)\n    if mana_cost is not None:\n        pips = getattr(mana_cost, \"pips\", None)\n        if pips:\n            result: set[Color] = set()\n            for mt in pips:\n                if mt in _MANA_TO_COLOR:\n                    result.add(_MANA_TO_COLOR[mt])\n            return result\n\n    # Single color attribute fallback\n    if hasattr(obj, \"color\") and obj.color is not None:\n        return {obj.color}\n\n    return set()\n\n\n# ---------------------------------------------------------------------------\n# ProtectionAbility\n# ---------------------------------------------------------------------------\n\n@dataclass\nclass ProtectionAbility:\n    \"\"\"Represents a 'protection from [quality]' ability.\n\n    The *quality* is typically a :class:`Color`, but the framework supports\n    arbitrary predicates via *predicate*.\n\n    Usage::\n\n        # Colour-based protection\n        pro_red = ProtectionAbility(quality=Color.RED)\n\n        # Custom predicate (e.g. protection from artifacts)\n        pro_artifacts = ProtectionAbility(\n            quality=\"artifacts\",\n            predicate=lambda src: CardType.ARTIFACT in getattr(src, \"card_types\", set()),\n        )\n\n    Attributes:\n        quality: A human-readable label for the quality (often a\n            :class:`Color` enum member).\n        predicate: An optional callable ``(source) -> bool`` that returns\n            ``True`` if *source* has the protected-from quality.  When\n            ``None``, the quality must be a :class:`Color` and the default\n            colour-matching predicate is used.\n    \"\"\"\n\n    quality: Any  # typically Color, but may be str or CardType\n    predicate: Callable[[Any], bool] | None = None\n\n    def matches(self, source: Any) -> bool:\n        \"\"\"Return ``True`` if *source* has the quality this protects from.\"\"\"\n        if self.predicate is not None:\n            return self.predicate(source)\n\n        # Default: colour-based matching\n        if isinstance(self.quality, Color):\n            return self.quality in get_colors(source)\n\n        return False\n\n\n# ---------------------------------------------------------------------------\n# Query helpers — work with any object that has a ``protections`` list\n# ---------------------------------------------------------------------------\n\ndef get_protections(obj: Any) -> list[ProtectionAbility]:\n    \"\"\"Return the list of :class:`ProtectionAbility` on *obj*, or ``[]``.\"\"\"\n    return getattr(obj, \"protections\", [])\n\n\ndef has_protection_from(permanent: Any, source: Any) -> bool:\n    \"\"\"Return ``True`` if *permanent* has protection from *source*.\n\n    Iterates over all :class:`ProtectionAbility` instances on *permanent*\n    and returns ``True`` if any matches *source*.\n    \"\"\"\n    for prot in get_protections(permanent):\n        if prot.matches(source):\n            return True\n    return False\n\n\ndef _is_illegal_target_due_to_protection(target: Any, source: Any) -> bool:\n    \"\"\"Return ``True`` if *target* cannot be targeted by *source* due to protection.\"\"\"\n    return has_protection_from(target, source)\n\n\ndef _is_illegal_block_due_to_protection(attacker: Any, blocker: Any) -> bool:\n    \"\"\"Return ``True`` if *attacker* has protection from *blocker*.\n\n    Protection prevents blocking *by* creatures with that quality —\n    i.e. the attacker is the one with protection, the blocker is checked.\n    \"\"\"\n    return has_protection_from(attacker, blocker)\n\n\ndef _should_prevent_damage(target: Any, source: Any) -> bool:\n    \"\"\"Return ``True`` if damage from *source* to *target* should be prevented.\"\"\"\n    return has_protection_from(target, source)\n\n\ndef _aura_illegal_due_to_protection(aura: Any) -> bool:\n    \"\"\"Return ``True`` if *aura* is illegally attached due to protection.\n\n    An aura is illegal if the enchanted permanent has protection from the\n    aura (checked via the aura's colours / quality).\n    \"\"\"\n    attached = getattr(aura, \"attached_to\", None)\n    if attached is None:\n        return False\n    return has_protection_from(attached, aura)\n","numLines":167,"startLine":1,"totalLines":167}}}
