+def _external_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:
+    """Sum generic cost reductions granted to *card* by other permanents.
+
+    A permanent grants an external reduction by implementing
+    ``static_cost_reduction(game, spell, spell_controller) -> int``.  This
+    lets one permanent reduce the cost of *other* spells (the self-only
+    reduction lives on :meth:`CardImpl.cost_reduction`).
+    """
+    total = 0
+    for perm in game.get_battlefield(controller).get_all():
+        if perm is card:
+            continue
+        hook = getattr(perm, "static_cost_reduction", None)
+        if hook is None:
+            continue
+        amount = hook(game, card, controller)
+        if amount:
+            total += amount
+    return total
+
+
