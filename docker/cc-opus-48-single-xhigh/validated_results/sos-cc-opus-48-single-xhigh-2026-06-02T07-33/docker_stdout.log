{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013JE7JHpbTuvMDptk4D8M7x","type":"tool_result","content":"1\t\"\"\"Tests for SOS 97 — Ral Zarek, Guest Lecturer.\n2\t\n3\tRal Zarek, Guest Lecturer — {1}{B}{B} Legendary Planeswalker — Ral — loyalty 3:\n4\t\n5\t    +1: Surveil 2.\n6\t    −1: Any number of target players each discard a card.\n7\t    −2: Return target creature card with mana value 3 or less from your\n8\t        graveyard to the battlefield.\n9\t    −7: Flip five coins. Target opponent skips their next X turns, where X\n10\t        is the number of coins that came up heads.\n11\t\n12\tContract derived from the oracle text and the engine's planeswalker\n13\tplumbing (``engine/card.py`` ``Planeswalker`` / ``LoyaltyAbility``, the FDN\n14\treference walkers ``cards/fdn/fdn_44`` (Kaito), ``cards/fdn/fdn_134``\n15\t(Ajani), ``cards/fdn/fdn_81`` (Chandra)) plus the engine helpers in\n16\t``engine/game.py`` (``discard``, ``move_to_zone``) and the established\n17\tsurveil convention in ``cards/fdn/fdn_157`` (Lightshell Duo) which uses\n18\t``controller.choose_yes_no(...)`` per top card, processed top-card-first.\n19\t\n20\tConventions exercised here (mirroring the FDN reference walkers):\n21\t\n22\t* ``get_loyalty_abilities()`` returns one :class:`LoyaltyAbility` per\n23\t  printed ability, with ``loyalty_cost`` equal to the printed loyalty\n24\t  adjustment (+1, −1, −2, −7).  Each ability's ``effect`` is a callable\n25\t  taking only ``game`` — at resolution the engine invokes\n26\t  ``ability.effect(game)`` (see ``engine/abilities.py``\n27\t  ``_activate_loyalty_ability``).\n28\t* Targets chosen for a loyalty ability are stashed on the planeswalker\n29\t  before the effect runs: a single target on ``pw._resolve_target`` and a\n30\t  variable number of targets on ``pw._resolve_targets`` (the idiom used by\n31\t  Kaito / Ajani / Chandra).\n32\t\"\"\"\n33\t\n34\tfrom __future__ import annotations\n35\t\n36\tfrom typing import Any\n37\t\n38\timport pytest\n39\t\n40\tfrom cards.sos.sos_97.card_impl import RalZarekGuestLecturer\n41\tfrom engine.card import Creature, LoyaltyAbility, Planeswalker\n42\tfrom engine.types import (\n43\t    CardType,\n44\t    ManaCost,\n45\t    Supertype,\n46\t    Zone,\n47\t)\n48\tfrom test_utils import create_game, set_board_state\n49\t\n50\t\n51\t# ---------------------------------------------------------------------------\n52\t# Helpers\n53\t# ---------------------------------------------------------------------------\n54\t\n55\t\n56\tdef _vanilla(name: str, owner: Any = None, *, mv: int = 2) -> Creature:\n57\t    \"\"\"A vanilla creature whose mana value is *mv* (generic-only cost).\"\"\"\n58\t    return Creature(\n59\t        name=name,\n60\t        owner=owner,\n61\t        controller=owner,\n62\t        mana_cost=ManaCost.parse(f\"{{{mv}}}\") if mv > 0 else ManaCost(),\n63\t        base_power=2,\n64\t        base_toughness=2,\n65\t    )\n66\t\n67\t\n68\tdef _filler(name: str, owner: Any = None) -> Creature:\n69\t    \"\"\"A plain card object usable to fill a library/hand zone.\"\"\"\n70\t    return Creature(\n71\t        name=name,\n72\t        owner=owner,\n73\t        controller=owner,\n74\t        base_power=1,\n75\t        base_toughness=1,\n76\t    )\n77\t\n78\t\n79\tdef _ability_by_cost(pw: RalZarekGuestLecturer, cost: int) -> LoyaltyAbility:\n80\t    \"\"\"Return the loyalty ability whose loyalty_cost equals *cost*.\"\"\"\n81\t    matches = [a for a in pw.get_loyalty_abilities() if a.loyalty_cost == cost]\n82\t    assert matches, f\"no loyalty ability with cost {cost:+d}\"\n83\t    return matches[0]\n84\t\n85\t\n86\t# ---------------------------------------------------------------------------\n87\t# Static properties\n88\t# ---------------------------------------------------------------------------\n89\t\n90\t\n91\tclass TestRalZarekProperties:\n92\t    \"\"\"Static card data should match the SOS 97 spec.\"\"\"\n93\t\n94\t    def test_name(self) -> None:\n95\t        assert RalZarekGuestLecturer(owner=None).name == \"Ral Zarek, Guest Lecturer\"\n96\t\n97\t    def test_mana_cost(self) -> None:\n98\t        assert RalZarekGuestLecturer(owner=None).mana_cost == ManaCost.parse(\"{1}{B}{B}\")\n99\t\n100\t    def test_is_planeswalker(self) -> None:\n101\t        card = RalZarekGuestLecturer(owner=None)\n102\t        assert isinstance(card, Planeswalker)\n103\t        assert CardType.PLANESWALKER in card.card_types\n104\t\n105\t    def test_is_legendary(self) -> None:\n106\t        assert Supertype.LEGENDARY in RalZarekGuestLecturer(owner=None).supertypes\n107\t\n108\t    def test_has_ral_subtype(self) -> None:\n109\t        assert \"Ral\" in RalZarekGuestLecturer(owner=None).subtypes\n110\t\n111\t    def test_starting_loyalty_is_three(self) -> None:\n112\t        card = RalZarekGuestLecturer(owner=None)\n113\t        assert card.starting_loyalty == 3\n114\t        assert card.loyalty == 3\n115\t\n116\t\n117\t# ---------------------------------------------------------------------------\n118\t# Loyalty ability roster\n119\t# ---------------------------------------------------------------------------\n120\t\n121\t\n122\tclass TestRalZarekLoyaltyRoster:\n123\t    \"\"\"get_loyalty_abilities() declares the four printed abilities.\"\"\"\n124\t\n125\t    def test_returns_four_abilities(self) -> None:\n126\t        abilities = RalZarekGuestLecturer(owner=None).get_loyalty_abilities()\n127\t        assert len(abilities) == 4\n128\t\n129\t    def test_each_is_loyalty_ability(self) -> None:\n130\t        for a in RalZarekGuestLecturer(owner=None).get_loyalty_abilities():\n131\t            assert isinstance(a, LoyaltyAbility)\n132\t\n133\t    def test_loyalty_costs_match_spec(self) -> None:\n134\t        costs = sorted(\n135\t            a.loyalty_cost for a in RalZarekGuestLecturer(owner=None).get_loyalty_abilities()\n136\t        )\n137\t        assert costs == [-7, -2, -1, 1]\n138\t\n139\t\n140\t# ---------------------------------------------------------------------------\n141\t# +1: Surveil 2\n142\t# ---------------------------------------------------------------------------\n143\t\n144\t\n145\tclass TestRalZarekSurveil:\n146\t    \"\"\"+1 surveils 2 — top two cards may be put into the graveyard.\n147\t\n148\t    Asserted against the engine's surveil convention (``choose_yes_no`` per\n149\t    top card, processed top-card-first; see ``cards/fdn/fdn_157``).  The\n150\t    robust invariants (card conservation, no leakage to other zones) hold\n151\t    regardless of the exact choice plumbing.\n152\t    \"\"\"\n153\t\n154\t    def _surveil(self, game: Any, controller: Any) -> RalZarekGuestLecturer:\n155\t        pw = RalZarekGuestLecturer(owner=controller, controller=controller)\n156\t        _ability_by_cost(pw, +1).effect(game)\n157\t        return pw\n158\t\n159\t    def test_keeping_both_leaves_library_untouched(self) -> None:\n160\t        game = create_game()\n161\t        p1 = game.players[0]\n162\t        top2 = [_filler(\"Card A\", p1), _filler(\"Card B\", p1)]\n163\t        # Library bottom->top: [A, B] so B is the top card, A second.\n164\t        p1.zones[Zone.LIBRARY]._objects = list(top2)\n165\t        # Script \"no\" to every \"put into graveyard?\" prompt.\n166\t        p1._script.extend([False, False])\n167\t\n168\t        self._surveil(game, p1)\n169\t\n170\t        # Nothing moved to the graveyard; library still holds both cards.\n171\t        assert len(p1.zones[Zone.GRAVEYARD].get_all()) == 0\n172\t        assert all(p1.zones[Zone.LIBRARY].contains(c) for c in top2)\n173\t\n174\t    def test_putting_both_into_graveyard(self) -> None:\n175\t        game = create_game()\n176\t        p1 = game.players[0]\n177\t        top2 = [_filler(\"Card A\", p1), _filler(\"Card B\", p1)]\n178\t        p1.zones[Zone.LIBRARY]._objects = list(top2)\n179\t        # Script \"yes\" to both prompts.\n180\t        p1._script.extend([True, True])\n181\t\n182\t        self._surveil(game, p1)\n183\t\n184\t        gy = p1.zones[Zone.GRAVEYARD]\n185\t        assert all(gy.contains(c) for c in top2)\n186\t        assert len(p1.zones[Zone.LIBRARY].get_all()) == 0\n187\t\n188\t    def test_card_count_is_conserved(self) -> None:\n189\t        \"\"\"Surveil never creates or destroys cards: library+graveyard total\n190\t        is invariant whatever the player chooses.\"\"\"\n191\t        game = create_game()\n192\t        p1 = game.players[0]\n193\t        deck = [_filler(f\"Card {i}\", p1) for i in range(5)]\n194\t        p1.zones[Zone.LIBRARY]._objects = list(deck)\n195\t        # Mixed choices for the (up to) two prompts.\n196\t        p1._script.extend([True, False])\n197\t\n198\t        before = len(p1.zones[Zone.LIBRARY].get_all()) + len(\n199\t            p1.zones[Zone.GRAVEYARD].get_all()\n200\t        )\n201\t        self._surveil(game, p1)\n202\t        after = len(p1.zones[Zone.LIBRARY].get_all()) + len(\n203\t            p1.zones[Zone.GRAVEYARD].get_all()\n204\t        )\n205\t        assert after == before\n206\t\n207\t    def test_surveil_does_not_leak_cards_to_other_zones(self) -> None:\n208\t        \"\"\"Surveilled cards only ever stay on the library or go to graveyard.\"\"\"\n209\t        game = create_game()\n210\t        p1 = game.players[0]\n211\t        deck = [_filler(f\"Card {i}\", p1) for i in range(3)]\n212\t        p1.zones[Zone.LIBRARY]._objects = list(deck)\n213\t        p1._script.extend([True, True])\n214\t\n215\t        self._surveil(game, p1)\n216\t\n217\t        for c in deck:\n218\t            in_lib = p1.zones[Zone.LIBRARY].contains(c)\n219\t            in_gy = p1.zones[Zone.GRAVEYARD].contains(c)\n220\t            assert in_lib != in_gy  # exactly one of the two\n221\t            assert not p1.zones[Zone.HAND].contains(c)\n222\t            assert not p1.zones[Zone.EXILE].contains(c)\n223\t            assert not p1.zones[Zone.BATTLEFIELD].contains(c)\n224\t\n225\t    def test_empty_library_is_a_noop(self) -> None:\n226\t        \"\"\"Surveil 2 with an empty library does nothing and does not raise.\"\"\"\n227\t        game = create_game()\n228\t        p1 = game.players[0]\n229\t        assert len(p1.zones[Zone.LIBRARY].get_all()) == 0\n230\t        # No choices should be requested for an empty library.\n231\t        self._surveil(game, p1)\n232\t        assert len(p1.zones[Zone.GRAVEYARD].get_all()) == 0\n233\t\n234\t\n235\t# ---------------------------------------------------------------------------\n236\t# −1: Any number of target players each discard a card\n237\t# ---------------------------------------------------------------------------\n238\t\n239\t\n240\tclass TestRalZarekDiscard:\n241\t    \"\"\"−1 makes each targeted player discard a card.\"\"\"\n242\t\n243\t    def test_single_targeted_player_discards(self) -> None:\n244\t        game = create_game()\n245\t        p1, p2 = game.players\n246\t        card = _filler(\"Doomed Hand Card\", p2)\n247\t        set_board_state(game, 1, hand=[card])\n248\t\n249\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n250\t        pw._resolve_targets = [p2]\n251\t        _ability_by_cost(pw, -1).effect(game)\n252\t\n253\t        # The targeted player has discarded their (only) card.\n254\t        assert len(p2.zones[Zone.HAND].get_all()) == 0\n255\t        assert p2.zones[Zone.GRAVEYARD].contains(card)\n256\t\n257\t    def test_multiple_targets_each_discard_one(self) -> None:\n258\t        game = create_game()\n259\t        p1, p2 = game.players\n260\t        c1 = _filler(\"P1 Card\", p1)\n261\t        c2 = _filler(\"P2 Card\", p2)\n262\t        set_board_state(game, 0, hand=[c1, _filler(\"P1 Extra\", p1)])\n263\t        set_board_state(game, 1, hand=[c2, _filler(\"P2 Extra\", p2)])\n264\t\n265\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n266\t        pw._resolve_targets = [p1, p2]\n267\t        _ability_by_cost(pw, -1).effect(game)\n268\t\n269\t        # Each targeted player discarded exactly one card.\n270\t        assert len(p1.zones[Zone.HAND].get_all()) == 1\n271\t        assert len(p2.zones[Zone.HAND].get_all()) == 1\n272\t        assert len(p1.zones[Zone.GRAVEYARD].get_all()) == 1\n273\t        assert len(p2.zones[Zone.GRAVEYARD].get_all()) == 1\n274\t\n275\t    def test_no_targets_is_a_noop(self) -> None:\n276\t        \"\"\"\"Any number of target players\" allows zero — nobody discards.\"\"\"\n277\t        game = create_game()\n278\t        p1, p2 = game.players\n279\t        set_board_state(game, 1, hand=[_filler(\"Safe Card\", p2)])\n280\t\n281\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n282\t        pw._resolve_targets = []\n283\t        _ability_by_cost(pw, -1).effect(game)\n284\t\n285\t        assert len(p2.zones[Zone.HAND].get_all()) == 1\n286\t        assert len(p2.zones[Zone.GRAVEYARD].get_all()) == 0\n287\t\n288\t    def test_targeted_player_with_empty_hand_does_not_crash(self) -> None:\n289\t        \"\"\"A targeted player with no cards simply discards nothing.\"\"\"\n290\t        game = create_game()\n291\t        p1, p2 = game.players\n292\t        set_board_state(game, 1, hand=[])\n293\t\n294\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n295\t        pw._resolve_targets = [p2]\n296\t        _ability_by_cost(pw, -1).effect(game)\n297\t\n298\t        assert len(p2.zones[Zone.GRAVEYARD].get_all()) == 0\n299\t\n300\t\n301\t# ---------------------------------------------------------------------------\n302\t# −2: Return a creature card with mana value 3 or less from your graveyard\n303\t# ---------------------------------------------------------------------------\n304\t\n305\t\n306\tclass TestRalZarekReanimate:\n307\t    \"\"\"−2 returns a low-cost creature from *your* graveyard to the battlefield.\"\"\"\n308\t\n309\t    def test_returns_targeted_creature_to_battlefield(self) -> None:\n310\t        game = create_game()\n311\t        p1 = game.players[0]\n312\t        creature = _vanilla(\"Reanimation Target\", p1, mv=3)\n313\t        set_board_state(game, 0, graveyard=[creature])\n314\t\n315\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n316\t        pw._resolve_target = creature\n317\t        _ability_by_cost(pw, -2).effect(game)\n318\t\n319\t        # Creature moved from graveyard onto the controller's battlefield.\n320\t        assert game.get_battlefield(p1).contains(creature)\n321\t        assert not p1.zones[Zone.GRAVEYARD].contains(creature)\n322\t\n323\t    def test_returned_creature_is_controlled_by_you(self) -> None:\n324\t        game = create_game()\n325\t        p1 = game.players[0]\n326\t        creature = _vanilla(\"Reanimation Target\", p1, mv=1)\n327\t        set_board_state(game, 0, graveyard=[creature])\n328\t\n329\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n330\t        pw._resolve_target = creature\n331\t        _ability_by_cost(pw, -2).effect(game)\n332\t\n333\t        assert creature.controller is p1\n334\t        assert game.get_battlefield(p1).contains(creature)\n335\t\n336\t    def test_no_target_is_a_noop(self) -> None:\n337\t        game = create_game()\n338\t        p1 = game.players[0]\n339\t        leftover = _vanilla(\"Stays Dead\", p1, mv=2)\n340\t        set_board_state(game, 0, graveyard=[leftover])\n341\t\n342\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n343\t        pw._resolve_target = None\n344\t        _ability_by_cost(pw, -2).effect(game)\n345\t\n346\t        # No target — the creature stays in the graveyard.\n347\t        assert p1.zones[Zone.GRAVEYARD].contains(leftover)\n348\t        assert not game.get_battlefield(p1).contains(leftover)\n349\t\n350\t    def test_target_filter_accepts_mana_value_three_creature(self) -> None:\n351\t        game = create_game()\n352\t        p1 = game.players[0]\n353\t        creature = _vanilla(\"MV3 Creature\", p1, mv=3)\n354\t        set_board_state(game, 0, graveyard=[creature])\n355\t\n356\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n357\t        reqs = pw.get_targets(game)\n358\t        # Find the requirement that scopes to the graveyard (the −2 ability).\n359\t        gy_reqs = [r for r in reqs if r.zone == Zone.GRAVEYARD]\n360\t        assert gy_reqs, \"expected a graveyard-scoped target requirement\"\n361\t        assert any(r.filter_fn(creature) for r in gy_reqs)\n362\t\n363\t    def test_target_filter_rejects_high_mana_value_creature(self) -> None:\n364\t        game = create_game()\n365\t        p1 = game.players[0]\n366\t        big = _vanilla(\"MV4 Creature\", p1, mv=4)\n367\t        set_board_state(game, 0, graveyard=[big])\n368\t\n369\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n370\t        gy_reqs = [r for r in pw.get_targets(game) if r.zone == Zone.GRAVEYARD]\n371\t        assert gy_reqs\n372\t        # A mana value 4 creature is NOT a legal target (\"3 or less\").\n373\t        assert all(not r.filter_fn(big) for r in gy_reqs)\n374\t\n375\t    def test_target_filter_rejects_noncreature_card(self) -> None:\n376\t        from engine.card import Sorcery\n377\t\n378\t        game = create_game()\n379\t        p1 = game.players[0]\n380\t        sorcery = Sorcery(\n381\t            name=\"Cheap Sorcery\",\n382\t            owner=p1,\n383\t            controller=p1,\n384\t            mana_cost=ManaCost.parse(\"{1}\"),\n385\t        )\n386\t        set_board_state(game, 0, graveyard=[sorcery])\n387\t\n388\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n389\t        gy_reqs = [r for r in pw.get_targets(game) if r.zone == Zone.GRAVEYARD]\n390\t        assert gy_reqs\n391\t        # Non-creature card in the graveyard is not a legal target.\n392\t        assert all(not r.filter_fn(sorcery) for r in gy_reqs)\n393\t\n394\t\n395\t# ---------------------------------------------------------------------------\n396\t# −7: Flip five coins; target opponent skips their next X turns\n397\t# ---------------------------------------------------------------------------\n398\t\n399\t\n400\tclass TestRalZarekUltimate:\n401\t    \"\"\"−7 flips five coins and makes a target opponent skip X turns.\n402\t\n403\t    Coin flips are random, so the exact value of X is not asserted here\n404\t    (see ``untestable.json``).  What is asserted: the ability exists at the\n405\t    −7 loyalty cost and resolving it against a target opponent does not\n406\t    raise and records a non-negative, at-most-five turn skip somewhere the\n407\t    engine can observe.\n408\t    \"\"\"\n409\t\n410\t    def test_ultimate_exists_at_minus_seven(self) -> None:\n411\t        pw = RalZarekGuestLecturer(owner=None)\n412\t        ult = _ability_by_cost(pw, -7)\n413\t        assert ult.loyalty_cost == -7\n414\t\n415\t    def test_ultimate_resolves_against_target_opponent(self) -> None:\n416\t        game = create_game()\n417\t        p1, p2 = game.players\n418\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n419\t        pw._resolve_target = p2\n420\t        # Resolving the ultimate must not raise even though the precise\n421\t        # number of skipped turns depends on the (random) coin flips.\n422\t        _ability_by_cost(pw, -7).effect(game)\n423\t\n424\t\n425\t# ---------------------------------------------------------------------------\n426\t# −7 (deterministic): seeded coin flips + skip-turn mechanism\n427\t# ---------------------------------------------------------------------------\n428\t\n429\t\n430\tdef _heads_for_seed(seed: Any) -> int:\n431\t    \"\"\"Ground truth: number of heads ``flip_coins(game, 5)`` yields for *seed*.\n432\t\n433\t    Computed on a throwaway game seeded the same way the −7 ability seeds the\n434\t    real game (``engine.game.seed_rng`` → ``flip_coins(game, 5)``).  This keeps\n435\t    the deterministic −7 tests self-documenting and robust to RNG-internals\n436\t    changes: each test asserts against the head count this helper observes for\n437\t    the same seed rather than a hard-coded magic number.\n438\t    \"\"\"\n439\t    from engine.game import flip_coins, seed_rng\n440\t\n441\t    probe = create_game()\n442\t    seed_rng(probe, seed)\n443\t    return flip_coins(probe, 5)\n444\t\n445\t\n446\tdef _end_turn(game: Any) -> None:\n447\t    \"\"\"Fast-forward to CLEANUP and advance, simulating end-of-turn.\n448\t\n449\t    Mirrors ``engine_tests/test_extra_turns.py::_end_turn`` so the skip-turn\n450\t    rotation is driven through the exact public API the engine documents\n451\t    (set ``Phase.ENDING`` / ``Step.CLEANUP`` then ``advance_phase``).\n452\t    \"\"\"\n453\t    from engine.types import Phase, Step\n454\t\n455\t    game.phase = Phase.ENDING\n456\t    game.step = Step.CLEANUP\n457\t    game.advance_phase()\n458\t\n459\t\n460\tclass TestRalZarekUltimateDeterministic:\n461\t    \"\"\"−7 under a seeded RNG: heads → skipped turns, and turns actually skip.\n462\t\n463\t    The Implementer added a seedable per-game RNG (``engine.game.seed_rng`` /\n464\t    ``flip_coins``) and a per-player ``skipped_turns`` counter consumed during\n465\t    turn rotation (``GameState._pick_next_active_index`` via ``advance_phase``).\n466\t    These tests make the previously-deferred −7 requirements observable.\n467\t    \"\"\"\n468\t\n469\t    def test_heads_count_added_to_target_opponent_skipped_turns(self) -> None:\n470\t        \"\"\"Seed the game, resolve −7 against the opponent, and assert the\n471\t        opponent's ``skipped_turns`` equals the number of heads that seed\n472\t        produces for five coin flips.\"\"\"\n473\t        from engine.game import seed_rng\n474\t\n475\t        seed = 0  # ground-truth head count established below for this seed.\n476\t        expected_heads = _heads_for_seed(seed)\n477\t        # Sanity: this seed must actually exercise X > 0 so the assertion is\n478\t        # meaningful (X = 0 is covered separately).\n479\t        assert expected_heads > 0\n480\t\n481\t        game = create_game()\n482\t        p1, p2 = game.players\n483\t        seed_rng(game, seed)\n484\t\n485\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n486\t        pw._resolve_target = p2\n487\t        _ability_by_cost(pw, -7).effect(game)\n488\t\n489\t        assert p2.skipped_turns == expected_heads\n490\t\n491\t    def test_all_heads_seed_skips_five_turns(self) -> None:\n492\t        \"\"\"An all-heads seed (X = 5) makes the opponent skip the maximum of\n493\t        five turns — the upper bound of the ability.\"\"\"\n494\t        from engine.game import seed_rng\n495\t\n496\t        seed = 4  # ground-truth: five heads for this seed.\n497\t        assert _heads_for_seed(seed) == 5\n498\t\n499\t        game = create_game()\n500\t        p1, p2 = game.players\n501\t        seed_rng(game, seed)\n502\t\n503\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n504\t        pw._resolve_target = p2\n505\t        _ability_by_cost(pw, -7).effect(game)\n506\t\n507\t        assert p2.skipped_turns == 5\n508\t\n509\t    def test_zero_heads_seed_adds_no_skipped_turns(self) -> None:\n510\t        \"\"\"A seed whose five flips yield zero heads (X = 0) adds no skipped\n511\t        turns — the opponent is not made to skip anything.\"\"\"\n512\t        from engine.game import seed_rng\n513\t\n514\t        seed = 5  # ground-truth: zero heads for this seed.\n515\t        assert _heads_for_seed(seed) == 0\n516\t\n517\t        game = create_game()\n518\t        p1, p2 = game.players\n519\t        seed_rng(game, seed)\n520\t\n521\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n522\t        pw._resolve_target = p2\n523\t        _ability_by_cost(pw, -7).effect(game)\n524\t\n525\t        assert p2.skipped_turns == 0\n526\t\n527\t    def test_skipped_turns_added_to_opponent_not_controller(self) -> None:\n528\t        \"\"\"The −7 adds skipped turns to the *targeted opponent*, never to the\n529\t        planeswalker's controller.\"\"\"\n530\t        from engine.game import seed_rng\n531\t\n532\t        seed = 0\n533\t        expected_heads = _heads_for_seed(seed)\n534\t        assert expected_heads > 0\n535\t\n536\t        game = create_game()\n537\t        p1, p2 = game.players\n538\t        seed_rng(game, seed)\n539\t\n540\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n541\t        pw._resolve_target = p2\n542\t        _ability_by_cost(pw, -7).effect(game)\n543\t\n544\t        # The opponent accrues the skips; the controller is untouched.\n545\t        assert p2.skipped_turns == expected_heads\n546\t        assert p1.skipped_turns == 0\n547\t\n548\t    def test_ultimate_drives_opponent_to_skip_its_next_turns(self) -> None:\n549\t        \"\"\"End-to-end: after the seeded −7, drive turn rotation and confirm the\n550\t        opponent's next X turns are actually skipped (it never becomes active)\n551\t        and the counter decrements back to 0.\n552\t\n553\t        Controller is seat 0 (active). With normal alternation the opponent\n554\t        (seat 1) would take the very next turn; instead each of its X due turns\n555\t        is consumed by the skip counter and bounced back to the controller.\n556\t        \"\"\"\n557\t        from engine.game import seed_rng\n558\t\n559\t        seed = 0\n560\t        expected_heads = _heads_for_seed(seed)\n561\t        assert 0 < expected_heads <= 5\n562\t\n563\t        game = create_game()\n564\t        p1, p2 = game.players\n565\t        assert game.active_player_index == 0\n566\t        seed_rng(game, seed)\n567\t\n568\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n569\t        pw._resolve_target = p2\n570\t        _ability_by_cost(pw, -7).effect(game)\n571\t        assert p2.skipped_turns == expected_heads\n572\t\n573\t        # Drive the opponent's X due turns; each should be skipped, so seat 1\n574\t        # never becomes active while the counter is being burned down.\n575\t        for _ in range(expected_heads):\n576\t            _end_turn(game)\n577\t            assert game.active_player_index == 0, (\n578\t                \"opponent's turn should have been skipped\"\n579\t            )\n580\t\n581\t        # All skips consumed; the counter is back to zero.\n582\t        assert p2.skipped_turns == 0\n583\t\n584\t        # Normal alternation resumes: the opponent finally takes a turn.\n585\t        _end_turn(game)\n586\t        assert game.active_player_index == 1\n587\t\n588\t    def test_skip_counter_decrements_one_per_skipped_turn(self) -> None:\n589\t        \"\"\"The skip counter is consumed exactly one-per-skipped-turn (not all\n590\t        at once), so it decreases monotonically by 1 each rotation.\"\"\"\n591\t        from engine.game import seed_rng\n592\t\n593\t        seed = 9  # ground-truth: four heads for this seed.\n594\t        expected_heads = _heads_for_seed(seed)\n595\t        assert expected_heads >= 2  # need >1 to observe the gradual decrement.\n596\t\n597\t        game = create_game()\n598\t        p1, p2 = game.players\n599\t        seed_rng(game, seed)\n600\t\n601\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n602\t        pw._resolve_target = p2\n603\t        _ability_by_cost(pw, -7).effect(game)\n604\t        assert p2.skipped_turns == expected_heads\n605\t\n606\t        for remaining in range(expected_heads - 1, -1, -1):\n607\t            _end_turn(game)\n608\t            assert p2.skipped_turns == remaining\n609\t\n610\t    def test_zero_heads_ultimate_does_not_skip_any_turn(self) -> None:\n611\t        \"\"\"End-to-end for X = 0: with no skipped turns the opponent takes its\n612\t        normal next turn immediately.\"\"\"\n613\t        from engine.game import seed_rng\n614\t\n615\t        seed = 5  # zero heads.\n616\t        assert _heads_for_seed(seed) == 0\n617\t\n618\t        game = create_game()\n619\t        p1, p2 = game.players\n620\t        assert game.active_player_index == 0\n621\t        seed_rng(game, seed)\n622\t\n623\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n624\t        pw._resolve_target = p2\n625\t        _ability_by_cost(pw, -7).effect(game)\n626\t        assert p2.skipped_turns == 0\n627\t\n628\t        # No skip queued — normal alternation hands the next turn to seat 1.\n629\t        _end_turn(game)\n630\t        assert game.active_player_index == 1\n631\t\n632\t    def test_no_target_ultimate_adds_no_skips_to_either_player(self) -> None:\n633\t        \"\"\"With no target stashed the −7 is a no-op: neither player accrues\n634\t        skipped turns even under a seed that would otherwise yield heads.\"\"\"\n635\t        from engine.game import seed_rng\n636\t\n637\t        seed = 4  # would be five heads if a target were set.\n638\t        assert _heads_for_seed(seed) == 5\n639\t\n640\t        game = create_game()\n641\t        p1, p2 = game.players\n642\t        seed_rng(game, seed)\n643\t\n644\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n645\t        pw._resolve_target = None\n646\t        _ability_by_cost(pw, -7).effect(game)\n647\t\n648\t        assert p1.skipped_turns == 0\n649\t        assert p2.skipped_turns == 0\n650\t\n651\t    def test_seeded_resolution_matches_standalone_flip_coins(self) -> None:\n652\t        \"\"\"Cross-check: resolving the seeded −7 consumes the RNG identically to\n653\t        a standalone ``flip_coins(game, 5)`` on a same-seeded game, proving the\n654\t        ability draws its X from the documented coin-flip API.\"\"\"\n655\t        from engine.game import flip_coins, seed_rng\n656\t\n657\t        seed = 6\n658\t        # Ground truth via the standalone API.\n659\t        standalone = create_game()\n660\t        seed_rng(standalone, seed)\n661\t        standalone_heads = flip_coins(standalone, 5)\n662\t\n663\t        game = create_game()\n664\t        p1, p2 = game.players\n665\t        seed_rng(game, seed)\n666\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n667\t        pw._resolve_target = p2\n668\t        _ability_by_cost(pw, -7).effect(game)\n669\t\n670\t        assert p2.skipped_turns == standalone_heads\n671\t"}]},"parent_tool_use_id":"toolu_01FLN5x2mJgycms39NgV7mjz","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"0c18edfb-ebd1-4179-aa85-6b4d1df17d2e","timestamp":"2026-06-02T08:44:50.545Z","subagent_type":"Reviewer","task_description":"Review sos_97 implementation"}
