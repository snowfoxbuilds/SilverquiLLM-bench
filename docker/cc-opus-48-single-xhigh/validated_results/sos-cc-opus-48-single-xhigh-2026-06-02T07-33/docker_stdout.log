{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PwGGwcqf7jWCEzJLPmVeut","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_226/card_impl.py b/cards/sos/sos_226/card_impl.py\n2\tindex a3ef6eb..685e602 100644\n3\t--- a/cards/sos/sos_226/card_impl.py\n4\t+++ b/cards/sos/sos_226/card_impl.py\n5\t@@ -1,16 +1,213 @@\n6\t-\"\"\"Card implementation for Silverquill, the Disputant.\"\"\"\n7\t+\"\"\"Card implementation for Silverquill, the Disputant (SOS 226).\"\"\"\n8\t \n9\t from __future__ import annotations\n10\t \n11\t-from engine.card import CardImpl\n12\t+from typing import TYPE_CHECKING, Any\n13\t \n14\t-from typing import TYPE_CHECKING\n15\t+from engine.card import Creature\n16\t+from engine.types import Color, Keyword, ManaCost, Supertype\n17\t \n18\t if TYPE_CHECKING:\n19\t     from engine.game_state import GameState\n20\t \n21\t \n22\t-class SilverquillTheDisputant(CardImpl):\n23\t-    \"\"\"TODO: Implement Silverquill, the Disputant.\"\"\"\n24\t+def _is_on_battlefield(game: Any, obj: Any) -> bool:\n25\t+    \"\"\"Return ``True`` if *obj* is on any player's battlefield.\"\"\"\n26\t+    for player in game.players:\n27\t+        if game.get_battlefield(player).contains(obj):\n28\t+            return True\n29\t+    return False\n30\t \n31\t-    pass\n32\t+\n33\t+class SilverquillTheDisputant(Creature):\n34\t+    \"\"\"Silverquill, the Disputant — {2}{W}{B} — Legendary Creature — Elder Dragon.\n35\t+\n36\t+    Flying, vigilance.\n37\t+    Each instant and sorcery spell you cast has casualty 1.  (As you cast that\n38\t+    spell, you may sacrifice a creature with power 1 or greater.  When you do,\n39\t+    copy the spell and you may choose new targets for the copy.)\n40\t+\n41\t+    SOS collector number 226.\n42\t+    \"\"\"\n43\t+\n44\t+    #: The casualty value Silverquill grants to the instants/sorceries its\n45\t+    #: controller casts.  \"Casualty\" is a printed keyword label, NOT an\n46\t+    #: evergreen ``engine.types.Keyword`` enum member (that enum is frozen at\n47\t+    #: 16 members), so it is recorded as a printed-keyword label below.\n48\t+    CASUALTY_LABEL = \"Casualty 1\"\n49\t+\n50\t+    def __init__(self, **kwargs: Any) -> None:\n51\t+        kwargs.setdefault(\"name\", \"Silverquill, the Disputant\")\n52\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{2}{W}{B}\"))\n53\t+        kwargs.setdefault(\"subtypes\", {\"Dragon\", \"Elder\"})\n54\t+        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n55\t+        kwargs.setdefault(\"keywords\", Keyword.FLYING | Keyword.VIGILANCE)\n56\t+        kwargs.setdefault(\"base_power\", 4)\n57\t+        kwargs.setdefault(\"base_toughness\", 4)\n58\t+        kwargs.setdefault(\n59\t+            \"rules_text\",\n60\t+            \"Flying, vigilance\\n\"\n61\t+            \"Each instant and sorcery spell you cast has casualty 1. (As you \"\n62\t+            \"cast that spell, you may sacrifice a creature with power 1 or \"\n63\t+            \"greater. When you do, copy the spell and you may choose new \"\n64\t+            \"targets for the copy.)\",\n65\t+        )\n66\t+        super().__init__(**kwargs)\n67\t+        # Explicit colour identity (W+B) so the colour is stable even when the\n68\t+        # cost is unavailable (e.g. on copies); the cost pips already encode it.\n69\t+        self.colors: list[Color] = [Color.WHITE, Color.BLACK]\n70\t+        # Printed-keyword label surface — Casualty is a printed keyword, not an\n71\t+        # evergreen ``Keyword`` enum member.\n72\t+        self.printed_keywords: list[str] = [self.CASUALTY_LABEL]\n73\t+\n74\t+    # ------------------------------------------------------------------\n75\t+    # Casualty grant — queryable surface\n76\t+    # ------------------------------------------------------------------\n77\t+\n78\t+    def get_casualty_value(self, game: \"GameState\", spell: Any) -> int | None:\n79\t+        \"\"\"Return the casualty value this card grants to *spell*, or ``None``.\n80\t+\n81\t+        Silverquill grants casualty 1 to every instant and sorcery spell *its\n82\t+        controller casts*.  This is the queryable grant surface the tests probe:\n83\t+        it returns ``1`` only when\n84\t+\n85\t+        * Silverquill is on the battlefield,\n86\t+        * *spell* is an instant or a sorcery, and\n87\t+        * *spell* is controlled by / in the hand of Silverquill's controller,\n88\t+\n89\t+        and ``None`` otherwise (creatures, an opponent's spell, etc.).\n90\t+        \"\"\"\n91\t+        from engine.casualty import CASUALTY_ONE, is_instant_or_sorcery\n92\t+\n93\t+        controller = self.controller\n94\t+        if controller is None:\n95\t+            return None\n96\t+        if not _is_on_battlefield(game, self):\n97\t+            return None\n98\t+        if not is_instant_or_sorcery(spell):\n99\t+            return None\n100\t+        if not self._spell_is_controllers(game, spell, controller):\n101\t+            return None\n102\t+        return CASUALTY_ONE\n103\t+\n104\t+    def _spell_is_controllers(\n105\t+        self, game: \"GameState\", spell: Any, controller: Any\n106\t+    ) -> bool:\n107\t+        \"\"\"Return ``True`` if *spell* belongs to Silverquill's controller.\n108\t+\n109\t+        The grant only applies to spells *you* cast (CR 702.153a is granted to\n110\t+        \"each instant and sorcery spell you cast\").  With no live cast pipeline,\n111\t+        a spell is treated as the controller's when it is in the controller's\n112\t+        hand (the observable proxy the tests use) or already controlled by the\n113\t+        controller (a spell on the stack).\"\"\"\n114\t+        # A spell on the stack carries an explicit controller.\n115\t+        spell_controller = getattr(spell, \"controller\", None)\n116\t+        if spell_controller is controller:\n117\t+            return True\n118\t+        # Otherwise treat a card in the controller's hand as the proxy.\n119\t+        if game.get_hand(controller).contains(spell):\n120\t+            return True\n121\t+        # If the spell lives in another player's hand, it is not yours.\n122\t+        for player in game.players:\n123\t+            if player is controller:\n124\t+                continue\n125\t+            if game.get_hand(player).contains(spell):\n126\t+                return False\n127\t+        # Unknown zone with no contradicting evidence — not granted.\n128\t+        return False\n129\t+\n130\t+    # ------------------------------------------------------------------\n131\t+    # Continuous grant + casualty pay/copy hook wiring\n132\t+    # ------------------------------------------------------------------\n133\t+\n134\t+    def register_triggers(self, game: \"GameState\") -> None:\n135\t+        \"\"\"Register the continuous casualty grant and the cast/copy hook.\"\"\"\n136\t+        self._apply_casualty_grant(game)\n137\t+        self._register_casualty_cast_hook(game)\n138\t+\n139\t+    def register_replacement_effects(self, game: \"GameState\") -> None:\n140\t+        \"\"\"Refresh the casualty grant whenever effects are recomputed.\"\"\"\n141\t+        self._apply_casualty_grant(game)\n142\t+\n143\t+    def _apply_casualty_grant(self, game: \"GameState\") -> None:\n144\t+        \"\"\"Write casualty 1 onto every instant/sorcery in the controller's hand.\n145\t+\n146\t+        Reuses the additive :func:`engine.casualty.grant_casualty_to_hand` so the\n147\t+        grant is queryable both via :meth:`get_casualty_value` (above) and via the\n148\t+        ``casualty`` attribute the framework writes onto each affected hand card.\n149\t+        No-ops while Silverquill is not on the battlefield.\n150\t+        \"\"\"\n151\t+        from engine.casualty import (\n152\t+            CASUALTY_ONE,\n153\t+            clear_casualty_grants,\n154\t+            grant_casualty_to_hand,\n155\t+        )\n156\t+\n157\t+        controller = self.controller\n158\t+        if controller is None:\n159\t+            return\n160\t+        if not _is_on_battlefield(game, self):\n161\t+            clear_casualty_grants(game, self)\n162\t+            return\n163\t+        grant_casualty_to_hand(game, self, controller, CASUALTY_ONE)\n164\t+\n165\t+    def _register_casualty_cast_hook(self, game: \"GameState\") -> None:\n166\t+        \"\"\"Wire the cast-time casualty offer (pay-by-sacrifice + copy, 702.153).\n167\t+\n168\t+        Registers (deduped per source) a\n169\t+        :class:`~engine.events.SpellCastTriggeredEvent` trigger that fires when\n170\t+        Silverquill's controller casts an instant or sorcery spell.  When it\n171\t+        fires, the controller is offered the optional casualty cost: sacrifice a\n172\t+        creature with power 1 or greater; on payment, the spell is copied onto\n173\t+        the stack with optional new targets (CR 702.153a/c).\"\"\"\n174\t+        from engine.casualty import CASUALTY_ONE, is_instant_or_sorcery, offer_casualty\n175\t+        from engine.events import SpellCastTriggeredEvent\n176\t+        from engine.triggers import TriggerRegistration\n177\t+\n178\t+        registry = getattr(game, \"_casualty_cast_hooks\", None)\n179\t+        if registry is None:\n180\t+            registry = set()\n181\t+            game._casualty_cast_hooks = registry  # type: ignore[attr-defined]\n182\t+        if id(self) in registry:\n183\t+            return\n184\t+        registry.add(id(self))\n185\t+\n186\t+        source = self\n187\t+        controller = self.controller or game.active_player\n188\t+\n189\t+        def _condition(g: \"GameState\", event: Any) -> bool:\n190\t+            ctrl = getattr(source, \"controller\", None)\n191\t+            if ctrl is None:\n192\t+                return False\n193\t+            if not _is_on_battlefield(g, source):\n194\t+                return False\n195\t+            caster = getattr(event, \"player\", None) or getattr(\n196\t+                event, \"controller\", None\n197\t+            )\n198\t+            if caster is not ctrl:\n199\t+                return False\n200\t+            spell = getattr(event, \"spell\", None) or getattr(event, \"card\", None)\n201\t+            if spell is None or not is_instant_or_sorcery(spell):\n202\t+                return False\n203\t+            source._casualty_pending_spell = spell  # type: ignore[attr-defined]\n204\t+            return True\n205\t+\n206\t+        def _effect(g: \"GameState\") -> None:\n207\t+            spell = getattr(source, \"_casualty_pending_spell\", None)\n208\t+            source._casualty_pending_spell = None  # type: ignore[attr-defined]\n209\t+            if spell is None:\n210\t+                return\n211\t+            ctrl = getattr(source, \"controller\", None)\n212\t+            if ctrl is None:\n213\t+                return\n214\t+            offer_casualty(g, ctrl, spell, CASUALTY_ONE)\n215\t+\n216\t+        game.trigger_manager.register(\n217\t+            TriggerRegistration(\n218\t+                event_type=SpellCastTriggeredEvent,\n219\t+                condition=_condition,\n220\t+                effect=_effect,\n221\t+                source=self,\n222\t+                controller=controller,\n223\t+            )\n224\t+        )\n225\tdiff --git a/engine/casualty.py b/engine/casualty.py\n226\tnew file mode 100644\n227\tindex 0000000..9cb3c27\n228\t--- /dev/null\n229\t+++ b/engine/casualty.py\n230\t@@ -0,0 +1,476 @@\n231\t+\"\"\"Casualty-keyword framework (Comprehensive Rules 702.153).\n232\t+\n233\t+*Casualty* is a static ability linked to a triggered ability:\n234\t+\n235\t+    Casualty N (As an additional cost to cast this spell, you may sacrifice a\n236\t+    creature with power N or greater.  When you cast this spell, if a casualty\n237\t+    cost was paid for it, copy it.  If the spell has any targets, you may choose\n238\t+    new targets for the copy.)\n239\t+\n240\t+A card normally carries casualty as a printed ability, but Silverquill, the\n241\t+Disputant *grants* casualty 1 to every instant and sorcery **spell** its\n242\t+controller casts.  The engine had no support for the mechanic, so this module\n243\t+adds it *additively* — no existing engine symbol is renamed, moved, or deleted.\n244\t+It mirrors :mod:`engine.miracle` / :mod:`engine.preparation` / :mod:`engine.paradigm`.\n245\t+\n246\t+The mechanic has three observable parts:\n247\t+\n248\t+1. **The grant surface.**  A *granted casualty value* is recorded on the affected\n249\t+   spell (an ``int`` written to ``spell.casualty``) and is also queryable via\n250\t+   :func:`get_casualty_value`.  A continuous-grant source (Silverquill) installs /\n251\t+   refreshes the grant via :func:`grant_casualty_to_hand`, which only ever writes\n252\t+   the value onto instants/sorceries in *its controller's* hand and clears stale\n253\t+   grants from cards that have left the hand.\n254\t+\n255\t+2. **The optional additional cost — sacrifice a creature with power >= N\n256\t+   (CR 702.153a).**  :func:`legal_casualty_sacrifices` exposes the set of legal\n257\t+   sacrifice candidates (creatures the caster controls whose power is >= N), so\n258\t+   the power boundary is observable (power 0 illegal, power 1 legal).\n259\t+   :func:`pay_casualty` performs the payment: it validates the chosen creature's\n260\t+   power, sacrifices it, and records the payment on the spell\n261\t+   (``spell.casualty_paid = True``).\n262\t+\n263\t+3. **Copy-on-payment (CR 702.153c).**  When the casualty cost is paid, the spell\n264\t+   is copied onto the stack under the controller's control, with the option to\n265\t+   choose new targets for the copy.  This reuses the existing engine spell-copy\n266\t+   primitive :func:`engine.stack.copy_spell` (no new copy primitive is added).\n267\t+\n268\t+\"Casualty\" is a *printed keyword label*, not an evergreen keyword, so no member\n269\t+is added to :class:`engine.types.Keyword` (that enum is frozen at 16 members).\n270\t+\"\"\"\n271\t+\n272\t+from __future__ import annotations\n273\t+\n274\t+from typing import TYPE_CHECKING, Any\n275\t+\n276\t+from engine.types import CardType, Zone\n277\t+\n278\t+if TYPE_CHECKING:\n279\t+    from engine.game_state import GameState\n280\t+    from engine.player import Player\n281\t+\n282\t+\n283\t+#: Default casualty value granted by Silverquill, the Disputant (casualty 1).\n284\t+CASUALTY_ONE: int = 1\n285\t+\n286\t+\n287\t+# ---------------------------------------------------------------------------\n288\t+# Grant surface — read / write the granted casualty value on a spell\n289\t+# ---------------------------------------------------------------------------\n290\t+\n291\t+\n292\t+def is_instant_or_sorcery(card: Any) -> bool:\n293\t+    \"\"\"Return ``True`` if *card* is an instant or sorcery (the granted types).\"\"\"\n294\t+    card_types = getattr(card, \"card_types\", set())\n295\t+    return CardType.INSTANT in card_types or CardType.SORCERY in card_types\n296\t+\n297\t+\n298\t+def get_casualty_value(card: Any) -> int | None:\n299\t+    \"\"\"Return the granted casualty value on *card*, or ``None`` if none.\n300\t+\n301\t+    The grant is stored on the card as an ``int`` under ``card.casualty`` (the\n302\t+    queryable grant surface).  Returns ``None`` when the card carries no granted\n303\t+    casualty value.\n304\t+    \"\"\"\n305\t+    return getattr(card, \"casualty\", None)\n306\t+\n307\t+\n308\t+def set_casualty_value(card: Any, value: int | None) -> None:\n309\t+    \"\"\"Write (or clear) the granted casualty value on *card*.\n310\t+\n311\t+    Passing ``None`` clears the grant (removes the ``casualty`` attribute so a\n312\t+    stale grant never lingers on a card that has left the granting zone).\n313\t+    \"\"\"\n314\t+    if value is None:\n315\t+        if hasattr(card, \"casualty\"):\n316\t+            try:\n317\t+                delattr(card, \"casualty\")\n318\t+            except AttributeError:\n319\t+                card.casualty = None  # type: ignore[attr-defined]\n320\t+        # Also drop the source back-link so the card is fully de-granted.\n321\t+        if hasattr(card, \"_casualty_grant_source\"):\n322\t+            try:\n323\t+                delattr(card, \"_casualty_grant_source\")\n324\t+            except AttributeError:\n325\t+                pass\n326\t+        return\n327\t+    card.casualty = value  # type: ignore[attr-defined]\n328\t+\n329\t+\n330\t+def has_casualty(card: Any) -> bool:\n331\t+    \"\"\"Return ``True`` if *card* currently carries a granted casualty value.\"\"\"\n332\t+    return get_casualty_value(card) is not None\n333\t+\n334\t+\n335\t+# ---------------------------------------------------------------------------\n336\t+# Per-game registry of cards a given source has granted casualty to\n337\t+# ---------------------------------------------------------------------------\n338\t+\n339\t+\n340\t+def _granted_registry(game: GameState) -> dict[int, set[int]]:\n341\t+    \"\"\"Return (creating if necessary) the per-game casualty-grant registry.\n342\t+\n343\t+    Maps ``id(source)`` to the set of ``id(card)`` it last granted casualty to,\n344\t+    so a refresh can clear grants from cards that have since left the granting\n345\t+    zone.  Stored lazily on the game object — no ``GameState.__init__`` change.\n346\t+    \"\"\"\n347\t+    registry = getattr(game, \"_casualty_grants\", None)\n348\t+    if registry is None:\n349\t+        registry = {}\n350\t+        game._casualty_grants = registry  # type: ignore[attr-defined]\n351\t+    return registry\n352\t+\n353\t+\n354\t+# ---------------------------------------------------------------------------\n355\t+# The continuous grant — \"each instant/sorcery you cast has casualty {N}\"\n356\t+# ---------------------------------------------------------------------------\n357\t+\n358\t+\n359\t+def grant_casualty_to_hand(\n360\t+    game: GameState,\n361\t+    source: Any,\n362\t+    controller: Any,\n363\t+    value: int = CASUALTY_ONE,\n364\t+) -> list[Any]:\n365\t+    \"\"\"Grant casualty *value* to every instant/sorcery in *controller*'s hand.\n366\t+\n367\t+    This is the body of Silverquill's continuous static ability: while the\n368\t+    source is on the battlefield, every instant and sorcery spell its controller\n369\t+    casts \"has casualty 1\".  The casting/casualty pipeline observes the grant on\n370\t+    the spell object regardless of zone; with no live cast pipeline the\n371\t+    controller's-hand instants/sorceries are the natural observable proxy (the\n372\t+    same proxy :mod:`engine.miracle` uses).  The grant is written onto each such\n373\t+    card (``card.casualty``) and is queryable via :func:`get_casualty_value`.\n374\t+\n375\t+    The grant is *scoped*:\n376\t+\n377\t+    * only instants and sorceries are affected (creatures, lands, etc. are not);\n378\t+    * only cards in *controller*'s hand are affected (an opponent's hand is left\n379\t+      untouched).\n380\t+\n381\t+    Calling this again refreshes the grant: cards that have left the controller's\n382\t+    hand since the last refresh have their (this-source) grant cleared so a stale\n383\t+    casualty value never lingers.  Returns the list of hand cards now carrying the\n384\t+    grant.\n385\t+    \"\"\"\n386\t+    if controller is None:\n387\t+        return []\n388\t+\n389\t+    registry = _granted_registry(game)\n390\t+    previously = registry.get(id(source), set())\n391\t+\n392\t+    hand = controller.zones[Zone.HAND]\n393\t+    granted: list[Any] = []\n394\t+    now_ids: set[int] = set()\n395\t+\n396\t+    for card in hand.get_all():\n397\t+        if not is_instant_or_sorcery(card):\n398\t+            continue\n399\t+        set_casualty_value(card, value)\n400\t+        card._casualty_grant_source = source  # type: ignore[attr-defined]\n401\t+        granted.append(card)\n402\t+        now_ids.add(id(card))\n403\t+\n404\t+    # Clear grants this source placed on cards that are no longer in the hand\n405\t+    # (or are no longer instants/sorceries).\n406\t+    stale = previously - now_ids\n407\t+    if stale:\n408\t+        _clear_grants_for_ids(game, source, stale)\n409\t+\n410\t+    registry[id(source)] = now_ids\n411\t+    return granted\n412\t+\n413\t+\n414\t+def _clear_grants_for_ids(game: GameState, source: Any, card_ids: set[int]) -> None:\n415\t+    \"\"\"Clear *source*'s casualty grant from any card in *card_ids* across zones.\"\"\"\n416\t+    for player in game.players:\n417\t+        for zone in Zone:\n418\t+            container = player.zones[zone]\n419\t+            for card in list(container.get_all()):\n420\t+                if (\n421\t+                    id(card) in card_ids\n422\t+                    and getattr(card, \"_casualty_grant_source\", None) is source\n423\t+                ):\n424\t+                    set_casualty_value(card, None)\n425\t+\n426\t+\n427\t+def clear_casualty_grants(game: GameState, source: Any) -> None:\n428\t+    \"\"\"Clear every casualty grant *source* placed (e.g. when it leaves play).\"\"\"\n429\t+    registry = _granted_registry(game)\n430\t+    granted = registry.pop(id(source), set())\n431\t+    if not granted:\n432\t+        return\n433\t+    _clear_grants_for_ids(game, source, granted)\n434\t+\n435\t+\n436\t+# ---------------------------------------------------------------------------\n437\t+# Optional additional cost — sacrifice a creature with power >= N (702.153a)\n438\t+# ---------------------------------------------------------------------------\n439\t+\n440\t+\n441\t+def is_legal_casualty_sacrifice(creature: Any, value: int) -> bool:\n442\t+    \"\"\"Return ``True`` if *creature* may be sacrificed for casualty *value*.\n443\t+\n444\t+    A legal casualty sacrifice for casualty N is a creature with power N or\n445\t+    greater (CR 702.153a).  For casualty 1 a power-0 creature is illegal and a\n446\t+    power-1 (or greater) creature is legal.\n447\t+    \"\"\"\n448\t+    if creature is None:\n449\t+        return False\n450\t+    card_types = getattr(creature, \"card_types\", set())\n451\t+    if CardType.CREATURE not in card_types:\n452\t+        return False\n453\t+    power = getattr(creature, \"power\", None)\n454\t+    if power is None:\n455\t+        power = getattr(creature, \"base_power\", 0)\n456\t+    return power >= value\n457\t+\n458\t+\n459\t+def legal_casualty_sacrifices(\n460\t+    game: GameState,\n461\t+    player: Any,\n462\t+    value: int,\n463\t+) -> list[Any]:\n464\t+    \"\"\"Return the creatures *player* controls that are legal casualty sacrifices.\n465\t+\n466\t+    These are the creatures on *player*'s battlefield whose power is >= *value*\n467\t+    (CR 702.153a).  Exposing this set makes the power boundary observable: for\n468\t+    casualty 1, a power-0 creature is excluded and a power-1 (or greater)\n469\t+    creature is included.\n470\t+    \"\"\"\n471\t+    if player is None:\n472\t+        return []\n473\t+    battlefield = game.get_battlefield(player)\n474\t+    return [\n475\t+        creature\n476\t+        for creature in battlefield.get_all()\n477\t+        if is_legal_casualty_sacrifice(creature, value)\n478\t+    ]\n479\t+\n480\t+\n481\t+def mark_casualty_paid(spell: Any) -> None:\n482\t+    \"\"\"Record that a casualty cost was paid for *spell* (``spell.casualty_paid``).\"\"\"\n483\t+    spell.casualty_paid = True  # type: ignore[attr-defined]\n484\t+\n485\t+\n486\t+def was_casualty_paid(spell: Any) -> bool:\n487\t+    \"\"\"Return ``True`` if a casualty cost was recorded as paid for *spell*.\"\"\"\n488\t+    return bool(getattr(spell, \"casualty_paid\", False))\n489\t+\n490\t+\n491\t+def pay_casualty(\n492\t+    game: GameState,\n493\t+    player: Any,\n494\t+    spell: Any,\n495\t+    creature: Any,\n496\t+    value: int | None = None,\n497\t+) -> bool:\n498\t+    \"\"\"Pay *spell*'s casualty cost by sacrificing *creature* (CR 702.153a).\n499\t+\n500\t+    Validates that *creature* is a legal casualty sacrifice (a creature *player*\n501\t+    controls with power >= the casualty value), sacrifices it to its owner's\n502\t+    graveyard, and records the payment on the spell (``spell.casualty_paid =\n503\t+    True``).\n504\t+\n505\t+    The casualty value defaults to the value granted to *spell* (via\n506\t+    :func:`get_casualty_value`), falling back to :data:`CASUALTY_ONE` if the\n507\t+    spell carries no recorded grant.\n508\t+\n509\t+    Returns ``True`` if the cost was paid, ``False`` if the chosen creature is\n510\t+    not a legal sacrifice (power below the threshold, not a creature, or not\n511\t+    controlled by *player*) — in which case nothing is sacrificed and no payment\n512\t+    is recorded.\n513\t+\n514\t+    NOTE: paying the casualty cost does **not** itself produce the copy — the\n515\t+    copy is the casualty *triggered* ability (CR 702.153c).  Call\n516\t+    :func:`copy_spell_on_casualty` (or :func:`offer_casualty`, which wires both)\n517\t+    to produce the copy once the spell is on the stack.\n518\t+    \"\"\"\n519\t+    from engine.game import sacrifice\n520\t+\n521\t+    if value is None:\n522\t+        value = get_casualty_value(spell)\n523\t+        if value is None:\n524\t+            value = CASUALTY_ONE\n525\t+\n526\t+    # The creature must be a legal sacrifice AND under the player's control.\n527\t+    if not is_legal_casualty_sacrifice(creature, value):\n528\t+        return False\n529\t+    if not game.get_battlefield(player).contains(creature):\n530\t+        return False\n531\t+\n532\t+    sacrifice(game, player, creature)\n533\t+    mark_casualty_paid(spell)\n534\t+    return True\n535\t+\n536\t+\n537\t+# ---------------------------------------------------------------------------\n538\t+# Copy-on-payment (CR 702.153c)\n539\t+# ---------------------------------------------------------------------------\n540\t+\n541\t+\n542\t+def _find_stack_object(game: GameState, spell: Any) -> Any | None:\n543\t+    \"\"\"Return the :class:`~engine.stack.StackObject` whose source is *spell*.\"\"\"\n544\t+    for stack_obj in game.stack._items:\n545\t+        if stack_obj.source is spell:\n546\t+            return stack_obj\n547\t+    return None\n548\t+\n549\t+\n550\t+def copy_spell_on_casualty(\n551\t+    game: GameState,\n552\t+    player: Any,\n553\t+    spell: Any,\n554\t+    new_targets: list[Any] | None = None,\n555\t+) -> Any | None:\n556\t+    \"\"\"Copy *spell* onto the stack under *player*'s control (CR 702.153c).\n557\t+\n558\t+    Implements the casualty triggered ability: \"When you cast this spell, if a\n559\t+    casualty cost was paid for it, copy it.  If the spell has any targets, you\n560\t+    may choose new targets for the copy.\"  *spell* must be on the stack.  Reuses\n561\t+    the engine spell-copy primitive :func:`engine.stack.copy_spell`, so the copy\n562\t+    shares the original's identity but has independent state and (optionally) new\n563\t+    targets.  The copy is pushed onto the stack and returned so callers/tests can\n564\t+    observe it.\n565\t+\n566\t+    Returns the copy's :class:`~engine.stack.StackObject`, or ``None`` if the\n567\t+    original spell is not on the stack.\n568\t+    \"\"\"\n569\t+    from engine.stack import copy_spell\n570\t+\n571\t+    original = _find_stack_object(game, spell)\n572\t+    if original is None:\n573\t+        return None\n574\t+\n575\t+    copy_obj = copy_spell(game, original, player, new_targets)\n576\t+    game.stack.push(copy_obj)\n577\t+    return copy_obj\n578\t+\n579\t+\n580\t+def offer_casualty(\n581\t+    game: GameState,\n582\t+    player: Any,\n583\t+    spell: Any,\n584\t+    value: int | None = None,\n585\t+) -> Any | None:\n586\t+    \"\"\"Offer *player* the option to pay *spell*'s casualty cost and copy it.\n587\t+\n588\t+    This wires the whole optional mechanic (CR 702.153a/c) around a spell that is\n589\t+    already on the stack:\n590\t+\n591\t+    1. Compute the legal sacrifice candidates (creatures with power >= the\n592\t+       casualty value).  With none available, the offer cannot be paid.\n593\t+    2. Ask the player whether they want to pay the casualty cost.\n594\t+    3. On *yes*, ask which creature to sacrifice, validate and pay via\n595\t+       :func:`pay_casualty` (recording ``spell.casualty_paid``), then copy the\n596\t+       spell onto the stack via :func:`copy_spell_on_casualty`, offering new\n597\t+       targets for the copy if the spell had any.\n598\t+\n599\t+    Returns the copy's :class:`~engine.stack.StackObject` if the casualty cost\n600\t+    was paid and the copy produced, otherwise ``None`` (declined, no legal\n601\t+    sacrifice, or the spell left the stack).\n602\t+    \"\"\"\n603\t+    if value is None:\n604\t+        value = get_casualty_value(spell)\n605\t+        if value is None:\n606\t+            value = CASUALTY_ONE\n607\t+\n608\t+    candidates = legal_casualty_sacrifices(game, player, value)\n609\t+    if not candidates:\n610\t+        return None\n611\t+\n612\t+    chooser = getattr(player, \"choose_yes_no\", None)\n613\t+    if not callable(chooser):\n614\t+        return None\n615\t+    try:\n616\t+        wants = bool(\n617\t+            chooser(\n618\t+                f\"Pay casualty {value} for \"\n619\t+                f\"{getattr(spell, 'name', 'this spell')} \"\n620\t+                f\"(sacrifice a creature with power {value} or greater)?\"\n621\t+            )\n622\t+        )\n623\t+    except Exception:\n624\t+        return None\n625\t+    if not wants:\n626\t+        return None\n627\t+\n628\t+    # Choose which creature to sacrifice.\n629\t+    picker = getattr(player, \"choose_card\", None)\n630\t+    chosen = candidates[0]\n631\t+    if callable(picker):\n632\t+        try:\n633\t+            chosen = picker(candidates, \"creature to sacrifice for casualty\")\n634\t+        except Exception:\n635\t+            chosen = candidates[0]\n636\t+    if chosen is None or not is_legal_casualty_sacrifice(chosen, value):\n637\t+        return None\n638\t+\n639\t+    if not pay_casualty(game, player, spell, chosen, value):\n640\t+        return None\n641\t+\n642\t+    # CR 702.153c — produce the copy, with optional new targets.\n643\t+    new_targets = _maybe_choose_new_targets(game, player, spell)\n644\t+    return copy_spell_on_casualty(game, player, spell, new_targets)\n645\t+\n646\t+\n647\t+def _maybe_choose_new_targets(\n648\t+    game: GameState,\n649\t+    player: Any,\n650\t+    spell: Any,\n651\t+) -> list[Any] | None:\n652\t+    \"\"\"Optionally let *player* choose new targets for the casualty copy.\n653\t+\n654\t+    Returns the chosen new target list, or ``None`` to keep the original\n655\t+    targets.  Only prompts when the spell has at least one target on its stack\n656\t+    object; declining keeps the original targets (CR 702.153a: \"you may choose\n657\t+    new targets for the copy\").\n658\t+    \"\"\"\n659\t+    original = _find_stack_object(game, spell)\n660\t+    if original is None or not original.targets:\n661\t+        return None\n662\t+\n663\t+    chooser = getattr(player, \"choose_yes_no\", None)\n664\t+    if not callable(chooser):\n665\t+        return None\n666\t+    try:\n667\t+        wants = bool(\n668\t+            chooser(\n669\t+                f\"Choose new targets for the copy of \"\n670\t+                f\"{getattr(spell, 'name', 'this spell')}?\"\n671\t+            )\n672\t+        )\n673\t+    except Exception:\n674\t+        return None\n675\t+    if not wants:\n676\t+        return None\n677\t+\n678\t+    get_targets = getattr(spell, \"get_targets\", None)\n679\t+    if not callable(get_targets):\n680\t+        return None\n681\t+    try:\n682\t+        requirements = get_targets(game)\n683\t+    except Exception:\n684\t+        return None\n685\t+    if not requirements:\n686\t+        return None\n687\t+\n688\t+    new_targets: list[Any] = []\n689\t+    for req in requirements:\n690\t+        legal: list[Any] = []\n691\t+        filter_fn = getattr(req, \"filter_fn\", None)\n692\t+        for p in game.players:\n693\t+            for obj in game.get_battlefield(p).get_all():\n694\t+                if filter_fn is None or filter_fn(obj):\n695\t+                    legal.append(obj)\n696\t+            if filter_fn is not None and filter_fn(p):\n697\t+                legal.append(p)\n698\t+        if not legal:\n699\t+            continue\n700\t+        try:\n701\t+            chosen = player.choose_target(legal, req)\n702\t+        except Exception:\n703\t+            chosen = legal[0]\n704\t+        new_targets.append(chosen)\n705\t+\n706\t+    return new_targets or None\n707\t"}]},"parent_tool_use_id":"toolu_018GmEL7Ns3yBUZBZpcJCUmz","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"1aa9e1ce-abc6-4735-aac7-746deb3ff7a2","timestamp":"2026-06-02T09:41:32.187Z","subagent_type":"Reviewer","task_description":"Review sos_226 implementation"}
