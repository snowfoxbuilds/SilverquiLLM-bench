{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01L4coB3RiE7Vz6xqyTHSw1S","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_1/card_impl.py b/cards/sos/sos_1/card_impl.py\n2\tindex 6f6280e..02a0b10 100644\n3\t--- a/cards/sos/sos_1/card_impl.py\n4\t+++ b/cards/sos/sos_1/card_impl.py\n5\t@@ -2,15 +2,143 @@\n6\t \n7\t from __future__ import annotations\n8\t \n9\t-from engine.card import CardImpl\n10\t+from typing import TYPE_CHECKING, Any\n11\t \n12\t-from typing import TYPE_CHECKING\n13\t+from engine.card import Creature\n14\t+from engine.events import AttacksTriggeredEvent\n15\t+from engine.triggers import TriggerRegistration\n16\t+from engine.types import CardType, Keyword, ManaCost, Supertype, Zone\n17\t \n18\t if TYPE_CHECKING:\n19\t     from engine.game_state import GameState\n20\t \n21\t \n22\t-class TheDawningArchaic(CardImpl):\n23\t-    \"\"\"TODO: Implement The Dawning Archaic.\"\"\"\n24\t+class TheDawningArchaic(Creature):\n25\t+    \"\"\"The Dawning Archaic — {10} — 7/7 — Legendary Creature — Avatar.\n26\t \n27\t-    pass\n28\t+    This spell costs {1} less to cast for each instant and sorcery card in\n29\t+    your graveyard.\n30\t+    Reach\n31\t+    Whenever The Dawning Archaic attacks, you may cast target instant or\n32\t+    sorcery card from your graveyard without paying its mana cost. If that\n33\t+    spell would be put into your graveyard, exile it instead.\n34\t+\n35\t+    SOS collector number 1.\n36\t+    \"\"\"\n37\t+\n38\t+    def __init__(self, **kwargs: Any) -> None:\n39\t+        kwargs.setdefault(\"name\", \"The Dawning Archaic\")\n40\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{10}\"))\n41\t+        kwargs.setdefault(\"subtypes\", {\"Avatar\"})\n42\t+        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n43\t+        kwargs.setdefault(\"keywords\", Keyword.REACH)\n44\t+        kwargs.setdefault(\"base_power\", 7)\n45\t+        kwargs.setdefault(\"base_toughness\", 7)\n46\t+        kwargs.setdefault(\n47\t+            \"rules_text\",\n48\t+            \"This spell costs {1} less to cast for each instant and sorcery \"\n49\t+            \"card in your graveyard.\\nReach\\nWhenever The Dawning Archaic \"\n50\t+            \"attacks, you may cast target instant or sorcery card from your \"\n51\t+            \"graveyard without paying its mana cost. If that spell would be \"\n52\t+            \"put into your graveyard, exile it instead.\",\n53\t+        )\n54\t+        super().__init__(**kwargs)\n55\t+\n56\t+    # ------------------------------------------------------------------\n57\t+    # Cost reduction — {1} less for each instant/sorcery in your graveyard.\n58\t+    # ------------------------------------------------------------------\n59\t+\n60\t+    def cost_reduction(self, game: \"GameState\") -> int:\n61\t+        \"\"\"Reduce the generic cost by {1} per instant/sorcery in your graveyard.\n62\t+\n63\t+        Only the controller's graveyard is consulted, and only instant and\n64\t+        sorcery cards count.  The engine clamps the final value so generic\n65\t+        mana never goes below 0 (see ``engine.casting.get_cost_reduction``).\n66\t+        \"\"\"\n67\t+        controller = self.controller\n68\t+        if controller is None:\n69\t+            return 0\n70\t+        graveyard = controller.zones[Zone.GRAVEYARD]\n71\t+        count = 0\n72\t+        for card in graveyard.get_all():\n73\t+            card_types = getattr(card, \"card_types\", set())\n74\t+            if CardType.INSTANT in card_types or CardType.SORCERY in card_types:\n75\t+                count += 1\n76\t+        return count\n77\t+\n78\t+    # ------------------------------------------------------------------\n79\t+    # Attack trigger — may recast an instant/sorcery from your graveyard.\n80\t+    # ------------------------------------------------------------------\n81\t+\n82\t+    def register_triggers(self, game: \"GameState\") -> None:\n83\t+        \"\"\"Register the attack trigger that recasts a graveyard spell for free.\"\"\"\n84\t+        source = self\n85\t+        controller = getattr(self, \"controller\", None) or game.active_player\n86\t+\n87\t+        def _condition(game: Any, event: AttacksTriggeredEvent) -> bool:\n88\t+            return event.creature is source\n89\t+\n90\t+        def _effect(game: \"GameState\") -> None:\n91\t+            ctrl = getattr(source, \"controller\", None)\n92\t+            if ctrl is None:\n93\t+                return\n94\t+\n95\t+            graveyard = ctrl.zones[Zone.GRAVEYARD]\n96\t+            candidates = [\n97\t+                c\n98\t+                for c in graveyard.get_all()\n99\t+                if CardType.INSTANT in getattr(c, \"card_types\", set())\n100\t+                or CardType.SORCERY in getattr(c, \"card_types\", set())\n101\t+            ]\n102\t+            if not candidates:\n103\t+                return\n104\t+\n105\t+            # Optional \"you may\" — ask before committing to a target.\n106\t+            try:\n107\t+                wants_to_cast = ctrl.choose_yes_no(\n108\t+                    \"Cast an instant or sorcery from your graveyard \"\n109\t+                    \"without paying its mana cost?\"\n110\t+                )\n111\t+            except Exception:\n112\t+                wants_to_cast = False\n113\t+            if not wants_to_cast:\n114\t+                return\n115\t+\n116\t+            # Choose the target instant/sorcery card from the graveyard.\n117\t+            try:\n118\t+                chosen = ctrl.choose_card(\n119\t+                    candidates,\n120\t+                    \"instant or sorcery card to cast from your graveyard\",\n121\t+                )\n122\t+            except Exception:\n123\t+                chosen = None\n124\t+            if chosen is None or not graveyard.contains(chosen):\n125\t+                return\n126\t+\n127\t+            # \"If that spell would be put into your graveyard, exile it\n128\t+            # instead.\" — register a stack→graveyard redirect for this spell\n129\t+            # so that when it finishes resolving it heads to exile.\n130\t+            from engine.casting import (\n131\t+                cast_spell_free,\n132\t+                register_stack_to_graveyard_redirect,\n133\t+            )\n134\t+\n135\t+            register_stack_to_graveyard_redirect(game, chosen, \"exile\")\n136\t+            try:\n137\t+                cast_spell_free(game, ctrl, chosen, Zone.GRAVEYARD)\n138\t+            except Exception:\n139\t+                # If the cast fails (e.g. illegal target), clear the redirect\n140\t+                # so a future natural trip to the graveyard is unaffected.\n141\t+                from engine.casting import clear_stack_to_graveyard_redirect\n142\t+\n143\t+                clear_stack_to_graveyard_redirect(game, chosen)\n144\t+\n145\t+        game.trigger_manager.register(\n146\t+            TriggerRegistration(\n147\t+                event_type=AttacksTriggeredEvent,\n148\t+                condition=_condition,\n149\t+                effect=_effect,\n150\t+                source=self,\n151\t+                controller=controller,\n152\t+            )\n153\t+        )\n154\tdiff --git a/engine/casting.py b/engine/casting.py\n155\tindex 5d8acca..4bf1282 100644\n156\t--- a/engine/casting.py\n157\t+++ b/engine/casting.py\n158\t@@ -371,6 +371,61 @@ def cast_spell_free(\n159\t     game.stack.push(stack_obj)\n160\t \n161\t \n162\t+# ------------------------------------------------------------------\n163\t+# Stack → graveyard redirection registry\n164\t+# ------------------------------------------------------------------\n165\t+#\n166\t+# Some effects (e.g. \"you may cast target instant or sorcery from your\n167\t+# graveyard ... If that spell would be put into your graveyard, exile it\n168\t+# instead\") need to redirect a *spell* (a non-permanent on the stack) to a\n169\t+# zone other than the graveyard when it finishes resolving.  The engine's\n170\t+# replacement-effect pipeline in ``engine.zones.move_to_zone`` only consults\n171\t+# replacement effects when a card is *leaving the battlefield*, so it does not\n172\t+# cover the STACK → GRAVEYARD transition a resolving instant/sorcery makes.\n173\t+#\n174\t+# This lightweight, per-game registry lets such effects register a one-shot\n175\t+# redirect keyed on the specific card object.  ``_resolve_spell`` consults the\n176\t+# registry when an instant/sorcery would head to the graveyard and routes the\n177\t+# card to the requested zone instead (clearing the entry afterwards so the\n178\t+# redirect applies only to this resolution).\n179\t+\n180\t+\n181\t+def _redirect_registry(game: GameState) -> dict[int, str]:\n182\t+    \"\"\"Return (creating if necessary) the per-game stack→graveyard redirect map.\n183\t+\n184\t+    The map is keyed by ``id(card)`` so identity-based lookup is preserved even\n185\t+    for cards that are not hashable in a domain-meaningful way.  Stored lazily\n186\t+    on the game object so no change to ``GameState.__init__`` is required.\n187\t+    \"\"\"\n188\t+    registry = getattr(game, \"_stack_to_graveyard_redirects\", None)\n189\t+    if registry is None:\n190\t+        registry = {}\n191\t+        game._stack_to_graveyard_redirects = registry  # type: ignore[attr-defined]\n192\t+    return registry\n193\t+\n194\t+\n195\t+def register_stack_to_graveyard_redirect(\n196\t+    game: GameState,\n197\t+    card: CardImpl,\n198\t+    destination: str,\n199\t+) -> None:\n200\t+    \"\"\"Redirect *card* away from the graveyard when it resolves off the stack.\n201\t+\n202\t+    Registers a one-shot redirect so that when *card* (a resolving\n203\t+    instant/sorcery) would be put into the graveyard from the stack, it is\n204\t+    instead placed into the zone named by *destination* (``\"exile\"``,\n205\t+    ``\"hand\"``, ``\"library\"`` — see ``engine.zones._DESTINATION_ZONE_MAP``).\n206\t+\n207\t+    The redirect is consumed the first time the card resolves from the stack.\n208\t+    \"\"\"\n209\t+    _redirect_registry(game)[id(card)] = destination\n210\t+\n211\t+\n212\t+def clear_stack_to_graveyard_redirect(game: GameState, card: CardImpl) -> None:\n213\t+    \"\"\"Remove any pending stack→graveyard redirect for *card* (no-op if none).\"\"\"\n214\t+    _redirect_registry(game).pop(id(card), None)\n215\t+\n216\t+\n217\t # ------------------------------------------------------------------\n218\t # Resolution (called when the stack pops)\n219\t # ------------------------------------------------------------------\n220\t@@ -388,9 +443,11 @@ def _resolve_spell(\n221\t     3. If the card is a permanent type, move it to the battlefield via\n222\t        :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n223\t        registration and the ETB event).\n224\t-    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n225\t+    4. Otherwise (instant / sorcery), move it to the owner's graveyard —\n226\t+       unless a stack→graveyard redirect was registered for this card, in\n227\t+       which case it is routed to the requested zone (e.g. exile) instead.\n228\t     \"\"\"\n229\t-    from engine.zones import move_to_zone\n230\t+    from engine.zones import _DESTINATION_ZONE_MAP, move_to_zone\n231\t \n232\t     # Read targets from the StackObject — the single source of truth.\n233\t     # Set chosen_targets on the card just before resolution so that\n234\t@@ -406,8 +463,14 @@ def _resolve_spell(\n235\t         # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n236\t         move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n237\t     else:\n238\t-        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n239\t-        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n240\t+        # Instant/sorcery: move from stack to graveyard via move_to_zone,\n241\t+        # honouring any registered one-shot stack→graveyard redirect (e.g.\n242\t+        # \"If that spell would be put into your graveyard, exile it instead\").\n243\t+        destination = _redirect_registry(game).pop(id(card), None)\n244\t+        dest_zone = Zone.GRAVEYARD\n245\t+        if destination is not None:\n246\t+            dest_zone = _DESTINATION_ZONE_MAP.get(destination, Zone.GRAVEYARD)\n247\t+        move_to_zone(game, card, Zone.STACK, dest_zone)\n248\t \n249\t \n250\t # ------------------------------------------------------------------\n251\t"}]},"parent_tool_use_id":"toolu_01V4UV3nu5k25iEqvDPF1Kdu","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"262f3bba-6df3-447e-9d07-83b10e554405","timestamp":"2026-06-02T07:43:56.538Z","subagent_type":"Reviewer","task_description":"Review sos_1 implementation"}
