{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013cQUyBqV6GdFSmADf1DjFt","type":"tool_result","content":"1\t\"\"\"Mana pool and cost payment logic.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom dataclasses import dataclass\n6\tfrom typing import Any\n7\t\n8\tfrom engine.types import CardType, Color, HybridManaSymbol, ManaCost, ManaType\n9\t\n10\t# Map colored ManaTypes to their corresponding Color enum values.\n11\t_MANA_TO_COLOR: dict[ManaType, Color] = {\n12\t    ManaType.WHITE: Color.WHITE,\n13\t    ManaType.BLUE: Color.BLUE,\n14\t    ManaType.BLACK: Color.BLACK,\n15\t    ManaType.RED: Color.RED,\n16\t    ManaType.GREEN: Color.GREEN,\n17\t}\n18\t\n19\t\n20\t#: Restriction tag meaning \"spend this mana only to cast an instant or sorcery\n21\t#: spell\" (Great Hall of the Biblioplex's any-color mana).\n22\tRESTRICT_INSTANT_SORCERY = \"instant_or_sorcery\"\n23\t\n24\t\n25\t@dataclass\n26\tclass ManaRestriction:\n27\t    \"\"\"An outstanding chunk of restricted mana in a :class:`ManaPool`.\n28\t\n29\t    Attributes:\n30\t        mana_type: The kind of mana produced (e.g. the chosen color).\n31\t        amount: How many mana of this chunk remain unspent.\n32\t        restriction: A tag describing what the mana may be spent on.  The\n33\t            only built-in tag is :data:`RESTRICT_INSTANT_SORCERY` (\"spend\n34\t            this mana only to cast an instant or sorcery spell\").  An\n35\t            unrecognised tag is treated conservatively (no spell qualifies),\n36\t            so a future restriction never silently behaves as unrestricted.\n37\t        source: Optional back-reference to the permanent/ability that\n38\t            produced the restricted mana (advisory only).\n39\t    \"\"\"\n40\t\n41\t    mana_type: ManaType\n42\t    amount: int\n43\t    restriction: str\n44\t    source: Any = None\n45\t\n46\t    def allows_spell(self, spell: Any) -> bool:\n47\t        \"\"\"Return ``True`` if this restricted mana may pay for *spell*.\n48\t\n49\t        Only the instant/sorcery restriction is understood; any other tag\n50\t        is treated as \"no spell qualifies\" so the restriction is never\n51\t        accidentally bypassed.\n52\t        \"\"\"\n53\t        if self.restriction == RESTRICT_INSTANT_SORCERY:\n54\t            card_types = getattr(spell, \"card_types\", set())\n55\t            return CardType.INSTANT in card_types or CardType.SORCERY in card_types\n56\t        return False\n57\t\n58\t\n59\tclass ManaPool:\n60\t    \"\"\"Tracks available mana for a player.\n61\t\n62\t    Internal storage uses a ``dict[ManaType, int]`` mapping each mana type\n63\t    to its current count.\n64\t\n65\t    Restricted mana\n66\t    ---------------\n67\t    Some effects produce mana that may only be spent in a limited way\n68\t    (e.g. Great Hall of the Biblioplex: \"Spend this mana only to cast an\n69\t    instant or sorcery spell\").  The base pool has no notion of a spend\n70\t    restriction; to support such mana *additively* (without changing the\n71\t    flat ``dict[ManaType, int]`` model or any existing payment behaviour),\n72\t    the pool carries a small parallel record:\n73\t\n74\t    * :attr:`restrictions` — a list of :class:`ManaRestriction` records, one\n75\t      per outstanding chunk of restricted mana that has not yet been spent.\n76\t\n77\t    Unrestricted mana is never recorded here, so when no effect produces\n78\t    restricted mana the list stays empty and every existing operation\n79\t    (:meth:`add`, :meth:`pay`, :meth:`can_pay`, :meth:`empty`, ...) behaves\n80\t    byte-for-byte as before.  The restriction record is purely advisory at\n81\t    the pool level — enforcement lives in :func:`engine.casting.cast_spell`,\n82\t    which consults :meth:`restricted_amount` / :meth:`spendable_for_spell`\n83\t    so restricted mana can pay a permitted spell but is rejected for a\n84\t    disallowed one.\n85\t    \"\"\"\n86\t\n87\t    def __init__(self) -> None:\n88\t        self._pool: dict[ManaType, int] = {mt: 0 for mt in ManaType}\n89\t        self._last_payment_colors: list[Color] = []\n90\t        # Parallel record of outstanding restricted-mana chunks.  Empty for\n91\t        # ordinary mana, so all existing behaviour is unchanged by default.\n92\t        self.restrictions: list[ManaRestriction] = []\n93\t\n94\t    # ------------------------------------------------------------------\n95\t    # Basic operations\n96\t    # ------------------------------------------------------------------\n97\t\n98\t    def add(self, mana_type: ManaType, amount: int = 1) -> None:\n99\t        \"\"\"Add *amount* mana of the given type to the pool.\n100\t\n101\t        Parameters:\n102\t            mana_type: The type of mana to add.\n103\t            amount: How many mana to add (must be non-negative).\n104\t        \"\"\"\n105\t        if amount < 0:\n106\t            raise ValueError(f\"Cannot add negative mana: {amount}\")\n107\t        self._pool[mana_type] = self._pool.get(mana_type, 0) + amount\n108\t\n109\t    def add_restricted(\n110\t        self,\n111\t        mana_type: ManaType,\n112\t        amount: int = 1,\n113\t        restriction: str = RESTRICT_INSTANT_SORCERY,\n114\t        source: Any = None,\n115\t    ) -> None:\n116\t        \"\"\"Add *amount* mana of *mana_type* tagged with a spend *restriction*.\n117\t\n118\t        The mana lands in the flat pool exactly like ordinary mana (so it is\n119\t        countable via :meth:`get` / :meth:`total` and payable by the unchanged\n120\t        :meth:`pay`), and a parallel :class:`ManaRestriction` record is kept in\n121\t        :attr:`restrictions` so the casting pipeline can tell that this much of\n122\t        the pool may only be spent on a permitted spell.\n123\t\n124\t        Use this instead of :meth:`add` when an effect produces mana with a\n125\t        spend restriction (e.g. \"Spend this mana only to cast an instant or\n126\t        sorcery spell\").  Producing ordinary mana via :meth:`add` records no\n127\t        restriction, leaving existing behaviour unchanged.\n128\t        \"\"\"\n129\t        self.add(mana_type, amount)\n130\t        if amount > 0:\n131\t            self.restrictions.append(\n132\t                ManaRestriction(\n133\t                    mana_type=mana_type,\n134\t                    amount=amount,\n135\t                    restriction=restriction,\n136\t                    source=source,\n137\t                )\n138\t            )\n139\t\n140\t    def empty(self) -> None:\n141\t        \"\"\"Clear the pool — happens at phase/step transitions.\"\"\"\n142\t        for mt in self._pool:\n143\t            self._pool[mt] = 0\n144\t        # Restricted mana empties with the rest of the pool.\n145\t        self.restrictions = []\n146\t\n147\t    def total(self) -> int:\n148\t        \"\"\"Return the total amount of mana in the pool across all types.\"\"\"\n149\t        return sum(self._pool.values())\n150\t\n151\t    def get(self, mana_type: ManaType) -> int:\n152\t        \"\"\"Return the amount of a specific mana type in the pool.\"\"\"\n153\t        return self._pool.get(mana_type, 0)\n154\t\n155\t    @property\n156\t    def last_payment_colors(self) -> list[Color]:\n157\t        \"\"\"Return the distinct colors of mana spent in the last :meth:`pay` call.\n158\t\n159\t        Colorless mana is not a color and is excluded.  The list is sorted\n160\t        by Color enum order for determinism.  Empty if no payment has been\n161\t        made or if all mana spent was colorless.\n162\t        \"\"\"\n163\t        return list(self._last_payment_colors)\n164\t\n165\t    # ------------------------------------------------------------------\n166\t    # Restricted-mana queries / bookkeeping\n167\t    # ------------------------------------------------------------------\n168\t\n169\t    def has_restricted_mana(self) -> bool:\n170\t        \"\"\"Return ``True`` if the pool holds any outstanding restricted mana.\"\"\"\n171\t        return any(r.amount > 0 for r in self.restrictions)\n172\t\n173\t    def restricted_amount(self) -> int:\n174\t        \"\"\"Return the total amount of currently-restricted mana in the pool.\"\"\"\n175\t        return sum(r.amount for r in self.restrictions if r.amount > 0)\n176\t\n177\t    def spendable_for_spell(self, spell: Any) -> int:\n178\t        \"\"\"Return how much of the pool may legally help pay for *spell*.\n179\t\n180\t        Restricted mana that does not permit *spell* is excluded; all\n181\t        unrestricted mana (the pool total minus the restricted portion) plus\n182\t        any restricted mana whose restriction permits *spell* is included.\n183\t        With no restricted mana present this is simply :meth:`total`.\n184\t        \"\"\"\n185\t        forbidden = sum(\n186\t            r.amount\n187\t            for r in self.restrictions\n188\t            if r.amount > 0 and not r.allows_spell(spell)\n189\t        )\n190\t        return self.total() - forbidden\n191\t\n192\t    def can_pay_for_spell(self, cost: ManaCost, spell: Any) -> bool:\n193\t        \"\"\"Like :meth:`can_pay`, but honouring restricted-mana spend rules.\n194\t\n195\t        Returns ``True`` only if the cost can be paid *and* no restricted mana\n196\t        that disallows *spell* is forced into the payment.  When the pool holds\n197\t        no restricted mana this delegates straight to :meth:`can_pay`, so\n198\t        ordinary casts are entirely unaffected.\n199\t        \"\"\"\n200\t        if not self.has_restricted_mana():\n201\t            return self.can_pay(cost)\n202\t        if not self.can_pay(cost):\n203\t            return False\n204\t        # The spell's total cost cannot exceed the mana that may legally pay it.\n205\t        needed = cost.generic + sum(cost.pips.values()) + len(cost.hybrid)\n206\t        return self.spendable_for_spell(spell) >= needed\n207\t\n208\t    def _consume_restrictions_for_payment(self, paid: dict[ManaType, int]) -> None:\n209\t        \"\"\"Decrement restriction records to mirror a committed *paid* deduction.\n210\t\n211\t        *paid* maps each :class:`ManaType` to how many of it the payment spent.\n212\t        Restricted records of the matching type are drawn down first so the\n213\t        outstanding restricted amount never overstates what remains in the pool.\n214\t        Records that reach zero are dropped.\n215\t        \"\"\"\n216\t        for mana_type, spent in paid.items():\n217\t            remaining = spent\n218\t            for record in self.restrictions:\n219\t                if remaining <= 0:\n220\t                    break\n221\t                if record.mana_type is not mana_type or record.amount <= 0:\n222\t                    continue\n223\t                take = min(record.amount, remaining)\n224\t                record.amount -= take\n225\t                remaining -= take\n226\t        self.restrictions = [r for r in self.restrictions if r.amount > 0]\n227\t\n228\t    # ------------------------------------------------------------------\n229\t    # Cost payment\n230\t    # ------------------------------------------------------------------\n231\t\n232\t    def can_pay(self, cost: ManaCost) -> bool:\n233\t        \"\"\"Check whether the pool can satisfy *cost*.\n234\t\n235\t        Generic mana can be paid by any type.  X is treated as 0 for\n236\t        ``can_pay`` unless explicitly set in the cost's generic component.\n237\t        Hybrid symbols can be paid with either option; this method uses\n238\t        backtracking to find a valid assignment.\n239\t\n240\t        Returns:\n241\t            True if the pool has enough mana to pay the cost.\n242\t        \"\"\"\n243\t        remaining: dict[ManaType, int] = dict(self._pool)\n244\t\n245\t        # Pay colored/colorless pips first.\n246\t        for mana_type, count in cost.pips.items():\n247\t            if remaining.get(mana_type, 0) < count:\n248\t                return False\n249\t            remaining[mana_type] = remaining.get(mana_type, 0) - count\n250\t\n251\t        # Solve hybrid symbols with backtracking.\n252\t        if cost.hybrid:\n253\t            if not self._can_pay_hybrid(remaining, list(cost.hybrid), 0, cost.generic):\n254\t                return False\n255\t            return True\n256\t\n257\t        # Then check generic — sum of all remaining mana must cover it.\n258\t        return sum(remaining.values()) >= cost.generic\n259\t\n260\t    def pay(self, cost: ManaCost, choices: dict[ManaType, int] | None = None) -> bool:\n261\t        \"\"\"Deduct mana from the pool to pay *cost*.\n262\t\n263\t        Parameters:\n264\t            cost: The mana cost to pay.\n265\t            choices: How to split the generic portion across mana types.\n266\t                If ``None``, auto-pay greedily: pay colored pips first,\n267\t                then hybrid symbols, then generic using colorless first,\n268\t                then excess colored.\n269\t\n270\t        Returns:\n271\t            True if payment succeeded, False if the pool has insufficient mana.\n272\t        \"\"\"\n273\t        if not self.can_pay(cost):\n274\t            return False\n275\t\n276\t        # Work on a copy so we can roll back on failure.\n277\t        working: dict[ManaType, int] = dict(self._pool)\n278\t\n279\t        # 1. Pay colored/colorless pips.\n280\t        for mana_type, count in cost.pips.items():\n281\t            working[mana_type] -= count\n282\t\n283\t        # 2. When explicit generic choices are provided, reserve that mana\n284\t        #    *before* solving hybrids so the solver doesn't steal it.\n285\t        generic_remaining = cost.generic\n286\t        if generic_remaining > 0 and choices is not None:\n287\t            # Reject negative choice amounts — they would create mana.\n288\t            if any(v < 0 for v in choices.values()):\n289\t                return False\n290\t            # Validate choices sum to generic cost.\n291\t            if sum(choices.values()) != generic_remaining:\n292\t                return False\n293\t            for mana_type, amount in choices.items():\n294\t                if working.get(mana_type, 0) < amount:\n295\t                    return False\n296\t                working[mana_type] -= amount\n297\t\n298\t        # 3. Pay hybrid symbols using backtracking to find a valid assignment.\n299\t        #    Generic choices (if any) have already been reserved above,\n300\t        #    so _solve_hybrid sees only the genuinely available mana.\n301\t        if cost.hybrid:\n302\t            generic_for_solver = generic_remaining if choices is None else 0\n303\t            hybrid_assignment = self._solve_hybrid(\n304\t                working, list(cost.hybrid), 0, generic_for_solver,\n305\t            )\n306\t            if hybrid_assignment is None:\n307\t                return False  # pragma: no cover – should not happen after can_pay\n308\t            for mt in hybrid_assignment:\n309\t                working[mt] = working.get(mt, 0) - 1\n310\t\n311\t        # 4. Pay generic cost (auto-pay path — choices already deducted above).\n312\t        if generic_remaining > 0 and choices is None:\n313\t            generic_remaining = self._auto_pay_generic(working, generic_remaining)\n314\t            if generic_remaining > 0:\n315\t                return False  # pragma: no cover – should not happen after can_pay\n316\t\n317\t        # Commit the payment.\n318\t        # Compute colors of mana spent by comparing old pool to new working pool.\n319\t        colors_spent: set[Color] = set()\n320\t        spent_by_type: dict[ManaType, int] = {}\n321\t        for mt, old_amount in self._pool.items():\n322\t            new_amount = working.get(mt, 0)\n323\t            if new_amount < old_amount:\n324\t                spent_by_type[mt] = old_amount - new_amount\n325\t                if mt in _MANA_TO_COLOR:\n326\t                    colors_spent.add(_MANA_TO_COLOR[mt])\n327\t        self._last_payment_colors = sorted(colors_spent, key=lambda c: c.value)\n328\t        self._pool = working\n329\t        # Keep restriction bookkeeping in sync with the deduction.  Skipped\n330\t        # entirely when no restricted mana is outstanding, so ordinary payments\n331\t        # are byte-for-byte unchanged.\n332\t        if self.restrictions and spent_by_type:\n333\t            self._consume_restrictions_for_payment(spent_by_type)\n334\t        return True\n335\t\n336\t    @staticmethod\n337\t    def _can_pay_hybrid(\n338\t        remaining: dict[ManaType, int],\n339\t        hybrids: list[HybridManaSymbol],\n340\t        idx: int,\n341\t        generic: int,\n342\t    ) -> bool:\n343\t        \"\"\"Recursively check if hybrid symbols + generic can be satisfied.\n344\t\n345\t        Uses backtracking: for each hybrid symbol, try option_a then option_b.\n346\t        After all hybrids are assigned, check that remaining mana covers generic.\n347\t        \"\"\"\n348\t        if idx >= len(hybrids):\n349\t            return sum(remaining.values()) >= generic\n350\t\n351\t        sym = hybrids[idx]\n352\t        for option in (sym.option_a, sym.option_b):\n353\t            if remaining.get(option, 0) > 0:\n354\t                remaining[option] -= 1\n355\t                if ManaPool._can_pay_hybrid(remaining, hybrids, idx + 1, generic):\n356\t                    remaining[option] += 1\n357\t                    return True\n358\t                remaining[option] += 1\n359\t        return False\n360\t\n361\t    @staticmethod\n362\t    def _solve_hybrid(\n363\t        remaining: dict[ManaType, int],\n364\t        hybrids: list[HybridManaSymbol],\n365\t        idx: int,\n366\t        generic: int,\n367\t    ) -> list[ManaType] | None:\n368\t        \"\"\"Find a valid assignment for hybrid symbols.\n369\t\n370\t        Returns a list of ManaType choices (one per hybrid symbol) or None\n371\t        if no valid assignment exists.\n372\t        \"\"\"\n373\t        if idx >= len(hybrids):\n374\t            if sum(remaining.values()) >= generic:\n375\t                return []\n376\t            return None\n377\t\n378\t        sym = hybrids[idx]\n379\t        for option in (sym.option_a, sym.option_b):\n380\t            if remaining.get(option, 0) > 0:\n381\t                remaining[option] -= 1\n382\t                result = ManaPool._solve_hybrid(remaining, hybrids, idx + 1, generic)\n383\t                if result is not None:\n384\t                    remaining[option] += 1\n385\t                    return [option] + result\n386\t                remaining[option] += 1\n387\t        return None\n388\t\n389\t    @staticmethod\n390\t    def _auto_pay_generic(working: dict[ManaType, int], amount: int) -> int:\n391\t        \"\"\"Deduct *amount* generic mana from *working*, preferring colorless.\n392\t\n393\t        Returns the remaining unpaid generic amount (0 on success).\n394\t        \"\"\"\n395\t        # Pay with colorless first.\n396\t        if working.get(ManaType.COLORLESS, 0) > 0:\n397\t            take = min(working[ManaType.COLORLESS], amount)\n398\t            working[ManaType.COLORLESS] -= take\n399\t            amount -= take\n400\t\n401\t        # Then pay with each colored type in enum order.\n402\t        for mt in ManaType:\n403\t            if mt is ManaType.COLORLESS:\n404\t                continue\n405\t            if amount <= 0:\n406\t                break\n407\t            if working.get(mt, 0) > 0:\n408\t                take = min(working[mt], amount)\n409\t                working[mt] -= take\n410\t                amount -= take\n411\t\n412\t        return amount\n413\t\n414\t    # ------------------------------------------------------------------\n415\t    # Dunder helpers\n416\t    # ------------------------------------------------------------------\n417\t\n418\t    def __repr__(self) -> str:\n419\t        non_zero = {mt.name: v for mt, v in self._pool.items() if v > 0}\n420\t        return f\"ManaPool({non_zero})\"\n421\t"}]},"parent_tool_use_id":"toolu_01CbsKBgtu5hXmsenTvvH1UM","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"8061fb52-ad37-4410-900f-9d0b79b6d03d","timestamp":"2026-06-02T10:19:15.654Z","subagent_type":"Tester","task_description":"Extend sos_257 tests"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TQDKntgctoeBdHUj5tvgs8","type":"tool_result","content":"1\t\"\"\"Land-animation (\"becomes a creature\") framework.\n2\t\n3\tSeveral lands turn themselves into creatures while remaining lands — e.g.\n4\tGreat Hall of the Biblioplex:\n5\t\n6\t    {5}: If this land isn't a creature, it becomes a 2/4 Wizard creature with\n7\t    \"Whenever you cast an instant or sorcery spell, this creature gets +1/+0\n8\t    until end of turn.\"  It's still a land.\n9\t\n10\tThe engine's :mod:`engine.continuous_effects` layer system already models type\n11\tchanges (Layer 4) and P/T effects (Layer 7), but it had no helper to *animate*\n12\ta non-Creature :class:`~engine.card.CardImpl` into a creature that retains its\n13\tland type, exposes a base power/toughness, and gains a creature subtype.  This\n14\tmodule adds that helper *additively* — no existing engine symbol is renamed,\n15\tmoved, or deleted.  It mirrors the lazy per-game-registry + grant conventions of\n16\t:mod:`engine.miracle` / :mod:`engine.casualty` / :mod:`engine.affinity`.\n17\t\n18\tTwo observable mechanisms live here:\n19\t\n20\t1. **Animation** (:func:`animate_land`).  Layers ``CardType.CREATURE`` onto the\n21\t   land while keeping ``CardType.LAND``, grants a creature subtype, and sets a\n22\t   base body.  The body is observable via ``card.power`` / ``card.toughness``\n23\t   once the card reports those characteristics under the active animation (a\n24\t   :class:`~engine.card.Land` ordinarily has no power/toughness — the animating\n25\t   card is expected to expose ``power``/``toughness`` properties that read the\n26\t   animation state set here; see ``cards/sos/sos_257``).  The animation is\n27\t   durable (``DURATION_PERMANENT`` — it lasts until the land leaves play), and\n28\t   is *idempotent* per land via a lazy per-game registry, so \"if this land isn't\n29\t   a creature\" re-activation is a true no-op.\n30\t\n31\t2. **The granted pump trigger** (:func:`register_instant_sorcery_pump`).  The\n32\t   animation grants the land a triggered ability — \"Whenever you cast an instant\n33\t   or sorcery spell, this creature gets +1/+0 until end of turn\" — registered as\n34\t   a :class:`~engine.events.SpellCastTriggeredEvent` trigger controlled by the\n35\t   land's controller and gated to that controller's own instant/sorcery casts.\n36\t   Firing it adds a Layer 7c (``MODIFY_PT``) +1/+0 :class:`ContinuousEffect`\n37\t   with ``DURATION_END_OF_TURN`` to the land, so N casts in a turn yield +N/+0,\n38\t   swept back at cleanup by ``EffectManager.remove_expired``.  The trigger is\n39\t   deduped per source so animating once registers exactly one trigger.\n40\t\"\"\"\n41\t\n42\tfrom __future__ import annotations\n43\t\n44\tfrom typing import TYPE_CHECKING, Any\n45\t\n46\tfrom engine.continuous_effects import (\n47\t    DURATION_END_OF_TURN,\n48\t    DURATION_PERMANENT,\n49\t    ContinuousEffect,\n50\t    Layer,\n51\t    SubLayer,\n52\t)\n53\tfrom engine.events import SpellCastTriggeredEvent\n54\tfrom engine.triggers import TriggerRegistration\n55\tfrom engine.types import CardType\n56\t\n57\tif TYPE_CHECKING:\n58\t    from engine.game_state import GameState\n59\t\n60\t\n61\t# ---------------------------------------------------------------------------\n62\t# Per-game registry of animated permanents (idempotency / \"isn't a creature\")\n63\t# ---------------------------------------------------------------------------\n64\t\n65\t\n66\tdef _animation_registry(game: GameState) -> dict[int, dict[str, Any]]:\n67\t    \"\"\"Return (creating if necessary) the per-game land-animation registry.\n68\t\n69\t    Maps ``id(land)`` to a record describing the active animation.  Stored\n70\t    lazily on the game object so no ``GameState.__init__`` change is needed.\n71\t    \"\"\"\n72\t    registry = getattr(game, \"_land_animations\", None)\n73\t    if registry is None:\n74\t        registry = {}\n75\t        game._land_animations = registry  # type: ignore[attr-defined]\n76\t    return registry\n77\t\n78\t\n79\tdef is_animated(game: GameState, land: Any) -> bool:\n80\t    \"\"\"Return ``True`` if *land* is currently animated into a creature.\n81\t\n82\t    Checks both the per-game registry and the land's own card types, so a card\n83\t    that became a creature by any means reports correctly.\n84\t    \"\"\"\n85\t    if id(land) in _animation_registry(game):\n86\t        return True\n87\t    return CardType.CREATURE in getattr(land, \"card_types\", set())\n88\t\n89\t\n90\t# ---------------------------------------------------------------------------\n91\t# Animation — becomes a creature, still a land\n92\t# ---------------------------------------------------------------------------\n93\t\n94\t\n95\tdef animate_land(\n96\t    game: GameState,\n97\t    land: Any,\n98\t    base_power: int,\n99\t    base_toughness: int,\n100\t    subtype: str | None = None,\n101\t    controller: Any = None,\n102\t) -> bool:\n103\t    \"\"\"Animate *land* into a ``base_power``/``base_toughness`` creature.\n104\t\n105\t    Implements \"it becomes a [P]/[T] [subtype] creature ... It's still a land\":\n106\t\n107\t    * adds ``CardType.CREATURE`` to the land's card types while RETAINING\n108\t      ``CardType.LAND``;\n109\t    * grants *subtype* (e.g. ``\"Wizard\"``) to its subtypes;\n110\t    * records a base body the animating card can surface via ``power`` /\n111\t      ``toughness`` (this writes ``land._animated``, ``land._anim_base_power``,\n112\t      ``land._anim_base_toughness``, and seeds ``modified_power`` /\n113\t      ``modified_toughness``);\n114\t    * installs a durable (``DURATION_PERMANENT``) Layer-4 type effect and a\n115\t      Layer 7b ``SET_PT`` base-body effect through the engine layer system so\n116\t      the change survives ``EffectManager.apply_all``'s reset-and-reapply.\n117\t\n118\t    The change is applied *immediately* (so ``CardType.CREATURE`` is observable\n119\t    without first calling ``apply_all``) AND registered as a continuous effect\n120\t    (so it persists across recomputation).\n121\t\n122\t    Guarded by \"if this land isn't a creature\": if *land* is already animated\n123\t    (or already a creature), this is a no-op and returns ``False``.  Otherwise\n124\t    it animates and returns ``True``.\n125\t    \"\"\"\n126\t    if is_animated(game, land):\n127\t        return False\n128\t\n129\t    if controller is None:\n130\t        controller = getattr(land, \"controller\", None)\n131\t\n132\t    # --- Immediate mutation so the new characteristics are observable now. ---\n133\t    land.card_types = set(getattr(land, \"card_types\", set())) | {CardType.CREATURE}\n134\t    if subtype is not None:\n135\t        subtypes = getattr(land, \"subtypes\", None)\n136\t        if subtypes is None:\n137\t            subtypes = set()\n138\t            land.subtypes = subtypes\n139\t        subtypes.add(subtype)\n140\t\n141\t    land._animated = True  # type: ignore[attr-defined]\n142\t    land._anim_base_power = base_power  # type: ignore[attr-defined]\n143\t    land._anim_base_toughness = base_toughness  # type: ignore[attr-defined]\n144\t    land._anim_subtype = subtype  # type: ignore[attr-defined]\n145\t    land.modified_power = base_power  # type: ignore[attr-defined]\n146\t    land.modified_toughness = base_toughness  # type: ignore[attr-defined]\n147\t\n148\t    # --- Durable layer effects so the animation survives apply_all resets. ---\n149\t    def _apply_type(g: GameState) -> None:\n150\t        land.card_types = set(getattr(land, \"card_types\", set())) | {\n151\t            CardType.CREATURE\n152\t        }\n153\t        land.card_types.add(CardType.LAND)\n154\t        if subtype is not None:\n155\t            land.subtypes.add(subtype)\n156\t\n157\t    def _apply_base_body(g: GameState) -> None:\n158\t        land.modified_power = base_power  # type: ignore[attr-defined]\n159\t        land.modified_toughness = base_toughness  # type: ignore[attr-defined]\n160\t\n161\t    type_effect = ContinuousEffect(\n162\t        source=land,\n163\t        layer=Layer.TYPE,\n164\t        apply=_apply_type,\n165\t        duration=DURATION_PERMANENT,\n166\t    )\n167\t    body_effect = ContinuousEffect(\n168\t        source=land,\n169\t        layer=Layer.POWER_TOUGHNESS,\n170\t        sublayer=SubLayer.SET_PT,\n171\t        apply=_apply_base_body,\n172\t        duration=DURATION_PERMANENT,\n173\t    )\n174\t    game.effect_manager.add(type_effect)\n175\t    game.effect_manager.add(body_effect)\n176\t\n177\t    _animation_registry(game)[id(land)] = {\n178\t        \"controller\": controller,\n179\t        \"base_power\": base_power,\n180\t        \"base_toughness\": base_toughness,\n181\t        \"subtype\": subtype,\n182\t        \"type_effect\": type_effect,\n183\t        \"body_effect\": body_effect,\n184\t    }\n185\t    return True\n186\t\n187\t\n188\tdef deanimate_land(game: GameState, land: Any) -> None:\n189\t    \"\"\"Remove *land*'s animation (e.g. when it leaves the battlefield).\n190\t\n191\t    Drops the registry record and the durable layer effects, clears the\n192\t    animation flags, and removes the granted pump trigger.  This is the\n193\t    \"until it leaves play\" cleanup; it is safe to call when *land* is not\n194\t    animated (no-op).\n195\t    \"\"\"\n196\t    registry = _animation_registry(game)\n197\t    record = registry.pop(id(land), None)\n198\t    if record is None:\n199\t        return\n200\t    for key in (\"type_effect\", \"body_effect\"):\n201\t        effect = record.get(key)\n202\t        if effect is not None:\n203\t            game.effect_manager.remove(effect)\n204\t    game.trigger_manager.unregister(land)\n205\t    land._animated = False  # type: ignore[attr-defined]\n206\t    land.card_types = set(getattr(land, \"card_types\", set())) - {CardType.CREATURE}\n207\t    subtype = record.get(\"subtype\")\n208\t    if subtype is not None and subtype in getattr(land, \"subtypes\", set()):\n209\t        land.subtypes.discard(subtype)\n210\t\n211\t\n212\t# ---------------------------------------------------------------------------\n213\t# The granted pump trigger\n214\t# ---------------------------------------------------------------------------\n215\t\n216\t\n217\tdef add_pump_until_end_of_turn(\n218\t    game: GameState,\n219\t    land: Any,\n220\t    power_bonus: int = 1,\n221\t    toughness_bonus: int = 0,\n222\t) -> ContinuousEffect:\n223\t    \"\"\"Give *land* +``power_bonus``/+``toughness_bonus`` until end of turn.\n224\t\n225\t    Adds a Layer 7c (``MODIFY_PT``) :class:`ContinuousEffect` with\n226\t    ``DURATION_END_OF_TURN`` to the engine layer system.  After\n227\t    ``EffectManager.apply_all`` the bonus is visible via ``land.power`` /\n228\t    ``land.toughness``; firing this N times in a turn stacks to +N/+0, and\n229\t    ``EffectManager.remove_expired`` (run at cleanup) sweeps every such effect\n230\t    away so the body resets at end of turn.\n231\t    \"\"\"\n232\t\n233\t    def _apply(g: GameState) -> None:\n234\t        if getattr(land, \"modified_power\", None) is not None:\n235\t            land.modified_power += power_bonus  # type: ignore[attr-defined]\n236\t        if getattr(land, \"modified_toughness\", None) is not None:\n237\t            land.modified_toughness += toughness_bonus  # type: ignore[attr-defined]\n238\t\n239\t    effect = ContinuousEffect(\n240\t        source=land,\n241\t        layer=Layer.POWER_TOUGHNESS,\n242\t        sublayer=SubLayer.MODIFY_PT,\n243\t        apply=_apply,\n244\t        duration=DURATION_END_OF_TURN,\n245\t    )\n246\t    return game.effect_manager.add(effect)\n247\t\n248\t\n249\tdef _pump_trigger_registry(game: GameState) -> set[int]:\n250\t    \"\"\"Return (creating if necessary) the per-game pump-trigger dedup set.\"\"\"\n251\t    registry = getattr(game, \"_animation_pump_triggers\", None)\n252\t    if registry is None:\n253\t        registry = set()\n254\t        game._animation_pump_triggers = registry  # type: ignore[attr-defined]\n255\t    return registry\n256\t\n257\t\n258\tdef register_instant_sorcery_pump(\n259\t    game: GameState,\n260\t    land: Any,\n261\t    controller: Any,\n262\t    power_bonus: int = 1,\n263\t    toughness_bonus: int = 0,\n264\t) -> TriggerRegistration | None:\n265\t    \"\"\"Grant *land* \"whenever you cast an instant/sorcery, +1/+0 until EOT\".\n266\t\n267\t    Registers (deduped per source via a lazy per-game registry) a\n268\t    :class:`~engine.events.SpellCastTriggeredEvent` trigger controlled by\n269\t    *controller* and gated to *controller*'s own instant/sorcery casts.  When it\n270\t    fires, :func:`add_pump_until_end_of_turn` gives *land*\n271\t    +``power_bonus``/+``toughness_bonus`` until end of turn.\n272\t\n273\t    Returns the created :class:`~engine.triggers.TriggerRegistration`, or\n274\t    ``None`` if a pump trigger was already registered for this source (so a\n275\t    second animation does not stack a second grant).\n276\t    \"\"\"\n277\t    registry = _pump_trigger_registry(game)\n278\t    if id(land) in registry:\n279\t        return None\n280\t\n281\t    def _condition(g: GameState, event: SpellCastTriggeredEvent) -> bool:\n282\t        caster = getattr(event, \"player\", None) or getattr(event, \"controller\", None)\n283\t        if caster is not controller:\n284\t            return False\n285\t        spell = getattr(event, \"spell\", None) or getattr(event, \"card\", None)\n286\t        card_types = getattr(spell, \"card_types\", set())\n287\t        return CardType.INSTANT in card_types or CardType.SORCERY in card_types\n288\t\n289\t    def _effect(g: GameState) -> None:\n290\t        add_pump_until_end_of_turn(g, land, power_bonus, toughness_bonus)\n291\t\n292\t    trigger = TriggerRegistration(\n293\t        event_type=SpellCastTriggeredEvent,\n294\t        condition=_condition,\n295\t        effect=_effect,\n296\t        source=land,\n297\t        controller=controller,\n298\t    )\n299\t    game.trigger_manager.register(trigger)\n300\t    registry.add(id(land))\n301\t    return trigger\n302\t"}]},"parent_tool_use_id":"toolu_01CbsKBgtu5hXmsenTvvH1UM","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"dd3a45ad-7ff5-468d-9b99-ba5ef8887aa4","timestamp":"2026-06-02T10:19:15.655Z","subagent_type":"Tester","task_description":"Extend sos_257 tests"}
