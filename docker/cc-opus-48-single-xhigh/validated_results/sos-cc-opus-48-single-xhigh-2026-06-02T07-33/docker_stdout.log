{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014rTH5kxyJZkN9SnAouaZay","type":"tool_result","content":"1\t\"\"\"Tests for SOS 13 — Emeritus of Truce // Swords to Plowshares.\n2\t\n3\tOracle text (from card_spec.json), front (creature) face:\n4\t\n5\t    When this creature enters, target player creates a 1/1 white and black\n6\t    Inkling creature token with flying. Then if an opponent controls more\n7\t    creatures than you, this creature becomes prepared. (While it's prepared,\n8\t    you may cast a copy of its spell. Doing so unprepares it.)\n9\t\n10\tStatic data:\n11\t\n12\t    Emeritus of Truce // Swords to Plowshares\n13\t    {1}{W}{W} // {W}\n14\t    Creature — Cat Cleric // Instant\n15\t    3/3, white, mythic, keyword \"Prepared\".\n16\t\n17\tBehaviour contract derived from the spec\n18\t----------------------------------------\n19\t\n20\t* Front face is a white Creature — Cat Cleric, 3/3, mana cost {1}{W}{W}.\n21\t* Enters-the-battlefield trigger: a target player (chosen by the\n22\t  controller — may be the controller themselves or an opponent) creates a\n23\t  1/1 white-and-black Inkling creature token with flying.  The token enters\n24\t  under the *targeted* player's control.\n25\t* Conditional \"becomes prepared\": after the token is created, the creature\n26\t  becomes prepared **only if** an opponent controls strictly more creatures\n27\t  than the controller.  Otherwise it does not become prepared.\n28\t* The card is a Preparation card (rule 722): it has a back/prepare \"spell\"\n29\t  half — Swords to Plowshares, an Instant costing {W}.\n30\t\n31\tThese tests are written for the TDD red phase: they FAIL against the empty\n32\tstub and PASS once the card is implemented correctly.\n33\t\"\"\"\n34\t\n35\tfrom __future__ import annotations\n36\t\n37\tfrom typing import Any\n38\t\n39\timport pytest\n40\t\n41\tfrom cards.sos.sos_13.card_impl import EmeritusOfTruceSwordsToPlowshares\n42\tfrom engine.card import Creature\n43\tfrom engine.events import EntersBattlefieldTriggeredEvent\n44\tfrom engine.protection import get_colors\n45\tfrom engine.triggers import TriggerRegistration\n46\tfrom engine.types import CardType, Color, Keyword, ManaCost, Zone\n47\tfrom test_utils import create_game, set_board_state\n48\t\n49\t\n50\t# ---------------------------------------------------------------------------\n51\t# Helpers\n52\t# ---------------------------------------------------------------------------\n53\t\n54\t\n55\tdef _vanilla_creature(name: str = \"Grizzly Bears\") -> Creature:\n56\t    \"\"\"A plain 2/2 creature for filling out board states.\"\"\"\n57\t    return Creature(\n58\t        name=name,\n59\t        mana_cost=ManaCost.parse(\"{1}{G}\"),\n60\t        base_power=2,\n61\t        base_toughness=2,\n62\t    )\n63\t\n64\t\n65\tdef _resolve_full_stack(game: Any) -> None:\n66\t    \"\"\"Resolve every object currently on the stack, top-down.\n67\t\n68\t    Mirrors ``test_utils._resolve_top_of_stack`` but local so it can be reused\n69\t    after manually firing the ETB trigger (whose resolution applies the token\n70\t    / prepared effect).\n71\t    \"\"\"\n72\t    from engine.state_based_actions import resolve_state_based_actions\n73\t\n74\t    while not game.stack.is_empty():\n75\t        obj = game.stack.pop()\n76\t        obj.on_resolve(game)\n77\t        resolve_state_based_actions(game)\n78\t\n79\t\n80\tdef _inkling_tokens(game: Any, player: Any) -> list[Creature]:\n81\t    \"\"\"Return all Inkling-like token creatures on *player*'s battlefield.\n82\t\n83\t    Detection is intentionally tolerant of the exact representation: any\n84\t    battlefield creature flagged ``is_token`` whose name or subtypes mention\n85\t    \"Inkling\" counts.\n86\t    \"\"\"\n87\t    result: list[Creature] = []\n88\t    for obj in game.get_battlefield(player).get_all():\n89\t        if not isinstance(obj, Creature):\n90\t            continue\n91\t        if not getattr(obj, \"is_token\", False):\n92\t            continue\n93\t        name = getattr(obj, \"name\", \"\") or \"\"\n94\t        subtypes = getattr(obj, \"subtypes\", set()) or set()\n95\t        if \"Inkling\" in name or \"Inkling\" in subtypes:\n96\t            result.append(obj)\n97\t    return result\n98\t\n99\t\n100\tdef _all_tokens(game: Any, player: Any) -> list[Creature]:\n101\t    \"\"\"Return every token creature on *player*'s battlefield.\"\"\"\n102\t    return [\n103\t        obj\n104\t        for obj in game.get_battlefield(player).get_all()\n105\t        if isinstance(obj, Creature) and getattr(obj, \"is_token\", False)\n106\t    ]\n107\t\n108\t\n109\tdef _is_prepared(card: Any) -> bool:\n110\t    \"\"\"Best-effort read of the 'prepared' designation on *card*.\n111\t\n112\t    The mechanic is new; the implementation may expose it as ``is_prepared``,\n113\t    ``prepared``, or a ``Keyword.PREPARED``-style flag.  We probe the common\n114\t    representations so the behavioural tests aren't coupled to one spelling.\n115\t    \"\"\"\n116\t    for attr in (\"is_prepared\", \"prepared\"):\n117\t        val = getattr(card, attr, None)\n118\t        if isinstance(val, bool):\n119\t            return val\n120\t    return False\n121\t\n122\t\n123\tdef _make_etb_card(game: Any, controller_index: int) -> EmeritusOfTruceSwordsToPlowshares:\n124\t    \"\"\"Place the creature on *controller_index*'s battlefield and wire triggers.\n125\t\n126\t    Returns the card with ``register_triggers`` already called.  The ETB event\n127\t    is *not* fired here — tests fire it explicitly so they can control the\n128\t    target choice first (the engine fires ETB before registration, so the\n129\t    self-ETB trigger is exercised by an explicit ``fire_event``).\n130\t    \"\"\"\n131\t    p = game.players[controller_index]\n132\t    card = EmeritusOfTruceSwordsToPlowshares(owner=p, controller=p)\n133\t    set_board_state(game, controller_index, battlefield=[card])\n134\t    game.active_player_index = controller_index\n135\t    card.register_triggers(game)\n136\t    return card\n137\t\n138\t\n139\tdef _fire_etb(game: Any, card: Any, target_player: Any) -> None:\n140\t    \"\"\"Fire the creature's ETB event after pointing it at *target_player*.\n141\t\n142\t    Sets ``chosen_targets`` (the resolve-time idiom used by FDN ETB cards) and\n143\t    also seeds the controller's script with the target so an implementation\n144\t    that asks at resolution time is satisfied either way.\n145\t    \"\"\"\n146\t    card.chosen_targets = [target_player]\n147\t    controller = card.controller\n148\t    if controller is not None and hasattr(controller, \"_script\"):\n149\t        controller._script.extend([target_player, target_player])\n150\t    game.trigger_manager.fire_event(\n151\t        game, EntersBattlefieldTriggeredEvent(permanent=card, controller=controller)\n152\t    )\n153\t    _resolve_full_stack(game)\n154\t\n155\t\n156\t# ---------------------------------------------------------------------------\n157\t# Static card data — front (creature) face\n158\t# ---------------------------------------------------------------------------\n159\t\n160\t\n161\tclass TestEmeritusProperties:\n162\t    \"\"\"Front-face characteristics must match the SOS 13 spec.\"\"\"\n163\t\n164\t    def test_is_creature(self) -> None:\n165\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n166\t        assert isinstance(card, Creature)\n167\t        assert CardType.CREATURE in card.card_types\n168\t\n169\t    def test_name_includes_emeritus_of_truce(self) -> None:\n170\t        # The front-face name; the implementation may expose either the\n171\t        # creature-half name or the combined split name.\n172\t        name = EmeritusOfTruceSwordsToPlowshares(owner=None).name\n173\t        assert \"Emeritus of Truce\" in name\n174\t\n175\t    def test_front_face_mana_cost(self) -> None:\n176\t        # The castable (creature) half costs {1}{W}{W}.\n177\t        cost = EmeritusOfTruceSwordsToPlowshares(owner=None).mana_cost\n178\t        assert cost == ManaCost.parse(\"{1}{W}{W}\")\n179\t\n180\t    def test_power_toughness(self) -> None:\n181\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n182\t        assert card.base_power == 3\n183\t        assert card.base_toughness == 3\n184\t\n185\t    def test_is_white(self) -> None:\n186\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n187\t        assert get_colors(card) == {Color.WHITE}\n188\t\n189\t    def test_subtypes_cat_cleric(self) -> None:\n190\t        subtypes = EmeritusOfTruceSwordsToPlowshares(owner=None).subtypes\n191\t        assert \"Cat\" in subtypes\n192\t        assert \"Cleric\" in subtypes\n193\t\n194\t\n195\t# ---------------------------------------------------------------------------\n196\t# ETB trigger registration\n197\t# ---------------------------------------------------------------------------\n198\t\n199\t\n200\tclass TestEmeritusEtbTriggerRegistration:\n201\t    \"\"\"register_triggers wires a self-referencing ETB trigger.\"\"\"\n202\t\n203\t    def test_registers_one_trigger(self) -> None:\n204\t        game = create_game()\n205\t        p1 = game.players[0]\n206\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n207\t        before = len(game.trigger_manager.get_triggers())\n208\t        card.register_triggers(game)\n209\t        after = len(game.trigger_manager.get_triggers())\n210\t        assert after - before == 1\n211\t\n212\t    def test_trigger_watches_enters_battlefield_event(self) -> None:\n213\t        game = create_game()\n214\t        p1 = game.players[0]\n215\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n216\t        card.register_triggers(game)\n217\t        regs = game.trigger_manager.get_triggers_for_source(card)\n218\t        assert len(regs) == 1\n219\t        reg = regs[0]\n220\t        assert isinstance(reg, TriggerRegistration)\n221\t        assert reg.event_type is EntersBattlefieldTriggeredEvent\n222\t\n223\t    def test_trigger_only_fires_for_this_card(self) -> None:\n224\t        \"\"\"A different permanent entering must not fire this card's ETB.\"\"\"\n225\t        game = create_game()\n226\t        p1 = game.players[0]\n227\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n228\t        set_board_state(game, 0, battlefield=[card])\n229\t        game.active_player_index = 0\n230\t        card.register_triggers(game)\n231\t\n232\t        other = _vanilla_creature(\"Some Other Bear\")\n233\t        other.owner = p1\n234\t        other.controller = p1\n235\t        game.trigger_manager.fire_event(\n236\t            game, EntersBattlefieldTriggeredEvent(permanent=other, controller=p1)\n237\t        )\n238\t        assert game.stack.is_empty()\n239\t\n240\t    def test_trigger_fires_when_this_card_enters(self) -> None:\n241\t        game = create_game()\n242\t        p1 = game.players[0]\n243\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n244\t        set_board_state(game, 0, battlefield=[card])\n245\t        game.active_player_index = 0\n246\t        card.register_triggers(game)\n247\t\n248\t        game.trigger_manager.fire_event(\n249\t            game, EntersBattlefieldTriggeredEvent(permanent=card, controller=p1)\n250\t        )\n251\t        assert not game.stack.is_empty()\n252\t        assert game.stack.peek().source is card\n253\t\n254\t\n255\t# ---------------------------------------------------------------------------\n256\t# ETB token creation\n257\t# ---------------------------------------------------------------------------\n258\t\n259\t\n260\tclass TestEmeritusTokenCreation:\n261\t    \"\"\"target player creates a 1/1 white & black Inkling token with flying.\"\"\"\n262\t\n263\t    def test_controller_target_gets_one_inkling(self) -> None:\n264\t        game = create_game()\n265\t        card = _make_etb_card(game, 0)\n266\t        p1 = game.players[0]\n267\t        before = len(_all_tokens(game, p1))\n268\t        _fire_etb(game, card, p1)\n269\t        inklings = _inkling_tokens(game, p1)\n270\t        assert len(inklings) == 1\n271\t        # Exactly one token was created for the chosen player.\n272\t        assert len(_all_tokens(game, p1)) == before + 1\n273\t\n274\t    def test_token_is_one_one(self) -> None:\n275\t        game = create_game()\n276\t        card = _make_etb_card(game, 0)\n277\t        p1 = game.players[0]\n278\t        _fire_etb(game, card, p1)\n279\t        token = _inkling_tokens(game, p1)[0]\n280\t        assert token.base_power == 1\n281\t        assert token.base_toughness == 1\n282\t\n283\t    def test_token_has_flying(self) -> None:\n284\t        game = create_game()\n285\t        card = _make_etb_card(game, 0)\n286\t        p1 = game.players[0]\n287\t        _fire_etb(game, card, p1)\n288\t        token = _inkling_tokens(game, p1)[0]\n289\t        assert Keyword.FLYING & token.keywords\n290\t\n291\t    def test_token_is_white_and_black(self) -> None:\n292\t        game = create_game()\n293\t        card = _make_etb_card(game, 0)\n294\t        p1 = game.players[0]\n295\t        _fire_etb(game, card, p1)\n296\t        token = _inkling_tokens(game, p1)[0]\n297\t        assert get_colors(token) == {Color.WHITE, Color.BLACK}\n298\t\n299\t    def test_targeting_opponent_creates_token_under_opponent(self) -> None:\n300\t        \"\"\"\"target player\" may be an opponent; the token enters under that\n301\t        targeted player's control, not the controller's.\"\"\"\n302\t        game = create_game()\n303\t        card = _make_etb_card(game, 0)\n304\t        p1 = game.players[0]\n305\t        p2 = game.players[1]\n306\t        _fire_etb(game, card, p2)\n307\t        # The opponent receives the Inkling.\n308\t        assert len(_inkling_tokens(game, p2)) == 1\n309\t        # The controller does not get a token in this case.\n310\t        assert len(_inkling_tokens(game, p1)) == 0\n311\t        token = _inkling_tokens(game, p2)[0]\n312\t        assert token.controller is p2\n313\t\n314\t    def test_token_is_a_creature_token(self) -> None:\n315\t        game = create_game()\n316\t        card = _make_etb_card(game, 0)\n317\t        p1 = game.players[0]\n318\t        _fire_etb(game, card, p1)\n319\t        token = _inkling_tokens(game, p1)[0]\n320\t        assert CardType.CREATURE in token.card_types\n321\t        assert token.is_token is True\n322\t\n323\t\n324\t# ---------------------------------------------------------------------------\n325\t# Conditional \"becomes prepared\"\n326\t# ---------------------------------------------------------------------------\n327\t\n328\t\n329\tclass TestEmeritusBecomesPrepared:\n330\t    \"\"\"\"Then if an opponent controls more creatures than you, this creature\n331\t    becomes prepared.\"\n332\t\n333\t    Each board state below is chosen so the prepared outcome is the same\n334\t    whether the implementation evaluates the creature counts *before* or\n335\t    *after* the Inkling token is created — by directing the token to the\n336\t    player whose count is irrelevant to crossing the threshold.\n337\t    \"\"\"\n338\t\n339\t    @staticmethod\n340\t    def _rewire(game: Any, card: Any) -> None:\n341\t        \"\"\"Re-register the self-ETB trigger after set_board_state wipes it.\"\"\"\n342\t        game.trigger_manager.unregister(card)\n343\t        card.register_triggers(game)\n344\t\n345\t    def test_becomes_prepared_when_opponent_has_more_creatures(self) -> None:\n346\t        game = create_game()\n347\t        card = _make_etb_card(game, 0)\n348\t        p1 = game.players[0]\n349\t        p2 = game.players[1]\n350\t        # Controller controls only Emeritus (1); opponent controls 3.\n351\t        set_board_state(game, 0, battlefield=[card])\n352\t        set_board_state(\n353\t            game,\n354\t            1,\n355\t            battlefield=[\n356\t                _vanilla_creature(\"Foe A\"),\n357\t                _vanilla_creature(\"Foe B\"),\n358\t                _vanilla_creature(\"Foe C\"),\n359\t            ],\n360\t        )\n361\t        self._rewire(game, card)\n362\t        # Send the token to the opponent so the controller's count stays 1.\n363\t        # opponent 3-or-4 > you 1 either way -> prepared.\n364\t        _fire_etb(game, card, p2)\n365\t        assert len(_inkling_tokens(game, p2)) == 1\n366\t        assert _is_prepared(card) is True\n367\t\n368\t    def test_not_prepared_when_counts_equal(self) -> None:\n369\t        \"\"\"Opponent must control *strictly more* creatures — an equal count\n370\t        does not prepare the creature.\"\"\"\n371\t        game = create_game()\n372\t        card = _make_etb_card(game, 0)\n373\t        p1 = game.players[0]\n374\t        # Controller has Emeritus + one ally (2); opponent has two foes (2).\n375\t        set_board_state(game, 0, battlefield=[card, _vanilla_creature(\"Ally\")])\n376\t        set_board_state(\n377\t            game,\n378\t            1,\n379\t            battlefield=[_vanilla_creature(\"Foe A\"), _vanilla_creature(\"Foe B\")],\n380\t        )\n381\t        self._rewire(game, card)\n382\t        # Token goes to the controller -> you 3, opponent 2 (and pre-token the\n383\t        # counts were equal 2==2). Opponent never has strictly more -> no prep.\n384\t        _fire_etb(game, card, p1)\n385\t        # Anchor to real ETB execution: the token must have been created, so a\n386\t        # passing assertion means the not-prepared branch was actually reached\n387\t        # (not that the mechanic is simply unimplemented).\n388\t        assert len(_inkling_tokens(game, p1)) == 1\n389\t        assert _is_prepared(card) is False\n390\t\n391\t    def test_not_prepared_when_controller_has_more_creatures(self) -> None:\n392\t        game = create_game()\n393\t        card = _make_etb_card(game, 0)\n394\t        p1 = game.players[0]\n395\t        p2 = game.players[1]\n396\t        # Controller has Emeritus + two allies (3); opponent has nothing.\n397\t        set_board_state(\n398\t            game,\n399\t            0,\n400\t            battlefield=[card, _vanilla_creature(\"Ally A\"), _vanilla_creature(\"Ally B\")],\n401\t        )\n402\t        set_board_state(game, 1, battlefield=[])\n403\t        self._rewire(game, card)\n404\t        # Token goes to the opponent -> opponent at most 1 vs your 3 -> no prep.\n405\t        _fire_etb(game, card, p2)\n406\t        assert len(_inkling_tokens(game, p2)) == 1\n407\t        assert _is_prepared(card) is False\n408\t\n409\t    def test_not_prepared_when_opponent_has_no_creatures(self) -> None:\n410\t        game = create_game()\n411\t        card = _make_etb_card(game, 0)\n412\t        p1 = game.players[0]\n413\t        # Opponent controls nothing; controller controls Emeritus. Token to you.\n414\t        _fire_etb(game, card, p1)\n415\t        assert len(_inkling_tokens(game, p1)) == 1\n416\t        assert _is_prepared(card) is False\n417\t\n418\t\n419\t# ---------------------------------------------------------------------------\n420\t# Preparation-card / back (\"Swords to Plowshares\") half\n421\t# ---------------------------------------------------------------------------\n422\t\n423\t\n424\tclass TestSwordsToPlowsharesHalf:\n425\t    \"\"\"The card is a Preparation card with a back/prepare spell half.\"\"\"\n426\t\n427\t    def test_prepare_spell_mana_cost_is_w(self) -> None:\n428\t        \"\"\"The prepare (\"Swords to Plowshares\") half costs {W}.\n429\t\n430\t        The implementation exposes the prepare spell's cost somewhere — try\n431\t        the common shapes (a dedicated attribute or a copy/factory) before\n432\t        giving up.\n433\t        \"\"\"\n434\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n435\t        expected = ManaCost.parse(\"{W}\")\n436\t        candidates: list[Any] = []\n437\t        for attr in (\n438\t            \"prepare_mana_cost\",\n439\t            \"back_mana_cost\",\n440\t            \"swords_mana_cost\",\n441\t        ):\n442\t            val = getattr(card, attr, None)\n443\t            if isinstance(val, ManaCost):\n444\t                candidates.append(val)\n445\t        for attr in (\"prepare_spell\", \"back_face\", \"back_spell\", \"swords_to_plowshares\"):\n446\t            half = getattr(card, attr, None)\n447\t            if half is not None:\n448\t                cost = getattr(half, \"mana_cost\", None)\n449\t                if isinstance(cost, ManaCost):\n450\t                    candidates.append(cost)\n451\t            if callable(half):\n452\t                try:\n453\t                    produced = half()\n454\t                except TypeError:\n455\t                    produced = None\n456\t                cost = getattr(produced, \"mana_cost\", None)\n457\t                if isinstance(cost, ManaCost):\n458\t                    candidates.append(cost)\n459\t        assert candidates, \"no prepare-spell cost surface found on the card\"\n460\t        assert any(c == expected for c in candidates)\n461\t\n462\t\n463\tif __name__ == \"__main__\":  # pragma: no cover\n464\t    raise SystemExit(pytest.main([__file__, \"-v\"]))\n465\t"}]},"parent_tool_use_id":"toolu_018ZwvTgTpTJz4LT2bhcsVoT","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"91c5206c-be6a-4081-ab9b-1fb2b13751f8","timestamp":"2026-06-02T08:09:37.232Z","subagent_type":"Tester","task_description":"Extend tests for sos_13 prepared mechanic"}
