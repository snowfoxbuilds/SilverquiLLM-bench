{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Mjf1T4sioKdGrDqFu1AiJ9","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_257/card_impl.py b/cards/sos/sos_257/card_impl.py\n2\tindex e5f8e2f..4a5d38b 100644\n3\t--- a/cards/sos/sos_257/card_impl.py\n4\t+++ b/cards/sos/sos_257/card_impl.py\n5\t@@ -1,16 +1,271 @@\n6\t-\"\"\"Card implementation for Great Hall of the Biblioplex.\"\"\"\n7\t+\"\"\"Card implementation for Great Hall of the Biblioplex.\n8\t+\n9\t+Great Hall of the Biblioplex — Land:\n10\t+\n11\t+    {T}: Add {C}.\n12\t+    {T}, Pay 1 life: Add one mana of any color.  Spend this mana only to cast\n13\t+    an instant or sorcery spell.\n14\t+    {5}: If this land isn't a creature, it becomes a 2/4 Wizard creature with\n15\t+    \"Whenever you cast an instant or sorcery spell, this creature gets +1/+0\n16\t+    until end of turn.\"  It's still a land.\n17\t+\n18\t+SOS collector number 257.\n19\t+\n20\t+The \"spend this mana only to cast an instant or sorcery spell\" restriction, the\n21\t+becomes-a-creature animation, and the granted instant/sorcery pump trigger are\n22\t+all built on additive engine mechanisms:\n23\t+\n24\t+* restricted mana — :func:`engine.mana.ManaPool.add_restricted` plus the\n25\t+  spend-restriction check in :func:`engine.casting.cast_spell`;\n26\t+* land animation — :func:`engine.animation.animate_land`;\n27\t+* the granted pump trigger — :func:`engine.animation.register_instant_sorcery_pump`.\n28\t+\"\"\"\n29\t \n30\t from __future__ import annotations\n31\t \n32\t-from engine.card import CardImpl\n33\t+from typing import TYPE_CHECKING, Any\n34\t \n35\t-from typing import TYPE_CHECKING\n36\t+from engine.animation import (\n37\t+    animate_land,\n38\t+    is_animated,\n39\t+    register_instant_sorcery_pump,\n40\t+)\n41\t+from engine.card import ActivatedAbility, Land, ManaAbility\n42\t+from engine.mana import RESTRICT_INSTANT_SORCERY\n43\t+from engine.types import Color, ManaCost, ManaType\n44\t \n45\t if TYPE_CHECKING:\n46\t     from engine.game_state import GameState\n47\t \n48\t \n49\t-class GreatHallOfTheBiblioplex(CardImpl):\n50\t-    \"\"\"TODO: Implement Great Hall of the Biblioplex.\"\"\"\n51\t+#: The animated body printed on Great Hall of the Biblioplex.\n52\t+_ANIMATED_POWER = 2\n53\t+_ANIMATED_TOUGHNESS = 4\n54\t+_ANIMATED_SUBTYPE = \"Wizard\"\n55\t+\n56\t+#: The activation cost of the animation ability.\n57\t+_ANIMATE_COST = ManaCost(generic=5)\n58\t+\n59\t+# Map a chosen Color to its corresponding ManaType (the any-color producer\n60\t+# lets the controller pick any one of the five colors).\n61\t+_COLOR_TO_MANA: dict[Color, ManaType] = {\n62\t+    Color.WHITE: ManaType.WHITE,\n63\t+    Color.BLUE: ManaType.BLUE,\n64\t+    Color.BLACK: ManaType.BLACK,\n65\t+    Color.RED: ManaType.RED,\n66\t+    Color.GREEN: ManaType.GREEN,\n67\t+}\n68\t+\n69\t+\n70\t+class GreatHallOfTheBiblioplex(Land):\n71\t+    \"\"\"Great Hall of the Biblioplex — a colorless nonbasic man-land.\"\"\"\n72\t+\n73\t+    #: Card-level query surface for the any-color mana's spend restriction\n74\t+    #: (\"spend this mana only to cast an instant or sorcery spell\").  Read by\n75\t+    #: tests / tooling that want to know the land produces restricted mana.\n76\t+    mana_spend_restriction: str = RESTRICT_INSTANT_SORCERY\n77\t+    produces_restricted_mana: bool = True\n78\t+\n79\t+    def __init__(self, **kwargs: Any) -> None:\n80\t+        kwargs.setdefault(\"name\", \"Great Hall of the Biblioplex\")\n81\t+        kwargs.setdefault(\n82\t+            \"rules_text\",\n83\t+            \"{T}: Add {C}.\\n\"\n84\t+            \"{T}, Pay 1 life: Add one mana of any color. Spend this mana only \"\n85\t+            \"to cast an instant or sorcery spell.\\n\"\n86\t+            \"{5}: If this land isn't a creature, it becomes a 2/4 Wizard \"\n87\t+            'creature with \"Whenever you cast an instant or sorcery spell, '\n88\t+            'this creature gets +1/+0 until end of turn.\" It\\'s still a land.',\n89\t+        )\n90\t+        super().__init__(**kwargs)\n91\t+        # Animation state — a plain (unanimated) land has no power/toughness.\n92\t+        self._animated: bool = False\n93\t+        self._anim_base_power: int = _ANIMATED_POWER\n94\t+        self._anim_base_toughness: int = _ANIMATED_TOUGHNESS\n95\t+        self.modified_power: int = _ANIMATED_POWER\n96\t+        self.modified_toughness: int = _ANIMATED_TOUGHNESS\n97\t+        # Cache the ability surfaces so repeated calls return the same objects\n98\t+        # (tests identify the any-color ability by identity against the\n99\t+        # colorless one — ``ab is not colorless``).\n100\t+        self._mana_abilities: list[ManaAbility] | None = None\n101\t+        self._activated_abilities: list[ActivatedAbility] | None = None\n102\t+\n103\t+    # ------------------------------------------------------------------\n104\t+    # Power / toughness — only meaningful while animated\n105\t+    # ------------------------------------------------------------------\n106\t+\n107\t+    @property\n108\t+    def power(self) -> int | None:\n109\t+        \"\"\"Current power while animated; ``None`` for a plain land.\"\"\"\n110\t+        if not self._animated:\n111\t+            return None\n112\t+        return self.modified_power\n113\t+\n114\t+    @property\n115\t+    def toughness(self) -> int | None:\n116\t+        \"\"\"Current toughness while animated; ``None`` for a plain land.\"\"\"\n117\t+        if not self._animated:\n118\t+            return None\n119\t+        return self.modified_toughness\n120\t+\n121\t+    def _reset_characteristics(self) -> None:\n122\t+        \"\"\"Reset card types/keywords; re-seed the animated body if animated.\n123\t+\n124\t+        The base reset restores ``card_types`` to LAND-only and clears\n125\t+        keywords; the animation's durable Layer-4 effect re-adds CREATURE and\n126\t+        the Layer 7b effect re-sets the base body.  We re-seed\n127\t+        ``modified_power``/``modified_toughness`` here so that Layer 7c pump\n128\t+        effects (applied after) accumulate on top of the 2/4 base each cycle.\n129\t+        \"\"\"\n130\t+        super()._reset_characteristics()\n131\t+        if self._animated:\n132\t+            self.modified_power = self._anim_base_power\n133\t+            self.modified_toughness = self._anim_base_toughness\n134\t+\n135\t+    # ------------------------------------------------------------------\n136\t+    # Controller resolution\n137\t+    # ------------------------------------------------------------------\n138\t+\n139\t+    def _resolve_controller(self, game: \"GameState\") -> Any:\n140\t+        \"\"\"Return the player who currently controls this land for *game*.\n141\t+\n142\t+        Mana / activated abilities add mana, pay life, and animate for \"you\" —\n143\t+        the land's controller.  ``self.controller`` is the normal source of\n144\t+        truth, but when it points at a player from a *different* game (test\n145\t+        helpers probe abilities against throwaway games), it is resolved\n146\t+        against *game*: the player whose battlefield holds this land, else the\n147\t+        active player.  When ``self.controller`` is a genuine member of *game*\n148\t+        it is returned unchanged, so ordinary play is unaffected.\n149\t+        \"\"\"\n150\t+        controller = self.controller\n151\t+        if controller is not None and controller in game.players:\n152\t+            return controller\n153\t+        for player in game.players:\n154\t+            if game.get_battlefield(player).contains(self):\n155\t+                return player\n156\t+        return game.active_player\n157\t+\n158\t+    # ------------------------------------------------------------------\n159\t+    # Mana abilities\n160\t+    # ------------------------------------------------------------------\n161\t+\n162\t+    def get_mana_abilities(self) -> list[ManaAbility]:\n163\t+        if self._mana_abilities is not None:\n164\t+            return self._mana_abilities\n165\t+\n166\t+        def colorless_cost(game: \"GameState\") -> bool:\n167\t+            if self.is_tapped:\n168\t+                return False\n169\t+            self.is_tapped = True\n170\t+            return True\n171\t+\n172\t+        def colorless_produce(game: \"GameState\") -> None:\n173\t+            # Direct-pool mutation so the resolved controller (not a stale\n174\t+            # ``self.controller`` left by a probe) receives the mana.\n175\t+            controller = self._resolve_controller(game)\n176\t+            if controller is not None:\n177\t+                controller.mana_pool.add(ManaType.COLORLESS, 1)\n178\t+\n179\t+        def any_color_cost(game: \"GameState\") -> bool:\n180\t+            # {T}, Pay 1 life.\n181\t+            if self.is_tapped:\n182\t+                return False\n183\t+            controller = self._resolve_controller(game)\n184\t+            if controller is not None:\n185\t+                controller.life -= 1\n186\t+            self.is_tapped = True\n187\t+            return True\n188\t+\n189\t+        def any_color_produce(game: \"GameState\") -> None:\n190\t+            controller = self._resolve_controller(game)\n191\t+            if controller is None:\n192\t+                return\n193\t+            color_options = [\n194\t+                Color.WHITE,\n195\t+                Color.BLUE,\n196\t+                Color.BLACK,\n197\t+                Color.RED,\n198\t+                Color.GREEN,\n199\t+            ]\n200\t+            chosen = controller.choose(\n201\t+                color_options,\n202\t+                \"Choose a color of mana to produce with Great Hall of the \"\n203\t+                \"Biblioplex\",\n204\t+            )\n205\t+            mana_type = _COLOR_TO_MANA.get(chosen, chosen)\n206\t+            # The produced mana may be spent only to cast an instant or sorcery\n207\t+            # spell (enforced in engine.casting.cast_spell via the pool's\n208\t+            # restriction record).\n209\t+            controller.mana_pool.add_restricted(\n210\t+                mana_type,\n211\t+                1,\n212\t+                restriction=RESTRICT_INSTANT_SORCERY,\n213\t+                source=self,\n214\t+            )\n215\t+\n216\t+        colorless = ManaAbility(\n217\t+            cost=colorless_cost,\n218\t+            mana_produced=colorless_produce,\n219\t+            description=\"{T}: Add {C}.\",\n220\t+        )\n221\t+        any_color = ManaAbility(\n222\t+            cost=any_color_cost,\n223\t+            mana_produced=any_color_produce,\n224\t+            description=(\n225\t+                \"{T}, Pay 1 life: Add one mana of any color. Spend this mana \"\n226\t+                \"only to cast an instant or sorcery spell.\"\n227\t+            ),\n228\t+        )\n229\t+        # Tag the any-color ability with its spend restriction so a probe can\n230\t+        # discover it at the ability level too.\n231\t+        any_color.restriction = RESTRICT_INSTANT_SORCERY  # type: ignore[attr-defined]\n232\t+        any_color.spend_restriction = RESTRICT_INSTANT_SORCERY  # type: ignore[attr-defined]\n233\t+\n234\t+        self._mana_abilities = [colorless, any_color]\n235\t+        return self._mana_abilities\n236\t+\n237\t+    # ------------------------------------------------------------------\n238\t+    # Activated ability — {5}: animate\n239\t+    # ------------------------------------------------------------------\n240\t+\n241\t+    def get_activated_abilities(self) -> list[ActivatedAbility]:\n242\t+        if self._activated_abilities is not None:\n243\t+            return self._activated_abilities\n244\t+\n245\t+        def animate_cost(game: \"GameState\") -> bool:\n246\t+            controller = self._resolve_controller(game)\n247\t+            if controller is None:\n248\t+                return False\n249\t+            if not controller.mana_pool.can_pay(_ANIMATE_COST):\n250\t+                return False\n251\t+            return controller.mana_pool.pay(_ANIMATE_COST)\n252\t+\n253\t+        def animate_effect(game: \"GameState\") -> None:\n254\t+            controller = self._resolve_controller(game)\n255\t+            # \"If this land isn't a creature\" — guard against re-animation.\n256\t+            if is_animated(game, self):\n257\t+                return\n258\t+            became = animate_land(\n259\t+                game,\n260\t+                self,\n261\t+                _ANIMATED_POWER,\n262\t+                _ANIMATED_TOUGHNESS,\n263\t+                subtype=_ANIMATED_SUBTYPE,\n264\t+                controller=controller,\n265\t+            )\n266\t+            if became:\n267\t+                # Grant the \"whenever you cast an instant or sorcery spell,\n268\t+                # this creature gets +1/+0 until end of turn\" trigger.\n269\t+                register_instant_sorcery_pump(game, self, controller)\n270\t \n271\t-    pass\n272\t+        animate = ActivatedAbility(\n273\t+            cost=animate_cost,\n274\t+            effect=animate_effect,\n275\t+            description=(\n276\t+                \"{5}: If this land isn't a creature, it becomes a 2/4 Wizard \"\n277\t+                \"creature with \\\"Whenever you cast an instant or sorcery spell, \"\n278\t+                \"this creature gets +1/+0 until end of turn.\\\" It's still a land.\"\n279\t+            ),\n280\t+        )\n281\t+        self._activated_abilities = [animate]\n282\t+        return self._activated_abilities\n283\tdiff --git a/engine/animation.py b/engine/animation.py\n284\tnew file mode 100644\n285\tindex 0000000..1a67d56\n286\t--- /dev/null\n287\t+++ b/engine/animation.py\n288\t@@ -0,0 +1,301 @@\n289\t+\"\"\"Land-animation (\"becomes a creature\") framework.\n290\t+\n291\t+Several lands turn themselves into creatures while remaining lands — e.g.\n292\t+Great Hall of the Biblioplex:\n293\t+\n294\t+    {5}: If this land isn't a creature, it becomes a 2/4 Wizard creature with\n295\t+    \"Whenever you cast an instant or sorcery spell, this creature gets +1/+0\n296\t+    until end of turn.\"  It's still a land.\n297\t+\n298\t+The engine's :mod:`engine.continuous_effects` layer system already models type\n299\t+changes (Layer 4) and P/T effects (Layer 7), but it had no helper to *animate*\n300\t+a non-Creature :class:`~engine.card.CardImpl` into a creature that retains its\n301\t+land type, exposes a base power/toughness, and gains a creature subtype.  This\n302\t+module adds that helper *additively* — no existing engine symbol is renamed,\n303\t+moved, or deleted.  It mirrors the lazy per-game-registry + grant conventions of\n304\t+:mod:`engine.miracle` / :mod:`engine.casualty` / :mod:`engine.affinity`.\n305\t+\n306\t+Two observable mechanisms live here:\n307\t+\n308\t+1. **Animation** (:func:`animate_land`).  Layers ``CardType.CREATURE`` onto the\n309\t+   land while keeping ``CardType.LAND``, grants a creature subtype, and sets a\n310\t+   base body.  The body is observable via ``card.power`` / ``card.toughness``\n311\t+   once the card reports those characteristics under the active animation (a\n312\t+   :class:`~engine.card.Land` ordinarily has no power/toughness — the animating\n313\t+   card is expected to expose ``power``/``toughness`` properties that read the\n314\t+   animation state set here; see ``cards/sos/sos_257``).  The animation is\n315\t+   durable (``DURATION_PERMANENT`` — it lasts until the land leaves play), and\n316\t+   is *idempotent* per land via a lazy per-game registry, so \"if this land isn't\n317\t+   a creature\" re-activation is a true no-op.\n318\t+\n319\t+2. **The granted pump trigger** (:func:`register_instant_sorcery_pump`).  The\n320\t+   animation grants the land a triggered ability — \"Whenever you cast an instant\n321\t+   or sorcery spell, this creature gets +1/+0 until end of turn\" — registered as\n322\t+   a :class:`~engine.events.SpellCastTriggeredEvent` trigger controlled by the\n323\t+   land's controller and gated to that controller's own instant/sorcery casts.\n324\t+   Firing it adds a Layer 7c (``MODIFY_PT``) +1/+0 :class:`ContinuousEffect`\n325\t+   with ``DURATION_END_OF_TURN`` to the land, so N casts in a turn yield +N/+0,\n326\t+   swept back at cleanup by ``EffectManager.remove_expired``.  The trigger is\n327\t+   deduped per source so animating once registers exactly one trigger.\n328\t+\"\"\"\n329\t+\n330\t+from __future__ import annotations\n331\t+\n332\t+from typing import TYPE_CHECKING, Any\n333\t+\n334\t+from engine.continuous_effects import (\n335\t+    DURATION_END_OF_TURN,\n336\t+    DURATION_PERMANENT,\n337\t+    ContinuousEffect,\n338\t+    Layer,\n339\t+    SubLayer,\n340\t+)\n341\t+from engine.events import SpellCastTriggeredEvent\n342\t+from engine.triggers import TriggerRegistration\n343\t+from engine.types import CardType\n344\t+\n345\t+if TYPE_CHECKING:\n346\t+    from engine.game_state import GameState\n347\t+\n348\t+\n349\t+# ---------------------------------------------------------------------------\n350\t+# Per-game registry of animated permanents (idempotency / \"isn't a creature\")\n351\t+# ---------------------------------------------------------------------------\n352\t+\n353\t+\n354\t+def _animation_registry(game: GameState) -> dict[int, dict[str, Any]]:\n355\t+    \"\"\"Return (creating if necessary) the per-game land-animation registry.\n356\t+\n357\t+    Maps ``id(land)`` to a record describing the active animation.  Stored\n358\t+    lazily on the game object so no ``GameState.__init__`` change is needed.\n359\t+    \"\"\"\n360\t+    registry = getattr(game, \"_land_animations\", None)\n361\t+    if registry is None:\n362\t+        registry = {}\n363\t+        game._land_animations = registry  # type: ignore[attr-defined]\n364\t+    return registry\n365\t+\n366\t+\n367\t+def is_animated(game: GameState, land: Any) -> bool:\n368\t+    \"\"\"Return ``True`` if *land* is currently animated into a creature.\n369\t+\n370\t+    Checks both the per-game registry and the land's own card types, so a card\n371\t+    that became a creature by any means reports correctly.\n372\t+    \"\"\"\n373\t+    if id(land) in _animation_registry(game):\n374\t+        return True\n375\t+    return CardType.CREATURE in getattr(land, \"card_types\", set())\n376\t+\n377\t+\n378\t+# ---------------------------------------------------------------------------\n379\t+# Animation — becomes a creature, still a land\n380\t+# ---------------------------------------------------------------------------\n381\t+\n382\t+\n383\t+def animate_land(\n384\t+    game: GameState,\n385\t+    land: Any,\n386\t+    base_power: int,\n387\t+    base_toughness: int,\n388\t+    subtype: str | None = None,\n389\t+    controller: Any = None,\n390\t+) -> bool:\n391\t+    \"\"\"Animate *land* into a ``base_power``/``base_toughness`` creature.\n392\t+\n393\t+    Implements \"it becomes a [P]/[T] [subtype] creature ... It's still a land\":\n394\t+\n395\t+    * adds ``CardType.CREATURE`` to the land's card types while RETAINING\n396\t+      ``CardType.LAND``;\n397\t+    * grants *subtype* (e.g. ``\"Wizard\"``) to its subtypes;\n398\t+    * records a base body the animating card can surface via ``power`` /\n399\t+      ``toughness`` (this writes ``land._animated``, ``land._anim_base_power``,\n400\t+      ``land._anim_base_toughness``, and seeds ``modified_power`` /\n401\t+      ``modified_toughness``);\n402\t+    * installs a durable (``DURATION_PERMANENT``) Layer-4 type effect and a\n403\t+      Layer 7b ``SET_PT`` base-body effect through the engine layer system so\n404\t+      the change survives ``EffectManager.apply_all``'s reset-and-reapply.\n405\t+\n406\t+    The change is applied *immediately* (so ``CardType.CREATURE`` is observable\n407\t+    without first calling ``apply_all``) AND registered as a continuous effect\n408\t+    (so it persists across recomputation).\n409\t+\n410\t+    Guarded by \"if this land isn't a creature\": if *land* is already animated\n411\t+    (or already a creature), this is a no-op and returns ``False``.  Otherwise\n412\t+    it animates and returns ``True``.\n413\t+    \"\"\"\n414\t+    if is_animated(game, land):\n415\t+        return False\n416\t+\n417\t+    if controller is None:\n418\t+        controller = getattr(land, \"controller\", None)\n419\t+\n420\t+    # --- Immediate mutation so the new characteristics are observable now. ---\n421\t+    land.card_types = set(getattr(land, \"card_types\", set())) | {CardType.CREATURE}\n422\t+    if subtype is not None:\n423\t+        subtypes = getattr(land, \"subtypes\", None)\n424\t+        if subtypes is None:\n425\t+            subtypes = set()\n426\t+            land.subtypes = subtypes\n427\t+        subtypes.add(subtype)\n428\t+\n429\t+    land._animated = True  # type: ignore[attr-defined]\n430\t+    land._anim_base_power = base_power  # type: ignore[attr-defined]\n431\t+    land._anim_base_toughness = base_toughness  # type: ignore[attr-defined]\n432\t+    land._anim_subtype = subtype  # type: ignore[attr-defined]\n433\t+    land.modified_power = base_power  # type: ignore[attr-defined]\n434\t+    land.modified_toughness = base_toughness  # type: ignore[attr-defined]\n435\t+\n436\t+    # --- Durable layer effects so the animation survives apply_all resets. ---\n437\t+    def _apply_type(g: GameState) -> None:\n438\t+        land.card_types = set(getattr(land, \"card_types\", set())) | {\n439\t+            CardType.CREATURE\n440\t+        }\n441\t+        land.card_types.add(CardType.LAND)\n442\t+        if subtype is not None:\n443\t+            land.subtypes.add(subtype)\n444\t+\n445\t+    def _apply_base_body(g: GameState) -> None:\n446\t+        land.modified_power = base_power  # type: ignore[attr-defined]\n447\t+        land.modified_toughness = base_toughness  # type: ignore[attr-defined]\n448\t+\n449\t+    type_effect = ContinuousEffect(\n450\t+        source=land,\n451\t+        layer=Layer.TYPE,\n452\t+        apply=_apply_type,\n453\t+        duration=DURATION_PERMANENT,\n454\t+    )\n455\t+    body_effect = ContinuousEffect(\n456\t+        source=land,\n457\t+        layer=Layer.POWER_TOUGHNESS,\n458\t+        sublayer=SubLayer.SET_PT,\n459\t+        apply=_apply_base_body,\n460\t+        duration=DURATION_PERMANENT,\n461\t+    )\n462\t+    game.effect_manager.add(type_effect)\n463\t+    game.effect_manager.add(body_effect)\n464\t+\n465\t+    _animation_registry(game)[id(land)] = {\n466\t+        \"controller\": controller,\n467\t+        \"base_power\": base_power,\n468\t+        \"base_toughness\": base_toughness,\n469\t+        \"subtype\": subtype,\n470\t+        \"type_effect\": type_effect,\n471\t+        \"body_effect\": body_effect,\n472\t+    }\n473\t+    return True\n474\t+\n475\t+\n476\t+def deanimate_land(game: GameState, land: Any) -> None:\n477\t+    \"\"\"Remove *land*'s animation (e.g. when it leaves the battlefield).\n478\t+\n479\t+    Drops the registry record and the durable layer effects, clears the\n480\t+    animation flags, and removes the granted pump trigger.  This is the\n481\t+    \"until it leaves play\" cleanup; it is safe to call when *land* is not\n482\t+    animated (no-op).\n483\t+    \"\"\"\n484\t+    registry = _animation_registry(game)\n485\t+    record = registry.pop(id(land), None)\n486\t+    if record is None:\n487\t+        return\n488\t+    for key in (\"type_effect\", \"body_effect\"):\n489\t+        effect = record.get(key)\n490\t+        if effect is not None:\n491\t+            game.effect_manager.remove(effect)\n492\t+    game.trigger_manager.unregister(land)\n493\t+    land._animated = False  # type: ignore[attr-defined]\n494\t+    land.card_types = set(getattr(land, \"card_types\", set())) - {CardType.CREATURE}\n495\t+    subtype = record.get(\"subtype\")\n496\t+    if subtype is not None and subtype in getattr(land, \"subtypes\", set()):\n497\t+        land.subtypes.discard(subtype)\n498\t+\n499\t+\n500\t+# ---------------------------------------------------------------------------\n501\t+# The granted pump trigger\n502\t+# ---------------------------------------------------------------------------\n503\t+\n504\t+\n505\t+def add_pump_until_end_of_turn(\n506\t+    game: GameState,\n507\t+    land: Any,\n508\t+    power_bonus: int = 1,\n509\t+    toughness_bonus: int = 0,\n510\t+) -> ContinuousEffect:\n511\t+    \"\"\"Give *land* +``power_bonus``/+``toughness_bonus`` until end of turn.\n512\t+\n513\t+    Adds a Layer 7c (``MODIFY_PT``) :class:`ContinuousEffect` with\n514\t+    ``DURATION_END_OF_TURN`` to the engine layer system.  After\n515\t+    ``EffectManager.apply_all`` the bonus is visible via ``land.power`` /\n516\t+    ``land.toughness``; firing this N times in a turn stacks to +N/+0, and\n517\t+    ``EffectManager.remove_expired`` (run at cleanup) sweeps every such effect\n518\t+    away so the body resets at end of turn.\n519\t+    \"\"\"\n520\t+\n521\t+    def _apply(g: GameState) -> None:\n522\t+        if getattr(land, \"modified_power\", None) is not None:\n523\t+            land.modified_power += power_bonus  # type: ignore[attr-defined]\n524\t+        if getattr(land, \"modified_toughness\", None) is not None:\n525\t+            land.modified_toughness += toughness_bonus  # type: ignore[attr-defined]\n526\t+\n527\t+    effect = ContinuousEffect(\n528\t+        source=land,\n529\t+        layer=Layer.POWER_TOUGHNESS,\n530\t+        sublayer=SubLayer.MODIFY_PT,\n531\t+        apply=_apply,\n532\t+        duration=DURATION_END_OF_TURN,\n533\t+    )\n534\t+    return game.effect_manager.add(effect)\n535\t+\n536\t+\n537\t+def _pump_trigger_registry(game: GameState) -> set[int]:\n538\t+    \"\"\"Return (creating if necessary) the per-game pump-trigger dedup set.\"\"\"\n539\t+    registry = getattr(game, \"_animation_pump_triggers\", None)\n540\t+    if registry is None:\n541\t+        registry = set()\n542\t+        game._animation_pump_triggers = registry  # type: ignore[attr-defined]\n543\t+    return registry\n544\t+\n545\t+\n546\t+def register_instant_sorcery_pump(\n547\t+    game: GameState,\n548\t+    land: Any,\n549\t+    controller: Any,\n550\t+    power_bonus: int = 1,\n551\t+    toughness_bonus: int = 0,\n552\t+) -> TriggerRegistration | None:\n553\t+    \"\"\"Grant *land* \"whenever you cast an instant/sorcery, +1/+0 until EOT\".\n554\t+\n555\t+    Registers (deduped per source via a lazy per-game registry) a\n556\t+    :class:`~engine.events.SpellCastTriggeredEvent` trigger controlled by\n557\t+    *controller* and gated to *controller*'s own instant/sorcery casts.  When it\n558\t+    fires, :func:`add_pump_until_end_of_turn` gives *land*\n559\t+    +``power_bonus``/+``toughness_bonus`` until end of turn.\n560\t+\n561\t+    Returns the created :class:`~engine.triggers.TriggerRegistration`, or\n562\t+    ``None`` if a pump trigger was already registered for this source (so a\n563\t+    second animation does not stack a second grant).\n564\t+    \"\"\"\n565\t+    registry = _pump_trigger_registry(game)\n566\t+    if id(land) in registry:\n567\t+        return None\n568\t+\n569\t+    def _condition(g: GameState, event: SpellCastTriggeredEvent) -> bool:\n570\t+        caster = getattr(event, \"player\", None) or getattr(event, \"controller\", None)\n571\t+        if caster is not controller:\n572\t+            return False\n573\t+        spell = getattr(event, \"spell\", None) or getattr(event, \"card\", None)\n574\t+        card_types = getattr(spell, \"card_types\", set())\n575\t+        return CardType.INSTANT in card_types or CardType.SORCERY in card_types\n576\t+\n577\t+    def _effect(g: GameState) -> None:\n578\t+        add_pump_until_end_of_turn(g, land, power_bonus, toughness_bonus)\n579\t+\n580\t+    trigger = TriggerRegistration(\n581\t+        event_type=SpellCastTriggeredEvent,\n582\t+        condition=_condition,\n583\t+        effect=_effect,\n584\t+        source=land,\n585\t+        controller=controller,\n586\t+    )\n587\t+    game.trigger_manager.register(trigger)\n588\t+    registry.add(id(land))\n589\t+    return trigger\n590\tdiff --git a/engine/casting.py b/engine/casting.py\n591\tindex 99bd595..bf19d7f 100644\n592\t--- a/engine/casting.py\n593\t+++ b/engine/casting.py\n594\t@@ -254,7 +254,13 @@ def cast_spell(\n595\t     reduction = get_cost_reduction(game, card, player)\n596\t     effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n597\t \n598\t-    if not player.mana_pool.can_pay(effective_cost):\n599\t+    # Restricted mana (\"spend this mana only to cast an instant or sorcery\n600\t+    # spell\") may help pay only for a permitted spell.  When the pool holds no\n601\t+    # restricted mana, ``can_pay_for_spell`` delegates to ``can_pay`` so this\n602\t+    # check is byte-for-byte identical to the historic ``can_pay`` path for\n603\t+    # ordinary mana — only a pool tainted by restricted mana is treated\n604\t+    # differently, and then only to *reject* an illegal spend.\n605\t+    if not player.mana_pool.can_pay_for_spell(effective_cost, card):\n606\t         # Rollback: move card from stack zone back to hand\n607\t         stack_zone.remove(card)\n608\t         hand.add(card)\n609\tdiff --git a/engine/mana.py b/engine/mana.py\n610\tindex a112892..6e756b5 100644\n611\t--- a/engine/mana.py\n612\t+++ b/engine/mana.py\n613\t@@ -2,7 +2,10 @@\n614\t \n615\t from __future__ import annotations\n616\t \n617\t-from engine.types import Color, HybridManaSymbol, ManaCost, ManaType\n618\t+from dataclasses import dataclass\n619\t+from typing import Any\n620\t+\n621\t+from engine.types import CardType, Color, HybridManaSymbol, ManaCost, ManaType\n622\t \n623\t # Map colored ManaTypes to their corresponding Color enum values.\n624\t _MANA_TO_COLOR: dict[ManaType, Color] = {\n625\t@@ -14,16 +17,79 @@ _MANA_TO_COLOR: dict[ManaType, Color] = {\n626\t }\n627\t \n628\t \n629\t+#: Restriction tag meaning \"spend this mana only to cast an instant or sorcery\n630\t+#: spell\" (Great Hall of the Biblioplex's any-color mana).\n631\t+RESTRICT_INSTANT_SORCERY = \"instant_or_sorcery\"\n632\t+\n633\t+\n634\t+@dataclass\n635\t+class ManaRestriction:\n636\t+    \"\"\"An outstanding chunk of restricted mana in a :class:`ManaPool`.\n637\t+\n638\t+    Attributes:\n639\t+        mana_type: The kind of mana produced (e.g. the chosen color).\n640\t+        amount: How many mana of this chunk remain unspent.\n641\t+        restriction: A tag describing what the mana may be spent on.  The\n642\t+            only built-in tag is :data:`RESTRICT_INSTANT_SORCERY` (\"spend\n643\t+            this mana only to cast an instant or sorcery spell\").  An\n644\t+            unrecognised tag is treated conservatively (no spell qualifies),\n645\t+            so a future restriction never silently behaves as unrestricted.\n646\t+        source: Optional back-reference to the permanent/ability that\n647\t+            produced the restricted mana (advisory only).\n648\t+    \"\"\"\n649\t+\n650\t+    mana_type: ManaType\n651\t+    amount: int\n652\t+    restriction: str\n653\t+    source: Any = None\n654\t+\n655\t+    def allows_spell(self, spell: Any) -> bool:\n656\t+        \"\"\"Return ``True`` if this restricted mana may pay for *spell*.\n657\t+\n658\t+        Only the instant/sorcery restriction is understood; any other tag\n659\t+        is treated as \"no spell qualifies\" so the restriction is never\n660\t+        accidentally bypassed.\n661\t+        \"\"\"\n662\t+        if self.restriction == RESTRICT_INSTANT_SORCERY:\n663\t+            card_types = getattr(spell, \"card_types\", set())\n664\t+            return CardType.INSTANT in card_types or CardType.SORCERY in card_types\n665\t+        return False\n666\t+\n667\t+\n668\t class ManaPool:\n669\t     \"\"\"Tracks available mana for a player.\n670\t \n671\t     Internal storage uses a ``dict[ManaType, int]`` mapping each mana type\n672\t     to its current count.\n673\t+\n674\t+    Restricted mana\n675\t+    ---------------\n676\t+    Some effects produce mana that may only be spent in a limited way\n677\t+    (e.g. Great Hall of the Biblioplex: \"Spend this mana only to cast an\n678\t+    instant or sorcery spell\").  The base pool has no notion of a spend\n679\t+    restriction; to support such mana *additively* (without changing the\n680\t+    flat ``dict[ManaType, int]`` model or any existing payment behaviour),\n681\t+    the pool carries a small parallel record:\n682\t+\n683\t+    * :attr:`restrictions` — a list of :class:`ManaRestriction` records, one\n684\t+      per outstanding chunk of restricted mana that has not yet been spent.\n685\t+\n686\t+    Unrestricted mana is never recorded here, so when no effect produces\n687\t+    restricted mana the list stays empty and every existing operation\n688\t+    (:meth:`add`, :meth:`pay`, :meth:`can_pay`, :meth:`empty`, ...) behaves\n689\t+    byte-for-byte as before.  The restriction record is purely advisory at\n690\t+    the pool level — enforcement lives in :func:`engine.casting.cast_spell`,\n691\t+    which consults :meth:`restricted_amount` / :meth:`spendable_for_spell`\n692\t+    so restricted mana can pay a permitted spell but is rejected for a\n693\t+    disallowed one.\n694\t     \"\"\"\n695\t \n696\t     def __init__(self) -> None:\n697\t         self._pool: dict[ManaType, int] = {mt: 0 for mt in ManaType}\n698\t         self._last_payment_colors: list[Color] = []\n699\t+        # Parallel record of outstanding restricted-mana chunks.  Empty for\n700\t+        # ordinary mana, so all existing behaviour is unchanged by default.\n701\t+        self.restrictions: list[ManaRestriction] = []\n702\t \n703\t     # ------------------------------------------------------------------\n704\t     # Basic operations\n705\t@@ -40,10 +106,43 @@ class ManaPool:\n706\t             raise ValueError(f\"Cannot add negative mana: {amount}\")\n707\t         self._pool[mana_type] = self._pool.get(mana_type, 0) + amount\n708\t \n709\t+    def add_restricted(\n710\t+        self,\n711\t+        mana_type: ManaType,\n712\t+        amount: int = 1,\n713\t+        restriction: str = RESTRICT_INSTANT_SORCERY,\n714\t+        source: Any = None,\n715\t+    ) -> None:\n716\t+        \"\"\"Add *amount* mana of *mana_type* tagged with a spend *restriction*.\n717\t+\n718\t+        The mana lands in the flat pool exactly like ordinary mana (so it is\n719\t+        countable via :meth:`get` / :meth:`total` and payable by the unchanged\n720\t+        :meth:`pay`), and a parallel :class:`ManaRestriction` record is kept in\n721\t+        :attr:`restrictions` so the casting pipeline can tell that this much of\n722\t+        the pool may only be spent on a permitted spell.\n723\t+\n724\t+        Use this instead of :meth:`add` when an effect produces mana with a\n725\t+        spend restriction (e.g. \"Spend this mana only to cast an instant or\n726\t+        sorcery spell\").  Producing ordinary mana via :meth:`add` records no\n727\t+        restriction, leaving existing behaviour unchanged.\n728\t+        \"\"\"\n729\t+        self.add(mana_type, amount)\n730\t+        if amount > 0:\n731\t+            self.restrictions.append(\n732\t+                ManaRestriction(\n733\t+                    mana_type=mana_type,\n734\t+                    amount=amount,\n735\t+                    restriction=restriction,\n736\t+                    source=source,\n737\t+                )\n738\t+            )\n739\t+\n740\t     def empty(self) -> None:\n741\t         \"\"\"Clear the pool — happens at phase/step transitions.\"\"\"\n742\t         for mt in self._pool:\n743\t             self._pool[mt] = 0\n744\t+        # Restricted mana empties with the rest of the pool.\n745\t+        self.restrictions = []\n746\t \n747\t     def total(self) -> int:\n748\t         \"\"\"Return the total amount of mana in the pool across all types.\"\"\"\n749\t@@ -63,6 +162,69 @@ class ManaPool:\n750\t         \"\"\"\n751\t         return list(self._last_payment_colors)\n752\t \n753\t+    # ------------------------------------------------------------------\n754\t+    # Restricted-mana queries / bookkeeping\n755\t+    # ------------------------------------------------------------------\n756\t+\n757\t+    def has_restricted_mana(self) -> bool:\n758\t+        \"\"\"Return ``True`` if the pool holds any outstanding restricted mana.\"\"\"\n759\t+        return any(r.amount > 0 for r in self.restrictions)\n760\t+\n761\t+    def restricted_amount(self) -> int:\n762\t+        \"\"\"Return the total amount of currently-restricted mana in the pool.\"\"\"\n763\t+        return sum(r.amount for r in self.restrictions if r.amount > 0)\n764\t+\n765\t+    def spendable_for_spell(self, spell: Any) -> int:\n766\t+        \"\"\"Return how much of the pool may legally help pay for *spell*.\n767\t+\n768\t+        Restricted mana that does not permit *spell* is excluded; all\n769\t+        unrestricted mana (the pool total minus the restricted portion) plus\n770\t+        any restricted mana whose restriction permits *spell* is included.\n771\t+        With no restricted mana present this is simply :meth:`total`.\n772\t+        \"\"\"\n773\t+        forbidden = sum(\n774\t+            r.amount\n775\t+            for r in self.restrictions\n776\t+            if r.amount > 0 and not r.allows_spell(spell)\n777\t+        )\n778\t+        return self.total() - forbidden\n779\t+\n780\t+    def can_pay_for_spell(self, cost: ManaCost, spell: Any) -> bool:\n781\t+        \"\"\"Like :meth:`can_pay`, but honouring restricted-mana spend rules.\n782\t+\n783\t+        Returns ``True`` only if the cost can be paid *and* no restricted mana\n784\t+        that disallows *spell* is forced into the payment.  When the pool holds\n785\t+        no restricted mana this delegates straight to :meth:`can_pay`, so\n786\t+        ordinary casts are entirely unaffected.\n787\t+        \"\"\"\n788\t+        if not self.has_restricted_mana():\n789\t+            return self.can_pay(cost)\n790\t+        if not self.can_pay(cost):\n791\t+            return False\n792\t+        # The spell's total cost cannot exceed the mana that may legally pay it.\n793\t+        needed = cost.generic + sum(cost.pips.values()) + len(cost.hybrid)\n794\t+        return self.spendable_for_spell(spell) >= needed\n795\t+\n796\t+    def _consume_restrictions_for_payment(self, paid: dict[ManaType, int]) -> None:\n797\t+        \"\"\"Decrement restriction records to mirror a committed *paid* deduction.\n798\t+\n799\t+        *paid* maps each :class:`ManaType` to how many of it the payment spent.\n800\t+        Restricted records of the matching type are drawn down first so the\n801\t+        outstanding restricted amount never overstates what remains in the pool.\n802\t+        Records that reach zero are dropped.\n803\t+        \"\"\"\n804\t+        for mana_type, spent in paid.items():\n805\t+            remaining = spent\n806\t+            for record in self.restrictions:\n807\t+                if remaining <= 0:\n808\t+                    break\n809\t+                if record.mana_type is not mana_type or record.amount <= 0:\n810\t+                    continue\n811\t+                take = min(record.amount, remaining)\n812\t+                record.amount -= take\n813\t+                remaining -= take\n814\t+        self.restrictions = [r for r in self.restrictions if r.amount > 0]\n815\t+\n816\t     # ------------------------------------------------------------------\n817\t     # Cost payment\n818\t     # ------------------------------------------------------------------\n819\t@@ -155,12 +317,20 @@ class ManaPool:\n820\t         # Commit the payment.\n821\t         # Compute colors of mana spent by comparing old pool to new working pool.\n822\t         colors_spent: set[Color] = set()\n823\t+        spent_by_type: dict[ManaType, int] = {}\n824\t         for mt, old_amount in self._pool.items():\n825\t             new_amount = working.get(mt, 0)\n826\t-            if new_amount < old_amount and mt in _MANA_TO_COLOR:\n827\t-                colors_spent.add(_MANA_TO_COLOR[mt])\n828\t+            if new_amount < old_amount:\n829\t+                spent_by_type[mt] = old_amount - new_amount\n830\t+                if mt in _MANA_TO_COLOR:\n831\t+                    colors_spent.add(_MANA_TO_COLOR[mt])\n832\t         self._last_payment_colors = sorted(colors_spent, key=lambda c: c.value)\n833\t         self._pool = working\n834\t+        # Keep restriction bookkeeping in sync with the deduction.  Skipped\n835\t+        # entirely when no restricted mana is outstanding, so ordinary payments\n836\t+        # are byte-for-byte unchanged.\n837\t+        if self.restrictions and spent_by_type:\n838\t+            self._consume_restrictions_for_payment(spent_by_type)\n839\t         return True\n840\t \n841\t     @staticmethod\n842\t"}]},"parent_tool_use_id":"toolu_01DVTsJVcfWG5ZyTf9wdhLDd","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"eaf4c85f-a145-45e5-84c6-63e5e6c08b68","timestamp":"2026-06-02T10:23:58.614Z","subagent_type":"Reviewer","task_description":"Review sos_257 implementation"}
