{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GzfXRqjauADCzCNtnb4W9q","type":"tool_result","content":"1\t\"\"\"Tests for engine/casting.py — casting and resolution pipeline.\n2\t\n3\tCovers:\n4\t- Timing helpers: is_sorcery_speed, can_cast_at_instant_speed\n5\t- cast_spell: full pipeline from hand → stack → resolve → destination zone\n6\t- play_land: special action bypassing the stack\n7\t- CastingError for illegal actions\n8\t- Hook callbacks (on_cast, on_resolve)\n9\t- Mana payment verification\n10\t\"\"\"\n11\t\n12\tfrom __future__ import annotations\n13\t\n14\timport pytest\n15\t\n16\tfrom engine.card import (\n17\t    Artifact,\n18\t    ArtifactCreature,\n19\t    CardImpl,\n20\t    Creature,\n21\t    Enchantment,\n22\t    Instant,\n23\t    Land,\n24\t    Planeswalker,\n25\t    Sorcery,\n26\t)\n27\tfrom engine.casting import (\n28\t    CastingError,\n29\t    _PERMANENT_TYPES,\n30\t    can_cast_at_instant_speed,\n31\t    cast_spell,\n32\t    is_sorcery_speed,\n33\t    play_land,\n34\t)\n35\tfrom engine.game_state import GameState\n36\tfrom engine.player import DeterministicPlayer\n37\tfrom engine.stack import StackObject\n38\tfrom engine.types import CardType, Keyword, ManaCost, ManaType, Phase, Step\n39\t\n40\t\n41\t# ---------------------------------------------------------------------------\n42\t# Helpers\n43\t# ---------------------------------------------------------------------------\n44\t\n45\tdef _make_game(\n46\t    *,\n47\t    p1_script: list | None = None,\n48\t    p2_script: list | None = None,\n49\t    phase: Phase = Phase.PRECOMBAT_MAIN,\n50\t    step: Step | None = None,\n51\t) -> GameState:\n52\t    \"\"\"Create a minimal 2-player GameState at the specified phase/step.\"\"\"\n53\t    p1 = DeterministicPlayer(\"Alice\", p1_script or [])\n54\t    p2 = DeterministicPlayer(\"Bob\", p2_script or [])\n55\t    game = GameState([p1, p2])\n56\t    game.phase = phase\n57\t    game.step = step\n58\t    return game\n59\t\n60\t\n61\tdef _add_to_hand(game: GameState, player_idx: int, card: CardImpl) -> None:\n62\t    \"\"\"Put *card* into the player's hand.\"\"\"\n63\t    game.get_hand(game.players[player_idx]).add(card)\n64\t\n65\t\n66\tdef _add_mana(player: DeterministicPlayer, mana_type: ManaType, amount: int) -> None:\n67\t    \"\"\"Shortcut to add mana to a player's pool.\"\"\"\n68\t    player.mana_pool.add(mana_type, amount)\n69\t\n70\t\n71\t# ---------------------------------------------------------------------------\n72\t# Timing helper tests — is_sorcery_speed\n73\t# ---------------------------------------------------------------------------\n74\t\n75\tclass TestIsSorcerySpeed:\n76\t    \"\"\"Verify is_sorcery_speed requires: active player + main phase + empty stack.\"\"\"\n77\t\n78\t    def test_precombat_main_active_player_empty_stack_is_true(self):\n79\t        game = _make_game(phase=Phase.PRECOMBAT_MAIN)\n80\t        assert is_sorcery_speed(game, game.players[0]) is True\n81\t\n82\t    def test_postcombat_main_active_player_empty_stack_is_true(self):\n83\t        game = _make_game(phase=Phase.POSTCOMBAT_MAIN)\n84\t        assert is_sorcery_speed(game, game.players[0]) is True\n85\t\n86\t    def test_non_active_player_returns_false(self):\n87\t        game = _make_game(phase=Phase.PRECOMBAT_MAIN)\n88\t        assert is_sorcery_speed(game, game.players[1]) is False\n89\t\n90\t    def test_combat_phase_returns_false(self):\n91\t        game = _make_game(phase=Phase.COMBAT, step=Step.DECLARE_ATTACKERS)\n92\t        assert is_sorcery_speed(game, game.players[0]) is False\n93\t\n94\t    def test_beginning_phase_returns_false(self):\n95\t        game = _make_game(phase=Phase.BEGINNING, step=Step.UPKEEP)\n96\t        assert is_sorcery_speed(game, game.players[0]) is False\n97\t\n98\t    def test_ending_phase_returns_false(self):\n99\t        game = _make_game(phase=Phase.ENDING, step=Step.END)\n100\t        assert is_sorcery_speed(game, game.players[0]) is False\n101\t\n102\t    def test_nonempty_stack_returns_false(self):\n103\t        game = _make_game(phase=Phase.PRECOMBAT_MAIN)\n104\t        dummy = StackObject(source=None, controller=game.players[0])\n105\t        game.stack.push(dummy)\n106\t        assert is_sorcery_speed(game, game.players[0]) is False\n107\t\n108\t\n109\t# ---------------------------------------------------------------------------\n110\t# Timing helper tests — can_cast_at_instant_speed\n111\t# ---------------------------------------------------------------------------\n112\t\n113\tclass TestCanCastAtInstantSpeed:\n114\t    \"\"\"Verify instant-speed detection: instant type or FLASH keyword.\"\"\"\n115\t\n116\t    def test_instant_returns_true(self):\n117\t        assert can_cast_at_instant_speed(Instant(name=\"Bolt\")) is True\n118\t\n119\t    def test_sorcery_returns_false(self):\n120\t        assert can_cast_at_instant_speed(Sorcery(name=\"Div\")) is False\n121\t\n122\t    def test_creature_without_flash_returns_false(self):\n123\t        assert can_cast_at_instant_speed(\n124\t            Creature(name=\"Bear\", base_power=2, base_toughness=2)\n125\t        ) is False\n126\t\n127\t    def test_creature_with_flash_returns_true(self):\n128\t        card = Creature(name=\"Viper\", base_power=2, base_toughness=1, keywords=Keyword.FLASH)\n129\t        assert can_cast_at_instant_speed(card) is True\n130\t\n131\t    def test_enchantment_with_flash_returns_true(self):\n132\t        card = Enchantment(name=\"Leyline\", keywords=Keyword.FLASH)\n133\t        assert can_cast_at_instant_speed(card) is True\n134\t\n135\t\n136\t# ---------------------------------------------------------------------------\n137\t# cast_spell — core pipeline tests\n138\t# ---------------------------------------------------------------------------\n139\t\n140\tclass TestCastSpellCreature:\n141\t    \"\"\"Requirement: cast vanilla creature → on stack → resolve → battlefield.\"\"\"\n142\t\n143\t    def test_cast_puts_creature_on_stack(self):\n144\t        game = _make_game()\n145\t        player = game.players[0]\n146\t        bear = Creature(\n147\t            name=\"Grizzly Bears\",\n148\t            mana_cost=ManaCost(generic=1, pips={ManaType.GREEN: 1}),\n149\t            base_power=2, base_toughness=2,\n150\t        )\n151\t        _add_to_hand(game, 0, bear)\n152\t        _add_mana(player, ManaType.GREEN, 2)\n153\t\n154\t        cast_spell(game, player, bear)\n155\t\n156\t        assert not game.stack.is_empty()\n157\t        top = game.stack.peek()\n158\t        assert top is not None\n159\t        assert top.source is bear\n160\t        assert top.controller is player\n161\t\n162\t    def test_cast_removes_creature_from_hand(self):\n163\t        game = _make_game()\n164\t        player = game.players[0]\n165\t        bear = Creature(\n166\t            name=\"Bear\", mana_cost=ManaCost(pips={ManaType.GREEN: 1}),\n167\t            base_power=2, base_toughness=2,\n168\t        )\n169\t        _add_to_hand(game, 0, bear)\n170\t        _add_mana(player, ManaType.GREEN, 1)\n171\t\n172\t        cast_spell(game, player, bear)\n173\t        assert not game.get_hand(player).contains(bear)\n174\t\n175\t    def test_resolve_creature_to_battlefield(self):\n176\t        game = _make_game()\n177\t        player = game.players[0]\n178\t        bear = Creature(\n179\t            name=\"Bear\",\n180\t            mana_cost=ManaCost(generic=1, pips={ManaType.GREEN: 1}),\n181\t            base_power=2, base_toughness=2,\n182\t        )\n183\t        _add_to_hand(game, 0, bear)\n184\t        _add_mana(player, ManaType.GREEN, 2)\n185\t\n186\t        cast_spell(game, player, bear)\n187\t        obj = game.stack.pop()\n188\t        obj.on_resolve(game)\n189\t\n190\t        assert game.get_battlefield(player).contains(bear)\n191\t        assert not game.get_graveyard(player).contains(bear)\n192\t\n193\t\n194\tclass TestCastSpellInstant:\n195\t    \"\"\"Requirement: cast instant → resolve → graveyard (not battlefield).\"\"\"\n196\t\n197\t    def test_resolve_instant_to_graveyard(self):\n198\t        game = _make_game()\n199\t        player = game.players[0]\n200\t        bolt = Instant(name=\"Bolt\", mana_cost=ManaCost(pips={ManaType.RED: 1}))\n201\t        _add_to_hand(game, 0, bolt)\n202\t        _add_mana(player, ManaType.RED, 1)\n203\t\n204\t        cast_spell(game, player, bolt)\n205\t        obj = game.stack.pop()\n206\t        obj.on_resolve(game)\n207\t\n208\t        assert game.get_graveyard(player).contains(bolt)\n209\t        assert not game.get_battlefield(player).contains(bolt)\n210\t\n211\t\n212\tclass TestCastSpellSorcery:\n213\t    \"\"\"Requirement: cast sorcery → resolve → graveyard.\"\"\"\n214\t\n215\t    def test_resolve_sorcery_to_graveyard(self):\n216\t        game = _make_game()\n217\t        player = game.players[0]\n218\t        div = Sorcery(\n219\t            name=\"Divination\",\n220\t            mana_cost=ManaCost(generic=2, pips={ManaType.BLUE: 1}),\n221\t        )\n222\t        _add_to_hand(game, 0, div)\n223\t        _add_mana(player, ManaType.BLUE, 3)\n224\t\n225\t        cast_spell(game, player, div)\n226\t        obj = game.stack.pop()\n227\t        obj.on_resolve(game)\n228\t\n229\t        assert game.get_graveyard(player).contains(div)\n230\t        assert not game.get_battlefield(player).contains(div)\n231\t\n232\t\n233\t# ---------------------------------------------------------------------------\n234\t# cast_spell — timing rejection tests\n235\t# ---------------------------------------------------------------------------\n236\t\n237\tclass TestCastSpellTimingRejections:\n238\t    \"\"\"Requirement: sorcery-speed violations raise CastingError.\"\"\"\n239\t\n240\t    def test_sorcery_during_combat_phase_raises(self):\n241\t        \"\"\"Sorcery during combat → CastingError.\"\"\"\n242\t        game = _make_game(phase=Phase.COMBAT, step=Step.DECLARE_ATTACKERS)\n243\t        player = game.players[0]\n244\t        sorc = Sorcery(name=\"Wrath\", mana_cost=ManaCost(pips={ManaType.WHITE: 1}))\n245\t        _add_to_hand(game, 0, sorc)\n246\t        _add_mana(player, ManaType.WHITE, 1)\n247\t\n248\t        with pytest.raises(CastingError, match=\"sorcery-speed timing\"):\n249\t            cast_spell(game, player, sorc)\n250\t\n251\t    def test_creature_during_combat_phase_raises(self):\n252\t        \"\"\"Non-flash creature during combat → CastingError.\"\"\"\n253\t        game = _make_game(phase=Phase.COMBAT, step=Step.DECLARE_BLOCKERS)\n254\t        player = game.players[0]\n255\t        bear = Creature(\n256\t            name=\"Bear\", mana_cost=ManaCost(pips={ManaType.GREEN: 1}),\n257\t            base_power=2, base_toughness=2,\n258\t        )\n259\t        _add_to_hand(game, 0, bear)\n260\t        _add_mana(player, ManaType.GREEN, 1)\n261\t\n262\t        with pytest.raises(CastingError, match=\"sorcery-speed timing\"):\n263\t            cast_spell(game, player, bear)\n264\t\n265\t    def test_sorcery_with_nonempty_stack_raises(self):\n266\t        \"\"\"Sorcery with non-empty stack → CastingError.\"\"\"\n267\t        game = _make_game()\n268\t        player = game.players[0]\n269\t        dummy = StackObject(source=None, controller=player)\n270\t        game.stack.push(dummy)\n271\t\n272\t        sorc = Sorcery(name=\"Div\", mana_cost=ManaCost(pips={ManaType.BLUE: 1}))\n273\t        _add_to_hand(game, 0, sorc)\n274\t        _add_mana(player, ManaType.BLUE, 1)\n275\t\n276\t        with pytest.raises(CastingError, match=\"sorcery-speed timing\"):\n277\t            cast_spell(game, player, sorc)\n278\t\n279\t    def test_non_active_player_sorcery_raises(self):\n280\t        \"\"\"Non-active player casting sorcery → CastingError.\"\"\"\n281\t        game = _make_game()\n282\t        non_active = game.players[1]\n283\t        sorc = Sorcery(name=\"Div\", mana_cost=ManaCost(pips={ManaType.BLUE: 1}))\n284\t        _add_to_hand(game, 1, sorc)\n285\t        _add_mana(non_active, ManaType.BLUE, 1)\n286\t\n287\t        with pytest.raises(CastingError, match=\"sorcery-speed timing\"):\n288\t            cast_spell(game, non_active, sorc)\n289\t\n290\t    def test_non_active_player_creature_no_flash_raises(self):\n291\t        \"\"\"Non-active player casting creature without flash → CastingError.\"\"\"\n292\t        game = _make_game()\n293\t        non_active = game.players[1]\n294\t        bear = Creature(\n295\t            name=\"Bear\", mana_cost=ManaCost(pips={ManaType.GREEN: 1}),\n296\t            base_power=2, base_toughness=2,\n297\t        )\n298\t        _add_to_hand(game, 1, bear)\n299\t        _add_mana(non_active, ManaType.GREEN, 1)\n300\t\n301\t        with pytest.raises(CastingError, match=\"sorcery-speed timing\"):\n302\t            cast_spell(game, non_active, bear)\n303\t\n304\t\n305\t# ---------------------------------------------------------------------------\n306\t# cast_spell — flash / instant-speed success\n307\t# ---------------------------------------------------------------------------\n308\t\n309\tclass TestCastSpellInstantSpeed:\n310\t    \"\"\"Requirement: FLASH keyword at instant speed → succeeds.\"\"\"\n311\t\n312\t    def test_flash_creature_during_combat_succeeds(self):\n313\t        game = _make_game(phase=Phase.COMBAT, step=Step.DECLARE_BLOCKERS)\n314\t        player = game.players[0]\n315\t        viper = Creature(\n316\t            name=\"Ambush Viper\",\n317\t            mana_cost=ManaCost(generic=1, pips={ManaType.GREEN: 1}),\n318\t            base_power=2, base_toughness=1,\n319\t            keywords=Keyword.FLASH,\n320\t        )\n321\t        _add_to_hand(game, 0, viper)\n322\t        _add_mana(player, ManaType.GREEN, 2)\n323\t\n324\t        cast_spell(game, player, viper)\n325\t        assert not game.stack.is_empty()\n326\t        assert game.stack.peek().source is viper\n327\t\n328\t    def test_instant_during_upkeep_succeeds(self):\n329\t        game = _make_game(phase=Phase.BEGINNING, step=Step.UPKEEP)\n330\t        player = game.players[0]\n331\t        bolt = Instant(name=\"Bolt\", mana_cost=ManaCost(pips={ManaType.RED: 1}))\n332\t        _add_to_hand(game, 0, bolt)\n333\t        _add_mana(player, ManaType.RED, 1)\n334\t\n335\t        cast_spell(game, player, bolt)\n336\t        assert not game.stack.is_empty()\n337\t\n338\t    def test_non_active_player_can_cast_instant(self):\n339\t        game = _make_game()\n340\t        non_active = game.players[1]\n341\t        bolt = Instant(name=\"Bolt\", mana_cost=ManaCost(pips={ManaType.RED: 1}))\n342\t        _add_to_hand(game, 1, bolt)\n343\t        _add_mana(non_active, ManaType.RED, 1)\n344\t\n345\t        cast_spell(game, non_active, bolt)\n346\t        assert not game.stack.is_empty()\n347\t\n348\t    def test_flash_enchantment_during_combat_succeeds(self):\n349\t        game = _make_game(phase=Phase.COMBAT, step=Step.END_COMBAT)\n350\t        player = game.players[0]\n351\t        ench = Enchantment(\n352\t            name=\"Leyline\",\n353\t            mana_cost=ManaCost(pips={ManaType.WHITE: 1}),\n354\t            keywords=Keyword.FLASH,\n355\t        )\n356\t        _add_to_hand(game, 0, ench)\n357\t        _add_mana(player, ManaType.WHITE, 1)\n358\t\n359\t        cast_spell(game, player, ench)\n360\t        assert not game.stack.is_empty()\n361\t\n362\t\n363\t# ---------------------------------------------------------------------------\n364\t# cast_spell — mana payment\n365\t# ---------------------------------------------------------------------------\n366\t\n367\tclass TestCastSpellManaPayment:\n368\t    \"\"\"Requirement: insufficient mana → CastingError; mana deducted on success.\"\"\"\n369\t\n370\t    def test_insufficient_mana_raises(self):\n371\t        game = _make_game()\n372\t        player = game.players[0]\n373\t        bear = Creature(\n374\t            name=\"Bear\",\n375\t            mana_cost=ManaCost(generic=1, pips={ManaType.GREEN: 1}),\n376\t            base_power=2, base_toughness=2,\n377\t        )\n378\t        _add_to_hand(game, 0, bear)\n379\t        _add_mana(player, ManaType.GREEN, 1)  # only 1G, need 1G + {1}\n380\t\n381\t        with pytest.raises(CastingError, match=\"insufficient mana\"):\n382\t            cast_spell(game, player, bear)\n383\t\n384\t    def test_no_mana_at_all_raises(self):\n385\t        game = _make_game()\n386\t        player = game.players[0]\n387\t        bolt = Instant(name=\"Bolt\", mana_cost=ManaCost(pips={ManaType.RED: 1}))\n388\t        _add_to_hand(game, 0, bolt)\n389\t        # No mana added\n390\t\n391\t        with pytest.raises(CastingError, match=\"insufficient mana\"):\n392\t            cast_spell(game, player, bolt)\n393\t\n394\t    def test_wrong_color_mana_raises(self):\n395\t        game = _make_game()\n396\t        player = game.players[0]\n397\t        bolt = Instant(name=\"Bolt\", mana_cost=ManaCost(pips={ManaType.RED: 1}))\n398\t        _add_to_hand(game, 0, bolt)\n399\t        _add_mana(player, ManaType.BLUE, 5)  # plenty of mana, but wrong color\n400\t\n401\t        with pytest.raises(CastingError, match=\"insufficient mana\"):\n402\t            cast_spell(game, player, bolt)\n403\t\n404\t    def test_mana_deducted_after_cast(self):\n405\t        \"\"\"Verify mana pool is reduced by the cost after a successful cast.\"\"\"\n406\t        game = _make_game()\n407\t        player = game.players[0]\n408\t        bear = Creature(\n409\t            name=\"Bear\",\n410\t            mana_cost=ManaCost(generic=1, pips={ManaType.GREEN: 1}),\n411\t            base_power=2, base_toughness=2,\n412\t        )\n413\t        _add_to_hand(game, 0, bear)\n414\t        _add_mana(player, ManaType.GREEN, 3)\n415\t\n416\t        cast_spell(game, player, bear)\n417\t\n418\t        # 3G minus {G} pip minus {1} generic (auto-paid with G) = 1G left\n419\t        assert player.mana_pool.get(ManaType.GREEN) == 1\n420\t\n421\t    def test_exact_mana_leaves_zero(self):\n422\t        \"\"\"Paying exactly the cost leaves the pool empty.\"\"\"\n423\t        game = _make_game()\n424\t        player = game.players[0]\n425\t        bolt = Instant(name=\"Bolt\", mana_cost=ManaCost(pips={ManaType.RED: 1}))\n426\t        _add_to_hand(game, 0, bolt)\n427\t        _add_mana(player, ManaType.RED, 1)\n428\t\n429\t        cast_spell(game, player, bolt)\n430\t        assert player.mana_pool.get(ManaType.RED) == 0\n431\t\n432\t    def test_zero_cost_spell_requires_no_mana(self):\n433\t        \"\"\"A zero-cost spell can be cast with an empty pool.\"\"\"\n434\t        game = _make_game()\n435\t        player = game.players[0]\n436\t        card = Instant(name=\"Pact\", mana_cost=ManaCost())\n437\t        _add_to_hand(game, 0, card)\n438\t        # No mana added — pool is empty\n439\t\n440\t        cast_spell(game, player, card)\n441\t        assert not game.stack.is_empty()\n442\t\n443\t    def test_mana_not_deducted_on_failure(self):\n444\t        \"\"\"When casting fails (e.g. timing), mana should not be deducted.\"\"\"\n445\t        game = _make_game(phase=Phase.COMBAT, step=Step.DECLARE_ATTACKERS)\n446\t        player = game.players[0]\n447\t        sorc = Sorcery(name=\"Div\", mana_cost=ManaCost(pips={ManaType.BLUE: 1}))\n448\t        _add_to_hand(game, 0, sorc)\n449\t        _add_mana(player, ManaType.BLUE, 1)\n450\t\n451\t        with pytest.raises(CastingError):\n452\t            cast_spell(game, player, sorc)\n453\t\n454\t        # Mana should still be there since timing check fails before payment\n455\t        assert player.mana_pool.get(ManaType.BLUE) == 1\n456\t\n457\t\n458\t# ---------------------------------------------------------------------------\n459\t# cast_spell — hook callbacks\n460\t# ---------------------------------------------------------------------------\n461\t\n462\tclass TestCastSpellHooks:\n463\t    \"\"\"Requirements: on_cast called during cast; on_resolve called during resolution.\"\"\"\n464\t\n465\t    def test_on_cast_callback_is_called(self):\n466\t        on_cast_log: list[str] = []\n467\t\n468\t        class TrackedCreature(Creature):\n469\t            def on_cast(self, game: GameState) -> None:\n470\t                on_cast_log.append(\"on_cast\")\n471\t\n472\t        game = _make_game()\n473\t        player = game.players[0]\n474\t        card = TrackedCreature(\n475\t            name=\"Tracked\",\n476\t            mana_cost=ManaCost(pips={ManaType.GREEN: 1}),\n477\t            base_power=1, base_toughness=1,\n478\t        )\n479\t        _add_to_hand(game, 0, card)\n480\t        _add_mana(player, ManaType.GREEN, 1)\n481\t\n482\t        cast_spell(game, player, card)\n483\t        assert on_cast_log == [\"on_cast\"]\n484\t\n485\t    def test_on_resolve_callback_is_called(self):\n486\t        on_resolve_log: list[str] = []\n487\t\n488\t        class TrackedInstant(Instant):\n489\t            def on_resolve(self, game: GameState) -> None:\n490\t                on_resolve_log.append(\"on_resolve\")\n491\t\n492\t        game = _make_game()\n493\t        player = game.players[0]\n494\t        card = TrackedInstant(\n495\t            name=\"Tracked\", mana_cost=ManaCost(pips={ManaType.RED: 1}),\n496\t        )\n497\t        _add_to_hand(game, 0, card)\n498\t        _add_mana(player, ManaType.RED, 1)\n499\t\n500\t        cast_spell(game, player, card)\n501\t        obj = game.stack.pop()\n502\t        obj.on_resolve(game)\n503\t\n504\t        assert on_resolve_log == [\"on_resolve\"]\n505\t\n506\t    def test_on_cast_called_before_push_to_stack(self):\n507\t        \"\"\"on_cast fires during cast_spell, before the StackObject is pushed.\"\"\"\n508\t        stack_was_empty_during_on_cast: list[bool] = []\n509\t\n510\t        class InspectorCreature(Creature):\n511\t            def on_cast(self, game: GameState) -> None:\n512\t                # At on_cast time the stack should still be empty\n513\t                # (StackObject push happens after on_cast)\n514\t                stack_was_empty_during_on_cast.append(game.stack.is_empty())\n515\t\n516\t        game = _make_game()\n517\t        player = game.players[0]\n518\t        card = InspectorCreature(\n519\t            name=\"Inspector\",\n520\t            mana_cost=ManaCost(pips={ManaType.GREEN: 1}),\n521\t            base_power=1, base_toughness=1,\n522\t        )\n523\t        _add_to_hand(game, 0, card)\n524\t        _add_mana(player, ManaType.GREEN, 1)\n525\t\n526\t        cast_spell(game, player, card)\n527\t        assert stack_was_empty_during_on_cast == [True]\n528\t\n529\t    def test_on_resolve_receives_game_state(self):\n530\t        \"\"\"on_resolve receives the game state so the card can interact with it.\"\"\"\n531\t        received_game: list[GameState | None] = []\n532\t\n533\t        class InspectorSorcery(Sorcery):\n534\t            def on_resolve(self, game: GameState) -> None:\n535\t                received_game.append(game)\n536\t\n537\t        game = _make_game()\n538\t        player = game.players[0]\n539\t        card = InspectorSorcery(\n540\t            name=\"Inspector\", mana_cost=ManaCost(pips={ManaType.BLUE: 1}),\n541\t        )\n542\t        _add_to_hand(game, 0, card)\n543\t        _add_mana(player, ManaType.BLUE, 1)\n544\t\n545\t        cast_spell(game, player, card)\n546\t        obj = game.stack.pop()\n547\t        obj.on_resolve(game)\n548\t\n549\t        assert received_game == [game]\n550\t\n551\t\n552\t# ---------------------------------------------------------------------------\n553\t# cast_spell — additional legality checks\n554\t# ---------------------------------------------------------------------------\n555\t\n556\tclass TestCastSpellLegality:\n557\t    \"\"\"Miscellaneous legality checks for cast_spell.\"\"\"\n558\t\n559\t    def test_card_not_in_hand_raises(self):\n560\t        game = _make_game()\n561\t        player = game.players[0]\n562\t        bear = Creature(\n563\t            name=\"Bear\", mana_cost=ManaCost(pips={ManaType.GREEN: 1}),\n564\t            base_power=2, base_toughness=2,\n565\t        )\n566\t        _add_mana(player, ManaType.GREEN, 1)\n567\t        # Card NOT added to hand\n568\t\n569\t        with pytest.raises(CastingError, match=\"card not in hand\"):\n570\t            cast_spell(game, player, bear)\n571\t\n572\t    def test_can_cast_returns_false_raises(self):\n573\t        \"\"\"Land.can_cast always returns False; trying to cast_spell should error.\"\"\"\n574\t        game = _make_game()\n575\t        player = game.players[0]\n576\t        land = Land(name=\"Forest\")\n577\t        _add_to_hand(game, 0, land)\n578\t\n579\t        with pytest.raises(CastingError, match=\"can_cast returned False\"):\n580\t            cast_spell(game, player, land)\n581\t\n582\t    def test_hand_unchanged_on_timing_failure(self):\n583\t        \"\"\"If timing check fails, card should remain in hand.\"\"\"\n584\t        game = _make_game(phase=Phase.COMBAT, step=Step.DECLARE_ATTACKERS)\n585\t        player = game.players[0]\n586\t        bear = Creature(\n587\t            name=\"Bear\", mana_cost=ManaCost(pips={ManaType.GREEN: 1}),\n588\t            base_power=2, base_toughness=2,\n589\t        )\n590\t        _add_to_hand(game, 0, bear)\n591\t        _add_mana(player, ManaType.GREEN, 1)\n592\t\n593\t        with pytest.raises(CastingError):\n594\t            cast_spell(game, player, bear)\n595\t\n596\t        # Card should still be in hand\n597\t        assert game.get_hand(player).contains(bear)\n598\t\n599\t    def test_stack_unchanged_on_failure(self):\n600\t        \"\"\"If cast fails, nothing is added to the stack.\"\"\"\n601\t        game = _make_game()\n602\t        player = game.players[0]\n603\t        bear = Creature(\n604\t            name=\"Bear\",\n605\t            mana_cost=ManaCost(generic=5, pips={ManaType.GREEN: 1}),\n606\t            base_power=2, base_toughness=2,\n607\t        )\n608\t        _add_to_hand(game, 0, bear)\n609\t        # Insufficient mana\n610\t        _add_mana(player, ManaType.GREEN, 1)\n611\t\n612\t        with pytest.raises(CastingError):\n613\t            cast_spell(game, player, bear)\n614\t\n615\t        assert game.stack.is_empty()\n616\t\n617\t\n618\t# ---------------------------------------------------------------------------\n619\t# play_land tests\n620\t# ---------------------------------------------------------------------------\n621\t\n622\tclass TestPlayLand:\n623\t    \"\"\"Requirement: play_land moves land hand→battlefield, decrements counter.\"\"\"\n624\t\n625\t    def test_valid_land_play_moves_to_battlefield(self):\n626\t        game = _make_game()\n627\t        player = game.players[0]\n628\t        forest = Land(name=\"Forest\")\n629\t        _add_to_hand(game, 0, forest)\n630\t\n631\t        play_land(game, player, forest)\n632\t        assert game.get_battlefield(player).contains(forest)\n633\t\n634\t    def test_valid_land_play_removes_from_hand(self):\n635\t        game = _make_game()\n636\t        player = game.players[0]\n637\t        forest = Land(name=\"Forest\")\n638\t        _add_to_hand(game, 0, forest)\n639\t\n640\t        play_land(game, player, forest)\n641\t        assert not game.get_hand(player).contains(forest)\n642\t\n643\t    def test_valid_land_play_decrements_remaining(self):\n644\t        game = _make_game()\n645\t        player = game.players[0]\n646\t        forest = Land(name=\"Forest\")\n647\t        _add_to_hand(game, 0, forest)\n648\t        assert player.land_plays_remaining == 1\n649\t\n650\t        play_land(game, player, forest)\n651\t        assert player.land_plays_remaining == 0\n652\t\n653\t    def test_land_play_postcombat_main_succeeds(self):\n654\t        game = _make_game(phase=Phase.POSTCOMBAT_MAIN)\n655\t        player = game.players[0]\n656\t        island = Land(name=\"Island\")\n657\t        _add_to_hand(game, 0, island)\n658\t\n659\t        play_land(game, player, island)\n660\t        assert game.get_battlefield(player).contains(island)\n661\t\n662\t    def test_second_land_play_when_remaining_zero_raises(self):\n663\t        \"\"\"After playing one land (remaining=0), second play raises CastingError.\"\"\"\n664\t        game = _make_game()\n665\t        player = game.players[0]\n666\t        f1 = Land(name=\"Forest\")\n667\t        f2 = Land(name=\"Forest\")\n668\t        _add_to_hand(game, 0, f1)\n669\t        _add_to_hand(game, 0, f2)\n670\t\n671\t        play_land(game, player, f1)\n672\t        assert player.land_plays_remaining == 0\n673\t\n674\t        with pytest.raises(CastingError, match=\"no land plays remaining\"):\n675\t            play_land(game, player, f2)\n676\t\n677\t    def test_remaining_already_zero_raises(self):\n678\t        \"\"\"If remaining=0 from the start, playing a land raises CastingError.\"\"\"\n679\t        game = _make_game()\n680\t        player = game.players[0]\n681\t        player.land_plays_remaining = 0\n682\t        forest = Land(name=\"Forest\")\n683\t        _add_to_hand(game, 0, forest)\n684\t\n685\t        with pytest.raises(CastingError, match=\"no land plays remaining\"):\n686\t            play_land(game, player, forest)\n687\t\n688\t    def test_land_during_combat_phase_raises(self):\n689\t        \"\"\"Cannot play a land during combat — must be main phase.\"\"\"\n690\t        game = _make_game(phase=Phase.COMBAT, step=Step.DECLARE_ATTACKERS)\n691\t        player = game.players[0]\n692\t        forest = Land(name=\"Forest\")\n693\t        _add_to_hand(game, 0, forest)\n694\t\n695\t        with pytest.raises(CastingError):\n696\t            play_land(game, player, forest)\n697\t\n698\t    def test_land_during_beginning_phase_raises(self):\n699\t        \"\"\"Cannot play a land during upkeep — must be main phase.\"\"\"\n700\t        game = _make_game(phase=Phase.BEGINNING, step=Step.UPKEEP)\n701\t        player = game.players[0]\n702\t        forest = Land(name=\"Forest\")\n703\t        _add_to_hand(game, 0, forest)\n704\t\n705\t        with pytest.raises(CastingError):\n706\t            play_land(game, player, forest)\n707\t\n708\t    def test_land_by_non_active_player_raises(self):\n709\t        \"\"\"Non-active player cannot play a land.\"\"\"\n710\t        game = _make_game()\n711\t        non_active = game.players[1]\n712\t        forest = Land(name=\"Forest\")\n713\t        _add_to_hand(game, 1, forest)\n714\t\n715\t        with pytest.raises(CastingError):\n716\t            play_land(game, non_active, forest)\n717\t\n718\t    def test_land_with_nonempty_stack_raises(self):\n719\t        \"\"\"Cannot play a land when the stack is non-empty.\"\"\"\n720\t        game = _make_game()\n721\t        player = game.players[0]\n722\t        dummy = StackObject(source=None, controller=player)\n723\t        game.stack.push(dummy)\n724\t\n725\t        forest = Land(name=\"Forest\")\n726\t        _add_to_hand(game, 0, forest)\n727\t\n728\t        with pytest.raises(CastingError):\n729\t            play_land(game, player, forest)\n730\t\n731\t    def test_non_land_card_raises(self):\n732\t        \"\"\"play_land rejects a card that isn't a land.\"\"\"\n733\t        game = _make_game()\n734\t        player = game.players[0]\n735\t        creature = Creature(name=\"Bear\", base_power=2, base_toughness=2)\n736\t        _add_to_hand(game, 0, creature)\n737\t\n738\t        with pytest.raises(CastingError, match=\"not a land card\"):\n739\t            play_land(game, player, creature)\n740\t\n741\t    def test_land_not_in_hand_raises(self):\n742\t        \"\"\"Cannot play a land that's not in hand.\"\"\"\n743\t        game = _make_game()\n744\t        player = game.players[0]\n745\t        forest = Land(name=\"Forest\")\n746\t        # NOT added to hand\n747\t\n748\t        with pytest.raises(CastingError, match=\"card not in hand\"):\n749\t            play_land(game, player, forest)\n750\t\n751\t    def test_extra_land_with_increased_limit(self):\n752\t        \"\"\"If land_plays_remaining is 2 (e.g. Exploration), two lands are allowed.\"\"\"\n753\t        game = _make_game()\n754\t        player = game.players[0]\n755\t        player.land_plays_remaining = 2\n756\t        f1 = Land(name=\"Forest\")\n757\t        f2 = Land(name=\"Forest\")\n758\t        _add_to_hand(game, 0, f1)\n759\t        _add_to_hand(game, 0, f2)\n760\t\n761\t        play_land(game, player, f1)\n762\t        assert player.land_plays_remaining == 1\n763\t\n764\t        play_land(game, player, f2)\n765\t        assert player.land_plays_remaining == 0\n766\t        assert game.get_battlefield(player).contains(f1)\n767\t        assert game.get_battlefield(player).contains(f2)\n768\t\n769\t    def test_land_does_not_use_stack(self):\n770\t        \"\"\"Playing a land is a special action — it should not go through the stack.\"\"\"\n771\t        game = _make_game()\n772\t        player = game.players[0]\n773\t        forest = Land(name=\"Forest\")\n774\t        _add_to_hand(game, 0, forest)\n775\t\n776\t        play_land(game, player, forest)\n777\t        assert game.stack.is_empty()\n778\t\n779\t\n780\t# ---------------------------------------------------------------------------\n781\t# Permanent type detection\n782\t# ---------------------------------------------------------------------------\n783\t\n784\tclass TestPermanentTypes:\n785\t    \"\"\"Verify _PERMANENT_TYPES covers exactly creature, enchantment, artifact, planeswalker.\"\"\"\n786\t\n787\t    def test_creature_is_permanent(self):\n788\t        assert CardType.CREATURE in _PERMANENT_TYPES\n789\t\n790\t    def test_enchantment_is_permanent(self):\n791\t        assert CardType.ENCHANTMENT in _PERMANENT_TYPES\n792\t\n793\t    def test_artifact_is_permanent(self):\n794\t        assert CardType.ARTIFACT in _PERMANENT_TYPES\n795\t\n796\t    def test_planeswalker_is_permanent(self):\n797\t        assert CardType.PLANESWALKER in _PERMANENT_TYPES\n798\t\n799\t    def test_instant_is_not_permanent(self):\n800\t        assert CardType.INSTANT not in _PERMANENT_TYPES\n801\t\n802\t    def test_sorcery_is_not_permanent(self):\n803\t        assert CardType.SORCERY not in _PERMANENT_TYPES\n804\t\n805\t    def test_land_is_not_in_permanent_types(self):\n806\t        assert CardType.LAND not in _PERMANENT_TYPES\n807\t\n808\t\n809\t# ---------------------------------------------------------------------------\n810\t# Resolution: additional permanent subtypes\n811\t# ---------------------------------------------------------------------------\n812\t\n813\tclass TestResolveOtherPermanents:\n814\t    \"\"\"Enchantments, artifacts, planeswalkers, artifact creatures → battlefield.\"\"\"\n815\t\n816\t    def test_enchantment_resolves_to_battlefield(self):\n817\t        game = _make_game()\n818\t        player = game.players[0]\n819\t        ench = Enchantment(name=\"Pac\", mana_cost=ManaCost(pips={ManaType.WHITE: 1}))\n820\t        _add_to_hand(game, 0, ench)\n821\t        _add_mana(player, ManaType.WHITE, 1)\n822\t\n823\t        cast_spell(game, player, ench)\n824\t        obj = game.stack.pop()\n825\t        obj.on_resolve(game)\n826\t\n827\t        assert game.get_battlefield(player).contains(ench)\n828\t\n829\t    def test_artifact_resolves_to_battlefield(self):\n830\t        game = _make_game()\n831\t        player = game.players[0]\n832\t        art = Artifact(name=\"Sol Ring\", mana_cost=ManaCost(generic=1))\n833\t        _add_to_hand(game, 0, art)\n834\t        _add_mana(player, ManaType.COLORLESS, 1)\n835\t\n836\t        cast_spell(game, player, art)\n837\t        obj = game.stack.pop()\n838\t        obj.on_resolve(game)\n839\t\n840\t        assert game.get_battlefield(player).contains(art)\n841\t\n842\t    def test_planeswalker_resolves_to_battlefield(self):\n843\t        game = _make_game()\n844\t        player = game.players[0]\n845\t        pw = Planeswalker(\n846\t            name=\"Jace\",\n847\t            mana_cost=ManaCost(generic=2, pips={ManaType.BLUE: 2}),\n848\t            starting_loyalty=3,\n849\t        )\n850\t        _add_to_hand(game, 0, pw)\n851\t        _add_mana(player, ManaType.BLUE, 4)\n852\t\n853\t        cast_spell(game, player, pw)\n854\t        obj = game.stack.pop()\n855\t        obj.on_resolve(game)\n856\t\n857\t        assert game.get_battlefield(player).contains(pw)\n858\t\n859\t    def test_artifact_creature_resolves_to_battlefield(self):\n860\t        game = _make_game()\n861\t        player = game.players[0]\n862\t        ac = ArtifactCreature(\n863\t            name=\"Ornithopter\", mana_cost=ManaCost(), base_power=0, base_toughness=2,\n864\t        )\n865\t        _add_to_hand(game, 0, ac)\n866\t\n867\t        cast_spell(game, player, ac)\n868\t        obj = game.stack.pop()\n869\t        obj.on_resolve(game)\n870\t\n871\t        assert game.get_battlefield(player).contains(ac)\n872\t\n873\t\n874\t# ---------------------------------------------------------------------------\n875\t# Integration: multi-spell stack LIFO ordering\n876\t# ---------------------------------------------------------------------------\n877\t\n878\tclass TestCastResolveIntegration:\n879\t    \"\"\"End-to-end integration tests for stack interaction.\"\"\"\n880\t\n881\t    def test_multiple_spells_resolve_lifo(self):\n882\t        \"\"\"Two instants on the stack resolve in LIFO order.\"\"\"\n883\t        game = _make_game()\n884\t        player = game.players[0]\n885\t\n886\t        bolt1 = Instant(name=\"Bolt 1\", mana_cost=ManaCost(pips={ManaType.RED: 1}))\n887\t        bolt2 = Instant(name=\"Bolt 2\", mana_cost=ManaCost(pips={ManaType.RED: 1}))\n888\t        _add_to_hand(game, 0, bolt1)\n889\t        _add_to_hand(game, 0, bolt2)\n890\t        _add_mana(player, ManaType.RED, 2)\n891\t\n892\t        cast_spell(game, player, bolt1)\n893\t        cast_spell(game, player, bolt2)\n894\t\n895\t        top = game.stack.pop()\n896\t        assert top.source is bolt2\n897\t        top.on_resolve(game)\n898\t\n899\t        next_obj = game.stack.pop()\n900\t        assert next_obj.source is bolt1\n901\t        next_obj.on_resolve(game)\n902\t\n903\t        assert game.get_graveyard(player).contains(bolt1)\n904\t        assert game.get_graveyard(player).contains(bolt2)\n905\t\n906\t    def test_cast_creature_full_lifecycle(self):\n907\t        \"\"\"Full lifecycle: hand → cast → stack → resolve → battlefield.\"\"\"\n908\t        game = _make_game()\n909\t        player = game.players[0]\n910\t        bear = Creature(\n911\t            name=\"Bear\",\n912\t            mana_cost=ManaCost(generic=1, pips={ManaType.GREEN: 1}),\n913\t            base_power=2, base_toughness=2,\n914\t        )\n915\t        _add_to_hand(game, 0, bear)\n916\t        _add_mana(player, ManaType.GREEN, 2)\n917\t\n918\t        # 1. In hand\n919\t        assert game.get_hand(player).contains(bear)\n920\t        # 2. Cast\n921\t        cast_spell(game, player, bear)\n922\t        assert not game.get_hand(player).contains(bear)\n923\t        assert len(game.stack.objects()) == 1\n924\t        # 3. Resolve\n925\t        obj = game.stack.pop()\n926\t        obj.on_resolve(game)\n927\t        assert game.stack.is_empty()\n928\t        assert game.get_battlefield(player).contains(bear)\n929\t\n930\t    def test_cast_with_targets_passes_to_stack_object(self):\n931\t        \"\"\"Targets chosen during casting are stored in the StackObject.\"\"\"\n932\t\n933\t        class TargetedBolt(Instant):\n934\t            def get_targets(self, game: GameState):\n935\t                return [\"spec_a\"]\n936\t\n937\t        game = _make_game(p1_script=[\"target_creature\"])\n938\t        player = game.players[0]\n939\t        card = TargetedBolt(name=\"Bolt\", mana_cost=ManaCost(pips={ManaType.RED: 1}))\n940\t        _add_to_hand(game, 0, card)\n941\t        _add_mana(player, ManaType.RED, 1)\n942\t\n943\t        cast_spell(game, player, card)\n944\t        top = game.stack.peek()\n945\t        assert top.targets == [\"target_creature\"]\n946\t"}]},"parent_tool_use_id":"toolu_01AepSwRZkXZzkfUhV74jmjw","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"629a437a-1922-4037-acd0-45e34e579f88","timestamp":"2026-06-02T09:27:42.311Z","subagent_type":"Tester","task_description":"Write tests for sos_226"}
