{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019YYxaBLV2vrpQfsL5suzoZ","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_57/card_impl.py b/cards/sos/sos_57/card_impl.py\n2\tindex 732a555..c28cecb 100644\n3\t--- a/cards/sos/sos_57/card_impl.py\n4\t+++ b/cards/sos/sos_57/card_impl.py\n5\t@@ -2,15 +2,185 @@\n6\t \n7\t from __future__ import annotations\n8\t \n9\t-from engine.card import CardImpl\n10\t+from typing import TYPE_CHECKING, Any\n11\t \n12\t-from typing import TYPE_CHECKING\n13\t+from engine.card import Instant\n14\t+from engine.events import BeginningOfMainPhaseTriggeredEvent\n15\t+from engine.types import ManaCost, ManaType, TargetRequirement, Zone\n16\t \n17\t if TYPE_CHECKING:\n18\t     from engine.game_state import GameState\n19\t \n20\t \n21\t-class ManaSculpt(CardImpl):\n22\t-    \"\"\"TODO: Implement Mana Sculpt.\"\"\"\n23\t+def _get_chosen_target(card: Any, game: Any) -> Any:\n24\t+    \"\"\"Retrieve the first chosen target for a spell.\n25\t \n26\t-    pass\n27\t+    Looks for ``chosen_targets`` (set by :func:`cast_spell` during the\n28\t+    real casting pipeline) first, then falls back to the test-backdoor\n29\t+    attribute ``_resolve_target``.\n30\t+    \"\"\"\n31\t+    chosen = getattr(card, \"chosen_targets\", None)\n32\t+    if chosen:\n33\t+        return chosen[0]\n34\t+    return getattr(card, \"_resolve_target\", None)\n35\t+\n36\t+\n37\t+def _counter_spell(game: \"GameState\", stack_obj: Any) -> bool:\n38\t+    \"\"\"Counter a spell — remove it from the stack and move the card to\n39\t+    its owner's graveyard.\n40\t+\n41\t+    Returns ``True`` if a spell was actually countered (the stack object\n42\t+    was found on the stack), ``False`` otherwise (fizzle / illegal target).\n43\t+    \"\"\"\n44\t+    from engine.stack import StackObject\n45\t+\n46\t+    if not isinstance(stack_obj, StackObject):\n47\t+        return False\n48\t+\n49\t+    card = stack_obj.source\n50\t+\n51\t+    # Check if the stack object is actually on the stack; if not, fizzle.\n52\t+    stack_items = game.stack._items  # noqa: SLF001\n53\t+    found = False\n54\t+    for i, item in enumerate(stack_items):\n55\t+        if item is stack_obj:\n56\t+            stack_items.pop(i)\n57\t+            found = True\n58\t+            break\n59\t+\n60\t+    if not found:\n61\t+        return False\n62\t+\n63\t+    controller = stack_obj.controller\n64\t+    owner = getattr(card, \"owner\", controller)\n65\t+\n66\t+    if controller is not None:\n67\t+        stack_zone = controller.zones[Zone.STACK]\n68\t+        if stack_zone.contains(card):\n69\t+            stack_zone.remove(card)\n70\t+\n71\t+    if owner is not None:\n72\t+        graveyard = owner.zones[Zone.GRAVEYARD]\n73\t+        graveyard.add(card)\n74\t+\n75\t+    return True\n76\t+\n77\t+\n78\t+def _controls_a_wizard(game: \"GameState\", player: Any) -> bool:\n79\t+    \"\"\"True if *player* controls a Wizard on the battlefield.\"\"\"\n80\t+    if player is None:\n81\t+        return False\n82\t+    battlefield = player.zones[Zone.BATTLEFIELD]\n83\t+    for obj in battlefield.get_all():\n84\t+        if \"Wizard\" in getattr(obj, \"subtypes\", set()):\n85\t+            return True\n86\t+    return False\n87\t+\n88\t+\n89\t+def _mana_spent_to_cast(card: Any) -> int:\n90\t+    \"\"\"Amount of mana spent to cast *card*.\n91\t+\n92\t+    Uses the engine-recorded ``mana_spent`` (set in ``engine.casting`` after\n93\t+    payment) when present, falling back to the card's mana value\n94\t+    (``mana_cost.cmc``) otherwise — e.g. when a test places a spell directly\n95\t+    on the stack without paying.  For a normally-cast, no-X / non-reduced\n96\t+    spell the two are equal.\n97\t+    \"\"\"\n98\t+    recorded = getattr(card, \"mana_spent\", None)\n99\t+    if isinstance(recorded, int):\n100\t+        return recorded\n101\t+    mana_cost = getattr(card, \"mana_cost\", None)\n102\t+    if mana_cost is not None:\n103\t+        return mana_cost.cmc\n104\t+    return 0\n105\t+\n106\t+\n107\t+class ManaSculpt(Instant):\n108\t+    \"\"\"Mana Sculpt — {1}{U}{U} — Instant.\n109\t+\n110\t+    Counter target spell. If you control a Wizard, add an amount of {C}\n111\t+    equal to the amount of mana spent to cast that spell at the beginning\n112\t+    of your next main phase.\n113\t+\n114\t+    SOS collector number 57.\n115\t+    \"\"\"\n116\t+\n117\t+    def __init__(self, **kwargs: Any) -> None:\n118\t+        kwargs.setdefault(\"name\", \"Mana Sculpt\")\n119\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{U}{U}\"))\n120\t+        kwargs.setdefault(\n121\t+            \"rules_text\",\n122\t+            \"Counter target spell. If you control a Wizard, add an amount of \"\n123\t+            \"{C} equal to the amount of mana spent to cast that spell at the \"\n124\t+            \"beginning of your next main phase.\",\n125\t+        )\n126\t+        super().__init__(**kwargs)\n127\t+\n128\t+    def can_cast(self, game: \"GameState\") -> bool:\n129\t+        \"\"\"Cannot cast unless there's another spell on the stack to counter.\"\"\"\n130\t+        for stack_obj in game.stack.objects():\n131\t+            source = stack_obj.source\n132\t+            if source is self:\n133\t+                continue\n134\t+            # \"Counter target spell\" — any spell, not just creature spells.\n135\t+            if getattr(stack_obj, \"is_spell\", True):\n136\t+                return True\n137\t+        return False\n138\t+\n139\t+    def get_targets(self, game: \"GameState\") -> list[Any]:\n140\t+        \"\"\"Target any spell on the stack (other than Mana Sculpt itself).\"\"\"\n141\t+        targets: list[Any] = []\n142\t+        for stack_obj in game.stack.objects():\n143\t+            source = stack_obj.source\n144\t+            if source is self:\n145\t+                continue\n146\t+            if getattr(stack_obj, \"is_spell\", True):\n147\t+                targets.append(stack_obj)\n148\t+        if not targets:\n149\t+            return []\n150\t+        return [\n151\t+            TargetRequirement(\n152\t+                filter_fn=lambda obj: getattr(obj, \"source\", obj) is not self\n153\t+                and getattr(obj, \"is_spell\", True),\n154\t+                description=\"target spell\",\n155\t+                zone=Zone.STACK,\n156\t+            )\n157\t+        ]\n158\t+\n159\t+    def on_resolve(self, game: \"GameState\") -> None:\n160\t+        \"\"\"Counter the target spell; if you control a Wizard, set up the\n161\t+        deferred {C} for your next main phase.\"\"\"\n162\t+        target = _get_chosen_target(self, game)\n163\t+        if target is None:\n164\t+            return\n165\t+\n166\t+        countered_card = getattr(target, \"source\", None)\n167\t+        if not _counter_spell(game, target):\n168\t+            # No legal target was countered — the spell fizzles; nothing\n169\t+            # else happens (no deferred mana).\n170\t+            return\n171\t+\n172\t+        controller = self.controller\n173\t+        if controller is None:\n174\t+            return\n175\t+\n176\t+        # \"If you control a Wizard\" — evaluated as the counter resolves.\n177\t+        if not _controls_a_wizard(game, controller):\n178\t+            return\n179\t+\n180\t+        amount = _mana_spent_to_cast(countered_card)\n181\t+\n182\t+        def _add_deferred_mana(g: \"GameState\") -> None:\n183\t+            if amount > 0:\n184\t+                controller.mana_pool.add(ManaType.COLORLESS, amount)\n185\t+\n186\t+        # Delayed one-shot trigger: at the beginning of the controller's\n187\t+        # next main phase, add {C} equal to the mana spent, then remove\n188\t+        # itself (one-shot semantics handled by the trigger manager).\n189\t+        game.trigger_manager.register_delayed(\n190\t+            event_type=BeginningOfMainPhaseTriggeredEvent,\n191\t+            effect=_add_deferred_mana,\n192\t+            source=self,\n193\t+            controller=controller,\n194\t+            condition=lambda g, event: getattr(event, \"player\", None) is controller,\n195\t+        )\n196\tdiff --git a/engine/casting.py b/engine/casting.py\n197\tindex 4bf1282..2e3b5fb 100644\n198\t--- a/engine/casting.py\n199\t+++ b/engine/casting.py\n200\t@@ -167,9 +167,12 @@ def cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n201\t     hand.remove(card)\n202\t     stack_zone.add(card)\n203\t \n204\t-    # Clear any stale colors_spent from a prior cast before new payment.\n205\t+    # Clear any stale colors_spent / mana_spent from a prior cast before\n206\t+    # new payment.\n207\t     if hasattr(card, \"colors_spent\"):\n208\t         del card.colors_spent\n209\t+    if hasattr(card, \"mana_spent\"):\n210\t+        del card.mana_spent\n211\t \n212\t     # 5. Choose targets\n213\t     target_specs = card.get_targets(game)\n214\t@@ -228,6 +231,13 @@ def cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n215\t     # that care about the colors used to cast the spell.\n216\t     card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n217\t \n218\t+    # Store the TOTAL amount of mana paid for this cast for mechanics that\n219\t+    # care about the literal amount of mana spent (e.g. \"add {C} equal to\n220\t+    # the amount of mana spent to cast that spell\").  For a no-X / non-\n221\t+    # reduced cast this equals the card's mana value; with cost reductions\n222\t+    # it reflects the actual amount paid after reduction.\n223\t+    card.mana_spent = effective_cost.cmc  # type: ignore[attr-defined]\n224\t+\n225\t     # 7. Call on_cast hook\n226\t     card.on_cast(game)\n227\t \n228\tdiff --git a/engine/events.py b/engine/events.py\n229\tindex 9f38fa2..b524f7c 100644\n230\t--- a/engine/events.py\n231\t+++ b/engine/events.py\n232\t@@ -76,6 +76,20 @@ class BeginningOfCombatTriggeredEvent(TriggeredEvent):\n233\t     pass\n234\t \n235\t \n236\t+@dataclass\n237\t+class BeginningOfMainPhaseTriggeredEvent(TriggeredEvent):\n238\t+    \"\"\"Fired at the start of a main phase (pre- and post-combat).\n239\t+\n240\t+    ``player`` is the active player whose main phase is beginning.  Use\n241\t+    the ``precombat`` flag to distinguish the pre-combat main phase from\n242\t+    the post-combat one.  Triggers that care only about \"your next main\n243\t+    phase\" should check ``event.player`` against their controller.\n244\t+    \"\"\"\n245\t+\n246\t+    player: Any = None\n247\t+    precombat: bool = False\n248\t+\n249\t+\n250\t @dataclass\n251\t class EndOfTurnTriggeredEvent(TriggeredEvent):\n252\t     pass\n253\tdiff --git a/engine/triggers.py b/engine/triggers.py\n254\tindex 6e94d99..4902257 100644\n255\t--- a/engine/triggers.py\n256\t+++ b/engine/triggers.py\n257\t@@ -39,6 +39,11 @@ class TriggerRegistration:\n258\t         source: The game object (card / permanent) that owns this trigger.\n259\t         controller: The player who controls the source at the time of\n260\t             registration.\n261\t+        one_shot: When ``True`` this is a delayed trigger that fires\n262\t+            exactly once.  It is removed from the manager the first time\n263\t+            its event fires and its condition passes (see\n264\t+            :meth:`TriggerManager.fire_event`), so it will not fire again\n265\t+            on subsequent matching events.\n266\t     \"\"\"\n267\t \n268\t     event_type: type[TriggeredEvent]\n269\t@@ -46,6 +51,7 @@ class TriggerRegistration:\n270\t     effect: Callable[..., None]\n271\t     source: Any\n272\t     controller: Player\n273\t+    one_shot: bool = False\n274\t \n275\t \n276\t class TriggerManager:\n277\t@@ -74,6 +80,40 @@ class TriggerManager:\n278\t         \"\"\"Register a triggered ability.\"\"\"\n279\t         self._triggers.append(trigger)\n280\t \n281\t+    def register_delayed(\n282\t+        self,\n283\t+        event_type: type[TriggeredEvent],\n284\t+        effect: Callable[..., None],\n285\t+        source: Any,\n286\t+        controller: Player,\n287\t+        condition: Callable[..., bool] | None = None,\n288\t+    ) -> TriggerRegistration:\n289\t+        \"\"\"Register a one-shot *delayed* triggered ability.\n290\t+\n291\t+        A delayed trigger fires exactly once: the first time *event_type*\n292\t+        (or a subclass) is fired and *condition* (if any) passes, *effect*\n293\t+        is placed on the stack and the trigger is removed from the manager\n294\t+        so it will not fire again.\n295\t+\n296\t+        This is the engine hook used by effects like \"at the beginning of\n297\t+        your next main phase, ...\" — register a delayed trigger watching\n298\t+        :class:`~engine.events.BeginningOfMainPhaseTriggeredEvent` whose\n299\t+        *condition* checks that the firing player is the controller.\n300\t+\n301\t+        Returns the created :class:`TriggerRegistration` (already\n302\t+        registered) so callers can inspect / unregister it.\n303\t+        \"\"\"\n304\t+        trigger = TriggerRegistration(\n305\t+            event_type=event_type,\n306\t+            condition=condition,\n307\t+            effect=effect,\n308\t+            source=source,\n309\t+            controller=controller,\n310\t+            one_shot=True,\n311\t+        )\n312\t+        self._triggers.append(trigger)\n313\t+        return trigger\n314\t+\n315\t     def unregister(self, source: Any) -> None:\n316\t         \"\"\"Remove all triggers registered by *source* (identity-based).\"\"\"\n317\t         self._triggers = [t for t in self._triggers if t.source is not source]\n318\t@@ -103,6 +143,13 @@ class TriggerManager:\n319\t         if not matching:\n320\t             return\n321\t \n322\t+        # One-shot (delayed) triggers fire exactly once: remove them from\n323\t+        # the registry now that they have matched, so a later matching event\n324\t+        # does not fire them again.\n325\t+        one_shot_fired = [t for t in matching if t.one_shot]\n326\t+        if one_shot_fired:\n327\t+            self._triggers = [t for t in self._triggers if t not in one_shot_fired]\n328\t+\n329\t         active_player = game.active_player\n330\t         active_triggers: list[TriggerRegistration] = []\n331\t         non_active_triggers: list[TriggerRegistration] = []\n332\tdiff --git a/engine/turn.py b/engine/turn.py\n333\tindex e400349..1572201 100644\n334\t--- a/engine/turn.py\n335\t+++ b/engine/turn.py\n336\t@@ -204,6 +204,15 @@ def run_turn(game: GameState) -> None:\n337\t             game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n338\t         elif current == (Phase.BEGINNING, Step.DRAW):\n339\t             _do_draw_step(game)\n340\t+        elif game.phase in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN) and game.step is None:\n341\t+            from engine.events import BeginningOfMainPhaseTriggeredEvent\n342\t+            game.trigger_manager.fire_event(\n343\t+                game,\n344\t+                BeginningOfMainPhaseTriggeredEvent(\n345\t+                    player=game.active_player,\n346\t+                    precombat=(game.phase == Phase.PRECOMBAT_MAIN),\n347\t+                ),\n348\t+            )\n349\t         elif game.phase == Phase.COMBAT and game.step is not None:\n350\t             _do_combat_step(game, game.step)\n351\t         elif current == (Phase.ENDING, Step.CLEANUP):\n352\t"}]},"parent_tool_use_id":"toolu_012WJm16sHZxbzFpVsTzGbaS","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"94f0ad3a-e752-4cb9-bac6-ef58d940adc8","timestamp":"2026-06-02T08:29:24.608Z","subagent_type":"Reviewer","task_description":"Review sos_57 implementation"}
