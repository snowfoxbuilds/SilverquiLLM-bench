{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017ybzbdwxEgYBkyfQ61WFF2","type":"tool_result","content":"1\t\"\"\"Tests for SOS 226 — Silverquill, the Disputant.\n2\t\n3\tOracle text (from card_spec.json):\n4\t\n5\t    Flying, vigilance\n6\t    Each instant and sorcery spell you cast has casualty 1. (As you cast that\n7\t    spell, you may sacrifice a creature with power 1 or greater. When you do,\n8\t    copy the spell and you may choose new targets for the copy.)\n9\t\n10\tBehaviour contract derived from that text:\n11\t\n12\t* Static: Legendary Creature — Elder Dragon, {2}{W}{B}, 4/4, black+white, with\n13\t  Flying and Vigilance.\n14\t* Casualty-granting static ability: while Silverquill is on the battlefield,\n15\t  every instant and sorcery SPELL its controller casts \"has casualty 1\"\n16\t  (CR 702.153). Casualty 1 means: as an additional cost you MAY sacrifice a\n17\t  creature with power 1 or greater; when you do, copy the spell and may choose\n18\t  new targets for the copy.\n19\t\n20\t  There is no engine-level casualty pipeline, so the implementation must expose\n21\t  some observable surface that reports the casualty value (1) for an\n22\t  instant/sorcery the controller casts (and grants it to no other card types /\n23\t  no other players). These tests probe that surface TOLERANTLY: they accept any\n24\t  of the conventional spellings the implementer is likely to use (a query method\n25\t  on the Silverquill card and/or an attribute written onto the affected spell),\n26\t  and skip-with-reason only if NO recognised surface exists (so the contract is\n27\t  never silently green).\n28\t\n29\t  The copy/sacrifice RESOLUTION mechanic (paying the casualty cost by\n30\t  sacrificing a power>=1 creature, then producing a copy with optional new\n31\t  targets) is recorded in untestable.json: no engine casualty pipeline exists to\n32\t  assert it against yet.\n33\t\n34\tThese tests are written for the TDD red phase: they must FAIL against the empty\n35\tstub and PASS once the card is implemented correctly.\n36\t\"\"\"\n37\t\n38\tfrom __future__ import annotations\n39\t\n40\tfrom typing import Any\n41\t\n42\timport pytest\n43\t\n44\tfrom cards.sos.sos_226.card_impl import SilverquillTheDisputant\n45\tfrom engine.card import Creature, Instant, Sorcery\n46\tfrom engine.events import SpellCastTriggeredEvent\n47\tfrom engine.stack import StackObject\n48\tfrom engine.types import Color, Keyword, ManaCost, ManaType, Supertype, Zone\n49\tfrom test_utils import create_game, set_board_state\n50\t\n51\t\n52\t# ---------------------------------------------------------------------------\n53\t# Test helper cards\n54\t# ---------------------------------------------------------------------------\n55\t\n56\t\n57\tdef _vanilla_instant(name: str = \"Test Instant\") -> Instant:\n58\t    return Instant(name=name, mana_cost=ManaCost.parse(\"{1}{R}\"))\n59\t\n60\t\n61\tdef _vanilla_sorcery(name: str = \"Test Sorcery\") -> Sorcery:\n62\t    return Sorcery(name=name, mana_cost=ManaCost.parse(\"{2}{G}\"))\n63\t\n64\t\n65\tdef _vanilla_creature(name: str = \"Test Bear\") -> Creature:\n66\t    return Creature(\n67\t        name=name,\n68\t        mana_cost=ManaCost.parse(\"{1}{G}\"),\n69\t        base_power=2,\n70\t        base_toughness=2,\n71\t    )\n72\t\n73\t\n74\tdef _casualty_value_for(card_obj: Any, game: Any, spell: Any) -> Any:\n75\t    \"\"\"Best-effort probe for the granted casualty value of *spell*.\n76\t\n77\t    The casualty mechanic has no engine pipeline, so the implementation is free\n78\t    to surface the grant in a number of conventional ways. This helper tries\n79\t    each in turn and returns the reported value, or raises ``pytest.skip`` if no\n80\t    recognised surface exists (so the contract is not silently green).\n81\t    \"\"\"\n82\t    # 1. A method on the Silverquill card that reports the casualty value it\n83\t    #    grants to a given spell.\n84\t    for meth_name in (\n85\t        \"casualty_value_for\",\n86\t        \"get_casualty_value\",\n87\t        \"casualty_for\",\n88\t        \"get_casualty\",\n89\t        \"casualty_value\",\n90\t    ):\n91\t        meth = getattr(card_obj, meth_name, None)\n92\t        if callable(meth):\n93\t            try:\n94\t                return meth(game, spell)\n95\t            except TypeError:\n96\t                try:\n97\t                    return meth(spell)\n98\t                except TypeError:\n99\t                    continue\n100\t    # 2. The grant written directly onto the spell.\n101\t    for attr_name in (\"casualty_value\", \"casualty\", \"granted_casualty\"):\n102\t        val = getattr(spell, attr_name, None)\n103\t        if val is not None:\n104\t            return val\n105\t    pytest.skip(\n106\t        \"No observable surface for the granted casualty value — implementation \"\n107\t        \"must expose casualty_value_for(...)/get_casualty_value(...) on the \"\n108\t        \"card or a casualty_value attribute on the affected spell.\"\n109\t    )\n110\t\n111\t\n112\tdef _probe_casualty_silent(card_obj: Any, game: Any, spell: Any) -> Any:\n113\t    \"\"\"Like ``_casualty_value_for`` but returns None instead of skipping when no\n114\t    recognised surface reports a value for *spell* (used for the exclusion-side\n115\t    assertions, anchored on a positive case so the test is never vacuous).\"\"\"\n116\t    for meth_name in (\n117\t        \"casualty_value_for\",\n118\t        \"get_casualty_value\",\n119\t        \"casualty_for\",\n120\t        \"get_casualty\",\n121\t        \"casualty_value\",\n122\t    ):\n123\t        meth = getattr(card_obj, meth_name, None)\n124\t        if callable(meth):\n125\t            try:\n126\t                return meth(game, spell)\n127\t            except TypeError:\n128\t                try:\n129\t                    return meth(spell)\n130\t                except TypeError:\n131\t                    continue\n132\t    for attr_name in (\"casualty_value\", \"casualty\", \"granted_casualty\"):\n133\t        val = getattr(spell, attr_name, None)\n134\t        if val is not None:\n135\t            return val\n136\t    return None\n137\t\n138\t\n139\tdef _coerce_to_one(value: Any) -> bool:\n140\t    \"\"\"Return True if *value* represents casualty N == 1.\n141\t\n142\t    Accepts an int (1), a bool True coerced via int, a string spelling like\n143\t    \"1\" or \"casualty 1\", or anything exposing ``.cmc``/``.value``/``.n`` == 1.\n144\t    \"\"\"\n145\t    if value is None or value is False:\n146\t        return False\n147\t    if value is True:\n148\t        # A bare True flag means \"has casualty\" but does not encode N; treat as\n149\t        # NOT a confirmation of the specific value 1.\n150\t        return False\n151\t    if isinstance(value, int):\n152\t        return value == 1\n153\t    if isinstance(value, str):\n154\t        digits = \"\".join(ch for ch in value if ch.isdigit())\n155\t        return digits == \"1\"\n156\t    for attr in (\"value\", \"n\", \"amount\", \"cmc\"):\n157\t        v = getattr(value, attr, None)\n158\t        if isinstance(v, int):\n159\t            return v == 1\n160\t    return False\n161\t\n162\t\n163\t# ---------------------------------------------------------------------------\n164\t# Static card data\n165\t# ---------------------------------------------------------------------------\n166\t\n167\t\n168\tclass TestSilverquillProperties:\n169\t    \"\"\"Static characteristics must match the SOS 226 spec.\"\"\"\n170\t\n171\t    def test_is_creature(self) -> None:\n172\t        assert isinstance(SilverquillTheDisputant(owner=None), Creature)\n173\t\n174\t    def test_name(self) -> None:\n175\t        assert SilverquillTheDisputant(owner=None).name == \"Silverquill, the Disputant\"\n176\t\n177\t    def test_mana_cost(self) -> None:\n178\t        assert SilverquillTheDisputant(owner=None).mana_cost == ManaCost.parse(\"{2}{W}{B}\")\n179\t\n180\t    def test_mana_value_is_four(self) -> None:\n181\t        assert SilverquillTheDisputant(owner=None).mana_cost.cmc == 4\n182\t\n183\t    def test_power_toughness(self) -> None:\n184\t        card = SilverquillTheDisputant(owner=None)\n185\t        assert card.base_power == 4\n186\t        assert card.base_toughness == 4\n187\t\n188\t    def test_is_legendary(self) -> None:\n189\t        assert Supertype.LEGENDARY in SilverquillTheDisputant(owner=None).supertypes\n190\t\n191\t    def test_is_elder_dragon(self) -> None:\n192\t        subtypes = SilverquillTheDisputant(owner=None).subtypes\n193\t        assert \"Dragon\" in subtypes\n194\t        assert \"Elder\" in subtypes\n195\t\n196\t    def test_has_flying(self) -> None:\n197\t        assert Keyword.FLYING in SilverquillTheDisputant(owner=None).keywords\n198\t\n199\t    def test_has_vigilance(self) -> None:\n200\t        assert Keyword.VIGILANCE in SilverquillTheDisputant(owner=None).keywords\n201\t\n202\t    def test_is_white_black(self) -> None:\n203\t        \"\"\"{2}{W}{B} has exactly one white and one black pip and no others.\"\"\"\n204\t        cost = SilverquillTheDisputant(owner=None).mana_cost\n205\t        assert cost.pips.get(ManaType.WHITE, 0) == 1\n206\t        assert cost.pips.get(ManaType.BLACK, 0) == 1\n207\t        assert cost.pips.get(ManaType.RED, 0) == 0\n208\t        assert cost.pips.get(ManaType.BLUE, 0) == 0\n209\t        assert cost.pips.get(ManaType.GREEN, 0) == 0\n210\t\n211\t    def test_colors_are_black_and_white(self) -> None:\n212\t        \"\"\"If the implementation exposes a ``colors`` surface it must be exactly\n213\t        {B, W}. If it does not, the pip-based ``test_is_white_black`` above\n214\t        already pins the colours, so this is skipped rather than failing.\"\"\"\n215\t        card = SilverquillTheDisputant(owner=None)\n216\t        colors = getattr(card, \"colors\", None)\n217\t        if not colors:\n218\t            pytest.skip(\"no explicit colors attribute; pip test covers colours\")\n219\t        color_set = set(colors)\n220\t        assert color_set == {Color.WHITE, Color.BLACK}\n221\t\n222\t    def test_casualty_is_printed_keyword_label_not_enum(self) -> None:\n223\t        \"\"\"'Casualty' is a printed-keyword label (the Keyword enum is frozen at\n224\t        16 evergreen members), so it must NOT appear as a Keyword enum member.\n225\t        If the implementation records printed labels, \"Casualty\" should be among\n226\t        them; if it exposes no such surface this is skipped (the grant-surface\n227\t        tests below are the real contract).\"\"\"\n228\t        card = SilverquillTheDisputant(owner=None)\n229\t        # Casualty must not have been smuggled into the evergreen Keyword enum.\n230\t        assert not hasattr(Keyword, \"CASUALTY\")\n231\t        labels = getattr(card, \"printed_keywords\", None)\n232\t        if labels is None:\n233\t            pytest.skip(\"no printed_keywords surface to assert the Casualty label\")\n234\t        assert any(\"casualty\" in str(label).lower() for label in labels)\n235\t\n236\t\n237\t# ---------------------------------------------------------------------------\n238\t# Casualty-granting static ability — queryable / observable grant surface\n239\t# ---------------------------------------------------------------------------\n240\t\n241\t\n242\tclass TestSilverquillCasualtyGrant:\n243\t    \"\"\"While on the battlefield, Silverquill grants casualty 1 to each instant\n244\t    and sorcery SPELL its controller casts.\"\"\"\n245\t\n246\t    def _setup(\n247\t        self,\n248\t        controller_spells: list[Any],\n249\t        opp_spells: list[Any] | None = None,\n250\t        *,\n251\t        on_battlefield: bool = True,\n252\t    ):\n253\t        game = create_game()\n254\t        p1 = game.players[0]\n255\t        p2 = game.players[1]\n256\t        card = SilverquillTheDisputant(owner=p1, controller=p1)\n257\t        if on_battlefield:\n258\t            set_board_state(game, 0, battlefield=[card], hand=controller_spells)\n259\t        else:\n260\t            # Silverquill in hand, not on the battlefield: the grant must be off.\n261\t            set_board_state(game, 0, hand=[card] + controller_spells)\n262\t        if opp_spells is not None:\n263\t            set_board_state(game, 1, hand=opp_spells)\n264\t        # Apply continuous effects if the engine maintains them, so a\n265\t        # layer-based implementation has a chance to write its grant.\n266\t        if hasattr(game, \"effect_manager\"):\n267\t            try:\n268\t                card.register_replacement_effects(game)\n269\t                card.register_triggers(game)\n270\t            except Exception:\n271\t                pass\n272\t            try:\n273\t                game.effect_manager.apply_all(game)\n274\t            except Exception:\n275\t                pass\n276\t        return game, p1, p2, card\n277\t\n278\t    def test_instant_gets_casualty_one(self) -> None:\n279\t        spell = _vanilla_instant(\"My Bolt\")\n280\t        game, p1, p2, card = self._setup([spell])\n281\t        value = _casualty_value_for(card, game, spell)\n282\t        assert _coerce_to_one(value)\n283\t\n284\t    def test_sorcery_gets_casualty_one(self) -> None:\n285\t        spell = _vanilla_sorcery(\"My Ritual\")\n286\t        game, p1, p2, card = self._setup([spell])\n287\t        value = _casualty_value_for(card, game, spell)\n288\t        assert _coerce_to_one(value)\n289\t\n290\t    def test_creature_spell_does_not_get_casualty(self) -> None:\n291\t        \"\"\"Casualty is granted only to instant/sorcery spells. A creature spell\n292\t        is neither, so it must not be granted casualty. We anchor on a real\n293\t        instant first (via the probe, which skips if no surface exists) so this\n294\t        fails on an empty stub rather than passing vacuously.\"\"\"\n295\t        anchor = _vanilla_instant(\"Anchor Bolt\")\n296\t        bear = _vanilla_creature(\"Hand Bear\")\n297\t        game, p1, p2, card = self._setup([anchor, bear])\n298\t        # Anchor: confirm the grant surface exists and reports 1 for the instant.\n299\t        assert _coerce_to_one(_casualty_value_for(card, game, anchor))\n300\t        # The creature spell must NOT be granted casualty 1.\n301\t        assert not _coerce_to_one(_probe_casualty_silent(card, game, bear))\n302\t\n303\t    def test_opponents_instant_does_not_get_casualty(self) -> None:\n304\t        \"\"\"Only spells YOU cast get casualty — an opponent's instant is\n305\t        unaffected. Anchored on a controller-side instant so the test fails on\n306\t        an empty stub rather than passing vacuously.\"\"\"\n307\t        my_spell = _vanilla_instant(\"My Instant\")\n308\t        opp_spell = _vanilla_instant(\"Opp Instant\")\n309\t        game, p1, p2, card = self._setup([my_spell], opp_spells=[opp_spell])\n310\t        # Anchor: my own instant gets casualty 1 (skips if no surface exists).\n311\t        assert _coerce_to_one(_casualty_value_for(card, game, my_spell))\n312\t        # The opponent's instant must NOT be granted casualty.\n313\t        assert not _coerce_to_one(_probe_casualty_silent(card, game, opp_spell))\n314\t\n315\t    def test_no_grant_while_off_battlefield(self) -> None:\n316\t        \"\"\"A static ability of a permanent functions only while that permanent\n317\t        is on the battlefield (CR 113.6 / 604.x). With Silverquill in hand (not\n318\t        on the battlefield), an instant must NOT be granted casualty.\n319\t\n320\t        This anchors on the positive case from ``test_instant_gets_casualty_one``\n321\t        (which skips if no surface exists), so a stub that always returns a value\n322\t        is caught, while genuinely-absent surfaces skip rather than pass.\"\"\"\n323\t        # Positive anchor: a parallel on-battlefield setup must grant casualty.\n324\t        anchor_spell = _vanilla_instant(\"Anchor While On Field\")\n325\t        a_game, _, _, a_card = self._setup([anchor_spell])\n326\t        assert _coerce_to_one(_casualty_value_for(a_card, a_game, anchor_spell))\n327\t\n328\t        # Now Silverquill is in hand, not on the battlefield: no grant.\n329\t        spell = _vanilla_instant(\"Off Field Instant\")\n330\t        game, p1, p2, card = self._setup([spell], on_battlefield=False)\n331\t        assert not _coerce_to_one(_probe_casualty_silent(card, game, spell))\n332\t\n333\t\n334\t# ---------------------------------------------------------------------------\n335\t# Casualty grant wiring — the card must install its continuous grant\n336\t# ---------------------------------------------------------------------------\n337\t\n338\t\n339\tclass TestSilverquillGrantWiring:\n340\t    \"\"\"The casualty grant is a continuous static ability, so the card must wire\n341\t    it through one of the engine's continuous/effect/trigger hooks rather than\n342\t    doing nothing. We assert the card actually installs something observable.\"\"\"\n343\t\n344\t    def test_card_exposes_a_casualty_grant_surface(self) -> None:\n345\t        \"\"\"The implementation must expose at least one recognised casualty-grant\n346\t        surface (a query method on the card, or an attribute it writes onto an\n347\t        affected spell). An empty stub exposes none and fails here.\"\"\"\n348\t        game = create_game()\n349\t        p1 = game.players[0]\n350\t        card = SilverquillTheDisputant(owner=p1, controller=p1)\n351\t        spell = _vanilla_instant(\"Probe Instant\")\n352\t        set_board_state(game, 0, battlefield=[card], hand=[spell])\n353\t        if hasattr(game, \"effect_manager\"):\n354\t            try:\n355\t                card.register_replacement_effects(game)\n356\t                card.register_triggers(game)\n357\t                game.effect_manager.apply_all(game)\n358\t            except Exception:\n359\t                pass\n360\t\n361\t        has_method = any(\n362\t            callable(getattr(card, m, None))\n363\t            for m in (\n364\t                \"casualty_value_for\",\n365\t                \"get_casualty_value\",\n366\t                \"casualty_for\",\n367\t                \"get_casualty\",\n368\t                \"casualty_value\",\n369\t            )\n370\t        )\n371\t        has_attr = any(\n372\t            getattr(spell, a, None) is not None\n373\t            for a in (\"casualty_value\", \"casualty\", \"granted_casualty\")\n374\t        )\n375\t        assert has_method or has_attr, (\n376\t            \"Silverquill must expose an observable casualty-grant surface \"\n377\t            \"(a query method on the card or an attribute on the affected spell).\"\n378\t        )\n379\t\n380\t\n381\t# ===========================================================================\n382\t# Extended coverage — casualty RESOLUTION mechanic (CR 702.153a/c)\n383\t#\n384\t# These tests were previously deferred to untestable.json (no engine casualty\n385\t# pipeline). The Implementer has since built the additive engine.casualty\n386\t# framework and wired it into the card, so the three deferred requirements are\n387\t# now testable as REAL passing tests:\n388\t#\n389\t#   1. Pay-by-sacrifice records the payment and moves the creature to the GY.\n390\t#   2. The power>=1 legality boundary (power 0 illegal, power 1 legal).\n391\t#   3. Copy-on-payment puts a copy on the stack with optional new targets.\n392\t#   4. Declining is a clean no-op (no sacrifice, no copy).\n393\t#   5. Scope: opponents' / creature spells get no casualty offer.\n394\t#\n395\t# The framework API (confirmed in engine/casualty.py and impl-rationale.md):\n396\t#   is_legal_casualty_sacrifice(creature, value) -> bool\n397\t#   legal_casualty_sacrifices(game, player, value) -> list\n398\t#   pay_casualty(game, player, spell, creature, value=None) -> bool\n399\t#   was_casualty_paid(spell) -> bool        # reads spell.casualty_paid\n400\t#   copy_spell_on_casualty(game, player, spell, new_targets=None) -> StackObject|None\n401\t#   offer_casualty(game, player, spell, value=None) -> StackObject|None\n402\t#   set_casualty_value(card, value) / get_casualty_value(card)\n403\t# ===========================================================================\n404\t\n405\t\n406\tdef _power_creature(name: str, power: int, toughness: int = 1) -> Creature:\n407\t    \"\"\"A creature with an explicit printed power (for the legality boundary).\"\"\"\n408\t    return Creature(\n409\t        name=name,\n410\t        mana_cost=ManaCost.parse(\"{1}{R}\"),\n411\t        base_power=power,\n412\t        base_toughness=toughness,\n413\t    )\n414\t\n415\t\n416\tdef _put_spell_on_stack(game: Any, player: Any, spell: Any, targets: list[Any] | None = None) -> StackObject:\n417\t    \"\"\"Push *spell* onto the stack as a StackObject under *player*'s control.\n418\t\n419\t    ``copy_spell_on_casualty`` locates the original on the stack by identity\n420\t    (``so.source is spell``), so the casualty copy needs the spell to be a live\n421\t    stack object. ``set_board_state`` only fills zones, so this models the\n422\t    \"spell on the stack\" state directly.\n423\t    \"\"\"\n424\t    spell.controller = player\n425\t    spell.owner = player\n426\t    stack_obj = StackObject(source=spell, controller=player, targets=list(targets or []))\n427\t    game.stack.push(stack_obj)\n428\t    return stack_obj\n429\t\n430\t\n431\tdef _grant_value_on(spell: Any) -> int:\n432\t    \"\"\"Set casualty 1 on *spell* via the framework and return the value.\"\"\"\n433\t    from engine.casualty import CASUALTY_ONE, set_casualty_value\n434\t\n435\t    set_casualty_value(spell, CASUALTY_ONE)\n436\t    return CASUALTY_ONE\n437\t\n438\t\n439\tclass TestCasualtyPayBySacrifice:\n440\t    \"\"\"CR 702.153a — paying casualty sacrifices a power>=1 creature and records\n441\t    the payment on the spell.\"\"\"\n442\t\n443\t    def test_pay_casualty_sacrifices_creature_to_graveyard(self) -> None:\n444\t        \"\"\"Paying casualty by sacrificing a power>=1 creature moves it from the\n445\t        battlefield to the owner's graveyard.\"\"\"\n446\t        from engine.casualty import pay_casualty\n447\t\n448\t        game = create_game()\n449\t        p1 = game.players[0]\n450\t        bear = _power_creature(\"Sac Bear\", power=2)\n451\t        spell = _vanilla_instant(\"Paid Bolt\")\n452\t        set_board_state(game, 0, battlefield=[bear])\n453\t        _put_spell_on_stack(game, p1, spell)\n454\t        _grant_value_on(spell)\n455\t\n456\t        paid = pay_casualty(game, p1, spell, bear)\n457\t\n458\t        assert paid is True\n459\t        assert not game.get_battlefield(p1).contains(bear), (\n460\t            \"the sacrificed creature must leave the battlefield\"\n461\t        )\n462\t        assert game.get_graveyard(p1).contains(bear), (\n463\t            \"the sacrificed creature must be put into its owner's graveyard\"\n464\t        )\n465\t\n466\t    def test_pay_casualty_records_payment_on_spell(self) -> None:\n467\t        \"\"\"A paid casualty cost is recorded so the copy trigger can observe it\n468\t        (``spell.casualty_paid == True`` / ``was_casualty_paid``).\"\"\"\n469\t        from engine.casualty import pay_casualty, was_casualty_paid\n470\t\n471\t        game = create_game()\n472\t        p1 = game.players[0]\n473\t        bear = _power_creature(\"Sac Bear\", power=2)\n474\t        spell = _vanilla_instant(\"Recorded Bolt\")\n475\t        set_board_state(game, 0, battlefield=[bear])\n476\t        _put_spell_on_stack(game, p1, spell)\n477\t        _grant_value_on(spell)\n478\t\n479\t        # Before payment, nothing is recorded.\n480\t        assert was_casualty_paid(spell) is False\n481\t        assert getattr(spell, \"casualty_paid\", False) is False\n482\t\n483\t        pay_casualty(game, p1, spell, bear)\n484\t\n485\t        assert was_casualty_paid(spell) is True\n486\t        assert spell.casualty_paid is True\n487\t\n488\t    def test_pay_casualty_rejects_creature_not_controlled(self) -> None:\n489\t        \"\"\"A creature the caster does not control is not a legal casualty\n490\t        sacrifice: nothing is sacrificed and no payment is recorded.\"\"\"\n491\t        from engine.casualty import pay_casualty, was_casualty_paid\n492\t\n493\t        game = create_game()\n494\t        p1 = game.players[0]\n495\t        p2 = game.players[1]\n496\t        opp_bear = _power_creature(\"Their Bear\", power=3)\n497\t        spell = _vanilla_instant(\"Bad Bolt\")\n498\t        set_board_state(game, 0, battlefield=[])\n499\t        set_board_state(game, 1, battlefield=[opp_bear])\n500\t        _put_spell_on_stack(game, p1, spell)\n501\t        _grant_value_on(spell)\n502\t\n503\t        paid = pay_casualty(game, p1, spell, opp_bear)\n504\t\n505\t        assert paid is False\n506\t        assert game.get_battlefield(p2).contains(opp_bear), (\n507\t            \"an opponent's creature must not be sacrificed by the caster's casualty\"\n508\t        )\n509\t        assert was_casualty_paid(spell) is False\n510\t\n511\t\n512\tclass TestCasualtyPowerThreshold:\n513\t    \"\"\"CR 702.153a — the casualty 1 legality boundary: power 0 is illegal, power\n514\t    1 (or greater) is legal.\"\"\"\n515\t\n516\t    def test_power_zero_creature_is_not_a_legal_sacrifice(self) -> None:\n517\t        from engine.casualty import is_legal_casualty_sacrifice\n518\t\n519\t        wall = _power_creature(\"Power Zero Wall\", power=0, toughness=4)\n520\t        assert is_legal_casualty_sacrifice(wall, 1) is False\n521\t\n522\t    def test_power_one_creature_is_a_legal_sacrifice(self) -> None:\n523\t        from engine.casualty import is_legal_casualty_sacrifice\n524\t\n525\t        goblin = _power_creature(\"Power One Goblin\", power=1)\n526\t        assert is_legal_casualty_sacrifice(goblin, 1) is True\n527\t\n528\t    def test_higher_power_creature_is_a_legal_sacrifice(self) -> None:\n529\t        \"\"\"Power strictly greater than the threshold is also legal (>= boundary).\"\"\"\n530\t        from engine.casualty import is_legal_casualty_sacrifice\n531\t\n532\t        ogre = _power_creature(\"Big Ogre\", power=5)\n533\t        assert is_legal_casualty_sacrifice(ogre, 1) is True\n534\t\n535\t    def test_legal_candidate_set_excludes_power_zero_includes_power_one(self) -> None:\n536\t        \"\"\"The observable candidate set for casualty 1 excludes a power-0 creature\n537\t        and includes a power-1 creature controlled by the caster.\"\"\"\n538\t        from engine.casualty import legal_casualty_sacrifices\n539\t\n540\t        game = create_game()\n541\t        p1 = game.players[0]\n542\t        wall = _power_creature(\"Boundary Wall\", power=0, toughness=4)\n543\t        goblin = _power_creature(\"Boundary Goblin\", power=1)\n544\t        set_board_state(game, 0, battlefield=[wall, goblin])\n545\t\n546\t        candidates = legal_casualty_sacrifices(game, p1, 1)\n547\t\n548\t        assert goblin in candidates, \"a power-1 creature is a legal casualty 1 sacrifice\"\n549\t        assert wall not in candidates, \"a power-0 creature is NOT a legal casualty 1 sacrifice\"\n550\t\n551\t    def test_pay_casualty_with_power_zero_creature_fails(self) -> None:\n552\t        \"\"\"Trying to pay casualty 1 with a power-0 creature is rejected: no\n553\t        sacrifice, no recorded payment (the boundary enforced at payment time).\"\"\"\n554\t        from engine.casualty import pay_casualty, was_casualty_paid\n555\t\n556\t        game = create_game()\n557\t        p1 = game.players[0]\n558\t        wall = _power_creature(\"Pay Wall Zero\", power=0, toughness=4)\n559\t        spell = _vanilla_instant(\"Boundary Bolt\")\n560\t        set_board_state(game, 0, battlefield=[wall])\n561\t        _put_spell_on_stack(game, p1, spell)\n562\t        _grant_value_on(spell)\n563\t\n564\t        paid = pay_casualty(game, p1, spell, wall)\n565\t\n566\t        assert paid is False\n567\t        assert game.get_battlefield(p1).contains(wall), (\n568\t            \"a power-0 creature must not be sacrificed for casualty 1\"\n569\t        )\n570\t        assert was_casualty_paid(spell) is False\n571\t\n572\t\n573\tclass TestCasualtyCopyOnPayment:\n574\t    \"\"\"CR 702.153c — when the casualty cost is paid, a copy of the spell is put\n575\t    onto the stack under the caster's control, with optional new targets.\"\"\"\n576\t\n577\t    def test_copy_is_put_on_the_stack_under_controller_control(self) -> None:\n578\t        from engine.casualty import copy_spell_on_casualty, pay_casualty\n579\t\n580\t        game = create_game()\n581\t        p1 = game.players[0]\n582\t        bear = _power_creature(\"Copy Bear\", power=2)\n583\t        spell = _vanilla_instant(\"Copied Bolt\")\n584\t        set_board_state(game, 0, battlefield=[bear])\n585\t        original = _put_spell_on_stack(game, p1, spell)\n586\t        _grant_value_on(spell)\n587\t        pay_casualty(game, p1, spell, bear)\n588\t\n589\t        stack_before = len(game.stack)\n590\t        copy_obj = copy_spell_on_casualty(game, p1, spell)\n591\t\n592\t        assert copy_obj is not None, \"paying casualty must produce a copy\"\n593\t        assert len(game.stack) == stack_before + 1, (\n594\t            \"the copy must be put onto the stack in addition to the original\"\n595\t        )\n596\t        assert game.stack.peek() is copy_obj, \"the copy is the top of the stack\"\n597\t        assert copy_obj.controller is p1, \"the copy is controlled by the caster\"\n598\t        assert copy_obj.source is not spell, (\n599\t            \"the copy is a distinct object, not the original spell\"\n600\t        )\n601\t        assert getattr(copy_obj.source, \"name\", None) == spell.name, (\n602\t            \"the copy shares the original's identity (same name)\"\n603\t        )\n604\t        # The original spell remains its own stack object.\n605\t        assert original.source is spell\n606\t\n607\t    def test_copy_may_take_new_targets(self) -> None:\n608\t        \"\"\"The caster may choose new targets for the copy; the original spell's\n609\t        targets are unchanged (independent state).\"\"\"\n610\t        from engine.casualty import copy_spell_on_casualty, pay_casualty\n611\t\n612\t        game = create_game()\n613\t        p1 = game.players[0]\n614\t        p2 = game.players[1]\n615\t        bear = _power_creature(\"Retarget Bear\", power=2)\n616\t        spell = _vanilla_instant(\"Retarget Bolt\")\n617\t        set_board_state(game, 0, battlefield=[bear])\n618\t        original = _put_spell_on_stack(game, p1, spell, targets=[p2])\n619\t        _grant_value_on(spell)\n620\t        pay_casualty(game, p1, spell, bear)\n621\t\n622\t        copy_obj = copy_spell_on_casualty(game, p1, spell, new_targets=[p1])\n623\t\n624\t        assert copy_obj is not None\n625\t        assert copy_obj.targets == [p1], \"the copy uses the chosen new targets\"\n626\t        assert original.targets == [p2], (\n627\t            \"choosing new targets for the copy must not mutate the original's targets\"\n628\t        )\n629\t\n630\t    def test_copy_defaults_to_original_targets_when_not_retargeted(self) -> None:\n631\t        \"\"\"Declining to choose new targets keeps the original targets on the copy\n632\t        (CR 702.153a: 'you MAY choose new targets').\"\"\"\n633\t        from engine.casualty import copy_spell_on_casualty, pay_casualty\n634\t\n635\t        game = create_game()\n636\t        p1 = game.players[0]\n637\t        p2 = game.players[1]\n638\t        bear = _power_creature(\"Keep Bear\", power=2)\n639\t        spell = _vanilla_instant(\"Keep Bolt\")\n640\t        set_board_state(game, 0, battlefield=[bear])\n641\t        _put_spell_on_stack(game, p1, spell, targets=[p2])\n642\t        _grant_value_on(spell)\n643\t        pay_casualty(game, p1, spell, bear)\n644\t\n645\t        copy_obj = copy_spell_on_casualty(game, p1, spell)\n646\t\n647\t        assert copy_obj is not None\n648\t        assert copy_obj.targets == [p2], (\n649\t            \"with no new targets chosen, the copy keeps the original's targets\"\n650\t        )\n651\t\n652\t    def test_no_copy_when_spell_not_on_stack(self) -> None:\n653\t        \"\"\"If the spell is not on the stack there is nothing to copy (a guard, so\n654\t        a stray call cannot fabricate a copy out of nothing).\"\"\"\n655\t        from engine.casualty import copy_spell_on_casualty\n656\t\n657\t        game = create_game()\n658\t        p1 = game.players[0]\n659\t        spell = _vanilla_instant(\"Offstack Bolt\")\n660\t        # Spell deliberately NOT pushed onto the stack.\n661\t        set_board_state(game, 0, hand=[spell])\n662\t\n663\t        assert copy_spell_on_casualty(game, p1, spell) is None\n664\t        assert game.stack.is_empty()\n665\t\n666\t\n667\tclass TestCasualtyOptionalDeclineAndOfferFlow:\n668\t    \"\"\"CR 702.153a — casualty is OPTIONAL: the controller may decline, in which\n669\t    case nothing is sacrificed and no copy is produced. ``offer_casualty`` wires\n670\t    the whole yes/no -> choose-sacrifice -> pay -> copy flow.\"\"\"\n671\t\n672\t    def test_offer_accept_pays_and_copies(self) -> None:\n673\t        \"\"\"Accepting the offer (scripted yes, then choosing the sacrifice)\n674\t        sacrifices the creature, records the payment, and puts a copy on the\n675\t        stack.\"\"\"\n676\t        from engine.casualty import offer_casualty, was_casualty_paid\n677\t\n678\t        game = create_game()\n679\t        p1 = game.players[0]\n680\t        bear = _power_creature(\"Offer Bear\", power=2)\n681\t        spell = _vanilla_instant(\"Offer Bolt\")\n682\t        set_board_state(game, 0, battlefield=[bear])\n683\t        _put_spell_on_stack(game, p1, spell)\n684\t        _grant_value_on(spell)\n685\t        # Script: choose_yes_no -> True (pay), choose_card -> bear.\n686\t        p1._script.clear()\n687\t        p1._script.append(True)\n688\t        p1._script.append(bear)\n689\t\n690\t        result = offer_casualty(game, p1, spell)\n691\t\n692\t        assert result is not None, \"accepting the casualty offer produces the copy\"\n693\t        assert was_casualty_paid(spell) is True\n694\t        assert game.get_graveyard(p1).contains(bear)\n695\t        assert game.stack.peek() is result, \"the copy is on top of the stack\"\n696\t\n697\t    def test_offer_decline_is_a_clean_noop(self) -> None:\n698\t        \"\"\"Declining the offer (scripted no) sacrifices nothing, records no\n699\t        payment, and produces no copy — the original spell is untouched.\"\"\"\n700\t        from engine.casualty import offer_casualty, was_casualty_paid\n701\t\n702\t        game = create_game()\n703\t        p1 = game.players[0]\n704\t        bear = _power_creature(\"Decline Bear\", power=2)\n705\t        spell = _vanilla_instant(\"Decline Bolt\")\n706\t        set_board_state(game, 0, battlefield=[bear])\n707\t        original = _put_spell_on_stack(game, p1, spell)\n708\t        _grant_value_on(spell)\n709\t        stack_before = len(game.stack)\n710\t        # Script: choose_yes_no -> False (decline).\n711\t        p1._script.clear()\n712\t        p1._script.append(False)\n713\t\n714\t        result = offer_casualty(game, p1, spell)\n715\t\n716\t        assert result is None, \"declining the casualty offer produces no copy\"\n717\t        assert was_casualty_paid(spell) is False\n718\t        assert game.get_battlefield(p1).contains(bear), (\n719\t            \"declining sacrifices nothing\"\n720\t        )\n721\t        assert len(game.stack) == stack_before, \"no copy was put on the stack\"\n722\t        assert game.stack.peek() is original, \"only the original spell remains\"\n723\t\n724\t    def test_offer_with_no_legal_sacrifice_is_a_noop(self) -> None:\n725\t        \"\"\"With no power>=1 creature available the offer cannot be paid; it is a\n726\t        no-op even before asking the controller (CR 702.153a: the additional cost\n727\t        cannot be paid).\"\"\"\n728\t        from engine.casualty import offer_casualty, was_casualty_paid\n729\t\n730\t        game = create_game()\n731\t        p1 = game.players[0]\n732\t        wall = _power_creature(\"Only Wall\", power=0, toughness=4)\n733\t        spell = _vanilla_instant(\"No Sac Bolt\")\n734\t        set_board_state(game, 0, battlefield=[wall])\n735\t        _put_spell_on_stack(game, p1, spell)\n736\t        _grant_value_on(spell)\n737\t        stack_before = len(game.stack)\n738\t\n739\t        result = offer_casualty(game, p1, spell)\n740\t\n741\t        assert result is None\n742\t        assert was_casualty_paid(spell) is False\n743\t        assert game.get_battlefield(p1).contains(wall)\n744\t        assert len(game.stack) == stack_before\n745\t\n746\t\n747\tclass TestCasualtyCastHookScope:\n748\t    \"\"\"The card's cast hook (SpellCastTriggeredEvent) offers casualty ONLY for\n749\t    the controller's instants/sorceries — not opponents' spells, not creature\n750\t    spells (CR 702.153a is granted only to 'each instant and sorcery spell you\n751\t    cast').\"\"\"\n752\t\n753\t    def _silverquill_game(self):\n754\t        game = create_game()\n755\t        p1 = game.players[0]\n756\t        p2 = game.players[1]\n757\t        game.active_player_index = 0\n758\t        silver = SilverquillTheDisputant(owner=p1, controller=p1)\n759\t        set_board_state(game, 0, battlefield=[silver])\n760\t        silver.register_triggers(game)\n761\t        return game, p1, p2, silver\n762\t\n763\t    def test_controllers_instant_offers_casualty(self) -> None:\n764\t        \"\"\"A positive anchor: casting the controller's instant fires exactly one\n765\t        casualty trigger onto the stack (so the exclusion tests below are not\n766\t        vacuous).\"\"\"\n767\t        game, p1, p2, silver = self._silverquill_game()\n768\t        spell = _vanilla_instant(\"Mine Bolt\")\n769\t        spell.controller = p1\n770\t        before = len(game.stack)\n771\t\n772\t        game.trigger_manager.fire_event(\n773\t            game,\n774\t            SpellCastTriggeredEvent(spell=spell, player=p1, controller=p1, card=spell),\n775\t        )\n776\t\n777\t        assert len(game.stack) == before + 1, (\n778\t            \"casting the controller's instant must push the casualty offer trigger\"\n779\t        )\n780\t\n781\t    def test_opponents_instant_offers_no_casualty(self) -> None:\n782\t        \"\"\"An opponent's instant must not get a casualty offer (only spells YOU\n783\t        cast). Anchored against the positive case above.\"\"\"\n784\t        game, p1, p2, silver = self._silverquill_game()\n785\t        opp_spell = _vanilla_instant(\"Theirs Bolt\")\n786\t        opp_spell.controller = p2\n787\t        before = len(game.stack)\n788\t\n789\t        game.trigger_manager.fire_event(\n790\t            game,\n791\t            SpellCastTriggeredEvent(spell=opp_spell, player=p2, controller=p2, card=opp_spell),\n792\t        )\n793\t\n794\t        assert len(game.stack) == before, (\n795\t            \"an opponent's instant must not push a casualty offer trigger\"\n796\t        )\n797\t\n798\t    def test_creature_spell_offers_no_casualty(self) -> None:\n799\t        \"\"\"A creature spell is neither instant nor sorcery, so casting it must\n800\t        not get a casualty offer.\"\"\"\n801\t        game, p1, p2, silver = self._silverquill_game()\n802\t        creature_spell = _power_creature(\"Spell Bear\", power=2)\n803\t        creature_spell.controller = p1\n804\t        before = len(game.stack)\n805\t\n806\t        game.trigger_manager.fire_event(\n807\t            game,\n808\t            SpellCastTriggeredEvent(\n809\t                spell=creature_spell, player=p1, controller=p1, card=creature_spell\n810\t            ),\n811\t        )\n812\t\n813\t        assert len(game.stack) == before, (\n814\t            \"a creature spell must not push a casualty offer trigger\"\n815\t        )\n816\t"}]},"parent_tool_use_id":"toolu_018GmEL7Ns3yBUZBZpcJCUmz","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"b9d2fc3b-675a-4dff-962b-b3500557fdd2","timestamp":"2026-06-02T09:42:00.101Z","subagent_type":"Reviewer","task_description":"Review sos_226 implementation"}
{"type":"system","subtype":"task_progress","task_id":"ab1c29db9e4baf918","tool_use_id":"toolu_018GmEL7Ns3yBUZBZpcJCUmz","description":"Reading engine/triggers.py","subagent_type":"Reviewer","usage":{"total_tokens":73373,"tool_uses":14,"duration_ms":34747},"last_tool_name":"Read","uuid":"722e865e-18eb-49ad-aa2b-965a96010990","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc"}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01D2JtKDbNmkqHeE8TeE9hdc","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Rm6BAMg4N6PsQmtVFVzBRM","name":"Read","input":{"file_path":"/workspace/engine/triggers.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14790,"cache_read_input_tokens":58519,"cache_creation":{"ephemeral_5m_input_tokens":14790,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_018GmEL7Ns3yBUZBZpcJCUmz","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"8293d0eb-bb8d-4596-81cd-7e255f30323b","request_id":"req_011CbeDPTS7p3pWGcoqrhnDv","subagent_type":"Reviewer","task_description":"Review sos_226 implementation"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Rm6BAMg4N6PsQmtVFVzBRM","type":"tool_result","content":"1\t\"\"\"Triggered abilities system — event-driven trigger registration and firing.\n2\t\n3\tProvides the core mechanism for registering triggered abilities and firing\n4\tevents that push matching triggers onto the stack:\n5\t\n6\t- :class:`TriggerRegistration` — dataclass describing a single trigger.\n7\t- :class:`TriggerManager` — central registry for triggers with APNAP-ordered\n8\t  event firing.\n9\t\n10\tEvent types live in :mod:`engine.events` as typed dataclasses.\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\tfrom dataclasses import dataclass, field\n16\tfrom typing import TYPE_CHECKING, Any, Callable\n17\t\n18\tfrom engine.events import TriggeredEvent\n19\tfrom engine.stack import StackObject\n20\t\n21\tif TYPE_CHECKING:\n22\t    from engine.game_state import GameState\n23\t    from engine.player import Player\n24\t\n25\t\n26\t@dataclass\n27\tclass TriggerRegistration:\n28\t    \"\"\"Describes a single triggered ability.\n29\t\n30\t    Attributes:\n31\t        event_type: The event class (or a base class) this trigger watches.\n32\t            The trigger fires for any fired event that is an instance of\n33\t            this class, including instances of subclasses.\n34\t        condition: Optional callable ``(game, event) -> bool`` that must\n35\t            return ``True`` for the trigger to fire.  ``None`` means the\n36\t            trigger always fires for its event type.\n37\t        effect: Callable ``(game) -> None`` executed when the trigger\n38\t            resolves (becomes the :attr:`StackObject.on_resolve` callback).\n39\t        source: The game object (card / permanent) that owns this trigger.\n40\t        controller: The player who controls the source at the time of\n41\t            registration.\n42\t        one_shot: When ``True`` this is a delayed trigger that fires\n43\t            exactly once.  It is removed from the manager the first time\n44\t            its event fires and its condition passes (see\n45\t            :meth:`TriggerManager.fire_event`), so it will not fire again\n46\t            on subsequent matching events.\n47\t    \"\"\"\n48\t\n49\t    event_type: type[TriggeredEvent]\n50\t    condition: Callable[..., bool] | None\n51\t    effect: Callable[..., None]\n52\t    source: Any\n53\t    controller: Player\n54\t    one_shot: bool = False\n55\t\n56\t\n57\tclass TriggerManager:\n58\t    \"\"\"Central registry for triggered abilities.\n59\t\n60\t    Triggers are registered when a permanent enters the battlefield (or\n61\t    via other game actions) and unregistered when the source leaves.\n62\t\n63\t    :meth:`fire_event` checks all registered triggers of a matching\n64\t    event type, evaluates their conditions, and pushes matching triggers\n65\t    onto the game stack as :class:`StackObject` instances.  Triggers are\n66\t    ordered according to APNAP (Active Player, Non-Active Player):\n67\t\n68\t    * Active player's triggers are pushed first (end up on the bottom\n69\t      of the batch).\n70\t    * Non-active player's triggers are pushed second (end up on top).\n71\t    * Within the same player, triggers are pushed in registration order\n72\t      (controller would normally choose; for now we use registration\n73\t      order as a deterministic default).\n74\t    \"\"\"\n75\t\n76\t    def __init__(self) -> None:\n77\t        self._triggers: list[TriggerRegistration] = []\n78\t\n79\t    def register(self, trigger: TriggerRegistration) -> None:\n80\t        \"\"\"Register a triggered ability.\"\"\"\n81\t        self._triggers.append(trigger)\n82\t\n83\t    def register_delayed(\n84\t        self,\n85\t        event_type: type[TriggeredEvent],\n86\t        effect: Callable[..., None],\n87\t        source: Any,\n88\t        controller: Player,\n89\t        condition: Callable[..., bool] | None = None,\n90\t    ) -> TriggerRegistration:\n91\t        \"\"\"Register a one-shot *delayed* triggered ability.\n92\t\n93\t        A delayed trigger fires exactly once: the first time *event_type*\n94\t        (or a subclass) is fired and *condition* (if any) passes, *effect*\n95\t        is placed on the stack and the trigger is removed from the manager\n96\t        so it will not fire again.\n97\t\n98\t        This is the engine hook used by effects like \"at the beginning of\n99\t        your next main phase, ...\" — register a delayed trigger watching\n100\t        :class:`~engine.events.BeginningOfMainPhaseTriggeredEvent` whose\n101\t        *condition* checks that the firing player is the controller.\n102\t\n103\t        Returns the created :class:`TriggerRegistration` (already\n104\t        registered) so callers can inspect / unregister it.\n105\t        \"\"\"\n106\t        trigger = TriggerRegistration(\n107\t            event_type=event_type,\n108\t            condition=condition,\n109\t            effect=effect,\n110\t            source=source,\n111\t            controller=controller,\n112\t            one_shot=True,\n113\t        )\n114\t        self._triggers.append(trigger)\n115\t        return trigger\n116\t\n117\t    def unregister(self, source: Any) -> None:\n118\t        \"\"\"Remove all triggers registered by *source* (identity-based).\"\"\"\n119\t        self._triggers = [t for t in self._triggers if t.source is not source]\n120\t\n121\t    def fire_event(self, game: GameState, event: TriggeredEvent) -> None:\n122\t        \"\"\"Fire an event and push all matching triggers onto the stack.\n123\t\n124\t        Parameters:\n125\t            game: The current game state.\n126\t            event: The typed event object.  Triggers registered for the\n127\t                event's class or any of its parent classes will fire.\n128\t\n129\t        Matching triggers are pushed in APNAP order:\n130\t\n131\t        1. Active player's matching triggers (in registration order).\n132\t        2. Non-active player's matching triggers (in registration order).\n133\t        \"\"\"\n134\t        matching: list[TriggerRegistration] = []\n135\t        for trigger in self._triggers:\n136\t            if not isinstance(event, trigger.event_type):\n137\t                continue\n138\t            if trigger.condition is not None:\n139\t                if not trigger.condition(game, event):\n140\t                    continue\n141\t            matching.append(trigger)\n142\t\n143\t        if not matching:\n144\t            return\n145\t\n146\t        # One-shot (delayed) triggers fire exactly once: remove them from\n147\t        # the registry now that they have matched, so a later matching event\n148\t        # does not fire them again.\n149\t        one_shot_fired = [t for t in matching if t.one_shot]\n150\t        if one_shot_fired:\n151\t            self._triggers = [t for t in self._triggers if t not in one_shot_fired]\n152\t\n153\t        active_player = game.active_player\n154\t        active_triggers: list[TriggerRegistration] = []\n155\t        non_active_triggers: list[TriggerRegistration] = []\n156\t\n157\t        for trigger in matching:\n158\t            if trigger.controller is active_player:\n159\t                active_triggers.append(trigger)\n160\t            else:\n161\t                non_active_triggers.append(trigger)\n162\t\n163\t        ordered = active_triggers + non_active_triggers\n164\t\n165\t        for trigger in ordered:\n166\t            stack_obj = StackObject(\n167\t                source=trigger.source,\n168\t                controller=trigger.controller,\n169\t                on_resolve=trigger.effect,\n170\t            )\n171\t            game.stack.push(stack_obj)\n172\t\n173\t    def get_triggers(self) -> list[TriggerRegistration]:\n174\t        \"\"\"Return a shallow copy of all registered triggers.\"\"\"\n175\t        return list(self._triggers)\n176\t\n177\t    def get_triggers_for_source(self, source: Any) -> list[TriggerRegistration]:\n178\t        \"\"\"Return all triggers registered by *source* (identity-based).\"\"\"\n179\t        return [t for t in self._triggers if t.source is source]\n180\t\n181\t    def clear(self) -> None:\n182\t        \"\"\"Remove all registered triggers.\"\"\"\n183\t        self._triggers.clear()\n184\t"}]},"parent_tool_use_id":"toolu_018GmEL7Ns3yBUZBZpcJCUmz","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"e2fa210b-39b1-428b-a14d-42e20522bd80","timestamp":"2026-06-02T09:42:03.575Z","subagent_type":"Reviewer","task_description":"Review sos_226 implementation"}
