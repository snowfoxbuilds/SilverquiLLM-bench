{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CvCPEE6kDJC3QCbVpCdT3o","type":"tool_result","content":"1\t\"\"\"Tests for SOS 226 — Silverquill, the Disputant.\n2\t\n3\tOracle text (from card_spec.json):\n4\t\n5\t    Flying, vigilance\n6\t    Each instant and sorcery spell you cast has casualty 1. (As you cast that\n7\t    spell, you may sacrifice a creature with power 1 or greater. When you do,\n8\t    copy the spell and you may choose new targets for the copy.)\n9\t\n10\tBehaviour contract derived from that text:\n11\t\n12\t* Static: Legendary Creature — Elder Dragon, {2}{W}{B}, 4/4, black+white, with\n13\t  Flying and Vigilance.\n14\t* Casualty-granting static ability: while Silverquill is on the battlefield,\n15\t  every instant and sorcery SPELL its controller casts \"has casualty 1\"\n16\t  (CR 702.153). Casualty 1 means: as an additional cost you MAY sacrifice a\n17\t  creature with power 1 or greater; when you do, copy the spell and may choose\n18\t  new targets for the copy.\n19\t\n20\t  There is no engine-level casualty pipeline, so the implementation must expose\n21\t  some observable surface that reports the casualty value (1) for an\n22\t  instant/sorcery the controller casts (and grants it to no other card types /\n23\t  no other players). These tests probe that surface TOLERANTLY: they accept any\n24\t  of the conventional spellings the implementer is likely to use (a query method\n25\t  on the Silverquill card and/or an attribute written onto the affected spell),\n26\t  and skip-with-reason only if NO recognised surface exists (so the contract is\n27\t  never silently green).\n28\t\n29\t  The copy/sacrifice RESOLUTION mechanic (paying the casualty cost by\n30\t  sacrificing a power>=1 creature, then producing a copy with optional new\n31\t  targets) is recorded in untestable.json: no engine casualty pipeline exists to\n32\t  assert it against yet.\n33\t\n34\tThese tests are written for the TDD red phase: they must FAIL against the empty\n35\tstub and PASS once the card is implemented correctly.\n36\t\"\"\"\n37\t\n38\tfrom __future__ import annotations\n39\t\n40\tfrom typing import Any\n41\t\n42\timport pytest\n43\t\n44\tfrom cards.sos.sos_226.card_impl import SilverquillTheDisputant\n45\tfrom engine.card import Creature, Instant, Sorcery\n46\tfrom engine.types import Color, Keyword, ManaCost, ManaType, Supertype\n47\tfrom test_utils import create_game, set_board_state\n48\t\n49\t\n50\t# ---------------------------------------------------------------------------\n51\t# Test helper cards\n52\t# ---------------------------------------------------------------------------\n53\t\n54\t\n55\tdef _vanilla_instant(name: str = \"Test Instant\") -> Instant:\n56\t    return Instant(name=name, mana_cost=ManaCost.parse(\"{1}{R}\"))\n57\t\n58\t\n59\tdef _vanilla_sorcery(name: str = \"Test Sorcery\") -> Sorcery:\n60\t    return Sorcery(name=name, mana_cost=ManaCost.parse(\"{2}{G}\"))\n61\t\n62\t\n63\tdef _vanilla_creature(name: str = \"Test Bear\") -> Creature:\n64\t    return Creature(\n65\t        name=name,\n66\t        mana_cost=ManaCost.parse(\"{1}{G}\"),\n67\t        base_power=2,\n68\t        base_toughness=2,\n69\t    )\n70\t\n71\t\n72\tdef _casualty_value_for(card_obj: Any, game: Any, spell: Any) -> Any:\n73\t    \"\"\"Best-effort probe for the granted casualty value of *spell*.\n74\t\n75\t    The casualty mechanic has no engine pipeline, so the implementation is free\n76\t    to surface the grant in a number of conventional ways. This helper tries\n77\t    each in turn and returns the reported value, or raises ``pytest.skip`` if no\n78\t    recognised surface exists (so the contract is not silently green).\n79\t    \"\"\"\n80\t    # 1. A method on the Silverquill card that reports the casualty value it\n81\t    #    grants to a given spell.\n82\t    for meth_name in (\n83\t        \"casualty_value_for\",\n84\t        \"get_casualty_value\",\n85\t        \"casualty_for\",\n86\t        \"get_casualty\",\n87\t        \"casualty_value\",\n88\t    ):\n89\t        meth = getattr(card_obj, meth_name, None)\n90\t        if callable(meth):\n91\t            try:\n92\t                return meth(game, spell)\n93\t            except TypeError:\n94\t                try:\n95\t                    return meth(spell)\n96\t                except TypeError:\n97\t                    continue\n98\t    # 2. The grant written directly onto the spell.\n99\t    for attr_name in (\"casualty_value\", \"casualty\", \"granted_casualty\"):\n100\t        val = getattr(spell, attr_name, None)\n101\t        if val is not None:\n102\t            return val\n103\t    pytest.skip(\n104\t        \"No observable surface for the granted casualty value — implementation \"\n105\t        \"must expose casualty_value_for(...)/get_casualty_value(...) on the \"\n106\t        \"card or a casualty_value attribute on the affected spell.\"\n107\t    )\n108\t\n109\t\n110\tdef _probe_casualty_silent(card_obj: Any, game: Any, spell: Any) -> Any:\n111\t    \"\"\"Like ``_casualty_value_for`` but returns None instead of skipping when no\n112\t    recognised surface reports a value for *spell* (used for the exclusion-side\n113\t    assertions, anchored on a positive case so the test is never vacuous).\"\"\"\n114\t    for meth_name in (\n115\t        \"casualty_value_for\",\n116\t        \"get_casualty_value\",\n117\t        \"casualty_for\",\n118\t        \"get_casualty\",\n119\t        \"casualty_value\",\n120\t    ):\n121\t        meth = getattr(card_obj, meth_name, None)\n122\t        if callable(meth):\n123\t            try:\n124\t                return meth(game, spell)\n125\t            except TypeError:\n126\t                try:\n127\t                    return meth(spell)\n128\t                except TypeError:\n129\t                    continue\n130\t    for attr_name in (\"casualty_value\", \"casualty\", \"granted_casualty\"):\n131\t        val = getattr(spell, attr_name, None)\n132\t        if val is not None:\n133\t            return val\n134\t    return None\n135\t\n136\t\n137\tdef _coerce_to_one(value: Any) -> bool:\n138\t    \"\"\"Return True if *value* represents casualty N == 1.\n139\t\n140\t    Accepts an int (1), a bool True coerced via int, a string spelling like\n141\t    \"1\" or \"casualty 1\", or anything exposing ``.cmc``/``.value``/``.n`` == 1.\n142\t    \"\"\"\n143\t    if value is None or value is False:\n144\t        return False\n145\t    if value is True:\n146\t        # A bare True flag means \"has casualty\" but does not encode N; treat as\n147\t        # NOT a confirmation of the specific value 1.\n148\t        return False\n149\t    if isinstance(value, int):\n150\t        return value == 1\n151\t    if isinstance(value, str):\n152\t        digits = \"\".join(ch for ch in value if ch.isdigit())\n153\t        return digits == \"1\"\n154\t    for attr in (\"value\", \"n\", \"amount\", \"cmc\"):\n155\t        v = getattr(value, attr, None)\n156\t        if isinstance(v, int):\n157\t            return v == 1\n158\t    return False\n159\t\n160\t\n161\t# ---------------------------------------------------------------------------\n162\t# Static card data\n163\t# ---------------------------------------------------------------------------\n164\t\n165\t\n166\tclass TestSilverquillProperties:\n167\t    \"\"\"Static characteristics must match the SOS 226 spec.\"\"\"\n168\t\n169\t    def test_is_creature(self) -> None:\n170\t        assert isinstance(SilverquillTheDisputant(owner=None), Creature)\n171\t\n172\t    def test_name(self) -> None:\n173\t        assert SilverquillTheDisputant(owner=None).name == \"Silverquill, the Disputant\"\n174\t\n175\t    def test_mana_cost(self) -> None:\n176\t        assert SilverquillTheDisputant(owner=None).mana_cost == ManaCost.parse(\"{2}{W}{B}\")\n177\t\n178\t    def test_mana_value_is_four(self) -> None:\n179\t        assert SilverquillTheDisputant(owner=None).mana_cost.cmc == 4\n180\t\n181\t    def test_power_toughness(self) -> None:\n182\t        card = SilverquillTheDisputant(owner=None)\n183\t        assert card.base_power == 4\n184\t        assert card.base_toughness == 4\n185\t\n186\t    def test_is_legendary(self) -> None:\n187\t        assert Supertype.LEGENDARY in SilverquillTheDisputant(owner=None).supertypes\n188\t\n189\t    def test_is_elder_dragon(self) -> None:\n190\t        subtypes = SilverquillTheDisputant(owner=None).subtypes\n191\t        assert \"Dragon\" in subtypes\n192\t        assert \"Elder\" in subtypes\n193\t\n194\t    def test_has_flying(self) -> None:\n195\t        assert Keyword.FLYING in SilverquillTheDisputant(owner=None).keywords\n196\t\n197\t    def test_has_vigilance(self) -> None:\n198\t        assert Keyword.VIGILANCE in SilverquillTheDisputant(owner=None).keywords\n199\t\n200\t    def test_is_white_black(self) -> None:\n201\t        \"\"\"{2}{W}{B} has exactly one white and one black pip and no others.\"\"\"\n202\t        cost = SilverquillTheDisputant(owner=None).mana_cost\n203\t        assert cost.pips.get(ManaType.WHITE, 0) == 1\n204\t        assert cost.pips.get(ManaType.BLACK, 0) == 1\n205\t        assert cost.pips.get(ManaType.RED, 0) == 0\n206\t        assert cost.pips.get(ManaType.BLUE, 0) == 0\n207\t        assert cost.pips.get(ManaType.GREEN, 0) == 0\n208\t\n209\t    def test_colors_are_black_and_white(self) -> None:\n210\t        \"\"\"If the implementation exposes a ``colors`` surface it must be exactly\n211\t        {B, W}. If it does not, the pip-based ``test_is_white_black`` above\n212\t        already pins the colours, so this is skipped rather than failing.\"\"\"\n213\t        card = SilverquillTheDisputant(owner=None)\n214\t        colors = getattr(card, \"colors\", None)\n215\t        if not colors:\n216\t            pytest.skip(\"no explicit colors attribute; pip test covers colours\")\n217\t        color_set = set(colors)\n218\t        assert color_set == {Color.WHITE, Color.BLACK}\n219\t\n220\t    def test_casualty_is_printed_keyword_label_not_enum(self) -> None:\n221\t        \"\"\"'Casualty' is a printed-keyword label (the Keyword enum is frozen at\n222\t        16 evergreen members), so it must NOT appear as a Keyword enum member.\n223\t        If the implementation records printed labels, \"Casualty\" should be among\n224\t        them; if it exposes no such surface this is skipped (the grant-surface\n225\t        tests below are the real contract).\"\"\"\n226\t        card = SilverquillTheDisputant(owner=None)\n227\t        # Casualty must not have been smuggled into the evergreen Keyword enum.\n228\t        assert not hasattr(Keyword, \"CASUALTY\")\n229\t        labels = getattr(card, \"printed_keywords\", None)\n230\t        if labels is None:\n231\t            pytest.skip(\"no printed_keywords surface to assert the Casualty label\")\n232\t        assert any(\"casualty\" in str(label).lower() for label in labels)\n233\t\n234\t\n235\t# ---------------------------------------------------------------------------\n236\t# Casualty-granting static ability — queryable / observable grant surface\n237\t# ---------------------------------------------------------------------------\n238\t\n239\t\n240\tclass TestSilverquillCasualtyGrant:\n241\t    \"\"\"While on the battlefield, Silverquill grants casualty 1 to each instant\n242\t    and sorcery SPELL its controller casts.\"\"\"\n243\t\n244\t    def _setup(\n245\t        self,\n246\t        controller_spells: list[Any],\n247\t        opp_spells: list[Any] | None = None,\n248\t        *,\n249\t        on_battlefield: bool = True,\n250\t    ):\n251\t        game = create_game()\n252\t        p1 = game.players[0]\n253\t        p2 = game.players[1]\n254\t        card = SilverquillTheDisputant(owner=p1, controller=p1)\n255\t        if on_battlefield:\n256\t            set_board_state(game, 0, battlefield=[card], hand=controller_spells)\n257\t        else:\n258\t            # Silverquill in hand, not on the battlefield: the grant must be off.\n259\t            set_board_state(game, 0, hand=[card] + controller_spells)\n260\t        if opp_spells is not None:\n261\t            set_board_state(game, 1, hand=opp_spells)\n262\t        # Apply continuous effects if the engine maintains them, so a\n263\t        # layer-based implementation has a chance to write its grant.\n264\t        if hasattr(game, \"effect_manager\"):\n265\t            try:\n266\t                card.register_replacement_effects(game)\n267\t                card.register_triggers(game)\n268\t            except Exception:\n269\t                pass\n270\t            try:\n271\t                game.effect_manager.apply_all(game)\n272\t            except Exception:\n273\t                pass\n274\t        return game, p1, p2, card\n275\t\n276\t    def test_instant_gets_casualty_one(self) -> None:\n277\t        spell = _vanilla_instant(\"My Bolt\")\n278\t        game, p1, p2, card = self._setup([spell])\n279\t        value = _casualty_value_for(card, game, spell)\n280\t        assert _coerce_to_one(value)\n281\t\n282\t    def test_sorcery_gets_casualty_one(self) -> None:\n283\t        spell = _vanilla_sorcery(\"My Ritual\")\n284\t        game, p1, p2, card = self._setup([spell])\n285\t        value = _casualty_value_for(card, game, spell)\n286\t        assert _coerce_to_one(value)\n287\t\n288\t    def test_creature_spell_does_not_get_casualty(self) -> None:\n289\t        \"\"\"Casualty is granted only to instant/sorcery spells. A creature spell\n290\t        is neither, so it must not be granted casualty. We anchor on a real\n291\t        instant first (via the probe, which skips if no surface exists) so this\n292\t        fails on an empty stub rather than passing vacuously.\"\"\"\n293\t        anchor = _vanilla_instant(\"Anchor Bolt\")\n294\t        bear = _vanilla_creature(\"Hand Bear\")\n295\t        game, p1, p2, card = self._setup([anchor, bear])\n296\t        # Anchor: confirm the grant surface exists and reports 1 for the instant.\n297\t        assert _coerce_to_one(_casualty_value_for(card, game, anchor))\n298\t        # The creature spell must NOT be granted casualty 1.\n299\t        assert not _coerce_to_one(_probe_casualty_silent(card, game, bear))\n300\t\n301\t    def test_opponents_instant_does_not_get_casualty(self) -> None:\n302\t        \"\"\"Only spells YOU cast get casualty — an opponent's instant is\n303\t        unaffected. Anchored on a controller-side instant so the test fails on\n304\t        an empty stub rather than passing vacuously.\"\"\"\n305\t        my_spell = _vanilla_instant(\"My Instant\")\n306\t        opp_spell = _vanilla_instant(\"Opp Instant\")\n307\t        game, p1, p2, card = self._setup([my_spell], opp_spells=[opp_spell])\n308\t        # Anchor: my own instant gets casualty 1 (skips if no surface exists).\n309\t        assert _coerce_to_one(_casualty_value_for(card, game, my_spell))\n310\t        # The opponent's instant must NOT be granted casualty.\n311\t        assert not _coerce_to_one(_probe_casualty_silent(card, game, opp_spell))\n312\t\n313\t    def test_no_grant_while_off_battlefield(self) -> None:\n314\t        \"\"\"A static ability of a permanent functions only while that permanent\n315\t        is on the battlefield (CR 113.6 / 604.x). With Silverquill in hand (not\n316\t        on the battlefield), an instant must NOT be granted casualty.\n317\t\n318\t        This anchors on the positive case from ``test_instant_gets_casualty_one``\n319\t        (which skips if no surface exists), so a stub that always returns a value\n320\t        is caught, while genuinely-absent surfaces skip rather than pass.\"\"\"\n321\t        # Positive anchor: a parallel on-battlefield setup must grant casualty.\n322\t        anchor_spell = _vanilla_instant(\"Anchor While On Field\")\n323\t        a_game, _, _, a_card = self._setup([anchor_spell])\n324\t        assert _coerce_to_one(_casualty_value_for(a_card, a_game, anchor_spell))\n325\t\n326\t        # Now Silverquill is in hand, not on the battlefield: no grant.\n327\t        spell = _vanilla_instant(\"Off Field Instant\")\n328\t        game, p1, p2, card = self._setup([spell], on_battlefield=False)\n329\t        assert not _coerce_to_one(_probe_casualty_silent(card, game, spell))\n330\t\n331\t\n332\t# ---------------------------------------------------------------------------\n333\t# Casualty grant wiring — the card must install its continuous grant\n334\t# ---------------------------------------------------------------------------\n335\t\n336\t\n337\tclass TestSilverquillGrantWiring:\n338\t    \"\"\"The casualty grant is a continuous static ability, so the card must wire\n339\t    it through one of the engine's continuous/effect/trigger hooks rather than\n340\t    doing nothing. We assert the card actually installs something observable.\"\"\"\n341\t\n342\t    def test_card_exposes_a_casualty_grant_surface(self) -> None:\n343\t        \"\"\"The implementation must expose at least one recognised casualty-grant\n344\t        surface (a query method on the card, or an attribute it writes onto an\n345\t        affected spell). An empty stub exposes none and fails here.\"\"\"\n346\t        game = create_game()\n347\t        p1 = game.players[0]\n348\t        card = SilverquillTheDisputant(owner=p1, controller=p1)\n349\t        spell = _vanilla_instant(\"Probe Instant\")\n350\t        set_board_state(game, 0, battlefield=[card], hand=[spell])\n351\t        if hasattr(game, \"effect_manager\"):\n352\t            try:\n353\t                card.register_replacement_effects(game)\n354\t                card.register_triggers(game)\n355\t                game.effect_manager.apply_all(game)\n356\t            except Exception:\n357\t                pass\n358\t\n359\t        has_method = any(\n360\t            callable(getattr(card, m, None))\n361\t            for m in (\n362\t                \"casualty_value_for\",\n363\t                \"get_casualty_value\",\n364\t                \"casualty_for\",\n365\t                \"get_casualty\",\n366\t                \"casualty_value\",\n367\t            )\n368\t        )\n369\t        has_attr = any(\n370\t            getattr(spell, a, None) is not None\n371\t            for a in (\"casualty_value\", \"casualty\", \"granted_casualty\")\n372\t        )\n373\t        assert has_method or has_attr, (\n374\t            \"Silverquill must expose an observable casualty-grant surface \"\n375\t            \"(a query method on the card or an attribute on the affected spell).\"\n376\t        )\n377\t"}]},"parent_tool_use_id":"toolu_01MCk4C64ZZ91MHuV32a4PEw","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"ebdc60c8-3cd1-4eb7-b68a-efb771ae16fb","timestamp":"2026-06-02T09:36:36.709Z","subagent_type":"Tester","task_description":"Extend sos_226 casualty tests"}
