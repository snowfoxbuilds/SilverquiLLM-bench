{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01FgBkG2u35mVvz1HJboTZtP","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JfQFkQbhTKrSs54TAnW6Qr","name":"Write","input":{"file_path":"/workspace/engine/casualty.py","content":"\"\"\"Casualty-keyword framework (Comprehensive Rules 702.153).\n\n*Casualty* is a static ability linked to a triggered ability:\n\n    Casualty N (As an additional cost to cast this spell, you may sacrifice a\n    creature with power N or greater.  When you cast this spell, if a casualty\n    cost was paid for it, copy it.  If the spell has any targets, you may choose\n    new targets for the copy.)\n\nA card normally carries casualty as a printed ability, but Silverquill, the\nDisputant *grants* casualty 1 to every instant and sorcery **spell** its\ncontroller casts.  The engine had no support for the mechanic, so this module\nadds it *additively* — no existing engine symbol is renamed, moved, or deleted.\nIt mirrors :mod:`engine.miracle` / :mod:`engine.preparation` / :mod:`engine.paradigm`.\n\nThe mechanic has three observable parts:\n\n1. **The grant surface.**  A *granted casualty value* is recorded on the affected\n   spell (an ``int`` written to ``spell.casualty``) and is also queryable via\n   :func:`get_casualty_value`.  A continuous-grant source (Silverquill) installs /\n   refreshes the grant via :func:`grant_casualty_to_hand`, which only ever writes\n   the value onto instants/sorceries in *its controller's* hand and clears stale\n   grants from cards that have left the hand.\n\n2. **The optional additional cost — sacrifice a creature with power >= N\n   (CR 702.153a).**  :func:`legal_casualty_sacrifices` exposes the set of legal\n   sacrifice candidates (creatures the caster controls whose power is >= N), so\n   the power boundary is observable (power 0 illegal, power 1 legal).\n   :func:`pay_casualty` performs the payment: it validates the chosen creature's\n   power, sacrifices it, and records the payment on the spell\n   (``spell.casualty_paid = True``).\n\n3. **Copy-on-payment (CR 702.153c).**  When the casualty cost is paid, the spell\n   is copied onto the stack under the controller's control, with the option to\n   choose new targets for the copy.  This reuses the existing engine spell-copy\n   primitive :func:`engine.stack.copy_spell` (no new copy primitive is added).\n\n\"Casualty\" is a *printed keyword label*, not an evergreen keyword, so no member\nis added to :class:`engine.types.Keyword` (that enum is frozen at 16 members).\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.types import CardType, Zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n#: Default casualty value granted by Silverquill, the Disputant (casualty 1).\nCASUALTY_ONE: int = 1\n\n\n# ---------------------------------------------------------------------------\n# Grant surface — read / write the granted casualty value on a spell\n# ---------------------------------------------------------------------------\n\n\ndef is_instant_or_sorcery(card: Any) -> bool:\n    \"\"\"Return ``True`` if *card* is an instant or sorcery (the granted types).\"\"\"\n    card_types = getattr(card, \"card_types\", set())\n    return CardType.INSTANT in card_types or CardType.SORCERY in card_types\n\n\ndef get_casualty_value(card: Any) -> int | None:\n    \"\"\"Return the granted casualty value on *card*, or ``None`` if none.\n\n    The grant is stored on the card as an ``int`` under ``card.casualty`` (the\n    queryable grant surface).  Returns ``None`` when the card carries no granted\n    casualty value.\n    \"\"\"\n    return getattr(card, \"casualty\", None)\n\n\ndef set_casualty_value(card: Any, value: int | None) -> None:\n    \"\"\"Write (or clear) the granted casualty value on *card*.\n\n    Passing ``None`` clears the grant (removes the ``casualty`` attribute so a\n    stale grant never lingers on a card that has left the granting zone).\n    \"\"\"\n    if value is None:\n        if hasattr(card, \"casualty\"):\n            try:\n                delattr(card, \"casualty\")\n            except AttributeError:\n                card.casualty = None  # type: ignore[attr-defined]\n        # Also drop the source back-link so the card is fully de-granted.\n        if hasattr(card, \"_casualty_grant_source\"):\n            try:\n                delattr(card, \"_casualty_grant_source\")\n            except AttributeError:\n                pass\n        return\n    card.casualty = value  # type: ignore[attr-defined]\n\n\ndef has_casualty(card: Any) -> bool:\n    \"\"\"Return ``True`` if *card* currently carries a granted casualty value.\"\"\"\n    return get_casualty_value(card) is not None\n\n\n# ---------------------------------------------------------------------------\n# Per-game registry of cards a given source has granted casualty to\n# ---------------------------------------------------------------------------\n\n\ndef _granted_registry(game: GameState) -> dict[int, set[int]]:\n    \"\"\"Return (creating if necessary) the per-game casualty-grant registry.\n\n    Maps ``id(source)`` to the set of ``id(card)`` it last granted casualty to,\n    so a refresh can clear grants from cards that have since left the granting\n    zone.  Stored lazily on the game object — no ``GameState.__init__`` change.\n    \"\"\"\n    registry = getattr(game, \"_casualty_grants\", None)\n    if registry is None:\n        registry = {}\n        game._casualty_grants = registry  # type: ignore[attr-defined]\n    return registry\n\n\n# ---------------------------------------------------------------------------\n# The continuous grant — \"each instant/sorcery you cast has casualty {N}\"\n# ---------------------------------------------------------------------------\n\n\ndef grant_casualty_to_hand(\n    game: GameState,\n    source: Any,\n    controller: Any,\n    value: int = CASUALTY_ONE,\n) -> list[Any]:\n    \"\"\"Grant casualty *value* to every instant/sorcery in *controller*'s hand.\n\n    This is the body of Silverquill's continuous static ability: while the\n    source is on the battlefield, every instant and sorcery spell its controller\n    casts \"has casualty 1\".  The casting/casualty pipeline observes the grant on\n    the spell object regardless of zone; with no live cast pipeline the\n    controller's-hand instants/sorceries are the natural observable proxy (the\n    same proxy :mod:`engine.miracle` uses).  The grant is written onto each such\n    card (``card.casualty``) and is queryable via :func:`get_casualty_value`.\n\n    The grant is *scoped*:\n\n    * only instants and sorceries are affected (creatures, lands, etc. are not);\n    * only cards in *controller*'s hand are affected (an opponent's hand is left\n      untouched).\n\n    Calling this again refreshes the grant: cards that have left the controller's\n    hand since the last refresh have their (this-source) grant cleared so a stale\n    casualty value never lingers.  Returns the list of hand cards now carrying the\n    grant.\n    \"\"\"\n    if controller is None:\n        return []\n\n    registry = _granted_registry(game)\n    previously = registry.get(id(source), set())\n\n    hand = controller.zones[Zone.HAND]\n    granted: list[Any] = []\n    now_ids: set[int] = set()\n\n    for card in hand.get_all():\n        if not is_instant_or_sorcery(card):\n            continue\n        set_casualty_value(card, value)\n        card._casualty_grant_source = source  # type: ignore[attr-defined]\n        granted.append(card)\n        now_ids.add(id(card))\n\n    # Clear grants this source placed on cards that are no longer in the hand\n    # (or are no longer instants/sorceries).\n    stale = previously - now_ids\n    if stale:\n        _clear_grants_for_ids(game, source, stale)\n\n    registry[id(source)] = now_ids\n    return granted\n\n\ndef _clear_grants_for_ids(game: GameState, source: Any, card_ids: set[int]) -> None:\n    \"\"\"Clear *source*'s casualty grant from any card in *card_ids* across zones.\"\"\"\n    for player in game.players:\n        for zone in Zone:\n            container = player.zones[zone]\n            for card in list(container.get_all()):\n                if (\n                    id(card) in card_ids\n                    and getattr(card, \"_casualty_grant_source\", None) is source\n                ):\n                    set_casualty_value(card, None)\n\n\ndef clear_casualty_grants(game: GameState, source: Any) -> None:\n    \"\"\"Clear every casualty grant *source* placed (e.g. when it leaves play).\"\"\"\n    registry = _granted_registry(game)\n    granted = registry.pop(id(source), set())\n    if not granted:\n        return\n    _clear_grants_for_ids(game, source, granted)\n\n\n# ---------------------------------------------------------------------------\n# Optional additional cost — sacrifice a creature with power >= N (702.153a)\n# ---------------------------------------------------------------------------\n\n\ndef is_legal_casualty_sacrifice(creature: Any, value: int) -> bool:\n    \"\"\"Return ``True`` if *creature* may be sacrificed for casualty *value*.\n\n    A legal casualty sacrifice for casualty N is a creature with power N or\n    greater (CR 702.153a).  For casualty 1 a power-0 creature is illegal and a\n    power-1 (or greater) creature is legal.\n    \"\"\"\n    if creature is None:\n        return False\n    card_types = getattr(creature, \"card_types\", set())\n    if CardType.CREATURE not in card_types:\n        return False\n    power = getattr(creature, \"power\", None)\n    if power is None:\n        power = getattr(creature, \"base_power\", 0)\n    return power >= value\n\n\ndef legal_casualty_sacrifices(\n    game: GameState,\n    player: Any,\n    value: int,\n) -> list[Any]:\n    \"\"\"Return the creatures *player* controls that are legal casualty sacrifices.\n\n    These are the creatures on *player*'s battlefield whose power is >= *value*\n    (CR 702.153a).  Exposing this set makes the power boundary observable: for\n    casualty 1, a power-0 creature is excluded and a power-1 (or greater)\n    creature is included.\n    \"\"\"\n    if player is None:\n        return []\n    battlefield = game.get_battlefield(player)\n    return [\n        creature\n        for creature in battlefield.get_all()\n        if is_legal_casualty_sacrifice(creature, value)\n    ]\n\n\ndef mark_casualty_paid(spell: Any) -> None:\n    \"\"\"Record that a casualty cost was paid for *spell* (``spell.casualty_paid``).\"\"\"\n    spell.casualty_paid = True  # type: ignore[attr-defined]\n\n\ndef was_casualty_paid(spell: Any) -> bool:\n    \"\"\"Return ``True`` if a casualty cost was recorded as paid for *spell*.\"\"\"\n    return bool(getattr(spell, \"casualty_paid\", False))\n\n\ndef pay_casualty(\n    game: GameState,\n    player: Any,\n    spell: Any,\n    creature: Any,\n    value: int | None = None,\n) -> bool:\n    \"\"\"Pay *spell*'s casualty cost by sacrificing *creature* (CR 702.153a).\n\n    Validates that *creature* is a legal casualty sacrifice (a creature *player*\n    controls with power >= the casualty value), sacrifices it to its owner's\n    graveyard, and records the payment on the spell (``spell.casualty_paid =\n    True``).\n\n    The casualty value defaults to the value granted to *spell* (via\n    :func:`get_casualty_value`), falling back to :data:`CASUALTY_ONE` if the\n    spell carries no recorded grant.\n\n    Returns ``True`` if the cost was paid, ``False`` if the chosen creature is\n    not a legal sacrifice (power below the threshold, not a creature, or not\n    controlled by *player*) — in which case nothing is sacrificed and no payment\n    is recorded.\n\n    NOTE: paying the casualty cost does **not** itself produce the copy — the\n    copy is the casualty *triggered* ability (CR 702.153c).  Call\n    :func:`copy_spell_on_casualty` (or :func:`offer_casualty`, which wires both)\n    to produce the copy once the spell is on the stack.\n    \"\"\"\n    from engine.game import sacrifice\n\n    if value is None:\n        value = get_casualty_value(spell)\n        if value is None:\n            value = CASUALTY_ONE\n\n    # The creature must be a legal sacrifice AND under the player's control.\n    if not is_legal_casualty_sacrifice(creature, value):\n        return False\n    if not game.get_battlefield(player).contains(creature):\n        return False\n\n    sacrifice(game, player, creature)\n    mark_casualty_paid(spell)\n    return True\n\n\n# ---------------------------------------------------------------------------\n# Copy-on-payment (CR 702.153c)\n# ---------------------------------------------------------------------------\n\n\ndef _find_stack_object(game: GameState, spell: Any) -> Any | None:\n    \"\"\"Return the :class:`~engine.stack.StackObject` whose source is *spell*.\"\"\"\n    for stack_obj in game.stack._items:\n        if stack_obj.source is spell:\n            return stack_obj\n    return None\n\n\ndef copy_spell_on_casualty(\n    game: GameState,\n    player: Any,\n    spell: Any,\n    new_targets: list[Any] | None = None,\n) -> Any | None:\n    \"\"\"Copy *spell* onto the stack under *player*'s control (CR 702.153c).\n\n    Implements the casualty triggered ability: \"When you cast this spell, if a\n    casualty cost was paid for it, copy it.  If the spell has any targets, you\n    may choose new targets for the copy.\"  *spell* must be on the stack.  Reuses\n    the engine spell-copy primitive :func:`engine.stack.copy_spell`, so the copy\n    shares the original's identity but has independent state and (optionally) new\n    targets.  The copy is pushed onto the stack and returned so callers/tests can\n    observe it.\n\n    Returns the copy's :class:`~engine.stack.StackObject`, or ``None`` if the\n    original spell is not on the stack.\n    \"\"\"\n    from engine.stack import copy_spell\n\n    original = _find_stack_object(game, spell)\n    if original is None:\n        return None\n\n    copy_obj = copy_spell(game, original, player, new_targets)\n    game.stack.push(copy_obj)\n    return copy_obj\n\n\ndef offer_casualty(\n    game: GameState,\n    player: Any,\n    spell: Any,\n    value: int | None = None,\n) -> Any | None:\n    \"\"\"Offer *player* the option to pay *spell*'s casualty cost and copy it.\n\n    This wires the whole optional mechanic (CR 702.153a/c) around a spell that is\n    already on the stack:\n\n    1. Compute the legal sacrifice candidates (creatures with power >= the\n       casualty value).  With none available, the offer cannot be paid.\n    2. Ask the player whether they want to pay the casualty cost.\n    3. On *yes*, ask which creature to sacrifice, validate and pay via\n       :func:`pay_casualty` (recording ``spell.casualty_paid``), then copy the\n       spell onto the stack via :func:`copy_spell_on_casualty`, offering new\n       targets for the copy if the spell had any.\n\n    Returns the copy's :class:`~engine.stack.StackObject` if the casualty cost\n    was paid and the copy produced, otherwise ``None`` (declined, no legal\n    sacrifice, or the spell left the stack).\n    \"\"\"\n    if value is None:\n        value = get_casualty_value(spell)\n        if value is None:\n            value = CASUALTY_ONE\n\n    candidates = legal_casualty_sacrifices(game, player, value)\n    if not candidates:\n        return None\n\n    chooser = getattr(player, \"choose_yes_no\", None)\n    if not callable(chooser):\n        return None\n    try:\n        wants = bool(\n            chooser(\n                f\"Pay casualty {value} for \"\n                f\"{getattr(spell, 'name', 'this spell')} \"\n                f\"(sacrifice a creature with power {value} or greater)?\"\n            )\n        )\n    except Exception:\n        return None\n    if not wants:\n        return None\n\n    # Choose which creature to sacrifice.\n    picker = getattr(player, \"choose_card\", None)\n    chosen = candidates[0]\n    if callable(picker):\n        try:\n            chosen = picker(candidates, \"creature to sacrifice for casualty\")\n        except Exception:\n            chosen = candidates[0]\n    if chosen is None or not is_legal_casualty_sacrifice(chosen, value):\n        return None\n\n    if not pay_casualty(game, player, spell, chosen, value):\n        return None\n\n    # CR 702.153c — produce the copy, with optional new targets.\n    new_targets = _maybe_choose_new_targets(game, player, spell)\n    return copy_spell_on_casualty(game, player, spell, new_targets)\n\n\ndef _maybe_choose_new_targets(\n    game: GameState,\n    player: Any,\n    spell: Any,\n) -> list[Any] | None:\n    \"\"\"Optionally let *player* choose new targets for the casualty copy.\n\n    Returns the chosen new target list, or ``None`` to keep the original\n    targets.  Only prompts when the spell has at least one target on its stack\n    object; declining keeps the original targets (CR 702.153a: \"you may choose\n    new targets for the copy\").\n    \"\"\"\n    original = _find_stack_object(game, spell)\n    if original is None or not original.targets:\n        return None\n\n    chooser = getattr(player, \"choose_yes_no\", None)\n    if not callable(chooser):\n        return None\n    try:\n        wants = bool(\n            chooser(\n                f\"Choose new targets for the copy of \"\n                f\"{getattr(spell, 'name', 'this spell')}?\"\n            )\n        )\n    except Exception:\n        return None\n    if not wants:\n        return None\n\n    get_targets = getattr(spell, \"get_targets\", None)\n    if not callable(get_targets):\n        return None\n    try:\n        requirements = get_targets(game)\n    except Exception:\n        return None\n    if not requirements:\n        return None\n\n    new_targets: list[Any] = []\n    for req in requirements:\n        legal: list[Any] = []\n        filter_fn = getattr(req, \"filter_fn\", None)\n        for p in game.players:\n            for obj in game.get_battlefield(p).get_all():\n                if filter_fn is None or filter_fn(obj):\n                    legal.append(obj)\n            if filter_fn is not None and filter_fn(p):\n                legal.append(p)\n        if not legal:\n            continue\n        try:\n            chosen = player.choose_target(legal, req)\n        except Exception:\n            chosen = legal[0]\n        new_targets.append(chosen)\n\n    return new_targets or None\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1823,"cache_read_input_tokens":98060,"cache_creation":{"ephemeral_5m_input_tokens":1823,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_015WsNuwKx3ww7UKaCjA1Mn7","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"1da8a994-1d97-4f45-aac1-791c33e44ad1","request_id":"req_011CbeCg4u9wtp4j2bMek2Kp","subagent_type":"Implementer","task_description":"Implement sos_226 + casualty framework"}
