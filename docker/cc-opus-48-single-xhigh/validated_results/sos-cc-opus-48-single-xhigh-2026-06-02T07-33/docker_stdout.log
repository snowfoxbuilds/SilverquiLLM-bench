{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TZwsx65QfvoTuykokm2Q1b","type":"tool_result","content":"300\t        set_miracle_cost(card, None)\n301\t    return miracle_paid\n302\t\n303\t\n304\tdef register_miracle_draw_hook(\n305\t    game: GameState,\n306\t    source: Any,\n307\t    controller: Any,\n308\t) -> None:\n309\t    \"\"\"Wire the draw-time miracle cast hook for *source*'s controller.\n310\t\n311\t    Registers (deduped per source) a :class:`~engine.events.DrawsCardTriggeredEvent`\n312\t    trigger that fires only when the drawing player draws a card carrying a\n313\t    granted miracle cost *and* it is the first card they drew this turn\n314\t    (:func:`is_first_draw_of_turn`).  When it fires it runs\n315\t    :func:`offer_miracle_cast` so the drawer may cast the freshly-drawn card for\n316\t    its miracle cost (CR 702.94a).\n317\t\n318\t    The hook is keyed to the firing event's drawing player and drawn card, so it\n319\t    works for whoever benefits from a granted miracle (here, the controller of\n320\t    Lorehold whose own draws are offered the cast).\n321\t    \"\"\"\n322\t    from engine.events import DrawsCardTriggeredEvent\n323\t    from engine.triggers import TriggerRegistration\n324\t\n325\t    registry = getattr(game, \"_miracle_draw_hooks\", None)\n326\t    if registry is None:\n327\t        registry = set()\n328\t        game._miracle_draw_hooks = registry  # type: ignore[attr-defined]\n329\t    if id(source) in registry:\n330\t        return\n331\t    registry.add(id(source))\n332\t\n333\t    def _condition(g: GameState, event: DrawsCardTriggeredEvent) -> bool:\n334\t        drawer = getattr(event, \"player\", None)\n335\t        drawn = getattr(event, \"card\", None)\n336\t        if drawer is None or drawn is None:\n337\t            return False\n338\t        # Only the first card drawn this turn is eligible (CR 702.94a).\n339\t        if not is_first_draw_of_turn(drawer):\n340\t            return False\n341\t        # The drawn card must carry a granted miracle cost.\n342\t        if not has_miracle(drawn):\n343\t            return False\n344\t        # Stash the qualifying (player, card) so the effect (which receives only\n345\t        # the game) can offer the cast for exactly this draw.  The trigger\n346\t        # manager pushes the effect onto the stack right after this returns True,\n347\t        # so a single matching draw is captured per fire.\n348\t        source._miracle_pending = (drawer, drawn)  # type: ignore[attr-defined]\n349\t        return True\n350\t\n351\t    def _effect(g: GameState) -> None:\n352\t        pending = getattr(source, \"_miracle_pending\", None)\n353\t        source._miracle_pending = None  # type: ignore[attr-defined]\n354\t        if pending is None:\n355\t            return\n356\t        drawer, drawn = pending\n357\t        # Re-verify the card is still in the drawer's hand and still granted\n358\t        # (it may have moved between trigger fire and resolution).\n359\t        if drawn is None or not has_miracle(drawn):\n360\t            return\n361\t        if not g.get_hand(drawer).contains(drawn):\n362\t            return\n363\t        offer_miracle_cast(g, drawer, drawn)\n364\t\n365\t    game.trigger_manager.register(\n366\t        TriggerRegistration(\n367\t            event_type=DrawsCardTriggeredEvent,\n368\t            condition=_condition,\n369\t            effect=_effect,\n370\t            source=source,\n371\t            controller=controller,\n372\t        )\n373\t    )\n374\t"}]},"parent_tool_use_id":"toolu_01SxABS2LYMPLt5MCvzy5rCk","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"d33f7531-639d-4902-b794-b99af1d0ddb7","timestamp":"2026-06-02T09:12:43.669Z","subagent_type":"Implementer","task_description":"Implement sos_201"}
