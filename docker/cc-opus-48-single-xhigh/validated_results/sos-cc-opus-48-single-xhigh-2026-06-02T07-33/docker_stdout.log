{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D62LcpnCDj1gkqKhyPUsYB","type":"tool_result","content":"1\t\"\"\"Card implementation for Great Hall of the Biblioplex.\n2\t\n3\tGreat Hall of the Biblioplex — Land:\n4\t\n5\t    {T}: Add {C}.\n6\t    {T}, Pay 1 life: Add one mana of any color.  Spend this mana only to cast\n7\t    an instant or sorcery spell.\n8\t    {5}: If this land isn't a creature, it becomes a 2/4 Wizard creature with\n9\t    \"Whenever you cast an instant or sorcery spell, this creature gets +1/+0\n10\t    until end of turn.\"  It's still a land.\n11\t\n12\tSOS collector number 257.\n13\t\n14\tThe \"spend this mana only to cast an instant or sorcery spell\" restriction, the\n15\tbecomes-a-creature animation, and the granted instant/sorcery pump trigger are\n16\tall built on additive engine mechanisms:\n17\t\n18\t* restricted mana — :func:`engine.mana.ManaPool.add_restricted` plus the\n19\t  spend-restriction check in :func:`engine.casting.cast_spell`;\n20\t* land animation — :func:`engine.animation.animate_land`;\n21\t* the granted pump trigger — :func:`engine.animation.register_instant_sorcery_pump`.\n22\t\"\"\"\n23\t\n24\tfrom __future__ import annotations\n25\t\n26\tfrom typing import TYPE_CHECKING, Any\n27\t\n28\tfrom engine.animation import (\n29\t    animate_land,\n30\t    is_animated,\n31\t    register_instant_sorcery_pump,\n32\t)\n33\tfrom engine.card import ActivatedAbility, Land, ManaAbility\n34\tfrom engine.mana import RESTRICT_INSTANT_SORCERY\n35\tfrom engine.types import Color, ManaCost, ManaType\n36\t\n37\tif TYPE_CHECKING:\n38\t    from engine.game_state import GameState\n39\t\n40\t\n41\t#: The animated body printed on Great Hall of the Biblioplex.\n42\t_ANIMATED_POWER = 2\n43\t_ANIMATED_TOUGHNESS = 4\n44\t_ANIMATED_SUBTYPE = \"Wizard\"\n45\t\n46\t#: The activation cost of the animation ability.\n47\t_ANIMATE_COST = ManaCost(generic=5)\n48\t\n49\t# Map a chosen Color to its corresponding ManaType (the any-color producer\n50\t# lets the controller pick any one of the five colors).\n51\t_COLOR_TO_MANA: dict[Color, ManaType] = {\n52\t    Color.WHITE: ManaType.WHITE,\n53\t    Color.BLUE: ManaType.BLUE,\n54\t    Color.BLACK: ManaType.BLACK,\n55\t    Color.RED: ManaType.RED,\n56\t    Color.GREEN: ManaType.GREEN,\n57\t}\n58\t\n59\t\n60\tclass GreatHallOfTheBiblioplex(Land):\n61\t    \"\"\"Great Hall of the Biblioplex — a colorless nonbasic man-land.\"\"\"\n62\t\n63\t    #: Card-level query surface for the any-color mana's spend restriction\n64\t    #: (\"spend this mana only to cast an instant or sorcery spell\").  Read by\n65\t    #: tests / tooling that want to know the land produces restricted mana.\n66\t    mana_spend_restriction: str = RESTRICT_INSTANT_SORCERY\n67\t    produces_restricted_mana: bool = True\n68\t\n69\t    def __init__(self, **kwargs: Any) -> None:\n70\t        kwargs.setdefault(\"name\", \"Great Hall of the Biblioplex\")\n71\t        kwargs.setdefault(\n72\t            \"rules_text\",\n73\t            \"{T}: Add {C}.\\n\"\n74\t            \"{T}, Pay 1 life: Add one mana of any color. Spend this mana only \"\n75\t            \"to cast an instant or sorcery spell.\\n\"\n76\t            \"{5}: If this land isn't a creature, it becomes a 2/4 Wizard \"\n77\t            'creature with \"Whenever you cast an instant or sorcery spell, '\n78\t            'this creature gets +1/+0 until end of turn.\" It\\'s still a land.',\n79\t        )\n80\t        super().__init__(**kwargs)\n81\t        # Animation state — a plain (unanimated) land has no power/toughness.\n82\t        self._animated: bool = False\n83\t        self._anim_base_power: int = _ANIMATED_POWER\n84\t        self._anim_base_toughness: int = _ANIMATED_TOUGHNESS\n85\t        self.modified_power: int = _ANIMATED_POWER\n86\t        self.modified_toughness: int = _ANIMATED_TOUGHNESS\n87\t        # Cache the ability surfaces so repeated calls return the same objects\n88\t        # (tests identify the any-color ability by identity against the\n89\t        # colorless one — ``ab is not colorless``).\n90\t        self._mana_abilities: list[ManaAbility] | None = None\n91\t        self._activated_abilities: list[ActivatedAbility] | None = None\n92\t\n93\t    # ------------------------------------------------------------------\n94\t    # Power / toughness — only meaningful while animated\n95\t    # ------------------------------------------------------------------\n96\t\n97\t    @property\n98\t    def power(self) -> int | None:\n99\t        \"\"\"Current power while animated; ``None`` for a plain land.\"\"\"\n100\t        if not self._animated:\n101\t            return None\n102\t        return self.modified_power\n103\t\n104\t    @property\n105\t    def toughness(self) -> int | None:\n106\t        \"\"\"Current toughness while animated; ``None`` for a plain land.\"\"\"\n107\t        if not self._animated:\n108\t            return None\n109\t        return self.modified_toughness\n110\t\n111\t    def _reset_characteristics(self) -> None:\n112\t        \"\"\"Reset card types/keywords; re-seed the animated body if animated.\n113\t\n114\t        The base reset restores ``card_types`` to LAND-only and clears\n115\t        keywords; the animation's durable Layer-4 effect re-adds CREATURE and\n116\t        the Layer 7b effect re-sets the base body.  We re-seed\n117\t        ``modified_power``/``modified_toughness`` here so that Layer 7c pump\n118\t        effects (applied after) accumulate on top of the 2/4 base each cycle.\n119\t        \"\"\"\n120\t        super()._reset_characteristics()\n121\t        if self._animated:\n122\t            self.modified_power = self._anim_base_power\n123\t            self.modified_toughness = self._anim_base_toughness\n124\t\n125\t    # ------------------------------------------------------------------\n126\t    # Controller resolution\n127\t    # ------------------------------------------------------------------\n128\t\n129\t    def _resolve_controller(self, game: \"GameState\") -> Any:\n130\t        \"\"\"Return the player who currently controls this land for *game*.\n131\t\n132\t        Mana / activated abilities add mana, pay life, and animate for \"you\" —\n133\t        the land's controller.  ``self.controller`` is the normal source of\n134\t        truth, but when it points at a player from a *different* game (test\n135\t        helpers probe abilities against throwaway games), it is resolved\n136\t        against *game*: the player whose battlefield holds this land, else the\n137\t        active player.  When ``self.controller`` is a genuine member of *game*\n138\t        it is returned unchanged, so ordinary play is unaffected.\n139\t        \"\"\"\n140\t        controller = self.controller\n141\t        if controller is not None and controller in game.players:\n142\t            return controller\n143\t        for player in game.players:\n144\t            if game.get_battlefield(player).contains(self):\n145\t                return player\n146\t        return game.active_player\n147\t\n148\t    # ------------------------------------------------------------------\n149\t    # Mana abilities\n150\t    # ------------------------------------------------------------------\n151\t\n152\t    def get_mana_abilities(self) -> list[ManaAbility]:\n153\t        if self._mana_abilities is not None:\n154\t            return self._mana_abilities\n155\t\n156\t        def colorless_cost(game: \"GameState\") -> bool:\n157\t            if self.is_tapped:\n158\t                return False\n159\t            self.is_tapped = True\n160\t            return True\n161\t\n162\t        def colorless_produce(game: \"GameState\") -> None:\n163\t            # Direct-pool mutation so the resolved controller (not a stale\n164\t            # ``self.controller`` left by a probe) receives the mana.\n165\t            controller = self._resolve_controller(game)\n166\t            if controller is not None:\n167\t                controller.mana_pool.add(ManaType.COLORLESS, 1)\n168\t\n169\t        def any_color_cost(game: \"GameState\") -> bool:\n170\t            # {T}, Pay 1 life.\n171\t            if self.is_tapped:\n172\t                return False\n173\t            controller = self._resolve_controller(game)\n174\t            if controller is not None:\n175\t                controller.life -= 1\n176\t            self.is_tapped = True\n177\t            return True\n178\t\n179\t        def any_color_produce(game: \"GameState\") -> None:\n180\t            controller = self._resolve_controller(game)\n181\t            if controller is None:\n182\t                return\n183\t            color_options = [\n184\t                Color.WHITE,\n185\t                Color.BLUE,\n186\t                Color.BLACK,\n187\t                Color.RED,\n188\t                Color.GREEN,\n189\t            ]\n190\t            chosen = controller.choose(\n191\t                color_options,\n192\t                \"Choose a color of mana to produce with Great Hall of the \"\n193\t                \"Biblioplex\",\n194\t            )\n195\t            mana_type = _COLOR_TO_MANA.get(chosen, chosen)\n196\t            # The produced mana may be spent only to cast an instant or sorcery\n197\t            # spell (enforced in engine.casting.cast_spell via the pool's\n198\t            # restriction record).\n199\t            controller.mana_pool.add_restricted(\n200\t                mana_type,\n201\t                1,\n202\t                restriction=RESTRICT_INSTANT_SORCERY,\n203\t                source=self,\n204\t            )\n205\t\n206\t        colorless = ManaAbility(\n207\t            cost=colorless_cost,\n208\t            mana_produced=colorless_produce,\n209\t            description=\"{T}: Add {C}.\",\n210\t        )\n211\t        any_color = ManaAbility(\n212\t            cost=any_color_cost,\n213\t            mana_produced=any_color_produce,\n214\t            description=(\n215\t                \"{T}, Pay 1 life: Add one mana of any color. Spend this mana \"\n216\t                \"only to cast an instant or sorcery spell.\"\n217\t            ),\n218\t        )\n219\t        # Tag the any-color ability with its spend restriction so a probe can\n220\t        # discover it at the ability level too.\n221\t        any_color.restriction = RESTRICT_INSTANT_SORCERY  # type: ignore[attr-defined]\n222\t        any_color.spend_restriction = RESTRICT_INSTANT_SORCERY  # type: ignore[attr-defined]\n223\t\n224\t        self._mana_abilities = [colorless, any_color]\n225\t        return self._mana_abilities\n226\t\n227\t    # ------------------------------------------------------------------\n228\t    # Activated ability — {5}: animate\n229\t    # ------------------------------------------------------------------\n230\t\n231\t    def get_activated_abilities(self) -> list[ActivatedAbility]:\n232\t        if self._activated_abilities is not None:\n233\t            return self._activated_abilities\n234\t\n235\t        def animate_cost(game: \"GameState\") -> bool:\n236\t            controller = self._resolve_controller(game)\n237\t            if controller is None:\n238\t                return False\n239\t            if not controller.mana_pool.can_pay(_ANIMATE_COST):\n240\t                return False\n241\t            return controller.mana_pool.pay(_ANIMATE_COST)\n242\t\n243\t        def animate_effect(game: \"GameState\") -> None:\n244\t            controller = self._resolve_controller(game)\n245\t            # \"If this land isn't a creature\" — guard against re-animation.\n246\t            if is_animated(game, self):\n247\t                return\n248\t            became = animate_land(\n249\t                game,\n250\t                self,\n251\t                _ANIMATED_POWER,\n252\t                _ANIMATED_TOUGHNESS,\n253\t                subtype=_ANIMATED_SUBTYPE,\n254\t                controller=controller,\n255\t            )\n256\t            if became:\n257\t                # Grant the \"whenever you cast an instant or sorcery spell,\n258\t                # this creature gets +1/+0 until end of turn\" trigger.\n259\t                register_instant_sorcery_pump(game, self, controller)\n260\t\n261\t        animate = ActivatedAbility(\n262\t            cost=animate_cost,\n263\t            effect=animate_effect,\n264\t            description=(\n265\t                \"{5}: If this land isn't a creature, it becomes a 2/4 Wizard \"\n266\t                \"creature with \\\"Whenever you cast an instant or sorcery spell, \"\n267\t                \"this creature gets +1/+0 until end of turn.\\\" It's still a land.\"\n268\t            ),\n269\t        )\n270\t        self._activated_abilities = [animate]\n271\t        return self._activated_abilities\n272\t"}]},"parent_tool_use_id":"toolu_01CbsKBgtu5hXmsenTvvH1UM","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"47782df9-d544-43bc-8d80-19d6f9567eaa","timestamp":"2026-06-02T10:19:18.290Z","subagent_type":"Tester","task_description":"Extend sos_257 tests"}
