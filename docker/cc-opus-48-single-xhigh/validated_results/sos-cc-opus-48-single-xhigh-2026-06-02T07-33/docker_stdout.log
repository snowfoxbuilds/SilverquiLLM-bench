{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_018YdY6hs6NGNf5hSKsHCSGT","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DhyeNJEa4KSpSg67uNxqJM","name":"Read","input":{"file_path":"/workspace/engine/affinity.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5470,"cache_read_input_tokens":72136,"cache_creation":{"ephemeral_5m_input_tokens":5470,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_013DvBFWmxzpqf1jHj4XNC9b","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"7168a215-1d0b-455d-87f4-e969270dc823","request_id":"req_011CbeFNuTFP3CNLJqmKmmR7","subagent_type":"Implementer","task_description":"Implement sos_257 + 3 engine mechanisms"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DhyeNJEa4KSpSg67uNxqJM","type":"tool_result","content":"1\t\"\"\"Affinity-keyword framework (Comprehensive Rules 702.41).\n2\t\n3\t*Affinity for [quality]* is a static ability that reduces the generic portion of\n4\ta spell's cost:\n5\t\n6\t    Affinity for creatures (This spell costs {1} less to cast for each creature\n7\t    you control.)\n8\t\n9\tA card normally carries affinity as a printed cost-reduction ability — that\n10\t*own* affinity is implemented with the established ``cost_reduction(self, game)``\n11\thook (sos_1 / fdn_167 Tolarian Terror), which the engine's\n12\t:func:`engine.casting.get_cost_reduction` clamps to the spell's generic portion.\n13\t\n14\tWitherbloom, the Balancer also *grants* \"affinity for creatures\" to every\n15\tinstant and sorcery **spell** its controller casts.  The engine had no support\n16\tfor a granting permanent contributing a per-spell cost reduction, so this module\n17\tadds it *additively* — no existing engine symbol is renamed, moved, or deleted.\n18\tIt mirrors :mod:`engine.casualty` / :mod:`engine.miracle` / :mod:`engine.paradigm`.\n19\t\n20\tThe mechanic has two observable parts:\n21\t\n22\t1. **The grant surface.**  A *granted affinity-for-creatures* flag is recorded on\n23\t   the affected spell (``spell.affinity_for_creatures = True``) and is also\n24\t   queryable via :func:`grants_affinity_for_creatures`.  A continuous-grant source\n25\t   (Witherbloom) installs / refreshes the grant via\n26\t   :func:`grant_affinity_to_hand`, which only ever writes the flag onto\n27\t   instants/sorceries in *its controller's* hand and clears stale grants from\n28\t   cards that have left the hand.\n29\t\n30\t2. **The granted cost reduction (driven through the cast/cost pipeline).**  A\n31\t   granting permanent registers, per controller, a *granted reduction* — a\n32\t   callable ``(game, spell, controller) -> int`` returning how much {1}-less the\n33\t   grant gives a particular spell (for affinity for creatures: the number of\n34\t   creatures the controller controls).  :func:`get_granted_reduction` sums the\n35\t   contributions of every registered grant that applies to a spell, and\n36\t   :func:`engine.casting.get_cost_reduction` adds that to the cast card's own\n37\t   ``cost_reduction(game)`` hook before clamping to the spell's generic portion.\n38\t   With no grant registered the sum is 0, so existing cost-reduction behaviour\n39\t   (sos_1, fdn_167) is unchanged.\n40\t\n41\t\"Affinity\" is a *printed keyword label*, not an evergreen keyword, so no member\n42\tis added to :class:`engine.types.Keyword` (that enum is frozen at 16 members).\n43\t\"\"\"\n44\t\n45\tfrom __future__ import annotations\n46\t\n47\tfrom typing import TYPE_CHECKING, Any, Callable\n48\t\n49\tfrom engine.types import CardType, Zone\n50\t\n51\tif TYPE_CHECKING:\n52\t    from engine.game_state import GameState\n53\t\n54\t\n55\t#: Type of a granted-reduction resolver: ``(game, spell, controller) -> int``.\n56\tReductionResolver = Callable[[Any, Any, Any], int]\n57\t\n58\t\n59\t# ---------------------------------------------------------------------------\n60\t# Grant surface — read / write the granted affinity flag on a spell\n61\t# ---------------------------------------------------------------------------\n62\t\n63\t\n64\tdef is_instant_or_sorcery(card: Any) -> bool:\n65\t    \"\"\"Return ``True`` if *card* is an instant or sorcery (the granted types).\"\"\"\n66\t    card_types = getattr(card, \"card_types\", set())\n67\t    return CardType.INSTANT in card_types or CardType.SORCERY in card_types\n68\t\n69\t\n70\tdef grants_affinity_for_creatures(card: Any) -> bool:\n71\t    \"\"\"Return ``True`` if *card* currently carries a granted affinity-for-creatures.\"\"\"\n72\t    return bool(getattr(card, \"affinity_for_creatures\", False))\n73\t\n74\t\n75\tdef set_affinity_for_creatures(card: Any, granted: bool) -> None:\n76\t    \"\"\"Write (or clear) the granted affinity-for-creatures flag on *card*.\n77\t\n78\t    Passing ``False`` clears the grant (removes the ``affinity_for_creatures``\n79\t    attribute so a stale grant never lingers on a card that has left the granting\n80\t    zone).\n81\t    \"\"\"\n82\t    if not granted:\n83\t        if hasattr(card, \"affinity_for_creatures\"):\n84\t            try:\n85\t                delattr(card, \"affinity_for_creatures\")\n86\t            except AttributeError:\n87\t                card.affinity_for_creatures = False  # type: ignore[attr-defined]\n88\t        if hasattr(card, \"_affinity_grant_source\"):\n89\t            try:\n90\t                delattr(card, \"_affinity_grant_source\")\n91\t            except AttributeError:\n92\t                pass\n93\t        return\n94\t    card.affinity_for_creatures = True  # type: ignore[attr-defined]\n95\t\n96\t\n97\t# ---------------------------------------------------------------------------\n98\t# Per-game registry of cards a given source has flagged with the grant\n99\t# ---------------------------------------------------------------------------\n100\t\n101\t\n102\tdef _flagged_registry(game: GameState) -> dict[int, set[int]]:\n103\t    \"\"\"Return (creating if necessary) the per-game affinity-flag registry.\n104\t\n105\t    Maps ``id(source)`` to the set of ``id(card)`` it last flagged, so a refresh\n106\t    can clear flags from cards that have since left the granting zone.  Stored\n107\t    lazily on the game object — no ``GameState.__init__`` change.\n108\t    \"\"\"\n109\t    registry = getattr(game, \"_affinity_flags\", None)\n110\t    if registry is None:\n111\t        registry = {}\n112\t        game._affinity_flags = registry  # type: ignore[attr-defined]\n113\t    return registry\n114\t\n115\t\n116\tdef grant_affinity_to_hand(\n117\t    game: GameState,\n118\t    source: Any,\n119\t    controller: Any,\n120\t) -> list[Any]:\n121\t    \"\"\"Flag every instant/sorcery in *controller*'s hand as having affinity.\n122\t\n123\t    This is the observable half of Witherbloom's continuous static ability:\n124\t    while the source is on the battlefield, every instant and sorcery spell its\n125\t    controller casts \"has affinity for creatures\".  The flag is written onto each\n126\t    such hand card (``card.affinity_for_creatures = True``) and is queryable via\n127\t    :func:`grants_affinity_for_creatures`.\n128\t\n129\t    The grant is *scoped*:\n130\t\n131\t    * only instants and sorceries are flagged (creatures, lands, etc. are not);\n132\t    * only cards in *controller*'s hand are flagged (an opponent's hand is left\n133\t      untouched).\n134\t\n135\t    Calling this again refreshes the flag: cards that have left the controller's\n136\t    hand since the last refresh have their (this-source) flag cleared so a stale\n137\t    grant never lingers.  Returns the list of hand cards now carrying the flag.\n138\t    \"\"\"\n139\t    if controller is None:\n140\t        return []\n141\t\n142\t    registry = _flagged_registry(game)\n143\t    previously = registry.get(id(source), set())\n144\t\n145\t    hand = controller.zones[Zone.HAND]\n146\t    granted: list[Any] = []\n147\t    now_ids: set[int] = set()\n148\t\n149\t    for card in hand.get_all():\n150\t        if not is_instant_or_sorcery(card):\n151\t            continue\n152\t        set_affinity_for_creatures(card, True)\n153\t        card._affinity_grant_source = source  # type: ignore[attr-defined]\n154\t        granted.append(card)\n155\t        now_ids.add(id(card))\n156\t\n157\t    stale = previously - now_ids\n158\t    if stale:\n159\t        _clear_flags_for_ids(game, source, stale)\n160\t\n161\t    registry[id(source)] = now_ids\n162\t    return granted\n163\t\n164\t\n165\tdef _clear_flags_for_ids(game: GameState, source: Any, card_ids: set[int]) -> None:\n166\t    \"\"\"Clear *source*'s affinity flag from any card in *card_ids* across zones.\"\"\"\n167\t    for player in game.players:\n168\t        for zone in Zone:\n169\t            container = player.zones[zone]\n170\t            for card in list(container.get_all()):\n171\t                if (\n172\t                    id(card) in card_ids\n173\t                    and getattr(card, \"_affinity_grant_source\", None) is source\n174\t                ):\n175\t                    set_affinity_for_creatures(card, False)\n176\t\n177\t\n178\tdef clear_affinity_flags(game: GameState, source: Any) -> None:\n179\t    \"\"\"Clear every affinity flag *source* placed (e.g. when it leaves play).\"\"\"\n180\t    registry = _flagged_registry(game)\n181\t    granted = registry.pop(id(source), set())\n182\t    if not granted:\n183\t        return\n184\t    _clear_flags_for_ids(game, source, granted)\n185\t\n186\t\n187\t# ---------------------------------------------------------------------------\n188\t# Granted-reduction registry — drive the granted cost reduction through the\n189\t# cast/cost pipeline (mirrors engine.casualty / engine.miracle grant registries)\n190\t# ---------------------------------------------------------------------------\n191\t\n192\t\n193\tdef _grant_registry(game: GameState) -> dict[int, dict[str, Any]]:\n194\t    \"\"\"Return (creating if necessary) the per-game granted-reduction registry.\n195\t\n196\t    Maps ``id(source)`` to a record ``{\"controller\", \"applies\", \"resolver\"}``:\n197\t\n198\t    * ``controller`` — the player whose spells the grant applies to;\n199\t    * ``applies`` — predicate ``(game, spell, controller) -> bool`` deciding\n200\t      whether a given spell receives the grant (e.g. controller's instants /\n201\t      sorceries, source on the battlefield);\n202\t    * ``resolver`` — :data:`ReductionResolver` returning the {1}-less count for a\n203\t      qualifying spell (for affinity for creatures: how many creatures the\n204\t      controller controls).\n205\t\n206\t    Stored lazily on the game object — no ``GameState.__init__`` change.\n207\t    \"\"\"\n208\t    registry = getattr(game, \"_affinity_grants\", None)\n209\t    if registry is None:\n210\t        registry = {}\n211\t        game._affinity_grants = registry  # type: ignore[attr-defined]\n212\t    return registry\n213\t\n214\t\n215\tdef register_affinity_grant(\n216\t    game: GameState,\n217\t    source: Any,\n218\t    controller: Any,\n219\t    resolver: ReductionResolver,\n220\t    applies: Callable[[Any, Any, Any], bool],\n221\t) -> None:\n222\t    \"\"\"Register *source*'s granted per-spell cost reduction (idempotent per source).\n223\t\n224\t    When a spell is cast, :func:`get_granted_reduction` consults every registered\n225\t    grant whose ``applies(game, spell, controller)`` predicate returns ``True``\n226\t    and sums each grant's ``resolver(game, spell, controller)`` contribution.\n227\t    :func:`engine.casting.get_cost_reduction` adds that sum to the cast card's own\n228\t    ``cost_reduction(game)`` before clamping to the spell's generic portion.\n229\t\n230\t    Re-registering the same source overwrites its record (so a refreshed grant\n231\t    keeps the latest controller/resolver) — keyed by ``id(source)``.\n232\t    \"\"\"\n233\t    _grant_registry(game)[id(source)] = {\n234\t        \"controller\": controller,\n235\t        \"applies\": applies,\n236\t        \"resolver\": resolver,\n237\t    }\n238\t\n239\t\n240\tdef clear_affinity_grant(game: GameState, source: Any) -> None:\n241\t    \"\"\"Remove *source*'s granted-reduction record (e.g. when it leaves play).\"\"\"\n242\t    _grant_registry(game).pop(id(source), None)\n243\t\n244\t\n245\tdef get_granted_reduction(game: GameState, spell: Any, controller: Any) -> int:\n246\t    \"\"\"Return the total granted generic reduction for *controller* casting *spell*.\n247\t\n248\t    Sums the contribution of every registered grant whose ``applies`` predicate\n249\t    accepts ``(game, spell, controller)``.  Returns ``0`` when no grant applies —\n250\t    so a spell with no granting permanent in play is reduced only by its own\n251\t    ``cost_reduction`` hook (existing behaviour is unchanged).\n252\t    \"\"\"\n253\t    registry = getattr(game, \"_affinity_grants\", None)\n254\t    if not registry:\n255\t        return 0\n256\t    total = 0\n257\t    for record in list(registry.values()):\n258\t        applies = record.get(\"applies\")\n259\t        resolver = record.get(\"resolver\")\n260\t        if resolver is None:\n261\t            continue\n262\t        try:\n263\t            if applies is not None and not applies(game, spell, controller):\n264\t                continue\n265\t            contribution = resolver(game, spell, controller)\n266\t        except Exception:\n267\t            continue\n268\t        if contribution and contribution > 0:\n269\t            total += int(contribution)\n270\t    return total\n271\t"}]},"parent_tool_use_id":"toolu_013DvBFWmxzpqf1jHj4XNC9b","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"6426411f-2964-499b-b936-5a9085424347","timestamp":"2026-06-02T10:08:09.432Z","subagent_type":"Implementer","task_description":"Implement sos_257 + 3 engine mechanisms"}
