{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Lt6PNQRXjhnPni2thqqK2w","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_97/card_impl.py b/cards/sos/sos_97/card_impl.py\n2\tindex df568b7..bd40047 100644\n3\t--- a/cards/sos/sos_97/card_impl.py\n4\t+++ b/cards/sos/sos_97/card_impl.py\n5\t@@ -2,15 +2,178 @@\n6\t \n7\t from __future__ import annotations\n8\t \n9\t-from engine.card import CardImpl\n10\t+from typing import TYPE_CHECKING, Any\n11\t \n12\t-from typing import TYPE_CHECKING\n13\t+from engine.card import LoyaltyAbility, Planeswalker\n14\t+from engine.types import CardType, ManaCost, Supertype, TargetRequirement, Zone\n15\t \n16\t if TYPE_CHECKING:\n17\t     from engine.game_state import GameState\n18\t+    from engine.player import Player\n19\t \n20\t \n21\t-class RalZarekGuestLecturer(CardImpl):\n22\t-    \"\"\"TODO: Implement Ral Zarek, Guest Lecturer.\"\"\"\n23\t+class RalZarekGuestLecturer(Planeswalker):\n24\t+    \"\"\"Ral Zarek, Guest Lecturer — {1}{B}{B} Legendary Planeswalker — Ral — 3.\n25\t \n26\t-    pass\n27\t+    +1: Surveil 2.\n28\t+    −1: Any number of target players each discard a card.\n29\t+    −2: Return target creature card with mana value 3 or less from your\n30\t+        graveyard to the battlefield.\n31\t+    −7: Flip five coins. Target opponent skips their next X turns, where X\n32\t+        is the number of coins that came up heads.\n33\t+\n34\t+    SOS collector number 97.\n35\t+    \"\"\"\n36\t+\n37\t+    def __init__(self, **kwargs: Any) -> None:\n38\t+        kwargs.setdefault(\"name\", \"Ral Zarek, Guest Lecturer\")\n39\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{B}{B}\"))\n40\t+        kwargs.setdefault(\"starting_loyalty\", 3)\n41\t+        kwargs.setdefault(\"supertypes\", set())\n42\t+        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.LEGENDARY}\n43\t+        kwargs.setdefault(\"subtypes\", set())\n44\t+        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Ral\"}\n45\t+        kwargs.setdefault(\n46\t+            \"rules_text\",\n47\t+            \"+1: Surveil 2.\\n\"\n48\t+            \"−1: Any number of target players each discard a card.\\n\"\n49\t+            \"−2: Return target creature card with mana value 3 or less from \"\n50\t+            \"your graveyard to the battlefield.\\n\"\n51\t+            \"−7: Flip five coins. Target opponent skips their next X turns, \"\n52\t+            \"where X is the number of coins that came up heads.\",\n53\t+        )\n54\t+        super().__init__(**kwargs)\n55\t+\n56\t+    # ------------------------------------------------------------------\n57\t+    # Targeting\n58\t+    # ------------------------------------------------------------------\n59\t+\n60\t+    def get_targets(self, game: GameState) -> list[Any]:\n61\t+        \"\"\"Declare the graveyard-scoped target requirement for −2.\n62\t+\n63\t+        The −2 ability returns a *creature card with mana value 3 or less*\n64\t+        from the controller's graveyard.  The other abilities target players\n65\t+        (\"any number of target players\", \"target opponent\"); those are\n66\t+        resolved via the engine's player-choice plumbing and stashed on\n67\t+        ``_resolve_targets`` / ``_resolve_target`` and so do not need a\n68\t+        battlefield/graveyard ``TargetRequirement`` here.\n69\t+        \"\"\"\n70\t+        controller = self.controller or game.active_player\n71\t+\n72\t+        def _reanimate_filter(obj: Any) -> bool:\n73\t+            if CardType.CREATURE not in getattr(obj, \"card_types\", set()):\n74\t+                return False\n75\t+            cost = getattr(obj, \"mana_cost\", None)\n76\t+            mana_value = cost.cmc if cost is not None else 0\n77\t+            return mana_value <= 3\n78\t+\n79\t+        return [\n80\t+            TargetRequirement(\n81\t+                filter_fn=_reanimate_filter,\n82\t+                description=\"creature card with mana value 3 or less in your graveyard\",\n83\t+                zone=Zone.GRAVEYARD,\n84\t+            )\n85\t+        ]\n86\t+\n87\t+    # ------------------------------------------------------------------\n88\t+    # Loyalty abilities\n89\t+    # ------------------------------------------------------------------\n90\t+\n91\t+    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n92\t+        pw = self\n93\t+\n94\t+        def _plus1(game: Any) -> None:\n95\t+            \"\"\"+1: Surveil 2.\n96\t+\n97\t+            Look at the top two cards of your library; for each, the\n98\t+            controller may put it into the graveyard.  Processed\n99\t+            top-card-first via ``choose_yes_no`` (engine surveil convention,\n100\t+            see ``cards/fdn/fdn_157`` Lightshell Duo).\n101\t+            \"\"\"\n102\t+            controller = pw.controller\n103\t+            if controller is None:\n104\t+                return\n105\t+            library = controller.zones[Zone.LIBRARY]\n106\t+            cards = list(library.get_all())\n107\t+            if not cards:\n108\t+                return\n109\t+            # Top of library is the last element; take up to two, top first.\n110\t+            top_cards = cards[-min(2, len(cards)):]\n111\t+            for card in reversed(top_cards):\n112\t+                put_in_gy = controller.choose_yes_no(\n113\t+                    f\"Surveil: Put {getattr(card, 'name', 'card')} into your graveyard?\"\n114\t+                )\n115\t+                if put_in_gy:\n116\t+                    library.remove(card)\n117\t+                    controller.zones[Zone.GRAVEYARD].add(card)\n118\t+\n119\t+        def _minus1(game: Any) -> None:\n120\t+            \"\"\"−1: Any number of target players each discard a card.\"\"\"\n121\t+            from engine.game import discard\n122\t+\n123\t+            targets = getattr(pw, \"_resolve_targets\", None) or []\n124\t+            for player in targets:\n125\t+                hand = player.zones[Zone.HAND].get_all()\n126\t+                if hand:\n127\t+                    # The player chooses which card to discard; with no\n128\t+                    # scripted choice, discard deterministically from the end.\n129\t+                    card = None\n130\t+                    chooser = getattr(player, \"choose_card\", None)\n131\t+                    if chooser is not None:\n132\t+                        try:\n133\t+                            card = chooser(hand, \"discard a card\")\n134\t+                        except Exception:\n135\t+                            card = None\n136\t+                    if card is None or card not in hand:\n137\t+                        card = hand[-1]\n138\t+                    discard(game, player, card)\n139\t+\n140\t+        def _minus2(game: Any) -> None:\n141\t+            \"\"\"−2: Return target creature (mv ≤ 3) from your graveyard to play.\"\"\"\n142\t+            from engine.zones import move_to_zone\n143\t+\n144\t+            target = getattr(pw, \"_resolve_target\", None)\n145\t+            controller = pw.controller\n146\t+            if target is None or controller is None:\n147\t+                return\n148\t+            graveyard = controller.zones[Zone.GRAVEYARD]\n149\t+            if not graveyard.contains(target):\n150\t+                return\n151\t+            # Enters under the planeswalker's controller's control.\n152\t+            target.controller = controller\n153\t+            move_to_zone(game, target, Zone.GRAVEYARD, Zone.BATTLEFIELD)\n154\t+\n155\t+        def _minus7(game: Any) -> None:\n156\t+            \"\"\"−7: Flip five coins. Target opponent skips their next X turns.\"\"\"\n157\t+            from engine.game import add_skipped_turns, flip_coins\n158\t+\n159\t+            target = getattr(pw, \"_resolve_target\", None)\n160\t+            if target is None:\n161\t+                return\n162\t+            heads = flip_coins(game, 5)\n163\t+            add_skipped_turns(game, target, heads)\n164\t+\n165\t+        return [\n166\t+            LoyaltyAbility(\n167\t+                loyalty_cost=+1,\n168\t+                effect=_plus1,\n169\t+                description=\"+1: Surveil 2.\",\n170\t+            ),\n171\t+            LoyaltyAbility(\n172\t+                loyalty_cost=-1,\n173\t+                effect=_minus1,\n174\t+                description=\"−1: Any number of target players each discard a card.\",\n175\t+            ),\n176\t+            LoyaltyAbility(\n177\t+                loyalty_cost=-2,\n178\t+                effect=_minus2,\n179\t+                description=\"−2: Return target creature card with mana value 3 or \"\n180\t+                \"less from your graveyard to the battlefield.\",\n181\t+            ),\n182\t+            LoyaltyAbility(\n183\t+                loyalty_cost=-7,\n184\t+                effect=_minus7,\n185\t+                description=\"−7: Flip five coins. Target opponent skips their next \"\n186\t+                \"X turns, where X is the number of heads.\",\n187\t+            ),\n188\t+        ]\n189\tdiff --git a/engine/game.py b/engine/game.py\n190\tindex 46e4195..00d75ae 100644\n191\t--- a/engine/game.py\n192\t+++ b/engine/game.py\n193\t@@ -473,6 +473,108 @@ def untap(game: GameState, permanent: Any) -> None:\n194\t         permanent.is_tapped = False\n195\t \n196\t \n197\t+# ---------------------------------------------------------------------------\n198\t+# Randomness — coin flips (CR 705)\n199\t+# ---------------------------------------------------------------------------\n200\t+\n201\t+def get_rng(game: GameState) -> Any:\n202\t+    \"\"\"Return the game's random-number generator, creating it on demand.\n203\t+\n204\t+    The RNG is a :class:`random.Random` instance lazily attached to the\n205\t+    game as ``game._rng`` (no :class:`GameState.__init__` change required —\n206\t+    keeps the addition fully additive).  Unseeded, it behaves as a fair\n207\t+    source of randomness; tests can make it deterministic via\n208\t+    :func:`seed_rng`.\n209\t+\n210\t+    Parameters:\n211\t+        game: The current game state.\n212\t+\n213\t+    Returns:\n214\t+        The per-game :class:`random.Random` instance.\n215\t+    \"\"\"\n216\t+    import random as _random\n217\t+\n218\t+    rng = getattr(game, \"_rng\", None)\n219\t+    if rng is None:\n220\t+        rng = _random.Random()\n221\t+        game._rng = rng\n222\t+    return rng\n223\t+\n224\t+\n225\t+def seed_rng(game: GameState, seed: Any) -> None:\n226\t+    \"\"\"Seed (or re-seed) the game's RNG for deterministic randomness.\n227\t+\n228\t+    Tests can call this to force a reproducible sequence of coin flips\n229\t+    (CR 705) — e.g. ``seed_rng(game, 0)`` then :func:`flip_coins` yields a\n230\t+    fixed, repeatable number of heads.  Production code never seeds, so the\n231\t+    default behaviour stays a fair coin.\n232\t+\n233\t+    Parameters:\n234\t+        game: The current game state.\n235\t+        seed: Any value accepted by :meth:`random.Random.seed`.\n236\t+    \"\"\"\n237\t+    get_rng(game).seed(seed)\n238\t+\n239\t+\n240\t+def flip_coin(game: GameState) -> bool:\n241\t+    \"\"\"Flip a single fair coin (CR 705).\n242\t+\n243\t+    Returns ``True`` for heads and ``False`` for tails using the game's\n244\t+    seedable RNG (see :func:`get_rng` / :func:`seed_rng`).\n245\t+\n246\t+    Parameters:\n247\t+        game: The current game state.\n248\t+\n249\t+    Returns:\n250\t+        ``True`` if the coin came up heads, ``False`` if tails.\n251\t+    \"\"\"\n252\t+    return get_rng(game).random() < 0.5\n253\t+\n254\t+\n255\t+def flip_coins(game: GameState, n: int) -> int:\n256\t+    \"\"\"Flip *n* fair coins and return the number that came up heads (CR 705).\n257\t+\n258\t+    Backed by the game's seedable RNG so tests can force a known result:\n259\t+    seed via :func:`seed_rng`, then assert the returned head count.  With\n260\t+    no seed the flips are fair and independent.\n261\t+\n262\t+    Parameters:\n263\t+        game: The current game state.\n264\t+        n: The number of coins to flip (``0`` returns ``0``).\n265\t+\n266\t+    Returns:\n267\t+        The number of coins (``0..n``) that came up heads.\n268\t+    \"\"\"\n269\t+    if n <= 0:\n270\t+        return 0\n271\t+    return sum(1 for _ in range(n) if flip_coin(game))\n272\t+\n273\t+\n274\t+# ---------------------------------------------------------------------------\n275\t+# Turn modification — skipped turns\n276\t+# ---------------------------------------------------------------------------\n277\t+\n278\t+def add_skipped_turns(game: GameState, player: Player, amount: int = 1) -> None:\n279\t+    \"\"\"Make *player* skip their next *amount* turns.\n280\t+\n281\t+    Increments the per-player ``skipped_turns`` counter (see\n282\t+    :class:`engine.player.Player`).  The counter is consumed during turn\n283\t+    rotation in :meth:`GameState.advance_phase`: each time it would become\n284\t+    *player*'s turn while ``skipped_turns > 0``, the counter is decremented\n285\t+    and that turn is passed to the next player.  This mirrors the additive\n286\t+    nature of the existing ``extra_turns`` FIFO queue.\n287\t+\n288\t+    Parameters:\n289\t+        game: The current game state.\n290\t+        player: The player who will skip turns.\n291\t+        amount: Number of turns to skip (non-positive amounts are ignored).\n292\t+    \"\"\"\n293\t+    if amount <= 0 or player is None:\n294\t+        return\n295\t+    current = getattr(player, \"skipped_turns\", 0)\n296\t+    player.skipped_turns = current + amount\n297\t+\n298\t+\n299\t # ---------------------------------------------------------------------------\n300\t # Game loop\n301\t # ---------------------------------------------------------------------------\n302\tdiff --git a/engine/game_state.py b/engine/game_state.py\n303\tindex eaaff47..d62a3f8 100644\n304\t--- a/engine/game_state.py\n305\t+++ b/engine/game_state.py\n306\t@@ -147,21 +147,55 @@ class GameState:\n307\t         else:\n308\t             # End of turn — wrap around.\n309\t             self.turn_number += 1\n310\t-            if self.extra_turns:\n311\t-                # ENGINE LIMITATION: Extra turns queue (FIFO). Pop the\n312\t-                # next player seat index; that player gets the next turn.\n313\t-                # Normal rotation is NOT advanced — extra turns are\n314\t-                # inserted before the normal next turn.\n315\t-                self.active_player_index = self.extra_turns.pop(0)\n316\t-            else:\n317\t-                self.active_player_index = self._normal_next_index\n318\t-                self._normal_next_index = 1 - self._normal_next_index\n319\t+            self.active_player_index = self._pick_next_active_index()\n320\t             self.priority_player_index = self.active_player_index\n321\t             self.phase = _TURN_SEQUENCE[0][0]\n322\t             self.step = _TURN_SEQUENCE[0][1]\n323\t \n324\t         self.empty_mana_pools()\n325\t \n326\t+    def _next_active_index_raw(self) -> int:\n327\t+        \"\"\"Pick the next active seat index using extra-turns / normal rotation.\n328\t+\n329\t+        Pops from the ``extra_turns`` FIFO if present (extra turns are\n330\t+        *inserted* and do not advance the normal rotation); otherwise uses\n331\t+        ``_normal_next_index`` and flips it.  Does NOT consider skip-turn\n332\t+        effects — that is layered on top in :meth:`_pick_next_active_index`.\n333\t+        \"\"\"\n334\t+        if self.extra_turns:\n335\t+            # ENGINE LIMITATION: Extra turns queue (FIFO). Pop the next\n336\t+            # player seat index; that player gets the next turn. Normal\n337\t+            # rotation is NOT advanced — extra turns are inserted before\n338\t+            # the normal next turn.\n339\t+            return self.extra_turns.pop(0)\n340\t+        idx = self._normal_next_index\n341\t+        self._normal_next_index = 1 - self._normal_next_index\n342\t+        return idx\n343\t+\n344\t+    def _pick_next_active_index(self) -> int:\n345\t+        \"\"\"Return the next active seat, consuming skip-turn effects.\n346\t+\n347\t+        Mirrors the additive ``extra_turns`` design: when the player who\n348\t+        would become active has ``skipped_turns > 0``, that counter is\n349\t+        decremented and the turn is passed to the next player (which may in\n350\t+        turn be skipped).  The loop is bounded by the number of players times\n351\t+        the outstanding skips so it always terminates; if every remaining\n352\t+        candidate is skipped it falls back to the last computed seat.\n353\t+        \"\"\"\n354\t+        # Total outstanding skips bound the loop so it can never spin forever.\n355\t+        max_iterations = len(self.players) + sum(\n356\t+            max(0, getattr(p, \"skipped_turns\", 0)) for p in self.players\n357\t+        )\n358\t+        idx = self._next_active_index_raw()\n359\t+        for _ in range(max_iterations):\n360\t+            player = self.players[idx]\n361\t+            if getattr(player, \"skipped_turns\", 0) > 0:\n362\t+                player.skipped_turns -= 1\n363\t+                idx = self._next_active_index_raw()\n364\t+            else:\n365\t+                break\n366\t+        return idx\n367\t+\n368\t     def empty_mana_pools(self) -> None:\n369\t         \"\"\"Empty all players' mana pools — called on each phase/step transition.\"\"\"\n370\t         for player in self.players:\n371\tdiff --git a/engine/player.py b/engine/player.py\n372\tindex 9d66c29..dc647e0 100644\n373\t--- a/engine/player.py\n374\t+++ b/engine/player.py\n375\t@@ -35,6 +35,11 @@ class Player(ABC):\n376\t         self.has_lost: bool = False\n377\t         self.land_plays_remaining: int = 1\n378\t         self.drawn_from_empty_library: bool = False\n379\t+        # Number of upcoming turns this player must skip (CR 720.5).  Consumed\n380\t+        # during turn rotation in :meth:`GameState.advance_phase`, analogous to\n381\t+        # the engine's existing ``extra_turns`` FIFO queue.  See\n382\t+        # :func:`engine.game.add_skipped_turns`.\n383\t+        self.skipped_turns: int = 0\n384\t \n385\t     @abstractmethod\n386\t     def choose_target(self, options: Any, requirement: Any) -> Any:\n387\t"}]},"parent_tool_use_id":"toolu_01FLN5x2mJgycms39NgV7mjz","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"819bc14a-8c5b-4dad-a3ad-ef64fcae01c5","timestamp":"2026-06-02T08:44:44.712Z","subagent_type":"Reviewer","task_description":"Review sos_97 implementation"}
