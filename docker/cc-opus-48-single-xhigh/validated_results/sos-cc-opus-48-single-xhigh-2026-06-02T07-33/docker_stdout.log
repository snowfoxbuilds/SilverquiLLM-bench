{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LrJUkmmwG52NtA8GdtZSa1","type":"tool_result","content":"485\tclass TestLoreholdMiracleDrawCast:\n486\t    \"\"\"While Lorehold is on the battlefield, the first instant/sorcery its\n487\t    controller draws each turn may be cast for the miracle cost {2} as it is\n488\t    drawn (CR 702.94a). The draw-time hook is wired by ``register_triggers``\n489\t    and fires through the engine's ``DrawsCardTriggeredEvent`` pipeline.\"\"\"\n490\t\n491\t    def _setup(self, controller_index: int = 0):\n492\t        \"\"\"Lorehold on p1's battlefield with its triggers (and draw hook) wired.\"\"\"\n493\t        game = create_game()\n494\t        p1 = game.players[0]\n495\t        p2 = game.players[1]\n496\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n497\t        set_board_state(game, 0, battlefield=[card])\n498\t        card.register_triggers(game)\n499\t        return game, p1, p2, card\n500\t\n501\t    def test_first_draw_accept_casts_for_two(self) -> None:\n502\t        \"\"\"Accepting the miracle offer on the turn's first draw casts the drawn\n503\t        instant: it leaves the controller's hand and resolves to the graveyard.\n504\t        The miracle hook must put its offer on the stack as a consequence of the\n505\t        draw (so a missing hook fails here rather than passing vacuously).\"\"\"\n506\t        from engine import game as game_mod\n507\t\n508\t        game, p1, p2, card = self._setup()\n509\t        top = _expensive_instant(\"Accept Me\")\n510\t        _put_on_top_of_library(game, p1, top)\n511\t        p1.cards_drawn_this_turn = 0  # the upcoming draw is the turn's first\n512\t        set_board_state(game, 0, mana={ManaType.COLORLESS: 2})\n513\t        p1._script.append(True)  # accept the miracle offer\n514\t\n515\t        drawn = game_mod.draw_card(game, p1)\n516\t        assert drawn is top, \"draw_card must fetch the top of library\"\n517\t        # The draw fires the miracle hook, which puts the cast offer on the stack.\n518\t        assert not game.stack.is_empty(), (\n519\t            \"the first-draw miracle offer must hit the stack as a result of the draw\"\n520\t        )\n521\t        _resolve_full_stack(game)\n522\t\n523\t        # Accepted: the instant was cast (left hand) and resolved to graveyard.\n524\t        assert not game.get_hand(p1).contains(top)\n525\t        assert game.get_graveyard(p1).contains(top)\n526\t\n527\t    def test_first_draw_accept_charges_exactly_two(self) -> None:\n528\t        \"\"\"The accepted miracle cast pays only the miracle cost {2}, NOT the\n529\t        card's printed {4}{R}{R}. Starting the pool at five mana, exactly two are\n530\t        spent (three remain). The printed mana cost is left intact afterward.\"\"\"\n531\t        from engine import game as game_mod\n532\t\n533\t        game, p1, p2, card = self._setup()\n534\t        top = _expensive_instant(\"Charge Me\")\n535\t        printed_cmc = top.mana_cost.cmc\n536\t        _put_on_top_of_library(game, p1, top)\n537\t        p1.cards_drawn_this_turn = 0\n538\t        # Five generic mana: enough for {2} (and far short of the printed {6}),\n539\t        # so 'charged exactly two' is observable as 'three left'.\n540\t        set_board_state(game, 0, mana={ManaType.COLORLESS: 5})\n541\t        p1._script.append(True)\n542\t\n543\t        game_mod.draw_card(game, p1)\n544\t        _resolve_full_stack(game)\n545\t\n546\t        assert p1.mana_pool.total() == 3, (\n547\t            \"miracle cast must charge exactly {2}, not the printed cost\"\n548\t        )\n549\t        # The printed cost is restored, not permanently mutated to {2}.\n550\t        assert top.mana_cost.cmc == printed_cmc\n551\t\n552\t    def test_first_draw_decline_keeps_card_in_hand(self) -> None:\n553\t        \"\"\"Declining the offer leaves the drawn instant in the controller's\n554\t        hand, spends no mana, and leaves the stack empty after resolution. (The\n555\t        hook still lands the offer on the stack; the yes/no is asked when that\n556\t        offer resolves, and 'no' is a no-op.)\"\"\"\n557\t        from engine import game as game_mod\n558\t\n559\t        game, p1, p2, card = self._setup()\n560\t        top = _expensive_instant(\"Decline Me\")\n561\t        _put_on_top_of_library(game, p1, top)\n562\t        p1.cards_drawn_this_turn = 0\n563\t        set_board_state(game, 0, mana={ManaType.COLORLESS: 5})\n564\t        p1._script.append(False)  # decline the miracle offer\n565\t\n566\t        game_mod.draw_card(game, p1)\n567\t        _resolve_full_stack(game)\n568\t\n569\t        assert game.get_hand(p1).contains(top)\n570\t        assert not game.get_graveyard(p1).contains(top)\n571\t        assert game.stack.is_empty()\n572\t        # No mana spent on a decline.\n573\t        assert p1.mana_pool.total() == 5\n574\t\n575\t    def test_non_first_draw_is_not_offered(self) -> None:\n576\t        \"\"\"Miracle's reveal window is only the FIRST card drawn each turn. When\n577\t        the controller has already drawn this turn, drawing a granted instant\n578\t        offers no miracle: the stack stays empty and the card stays in hand.\n579\t\n580\t        No yes/no is scripted; if the implementation wrongly offered the cast it\n581\t        would raise ScriptExhaustedError, so this also guards against an\n582\t        unconditioned hook.\"\"\"\n583\t        from engine import game as game_mod\n584\t\n585\t        game, p1, p2, card = self._setup()\n586\t        top = _expensive_instant(\"Second Draw\")\n587\t        _put_on_top_of_library(game, p1, top)\n588\t        # Already drew one card this turn — the upcoming draw is the SECOND.\n589\t        p1.cards_drawn_this_turn = 1\n590\t        set_board_state(game, 0, mana={ManaType.COLORLESS: 5})\n591\t\n592\t        game_mod.draw_card(game, p1)\n593\t\n594\t        assert game.stack.is_empty(), \"non-first draw must not offer miracle\"\n595\t        assert game.get_hand(p1).contains(top)\n596\t        assert not game.get_graveyard(p1).contains(top)\n597\t\n598\t    def test_opponent_first_draw_is_not_offered_loreholds_grant(self) -> None:\n599\t        \"\"\"Lorehold grants miracle only to cards in ITS controller's hand. An\n600\t        opponent drawing an instant as their first draw is not offered the\n601\t        miracle cast — no offer hits the stack and the card stays in the\n602\t        opponent's hand. No yes/no is scripted for the opponent, so a wrongly\n603\t        scoped hook would raise ScriptExhaustedError.\"\"\"\n604\t        from engine import game as game_mod\n605\t\n606\t        game, p1, p2, card = self._setup()\n607\t        opp_top = _expensive_instant(\"Opp Draw\")\n608\t        _put_on_top_of_library(game, p2, opp_top)\n609\t        p2.cards_drawn_this_turn = 0  # opponent's first draw this turn\n610\t        set_board_state(game, 1, mana={ManaType.COLORLESS: 5})\n611\t\n612\t        game_mod.draw_card(game, p2)\n613\t\n614\t        assert game.stack.is_empty(), (\n615\t            \"Lorehold must not offer its miracle grant on an opponent's draw\"\n616\t        )\n617\t        assert game.get_hand(p2).contains(opp_top)\n618\t        assert not game.get_graveyard(p2).contains(opp_top)\n619\t\n620\t    def test_drawn_creature_is_not_offered_miracle(self) -> None:\n621\t        \"\"\"Miracle is granted only to instants and sorceries. The controller\n622\t        drawing a CREATURE as their first draw triggers no miracle offer: the\n623\t        stack stays empty and the creature stays in hand. No yes/no is scripted,\n624\t        so a hook that ignored the card type would raise ScriptExhaustedError.\"\"\"\n625\t        from engine import game as game_mod\n626\t\n627\t        game, p1, p2, card = self._setup()\n628\t        bear = _vanilla_creature(\"Drawn Bear\")\n629\t        _put_on_top_of_library(game, p1, bear)\n630\t        p1.cards_drawn_this_turn = 0  # first draw of the turn\n631\t        set_board_state(game, 0, mana={ManaType.COLORLESS: 5})\n632\t\n633\t        game_mod.draw_card(game, p1)\n634\t\n635\t        assert game.stack.is_empty(), (\n636\t            \"a drawn creature is neither instant nor sorcery — no miracle offer\"\n637\t        )\n638\t        assert game.get_hand(p1).contains(bear)\n639\t\n640\t    def test_first_draw_sorcery_accept_casts_for_two(self) -> None:\n641\t        \"\"\"The grant covers sorceries too: accepting the offer on a first-drawn\n642\t        sorcery casts it for {2} (leaves hand, resolves to graveyard), charging\n643\t        exactly two from a five-mana pool.\"\"\"\n644\t        from engine import game as game_mod\n645\t\n646\t        game, p1, p2, card = self._setup()\n647\t        top = Sorcery(name=\"Costly Ritual\", mana_cost=ManaCost.parse(\"{5}{B}\"))\n648\t        _put_on_top_of_library(game, p1, top)\n649\t        p1.cards_drawn_this_turn = 0\n650\t        set_board_state(game, 0, mana={ManaType.COLORLESS: 5})\n651\t        p1._script.append(True)\n652\t\n653\t        game_mod.draw_card(game, p1)\n654\t        assert not game.stack.is_empty()\n655\t        _resolve_full_stack(game)\n656\t\n657\t        assert not game.get_hand(p1).contains(top)\n658\t        assert game.get_graveyard(p1).contains(top)\n659\t        assert p1.mana_pool.total() == 3\n660\t"}]},"parent_tool_use_id":"toolu_0161xMeCEMDGx7Qwdiz8uz1c","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"5e2a1221-34e8-4542-a320-81b345296d47","timestamp":"2026-06-02T09:21:51.072Z","subagent_type":"Implementer","task_description":"Fix sos_201 miracle sorcery draw-cast"}
