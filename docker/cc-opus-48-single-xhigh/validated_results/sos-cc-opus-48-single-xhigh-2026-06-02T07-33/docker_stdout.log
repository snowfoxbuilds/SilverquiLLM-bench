{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CdzbYWhMoq9MmW2D2fj7v2","type":"tool_result","content":"134\tdef set_board_state(\n135\t    game: GameState,\n136\t    player_index: int,\n137\t    *,\n138\t    battlefield: list[Any] | None = None,\n139\t    hand: list[Any] | None = None,\n140\t    graveyard: list[Any] | None = None,\n141\t    life: int | None = None,\n142\t    mana: dict[ManaType, int] | None = None,\n143\t) -> None:\n144\t    \"\"\"Directly set zone contents and player state for test setup.\n145\t\n146\t    Replaces the contents of the specified zones (only zones that are\n147\t    explicitly provided are modified — others are left unchanged).\n148\t\n149\t    For each card placed into a zone, ``owner`` and ``controller`` are\n150\t    set to the target player.\n151\t\n152\t    Parameters:\n153\t        game: The game state to modify.\n154\t        player_index: Index of the player (0 or 1).\n155\t        battlefield: Cards/permanents to place on the battlefield.\n156\t        hand: Cards to place in hand.\n157\t        graveyard: Cards to place in graveyard.\n158\t        life: Life total to set (or ``None`` to leave unchanged).\n159\t        mana: Mana to add to the player's pool.  Keys are\n160\t            :class:`ManaType`, values are amounts.\n161\t\n162\t    Raises:\n163\t        TestSetupError: If ``player_index`` is out of range.\n164\t    \"\"\"\n165\t    if player_index < 0 or player_index >= len(game.players):\n166\t        raise TestSetupError(\n167\t            f\"Invalid player_index {player_index} — game has \"\n168\t            f\"{len(game.players)} players (indices 0–{len(game.players) - 1})\"\n169\t        )\n170\t\n171\t    player = game.players[player_index]\n172\t\n173\t    if life is not None:\n174\t        player.life = life\n175\t\n176\t    if mana is not None:\n177\t        player.mana_pool.empty()\n178\t        for mana_type, amount in mana.items():\n179\t            player.mana_pool.add(mana_type, amount)\n180\t\n181\t    if battlefield is not None:\n182\t        _set_zone(game, player, Zone.BATTLEFIELD, battlefield)\n183\t\n184\t    if hand is not None:\n185\t        _set_zone(game, player, Zone.HAND, hand)\n186\t\n187\t    if graveyard is not None:\n188\t        _set_zone(game, player, Zone.GRAVEYARD, graveyard)\n189\t\n190\t\n191\tdef _set_zone(\n192\t    game: GameState,\n193\t    player: Any,\n194\t    zone: Zone,\n195\t    cards: list[Any],\n196\t) -> None:\n197\t    \"\"\"Replace a zone's contents with *cards*, assigning ownership.\"\"\"\n198\t    zone_container = player.zones[zone]\n199\t    # Clear existing contents\n200\t    for obj in zone_container.get_all():\n201\t        zone_container.remove(obj)\n202\t\n203\t    # Add new contents\n204\t    for card in cards:\n205\t        card.owner = player\n206\t        card.controller = player\n207\t        zone_container.add(card)\n208\t\n209\t\n210\t# ---------------------------------------------------------------------------\n211\t# cast_spell\n212\t# ---------------------------------------------------------------------------\n213\t"}]},"parent_tool_use_id":"toolu_011ZQCTY2TPiZpW5s2RVhLVB","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"2393c944-ea39-4a38-a0c9-7697777b6398","timestamp":"2026-06-02T09:49:28.466Z","subagent_type":"Implementer","task_description":"Implement sos_245 + affinity grant hook"}
{"type":"system","subtype":"task_progress","task_id":"ac5941a03d8f2cb9c","tool_use_id":"toolu_011ZQCTY2TPiZpW5s2RVhLVB","description":"Writing engine/affinity.py","subagent_type":"Implementer","usage":{"total_tokens":79569,"tool_uses":23,"duration_ms":79167},"last_tool_name":"Write","uuid":"b962d41a-d066-4a81-9c29-25304c44182a","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc"}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01XP6aCxXb3giFBDkRPobapD","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01GniT8KbbrYKrU7RoMDixRb","name":"Write","input":{"file_path":"/workspace/engine/affinity.py","content":"\"\"\"Affinity-keyword framework (Comprehensive Rules 702.41).\n\n*Affinity for [quality]* is a static ability that reduces the generic portion of\na spell's cost:\n\n    Affinity for creatures (This spell costs {1} less to cast for each creature\n    you control.)\n\nA card normally carries affinity as a printed cost-reduction ability — that\n*own* affinity is implemented with the established ``cost_reduction(self, game)``\nhook (sos_1 / fdn_167 Tolarian Terror), which the engine's\n:func:`engine.casting.get_cost_reduction` clamps to the spell's generic portion.\n\nWitherbloom, the Balancer also *grants* \"affinity for creatures\" to every\ninstant and sorcery **spell** its controller casts.  The engine had no support\nfor a granting permanent contributing a per-spell cost reduction, so this module\nadds it *additively* — no existing engine symbol is renamed, moved, or deleted.\nIt mirrors :mod:`engine.casualty` / :mod:`engine.miracle` / :mod:`engine.paradigm`.\n\nThe mechanic has two observable parts:\n\n1. **The grant surface.**  A *granted affinity-for-creatures* flag is recorded on\n   the affected spell (``spell.affinity_for_creatures = True``) and is also\n   queryable via :func:`grants_affinity_for_creatures`.  A continuous-grant source\n   (Witherbloom) installs / refreshes the grant via\n   :func:`grant_affinity_to_hand`, which only ever writes the flag onto\n   instants/sorceries in *its controller's* hand and clears stale grants from\n   cards that have left the hand.\n\n2. **The granted cost reduction (driven through the cast/cost pipeline).**  A\n   granting permanent registers, per controller, a *granted reduction* — a\n   callable ``(game, spell, controller) -> int`` returning how much {1}-less the\n   grant gives a particular spell (for affinity for creatures: the number of\n   creatures the controller controls).  :func:`get_granted_reduction` sums the\n   contributions of every registered grant that applies to a spell, and\n   :func:`engine.casting.get_cost_reduction` adds that to the cast card's own\n   ``cost_reduction(game)`` hook before clamping to the spell's generic portion.\n   With no grant registered the sum is 0, so existing cost-reduction behaviour\n   (sos_1, fdn_167) is unchanged.\n\n\"Affinity\" is a *printed keyword label*, not an evergreen keyword, so no member\nis added to :class:`engine.types.Keyword` (that enum is frozen at 16 members).\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any, Callable\n\nfrom engine.types import CardType, Zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\n#: Type of a granted-reduction resolver: ``(game, spell, controller) -> int``.\nReductionResolver = Callable[[Any, Any, Any], int]\n\n\n# ---------------------------------------------------------------------------\n# Grant surface — read / write the granted affinity flag on a spell\n# ---------------------------------------------------------------------------\n\n\ndef is_instant_or_sorcery(card: Any) -> bool:\n    \"\"\"Return ``True`` if *card* is an instant or sorcery (the granted types).\"\"\"\n    card_types = getattr(card, \"card_types\", set())\n    return CardType.INSTANT in card_types or CardType.SORCERY in card_types\n\n\ndef grants_affinity_for_creatures(card: Any) -> bool:\n    \"\"\"Return ``True`` if *card* currently carries a granted affinity-for-creatures.\"\"\"\n    return bool(getattr(card, \"affinity_for_creatures\", False))\n\n\ndef set_affinity_for_creatures(card: Any, granted: bool) -> None:\n    \"\"\"Write (or clear) the granted affinity-for-creatures flag on *card*.\n\n    Passing ``False`` clears the grant (removes the ``affinity_for_creatures``\n    attribute so a stale grant never lingers on a card that has left the granting\n    zone).\n    \"\"\"\n    if not granted:\n        if hasattr(card, \"affinity_for_creatures\"):\n            try:\n                delattr(card, \"affinity_for_creatures\")\n            except AttributeError:\n                card.affinity_for_creatures = False  # type: ignore[attr-defined]\n        if hasattr(card, \"_affinity_grant_source\"):\n            try:\n                delattr(card, \"_affinity_grant_source\")\n            except AttributeError:\n                pass\n        return\n    card.affinity_for_creatures = True  # type: ignore[attr-defined]\n\n\n# ---------------------------------------------------------------------------\n# Per-game registry of cards a given source has flagged with the grant\n# ---------------------------------------------------------------------------\n\n\ndef _flagged_registry(game: GameState) -> dict[int, set[int]]:\n    \"\"\"Return (creating if necessary) the per-game affinity-flag registry.\n\n    Maps ``id(source)`` to the set of ``id(card)`` it last flagged, so a refresh\n    can clear flags from cards that have since left the granting zone.  Stored\n    lazily on the game object — no ``GameState.__init__`` change.\n    \"\"\"\n    registry = getattr(game, \"_affinity_flags\", None)\n    if registry is None:\n        registry = {}\n        game._affinity_flags = registry  # type: ignore[attr-defined]\n    return registry\n\n\ndef grant_affinity_to_hand(\n    game: GameState,\n    source: Any,\n    controller: Any,\n) -> list[Any]:\n    \"\"\"Flag every instant/sorcery in *controller*'s hand as having affinity.\n\n    This is the observable half of Witherbloom's continuous static ability:\n    while the source is on the battlefield, every instant and sorcery spell its\n    controller casts \"has affinity for creatures\".  The flag is written onto each\n    such hand card (``card.affinity_for_creatures = True``) and is queryable via\n    :func:`grants_affinity_for_creatures`.\n\n    The grant is *scoped*:\n\n    * only instants and sorceries are flagged (creatures, lands, etc. are not);\n    * only cards in *controller*'s hand are flagged (an opponent's hand is left\n      untouched).\n\n    Calling this again refreshes the flag: cards that have left the controller's\n    hand since the last refresh have their (this-source) flag cleared so a stale\n    grant never lingers.  Returns the list of hand cards now carrying the flag.\n    \"\"\"\n    if controller is None:\n        return []\n\n    registry = _flagged_registry(game)\n    previously = registry.get(id(source), set())\n\n    hand = controller.zones[Zone.HAND]\n    granted: list[Any] = []\n    now_ids: set[int] = set()\n\n    for card in hand.get_all():\n        if not is_instant_or_sorcery(card):\n            continue\n        set_affinity_for_creatures(card, True)\n        card._affinity_grant_source = source  # type: ignore[attr-defined]\n        granted.append(card)\n        now_ids.add(id(card))\n\n    stale = previously - now_ids\n    if stale:\n        _clear_flags_for_ids(game, source, stale)\n\n    registry[id(source)] = now_ids\n    return granted\n\n\ndef _clear_flags_for_ids(game: GameState, source: Any, card_ids: set[int]) -> None:\n    \"\"\"Clear *source*'s affinity flag from any card in *card_ids* across zones.\"\"\"\n    for player in game.players:\n        for zone in Zone:\n            container = player.zones[zone]\n            for card in list(container.get_all()):\n                if (\n                    id(card) in card_ids\n                    and getattr(card, \"_affinity_grant_source\", None) is source\n                ):\n                    set_affinity_for_creatures(card, False)\n\n\ndef clear_affinity_flags(game: GameState, source: Any) -> None:\n    \"\"\"Clear every affinity flag *source* placed (e.g. when it leaves play).\"\"\"\n    registry = _flagged_registry(game)\n    granted = registry.pop(id(source), set())\n    if not granted:\n        return\n    _clear_flags_for_ids(game, source, granted)\n\n\n# ---------------------------------------------------------------------------\n# Granted-reduction registry — drive the granted cost reduction through the\n# cast/cost pipeline (mirrors engine.casualty / engine.miracle grant registries)\n# ---------------------------------------------------------------------------\n\n\ndef _grant_registry(game: GameState) -> dict[int, dict[str, Any]]:\n    \"\"\"Return (creating if necessary) the per-game granted-reduction registry.\n\n    Maps ``id(source)`` to a record ``{\"controller\", \"applies\", \"resolver\"}``:\n\n    * ``controller`` — the player whose spells the grant applies to;\n    * ``applies`` — predicate ``(game, spell, controller) -> bool`` deciding\n      whether a given spell receives the grant (e.g. controller's instants /\n      sorceries, source on the battlefield);\n    * ``resolver`` — :data:`ReductionResolver` returning the {1}-less count for a\n      qualifying spell (for affinity for creatures: how many creatures the\n      controller controls).\n\n    Stored lazily on the game object — no ``GameState.__init__`` change.\n    \"\"\"\n    registry = getattr(game, \"_affinity_grants\", None)\n    if registry is None:\n        registry = {}\n        game._affinity_grants = registry  # type: ignore[attr-defined]\n    return registry\n\n\ndef register_affinity_grant(\n    game: GameState,\n    source: Any,\n    controller: Any,\n    resolver: ReductionResolver,\n    applies: Callable[[Any, Any, Any], bool],\n) -> None:\n    \"\"\"Register *source*'s granted per-spell cost reduction (idempotent per source).\n\n    When a spell is cast, :func:`get_granted_reduction` consults every registered\n    grant whose ``applies(game, spell, controller)`` predicate returns ``True``\n    and sums each grant's ``resolver(game, spell, controller)`` contribution.\n    :func:`engine.casting.get_cost_reduction` adds that sum to the cast card's own\n    ``cost_reduction(game)`` before clamping to the spell's generic portion.\n\n    Re-registering the same source overwrites its record (so a refreshed grant\n    keeps the latest controller/resolver) — keyed by ``id(source)``.\n    \"\"\"\n    _grant_registry(game)[id(source)] = {\n        \"controller\": controller,\n        \"applies\": applies,\n        \"resolver\": resolver,\n    }\n\n\ndef clear_affinity_grant(game: GameState, source: Any) -> None:\n    \"\"\"Remove *source*'s granted-reduction record (e.g. when it leaves play).\"\"\"\n    _grant_registry(game).pop(id(source), None)\n\n\ndef get_granted_reduction(game: GameState, spell: Any, controller: Any) -> int:\n    \"\"\"Return the total granted generic reduction for *controller* casting *spell*.\n\n    Sums the contribution of every registered grant whose ``applies`` predicate\n    accepts ``(game, spell, controller)``.  Returns ``0`` when no grant applies —\n    so a spell with no granting permanent in play is reduced only by its own\n    ``cost_reduction`` hook (existing behaviour is unchanged).\n    \"\"\"\n    registry = getattr(game, \"_affinity_grants\", None)\n    if not registry:\n        return 0\n    total = 0\n    for record in list(registry.values()):\n        applies = record.get(\"applies\")\n        resolver = record.get(\"resolver\")\n        if resolver is None:\n            continue\n        try:\n            if applies is not None and not applies(game, spell, controller):\n                continue\n            contribution = resolver(game, spell, controller)\n        except Exception:\n            continue\n        if contribution and contribution > 0:\n            total += int(contribution)\n    return total\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1171,"cache_read_input_tokens":78119,"cache_creation":{"ephemeral_5m_input_tokens":1171,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_011ZQCTY2TPiZpW5s2RVhLVB","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"58e5bacc-f476-4052-8338-c13cbccf92cf","request_id":"req_011CbeDxWUMSc8AnAuX6xLv1","subagent_type":"Implementer","task_description":"Implement sos_245 + affinity grant hook"}
