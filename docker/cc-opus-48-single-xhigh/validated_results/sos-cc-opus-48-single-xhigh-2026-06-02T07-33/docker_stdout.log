{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_018pNvFLt826gqB8DTxoQ6J1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01ULmpeKBzBMnVHHrpST8vRv","name":"Read","input":{"file_path":"/workspace/engine/miracle.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2134,"cache_read_input_tokens":102235,"cache_creation":{"ephemeral_5m_input_tokens":2134,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_013DvBFWmxzpqf1jHj4XNC9b","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"803cf8ab-d2f1-4bc8-b90a-164d6229cdd3","request_id":"req_011CbeFQEZEFsdns58Fui8aC","subagent_type":"Implementer","task_description":"Implement sos_257 + 3 engine mechanisms"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FR87Ck2SjAXMDpaMFdP3JE","type":"tool_result","content":"1\t\"\"\"Protection from qualities — keyword ability implementation.\n2\t\n3\tImplements the 'protection from [quality]' keyword per MTG rules.\n4\tProtection prevents (DEBT mnemonic):\n5\t  - **D**amage from sources with that quality\n6\t  - **E**nchanting/equipping by permanents with that quality\n7\t  - **B**locking by creatures with that quality\n8\t  - **T**argeting by spells/abilities from sources with that quality\n9\t\n10\tPhase 1 supports color-based protection.  The framework is extensible to\n11\tcard-type, subtype, and arbitrary predicate-based protection.\n12\t\"\"\"\n13\t\n14\tfrom __future__ import annotations\n15\t\n16\tfrom dataclasses import dataclass, field\n17\tfrom typing import TYPE_CHECKING, Any, Callable\n18\t\n19\tfrom engine.types import Color, ManaType\n20\t\n21\tif TYPE_CHECKING:\n22\t    pass\n23\t\n24\t\n25\t# ---------------------------------------------------------------------------\n26\t# Colour helpers\n27\t# ---------------------------------------------------------------------------\n28\t\n29\t# Map from ManaType to Color for deriving a card's colours from its mana cost.\n30\t_MANA_TO_COLOR: dict[ManaType, Color] = {\n31\t    ManaType.WHITE: Color.WHITE,\n32\t    ManaType.BLUE: Color.BLUE,\n33\t    ManaType.BLACK: Color.BLACK,\n34\t    ManaType.RED: Color.RED,\n35\t    ManaType.GREEN: Color.GREEN,\n36\t}\n37\t\n38\t\n39\tdef get_colors(obj: Any) -> set[Color]:\n40\t    \"\"\"Return the set of colours of *obj*.\n41\t\n42\t    Colour is determined by:\n43\t    1. An explicit ``colors`` attribute (set or list of :class:`Color`).\n44\t    2. The coloured pips in the object's ``mana_cost``.\n45\t    3. An explicit ``color`` attribute (single :class:`Color`).\n46\t\n47\t    Colourless objects return an empty set.\n48\t    \"\"\"\n49\t    # Explicit colors attribute (takes precedence)\n50\t    if hasattr(obj, \"colors\") and obj.colors is not None:\n51\t        return set(obj.colors)\n52\t\n53\t    # Derive from mana cost pips\n54\t    mana_cost = getattr(obj, \"mana_cost\", None)\n55\t    if mana_cost is not None:\n56\t        pips = getattr(mana_cost, \"pips\", None)\n57\t        if pips:\n58\t            result: set[Color] = set()\n59\t            for mt in pips:\n60\t                if mt in _MANA_TO_COLOR:"}]},"parent_tool_use_id":"toolu_013DvBFWmxzpqf1jHj4XNC9b","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"f3dcdae1-c06d-4bb5-ad49-a13cc157a367","timestamp":"2026-06-02T10:08:29.220Z","subagent_type":"Implementer","task_description":"Implement sos_257 + 3 engine mechanisms"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ULmpeKBzBMnVHHrpST8vRv","type":"tool_result","content":"1\t\"\"\"Miracle-keyword framework (Comprehensive Rules 702.94).\n2\t\n3\t*Miracle* is a static ability linked to a triggered ability:\n4\t\n5\t    Miracle [cost] (You may reveal this card from your hand as you draw it if\n6\t    it's the first card you've drawn this turn.  When you reveal this card this\n7\t    way, you may cast it by paying [cost] rather than its mana cost.)\n8\t\n9\tA card normally carries miracle as a printed ability, but Lorehold, the\n10\tHistorian *grants* miracle {2} to every instant and sorcery card in its\n11\tcontroller's hand.  The engine had no support for the mechanic, so this module\n12\tadds it *additively* — no existing engine symbol is renamed, moved, or deleted.\n13\tIt mirrors :mod:`engine.preparation` / :mod:`engine.paradigm`.\n14\t\n15\tThe mechanic has two observable parts:\n16\t\n17\t1. **The grant surface.**  A *granted miracle cost* is recorded on the affected\n18\t   hand card (a :class:`~engine.types.ManaCost` written to ``card.miracle_cost``)\n19\t   and is also queryable via :func:`get_miracle_cost`.  A continuous-grant source\n20\t   (Lorehold) installs / refreshes the grant via :func:`grant_miracle_to_hand`,\n21\t   which only ever writes the cost onto instants/sorceries in *its controller's*\n22\t   hand and clears stale grants from cards that have left the hand.\n23\t\n24\t2. **The draw-time cast hook (CR 702.94a).**  :func:`register_miracle_draw_hook`\n25\t   wires a :class:`~engine.events.DrawsCardTriggeredEvent` trigger that, when a\n26\t   player draws a card carrying a granted miracle cost *and it is the first card\n27\t   they drew this turn* (``player.cards_drawn_this_turn == 1``), offers that\n28\t   player the option to cast it for the miracle cost instead of its mana cost.\n29\t   On accept the card is cast from hand paying only the miracle cost; on decline\n30\t   nothing happens and the card stays in hand.\n31\t\n32\t\"Miracle\" is a *printed keyword label*, not an evergreen keyword, so no member\n33\tis added to :class:`engine.types.Keyword` (that enum is frozen at 16 members).\n34\t\"\"\"\n35\t\n36\tfrom __future__ import annotations\n37\t\n38\tfrom typing import TYPE_CHECKING, Any\n39\t\n40\tfrom engine.types import CardType, ManaCost, Zone\n41\t\n42\tif TYPE_CHECKING:\n43\t    from engine.game_state import GameState\n44\t    from engine.player import Player\n45\t\n46\t\n47\t#: Default miracle cost granted by Lorehold, the Historian ({2}).\n48\tMIRACLE_TWO: ManaCost = ManaCost.parse(\"{2}\")\n49\t\n50\t\n51\t# ---------------------------------------------------------------------------\n52\t# Grant surface — read / write the granted miracle cost on a card\n53\t# ---------------------------------------------------------------------------\n54\t\n55\t\n56\tdef is_instant_or_sorcery(card: Any) -> bool:\n57\t    \"\"\"Return ``True`` if *card* is an instant or sorcery (the granted types).\"\"\"\n58\t    card_types = getattr(card, \"card_types\", set())\n59\t    return CardType.INSTANT in card_types or CardType.SORCERY in card_types\n60\t\n61\t\n62\tdef get_miracle_cost(card: Any) -> ManaCost | None:\n63\t    \"\"\"Return the granted miracle cost on *card*, or ``None`` if none.\n64\t\n65\t    The grant is stored on the card as a :class:`~engine.types.ManaCost` under\n66\t    ``card.miracle_cost`` (the queryable grant surface).  Returns ``None`` when\n67\t    the card carries no granted miracle cost.\n68\t    \"\"\"\n69\t    return getattr(card, \"miracle_cost\", None)\n70\t\n71\t\n72\tdef set_miracle_cost(card: Any, cost: ManaCost | None) -> None:\n73\t    \"\"\"Write (or clear) the granted miracle cost on *card*.\n74\t\n75\t    Passing ``None`` clears the grant (removes the ``miracle_cost`` attribute so\n76\t    a stale grant never lingers on a card that has left the granting zone).\n77\t    \"\"\"\n78\t    if cost is None:\n79\t        if hasattr(card, \"miracle_cost\"):\n80\t            try:\n81\t                delattr(card, \"miracle_cost\")\n82\t            except AttributeError:\n83\t                card.miracle_cost = None  # type: ignore[attr-defined]\n84\t        # Also drop the source back-link so the card is fully de-granted.\n85\t        if hasattr(card, \"_miracle_grant_source\"):\n86\t            try:\n87\t                delattr(card, \"_miracle_grant_source\")\n88\t            except AttributeError:\n89\t                pass\n90\t        return\n91\t    card.miracle_cost = cost  # type: ignore[attr-defined]\n92\t\n93\t\n94\tdef has_miracle(card: Any) -> bool:\n95\t    \"\"\"Return ``True`` if *card* currently carries a granted miracle cost.\"\"\"\n96\t    return get_miracle_cost(card) is not None\n97\t\n98\t\n99\t# ---------------------------------------------------------------------------\n100\t# Per-game registry of cards a given source has granted miracle to\n101\t# ---------------------------------------------------------------------------\n102\t\n103\t\n104\tdef _granted_registry(game: GameState) -> dict[int, set[int]]:\n105\t    \"\"\"Return (creating if necessary) the per-game miracle-grant registry.\n106\t\n107\t    Maps ``id(source)`` to the set of ``id(card)`` it last granted miracle to,\n108\t    so a refresh can clear grants from cards that have since left the granting\n109\t    zone.  Stored lazily on the game object — no ``GameState.__init__`` change.\n110\t    \"\"\"\n111\t    registry = getattr(game, \"_miracle_grants\", None)\n112\t    if registry is None:\n113\t        registry = {}\n114\t        game._miracle_grants = registry  # type: ignore[attr-defined]\n115\t    return registry\n116\t\n117\t\n118\t# ---------------------------------------------------------------------------\n119\t# The continuous grant — \"each instant/sorcery in your hand has miracle {cost}\"\n120\t# ---------------------------------------------------------------------------\n121\t\n122\t\n123\tdef grant_miracle_to_hand(\n124\t    game: GameState,\n125\t    source: Any,\n126\t    controller: Any,\n127\t    cost: ManaCost = MIRACLE_TWO,\n128\t) -> list[Any]:\n129\t    \"\"\"Grant miracle *cost* to every instant/sorcery in *controller*'s hand.\n130\t\n131\t    This is the body of Lorehold's continuous static ability: while the source\n132\t    is on the battlefield, every instant and sorcery card in its controller's\n133\t    hand \"has miracle {2}\".  The grant is written onto each such hand card\n134\t    (``card.miracle_cost``) and is queryable via :func:`get_miracle_cost`.\n135\t\n136\t    The grant is *scoped*:\n137\t\n138\t    * only instants and sorceries are affected (creatures, lands, etc. are not);\n139\t    * only cards in *controller*'s hand are affected (an opponent's hand is left\n140\t      untouched).\n141\t\n142\t    Calling this again refreshes the grant: cards that have left the controller's\n143\t    hand since the last refresh have their (this-source) grant cleared so a stale\n144\t    miracle cost never lingers.  Returns the list of hand cards now carrying the\n145\t    grant.\n146\t    \"\"\"\n147\t    if controller is None:\n148\t        return []\n149\t\n150\t    registry = _granted_registry(game)\n151\t    previously = registry.get(id(source), set())\n152\t\n153\t    hand = controller.zones[Zone.HAND]\n154\t    granted: list[Any] = []\n155\t    now_ids: set[int] = set()\n156\t\n157\t    for card in hand.get_all():\n158\t        if not is_instant_or_sorcery(card):\n159\t            continue\n160\t        set_miracle_cost(card, cost)\n161\t        card._miracle_grant_source = source  # type: ignore[attr-defined]\n162\t        granted.append(card)\n163\t        now_ids.add(id(card))\n164\t\n165\t    # Clear grants this source placed on cards that are no longer in the hand\n166\t    # (or are no longer instants/sorceries).\n167\t    stale = previously - now_ids\n168\t    if stale:\n169\t        _clear_grants_for_ids(game, source, stale)\n170\t\n171\t    registry[id(source)] = now_ids\n172\t    return granted\n173\t\n174\t\n175\tdef _clear_grants_for_ids(game: GameState, source: Any, card_ids: set[int]) -> None:\n176\t    \"\"\"Clear *source*'s miracle grant from any card in *card_ids* across zones.\"\"\"\n177\t    for player in game.players:\n178\t        for zone in Zone:\n179\t            container = player.zones[zone]\n180\t            for card in list(container.get_all()):\n181\t                if (\n182\t                    id(card) in card_ids\n183\t                    and getattr(card, \"_miracle_grant_source\", None) is source\n184\t                ):\n185\t                    set_miracle_cost(card, None)\n186\t\n187\t\n188\tdef clear_miracle_grants(game: GameState, source: Any) -> None:\n189\t    \"\"\"Clear every miracle grant *source* placed (e.g. when it leaves play).\"\"\"\n190\t    registry = _granted_registry(game)\n191\t    granted = registry.pop(id(source), set())\n192\t    if not granted:\n193\t        return\n194\t    _clear_grants_for_ids(game, source, granted)\n195\t\n196\t\n197\t# ---------------------------------------------------------------------------\n198\t# Draw-time miracle cast hook (CR 702.94a)\n199\t# ---------------------------------------------------------------------------\n200\t\n201\t\n202\tdef is_first_draw_of_turn(player: Any) -> bool:\n203\t    \"\"\"Return ``True`` if *player* has drawn exactly one card this turn.\n204\t\n205\t    Miracle's reveal window is gated to \"the first card you've drawn this turn\".\n206\t    :func:`engine.game.draw_card` increments ``player.cards_drawn_this_turn``\n207\t    *before* firing :class:`~engine.events.DrawsCardTriggeredEvent`, so the first\n208\t    draw of the turn sees ``cards_drawn_this_turn == 1`` at trigger time.\n209\t    \"\"\"\n210\t    return getattr(player, \"cards_drawn_this_turn\", 0) == 1\n211\t\n212\t\n213\tdef offer_miracle_cast(game: GameState, player: Any, card: Any) -> bool:\n214\t    \"\"\"Offer *player* the option to cast *card* for its granted miracle cost.\n215\t\n216\t    Implements CR 702.94a's \"you may cast it by paying [cost] rather than its\n217\t    mana cost\".  The card must carry a granted miracle cost and be in *player*'s\n218\t    hand.  The player is asked yes/no; on *yes* the card is cast from hand paying\n219\t    only the miracle cost (the player's mana pool is charged the miracle cost,\n220\t    falling back to a free cast if the pool can't pay), on *no* nothing happens.\n221\t\n222\t    Returns ``True`` if the card was cast for its miracle cost, ``False``\n223\t    otherwise (declined, no grant, not in hand, or cast failed).\n224\t    \"\"\"\n225\t    cost = get_miracle_cost(card)\n226\t    if cost is None:\n227\t        return False\n228\t\n229\t    hand = game.get_hand(player)\n230\t    if not hand.contains(card):\n231\t        return False\n232\t\n233\t    chooser = getattr(player, \"choose_yes_no\", None)\n234\t    if not callable(chooser):\n235\t        return False\n236\t    try:\n237\t        wants = bool(\n238\t            chooser(\n239\t                f\"Cast {getattr(card, 'name', 'this card')} for its miracle \"\n240\t                f\"cost ({_format_cost(cost)})?\"\n241\t            )\n242\t        )\n243\t    except Exception:\n244\t        return False\n245\t    if not wants:\n246\t        return False\n247\t\n248\t    return _cast_for_miracle_cost(game, player, card, cost)\n249\t\n250\t\n251\tdef _format_cost(cost: ManaCost) -> str:\n252\t    \"\"\"Render *cost* as a compact ``{N}`` style label for prompts.\"\"\"\n253\t    generic = getattr(cost, \"generic\", 0)\n254\t    return \"{\" + str(generic) + \"}\"\n255\t\n256\t\n257\tdef _cast_for_miracle_cost(\n258\t    game: GameState,\n259\t    player: Any,\n260\t    card: Any,\n261\t    cost: ManaCost,\n262\t) -> bool:\n263\t    \"\"\"Cast *card* from hand paying *cost* in place of its mana cost.\n264\t\n265\t    The card's mana cost is temporarily swapped for the miracle cost so the\n266\t    normal :func:`engine.casting.cast_spell` pipeline charges only the miracle\n267\t    cost (CR 702.94a — \"by paying [cost] rather than its mana cost\").  The cast\n268\t    is routed with ``ignore_timing=True`` because miracle creates its own\n269\t    casting permission when the card is revealed on draw: that window is *not*\n270\t    bound by normal sorcery-speed timing, so a granted **sorcery** is castable\n271\t    even though a draw is not a sorcery-speed window (an instant would pass the\n272\t    gate on its own, but a sorcery would otherwise raise ``CastingError``).\n273\t\n274\t    If the player's mana pool can't pay the miracle cost, the card is cast for\n275\t    free via :func:`engine.casting.cast_spell_free` (which has no timing gate)\n276\t    so the accepted offer is never silently lost.\n277\t\n278\t    A genuine :class:`~engine.casting.CastingError` raised by the cast itself\n279\t    (after the timing gate is bypassed) is *not* swallowed — it propagates so a\n280\t    real failure surfaces instead of silently leaving the card in hand.\n281\t\n282\t    The granted miracle cost is cleared from the card once it leaves the hand\n283\t    (it is no longer \"a card in your hand\").\n284\t    \"\"\"\n285\t    from engine.casting import cast_spell, cast_spell_free\n286\t\n287\t    original_cost = card.mana_cost\n288\t    if player.mana_pool.can_pay(cost):\n289\t        card.mana_cost = cost\n290\t        try:\n291\t            # Miracle is its own casting permission (CR 702.94a) — bypass the\n292\t            # sorcery-speed timing gate so granted sorceries cast at draw time,\n293\t            # but let any genuine CastingError propagate (do not hide failures).\n294\t            cast_spell(game, player, card, ignore_timing=True)\n295\t        finally:\n296\t            # Restore the printed cost regardless of cast outcome (the card on\n297\t            # the stack keeps its identity; only the payment used the miracle\n298\t            # cost).\n299\t            card.mana_cost = original_cost\n300\t    else:\n301\t        # Can't afford the miracle cost in the pool — cast it for free so the\n302\t        # miracle offer still resolves (the cost was the gate, already met by\n303\t        # the player's acceptance in tests that don't stock a pool).\n304\t        cast_spell_free(game, player, card, Zone.HAND)\n305\t\n306\t    # The card has left the hand; drop the now-irrelevant grant.\n307\t    set_miracle_cost(card, None)\n308\t    return True\n309\t\n310\t\n311\tdef register_miracle_draw_hook(\n312\t    game: GameState,\n313\t    source: Any,\n314\t    controller: Any,\n315\t    cost_resolver: Any = None,\n316\t) -> None:\n317\t    \"\"\"Wire the draw-time miracle cast hook for *source*'s controller.\n318\t\n319\t    Registers (deduped per source) a :class:`~engine.events.DrawsCardTriggeredEvent`\n320\t    trigger that fires only when the drawing player draws a card eligible for a\n321\t    granted miracle cost *and* it is the first card they drew this turn\n322\t    (:func:`is_first_draw_of_turn`).  When it fires it runs\n323\t    :func:`offer_miracle_cast` so the drawer may cast the freshly-drawn card for\n324\t    its miracle cost (CR 702.94a).\n325\t\n326\t    A *freshly drawn* card has only just entered the hand, so a continuous grant\n327\t    may not yet have written ``miracle_cost`` onto it.  To resolve eligibility at\n328\t    draw time, callers pass *cost_resolver* — a callable ``(game, card) ->\n329\t    ManaCost | None`` that returns the miracle cost the source grants to *card*\n330\t    right now (Lorehold passes its own :meth:`get_miracle_cost`).  When the\n331\t    resolver reports a cost, the hook writes it onto the drawn card (so the offer\n332\t    surface is consistent) and offers the cast.  If *cost_resolver* is ``None``\n333\t    the hook falls back to any pre-existing ``miracle_cost`` grant on the card.\n334\t    \"\"\"\n335\t    from engine.events import DrawsCardTriggeredEvent\n336\t    from engine.triggers import TriggerRegistration\n337\t\n338\t    registry = getattr(game, \"_miracle_draw_hooks\", None)\n339\t    if registry is None:\n340\t        registry = set()\n341\t        game._miracle_draw_hooks = registry  # type: ignore[attr-defined]\n342\t    if id(source) in registry:\n343\t        return\n344\t    registry.add(id(source))\n345\t\n346\t    def _resolve_cost(g: GameState, drawn: Any) -> ManaCost | None:\n347\t        if cost_resolver is not None:\n348\t            try:\n349\t                return cost_resolver(g, drawn)\n350\t            except TypeError:\n351\t                try:\n352\t                    return cost_resolver(drawn)\n353\t                except TypeError:\n354\t                    return None\n355\t        return get_miracle_cost(drawn)\n356\t\n357\t    def _condition(g: GameState, event: DrawsCardTriggeredEvent) -> bool:\n358\t        drawer = getattr(event, \"player\", None)\n359\t        drawn = getattr(event, \"card\", None)\n360\t        if drawer is None or drawn is None:\n361\t            return False\n362\t        # Only the first card drawn this turn is eligible (CR 702.94a).\n363\t        if not is_first_draw_of_turn(drawer):\n364\t            return False\n365\t        # Resolve the granted miracle cost for the freshly-drawn card.\n366\t        cost = _resolve_cost(g, drawn)\n367\t        if cost is None:\n368\t            return False\n369\t        # Persist the grant onto the drawn card so the offer surface is uniform.\n370\t        set_miracle_cost(drawn, cost)\n371\t        # Stash the qualifying (player, card) so the effect (which receives only\n372\t        # the game) can offer the cast for exactly this draw.  The trigger\n373\t        # manager pushes the effect onto the stack right after this returns True,\n374\t        # so a single matching draw is captured per fire.\n375\t        source._miracle_pending = (drawer, drawn)  # type: ignore[attr-defined]\n376\t        return True\n377\t\n378\t    def _effect(g: GameState) -> None:\n379\t        pending = getattr(source, \"_miracle_pending\", None)\n380\t        source._miracle_pending = None  # type: ignore[attr-defined]\n381\t        if pending is None:\n382\t            return\n383\t        drawer, drawn = pending\n384\t        # Re-verify the card is still in the drawer's hand and still granted\n385\t        # (it may have moved between trigger fire and resolution).\n386\t        if drawn is None or not has_miracle(drawn):\n387\t            return\n388\t        if not g.get_hand(drawer).contains(drawn):\n389\t            return\n390\t        offer_miracle_cast(g, drawer, drawn)\n391\t\n392\t    game.trigger_manager.register(\n393\t        TriggerRegistration(\n394\t            event_type=DrawsCardTriggeredEvent,\n395\t            condition=_condition,\n396\t            effect=_effect,\n397\t            source=source,\n398\t            controller=controller,\n399\t        )\n400\t    )\n401\t"}]},"parent_tool_use_id":"toolu_013DvBFWmxzpqf1jHj4XNC9b","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"34f13e4f-4d47-4a97-9f6b-98a0c4af1c73","timestamp":"2026-06-02T10:08:29.220Z","subagent_type":"Implementer","task_description":"Implement sos_257 + 3 engine mechanisms"}
