{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FyVxQTb3LHkyxwJLoUQm2C","type":"tool_result","content":"1\t\"\"\"Turn execution loop for the SilverquiLLM engine.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport warnings\n6\tfrom typing import TYPE_CHECKING\n7\t\n8\tif TYPE_CHECKING:\n9\t    from engine.game_state import GameState\n10\t\n11\tfrom engine.stack import priority_loop\n12\tfrom engine.types import Phase, Step, Zone\n13\t\n14\t\n15\t# Maximum hand size — players discard down to this during cleanup.\n16\tMAX_HAND_SIZE: int = 7\n17\t\n18\t\n19\t# Steps/phases where priority is given to players.\n20\t# In MTG, players do NOT receive priority during Untap and Cleanup (normally).\n21\t_NO_PRIORITY_STEPS: set[tuple[Phase, Step | None]] = {\n22\t    (Phase.BEGINNING, Step.UNTAP),\n23\t    (Phase.ENDING, Step.CLEANUP),\n24\t}\n25\t\n26\t\n27\tdef _do_untap_step(game: GameState) -> None:\n28\t    \"\"\"Perform untap step actions: untap all permanents controlled by the active player.\n29\t\n30\t    Per MTG rules, the active player untaps all permanents they control\n31\t    during their untap step. Summoning sickness is also cleared at this point.\n32\t    \"\"\"\n33\t    active = game.active_player\n34\t    bf = active.zones[Zone.BATTLEFIELD]\n35\t    for obj in bf.get_all():\n36\t        if hasattr(obj, \"is_tapped\"):\n37\t            obj.is_tapped = False\n38\t        if hasattr(obj, \"summoning_sick\"):\n39\t            obj.summoning_sick = False\n40\t\n41\t    # Reset land plays for the active player\n42\t    active.land_plays_remaining = 1\n43\t\n44\t\n45\tdef _do_draw_step(game: GameState) -> None:\n46\t    \"\"\"Perform draw step actions: active player draws a card.\n47\t\n48\t    In a two-player game, the starting player (the player who takes\n49\t    turn 1) skips their draw step on that first turn.  This is per\n50\t    MTG comprehensive rules §103.7a.\n51\t    \"\"\"\n52\t    # The starting player skips their draw on turn 1.\n53\t    if game.turn_number == 1 and game.active_player_index == 0:\n54\t        return\n55\t\n56\t    from engine.game import draw_card\n57\t\n58\t    draw_card(game, game.active_player)\n59\t\n60\t\n61\tdef _do_combat_step(game: GameState, step: Step) -> None:\n62\t    \"\"\"Dispatch combat sub-steps to the appropriate combat functions.\n63\t\n64\t    Parameters:\n65\t        game: The current game state.\n66\t        step: The combat step to execute.\n67\t    \"\"\"\n68\t    from engine.combat import (\n69\t        combat_damage_step,\n70\t        declare_attackers_step,\n71\t        declare_blockers_step,\n72\t        end_combat_step,\n73\t    )\n74\t\n75\t    if step == Step.DECLARE_ATTACKERS:\n76\t        declare_attackers_step(game)\n77\t    elif step == Step.DECLARE_BLOCKERS:\n78\t        declare_blockers_step(game)\n79\t    elif step == Step.COMBAT_DAMAGE:\n80\t        combat_damage_step(game)\n81\t    elif step == Step.END_COMBAT:\n82\t        end_combat_step(game)\n83\t\n84\t\n85\tdef _do_cleanup_step(game: GameState) -> None:\n86\t    \"\"\"Perform the cleanup step (MTG rule §514).\n87\t\n88\t    The cleanup step executes the following actions in order:\n89\t\n90\t    1. Active player discards down to maximum hand size (7) using\n91\t       :meth:`Player.choose_card`.\n92\t    2. Remove all \"until end of turn\" continuous effects via\n93\t       :meth:`EffectManager.remove_expired`, then reapply remaining\n94\t       effects for a consistent game state.\n95\t    3. Clear damage marked on all creatures on the battlefield.\n96\t    4. Clear combat-related flags (``dealt_deathtouch_damage``,\n97\t       ``is_attacking``, ``is_blocking``) and reset the combat state.\n98\t    5. Empty all players' mana pools.\n99\t    6. Check state-based actions.\n100\t    7. If triggers fired during cleanup (e.g. from discarding), process\n101\t       them (give priority, resolve stack) and perform another cleanup step.\n102\t    \"\"\"\n103\t    from engine.game import discard as _discard\n104\t    from engine.player import ScriptExhaustedError\n105\t    from engine.state_based_actions import resolve_state_based_actions\n106\t\n107\t    # --- Step 1: Discard to hand size ---\n108\t    active = game.active_player\n109\t    hand = active.zones[Zone.HAND]\n110\t    while len(hand) > MAX_HAND_SIZE:\n111\t        cards_in_hand = hand.get_all()\n112\t        if not cards_in_hand:\n113\t            break  # safety guard\n114\t        try:\n115\t            chosen = active.choose_card(cards_in_hand, \"discard to hand size\")\n116\t        except (ScriptExhaustedError, NotImplementedError) as exc:\n117\t            # Player implementation doesn't support choose_card or script\n118\t            # was exhausted.  Discard deterministically from end.\n119\t            chosen = cards_in_hand[-1]\n120\t            exc_name = type(exc).__name__\n121\t            warnings.warn(\n122\t                f\"{exc_name} during cleanup discard for {active.name}; \"\n123\t                f\"auto-discarding {chosen.name}\"\n124\t            )\n125\t        if chosen is not None and hand.contains(chosen):\n126\t            _discard(game, active, chosen)\n127\t        else:\n128\t            # If choose_card returns something invalid, discard the last card\n129\t            # to avoid an infinite loop.\n130\t            _discard(game, active, cards_in_hand[-1])\n131\t\n132\t    # --- Step 2: Remove \"until end of turn\" continuous effects ---\n133\t    if hasattr(game, \"effect_manager\"):\n134\t        game.effect_manager.remove_expired(game)\n135\t        # Reapply remaining effects so the game state is consistent.\n136\t        game.effect_manager.apply_all(game)\n137\t\n138\t    # --- Step 3: Clear damage on all creatures ---\n139\t    for player in game.players:\n140\t        bf = player.zones[Zone.BATTLEFIELD]\n141\t        for obj in bf.get_all():\n142\t            if hasattr(obj, \"damage_marked\"):\n143\t                obj.damage_marked = 0\n144\t\n145\t    # --- Step 4: Clear combat flags ---\n146\t    for player in game.players:\n147\t        bf = player.zones[Zone.BATTLEFIELD]\n148\t        for obj in bf.get_all():\n149\t            if hasattr(obj, \"dealt_deathtouch_damage\"):\n150\t                obj.dealt_deathtouch_damage = False\n151\t            if hasattr(obj, \"is_attacking\"):\n152\t                obj.is_attacking = False\n153\t            if hasattr(obj, \"is_blocking\"):\n154\t                obj.is_blocking = False\n155\t    # Reset the CombatState itself.\n156\t    if hasattr(game, \"combat_state\"):\n157\t        game.combat_state.clear()\n158\t\n159\t    # --- Step 5: Empty mana pools ---\n160\t    game.empty_mana_pools()\n161\t\n162\t    # --- Step 6: Check state-based actions ---\n163\t    sba_happened = resolve_state_based_actions(game)\n164\t\n165\t    # --- Step 7: If SBAs were performed or triggers fired, process & repeat ---\n166\t    # Rule 514.3a: if state-based actions were performed or triggered abilities\n167\t    # triggered during cleanup, another cleanup step occurs.\n168\t    if sba_happened or not game.stack.is_empty():\n169\t        # Triggers were placed on the stack — give priority and resolve.\n170\t        priority_loop(game)\n171\t        # After resolving, perform another cleanup step (recursive).\n172\t        _do_cleanup_step(game)\n173\t\n174\t\n175\tdef run_turn(game: GameState) -> None:\n176\t    \"\"\"Execute a full turn, iterating through all phases/steps.\n177\t\n178\t    At each priority point (every phase/step except Untap and Cleanup),\n179\t    :func:`priority_loop` is called.  Turn-based actions are performed\n180\t    at the appropriate steps:\n181\t\n182\t    - **Untap**: Untap all permanents, clear summoning sickness, reset\n183\t      land plays.\n184\t    - **Draw**: Active player draws a card.\n185\t    - **Combat**: Delegate to combat system functions.\n186\t    - **Cleanup**: Clear damage, remove expired effects.\n187\t\n188\t    After the last step (Cleanup), the turn number is incremented and\n189\t    the active player swaps via :meth:`GameState.advance_phase`.\n190\t\n191\t    Parameters:\n192\t        game: The game state to advance through one complete turn.\n193\t    \"\"\"\n194\t    start_turn = game.turn_number\n195\t\n196\t    while game.turn_number == start_turn:\n197\t        current = (game.phase, game.step)\n198\t\n199\t        # Perform turn-based actions for the current step\n200\t        if current == (Phase.BEGINNING, Step.UNTAP):\n201\t            _do_untap_step(game)\n202\t        elif current == (Phase.BEGINNING, Step.UPKEEP):\n203\t            from engine.events import BeginningOfUpkeepTriggeredEvent\n204\t            game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n205\t        elif current == (Phase.BEGINNING, Step.DRAW):\n206\t            _do_draw_step(game)\n207\t        elif game.phase in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN) and game.step is None:\n208\t            from engine.events import BeginningOfMainPhaseTriggeredEvent\n209\t            game.trigger_manager.fire_event(\n210\t                game,\n211\t                BeginningOfMainPhaseTriggeredEvent(\n212\t                    player=game.active_player,\n213\t                    precombat=(game.phase == Phase.PRECOMBAT_MAIN),\n214\t                ),\n215\t            )\n216\t        elif game.phase == Phase.COMBAT and game.step is not None:\n217\t            _do_combat_step(game, game.step)\n218\t        elif current == (Phase.ENDING, Step.CLEANUP):\n219\t            _do_cleanup_step(game)\n220\t\n221\t        # Grant priority at this phase/step unless it's Untap or Cleanup.\n222\t        if current not in _NO_PRIORITY_STEPS:\n223\t            priority_loop(game)\n224\t\n225\t        # Advance to the next phase/step (or to next turn).\n226\t        game.advance_phase()\n227\t"}]},"parent_tool_use_id":"toolu_01GzTivkk8UJSRY11VipzqHn","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"38010052-bc2f-48fe-a14d-89d9575e0529","timestamp":"2026-06-02T08:27:26.501Z","subagent_type":"Tester","task_description":"Extend tests for sos_57 timing"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GXXnsemqPJoCmCPNCfwYwa","type":"tool_result","content":"1\t\"\"\"Mana pool and cost payment logic.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom engine.types import Color, HybridManaSymbol, ManaCost, ManaType\n6\t\n7\t# Map colored ManaTypes to their corresponding Color enum values.\n8\t_MANA_TO_COLOR: dict[ManaType, Color] = {\n9\t    ManaType.WHITE: Color.WHITE,\n10\t    ManaType.BLUE: Color.BLUE,\n11\t    ManaType.BLACK: Color.BLACK,\n12\t    ManaType.RED: Color.RED,\n13\t    ManaType.GREEN: Color.GREEN,\n14\t}\n15\t\n16\t\n17\tclass ManaPool:\n18\t    \"\"\"Tracks available mana for a player.\n19\t\n20\t    Internal storage uses a ``dict[ManaType, int]`` mapping each mana type\n21\t    to its current count.\n22\t    \"\"\"\n23\t\n24\t    def __init__(self) -> None:\n25\t        self._pool: dict[ManaType, int] = {mt: 0 for mt in ManaType}\n26\t        self._last_payment_colors: list[Color] = []\n27\t\n28\t    # ------------------------------------------------------------------\n29\t    # Basic operations\n30\t    # ------------------------------------------------------------------\n31\t\n32\t    def add(self, mana_type: ManaType, amount: int = 1) -> None:\n33\t        \"\"\"Add *amount* mana of the given type to the pool.\n34\t\n35\t        Parameters:\n36\t            mana_type: The type of mana to add.\n37\t            amount: How many mana to add (must be non-negative).\n38\t        \"\"\"\n39\t        if amount < 0:\n40\t            raise ValueError(f\"Cannot add negative mana: {amount}\")\n41\t        self._pool[mana_type] = self._pool.get(mana_type, 0) + amount\n42\t\n43\t    def empty(self) -> None:\n44\t        \"\"\"Clear the pool — happens at phase/step transitions.\"\"\"\n45\t        for mt in self._pool:\n46\t            self._pool[mt] = 0\n47\t\n48\t    def total(self) -> int:\n49\t        \"\"\"Return the total amount of mana in the pool across all types.\"\"\"\n50\t        return sum(self._pool.values())\n51\t\n52\t    def get(self, mana_type: ManaType) -> int:\n53\t        \"\"\"Return the amount of a specific mana type in the pool.\"\"\"\n54\t        return self._pool.get(mana_type, 0)\n55\t\n56\t    @property\n57\t    def last_payment_colors(self) -> list[Color]:\n58\t        \"\"\"Return the distinct colors of mana spent in the last :meth:`pay` call.\n59\t\n60\t        Colorless mana is not a color and is excluded.  The list is sorted\n61\t        by Color enum order for determinism.  Empty if no payment has been\n62\t        made or if all mana spent was colorless.\n63\t        \"\"\"\n64\t        return list(self._last_payment_colors)\n65\t\n66\t    # ------------------------------------------------------------------\n67\t    # Cost payment\n68\t    # ------------------------------------------------------------------\n69\t\n70\t    def can_pay(self, cost: ManaCost) -> bool:\n71\t        \"\"\"Check whether the pool can satisfy *cost*.\n72\t\n73\t        Generic mana can be paid by any type.  X is treated as 0 for\n74\t        ``can_pay`` unless explicitly set in the cost's generic component.\n75\t        Hybrid symbols can be paid with either option; this method uses\n76\t        backtracking to find a valid assignment.\n77\t\n78\t        Returns:\n79\t            True if the pool has enough mana to pay the cost.\n80\t        \"\"\"\n81\t        remaining: dict[ManaType, int] = dict(self._pool)\n82\t\n83\t        # Pay colored/colorless pips first.\n84\t        for mana_type, count in cost.pips.items():\n85\t            if remaining.get(mana_type, 0) < count:\n86\t                return False\n87\t            remaining[mana_type] = remaining.get(mana_type, 0) - count\n88\t\n89\t        # Solve hybrid symbols with backtracking.\n90\t        if cost.hybrid:\n91\t            if not self._can_pay_hybrid(remaining, list(cost.hybrid), 0, cost.generic):\n92\t                return False\n93\t            return True\n94\t\n95\t        # Then check generic — sum of all remaining mana must cover it.\n96\t        return sum(remaining.values()) >= cost.generic\n97\t\n98\t    def pay(self, cost: ManaCost, choices: dict[ManaType, int] | None = None) -> bool:\n99\t        \"\"\"Deduct mana from the pool to pay *cost*.\n100\t\n101\t        Parameters:\n102\t            cost: The mana cost to pay.\n103\t            choices: How to split the generic portion across mana types.\n104\t                If ``None``, auto-pay greedily: pay colored pips first,\n105\t                then hybrid symbols, then generic using colorless first,\n106\t                then excess colored.\n107\t\n108\t        Returns:\n109\t            True if payment succeeded, False if the pool has insufficient mana.\n110\t        \"\"\"\n111\t        if not self.can_pay(cost):\n112\t            return False\n113\t\n114\t        # Work on a copy so we can roll back on failure.\n115\t        working: dict[ManaType, int] = dict(self._pool)\n116\t\n117\t        # 1. Pay colored/colorless pips.\n118\t        for mana_type, count in cost.pips.items():\n119\t            working[mana_type] -= count\n120\t\n121\t        # 2. When explicit generic choices are provided, reserve that mana\n122\t        #    *before* solving hybrids so the solver doesn't steal it.\n123\t        generic_remaining = cost.generic\n124\t        if generic_remaining > 0 and choices is not None:\n125\t            # Reject negative choice amounts — they would create mana.\n126\t            if any(v < 0 for v in choices.values()):\n127\t                return False\n128\t            # Validate choices sum to generic cost.\n129\t            if sum(choices.values()) != generic_remaining:\n130\t                return False\n131\t            for mana_type, amount in choices.items():\n132\t                if working.get(mana_type, 0) < amount:\n133\t                    return False\n134\t                working[mana_type] -= amount\n135\t\n136\t        # 3. Pay hybrid symbols using backtracking to find a valid assignment.\n137\t        #    Generic choices (if any) have already been reserved above,\n138\t        #    so _solve_hybrid sees only the genuinely available mana.\n139\t        if cost.hybrid:\n140\t            generic_for_solver = generic_remaining if choices is None else 0\n141\t            hybrid_assignment = self._solve_hybrid(\n142\t                working, list(cost.hybrid), 0, generic_for_solver,\n143\t            )\n144\t            if hybrid_assignment is None:\n145\t                return False  # pragma: no cover – should not happen after can_pay\n146\t            for mt in hybrid_assignment:\n147\t                working[mt] = working.get(mt, 0) - 1\n148\t\n149\t        # 4. Pay generic cost (auto-pay path — choices already deducted above).\n150\t        if generic_remaining > 0 and choices is None:\n151\t            generic_remaining = self._auto_pay_generic(working, generic_remaining)\n152\t            if generic_remaining > 0:\n153\t                return False  # pragma: no cover – should not happen after can_pay\n154\t\n155\t        # Commit the payment.\n156\t        # Compute colors of mana spent by comparing old pool to new working pool.\n157\t        colors_spent: set[Color] = set()\n158\t        for mt, old_amount in self._pool.items():\n159\t            new_amount = working.get(mt, 0)\n160\t            if new_amount < old_amount and mt in _MANA_TO_COLOR:\n161\t                colors_spent.add(_MANA_TO_COLOR[mt])\n162\t        self._last_payment_colors = sorted(colors_spent, key=lambda c: c.value)\n163\t        self._pool = working\n164\t        return True\n165\t\n166\t    @staticmethod\n167\t    def _can_pay_hybrid(\n168\t        remaining: dict[ManaType, int],\n169\t        hybrids: list[HybridManaSymbol],\n170\t        idx: int,\n171\t        generic: int,\n172\t    ) -> bool:\n173\t        \"\"\"Recursively check if hybrid symbols + generic can be satisfied.\n174\t\n175\t        Uses backtracking: for each hybrid symbol, try option_a then option_b.\n176\t        After all hybrids are assigned, check that remaining mana covers generic.\n177\t        \"\"\"\n178\t        if idx >= len(hybrids):\n179\t            return sum(remaining.values()) >= generic\n180\t\n181\t        sym = hybrids[idx]\n182\t        for option in (sym.option_a, sym.option_b):\n183\t            if remaining.get(option, 0) > 0:\n184\t                remaining[option] -= 1\n185\t                if ManaPool._can_pay_hybrid(remaining, hybrids, idx + 1, generic):\n186\t                    remaining[option] += 1\n187\t                    return True\n188\t                remaining[option] += 1\n189\t        return False\n190\t\n191\t    @staticmethod\n192\t    def _solve_hybrid(\n193\t        remaining: dict[ManaType, int],\n194\t        hybrids: list[HybridManaSymbol],\n195\t        idx: int,\n196\t        generic: int,\n197\t    ) -> list[ManaType] | None:\n198\t        \"\"\"Find a valid assignment for hybrid symbols.\n199\t\n200\t        Returns a list of ManaType choices (one per hybrid symbol) or None\n201\t        if no valid assignment exists.\n202\t        \"\"\"\n203\t        if idx >= len(hybrids):\n204\t            if sum(remaining.values()) >= generic:\n205\t                return []\n206\t            return None\n207\t\n208\t        sym = hybrids[idx]\n209\t        for option in (sym.option_a, sym.option_b):\n210\t            if remaining.get(option, 0) > 0:\n211\t                remaining[option] -= 1\n212\t                result = ManaPool._solve_hybrid(remaining, hybrids, idx + 1, generic)\n213\t                if result is not None:\n214\t                    remaining[option] += 1\n215\t                    return [option] + result\n216\t                remaining[option] += 1\n217\t        return None\n218\t\n219\t    @staticmethod\n220\t    def _auto_pay_generic(working: dict[ManaType, int], amount: int) -> int:\n221\t        \"\"\"Deduct *amount* generic mana from *working*, preferring colorless.\n222\t\n223\t        Returns the remaining unpaid generic amount (0 on success).\n224\t        \"\"\"\n225\t        # Pay with colorless first.\n226\t        if working.get(ManaType.COLORLESS, 0) > 0:\n227\t            take = min(working[ManaType.COLORLESS], amount)\n228\t            working[ManaType.COLORLESS] -= take\n229\t            amount -= take\n230\t\n231\t        # Then pay with each colored type in enum order.\n232\t        for mt in ManaType:\n233\t            if mt is ManaType.COLORLESS:\n234\t                continue\n235\t            if amount <= 0:\n236\t                break\n237\t            if working.get(mt, 0) > 0:\n238\t                take = min(working[mt], amount)\n239\t                working[mt] -= take\n240\t                amount -= take\n241\t\n242\t        return amount\n243\t\n244\t    # ------------------------------------------------------------------\n245\t    # Dunder helpers\n246\t    # ------------------------------------------------------------------\n247\t\n248\t    def __repr__(self) -> str:\n249\t        non_zero = {mt.name: v for mt, v in self._pool.items() if v > 0}\n250\t        return f\"ManaPool({non_zero})\"\n251\t"}]},"parent_tool_use_id":"toolu_01GzTivkk8UJSRY11VipzqHn","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"a12cb4b6-715f-409b-b5df-47833a9d94c9","timestamp":"2026-06-02T08:27:26.501Z","subagent_type":"Tester","task_description":"Extend tests for sos_57 timing"}
