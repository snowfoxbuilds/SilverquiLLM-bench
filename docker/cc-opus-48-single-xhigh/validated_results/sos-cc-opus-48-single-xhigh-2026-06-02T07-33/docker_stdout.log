{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Aq2G3LyJctn9aYpM8Sogz4","type":"tool_result","content":"1\t\"\"\"Card implementation for Ral Zarek, Guest Lecturer.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import LoyaltyAbility, Planeswalker\n8\tfrom engine.types import CardType, ManaCost, Supertype, TargetRequirement, Zone\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t    from engine.player import Player\n13\t\n14\t\n15\tclass RalZarekGuestLecturer(Planeswalker):\n16\t    \"\"\"Ral Zarek, Guest Lecturer — {1}{B}{B} Legendary Planeswalker — Ral — 3.\n17\t\n18\t    +1: Surveil 2.\n19\t    −1: Any number of target players each discard a card.\n20\t    −2: Return target creature card with mana value 3 or less from your\n21\t        graveyard to the battlefield.\n22\t    −7: Flip five coins. Target opponent skips their next X turns, where X\n23\t        is the number of coins that came up heads.\n24\t\n25\t    SOS collector number 97.\n26\t    \"\"\"\n27\t\n28\t    def __init__(self, **kwargs: Any) -> None:\n29\t        kwargs.setdefault(\"name\", \"Ral Zarek, Guest Lecturer\")\n30\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{B}{B}\"))\n31\t        kwargs.setdefault(\"starting_loyalty\", 3)\n32\t        kwargs.setdefault(\"supertypes\", set())\n33\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.LEGENDARY}\n34\t        kwargs.setdefault(\"subtypes\", set())\n35\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Ral\"}\n36\t        kwargs.setdefault(\n37\t            \"rules_text\",\n38\t            \"+1: Surveil 2.\\n\"\n39\t            \"−1: Any number of target players each discard a card.\\n\"\n40\t            \"−2: Return target creature card with mana value 3 or less from \"\n41\t            \"your graveyard to the battlefield.\\n\"\n42\t            \"−7: Flip five coins. Target opponent skips their next X turns, \"\n43\t            \"where X is the number of coins that came up heads.\",\n44\t        )\n45\t        super().__init__(**kwargs)\n46\t\n47\t    # ------------------------------------------------------------------\n48\t    # Targeting\n49\t    # ------------------------------------------------------------------\n50\t\n51\t    def get_targets(self, game: GameState) -> list[Any]:\n52\t        \"\"\"Declare the graveyard-scoped target requirement for −2.\n53\t\n54\t        The −2 ability returns a *creature card with mana value 3 or less*\n55\t        from the controller's graveyard.  The other abilities target players\n56\t        (\"any number of target players\", \"target opponent\"); those are\n57\t        resolved via the engine's player-choice plumbing and stashed on\n58\t        ``_resolve_targets`` / ``_resolve_target`` and so do not need a\n59\t        battlefield/graveyard ``TargetRequirement`` here.\n60\t        \"\"\"\n61\t        controller = self.controller or game.active_player\n62\t\n63\t        def _reanimate_filter(obj: Any) -> bool:\n64\t            if CardType.CREATURE not in getattr(obj, \"card_types\", set()):\n65\t                return False\n66\t            cost = getattr(obj, \"mana_cost\", None)\n67\t            mana_value = cost.cmc if cost is not None else 0\n68\t            return mana_value <= 3\n69\t\n70\t        return [\n71\t            TargetRequirement(\n72\t                filter_fn=_reanimate_filter,\n73\t                description=\"creature card with mana value 3 or less in your graveyard\",\n74\t                zone=Zone.GRAVEYARD,\n75\t            )\n76\t        ]\n77\t\n78\t    # ------------------------------------------------------------------\n79\t    # Loyalty abilities\n80\t    # ------------------------------------------------------------------\n81\t\n82\t    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n83\t        pw = self\n84\t\n85\t        def _plus1(game: Any) -> None:\n86\t            \"\"\"+1: Surveil 2.\n87\t\n88\t            Look at the top two cards of your library; for each, the\n89\t            controller may put it into the graveyard.  Processed\n90\t            top-card-first via ``choose_yes_no`` (engine surveil convention,\n91\t            see ``cards/fdn/fdn_157`` Lightshell Duo).\n92\t            \"\"\"\n93\t            controller = pw.controller\n94\t            if controller is None:\n95\t                return\n96\t            library = controller.zones[Zone.LIBRARY]\n97\t            cards = list(library.get_all())\n98\t            if not cards:\n99\t                return\n100\t            # Top of library is the last element; take up to two, top first.\n101\t            top_cards = cards[-min(2, len(cards)):]\n102\t            for card in reversed(top_cards):\n103\t                put_in_gy = controller.choose_yes_no(\n104\t                    f\"Surveil: Put {getattr(card, 'name', 'card')} into your graveyard?\"\n105\t                )\n106\t                if put_in_gy:\n107\t                    library.remove(card)\n108\t                    controller.zones[Zone.GRAVEYARD].add(card)\n109\t\n110\t        def _minus1(game: Any) -> None:\n111\t            \"\"\"−1: Any number of target players each discard a card.\"\"\"\n112\t            from engine.game import discard\n113\t\n114\t            targets = getattr(pw, \"_resolve_targets\", None) or []\n115\t            for player in targets:\n116\t                hand = player.zones[Zone.HAND].get_all()\n117\t                if hand:\n118\t                    # The player chooses which card to discard; with no\n119\t                    # scripted choice, discard deterministically from the end.\n120\t                    card = None\n121\t                    chooser = getattr(player, \"choose_card\", None)\n122\t                    if chooser is not None:\n123\t                        try:\n124\t                            card = chooser(hand, \"discard a card\")\n125\t                        except Exception:\n126\t                            card = None\n127\t                    if card is None or card not in hand:\n128\t                        card = hand[-1]\n129\t                    discard(game, player, card)\n130\t\n131\t        def _minus2(game: Any) -> None:\n132\t            \"\"\"−2: Return target creature (mv ≤ 3) from your graveyard to play.\"\"\"\n133\t            from engine.zones import move_to_zone\n134\t\n135\t            target = getattr(pw, \"_resolve_target\", None)\n136\t            controller = pw.controller\n137\t            if target is None or controller is None:\n138\t                return\n139\t            graveyard = controller.zones[Zone.GRAVEYARD]\n140\t            if not graveyard.contains(target):\n141\t                return\n142\t            # Enters under the planeswalker's controller's control.\n143\t            target.controller = controller\n144\t            move_to_zone(game, target, Zone.GRAVEYARD, Zone.BATTLEFIELD)\n145\t\n146\t        def _minus7(game: Any) -> None:\n147\t            \"\"\"−7: Flip five coins. Target opponent skips their next X turns.\"\"\"\n148\t            from engine.game import add_skipped_turns, flip_coins\n149\t\n150\t            target = getattr(pw, \"_resolve_target\", None)\n151\t            if target is None:\n152\t                return\n153\t            heads = flip_coins(game, 5)\n154\t            add_skipped_turns(game, target, heads)\n155\t\n156\t        return [\n157\t            LoyaltyAbility(\n158\t                loyalty_cost=+1,\n159\t                effect=_plus1,\n160\t                description=\"+1: Surveil 2.\",\n161\t            ),\n162\t            LoyaltyAbility(\n163\t                loyalty_cost=-1,\n164\t                effect=_minus1,\n165\t                description=\"−1: Any number of target players each discard a card.\",\n166\t            ),\n167\t            LoyaltyAbility(\n168\t                loyalty_cost=-2,\n169\t                effect=_minus2,\n170\t                description=\"−2: Return target creature card with mana value 3 or \"\n171\t                \"less from your graveyard to the battlefield.\",\n172\t            ),\n173\t            LoyaltyAbility(\n174\t                loyalty_cost=-7,\n175\t                effect=_minus7,\n176\t                description=\"−7: Flip five coins. Target opponent skips their next \"\n177\t                \"X turns, where X is the number of heads.\",\n178\t            ),\n179\t        ]\n180\t"}]},"parent_tool_use_id":"toolu_01PJsLyamRY5s6LsmWNDw4TW","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"bfcd6600-e24a-483a-99eb-db585c5cefce","timestamp":"2026-06-02T08:43:01.911Z","subagent_type":"Tester","task_description":"Extend tests for sos_97 ultimate"}
