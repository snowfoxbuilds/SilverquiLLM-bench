{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GVRV9LQJWaBNsrPvSApuSt","type":"tool_result","content":"1\t\"\"\"Tests for SOS 257 — Great Hall of the Biblioplex.\n2\t\n3\tGreat Hall of the Biblioplex — Land:\n4\t\n5\t    {T}: Add {C}.\n6\t    {T}, Pay 1 life: Add one mana of any color. Spend this mana only to cast\n7\t    an instant or sorcery spell.\n8\t    {5}: If this land isn't a creature, it becomes a 2/4 Wizard creature with\n9\t    \"Whenever you cast an instant or sorcery spell, this creature gets +1/+0\n10\t    until end of turn.\" It's still a land.\n11\t\n12\tBehaviour contract (TDD red phase — these tests fail against the empty stub).\n13\t\n14\t* **Static data** — a :class:`engine.card.Land` named ``\"Great Hall of the\n15\t  Biblioplex\"``, type line ``Land`` (``CardType.LAND`` only, never CREATURE\n16\t  while unanimated), no colors, no mana cost, and NOT a basic land (no\n17\t  ``Supertype.BASIC``).  Power/toughness are ``None`` while it is not a\n18\t  creature.\n19\t* **Ability 1 — {T}: Add {C}** — one mana ability that, when its cost runs,\n20\t  taps the land and adds exactly one ``COLORLESS`` mana to the controller's\n21\t  pool.  Modelled exactly on fdn_272 (Plains) / fdn_267 (Secluded Courtyard).\n22\t* **Ability 2 — {T}, Pay 1 life: any color (instant/sorcery only)** — a second\n23\t  mana ability that taps the land, reduces the controller's life by 1, and\n24\t  adds one mana of a chosen color.  The \"spend this mana only to cast an\n25\t  instant or sorcery spell\" restriction has no engine surface today (the\n26\t  ManaPool has no restricted-mana tagging — see fdn_267's documented engine\n27\t  limitation); that one clause is recorded in ``untestable.json``.\n28\t* **Ability 3 — {5}: animate** — an activated ability ({5}) that, while the\n29\t  land is not already a creature, turns it into a 2/4 Wizard creature that is\n30\t  STILL a land, with a granted \"Whenever you cast an instant or sorcery spell,\n31\t  this creature gets +1/+0 until end of turn\" trigger.  The engine has no\n32\t  becomes-a-creature animation pipeline nor an until-end-of-turn pump grant;\n33\t  the deep assertions are tolerant probes that fail loudly if the surface is\n34\t  absent, and the hardest pieces are recorded in ``untestable.json``.\n35\t\n36\tThe mana / activated abilities are exercised by reading the card's public\n37\tability surface (``get_mana_abilities`` / ``get_activated_abilities``) and\n38\tinvoking the cost/effect callables directly — the established per-card test\n39\tconvention used by the FDN reference land cards (fdn_272, fdn_267) and the\n40\tSOS reference cards.\n41\t\"\"\"\n42\t\n43\tfrom __future__ import annotations\n44\t\n45\tfrom typing import Any\n46\t\n47\timport pytest\n48\t\n49\tfrom cards.sos.sos_257.card_impl import GreatHallOfTheBiblioplex\n50\tfrom engine.card import ActivatedAbility, Creature, Instant, Land, ManaAbility, Sorcery\n51\tfrom engine.casting import CastingError, cast_spell\n52\tfrom engine.events import SpellCastTriggeredEvent\n53\tfrom engine.types import (\n54\t    CardType,\n55\t    Color,\n56\t    ManaCost,\n57\t    ManaType,\n58\t    Phase,\n59\t    Supertype,\n60\t)\n61\tfrom test_utils import create_game, set_board_state\n62\t\n63\t\n64\t# ---------------------------------------------------------------------------\n65\t# Helpers\n66\t# ---------------------------------------------------------------------------\n67\t\n68\t\n69\tdef _card(owner: Any = None, controller: Any = None) -> GreatHallOfTheBiblioplex:\n70\t    \"\"\"Build a Great Hall instance (owner == controller by default).\"\"\"\n71\t    return GreatHallOfTheBiblioplex(owner=owner, controller=controller)\n72\t\n73\t\n74\tdef _run_cost(ability: Any, game: Any, source: Any) -> bool:\n75\t    \"\"\"Invoke an ability cost callable, tolerating 1- or 2-arg signatures.\n76\t\n77\t    fdn_272 (Plains) uses a 1-arg ``cost(game)`` closure while fdn_267\n78\t    (Secluded Courtyard) uses a 2-arg ``cost(game, source)`` closure; both\n79\t    shapes are legal, so call accordingly.\n80\t    \"\"\"\n81\t    try:\n82\t        return bool(ability.cost(game, source))\n83\t    except TypeError:\n84\t        return bool(ability.cost(game))\n85\t\n86\t\n87\tdef _run_effect(ability: Any, game: Any, source: Any) -> None:\n88\t    \"\"\"Invoke a mana ability's ``mana_produced`` / effect callable.\n89\t\n90\t    ``ManaAbility.mana_produced`` may either *return* a ``{ManaType: int}``\n91\t    dict (fdn_272 style) or directly mutate the controller's pool (fdn_267\n92\t    style).  When it returns a dict, deposit it into the controller's pool\n93\t    so both conventions are observable through the pool.\n94\t    \"\"\"\n95\t    produced = ability.mana_produced(game)\n96\t    if isinstance(produced, dict):\n97\t        controller = source.controller\n98\t        for mana_type, amount in produced.items():\n99\t            controller.mana_pool.add(mana_type, amount)\n100\t\n101\t\n102\tdef _colorless_mana_ability(card: Any) -> ManaAbility:\n103\t    \"\"\"Return the ``{T}: Add {C}`` ability (the one that yields colorless).\"\"\"\n104\t    abilities = card.get_mana_abilities()\n105\t    for ab in abilities:\n106\t        # Probe each ability in a fresh game; pick the one that produces {C}.\n107\t        game = create_game()\n108\t        p = game.players[0]\n109\t        card.owner = p\n110\t        card.controller = p\n111\t        card.is_tapped = False\n112\t        if not _run_cost(ab, game, card):\n113\t            continue\n114\t        _run_effect(ab, game, card)\n115\t        if p.mana_pool.get(ManaType.COLORLESS) >= 1 and p.mana_pool.total() == 1:\n116\t            return ab\n117\t    raise AssertionError(\"No {T}: Add {C} mana ability found on Great Hall\")\n118\t\n119\t\n120\t# ---------------------------------------------------------------------------\n121\t# Static properties\n122\t# ---------------------------------------------------------------------------\n123\t\n124\t\n125\tclass TestGreatHallProperties:\n126\t    \"\"\"Static card data should match the SOS 257 spec.\"\"\"\n127\t\n128\t    def test_name(self) -> None:\n129\t        assert _card().name == \"Great Hall of the Biblioplex\"\n130\t\n131\t    def test_is_a_land(self) -> None:\n132\t        card = _card()\n133\t        assert isinstance(card, Land)\n134\t        assert CardType.LAND in card.card_types\n135\t\n136\t    def test_not_a_creature_while_unanimated(self) -> None:\n137\t        \"\"\"It is a plain land until {5} animates it.\"\"\"\n138\t        assert CardType.CREATURE not in _card().card_types\n139\t\n140\t    def test_has_no_mana_cost(self) -> None:\n141\t        \"\"\"Lands are played, not cast — no mana cost is printed.\"\"\"\n142\t        assert _card().mana_cost == ManaCost()\n143\t\n144\t    def test_cannot_be_cast(self) -> None:\n145\t        \"\"\"Lands return can_cast() == False (they are played as a special action).\"\"\"\n146\t        game = create_game()\n147\t        assert _card().can_cast(game) is False\n148\t\n149\t    def test_has_no_colors(self) -> None:\n150\t        \"\"\"A colorless land — no colored identity.\"\"\"\n151\t        from engine.protection import get_colors\n152\t\n153\t        assert get_colors(_card()) == set()\n154\t\n155\t    def test_is_not_a_basic_land(self) -> None:\n156\t        \"\"\"Great Hall is a nonbasic land — no BASIC supertype.\"\"\"\n157\t        assert Supertype.BASIC not in _card().supertypes\n158\t\n159\t    def test_has_no_basic_land_subtype(self) -> None:\n160\t        \"\"\"It is not a Plains/Island/Swamp/Mountain/Forest.\"\"\"\n161\t        basics = {\"Plains\", \"Island\", \"Swamp\", \"Mountain\", \"Forest\"}\n162\t        assert _card().subtypes.isdisjoint(basics)\n163\t\n164\t    def test_power_toughness_unset_while_not_a_creature(self) -> None:\n165\t        \"\"\"A non-creature land has no power/toughness characteristic.\n166\t\n167\t        Either the attributes are absent, or they read as ``None`` — never a\n168\t        concrete number while the card is an ordinary (non-creature) land.\n169\t        \"\"\"\n170\t        card = _card()\n171\t        assert getattr(card, \"power\", None) is None\n172\t        assert getattr(card, \"toughness\", None) is None\n173\t\n174\t\n175\t# ---------------------------------------------------------------------------\n176\t# Ability 1 — {T}: Add {C}\n177\t# ---------------------------------------------------------------------------\n178\t\n179\t\n180\tclass TestGreatHallColorlessManaAbility:\n181\t    \"\"\"{T}: Add {C} — a basic colorless mana ability.\"\"\"\n182\t\n183\t    def test_exposes_at_least_two_mana_abilities(self) -> None:\n184\t        \"\"\"The card prints two mana abilities (the {C} one and the any-color one).\"\"\"\n185\t        card = _card()\n186\t        abilities = card.get_mana_abilities()\n187\t        assert isinstance(abilities, list)\n188\t        assert len(abilities) >= 2\n189\t        assert all(isinstance(ab, ManaAbility) for ab in abilities)\n190\t\n191\t    def test_colorless_ability_taps_the_land(self) -> None:\n192\t        game = create_game()\n193\t        p1 = game.players[0]\n194\t        card = _card(owner=p1, controller=p1)\n195\t        card.is_tapped = False\n196\t        ab = _colorless_mana_ability(card)\n197\t        # Re-run the cost on a clean instance to assert the tap side effect.\n198\t        card.is_tapped = False\n199\t        assert _run_cost(ab, game, card) is True\n200\t        assert card.is_tapped is True\n201\t\n202\t    def test_colorless_ability_adds_one_colorless_mana(self) -> None:\n203\t        game = create_game()\n204\t        p1 = game.players[0]\n205\t        card = _card(owner=p1, controller=p1)\n206\t        card.is_tapped = False\n207\t        ab = _colorless_mana_ability(card)\n208\t        # Run the chosen ability for real against p1.\n209\t        card.is_tapped = False\n210\t        assert _run_cost(ab, game, card) is True\n211\t        _run_effect(ab, game, card)\n212\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 1\n213\t        assert p1.mana_pool.total() == 1\n214\t\n215\t    def test_colorless_ability_cost_fails_when_already_tapped(self) -> None:\n216\t        \"\"\"A tapped land cannot pay its {T} cost again.\"\"\"\n217\t        game = create_game()\n218\t        p1 = game.players[0]\n219\t        card = _card(owner=p1, controller=p1)\n220\t        ab = _colorless_mana_ability(card)\n221\t        card.is_tapped = True\n222\t        assert _run_cost(ab, game, card) is False\n223\t\n224\t\n225\t# ---------------------------------------------------------------------------\n226\t# Ability 2 — {T}, Pay 1 life: Add one mana of any color (instant/sorcery only)\n227\t# ---------------------------------------------------------------------------\n228\t\n229\t\n230\tclass TestGreatHallAnyColorManaAbility:\n231\t    \"\"\"{T}, Pay 1 life: Add one mana of any color (restricted to I/S casting).\"\"\"\n232\t\n233\t    def _any_color_ability(self, card: Any) -> ManaAbility:\n234\t        \"\"\"Return the second (any-color, pay-1-life) mana ability.\n235\t\n236\t        Identified positionally: the colorless ability is the {C} producer;\n237\t        the remaining mana ability is the any-color one.\n238\t        \"\"\"\n239\t        colorless = _colorless_mana_ability(card)\n240\t        others = [ab for ab in card.get_mana_abilities() if ab is not colorless]\n241\t        assert others, \"Great Hall must print a second (any-color) mana ability\"\n242\t        return others[0]\n243\t\n244\t    def test_any_color_ability_taps_the_land(self) -> None:\n245\t        game = create_game(scripts=([Color.BLUE], []))\n246\t        p1 = game.players[0]\n247\t        card = _card(owner=p1, controller=p1)\n248\t        ab = self._any_color_ability(card)\n249\t        card.is_tapped = False\n250\t        assert _run_cost(ab, game, card) is True\n251\t        assert card.is_tapped is True\n252\t\n253\t    def test_any_color_ability_pays_one_life(self) -> None:\n254\t        \"\"\"Activating the second ability reduces the controller's life by 1.\"\"\"\n255\t        game = create_game(scripts=([Color.RED], []))\n256\t        p1 = game.players[0]\n257\t        set_board_state(game, 0, life=20)\n258\t        card = _card(owner=p1, controller=p1)\n259\t        ab = self._any_color_ability(card)\n260\t        card.is_tapped = False\n261\t        before = p1.life\n262\t        _run_cost(ab, game, card)\n263\t        _run_effect(ab, game, card)\n264\t        assert p1.life == before - 1\n265\t\n266\t    def test_any_color_ability_adds_one_mana_of_chosen_color(self) -> None:\n267\t        \"\"\"The chosen color (here blue) is the single mana added.\"\"\"\n268\t        game = create_game(scripts=([Color.BLUE], []))\n269\t        p1 = game.players[0]\n270\t        card = _card(owner=p1, controller=p1)\n271\t        ab = self._any_color_ability(card)\n272\t        card.is_tapped = False\n273\t        _run_cost(ab, game, card)\n274\t        _run_effect(ab, game, card)\n275\t        assert p1.mana_pool.get(ManaType.BLUE) == 1\n276\t        # Exactly one mana of one color is produced.\n277\t        assert p1.mana_pool.total() == 1\n278\t\n279\t    def test_any_color_ability_can_produce_a_different_color(self) -> None:\n280\t        \"\"\"A different scripted color (green) is honoured — it is \"any color\".\"\"\"\n281\t        game = create_game(scripts=([Color.GREEN], []))\n282\t        p1 = game.players[0]\n283\t        card = _card(owner=p1, controller=p1)\n284\t        ab = self._any_color_ability(card)\n285\t        card.is_tapped = False\n286\t        _run_cost(ab, game, card)\n287\t        _run_effect(ab, game, card)\n288\t        assert p1.mana_pool.get(ManaType.GREEN) == 1\n289\t        assert p1.mana_pool.total() == 1\n290\t\n291\t    def test_any_color_mana_is_marked_restricted_to_instants_sorceries(self) -> None:\n292\t        \"\"\"The produced mana must carry an instant/sorcery-only spend restriction.\n293\t\n294\t        TOLERANT PROBE.  The engine's ``ManaPool`` has no restricted-mana\n295\t        tagging today (fdn_267 documents the same limitation), so there is no\n296\t        public way to add or read such a restriction.  This test fails loudly\n297\t        rather than passing vacuously: if a restriction surface is ever added\n298\t        (a tag on the pool, a per-mana restriction record, or a card-level\n299\t        query such as ``produces_restricted_mana``/``mana_spend_restriction``),\n300\t        it must be discoverable here.  Recorded in untestable.json until then.\n301\t        \"\"\"\n302\t        card = _card()\n303\t        ab = self._any_color_ability(card)\n304\t        restriction_surface = (\n305\t            hasattr(card, \"mana_spend_restriction\")\n306\t            or hasattr(card, \"produces_restricted_mana\")\n307\t            or hasattr(ab, \"restriction\")\n308\t            or hasattr(ab, \"spend_restriction\")\n309\t            or hasattr(create_game().players[0].mana_pool, \"restrictions\")\n310\t        )\n311\t        assert restriction_surface, (\n312\t            \"No engine surface to tag 'spend this mana only to cast an instant \"\n313\t            \"or sorcery spell' — see untestable.json\"\n314\t        )\n315\t\n316\t\n317\t# ---------------------------------------------------------------------------\n318\t# Ability 3 — {5}: becomes a 2/4 Wizard creature, still a land\n319\t# ---------------------------------------------------------------------------\n320\t\n321\t\n322\tclass TestGreatHallAnimationAbilitySurface:\n323\t    \"\"\"{5}: exposes a non-mana activated ability for the animation.\"\"\"\n324\t\n325\t    def test_exposes_an_activated_ability(self) -> None:\n326\t        \"\"\"The {5} animation is an activated (non-mana) ability.\"\"\"\n327\t        card = _card()\n328\t        abilities = card.get_activated_abilities()\n329\t        assert isinstance(abilities, list)\n330\t        assert len(abilities) >= 1\n331\t        assert all(isinstance(ab, ActivatedAbility) for ab in abilities)\n332\t\n333\t\n334\tclass TestGreatHallAnimationEffect:\n335\t    \"\"\"{5}: If this land isn't a creature, it becomes a 2/4 Wizard creature\n336\t    with a granted instant/sorcery pump trigger.  It's still a land.\n337\t\n338\t    The engine has no becomes-a-creature animation pipeline, so these are\n339\t    TOLERANT PROBES: they invoke the activated ability's effect and then\n340\t    assert the observable end state (added CREATURE type, Wizard subtype, 2/4,\n341\t    LAND retained).  They fail loudly if the animation surface is absent.\n342\t    The deepest pieces are also recorded in untestable.json.\n343\t    \"\"\"\n344\t\n345\t    def _activate(self, card: Any, game: Any) -> None:\n346\t        \"\"\"Pay the {5} cost (if a cost gate exists) and apply the effect.\"\"\"\n347\t        abilities = card.get_activated_abilities()\n348\t        assert abilities, \"Great Hall must print a {5} activated ability\"\n349\t        ab = abilities[0]\n350\t        # Pay the cost if the closure enforces one; tolerate either shape.\n351\t        try:\n352\t            ab.cost(game, card)\n353\t        except TypeError:\n354\t            try:\n355\t                ab.cost(game)\n356\t            except Exception:\n357\t                pass\n358\t        ab.effect(game)\n359\t\n360\t    def test_becomes_a_creature(self) -> None:\n361\t        game = create_game()\n362\t        p1 = game.players[0]\n363\t        card = _card(owner=p1, controller=p1)\n364\t        set_board_state(game, 0, battlefield=[card])\n365\t        assert CardType.CREATURE not in card.card_types\n366\t        self._activate(card, game)\n367\t        assert CardType.CREATURE in card.card_types\n368\t\n369\t    def test_is_still_a_land_after_animation(self) -> None:\n370\t        \"\"\"\"It's still a land.\" — LAND type is retained alongside CREATURE.\"\"\"\n371\t        game = create_game()\n372\t        p1 = game.players[0]\n373\t        card = _card(owner=p1, controller=p1)\n374\t        set_board_state(game, 0, battlefield=[card])\n375\t        self._activate(card, game)\n376\t        assert CardType.LAND in card.card_types\n377\t\n378\t    def test_becomes_a_wizard(self) -> None:\n379\t        game = create_game()\n380\t        p1 = game.players[0]\n381\t        card = _card(owner=p1, controller=p1)\n382\t        set_board_state(game, 0, battlefield=[card])\n383\t        self._activate(card, game)\n384\t        assert \"Wizard\" in card.subtypes\n385\t\n386\t    def test_becomes_two_four(self) -> None:\n387\t        \"\"\"The animated land is a 2/4.\"\"\"\n388\t        game = create_game()\n389\t        p1 = game.players[0]\n390\t        card = _card(owner=p1, controller=p1)\n391\t        set_board_state(game, 0, battlefield=[card])\n392\t        self._activate(card, game)\n393\t        # Recompute continuous effects so layer-based P/T (if any) is applied.\n394\t        game.effect_manager.apply_all(game)\n395\t        assert getattr(card, \"power\", None) == 2\n396\t        assert getattr(card, \"toughness\", None) == 4\n397\t\n398\t    def test_animation_no_op_when_already_a_creature(self) -> None:\n399\t        \"\"\"\"If this land isn't a creature\" — a second activation is a no-op.\n400\t\n401\t        Animating an already-animated Great Hall must not stack a second\n402\t        pump grant or change its 2/4 body.\n403\t        \"\"\"\n404\t        game = create_game()\n405\t        p1 = game.players[0]\n406\t        card = _card(owner=p1, controller=p1)\n407\t        set_board_state(game, 0, battlefield=[card])\n408\t        self._activate(card, game)\n409\t        game.effect_manager.apply_all(game)\n410\t        triggers_after_first = len(game.trigger_manager.get_triggers())\n411\t        # Second activation while already a creature should change nothing.\n412\t        self._activate(card, game)\n413\t        game.effect_manager.apply_all(game)\n414\t        assert getattr(card, \"power\", None) == 2\n415\t        assert getattr(card, \"toughness\", None) == 4\n416\t        assert len(game.trigger_manager.get_triggers()) == triggers_after_first\n417\t\n418\t\n419\tclass TestGreatHallGrantedPumpTrigger:\n420\t    \"\"\"The animated creature gets +1/+0 until end of turn per instant/sorcery\n421\t    spell you cast.  TOLERANT PROBE — no engine grant-on-animation pipeline.\"\"\"\n422\t\n423\t    def _activate(self, card: Any, game: Any) -> None:\n424\t        abilities = card.get_activated_abilities()\n425\t        assert abilities, \"Great Hall must print a {5} activated ability\"\n426\t        ab = abilities[0]\n427\t        try:\n428\t            ab.cost(game, card)\n429\t        except TypeError:\n430\t            try:\n431\t                ab.cost(game)\n432\t            except Exception:\n433\t                pass\n434\t        ab.effect(game)\n435\t\n436\t    def test_animation_registers_a_pump_trigger(self) -> None:\n437\t        \"\"\"Animating the land must register a (cast-an-instant/sorcery) trigger.\n438\t\n439\t        The granted ability fires \"Whenever you cast an instant or sorcery\n440\t        spell\", so a new trigger controlled by the land's controller should be\n441\t        registered when the land becomes a creature.\n442\t        \"\"\"\n443\t        game = create_game()\n444\t        p1 = game.players[0]\n445\t        card = _card(owner=p1, controller=p1)\n446\t        set_board_state(game, 0, battlefield=[card])\n447\t        before = len(game.trigger_manager.get_triggers())\n448\t        self._activate(card, game)\n449\t        after = len(game.trigger_manager.get_triggers())\n450\t        assert after > before, (\n451\t            \"Animation must grant the 'whenever you cast an instant or sorcery \"\n452\t            \"spell' pump trigger — see untestable.json\"\n453\t        )\n454\t\n455\t    def test_pump_trigger_adds_plus_one_zero_until_end_of_turn(self) -> None:\n456\t        \"\"\"Casting an instant/sorcery pumps the animated land +1/+0.\n457\t\n458\t        TOLERANT PROBE: locate the granted trigger registered by the\n459\t        animation, fire its effect once, recompute continuous effects, and\n460\t        assert the body is 3/4 (2/4 plus +1/+0).  Fails loudly if no such\n461\t        trigger/effect surface exists.  The until-end-of-turn duration and the\n462\t        per-cast scaling are recorded in untestable.json.\n463\t        \"\"\"\n464\t        game = create_game()\n465\t        p1 = game.players[0]\n466\t        card = _card(owner=p1, controller=p1)\n467\t        set_board_state(game, 0, battlefield=[card])\n468\t\n469\t        before = list(game.trigger_manager.get_triggers())\n470\t        self._activate(card, game)\n471\t        game.effect_manager.apply_all(game)\n472\t        new_triggers = [\n473\t            t for t in game.trigger_manager.get_triggers() if t not in before\n474\t        ]\n475\t        assert new_triggers, (\n476\t            \"No granted instant/sorcery pump trigger to fire — see untestable.json\"\n477\t        )\n478\t\n479\t        # Fire the granted trigger's effect (as a cast event would) and\n480\t        # recompute the layer system.\n481\t        trig = new_triggers[0]\n482\t        effect = getattr(trig, \"effect\", None)\n483\t        assert callable(effect), \"Granted pump trigger has no callable effect\"\n484\t        effect(game)\n485\t        game.effect_manager.apply_all(game)\n486\t\n487\t        assert getattr(card, \"power\", None) == 3\n488\t        assert getattr(card, \"toughness\", None) == 4\n489\t\n490\t\n491\t# ===========================================================================\n492\t# EXTENDED COVERAGE — the three formerly-deferred mechanisms, now built.\n493\t#\n494\t# These tests drive the REAL engine surfaces the Implementer added:\n495\t#   1. engine.mana.ManaPool.add_restricted / can_pay_for_spell  (+ cast_spell)\n496\t#   2. engine.animation.animate_land  (becomes-a-creature end state + guard)\n497\t#   3. engine.animation.register_instant_sorcery_pump  (granted +1/+0 EOT pump)\n498\t# Each was confirmed to PASS against the now-built engine; the tolerant probes\n499\t# above stay as-is, and these add concrete assertions that fail loudly if any\n500\t# surface regresses.\n501\t# ===========================================================================\n502\t\n503\t\n504\tdef _sorcery_speed(game: Any, player_index: int = 0) -> None:\n505\t    \"\"\"Put *game* in a sorcery-speed window for ``player_index`` (active,\n506\t    pre-combat main, empty stack) so ``cast_spell`` accepts a sorcery/creature.\n507\t    \"\"\"\n508\t    game.active_player_index = player_index\n509\t    game.priority_player_index = player_index\n510\t    game.phase = Phase.PRECOMBAT_MAIN\n511\t    game.step = None\n512\t\n513\t\n514\tdef _restricted_mana_game() -> Any:\n515\t    \"\"\"Return a fresh game in a sorcery-speed window with an empty p1 pool.\"\"\"\n516\t    game = create_game()\n517\t    _sorcery_speed(game, 0)\n518\t    game.players[0].mana_pool.empty()\n519\t    return game\n520\t\n521\t\n522\tclass TestGreatHallRestrictedManaSpend:\n523\t    \"\"\"The any-color mana is tagged \"spend only to cast an instant or sorcery\n524\t    spell\" — engine.mana.ManaPool.add_restricted + can_pay_for_spell, enforced\n525\t    by engine.casting.cast_spell.\n526\t\n527\t    Drives the REAL ManaPool + cast_spell: an instant/sorcery consumes the\n528\t    restricted mana, but a creature spell cannot use it.\n529\t    \"\"\"\n530\t\n531\t    def _produce_restricted_via_card(self, game: Any, color: Color) -> None:\n532\t        \"\"\"Activate Great Hall's {T}, Pay 1 life ability to deposit one mana of\n533\t        *color* tagged instant/sorcery-only into p1's pool (drives the card).\"\"\"\n534\t        p1 = game.players[0]\n535\t        # The any-color producer reads a scripted color choice.\n536\t        if hasattr(p1, \"_script\"):\n537\t            p1._script.appendleft(color)\n538\t        land = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n539\t        set_board_state(game, 0, battlefield=[land])\n540\t        land.is_tapped = False\n541\t        abilities = land.get_mana_abilities()\n542\t        any_color = [ab for ab in abilities if getattr(ab, \"restriction\", None)]\n543\t        assert any_color, \"Great Hall must tag its any-color ability with a restriction\"\n544\t        ab = any_color[0]\n545\t        assert ab.cost(game) is True\n546\t        ab.mana_produced(game)\n547\t\n548\t    def test_card_produced_mana_is_tagged_restricted(self) -> None:\n549\t        \"\"\"The any-color ability deposits mana that the pool records as\n550\t        restricted (not merely ordinary mana).\"\"\"\n551\t        game = create_game(scripts=([Color.BLUE], []))\n552\t        _sorcery_speed(game, 0)\n553\t        game.players[0].mana_pool.empty()\n554\t        self._produce_restricted_via_card(game, Color.BLUE)\n555\t        pool = game.players[0].mana_pool\n556\t        assert pool.get(ManaType.BLUE) == 1\n557\t        assert pool.has_restricted_mana() is True\n558\t        assert pool.restricted_amount() == 1\n559\t\n560\t    def test_instant_can_be_cast_with_restricted_mana(self) -> None:\n561\t        \"\"\"An INSTANT consumes the restricted any-color mana (the permitted\n562\t        spell type) — driven through the real cast_spell pipeline.\"\"\"\n563\t        game = create_game(scripts=([Color.BLUE], []))\n564\t        _sorcery_speed(game, 0)\n565\t        p1 = game.players[0]\n566\t        p1.mana_pool.empty()\n567\t        self._produce_restricted_via_card(game, Color.BLUE)\n568\t        spell = Instant(name=\"Restricted Bolt\", mana_cost=ManaCost.parse(\"{U}\"))\n569\t        set_board_state(game, 0, hand=[spell])\n570\t        cast_spell(game, p1, spell)\n571\t        # The instant reached the stack and the restricted mana was spent.\n572\t        assert not game.stack.is_empty()\n573\t        assert p1.mana_pool.total() == 0\n574\t        assert p1.mana_pool.restricted_amount() == 0\n575\t\n576\t    def test_sorcery_can_be_cast_with_restricted_mana(self) -> None:\n577\t        \"\"\"A SORCERY is also a permitted spend target for the restricted mana.\"\"\"\n578\t        game = _restricted_mana_game()\n579\t        p1 = game.players[0]\n580\t        p1.mana_pool.add_restricted(\n581\t            ManaType.GREEN, 1, source=None\n582\t        )\n583\t        spell = Sorcery(name=\"Restricted Spell\", mana_cost=ManaCost.parse(\"{G}\"))\n584\t        set_board_state(game, 0, hand=[spell])\n585\t        cast_spell(game, p1, spell)\n586\t        assert not game.stack.is_empty()\n587\t        assert p1.mana_pool.total() == 0\n588\t\n589\t    def test_creature_cannot_be_cast_with_restricted_mana(self) -> None:\n590\t        \"\"\"A CREATURE spell is NOT a permitted target — the restricted mana may\n591\t        not pay for it, so cast_spell rejects it as insufficient mana.\"\"\"\n592\t        game = _restricted_mana_game()\n593\t        p1 = game.players[0]\n594\t        p1.mana_pool.add_restricted(ManaType.GREEN, 1, source=None)\n595\t        creature = Creature(\n596\t            name=\"Forbidden Bear\",\n597\t            mana_cost=ManaCost.parse(\"{G}\"),\n598\t            base_power=1,\n599\t            base_toughness=1,\n600\t        )\n601\t        set_board_state(game, 0, hand=[creature])\n602\t        with pytest.raises(CastingError):\n603\t            cast_spell(game, p1, creature)\n604\t        # The spell was rolled back to hand and the restricted mana untouched.\n605\t        assert game.get_hand(p1).contains(creature)\n606\t        assert p1.mana_pool.restricted_amount() == 1\n607\t\n608\t    def test_creature_can_be_cast_with_unrestricted_mana(self) -> None:\n609\t        \"\"\"Anchor: the rejection above is about the RESTRICTION, not the cost.\n610\t\n611\t        The same creature for {G} casts fine when the green mana is ordinary\n612\t        (unrestricted) — so the negative test is not vacuously failing for an\n613\t        unrelated reason.\n614\t        \"\"\"\n615\t        game = _restricted_mana_game()\n616\t        p1 = game.players[0]\n617\t        p1.mana_pool.add(ManaType.GREEN, 1)\n618\t        creature = Creature(\n619\t            name=\"Allowed Bear\",\n620\t            mana_cost=ManaCost.parse(\"{G}\"),\n621\t            base_power=1,\n622\t            base_toughness=1,\n623\t        )\n624\t        set_board_state(game, 0, hand=[creature])\n625\t        cast_spell(game, p1, creature)\n626\t        assert not game.stack.is_empty()\n627\t\n628\t    def test_restricted_mana_does_not_taint_an_unrestricted_pool(self) -> None:\n629\t        \"\"\"Regression anchor: with NO restricted mana present, a creature for\n630\t        {G} still casts — the restriction machinery never blocks ordinary mana.\n631\t        \"\"\"\n632\t        game = _restricted_mana_game()\n633\t        p1 = game.players[0]\n634\t        # Ordinary mana only.\n635\t        p1.mana_pool.add(ManaType.GREEN, 2)\n636\t        assert p1.mana_pool.has_restricted_mana() is False\n637\t        creature = Creature(\n638\t            name=\"Plain Bear\",\n639\t            mana_cost=ManaCost.parse(\"{1}{G}\"),\n640\t            base_power=2,\n641\t            base_toughness=2,\n642\t        )\n643\t        set_board_state(game, 0, hand=[creature])\n644\t        cast_spell(game, p1, creature)\n645\t        assert not game.stack.is_empty()\n646\t\n647\t\n648\tclass TestGreatHallAnimationEndState:\n649\t    \"\"\"{5} animation end state via engine.animation.animate_land.\n650\t\n651\t    Pays the real {5} cost out of the controller's pool, then asserts the exact\n652\t    end state: CREATURE added while LAND retained, Wizard subtype, a 2/4 body\n653\t    observable after the effect manager applies, and the \"if this land isn't a\n654\t    creature\" guard against re-animation.\n655\t    \"\"\"\n656\t\n657\t    def _animated_land(self, mana: int = 5) -> tuple[Any, Any]:\n658\t        game = create_game()\n659\t        game.active_player_index = 0\n660\t        p1 = game.players[0]\n661\t        land = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n662\t        set_board_state(game, 0, battlefield=[land], mana={ManaType.COLORLESS: mana})\n663\t        ab = land.get_activated_abilities()[0]\n664\t        assert ab.cost(game) is True\n665\t        ab.effect(game)\n666\t        game.effect_manager.apply_all(game)\n667\t        return game, land\n668\t\n669\t    def test_five_cost_is_paid_from_the_pool(self) -> None:\n670\t        \"\"\"Activating the {5} ability consumes exactly five generic mana.\"\"\"\n671\t        game = create_game()\n672\t        game.active_player_index = 0\n673\t        p1 = game.players[0]\n674\t        land = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n675\t        set_board_state(game, 0, battlefield=[land], mana={ManaType.COLORLESS: 6})\n676\t        ab = land.get_activated_abilities()[0]\n677\t        assert ab.cost(game) is True\n678\t        assert p1.mana_pool.total() == 1  # 6 - 5\n679\t\n680\t    def test_animated_gains_creature_but_keeps_land(self) -> None:\n681\t        \"\"\"It becomes a creature AND stays a land (\"It's still a land.\").\"\"\"\n682\t        _game, land = self._animated_land()\n683\t        assert CardType.CREATURE in land.card_types\n684\t        assert CardType.LAND in land.card_types\n685\t\n686\t    def test_animated_gains_wizard_subtype(self) -> None:\n687\t        _game, land = self._animated_land()\n688\t        assert \"Wizard\" in land.subtypes\n689\t\n690\t    def test_animated_body_is_two_four(self) -> None:\n691\t        \"\"\"The animated land reports power 2 / toughness 4 after apply_all.\"\"\"\n692\t        _game, land = self._animated_land()\n693\t        assert land.power == 2\n694\t        assert land.toughness == 4\n695\t\n696\t    def test_body_survives_recomputation(self) -> None:\n697\t        \"\"\"The durable layer effects keep the 2/4 body and creature type across\n698\t        repeated apply_all cycles (reset-and-reapply does not lose them).\"\"\"\n699\t        game, land = self._animated_land()\n700\t        for _ in range(3):\n701\t            game.effect_manager.apply_all(game)\n702\t        assert land.power == 2\n703\t        assert land.toughness == 4\n704\t        assert CardType.CREATURE in land.card_types\n705\t        assert CardType.LAND in land.card_types\n706\t\n707\t    def test_reanimation_is_a_noop_no_second_body_or_grant(self) -> None:\n708\t        \"\"\"\"If this land isn't a creature\" — a SECOND {5} (cost paid again) does\n709\t        NOT re-animate: no second pump-trigger grant, no extra layer effects,\n710\t        and the body stays 2/4 (not stacked).\"\"\"\n711\t        game, land = self._animated_land(mana=10)\n712\t        triggers_after_first = len(game.trigger_manager.get_triggers())\n713\t        effects_after_first = len(game.effect_manager.get_all())\n714\t        assert triggers_after_first == 1, \"first animation grants exactly one trigger\"\n715\t\n716\t        # Re-activate while already a creature.\n717\t        ab = land.get_activated_abilities()[0]\n718\t        assert ab.cost(game) is True  # the cost still runs (pays {5})\n719\t        ab.effect(game)  # ... but the effect must be a no-op (guard)\n720\t        game.effect_manager.apply_all(game)\n721\t\n722\t        assert len(game.trigger_manager.get_triggers()) == triggers_after_first\n723\t        assert len(game.effect_manager.get_all()) == effects_after_first\n724\t        assert land.power == 2\n725\t        assert land.toughness == 4\n726\t\n727\t\n728\tclass TestGreatHallGrantedPumpBehaviour:\n729\t    \"\"\"The granted \"Whenever you cast an instant or sorcery spell, this creature\n730\t    gets +1/+0 until end of turn\" trigger — engine.animation.\n731\t\n732\t    Fires SpellCastTriggeredEvent (the established cast-trigger test pattern,\n733\t    cf. sos_226), resolves the stacked trigger, and asserts the +1/+0 stacks per\n734\t    cast, resets at cleanup, and is gated to the controller's instant/sorcery\n735\t    casts.\n736\t    \"\"\"\n737\t\n738\t    def _animate(self) -> tuple[Any, Any, Any, Any]:\n739\t        game = create_game()\n740\t        game.active_player_index = 0\n741\t        p1 = game.players[0]\n742\t        p2 = game.players[1]\n743\t        land = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n744\t        set_board_state(game, 0, battlefield=[land], mana={ManaType.COLORLESS: 5})\n745\t        ab = land.get_activated_abilities()[0]\n746\t        ab.cost(game)\n747\t        ab.effect(game)\n748\t        game.effect_manager.apply_all(game)\n749\t        return game, p1, p2, land\n750\t\n751\t    def _cast_event(self, game: Any, land: Any, spell: Any, caster: Any) -> None:\n752\t        \"\"\"Fire a SpellCastTriggeredEvent and resolve any trigger it stacks,\n753\t        then recompute continuous effects.\"\"\"\n754\t        game.trigger_manager.fire_event(\n755\t            game,\n756\t            SpellCastTriggeredEvent(\n757\t                spell=spell, player=caster, controller=caster, card=spell\n758\t            ),\n759\t        )\n760\t        while not game.stack.is_empty():\n761\t            obj = game.stack.pop()\n762\t            obj.on_resolve(game)\n763\t        game.effect_manager.apply_all(game)\n764\t\n765\t    def test_animation_registers_exactly_one_pump_trigger(self) -> None:\n766\t        game, _p1, _p2, _land = self._animate()\n767\t        triggers = game.trigger_manager.get_triggers()\n768\t        assert len(triggers) == 1\n769\t        assert triggers[0].event_type is SpellCastTriggeredEvent\n770\t\n771\t    def test_one_instant_cast_pumps_plus_one_zero(self) -> None:\n772\t        \"\"\"One instant cast → +1/+0 (power 3, toughness unchanged at 4).\"\"\"\n773\t        game, p1, _p2, land = self._animate()\n774\t        spell = Instant(name=\"Pump Bolt\", mana_cost=ManaCost.parse(\"{U}\"))\n775\t        self._cast_event(game, land, spell, p1)\n776\t        assert land.power == 3\n777\t        assert land.toughness == 4\n778\t\n779\t    def test_sorcery_cast_also_pumps(self) -> None:\n780\t        \"\"\"A sorcery is an equally valid trigger — +1/+0 as well.\"\"\"\n781\t        game, p1, _p2, land = self._animate()\n782\t        spell = Sorcery(name=\"Pump Spell\", mana_cost=ManaCost.parse(\"{G}\"))\n783\t        self._cast_event(game, land, spell, p1)\n784\t        assert land.power == 3\n785\t        assert land.toughness == 4\n786\t\n787\t    def test_multiple_casts_stack_plus_n_zero(self) -> None:\n788\t        \"\"\"N instant/sorcery casts in a turn → power == 2 + N, toughness == 4.\"\"\"\n789\t        game, p1, _p2, land = self._animate()\n790\t        n = 3\n791\t        for i in range(n):\n792\t            spell = Instant(name=f\"Bolt {i}\", mana_cost=ManaCost.parse(\"{U}\"))\n793\t            self._cast_event(game, land, spell, p1)\n794\t        assert land.power == 2 + n\n795\t        assert land.toughness == 4\n796\t\n797\t    def test_pump_resets_at_end_of_turn(self) -> None:\n798\t        \"\"\"The +1/+0 is \"until end of turn\": remove_expired (run at cleanup)\n799\t        sweeps the DURATION_END_OF_TURN effects, so the body resets to 2/4.\"\"\"\n800\t        game, p1, _p2, land = self._animate()\n801\t        for i in range(2):\n802\t            spell = Instant(name=f\"Bolt {i}\", mana_cost=ManaCost.parse(\"{U}\"))\n803\t            self._cast_event(game, land, spell, p1)\n804\t        assert land.power == 4  # 2 + 2 pumps, mid-turn\n805\t\n806\t        # Cleanup: sweep end-of-turn effects, recompute.\n807\t        game.effect_manager.remove_expired(game)\n808\t        game.effect_manager.apply_all(game)\n809\t        assert land.power == 2\n810\t        assert land.toughness == 4\n811\t\n812\t    def test_animation_type_effect_survives_eot_sweep(self) -> None:\n813\t        \"\"\"The cleanup sweep removes the pump but NOT the (permanent) animation:\n814\t        the land is still a 2/4 creature-land after end-of-turn reset.\"\"\"\n815\t        game, p1, _p2, land = self._animate()\n816\t        spell = Instant(name=\"Bolt\", mana_cost=ManaCost.parse(\"{U}\"))\n817\t        self._cast_event(game, land, spell, p1)\n818\t        game.effect_manager.remove_expired(game)\n819\t        game.effect_manager.apply_all(game)\n820\t        assert land.power == 2\n821\t        assert CardType.CREATURE in land.card_types\n822\t        assert CardType.LAND in land.card_types\n823\t        assert \"Wizard\" in land.subtypes\n824\t\n825\t    def test_opponents_cast_does_not_pump(self) -> None:\n826\t        \"\"\"Gated to \"you\": an OPPONENT casting an instant must NOT pump the land\n827\t        (it stays 2/4).\"\"\"\n828\t        game, _p1, p2, land = self._animate()\n829\t        spell = Instant(name=\"Their Bolt\", mana_cost=ManaCost.parse(\"{U}\"))\n830\t        before_stack = len(game.stack)\n831\t        game.trigger_manager.fire_event(\n832\t            game,\n833\t            SpellCastTriggeredEvent(spell=spell, player=p2, controller=p2, card=spell),\n834\t        )\n835\t        # No trigger should have been pushed for the opponent's cast.\n836\t        assert len(game.stack) == before_stack\n837\t        game.effect_manager.apply_all(game)\n838\t        assert land.power == 2\n839\t        assert land.toughness == 4\n840\t\n841\t    def test_controllers_creature_cast_does_not_pump(self) -> None:\n842\t        \"\"\"Gated to instants/sorceries: the controller casting a CREATURE spell\n843\t        must NOT pump the land (creature is neither instant nor sorcery).\"\"\"\n844\t        game, p1, _p2, land = self._animate()\n845\t        creature_spell = Creature(\n846\t            name=\"Bear Spell\",\n847\t            mana_cost=ManaCost.parse(\"{G}\"),\n848\t            base_power=2,\n849\t            base_toughness=2,\n850\t        )\n851\t        before_stack = len(game.stack)\n852\t        game.trigger_manager.fire_event(\n853\t            game,\n854\t            SpellCastTriggeredEvent(\n855\t                spell=creature_spell, player=p1, controller=p1, card=creature_spell\n856\t            ),\n857\t        )\n858\t        assert len(game.stack) == before_stack\n859\t        game.effect_manager.apply_all(game)\n860\t        assert land.power == 2\n861\t        assert land.toughness == 4\n862\t"}]},"parent_tool_use_id":"toolu_019WKdPJ7AhbwAo5ff5Hkzdm","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"114f865e-fd3a-49ba-a7f1-6bfd32815121","timestamp":"2026-06-02T10:26:45.675Z","subagent_type":"Implementer","task_description":"Revise sos_257 restricted-mana fix"}
