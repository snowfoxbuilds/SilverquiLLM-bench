{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019ZDifVc7Df5rYH3xEqWfA9","type":"tool_result","content":"1\t\"\"\"Tests for extra turns infrastructure (FIFO queue in GameState).\n2\t\n3\tCovers:\n4\t- extra_turns attribute initialisation\n5\t- Granting an extra turn to the active player (consecutive turns)\n6\t- Normal turn order resumes after the extra turn is consumed\n7\t- Multiple extra turns queued in FIFO order\n8\t- Extra turns for different players interleave correctly\n9\t- Adding an extra turn *during* an extra turn\n10\t- Edge cases: empty queue, priority reset, turn number increments\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\timport pytest\n16\t\n17\tfrom engine.game_state import GameState\n18\tfrom engine.player import DeterministicPlayer\n19\tfrom engine.types import Phase, Step\n20\t\n21\t\n22\t# ---------------------------------------------------------------------------\n23\t# Helpers\n24\t# ---------------------------------------------------------------------------\n25\t\n26\t\n27\tdef _make_game() -> GameState:\n28\t    \"\"\"Create a minimal 2-player GameState for extra-turn tests.\"\"\"\n29\t    p0 = DeterministicPlayer(\"Alice\", [])\n30\t    p1 = DeterministicPlayer(\"Bob\", [])\n31\t    for p in (p0, p1):\n32\t        p.life = 20\n33\t    return GameState([p0, p1])\n34\t\n35\t\n36\tdef _end_turn(game: GameState) -> None:\n37\t    \"\"\"Fast-forward to CLEANUP and advance, simulating end-of-turn.\"\"\"\n38\t    game.phase = Phase.ENDING\n39\t    game.step = Step.CLEANUP\n40\t    game.advance_phase()\n41\t\n42\t\n43\t# ---------------------------------------------------------------------------\n44\t# Attribute initialisation\n45\t# ---------------------------------------------------------------------------\n46\t\n47\t\n48\tclass TestExtraTurnsAttribute:\n49\t    \"\"\"GameState.extra_turns should be an empty list by default.\"\"\"\n50\t\n51\t    def test_extra_turns_initialized_empty(self):\n52\t        game = _make_game()\n53\t        assert game.extra_turns == []\n54\t\n55\t    def test_extra_turns_is_mutable_list(self):\n56\t        game = _make_game()\n57\t        assert isinstance(game.extra_turns, list)\n58\t        # Should be appendable like a normal list\n59\t        game.extra_turns.append(0)\n60\t        assert len(game.extra_turns) == 1\n61\t\n62\t\n63\t# ---------------------------------------------------------------------------\n64\t# Single extra turn granted\n65\t# ---------------------------------------------------------------------------\n66\t\n67\t\n68\tclass TestExtraTurnGranted:\n69\t    \"\"\"Appending a player seat to extra_turns gives them the next turn.\"\"\"\n70\t\n71\t    def test_active_player_gets_consecutive_turn(self):\n72\t        \"\"\"Player 0 queues an extra turn; they should take turn 2.\"\"\"\n73\t        game = _make_game()\n74\t        assert game.active_player_index == 0\n75\t        game.extra_turns.append(0)\n76\t\n77\t        _end_turn(game)\n78\t\n79\t        assert game.active_player_index == 0\n80\t        assert game.turn_number == 2\n81\t        assert game.extra_turns == []\n82\t\n83\t    def test_opponent_gets_extra_turn(self):\n84\t        \"\"\"An effect grants player 1 an extra turn during player 0's turn.\"\"\"\n85\t        game = _make_game()\n86\t        game.extra_turns.append(1)\n87\t\n88\t        _end_turn(game)\n89\t\n90\t        assert game.active_player_index == 1\n91\t        assert game.turn_number == 2\n92\t        assert game.extra_turns == []\n93\t\n94\t    def test_turn_number_increments_on_extra_turn(self):\n95\t        \"\"\"Extra turns still increment the turn counter.\"\"\"\n96\t        game = _make_game()\n97\t        game.extra_turns.append(0)\n98\t\n99\t        _end_turn(game)\n100\t        assert game.turn_number == 2\n101\t\n102\t        _end_turn(game)\n103\t        assert game.turn_number == 3\n104\t\n105\t\n106\t# ---------------------------------------------------------------------------\n107\t# Normal turn order resumes after extra turn\n108\t# ---------------------------------------------------------------------------\n109\t\n110\t\n111\tclass TestNormalOrderResumes:\n112\t    \"\"\"After extra turns are exhausted, the normal alternation resumes.\"\"\"\n113\t\n114\t    def test_resumes_to_opponent_after_self_extra_turn(self):\n115\t        game = _make_game()\n116\t        game.extra_turns.append(0)\n117\t\n118\t        _end_turn(game)  # turn 2: extra for P0\n119\t        assert game.active_player_index == 0\n120\t\n121\t        _end_turn(game)  # turn 3: normal -> P1\n122\t        assert game.active_player_index == 1\n123\t\n124\t    def test_resumes_after_opponent_extra_turn(self):\n125\t        \"\"\"After P1 takes an inserted extra turn, normal rotation resumes\n126\t        from where it left off — P0 was the last *normal* active player,\n127\t        so the next normal turn belongs to P1 (P0 → P1(extra) → P1(normal)).\"\"\"\n128\t        game = _make_game()\n129\t        game.extra_turns.append(1)\n130\t\n131\t        _end_turn(game)  # turn 2: extra for P1\n132\t        assert game.active_player_index == 1\n133\t\n134\t        _end_turn(game)  # turn 3: normal rotation from P0 → P1\n135\t        assert game.active_player_index == 1\n136\t\n137\t    def test_empty_queue_normal_alternation(self):\n138\t        \"\"\"With no extra turns queued, turns alternate normally.\"\"\"\n139\t        game = _make_game()\n140\t\n141\t        _end_turn(game)\n142\t        assert game.active_player_index == 1\n143\t\n144\t        _end_turn(game)\n145\t        assert game.active_player_index == 0\n146\t\n147\t\n148\t# ---------------------------------------------------------------------------\n149\t# Multiple extra turns — FIFO ordering\n150\t# ---------------------------------------------------------------------------\n151\t\n152\t\n153\tclass TestMultipleExtraTurnsFIFO:\n154\t    \"\"\"Multiple extra turns must be processed first-in, first-out.\"\"\"\n155\t\n156\t    def test_two_extra_turns_same_player(self):\n157\t        game = _make_game()\n158\t        game.extra_turns.extend([0, 0])\n159\t\n160\t        _end_turn(game)\n161\t        assert game.active_player_index == 0\n162\t        assert len(game.extra_turns) == 1\n163\t\n164\t        _end_turn(game)\n165\t        assert game.active_player_index == 0\n166\t        assert game.extra_turns == []\n167\t\n168\t        _end_turn(game)  # normal: -> P1\n169\t        assert game.active_player_index == 1\n170\t\n171\t    def test_fifo_different_players(self):\n172\t        \"\"\"Queue [P0, P1] — P0's extra first, then P1's extra.\"\"\"\n173\t        game = _make_game()\n174\t        game.extra_turns.extend([0, 1])\n175\t\n176\t        _end_turn(game)\n177\t        assert game.active_player_index == 0\n178\t\n179\t        _end_turn(game)\n180\t        assert game.active_player_index == 1\n181\t\n182\t    def test_three_extras_interleaved(self):\n183\t        \"\"\"Queue [P0, P1, P0] — should pop in that exact order.\"\"\"\n184\t        game = _make_game()\n185\t        game.extra_turns.extend([0, 1, 0])\n186\t\n187\t        results = []\n188\t        for _ in range(3):\n189\t            _end_turn(game)\n190\t            results.append(game.active_player_index)\n191\t\n192\t        assert results == [0, 1, 0]\n193\t        assert game.extra_turns == []\n194\t\n195\t    def test_normal_order_resumes_after_all_extras_consumed(self):\n196\t        \"\"\"After [P0, P1] extras, normal alternation resumes from the last\n197\t        *normal* turn (P0), so next normal turn is P1.\"\"\"\n198\t        game = _make_game()\n199\t        game.extra_turns.extend([0, 1])\n200\t\n201\t        _end_turn(game)  # extra P0\n202\t        _end_turn(game)  # extra P1\n203\t\n204\t        _end_turn(game)  # normal: P0 was last normal → P1\n205\t        assert game.active_player_index == 1\n206\t\n207\t\n208\t# ---------------------------------------------------------------------------\n209\t# Extra turn during an extra turn\n210\t# ---------------------------------------------------------------------------\n211\t\n212\t\n213\tclass TestExtraTurnDuringExtraTurn:\n214\t    \"\"\"Queueing an extra turn while taking an extra turn should work.\"\"\"\n215\t\n216\t    def test_queue_extra_during_extra(self):\n217\t        \"\"\"P0 gets an extra turn, then during that extra turn queues another.\"\"\"\n218\t        game = _make_game()\n219\t        game.extra_turns.append(0)\n220\t\n221\t        _end_turn(game)  # extra turn for P0\n222\t        assert game.active_player_index == 0\n223\t\n224\t        # During the extra turn, another extra turn is granted\n225\t        game.extra_turns.append(0)\n226\t\n227\t        _end_turn(game)  # second extra for P0\n228\t        assert game.active_player_index == 0\n229\t\n230\t        _end_turn(game)  # normal -> P1\n231\t        assert game.active_player_index == 1\n232\t\n233\t    def test_queue_opponent_extra_during_own_extra(self):\n234\t        \"\"\"P0 takes extra turn, queues extra for P1 during it.\n235\t        Normal rotation still tracks P0 as last normal, so after\n236\t        extras: P0(extra) → P1(extra) → P1(normal).\"\"\"\n237\t        game = _make_game()\n238\t        game.extra_turns.append(0)\n239\t\n240\t        _end_turn(game)\n241\t        assert game.active_player_index == 0\n242\t\n243\t        game.extra_turns.append(1)\n244\t\n245\t        _end_turn(game)\n246\t        assert game.active_player_index == 1\n247\t\n248\t        _end_turn(game)  # normal: P0 was last normal → P1\n249\t        assert game.active_player_index == 1\n250\t\n251\t\n252\t# ---------------------------------------------------------------------------\n253\t# Priority and phase reset on extra turn\n254\t# ---------------------------------------------------------------------------\n255\t\n256\t\n257\tclass TestPriorityAndPhaseReset:\n258\t    \"\"\"On a new turn (including extra), priority and phase should reset.\"\"\"\n259\t\n260\t    def test_priority_set_to_active_player_on_extra_turn(self):\n261\t        game = _make_game()\n262\t        game.extra_turns.append(0)\n263\t        game.priority_player_index = 1  # opponent had priority\n264\t\n265\t        _end_turn(game)\n266\t\n267\t        assert game.priority_player_index == 0\n268\t\n269\t    def test_phase_resets_to_beginning_on_extra_turn(self):\n270\t        game = _make_game()\n271\t        game.extra_turns.append(0)\n272\t\n273\t        _end_turn(game)\n274\t\n275\t        assert game.phase == Phase.BEGINNING\n276\t        assert game.step == Step.UNTAP\n277\t"}]},"parent_tool_use_id":"toolu_0175Pw6mRGSzRALRLtAaYqyV","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"d81c9054-023c-4f2b-a849-fee2b143a4a3","timestamp":"2026-06-02T08:39:43.581Z","subagent_type":"Implementer","task_description":"Implement sos_97"}
