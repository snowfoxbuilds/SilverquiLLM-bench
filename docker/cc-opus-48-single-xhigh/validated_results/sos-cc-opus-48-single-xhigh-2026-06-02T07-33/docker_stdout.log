{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BSKDN8RNxJAdWAecN2rTdP","type":"tool_result","content":"1\t\"\"\"Tests for SOS 13 — Emeritus of Truce // Swords to Plowshares.\n2\t\n3\tOracle text (from card_spec.json), front (creature) face:\n4\t\n5\t    When this creature enters, target player creates a 1/1 white and black\n6\t    Inkling creature token with flying. Then if an opponent controls more\n7\t    creatures than you, this creature becomes prepared. (While it's prepared,\n8\t    you may cast a copy of its spell. Doing so unprepares it.)\n9\t\n10\tStatic data:\n11\t\n12\t    Emeritus of Truce // Swords to Plowshares\n13\t    {1}{W}{W} // {W}\n14\t    Creature — Cat Cleric // Instant\n15\t    3/3, white, mythic, keyword \"Prepared\".\n16\t\n17\tBehaviour contract derived from the spec\n18\t----------------------------------------\n19\t\n20\t* Front face is a white Creature — Cat Cleric, 3/3, mana cost {1}{W}{W}.\n21\t* Enters-the-battlefield trigger: a target player (chosen by the\n22\t  controller — may be the controller themselves or an opponent) creates a\n23\t  1/1 white-and-black Inkling creature token with flying.  The token enters\n24\t  under the *targeted* player's control.\n25\t* Conditional \"becomes prepared\": after the token is created, the creature\n26\t  becomes prepared **only if** an opponent controls strictly more creatures\n27\t  than the controller.  Otherwise it does not become prepared.\n28\t* The card is a Preparation card (rule 722): it has a back/prepare \"spell\"\n29\t  half — Swords to Plowshares, an Instant costing {W}.\n30\t\n31\tThese tests are written for the TDD red phase: they FAIL against the empty\n32\tstub and PASS once the card is implemented correctly.\n33\t\"\"\"\n34\t\n35\tfrom __future__ import annotations\n36\t\n37\tfrom typing import Any\n38\t\n39\timport pytest\n40\t\n41\tfrom cards.sos.sos_13.card_impl import (\n42\t    EmeritusOfTruceSwordsToPlowshares,\n43\t    SwordsToPlowshares,\n44\t)\n45\tfrom engine import preparation\n46\tfrom engine.card import Creature\n47\tfrom engine.events import EntersBattlefieldTriggeredEvent\n48\tfrom engine.protection import get_colors\n49\tfrom engine.triggers import TriggerRegistration\n50\tfrom engine.types import CardType, Color, Keyword, ManaCost, Zone\n51\tfrom test_utils import create_game, set_board_state\n52\t\n53\t\n54\t# ---------------------------------------------------------------------------\n55\t# Helpers\n56\t# ---------------------------------------------------------------------------\n57\t\n58\t\n59\tdef _vanilla_creature(name: str = \"Grizzly Bears\") -> Creature:\n60\t    \"\"\"A plain 2/2 creature for filling out board states.\"\"\"\n61\t    return Creature(\n62\t        name=name,\n63\t        mana_cost=ManaCost.parse(\"{1}{G}\"),\n64\t        base_power=2,\n65\t        base_toughness=2,\n66\t    )\n67\t\n68\t\n69\tdef _resolve_full_stack(game: Any) -> None:\n70\t    \"\"\"Resolve every object currently on the stack, top-down.\n71\t\n72\t    Mirrors ``test_utils._resolve_top_of_stack`` but local so it can be reused\n73\t    after manually firing the ETB trigger (whose resolution applies the token\n74\t    / prepared effect).\n75\t    \"\"\"\n76\t    from engine.state_based_actions import resolve_state_based_actions\n77\t\n78\t    while not game.stack.is_empty():\n79\t        obj = game.stack.pop()\n80\t        obj.on_resolve(game)\n81\t        resolve_state_based_actions(game)\n82\t\n83\t\n84\tdef _inkling_tokens(game: Any, player: Any) -> list[Creature]:\n85\t    \"\"\"Return all Inkling-like token creatures on *player*'s battlefield.\n86\t\n87\t    Detection is intentionally tolerant of the exact representation: any\n88\t    battlefield creature flagged ``is_token`` whose name or subtypes mention\n89\t    \"Inkling\" counts.\n90\t    \"\"\"\n91\t    result: list[Creature] = []\n92\t    for obj in game.get_battlefield(player).get_all():\n93\t        if not isinstance(obj, Creature):\n94\t            continue\n95\t        if not getattr(obj, \"is_token\", False):\n96\t            continue\n97\t        name = getattr(obj, \"name\", \"\") or \"\"\n98\t        subtypes = getattr(obj, \"subtypes\", set()) or set()\n99\t        if \"Inkling\" in name or \"Inkling\" in subtypes:\n100\t            result.append(obj)\n101\t    return result\n102\t\n103\t\n104\tdef _all_tokens(game: Any, player: Any) -> list[Creature]:\n105\t    \"\"\"Return every token creature on *player*'s battlefield.\"\"\"\n106\t    return [\n107\t        obj\n108\t        for obj in game.get_battlefield(player).get_all()\n109\t        if isinstance(obj, Creature) and getattr(obj, \"is_token\", False)\n110\t    ]\n111\t\n112\t\n113\tdef _is_prepared(card: Any) -> bool:\n114\t    \"\"\"Best-effort read of the 'prepared' designation on *card*.\n115\t\n116\t    The mechanic is new; the implementation may expose it as ``is_prepared``,\n117\t    ``prepared``, or a ``Keyword.PREPARED``-style flag.  We probe the common\n118\t    representations so the behavioural tests aren't coupled to one spelling.\n119\t    \"\"\"\n120\t    for attr in (\"is_prepared\", \"prepared\"):\n121\t        val = getattr(card, attr, None)\n122\t        if isinstance(val, bool):\n123\t            return val\n124\t    return False\n125\t\n126\t\n127\tdef _make_etb_card(game: Any, controller_index: int) -> EmeritusOfTruceSwordsToPlowshares:\n128\t    \"\"\"Place the creature on *controller_index*'s battlefield and wire triggers.\n129\t\n130\t    Returns the card with ``register_triggers`` already called.  The ETB event\n131\t    is *not* fired here — tests fire it explicitly so they can control the\n132\t    target choice first (the engine fires ETB before registration, so the\n133\t    self-ETB trigger is exercised by an explicit ``fire_event``).\n134\t    \"\"\"\n135\t    p = game.players[controller_index]\n136\t    card = EmeritusOfTruceSwordsToPlowshares(owner=p, controller=p)\n137\t    set_board_state(game, controller_index, battlefield=[card])\n138\t    game.active_player_index = controller_index\n139\t    card.register_triggers(game)\n140\t    return card\n141\t\n142\t\n143\tdef _fire_etb(game: Any, card: Any, target_player: Any) -> None:\n144\t    \"\"\"Fire the creature's ETB event after pointing it at *target_player*.\n145\t\n146\t    Sets ``chosen_targets`` (the resolve-time idiom used by FDN ETB cards) and\n147\t    also seeds the controller's script with the target so an implementation\n148\t    that asks at resolution time is satisfied either way.\n149\t    \"\"\"\n150\t    card.chosen_targets = [target_player]\n151\t    controller = card.controller\n152\t    if controller is not None and hasattr(controller, \"_script\"):\n153\t        controller._script.extend([target_player, target_player])\n154\t    game.trigger_manager.fire_event(\n155\t        game, EntersBattlefieldTriggeredEvent(permanent=card, controller=controller)\n156\t    )\n157\t    _resolve_full_stack(game)\n158\t\n159\t\n160\t# ---------------------------------------------------------------------------\n161\t# Static card data — front (creature) face\n162\t# ---------------------------------------------------------------------------\n163\t\n164\t\n165\tclass TestEmeritusProperties:\n166\t    \"\"\"Front-face characteristics must match the SOS 13 spec.\"\"\"\n167\t\n168\t    def test_is_creature(self) -> None:\n169\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n170\t        assert isinstance(card, Creature)\n171\t        assert CardType.CREATURE in card.card_types\n172\t\n173\t    def test_name_includes_emeritus_of_truce(self) -> None:\n174\t        # The front-face name; the implementation may expose either the\n175\t        # creature-half name or the combined split name.\n176\t        name = EmeritusOfTruceSwordsToPlowshares(owner=None).name\n177\t        assert \"Emeritus of Truce\" in name\n178\t\n179\t    def test_front_face_mana_cost(self) -> None:\n180\t        # The castable (creature) half costs {1}{W}{W}.\n181\t        cost = EmeritusOfTruceSwordsToPlowshares(owner=None).mana_cost\n182\t        assert cost == ManaCost.parse(\"{1}{W}{W}\")\n183\t\n184\t    def test_power_toughness(self) -> None:\n185\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n186\t        assert card.base_power == 3\n187\t        assert card.base_toughness == 3\n188\t\n189\t    def test_is_white(self) -> None:\n190\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n191\t        assert get_colors(card) == {Color.WHITE}\n192\t\n193\t    def test_subtypes_cat_cleric(self) -> None:\n194\t        subtypes = EmeritusOfTruceSwordsToPlowshares(owner=None).subtypes\n195\t        assert \"Cat\" in subtypes\n196\t        assert \"Cleric\" in subtypes\n197\t\n198\t\n199\t# ---------------------------------------------------------------------------\n200\t# ETB trigger registration\n201\t# ---------------------------------------------------------------------------\n202\t\n203\t\n204\tclass TestEmeritusEtbTriggerRegistration:\n205\t    \"\"\"register_triggers wires a self-referencing ETB trigger.\"\"\"\n206\t\n207\t    def test_registers_one_trigger(self) -> None:\n208\t        game = create_game()\n209\t        p1 = game.players[0]\n210\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n211\t        before = len(game.trigger_manager.get_triggers())\n212\t        card.register_triggers(game)\n213\t        after = len(game.trigger_manager.get_triggers())\n214\t        assert after - before == 1\n215\t\n216\t    def test_trigger_watches_enters_battlefield_event(self) -> None:\n217\t        game = create_game()\n218\t        p1 = game.players[0]\n219\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n220\t        card.register_triggers(game)\n221\t        regs = game.trigger_manager.get_triggers_for_source(card)\n222\t        assert len(regs) == 1\n223\t        reg = regs[0]\n224\t        assert isinstance(reg, TriggerRegistration)\n225\t        assert reg.event_type is EntersBattlefieldTriggeredEvent\n226\t\n227\t    def test_trigger_only_fires_for_this_card(self) -> None:\n228\t        \"\"\"A different permanent entering must not fire this card's ETB.\"\"\"\n229\t        game = create_game()\n230\t        p1 = game.players[0]\n231\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n232\t        set_board_state(game, 0, battlefield=[card])\n233\t        game.active_player_index = 0\n234\t        card.register_triggers(game)\n235\t\n236\t        other = _vanilla_creature(\"Some Other Bear\")\n237\t        other.owner = p1\n238\t        other.controller = p1\n239\t        game.trigger_manager.fire_event(\n240\t            game, EntersBattlefieldTriggeredEvent(permanent=other, controller=p1)\n241\t        )\n242\t        assert game.stack.is_empty()\n243\t\n244\t    def test_trigger_fires_when_this_card_enters(self) -> None:\n245\t        game = create_game()\n246\t        p1 = game.players[0]\n247\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n248\t        set_board_state(game, 0, battlefield=[card])\n249\t        game.active_player_index = 0\n250\t        card.register_triggers(game)\n251\t\n252\t        game.trigger_manager.fire_event(\n253\t            game, EntersBattlefieldTriggeredEvent(permanent=card, controller=p1)\n254\t        )\n255\t        assert not game.stack.is_empty()\n256\t        assert game.stack.peek().source is card\n257\t\n258\t\n259\t# ---------------------------------------------------------------------------\n260\t# ETB token creation\n261\t# ---------------------------------------------------------------------------\n262\t\n263\t\n264\tclass TestEmeritusTokenCreation:\n265\t    \"\"\"target player creates a 1/1 white & black Inkling token with flying.\"\"\"\n266\t\n267\t    def test_controller_target_gets_one_inkling(self) -> None:\n268\t        game = create_game()\n269\t        card = _make_etb_card(game, 0)\n270\t        p1 = game.players[0]\n271\t        before = len(_all_tokens(game, p1))\n272\t        _fire_etb(game, card, p1)\n273\t        inklings = _inkling_tokens(game, p1)\n274\t        assert len(inklings) == 1\n275\t        # Exactly one token was created for the chosen player.\n276\t        assert len(_all_tokens(game, p1)) == before + 1\n277\t\n278\t    def test_token_is_one_one(self) -> None:\n279\t        game = create_game()\n280\t        card = _make_etb_card(game, 0)\n281\t        p1 = game.players[0]\n282\t        _fire_etb(game, card, p1)\n283\t        token = _inkling_tokens(game, p1)[0]\n284\t        assert token.base_power == 1\n285\t        assert token.base_toughness == 1\n286\t\n287\t    def test_token_has_flying(self) -> None:\n288\t        game = create_game()\n289\t        card = _make_etb_card(game, 0)\n290\t        p1 = game.players[0]\n291\t        _fire_etb(game, card, p1)\n292\t        token = _inkling_tokens(game, p1)[0]\n293\t        assert Keyword.FLYING & token.keywords\n294\t\n295\t    def test_token_is_white_and_black(self) -> None:\n296\t        game = create_game()\n297\t        card = _make_etb_card(game, 0)\n298\t        p1 = game.players[0]\n299\t        _fire_etb(game, card, p1)\n300\t        token = _inkling_tokens(game, p1)[0]\n301\t        assert get_colors(token) == {Color.WHITE, Color.BLACK}\n302\t\n303\t    def test_targeting_opponent_creates_token_under_opponent(self) -> None:\n304\t        \"\"\"\"target player\" may be an opponent; the token enters under that\n305\t        targeted player's control, not the controller's.\"\"\"\n306\t        game = create_game()\n307\t        card = _make_etb_card(game, 0)\n308\t        p1 = game.players[0]\n309\t        p2 = game.players[1]\n310\t        _fire_etb(game, card, p2)\n311\t        # The opponent receives the Inkling.\n312\t        assert len(_inkling_tokens(game, p2)) == 1\n313\t        # The controller does not get a token in this case.\n314\t        assert len(_inkling_tokens(game, p1)) == 0\n315\t        token = _inkling_tokens(game, p2)[0]\n316\t        assert token.controller is p2\n317\t\n318\t    def test_token_is_a_creature_token(self) -> None:\n319\t        game = create_game()\n320\t        card = _make_etb_card(game, 0)\n321\t        p1 = game.players[0]\n322\t        _fire_etb(game, card, p1)\n323\t        token = _inkling_tokens(game, p1)[0]\n324\t        assert CardType.CREATURE in token.card_types\n325\t        assert token.is_token is True\n326\t\n327\t\n328\t# ---------------------------------------------------------------------------\n329\t# Conditional \"becomes prepared\"\n330\t# ---------------------------------------------------------------------------\n331\t\n332\t\n333\tclass TestEmeritusBecomesPrepared:\n334\t    \"\"\"\"Then if an opponent controls more creatures than you, this creature\n335\t    becomes prepared.\"\n336\t\n337\t    Each board state below is chosen so the prepared outcome is the same\n338\t    whether the implementation evaluates the creature counts *before* or\n339\t    *after* the Inkling token is created — by directing the token to the\n340\t    player whose count is irrelevant to crossing the threshold.\n341\t    \"\"\"\n342\t\n343\t    @staticmethod\n344\t    def _rewire(game: Any, card: Any) -> None:\n345\t        \"\"\"Re-register the self-ETB trigger after set_board_state wipes it.\"\"\"\n346\t        game.trigger_manager.unregister(card)\n347\t        card.register_triggers(game)\n348\t\n349\t    def test_becomes_prepared_when_opponent_has_more_creatures(self) -> None:\n350\t        game = create_game()\n351\t        card = _make_etb_card(game, 0)\n352\t        p1 = game.players[0]\n353\t        p2 = game.players[1]\n354\t        # Controller controls only Emeritus (1); opponent controls 3.\n355\t        set_board_state(game, 0, battlefield=[card])\n356\t        set_board_state(\n357\t            game,\n358\t            1,\n359\t            battlefield=[\n360\t                _vanilla_creature(\"Foe A\"),\n361\t                _vanilla_creature(\"Foe B\"),\n362\t                _vanilla_creature(\"Foe C\"),\n363\t            ],\n364\t        )\n365\t        self._rewire(game, card)\n366\t        # Send the token to the opponent so the controller's count stays 1.\n367\t        # opponent 3-or-4 > you 1 either way -> prepared.\n368\t        _fire_etb(game, card, p2)\n369\t        assert len(_inkling_tokens(game, p2)) == 1\n370\t        assert _is_prepared(card) is True\n371\t\n372\t    def test_not_prepared_when_counts_equal(self) -> None:\n373\t        \"\"\"Opponent must control *strictly more* creatures — an equal count\n374\t        does not prepare the creature.\"\"\"\n375\t        game = create_game()\n376\t        card = _make_etb_card(game, 0)\n377\t        p1 = game.players[0]\n378\t        # Controller has Emeritus + one ally (2); opponent has two foes (2).\n379\t        set_board_state(game, 0, battlefield=[card, _vanilla_creature(\"Ally\")])\n380\t        set_board_state(\n381\t            game,\n382\t            1,\n383\t            battlefield=[_vanilla_creature(\"Foe A\"), _vanilla_creature(\"Foe B\")],\n384\t        )\n385\t        self._rewire(game, card)\n386\t        # Token goes to the controller -> you 3, opponent 2 (and pre-token the\n387\t        # counts were equal 2==2). Opponent never has strictly more -> no prep.\n388\t        _fire_etb(game, card, p1)\n389\t        # Anchor to real ETB execution: the token must have been created, so a\n390\t        # passing assertion means the not-prepared branch was actually reached\n391\t        # (not that the mechanic is simply unimplemented).\n392\t        assert len(_inkling_tokens(game, p1)) == 1\n393\t        assert _is_prepared(card) is False\n394\t\n395\t    def test_not_prepared_when_controller_has_more_creatures(self) -> None:\n396\t        game = create_game()\n397\t        card = _make_etb_card(game, 0)\n398\t        p1 = game.players[0]\n399\t        p2 = game.players[1]\n400\t        # Controller has Emeritus + two allies (3); opponent has nothing.\n401\t        set_board_state(\n402\t            game,\n403\t            0,\n404\t            battlefield=[card, _vanilla_creature(\"Ally A\"), _vanilla_creature(\"Ally B\")],\n405\t        )\n406\t        set_board_state(game, 1, battlefield=[])\n407\t        self._rewire(game, card)\n408\t        # Token goes to the opponent -> opponent at most 1 vs your 3 -> no prep.\n409\t        _fire_etb(game, card, p2)\n410\t        assert len(_inkling_tokens(game, p2)) == 1\n411\t        assert _is_prepared(card) is False\n412\t\n413\t    def test_not_prepared_when_opponent_has_no_creatures(self) -> None:\n414\t        game = create_game()\n415\t        card = _make_etb_card(game, 0)\n416\t        p1 = game.players[0]\n417\t        # Opponent controls nothing; controller controls Emeritus. Token to you.\n418\t        _fire_etb(game, card, p1)\n419\t        assert len(_inkling_tokens(game, p1)) == 1\n420\t        assert _is_prepared(card) is False\n421\t\n422\t\n423\t# ---------------------------------------------------------------------------\n424\t# Preparation-card / back (\"Swords to Plowshares\") half\n425\t# ---------------------------------------------------------------------------\n426\t\n427\t\n428\tclass TestSwordsToPlowsharesHalf:\n429\t    \"\"\"The card is a Preparation card with a back/prepare spell half.\"\"\"\n430\t\n431\t    def test_prepare_spell_mana_cost_is_w(self) -> None:\n432\t        \"\"\"The prepare (\"Swords to Plowshares\") half costs {W}.\n433\t\n434\t        The implementation exposes the prepare spell's cost somewhere — try\n435\t        the common shapes (a dedicated attribute or a copy/factory) before\n436\t        giving up.\n437\t        \"\"\"\n438\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n439\t        expected = ManaCost.parse(\"{W}\")\n440\t        candidates: list[Any] = []\n441\t        for attr in (\n442\t            \"prepare_mana_cost\",\n443\t            \"back_mana_cost\",\n444\t            \"swords_mana_cost\",\n445\t        ):\n446\t            val = getattr(card, attr, None)\n447\t            if isinstance(val, ManaCost):\n448\t                candidates.append(val)\n449\t        for attr in (\"prepare_spell\", \"back_face\", \"back_spell\", \"swords_to_plowshares\"):\n450\t            half = getattr(card, attr, None)\n451\t            if half is not None:\n452\t                cost = getattr(half, \"mana_cost\", None)\n453\t                if isinstance(cost, ManaCost):\n454\t                    candidates.append(cost)\n455\t            if callable(half):\n456\t                try:\n457\t                    produced = half()\n458\t                except TypeError:\n459\t                    produced = None\n460\t                cost = getattr(produced, \"mana_cost\", None)\n461\t                if isinstance(cost, ManaCost):\n462\t                    candidates.append(cost)\n463\t        assert candidates, \"no prepare-spell cost surface found on the card\"\n464\t        assert any(c == expected for c in candidates)\n465\t\n466\t\n467\t# ---------------------------------------------------------------------------\n468\t# Extended coverage — engine Preparation framework (engine/preparation.py)\n469\t#\n470\t# The Implementer built the additive Preparation-card framework, so the three\n471\t# items previously deferred in untestable.json are now observable:\n472\t#   (1) copy-of-the-prepare-spell-in-exile creation on becoming prepared,\n473\t#   (2) cast-from-exile + unprepare-on-cast transition,\n474\t#   (3) the Swords to Plowshares back-face effect.\n475\t# ---------------------------------------------------------------------------\n476\t\n477\t\n478\tdef _prepared_card_on_battlefield(\n479\t    game: Any, controller_index: int = 0\n480\t) -> EmeritusOfTruceSwordsToPlowshares:\n481\t    \"\"\"Put an Emeritus on *controller_index*'s battlefield, owned/controlled by\n482\t    that player, so ``mark_prepared`` has a real controller to exile to.\"\"\"\n483\t    p = game.players[controller_index]\n484\t    card = EmeritusOfTruceSwordsToPlowshares(owner=p, controller=p)\n485\t    set_board_state(game, controller_index, battlefield=[card])\n486\t    card.owner = p\n487\t    card.controller = p\n488\t    return card\n489\t\n490\t\n491\tclass TestPreparationCopyInExile:\n492\t    \"\"\"(1) On becoming prepared, the controller creates a {W} Swords to\n493\t    Plowshares instant copy in their exile, keyed to the prepared permanent.\"\"\"\n494\t\n495\t    def test_mark_prepared_sets_designation(self) -> None:\n496\t        game = create_game()\n497\t        card = _prepared_card_on_battlefield(game, 0)\n498\t        assert preparation.is_prepared(card) is False\n499\t        preparation.mark_prepared(game, card)\n500\t        assert preparation.is_prepared(card) is True\n501\t\n502\t    def test_mark_prepared_returns_exiled_copy(self) -> None:\n503\t        game = create_game()\n504\t        card = _prepared_card_on_battlefield(game, 0)\n505\t        p1 = game.players[0]\n506\t        copy = preparation.mark_prepared(game, card)\n507\t        assert copy is not None\n508\t        # The returned copy is the one sitting in the controller's exile.\n509\t        assert game.get_exile(p1).contains(copy)\n510\t\n511\t    def test_exiled_copy_is_swords_to_plowshares_instant(self) -> None:\n512\t        game = create_game()\n513\t        card = _prepared_card_on_battlefield(game, 0)\n514\t        copy = preparation.mark_prepared(game, card)\n515\t        assert isinstance(copy, SwordsToPlowshares)\n516\t        assert CardType.INSTANT in copy.card_types\n517\t\n518\t    def test_exiled_copy_costs_w(self) -> None:\n519\t        game = create_game()\n520\t        card = _prepared_card_on_battlefield(game, 0)\n521\t        copy = preparation.mark_prepared(game, card)\n522\t        assert copy.mana_cost == ManaCost.parse(\"{W}\")\n523\t\n524\t    def test_copy_keyed_to_prepared_permanent(self) -> None:\n525\t        game = create_game()\n526\t        card = _prepared_card_on_battlefield(game, 0)\n527\t        copy = preparation.mark_prepared(game, card)\n528\t        # The registry round-trips the permanent -> copy mapping.\n529\t        assert preparation.get_prepared_copy(game, card) is copy\n530\t        # And the per-game registry is keyed by the prepared permanent's id.\n531\t        assert game._prepared_copies[id(card)] is copy\n532\t\n533\t    def test_copy_controlled_by_prepared_controller(self) -> None:\n534\t        \"\"\"The copy is owned and controlled by the prepared permanent's\n535\t        controller (so it lands in *that* player's exile).\"\"\"\n536\t        game = create_game()\n537\t        card = _prepared_card_on_battlefield(game, 0)\n538\t        p1 = game.players[0]\n539\t        p2 = game.players[1]\n540\t        copy = preparation.mark_prepared(game, card)\n541\t        assert copy.controller is p1\n542\t        assert copy.owner is p1\n543\t        # The opponent's exile does not receive a copy.\n544\t        assert not game.get_exile(p2).contains(copy)\n545\t\n546\t    def test_etb_prepared_branch_creates_exile_copy(self) -> None:\n547\t        \"\"\"Going through the real ETB (opponent has strictly more creatures)\n548\t        also produces the exile copy — not just a direct mark_prepared call.\"\"\"\n549\t        game = create_game()\n550\t        card = _make_etb_card(game, 0)\n551\t        p1 = game.players[0]\n552\t        p2 = game.players[1]\n553\t        set_board_state(game, 0, battlefield=[card])\n554\t        set_board_state(\n555\t            game,\n556\t            1,\n557\t            battlefield=[\n558\t                _vanilla_creature(\"Foe A\"),\n559\t                _vanilla_creature(\"Foe B\"),\n560\t                _vanilla_creature(\"Foe C\"),\n561\t            ],\n562\t        )\n563\t        game.trigger_manager.unregister(card)\n564\t        card.register_triggers(game)\n565\t        _fire_etb(game, card, p2)\n566\t        assert preparation.is_prepared(card) is True\n567\t        copy = preparation.get_prepared_copy(game, card)\n568\t        assert copy is not None\n569\t        assert isinstance(copy, SwordsToPlowshares)\n570\t        assert game.get_exile(p1).contains(copy)\n571\t\n572\t\n573\tclass TestPreparationIdempotencyAndUnprepare:\n574\t    \"\"\"(4) Edge cases: mark_prepared idempotency, and unprepare removes the\n575\t    exiled copy and clears the designation.\"\"\"\n576\t\n577\t    def test_mark_prepared_is_idempotent(self) -> None:\n578\t        game = create_game()\n579\t        card = _prepared_card_on_battlefield(game, 0)\n580\t        p1 = game.players[0]\n581\t        first = preparation.mark_prepared(game, card)\n582\t        # A second mark must not create a duplicate (CR 722.3a) — same copy back.\n583\t        second = preparation.mark_prepared(game, card)\n584\t        assert second is first\n585\t        exile_copies = [\n586\t            obj\n587\t            for obj in game.get_exile(p1).get_all()\n588\t            if isinstance(obj, SwordsToPlowshares)\n589\t        ]\n590\t        assert len(exile_copies) == 1\n591\t\n592\t    def test_unprepare_clears_designation(self) -> None:\n593\t        game = create_game()\n594\t        card = _prepared_card_on_battlefield(game, 0)\n595\t        preparation.mark_prepared(game, card)\n596\t        assert preparation.is_prepared(card) is True\n597\t        preparation.unprepare(game, card)\n598\t        assert preparation.is_prepared(card) is False\n599\t\n600\t    def test_unprepare_removes_exile_copy(self) -> None:\n601\t        game = create_game()\n602\t        card = _prepared_card_on_battlefield(game, 0)\n603\t        p1 = game.players[0]\n604\t        copy = preparation.mark_prepared(game, card)\n605\t        assert game.get_exile(p1).contains(copy)\n606\t        preparation.unprepare(game, card)\n607\t        # The copy only persists while prepared (CR 722.3c).\n608\t        assert not game.get_exile(p1).contains(copy)\n609\t        assert preparation.get_prepared_copy(game, card) is None\n610\t\n611\t\n612\tclass TestPreparationCastFromExile:\n613\t    \"\"\"(2) The controller casts the exiled copy; doing so unprepares the source\n614\t    and moves the copy out of exile onto the stack.\"\"\"\n615\t\n616\t    def test_cast_from_exile_unprepares_source(self) -> None:\n617\t        # Give the controller a creature to target so cast_prepared_copy's\n618\t        # target choice succeeds.\n619\t        victim = _vanilla_creature(\"Victim\")\n620\t        game = create_game(scripts=([victim], []))\n621\t        card = _prepared_card_on_battlefield(game, 0)\n622\t        p1 = game.players[0]\n623\t        # Put the target creature on the battlefield (under the controller).\n624\t        set_board_state(game, 0, battlefield=[card, victim])\n625\t        card.owner = p1\n626\t        card.controller = p1\n627\t        copy = preparation.mark_prepared(game, card)\n628\t        assert preparation.is_prepared(card) is True\n629\t\n630\t        preparation.cast_prepared_copy(game, p1, copy)\n631\t        # Casting the copy clears the prepared designation (CR 722.3c).\n632\t        assert preparation.is_prepared(card) is False\n633\t\n634\t    def test_cast_from_exile_moves_copy_off_exile(self) -> None:\n635\t        victim = _vanilla_creature(\"Victim\")\n636\t        game = create_game(scripts=([victim], []))\n637\t        card = _prepared_card_on_battlefield(game, 0)\n638\t        p1 = game.players[0]\n639\t        set_board_state(game, 0, battlefield=[card, victim])\n640\t        card.owner = p1\n641\t        card.controller = p1\n642\t        copy = preparation.mark_prepared(game, card)\n643\t        assert game.get_exile(p1).contains(copy)\n644\t\n645\t        preparation.cast_prepared_copy(game, p1, copy)\n646\t        # The copy left exile (it is now on the stack).\n647\t        assert not game.get_exile(p1).contains(copy)\n648\t        assert not game.stack.is_empty()\n649\t        assert game.stack.peek().source is copy\n650\t\n651\t    def test_cast_from_exile_clears_registry_entry(self) -> None:\n652\t        victim = _vanilla_creature(\"Victim\")\n653\t        game = create_game(scripts=([victim], []))\n654\t        card = _prepared_card_on_battlefield(game, 0)\n655\t        p1 = game.players[0]\n656\t        set_board_state(game, 0, battlefield=[card, victim])\n657\t        card.owner = p1\n658\t        card.controller = p1\n659\t        copy = preparation.mark_prepared(game, card)\n660\t\n661\t        preparation.cast_prepared_copy(game, p1, copy)\n662\t        # The source is no longer tracked as having a prepared copy.\n663\t        assert preparation.get_prepared_copy(game, card) is None\n664\t\n665\t\n666\tclass TestSwordsToPlowsharesEffect:\n667\t    \"\"\"(3) Resolving the prepare spell exiles the target creature and gives its\n668\t    controller life equal to the creature's power.\"\"\"\n669\t\n670\t    def test_resolved_swords_exiles_target_creature(self) -> None:\n671\t        victim = _vanilla_creature(\"Victim\")  # 2/2\n672\t        game = create_game(scripts=([victim], []))\n673\t        card = _prepared_card_on_battlefield(game, 0)\n674\t        p1 = game.players[0]\n675\t        set_board_state(game, 0, battlefield=[card, victim])\n676\t        card.owner = p1\n677\t        card.controller = p1\n678\t        copy = preparation.mark_prepared(game, card)\n679\t\n680\t        preparation.cast_prepared_copy(game, p1, copy)\n681\t        _resolve_full_stack(game)\n682\t\n683\t        # The creature is off the battlefield and in its owner's exile.\n684\t        assert not game.get_battlefield(p1).contains(victim)\n685\t        assert game.get_exile(p1).contains(victim)\n686\t\n687\t    def test_resolved_swords_controller_gains_life_equal_to_power(self) -> None:\n688\t        victim = _vanilla_creature(\"Victim\")  # base power 2\n689\t        game = create_game(scripts=([victim], []))\n690\t        card = _prepared_card_on_battlefield(game, 0)\n691\t        p1 = game.players[0]\n692\t        set_board_state(game, 0, battlefield=[card, victim], life=20)\n693\t        card.owner = p1\n694\t        card.controller = p1\n695\t        copy = preparation.mark_prepared(game, card)\n696\t        life_before = p1.life\n697\t\n698\t        preparation.cast_prepared_copy(game, p1, copy)\n699\t        _resolve_full_stack(game)\n700\t\n701\t        # Its controller (p1, who controls the 2-power Victim) gains 2 life.\n702\t        assert p1.life == life_before + 2\n703\t\n704\t    def test_swords_life_goes_to_targets_controller_not_caster(self) -> None:\n705\t        \"\"\"\"Its controller gains life\" — the life goes to the target creature's\n706\t        controller, which may be an opponent, not the spell's caster.\"\"\"\n707\t        foe_creature = _vanilla_creature(\"Foe Bear\")  # power 2, controlled by p2\n708\t        game = create_game(scripts=([foe_creature], []))\n709\t        card = _prepared_card_on_battlefield(game, 0)\n710\t        p1 = game.players[0]\n711\t        p2 = game.players[1]\n712\t        set_board_state(game, 0, battlefield=[card], life=20)\n713\t        set_board_state(game, 1, battlefield=[foe_creature], life=20)\n714\t        foe_creature.owner = p2\n715\t        foe_creature.controller = p2\n716\t        copy = preparation.mark_prepared(game, card)\n717\t        p1_life_before = p1.life\n718\t        p2_life_before = p2.life\n719\t\n720\t        # p1 casts the copy targeting the opponent's creature.\n721\t        preparation.cast_prepared_copy(game, p1, copy)\n722\t        _resolve_full_stack(game)\n723\t\n724\t        # The creature is exiled to its owner's (p2) exile.\n725\t        assert not game.get_battlefield(p2).contains(foe_creature)\n726\t        assert game.get_exile(p2).contains(foe_creature)\n727\t        # Its controller (p2) gains the life, not the caster (p1).\n728\t        assert p2.life == p2_life_before + 2\n729\t        assert p1.life == p1_life_before\n730\t\n731\t\n732\tif __name__ == \"__main__\":  # pragma: no cover\n733\t    raise SystemExit(pytest.main([__file__, \"-v\"]))\n734\t"}]},"parent_tool_use_id":"toolu_014qMHqUqBYKEbXQ4J36hKc5","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"e73573cf-5d45-4482-9bbd-68c3312c8acf","timestamp":"2026-06-02T08:12:20.670Z","subagent_type":"Reviewer","task_description":"Review sos_13 implementation"}
