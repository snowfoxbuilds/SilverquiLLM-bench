{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01JeC8oHzfPR8oDxBg6z6kGU","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01TLZEq7B7R1QjQKKz5Nid19","name":"Read","input":{"file_path":"/workspace/engine/triggers.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9527,"cache_read_input_tokens":33132,"cache_creation":{"ephemeral_5m_input_tokens":9527,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01KzbV64VrxFyeMJaYKxaCDa","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"fdb98030-ca9f-4ccd-b05c-2f554180f953","request_id":"req_011Cbe9gpc6h5Nhc4yNC4REi","subagent_type":"Implementer","task_description":"Implement sos_120"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BDFDWhQoSkWnpBaNNrmYCa","type":"tool_result","content":"1\t\"\"\"Card base classes, CardImpl interface, and supporting dataclasses.\n2\t\n3\tProvides the core class hierarchy for all Magic: The Gathering card types:\n4\t\n5\t- ``GameObject`` — base for anything that can exist in zones.\n6\t- ``CardImpl(GameObject)`` — abstract card implementation with hooks for\n7\t  casting, resolution, targeting, triggers, and abilities.\n8\t- Concrete subclasses: ``Creature``, ``Instant``, ``Sorcery``,\n9\t  ``Enchantment``, ``Aura``, ``Artifact``, ``ArtifactCreature``,\n10\t  ``Planeswalker``, ``Land``.\n11\t- Supporting dataclasses: ``ActivatedAbility``, ``LoyaltyAbility``,\n12\t  ``ManaAbility``, ``ContinuousEffect``, ``Mode``.\n13\t\"\"\"\n14\t\n15\tfrom __future__ import annotations\n16\t\n17\tfrom dataclasses import dataclass\n18\tfrom typing import TYPE_CHECKING, Any, Callable\n19\t\n20\tfrom engine.types import CardType, Keyword, ManaCost, Supertype\n21\t\n22\tif TYPE_CHECKING:\n23\t    from engine.game_state import GameState\n24\t    from engine.player import Player\n25\t\n26\t\n27\t# ---------------------------------------------------------------------------\n28\t# Supporting dataclasses\n29\t# ---------------------------------------------------------------------------\n30\t\n31\t@dataclass\n32\tclass Mode:\n33\t    \"\"\"Represents a single mode of a modal spell or ability.\n34\t\n35\t    Attributes:\n36\t        name: Short label for this mode (e.g. ``\"Destroy target creature\"``).\n37\t        description: Detailed rules text for the mode.\n38\t    \"\"\"\n39\t\n40\t    name: str = \"\"\n41\t    description: str = \"\"\n42\t\n43\t\n44\t@dataclass\n45\tclass ActivatedAbility:\n46\t    \"\"\"An activated ability on a permanent.\n47\t\n48\t    Attributes:\n49\t        cost: A callable that checks/pays the cost given the game state.\n50\t        effect: A callable that applies the effect given the game state.\n51\t        description: Human-readable description of the ability.\n52\t    \"\"\"\n53\t\n54\t    cost: Callable[..., Any]\n55\t    effect: Callable[..., Any]\n56\t    description: str = \"\"\n57\t\n58\t\n59\t@dataclass\n60\tclass LoyaltyAbility:\n61\t    \"\"\"A planeswalker loyalty ability.\n62\t\n63\t    Attributes:\n64\t        loyalty_cost: The loyalty cost (positive for ``+``, negative for ``−``).\n65\t        effect: A callable that applies the ability's effect.\n66\t        description: Human-readable description.\n67\t    \"\"\"\n68\t\n69\t    loyalty_cost: int\n70\t    effect: Callable[..., Any]\n71\t    description: str = \"\"\n72\t\n73\t\n74\t@dataclass\n75\tclass ManaAbility:\n76\t    \"\"\"A mana ability (does not use the stack).\n77\t\n78\t    Attributes:\n79\t        cost: A callable that checks/pays the cost.\n80\t        mana_produced: A callable that returns the mana added.\n81\t        description: Human-readable description.\n82\t    \"\"\"\n83\t\n84\t    cost: Callable[..., Any]\n85\t    mana_produced: Callable[..., Any]\n86\t    description: str = \"\"\n87\t\n88\t\n89\t@dataclass\n90\tclass ContinuousEffect:\n91\t    \"\"\"A continuous effect applied by an enchantment or other source.\n92\t\n93\t    Attributes:\n94\t        apply: A callable that applies the effect to the game state.\n95\t        remove: A callable that removes the effect from the game state.\n96\t        description: Human-readable description.\n97\t    \"\"\"\n98\t\n99\t    apply: Callable[..., Any]\n100\t    remove: Callable[..., Any]\n101\t    description: str = \"\"\n102\t\n103\t\n104\t# ---------------------------------------------------------------------------\n105\t# GameObject — base class for zone-resident objects\n106\t# ---------------------------------------------------------------------------\n107\t\n108\tclass GameObject:\n109\t    \"\"\"Base class for anything that can exist in a zone.\n110\t\n111\t    Each instance receives a unique ``object_id`` via a class-level\n112\t    auto-incrementing counter.\n113\t\n114\t    Attributes:\n115\t        object_id: Unique integer identifier (auto-assigned).\n116\t        owner: The player who owns this object.\n117\t        controller: The player who currently controls this object.\n118\t    \"\"\"\n119\t\n120\t    _next_id: int = 1\n121\t\n122\t    def __init__(self, owner: Player | None = None, controller: Player | None = None) -> None:\n123\t        self.object_id: int = GameObject._next_id\n124\t        GameObject._next_id += 1\n125\t        self.owner: Player | None = owner\n126\t        self.controller: Player | None = controller if controller is not None else owner\n127\t\n128\t    @classmethod\n129\t    def reset_id_counter(cls) -> None:\n130\t        \"\"\"Reset the auto-incrementing counter (useful in tests).\"\"\"\n131\t        cls._next_id = 1\n132\t\n133\t\n134\t# ---------------------------------------------------------------------------\n135\t# CardImpl — abstract card implementation\n136\t# ---------------------------------------------------------------------------\n137\t\n138\tclass CardImpl(GameObject):\n139\t    \"\"\"Abstract base for all card implementations.\n140\t\n141\t    Subclasses should override the ``can_cast``, ``on_cast``, ``on_resolve``,\n142\t    and other hook methods to implement card-specific behaviour.\n143\t\n144\t    Attributes:\n145\t        name: Card name.\n146\t        mana_cost: The card's mana cost.\n147\t        card_types: Set of :class:`~engine.types.CardType` values.\n148\t        subtypes: Set of subtype strings (e.g. ``{\"Elf\", \"Warrior\"}``).\n149\t        supertypes: Set of :class:`~engine.types.Supertype` values.\n150\t        keywords: Combination of :class:`~engine.types.Keyword` flags.\n151\t        rules_text: The card's rules text string.\n152\t    \"\"\"\n153\t\n154\t    def __init__(\n155\t        self,\n156\t        name: str = \"\",\n157\t        mana_cost: ManaCost | None = None,\n158\t        card_types: set[CardType] | None = None,\n159\t        subtypes: set[str] | None = None,\n160\t        supertypes: set[Supertype] | None = None,\n161\t        keywords: Keyword | None = None,\n162\t        rules_text: str = \"\",\n163\t        owner: Player | None = None,\n164\t        controller: Player | None = None,\n165\t    ) -> None:\n166\t        super().__init__(owner=owner, controller=controller)\n167\t        self.name: str = name\n168\t        self.mana_cost: ManaCost = mana_cost if mana_cost is not None else ManaCost()\n169\t        self.card_types: set[CardType] = card_types if card_types is not None else set()\n170\t        self.subtypes: set[str] = subtypes if subtypes is not None else set()\n171\t        self.supertypes: set[Supertype] = supertypes if supertypes is not None else set()\n172\t        self.keywords: Keyword = keywords if keywords is not None else Keyword(0)\n173\t        self.rules_text: str = rules_text\n174\t        # Snapshot original characteristics for continuous-effect reset.\n175\t        self._original_card_types: frozenset[CardType] = frozenset(self.card_types)\n176\t        self._original_keywords: Keyword = self.keywords\n177\t\n178\t    # ------------------------------------------------------------------\n179\t    # Continuous-effect reset support\n180\t    # ------------------------------------------------------------------\n181\t\n182\t    def _reset_characteristics(self) -> None:\n183\t        \"\"\"Reset mutable characteristics to their original (pre-effect) values.\n184\t\n185\t        Called by :meth:`EffectManager.apply_all` before reapplying effects\n186\t        so that the recalculation is idempotent.\n187\t        \"\"\"\n188\t        self.card_types = set(self._original_card_types)\n189\t        self.keywords = self._original_keywords\n190\t\n191\t    # ------------------------------------------------------------------\n192\t    # Hook methods — override in subclasses / card definitions\n193\t    # ------------------------------------------------------------------\n194\t\n195\t    def can_cast(self, game: GameState) -> bool:\n196\t        \"\"\"Return ``True`` if this card can currently be cast.\"\"\"\n197\t        return True\n198\t\n199\t    def cost_reduction(self, game: GameState) -> int:\n200\t        \"\"\"Return the generic mana reduction for casting this card.\n201\t\n202\t        Override in subclasses to implement cost-reduction mechanics\n203\t        (e.g. Embercleave costs {1} less for each attacking creature).\n204\t        The returned value is clamped so that generic mana cannot go below 0.\n205\t        Only reduces generic mana — colored costs are never reduced.\n206\t\n207\t        Returns:\n208\t            Non-negative integer representing generic mana to subtract.\n209\t        \"\"\"\n210\t        return 0\n211\t\n212\t    def on_cast(self, game: GameState) -> None:\n213\t        \"\"\"Called when the card is cast (before it goes on the stack).\"\"\"\n214\t\n215\t    def on_resolve(self, game: GameState) -> None:\n216\t        \"\"\"Called when the spell resolves from the stack.\n217\t\n218\t        Targets are available via ``self.chosen_targets`` — set at\n219\t        resolve-time by :func:`~engine.casting._resolve_spell` from\n220\t        :attr:`StackObject.targets`, or directly by test code.\n221\t        \"\"\"\n222\t\n223\t    def get_targets(self, game: GameState) -> list[Any]:\n224\t        \"\"\"Return a list of legal targets for this card.\"\"\"\n225\t        return []\n226\t\n227\t    def register_triggers(self, game: GameState) -> None:\n228\t        \"\"\"Register any triggered abilities this card provides.\"\"\"\n229\t\n230\t    def register_replacement_effects(self, game: GameState) -> None:\n231\t        \"\"\"Register any replacement effects this card provides.\"\"\"\n232\t\n233\t    def get_activated_abilities(self) -> list[ActivatedAbility]:\n234\t        \"\"\"Return activated abilities this card provides.\"\"\"\n235\t        return []\n236\t\n237\t    def get_modes(self) -> list[Mode]:\n238\t        \"\"\"Return available modes for modal spells/abilities.\n239\t\n240\t        Non-modal cards return an empty list by default.\n241\t        \"\"\"\n242\t        return []\n243\t\n244\t\n245\t# ---------------------------------------------------------------------------\n246\t# Creature\n247\t# ---------------------------------------------------------------------------\n248\t\n249\tclass Creature(CardImpl):\n250\t    \"\"\"A creature card.\n251\t\n252\t    Attributes:\n253\t        base_power: The printed power value (rule 208.1). Immutable after init.\n254\t        base_toughness: The printed toughness value. Immutable after init.\n255\t        modified_power: Current power after continuous effects (Layer 7c), before counters.\n256\t            Reset to ``base_power`` each effect cycle; continuous effects write here.\n257\t        modified_toughness: Current toughness after continuous effects, before counters.\n258\t        damage_marked: Amount of damage currently marked on this creature.\n259\t        is_tapped: Whether the creature is tapped.\n260\t        summoning_sick: Whether the creature has summoning sickness.\n261\t        is_attacking: Combat flag — currently declared as an attacker.\n262\t        is_blocking: Combat flag — currently declared as a blocker.\n263\t        plus_one_counters: Number of +1/+1 counters.\n264\t        minus_one_counters: Number of -1/-1 counters.\n265\t        is_token: Whether this object is a token (for SBA checks).\n266\t    \"\"\"\n267\t\n268\t    def __init__(\n269\t        self,\n270\t        name: str = \"\",\n271\t        mana_cost: ManaCost | None = None,\n272\t        card_types: set[CardType] | None = None,\n273\t        subtypes: set[str] | None = None,\n274\t        supertypes: set[Supertype] | None = None,\n275\t        keywords: Keyword | None = None,\n276\t        rules_text: str = \"\",\n277\t        owner: Player | None = None,\n278\t        controller: Player | None = None,\n279\t        base_power: int = 0,\n280\t        base_toughness: int = 0,\n281\t    ) -> None:\n282\t        # Always include CREATURE in card_types.\n283\t        card_types = (card_types or set()) | {CardType.CREATURE}\n284\t        super().__init__(\n285\t            name=name,\n286\t            mana_cost=mana_cost,\n287\t            card_types=card_types,\n288\t            subtypes=subtypes,\n289\t            supertypes=supertypes,\n290\t            keywords=keywords,\n291\t            rules_text=rules_text,\n292\t            owner=owner,\n293\t            controller=controller,\n294\t        )\n295\t        self.base_power: int = base_power\n296\t        self.base_toughness: int = base_toughness\n297\t        self.modified_power: int = base_power\n298\t        self.modified_toughness: int = base_toughness\n299\t        self.damage_marked: int = 0\n300\t        self.is_tapped: bool = False\n301\t        self.summoning_sick: bool = True\n302\t        self.is_attacking: bool = False\n303\t        self.is_blocking: bool = False\n304\t        self.plus_one_counters: int = 0\n305\t        self.minus_one_counters: int = 0\n306\t        self.is_token: bool = False\n307\t        self.dealt_deathtouch_damage: bool = False\n308\t        self._base_plus_one_counters: int = 0\n309\t        self._base_minus_one_counters: int = 0\n310\t\n311\t    def _reset_characteristics(self) -> None:\n312\t        \"\"\"Reset creature characteristics to pre-effect values.\"\"\"\n313\t        super()._reset_characteristics()\n314\t        self.modified_power = self.base_power\n315\t        self.modified_toughness = self.base_toughness\n316\t        self.plus_one_counters = self._base_plus_one_counters\n317\t        self.minus_one_counters = self._base_minus_one_counters\n318\t        # Reset combat-restriction flags set by continuous effects (e.g. Pacifism).\n319\t        # These are reapplied by active effects during apply_all().\n320\t        self._cant_attack: bool = False\n321\t        self._cant_block: bool = False\n322\t        self._cant_be_blocked: bool = False\n323\t        self._cant_activate: bool = False\n324\t        self._max_attackers_blocked: int = 1\n325\t        # Clear granted protections so they are reapplied by active effects.\n326\t        if hasattr(self, \"protections\"):\n327\t            self.protections = []\n328\t\n329\t    @property\n330\t    def counters(self) -> dict[str, int]:\n331\t        \"\"\"Return a dict-like view of counters on this creature.\"\"\"\n332\t        result: dict[str, int] = {}\n333\t        if self.plus_one_counters > 0:\n334\t            result[\"+1/+1\"] = self.plus_one_counters\n335\t        if self.minus_one_counters > 0:\n336\t            result[\"-1/-1\"] = self.minus_one_counters\n337\t        return result\n338\t\n339\t    @property\n340\t    def power(self) -> int:\n341\t        \"\"\"Current power including counter modifications.\"\"\"\n342\t        return self.modified_power + self.plus_one_counters - self.minus_one_counters\n343\t\n344\t    @property\n345\t    def toughness(self) -> int:\n346\t        \"\"\"Current toughness including counter modifications.\"\"\"\n347\t        return self.modified_toughness + self.plus_one_counters - self.minus_one_counters\n348\t\n349\t\n350\t# ---------------------------------------------------------------------------\n351\t# Instant / Sorcery\n352\t# ---------------------------------------------------------------------------\n353\t\n354\tclass Instant(CardImpl):\n355\t    \"\"\"An instant spell — no extra fields beyond CardImpl.\"\"\"\n356\t\n357\t    def __init__(self, **kwargs: Any) -> None:\n358\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.INSTANT}\n359\t        super().__init__(**kwargs)\n360\t\n361\t\n362\tclass Sorcery(CardImpl):\n363\t    \"\"\"A sorcery spell — no extra fields beyond CardImpl.\"\"\"\n364\t\n365\t    def __init__(self, **kwargs: Any) -> None:\n366\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.SORCERY}\n367\t        super().__init__(**kwargs)\n368\t\n369\t\n370\t# ---------------------------------------------------------------------------\n371\t# Enchantment\n372\t# ---------------------------------------------------------------------------\n373\t\n374\tclass Enchantment(CardImpl):\n375\t    \"\"\"An enchantment card.\n376\t\n377\t    For auras, use the :class:`Aura` subclass which sets ``is_aura = True``.\n378\t    The base ``Enchantment`` class retains the ``attached_to`` attribute for\n379\t    backwards compatibility but marks ``is_aura = False`` so that state-based\n380\t    actions do not treat a non-aura enchantment as an unattached aura.\n381\t\n382\t    Attributes:\n383\t        attached_to: The object this enchantment is attached to (``None``\n384\t            if not an aura or not yet attached).\n385\t        is_aura: ``False`` for regular enchantments; ``True`` for auras.\n386\t    \"\"\"\n387\t\n388\t    is_aura: bool = False\n389\t\n390\t    def __init__(self, attached_to: Any | None = None, **kwargs: Any) -> None:\n391\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ENCHANTMENT}\n392\t        super().__init__(**kwargs)\n393\t        self.attached_to: Any | None = attached_to\n394\t\n395\t    def apply_continuous_effect(self, game: GameState) -> None:\n396\t        \"\"\"Apply the enchantment's continuous effect to the game.\"\"\"\n397\t\n398\t    def on_enchant(self, game: GameState) -> None:\n399\t        \"\"\"Called when this enchantment becomes attached to an object.\"\"\"\n400\t\n401\t    def on_detach(self, game: GameState) -> None:\n402\t        \"\"\"Called when this enchantment is detached from its object.\"\"\"\n403\t\n404\t\n405\tclass Aura(Enchantment):\n406\t    \"\"\"An Aura enchantment — attaches to a permanent on the battlefield.\n407\t\n408\t    Sets ``is_aura = True`` so that state-based actions correctly identify\n409\t    this as an aura (and move it to the graveyard when unattached).\n410\t\n411\t    Attributes:\n412\t        is_aura: Always ``True`` for auras.\n413\t    \"\"\"\n414\t\n415\t    is_aura: bool = True\n416\t\n417\t    def __init__(self, attached_to: Any | None = None, **kwargs: Any) -> None:\n418\t        super().__init__(attached_to=attached_to, **kwargs)\n419\t\n420\t\n421\t# ---------------------------------------------------------------------------\n422\t# Artifact / ArtifactCreature\n423\t# ---------------------------------------------------------------------------\n424\t\n425\tclass Artifact(CardImpl):\n426\t    \"\"\"An artifact card.\n427\t\n428\t    Attributes:\n429\t        is_tapped: Whether the artifact is currently tapped.\n430\t    \"\"\"\n431\t\n432\t    def __init__(self, **kwargs: Any) -> None:\n433\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ARTIFACT}\n434\t        super().__init__(**kwargs)\n435\t        self.is_tapped: bool = False\n436\t\n437\t\n438\tclass ArtifactCreature(Creature):\n439\t    \"\"\"An artifact creature — combines Artifact and Creature types.\n440\t\n441\t    Inherits creature combat stats and behaviour from :class:`Creature`.\n442\t    \"\"\"\n443\t\n444\t    def __init__(self, **kwargs: Any) -> None:\n445\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ARTIFACT, CardType.CREATURE}\n446\t        super().__init__(**kwargs)\n447\t\n448\t\n449\t# ---------------------------------------------------------------------------\n450\t# Planeswalker\n451\t# ---------------------------------------------------------------------------\n452\t\n453\tclass Planeswalker(CardImpl):\n454\t    \"\"\"A planeswalker card.\n455\t\n456\t    Attributes:\n457\t        starting_loyalty: The starting loyalty printed on the card.\n458\t        loyalty: Current loyalty counter value.\n459\t    \"\"\"\n460\t\n461\t    def __init__(\n462\t        self,\n463\t        starting_loyalty: int = 0,\n464\t        **kwargs: Any,\n465\t    ) -> None:\n466\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.PLANESWALKER}\n467\t        super().__init__(**kwargs)\n468\t        self.starting_loyalty: int = starting_loyalty\n469\t        self.loyalty: int = starting_loyalty\n470\t\n471\t    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n472\t        \"\"\"Return the planeswalker's loyalty abilities.\"\"\"\n473\t        return []\n474\t\n475\t\n476\t# ---------------------------------------------------------------------------\n477\t# Land\n478\t# ---------------------------------------------------------------------------\n479\t\n480\tclass Land(CardImpl):\n481\t    \"\"\"A land card.\n482\t\n483\t    Lands are not cast — they are played via a special action. ``can_cast``\n484\t    always returns ``False``.\n485\t\n486\t    Attributes:\n487\t        is_tapped: Whether the land is currently tapped.\n488\t    \"\"\"\n489\t\n490\t    def __init__(self, **kwargs: Any) -> None:\n491\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.LAND}\n492\t        super().__init__(**kwargs)\n493\t        self.is_tapped: bool = False\n494\t\n495\t    def can_cast(self, game: GameState) -> bool:\n496\t        \"\"\"Lands cannot be cast; they are played as a special action.\"\"\"\n497\t        return False\n498\t\n499\t    def get_mana_abilities(self) -> list[ManaAbility]:\n500\t        \"\"\"Return the land's mana abilities.\"\"\"\n501\t        return []\n502\t"}]},"parent_tool_use_id":"toolu_01KzbV64VrxFyeMJaYKxaCDa","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"6741a3cb-aade-4ecc-b3f3-a0f87d5f65a6","timestamp":"2026-06-02T08:53:30.921Z","subagent_type":"Implementer","task_description":"Implement sos_120"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TLZEq7B7R1QjQKKz5Nid19","type":"tool_result","content":"1\t\"\"\"Triggered abilities system — event-driven trigger registration and firing.\n2\t\n3\tProvides the core mechanism for registering triggered abilities and firing\n4\tevents that push matching triggers onto the stack:\n5\t\n6\t- :class:`TriggerRegistration` — dataclass describing a single trigger.\n7\t- :class:`TriggerManager` — central registry for triggers with APNAP-ordered\n8\t  event firing.\n9\t\n10\tEvent types live in :mod:`engine.events` as typed dataclasses.\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\tfrom dataclasses import dataclass, field\n16\tfrom typing import TYPE_CHECKING, Any, Callable\n17\t\n18\tfrom engine.events import TriggeredEvent\n19\tfrom engine.stack import StackObject\n20\t\n21\tif TYPE_CHECKING:\n22\t    from engine.game_state import GameState\n23\t    from engine.player import Player\n24\t\n25\t\n26\t@dataclass\n27\tclass TriggerRegistration:\n28\t    \"\"\"Describes a single triggered ability.\n29\t\n30\t    Attributes:\n31\t        event_type: The event class (or a base class) this trigger watches.\n32\t            The trigger fires for any fired event that is an instance of\n33\t            this class, including instances of subclasses.\n34\t        condition: Optional callable ``(game, event) -> bool`` that must\n35\t            return ``True`` for the trigger to fire.  ``None`` means the\n36\t            trigger always fires for its event type.\n37\t        effect: Callable ``(game) -> None`` executed when the trigger\n38\t            resolves (becomes the :attr:`StackObject.on_resolve` callback).\n39\t        source: The game object (card / permanent) that owns this trigger.\n40\t        controller: The player who controls the source at the time of\n41\t            registration.\n42\t        one_shot: When ``True`` this is a delayed trigger that fires\n43\t            exactly once.  It is removed from the manager the first time\n44\t            its event fires and its condition passes (see\n45\t            :meth:`TriggerManager.fire_event`), so it will not fire again\n46\t            on subsequent matching events.\n47\t    \"\"\"\n48\t\n49\t    event_type: type[TriggeredEvent]\n50\t    condition: Callable[..., bool] | None\n51\t    effect: Callable[..., None]\n52\t    source: Any\n53\t    controller: Player\n54\t    one_shot: bool = False\n55\t\n56\t\n57\tclass TriggerManager:\n58\t    \"\"\"Central registry for triggered abilities.\n59\t\n60\t    Triggers are registered when a permanent enters the battlefield (or\n61\t    via other game actions) and unregistered when the source leaves.\n62\t\n63\t    :meth:`fire_event` checks all registered triggers of a matching\n64\t    event type, evaluates their conditions, and pushes matching triggers\n65\t    onto the game stack as :class:`StackObject` instances.  Triggers are\n66\t    ordered according to APNAP (Active Player, Non-Active Player):\n67\t\n68\t    * Active player's triggers are pushed first (end up on the bottom\n69\t      of the batch).\n70\t    * Non-active player's triggers are pushed second (end up on top).\n71\t    * Within the same player, triggers are pushed in registration order\n72\t      (controller would normally choose; for now we use registration\n73\t      order as a deterministic default).\n74\t    \"\"\"\n75\t\n76\t    def __init__(self) -> None:\n77\t        self._triggers: list[TriggerRegistration] = []\n78\t\n79\t    def register(self, trigger: TriggerRegistration) -> None:\n80\t        \"\"\"Register a triggered ability.\"\"\"\n81\t        self._triggers.append(trigger)\n82\t\n83\t    def register_delayed(\n84\t        self,\n85\t        event_type: type[TriggeredEvent],\n86\t        effect: Callable[..., None],\n87\t        source: Any,\n88\t        controller: Player,\n89\t        condition: Callable[..., bool] | None = None,\n90\t    ) -> TriggerRegistration:\n91\t        \"\"\"Register a one-shot *delayed* triggered ability.\n92\t\n93\t        A delayed trigger fires exactly once: the first time *event_type*\n94\t        (or a subclass) is fired and *condition* (if any) passes, *effect*\n95\t        is placed on the stack and the trigger is removed from the manager\n96\t        so it will not fire again.\n97\t\n98\t        This is the engine hook used by effects like \"at the beginning of\n99\t        your next main phase, ...\" — register a delayed trigger watching\n100\t        :class:`~engine.events.BeginningOfMainPhaseTriggeredEvent` whose\n101\t        *condition* checks that the firing player is the controller.\n102\t\n103\t        Returns the created :class:`TriggerRegistration` (already\n104\t        registered) so callers can inspect / unregister it.\n105\t        \"\"\"\n106\t        trigger = TriggerRegistration(\n107\t            event_type=event_type,\n108\t            condition=condition,\n109\t            effect=effect,\n110\t            source=source,\n111\t            controller=controller,\n112\t            one_shot=True,\n113\t        )\n114\t        self._triggers.append(trigger)\n115\t        return trigger\n116\t\n117\t    def unregister(self, source: Any) -> None:\n118\t        \"\"\"Remove all triggers registered by *source* (identity-based).\"\"\"\n119\t        self._triggers = [t for t in self._triggers if t.source is not source]\n120\t\n121\t    def fire_event(self, game: GameState, event: TriggeredEvent) -> None:\n122\t        \"\"\"Fire an event and push all matching triggers onto the stack.\n123\t\n124\t        Parameters:\n125\t            game: The current game state.\n126\t            event: The typed event object.  Triggers registered for the\n127\t                event's class or any of its parent classes will fire.\n128\t\n129\t        Matching triggers are pushed in APNAP order:\n130\t\n131\t        1. Active player's matching triggers (in registration order).\n132\t        2. Non-active player's matching triggers (in registration order).\n133\t        \"\"\"\n134\t        matching: list[TriggerRegistration] = []\n135\t        for trigger in self._triggers:\n136\t            if not isinstance(event, trigger.event_type):\n137\t                continue\n138\t            if trigger.condition is not None:\n139\t                if not trigger.condition(game, event):\n140\t                    continue\n141\t            matching.append(trigger)\n142\t\n143\t        if not matching:\n144\t            return\n145\t\n146\t        # One-shot (delayed) triggers fire exactly once: remove them from\n147\t        # the registry now that they have matched, so a later matching event\n148\t        # does not fire them again.\n149\t        one_shot_fired = [t for t in matching if t.one_shot]\n150\t        if one_shot_fired:\n151\t            self._triggers = [t for t in self._triggers if t not in one_shot_fired]\n152\t\n153\t        active_player = game.active_player\n154\t        active_triggers: list[TriggerRegistration] = []\n155\t        non_active_triggers: list[TriggerRegistration] = []\n156\t\n157\t        for trigger in matching:\n158\t            if trigger.controller is active_player:\n159\t                active_triggers.append(trigger)\n160\t            else:\n161\t                non_active_triggers.append(trigger)\n162\t\n163\t        ordered = active_triggers + non_active_triggers\n164\t\n165\t        for trigger in ordered:\n166\t            stack_obj = StackObject(\n167\t                source=trigger.source,\n168\t                controller=trigger.controller,\n169\t                on_resolve=trigger.effect,\n170\t            )\n171\t            game.stack.push(stack_obj)\n172\t\n173\t    def get_triggers(self) -> list[TriggerRegistration]:\n174\t        \"\"\"Return a shallow copy of all registered triggers.\"\"\"\n175\t        return list(self._triggers)\n176\t\n177\t    def get_triggers_for_source(self, source: Any) -> list[TriggerRegistration]:\n178\t        \"\"\"Return all triggers registered by *source* (identity-based).\"\"\"\n179\t        return [t for t in self._triggers if t.source is source]\n180\t\n181\t    def clear(self) -> None:\n182\t        \"\"\"Remove all registered triggers.\"\"\"\n183\t        self._triggers.clear()\n184\t"}]},"parent_tool_use_id":"toolu_01KzbV64VrxFyeMJaYKxaCDa","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"4e147007-66a8-496b-8d64-258127aa8dd3","timestamp":"2026-06-02T08:53:30.921Z","subagent_type":"Implementer","task_description":"Implement sos_120"}
{"type":"system","subtype":"task_progress","task_id":"a6a431f6e27cf0446","tool_use_id":"toolu_01KzbV64VrxFyeMJaYKxaCDa","description":"Reading engine/casting.py","subagent_type":"Implementer","usage":{"total_tokens":53136,"tool_uses":13,"duration_ms":15624},"last_tool_name":"Read","uuid":"6369980b-7650-4ce1-91f4-e8a133d2b5cc","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc"}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01JBVME91taPmeRoccxbTrbx","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01VT4GG9mVXe5Ei2ypFDDuVA","name":"Read","input":{"file_path":"/workspace/engine/casting.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10397,"cache_read_input_tokens":42659,"cache_creation":{"ephemeral_5m_input_tokens":10397,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01KzbV64VrxFyeMJaYKxaCDa","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"6d531ef6-1a57-4420-bdda-0cdaa3c5e479","request_id":"req_011Cbe9h1N17roKJx6fZE8mC","subagent_type":"Implementer","task_description":"Implement sos_120"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VT4GG9mVXe5Ei2ypFDDuVA","type":"tool_result","content":"1\t\"\"\"Casting and resolution pipeline for spells and lands.\n2\t\n3\tProvides the full flow from casting a spell or playing a land through\n4\tresolution:\n5\t\n6\t- :func:`cast_spell` — verify timing & legality → move hand to stack →\n7\t  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n8\t- :func:`play_land` — verify land play remaining → move hand to\n9\t  battlefield → decrement ``land_plays_remaining``.\n10\t- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n11\t  helpers used by the casting pipeline.\n12\t\n13\tResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\n14\tcreated by :func:`cast_spell`:\n15\t\n16\t- Call ``card.on_resolve(game)``.\n17\t- Permanents (creature / enchantment / artifact / planeswalker) move from\n18\t  the stack to the battlefield.\n19\t- Non-permanents (instant / sorcery) move to the graveyard.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import TYPE_CHECKING, Any\n25\t\n26\tfrom engine.card import CardImpl\n27\tfrom engine.stack import StackObject\n28\tfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\n29\tfrom engine.zones import move_zone\n30\t\n31\tif TYPE_CHECKING:\n32\t    from engine.game_state import GameState\n33\t    from engine.player import Player\n34\t\n35\t\n36\t# Card types that represent permanents — these go to the battlefield on resolve.\n37\t_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n38\t    CardType.CREATURE,\n39\t    CardType.ENCHANTMENT,\n40\t    CardType.ARTIFACT,\n41\t    CardType.PLANESWALKER,\n42\t})\n43\t\n44\t\n45\tclass CastingError(Exception):\n46\t    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n47\t\n48\t\n49\t# ------------------------------------------------------------------\n50\t# Timing helpers\n51\t# ------------------------------------------------------------------\n52\t\n53\tdef is_sorcery_speed(game: GameState, player: Player) -> bool:\n54\t    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n55\t\n56\t    Sorcery speed requires all of:\n57\t\n58\t    * *player* is the active player.\n59\t    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n60\t      ``POSTCOMBAT_MAIN``).\n61\t    * The stack is empty.\n62\t    \"\"\"\n63\t    if player is not game.active_player:\n64\t        return False\n65\t    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n66\t        return False\n67\t    if not game.stack.is_empty():\n68\t        return False\n69\t    return True\n70\t\n71\t\n72\tdef can_cast_at_instant_speed(card: CardImpl) -> bool:\n73\t    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n74\t\n75\t    A card has instant-speed timing if it is an instant or has the\n76\t    :attr:`~engine.types.Keyword.FLASH` keyword.\n77\t    \"\"\"\n78\t    if CardType.INSTANT in card.card_types:\n79\t        return True\n80\t    if Keyword.FLASH & card.keywords:\n81\t        return True\n82\t    return False\n83\t\n84\t\n85\t# ------------------------------------------------------------------\n86\t# Cost reduction\n87\t# ------------------------------------------------------------------\n88\t\n89\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n90\t    \"\"\"Return the generic mana reduction for casting *card*.\n91\t\n92\t    Queries ``card.cost_reduction(game)`` and clamps the result so that\n93\t    the generic portion of the mana cost cannot go below 0.\n94\t\n95\t    This is a simplified single-card self-reduction model.  Full MTG\n96\t    cost-reduction interactions (Trinisphere, multiple reductions from\n97\t    different sources) are deferred.\n98\t    \"\"\"\n99\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n100\t    # casting player even when the card was never explicitly assigned one.\n101\t    prev_controller = card.controller\n102\t    card.controller = controller\n103\t    raw = card.cost_reduction(game)\n104\t    # Restore previous controller in case the caller doesn't want a\n105\t    # side-effect (get_cost_reduction is a query, not a mutation).\n106\t    card.controller = prev_controller\n107\t    generic = card.mana_cost.generic if card.mana_cost else 0\n108\t    return max(0, min(raw, generic))\n109\t\n110\t\n111\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n112\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n113\t    new_generic = max(0, cost.generic - reduction)\n114\t    return ManaCost(\n115\t        generic=new_generic,\n116\t        pips=dict(cost.pips),\n117\t        x_count=cost.x_count,\n118\t        hybrid=list(cost.hybrid),\n119\t    )\n120\t\n121\t\n122\t# ------------------------------------------------------------------\n123\t# Cast spell\n124\t# ------------------------------------------------------------------\n125\t\n126\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n127\t    \"\"\"Cast *card* from *player*'s hand.\n128\t\n129\t    Pipeline\n130\t    --------\n131\t    1. **Timing check** — instants (and cards with flash) can be cast\n132\t       whenever the player has priority; everything else requires\n133\t       sorcery-speed timing.\n134\t    2. **can_cast** — ask the card whether it can legally be cast.\n135\t    3. **Hand check** — the card must be in the player's hand.\n136\t    4. **Move hand → stack zone** — remove the card from the hand and\n137\t       place it into the player's stack zone.\n138\t    5. **Choose targets** — if the card specifies targets (via\n139\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n140\t    6. **Mana check / payment** — the player's mana pool must be able to\n141\t       pay the card's mana cost.  If payment fails, the card is rolled\n142\t       back from the stack zone to the hand.\n143\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n144\t    8. **Push StackObject** — push a :class:`StackObject` whose\n145\t       ``on_resolve`` callback handles resolution.\n146\t\n147\t    Raises:\n148\t        CastingError: If any legality check fails.\n149\t    \"\"\"\n150\t    # 1. Timing\n151\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n152\t        raise CastingError(\n153\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n154\t        )\n155\t\n156\t    # 2. can_cast\n157\t    if not card.can_cast(game):\n158\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n159\t\n160\t    # 3. Hand check\n161\t    hand = game.get_hand(player)\n162\t    if not hand.contains(card):\n163\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n164\t\n165\t    # 4. Move card from hand to stack zone\n166\t    stack_zone = player.zones[Zone.STACK]\n167\t    hand.remove(card)\n168\t    stack_zone.add(card)\n169\t\n170\t    # Clear any stale colors_spent / mana_spent from a prior cast before\n171\t    # new payment.\n172\t    if hasattr(card, \"colors_spent\"):\n173\t        del card.colors_spent\n174\t    if hasattr(card, \"mana_spent\"):\n175\t        del card.mana_spent\n176\t\n177\t    # 5. Choose targets\n178\t    target_specs = card.get_targets(game)\n179\t    chosen_targets: list[Any] = []\n180\t    if target_specs:\n181\t        for spec in target_specs:\n182\t            target = player.choose_target(target_specs, spec)\n183\t            # Validate against filter_fn if the spec provides one\n184\t            filter_fn = getattr(spec, \"filter_fn\", None)\n185\t            if filter_fn is not None and target is not None:\n186\t                if not filter_fn(target):\n187\t                    stack_zone.remove(card)\n188\t                    hand.add(card)\n189\t                    raise CastingError(\n190\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n191\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n192\t                    )\n193\t            chosen_targets.append(target)\n194\t\n195\t    # 5b. Protection check — reject targets that have protection from this\n196\t    #     spell (the T in DEBT).\n197\t    from engine.protection import has_protection_from\n198\t\n199\t    for target in chosen_targets:\n200\t        if has_protection_from(target, card):\n201\t            # Rollback: move card from stack zone back to hand\n202\t            stack_zone.remove(card)\n203\t            hand.add(card)\n204\t            raise CastingError(\n205\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n206\t            )\n207\t\n208\t    # Targets are stored on the StackObject (not the card) and passed\n209\t    # through the resolve pipeline via on_resolve(game, targets=...).\n210\t\n211\t    # 6. Mana check / payment (rollback on failure)\n212\t    # Ensure the card knows its controller so that cost_reduction() hooks\n213\t    # (e.g. Embercleave counting attacking creatures you control) see the\n214\t    # casting player, even for cards that were added to hand without an\n215\t    # explicit controller assignment.\n216\t    if card.controller is None:\n217\t        card.controller = player\n218\t    reduction = get_cost_reduction(game, card, player)\n219\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n220\t\n221\t    if not player.mana_pool.can_pay(effective_cost):\n222\t        # Rollback: move card from stack zone back to hand\n223\t        stack_zone.remove(card)\n224\t        hand.add(card)\n225\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n226\t\n227\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n228\t    player.mana_pool.pay(effective_cost)\n229\t\n230\t    # Store colors of mana spent on the card for mechanics like Converge\n231\t    # that care about the colors used to cast the spell.\n232\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n233\t\n234\t    # Store the TOTAL amount of mana paid for this cast for mechanics that\n235\t    # care about the literal amount of mana spent (e.g. \"add {C} equal to\n236\t    # the amount of mana spent to cast that spell\").  For a no-X / non-\n237\t    # reduced cast this equals the card's mana value; with cost reductions\n238\t    # it reflects the actual amount paid after reduction.\n239\t    card.mana_spent = effective_cost.cmc  # type: ignore[attr-defined]\n240\t\n241\t    # 7. Call on_cast hook\n242\t    card.on_cast(game)\n243\t\n244\t    # 8. Build on_resolve callback and push StackObject\n245\t    stack_obj = StackObject(\n246\t        source=card,\n247\t        controller=player,\n248\t        targets=chosen_targets,\n249\t        on_resolve=lambda g: None,  # replaced below\n250\t    )\n251\t\n252\t    def _on_resolve(g: GameState) -> None:\n253\t        _resolve_spell(g, card, player, stack_obj)\n254\t\n255\t    stack_obj.on_resolve = _on_resolve\n256\t    game.stack.push(stack_obj)\n257\t\n258\t\n259\t# ------------------------------------------------------------------\n260\t# Cast spell without paying mana cost (free-cast from any zone)\n261\t# ------------------------------------------------------------------\n262\t\n263\t\n264\tdef cast_spell_free(\n265\t    game: GameState,\n266\t    player: Player,\n267\t    card: CardImpl,\n268\t    from_zone: Zone,\n269\t) -> None:\n270\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n271\t\n272\t    This is used by effects that allow casting from zones other than hand\n273\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n274\t    or cascade.\n275\t\n276\t    Pipeline\n277\t    --------\n278\t    1. **can_cast** — ask the card whether it can legally be cast (same\n279\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n280\t    2. Move *card* from *from_zone* to the stack zone.\n281\t    3. Choose targets (if applicable) with validation and protection check.\n282\t    4. Call ``on_cast`` hook.\n283\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n284\t       resolution normally (permanents → battlefield, non-permanents →\n285\t       graveyard).\n286\t\n287\t    No timing check or mana payment is performed.  The spell goes on the\n288\t    stack and can be responded to normally (e.g. countered).\n289\t\n290\t    If targeting or other post-move checks fail, the card is rolled back\n291\t    to its source zone.\n292\t\n293\t    Parameters:\n294\t        game: The current game state.\n295\t        player: The player casting the spell.\n296\t        card: The card to cast.\n297\t        from_zone: The zone the card is currently in.\n298\t\n299\t    Raises:\n300\t        CastingError: If the card cannot be found in *from_zone* or\n301\t            legality checks fail.\n302\t    \"\"\"\n303\t    from engine.zones import move_to_zone\n304\t\n305\t    # Ensure controller is set\n306\t    card.controller = player\n307\t    if card.owner is None:\n308\t        card.owner = player\n309\t\n310\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n311\t    if not card.can_cast(game):\n312\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n313\t\n314\t    # 2. Locate card in source zone\n315\t    source_zone_container = player.zones[from_zone]\n316\t    if not source_zone_container.contains(card):\n317\t        # Try to find the card in any player's zone\n318\t        source_zone_container = None\n319\t        for p in game.players:\n320\t            z = p.zones[from_zone]\n321\t            if z.contains(card):\n322\t                source_zone_container = z\n323\t                break\n324\t\n325\t    if source_zone_container is None or not source_zone_container.contains(card):\n326\t        raise CastingError(\n327\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n328\t        )\n329\t\n330\t    # Move card from source zone to stack zone\n331\t    stack_zone = player.zones[Zone.STACK]\n332\t    source_zone_container.remove(card)\n333\t    stack_zone.add(card)\n334\t\n335\t    # 3. Choose targets (with rollback on failure)\n336\t    try:\n337\t        target_specs = card.get_targets(game)\n338\t        chosen_targets: list[Any] = []\n339\t        if target_specs:\n340\t            for spec in target_specs:\n341\t                target = player.choose_target(target_specs, spec)\n342\t                # Validate against filter_fn if the spec provides one\n343\t                filter_fn = getattr(spec, \"filter_fn\", None)\n344\t                if filter_fn is not None and target is not None:\n345\t                    if not filter_fn(target):\n346\t                        raise CastingError(\n347\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n348\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n349\t                        )\n350\t                chosen_targets.append(target)\n351\t\n352\t        # Protection check — reject targets that have protection from this spell\n353\t        from engine.protection import has_protection_from\n354\t\n355\t        for target in chosen_targets:\n356\t            if has_protection_from(target, card):\n357\t                raise CastingError(\n358\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n359\t                )\n360\t    except Exception as exc:\n361\t        # Rollback: move card from stack zone back to source zone\n362\t        stack_zone.remove(card)\n363\t        source_zone_container.add(card)\n364\t        raise CastingError(str(exc)) from exc\n365\t\n366\t    # 4. Call on_cast hook\n367\t    card.on_cast(game)\n368\t\n369\t    # 5. Build on_resolve callback and push StackObject\n370\t    stack_obj = StackObject(\n371\t        source=card,\n372\t        controller=player,\n373\t        targets=chosen_targets,\n374\t        on_resolve=lambda g: None,  # replaced below\n375\t    )\n376\t\n377\t    def _on_resolve(g: GameState) -> None:\n378\t        _resolve_spell(g, card, player, stack_obj)\n379\t\n380\t    stack_obj.on_resolve = _on_resolve\n381\t    game.stack.push(stack_obj)\n382\t\n383\t\n384\t# ------------------------------------------------------------------\n385\t# Stack → graveyard redirection registry\n386\t# ------------------------------------------------------------------\n387\t#\n388\t# Some effects (e.g. \"you may cast target instant or sorcery from your\n389\t# graveyard ... If that spell would be put into your graveyard, exile it\n390\t# instead\") need to redirect a *spell* (a non-permanent on the stack) to a\n391\t# zone other than the graveyard when it finishes resolving.  The engine's\n392\t# replacement-effect pipeline in ``engine.zones.move_to_zone`` only consults\n393\t# replacement effects when a card is *leaving the battlefield*, so it does not\n394\t# cover the STACK → GRAVEYARD transition a resolving instant/sorcery makes.\n395\t#\n396\t# This lightweight, per-game registry lets such effects register a one-shot\n397\t# redirect keyed on the specific card object.  ``_resolve_spell`` consults the\n398\t# registry when an instant/sorcery would head to the graveyard and routes the\n399\t# card to the requested zone instead (clearing the entry afterwards so the\n400\t# redirect applies only to this resolution).\n401\t\n402\t\n403\tdef _redirect_registry(game: GameState) -> dict[int, str]:\n404\t    \"\"\"Return (creating if necessary) the per-game stack→graveyard redirect map.\n405\t\n406\t    The map is keyed by ``id(card)`` so identity-based lookup is preserved even\n407\t    for cards that are not hashable in a domain-meaningful way.  Stored lazily\n408\t    on the game object so no change to ``GameState.__init__`` is required.\n409\t    \"\"\"\n410\t    registry = getattr(game, \"_stack_to_graveyard_redirects\", None)\n411\t    if registry is None:\n412\t        registry = {}\n413\t        game._stack_to_graveyard_redirects = registry  # type: ignore[attr-defined]\n414\t    return registry\n415\t\n416\t\n417\tdef register_stack_to_graveyard_redirect(\n418\t    game: GameState,\n419\t    card: CardImpl,\n420\t    destination: str,\n421\t) -> None:\n422\t    \"\"\"Redirect *card* away from the graveyard when it resolves off the stack.\n423\t\n424\t    Registers a one-shot redirect so that when *card* (a resolving\n425\t    instant/sorcery) would be put into the graveyard from the stack, it is\n426\t    instead placed into the zone named by *destination* (``\"exile\"``,\n427\t    ``\"hand\"``, ``\"library\"`` — see ``engine.zones._DESTINATION_ZONE_MAP``).\n428\t\n429\t    The redirect is consumed the first time the card resolves from the stack.\n430\t    \"\"\"\n431\t    _redirect_registry(game)[id(card)] = destination\n432\t\n433\t\n434\tdef clear_stack_to_graveyard_redirect(game: GameState, card: CardImpl) -> None:\n435\t    \"\"\"Remove any pending stack→graveyard redirect for *card* (no-op if none).\"\"\"\n436\t    _redirect_registry(game).pop(id(card), None)\n437\t\n438\t\n439\t# ------------------------------------------------------------------\n440\t# Resolution (called when the stack pops)\n441\t# ------------------------------------------------------------------\n442\t\n443\tdef _resolve_spell(\n444\t    game: GameState,\n445\t    card: CardImpl,\n446\t    player: Player,\n447\t    stack_obj: StackObject,\n448\t) -> None:\n449\t    \"\"\"Resolve *card* cast by *player*.\n450\t\n451\t    1. Call ``card.on_resolve(game, targets=targets)``.\n452\t    2. Remove the card from the stack zone.\n453\t    3. If the card is a permanent type, move it to the battlefield via\n454\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n455\t       registration and the ETB event).\n456\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard —\n457\t       unless a stack→graveyard redirect was registered for this card, in\n458\t       which case it is routed to the requested zone (e.g. exile) instead.\n459\t    \"\"\"\n460\t    from engine.zones import _DESTINATION_ZONE_MAP, move_to_zone\n461\t\n462\t    # Read targets from the StackObject — the single source of truth.\n463\t    # Set chosen_targets on the card just before resolution so that\n464\t    # _get_chosen_target helpers (which read via getattr) work.\n465\t    targets = stack_obj.targets\n466\t    if targets is not None:\n467\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n468\t\n469\t    card.on_resolve(game)\n470\t\n471\t    if card.card_types & _PERMANENT_TYPES:\n472\t        # Move from stack to battlefield via move_to_zone, which handles\n473\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n474\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n475\t    else:\n476\t        # Instant/sorcery: move from stack to graveyard via move_to_zone,\n477\t        # honouring any registered one-shot stack→graveyard redirect (e.g.\n478\t        # \"If that spell would be put into your graveyard, exile it instead\").\n479\t        destination = _redirect_registry(game).pop(id(card), None)\n480\t        dest_zone = Zone.GRAVEYARD\n481\t        if destination is not None:\n482\t            dest_zone = _DESTINATION_ZONE_MAP.get(destination, Zone.GRAVEYARD)\n483\t        move_to_zone(game, card, Zone.STACK, dest_zone)\n484\t\n485\t\n486\t# ------------------------------------------------------------------\n487\t# Play land (special action — does not use the stack)\n488\t# ------------------------------------------------------------------\n489\t\n490\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n491\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n492\t\n493\t    Requirements (all must hold):\n494\t\n495\t    * *land_card* has :attr:`CardType.LAND`.\n496\t    * *player* is the active player.\n497\t    * Current phase is a main phase.\n498\t    * The stack is empty.\n499\t    * ``player.land_plays_remaining > 0``.\n500\t    * The card is in the player's hand.\n501\t\n502\t    On success the card moves from hand to battlefield and\n503\t    ``land_plays_remaining`` is decremented.\n504\t\n505\t    Raises:\n506\t        CastingError: If any requirement is not met.\n507\t    \"\"\"\n508\t    # Must be a land\n509\t    if CardType.LAND not in land_card.card_types:\n510\t        raise CastingError(\n511\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n512\t        )\n513\t\n514\t    # Sorcery-speed timing (active player, main phase, stack empty)\n515\t    if not is_sorcery_speed(game, player):\n516\t        raise CastingError(\n517\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n518\t            \"during main phase with empty stack\"\n519\t        )\n520\t\n521\t    # Land plays remaining\n522\t    if player.land_plays_remaining <= 0:\n523\t        raise CastingError(\n524\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n525\t        )\n526\t\n527\t    # Card must be in hand\n528\t    hand = game.get_hand(player)\n529\t    if not hand.contains(land_card):\n530\t        raise CastingError(\n531\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n532\t        )\n533\t\n534\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n535\t    if land_card.owner is None:\n536\t        land_card.owner = player\n537\t    land_card.controller = player\n538\t\n539\t    # Move from hand to battlefield via move_to_zone, which fires\n540\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n541\t    from engine.zones import move_to_zone\n542\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n543\t\n544\t    # Decrement land plays\n545\t    player.land_plays_remaining -= 1\n546\t\n547\t\n548\tdef resolve_top(game: GameState) -> None:\n549\t    \"\"\"Resolve the top spell/ability on the stack.\n550\t\n551\t    Pops the top item from the stack, calls its on_resolve callback,\n552\t    then runs state-based actions.  If the stack is empty this is a no-op.\n553\t    \"\"\"\n554\t    if game.stack.is_empty():\n555\t        return\n556\t    from engine.state_based_actions import resolve_state_based_actions\n557\t\n558\t    obj = game.stack.pop()\n559\t    obj.on_resolve(game)\n560\t    resolve_state_based_actions(game)\n561\t"}]},"parent_tool_use_id":"toolu_01KzbV64VrxFyeMJaYKxaCDa","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"c127a71d-6b77-4b7f-b0ec-33a7ed947d6b","timestamp":"2026-06-02T08:53:33.550Z","subagent_type":"Implementer","task_description":"Implement sos_120"}
