{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01SFreUornkeg6yecdavwfrT","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01SAngnUdtDZTcV3k4Hf3RzC","name":"Read","input":{"file_path":"/workspace/engine/casting.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12492,"cache_read_input_tokens":28087,"cache_creation":{"ephemeral_5m_input_tokens":12492,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01CbsKBgtu5hXmsenTvvH1UM","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"872ed8c4-32af-4951-b243-42e73ffb28ee","request_id":"req_011CbeGEFEzkGJLYiJKdncG9","subagent_type":"Tester","task_description":"Extend sos_257 tests"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SAngnUdtDZTcV3k4Hf3RzC","type":"tool_result","content":"1\t\"\"\"Casting and resolution pipeline for spells and lands.\n2\t\n3\tProvides the full flow from casting a spell or playing a land through\n4\tresolution:\n5\t\n6\t- :func:`cast_spell` — verify timing & legality → move hand to stack →\n7\t  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n8\t- :func:`play_land` — verify land play remaining → move hand to\n9\t  battlefield → decrement ``land_plays_remaining``.\n10\t- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n11\t  helpers used by the casting pipeline.\n12\t\n13\tResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\n14\tcreated by :func:`cast_spell`:\n15\t\n16\t- Call ``card.on_resolve(game)``.\n17\t- Permanents (creature / enchantment / artifact / planeswalker) move from\n18\t  the stack to the battlefield.\n19\t- Non-permanents (instant / sorcery) move to the graveyard.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import TYPE_CHECKING, Any\n25\t\n26\tfrom engine.card import CardImpl\n27\tfrom engine.stack import StackObject\n28\tfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\n29\tfrom engine.zones import move_zone\n30\t\n31\tif TYPE_CHECKING:\n32\t    from engine.game_state import GameState\n33\t    from engine.player import Player\n34\t\n35\t\n36\t# Card types that represent permanents — these go to the battlefield on resolve.\n37\t_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n38\t    CardType.CREATURE,\n39\t    CardType.ENCHANTMENT,\n40\t    CardType.ARTIFACT,\n41\t    CardType.PLANESWALKER,\n42\t})\n43\t\n44\t\n45\tclass CastingError(Exception):\n46\t    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n47\t\n48\t\n49\t# ------------------------------------------------------------------\n50\t# Timing helpers\n51\t# ------------------------------------------------------------------\n52\t\n53\tdef is_sorcery_speed(game: GameState, player: Player) -> bool:\n54\t    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n55\t\n56\t    Sorcery speed requires all of:\n57\t\n58\t    * *player* is the active player.\n59\t    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n60\t      ``POSTCOMBAT_MAIN``).\n61\t    * The stack is empty.\n62\t    \"\"\"\n63\t    if player is not game.active_player:\n64\t        return False\n65\t    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n66\t        return False\n67\t    if not game.stack.is_empty():\n68\t        return False\n69\t    return True\n70\t\n71\t\n72\tdef can_cast_at_instant_speed(card: CardImpl) -> bool:\n73\t    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n74\t\n75\t    A card has instant-speed timing if it is an instant or has the\n76\t    :attr:`~engine.types.Keyword.FLASH` keyword.\n77\t    \"\"\"\n78\t    if CardType.INSTANT in card.card_types:\n79\t        return True\n80\t    if Keyword.FLASH & card.keywords:\n81\t        return True\n82\t    return False\n83\t\n84\t\n85\t# ------------------------------------------------------------------\n86\t# Cost reduction\n87\t# ------------------------------------------------------------------\n88\t\n89\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n90\t    \"\"\"Return the generic mana reduction for casting *card*.\n91\t\n92\t    Queries ``card.cost_reduction(game)`` for the card's *own* cost reduction\n93\t    (e.g. Tolarian Terror counting instants/sorceries in your graveyard, or\n94\t    Witherbloom's own affinity for creatures) and adds any *granted* per-spell\n95\t    reduction another permanent contributes for this controller's spell (e.g.\n96\t    Witherbloom granting \"affinity for creatures\" to your instants/sorceries —\n97\t    see :mod:`engine.affinity`).  The summed reduction is clamped so that the\n98\t    generic portion of the mana cost cannot go below 0.\n99\t\n100\t    When no grant is registered for this spell, the granted contribution is 0 and\n101\t    the result is exactly the card's own clamped ``cost_reduction`` — so existing\n102\t    cost-reduction behaviour (sos_1, fdn_167) is unaffected.\n103\t\n104\t    Full MTG cost-reduction interactions (Trinisphere, ordering of multiple\n105\t    reductions from different sources) remain a simplified additive model.\n106\t    \"\"\"\n107\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n108\t    # casting player even when the card was never explicitly assigned one.\n109\t    prev_controller = card.controller\n110\t    card.controller = controller\n111\t    raw = card.cost_reduction(game)\n112\t    # Restore previous controller in case the caller doesn't want a\n113\t    # side-effect (get_cost_reduction is a query, not a mutation).\n114\t    card.controller = prev_controller\n115\t\n116\t    # Add any granted per-spell reduction (e.g. granted affinity for creatures)\n117\t    # registered for this controller's spell.  With no grant registered this is\n118\t    # 0, leaving the card's own reduction unchanged.\n119\t    from engine.affinity import get_granted_reduction\n120\t\n121\t    raw += get_granted_reduction(game, card, controller)\n122\t\n123\t    generic = card.mana_cost.generic if card.mana_cost else 0\n124\t    return max(0, min(raw, generic))\n125\t\n126\t\n127\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n128\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n129\t    new_generic = max(0, cost.generic - reduction)\n130\t    return ManaCost(\n131\t        generic=new_generic,\n132\t        pips=dict(cost.pips),\n133\t        x_count=cost.x_count,\n134\t        hybrid=list(cost.hybrid),\n135\t    )\n136\t\n137\t\n138\t# ------------------------------------------------------------------\n139\t# Cast spell\n140\t# ------------------------------------------------------------------\n141\t\n142\tdef cast_spell(\n143\t    game: GameState,\n144\t    player: Player,\n145\t    card: CardImpl,\n146\t    ignore_timing: bool = False,\n147\t) -> None:\n148\t    \"\"\"Cast *card* from *player*'s hand.\n149\t\n150\t    Pipeline\n151\t    --------\n152\t    1. **Timing check** — instants (and cards with flash) can be cast\n153\t       whenever the player has priority; everything else requires\n154\t       sorcery-speed timing.\n155\t    2. **can_cast** — ask the card whether it can legally be cast.\n156\t    3. **Hand check** — the card must be in the player's hand.\n157\t    4. **Move hand → stack zone** — remove the card from the hand and\n158\t       place it into the player's stack zone.\n159\t    5. **Choose targets** — if the card specifies targets (via\n160\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n161\t    6. **Mana check / payment** — the player's mana pool must be able to\n162\t       pay the card's mana cost.  If payment fails, the card is rolled\n163\t       back from the stack zone to the hand.\n164\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n165\t    8. **Push StackObject** — push a :class:`StackObject` whose\n166\t       ``on_resolve`` callback handles resolution.\n167\t\n168\t    Parameters:\n169\t        ignore_timing: When ``True``, the sorcery-speed timing gate\n170\t            (step 1) is bypassed so the spell may be cast outside a normal\n171\t            sorcery-speed window.  This is an opt-in escape hatch for\n172\t            casting permissions that create their own timing window — e.g.\n173\t            miracle (CR 702.94a), which lets a card be cast as it is drawn\n174\t            regardless of phase/stack/priority.  All other legality checks\n175\t            (``can_cast``, hand membership, targeting, mana payment) are\n176\t            unaffected.  Defaults to ``False`` so ordinary casts keep full\n177\t            sorcery-speed enforcement.\n178\t\n179\t    Raises:\n180\t        CastingError: If any legality check fails.\n181\t    \"\"\"\n182\t    # 1. Timing\n183\t    if (\n184\t        not ignore_timing\n185\t        and not can_cast_at_instant_speed(card)\n186\t        and not is_sorcery_speed(game, player)\n187\t    ):\n188\t        raise CastingError(\n189\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n190\t        )\n191\t\n192\t    # 2. can_cast\n193\t    if not card.can_cast(game):\n194\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n195\t\n196\t    # 3. Hand check\n197\t    hand = game.get_hand(player)\n198\t    if not hand.contains(card):\n199\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n200\t\n201\t    # 4. Move card from hand to stack zone\n202\t    stack_zone = player.zones[Zone.STACK]\n203\t    hand.remove(card)\n204\t    stack_zone.add(card)\n205\t\n206\t    # Clear any stale colors_spent / mana_spent from a prior cast before\n207\t    # new payment.\n208\t    if hasattr(card, \"colors_spent\"):\n209\t        del card.colors_spent\n210\t    if hasattr(card, \"mana_spent\"):\n211\t        del card.mana_spent\n212\t\n213\t    # 5. Choose targets\n214\t    target_specs = card.get_targets(game)\n215\t    chosen_targets: list[Any] = []\n216\t    if target_specs:\n217\t        for spec in target_specs:\n218\t            target = player.choose_target(target_specs, spec)\n219\t            # Validate against filter_fn if the spec provides one\n220\t            filter_fn = getattr(spec, \"filter_fn\", None)\n221\t            if filter_fn is not None and target is not None:\n222\t                if not filter_fn(target):\n223\t                    stack_zone.remove(card)\n224\t                    hand.add(card)\n225\t                    raise CastingError(\n226\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n227\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n228\t                    )\n229\t            chosen_targets.append(target)\n230\t\n231\t    # 5b. Protection check — reject targets that have protection from this\n232\t    #     spell (the T in DEBT).\n233\t    from engine.protection import has_protection_from\n234\t\n235\t    for target in chosen_targets:\n236\t        if has_protection_from(target, card):\n237\t            # Rollback: move card from stack zone back to hand\n238\t            stack_zone.remove(card)\n239\t            hand.add(card)\n240\t            raise CastingError(\n241\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n242\t            )\n243\t\n244\t    # Targets are stored on the StackObject (not the card) and passed\n245\t    # through the resolve pipeline via on_resolve(game, targets=...).\n246\t\n247\t    # 6. Mana check / payment (rollback on failure)\n248\t    # Ensure the card knows its controller so that cost_reduction() hooks\n249\t    # (e.g. Embercleave counting attacking creatures you control) see the\n250\t    # casting player, even for cards that were added to hand without an\n251\t    # explicit controller assignment.\n252\t    if card.controller is None:\n253\t        card.controller = player\n254\t    reduction = get_cost_reduction(game, card, player)\n255\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n256\t\n257\t    # Restricted mana (\"spend this mana only to cast an instant or sorcery\n258\t    # spell\") may help pay only for a permitted spell.  When the pool holds no\n259\t    # restricted mana, ``can_pay_for_spell`` delegates to ``can_pay`` so this\n260\t    # check is byte-for-byte identical to the historic ``can_pay`` path for\n261\t    # ordinary mana — only a pool tainted by restricted mana is treated\n262\t    # differently, and then only to *reject* an illegal spend.\n263\t    if not player.mana_pool.can_pay_for_spell(effective_cost, card):\n264\t        # Rollback: move card from stack zone back to hand\n265\t        stack_zone.remove(card)\n266\t        hand.add(card)\n267\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n268\t\n269\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n270\t    player.mana_pool.pay(effective_cost)\n271\t\n272\t    # Store colors of mana spent on the card for mechanics like Converge\n273\t    # that care about the colors used to cast the spell.\n274\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n275\t\n276\t    # Store the TOTAL amount of mana paid for this cast for mechanics that\n277\t    # care about the literal amount of mana spent (e.g. \"add {C} equal to\n278\t    # the amount of mana spent to cast that spell\").  For a no-X / non-\n279\t    # reduced cast this equals the card's mana value; with cost reductions\n280\t    # it reflects the actual amount paid after reduction.\n281\t    card.mana_spent = effective_cost.cmc  # type: ignore[attr-defined]\n282\t\n283\t    # 7. Call on_cast hook\n284\t    card.on_cast(game)\n285\t\n286\t    # 8. Build on_resolve callback and push StackObject\n287\t    stack_obj = StackObject(\n288\t        source=card,\n289\t        controller=player,\n290\t        targets=chosen_targets,\n291\t        on_resolve=lambda g: None,  # replaced below\n292\t    )\n293\t\n294\t    def _on_resolve(g: GameState) -> None:\n295\t        _resolve_spell(g, card, player, stack_obj)\n296\t\n297\t    stack_obj.on_resolve = _on_resolve\n298\t    game.stack.push(stack_obj)\n299\t\n300\t\n301\t# ------------------------------------------------------------------\n302\t# Cast spell without paying mana cost (free-cast from any zone)\n303\t# ------------------------------------------------------------------\n304\t\n305\t\n306\tdef cast_spell_free(\n307\t    game: GameState,\n308\t    player: Player,\n309\t    card: CardImpl,\n310\t    from_zone: Zone,\n311\t) -> None:\n312\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n313\t\n314\t    This is used by effects that allow casting from zones other than hand\n315\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n316\t    or cascade.\n317\t\n318\t    Pipeline\n319\t    --------\n320\t    1. **can_cast** — ask the card whether it can legally be cast (same\n321\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n322\t    2. Move *card* from *from_zone* to the stack zone.\n323\t    3. Choose targets (if applicable) with validation and protection check.\n324\t    4. Call ``on_cast`` hook.\n325\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n326\t       resolution normally (permanents → battlefield, non-permanents →\n327\t       graveyard).\n328\t\n329\t    No timing check or mana payment is performed.  The spell goes on the\n330\t    stack and can be responded to normally (e.g. countered).\n331\t\n332\t    If targeting or other post-move checks fail, the card is rolled back\n333\t    to its source zone.\n334\t\n335\t    Parameters:\n336\t        game: The current game state.\n337\t        player: The player casting the spell.\n338\t        card: The card to cast.\n339\t        from_zone: The zone the card is currently in.\n340\t\n341\t    Raises:\n342\t        CastingError: If the card cannot be found in *from_zone* or\n343\t            legality checks fail.\n344\t    \"\"\"\n345\t    from engine.zones import move_to_zone\n346\t\n347\t    # Ensure controller is set\n348\t    card.controller = player\n349\t    if card.owner is None:\n350\t        card.owner = player\n351\t\n352\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n353\t    if not card.can_cast(game):\n354\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n355\t\n356\t    # 2. Locate card in source zone\n357\t    source_zone_container = player.zones[from_zone]\n358\t    if not source_zone_container.contains(card):\n359\t        # Try to find the card in any player's zone\n360\t        source_zone_container = None\n361\t        for p in game.players:\n362\t            z = p.zones[from_zone]\n363\t            if z.contains(card):\n364\t                source_zone_container = z\n365\t                break\n366\t\n367\t    if source_zone_container is None or not source_zone_container.contains(card):\n368\t        raise CastingError(\n369\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n370\t        )\n371\t\n372\t    # Move card from source zone to stack zone\n373\t    stack_zone = player.zones[Zone.STACK]\n374\t    source_zone_container.remove(card)\n375\t    stack_zone.add(card)\n376\t\n377\t    # 3. Choose targets (with rollback on failure)\n378\t    try:\n379\t        target_specs = card.get_targets(game)\n380\t        chosen_targets: list[Any] = []\n381\t        if target_specs:\n382\t            for spec in target_specs:\n383\t                target = player.choose_target(target_specs, spec)\n384\t                # Validate against filter_fn if the spec provides one\n385\t                filter_fn = getattr(spec, \"filter_fn\", None)\n386\t                if filter_fn is not None and target is not None:\n387\t                    if not filter_fn(target):\n388\t                        raise CastingError(\n389\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n390\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n391\t                        )\n392\t                chosen_targets.append(target)\n393\t\n394\t        # Protection check — reject targets that have protection from this spell\n395\t        from engine.protection import has_protection_from\n396\t\n397\t        for target in chosen_targets:\n398\t            if has_protection_from(target, card):\n399\t                raise CastingError(\n400\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n401\t                )\n402\t    except Exception as exc:\n403\t        # Rollback: move card from stack zone back to source zone\n404\t        stack_zone.remove(card)\n405\t        source_zone_container.add(card)\n406\t        raise CastingError(str(exc)) from exc\n407\t\n408\t    # 4. Call on_cast hook\n409\t    card.on_cast(game)\n410\t\n411\t    # 5. Build on_resolve callback and push StackObject\n412\t    stack_obj = StackObject(\n413\t        source=card,\n414\t        controller=player,\n415\t        targets=chosen_targets,\n416\t        on_resolve=lambda g: None,  # replaced below\n417\t    )\n418\t\n419\t    def _on_resolve(g: GameState) -> None:\n420\t        _resolve_spell(g, card, player, stack_obj)\n421\t\n422\t    stack_obj.on_resolve = _on_resolve\n423\t    game.stack.push(stack_obj)\n424\t\n425\t\n426\t# ------------------------------------------------------------------\n427\t# Stack → graveyard redirection registry\n428\t# ------------------------------------------------------------------\n429\t#\n430\t# Some effects (e.g. \"you may cast target instant or sorcery from your\n431\t# graveyard ... If that spell would be put into your graveyard, exile it\n432\t# instead\") need to redirect a *spell* (a non-permanent on the stack) to a\n433\t# zone other than the graveyard when it finishes resolving.  The engine's\n434\t# replacement-effect pipeline in ``engine.zones.move_to_zone`` only consults\n435\t# replacement effects when a card is *leaving the battlefield*, so it does not\n436\t# cover the STACK → GRAVEYARD transition a resolving instant/sorcery makes.\n437\t#\n438\t# This lightweight, per-game registry lets such effects register a one-shot\n439\t# redirect keyed on the specific card object.  ``_resolve_spell`` consults the\n440\t# registry when an instant/sorcery would head to the graveyard and routes the\n441\t# card to the requested zone instead (clearing the entry afterwards so the\n442\t# redirect applies only to this resolution).\n443\t\n444\t\n445\tdef _redirect_registry(game: GameState) -> dict[int, str]:\n446\t    \"\"\"Return (creating if necessary) the per-game stack→graveyard redirect map.\n447\t\n448\t    The map is keyed by ``id(card)`` so identity-based lookup is preserved even\n449\t    for cards that are not hashable in a domain-meaningful way.  Stored lazily\n450\t    on the game object so no change to ``GameState.__init__`` is required.\n451\t    \"\"\"\n452\t    registry = getattr(game, \"_stack_to_graveyard_redirects\", None)\n453\t    if registry is None:\n454\t        registry = {}\n455\t        game._stack_to_graveyard_redirects = registry  # type: ignore[attr-defined]\n456\t    return registry\n457\t\n458\t\n459\tdef register_stack_to_graveyard_redirect(\n460\t    game: GameState,\n461\t    card: CardImpl,\n462\t    destination: str,\n463\t) -> None:\n464\t    \"\"\"Redirect *card* away from the graveyard when it resolves off the stack.\n465\t\n466\t    Registers a one-shot redirect so that when *card* (a resolving\n467\t    instant/sorcery) would be put into the graveyard from the stack, it is\n468\t    instead placed into the zone named by *destination* (``\"exile\"``,\n469\t    ``\"hand\"``, ``\"library\"`` — see ``engine.zones._DESTINATION_ZONE_MAP``).\n470\t\n471\t    The redirect is consumed the first time the card resolves from the stack.\n472\t    \"\"\"\n473\t    _redirect_registry(game)[id(card)] = destination\n474\t\n475\t\n476\tdef clear_stack_to_graveyard_redirect(game: GameState, card: CardImpl) -> None:\n477\t    \"\"\"Remove any pending stack→graveyard redirect for *card* (no-op if none).\"\"\"\n478\t    _redirect_registry(game).pop(id(card), None)\n479\t\n480\t\n481\t# ------------------------------------------------------------------\n482\t# Resolution (called when the stack pops)\n483\t# ------------------------------------------------------------------\n484\t\n485\tdef _resolve_spell(\n486\t    game: GameState,\n487\t    card: CardImpl,\n488\t    player: Player,\n489\t    stack_obj: StackObject,\n490\t) -> None:\n491\t    \"\"\"Resolve *card* cast by *player*.\n492\t\n493\t    1. Call ``card.on_resolve(game, targets=targets)``.\n494\t    2. Remove the card from the stack zone.\n495\t    3. If the card is a permanent type, move it to the battlefield via\n496\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n497\t       registration and the ETB event).\n498\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard —\n499\t       unless a stack→graveyard redirect was registered for this card, in\n500\t       which case it is routed to the requested zone (e.g. exile) instead.\n501\t    \"\"\"\n502\t    from engine.zones import _DESTINATION_ZONE_MAP, move_to_zone\n503\t\n504\t    # Read targets from the StackObject — the single source of truth.\n505\t    # Set chosen_targets on the card just before resolution so that\n506\t    # _get_chosen_target helpers (which read via getattr) work.\n507\t    targets = stack_obj.targets\n508\t    if targets is not None:\n509\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n510\t\n511\t    card.on_resolve(game)\n512\t\n513\t    if card.card_types & _PERMANENT_TYPES:\n514\t        # Move from stack to battlefield via move_to_zone, which handles\n515\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n516\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n517\t    else:\n518\t        # Instant/sorcery: move from stack to graveyard via move_to_zone,\n519\t        # honouring any registered one-shot stack→graveyard redirect (e.g.\n520\t        # \"If that spell would be put into your graveyard, exile it instead\").\n521\t        destination = _redirect_registry(game).pop(id(card), None)\n522\t        dest_zone = Zone.GRAVEYARD\n523\t        if destination is not None:\n524\t            dest_zone = _DESTINATION_ZONE_MAP.get(destination, Zone.GRAVEYARD)\n525\t        move_to_zone(game, card, Zone.STACK, dest_zone)\n526\t\n527\t\n528\t# ------------------------------------------------------------------\n529\t# Play land (special action — does not use the stack)\n530\t# ------------------------------------------------------------------\n531\t\n532\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n533\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n534\t\n535\t    Requirements (all must hold):\n536\t\n537\t    * *land_card* has :attr:`CardType.LAND`.\n538\t    * *player* is the active player.\n539\t    * Current phase is a main phase.\n540\t    * The stack is empty.\n541\t    * ``player.land_plays_remaining > 0``.\n542\t    * The card is in the player's hand.\n543\t\n544\t    On success the card moves from hand to battlefield and\n545\t    ``land_plays_remaining`` is decremented.\n546\t\n547\t    Raises:\n548\t        CastingError: If any requirement is not met.\n549\t    \"\"\"\n550\t    # Must be a land\n551\t    if CardType.LAND not in land_card.card_types:\n552\t        raise CastingError(\n553\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n554\t        )\n555\t\n556\t    # Sorcery-speed timing (active player, main phase, stack empty)\n557\t    if not is_sorcery_speed(game, player):\n558\t        raise CastingError(\n559\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n560\t            \"during main phase with empty stack\"\n561\t        )\n562\t\n563\t    # Land plays remaining\n564\t    if player.land_plays_remaining <= 0:\n565\t        raise CastingError(\n566\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n567\t        )\n568\t\n569\t    # Card must be in hand\n570\t    hand = game.get_hand(player)\n571\t    if not hand.contains(land_card):\n572\t        raise CastingError(\n573\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n574\t        )\n575\t\n576\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n577\t    if land_card.owner is None:\n578\t        land_card.owner = player\n579\t    land_card.controller = player\n580\t\n581\t    # Move from hand to battlefield via move_to_zone, which fires\n582\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n583\t    from engine.zones import move_to_zone\n584\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n585\t\n586\t    # Decrement land plays\n587\t    player.land_plays_remaining -= 1\n588\t\n589\t\n590\tdef resolve_top(game: GameState) -> None:\n591\t    \"\"\"Resolve the top spell/ability on the stack.\n592\t\n593\t    Pops the top item from the stack, calls its on_resolve callback,\n594\t    then runs state-based actions.  If the stack is empty this is a no-op.\n595\t    \"\"\"\n596\t    if game.stack.is_empty():\n597\t        return\n598\t    from engine.state_based_actions import resolve_state_based_actions\n599\t\n600\t    obj = game.stack.pop()\n601\t    obj.on_resolve(game)\n602\t    resolve_state_based_actions(game)\n603\t"}]},"parent_tool_use_id":"toolu_01CbsKBgtu5hXmsenTvvH1UM","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"fb2872f1-d7bb-4a43-bd2d-6bbcf8f07059","timestamp":"2026-06-02T10:19:17.970Z","subagent_type":"Tester","task_description":"Extend sos_257 tests"}
