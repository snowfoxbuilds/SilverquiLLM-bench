{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01G2rMAiLAQgnCc7FmxqfqCy","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_245/card_impl.py b/cards/sos/sos_245/card_impl.py\n2\tindex b860d8c..77c8b66 100644\n3\t--- a/cards/sos/sos_245/card_impl.py\n4\t+++ b/cards/sos/sos_245/card_impl.py\n5\t@@ -1,16 +1,216 @@\n6\t-\"\"\"Card implementation for Witherbloom, the Balancer.\"\"\"\n7\t+\"\"\"Card implementation for Witherbloom, the Balancer (SOS 245).\"\"\"\n8\t \n9\t from __future__ import annotations\n10\t \n11\t-from engine.card import CardImpl\n12\t+from typing import TYPE_CHECKING, Any\n13\t \n14\t-from typing import TYPE_CHECKING\n15\t+from engine.card import Creature\n16\t+from engine.types import CardType, Color, Keyword, ManaCost, Supertype\n17\t \n18\t if TYPE_CHECKING:\n19\t     from engine.game_state import GameState\n20\t \n21\t \n22\t-class WitherbloomTheBalancer(CardImpl):\n23\t-    \"\"\"TODO: Implement Witherbloom, the Balancer.\"\"\"\n24\t+def _is_on_battlefield(game: Any, obj: Any) -> bool:\n25\t+    \"\"\"Return ``True`` if *obj* is on any player's battlefield.\"\"\"\n26\t+    for player in game.players:\n27\t+        if game.get_battlefield(player).contains(obj):\n28\t+            return True\n29\t+    return False\n30\t \n31\t-    pass\n32\t+\n33\t+def _count_creatures_controlled(game: Any, controller: Any) -> int:\n34\t+    \"\"\"Return how many creatures *controller* controls (on their battlefield).\"\"\"\n35\t+    if controller is None:\n36\t+        return 0\n37\t+    count = 0\n38\t+    for card in game.get_battlefield(controller).get_all():\n39\t+        if CardType.CREATURE in getattr(card, \"card_types\", set()):\n40\t+            count += 1\n41\t+    return count\n42\t+\n43\t+\n44\t+class WitherbloomTheBalancer(Creature):\n45\t+    \"\"\"Witherbloom, the Balancer — {6}{B}{G} — Legendary Creature — Elder Dragon.\n46\t+\n47\t+    Affinity for creatures (this spell costs {1} less to cast for each creature\n48\t+    you control.)\n49\t+    Flying, deathtouch.\n50\t+    Instant and sorcery spells you cast have affinity for creatures.\n51\t+\n52\t+    SOS collector number 245.\n53\t+    \"\"\"\n54\t+\n55\t+    #: \"Affinity\" is a printed keyword label, NOT an evergreen\n56\t+    #: ``engine.types.Keyword`` enum member (that enum is frozen at 16 members),\n57\t+    #: so it is recorded as a printed-keyword label below.\n58\t+    AFFINITY_LABEL = \"Affinity\"\n59\t+\n60\t+    def __init__(self, **kwargs: Any) -> None:\n61\t+        kwargs.setdefault(\"name\", \"Witherbloom, the Balancer\")\n62\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{6}{B}{G}\"))\n63\t+        kwargs.setdefault(\"subtypes\", {\"Dragon\", \"Elder\"})\n64\t+        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n65\t+        kwargs.setdefault(\"keywords\", Keyword.FLYING | Keyword.DEATHTOUCH)\n66\t+        kwargs.setdefault(\"base_power\", 5)\n67\t+        kwargs.setdefault(\"base_toughness\", 5)\n68\t+        kwargs.setdefault(\n69\t+            \"rules_text\",\n70\t+            \"Affinity for creatures (This spell costs {1} less to cast for each \"\n71\t+            \"creature you control.)\\n\"\n72\t+            \"Flying, deathtouch\\n\"\n73\t+            \"Instant and sorcery spells you cast have affinity for creatures.\",\n74\t+        )\n75\t+        super().__init__(**kwargs)\n76\t+        # Explicit colour identity (B+G) so the colour is stable even when the\n77\t+        # cost is unavailable; the cost pips already encode it.\n78\t+        self.colors: list[Color] = [Color.BLACK, Color.GREEN]\n79\t+        # Printed-keyword label surface — Affinity is a printed keyword, not an\n80\t+        # evergreen ``Keyword`` enum member.\n81\t+        self.printed_keywords: list[str] = [self.AFFINITY_LABEL]\n82\t+\n83\t+    # ------------------------------------------------------------------\n84\t+    # Witherbloom's OWN affinity for creatures — cost reduction.\n85\t+    # ------------------------------------------------------------------\n86\t+\n87\t+    def cost_reduction(self, game: \"GameState\") -> int:\n88\t+        \"\"\"Reduce the generic cost by {1} per creature its controller controls.\n89\t+\n90\t+        Affinity for creatures: only creatures the CONTROLLER controls count\n91\t+        (an opponent's creatures do not; non-creature permanents do not).  The\n92\t+        engine clamps the final value so generic mana never goes below 0 (see\n93\t+        ``engine.casting.get_cost_reduction``).  While Witherbloom is on the\n94\t+        stack being cast it is not on the battlefield, so it does not count\n95\t+        itself.\n96\t+        \"\"\"\n97\t+        return _count_creatures_controlled(game, self.controller)\n98\t+\n99\t+    # ------------------------------------------------------------------\n100\t+    # Granted affinity for creatures — queryable grant surface.\n101\t+    # ------------------------------------------------------------------\n102\t+\n103\t+    def has_affinity_for_creatures(self, game: \"GameState\", spell: Any) -> bool:\n104\t+        \"\"\"Return ``True`` if this card grants affinity for creatures to *spell*.\n105\t+\n106\t+        Witherbloom grants affinity for creatures to every instant and sorcery\n107\t+        spell *its controller casts*.  This is the queryable grant surface the\n108\t+        tests probe: it returns ``True`` only when\n109\t+\n110\t+        * Witherbloom is on the battlefield,\n111\t+        * *spell* is an instant or a sorcery, and\n112\t+        * *spell* is controlled by / in the hand of Witherbloom's controller,\n113\t+\n114\t+        and ``False`` otherwise (creatures, an opponent's spell, off-battlefield).\n115\t+        \"\"\"\n116\t+        from engine.affinity import is_instant_or_sorcery\n117\t+\n118\t+        controller = self.controller\n119\t+        if controller is None:\n120\t+            return False\n121\t+        if not _is_on_battlefield(game, self):\n122\t+            return False\n123\t+        if not is_instant_or_sorcery(spell):\n124\t+            return False\n125\t+        return self._spell_is_controllers(game, spell, controller)\n126\t+\n127\t+    def _spell_is_controllers(\n128\t+        self, game: \"GameState\", spell: Any, controller: Any\n129\t+    ) -> bool:\n130\t+        \"\"\"Return ``True`` if *spell* belongs to Witherbloom's controller.\n131\t+\n132\t+        The grant only applies to spells *you* cast.  With no fully live cast\n133\t+        pipeline, a spell is treated as the controller's when it is in the\n134\t+        controller's hand (the observable proxy the tests use) or already\n135\t+        controlled by the controller (a spell on the stack).\n136\t+        \"\"\"\n137\t+        spell_controller = getattr(spell, \"controller\", None)\n138\t+        if spell_controller is controller:\n139\t+            return True\n140\t+        if game.get_hand(controller).contains(spell):\n141\t+            return True\n142\t+        for player in game.players:\n143\t+            if player is controller:\n144\t+                continue\n145\t+            if game.get_hand(player).contains(spell):\n146\t+                return False\n147\t+        return False\n148\t+\n149\t+    # ------------------------------------------------------------------\n150\t+    # Continuous grant + granted-reduction pipeline wiring.\n151\t+    # ------------------------------------------------------------------\n152\t+\n153\t+    def register_triggers(self, game: \"GameState\") -> None:\n154\t+        \"\"\"Install the continuous affinity grant and the granted-reduction hook.\"\"\"\n155\t+        self._apply_affinity_grant(game)\n156\t+        self._register_affinity_reduction(game)\n157\t+\n158\t+    def register_replacement_effects(self, game: \"GameState\") -> None:\n159\t+        \"\"\"Refresh the affinity grant whenever effects are recomputed.\"\"\"\n160\t+        self._apply_affinity_grant(game)\n161\t+        self._register_affinity_reduction(game)\n162\t+\n163\t+    def _apply_affinity_grant(self, game: \"GameState\") -> None:\n164\t+        \"\"\"Flag every instant/sorcery in the controller's hand as having affinity.\n165\t+\n166\t+        Reuses the additive :func:`engine.affinity.grant_affinity_to_hand` so the\n167\t+        grant is observable both via :meth:`has_affinity_for_creatures` and via\n168\t+        the ``affinity_for_creatures`` flag written onto each affected hand card.\n169\t+        No-ops (and clears stale flags) while Witherbloom is off the battlefield.\n170\t+        \"\"\"\n171\t+        from engine.affinity import clear_affinity_flags, grant_affinity_to_hand\n172\t+\n173\t+        controller = self.controller\n174\t+        if controller is None:\n175\t+            return\n176\t+        if not _is_on_battlefield(game, self):\n177\t+            clear_affinity_flags(game, self)\n178\t+            return\n179\t+        grant_affinity_to_hand(game, self, controller)\n180\t+\n181\t+    def _register_affinity_reduction(self, game: \"GameState\") -> None:\n182\t+        \"\"\"Drive the granted affinity reduction through the cast/cost pipeline.\n183\t+\n184\t+        Registers (per source) a granted per-spell reduction so that when the\n185\t+        controller casts a granted instant/sorcery, ``cast_spell`` /\n186\t+        ``get_cost_reduction`` lowers its generic cost by the number of creatures\n187\t+        the controller controls (clamped to the spell's generic) — exactly like\n188\t+        affinity.  The grant applies only to the controller's instants/sorceries\n189\t+        while Witherbloom is on the battlefield; otherwise it contributes 0.\n190\t+        \"\"\"\n191\t+        from engine.affinity import (\n192\t+            clear_affinity_grant,\n193\t+            is_instant_or_sorcery,\n194\t+            register_affinity_grant,\n195\t+        )\n196\t+\n197\t+        controller = self.controller\n198\t+        if controller is None:\n199\t+            return\n200\t+        if not _is_on_battlefield(game, self):\n201\t+            clear_affinity_grant(game, self)\n202\t+            return\n203\t+\n204\t+        source = self\n205\t+\n206\t+        def _applies(g: Any, spell: Any, ctrl: Any) -> bool:\n207\t+            # The grant functions only while Witherbloom is on the battlefield.\n208\t+            if not _is_on_battlefield(g, source):\n209\t+                return False\n210\t+            grant_controller = getattr(source, \"controller\", None)\n211\t+            if grant_controller is None:\n212\t+                return False\n213\t+            # Only the granting controller's spells receive the reduction.\n214\t+            if ctrl is not grant_controller:\n215\t+                return False\n216\t+            # Only instant/sorcery spells — not creature spells, not the\n217\t+            # granting permanent's own (creature) spell.\n218\t+            if spell is source:\n219\t+                return False\n220\t+            return is_instant_or_sorcery(spell)\n221\t+\n222\t+        def _resolver(g: Any, spell: Any, ctrl: Any) -> int:\n223\t+            # Affinity for creatures: {1} less per creature the controller\n224\t+            # controls.\n225\t+            return _count_creatures_controlled(g, ctrl)\n226\t+\n227\t+        register_affinity_grant(game, source, controller, _resolver, _applies)\n228\tdiff --git a/engine/affinity.py b/engine/affinity.py\n229\tnew file mode 100644\n230\tindex 0000000..61d7d41\n231\t--- /dev/null\n232\t+++ b/engine/affinity.py\n233\t@@ -0,0 +1,270 @@\n234\t+\"\"\"Affinity-keyword framework (Comprehensive Rules 702.41).\n235\t+\n236\t+*Affinity for [quality]* is a static ability that reduces the generic portion of\n237\t+a spell's cost:\n238\t+\n239\t+    Affinity for creatures (This spell costs {1} less to cast for each creature\n240\t+    you control.)\n241\t+\n242\t+A card normally carries affinity as a printed cost-reduction ability — that\n243\t+*own* affinity is implemented with the established ``cost_reduction(self, game)``\n244\t+hook (sos_1 / fdn_167 Tolarian Terror), which the engine's\n245\t+:func:`engine.casting.get_cost_reduction` clamps to the spell's generic portion.\n246\t+\n247\t+Witherbloom, the Balancer also *grants* \"affinity for creatures\" to every\n248\t+instant and sorcery **spell** its controller casts.  The engine had no support\n249\t+for a granting permanent contributing a per-spell cost reduction, so this module\n250\t+adds it *additively* — no existing engine symbol is renamed, moved, or deleted.\n251\t+It mirrors :mod:`engine.casualty` / :mod:`engine.miracle` / :mod:`engine.paradigm`.\n252\t+\n253\t+The mechanic has two observable parts:\n254\t+\n255\t+1. **The grant surface.**  A *granted affinity-for-creatures* flag is recorded on\n256\t+   the affected spell (``spell.affinity_for_creatures = True``) and is also\n257\t+   queryable via :func:`grants_affinity_for_creatures`.  A continuous-grant source\n258\t+   (Witherbloom) installs / refreshes the grant via\n259\t+   :func:`grant_affinity_to_hand`, which only ever writes the flag onto\n260\t+   instants/sorceries in *its controller's* hand and clears stale grants from\n261\t+   cards that have left the hand.\n262\t+\n263\t+2. **The granted cost reduction (driven through the cast/cost pipeline).**  A\n264\t+   granting permanent registers, per controller, a *granted reduction* — a\n265\t+   callable ``(game, spell, controller) -> int`` returning how much {1}-less the\n266\t+   grant gives a particular spell (for affinity for creatures: the number of\n267\t+   creatures the controller controls).  :func:`get_granted_reduction` sums the\n268\t+   contributions of every registered grant that applies to a spell, and\n269\t+   :func:`engine.casting.get_cost_reduction` adds that to the cast card's own\n270\t+   ``cost_reduction(game)`` hook before clamping to the spell's generic portion.\n271\t+   With no grant registered the sum is 0, so existing cost-reduction behaviour\n272\t+   (sos_1, fdn_167) is unchanged.\n273\t+\n274\t+\"Affinity\" is a *printed keyword label*, not an evergreen keyword, so no member\n275\t+is added to :class:`engine.types.Keyword` (that enum is frozen at 16 members).\n276\t+\"\"\"\n277\t+\n278\t+from __future__ import annotations\n279\t+\n280\t+from typing import TYPE_CHECKING, Any, Callable\n281\t+\n282\t+from engine.types import CardType, Zone\n283\t+\n284\t+if TYPE_CHECKING:\n285\t+    from engine.game_state import GameState\n286\t+\n287\t+\n288\t+#: Type of a granted-reduction resolver: ``(game, spell, controller) -> int``.\n289\t+ReductionResolver = Callable[[Any, Any, Any], int]\n290\t+\n291\t+\n292\t+# ---------------------------------------------------------------------------\n293\t+# Grant surface — read / write the granted affinity flag on a spell\n294\t+# ---------------------------------------------------------------------------\n295\t+\n296\t+\n297\t+def is_instant_or_sorcery(card: Any) -> bool:\n298\t+    \"\"\"Return ``True`` if *card* is an instant or sorcery (the granted types).\"\"\"\n299\t+    card_types = getattr(card, \"card_types\", set())\n300\t+    return CardType.INSTANT in card_types or CardType.SORCERY in card_types\n301\t+\n302\t+\n303\t+def grants_affinity_for_creatures(card: Any) -> bool:\n304\t+    \"\"\"Return ``True`` if *card* currently carries a granted affinity-for-creatures.\"\"\"\n305\t+    return bool(getattr(card, \"affinity_for_creatures\", False))\n306\t+\n307\t+\n308\t+def set_affinity_for_creatures(card: Any, granted: bool) -> None:\n309\t+    \"\"\"Write (or clear) the granted affinity-for-creatures flag on *card*.\n310\t+\n311\t+    Passing ``False`` clears the grant (removes the ``affinity_for_creatures``\n312\t+    attribute so a stale grant never lingers on a card that has left the granting\n313\t+    zone).\n314\t+    \"\"\"\n315\t+    if not granted:\n316\t+        if hasattr(card, \"affinity_for_creatures\"):\n317\t+            try:\n318\t+                delattr(card, \"affinity_for_creatures\")\n319\t+            except AttributeError:\n320\t+                card.affinity_for_creatures = False  # type: ignore[attr-defined]\n321\t+        if hasattr(card, \"_affinity_grant_source\"):\n322\t+            try:\n323\t+                delattr(card, \"_affinity_grant_source\")\n324\t+            except AttributeError:\n325\t+                pass\n326\t+        return\n327\t+    card.affinity_for_creatures = True  # type: ignore[attr-defined]\n328\t+\n329\t+\n330\t+# ---------------------------------------------------------------------------\n331\t+# Per-game registry of cards a given source has flagged with the grant\n332\t+# ---------------------------------------------------------------------------\n333\t+\n334\t+\n335\t+def _flagged_registry(game: GameState) -> dict[int, set[int]]:\n336\t+    \"\"\"Return (creating if necessary) the per-game affinity-flag registry.\n337\t+\n338\t+    Maps ``id(source)`` to the set of ``id(card)`` it last flagged, so a refresh\n339\t+    can clear flags from cards that have since left the granting zone.  Stored\n340\t+    lazily on the game object — no ``GameState.__init__`` change.\n341\t+    \"\"\"\n342\t+    registry = getattr(game, \"_affinity_flags\", None)\n343\t+    if registry is None:\n344\t+        registry = {}\n345\t+        game._affinity_flags = registry  # type: ignore[attr-defined]\n346\t+    return registry\n347\t+\n348\t+\n349\t+def grant_affinity_to_hand(\n350\t+    game: GameState,\n351\t+    source: Any,\n352\t+    controller: Any,\n353\t+) -> list[Any]:\n354\t+    \"\"\"Flag every instant/sorcery in *controller*'s hand as having affinity.\n355\t+\n356\t+    This is the observable half of Witherbloom's continuous static ability:\n357\t+    while the source is on the battlefield, every instant and sorcery spell its\n358\t+    controller casts \"has affinity for creatures\".  The flag is written onto each\n359\t+    such hand card (``card.affinity_for_creatures = True``) and is queryable via\n360\t+    :func:`grants_affinity_for_creatures`.\n361\t+\n362\t+    The grant is *scoped*:\n363\t+\n364\t+    * only instants and sorceries are flagged (creatures, lands, etc. are not);\n365\t+    * only cards in *controller*'s hand are flagged (an opponent's hand is left\n366\t+      untouched).\n367\t+\n368\t+    Calling this again refreshes the flag: cards that have left the controller's\n369\t+    hand since the last refresh have their (this-source) flag cleared so a stale\n370\t+    grant never lingers.  Returns the list of hand cards now carrying the flag.\n371\t+    \"\"\"\n372\t+    if controller is None:\n373\t+        return []\n374\t+\n375\t+    registry = _flagged_registry(game)\n376\t+    previously = registry.get(id(source), set())\n377\t+\n378\t+    hand = controller.zones[Zone.HAND]\n379\t+    granted: list[Any] = []\n380\t+    now_ids: set[int] = set()\n381\t+\n382\t+    for card in hand.get_all():\n383\t+        if not is_instant_or_sorcery(card):\n384\t+            continue\n385\t+        set_affinity_for_creatures(card, True)\n386\t+        card._affinity_grant_source = source  # type: ignore[attr-defined]\n387\t+        granted.append(card)\n388\t+        now_ids.add(id(card))\n389\t+\n390\t+    stale = previously - now_ids\n391\t+    if stale:\n392\t+        _clear_flags_for_ids(game, source, stale)\n393\t+\n394\t+    registry[id(source)] = now_ids\n395\t+    return granted\n396\t+\n397\t+\n398\t+def _clear_flags_for_ids(game: GameState, source: Any, card_ids: set[int]) -> None:\n399\t+    \"\"\"Clear *source*'s affinity flag from any card in *card_ids* across zones.\"\"\"\n400\t+    for player in game.players:\n401\t+        for zone in Zone:\n402\t+            container = player.zones[zone]\n403\t+            for card in list(container.get_all()):\n404\t+                if (\n405\t+                    id(card) in card_ids\n406\t+                    and getattr(card, \"_affinity_grant_source\", None) is source\n407\t+                ):\n408\t+                    set_affinity_for_creatures(card, False)\n409\t+\n410\t+\n411\t+def clear_affinity_flags(game: GameState, source: Any) -> None:\n412\t+    \"\"\"Clear every affinity flag *source* placed (e.g. when it leaves play).\"\"\"\n413\t+    registry = _flagged_registry(game)\n414\t+    granted = registry.pop(id(source), set())\n415\t+    if not granted:\n416\t+        return\n417\t+    _clear_flags_for_ids(game, source, granted)\n418\t+\n419\t+\n420\t+# ---------------------------------------------------------------------------\n421\t+# Granted-reduction registry — drive the granted cost reduction through the\n422\t+# cast/cost pipeline (mirrors engine.casualty / engine.miracle grant registries)\n423\t+# ---------------------------------------------------------------------------\n424\t+\n425\t+\n426\t+def _grant_registry(game: GameState) -> dict[int, dict[str, Any]]:\n427\t+    \"\"\"Return (creating if necessary) the per-game granted-reduction registry.\n428\t+\n429\t+    Maps ``id(source)`` to a record ``{\"controller\", \"applies\", \"resolver\"}``:\n430\t+\n431\t+    * ``controller`` — the player whose spells the grant applies to;\n432\t+    * ``applies`` — predicate ``(game, spell, controller) -> bool`` deciding\n433\t+      whether a given spell receives the grant (e.g. controller's instants /\n434\t+      sorceries, source on the battlefield);\n435\t+    * ``resolver`` — :data:`ReductionResolver` returning the {1}-less count for a\n436\t+      qualifying spell (for affinity for creatures: how many creatures the\n437\t+      controller controls).\n438\t+\n439\t+    Stored lazily on the game object — no ``GameState.__init__`` change.\n440\t+    \"\"\"\n441\t+    registry = getattr(game, \"_affinity_grants\", None)\n442\t+    if registry is None:\n443\t+        registry = {}\n444\t+        game._affinity_grants = registry  # type: ignore[attr-defined]\n445\t+    return registry\n446\t+\n447\t+\n448\t+def register_affinity_grant(\n449\t+    game: GameState,\n450\t+    source: Any,\n451\t+    controller: Any,\n452\t+    resolver: ReductionResolver,\n453\t+    applies: Callable[[Any, Any, Any], bool],\n454\t+) -> None:\n455\t+    \"\"\"Register *source*'s granted per-spell cost reduction (idempotent per source).\n456\t+\n457\t+    When a spell is cast, :func:`get_granted_reduction` consults every registered\n458\t+    grant whose ``applies(game, spell, controller)`` predicate returns ``True``\n459\t+    and sums each grant's ``resolver(game, spell, controller)`` contribution.\n460\t+    :func:`engine.casting.get_cost_reduction` adds that sum to the cast card's own\n461\t+    ``cost_reduction(game)`` before clamping to the spell's generic portion.\n462\t+\n463\t+    Re-registering the same source overwrites its record (so a refreshed grant\n464\t+    keeps the latest controller/resolver) — keyed by ``id(source)``.\n465\t+    \"\"\"\n466\t+    _grant_registry(game)[id(source)] = {\n467\t+        \"controller\": controller,\n468\t+        \"applies\": applies,\n469\t+        \"resolver\": resolver,\n470\t+    }\n471\t+\n472\t+\n473\t+def clear_affinity_grant(game: GameState, source: Any) -> None:\n474\t+    \"\"\"Remove *source*'s granted-reduction record (e.g. when it leaves play).\"\"\"\n475\t+    _grant_registry(game).pop(id(source), None)\n476\t+\n477\t+\n478\t+def get_granted_reduction(game: GameState, spell: Any, controller: Any) -> int:\n479\t+    \"\"\"Return the total granted generic reduction for *controller* casting *spell*.\n480\t+\n481\t+    Sums the contribution of every registered grant whose ``applies`` predicate\n482\t+    accepts ``(game, spell, controller)``.  Returns ``0`` when no grant applies —\n483\t+    so a spell with no granting permanent in play is reduced only by its own\n484\t+    ``cost_reduction`` hook (existing behaviour is unchanged).\n485\t+    \"\"\"\n486\t+    registry = getattr(game, \"_affinity_grants\", None)\n487\t+    if not registry:\n488\t+        return 0\n489\t+    total = 0\n490\t+    for record in list(registry.values()):\n491\t+        applies = record.get(\"applies\")\n492\t+        resolver = record.get(\"resolver\")\n493\t+        if resolver is None:\n494\t+            continue\n495\t+        try:\n496\t+            if applies is not None and not applies(game, spell, controller):\n497\t+                continue\n498\t+            contribution = resolver(game, spell, controller)\n499\t+        except Exception:\n500\t+            continue\n501\t+        if contribution and contribution > 0:\n502\t+            total += int(contribution)\n503\t+    return total\n504\tdiff --git a/engine/casting.py b/engine/casting.py\n505\tindex 111c40d..99bd595 100644\n506\t--- a/engine/casting.py\n507\t+++ b/engine/casting.py\n508\t@@ -89,12 +89,20 @@ def can_cast_at_instant_speed(card: CardImpl) -> bool:\n509\t def get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n510\t     \"\"\"Return the generic mana reduction for casting *card*.\n511\t \n512\t-    Queries ``card.cost_reduction(game)`` and clamps the result so that\n513\t-    the generic portion of the mana cost cannot go below 0.\n514\t-\n515\t-    This is a simplified single-card self-reduction model.  Full MTG\n516\t-    cost-reduction interactions (Trinisphere, multiple reductions from\n517\t-    different sources) are deferred.\n518\t+    Queries ``card.cost_reduction(game)`` for the card's *own* cost reduction\n519\t+    (e.g. Tolarian Terror counting instants/sorceries in your graveyard, or\n520\t+    Witherbloom's own affinity for creatures) and adds any *granted* per-spell\n521\t+    reduction another permanent contributes for this controller's spell (e.g.\n522\t+    Witherbloom granting \"affinity for creatures\" to your instants/sorceries —\n523\t+    see :mod:`engine.affinity`).  The summed reduction is clamped so that the\n524\t+    generic portion of the mana cost cannot go below 0.\n525\t+\n526\t+    When no grant is registered for this spell, the granted contribution is 0 and\n527\t+    the result is exactly the card's own clamped ``cost_reduction`` — so existing\n528\t+    cost-reduction behaviour (sos_1, fdn_167) is unaffected.\n529\t+\n530\t+    Full MTG cost-reduction interactions (Trinisphere, ordering of multiple\n531\t+    reductions from different sources) remain a simplified additive model.\n532\t     \"\"\"\n533\t     # Ensure card.controller is set so the hook can reference \"you\" / the\n534\t     # casting player even when the card was never explicitly assigned one.\n535\t@@ -104,6 +112,14 @@ def get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> i\n536\t     # Restore previous controller in case the caller doesn't want a\n537\t     # side-effect (get_cost_reduction is a query, not a mutation).\n538\t     card.controller = prev_controller\n539\t+\n540\t+    # Add any granted per-spell reduction (e.g. granted affinity for creatures)\n541\t+    # registered for this controller's spell.  With no grant registered this is\n542\t+    # 0, leaving the card's own reduction unchanged.\n543\t+    from engine.affinity import get_granted_reduction\n544\t+\n545\t+    raw += get_granted_reduction(game, card, controller)\n546\t+\n547\t     generic = card.mana_cost.generic if card.mana_cost else 0\n548\t     return max(0, min(raw, generic))\n549\t \n550\t"}]},"parent_tool_use_id":"toolu_01STkDpC5UkMTwGuV6iPmCqF","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"2d035999-23f4-4ce7-9325-fae25dcc429d","timestamp":"2026-06-02T10:00:04.186Z","subagent_type":"Reviewer","task_description":"Review sos_245 implementation"}
