{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WLgTXFG8ZbXHjZp8eMtqRX","type":"tool_result","content":"1\t\"\"\"Tests for SOS 201 — Lorehold, the Historian.\n2\t\n3\tOracle text (from card_spec.json):\n4\t\n5\t    Flying, haste\n6\t    Each instant and sorcery card in your hand has miracle {2}. (You may cast\n7\t    a card for its miracle cost when you draw it if it's the first card you\n8\t    drew this turn.)\n9\t    At the beginning of each opponent's upkeep, you may discard a card. If you\n10\t    do, draw a card.\n11\t\n12\tBehaviour contract derived from that text:\n13\t\n14\t* Static: Legendary Creature — Elder Dragon, {3}{R}{W}, 5/5, red+white, with\n15\t  Flying and Haste.\n16\t* Miracle-granting static ability: while Lorehold is on the battlefield, every\n17\t  instant and sorcery card in its controller's hand \"has miracle {2}\". There is\n18\t  no engine-level miracle pipeline, so the implementation must expose some\n19\t  observable surface that reports the miracle cost ({2}) for an instant/sorcery\n20\t  in the controller's hand (and grants it to no other cards / no other\n21\t  players). These tests probe that surface tolerantly: they accept any of the\n22\t  conventional spellings the implementer is likely to use, and skip-with-reason\n23\t  only if none exists. The \"cast it when you draw it\" timing is recorded in\n24\t  untestable.json (no engine draw-time cast hook exists).\n25\t* Upkeep trigger: a ``BeginningOfUpkeepTriggeredEvent`` trigger that fires only\n26\t  on an OPPONENT's upkeep (not the controller's own upkeep). It is optional\n27\t  (\"you may discard a card\"); if a card is discarded the controller draws a\n28\t  card. Declining discards nothing and draws nothing. With an empty hand there\n29\t  is nothing to discard, so nothing is drawn.\n30\t\n31\tThese tests are written for the TDD red phase: they must FAIL against the empty\n32\tstub and PASS once the card is implemented correctly.\n33\t\"\"\"\n34\t\n35\tfrom __future__ import annotations\n36\t\n37\tfrom typing import Any\n38\t\n39\timport pytest\n40\t\n41\tfrom cards.sos.sos_201.card_impl import LoreholdTheHistorian\n42\tfrom engine.card import Creature, Instant, Sorcery\n43\tfrom engine.events import BeginningOfUpkeepTriggeredEvent\n44\tfrom engine.triggers import TriggerRegistration\n45\tfrom engine.types import CardType, Keyword, ManaCost, Supertype, Zone\n46\tfrom test_utils import create_game, set_board_state\n47\t\n48\t\n49\t# ---------------------------------------------------------------------------\n50\t# Test helper cards\n51\t# ---------------------------------------------------------------------------\n52\t\n53\t\n54\tdef _vanilla_instant(name: str = \"Test Instant\") -> Instant:\n55\t    return Instant(name=name, mana_cost=ManaCost.parse(\"{1}{R}\"))\n56\t\n57\t\n58\tdef _vanilla_sorcery(name: str = \"Test Sorcery\") -> Sorcery:\n59\t    return Sorcery(name=name, mana_cost=ManaCost.parse(\"{2}{B}\"))\n60\t\n61\t\n62\tdef _vanilla_creature(name: str = \"Test Bear\") -> Creature:\n63\t    return Creature(\n64\t        name=name,\n65\t        mana_cost=ManaCost.parse(\"{1}{G}\"),\n66\t        base_power=2,\n67\t        base_toughness=2,\n68\t    )\n69\t\n70\t\n71\tdef _resolve_full_stack(game: Any) -> None:\n72\t    \"\"\"Resolve every object currently on the stack, top-down.\"\"\"\n73\t    from engine.state_based_actions import resolve_state_based_actions\n74\t\n75\t    while not game.stack.is_empty():\n76\t        obj = game.stack.pop()\n77\t        obj.on_resolve(game)\n78\t        resolve_state_based_actions(game)\n79\t\n80\t\n81\tdef _miracle_cost_for(card_obj: Any, game: Any, hand_card: Any) -> Any:\n82\t    \"\"\"Best-effort probe for the granted miracle cost of *hand_card*.\n83\t\n84\t    The miracle mechanic has no engine pipeline, so the implementation is free\n85\t    to surface the granted cost in a number of conventional ways. This helper\n86\t    tries each in turn and returns the reported cost, or raises\n87\t    ``pytest.skip`` if no recognised surface exists (so the contract is not\n88\t    silently green).\n89\t    \"\"\"\n90\t    # 1. A method on the Lorehold card that reports the miracle cost it grants\n91\t    #    to a given hand card.\n92\t    for meth_name in (\"miracle_cost_for\", \"get_miracle_cost\", \"miracle_cost\"):\n93\t        meth = getattr(card_obj, meth_name, None)\n94\t        if callable(meth):\n95\t            try:\n96\t                return meth(game, hand_card)\n97\t            except TypeError:\n98\t                try:\n99\t                    return meth(hand_card)\n100\t                except TypeError:\n101\t                    continue\n102\t    # 2. The grant written directly onto the hand card.\n103\t    for attr_name in (\"miracle_cost\", \"granted_miracle_cost\", \"miracle\"):\n104\t        val = getattr(hand_card, attr_name, None)\n105\t        if val is not None:\n106\t            return val\n107\t    pytest.skip(\n108\t        \"No observable surface for the granted miracle cost — implementation \"\n109\t        \"must expose miracle_cost_for(...)/get_miracle_cost(...) on the card \"\n110\t        \"or a miracle_cost attribute on the affected hand card.\"\n111\t    )\n112\t\n113\t\n114\tdef _coerce_to_two(value: Any) -> bool:\n115\t    \"\"\"Return True if *value* represents a mana value / cost of {2}.\"\"\"\n116\t    if value is None:\n117\t        return False\n118\t    if isinstance(value, ManaCost):\n119\t        return value.cmc == 2 and value.generic == 2\n120\t    if isinstance(value, int):\n121\t        return value == 2\n122\t    # A string spelling like \"{2}\".\n123\t    if isinstance(value, str):\n124\t        try:\n125\t            return ManaCost.parse(value).cmc == 2\n126\t        except Exception:\n127\t            return False\n128\t    # Fallback: anything exposing a .cmc.\n129\t    cmc = getattr(value, \"cmc\", None)\n130\t    return cmc == 2\n131\t\n132\t\n133\t# ---------------------------------------------------------------------------\n134\t# Static card data\n135\t# ---------------------------------------------------------------------------\n136\t\n137\t\n138\tclass TestLoreholdProperties:\n139\t    \"\"\"Static characteristics must match the SOS 201 spec.\"\"\"\n140\t\n141\t    def test_is_creature(self) -> None:\n142\t        assert isinstance(LoreholdTheHistorian(owner=None), Creature)\n143\t\n144\t    def test_name(self) -> None:\n145\t        assert LoreholdTheHistorian(owner=None).name == \"Lorehold, the Historian\"\n146\t\n147\t    def test_mana_cost(self) -> None:\n148\t        assert LoreholdTheHistorian(owner=None).mana_cost == ManaCost.parse(\"{3}{R}{W}\")\n149\t\n150\t    def test_mana_value_is_five(self) -> None:\n151\t        assert LoreholdTheHistorian(owner=None).mana_cost.cmc == 5\n152\t\n153\t    def test_power_toughness(self) -> None:\n154\t        card = LoreholdTheHistorian(owner=None)\n155\t        assert card.base_power == 5\n156\t        assert card.base_toughness == 5\n157\t\n158\t    def test_is_legendary(self) -> None:\n159\t        assert Supertype.LEGENDARY in LoreholdTheHistorian(owner=None).supertypes\n160\t\n161\t    def test_is_elder_dragon(self) -> None:\n162\t        subtypes = LoreholdTheHistorian(owner=None).subtypes\n163\t        assert \"Dragon\" in subtypes\n164\t        assert \"Elder\" in subtypes\n165\t\n166\t    def test_has_flying(self) -> None:\n167\t        assert Keyword.FLYING in LoreholdTheHistorian(owner=None).keywords\n168\t\n169\t    def test_has_haste(self) -> None:\n170\t        assert Keyword.HASTE in LoreholdTheHistorian(owner=None).keywords\n171\t\n172\t    def test_is_red_white(self) -> None:\n173\t        \"\"\"{3}{R}{W} has exactly one red and one white pip and no others.\"\"\"\n174\t        cost = LoreholdTheHistorian(owner=None).mana_cost\n175\t        from engine.types import ManaType\n176\t\n177\t        assert cost.pips.get(ManaType.RED, 0) == 1\n178\t        assert cost.pips.get(ManaType.WHITE, 0) == 1\n179\t        assert cost.pips.get(ManaType.BLUE, 0) == 0\n180\t        assert cost.pips.get(ManaType.BLACK, 0) == 0\n181\t        assert cost.pips.get(ManaType.GREEN, 0) == 0\n182\t\n183\t\n184\t# ---------------------------------------------------------------------------\n185\t# Upkeep trigger registration\n186\t# ---------------------------------------------------------------------------\n187\t\n188\t\n189\tclass TestLoreholdUpkeepTriggerRegistration:\n190\t    \"\"\"register_triggers wires exactly one BeginningOfUpkeepTriggeredEvent\n191\t    trigger for the loot-on-each-opponent's-upkeep ability.\"\"\"\n192\t\n193\t    def test_registers_an_upkeep_trigger(self) -> None:\n194\t        game = create_game()\n195\t        p1 = game.players[0]\n196\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n197\t        regs_before = len(game.trigger_manager.get_triggers())\n198\t        card.register_triggers(game)\n199\t        regs_after = len(game.trigger_manager.get_triggers())\n200\t        assert regs_after > regs_before\n201\t\n202\t    def test_trigger_watches_upkeep_event(self) -> None:\n203\t        game = create_game()\n204\t        p1 = game.players[0]\n205\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n206\t        card.register_triggers(game)\n207\t        regs = game.trigger_manager.get_triggers_for_source(card)\n208\t        upkeep_regs = [\n209\t            r for r in regs if r.event_type is BeginningOfUpkeepTriggeredEvent\n210\t        ]\n211\t        assert len(upkeep_regs) == 1\n212\t        assert isinstance(upkeep_regs[0], TriggerRegistration)\n213\t\n214\t\n215\t# ---------------------------------------------------------------------------\n216\t# Upkeep trigger: \"each opponent's upkeep\" timing\n217\t# ---------------------------------------------------------------------------\n218\t\n219\t\n220\tclass TestLoreholdUpkeepTiming:\n221\t    \"\"\"The trigger fires only during an OPPONENT's upkeep, not the\n222\t    controller's own.\"\"\"\n223\t\n224\t    def _setup(self):\n225\t        game = create_game()\n226\t        p1 = game.players[0]\n227\t        p2 = game.players[1]\n228\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n229\t        set_board_state(game, 0, battlefield=[card])\n230\t        card.register_triggers(game)\n231\t        return game, p1, p2, card\n232\t\n233\t    def test_does_not_fire_on_controllers_own_upkeep(self) -> None:\n234\t        \"\"\"When the controller (p1) is the active player, p1's own upkeep must\n235\t        NOT put Lorehold's loot trigger on the stack.\n236\t\n237\t        To distinguish a correctly-conditioned trigger from a missing one, we\n238\t        first confirm (in ``test_fires_on_opponents_upkeep``) that the trigger\n239\t        exists and fires on an opponent's upkeep. Here we additionally require\n240\t        that an upkeep trigger is registered, so an empty stub (which registers\n241\t        nothing) fails rather than vacuously passing.\"\"\"\n242\t        game, p1, p2, card = self._setup()\n243\t        upkeep_regs = [\n244\t            r\n245\t            for r in game.trigger_manager.get_triggers_for_source(card)\n246\t            if r.event_type is BeginningOfUpkeepTriggeredEvent\n247\t        ]\n248\t        assert len(upkeep_regs) == 1, \"Lorehold must register an upkeep trigger\"\n249\t\n250\t        game.active_player_index = 0  # controller's own upkeep\n251\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n252\t        assert game.stack.is_empty()\n253\t\n254\t    def test_fires_on_opponents_upkeep(self) -> None:\n255\t        \"\"\"When an opponent (p2) is the active player, the loot trigger goes on\n256\t        the stack under the controller's control.\"\"\"\n257\t        game, p1, p2, card = self._setup()\n258\t        game.active_player_index = 1  # opponent's upkeep\n259\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n260\t        assert not game.stack.is_empty()\n261\t        assert game.stack.peek().controller is p1\n262\t\n263\t\n264\t# ---------------------------------------------------------------------------\n265\t# Upkeep trigger: discard-then-draw effect\n266\t# ---------------------------------------------------------------------------\n267\t\n268\t\n269\tclass TestLoreholdLootEffect:\n270\t    \"\"\"Resolving the opponent's-upkeep trigger lets the controller optionally\n271\t    discard a card and, if they do, draw a card.\"\"\"\n272\t\n273\t    def _setup_opponent_upkeep(\n274\t        self, *, hand: list[Any], library: list[Any], yes: bool, discard_target: Any\n275\t    ):\n276\t        \"\"\"Build a game with Lorehold on p1's battlefield, p1's hand and\n277\t        library populated, fire an opponent's-upkeep event, and script p1's\n278\t        optional choices.\n279\t\n280\t        DeterministicPlayer pops answers in order; the implementation may ask a\n281\t        yes/no (\"may discard\") and a card choice (which card to discard). We\n282\t        feed a permissive script so whichever methods it calls are satisfied.\n283\t        \"\"\"\n284\t        game = create_game()\n285\t        p1 = game.players[0]\n286\t        p2 = game.players[1]\n287\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n288\t        set_board_state(game, 0, battlefield=[card], hand=hand)\n289\t        # Populate p1's library so a draw has something to fetch.\n290\t        lib = game.get_library(p1)\n291\t        for obj in lib.get_all():\n292\t            lib.remove(obj)\n293\t        for c in library:\n294\t            c.owner = p1\n295\t            c.controller = p1\n296\t            lib.add(c)\n297\t        card.register_triggers(game)\n298\t        game.active_player_index = 1  # opponent's upkeep\n299\t\n300\t        # Script: yes/no, then which card to discard (and a spare copy in case\n301\t        # the implementation re-asks).\n302\t        p1._script.extend([yes, discard_target, discard_target])\n303\t\n304\t        # Fire the opponent's-upkeep event. The loot trigger must go on the\n305\t        # stack — otherwise the card has no effect at all (empty stub) and the\n306\t        # no-op assertions below would pass vacuously.\n307\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n308\t        assert not game.stack.is_empty(), (\n309\t            \"Lorehold's loot ability must trigger on an opponent's upkeep\"\n310\t        )\n311\t        return game, p1, p2, card\n312\t\n313\t    def test_discard_then_draw_on_yes(self) -> None:\n314\t        \"\"\"Saying yes discards the chosen hand card and draws the top of\n315\t        library. Net hand size is unchanged (one out, one in) but the drawn\n316\t        card and discarded card are different objects in their new zones.\"\"\"\n317\t        to_discard = _vanilla_instant(\"Discard Me\")\n318\t        drawn = _vanilla_creature(\"Draw Me\")\n319\t        game, p1, p2, card = self._setup_opponent_upkeep(\n320\t            hand=[to_discard], library=[drawn], yes=True, discard_target=to_discard\n321\t        )\n322\t        _resolve_full_stack(game)\n323\t\n324\t        # The discarded card is now in the graveyard.\n325\t        assert game.get_graveyard(p1).contains(to_discard)\n326\t        # The drawn card moved from library to hand.\n327\t        assert game.get_hand(p1).contains(drawn)\n328\t        assert not game.get_library(p1).contains(drawn)\n329\t\n330\t    def test_decline_discards_and_draws_nothing(self) -> None:\n331\t        \"\"\"Saying no leaves the hand card in hand and draws nothing.\"\"\"\n332\t        keep = _vanilla_instant(\"Keep Me\")\n333\t        top = _vanilla_creature(\"Stay In Library\")\n334\t        game, p1, p2, card = self._setup_opponent_upkeep(\n335\t            hand=[keep], library=[top], yes=False, discard_target=keep\n336\t        )\n337\t        _resolve_full_stack(game)\n338\t\n339\t        # Nothing discarded, nothing drawn.\n340\t        assert game.get_hand(p1).contains(keep)\n341\t        assert not game.get_graveyard(p1).contains(keep)\n342\t        assert game.get_library(p1).contains(top)\n343\t        assert not game.get_hand(p1).contains(top)\n344\t\n345\t    def test_empty_hand_is_a_noop(self) -> None:\n346\t        \"\"\"With no cards to discard, the controller cannot pay the 'if you do'\n347\t        cost, so no draw happens and resolution does not raise.\"\"\"\n348\t        top = _vanilla_creature(\"Stay In Library\")\n349\t        game, p1, p2, card = self._setup_opponent_upkeep(\n350\t            hand=[], library=[top], yes=True, discard_target=None\n351\t        )\n352\t        _resolve_full_stack(game)\n353\t\n354\t        # Hand is still empty (nothing was drawn, because nothing was discarded).\n355\t        assert len(game.get_hand(p1).get_all()) == 0\n356\t        assert game.get_library(p1).contains(top)\n357\t\n358\t    def test_draw_is_conditional_on_discard(self) -> None:\n359\t        \"\"\"The draw is gated on the discard happening ('If you do'). When the\n360\t        controller declines, the library is untouched (no draw).\"\"\"\n361\t        keep = _vanilla_sorcery(\"Keep Me\")\n362\t        top = _vanilla_creature(\"Top Card\")\n363\t        game, p1, p2, card = self._setup_opponent_upkeep(\n364\t            hand=[keep], library=[top], yes=False, discard_target=keep\n365\t        )\n366\t        lib_size_before = len(game.get_library(p1).get_all())\n367\t        _resolve_full_stack(game)\n368\t        assert len(game.get_library(p1).get_all()) == lib_size_before\n369\t\n370\t\n371\t# ---------------------------------------------------------------------------\n372\t# Miracle-granting static ability\n373\t# ---------------------------------------------------------------------------\n374\t\n375\t\n376\tclass TestLoreholdMiracleGrant:\n377\t    \"\"\"While on the battlefield, Lorehold grants miracle {2} to each instant\n378\t    and sorcery card in its controller's hand.\"\"\"\n379\t\n380\t    def _setup(self, controller_hand: list[Any], opp_hand: list[Any] | None = None):\n381\t        game = create_game()\n382\t        p1 = game.players[0]\n383\t        p2 = game.players[1]\n384\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n385\t        set_board_state(game, 0, battlefield=[card], hand=controller_hand)\n386\t        if opp_hand is not None:\n387\t            set_board_state(game, 1, hand=opp_hand)\n388\t        # Apply continuous effects if the engine maintains them, so a\n389\t        # layer-based implementation has a chance to write its grant.\n390\t        if hasattr(game, \"effect_manager\"):\n391\t            card.register_replacement_effects(game)\n392\t            card.register_triggers(game)\n393\t            try:\n394\t                game.effect_manager.apply_all(game)\n395\t            except Exception:\n396\t                pass\n397\t        return game, p1, p2, card\n398\t\n399\t    def test_instant_in_hand_gets_miracle_two(self) -> None:\n400\t        spell = _vanilla_instant(\"Hand Instant\")\n401\t        game, p1, p2, card = self._setup([spell])\n402\t        cost = _miracle_cost_for(card, game, spell)\n403\t        assert _coerce_to_two(cost)\n404\t\n405\t    def test_sorcery_in_hand_gets_miracle_two(self) -> None:\n406\t        spell = _vanilla_sorcery(\"Hand Sorcery\")\n407\t        game, p1, p2, card = self._setup([spell])\n408\t        cost = _miracle_cost_for(card, game, spell)\n409\t        assert _coerce_to_two(cost)\n410\t\n411\t    def test_creature_in_hand_does_not_get_miracle(self) -> None:\n412\t        \"\"\"A creature card is neither an instant nor a sorcery, so it is not\n413\t        granted miracle. We anchor on a real instant first (via the probe,\n414\t        which skips if no surface exists) so this fails on an empty stub\n415\t        rather than passing vacuously, then assert the creature is excluded.\"\"\"\n416\t        bear = _vanilla_creature(\"Hand Bear\")\n417\t        anchor = _vanilla_instant(\"Anchor Instant\")\n418\t        game, p1, p2, card = self._setup([anchor, bear])\n419\t        # Anchor: confirm the grant surface exists and reports {2} for the\n420\t        # instant. If no surface exists, _miracle_cost_for skips the test.\n421\t        assert _coerce_to_two(_miracle_cost_for(card, game, anchor))\n422\t        # The creature must NOT be granted miracle {2}.\n423\t        assert not _coerce_to_two(self._probe_silent(card, game, bear))\n424\t\n425\t    def test_opponents_spell_does_not_get_miracle(self) -> None:\n426\t        \"\"\"Only cards in YOUR hand are granted miracle — an instant in the\n427\t        opponent's hand is unaffected. Anchored on a controller-hand instant so\n428\t        the test fails on an empty stub rather than passing vacuously.\"\"\"\n429\t        opp_spell = _vanilla_instant(\"Opp Instant\")\n430\t        my_spell = _vanilla_instant(\"My Instant\")\n431\t        game, p1, p2, card = self._setup([my_spell], opp_hand=[opp_spell])\n432\t        # Anchor: my own instant gets miracle {2} (skips if no surface exists).\n433\t        assert _coerce_to_two(_miracle_cost_for(card, game, my_spell))\n434\t        # The opponent's instant must NOT be granted miracle.\n435\t        assert not _coerce_to_two(self._probe_silent(card, game, opp_spell))\n436\t\n437\t    @staticmethod\n438\t    def _probe_silent(card_obj: Any, game: Any, hand_card: Any) -> Any:\n439\t        \"\"\"Like ``_miracle_cost_for`` but returns None instead of skipping\n440\t        when no recognised surface reports a cost for *hand_card*.\"\"\"\n441\t        for meth_name in (\"miracle_cost_for\", \"get_miracle_cost\", \"miracle_cost\"):\n442\t            meth = getattr(card_obj, meth_name, None)\n443\t            if callable(meth):\n444\t                try:\n445\t                    return meth(game, hand_card)\n446\t                except TypeError:\n447\t                    try:\n448\t                        return meth(hand_card)\n449\t                    except TypeError:\n450\t                        continue\n451\t        for attr_name in (\"miracle_cost\", \"granted_miracle_cost\", \"miracle\"):\n452\t            val = getattr(hand_card, attr_name, None)\n453\t            if val is not None:\n454\t                return val\n455\t        return None\n456\t"}]},"parent_tool_use_id":"toolu_01KJbA7QyF9c3QV9RxaZh8H1","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"7b0f44f4-e422-46ef-87e9-379031e7b628","timestamp":"2026-06-02T09:15:26.424Z","subagent_type":"Tester","task_description":"Extend tests for sos_201 miracle draw"}
