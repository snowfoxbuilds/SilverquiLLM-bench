{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BbqbkM88tJ9y2ENCMB7uzA","type":"tool_result","content":"1\t\"\"\"Tests for engine/zones.py — move_to_zone() centralized zone-transition hooks.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom typing import Any\n4\timport types\n5\timport pytest\n6\tfrom engine.card import CardImpl, Creature, Enchantment\n7\tfrom engine.events import CreatureDiesReplacementEvent, CreatureDiesTriggeredEvent, EntersBattlefieldTriggeredEvent, LeavesBattlefieldTriggeredEvent, BeginningOfUpkeepTriggeredEvent, TriggeredEvent\n8\tfrom engine.replacement_effects import ReplacementEffect\n9\tfrom engine.triggers import TriggerRegistration\n10\tfrom engine.types import CardType, Zone\n11\tfrom test_utils import create_game, set_board_state\n12\t\n13\tdef _make_creature(name: str='TestCreature', power: int=2, toughness: int=2) -> Creature:\n14\t    return Creature(name=name, base_power=power, base_toughness=toughness)\n15\t\n16\tdef _make_enchantment(name: str='TestEnchantment') -> Enchantment:\n17\t    return Enchantment(name=name)\n18\t\n19\tdef _make_token_creature(name: str='TokenCreature', power: int=1, toughness: int=1) -> Creature:\n20\t    token = Creature(name=name, base_power=power, base_toughness=toughness)\n21\t    token.is_token = True\n22\t    return token\n23\t\n24\tdef _record_events(game: Any) -> list[TriggeredEvent]:\n25\t    \"\"\"Monkey-patch the trigger manager to record all fired events.\"\"\"\n26\t    original_fire = game.trigger_manager.fire_event.__func__\n27\t    recorded: list[TriggeredEvent] = []\n28\t\n29\t    def recording_fire(self: Any, game: Any, event: TriggeredEvent) -> None:\n30\t        recorded.append(event)\n31\t        original_fire(self, game, event)\n32\t    game.trigger_manager.fire_event = types.MethodType(recording_fire, game.trigger_manager)\n33\t    return recorded\n34\t\n35\tclass TestMoveToZoneBounce:\n36\t    \"\"\"Bounce a creature from battlefield to hand.\"\"\"\n37\t\n38\t    def test_bounce_removes_from_battlefield_adds_to_hand(self) -> None:\n39\t        from engine.zones import move_to_zone\n40\t        game = create_game()\n41\t        creature = _make_creature('Bouncee')\n42\t        player = game.players[0]\n43\t        set_board_state(game, 0, battlefield=[creature])\n44\t        move_to_zone(game, creature, Zone.BATTLEFIELD, Zone.HAND)\n45\t        assert not player.zones[Zone.BATTLEFIELD].contains(creature)\n46\t        assert player.zones[Zone.HAND].contains(creature)\n47\t\n48\t    def test_bounce_fires_leaves_battlefield(self) -> None:\n49\t        from engine.zones import move_to_zone\n50\t        game = create_game()\n51\t        creature = _make_creature('Bouncee')\n52\t        set_board_state(game, 0, battlefield=[creature])\n53\t        recorded = _record_events(game)\n54\t        move_to_zone(game, creature, Zone.BATTLEFIELD, Zone.HAND)\n55\t        assert any((isinstance(e, LeavesBattlefieldTriggeredEvent) for e in recorded))\n56\t\n57\t    def test_bounce_does_not_fire_creature_dies(self) -> None:\n58\t        from engine.zones import move_to_zone\n59\t        game = create_game()\n60\t        creature = _make_creature('Bouncee')\n61\t        set_board_state(game, 0, battlefield=[creature])\n62\t        recorded = _record_events(game)\n63\t        move_to_zone(game, creature, Zone.BATTLEFIELD, Zone.HAND)\n64\t        assert not any((isinstance(e, CreatureDiesTriggeredEvent) for e in recorded))\n65\t\n66\t    def test_bounce_unregisters_triggers(self) -> None:\n67\t        from engine.zones import move_to_zone\n68\t        game = create_game()\n69\t        creature = _make_creature('Bouncee')\n70\t        player = game.players[0]\n71\t        set_board_state(game, 0, battlefield=[creature])\n72\t        trigger = TriggerRegistration(event_type=BeginningOfUpkeepTriggeredEvent, condition=None, effect=lambda g: None, source=creature, controller=player)\n73\t        game.trigger_manager.register(trigger)\n74\t        assert len(game.trigger_manager.get_triggers_for_source(creature)) == 1\n75\t        move_to_zone(game, creature, Zone.BATTLEFIELD, Zone.HAND)\n76\t        assert len(game.trigger_manager.get_triggers_for_source(creature)) == 0\n77\t\n78\t    def test_bounce_unregisters_replacement_effects(self) -> None:\n79\t        from engine.zones import move_to_zone\n80\t        game = create_game()\n81\t        creature = _make_creature('Bouncee')\n82\t        player = game.players[0]\n83\t        set_board_state(game, 0, battlefield=[creature])\n84\t        repl = ReplacementEffect(event_type=CreatureDiesReplacementEvent, source=creature, condition=None, replacement=lambda g, event: event, controller=player)\n85\t        game.replacement_manager.register(repl)\n86\t        move_to_zone(game, creature, Zone.BATTLEFIELD, Zone.HAND)\n87\t        remaining = [r for r in game.replacement_manager._effects if r.source is creature]\n88\t        assert len(remaining) == 0\n89\t\n90\tclass TestMoveToZoneETB:\n91\t    \"\"\"Enter the battlefield: hand to battlefield.\"\"\"\n92\t\n93\t    def test_etb_fires_enters_battlefield(self) -> None:\n94\t        from engine.zones import move_to_zone\n95\t        game = create_game()\n96\t        creature = _make_creature('ETBCreature')\n97\t        set_board_state(game, 0, hand=[creature])\n98\t        recorded = _record_events(game)\n99\t        move_to_zone(game, creature, Zone.HAND, Zone.BATTLEFIELD)\n100\t        assert any((isinstance(e, EntersBattlefieldTriggeredEvent) for e in recorded))\n101\t\n102\t    def test_etb_calls_register_triggers(self) -> None:\n103\t        from engine.zones import move_to_zone\n104\t        game = create_game()\n105\t        registered = []\n106\t\n107\t        class TriggerCreature(Creature):\n108\t\n109\t            def register_triggers(self, game: Any) -> None:\n110\t                registered.append(True)\n111\t        creature = TriggerCreature(name='TriggerBear', base_power=2, base_toughness=2)\n112\t        set_board_state(game, 0, hand=[creature])\n113\t        move_to_zone(game, creature, Zone.HAND, Zone.BATTLEFIELD)\n114\t        assert len(registered) == 1\n115\t\n116\t    def test_etb_calls_register_replacement_effects(self) -> None:\n117\t        from engine.zones import move_to_zone\n118\t        game = create_game()\n119\t        registered = []\n120\t\n121\t        class ReplCreature(Creature):\n122\t\n123\t            def register_replacement_effects(self, game: Any) -> None:\n124\t                registered.append(True)\n125\t        creature = ReplCreature(name='ReplBear', base_power=2, base_toughness=2)\n126\t        set_board_state(game, 0, hand=[creature])\n127\t        move_to_zone(game, creature, Zone.HAND, Zone.BATTLEFIELD)\n128\t        assert len(registered) == 1\n129\t\n130\t    def test_etb_adds_to_battlefield(self) -> None:\n131\t        from engine.zones import move_to_zone\n132\t        game = create_game()\n133\t        creature = _make_creature('ETBCreature')\n134\t        player = game.players[0]\n135\t        set_board_state(game, 0, hand=[creature])\n136\t        move_to_zone(game, creature, Zone.HAND, Zone.BATTLEFIELD)\n137\t        assert player.zones[Zone.BATTLEFIELD].contains(creature)\n138\t        assert not player.zones[Zone.HAND].contains(creature)\n139\t\n140\tclass TestMoveToZoneDeath:\n141\t    \"\"\"Creature dying: battlefield to graveyard.\"\"\"\n142\t\n143\t    def test_death_fires_leaves_battlefield(self) -> None:\n144\t        from engine.zones import move_to_zone\n145\t        game = create_game()\n146\t        creature = _make_creature('DyingCreature')\n147\t        set_board_state(game, 0, battlefield=[creature])\n148\t        recorded = _record_events(game)\n149\t        move_to_zone(game, creature, Zone.BATTLEFIELD, Zone.GRAVEYARD)\n150\t        assert any((isinstance(e, LeavesBattlefieldTriggeredEvent) for e in recorded))\n151\t\n152\t    def test_death_fires_creature_dies(self) -> None:\n153\t        from engine.zones import move_to_zone\n154\t        game = create_game()\n155\t        creature = _make_creature('DyingCreature')\n156\t        set_board_state(game, 0, battlefield=[creature])\n157\t        recorded = _record_events(game)\n158\t        move_to_zone(game, creature, Zone.BATTLEFIELD, Zone.GRAVEYARD)\n159\t        assert any((isinstance(e, CreatureDiesTriggeredEvent) for e in recorded))\n160\t\n161\t    def test_death_fires_events_before_unregister(self) -> None:\n162\t        from engine.zones import move_to_zone\n163\t        game = create_game()\n164\t        creature = _make_creature('DyingCreature')\n165\t        player = game.players[0]\n166\t        set_board_state(game, 0, battlefield=[creature])\n167\t        death_trigger_fired = []\n168\t\n169\t        def death_condition(game: Any, event: CreatureDiesTriggeredEvent) -> bool:\n170\t            return event.creature is creature\n171\t\n172\t        def death_effect(game: Any) -> None:\n173\t            death_trigger_fired.append(True)\n174\t        trigger = TriggerRegistration(event_type=CreatureDiesTriggeredEvent, condition=death_condition, effect=death_effect, source=creature, controller=player)\n175\t        game.trigger_manager.register(trigger)\n176\t        move_to_zone(game, creature, Zone.BATTLEFIELD, Zone.GRAVEYARD)\n177\t        assert not game.stack.is_empty() or len(death_trigger_fired) > 0\n178\t        assert len(game.trigger_manager.get_triggers_for_source(creature)) == 0\n179\t\n180\t    def test_death_card_ends_in_graveyard(self) -> None:\n181\t        from engine.zones import move_to_zone\n182\t        game = create_game()\n183\t        creature = _make_creature('DyingCreature')\n184\t        player = game.players[0]\n185\t        set_board_state(game, 0, battlefield=[creature])\n186\t        move_to_zone(game, creature, Zone.BATTLEFIELD, Zone.GRAVEYARD)\n187\t        assert player.zones[Zone.GRAVEYARD].contains(creature)\n188\t        assert not player.zones[Zone.BATTLEFIELD].contains(creature)\n189\t\n190\tclass TestMoveToZoneExile:\n191\t    \"\"\"Exile a creature: battlefield to exile.\"\"\"\n192\t\n193\t    def test_exile_fires_leaves_battlefield(self) -> None:\n194\t        from engine.zones import move_to_zone\n195\t        game = create_game()\n196\t        creature = _make_creature('ExiledCreature')\n197\t        set_board_state(game, 0, battlefield=[creature])\n198\t        recorded = _record_events(game)\n199\t        move_to_zone(game, creature, Zone.BATTLEFIELD, Zone.EXILE)\n200\t        assert any((isinstance(e, LeavesBattlefieldTriggeredEvent) for e in recorded))\n201\t\n202\t    def test_exile_does_not_fire_creature_dies(self) -> None:\n203\t        from engine.zones import move_to_zone\n204\t        game = create_game()\n205\t        creature = _make_creature('ExiledCreature')\n206\t        set_board_state(game, 0, battlefield=[creature])\n207\t        recorded = _record_events(game)\n208\t        move_to_zone(game, creature, Zone.BATTLEFIELD, Zone.EXILE)\n209\t        assert not any((isinstance(e, CreatureDiesTriggeredEvent) for e in recorded))\n210\t\n211\t    def test_exile_moves_to_exile_zone(self) -> None:\n212\t        from engine.zones import move_to_zone\n213\t        game = create_game()\n214\t        creature = _make_creature('ExiledCreature')\n215\t        player = game.players[0]\n216\t        set_board_state(game, 0, battlefield=[creature])\n217\t        move_to_zone(game, creature, Zone.BATTLEFIELD, Zone.EXILE)\n218\t        assert player.zones[Zone.EXILE].contains(creature)\n219\t        assert not player.zones[Zone.BATTLEFIELD].contains(creature)\n220\t\n221\tclass TestMoveToZoneReplacementRedirection:\n222\t    \"\"\"Replacement effect redirects graveyard destination to exile.\"\"\"\n223\t\n224\t    def _make_repl_event(self, game: Any, creature: Any) -> CreatureDiesReplacementEvent:\n225\t        player = game.players[0]\n226\t        return CreatureDiesReplacementEvent(creature=creature, destination='graveyard', controller=player, owner=player)\n227\t\n228\t    def test_replacement_redirects_to_exile(self) -> None:\n229\t        from engine.zones import move_to_zone\n230\t        game = create_game()\n231\t        creature = _make_creature('RedirectedCreature')\n232\t        player = game.players[0]\n233\t        set_board_state(game, 0, battlefield=[creature])\n234\t\n235\t        def redirect_to_exile(game: Any, event: CreatureDiesReplacementEvent) -> CreatureDiesReplacementEvent:\n236\t            event.destination = 'exile'\n237\t            return event\n238\t        repl = ReplacementEffect(event_type=CreatureDiesReplacementEvent, source=creature, condition=None, replacement=redirect_to_exile, controller=player)\n239\t        game.replacement_manager.register(repl)\n240\t        move_to_zone(game, creature, Zone.BATTLEFIELD, Zone.GRAVEYARD, replacement_event=self._make_repl_event(game, creature))\n241\t        assert player.zones[Zone.EXILE].contains(creature)\n242\t        assert not player.zones[Zone.GRAVEYARD].contains(creature)\n243\t\n244\t    def test_replacement_redirect_suppresses_creature_dies(self) -> None:\n245\t        from engine.zones import move_to_zone\n246\t        game = create_game()\n247\t        creature = _make_creature('RedirectedCreature')\n248\t        player = game.players[0]\n249\t        set_board_state(game, 0, battlefield=[creature])\n250\t\n251\t        def redirect_to_exile(game: Any, event: CreatureDiesReplacementEvent) -> CreatureDiesReplacementEvent:\n252\t            event.destination = 'exile'\n253\t            return event\n254\t        repl = ReplacementEffect(event_type=CreatureDiesReplacementEvent, source=creature, condition=None, replacement=redirect_to_exile, controller=player)\n255\t        game.replacement_manager.register(repl)\n256\t        recorded = _record_events(game)\n257\t        move_to_zone(game, creature, Zone.BATTLEFIELD, Zone.GRAVEYARD, replacement_event=self._make_repl_event(game, creature))\n258\t        assert not any((isinstance(e, CreatureDiesTriggeredEvent) for e in recorded))\n259\t\n260\t    def test_replacement_redirect_still_fires_leaves_battlefield(self) -> None:\n261\t        from engine.zones import move_to_zone\n262\t        game = create_game()\n263\t        creature = _make_creature('RedirectedCreature')\n264\t        player = game.players[0]\n265\t        set_board_state(game, 0, battlefield=[creature])\n266\t\n267\t        def redirect_to_exile(game: Any, event: CreatureDiesReplacementEvent) -> CreatureDiesReplacementEvent:\n268\t            event.destination = 'exile'\n269\t            return event\n270\t        repl = ReplacementEffect(event_type=CreatureDiesReplacementEvent, source=creature, condition=None, replacement=redirect_to_exile, controller=player)\n271\t        game.replacement_manager.register(repl)\n272\t        recorded = _record_events(game)\n273\t        move_to_zone(game, creature, Zone.BATTLEFIELD, Zone.GRAVEYARD, replacement_event=self._make_repl_event(game, creature))\n274\t        assert any((isinstance(e, LeavesBattlefieldTriggeredEvent) for e in recorded))\n275\t\n276\tclass TestMoveToZoneNonCreature:\n277\t    \"\"\"Non-creature permanent leaving battlefield.\"\"\"\n278\t\n279\t    def test_enchantment_leaving_fires_leaves_battlefield(self) -> None:\n280\t        from engine.zones import move_to_zone\n281\t        game = create_game()\n282\t        enchantment = _make_enchantment('TestEnchantment')\n283\t        set_board_state(game, 0, battlefield=[enchantment])\n284\t        recorded = _record_events(game)\n285\t        move_to_zone(game, enchantment, Zone.BATTLEFIELD, Zone.GRAVEYARD)\n286\t        assert any((isinstance(e, LeavesBattlefieldTriggeredEvent) for e in recorded))\n287\t\n288\t    def test_enchantment_leaving_does_not_fire_creature_dies(self) -> None:\n289\t        from engine.zones import move_to_zone\n290\t        game = create_game()\n291\t        enchantment = _make_enchantment('TestEnchantment')\n292\t        set_board_state(game, 0, battlefield=[enchantment])\n293\t        recorded = _record_events(game)\n294\t        move_to_zone(game, enchantment, Zone.BATTLEFIELD, Zone.GRAVEYARD)\n295\t        assert not any((isinstance(e, CreatureDiesTriggeredEvent) for e in recorded))\n296\t\n297\tclass TestMoveToZoneToken:\n298\t    \"\"\"Token creature going to graveyard.\"\"\"\n299\t\n300\t    def test_token_to_graveyard_fires_leaves_battlefield(self) -> None:\n301\t        from engine.zones import move_to_zone\n302\t        game = create_game()\n303\t        token = _make_token_creature('SoldierToken')\n304\t        set_board_state(game, 0, battlefield=[token])\n305\t        recorded = _record_events(game)\n306\t        move_to_zone(game, token, Zone.BATTLEFIELD, Zone.GRAVEYARD)\n307\t        assert any((isinstance(e, LeavesBattlefieldTriggeredEvent) for e in recorded))\n308\t\n309\t    def test_token_to_graveyard_fires_creature_dies(self) -> None:\n310\t        from engine.zones import move_to_zone\n311\t        game = create_game()\n312\t        token = _make_token_creature('SoldierToken')\n313\t        set_board_state(game, 0, battlefield=[token])\n314\t        recorded = _record_events(game)\n315\t        move_to_zone(game, token, Zone.BATTLEFIELD, Zone.GRAVEYARD)\n316\t        assert any((isinstance(e, CreatureDiesTriggeredEvent) for e in recorded))\n317\t"}]},"parent_tool_use_id":"toolu_01V47x35JN2jnvC54S4NFizo","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"4f86f842-7262-4781-bdc4-58cf6eac244f","timestamp":"2026-06-02T07:41:36.106Z","subagent_type":"Implementer","task_description":"Implement sos_1"}
