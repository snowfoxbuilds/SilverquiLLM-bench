{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MDfA6j3pKcufkHom4qqtJD","type":"tool_result","content":"1\t\"\"\"Typed event objects for triggered abilities and replacement effects.\n2\t\n3\tTriggered events are passed to :meth:`TriggerManager.fire_event` and\n4\tforwarded to trigger condition callables.\n5\t\n6\tReplacement events are passed to :meth:`ReplacementManager.apply` and\n7\tforwarded to replacement condition/replacement callables.  Subclassing\n8\tencodes event-type hierarchy so a replacement registered for a parent\n9\ttype (e.g. ``MoveToGraveyardReplacementEvent``) also fires for\n10\tsubtypes (e.g. ``CreatureDiesReplacementEvent``).\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\tfrom dataclasses import dataclass\n16\tfrom typing import Any\n17\t\n18\t\n19\t# ---------------------------------------------------------------------------\n20\t# Triggered events\n21\t# ---------------------------------------------------------------------------\n22\t\n23\t@dataclass\n24\tclass TriggeredEvent:\n25\t    \"\"\"Base class for all triggered-ability events.\"\"\"\n26\t\n27\t\n28\t@dataclass\n29\tclass EntersBattlefieldTriggeredEvent(TriggeredEvent):\n30\t    permanent: Any = None\n31\t    controller: Any = None\n32\t    card: Any = None\n33\t    creature: Any = None\n34\t\n35\t\n36\t@dataclass\n37\tclass LeavesBattlefieldTriggeredEvent(TriggeredEvent):\n38\t    permanent: Any = None\n39\t    controller: Any = None\n40\t\n41\t\n42\t@dataclass\n43\tclass DealsDamageTriggeredEvent(TriggeredEvent):\n44\t    source: Any = None\n45\t    target: Any = None\n46\t    amount: int = 0\n47\t    is_combat: bool = False\n48\t    combat: bool = False\n49\t\n50\t\n51\t@dataclass\n52\tclass LosesLifeTriggeredEvent(TriggeredEvent):\n53\t    player: Any = None\n54\t    amount: int = 0\n55\t\n56\t\n57\t@dataclass\n58\tclass GainsLifeTriggeredEvent(TriggeredEvent):\n59\t    player: Any = None\n60\t    amount: int = 0\n61\t\n62\t\n63\t@dataclass\n64\tclass DrawsCardTriggeredEvent(TriggeredEvent):\n65\t    player: Any = None\n66\t    card: Any = None\n67\t\n68\t\n69\t@dataclass\n70\tclass BeginningOfUpkeepTriggeredEvent(TriggeredEvent):\n71\t    pass\n72\t\n73\t\n74\t@dataclass\n75\tclass BeginningOfCombatTriggeredEvent(TriggeredEvent):\n76\t    pass\n77\t\n78\t\n79\t@dataclass\n80\tclass BeginningOfMainPhaseTriggeredEvent(TriggeredEvent):\n81\t    \"\"\"Fired at the start of a main phase (pre- and post-combat).\n82\t\n83\t    ``player`` is the active player whose main phase is beginning.  Use\n84\t    the ``precombat`` flag to distinguish the pre-combat main phase from\n85\t    the post-combat one.  Triggers that care only about \"your next main\n86\t    phase\" should check ``event.player`` against their controller.\n87\t    \"\"\"\n88\t\n89\t    player: Any = None\n90\t    precombat: bool = False\n91\t\n92\t\n93\t@dataclass\n94\tclass EndOfTurnTriggeredEvent(TriggeredEvent):\n95\t    pass\n96\t\n97\t\n98\t@dataclass\n99\tclass EndStepTriggeredEvent(TriggeredEvent):\n100\t    player: Any = None\n101\t\n102\t\n103\t@dataclass\n104\tclass CreatureDiesTriggeredEvent(TriggeredEvent):\n105\t    creature: Any = None\n106\t    controller: Any = None\n107\t    owner: Any = None\n108\t\n109\t\n110\t@dataclass\n111\tclass SpellCastTriggeredEvent(TriggeredEvent):\n112\t    spell: Any = None\n113\t    player: Any = None\n114\t    card: Any = None\n115\t    controller: Any = None\n116\t\n117\t\n118\t@dataclass\n119\tclass AttacksTriggeredEvent(TriggeredEvent):\n120\t    creature: Any = None\n121\t    attacker: Any = None\n122\t\n123\t\n124\t@dataclass\n125\tclass BlocksTriggeredEvent(TriggeredEvent):\n126\t    creature: Any = None\n127\t\n128\t\n129\t@dataclass\n130\tclass CounterAddedTriggeredEvent(TriggeredEvent):\n131\t    permanent: Any = None\n132\t    counter_type: Any = None\n133\t    amount: int = 0\n134\t\n135\t\n136\t# ---------------------------------------------------------------------------\n137\t# Replacement events\n138\t# ---------------------------------------------------------------------------\n139\t\n140\t@dataclass\n141\tclass ReplacementEvent:\n142\t    \"\"\"Base class for all replacement-effect events.\"\"\"\n143\t\n144\t\n145\t@dataclass\n146\tclass MoveToGraveyardReplacementEvent(ReplacementEvent):\n147\t    \"\"\"Any permanent moving to a graveyard.\n148\t\n149\t    Subclass this for specific causes (destruction, sacrifice, etc.).\n150\t    A replacement registered for this type also fires for all subtypes.\n151\t\n152\t    ``destination`` may be mutated by a replacement to redirect the\n153\t    permanent to a different zone (``\"exile\"``, ``\"library\"``, ``\"hand\"``).\n154\t    Set ``prevented = True`` to signal that the replacement handled the\n155\t    zone move itself and the engine should skip its own move.\n156\t    \"\"\"\n157\t\n158\t    destination: str = \"graveyard\"\n159\t    controller: Any = None\n160\t    owner: Any = None\n161\t    prevented: bool = False\n162\t\n163\t    @property\n164\t    def card(self) -> Any:\n165\t        \"\"\"The object moving to the graveyard (overridden by subclasses).\"\"\"\n166\t        return None\n167\t\n168\t\n169\t@dataclass\n170\tclass CreatureDiesReplacementEvent(MoveToGraveyardReplacementEvent):\n171\t    \"\"\"A creature going to the graveyard via destruction or lethal damage.\"\"\"\n172\t\n173\t    creature: Any = None\n174\t\n175\t    @property\n176\t    def card(self) -> Any:\n177\t        return self.creature\n178\t\n179\t\n180\t@dataclass\n181\tclass PermanentDestroyedReplacementEvent(MoveToGraveyardReplacementEvent):\n182\t    \"\"\"A non-creature permanent going to the graveyard via destruction.\"\"\"\n183\t\n184\t    permanent: Any = None\n185\t\n186\t    @property\n187\t    def card(self) -> Any:\n188\t        return self.permanent\n189\t\n190\t\n191\t@dataclass\n192\tclass SacrificeReplacementEvent(MoveToGraveyardReplacementEvent):\n193\t    \"\"\"A permanent going to the graveyard via sacrifice.\"\"\"\n194\t\n195\t    permanent: Any = None\n196\t\n197\t    @property\n198\t    def card(self) -> Any:\n199\t        return self.permanent\n200\t\n201\t\n202\t@dataclass\n203\tclass CreateTokenReplacementEvent(ReplacementEvent):\n204\t    \"\"\"An effect about to create one or more tokens.\"\"\"\n205\t\n206\t    player: Any = None\n207\t    count: int = 1\n208\t\n209\t\n210\t@dataclass\n211\tclass AddCounterReplacementEvent(ReplacementEvent):\n212\t    \"\"\"An effect about to add one or more counters to a permanent.\"\"\"\n213\t\n214\t    permanent: Any = None\n215\t    amount: int = 1\n216\t"}]},"parent_tool_use_id":"toolu_01H6pxqW1YJhVScLqeG4XwUq","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"11aa68fe-65a1-4fea-bb1d-b56d7f4ea8be","timestamp":"2026-06-02T09:03:02.536Z","subagent_type":"Tester","task_description":"Write tests for sos_201"}
{"type":"system","subtype":"task_progress","task_id":"a6c2482023c961840","tool_use_id":"toolu_01H6pxqW1YJhVScLqeG4XwUq","description":"Reading engine/triggers.py","subagent_type":"Tester","usage":{"total_tokens":50669,"tool_uses":16,"duration_ms":23837},"last_tool_name":"Read","uuid":"7bb3c5ba-a552-43ff-a23f-c59d5526232f","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc"}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01Y9tq1eGpd1VCNq6mPdFK2s","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01R6RktfQYveoRqs78L3a3Fb","name":"Read","input":{"file_path":"/workspace/engine/triggers.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2653,"cache_read_input_tokens":47929,"cache_creation":{"ephemeral_5m_input_tokens":2653,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01H6pxqW1YJhVScLqeG4XwUq","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"7bb7816a-ac0d-4321-bbad-4b26ad1228e9","request_id":"req_011CbeAR95X7VTNPWo7HUpxL","subagent_type":"Tester","task_description":"Write tests for sos_201"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01R6RktfQYveoRqs78L3a3Fb","type":"tool_result","content":"1\t\"\"\"Triggered abilities system — event-driven trigger registration and firing.\n2\t\n3\tProvides the core mechanism for registering triggered abilities and firing\n4\tevents that push matching triggers onto the stack:\n5\t\n6\t- :class:`TriggerRegistration` — dataclass describing a single trigger.\n7\t- :class:`TriggerManager` — central registry for triggers with APNAP-ordered\n8\t  event firing.\n9\t\n10\tEvent types live in :mod:`engine.events` as typed dataclasses.\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\tfrom dataclasses import dataclass, field\n16\tfrom typing import TYPE_CHECKING, Any, Callable\n17\t\n18\tfrom engine.events import TriggeredEvent\n19\tfrom engine.stack import StackObject\n20\t\n21\tif TYPE_CHECKING:\n22\t    from engine.game_state import GameState\n23\t    from engine.player import Player\n24\t\n25\t\n26\t@dataclass\n27\tclass TriggerRegistration:\n28\t    \"\"\"Describes a single triggered ability.\n29\t\n30\t    Attributes:\n31\t        event_type: The event class (or a base class) this trigger watches.\n32\t            The trigger fires for any fired event that is an instance of\n33\t            this class, including instances of subclasses.\n34\t        condition: Optional callable ``(game, event) -> bool`` that must\n35\t            return ``True`` for the trigger to fire.  ``None`` means the\n36\t            trigger always fires for its event type.\n37\t        effect: Callable ``(game) -> None`` executed when the trigger\n38\t            resolves (becomes the :attr:`StackObject.on_resolve` callback).\n39\t        source: The game object (card / permanent) that owns this trigger.\n40\t        controller: The player who controls the source at the time of\n41\t            registration.\n42\t        one_shot: When ``True`` this is a delayed trigger that fires\n43\t            exactly once.  It is removed from the manager the first time\n44\t            its event fires and its condition passes (see\n45\t            :meth:`TriggerManager.fire_event`), so it will not fire again\n46\t            on subsequent matching events.\n47\t    \"\"\"\n48\t\n49\t    event_type: type[TriggeredEvent]\n50\t    condition: Callable[..., bool] | None\n51\t    effect: Callable[..., None]\n52\t    source: Any\n53\t    controller: Player\n54\t    one_shot: bool = False\n55\t\n56\t\n57\tclass TriggerManager:\n58\t    \"\"\"Central registry for triggered abilities.\n59\t\n60\t    Triggers are registered when a permanent enters the battlefield (or\n61\t    via other game actions) and unregistered when the source leaves.\n62\t\n63\t    :meth:`fire_event` checks all registered triggers of a matching\n64\t    event type, evaluates their conditions, and pushes matching triggers\n65\t    onto the game stack as :class:`StackObject` instances.  Triggers are\n66\t    ordered according to APNAP (Active Player, Non-Active Player):\n67\t\n68\t    * Active player's triggers are pushed first (end up on the bottom\n69\t      of the batch).\n70\t    * Non-active player's triggers are pushed second (end up on top).\n71\t    * Within the same player, triggers are pushed in registration order\n72\t      (controller would normally choose; for now we use registration\n73\t      order as a deterministic default).\n74\t    \"\"\"\n75\t\n76\t    def __init__(self) -> None:\n77\t        self._triggers: list[TriggerRegistration] = []\n78\t\n79\t    def register(self, trigger: TriggerRegistration) -> None:\n80\t        \"\"\"Register a triggered ability.\"\"\"\n81\t        self._triggers.append(trigger)\n82\t\n83\t    def register_delayed(\n84\t        self,\n85\t        event_type: type[TriggeredEvent],\n86\t        effect: Callable[..., None],\n87\t        source: Any,\n88\t        controller: Player,\n89\t        condition: Callable[..., bool] | None = None,\n90\t    ) -> TriggerRegistration:\n91\t        \"\"\"Register a one-shot *delayed* triggered ability.\n92\t\n93\t        A delayed trigger fires exactly once: the first time *event_type*\n94\t        (or a subclass) is fired and *condition* (if any) passes, *effect*\n95\t        is placed on the stack and the trigger is removed from the manager\n96\t        so it will not fire again.\n97\t\n98\t        This is the engine hook used by effects like \"at the beginning of\n99\t        your next main phase, ...\" — register a delayed trigger watching\n100\t        :class:`~engine.events.BeginningOfMainPhaseTriggeredEvent` whose\n101\t        *condition* checks that the firing player is the controller.\n102\t\n103\t        Returns the created :class:`TriggerRegistration` (already\n104\t        registered) so callers can inspect / unregister it.\n105\t        \"\"\"\n106\t        trigger = TriggerRegistration(\n107\t            event_type=event_type,\n108\t            condition=condition,\n109\t            effect=effect,\n110\t            source=source,\n111\t            controller=controller,\n112\t            one_shot=True,\n113\t        )\n114\t        self._triggers.append(trigger)\n115\t        return trigger\n116\t\n117\t    def unregister(self, source: Any) -> None:\n118\t        \"\"\"Remove all triggers registered by *source* (identity-based).\"\"\"\n119\t        self._triggers = [t for t in self._triggers if t.source is not source]\n120\t\n121\t    def fire_event(self, game: GameState, event: TriggeredEvent) -> None:\n122\t        \"\"\"Fire an event and push all matching triggers onto the stack.\n123\t\n124\t        Parameters:\n125\t            game: The current game state.\n126\t            event: The typed event object.  Triggers registered for the\n127\t                event's class or any of its parent classes will fire.\n128\t\n129\t        Matching triggers are pushed in APNAP order:\n130\t\n131\t        1. Active player's matching triggers (in registration order).\n132\t        2. Non-active player's matching triggers (in registration order).\n133\t        \"\"\"\n134\t        matching: list[TriggerRegistration] = []\n135\t        for trigger in self._triggers:\n136\t            if not isinstance(event, trigger.event_type):\n137\t                continue\n138\t            if trigger.condition is not None:\n139\t                if not trigger.condition(game, event):\n140\t                    continue\n141\t            matching.append(trigger)\n142\t\n143\t        if not matching:\n144\t            return\n145\t\n146\t        # One-shot (delayed) triggers fire exactly once: remove them from\n147\t        # the registry now that they have matched, so a later matching event\n148\t        # does not fire them again.\n149\t        one_shot_fired = [t for t in matching if t.one_shot]\n150\t        if one_shot_fired:\n151\t            self._triggers = [t for t in self._triggers if t not in one_shot_fired]\n152\t\n153\t        active_player = game.active_player\n154\t        active_triggers: list[TriggerRegistration] = []\n155\t        non_active_triggers: list[TriggerRegistration] = []\n156\t\n157\t        for trigger in matching:\n158\t            if trigger.controller is active_player:\n159\t                active_triggers.append(trigger)\n160\t            else:\n161\t                non_active_triggers.append(trigger)\n162\t\n163\t        ordered = active_triggers + non_active_triggers\n164\t\n165\t        for trigger in ordered:\n166\t            stack_obj = StackObject(\n167\t                source=trigger.source,\n168\t                controller=trigger.controller,\n169\t                on_resolve=trigger.effect,\n170\t            )\n171\t            game.stack.push(stack_obj)\n172\t\n173\t    def get_triggers(self) -> list[TriggerRegistration]:\n174\t        \"\"\"Return a shallow copy of all registered triggers.\"\"\"\n175\t        return list(self._triggers)\n176\t\n177\t    def get_triggers_for_source(self, source: Any) -> list[TriggerRegistration]:\n178\t        \"\"\"Return all triggers registered by *source* (identity-based).\"\"\"\n179\t        return [t for t in self._triggers if t.source is source]\n180\t\n181\t    def clear(self) -> None:\n182\t        \"\"\"Remove all registered triggers.\"\"\"\n183\t        self._triggers.clear()\n184\t"}]},"parent_tool_use_id":"toolu_01H6pxqW1YJhVScLqeG4XwUq","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"580776bf-5952-4f7b-9c38-666f59263361","timestamp":"2026-06-02T09:03:06.359Z","subagent_type":"Tester","task_description":"Write tests for sos_201"}
