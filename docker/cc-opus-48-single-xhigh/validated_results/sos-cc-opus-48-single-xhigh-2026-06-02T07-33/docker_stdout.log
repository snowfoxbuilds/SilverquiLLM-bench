{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QPBPTWRx8eXWGMB5a4ekhk","type":"tool_result","content":"1\t\"\"\"Casting and resolution pipeline for spells and lands.\n2\t\n3\tProvides the full flow from casting a spell or playing a land through\n4\tresolution:\n5\t\n6\t- :func:`cast_spell` — verify timing & legality → move hand to stack →\n7\t  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n8\t- :func:`play_land` — verify land play remaining → move hand to\n9\t  battlefield → decrement ``land_plays_remaining``.\n10\t- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n11\t  helpers used by the casting pipeline.\n12\t\n13\tResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\n14\tcreated by :func:`cast_spell`:\n15\t\n16\t- Call ``card.on_resolve(game)``.\n17\t- Permanents (creature / enchantment / artifact / planeswalker) move from\n18\t  the stack to the battlefield.\n19\t- Non-permanents (instant / sorcery) move to the graveyard.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import TYPE_CHECKING, Any\n25\t\n26\tfrom engine.card import CardImpl\n27\tfrom engine.stack import StackObject\n28\tfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\n29\tfrom engine.zones import move_zone\n30\t\n31\tif TYPE_CHECKING:\n32\t    from engine.game_state import GameState\n33\t    from engine.player import Player\n34\t\n35\t\n36\t# Card types that represent permanents — these go to the battlefield on resolve.\n37\t_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n38\t    CardType.CREATURE,\n39\t    CardType.ENCHANTMENT,\n40\t    CardType.ARTIFACT,\n41\t    CardType.PLANESWALKER,\n42\t})\n43\t\n44\t\n45\tclass CastingError(Exception):\n46\t    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n47\t\n48\t\n49\t# ------------------------------------------------------------------\n50\t# Timing helpers\n51\t# ------------------------------------------------------------------\n52\t\n53\tdef is_sorcery_speed(game: GameState, player: Player) -> bool:\n54\t    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n55\t\n56\t    Sorcery speed requires all of:\n57\t\n58\t    * *player* is the active player.\n59\t    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n60\t      ``POSTCOMBAT_MAIN``).\n61\t    * The stack is empty.\n62\t    \"\"\"\n63\t    if player is not game.active_player:\n64\t        return False\n65\t    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n66\t        return False\n67\t    if not game.stack.is_empty():\n68\t        return False\n69\t    return True\n70\t\n71\t\n72\tdef can_cast_at_instant_speed(card: CardImpl) -> bool:\n73\t    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n74\t\n75\t    A card has instant-speed timing if it is an instant or has the\n76\t    :attr:`~engine.types.Keyword.FLASH` keyword.\n77\t    \"\"\"\n78\t    if CardType.INSTANT in card.card_types:\n79\t        return True\n80\t    if Keyword.FLASH & card.keywords:\n81\t        return True\n82\t    return False\n83\t\n84\t\n85\t# ------------------------------------------------------------------\n86\t# Cost reduction\n87\t# ------------------------------------------------------------------\n88\t\n89\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n90\t    \"\"\"Return the generic mana reduction for casting *card*.\n91\t\n92\t    Queries ``card.cost_reduction(game)`` for the card's *own* cost reduction\n93\t    (e.g. Tolarian Terror counting instants/sorceries in your graveyard, or\n94\t    Witherbloom's own affinity for creatures) and adds any *granted* per-spell\n95\t    reduction another permanent contributes for this controller's spell (e.g.\n96\t    Witherbloom granting \"affinity for creatures\" to your instants/sorceries —\n97\t    see :mod:`engine.affinity`).  The summed reduction is clamped so that the\n98\t    generic portion of the mana cost cannot go below 0.\n99\t\n100\t    When no grant is registered for this spell, the granted contribution is 0 and\n101\t    the result is exactly the card's own clamped ``cost_reduction`` — so existing\n102\t    cost-reduction behaviour (sos_1, fdn_167) is unaffected.\n103\t\n104\t    Full MTG cost-reduction interactions (Trinisphere, ordering of multiple\n105\t    reductions from different sources) remain a simplified additive model.\n106\t    \"\"\"\n107\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n108\t    # casting player even when the card was never explicitly assigned one.\n109\t    prev_controller = card.controller\n110\t    card.controller = controller\n111\t    raw = card.cost_reduction(game)\n112\t    # Restore previous controller in case the caller doesn't want a\n113\t    # side-effect (get_cost_reduction is a query, not a mutation).\n114\t    card.controller = prev_controller\n115\t\n116\t    # Add any granted per-spell reduction (e.g. granted affinity for creatures)\n117\t    # registered for this controller's spell.  With no grant registered this is\n118\t    # 0, leaving the card's own reduction unchanged.\n119\t    from engine.affinity import get_granted_reduction\n120\t\n121\t    raw += get_granted_reduction(game, card, controller)\n122\t\n123\t    generic = card.mana_cost.generic if card.mana_cost else 0\n124\t    return max(0, min(raw, generic))\n125\t\n126\t\n127\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n128\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n129\t    new_generic = max(0, cost.generic - reduction)\n130\t    return ManaCost(\n131\t        generic=new_generic,\n132\t        pips=dict(cost.pips),\n133\t        x_count=cost.x_count,\n134\t        hybrid=list(cost.hybrid),\n135\t    )\n136\t\n137\t\n138\t# ------------------------------------------------------------------\n139\t# Cast spell\n140\t# ------------------------------------------------------------------\n141\t\n142\tdef cast_spell(\n143\t    game: GameState,\n144\t    player: Player,\n145\t    card: CardImpl,\n146\t    ignore_timing: bool = False,\n147\t) -> None:\n148\t    \"\"\"Cast *card* from *player*'s hand.\n149\t\n150\t    Pipeline\n151\t    --------\n152\t    1. **Timing check** — instants (and cards with flash) can be cast\n153\t       whenever the player has priority; everything else requires\n154\t       sorcery-speed timing.\n155\t    2. **can_cast** — ask the card whether it can legally be cast.\n156\t    3. **Hand check** — the card must be in the player's hand.\n157\t    4. **Move hand → stack zone** — remove the card from the hand and\n158\t       place it into the player's stack zone.\n159\t    5. **Choose targets** — if the card specifies targets (via\n160\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n161\t    6. **Mana check / payment** — the player's mana pool must be able to\n162\t       pay the card's mana cost.  If payment fails, the card is rolled\n163\t       back from the stack zone to the hand.\n164\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n165\t    8. **Push StackObject** — push a :class:`StackObject` whose\n166\t       ``on_resolve`` callback handles resolution.\n167\t\n168\t    Parameters:\n169\t        ignore_timing: When ``True``, the sorcery-speed timing gate\n170\t            (step 1) is bypassed so the spell may be cast outside a normal\n171\t            sorcery-speed window.  This is an opt-in escape hatch for\n172\t            casting permissions that create their own timing window — e.g.\n173\t            miracle (CR 702.94a), which lets a card be cast as it is drawn\n174\t            regardless of phase/stack/priority.  All other legality checks\n175\t            (``can_cast``, hand membership, targeting, mana payment) are\n176\t            unaffected.  Defaults to ``False`` so ordinary casts keep full\n177\t            sorcery-speed enforcement.\n178\t\n179\t    Raises:\n180\t        CastingError: If any legality check fails.\n181\t    \"\"\"\n182\t    # 1. Timing\n183\t    if (\n184\t        not ignore_timing\n185\t        and not can_cast_at_instant_speed(card)\n186\t        and not is_sorcery_speed(game, player)\n187\t    ):\n188\t        raise CastingError(\n189\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n190\t        )\n191\t\n192\t    # 2. can_cast\n193\t    if not card.can_cast(game):\n194\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n195\t\n196\t    # 3. Hand check\n197\t    hand = game.get_hand(player)\n198\t    if not hand.contains(card):\n199\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n200\t\n201\t    # 4. Move card from hand to stack zone\n202\t    stack_zone = player.zones[Zone.STACK]\n203\t    hand.remove(card)\n204\t    stack_zone.add(card)\n205\t\n206\t    # Clear any stale colors_spent / mana_spent from a prior cast before\n207\t    # new payment.\n208\t    if hasattr(card, \"colors_spent\"):\n209\t        del card.colors_spent\n210\t    if hasattr(card, \"mana_spent\"):\n211\t        del card.mana_spent\n212\t\n213\t    # 5. Choose targets\n214\t    target_specs = card.get_targets(game)\n215\t    chosen_targets: list[Any] = []\n216\t    if target_specs:\n217\t        for spec in target_specs:\n218\t            target = player.choose_target(target_specs, spec)\n219\t            # Validate against filter_fn if the spec provides one\n220\t            filter_fn = getattr(spec, \"filter_fn\", None)\n221\t            if filter_fn is not None and target is not None:\n222\t                if not filter_fn(target):\n223\t                    stack_zone.remove(card)\n224\t                    hand.add(card)\n225\t                    raise CastingError(\n226\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n227\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n228\t                    )\n229\t            chosen_targets.append(target)\n230\t\n231\t    # 5b. Protection check — reject targets that have protection from this\n232\t    #     spell (the T in DEBT).\n233\t    from engine.protection import has_protection_from\n234\t\n235\t    for target in chosen_targets:\n236\t        if has_protection_from(target, card):\n237\t            # Rollback: move card from stack zone back to hand\n238\t            stack_zone.remove(card)\n239\t            hand.add(card)\n240\t            raise CastingError(\n241\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n242\t            )\n243\t\n244\t    # Targets are stored on the StackObject (not the card) and passed\n245\t    # through the resolve pipeline via on_resolve(game, targets=...).\n246\t\n247\t    # 6. Mana check / payment (rollback on failure)\n248\t    # Ensure the card knows its controller so that cost_reduction() hooks\n249\t    # (e.g. Embercleave counting attacking creatures you control) see the\n250\t    # casting player, even for cards that were added to hand without an\n251\t    # explicit controller assignment.\n252\t    if card.controller is None:\n253\t        card.controller = player\n254\t    reduction = get_cost_reduction(game, card, player)\n255\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n256\t\n257\t    if not player.mana_pool.can_pay(effective_cost):\n258\t        # Rollback: move card from stack zone back to hand\n259\t        stack_zone.remove(card)\n260\t        hand.add(card)\n261\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n262\t\n263\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n264\t    player.mana_pool.pay(effective_cost)\n265\t\n266\t    # Store colors of mana spent on the card for mechanics like Converge\n267\t    # that care about the colors used to cast the spell.\n268\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n269\t\n270\t    # Store the TOTAL amount of mana paid for this cast for mechanics that\n271\t    # care about the literal amount of mana spent (e.g. \"add {C} equal to\n272\t    # the amount of mana spent to cast that spell\").  For a no-X / non-\n273\t    # reduced cast this equals the card's mana value; with cost reductions\n274\t    # it reflects the actual amount paid after reduction.\n275\t    card.mana_spent = effective_cost.cmc  # type: ignore[attr-defined]\n276\t\n277\t    # 7. Call on_cast hook\n278\t    card.on_cast(game)\n279\t\n280\t    # 8. Build on_resolve callback and push StackObject\n281\t    stack_obj = StackObject(\n282\t        source=card,\n283\t        controller=player,\n284\t        targets=chosen_targets,\n285\t        on_resolve=lambda g: None,  # replaced below\n286\t    )\n287\t\n288\t    def _on_resolve(g: GameState) -> None:\n289\t        _resolve_spell(g, card, player, stack_obj)\n290\t\n291\t    stack_obj.on_resolve = _on_resolve\n292\t    game.stack.push(stack_obj)\n293\t\n294\t\n295\t# ------------------------------------------------------------------\n296\t# Cast spell without paying mana cost (free-cast from any zone)\n297\t# ------------------------------------------------------------------\n298\t\n299\t\n300\tdef cast_spell_free(\n301\t    game: GameState,\n302\t    player: Player,\n303\t    card: CardImpl,\n304\t    from_zone: Zone,\n305\t) -> None:\n306\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n307\t\n308\t    This is used by effects that allow casting from zones other than hand\n309\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n310\t    or cascade.\n311\t\n312\t    Pipeline\n313\t    --------\n314\t    1. **can_cast** — ask the card whether it can legally be cast (same\n315\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n316\t    2. Move *card* from *from_zone* to the stack zone.\n317\t    3. Choose targets (if applicable) with validation and protection check.\n318\t    4. Call ``on_cast`` hook.\n319\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n320\t       resolution normally (permanents → battlefield, non-permanents →\n321\t       graveyard).\n322\t\n323\t    No timing check or mana payment is performed.  The spell goes on the\n324\t    stack and can be responded to normally (e.g. countered).\n325\t\n326\t    If targeting or other post-move checks fail, the card is rolled back\n327\t    to its source zone.\n328\t\n329\t    Parameters:\n330\t        game: The current game state.\n331\t        player: The player casting the spell.\n332\t        card: The card to cast.\n333\t        from_zone: The zone the card is currently in.\n334\t\n335\t    Raises:\n336\t        CastingError: If the card cannot be found in *from_zone* or\n337\t            legality checks fail.\n338\t    \"\"\"\n339\t    from engine.zones import move_to_zone\n340\t\n341\t    # Ensure controller is set\n342\t    card.controller = player\n343\t    if card.owner is None:\n344\t        card.owner = player\n345\t\n346\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n347\t    if not card.can_cast(game):\n348\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n349\t\n350\t    # 2. Locate card in source zone\n351\t    source_zone_container = player.zones[from_zone]\n352\t    if not source_zone_container.contains(card):\n353\t        # Try to find the card in any player's zone\n354\t        source_zone_container = None\n355\t        for p in game.players:\n356\t            z = p.zones[from_zone]\n357\t            if z.contains(card):\n358\t                source_zone_container = z\n359\t                break\n360\t\n361\t    if source_zone_container is None or not source_zone_container.contains(card):\n362\t        raise CastingError(\n363\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n364\t        )\n365\t\n366\t    # Move card from source zone to stack zone\n367\t    stack_zone = player.zones[Zone.STACK]\n368\t    source_zone_container.remove(card)\n369\t    stack_zone.add(card)\n370\t\n371\t    # 3. Choose targets (with rollback on failure)\n372\t    try:\n373\t        target_specs = card.get_targets(game)\n374\t        chosen_targets: list[Any] = []\n375\t        if target_specs:\n376\t            for spec in target_specs:\n377\t                target = player.choose_target(target_specs, spec)\n378\t                # Validate against filter_fn if the spec provides one\n379\t                filter_fn = getattr(spec, \"filter_fn\", None)\n380\t                if filter_fn is not None and target is not None:\n381\t                    if not filter_fn(target):\n382\t                        raise CastingError(\n383\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n384\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n385\t                        )\n386\t                chosen_targets.append(target)\n387\t\n388\t        # Protection check — reject targets that have protection from this spell\n389\t        from engine.protection import has_protection_from\n390\t\n391\t        for target in chosen_targets:\n392\t            if has_protection_from(target, card):\n393\t                raise CastingError(\n394\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n395\t                )\n396\t    except Exception as exc:\n397\t        # Rollback: move card from stack zone back to source zone\n398\t        stack_zone.remove(card)\n399\t        source_zone_container.add(card)\n400\t        raise CastingError(str(exc)) from exc\n401\t\n402\t    # 4. Call on_cast hook\n403\t    card.on_cast(game)\n404\t\n405\t    # 5. Build on_resolve callback and push StackObject\n406\t    stack_obj = StackObject(\n407\t        source=card,\n408\t        controller=player,\n409\t        targets=chosen_targets,\n410\t        on_resolve=lambda g: None,  # replaced below\n411\t    )\n412\t\n413\t    def _on_resolve(g: GameState) -> None:\n414\t        _resolve_spell(g, card, player, stack_obj)\n415\t\n416\t    stack_obj.on_resolve = _on_resolve\n417\t    game.stack.push(stack_obj)\n418\t\n419\t\n420\t# ------------------------------------------------------------------\n421\t# Stack → graveyard redirection registry\n422\t# ------------------------------------------------------------------\n423\t#\n424\t# Some effects (e.g. \"you may cast target instant or sorcery from your\n425\t# graveyard ... If that spell would be put into your graveyard, exile it\n426\t# instead\") need to redirect a *spell* (a non-permanent on the stack) to a\n427\t# zone other than the graveyard when it finishes resolving.  The engine's\n428\t# replacement-effect pipeline in ``engine.zones.move_to_zone`` only consults\n429\t# replacement effects when a card is *leaving the battlefield*, so it does not\n430\t# cover the STACK → GRAVEYARD transition a resolving instant/sorcery makes.\n431\t#\n432\t# This lightweight, per-game registry lets such effects register a one-shot\n433\t# redirect keyed on the specific card object.  ``_resolve_spell`` consults the\n434\t# registry when an instant/sorcery would head to the graveyard and routes the\n435\t# card to the requested zone instead (clearing the entry afterwards so the\n436\t# redirect applies only to this resolution).\n437\t\n438\t\n439\tdef _redirect_registry(game: GameState) -> dict[int, str]:\n440\t    \"\"\"Return (creating if necessary) the per-game stack→graveyard redirect map.\n441\t\n442\t    The map is keyed by ``id(card)`` so identity-based lookup is preserved even\n443\t    for cards that are not hashable in a domain-meaningful way.  Stored lazily\n444\t    on the game object so no change to ``GameState.__init__`` is required.\n445\t    \"\"\"\n446\t    registry = getattr(game, \"_stack_to_graveyard_redirects\", None)\n447\t    if registry is None:\n448\t        registry = {}\n449\t        game._stack_to_graveyard_redirects = registry  # type: ignore[attr-defined]\n450\t    return registry\n451\t\n452\t\n453\tdef register_stack_to_graveyard_redirect(\n454\t    game: GameState,\n455\t    card: CardImpl,\n456\t    destination: str,\n457\t) -> None:\n458\t    \"\"\"Redirect *card* away from the graveyard when it resolves off the stack.\n459\t\n460\t    Registers a one-shot redirect so that when *card* (a resolving\n461\t    instant/sorcery) would be put into the graveyard from the stack, it is\n462\t    instead placed into the zone named by *destination* (``\"exile\"``,\n463\t    ``\"hand\"``, ``\"library\"`` — see ``engine.zones._DESTINATION_ZONE_MAP``).\n464\t\n465\t    The redirect is consumed the first time the card resolves from the stack.\n466\t    \"\"\"\n467\t    _redirect_registry(game)[id(card)] = destination\n468\t\n469\t\n470\tdef clear_stack_to_graveyard_redirect(game: GameState, card: CardImpl) -> None:\n471\t    \"\"\"Remove any pending stack→graveyard redirect for *card* (no-op if none).\"\"\"\n472\t    _redirect_registry(game).pop(id(card), None)\n473\t\n474\t\n475\t# ------------------------------------------------------------------\n476\t# Resolution (called when the stack pops)\n477\t# ------------------------------------------------------------------\n478\t\n479\tdef _resolve_spell(\n480\t    game: GameState,\n481\t    card: CardImpl,\n482\t    player: Player,\n483\t    stack_obj: StackObject,\n484\t) -> None:\n485\t    \"\"\"Resolve *card* cast by *player*.\n486\t\n487\t    1. Call ``card.on_resolve(game, targets=targets)``.\n488\t    2. Remove the card from the stack zone.\n489\t    3. If the card is a permanent type, move it to the battlefield via\n490\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n491\t       registration and the ETB event).\n492\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard —\n493\t       unless a stack→graveyard redirect was registered for this card, in\n494\t       which case it is routed to the requested zone (e.g. exile) instead.\n495\t    \"\"\"\n496\t    from engine.zones import _DESTINATION_ZONE_MAP, move_to_zone\n497\t\n498\t    # Read targets from the StackObject — the single source of truth.\n499\t    # Set chosen_targets on the card just before resolution so that\n500\t    # _get_chosen_target helpers (which read via getattr) work.\n501\t    targets = stack_obj.targets\n502\t    if targets is not None:\n503\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n504\t\n505\t    card.on_resolve(game)\n506\t\n507\t    if card.card_types & _PERMANENT_TYPES:\n508\t        # Move from stack to battlefield via move_to_zone, which handles\n509\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n510\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n511\t    else:\n512\t        # Instant/sorcery: move from stack to graveyard via move_to_zone,\n513\t        # honouring any registered one-shot stack→graveyard redirect (e.g.\n514\t        # \"If that spell would be put into your graveyard, exile it instead\").\n515\t        destination = _redirect_registry(game).pop(id(card), None)\n516\t        dest_zone = Zone.GRAVEYARD\n517\t        if destination is not None:\n518\t            dest_zone = _DESTINATION_ZONE_MAP.get(destination, Zone.GRAVEYARD)\n519\t        move_to_zone(game, card, Zone.STACK, dest_zone)\n520\t\n521\t\n522\t# ------------------------------------------------------------------\n523\t# Play land (special action — does not use the stack)\n524\t# ------------------------------------------------------------------\n525\t\n526\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n527\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n528\t\n529\t    Requirements (all must hold):\n530\t\n531\t    * *land_card* has :attr:`CardType.LAND`.\n532\t    * *player* is the active player.\n533\t    * Current phase is a main phase.\n534\t    * The stack is empty.\n535\t    * ``player.land_plays_remaining > 0``.\n536\t    * The card is in the player's hand.\n537\t\n538\t    On success the card moves from hand to battlefield and\n539\t    ``land_plays_remaining`` is decremented.\n540\t\n541\t    Raises:\n542\t        CastingError: If any requirement is not met.\n543\t    \"\"\"\n544\t    # Must be a land\n545\t    if CardType.LAND not in land_card.card_types:\n546\t        raise CastingError(\n547\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n548\t        )\n549\t\n550\t    # Sorcery-speed timing (active player, main phase, stack empty)\n551\t    if not is_sorcery_speed(game, player):\n552\t        raise CastingError(\n553\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n554\t            \"during main phase with empty stack\"\n555\t        )\n556\t\n557\t    # Land plays remaining\n558\t    if player.land_plays_remaining <= 0:\n559\t        raise CastingError(\n560\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n561\t        )\n562\t\n563\t    # Card must be in hand\n564\t    hand = game.get_hand(player)\n565\t    if not hand.contains(land_card):\n566\t        raise CastingError(\n567\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n568\t        )\n569\t\n570\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n571\t    if land_card.owner is None:\n572\t        land_card.owner = player\n573\t    land_card.controller = player\n574\t\n575\t    # Move from hand to battlefield via move_to_zone, which fires\n576\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n577\t    from engine.zones import move_to_zone\n578\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n579\t\n580\t    # Decrement land plays\n581\t    player.land_plays_remaining -= 1\n582\t\n583\t\n584\tdef resolve_top(game: GameState) -> None:\n585\t    \"\"\"Resolve the top spell/ability on the stack.\n586\t\n587\t    Pops the top item from the stack, calls its on_resolve callback,\n588\t    then runs state-based actions.  If the stack is empty this is a no-op.\n589\t    \"\"\"\n590\t    if game.stack.is_empty():\n591\t        return\n592\t    from engine.state_based_actions import resolve_state_based_actions\n593\t\n594\t    obj = game.stack.pop()\n595\t    obj.on_resolve(game)\n596\t    resolve_state_based_actions(game)\n597\t"}]},"parent_tool_use_id":"toolu_013DvBFWmxzpqf1jHj4XNC9b","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"544fe5e3-0410-4d85-951e-b34409e1fda9","timestamp":"2026-06-02T10:08:03.170Z","subagent_type":"Implementer","task_description":"Implement sos_257 + 3 engine mechanisms"}
