{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Hpgqbo4v4A5z3gMAGQKjHm","type":"tool_result","content":"1\t\"\"\"Tests for SOS 57 — Mana Sculpt.\n2\t\n3\tMana Sculpt — {1}{U}{U} Instant:\n4\t\n5\t    Counter target spell. If you control a Wizard, add an amount of {C}\n6\t    equal to the amount of mana spent to cast that spell at the beginning\n7\t    of your next main phase.\n8\t\n9\tContract derived from the oracle text and the engine's counter plumbing\n10\t(see ``cards/fdn/fdn_48`` / ``cards/fdn/fdn_153`` for the established\n11\t``_counter_spell`` pattern, plus ``engine/stack.py``,\n12\t``engine/triggers.py`` and ``engine/mana.py``):\n13\t\n14\t* **Static data** — name ``\"Mana Sculpt\"``, mana cost ``{1}{U}{U}``, an\n15\t  instant.\n16\t* **Counter half** — the spell targets another spell on the stack and, on\n17\t  resolution, removes that spell's :class:`StackObject` from the stack and\n18\t  puts the countered card into its owner's graveyard.  A counter with no\n19\t  legal target (it left the stack) does nothing.\n20\t* **Wizard condition** — the deferred mana clause only applies if the\n21\t  controller of Mana Sculpt controls a Wizard *as the counter resolves*.\n22\t  With no Wizard, only the counter happens.\n23\t* **Deferred {C}** — when the controller does control a Wizard, a delayed\n24\t  effect is set up that, at the beginning of the controller's next main\n25\t  phase, adds an amount of ``{C}`` (colorless mana) to the controller's\n26\t  pool equal to the amount of mana spent to cast the countered spell.\n27\t  For a normally-cast spell with no X / cost reduction this is the\n28\t  countered spell's mana value.\n29\t\n30\tThe counter behaviour is asserted by driving ``on_resolve`` directly after\n31\tseeding ``chosen_targets`` (the established per-card test convention used by\n32\tthe FDN reference counter cards).  The deferred-mana behaviour is asserted\n33\tthrough the public trigger system: a Wizard-conditional counter must\n34\tregister a (delayed) trigger, and firing that trigger's effect must add the\n35\tcorrect amount of ``{C}`` to the controller's pool.\n36\t\"\"\"\n37\t\n38\tfrom __future__ import annotations\n39\t\n40\tfrom typing import Any\n41\t\n42\timport pytest\n43\t\n44\tfrom cards.sos.sos_57.card_impl import ManaSculpt\n45\tfrom engine.card import Creature, Instant, Sorcery\n46\tfrom engine.stack import StackObject\n47\tfrom engine.types import CardType, ManaCost, ManaType, Zone\n48\tfrom test_utils import create_game, set_board_state\n49\t\n50\t\n51\t# ---------------------------------------------------------------------------\n52\t# Helpers\n53\t# ---------------------------------------------------------------------------\n54\t\n55\t\n56\tdef _wizard(owner: Any = None) -> Creature:\n57\t    \"\"\"A 2/2 creature with the Wizard subtype.\"\"\"\n58\t    return Creature(\n59\t        name=\"Test Wizard\",\n60\t        owner=owner,\n61\t        controller=owner,\n62\t        subtypes={\"Human\", \"Wizard\"},\n63\t        base_power=2,\n64\t        base_toughness=2,\n65\t    )\n66\t\n67\t\n68\tdef _non_wizard(owner: Any = None) -> Creature:\n69\t    \"\"\"A 2/2 creature without the Wizard subtype.\"\"\"\n70\t    return Creature(\n71\t        name=\"Grizzly Bears\",\n72\t        owner=owner,\n73\t        controller=owner,\n74\t        subtypes={\"Bear\"},\n75\t        base_power=2,\n76\t        base_toughness=2,\n77\t    )\n78\t\n79\t\n80\tdef _make_spell_on_stack(\n81\t    game: Any,\n82\t    caster: Any,\n83\t    *,\n84\t    mana_cost: str = \"{2}{R}\",\n85\t    name: str = \"Lightning Spell\",\n86\t    creature: bool = False,\n87\t) -> StackObject:\n88\t    \"\"\"Put a dummy spell on the stack controlled by *caster*.\n89\t\n90\t    Mirrors the real cast pipeline's bookkeeping enough for a counter to\n91\t    act on it: the source card lives in the caster's stack zone and a\n92\t    :class:`StackObject` referencing it sits on the game stack.\n93\t    \"\"\"\n94\t    if creature:\n95\t        spell = Creature(\n96\t            name=name,\n97\t            owner=caster,\n98\t            controller=caster,\n99\t            mana_cost=ManaCost.parse(mana_cost),\n100\t            base_power=1,\n101\t            base_toughness=1,\n102\t        )\n103\t    else:\n104\t        spell = Sorcery(\n105\t            name=name,\n106\t            owner=caster,\n107\t            controller=caster,\n108\t            mana_cost=ManaCost.parse(mana_cost),\n109\t        )\n110\t    caster.zones[Zone.STACK].add(spell)\n111\t    stack_obj = StackObject(\n112\t        source=spell,\n113\t        controller=caster,\n114\t        targets=[],\n115\t        on_resolve=lambda _g: None,\n116\t    )\n117\t    game.stack.push(stack_obj)\n118\t    return stack_obj\n119\t\n120\t\n121\t# ---------------------------------------------------------------------------\n122\t# Static properties\n123\t# ---------------------------------------------------------------------------\n124\t\n125\t\n126\tclass TestManaSculptProperties:\n127\t    \"\"\"Static card data should match the SOS 57 spec.\"\"\"\n128\t\n129\t    def test_name(self) -> None:\n130\t        assert ManaSculpt(owner=None).name == \"Mana Sculpt\"\n131\t\n132\t    def test_mana_cost(self) -> None:\n133\t        assert ManaSculpt(owner=None).mana_cost == ManaCost.parse(\"{1}{U}{U}\")\n134\t\n135\t    def test_is_instant(self) -> None:\n136\t        card = ManaSculpt(owner=None)\n137\t        assert isinstance(card, Instant)\n138\t        assert CardType.INSTANT in card.card_types\n139\t\n140\t    def test_not_a_creature(self) -> None:\n141\t        card = ManaSculpt(owner=None)\n142\t        assert CardType.CREATURE not in card.card_types\n143\t\n144\t\n145\t# ---------------------------------------------------------------------------\n146\t# Targeting / castability — needs a spell on the stack\n147\t# ---------------------------------------------------------------------------\n148\t\n149\t\n150\tclass TestManaSculptTargeting:\n151\t    \"\"\"Mana Sculpt targets a spell on the stack.\"\"\"\n152\t\n153\t    def test_cannot_cast_with_empty_stack(self) -> None:\n154\t        game = create_game()\n155\t        p1 = game.players[0]\n156\t        card = ManaSculpt(owner=p1, controller=p1)\n157\t        assert card.can_cast(game) is False\n158\t\n159\t    def test_can_cast_when_a_spell_is_on_the_stack(self) -> None:\n160\t        game = create_game()\n161\t        p1, p2 = game.players\n162\t        _make_spell_on_stack(game, p2)\n163\t        card = ManaSculpt(owner=p1, controller=p1)\n164\t        assert card.can_cast(game) is True\n165\t\n166\t    def test_get_targets_offers_the_spell_on_the_stack(self) -> None:\n167\t        game = create_game()\n168\t        p1, p2 = game.players\n169\t        target = _make_spell_on_stack(game, p2)\n170\t        card = ManaSculpt(owner=p1, controller=p1)\n171\t        reqs = card.get_targets(game)\n172\t        assert len(reqs) == 1\n173\t        # The requirement's filter must accept the spell's StackObject and\n174\t        # reject Mana Sculpt itself.\n175\t        req = reqs[0]\n176\t        assert req.zone == Zone.STACK\n177\t        assert req.filter_fn(target) is True\n178\t\n179\t    def test_get_targets_rejects_self(self) -> None:\n180\t        \"\"\"Mana Sculpt must not be able to target its own stack object.\"\"\"\n181\t        game = create_game()\n182\t        p1, p2 = game.players\n183\t        _make_spell_on_stack(game, p2)\n184\t        card = ManaSculpt(owner=p1, controller=p1)\n185\t        own_obj = StackObject(source=card, controller=p1, targets=[])\n186\t        req = card.get_targets(game)[0]\n187\t        assert req.filter_fn(own_obj) is False\n188\t\n189\t\n190\t# ---------------------------------------------------------------------------\n191\t# Counter half\n192\t# ---------------------------------------------------------------------------\n193\t\n194\t\n195\tclass TestManaSculptCounter:\n196\t    \"\"\"The counter removes the target spell from the stack.\"\"\"\n197\t\n198\t    def test_counter_removes_spell_from_stack(self) -> None:\n199\t        game = create_game()\n200\t        p1, p2 = game.players\n201\t        target = _make_spell_on_stack(game, p2, name=\"Doomed Spell\")\n202\t\n203\t        card = ManaSculpt(owner=p1, controller=p1)\n204\t        card.chosen_targets = [target]\n205\t        # Sanity: the targeted spell is on the stack before resolution.\n206\t        assert target in game.stack.objects()\n207\t\n208\t        card.on_resolve(game)\n209\t\n210\t        assert target not in game.stack.objects()\n211\t\n212\t    def test_countered_spell_goes_to_owners_graveyard(self) -> None:\n213\t        game = create_game()\n214\t        p1, p2 = game.players\n215\t        target = _make_spell_on_stack(game, p2, name=\"Doomed Spell\")\n216\t        spell_card = target.source\n217\t\n218\t        card = ManaSculpt(owner=p1, controller=p1)\n219\t        card.chosen_targets = [target]\n220\t        card.on_resolve(game)\n221\t\n222\t        # The countered card is owned by p2; it ends up in p2's graveyard.\n223\t        assert game.get_graveyard(p2).contains(spell_card)\n224\t        # And it is no longer in the stack zone.\n225\t        assert not p2.zones[Zone.STACK].contains(spell_card)\n226\t\n227\t    def test_counters_creature_spell_too(self) -> None:\n228\t        \"\"\"\"Counter target spell\" is not limited to noncreature spells.\"\"\"\n229\t        game = create_game()\n230\t        p1, p2 = game.players\n231\t        target = _make_spell_on_stack(game, p2, name=\"Big Beast\", creature=True)\n232\t        spell_card = target.source\n233\t\n234\t        card = ManaSculpt(owner=p1, controller=p1)\n235\t        card.chosen_targets = [target]\n236\t        card.on_resolve(game)\n237\t\n238\t        assert target not in game.stack.objects()\n239\t        assert game.get_graveyard(p2).contains(spell_card)\n240\t\n241\t    def test_no_target_is_a_noop(self) -> None:\n242\t        \"\"\"If there is no legal target, resolution does nothing (fizzles).\"\"\"\n243\t        game = create_game()\n244\t        p1, p2 = game.players\n245\t        # A bystander spell that must remain on the stack untouched.\n246\t        bystander = _make_spell_on_stack(game, p2, name=\"Bystander\")\n247\t\n248\t        card = ManaSculpt(owner=p1, controller=p1)\n249\t        card.chosen_targets = [None]\n250\t        card.on_resolve(game)\n251\t\n252\t        assert bystander in game.stack.objects()\n253\t        assert not game.get_graveyard(p2).contains(bystander.source)\n254\t\n255\t\n256\t# ---------------------------------------------------------------------------\n257\t# Wizard condition + deferred {C}\n258\t# ---------------------------------------------------------------------------\n259\t\n260\t\n261\tclass TestManaSculptWizardCondition:\n262\t    \"\"\"The deferred-mana clause only applies if you control a Wizard.\"\"\"\n263\t\n264\t    def test_no_wizard_registers_no_delayed_trigger(self) -> None:\n265\t        game = create_game()\n266\t        p1, p2 = game.players\n267\t        # Controller has a non-Wizard creature only.\n268\t        set_board_state(game, 0, battlefield=[_non_wizard(p1)])\n269\t        target = _make_spell_on_stack(game, p2, mana_cost=\"{2}{R}\")\n270\t\n271\t        card = ManaSculpt(owner=p1, controller=p1)\n272\t        card.chosen_targets = [target]\n273\t\n274\t        before = len(game.trigger_manager.get_triggers())\n275\t        card.on_resolve(game)\n276\t        after = len(game.trigger_manager.get_triggers())\n277\t\n278\t        # The spell is still countered, but no deferred-mana trigger exists.\n279\t        assert target not in game.stack.objects()\n280\t        assert after == before\n281\t\n282\t    def test_no_wizard_adds_no_mana_now_or_via_pool(self) -> None:\n283\t        \"\"\"Without a Wizard, the controller's pool gains no colorless mana.\"\"\"\n284\t        game = create_game()\n285\t        p1, p2 = game.players\n286\t        set_board_state(game, 0, battlefield=[_non_wizard(p1)],\n287\t                        mana={ManaType.COLORLESS: 0})\n288\t        target = _make_spell_on_stack(game, p2, mana_cost=\"{2}{R}\")\n289\t\n290\t        card = ManaSculpt(owner=p1, controller=p1)\n291\t        card.chosen_targets = [target]\n292\t        card.on_resolve(game)\n293\t\n294\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 0\n295\t\n296\t    def test_wizard_registers_a_delayed_trigger(self) -> None:\n297\t        game = create_game()\n298\t        p1, p2 = game.players\n299\t        set_board_state(game, 0, battlefield=[_wizard(p1)])\n300\t        target = _make_spell_on_stack(game, p2, mana_cost=\"{2}{R}\")  # mv 3\n301\t\n302\t        card = ManaSculpt(owner=p1, controller=p1)\n303\t        card.chosen_targets = [target]\n304\t\n305\t        before = len(game.trigger_manager.get_triggers())\n306\t        card.on_resolve(game)\n307\t        after = len(game.trigger_manager.get_triggers())\n308\t\n309\t        # Counter happened, and a deferred-mana trigger was registered for\n310\t        # the controller's next main phase.\n311\t        assert target not in game.stack.objects()\n312\t        assert after == before + 1\n313\t\n314\t    def test_delayed_trigger_is_controlled_by_caster(self) -> None:\n315\t        \"\"\"The deferred mana belongs to Mana Sculpt's controller (\"you\").\"\"\"\n316\t        game = create_game()\n317\t        p1, p2 = game.players\n318\t        set_board_state(game, 0, battlefield=[_wizard(p1)])\n319\t        target = _make_spell_on_stack(game, p2, mana_cost=\"{2}{R}\")\n320\t\n321\t        card = ManaSculpt(owner=p1, controller=p1)\n322\t        card.chosen_targets = [target]\n323\t        card.on_resolve(game)\n324\t\n325\t        new_triggers = [\n326\t            t for t in game.trigger_manager.get_triggers()\n327\t            if t.controller is p1\n328\t        ]\n329\t        assert len(new_triggers) == 1\n330\t\n331\t    def test_delayed_trigger_effect_adds_colorless_equal_to_mana_spent(self) -> None:\n332\t        \"\"\"Firing the registered effect adds {C} equal to the spell's cost.\n333\t\n334\t        The countered spell costs {2}{R} (mana value 3, no X / reductions),\n335\t        so the controller gains exactly 3 colorless mana.\n336\t        \"\"\"\n337\t        game = create_game()\n338\t        p1, p2 = game.players\n339\t        set_board_state(game, 0, battlefield=[_wizard(p1)],\n340\t                        mana={ManaType.COLORLESS: 0})\n341\t        target = _make_spell_on_stack(game, p2, mana_cost=\"{2}{R}\")  # mv 3\n342\t\n343\t        card = ManaSculpt(owner=p1, controller=p1)\n344\t        card.chosen_targets = [target]\n345\t        card.on_resolve(game)\n346\t\n347\t        new_triggers = [\n348\t            t for t in game.trigger_manager.get_triggers()\n349\t            if t.controller is p1\n350\t        ]\n351\t        assert len(new_triggers) == 1\n352\t        # Execute the deferred effect (as the engine would when the trigger\n353\t        # resolves at the controller's next main phase).\n354\t        new_triggers[0].effect(game)\n355\t\n356\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 3\n357\t\n358\t    def test_deferred_amount_scales_with_a_more_expensive_spell(self) -> None:\n359\t        \"\"\"{C} added equals the amount of mana spent — a 5-mana spell → 5 {C}.\"\"\"\n360\t        game = create_game()\n361\t        p1, p2 = game.players\n362\t        set_board_state(game, 0, battlefield=[_wizard(p1)],\n363\t                        mana={ManaType.COLORLESS: 0})\n364\t        target = _make_spell_on_stack(game, p2, mana_cost=\"{3}{U}{U}\")  # mv 5\n365\t\n366\t        card = ManaSculpt(owner=p1, controller=p1)\n367\t        card.chosen_targets = [target]\n368\t        card.on_resolve(game)\n369\t\n370\t        new_triggers = [\n371\t            t for t in game.trigger_manager.get_triggers()\n372\t            if t.controller is p1\n373\t        ]\n374\t        assert len(new_triggers) == 1\n375\t        new_triggers[0].effect(game)\n376\t\n377\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 5\n378\t\n379\t    def test_deferred_mana_is_colorless_not_colored(self) -> None:\n380\t        \"\"\"The deferred mana is {C}; it must not add colored mana.\"\"\"\n381\t        game = create_game()\n382\t        p1, p2 = game.players\n383\t        set_board_state(\n384\t            game, 0, battlefield=[_wizard(p1)],\n385\t            mana={\n386\t                ManaType.COLORLESS: 0,\n387\t                ManaType.BLUE: 0,\n388\t                ManaType.RED: 0,\n389\t            },\n390\t        )\n391\t        target = _make_spell_on_stack(game, p2, mana_cost=\"{2}{R}\")  # mv 3\n392\t\n393\t        card = ManaSculpt(owner=p1, controller=p1)\n394\t        card.chosen_targets = [target]\n395\t        card.on_resolve(game)\n396\t\n397\t        new_triggers = [\n398\t            t for t in game.trigger_manager.get_triggers()\n399\t            if t.controller is p1\n400\t        ]\n401\t        assert len(new_triggers) == 1\n402\t        new_triggers[0].effect(game)\n403\t\n404\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 3\n405\t        # No colored mana was added by the colorless clause.\n406\t        assert p1.mana_pool.get(ManaType.BLUE) == 0\n407\t        assert p1.mana_pool.get(ManaType.RED) == 0\n408\t\n409\t    def test_opponents_wizard_does_not_enable_the_clause(self) -> None:\n410\t        \"\"\"\"If *you* control a Wizard\" — an opponent's Wizard does not count.\"\"\"\n411\t        game = create_game()\n412\t        p1, p2 = game.players\n413\t        # Only the opponent (p2) controls a Wizard.\n414\t        set_board_state(game, 0, battlefield=[_non_wizard(p1)])\n415\t        set_board_state(game, 1, battlefield=[_wizard(p2)])\n416\t        target = _make_spell_on_stack(game, p2, mana_cost=\"{2}{R}\")\n417\t\n418\t        card = ManaSculpt(owner=p1, controller=p1)\n419\t        card.chosen_targets = [target]\n420\t\n421\t        before = len(game.trigger_manager.get_triggers())\n422\t        card.on_resolve(game)\n423\t        after = len(game.trigger_manager.get_triggers())\n424\t\n425\t        assert target not in game.stack.objects()\n426\t        # No deferred-mana trigger because the controller has no Wizard.\n427\t        assert after == before\n428\t\n429\t\n430\t# ---------------------------------------------------------------------------\n431\t# End-to-end timing: the {C} arrives at the controller's next main phase\n432\t# ---------------------------------------------------------------------------\n433\t\n434\t\n435\tclass TestManaSculptDeliveryTiming:\n436\t    \"\"\"The deferred {C} is delivered to the pool at the next main phase.\n437\t\n438\t    This drives the registered delayed trigger and asserts the colorless\n439\t    mana lands in the controller's pool — the observable end state of the\n440\t    \"add ... at the beginning of your next main phase\" clause.\n441\t    \"\"\"\n442\t\n443\t    def test_mana_lands_in_pool_after_firing_delayed_trigger(self) -> None:\n444\t        game = create_game()\n445\t        p1, p2 = game.players\n446\t        set_board_state(game, 0, battlefield=[_wizard(p1)],\n447\t                        mana={ManaType.COLORLESS: 0})\n448\t        target = _make_spell_on_stack(game, p2, mana_cost=\"{4}\")  # mv 4\n449\t\n450\t        card = ManaSculpt(owner=p1, controller=p1)\n451\t        card.chosen_targets = [target]\n452\t        card.on_resolve(game)\n453\t\n454\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 0  # not added yet\n455\t\n456\t        new_triggers = [\n457\t            t for t in game.trigger_manager.get_triggers()\n458\t            if t.controller is p1\n459\t        ]\n460\t        assert len(new_triggers) == 1\n461\t        new_triggers[0].effect(game)\n462\t\n463\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 4\n464\t"}]},"parent_tool_use_id":"toolu_01GzTivkk8UJSRY11VipzqHn","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"a3165315-d701-460f-8ce6-f33e4e19de42","timestamp":"2026-06-02T08:27:12.505Z","subagent_type":"Tester","task_description":"Extend tests for sos_57 timing"}
