{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NLMtYpRoCqbgzxrAuyVDmL","type":"tool_result","content":"1\t\"\"\"Card implementation for The Dawning Archaic.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.events import AttacksTriggeredEvent\n9\tfrom engine.triggers import TriggerRegistration\n10\tfrom engine.types import CardType, Keyword, ManaCost, Supertype, Zone\n11\t\n12\tif TYPE_CHECKING:\n13\t    from engine.game_state import GameState\n14\t\n15\t\n16\tclass TheDawningArchaic(Creature):\n17\t    \"\"\"The Dawning Archaic — {10} — 7/7 — Legendary Creature — Avatar.\n18\t\n19\t    This spell costs {1} less to cast for each instant and sorcery card in\n20\t    your graveyard.\n21\t    Reach\n22\t    Whenever The Dawning Archaic attacks, you may cast target instant or\n23\t    sorcery card from your graveyard without paying its mana cost. If that\n24\t    spell would be put into your graveyard, exile it instead.\n25\t\n26\t    SOS collector number 1.\n27\t    \"\"\"\n28\t\n29\t    def __init__(self, **kwargs: Any) -> None:\n30\t        kwargs.setdefault(\"name\", \"The Dawning Archaic\")\n31\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{10}\"))\n32\t        kwargs.setdefault(\"subtypes\", {\"Avatar\"})\n33\t        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n34\t        kwargs.setdefault(\"keywords\", Keyword.REACH)\n35\t        kwargs.setdefault(\"base_power\", 7)\n36\t        kwargs.setdefault(\"base_toughness\", 7)\n37\t        kwargs.setdefault(\n38\t            \"rules_text\",\n39\t            \"This spell costs {1} less to cast for each instant and sorcery \"\n40\t            \"card in your graveyard.\\nReach\\nWhenever The Dawning Archaic \"\n41\t            \"attacks, you may cast target instant or sorcery card from your \"\n42\t            \"graveyard without paying its mana cost. If that spell would be \"\n43\t            \"put into your graveyard, exile it instead.\",\n44\t        )\n45\t        super().__init__(**kwargs)\n46\t\n47\t    # ------------------------------------------------------------------\n48\t    # Cost reduction — {1} less for each instant/sorcery in your graveyard.\n49\t    # ------------------------------------------------------------------\n50\t\n51\t    def cost_reduction(self, game: \"GameState\") -> int:\n52\t        \"\"\"Reduce the generic cost by {1} per instant/sorcery in your graveyard.\n53\t\n54\t        Only the controller's graveyard is consulted, and only instant and\n55\t        sorcery cards count.  The engine clamps the final value so generic\n56\t        mana never goes below 0 (see ``engine.casting.get_cost_reduction``).\n57\t        \"\"\"\n58\t        controller = self.controller\n59\t        if controller is None:\n60\t            return 0\n61\t        graveyard = controller.zones[Zone.GRAVEYARD]\n62\t        count = 0\n63\t        for card in graveyard.get_all():\n64\t            card_types = getattr(card, \"card_types\", set())\n65\t            if CardType.INSTANT in card_types or CardType.SORCERY in card_types:\n66\t                count += 1\n67\t        return count\n68\t\n69\t    # ------------------------------------------------------------------\n70\t    # Attack trigger — may recast an instant/sorcery from your graveyard.\n71\t    # ------------------------------------------------------------------\n72\t\n73\t    def register_triggers(self, game: \"GameState\") -> None:\n74\t        \"\"\"Register the attack trigger that recasts a graveyard spell for free.\"\"\"\n75\t        source = self\n76\t        controller = getattr(self, \"controller\", None) or game.active_player\n77\t\n78\t        def _condition(game: Any, event: AttacksTriggeredEvent) -> bool:\n79\t            return event.creature is source\n80\t\n81\t        def _effect(game: \"GameState\") -> None:\n82\t            ctrl = getattr(source, \"controller\", None)\n83\t            if ctrl is None:\n84\t                return\n85\t\n86\t            graveyard = ctrl.zones[Zone.GRAVEYARD]\n87\t            candidates = [\n88\t                c\n89\t                for c in graveyard.get_all()\n90\t                if CardType.INSTANT in getattr(c, \"card_types\", set())\n91\t                or CardType.SORCERY in getattr(c, \"card_types\", set())\n92\t            ]\n93\t            if not candidates:\n94\t                return\n95\t\n96\t            # Optional \"you may\" — ask before committing to a target.\n97\t            try:\n98\t                wants_to_cast = ctrl.choose_yes_no(\n99\t                    \"Cast an instant or sorcery from your graveyard \"\n100\t                    \"without paying its mana cost?\"\n101\t                )\n102\t            except Exception:\n103\t                wants_to_cast = False\n104\t            if not wants_to_cast:\n105\t                return\n106\t\n107\t            # Choose the target instant/sorcery card from the graveyard.\n108\t            try:\n109\t                chosen = ctrl.choose_card(\n110\t                    candidates,\n111\t                    \"instant or sorcery card to cast from your graveyard\",\n112\t                )\n113\t            except Exception:\n114\t                chosen = None\n115\t            if chosen is None or not graveyard.contains(chosen):\n116\t                return\n117\t\n118\t            # \"If that spell would be put into your graveyard, exile it\n119\t            # instead.\" — register a stack→graveyard redirect for this spell\n120\t            # so that when it finishes resolving it heads to exile.\n121\t            from engine.casting import (\n122\t                cast_spell_free,\n123\t                register_stack_to_graveyard_redirect,\n124\t            )\n125\t\n126\t            register_stack_to_graveyard_redirect(game, chosen, \"exile\")\n127\t            try:\n128\t                cast_spell_free(game, ctrl, chosen, Zone.GRAVEYARD)\n129\t            except Exception:\n130\t                # If the cast fails (e.g. illegal target), clear the redirect\n131\t                # so a future natural trip to the graveyard is unaffected.\n132\t                from engine.casting import clear_stack_to_graveyard_redirect\n133\t\n134\t                clear_stack_to_graveyard_redirect(game, chosen)\n135\t\n136\t        game.trigger_manager.register(\n137\t            TriggerRegistration(\n138\t                event_type=AttacksTriggeredEvent,\n139\t                condition=_condition,\n140\t                effect=_effect,\n141\t                source=self,\n142\t                controller=controller,\n143\t            )\n144\t        )\n145\t"}]},"parent_tool_use_id":"toolu_016vGKoq4rn862gyfhY4rSDc","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"e2abe1ab-92f9-4b55-b68f-c3e7442f49fd","timestamp":"2026-06-02T08:47:45.463Z","subagent_type":"Tester","task_description":"Write tests for sos_120"}
