{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01RKJftE3D4k9JHiQNzYd21c","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01HKvLZndXWkemArsrmHMMTK","name":"Read","input":{"file_path":"/workspace/engine/casting.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11287,"cache_read_input_tokens":45173,"cache_creation":{"ephemeral_5m_input_tokens":11287,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_015WsNuwKx3ww7UKaCjA1Mn7","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"82657a33-52e4-4fed-86a6-3b45a89ffced","request_id":"req_011CbeCcjXFAcd1QAUCpZ3Uj","subagent_type":"Implementer","task_description":"Implement sos_226 + casualty framework"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HKvLZndXWkemArsrmHMMTK","type":"tool_result","content":"1\t\"\"\"Casting and resolution pipeline for spells and lands.\n2\t\n3\tProvides the full flow from casting a spell or playing a land through\n4\tresolution:\n5\t\n6\t- :func:`cast_spell` — verify timing & legality → move hand to stack →\n7\t  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n8\t- :func:`play_land` — verify land play remaining → move hand to\n9\t  battlefield → decrement ``land_plays_remaining``.\n10\t- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n11\t  helpers used by the casting pipeline.\n12\t\n13\tResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\n14\tcreated by :func:`cast_spell`:\n15\t\n16\t- Call ``card.on_resolve(game)``.\n17\t- Permanents (creature / enchantment / artifact / planeswalker) move from\n18\t  the stack to the battlefield.\n19\t- Non-permanents (instant / sorcery) move to the graveyard.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import TYPE_CHECKING, Any\n25\t\n26\tfrom engine.card import CardImpl\n27\tfrom engine.stack import StackObject\n28\tfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\n29\tfrom engine.zones import move_zone\n30\t\n31\tif TYPE_CHECKING:\n32\t    from engine.game_state import GameState\n33\t    from engine.player import Player\n34\t\n35\t\n36\t# Card types that represent permanents — these go to the battlefield on resolve.\n37\t_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n38\t    CardType.CREATURE,\n39\t    CardType.ENCHANTMENT,\n40\t    CardType.ARTIFACT,\n41\t    CardType.PLANESWALKER,\n42\t})\n43\t\n44\t\n45\tclass CastingError(Exception):\n46\t    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n47\t\n48\t\n49\t# ------------------------------------------------------------------\n50\t# Timing helpers\n51\t# ------------------------------------------------------------------\n52\t\n53\tdef is_sorcery_speed(game: GameState, player: Player) -> bool:\n54\t    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n55\t\n56\t    Sorcery speed requires all of:\n57\t\n58\t    * *player* is the active player.\n59\t    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n60\t      ``POSTCOMBAT_MAIN``).\n61\t    * The stack is empty.\n62\t    \"\"\"\n63\t    if player is not game.active_player:\n64\t        return False\n65\t    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n66\t        return False\n67\t    if not game.stack.is_empty():\n68\t        return False\n69\t    return True\n70\t\n71\t\n72\tdef can_cast_at_instant_speed(card: CardImpl) -> bool:\n73\t    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n74\t\n75\t    A card has instant-speed timing if it is an instant or has the\n76\t    :attr:`~engine.types.Keyword.FLASH` keyword.\n77\t    \"\"\"\n78\t    if CardType.INSTANT in card.card_types:\n79\t        return True\n80\t    if Keyword.FLASH & card.keywords:\n81\t        return True\n82\t    return False\n83\t\n84\t\n85\t# ------------------------------------------------------------------\n86\t# Cost reduction\n87\t# ------------------------------------------------------------------\n88\t\n89\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n90\t    \"\"\"Return the generic mana reduction for casting *card*.\n91\t\n92\t    Queries ``card.cost_reduction(game)`` and clamps the result so that\n93\t    the generic portion of the mana cost cannot go below 0.\n94\t\n95\t    This is a simplified single-card self-reduction model.  Full MTG\n96\t    cost-reduction interactions (Trinisphere, multiple reductions from\n97\t    different sources) are deferred.\n98\t    \"\"\"\n99\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n100\t    # casting player even when the card was never explicitly assigned one.\n101\t    prev_controller = card.controller\n102\t    card.controller = controller\n103\t    raw = card.cost_reduction(game)\n104\t    # Restore previous controller in case the caller doesn't want a\n105\t    # side-effect (get_cost_reduction is a query, not a mutation).\n106\t    card.controller = prev_controller\n107\t    generic = card.mana_cost.generic if card.mana_cost else 0\n108\t    return max(0, min(raw, generic))\n109\t\n110\t\n111\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n112\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n113\t    new_generic = max(0, cost.generic - reduction)\n114\t    return ManaCost(\n115\t        generic=new_generic,\n116\t        pips=dict(cost.pips),\n117\t        x_count=cost.x_count,\n118\t        hybrid=list(cost.hybrid),\n119\t    )\n120\t\n121\t\n122\t# ------------------------------------------------------------------\n123\t# Cast spell\n124\t# ------------------------------------------------------------------\n125\t\n126\tdef cast_spell(\n127\t    game: GameState,\n128\t    player: Player,\n129\t    card: CardImpl,\n130\t    ignore_timing: bool = False,\n131\t) -> None:\n132\t    \"\"\"Cast *card* from *player*'s hand.\n133\t\n134\t    Pipeline\n135\t    --------\n136\t    1. **Timing check** — instants (and cards with flash) can be cast\n137\t       whenever the player has priority; everything else requires\n138\t       sorcery-speed timing.\n139\t    2. **can_cast** — ask the card whether it can legally be cast.\n140\t    3. **Hand check** — the card must be in the player's hand.\n141\t    4. **Move hand → stack zone** — remove the card from the hand and\n142\t       place it into the player's stack zone.\n143\t    5. **Choose targets** — if the card specifies targets (via\n144\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n145\t    6. **Mana check / payment** — the player's mana pool must be able to\n146\t       pay the card's mana cost.  If payment fails, the card is rolled\n147\t       back from the stack zone to the hand.\n148\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n149\t    8. **Push StackObject** — push a :class:`StackObject` whose\n150\t       ``on_resolve`` callback handles resolution.\n151\t\n152\t    Parameters:\n153\t        ignore_timing: When ``True``, the sorcery-speed timing gate\n154\t            (step 1) is bypassed so the spell may be cast outside a normal\n155\t            sorcery-speed window.  This is an opt-in escape hatch for\n156\t            casting permissions that create their own timing window — e.g.\n157\t            miracle (CR 702.94a), which lets a card be cast as it is drawn\n158\t            regardless of phase/stack/priority.  All other legality checks\n159\t            (``can_cast``, hand membership, targeting, mana payment) are\n160\t            unaffected.  Defaults to ``False`` so ordinary casts keep full\n161\t            sorcery-speed enforcement.\n162\t\n163\t    Raises:\n164\t        CastingError: If any legality check fails.\n165\t    \"\"\"\n166\t    # 1. Timing\n167\t    if (\n168\t        not ignore_timing\n169\t        and not can_cast_at_instant_speed(card)\n170\t        and not is_sorcery_speed(game, player)\n171\t    ):\n172\t        raise CastingError(\n173\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n174\t        )\n175\t\n176\t    # 2. can_cast\n177\t    if not card.can_cast(game):\n178\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n179\t\n180\t    # 3. Hand check\n181\t    hand = game.get_hand(player)\n182\t    if not hand.contains(card):\n183\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n184\t\n185\t    # 4. Move card from hand to stack zone\n186\t    stack_zone = player.zones[Zone.STACK]\n187\t    hand.remove(card)\n188\t    stack_zone.add(card)\n189\t\n190\t    # Clear any stale colors_spent / mana_spent from a prior cast before\n191\t    # new payment.\n192\t    if hasattr(card, \"colors_spent\"):\n193\t        del card.colors_spent\n194\t    if hasattr(card, \"mana_spent\"):\n195\t        del card.mana_spent\n196\t\n197\t    # 5. Choose targets\n198\t    target_specs = card.get_targets(game)\n199\t    chosen_targets: list[Any] = []\n200\t    if target_specs:\n201\t        for spec in target_specs:\n202\t            target = player.choose_target(target_specs, spec)\n203\t            # Validate against filter_fn if the spec provides one\n204\t            filter_fn = getattr(spec, \"filter_fn\", None)\n205\t            if filter_fn is not None and target is not None:\n206\t                if not filter_fn(target):\n207\t                    stack_zone.remove(card)\n208\t                    hand.add(card)\n209\t                    raise CastingError(\n210\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n211\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n212\t                    )\n213\t            chosen_targets.append(target)\n214\t\n215\t    # 5b. Protection check — reject targets that have protection from this\n216\t    #     spell (the T in DEBT).\n217\t    from engine.protection import has_protection_from\n218\t\n219\t    for target in chosen_targets:\n220\t        if has_protection_from(target, card):\n221\t            # Rollback: move card from stack zone back to hand\n222\t            stack_zone.remove(card)\n223\t            hand.add(card)\n224\t            raise CastingError(\n225\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n226\t            )\n227\t\n228\t    # Targets are stored on the StackObject (not the card) and passed\n229\t    # through the resolve pipeline via on_resolve(game, targets=...).\n230\t\n231\t    # 6. Mana check / payment (rollback on failure)\n232\t    # Ensure the card knows its controller so that cost_reduction() hooks\n233\t    # (e.g. Embercleave counting attacking creatures you control) see the\n234\t    # casting player, even for cards that were added to hand without an\n235\t    # explicit controller assignment.\n236\t    if card.controller is None:\n237\t        card.controller = player\n238\t    reduction = get_cost_reduction(game, card, player)\n239\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n240\t\n241\t    if not player.mana_pool.can_pay(effective_cost):\n242\t        # Rollback: move card from stack zone back to hand\n243\t        stack_zone.remove(card)\n244\t        hand.add(card)\n245\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n246\t\n247\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n248\t    player.mana_pool.pay(effective_cost)\n249\t\n250\t    # Store colors of mana spent on the card for mechanics like Converge\n251\t    # that care about the colors used to cast the spell.\n252\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n253\t\n254\t    # Store the TOTAL amount of mana paid for this cast for mechanics that\n255\t    # care about the literal amount of mana spent (e.g. \"add {C} equal to\n256\t    # the amount of mana spent to cast that spell\").  For a no-X / non-\n257\t    # reduced cast this equals the card's mana value; with cost reductions\n258\t    # it reflects the actual amount paid after reduction.\n259\t    card.mana_spent = effective_cost.cmc  # type: ignore[attr-defined]\n260\t\n261\t    # 7. Call on_cast hook\n262\t    card.on_cast(game)\n263\t\n264\t    # 8. Build on_resolve callback and push StackObject\n265\t    stack_obj = StackObject(\n266\t        source=card,\n267\t        controller=player,\n268\t        targets=chosen_targets,\n269\t        on_resolve=lambda g: None,  # replaced below\n270\t    )\n271\t\n272\t    def _on_resolve(g: GameState) -> None:\n273\t        _resolve_spell(g, card, player, stack_obj)\n274\t\n275\t    stack_obj.on_resolve = _on_resolve\n276\t    game.stack.push(stack_obj)\n277\t\n278\t\n279\t# ------------------------------------------------------------------\n280\t# Cast spell without paying mana cost (free-cast from any zone)\n281\t# ------------------------------------------------------------------\n282\t\n283\t\n284\tdef cast_spell_free(\n285\t    game: GameState,\n286\t    player: Player,\n287\t    card: CardImpl,\n288\t    from_zone: Zone,\n289\t) -> None:\n290\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n291\t\n292\t    This is used by effects that allow casting from zones other than hand\n293\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n294\t    or cascade.\n295\t\n296\t    Pipeline\n297\t    --------\n298\t    1. **can_cast** — ask the card whether it can legally be cast (same\n299\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n300\t    2. Move *card* from *from_zone* to the stack zone.\n301\t    3. Choose targets (if applicable) with validation and protection check.\n302\t    4. Call ``on_cast`` hook.\n303\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n304\t       resolution normally (permanents → battlefield, non-permanents →\n305\t       graveyard).\n306\t\n307\t    No timing check or mana payment is performed.  The spell goes on the\n308\t    stack and can be responded to normally (e.g. countered).\n309\t\n310\t    If targeting or other post-move checks fail, the card is rolled back\n311\t    to its source zone.\n312\t\n313\t    Parameters:\n314\t        game: The current game state.\n315\t        player: The player casting the spell.\n316\t        card: The card to cast.\n317\t        from_zone: The zone the card is currently in.\n318\t\n319\t    Raises:\n320\t        CastingError: If the card cannot be found in *from_zone* or\n321\t            legality checks fail.\n322\t    \"\"\"\n323\t    from engine.zones import move_to_zone\n324\t\n325\t    # Ensure controller is set\n326\t    card.controller = player\n327\t    if card.owner is None:\n328\t        card.owner = player\n329\t\n330\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n331\t    if not card.can_cast(game):\n332\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n333\t\n334\t    # 2. Locate card in source zone\n335\t    source_zone_container = player.zones[from_zone]\n336\t    if not source_zone_container.contains(card):\n337\t        # Try to find the card in any player's zone\n338\t        source_zone_container = None\n339\t        for p in game.players:\n340\t            z = p.zones[from_zone]\n341\t            if z.contains(card):\n342\t                source_zone_container = z\n343\t                break\n344\t\n345\t    if source_zone_container is None or not source_zone_container.contains(card):\n346\t        raise CastingError(\n347\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n348\t        )\n349\t\n350\t    # Move card from source zone to stack zone\n351\t    stack_zone = player.zones[Zone.STACK]\n352\t    source_zone_container.remove(card)\n353\t    stack_zone.add(card)\n354\t\n355\t    # 3. Choose targets (with rollback on failure)\n356\t    try:\n357\t        target_specs = card.get_targets(game)\n358\t        chosen_targets: list[Any] = []\n359\t        if target_specs:\n360\t            for spec in target_specs:\n361\t                target = player.choose_target(target_specs, spec)\n362\t                # Validate against filter_fn if the spec provides one\n363\t                filter_fn = getattr(spec, \"filter_fn\", None)\n364\t                if filter_fn is not None and target is not None:\n365\t                    if not filter_fn(target):\n366\t                        raise CastingError(\n367\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n368\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n369\t                        )\n370\t                chosen_targets.append(target)\n371\t\n372\t        # Protection check — reject targets that have protection from this spell\n373\t        from engine.protection import has_protection_from\n374\t\n375\t        for target in chosen_targets:\n376\t            if has_protection_from(target, card):\n377\t                raise CastingError(\n378\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n379\t                )\n380\t    except Exception as exc:\n381\t        # Rollback: move card from stack zone back to source zone\n382\t        stack_zone.remove(card)\n383\t        source_zone_container.add(card)\n384\t        raise CastingError(str(exc)) from exc\n385\t\n386\t    # 4. Call on_cast hook\n387\t    card.on_cast(game)\n388\t\n389\t    # 5. Build on_resolve callback and push StackObject\n390\t    stack_obj = StackObject(\n391\t        source=card,\n392\t        controller=player,\n393\t        targets=chosen_targets,\n394\t        on_resolve=lambda g: None,  # replaced below\n395\t    )\n396\t\n397\t    def _on_resolve(g: GameState) -> None:\n398\t        _resolve_spell(g, card, player, stack_obj)\n399\t\n400\t    stack_obj.on_resolve = _on_resolve\n401\t    game.stack.push(stack_obj)\n402\t\n403\t\n404\t# ------------------------------------------------------------------\n405\t# Stack → graveyard redirection registry\n406\t# ------------------------------------------------------------------\n407\t#\n408\t# Some effects (e.g. \"you may cast target instant or sorcery from your\n409\t# graveyard ... If that spell would be put into your graveyard, exile it\n410\t# instead\") need to redirect a *spell* (a non-permanent on the stack) to a\n411\t# zone other than the graveyard when it finishes resolving.  The engine's\n412\t# replacement-effect pipeline in ``engine.zones.move_to_zone`` only consults\n413\t# replacement effects when a card is *leaving the battlefield*, so it does not\n414\t# cover the STACK → GRAVEYARD transition a resolving instant/sorcery makes.\n415\t#\n416\t# This lightweight, per-game registry lets such effects register a one-shot\n417\t# redirect keyed on the specific card object.  ``_resolve_spell`` consults the\n418\t# registry when an instant/sorcery would head to the graveyard and routes the\n419\t# card to the requested zone instead (clearing the entry afterwards so the\n420\t# redirect applies only to this resolution).\n421\t\n422\t\n423\tdef _redirect_registry(game: GameState) -> dict[int, str]:\n424\t    \"\"\"Return (creating if necessary) the per-game stack→graveyard redirect map.\n425\t\n426\t    The map is keyed by ``id(card)`` so identity-based lookup is preserved even\n427\t    for cards that are not hashable in a domain-meaningful way.  Stored lazily\n428\t    on the game object so no change to ``GameState.__init__`` is required.\n429\t    \"\"\"\n430\t    registry = getattr(game, \"_stack_to_graveyard_redirects\", None)\n431\t    if registry is None:\n432\t        registry = {}\n433\t        game._stack_to_graveyard_redirects = registry  # type: ignore[attr-defined]\n434\t    return registry\n435\t\n436\t\n437\tdef register_stack_to_graveyard_redirect(\n438\t    game: GameState,\n439\t    card: CardImpl,\n440\t    destination: str,\n441\t) -> None:\n442\t    \"\"\"Redirect *card* away from the graveyard when it resolves off the stack.\n443\t\n444\t    Registers a one-shot redirect so that when *card* (a resolving\n445\t    instant/sorcery) would be put into the graveyard from the stack, it is\n446\t    instead placed into the zone named by *destination* (``\"exile\"``,\n447\t    ``\"hand\"``, ``\"library\"`` — see ``engine.zones._DESTINATION_ZONE_MAP``).\n448\t\n449\t    The redirect is consumed the first time the card resolves from the stack.\n450\t    \"\"\"\n451\t    _redirect_registry(game)[id(card)] = destination\n452\t\n453\t\n454\tdef clear_stack_to_graveyard_redirect(game: GameState, card: CardImpl) -> None:\n455\t    \"\"\"Remove any pending stack→graveyard redirect for *card* (no-op if none).\"\"\"\n456\t    _redirect_registry(game).pop(id(card), None)\n457\t\n458\t\n459\t# ------------------------------------------------------------------\n460\t# Resolution (called when the stack pops)\n461\t# ------------------------------------------------------------------\n462\t\n463\tdef _resolve_spell(\n464\t    game: GameState,\n465\t    card: CardImpl,\n466\t    player: Player,\n467\t    stack_obj: StackObject,\n468\t) -> None:\n469\t    \"\"\"Resolve *card* cast by *player*.\n470\t\n471\t    1. Call ``card.on_resolve(game, targets=targets)``.\n472\t    2. Remove the card from the stack zone.\n473\t    3. If the card is a permanent type, move it to the battlefield via\n474\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n475\t       registration and the ETB event).\n476\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard —\n477\t       unless a stack→graveyard redirect was registered for this card, in\n478\t       which case it is routed to the requested zone (e.g. exile) instead.\n479\t    \"\"\"\n480\t    from engine.zones import _DESTINATION_ZONE_MAP, move_to_zone\n481\t\n482\t    # Read targets from the StackObject — the single source of truth.\n483\t    # Set chosen_targets on the card just before resolution so that\n484\t    # _get_chosen_target helpers (which read via getattr) work.\n485\t    targets = stack_obj.targets\n486\t    if targets is not None:\n487\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n488\t\n489\t    card.on_resolve(game)\n490\t\n491\t    if card.card_types & _PERMANENT_TYPES:\n492\t        # Move from stack to battlefield via move_to_zone, which handles\n493\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n494\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n495\t    else:\n496\t        # Instant/sorcery: move from stack to graveyard via move_to_zone,\n497\t        # honouring any registered one-shot stack→graveyard redirect (e.g.\n498\t        # \"If that spell would be put into your graveyard, exile it instead\").\n499\t        destination = _redirect_registry(game).pop(id(card), None)\n500\t        dest_zone = Zone.GRAVEYARD\n501\t        if destination is not None:\n502\t            dest_zone = _DESTINATION_ZONE_MAP.get(destination, Zone.GRAVEYARD)\n503\t        move_to_zone(game, card, Zone.STACK, dest_zone)\n504\t\n505\t\n506\t# ------------------------------------------------------------------\n507\t# Play land (special action — does not use the stack)\n508\t# ------------------------------------------------------------------\n509\t\n510\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n511\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n512\t\n513\t    Requirements (all must hold):\n514\t\n515\t    * *land_card* has :attr:`CardType.LAND`.\n516\t    * *player* is the active player.\n517\t    * Current phase is a main phase.\n518\t    * The stack is empty.\n519\t    * ``player.land_plays_remaining > 0``.\n520\t    * The card is in the player's hand.\n521\t\n522\t    On success the card moves from hand to battlefield and\n523\t    ``land_plays_remaining`` is decremented.\n524\t\n525\t    Raises:\n526\t        CastingError: If any requirement is not met.\n527\t    \"\"\"\n528\t    # Must be a land\n529\t    if CardType.LAND not in land_card.card_types:\n530\t        raise CastingError(\n531\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n532\t        )\n533\t\n534\t    # Sorcery-speed timing (active player, main phase, stack empty)\n535\t    if not is_sorcery_speed(game, player):\n536\t        raise CastingError(\n537\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n538\t            \"during main phase with empty stack\"\n539\t        )\n540\t\n541\t    # Land plays remaining\n542\t    if player.land_plays_remaining <= 0:\n543\t        raise CastingError(\n544\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n545\t        )\n546\t\n547\t    # Card must be in hand\n548\t    hand = game.get_hand(player)\n549\t    if not hand.contains(land_card):\n550\t        raise CastingError(\n551\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n552\t        )\n553\t\n554\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n555\t    if land_card.owner is None:\n556\t        land_card.owner = player\n557\t    land_card.controller = player\n558\t\n559\t    # Move from hand to battlefield via move_to_zone, which fires\n560\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n561\t    from engine.zones import move_to_zone\n562\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n563\t\n564\t    # Decrement land plays\n565\t    player.land_plays_remaining -= 1\n566\t\n567\t\n568\tdef resolve_top(game: GameState) -> None:\n569\t    \"\"\"Resolve the top spell/ability on the stack.\n570\t\n571\t    Pops the top item from the stack, calls its on_resolve callback,\n572\t    then runs state-based actions.  If the stack is empty this is a no-op.\n573\t    \"\"\"\n574\t    if game.stack.is_empty():\n575\t        return\n576\t    from engine.state_based_actions import resolve_state_based_actions\n577\t\n578\t    obj = game.stack.pop()\n579\t    obj.on_resolve(game)\n580\t    resolve_state_based_actions(game)\n581\t"}]},"parent_tool_use_id":"toolu_015WsNuwKx3ww7UKaCjA1Mn7","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"d2fbb153-b7e8-4cc9-aae8-dcfd32bd2bbb","timestamp":"2026-06-02T09:31:55.431Z","subagent_type":"Implementer","task_description":"Implement sos_226 + casualty framework"}
