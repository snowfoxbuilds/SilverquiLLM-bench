{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011wL8r5MTWJyL843Q2V4rX7","type":"tool_result","content":"1\t\"\"\"Tests for SOS 120 — Improvisation Capstone.\n2\t\n3\tOracle text (from card_spec.json):\n4\t\n5\t    Exile cards from the top of your library until you exile cards with total\n6\t    mana value 4 or greater. You may cast any number of spells from among them\n7\t    without paying their mana costs.\n8\t    Paradigm (Then exile this spell. After you first resolve a spell with this\n9\t    name, you may cast a copy of it from exile without paying its mana cost at\n10\t    the beginning of each of your first main phases.)\n11\t\n12\tStatic data:\n13\t\n14\t    Improvisation Capstone\n15\t    {5}{R}{R}\n16\t    Sorcery — Lesson\n17\t    red, mythic, keyword \"Paradigm\".\n18\t\n19\tBehaviour contract derived from the spec\n20\t----------------------------------------\n21\t\n22\tMain effect (on_resolve):\n23\t\n24\t* Exile cards from the **top** of the controller's library one at a time,\n25\t  summing their mana value, and stop as soon as the running total of mana\n26\t  value reaches 4 or greater (the card that crosses the threshold is exiled\n27\t  too).  All exiled cards go to the controller's exile zone.\n28\t* A single card whose mana value is already >= 4 stops the process after that\n29\t  one card.\n30\t* Mana-value-0 cards (e.g. lands) keep the process going — they add nothing to\n31\t  the running total — until a card with nonzero mana value pushes the total to\n32\t  4 or greater.\n33\t* If the library runs out before reaching total mana value 4, every remaining\n34\t  card is exiled and the process stops (no crash / infinite loop).\n35\t* From among the cards exiled this way the controller \"may cast any number of\n36\t  spells ... without paying their mana costs\".  A spell cast this way is cast\n37\t  from the exile zone for free (it leaves exile and goes on the stack).  Lands\n38\t  among the exiled cards are not spells and cannot be cast this way.\n39\t\n40\tParadigm (keyword, CR 702.192):\n41\t\n42\t* The card has the \"Paradigm\" keyword designation.\n43\t* \"Then exile this spell.\" — after Improvisation Capstone finishes resolving\n44\t  it is exiled rather than put into the graveyard.\n45\t* \"After you first resolve a spell with this name, ... cast a copy of it from\n46\t  exile ... at the beginning of each of your first main phases.\" — the\n47\t  implementation exposes a way to create / cast a free copy of the spell from\n48\t  exile.  The exact engine surface for this brand-new mechanic is probed\n49\t  tolerantly (a copy factory and/or a cast helper).\n50\t\n51\tThese tests are written for the TDD red phase: they FAIL against the empty\n52\tstub and PASS once the card is implemented correctly.\n53\t\"\"\"\n54\t\n55\tfrom __future__ import annotations\n56\t\n57\tfrom typing import Any\n58\t\n59\timport pytest\n60\t\n61\tfrom cards.sos.sos_120.card_impl import ImprovisationCapstone\n62\tfrom engine.card import Creature, Instant, Land, Sorcery\n63\tfrom engine.events import BeginningOfMainPhaseTriggeredEvent\n64\tfrom engine.paradigm import (\n65\t    has_paradigm_resolved,\n66\t    register_paradigm,\n67\t)\n68\tfrom engine.protection import get_colors\n69\tfrom engine.types import CardType, Color, ManaCost, Zone\n70\tfrom test_utils import create_game, set_board_state\n71\t\n72\tCAPSTONE_NAME = \"Improvisation Capstone\"\n73\t\n74\t\n75\t# ---------------------------------------------------------------------------\n76\t# Helpers\n77\t# ---------------------------------------------------------------------------\n78\t\n79\t\n80\tdef _sorcery(name: str, cost: str) -> Sorcery:\n81\t    \"\"\"A plain sorcery with the given mana cost (no effect).\"\"\"\n82\t    return Sorcery(name=name, mana_cost=ManaCost.parse(cost))\n83\t\n84\t\n85\tdef _instant(name: str, cost: str) -> Instant:\n86\t    \"\"\"A plain instant with the given mana cost (no effect).\"\"\"\n87\t    return Instant(name=name, mana_cost=ManaCost.parse(cost))\n88\t\n89\t\n90\tdef _creature(name: str, cost: str, *, power: int = 2, toughness: int = 2) -> Creature:\n91\t    \"\"\"A plain vanilla creature with the given mana cost.\"\"\"\n92\t    return Creature(\n93\t        name=name,\n94\t        mana_cost=ManaCost.parse(cost),\n95\t        base_power=power,\n96\t        base_toughness=toughness,\n97\t    )\n98\t\n99\t\n100\tdef _land(name: str = \"Wastes\") -> Land:\n101\t    \"\"\"A basic land (mana value 0, not a spell).\"\"\"\n102\t    return Land(name=name)\n103\t\n104\t\n105\tdef _set_library(game: Any, player_index: int, cards: list[Any]) -> None:\n106\t    \"\"\"Replace *player_index*'s library with *cards*.\n107\t\n108\t    ``cards[-1]`` becomes the *top* of the library (the internal list stores\n109\t    the top at the end), so the cards are exiled in reverse-list order:\n110\t    ``cards[-1]`` first.  Ownership/control is assigned to the player.\n111\t    \"\"\"\n112\t    player = game.players[player_index]\n113\t    library = player.zones[Zone.LIBRARY]\n114\t    for obj in library.get_all():\n115\t        library.remove(obj)\n116\t    for card in cards:\n117\t        card.owner = player\n118\t        card.controller = player\n119\t        library.add(card)\n120\t\n121\t\n122\tdef _resolve_capstone(game: Any, card: ImprovisationCapstone) -> None:\n123\t    \"\"\"Run the card's main resolution and any spells it puts on the stack.\n124\t\n125\t    ``on_resolve`` does the exile-and-(optionally)-cast work; if it free-casts\n126\t    spells they land on the stack, so we drain the stack afterwards to settle\n127\t    a stable end state.\n128\t    \"\"\"\n129\t    card.on_resolve(game)\n130\t    while not game.stack.is_empty():\n131\t        obj = game.stack.pop()\n132\t        obj.on_resolve(game)\n133\t\n134\t\n135\tdef _capstone_on_battlefield_owner(game: Any, player_index: int) -> ImprovisationCapstone:\n136\t    \"\"\"An Improvisation Capstone owned/controlled by *player_index*.\"\"\"\n137\t    p = game.players[player_index]\n138\t    card = ImprovisationCapstone(owner=p, controller=p)\n139\t    return card\n140\t\n141\t\n142\tdef _fire_main_phase_begin(\n143\t    game: Any, player: Any, *, precombat: bool = True, drain: bool = True\n144\t) -> None:\n145\t    \"\"\"Fire ``BeginningOfMainPhaseTriggeredEvent`` for *player*.\n146\t\n147\t    Drives the engine exactly as ``engine/turn.py`` does at the start of a main\n148\t    phase: the event is fired via :meth:`TriggerManager.fire_event`, which pushes\n149\t    any matching trigger's effect onto the stack as a :class:`StackObject`.  When\n150\t    *drain* is ``True`` the stack is then resolved (LIFO) so the trigger's body\n151\t    (``offer_paradigm_copy``) actually runs — mirroring the real ``priority_loop``\n152\t    resolution that follows the fired event.\n153\t\n154\t    APNAP ordering in ``fire_event`` keys off ``game.active_player``; the active\n155\t    player is set to *player* so a trigger they control is pushed normally.\n156\t    \"\"\"\n157\t    game.active_player_index = game.players.index(player)\n158\t    game.trigger_manager.fire_event(\n159\t        game,\n160\t        BeginningOfMainPhaseTriggeredEvent(player=player, precombat=precombat),\n161\t    )\n162\t    if not drain:\n163\t        return\n164\t    while not game.stack.is_empty():\n165\t        obj = game.stack.pop()\n166\t        obj.on_resolve(game)\n167\t\n168\t\n169\tdef _capstone_copies_in_exile(player: Any) -> list[ImprovisationCapstone]:\n170\t    \"\"\"All Improvisation Capstone copies currently in *player*'s exile zone.\"\"\"\n171\t    return [\n172\t        c\n173\t        for c in player.zones[Zone.EXILE].get_all()\n174\t        if isinstance(c, ImprovisationCapstone)\n175\t    ]\n176\t\n177\t\n178\t# ---------------------------------------------------------------------------\n179\t# Static properties\n180\t# ---------------------------------------------------------------------------\n181\t\n182\t\n183\tclass TestImprovisationCapstoneProperties:\n184\t    \"\"\"Static card data should match the SOS 120 spec.\"\"\"\n185\t\n186\t    def test_name(self) -> None:\n187\t        assert ImprovisationCapstone(owner=None).name == \"Improvisation Capstone\"\n188\t\n189\t    def test_mana_cost(self) -> None:\n190\t        assert ImprovisationCapstone(owner=None).mana_cost == ManaCost.parse(\"{5}{R}{R}\")\n191\t\n192\t    def test_is_sorcery(self) -> None:\n193\t        card = ImprovisationCapstone(owner=None)\n194\t        assert isinstance(card, Sorcery)\n195\t        assert CardType.SORCERY in card.card_types\n196\t\n197\t    def test_not_a_creature(self) -> None:\n198\t        card = ImprovisationCapstone(owner=None)\n199\t        assert CardType.CREATURE not in card.card_types\n200\t\n201\t    def test_is_red(self) -> None:\n202\t        assert get_colors(ImprovisationCapstone(owner=None)) == {Color.RED}\n203\t\n204\t    def test_is_a_lesson(self) -> None:\n205\t        assert \"Lesson\" in ImprovisationCapstone(owner=None).subtypes\n206\t\n207\t    def test_mana_value_is_seven(self) -> None:\n208\t        assert ImprovisationCapstone(owner=None).mana_cost.cmc == 7\n209\t\n210\t    def test_has_paradigm_keyword(self) -> None:\n211\t        \"\"\"The card carries the 'Paradigm' designation.\n212\t\n213\t        Paradigm is not an evergreen ``Keyword`` enum member, so the\n214\t        implementation records it as a printed-keyword label.  Probe the\n215\t        common spellings tolerantly.\n216\t        \"\"\"\n217\t        card = ImprovisationCapstone(owner=None)\n218\t        found = False\n219\t        for attr in (\"printed_keywords\", \"keyword_labels\", \"ability_words\"):\n220\t            val = getattr(card, attr, None)\n221\t            if val and any(\"Paradigm\" in str(k) for k in val):\n222\t                found = True\n223\t        rules = getattr(card, \"rules_text\", \"\") or \"\"\n224\t        if \"Paradigm\" in rules:\n225\t            found = True\n226\t        assert found, \"no 'Paradigm' designation found on the card\"\n227\t\n228\t\n229\t# ---------------------------------------------------------------------------\n230\t# Main effect — exile from library until total mana value >= 4\n231\t# ---------------------------------------------------------------------------\n232\t\n233\t\n234\tclass TestExileThreshold:\n235\t    \"\"\"Exile cards from the top of your library until total mana value >= 4.\"\"\"\n236\t\n237\t    def test_exiles_until_total_mana_value_reaches_four(self) -> None:\n238\t        \"\"\"Three 2-MV cards: the first two (total 4) cross the threshold.\n239\t\n240\t        Top-of-library cards are exiled first; once the running total reaches\n241\t        4 the process stops, so the third card stays in the library.\n242\t        \"\"\"\n243\t        game = create_game()\n244\t        p1 = game.players[0]\n245\t        card = _capstone_on_battlefield_owner(game, 0)\n246\t        a = _sorcery(\"A\", \"{2}\")  # mv 2\n247\t        b = _sorcery(\"B\", \"{2}\")  # mv 2\n248\t        c = _sorcery(\"C\", \"{2}\")  # mv 2\n249\t        # top -> a, then b, then c\n250\t        _set_library(game, 0, [c, b, a])\n251\t\n252\t        card.on_resolve(game)\n253\t\n254\t        exile = p1.zones[Zone.EXILE]\n255\t        assert exile.contains(a)\n256\t        assert exile.contains(b)\n257\t        # The third card is untouched in the library — threshold already met.\n258\t        assert not exile.contains(c)\n259\t        assert p1.zones[Zone.LIBRARY].contains(c)\n260\t\n261\t    def test_single_high_mana_value_card_stops_immediately(self) -> None:\n262\t        \"\"\"A single card whose mana value is already >= 4 ends the process.\"\"\"\n263\t        game = create_game()\n264\t        p1 = game.players[0]\n265\t        card = _capstone_on_battlefield_owner(game, 0)\n266\t        big = _sorcery(\"Big Spell\", \"{4}\")  # mv 4\n267\t        rest = _sorcery(\"Untouched\", \"{1}\")\n268\t        _set_library(game, 0, [rest, big])  # top -> big\n269\t\n270\t        card.on_resolve(game)\n271\t\n272\t        exile = p1.zones[Zone.EXILE]\n273\t        assert exile.contains(big)\n274\t        # Only the one card was exiled; the second never gets reached.\n275\t        assert not exile.contains(rest)\n276\t        assert p1.zones[Zone.LIBRARY].contains(rest)\n277\t\n278\t    def test_threshold_is_inclusive_of_exactly_four(self) -> None:\n279\t        \"\"\"Reaching exactly mana value 4 stops the process (>= 4, not > 4).\"\"\"\n280\t        game = create_game()\n281\t        p1 = game.players[0]\n282\t        card = _capstone_on_battlefield_owner(game, 0)\n283\t        four = _sorcery(\"Exactly Four\", \"{4}\")\n284\t        extra = _sorcery(\"Extra\", \"{1}\")\n285\t        _set_library(game, 0, [extra, four])  # top -> four\n286\t\n287\t        card.on_resolve(game)\n288\t\n289\t        exile = p1.zones[Zone.EXILE]\n290\t        assert exile.contains(four)\n291\t        assert not exile.contains(extra)\n292\t\n293\t    def test_zero_mana_value_cards_do_not_stop_the_process(self) -> None:\n294\t        \"\"\"Lands (mana value 0) keep the process going until a nonzero card\n295\t        pushes the running total to 4 or greater.\"\"\"\n296\t        game = create_game()\n297\t        p1 = game.players[0]\n298\t        card = _capstone_on_battlefield_owner(game, 0)\n299\t        land1 = _land(\"Wastes 1\")  # mv 0\n300\t        land2 = _land(\"Wastes 2\")  # mv 0\n301\t        payoff = _sorcery(\"Payoff\", \"{4}\")  # mv 4 -> crosses threshold\n302\t        beyond = _sorcery(\"Beyond\", \"{1}\")\n303\t        # top -> land1, land2, payoff, beyond\n304\t        _set_library(game, 0, [beyond, payoff, land2, land1])\n305\t\n306\t        card.on_resolve(game)\n307\t\n308\t        exile = p1.zones[Zone.EXILE]\n309\t        assert exile.contains(land1)\n310\t        assert exile.contains(land2)\n311\t        assert exile.contains(payoff)\n312\t        # The card after the threshold-crosser is left in the library.\n313\t        assert not exile.contains(beyond)\n314\t        assert p1.zones[Zone.LIBRARY].contains(beyond)\n315\t\n316\t    def test_exiled_cards_leave_the_library(self) -> None:\n317\t        \"\"\"Exiled cards are removed from the library (no duplication).\"\"\"\n318\t        game = create_game()\n319\t        p1 = game.players[0]\n320\t        card = _capstone_on_battlefield_owner(game, 0)\n321\t        a = _sorcery(\"A\", \"{3}\")\n322\t        b = _sorcery(\"B\", \"{3}\")  # total 6 -> stops after b\n323\t        _set_library(game, 0, [b, a])  # top -> a\n324\t\n325\t        card.on_resolve(game)\n326\t\n327\t        library = p1.zones[Zone.LIBRARY]\n328\t        assert not library.contains(a)\n329\t        assert not library.contains(b)\n330\t\n331\t    def test_empty_library_exiles_nothing_and_does_not_crash(self) -> None:\n332\t        \"\"\"With an empty library, the effect exiles nothing and is a no-op.\"\"\"\n333\t        game = create_game()\n334\t        p1 = game.players[0]\n335\t        card = _capstone_on_battlefield_owner(game, 0)\n336\t        _set_library(game, 0, [])\n337\t\n338\t        card.on_resolve(game)  # must not raise / infinite-loop\n339\t\n340\t        assert len(p1.zones[Zone.EXILE].get_all()) == 0\n341\t\n342\t    def test_library_smaller_than_threshold_exiles_all_remaining(self) -> None:\n343\t        \"\"\"If the library runs dry before total mana value 4, every card is\n344\t        exiled and the process stops (no infinite loop).\"\"\"\n345\t        game = create_game()\n346\t        p1 = game.players[0]\n347\t        card = _capstone_on_battlefield_owner(game, 0)\n348\t        a = _sorcery(\"A\", \"{1}\")  # mv 1\n349\t        b = _sorcery(\"B\", \"{1}\")  # mv 1 -> total 2, library exhausted\n350\t        _set_library(game, 0, [b, a])\n351\t\n352\t        card.on_resolve(game)\n353\t\n354\t        exile = p1.zones[Zone.EXILE]\n355\t        assert exile.contains(a)\n356\t        assert exile.contains(b)\n357\t        assert len(p1.zones[Zone.LIBRARY].get_all()) == 0\n358\t\n359\t    def test_only_controllers_library_is_used(self) -> None:\n360\t        \"\"\"Cards come from *your* (the controller's) library, not an opponent's.\"\"\"\n361\t        game = create_game()\n362\t        p1, p2 = game.players\n363\t        card = _capstone_on_battlefield_owner(game, 0)\n364\t        mine = _sorcery(\"Mine\", \"{4}\")\n365\t        _set_library(game, 0, [mine])\n366\t        opp = _sorcery(\"Opp\", \"{4}\")\n367\t        _set_library(game, 1, [opp])\n368\t\n369\t        card.on_resolve(game)\n370\t\n371\t        # The controller's card is exiled; the opponent's library is untouched.\n372\t        assert p1.zones[Zone.EXILE].contains(mine)\n373\t        assert p2.zones[Zone.LIBRARY].contains(opp)\n374\t        assert not p2.zones[Zone.EXILE].contains(opp)\n375\t\n376\t\n377\t# ---------------------------------------------------------------------------\n378\t# Main effect — cast any number of spells from among them for free\n379\t# ---------------------------------------------------------------------------\n380\t\n381\t\n382\tclass TestCastFromAmongExiled:\n383\t    \"\"\"You may cast any number of spells from among the exiled cards for free.\"\"\"\n384\t\n385\t    def test_chosen_spell_is_cast_for_free(self) -> None:\n386\t        \"\"\"A spell chosen from the exiled cards is put on the stack from exile\n387\t        without paying mana (the controller's empty pool is irrelevant).\"\"\"\n388\t        spell = _sorcery(\"Free Spell\", \"{4}\")\n389\t        # Script: yes (cast a spell), choose the spell, then no (stop).\n390\t        game = create_game(scripts=([True, spell, False], []))\n391\t        p1 = game.players[0]\n392\t        card = _capstone_on_battlefield_owner(game, 0)\n393\t        _set_library(game, 0, [spell])\n394\t        set_board_state(game, 0, mana={})  # no mana available\n395\t\n396\t        card.on_resolve(game)\n397\t\n398\t        # The chosen spell left exile and is now on the stack (cast for free).\n399\t        assert not p1.zones[Zone.EXILE].contains(spell)\n400\t        assert not game.stack.is_empty()\n401\t        sources = [obj.source for obj in game.stack.objects()]\n402\t        assert spell in sources\n403\t\n404\t    def test_declining_leaves_spells_in_exile(self) -> None:\n405\t        \"\"\"Casting is optional (\"may\"); declining leaves the cards in exile.\"\"\"\n406\t        spell = _sorcery(\"Stays Exiled\", \"{4}\")\n407\t        game = create_game(scripts=([False], []))  # decline to cast anything\n408\t        p1 = game.players[0]\n409\t        card = _capstone_on_battlefield_owner(game, 0)\n410\t        _set_library(game, 0, [spell])\n411\t\n412\t        card.on_resolve(game)\n413\t\n414\t        # Nothing was cast; the spell remains in exile.\n415\t        assert p1.zones[Zone.EXILE].contains(spell)\n416\t        assert game.stack.is_empty()\n417\t\n418\t    def test_can_cast_multiple_spells(self) -> None:\n419\t        \"\"\"\"any number of spells\" — more than one exiled spell may be cast.\"\"\"\n420\t        s1 = _sorcery(\"First\", \"{2}\")\n421\t        s2 = _sorcery(\"Second\", \"{2}\")  # total mv 4 -> both exiled\n422\t        # yes, cast s1; yes, cast s2; no (stop).\n423\t        game = create_game(scripts=([True, s1, True, s2, False], []))\n424\t        p1 = game.players[0]\n425\t        card = _capstone_on_battlefield_owner(game, 0)\n426\t        _set_library(game, 0, [s2, s1])  # top -> s1\n427\t\n428\t        card.on_resolve(game)\n429\t\n430\t        assert not p1.zones[Zone.EXILE].contains(s1)\n431\t        assert not p1.zones[Zone.EXILE].contains(s2)\n432\t        sources = [obj.source for obj in game.stack.objects()]\n433\t        assert s1 in sources\n434\t        assert s2 in sources\n435\t\n436\t    def test_lands_among_exiled_cards_are_not_castable(self) -> None:\n437\t        \"\"\"Lands are not spells; they cannot be cast and stay in exile.\"\"\"\n438\t        land = _land(\"Exiled Land\")  # mv 0, not a spell\n439\t        payoff = _sorcery(\"Payoff\", \"{4}\")\n440\t        # Decline casting any spell; verify the land never leaves exile.\n441\t        game = create_game(scripts=([False], []))\n442\t        p1 = game.players[0]\n443\t        card = _capstone_on_battlefield_owner(game, 0)\n444\t        _set_library(game, 0, [payoff, land])  # top -> land\n445\t\n446\t        card.on_resolve(game)\n447\t\n448\t        # Both cards were exiled; the land remains in exile regardless.\n449\t        assert p1.zones[Zone.EXILE].contains(land)\n450\t        assert p1.zones[Zone.EXILE].contains(payoff)\n451\t\n452\t    def test_resolved_free_cast_spell_does_not_require_payment(self) -> None:\n453\t        \"\"\"The free-cast spell resolves even with the controller holding no\n454\t        mana — confirming it was genuinely cast without paying.\"\"\"\n455\t        spell = _instant(\"Cheap Instant\", \"{6}{R}\")  # expensive; no mana available\n456\t        game = create_game(scripts=([True, spell, False], []))\n457\t        p1 = game.players[0]\n458\t        card = _capstone_on_battlefield_owner(game, 0)\n459\t        _set_library(game, 0, [spell])\n460\t        set_board_state(game, 0, mana={})\n461\t\n462\t        _resolve_capstone(game, card)\n463\t\n464\t        # It must have actually been exiled and then cast — not left in the\n465\t        # library (which would mean the effect never ran).  An empty pool means\n466\t        # the only way it could have been cast is for free.\n467\t        assert not p1.zones[Zone.LIBRARY].contains(spell)\n468\t        # Having been cast and resolved, the non-permanent spell is no longer\n469\t        # on the stack nor still in exile — it went to the graveyard.\n470\t        assert game.stack.is_empty()\n471\t        assert not p1.zones[Zone.EXILE].contains(spell)\n472\t        assert p1.zones[Zone.GRAVEYARD].contains(spell)\n473\t\n474\t\n475\t# ---------------------------------------------------------------------------\n476\t# Paradigm — \"Then exile this spell.\"\n477\t# ---------------------------------------------------------------------------\n478\t\n479\t\n480\tclass TestParadigmExileThisSpell:\n481\t    \"\"\"Paradigm: after resolving, the spell is exiled rather than going to the\n482\t    graveyard.\"\"\"\n483\t\n484\t    def test_capstone_is_exiled_after_resolving_via_cast_pipeline(self) -> None:\n485\t        \"\"\"When cast and resolved through the real pipeline, Improvisation\n486\t        Capstone ends up in exile, not the graveyard (\"Then exile this\n487\t        spell.\").\"\"\"\n488\t        from engine.casting import cast_spell\n489\t\n490\t        game = create_game()\n491\t        p1 = game.players[0]\n492\t        capstone = ImprovisationCapstone(owner=p1, controller=p1)\n493\t        # A target/free-cast-free run: empty library so the main effect is a\n494\t        # no-op, isolating the \"exile this spell\" clause.\n495\t        _set_library(game, 0, [])\n496\t        set_board_state(game, 0, hand=[capstone], mana={})\n497\t        # Pay nothing — set the pool to exactly the cost so cast_spell succeeds.\n498\t        from engine.types import ManaType\n499\t\n500\t        set_board_state(\n501\t            game,\n502\t            0,\n503\t            mana={ManaType.RED: 2, ManaType.COLORLESS: 5},\n504\t        )\n505\t        # Sorcery-speed timing.\n506\t        from engine.types import Phase\n507\t\n508\t        game.active_player_index = 0\n509\t        game.priority_player_index = 0\n510\t        game.phase = Phase.PRECOMBAT_MAIN\n511\t        game.step = None\n512\t\n513\t        cast_spell(game, p1, capstone)\n514\t        # Resolve the spell.\n515\t        while not game.stack.is_empty():\n516\t            obj = game.stack.pop()\n517\t            obj.on_resolve(game)\n518\t\n519\t        assert p1.zones[Zone.EXILE].contains(capstone)\n520\t        assert not p1.zones[Zone.GRAVEYARD].contains(capstone)\n521\t\n522\t\n523\t# ---------------------------------------------------------------------------\n524\t# Paradigm — copy-cast-from-exile mechanism\n525\t# ---------------------------------------------------------------------------\n526\t\n527\t\n528\tclass TestParadigmCopyMechanism:\n529\t    \"\"\"Paradigm: after first resolving, a free copy can be cast from exile at\n530\t    the beginning of each of your first main phases.\n531\t\n532\t    The exact engine API for this brand-new mechanic is unknown at red-phase\n533\t    time, so these probe the observable surface tolerantly: the card should\n534\t    expose a way to materialise a copy of itself (a factory and/or a copy that\n535\t    lands in exile and is castable for free).\n536\t    \"\"\"\n537\t\n538\t    def test_card_exposes_a_paradigm_copy_factory(self) -> None:\n539\t        \"\"\"The card advertises ``make_paradigm_copy`` for the Paradigm delayed\n540\t        ability — a callable returning a fresh same-named copy.\"\"\"\n541\t        card = ImprovisationCapstone(owner=None)\n542\t        factory = card.make_paradigm_copy\n543\t        assert callable(factory)\n544\t        copy = factory()\n545\t        assert isinstance(copy, ImprovisationCapstone)\n546\t        assert copy is not card\n547\t        assert copy.name == card.name\n548\t\n549\t    def test_paradigm_copy_can_be_cast_for_free_from_exile(self) -> None:\n550\t        \"\"\"A Paradigm copy placed in exile can be cast for free (it leaves\n551\t        exile and goes on the stack without paying mana).\"\"\"\n552\t        from engine.casting import cast_spell_free\n553\t\n554\t        game = create_game()\n555\t        p1 = game.players[0]\n556\t        card = ImprovisationCapstone(owner=p1, controller=p1)\n557\t        copy = card.make_paradigm_copy()\n558\t        copy.owner = p1\n559\t        copy.controller = p1\n560\t        p1.zones[Zone.EXILE].add(copy)\n561\t        set_board_state(game, 0, mana={})  # no mana — free cast only\n562\t\n563\t        cast_spell_free(game, p1, copy, Zone.EXILE)\n564\t\n565\t        assert not p1.zones[Zone.EXILE].contains(copy)\n566\t        assert not game.stack.is_empty()\n567\t        assert game.stack.peek().source is copy\n568\t\n569\t\n570\t# ---------------------------------------------------------------------------\n571\t# Paradigm — recurring per-main-phase copy delivery + first-resolution gate\n572\t# ---------------------------------------------------------------------------\n573\t\n574\t\n575\tclass TestParadigmFirstResolutionGate:\n576\t    \"\"\"Paradigm: \"After you *first* resolve a spell with this name, ...\"\n577\t\n578\t    The recurring per-main-phase copy is gated on the first resolution of a\n579\t    spell with this name.  Before that first resolution, the controller's\n580\t    precombat main-phase event must produce no copy and the gate must read as\n581\t    closed.\n582\t    \"\"\"\n583\t\n584\t    def test_gate_closed_before_capstone_resolves(self) -> None:\n585\t        \"\"\"Before any Capstone resolves, the gate reads as closed for the\n586\t        controller.\"\"\"\n587\t        game = create_game()\n588\t        p1 = game.players[0]\n589\t        assert has_paradigm_resolved(game, p1, CAPSTONE_NAME) is False\n590\t\n591\t    def test_no_copy_before_first_resolution(self) -> None:\n592\t        \"\"\"Firing the controller's precombat main-phase event BEFORE the\n593\t        Capstone has ever resolved creates no copy in exile (the gate is\n594\t        closed, and no recurring trigger has been wired).\"\"\"\n595\t        game = create_game()\n596\t        p1 = game.players[0]\n597\t\n598\t        _fire_main_phase_begin(game, p1, precombat=True)\n599\t\n600\t        assert _capstone_copies_in_exile(p1) == []\n601\t        assert game.stack.is_empty()\n602\t        assert has_paradigm_resolved(game, p1, CAPSTONE_NAME) is False\n603\t\n604\t    def test_resolving_capstone_opens_the_gate(self) -> None:\n605\t        \"\"\"Resolving an Improvisation Capstone marks the first resolution so the\n606\t        gate reads as open for the controller afterwards.\"\"\"\n607\t        game = create_game()\n608\t        p1 = game.players[0]\n609\t        card = _capstone_on_battlefield_owner(game, 0)\n610\t        _set_library(game, 0, [])\n611\t\n612\t        assert has_paradigm_resolved(game, p1, CAPSTONE_NAME) is False\n613\t        card.on_resolve(game)\n614\t\n615\t        assert has_paradigm_resolved(game, p1, CAPSTONE_NAME) is True\n616\t\n617\t\n618\tclass TestParadigmRecurringCopyDelivery:\n619\t    \"\"\"Paradigm: \"... at the beginning of *each* of your first main phases.\"\n620\t\n621\t    After the first resolution wires the recurring trigger, every one of the\n622\t    controller's precombat main phases produces a fresh free copy in exile.\n623\t    These tests script the copy offer to DECLINE (``choose_yes_no`` -> False) so\n624\t    the copy stays in exile to be observed.\n625\t    \"\"\"\n626\t\n627\t    def _wired_game(self, *, decline_count: int = 4) -> tuple[Any, Any]:\n628\t        \"\"\"A game whose controller has resolved a Capstone (gate open, trigger\n629\t        wired) and whose script declines every paradigm copy offer.\n630\t\n631\t        ``decline_count`` provides enough scripted ``False`` answers for the\n632\t        number of times the test will fire the main-phase event.\n633\t        \"\"\"\n634\t        game = create_game(scripts=([False] * decline_count, []))\n635\t        p1 = game.players[0]\n636\t        card = _capstone_on_battlefield_owner(game, 0)\n637\t        _set_library(game, 0, [])\n638\t        card.on_resolve(game)\n639\t        return game, p1\n640\t\n641\t    def test_one_copy_appears_on_first_main_phase_after_resolution(self) -> None:\n642\t        \"\"\"After resolution, the controller's first precombat main phase creates\n643\t        exactly one new Capstone copy in exile (offer declined).\"\"\"\n644\t        game, p1 = self._wired_game()\n645\t        # The resolved Capstone itself is redirected to exile only through the\n646\t        # full cast pipeline; here on_resolve was called directly, so exile\n647\t        # holds no Capstone copy yet.\n648\t        assert _capstone_copies_in_exile(p1) == []\n649\t\n650\t        _fire_main_phase_begin(game, p1, precombat=True)\n651\t\n652\t        copies = _capstone_copies_in_exile(p1)\n653\t        assert len(copies) == 1\n654\t        # The delivered copy is a genuine Improvisation Capstone copy, distinct\n655\t        # from the original spell object.\n656\t        assert copies[0] is not None\n657\t        assert copies[0].name == CAPSTONE_NAME\n658\t\n659\t    def test_recurs_a_second_copy_on_the_next_main_phase(self) -> None:\n660\t        \"\"\"Firing the precombat main-phase event AGAIN yields a SECOND copy —\n661\t        proving the ability recurs (contrast the sos_57 one-shot delayed\n662\t        trigger, which fires exactly once).\"\"\"\n663\t        game, p1 = self._wired_game()\n664\t\n665\t        _fire_main_phase_begin(game, p1, precombat=True)\n666\t        assert len(_capstone_copies_in_exile(p1)) == 1\n667\t\n668\t        _fire_main_phase_begin(game, p1, precombat=True)\n669\t        assert len(_capstone_copies_in_exile(p1)) == 2\n670\t\n671\t    def test_recurring_trigger_is_not_consumed(self) -> None:\n672\t        \"\"\"The recurring trigger remains registered after it fires (it is NOT a\n673\t        one-shot delayed trigger).\"\"\"\n674\t        game, p1 = self._wired_game()\n675\t\n676\t        capstone_triggers_before = [\n677\t            t\n678\t            for t in game.trigger_manager.get_triggers()\n679\t            if t.controller is p1\n680\t        ]\n681\t        assert len(capstone_triggers_before) == 1\n682\t\n683\t        _fire_main_phase_begin(game, p1, precombat=True)\n684\t\n685\t        capstone_triggers_after = [\n686\t            t\n687\t            for t in game.trigger_manager.get_triggers()\n688\t            if t.controller is p1\n689\t        ]\n690\t        # Still exactly one — the recurring trigger survives firing.\n691\t        assert len(capstone_triggers_after) == 1\n692\t\n693\t\n694\tclass TestParadigmCopyGating:\n695\t    \"\"\"The recurring copy is gated by player and by phase.\"\"\"\n696\t\n697\t    def _wired_game(self, *, decline_count: int = 4) -> tuple[Any, Any, Any]:\n698\t        game = create_game(scripts=([False] * decline_count, [False] * decline_count))\n699\t        p1, p2 = game.players\n700\t        card = _capstone_on_battlefield_owner(game, 0)\n701\t        _set_library(game, 0, [])\n702\t        card.on_resolve(game)\n703\t        return game, p1, p2\n704\t\n705\t    def test_postcombat_main_phase_creates_no_copy(self) -> None:\n706\t        \"\"\"\"your *first* main phases\" — the postcombat main (``precombat=False``)\n707\t        does not deliver a copy.\"\"\"\n708\t        game, p1, _p2 = self._wired_game()\n709\t\n710\t        _fire_main_phase_begin(game, p1, precombat=False)\n711\t\n712\t        assert _capstone_copies_in_exile(p1) == []\n713\t\n714\t    def test_opponents_main_phase_creates_no_copy_for_controller(self) -> None:\n715\t        \"\"\"\"*your* first main phases\" — the opponent's precombat main phase does\n716\t        not deliver a copy to either player.\"\"\"\n717\t        game, p1, p2 = self._wired_game()\n718\t\n719\t        _fire_main_phase_begin(game, p2, precombat=True)\n720\t\n721\t        assert _capstone_copies_in_exile(p1) == []\n722\t        assert _capstone_copies_in_exile(p2) == []\n723\t\n724\t    def test_opponent_phase_then_controller_phase_delivers_once(self) -> None:\n725\t        \"\"\"The opponent's main phase is inert; the controller's then delivers\n726\t        exactly one copy.\"\"\"\n727\t        game, p1, p2 = self._wired_game()\n728\t\n729\t        _fire_main_phase_begin(game, p2, precombat=True)\n730\t        assert _capstone_copies_in_exile(p1) == []\n731\t\n732\t        _fire_main_phase_begin(game, p1, precombat=True)\n733\t        assert len(_capstone_copies_in_exile(p1)) == 1\n734\t\n735\t\n736\tclass TestParadigmCopyAcceptCast:\n737\t    \"\"\"The per-main-phase copy may be cast for free from exile (accept path).\"\"\"\n738\t\n739\t    def test_accepting_casts_the_copy_for_free_from_exile(self) -> None:\n740\t        \"\"\"When the controller accepts (``choose_yes_no`` -> True), the copy is\n741\t        cast for free: it leaves exile and lands on the stack.\n742\t\n743\t        The stack is inspected BEFORE draining so the freshly-cast copy is\n744\t        observed on the stack (resolving it would run the copy's own effect and\n745\t        move it onward).\"\"\"\n746\t        # Accept the paradigm copy offer.\n747\t        game = create_game(scripts=([True], []))\n748\t        p1 = game.players[0]\n749\t        card = _capstone_on_battlefield_owner(game, 0)\n750\t        _set_library(game, 0, [])\n751\t        card.on_resolve(game)\n752\t        set_board_state(game, 0, mana={})  # no mana — free cast only\n753\t\n754\t        # Fire the event but do not drain: the trigger body runs when its\n755\t        # StackObject resolves, so resolve only the trigger and then inspect.\n756\t        _fire_main_phase_begin(game, p1, precombat=True, drain=False)\n757\t        # Resolve the trigger itself (its effect calls offer_paradigm_copy,\n758\t        # which creates the copy and free-casts it onto the stack).\n759\t        assert not game.stack.is_empty()\n760\t        trigger_obj = game.stack.pop()\n761\t        trigger_obj.on_resolve(game)\n762\t\n763\t        # The accepted copy is now on the stack (cast for free) and no longer in\n764\t        # exile.\n765\t        assert not game.stack.is_empty()\n766\t        cast_copy = game.stack.peek().source\n767\t        assert isinstance(cast_copy, ImprovisationCapstone)\n768\t        assert not p1.zones[Zone.EXILE].contains(cast_copy)\n769\t\n770\t    def test_declining_leaves_the_copy_in_exile(self) -> None:\n771\t        \"\"\"When the controller declines, the copy stays in exile (nothing is put\n772\t        on the stack by the offer).\"\"\"\n773\t        game = create_game(scripts=([False], []))\n774\t        p1 = game.players[0]\n775\t        card = _capstone_on_battlefield_owner(game, 0)\n776\t        _set_library(game, 0, [])\n777\t        card.on_resolve(game)\n778\t\n779\t        _fire_main_phase_begin(game, p1, precombat=True)\n780\t\n781\t        copies = _capstone_copies_in_exile(p1)\n782\t        assert len(copies) == 1\n783\t        # Declined — the copy remains in exile, nothing on the stack.\n784\t        assert p1.zones[Zone.EXILE].contains(copies[0])\n785\t        assert game.stack.is_empty()\n786\t\n787\t\n788\tclass TestParadigmRegisterDirectly:\n789\t    \"\"\"``register_paradigm`` is the public hook the card wires; driving it\n790\t    directly mirrors the recurring delivery without the full on_resolve path.\"\"\"\n791\t\n792\t    def test_register_paradigm_opens_gate_and_delivers_recurring_copies(self) -> None:\n793\t        \"\"\"Calling ``register_paradigm`` opens the gate and installs the\n794\t        recurring trigger; firing the controller's precombat main phase then\n795\t        delivers copies repeatedly.\"\"\"\n796\t        game = create_game(scripts=([False, False], []))\n797\t        p1 = game.players[0]\n798\t        card = ImprovisationCapstone(owner=p1, controller=p1)\n799\t\n800\t        register_paradigm(\n801\t            game,\n802\t            source=card,\n803\t            controller=p1,\n804\t            factory=card.make_paradigm_copy,\n805\t            name=CAPSTONE_NAME,\n806\t        )\n807\t\n808\t        assert has_paradigm_resolved(game, p1, CAPSTONE_NAME) is True\n809\t\n810\t        _fire_main_phase_begin(game, p1, precombat=True)\n811\t        assert len(_capstone_copies_in_exile(p1)) == 1\n812\t\n813\t        _fire_main_phase_begin(game, p1, precombat=True)\n814\t        assert len(_capstone_copies_in_exile(p1)) == 2\n815\t\n816\t\n817\tif __name__ == \"__main__\":  # pragma: no cover\n818\t    raise SystemExit(pytest.main([__file__, \"-v\"]))\n819\t"}]},"parent_tool_use_id":"toolu_01SjZQCEbiximMqCdwAdjEmg","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"fa49457e-5de2-4ca6-b6a3-d6cb59e39c74","timestamp":"2026-06-02T09:00:21.725Z","subagent_type":"Reviewer","task_description":"Review sos_120 implementation"}
