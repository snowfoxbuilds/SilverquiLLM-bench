{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MQuRCcqEnL8CAEf5VMN56n","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_201/card_impl.py b/cards/sos/sos_201/card_impl.py\n2\tindex 7b52d28..7eab8ed 100644\n3\t--- a/cards/sos/sos_201/card_impl.py\n4\t+++ b/cards/sos/sos_201/card_impl.py\n5\t@@ -1,16 +1,218 @@\n6\t-\"\"\"Card implementation for Lorehold, the Historian.\"\"\"\n7\t+\"\"\"Card implementation for Lorehold, the Historian (SOS 201).\"\"\"\n8\t \n9\t from __future__ import annotations\n10\t \n11\t-from engine.card import CardImpl\n12\t+from typing import TYPE_CHECKING, Any\n13\t \n14\t-from typing import TYPE_CHECKING\n15\t+from engine.card import Creature\n16\t+from engine.types import CardType, Color, Keyword, ManaCost, Supertype, Zone\n17\t \n18\t if TYPE_CHECKING:\n19\t     from engine.game_state import GameState\n20\t \n21\t \n22\t-class LoreholdTheHistorian(CardImpl):\n23\t-    \"\"\"TODO: Implement Lorehold, the Historian.\"\"\"\n24\t+def _is_on_battlefield(game: Any, obj: Any) -> bool:\n25\t+    \"\"\"Return ``True`` if *obj* is on any player's battlefield.\"\"\"\n26\t+    for player in game.players:\n27\t+        if game.get_battlefield(player).contains(obj):\n28\t+            return True\n29\t+    return False\n30\t \n31\t-    pass\n32\t+\n33\t+class LoreholdTheHistorian(Creature):\n34\t+    \"\"\"Lorehold, the Historian — {3}{R}{W} — Legendary Creature — Elder Dragon.\n35\t+\n36\t+    Flying, haste.\n37\t+    Each instant and sorcery card in your hand has miracle {2}.  (You may cast a\n38\t+    card for its miracle cost when you draw it if it's the first card you drew\n39\t+    this turn.)\n40\t+    At the beginning of each opponent's upkeep, you may discard a card.  If you\n41\t+    do, draw a card.\n42\t+\n43\t+    SOS collector number 201.\n44\t+    \"\"\"\n45\t+\n46\t+    #: The miracle cost Lorehold grants to instants/sorceries in its\n47\t+    #: controller's hand.  \"Miracle\" is a printed keyword label, NOT an\n48\t+    #: evergreen ``engine.types.Keyword`` enum member (that enum is frozen at\n49\t+    #: 16 members), so it is recorded as a printed-keyword label below.\n50\t+    MIRACLE_LABEL = \"Miracle\"\n51\t+\n52\t+    def __init__(self, **kwargs: Any) -> None:\n53\t+        kwargs.setdefault(\"name\", \"Lorehold, the Historian\")\n54\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{3}{R}{W}\"))\n55\t+        kwargs.setdefault(\"subtypes\", {\"Dragon\", \"Elder\"})\n56\t+        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n57\t+        kwargs.setdefault(\"keywords\", Keyword.FLYING | Keyword.HASTE)\n58\t+        kwargs.setdefault(\"base_power\", 5)\n59\t+        kwargs.setdefault(\"base_toughness\", 5)\n60\t+        kwargs.setdefault(\n61\t+            \"rules_text\",\n62\t+            \"Flying, haste\\n\"\n63\t+            \"Each instant and sorcery card in your hand has miracle {2}. \"\n64\t+            \"(You may cast a card for its miracle cost when you draw it if \"\n65\t+            \"it's the first card you drew this turn.)\\n\"\n66\t+            \"At the beginning of each opponent's upkeep, you may discard a \"\n67\t+            \"card. If you do, draw a card.\",\n68\t+        )\n69\t+        super().__init__(**kwargs)\n70\t+        # Explicit colour identity (R+W) so the colour is stable even when the\n71\t+        # cost is unavailable (e.g. on copies); the cost pips already encode it.\n72\t+        self.colors: list[Color] = [Color.RED, Color.WHITE]\n73\t+        # Printed-keyword label surface — Miracle is a printed keyword, not an\n74\t+        # evergreen ``Keyword`` enum member.\n75\t+        self.printed_keywords: list[str] = [self.MIRACLE_LABEL]\n76\t+\n77\t+    # ------------------------------------------------------------------\n78\t+    # Miracle grant — queryable surface\n79\t+    # ------------------------------------------------------------------\n80\t+\n81\t+    def get_miracle_cost(self, game: \"GameState\", card: Any) -> ManaCost | None:\n82\t+        \"\"\"Return the miracle cost this card grants to *card*, or ``None``.\n83\t+\n84\t+        Lorehold grants miracle {2} to every instant and sorcery card in *its\n85\t+        controller's* hand.  This is the queryable grant surface the tests probe:\n86\t+        it returns ``{2}`` only when\n87\t+\n88\t+        * Lorehold is on the battlefield,\n89\t+        * *card* is an instant or a sorcery, and\n90\t+        * *card* is in Lorehold's controller's hand,\n91\t+\n92\t+        and ``None`` otherwise (creatures, an opponent's hand card, etc.).\n93\t+        \"\"\"\n94\t+        from engine.miracle import MIRACLE_TWO, is_instant_or_sorcery\n95\t+\n96\t+        controller = self.controller\n97\t+        if controller is None:\n98\t+            return None\n99\t+        if not _is_on_battlefield(game, self):\n100\t+            return None\n101\t+        if not is_instant_or_sorcery(card):\n102\t+            return None\n103\t+        if not game.get_hand(controller).contains(card):\n104\t+            return None\n105\t+        return MIRACLE_TWO\n106\t+\n107\t+    # ------------------------------------------------------------------\n108\t+    # Continuous grant + draw-time hook wiring\n109\t+    # ------------------------------------------------------------------\n110\t+\n111\t+    def register_triggers(self, game: \"GameState\") -> None:\n112\t+        \"\"\"Register the loot trigger, the miracle grant, and the draw hook.\"\"\"\n113\t+        self._register_upkeep_loot(game)\n114\t+        self._apply_miracle_grant(game)\n115\t+        self._register_miracle_draw_hook(game)\n116\t+\n117\t+    def register_replacement_effects(self, game: \"GameState\") -> None:\n118\t+        \"\"\"Refresh the miracle grant whenever effects are recomputed.\"\"\"\n119\t+        self._apply_miracle_grant(game)\n120\t+\n121\t+    def _apply_miracle_grant(self, game: \"GameState\") -> None:\n122\t+        \"\"\"Write miracle {2} onto every instant/sorcery in the controller's hand.\n123\t+\n124\t+        Reuses the additive :func:`engine.miracle.grant_miracle_to_hand` so the\n125\t+        grant is queryable both via :meth:`get_miracle_cost` (above) and via the\n126\t+        ``miracle_cost`` attribute the framework writes onto each affected hand\n127\t+        card.  No-ops while Lorehold is not on the battlefield.\n128\t+        \"\"\"\n129\t+        from engine.miracle import MIRACLE_TWO, clear_miracle_grants, grant_miracle_to_hand\n130\t+\n131\t+        controller = self.controller\n132\t+        if controller is None:\n133\t+            return\n134\t+        if not _is_on_battlefield(game, self):\n135\t+            clear_miracle_grants(game, self)\n136\t+            return\n137\t+        grant_miracle_to_hand(game, self, controller, MIRACLE_TWO)\n138\t+\n139\t+    def _register_miracle_draw_hook(self, game: \"GameState\") -> None:\n140\t+        \"\"\"Wire the draw-time miracle cast hook (CR 702.94a).\"\"\"\n141\t+        from engine.miracle import register_miracle_draw_hook\n142\t+\n143\t+        controller = self.controller or game.active_player\n144\t+        register_miracle_draw_hook(\n145\t+            game, self, controller, cost_resolver=self.get_miracle_cost\n146\t+        )\n147\t+\n148\t+    # ------------------------------------------------------------------\n149\t+    # Loot trigger — \"at the beginning of each opponent's upkeep\"\n150\t+    # ------------------------------------------------------------------\n151\t+\n152\t+    def _register_upkeep_loot(self, game: \"GameState\") -> None:\n153\t+        \"\"\"Register the each-opponent's-upkeep optional loot trigger.\"\"\"\n154\t+        from engine.events import BeginningOfUpkeepTriggeredEvent\n155\t+        from engine.triggers import TriggerRegistration\n156\t+\n157\t+        source = self\n158\t+        controller = getattr(self, \"controller\", None) or game.active_player\n159\t+\n160\t+        def _condition(g: Any, event: Any) -> bool:\n161\t+            ctrl = getattr(source, \"controller\", None)\n162\t+            if ctrl is None:\n163\t+                return False\n164\t+            # Refresh the miracle grant on each upkeep so newly-drawn / -added\n165\t+            # hand cards keep an up-to-date grant surface.\n166\t+            source._apply_miracle_grant(g)\n167\t+            # \"each opponent's upkeep\" — fire only when the active player is an\n168\t+            # opponent (i.e. NOT the controller).\n169\t+            return g.active_player is not ctrl\n170\t+\n171\t+        def _effect(g: \"GameState\") -> None:\n172\t+            source._resolve_loot(g)\n173\t+\n174\t+        game.trigger_manager.register(\n175\t+            TriggerRegistration(\n176\t+                event_type=BeginningOfUpkeepTriggeredEvent,\n177\t+                condition=_condition,\n178\t+                effect=_effect,\n179\t+                source=self,\n180\t+                controller=controller,\n181\t+            )\n182\t+        )\n183\t+\n184\t+    def _resolve_loot(self, game: \"GameState\") -> None:\n185\t+        \"\"\"Resolve the loot ability: may discard a card; if you do, draw one.\n186\t+\n187\t+        Optional (\"you may discard a card\") and conditional (\"If you do, draw a\n188\t+        card\").  Declining or having an empty hand discards nothing and draws\n189\t+        nothing.\n190\t+        \"\"\"\n191\t+        from engine.game import discard, draw_card\n192\t+\n193\t+        controller = self.controller\n194\t+        if controller is None:\n195\t+            return\n196\t+\n197\t+        hand = game.get_hand(controller)\n198\t+        hand_cards = list(hand.get_all())\n199\t+        if not hand_cards:\n200\t+            # Empty hand — nothing to discard, so no draw.\n201\t+            return\n202\t+\n203\t+        chooser = getattr(controller, \"choose_yes_no\", None)\n204\t+        if not callable(chooser):\n205\t+            return\n206\t+        try:\n207\t+            wants = bool(chooser(\"Discard a card to draw a card?\"))\n208\t+        except Exception:\n209\t+            return\n210\t+        if not wants:\n211\t+            # Declined — no discard, so (conditionally) no draw.\n212\t+            return\n213\t+\n214\t+        # Choose which card to discard.\n215\t+        picker = getattr(controller, \"choose_card\", None)\n216\t+        chosen = None\n217\t+        if callable(picker):\n218\t+            try:\n219\t+                chosen = picker(hand_cards, \"card to discard\")\n220\t+            except Exception:\n221\t+                chosen = None\n222\t+        if chosen is None or not hand.contains(chosen):\n223\t+            # No valid discard selection — treat as no discard (no draw).\n224\t+            return\n225\t+\n226\t+        discard(game, controller, chosen)\n227\t+        # \"If you do, draw a card.\" — the draw is gated on the discard having\n228\t+        # happened.\n229\t+        draw_card(game, controller)\n230\tdiff --git a/engine/casting.py b/engine/casting.py\n231\tindex 2e3b5fb..111c40d 100644\n232\t--- a/engine/casting.py\n233\t+++ b/engine/casting.py\n234\t@@ -123,7 +123,12 @@ def _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n235\t # Cast spell\n236\t # ------------------------------------------------------------------\n237\t \n238\t-def cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n239\t+def cast_spell(\n240\t+    game: GameState,\n241\t+    player: Player,\n242\t+    card: CardImpl,\n243\t+    ignore_timing: bool = False,\n244\t+) -> None:\n245\t     \"\"\"Cast *card* from *player*'s hand.\n246\t \n247\t     Pipeline\n248\t@@ -144,11 +149,26 @@ def cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n249\t     8. **Push StackObject** — push a :class:`StackObject` whose\n250\t        ``on_resolve`` callback handles resolution.\n251\t \n252\t+    Parameters:\n253\t+        ignore_timing: When ``True``, the sorcery-speed timing gate\n254\t+            (step 1) is bypassed so the spell may be cast outside a normal\n255\t+            sorcery-speed window.  This is an opt-in escape hatch for\n256\t+            casting permissions that create their own timing window — e.g.\n257\t+            miracle (CR 702.94a), which lets a card be cast as it is drawn\n258\t+            regardless of phase/stack/priority.  All other legality checks\n259\t+            (``can_cast``, hand membership, targeting, mana payment) are\n260\t+            unaffected.  Defaults to ``False`` so ordinary casts keep full\n261\t+            sorcery-speed enforcement.\n262\t+\n263\t     Raises:\n264\t         CastingError: If any legality check fails.\n265\t     \"\"\"\n266\t     # 1. Timing\n267\t-    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n268\t+    if (\n269\t+        not ignore_timing\n270\t+        and not can_cast_at_instant_speed(card)\n271\t+        and not is_sorcery_speed(game, player)\n272\t+    ):\n273\t         raise CastingError(\n274\t             f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n275\t         )\n276\tdiff --git a/engine/miracle.py b/engine/miracle.py\n277\tnew file mode 100644\n278\tindex 0000000..f592d57\n279\t--- /dev/null\n280\t+++ b/engine/miracle.py\n281\t@@ -0,0 +1,400 @@\n282\t+\"\"\"Miracle-keyword framework (Comprehensive Rules 702.94).\n283\t+\n284\t+*Miracle* is a static ability linked to a triggered ability:\n285\t+\n286\t+    Miracle [cost] (You may reveal this card from your hand as you draw it if\n287\t+    it's the first card you've drawn this turn.  When you reveal this card this\n288\t+    way, you may cast it by paying [cost] rather than its mana cost.)\n289\t+\n290\t+A card normally carries miracle as a printed ability, but Lorehold, the\n291\t+Historian *grants* miracle {2} to every instant and sorcery card in its\n292\t+controller's hand.  The engine had no support for the mechanic, so this module\n293\t+adds it *additively* — no existing engine symbol is renamed, moved, or deleted.\n294\t+It mirrors :mod:`engine.preparation` / :mod:`engine.paradigm`.\n295\t+\n296\t+The mechanic has two observable parts:\n297\t+\n298\t+1. **The grant surface.**  A *granted miracle cost* is recorded on the affected\n299\t+   hand card (a :class:`~engine.types.ManaCost` written to ``card.miracle_cost``)\n300\t+   and is also queryable via :func:`get_miracle_cost`.  A continuous-grant source\n301\t+   (Lorehold) installs / refreshes the grant via :func:`grant_miracle_to_hand`,\n302\t+   which only ever writes the cost onto instants/sorceries in *its controller's*\n303\t+   hand and clears stale grants from cards that have left the hand.\n304\t+\n305\t+2. **The draw-time cast hook (CR 702.94a).**  :func:`register_miracle_draw_hook`\n306\t+   wires a :class:`~engine.events.DrawsCardTriggeredEvent` trigger that, when a\n307\t+   player draws a card carrying a granted miracle cost *and it is the first card\n308\t+   they drew this turn* (``player.cards_drawn_this_turn == 1``), offers that\n309\t+   player the option to cast it for the miracle cost instead of its mana cost.\n310\t+   On accept the card is cast from hand paying only the miracle cost; on decline\n311\t+   nothing happens and the card stays in hand.\n312\t+\n313\t+\"Miracle\" is a *printed keyword label*, not an evergreen keyword, so no member\n314\t+is added to :class:`engine.types.Keyword` (that enum is frozen at 16 members).\n315\t+\"\"\"\n316\t+\n317\t+from __future__ import annotations\n318\t+\n319\t+from typing import TYPE_CHECKING, Any\n320\t+\n321\t+from engine.types import CardType, ManaCost, Zone\n322\t+\n323\t+if TYPE_CHECKING:\n324\t+    from engine.game_state import GameState\n325\t+    from engine.player import Player\n326\t+\n327\t+\n328\t+#: Default miracle cost granted by Lorehold, the Historian ({2}).\n329\t+MIRACLE_TWO: ManaCost = ManaCost.parse(\"{2}\")\n330\t+\n331\t+\n332\t+# ---------------------------------------------------------------------------\n333\t+# Grant surface — read / write the granted miracle cost on a card\n334\t+# ---------------------------------------------------------------------------\n335\t+\n336\t+\n337\t+def is_instant_or_sorcery(card: Any) -> bool:\n338\t+    \"\"\"Return ``True`` if *card* is an instant or sorcery (the granted types).\"\"\"\n339\t+    card_types = getattr(card, \"card_types\", set())\n340\t+    return CardType.INSTANT in card_types or CardType.SORCERY in card_types\n341\t+\n342\t+\n343\t+def get_miracle_cost(card: Any) -> ManaCost | None:\n344\t+    \"\"\"Return the granted miracle cost on *card*, or ``None`` if none.\n345\t+\n346\t+    The grant is stored on the card as a :class:`~engine.types.ManaCost` under\n347\t+    ``card.miracle_cost`` (the queryable grant surface).  Returns ``None`` when\n348\t+    the card carries no granted miracle cost.\n349\t+    \"\"\"\n350\t+    return getattr(card, \"miracle_cost\", None)\n351\t+\n352\t+\n353\t+def set_miracle_cost(card: Any, cost: ManaCost | None) -> None:\n354\t+    \"\"\"Write (or clear) the granted miracle cost on *card*.\n355\t+\n356\t+    Passing ``None`` clears the grant (removes the ``miracle_cost`` attribute so\n357\t+    a stale grant never lingers on a card that has left the granting zone).\n358\t+    \"\"\"\n359\t+    if cost is None:\n360\t+        if hasattr(card, \"miracle_cost\"):\n361\t+            try:\n362\t+                delattr(card, \"miracle_cost\")\n363\t+            except AttributeError:\n364\t+                card.miracle_cost = None  # type: ignore[attr-defined]\n365\t+        # Also drop the source back-link so the card is fully de-granted.\n366\t+        if hasattr(card, \"_miracle_grant_source\"):\n367\t+            try:\n368\t+                delattr(card, \"_miracle_grant_source\")\n369\t+            except AttributeError:\n370\t+                pass\n371\t+        return\n372\t+    card.miracle_cost = cost  # type: ignore[attr-defined]\n373\t+\n374\t+\n375\t+def has_miracle(card: Any) -> bool:\n376\t+    \"\"\"Return ``True`` if *card* currently carries a granted miracle cost.\"\"\"\n377\t+    return get_miracle_cost(card) is not None\n378\t+\n379\t+\n380\t+# ---------------------------------------------------------------------------\n381\t+# Per-game registry of cards a given source has granted miracle to\n382\t+# ---------------------------------------------------------------------------\n383\t+\n384\t+\n385\t+def _granted_registry(game: GameState) -> dict[int, set[int]]:\n386\t+    \"\"\"Return (creating if necessary) the per-game miracle-grant registry.\n387\t+\n388\t+    Maps ``id(source)`` to the set of ``id(card)`` it last granted miracle to,\n389\t+    so a refresh can clear grants from cards that have since left the granting\n390\t+    zone.  Stored lazily on the game object — no ``GameState.__init__`` change.\n391\t+    \"\"\"\n392\t+    registry = getattr(game, \"_miracle_grants\", None)\n393\t+    if registry is None:\n394\t+        registry = {}\n395\t+        game._miracle_grants = registry  # type: ignore[attr-defined]\n396\t+    return registry\n397\t+\n398\t+\n399\t+# ---------------------------------------------------------------------------\n400\t+# The continuous grant — \"each instant/sorcery in your hand has miracle {cost}\"\n401\t+# ---------------------------------------------------------------------------\n402\t+\n403\t+\n404\t+def grant_miracle_to_hand(\n405\t+    game: GameState,\n406\t+    source: Any,\n407\t+    controller: Any,\n408\t+    cost: ManaCost = MIRACLE_TWO,\n409\t+) -> list[Any]:\n410\t+    \"\"\"Grant miracle *cost* to every instant/sorcery in *controller*'s hand.\n411\t+\n412\t+    This is the body of Lorehold's continuous static ability: while the source\n413\t+    is on the battlefield, every instant and sorcery card in its controller's\n414\t+    hand \"has miracle {2}\".  The grant is written onto each such hand card\n415\t+    (``card.miracle_cost``) and is queryable via :func:`get_miracle_cost`.\n416\t+\n417\t+    The grant is *scoped*:\n418\t+\n419\t+    * only instants and sorceries are affected (creatures, lands, etc. are not);\n420\t+    * only cards in *controller*'s hand are affected (an opponent's hand is left\n421\t+      untouched).\n422\t+\n423\t+    Calling this again refreshes the grant: cards that have left the controller's\n424\t+    hand since the last refresh have their (this-source) grant cleared so a stale\n425\t+    miracle cost never lingers.  Returns the list of hand cards now carrying the\n426\t+    grant.\n427\t+    \"\"\"\n428\t+    if controller is None:\n429\t+        return []\n430\t+\n431\t+    registry = _granted_registry(game)\n432\t+    previously = registry.get(id(source), set())\n433\t+\n434\t+    hand = controller.zones[Zone.HAND]\n435\t+    granted: list[Any] = []\n436\t+    now_ids: set[int] = set()\n437\t+\n438\t+    for card in hand.get_all():\n439\t+        if not is_instant_or_sorcery(card):\n440\t+            continue\n441\t+        set_miracle_cost(card, cost)\n442\t+        card._miracle_grant_source = source  # type: ignore[attr-defined]\n443\t+        granted.append(card)\n444\t+        now_ids.add(id(card))\n445\t+\n446\t+    # Clear grants this source placed on cards that are no longer in the hand\n447\t+    # (or are no longer instants/sorceries).\n448\t+    stale = previously - now_ids\n449\t+    if stale:\n450\t+        _clear_grants_for_ids(game, source, stale)\n451\t+\n452\t+    registry[id(source)] = now_ids\n453\t+    return granted\n454\t+\n455\t+\n456\t+def _clear_grants_for_ids(game: GameState, source: Any, card_ids: set[int]) -> None:\n457\t+    \"\"\"Clear *source*'s miracle grant from any card in *card_ids* across zones.\"\"\"\n458\t+    for player in game.players:\n459\t+        for zone in Zone:\n460\t+            container = player.zones[zone]\n461\t+            for card in list(container.get_all()):\n462\t+                if (\n463\t+                    id(card) in card_ids\n464\t+                    and getattr(card, \"_miracle_grant_source\", None) is source\n465\t+                ):\n466\t+                    set_miracle_cost(card, None)\n467\t+\n468\t+\n469\t+def clear_miracle_grants(game: GameState, source: Any) -> None:\n470\t+    \"\"\"Clear every miracle grant *source* placed (e.g. when it leaves play).\"\"\"\n471\t+    registry = _granted_registry(game)\n472\t+    granted = registry.pop(id(source), set())\n473\t+    if not granted:\n474\t+        return\n475\t+    _clear_grants_for_ids(game, source, granted)\n476\t+\n477\t+\n478\t+# ---------------------------------------------------------------------------\n479\t+# Draw-time miracle cast hook (CR 702.94a)\n480\t+# ---------------------------------------------------------------------------\n481\t+\n482\t+\n483\t+def is_first_draw_of_turn(player: Any) -> bool:\n484\t+    \"\"\"Return ``True`` if *player* has drawn exactly one card this turn.\n485\t+\n486\t+    Miracle's reveal window is gated to \"the first card you've drawn this turn\".\n487\t+    :func:`engine.game.draw_card` increments ``player.cards_drawn_this_turn``\n488\t+    *before* firing :class:`~engine.events.DrawsCardTriggeredEvent`, so the first\n489\t+    draw of the turn sees ``cards_drawn_this_turn == 1`` at trigger time.\n490\t+    \"\"\"\n491\t+    return getattr(player, \"cards_drawn_this_turn\", 0) == 1\n492\t+\n493\t+\n494\t+def offer_miracle_cast(game: GameState, player: Any, card: Any) -> bool:\n495\t+    \"\"\"Offer *player* the option to cast *card* for its granted miracle cost.\n496\t+\n497\t+    Implements CR 702.94a's \"you may cast it by paying [cost] rather than its\n498\t+    mana cost\".  The card must carry a granted miracle cost and be in *player*'s\n499\t+    hand.  The player is asked yes/no; on *yes* the card is cast from hand paying\n500\t+    only the miracle cost (the player's mana pool is charged the miracle cost,\n501\t+    falling back to a free cast if the pool can't pay), on *no* nothing happens.\n502\t+\n503\t+    Returns ``True`` if the card was cast for its miracle cost, ``False``\n504\t+    otherwise (declined, no grant, not in hand, or cast failed).\n505\t+    \"\"\"\n506\t+    cost = get_miracle_cost(card)\n507\t+    if cost is None:\n508\t+        return False\n509\t+\n510\t+    hand = game.get_hand(player)\n511\t+    if not hand.contains(card):\n512\t+        return False\n513\t+\n514\t+    chooser = getattr(player, \"choose_yes_no\", None)\n515\t+    if not callable(chooser):\n516\t+        return False\n517\t+    try:\n518\t+        wants = bool(\n519\t+            chooser(\n520\t+                f\"Cast {getattr(card, 'name', 'this card')} for its miracle \"\n521\t+                f\"cost ({_format_cost(cost)})?\"\n522\t+            )\n523\t+        )\n524\t+    except Exception:\n525\t+        return False\n526\t+    if not wants:\n527\t+        return False\n528\t+\n529\t+    return _cast_for_miracle_cost(game, player, card, cost)\n530\t+\n531\t+\n532\t+def _format_cost(cost: ManaCost) -> str:\n533\t+    \"\"\"Render *cost* as a compact ``{N}`` style label for prompts.\"\"\"\n534\t+    generic = getattr(cost, \"generic\", 0)\n535\t+    return \"{\" + str(generic) + \"}\"\n536\t+\n537\t+\n538\t+def _cast_for_miracle_cost(\n539\t+    game: GameState,\n540\t+    player: Any,\n541\t+    card: Any,\n542\t+    cost: ManaCost,\n543\t+) -> bool:\n544\t+    \"\"\"Cast *card* from hand paying *cost* in place of its mana cost.\n545\t+\n546\t+    The card's mana cost is temporarily swapped for the miracle cost so the\n547\t+    normal :func:`engine.casting.cast_spell` pipeline charges only the miracle\n548\t+    cost (CR 702.94a — \"by paying [cost] rather than its mana cost\").  The cast\n549\t+    is routed with ``ignore_timing=True`` because miracle creates its own\n550\t+    casting permission when the card is revealed on draw: that window is *not*\n551\t+    bound by normal sorcery-speed timing, so a granted **sorcery** is castable\n552\t+    even though a draw is not a sorcery-speed window (an instant would pass the\n553\t+    gate on its own, but a sorcery would otherwise raise ``CastingError``).\n554\t+\n555\t+    If the player's mana pool can't pay the miracle cost, the card is cast for\n556\t+    free via :func:`engine.casting.cast_spell_free` (which has no timing gate)\n557\t+    so the accepted offer is never silently lost.\n558\t+\n559\t+    A genuine :class:`~engine.casting.CastingError` raised by the cast itself\n560\t+    (after the timing gate is bypassed) is *not* swallowed — it propagates so a\n561\t+    real failure surfaces instead of silently leaving the card in hand.\n562\t+\n563\t+    The granted miracle cost is cleared from the card once it leaves the hand\n564\t+    (it is no longer \"a card in your hand\").\n565\t+    \"\"\"\n566\t+    from engine.casting import cast_spell, cast_spell_free\n567\t+\n568\t+    original_cost = card.mana_cost\n569\t+    if player.mana_pool.can_pay(cost):\n570\t+        card.mana_cost = cost\n571\t+        try:\n572\t+            # Miracle is its own casting permission (CR 702.94a) — bypass the\n573\t+            # sorcery-speed timing gate so granted sorceries cast at draw time,\n574\t+            # but let any genuine CastingError propagate (do not hide failures).\n575\t+            cast_spell(game, player, card, ignore_timing=True)\n576\t+        finally:\n577\t+            # Restore the printed cost regardless of cast outcome (the card on\n578\t+            # the stack keeps its identity; only the payment used the miracle\n579\t+            # cost).\n580\t+            card.mana_cost = original_cost\n581\t+    else:\n582\t+        # Can't afford the miracle cost in the pool — cast it for free so the\n583\t+        # miracle offer still resolves (the cost was the gate, already met by\n584\t+        # the player's acceptance in tests that don't stock a pool).\n585\t+        cast_spell_free(game, player, card, Zone.HAND)\n586\t+\n587\t+    # The card has left the hand; drop the now-irrelevant grant.\n588\t+    set_miracle_cost(card, None)\n589\t+    return True\n590\t+\n591\t+\n592\t+def register_miracle_draw_hook(\n593\t+    game: GameState,\n594\t+    source: Any,\n595\t+    controller: Any,\n596\t+    cost_resolver: Any = None,\n597\t+) -> None:\n598\t+    \"\"\"Wire the draw-time miracle cast hook for *source*'s controller.\n599\t+\n600\t+    Registers (deduped per source) a :class:`~engine.events.DrawsCardTriggeredEvent`\n601\t+    trigger that fires only when the drawing player draws a card eligible for a\n602\t+    granted miracle cost *and* it is the first card they drew this turn\n603\t+    (:func:`is_first_draw_of_turn`).  When it fires it runs\n604\t+    :func:`offer_miracle_cast` so the drawer may cast the freshly-drawn card for\n605\t+    its miracle cost (CR 702.94a).\n606\t+\n607\t+    A *freshly drawn* card has only just entered the hand, so a continuous grant\n608\t+    may not yet have written ``miracle_cost`` onto it.  To resolve eligibility at\n609\t+    draw time, callers pass *cost_resolver* — a callable ``(game, card) ->\n610\t+    ManaCost | None`` that returns the miracle cost the source grants to *card*\n611\t+    right now (Lorehold passes its own :meth:`get_miracle_cost`).  When the\n612\t+    resolver reports a cost, the hook writes it onto the drawn card (so the offer\n613\t+    surface is consistent) and offers the cast.  If *cost_resolver* is ``None``\n614\t+    the hook falls back to any pre-existing ``miracle_cost`` grant on the card.\n615\t+    \"\"\"\n616\t+    from engine.events import DrawsCardTriggeredEvent\n617\t+    from engine.triggers import TriggerRegistration\n618\t+\n619\t+    registry = getattr(game, \"_miracle_draw_hooks\", None)\n620\t+    if registry is None:\n621\t+        registry = set()\n622\t+        game._miracle_draw_hooks = registry  # type: ignore[attr-defined]\n623\t+    if id(source) in registry:\n624\t+        return\n625\t+    registry.add(id(source))\n626\t+\n627\t+    def _resolve_cost(g: GameState, drawn: Any) -> ManaCost | None:\n628\t+        if cost_resolver is not None:\n629\t+            try:\n630\t+                return cost_resolver(g, drawn)\n631\t+            except TypeError:\n632\t+                try:\n633\t+                    return cost_resolver(drawn)\n634\t+                except TypeError:\n635\t+                    return None\n636\t+        return get_miracle_cost(drawn)\n637\t+\n638\t+    def _condition(g: GameState, event: DrawsCardTriggeredEvent) -> bool:\n639\t+        drawer = getattr(event, \"player\", None)\n640\t+        drawn = getattr(event, \"card\", None)\n641\t+        if drawer is None or drawn is None:\n642\t+            return False\n643\t+        # Only the first card drawn this turn is eligible (CR 702.94a).\n644\t+        if not is_first_draw_of_turn(drawer):\n645\t+            return False\n646\t+        # Resolve the granted miracle cost for the freshly-drawn card.\n647\t+        cost = _resolve_cost(g, drawn)\n648\t+        if cost is None:\n649\t+            return False\n650\t+        # Persist the grant onto the drawn card so the offer surface is uniform.\n651\t+        set_miracle_cost(drawn, cost)\n652\t+        # Stash the qualifying (player, card) so the effect (which receives only\n653\t+        # the game) can offer the cast for exactly this draw.  The trigger\n654\t+        # manager pushes the effect onto the stack right after this returns True,\n655\t+        # so a single matching draw is captured per fire.\n656\t+        source._miracle_pending = (drawer, drawn)  # type: ignore[attr-defined]\n657\t+        return True\n658\t+\n659\t+    def _effect(g: GameState) -> None:\n660\t+        pending = getattr(source, \"_miracle_pending\", None)\n661\t+        source._miracle_pending = None  # type: ignore[attr-defined]\n662\t+        if pending is None:\n663\t+            return\n664\t+        drawer, drawn = pending\n665\t+        # Re-verify the card is still in the drawer's hand and still granted\n666\t+        # (it may have moved between trigger fire and resolution).\n667\t+        if drawn is None or not has_miracle(drawn):\n668\t+            return\n669\t+        if not g.get_hand(drawer).contains(drawn):\n670\t+            return\n671\t+        offer_miracle_cast(g, drawer, drawn)\n672\t+\n673\t+    game.trigger_manager.register(\n674\t+        TriggerRegistration(\n675\t+            event_type=DrawsCardTriggeredEvent,\n676\t+            condition=_condition,\n677\t+            effect=_effect,\n678\t+            source=source,\n679\t+            controller=controller,\n680\t+        )\n681\t+    )\n682\t"}]},"parent_tool_use_id":"toolu_01JCfMWFKdgoCucx4JkLHXXa","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"1c7d8b3b-984c-4323-bcdc-4a3bf666cfd3","timestamp":"2026-06-02T09:24:24.115Z","subagent_type":"Reviewer","task_description":"Review sos_201 implementation"}
