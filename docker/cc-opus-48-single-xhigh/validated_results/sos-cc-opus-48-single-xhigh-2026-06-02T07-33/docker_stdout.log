{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J9o8e4S5NT1EzrELE2byDK","type":"tool_result","content":"1\t\"\"\"Tests for SOS 257 — Great Hall of the Biblioplex.\n2\t\n3\tGreat Hall of the Biblioplex — Land:\n4\t\n5\t    {T}: Add {C}.\n6\t    {T}, Pay 1 life: Add one mana of any color. Spend this mana only to cast\n7\t    an instant or sorcery spell.\n8\t    {5}: If this land isn't a creature, it becomes a 2/4 Wizard creature with\n9\t    \"Whenever you cast an instant or sorcery spell, this creature gets +1/+0\n10\t    until end of turn.\" It's still a land.\n11\t\n12\tBehaviour contract (TDD red phase — these tests fail against the empty stub).\n13\t\n14\t* **Static data** — a :class:`engine.card.Land` named ``\"Great Hall of the\n15\t  Biblioplex\"``, type line ``Land`` (``CardType.LAND`` only, never CREATURE\n16\t  while unanimated), no colors, no mana cost, and NOT a basic land (no\n17\t  ``Supertype.BASIC``).  Power/toughness are ``None`` while it is not a\n18\t  creature.\n19\t* **Ability 1 — {T}: Add {C}** — one mana ability that, when its cost runs,\n20\t  taps the land and adds exactly one ``COLORLESS`` mana to the controller's\n21\t  pool.  Modelled exactly on fdn_272 (Plains) / fdn_267 (Secluded Courtyard).\n22\t* **Ability 2 — {T}, Pay 1 life: any color (instant/sorcery only)** — a second\n23\t  mana ability that taps the land, reduces the controller's life by 1, and\n24\t  adds one mana of a chosen color.  The \"spend this mana only to cast an\n25\t  instant or sorcery spell\" restriction has no engine surface today (the\n26\t  ManaPool has no restricted-mana tagging — see fdn_267's documented engine\n27\t  limitation); that one clause is recorded in ``untestable.json``.\n28\t* **Ability 3 — {5}: animate** — an activated ability ({5}) that, while the\n29\t  land is not already a creature, turns it into a 2/4 Wizard creature that is\n30\t  STILL a land, with a granted \"Whenever you cast an instant or sorcery spell,\n31\t  this creature gets +1/+0 until end of turn\" trigger.  The engine has no\n32\t  becomes-a-creature animation pipeline nor an until-end-of-turn pump grant;\n33\t  the deep assertions are tolerant probes that fail loudly if the surface is\n34\t  absent, and the hardest pieces are recorded in ``untestable.json``.\n35\t\n36\tThe mana / activated abilities are exercised by reading the card's public\n37\tability surface (``get_mana_abilities`` / ``get_activated_abilities``) and\n38\tinvoking the cost/effect callables directly — the established per-card test\n39\tconvention used by the FDN reference land cards (fdn_272, fdn_267) and the\n40\tSOS reference cards.\n41\t\"\"\"\n42\t\n43\tfrom __future__ import annotations\n44\t\n45\tfrom typing import Any\n46\t\n47\timport pytest\n48\t\n49\tfrom cards.sos.sos_257.card_impl import GreatHallOfTheBiblioplex\n50\tfrom engine.card import ActivatedAbility, Creature, Land, ManaAbility\n51\tfrom engine.types import (\n52\t    CardType,\n53\t    Color,\n54\t    ManaCost,\n55\t    ManaType,\n56\t    Supertype,\n57\t)\n58\tfrom test_utils import create_game, set_board_state\n59\t\n60\t\n61\t# ---------------------------------------------------------------------------\n62\t# Helpers\n63\t# ---------------------------------------------------------------------------\n64\t\n65\t\n66\tdef _card(owner: Any = None, controller: Any = None) -> GreatHallOfTheBiblioplex:\n67\t    \"\"\"Build a Great Hall instance (owner == controller by default).\"\"\"\n68\t    return GreatHallOfTheBiblioplex(owner=owner, controller=controller)\n69\t\n70\t\n71\tdef _run_cost(ability: Any, game: Any, source: Any) -> bool:\n72\t    \"\"\"Invoke an ability cost callable, tolerating 1- or 2-arg signatures.\n73\t\n74\t    fdn_272 (Plains) uses a 1-arg ``cost(game)`` closure while fdn_267\n75\t    (Secluded Courtyard) uses a 2-arg ``cost(game, source)`` closure; both\n76\t    shapes are legal, so call accordingly.\n77\t    \"\"\"\n78\t    try:\n79\t        return bool(ability.cost(game, source))\n80\t    except TypeError:\n81\t        return bool(ability.cost(game))\n82\t\n83\t\n84\tdef _run_effect(ability: Any, game: Any, source: Any) -> None:\n85\t    \"\"\"Invoke a mana ability's ``mana_produced`` / effect callable.\n86\t\n87\t    ``ManaAbility.mana_produced`` may either *return* a ``{ManaType: int}``\n88\t    dict (fdn_272 style) or directly mutate the controller's pool (fdn_267\n89\t    style).  When it returns a dict, deposit it into the controller's pool\n90\t    so both conventions are observable through the pool.\n91\t    \"\"\"\n92\t    produced = ability.mana_produced(game)\n93\t    if isinstance(produced, dict):\n94\t        controller = source.controller\n95\t        for mana_type, amount in produced.items():\n96\t            controller.mana_pool.add(mana_type, amount)\n97\t\n98\t\n99\tdef _colorless_mana_ability(card: Any) -> ManaAbility:\n100\t    \"\"\"Return the ``{T}: Add {C}`` ability (the one that yields colorless).\"\"\"\n101\t    abilities = card.get_mana_abilities()\n102\t    for ab in abilities:\n103\t        # Probe each ability in a fresh game; pick the one that produces {C}.\n104\t        game = create_game()\n105\t        p = game.players[0]\n106\t        card.owner = p\n107\t        card.controller = p\n108\t        card.is_tapped = False\n109\t        if not _run_cost(ab, game, card):\n110\t            continue\n111\t        _run_effect(ab, game, card)\n112\t        if p.mana_pool.get(ManaType.COLORLESS) >= 1 and p.mana_pool.total() == 1:\n113\t            return ab\n114\t    raise AssertionError(\"No {T}: Add {C} mana ability found on Great Hall\")\n115\t\n116\t\n117\t# ---------------------------------------------------------------------------\n118\t# Static properties\n119\t# ---------------------------------------------------------------------------\n120\t\n121\t\n122\tclass TestGreatHallProperties:\n123\t    \"\"\"Static card data should match the SOS 257 spec.\"\"\"\n124\t\n125\t    def test_name(self) -> None:\n126\t        assert _card().name == \"Great Hall of the Biblioplex\"\n127\t\n128\t    def test_is_a_land(self) -> None:\n129\t        card = _card()\n130\t        assert isinstance(card, Land)\n131\t        assert CardType.LAND in card.card_types\n132\t\n133\t    def test_not_a_creature_while_unanimated(self) -> None:\n134\t        \"\"\"It is a plain land until {5} animates it.\"\"\"\n135\t        assert CardType.CREATURE not in _card().card_types\n136\t\n137\t    def test_has_no_mana_cost(self) -> None:\n138\t        \"\"\"Lands are played, not cast — no mana cost is printed.\"\"\"\n139\t        assert _card().mana_cost == ManaCost()\n140\t\n141\t    def test_cannot_be_cast(self) -> None:\n142\t        \"\"\"Lands return can_cast() == False (they are played as a special action).\"\"\"\n143\t        game = create_game()\n144\t        assert _card().can_cast(game) is False\n145\t\n146\t    def test_has_no_colors(self) -> None:\n147\t        \"\"\"A colorless land — no colored identity.\"\"\"\n148\t        from engine.protection import get_colors\n149\t\n150\t        assert get_colors(_card()) == set()\n151\t\n152\t    def test_is_not_a_basic_land(self) -> None:\n153\t        \"\"\"Great Hall is a nonbasic land — no BASIC supertype.\"\"\"\n154\t        assert Supertype.BASIC not in _card().supertypes\n155\t\n156\t    def test_has_no_basic_land_subtype(self) -> None:\n157\t        \"\"\"It is not a Plains/Island/Swamp/Mountain/Forest.\"\"\"\n158\t        basics = {\"Plains\", \"Island\", \"Swamp\", \"Mountain\", \"Forest\"}\n159\t        assert _card().subtypes.isdisjoint(basics)\n160\t\n161\t    def test_power_toughness_unset_while_not_a_creature(self) -> None:\n162\t        \"\"\"A non-creature land has no power/toughness characteristic.\n163\t\n164\t        Either the attributes are absent, or they read as ``None`` — never a\n165\t        concrete number while the card is an ordinary (non-creature) land.\n166\t        \"\"\"\n167\t        card = _card()\n168\t        assert getattr(card, \"power\", None) is None\n169\t        assert getattr(card, \"toughness\", None) is None\n170\t\n171\t\n172\t# ---------------------------------------------------------------------------\n173\t# Ability 1 — {T}: Add {C}\n174\t# ---------------------------------------------------------------------------\n175\t\n176\t\n177\tclass TestGreatHallColorlessManaAbility:\n178\t    \"\"\"{T}: Add {C} — a basic colorless mana ability.\"\"\"\n179\t\n180\t    def test_exposes_at_least_two_mana_abilities(self) -> None:\n181\t        \"\"\"The card prints two mana abilities (the {C} one and the any-color one).\"\"\"\n182\t        card = _card()\n183\t        abilities = card.get_mana_abilities()\n184\t        assert isinstance(abilities, list)\n185\t        assert len(abilities) >= 2\n186\t        assert all(isinstance(ab, ManaAbility) for ab in abilities)\n187\t\n188\t    def test_colorless_ability_taps_the_land(self) -> None:\n189\t        game = create_game()\n190\t        p1 = game.players[0]\n191\t        card = _card(owner=p1, controller=p1)\n192\t        card.is_tapped = False\n193\t        ab = _colorless_mana_ability(card)\n194\t        # Re-run the cost on a clean instance to assert the tap side effect.\n195\t        card.is_tapped = False\n196\t        assert _run_cost(ab, game, card) is True\n197\t        assert card.is_tapped is True\n198\t\n199\t    def test_colorless_ability_adds_one_colorless_mana(self) -> None:\n200\t        game = create_game()\n201\t        p1 = game.players[0]\n202\t        card = _card(owner=p1, controller=p1)\n203\t        card.is_tapped = False\n204\t        ab = _colorless_mana_ability(card)\n205\t        # Run the chosen ability for real against p1.\n206\t        card.is_tapped = False\n207\t        assert _run_cost(ab, game, card) is True\n208\t        _run_effect(ab, game, card)\n209\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 1\n210\t        assert p1.mana_pool.total() == 1\n211\t\n212\t    def test_colorless_ability_cost_fails_when_already_tapped(self) -> None:\n213\t        \"\"\"A tapped land cannot pay its {T} cost again.\"\"\"\n214\t        game = create_game()\n215\t        p1 = game.players[0]\n216\t        card = _card(owner=p1, controller=p1)\n217\t        ab = _colorless_mana_ability(card)\n218\t        card.is_tapped = True\n219\t        assert _run_cost(ab, game, card) is False\n220\t\n221\t\n222\t# ---------------------------------------------------------------------------\n223\t# Ability 2 — {T}, Pay 1 life: Add one mana of any color (instant/sorcery only)\n224\t# ---------------------------------------------------------------------------\n225\t\n226\t\n227\tclass TestGreatHallAnyColorManaAbility:\n228\t    \"\"\"{T}, Pay 1 life: Add one mana of any color (restricted to I/S casting).\"\"\"\n229\t\n230\t    def _any_color_ability(self, card: Any) -> ManaAbility:\n231\t        \"\"\"Return the second (any-color, pay-1-life) mana ability.\n232\t\n233\t        Identified positionally: the colorless ability is the {C} producer;\n234\t        the remaining mana ability is the any-color one.\n235\t        \"\"\"\n236\t        colorless = _colorless_mana_ability(card)\n237\t        others = [ab for ab in card.get_mana_abilities() if ab is not colorless]\n238\t        assert others, \"Great Hall must print a second (any-color) mana ability\"\n239\t        return others[0]\n240\t\n241\t    def test_any_color_ability_taps_the_land(self) -> None:\n242\t        game = create_game(scripts=([Color.BLUE], []))\n243\t        p1 = game.players[0]\n244\t        card = _card(owner=p1, controller=p1)\n245\t        ab = self._any_color_ability(card)\n246\t        card.is_tapped = False\n247\t        assert _run_cost(ab, game, card) is True\n248\t        assert card.is_tapped is True\n249\t\n250\t    def test_any_color_ability_pays_one_life(self) -> None:\n251\t        \"\"\"Activating the second ability reduces the controller's life by 1.\"\"\"\n252\t        game = create_game(scripts=([Color.RED], []))\n253\t        p1 = game.players[0]\n254\t        set_board_state(game, 0, life=20)\n255\t        card = _card(owner=p1, controller=p1)\n256\t        ab = self._any_color_ability(card)\n257\t        card.is_tapped = False\n258\t        before = p1.life\n259\t        _run_cost(ab, game, card)\n260\t        _run_effect(ab, game, card)\n261\t        assert p1.life == before - 1\n262\t\n263\t    def test_any_color_ability_adds_one_mana_of_chosen_color(self) -> None:\n264\t        \"\"\"The chosen color (here blue) is the single mana added.\"\"\"\n265\t        game = create_game(scripts=([Color.BLUE], []))\n266\t        p1 = game.players[0]\n267\t        card = _card(owner=p1, controller=p1)\n268\t        ab = self._any_color_ability(card)\n269\t        card.is_tapped = False\n270\t        _run_cost(ab, game, card)\n271\t        _run_effect(ab, game, card)\n272\t        assert p1.mana_pool.get(ManaType.BLUE) == 1\n273\t        # Exactly one mana of one color is produced.\n274\t        assert p1.mana_pool.total() == 1\n275\t\n276\t    def test_any_color_ability_can_produce_a_different_color(self) -> None:\n277\t        \"\"\"A different scripted color (green) is honoured — it is \"any color\".\"\"\"\n278\t        game = create_game(scripts=([Color.GREEN], []))\n279\t        p1 = game.players[0]\n280\t        card = _card(owner=p1, controller=p1)\n281\t        ab = self._any_color_ability(card)\n282\t        card.is_tapped = False\n283\t        _run_cost(ab, game, card)\n284\t        _run_effect(ab, game, card)\n285\t        assert p1.mana_pool.get(ManaType.GREEN) == 1\n286\t        assert p1.mana_pool.total() == 1\n287\t\n288\t    def test_any_color_mana_is_marked_restricted_to_instants_sorceries(self) -> None:\n289\t        \"\"\"The produced mana must carry an instant/sorcery-only spend restriction.\n290\t\n291\t        TOLERANT PROBE.  The engine's ``ManaPool`` has no restricted-mana\n292\t        tagging today (fdn_267 documents the same limitation), so there is no\n293\t        public way to add or read such a restriction.  This test fails loudly\n294\t        rather than passing vacuously: if a restriction surface is ever added\n295\t        (a tag on the pool, a per-mana restriction record, or a card-level\n296\t        query such as ``produces_restricted_mana``/``mana_spend_restriction``),\n297\t        it must be discoverable here.  Recorded in untestable.json until then.\n298\t        \"\"\"\n299\t        card = _card()\n300\t        ab = self._any_color_ability(card)\n301\t        restriction_surface = (\n302\t            hasattr(card, \"mana_spend_restriction\")\n303\t            or hasattr(card, \"produces_restricted_mana\")\n304\t            or hasattr(ab, \"restriction\")\n305\t            or hasattr(ab, \"spend_restriction\")\n306\t            or hasattr(create_game().players[0].mana_pool, \"restrictions\")\n307\t        )\n308\t        assert restriction_surface, (\n309\t            \"No engine surface to tag 'spend this mana only to cast an instant \"\n310\t            \"or sorcery spell' — see untestable.json\"\n311\t        )\n312\t\n313\t\n314\t# ---------------------------------------------------------------------------\n315\t# Ability 3 — {5}: becomes a 2/4 Wizard creature, still a land\n316\t# ---------------------------------------------------------------------------\n317\t\n318\t\n319\tclass TestGreatHallAnimationAbilitySurface:\n320\t    \"\"\"{5}: exposes a non-mana activated ability for the animation.\"\"\"\n321\t\n322\t    def test_exposes_an_activated_ability(self) -> None:\n323\t        \"\"\"The {5} animation is an activated (non-mana) ability.\"\"\"\n324\t        card = _card()\n325\t        abilities = card.get_activated_abilities()\n326\t        assert isinstance(abilities, list)\n327\t        assert len(abilities) >= 1\n328\t        assert all(isinstance(ab, ActivatedAbility) for ab in abilities)\n329\t\n330\t\n331\tclass TestGreatHallAnimationEffect:\n332\t    \"\"\"{5}: If this land isn't a creature, it becomes a 2/4 Wizard creature\n333\t    with a granted instant/sorcery pump trigger.  It's still a land.\n334\t\n335\t    The engine has no becomes-a-creature animation pipeline, so these are\n336\t    TOLERANT PROBES: they invoke the activated ability's effect and then\n337\t    assert the observable end state (added CREATURE type, Wizard subtype, 2/4,\n338\t    LAND retained).  They fail loudly if the animation surface is absent.\n339\t    The deepest pieces are also recorded in untestable.json.\n340\t    \"\"\"\n341\t\n342\t    def _activate(self, card: Any, game: Any) -> None:\n343\t        \"\"\"Pay the {5} cost (if a cost gate exists) and apply the effect.\"\"\"\n344\t        abilities = card.get_activated_abilities()\n345\t        assert abilities, \"Great Hall must print a {5} activated ability\"\n346\t        ab = abilities[0]\n347\t        # Pay the cost if the closure enforces one; tolerate either shape.\n348\t        try:\n349\t            ab.cost(game, card)\n350\t        except TypeError:\n351\t            try:\n352\t                ab.cost(game)\n353\t            except Exception:\n354\t                pass\n355\t        ab.effect(game)\n356\t\n357\t    def test_becomes_a_creature(self) -> None:\n358\t        game = create_game()\n359\t        p1 = game.players[0]\n360\t        card = _card(owner=p1, controller=p1)\n361\t        set_board_state(game, 0, battlefield=[card])\n362\t        assert CardType.CREATURE not in card.card_types\n363\t        self._activate(card, game)\n364\t        assert CardType.CREATURE in card.card_types\n365\t\n366\t    def test_is_still_a_land_after_animation(self) -> None:\n367\t        \"\"\"\"It's still a land.\" — LAND type is retained alongside CREATURE.\"\"\"\n368\t        game = create_game()\n369\t        p1 = game.players[0]\n370\t        card = _card(owner=p1, controller=p1)\n371\t        set_board_state(game, 0, battlefield=[card])\n372\t        self._activate(card, game)\n373\t        assert CardType.LAND in card.card_types\n374\t\n375\t    def test_becomes_a_wizard(self) -> None:\n376\t        game = create_game()\n377\t        p1 = game.players[0]\n378\t        card = _card(owner=p1, controller=p1)\n379\t        set_board_state(game, 0, battlefield=[card])\n380\t        self._activate(card, game)\n381\t        assert \"Wizard\" in card.subtypes\n382\t\n383\t    def test_becomes_two_four(self) -> None:\n384\t        \"\"\"The animated land is a 2/4.\"\"\"\n385\t        game = create_game()\n386\t        p1 = game.players[0]\n387\t        card = _card(owner=p1, controller=p1)\n388\t        set_board_state(game, 0, battlefield=[card])\n389\t        self._activate(card, game)\n390\t        # Recompute continuous effects so layer-based P/T (if any) is applied.\n391\t        game.effect_manager.apply_all(game)\n392\t        assert getattr(card, \"power\", None) == 2\n393\t        assert getattr(card, \"toughness\", None) == 4\n394\t\n395\t    def test_animation_no_op_when_already_a_creature(self) -> None:\n396\t        \"\"\"\"If this land isn't a creature\" — a second activation is a no-op.\n397\t\n398\t        Animating an already-animated Great Hall must not stack a second\n399\t        pump grant or change its 2/4 body.\n400\t        \"\"\"\n401\t        game = create_game()\n402\t        p1 = game.players[0]\n403\t        card = _card(owner=p1, controller=p1)\n404\t        set_board_state(game, 0, battlefield=[card])\n405\t        self._activate(card, game)\n406\t        game.effect_manager.apply_all(game)\n407\t        triggers_after_first = len(game.trigger_manager.get_triggers())\n408\t        # Second activation while already a creature should change nothing.\n409\t        self._activate(card, game)\n410\t        game.effect_manager.apply_all(game)\n411\t        assert getattr(card, \"power\", None) == 2\n412\t        assert getattr(card, \"toughness\", None) == 4\n413\t        assert len(game.trigger_manager.get_triggers()) == triggers_after_first\n414\t\n415\t\n416\tclass TestGreatHallGrantedPumpTrigger:\n417\t    \"\"\"The animated creature gets +1/+0 until end of turn per instant/sorcery\n418\t    spell you cast.  TOLERANT PROBE — no engine grant-on-animation pipeline.\"\"\"\n419\t\n420\t    def _activate(self, card: Any, game: Any) -> None:\n421\t        abilities = card.get_activated_abilities()\n422\t        assert abilities, \"Great Hall must print a {5} activated ability\"\n423\t        ab = abilities[0]\n424\t        try:\n425\t            ab.cost(game, card)\n426\t        except TypeError:\n427\t            try:\n428\t                ab.cost(game)\n429\t            except Exception:\n430\t                pass\n431\t        ab.effect(game)\n432\t\n433\t    def test_animation_registers_a_pump_trigger(self) -> None:\n434\t        \"\"\"Animating the land must register a (cast-an-instant/sorcery) trigger.\n435\t\n436\t        The granted ability fires \"Whenever you cast an instant or sorcery\n437\t        spell\", so a new trigger controlled by the land's controller should be\n438\t        registered when the land becomes a creature.\n439\t        \"\"\"\n440\t        game = create_game()\n441\t        p1 = game.players[0]\n442\t        card = _card(owner=p1, controller=p1)\n443\t        set_board_state(game, 0, battlefield=[card])\n444\t        before = len(game.trigger_manager.get_triggers())\n445\t        self._activate(card, game)\n446\t        after = len(game.trigger_manager.get_triggers())\n447\t        assert after > before, (\n448\t            \"Animation must grant the 'whenever you cast an instant or sorcery \"\n449\t            \"spell' pump trigger — see untestable.json\"\n450\t        )\n451\t\n452\t    def test_pump_trigger_adds_plus_one_zero_until_end_of_turn(self) -> None:\n453\t        \"\"\"Casting an instant/sorcery pumps the animated land +1/+0.\n454\t\n455\t        TOLERANT PROBE: locate the granted trigger registered by the\n456\t        animation, fire its effect once, recompute continuous effects, and\n457\t        assert the body is 3/4 (2/4 plus +1/+0).  Fails loudly if no such\n458\t        trigger/effect surface exists.  The until-end-of-turn duration and the\n459\t        per-cast scaling are recorded in untestable.json.\n460\t        \"\"\"\n461\t        game = create_game()\n462\t        p1 = game.players[0]\n463\t        card = _card(owner=p1, controller=p1)\n464\t        set_board_state(game, 0, battlefield=[card])\n465\t\n466\t        before = list(game.trigger_manager.get_triggers())\n467\t        self._activate(card, game)\n468\t        game.effect_manager.apply_all(game)\n469\t        new_triggers = [\n470\t            t for t in game.trigger_manager.get_triggers() if t not in before\n471\t        ]\n472\t        assert new_triggers, (\n473\t            \"No granted instant/sorcery pump trigger to fire — see untestable.json\"\n474\t        )\n475\t\n476\t        # Fire the granted trigger's effect (as a cast event would) and\n477\t        # recompute the layer system.\n478\t        trig = new_triggers[0]\n479\t        effect = getattr(trig, \"effect\", None)\n480\t        assert callable(effect), \"Granted pump trigger has no callable effect\"\n481\t        effect(game)\n482\t        game.effect_manager.apply_all(game)\n483\t\n484\t        assert getattr(card, \"power\", None) == 3\n485\t        assert getattr(card, \"toughness\", None) == 4\n486\t"}]},"parent_tool_use_id":"toolu_01CbsKBgtu5hXmsenTvvH1UM","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"d82a103c-4b51-42c2-8a34-fad4fff99237","timestamp":"2026-06-02T10:19:12.917Z","subagent_type":"Tester","task_description":"Extend sos_257 tests"}
