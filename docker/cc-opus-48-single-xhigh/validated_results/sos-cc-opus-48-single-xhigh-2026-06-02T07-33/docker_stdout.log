{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K7Gxt3AqQCKNvrNWvLWJLi","type":"tool_result","content":"1\t\"\"\"Tests for SOS 57 — Mana Sculpt.\n2\t\n3\tMana Sculpt — {1}{U}{U} Instant:\n4\t\n5\t    Counter target spell. If you control a Wizard, add an amount of {C}\n6\t    equal to the amount of mana spent to cast that spell at the beginning\n7\t    of your next main phase.\n8\t\n9\tContract derived from the oracle text and the engine's counter plumbing\n10\t(see ``cards/fdn/fdn_48`` / ``cards/fdn/fdn_153`` for the established\n11\t``_counter_spell`` pattern, plus ``engine/stack.py``,\n12\t``engine/triggers.py`` and ``engine/mana.py``):\n13\t\n14\t* **Static data** — name ``\"Mana Sculpt\"``, mana cost ``{1}{U}{U}``, an\n15\t  instant.\n16\t* **Counter half** — the spell targets another spell on the stack and, on\n17\t  resolution, removes that spell's :class:`StackObject` from the stack and\n18\t  puts the countered card into its owner's graveyard.  A counter with no\n19\t  legal target (it left the stack) does nothing.\n20\t* **Wizard condition** — the deferred mana clause only applies if the\n21\t  controller of Mana Sculpt controls a Wizard *as the counter resolves*.\n22\t  With no Wizard, only the counter happens.\n23\t* **Deferred {C}** — when the controller does control a Wizard, a delayed\n24\t  effect is set up that, at the beginning of the controller's next main\n25\t  phase, adds an amount of ``{C}`` (colorless mana) to the controller's\n26\t  pool equal to the amount of mana spent to cast the countered spell.\n27\t  For a normally-cast spell with no X / cost reduction this is the\n28\t  countered spell's mana value.\n29\t\n30\tThe counter behaviour is asserted by driving ``on_resolve`` directly after\n31\tseeding ``chosen_targets`` (the established per-card test convention used by\n32\tthe FDN reference counter cards).  The deferred-mana behaviour is asserted\n33\tthrough the public trigger system: a Wizard-conditional counter must\n34\tregister a (delayed) trigger, and firing that trigger's effect must add the\n35\tcorrect amount of ``{C}`` to the controller's pool.\n36\t\"\"\"\n37\t\n38\tfrom __future__ import annotations\n39\t\n40\tfrom typing import Any\n41\t\n42\timport pytest\n43\t\n44\tfrom cards.sos.sos_57.card_impl import ManaSculpt\n45\tfrom engine.card import Creature, Instant, Sorcery\n46\tfrom engine.events import BeginningOfMainPhaseTriggeredEvent\n47\tfrom engine.stack import StackObject\n48\tfrom engine.types import CardType, ManaCost, ManaType, Zone\n49\tfrom test_utils import create_game, set_board_state\n50\t\n51\t\n52\t# ---------------------------------------------------------------------------\n53\t# Helpers\n54\t# ---------------------------------------------------------------------------\n55\t\n56\t\n57\tdef _wizard(owner: Any = None) -> Creature:\n58\t    \"\"\"A 2/2 creature with the Wizard subtype.\"\"\"\n59\t    return Creature(\n60\t        name=\"Test Wizard\",\n61\t        owner=owner,\n62\t        controller=owner,\n63\t        subtypes={\"Human\", \"Wizard\"},\n64\t        base_power=2,\n65\t        base_toughness=2,\n66\t    )\n67\t\n68\t\n69\tdef _non_wizard(owner: Any = None) -> Creature:\n70\t    \"\"\"A 2/2 creature without the Wizard subtype.\"\"\"\n71\t    return Creature(\n72\t        name=\"Grizzly Bears\",\n73\t        owner=owner,\n74\t        controller=owner,\n75\t        subtypes={\"Bear\"},\n76\t        base_power=2,\n77\t        base_toughness=2,\n78\t    )\n79\t\n80\t\n81\tdef _make_spell_on_stack(\n82\t    game: Any,\n83\t    caster: Any,\n84\t    *,\n85\t    mana_cost: str = \"{2}{R}\",\n86\t    name: str = \"Lightning Spell\",\n87\t    creature: bool = False,\n88\t) -> StackObject:\n89\t    \"\"\"Put a dummy spell on the stack controlled by *caster*.\n90\t\n91\t    Mirrors the real cast pipeline's bookkeeping enough for a counter to\n92\t    act on it: the source card lives in the caster's stack zone and a\n93\t    :class:`StackObject` referencing it sits on the game stack.\n94\t    \"\"\"\n95\t    if creature:\n96\t        spell = Creature(\n97\t            name=name,\n98\t            owner=caster,\n99\t            controller=caster,\n100\t            mana_cost=ManaCost.parse(mana_cost),\n101\t            base_power=1,\n102\t            base_toughness=1,\n103\t        )\n104\t    else:\n105\t        spell = Sorcery(\n106\t            name=name,\n107\t            owner=caster,\n108\t            controller=caster,\n109\t            mana_cost=ManaCost.parse(mana_cost),\n110\t        )\n111\t    caster.zones[Zone.STACK].add(spell)\n112\t    stack_obj = StackObject(\n113\t        source=spell,\n114\t        controller=caster,\n115\t        targets=[],\n116\t        on_resolve=lambda _g: None,\n117\t    )\n118\t    game.stack.push(stack_obj)\n119\t    return stack_obj\n120\t\n121\t\n122\tdef _fire_main_phase_begin(game: Any, player: Any, *, precombat: bool = True) -> None:\n123\t    \"\"\"Fire ``BeginningOfMainPhaseTriggeredEvent`` for *player* and resolve.\n124\t\n125\t    Drives the engine exactly as ``engine/turn.py`` ``run_turn`` does at the\n126\t    start of a main phase: the event is fired via\n127\t    :meth:`TriggerManager.fire_event`, which pushes any matching delayed\n128\t    trigger's effect onto the stack as a :class:`StackObject`.  The stack is\n129\t    then resolved (LIFO) so the deferred effect actually runs — mirroring the\n130\t    real ``priority_loop`` resolution that follows the fired event.\n131\t\n132\t    APNAP ordering in ``fire_event`` keys off ``game.active_player``; we set\n133\t    the active player to *player* so a trigger they control is pushed normally.\n134\t    \"\"\"\n135\t    game.active_player_index = game.players.index(player)\n136\t    game.trigger_manager.fire_event(\n137\t        game,\n138\t        BeginningOfMainPhaseTriggeredEvent(player=player, precombat=precombat),\n139\t    )\n140\t    # Resolve everything the fired event pushed onto the stack.\n141\t    while not game.stack.is_empty():\n142\t        obj = game.stack.pop()\n143\t        obj.on_resolve(game)\n144\t\n145\t\n146\t# ---------------------------------------------------------------------------\n147\t# Static properties\n148\t# ---------------------------------------------------------------------------\n149\t\n150\t\n151\tclass TestManaSculptProperties:\n152\t    \"\"\"Static card data should match the SOS 57 spec.\"\"\"\n153\t\n154\t    def test_name(self) -> None:\n155\t        assert ManaSculpt(owner=None).name == \"Mana Sculpt\"\n156\t\n157\t    def test_mana_cost(self) -> None:\n158\t        assert ManaSculpt(owner=None).mana_cost == ManaCost.parse(\"{1}{U}{U}\")\n159\t\n160\t    def test_is_instant(self) -> None:\n161\t        card = ManaSculpt(owner=None)\n162\t        assert isinstance(card, Instant)\n163\t        assert CardType.INSTANT in card.card_types\n164\t\n165\t    def test_not_a_creature(self) -> None:\n166\t        card = ManaSculpt(owner=None)\n167\t        assert CardType.CREATURE not in card.card_types\n168\t\n169\t\n170\t# ---------------------------------------------------------------------------\n171\t# Targeting / castability — needs a spell on the stack\n172\t# ---------------------------------------------------------------------------\n173\t\n174\t\n175\tclass TestManaSculptTargeting:\n176\t    \"\"\"Mana Sculpt targets a spell on the stack.\"\"\"\n177\t\n178\t    def test_cannot_cast_with_empty_stack(self) -> None:\n179\t        game = create_game()\n180\t        p1 = game.players[0]\n181\t        card = ManaSculpt(owner=p1, controller=p1)\n182\t        assert card.can_cast(game) is False\n183\t\n184\t    def test_can_cast_when_a_spell_is_on_the_stack(self) -> None:\n185\t        game = create_game()\n186\t        p1, p2 = game.players\n187\t        _make_spell_on_stack(game, p2)\n188\t        card = ManaSculpt(owner=p1, controller=p1)\n189\t        assert card.can_cast(game) is True\n190\t\n191\t    def test_get_targets_offers_the_spell_on_the_stack(self) -> None:\n192\t        game = create_game()\n193\t        p1, p2 = game.players\n194\t        target = _make_spell_on_stack(game, p2)\n195\t        card = ManaSculpt(owner=p1, controller=p1)\n196\t        reqs = card.get_targets(game)\n197\t        assert len(reqs) == 1\n198\t        # The requirement's filter must accept the spell's StackObject and\n199\t        # reject Mana Sculpt itself.\n200\t        req = reqs[0]\n201\t        assert req.zone == Zone.STACK\n202\t        assert req.filter_fn(target) is True\n203\t\n204\t    def test_get_targets_rejects_self(self) -> None:\n205\t        \"\"\"Mana Sculpt must not be able to target its own stack object.\"\"\"\n206\t        game = create_game()\n207\t        p1, p2 = game.players\n208\t        _make_spell_on_stack(game, p2)\n209\t        card = ManaSculpt(owner=p1, controller=p1)\n210\t        own_obj = StackObject(source=card, controller=p1, targets=[])\n211\t        req = card.get_targets(game)[0]\n212\t        assert req.filter_fn(own_obj) is False\n213\t\n214\t\n215\t# ---------------------------------------------------------------------------\n216\t# Counter half\n217\t# ---------------------------------------------------------------------------\n218\t\n219\t\n220\tclass TestManaSculptCounter:\n221\t    \"\"\"The counter removes the target spell from the stack.\"\"\"\n222\t\n223\t    def test_counter_removes_spell_from_stack(self) -> None:\n224\t        game = create_game()\n225\t        p1, p2 = game.players\n226\t        target = _make_spell_on_stack(game, p2, name=\"Doomed Spell\")\n227\t\n228\t        card = ManaSculpt(owner=p1, controller=p1)\n229\t        card.chosen_targets = [target]\n230\t        # Sanity: the targeted spell is on the stack before resolution.\n231\t        assert target in game.stack.objects()\n232\t\n233\t        card.on_resolve(game)\n234\t\n235\t        assert target not in game.stack.objects()\n236\t\n237\t    def test_countered_spell_goes_to_owners_graveyard(self) -> None:\n238\t        game = create_game()\n239\t        p1, p2 = game.players\n240\t        target = _make_spell_on_stack(game, p2, name=\"Doomed Spell\")\n241\t        spell_card = target.source\n242\t\n243\t        card = ManaSculpt(owner=p1, controller=p1)\n244\t        card.chosen_targets = [target]\n245\t        card.on_resolve(game)\n246\t\n247\t        # The countered card is owned by p2; it ends up in p2's graveyard.\n248\t        assert game.get_graveyard(p2).contains(spell_card)\n249\t        # And it is no longer in the stack zone.\n250\t        assert not p2.zones[Zone.STACK].contains(spell_card)\n251\t\n252\t    def test_counters_creature_spell_too(self) -> None:\n253\t        \"\"\"\"Counter target spell\" is not limited to noncreature spells.\"\"\"\n254\t        game = create_game()\n255\t        p1, p2 = game.players\n256\t        target = _make_spell_on_stack(game, p2, name=\"Big Beast\", creature=True)\n257\t        spell_card = target.source\n258\t\n259\t        card = ManaSculpt(owner=p1, controller=p1)\n260\t        card.chosen_targets = [target]\n261\t        card.on_resolve(game)\n262\t\n263\t        assert target not in game.stack.objects()\n264\t        assert game.get_graveyard(p2).contains(spell_card)\n265\t\n266\t    def test_no_target_is_a_noop(self) -> None:\n267\t        \"\"\"If there is no legal target, resolution does nothing (fizzles).\"\"\"\n268\t        game = create_game()\n269\t        p1, p2 = game.players\n270\t        # A bystander spell that must remain on the stack untouched.\n271\t        bystander = _make_spell_on_stack(game, p2, name=\"Bystander\")\n272\t\n273\t        card = ManaSculpt(owner=p1, controller=p1)\n274\t        card.chosen_targets = [None]\n275\t        card.on_resolve(game)\n276\t\n277\t        assert bystander in game.stack.objects()\n278\t        assert not game.get_graveyard(p2).contains(bystander.source)\n279\t\n280\t\n281\t# ---------------------------------------------------------------------------\n282\t# Wizard condition + deferred {C}\n283\t# ---------------------------------------------------------------------------\n284\t\n285\t\n286\tclass TestManaSculptWizardCondition:\n287\t    \"\"\"The deferred-mana clause only applies if you control a Wizard.\"\"\"\n288\t\n289\t    def test_no_wizard_registers_no_delayed_trigger(self) -> None:\n290\t        game = create_game()\n291\t        p1, p2 = game.players\n292\t        # Controller has a non-Wizard creature only.\n293\t        set_board_state(game, 0, battlefield=[_non_wizard(p1)])\n294\t        target = _make_spell_on_stack(game, p2, mana_cost=\"{2}{R}\")\n295\t\n296\t        card = ManaSculpt(owner=p1, controller=p1)\n297\t        card.chosen_targets = [target]\n298\t\n299\t        before = len(game.trigger_manager.get_triggers())\n300\t        card.on_resolve(game)\n301\t        after = len(game.trigger_manager.get_triggers())\n302\t\n303\t        # The spell is still countered, but no deferred-mana trigger exists.\n304\t        assert target not in game.stack.objects()\n305\t        assert after == before\n306\t\n307\t    def test_no_wizard_adds_no_mana_now_or_via_pool(self) -> None:\n308\t        \"\"\"Without a Wizard, the controller's pool gains no colorless mana.\"\"\"\n309\t        game = create_game()\n310\t        p1, p2 = game.players\n311\t        set_board_state(game, 0, battlefield=[_non_wizard(p1)],\n312\t                        mana={ManaType.COLORLESS: 0})\n313\t        target = _make_spell_on_stack(game, p2, mana_cost=\"{2}{R}\")\n314\t\n315\t        card = ManaSculpt(owner=p1, controller=p1)\n316\t        card.chosen_targets = [target]\n317\t        card.on_resolve(game)\n318\t\n319\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 0\n320\t\n321\t    def test_wizard_registers_a_delayed_trigger(self) -> None:\n322\t        game = create_game()\n323\t        p1, p2 = game.players\n324\t        set_board_state(game, 0, battlefield=[_wizard(p1)])\n325\t        target = _make_spell_on_stack(game, p2, mana_cost=\"{2}{R}\")  # mv 3\n326\t\n327\t        card = ManaSculpt(owner=p1, controller=p1)\n328\t        card.chosen_targets = [target]\n329\t\n330\t        before = len(game.trigger_manager.get_triggers())\n331\t        card.on_resolve(game)\n332\t        after = len(game.trigger_manager.get_triggers())\n333\t\n334\t        # Counter happened, and a deferred-mana trigger was registered for\n335\t        # the controller's next main phase.\n336\t        assert target not in game.stack.objects()\n337\t        assert after == before + 1\n338\t\n339\t    def test_delayed_trigger_is_controlled_by_caster(self) -> None:\n340\t        \"\"\"The deferred mana belongs to Mana Sculpt's controller (\"you\").\"\"\"\n341\t        game = create_game()\n342\t        p1, p2 = game.players\n343\t        set_board_state(game, 0, battlefield=[_wizard(p1)])\n344\t        target = _make_spell_on_stack(game, p2, mana_cost=\"{2}{R}\")\n345\t\n346\t        card = ManaSculpt(owner=p1, controller=p1)\n347\t        card.chosen_targets = [target]\n348\t        card.on_resolve(game)\n349\t\n350\t        new_triggers = [\n351\t            t for t in game.trigger_manager.get_triggers()\n352\t            if t.controller is p1\n353\t        ]\n354\t        assert len(new_triggers) == 1\n355\t\n356\t    def test_delayed_trigger_effect_adds_colorless_equal_to_mana_spent(self) -> None:\n357\t        \"\"\"Firing the registered effect adds {C} equal to the spell's cost.\n358\t\n359\t        The countered spell costs {2}{R} (mana value 3, no X / reductions),\n360\t        so the controller gains exactly 3 colorless mana.\n361\t        \"\"\"\n362\t        game = create_game()\n363\t        p1, p2 = game.players\n364\t        set_board_state(game, 0, battlefield=[_wizard(p1)],\n365\t                        mana={ManaType.COLORLESS: 0})\n366\t        target = _make_spell_on_stack(game, p2, mana_cost=\"{2}{R}\")  # mv 3\n367\t\n368\t        card = ManaSculpt(owner=p1, controller=p1)\n369\t        card.chosen_targets = [target]\n370\t        card.on_resolve(game)\n371\t\n372\t        new_triggers = [\n373\t            t for t in game.trigger_manager.get_triggers()\n374\t            if t.controller is p1\n375\t        ]\n376\t        assert len(new_triggers) == 1\n377\t        # Execute the deferred effect (as the engine would when the trigger\n378\t        # resolves at the controller's next main phase).\n379\t        new_triggers[0].effect(game)\n380\t\n381\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 3\n382\t\n383\t    def test_deferred_amount_scales_with_a_more_expensive_spell(self) -> None:\n384\t        \"\"\"{C} added equals the amount of mana spent — a 5-mana spell → 5 {C}.\"\"\"\n385\t        game = create_game()\n386\t        p1, p2 = game.players\n387\t        set_board_state(game, 0, battlefield=[_wizard(p1)],\n388\t                        mana={ManaType.COLORLESS: 0})\n389\t        target = _make_spell_on_stack(game, p2, mana_cost=\"{3}{U}{U}\")  # mv 5\n390\t\n391\t        card = ManaSculpt(owner=p1, controller=p1)\n392\t        card.chosen_targets = [target]\n393\t        card.on_resolve(game)\n394\t\n395\t        new_triggers = [\n396\t            t for t in game.trigger_manager.get_triggers()\n397\t            if t.controller is p1\n398\t        ]\n399\t        assert len(new_triggers) == 1\n400\t        new_triggers[0].effect(game)\n401\t\n402\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 5\n403\t\n404\t    def test_deferred_mana_is_colorless_not_colored(self) -> None:\n405\t        \"\"\"The deferred mana is {C}; it must not add colored mana.\"\"\"\n406\t        game = create_game()\n407\t        p1, p2 = game.players\n408\t        set_board_state(\n409\t            game, 0, battlefield=[_wizard(p1)],\n410\t            mana={\n411\t                ManaType.COLORLESS: 0,\n412\t                ManaType.BLUE: 0,\n413\t                ManaType.RED: 0,\n414\t            },\n415\t        )\n416\t        target = _make_spell_on_stack(game, p2, mana_cost=\"{2}{R}\")  # mv 3\n417\t\n418\t        card = ManaSculpt(owner=p1, controller=p1)\n419\t        card.chosen_targets = [target]\n420\t        card.on_resolve(game)\n421\t\n422\t        new_triggers = [\n423\t            t for t in game.trigger_manager.get_triggers()\n424\t            if t.controller is p1\n425\t        ]\n426\t        assert len(new_triggers) == 1\n427\t        new_triggers[0].effect(game)\n428\t\n429\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 3\n430\t        # No colored mana was added by the colorless clause.\n431\t        assert p1.mana_pool.get(ManaType.BLUE) == 0\n432\t        assert p1.mana_pool.get(ManaType.RED) == 0\n433\t\n434\t    def test_opponents_wizard_does_not_enable_the_clause(self) -> None:\n435\t        \"\"\"\"If *you* control a Wizard\" — an opponent's Wizard does not count.\"\"\"\n436\t        game = create_game()\n437\t        p1, p2 = game.players\n438\t        # Only the opponent (p2) controls a Wizard.\n439\t        set_board_state(game, 0, battlefield=[_non_wizard(p1)])\n440\t        set_board_state(game, 1, battlefield=[_wizard(p2)])\n441\t        target = _make_spell_on_stack(game, p2, mana_cost=\"{2}{R}\")\n442\t\n443\t        card = ManaSculpt(owner=p1, controller=p1)\n444\t        card.chosen_targets = [target]\n445\t\n446\t        before = len(game.trigger_manager.get_triggers())\n447\t        card.on_resolve(game)\n448\t        after = len(game.trigger_manager.get_triggers())\n449\t\n450\t        assert target not in game.stack.objects()\n451\t        # No deferred-mana trigger because the controller has no Wizard.\n452\t        assert after == before\n453\t\n454\t\n455\t# ---------------------------------------------------------------------------\n456\t# End-to-end timing: the {C} arrives at the controller's next main phase\n457\t# ---------------------------------------------------------------------------\n458\t\n459\t\n460\tclass TestManaSculptDeliveryTiming:\n461\t    \"\"\"The deferred {C} is delivered to the pool at the next main phase.\n462\t\n463\t    This drives the registered delayed trigger and asserts the colorless\n464\t    mana lands in the controller's pool — the observable end state of the\n465\t    \"add ... at the beginning of your next main phase\" clause.\n466\t    \"\"\"\n467\t\n468\t    def test_mana_lands_in_pool_after_firing_delayed_trigger(self) -> None:\n469\t        game = create_game()\n470\t        p1, p2 = game.players\n471\t        set_board_state(game, 0, battlefield=[_wizard(p1)],\n472\t                        mana={ManaType.COLORLESS: 0})\n473\t        target = _make_spell_on_stack(game, p2, mana_cost=\"{4}\")  # mv 4\n474\t\n475\t        card = ManaSculpt(owner=p1, controller=p1)\n476\t        card.chosen_targets = [target]\n477\t        card.on_resolve(game)\n478\t\n479\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 0  # not added yet\n480\t\n481\t        new_triggers = [\n482\t            t for t in game.trigger_manager.get_triggers()\n483\t            if t.controller is p1\n484\t        ]\n485\t        assert len(new_triggers) == 1\n486\t        new_triggers[0].effect(game)\n487\t\n488\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 4\n489\t\n490\t\n491\t# ---------------------------------------------------------------------------\n492\t# Engine-driven timing: BeginningOfMainPhaseTriggeredEvent delivery\n493\t# ---------------------------------------------------------------------------\n494\t\n495\t\n496\tclass TestManaSculptMainPhaseTiming:\n497\t    \"\"\"The delayed trigger is delivered by the engine's main-phase event.\n498\t\n499\t    These tests exercise the real timing wiring the Implementer added:\n500\t\n501\t    * ``BeginningOfMainPhaseTriggeredEvent(player=..., precombat=...)`` is the\n502\t      event ``engine/turn.py`` fires at the start of each main phase.\n503\t    * ``register_delayed`` registers a *one-shot* trigger whose condition is\n504\t      ``event.player is controller``.\n505\t    * Firing the event through ``game.trigger_manager.fire_event`` pushes the\n506\t      delayed effect onto the stack; resolving it deposits ``{C}`` into the\n507\t      controller's pool.\n508\t\n509\t    The card-driven assertions (immediate ``trigger.effect(game)``) remain in\n510\t    :class:`TestManaSculptWizardCondition` / :class:`TestManaSculptDeliveryTiming`;\n511\t    here we assert the *engine* path actually delivers, fires once, and gates on\n512\t    the controlling player.\n513\t    \"\"\"\n514\t\n515\t    def _setup_counter_with_wizard(\n516\t        self, *, mana_cost: str = \"{2}{R}\"\n517\t    ) -> tuple[Any, Any, Any]:\n518\t        \"\"\"Resolve a Mana Sculpt counter while p1 controls a Wizard.\n519\t\n520\t        Returns ``(game, p1, p2)`` with the deferred trigger registered and\n521\t        p1's colorless pool emptied (so a later delivery is unambiguous).\n522\t        \"\"\"\n523\t        game = create_game()\n524\t        p1, p2 = game.players\n525\t        set_board_state(game, 0, battlefield=[_wizard(p1)],\n526\t                        mana={ManaType.COLORLESS: 0})\n527\t        target = _make_spell_on_stack(game, p2, mana_cost=mana_cost)\n528\t\n529\t        card = ManaSculpt(owner=p1, controller=p1)\n530\t        card.chosen_targets = [target]\n531\t        card.on_resolve(game)\n532\t        return game, p1, p2\n533\t\n534\t    def test_main_phase_event_delivers_colorless_to_controller(self) -> None:\n535\t        \"\"\"Firing the controller's main-phase event lands the {C} in their pool.\n536\t\n537\t        The {C} must NOT be present immediately after the counter resolves, and\n538\t        must appear once ``BeginningOfMainPhaseTriggeredEvent(player=p1)`` is\n539\t        fired and resolved — the engine-driven version of \"at the beginning of\n540\t        your next main phase\".\n541\t        \"\"\"\n542\t        game, p1, _p2 = self._setup_counter_with_wizard(mana_cost=\"{2}{R}\")  # mv 3\n543\t\n544\t        # Not added yet — only registered.\n545\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 0\n546\t\n547\t        _fire_main_phase_begin(game, p1)\n548\t\n549\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 3\n550\t\n551\t    def test_delayed_trigger_is_consumed_after_firing_once(self) -> None:\n552\t        \"\"\"The one-shot trigger is removed from the manager once it fires.\n553\t\n554\t        After the controller's main-phase event fires, no Mana Sculpt trigger\n555\t        remains registered (it is a one-shot delayed trigger).\n556\t        \"\"\"\n557\t        game, p1, _p2 = self._setup_counter_with_wizard()\n558\t\n559\t        # Exactly one Mana-Sculpt-owned trigger before delivery.\n560\t        before = [t for t in game.trigger_manager.get_triggers()\n561\t                  if t.controller is p1]\n562\t        assert len(before) == 1\n563\t\n564\t        _fire_main_phase_begin(game, p1)\n565\t\n566\t        # The one-shot trigger has been consumed — none remain.\n567\t        after = [t for t in game.trigger_manager.get_triggers()\n568\t                 if t.controller is p1]\n569\t        assert len(after) == 0\n570\t\n571\t    def test_does_not_fire_again_on_a_later_main_phase(self) -> None:\n572\t        \"\"\"Firing the main-phase event a second time adds no further mana.\n573\t\n574\t        \"Your *next* main phase\" — exactly once.  After the first delivery the\n575\t        trigger is gone, so a later main-phase event must not top up the pool.\n576\t        \"\"\"\n577\t        game, p1, _p2 = self._setup_counter_with_wizard(mana_cost=\"{2}{R}\")  # mv 3\n578\t\n579\t        _fire_main_phase_begin(game, p1)\n580\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 3\n581\t\n582\t        # A subsequent main phase fires the event again — but the one-shot\n583\t        # trigger was already consumed, so no additional {C} is delivered.\n584\t        _fire_main_phase_begin(game, p1, precombat=False)\n585\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 3\n586\t\n587\t    def test_does_not_fire_on_opponents_main_phase(self) -> None:\n588\t        \"\"\"The opponent's main-phase event does not deliver the {C}.\n589\t\n590\t        The delayed trigger's condition is ``event.player is controller``, so\n591\t        ``BeginningOfMainPhaseTriggeredEvent(player=p2)`` must not deposit mana\n592\t        into anyone's pool, and must leave the trigger registered for p1's own\n593\t        next main phase.\n594\t        \"\"\"\n595\t        game, p1, p2 = self._setup_counter_with_wizard(mana_cost=\"{2}{R}\")\n596\t\n597\t        # Opponent's main phase begins first.\n598\t        _fire_main_phase_begin(game, p2)\n599\t\n600\t        # No mana delivered to either player.\n601\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 0\n602\t        assert p2.mana_pool.get(ManaType.COLORLESS) == 0\n603\t        # The trigger is still waiting for p1's main phase.\n604\t        still_pending = [t for t in game.trigger_manager.get_triggers()\n605\t                         if t.controller is p1]\n606\t        assert len(still_pending) == 1\n607\t\n608\t    def test_opponent_phase_then_controller_phase_delivers_once(self) -> None:\n609\t        \"\"\"The trigger survives the opponent's main phase, then fires on p1's.\n610\t\n611\t        End-to-end ordering: p2's main phase does nothing, then p1's main phase\n612\t        delivers exactly the recorded {C} — confirming the gate doesn't consume\n613\t        the one-shot on a non-matching event.\n614\t        \"\"\"\n615\t        game, p1, p2 = self._setup_counter_with_wizard(mana_cost=\"{3}{U}{U}\")  # mv 5\n616\t\n617\t        _fire_main_phase_begin(game, p2)          # opponent's main — no-op\n618\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 0\n619\t\n620\t        _fire_main_phase_begin(game, p1)          # controller's main — delivers\n621\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 5\n622\t\n623\t    def test_no_wizard_main_phase_event_delivers_nothing(self) -> None:\n624\t        \"\"\"Without a Wizard no trigger is registered, so the event is inert.\n625\t\n626\t        Firing the controller's main-phase event after a Wizard-less counter\n627\t        adds no colorless mana (there was nothing to fire).\n628\t        \"\"\"\n629\t        game = create_game()\n630\t        p1, p2 = game.players\n631\t        set_board_state(game, 0, battlefield=[_non_wizard(p1)],\n632\t                        mana={ManaType.COLORLESS: 0})\n633\t        target = _make_spell_on_stack(game, p2, mana_cost=\"{2}{R}\")\n634\t\n635\t        card = ManaSculpt(owner=p1, controller=p1)\n636\t        card.chosen_targets = [target]\n637\t        card.on_resolve(game)\n638\t\n639\t        _fire_main_phase_begin(game, p1)\n640\t\n641\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 0\n642\t"}]},"parent_tool_use_id":"toolu_01R7riNeuBBpSdqgv2NRz8iA","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"283485f0-2c71-424a-a0d1-7c2f5643f6a7","timestamp":"2026-06-02T08:57:32.322Z","subagent_type":"Tester","task_description":"Extend tests for sos_120 Paradigm"}
