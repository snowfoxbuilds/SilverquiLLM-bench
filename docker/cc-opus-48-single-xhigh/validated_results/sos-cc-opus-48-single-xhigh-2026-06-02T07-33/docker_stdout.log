{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01T4Qgqk4NcLhR5DedPWapnq","type":"tool_result","content":"1\t\"\"\"Typed event objects for triggered abilities and replacement effects.\n2\t\n3\tTriggered events are passed to :meth:`TriggerManager.fire_event` and\n4\tforwarded to trigger condition callables.\n5\t\n6\tReplacement events are passed to :meth:`ReplacementManager.apply` and\n7\tforwarded to replacement condition/replacement callables.  Subclassing\n8\tencodes event-type hierarchy so a replacement registered for a parent\n9\ttype (e.g. ``MoveToGraveyardReplacementEvent``) also fires for\n10\tsubtypes (e.g. ``CreatureDiesReplacementEvent``).\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\tfrom dataclasses import dataclass\n16\tfrom typing import Any\n17\t\n18\t\n19\t# ---------------------------------------------------------------------------\n20\t# Triggered events\n21\t# ---------------------------------------------------------------------------\n22\t\n23\t@dataclass\n24\tclass TriggeredEvent:\n25\t    \"\"\"Base class for all triggered-ability events.\"\"\"\n26\t\n27\t\n28\t@dataclass\n29\tclass EntersBattlefieldTriggeredEvent(TriggeredEvent):\n30\t    permanent: Any = None\n31\t    controller: Any = None\n32\t    card: Any = None\n33\t    creature: Any = None\n34\t\n35\t\n36\t@dataclass\n37\tclass LeavesBattlefieldTriggeredEvent(TriggeredEvent):\n38\t    permanent: Any = None\n39\t    controller: Any = None\n40\t\n41\t\n42\t@dataclass\n43\tclass DealsDamageTriggeredEvent(TriggeredEvent):\n44\t    source: Any = None\n45\t    target: Any = None\n46\t    amount: int = 0\n47\t    is_combat: bool = False\n48\t    combat: bool = False\n49\t\n50\t\n51\t@dataclass\n52\tclass LosesLifeTriggeredEvent(TriggeredEvent):\n53\t    player: Any = None\n54\t    amount: int = 0\n55\t\n56\t\n57\t@dataclass\n58\tclass GainsLifeTriggeredEvent(TriggeredEvent):\n59\t    player: Any = None\n60\t    amount: int = 0\n61\t\n62\t\n63\t@dataclass\n64\tclass DrawsCardTriggeredEvent(TriggeredEvent):\n65\t    player: Any = None\n66\t    card: Any = None\n67\t\n68\t\n69\t@dataclass\n70\tclass BeginningOfUpkeepTriggeredEvent(TriggeredEvent):\n71\t    pass\n72\t\n73\t\n74\t@dataclass\n75\tclass BeginningOfCombatTriggeredEvent(TriggeredEvent):\n76\t    pass\n77\t\n78\t\n79\t@dataclass\n80\tclass EndOfTurnTriggeredEvent(TriggeredEvent):\n81\t    pass\n82\t\n83\t\n84\t@dataclass\n85\tclass EndStepTriggeredEvent(TriggeredEvent):\n86\t    player: Any = None\n87\t\n88\t\n89\t@dataclass\n90\tclass CreatureDiesTriggeredEvent(TriggeredEvent):\n91\t    creature: Any = None\n92\t    controller: Any = None\n93\t    owner: Any = None\n94\t\n95\t\n96\t@dataclass\n97\tclass SpellCastTriggeredEvent(TriggeredEvent):\n98\t    spell: Any = None\n99\t    player: Any = None\n100\t    card: Any = None\n101\t    controller: Any = None\n102\t\n103\t\n104\t@dataclass\n105\tclass AttacksTriggeredEvent(TriggeredEvent):\n106\t    creature: Any = None\n107\t    attacker: Any = None\n108\t\n109\t\n110\t@dataclass\n111\tclass BlocksTriggeredEvent(TriggeredEvent):\n112\t    creature: Any = None\n113\t\n114\t\n115\t@dataclass\n116\tclass CounterAddedTriggeredEvent(TriggeredEvent):\n117\t    permanent: Any = None\n118\t    counter_type: Any = None\n119\t    amount: int = 0\n120\t\n121\t\n122\t# ---------------------------------------------------------------------------\n123\t# Replacement events\n124\t# ---------------------------------------------------------------------------\n125\t\n126\t@dataclass\n127\tclass ReplacementEvent:\n128\t    \"\"\"Base class for all replacement-effect events.\"\"\"\n129\t\n130\t\n131\t@dataclass\n132\tclass MoveToGraveyardReplacementEvent(ReplacementEvent):\n133\t    \"\"\"Any permanent moving to a graveyard.\n134\t\n135\t    Subclass this for specific causes (destruction, sacrifice, etc.).\n136\t    A replacement registered for this type also fires for all subtypes.\n137\t\n138\t    ``destination`` may be mutated by a replacement to redirect the\n139\t    permanent to a different zone (``\"exile\"``, ``\"library\"``, ``\"hand\"``).\n140\t    Set ``prevented = True`` to signal that the replacement handled the\n141\t    zone move itself and the engine should skip its own move.\n142\t    \"\"\"\n143\t\n144\t    destination: str = \"graveyard\"\n145\t    controller: Any = None\n146\t    owner: Any = None\n147\t    prevented: bool = False\n148\t\n149\t    @property\n150\t    def card(self) -> Any:\n151\t        \"\"\"The object moving to the graveyard (overridden by subclasses).\"\"\"\n152\t        return None\n153\t\n154\t\n155\t@dataclass\n156\tclass CreatureDiesReplacementEvent(MoveToGraveyardReplacementEvent):\n157\t    \"\"\"A creature going to the graveyard via destruction or lethal damage.\"\"\"\n158\t\n159\t    creature: Any = None\n160\t\n161\t    @property\n162\t    def card(self) -> Any:\n163\t        return self.creature\n164\t\n165\t\n166\t@dataclass\n167\tclass PermanentDestroyedReplacementEvent(MoveToGraveyardReplacementEvent):\n168\t    \"\"\"A non-creature permanent going to the graveyard via destruction.\"\"\"\n169\t\n170\t    permanent: Any = None\n171\t\n172\t    @property\n173\t    def card(self) -> Any:\n174\t        return self.permanent\n175\t\n176\t\n177\t@dataclass\n178\tclass SacrificeReplacementEvent(MoveToGraveyardReplacementEvent):\n179\t    \"\"\"A permanent going to the graveyard via sacrifice.\"\"\"\n180\t\n181\t    permanent: Any = None\n182\t\n183\t    @property\n184\t    def card(self) -> Any:\n185\t        return self.permanent\n186\t\n187\t\n188\t@dataclass\n189\tclass CreateTokenReplacementEvent(ReplacementEvent):\n190\t    \"\"\"An effect about to create one or more tokens.\"\"\"\n191\t\n192\t    player: Any = None\n193\t    count: int = 1\n194\t\n195\t\n196\t@dataclass\n197\tclass AddCounterReplacementEvent(ReplacementEvent):\n198\t    \"\"\"An effect about to add one or more counters to a permanent.\"\"\"\n199\t\n200\t    permanent: Any = None\n201\t    amount: int = 1\n202\t"}]},"parent_tool_use_id":"toolu_015rF4nfPePEJ7zX53WjYEJK","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"842a612e-c7f2-49f3-b45e-df237341ba99","timestamp":"2026-06-02T08:22:48.912Z","subagent_type":"Implementer","task_description":"Implement sos_57"}
