{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0117YtmXDdRnnTh1k72W1Upt","type":"tool_result","content":"1\t\"\"\"Card implementation for Phyrexian Arena.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom dataclasses import dataclass\n4\tfrom typing import TYPE_CHECKING, Any\n5\tfrom engine.card import ActivatedAbility, Creature, Enchantment\n6\tfrom engine.continuous_effects import ContinuousEffect, DURATION_PERMANENT, Layer, SubLayer\n7\tfrom engine.types import CardType, Keyword, ManaCost, TargetRequirement, Zone\n8\tfrom engine.events import BeginningOfUpkeepTriggeredEvent, LosesLifeTriggeredEvent\n9\tif TYPE_CHECKING:\n10\t    from engine.game_state import GameState\n11\t    from cards.registry import CardRegistry\n12\t\n13\tdef _is_on_battlefield(game: Any, obj: Any) -> bool:\n14\t    \"\"\"Check if *obj* is on any player's battlefield.\"\"\"\n15\t    for player in game.players:\n16\t        if game.get_battlefield(player).contains(obj):\n17\t            return True\n18\t    return False\n19\t\n20\tclass PhyrexianArena(Enchantment):\n21\t    \"\"\"Phyrexian Arena — {1}{B}{B} — Draw a card, lose 1 life at upkeep.\n22\t\n23\t    At the beginning of your upkeep, you draw a card and you lose 1 life.\n24\t\n25\t    FDN collector number 180.\n26\t    \"\"\"\n27\t\n28\t    def __init__(self, **kwargs: Any) -> None:\n29\t        kwargs.setdefault('name', 'Phyrexian Arena')\n30\t        kwargs.setdefault('mana_cost', ManaCost.parse('{1}{B}{B}'))\n31\t        kwargs.setdefault('rules_text', 'At the beginning of your upkeep, you draw a card and you lose 1 life.')\n32\t        super().__init__(**kwargs)\n33\t\n34\t    def on_resolve(self, game: GameState) -> None:\n35\t        pass\n36\t\n37\t    def register_triggers(self, game: GameState) -> None:\n38\t        from engine.triggers import TriggerRegistration\n39\t        from engine.game import draw_card\n40\t        source = self\n41\t\n42\t        def _condition(game: Any, event: dict) -> bool:\n43\t            if not _is_on_battlefield(game, source):\n44\t                return False\n45\t            controller = source.controller\n46\t            return controller is not None and controller is game.active_player\n47\t\n48\t        def _effect(game: GameState) -> None:\n49\t            controller = source.controller\n50\t            if controller is None:\n51\t                return\n52\t            draw_card(game, controller)\n53\t            controller.life -= 1\n54\t            game.trigger_manager.fire_event(game, LosesLifeTriggeredEvent(player=controller, amount=1))\n55\t        controller = getattr(self, 'controller', None) or game.active_player\n56\t        game.trigger_manager.register(TriggerRegistration(event_type=BeginningOfUpkeepTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=controller))\n57\t"}]},"parent_tool_use_id":"toolu_01H6pxqW1YJhVScLqeG4XwUq","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"e9753bd4-3365-428c-a074-c89e3456e455","timestamp":"2026-06-02T09:03:50.403Z","subagent_type":"Tester","task_description":"Write tests for sos_201"}
