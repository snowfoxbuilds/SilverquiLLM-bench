{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Mi8tGVU99ErmehbKwUqbz9","type":"tool_result","content":"1\t\"\"\"Card implementation for Improvisation Capstone.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Sorcery\n8\tfrom engine.types import Color, ManaCost, Zone\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t\n13\t\n14\tdef _mana_value(card: Any) -> int:\n15\t    \"\"\"Return *card*'s mana value (converted mana cost).\n16\t\n17\t    Lands and other zero-cost cards have mana value 0.\n18\t    \"\"\"\n19\t    mana_cost = getattr(card, \"mana_cost\", None)\n20\t    if mana_cost is None:\n21\t        return 0\n22\t    return mana_cost.cmc\n23\t\n24\t\n25\tdef _is_castable_spell(card: Any) -> bool:\n26\t    \"\"\"Return ``True`` if *card* is a spell that can be cast (not a land).\"\"\"\n27\t    from engine.paradigm import is_castable_spell\n28\t\n29\t    return is_castable_spell(card)\n30\t\n31\t\n32\tclass ImprovisationCapstone(Sorcery):\n33\t    \"\"\"Improvisation Capstone — {5}{R}{R} — Sorcery — Lesson.\n34\t\n35\t    Exile cards from the top of your library until you exile cards with total\n36\t    mana value 4 or greater.  You may cast any number of spells from among them\n37\t    without paying their mana costs.\n38\t    Paradigm (Then exile this spell.  After you first resolve a spell with this\n39\t    name, you may cast a copy of it from exile without paying its mana cost at\n40\t    the beginning of each of your first main phases.)\n41\t\n42\t    SOS collector number 120.\n43\t    \"\"\"\n44\t\n45\t    #: The printed paradigm keyword label (Paradigm is NOT an evergreen\n46\t    #: ``engine.types.Keyword`` enum member — that enum is frozen at 16\n47\t    #: members — so it is recorded here as a printed-keyword label).\n48\t    PARADIGM_LABEL = \"Paradigm\"\n49\t\n50\t    #: Total mana value the exile process accumulates to before stopping.\n51\t    EXILE_THRESHOLD = 4\n52\t\n53\t    def __init__(self, **kwargs: Any) -> None:\n54\t        kwargs.setdefault(\"name\", \"Improvisation Capstone\")\n55\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{5}{R}{R}\"))\n56\t        kwargs.setdefault(\"subtypes\", {\"Lesson\"})\n57\t        kwargs.setdefault(\n58\t            \"rules_text\",\n59\t            \"Exile cards from the top of your library until you exile cards \"\n60\t            \"with total mana value 4 or greater. You may cast any number of \"\n61\t            \"spells from among them without paying their mana costs.\\n\"\n62\t            \"Paradigm (Then exile this spell. After you first resolve a spell \"\n63\t            \"with this name, you may cast a copy of it from exile without \"\n64\t            \"paying its mana cost at the beginning of each of your first main \"\n65\t            \"phases.)\",\n66\t        )\n67\t        super().__init__(**kwargs)\n68\t        # Red is given explicitly so colour is correct even off the stack\n69\t        # (the cost pips are also red, but being explicit keeps colour stable\n70\t        # for copies and for cards stripped of their cost).\n71\t        self.colors: list[Color] = [Color.RED]\n72\t        # Printed-keyword label surface — Paradigm is a printed keyword, not an\n73\t        # evergreen ``Keyword`` enum member.\n74\t        self.printed_keywords: list[str] = [self.PARADIGM_LABEL]\n75\t\n76\t    # ------------------------------------------------------------------\n77\t    # Paradigm copy factory\n78\t    # ------------------------------------------------------------------\n79\t\n80\t    def make_paradigm_copy(self) -> \"ImprovisationCapstone\":\n81\t        \"\"\"Return a fresh same-named copy of this spell for paradigm.\n82\t\n83\t        The copy is a brand-new :class:`ImprovisationCapstone` (so it can be\n84\t        placed in exile and cast for free at the beginning of each of the\n85\t        controller's first main phases).  Owner/controller are inherited from\n86\t        this card so the copy belongs to the right player.\n87\t        \"\"\"\n88\t        copy = ImprovisationCapstone(owner=self.owner, controller=self.controller)\n89\t        copy.is_paradigm_copy = True\n90\t        return copy\n91\t\n92\t    # ------------------------------------------------------------------\n93\t    # Main resolution\n94\t    # ------------------------------------------------------------------\n95\t\n96\t    def on_resolve(self, game: \"GameState\") -> None:\n97\t        \"\"\"Resolve Improvisation Capstone.\n98\t\n99\t        1. Exile cards from the top of the controller's library until the total\n100\t           exiled mana value reaches 4 or greater (or the library is empty).\n101\t        2. The controller may cast any number of those exiled spells for free.\n102\t        3. \"Then exile this spell.\" — register a stack->exile redirect so the\n103\t           Capstone is exiled rather than put into the graveyard.\n104\t        4. On first resolution, wire the recurring paradigm copy ability.\n105\t        \"\"\"\n106\t        controller = self.controller\n107\t        if controller is None:\n108\t            controller = game.active_player\n109\t        if controller is None:\n110\t            return\n111\t\n112\t        exiled = self._exile_from_library(game, controller)\n113\t        self._offer_free_casts(game, controller, exiled)\n114\t        self._exile_this_spell(game)\n115\t        self._wire_paradigm(game, controller)\n116\t\n117\t    # ------------------------------------------------------------------\n118\t    # Step 1 — exile from library until total mana value >= 4\n119\t    # ------------------------------------------------------------------\n120\t\n121\t    def _exile_from_library(self, game: \"GameState\", controller: Any) -> list[Any]:\n122\t        \"\"\"Exile from the top of *controller*'s library until total MV >= 4.\n123\t\n124\t        Returns the list of cards exiled (top-of-library order).  Mana-value-0\n125\t        cards do not stop the process; an empty (or too-small) library simply\n126\t        stops once it runs dry — no crash / infinite loop.\n127\t        \"\"\"\n128\t        library = controller.zones[Zone.LIBRARY]\n129\t        exile = controller.zones[Zone.EXILE]\n130\t        exiled: list[Any] = []\n131\t        total = 0\n132\t\n133\t        while total < self.EXILE_THRESHOLD:\n134\t            # Top of the library is the last element of the internal list.\n135\t            top = library.top(1)\n136\t            if not top:\n137\t                break  # Library is empty — stop (no infinite loop).\n138\t            card = top[-1]\n139\t            library.remove(card)\n140\t            card.owner = controller\n141\t            card.controller = controller\n142\t            exile.add(card)\n143\t            exiled.append(card)\n144\t            total += _mana_value(card)\n145\t\n146\t        return exiled\n147\t\n148\t    # ------------------------------------------------------------------\n149\t    # Step 2 — may cast any number of those spells for free\n150\t    # ------------------------------------------------------------------\n151\t\n152\t    def _offer_free_casts(\n153\t        self, game: \"GameState\", controller: Any, exiled: list[Any]\n154\t    ) -> None:\n155\t        \"\"\"Let *controller* cast any number of the *exiled* spells for free.\n156\t\n157\t        Lands are not spells and are skipped.  The choice loop is optional\n158\t        (\"may\"): each iteration the controller decides whether to cast another\n159\t        spell, and if so chooses which exiled spell to cast for free from\n160\t        exile.  Declining ends the loop.\n161\t        \"\"\"\n162\t        from engine.casting import CastingError, cast_spell_free\n163\t\n164\t        chooser = getattr(controller, \"choose_yes_no\", None)\n165\t        picker = getattr(controller, \"choose_card\", None)\n166\t        if not callable(chooser) or not callable(picker):\n167\t            return\n168\t\n169\t        while True:\n170\t            # Only spells still in exile that are castable (not lands).\n171\t            exile = controller.zones[Zone.EXILE]\n172\t            candidates = [\n173\t                c\n174\t                for c in exiled\n175\t                if exile.contains(c) and _is_castable_spell(c)\n176\t            ]\n177\t            if not candidates:\n178\t                return\n179\t\n180\t            try:\n181\t                wants = bool(\n182\t                    chooser(\n183\t                        \"Cast a spell from among the exiled cards without \"\n184\t                        \"paying its mana cost?\"\n185\t                    )\n186\t                )\n187\t            except Exception:\n188\t                return\n189\t            if not wants:\n190\t                return\n191\t\n192\t            try:\n193\t                chosen = picker(\n194\t                    candidates,\n195\t                    \"spell to cast for free from among the exiled cards\",\n196\t                )\n197\t            except Exception:\n198\t                return\n199\t            if chosen is None or not exile.contains(chosen):\n200\t                continue\n201\t            if not _is_castable_spell(chosen):\n202\t                continue\n203\t\n204\t            try:\n205\t                cast_spell_free(game, controller, chosen, Zone.EXILE)\n206\t            except CastingError:\n207\t                # Cast failed (e.g. no legal target) — the card is rolled back\n208\t                # into exile; do not offer it again to avoid an infinite loop.\n209\t                if chosen in exiled:\n210\t                    exiled.remove(chosen)\n211\t\n212\t    # ------------------------------------------------------------------\n213\t    # Step 3 — \"Then exile this spell.\"\n214\t    # ------------------------------------------------------------------\n215\t\n216\t    def _exile_this_spell(self, game: \"GameState\") -> None:\n217\t        \"\"\"Register a stack->exile redirect so this spell is exiled on resolve.\n218\t\n219\t        Reuses the sos_1 redirect helper: when this sorcery finishes resolving\n220\t        and would go to the graveyard, it is routed to exile instead.\n221\t        \"\"\"\n222\t        from engine.casting import register_stack_to_graveyard_redirect\n223\t\n224\t        register_stack_to_graveyard_redirect(game, self, \"exile\")\n225\t\n226\t    # ------------------------------------------------------------------\n227\t    # Step 4 — wire the recurring paradigm copy ability\n228\t    # ------------------------------------------------------------------\n229\t\n230\t    def _wire_paradigm(self, game: \"GameState\", controller: Any) -> None:\n231\t        \"\"\"Mark first resolution + register the recurring paradigm ability.\"\"\"\n232\t        from engine.paradigm import register_paradigm\n233\t\n234\t        register_paradigm(\n235\t            game,\n236\t            source=self,\n237\t            controller=controller,\n238\t            factory=self.make_paradigm_copy,\n239\t            name=self.name,\n240\t        )\n241\t"}]},"parent_tool_use_id":"toolu_01SxABS2LYMPLt5MCvzy5rCk","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"c4334bfa-1971-468b-a02c-229e56859a7d","timestamp":"2026-06-02T09:09:55.885Z","subagent_type":"Implementer","task_description":"Implement sos_201"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Xkhu5nbd4C7dyfM1mPaZKN","type":"tool_result","content":"1\t{\n2\t  \"cards\": [\n3\t    {\n4\t      \"card\": \"sos_1\",\n5\t      \"tests\": [\n6\t        {\n7\t          \"path\": \"cards/sos/sos_1/tests.py\",\n8\t          \"summary\": \"tests for The Dawning Archaic: static data, cost reduction, attack trigger registration, free-recast and exile-instead-of-graveyard\"\n9\t        }\n10\t      ],\n11\t      \"implementation\": [\n12\t        {\n13\t          \"path\": \"cards/sos/sos_1/card_impl.py\",\n14\t          \"summary\": \"The Dawning Archaic: cost reduction per instant/sorcery in graveyard, attack trigger recasting a graveyard spell for free with exile redirect\"\n15\t        },\n16\t        {\n17\t          \"path\": \"engine/casting.py\",\n18\t          \"summary\": \"additive stack->graveyard redirect registry consulted by _resolve_spell so a free-cast spell can be exiled instead of going to graveyard\"\n19\t        }\n20\t      ]\n21\t    },\n22\t    {\n23\t      \"card\": \"sos_120\",\n24\t      \"tests\": [\n25\t        {\n26\t          \"path\": \"cards/sos/sos_120/tests.py\",\n27\t          \"summary\": \"tests for sos_120 Improvisation Capstone: static data + Paradigm label, exile-from-top-until-total-MV>=4 (inclusive, MV-0 doesn't stop, empty/short library, controller-only), may-cast-any-number-for-free (decline/multi/lands-not-spells/free-resolution), Then-exile-this-spell via cast pipeline, and tolerant paradigm copy-factory/free-cast-from-exile probes\"\n28\t        }\n29\t      ],\n30\t      \"implementation\": [\n31\t        {\n32\t          \"path\": \"cards/sos/sos_120/card_impl.py\",\n33\t          \"summary\": \"Improvisation Capstone: exile top of library until total MV>=4, optional free-cast loop of those spells (lands skipped) via cast_spell_free, Then-exile-this-spell via sos_1 redirect, make_paradigm_copy factory, and register_paradigm on first resolution\"\n34\t        },\n35\t        {\n36\t          \"path\": \"engine/paradigm.py\",\n37\t          \"summary\": \"additive Paradigm framework (CR 702.192): per-game first-resolution gate (mark/has_paradigm_resolved), register_paradigm wiring a RECURRING BeginningOfMainPhaseTriggeredEvent trigger (controller's precombat mains only, deduped per controller+name), offer_paradigm_copy creating a free copy in exile and casting via cast_spell_free; reuses sos_57 main-phase event + sos_1 free-cast\"\n38\t        }\n39\t      ]\n40\t    },\n41\t    {\n42\t      \"card\": \"sos_13\",\n43\t      \"tests\": [\n44\t        {\n45\t          \"path\": \"cards/sos/sos_13/tests.py\",\n46\t          \"summary\": \"tests for Emeritus of Truce // Swords to Plowshares: front-face stats, ETB Inkling token (target player, 1/1 W+B flying), conditional becomes-prepared (strictly-more opponents), {W} prepare-half cost, exile-copy creation, cast-from-exile + unprepare, and Swords effect\"\n47\t        }\n48\t      ],\n49\t      \"implementation\": [\n50\t        {\n51\t          \"path\": \"cards/sos/sos_13/card_impl.py\",\n52\t          \"summary\": \"Emeritus of Truce front-face creature + ETB (Inkling token then conditional mark_prepared); SwordsToPlowshares {W} instant prepare half (exile target creature, controller gains life=power)\"\n53\t        },\n54\t        {\n55\t          \"path\": \"engine/preparation.py\",\n56\t          \"summary\": \"additive Preparation-card framework (CR 722): mark_prepared/unprepare/is_prepared, copy-of-prepare-spell created in controller exile keyed to permanent; cast_prepared_copy casts the copy first and only unprepares the source/detaches the registry after the cast succeeds (722.3c)\"\n57\t        }\n58\t      ]\n59\t    },\n60\t    {\n61\t      \"card\": \"sos_4\",\n62\t      \"tests\": [\n63\t        {\n64\t          \"path\": \"cards/sos/sos_4/tests.py\",\n65\t          \"summary\": \"tests for Together as One: properties, two-target (player + any target) targeting, Converge X=distinct colors, draw/damage/lifegain clauses, and full-cast pipeline X==3\"\n66\t        }\n67\t      ],\n68\t      \"implementation\": [\n69\t        {\n70\t          \"path\": \"cards/sos/sos_4/card_impl.py\",\n71\t          \"summary\": \"Together as One: {6} sorcery, X=len(colors_spent); target player draws X, X damage to any target, controller gains X life\"\n72\t        }\n73\t      ]\n74\t    },\n75\t    {\n76\t      \"card\": \"sos_57\",\n77\t      \"tests\": [\n78\t        {\n79\t          \"path\": \"cards/sos/sos_57/tests.py\",\n80\t          \"summary\": \"tests for Mana Sculpt: static data, counter-any-spell targeting (excludes self), countered card to owner graveyard, creature-spell counter, no-target fizzle, Wizard-conditional delayed trigger (controlled by you, scales with mana spent, colorless-only, opponent Wizard excluded), and deferred {C} delivery timing\"\n81\t        }\n82\t      ],\n83\t      \"implementation\": [\n84\t        {\n85\t          \"path\": \"cards/sos/sos_57/card_impl.py\",\n86\t          \"summary\": \"Mana Sculpt: counter target spell via _counter_spell idiom; if controller controls a Wizard at resolution, register a one-shot delayed trigger adding {C}=mana_spent (fallback mana_cost.cmc) at controller's next main phase\"\n87\t        },\n88\t        {\n89\t          \"path\": \"engine/casting.py\",\n90\t          \"summary\": \"additive: record card.mana_spent = effective_cost.cmc after payment (total mana paid), cleared at cast start alongside colors_spent\"\n91\t        },\n92\t        {\n93\t          \"path\": \"engine/events.py\",\n94\t          \"summary\": \"additive: new BeginningOfMainPhaseTriggeredEvent(player, precombat) triggered event\"\n95\t        },\n96\t        {\n97\t          \"path\": \"engine/triggers.py\",\n98\t          \"summary\": \"additive: TriggerRegistration.one_shot field, TriggerManager.register_delayed() for one-shot delayed triggers, fire_event removes matched one-shot triggers so they fire exactly once\"\n99\t        },\n100\t        {\n101\t          \"path\": \"engine/turn.py\",\n102\t          \"summary\": \"additive: run_turn fires BeginningOfMainPhaseTriggeredEvent at the start of each main phase (pre/post-combat)\"\n103\t        }\n104\t      ]\n105\t    },\n106\t    {\n107\t      \"card\": \"sos_97\",\n108\t      \"tests\": [\n109\t        {\n110\t          \"path\": \"cards/sos/sos_97/tests.py\",\n111\t          \"summary\": \"tests for Ral Zarek, Guest Lecturer: static data, four-ability loyalty roster, +1 surveil 2 (card-conservation/no-leak/empty-lib), -1 any-number-of-target-players discard (zero/empty-hand no-ops), -2 reanimate mv<=3 creature from your graveyard + filter boundary (mv3 ok, mv4/noncreature rejected), -7 ultimate exists/resolves\"\n112\t        }\n113\t      ],\n114\t      \"implementation\": [\n115\t        {\n116\t          \"path\": \"cards/sos/sos_97/card_impl.py\",\n117\t          \"summary\": \"Ral Zarek planeswalker: +1 surveil 2 via choose_yes_no top-first; -1 each target player discards; -2 graveyard-scoped TargetRequirement (creature mv<=3) move_to_zone GRAVEYARD->BATTLEFIELD under you; -7 flip_coins(5)=X add_skipped_turns(opponent, X)\"\n118\t        },\n119\t        {\n120\t          \"path\": \"engine/game.py\",\n121\t          \"summary\": \"additive: get_rng/seed_rng/flip_coin/flip_coins(game,n) seedable coin flips (lazy game._rng); add_skipped_turns(game,player,amount) increments per-player skipped_turns counter\"\n122\t        },\n123\t        {\n124\t          \"path\": \"engine/game_state.py\",\n125\t          \"summary\": \"additive: _next_active_index_raw() factors out extra_turns/normal rotation unchanged; _pick_next_active_index() consumes skipped_turns during end-of-turn rotation; advance_phase calls it\"\n126\t        },\n127\t        {\n128\t          \"path\": \"engine/player.py\",\n129\t          \"summary\": \"additive: Player.skipped_turns:int=0 per-player skip-turn counter consumed during turn rotation\"\n130\t        }\n131\t      ]\n132\t    }\n133\t  ]\n134\t}\n135\t"}]},"parent_tool_use_id":"toolu_01SxABS2LYMPLt5MCvzy5rCk","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"529ce0b1-02d1-4c76-8aa6-715498f8d272","timestamp":"2026-06-02T09:09:55.885Z","subagent_type":"Implementer","task_description":"Implement sos_201"}
