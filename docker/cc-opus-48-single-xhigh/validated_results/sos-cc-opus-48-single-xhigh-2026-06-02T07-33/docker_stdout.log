{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LdxMQbK1shrjT6Qr5bkUoT","type":"tool_result","content":"39\tdef get_colors(obj: Any) -> set[Color]:\n40\t    \"\"\"Return the set of colours of *obj*.\n41\t\n42\t    Colour is determined by:\n43\t    1. An explicit ``colors`` attribute (set or list of :class:`Color`).\n44\t    2. The coloured pips in the object's ``mana_cost``.\n45\t    3. An explicit ``color`` attribute (single :class:`Color`).\n46\t\n47\t    Colourless objects return an empty set.\n48\t    \"\"\"\n49\t    # Explicit colors attribute (takes precedence)\n50\t    if hasattr(obj, \"colors\") and obj.colors is not None:\n51\t        return set(obj.colors)\n52\t\n53\t    # Derive from mana cost pips\n54\t    mana_cost = getattr(obj, \"mana_cost\", None)\n55\t    if mana_cost is not None:\n56\t        pips = getattr(mana_cost, \"pips\", None)\n57\t        if pips:\n58\t            result: set[Color] = set()\n59\t            for mt in pips:\n60\t                if mt in _MANA_TO_COLOR:\n61\t                    result.add(_MANA_TO_COLOR[mt])\n62\t            return result\n63\t\n64\t    # Single color attribute fallback\n65\t    if hasattr(obj, \"color\") and obj.color is not None:\n66\t        return {obj.color}\n67\t\n68\t    return set()\n69\t\n70\t\n71\t# ---------------------------------------------------------------------------\n72\t# ProtectionAbility\n73\t# ---------------------------------------------------------------------------\n74\t\n75\t@dataclass\n76\tclass ProtectionAbility:\n77\t    \"\"\"Represents a 'protection from [quality]' ability.\n78\t\n79\t    The *quality* is typically a :class:`Color`, but the framework supports\n80\t    arbitrary predicates via *predicate*.\n81\t\n82\t    Usage::\n83\t\n84\t        # Colour-based protection\n85\t        pro_red = ProtectionAbility(quality=Color.RED)\n86\t\n87\t        # Custom predicate (e.g. protection from artifacts)\n88\t        pro_artifacts = ProtectionAbility(\n89\t            quality=\"artifacts\",\n90\t            predicate=lambda src: CardType.ARTIFACT in getattr(src, \"card_types\", set()),\n91\t        )\n92\t\n93\t    Attributes:\n94\t        quality: A human-readable label for the quality (often a\n95\t            :class:`Color` enum member).\n96\t        predicate: An optional callable ``(source) -> bool`` that returns\n97\t            ``True`` if *source* has the protected-from quality.  When\n98\t            ``None``, the quality must be a :class:`Color` and the default\n99\t            colour-matching predicate is used.\n100\t    \"\"\"\n101\t\n102\t    quality: Any  # typically Color, but may be str or CardType\n103\t    predicate: Callable[[Any], bool] | None = None\n104\t\n105\t    def matches(self, source: Any) -> bool:\n106\t        \"\"\"Return ``True`` if *source* has the quality this protects from.\"\"\"\n107\t        if self.predicate is not None:\n108\t            return self.predicate(source)\n109\t\n110\t        # Default: colour-based matching\n111\t        if isinstance(self.quality, Color):\n112\t            return self.quality in get_colors(source)\n113\t\n114\t        return False\n115\t\n116\t\n117\t# ---------------------------------------------------------------------------\n118\t# Query helpers — work with any object that has a ``protections`` list\n119\t# ---------------------------------------------------------------------------\n120\t\n121\tdef get_protections(obj: Any) -> list[ProtectionAbility]:\n122\t    \"\"\"Return the list of :class:`ProtectionAbility` on *obj*, or ``[]``.\"\"\"\n123\t    return getattr(obj, \"protections\", [])\n124\t\n125\t\n126\tdef has_protection_from(permanent: Any, source: Any) -> bool:\n127\t    \"\"\"Return ``True`` if *permanent* has protection from *source*.\n128\t"}]},"parent_tool_use_id":"toolu_01DdJkrnCk6XXKFwRmJKdNX3","session_id":"69c150b5-c49a-4f71-a445-032aa09f64bc","uuid":"d1d0d8a5-0bd6-430a-8088-25ea67115351","timestamp":"2026-06-02T08:04:10.934Z","s