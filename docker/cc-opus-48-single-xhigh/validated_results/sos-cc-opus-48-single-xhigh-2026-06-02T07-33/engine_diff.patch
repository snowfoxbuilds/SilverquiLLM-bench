diff -ruN a/affinity.py b/affinity.py
--- a/affinity.py	1970-01-01 00:00:00.000000000 +0000
+++ b/affinity.py	2026-06-02 09:50:10.658749869 +0000
@@ -0,0 +1,270 @@
+"""Affinity-keyword framework (Comprehensive Rules 702.41).
+
+*Affinity for [quality]* is a static ability that reduces the generic portion of
+a spell's cost:
+
+    Affinity for creatures (This spell costs {1} less to cast for each creature
+    you control.)
+
+A card normally carries affinity as a printed cost-reduction ability — that
+*own* affinity is implemented with the established ``cost_reduction(self, game)``
+hook (sos_1 / fdn_167 Tolarian Terror), which the engine's
+:func:`engine.casting.get_cost_reduction` clamps to the spell's generic portion.
+
+Witherbloom, the Balancer also *grants* "affinity for creatures" to every
+instant and sorcery **spell** its controller casts.  The engine had no support
+for a granting permanent contributing a per-spell cost reduction, so this module
+adds it *additively* — no existing engine symbol is renamed, moved, or deleted.
+It mirrors :mod:`engine.casualty` / :mod:`engine.miracle` / :mod:`engine.paradigm`.
+
+The mechanic has two observable parts:
+
+1. **The grant surface.**  A *granted affinity-for-creatures* flag is recorded on
+   the affected spell (``spell.affinity_for_creatures = True``) and is also
+   queryable via :func:`grants_affinity_for_creatures`.  A continuous-grant source
+   (Witherbloom) installs / refreshes the grant via
+   :func:`grant_affinity_to_hand`, which only ever writes the flag onto
+   instants/sorceries in *its controller's* hand and clears stale grants from
+   cards that have left the hand.
+
+2. **The granted cost reduction (driven through the cast/cost pipeline).**  A
+   granting permanent registers, per controller, a *granted reduction* — a
+   callable ``(game, spell, controller) -> int`` returning how much {1}-less the
+   grant gives a particular spell (for affinity for creatures: the number of
+   creatures the controller controls).  :func:`get_granted_reduction` sums the
+   contributions of every registered grant that applies to a spell, and
+   :func:`engine.casting.get_cost_reduction` adds that to the cast card's own
+   ``cost_reduction(game)`` hook before clamping to the spell's generic portion.
+   With no grant registered the sum is 0, so existing cost-reduction behaviour
+   (sos_1, fdn_167) is unchanged.
+
+"Affinity" is a *printed keyword label*, not an evergreen keyword, so no member
+is added to :class:`engine.types.Keyword` (that enum is frozen at 16 members).
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any, Callable
+
+from engine.types import CardType, Zone
+
+if TYPE_CHECKING:
+    from engine.game_state import GameState
+
+
+#: Type of a granted-reduction resolver: ``(game, spell, controller) -> int``.
+ReductionResolver = Callable[[Any, Any, Any], int]
+
+
+# ---------------------------------------------------------------------------
+# Grant surface — read / write the granted affinity flag on a spell
+# ---------------------------------------------------------------------------
+
+
+def is_instant_or_sorcery(card: Any) -> bool:
+    """Return ``True`` if *card* is an instant or sorcery (the granted types)."""
+    card_types = getattr(card, "card_types", set())
+    return CardType.INSTANT in card_types or CardType.SORCERY in card_types
+
+
+def grants_affinity_for_creatures(card: Any) -> bool:
+    """Return ``True`` if *card* currently carries a granted affinity-for-creatures."""
+    return bool(getattr(card, "affinity_for_creatures", False))
+
+
+def set_affinity_for_creatures(card: Any, granted: bool) -> None:
+    """Write (or clear) the granted affinity-for-creatures flag on *card*.
+
+    Passing ``False`` clears the grant (removes the ``affinity_for_creatures``
+    attribute so a stale grant never lingers on a card that has left the granting
+    zone).
+    """
+    if not granted:
+        if hasattr(card, "affinity_for_creatures"):
+            try:
+                delattr(card, "affinity_for_creatures")
+            except AttributeError:
+                card.affinity_for_creatures = False  # type: ignore[attr-defined]
+        if hasattr(card, "_affinity_grant_source"):
+            try:
+                delattr(card, "_affinity_grant_source")
+            except AttributeError:
+                pass
+        return
+    card.affinity_for_creatures = True  # type: ignore[attr-defined]
+
+
+# ---------------------------------------------------------------------------
+# Per-game registry of cards a given source has flagged with the grant
+# ---------------------------------------------------------------------------
+
+
+def _flagged_registry(game: GameState) -> dict[int, set[int]]:
+    """Return (creating if necessary) the per-game affinity-flag registry.
+
+    Maps ``id(source)`` to the set of ``id(card)`` it last flagged, so a refresh
+    can clear flags from cards that have since left the granting zone.  Stored
+    lazily on the game object — no ``GameState.__init__`` change.
+    """
+    registry = getattr(game, "_affinity_flags", None)
+    if registry is None:
+        registry = {}
+        game._affinity_flags = registry  # type: ignore[attr-defined]
+    return registry
+
+
+def grant_affinity_to_hand(
+    game: GameState,
+    source: Any,
+    controller: Any,
+) -> list[Any]:
+    """Flag every instant/sorcery in *controller*'s hand as having affinity.
+
+    This is the observable half of Witherbloom's continuous static ability:
+    while the source is on the battlefield, every instant and sorcery spell its
+    controller casts "has affinity for creatures".  The flag is written onto each
+    such hand card (``card.affinity_for_creatures = True``) and is queryable via
+    :func:`grants_affinity_for_creatures`.
+
+    The grant is *scoped*:
+
+    * only instants and sorceries are flagged (creatures, lands, etc. are not);
+    * only cards in *controller*'s hand are flagged (an opponent's hand is left
+      untouched).
+
+    Calling this again refreshes the flag: cards that have left the controller's
+    hand since the last refresh have their (this-source) flag cleared so a stale
+    grant never lingers.  Returns the list of hand cards now carrying the flag.
+    """
+    if controller is None:
+        return []
+
+    registry = _flagged_registry(game)
+    previously = registry.get(id(source), set())
+
+    hand = controller.zones[Zone.HAND]
+    granted: list[Any] = []
+    now_ids: set[int] = set()
+
+    for card in hand.get_all():
+        if not is_instant_or_sorcery(card):
+            continue
+        set_affinity_for_creatures(card, True)
+        card._affinity_grant_source = source  # type: ignore[attr-defined]
+        granted.append(card)
+        now_ids.add(id(card))
+
+    stale = previously - now_ids
+    if stale:
+        _clear_flags_for_ids(game, source, stale)
+
+    registry[id(source)] = now_ids
+    return granted
+
+
+def _clear_flags_for_ids(game: GameState, source: Any, card_ids: set[int]) -> None:
+    """Clear *source*'s affinity flag from any card in *card_ids* across zones."""
+    for player in game.players:
+        for zone in Zone:
+            container = player.zones[zone]
+            for card in list(container.get_all()):
+                if (
+                    id(card) in card_ids
+                    and getattr(card, "_affinity_grant_source", None) is source
+                ):
+                    set_affinity_for_creatures(card, False)
+
+
+def clear_affinity_flags(game: GameState, source: Any) -> None:
+    """Clear every affinity flag *source* placed (e.g. when it leaves play)."""
+    registry = _flagged_registry(game)
+    granted = registry.pop(id(source), set())
+    if not granted:
+        return
+    _clear_flags_for_ids(game, source, granted)
+
+
+# ---------------------------------------------------------------------------
+# Granted-reduction registry — drive the granted cost reduction through the
+# cast/cost pipeline (mirrors engine.casualty / engine.miracle grant registries)
+# ---------------------------------------------------------------------------
+
+
+def _grant_registry(game: GameState) -> dict[int, dict[str, Any]]:
+    """Return (creating if necessary) the per-game granted-reduction registry.
+
+    Maps ``id(source)`` to a record ``{"controller", "applies", "resolver"}``:
+
+    * ``controller`` — the player whose spells the grant applies to;
+    * ``applies`` — predicate ``(game, spell, controller) -> bool`` deciding
+      whether a given spell receives the grant (e.g. controller's instants /
+      sorceries, source on the battlefield);
+    * ``resolver`` — :data:`ReductionResolver` returning the {1}-less count for a
+      qualifying spell (for affinity for creatures: how many creatures the
+      controller controls).
+
+    Stored lazily on the game object — no ``GameState.__init__`` change.
+    """
+    registry = getattr(game, "_affinity_grants", None)
+    if registry is None:
+        registry = {}
+        game._affinity_grants = registry  # type: ignore[attr-defined]
+    return registry
+
+
+def register_affinity_grant(
+    game: GameState,
+    source: Any,
+    controller: Any,
+    resolver: ReductionResolver,
+    applies: Callable[[Any, Any, Any], bool],
+) -> None:
+    """Register *source*'s granted per-spell cost reduction (idempotent per source).
+
+    When a spell is cast, :func:`get_granted_reduction` consults every registered
+    grant whose ``applies(game, spell, controller)`` predicate returns ``True``
+    and sums each grant's ``resolver(game, spell, controller)`` contribution.
+    :func:`engine.casting.get_cost_reduction` adds that sum to the cast card's own
+    ``cost_reduction(game)`` before clamping to the spell's generic portion.
+
+    Re-registering the same source overwrites its record (so a refreshed grant
+    keeps the latest controller/resolver) — keyed by ``id(source)``.
+    """
+    _grant_registry(game)[id(source)] = {
+        "controller": controller,
+        "applies": applies,
+        "resolver": resolver,
+    }
+
+
+def clear_affinity_grant(game: GameState, source: Any) -> None:
+    """Remove *source*'s granted-reduction record (e.g. when it leaves play)."""
+    _grant_registry(game).pop(id(source), None)
+
+
+def get_granted_reduction(game: GameState, spell: Any, controller: Any) -> int:
+    """Return the total granted generic reduction for *controller* casting *spell*.
+
+    Sums the contribution of every registered grant whose ``applies`` predicate
+    accepts ``(game, spell, controller)``.  Returns ``0`` when no grant applies —
+    so a spell with no granting permanent in play is reduced only by its own
+    ``cost_reduction`` hook (existing behaviour is unchanged).
+    """
+    registry = getattr(game, "_affinity_grants", None)
+    if not registry:
+        return 0
+    total = 0
+    for record in list(registry.values()):
+        applies = record.get("applies")
+        resolver = record.get("resolver")
+        if resolver is None:
+            continue
+        try:
+            if applies is not None and not applies(game, spell, controller):
+                continue
+            contribution = resolver(game, spell, controller)
+        except Exception:
+            continue
+        if contribution and contribution > 0:
+            total += int(contribution)
+    return total
diff -ruN a/animation.py b/animation.py
--- a/animation.py	1970-01-01 00:00:00.000000000 +0000
+++ b/animation.py	2026-06-02 10:27:30.616210666 +0000
@@ -0,0 +1,305 @@
+"""Land-animation ("becomes a creature") framework.
+
+Several lands turn themselves into creatures while remaining lands — e.g.
+Great Hall of the Biblioplex:
+
+    {5}: If this land isn't a creature, it becomes a 2/4 Wizard creature with
+    "Whenever you cast an instant or sorcery spell, this creature gets +1/+0
+    until end of turn."  It's still a land.
+
+The engine's :mod:`engine.continuous_effects` layer system already models type
+changes (Layer 4) and P/T effects (Layer 7), but it had no helper to *animate*
+a non-Creature :class:`~engine.card.CardImpl` into a creature that retains its
+land type, exposes a base power/toughness, and gains a creature subtype.  This
+module adds that helper *additively* — no existing engine symbol is renamed,
+moved, or deleted.  It mirrors the lazy per-game-registry + grant conventions of
+:mod:`engine.miracle` / :mod:`engine.casualty` / :mod:`engine.affinity`.
+
+Two observable mechanisms live here:
+
+1. **Animation** (:func:`animate_land`).  Layers ``CardType.CREATURE`` onto the
+   land while keeping ``CardType.LAND``, grants a creature subtype, and sets a
+   base body.  The body is observable via ``card.power`` / ``card.toughness``
+   once the card reports those characteristics under the active animation (a
+   :class:`~engine.card.Land` ordinarily has no power/toughness — the animating
+   card is expected to expose ``power``/``toughness`` properties that read the
+   animation state set here; see ``cards/sos/sos_257``).  The animation is
+   durable (``DURATION_PERMANENT`` — it lasts until the land leaves play), and
+   is *idempotent* per land via a lazy per-game registry, so "if this land isn't
+   a creature" re-activation is a true no-op.
+
+2. **The granted pump trigger** (:func:`register_instant_sorcery_pump`).  The
+   animation grants the land a triggered ability — "Whenever you cast an instant
+   or sorcery spell, this creature gets +1/+0 until end of turn" — registered as
+   a :class:`~engine.events.SpellCastTriggeredEvent` trigger controlled by the
+   land's controller and gated to that controller's own instant/sorcery casts.
+   Firing it adds a Layer 7c (``MODIFY_PT``) +1/+0 :class:`ContinuousEffect`
+   with ``DURATION_END_OF_TURN`` to the land, so N casts in a turn yield +N/+0,
+   swept back at cleanup by ``EffectManager.remove_expired``.  The trigger is
+   deduped per source so animating once registers exactly one trigger.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any
+
+from engine.continuous_effects import (
+    DURATION_END_OF_TURN,
+    DURATION_PERMANENT,
+    ContinuousEffect,
+    Layer,
+    SubLayer,
+)
+from engine.events import SpellCastTriggeredEvent
+from engine.triggers import TriggerRegistration
+from engine.types import CardType
+
+if TYPE_CHECKING:
+    from engine.game_state import GameState
+
+
+# ---------------------------------------------------------------------------
+# Per-game registry of animated permanents (idempotency / "isn't a creature")
+# ---------------------------------------------------------------------------
+
+
+def _animation_registry(game: GameState) -> dict[int, dict[str, Any]]:
+    """Return (creating if necessary) the per-game land-animation registry.
+
+    Maps ``id(land)`` to a record describing the active animation.  Stored
+    lazily on the game object so no ``GameState.__init__`` change is needed.
+    """
+    registry = getattr(game, "_land_animations", None)
+    if registry is None:
+        registry = {}
+        game._land_animations = registry  # type: ignore[attr-defined]
+    return registry
+
+
+def is_animated(game: GameState, land: Any) -> bool:
+    """Return ``True`` if *land* is currently animated into a creature.
+
+    Checks both the per-game registry and the land's own card types, so a card
+    that became a creature by any means reports correctly.
+    """
+    if id(land) in _animation_registry(game):
+        return True
+    return CardType.CREATURE in getattr(land, "card_types", set())
+
+
+# ---------------------------------------------------------------------------
+# Animation — becomes a creature, still a land
+# ---------------------------------------------------------------------------
+
+
+def animate_land(
+    game: GameState,
+    land: Any,
+    base_power: int,
+    base_toughness: int,
+    subtype: str | None = None,
+    controller: Any = None,
+) -> bool:
+    """Animate *land* into a ``base_power``/``base_toughness`` creature.
+
+    Implements "it becomes a [P]/[T] [subtype] creature ... It's still a land":
+
+    * adds ``CardType.CREATURE`` to the land's card types while RETAINING
+      ``CardType.LAND``;
+    * grants *subtype* (e.g. ``"Wizard"``) to its subtypes;
+    * records a base body the animating card can surface via ``power`` /
+      ``toughness`` (this writes ``land._animated``, ``land._anim_base_power``,
+      ``land._anim_base_toughness``, and seeds ``modified_power`` /
+      ``modified_toughness``);
+    * installs a durable (``DURATION_PERMANENT``) Layer-4 type effect and a
+      Layer 7b ``SET_PT`` base-body effect through the engine layer system so
+      the change survives ``EffectManager.apply_all``'s reset-and-reapply.
+
+    The change is applied *immediately* (so ``CardType.CREATURE`` is observable
+    without first calling ``apply_all``) AND registered as a continuous effect
+    (so it persists across recomputation).
+
+    Guarded by "if this land isn't a creature": if *land* is already animated
+    (or already a creature), this is a no-op and returns ``False``.  Otherwise
+    it animates and returns ``True``.
+    """
+    if is_animated(game, land):
+        return False
+
+    if controller is None:
+        controller = getattr(land, "controller", None)
+
+    # --- Immediate mutation so the new characteristics are observable now. ---
+    land.card_types = set(getattr(land, "card_types", set())) | {CardType.CREATURE}
+    if subtype is not None:
+        subtypes = getattr(land, "subtypes", None)
+        if subtypes is None:
+            subtypes = set()
+            land.subtypes = subtypes
+        subtypes.add(subtype)
+
+    land._animated = True  # type: ignore[attr-defined]
+    land._anim_base_power = base_power  # type: ignore[attr-defined]
+    land._anim_base_toughness = base_toughness  # type: ignore[attr-defined]
+    land._anim_subtype = subtype  # type: ignore[attr-defined]
+    land.modified_power = base_power  # type: ignore[attr-defined]
+    land.modified_toughness = base_toughness  # type: ignore[attr-defined]
+
+    # --- Durable layer effects so the animation survives apply_all resets. ---
+    def _apply_type(g: GameState) -> None:
+        land.card_types = set(getattr(land, "card_types", set())) | {
+            CardType.CREATURE
+        }
+        land.card_types.add(CardType.LAND)
+        if subtype is not None:
+            land.subtypes.add(subtype)
+
+    def _apply_base_body(g: GameState) -> None:
+        land.modified_power = base_power  # type: ignore[attr-defined]
+        land.modified_toughness = base_toughness  # type: ignore[attr-defined]
+
+    type_effect = ContinuousEffect(
+        source=land,
+        layer=Layer.TYPE,
+        apply=_apply_type,
+        duration=DURATION_PERMANENT,
+    )
+    body_effect = ContinuousEffect(
+        source=land,
+        layer=Layer.POWER_TOUGHNESS,
+        sublayer=SubLayer.SET_PT,
+        apply=_apply_base_body,
+        duration=DURATION_PERMANENT,
+    )
+    game.effect_manager.add(type_effect)
+    game.effect_manager.add(body_effect)
+
+    _animation_registry(game)[id(land)] = {
+        "controller": controller,
+        "base_power": base_power,
+        "base_toughness": base_toughness,
+        "subtype": subtype,
+        "type_effect": type_effect,
+        "body_effect": body_effect,
+    }
+    return True
+
+
+def deanimate_land(game: GameState, land: Any) -> None:
+    """Remove *land*'s animation (e.g. when it leaves the battlefield).
+
+    Drops the registry record and the durable layer effects, clears the
+    animation flags, and removes the granted pump trigger.  This is the
+    "until it leaves play" cleanup; it is safe to call when *land* is not
+    animated (no-op).
+    """
+    registry = _animation_registry(game)
+    record = registry.pop(id(land), None)
+    if record is None:
+        return
+    for key in ("type_effect", "body_effect"):
+        effect = record.get(key)
+        if effect is not None:
+            game.effect_manager.remove(effect)
+    game.trigger_manager.unregister(land)
+    # Clear the pump-trigger dedup entry so a later re-animation of the same
+    # Python object can re-grant its instant/sorcery pump trigger (symmetry
+    # with register_instant_sorcery_pump's per-source dedup).
+    _pump_trigger_registry(game).discard(id(land))
+    land._animated = False  # type: ignore[attr-defined]
+    land.card_types = set(getattr(land, "card_types", set())) - {CardType.CREATURE}
+    subtype = record.get("subtype")
+    if subtype is not None and subtype in getattr(land, "subtypes", set()):
+        land.subtypes.discard(subtype)
+
+
+# ---------------------------------------------------------------------------
+# The granted pump trigger
+# ---------------------------------------------------------------------------
+
+
+def add_pump_until_end_of_turn(
+    game: GameState,
+    land: Any,
+    power_bonus: int = 1,
+    toughness_bonus: int = 0,
+) -> ContinuousEffect:
+    """Give *land* +``power_bonus``/+``toughness_bonus`` until end of turn.
+
+    Adds a Layer 7c (``MODIFY_PT``) :class:`ContinuousEffect` with
+    ``DURATION_END_OF_TURN`` to the engine layer system.  After
+    ``EffectManager.apply_all`` the bonus is visible via ``land.power`` /
+    ``land.toughness``; firing this N times in a turn stacks to +N/+0, and
+    ``EffectManager.remove_expired`` (run at cleanup) sweeps every such effect
+    away so the body resets at end of turn.
+    """
+
+    def _apply(g: GameState) -> None:
+        if getattr(land, "modified_power", None) is not None:
+            land.modified_power += power_bonus  # type: ignore[attr-defined]
+        if getattr(land, "modified_toughness", None) is not None:
+            land.modified_toughness += toughness_bonus  # type: ignore[attr-defined]
+
+    effect = ContinuousEffect(
+        source=land,
+        layer=Layer.POWER_TOUGHNESS,
+        sublayer=SubLayer.MODIFY_PT,
+        apply=_apply,
+        duration=DURATION_END_OF_TURN,
+    )
+    return game.effect_manager.add(effect)
+
+
+def _pump_trigger_registry(game: GameState) -> set[int]:
+    """Return (creating if necessary) the per-game pump-trigger dedup set."""
+    registry = getattr(game, "_animation_pump_triggers", None)
+    if registry is None:
+        registry = set()
+        game._animation_pump_triggers = registry  # type: ignore[attr-defined]
+    return registry
+
+
+def register_instant_sorcery_pump(
+    game: GameState,
+    land: Any,
+    controller: Any,
+    power_bonus: int = 1,
+    toughness_bonus: int = 0,
+) -> TriggerRegistration | None:
+    """Grant *land* "whenever you cast an instant/sorcery, +1/+0 until EOT".
+
+    Registers (deduped per source via a lazy per-game registry) a
+    :class:`~engine.events.SpellCastTriggeredEvent` trigger controlled by
+    *controller* and gated to *controller*'s own instant/sorcery casts.  When it
+    fires, :func:`add_pump_until_end_of_turn` gives *land*
+    +``power_bonus``/+``toughness_bonus`` until end of turn.
+
+    Returns the created :class:`~engine.triggers.TriggerRegistration`, or
+    ``None`` if a pump trigger was already registered for this source (so a
+    second animation does not stack a second grant).
+    """
+    registry = _pump_trigger_registry(game)
+    if id(land) in registry:
+        return None
+
+    def _condition(g: GameState, event: SpellCastTriggeredEvent) -> bool:
+        caster = getattr(event, "player", None) or getattr(event, "controller", None)
+        if caster is not controller:
+            return False
+        spell = getattr(event, "spell", None) or getattr(event, "card", None)
+        card_types = getattr(spell, "card_types", set())
+        return CardType.INSTANT in card_types or CardType.SORCERY in card_types
+
+    def _effect(g: GameState) -> None:
+        add_pump_until_end_of_turn(g, land, power_bonus, toughness_bonus)
+
+    trigger = TriggerRegistration(
+        event_type=SpellCastTriggeredEvent,
+        condition=_condition,
+        effect=_effect,
+        source=land,
+        controller=controller,
+    )
+    game.trigger_manager.register(trigger)
+    registry.add(id(land))
+    return trigger
diff -ruN a/casting.py b/casting.py
--- a/casting.py	2026-05-25 16:43:11.728292087 +0000
+++ b/casting.py	2026-06-02 10:10:08.634840975 +0000
@@ -89,12 +89,20 @@
 def get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:
     """Return the generic mana reduction for casting *card*.
 
-    Queries ``card.cost_reduction(game)`` and clamps the result so that
-    the generic portion of the mana cost cannot go below 0.
+    Queries ``card.cost_reduction(game)`` for the card's *own* cost reduction
+    (e.g. Tolarian Terror counting instants/sorceries in your graveyard, or
