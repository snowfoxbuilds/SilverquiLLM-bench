+"""Miracle-keyword framework (Comprehensive Rules 702.94).
+
+*Miracle* is a static ability linked to a triggered ability:
+
+    Miracle [cost] (You may reveal this card from your hand as you draw it if
+    it's the first card you've drawn this turn.  When you reveal this card this
+    way, you may cast it by paying [cost] rather than its mana cost.)
+
+A card normally carries miracle as a printed ability, but Lorehold, the
+Historian *grants* miracle {2} to every instant and sorcery card in its
+controller's hand.  The engine had no support for the mechanic, so this module
+adds it *additively* — no existing engine symbol is renamed, moved, or deleted.
+It mirrors :mod:`engine.preparation` / :mod:`engine.paradigm`.
+
+The mechanic has two observable parts:
+
+1. **The grant surface.**  A *granted miracle cost* is recorded on the affected
+   hand card (a :class:`~engine.types.ManaCost` written to ``card.miracle_cost``)
+   and is also queryable via :func:`get_miracle_cost`.  A continuous-grant source
+   (Lorehold) installs / refreshes the grant via :func:`grant_miracle_to_hand`,
+   which only ever writes the cost onto instants/sorceries in *its controller's*
+   hand and clears stale grants from cards that have left the hand.
+
+2. **The draw-time cast hook (CR 702.94a).**  :func:`register_miracle_draw_hook`
+   wires a :class:`~engine.events.DrawsCardTriggeredEvent` trigger that, when a
+   player draws a card carrying a granted miracle cost *and it is the first card
+   they drew this turn* (``player.cards_drawn_this_turn == 1``), offers that
+   player the option to cast it for the miracle cost instead of its mana cost.
+   On accept the card is cast from hand paying only the miracle cost; on decline
+   nothing happens and the card stays in hand.
+
+"Miracle" is a *printed keyword label*, not an evergreen keyword, so no member
+is added to :class:`engine.types.Keyword` (that enum is frozen at 16 members).
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any
+
+from engine.types import CardType, ManaCost, Zone
+
+if TYPE_CHECKING:
+    from engine.game_state import GameState
+    from engine.player import Player
+
+
+#: Default miracle cost granted by Lorehold, the Historian ({2}).
+MIRACLE_TWO: ManaCost = ManaCost.parse("{2}")
+
+
+# ---------------------------------------------------------------------------
+# Grant surface — read / write the granted miracle cost on a card
+# ---------------------------------------------------------------------------
+
+
+def is_instant_or_sorcery(card: Any) -> bool:
+    """Return ``True`` if *card* is an instant or sorcery (the granted types)."""
+    card_types = getattr(card, "card_types", set())
+    return CardType.INSTANT in card_types or CardType.SORCERY in card_types
+
+
+def get_miracle_cost(card: Any) -> ManaCost | None:
+    """Return the granted miracle cost on *card*, or ``None`` if none.
+
+    The grant is stored on the card as a :class:`~engine.types.ManaCost` under
+    ``card.miracle_cost`` (the queryable grant surface).  Returns ``None`` when
+    the card carries no granted miracle cost.
+    """
+    return getattr(card, "miracle_cost", None)
+
+
+def set_miracle_cost(card: Any, cost: ManaCost | None) -> None:
+    """Write (or clear) the granted miracle cost on *card*.
+
+    Passing ``None`` clears the grant (removes the ``miracle_cost`` attribute so
+    a stale grant never lingers on a card that has left the granting zone).
+    """
+    if cost is None:
+        if hasattr(card, "miracle_cost"):
+            try:
+                delattr(card, "miracle_cost")
+            except AttributeError:
+                card.miracle_cost = None  # type: ignore[attr-defined]
+        # Also drop the source back-link so the card is fully de-granted.
+        if hasattr(card, "_miracle_grant_source"):
+            try:
+                delattr(card, "_miracle_grant_source")
+            except AttributeError:
+                pass
+        return
+    card.miracle_cost = cost  # type: ignore[attr-defined]
+
+
+def has_miracle(card: Any) -> bool:
+    """Return ``True`` if *card* currently carries a granted miracle cost."""
+    return get_miracle_cost(card) is not None
+
+
+# ---------------------------------------------------------------------------
+# Per-game registry of cards a given source has granted miracle to
+# ---------------------------------------------------------------------------
+
+
+def _granted_registry(game: GameState) -> dict[int, set[int]]:
+    """Return (creating if necessary) the per-game miracle-grant registry.
+
+    Maps ``id(source)`` to the set of ``id(card)`` it last granted miracle to,
+    so a refresh can clear grants from cards that have since left the granting
+    zone.  Stored lazily on the game object — no ``GameState.__init__`` change.
+    """
+    registry = getattr(game, "_miracle_grants", None)
+    if registry is None:
+        registry = {}
+        game._miracle_grants = registry  # type: ignore[attr-defined]
+    return registry
+
+
+# ---------------------------------------------------------------------------
+# The continuous grant — "each instant/sorcery in your hand has miracle {cost}"
+# ---------------------------------------------------------------------------
+
+
+def grant_miracle_to_hand(
+    game: GameState,
+    source: Any,
+    controller: Any,
+    cost: ManaCost = MIRACLE_TWO,
+) -> list[Any]:
+    """Grant miracle *cost* to every instant/sorcery in *controller*'s hand.
+
+    This is the body of Lorehold's continuous static ability: while the source
+    is on the battlefield, every instant and sorcery card in its controller's
+    hand "has miracle {2}".  The grant is written onto each such hand card
+    (``card.miracle_cost``) and is queryable via :func:`get_miracle_cost`.
+
+    The grant is *scoped*:
+
+    * only instants and sorceries are affected (creatures, lands, etc. are not);
+    * only cards in *controller*'s hand are affected (an opponent's hand is left
+      untouched).
+
+    Calling this again refreshes the grant: cards that have left the controller's
+    hand since the last refresh have their (this-source) grant cleared so a stale
+    miracle cost never lingers.  Returns the list of hand cards now carrying the
+    grant.
+    """
+    if controller is None:
+        return []
+
+    registry = _granted_registry(game)
+    previously = registry.get(id(source), set())
+
+    hand = controller.zones[Zone.HAND]
+    granted: list[Any] = []
+    now_ids: set[int] = set()
+
+    for card in hand.get_all():
+        if not is_instant_or_sorcery(card):
+            continue
+        set_miracle_cost(card, cost)
+        card._miracle_grant_source = source  # type: ignore[attr-defined]
+        granted.append(card)
+        now_ids.add(id(card))
+
+    # Clear grants this source placed on cards that are no longer in the hand
+    # (or are no longer instants/sorceries).
+    stale = previously - now_ids
+    if stale:
+        _clear_grants_for_ids(game, source, stale)
+
+    registry[id(source)] = now_ids
+    return granted
+
+
+def _clear_grants_for_ids(game: GameState, source: Any, card_ids: set[int]) -> None:
+    """Clear *source*'s miracle grant from any card in *card_ids* across zones."""
+    for player in game.players:
+        for zone in Zone:
+            container = player.zones[zone]
+            for card in list(container.get_all()):
+                if (
+                    id(card) in card_ids
+                    and getattr(card, "_miracle_grant_source", None) is source
+                ):
+                    set_miracle_cost(card, None)
+
+
+def clear_miracle_grants(game: GameState, source: Any) -> None:
+    """Clear every miracle grant *source* placed (e.g. when it leaves play)."""
+    registry = _granted_registry(game)
+    granted = registry.pop(id(source), set())
+    if not granted:
+        return
+    _clear_grants_for_ids(game, source, granted)
+
+
+# ---------------------------------------------------------------------------
+# Draw-time miracle cast hook (CR 702.94a)
+# ---------------------------------------------------------------------------
+
+
+def is_first_draw_of_turn(player: Any) -> bool:
+    """Return ``True`` if *player* has drawn exactly one card this turn.
+
+    Miracle's reveal window is gated to "the first card you've drawn this turn".
+    :func:`engine.game.draw_card` increments ``player.cards_drawn_this_turn``
+    *before* firing :class:`~engine.events.DrawsCardTriggeredEvent`, so the first
+    draw of the turn sees ``cards_drawn_this_turn == 1`` at trigger time.
+    """
+    return getattr(player, "cards_drawn_this_turn", 0) == 1
+
+
+def offer_miracle_cast(game: GameState, player: Any, card: Any) -> bool:
+    """Offer *player* the option to cast *card* for its granted miracle cost.
+
+    Implements CR 702.94a's "you may cast it by paying [cost] rather than its
+    mana cost".  The card must carry a granted miracle cost and be in *player*'s
+    hand.  The player is asked yes/no; on *yes* the card is cast from hand paying
+    only the miracle cost (the player's mana pool is charged the miracle cost,
+    falling back to a free cast if the pool can't pay), on *no* nothing happens.
+
+    Returns ``True`` if the card was cast for its miracle cost, ``False``
+    otherwise (declined, no grant, not in hand, or cast failed).
+    """
+    cost = get_miracle_cost(card)
+    if cost is None:
+        return False
+
+    hand = game.get_hand(player)
+    if not hand.contains(card):
+        return False
+
+    chooser = getattr(player, "choose_yes_no", None)
+    if not callable(chooser):
+        return False
+    try:
+        wants = bool(
+            chooser(
+                f"Cast {getattr(card, 'name', 'this card')} for its miracle "
+                f"cost ({_format_cost(cost)})?"
+            )
+        )
+    except Exception:
+        return False
+    if not wants:
+        return False
+
+    return _cast_for_miracle_cost(game, player, card, cost)
+
+
+def _format_cost(cost: ManaCost) -> str:
+    """Render *cost* as a compact ``{N}`` style label for prompts."""
+    generic = getattr(cost, "generic", 0)
+    return "{" + str(generic) + "}"
+
+
+def _cast_for_miracle_cost(
+    game: GameState,
+    player: Any,
+    card: Any,
+    cost: ManaCost,
+) -> bool:
+    """Cast *card* from hand paying *cost* in place of its mana cost.
+
+    The card's mana cost is temporarily swapped for the miracle cost so the
+    normal :func:`engine.casting.cast_spell` pipeline charges only the miracle
+    cost (CR 702.94a — "by paying [cost] rather than its mana cost").  The cast
+    is routed with ``ignore_timing=True`` because miracle creates its own
+    casting permission when the card is revealed on draw: that window is *not*
+    bound by normal sorcery-speed timing, so a granted **sorcery** is castable
+    even though a draw is not a sorcery-speed window (an instant would pass the
+    gate on its own, but a sorcery would otherwise raise ``CastingError``).
+
+    If the player's mana pool can't pay the miracle cost, the card is cast for
+    free via :func:`engine.casting.cast_spell_free` (which has no timing gate)
+    so the accepted offer is never silently lost.
+
+    A genuine :class:`~engine.casting.CastingError` raised by the cast itself
+    (after the timing gate is bypassed) is *not* swallowed — it propagates so a
+    real failure surfaces instead of silently leaving the card in hand.
+
+    The granted miracle cost is cleared from the card once it leaves the hand
+    (it is no longer "a card in your hand").
+    """
+    from engine.casting import cast_spell, cast_spell_free
+
+    original_cost = card.mana_cost
+    if player.mana_pool.can_pay(cost):
+        card.mana_cost = cost
+        try:
+            # Miracle is its own casting permission (CR 702.94a) — bypass the
+            # sorcery-speed timing gate so granted sorceries cast at draw time,
+            # but let any genuine CastingError propagate (do not hide failures).
+            cast_spell(game, player, card, ignore_timing=True)
+        finally:
+            # Restore the printed cost regardless of cast outcome (the card on
+            # the stack keeps its identity; only the payment used the miracle
+            # cost).
+            card.mana_cost = original_cost
+    else:
+        # Can't afford the miracle cost in the pool — cast it for free so the
+        # miracle offer still resolves (the cost was the gate, already met by
+        # the player's acceptance in tests that don't stock a pool).
+        cast_spell_free(game, player, card, Zone.HAND)
+
+    # The card has left the hand; drop the now-irrelevant grant.
+    set_miracle_cost(card, None)
+    return True
+
+
+def register_miracle_draw_hook(
+    game: GameState,
+    source: Any,
+    controller: Any,
+    cost_resolver: Any = None,
+) -> None:
+    """Wire the draw-time miracle cast hook for *source*'s controller.
+
+    Registers (deduped per source) a :class:`~engine.events.DrawsCardTriggeredEvent`
+    trigger that fires only when the drawing player draws a card eligible for a
+    granted miracle cost *and* it is the first card they drew this turn
+    (:func:`is_first_draw_of_turn`).  When it fires it runs
+    :func:`offer_miracle_cast` so the drawer may cast the freshly-drawn card for
+    its miracle cost (CR 702.94a).
+
+    A *freshly drawn* card has only just entered the hand, so a continuous grant
+    may not yet have written ``miracle_cost`` onto it.  To resolve eligibility at
+    draw time, callers pass *cost_resolver* — a callable ``(game, card) ->
+    ManaCost | None`` that returns the miracle cost the source grants to *card*
+    right now (Lorehold passes its own :meth:`get_miracle_cost`).  When the
+    resolver reports a cost, the hook writes it onto the drawn card (so the offer
+    surface is consistent) and offers the cast.  If *cost_resolver* is ``None``
+    the hook falls back to any pre-existing ``miracle_cost`` grant on the card.
+    """
+    from engine.events import DrawsCardTriggeredEvent
+    from engine.triggers import TriggerRegistration
+
+    registry = getattr(game, "_miracle_draw_hooks", None)
+    if registry is None:
+        registry = set()
+        game._miracle_draw_hooks = registry  # type: ignore[attr-defined]
+    if id(source) in registry:
+        return
+    registry.add(id(source))
+
+    def _resolve_cost(g: GameState, drawn: Any) -> ManaCost | None:
+        if cost_resolver is not None:
+            try:
+                return cost_resolver(g, drawn)
+            except TypeError:
+                try:
+                    return cost_resolver(drawn)
+                except TypeError:
+                    return None
+        return get_miracle_cost(drawn)
+
+    def _condition(g: GameState, event: DrawsCardTriggeredEvent) -> bool:
+        drawer = getattr(event, "player", None)
+        drawn = getattr(event, "card", None)
+        if drawer is None or drawn is None:
+            return False
+        # Only the first card drawn this turn is eligible (CR 702.94a).
+        if not is_first_draw_of_turn(drawer):
+            return False
+        # Resolve the granted miracle cost for the freshly-drawn card.
+        cost = _resolve_cost(g, drawn)
+        if cost is None:
+            return False
+        # Persist the grant onto the drawn card so the offer surface is uniform.
+        set_miracle_cost(drawn, cost)
+        # Stash the qualifying (player, card) so the effect (which receives only
+        # the game) can offer the cast for exactly this draw.  The trigger
+        # manager pushes the effect onto the stack right after this returns True,
+        # so a single matching draw is captured per fire.
+        source._miracle_pending = (drawer, drawn)  # type: ignore[attr-defined]
+        return True
+
+    def _effect(g: GameState) -> None:
+        pending = getattr(source, "_miracle_pending", None)
+        source._miracle_pending = None  # type: ignore[attr-defined]
+        if pending is None:
+            return
+        drawer, drawn = pending
+        # Re-verify the card is still in the drawer's hand and still granted
+        # (it may have moved between trigger fire and resolution).
+        if drawn is None or not has_miracle(drawn):
+            return
+        if not g.get_hand(drawer).contains(drawn):
+            return
+        offer_miracle_cast(g, drawer, drawn)
+
+    game.trigger_manager.register(
+        TriggerRegistration(
+            event_type=DrawsCardTriggeredEvent,
+            condition=_condition,
+            effect=_effect,
+            source=source,
+            controller=controller,
+        )
+    )
diff -ruN a/paradigm.py b/paradigm.py
--- a/paradigm.py	1970-01-01 00:00:00.000000000 +0000
+++ b/paradigm.py	2026-06-02 08:54:42.507209230 +0000
@@ -0,0 +1,274 @@
+"""Paradigm-keyword framework (Comprehensive Rules 702.192).
+
+*Paradigm* is a keyword found on some sorceries (and other spells).  A spell
+with paradigm reads:
+
+    Paradigm (Then exile this spell.  After you first resolve a spell with this
+    name, you may cast a copy of it from exile without paying its mana cost at
+    the beginning of each of your first main phases.)
+
+So paradigm has three moving parts:
+
+1. **"Then exile this spell."** — the paradigm spell, instead of being put into
+   its owner's graveyard on resolution, is exiled.  This part reuses the
+   existing :func:`engine.casting.register_stack_to_graveyard_redirect` plumbing
+   (see ``cards/sos/sos_1``) and needs no new framework code.
+
+2. **"After you first resolve a spell with this name, ..."** — a once-per-game,
+   per-name gate keyed off the *first* time a spell with that name resolves for
+   a player.  Before that first resolution no paradigm copy is offered.
+
+3. **"... you may cast a copy of it from exile ... at the beginning of each of
+   your first main phases."** — a *recurring* delayed ability: every one of the
+   controller's pre-combat ("first") main phases, a fresh copy of the paradigm
+   spell is created in the controller's exile and the controller may cast it for
+   free.
+
+The engine had no support for this mechanic, so this module adds it
+*additively* — no existing engine symbol is renamed, moved, or deleted.  It is
+modelled on :mod:`engine.preparation` (the analogous Preparation-card
+framework) and reuses:
+
+- :class:`engine.events.BeginningOfMainPhaseTriggeredEvent` (from sos_57) for
+  the per-main-phase timing.
+- :meth:`engine.triggers.TriggerManager.register` for a *recurring* trigger
+  (``register_delayed`` is one-shot; paradigm needs to fire every first main
+  phase, so we register a normal, non-one-shot trigger here).
+- :func:`engine.casting.cast_spell_free` (with :class:`~engine.types.Zone.EXILE`)
+  to cast the exiled copy for free.
+
+Public API
+----------
+- :func:`mark_paradigm_resolved` / :func:`has_paradigm_resolved` — the
+  per-game, per-(player, name) first-resolution registry.
+- :func:`register_paradigm` — wire the recurring per-main-phase free-copy
+  ability for a given paradigm spell name + controller (idempotent per
+  controller+name).  Marks the first resolution as a side effect.
+- :func:`offer_paradigm_copy` — create a fresh copy of the paradigm spell in
+  the controller's exile and let the controller optionally cast it for free.
+  This is the effect the recurring trigger runs each first main phase.
+
+"Paradigm" is a *printed keyword label*, not an evergreen keyword, so no member
+is added to :class:`engine.types.Keyword` (keeping that enum unchanged /
+additive-safe).
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any, Callable
+
+from engine.events import BeginningOfMainPhaseTriggeredEvent
+from engine.types import CardType, Zone
+
+if TYPE_CHECKING:
+    from engine.game_state import GameState
+    from engine.player import Player
+
+
+# ---------------------------------------------------------------------------
+# Per-game first-resolution registry  (player, name) -> resolved?
+# ---------------------------------------------------------------------------
+
+
+def _resolved_registry(game: GameState) -> set[tuple[int, str]]:
+    """Return (creating if necessary) the per-game first-resolution registry.
+
+    The registry is a set of ``(id(player), name)`` keys recording that a
+    spell with that name has *first resolved* under that player's control this
+    game.  Stored lazily on the game object so no change to
+    ``GameState.__init__`` is required.
+    """
+    registry = getattr(game, "_paradigm_resolved", None)
+    if registry is None:
+        registry = set()
+        game._paradigm_resolved = registry  # type: ignore[attr-defined]
+    return registry
+
+
+def has_paradigm_resolved(game: GameState, player: Any, name: str) -> bool:
+    """Return ``True`` if a spell named *name* has first resolved for *player*."""
+    if player is None:
+        return False
+    return (id(player), name) in _resolved_registry(game)
+
+
+def mark_paradigm_resolved(game: GameState, player: Any, name: str) -> bool:
+    """Record that a spell named *name* has resolved for *player*.
+
+    Returns ``True`` if this was the *first* resolution (the gate just opened),
+    ``False`` if a spell with that name had already resolved for the player
+    (the "after you *first* resolve" clause only opens the gate once).
+    """
+    if player is None:
+        return False
+    registry = _resolved_registry(game)
+    key = (id(player), name)
+    if key in registry:
+        return False
+    registry.add(key)
+    return True
+
+
+# ---------------------------------------------------------------------------
+# Per-game registry of active paradigm triggers  (player, name) -> True
+# ---------------------------------------------------------------------------
+
+
+def _registered_registry(game: GameState) -> set[tuple[int, str]]:
+    """Return (creating if necessary) the set of already-wired paradigm triggers.
+
+    Keyed by ``(id(controller), name)`` so the recurring trigger is registered
+    at most once per controller+name even if the paradigm spell resolves
+    multiple times.
+    """
+    registry = getattr(game, "_paradigm_registered", None)
+    if registry is None:
+        registry = set()
+        game._paradigm_registered = registry  # type: ignore[attr-defined]
+    return registry
+
+
+# ---------------------------------------------------------------------------
+# Offering the free copy each first main phase
+# ---------------------------------------------------------------------------
+
+
+def offer_paradigm_copy(
+    game: GameState,
+    controller: Any,
+    factory: Callable[[], Any],
+    name: str,
+) -> Any | None:
+    """Create a paradigm copy in *controller*'s exile and offer a free cast.
+
+    Implements the per-main-phase body of paradigm: a fresh copy of the
+    paradigm spell (produced by *factory*) is created in the controller's
+    exile zone, then the controller is asked whether they want to cast it for
+    free.  On *yes* the copy is cast from exile via
+    :func:`engine.casting.cast_spell_free`; on *no* (or a cast failure) the
+    copy is left in exile.
+
+    Returns the copy that was created (whether or not it was cast), or ``None``
+    if no copy could be produced.
+    """
+    if controller is None or factory is None:
+        return None
+
+    copy = factory()
+    if copy is None:
+        return None
+    copy.owner = controller
+    copy.controller = controller
+    copy.is_paradigm_copy = True
+
+    exile = controller.zones[Zone.EXILE]
+    exile.add(copy)
+
+    # "you may cast" — optional.
+    wants_to_cast = False
+    chooser = getattr(controller, "choose_yes_no", None)
+    if callable(chooser):
+        try:
+            wants_to_cast = bool(
+                chooser(
+                    f"Cast a copy of {name} from exile without paying its "
+                    "mana cost?"
+                )
+            )
+        except Exception:
+            wants_to_cast = False
+
+    if not wants_to_cast:
+        return copy
+
+    from engine.casting import cast_spell_free
+
+    try:
+        cast_spell_free(game, controller, copy, Zone.EXILE)
+    except Exception:
+        # Cast failed (e.g. illegal target) — leave the copy in exile.
+        if not exile.contains(copy):
+            exile.add(copy)
+    return copy
+
+
+# ---------------------------------------------------------------------------
+# Wiring the recurring delayed ability
+# ---------------------------------------------------------------------------
+
+
+def register_paradigm(
+    game: GameState,
+    source: Any,
+    controller: Any,
+    factory: Callable[[], Any],
+    name: str,
+) -> None:
+    """Wire paradigm's recurring per-main-phase free-copy ability.
+
+    Called when a paradigm spell (named *name*, controlled by *controller*)
+    resolves.  It:
+
+    1. Marks the first resolution in the per-game registry (the "after you
+       first resolve a spell with this name" gate).  If a spell with this name
+       has already resolved for *controller* the gate is already open.
+    2. Registers — at most once per ``(controller, name)`` — a *recurring*
+       trigger on :class:`~engine.events.BeginningOfMainPhaseTriggeredEvent`
+       that, at the beginning of each of *controller*'s pre-combat ("first")
+       main phases, runs :func:`offer_paradigm_copy` to create a free copy in
+       exile and offer to cast it.
+
+    Unlike :meth:`engine.triggers.TriggerManager.register_delayed` (one-shot),
+    this uses :meth:`~engine.triggers.TriggerManager.register` so the ability
+    fires every qualifying main phase, matching "each of your first main
+    phases".
+    """
+    from engine.triggers import TriggerRegistration
+
+    mark_paradigm_resolved(game, controller, name)
+
+    if controller is None or factory is None:
+        return
+
+    registered = _registered_registry(game)
+    key = (id(controller), name)
+    if key in registered:
+        return
+    registered.add(key)
+
+    def _condition(g: GameState, event: BeginningOfMainPhaseTriggeredEvent) -> bool:
+        # "your first main phases" — only the controller's pre-combat main, and
+        # only once the first-resolution gate is open.
+        if getattr(event, "player", None) is not controller:
+            return False
+        if not getattr(event, "precombat", False):
+            return False
+        return has_paradigm_resolved(g, controller, name)
+
+    def _effect(g: GameState) -> None:
+        offer_paradigm_copy(g, controller, factory, name)
+
+    game.trigger_manager.register(
+        TriggerRegistration(
+            event_type=BeginningOfMainPhaseTriggeredEvent,
+            condition=_condition,
+            effect=_effect,
+            source=source,
+            controller=controller,
+        )
+    )
+
+
+def is_paradigm_copy(card: Any) -> bool:
+    """Return ``True`` if *card* is a paradigm copy created by this framework."""
+    return bool(getattr(card, "is_paradigm_copy", False))
+
+
+def is_castable_spell(card: Any) -> bool:
+    """Return ``True`` if *card* is a spell that can be cast (not a land).
+
+    Lands are not spells (CR 601.1) and cannot be cast for free by paradigm's
+    "cast any number of spells" clause; this helper centralises that check.
+    """
+    card_types = getattr(card, "card_types", set())
+    return CardType.LAND not in card_types
diff -ruN a/player.py b/player.py
--- a/player.py	2026-05-25 16:43:11.729292098 +0000
+++ b/player.py	2026-06-02 08:39:35.511344791 +0000
@@ -35,6 +35,11 @@
         self.has_lost: bool = False
         self.land_plays_remaining: int = 1
         self.drawn_from_empty_library: bool = False
+        # Number of upcoming turns this player must skip (CR 720.5).  Consumed
