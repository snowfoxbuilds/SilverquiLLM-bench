+++ b/casualty.py	2026-06-02 09:33:41.901766044 +0000
@@ -0,0 +1,476 @@
+"""Casualty-keyword framework (Comprehensive Rules 702.153).
+
+*Casualty* is a static ability linked to a triggered ability:
+
+    Casualty N (As an additional cost to cast this spell, you may sacrifice a
+    creature with power N or greater.  When you cast this spell, if a casualty
+    cost was paid for it, copy it.  If the spell has any targets, you may choose
+    new targets for the copy.)
+
+A card normally carries casualty as a printed ability, but Silverquill, the
+Disputant *grants* casualty 1 to every instant and sorcery **spell** its
+controller casts.  The engine had no support for the mechanic, so this module
+adds it *additively* — no existing engine symbol is renamed, moved, or deleted.
+It mirrors :mod:`engine.miracle` / :mod:`engine.preparation` / :mod:`engine.paradigm`.
+
+The mechanic has three observable parts:
+
+1. **The grant surface.**  A *granted casualty value* is recorded on the affected
+   spell (an ``int`` written to ``spell.casualty``) and is also queryable via
+   :func:`get_casualty_value`.  A continuous-grant source (Silverquill) installs /
+   refreshes the grant via :func:`grant_casualty_to_hand`, which only ever writes
+   the value onto instants/sorceries in *its controller's* hand and clears stale
+   grants from cards that have left the hand.
+
+2. **The optional additional cost — sacrifice a creature with power >= N
+   (CR 702.153a).**  :func:`legal_casualty_sacrifices` exposes the set of legal
+   sacrifice candidates (creatures the caster controls whose power is >= N), so
+   the power boundary is observable (power 0 illegal, power 1 legal).
+   :func:`pay_casualty` performs the payment: it validates the chosen creature's
+   power, sacrifices it, and records the payment on the spell
+   (``spell.casualty_paid = True``).
+
+3. **Copy-on-payment (CR 702.153c).**  When the casualty cost is paid, the spell
+   is copied onto the stack under the controller's control, with the option to
+   choose new targets for the copy.  This reuses the existing engine spell-copy
+   primitive :func:`engine.stack.copy_spell` (no new copy primitive is added).
+
+"Casualty" is a *printed keyword label*, not an evergreen keyword, so no member
+is added to :class:`engine.types.Keyword` (that enum is frozen at 16 members).
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any
+
+from engine.types import CardType, Zone
+
+if TYPE_CHECKING:
+    from engine.game_state import GameState
+    from engine.player import Player
+
+
+#: Default casualty value granted by Silverquill, the Disputant (casualty 1).
+CASUALTY_ONE: int = 1
+
+
+# ---------------------------------------------------------------------------
+# Grant surface — read / write the granted casualty value on a spell
+# ---------------------------------------------------------------------------
+
+
+def is_instant_or_sorcery(card: Any) -> bool:
+    """Return ``True`` if *card* is an instant or sorcery (the granted types)."""
+    card_types = getattr(card, "card_types", set())
+    return CardType.INSTANT in card_types or CardType.SORCERY in card_types
+
+
+def get_casualty_value(card: Any) -> int | None:
+    """Return the granted casualty value on *card*, or ``None`` if none.
+
+    The grant is stored on the card as an ``int`` under ``card.casualty`` (the
+    queryable grant surface).  Returns ``None`` when the card carries no granted
+    casualty value.
+    """
+    return getattr(card, "casualty", None)
+
+
+def set_casualty_value(card: Any, value: int | None) -> None:
+    """Write (or clear) the granted casualty value on *card*.
+
+    Passing ``None`` clears the grant (removes the ``casualty`` attribute so a
+    stale grant never lingers on a card that has left the granting zone).
+    """
+    if value is None:
+        if hasattr(card, "casualty"):
+            try:
+                delattr(card, "casualty")
+            except AttributeError:
+                card.casualty = None  # type: ignore[attr-defined]
+        # Also drop the source back-link so the card is fully de-granted.
+        if hasattr(card, "_casualty_grant_source"):
+            try:
+                delattr(card, "_casualty_grant_source")
+            except AttributeError:
+                pass
+        return
+    card.casualty = value  # type: ignore[attr-defined]
+
+
+def has_casualty(card: Any) -> bool:
+    """Return ``True`` if *card* currently carries a granted casualty value."""
+    return get_casualty_value(card) is not None
+
+
+# ---------------------------------------------------------------------------
+# Per-game registry of cards a given source has granted casualty to
+# ---------------------------------------------------------------------------
+
+
+def _granted_registry(game: GameState) -> dict[int, set[int]]:
+    """Return (creating if necessary) the per-game casualty-grant registry.
+
+    Maps ``id(source)`` to the set of ``id(card)`` it last granted casualty to,
+    so a refresh can clear grants from cards that have since left the granting
+    zone.  Stored lazily on the game object — no ``GameState.__init__`` change.
+    """
+    registry = getattr(game, "_casualty_grants", None)
+    if registry is None:
+        registry = {}
+        game._casualty_grants = registry  # type: ignore[attr-defined]
+    return registry
+
+
+# ---------------------------------------------------------------------------
+# The continuous grant — "each instant/sorcery you cast has casualty {N}"
+# ---------------------------------------------------------------------------
+
+
+def grant_casualty_to_hand(
+    game: GameState,
+    source: Any,
+    controller: Any,
+    value: int = CASUALTY_ONE,
+) -> list[Any]:
+    """Grant casualty *value* to every instant/sorcery in *controller*'s hand.
+
+    This is the body of Silverquill's continuous static ability: while the
+    source is on the battlefield, every instant and sorcery spell its controller
+    casts "has casualty 1".  The casting/casualty pipeline observes the grant on
+    the spell object regardless of zone; with no live cast pipeline the
+    controller's-hand instants/sorceries are the natural observable proxy (the
+    same proxy :mod:`engine.miracle` uses).  The grant is written onto each such
+    card (``card.casualty``) and is queryable via :func:`get_casualty_value`.
+
+    The grant is *scoped*:
+
+    * only instants and sorceries are affected (creatures, lands, etc. are not);
+    * only cards in *controller*'s hand are affected (an opponent's hand is left
+      untouched).
+
+    Calling this again refreshes the grant: cards that have left the controller's
+    hand since the last refresh have their (this-source) grant cleared so a stale
+    casualty value never lingers.  Returns the list of hand cards now carrying the
+    grant.
+    """
+    if controller is None:
+        return []
+
+    registry = _granted_registry(game)
+    previously = registry.get(id(source), set())
+
+    hand = controller.zones[Zone.HAND]
+    granted: list[Any] = []
+    now_ids: set[int] = set()
+
+    for card in hand.get_all():
+        if not is_instant_or_sorcery(card):
+            continue
+        set_casualty_value(card, value)
+        card._casualty_grant_source = source  # type: ignore[attr-defined]
+        granted.append(card)
+        now_ids.add(id(card))
+
+    # Clear grants this source placed on cards that are no longer in the hand
+    # (or are no longer instants/sorceries).
+    stale = previously - now_ids
+    if stale:
+        _clear_grants_for_ids(game, source, stale)
+
+    registry[id(source)] = now_ids
+    return granted
+
+
+def _clear_grants_for_ids(game: GameState, source: Any, card_ids: set[int]) -> None:
+    """Clear *source*'s casualty grant from any card in *card_ids* across zones."""
+    for player in game.players:
+        for zone in Zone:
+            container = player.zones[zone]
+            for card in list(container.get_all()):
+                if (
+                    id(card) in card_ids
+                    and getattr(card, "_casualty_grant_source", None) is source
+                ):
+                    set_casualty_value(card, None)
+
+
+def clear_casualty_grants(game: GameState, source: Any) -> None:
+    """Clear every casualty grant *source* placed (e.g. when it leaves play)."""
+    registry = _granted_registry(game)
+    granted = registry.pop(id(source), set())
+    if not granted:
+        return
+    _clear_grants_for_ids(game, source, granted)
+
+
+# ---------------------------------------------------------------------------
+# Optional additional cost — sacrifice a creature with power >= N (702.153a)
+# ---------------------------------------------------------------------------
+
+
+def is_legal_casualty_sacrifice(creature: Any, value: int) -> bool:
+    """Return ``True`` if *creature* may be sacrificed for casualty *value*.
+
+    A legal casualty sacrifice for casualty N is a creature with power N or
+    greater (CR 702.153a).  For casualty 1 a power-0 creature is illegal and a
+    power-1 (or greater) creature is legal.
+    """
+    if creature is None:
+        return False
+    card_types = getattr(creature, "card_types", set())
+    if CardType.CREATURE not in card_types:
+        return False
+    power = getattr(creature, "power", None)
+    if power is None:
+        power = getattr(creature, "base_power", 0)
+    return power >= value
+
+
+def legal_casualty_sacrifices(
+    game: GameState,
+    player: Any,
+    value: int,
+) -> list[Any]:
+    """Return the creatures *player* controls that are legal casualty sacrifices.
+
+    These are the creatures on *player*'s battlefield whose power is >= *value*
+    (CR 702.153a).  Exposing this set makes the power boundary observable: for
+    casualty 1, a power-0 creature is excluded and a power-1 (or greater)
+    creature is included.
+    """
+    if player is None:
+        return []
+    battlefield = game.get_battlefield(player)
+    return [
+        creature
+        for creature in battlefield.get_all()
+        if is_legal_casualty_sacrifice(creature, value)
+    ]
+
+
+def mark_casualty_paid(spell: Any) -> None:
+    """Record that a casualty cost was paid for *spell* (``spell.casualty_paid``)."""
+    spell.casualty_paid = True  # type: ignore[attr-defined]
+
+
+def was_casualty_paid(spell: Any) -> bool:
+    """Return ``True`` if a casualty cost was recorded as paid for *spell*."""
+    return bool(getattr(spell, "casualty_paid", False))
+
+
+def pay_casualty(
+    game: GameState,
+    player: Any,
+    spell: Any,
+    creature: Any,
+    value: int | None = None,
+) -> bool:
+    """Pay *spell*'s casualty cost by sacrificing *creature* (CR 702.153a).
+
+    Validates that *creature* is a legal casualty sacrifice (a creature *player*
+    controls with power >= the casualty value), sacrifices it to its owner's
+    graveyard, and records the payment on the spell (``spell.casualty_paid =
+    True``).
+
+    The casualty value defaults to the value granted to *spell* (via
+    :func:`get_casualty_value`), falling back to :data:`CASUALTY_ONE` if the
+    spell carries no recorded grant.
+
+    Returns ``True`` if the cost was paid, ``False`` if the chosen creature is
+    not a legal sacrifice (power below the threshold, not a creature, or not
+    controlled by *player*) — in which case nothing is sacrificed and no payment
+    is recorded.
+
+    NOTE: paying the casualty cost does **not** itself produce the copy — the
+    copy is the casualty *triggered* ability (CR 702.153c).  Call
+    :func:`copy_spell_on_casualty` (or :func:`offer_casualty`, which wires both)
+    to produce the copy once the spell is on the stack.
+    """
+    from engine.game import sacrifice
+
+    if value is None:
+        value = get_casualty_value(spell)
+        if value is None:
+            value = CASUALTY_ONE
+
+    # The creature must be a legal sacrifice AND under the player's control.
+    if not is_legal_casualty_sacrifice(creature, value):
+        return False
+    if not game.get_battlefield(player).contains(creature):
+        return False
+
+    sacrifice(game, player, creature)
+    mark_casualty_paid(spell)
+    return True
+
+
+# ---------------------------------------------------------------------------
+# Copy-on-payment (CR 702.153c)
+# ---------------------------------------------------------------------------
+
+
+def _find_stack_object(game: GameState, spell: Any) -> Any | None:
+    """Return the :class:`~engine.stack.StackObject` whose source is *spell*."""
+    for stack_obj in game.stack._items:
+        if stack_obj.source is spell:
+            return stack_obj
+    return None
+
+
+def copy_spell_on_casualty(
+    game: GameState,
+    player: Any,
+    spell: Any,
+    new_targets: list[Any] | None = None,
+) -> Any | None:
+    """Copy *spell* onto the stack under *player*'s control (CR 702.153c).
+
+    Implements the casualty triggered ability: "When you cast this spell, if a
+    casualty cost was paid for it, copy it.  If the spell has any targets, you
+    may choose new targets for the copy."  *spell* must be on the stack.  Reuses
+    the engine spell-copy primitive :func:`engine.stack.copy_spell`, so the copy
+    shares the original's identity but has independent state and (optionally) new
+    targets.  The copy is pushed onto the stack and returned so callers/tests can
+    observe it.
+
+    Returns the copy's :class:`~engine.stack.StackObject`, or ``None`` if the
+    original spell is not on the stack.
+    """
+    from engine.stack import copy_spell
+
+    original = _find_stack_object(game, spell)
+    if original is None:
+        return None
+
+    copy_obj = copy_spell(game, original, player, new_targets)
+    game.stack.push(copy_obj)
+    return copy_obj
+
+
+def offer_casualty(
+    game: GameState,
+    player: Any,
+    spell: Any,
+    value: int | None = None,
+) -> Any | None:
+    """Offer *player* the option to pay *spell*'s casualty cost and copy it.
+
+    This wires the whole optional mechanic (CR 702.153a/c) around a spell that is
+    already on the stack:
+
+    1. Compute the legal sacrifice candidates (creatures with power >= the
+       casualty value).  With none available, the offer cannot be paid.
+    2. Ask the player whether they want to pay the casualty cost.
+    3. On *yes*, ask which creature to sacrifice, validate and pay via
+       :func:`pay_casualty` (recording ``spell.casualty_paid``), then copy the
+       spell onto the stack via :func:`copy_spell_on_casualty`, offering new
+       targets for the copy if the spell had any.
+
+    Returns the copy's :class:`~engine.stack.StackObject` if the casualty cost
+    was paid and the copy produced, otherwise ``None`` (declined, no legal
+    sacrifice, or the spell left the stack).
+    """
+    if value is None:
+        value = get_casualty_value(spell)
+        if value is None:
+            value = CASUALTY_ONE
+
+    candidates = legal_casualty_sacrifices(game, player, value)
+    if not candidates:
+        return None
+
+    chooser = getattr(player, "choose_yes_no", None)
+    if not callable(chooser):
+        return None
+    try:
+        wants = bool(
+            chooser(
+                f"Pay casualty {value} for "
+                f"{getattr(spell, 'name', 'this spell')} "
+                f"(sacrifice a creature with power {value} or greater)?"
+            )
+        )
+    except Exception:
+        return None
+    if not wants:
+        return None
+
+    # Choose which creature to sacrifice.
+    picker = getattr(player, "choose_card", None)
