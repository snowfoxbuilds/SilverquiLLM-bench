+    seedable RNG (see :func:`get_rng` / :func:`seed_rng`).
+
+    Parameters:
+        game: The current game state.
+
+    Returns:
+        ``True`` if the coin came up heads, ``False`` if tails.
+    """
+    return get_rng(game).random() < 0.5
+
+
+def flip_coins(game: GameState, n: int) -> int:
+    """Flip *n* fair coins and return the number that came up heads (CR 705).
+
+    Backed by the game's seedable RNG so tests can force a known result:
+    seed via :func:`seed_rng`, then assert the returned head count.  With
+    no seed the flips are fair and independent.
