+++ b/preparation.py	2026-06-02 08:14:33.310658999 +0000
@@ -0,0 +1,248 @@
+"""Preparation-card framework (Comprehensive Rules 722).
+
+A *preparation card* (CR 722) is a permanent that, in addition to its normal
+characteristics, carries an alternative "prepare spell" half.  The card can
+"become prepared"; when it does, its controller creates a castable copy of the
+prepare spell in exile that they may cast, and casting that copy "unprepares"
+the source permanent (CR 722.3a–c).
+
+The engine had no support for this mechanic, so this module adds it
+*additively* — no existing engine symbol is renamed, moved, or deleted:
+
+- :func:`mark_prepared` — give a permanent the ``prepared`` designation and
+  create a copy of its prepare spell in the controller's exile (722.3c).
+- :func:`unprepare` — clear the designation and remove the exiled copy
+  (722.3b; the copy only lasts while the permanent stays prepared, 722.3c).
+- :func:`is_prepared` — read the designation off a permanent.
+- :func:`get_prepared_copy` — fetch the exiled prepare-spell copy keyed to a
+  prepared permanent.
+- :func:`get_prepared_source` — reverse lookup: the permanent a given exiled
+  copy was created for.
+- :func:`cast_prepared_copy` — cast an exiled prepare-spell copy from exile
+  (via :func:`engine.casting.cast_spell_free`); the cast unprepares the source
+  (722.3c — "loses the prepared designation at the time the spell becomes
+  cast").
+
+A permanent advertises a prepare spell by exposing a ``make_prepare_spell()``
+factory (returning a fresh :class:`~engine.card.CardImpl` for the {W} instant,
+etc.).  The framework calls that factory to materialise the copy.
+
+The prepared designation is stored on the permanent both as ``is_prepared`` and
+``prepared`` boolean attributes (so probes against either spelling work), and
+the permanent⇄copy bookkeeping lives in a per-game registry attached lazily to
+the game object (no ``GameState.__init__`` change required).  "Prepared" is a
+*designation*, not an evergreen keyword, so no member is added to
+``engine.types.Keyword`` (keeping that enum unchanged / additive-safe).
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any
+
+from engine.types import Zone
+
+if TYPE_CHECKING:
+    from engine.card import CardImpl
+    from engine.game_state import GameState
+    from engine.player import Player
+
+
+# ---------------------------------------------------------------------------
+# Per-game registry of prepared permanents ⇄ their exiled prepare-spell copies
+# ---------------------------------------------------------------------------
+
+
+def _prepare_registry(game: GameState) -> dict[int, Any]:
+    """Return (creating if necessary) the per-game preparation registry.
+
+    The registry maps ``id(permanent)`` to the exiled prepare-spell copy that
+    was created for it (CR 722.3c).  Stored lazily on the game object so no
+    change to ``GameState.__init__`` is required.
+    """
+    registry = getattr(game, "_prepared_copies", None)
+    if registry is None:
+        registry = {}
+        game._prepared_copies = registry  # type: ignore[attr-defined]
+    return registry
+
+
+# ---------------------------------------------------------------------------
+# Designation read / write
+# ---------------------------------------------------------------------------
+
+
+def is_prepared(permanent: Any) -> bool:
+    """Return ``True`` if *permanent* currently has the prepared designation."""
+    val = getattr(permanent, "is_prepared", None)
+    if isinstance(val, bool):
+        return val
+    val = getattr(permanent, "prepared", None)
+    if isinstance(val, bool):
+        return val
+    return False
+
+
+def _set_designation(permanent: Any, value: bool) -> None:
+    """Write the prepared designation under both common attribute spellings."""
+    permanent.is_prepared = value
+    permanent.prepared = value
+
+
+# ---------------------------------------------------------------------------
+# Becoming prepared (722.3a, 722.3c)
+# ---------------------------------------------------------------------------
+
+
+def mark_prepared(game: GameState, permanent: Any) -> Any | None:
+    """Give *permanent* the prepared designation and create the exiled copy.
+
+    Implements CR 722.3a (gaining the designation) and 722.3c (creating a
+    copy of the prepare spell in the controller's exile zone).  The copy is a
+    fresh object produced by the permanent's ``make_prepare_spell()`` factory;
+    it is owned/controlled by the prepared permanent's controller and lives in
+    that controller's exile zone, keyed to the source permanent.
+
+    A permanent that already has the designation is left unchanged (722.3a — a
+    permanent can't gain the designation if it already has it).
+
+    Returns:
+        The exiled prepare-spell copy, or ``None`` if the permanent has no
+        prepare-spell factory / no controller.
+    """
+    if is_prepared(permanent):
+        return get_prepared_copy(game, permanent)
+
+    factory = getattr(permanent, "make_prepare_spell", None)
+    if factory is None:
+        return None
+    controller = getattr(permanent, "controller", None)
+    if controller is None:
+        return None
+
+    _set_designation(permanent, True)
+
+    copy = factory()
+    if copy is None:
+        return None
+    copy.owner = controller
+    copy.controller = controller
+    # Mark the copy as a prepare-spell copy and back-link it to its source so
+    # casting it can find and unprepare the source permanent (722.3c).
+    copy.is_prepare_copy = True
+    copy.prepare_source = permanent
+
+    exile = controller.zones[Zone.EXILE]
+    exile.add(copy)
+    _prepare_registry(game)[id(permanent)] = copy
+    return copy
+
+
+# ---------------------------------------------------------------------------
+# Becoming unprepared (722.3b, 722.3c)
+# ---------------------------------------------------------------------------
+
+
+def unprepare(game: GameState, permanent: Any) -> None:
+    """Clear the prepared designation from *permanent* and drop its copy.
+
+    Implements CR 722.3b (removing the designation).  Per 722.3c the exiled
+    copy only persists while the permanent stays prepared, so the copy is
+    removed from exile here (if it is still there).
+    """
+    _set_designation(permanent, False)
+    copy = _prepare_registry(game).pop(id(permanent), None)
+    if copy is None:
+        return
+    controller = getattr(copy, "controller", None) or getattr(permanent, "controller", None)
+    if controller is not None:
+        exile = controller.zones[Zone.EXILE]
+        if exile.contains(copy):
+            exile.remove(copy)
+
+
+# ---------------------------------------------------------------------------
+# Lookups
+# ---------------------------------------------------------------------------
+
+
+def get_prepared_copy(game: GameState, permanent: Any) -> Any | None:
+    """Return the exiled prepare-spell copy keyed to *permanent* (or ``None``)."""
+    return _prepare_registry(game).get(id(permanent))
+
+
+def get_prepared_source(game: GameState, copy: Any) -> Any | None:
+    """Return the prepared permanent a given exiled *copy* was created for.
+
+    Resolution relies on the ``prepare_source`` back-link the framework sets on
+    every copy it materialises (:func:`mark_prepared`).  ``id(...)`` keys in the
+    registry cannot be reversed to an object, so there is no further fallback.
+    """
+    return getattr(copy, "prepare_source", None)
+
+
+def _registry_key_for_copy(game: GameState, copy: Any) -> int | None:
+    """Reverse-scan the per-game registry for the key whose value is *copy*.
+
+    Used to detach a copy from the registry when its ``prepare_source``
+    back-link is missing (e.g. an externally-supplied copy).  Returns the
+    matching ``id(permanent)`` key, or ``None`` if the copy is not registered.
+    """
+    for source_id, registered in _prepare_registry(game).items():
+        if registered is copy:
+            return source_id
+    return None
+
+
+# ---------------------------------------------------------------------------
+# Casting the exiled copy (722.3c — unprepare on cast)
+# ---------------------------------------------------------------------------
+
+
+def cast_prepared_copy(game: GameState, player: Player, copy: Any) -> None:
+    """Cast an exiled prepare-spell *copy* from exile, unpreparing its source.
+
+    Uses :func:`engine.casting.cast_spell_free` to put the copy on the stack
+    from the exile zone (the prepare half is cast for its own {W} cost in
+    paper Magic; the engine's free-cast path is the closest existing plumbing
+    and keeps this additive).
+
+    Per CR 722.3c the source permanent loses the prepared designation **at the
+    time the spell becomes cast** — i.e. only when the cast actually succeeds.
+    :func:`engine.casting.cast_spell_free` can raise
+    :class:`~engine.casting.CastingError` (e.g. no legal target, or the target
+    has protection) and roll the copy back into exile.  So the order here is:
+    cast the copy *first*; only after the cast returns without error do we clear
+    the source's designation and detach the registry entry.  On a cast failure
+    the source stays prepared and the copy stays in exile (the error
+    propagates), matching the rules.
+
+    ``cast_spell_free`` already moves the copy from exile onto the stack, so we
+    must **not** also remove it from exile here — we only pop the registry entry
+    (a dict key), never re-touch the in-flight copy, avoiding any double-removal.
+
+    Raises:
+        engine.casting.CastingError: If the copy cannot be cast.  In that case
+            the source remains prepared and the copy remains in exile.
+    """
+    from engine.casting import cast_spell_free
+
+    source = get_prepared_source(game, copy)
+
+    # Cast first.  If this raises (CastingError), the copy is rolled back into
+    # exile by cast_spell_free and the source is left untouched (still prepared)
+    # because the error propagates before we clear anything below.
+    cast_spell_free(game, player, copy, Zone.EXILE)
+
+    # The spell has now "become cast" (722.3c): clear the source's designation
+    # and detach the registry entry.  We only pop the registry key here; the
+    # copy itself already left exile as part of the cast, so it is not removed
+    # again (no double-removal of the in-flight copy).
+    if source is not None:
+        _set_designation(source, False)
+        _prepare_registry(game).pop(id(source), None)
+    else:
+        # Externally-supplied copy with no prepare_source back-link: still
+        # detach any matching registry entry so the source unprepares.
+        key = _registry_key_for_copy(game, copy)
+        if key is not None:
+            _prepare_registry(game).pop(key, None)
