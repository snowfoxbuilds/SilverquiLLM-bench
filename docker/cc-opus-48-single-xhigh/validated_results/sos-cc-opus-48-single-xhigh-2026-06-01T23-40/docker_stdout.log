{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ns1Cy2SpTHWEZ8Qkv3smwd","type":"tool_result","content":"1\t\"\"\"Tests for SOS 97 — Ral Zarek, Guest Lecturer.\n2\t\n3\tRal Zarek, Guest Lecturer is a Legendary Planeswalker — Ral, {1}{B}{B},\n4\tstarting loyalty 3, with four loyalty abilities:\n5\t\n6\t    +1: Surveil 2.\n7\t    −1: Any number of target players each discard a card.\n8\t    −2: Return target creature card with mana value 3 or less from your\n9\t        graveyard to the battlefield.\n10\t    −7: Flip five coins. Target opponent skips their next X turns, where X\n11\t        is the number of coins that came up heads.\n12\t\n13\tThe engine's planeswalker contract (see ``cards/fdn/fdn_44`` / ``fdn_234``):\n14\t``get_loyalty_abilities()`` returns a list of ``LoyaltyAbility`` objects whose\n15\t``effect`` closures read ``pw.controller`` and, for targeted abilities, a\n16\t``pw._resolve_target`` (single) / ``pw._resolve_targets`` (list) attribute that\n17\ttest code sets directly. These tests exercise each ability's ``effect`` in\n18\tisolation by setting those attributes and calling ``effect(game)``.\n19\t\n20\tMechanics that the engine has no native support for (surveil decisions, coin\n21\tflips, skip-turn replacement) are exercised against the most conventional\n22\tsurface for this codebase; the truly engine-blocked pieces (exact coin-flip X\n23\tand enforced turn-skipping) are recorded in ``untestable.json``.\n24\t\"\"\"\n25\t\n26\tfrom __future__ import annotations\n27\t\n28\tfrom cards.sos.sos_97.card_impl import RalZarekGuestLecturer\n29\tfrom engine.card import Creature, LoyaltyAbility, Planeswalker\n30\tfrom engine.types import CardType, ManaCost, Supertype, Zone\n31\tfrom test_utils import create_game, set_board_state\n32\t\n33\t\n34\t# ---------------------------------------------------------------------------\n35\t# Helpers\n36\t# ---------------------------------------------------------------------------\n37\t\n38\tdef _make_creature_card(name: str, mv: int, owner=None):\n39\t    \"\"\"A creature *card* (not yet a permanent) with mana value ``mv``.\n40\t\n41\t    Mana value is encoded entirely as generic mana so ``mana_cost.cmc == mv``.\n42\t    \"\"\"\n43\t    card = Creature(\n44\t        name=name,\n45\t        base_power=1,\n46\t        base_toughness=1,\n47\t        mana_cost=ManaCost.parse(f\"{{{mv}}}\") if mv > 0 else ManaCost(),\n48\t        owner=owner,\n49\t        controller=owner,\n50\t    )\n51\t    card.card_types = {CardType.CREATURE}\n52\t    return card\n53\t\n54\t\n55\tdef _vanilla_library_card(name: str, owner=None):\n56\t    \"\"\"A plain card object usable as a library card for surveil tests.\"\"\"\n57\t    card = Creature(name=name, base_power=2, base_toughness=2, owner=owner, controller=owner)\n58\t    card.card_types = {CardType.CREATURE}\n59\t    return card\n60\t\n61\t\n62\tdef _ability_by_cost(pw, cost: int) -> LoyaltyAbility:\n63\t    \"\"\"Return the single loyalty ability whose ``loyalty_cost`` equals *cost*.\"\"\"\n64\t    matches = [a for a in pw.get_loyalty_abilities() if a.loyalty_cost == cost]\n65\t    assert len(matches) == 1, f\"expected exactly one ability with cost {cost}\"\n66\t    return matches[0]\n67\t\n68\t\n69\t# ---------------------------------------------------------------------------\n70\t# Static card properties\n71\t# ---------------------------------------------------------------------------\n72\t\n73\tclass TestRalZarekProperties:\n74\t    \"\"\"Static card data should match the SOS 97 spec.\"\"\"\n75\t\n76\t    def test_is_planeswalker(self) -> None:\n77\t        assert isinstance(RalZarekGuestLecturer(owner=None), Planeswalker)\n78\t\n79\t    def test_card_type_is_planeswalker(self) -> None:\n80\t        card = RalZarekGuestLecturer(owner=None)\n81\t        assert CardType.PLANESWALKER in card.card_types\n82\t\n83\t    def test_name(self) -> None:\n84\t        assert RalZarekGuestLecturer(owner=None).name == \"Ral Zarek, Guest Lecturer\"\n85\t\n86\t    def test_mana_cost(self) -> None:\n87\t        card = RalZarekGuestLecturer(owner=None)\n88\t        assert card.mana_cost == ManaCost.parse(\"{1}{B}{B}\")\n89\t\n90\t    def test_is_legendary(self) -> None:\n91\t        card = RalZarekGuestLecturer(owner=None)\n92\t        assert Supertype.LEGENDARY in card.supertypes\n93\t\n94\t    def test_has_ral_subtype(self) -> None:\n95\t        card = RalZarekGuestLecturer(owner=None)\n96\t        assert \"Ral\" in card.subtypes\n97\t\n98\t    def test_starting_loyalty_is_three(self) -> None:\n99\t        card = RalZarekGuestLecturer(owner=None)\n100\t        assert card.starting_loyalty == 3\n101\t\n102\t    def test_current_loyalty_initialised_to_three(self) -> None:\n103\t        card = RalZarekGuestLecturer(owner=None)\n104\t        assert card.loyalty == 3\n105\t\n106\t\n107\t# ---------------------------------------------------------------------------\n108\t# Loyalty ability declaration\n109\t# ---------------------------------------------------------------------------\n110\t\n111\tclass TestRalZarekLoyaltyAbilityShape:\n112\t    \"\"\"get_loyalty_abilities() declares the four printed abilities.\"\"\"\n113\t\n114\t    def test_returns_four_abilities(self) -> None:\n115\t        abilities = RalZarekGuestLecturer(owner=None).get_loyalty_abilities()\n116\t        assert len(abilities) == 4\n117\t\n118\t    def test_all_are_loyalty_abilities(self) -> None:\n119\t        abilities = RalZarekGuestLecturer(owner=None).get_loyalty_abilities()\n120\t        for a in abilities:\n121\t            assert isinstance(a, LoyaltyAbility)\n122\t\n123\t    def test_loyalty_costs_match_printed_values(self) -> None:\n124\t        abilities = RalZarekGuestLecturer(owner=None).get_loyalty_abilities()\n125\t        costs = sorted(a.loyalty_cost for a in abilities)\n126\t        assert costs == [-7, -2, -1, 1]\n127\t\n128\t\n129\t# ---------------------------------------------------------------------------\n130\t# +1: Surveil 2\n131\t# ---------------------------------------------------------------------------\n132\t\n133\tclass TestRalZarekSurveil:\n134\t    \"\"\"+1 surveils 2: look at top two cards of the controller's library, put\n135\t    any number into the graveyard and the rest back on top.\n136\t\n137\t    The per-card keep/bin decision is taken via the controller's\n138\t    ``choose_yes_no`` (the codebase's standard \"you may\" decision channel).\n139\t    \"\"\"\n140\t\n141\t    def test_surveil_keeping_both_leaves_library_size_unchanged(self) -> None:\n142\t        game = create_game()\n143\t        p1 = game.players[0]\n144\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n145\t\n146\t        top = _vanilla_library_card(\"Top Card\", owner=p1)\n147\t        second = _vanilla_library_card(\"Second Card\", owner=p1)\n148\t        # Library bottom -> top: [filler, second, top]; top of library is last.\n149\t        filler = _vanilla_library_card(\"Filler\", owner=p1)\n150\t        lib = p1.zones[Zone.LIBRARY]\n151\t        for c in (filler, second, top):\n152\t            lib.add(c)\n153\t\n154\t        before_lib = len(lib)\n155\t        before_gy = len(p1.zones[Zone.GRAVEYARD])\n156\t\n157\t        # Decline to bin either of the surveilled cards.\n158\t        p1._script.extend([False, False])\n159\t        _ability_by_cost(pw, +1).effect(game)\n160\t\n161\t        assert len(lib) == before_lib\n162\t        assert len(p1.zones[Zone.GRAVEYARD]) == before_gy\n163\t\n164\t    def test_surveil_binning_both_moves_them_to_graveyard(self) -> None:\n165\t        game = create_game()\n166\t        p1 = game.players[0]\n167\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n168\t\n169\t        top = _vanilla_library_card(\"Top Card\", owner=p1)\n170\t        second = _vanilla_library_card(\"Second Card\", owner=p1)\n171\t        filler = _vanilla_library_card(\"Filler\", owner=p1)\n172\t        lib = p1.zones[Zone.LIBRARY]\n173\t        for c in (filler, second, top):\n174\t            lib.add(c)\n175\t\n176\t        # Bin both of the surveilled (top two) cards.\n177\t        p1._script.extend([True, True])\n178\t        _ability_by_cost(pw, +1).effect(game)\n179\t\n180\t        gy_objs = p1.zones[Zone.GRAVEYARD].get_all()\n181\t        assert top in gy_objs\n182\t        assert second in gy_objs\n183\t        # The filler underneath the top two is untouched.\n184\t        assert lib.contains(filler)\n185\t\n186\t    def test_surveil_never_moves_cards_to_hand(self) -> None:\n187\t        \"\"\"Surveil only touches library/graveyard — never hand.\"\"\"\n188\t        game = create_game()\n189\t        p1 = game.players[0]\n190\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n191\t\n192\t        for i in range(2):\n193\t            p1.zones[Zone.LIBRARY].add(_vanilla_library_card(f\"C{i}\", owner=p1))\n194\t\n195\t        before_hand = len(p1.zones[Zone.HAND])\n196\t        p1._script.extend([False, False])\n197\t        _ability_by_cost(pw, +1).effect(game)\n198\t        assert len(p1.zones[Zone.HAND]) == before_hand\n199\t\n200\t    def test_surveil_with_empty_library_is_a_safe_noop(self) -> None:\n201\t        game = create_game()\n202\t        p1 = game.players[0]\n203\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n204\t        # Empty library — surveil 2 must not raise.\n205\t        _ability_by_cost(pw, +1).effect(game)\n206\t        assert len(p1.zones[Zone.LIBRARY]) == 0\n207\t\n208\t\n209\t# ---------------------------------------------------------------------------\n210\t# −1: Any number of target players each discard a card\n211\t# ---------------------------------------------------------------------------\n212\t\n213\tclass TestRalZarekDiscard:\n214\t    \"\"\"−1 makes each targeted player discard a card.\"\"\"\n215\t\n216\t    def test_targeted_opponent_discards_a_card(self) -> None:\n217\t        game = create_game()\n218\t        p1, p2 = game.players\n219\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n220\t\n221\t        opp_card = _vanilla_library_card(\"Opp Hand Card\", owner=p2)\n222\t        set_board_state(game, 1, hand=[opp_card])\n223\t\n224\t        before = len(p2.zones[Zone.HAND])\n225\t        pw._resolve_targets = [p2]\n226\t        # If the implementation prompts which card to discard, give it the card.\n227\t        p2._script.appendleft(opp_card)\n228\t        _ability_by_cost(pw, -1).effect(game)\n229\t\n230\t        assert len(p2.zones[Zone.HAND]) == before - 1\n231\t        assert p2.zones[Zone.GRAVEYARD].contains(opp_card)\n232\t\n233\t    def test_both_targeted_players_each_discard(self) -> None:\n234\t        game = create_game()\n235\t        p1, p2 = game.players\n236\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n237\t\n238\t        c1 = _vanilla_library_card(\"P1 Hand Card\", owner=p1)\n239\t        c2 = _vanilla_library_card(\"P2 Hand Card\", owner=p2)\n240\t        set_board_state(game, 0, hand=[c1])\n241\t        set_board_state(game, 1, hand=[c2])\n242\t\n243\t        pw._resolve_targets = [p1, p2]\n244\t        p1._script.appendleft(c1)\n245\t        p2._script.appendleft(c2)\n246\t        _ability_by_cost(pw, -1).effect(game)\n247\t\n248\t        assert len(p1.zones[Zone.HAND]) == 0\n249\t        assert len(p2.zones[Zone.HAND]) == 0\n250\t\n251\t    def test_no_targets_chosen_is_a_noop(self) -> None:\n252\t        \"\"\"\"Any number\" permits zero targets — nobody discards.\"\"\"\n253\t        game = create_game()\n254\t        p1, p2 = game.players\n255\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n256\t\n257\t        c2 = _vanilla_library_card(\"P2 Hand Card\", owner=p2)\n258\t        set_board_state(game, 1, hand=[c2])\n259\t\n260\t        pw._resolve_targets = []\n261\t        _ability_by_cost(pw, -1).effect(game)\n262\t        # Untargeted player keeps their card.\n263\t        assert p2.zones[Zone.HAND].contains(c2)\n264\t\n265\t    def test_targeted_player_with_empty_hand_is_safe(self) -> None:\n266\t        game = create_game()\n267\t        p1, p2 = game.players\n268\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n269\t        set_board_state(game, 1, hand=[])\n270\t        pw._resolve_targets = [p2]\n271\t        # Must not raise even though the player has nothing to discard.\n272\t        _ability_by_cost(pw, -1).effect(game)\n273\t        assert len(p2.zones[Zone.GRAVEYARD]) == 0\n274\t\n275\t\n276\t# ---------------------------------------------------------------------------\n277\t# −2: Return target creature card with mana value 3 or less from your\n278\t#     graveyard to the battlefield\n279\t# ---------------------------------------------------------------------------\n280\t\n281\tclass TestRalZarekReanimate:\n282\t    \"\"\"−2 returns a low-mana-value creature card from the controller's own\n283\t    graveyard to the battlefield.\"\"\"\n284\t\n285\t    def test_returns_mv3_creature_to_battlefield(self) -> None:\n286\t        game = create_game()\n287\t        p1 = game.players[0]\n288\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n289\t\n290\t        target = _make_creature_card(\"Goblin\", mv=3, owner=p1)\n291\t        set_board_state(game, 0, graveyard=[target])\n292\t\n293\t        pw._resolve_target = target\n294\t        _ability_by_cost(pw, -2).effect(game)\n295\t\n296\t        assert game.get_battlefield(p1).contains(target)\n297\t        assert not p1.zones[Zone.GRAVEYARD].contains(target)\n298\t\n299\t    def test_zero_mana_value_creature_is_legal(self) -> None:\n300\t        game = create_game()\n301\t        p1 = game.players[0]\n302\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n303\t\n304\t        target = _make_creature_card(\"Ornithopter\", mv=0, owner=p1)\n305\t        set_board_state(game, 0, graveyard=[target])\n306\t\n307\t        pw._resolve_target = target\n308\t        _ability_by_cost(pw, -2).effect(game)\n309\t        assert game.get_battlefield(p1).contains(target)\n310\t\n311\t    def test_mana_value_four_creature_is_not_returned(self) -> None:\n312\t        \"\"\"Mana value 4 exceeds the \"3 or less\" filter — the effect must not\n313\t        move the card to the battlefield.\"\"\"\n314\t        game = create_game()\n315\t        p1 = game.players[0]\n316\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n317\t\n318\t        target = _make_creature_card(\"Big Beast\", mv=4, owner=p1)\n319\t        set_board_state(game, 0, graveyard=[target])\n320\t\n321\t        pw._resolve_target = target\n322\t        _ability_by_cost(pw, -2).effect(game)\n323\t\n324\t        assert not game.get_battlefield(p1).contains(target)\n325\t\n326\t    def test_noncreature_card_is_not_returned(self) -> None:\n327\t        \"\"\"Only creature cards are legal targets.\"\"\"\n328\t        from engine.card import Sorcery\n329\t\n330\t        game = create_game()\n331\t        p1 = game.players[0]\n332\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n333\t\n334\t        sorc = Sorcery(name=\"Cheap Sorcery\", mana_cost=ManaCost.parse(\"{1}\"), owner=p1, controller=p1)\n335\t        set_board_state(game, 0, graveyard=[sorc])\n336\t\n337\t        pw._resolve_target = sorc\n338\t        _ability_by_cost(pw, -2).effect(game)\n339\t        assert not game.get_battlefield(p1).contains(sorc)\n340\t\n341\t    def test_no_target_is_a_noop(self) -> None:\n342\t        game = create_game()\n343\t        p1 = game.players[0]\n344\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n345\t        target = _make_creature_card(\"Goblin\", mv=2, owner=p1)\n346\t        set_board_state(game, 0, graveyard=[target])\n347\t        # No _resolve_target set -> nothing happens.\n348\t        _ability_by_cost(pw, -2).effect(game)\n349\t        assert p1.zones[Zone.GRAVEYARD].contains(target)\n350\t\n351\t\n352\t# ---------------------------------------------------------------------------\n353\t# −7: Flip five coins. Target opponent skips their next X turns.\n354\t# ---------------------------------------------------------------------------\n355\t\n356\tclass TestRalZarekUltimate:\n357\t    \"\"\"−7's structural contract: it exists at loyalty cost −7 and runs without\n358\t    raising when a target opponent is supplied. The randomised X (heads count)\n359\t    and enforced turn-skipping are not asserted here (see untestable.json).\"\"\"\n360\t\n361\t    def test_ultimate_loyalty_cost_is_minus_seven(self) -> None:\n362\t        pw = RalZarekGuestLecturer(owner=None)\n363\t        ability = _ability_by_cost(pw, -7)\n364\t        assert ability.loyalty_cost == -7\n365\t\n366\t    def test_ultimate_runs_with_target_opponent(self) -> None:\n367\t        game = create_game()\n368\t        p1, p2 = game.players\n369\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n370\t        pw._resolve_target = p2\n371\t        # Five coin flips + skip scheduling must execute without raising.\n372\t        _ability_by_cost(pw, -7).effect(game)\n373\t\n374\t    def test_ultimate_with_no_target_is_a_safe_noop(self) -> None:\n375\t        game = create_game()\n376\t        p1 = game.players[0]\n377\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n378\t        # No target -> must not raise and must not break game state.\n379\t        _ability_by_cost(pw, -7).effect(game)\n380\t        assert game.is_game_over is False\n381\t"}]},"parent_tool_use_id":"toolu_01CEQK4iuzVq89pcNhCfuf9F","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"2717cc01-25e9-4c29-9e8b-391d36918f9d","timestamp":"2026-06-02T00:47:31.843Z","subagent_type":"Implementer","task_description":"Implement sos_97 planeswalker + engine support"}
