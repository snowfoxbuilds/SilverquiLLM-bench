{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015nFTt3E5ZjPB8zUMMxDLhE","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_120/card_impl.py b/cards/sos/sos_120/card_impl.py\n2\tindex fd0c1f4..3b316c8 100644\n3\t--- a/cards/sos/sos_120/card_impl.py\n4\t+++ b/cards/sos/sos_120/card_impl.py\n5\t@@ -1,16 +1,214 @@\n6\t-\"\"\"Card implementation for Improvisation Capstone.\"\"\"\n7\t+\"\"\"Card implementation for Improvisation Capstone (SOS 120).\"\"\"\n8\t \n9\t from __future__ import annotations\n10\t \n11\t-from engine.card import CardImpl\n12\t+from typing import TYPE_CHECKING, Any\n13\t \n14\t-from typing import TYPE_CHECKING\n15\t+from engine.card import Sorcery\n16\t+from engine.types import CardType, ManaCost, Zone\n17\t \n18\t if TYPE_CHECKING:\n19\t     from engine.game_state import GameState\n20\t+    from engine.player import Player\n21\t \n22\t \n23\t-class ImprovisationCapstone(CardImpl):\n24\t-    \"\"\"TODO: Implement Improvisation Capstone.\"\"\"\n25\t+def _mana_value(card: Any) -> int:\n26\t+    \"\"\"Return the mana value (CMC) of *card*, treating missing costs as 0.\"\"\"\n27\t+    mana_cost = getattr(card, \"mana_cost\", None)\n28\t+    if mana_cost is None:\n29\t+        return 0\n30\t+    return int(getattr(mana_cost, \"cmc\", 0) or 0)\n31\t \n32\t-    pass\n33\t+\n34\t+def _is_nonland_spell(card: Any) -> bool:\n35\t+    \"\"\"Return ``True`` if *card* is a castable nonland spell (never a land).\"\"\"\n36\t+    card_types = getattr(card, \"card_types\", set())\n37\t+    return CardType.LAND not in card_types\n38\t+\n39\t+\n40\t+class ImprovisationCapstone(Sorcery):\n41\t+    \"\"\"Improvisation Capstone — {5}{R}{R} — Sorcery — Lesson.\n42\t+\n43\t+    Exile cards from the top of your library until you exile cards with total\n44\t+    mana value 4 or greater. You may cast any number of spells from among them\n45\t+    without paying their mana costs.\n46\t+    Paradigm (Then exile this spell. After you first resolve a spell with this\n47\t+    name, you may cast a copy of it from exile without paying its mana cost at\n48\t+    the beginning of each of your first main phases.)\n49\t+\n50\t+    SOS collector number 120.\n51\t+    \"\"\"\n52\t+\n53\t+    def __init__(self, **kwargs: Any) -> None:\n54\t+        kwargs.setdefault(\"name\", \"Improvisation Capstone\")\n55\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{5}{R}{R}\"))\n56\t+        kwargs.setdefault(\"subtypes\", {\"Lesson\"})\n57\t+        kwargs.setdefault(\n58\t+            \"rules_text\",\n59\t+            \"Exile cards from the top of your library until you exile cards \"\n60\t+            \"with total mana value 4 or greater. You may cast any number of \"\n61\t+            \"spells from among them without paying their mana costs.\\n\"\n62\t+            \"Paradigm (Then exile this spell. After you first resolve a spell \"\n63\t+            \"with this name, you may cast a copy of it from exile without \"\n64\t+            \"paying its mana cost at the beginning of each of your first main \"\n65\t+            \"phases.)\",\n66\t+        )\n67\t+        super().__init__(**kwargs)\n68\t+        # Explicit colors (KEY_DECISIONS sos_13).\n69\t+        self.colors = [\"R\"]\n70\t+        # Card-level marker advertising the Paradigm keyword (not an evergreen\n71\t+        # engine Keyword flag).\n72\t+        self.paradigm = True\n73\t+\n74\t+    # ------------------------------------------------------------------\n75\t+    # Resolution\n76\t+    # ------------------------------------------------------------------\n77\t+\n78\t+    def on_resolve(self, game: \"GameState\") -> None:\n79\t+        \"\"\"Resolve Improvisation Capstone.\n80\t+\n81\t+        1. Exile cards from the top of the controller's library until the\n82\t+           cumulative mana value of the exiled pile is 4 or greater.\n83\t+        2. Offer the controller a free cast (no mana) of each nonland spell\n84\t+           among the freshly exiled pile.\n85\t+        3. Paradigm: self-exile this spell on resolution, and on the FIRST\n86\t+           resolution schedule a recurring precombat-main-phase effect that\n87\t+           offers a free copy from exile.\n88\t+        \"\"\"\n89\t+        controller = self.controller\n90\t+        if controller is None:\n91\t+            return\n92\t+\n93\t+        # --- Clause 1: exile-until-MV-4 -------------------------------------\n94\t+        exiled_pile = self._exile_until_mana_value_four(game, controller)\n95\t+\n96\t+        # --- Clause 2: free-cast from among the exiled pile ----------------\n97\t+        self._offer_free_casts(game, controller, exiled_pile)\n98\t+\n99\t+        # --- Clause 3: Paradigm self-exile + recurring copy trigger --------\n100\t+        # \"Then exile this spell\" — route the resolving Capstone to exile\n101\t+        # instead of the graveyard (sos_1 opt-in honoured by casting pipeline).\n102\t+        self._exile_instead_of_graveyard = True  # type: ignore[attr-defined]\n103\t+        self._schedule_paradigm_copy(game, controller)\n104\t+\n105\t+    # ------------------------------------------------------------------\n106\t+    # Clause 1 — exile until total mana value >= 4\n107\t+    # ------------------------------------------------------------------\n108\t+\n109\t+    def _exile_until_mana_value_four(\n110\t+        self, game: \"GameState\", controller: \"Player\"\n111\t+    ) -> list[Any]:\n112\t+        \"\"\"Exile top library cards until cumulative MV >= 4.\n113\t+\n114\t+        Returns the list of cards exiled by this call (in exile order). MV-0\n115\t+        cards add 0 and do not stop the loop. An empty / too-small library\n116\t+        terminates safely without raising.\n117\t+        \"\"\"\n118\t+        library = game.get_library(controller)\n119\t+        exile = game.get_exile(controller)\n120\t+\n121\t+        exiled: list[Any] = []\n122\t+        total = 0\n123\t+        while total < 4:\n124\t+            top = library.top(1)\n125\t+            if not top:\n126\t+                # Library emptied before reaching MV 4 — safe termination.\n127\t+                break\n128\t+            card = top[0]\n129\t+            library.remove(card)\n130\t+            exile.add(card)\n131\t+            exiled.append(card)\n132\t+            total += _mana_value(card)\n133\t+        return exiled\n134\t+\n135\t+    # ------------------------------------------------------------------\n136\t+    # Clause 2 — cast any number of the exiled spells for free\n137\t+    # ------------------------------------------------------------------\n138\t+\n139\t+    def _offer_free_casts(\n140\t+        self, game: \"GameState\", controller: \"Player\", exiled_pile: list[Any]\n141\t+    ) -> None:\n142\t+        \"\"\"Offer the controller a free cast of each nonland spell in the pile.\n143\t+\n144\t+        Uses the sos_1 ``choose_yes_no``-per-eligible-spell convention: lands\n145\t+        are skipped entirely; for each remaining nonland card the controller is\n146\t+        asked whether to cast it for free from exile. Accepted spells are\n147\t+        free-cast (``cast_spell_free`` from ``Zone.EXILE``); declined cards stay\n148\t+        in exile.\n149\t+        \"\"\"\n150\t+        from engine.casting import cast_spell_free, CastingError\n151\t+\n152\t+        for card in exiled_pile:\n153\t+            if not _is_nonland_spell(card):\n154\t+                # Lands can never be cast — skip without asking.\n155\t+                continue\n156\t+            # The card must still be in exile (it could have been moved by an\n157\t+            # earlier free cast, though pile entries are distinct).\n158\t+            if not game.get_exile(controller).contains(card):\n159\t+                continue\n160\t+            if not controller.choose_yes_no(\n161\t+                f\"Cast {getattr(card, 'name', 'a spell')!r} from exile without \"\n162\t+                \"paying its mana cost?\"\n163\t+            ):\n164\t+                continue\n165\t+            try:\n166\t+                cast_spell_free(game, controller, card, Zone.EXILE)\n167\t+            except CastingError:\n168\t+                # If the spell cannot legally be cast, leave it in exile.\n169\t+                continue\n170\t+\n171\t+    # ------------------------------------------------------------------\n172\t+    # Clause 3 — Paradigm recurring copy trigger\n173\t+    # ------------------------------------------------------------------\n174\t+\n175\t+    def _schedule_paradigm_copy(\n176\t+        self, game: \"GameState\", controller: \"Player\"\n177\t+    ) -> None:\n178\t+        \"\"\"Schedule the recurring Paradigm copy offer for the controller.\n179\t+\n180\t+        The sos_57 ``schedule_main_phase_deferred_effect`` surface is one-shot,\n181\t+        so the callback RE-SCHEDULES itself each time it fires — making the\n182\t+        offer recur at the beginning of every precombat main phase. When it\n183\t+        fires, the controller may cast a free copy of the Capstone from exile.\n184\t+        \"\"\"\n185\t+        capstone = self\n186\t+\n187\t+        def _offer_copy(g: \"GameState\") -> None:\n188\t+            # Re-schedule first so the recurring offer persists for the next\n189\t+            # precombat main phase even after this one fires (the deferred\n190\t+            # delivery removes one-shot entries before running callbacks).\n191\t+            g.schedule_main_phase_deferred_effect(\n192\t+                controller, _offer_copy, precombat=True\n193\t+            )\n194\t+\n195\t+            if not controller.choose_yes_no(\n196\t+                \"Cast a copy of Improvisation Capstone from exile without \"\n197\t+                \"paying its mana cost?\"\n198\t+            ):\n199\t+                return\n200\t+\n201\t+            capstone._cast_free_copy(g, controller)\n202\t+\n203\t+        game.schedule_main_phase_deferred_effect(\n204\t+            controller, _offer_copy, precombat=True\n205\t+        )\n206\t+\n207\t+    def _cast_free_copy(self, game: \"GameState\", controller: \"Player\") -> None:\n208\t+        \"\"\"Cast a free copy of Improvisation Capstone from exile.\n209\t+\n210\t+        Mirrors the casting pipeline by building a fresh Capstone instance (a\n211\t+        copy) and free-casting it. The copy carries the same Paradigm self-exile\n212\t+        rider so its own resolution behaves identically.\n213\t+        \"\"\"\n214\t+        from engine.casting import cast_spell_free, CastingError\n215\t+\n216\t+        copy = ImprovisationCapstone(owner=controller, controller=controller)\n217\t+        # Place the copy into exile so it can be cast \"from exile\".\n218\t+        game.get_exile(controller).add(copy)\n219\t+        try:\n220\t+            cast_spell_free(game, controller, copy, Zone.EXILE)\n221\t+        except CastingError:\n222\t+            # Could not cast — remove the dangling copy from exile.\n223\t+            exile = game.get_exile(controller)\n224\t+            if exile.contains(copy):\n225\t+                exile.remove(copy)\n226\t"}]},"parent_tool_use_id":"toolu_01DqhoWZJg2WpqFzEv91ggkk","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"e8355279-3f60-48aa-aa16-fed685483d74","timestamp":"2026-06-02T01:09:43.925Z","subagent_type":"Reviewer","task_description":"Review sos_120 implementation"}
