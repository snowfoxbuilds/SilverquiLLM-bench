{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EG4LkQnuj3qymfdmxUQMGB","type":"tool_result","content":"1\t\"\"\"Tests for SOS 120 — Improvisation Capstone.\n2\t\n3\tImprovisation Capstone is a ``{5}{R}{R}`` Sorcery — Lesson with the\n4\t**Paradigm** keyword:\n5\t\n6\t    Exile cards from the top of your library until you exile cards with\n7\t    total mana value 4 or greater. You may cast any number of spells from\n8\t    among them without paying their mana costs.\n9\t    Paradigm (Then exile this spell. After you first resolve a spell with\n10\t    this name, you may cast a copy of it from exile without paying its mana\n11\t    cost at the beginning of each of your first main phases.)\n12\t\n13\tThe card breaks into three distinct behaviours:\n14\t\n15\t1.  **Exile-until-MV-4** — exile cards one at a time off the top of the\n16\t    library, stopping as soon as the cumulative mana value of the exiled\n17\t    pile is 4 or greater (CR 614-style \"until\" loop). A library with fewer\n18\t    than 4 total mana value just empties; an empty library is a safe no-op.\n19\t2.  **Free-cast from among the exiled pile** — the controller *may* cast any\n20\t    number of the exiled *spells* (nonland cards) without paying their mana\n21\t    costs. Lands cannot be cast. Declining leaves the cards in exile.\n22\t3.  **Paradigm** — the spell exiles itself on resolution (instead of going to\n23\t    the graveyard), and after the controller first resolves a spell with this\n24\t    name a delayed effect lets them cast a free copy from exile at the\n25\t    beginning of each of their first (precombat) main phases.\n26\t\n27\tThese tests pin the spec-mandated, observable behaviour. They are written\n28\tagainst the public contract (``on_resolve``, the player decision interface,\n29\tand the deferred main-phase mechanism documented in KEY_DECISIONS), not\n30\tagainst private implementation details.\n31\t\"\"\"\n32\t\n33\tfrom __future__ import annotations\n34\t\n35\timport pytest\n36\t\n37\tfrom cards.sos.sos_120.card_impl import ImprovisationCapstone\n38\tfrom engine.card import Creature, Instant, Land, Sorcery\n39\tfrom engine.events import BeginningOfMainPhaseTriggeredEvent\n40\tfrom engine.types import CardType, ManaCost, ManaType\n41\tfrom test_utils import create_game, set_board_state\n42\t\n43\t\n44\t# ---------------------------------------------------------------------------\n45\t# Helpers\n46\t# ---------------------------------------------------------------------------\n47\t\n48\tdef _instant(name: str, cost: str, owner=None) -> Instant:\n49\t    return Instant(name=name, mana_cost=ManaCost.parse(cost), owner=owner)\n50\t\n51\t\n52\tdef _sorcery(name: str, cost: str, owner=None) -> Sorcery:\n53\t    return Sorcery(name=name, mana_cost=ManaCost.parse(cost), owner=owner)\n54\t\n55\t\n56\tdef _creature(name: str, cost: str, power: int = 2, toughness: int = 2, owner=None) -> Creature:\n57\t    return Creature(\n58\t        name=name,\n59\t        mana_cost=ManaCost.parse(cost),\n60\t        base_power=power,\n61\t        base_toughness=toughness,\n62\t        owner=owner,\n63\t    )\n64\t\n65\t\n66\tdef _land(name: str, owner=None) -> Land:\n67\t    return Land(name=name, owner=owner)\n68\t\n69\t\n70\tdef _set_library(game, player, cards: list) -> None:\n71\t    \"\"\"Replace *player*'s library with *cards* (index -1 == top of library).\"\"\"\n72\t    library = game.get_library(player)\n73\t    for obj in library.get_all():\n74\t        library.remove(obj)\n75\t    for card in cards:\n76\t        card.owner = player\n77\t        card.controller = player\n78\t        library.add(card)  # appends to top\n79\t\n80\t\n81\tdef _exiled(game, player) -> list:\n82\t    return game.get_exile(player).get_all()\n83\t\n84\t\n85\tdef _decline_free_casts(player, n: int = 12) -> None:\n86\t    \"\"\"Pre-script *player* to decline every \"you may cast?\" offer.\n87\t\n88\t    The \"you may cast any number of spells\" clause asks the controller whether\n89\t    to cast each eligible exiled spell. A DeterministicPlayer raises when its\n90\t    script is exhausted, so the exile-focused tests pre-load a generous run of\n91\t    ``False`` answers to decline the free-cast offers and keep the focus on the\n92\t    exile-until-MV-4 behaviour.\n93\t    \"\"\"\n94\t    player._script.extend([False] * n)\n95\t\n96\t\n97\t# ---------------------------------------------------------------------------\n98\t# Static card properties\n99\t# ---------------------------------------------------------------------------\n100\t\n101\tclass TestImprovisationCapstoneProperties:\n102\t    \"\"\"Static card data should match the SOS 120 spec.\"\"\"\n103\t\n104\t    def test_name(self) -> None:\n105\t        assert ImprovisationCapstone(owner=None).name == \"Improvisation Capstone\"\n106\t\n107\t    def test_is_sorcery(self) -> None:\n108\t        assert isinstance(ImprovisationCapstone(owner=None), Sorcery)\n109\t        assert CardType.SORCERY in ImprovisationCapstone(owner=None).card_types\n110\t\n111\t    def test_mana_cost(self) -> None:\n112\t        assert ImprovisationCapstone(owner=None).mana_cost == ManaCost.parse(\"{5}{R}{R}\")\n113\t\n114\t    def test_has_lesson_subtype(self) -> None:\n115\t        assert \"Lesson\" in ImprovisationCapstone(owner=None).subtypes\n116\t\n117\t    def test_has_paradigm_keyword_or_marker(self) -> None:\n118\t        \"\"\"The card advertises Paradigm. Paradigm is not an evergreen\n119\t        :class:`Keyword` flag, so it is exposed either via a card-level\n120\t        marker attribute or its rules text.\"\"\"\n121\t        card = ImprovisationCapstone(owner=None)\n122\t        rules = (getattr(card, \"rules_text\", \"\") or \"\").lower()\n123\t        has_marker = (\n124\t            getattr(card, \"paradigm\", False)\n125\t            or getattr(card, \"has_paradigm\", False)\n126\t            or \"paradigm\" in rules\n127\t        )\n128\t        assert has_marker\n129\t\n130\t    def test_is_red(self) -> None:\n131\t        card = ImprovisationCapstone(owner=None)\n132\t        assert \"R\" in getattr(card, \"colors\", [])\n133\t\n134\t    def test_not_a_permanent_type(self) -> None:\n135\t        \"\"\"A sorcery is not a permanent — it must not carry permanent types.\"\"\"\n136\t        types = ImprovisationCapstone(owner=None).card_types\n137\t        assert CardType.CREATURE not in types\n138\t        assert CardType.ENCHANTMENT not in types\n139\t        assert CardType.ARTIFACT not in types\n140\t\n141\t\n142\t# ---------------------------------------------------------------------------\n143\t# Clause 1 — Exile cards until total mana value >= 4\n144\t# ---------------------------------------------------------------------------\n145\t\n146\tclass TestExileUntilManaValueFour:\n147\t    \"\"\"Exile top cards one at a time until cumulative MV >= 4.\"\"\"\n148\t\n149\t    def test_exiles_until_total_mana_value_reaches_four(self) -> None:\n150\t        \"\"\"Three 2-MV cards on top: exile the first two (total 4), stop.\"\"\"\n151\t        game = create_game()\n152\t        p1 = game.players[0]\n153\t        # Library bottom -> top: deep, b (2), a (2). Top is `a`.\n154\t        deep = _creature(\"Deep Filler\", \"{9}\")\n155\t        a = _instant(\"Top A\", \"{1}{R}\")   # MV 2\n156\t        b = _sorcery(\"Top B\", \"{1}{R}\")   # MV 2\n157\t        _set_library(game, p1, [deep, b, a])\n158\t\n159\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n160\t        _decline_free_casts(p1)\n161\t        spell.on_resolve(game)\n162\t\n163\t        exiled = _exiled(game, p1)\n164\t        assert a in exiled and b in exiled\n165\t        assert deep not in exiled\n166\t        # Stops once total MV is 4 — does not over-exile beyond the boundary.\n167\t        assert deep in game.get_library(p1).get_all()\n168\t\n169\t    def test_single_high_value_card_stops_immediately(self) -> None:\n170\t        \"\"\"A single MV-4 card on top is enough; only it is exiled.\"\"\"\n171\t        game = create_game()\n172\t        p1 = game.players[0]\n173\t        big = _creature(\"Behemoth\", \"{4}\")     # MV 4\n174\t        rest = _instant(\"Untouched\", \"{1}\")\n175\t        _set_library(game, p1, [rest, big])    # big is on top\n176\t\n177\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n178\t        _decline_free_casts(p1)\n179\t        spell.on_resolve(game)\n180\t\n181\t        exiled = _exiled(game, p1)\n182\t        assert big in exiled\n183\t        assert rest not in exiled\n184\t        # The second card was never exiled — the loop stopped after the MV-4 card.\n185\t        assert rest in game.get_library(p1).get_all()\n186\t\n187\t    def test_total_mana_value_can_exceed_four(self) -> None:\n188\t        \"\"\"If the boundary card pushes the total past 4, that is fine —\n189\t        the loop only stops *after* reaching >= 4.\"\"\"\n190\t        game = create_game()\n191\t        p1 = game.players[0]\n192\t        a = _instant(\"A\", \"{2}\")   # MV 2\n193\t        b = _creature(\"B\", \"{5}\")  # MV 5 -> total 7 >= 4\n194\t        rest = _instant(\"Rest\", \"{1}\")\n195\t        _set_library(game, p1, [rest, b, a])   # top is `a`\n196\t\n197\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n198\t        _decline_free_casts(p1)\n199\t        spell.on_resolve(game)\n200\t\n201\t        exiled = _exiled(game, p1)\n202\t        assert a in exiled and b in exiled\n203\t        assert rest not in exiled\n204\t        assert rest in game.get_library(p1).get_all()\n205\t\n206\t    def test_exact_three_one_drops_take_four_cards(self) -> None:\n207\t        \"\"\"Four MV-1 cards: must exile exactly four to reach total MV 4.\"\"\"\n208\t        game = create_game()\n209\t        p1 = game.players[0]\n210\t        ones = [_instant(f\"One{i}\", \"{1}\") for i in range(4)]\n211\t        spare = _instant(\"Spare\", \"{1}\")\n212\t        # Library bottom->top: spare, One3, One2, One1, One0 (One0 on top)\n213\t        _set_library(game, p1, [spare] + list(reversed(ones)))\n214\t\n215\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n216\t        _decline_free_casts(p1)\n217\t        spell.on_resolve(game)\n218\t\n219\t        exiled = _exiled(game, p1)\n220\t        for card in ones:\n221\t            assert card in exiled\n222\t        assert spare not in exiled\n223\t        # The fifth card stays in the library — four MV-1 cards already total 4.\n224\t        assert spare in game.get_library(p1).get_all()\n225\t\n226\t    def test_small_library_below_four_is_emptied(self) -> None:\n227\t        \"\"\"If the whole library totals < 4 MV, every card is exiled and the\n228\t        loop terminates without error.\"\"\"\n229\t        game = create_game()\n230\t        p1 = game.players[0]\n231\t        a = _instant(\"A\", \"{1}\")   # MV 1\n232\t        b = _instant(\"B\", \"{1}\")   # MV 1 -> total 2, never reaches 4\n233\t        _set_library(game, p1, [b, a])\n234\t\n235\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n236\t        _decline_free_casts(p1)\n237\t        spell.on_resolve(game)\n238\t\n239\t        exiled = _exiled(game, p1)\n240\t        assert a in exiled and b in exiled\n241\t        assert len(game.get_library(p1).get_all()) == 0\n242\t\n243\t    def test_empty_library_is_safe_noop(self) -> None:\n244\t        \"\"\"An empty library exiles nothing and does not raise.\"\"\"\n245\t        game = create_game()\n246\t        p1 = game.players[0]\n247\t        _set_library(game, p1, [])\n248\t\n249\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n250\t        spell.on_resolve(game)  # must not raise\n251\t\n252\t        assert len(_exiled(game, p1)) == 0\n253\t\n254\t    def test_zero_mana_value_card_does_not_stop_the_loop(self) -> None:\n255\t        \"\"\"A {0} card adds 0 to the total — the loop must keep exiling until\n256\t        the cumulative MV actually reaches 4.\"\"\"\n257\t        game = create_game()\n258\t        p1 = game.players[0]\n259\t        zero = _instant(\"Free Spell\", \"{0}\")  # MV 0\n260\t        four = _creature(\"Four Drop\", \"{4}\")  # MV 4\n261\t        rest = _instant(\"Rest\", \"{1}\")\n262\t        _set_library(game, p1, [rest, four, zero])  # zero on top\n263\t\n264\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n265\t        _decline_free_casts(p1)\n266\t        spell.on_resolve(game)\n267\t\n268\t        exiled = _exiled(game, p1)\n269\t        assert zero in exiled and four in exiled\n270\t        assert rest not in exiled\n271\t        assert rest in game.get_library(p1).get_all()\n272\t\n273\t    def test_exiled_cards_leave_the_library(self) -> None:\n274\t        \"\"\"Cards moved to exile must no longer be in the library.\"\"\"\n275\t        game = create_game()\n276\t        p1 = game.players[0]\n277\t        a = _creature(\"A\", \"{4}\")\n278\t        rest = _instant(\"Rest\", \"{2}\")\n279\t        _set_library(game, p1, [rest, a])\n280\t\n281\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n282\t        _decline_free_casts(p1)\n283\t        spell.on_resolve(game)\n284\t\n285\t        assert not game.get_library(p1).contains(a)\n286\t        assert game.get_library(p1).contains(rest)\n287\t\n288\t\n289\t# ---------------------------------------------------------------------------\n290\t# Clause 2 — Cast any number of the exiled spells for free\n291\t# ---------------------------------------------------------------------------\n292\t\n293\tclass TestFreeCastFromExile:\n294\t    \"\"\"\"You may cast any number of spells from among them without paying.\"\"\"\n295\t\n296\t    def test_declining_leaves_all_cards_in_exile(self) -> None:\n297\t        \"\"\"Scripting \"no\" to every cast offer leaves the whole exiled pile\n298\t        in exile — nothing resolves, nothing is cast.\"\"\"\n299\t        game = create_game()\n300\t        p1 = game.players[0]\n301\t        a = _instant(\"A\", \"{2}\")\n302\t        b = _sorcery(\"B\", \"{2}\")\n303\t        rest = _instant(\"Rest\", \"{1}\")\n304\t        _set_library(game, p1, [rest, b, a])\n305\t        # Decline any/every \"do you want to cast?\" prompt.\n306\t        p1._script.extend([False, False, False, False])\n307\t\n308\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n309\t        spell.on_resolve(game)\n310\t\n311\t        exiled = _exiled(game, p1)\n312\t        assert a in exiled and b in exiled\n313\t        # No spell was put onto the stack to be cast.\n314\t        assert game.stack.is_empty()\n315\t\n316\t    def test_lands_among_exiled_are_never_cast(self) -> None:\n317\t        \"\"\"Lands are not spells — even if exiled, they cannot be cast and\n318\t        remain in exile regardless of player choices.\"\"\"\n319\t        game = create_game()\n320\t        p1 = game.players[0]\n321\t        land = _land(\"Mountain\")\n322\t        big = _creature(\"Big\", \"{4}\")   # MV 4, paired with the land\n323\t        _set_library(game, p1, [big, land])  # land on top, then big\n324\t        # Accept everything the card might offer; the land must still not be cast.\n325\t        p1._script.extend([True, True, True, True, True, True])\n326\t\n327\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n328\t        spell.on_resolve(game)\n329\t\n330\t        # The land was exiled but never left exile (cannot be cast).\n331\t        assert game.get_exile(p1).contains(land)\n332\t        assert not game.get_battlefield(p1).contains(land)\n333\t\n334\t    def test_casting_a_chosen_spell_moves_it_out_of_exile(self) -> None:\n335\t        \"\"\"Accepting the offer for an exiled instant casts it for free: the\n336\t        card is first exiled by the \"exile until MV 4\" clause, then cast — so\n337\t        after resolution it is no longer in exile, but it HAS left the library\n338\t        (proving it was the exiled card that got cast, not an untouched one).\"\"\"\n339\t        game = create_game()\n340\t        p1 = game.players[0]\n341\t        bolt = _instant(\"Free Bolt\", \"{4}\")  # MV 4 alone -> sole exiled card\n342\t        rest = _instant(\"Rest\", \"{1}\")\n343\t        _set_library(game, p1, [rest, bolt])  # bolt on top\n344\t        # Say yes to cast Free Bolt, plus a couple of spare answers in case the\n345\t        # implementation asks a per-card selection question.\n346\t        p1._script.extend([True, bolt, True, bolt])\n347\t\n348\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n349\t        spell.on_resolve(game)\n350\t\n351\t        # The card was pulled off the library (exiled), then cast — so it is\n352\t        # neither in the library nor still sitting in exile.\n353\t        assert not game.get_library(p1).contains(bolt)\n354\t        assert not game.get_exile(p1).contains(bolt)\n355\t\n356\t    def test_free_cast_does_not_require_mana(self) -> None:\n357\t        \"\"\"Casting from among the exiled pile costs no mana — the controller\n358\t        with an empty pool can still cast the exiled spell. The card must\n359\t        first have been exiled (off the library) and then leave exile.\"\"\"\n360\t        game = create_game()\n361\t        p1 = game.players[0]\n362\t        spell_card = _sorcery(\"Free Sorc\", \"{4}\")\n363\t        rest = _instant(\"Rest\", \"{1}\")\n364\t        _set_library(game, p1, [rest, spell_card])  # spell_card on top\n365\t        set_board_state(game, 0, mana={})  # empty pool\n366\t        p1._script.extend([True, spell_card, True, spell_card])\n367\t\n368\t        capstone = ImprovisationCapstone(owner=p1, controller=p1)\n369\t        capstone.on_resolve(game)\n370\t\n371\t        # Free Sorc was exiled (left the library) and cast (left exile) despite\n372\t        # no available mana.\n373\t        assert not game.get_library(p1).contains(spell_card)\n374\t        assert not game.get_exile(p1).contains(spell_card)\n375\t\n376\t\n377\t# ---------------------------------------------------------------------------\n378\t# Clause 3 — Paradigm: exile this spell + delayed copy mechanism\n379\t# ---------------------------------------------------------------------------\n380\t\n381\tclass TestParadigmSelfExile:\n382\t    \"\"\"\"Then exile this spell.\" — the resolved Capstone goes to exile, not\n383\t    the graveyard.\"\"\"\n384\t\n385\t    def test_resolution_via_full_pipeline_exiles_the_spell(self) -> None:\n386\t        \"\"\"Casting through the engine pipeline routes the resolved Capstone to\n387\t        exile rather than the graveyard (the Paradigm self-exile rider).\"\"\"\n388\t        game = create_game()\n389\t        p1 = game.players[0]\n390\t        capstone = ImprovisationCapstone(owner=p1, controller=p1)\n391\t        # Give it a small library so the exile-until clause is a quick no-op-ish.\n392\t        filler = _instant(\"Filler\", \"{4}\")\n393\t        _set_library(game, p1, [filler])\n394\t        set_board_state(\n395\t            game, 0,\n396\t            hand=[capstone],\n397\t            mana={ManaType.RED: 2, ManaType.COLORLESS: 5},\n398\t        )\n399\t        # Decline the free-cast offers so the test stays focused on self-exile.\n400\t        p1._script.extend([False, False, False])\n401\t\n402\t        from test_utils import cast_spell\n403\t        cast_spell(game, 0, \"Improvisation Capstone\")\n404\t\n405\t        # Paradigm: \"Then exile this spell.\"\n406\t        assert game.get_exile(p1).contains(capstone)\n407\t        assert not game.get_graveyard(p1).contains(capstone)\n408\t\n409\t\n410\tclass TestParadigmDelayedCopy:\n411\t    \"\"\"After the first Capstone resolves, a delayed effect lets the\n412\t    controller cast a free copy from exile at the beginning of each of their\n413\t    first (precombat) main phases.\"\"\"\n414\t\n415\t    def test_first_resolution_schedules_a_main_phase_effect(self) -> None:\n416\t        \"\"\"Resolving the spell for the first time registers a deferred\n417\t        main-phase effect for its controller (the Paradigm delayed trigger).\"\"\"\n418\t        game = create_game()\n419\t        p1 = game.players[0]\n420\t        filler = _instant(\"Filler\", \"{4}\")\n421\t        _set_library(game, p1, [filler])\n422\t\n423\t        capstone = ImprovisationCapstone(owner=p1, controller=p1)\n424\t        before = len(game.main_phase_deferred_effects)\n425\t        # Decline the free-cast prompts.\n426\t        p1._script.extend([False, False, False])\n427\t        capstone.on_resolve(game)\n428\t\n429\t        after = len(game.main_phase_deferred_effects)\n430\t        assert after > before\n431\t\n432\t    def test_scheduled_copy_effect_targets_the_precombat_main_phase(self) -> None:\n433\t        \"\"\"The Paradigm delayed trigger is for the controller's *precombat*\n434\t        main phases, so the scheduled deferred effect must be registered for\n435\t        the controller with the precombat flag set.\"\"\"\n436\t        game = create_game()\n437\t        p1 = game.players[0]\n438\t        filler = _instant(\"Filler\", \"{4}\")\n439\t        _set_library(game, p1, [filler])\n440\t\n441\t        capstone = ImprovisationCapstone(owner=p1, controller=p1)\n442\t        p1._script.extend([False, False, False])\n443\t        capstone.on_resolve(game)\n444\t\n445\t        entries = [\n446\t            e for e in game.main_phase_deferred_effects\n447\t            if e.get(\"controller\") is p1\n448\t        ]\n449\t        assert entries, \"first resolution must schedule a deferred effect for the controller\"\n450\t        assert all(e.get(\"precombat\", True) for e in entries)\n451\t\n452\t    def test_precombat_main_phase_consults_player_for_a_copy(self) -> None:\n453\t        \"\"\"When the controller's next precombat main phase begins after the\n454\t        first resolution, firing the main-phase event runs the scheduled\n455\t        Paradigm effect, which consults the controller (\"you may cast a\n456\t        copy\"). Declining must cast nothing onto the stack.\n457\t\n458\t        This focuses on the delayed copy mechanism; the self-exile of the\n459\t        Capstone via resolution is covered separately by\n460\t        :class:`TestParadigmSelfExile`.\"\"\"\n461\t        game = create_game()\n462\t        p1 = game.players[0]\n463\t        filler = _instant(\"Filler\", \"{4}\")\n464\t        _set_library(game, p1, [filler])\n465\t\n466\t        capstone = ImprovisationCapstone(owner=p1, controller=p1)\n467\t        # First resolution: decline the immediate free-cast offers.\n468\t        _decline_free_casts(p1)\n469\t        capstone.on_resolve(game)\n470\t        # Ensure the Capstone is in exile for the copy mechanism, regardless of\n471\t        # whether the bare on_resolve path or the casting pipeline performs the\n472\t        # self-exile.\n473\t        if not game.get_exile(p1).contains(capstone):\n474\t            game.get_exile(p1).add(capstone)\n475\t\n476\t        # At the next precombat main phase, the scheduled effect must consult\n477\t        # the controller. Provide a decline answer.\n478\t        before = p1.remaining_choices\n479\t        p1._script.append(False)\n480\t        game.active_player_index = 0\n481\t        game.trigger_manager.fire_event(\n482\t            game,\n483\t            BeginningOfMainPhaseTriggeredEvent(player=p1, controller=p1, precombat=True),\n484\t        )\n485\t\n486\t        # The scheduled effect ran and consumed the player's \"no\" answer\n487\t        # (a one-shot deferred entry that never fired would leave it unused).\n488\t        assert p1.remaining_choices < before + 1\n489\t        # Declining the copy casts nothing onto the stack.\n490\t        assert game.stack.is_empty()\n491\t\n492\t    def test_paradigm_copy_offer_recurs_each_precombat_main_phase(self) -> None:\n493\t        \"\"\"Paradigm fires \"at the beginning of EACH of your first main phases\",\n494\t        so the deferred offer must persist after the first main phase — it is\n495\t        not a single-use one-shot effect. After firing one precombat main\n496\t        phase (and declining), a scheduled effect for the controller must\n497\t        still be present for the next one.\"\"\"\n498\t        game = create_game()\n499\t        p1 = game.players[0]\n500\t        filler = _instant(\"Filler\", \"{4}\")\n501\t        _set_library(game, p1, [filler])\n502\t\n503\t        capstone = ImprovisationCapstone(owner=p1, controller=p1)\n504\t        p1._script.extend([False, False, False])\n505\t        capstone.on_resolve(game)\n506\t\n507\t        # First precombat main phase — decline the copy offer.\n508\t        p1._script.append(False)\n509\t        game.active_player_index = 0\n510\t        game.trigger_manager.fire_event(\n511\t            game,\n512\t            BeginningOfMainPhaseTriggeredEvent(player=p1, controller=p1, precombat=True),\n513\t        )\n514\t\n515\t        # The recurring Paradigm offer must still be scheduled for the\n516\t        # controller's next precombat main phase (not consumed one-shot).\n517\t        remaining = [\n518\t            e for e in game.main_phase_deferred_effects\n519\t            if e.get(\"controller\") is p1\n520\t        ]\n521\t        assert remaining, (\n522\t            \"Paradigm is a recurring delayed trigger — the offer must persist \"\n523\t            \"for subsequent precombat main phases, not be removed after one\"\n524\t        )\n525\t"}]},"parent_tool_use_id":"toolu_01MgVHaaugGQm27LxaZDymC1","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"53cd9ac9-555e-4184-add8-1677b7d6490b","timestamp":"2026-06-02T01:06:42.308Z","subagent_type":"Implementer","task_description":"Implement sos_120 (retry)"}
