{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018b5BAs96xKiu8aRKP6R8Sz","type":"tool_result","content":"1\t\"\"\"Tests for engine/casting.py — casting and resolution pipeline.\n2\t\n3\tCovers:\n4\t- Timing helpers: is_sorcery_speed, can_cast_at_instant_speed\n5\t- cast_spell: full pipeline from hand → stack → resolve → destination zone\n6\t- play_land: special action bypassing the stack\n7\t- CastingError for illegal actions\n8\t- Hook callbacks (on_cast, on_resolve)\n9\t- Mana payment verification\n10\t\"\"\"\n11\t\n12\tfrom __future__ import annotations\n13\t\n14\timport pytest\n15\t\n16\tfrom engine.card import (\n17\t    Artifact,\n18\t    ArtifactCreature,\n19\t    CardImpl,\n20\t    Creature,\n21\t    Enchantment,\n22\t    Instant,\n23\t    Land,\n24\t    Planeswalker,\n25\t    Sorcery,\n26\t)\n27\tfrom engine.casting import (\n28\t    CastingError,\n29\t    _PERMANENT_TYPES,\n30\t    can_cast_at_instant_speed,\n31\t    cast_spell,\n32\t    is_sorcery_speed,\n33\t    play_land,\n34\t)\n35\tfrom engine.game_state import GameState\n36\tfrom engine.player import DeterministicPlayer\n37\tfrom engine.stack import StackObject\n38\tfrom engine.types import CardType, Keyword, ManaCost, ManaType, Phase, Step\n39\t\n40\t\n41\t# ---------------------------------------------------------------------------\n42\t# Helpers\n43\t# ---------------------------------------------------------------------------\n44\t\n45\tdef _make_game(\n46\t    *,\n47\t    p1_script: list | None = None,\n48\t    p2_script: list | None = None,\n49\t    phase: Phase = Phase.PRECOMBAT_MAIN,\n50\t    step: Step | None = None,\n51\t) -> GameState:\n52\t    \"\"\"Create a minimal 2-player GameState at the specified phase/step.\"\"\"\n53\t    p1 = DeterministicPlayer(\"Alice\", p1_script or [])\n54\t    p2 = DeterministicPlayer(\"Bob\", p2_script or [])\n55\t    game = GameState([p1, p2])\n56\t    game.phase = phase\n57\t    game.step = step\n58\t    return game\n59\t\n60\t\n61\tdef _add_to_hand(game: GameState, player_idx: int, card: CardImpl) -> None:\n62\t    \"\"\"Put *card* into the player's hand.\"\"\"\n63\t    game.get_hand(game.players[player_idx]).add(card)\n64\t\n65\t\n66\tdef _add_mana(player: DeterministicPlayer, mana_type: ManaType, amount: int) -> None:\n67\t    \"\"\"Shortcut to add mana to a player's pool.\"\"\"\n68\t    player.mana_pool.add(mana_type, amount)\n69\t\n70\t\n71\t# ---------------------------------------------------------------------------\n72\t# Timing helper tests — is_sorcery_speed\n73\t# ---------------------------------------------------------------------------\n74\t\n75\tclass TestIsSorcerySpeed:\n76\t    \"\"\"Verify is_sorcery_speed requires: active player + main phase + empty stack.\"\"\"\n77\t\n78\t    def test_precombat_main_active_player_empty_stack_is_true(self):\n79\t        game = _make_game(phase=Phase.PRECOMBAT_MAIN)\n80\t        assert is_sorcery_speed(game, game.players[0]) is True\n81\t\n82\t    def test_postcombat_main_active_player_empty_stack_is_true(self):\n83\t        game = _make_game(phase=Phase.POSTCOMBAT_MAIN)\n84\t        assert is_sorcery_speed(game, game.players[0]) is True\n85\t\n86\t    def test_non_active_player_returns_false(self):\n87\t        game = _make_game(phase=Phase.PRECOMBAT_MAIN)\n88\t        assert is_sorcery_speed(game, game.players[1]) is False\n89\t\n90\t    def test_combat_phase_returns_false(self):\n91\t        game = _make_game(phase=Phase.COMBAT, step=Step.DECLARE_ATTACKERS)\n92\t        assert is_sorcery_speed(game, game.players[0]) is False\n93\t\n94\t    def test_beginning_phase_returns_false(self):\n95\t        game = _make_game(phase=Phase.BEGINNING, step=Step.UPKEEP)\n96\t        assert is_sorcery_speed(game, game.players[0]) is False\n97\t\n98\t    def test_ending_phase_returns_false(self):\n99\t        game = _make_game(phase=Phase.ENDING, step=Step.END)\n100\t        assert is_sorcery_speed(game, game.players[0]) is False\n101\t\n102\t    def test_nonempty_stack_returns_false(self):\n103\t        game = _make_game(phase=Phase.PRECOMBAT_MAIN)\n104\t        dummy = StackObject(source=None, controller=game.players[0])\n105\t        game.stack.push(dummy)\n106\t        assert is_sorcery_speed(game, game.players[0]) is False\n107\t\n108\t\n109\t# ---------------------------------------------------------------------------\n110\t# Timing helper tests — can_cast_at_instant_speed\n111\t# ---------------------------------------------------------------------------\n112\t\n113\tclass TestCanCastAtInstantSpeed:\n114\t    \"\"\"Verify instant-speed detection: instant type or FLASH keyword.\"\"\"\n115\t\n116\t    def test_instant_returns_true(self):\n117\t        assert can_cast_at_instant_speed(Instant(name=\"Bolt\")) is True\n118\t\n119\t    def test_sorcery_returns_false(self):\n120\t        assert can_cast_at_instant_speed(Sorcery(name=\"Div\")) is False\n121\t\n122\t    def test_creature_without_flash_returns_false(self):\n123\t        assert can_cast_at_instant_speed(\n124\t            Creature(name=\"Bear\", base_power=2, base_toughness=2)\n125\t        ) is False\n126\t\n127\t    def test_creature_with_flash_returns_true(self):\n128\t        card = Creature(name=\"Viper\", base_power=2, base_toughness=1, keywords=Keyword.FLASH)\n129\t        assert can_cast_at_instant_speed(card) is True\n130\t\n131\t    def test_enchantment_with_flash_returns_true(self):\n132\t        card = Enchantment(name=\"Leyline\", keywords=Keyword.FLASH)\n133\t        assert can_cast_at_instant_speed(card) is True\n134\t\n135\t\n136\t# ---------------------------------------------------------------------------\n137\t# cast_spell — core pipeline tests\n138\t# ---------------------------------------------------------------------------\n139\t\n140\tclass TestCastSpellCreature:\n141\t    \"\"\"Requirement: cast vanilla creature → on stack → resolve → battlefield.\"\"\"\n142\t\n143\t    def test_cast_puts_creature_on_stack(self):\n144\t        game = _make_game()\n145\t        player = game.players[0]\n146\t        bear = Creature(\n147\t            name=\"Grizzly Bears\",\n148\t            mana_cost=ManaCost(generic=1, pips={ManaType.GREEN: 1}),\n149\t            base_power=2, base_toughness=2,\n150\t        )\n151\t        _add_to_hand(game, 0, bear)\n152\t        _add_mana(player, ManaType.GREEN, 2)\n153\t\n154\t        cast_spell(game, player, bear)\n155\t\n156\t        assert not game.stack.is_empty()\n157\t        top = game.stack.peek()\n158\t        assert top is not None\n159\t        assert top.source is bear\n160\t        assert top.controller is player\n161\t\n162\t    def test_cast_removes_creature_from_hand(self):\n163\t        game = _make_game()\n164\t        player = game.players[0]\n165\t        bear = Creature(\n166\t            name=\"Bear\", mana_cost=ManaCost(pips={ManaType.GREEN: 1}),\n167\t            base_power=2, base_toughness=2,\n168\t        )\n169\t        _add_to_hand(game, 0, bear)\n170\t        _add_mana(player, ManaType.GREEN, 1)\n171\t\n172\t        cast_spell(game, player, bear)\n173\t        assert not game.get_hand(player).contains(bear)\n174\t\n175\t    def test_resolve_creature_to_battlefield(self):\n176\t        game = _make_game()\n177\t        player = game.players[0]\n178\t        bear = Creature(\n179\t            name=\"Bear\",\n180\t            mana_cost=ManaCost(generic=1, pips={ManaType.GREEN: 1}),\n181\t            base_power=2, base_toughness=2,\n182\t        )\n183\t        _add_to_hand(game, 0, bear)\n184\t        _add_mana(player, ManaType.GREEN, 2)\n185\t\n186\t        cast_spell(game, player, bear)\n187\t        obj = game.stack.pop()\n188\t        obj.on_resolve(game)\n189\t\n190\t        assert game.get_battlefield(player).contains(bear)\n191\t        assert not game.get_graveyard(player).contains(bear)\n192\t\n193\t\n194\tclass TestCastSpellInstant:\n195\t    \"\"\"Requirement: cast instant → resolve → graveyard (not battlefield).\"\"\"\n196\t\n197\t    def test_resolve_instant_to_graveyard(self):\n198\t        game = _make_game()\n199\t        player = game.players[0]\n200\t        bolt = Instant(name=\"Bolt\", mana_cost=ManaCost(pips={ManaType.RED: 1}))\n201\t        _add_to_hand(game, 0, bolt)\n202\t        _add_mana(player, ManaType.RED, 1)\n203\t\n204\t        cast_spell(game, player, bolt)\n205\t        obj = game.stack.pop()\n206\t        obj.on_resolve(game)\n207\t\n208\t        assert game.get_graveyard(player).contains(bolt)\n209\t        assert not game.get_battlefield(player).contains(bolt)\n210\t\n211\t\n212\tclass TestCastSpellSorcery:\n213\t    \"\"\"Requirement: cast sorcery → resolve → graveyard.\"\"\"\n214\t\n215\t    def test_resolve_sorcery_to_graveyard(self):\n216\t        game = _make_game()\n217\t        player = game.players[0]\n218\t        div = Sorcery(\n219\t            name=\"Divination\",\n220\t            mana_cost=ManaCost(generic=2, pips={ManaType.BLUE: 1}),\n221\t        )\n222\t        _add_to_hand(game, 0, div)\n223\t        _add_mana(player, ManaType.BLUE, 3)\n224\t\n225\t        cast_spell(game, player, div)\n226\t        obj = game.stack.pop()\n227\t        obj.on_resolve(game)\n228\t\n229\t        assert game.get_graveyard(player).contains(div)\n230\t        assert not game.get_battlefield(player).contains(div)\n231\t\n232\t\n233\t# ---------------------------------------------------------------------------\n234\t# cast_spell — timing rejection tests\n235\t# ---------------------------------------------------------------------------\n236\t\n237\tclass TestCastSpellTimingRejections:\n238\t    \"\"\"Requirement: sorcery-speed violations raise CastingError.\"\"\"\n239\t\n240\t    def test_sorcery_during_combat_phase_raises(self):\n241\t        \"\"\"Sorcery during combat → CastingError.\"\"\"\n242\t        game = _make_game(phase=Phase.COMBAT, step=Step.DECLARE_ATTACKERS)\n243\t        player = game.players[0]\n244\t        sorc = Sorcery(name=\"Wrath\", mana_cost=ManaCost(pips={ManaType.WHITE: 1}))\n245\t        _add_to_hand(game, 0, sorc)\n246\t        _add_mana(player, ManaType.WHITE, 1)\n247\t\n248\t        with pytest.raises(CastingError, match=\"sorcery-speed timing\"):\n249\t            cast_spell(game, player, sorc)\n250\t\n251\t    def test_creature_during_combat_phase_raises(self):\n252\t        \"\"\"Non-flash creature during combat → CastingError.\"\"\"\n253\t        game = _make_game(phase=Phase.COMBAT, step=Step.DECLARE_BLOCKERS)\n254\t        player = game.players[0]\n255\t        bear = Creature(\n256\t            name=\"Bear\", mana_cost=ManaCost(pips={ManaType.GREEN: 1}),\n257\t            base_power=2, base_toughness=2,\n258\t        )\n259\t        _add_to_hand(game, 0, bear)\n260\t        _add_mana(player, ManaType.GREEN, 1)\n261\t\n262\t        with pytest.raises(CastingError, match=\"sorcery-speed timing\"):\n263\t            cast_spell(game, player, bear)\n264\t\n265\t    def test_sorcery_with_nonempty_stack_raises(self):\n266\t        \"\"\"Sorcery with non-empty stack → CastingError.\"\"\"\n267\t        game = _make_game()\n268\t        player = game.players[0]\n269\t        dummy = StackObject(source=None, controller=player)\n270\t        game.stack.push(dummy)\n271\t\n272\t        sorc = Sorcery(name=\"Div\", mana_cost=ManaCost(pips={ManaType.BLUE: 1}))\n273\t        _add_to_hand(game, 0, sorc)\n274\t        _add_mana(player, ManaType.BLUE, 1)\n275\t\n276\t        with pytest.raises(CastingError, match=\"sorcery-speed timing\"):\n277\t            cast_spell(game, player, sorc)\n278\t\n279\t    def test_non_active_player_sorcery_raises(self):\n280\t        \"\"\"Non-active player casting sorcery → CastingError.\"\"\"\n281\t        game = _make_game()\n282\t        non_active = game.players[1]\n283\t        sorc = Sorcery(name=\"Div\", mana_cost=ManaCost(pips={ManaType.BLUE: 1}))\n284\t        _add_to_hand(game, 1, sorc)\n285\t        _add_mana(non_active, ManaType.BLUE, 1)\n286\t\n287\t        with pytest.raises(CastingError, match=\"sorcery-speed timing\"):\n288\t            cast_spell(game, non_active, sorc)\n289\t\n290\t    def test_non_active_player_creature_no_flash_raises(self):\n291\t        \"\"\"Non-active player casting creature without flash → CastingError.\"\"\"\n292\t        game = _make_game()\n293\t        non_active = game.players[1]\n294\t        bear = Creature(\n295\t            name=\"Bear\", mana_cost=ManaCost(pips={ManaType.GREEN: 1}),\n296\t            base_power=2, base_toughness=2,\n297\t        )\n298\t        _add_to_hand(game, 1, bear)\n299\t        _add_mana(non_active, ManaType.GREEN, 1)\n300\t\n301\t        with pytest.raises(CastingError, match=\"sorcery-speed timing\"):\n302\t            cast_spell(game, non_active, bear)\n303\t\n304\t\n305\t# ---------------------------------------------------------------------------\n306\t# cast_spell — flash / instant-speed success\n307\t# ---------------------------------------------------------------------------\n308\t\n309\tclass TestCastSpellInstantSpeed:\n310\t    \"\"\"Requirement: FLASH keyword at instant speed → succeeds.\"\"\"\n311\t\n312\t    def test_flash_creature_during_combat_succeeds(self):\n313\t        game = _make_game(phase=Phase.COMBAT, step=Step.DECLARE_BLOCKERS)\n314\t        player = game.players[0]\n315\t        viper = Creature(\n316\t            name=\"Ambush Viper\",\n317\t            mana_cost=ManaCost(generic=1, pips={ManaType.GREEN: 1}),\n318\t            base_power=2, base_toughness=1,\n319\t            keywords=Keyword.FLASH,\n320\t        )\n321\t        _add_to_hand(game, 0, viper)\n322\t        _add_mana(player, ManaType.GREEN, 2)\n323\t\n324\t        cast_spell(game, player, viper)\n325\t        assert not game.stack.is_empty()\n326\t        assert game.stack.peek().source is viper\n327\t\n328\t    def test_instant_during_upkeep_succeeds(self):\n329\t        game = _make_game(phase=Phase.BEGINNING, step=Step.UPKEEP)\n330\t        player = game.players[0]\n331\t        bolt = Instant(name=\"Bolt\", mana_cost=ManaCost(pips={ManaType.RED: 1}))\n332\t        _add_to_hand(game, 0, bolt)\n333\t        _add_mana(player, ManaType.RED, 1)\n334\t\n335\t        cast_spell(game, player, bolt)\n336\t        assert not game.stack.is_empty()\n337\t\n338\t    def test_non_active_player_can_cast_instant(self):\n339\t        game = _make_game()\n340\t        non_active = game.players[1]\n341\t        bolt = Instant(name=\"Bolt\", mana_cost=ManaCost(pips={ManaType.RED: 1}))\n342\t        _add_to_hand(game, 1, bolt)\n343\t        _add_mana(non_active, ManaType.RED, 1)\n344\t\n345\t        cast_spell(game, non_active, bolt)\n346\t        assert not game.stack.is_empty()\n347\t\n348\t    def test_flash_enchantment_during_combat_succeeds(self):\n349\t        game = _make_game(phase=Phase.COMBAT, step=Step.END_COMBAT)\n350\t        player = game.players[0]\n351\t        ench = Enchantment(\n352\t            name=\"Leyline\",\n353\t            mana_cost=ManaCost(pips={ManaType.WHITE: 1}),\n354\t            keywords=Keyword.FLASH,\n355\t        )\n356\t        _add_to_hand(game, 0, ench)\n357\t        _add_mana(player, ManaType.WHITE, 1)\n358\t\n359\t        cast_spell(game, player, ench)\n360\t        assert not game.stack.is_empty()\n361\t\n362\t\n363\t# ---------------------------------------------------------------------------\n364\t# cast_spell — mana payment\n365\t# ---------------------------------------------------------------------------\n366\t\n367\tclass TestCastSpellManaPayment:\n368\t    \"\"\"Requirement: insufficient mana → CastingError; mana deducted on success.\"\"\"\n369\t\n370\t    def test_insufficient_mana_raises(self):\n371\t        game = _make_game()\n372\t        player = game.players[0]\n373\t        bear = Creature(\n374\t            name=\"Bear\",\n375\t            mana_cost=ManaCost(generic=1, pips={ManaType.GREEN: 1}),\n376\t            base_power=2, base_toughness=2,\n377\t        )\n378\t        _add_to_hand(game, 0, bear)\n379\t        _add_mana(player, ManaType.GREEN, 1)  # only 1G, need 1G + {1}\n380\t\n381\t        with pytest.raises(CastingError, match=\"insufficient mana\"):\n382\t            cast_spell(game, player, bear)\n383\t\n384\t    def test_no_mana_at_all_raises(self):\n385\t        game = _make_game()\n386\t        player = game.players[0]\n387\t        bolt = Instant(name=\"Bolt\", mana_cost=ManaCost(pips={ManaType.RED: 1}))\n388\t        _add_to_hand(game, 0, bolt)\n389\t        # No mana added\n390\t\n391\t        with pytest.raises(CastingError, match=\"insufficient mana\"):\n392\t            cast_spell(game, player, bolt)\n393\t\n394\t    def test_wrong_color_mana_raises(self):\n395\t        game = _make_game()\n396\t        player = game.players[0]\n397\t        bolt = Instant(name=\"Bolt\", mana_cost=ManaCost(pips={ManaType.RED: 1}))\n398\t        _add_to_hand(game, 0, bolt)\n399\t        _add_mana(player, ManaType.BLUE, 5)  # plenty of mana, but wrong color\n400\t\n401\t        with pytest.raises(CastingError, match=\"insufficient mana\"):\n402\t            cast_spell(game, player, bolt)\n403\t\n404\t    def test_mana_deducted_after_cast(self):\n405\t        \"\"\"Verify mana pool is reduced by the cost after a successful cast.\"\"\"\n406\t        game = _make_game()\n407\t        player = game.players[0]\n408\t        bear = Creature(\n409\t            name=\"Bear\",\n410\t            mana_cost=ManaCost(generic=1, pips={ManaType.GREEN: 1}),\n411\t            base_power=2, base_toughness=2,\n412\t        )\n413\t        _add_to_hand(game, 0, bear)\n414\t        _add_mana(player, ManaType.GREEN, 3)\n415\t\n416\t        cast_spell(game, player, bear)\n417\t\n418\t        # 3G minus {G} pip minus {1} generic (auto-paid with G) = 1G left\n419\t        assert player.mana_pool.get(ManaType.GREEN) == 1\n420\t\n421\t    def test_exact_mana_leaves_zero(self):\n422\t        \"\"\"Paying exactly the cost leaves the pool empty.\"\"\"\n423\t        game = _make_game()\n424\t        player = game.players[0]\n425\t        bolt = Instant(name=\"Bolt\", mana_cost=ManaCost(pips={ManaType.RED: 1}))\n426\t        _add_to_hand(game, 0, bolt)\n427\t        _add_mana(player, ManaType.RED, 1)\n428\t\n429\t        cast_spell(game, player, bolt)\n430\t        assert player.mana_pool.get(ManaType.RED) == 0\n431\t\n432\t    def test_zero_cost_spell_requires_no_mana(self):\n433\t        \"\"\"A zero-cost spell can be cast with an empty pool.\"\"\"\n434\t        game = _make_game()\n435\t        player = game.players[0]\n436\t        card = Instant(name=\"Pact\", mana_cost=ManaCost())\n437\t        _add_to_hand(game, 0, card)\n438\t        # No mana added — pool is empty\n439\t\n440\t        cast_spell(game, player, card)\n441\t        assert not game.stack.is_empty()\n442\t\n443\t    def test_mana_not_deducted_on_failure(self):\n444\t        \"\"\"When casting fails (e.g. timing), mana should not be deducted.\"\"\"\n445\t        game = _make_game(phase=Phase.COMBAT, step=Step.DECLARE_ATTACKERS)\n446\t        player = game.players[0]\n447\t        sorc = Sorcery(name=\"Div\", mana_cost=ManaCost(pips={ManaType.BLUE: 1}))\n448\t        _add_to_hand(game, 0, sorc)\n449\t        _add_mana(player, ManaType.BLUE, 1)\n450\t\n451\t        with pytest.raises(CastingError):\n452\t            cast_spell(game, player, sorc)\n453\t\n454\t        # Mana should still be there since timing check fails before payment\n455\t        assert player.mana_pool.get(ManaType.BLUE) == 1\n456\t\n457\t\n458\t# ---------------------------------------------------------------------------\n459\t# cast_spell — hook callbacks\n460\t# ---------------------------------------------------------------------------\n461\t\n462\tclass TestCastSpellHooks:\n463\t    \"\"\"Requirements: on_cast called during cast; on_resolve called during resolution.\"\"\"\n464\t\n465\t    def test_on_cast_callback_is_called(self):\n466\t        on_cast_log: list[str] = []\n467\t\n468\t        class TrackedCreature(Creature):\n469\t            def on_cast(self, game: GameState) -> None:\n470\t                on_cast_log.append(\"on_cast\")\n471\t\n472\t        game = _make_game()\n473\t        player = game.players[0]\n474\t        card = TrackedCreature(\n475\t            name=\"Tracked\",\n476\t            mana_cost=ManaCost(pips={ManaType.GREEN: 1}),\n477\t            base_power=1, base_toughness=1,\n478\t        )\n479\t        _add_to_hand(game, 0, card)\n480\t        _add_mana(player, ManaType.GREEN, 1)\n481\t\n482\t        cast_spell(game, player, card)\n483\t        assert on_cast_log == [\"on_cast\"]\n484\t\n485\t    def test_on_resolve_callback_is_called(self):\n486\t        on_resolve_log: list[str] = []\n487\t\n488\t        class TrackedInstant(Instant):\n489\t            def on_resolve(self, game: GameState) -> None:\n490\t                on_resolve_log.append(\"on_resolve\")\n491\t\n492\t        game = _make_game()\n493\t        player = game.players[0]\n494\t        card = TrackedInstant(\n495\t            name=\"Tracked\", mana_cost=ManaCost(pips={ManaType.RED: 1}),\n496\t        )\n497\t        _add_to_hand(game, 0, card)\n498\t        _add_mana(player, ManaType.RED, 1)\n499\t\n500\t        cast_spell(game, player, card)\n501\t        obj = game.stack.pop()\n502\t        obj.on_resolve(game)\n503\t\n504\t        assert on_resolve_log == [\"on_resolve\"]\n505\t\n506\t    def test_on_cast_called_before_push_to_stack(self):\n507\t        \"\"\"on_cast fires during cast_spell, before the StackObject is pushed.\"\"\"\n508\t        stack_was_empty_during_on_cast: list[bool] = []\n509\t\n510\t        class InspectorCreature(Creature):\n511\t            def on_cast(self, game: GameState) -> None:\n512\t                # At on_cast time the stack should still be empty\n513\t                # (StackObject push happens after on_cast)\n514\t                stack_was_empty_during_on_cast.append(game.stack.is_empty())\n515\t\n516\t        game = _make_game()\n517\t        player = game.players[0]\n518\t        card = InspectorCreature(\n519\t            name=\"Inspector\",\n520\t            mana_cost=ManaCost(pips={ManaType.GREEN: 1}),\n521\t            base_power=1, base_toughness=1,\n522\t        )\n523\t        _add_to_hand(game, 0, card)\n524\t        _add_mana(player, ManaType.GREEN, 1)\n525\t\n526\t        cast_spell(game, player, card)\n527\t        assert stack_was_empty_during_on_cast == [True]\n528\t\n529\t    def test_on_resolve_receives_game_state(self):\n530\t        \"\"\"on_resolve receives the game state so the card can interact with it.\"\"\"\n531\t        received_game: list[GameState | None] = []\n532\t\n533\t        class InspectorSorcery(Sorcery):\n534\t            def on_resolve(self, game: GameState) -> None:\n535\t                received_game.append(game)\n536\t\n537\t        game = _make_game()\n538\t        player = game.players[0]\n539\t        card = InspectorSorcery(\n540\t            name=\"Inspector\", mana_cost=ManaCost(pips={ManaType.BLUE: 1}),\n541\t        )\n542\t        _add_to_hand(game, 0, card)\n543\t        _add_mana(player, ManaType.BLUE, 1)\n544\t\n545\t        cast_spell(game, player, card)\n546\t        obj = game.stack.pop()\n547\t        obj.on_resolve(game)\n548\t\n549\t        assert received_game == [game]\n550\t\n551\t\n552\t# ---------------------------------------------------------------------------\n553\t# cast_spell — additional legality checks\n554\t# ---------------------------------------------------------------------------\n555\t\n556\tclass TestCastSpellLegality:\n557\t    \"\"\"Miscellaneous legality checks for cast_spell.\"\"\"\n558\t\n559\t    def test_card_not_in_hand_raises(self):\n560\t        game = _make_game()\n561\t        player = game.players[0]\n562\t        bear = Creature(\n563\t            name=\"Bear\", mana_cost=ManaCost(pips={ManaType.GREEN: 1}),\n564\t            base_power=2, base_toughness=2,\n565\t        )\n566\t        _add_mana(player, ManaType.GREEN, 1)\n567\t        # Card NOT added to hand\n568\t\n569\t        with pytest.raises(CastingError, match=\"card not in hand\"):\n570\t            cast_spell(game, player, bear)\n571\t\n572\t    def test_can_cast_returns_false_raises(self):\n573\t        \"\"\"Land.can_cast always returns False; trying to cast_spell should error.\"\"\"\n574\t        game = _make_game()\n575\t        player = game.players[0]\n576\t        land = Land(name=\"Forest\")\n577\t        _add_to_hand(game, 0, land)\n578\t\n579\t        with pytest.raises(CastingError, match=\"can_cast returned False\"):\n580\t            cast_spell(game, player, land)\n581\t\n582\t    def test_hand_unchanged_on_timing_failure(self):\n583\t        \"\"\"If timing check fails, card should remain in hand.\"\"\"\n584\t        game = _make_game(phase=Phase.COMBAT, step=Step.DECLARE_ATTACKERS)\n585\t        player = game.players[0]\n586\t        bear = Creature(\n587\t            name=\"Bear\", mana_cost=ManaCost(pips={ManaType.GREEN: 1}),\n588\t            base_power=2, base_toughness=2,\n589\t        )\n590\t        _add_to_hand(game, 0, bear)\n591\t        _add_mana(player, ManaType.GREEN, 1)\n592\t\n593\t        with pytest.raises(CastingError):\n594\t            cast_spell(game, player, bear)\n595\t\n596\t        # Card should still be in hand\n597\t        assert game.get_hand(player).contains(bear)\n598\t\n599\t    def test_stack_unchanged_on_failure(self):\n600\t        \"\"\"If cast fails, nothing is added to the stack.\"\"\"\n601\t        game = _make_game()\n602\t        player = game.players[0]\n603\t        bear = Creature(\n604\t            name=\"Bear\",\n605\t            mana_cost=ManaCost(generic=5, pips={ManaType.GREEN: 1}),\n606\t            base_power=2, base_toughness=2,\n607\t        )\n608\t        _add_to_hand(game, 0, bear)\n609\t        # Insufficient mana\n610\t        _add_mana(player, ManaType.GREEN, 1)\n611\t\n612\t        with pytest.raises(CastingError):\n613\t            cast_spell(game, player, bear)\n614\t\n615\t        assert game.stack.is_empty()\n616\t\n617\t\n618\t# ---------------------------------------------------------------------------\n619\t# play_land tests\n620\t# ---------------------------------------------------------------------------\n621\t\n622\tclass TestPlayLand:\n623\t    \"\"\"Requirement: play_land moves land hand→battlefield, decrements counter.\"\"\"\n624\t\n625\t    def test_valid_land_play_moves_to_battlefield(self):\n626\t        game = _make_game()\n627\t        player = game.players[0]\n628\t        forest = Land(name=\"Forest\")\n629\t        _add_to_hand(game, 0, forest)\n630\t\n631\t        play_land(game, player, forest)\n632\t        assert game.get_battlefield(player).contains(forest)\n633\t\n634\t    def test_valid_land_play_removes_from_hand(self):\n635\t        game = _make_game()\n636\t        player = game.players[0]\n637\t        forest = Land(name=\"Forest\")\n638\t        _add_to_hand(game, 0, forest)\n639\t\n640\t        play_land(game, player, forest)\n641\t        assert not game.get_hand(player).contains(forest)\n642\t\n643\t    def test_valid_land_play_decrements_remaining(self):\n644\t        game = _make_game()\n645\t        player = game.players[0]\n646\t        forest = Land(name=\"Forest\")\n647\t        _add_to_hand(game, 0, forest)\n648\t        assert player.land_plays_remaining == 1\n649\t\n650\t        play_land(game, player, forest)\n651\t        assert player.land_plays_remaining == 0\n652\t\n653\t    def test_land_play_postcombat_main_succeeds(self):\n654\t        game = _make_game(phase=Phase.POSTCOMBAT_MAIN)\n655\t        player = game.players[0]\n656\t        island = Land(name=\"Island\")\n657\t        _add_to_hand(game, 0, island)\n658\t\n659\t        play_land(game, player, island)\n660\t        assert game.get_battlefield(player).contains(island)\n661\t\n662\t    def test_second_land_play_when_remaining_zero_raises(self):\n663\t        \"\"\"After playing one land (remaining=0), second play raises CastingError.\"\"\"\n664\t        game = _make_game()\n665\t        player = game.players[0]\n666\t        f1 = Land(name=\"Forest\")\n667\t        f2 = Land(name=\"Forest\")\n668\t        _add_to_hand(game, 0, f1)\n669\t        _add_to_hand(game, 0, f2)\n670\t\n671\t        play_land(game, player, f1)\n672\t        assert player.land_plays_remaining == 0\n673\t\n674\t        with pytest.raises(CastingError, match=\"no land plays remaining\"):\n675\t            play_land(game, player, f2)\n676\t\n677\t    def test_remaining_already_zero_raises(self):\n678\t        \"\"\"If remaining=0 from the start, playing a land raises CastingError.\"\"\"\n679\t        game = _make_game()\n680\t        player = game.players[0]\n681\t        player.land_plays_remaining = 0\n682\t        forest = Land(name=\"Forest\")\n683\t        _add_to_hand(game, 0, forest)\n684\t\n685\t        with pytest.raises(CastingError, match=\"no land plays remaining\"):\n686\t            play_land(game, player, forest)\n687\t\n688\t    def test_land_during_combat_phase_raises(self):\n689\t        \"\"\"Cannot play a land during combat — must be main phase.\"\"\"\n690\t        game = _make_game(phase=Phase.COMBAT, step=Step.DECLARE_ATTACKERS)\n691\t        player = game.players[0]\n692\t        forest = Land(name=\"Forest\")\n693\t        _add_to_hand(game, 0, forest)\n694\t\n695\t        with pytest.raises(CastingError):\n696\t            play_land(game, player, forest)\n697\t\n698\t    def test_land_during_beginning_phase_raises(self):\n699\t        \"\"\"Cannot play a land during upkeep — must be main phase.\"\"\"\n700\t        game = _make_game(phase=Phase.BEGINNING, step=Step.UPKEEP)\n701\t        player = game.players[0]\n702\t        forest = Land(name=\"Forest\")\n703\t        _add_to_hand(game, 0, forest)\n704\t\n705\t        with pytest.raises(CastingError):\n706\t            play_land(game, player, forest)\n707\t\n708\t    def test_land_by_non_active_player_raises(self):\n709\t        \"\"\"Non-active player cannot play a land.\"\"\"\n710\t        game = _make_game()\n711\t        non_active = game.players[1]\n712\t        forest = Land(name=\"Forest\")\n713\t        _add_to_hand(game, 1, forest)\n714\t\n715\t        with pytest.raises(CastingError):\n716\t            play_land(game, non_active, forest)\n717\t\n718\t    def test_land_with_nonempty_stack_raises(self):\n719\t        \"\"\"Cannot play a land when the stack is non-empty.\"\"\"\n720\t        game = _make_game()\n721\t        player = game.players[0]\n722\t        dummy = StackObject(source=None, controller=player)\n723\t        game.stack.push(dummy)\n724\t\n725\t        forest = Land(name=\"Forest\")\n726\t        _add_to_hand(game, 0, forest)\n727\t\n728\t        with pytest.raises(CastingError):\n729\t            play_land(game, player, forest)\n730\t\n731\t    def test_non_land_card_raises(self):\n732\t        \"\"\"play_land rejects a card that isn't a land.\"\"\"\n733\t        game = _make_game()\n734\t        player = game.players[0]\n735\t        creature = Creature(name=\"Bear\", base_power=2, base_toughness=2)\n736\t        _add_to_hand(game, 0, creature)\n737\t\n738\t        with pytest.raises(CastingError, match=\"not a land card\"):\n739\t            play_land(game, player, creature)\n740\t\n741\t    def test_land_not_in_hand_raises(self):\n742\t        \"\"\"Cannot play a land that's not in hand.\"\"\"\n743\t        game = _make_game()\n744\t        player = game.players[0]\n745\t        forest = Land(name=\"Forest\")\n746\t        # NOT added to hand\n747\t\n748\t        with pytest.raises(CastingError, match=\"card not in hand\"):\n749\t            play_land(game, player, forest)\n750\t\n751\t    def test_extra_land_with_increased_limit(self):\n752\t        \"\"\"If land_plays_remaining is 2 (e.g. Exploration), two lands are allowed.\"\"\"\n753\t        game = _make_game()\n754\t        player = game.players[0]\n755\t        player.land_plays_remaining = 2\n756\t        f1 = Land(name=\"Forest\")\n757\t        f2 = Land(name=\"Forest\")\n758\t        _add_to_hand(game, 0, f1)\n759\t        _add_to_hand(game, 0, f2)\n760\t\n761\t        play_land(game, player, f1)\n762\t        assert player.land_plays_remaining == 1\n763\t\n764\t        play_land(game, player, f2)\n765\t        assert player.land_plays_remaining == 0\n766\t        assert game.get_battlefield(player).contains(f1)\n767\t        assert game.get_battlefield(player).contains(f2)\n768\t\n769\t    def test_land_does_not_use_stack(self):\n770\t        \"\"\"Playing a land is a special action — it should not go through the stack.\"\"\"\n771\t        game = _make_game()\n772\t        player = game.players[0]\n773\t        forest = Land(name=\"Forest\")\n774\t        _add_to_hand(game, 0, forest)\n775\t\n776\t        play_land(game, player, forest)\n777\t        assert game.stack.is_empty()\n778\t\n779\t\n780\t# ---------------------------------------------------------------------------\n781\t# Permanent type detection\n782\t# ---------------------------------------------------------------------------\n783\t\n784\tclass TestPermanentTypes:\n785\t    \"\"\"Verify _PERMANENT_TYPES covers exactly creature, enchantment, artifact, planeswalker.\"\"\"\n786\t\n787\t    def test_creature_is_permanent(self):\n788\t        assert CardType.CREATURE in _PERMANENT_TYPES\n789\t\n790\t    def test_enchantment_is_permanent(self):\n791\t        assert CardType.ENCHANTMENT in _PERMANENT_TYPES\n792\t\n793\t    def test_artifact_is_permanent(self):\n794\t        assert CardType.ARTIFACT in _PERMANENT_TYPES\n795\t\n796\t    def test_planeswalker_is_permanent(self):\n797\t        assert CardType.PLANESWALKER in _PERMANENT_TYPES\n798\t\n799\t    def test_instant_is_not_permanent(self):\n800\t        assert CardType.INSTANT not in _PERMANENT_TYPES\n801\t\n802\t    def test_sorcery_is_not_permanent(self):\n803\t        assert CardType.SORCERY not in _PERMANENT_TYPES\n804\t\n805\t    def test_land_is_not_in_permanent_types(self):\n806\t        assert CardType.LAND not in _PERMANENT_TYPES\n807\t\n808\t\n809\t# ---------------------------------------------------------------------------\n810\t# Resolution: additional permanent subtypes\n811\t# ---------------------------------------------------------------------------\n812\t\n813\tclass TestResolveOtherPermanents:\n814\t    \"\"\"Enchantments, artifacts, planeswalkers, artifact creatures → battlefield.\"\"\"\n815\t\n816\t    def test_enchantment_resolves_to_battlefield(self):\n817\t        game = _make_game()\n818\t        player = game.players[0]\n819\t        ench = Enchantment(name=\"Pac\", mana_cost=ManaCost(pips={ManaType.WHITE: 1}))\n820\t        _add_to_hand(game, 0, ench)\n821\t        _add_mana(player, ManaType.WHITE, 1)\n822\t\n823\t        cast_spell(game, player, ench)\n824\t        obj = game.stack.pop()\n825\t        obj.on_resolve(game)\n826\t\n827\t        assert game.get_battlefield(player).contains(ench)\n828\t\n829\t    def test_artifact_resolves_to_battlefield(self):\n830\t        game = _make_game()\n831\t        player = game.players[0]\n832\t        art = Artifact(name=\"Sol Ring\", mana_cost=ManaCost(generic=1))\n833\t        _add_to_hand(game, 0, art)\n834\t        _add_mana(player, ManaType.COLORLESS, 1)\n835\t\n836\t        cast_spell(game, player, art)\n837\t        obj = game.stack.pop()\n838\t        obj.on_resolve(game)\n839\t\n840\t        assert game.get_battlefield(player).contains(art)\n841\t\n842\t    def test_planeswalker_resolves_to_battlefield(self):\n843\t        game = _make_game()\n844\t        player = game.players[0]\n845\t        pw = Planeswalker(\n846\t            name=\"Jace\",\n847\t            mana_cost=ManaCost(generic=2, pips={ManaType.BLUE: 2}),\n848\t            starting_loyalty=3,\n849\t        )\n850\t        _add_to_hand(game, 0, pw)\n851\t        _add_mana(player, ManaType.BLUE, 4)\n852\t\n853\t        cast_spell(game, player, pw)\n854\t        obj = game.stack.pop()\n855\t        obj.on_resolve(game)\n856\t\n857\t        assert game.get_battlefield(player).contains(pw)\n858\t\n859\t    def test_artifact_creature_resolves_to_battlefield(self):\n860\t        game = _make_game()\n861\t        player = game.players[0]\n862\t        ac = ArtifactCreature(\n863\t            name=\"Ornithopter\", mana_cost=ManaCost(), base_power=0, base_toughness=2,\n864\t        )\n865\t        _add_to_hand(game, 0, ac)\n866\t\n867\t        cast_spell(game, player, ac)\n868\t        obj = game.stack.pop()\n869\t        obj.on_resolve(game)\n870\t\n871\t        assert game.get_battlefield(player).contains(ac)\n872\t\n873\t\n874\t# ---------------------------------------------------------------------------\n875\t# Integration: multi-spell stack LIFO ordering\n876\t# ---------------------------------------------------------------------------\n877\t\n878\tclass TestCastResolveIntegration:\n879\t    \"\"\"End-to-end integration tests for stack interaction.\"\"\"\n880\t\n881\t    def test_multiple_spells_resolve_lifo(self):\n882\t        \"\"\"Two instants on the stack resolve in LIFO order.\"\"\"\n883\t        game = _make_game()\n884\t        player = game.players[0]\n885\t\n886\t        bolt1 = Instant(name=\"Bolt 1\", mana_cost=ManaCost(pips={ManaType.RED: 1}))\n887\t        bolt2 = Instant(name=\"Bolt 2\", mana_cost=ManaCost(pips={ManaType.RED: 1}))\n888\t        _add_to_hand(game, 0, bolt1)\n889\t        _add_to_hand(game, 0, bolt2)\n890\t        _add_mana(player, ManaType.RED, 2)\n891\t\n892\t        cast_spell(game, player, bolt1)\n893\t        cast_spell(game, player, bolt2)\n894\t\n895\t        top = game.stack.pop()\n896\t        assert top.source is bolt2\n897\t        top.on_resolve(game)\n898\t\n899\t        next_obj = game.stack.pop()\n900\t        assert next_obj.source is bolt1\n901\t        next_obj.on_resolve(game)\n902\t\n903\t        assert game.get_graveyard(player).contains(bolt1)\n904\t        assert game.get_graveyard(player).contains(bolt2)\n905\t\n906\t    def test_cast_creature_full_lifecycle(self):\n907\t        \"\"\"Full lifecycle: hand → cast → stack → resolve → battlefield.\"\"\"\n908\t        game = _make_game()\n909\t        player = game.players[0]\n910\t        bear = Creature(\n911\t            name=\"Bear\",\n912\t            mana_cost=ManaCost(generic=1, pips={ManaType.GREEN: 1}),\n913\t            base_power=2, base_toughness=2,\n914\t        )\n915\t        _add_to_hand(game, 0, bear)\n916\t        _add_mana(player, ManaType.GREEN, 2)\n917\t\n918\t        # 1. In hand\n919\t        assert game.get_hand(player).contains(bear)\n920\t        # 2. Cast\n921\t        cast_spell(game, player, bear)\n922\t        assert not game.get_hand(player).contains(bear)\n923\t        assert len(game.stack.objects()) == 1\n924\t        # 3. Resolve\n925\t        obj = game.stack.pop()\n926\t        obj.on_resolve(game)\n927\t        assert game.stack.is_empty()\n928\t        assert game.get_battlefield(player).contains(bear)\n929\t\n930\t    def test_cast_with_targets_passes_to_stack_object(self):\n931\t        \"\"\"Targets chosen during casting are stored in the StackObject.\"\"\"\n932\t\n933\t        class TargetedBolt(Instant):\n934\t            def get_targets(self, game: GameState):\n935\t                return [\"spec_a\"]\n936\t\n937\t        game = _make_game(p1_script=[\"target_creature\"])\n938\t        player = game.players[0]\n939\t        card = TargetedBolt(name=\"Bolt\", mana_cost=ManaCost(pips={ManaType.RED: 1}))\n940\t        _add_to_hand(game, 0, card)\n941\t        _add_mana(player, ManaType.RED, 1)\n942\t\n943\t        cast_spell(game, player, card)\n944\t        top = game.stack.peek()\n945\t        assert top.targets == [\"target_creature\"]\n946\t"}]},"parent_tool_use_id":"toolu_01M6QwNHGRh57GZfrPn9to8x","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"21076850-c9ec-475f-8e42-adca4b443a36","timestamp":"2026-06-01T23:41:23.078Z","subagent_type":"Tester","task_description":"Write tests for sos_1"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CV4Pqqk32UvD1D9pkTHAof","type":"tool_result","content":"1\t\"\"\"Tests for engine/triggers.py — Triggered abilities system.\n2\t\n3\tVerifies:\n4\t- EventType enum members and values.\n5\t- TriggerRegistration dataclass construction and fields.\n6\t- TriggerManager register/unregister/get_triggers/get_triggers_for_source/clear.\n7\t- TriggerManager.fire_event pushes StackObjects for matching triggers.\n8\t- fire_event with non-matching event type → nothing pushed.\n9\t- Condition filtering: triggers only fire when condition returns True.\n10\t- Condition filtering: triggers do NOT fire when condition returns False.\n11\t- fire_event data parameter passed to condition.\n12\t- APNAP ordering: active player triggers pushed first (bottom), non-active on top.\n13\t- Registration-order preserved within same player.\n14\t- Unregister removes all triggers for a source (identity-based).\n15\t- Integration: GameState.trigger_manager is TriggerManager instance.\n16\t- ETB scenario: card enters battlefield → register_triggers → fire event → StackObject.\n17\t- Unregister on leave → fire event → nothing.\n18\t- Multiple triggers from different sources for same event → all pushed.\n19\t- Data dict forwarded to condition callable.\n20\t\"\"\"\n21\tfrom __future__ import annotations\n22\timport pytest\n23\tfrom engine.card import CardImpl, Creature\n24\tfrom engine.game_state import GameState\n25\tfrom engine.player import DeterministicPlayer\n26\tfrom engine.stack import StackObject\n27\tfrom engine.triggers import TriggerManager, TriggerRegistration\n28\tfrom engine.types import Zone\n29\tfrom engine.events import AttacksTriggeredEvent, BeginningOfUpkeepTriggeredEvent, CreatureDiesTriggeredEvent, DealsDamageTriggeredEvent, EndOfTurnTriggeredEvent, EntersBattlefieldTriggeredEvent, GainsLifeTriggeredEvent, SpellCastTriggeredEvent\n30\t\n31\t@pytest.fixture()\n32\tdef players() -> list[DeterministicPlayer]:\n33\t    \"\"\"Create two DeterministicPlayers.\"\"\"\n34\t    return [DeterministicPlayer('Alice', script=[]), DeterministicPlayer('Bob', script=[])]\n35\t\n36\t@pytest.fixture()\n37\tdef game(players: list[DeterministicPlayer]) -> GameState:\n38\t    \"\"\"Create a GameState with two players.\"\"\"\n39\t    return GameState(players)\n40\t\n41\tdef _make_trigger(event_type: type, source: object, controller: DeterministicPlayer, *, condition=None, effect=None) -> TriggerRegistration:\n42\t    \"\"\"Convenience to build a TriggerRegistration with sensible defaults.\"\"\"\n43\t    return TriggerRegistration(event_type=event_type, condition=condition, effect=effect or (lambda g: None), source=source, controller=controller)\n44\t\n45\tclass TestTriggerRegistration:\n46\t    \"\"\"TriggerRegistration dataclass stores all fields correctly.\"\"\"\n47\t\n48\t    def test_construction_with_all_fields(self, players: list[DeterministicPlayer]) -> None:\n49\t        \"\"\"All five required fields are stored on construction.\"\"\"\n50\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n51\t        cond = lambda g, d: True\n52\t        effect = lambda g: None\n53\t        reg = TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=cond, effect=effect, source=source, controller=players[0])\n54\t        assert reg.event_type is EntersBattlefieldTriggeredEvent\n55\t        assert reg.condition is cond\n56\t        assert reg.effect is effect\n57\t        assert reg.source is source\n58\t        assert reg.controller is players[0]\n59\t\n60\t    def test_condition_none_allowed(self, players: list[DeterministicPlayer]) -> None:\n61\t        \"\"\"condition=None means 'always fires for event type'.\"\"\"\n62\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n63\t        reg = TriggerRegistration(event_type=CreatureDiesTriggeredEvent, condition=None, effect=lambda g: None, source=source, controller=players[0])\n64\t        assert reg.condition is None\n65\t\n66\t    def test_source_can_be_any_object(self, players: list[DeterministicPlayer]) -> None:\n67\t        \"\"\"source field accepts any game object (not just Creature).\"\"\"\n68\t        source = object()\n69\t        reg = _make_trigger(SpellCastTriggeredEvent, source, players[0])\n70\t        assert reg.source is source\n71\t\n72\tclass TestTriggerManagerBasic:\n73\t    \"\"\"TriggerManager register, unregister, get_triggers, get_triggers_for_source, clear.\"\"\"\n74\t\n75\t    def test_initial_empty(self) -> None:\n76\t        \"\"\"A new TriggerManager has no triggers.\"\"\"\n77\t        tm = TriggerManager()\n78\t        assert tm.get_triggers() == []\n79\t\n80\t    def test_register_adds_trigger(self, players: list[DeterministicPlayer]) -> None:\n81\t        \"\"\"register() should add the trigger to the internal list.\"\"\"\n82\t        tm = TriggerManager()\n83\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n84\t        reg = _make_trigger(EntersBattlefieldTriggeredEvent, source, players[0])\n85\t        tm.register(reg)\n86\t        assert len(tm.get_triggers()) == 1\n87\t        assert tm.get_triggers()[0] is reg\n88\t\n89\t    def test_register_multiple_triggers(self, players: list[DeterministicPlayer]) -> None:\n90\t        \"\"\"Multiple registrations should accumulate.\"\"\"\n91\t        tm = TriggerManager()\n92\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n93\t        r1 = _make_trigger(EntersBattlefieldTriggeredEvent, source, players[0])\n94\t        r2 = _make_trigger(CreatureDiesTriggeredEvent, source, players[0])\n95\t        tm.register(r1)\n96\t        tm.register(r2)\n97\t        assert len(tm.get_triggers()) == 2\n98\t\n99\t    def test_get_triggers_returns_copy(self, players: list[DeterministicPlayer]) -> None:\n100\t        \"\"\"get_triggers() should return a shallow copy — mutating it does not affect the manager.\"\"\"\n101\t        tm = TriggerManager()\n102\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n103\t        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, source, players[0]))\n104\t        copy = tm.get_triggers()\n105\t        copy.clear()\n106\t        assert len(tm.get_triggers()) == 1\n107\t\n108\tclass TestTriggerManagerUnregister:\n109\t    \"\"\"Unregister removes all triggers for a given source object.\"\"\"\n110\t\n111\t    def test_unregister_removes_all_triggers_for_source(self, players: list[DeterministicPlayer]) -> None:\n112\t        \"\"\"unregister(source) should remove every trigger whose source is that object.\"\"\"\n113\t        tm = TriggerManager()\n114\t        bear = Creature(name='Bear', owner=players[0], controller=players[0])\n115\t        elf = Creature(name='Elf', owner=players[0], controller=players[0])\n116\t        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, bear, players[0]))\n117\t        tm.register(_make_trigger(CreatureDiesTriggeredEvent, bear, players[0]))\n118\t        tm.register(_make_trigger(AttacksTriggeredEvent, elf, players[0]))\n119\t        tm.unregister(bear)\n120\t        remaining = tm.get_triggers()\n121\t        assert len(remaining) == 1\n122\t        assert remaining[0].source is elf\n123\t\n124\t    def test_unregister_is_identity_based(self, players: list[DeterministicPlayer]) -> None:\n125\t        \"\"\"Unregister uses `is` (identity), not `==` (equality).\"\"\"\n126\t        tm = TriggerManager()\n127\t        bear1 = Creature(name='Bear', owner=players[0], controller=players[0])\n128\t        bear2 = Creature(name='Bear', owner=players[0], controller=players[0])\n129\t        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, bear1, players[0]))\n130\t        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, bear2, players[0]))\n131\t        tm.unregister(bear1)\n132\t        assert len(tm.get_triggers()) == 1\n133\t        assert tm.get_triggers()[0].source is bear2\n134\t\n135\t    def test_unregister_nonexistent_source_is_noop(self) -> None:\n136\t        \"\"\"Unregistering a source with no triggers should not raise.\"\"\"\n137\t        tm = TriggerManager()\n138\t        tm.unregister(object())\n139\t        assert tm.get_triggers() == []\n140\t\n141\t    def test_unregister_leaves_other_sources_intact(self, players: list[DeterministicPlayer]) -> None:\n142\t        \"\"\"After unregister, triggers from other sources must remain.\"\"\"\n143\t        tm = TriggerManager()\n144\t        bear = Creature(name='Bear', owner=players[0], controller=players[0])\n145\t        elf = Creature(name='Elf', owner=players[1], controller=players[1])\n146\t        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, bear, players[0]))\n147\t        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, elf, players[1]))\n148\t        tm.unregister(bear)\n149\t        assert len(tm.get_triggers()) == 1\n150\t        assert tm.get_triggers()[0].source is elf\n151\t\n152\tclass TestTriggerManagerGetTriggersForSource:\n153\t    \"\"\"get_triggers_for_source filters by source identity.\"\"\"\n154\t\n155\t    def test_returns_only_matching_source(self, players: list[DeterministicPlayer]) -> None:\n156\t        tm = TriggerManager()\n157\t        bear = Creature(name='Bear', owner=players[0], controller=players[0])\n158\t        elf = Creature(name='Elf', owner=players[0], controller=players[0])\n159\t        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, bear, players[0]))\n160\t        tm.register(_make_trigger(CreatureDiesTriggeredEvent, bear, players[0]))\n161\t        tm.register(_make_trigger(AttacksTriggeredEvent, elf, players[0]))\n162\t        bear_triggers = tm.get_triggers_for_source(bear)\n163\t        assert len(bear_triggers) == 2\n164\t        assert all((t.source is bear for t in bear_triggers))\n165\t\n166\t    def test_returns_empty_for_unknown_source(self) -> None:\n167\t        tm = TriggerManager()\n168\t        assert tm.get_triggers_for_source(object()) == []\n169\t\n170\tclass TestTriggerManagerClear:\n171\t    \"\"\"clear() removes all triggers.\"\"\"\n172\t\n173\t    def test_clear_empties_all(self, players: list[DeterministicPlayer]) -> None:\n174\t        tm = TriggerManager()\n175\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n176\t        tm.register(_make_trigger(EntersBattlefieldTriggeredEvent, source, players[0]))\n177\t        tm.register(_make_trigger(CreatureDiesTriggeredEvent, source, players[0]))\n178\t        tm.clear()\n179\t        assert tm.get_triggers() == []\n180\t\n181\tclass TestFireEvent:\n182\t    \"\"\"fire_event pushes matching triggers onto the game stack.\"\"\"\n183\t\n184\t    def test_matching_trigger_pushes_stack_object(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n185\t        \"\"\"A registered ETB trigger fires when ENTERS_BATTLEFIELD is fired.\"\"\"\n186\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n187\t        game.trigger_manager.register(_make_trigger(EntersBattlefieldTriggeredEvent, source, players[0]))\n188\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n189\t        assert not game.stack.is_empty()\n190\t        stack_obj = game.stack.peek()\n191\t        assert isinstance(stack_obj, StackObject)\n192\t        assert stack_obj.source is source\n193\t        assert stack_obj.controller is players[0]\n194\t\n195\t    def test_stack_object_on_resolve_invokes_effect(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n196\t        \"\"\"The StackObject's on_resolve should call the trigger's effect callback.\"\"\"\n197\t        calls: list[str] = []\n198\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n199\t        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=None, effect=lambda g: calls.append('resolved'), source=source, controller=players[0]))\n200\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n201\t        stack_obj = game.stack.pop()\n202\t        stack_obj.on_resolve(game)\n203\t        assert calls == ['resolved']\n204\t\n205\t    def test_non_matching_event_type_pushes_nothing(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n206\t        \"\"\"Firing a different event type should not push any StackObject.\"\"\"\n207\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n208\t        game.trigger_manager.register(_make_trigger(EntersBattlefieldTriggeredEvent, source, players[0]))\n209\t        game.trigger_manager.fire_event(game, CreatureDiesTriggeredEvent())\n210\t        assert game.stack.is_empty()\n211\t\n212\t    def test_no_registered_triggers_pushes_nothing(self, game: GameState) -> None:\n213\t        \"\"\"Firing an event with no registered triggers should leave the stack empty.\"\"\"\n214\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n215\t        assert game.stack.is_empty()\n216\t\n217\t    def test_condition_true_fires_trigger(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n218\t        \"\"\"When condition returns True, the trigger should fire.\"\"\"\n219\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n220\t        game.trigger_manager.register(TriggerRegistration(event_type=DealsDamageTriggeredEvent, condition=lambda g, event: True, effect=lambda g: None, source=source, controller=players[0]))\n221\t        game.trigger_manager.fire_event(game, DealsDamageTriggeredEvent(amount=3))\n222\t        assert not game.stack.is_empty()\n223\t\n224\t    def test_condition_false_does_not_fire_trigger(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n225\t        \"\"\"When condition returns False, the trigger should NOT fire.\"\"\"\n226\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n227\t        game.trigger_manager.register(TriggerRegistration(event_type=DealsDamageTriggeredEvent, condition=lambda g, event: False, effect=lambda g: None, source=source, controller=players[0]))\n228\t        game.trigger_manager.fire_event(game, DealsDamageTriggeredEvent(amount=3))\n229\t        assert game.stack.is_empty()\n230\t\n231\t    def test_condition_none_always_fires(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n232\t        \"\"\"A trigger with condition=None should always fire for matching event.\"\"\"\n233\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n234\t        game.trigger_manager.register(_make_trigger(GainsLifeTriggeredEvent, source, players[0], condition=None))\n235\t        game.trigger_manager.fire_event(game, GainsLifeTriggeredEvent())\n236\t        assert not game.stack.is_empty()\n237\t\n238\t    def test_condition_receives_data_dict(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n239\t        \"\"\"The condition callable should receive (game, event) where event is the typed event object.\"\"\"\n240\t        received_args: list[tuple] = []\n241\t\n242\t        def cond(g, e):\n243\t            received_args.append((g, e))\n244\t            return True\n245\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n246\t        game.trigger_manager.register(TriggerRegistration(event_type=DealsDamageTriggeredEvent, condition=cond, effect=lambda g: None, source=source, controller=players[0]))\n247\t        event = DealsDamageTriggeredEvent(amount=5)\n248\t        game.trigger_manager.fire_event(game, event)\n249\t        assert len(received_args) == 1\n250\t        assert received_args[0][0] is game\n251\t        assert received_args[0][1] is event\n252\t\n253\t    def test_fire_event_without_data_passes_empty_dict(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n254\t        \"\"\"Calling fire_event passes the typed event object to condition.\"\"\"\n255\t        received_data: list = []\n256\t\n257\t        def cond(g, e):\n258\t            received_data.append(e)\n259\t            return True\n260\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n261\t        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=cond, effect=lambda g: None, source=source, controller=players[0]))\n262\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n263\t        assert len(received_data) == 1\n264\t        assert isinstance(received_data[0], EntersBattlefieldTriggeredEvent)\n265\t\n266\t    def test_multiple_triggers_same_event_all_pushed(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n267\t        \"\"\"Three triggers for the same event → three StackObjects pushed.\"\"\"\n268\t        sources = []\n269\t        for i in range(3):\n270\t            src = Creature(name=f'Bear{i}', owner=players[0], controller=players[0])\n271\t            sources.append(src)\n272\t            game.trigger_manager.register(_make_trigger(EntersBattlefieldTriggeredEvent, src, players[0]))\n273\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n274\t        assert len(game.stack.objects()) == 3\n275\t\n276\t    def test_mixed_matching_and_nonmatching_only_matching_pushed(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n277\t        \"\"\"Only triggers matching the fired event type should be pushed.\"\"\"\n278\t        src_etb = Creature(name='ETB', owner=players[0], controller=players[0])\n279\t        src_die = Creature(name='DIE', owner=players[0], controller=players[0])\n280\t        game.trigger_manager.register(_make_trigger(EntersBattlefieldTriggeredEvent, src_etb, players[0]))\n281\t        game.trigger_manager.register(_make_trigger(CreatureDiesTriggeredEvent, src_die, players[0]))\n282\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n283\t        assert len(game.stack.objects()) == 1\n284\t        assert game.stack.peek().source is src_etb\n285\t\n286\t    def test_condition_uses_data_to_filter(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n287\t        \"\"\"Condition can inspect data dict to decide whether to fire.\"\"\"\n288\t        source = Creature(name='Lifelinker', owner=players[0], controller=players[0])\n289\t        game.trigger_manager.register(TriggerRegistration(event_type=GainsLifeTriggeredEvent, condition=lambda g, event: event.amount >= 5, effect=lambda g: None, source=source, controller=players[0]))\n290\t        game.trigger_manager.fire_event(game, GainsLifeTriggeredEvent(amount=3))\n291\t        assert game.stack.is_empty()\n292\t        game.trigger_manager.fire_event(game, GainsLifeTriggeredEvent(amount=5))\n293\t        assert not game.stack.is_empty()\n294\t\n295\tclass TestAPNAPOrdering:\n296\t    \"\"\"APNAP: Active player's triggers pushed first (bottom), non-active player's on top.\"\"\"\n297\t\n298\t    def test_active_player_triggers_at_bottom_non_active_on_top(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n299\t        \"\"\"Active player's triggers end up at the bottom of the stack batch;\n300\t        non-active player's triggers are on top (resolve first).\"\"\"\n301\t        active = players[game.active_player_index]\n302\t        non_active = players[1 - game.active_player_index]\n303\t        active_src = Creature(name='A', owner=active, controller=active)\n304\t        nap_src = Creature(name='N', owner=non_active, controller=non_active)\n305\t        game.trigger_manager.register(_make_trigger(BeginningOfUpkeepTriggeredEvent, active_src, active))\n306\t        game.trigger_manager.register(_make_trigger(BeginningOfUpkeepTriggeredEvent, nap_src, non_active))\n307\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n308\t        stack_objs = game.stack.objects()\n309\t        assert len(stack_objs) == 2\n310\t        assert stack_objs[0].controller is non_active\n311\t        assert stack_objs[1].controller is active\n312\t\n313\t    def test_apnap_ordering_regardless_of_registration_order(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n314\t        \"\"\"APNAP ordering should hold even if non-active player's trigger is registered first.\"\"\"\n315\t        active = players[game.active_player_index]\n316\t        non_active = players[1 - game.active_player_index]\n317\t        active_src = Creature(name='A', owner=active, controller=active)\n318\t        nap_src = Creature(name='N', owner=non_active, controller=non_active)\n319\t        game.trigger_manager.register(_make_trigger(EndOfTurnTriggeredEvent, nap_src, non_active))\n320\t        game.trigger_manager.register(_make_trigger(EndOfTurnTriggeredEvent, active_src, active))\n321\t        game.trigger_manager.fire_event(game, EndOfTurnTriggeredEvent())\n322\t        stack_objs = game.stack.objects()\n323\t        assert len(stack_objs) == 2\n324\t        assert stack_objs[0].controller is non_active\n325\t        assert stack_objs[1].controller is active\n326\t\n327\t    def test_registration_order_preserved_within_same_player(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n328\t        \"\"\"Triggers from the same player maintain registration order (pushed in that order).\"\"\"\n329\t        active = players[game.active_player_index]\n330\t        src1 = Creature(name='First', owner=active, controller=active)\n331\t        src2 = Creature(name='Second', owner=active, controller=active)\n332\t        game.trigger_manager.register(_make_trigger(BeginningOfUpkeepTriggeredEvent, src1, active))\n333\t        game.trigger_manager.register(_make_trigger(BeginningOfUpkeepTriggeredEvent, src2, active))\n334\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n335\t        stack_objs = game.stack.objects()\n336\t        assert len(stack_objs) == 2\n337\t        assert stack_objs[0].source is src2\n338\t        assert stack_objs[1].source is src1\n339\t\n340\t    def test_apnap_with_multiple_triggers_per_player(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n341\t        \"\"\"With multiple triggers per player, all active player's come before non-active's.\"\"\"\n342\t        active = players[game.active_player_index]\n343\t        non_active = players[1 - game.active_player_index]\n344\t        a1 = Creature(name='A1', owner=active, controller=active)\n345\t        a2 = Creature(name='A2', owner=active, controller=active)\n346\t        n1 = Creature(name='N1', owner=non_active, controller=non_active)\n347\t        n2 = Creature(name='N2', owner=non_active, controller=non_active)\n348\t        game.trigger_manager.register(_make_trigger(EndOfTurnTriggeredEvent, a1, active))\n349\t        game.trigger_manager.register(_make_trigger(EndOfTurnTriggeredEvent, n1, non_active))\n350\t        game.trigger_manager.register(_make_trigger(EndOfTurnTriggeredEvent, a2, active))\n351\t        game.trigger_manager.register(_make_trigger(EndOfTurnTriggeredEvent, n2, non_active))\n352\t        game.trigger_manager.fire_event(game, EndOfTurnTriggeredEvent())\n353\t        stack_objs = game.stack.objects()\n354\t        assert len(stack_objs) == 4\n355\t        assert stack_objs[0].controller is non_active\n356\t        assert stack_objs[1].controller is non_active\n357\t        assert stack_objs[2].controller is active\n358\t        assert stack_objs[3].controller is active\n359\t\n360\tclass TestGameStateIntegration:\n361\t    \"\"\"GameState has a trigger_manager attribute.\"\"\"\n362\t\n363\t    def test_game_state_has_trigger_manager(self, game: GameState) -> None:\n364\t        \"\"\"GameState should have a trigger_manager attribute that is a TriggerManager.\"\"\"\n365\t        assert hasattr(game, 'trigger_manager')\n366\t        assert isinstance(game.trigger_manager, TriggerManager)\n367\t\n368\t    def test_trigger_manager_starts_empty(self, game: GameState) -> None:\n369\t        \"\"\"A fresh GameState's trigger_manager should have no registered triggers.\"\"\"\n370\t        assert game.trigger_manager.get_triggers() == []\n371\t\n372\t    def test_trigger_manager_usable_via_game_state(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n373\t        \"\"\"Triggers registered via game.trigger_manager should fire via game.trigger_manager.\"\"\"\n374\t        source = Creature(name='Bear', owner=players[0], controller=players[0])\n375\t        game.trigger_manager.register(_make_trigger(EntersBattlefieldTriggeredEvent, source, players[0]))\n376\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n377\t        assert not game.stack.is_empty()\n378\t\n379\tclass TestETBIntegration:\n380\t    \"\"\"End-to-end: card with ETB trigger → battlefield → fire event → StackObject.\"\"\"\n381\t\n382\t    def test_etb_trigger_full_flow(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n383\t        \"\"\"Simulate: card enters battlefield, registers trigger, fire ETB, verify StackObject, resolve.\"\"\"\n384\t        etb_resolved: list[str] = []\n385\t\n386\t        class ETBCreature(Creature):\n387\t\n388\t            def register_triggers(self, g: GameState) -> None:\n389\t                reg = TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=None, effect=lambda game: etb_resolved.append(self.name), source=self, controller=self.controller)\n390\t                g.trigger_manager.register(reg)\n391\t        p = players[0]\n392\t        card = ETBCreature(name='Ravenous Chupacabra', owner=p, controller=p)\n393\t        game.get_battlefield(p).add(card)\n394\t        card.register_triggers(game)\n395\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n396\t        assert not game.stack.is_empty()\n397\t        stack_obj = game.stack.pop()\n398\t        assert stack_obj.source is card\n399\t        assert stack_obj.controller is p\n400\t        stack_obj.on_resolve(game)\n401\t        assert etb_resolved == ['Ravenous Chupacabra']\n402\t\n403\t    def test_etb_trigger_card_is_on_battlefield(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n404\t        \"\"\"The card should actually be on the battlefield when the trigger fires.\"\"\"\n405\t        on_battlefield_during_fire: list[bool] = []\n406\t\n407\t        class ETBCreature(Creature):\n408\t\n409\t            def register_triggers(self, g: GameState) -> None:\n410\t                card_ref = self\n411\t\n412\t                def check_condition(game_state, event):\n413\t                    bf = game_state.get_battlefield(card_ref.controller)\n414\t                    on_battlefield_during_fire.append(bf.contains(card_ref))\n415\t                    return True\n416\t                g.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=check_condition, effect=lambda g: None, source=self, controller=self.controller))\n417\t        p = players[0]\n418\t        card = ETBCreature(name='Chup', owner=p, controller=p)\n419\t        game.get_battlefield(p).add(card)\n420\t        card.register_triggers(game)\n421\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n422\t        assert on_battlefield_during_fire == [True]\n423\t\n424\t    def test_unregister_on_leave_battlefield(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n425\t        \"\"\"When a source leaves the battlefield and is unregistered, firing does nothing.\"\"\"\n426\t\n427\t        class ETBCreature(Creature):\n428\t\n429\t            def register_triggers(self, g: GameState) -> None:\n430\t                g.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=None, effect=lambda g: None, source=self, controller=self.controller))\n431\t        p = players[0]\n432\t        card = ETBCreature(name='Chupacabra', owner=p, controller=p)\n433\t        game.get_battlefield(p).add(card)\n434\t        card.register_triggers(game)\n435\t        assert len(game.trigger_manager.get_triggers()) == 1\n436\t        game.get_battlefield(p).remove(card)\n437\t        game.trigger_manager.unregister(card)\n438\t        assert len(game.trigger_manager.get_triggers()) == 0\n439\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n440\t        assert game.stack.is_empty()\n441\t\n442\t    def test_etb_with_data_parameter(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n443\t        \"\"\"ETB trigger condition can inspect data dict to filter (e.g., which creature entered).\"\"\"\n444\t        fired: list[str] = []\n445\t        p = players[0]\n446\t        bear = Creature(name='Bear', owner=p, controller=p)\n447\t        game.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=lambda g, event: event.creature is bear, effect=lambda g: fired.append('bear_entered'), source=bear, controller=p))\n448\t        other = Creature(name='Elf', owner=p, controller=p)\n449\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent(creature=other))\n450\t        assert game.stack.is_empty()\n451\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent(creature=bear))\n452\t        assert not game.stack.is_empty()\n453\t\n454\tclass TestAutoTriggerRegistrationViaResolve:\n455\t    \"\"\"Verify triggers are automatically registered when a permanent enters\n456\t    the battlefield through the real casting/resolution pipeline — NOT by\n457\t    manually calling card.register_triggers(game).\n458\t    \"\"\"\n459\t\n460\t    def test_resolve_spell_auto_registers_triggers(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n461\t        \"\"\"Cast a creature with an ETB trigger, resolve it, fire event,\n462\t        verify the trigger fires and pushes a StackObject automatically.\n463\t        \"\"\"\n464\t        from engine.casting import cast_spell\n465\t        from engine.types import ManaCost, ManaType, Phase\n466\t        etb_fired: list[str] = []\n467\t\n468\t        class ETBBeast(Creature):\n469\t\n470\t            def register_triggers(self, g: GameState) -> None:\n471\t                g.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=None, effect=lambda game: etb_fired.append(self.name), source=self, controller=self.controller))\n472\t        p = players[0]\n473\t        cost = ManaCost(generic=1)\n474\t        card = ETBBeast(name='Hollowhenge Beast', mana_cost=cost, owner=p, controller=p)\n475\t        game.get_hand(p).add(card)\n476\t        game.phase = Phase.PRECOMBAT_MAIN\n477\t        game.step = None\n478\t        p.mana_pool.add(ManaType.COLORLESS, 5)\n479\t        cast_spell(game, p, card)\n480\t        assert not game.stack.is_empty(), 'Spell should be on the stack after casting'\n481\t        spell_obj = game.stack.pop()\n482\t        spell_obj.on_resolve(game)\n483\t        assert game.get_battlefield(p).contains(card)\n484\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n485\t        assert len(triggers) == 1, 'register_triggers should have been called automatically'\n486\t        assert triggers[0].event_type is EntersBattlefieldTriggeredEvent\n487\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n488\t        assert not game.stack.is_empty(), 'ETB trigger should push a StackObject'\n489\t        trigger_obj = game.stack.pop()\n490\t        assert trigger_obj.source is card\n491\t        assert trigger_obj.controller is p\n492\t        trigger_obj.on_resolve(game)\n493\t        assert etb_fired == ['Hollowhenge Beast']\n494\t\n495\t    def test_play_land_auto_registers_triggers(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n496\t        \"\"\"Play a land with triggers via play_land, verify triggers are\n497\t        auto-registered without manual register_triggers call.\n498\t        \"\"\"\n499\t        from engine.card import Land\n500\t        from engine.casting import play_land\n501\t        from engine.types import Phase\n502\t        etb_fired: list[str] = []\n503\t\n504\t        class TriggerLand(Land):\n505\t\n506\t            def register_triggers(self, g: GameState) -> None:\n507\t                g.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=None, effect=lambda game: etb_fired.append(self.name), source=self, controller=self.controller))\n508\t        p = players[0]\n509\t        land = TriggerLand(name='Valakut', owner=p, controller=p)\n510\t        game.get_hand(p).add(land)\n511\t        game.phase = Phase.PRECOMBAT_MAIN\n512\t        game.step = None\n513\t        p.land_plays_remaining = 1\n514\t        play_land(game, p, land)\n515\t        assert game.get_battlefield(p).contains(land)\n516\t        triggers = game.trigger_manager.get_triggers_for_source(land)\n517\t        assert len(triggers) == 1\n518\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n519\t        assert not game.stack.is_empty()\n520\t\n521\tclass TestAutoTriggerUnregistrationViaLeave:\n522\t    \"\"\"Verify triggers are automatically unregistered when a permanent\n523\t    leaves the battlefield through the real engine paths (e.g., SBA\n524\t    moving a creature to the graveyard) — NOT by manually calling\n525\t    game.trigger_manager.unregister(card).\n526\t    \"\"\"\n527\t\n528\t    def test_sba_lethal_damage_auto_unregisters_triggers(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n529\t        \"\"\"A creature with triggers takes lethal damage → SBA moves it to\n530\t        graveyard → triggers should be automatically unregistered.\n531\t        \"\"\"\n532\t        from engine.casting import cast_spell\n533\t        from engine.state_based_actions import check_state_based_actions\n534\t        from engine.types import ManaCost, ManaType, Phase\n535\t\n536\t        class ETBCreature(Creature):\n537\t\n538\t            def register_triggers(self, g: GameState) -> None:\n539\t                g.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=None, effect=lambda game: None, source=self, controller=self.controller))\n540\t        p = players[0]\n541\t        cost = ManaCost(generic=1)\n542\t        card = ETBCreature(name='Fragile Golem', mana_cost=cost, owner=p, controller=p, base_power=2, base_toughness=2)\n543\t        game.get_hand(p).add(card)\n544\t        game.phase = Phase.PRECOMBAT_MAIN\n545\t        game.step = None\n546\t        p.mana_pool.add(ManaType.COLORLESS, 5)\n547\t        cast_spell(game, p, card)\n548\t        spell_obj = game.stack.pop()\n549\t        spell_obj.on_resolve(game)\n550\t        assert len(game.trigger_manager.get_triggers_for_source(card)) == 1\n551\t        assert game.get_battlefield(p).contains(card)\n552\t        card.damage_marked = 5\n553\t        check_state_based_actions(game)\n554\t        assert not game.get_battlefield(p).contains(card)\n555\t        assert len(game.trigger_manager.get_triggers_for_source(card)) == 0\n556\t        assert len(game.trigger_manager.get_triggers()) == 0\n557\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n558\t        assert game.stack.is_empty(), 'Trigger should have been auto-unregistered when creature left battlefield'\n559\t\n560\t    def test_sba_zero_toughness_auto_unregisters_triggers(self, game: GameState, players: list[DeterministicPlayer]) -> None:\n561\t        \"\"\"A creature with 0 toughness is removed by SBA → triggers auto-unregistered.\"\"\"\n562\t        from engine.state_based_actions import check_state_based_actions\n563\t\n564\t        class ETBCreature(Creature):\n565\t\n566\t            def register_triggers(self, g: GameState) -> None:\n567\t                g.trigger_manager.register(TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=None, effect=lambda game: None, source=self, controller=self.controller))\n568\t        p = players[0]\n569\t        card = ETBCreature(name='Doomed Construct', owner=p, controller=p, base_power=3, base_toughness=1)\n570\t        game.get_battlefield(p).add(card)\n571\t        card.register_triggers(game)\n572\t        assert len(game.trigger_manager.get_triggers_for_source(card)) == 1\n573\t        card.minus_one_counters = 1\n574\t        assert card.toughness == 0\n575\t        check_state_based_actions(game)\n576\t        assert not game.get_battlefield(p).contains(card)\n577\t        assert len(game.trigger_manager.get_triggers_for_source(card)) == 0\n578\t        game.trigger_manager.fire_event(game, EntersBattlefieldTriggeredEvent())\n579\t        assert game.stack.is_empty()\n580\t"}]},"parent_tool_use_id":"toolu_01M6QwNHGRh57GZfrPn9to8x","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"6f3f8658-8448-4b78-9092-74fd262e6f67","timestamp":"2026-06-01T23:41:23.119Z","subagent_type":"Tester","task_description":"Write tests for sos_1"}
