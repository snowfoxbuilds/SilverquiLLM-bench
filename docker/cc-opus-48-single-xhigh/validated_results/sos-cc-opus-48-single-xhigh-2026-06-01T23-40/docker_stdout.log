{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01Qpxh6sA1FkoTbA9vEY3cRy","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018EzFX5Vwd4MUJPoCCQwxRM","name":"Read","input":{"file_path":"/workspace/engine/game.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1116,"cache_read_input_tokens":11607,"cache_creation":{"ephemeral_5m_input_tokens":1116,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01FWkbLwQU8VHJEPVBvDNHZC","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"33664d9c-9155-44da-ae2d-74b3d03cf28f","request_id":"req_011CbdbBTN8SBzbSquocM2Bf","subagent_type":"Implementer","task_description":"Revise sos_226 per review"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018EzFX5Vwd4MUJPoCCQwxRM","type":"tool_result","content":"1\t\"\"\"Game setup, helper actions, and the full game loop.\n2\t\n3\tProvides the top-level functions for creating, running, and interacting with\n4\ta game of Magic: The Gathering:\n5\t\n6\t- :func:`create_game` — initialise a full game state for two players.\n7\t- Helper actions — module-level functions for common game operations\n8\t  (``deal_damage``, ``destroy``, ``sacrifice``, ``exile``, ``draw_card``,\n9\t  ``discard``, ``create_token``, ``add_counter``, ``remove_counter``,\n10\t  ``tap``, ``untap``).\n11\t- :func:`run_game` — execute turns until the game ends, returning the winner.\n12\t\"\"\"\n13\t\n14\tfrom __future__ import annotations\n15\t\n16\tfrom typing import TYPE_CHECKING, Any\n17\t\n18\tfrom engine.events import (\n19\t    CreatureDiesReplacementEvent,\n20\t    DealsDamageTriggeredEvent,\n21\t    DrawsCardTriggeredEvent,\n22\t    EntersBattlefieldTriggeredEvent,\n23\t    GainsLifeTriggeredEvent,\n24\t    LosesLifeTriggeredEvent,\n25\t    PermanentDestroyedReplacementEvent,\n26\t    SacrificeReplacementEvent,\n27\t)\n28\tfrom engine.game_state import GameState\n29\tfrom engine.turn import run_turn\n30\tfrom engine.types import Zone\n31\tfrom engine.zones import move_to_zone\n32\t\n33\tif TYPE_CHECKING:\n34\t    from engine.card import CardImpl, Creature\n35\t    from engine.player import Player\n36\t\n37\t\n38\t# Maximum number of turns before the game is considered a draw.\n39\t# Prevents infinite loops in deterministic or stuck game states.\n40\tMAX_TURNS: int = 1000\n41\t\n42\t\n43\t# ---------------------------------------------------------------------------\n44\t# Game creation\n45\t# ---------------------------------------------------------------------------\n46\t\n47\tdef create_game(\n48\t    player1: Player,\n49\t    player2: Player,\n50\t    deck1: list[CardImpl],\n51\t    deck2: list[CardImpl],\n52\t) -> GameState:\n53\t    \"\"\"Create and initialise a new two-player game.\n54\t\n55\t    Steps performed:\n56\t\n57\t    1. Set each player's life total to 20.\n58\t    2. Place *deck1* / *deck2* into the respective player's library zone.\n59\t    3. Shuffle each library.\n60\t    4. Draw 7 cards for each player.\n61\t    5. Set the active player to *player1*.\n62\t\n63\t    Card ownership is set so that each card's ``owner`` and ``controller``\n64\t    point to the player whose deck it came from.\n65\t\n66\t    Parameters:\n67\t        player1: The first player (goes first).\n68\t        player2: The second player.\n69\t        deck1: Cards comprising player1's deck.\n70\t        deck2: Cards comprising player2's deck.\n71\t\n72\t    Returns:\n73\t        A fully initialised :class:`GameState` ready for play.\n74\t    \"\"\"\n75\t    # 1. Set life totals\n76\t    player1.life = 20\n77\t    player2.life = 20\n78\t\n79\t    # 2. Place deck cards into libraries and set ownership\n80\t    library1 = player1.zones[Zone.LIBRARY]\n81\t    for card in deck1:\n82\t        card.owner = player1\n83\t        card.controller = player1\n84\t        library1.add(card)\n85\t\n86\t    library2 = player2.zones[Zone.LIBRARY]\n87\t    for card in deck2:\n88\t        card.owner = player2\n89\t        card.controller = player2\n90\t        library2.add(card)\n91\t\n92\t    # 3. Shuffle libraries\n93\t    library1.shuffle()\n94\t    library2.shuffle()\n95\t\n96\t    # Build the game state\n97\t    game = GameState([player1, player2])\n98\t\n99\t    # 4. Draw 7 cards each\n100\t    for _ in range(7):\n101\t        draw_card(game, player1)\n102\t    for _ in range(7):\n103\t        draw_card(game, player2)\n104\t\n105\t    # 5. Active player is player1 (index 0 — already the default)\n106\t    game.active_player_index = 0\n107\t    game.priority_player_index = 0\n108\t\n109\t    return game\n110\t\n111\t\n112\t# ---------------------------------------------------------------------------\n113\t# Common helper actions\n114\t# ---------------------------------------------------------------------------\n115\t\n116\tdef deal_damage(game: GameState, source: Any, target: Any, amount: int) -> None:\n117\t    \"\"\"Deal *amount* damage from *source* to *target*.\n118\t\n119\t    If *target* has a ``life`` attribute (i.e. is a player), life is reduced.\n120\t    If *target* has a ``damage_marked`` attribute (i.e. is a creature),\n121\t    damage is marked on it.\n122\t\n123\t    Fires :attr:`EventType.DEALS_DAMAGE` via the trigger manager.\n124\t\n125\t    Parameters:\n126\t        game: The current game state.\n127\t        source: The object dealing the damage.\n128\t        target: The player or creature receiving the damage.\n129\t        amount: The amount of damage to deal (must be > 0 to have effect).\n130\t    \"\"\"\n131\t    if amount <= 0:\n132\t        return\n133\t\n134\t    from engine.protection import has_protection_from\n135\t    from engine.types import Keyword\n136\t\n137\t    # Protection prevents damage from sources with the protected-from quality.\n138\t    if has_protection_from(target, source):\n139\t        return\n140\t\n141\t    if hasattr(target, \"life\"):\n142\t        # Target is a player\n143\t        target.life -= amount\n144\t        # Fire damage trigger\n145\t        game.trigger_manager.fire_event(\n146\t            game,\n147\t            DealsDamageTriggeredEvent(source=source, target=target, amount=amount),\n148\t        )\n149\t        # Fire loses-life trigger\n150\t        game.trigger_manager.fire_event(\n151\t            game,\n152\t            LosesLifeTriggeredEvent(player=target, amount=amount),\n153\t        )\n154\t    elif hasattr(target, \"damage_marked\"):\n155\t        # Target is a creature\n156\t        target.damage_marked += amount\n157\t\n158\t        # Track deathtouch damage for SBA rule 704.5h\n159\t        source_kw = getattr(source, \"keywords\", Keyword(0))\n160\t        if Keyword.DEATHTOUCH in source_kw:\n161\t            target.dealt_deathtouch_damage = True\n162\t\n163\t        # Fire damage trigger\n164\t        game.trigger_manager.fire_event(\n165\t            game,\n166\t            DealsDamageTriggeredEvent(source=source, target=target, amount=amount),\n167\t        )\n168\t\n169\t    # Lifelink: controller of source gains life equal to damage dealt\n170\t    source_kw = getattr(source, \"keywords\", Keyword(0))\n171\t    if Keyword.LIFELINK in source_kw:\n172\t        controller = getattr(source, \"controller\", None)\n173\t        if controller is not None and hasattr(controller, \"life\"):\n174\t            controller.life += amount\n175\t\n176\t\n177\tdef destroy(game: GameState, permanent: Any) -> None:\n178\t    \"\"\"Destroy *permanent* — move it from the battlefield to its owner's graveyard.\n179\t\n180\t    Respects replacement effects via :func:`move_to_zone`.\n181\t    Creatures with the ``INDESTRUCTIBLE`` keyword are not destroyed.\n182\t\n183\t    Parameters:\n184\t        game: The current game state.\n185\t        permanent: The permanent to destroy.\n186\t    \"\"\"\n187\t    from engine.types import Keyword\n188\t\n189\t    # Indestructible permanents cannot be destroyed\n190\t    kw = getattr(permanent, \"keywords\", Keyword(0))\n191\t    if Keyword.INDESTRUCTIBLE in kw:\n192\t        return\n193\t\n194\t    controller = getattr(permanent, \"controller\", None)\n195\t    if controller is None:\n196\t        # Fallback: find which player's battlefield contains it\n197\t        for player in game.players:\n198\t            bf = game.get_battlefield(player)\n199\t            if bf.contains(permanent):\n200\t                controller = player\n201\t                break\n202\t    if controller is None:\n203\t        return\n204\t\n205\t    bf = game.get_battlefield(controller)\n206\t    if not bf.contains(permanent):\n207\t        return\n208\t\n209\t    from engine.types import CardType\n210\t\n211\t    card_types = getattr(permanent, \"card_types\", set())\n212\t    is_creature = CardType.CREATURE in card_types\n213\t    owner = getattr(permanent, \"owner\", controller)\n214\t\n215\t    if is_creature:\n216\t        repl_event: CreatureDiesReplacementEvent | PermanentDestroyedReplacementEvent = (\n217\t            CreatureDiesReplacementEvent(\n218\t                creature=permanent, destination=\"graveyard\",\n219\t                controller=controller, owner=owner,\n220\t            )\n221\t        )\n222\t    else:\n223\t        repl_event = PermanentDestroyedReplacementEvent(\n224\t            permanent=permanent, destination=\"graveyard\",\n225\t            controller=controller, owner=owner,\n226\t        )\n227\t\n228\t    move_to_zone(\n229\t        game,\n230\t        permanent,\n231\t        Zone.BATTLEFIELD,\n232\t        Zone.GRAVEYARD,\n233\t        replacement_event=repl_event,\n234\t    )\n235\t\n236\t\n237\tdef sacrifice(game: GameState, player: Player, permanent: Any) -> None:\n238\t    \"\"\"Sacrifice *permanent* — move it from the battlefield to its owner's graveyard.\n239\t\n240\t    Sacrificing cannot be prevented by indestructible or regeneration, but\n241\t    replacement effects that modify zone changes (e.g. \"if this would be\n242\t    put into a graveyard, exile it instead\") still apply via\n243\t    :func:`move_to_zone`.\n244\t\n245\t    Parameters:\n246\t        game: The current game state.\n247\t        player: The player performing the sacrifice.\n248\t        permanent: The permanent to sacrifice.\n249\t    \"\"\"\n250\t    bf = game.get_battlefield(player)\n251\t    if not bf.contains(permanent):\n252\t        return\n253\t\n254\t    owner = getattr(permanent, \"owner\", player)\n255\t    move_to_zone(\n256\t        game,\n257\t        permanent,\n258\t        Zone.BATTLEFIELD,\n259\t        Zone.GRAVEYARD,\n260\t        replacement_event=SacrificeReplacementEvent(\n261\t            permanent=permanent, destination=\"graveyard\",\n262\t            controller=player, owner=owner,\n263\t        ),\n264\t    )\n265\t\n266\t\n267\tdef exile(game: GameState, obj: Any) -> None:\n268\t    \"\"\"Exile *obj* — move it to its owner's exile zone.\n269\t\n270\t    Works for objects on the battlefield, in the graveyard, on the stack,\n271\t    or in hand.\n272\t\n273\t    Parameters:\n274\t        game: The current game state.\n275\t        obj: The game object to exile.\n276\t    \"\"\"\n277\t    # Find which zone the object is currently in\n278\t    source_zone_type = None\n279\t    for player in game.players:\n280\t        for zone_type in Zone:\n281\t            zone = player.zones[zone_type]\n282\t            if zone.contains(obj):\n283\t                source_zone_type = zone_type\n284\t                break\n285\t        if source_zone_type is not None:\n286\t            break\n287\t\n288\t    if source_zone_type is None:\n289\t        return\n290\t\n291\t    move_to_zone(game, obj, source_zone_type, Zone.EXILE)\n292\t\n293\t\n294\tdef draw_card(game: GameState, player: Player) -> Any | None:\n295\t    \"\"\"Draw a card for *player* — move the top card of library to hand.\n296\t\n297\t    If the library is empty, sets ``player.drawn_from_empty_library = True``\n298\t    (SBAs will handle the game loss).\n299\t\n300\t    Fires :attr:`EventType.DRAWS_CARD` via the trigger manager.\n301\t\n302\t    Parameters:\n303\t        game: The current game state.\n304\t        player: The player drawing a card.\n305\t\n306\t    Returns:\n307\t        The drawn card, or ``None`` if the library was empty.\n308\t    \"\"\"\n309\t    library = player.zones[Zone.LIBRARY]\n310\t\n311\t    if len(library) == 0:\n312\t        player.drawn_from_empty_library = True\n313\t        return None\n314\t\n315\t    # Top of library is the last element (index -1)\n316\t    cards = library.top(1)\n317\t    card = cards[0]\n318\t    library.remove(card)\n319\t\n320\t    hand = player.zones[Zone.HAND]\n321\t    hand.add(card)\n322\t\n323\t    # Track cards drawn this turn\n324\t    if not hasattr(player, \"cards_drawn_this_turn\"):\n325\t        player.cards_drawn_this_turn = 0\n326\t    player.cards_drawn_this_turn += 1\n327\t\n328\t    # Fire trigger (only if game has a trigger_manager — may not during setup)\n329\t    if hasattr(game, \"trigger_manager\"):\n330\t        game.trigger_manager.fire_event(\n331\t            game,\n332\t            DrawsCardTriggeredEvent(player=player, card=card),\n333\t        )\n334\t\n335\t    # Draw-time miracle window (CR 702.94). This is a COMPLETE no-op unless the\n336\t    # drawn card is this player's FIRST card this turn AND a permanent they\n337\t    # control grants the card a miracle (alternative) cost. Only then is the\n338\t    # controller offered the immediate cast. Keeping the hook fully gated means\n339\t    # ordinary draws (where nothing grants miracle) see zero behavioural change.\n340\t    _offer_miracle(game, player, card)\n341\t\n342\t    return card\n343\t\n344\t\n345\tdef _offer_miracle(game: GameState, player: Player, card: Any) -> None:\n346\t    \"\"\"Offer to cast *card* for a granted miracle cost at draw time.\n347\t\n348\t    Gated so it does nothing unless BOTH hold:\n349\t\n350\t    * ``card`` is *player*'s first card drawn this turn\n351\t      (``player.cards_drawn_this_turn == 1``), and\n352\t    * a permanent *player* controls advertises a ``grants_miracle_to(card)``\n353\t      capability returning a non-``None`` :class:`~engine.types.ManaCost`.\n354\t\n355\t    When both hold, ``card.miracle_cost`` is stamped and the player is asked\n356\t    (via ``choose_yes_no``) whether to cast it for the miracle cost. On yes,\n357\t    the card is cast from hand via the alternative-cost casting surface.\n358\t\n359\t    The miracle \"window\" is modelled as an immediate at-draw offer rather than\n360\t    the full reveal → triggered ability → cast-before-next-step sequence; this\n361\t    is deterministic and sufficient for the engine.\n362\t    \"\"\"\n363\t    # (a) First card drawn this turn.\n364\t    if getattr(player, \"cards_drawn_this_turn\", 0) != 1:\n365\t        return\n366\t\n367\t    # (b) A controlled permanent grants miracle to this card.\n368\t    miracle_cost = None\n369\t    battlefield = player.zones[Zone.BATTLEFIELD]\n370\t    for permanent in battlefield.get_all():\n371\t        grant = getattr(permanent, \"grants_miracle_to\", None)\n372\t        if grant is None:\n373\t            continue\n374\t        cost = grant(card)\n375\t        if cost is not None:\n376\t            miracle_cost = cost\n377\t            break\n378\t\n379\t    if miracle_cost is None:\n380\t        return\n381\t\n382\t    # Stamp the granted miracle cost so it is observable on the card.\n383\t    card.miracle_cost = miracle_cost  # type: ignore[attr-defined]\n384\t\n385\t    # \"You may cast it for its miracle cost.\" Offer the controller the choice.\n386\t    if not player.choose_yes_no(\n387\t        f\"Cast {getattr(card, 'name', 'this card')!r} for its miracle cost?\"\n388\t    ):\n389\t        return\n390\t\n391\t    from engine.casting import CastingError, cast_spell\n392\t\n393\t    try:\n394\t        cast_spell(game, player, card, alternative_cost=miracle_cost)\n395\t    except CastingError:\n396\t        # Could not pay / cast (e.g. insufficient mana) — leave the card in\n397\t        # hand, no state change beyond the stamped miracle_cost.\n398\t        return\n399\t\n400\t\n401\tdef discard(game: GameState, player: Player, card: Any) -> None:\n402\t    \"\"\"Discard *card* from *player*'s hand to the owner's graveyard.\n403\t\n404\t    Parameters:\n405\t        game: The current game state.\n406\t        player: The player discarding.\n407\t        card: The card to discard (must be in the player's hand).\n408\t    \"\"\"\n409\t    hand = game.get_hand(player)\n410\t    if not hand.contains(card):\n411\t        return\n412\t\n413\t    move_to_zone(game, card, Zone.HAND, Zone.GRAVEYARD)\n414\t\n415\t\n416\tdef create_token(game: GameState, player: Player, token: Any) -> None:\n417\t    \"\"\"Create a token on the battlefield under *player*'s control.\n418\t\n419\t    Sets ``is_token = True`` on the token, along with ``owner`` and\n420\t    ``controller``.  Uses :func:`move_to_zone` for entering-battlefield\n421\t    hooks (trigger/replacement-effect registration and ETB event).\n422\t\n423\t    Parameters:\n424\t        game: The current game state.\n425\t        player: The player who controls the token.\n426\t        token: The token object to place on the battlefield.\n427\t    \"\"\"\n428\t    token.is_token = True\n429\t    token.owner = player\n430\t    token.controller = player\n431\t\n432\t    # Tokens don't come from an existing zone — add directly and fire hooks.\n433\t    # Ordering matches move_to_zone: fire ETB *before* registering the token's\n434\t    # own triggers so a token's ETB trigger doesn't self-fire on entry.\n435\t    battlefield = game.get_battlefield(player)\n436\t    battlefield.add(token)\n437\t\n438\t    game.trigger_manager.fire_event(\n439\t        game,\n440\t        EntersBattlefieldTriggeredEvent(permanent=token, controller=player),\n441\t    )\n442\t\n443\t    # Register triggers/replacement effects after the ETB event.\n444\t    if hasattr(token, \"register_triggers\"):\n445\t        token.register_triggers(game)\n446\t    if hasattr(token, \"register_replacement_effects\"):\n447\t        token.register_replacement_effects(game)\n448\t\n449\t\n450\tdef add_counter(\n451\t    game: GameState,\n452\t    permanent: Any,\n453\t    counter_type: str,\n454\t    amount: int = 1,\n455\t) -> None:\n456\t    \"\"\"Add *amount* counters of *counter_type* to *permanent*.\n457\t\n458\t    Supports ``\"+1/+1\"`` and ``\"-1/-1\"`` counter types via the\n459\t    ``plus_one_counters`` / ``minus_one_counters`` attributes.  For other\n460\t    counter types, uses a generic ``counters`` dict.\n461\t\n462\t    Parameters:\n463\t        game: The current game state.\n464\t        permanent: The permanent to add counters to.\n465\t        counter_type: The type of counter (e.g. ``\"+1/+1\"``, ``\"-1/-1\"``,\n466\t            ``\"loyalty\"``, ``\"charge\"``).\n467\t        amount: Number of counters to add (default 1).\n468\t    \"\"\"\n469\t    if amount <= 0:\n470\t        return\n471\t\n472\t    if counter_type == \"+1/+1\" and hasattr(permanent, \"plus_one_counters\"):\n473\t        permanent.plus_one_counters += amount\n474\t    elif counter_type == \"-1/-1\" and hasattr(permanent, \"minus_one_counters\"):\n475\t        permanent.minus_one_counters += amount\n476\t    elif counter_type == \"loyalty\" and hasattr(permanent, \"loyalty\"):\n477\t        permanent.loyalty += amount\n478\t    else:\n479\t        # Generic counter storage\n480\t        if not hasattr(permanent, \"counters\"):\n481\t            permanent.counters = {}\n482\t        permanent.counters[counter_type] = permanent.counters.get(counter_type, 0) + amount\n483\t\n484\t\n485\tdef remove_counter(\n486\t    game: GameState,\n487\t    permanent: Any,\n488\t    counter_type: str,\n489\t    amount: int = 1,\n490\t) -> None:\n491\t    \"\"\"Remove *amount* counters of *counter_type* from *permanent*.\n492\t\n493\t    Will not reduce below zero.\n494\t\n495\t    Parameters:\n496\t        game: The current game state.\n497\t        permanent: The permanent to remove counters from.\n498\t        counter_type: The type of counter to remove.\n499\t        amount: Number of counters to remove (default 1).\n500\t    \"\"\"\n501\t    if amount <= 0:\n502\t        return\n503\t\n504\t    if counter_type == \"+1/+1\" and hasattr(permanent, \"plus_one_counters\"):\n505\t        permanent.plus_one_counters = max(0, permanent.plus_one_counters - amount)\n506\t    elif counter_type == \"-1/-1\" and hasattr(permanent, \"minus_one_counters\"):\n507\t        permanent.minus_one_counters = max(0, permanent.minus_one_counters - amount)\n508\t    elif counter_type == \"loyalty\" and hasattr(permanent, \"loyalty\"):\n509\t        permanent.loyalty = max(0, permanent.loyalty - amount)\n510\t    else:\n511\t        if hasattr(permanent, \"counters\") and counter_type in permanent.counters:\n512\t            permanent.counters[counter_type] = max(\n513\t                0, permanent.counters[counter_type] - amount\n514\t            )\n515\t\n516\t\n517\tdef tap(game: GameState, permanent: Any) -> None:\n518\t    \"\"\"Tap *permanent* — set ``is_tapped = True``.\n519\t\n520\t    Parameters:\n521\t        game: The current game state.\n522\t        permanent: The permanent to tap.\n523\t    \"\"\"\n524\t    if hasattr(permanent, \"is_tapped\"):\n525\t        permanent.is_tapped = True\n526\t\n527\t\n528\tdef untap(game: GameState, permanent: Any) -> None:\n529\t    \"\"\"Untap *permanent* — set ``is_tapped = False``.\n530\t\n531\t    Parameters:\n532\t        game: The current game state.\n533\t        permanent: The permanent to untap.\n534\t    \"\"\"\n535\t    if hasattr(permanent, \"is_tapped\"):\n536\t        permanent.is_tapped = False\n537\t\n538\t\n539\t# ---------------------------------------------------------------------------\n540\t# Coin flips (CR 705)\n541\t# ---------------------------------------------------------------------------\n542\t\n543\tdef flip_coin(game: GameState, player: Any = None) -> bool:\n544\t    \"\"\"Flip a single coin (CR 705) and return ``True`` for heads.\n545\t\n546\t    The randomness is deterministic and injectable so that tests can force\n547\t    outcomes. The injection points, checked in order, are:\n548\t\n549\t    1. ``game._forced_coin_flips`` — a list/deque of pre-seeded booleans (or\n550\t       truthy/falsy values). When present and non-empty, the next value is\n551\t       popped from the *front* and used as the result. This is the simplest\n552\t       way for a test to force a known number of heads.\n553\t    2. ``game.rng`` — a ``random.Random``-compatible object. When present, the\n554\t       result is ``game.rng.random() < 0.5``. A test can set\n555\t       ``game.rng = random.Random(seed)`` for reproducible flips.\n556\t    3. Otherwise a module-level ``random`` call is used.\n557\t\n558\t    Parameters:\n559\t        game: The current game state.\n560\t        player: The player flipping the coin (informational; unused by the\n561\t            default RNG but accepted for API symmetry / future hooks).\n562\t\n563\t    Returns:\n564\t        ``True`` for heads, ``False`` for tails.\n565\t    \"\"\"\n566\t    forced = getattr(game, \"_forced_coin_flips\", None)\n567\t    if forced:\n568\t        # Support both lists and collections.deque (popleft) for the queue.\n569\t        if hasattr(forced, \"popleft\"):\n570\t            value = forced.popleft()\n571\t        else:\n572\t            value = forced.pop(0)\n573\t        return bool(value)\n574\t\n575\t    rng = getattr(game, \"rng\", None)\n576\t    if rng is not None:\n577\t        return rng.random() < 0.5\n578\t\n579\t    import random as _random\n580\t\n581\t    return _random.random() < 0.5\n582\t\n583\t\n584\tdef flip_coins(game: GameState, n: int, player: Any = None) -> int:\n585\t    \"\"\"Flip *n* coins and return the number that came up heads.\n586\t\n587\t    Uses :func:`flip_coin` for each flip, so the same deterministic injection\n588\t    points apply (``game._forced_coin_flips`` then ``game.rng``). See\n589\t    :func:`flip_coin` for how a test forces specific results.\n590\t\n591\t    Parameters:\n592\t        game: The current game state.\n593\t        n: The number of coins to flip (``n <= 0`` returns 0).\n594\t        player: The player flipping the coins (informational).\n595\t\n596\t    Returns:\n597\t        The number of heads across the *n* flips.\n598\t    \"\"\"\n599\t    if n <= 0:\n600\t        return 0\n601\t    return sum(1 for _ in range(n) if flip_coin(game, player))\n602\t\n603\t\n604\t# ---------------------------------------------------------------------------\n605\t# Game loop\n606\t# ---------------------------------------------------------------------------\n607\t\n608\tdef run_game(game: GameState) -> Player | None:\n609\t    \"\"\"Run the game loop until the game ends.\n610\t\n611\t    Executes :func:`~engine.turn.run_turn` in a loop, checking\n612\t    :attr:`GameState.is_game_over` after each turn.  State-based actions\n613\t    are resolved before and after each turn to catch game-ending conditions\n614\t    even when the priority loop auto-passes.\n615\t\n616\t    Includes a safety limit of :data:`MAX_TURNS` to prevent infinite loops\n617\t    in deterministic or stuck game states.\n618\t\n619\t    Parameters:\n620\t        game: The game state to run.\n621\t\n622\t    Returns:\n623\t        The winning player, or ``None`` if the game ended in a draw (or\n624\t        hit the turn limit).\n625\t    \"\"\"\n626\t    from engine.state_based_actions import resolve_state_based_actions\n627\t\n628\t    while not game.is_game_over and game.turn_number <= MAX_TURNS:\n629\t        # Check SBAs before the turn (catches pre-existing conditions)\n630\t        resolve_state_based_actions(game)\n631\t        _check_game_over(game)\n632\t        if game.is_game_over:\n633\t            break\n634\t\n635\t        run_turn(game)\n636\t\n637\t        # Check SBAs after the turn\n638\t        resolve_state_based_actions(game)\n639\t        _check_game_over(game)\n640\t\n641\t    return game.winner\n642\t\n643\t\n644\tdef _check_game_over(game: GameState) -> None:\n645\t    \"\"\"Check whether the game has ended and update ``game.is_game_over`` / ``game.winner``.\n646\t\n647\t    The game ends when:\n648\t    - One player has lost (``has_lost``): the other player wins.\n649\t    - Both players have lost: the game is a draw (``winner = None``).\n650\t    - The turn limit is exceeded: the game is a draw.\n651\t    \"\"\"\n652\t    lost_players = [p for p in game.players if p.has_lost]\n653\t\n654\t    if len(lost_players) == len(game.players):\n655\t        # All players have lost — draw\n656\t        game.is_game_over = True\n657\t        game.winner = None\n658\t    elif len(lost_players) == 1:\n659\t        # One player lost — the other wins\n660\t        game.is_game_over = True\n661\t        game.winner = [p for p in game.players if not p.has_lost][0]\n662\t    elif game.turn_number > MAX_TURNS:\n663\t        # Turn limit exceeded — draw\n664\t        game.is_game_over = True\n665\t        game.winner = None\n666\t"}]},"parent_tool_use_id":"toolu_01FWkbLwQU8VHJEPVBvDNHZC","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"e793e874-34b8-4188-977e-3fffe5a72adb","timestamp":"2026-06-02T01:47:15.332Z","subagent_type":"Implementer","task_description":"Revise sos_226 per review"}
