{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WXHQB8urcuFgYCkbo4kAZ1","type":"tool_result","content":"1\t\"\"\"Tests for SOS 226 — Silverquill, the Disputant.\n2\t\n3\tSilverquill, the Disputant is a ``{2}{W}{B}`` Legendary Creature — Elder\n4\tDragon with power/toughness 4/4 and the following abilities:\n5\t\n6\t1. Flying, vigilance (evergreen keywords).\n7\t2. \"Each instant and sorcery spell you cast has casualty 1. (As you cast that\n8\t   spell, you may sacrifice a creature with power 1 or greater. When you do,\n9\t   copy the spell and you may choose new targets for the copy.)\"\n10\t\n11\tThe engine has no native \"casualty\" mechanic (it is not fired automatically\n12\tfrom ``cast_spell``), and there is no ``SpellCastTriggeredEvent`` fired by the\n13\tcasting pipeline. Following the established convention for granted abilities\n14\tthat lack native engine support (see SOS 201's miracle granting and the\n15\t``copy_spell`` surface used by FDN 248 Thousand-Year Storm), we test the\n16\t*observable card contract*:\n17\t\n18\t* ``CASUALTY_AMOUNT`` — the granted casualty value (1), exposed as a constant.\n19\t* ``grants_casualty_to(spell) -> int | None`` — the capability: returns the\n20\t  casualty amount for an instant/sorcery the dragon's controller casts and\n21\t  ``None`` for anything else. (Mirrors SOS 201's ``grants_miracle_to``.)\n22\t* ``offer_casualty(game, stack_obj) -> bool`` — the actual casualty offer:\n23\t  given a spell already on the stack (controlled by the dragon's controller),\n24\t  optionally sacrifice a controlled creature with power >= 1, and if so push a\n25\t  copy of the spell onto the stack (with optionally-new targets). Returns\n26\t  whether a copy was made.\n27\t\n28\tThese tests target the public card contract and are written before the\n29\timplementation (TDD red phase): they import the card and assert real behavior,\n30\tso they fail until ``SilverquillTheDisputant`` is implemented.\n31\t\"\"\"\n32\t\n33\tfrom __future__ import annotations\n34\t\n35\tfrom typing import Any\n36\t\n37\timport pytest\n38\t\n39\tfrom cards.sos.sos_226.card_impl import SilverquillTheDisputant\n40\tfrom engine.card import Creature, Instant, Sorcery, Land\n41\tfrom engine.casting import cast_spell as engine_cast_spell\n42\tfrom engine.combat import _can_attack, _can_block, declare_attackers_step\n43\tfrom engine.stack import StackObject\n44\tfrom engine.types import (\n45\t    CardType,\n46\t    Keyword,\n47\t    ManaCost,\n48\t    ManaType,\n49\t    Phase,\n50\t    Step,\n51\t    Supertype,\n52\t    Zone,\n53\t)\n54\tfrom test_utils import create_game, set_board_state\n55\t\n56\t\n57\t# ---------------------------------------------------------------------------\n58\t# Helpers\n59\t# ---------------------------------------------------------------------------\n60\t\n61\t\n62\tdef _make_instant(name: str = \"Bolt\", owner=None) -> Instant:\n63\t    return Instant(\n64\t        name=name,\n65\t        mana_cost=ManaCost.parse(\"{R}\"),\n66\t        owner=owner,\n67\t        controller=owner,\n68\t    )\n69\t\n70\t\n71\tdef _make_sorcery(name: str = \"Divination\", owner=None) -> Sorcery:\n72\t    return Sorcery(\n73\t        name=name,\n74\t        mana_cost=ManaCost.parse(\"{2}{U}\"),\n75\t        owner=owner,\n76\t        controller=owner,\n77\t    )\n78\t\n79\t\n80\tdef _make_creature(name: str, power: int, toughness: int, owner=None) -> Creature:\n81\t    return Creature(\n82\t        name=name,\n83\t        base_power=power,\n84\t        base_toughness=toughness,\n85\t        owner=owner,\n86\t        controller=owner,\n87\t    )\n88\t\n89\t\n90\tdef _spell_stack_object(spell: Any, controller: Any, targets=None) -> StackObject:\n91\t    \"\"\"Build a StackObject representing *spell* cast by *controller*.\n92\t\n93\t    Mirrors what ``engine.casting.cast_spell`` would push for a real cast:\n94\t    ``is_spell=True`` and the on_resolve callback invokes the card's\n95\t    ``on_resolve``.\n96\t    \"\"\"\n97\t\n98\t    def _resolve(g):\n99\t        spell.chosen_targets = list(targets or [])\n100\t        spell.on_resolve(g)\n101\t\n102\t    return StackObject(\n103\t        source=spell,\n104\t        controller=controller,\n105\t        targets=list(targets or []),\n106\t        on_resolve=_resolve,\n107\t        is_spell=True,\n108\t    )\n109\t\n110\t\n111\t# ---------------------------------------------------------------------------\n112\t# Static characteristics\n113\t# ---------------------------------------------------------------------------\n114\t\n115\t\n116\tclass TestSilverquillProperties:\n117\t    \"\"\"Static card data should match the SOS 226 spec.\"\"\"\n118\t\n119\t    def test_is_creature(self) -> None:\n120\t        card = SilverquillTheDisputant(owner=None)\n121\t        assert isinstance(card, Creature)\n122\t        assert CardType.CREATURE in card.card_types\n123\t\n124\t    def test_name(self) -> None:\n125\t        assert SilverquillTheDisputant(owner=None).name == \"Silverquill, the Disputant\"\n126\t\n127\t    def test_mana_cost(self) -> None:\n128\t        assert SilverquillTheDisputant(owner=None).mana_cost == ManaCost.parse(\"{2}{W}{B}\")\n129\t\n130\t    def test_power_toughness(self) -> None:\n131\t        card = SilverquillTheDisputant(owner=None)\n132\t        assert card.base_power == 4\n133\t        assert card.base_toughness == 4\n134\t\n135\t    def test_is_legendary(self) -> None:\n136\t        assert Supertype.LEGENDARY in SilverquillTheDisputant(owner=None).supertypes\n137\t\n138\t    def test_elder_dragon_subtypes(self) -> None:\n139\t        subtypes = SilverquillTheDisputant(owner=None).subtypes\n140\t        assert {\"Elder\", \"Dragon\"} <= subtypes\n141\t\n142\t    def test_colors_are_white_black(self) -> None:\n143\t        \"\"\"The spec lists colors W and B; cards advertise this via self.colors.\"\"\"\n144\t        colors = set(getattr(SilverquillTheDisputant(owner=None), \"colors\", []))\n145\t        assert colors == {\"W\", \"B\"}\n146\t\n147\t\n148\t# ---------------------------------------------------------------------------\n149\t# Flying + vigilance keywords\n150\t# ---------------------------------------------------------------------------\n151\t\n152\t\n153\tclass TestSilverquillKeywords:\n154\t    \"\"\"Flying and vigilance keyword flags and their combat-rule consequences.\"\"\"\n155\t\n156\t    def test_has_flying_and_vigilance(self) -> None:\n157\t        kw = SilverquillTheDisputant(owner=None).keywords\n158\t        assert Keyword.FLYING in kw\n159\t        assert Keyword.VIGILANCE in kw\n160\t\n161\t    def test_ground_creature_cannot_block_flying_silverquill(self) -> None:\n162\t        attacker = SilverquillTheDisputant(owner=None)\n163\t        ground = Creature(name=\"Ground Bear\", base_power=2, base_toughness=2)\n164\t        ground.keywords = Keyword(0)\n165\t        ground.is_tapped = False\n166\t        assert _can_block(ground, attacker) is False\n167\t\n168\t    def test_flying_creature_can_block_flying_silverquill(self) -> None:\n169\t        attacker = SilverquillTheDisputant(owner=None)\n170\t        # Guard: the contract is meaningful only if Silverquill actually flies\n171\t        # (otherwise a ground blocker could block it too).\n172\t        assert Keyword.FLYING in attacker.keywords\n173\t        flier = Creature(name=\"Air Bear\", base_power=2, base_toughness=2)\n174\t        flier.keywords = Keyword.FLYING\n175\t        flier.is_tapped = False\n176\t        assert _can_block(flier, attacker) is True\n177\t\n178\t    def test_reach_creature_can_block_flying_silverquill(self) -> None:\n179\t        attacker = SilverquillTheDisputant(owner=None)\n180\t        assert Keyword.FLYING in attacker.keywords\n181\t        spider = Creature(name=\"Spider\", base_power=1, base_toughness=4)\n182\t        spider.keywords = Keyword.REACH\n183\t        spider.is_tapped = False\n184\t        assert _can_block(spider, attacker) is True\n185\t\n186\t    def test_vigilance_does_not_tap_when_attacking(self) -> None:\n187\t        \"\"\"Vigilance: declaring Silverquill as an attacker leaves it untapped.\n188\t\n189\t        Drives the real ``declare_attackers_step`` so the keyword's\n190\t        consequence (no tap) is observed, not just the flag.\n191\t        \"\"\"\n192\t        game = create_game(scripts=([None], [None]))\n193\t        p1 = game.players[0]\n194\t        dragon = SilverquillTheDisputant(owner=p1, controller=p1)\n195\t        dragon.summoning_sick = False\n196\t        dragon.is_tapped = False\n197\t        set_board_state(game, 0, battlefield=[dragon])\n198\t\n199\t        game.active_player_index = 0\n200\t        game.priority_player_index = 0\n201\t        game.phase = Phase.COMBAT\n202\t        game.step = Step.DECLARE_ATTACKERS\n203\t        game.combat_state.in_combat = True\n204\t        # Script the active player to declare the dragon as the attacker set.\n205\t        p1._script.appendleft([dragon])\n206\t\n207\t        declare_attackers_step(game)\n208\t\n209\t        assert dragon.is_attacking is True\n210\t        assert dragon.is_tapped is False\n211\t\n212\t\n213\t# ---------------------------------------------------------------------------\n214\t# Casualty granting: \"Each instant and sorcery spell you cast has casualty 1\"\n215\t# ---------------------------------------------------------------------------\n216\t\n217\t\n218\tclass TestSilverquillCasualtyGrant:\n219\t    \"\"\"The granted casualty value and the eligibility capability.\n220\t\n221\t    ``CASUALTY_AMOUNT`` is the constant 1; ``grants_casualty_to(spell)``\n222\t    returns that amount for instants/sorceries and ``None`` otherwise.\n223\t    \"\"\"\n224\t\n225\t    def test_casualty_amount_is_one(self) -> None:\n226\t        assert SilverquillTheDisputant(owner=None).CASUALTY_AMOUNT == 1\n227\t\n228\t    def test_grants_casualty_to_instant(self) -> None:\n229\t        dragon = SilverquillTheDisputant(owner=None)\n230\t        assert dragon.grants_casualty_to(_make_instant()) == 1\n231\t\n232\t    def test_grants_casualty_to_sorcery(self) -> None:\n233\t        dragon = SilverquillTheDisputant(owner=None)\n234\t        assert dragon.grants_casualty_to(_make_sorcery()) == 1\n235\t\n236\t    def test_does_not_grant_casualty_to_creature_spell(self) -> None:\n237\t        dragon = SilverquillTheDisputant(owner=None)\n238\t        bear = Creature(name=\"Bear\", base_power=2, base_toughness=2)\n239\t        assert dragon.grants_casualty_to(bear) is None\n240\t\n241\t    def test_does_not_grant_casualty_to_land(self) -> None:\n242\t        dragon = SilverquillTheDisputant(owner=None)\n243\t        assert dragon.grants_casualty_to(Land(name=\"Plains\")) is None\n244\t\n245\t\n246\t# ---------------------------------------------------------------------------\n247\t# Casualty offer: sacrifice a creature with power >= 1, then copy the spell\n248\t# ---------------------------------------------------------------------------\n249\t\n250\t\n251\tclass TestSilverquillCasualtyOffer:\n252\t    \"\"\"``offer_casualty(game, stack_obj)`` — the heart of the card.\n253\t\n254\t    When the dragon's controller casts an instant/sorcery and controls a\n255\t    creature with power >= 1, they may sacrifice such a creature; if they do,\n256\t    a copy of the spell is created (and they may choose new targets for the\n257\t    copy). These tests drive that method directly with a spell already\n258\t    represented as a StackObject.\n259\t    \"\"\"\n260\t\n261\t    def test_yes_sacrifices_creature_and_copies_spell(self) -> None:\n262\t        \"\"\"Accept: sacrifice a power>=1 creature → a copy of the spell is on the stack.\"\"\"\n263\t        # Scripts: choose_yes_no -> True (pay casualty); choose_card -> fodder;\n264\t        # choose_yes_no -> False (don't choose new targets).\n265\t        game = create_game(scripts=([], []))\n266\t        p1 = game.players[0]\n267\t        dragon = SilverquillTheDisputant(owner=p1, controller=p1)\n268\t        fodder = _make_creature(\"Fodder\", 1, 1, owner=p1)\n269\t        bolt = _make_instant(\"Cast Bolt\", owner=p1)\n270\t        set_board_state(game, 0, battlefield=[dragon, fodder])\n271\t        # Spell is already on the stack (as a cast spell would be).\n272\t        spell_so = _spell_stack_object(bolt, p1)\n273\t        game.stack.push(spell_so)\n274\t\n275\t        # Script the controller's decisions.\n276\t        p1._script.append(True)    # choose_yes_no: pay casualty\n277\t        p1._script.append(fodder)  # choose_card: which creature to sacrifice\n278\t        p1._script.append(False)   # choose_yes_no: keep same targets for copy\n279\t\n280\t        made_copy = dragon.offer_casualty(game, spell_so)\n281\t\n282\t        assert made_copy is True\n283\t        # The fodder creature was sacrificed to its owner's graveyard.\n284\t        assert game.get_graveyard(p1).contains(fodder)\n285\t        assert not game.get_battlefield(p1).contains(fodder)\n286\t        # A copy of the spell is now on the stack: two stack objects whose\n287\t        # source is the bolt (the original) and a distinct copy of it.\n288\t        spell_objs = [so for so in game.stack.objects() if getattr(so, \"is_spell\", False)]\n289\t        assert len(spell_objs) == 2\n290\t        sources = [so.source for so in spell_objs]\n291\t        assert bolt in sources\n292\t        # The copy is a different object than the original spell card.\n293\t        copies = [s for s in sources if s is not bolt]\n294\t        assert len(copies) == 1\n295\t        assert copies[0].name == bolt.name\n296\t\n297\t    def test_no_does_not_sacrifice_and_makes_no_copy(self) -> None:\n298\t        \"\"\"Decline: no creature sacrificed, no copy made.\"\"\"\n299\t        game = create_game(scripts=([], []))\n300\t        p1 = game.players[0]\n301\t        dragon = SilverquillTheDisputant(owner=p1, controller=p1)\n302\t        fodder = _make_creature(\"Fodder\", 2, 2, owner=p1)\n303\t        bolt = _make_instant(\"Cast Bolt\", owner=p1)\n304\t        set_board_state(game, 0, battlefield=[dragon, fodder])\n305\t        spell_so = _spell_stack_object(bolt, p1)\n306\t        game.stack.push(spell_so)\n307\t\n308\t        p1._script.append(False)  # choose_yes_no: decline casualty\n309\t\n310\t        made_copy = dragon.offer_casualty(game, spell_so)\n311\t\n312\t        assert made_copy is False\n313\t        # No sacrifice happened.\n314\t        assert game.get_battlefield(p1).contains(fodder)\n315\t        assert not game.get_graveyard(p1).contains(fodder)\n316\t        # Only the original spell is on the stack.\n317\t        spell_objs = [so for so in game.stack.objects() if getattr(so, \"is_spell\", False)]\n318\t        assert len(spell_objs) == 1\n319\t        assert spell_objs[0].source is bolt\n320\t\n321\t    def test_no_eligible_creature_makes_no_copy_and_does_not_prompt(self) -> None:\n322\t        \"\"\"With no power>=1 creature to sacrifice, casualty cannot be paid.\n323\t\n324\t        The empty script proves no yes/no prompt is issued (a stray prompt\n325\t        would raise ScriptExhaustedError). The dragon itself has power 4 but\n326\t        sacrificing it would be a legal choice — so to isolate \"no eligible\n327\t        creature\" we use a board where the only other creature has power 0 and\n328\t        we exclude the dragon by giving it 0 power is not possible; instead we\n329\t        assert the no-op contract when there is genuinely nothing with power>=1\n330\t        OTHER than... see test_power_zero_creature_is_not_eligible for the\n331\t        zero-power filter. Here we simply confirm that with no creatures at all\n332\t        besides nothing eligible, no copy is made.\n333\t        \"\"\"\n334\t        game = create_game(scripts=([], []))\n335\t        p1 = game.players[0]\n336\t        # Only a 0-power creature is available; the dragon is NOT on the\n337\t        # battlefield here, so there is no power>=1 creature to sacrifice.\n338\t        wall = _make_creature(\"Wall\", 0, 4, owner=p1)\n339\t        dragon = SilverquillTheDisputant(owner=p1, controller=p1)\n340\t        bolt = _make_instant(\"Cast Bolt\", owner=p1)\n341\t        set_board_state(game, 0, battlefield=[wall])\n342\t        spell_so = _spell_stack_object(bolt, p1)\n343\t        game.stack.push(spell_so)\n344\t\n345\t        made_copy = dragon.offer_casualty(game, spell_so)\n346\t\n347\t        assert made_copy is False\n348\t        # Nothing sacrificed, only the original spell remains.\n349\t        assert game.get_battlefield(p1).contains(wall)\n350\t        spell_objs = [so for so in game.stack.objects() if getattr(so, \"is_spell\", False)]\n351\t        assert len(spell_objs) == 1\n352\t        # No prompt was consumed.\n353\t        assert p1.remaining_choices == 0\n354\t\n355\t    def test_power_zero_creature_is_not_a_legal_sacrifice(self) -> None:\n356\t        \"\"\"Only creatures with power 1 or greater may be sacrificed for casualty.\n357\t\n358\t        Board has a 0/4 wall and a 1/1 fodder; the offer must restrict the\n359\t        sacrifice choice to the 1/1 (and the dragon, which is 4/4). We accept\n360\t        the offer and verify the only-power>=1 fodder is sacrificed.\n361\t        \"\"\"\n362\t        game = create_game(scripts=([], []))\n363\t        p1 = game.players[0]\n364\t        dragon = SilverquillTheDisputant(owner=p1, controller=p1)\n365\t        wall = _make_creature(\"Wall\", 0, 4, owner=p1)\n366\t        fodder = _make_creature(\"Fodder\", 1, 1, owner=p1)\n367\t        bolt = _make_instant(\"Cast Bolt\", owner=p1)\n368\t        set_board_state(game, 0, battlefield=[dragon, wall, fodder])\n369\t        spell_so = _spell_stack_object(bolt, p1)\n370\t        game.stack.push(spell_so)\n371\t\n372\t        captured: dict[str, Any] = {}\n373\t        orig_choose_card = p1.choose_card\n374\t\n375\t        def _spy_choose_card(cards, description):\n376\t            captured[\"options\"] = list(cards)\n377\t            return orig_choose_card(cards, description)\n378\t\n379\t        p1.choose_card = _spy_choose_card  # type: ignore[assignment]\n380\t\n381\t        p1._script.append(True)    # pay casualty\n382\t        p1._script.append(fodder)  # sacrifice the 1/1\n383\t        p1._script.append(False)   # keep same targets\n384\t\n385\t        dragon.offer_casualty(game, spell_so)\n386\t\n387\t        # The 0-power wall must not be among the legal sacrifice options.\n388\t        assert wall not in captured[\"options\"]\n389\t        assert fodder in captured[\"options\"]\n390\t        assert game.get_graveyard(p1).contains(fodder)\n391\t        assert game.get_battlefield(p1).contains(wall)\n392\t\n393\t    def test_copy_can_choose_new_targets(self) -> None:\n394\t        \"\"\"When the controller opts in, the copy uses newly chosen targets.\n395\t\n396\t        The original spell targets opponent A; choosing new targets points the\n397\t        copy at opponent B (here, a different creature). The copy's targets\n398\t        differ from the original's.\n399\t        \"\"\"\n400\t        game = create_game(scripts=([], []))\n401\t        p1 = game.players[0]\n402\t        p2 = game.players[1]\n403\t        dragon = SilverquillTheDisputant(owner=p1, controller=p1)\n404\t        fodder = _make_creature(\"Fodder\", 1, 1, owner=p1)\n405\t        original_target = _make_creature(\"Target A\", 2, 2, owner=p2)\n406\t        new_target = _make_creature(\"Target B\", 3, 3, owner=p2)\n407\t        bolt = _make_instant(\"Targeted Bolt\", owner=p1)\n408\t        set_board_state(game, 0, battlefield=[dragon, fodder])\n409\t        set_board_state(game, 1, battlefield=[original_target, new_target])\n410\t\n411\t        spell_so = _spell_stack_object(bolt, p1, targets=[original_target])\n412\t        game.stack.push(spell_so)\n413\t\n414\t        p1._script.append(True)        # pay casualty\n415\t        p1._script.append(fodder)      # sacrifice\n416\t        p1._script.append(True)        # choose new targets for the copy\n417\t        p1._script.append(new_target)  # the new target\n418\t\n419\t        dragon.offer_casualty(game, spell_so)\n420\t\n421\t        spell_objs = [so for so in game.stack.objects() if getattr(so, \"is_spell\", False)]\n422\t        copies = [so for so in spell_objs if so.source is not bolt]\n423\t        assert len(copies) == 1\n424\t        copy_so = copies[0]\n425\t        # The copy targets the newly chosen creature, not the original.\n426\t        assert new_target in copy_so.targets\n427\t        assert original_target not in copy_so.targets\n428\t\n429\t    def test_copy_keeps_original_targets_when_declined(self) -> None:\n430\t        \"\"\"Declining the new-targets choice keeps the copy's original targets.\"\"\"\n431\t        game = create_game(scripts=([], []))\n432\t        p1 = game.players[0]\n433\t        p2 = game.players[1]\n434\t        dragon = SilverquillTheDisputant(owner=p1, controller=p1)\n435\t        fodder = _make_creature(\"Fodder\", 1, 1, owner=p1)\n436\t        original_target = _make_creature(\"Target A\", 2, 2, owner=p2)\n437\t        bolt = _make_instant(\"Targeted Bolt\", owner=p1)\n438\t        set_board_state(game, 0, battlefield=[dragon, fodder])\n439\t        set_board_state(game, 1, battlefield=[original_target])\n440\t\n441\t        spell_so = _spell_stack_object(bolt, p1, targets=[original_target])\n442\t        game.stack.push(spell_so)\n443\t\n444\t        p1._script.append(True)    # pay casualty\n445\t        p1._script.append(fodder)  # sacrifice\n446\t        p1._script.append(False)   # do NOT choose new targets\n447\t\n448\t        dragon.offer_casualty(game, spell_so)\n449\t\n450\t        spell_objs = [so for so in game.stack.objects() if getattr(so, \"is_spell\", False)]\n451\t        copies = [so for so in spell_objs if so.source is not bolt]\n452\t        assert len(copies) == 1\n453\t        assert copies[0].targets == [original_target]\n454\t\n455\t    def test_copy_is_marked_as_spell(self) -> None:\n456\t        \"\"\"The pushed copy is a spell on the stack (is_spell=True).\"\"\"\n457\t        game = create_game(scripts=([], []))\n458\t        p1 = game.players[0]\n459\t        dragon = SilverquillTheDisputant(owner=p1, controller=p1)\n460\t        fodder = _make_creature(\"Fodder\", 1, 1, owner=p1)\n461\t        bolt = _make_instant(\"Cast Bolt\", owner=p1)\n462\t        set_board_state(game, 0, battlefield=[dragon, fodder])\n463\t        spell_so = _spell_stack_object(bolt, p1)\n464\t        game.stack.push(spell_so)\n465\t\n466\t        p1._script.append(True)\n467\t        p1._script.append(fodder)\n468\t        p1._script.append(False)\n469\t\n470\t        dragon.offer_casualty(game, spell_so)\n471\t\n472\t        copies = [\n473\t            so for so in game.stack.objects()\n474\t            if getattr(so, \"is_spell\", False) and so.source is not bolt\n475\t        ]\n476\t        assert len(copies) == 1\n477\t        assert copies[0].is_spell is True\n478\t        assert copies[0].controller is p1\n479\t\n480\t    def test_casualty_only_offered_for_controllers_own_spells(self) -> None:\n481\t        \"\"\"Casualty applies to spells *you* cast — not an opponent's spell.\n482\t\n483\t        If the spell on the stack is controlled by the opponent, the dragon's\n484\t        controller gets no casualty offer (no prompt, no copy).\n485\t        \"\"\"\n486\t        game = create_game(scripts=([], []))\n487\t        p1 = game.players[0]\n488\t        p2 = game.players[1]\n489\t        dragon = SilverquillTheDisputant(owner=p1, controller=p1)\n490\t        fodder = _make_creature(\"Fodder\", 2, 2, owner=p1)\n491\t        opp_bolt = _make_instant(\"Opp Bolt\", owner=p2)\n492\t        set_board_state(game, 0, battlefield=[dragon, fodder])\n493\t        # Opponent's spell on the stack.\n494\t        spell_so = _spell_stack_object(opp_bolt, p2)\n495\t        game.stack.push(spell_so)\n496\t\n497\t        made_copy = dragon.offer_casualty(game, spell_so)\n498\t\n499\t        assert made_copy is False\n500\t        # No sacrifice, only the opponent's spell remains.\n501\t        assert game.get_battlefield(p1).contains(fodder)\n502\t        spell_objs = [so for so in game.stack.objects() if getattr(so, \"is_spell\", False)]\n503\t        assert len(spell_objs) == 1\n504\t        # No prompt issued to the dragon's controller.\n505\t        assert p1.remaining_choices == 0\n506\t\n507\t    def test_casualty_not_offered_for_noninstant_sorcery_spell(self) -> None:\n508\t        \"\"\"Casualty only applies to instant/sorcery spells, not creature spells.\"\"\"\n509\t        game = create_game(scripts=([], []))\n510\t        p1 = game.players[0]\n511\t        dragon = SilverquillTheDisputant(owner=p1, controller=p1)\n512\t        fodder = _make_creature(\"Fodder\", 2, 2, owner=p1)\n513\t        creature_spell = _make_creature(\"Cast Bear\", 2, 2, owner=p1)\n514\t        set_board_state(game, 0, battlefield=[dragon, fodder])\n515\t        spell_so = _spell_stack_object(creature_spell, p1)\n516\t        game.stack.push(spell_so)\n517\t\n518\t        made_copy = dragon.offer_casualty(game, spell_so)\n519\t\n520\t        assert made_copy is False\n521\t        assert game.get_battlefield(p1).contains(fodder)\n522\t        assert p1.remaining_choices == 0\n523\t\n524\t\n525\t# ---------------------------------------------------------------------------\n526\t# Integration: casting an instant while the dragon is in play\n527\t# ---------------------------------------------------------------------------\n528\t\n529\t\n530\tclass TestSilverquillCastingIntegration:\n531\t    \"\"\"End-to-end: the casualty offer composes with the REAL cast pipeline.\n532\t\n533\t    A real ``engine.casting.cast_spell`` puts the instant on the stack as a\n534\t    spell StackObject (``is_spell=True``). We then drive the documented\n535\t    ``offer_casualty`` surface against *that* real StackObject, proving the\n536\t    casualty offer + ``copy_spell`` works on top of an actually-cast spell\n537\t    (not a hand-built StackObject). Whether the card additionally wires this\n538\t    offer to fire *automatically* during ``cast_spell`` depends on an engine\n539\t    hook that is not yet present — see untestable.json.\n540\t    \"\"\"\n541\t\n542\t    def test_offer_casualty_on_really_cast_spell(self) -> None:\n543\t        game = create_game(scripts=([], []))\n544\t        p1 = game.players[0]\n545\t        dragon = SilverquillTheDisputant(owner=p1, controller=p1)\n546\t        fodder = _make_creature(\"Fodder\", 1, 1, owner=p1)\n547\t        bolt = _make_instant(\"Integration Bolt\", owner=p1)\n548\t        set_board_state(\n549\t            game,\n550\t            0,\n551\t            battlefield=[dragon, fodder],\n552\t            hand=[bolt],\n553\t            mana={ManaType.RED: 1},\n554\t        )\n555\t        game.active_player_index = 0\n556\t        game.priority_player_index = 0\n557\t        game.phase = Phase.PRECOMBAT_MAIN\n558\t        game.step = None\n559\t\n560\t        # Cast the instant for real (no casualty wiring assumed here).\n561\t        engine_cast_spell(game, p1, bolt)\n562\t        # Locate the real StackObject the engine pushed for this spell.\n563\t        cast_so = next(\n564\t            so for so in game.stack.objects()\n565\t            if getattr(so, \"is_spell\", False) and so.source is bolt\n566\t        )\n567\t        assert cast_so.controller is p1\n568\t\n569\t        # Now drive the granted casualty offer against the genuine cast spell.\n570\t        p1._script.append(True)    # pay casualty\n571\t        p1._script.append(fodder)  # sacrifice\n572\t        p1._script.append(False)   # keep same targets\n573\t\n574\t        made_copy = dragon.offer_casualty(game, cast_so)\n575\t\n576\t        assert made_copy is True\n577\t        # The fodder is gone and a copy of the bolt exists alongside the original.\n578\t        assert game.get_graveyard(p1).contains(fodder)\n579\t        spell_objs = [so for so in game.stack.objects() if getattr(so, \"is_spell\", False)]\n580\t        sources = [so.source for so in spell_objs]\n581\t        assert bolt in sources\n582\t        # original + copy\n583\t        assert len(spell_objs) == 2\n584\t"}]},"parent_tool_use_id":"toolu_01AnMfFdRfg114k3p8WJq1hq","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"72fb86a3-1822-443e-9abc-7af7c4ca849b","timestamp":"2026-06-02T01:40:01.863Z","subagent_type":"Implementer","task_description":"Implement sos_226 Silverquill + casualty"}
