{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PjWMHaNTJ8kdj2Vjo6p9hs","type":"tool_result","content":"1\t\"\"\"Tests for SOS 97 — Ral Zarek, Guest Lecturer.\n2\t\n3\tRal Zarek, Guest Lecturer is a Legendary Planeswalker — Ral, {1}{B}{B},\n4\tstarting loyalty 3, with four loyalty abilities:\n5\t\n6\t    +1: Surveil 2.\n7\t    −1: Any number of target players each discard a card.\n8\t    −2: Return target creature card with mana value 3 or less from your\n9\t        graveyard to the battlefield.\n10\t    −7: Flip five coins. Target opponent skips their next X turns, where X\n11\t        is the number of coins that came up heads.\n12\t\n13\tThe engine's planeswalker contract (see ``cards/fdn/fdn_44`` / ``fdn_234``):\n14\t``get_loyalty_abilities()`` returns a list of ``LoyaltyAbility`` objects whose\n15\t``effect`` closures read ``pw.controller`` and, for targeted abilities, a\n16\t``pw._resolve_target`` (single) / ``pw._resolve_targets`` (list) attribute that\n17\ttest code sets directly. These tests exercise each ability's ``effect`` in\n18\tisolation by setting those attributes and calling ``effect(game)``.\n19\t\n20\tSurveil decisions are exercised through the controller's ``choose_yes_no``\n21\tchannel. The −7 ultimate now has a deterministic engine surface: coin flips go\n22\tthrough ``engine.game.flip_coin`` / ``flip_coins`` whose result a test forces\n23\tvia ``game._forced_coin_flips`` (a deque of booleans consumed from the front),\n24\tthe resolved heads count is recorded on ``pw._last_heads``, and the enforced\n25\tturn-skipping is observed through ``Player.skipped_turns`` and the turn rotation\n26\tin ``GameState.advance_phase`` / ``_select_next_active_player``. Both previously\n27\tengine-blocked pieces (exact coin-flip X and enforced turn-skipping) are now\n28\tasserted directly — see ``TestRalZarekUltimateDeterministic``.\n29\t\"\"\"\n30\t\n31\tfrom __future__ import annotations\n32\t\n33\tfrom collections import deque\n34\t\n35\tfrom cards.sos.sos_97.card_impl import RalZarekGuestLecturer\n36\tfrom engine.card import Creature, LoyaltyAbility, Planeswalker\n37\tfrom engine.types import CardType, ManaCost, Phase, Step, Supertype, Zone\n38\tfrom test_utils import create_game, set_board_state\n39\t\n40\t\n41\t# ---------------------------------------------------------------------------\n42\t# Helpers\n43\t# ---------------------------------------------------------------------------\n44\t\n45\tdef _make_creature_card(name: str, mv: int, owner=None):\n46\t    \"\"\"A creature *card* (not yet a permanent) with mana value ``mv``.\n47\t\n48\t    Mana value is encoded entirely as generic mana so ``mana_cost.cmc == mv``.\n49\t    \"\"\"\n50\t    card = Creature(\n51\t        name=name,\n52\t        base_power=1,\n53\t        base_toughness=1,\n54\t        mana_cost=ManaCost.parse(f\"{{{mv}}}\") if mv > 0 else ManaCost(),\n55\t        owner=owner,\n56\t        controller=owner,\n57\t    )\n58\t    card.card_types = {CardType.CREATURE}\n59\t    return card\n60\t\n61\t\n62\tdef _vanilla_library_card(name: str, owner=None):\n63\t    \"\"\"A plain card object usable as a library card for surveil tests.\"\"\"\n64\t    card = Creature(name=name, base_power=2, base_toughness=2, owner=owner, controller=owner)\n65\t    card.card_types = {CardType.CREATURE}\n66\t    return card\n67\t\n68\t\n69\tdef _ability_by_cost(pw, cost: int) -> LoyaltyAbility:\n70\t    \"\"\"Return the single loyalty ability whose ``loyalty_cost`` equals *cost*.\"\"\"\n71\t    matches = [a for a in pw.get_loyalty_abilities() if a.loyalty_cost == cost]\n72\t    assert len(matches) == 1, f\"expected exactly one ability with cost {cost}\"\n73\t    return matches[0]\n74\t\n75\t\n76\t# ---------------------------------------------------------------------------\n77\t# Static card properties\n78\t# ---------------------------------------------------------------------------\n79\t\n80\tclass TestRalZarekProperties:\n81\t    \"\"\"Static card data should match the SOS 97 spec.\"\"\"\n82\t\n83\t    def test_is_planeswalker(self) -> None:\n84\t        assert isinstance(RalZarekGuestLecturer(owner=None), Planeswalker)\n85\t\n86\t    def test_card_type_is_planeswalker(self) -> None:\n87\t        card = RalZarekGuestLecturer(owner=None)\n88\t        assert CardType.PLANESWALKER in card.card_types\n89\t\n90\t    def test_name(self) -> None:\n91\t        assert RalZarekGuestLecturer(owner=None).name == \"Ral Zarek, Guest Lecturer\"\n92\t\n93\t    def test_mana_cost(self) -> None:\n94\t        card = RalZarekGuestLecturer(owner=None)\n95\t        assert card.mana_cost == ManaCost.parse(\"{1}{B}{B}\")\n96\t\n97\t    def test_is_legendary(self) -> None:\n98\t        card = RalZarekGuestLecturer(owner=None)\n99\t        assert Supertype.LEGENDARY in card.supertypes\n100\t\n101\t    def test_has_ral_subtype(self) -> None:\n102\t        card = RalZarekGuestLecturer(owner=None)\n103\t        assert \"Ral\" in card.subtypes\n104\t\n105\t    def test_starting_loyalty_is_three(self) -> None:\n106\t        card = RalZarekGuestLecturer(owner=None)\n107\t        assert card.starting_loyalty == 3\n108\t\n109\t    def test_current_loyalty_initialised_to_three(self) -> None:\n110\t        card = RalZarekGuestLecturer(owner=None)\n111\t        assert card.loyalty == 3\n112\t\n113\t\n114\t# ---------------------------------------------------------------------------\n115\t# Loyalty ability declaration\n116\t# ---------------------------------------------------------------------------\n117\t\n118\tclass TestRalZarekLoyaltyAbilityShape:\n119\t    \"\"\"get_loyalty_abilities() declares the four printed abilities.\"\"\"\n120\t\n121\t    def test_returns_four_abilities(self) -> None:\n122\t        abilities = RalZarekGuestLecturer(owner=None).get_loyalty_abilities()\n123\t        assert len(abilities) == 4\n124\t\n125\t    def test_all_are_loyalty_abilities(self) -> None:\n126\t        abilities = RalZarekGuestLecturer(owner=None).get_loyalty_abilities()\n127\t        for a in abilities:\n128\t            assert isinstance(a, LoyaltyAbility)\n129\t\n130\t    def test_loyalty_costs_match_printed_values(self) -> None:\n131\t        abilities = RalZarekGuestLecturer(owner=None).get_loyalty_abilities()\n132\t        costs = sorted(a.loyalty_cost for a in abilities)\n133\t        assert costs == [-7, -2, -1, 1]\n134\t\n135\t\n136\t# ---------------------------------------------------------------------------\n137\t# +1: Surveil 2\n138\t# ---------------------------------------------------------------------------\n139\t\n140\tclass TestRalZarekSurveil:\n141\t    \"\"\"+1 surveils 2: look at top two cards of the controller's library, put\n142\t    any number into the graveyard and the rest back on top.\n143\t\n144\t    The per-card keep/bin decision is taken via the controller's\n145\t    ``choose_yes_no`` (the codebase's standard \"you may\" decision channel).\n146\t    \"\"\"\n147\t\n148\t    def test_surveil_keeping_both_leaves_library_size_unchanged(self) -> None:\n149\t        game = create_game()\n150\t        p1 = game.players[0]\n151\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n152\t\n153\t        top = _vanilla_library_card(\"Top Card\", owner=p1)\n154\t        second = _vanilla_library_card(\"Second Card\", owner=p1)\n155\t        # Library bottom -> top: [filler, second, top]; top of library is last.\n156\t        filler = _vanilla_library_card(\"Filler\", owner=p1)\n157\t        lib = p1.zones[Zone.LIBRARY]\n158\t        for c in (filler, second, top):\n159\t            lib.add(c)\n160\t\n161\t        before_lib = len(lib)\n162\t        before_gy = len(p1.zones[Zone.GRAVEYARD])\n163\t\n164\t        # Decline to bin either of the surveilled cards.\n165\t        p1._script.extend([False, False])\n166\t        _ability_by_cost(pw, +1).effect(game)\n167\t\n168\t        assert len(lib) == before_lib\n169\t        assert len(p1.zones[Zone.GRAVEYARD]) == before_gy\n170\t\n171\t    def test_surveil_binning_both_moves_them_to_graveyard(self) -> None:\n172\t        game = create_game()\n173\t        p1 = game.players[0]\n174\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n175\t\n176\t        top = _vanilla_library_card(\"Top Card\", owner=p1)\n177\t        second = _vanilla_library_card(\"Second Card\", owner=p1)\n178\t        filler = _vanilla_library_card(\"Filler\", owner=p1)\n179\t        lib = p1.zones[Zone.LIBRARY]\n180\t        for c in (filler, second, top):\n181\t            lib.add(c)\n182\t\n183\t        # Bin both of the surveilled (top two) cards.\n184\t        p1._script.extend([True, True])\n185\t        _ability_by_cost(pw, +1).effect(game)\n186\t\n187\t        gy_objs = p1.zones[Zone.GRAVEYARD].get_all()\n188\t        assert top in gy_objs\n189\t        assert second in gy_objs\n190\t        # The filler underneath the top two is untouched.\n191\t        assert lib.contains(filler)\n192\t\n193\t    def test_surveil_never_moves_cards_to_hand(self) -> None:\n194\t        \"\"\"Surveil only touches library/graveyard — never hand.\"\"\"\n195\t        game = create_game()\n196\t        p1 = game.players[0]\n197\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n198\t\n199\t        for i in range(2):\n200\t            p1.zones[Zone.LIBRARY].add(_vanilla_library_card(f\"C{i}\", owner=p1))\n201\t\n202\t        before_hand = len(p1.zones[Zone.HAND])\n203\t        p1._script.extend([False, False])\n204\t        _ability_by_cost(pw, +1).effect(game)\n205\t        assert len(p1.zones[Zone.HAND]) == before_hand\n206\t\n207\t    def test_surveil_with_empty_library_is_a_safe_noop(self) -> None:\n208\t        game = create_game()\n209\t        p1 = game.players[0]\n210\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n211\t        # Empty library — surveil 2 must not raise.\n212\t        _ability_by_cost(pw, +1).effect(game)\n213\t        assert len(p1.zones[Zone.LIBRARY]) == 0\n214\t\n215\t\n216\t# ---------------------------------------------------------------------------\n217\t# −1: Any number of target players each discard a card\n218\t# ---------------------------------------------------------------------------\n219\t\n220\tclass TestRalZarekDiscard:\n221\t    \"\"\"−1 makes each targeted player discard a card.\"\"\"\n222\t\n223\t    def test_targeted_opponent_discards_a_card(self) -> None:\n224\t        game = create_game()\n225\t        p1, p2 = game.players\n226\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n227\t\n228\t        opp_card = _vanilla_library_card(\"Opp Hand Card\", owner=p2)\n229\t        set_board_state(game, 1, hand=[opp_card])\n230\t\n231\t        before = len(p2.zones[Zone.HAND])\n232\t        pw._resolve_targets = [p2]\n233\t        # If the implementation prompts which card to discard, give it the card.\n234\t        p2._script.appendleft(opp_card)\n235\t        _ability_by_cost(pw, -1).effect(game)\n236\t\n237\t        assert len(p2.zones[Zone.HAND]) == before - 1\n238\t        assert p2.zones[Zone.GRAVEYARD].contains(opp_card)\n239\t\n240\t    def test_both_targeted_players_each_discard(self) -> None:\n241\t        game = create_game()\n242\t        p1, p2 = game.players\n243\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n244\t\n245\t        c1 = _vanilla_library_card(\"P1 Hand Card\", owner=p1)\n246\t        c2 = _vanilla_library_card(\"P2 Hand Card\", owner=p2)\n247\t        set_board_state(game, 0, hand=[c1])\n248\t        set_board_state(game, 1, hand=[c2])\n249\t\n250\t        pw._resolve_targets = [p1, p2]\n251\t        p1._script.appendleft(c1)\n252\t        p2._script.appendleft(c2)\n253\t        _ability_by_cost(pw, -1).effect(game)\n254\t\n255\t        assert len(p1.zones[Zone.HAND]) == 0\n256\t        assert len(p2.zones[Zone.HAND]) == 0\n257\t\n258\t    def test_no_targets_chosen_is_a_noop(self) -> None:\n259\t        \"\"\"\"Any number\" permits zero targets — nobody discards.\"\"\"\n260\t        game = create_game()\n261\t        p1, p2 = game.players\n262\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n263\t\n264\t        c2 = _vanilla_library_card(\"P2 Hand Card\", owner=p2)\n265\t        set_board_state(game, 1, hand=[c2])\n266\t\n267\t        pw._resolve_targets = []\n268\t        _ability_by_cost(pw, -1).effect(game)\n269\t        # Untargeted player keeps their card.\n270\t        assert p2.zones[Zone.HAND].contains(c2)\n271\t\n272\t    def test_targeted_player_with_empty_hand_is_safe(self) -> None:\n273\t        game = create_game()\n274\t        p1, p2 = game.players\n275\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n276\t        set_board_state(game, 1, hand=[])\n277\t        pw._resolve_targets = [p2]\n278\t        # Must not raise even though the player has nothing to discard.\n279\t        _ability_by_cost(pw, -1).effect(game)\n280\t        assert len(p2.zones[Zone.GRAVEYARD]) == 0\n281\t\n282\t\n283\t# ---------------------------------------------------------------------------\n284\t# −2: Return target creature card with mana value 3 or less from your\n285\t#     graveyard to the battlefield\n286\t# ---------------------------------------------------------------------------\n287\t\n288\tclass TestRalZarekReanimate:\n289\t    \"\"\"−2 returns a low-mana-value creature card from the controller's own\n290\t    graveyard to the battlefield.\"\"\"\n291\t\n292\t    def test_returns_mv3_creature_to_battlefield(self) -> None:\n293\t        game = create_game()\n294\t        p1 = game.players[0]\n295\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n296\t\n297\t        target = _make_creature_card(\"Goblin\", mv=3, owner=p1)\n298\t        set_board_state(game, 0, graveyard=[target])\n299\t\n300\t        pw._resolve_target = target\n301\t        _ability_by_cost(pw, -2).effect(game)\n302\t\n303\t        assert game.get_battlefield(p1).contains(target)\n304\t        assert not p1.zones[Zone.GRAVEYARD].contains(target)\n305\t\n306\t    def test_zero_mana_value_creature_is_legal(self) -> None:\n307\t        game = create_game()\n308\t        p1 = game.players[0]\n309\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n310\t\n311\t        target = _make_creature_card(\"Ornithopter\", mv=0, owner=p1)\n312\t        set_board_state(game, 0, graveyard=[target])\n313\t\n314\t        pw._resolve_target = target\n315\t        _ability_by_cost(pw, -2).effect(game)\n316\t        assert game.get_battlefield(p1).contains(target)\n317\t\n318\t    def test_mana_value_four_creature_is_not_returned(self) -> None:\n319\t        \"\"\"Mana value 4 exceeds the \"3 or less\" filter — the effect must not\n320\t        move the card to the battlefield.\"\"\"\n321\t        game = create_game()\n322\t        p1 = game.players[0]\n323\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n324\t\n325\t        target = _make_creature_card(\"Big Beast\", mv=4, owner=p1)\n326\t        set_board_state(game, 0, graveyard=[target])\n327\t\n328\t        pw._resolve_target = target\n329\t        _ability_by_cost(pw, -2).effect(game)\n330\t\n331\t        assert not game.get_battlefield(p1).contains(target)\n332\t\n333\t    def test_noncreature_card_is_not_returned(self) -> None:\n334\t        \"\"\"Only creature cards are legal targets.\"\"\"\n335\t        from engine.card import Sorcery\n336\t\n337\t        game = create_game()\n338\t        p1 = game.players[0]\n339\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n340\t\n341\t        sorc = Sorcery(name=\"Cheap Sorcery\", mana_cost=ManaCost.parse(\"{1}\"), owner=p1, controller=p1)\n342\t        set_board_state(game, 0, graveyard=[sorc])\n343\t\n344\t        pw._resolve_target = sorc\n345\t        _ability_by_cost(pw, -2).effect(game)\n346\t        assert not game.get_battlefield(p1).contains(sorc)\n347\t\n348\t    def test_no_target_is_a_noop(self) -> None:\n349\t        game = create_game()\n350\t        p1 = game.players[0]\n351\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n352\t        target = _make_creature_card(\"Goblin\", mv=2, owner=p1)\n353\t        set_board_state(game, 0, graveyard=[target])\n354\t        # No _resolve_target set -> nothing happens.\n355\t        _ability_by_cost(pw, -2).effect(game)\n356\t        assert p1.zones[Zone.GRAVEYARD].contains(target)\n357\t\n358\t\n359\t# ---------------------------------------------------------------------------\n360\t# −7: Flip five coins. Target opponent skips their next X turns.\n361\t# ---------------------------------------------------------------------------\n362\t\n363\tclass TestRalZarekUltimate:\n364\t    \"\"\"−7's structural contract: it exists at loyalty cost −7 and runs without\n365\t    raising when a target opponent is supplied. The randomised X (heads count)\n366\t    and enforced turn-skipping are asserted deterministically in\n367\t    ``TestRalZarekUltimateDeterministic`` below.\"\"\"\n368\t\n369\t    def test_ultimate_loyalty_cost_is_minus_seven(self) -> None:\n370\t        pw = RalZarekGuestLecturer(owner=None)\n371\t        ability = _ability_by_cost(pw, -7)\n372\t        assert ability.loyalty_cost == -7\n373\t\n374\t    def test_ultimate_runs_with_target_opponent(self) -> None:\n375\t        game = create_game()\n376\t        p1, p2 = game.players\n377\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n378\t        pw._resolve_target = p2\n379\t        # Five coin flips + skip scheduling must execute without raising.\n380\t        _ability_by_cost(pw, -7).effect(game)\n381\t\n382\t    def test_ultimate_with_no_target_is_a_safe_noop(self) -> None:\n383\t        game = create_game()\n384\t        p1 = game.players[0]\n385\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n386\t        # No target -> must not raise and must not break game state.\n387\t        _ability_by_cost(pw, -7).effect(game)\n388\t        assert game.is_game_over is False\n389\t\n390\t\n391\t# ---------------------------------------------------------------------------\n392\t# −7 (deterministic): X == heads, head-count parametrisation, enforced skips,\n393\t#                     and the no-target no-op.\n394\t# ---------------------------------------------------------------------------\n395\t\n396\tdef _force_turn_wrap(game) -> None:\n397\t    \"\"\"Drive the turn rotation forward by exactly one turn boundary.\n398\t\n399\t    Jumps the game to the final step of the current turn (ENDING/CLEANUP) and\n400\t    calls ``advance_phase`` once. ``advance_phase`` only rotates the active\n401\t    player when it wraps past the last step of the sequence, so this exercises\n402\t    ``_select_next_active_player`` (and therefore the ``skipped_turns`` skip\n403\t    logic) deterministically without running full turns / priority loops.\n404\t    \"\"\"\n405\t    game.phase = Phase.ENDING\n406\t    game.step = Step.CLEANUP\n407\t    game.advance_phase()\n408\t\n409\t\n410\tclass TestRalZarekUltimateDeterministic:\n411\t    \"\"\"−7 with the deterministic coin-flip + skip-turn surface in place.\n412\t\n413\t    Coin flips are forced via ``game._forced_coin_flips`` (a deque of booleans\n414\t    consumed from the front; truthy == heads). The resolved heads count is read\n415\t    from ``pw._last_heads`` and the scheduled skips from the target opponent's\n416\t    ``Player.skipped_turns``. Turn enforcement is observed through\n417\t    ``GameState.advance_phase`` / ``_select_next_active_player``.\n418\t    \"\"\"\n419\t\n420\t    def test_x_equals_heads_count_and_schedules_that_many_skips(self) -> None:\n421\t        \"\"\"Forced sequence with 3 heads -> X == 3, opponent skips 3 turns.\"\"\"\n422\t        game = create_game()\n423\t        p1, p2 = game.players\n424\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n425\t        pw._resolve_target = p2\n426\t\n427\t        # 5 flips, exactly 3 heads (truthy values).\n428\t        game._forced_coin_flips = deque([True, False, True, True, False])\n429\t        _ability_by_cost(pw, -7).effect(game)\n430\t\n431\t        assert pw._last_heads == 3\n432\t        assert p2.skipped_turns == 3\n433\t\n434\t    def test_all_heads_schedules_five_skips(self) -> None:\n435\t        \"\"\"All five coins heads -> X == 5.\"\"\"\n436\t        game = create_game()\n437\t        p1, p2 = game.players\n438\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n439\t        pw._resolve_target = p2\n440\t\n441\t        game._forced_coin_flips = deque([True, True, True, True, True])\n442\t        _ability_by_cost(pw, -7).effect(game)\n443\t\n444\t        assert pw._last_heads == 5\n445\t        assert p2.skipped_turns == 5\n446\t\n447\t    def test_all_tails_schedules_no_skips(self) -> None:\n448\t        \"\"\"All five coins tails -> X == 0, opponent skips nothing.\"\"\"\n449\t        game = create_game()\n450\t        p1, p2 = game.players\n451\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n452\t        pw._resolve_target = p2\n453\t\n454\t        game._forced_coin_flips = deque([False, False, False, False, False])\n455\t        _ability_by_cost(pw, -7).effect(game)\n456\t\n457\t        assert pw._last_heads == 0\n458\t        assert p2.skipped_turns == 0\n459\t\n460\t    def test_skip_counter_is_additive_across_two_ultimates(self) -> None:\n461\t        \"\"\"A second −7 adds to (does not overwrite) the existing skip count.\"\"\"\n462\t        game = create_game()\n463\t        p1, p2 = game.players\n464\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n465\t        pw._resolve_target = p2\n466\t\n467\t        game._forced_coin_flips = deque([True, True, False, False, False])  # 2\n468\t        _ability_by_cost(pw, -7).effect(game)\n469\t        assert p2.skipped_turns == 2\n470\t\n471\t        game._forced_coin_flips = deque([True, False, False, False, False])  # 1\n472\t        _ability_by_cost(pw, -7).effect(game)\n473\t        assert pw._last_heads == 1\n474\t        assert p2.skipped_turns == 3\n475\t\n476\t    def test_opponent_is_not_active_while_skip_counter_positive(self) -> None:\n477\t        \"\"\"While the opponent owes skips they never become the active player;\n478\t        the counter decrements once per skipped turn slot.\"\"\"\n479\t        game = create_game()\n480\t        p1, p2 = game.players  # p1 == seat 0 (active), p2 == seat 1\n481\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n482\t        pw._resolve_target = p2\n483\t\n484\t        # Force exactly 2 heads -> opponent skips their next 2 turns.\n485\t        game._forced_coin_flips = deque([True, True, False, False, False])\n486\t        _ability_by_cost(pw, -7).effect(game)\n487\t        assert p2.skipped_turns == 2\n488\t\n489\t        # Turn 1: seat 0 active. The next two turn boundaries would each hand\n490\t        # seat 1 a turn, but both are skipped -> seat 0 stays active and the\n491\t        # counter decrements each time.\n492\t        assert game.active_player_index == 0\n493\t\n494\t        _force_turn_wrap(game)\n495\t        assert game.active_player_index == 0          # p2's turn was skipped\n496\t        assert p2.skipped_turns == 1\n497\t\n498\t        _force_turn_wrap(game)\n499\t        assert game.active_player_index == 0          # second skip consumed\n500\t        assert p2.skipped_turns == 0\n501\t\n502\t    def test_opponent_takes_a_normal_turn_after_skips_are_exhausted(self) -> None:\n503\t        \"\"\"Once the skip counter reaches 0 the opponent resumes normal turns.\"\"\"\n504\t        game = create_game()\n505\t        p1, p2 = game.players\n506\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n507\t        pw._resolve_target = p2\n508\t\n509\t        game._forced_coin_flips = deque([True, True, False, False, False])  # 2\n510\t        _ability_by_cost(pw, -7).effect(game)\n511\t        assert p2.skipped_turns == 2\n512\t\n513\t        # Burn through both skipped slots.\n514\t        _force_turn_wrap(game)\n515\t        _force_turn_wrap(game)\n516\t        assert p2.skipped_turns == 0\n517\t        assert game.active_player_index == 0\n518\t\n519\t        # The next boundary is no longer skipped: seat 1 (the opponent) finally\n520\t        # becomes the active player.\n521\t        _force_turn_wrap(game)\n522\t        assert game.active_player_index == 1\n523\t        assert p2.skipped_turns == 0\n524\t\n525\t    def test_no_target_flips_but_schedules_no_skip(self) -> None:\n526\t        \"\"\"With no chosen target the −7 still flips (records X) but nobody's\n527\t        skip counter increases — a safe no-op on the skip side.\"\"\"\n528\t        game = create_game()\n529\t        p1, p2 = game.players\n530\t        pw = RalZarekGuestLecturer(owner=p1, controller=p1)\n531\t        # Deliberately no pw._resolve_target.\n532\t\n533\t        game._forced_coin_flips = deque([True, True, False, True, False])  # 3\n534\t        _ability_by_cost(pw, -7).effect(game)\n535\t\n536\t        # Flips still happened and were recorded.\n537\t        assert pw._last_heads == 3\n538\t        # But nobody was scheduled to skip.\n539\t        assert p1.skipped_turns == 0\n540\t        assert p2.skipped_turns == 0\n541\t"}]},"parent_tool_use_id":"toolu_019FjC3Yg4WQJQBFnLquD2dB","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"884c3241-0473-4c11-a792-ed6f2d249092","timestamp":"2026-06-02T00:54:35.371Z","subagent_type":"Reviewer","task_description":"Review sos_97 implementation"}
