{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Un9ARnEMogrMqvVsdcvbCm","type":"tool_result","content":"1\t\"\"\"Card implementation for Emeritus of Truce // Swords to Plowshares (SOS #13).\n2\t\n3\tThis is a *preparation card* (CR 722).  The front face is the creature\n4\t**Emeritus of Truce** ({1}{W}{W}, 3/3 Cat Cleric) and the inset \"prepare\n5\tspell\" is **Swords to Plowshares** ({W} instant — exile target creature, its\n6\tcontroller gains life equal to its power).\n7\t\n8\tThe engine has no native \"Prepared\" designation, so this implementation models\n9\tthe mechanic with a small, additive, card-local surface (mandated by the\n10\tcoordinator directives):\n11\t\n12\t* ``prepared`` — a boolean attribute (default ``False``); also exposed via the\n13\t  read-only ``is_prepared`` alias property.  Set ``True`` during ETB resolution\n14\t  only when an opponent controls strictly more creatures than the controller,\n15\t  evaluated *after* the Inkling token is created (CR 722.3a).\n16\t* ``make_prepare_spell(game)`` — factory returning a castable Swords to\n17\t  Plowshares :class:`~engine.card.Instant` whose resolution exiles its chosen\n18\t  target creature and grants THAT creature's controller life equal to the\n19\t  exiled creature's power.  A no-target resolution is a safe no-op.\n20\t* ``cast_prepare_spell(game, target=...)`` — requires ``prepared is True``,\n21\t  casts/resolves a fresh copy of the prepare spell \"without paying its mana\n22\t  cost\", then unprepares the permanent (``prepared = False``) per CR 722.3c.\n23\t\"\"\"\n24\t\n25\tfrom __future__ import annotations\n26\t\n27\tfrom typing import TYPE_CHECKING, Any\n28\t\n29\tfrom engine.card import Creature, Instant\n30\tfrom engine.types import CardType, Keyword, ManaCost, Zone\n31\t\n32\tif TYPE_CHECKING:\n33\t    from engine.game_state import GameState\n34\t\n35\t\n36\tdef _is_creature(obj: Any) -> bool:\n37\t    \"\"\"Return ``True`` if *obj* is a creature object.\"\"\"\n38\t    return CardType.CREATURE in getattr(obj, \"card_types\", set())\n39\t\n40\t\n41\tclass SwordsToPlowshares(Instant):\n42\t    \"\"\"Swords to Plowshares — {W} Instant (the inset prepare spell).\n43\t\n44\t    \"Exile target creature. Its controller gains life equal to its power.\"\n45\t\n46\t    The target is read from :attr:`chosen_targets`.  Resolving with no chosen\n47\t    target is a safe no-op (no exile, no life change, no raise).\n48\t    \"\"\"\n49\t\n50\t    def __init__(self, **kwargs: Any) -> None:\n51\t        kwargs.setdefault(\"name\", \"Swords to Plowshares\")\n52\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{W}\"))\n53\t        kwargs.setdefault(\n54\t            \"rules_text\",\n55\t            \"Exile target creature. Its controller gains life equal to its power.\",\n56\t        )\n57\t        super().__init__(**kwargs)\n58\t        # Single-letter color identity (the engine has no native colors field).\n59\t        self.colors: list[str] = [\"W\"]\n60\t\n61\t    def on_resolve(self, game: \"GameState\") -> None:\n62\t        \"\"\"Exile the target creature; its controller gains life equal to power.\"\"\"\n63\t        from engine.game import exile\n64\t\n65\t        targets = getattr(self, \"chosen_targets\", None) or []\n66\t        victim = targets[0] if targets else None\n67\t        if victim is None or not _is_creature(victim):\n68\t            # No legal target — safe no-op.\n69\t            return\n70\t\n71\t        # Snapshot power and controller before the creature leaves play.\n72\t        power = getattr(victim, \"power\", getattr(victim, \"base_power\", 0)) or 0\n73\t        victim_controller = getattr(victim, \"controller\", None)\n74\t\n75\t        exile(game, victim)\n76\t\n77\t        if victim_controller is not None and hasattr(victim_controller, \"life\"):\n78\t            victim_controller.life += power\n79\t\n80\t\n81\tclass EmeritusOfTruceSwordsToPlowshares(Creature):\n82\t    \"\"\"Emeritus of Truce — {1}{W}{W} — 3/3 — Creature — Cat Cleric.\n83\t\n84\t    When this creature enters, target player creates a 1/1 white and black\n85\t    Inkling creature token with flying.  Then if an opponent controls more\n86\t    creatures than you, this creature becomes prepared.  (While it's prepared,\n87\t    you may cast a copy of its spell. Doing so unprepares it.)\n88\t\n89\t    SOS collector number 13 (preparation-card reference slot, CR 722).\n90\t    \"\"\"\n91\t\n92\t    def __init__(self, **kwargs: Any) -> None:\n93\t        kwargs.setdefault(\"name\", \"Emeritus of Truce // Swords to Plowshares\")\n94\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{W}{W}\"))\n95\t        kwargs.setdefault(\"subtypes\", {\"Cat\", \"Cleric\"})\n96\t        kwargs.setdefault(\"keywords\", Keyword(0))\n97\t        kwargs.setdefault(\"base_power\", 3)\n98\t        kwargs.setdefault(\"base_toughness\", 3)\n99\t        kwargs.setdefault(\n100\t            \"rules_text\",\n101\t            \"When this creature enters, target player creates a 1/1 white and \"\n102\t            \"black Inkling creature token with flying. Then if an opponent \"\n103\t            \"controls more creatures than you, this creature becomes prepared. \"\n104\t            \"(While it's prepared, you may cast a copy of its spell. Doing so \"\n105\t            \"unprepares it.)\",\n106\t        )\n107\t        super().__init__(**kwargs)\n108\t        # The engine has no native colors field — expose the front face's color.\n109\t        self.colors: list[str] = [\"W\"]\n110\t        # Preparation designation (CR 722.3a); default unprepared.\n111\t        self.prepared: bool = False\n112\t\n113\t    # ------------------------------------------------------------------\n114\t    # Prepared designation\n115\t    # ------------------------------------------------------------------\n116\t\n117\t    @property\n118\t    def is_prepared(self) -> bool:\n119\t        \"\"\"Read-only alias for :attr:`prepared` (CR 722 'prepared' marker).\"\"\"\n120\t        return self.prepared\n121\t\n122\t    # ------------------------------------------------------------------\n123\t    # ETB trigger: token creation + becomes-prepared comparison\n124\t    # ------------------------------------------------------------------\n125\t\n126\t    def register_triggers(self, game: \"GameState\") -> None:\n127\t        \"\"\"Register the enters-the-battlefield triggered ability.\"\"\"\n128\t        from engine.events import EntersBattlefieldTriggeredEvent\n129\t        from engine.triggers import TriggerRegistration\n130\t\n131\t        source = self\n132\t\n133\t        def _condition(game: Any, event: Any) -> bool:\n134\t            return getattr(event, \"permanent\", None) is source\n135\t\n136\t        def _effect(game: \"GameState\") -> None:\n137\t            self._resolve_etb(game)\n138\t\n139\t        controller = getattr(self, \"controller\", None) or game.active_player\n140\t        game.trigger_manager.register(\n141\t            TriggerRegistration(\n142\t                event_type=EntersBattlefieldTriggeredEvent,\n143\t                condition=_condition,\n144\t                effect=_effect,\n145\t                source=self,\n146\t                controller=controller,\n147\t            )\n148\t        )\n149\t\n150\t    def _resolve_etb(self, game: \"GameState\") -> None:\n151\t        \"\"\"Resolve the ETB: create the Inkling token, then check prepared.\n152\t\n153\t        The token is created BEFORE the \"more creatures than you\" comparison,\n154\t        so a token given to an opponent counts toward that opponent's total.\n155\t        \"\"\"\n156\t        from engine.game import create_token\n157\t\n158\t        controller = getattr(self, \"controller\", None)\n159\t        if controller is None:\n160\t            return\n161\t\n162\t        # 1. Target player creates a 1/1 white-and-black Inkling with flying.\n163\t        targets = getattr(self, \"chosen_targets\", None) or []\n164\t        target_player = targets[0] if targets else controller\n165\t\n166\t        token = Creature(\n167\t            name=\"Inkling\",\n168\t            subtypes={\"Inkling\"},\n169\t            keywords=Keyword.FLYING,\n170\t            base_power=1,\n171\t            base_toughness=1,\n172\t        )\n173\t        token.colors = [\"W\", \"B\"]\n174\t        create_token(game, target_player, token)\n175\t\n176\t        # 2. Then if an opponent controls more creatures than you, prepare.\n177\t        if self._opponent_controls_more_creatures(game, controller):\n178\t            self.prepared = True\n179\t\n180\t    @staticmethod\n181\t    def _creature_count(game: \"GameState\", player: Any) -> int:\n182\t        \"\"\"Number of creatures *player* controls on the battlefield.\"\"\"\n183\t        return sum(\n184\t            1\n185\t            for obj in game.get_battlefield(player).get_all()\n186\t            if _is_creature(obj)\n187\t        )\n188\t\n189\t    def _opponent_controls_more_creatures(\n190\t        self, game: \"GameState\", controller: Any\n191\t    ) -> bool:\n192\t        \"\"\"Return ``True`` iff some opponent controls strictly more creatures.\n193\t\n194\t        \"You\" are measured by the creatures you control other than Emeritus\n195\t        itself; the just-created Inkling token (if given to you) and any other\n196\t        creatures you control count, but the entering Emeritus does not.  Each\n197\t        opponent's count includes every creature they control (including a\n198\t        token granted to them).\n199\t        \"\"\"\n200\t        my_count = self._creature_count(game, controller)\n201\t        # The entering Emeritus does not count toward its controller's total.\n202\t        if game.get_battlefield(controller).contains(self):\n203\t            my_count -= 1\n204\t        for player in game.players:\n205\t            if player is controller:\n206\t                continue\n207\t            if self._creature_count(game, player) > my_count:\n208\t                return True\n209\t        return False\n210\t\n211\t    # ------------------------------------------------------------------\n212\t    # Prepare spell — Swords to Plowshares\n213\t    # ------------------------------------------------------------------\n214\t\n215\t    def make_prepare_spell(self, game: \"GameState\") -> SwordsToPlowshares:\n216\t        \"\"\"Return a castable copy of the Swords to Plowshares prepare spell.\n217\t\n218\t        The copy's controller/owner default to this permanent's controller\n219\t        (CR 722.3c: the prepared permanent's controller may cast the copy).\n220\t        \"\"\"\n221\t        controller = getattr(self, \"controller\", None)\n222\t        owner = getattr(self, \"owner\", None) or controller\n223\t        spell = SwordsToPlowshares(owner=owner, controller=controller)\n224\t        return spell\n225\t\n226\t    # ------------------------------------------------------------------\n227\t    # Cast-while-prepared + unprepare (CR 722.3c)\n228\t    # ------------------------------------------------------------------\n229\t\n230\t    def cast_prepare_spell(\n231\t        self,\n232\t        game: \"GameState\",\n233\t        target: Any | None = None,\n234\t    ) -> SwordsToPlowshares:\n235\t        \"\"\"Cast a copy of the prepare spell (free), then unprepare.\n236\t\n237\t        Requires :attr:`prepared` to be ``True`` (raises otherwise).  Resolves\n238\t        a fresh Swords to Plowshares copy against *target* (read from\n239\t        ``chosen_targets`` if not given) \"without paying its mana cost\", then\n240\t        clears the prepared designation (CR 722.3c).\n241\t\n242\t        Returns the resolved prepare-spell object.\n243\t        \"\"\"\n244\t        if not self.prepared:\n245\t            raise ValueError(\n246\t                \"Emeritus of Truce is not prepared; cannot cast its prepare spell.\"\n247\t            )\n248\t\n249\t        spell = self.make_prepare_spell(game)\n250\t        if target is not None:\n251\t            spell.chosen_targets = [target]\n252\t\n253\t        # The copy is cast \"without paying its mana cost\"; resolve it directly.\n254\t        spell.on_resolve(game)\n255\t\n256\t        # Casting the prepare spell unprepares the permanent (CR 722.3c).\n257\t        self.prepared = False\n258\t        return spell\n259\t"}]},"parent_tool_use_id":"toolu_014XeaoWYfsVtkKELfbWWq5K","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"e7cad27a-e2f5-4318-967a-51c2526e7ed1","timestamp":"2026-06-02T00:14:44.210Z","subagent_type":"Tester","task_description":"Extend & fix tests for sos_13"}
