one:\n                return\n            # Wrap the target's on_resolve so that after it resolves and the\n            # engine moves it to graveyard, we relocate it to exile. Simpler:\n            # override on_resolve to exile-instead at the end.\n            orig = target.on_resolve\n            def wrapped(g2, _orig=orig, _t=target, _ctrl=ctrl):\n                _orig(g2)\n                # After the engine puts it in graveyard, move it to exile.\n                # We schedule by overriding: easiest is to flag and move now,\n                # but the engine moves AFTER on_resolve. So pre-empt: nothing\n                # here; rely on a post-pass.\n            # Instead use the replacement approach against the stack->graveyard\n            # by registering against the spell going to graveyard from anywhere.\n            from engine.replacement_effects import ReplacementEffect\n            from engine.events import MoveToGraveyardReplacementEvent\n            cast_spell_free(g, ctrl, target, Zone.GRAVEYARD)\n            # Patch the just-pushed StackObject's on_resolve to exile-instead.\n            top = g.stack.peek()\n            orig_resolve = top.on_resolve\n            def new_resolve(g3, _t=target, _ctrl=ctrl, _src=source):\n                _t.on_resolve(g3)\n                # Remove from stack zone and exile instead of graveyard.\n                _ctrl.zones[Zone.STACK].remove(_t)\n                _ctrl.zones[Zone.EXILE].add(_t)\n            top.on_resolve = new_resolve\n        game.trigger_manager.register(TriggerRegistration(\n            event_type=AttacksTriggeredEvent, condition=cond, effect=effect,\n            source=self, controller=controller))\nEOF\ncp /tmp/ref_impl2.py /workspace/cards/sos/sos_1/card_impl.py\npython3 -m pytest /workspace/cards/sos/sos_1/tests.py -q 2>&1 | tail -8\ncp /tmp/stub_backup.py /workspace/cards/sos/sos_1/card_impl.py\necho \"=== stub restored ===\"","description":"Validate exile-replacement contract is satisfiable via 