{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WxiNNMEHMgDZDwKUH359gk","type":"tool_result","content":"1\t\"\"\"Tests for SOS 201 — Lorehold, the Historian.\n2\t\n3\tLorehold, the Historian is a {3}{R}{W} Legendary Creature — Elder Dragon\n4\twith power/toughness 5/5 and the following abilities:\n5\t\n6\t1. Flying, haste (evergreen keywords).\n7\t2. \"Each instant and sorcery card in your hand has miracle {2}.\" — a granted\n8\t   static ability (CR 702.94). The engine has no native draw-reveal-cast-for-\n9\t   miracle pipeline, so we test the observable portion of the contract: the\n10\t   card advertises the miracle cost ({2}) and stamps it onto the instant and\n11\t   sorcery cards in *its controller's* hand (and nothing else).\n12\t3. \"At the beginning of each opponent's upkeep, you may discard a card. If you\n13\t   do, draw a card.\" — an optional rummage-style triggered ability that fires\n14\t   only on an *opponent's* upkeep.\n15\t\n16\tThese tests target the public card contract (static data, keyword flags,\n17\tcombat-rule interactions through the engine, the trigger registration, and the\n18\ttrigger's effect). They are written before implementation (TDD red phase).\n19\t\"\"\"\n20\t\n21\tfrom __future__ import annotations\n22\t\n23\tfrom cards.sos.sos_201.card_impl import LoreholdTheHistorian\n24\tfrom engine.card import Creature, Instant, Land, Sorcery\n25\tfrom engine.combat import _can_attack, _can_block\n26\tfrom engine.events import BeginningOfUpkeepTriggeredEvent\n27\tfrom engine.types import (\n28\t    CardType,\n29\t    Keyword,\n30\t    ManaCost,\n31\t    Supertype,\n32\t    Zone,\n33\t)\n34\tfrom test_utils import create_game, set_board_state\n35\t\n36\t\n37\t# ---------------------------------------------------------------------------\n38\t# Static characteristics\n39\t# ---------------------------------------------------------------------------\n40\t\n41\t\n42\tclass TestLoreholdProperties:\n43\t    \"\"\"Static card data should match the SOS 201 spec.\"\"\"\n44\t\n45\t    def test_is_creature(self) -> None:\n46\t        assert isinstance(LoreholdTheHistorian(owner=None), Creature)\n47\t\n48\t    def test_name(self) -> None:\n49\t        assert LoreholdTheHistorian(owner=None).name == \"Lorehold, the Historian\"\n50\t\n51\t    def test_mana_cost(self) -> None:\n52\t        assert LoreholdTheHistorian(owner=None).mana_cost == ManaCost.parse(\"{3}{R}{W}\")\n53\t\n54\t    def test_power_toughness(self) -> None:\n55\t        card = LoreholdTheHistorian(owner=None)\n56\t        assert card.base_power == 5\n57\t        assert card.base_toughness == 5\n58\t\n59\t    def test_is_legendary(self) -> None:\n60\t        assert Supertype.LEGENDARY in LoreholdTheHistorian(owner=None).supertypes\n61\t\n62\t    def test_elder_dragon_subtypes(self) -> None:\n63\t        subtypes = LoreholdTheHistorian(owner=None).subtypes\n64\t        assert {\"Elder\", \"Dragon\"} <= subtypes\n65\t\n66\t    def test_colors_are_red_white(self) -> None:\n67\t        \"\"\"The spec lists colors R and W; cards advertise this via self.colors.\"\"\"\n68\t        colors = set(getattr(LoreholdTheHistorian(owner=None), \"colors\", []))\n69\t        assert colors == {\"R\", \"W\"}\n70\t\n71\t\n72\t# ---------------------------------------------------------------------------\n73\t# Flying + haste keywords\n74\t# ---------------------------------------------------------------------------\n75\t\n76\t\n77\tclass TestLoreholdKeywords:\n78\t    \"\"\"Flying and haste keyword flags and their combat-rule consequences.\"\"\"\n79\t\n80\t    def test_has_flying_and_haste(self) -> None:\n81\t        kw = LoreholdTheHistorian(owner=None).keywords\n82\t        assert Keyword.FLYING in kw\n83\t        assert Keyword.HASTE in kw\n84\t\n85\t    def test_haste_allows_attacking_while_summoning_sick(self) -> None:\n86\t        \"\"\"Haste lets a freshly-cast Lorehold attack the turn it arrives.\"\"\"\n87\t        card = LoreholdTheHistorian(owner=None)\n88\t        card.summoning_sick = True\n89\t        card.is_tapped = False\n90\t        assert _can_attack(card) is True\n91\t\n92\t    def test_ground_creature_cannot_block_flying_lorehold(self) -> None:\n93\t        attacker = LoreholdTheHistorian(owner=None)\n94\t        ground = Creature(name=\"Ground Bear\", base_power=2, base_toughness=2)\n95\t        ground.keywords = Keyword(0)\n96\t        ground.is_tapped = False\n97\t        assert _can_block(ground, attacker) is False\n98\t\n99\t    def test_flying_creature_can_block_flying_lorehold(self) -> None:\n100\t        attacker = LoreholdTheHistorian(owner=None)\n101\t        flier = Creature(name=\"Air Bear\", base_power=2, base_toughness=2)\n102\t        flier.keywords = Keyword.FLYING\n103\t        flier.is_tapped = False\n104\t        assert _can_block(flier, attacker) is True\n105\t\n106\t    def test_reach_creature_can_block_flying_lorehold(self) -> None:\n107\t        attacker = LoreholdTheHistorian(owner=None)\n108\t        spider = Creature(name=\"Spider\", base_power=1, base_toughness=4)\n109\t        spider.keywords = Keyword.REACH\n110\t        spider.is_tapped = False\n111\t        assert _can_block(spider, attacker) is True\n112\t\n113\t\n114\t# ---------------------------------------------------------------------------\n115\t# Miracle granting: \"Each instant and sorcery card in your hand has miracle {2}\"\n116\t# ---------------------------------------------------------------------------\n117\t\n118\t\n119\tdef _make_instant(name: str, owner=None) -> Instant:\n120\t    spell = Instant(name=name, mana_cost=ManaCost.parse(\"{3}{U}\"), owner=owner, controller=owner)\n121\t    return spell\n122\t\n123\t\n124\tdef _make_sorcery(name: str, owner=None) -> Sorcery:\n125\t    spell = Sorcery(name=name, mana_cost=ManaCost.parse(\"{4}{B}\"), owner=owner, controller=owner)\n126\t    return spell\n127\t\n128\t\n129\tclass TestLoreholdMiracleGrant:\n130\t    \"\"\"The granted miracle {2} static ability marks eligible hand cards.\n131\t\n132\t    The engine has no native miracle pipeline, so the card exposes the\n133\t    granting as a method (``grant_miracle(game)``) that stamps the miracle\n134\t    cost onto each instant/sorcery card in *its controller's* hand. These\n135\t    tests exercise that contract.\n136\t    \"\"\"\n137\t\n138\t    def test_miracle_cost_is_two_generic(self) -> None:\n139\t        \"\"\"The granted alternative cost is {2}.\"\"\"\n140\t        card = LoreholdTheHistorian(owner=None)\n141\t        assert card.MIRACLE_COST == ManaCost.parse(\"{2}\")\n142\t\n143\t    def test_grants_miracle_to_instant_in_controller_hand(self) -> None:\n144\t        game = create_game()\n145\t        p1 = game.players[0]\n146\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n147\t        bolt = _make_instant(\"Bolt\", owner=p1)\n148\t        set_board_state(game, 0, battlefield=[lorehold], hand=[bolt])\n149\t        lorehold.grant_miracle(game)\n150\t        assert bolt.miracle_cost == ManaCost.parse(\"{2}\")\n151\t\n152\t    def test_grants_miracle_to_sorcery_in_controller_hand(self) -> None:\n153\t        game = create_game()\n154\t        p1 = game.players[0]\n155\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n156\t        ritual = _make_sorcery(\"Ritual\", owner=p1)\n157\t        set_board_state(game, 0, battlefield=[lorehold], hand=[ritual])\n158\t        lorehold.grant_miracle(game)\n159\t        assert ritual.miracle_cost == ManaCost.parse(\"{2}\")\n160\t\n161\t    def test_does_not_grant_miracle_to_noncast_types_in_hand(self) -> None:\n162\t        \"\"\"Creatures and lands in hand are not instants/sorceries — no miracle.\"\"\"\n163\t        game = create_game()\n164\t        p1 = game.players[0]\n165\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n166\t        bear = Creature(name=\"Bear\", base_power=2, base_toughness=2, owner=p1, controller=p1)\n167\t        forest = Land(name=\"Forest\", owner=p1, controller=p1)\n168\t        set_board_state(game, 0, battlefield=[lorehold], hand=[bear, forest])\n169\t        lorehold.grant_miracle(game)\n170\t        assert getattr(bear, \"miracle_cost\", None) is None\n171\t        assert getattr(forest, \"miracle_cost\", None) is None\n172\t\n173\t    def test_does_not_grant_miracle_to_opponent_hand(self) -> None:\n174\t        \"\"\"'your hand' means the controller's hand, not the opponent's.\"\"\"\n175\t        game = create_game()\n176\t        p1 = game.players[0]\n177\t        p2 = game.players[1]\n178\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n179\t        opp_spell = _make_instant(\"Opp Bolt\", owner=p2)\n180\t        set_board_state(game, 0, battlefield=[lorehold])\n181\t        set_board_state(game, 1, hand=[opp_spell])\n182\t        lorehold.grant_miracle(game)\n183\t        assert getattr(opp_spell, \"miracle_cost\", None) is None\n184\t\n185\t\n186\t# ---------------------------------------------------------------------------\n187\t# Opponent's-upkeep loot trigger\n188\t# ---------------------------------------------------------------------------\n189\t\n190\t\n191\tclass TestLoreholdUpkeepTriggerRegistration:\n192\t    \"\"\"register_triggers wires a BeginningOfUpkeep trigger for this card.\"\"\"\n193\t\n194\t    def test_registers_an_upkeep_trigger(self) -> None:\n195\t        game = create_game()\n196\t        p1 = game.players[0]\n197\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n198\t        game.get_battlefield(p1).add(card)\n199\t        before = len(game.trigger_manager.get_triggers_for_source(card))\n200\t        card.register_triggers(game)\n201\t        after = game.trigger_manager.get_triggers_for_source(card)\n202\t        assert len(after) - before == 1\n203\t        assert after[0].event_type is BeginningOfUpkeepTriggeredEvent\n204\t        assert after[0].controller is p1\n205\t\n206\t\n207\tclass TestLoreholdUpkeepTriggerCondition:\n208\t    \"\"\"The trigger fires only on an opponent's upkeep, never the controller's.\"\"\"\n209\t\n210\t    def _setup(self):\n211\t        game = create_game()\n212\t        p1 = game.players[0]\n213\t        p2 = game.players[1]\n214\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n215\t        game.get_battlefield(p1).add(card)\n216\t        card.register_triggers(game)\n217\t        return game, p1, p2, card\n218\t\n219\t    def test_does_not_fire_on_controllers_own_upkeep(self) -> None:\n220\t        game, p1, p2, card = self._setup()\n221\t        game.active_player_index = 0  # controller's own upkeep\n222\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n223\t        assert game.stack.is_empty()\n224\t\n225\t    def test_fires_on_opponents_upkeep(self) -> None:\n226\t        game, p1, p2, card = self._setup()\n227\t        game.active_player_index = 1  # opponent's upkeep\n228\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n229\t        assert not game.stack.is_empty()\n230\t        stack_obj = game.stack.peek()\n231\t        assert stack_obj.source is card\n232\t        assert stack_obj.controller is p1\n233\t\n234\t\n235\tclass TestLoreholdUpkeepTriggerEffect:\n236\t    \"\"\"The optional 'discard a card, if you do draw a card' effect.\"\"\"\n237\t\n238\t    def _build_trigger_effect(self, game, controller):\n239\t        card = LoreholdTheHistorian(owner=controller, controller=controller)\n240\t        game.get_battlefield(controller).add(card)\n241\t        card.register_triggers(game)\n242\t        reg = game.trigger_manager.get_triggers_for_source(card)[0]\n243\t        return card, reg\n244\t\n245\t    def test_yes_discards_chosen_card_and_draws(self) -> None:\n246\t        # Controller is player 0; library has a card to draw, hand has one to pitch.\n247\t        game = create_game(scripts=([True], []))\n248\t        p1 = game.players[0]\n249\t        to_discard = _make_sorcery(\"Pitch Me\", owner=p1)\n250\t        # Put a card in the library so the draw has something to pull.\n251\t        drawn = Creature(name=\"Drawn Bear\", base_power=1, base_toughness=1, owner=p1, controller=p1)\n252\t        set_board_state(game, 0, hand=[to_discard])\n253\t        game.get_library(p1).add(drawn)\n254\t        # Script: choose_yes_no -> True, choose_card -> to_discard.\n255\t        p1._script.append(to_discard)\n256\t\n257\t        card, reg = self._build_trigger_effect(game, p1)\n258\t        reg.effect(game)\n259\t\n260\t        # The chosen card is now in the graveyard...\n261\t        assert game.get_graveyard(p1).contains(to_discard)\n262\t        assert not game.get_hand(p1).contains(to_discard)\n263\t        # ...and the drawn card is now in hand.\n264\t        assert game.get_hand(p1).contains(drawn)\n265\t        assert not game.get_library(p1).contains(drawn)\n266\t\n267\t    def test_no_does_not_discard_or_draw(self) -> None:\n268\t        game = create_game(scripts=([False], []))\n269\t        p1 = game.players[0]\n270\t        keep = _make_sorcery(\"Keep Me\", owner=p1)\n271\t        drawn = Creature(name=\"Library Bear\", base_power=1, base_toughness=1, owner=p1, controller=p1)\n272\t        set_board_state(game, 0, hand=[keep])\n273\t        game.get_library(p1).add(drawn)\n274\t\n275\t        card, reg = self._build_trigger_effect(game, p1)\n276\t        reg.effect(game)\n277\t\n278\t        # Declined: nothing discarded, nothing drawn.\n279\t        assert game.get_hand(p1).contains(keep)\n280\t        assert not game.get_graveyard(p1).contains(keep)\n281\t        assert game.get_library(p1).contains(drawn)\n282\t        assert len(game.get_hand(p1).get_all()) == 1\n283\t\n284\t    def test_empty_hand_is_safe_noop(self) -> None:\n285\t        \"\"\"With no card to discard the effect cannot 'do' anything, so no draw.\n286\t\n287\t        'If you do, draw a card' only triggers the draw when a card was\n288\t        actually discarded. An empty hand means no discard and therefore no\n289\t        draw — and the effect must not raise.\n290\t        \"\"\"\n291\t        game = create_game(scripts=([True], []))\n292\t        p1 = game.players[0]\n293\t        drawn = Creature(name=\"Library Bear\", base_power=1, base_toughness=1, owner=p1, controller=p1)\n294\t        set_board_state(game, 0, hand=[])\n295\t        game.get_library(p1).add(drawn)\n296\t\n297\t        card, reg = self._build_trigger_effect(game, p1)\n298\t        reg.effect(game)\n299\t\n300\t        # Could not discard, so must not draw.\n301\t        assert game.get_library(p1).contains(drawn)\n302\t        assert len(game.get_hand(p1).get_all()) == 0\n303\t"}]},"parent_tool_use_id":"toolu_01DP4Xs2cvbpN88ARbBpN9ZM","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"48550be3-556d-4d6f-bfb2-828f8be77eb6","timestamp":"2026-06-02T01:26:50.114Z","subagent_type":"Tester","task_description":"Extend sos_201 tests: miracle draw"}
