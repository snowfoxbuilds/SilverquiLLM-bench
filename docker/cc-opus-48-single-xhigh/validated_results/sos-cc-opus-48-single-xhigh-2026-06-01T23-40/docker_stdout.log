urn_number) in _loyalty_activated_this_turn\nengine/abilities.py:119:def _mark_loyalty_activated(source: Any, turn_number: int) -> None:\nengine/abilities.py:120:    \"\"\"Record that *source* used a loyalty ability this turn.\"\"\"\nengine/abilities.py:122:    _loyalty_activated_this_turn.add((obj_id, turn_number))\nengine/abilities.py:158:    ability: ActivatedAbilityInstance | LoyaltyAbilityInstance,\nengine/abilities.py:168:       ``priority_loop``, not here.  **Only loyalty abilities** carry\nengine/abilities.py:170:    2. **Pay costs** — invoke the ability's cost callable.  For loyalty\nengine/abilities.py:171:       abilities, adjust loyalty counters and enforce once-per-turn.\nengine/abilities.py:181:            :class:`LoyaltyAbilityInstance`).\nengine/abilities.py:187:    if isinstance(ability, LoyaltyAbilityInstance):\nengine/abilities.py:188:        _activate_loyalty_ability(game, player, ability)\nengine/abilities.py:204:    \"\"\"Activate a regular (non-loyalty) activated ability.\"\"\"\nengine/abilities.py:231:def _activate_loyalty_ability(\nengine/abilities.py:234:    ability: LoyaltyAbilityInstance,\nengine/abilities.py:236:    \"\"\"Activate a planeswalker loyalty ability.\"\"\"\nengine/abilities.py:239:    # 1. Timing — loyalty abilities are sorcery speed only.\nengine/abilities.py:242:            \"Cannot activate loyalty ability — sorcery-speed timing not met\"\nengine/abilities.py:247:    if _has_activated_loyalty_this_turn(source, turn_number):\nengine/abilities.py:249:            \"Cannot activate loyalty ability — already activated this turn\"\nengine/abilities.py:252:    # 3. Pay loyalty cost.\nengine/abilities.py:253:    current_loyalty = getattr(source, \"loyalty\", 0)\nengine/abilities.py:254:    new_loyalty = current_loyalty + ability.loyalty_cost\nengine/abilities.py:255:    if new_loyalty < 0:\nengine/abilities.py:257:            f\"Cannot activate loyalty ability — insufficient loyalty \"\nengine/abilities.py:258:            f\"(have