{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JP8qoUk8WAxRXVEBGDR9BN","type":"tool_result","content":"1\t\"\"\"Tests for SOS 201 — Lorehold, the Historian.\n2\t\n3\tLorehold, the Historian is a {3}{R}{W} Legendary Creature — Elder Dragon\n4\twith power/toughness 5/5 and the following abilities:\n5\t\n6\t1. Flying, haste (evergreen keywords).\n7\t2. \"Each instant and sorcery card in your hand has miracle {2}.\" — a granted\n8\t   static ability (CR 702.94). The engine has no native draw-reveal-cast-for-\n9\t   miracle pipeline, so we test the observable portion of the contract: the\n10\t   card advertises the miracle cost ({2}) and stamps it onto the instant and\n11\t   sorcery cards in *its controller's* hand (and nothing else).\n12\t3. \"At the beginning of each opponent's upkeep, you may discard a card. If you\n13\t   do, draw a card.\" — an optional rummage-style triggered ability that fires\n14\t   only on an *opponent's* upkeep.\n15\t\n16\tThese tests target the public card contract (static data, keyword flags,\n17\tcombat-rule interactions through the engine, the trigger registration, and the\n18\ttrigger's effect). They are written before implementation (TDD red phase).\n19\t\"\"\"\n20\t\n21\tfrom __future__ import annotations\n22\t\n23\tfrom cards.sos.sos_201.card_impl import LoreholdTheHistorian\n24\tfrom engine.card import Creature, Instant, Land, Sorcery\n25\tfrom engine.combat import _can_attack, _can_block\n26\tfrom engine.events import BeginningOfUpkeepTriggeredEvent\n27\tfrom engine.game import draw_card\n28\tfrom engine.types import (\n29\t    CardType,\n30\t    Keyword,\n31\t    ManaCost,\n32\t    ManaType,\n33\t    Supertype,\n34\t    Zone,\n35\t)\n36\tfrom test_utils import create_game, set_board_state\n37\t\n38\t\n39\t# ---------------------------------------------------------------------------\n40\t# Static characteristics\n41\t# ---------------------------------------------------------------------------\n42\t\n43\t\n44\tclass TestLoreholdProperties:\n45\t    \"\"\"Static card data should match the SOS 201 spec.\"\"\"\n46\t\n47\t    def test_is_creature(self) -> None:\n48\t        assert isinstance(LoreholdTheHistorian(owner=None), Creature)\n49\t\n50\t    def test_name(self) -> None:\n51\t        assert LoreholdTheHistorian(owner=None).name == \"Lorehold, the Historian\"\n52\t\n53\t    def test_mana_cost(self) -> None:\n54\t        assert LoreholdTheHistorian(owner=None).mana_cost == ManaCost.parse(\"{3}{R}{W}\")\n55\t\n56\t    def test_power_toughness(self) -> None:\n57\t        card = LoreholdTheHistorian(owner=None)\n58\t        assert card.base_power == 5\n59\t        assert card.base_toughness == 5\n60\t\n61\t    def test_is_legendary(self) -> None:\n62\t        assert Supertype.LEGENDARY in LoreholdTheHistorian(owner=None).supertypes\n63\t\n64\t    def test_elder_dragon_subtypes(self) -> None:\n65\t        subtypes = LoreholdTheHistorian(owner=None).subtypes\n66\t        assert {\"Elder\", \"Dragon\"} <= subtypes\n67\t\n68\t    def test_colors_are_red_white(self) -> None:\n69\t        \"\"\"The spec lists colors R and W; cards advertise this via self.colors.\"\"\"\n70\t        colors = set(getattr(LoreholdTheHistorian(owner=None), \"colors\", []))\n71\t        assert colors == {\"R\", \"W\"}\n72\t\n73\t\n74\t# ---------------------------------------------------------------------------\n75\t# Flying + haste keywords\n76\t# ---------------------------------------------------------------------------\n77\t\n78\t\n79\tclass TestLoreholdKeywords:\n80\t    \"\"\"Flying and haste keyword flags and their combat-rule consequences.\"\"\"\n81\t\n82\t    def test_has_flying_and_haste(self) -> None:\n83\t        kw = LoreholdTheHistorian(owner=None).keywords\n84\t        assert Keyword.FLYING in kw\n85\t        assert Keyword.HASTE in kw\n86\t\n87\t    def test_haste_allows_attacking_while_summoning_sick(self) -> None:\n88\t        \"\"\"Haste lets a freshly-cast Lorehold attack the turn it arrives.\"\"\"\n89\t        card = LoreholdTheHistorian(owner=None)\n90\t        card.summoning_sick = True\n91\t        card.is_tapped = False\n92\t        assert _can_attack(card) is True\n93\t\n94\t    def test_ground_creature_cannot_block_flying_lorehold(self) -> None:\n95\t        attacker = LoreholdTheHistorian(owner=None)\n96\t        ground = Creature(name=\"Ground Bear\", base_power=2, base_toughness=2)\n97\t        ground.keywords = Keyword(0)\n98\t        ground.is_tapped = False\n99\t        assert _can_block(ground, attacker) is False\n100\t\n101\t    def test_flying_creature_can_block_flying_lorehold(self) -> None:\n102\t        attacker = LoreholdTheHistorian(owner=None)\n103\t        flier = Creature(name=\"Air Bear\", base_power=2, base_toughness=2)\n104\t        flier.keywords = Keyword.FLYING\n105\t        flier.is_tapped = False\n106\t        assert _can_block(flier, attacker) is True\n107\t\n108\t    def test_reach_creature_can_block_flying_lorehold(self) -> None:\n109\t        attacker = LoreholdTheHistorian(owner=None)\n110\t        spider = Creature(name=\"Spider\", base_power=1, base_toughness=4)\n111\t        spider.keywords = Keyword.REACH\n112\t        spider.is_tapped = False\n113\t        assert _can_block(spider, attacker) is True\n114\t\n115\t\n116\t# ---------------------------------------------------------------------------\n117\t# Miracle granting: \"Each instant and sorcery card in your hand has miracle {2}\"\n118\t# ---------------------------------------------------------------------------\n119\t\n120\t\n121\tdef _make_instant(name: str, owner=None) -> Instant:\n122\t    spell = Instant(name=name, mana_cost=ManaCost.parse(\"{3}{U}\"), owner=owner, controller=owner)\n123\t    return spell\n124\t\n125\t\n126\tdef _make_sorcery(name: str, owner=None) -> Sorcery:\n127\t    spell = Sorcery(name=name, mana_cost=ManaCost.parse(\"{4}{B}\"), owner=owner, controller=owner)\n128\t    return spell\n129\t\n130\t\n131\tclass TestLoreholdMiracleGrant:\n132\t    \"\"\"The granted miracle {2} static ability marks eligible hand cards.\n133\t\n134\t    The engine has no native miracle pipeline, so the card exposes the\n135\t    granting as a method (``grant_miracle(game)``) that stamps the miracle\n136\t    cost onto each instant/sorcery card in *its controller's* hand. These\n137\t    tests exercise that contract.\n138\t    \"\"\"\n139\t\n140\t    def test_miracle_cost_is_two_generic(self) -> None:\n141\t        \"\"\"The granted alternative cost is {2}.\"\"\"\n142\t        card = LoreholdTheHistorian(owner=None)\n143\t        assert card.MIRACLE_COST == ManaCost.parse(\"{2}\")\n144\t\n145\t    def test_grants_miracle_to_instant_in_controller_hand(self) -> None:\n146\t        game = create_game()\n147\t        p1 = game.players[0]\n148\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n149\t        bolt = _make_instant(\"Bolt\", owner=p1)\n150\t        set_board_state(game, 0, battlefield=[lorehold], hand=[bolt])\n151\t        lorehold.grant_miracle(game)\n152\t        assert bolt.miracle_cost == ManaCost.parse(\"{2}\")\n153\t\n154\t    def test_grants_miracle_to_sorcery_in_controller_hand(self) -> None:\n155\t        game = create_game()\n156\t        p1 = game.players[0]\n157\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n158\t        ritual = _make_sorcery(\"Ritual\", owner=p1)\n159\t        set_board_state(game, 0, battlefield=[lorehold], hand=[ritual])\n160\t        lorehold.grant_miracle(game)\n161\t        assert ritual.miracle_cost == ManaCost.parse(\"{2}\")\n162\t\n163\t    def test_does_not_grant_miracle_to_noncast_types_in_hand(self) -> None:\n164\t        \"\"\"Creatures and lands in hand are not instants/sorceries — no miracle.\"\"\"\n165\t        game = create_game()\n166\t        p1 = game.players[0]\n167\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n168\t        bear = Creature(name=\"Bear\", base_power=2, base_toughness=2, owner=p1, controller=p1)\n169\t        forest = Land(name=\"Forest\", owner=p1, controller=p1)\n170\t        set_board_state(game, 0, battlefield=[lorehold], hand=[bear, forest])\n171\t        lorehold.grant_miracle(game)\n172\t        assert getattr(bear, \"miracle_cost\", None) is None\n173\t        assert getattr(forest, \"miracle_cost\", None) is None\n174\t\n175\t    def test_does_not_grant_miracle_to_opponent_hand(self) -> None:\n176\t        \"\"\"'your hand' means the controller's hand, not the opponent's.\"\"\"\n177\t        game = create_game()\n178\t        p1 = game.players[0]\n179\t        p2 = game.players[1]\n180\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n181\t        opp_spell = _make_instant(\"Opp Bolt\", owner=p2)\n182\t        set_board_state(game, 0, battlefield=[lorehold])\n183\t        set_board_state(game, 1, hand=[opp_spell])\n184\t        lorehold.grant_miracle(game)\n185\t        assert getattr(opp_spell, \"miracle_cost\", None) is None\n186\t\n187\t\n188\t# ---------------------------------------------------------------------------\n189\t# Opponent's-upkeep loot trigger\n190\t# ---------------------------------------------------------------------------\n191\t\n192\t\n193\tclass TestLoreholdUpkeepTriggerRegistration:\n194\t    \"\"\"register_triggers wires a BeginningOfUpkeep trigger for this card.\"\"\"\n195\t\n196\t    def test_registers_an_upkeep_trigger(self) -> None:\n197\t        game = create_game()\n198\t        p1 = game.players[0]\n199\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n200\t        game.get_battlefield(p1).add(card)\n201\t        before = len(game.trigger_manager.get_triggers_for_source(card))\n202\t        card.register_triggers(game)\n203\t        after = game.trigger_manager.get_triggers_for_source(card)\n204\t        assert len(after) - before == 1\n205\t        assert after[0].event_type is BeginningOfUpkeepTriggeredEvent\n206\t        assert after[0].controller is p1\n207\t\n208\t\n209\tclass TestLoreholdUpkeepTriggerCondition:\n210\t    \"\"\"The trigger fires only on an opponent's upkeep, never the controller's.\"\"\"\n211\t\n212\t    def _setup(self):\n213\t        game = create_game()\n214\t        p1 = game.players[0]\n215\t        p2 = game.players[1]\n216\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n217\t        game.get_battlefield(p1).add(card)\n218\t        card.register_triggers(game)\n219\t        return game, p1, p2, card\n220\t\n221\t    def test_does_not_fire_on_controllers_own_upkeep(self) -> None:\n222\t        game, p1, p2, card = self._setup()\n223\t        game.active_player_index = 0  # controller's own upkeep\n224\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n225\t        assert game.stack.is_empty()\n226\t\n227\t    def test_fires_on_opponents_upkeep(self) -> None:\n228\t        game, p1, p2, card = self._setup()\n229\t        game.active_player_index = 1  # opponent's upkeep\n230\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n231\t        assert not game.stack.is_empty()\n232\t        stack_obj = game.stack.peek()\n233\t        assert stack_obj.source is card\n234\t        assert stack_obj.controller is p1\n235\t\n236\t\n237\tclass TestLoreholdUpkeepTriggerEffect:\n238\t    \"\"\"The optional 'discard a card, if you do draw a card' effect.\"\"\"\n239\t\n240\t    def _build_trigger_effect(self, game, controller):\n241\t        card = LoreholdTheHistorian(owner=controller, controller=controller)\n242\t        game.get_battlefield(controller).add(card)\n243\t        card.register_triggers(game)\n244\t        reg = game.trigger_manager.get_triggers_for_source(card)[0]\n245\t        return card, reg\n246\t\n247\t    def test_yes_discards_chosen_card_and_draws(self) -> None:\n248\t        # Controller is player 0; library has a card to draw, hand has one to pitch.\n249\t        game = create_game(scripts=([True], []))\n250\t        p1 = game.players[0]\n251\t        to_discard = _make_sorcery(\"Pitch Me\", owner=p1)\n252\t        # Put a card in the library so the draw has something to pull.\n253\t        drawn = Creature(name=\"Drawn Bear\", base_power=1, base_toughness=1, owner=p1, controller=p1)\n254\t        set_board_state(game, 0, hand=[to_discard])\n255\t        game.get_library(p1).add(drawn)\n256\t        # Script: choose_yes_no -> True, choose_card -> to_discard.\n257\t        p1._script.append(to_discard)\n258\t\n259\t        card, reg = self._build_trigger_effect(game, p1)\n260\t        reg.effect(game)\n261\t\n262\t        # The chosen card is now in the graveyard...\n263\t        assert game.get_graveyard(p1).contains(to_discard)\n264\t        assert not game.get_hand(p1).contains(to_discard)\n265\t        # ...and the drawn card is now in hand.\n266\t        assert game.get_hand(p1).contains(drawn)\n267\t        assert not game.get_library(p1).contains(drawn)\n268\t\n269\t    def test_no_does_not_discard_or_draw(self) -> None:\n270\t        game = create_game(scripts=([False], []))\n271\t        p1 = game.players[0]\n272\t        keep = _make_sorcery(\"Keep Me\", owner=p1)\n273\t        drawn = Creature(name=\"Library Bear\", base_power=1, base_toughness=1, owner=p1, controller=p1)\n274\t        set_board_state(game, 0, hand=[keep])\n275\t        game.get_library(p1).add(drawn)\n276\t\n277\t        card, reg = self._build_trigger_effect(game, p1)\n278\t        reg.effect(game)\n279\t\n280\t        # Declined: nothing discarded, nothing drawn.\n281\t        assert game.get_hand(p1).contains(keep)\n282\t        assert not game.get_graveyard(p1).contains(keep)\n283\t        assert game.get_library(p1).contains(drawn)\n284\t        assert len(game.get_hand(p1).get_all()) == 1\n285\t\n286\t    def test_empty_hand_is_safe_noop(self) -> None:\n287\t        \"\"\"With no card to discard the effect cannot 'do' anything, so no draw.\n288\t\n289\t        'If you do, draw a card' only triggers the draw when a card was\n290\t        actually discarded. An empty hand means no discard and therefore no\n291\t        draw — and the effect must not raise.\n292\t        \"\"\"\n293\t        game = create_game(scripts=([True], []))\n294\t        p1 = game.players[0]\n295\t        drawn = Creature(name=\"Library Bear\", base_power=1, base_toughness=1, owner=p1, controller=p1)\n296\t        set_board_state(game, 0, hand=[])\n297\t        game.get_library(p1).add(drawn)\n298\t\n299\t        card, reg = self._build_trigger_effect(game, p1)\n300\t        reg.effect(game)\n301\t\n302\t        # Could not discard, so must not draw.\n303\t        assert game.get_library(p1).contains(drawn)\n304\t        assert len(game.get_hand(p1).get_all()) == 0\n305\t\n306\t\n307\t# ---------------------------------------------------------------------------\n308\t# Draw-time miracle: \"You may cast it for its miracle cost when you draw it\n309\t# if it's the first card you drew this turn.\"\n310\t# ---------------------------------------------------------------------------\n311\t\n312\t\n313\tclass TestLoreholdDrawTimeMiracle:\n314\t    \"\"\"The deterministic at-draw miracle window built into ``draw_card``.\n315\t\n316\t    With Lorehold on a player's battlefield, the FIRST card that player draws\n317\t    each turn is offered the miracle cast when it's an instant/sorcery. These\n318\t    tests drive the real engine ``draw_card`` and assert the full observable\n319\t    contract: the offer gating, the cast-for-{2} payment, the decline path,\n320\t    and the no-offer cases (non-first card, no granting permanent).\n321\t\n322\t    Conventions: the controller is a ``DeterministicPlayer`` whose\n323\t    ``choose_yes_no`` is scripted via the ``scripts`` arg, and the drawn card\n324\t    is placed on top of the library (the last object added — see\n325\t    ``ZoneContainer`` / ``draw_card``'s ``library.top(1)``).\n326\t    \"\"\"\n327\t\n328\t    @staticmethod\n329\t    def _put_on_top(game, player, card) -> None:\n330\t        \"\"\"Place *card* on top of *player*'s library (drawn next).\"\"\"\n331\t        game.get_library(player).add(card)\n332\t\n333\t    def test_first_card_yes_casts_for_miracle_cost(self) -> None:\n334\t        \"\"\"First-card instant + Lorehold + 'yes' → cast for {2}.\n335\t\n336\t        Validates: the controller is offered the cast, ``miracle_cost`` is\n337\t        stamped, the card is paid for with {2} (pool drained, ``mana_spent``\n338\t        records the alternative cost's cmc), the card leaves hand and is on\n339\t        the stack (a StackObject was pushed), not still in hand.\n340\t        \"\"\"\n341\t        game = create_game(scripts=([True], []))  # choose_yes_no -> yes\n342\t        p1 = game.players[0]\n343\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n344\t        bolt = _make_instant(\"Miracle Bolt\", owner=p1)\n345\t        # Exactly {2} generic available so we can prove the cost was paid.\n346\t        set_board_state(\n347\t            game, 0, battlefield=[lorehold], hand=[], mana={ManaType.COLORLESS: 2}\n348\t        )\n349\t        p1.cards_drawn_this_turn = 0\n350\t        self._put_on_top(game, p1, bolt)\n351\t\n352\t        drawn = draw_card(game, p1)\n353\t\n354\t        assert drawn is bolt\n355\t        # Offered + accepted: miracle cost stamped and the card was cast.\n356\t        assert bolt.miracle_cost == ManaCost.parse(\"{2}\")\n357\t        assert not game.get_hand(p1).contains(bolt)  # left hand to be cast\n358\t        assert p1.zones[Zone.STACK].contains(bolt)    # now on the stack zone\n359\t        assert not game.stack.is_empty()              # a spell is on the stack\n360\t        assert game.stack.peek().source is bolt\n361\t        # The {2} miracle cost was paid: the pool is emptied and the recorded\n362\t        # mana spent equals the alternative cost's converted mana cost.\n363\t        assert p1.mana_pool.total() == 0\n364\t        assert bolt.mana_spent == 2\n365\t\n366\t    def test_first_card_no_keeps_card_and_spends_no_mana(self) -> None:\n367\t        \"\"\"First-card instant + Lorehold + 'no' → card stays in hand, no cost.\n368\t\n369\t        Declining the offer must not move the card or spend mana. The\n370\t        ``miracle_cost`` may still be stamped (it is advertised before the\n371\t        yes/no prompt), but nothing is cast.\n372\t        \"\"\"\n373\t        game = create_game(scripts=([False], []))  # choose_yes_no -> no\n374\t        p1 = game.players[0]\n375\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n376\t        bolt = _make_instant(\"Declined Bolt\", owner=p1)\n377\t        set_board_state(\n378\t            game, 0, battlefield=[lorehold], hand=[], mana={ManaType.COLORLESS: 2}\n379\t        )\n380\t        p1.cards_drawn_this_turn = 0\n381\t        self._put_on_top(game, p1, bolt)\n382\t\n383\t        drawn = draw_card(game, p1)\n384\t\n385\t        assert drawn is bolt\n386\t        # Declined: the card remains in hand and nothing went on the stack.\n387\t        assert game.get_hand(p1).contains(bolt)\n388\t        assert not p1.zones[Zone.STACK].contains(bolt)\n389\t        assert game.stack.is_empty()\n390\t        # No mana was spent.\n391\t        assert p1.mana_pool.total() == 2\n392\t        assert getattr(bolt, \"mana_spent\", None) is None\n393\t\n394\t    def test_non_first_card_draw_is_not_offered(self) -> None:\n395\t        \"\"\"A SECOND draw is never offered the miracle, even with Lorehold out.\n396\t\n397\t        Draw a (non-spell) card first so ``cards_drawn_this_turn`` becomes 1,\n398\t        then draw the instant as the second card. The first-card gate fails,\n399\t        so there is no prompt, no cast, no stamp — the instant simply enters\n400\t        hand. The empty yes/no script proves no prompt was issued (a stray\n401\t        prompt would raise ``ScriptExhaustedError``).\n402\t        \"\"\"\n403\t        game = create_game(scripts=([], []))  # no yes/no answers available\n404\t        p1 = game.players[0]\n405\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n406\t        filler = Creature(\n407\t            name=\"Filler Bear\", base_power=1, base_toughness=1, owner=p1, controller=p1\n408\t        )\n409\t        bolt = _make_instant(\"Late Bolt\", owner=p1)\n410\t        set_board_state(\n411\t            game, 0, battlefield=[lorehold], hand=[], mana={ManaType.COLORLESS: 2}\n412\t        )\n413\t        p1.cards_drawn_this_turn = 0\n414\t        # bolt added first (bottom), filler added second (top → drawn first).\n415\t        self._put_on_top(game, p1, bolt)\n416\t        self._put_on_top(game, p1, filler)\n417\t\n418\t        first = draw_card(game, p1)   # non-spell first card, no offer\n419\t        second = draw_card(game, p1)  # instant, but it is the 2nd card\n420\t\n421\t        assert first is filler\n422\t        assert second is bolt\n423\t        assert p1.cards_drawn_this_turn == 2\n424\t        # No offer for the second card: it just enters hand untouched.\n425\t        assert game.get_hand(p1).contains(bolt)\n426\t        assert game.stack.is_empty()\n427\t        assert p1.mana_pool.total() == 2\n428\t        assert getattr(bolt, \"miracle_cost\", None) is None\n429\t\n430\t    def test_no_miracle_grantor_means_no_offer(self) -> None:\n431\t        \"\"\"First-card instant with NO granting permanent → no offer at all.\n432\t\n433\t        Regression-safety for the draw hook's gate: when nothing the drawing\n434\t        player controls grants miracle, ``draw_card`` is a complete no-op\n435\t        beyond the normal draw — no prompt (empty script proves it), no stamp,\n436\t        no mana spent, card simply enters hand.\n437\t        \"\"\"\n438\t        game = create_game(scripts=([], []))  # no yes/no answers available\n439\t        p1 = game.players[0]\n440\t        bolt = _make_instant(\"Ungranted Bolt\", owner=p1)\n441\t        # No Lorehold (or any granting permanent) on the battlefield.\n442\t        set_board_state(\n443\t            game, 0, battlefield=[], hand=[], mana={ManaType.COLORLESS: 2}\n444\t        )\n445\t        p1.cards_drawn_this_turn = 0\n446\t        self._put_on_top(game, p1, bolt)\n447\t\n448\t        drawn = draw_card(game, p1)\n449\t\n450\t        assert drawn is bolt\n451\t        assert game.get_hand(p1).contains(bolt)\n452\t        assert game.stack.is_empty()\n453\t        assert p1.mana_pool.total() == 2\n454\t        assert getattr(bolt, \"miracle_cost\", None) is None\n455\t        # No prompt was consumed.\n456\t        assert p1.remaining_choices == 0\n457\t\n458\t    def test_first_card_sorcery_also_offered_and_cast(self) -> None:\n459\t        \"\"\"Sorceries get the miracle window too (not just instants).\n460\t\n461\t        Mirrors the instant 'yes' path with a sorcery on top, proving the\n462\t        grant applies to both instant and sorcery card types at draw time.\n463\t        \"\"\"\n464\t        game = create_game(scripts=([True], []))  # yes\n465\t        p1 = game.players[0]\n466\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n467\t        ritual = _make_sorcery(\"Miracle Ritual\", owner=p1)\n468\t        set_board_state(\n469\t            game, 0, battlefield=[lorehold], hand=[], mana={ManaType.COLORLESS: 2}\n470\t        )\n471\t        p1.cards_drawn_this_turn = 0\n472\t        self._put_on_top(game, p1, ritual)\n473\t\n474\t        drawn = draw_card(game, p1)\n475\t\n476\t        assert drawn is ritual\n477\t        assert ritual.miracle_cost == ManaCost.parse(\"{2}\")\n478\t        assert not game.get_hand(p1).contains(ritual)\n479\t        assert p1.zones[Zone.STACK].contains(ritual)\n480\t        assert game.stack.peek().source is ritual\n481\t        assert p1.mana_pool.total() == 0\n482\t        assert ritual.mana_spent == 2\n483\t"}]},"parent_tool_use_id":"toolu_01RTAjsfjPH76zUPLLeiM977","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"a5b50392-1f9d-47aa-98a6-05f2b995c82e","timestamp":"2026-06-02T01:34:10.471Z","subagent_type":"Tester","task_description":"Write tests for sos_226"}
