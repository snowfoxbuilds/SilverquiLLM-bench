{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QmG7vRqyRBvfKCPMsKFKxd","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_57/card_impl.py b/cards/sos/sos_57/card_impl.py\n2\tindex 732a555..5fb9514 100644\n3\t--- a/cards/sos/sos_57/card_impl.py\n4\t+++ b/cards/sos/sos_57/card_impl.py\n5\t@@ -1,16 +1,184 @@\n6\t-\"\"\"Card implementation for Mana Sculpt.\"\"\"\n7\t+\"\"\"Card implementation for Mana Sculpt (SOS 57).\"\"\"\n8\t \n9\t from __future__ import annotations\n10\t \n11\t-from engine.card import CardImpl\n12\t+from typing import TYPE_CHECKING, Any\n13\t \n14\t-from typing import TYPE_CHECKING\n15\t+from engine.card import Instant\n16\t+from engine.types import CardType, ManaCost, ManaType, TargetRequirement, Zone\n17\t \n18\t if TYPE_CHECKING:\n19\t     from engine.game_state import GameState\n20\t \n21\t \n22\t-class ManaSculpt(CardImpl):\n23\t-    \"\"\"TODO: Implement Mana Sculpt.\"\"\"\n24\t+def _stack_source(obj: Any) -> Any:\n25\t+    \"\"\"Return the underlying card for a StackObject, or *obj* itself.\"\"\"\n26\t+    return getattr(obj, \"source\", obj)\n27\t \n28\t-    pass\n29\t+\n30\t+def _is_spell(obj: Any) -> bool:\n31\t+    \"\"\"Return ``True`` if *obj* (a StackObject or card) represents a spell.\n32\t+\n33\t+    A spell is anything on the stack with spell card types — i.e. anything\n34\t+    other than a (bare) land. Triggered/activated abilities have no spell\n35\t+    card types and are excluded.\n36\t+    \"\"\"\n37\t+    if getattr(obj, \"is_spell\", None) is False:\n38\t+        return False\n39\t+    source = _stack_source(obj)\n40\t+    card_types = getattr(source, \"card_types\", set())\n41\t+    return bool(card_types - {CardType.LAND})\n42\t+\n43\t+\n44\t+def _get_chosen_target(card: Any) -> Any:\n45\t+    \"\"\"Retrieve the first chosen target for this spell.\"\"\"\n46\t+    chosen = getattr(card, \"chosen_targets\", None)\n47\t+    if chosen:\n48\t+        return chosen[0]\n49\t+    return None\n50\t+\n51\t+\n52\t+def _counter_spell(game: \"GameState\", stack_obj: Any) -> None:\n53\t+    \"\"\"Counter a spell — remove its StackObject and route the card to its\n54\t+    owner's graveyard. The spell never resolves.\"\"\"\n55\t+    from engine.stack import StackObject\n56\t+\n57\t+    if not isinstance(stack_obj, StackObject):\n58\t+        return\n59\t+\n60\t+    card = stack_obj.source\n61\t+    stack_items = game.stack._items  # noqa: SLF001\n62\t+    found = False\n63\t+    for i, item in enumerate(stack_items):\n64\t+        if item is stack_obj:\n65\t+            stack_items.pop(i)\n66\t+            found = True\n67\t+            break\n68\t+\n69\t+    if not found:\n70\t+        return\n71\t+\n72\t+    controller = stack_obj.controller\n73\t+    owner = getattr(card, \"owner\", controller)\n74\t+\n75\t+    if controller is not None:\n76\t+        stack_zone = controller.zones[Zone.STACK]\n77\t+        if stack_zone.contains(card):\n78\t+            stack_zone.remove(card)\n79\t+\n80\t+    if owner is not None:\n81\t+        graveyard = owner.zones[Zone.GRAVEYARD]\n82\t+        graveyard.add(card)\n83\t+\n84\t+\n85\t+def _controls_wizard(game: \"GameState\", player: Any) -> bool:\n86\t+    \"\"\"Return ``True`` if *player* controls a creature with the Wizard subtype.\"\"\"\n87\t+    if player is None:\n88\t+        return False\n89\t+    battlefield = player.zones[Zone.BATTLEFIELD]\n90\t+    for obj in battlefield.get_all():\n91\t+        card_types = getattr(obj, \"card_types\", set())\n92\t+        if CardType.CREATURE not in card_types:\n93\t+            continue\n94\t+        subtypes = getattr(obj, \"subtypes\", set()) or set()\n95\t+        if \"Wizard\" in subtypes:\n96\t+            return True\n97\t+    return False\n98\t+\n99\t+\n100\t+class ManaSculpt(Instant):\n101\t+    \"\"\"Mana Sculpt — {1}{U}{U} — Instant.\n102\t+\n103\t+    Counter target spell. If you control a Wizard, add an amount of {C} equal\n104\t+    to the amount of mana spent to cast that spell at the beginning of your\n105\t+    next main phase.\n106\t+\n107\t+    SOS collector number 57.\n108\t+    \"\"\"\n109\t+\n110\t+    def __init__(self, **kwargs: Any) -> None:\n111\t+        kwargs.setdefault(\"name\", \"Mana Sculpt\")\n112\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{U}{U}\"))\n113\t+        kwargs.setdefault(\n114\t+            \"rules_text\",\n115\t+            \"Counter target spell. If you control a Wizard, add an amount of \"\n116\t+            \"{C} equal to the amount of mana spent to cast that spell at the \"\n117\t+            \"beginning of your next main phase.\",\n118\t+        )\n119\t+        super().__init__(**kwargs)\n120\t+        self.colors = [\"U\"]\n121\t+        # Amount of {C} this spell scheduled to be reimbursed at its\n122\t+        # controller's next main phase (read back by tests; defaults to 0).\n123\t+        self.pending_colorless: int = 0\n124\t+\n125\t+    # ------------------------------------------------------------------\n126\t+    # Targeting — \"Counter target spell\"\n127\t+    # ------------------------------------------------------------------\n128\t+\n129\t+    def can_cast(self, game: \"GameState\") -> bool:\n130\t+        \"\"\"Castable only when there is a legal spell to counter on the stack.\"\"\"\n131\t+        for stack_obj in game.stack.objects():\n132\t+            if _stack_source(stack_obj) is self:\n133\t+                continue\n134\t+            if _is_spell(stack_obj):\n135\t+                return True\n136\t+        return False\n137\t+\n138\t+    def get_targets(self, game: \"GameState\") -> list:\n139\t+        \"\"\"Target any spell on the stack (creature or noncreature).\"\"\"\n140\t+\n141\t+        def _filter(obj: Any) -> bool:\n142\t+            if obj is self or _stack_source(obj) is self:\n143\t+                return False\n144\t+            return _is_spell(obj)\n145\t+\n146\t+        return [\n147\t+            TargetRequirement(\n148\t+                filter_fn=_filter,\n149\t+                description=\"target spell\",\n150\t+                zone=Zone.STACK,\n151\t+            )\n152\t+        ]\n153\t+\n154\t+    # ------------------------------------------------------------------\n155\t+    # Resolution\n156\t+    # ------------------------------------------------------------------\n157\t+\n158\t+    def on_resolve(self, game: \"GameState\") -> None:\n159\t+        \"\"\"Counter the target spell; if controlling a Wizard, schedule the\n160\t+        deferred {C} reimbursement for the controller's next main phase.\"\"\"\n161\t+        target = _get_chosen_target(self)\n162\t+        if target is None:\n163\t+            return\n164\t+\n165\t+        # Capture the amount of mana spent on the countered spell BEFORE it\n166\t+        # leaves the stack (the engine records this as card.mana_spent during\n167\t+        # payment).\n168\t+        countered_card = _stack_source(target)\n169\t+        mana_spent = int(getattr(countered_card, \"mana_spent\", 0) or 0)\n170\t+\n171\t+        # Always counter the target spell — unconditional.\n172\t+        _counter_spell(game, target)\n173\t+\n174\t+        controller = self.controller\n175\t+        if controller is None:\n176\t+            return\n177\t+\n178\t+        # Wizard gate — only schedule the deferred {C} if the controller\n179\t+        # controls a Wizard at resolution.\n180\t+        if not _controls_wizard(game, controller):\n181\t+            self.pending_colorless = 0\n182\t+            return\n183\t+\n184\t+        self.pending_colorless = mana_spent\n185\t+        if mana_spent <= 0:\n186\t+            return\n187\t+\n188\t+        def _reimburse(g: \"GameState\", amount: int = mana_spent, who: Any = controller) -> None:\n189\t+            who.mana_pool.add(ManaType.COLORLESS, amount)\n190\t+\n191\t+        # Deferred — not added immediately. Delivered when the controller's\n192\t+        # next BeginningOfMainPhaseTriggeredEvent (precombat) fires.\n193\t+        game.schedule_main_phase_deferred_effect(\n194\t+            controller, _reimburse, precombat=True\n195\t+        )\n196\tdiff --git a/engine/casting.py b/engine/casting.py\n197\tindex 4131e11..73672db 100644\n198\t--- a/engine/casting.py\n199\t+++ b/engine/casting.py\n200\t@@ -167,9 +167,12 @@ def cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n201\t     hand.remove(card)\n202\t     stack_zone.add(card)\n203\t \n204\t-    # Clear any stale colors_spent from a prior cast before new payment.\n205\t+    # Clear any stale colors_spent / mana_spent from a prior cast before\n206\t+    # new payment.\n207\t     if hasattr(card, \"colors_spent\"):\n208\t         del card.colors_spent\n209\t+    if hasattr(card, \"mana_spent\"):\n210\t+        del card.mana_spent\n211\t \n212\t     # 5. Choose targets\n213\t     target_specs = card.get_targets(game)\n214\t@@ -228,6 +231,11 @@ def cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n215\t     # that care about the colors used to cast the spell.\n216\t     card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n217\t \n218\t+    # Store the TOTAL amount of mana spent (converted, after cost reduction)\n219\t+    # for mechanics that reimburse / count the mana paid to cast the spell\n220\t+    # (e.g. Mana Sculpt). Additive and backward-compatible — defaults absent.\n221\t+    card.mana_spent = effective_cost.cmc  # type: ignore[attr-defined]\n222\t+\n223\t     # 7. Call on_cast hook\n224\t     card.on_cast(game)\n225\t \n226\t@@ -353,6 +361,9 @@ def cast_spell_free(\n227\t         source_zone_container.add(card)\n228\t         raise CastingError(str(exc)) from exc\n229\t \n230\t+    # Free casts pay no mana, so the total mana spent is 0.\n231\t+    card.mana_spent = 0  # type: ignore[attr-defined]\n232\t+\n233\t     # 4. Call on_cast hook\n234\t     card.on_cast(game)\n235\t \n236\tdiff --git a/engine/events.py b/engine/events.py\n237\tindex 9f38fa2..f1be9b1 100644\n238\t--- a/engine/events.py\n239\t+++ b/engine/events.py\n240\t@@ -76,6 +76,28 @@ class BeginningOfCombatTriggeredEvent(TriggeredEvent):\n241\t     pass\n242\t \n243\t \n244\t+@dataclass\n245\t+class BeginningOfMainPhaseTriggeredEvent(TriggeredEvent):\n246\t+    \"\"\"Fired at the start of a main phase (after entering it).\n247\t+\n248\t+    Carries the active player (the player whose main phase is beginning,\n249\t+    used as the controller for \"at the beginning of your next main phase\"\n250\t+    delayed effects) and a flag distinguishing the precombat from the\n251\t+    postcombat main phase.\n252\t+\n253\t+    Attributes:\n254\t+        player: The active player whose main phase is beginning.\n255\t+        controller: Alias of ``player`` (matches the naming used by other\n256\t+            triggered events that carry a controller).\n257\t+        precombat: ``True`` for the precombat main phase, ``False`` for the\n258\t+            postcombat main phase.\n259\t+    \"\"\"\n260\t+\n261\t+    player: Any = None\n262\t+    controller: Any = None\n263\t+    precombat: bool = True\n264\t+\n265\t+\n266\t @dataclass\n267\t class EndOfTurnTriggeredEvent(TriggeredEvent):\n268\t     pass\n269\tdiff --git a/engine/game_state.py b/engine/game_state.py\n270\tindex eaaff47..5f8e628 100644\n271\t--- a/engine/game_state.py\n272\t+++ b/engine/game_state.py\n273\t@@ -81,6 +81,41 @@ class GameState:\n274\t         # normal rotation.  When extras are exhausted the game picks up\n275\t         # from _normal_next_index.\n276\t         self._normal_next_index: int = 1\n277\t+        # Deferred one-shot effects scheduled to run \"at the beginning of a\n278\t+        # player's next (precombat) main phase\". Each entry is a dict with\n279\t+        # keys: ``controller`` (Player), ``callback`` (callable taking the\n280\t+        # game state), and ``precombat`` (bool — restrict to the precombat\n281\t+        # main phase). Consumed (and removed) by\n282\t+        # :func:`engine.deferred.deliver_main_phase_deferred_effects` when the\n283\t+        # matching BeginningOfMainPhaseTriggeredEvent fires. Additive — see\n284\t+        # :func:`schedule_main_phase_deferred_effect`.\n285\t+        self.main_phase_deferred_effects: list[dict[str, Any]] = []\n286\t+\n287\t+    # ------------------------------------------------------------------\n288\t+    # Deferred one-shot main-phase effects\n289\t+    # ------------------------------------------------------------------\n290\t+\n291\t+    def schedule_main_phase_deferred_effect(\n292\t+        self,\n293\t+        controller: Player,\n294\t+        callback: Any,\n295\t+        *,\n296\t+        precombat: bool = True,\n297\t+    ) -> None:\n298\t+        \"\"\"Schedule a one-shot effect for *controller*'s next main phase.\n299\t+\n300\t+        The *callback* (a callable taking the game state) runs exactly once,\n301\t+        when the matching :class:`~engine.events.BeginningOfMainPhaseTriggeredEvent`\n302\t+        next fires for *controller*. If *precombat* is ``True`` the effect\n303\t+        only fires for the precombat main phase.\n304\t+\n305\t+        This is the engine's delayed/one-shot deferred-effect mechanism for\n306\t+        \"do X at the beginning of your next main phase\" riders (e.g. Mana\n307\t+        Sculpt). It is additive and does not use the stack.\n308\t+        \"\"\"\n309\t+        self.main_phase_deferred_effects.append(\n310\t+            {\"controller\": controller, \"callback\": callback, \"precombat\": precombat}\n311\t+        )\n312\t \n313\t     # ------------------------------------------------------------------\n314\t     # Player properties\n315\tdiff --git a/engine/triggers.py b/engine/triggers.py\n316\tindex 6e94d99..a360ca4 100644\n317\t--- a/engine/triggers.py\n318\t+++ b/engine/triggers.py\n319\t@@ -91,6 +91,17 @@ class TriggerManager:\n320\t         1. Active player's matching triggers (in registration order).\n321\t         2. Non-active player's matching triggers (in registration order).\n322\t         \"\"\"\n323\t+        # Deliver one-shot deferred effects scheduled for \"the beginning of\n324\t+        # your next main phase\". These run directly (not via the stack) so\n325\t+        # that firing the event makes the scheduled effect observable\n326\t+        # immediately, mirroring how delayed riders resolve. Additive.\n327\t+        from engine.events import BeginningOfMainPhaseTriggeredEvent\n328\t+\n329\t+        if isinstance(event, BeginningOfMainPhaseTriggeredEvent):\n330\t+            from engine.deferred import deliver_main_phase_deferred_effects\n331\t+\n332\t+            deliver_main_phase_deferred_effects(game, event)\n333\t+\n334\t         matching: list[TriggerRegistration] = []\n335\t         for trigger in self._triggers:\n336\t             if not isinstance(event, trigger.event_type):\n337\tdiff --git a/engine/turn.py b/engine/turn.py\n338\tindex e400349..3172567 100644\n339\t--- a/engine/turn.py\n340\t+++ b/engine/turn.py\n341\t@@ -204,6 +204,26 @@ def run_turn(game: GameState) -> None:\n342\t             game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n343\t         elif current == (Phase.BEGINNING, Step.DRAW):\n344\t             _do_draw_step(game)\n345\t+        elif current == (Phase.PRECOMBAT_MAIN, None):\n346\t+            from engine.events import BeginningOfMainPhaseTriggeredEvent\n347\t+            game.trigger_manager.fire_event(\n348\t+                game,\n349\t+                BeginningOfMainPhaseTriggeredEvent(\n350\t+                    player=game.active_player,\n351\t+                    controller=game.active_player,\n352\t+                    precombat=True,\n353\t+                ),\n354\t+            )\n355\t+        elif current == (Phase.POSTCOMBAT_MAIN, None):\n356\t+            from engine.events import BeginningOfMainPhaseTriggeredEvent\n357\t+            game.trigger_manager.fire_event(\n358\t+                game,\n359\t+                BeginningOfMainPhaseTriggeredEvent(\n360\t+                    player=game.active_player,\n361\t+                    controller=game.active_player,\n362\t+                    precombat=False,\n363\t+                ),\n364\t+            )\n365\t         elif game.phase == Phase.COMBAT and game.step is not None:\n366\t             _do_combat_step(game, game.step)\n367\t         elif current == (Phase.ENDING, Step.CLEANUP):\n368\tdiff --git a/engine/deferred.py b/engine/deferred.py\n369\tnew file mode 100644\n370\tindex 0000000..739887d\n371\t--- /dev/null\n372\t+++ b/engine/deferred.py\n373\t@@ -0,0 +1,62 @@\n374\t+\"\"\"Delivery of delayed / one-shot deferred effects.\n375\t+\n376\t+The engine schedules one-shot effects that should run \"at the beginning of a\n377\t+player's next (precombat) main phase\" on\n378\t+:attr:`GameState.main_phase_deferred_effects` via\n379\t+:meth:`GameState.schedule_main_phase_deferred_effect`.\n380\t+\n381\t+This module delivers those effects when the matching\n382\t+:class:`~engine.events.BeginningOfMainPhaseTriggeredEvent` fires.  Delivery is\n383\t+invoked from :meth:`engine.triggers.TriggerManager.fire_event` so that firing\n384\t+the event (the way tests fire ETB events) runs the scheduled callbacks directly\n385\t+and removes them — they are one-shot.\n386\t+\"\"\"\n387\t+\n388\t+from __future__ import annotations\n389\t+\n390\t+from typing import TYPE_CHECKING\n391\t+\n392\t+from engine.events import BeginningOfMainPhaseTriggeredEvent\n393\t+\n394\t+if TYPE_CHECKING:\n395\t+    from engine.game_state import GameState\n396\t+\n397\t+\n398\t+def deliver_main_phase_deferred_effects(\n399\t+    game: GameState,\n400\t+    event: BeginningOfMainPhaseTriggeredEvent,\n401\t+) -> None:\n402\t+    \"\"\"Run and remove any deferred effects matching *event*.\n403\t+\n404\t+    A scheduled effect matches when its ``controller`` is the event's\n405\t+    controller/player and (when the effect requested ``precombat``) the event\n406\t+    is for the precombat main phase.  Matching effects run exactly once and\n407\t+    are removed from the registry.\n408\t+    \"\"\"\n409\t+    pending = getattr(game, \"main_phase_deferred_effects\", None)\n410\t+    if not pending:\n411\t+        return\n412\t+\n413\t+    target = getattr(event, \"controller\", None) or getattr(event, \"player\", None)\n414\t+    is_precombat = getattr(event, \"precombat\", True)\n415\t+\n416\t+    remaining: list[dict] = []\n417\t+    to_run: list[dict] = []\n418\t+    for entry in pending:\n419\t+        if entry.get(\"controller\") is not target:\n420\t+            remaining.append(entry)\n421\t+            continue\n422\t+        if entry.get(\"precombat\", True) and not is_precombat:\n423\t+            # Effect wants the precombat main phase but this is postcombat.\n424\t+            remaining.append(entry)\n425\t+            continue\n426\t+        to_run.append(entry)\n427\t+\n428\t+    # Replace the registry first so callbacks that schedule further effects\n429\t+    # are not clobbered.\n430\t+    game.main_phase_deferred_effects = remaining\n431\t+\n432\t+    for entry in to_run:\n433\t+        callback = entry.get(\"callback\")\n434\t+        if callback is not None:\n435\t+            callback(game)\n436\t"}]},"parent_tool_use_id":"toolu_018Gqe6nmCSgzsoRzUUx67VM","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"11c7ca05-f9f7-4584-9911-9b7690249c8b","timestamp":"2026-06-02T00:34:14.150Z","subagent_type":"Reviewer","task_description":"Review sos_57 implementation"}
