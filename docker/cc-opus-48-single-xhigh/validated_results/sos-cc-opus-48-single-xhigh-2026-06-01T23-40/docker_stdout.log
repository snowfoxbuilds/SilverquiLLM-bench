re with zero toughness goes to graveyard normally.\n654-        \"\"\"\n655-        from engine.state_based_actions import resolve_state_based_actions\n656-        alice = game.players[0]\n657-        protected = _make_creature('Protected Bear', power=2, toughness=0, owner=alice, controller=alice)\n658-        unprotected = _make_creature('Normal Bear', power=2, toughness=0, owner=alice, controller=alice)\n659-        bf = game.get_battlefield(alice)\n660-        bf.add(protected)\n661-        bf.add(unprotected)\n662-\n663-        def only_for_protected(g: Any, event: dict[str, Any]) -> bool:\n664-            return event.creature is protected\n665-\n666:        def exile_instead(g: Any, event: dict[str, Any]) -> dict[str, Any]:\n667-            event.destination = 'exile'\n668-            return event\n669:        game.replacement_manager.register(ReplacementEffect(event_type=CreatureDiesReplacementEvent, source=protected, condition=only_for_protected, replacement=exile_instead))\n670-        resolve_state_based_actions(game)\n671-        assert not bf.contains(protected)\n672-        exile = game.get_exile(alice)\n673-        assert exile.contains(protected), 'protected creature should be exiled'\n674-        gy = game.get_graveyard(alice)\n675-        assert not gy.contains(protected), 'protected creature should NOT be in graveyard'\n676-        assert not bf.contains(unprotected)\n677-        assert gy.contains(unprotected), 'unprotected creature should go to graveyard normally'\n678-        assert not exile.contains(unprotected), 'unprotected creature should NOT be exiled'\n679-\n680-    def test_replacement_effect_unregistered_after_creature_exiled(self, game: GameState) -> None:\n681-        \"\"\"After a creature is exiled via replacement effect through SBA, its\n682-        replacement effects should be cleaned up from the manager.\n683-        \"\"\"\n684-        from engine.state_based_actions import resolve_state_based_actions\n685-        alice = game.