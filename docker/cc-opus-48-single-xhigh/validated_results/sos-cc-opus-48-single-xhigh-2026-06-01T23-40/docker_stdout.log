{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KD2aXfJtz1PCEuwkPqN81U","type":"tool_result","content":"1\t\"\"\"Tests for SOS 57 — Mana Sculpt.\n2\t\n3\tMana Sculpt — {1}{U}{U} — Instant:\n4\t\n5\t    \"Counter target spell. If you control a Wizard, add an amount of {C}\n6\t    equal to the amount of mana spent to cast that spell at the beginning\n7\t    of your next main phase.\"\n8\t\n9\tThe card has three distinct behavioural clauses:\n10\t\n11\t1. **Counter target spell** — any spell on the stack is a legal target\n12\t   (creature spells *and* noncreature spells, unlike \"counter target\n13\t   noncreature spell\"). On resolution the targeted spell is removed from\n14\t   the stack and put into its owner's graveyard; it never resolves.\n15\t2. **Wizard gate** — the deferred mana benefit only happens *if its\n16\t   controller controls a Wizard* (a creature with the ``Wizard`` subtype).\n17\t3. **Deferred {C}** — at the beginning of the controller's next main phase,\n18\t   they add an amount of {C} equal to the amount of mana spent to cast the\n19\t   countered spell.\n20\t\n21\tThese tests follow the FDN reference-test style: static-property checks plus\n22\tbehavioural checks that set up explicit board / stack states and drive the\n23\tcard's public hooks (``get_targets`` / ``can_cast`` / ``on_resolve``).\n24\t\"\"\"\n25\t\n26\tfrom __future__ import annotations\n27\t\n28\tfrom cards.sos.sos_57.card_impl import ManaSculpt\n29\tfrom engine.card import Creature, Instant, Sorcery\n30\tfrom engine.casting import cast_spell as engine_cast_spell\n31\tfrom engine.events import BeginningOfMainPhaseTriggeredEvent\n32\tfrom engine.types import CardType, ManaCost, ManaType, Phase, Zone\n33\tfrom test_utils import create_game, set_board_state\n34\t\n35\t\n36\t# ---------------------------------------------------------------------------\n37\t# Helpers\n38\t# ---------------------------------------------------------------------------\n39\t\n40\tdef _wizard(power: int = 1, toughness: int = 1) -> Creature:\n41\t    \"\"\"A creature with the Wizard subtype.\"\"\"\n42\t    return Creature(\n43\t        name=\"Test Wizard\",\n44\t        base_power=power,\n45\t        base_toughness=toughness,\n46\t        subtypes={\"Wizard\"},\n47\t    )\n48\t\n49\t\n50\tdef _non_wizard(power: int = 2, toughness: int = 2) -> Creature:\n51\t    \"\"\"A creature with no relevant subtype.\"\"\"\n52\t    return Creature(\n53\t        name=\"Grizzly Bears\",\n54\t        base_power=power,\n55\t        base_toughness=toughness,\n56\t        subtypes={\"Bear\"},\n57\t    )\n58\t\n59\t\n60\tdef _put_spell_on_stack(game, caster, card, mana=None):\n61\t    \"\"\"Cast *card* from *caster*'s hand through the real engine pipeline so it\n62\t    sits on the stack (un-resolved). Returns the StackObject for that spell.\n63\t\n64\t    Sets up sorcery-speed timing for the caster and grants the supplied mana.\n65\t    \"\"\"\n66\t    if mana is None:\n67\t        mana = {ManaType.COLORLESS: 10}\n68\t    caster_index = game.players.index(caster)\n69\t    set_board_state(game, caster_index, hand=[card], mana=mana)\n70\t    game.active_player_index = caster_index\n71\t    game.priority_player_index = caster_index\n72\t    game.phase = Phase.PRECOMBAT_MAIN\n73\t    game.step = None\n74\t    engine_cast_spell(game, caster, card)\n75\t    return game.stack.peek()\n76\t\n77\t\n78\t# ---------------------------------------------------------------------------\n79\t# Static card properties\n80\t# ---------------------------------------------------------------------------\n81\t\n82\tclass TestManaSculptProperties:\n83\t    \"\"\"Static card data should match the SOS 57 spec.\"\"\"\n84\t\n85\t    def test_name(self) -> None:\n86\t        assert ManaSculpt(owner=None).name == \"Mana Sculpt\"\n87\t\n88\t    def test_is_instant(self) -> None:\n89\t        card = ManaSculpt(owner=None)\n90\t        assert isinstance(card, Instant)\n91\t        assert CardType.INSTANT in card.card_types\n92\t\n93\t    def test_mana_cost(self) -> None:\n94\t        assert ManaSculpt(owner=None).mana_cost == ManaCost.parse(\"{1}{U}{U}\")\n95\t\n96\t    def test_is_not_a_permanent_type(self) -> None:\n97\t        \"\"\"An instant is not a creature/permanent.\"\"\"\n98\t        card = ManaSculpt(owner=None)\n99\t        assert CardType.CREATURE not in card.card_types\n100\t        assert CardType.LAND not in card.card_types\n101\t\n102\t\n103\t# ---------------------------------------------------------------------------\n104\t# Targeting: \"Counter target spell\"\n105\t# ---------------------------------------------------------------------------\n106\t\n107\tclass TestManaSculptTargeting:\n108\t    \"\"\"get_targets / can_cast should accept any spell on the stack.\"\"\"\n109\t\n110\t    def test_get_targets_returns_one_requirement(self) -> None:\n111\t        \"\"\"The spell targets exactly one thing (target spell).\"\"\"\n112\t        game = create_game()\n113\t        p1 = game.players[0]\n114\t        # Put an instant on the stack to provide a legal target.\n115\t        p2 = game.players[1]\n116\t        _put_spell_on_stack(\n117\t            game, p2, Instant(name=\"Doomed Bolt\", mana_cost=ManaCost(pips={ManaType.RED: 1})),\n118\t            mana={ManaType.RED: 1},\n119\t        )\n120\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n121\t        reqs = sculpt.get_targets(game)\n122\t        assert len(reqs) == 1\n123\t\n124\t    def test_target_requirement_zone_is_stack(self) -> None:\n125\t        \"\"\"The legal targets live on the stack, not the battlefield.\"\"\"\n126\t        game = create_game()\n127\t        p1 = game.players[0]\n128\t        p2 = game.players[1]\n129\t        _put_spell_on_stack(\n130\t            game, p2, Instant(name=\"Doomed Bolt\", mana_cost=ManaCost(pips={ManaType.RED: 1})),\n131\t            mana={ManaType.RED: 1},\n132\t        )\n133\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n134\t        req = sculpt.get_targets(game)[0]\n135\t        assert getattr(req, \"zone\", None) == Zone.STACK\n136\t\n137\t    def test_target_filter_accepts_creature_spell(self) -> None:\n138\t        \"\"\"Unlike 'counter target noncreature spell', a creature spell is legal.\"\"\"\n139\t        game = create_game()\n140\t        p1 = game.players[0]\n141\t        p2 = game.players[1]\n142\t        bear_obj = _put_spell_on_stack(\n143\t            game, p2,\n144\t            Creature(\n145\t                name=\"Big Bear\",\n146\t                mana_cost=ManaCost(generic=1, pips={ManaType.GREEN: 1}),\n147\t                base_power=3, base_toughness=3,\n148\t            ),\n149\t            mana={ManaType.GREEN: 2},\n150\t        )\n151\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n152\t        req = sculpt.get_targets(game)[0]\n153\t        assert req.filter_fn(bear_obj) is True\n154\t\n155\t    def test_target_filter_accepts_noncreature_spell(self) -> None:\n156\t        \"\"\"A noncreature spell (instant) is also a legal target.\"\"\"\n157\t        game = create_game()\n158\t        p1 = game.players[0]\n159\t        p2 = game.players[1]\n160\t        bolt_obj = _put_spell_on_stack(\n161\t            game, p2, Instant(name=\"Doomed Bolt\", mana_cost=ManaCost(pips={ManaType.RED: 1})),\n162\t            mana={ManaType.RED: 1},\n163\t        )\n164\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n165\t        req = sculpt.get_targets(game)[0]\n166\t        assert req.filter_fn(bolt_obj) is True\n167\t\n168\t    def test_target_filter_rejects_self(self) -> None:\n169\t        \"\"\"Mana Sculpt cannot target itself on the stack.\"\"\"\n170\t        game = create_game()\n171\t        p1 = game.players[0]\n172\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n173\t        # Provide another spell so get_targets does not early-return empty.\n174\t        p2 = game.players[1]\n175\t        _put_spell_on_stack(\n176\t            game, p2, Instant(name=\"Doomed Bolt\", mana_cost=ManaCost(pips={ManaType.RED: 1})),\n177\t            mana={ManaType.RED: 1},\n178\t        )\n179\t        req = sculpt.get_targets(game)[0]\n180\t        # A spell can never counter itself. The targeting layer works over the\n181\t        # STACK zone, so the filter must reject a StackObject whose source is\n182\t        # this very Mana Sculpt. (Accept either representation the filter may\n183\t        # be handed: the raw card or the wrapping StackObject.)\n184\t        from engine.stack import StackObject\n185\t        own_obj = StackObject(source=sculpt, controller=p1)\n186\t        assert req.filter_fn(own_obj) is False\n187\t        assert req.filter_fn(sculpt) is False\n188\t\n189\t    def test_cannot_cast_with_empty_stack(self) -> None:\n190\t        \"\"\"With no spell on the stack there is no legal target → can_cast False.\"\"\"\n191\t        game = create_game()\n192\t        p1 = game.players[0]\n193\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n194\t        assert sculpt.can_cast(game) is False\n195\t\n196\t    def test_can_cast_with_spell_on_stack(self) -> None:\n197\t        \"\"\"A spell on the stack provides a legal target → can_cast True.\"\"\"\n198\t        game = create_game()\n199\t        p1 = game.players[0]\n200\t        p2 = game.players[1]\n201\t        _put_spell_on_stack(\n202\t            game, p2, Instant(name=\"Doomed Bolt\", mana_cost=ManaCost(pips={ManaType.RED: 1})),\n203\t            mana={ManaType.RED: 1},\n204\t        )\n205\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n206\t        assert sculpt.can_cast(game) is True\n207\t\n208\t\n209\t# ---------------------------------------------------------------------------\n210\t# Counter behaviour: \"Counter target spell\"\n211\t# ---------------------------------------------------------------------------\n212\t\n213\tclass TestManaSculptCounter:\n214\t    \"\"\"On resolution the targeted spell is countered (removed from stack →\n215\t    graveyard) and never resolves.\"\"\"\n216\t\n217\t    def test_counters_instant_to_graveyard(self) -> None:\n218\t        game = create_game()\n219\t        p1 = game.players[0]\n220\t        p2 = game.players[1]\n221\t        bolt = Instant(name=\"Doomed Bolt\", mana_cost=ManaCost(pips={ManaType.RED: 1}))\n222\t        bolt_obj = _put_spell_on_stack(game, p2, bolt, mana={ManaType.RED: 1})\n223\t\n224\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n225\t        sculpt.chosen_targets = [bolt_obj]\n226\t        sculpt.on_resolve(game)\n227\t\n228\t        # The targeted instant is now in its owner's graveyard, not on the stack.\n229\t        assert game.get_graveyard(p2).contains(bolt)\n230\t        assert not game.players[1].zones[Zone.STACK].contains(bolt)\n231\t\n232\t    def test_countered_spell_removed_from_stack(self) -> None:\n233\t        \"\"\"The countered spell's StackObject is gone from the stack.\"\"\"\n234\t        game = create_game()\n235\t        p1 = game.players[0]\n236\t        p2 = game.players[1]\n237\t        bolt = Instant(name=\"Doomed Bolt\", mana_cost=ManaCost(pips={ManaType.RED: 1}))\n238\t        bolt_obj = _put_spell_on_stack(game, p2, bolt, mana={ManaType.RED: 1})\n239\t\n240\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n241\t        sculpt.chosen_targets = [bolt_obj]\n242\t        sculpt.on_resolve(game)\n243\t\n244\t        assert bolt_obj not in game.stack.objects()\n245\t\n246\t    def test_countered_creature_does_not_enter_battlefield(self) -> None:\n247\t        \"\"\"A countered creature spell never reaches the battlefield.\"\"\"\n248\t        game = create_game()\n249\t        p1 = game.players[0]\n250\t        p2 = game.players[1]\n251\t        bear = Creature(\n252\t            name=\"Doomed Bear\",\n253\t            mana_cost=ManaCost(generic=1, pips={ManaType.GREEN: 1}),\n254\t            base_power=2, base_toughness=2,\n255\t        )\n256\t        bear_obj = _put_spell_on_stack(game, p2, bear, mana={ManaType.GREEN: 2})\n257\t\n258\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n259\t        sculpt.chosen_targets = [bear_obj]\n260\t        sculpt.on_resolve(game)\n261\t\n262\t        assert not game.get_battlefield(p2).contains(bear)\n263\t        assert game.get_graveyard(p2).contains(bear)\n264\t\n265\t    def test_counters_sorcery(self) -> None:\n266\t        \"\"\"A sorcery on the stack is also countered to its owner's graveyard.\"\"\"\n267\t        game = create_game()\n268\t        p1 = game.players[0]\n269\t        p2 = game.players[1]\n270\t        sorc = Sorcery(name=\"Doomed Divination\",\n271\t                       mana_cost=ManaCost(generic=2, pips={ManaType.BLUE: 1}))\n272\t        sorc_obj = _put_spell_on_stack(game, p2, sorc, mana={ManaType.BLUE: 3})\n273\t\n274\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n275\t        sculpt.chosen_targets = [sorc_obj]\n276\t        sculpt.on_resolve(game)\n277\t\n278\t        assert game.get_graveyard(p2).contains(sorc)\n279\t\n280\t    def test_no_target_is_noop(self) -> None:\n281\t        \"\"\"With no chosen target the resolve does nothing and does not raise.\"\"\"\n282\t        game = create_game()\n283\t        p1 = game.players[0]\n284\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n285\t        # No chosen_targets attribute set at all.\n286\t        sculpt.on_resolve(game)  # must not raise\n287\t\n288\t\n289\t# ---------------------------------------------------------------------------\n290\t# Wizard gate + deferred {C} mana\n291\t# ---------------------------------------------------------------------------\n292\t\n293\tclass TestManaSculptWizardManaGate:\n294\t    \"\"\"The {C} reimbursement only triggers when its controller controls a\n295\t    Wizard; the amount equals the mana spent on the countered spell.\n296\t\n297\t    The engine has no native 'beginning of your next main phase' delayed\n298\t    trigger, so these tests verify the *gating decision* made at resolution\n299\t    time (whether the deferred benefit is set up at all) and — where the\n300\t    implementation exposes it — the recorded amount of {C}. We avoid\n301\t    asserting on a specific private delivery mechanism by checking the\n302\t    controller's {C} pool after the implementation's own delayed-effect\n303\t    delivery hook is invoked, when such a hook exists.\n304\t    \"\"\"\n305\t\n306\t    def test_no_wizard_no_mana_added_immediately(self) -> None:\n307\t        \"\"\"Without a Wizard, resolving Mana Sculpt must not immediately add\n308\t        {C} to the controller's mana pool (the benefit is gated off).\"\"\"\n309\t        game = create_game()\n310\t        p1 = game.players[0]\n311\t        p2 = game.players[1]\n312\t        set_board_state(game, 0, battlefield=[_non_wizard()],\n313\t                        mana={ManaType.COLORLESS: 0})\n314\t        bolt = Instant(name=\"Doomed Bolt\",\n315\t                       mana_cost=ManaCost(generic=1, pips={ManaType.RED: 1}))\n316\t        bolt_obj = _put_spell_on_stack(game, p2, bolt, mana={ManaType.RED: 3})\n317\t\n318\t        before = p1.mana_pool.get(ManaType.COLORLESS)\n319\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n320\t        sculpt.chosen_targets = [bolt_obj]\n321\t        sculpt.on_resolve(game)\n322\t\n323\t        # The spell is still countered ...\n324\t        assert game.get_graveyard(p2).contains(bolt)\n325\t        # ... but no {C} reimbursement is set up without a Wizard.\n326\t        assert p1.mana_pool.get(ManaType.COLORLESS) == before\n327\t\n328\t    def test_counter_happens_even_without_wizard(self) -> None:\n329\t        \"\"\"The counter is unconditional — only the {C} benefit is gated.\"\"\"\n330\t        game = create_game()\n331\t        p1 = game.players[0]\n332\t        p2 = game.players[1]\n333\t        set_board_state(game, 0, battlefield=[_non_wizard()])\n334\t        bolt = Instant(name=\"Doomed Bolt\", mana_cost=ManaCost(pips={ManaType.RED: 1}))\n335\t        bolt_obj = _put_spell_on_stack(game, p2, bolt, mana={ManaType.RED: 1})\n336\t\n337\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n338\t        sculpt.chosen_targets = [bolt_obj]\n339\t        sculpt.on_resolve(game)\n340\t\n341\t        assert game.get_graveyard(p2).contains(bolt)\n342\t\n343\t    def test_wizard_sets_up_deferred_mana(self) -> None:\n344\t        \"\"\"With a Wizard in play the spell records a pending {C} reimbursement\n345\t        whose amount equals the mana spent to cast the countered spell.\n346\t\n347\t        The bolt below costs {1}{R} (2 mana). Paying it from a pool of 3 red\n348\t        deducts exactly 2 mana, so the amount of mana spent — and therefore the\n349\t        deferred {C} — must be 2. We read the recorded pending amount via a\n350\t        plausible attribute on the resolving spell or its controller. If none\n351\t        is present this test fails (red phase).\n352\t        \"\"\"\n353\t        game = create_game()\n354\t        p1 = game.players[0]\n355\t        p2 = game.players[1]\n356\t        set_board_state(game, 0, battlefield=[_wizard()])\n357\t        bolt = Instant(name=\"Doomed Bolt\",\n358\t                       mana_cost=ManaCost(generic=1, pips={ManaType.RED: 1}))\n359\t        bolt_obj = _put_spell_on_stack(game, p2, bolt, mana={ManaType.RED: 3})\n360\t\n361\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n362\t        sculpt.chosen_targets = [bolt_obj]\n363\t        sculpt.on_resolve(game)\n364\t\n365\t        pending = _read_pending_colorless(sculpt, p1)\n366\t        assert pending == 2\n367\t\n368\t    def test_deferred_amount_tracks_larger_spend(self) -> None:\n369\t        \"\"\"The reimbursement scales with the mana actually spent (5 here).\"\"\"\n370\t        game = create_game()\n371\t        p1 = game.players[0]\n372\t        p2 = game.players[1]\n373\t        set_board_state(game, 0, battlefield=[_wizard()])\n374\t        big = Creature(\n375\t            name=\"Doomed Behemoth\",\n376\t            mana_cost=ManaCost(generic=3, pips={ManaType.GREEN: 2}),\n377\t            base_power=5, base_toughness=5,\n378\t        )\n379\t        big_obj = _put_spell_on_stack(game, p2, big, mana={ManaType.GREEN: 5})\n380\t\n381\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n382\t        sculpt.chosen_targets = [big_obj]\n383\t        sculpt.on_resolve(game)\n384\t\n385\t        pending = _read_pending_colorless(sculpt, p1)\n386\t        assert pending == 5\n387\t\n388\t    def test_mana_not_added_immediately_even_with_wizard(self) -> None:\n389\t        \"\"\"The {C} is added 'at the beginning of your next main phase', so it\n390\t        must NOT be in the pool the instant Mana Sculpt resolves.\"\"\"\n391\t        game = create_game()\n392\t        p1 = game.players[0]\n393\t        p2 = game.players[1]\n394\t        set_board_state(game, 0, battlefield=[_wizard()],\n395\t                        mana={ManaType.COLORLESS: 0})\n396\t        bolt = Instant(name=\"Doomed Bolt\",\n397\t                       mana_cost=ManaCost(generic=1, pips={ManaType.RED: 1}))\n398\t        bolt_obj = _put_spell_on_stack(game, p2, bolt, mana={ManaType.RED: 3})\n399\t\n400\t        before = p1.mana_pool.get(ManaType.COLORLESS)\n401\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n402\t        sculpt.chosen_targets = [bolt_obj]\n403\t        sculpt.on_resolve(game)\n404\t\n405\t        # Deferred — pool unchanged at resolution time.\n406\t        assert p1.mana_pool.get(ManaType.COLORLESS) == before\n407\t\n408\t\n409\t# ---------------------------------------------------------------------------\n410\t# Deterministic delivery of the deferred {C}\n411\t# ---------------------------------------------------------------------------\n412\t\n413\tclass TestManaSculptDeferredDelivery:\n414\t    \"\"\"End-to-end delivery of the deferred {C} reimbursement.\n415\t\n416\t    The engine now exposes a stable surface for \"at the beginning of your next\n417\t    main phase\": resolving Mana Sculpt with a Wizard in play schedules a\n418\t    one-shot deferred effect, and firing\n419\t    :class:`BeginningOfMainPhaseTriggeredEvent` for the controller (precombat)\n420\t    runs that effect synchronously — adding the recorded amount of {C} to the\n421\t    controller's mana pool exactly once.\n422\t\n423\t    The amount equals the mana spent to cast the countered spell, which the\n424\t    casting pipeline records on ``card.mana_spent`` (the converted cost actually\n425\t    paid). A ``{1}{R}`` bolt therefore reimburses 2 {C}.\n426\t    \"\"\"\n427\t\n428\t    @staticmethod\n429\t    def _fire_next_main_phase(game, controller) -> None:\n430\t        \"\"\"Fire the precombat BeginningOfMainPhase event for *controller*.\n431\t\n432\t        This drives the scheduled deferred effect synchronously without\n433\t        advancing the stack — the same way the engine delivers it on the\n434\t        controller's next main phase.\n435\t        \"\"\"\n436\t        game.trigger_manager.fire_event(\n437\t            game,\n438\t            BeginningOfMainPhaseTriggeredEvent(\n439\t                player=controller, controller=controller, precombat=True\n440\t            ),\n441\t        )\n442\t\n443\t    def test_deferred_colorless_not_in_pool_at_resolution(self) -> None:\n444\t        \"\"\"With a Wizard, the {C} is deferred — the pool is still empty the\n445\t        instant Mana Sculpt resolves (delivery happens later).\"\"\"\n446\t        game = create_game()\n447\t        p1 = game.players[0]\n448\t        p2 = game.players[1]\n449\t        set_board_state(game, 0, battlefield=[_wizard()],\n450\t                        mana={ManaType.COLORLESS: 0})\n451\t        # {1}{R} bolt → mana_spent == 2.\n452\t        bolt = Instant(name=\"Doomed Bolt\",\n453\t                       mana_cost=ManaCost(generic=1, pips={ManaType.RED: 1}))\n454\t        bolt_obj = _put_spell_on_stack(game, p2, bolt, mana={ManaType.RED: 3})\n455\t        assert getattr(bolt, \"mana_spent\", 0) == 2\n456\t\n457\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n458\t        sculpt.chosen_targets = [bolt_obj]\n459\t        sculpt.on_resolve(game)\n460\t\n461\t        # Spell countered, but no {C} yet — it is deferred to the next main phase.\n462\t        assert game.get_graveyard(p2).contains(bolt)\n463\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 0\n464\t\n465\t    def test_deferred_colorless_added_at_next_main_phase(self) -> None:\n466\t        \"\"\"Firing the controller's precombat BeginningOfMainPhase event adds\n467\t        exactly the countered spell's mana_spent worth of {C}.\"\"\"\n468\t        game = create_game()\n469\t        p1 = game.players[0]\n470\t        p2 = game.players[1]\n471\t        set_board_state(game, 0, battlefield=[_wizard()],\n472\t                        mana={ManaType.COLORLESS: 0})\n473\t        bolt = Instant(name=\"Doomed Bolt\",\n474\t                       mana_cost=ManaCost(generic=1, pips={ManaType.RED: 1}))\n475\t        bolt_obj = _put_spell_on_stack(game, p2, bolt, mana={ManaType.RED: 3})\n476\t        spent = getattr(bolt, \"mana_spent\", 0)\n477\t        assert spent == 2\n478\t\n479\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n480\t        sculpt.chosen_targets = [bolt_obj]\n481\t        sculpt.on_resolve(game)\n482\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 0\n483\t\n484\t        self._fire_next_main_phase(game, p1)\n485\t\n486\t        # The deferred {C} is now in the controller's pool, equal to mana spent.\n487\t        assert p1.mana_pool.get(ManaType.COLORLESS) == spent\n488\t\n489\t    def test_deferred_delivery_scales_with_larger_spend(self) -> None:\n490\t        \"\"\"A pricier countered spell (5 mana) delivers 5 {C} at the next main\n491\t        phase — the amount tracks the mana actually spent.\"\"\"\n492\t        game = create_game()\n493\t        p1 = game.players[0]\n494\t        p2 = game.players[1]\n495\t        set_board_state(game, 0, battlefield=[_wizard()],\n496\t                        mana={ManaType.COLORLESS: 0})\n497\t        big = Creature(\n498\t            name=\"Doomed Behemoth\",\n499\t            mana_cost=ManaCost(generic=3, pips={ManaType.GREEN: 2}),\n500\t            base_power=5, base_toughness=5,\n501\t        )\n502\t        big_obj = _put_spell_on_stack(game, p2, big, mana={ManaType.GREEN: 5})\n503\t        spent = getattr(big, \"mana_spent\", 0)\n504\t        assert spent == 5\n505\t\n506\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n507\t        sculpt.chosen_targets = [big_obj]\n508\t        sculpt.on_resolve(game)\n509\t\n510\t        self._fire_next_main_phase(game, p1)\n511\t\n512\t        assert p1.mana_pool.get(ManaType.COLORLESS) == spent\n513\t\n514\t    def test_deferred_delivery_is_one_shot(self) -> None:\n515\t        \"\"\"Firing the BeginningOfMainPhase event a SECOND time must not add\n516\t        any more {C} — the reimbursement is one-shot.\"\"\"\n517\t        game = create_game()\n518\t        p1 = game.players[0]\n519\t        p2 = game.players[1]\n520\t        set_board_state(game, 0, battlefield=[_wizard()],\n521\t                        mana={ManaType.COLORLESS: 0})\n522\t        bolt = Instant(name=\"Doomed Bolt\",\n523\t                       mana_cost=ManaCost(generic=1, pips={ManaType.RED: 1}))\n524\t        bolt_obj = _put_spell_on_stack(game, p2, bolt, mana={ManaType.RED: 3})\n525\t        spent = getattr(bolt, \"mana_spent\", 0)\n526\t        assert spent == 2\n527\t\n528\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n529\t        sculpt.chosen_targets = [bolt_obj]\n530\t        sculpt.on_resolve(game)\n531\t\n532\t        self._fire_next_main_phase(game, p1)\n533\t        after_first = p1.mana_pool.get(ManaType.COLORLESS)\n534\t        assert after_first == spent\n535\t\n536\t        # Fire again — the deferred effect has already been consumed.\n537\t        self._fire_next_main_phase(game, p1)\n538\t        assert p1.mana_pool.get(ManaType.COLORLESS) == after_first\n539\t\n540\t    def test_no_wizard_nothing_delivered_at_next_main_phase(self) -> None:\n541\t        \"\"\"Without a Wizard nothing is scheduled, so firing the next main-phase\n542\t        event adds no {C} at all.\"\"\"\n543\t        game = create_game()\n544\t        p1 = game.players[0]\n545\t        p2 = game.players[1]\n546\t        set_board_state(game, 0, battlefield=[_non_wizard()],\n547\t                        mana={ManaType.COLORLESS: 0})\n548\t        bolt = Instant(name=\"Doomed Bolt\",\n549\t                       mana_cost=ManaCost(generic=1, pips={ManaType.RED: 1}))\n550\t        bolt_obj = _put_spell_on_stack(game, p2, bolt, mana={ManaType.RED: 3})\n551\t\n552\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n553\t        sculpt.chosen_targets = [bolt_obj]\n554\t        sculpt.on_resolve(game)\n555\t\n556\t        self._fire_next_main_phase(game, p1)\n557\t\n558\t        # Spell still countered, but no Wizard → no deferred {C} ever delivered.\n559\t        assert game.get_graveyard(p2).contains(bolt)\n560\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 0\n561\t\n562\t\n563\t# ---------------------------------------------------------------------------\n564\t# Shared accessor for the deferred-{C} amount\n565\t# ---------------------------------------------------------------------------\n566\t\n567\tdef _read_pending_colorless(sculpt, controller):\n568\t    \"\"\"Read the pending deferred-{C} amount the implementation recorded.\n569\t\n570\t    The card may stash this on the spell instance or on its controller; we\n571\t    accept a small set of plausible attribute names so the test asserts on\n572\t    *behaviour* (amount recorded) rather than a single private field name.\n573\t    \"\"\"\n574\t    for obj in (sculpt, controller):\n575\t        for attr in (\n576\t            \"pending_colorless\",\n577\t            \"deferred_colorless\",\n578\t            \"pending_mana\",\n579\t            \"deferred_mana\",\n580\t            \"mana_to_add\",\n581\t        ):\n582\t            val = getattr(obj, attr, None)\n583\t            if isinstance(val, bool):\n584\t                continue\n585\t            if isinstance(val, int):\n586\t                return val\n587\t    return None\n588\t"}]},"parent_tool_use_id":"toolu_018Gqe6nmCSgzsoRzUUx67VM","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"fafd85ae-527d-406c-b906-c778fc0806e6","timestamp":"2026-06-02T00:34:57.720Z","subagent_type":"Reviewer","task_description":"Review sos_57 implementation"}
