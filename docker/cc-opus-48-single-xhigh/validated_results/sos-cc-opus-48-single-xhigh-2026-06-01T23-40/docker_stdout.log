{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Xv9fnzGDzZ9AoGWWWvR7Mr","type":"tool_result","content":"270\t\n271\t    def _bears(self, n: int) -> list[Creature]:\n272\t        return [\n273\t            Creature(name=f\"Bear{i}\", base_power=2, base_toughness=2)\n274\t            for i in range(n)\n275\t        ]\n276\t\n277\t    def test_prepared_when_opponent_has_more_creatures(self) -> None:\n278\t        game = create_game()\n279\t        p1, p2 = game.players\n280\t        card = _make_card(game, 0)\n281\t        # Opponent controls 2 creatures; controller controls only Emeritus (1).\n282\t        for b in self._bears(2):\n283\t            b.owner = p2\n284\t            b.controller = p2\n285\t            game.get_battlefield(p2).add(b)\n286\t        _fire_etb(game, card, target_player=p1)\n287\t        assert self._is_prepared(card) is True\n288\t\n289\t    def test_not_prepared_when_counts_equal(self) -> None:\n290\t        \"\"\"Strictly 'more than' — equal creature counts must NOT prepare it.\"\"\"\n291\t        game = create_game()\n292\t        p1, p2 = game.players\n293\t        card = _make_card(game, 0)\n294\t        # After ETB the controller has Emeritus (1). Give opponent exactly 1 so\n295\t        # that, counting Emeritus, neither side has *more* than the other.\n296\t        b = self._bears(1)[0]\n297\t        b.owner = p2\n298\t        b.controller = p2\n299\t        game.get_battlefield(p2).add(b)\n300\t        # Target self so the token does not change the opponent's count.\n301\t        _fire_etb(game, card, target_player=p1)\n302\t        # The ETB must still have created the token (guards against a no-op\n303\t        # implementation trivially \"passing\" this negative assertion).\n304\t        assert len(_inkling_tokens(game, p1)) == 1\n305\t        assert self._is_prepared(card) is False\n306\t\n307\t    def test_not_prepared_when_controller_has_more(self) -> None:\n308\t        game = create_game()\n309\t        p1, p2 = game.players\n310\t        card = _make_card(game, 0)\n311\t        # Controller has extra creatures; opponent has none.\n312\t        for b in self._bears(2):\n313\t            b.owner = p1\n314\t            b.controller = p1\n315\t            game.get_battlefield(p1).add(b)\n316\t        _fire_etb(game, card, target_player=p1)\n317\t        # The ETB must still have created the token (guards against a no-op\n318\t        # implementation trivially \"passing\" this negative assertion).\n319\t        assert len(_inkling_tokens(game, p1)) == 1\n320\t        assert self._is_prepared(card) is False\n321\t\n322\t    def test_token_under_opponent_can_flip_the_comparison(self) -> None:\n323\t        \"\"\"The token is created *before* the comparison; if it goes to the\n324\t        opponent it counts toward the opponent's creature total.\"\"\"\n325\t        game = create_game()\n326\t        p1, p2 = game.players\n327\t        card = _make_card(game, 0)\n328\t        # Opponent starts with 1 creature; controller has only Emeritus (1).\n329\t        b = self._bears(1)[0]\n330\t        b.owner = p2\n331\t        b.controller = p2\n332\t        game.get_battlefield(p2).add(b)\n333\t        # Token goes to the opponent -> opponent ends with 2, controller with 1.\n334\t        _fire_etb(game, card, target_player=p2)\n335\t        assert self._is_prepared(card) is True\n336\t\n337\t\n338\t# ---------------------------------------------------------------------------\n339\t# Prepare spell — Swords to Plowshares\n340\t# ---------------------------------------------------------------------------\n341\t\n342\t\n343\tclass TestSwordsToPlowshares:\n344\t    \"\"\"The inset prepare spell exiles a creature; its controller gains life\n345\t    equal to that creature's power.\"\"\"\n346\t\n347\t    @staticmethod\n348\t    def _make_prepare_spell(game: Any, controller: Any) -> Any:\n349\t        \"\"\"Obtain a castable copy of the Swords to Plowshares prepare spell.\n350\t\n351\t        The implementation may expose this via a factory/attribute; this helper\n352\t        probes the common shapes and skips if none is available.\n353\t        \"\"\"\n354\t        card = EmeritusOfTruceSwordsToPlowshares(owner=controller, controller=controller)\n355\t        for attr in (\"make_prepare_spell\", \"get_prepare_spell\", \"prepare_spell\", \"create_copy\"):\n356\t            obj = getattr(card, attr, None)\n357\t            if obj is None:\n358\t                continue\n359\t            spell = obj(game) if callable(obj) else obj\n360\t            if spell is not None:\n361\t                spell.owner = controller\n362\t                spell.controller = controller\n363\t                return spell\n364\t        pytest.skip(\"No prepare-spell construction surface exposed by the card.\")\n365\t\n366\t    def test_exiles_target_creature(self) -> None:\n367\t        game = create_game()\n368\t        p1, p2 = game.players\n369\t        spell = self._make_prepare_spell(game, p1)\n370\t        victim = Creature(\n371\t            name=\"Doomed Bear\", owner=p2, controller=p2, base_power=2, base_toughness=2\n372\t        )\n373\t        game.get_battlefield(p2).add(victim)\n374\t        spell.chosen_targets = [victim]\n375\t        spell.on_resolve(game)\n376\t        assert not game.get_battlefield(p2).contains(victim)\n377\t        assert p2.zones[Zone.EXILE].contains(victim)\n378\t\n379\t    def test_controller_gains_life_equal_to_power(self) -> None:\n380\t        game = create_game()\n381\t        p1, p2 = game.players\n382\t        spell = self._make_prepare_spell(game, p1)\n383\t        victim = Creature(\n384\t            name=\"Big Beast\", owner=p2, controller=p2, base_power=5, base_toughness=5\n385\t        )\n386\t        game.get_battlefield(p2).add(victim)\n387\t        before = p2.life\n388\t        spell.chosen_targets = [victim]\n389\t        spell.on_resolve(game)\n390\t        # The exiled creature's CONTROLLER (p2), not the caster, gains the life.\n391\t        assert p2.life == before + 5\n392\t\n393\t    def test_caster_does_not_gain_life_for_opponents_creature(self) -> None:\n394\t        game = create_game()\n395\t        p1, p2 = game.players\n396\t        spell = self._make_prepare_spell(game, p1)\n397\t        victim = Creature(\n398\t            name=\"Big Beast\", owner=p2, controller=p2, base_power=4, base_toughness=4\n399\t        )"}]},"parent_tool_use_id":null,"session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"0893c2a6-9582-4c47-8f4f-26dff64e8d74","timestamp":"2026-06-02T00:11:53.557Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/sos/sos_13/tests.py","content":"\n    def _bears(self, n: int) -> list[Creature]:\n        return [\n            Creature(name=f\"Bear{i}\", base_power=2, base_toughness=2)\n            for i in range(n)\n        ]\n\n    def test_prepared_when_opponent_has_more_creatures(self) -> None:\n        game = create_game()\n        p1, p2 = game.players\n        card = _make_card(game, 0)\n        # Opponent controls 2 creatures; controller controls only Emeritus (1).\n        for b in self._bears(2):\n            b.owner = p2\n            b.controller = p2\n            game.get_battlefield(p2).add(b)\n        _fire_etb(game, card, target_player=p1)\n        assert self._is_prepared(card) is True\n\n    def test_not_prepared_when_counts_equal(self) -> None:\n        \"\"\"Strictly 'more than' — equal creature counts must NOT prepare it.\"\"\"\n        game = create_game()\n        p1, p2 = game.players\n        card = _make_card(game, 0)\n        # After ETB the controller has Emeritus (1). Give opponent exactly 1 so\n        # that, counting Emeritus, neither side has *more* than the other.\n        b = self._bears(1)[0]\n        b.owner = p2\n        b.controller = p2\n        game.get_battlefield(p2).add(b)\n        # Target self so the token does not change the opponent's count.\n        _fire_etb(game, card, target_player=p1)\n        # The ETB must still have created the token (guards against a no-op\n        # implementation trivially \"passing\" this negative assertion).\n        assert len(_inkling_tokens(game, p1)) == 1\n        assert self._is_prepared(card) is False\n\n    def test_not_prepared_when_controller_has_more(self) -> None:\n        game = create_game()\n        p1, p2 = game.players\n        card = _make_card(game, 0)\n        # Controller has extra creatures; opponent has none.\n        for b in self._bears(2):\n            b.owner = p1\n            b.controller = p1\n            game.get_battlefield(p1).add(b)\n        _fire_etb(game, card, target_player=p1)\n        # The ETB must still have created the token (guards against a no-op\n        # implementation trivially \"passing\" this negative assertion).\n        assert len(_inkling_tokens(game, p1)) == 1\n        assert self._is_prepared(card) is False\n\n    def test_token_under_opponent_can_flip_the_comparison(self) -> None:\n        \"\"\"The token is created *before* the comparison; if it goes to the\n        opponent it counts toward the opponent's creature total.\"\"\"\n        game = create_game()\n        p1, p2 = game.players\n        card = _make_card(game, 0)\n        # Opponent starts with 1 creature; controller has only Emeritus (1).\n        b = self._bears(1)[0]\n        b.owner = p2\n        b.controller = p2\n        game.get_battlefield(p2).add(b)\n        # Token goes to the opponent -> opponent ends with 2, controller with 1.\n        _fire_etb(game, card, target_player=p2)\n        assert self._is_prepared(card) is True\n\n\n# ---------------------------------------------------------------------------\n# Prepare spell — Swords to Plowshares\n# ---------------------------------------------------------------------------\n\n\nclass TestSwordsToPlowshares:\n    \"\"\"The inset prepare spell exiles a creature; its controller gains life\n    equal to that creature's power.\"\"\"\n\n    @staticmethod\n    def _make_prepare_spell(game: Any, controller: Any) -> Any:\n        \"\"\"Obtain a castable copy of the Swords to Plowshares prepare spell.\n\n        The implementation may expose this via a factory/attribute; this helper\n        probes the common shapes and skips if none is available.\n        \"\"\"\n        card = EmeritusOfTruceSwordsToPlowshares(owner=controller, controller=controller)\n        for attr in (\"make_prepare_spell\", \"get_prepare_spell\", \"prepare_spell\", \"create_copy\"):\n            obj = getattr(card, attr, None)\n            if obj is None:\n                continue\n            spell = obj(game) if callable(obj) else obj\n            if spell is not None:\n                spell.owner = controller\n                spell.controller = controller\n                return spell\n        pytest.skip(\"No prepare-spell construction surface exposed by the card.\")\n\n    def test_exiles_target_creature(self) -> None:\n        game = create_game()\n        p1, p2 = game.players\n        spell = self._make_prepare_spell(game, p1)\n        victim = Creature(\n            name=\"Doomed Bear\", owner=p2, controller=p2, base_power=2, base_toughness=2\n        )\n        game.get_battlefield(p2).add(victim)\n        spell.chosen_targets = [victim]\n        spell.on_resolve(game)\n        assert not game.get_battlefield(p2).contains(victim)\n        assert p2.zones[Zone.EXILE].contains(victim)\n\n    def test_controller_gains_life_equal_to_power(self) -> None:\n        game = create_game()\n        p1, p2 = game.players\n        spell = self._make_prepare_spell(game, p1)\n        victim = Creature(\n            name=\"Big Beast\", owner=p2, controller=p2, base_power=5, base_toughness=5\n        )\n        game.get_battlefield(p2).add(victim)\n        before = p2.life\n        spell.chosen_targets = [victim]\n        spell.on_resolve(game)\n        # The exiled creature's CONTROLLER (p2), not the caster, gains the life.\n        assert p2.life == before + 5\n\n    def test_caster_does_not_gain_life_for_opponents_creature(self) -> None:\n        game = create_game()\n        p1, p2 = game.players\n        spell = self._make_prepare_spell(game, p1)\n        victim = Creature(\n            name=\"Big Beast\", owner=p2, controller=p2, base_power=4, base_toughness=4\n        )","numLines":130,"startLine":270,"totalLines":414}}}
