{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BAaxtLkW1H9PdppmuiYGsm","type":"tool_result","content":"1\t\"\"\"Card implementation for Witherbloom, the Balancer (SOS 245).\n2\t\n3\tWitherbloom, the Balancer is a ``{6}{B}{G}`` Legendary Creature — Elder\n4\tDragon, 5/5, with flying and deathtouch. It has two affinity-for-creatures\n5\tabilities:\n6\t\n7\t    \"Affinity for creatures (This spell costs {1} less to cast for each\n8\t    creature you control.)\"\n9\t    \"Flying, deathtouch\"\n10\t    \"Instant and sorcery spells you cast have affinity for creatures.\"\n11\t\n12\tAffinity is modeled through the ``cost_reduction(game)`` hook (FDN 6 Claws\n13\tOut convention): the engine clamps the returned reduction to the generic\n14\tportion of the mana cost in :func:`engine.casting.get_cost_reduction`, so\n15\tcolored mana is never reduced and generic never drops below zero. No manual\n16\tclamp is needed here.\n17\t\n18\tThe third ability grants affinity-for-creatures to *other* spells — every\n19\tinstant and sorcery the controller casts. The default\n20\t``get_cost_reduction`` consults only a spell's own ``cost_reduction`` hook,\n21\tso — mirroring the SOS 226 casualty-granting and SOS 201 miracle-granting\n22\tconventions — the grant is exposed through a getattr-safe capability the\n23\tengine's cost-reduction path queries on permanents the caster controls:\n24\t\n25\t* ``grants_affinity_to(spell) -> bool`` — True for instant/sorcery spells.\n26\t* ``affinity_reduction(game) -> int`` — the creature count the controller\n27\t  controls (the granted reduction value; also the dragon's own affinity\n28\t  metric, to which ``cost_reduction`` delegates).\n29\t\"\"\"\n30\t\n31\tfrom __future__ import annotations\n32\t\n33\tfrom typing import TYPE_CHECKING, Any\n34\t\n35\tfrom engine.card import Creature\n36\tfrom engine.types import CardType, Keyword, ManaCost, Supertype\n37\t\n38\tif TYPE_CHECKING:\n39\t    from engine.game_state import GameState\n40\t\n41\t\n42\tclass WitherbloomTheBalancer(Creature):\n43\t    \"\"\"Witherbloom, the Balancer — {6}{B}{G} — 5/5 — Legendary Elder Dragon.\n44\t\n45\t    Affinity for creatures.\n46\t    Flying, deathtouch.\n47\t    Instant and sorcery spells you cast have affinity for creatures.\n48\t\n49\t    SOS collector number 245.\n50\t    \"\"\"\n51\t\n52\t    def __init__(self, **kwargs: Any) -> None:\n53\t        kwargs.setdefault(\"name\", \"Witherbloom, the Balancer\")\n54\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{6}{B}{G}\"))\n55\t        kwargs.setdefault(\"subtypes\", {\"Elder\", \"Dragon\"})\n56\t        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n57\t        kwargs.setdefault(\"keywords\", Keyword.FLYING | Keyword.DEATHTOUCH)\n58\t        kwargs.setdefault(\"base_power\", 5)\n59\t        kwargs.setdefault(\"base_toughness\", 5)\n60\t        kwargs.setdefault(\n61\t            \"rules_text\",\n62\t            \"Affinity for creatures (This spell costs {1} less to cast for \"\n63\t            \"each creature you control.)\\n\"\n64\t            \"Flying, deathtouch\\n\"\n65\t            \"Instant and sorcery spells you cast have affinity for creatures.\",\n66\t        )\n67\t        super().__init__(**kwargs)\n68\t        # Explicit color identity (KEY_DECISIONS sos_13 convention).\n69\t        self.colors: list[str] = [\"B\", \"G\"]\n70\t\n71\t    # ------------------------------------------------------------------\n72\t    # Affinity for creatures — the dragon's OWN cost reduction\n73\t    # ------------------------------------------------------------------\n74\t\n75\t    def cost_reduction(self, game: \"GameState\") -> int:\n76\t        \"\"\"Affinity for creatures: reduce cost by 1 per creature you control.\n77\t\n78\t        Delegates to :meth:`affinity_reduction` — the same creature-count\n79\t        metric the dragon grants to instants/sorceries — so both abilities\n80\t        share one source of truth. The engine clamps the result to the\n81\t        generic portion of the cost in\n82\t        :func:`engine.casting.get_cost_reduction`, so no manual clamp is\n83\t        applied here (FDN 6 convention).\n84\t        \"\"\"\n85\t        return self.affinity_reduction(game)\n86\t\n87\t    # ------------------------------------------------------------------\n88\t    # Granted affinity (capability) — \"Instant and sorcery spells you cast\n89\t    # have affinity for creatures.\"\n90\t    # ------------------------------------------------------------------\n91\t\n92\t    def grants_affinity_to(self, spell: Any) -> bool:\n93\t        \"\"\"Return ``True`` if this dragon grants affinity to *spell*.\n94\t\n95\t        Witherbloom grants affinity-for-creatures to every instant and\n96\t        sorcery spell; any other card type (creature, land, etc.) gets\n97\t        nothing. This is the getattr-safe capability the additive\n98\t        cost-reduction hook in :mod:`engine.casting` queries on permanents\n99\t        the casting player controls.\n100\t        \"\"\"\n101\t        card_types = getattr(spell, \"card_types\", set())\n102\t        return CardType.INSTANT in card_types or CardType.SORCERY in card_types\n103\t\n104\t    def affinity_reduction(self, game: \"GameState\") -> int:\n105\t        \"\"\"Return the affinity-for-creatures reduction value.\n106\t\n107\t        Equal to the number of creatures the dragon's controller controls —\n108\t        the same metric the dragon applies to itself (``cost_reduction``) and\n109\t        grants to the controller's instants/sorceries. Returns 0 when there\n110\t        is no controller.\n111\t        \"\"\"\n112\t        controller = getattr(self, \"controller\", None)\n113\t        if controller is None:\n114\t            return 0\n115\t        battlefield = game.get_battlefield(controller)\n116\t        count = 0\n117\t        for obj in battlefield.get_all():\n118\t            if CardType.CREATURE in getattr(obj, \"card_types\", set()):\n119\t                count += 1\n120\t        return count\n121\t"}]},"parent_tool_use_id":"toolu_01FhNfUVJpcxNHXwXyrc99xQ","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"efdf3e2b-5bcb-4665-b635-7a56a0209934","timestamp":"2026-06-02T01:57:07.920Z","subagent_type":"Reviewer","task_description":"Review sos_245 implementation"}
