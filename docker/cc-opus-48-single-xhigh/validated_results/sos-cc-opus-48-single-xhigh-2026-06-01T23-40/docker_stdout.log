{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q7WjND8RSodMj58RLSD332","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_201/card_impl.py b/cards/sos/sos_201/card_impl.py\n2\tindex 7b52d28..32f8c16 100644\n3\t--- a/cards/sos/sos_201/card_impl.py\n4\t+++ b/cards/sos/sos_201/card_impl.py\n5\t@@ -1,16 +1,155 @@\n6\t-\"\"\"Card implementation for Lorehold, the Historian.\"\"\"\n7\t+\"\"\"Card implementation for Lorehold, the Historian (SOS 201).\n8\t+\n9\t+Lorehold, the Historian is a ``{3}{R}{W}`` Legendary Creature — Elder Dragon,\n10\t+5/5, with flying and haste. It grants miracle ``{2}`` to instant and sorcery\n11\t+cards in its controller's hand, and at the beginning of each opponent's upkeep\n12\t+its controller may rummage (discard a card; if they do, draw a card).\n13\t+\n14\t+Miracle (CR 702.94) has no native engine pipeline. The granting is exposed\n15\t+through two surfaces:\n16\t+\n17\t+* ``MIRACLE_COST`` / ``grant_miracle`` — the observable static-ability portion:\n18\t+  stamp ``miracle_cost`` onto eligible hand cards (used by the existing tests).\n19\t+* ``grants_miracle_to`` — the capability the additive draw-time miracle pipeline\n20\t+  in :mod:`engine.game` / :mod:`engine.casting` queries when a card is drawn.\n21\t+\"\"\"\n22\t \n23\t from __future__ import annotations\n24\t \n25\t-from engine.card import CardImpl\n26\t+from typing import TYPE_CHECKING, Any\n27\t \n28\t-from typing import TYPE_CHECKING\n29\t+from engine.card import Creature\n30\t+from engine.types import CardType, Keyword, ManaCost, Supertype\n31\t \n32\t if TYPE_CHECKING:\n33\t     from engine.game_state import GameState\n34\t \n35\t \n36\t-class LoreholdTheHistorian(CardImpl):\n37\t-    \"\"\"TODO: Implement Lorehold, the Historian.\"\"\"\n38\t+class LoreholdTheHistorian(Creature):\n39\t+    \"\"\"Lorehold, the Historian — {3}{R}{W} — 5/5 — Legendary Elder Dragon.\n40\t+\n41\t+    Flying, haste.\n42\t+    Each instant and sorcery card in your hand has miracle {2}.\n43\t+    At the beginning of each opponent's upkeep, you may discard a card. If you\n44\t+    do, draw a card.\n45\t+\n46\t+    SOS collector number 201.\n47\t+    \"\"\"\n48\t+\n49\t+    # The granted alternative (miracle) cost is {2} generic. Exposed as a\n50\t+    # class constant so the static-ability contract and the draw-time pipeline\n51\t+    # share a single source of truth.\n52\t+    MIRACLE_COST: ManaCost = ManaCost.parse(\"{2}\")\n53\t+\n54\t+    def __init__(self, **kwargs: Any) -> None:\n55\t+        kwargs.setdefault(\"name\", \"Lorehold, the Historian\")\n56\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{3}{R}{W}\"))\n57\t+        kwargs.setdefault(\"subtypes\", {\"Elder\", \"Dragon\"})\n58\t+        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n59\t+        kwargs.setdefault(\"keywords\", Keyword.FLYING | Keyword.HASTE)\n60\t+        kwargs.setdefault(\"base_power\", 5)\n61\t+        kwargs.setdefault(\"base_toughness\", 5)\n62\t+        kwargs.setdefault(\n63\t+            \"rules_text\",\n64\t+            \"Flying, haste\\n\"\n65\t+            \"Each instant and sorcery card in your hand has miracle {2}. \"\n66\t+            \"(You may cast a card for its miracle cost when you draw it if \"\n67\t+            \"it's the first card you drew this turn.)\\n\"\n68\t+            \"At the beginning of each opponent's upkeep, you may discard a \"\n69\t+            \"card. If you do, draw a card.\",\n70\t+        )\n71\t+        super().__init__(**kwargs)\n72\t+        # Explicit color identity (KEY_DECISIONS sos_13 convention).\n73\t+        self.colors: list[str] = [\"R\", \"W\"]\n74\t+\n75\t+    # ------------------------------------------------------------------\n76\t+    # Miracle granting\n77\t+    # ------------------------------------------------------------------\n78\t+\n79\t+    def grants_miracle_to(self, card: Any) -> ManaCost | None:\n80\t+        \"\"\"Return the miracle cost this permanent grants *card*, else ``None``.\n81\t+\n82\t+        Lorehold grants miracle ``{2}`` to every instant and sorcery card; any\n83\t+        other card type (creature, land, etc.) gets nothing. This is the\n84\t+        capability the additive draw-time miracle pipeline queries on permanents\n85\t+        the drawing player controls.\n86\t+        \"\"\"\n87\t+        card_types = getattr(card, \"card_types\", set())\n88\t+        if CardType.INSTANT in card_types or CardType.SORCERY in card_types:\n89\t+            return self.MIRACLE_COST\n90\t+        return None\n91\t+\n92\t+    def grant_miracle(self, game: \"GameState\") -> None:\n93\t+        \"\"\"Stamp ``miracle_cost`` onto eligible cards in the controller's hand.\n94\t+\n95\t+        \"Each instant and sorcery card in *your* hand has miracle {2}.\" Marks\n96\t+        every instant/sorcery card in this card's controller's hand with the\n97\t+        granted alternative cost; non-cast types and other players' hands are\n98\t+        left untouched.\n99\t+        \"\"\"\n100\t+        controller = getattr(self, \"controller\", None)\n101\t+        if controller is None:\n102\t+            return\n103\t+        hand = game.get_hand(controller)\n104\t+        for card in hand.get_all():\n105\t+            cost = self.grants_miracle_to(card)\n106\t+            if cost is not None:\n107\t+                card.miracle_cost = cost  # type: ignore[attr-defined]\n108\t+\n109\t+    # ------------------------------------------------------------------\n110\t+    # Opponent's-upkeep rummage trigger\n111\t+    # ------------------------------------------------------------------\n112\t+\n113\t+    def register_triggers(self, game: \"GameState\") -> None:\n114\t+        \"\"\"Register the beginning-of-each-opponent's-upkeep rummage trigger.\"\"\"\n115\t+        from engine.events import BeginningOfUpkeepTriggeredEvent\n116\t+        from engine.triggers import TriggerRegistration\n117\t+\n118\t+        source = self\n119\t+        controller = getattr(self, \"controller\", None) or game.active_player\n120\t+\n121\t+        def _condition(game: \"GameState\", event: Any) -> bool:\n122\t+            # \"each opponent's upkeep\" — fire only when the active player (whose\n123\t+            # upkeep is beginning) is NOT this card's controller. The event\n124\t+            # carries no player, so read the game's active player.\n125\t+            return game.active_player is not source.controller\n126\t+\n127\t+        def _effect(game: \"GameState\") -> None:\n128\t+            from engine.game import draw_card\n129\t+\n130\t+            ctrl = getattr(source, \"controller\", None)\n131\t+            if ctrl is None:\n132\t+                return\n133\t+\n134\t+            # \"you may discard a card.\"\n135\t+            if not ctrl.choose_yes_no(\"Discard a card to draw a card?\"):\n136\t+                return\n137\t+\n138\t+            hand = game.get_hand(ctrl)\n139\t+            hand_cards = hand.get_all()\n140\t+            if not hand_cards:\n141\t+                # Nothing to discard — \"if you do\" fails, so no draw. Safe no-op.\n142\t+                return\n143\t+\n144\t+            chosen = ctrl.choose_card(hand_cards, \"Choose a card to discard\")\n145\t+            if chosen is None or not hand.contains(chosen):\n146\t+                return\n147\t+\n148\t+            # Discard the chosen card to the graveyard.\n149\t+            from engine.types import Zone\n150\t+            from engine.zones import move_to_zone\n151\t+\n152\t+            move_to_zone(game, chosen, Zone.HAND, Zone.GRAVEYARD)\n153\t+\n154\t+            # \"If you do, draw a card.\"\n155\t+            draw_card(game, ctrl)\n156\t \n157\t-    pass\n158\t+        game.trigger_manager.register(\n159\t+            TriggerRegistration(\n160\t+                event_type=BeginningOfUpkeepTriggeredEvent,\n161\t+                condition=_condition,\n162\t+                effect=_effect,\n163\t+                source=self,\n164\t+                controller=controller,\n165\t+            )\n166\t+        )\n167\tdiff --git a/engine/casting.py b/engine/casting.py\n168\tindex 2ea1f34..e28481d 100644\n169\t--- a/engine/casting.py\n170\t+++ b/engine/casting.py\n171\t@@ -123,7 +123,12 @@ def _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n172\t # Cast spell\n173\t # ------------------------------------------------------------------\n174\t \n175\t-def cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n176\t+def cast_spell(\n177\t+    game: GameState,\n178\t+    player: Player,\n179\t+    card: CardImpl,\n180\t+    alternative_cost: ManaCost | None = None,\n181\t+) -> None:\n182\t     \"\"\"Cast *card* from *player*'s hand.\n183\t \n184\t     Pipeline\n185\t@@ -144,11 +149,27 @@ def cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n186\t     8. **Push StackObject** — push a :class:`StackObject` whose\n187\t        ``on_resolve`` callback handles resolution.\n188\t \n189\t+    Parameters:\n190\t+        alternative_cost: When provided, the spell is cast paying this\n191\t+            :class:`~engine.types.ManaCost` *instead of* ``card.mana_cost``\n192\t+            (an alternative cost such as miracle, CR 118.9). Cost reduction\n193\t+            is not applied to an alternative cost. ``card.mana_spent`` is set\n194\t+            to the alternative cost's converted mana cost. Defaults to\n195\t+            ``None`` — the existing behaviour (pay the printed mana cost) is\n196\t+            byte-for-byte unchanged.\n197\t+\n198\t     Raises:\n199\t         CastingError: If any legality check fails.\n200\t     \"\"\"\n201\t     # 1. Timing\n202\t-    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n203\t+    # Alternative costs such as miracle (CR 702.94 / 118.9) explicitly permit\n204\t+    # casting the spell when it is drawn, regardless of the normal timing\n205\t+    # restriction; bypass the sorcery-speed check in that case.\n206\t+    if (\n207\t+        alternative_cost is None\n208\t+        and not can_cast_at_instant_speed(card)\n209\t+        and not is_sorcery_speed(game, player)\n210\t+    ):\n211\t         raise CastingError(\n212\t             f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n213\t         )\n214\t@@ -215,8 +236,13 @@ def cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n215\t     # explicit controller assignment.\n216\t     if card.controller is None:\n217\t         card.controller = player\n218\t-    reduction = get_cost_reduction(game, card, player)\n219\t-    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n220\t+    if alternative_cost is not None:\n221\t+        # Alternative costs (e.g. miracle, CR 118.9) replace the printed mana\n222\t+        # cost wholesale and are not subject to generic cost reduction.\n223\t+        effective_cost = alternative_cost\n224\t+    else:\n225\t+        reduction = get_cost_reduction(game, card, player)\n226\t+        effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n227\t \n228\t     if not player.mana_pool.can_pay(effective_cost):\n229\t         # Rollback: move card from stack zone back to hand\n230\tdiff --git a/engine/game.py b/engine/game.py\n231\tindex 72b8fb4..4a92ab4 100644\n232\t--- a/engine/game.py\n233\t+++ b/engine/game.py\n234\t@@ -332,9 +332,72 @@ def draw_card(game: GameState, player: Player) -> Any | None:\n235\t             DrawsCardTriggeredEvent(player=player, card=card),\n236\t         )\n237\t \n238\t+    # Draw-time miracle window (CR 702.94). This is a COMPLETE no-op unless the\n239\t+    # drawn card is this player's FIRST card this turn AND a permanent they\n240\t+    # control grants the card a miracle (alternative) cost. Only then is the\n241\t+    # controller offered the immediate cast. Keeping the hook fully gated means\n242\t+    # ordinary draws (where nothing grants miracle) see zero behavioural change.\n243\t+    _offer_miracle(game, player, card)\n244\t+\n245\t     return card\n246\t \n247\t \n248\t+def _offer_miracle(game: GameState, player: Player, card: Any) -> None:\n249\t+    \"\"\"Offer to cast *card* for a granted miracle cost at draw time.\n250\t+\n251\t+    Gated so it does nothing unless BOTH hold:\n252\t+\n253\t+    * ``card`` is *player*'s first card drawn this turn\n254\t+      (``player.cards_drawn_this_turn == 1``), and\n255\t+    * a permanent *player* controls advertises a ``grants_miracle_to(card)``\n256\t+      capability returning a non-``None`` :class:`~engine.types.ManaCost`.\n257\t+\n258\t+    When both hold, ``card.miracle_cost`` is stamped and the player is asked\n259\t+    (via ``choose_yes_no``) whether to cast it for the miracle cost. On yes,\n260\t+    the card is cast from hand via the alternative-cost casting surface.\n261\t+\n262\t+    The miracle \"window\" is modelled as an immediate at-draw offer rather than\n263\t+    the full reveal → triggered ability → cast-before-next-step sequence; this\n264\t+    is deterministic and sufficient for the engine.\n265\t+    \"\"\"\n266\t+    # (a) First card drawn this turn.\n267\t+    if getattr(player, \"cards_drawn_this_turn\", 0) != 1:\n268\t+        return\n269\t+\n270\t+    # (b) A controlled permanent grants miracle to this card.\n271\t+    miracle_cost = None\n272\t+    battlefield = player.zones[Zone.BATTLEFIELD]\n273\t+    for permanent in battlefield.get_all():\n274\t+        grant = getattr(permanent, \"grants_miracle_to\", None)\n275\t+        if grant is None:\n276\t+            continue\n277\t+        cost = grant(card)\n278\t+        if cost is not None:\n279\t+            miracle_cost = cost\n280\t+            break\n281\t+\n282\t+    if miracle_cost is None:\n283\t+        return\n284\t+\n285\t+    # Stamp the granted miracle cost so it is observable on the card.\n286\t+    card.miracle_cost = miracle_cost  # type: ignore[attr-defined]\n287\t+\n288\t+    # \"You may cast it for its miracle cost.\" Offer the controller the choice.\n289\t+    if not player.choose_yes_no(\n290\t+        f\"Cast {getattr(card, 'name', 'this card')!r} for its miracle cost?\"\n291\t+    ):\n292\t+        return\n293\t+\n294\t+    from engine.casting import CastingError, cast_spell\n295\t+\n296\t+    try:\n297\t+        cast_spell(game, player, card, alternative_cost=miracle_cost)\n298\t+    except CastingError:\n299\t+        # Could not pay / cast (e.g. insufficient mana) — leave the card in\n300\t+        # hand, no state change beyond the stamped miracle_cost.\n301\t+        return\n302\t+\n303\t+\n304\t def discard(game: GameState, player: Player, card: Any) -> None:\n305\t     \"\"\"Discard *card* from *player*'s hand to the owner's graveyard.\n306\t \n307\tdiff --git a/engine/player.py b/engine/player.py\n308\tindex 4b1d527..156625e 100644\n309\t--- a/engine/player.py\n310\t+++ b/engine/player.py\n311\t@@ -35,6 +35,12 @@ class Player(ABC):\n312\t         self.has_lost: bool = False\n313\t         self.land_plays_remaining: int = 1\n314\t         self.drawn_from_empty_library: bool = False\n315\t+        # Number of cards this player has drawn during the current turn. Reset\n316\t+        # to 0 at the start of every turn (untap step) and incremented by\n317\t+        # ``engine.game.draw_card``. Used by the draw-time miracle window to\n318\t+        # detect \"the first card you drew this turn\" (CR 702.94). Additive;\n319\t+        # defaults to 0.\n320\t+        self.cards_drawn_this_turn: int = 0\n321\t         # Number of this player's upcoming turns to skip (CR 614.10). When a\n322\t         # turn would begin for a player with ``skipped_turns > 0``, the turn\n323\t         # rotation (``GameState.advance_phase``) skips it and decrements this\n324\tdiff --git a/engine/turn.py b/engine/turn.py\n325\tindex 3172567..fa6c47b 100644\n326\t--- a/engine/turn.py\n327\t+++ b/engine/turn.py\n328\t@@ -41,6 +41,12 @@ def _do_untap_step(game: GameState) -> None:\n329\t     # Reset land plays for the active player\n330\t     active.land_plays_remaining = 1\n331\t \n332\t+    # Reset the per-turn draw counter for ALL players so that \"the first card\n333\t+    # you drew this turn\" (used by the draw-time miracle window) is evaluated\n334\t+    # once per turn, regardless of whose turn it is. Additive; defaults to 0.\n335\t+    for p in game.players:\n336\t+        p.cards_drawn_this_turn = 0\n337\t+\n338\t \n339\t def _do_draw_step(game: GameState) -> None:\n340\t     \"\"\"Perform draw step actions: active player draws a card.\n341\t"}]},"parent_tool_use_id":"toolu_01CQVE79ZRFUJsgcJV9oB18J","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"b24b54dc-5d13-4d21-a554-2d946b95eac3","timestamp":"2026-06-02T01:30:01.939Z","subagent_type":"Reviewer","task_description":"Review sos_201 implementation"}
