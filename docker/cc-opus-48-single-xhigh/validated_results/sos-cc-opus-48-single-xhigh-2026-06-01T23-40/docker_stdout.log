{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NWwKsYZTKXcekCA7y4X53h","type":"tool_result","content":"1\t\"\"\"Tests for SOS 13 — Emeritus of Truce // Swords to Plowshares.\n2\t\n3\tThis is a *preparation card* (rule 722): a two-part card whose front face is\n4\tthe creature **Emeritus of Truce** ({1}{W}{W}, 3/3 Cat Cleric) and whose inset\n5\t\"prepare spell\" is **Swords to Plowshares** ({W} instant — exile a creature,\n6\tits controller gains life equal to its power).\n7\t\n8\tFront-face oracle text:\n9\t    \"When this creature enters, target player creates a 1/1 white and black\n10\t     Inkling creature token with flying. Then if an opponent controls more\n11\t     creatures than you, this creature becomes prepared.\"\n12\t\n13\tThe engine has no native \"Prepared\" designation or preparation-card frame, so\n14\tthe implementation has latitude on *how* it represents the prepared state and\n15\tthe prepare spell.  These tests therefore probe *observable behaviour*:\n16\t\n17\t  * the creature's printed characteristics,\n18\t  * the ETB token (a 1/1 white-and-black Inkling with flying) appearing under\n19\t    the chosen target player's control,\n20\t  * the conditional \"becomes prepared\" designation based on the\n21\t    opponent-controls-more-creatures comparison,\n22\t  * the prepare spell exiling a creature and granting its controller life.\n23\t\n24\tWhere a clause cannot be asserted against the current engine surface, it is\n25\trecorded in ``untestable.json`` instead of being silently skipped.\n26\t\"\"\"\n27\t\n28\tfrom __future__ import annotations\n29\t\n30\tfrom typing import Any\n31\t\n32\timport pytest\n33\t\n34\tfrom cards.sos.sos_13.card_impl import EmeritusOfTruceSwordsToPlowshares\n35\tfrom engine.card import Creature\n36\tfrom engine.types import CardType, Keyword, ManaCost, Zone\n37\tfrom test_utils import create_game\n38\t\n39\t\n40\t# ---------------------------------------------------------------------------\n41\t# Helpers\n42\t# ---------------------------------------------------------------------------\n43\t\n44\t\n45\tdef _make_card(game: Any, controller_index: int = 0) -> EmeritusOfTruceSwordsToPlowshares:\n46\t    \"\"\"Build the card owned/controlled by the given player and return it.\"\"\"\n47\t    player = game.players[controller_index]\n48\t    card = EmeritusOfTruceSwordsToPlowshares(owner=player, controller=player)\n49\t    return card\n50\t\n51\t\n52\tdef _battlefield_creatures(game: Any, player: Any) -> list[Any]:\n53\t    \"\"\"Return Creature objects on *player*'s battlefield.\"\"\"\n54\t    return [\n55\t        obj\n56\t        for obj in game.get_battlefield(player).get_all()\n57\t        if isinstance(obj, Creature)\n58\t    ]\n59\t\n60\t\n61\tdef _inkling_tokens(game: Any, player: Any) -> list[Any]:\n62\t    \"\"\"Return token creatures named 'Inkling' on *player*'s battlefield.\"\"\"\n63\t    out = []\n64\t    for obj in _battlefield_creatures(game, player):\n65\t        name = getattr(obj, \"name\", \"\")\n66\t        subtypes = getattr(obj, \"subtypes\", set())\n67\t        if \"Inkling\" in name or \"Inkling\" in subtypes:\n68\t            out.append(obj)\n69\t    return out\n70\t\n71\t\n72\tdef _fire_etb(game: Any, card: Any, target_player: Any) -> None:\n73\t    \"\"\"Resolve the card's enter-the-battlefield effect.\n74\t\n75\t    The card is placed on its controller's battlefield first (so SBA / zone\n76\t    checks see it), then its ETB is driven through whichever surface the\n77\t    implementation exposes.  ``chosen_targets`` is set to the target player,\n78\t    matching the engine's resolve-time contract for targeted effects.\n79\t    \"\"\"\n80\t    controller = card.controller\n81\t    game.get_battlefield(controller).add(card)\n82\t    card.chosen_targets = [target_player]\n83\t\n84\t    # Preferred path: register the ETB trigger, then fire the ETB event and\n85\t    # resolve the resulting stack object.\n86\t    from engine.events import EntersBattlefieldTriggeredEvent\n87\t\n88\t    if hasattr(card, \"register_triggers\"):\n89\t        card.register_triggers(game)\n90\t    fired = False\n91\t    try:\n92\t        game.trigger_manager.fire_event(\n93\t            game,\n94\t            EntersBattlefieldTriggeredEvent(\n95\t                permanent=card, controller=controller, creature=card\n96\t            ),\n97\t        )\n98\t    except Exception:\n99\t        fired = False\n100\t    else:\n101\t        fired = not game.stack.is_empty()\n102\t\n103\t    if fired:\n104\t        # Resolve all triggered abilities on the stack.\n105\t        while not game.stack.is_empty():\n106\t            obj = game.stack.pop()\n107\t            # Make the target player available to the resolving ability.\n108\t            if hasattr(obj, \"targets\") and not getattr(obj, \"targets\", None):\n109\t                obj.targets = [target_player]\n110\t            card.chosen_targets = [target_player]\n111\t            obj.on_resolve(game)\n112\t        return\n113\t\n114\t    # Fallback path: the implementation may expose the ETB as on_resolve.\n115\t    card.chosen_targets = [target_player]\n116\t    card.on_resolve(game)\n117\t\n118\t\n119\t# ---------------------------------------------------------------------------\n120\t# Static characteristics of the front face (Emeritus of Truce)\n121\t# ---------------------------------------------------------------------------\n122\t\n123\t\n124\tclass TestEmeritusProperties:\n125\t    \"\"\"The front face is a 3/3 white Cat Cleric costing {1}{W}{W}.\"\"\"\n126\t\n127\t    def test_is_creature(self) -> None:\n128\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n129\t        assert isinstance(card, Creature)\n130\t        assert CardType.CREATURE in card.card_types\n131\t\n132\t    def test_name(self) -> None:\n133\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n134\t        assert card.name == \"Emeritus of Truce // Swords to Plowshares\"\n135\t\n136\t    def test_mana_cost(self) -> None:\n137\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n138\t        assert card.mana_cost == ManaCost.parse(\"{1}{W}{W}\")\n139\t\n140\t    def test_power_toughness(self) -> None:\n141\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n142\t        assert card.base_power == 3\n143\t        assert card.base_toughness == 3\n144\t\n145\t    def test_creature_subtypes(self) -> None:\n146\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n147\t        assert {\"Cat\", \"Cleric\"} <= card.subtypes\n148\t\n149\t    def test_is_white(self) -> None:\n150\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n151\t        assert \"W\" in getattr(card, \"colors\", [])\n152\t\n153\t\n154\t# ---------------------------------------------------------------------------\n155\t# ETB trigger registration\n156\t# ---------------------------------------------------------------------------\n157\t\n158\t\n159\tclass TestEmeritusEtbRegistration:\n160\t    \"\"\"The creature registers an enters-the-battlefield triggered ability.\"\"\"\n161\t\n162\t    def test_register_triggers_adds_etb(self) -> None:\n163\t        from engine.events import EntersBattlefieldTriggeredEvent\n164\t\n165\t        game = create_game()\n166\t        p1 = game.players[0]\n167\t        card = _make_card(game, 0)\n168\t        game.get_battlefield(p1).add(card)\n169\t        before = len(game.trigger_manager.get_triggers_for_source(card))\n170\t        card.register_triggers(game)\n171\t        after = game.trigger_manager.get_triggers_for_source(card)\n172\t        assert len(after) - before == 1\n173\t        assert after[-1].event_type is EntersBattlefieldTriggeredEvent\n174\t\n175\t\n176\t# ---------------------------------------------------------------------------\n177\t# ETB effect — token creation for the target player\n178\t# ---------------------------------------------------------------------------\n179\t\n180\t\n181\tclass TestEmeritusTokenCreation:\n182\t    \"\"\"ETB: target player creates a 1/1 white-and-black Inkling with flying.\"\"\"\n183\t\n184\t    def test_target_player_gets_one_token(self) -> None:\n185\t        game = create_game()\n186\t        p1, p2 = game.players\n187\t        card = _make_card(game, 0)\n188\t        before = len(_inkling_tokens(game, p2))\n189\t        _fire_etb(game, card, target_player=p2)\n190\t        after = len(_inkling_tokens(game, p2))\n191\t        assert after - before == 1\n192\t\n193\t    def test_token_goes_to_chosen_player_not_caster(self) -> None:\n194\t        \"\"\"When the controller targets the opponent, the caster gets no token.\"\"\"\n195\t        game = create_game()\n196\t        p1, p2 = game.players\n197\t        card = _make_card(game, 0)\n198\t        _fire_etb(game, card, target_player=p2)\n199\t        # The opponent received exactly the Inkling token; the caster got none.\n200\t        assert len(_inkling_tokens(game, p2)) == 1\n201\t        assert len(_inkling_tokens(game, p1)) == 0\n202\t\n203\t    def test_controller_may_target_self(self) -> None:\n204\t        \"\"\"The controller is a legal 'target player' and may receive the token.\"\"\"\n205\t        game = create_game()\n206\t        p1, _ = game.players\n207\t        card = _make_card(game, 0)\n208\t        _fire_etb(game, card, target_player=p1)\n209\t        assert len(_inkling_tokens(game, p1)) == 1\n210\t\n211\t    def test_token_is_one_one(self) -> None:\n212\t        game = create_game()\n213\t        p1, p2 = game.players\n214\t        card = _make_card(game, 0)\n215\t        _fire_etb(game, card, target_player=p2)\n216\t        tokens = _inkling_tokens(game, p2)\n217\t        assert len(tokens) == 1\n218\t        tok = tokens[0]\n219\t        assert tok.base_power == 1\n220\t        assert tok.base_toughness == 1\n221\t\n222\t    def test_token_has_flying(self) -> None:\n223\t        game = create_game()\n224\t        p1, p2 = game.players\n225\t        card = _make_card(game, 0)\n226\t        _fire_etb(game, card, target_player=p2)\n227\t        tok = _inkling_tokens(game, p2)[0]\n228\t        assert Keyword.FLYING in getattr(tok, \"keywords\", Keyword(0))\n229\t\n230\t    def test_token_is_white_and_black(self) -> None:\n231\t        game = create_game()\n232\t        p1, p2 = game.players\n233\t        card = _make_card(game, 0)\n234\t        _fire_etb(game, card, target_player=p2)\n235\t        tok = _inkling_tokens(game, p2)[0]\n236\t        colors = set(getattr(tok, \"colors\", []))\n237\t        assert \"W\" in colors\n238\t        assert \"B\" in colors\n239\t\n240\t    def test_token_is_an_inkling(self) -> None:\n241\t        game = create_game()\n242\t        p1, p2 = game.players\n243\t        card = _make_card(game, 0)\n244\t        _fire_etb(game, card, target_player=p2)\n245\t        tok = _inkling_tokens(game, p2)[0]\n246\t        assert \"Inkling\" in getattr(tok, \"subtypes\", set())\n247\t\n248\t    def test_token_is_marked_as_token(self) -> None:\n249\t        game = create_game()\n250\t        p1, p2 = game.players\n251\t        card = _make_card(game, 0)\n252\t        _fire_etb(game, card, target_player=p2)\n253\t        tok = _inkling_tokens(game, p2)[0]\n254\t        assert getattr(tok, \"is_token\", False) is True\n255\t\n256\t\n257\t# ---------------------------------------------------------------------------\n258\t# ETB second clause — \"becomes prepared\" conditional\n259\t# ---------------------------------------------------------------------------\n260\t\n261\t\n262\tclass TestEmeritusBecomesPrepared:\n263\t    \"\"\"\"Then if an opponent controls more creatures than you, this creature\n264\t    becomes prepared.\" — comparison is creature counts on the battlefield.\"\"\"\n265\t\n266\t    @staticmethod\n267\t    def _is_prepared(card: Any) -> bool:\n268\t        \"\"\"Best-effort read of the 'prepared' designation.\"\"\"\n269\t        return bool(getattr(card, \"prepared\", False) or getattr(card, \"is_prepared\", False))\n270\t\n271\t    def _bears(self, n: int) -> list[Creature]:\n272\t        return [\n273\t            Creature(name=f\"Bear{i}\", base_power=2, base_toughness=2)\n274\t            for i in range(n)\n275\t        ]\n276\t\n277\t    def test_prepared_when_opponent_has_more_creatures(self) -> None:\n278\t        game = create_game()\n279\t        p1, p2 = game.players\n280\t        card = _make_card(game, 0)\n281\t        # STANDARD MTG counting: the entering Emeritus counts toward its\n282\t        # controller, and the Inkling token counts for whoever controls it.\n283\t        # Target the token to the CONTROLLER (p1) so it counts toward \"you\":\n284\t        # controller ends with Emeritus + token = 2, opponent has 3 bears = 3.\n285\t        # 3 > 2 -> opponent strictly more -> prepared.\n286\t        for b in self._bears(3):\n287\t            b.owner = p2\n288\t            b.controller = p2\n289\t            game.get_battlefield(p2).add(b)\n290\t        _fire_etb(game, card, target_player=p1)\n291\t        # The token was created before the comparison and went to the\n292\t        # controller (counts toward \"you\"); the opponent still has strictly\n293\t        # more creatures, so the creature becomes prepared.\n294\t        assert len(_inkling_tokens(game, p1)) == 1\n295\t        assert self._is_prepared(card) is True\n296\t\n297\t    def test_not_prepared_when_counts_equal(self) -> None:\n298\t        \"\"\"Strictly 'more than' — equal creature counts must NOT prepare it.\"\"\"\n299\t        game = create_game()\n300\t        p1, p2 = game.players\n301\t        card = _make_card(game, 0)\n302\t        # After ETB the controller has Emeritus (1). Give opponent exactly 1 so\n303\t        # that, counting Emeritus, neither side has *more* than the other.\n304\t        b = self._bears(1)[0]\n305\t        b.owner = p2\n306\t        b.controller = p2\n307\t        game.get_battlefield(p2).add(b)\n308\t        # Target self so the token does not change the opponent's count.\n309\t        _fire_etb(game, card, target_player=p1)\n310\t        # The ETB must still have created the token (guards against a no-op\n311\t        # implementation trivially \"passing\" this negative assertion).\n312\t        assert len(_inkling_tokens(game, p1)) == 1\n313\t        assert self._is_prepared(card) is False\n314\t\n315\t    def test_not_prepared_when_controller_has_more(self) -> None:\n316\t        game = create_game()\n317\t        p1, p2 = game.players\n318\t        card = _make_card(game, 0)\n319\t        # Controller has extra creatures; opponent has none.\n320\t        for b in self._bears(2):\n321\t            b.owner = p1\n322\t            b.controller = p1\n323\t            game.get_battlefield(p1).add(b)\n324\t        _fire_etb(game, card, target_player=p1)\n325\t        # The ETB must still have created the token (guards against a no-op\n326\t        # implementation trivially \"passing\" this negative assertion).\n327\t        assert len(_inkling_tokens(game, p1)) == 1\n328\t        assert self._is_prepared(card) is False\n329\t\n330\t    def test_token_under_opponent_can_flip_the_comparison(self) -> None:\n331\t        \"\"\"The token is created *before* the comparison; if it goes to the\n332\t        opponent it counts toward the opponent's creature total.\"\"\"\n333\t        game = create_game()\n334\t        p1, p2 = game.players\n335\t        card = _make_card(game, 0)\n336\t        # Opponent starts with 1 creature; controller has only Emeritus (1).\n337\t        b = self._bears(1)[0]\n338\t        b.owner = p2\n339\t        b.controller = p2\n340\t        game.get_battlefield(p2).add(b)\n341\t        # Token goes to the opponent -> opponent ends with 2, controller with 1.\n342\t        _fire_etb(game, card, target_player=p2)\n343\t        assert self._is_prepared(card) is True\n344\t\n345\t\n346\t# ---------------------------------------------------------------------------\n347\t# Prepare spell — Swords to Plowshares\n348\t# ---------------------------------------------------------------------------\n349\t\n350\t\n351\tclass TestSwordsToPlowshares:\n352\t    \"\"\"The inset prepare spell exiles a creature; its controller gains life\n353\t    equal to that creature's power.\"\"\"\n354\t\n355\t    @staticmethod\n356\t    def _make_prepare_spell(game: Any, controller: Any) -> Any:\n357\t        \"\"\"Obtain a castable copy of the Swords to Plowshares prepare spell.\n358\t\n359\t        The card exposes a stable ``make_prepare_spell(game)`` factory (see the\n360\t        coordinator directives / card_impl docstring), so this is now a HARD\n361\t        contract: the factory must exist, be callable, and return a spell\n362\t        object.  No skip path.\n363\t        \"\"\"\n364\t        card = EmeritusOfTruceSwordsToPlowshares(owner=controller, controller=controller)\n365\t        factory = getattr(card, \"make_prepare_spell\", None)\n366\t        assert callable(factory), (\n367\t            \"Card must expose a callable make_prepare_spell(game) factory \"\n368\t            \"for the inset Swords to Plowshares prepare spell.\"\n369\t        )\n370\t        spell = factory(game)\n371\t        assert spell is not None, \"make_prepare_spell(game) must return a spell object.\"\n372\t        spell.owner = controller\n373\t        spell.controller = controller\n374\t        return spell\n375\t\n376\t    def test_exiles_target_creature(self) -> None:\n377\t        game = create_game()\n378\t        p1, p2 = game.players\n379\t        spell = self._make_prepare_spell(game, p1)\n380\t        victim = Creature(\n381\t            name=\"Doomed Bear\", owner=p2, controller=p2, base_power=2, base_toughness=2\n382\t        )\n383\t        game.get_battlefield(p2).add(victim)\n384\t        spell.chosen_targets = [victim]\n385\t        spell.on_resolve(game)\n386\t        assert not game.get_battlefield(p2).contains(victim)\n387\t        assert p2.zones[Zone.EXILE].contains(victim)\n388\t\n389\t    def test_controller_gains_life_equal_to_power(self) -> None:\n390\t        game = create_game()\n391\t        p1, p2 = game.players\n392\t        spell = self._make_prepare_spell(game, p1)\n393\t        victim = Creature(\n394\t            name=\"Big Beast\", owner=p2, controller=p2, base_power=5, base_toughness=5\n395\t        )\n396\t        game.get_battlefield(p2).add(victim)\n397\t        before = p2.life\n398\t        spell.chosen_targets = [victim]\n399\t        spell.on_resolve(game)\n400\t        # The exiled creature's CONTROLLER (p2), not the caster, gains the life.\n401\t        assert p2.life == before + 5\n402\t\n403\t    def test_caster_does_not_gain_life_for_opponents_creature(self) -> None:\n404\t        game = create_game()\n405\t        p1, p2 = game.players\n406\t        spell = self._make_prepare_spell(game, p1)\n407\t        victim = Creature(\n408\t            name=\"Big Beast\", owner=p2, controller=p2, base_power=4, base_toughness=4\n409\t        )\n410\t        game.get_battlefield(p2).add(victim)\n411\t        before_caster = p1.life\n412\t        spell.chosen_targets = [victim]\n413\t        spell.on_resolve(game)\n414\t        assert p1.life == before_caster\n415\t\n416\t    def test_no_target_is_a_noop(self) -> None:\n417\t        game = create_game()\n418\t        p1, _ = game.players\n419\t        spell = self._make_prepare_spell(game, p1)\n420\t        # No chosen_targets set — resolution must not raise or change life.\n421\t        before = p1.life\n422\t        spell.on_resolve(game)\n423\t        assert p1.life == before\n424\t\n425\t\n426\t# ---------------------------------------------------------------------------\n427\t# Casting the prepare spell while prepared — unprepare transition (CR 722.3c)\n428\t# ---------------------------------------------------------------------------\n429\t\n430\t\n431\tclass TestCastPrepareSpellUnprepares:\n432\t    \"\"\"\"While it's prepared, you may cast a copy of its spell. Doing so\n433\t    unprepares it.\" (CR 722.3c)\n434\t\n435\t    The card exposes ``cast_prepare_spell(game, target=...)`` which (a) requires\n436\t    the creature to be prepared, (b) free-casts/resolves a copy of Swords to\n437\t    Plowshares against the target, and (c) clears the prepared designation.\n438\t    \"\"\"\n439\t\n440\t    def test_cast_while_prepared_exiles_grants_life_and_unprepares(self) -> None:\n441\t        game = create_game()\n442\t        p1, p2 = game.players\n443\t        card = _make_card(game, 0)\n444\t        game.get_battlefield(p1).add(card)\n445\t        # Prepare the creature directly (the becomes-prepared path is covered\n446\t        # elsewhere; here we exercise the cast/unprepare transition in isolation).\n447\t        card.prepared = True\n448\t\n449\t        victim = Creature(\n450\t            name=\"Plowed Beast\", owner=p2, controller=p2, base_power=3, base_toughness=3\n451\t        )\n452\t        game.get_battlefield(p2).add(victim)\n453\t        before = p2.life\n454\t\n455\t        card.cast_prepare_spell(game, target=victim)\n456\t\n457\t        # (a) The target creature is exiled and ITS controller (p2) gains life\n458\t        #     equal to its power.\n459\t        assert not game.get_battlefield(p2).contains(victim)\n460\t        assert p2.zones[Zone.EXILE].contains(victim)\n461\t        assert p2.life == before + 3\n462\t        # (b) Casting the prepare spell unprepares the permanent (CR 722.3c).\n463\t        assert card.prepared is False\n464\t\n465\t    def test_cast_when_not_prepared_is_rejected(self) -> None:\n466\t        game = create_game()\n467\t        p1, p2 = game.players\n468\t        card = _make_card(game, 0)\n469\t        game.get_battlefield(p1).add(card)\n470\t        # The creature is NOT prepared.\n471\t        assert card.prepared is False\n472\t\n473\t        victim = Creature(\n474\t            name=\"Safe Beast\", owner=p2, controller=p2, base_power=2, base_toughness=2\n475\t        )\n476\t        game.get_battlefield(p2).add(victim)\n477\t        before = p2.life\n478\t\n479\t        # Casting the prepare spell while not prepared must be rejected.\n480\t        with pytest.raises(ValueError):\n481\t            card.cast_prepare_spell(game, target=victim)\n482\t\n483\t        # The rejected attempt must not have exiled the creature or moved life.\n484\t        assert game.get_battlefield(p2).contains(victim)\n485\t        assert p2.life == before\n486\t"}]},"parent_tool_use_id":"toolu_018joPD2pbTUDWvHehg7gDJr","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"1960ea6e-21e8-4f37-8184-ccb0bd4cfcd9","timestamp":"2026-06-02T00:19:00.947Z","subagent_type":"Reviewer","task_description":"Review sos_13 implementation"}
