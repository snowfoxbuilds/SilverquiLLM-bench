{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BxhVuj6unaczpZyfnSBW9U","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_1/card_impl.py b/cards/sos/sos_1/card_impl.py\n2\tindex 6f6280e..f853c95 100644\n3\t--- a/cards/sos/sos_1/card_impl.py\n4\t+++ b/cards/sos/sos_1/card_impl.py\n5\t@@ -2,15 +2,129 @@\n6\t \n7\t from __future__ import annotations\n8\t \n9\t-from engine.card import CardImpl\n10\t+from typing import TYPE_CHECKING, Any\n11\t \n12\t-from typing import TYPE_CHECKING\n13\t+from engine.card import Creature\n14\t+from engine.types import CardType, Keyword, ManaCost, Supertype, Zone\n15\t \n16\t if TYPE_CHECKING:\n17\t     from engine.game_state import GameState\n18\t \n19\t \n20\t-class TheDawningArchaic(CardImpl):\n21\t-    \"\"\"TODO: Implement The Dawning Archaic.\"\"\"\n22\t+class TheDawningArchaic(Creature):\n23\t+    \"\"\"The Dawning Archaic — {10} — 7/7 — Legendary Creature — Avatar.\n24\t \n25\t-    pass\n26\t+    Reach.\n27\t+    This spell costs {1} less to cast for each instant and sorcery card in\n28\t+    your graveyard.\n29\t+    Whenever The Dawning Archaic attacks, you may cast target instant or\n30\t+    sorcery card from your graveyard without paying its mana cost. If that\n31\t+    spell would be put into your graveyard, exile it instead.\n32\t+\n33\t+    SOS collector number 1.\n34\t+    \"\"\"\n35\t+\n36\t+    def __init__(self, **kwargs: Any) -> None:\n37\t+        kwargs.setdefault(\"name\", \"The Dawning Archaic\")\n38\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{10}\"))\n39\t+        kwargs.setdefault(\"subtypes\", {\"Avatar\"})\n40\t+        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n41\t+        kwargs.setdefault(\"keywords\", Keyword.REACH)\n42\t+        kwargs.setdefault(\"base_power\", 7)\n43\t+        kwargs.setdefault(\"base_toughness\", 7)\n44\t+        kwargs.setdefault(\n45\t+            \"rules_text\",\n46\t+            \"This spell costs {1} less to cast for each instant and sorcery \"\n47\t+            \"card in your graveyard.\\nReach\\nWhenever The Dawning Archaic \"\n48\t+            \"attacks, you may cast target instant or sorcery card from your \"\n49\t+            \"graveyard without paying its mana cost. If that spell would be \"\n50\t+            \"put into your graveyard, exile it instead.\",\n51\t+        )\n52\t+        super().__init__(**kwargs)\n53\t+\n54\t+    # ------------------------------------------------------------------\n55\t+    # Cost reduction\n56\t+    # ------------------------------------------------------------------\n57\t+\n58\t+    def cost_reduction(self, game: \"GameState\") -> int:\n59\t+        \"\"\"Return {1} per instant/sorcery card in the controller's graveyard.\n60\t+\n61\t+        The engine clamps this value to the generic portion of the mana cost\n62\t+        (see :func:`engine.casting.get_cost_reduction`), so colored mana is\n63\t+        never reduced and the value never drives generic below zero.\n64\t+        \"\"\"\n65\t+        controller = getattr(self, \"controller\", None)\n66\t+        if controller is None:\n67\t+            return 0\n68\t+        graveyard = game.get_graveyard(controller)\n69\t+        count = 0\n70\t+        for card in graveyard.get_all():\n71\t+            card_types = getattr(card, \"card_types\", set())\n72\t+            if CardType.INSTANT in card_types or CardType.SORCERY in card_types:\n73\t+                count += 1\n74\t+        return count\n75\t+\n76\t+    # ------------------------------------------------------------------\n77\t+    # Attack trigger: free-cast an instant/sorcery from your graveyard\n78\t+    # ------------------------------------------------------------------\n79\t+\n80\t+    def register_triggers(self, game: \"GameState\") -> None:\n81\t+        \"\"\"Register the attack trigger for the optional free cast.\"\"\"\n82\t+        from engine.events import AttacksTriggeredEvent\n83\t+        from engine.triggers import TriggerRegistration\n84\t+\n85\t+        source = self\n86\t+\n87\t+        def _condition(game: Any, event: Any) -> bool:\n88\t+            return event.creature is source\n89\t+\n90\t+        def _effect(game: \"GameState\") -> None:\n91\t+            from engine.casting import cast_spell_free\n92\t+\n93\t+            controller = getattr(source, \"controller\", None)\n94\t+            if controller is None:\n95\t+                return\n96\t+\n97\t+            # \"you may\" — ask before doing anything else.\n98\t+            if not controller.choose_yes_no(\n99\t+                \"Cast an instant or sorcery from your graveyard without \"\n100\t+                \"paying its mana cost?\"\n101\t+            ):\n102\t+                return\n103\t+\n104\t+            # Gather legal targets: instant/sorcery cards in your graveyard.\n105\t+            graveyard = game.get_graveyard(controller)\n106\t+            legal = [\n107\t+                card\n108\t+                for card in graveyard.get_all()\n109\t+                if (\n110\t+                    CardType.INSTANT in getattr(card, \"card_types\", set())\n111\t+                    or CardType.SORCERY in getattr(card, \"card_types\", set())\n112\t+                )\n113\t+            ]\n114\t+            if not legal:\n115\t+                # Said yes but there is nothing to cast — safe no-op.\n116\t+                return\n117\t+\n118\t+            chosen = controller.choose_card(\n119\t+                legal, \"Choose an instant or sorcery to cast from your graveyard\"\n120\t+            )\n121\t+            if chosen is None or chosen not in legal:\n122\t+                return\n123\t+\n124\t+            # \"If that spell would be put into your graveyard, exile it\n125\t+            # instead.\" Flag the spell so the resolution pipeline redirects\n126\t+            # its stack -> graveyard move to exile.\n127\t+            chosen._exile_instead_of_graveyard = True  # type: ignore[attr-defined]\n128\t+            cast_spell_free(game, controller, chosen, Zone.GRAVEYARD)\n129\t+\n130\t+        controller = getattr(self, \"controller\", None) or game.active_player\n131\t+        game.trigger_manager.register(\n132\t+            TriggerRegistration(\n133\t+                event_type=AttacksTriggeredEvent,\n134\t+                condition=_condition,\n135\t+                effect=_effect,\n136\t+                source=self,\n137\t+                controller=controller,\n138\t+            )\n139\t+        )\n140\tdiff --git a/engine/casting.py b/engine/casting.py\n141\tindex 5d8acca..4131e11 100644\n142\t--- a/engine/casting.py\n143\t+++ b/engine/casting.py\n144\t@@ -407,7 +407,18 @@ def _resolve_spell(\n145\t         move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n146\t     else:\n147\t         # Instant/sorcery: move from stack to graveyard via move_to_zone.\n148\t-        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n149\t+        # Some effects (e.g. The Dawning Archaic's free cast) attach a\n150\t+        # per-spell replacement: \"If that spell would be put into your\n151\t+        # graveyard, exile it instead.\" Honour that opt-in flag here.\n152\t+        destination = Zone.GRAVEYARD\n153\t+        if getattr(card, \"_exile_instead_of_graveyard\", False):\n154\t+            destination = Zone.EXILE\n155\t+            # One-shot replacement: clear the flag now that it has applied.\n156\t+            try:\n157\t+                del card._exile_instead_of_graveyard\n158\t+            except AttributeError:  # pragma: no cover - defensive\n159\t+                card._exile_instead_of_graveyard = False\n160\t+        move_to_zone(game, card, Zone.STACK, destination)\n161\t \n162\t \n163\t # ------------------------------------------------------------------\n164\t"}]},"parent_tool_use_id":"toolu_01M5VoMrQGZA4rJT4yuqEbDA","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"24c2f4ae-2afc-4e9c-bf68-363563f192eb","timestamp":"2026-06-01T23:50:3