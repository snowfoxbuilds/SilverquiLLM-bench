{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_011nYkxGWXrx27qtmSmg7V5K","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LaTp3naLuG1SJdnztPDHV7","name":"Read","input":{"file_path":"/workspace/engine/casting.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10943,"cache_read_input_tokens":22201,"cache_creation":{"ephemeral_5m_input_tokens":10943,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_019PHzm2FDpRXoh6F4NHApme","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"50a55f44-1e0f-45e3-b8bf-41563f5ac056","request_id":"req_011CbdbkFd73C6ETB7rqoobb","subagent_type":"Implementer","task_description":"Implement sos_245 Witherbloom + affinity"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LaTp3naLuG1SJdnztPDHV7","type":"tool_result","content":"1\t\"\"\"Casting and resolution pipeline for spells and lands.\n2\t\n3\tProvides the full flow from casting a spell or playing a land through\n4\tresolution:\n5\t\n6\t- :func:`cast_spell` — verify timing & legality → move hand to stack →\n7\t  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n8\t- :func:`play_land` — verify land play remaining → move hand to\n9\t  battlefield → decrement ``land_plays_remaining``.\n10\t- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n11\t  helpers used by the casting pipeline.\n12\t\n13\tResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\n14\tcreated by :func:`cast_spell`:\n15\t\n16\t- Call ``card.on_resolve(game)``.\n17\t- Permanents (creature / enchantment / artifact / planeswalker) move from\n18\t  the stack to the battlefield.\n19\t- Non-permanents (instant / sorcery) move to the graveyard.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import TYPE_CHECKING, Any\n25\t\n26\tfrom engine.card import CardImpl\n27\tfrom engine.stack import StackObject\n28\tfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\n29\tfrom engine.zones import move_zone\n30\t\n31\tif TYPE_CHECKING:\n32\t    from engine.game_state import GameState\n33\t    from engine.player import Player\n34\t\n35\t\n36\t# Card types that represent permanents — these go to the battlefield on resolve.\n37\t_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n38\t    CardType.CREATURE,\n39\t    CardType.ENCHANTMENT,\n40\t    CardType.ARTIFACT,\n41\t    CardType.PLANESWALKER,\n42\t})\n43\t\n44\t\n45\tclass CastingError(Exception):\n46\t    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n47\t\n48\t\n49\t# ------------------------------------------------------------------\n50\t# Timing helpers\n51\t# ------------------------------------------------------------------\n52\t\n53\tdef is_sorcery_speed(game: GameState, player: Player) -> bool:\n54\t    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n55\t\n56\t    Sorcery speed requires all of:\n57\t\n58\t    * *player* is the active player.\n59\t    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n60\t      ``POSTCOMBAT_MAIN``).\n61\t    * The stack is empty.\n62\t    \"\"\"\n63\t    if player is not game.active_player:\n64\t        return False\n65\t    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n66\t        return False\n67\t    if not game.stack.is_empty():\n68\t        return False\n69\t    return True\n70\t\n71\t\n72\tdef can_cast_at_instant_speed(card: CardImpl) -> bool:\n73\t    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n74\t\n75\t    A card has instant-speed timing if it is an instant or has the\n76\t    :attr:`~engine.types.Keyword.FLASH` keyword.\n77\t    \"\"\"\n78\t    if CardType.INSTANT in card.card_types:\n79\t        return True\n80\t    if Keyword.FLASH & card.keywords:\n81\t        return True\n82\t    return False\n83\t\n84\t\n85\t# ------------------------------------------------------------------\n86\t# Cost reduction\n87\t# ------------------------------------------------------------------\n88\t\n89\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n90\t    \"\"\"Return the generic mana reduction for casting *card*.\n91\t\n92\t    Queries ``card.cost_reduction(game)`` and clamps the result so that\n93\t    the generic portion of the mana cost cannot go below 0.\n94\t\n95\t    This is a simplified single-card self-reduction model.  Full MTG\n96\t    cost-reduction interactions (Trinisphere, multiple reductions from\n97\t    different sources) are deferred.\n98\t    \"\"\"\n99\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n100\t    # casting player even when the card was never explicitly assigned one.\n101\t    prev_controller = card.controller\n102\t    card.controller = controller\n103\t    raw = card.cost_reduction(game)\n104\t    # Restore previous controller in case the caller doesn't want a\n105\t    # side-effect (get_cost_reduction is a query, not a mutation).\n106\t    card.controller = prev_controller\n107\t    generic = card.mana_cost.generic if card.mana_cost else 0\n108\t    return max(0, min(raw, generic))\n109\t\n110\t\n111\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n112\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n113\t    new_generic = max(0, cost.generic - reduction)\n114\t    return ManaCost(\n115\t        generic=new_generic,\n116\t        pips=dict(cost.pips),\n117\t        x_count=cost.x_count,\n118\t        hybrid=list(cost.hybrid),\n119\t    )\n120\t\n121\t\n122\t# ------------------------------------------------------------------\n123\t# Cast spell\n124\t# ------------------------------------------------------------------\n125\t\n126\tdef cast_spell(\n127\t    game: GameState,\n128\t    player: Player,\n129\t    card: CardImpl,\n130\t    alternative_cost: ManaCost | None = None,\n131\t) -> None:\n132\t    \"\"\"Cast *card* from *player*'s hand.\n133\t\n134\t    Pipeline\n135\t    --------\n136\t    1. **Timing check** — instants (and cards with flash) can be cast\n137\t       whenever the player has priority; everything else requires\n138\t       sorcery-speed timing.\n139\t    2. **can_cast** — ask the card whether it can legally be cast.\n140\t    3. **Hand check** — the card must be in the player's hand.\n141\t    4. **Move hand → stack zone** — remove the card from the hand and\n142\t       place it into the player's stack zone.\n143\t    5. **Choose targets** — if the card specifies targets (via\n144\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n145\t    6. **Mana check / payment** — the player's mana pool must be able to\n146\t       pay the card's mana cost.  If payment fails, the card is rolled\n147\t       back from the stack zone to the hand.\n148\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n149\t    8. **Push StackObject** — push a :class:`StackObject` whose\n150\t       ``on_resolve`` callback handles resolution.\n151\t\n152\t    Parameters:\n153\t        alternative_cost: When provided, the spell is cast paying this\n154\t            :class:`~engine.types.ManaCost` *instead of* ``card.mana_cost``\n155\t            (an alternative cost such as miracle, CR 118.9). Cost reduction\n156\t            is not applied to an alternative cost. ``card.mana_spent`` is set\n157\t            to the alternative cost's converted mana cost. Defaults to\n158\t            ``None`` — the existing behaviour (pay the printed mana cost) is\n159\t            byte-for-byte unchanged.\n160\t\n161\t    Raises:\n162\t        CastingError: If any legality check fails.\n163\t    \"\"\"\n164\t    # 1. Timing\n165\t    # Alternative costs such as miracle (CR 702.94 / 118.9) explicitly permit\n166\t    # casting the spell when it is drawn, regardless of the normal timing\n167\t    # restriction; bypass the sorcery-speed check in that case.\n168\t    if (\n169\t        alternative_cost is None\n170\t        and not can_cast_at_instant_speed(card)\n171\t        and not is_sorcery_speed(game, player)\n172\t    ):\n173\t        raise CastingError(\n174\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n175\t        )\n176\t\n177\t    # 2. can_cast\n178\t    if not card.can_cast(game):\n179\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n180\t\n181\t    # 3. Hand check\n182\t    hand = game.get_hand(player)\n183\t    if not hand.contains(card):\n184\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n185\t\n186\t    # 4. Move card from hand to stack zone\n187\t    stack_zone = player.zones[Zone.STACK]\n188\t    hand.remove(card)\n189\t    stack_zone.add(card)\n190\t\n191\t    # Clear any stale colors_spent / mana_spent from a prior cast before\n192\t    # new payment.\n193\t    if hasattr(card, \"colors_spent\"):\n194\t        del card.colors_spent\n195\t    if hasattr(card, \"mana_spent\"):\n196\t        del card.mana_spent\n197\t\n198\t    # 5. Choose targets\n199\t    target_specs = card.get_targets(game)\n200\t    chosen_targets: list[Any] = []\n201\t    if target_specs:\n202\t        for spec in target_specs:\n203\t            target = player.choose_target(target_specs, spec)\n204\t            # Validate against filter_fn if the spec provides one\n205\t            filter_fn = getattr(spec, \"filter_fn\", None)\n206\t            if filter_fn is not None and target is not None:\n207\t                if not filter_fn(target):\n208\t                    stack_zone.remove(card)\n209\t                    hand.add(card)\n210\t                    raise CastingError(\n211\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n212\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n213\t                    )\n214\t            chosen_targets.append(target)\n215\t\n216\t    # 5b. Protection check — reject targets that have protection from this\n217\t    #     spell (the T in DEBT).\n218\t    from engine.protection import has_protection_from\n219\t\n220\t    for target in chosen_targets:\n221\t        if has_protection_from(target, card):\n222\t            # Rollback: move card from stack zone back to hand\n223\t            stack_zone.remove(card)\n224\t            hand.add(card)\n225\t            raise CastingError(\n226\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n227\t            )\n228\t\n229\t    # Targets are stored on the StackObject (not the card) and passed\n230\t    # through the resolve pipeline via on_resolve(game, targets=...).\n231\t\n232\t    # 6. Mana check / payment (rollback on failure)\n233\t    # Ensure the card knows its controller so that cost_reduction() hooks\n234\t    # (e.g. Embercleave counting attacking creatures you control) see the\n235\t    # casting player, even for cards that were added to hand without an\n236\t    # explicit controller assignment.\n237\t    if card.controller is None:\n238\t        card.controller = player\n239\t    if alternative_cost is not None:\n240\t        # Alternative costs (e.g. miracle, CR 118.9) replace the printed mana\n241\t        # cost wholesale and are not subject to generic cost reduction.\n242\t        effective_cost = alternative_cost\n243\t    else:\n244\t        reduction = get_cost_reduction(game, card, player)\n245\t        effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n246\t\n247\t    if not player.mana_pool.can_pay(effective_cost):\n248\t        # Rollback: move card from stack zone back to hand\n249\t        stack_zone.remove(card)\n250\t        hand.add(card)\n251\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n252\t\n253\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n254\t    player.mana_pool.pay(effective_cost)\n255\t\n256\t    # Store colors of mana spent on the card for mechanics like Converge\n257\t    # that care about the colors used to cast the spell.\n258\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n259\t\n260\t    # Store the TOTAL amount of mana spent (converted, after cost reduction)\n261\t    # for mechanics that reimburse / count the mana paid to cast the spell\n262\t    # (e.g. Mana Sculpt). Additive and backward-compatible — defaults absent.\n263\t    card.mana_spent = effective_cost.cmc  # type: ignore[attr-defined]\n264\t\n265\t    # 7. Call on_cast hook\n266\t    card.on_cast(game)\n267\t\n268\t    # 8. Build on_resolve callback and push StackObject\n269\t    stack_obj = StackObject(\n270\t        source=card,\n271\t        controller=player,\n272\t        targets=chosen_targets,\n273\t        on_resolve=lambda g: None,  # replaced below\n274\t        is_spell=True,\n275\t    )\n276\t\n277\t    def _on_resolve(g: GameState) -> None:\n278\t        _resolve_spell(g, card, player, stack_obj)\n279\t\n280\t    stack_obj.on_resolve = _on_resolve\n281\t    game.stack.push(stack_obj)\n282\t\n283\t    # Casualty window (CR 702.153). This is a COMPLETE no-op unless some\n284\t    # permanent the CASTER controls advertises a ``grants_casualty_to(spell)``\n285\t    # capability for the just-cast spell. Only then is that permanent's\n286\t    # ``offer_casualty`` invoked. Keeping the hook fully gated means ordinary\n287\t    # casts (where nothing grants casualty) see zero behavioural change.\n288\t    _offer_casualty(game, player, stack_obj)\n289\t\n290\t\n291\tdef _offer_casualty(game: GameState, player: Player, stack_obj: StackObject) -> None:\n292\t    \"\"\"Offer casualty for the spell *stack_obj* just cast by *player*.\n293\t\n294\t    Gated so it does nothing unless some permanent *player* controls advertises\n295\t    a ``grants_casualty_to(spell)`` capability returning a non-``None`` amount\n296\t    for ``stack_obj.source``. For each such permanent, its\n297\t    ``offer_casualty(game, stack_obj)`` is invoked (which itself decides whether\n298\t    a creature is sacrificed and a copy is made).\n299\t\n300\t    When no controlled permanent grants casualty the helper does nothing — NO\n301\t    prompt, NO state change — so the default cast path is byte-for-byte\n302\t    unchanged in the absence of a grantor. Capability checks are ``getattr``-safe\n303\t    because not all permanents define ``grants_casualty_to``.\n304\t    \"\"\"\n305\t    if not getattr(stack_obj, \"is_spell\", False):\n306\t        return\n307\t\n308\t    spell = getattr(stack_obj, \"source\", None)\n309\t    if spell is None:\n310\t        return\n311\t\n312\t    battlefield = player.zones[Zone.BATTLEFIELD]\n313\t    # Snapshot the permanents so an offer that copies the spell (and may\n314\t    # otherwise mutate the battlefield) does not perturb iteration.\n315\t    for permanent in list(battlefield.get_all()):\n316\t        grant = getattr(permanent, \"grants_casualty_to\", None)\n317\t        if grant is None:\n318\t            continue\n319\t        if grant(spell) is None:\n320\t            continue\n321\t        offer = getattr(permanent, \"offer_casualty\", None)\n322\t        if offer is None:\n323\t            continue\n324\t        offer(game, stack_obj)\n325\t\n326\t\n327\t# ------------------------------------------------------------------\n328\t# Cast spell without paying mana cost (free-cast from any zone)\n329\t# ------------------------------------------------------------------\n330\t\n331\t\n332\tdef cast_spell_free(\n333\t    game: GameState,\n334\t    player: Player,\n335\t    card: CardImpl,\n336\t    from_zone: Zone,\n337\t) -> None:\n338\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n339\t\n340\t    This is used by effects that allow casting from zones other than hand\n341\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n342\t    or cascade.\n343\t\n344\t    Pipeline\n345\t    --------\n346\t    1. **can_cast** — ask the card whether it can legally be cast (same\n347\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n348\t    2. Move *card* from *from_zone* to the stack zone.\n349\t    3. Choose targets (if applicable) with validation and protection check.\n350\t    4. Call ``on_cast`` hook.\n351\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n352\t       resolution normally (permanents → battlefield, non-permanents →\n353\t       graveyard).\n354\t\n355\t    No timing check or mana payment is performed.  The spell goes on the\n356\t    stack and can be responded to normally (e.g. countered).\n357\t\n358\t    If targeting or other post-move checks fail, the card is rolled back\n359\t    to its source zone.\n360\t\n361\t    Parameters:\n362\t        game: The current game state.\n363\t        player: The player casting the spell.\n364\t        card: The card to cast.\n365\t        from_zone: The zone the card is currently in.\n366\t\n367\t    Raises:\n368\t        CastingError: If the card cannot be found in *from_zone* or\n369\t            legality checks fail.\n370\t    \"\"\"\n371\t    from engine.zones import move_to_zone\n372\t\n373\t    # Ensure controller is set\n374\t    card.controller = player\n375\t    if card.owner is None:\n376\t        card.owner = player\n377\t\n378\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n379\t    if not card.can_cast(game):\n380\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n381\t\n382\t    # 2. Locate card in source zone\n383\t    source_zone_container = player.zones[from_zone]\n384\t    if not source_zone_container.contains(card):\n385\t        # Try to find the card in any player's zone\n386\t        source_zone_container = None\n387\t        for p in game.players:\n388\t            z = p.zones[from_zone]\n389\t            if z.contains(card):\n390\t                source_zone_container = z\n391\t                break\n392\t\n393\t    if source_zone_container is None or not source_zone_container.contains(card):\n394\t        raise CastingError(\n395\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n396\t        )\n397\t\n398\t    # Move card from source zone to stack zone\n399\t    stack_zone = player.zones[Zone.STACK]\n400\t    source_zone_container.remove(card)\n401\t    stack_zone.add(card)\n402\t\n403\t    # 3. Choose targets (with rollback on failure)\n404\t    try:\n405\t        target_specs = card.get_targets(game)\n406\t        chosen_targets: list[Any] = []\n407\t        if target_specs:\n408\t            for spec in target_specs:\n409\t                target = player.choose_target(target_specs, spec)\n410\t                # Validate against filter_fn if the spec provides one\n411\t                filter_fn = getattr(spec, \"filter_fn\", None)\n412\t                if filter_fn is not None and target is not None:\n413\t                    if not filter_fn(target):\n414\t                        raise CastingError(\n415\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n416\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n417\t                        )\n418\t                chosen_targets.append(target)\n419\t\n420\t        # Protection check — reject targets that have protection from this spell\n421\t        from engine.protection import has_protection_from\n422\t\n423\t        for target in chosen_targets:\n424\t            if has_protection_from(target, card):\n425\t                raise CastingError(\n426\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n427\t                )\n428\t    except Exception as exc:\n429\t        # Rollback: move card from stack zone back to source zone\n430\t        stack_zone.remove(card)\n431\t        source_zone_container.add(card)\n432\t        raise CastingError(str(exc)) from exc\n433\t\n434\t    # Free casts pay no mana, so the total mana spent is 0.\n435\t    card.mana_spent = 0  # type: ignore[attr-defined]\n436\t\n437\t    # 4. Call on_cast hook\n438\t    card.on_cast(game)\n439\t\n440\t    # 5. Build on_resolve callback and push StackObject\n441\t    stack_obj = StackObject(\n442\t        source=card,\n443\t        controller=player,\n444\t        targets=chosen_targets,\n445\t        on_resolve=lambda g: None,  # replaced below\n446\t        is_spell=True,\n447\t    )\n448\t\n449\t    def _on_resolve(g: GameState) -> None:\n450\t        _resolve_spell(g, card, player, stack_obj)\n451\t\n452\t    stack_obj.on_resolve = _on_resolve\n453\t    game.stack.push(stack_obj)\n454\t\n455\t\n456\t# ------------------------------------------------------------------\n457\t# Resolution (called when the stack pops)\n458\t# ------------------------------------------------------------------\n459\t\n460\tdef _resolve_spell(\n461\t    game: GameState,\n462\t    card: CardImpl,\n463\t    player: Player,\n464\t    stack_obj: StackObject,\n465\t) -> None:\n466\t    \"\"\"Resolve *card* cast by *player*.\n467\t\n468\t    1. Call ``card.on_resolve(game, targets=targets)``.\n469\t    2. Remove the card from the stack zone.\n470\t    3. If the card is a permanent type, move it to the battlefield via\n471\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n472\t       registration and the ETB event).\n473\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n474\t    \"\"\"\n475\t    from engine.zones import move_to_zone\n476\t\n477\t    # Read targets from the StackObject — the single source of truth.\n478\t    # Set chosen_targets on the card just before resolution so that\n479\t    # _get_chosen_target helpers (which read via getattr) work.\n480\t    targets = stack_obj.targets\n481\t    if targets is not None:\n482\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n483\t\n484\t    card.on_resolve(game)\n485\t\n486\t    if card.card_types & _PERMANENT_TYPES:\n487\t        # Move from stack to battlefield via move_to_zone, which handles\n488\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n489\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n490\t    else:\n491\t        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n492\t        # Some effects (e.g. The Dawning Archaic's free cast) attach a\n493\t        # per-spell replacement: \"If that spell would be put into your\n494\t        # graveyard, exile it instead.\" Honour that opt-in flag here.\n495\t        destination = Zone.GRAVEYARD\n496\t        if getattr(card, \"_exile_instead_of_graveyard\", False):\n497\t            destination = Zone.EXILE\n498\t            # One-shot replacement: clear the flag now that it has applied.\n499\t            try:\n500\t                del card._exile_instead_of_graveyard\n501\t            except AttributeError:  # pragma: no cover - defensive\n502\t                card._exile_instead_of_graveyard = False\n503\t        move_to_zone(game, card, Zone.STACK, destination)\n504\t\n505\t\n506\t# ------------------------------------------------------------------\n507\t# Play land (special action — does not use the stack)\n508\t# ------------------------------------------------------------------\n509\t\n510\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n511\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n512\t\n513\t    Requirements (all must hold):\n514\t\n515\t    * *land_card* has :attr:`CardType.LAND`.\n516\t    * *player* is the active player.\n517\t    * Current phase is a main phase.\n518\t    * The stack is empty.\n519\t    * ``player.land_plays_remaining > 0``.\n520\t    * The card is in the player's hand.\n521\t\n522\t    On success the card moves from hand to battlefield and\n523\t    ``land_plays_remaining`` is decremented.\n524\t\n525\t    Raises:\n526\t        CastingError: If any requirement is not met.\n527\t    \"\"\"\n528\t    # Must be a land\n529\t    if CardType.LAND not in land_card.card_types:\n530\t        raise CastingError(\n531\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n532\t        )\n533\t\n534\t    # Sorcery-speed timing (active player, main phase, stack empty)\n535\t    if not is_sorcery_speed(game, player):\n536\t        raise CastingError(\n537\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n538\t            \"during main phase with empty stack\"\n539\t        )\n540\t\n541\t    # Land plays remaining\n542\t    if player.land_plays_remaining <= 0:\n543\t        raise CastingError(\n544\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n545\t        )\n546\t\n547\t    # Card must be in hand\n548\t    hand = game.get_hand(player)\n549\t    if not hand.contains(land_card):\n550\t        raise CastingError(\n551\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n552\t        )\n553\t\n554\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n555\t    if land_card.owner is None:\n556\t        land_card.owner = player\n557\t    land_card.controller = player\n558\t\n559\t    # Move from hand to battlefield via move_to_zone, which fires\n560\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n561\t    from engine.zones import move_to_zone\n562\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n563\t\n564\t    # Decrement land plays\n565\t    player.land_plays_remaining -= 1\n566\t\n567\t\n568\tdef resolve_top(game: GameState) -> None:\n569\t    \"\"\"Resolve the top spell/ability on the stack.\n570\t\n571\t    Pops the top item from the stack, calls its on_resolve callback,\n572\t    then runs state-based actions.  If the stack is empty this is a no-op.\n573\t    \"\"\"\n574\t    if game.stack.is_empty():\n575\t        return\n576\t    from engine.state_based_actions import resolve_state_based_actions\n577\t\n578\t    obj = game.stack.pop()\n579\t    obj.on_resolve(game)\n580\t    resolve_state_based_actions(game)\n581\t"}]},"parent_tool_use_id":"toolu_019PHzm2FDpRXoh6F4NHApme","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"2c0f6070-5595-48fb-818c-b76b14e63e2d","timestamp":"2026-06-02T01:54:39.428Z","subagent_type":"Implementer","task_description":"Implement sos_245 Witherbloom + affinity"}
