{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VwHYkH3ckxBAQMrhrTn8Me","type":"tool_result","content":"1\t\"\"\"Casting and resolution pipeline for spells and lands.\n2\t\n3\tProvides the full flow from casting a spell or playing a land through\n4\tresolution:\n5\t\n6\t- :func:`cast_spell` — verify timing & legality → move hand to stack →\n7\t  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n8\t- :func:`play_land` — verify land play remaining → move hand to\n9\t  battlefield → decrement ``land_plays_remaining``.\n10\t- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n11\t  helpers used by the casting pipeline.\n12\t\n13\tResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\n14\tcreated by :func:`cast_spell`:\n15\t\n16\t- Call ``card.on_resolve(game)``.\n17\t- Permanents (creature / enchantment / artifact / planeswalker) move from\n18\t  the stack to the battlefield.\n19\t- Non-permanents (instant / sorcery) move to the graveyard.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import TYPE_CHECKING, Any\n25\t\n26\tfrom engine.card import CardImpl\n27\tfrom engine.stack import StackObject\n28\tfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\n29\tfrom engine.zones import move_zone\n30\t\n31\tif TYPE_CHECKING:\n32\t    from engine.game_state import GameState\n33\t    from engine.player import Player\n34\t\n35\t\n36\t# Card types that represent permanents — these go to the battlefield on resolve.\n37\t_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n38\t    CardType.CREATURE,\n39\t    CardType.ENCHANTMENT,\n40\t    CardType.ARTIFACT,\n41\t    CardType.PLANESWALKER,\n42\t})\n43\t\n44\t\n45\tclass CastingError(Exception):\n46\t    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n47\t\n48\t\n49\t# ------------------------------------------------------------------\n50\t# Timing helpers\n51\t# ------------------------------------------------------------------\n52\t\n53\tdef is_sorcery_speed(game: GameState, player: Player) -> bool:\n54\t    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n55\t\n56\t    Sorcery speed requires all of:\n57\t\n58\t    * *player* is the active player.\n59\t    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n60\t      ``POSTCOMBAT_MAIN``).\n61\t    * The stack is empty.\n62\t    \"\"\"\n63\t    if player is not game.active_player:\n64\t        return False\n65\t    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n66\t        return False\n67\t    if not game.stack.is_empty():\n68\t        return False\n69\t    return True\n70\t\n71\t\n72\tdef can_cast_at_instant_speed(card: CardImpl) -> bool:\n73\t    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n74\t\n75\t    A card has instant-speed timing if it is an instant or has the\n76\t    :attr:`~engine.types.Keyword.FLASH` keyword.\n77\t    \"\"\"\n78\t    if CardType.INSTANT in card.card_types:\n79\t        return True\n80\t    if Keyword.FLASH & card.keywords:\n81\t        return True\n82\t    return False\n83\t\n84\t\n85\t# ------------------------------------------------------------------\n86\t# Cost reduction\n87\t# ------------------------------------------------------------------\n88\t\n89\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n90\t    \"\"\"Return the generic mana reduction for casting *card*.\n91\t\n92\t    Queries ``card.cost_reduction(game)`` and clamps the result so that\n93\t    the generic portion of the mana cost cannot go below 0.\n94\t\n95\t    This is a simplified single-card self-reduction model.  Full MTG\n96\t    cost-reduction interactions (Trinisphere, multiple reductions from\n97\t    different sources) are deferred.\n98\t    \"\"\"\n99\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n100\t    # casting player even when the card was never explicitly assigned one.\n101\t    prev_controller = card.controller\n102\t    card.controller = controller\n103\t    raw = card.cost_reduction(game)\n104\t    # Restore previous controller in case the caller doesn't want a\n105\t    # side-effect (get_cost_reduction is a query, not a mutation).\n106\t    card.controller = prev_controller\n107\t    # Granted affinity / cost reduction from permanents the CASTER controls\n108\t    # (e.g. \"Instant and sorcery spells you cast have affinity for\n109\t    # creatures.\"). Fully gated — a COMPLETE no-op when no controlled\n110\t    # permanent advertises the capability — so the default single-source\n111\t    # reduction path is byte-for-byte unchanged.\n112\t    raw += _granted_cost_reduction(game, card, controller)\n113\t    generic = card.mana_cost.generic if card.mana_cost else 0\n114\t    return max(0, min(raw, generic))\n115\t\n116\t\n117\tdef _granted_cost_reduction(\n118\t    game: GameState, card: CardImpl, controller: Player\n119\t) -> int:\n120\t    \"\"\"Return the cost reduction *granted* to *card* by other permanents.\n121\t\n122\t    Sums reductions granted by permanents *controller* controls that\n123\t    advertise the affinity-grant capability (mirrors the SOS 226\n124\t    ``grants_casualty_to`` / SOS 201 ``grants_miracle_to`` cast-time hooks):\n125\t\n126\t    * ``grants_affinity_to(spell) -> bool`` — truthy if the permanent grants\n127\t      affinity to *card* (e.g. only instants/sorceries).\n128\t    * ``affinity_reduction(game) -> int`` — the reduction value granted.\n129\t\n130\t    Capability probing is ``getattr``-safe because most permanents define\n131\t    neither method. When no controlled permanent grants affinity to *card*,\n132\t    this returns 0 with NO state change — so the default reduction path and\n133\t    all engine regression tests stay byte-for-byte equivalent in the absence\n134\t    of a grantor.\n135\t    \"\"\"\n136\t    if controller is None:\n137\t        return 0\n138\t\n139\t    battlefield = controller.zones[Zone.BATTLEFIELD]\n140\t    total = 0\n141\t    for permanent in battlefield.get_all():\n142\t        # The granting permanent never reduces its own cast (it is on the\n143\t        # battlefield, not on the stack), but guard anyway so a permanent that\n144\t        # somehow grants to itself does not double-count.\n145\t        if permanent is card:\n146\t            continue\n147\t        grants = getattr(permanent, \"grants_affinity_to\", None)\n148\t        if grants is None:\n149\t            continue\n150\t        if not grants(card):\n151\t            continue\n152\t        reduce_fn = getattr(permanent, \"affinity_reduction\", None)\n153\t        if reduce_fn is None:\n154\t            continue\n155\t        amount = reduce_fn(game)\n156\t        if amount:\n157\t            total += amount\n158\t    return total\n159\t\n160\t\n161\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n162\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n163\t    new_generic = max(0, cost.generic - reduction)\n164\t    return ManaCost(\n165\t        generic=new_generic,\n166\t        pips=dict(cost.pips),\n167\t        x_count=cost.x_count,\n168\t        hybrid=list(cost.hybrid),\n169\t    )\n170\t\n171\t\n172\t# ------------------------------------------------------------------\n173\t# Cast spell\n174\t# ------------------------------------------------------------------\n175\t\n176\tdef cast_spell(\n177\t    game: GameState,\n178\t    player: Player,\n179\t    card: CardImpl,\n180\t    alternative_cost: ManaCost | None = None,\n181\t) -> None:\n182\t    \"\"\"Cast *card* from *player*'s hand.\n183\t\n184\t    Pipeline\n185\t    --------\n186\t    1. **Timing check** — instants (and cards with flash) can be cast\n187\t       whenever the player has priority; everything else requires\n188\t       sorcery-speed timing.\n189\t    2. **can_cast** — ask the card whether it can legally be cast.\n190\t    3. **Hand check** — the card must be in the player's hand.\n191\t    4. **Move hand → stack zone** — remove the card from the hand and\n192\t       place it into the player's stack zone.\n193\t    5. **Choose targets** — if the card specifies targets (via\n194\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n195\t    6. **Mana check / payment** — the player's mana pool must be able to\n196\t       pay the card's mana cost.  If payment fails, the card is rolled\n197\t       back from the stack zone to the hand.\n198\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n199\t    8. **Push StackObject** — push a :class:`StackObject` whose\n200\t       ``on_resolve`` callback handles resolution.\n201\t\n202\t    Parameters:\n203\t        alternative_cost: When provided, the spell is cast paying this\n204\t            :class:`~engine.types.ManaCost` *instead of* ``card.mana_cost``\n205\t            (an alternative cost such as miracle, CR 118.9). Cost reduction\n206\t            is not applied to an alternative cost. ``card.mana_spent`` is set\n207\t            to the alternative cost's converted mana cost. Defaults to\n208\t            ``None`` — the existing behaviour (pay the printed mana cost) is\n209\t            byte-for-byte unchanged.\n210\t\n211\t    Raises:\n212\t        CastingError: If any legality check fails.\n213\t    \"\"\"\n214\t    # 1. Timing\n215\t    # Alternative costs such as miracle (CR 702.94 / 118.9) explicitly permit\n216\t    # casting the spell when it is drawn, regardless of the normal timing\n217\t    # restriction; bypass the sorcery-speed check in that case.\n218\t    if (\n219\t        alternative_cost is None\n220\t        and not can_cast_at_instant_speed(card)\n221\t        and not is_sorcery_speed(game, player)\n222\t    ):\n223\t        raise CastingError(\n224\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n225\t        )\n226\t\n227\t    # 2. can_cast\n228\t    if not card.can_cast(game):\n229\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n230\t\n231\t    # 3. Hand check\n232\t    hand = game.get_hand(player)\n233\t    if not hand.contains(card):\n234\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n235\t\n236\t    # 4. Move card from hand to stack zone\n237\t    stack_zone = player.zones[Zone.STACK]\n238\t    hand.remove(card)\n239\t    stack_zone.add(card)\n240\t\n241\t    # Clear any stale colors_spent / mana_spent from a prior cast before\n242\t    # new payment.\n243\t    if hasattr(card, \"colors_spent\"):\n244\t        del card.colors_spent\n245\t    if hasattr(card, \"mana_spent\"):\n246\t        del card.mana_spent\n247\t\n248\t    # 5. Choose targets\n249\t    target_specs = card.get_targets(game)\n250\t    chosen_targets: list[Any] = []\n251\t    if target_specs:\n252\t        for spec in target_specs:\n253\t            target = player.choose_target(target_specs, spec)\n254\t            # Validate against filter_fn if the spec provides one\n255\t            filter_fn = getattr(spec, \"filter_fn\", None)\n256\t            if filter_fn is not None and target is not None:\n257\t                if not filter_fn(target):\n258\t                    stack_zone.remove(card)\n259\t                    hand.add(card)\n260\t                    raise CastingError(\n261\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n262\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n263\t                    )\n264\t            chosen_targets.append(target)\n265\t\n266\t    # 5b. Protection check — reject targets that have protection from this\n267\t    #     spell (the T in DEBT).\n268\t    from engine.protection import has_protection_from\n269\t\n270\t    for target in chosen_targets:\n271\t        if has_protection_from(target, card):\n272\t            # Rollback: move card from stack zone back to hand\n273\t            stack_zone.remove(card)\n274\t            hand.add(card)\n275\t            raise CastingError(\n276\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n277\t            )\n278\t\n279\t    # Targets are stored on the StackObject (not the card) and passed\n280\t    # through the resolve pipeline via on_resolve(game, targets=...).\n281\t\n282\t    # 6. Mana check / payment (rollback on failure)\n283\t    # Ensure the card knows its controller so that cost_reduction() hooks\n284\t    # (e.g. Embercleave counting attacking creatures you control) see the\n285\t    # casting player, even for cards that were added to hand without an\n286\t    # explicit controller assignment.\n287\t    if card.controller is None:\n288\t        card.controller = player\n289\t    if alternative_cost is not None:\n290\t        # Alternative costs (e.g. miracle, CR 118.9) replace the printed mana\n291\t        # cost wholesale and are not subject to generic cost reduction.\n292\t        effective_cost = alternative_cost\n293\t    else:\n294\t        reduction = get_cost_reduction(game, card, player)\n295\t        effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n296\t\n297\t    if not player.mana_pool.can_pay(effective_cost):\n298\t        # Rollback: move card from stack zone back to hand\n299\t        stack_zone.remove(card)\n300\t        hand.add(card)\n301\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n302\t\n303\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n304\t    player.mana_pool.pay(effective_cost)\n305\t\n306\t    # Store colors of mana spent on the card for mechanics like Converge\n307\t    # that care about the colors used to cast the spell.\n308\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n309\t\n310\t    # Store the TOTAL amount of mana spent (converted, after cost reduction)\n311\t    # for mechanics that reimburse / count the mana paid to cast the spell\n312\t    # (e.g. Mana Sculpt). Additive and backward-compatible — defaults absent.\n313\t    card.mana_spent = effective_cost.cmc  # type: ignore[attr-defined]\n314\t\n315\t    # 7. Call on_cast hook\n316\t    card.on_cast(game)\n317\t\n318\t    # 8. Build on_resolve callback and push StackObject\n319\t    stack_obj = StackObject(\n320\t        source=card,\n321\t        controller=player,\n322\t        targets=chosen_targets,\n323\t        on_resolve=lambda g: None,  # replaced below\n324\t        is_spell=True,\n325\t    )\n326\t\n327\t    def _on_resolve(g: GameState) -> None:\n328\t        _resolve_spell(g, card, player, stack_obj)\n329\t\n330\t    stack_obj.on_resolve = _on_resolve\n331\t    game.stack.push(stack_obj)\n332\t\n333\t    # Casualty window (CR 702.153). This is a COMPLETE no-op unless some\n334\t    # permanent the CASTER controls advertises a ``grants_casualty_to(spell)``\n335\t    # capability for the just-cast spell. Only then is that permanent's\n336\t    # ``offer_casualty`` invoked. Keeping the hook fully gated means ordinary\n337\t    # casts (where nothing grants casualty) see zero behavioural change.\n338\t    _offer_casualty(game, player, stack_obj)\n339\t\n340\t\n341\tdef _offer_casualty(game: GameState, player: Player, stack_obj: StackObject) -> None:\n342\t    \"\"\"Offer casualty for the spell *stack_obj* just cast by *player*.\n343\t\n344\t    Gated so it does nothing unless some permanent *player* controls advertises\n345\t    a ``grants_casualty_to(spell)`` capability returning a non-``None`` amount\n346\t    for ``stack_obj.source``. For each such permanent, its\n347\t    ``offer_casualty(game, stack_obj)`` is invoked (which itself decides whether\n348\t    a creature is sacrificed and a copy is made).\n349\t\n350\t    When no controlled permanent grants casualty the helper does nothing — NO\n351\t    prompt, NO state change — so the default cast path is byte-for-byte\n352\t    unchanged in the absence of a grantor. Capability checks are ``getattr``-safe\n353\t    because not all permanents define ``grants_casualty_to``.\n354\t    \"\"\"\n355\t    if not getattr(stack_obj, \"is_spell\", False):\n356\t        return\n357\t\n358\t    spell = getattr(stack_obj, \"source\", None)\n359\t    if spell is None:\n360\t        return\n361\t\n362\t    battlefield = player.zones[Zone.BATTLEFIELD]\n363\t    # Snapshot the permanents so an offer that copies the spell (and may\n364\t    # otherwise mutate the battlefield) does not perturb iteration.\n365\t    for permanent in list(battlefield.get_all()):\n366\t        grant = getattr(permanent, \"grants_casualty_to\", None)\n367\t        if grant is None:\n368\t            continue\n369\t        if grant(spell) is None:\n370\t            continue\n371\t        offer = getattr(permanent, \"offer_casualty\", None)\n372\t        if offer is None:\n373\t            continue\n374\t        offer(game, stack_obj)\n375\t\n376\t\n377\t# ------------------------------------------------------------------\n378\t# Cast spell without paying mana cost (free-cast from any zone)\n379\t# ------------------------------------------------------------------\n380\t\n381\t\n382\tdef cast_spell_free(\n383\t    game: GameState,\n384\t    player: Player,\n385\t    card: CardImpl,\n386\t    from_zone: Zone,\n387\t) -> None:\n388\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n389\t\n390\t    This is used by effects that allow casting from zones other than hand\n391\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n392\t    or cascade.\n393\t\n394\t    Pipeline\n395\t    --------\n396\t    1. **can_cast** — ask the card whether it can legally be cast (same\n397\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n398\t    2. Move *card* from *from_zone* to the stack zone.\n399\t    3. Choose targets (if applicable) with validation and protection check.\n400\t    4. Call ``on_cast`` hook.\n401\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n402\t       resolution normally (permanents → battlefield, non-permanents →\n403\t       graveyard).\n404\t\n405\t    No timing check or mana payment is performed.  The spell goes on the\n406\t    stack and can be responded to normally (e.g. countered).\n407\t\n408\t    If targeting or other post-move checks fail, the card is rolled back\n409\t    to its source zone.\n410\t\n411\t    Parameters:\n412\t        game: The current game state.\n413\t        player: The player casting the spell.\n414\t        card: The card to cast.\n415\t        from_zone: The zone the card is currently in.\n416\t\n417\t    Raises:\n418\t        CastingError: If the card cannot be found in *from_zone* or\n419\t            legality checks fail.\n420\t    \"\"\"\n421\t    from engine.zones import move_to_zone\n422\t\n423\t    # Ensure controller is set\n424\t    card.controller = player\n425\t    if card.owner is None:\n426\t        card.owner = player\n427\t\n428\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n429\t    if not card.can_cast(game):\n430\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n431\t\n432\t    # 2. Locate card in source zone\n433\t    source_zone_container = player.zones[from_zone]\n434\t    if not source_zone_container.contains(card):\n435\t        # Try to find the card in any player's zone\n436\t        source_zone_container = None\n437\t        for p in game.players:\n438\t            z = p.zones[from_zone]\n439\t            if z.contains(card):\n440\t                source_zone_container = z\n441\t                break\n442\t\n443\t    if source_zone_container is None or not source_zone_container.contains(card):\n444\t        raise CastingError(\n445\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n446\t        )\n447\t\n448\t    # Move card from source zone to stack zone\n449\t    stack_zone = player.zones[Zone.STACK]\n450\t    source_zone_container.remove(card)\n451\t    stack_zone.add(card)\n452\t\n453\t    # 3. Choose targets (with rollback on failure)\n454\t    try:\n455\t        target_specs = card.get_targets(game)\n456\t        chosen_targets: list[Any] = []\n457\t        if target_specs:\n458\t            for spec in target_specs:\n459\t                target = player.choose_target(target_specs, spec)\n460\t                # Validate against filter_fn if the spec provides one\n461\t                filter_fn = getattr(spec, \"filter_fn\", None)\n462\t                if filter_fn is not None and target is not None:\n463\t                    if not filter_fn(target):\n464\t                        raise CastingError(\n465\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n466\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n467\t                        )\n468\t                chosen_targets.append(target)\n469\t\n470\t        # Protection check — reject targets that have protection from this spell\n471\t        from engine.protection import has_protection_from\n472\t\n473\t        for target in chosen_targets:\n474\t            if has_protection_from(target, card):\n475\t                raise CastingError(\n476\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n477\t                )\n478\t    except Exception as exc:\n479\t        # Rollback: move card from stack zone back to source zone\n480\t        stack_zone.remove(card)\n481\t        source_zone_container.add(card)\n482\t        raise CastingError(str(exc)) from exc\n483\t\n484\t    # Free casts pay no mana, so the total mana spent is 0.\n485\t    card.mana_spent = 0  # type: ignore[attr-defined]\n486\t\n487\t    # 4. Call on_cast hook\n488\t    card.on_cast(game)\n489\t\n490\t    # 5. Build on_resolve callback and push StackObject\n491\t    stack_obj = StackObject(\n492\t        source=card,\n493\t        controller=player,\n494\t        targets=chosen_targets,\n495\t        on_resolve=lambda g: None,  # replaced below\n496\t        is_spell=True,\n497\t    )\n498\t\n499\t    def _on_resolve(g: GameState) -> None:\n500\t        _resolve_spell(g, card, player, stack_obj)\n501\t\n502\t    stack_obj.on_resolve = _on_resolve\n503\t    game.stack.push(stack_obj)\n504\t\n505\t\n506\t# ------------------------------------------------------------------\n507\t# Resolution (called when the stack pops)\n508\t# ------------------------------------------------------------------\n509\t\n510\tdef _resolve_spell(\n511\t    game: GameState,\n512\t    card: CardImpl,\n513\t    player: Player,\n514\t    stack_obj: StackObject,\n515\t) -> None:\n516\t    \"\"\"Resolve *card* cast by *player*.\n517\t\n518\t    1. Call ``card.on_resolve(game, targets=targets)``.\n519\t    2. Remove the card from the stack zone.\n520\t    3. If the card is a permanent type, move it to the battlefield via\n521\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n522\t       registration and the ETB event).\n523\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n524\t    \"\"\"\n525\t    from engine.zones import move_to_zone\n526\t\n527\t    # Read targets from the StackObject — the single source of truth.\n528\t    # Set chosen_targets on the card just before resolution so that\n529\t    # _get_chosen_target helpers (which read via getattr) work.\n530\t    targets = stack_obj.targets\n531\t    if targets is not None:\n532\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n533\t\n534\t    card.on_resolve(game)\n535\t\n536\t    if card.card_types & _PERMANENT_TYPES:\n537\t        # Move from stack to battlefield via move_to_zone, which handles\n538\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n539\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n540\t    else:\n541\t        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n542\t        # Some effects (e.g. The Dawning Archaic's free cast) attach a\n543\t        # per-spell replacement: \"If that spell would be put into your\n544\t        # graveyard, exile it instead.\" Honour that opt-in flag here.\n545\t        destination = Zone.GRAVEYARD\n546\t        if getattr(card, \"_exile_instead_of_graveyard\", False):\n547\t            destination = Zone.EXILE\n548\t            # One-shot replacement: clear the flag now that it has applied.\n549\t            try:\n550\t                del card._exile_instead_of_graveyard\n551\t            except AttributeError:  # pragma: no cover - defensive\n552\t                card._exile_instead_of_graveyard = False\n553\t        move_to_zone(game, card, Zone.STACK, destination)\n554\t\n555\t\n556\t# ------------------------------------------------------------------\n557\t# Play land (special action — does not use the stack)\n558\t# ------------------------------------------------------------------\n559\t\n560\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n561\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n562\t\n563\t    Requirements (all must hold):\n564\t\n565\t    * *land_card* has :attr:`CardType.LAND`.\n566\t    * *player* is the active player.\n567\t    * Current phase is a main phase.\n568\t    * The stack is empty.\n569\t    * ``player.land_plays_remaining > 0``.\n570\t    * The card is in the player's hand.\n571\t\n572\t    On success the card moves from hand to battlefield and\n573\t    ``land_plays_remaining`` is decremented.\n574\t\n575\t    Raises:\n576\t        CastingError: If any requirement is not met.\n577\t    \"\"\"\n578\t    # Must be a land\n579\t    if CardType.LAND not in land_card.card_types:\n580\t        raise CastingError(\n581\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n582\t        )\n583\t\n584\t    # Sorcery-speed timing (active player, main phase, stack empty)\n585\t    if not is_sorcery_speed(game, player):\n586\t        raise CastingError(\n587\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n588\t            \"during main phase with empty stack\"\n589\t        )\n590\t\n591\t    # Land plays remaining\n592\t    if player.land_plays_remaining <= 0:\n593\t        raise CastingError(\n594\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n595\t        )\n596\t\n597\t    # Card must be in hand\n598\t    hand = game.get_hand(player)\n599\t    if not hand.contains(land_card):\n600\t        raise CastingError(\n601\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n602\t        )\n603\t\n604\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n605\t    if land_card.owner is None:\n606\t        land_card.owner = player\n607\t    land_card.controller = player\n608\t\n609\t    # Move from hand to battlefield via move_to_zone, which fires\n610\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n611\t    from engine.zones import move_to_zone\n612\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n613\t\n614\t    # Decrement land plays\n615\t    player.land_plays_remaining -= 1\n616\t\n617\t\n618\tdef resolve_top(game: GameState) -> None:\n619\t    \"\"\"Resolve the top spell/ability on the stack.\n620\t\n621\t    Pops the top item from the stack, calls its on_resolve callback,\n622\t    then runs state-based actions.  If the stack is empty this is a no-op.\n623\t    \"\"\"\n624\t    if game.stack.is_empty():\n625\t        return\n626\t    from engine.state_based_actions import resolve_state_based_actions\n627\t\n628\t    obj = game.stack.pop()\n629\t    obj.on_resolve(game)\n630\t    resolve_state_based_actions(game)\n631\t"}]},"parent_tool_use_id":"toolu_01YGTm3RKSK2yGeCH6x1tUM8","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"77a441b9-64d7-449b-8d97-3a59cd80c5be","timestamp":"2026-06-02T02:05:41.915Z","subagent_type":"Implementer","task_description":"Implement sos_257 Great Hall + restricted mana"}
