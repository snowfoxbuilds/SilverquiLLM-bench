{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SS9vKV8H1fLM3Li9Kgp3Eu","type":"tool_result","content":"1\t\"\"\"Tests for SOS 1 — The Dawning Archaic.\n2\t\n3\tThe Dawning Archaic — {10} — Legendary Creature — Avatar — 7/7.\n4\t\n5\tOracle text:\n6\t- \"This spell costs {1} less to cast for each instant and sorcery card in\n7\t  your graveyard.\"  (cost reduction)\n8\t- \"Reach\"  (keyword)\n9\t- \"Whenever The Dawning Archaic attacks, you may cast target instant or\n10\t  sorcery card from your graveyard without paying its mana cost. If that\n11\t  spell would be put into your graveyard, exile it instead.\"\n12\t  (attack trigger + free cast from graveyard + replacement to exile)\n13\t\n14\tThese tests are written before the implementation (TDD red phase) and define\n15\tthe contract the implementation must satisfy. The mechanics mirror the\n16\treference card Etali, Primal Storm (FDN 194) for the attack-trigger /\n17\tfree-cast pattern, and the engine cost-reduction hook (CardImpl.cost_reduction).\n18\t\"\"\"\n19\t\n20\tfrom __future__ import annotations\n21\t\n22\timport pytest\n23\t\n24\tfrom cards.sos.sos_1.card_impl import TheDawningArchaic\n25\tfrom engine.card import Creature, Instant, Sorcery\n26\tfrom engine.casting import cast_spell, get_cost_reduction\n27\tfrom engine.events import AttacksTriggeredEvent\n28\tfrom engine.triggers import TriggerRegistration\n29\tfrom engine.types import (\n30\t    CardType,\n31\t    Keyword,\n32\t    ManaCost,\n33\t    ManaType,\n34\t    Phase,\n35\t    Supertype,\n36\t    Zone,\n37\t)\n38\tfrom test_utils import create_game, set_board_state\n39\t\n40\t\n41\t# ---------------------------------------------------------------------------\n42\t# Helpers\n43\t# ---------------------------------------------------------------------------\n44\t\n45\tdef _bolt(name: str = \"Lightning Bolt\") -> Instant:\n46\t    \"\"\"A cheap instant for graveyard fodder / free-cast targets.\"\"\"\n47\t    return Instant(name=name, mana_cost=ManaCost.parse(\"{R}\"))\n48\t\n49\t\n50\tdef _divination(name: str = \"Divination\") -> Sorcery:\n51\t    \"\"\"A cheap sorcery for graveyard fodder / free-cast targets.\"\"\"\n52\t    return Sorcery(name=name, mana_cost=ManaCost.parse(\"{2}{U}\"))\n53\t\n54\t\n55\tdef _bear(name: str = \"Grizzly Bears\") -> Creature:\n56\t    \"\"\"A vanilla creature used as a non-instant/sorcery graveyard occupant.\"\"\"\n57\t    return Creature(name=name, mana_cost=ManaCost.parse(\"{1}{G}\"),\n58\t                    base_power=2, base_toughness=2)\n59\t\n60\t\n61\t# ---------------------------------------------------------------------------\n62\t# Static card properties\n63\t# ---------------------------------------------------------------------------\n64\t\n65\tclass TestTheDawningArchaicProperties:\n66\t    \"\"\"Static card data should match the SOS 1 spec.\"\"\"\n67\t\n68\t    def test_name(self) -> None:\n69\t        assert TheDawningArchaic(owner=None).name == \"The Dawning Archaic\"\n70\t\n71\t    def test_mana_cost(self) -> None:\n72\t        assert TheDawningArchaic(owner=None).mana_cost == ManaCost.parse(\"{10}\")\n73\t\n74\t    def test_is_creature(self) -> None:\n75\t        card = TheDawningArchaic(owner=None)\n76\t        assert isinstance(card, Creature)\n77\t        assert CardType.CREATURE in card.card_types\n78\t\n79\t    def test_power_toughness(self) -> None:\n80\t        card = TheDawningArchaic(owner=None)\n81\t        assert card.base_power == 7\n82\t        assert card.base_toughness == 7\n83\t\n84\t    def test_legendary(self) -> None:\n85\t        assert Supertype.LEGENDARY in TheDawningArchaic(owner=None).supertypes\n86\t\n87\t    def test_avatar_subtype(self) -> None:\n88\t        assert \"Avatar\" in TheDawningArchaic(owner=None).subtypes\n89\t\n90\t    def test_has_reach(self) -> None:\n91\t        assert Keyword.REACH in TheDawningArchaic(owner=None).keywords\n92\t\n93\t    def test_is_colorless(self) -> None:\n94\t        \"\"\"A {10} cost has no colored pips — the card is colorless.\"\"\"\n95\t        cost = TheDawningArchaic(owner=None).mana_cost\n96\t        colored = {mt: n for mt, n in cost.pips.items() if mt != ManaType.COLORLESS}\n97\t        assert colored == {}\n98\t        assert cost.hybrid == []\n99\t\n100\t\n101\t# ---------------------------------------------------------------------------\n102\t# Cost reduction: {1} less for each instant/sorcery in your graveyard\n103\t# ---------------------------------------------------------------------------\n104\t\n105\tclass TestTheDawningArchaicCostReduction:\n106\t    \"\"\"cost_reduction counts instant + sorcery cards in the controller's\n107\t    graveyard. The engine clamps the reduction to the generic portion of the\n108\t    mana cost (here, the whole {10}).\"\"\"\n109\t\n110\t    def test_no_reduction_with_empty_graveyard(self) -> None:\n111\t        game = create_game()\n112\t        p1 = game.players[0]\n113\t        card = TheDawningArchaic(owner=p1, controller=p1)\n114\t        assert card.cost_reduction(game) == 0\n115\t\n116\t    def test_one_instant_reduces_by_one(self) -> None:\n117\t        game = create_game()\n118\t        p1 = game.players[0]\n119\t        set_board_state(game, 0, graveyard=[_bolt()])\n120\t        card = TheDawningArchaic(owner=p1, controller=p1)\n121\t        assert card.cost_reduction(game) == 1\n122\t\n123\t    def test_one_sorcery_reduces_by_one(self) -> None:\n124\t        game = create_game()\n125\t        p1 = game.players[0]\n126\t        set_board_state(game, 0, graveyard=[_divination()])\n127\t        card = TheDawningArchaic(owner=p1, controller=p1)\n128\t        assert card.cost_reduction(game) == 1\n129\t\n130\t    def test_mixed_instants_and_sorceries_sum(self) -> None:\n131\t        \"\"\"Three instants + two sorceries → reduction of 5.\"\"\"\n132\t        game = create_game()\n133\t        p1 = game.players[0]\n134\t        set_board_state(\n135\t            game, 0,\n136\t            graveyard=[_bolt(\"Bolt1\"), _bolt(\"Bolt2\"), _bolt(\"Bolt3\"),\n137\t                       _divination(\"Div1\"), _divination(\"Div2\")],\n138\t        )\n139\t        card = TheDawningArchaic(owner=p1, controller=p1)\n140\t        assert card.cost_reduction(game) == 5\n141\t\n142\t    def test_creatures_in_graveyard_do_not_reduce(self) -> None:\n143\t        \"\"\"Only instant/sorcery cards count — creatures are ignored.\"\"\"\n144\t        game = create_game()\n145\t        p1 = game.players[0]\n146\t        set_board_state(game, 0, graveyard=[_bear(\"B1\"), _bear(\"B2\")])\n147\t        card = TheDawningArchaic(owner=p1, controller=p1)\n148\t        assert card.cost_reduction(game) == 0\n149\t\n150\t    def test_only_instant_sorcery_among_mixed_graveyard_count(self) -> None:\n151\t        \"\"\"A graveyard with 1 instant + 1 sorcery + 2 creatures → reduction 2.\"\"\"\n152\t        game = create_game()\n153\t        p1 = game.players[0]\n154\t        set_board_state(\n155\t            game, 0,\n156\t            graveyard=[_bolt(), _divination(), _bear(\"B1\"), _bear(\"B2\")],\n157\t        )\n158\t        card = TheDawningArchaic(owner=p1, controller=p1)\n159\t        assert card.cost_reduction(game) == 2\n160\t\n161\t    def test_opponent_graveyard_does_not_reduce(self) -> None:\n162\t        \"\"\"Only *your* graveyard counts, not the opponent's.\"\"\"\n163\t        game = create_game()\n164\t        p1 = game.players[0]\n165\t        # Opponent (player 1) has instants/sorceries; controller's is empty.\n166\t        set_board_state(game, 1, graveyard=[_bolt(), _divination(), _bolt(\"B2\")])\n167\t        card = TheDawningArchaic(owner=p1, controller=p1)\n168\t        assert card.cost_reduction(game) == 0\n169\t\n170\t    def test_engine_clamps_reduction_to_generic(self) -> None:\n171\t        \"\"\"get_cost_reduction clamps the value to the generic portion (10).\n172\t        With more than 10 spells, the reduction is capped at 10.\"\"\"\n173\t        game = create_game()\n174\t        p1 = game.players[0]\n175\t        gy = [_bolt(f\"Bolt{i}\") for i in range(12)]\n176\t        set_board_state(game, 0, graveyard=gy)\n177\t        card = TheDawningArchaic(owner=p1, controller=p1)\n178\t        assert get_cost_reduction(game, card, p1) == 10\n179\t\n180\t    def test_cast_with_reduction_succeeds_with_reduced_mana(self) -> None:\n181\t        \"\"\"{10} with 4 instant/sorcery in graveyard → effective {6}.\n182\t        Six colorless mana should be exactly enough to cast it.\"\"\"\n183\t        game = create_game()\n184\t        p1 = game.players[0]\n185\t        set_board_state(\n186\t            game, 0,\n187\t            graveyard=[_bolt(\"B1\"), _bolt(\"B2\"), _divination(\"D1\"), _divination(\"D2\")],\n188\t        )\n189\t        card = TheDawningArchaic(owner=p1, controller=p1)\n190\t        set_board_state(game, 0, hand=[card], mana={ManaType.COLORLESS: 6})\n191\t        # Sorcery-speed timing for the engine cast_spell: active player,\n192\t        # main phase, empty stack.\n193\t        game.phase = Phase.PRECOMBAT_MAIN\n194\t        game.step = None\n195\t        cast_spell(game, p1, card)\n196\t        # Spell goes on the stack; resolve it so the creature lands.\n197\t        spell_obj = game.stack.pop()\n198\t        spell_obj.on_resolve(game)\n199\t        assert game.get_battlefield(p1).contains(card)\n200\t\n201\t    def test_cast_without_enough_reduction_fails(self) -> None:\n202\t        \"\"\"With an empty graveyard the full {10} is required; 6 mana is too few.\n203\t\n204\t        The failure must be due to *mana*, not timing or another incidental\n205\t        legality issue — otherwise a cost-reduction bug could slip through.\n206\t        \"\"\"\n207\t        from engine.casting import CastingError\n208\t\n209\t        game = create_game()\n210\t        p1 = game.players[0]\n211\t        card = TheDawningArchaic(owner=p1, controller=p1)\n212\t        # Empty graveyard, only 6 mana.\n213\t        set_board_state(game, 0, hand=[card], graveyard=[], mana={ManaType.COLORLESS: 6})\n214\t        game.phase = Phase.PRECOMBAT_MAIN\n215\t        game.step = None\n216\t        with pytest.raises(CastingError, match=\"insufficient mana\"):\n217\t            cast_spell(game, p1, card)\n218\t\n219\t\n220\t# ---------------------------------------------------------------------------\n221\t# Attack trigger registration\n222\t# ---------------------------------------------------------------------------\n223\t\n224\tclass TestTheDawningArchaicTriggerRegistration:\n225\t    \"\"\"register_triggers must wire an AttacksTriggeredEvent trigger keyed to\n226\t    this creature.\"\"\"\n227\t\n228\t    def test_registers_an_attacks_trigger(self) -> None:\n229\t        game = create_game()\n230\t        p1 = game.players[0]\n231\t        card = TheDawningArchaic(owner=p1, controller=p1)\n232\t        before = len(game.trigger_manager.get_triggers_for_source(card))\n233\t        card.register_triggers(game)\n234\t        after = game.trigger_manager.get_triggers_for_source(card)\n235\t        assert len(after) - before == 1\n236\t        assert after[0].event_type is AttacksTriggeredEvent\n237\t\n238\t    def test_trigger_condition_matches_this_creature(self) -> None:\n239\t        \"\"\"The trigger fires only when THIS creature attacks, not another.\"\"\"\n240\t        game = create_game()\n241\t        p1 = game.players[0]\n242\t        card = TheDawningArchaic(owner=p1, controller=p1)\n243\t        card.register_triggers(game)\n244\t        reg = game.trigger_manager.get_triggers_for_source(card)[0]\n245\t        # Condition should be present and reject an unrelated attacker.\n246\t        assert reg.condition is not None\n247\t        other = _bear(\"Some Other Attacker\")\n248\t        assert reg.condition(game, AttacksTriggeredEvent(creature=other, attacker=other)) is False\n249\t        assert reg.condition(game, AttacksTriggeredEvent(creature=card, attacker=card)) is True\n250\t\n251\t\n252\t# ---------------------------------------------------------------------------\n253\t# Attack trigger effect: free-cast an instant/sorcery from your graveyard\n254\t# ---------------------------------------------------------------------------\n255\t\n256\tclass TestTheDawningArchaicAttackEffect:\n257\t    \"\"\"The attack trigger lets you cast a chosen instant/sorcery from your\n258\t    graveyard without paying its mana cost. The chosen card goes onto the\n259\t    stack (free cast) and is removed from the graveyard.\"\"\"\n260\t\n261\t    def _fire_attack_trigger(self, game, card, *, yes=True, chosen=None):\n262\t        \"\"\"Register the trigger, fire AttacksTriggeredEvent, and resolve the\n263\t        single pushed StackObject. Scripts the controller's choices.\n264\t\n265\t        Returns nothing; the test inspects game state afterwards.\n266\t        \"\"\"\n267\t        controller = card.controller\n268\t        # The effect will ask whether to cast and which target to choose.\n269\t        # We seed the deterministic player's script with those answers.\n270\t        script_answers = []\n271\t        if chosen is not None:\n272\t            script_answers.append(yes)        # choose_yes_no — cast it?\n273\t            script_answers.append(chosen)     # choose_target / choose_card\n274\t        else:\n275\t            script_answers.append(yes)\n276\t        for ans in reversed(script_answers):\n277\t            controller._script.appendleft(ans)\n278\t\n279\t        card.register_triggers(game)\n280\t        game.trigger_manager.fire_event(\n281\t            game, AttacksTriggeredEvent(creature=card, attacker=card)\n282\t        )\n283\t        # Resolve the attack trigger StackObject (the \"may cast\" effect).\n284\t        assert not game.stack.is_empty(), \"attack trigger should push a StackObject\"\n285\t        trig = game.stack.pop()\n286\t        trig.on_resolve(game)\n287\t\n288\t    def test_chosen_instant_leaves_graveyard_onto_stack(self) -> None:\n289\t        game = create_game()\n290\t        p1 = game.players[0]\n291\t        bolt = _bolt()\n292\t        set_board_state(game, 0, graveyard=[bolt])\n293\t        card = TheDawningArchaic(owner=p1, controller=p1)\n294\t        set_board_state(game, 0, battlefield=[card])\n295\t\n296\t        self._fire_attack_trigger(game, card, yes=True, chosen=bolt)\n297\t\n298\t        # After the trigger resolves, the bolt should no longer be in the\n299\t        # graveyard — it has been put onto the stack as a free cast.\n300\t        assert not game.get_graveyard(p1).contains(bolt)\n301\t        # The free-cast spell is now on the stack.\n302\t        on_stack = [obj.source for obj in game.stack.objects()]\n303\t        assert bolt in on_stack\n304\t\n305\t    def test_free_cast_does_not_spend_mana(self) -> None:\n306\t        \"\"\"Casting from the graveyard via the trigger requires no mana —\n307\t        the controller's (empty) mana pool is untouched.\"\"\"\n308\t        game = create_game()\n309\t        p1 = game.players[0]\n310\t        bolt = _bolt()\n311\t        set_board_state(game, 0, graveyard=[bolt], mana={})\n312\t        card = TheDawningArchaic(owner=p1, controller=p1)\n313\t        set_board_state(game, 0, battlefield=[card])\n314\t\n315\t        self._fire_attack_trigger(game, card, yes=True, chosen=bolt)\n316\t\n317\t        # No mana of any type was paid.\n318\t        total = sum(p1.mana_pool.get(mt) for mt in ManaType)\n319\t        assert total == 0\n320\t        on_stack = [obj.source for obj in game.stack.objects()]\n321\t        assert bolt in on_stack\n322\t\n323\t    def test_chosen_sorcery_can_be_cast(self) -> None:\n324\t        game = create_game()\n325\t        p1 = game.players[0]\n326\t        div = _divination()\n327\t        set_board_state(game, 0, graveyard=[div])\n328\t        card = TheDawningArchaic(owner=p1, controller=p1)\n329\t        set_board_state(game, 0, battlefield=[card])\n330\t\n331\t        self._fire_attack_trigger(game, card, yes=True, chosen=div)\n332\t\n333\t        assert not game.get_graveyard(p1).contains(div)\n334\t        on_stack = [obj.source for obj in game.stack.objects()]\n335\t        assert div in on_stack\n336\t\n337\t    def test_may_declining_leaves_graveyard_untouched(self) -> None:\n338\t        \"\"\"The ability is optional (\"you may\"). Declining leaves the\n339\t        graveyard unchanged and nothing extra on the stack.\"\"\"\n340\t        game = create_game()\n341\t        p1 = game.players[0]\n342\t        bolt = _bolt()\n343\t        set_board_state(game, 0, graveyard=[bolt])\n344\t        card = TheDawningArchaic(owner=p1, controller=p1)\n345\t        set_board_state(game, 0, battlefield=[card])\n346\t\n347\t        self._fire_attack_trigger(game, card, yes=False, chosen=None)\n348\t\n349\t        # Declined: the instant stays in the graveyard.\n350\t        assert game.get_graveyard(p1).contains(bolt)\n351\t        # Nothing new on the stack (the trigger itself was already resolved).\n352\t        assert game.stack.is_empty()\n353\t\n354\t    def test_empty_graveyard_is_a_safe_noop(self) -> None:\n355\t        \"\"\"With no instant/sorcery in the graveyard the trigger resolves\n356\t        without error and casts nothing.\"\"\"\n357\t        game = create_game()\n358\t        p1 = game.players[0]\n359\t        set_board_state(game, 0, graveyard=[])\n360\t        card = TheDawningArchaic(owner=p1, controller=p1)\n361\t        set_board_state(game, 0, battlefield=[card])\n362\t\n363\t        controller = p1\n364\t        # Even if the engine asks \"may cast?\", a yes with no legal target\n365\t        # must not raise; seed a yes to be safe.\n366\t        controller._script.appendleft(True)\n367\t        card.register_triggers(game)\n368\t        game.trigger_manager.fire_event(\n369\t            game, AttacksTriggeredEvent(creature=card, attacker=card)\n370\t        )\n371\t        assert not game.stack.is_empty()\n372\t        trig = game.stack.pop()\n373\t        # Should resolve cleanly with nothing to cast.\n374\t        trig.on_resolve(game)\n375\t        assert game.stack.is_empty()\n376\t\n377\t\n378\t# ---------------------------------------------------------------------------\n379\t# Replacement: free-cast spell is exiled instead of going to the graveyard\n380\t# ---------------------------------------------------------------------------\n381\t\n382\tclass TestTheDawningArchaicExileReplacement:\n383\t    \"\"\"\"If that spell would be put into your graveyard, exile it instead.\"\n384\t    After the free-cast spell resolves, it should end up in exile, not the\n385\t    graveyard.\"\"\"\n386\t\n387\t    def _free_cast_and_resolve(self, game, card, spell):\n388\t        \"\"\"Fire the attack trigger choosing *spell*, then resolve the\n389\t        free-cast spell that lands on the stack.\"\"\"\n390\t        controller = card.controller\n391\t        controller._script.appendleft(spell)   # target/card choice\n392\t        controller._script.appendleft(True)     # choose_yes_no — cast it?\n393\t\n394\t        card.register_triggers(game)\n395\t        game.trigger_manager.fire_event(\n396\t            game, AttacksTriggeredEvent(creature=card, attacker=card)\n397\t        )\n398\t        # Resolve the trigger (the \"may cast\" effect) → spell goes on stack.\n399\t        trig = game.stack.pop()\n400\t        trig.on_resolve(game)\n401\t        # Now resolve the free-cast spell itself.\n402\t        assert not game.stack.is_empty(), \"free-cast spell should be on the stack\"\n403\t        spell_obj = game.stack.pop()\n404\t        spell_obj.on_resolve(game)\n405\t\n406\t    def test_resolved_free_cast_instant_goes_to_exile(self) -> None:\n407\t        game = create_game()\n408\t        p1 = game.players[0]\n409\t        bolt = _bolt()\n410\t        set_board_state(game, 0, graveyard=[bolt])\n411\t        card = TheDawningArchaic(owner=p1, controller=p1)\n412\t        set_board_state(game, 0, battlefield=[card])\n413\t\n414\t        self._free_cast_and_resolve(game, card, bolt)\n415\t\n416\t        # The spell should be exiled, NOT returned to the graveyard.\n417\t        assert game.get_exile(p1).contains(bolt)\n418\t        assert not game.get_graveyard(p1).contains(bolt)\n419\t\n420\t    def test_resolved_free_cast_sorcery_goes_to_exile(self) -> None:\n421\t        game = create_game()\n422\t        p1 = game.players[0]\n423\t        div = _divination()\n424\t        set_board_state(game, 0, graveyard=[div])\n425\t        card = TheDawningArchaic(owner=p1, controller=p1)\n426\t        set_board_state(game, 0, battlefield=[card])\n427\t\n428\t        self._free_cast_and_resolve(game, card, div)\n429\t\n430\t        assert game.get_exile(p1).contains(div)\n431\t        assert not game.get_graveyard(p1).contains(div)\n432\t"}]},"parent_tool_use_id":"toolu_01AUSULf5a3mm3JkXCS2zBdz","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"73a3d68e-1162-4e6b-babd-f2d176946121","timestamp":"2026-06-01T23:47:25.138Z","subagent_type":"Implementer","task_description":"Implement sos_1"}
