\t          \"path\": \"engine/casting.py\",\n98\t          \"summary\": \"cast_spell invokes new fully-gated _offer_casualty after pushing the spell StackObject: only when a caster-controlled permanent grants_casualty_to(spell) is non-None does it invoke that permanent's offer_casualty; default cast path unchanged when no grantor\"\n99\t        }\n100\t      ]\n101\t    },\n102\t    {\n103\t      \"card\": \"sos_4\",\n104\t      \"tests\": [\n105\t        {\n106\t          \"path\": \"cards/sos/sos_4/tests.py\",\n107\t          \"summary\": \"tests for sos_4 Together as One: properties, two target requirements (target player + any target), converge-driven draw/damage/life-gain, X=0 inert, safety, and end-to-end cast\"\n108\t        }\n109\t      ],\n110\t      \"implementation\": [\n111\t        {\n112\t          \"path\": \"cards/sos/sos_4/card_impl.py\",\n113\t          \"summary\": \"Together as One: Sorcery with converge X=len(colors_spent); target player draws X, deals X damage to any target, controller gains X life; X=0 is fully inert\"\n114\t        }\n115\t      ]\n116\t    },\n117\t    {\n118\t      \"card\": \"sos_57\",\n119\t      \"tests\": [\n120\t        {\n121\t          \"path\": \"cards/sos/sos_57/tests.py\",\n122\t          \"summary\": \"tests for sos_57 Mana Sculpt: properties, counter-target-spell targeting (any spell, rejects self, stack zone), unconditional counter to graveyard, Wizard gate, deferred {C}=mana_spent recorded, and not-added-immediately\"\n123\t        }\n124\t      ],\n125\t      \"implementation\": [\n126\t        {\n127\t          \"path\": \"cards/sos/sos_57/card_impl.py\",\n128\t          \"summary\": \"ManaSculpt Instant: counter target spell unconditionally (now keys off StackObject.is_spell marker so abilities are excluded); Wizard gate schedules one-shot deferred {C}=countered spell's mana_spent at controller's next precombat main\"\n129\t        },\n130\t        {\n131\t          \"path\": \"engine/stack.py\",\n132\t  