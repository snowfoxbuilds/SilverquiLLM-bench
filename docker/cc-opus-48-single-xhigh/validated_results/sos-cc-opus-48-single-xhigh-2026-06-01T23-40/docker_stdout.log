{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P1348P1mv56L3A67Uwt85H","type":"tool_result","content":"1\t\"\"\"Typed event objects for triggered abilities and replacement effects.\n2\t\n3\tTriggered events are passed to :meth:`TriggerManager.fire_event` and\n4\tforwarded to trigger condition callables.\n5\t\n6\tReplacement events are passed to :meth:`ReplacementManager.apply` and\n7\tforwarded to replacement condition/replacement callables.  Subclassing\n8\tencodes event-type hierarchy so a replacement registered for a parent\n9\ttype (e.g. ``MoveToGraveyardReplacementEvent``) also fires for\n10\tsubtypes (e.g. ``CreatureDiesReplacementEvent``).\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\tfrom dataclasses import dataclass\n16\tfrom typing import Any\n17\t\n18\t\n19\t# ---------------------------------------------------------------------------\n20\t# Triggered events\n21\t# ---------------------------------------------------------------------------\n22\t\n23\t@dataclass\n24\tclass TriggeredEvent:\n25\t    \"\"\"Base class for all triggered-ability events.\"\"\"\n26\t\n27\t\n28\t@dataclass\n29\tclass EntersBattlefieldTriggeredEvent(TriggeredEvent):\n30\t    permanent: Any = None\n31\t    controller: Any = None\n32\t    card: Any = None\n33\t    creature: Any = None\n34\t\n35\t\n36\t@dataclass\n37\tclass LeavesBattlefieldTriggeredEvent(TriggeredEvent):\n38\t    permanent: Any = None\n39\t    controller: Any = None\n40\t\n41\t\n42\t@dataclass\n43\tclass DealsDamageTriggeredEvent(TriggeredEvent):\n44\t    source: Any = None\n45\t    target: Any = None\n46\t    amount: int = 0\n47\t    is_combat: bool = False\n48\t    combat: bool = False\n49\t\n50\t\n51\t@dataclass\n52\tclass LosesLifeTriggeredEvent(TriggeredEvent):\n53\t    player: Any = None\n54\t    amount: int = 0\n55\t\n56\t\n57\t@dataclass\n58\tclass GainsLifeTriggeredEvent(TriggeredEvent):\n59\t    player: Any = None\n60\t    amount: int = 0\n61\t\n62\t\n63\t@dataclass\n64\tclass DrawsCardTriggeredEvent(TriggeredEvent):\n65\t    player: Any = None\n66\t    card: Any = None\n67\t\n68\t\n69\t@dataclass\n70\tclass BeginningOfUpkeepTriggeredEvent(TriggeredEvent):\n71\t    pass\n72\t\n73\t\n74\t@dataclass\n75\tclass BeginningOfCombatTriggeredEvent(TriggeredEvent):\n76\t    pass\n77\t\n78\t\n79\t@dataclass\n80\tclass BeginningOfMainPhaseTriggeredEvent(TriggeredEvent):\n81\t    \"\"\"Fired at the start of a main phase (after entering it).\n82\t\n83\t    Carries the active player (the player whose main phase is beginning,\n84\t    used as the controller for \"at the beginning of your next main phase\"\n85\t    delayed effects) and a flag distinguishing the precombat from the\n86\t    postcombat main phase.\n87\t\n88\t    Attributes:\n89\t        player: The active player whose main phase is beginning.\n90\t        controller: Alias of ``player`` (matches the naming used by other\n91\t            triggered events that carry a controller).\n92\t        precombat: ``True`` for the precombat main phase, ``False`` for the\n93\t            postcombat main phase.\n94\t    \"\"\"\n95\t\n96\t    player: Any = None\n97\t    controller: Any = None\n98\t    precombat: bool = True\n99\t\n100\t\n101\t@dataclass\n102\tclass EndOfTurnTriggeredEvent(TriggeredEvent):\n103\t    pass\n104\t\n105\t\n106\t@dataclass\n107\tclass EndStepTriggeredEvent(TriggeredEvent):\n108\t    player: Any = None\n109\t\n110\t\n111\t@dataclass\n112\tclass CreatureDiesTriggeredEvent(TriggeredEvent):\n113\t    creature: Any = None\n114\t    controller: Any = None\n115\t    owner: Any = None\n116\t\n117\t\n118\t@dataclass\n119\tclass SpellCastTriggeredEvent(TriggeredEvent):\n120\t    spell: Any = None\n121\t    player: Any = None\n122\t    card: Any = None\n123\t    controller: Any = None\n124\t\n125\t\n126\t@dataclass\n127\tclass AttacksTriggeredEvent(TriggeredEvent):\n128\t    creature: Any = None\n129\t    attacker: Any = None\n130\t\n131\t\n132\t@dataclass\n133\tclass BlocksTriggeredEvent(TriggeredEvent):\n134\t    creature: Any = None\n135\t\n136\t\n137\t@dataclass\n138\tclass CounterAddedTriggeredEvent(TriggeredEvent):\n139\t    permanent: Any = None\n140\t    counter_type: Any = None\n141\t    amount: int = 0\n142\t\n143\t\n144\t# ---------------------------------------------------------------------------\n145\t# Replacement events\n146\t# ---------------------------------------------------------------------------\n147\t\n148\t@dataclass\n149\tclass ReplacementEvent:\n150\t    \"\"\"Base class for all replacement-effect events.\"\"\"\n151\t\n152\t\n153\t@dataclass\n154\tclass MoveToGraveyardReplacementEvent(ReplacementEvent):\n155\t    \"\"\"Any permanent moving to a graveyard.\n156\t\n157\t    Subclass this for specific causes (destruction, sacrifice, etc.).\n158\t    A replacement registered for this type also fires for all subtypes.\n159\t\n160\t    ``destination`` may be mutated by a replacement to redirect the\n161\t    permanent to a different zone (``\"exile\"``, ``\"library\"``, ``\"hand\"``).\n162\t    Set ``prevented = True`` to signal that the replacement handled the\n163\t    zone move itself and the engine should skip its own move.\n164\t    \"\"\"\n165\t\n166\t    destination: str = \"graveyard\"\n167\t    controller: Any = None\n168\t    owner: Any = None\n169\t    prevented: bool = False\n170\t\n171\t    @property\n172\t    def card(self) -> Any:\n173\t        \"\"\"The object moving to the graveyard (overridden by subclasses).\"\"\"\n174\t        return None\n175\t\n176\t\n177\t@dataclass\n178\tclass CreatureDiesReplacementEvent(MoveToGraveyardReplacementEvent):\n179\t    \"\"\"A creature going to the graveyard via destruction or lethal damage.\"\"\"\n180\t\n181\t    creature: Any = None\n182\t\n183\t    @property\n184\t    def card(self) -> Any:\n185\t        return self.creature\n186\t\n187\t\n188\t@dataclass\n189\tclass PermanentDestroyedReplacementEvent(MoveToGraveyardReplacementEvent):\n190\t    \"\"\"A non-creature permanent going to the graveyard via destruction.\"\"\"\n191\t\n192\t    permanent: Any = None\n193\t\n194\t    @property\n195\t    def card(self) -> Any:\n196\t        return self.permanent\n197\t\n198\t\n199\t@dataclass\n200\tclass SacrificeReplacementEvent(MoveToGraveyardReplacementEvent):\n201\t    \"\"\"A permanent going to the graveyard via sacrifice.\"\"\"\n202\t\n203\t    permanent: Any = None\n204\t\n205\t    @property\n206\t    def card(self) -> Any:\n207\t        return self.permanent\n208\t\n209\t\n210\t@dataclass\n211\tclass CreateTokenReplacementEvent(ReplacementEvent):\n212\t    \"\"\"An effect about to create one or more tokens.\"\"\"\n213\t\n214\t    player: Any = None\n215\t    count: int = 1\n216\t\n217\t\n218\t@dataclass\n219\tclass AddCounterReplacementEvent(ReplacementEvent):\n220\t    \"\"\"An effect about to add one or more counters to a permanent.\"\"\"\n221\t\n222\t    permanent: Any = None\n223\t    amount: int = 1\n224\t"}]},"parent_tool_use_id":"toolu_01YGTm3RKSK2yGeCH6x1tUM8","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"61fb9fc0-9745-4ff0-b492-b2b4cd43e2b2","timestamp":"2026-06-02T02:05:45.474Z","subagent_type":"Implementer","task_description":"Implement sos_257 Great Hall + restricted mana"}
{"type":"system","subtype":"task_progress","task_id":"ae701aa76180e583a","tool_use_id":"toolu_01YGTm3RKSK2yGeCH6x1tUM8","description":"Reading engine/triggers.py","subagent_type":"Implementer","usage":{"total_tokens":74672,"tool_uses":19,"duration_ms":37905},"last_tool_name":"Read","uuid":"2270f47a-f7c0-4e0d-881c-10b2bf9a25e1","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145"}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01KJjWHj38MSqfE5PKJRE1Qb","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KmUrq72gYEE7LhxhuuFhwk","name":"Read","input":{"file_path":"/workspace/engine/triggers.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2745,"cache_read_input_tokens":71726,"cache_creation":{"ephemeral_5m_input_tokens":2745,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01YGTm3RKSK2yGeCH6x1tUM8","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"5703b7f5-573c-40cf-bbfd-19b7430f87d1","request_id":"req_011CbdcbZS3CtMMeHmPez3g7","subagent_type":"Implementer","task_description":"Implement sos_257 Great Hall + restricted mana"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KmUrq72gYEE7LhxhuuFhwk","type":"tool_result","content":"1\t\"\"\"Triggered abilities system — event-driven trigger registration and firing.\n2\t\n3\tProvides the core mechanism for registering triggered abilities and firing\n4\tevents that push matching triggers onto the stack:\n5\t\n6\t- :class:`TriggerRegistration` — dataclass describing a single trigger.\n7\t- :class:`TriggerManager` — central registry for triggers with APNAP-ordered\n8\t  event firing.\n9\t\n10\tEvent types live in :mod:`engine.events` as typed dataclasses.\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\tfrom dataclasses import dataclass, field\n16\tfrom typing import TYPE_CHECKING, Any, Callable\n17\t\n18\tfrom engine.events import TriggeredEvent\n19\tfrom engine.stack import StackObject\n20\t\n21\tif TYPE_CHECKING:\n22\t    from engine.game_state import GameState\n23\t    from engine.player import Player\n24\t\n25\t\n26\t@dataclass\n27\tclass TriggerRegistration:\n28\t    \"\"\"Describes a single triggered ability.\n29\t\n30\t    Attributes:\n31\t        event_type: The event class (or a base class) this trigger watches.\n32\t            The trigger fires for any fired event that is an instance of\n33\t            this class, including instances of subclasses.\n34\t        condition: Optional callable ``(game, event) -> bool`` that must\n35\t            return ``True`` for the trigger to fire.  ``None`` means the\n36\t            trigger always fires for its event type.\n37\t        effect: Callable ``(game) -> None`` executed when the trigger\n38\t            resolves (becomes the :attr:`StackObject.on_resolve` callback).\n39\t        source: The game object (card / permanent) that owns this trigger.\n40\t        controller: The player who controls the source at the time of\n41\t            registration.\n42\t    \"\"\"\n43\t\n44\t    event_type: type[TriggeredEvent]\n45\t    condition: Callable[..., bool] | None\n46\t    effect: Callable[..., None]\n47\t    source: Any\n48\t    controller: Player\n49\t\n50\t\n51\tclass TriggerManager:\n52\t    \"\"\"Central registry for triggered abilities.\n53\t\n54\t    Triggers are registered when a permanent enters the battlefield (or\n55\t    via other game actions) and unregistered when the source leaves.\n56\t\n57\t    :meth:`fire_event` checks all registered triggers of a matching\n58\t    event type, evaluates their conditions, and pushes matching triggers\n59\t    onto the game stack as :class:`StackObject` instances.  Triggers are\n60\t    ordered according to APNAP (Active Player, Non-Active Player):\n61\t\n62\t    * Active player's triggers are pushed first (end up on the bottom\n63\t      of the batch).\n64\t    * Non-active player's triggers are pushed second (end up on top).\n65\t    * Within the same player, triggers are pushed in registration order\n66\t      (controller would normally choose; for now we use registration\n67\t      order as a deterministic default).\n68\t    \"\"\"\n69\t\n70\t    def __init__(self) -> None:\n71\t        self._triggers: list[TriggerRegistration] = []\n72\t\n73\t    def register(self, trigger: TriggerRegistration) -> None:\n74\t        \"\"\"Register a triggered ability.\"\"\"\n75\t        self._triggers.append(trigger)\n76\t\n77\t    def unregister(self, source: Any) -> None:\n78\t        \"\"\"Remove all triggers registered by *source* (identity-based).\"\"\"\n79\t        self._triggers = [t for t in self._triggers if t.source is not source]\n80\t\n81\t    def fire_event(self, game: GameState, event: TriggeredEvent) -> None:\n82\t        \"\"\"Fire an event and push all matching triggers onto the stack.\n83\t\n84\t        Parameters:\n85\t            game: The current game state.\n86\t            event: The typed event object.  Triggers registered for the\n87\t                event's class or any of its parent classes will fire.\n88\t\n89\t        Matching triggers are pushed in APNAP order:\n90\t\n91\t        1. Active player's matching triggers (in registration order).\n92\t        2. Non-active player's matching triggers (in registration order).\n93\t        \"\"\"\n94\t        # Deliver one-shot deferred effects scheduled for \"the beginning of\n95\t        # your next main phase\". These run directly (not via the stack) so\n96\t        # that firing the event makes the scheduled effect observable\n97\t        # immediately, mirroring how delayed riders resolve. Additive.\n98\t        from engine.events import BeginningOfMainPhaseTriggeredEvent\n99\t\n100\t        if isinstance(event, BeginningOfMainPhaseTriggeredEvent):\n101\t            from engine.deferred import deliver_main_phase_deferred_effects\n102\t\n103\t            deliver_main_phase_deferred_effects(game, event)\n104\t\n105\t        matching: list[TriggerRegistration] = []\n106\t        for trigger in self._triggers:\n107\t            if not isinstance(event, trigger.event_type):\n108\t                continue\n109\t            if trigger.condition is not None:\n110\t                if not trigger.condition(game, event):\n111\t                    continue\n112\t            matching.append(trigger)\n113\t\n114\t        if not matching:\n115\t            return\n116\t\n117\t        active_player = game.active_player\n118\t        active_triggers: list[TriggerRegistration] = []\n119\t        non_active_triggers: list[TriggerRegistration] = []\n120\t\n121\t        for trigger in matching:\n122\t            if trigger.controller is active_player:\n123\t                active_triggers.append(trigger)\n124\t            else:\n125\t                non_active_triggers.append(trigger)\n126\t\n127\t        ordered = active_triggers + non_active_triggers\n128\t\n129\t        for trigger in ordered:\n130\t            stack_obj = StackObject(\n131\t                source=trigger.source,\n132\t                controller=trigger.controller,\n133\t                on_resolve=trigger.effect,\n134\t            )\n135\t            game.stack.push(stack_obj)\n136\t\n137\t    def get_triggers(self) -> list[TriggerRegistration]:\n138\t        \"\"\"Return a shallow copy of all registered triggers.\"\"\"\n139\t        return list(self._triggers)\n140\t\n141\t    def get_triggers_for_source(self, source: Any) -> list[TriggerRegistration]:\n142\t        \"\"\"Return all triggers registered by *source* (identity-based).\"\"\"\n143\t        return [t for t in self._triggers if t.source is source]\n144\t\n145\t    def clear(self) -> None:\n146\t        \"\"\"Remove all registered triggers.\"\"\"\n147\t        self._triggers.clear()\n148\t"}]},"parent_tool_use_id":"toolu_01YGTm3RKSK2yGeCH6x1tUM8","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"f063769a-6c3f-485f-90f0-8f43fd7a87e8","timestamp":"2026-06-02T02:05:48.253Z","subagent_type":"Implementer","task_description":"Implement sos_257 Great Hall + restricted mana"}
