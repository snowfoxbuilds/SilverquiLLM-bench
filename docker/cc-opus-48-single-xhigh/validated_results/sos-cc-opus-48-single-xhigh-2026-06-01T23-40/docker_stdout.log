{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YaCJXSdqy4oDwdfRh2YqEG","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_13/card_impl.py b/cards/sos/sos_13/card_impl.py\n2\tindex 765fb45..c42437b 100644\n3\t--- a/cards/sos/sos_13/card_impl.py\n4\t+++ b/cards/sos/sos_13/card_impl.py\n5\t@@ -1,16 +1,256 @@\n6\t-\"\"\"Card implementation for Emeritus of Truce // Swords to Plowshares.\"\"\"\n7\t+\"\"\"Card implementation for Emeritus of Truce // Swords to Plowshares (SOS #13).\n8\t+\n9\t+This is a *preparation card* (CR 722).  The front face is the creature\n10\t+**Emeritus of Truce** ({1}{W}{W}, 3/3 Cat Cleric) and the inset \"prepare\n11\t+spell\" is **Swords to Plowshares** ({W} instant — exile target creature, its\n12\t+controller gains life equal to its power).\n13\t+\n14\t+The engine has no native \"Prepared\" designation, so this implementation models\n15\t+the mechanic with a small, additive, card-local surface (mandated by the\n16\t+coordinator directives):\n17\t+\n18\t+* ``prepared`` — a boolean attribute (default ``False``); also exposed via the\n19\t+  read-only ``is_prepared`` alias property.  Set ``True`` during ETB resolution\n20\t+  only when an opponent controls strictly more creatures than the controller,\n21\t+  evaluated *after* the Inkling token is created (CR 722.3a).\n22\t+* ``make_prepare_spell(game)`` — factory returning a castable Swords to\n23\t+  Plowshares :class:`~engine.card.Instant` whose resolution exiles its chosen\n24\t+  target creature and grants THAT creature's controller life equal to the\n25\t+  exiled creature's power.  A no-target resolution is a safe no-op.\n26\t+* ``cast_prepare_spell(game, target=...)`` — requires ``prepared is True``,\n27\t+  casts/resolves a fresh copy of the prepare spell \"without paying its mana\n28\t+  cost\", then unprepares the permanent (``prepared = False``) per CR 722.3c.\n29\t+\"\"\"\n30\t \n31\t from __future__ import annotations\n32\t \n33\t-from engine.card import CardImpl\n34\t+from typing import TYPE_CHECKING, Any\n35\t \n36\t-from typing import TYPE_CHECKING\n37\t+from engine.card import Creature, Instant\n38\t+from engine.types import CardType, Keyword, ManaCost, Zone\n39\t \n40\t if TYPE_CHECKING:\n41\t     from engine.game_state import GameState\n42\t \n43\t \n44\t-class EmeritusOfTruceSwordsToPlowshares(CardImpl):\n45\t-    \"\"\"TODO: Implement Emeritus of Truce // Swords to Plowshares.\"\"\"\n46\t+def _is_creature(obj: Any) -> bool:\n47\t+    \"\"\"Return ``True`` if *obj* is a creature object.\"\"\"\n48\t+    return CardType.CREATURE in getattr(obj, \"card_types\", set())\n49\t+\n50\t+\n51\t+class SwordsToPlowshares(Instant):\n52\t+    \"\"\"Swords to Plowshares — {W} Instant (the inset prepare spell).\n53\t+\n54\t+    \"Exile target creature. Its controller gains life equal to its power.\"\n55\t+\n56\t+    The target is read from :attr:`chosen_targets`.  Resolving with no chosen\n57\t+    target is a safe no-op (no exile, no life change, no raise).\n58\t+    \"\"\"\n59\t+\n60\t+    def __init__(self, **kwargs: Any) -> None:\n61\t+        kwargs.setdefault(\"name\", \"Swords to Plowshares\")\n62\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{W}\"))\n63\t+        kwargs.setdefault(\n64\t+            \"rules_text\",\n65\t+            \"Exile target creature. Its controller gains life equal to its power.\",\n66\t+        )\n67\t+        super().__init__(**kwargs)\n68\t+        # Single-letter color identity (the engine has no native colors field).\n69\t+        self.colors: list[str] = [\"W\"]\n70\t+\n71\t+    def on_resolve(self, game: \"GameState\") -> None:\n72\t+        \"\"\"Exile the target creature; its controller gains life equal to power.\"\"\"\n73\t+        from engine.game import exile\n74\t+\n75\t+        targets = getattr(self, \"chosen_targets\", None) or []\n76\t+        victim = targets[0] if targets else None\n77\t+        if victim is None or not _is_creature(victim):\n78\t+            # No legal target — safe no-op.\n79\t+            return\n80\t+\n81\t+        # Snapshot power and controller before the creature leaves play.\n82\t+        power = getattr(victim, \"power\", getattr(victim, \"base_power\", 0)) or 0\n83\t+        victim_controller = getattr(victim, \"controller\", None)\n84\t+\n85\t+        exile(game, victim)\n86\t+\n87\t+        if victim_controller is not None and hasattr(victim_controller, \"life\"):\n88\t+            victim_controller.life += power\n89\t+\n90\t+\n91\t+class EmeritusOfTruceSwordsToPlowshares(Creature):\n92\t+    \"\"\"Emeritus of Truce — {1}{W}{W} — 3/3 — Creature — Cat Cleric.\n93\t+\n94\t+    When this creature enters, target player creates a 1/1 white and black\n95\t+    Inkling creature token with flying.  Then if an opponent controls more\n96\t+    creatures than you, this creature becomes prepared.  (While it's prepared,\n97\t+    you may cast a copy of its spell. Doing so unprepares it.)\n98\t+\n99\t+    SOS collector number 13 (preparation-card reference slot, CR 722).\n100\t+    \"\"\"\n101\t+\n102\t+    def __init__(self, **kwargs: Any) -> None:\n103\t+        kwargs.setdefault(\"name\", \"Emeritus of Truce // Swords to Plowshares\")\n104\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{W}{W}\"))\n105\t+        kwargs.setdefault(\"subtypes\", {\"Cat\", \"Cleric\"})\n106\t+        kwargs.setdefault(\"keywords\", Keyword(0))\n107\t+        kwargs.setdefault(\"base_power\", 3)\n108\t+        kwargs.setdefault(\"base_toughness\", 3)\n109\t+        kwargs.setdefault(\n110\t+            \"rules_text\",\n111\t+            \"When this creature enters, target player creates a 1/1 white and \"\n112\t+            \"black Inkling creature token with flying. Then if an opponent \"\n113\t+            \"controls more creatures than you, this creature becomes prepared. \"\n114\t+            \"(While it's prepared, you may cast a copy of its spell. Doing so \"\n115\t+            \"unprepares it.)\",\n116\t+        )\n117\t+        super().__init__(**kwargs)\n118\t+        # The engine has no native colors field — expose the front face's color.\n119\t+        self.colors: list[str] = [\"W\"]\n120\t+        # Preparation designation (CR 722.3a); default unprepared.\n121\t+        self.prepared: bool = False\n122\t+\n123\t+    # ------------------------------------------------------------------\n124\t+    # Prepared designation\n125\t+    # ------------------------------------------------------------------\n126\t+\n127\t+    @property\n128\t+    def is_prepared(self) -> bool:\n129\t+        \"\"\"Read-only alias for :attr:`prepared` (CR 722 'prepared' marker).\"\"\"\n130\t+        return self.prepared\n131\t+\n132\t+    # ------------------------------------------------------------------\n133\t+    # ETB trigger: token creation + becomes-prepared comparison\n134\t+    # ------------------------------------------------------------------\n135\t+\n136\t+    def register_triggers(self, game: \"GameState\") -> None:\n137\t+        \"\"\"Register the enters-the-battlefield triggered ability.\"\"\"\n138\t+        from engine.events import EntersBattlefieldTriggeredEvent\n139\t+        from engine.triggers import TriggerRegistration\n140\t+\n141\t+        source = self\n142\t+\n143\t+        def _condition(game: Any, event: Any) -> bool:\n144\t+            return getattr(event, \"permanent\", None) is source\n145\t+\n146\t+        def _effect(game: \"GameState\") -> None:\n147\t+            self._resolve_etb(game)\n148\t+\n149\t+        controller = getattr(self, \"controller\", None) or game.active_player\n150\t+        game.trigger_manager.register(\n151\t+            TriggerRegistration(\n152\t+                event_type=EntersBattlefieldTriggeredEvent,\n153\t+                condition=_condition,\n154\t+                effect=_effect,\n155\t+                source=self,\n156\t+                controller=controller,\n157\t+            )\n158\t+        )\n159\t+\n160\t+    def _resolve_etb(self, game: \"GameState\") -> None:\n161\t+        \"\"\"Resolve the ETB: create the Inkling token, then check prepared.\n162\t+\n163\t+        The token is created BEFORE the \"more creatures than you\" comparison,\n164\t+        so a token given to an opponent counts toward that opponent's total.\n165\t+        \"\"\"\n166\t+        from engine.game import create_token\n167\t+\n168\t+        controller = getattr(self, \"controller\", None)\n169\t+        if controller is None:\n170\t+            return\n171\t+\n172\t+        # 1. Target player creates a 1/1 white-and-black Inkling with flying.\n173\t+        targets = getattr(self, \"chosen_targets\", None) or []\n174\t+        target_player = targets[0] if targets else controller\n175\t+\n176\t+        token = Creature(\n177\t+            name=\"Inkling\",\n178\t+            subtypes={\"Inkling\"},\n179\t+            keywords=Keyword.FLYING,\n180\t+            base_power=1,\n181\t+            base_toughness=1,\n182\t+        )\n183\t+        token.colors = [\"W\", \"B\"]\n184\t+        create_token(game, target_player, token)\n185\t+\n186\t+        # 2. Then if an opponent controls more creatures than you, prepare.\n187\t+        if self._opponent_controls_more_creatures(game, controller):\n188\t+            self.prepared = True\n189\t+\n190\t+    @staticmethod\n191\t+    def _creature_count(game: \"GameState\", player: Any) -> int:\n192\t+        \"\"\"Number of creatures *player* controls on the battlefield.\"\"\"\n193\t+        return sum(\n194\t+            1\n195\t+            for obj in game.get_battlefield(player).get_all()\n196\t+            if _is_creature(obj)\n197\t+        )\n198\t+\n199\t+    def _opponent_controls_more_creatures(\n200\t+        self, game: \"GameState\", controller: Any\n201\t+    ) -> bool:\n202\t+        \"\"\"Return ``True`` iff some opponent controls strictly more creatures.\n203\t+\n204\t+        Standard MTG counting (CR 722.3a, evaluated when the ETB resolves): the\n205\t+        entering Emeritus is on the battlefield, so it counts toward \"you\" (the\n206\t+        controller), as does the just-created Inkling token if it was given to\n207\t+        you.  Tokens count for whoever controls them.  Each opponent's count\n208\t+        includes every creature they control (including a token granted to\n209\t+        them).  \"More than\" is strict ``>``.\n210\t+        \"\"\"\n211\t+        my_count = self._creature_count(game, controller)\n212\t+        for player in game.players:\n213\t+            if player is controller:\n214\t+                continue\n215\t+            if self._creature_count(game, player) > my_count:\n216\t+                return True\n217\t+        return False\n218\t+\n219\t+    # ------------------------------------------------------------------\n220\t+    # Prepare spell — Swords to Plowshares\n221\t+    # ------------------------------------------------------------------\n222\t+\n223\t+    def make_prepare_spell(self, game: \"GameState\") -> SwordsToPlowshares:\n224\t+        \"\"\"Return a castable copy of the Swords to Plowshares prepare spell.\n225\t+\n226\t+        The copy's controller/owner default to this permanent's controller\n227\t+        (CR 722.3c: the prepared permanent's controller may cast the copy).\n228\t+        \"\"\"\n229\t+        controller = getattr(self, \"controller\", None)\n230\t+        owner = getattr(self, \"owner\", None) or controller\n231\t+        spell = SwordsToPlowshares(owner=owner, controller=controller)\n232\t+        return spell\n233\t+\n234\t+    # ------------------------------------------------------------------\n235\t+    # Cast-while-prepared + unprepare (CR 722.3c)\n236\t+    # ------------------------------------------------------------------\n237\t+\n238\t+    def cast_prepare_spell(\n239\t+        self,\n240\t+        game: \"GameState\",\n241\t+        target: Any | None = None,\n242\t+    ) -> SwordsToPlowshares:\n243\t+        \"\"\"Cast a copy of the prepare spell (free), then unprepare.\n244\t+\n245\t+        Requires :attr:`prepared` to be ``True`` (raises otherwise).  Resolves\n246\t+        a fresh Swords to Plowshares copy against *target* (read from\n247\t+        ``chosen_targets`` if not given) \"without paying its mana cost\", then\n248\t+        clears the prepared designation (CR 722.3c).\n249\t+\n250\t+        Returns the resolved prepare-spell object.\n251\t+        \"\"\"\n252\t+        if not self.prepared:\n253\t+            raise ValueError(\n254\t+                \"Emeritus of Truce is not prepared; cannot cast its prepare spell.\"\n255\t+            )\n256\t+\n257\t+        spell = self.make_prepare_spell(game)\n258\t+        if target is not None:\n259\t+            spell.chosen_targets = [target]\n260\t+\n261\t+        # The copy is cast \"without paying its mana cost\"; resolve it directly.\n262\t+        spell.on_resolve(game)\n263\t \n264\t-    pass\n265\t+        # Casting the prepare spell unprepares the permanent (CR 722.3c).\n266\t+        self.prepared = False\n267\t+        return spell\n268\t"}]},"parent_tool_use_id":"toolu_018joPD2pbTUDWvHehg7gDJr","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"e6f3b347-053a-4800-9a31-cbb5d86128c3","timestamp":"2026-06-02T00:18:43.054Z","subagent_type":"Reviewer","task_description":"Review sos_13 implementation"}
