{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FQsbzqHAkWCMMSq95vzswe","type":"tool_result","content":"1\t\"\"\"Card implementation for Great Hall of the Biblioplex (SOS 257).\n2\t\n3\tGreat Hall of the Biblioplex — Land:\n4\t\n5\t    {T}: Add {C}.\n6\t    {T}, Pay 1 life: Add one mana of any color. Spend this mana only to cast\n7\t        an instant or sorcery spell.\n8\t    {5}: If this land isn't a creature, it becomes a 2/4 Wizard creature with\n9\t        \"Whenever you cast an instant or sorcery spell, this creature gets\n10\t        +1/+0 until end of turn.\" It's still a land.\n11\t\n12\tDesign notes\n13\t------------\n14\t* The \"Spend this mana only to cast an instant or sorcery spell\" rider is\n15\t  modelled with the additive restricted-mana surface on ``engine.mana.ManaPool``:\n16\t  the any-color ability adds mana via ``add_restricted(..., restriction=\n17\t  RESTRICTION_INSTANT_SORCERY)``, and ``engine.casting`` consults the\n18\t  restriction when paying so the mana can only pay for instants/sorceries.\n19\t* This is a ``Land`` (never a ``Creature`` subclass), so it tracks its own\n20\t  ``power`` / ``toughness`` directly. Animation sets base P/T and adds\n21\t  ``CardType.CREATURE`` while KEEPING ``CardType.LAND``; the per-cast pump\n22\t  adds an until-end-of-turn power bonus. Both are idempotent on the\n23\t  becomes-a-creature gate (\"If this land isn't a creature\").\n24\t\"\"\"\n25\t\n26\tfrom __future__ import annotations\n27\t\n28\tfrom typing import TYPE_CHECKING, Any\n29\t\n30\tfrom engine.card import ActivatedAbility, Land, ManaAbility\n31\tfrom engine.events import SpellCastTriggeredEvent\n32\tfrom engine.mana import RESTRICTION_INSTANT_SORCERY\n33\tfrom engine.triggers import TriggerRegistration\n34\tfrom engine.types import CardType, ManaCost, ManaType\n35\t\n36\tif TYPE_CHECKING:\n37\t    from engine.game_state import GameState\n38\t\n39\t\n40\t_ANY_COLORS = (\n41\t    ManaType.WHITE,\n42\t    ManaType.BLUE,\n43\t    ManaType.BLACK,\n44\t    ManaType.RED,\n45\t    ManaType.GREEN,\n46\t)\n47\t\n48\t\n49\tclass GreatHallOfTheBiblioplex(Land):\n50\t    \"\"\"Great Hall of the Biblioplex — Land.\n51\t\n52\t    SOS collector number 257.\n53\t    \"\"\"\n54\t\n55\t    def __init__(self, **kwargs: Any) -> None:\n56\t        kwargs.setdefault(\"name\", \"Great Hall of the Biblioplex\")\n57\t        kwargs.setdefault(\n58\t            \"rules_text\",\n59\t            \"{T}: Add {C}.\\n\"\n60\t            \"{T}, Pay 1 life: Add one mana of any color. Spend this mana only \"\n61\t            \"to cast an instant or sorcery spell.\\n\"\n62\t            \"{5}: If this land isn't a creature, it becomes a 2/4 Wizard \"\n63\t            'creature with \"Whenever you cast an instant or sorcery spell, '\n64\t            'this creature gets +1/+0 until end of turn.\" It\\'s still a land.',\n65\t        )\n66\t        super().__init__(**kwargs)\n67\t        # Colorless land — explicit colors attribute (KEY_DECISIONS convention).\n68\t        self.colors: list[str] = []\n69\t        # Animation state. Until the {5} ability resolves, the land is not a\n70\t        # creature and has no power/toughness.\n71\t        self._is_animated: bool = False\n72\t        self._base_power: int = 0\n73\t        self._base_toughness: int = 0\n74\t        # Until-end-of-turn +1/+0 pump accumulator from the cast trigger.\n75\t        self._power_bonus: int = 0\n76\t        # Guard so register_triggers wires the cast trigger at most once.\n77\t        self._cast_trigger_registered: bool = False\n78\t\n79\t    # ------------------------------------------------------------------\n80\t    # Power / toughness (only meaningful once animated)\n81\t    # ------------------------------------------------------------------\n82\t\n83\t    @property\n84\t    def power(self) -> int:\n85\t        \"\"\"Current power (base + until-end-of-turn pump). 0 before animation.\"\"\"\n86\t        return self._base_power + self._power_bonus\n87\t\n88\t    @property\n89\t    def toughness(self) -> int:\n90\t        \"\"\"Current toughness. 0 before animation.\"\"\"\n91\t        return self._base_toughness\n92\t\n93\t    # ------------------------------------------------------------------\n94\t    # Mana abilities\n95\t    # ------------------------------------------------------------------\n96\t\n97\t    def get_mana_abilities(self) -> list[ManaAbility]:\n98\t        source = self\n99\t\n100\t        def _tap_cost(game: Any, src: Any) -> bool:\n101\t            if getattr(src, \"is_tapped\", False):\n102\t                return False\n103\t            src.is_tapped = True\n104\t            return True\n105\t\n106\t        def _tap_and_pay_life_cost(game: Any, src: Any) -> bool:\n107\t            # Atomic: if the tap cannot be paid, do NOT pay life.\n108\t            if getattr(src, \"is_tapped\", False):\n109\t                return False\n110\t            src.is_tapped = True\n111\t            controller = src.controller\n112\t            if controller is not None:\n113\t                controller.life -= 1\n114\t            return True\n115\t\n116\t        def _add_colorless(game: Any) -> None:\n117\t            controller = source.controller\n118\t            if controller is not None:\n119\t                controller.mana_pool.add(ManaType.COLORLESS, 1)\n120\t\n121\t        def _add_any_color(game: Any) -> None:\n122\t            controller = source.controller\n123\t            if controller is None:\n124\t                return\n125\t            chosen = controller.choose(\n126\t                list(_ANY_COLORS),\n127\t                \"Choose a color of mana to produce\",\n128\t            )\n129\t            # The produced mana may be spent only to cast an instant or sorcery\n130\t            # spell — tag it with the restriction so engine.casting enforces it.\n131\t            controller.mana_pool.add_restricted(\n132\t                chosen, 1, restriction=RESTRICTION_INSTANT_SORCERY\n133\t            )\n134\t\n135\t        return [\n136\t            ManaAbility(\n137\t                cost=_tap_cost,\n138\t                mana_produced=_add_colorless,\n139\t                description=\"{T}: Add {C}.\",\n140\t            ),\n141\t            ManaAbility(\n142\t                cost=_tap_and_pay_life_cost,\n143\t                mana_produced=_add_any_color,\n144\t                description=(\n145\t                    \"{T}, Pay 1 life: Add one mana of any color. Spend this \"\n146\t                    \"mana only to cast an instant or sorcery spell.\"\n147\t                ),\n148\t            ),\n149\t        ]\n150\t\n151\t    # ------------------------------------------------------------------\n152\t    # {5}: become a 2/4 Wizard creature (still a land)\n153\t    # ------------------------------------------------------------------\n154\t\n155\t    def get_activated_abilities(self) -> list[ActivatedAbility]:\n156\t        source = self\n157\t\n158\t        def _pay_five(game: Any, src: Any) -> bool:\n159\t            controller = src.controller\n160\t            if controller is None:\n161\t                return False\n162\t            cost = ManaCost(generic=5)\n163\t            if not controller.mana_pool.can_pay(cost):\n164\t                return False\n165\t            return controller.mana_pool.pay(cost)\n166\t\n167\t        def _animate(game: Any) -> None:\n168\t            # \"If this land isn't a creature\" — gate so a second resolution\n169\t            # does not stack additional power/toughness.\n170\t            if source._is_animated or CardType.CREATURE in source.card_types:\n171\t                return\n172\t            source._is_animated = True\n173\t            source.card_types = set(source.card_types) | {CardType.CREATURE}\n174\t            source.subtypes = set(source.subtypes) | {\"Wizard\"}\n175\t            source._base_power = 2\n176\t            source._base_toughness = 4\n177\t            # Wire the prowess-like cast trigger now that it is a creature.\n178\t            source.register_triggers(game)\n179\t\n180\t        return [\n181\t            ActivatedAbility(\n182\t                cost=_pay_five,\n183\t                effect=_animate,\n184\t                description=(\n185\t                    \"{5}: If this land isn't a creature, it becomes a 2/4 \"\n186\t                    \"Wizard creature with \\\"Whenever you cast an instant or \"\n187\t                    \"sorcery spell, this creature gets +1/+0 until end of \"\n188\t                    \"turn.\\\" It's still a land.\"\n189\t                ),\n190\t            )\n191\t        ]\n192\t\n193\t    # ------------------------------------------------------------------\n194\t    # \"Whenever you cast an instant or sorcery spell\" pump\n195\t    # ------------------------------------------------------------------\n196\t\n197\t    def register_triggers(self, game: GameState) -> None:\n198\t        # Only the animated creature has the cast trigger. Before animation the\n199\t        # land has no triggered abilities at all (matches the gate \"it becomes\n200\t        # a … creature with …\").\n201\t        if not self._is_animated:\n202\t            return\n203\t        if self._cast_trigger_registered:\n204\t            return\n205\t        self._cast_trigger_registered = True\n206\t\n207\t        source = self\n208\t\n209\t        def _controller_casts_instant_or_sorcery(g: GameState, event: Any) -> bool:\n210\t            # \"Whenever YOU cast\" — only the controller's spells count.\n211\t            caster = getattr(event, \"controller\", None) or getattr(event, \"player\", None)\n212\t            if caster is not source.controller:\n213\t                return False\n214\t            spell = getattr(event, \"spell\", None) or getattr(event, \"card\", None)\n215\t            card_types = getattr(spell, \"card_types\", set()) or set()\n216\t            return CardType.INSTANT in card_types or CardType.SORCERY in card_types\n217\t\n218\t        def _pump(g: GameState) -> None:\n219\t            # +1/+0 until end of turn. Modelled as a power bonus accumulator on\n220\t            # the land itself so ``power`` reflects it immediately.\n221\t            source._power_bonus += 1\n222\t\n223\t        game.trigger_manager.register(\n224\t            TriggerRegistration(\n225\t                event_type=SpellCastTriggeredEvent,\n226\t                condition=_controller_casts_instant_or_sorcery,\n227\t                effect=_pump,\n228\t                source=self,\n229\t                controller=self.controller,\n230\t            )\n231\t        )\n232\t"}]},"parent_tool_use_id":"toolu_018vLFmRjnSPaCfdXiEUZvAu","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"16ccb0b6-ba21-4b88-8908-af1d117e7575","timestamp":"2026-06-02T02:10:39.832Z","subagent_type":"Tester","task_description":"Extend sos_257 tests: restricted mana"}
