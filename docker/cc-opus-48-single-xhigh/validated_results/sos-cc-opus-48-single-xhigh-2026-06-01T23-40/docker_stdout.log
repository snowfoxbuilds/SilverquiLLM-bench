{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CHn5AzoaUcf98fYx6r6V3H","type":"tool_result","content":"167\t    def advance_phase(self) -> None:\n168\t        \"\"\"Advance to the next phase/step in MTG turn order.\n169\t\n170\t        At the end of CLEANUP, the turn number is incremented and the\n171\t        active player swaps (2-player assumption).  Mana pools are\n172\t        emptied on every transition.\n173\t        \"\"\"\n174\t        current = (self.phase, self.step)\n175\t        idx = _TURN_SEQUENCE.index(current)\n176\t\n177\t        if idx + 1 < len(_TURN_SEQUENCE):\n178\t            # Move to next phase/step within the same turn.\n179\t            next_phase, next_step = _TURN_SEQUENCE[idx + 1]\n180\t            self.phase = next_phase\n181\t            self.step = next_step\n182\t        else:\n183\t            # End of turn — wrap around.\n184\t            self.turn_number += 1\n185\t            if self.extra_turns:\n186\t                # ENGINE LIMITATION: Extra turns queue (FIFO). Pop the\n187\t                # next player seat index; that player gets the next turn.\n188\t                # Normal rotation is NOT advanced — extra turns are\n189\t                # inserted before the normal next turn.\n190\t                self.active_player_index = self.extra_turns.pop(0)\n191\t            else:\n192\t                self.active_player_index = self._normal_next_index\n193\t                self._normal_next_index = 1 - self._normal_next_index\n194\t            self.priority_player_index = self.active_player_index\n195\t            self.phase = _TURN_SEQUENCE[0][0]\n196\t            self.step = _TURN_SEQUENCE[0][1]\n197\t\n198\t        self.empty_mana_pools()\n199\t\n200\t    def empty_mana_pools(self) -> None:\n201\t        \"\"\"Empty all players' mana pools — called on each phase/step transition.\"\"\"\n202\t        for player in self.players:\n203\t            player.mana_pool.empty()\n204\t"}]},"parent_tool_use_id"