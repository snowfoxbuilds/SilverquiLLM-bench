1, controller=p1)\nfiller = Creature(name='Filler', base_power=1, base_toughness=1, owner=p1, controller=p1)\nbolt = Instant(name='Bolt', mana_cost=ManaCost.parse('{3}{U}'), owner=p1, controller=p1)\nset_board_state(game, 0, battlefield=[lorehold], hand=[], mana={ManaType.COLORLESS: 2})\np1.cards_drawn_this_turn = 0\ngame.get_library(p1).add(bolt)     # will be drawn SECOND (it's below filler? no, added first = bottom)\ngame.get_library(p1).add(filler)   # top -> drawn first\nc1 = draw_card(game, p1)  # filler, first card, non-instant -> no offer\nprint('first drawn is filler:', c1 is filler)\nc2 = draw_card(game, p1)  # bolt, second card -> NO offer regardless\nprint('second drawn is bolt:', c2 is bolt)\nprint('bolt in hand:', game.get_hand(p1).contains(bolt))\nprint('stack len:', len(game.stack))\nprint('mana total:', p1.mana_pool.total())\nprint('bolt miracle_cost stamped:', getattr(bolt, 'miracle_cost', None))\n\nprint('--- NO GRANTOR path ---')\ngame = create_game(scripts=([], []))\np1 = game.players[0]\nbolt = Instant(name='Bolt', mana_cost=ManaCost.parse('{3}{U}'), owner=p1, controller=p1)\nset_board_state(game, 0, battlefield=[], hand=[], mana={ManaType.COLORLESS: 2})\np1.cards_drawn_this_turn = 0\ngame.get_library(p1).add(bolt)\nc = draw_card(game, p1)\nprint('bolt in hand:', game.get_hand(p1).contains(bolt))\nprint('stack len:', len(game.stack))\nprint('mana total:', p1.mana_pool.total())\nprint('miracle stamped:', getattr(bolt, 'miracle_cost', None))\n\"\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":767,"cache_read_input_tokens":62394,"cache_creation":{"ephemeral_5m_input_tokens":767,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01DP4Xs2cvbpN88ARbBpN9ZM","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"3a76523