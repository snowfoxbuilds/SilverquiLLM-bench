{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GfzGLkL5CHyMMwo6fMvajx","type":"tool_result","content":"1\t\"\"\"Card implementation for Ral Zarek, Guest Lecturer.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import LoyaltyAbility, Planeswalker\n8\tfrom engine.types import CardType, ManaCost, Supertype, Zone\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t    from engine.player import Player\n13\t\n14\t\n15\tclass RalZarekGuestLecturer(Planeswalker):\n16\t    \"\"\"Ral Zarek, Guest Lecturer — {1}{B}{B} — Legendary Planeswalker — Ral.\n17\t\n18\t    Starting loyalty 3.\n19\t\n20\t    +1: Surveil 2.\n21\t    −1: Any number of target players each discard a card.\n22\t    −2: Return target creature card with mana value 3 or less from your\n23\t        graveyard to the battlefield.\n24\t    −7: Flip five coins. Target opponent skips their next X turns, where X is\n25\t        the number of coins that came up heads.\n26\t    \"\"\"\n27\t\n28\t    def __init__(self, **kwargs: Any) -> None:\n29\t        kwargs.setdefault(\"name\", \"Ral Zarek, Guest Lecturer\")\n30\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{B}{B}\"))\n31\t        kwargs.setdefault(\"starting_loyalty\", 3)\n32\t        kwargs.setdefault(\"supertypes\", set())\n33\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.LEGENDARY}\n34\t        kwargs.setdefault(\"subtypes\", set())\n35\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Ral\"}\n36\t        kwargs.setdefault(\n37\t            \"rules_text\",\n38\t            \"+1: Surveil 2.\\n\"\n39\t            \"−1: Any number of target players each discard a card.\\n\"\n40\t            \"−2: Return target creature card with mana value 3 or less from \"\n41\t            \"your graveyard to the battlefield.\\n\"\n42\t            \"−7: Flip five coins. Target opponent skips their next X turns, \"\n43\t            \"where X is the number of coins that came up heads.\",\n44\t        )\n45\t        super().__init__(**kwargs)\n46\t        # Explicit color identity (KEY_DECISIONS convention) — the {B}{B} pips\n47\t        # make Ral black.\n48\t        self.colors: list[str] = [\"B\"]\n49\t        # Records the number of heads from the most recent −7 resolution so a\n50\t        # test can assert X directly. Defaults to None until the ultimate runs.\n51\t        self._last_heads: int | None = None\n52\t\n53\t    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n54\t        pw = self\n55\t\n56\t        def _plus1(game: Any) -> None:\n57\t            \"\"\"+1: Surveil 2.\n58\t\n59\t            Look at the top two cards of the controller's library; put any\n60\t            number of them into the graveyard and the rest back on top. The\n61\t            keep/bin decision for each surveilled card is taken via the\n62\t            controller's ``choose_yes_no`` (the standard decision channel).\n63\t            \"\"\"\n64\t            from engine.zones import move_to_zone\n65\t\n66\t            controller = pw.controller\n67\t            if controller is None:\n68\t                return\n69\t            library = controller.zones[Zone.LIBRARY]\n70\t            if len(library) == 0:\n71\t                return\n72\t\n73\t            # Top of library is the end of the internal list; surveil the top\n74\t            # two cards, processing the very top first.\n75\t            top_cards = list(reversed(library.top(2)))\n76\t            for card in top_cards:\n77\t                if not library.contains(card):\n78\t                    continue\n79\t                bin_it = controller.choose_yes_no(\n80\t                    f\"Put {getattr(card, 'name', 'card')} into your graveyard?\"\n81\t                )\n82\t                if bin_it:\n83\t                    move_to_zone(game, card, Zone.LIBRARY, Zone.GRAVEYARD)\n84\t            # Cards not binned remain on top of the library in their existing\n85\t            # order — surveil leaves the order of the kept cards on top.\n86\t\n87\t        def _minus1(game: Any) -> None:\n88\t            \"\"\"−1: Any number of target players each discard a card.\"\"\"\n89\t            from engine.game import discard\n90\t\n91\t            targets = getattr(pw, \"_resolve_targets\", None)\n92\t            if not targets:\n93\t                return\n94\t            for player in targets:\n95\t                if player is None:\n96\t                    continue\n97\t                hand = player.zones[Zone.HAND]\n98\t                cards = hand.get_all()\n99\t                if not cards:\n100\t                    continue\n101\t                try:\n102\t                    chosen = player.choose_card(cards, \"Discard a card\")\n103\t                except Exception:\n104\t                    chosen = None\n105\t                if chosen is None or not hand.contains(chosen):\n106\t                    # Fall back to the last card in hand if the choice is\n107\t                    # missing/invalid (a player with a card in hand must\n108\t                    # discard one).\n109\t                    chosen = cards[-1]\n110\t                discard(game, player, chosen)\n111\t\n112\t        def _minus2(game: Any) -> None:\n113\t            \"\"\"−2: Return a creature card with mana value ≤ 3 from your\n114\t            graveyard to the battlefield.\"\"\"\n115\t            from engine.zones import move_to_zone\n116\t\n117\t            controller = pw.controller\n118\t            target = getattr(pw, \"_resolve_target\", None)\n119\t            if controller is None or target is None:\n120\t                return\n121\t            graveyard = controller.zones[Zone.GRAVEYARD]\n122\t            if not graveyard.contains(target):\n123\t                return\n124\t            # Lazy re-validation: creature card with mana value 3 or less.\n125\t            card_types = getattr(target, \"card_types\", set())\n126\t            if CardType.CREATURE not in card_types:\n127\t                return\n128\t            mana_cost = getattr(target, \"mana_cost\", None)\n129\t            mana_value = getattr(mana_cost, \"cmc\", 0) if mana_cost is not None else 0\n130\t            if mana_value > 3:\n131\t                return\n132\t            move_to_zone(game, target, Zone.GRAVEYARD, Zone.BATTLEFIELD)\n133\t\n134\t        def _minus7(game: Any) -> None:\n135\t            \"\"\"−7: Flip five coins. Target opponent skips their next X turns,\n136\t            where X is the number of coins that came up heads.\"\"\"\n137\t            from engine.game import flip_coins\n138\t\n139\t            target = getattr(pw, \"_resolve_target\", None)\n140\t            heads = flip_coins(game, 5, getattr(pw, \"controller\", None))\n141\t            pw._last_heads = heads\n142\t            if target is None:\n143\t                return\n144\t            # Schedule the opponent's next X turns to be skipped (CR 614.10),\n145\t            # honored by GameState turn rotation.\n146\t            current = getattr(target, \"skipped_turns\", 0)\n147\t            target.skipped_turns = current + heads\n148\t\n149\t        return [\n150\t            LoyaltyAbility(\n151\t                loyalty_cost=+1,\n152\t                effect=_plus1,\n153\t                description=\"+1: Surveil 2.\",\n154\t            ),\n155\t            LoyaltyAbility(\n156\t                loyalty_cost=-1,\n157\t                effect=_minus1,\n158\t                description=\"−1: Any number of target players each discard a card.\",\n159\t            ),\n160\t            LoyaltyAbility(\n161\t                loyalty_cost=-2,\n162\t                effect=_minus2,\n163\t                description=\"−2: Return target creature card with mana value 3 \"\n164\t                \"or less from your graveyard to the battlefield.\",\n165\t            ),\n166\t            LoyaltyAbility(\n167\t                loyalty_cost=-7,\n168\t                effect=_minus7,\n169\t                description=\"−7: Flip five coins. Target opponent skips their \"\n170\t                \"next X turns (X = heads).\",\n171\t            ),\n172\t        ]\n173\t"}]},"parent_tool_use_id":"toolu_01GnDaDCbHwYtiWkdURk8PBC","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"57deece7-f945-4177-a9da-f21305523041","timestamp":"2026-06-02T00:51:29.456Z","subagent_type":"Tester","task_description":"Add −7 X/skip-turn tests for sos_97"}
