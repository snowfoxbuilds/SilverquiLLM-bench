{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RdDt2C61PoyM4BUtVop4aD","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_97/card_impl.py b/cards/sos/sos_97/card_impl.py\n2\tindex df568b7..a8c79a2 100644\n3\t--- a/cards/sos/sos_97/card_impl.py\n4\t+++ b/cards/sos/sos_97/card_impl.py\n5\t@@ -2,15 +2,171 @@\n6\t \n7\t from __future__ import annotations\n8\t \n9\t-from engine.card import CardImpl\n10\t+from typing import TYPE_CHECKING, Any\n11\t \n12\t-from typing import TYPE_CHECKING\n13\t+from engine.card import LoyaltyAbility, Planeswalker\n14\t+from engine.types import CardType, ManaCost, Supertype, Zone\n15\t \n16\t if TYPE_CHECKING:\n17\t     from engine.game_state import GameState\n18\t+    from engine.player import Player\n19\t \n20\t \n21\t-class RalZarekGuestLecturer(CardImpl):\n22\t-    \"\"\"TODO: Implement Ral Zarek, Guest Lecturer.\"\"\"\n23\t+class RalZarekGuestLecturer(Planeswalker):\n24\t+    \"\"\"Ral Zarek, Guest Lecturer — {1}{B}{B} — Legendary Planeswalker — Ral.\n25\t \n26\t-    pass\n27\t+    Starting loyalty 3.\n28\t+\n29\t+    +1: Surveil 2.\n30\t+    −1: Any number of target players each discard a card.\n31\t+    −2: Return target creature card with mana value 3 or less from your\n32\t+        graveyard to the battlefield.\n33\t+    −7: Flip five coins. Target opponent skips their next X turns, where X is\n34\t+        the number of coins that came up heads.\n35\t+    \"\"\"\n36\t+\n37\t+    def __init__(self, **kwargs: Any) -> None:\n38\t+        kwargs.setdefault(\"name\", \"Ral Zarek, Guest Lecturer\")\n39\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{B}{B}\"))\n40\t+        kwargs.setdefault(\"starting_loyalty\", 3)\n41\t+        kwargs.setdefault(\"supertypes\", set())\n42\t+        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.LEGENDARY}\n43\t+        kwargs.setdefault(\"subtypes\", set())\n44\t+        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Ral\"}\n45\t+        kwargs.setdefault(\n46\t+            \"rules_text\",\n47\t+            \"+1: Surveil 2.\\n\"\n48\t+            \"−1: Any number of target players each discard a card.\\n\"\n49\t+            \"−2: Return target creature card with mana value 3 or less from \"\n50\t+            \"your graveyard to the battlefield.\\n\"\n51\t+            \"−7: Flip five coins. Target opponent skips their next X turns, \"\n52\t+            \"where X is the number of coins that came up heads.\",\n53\t+        )\n54\t+        super().__init__(**kwargs)\n55\t+        # Explicit color identity (KEY_DECISIONS convention) — the {B}{B} pips\n56\t+        # make Ral black.\n57\t+        self.colors: list[str] = [\"B\"]\n58\t+        # Records the number of heads from the most recent −7 resolution so a\n59\t+        # test can assert X directly. Defaults to None until the ultimate runs.\n60\t+        self._last_heads: int | None = None\n61\t+\n62\t+    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n63\t+        pw = self\n64\t+\n65\t+        def _plus1(game: Any) -> None:\n66\t+            \"\"\"+1: Surveil 2.\n67\t+\n68\t+            Look at the top two cards of the controller's library; put any\n69\t+            number of them into the graveyard and the rest back on top. The\n70\t+            keep/bin decision for each surveilled card is taken via the\n71\t+            controller's ``choose_yes_no`` (the standard decision channel).\n72\t+            \"\"\"\n73\t+            from engine.zones import move_to_zone\n74\t+\n75\t+            controller = pw.controller\n76\t+            if controller is None:\n77\t+                return\n78\t+            library = controller.zones[Zone.LIBRARY]\n79\t+            if len(library) == 0:\n80\t+                return\n81\t+\n82\t+            # Top of library is the end of the internal list; surveil the top\n83\t+            # two cards, processing the very top first.\n84\t+            top_cards = list(reversed(library.top(2)))\n85\t+            for card in top_cards:\n86\t+                if not library.contains(card):\n87\t+                    continue\n88\t+                bin_it = controller.choose_yes_no(\n89\t+                    f\"Put {getattr(card, 'name', 'card')} into your graveyard?\"\n90\t+                )\n91\t+                if bin_it:\n92\t+                    move_to_zone(game, card, Zone.LIBRARY, Zone.GRAVEYARD)\n93\t+            # Cards not binned remain on top of the library in their existing\n94\t+            # order — surveil leaves the order of the kept cards on top.\n95\t+\n96\t+        def _minus1(game: Any) -> None:\n97\t+            \"\"\"−1: Any number of target players each discard a card.\"\"\"\n98\t+            from engine.game import discard\n99\t+\n100\t+            targets = getattr(pw, \"_resolve_targets\", None)\n101\t+            if not targets:\n102\t+                return\n103\t+            for player in targets:\n104\t+                if player is None:\n105\t+                    continue\n106\t+                hand = player.zones[Zone.HAND]\n107\t+                cards = hand.get_all()\n108\t+                if not cards:\n109\t+                    continue\n110\t+                try:\n111\t+                    chosen = player.choose_card(cards, \"Discard a card\")\n112\t+                except Exception:\n113\t+                    chosen = None\n114\t+                if chosen is None or not hand.contains(chosen):\n115\t+                    # Fall back to the last card in hand if the choice is\n116\t+                    # missing/invalid (a player with a card in hand must\n117\t+                    # discard one).\n118\t+                    chosen = cards[-1]\n119\t+                discard(game, player, chosen)\n120\t+\n121\t+        def _minus2(game: Any) -> None:\n122\t+            \"\"\"−2: Return a creature card with mana value ≤ 3 from your\n123\t+            graveyard to the battlefield.\"\"\"\n124\t+            from engine.zones import move_to_zone\n125\t+\n126\t+            controller = pw.controller\n127\t+            target = getattr(pw, \"_resolve_target\", None)\n128\t+            if controller is None or target is None:\n129\t+                return\n130\t+            graveyard = controller.zones[Zone.GRAVEYARD]\n131\t+            if not graveyard.contains(target):\n132\t+                return\n133\t+            # Lazy re-validation: creature card with mana value 3 or less.\n134\t+            card_types = getattr(target, \"card_types\", set())\n135\t+            if CardType.CREATURE not in card_types:\n136\t+                return\n137\t+            mana_cost = getattr(target, \"mana_cost\", None)\n138\t+            mana_value = getattr(mana_cost, \"cmc\", 0) if mana_cost is not None else 0\n139\t+            if mana_value > 3:\n140\t+                return\n141\t+            move_to_zone(game, target, Zone.GRAVEYARD, Zone.BATTLEFIELD)\n142\t+\n143\t+        def _minus7(game: Any) -> None:\n144\t+            \"\"\"−7: Flip five coins. Target opponent skips their next X turns,\n145\t+            where X is the number of coins that came up heads.\"\"\"\n146\t+            from engine.game import flip_coins\n147\t+\n148\t+            target = getattr(pw, \"_resolve_target\", None)\n149\t+            heads = flip_coins(game, 5, getattr(pw, \"controller\", None))\n150\t+            pw._last_heads = heads\n151\t+            if target is None:\n152\t+                return\n153\t+            # Schedule the opponent's next X turns to be skipped (CR 614.10),\n154\t+            # honored by GameState turn rotation.\n155\t+            current = getattr(target, \"skipped_turns\", 0)\n156\t+            target.skipped_turns = current + heads\n157\t+\n158\t+        return [\n159\t+            LoyaltyAbility(\n160\t+                loyalty_cost=+1,\n161\t+                effect=_plus1,\n162\t+                description=\"+1: Surveil 2.\",\n163\t+            ),\n164\t+            LoyaltyAbility(\n165\t+                loyalty_cost=-1,\n166\t+                effect=_minus1,\n167\t+                description=\"−1: Any number of target players each discard a card.\",\n168\t+            ),\n169\t+            LoyaltyAbility(\n170\t+                loyalty_cost=-2,\n171\t+                effect=_minus2,\n172\t+                description=\"−2: Return target creature card with mana value 3 \"\n173\t+                \"or less from your graveyard to the battlefield.\",\n174\t+            ),\n175\t+            LoyaltyAbility(\n176\t+                loyalty_cost=-7,\n177\t+                effect=_minus7,\n178\t+                description=\"−7: Flip five coins. Target opponent skips their \"\n179\t+                \"next X turns (X = heads).\",\n180\t+            ),\n181\t+        ]\n182\tdiff --git a/engine/game.py b/engine/game.py\n183\tindex 46e4195..72b8fb4 100644\n184\t--- a/engine/game.py\n185\t+++ b/engine/game.py\n186\t@@ -473,6 +473,71 @@ def untap(game: GameState, permanent: Any) -> None:\n187\t         permanent.is_tapped = False\n188\t \n189\t \n190\t+# ---------------------------------------------------------------------------\n191\t+# Coin flips (CR 705)\n192\t+# ---------------------------------------------------------------------------\n193\t+\n194\t+def flip_coin(game: GameState, player: Any = None) -> bool:\n195\t+    \"\"\"Flip a single coin (CR 705) and return ``True`` for heads.\n196\t+\n197\t+    The randomness is deterministic and injectable so that tests can force\n198\t+    outcomes. The injection points, checked in order, are:\n199\t+\n200\t+    1. ``game._forced_coin_flips`` — a list/deque of pre-seeded booleans (or\n201\t+       truthy/falsy values). When present and non-empty, the next value is\n202\t+       popped from the *front* and used as the result. This is the simplest\n203\t+       way for a test to force a known number of heads.\n204\t+    2. ``game.rng`` — a ``random.Random``-compatible object. When present, the\n205\t+       result is ``game.rng.random() < 0.5``. A test can set\n206\t+       ``game.rng = random.Random(seed)`` for reproducible flips.\n207\t+    3. Otherwise a module-level ``random`` call is used.\n208\t+\n209\t+    Parameters:\n210\t+        game: The current game state.\n211\t+        player: The player flipping the coin (informational; unused by the\n212\t+            default RNG but accepted for API symmetry / future hooks).\n213\t+\n214\t+    Returns:\n215\t+        ``True`` for heads, ``False`` for tails.\n216\t+    \"\"\"\n217\t+    forced = getattr(game, \"_forced_coin_flips\", None)\n218\t+    if forced:\n219\t+        # Support both lists and collections.deque (popleft) for the queue.\n220\t+        if hasattr(forced, \"popleft\"):\n221\t+            value = forced.popleft()\n222\t+        else:\n223\t+            value = forced.pop(0)\n224\t+        return bool(value)\n225\t+\n226\t+    rng = getattr(game, \"rng\", None)\n227\t+    if rng is not None:\n228\t+        return rng.random() < 0.5\n229\t+\n230\t+    import random as _random\n231\t+\n232\t+    return _random.random() < 0.5\n233\t+\n234\t+\n235\t+def flip_coins(game: GameState, n: int, player: Any = None) -> int:\n236\t+    \"\"\"Flip *n* coins and return the number that came up heads.\n237\t+\n238\t+    Uses :func:`flip_coin` for each flip, so the same deterministic injection\n239\t+    points apply (``game._forced_coin_flips`` then ``game.rng``). See\n240\t+    :func:`flip_coin` for how a test forces specific results.\n241\t+\n242\t+    Parameters:\n243\t+        game: The current game state.\n244\t+        n: The number of coins to flip (``n <= 0`` returns 0).\n245\t+        player: The player flipping the coins (informational).\n246\t+\n247\t+    Returns:\n248\t+        The number of heads across the *n* flips.\n249\t+    \"\"\"\n250\t+    if n <= 0:\n251\t+        return 0\n252\t+    return sum(1 for _ in range(n) if flip_coin(game, player))\n253\t+\n254\t+\n255\t # ---------------------------------------------------------------------------\n256\t # Game loop\n257\t # ---------------------------------------------------------------------------\n258\tdiff --git a/engine/game_state.py b/engine/game_state.py\n259\tindex 5f8e628..33344c7 100644\n260\t--- a/engine/game_state.py\n261\t+++ b/engine/game_state.py\n262\t@@ -182,21 +182,62 @@ class GameState:\n263\t         else:\n264\t             # End of turn — wrap around.\n265\t             self.turn_number += 1\n266\t-            if self.extra_turns:\n267\t-                # ENGINE LIMITATION: Extra turns queue (FIFO). Pop the\n268\t-                # next player seat index; that player gets the next turn.\n269\t-                # Normal rotation is NOT advanced — extra turns are\n270\t-                # inserted before the normal next turn.\n271\t-                self.active_player_index = self.extra_turns.pop(0)\n272\t-            else:\n273\t-                self.active_player_index = self._normal_next_index\n274\t-                self._normal_next_index = 1 - self._normal_next_index\n275\t+            self.active_player_index = self._select_next_active_player()\n276\t             self.priority_player_index = self.active_player_index\n277\t             self.phase = _TURN_SEQUENCE[0][0]\n278\t             self.step = _TURN_SEQUENCE[0][1]\n279\t \n280\t         self.empty_mana_pools()\n281\t \n282\t+    def _select_next_active_player(self) -> int:\n283\t+        \"\"\"Determine the seat index that should take the upcoming turn.\n284\t+\n285\t+        Resolves the next active player from the extra-turn FIFO / normal\n286\t+        rotation, then honors per-player skip-turn counters (CR 614.10): if\n287\t+        the would-be active player has ``skipped_turns > 0``, that counter is\n288\t+        decremented and their turn is consumed, advancing to the following\n289\t+        candidate. This preserves all existing ``extra_turns`` behavior — an\n290\t+        extra turn that is skipped is still consumed from the queue.\n291\t+\n292\t+        A safety guard caps the number of skip iterations so that a state in\n293\t+        which both players are perpetually skipped cannot loop forever; once\n294\t+        the guard trips, the last candidate takes the turn.\n295\t+        \"\"\"\n296\t+        # Guard against the (degenerate) case where every candidate is skipped.\n297\t+        max_iterations = (len(self.players) * 2) + sum(\n298\t+            getattr(p, \"skipped_turns\", 0) for p in self.players\n299\t+        ) + 1\n300\t+\n301\t+        candidate = self._advance_rotation_index()\n302\t+        for _ in range(max_iterations):\n303\t+            player = self.players[candidate]\n304\t+            if getattr(player, \"skipped_turns\", 0) > 0:\n305\t+                # This player's turn is skipped — consume one skip and the\n306\t+                # turn slot, then move to the next candidate.\n307\t+                player.skipped_turns -= 1\n308\t+                self.turn_number += 1\n309\t+                candidate = self._advance_rotation_index()\n310\t+                continue\n311\t+            return candidate\n312\t+        return candidate\n313\t+\n314\t+    def _advance_rotation_index(self) -> int:\n315\t+        \"\"\"Pop the next seat index from the extra-turn FIFO or normal rotation.\n316\t+\n317\t+        Mirrors the prior inline logic in :meth:`advance_phase`: an extra turn\n318\t+        (if queued) is taken without advancing the normal rotation; otherwise\n319\t+        the normal alternating rotation advances.\n320\t+        \"\"\"\n321\t+        if self.extra_turns:\n322\t+            # ENGINE LIMITATION: Extra turns queue (FIFO). Pop the next player\n323\t+            # seat index; that player gets the next turn. Normal rotation is\n324\t+            # NOT advanced — extra turns are inserted before the normal next\n325\t+            # turn.\n326\t+            return self.extra_turns.pop(0)\n327\t+        index = self._normal_next_index\n328\t+        self._normal_next_index = 1 - self._normal_next_index\n329\t+        return index\n330\t+\n331\t     def empty_mana_pools(self) -> None:\n332\t         \"\"\"Empty all players' mana pools — called on each phase/step transition.\"\"\"\n333\t         for player in self.players:\n334\tdiff --git a/engine/player.py b/engine/player.py\n335\tindex 9d66c29..4b1d527 100644\n336\t--- a/engine/player.py\n337\t+++ b/engine/player.py\n338\t@@ -35,6 +35,11 @@ class Player(ABC):\n339\t         self.has_lost: bool = False\n340\t         self.land_plays_remaining: int = 1\n341\t         self.drawn_from_empty_library: bool = False\n342\t+        # Number of this player's upcoming turns to skip (CR 614.10). When a\n343\t+        # turn would begin for a player with ``skipped_turns > 0``, the turn\n344\t+        # rotation (``GameState.advance_phase``) skips it and decrements this\n345\t+        # counter instead of running the turn. Additive; defaults to 0.\n346\t+        self.skipped_turns: int = 0\n347\t \n348\t     @abstractmethod\n349\t     def choose_target(self, options: Any, requirement: Any) -> Any:\n350\t"}]},"parent_tool_use_id":"toolu_019FjC3Yg4WQJQBFnLquD2dB","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"4a3896b3-130c-4378-b336-d7da708b9d56","timestamp":"2026-06-02T00:54:04.455Z","subagent_type":"Reviewer","task_description":"Review sos_97 implementation"}
