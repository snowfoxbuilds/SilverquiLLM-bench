{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015qKrk9bVs5x2XGJuskPkWp","type":"tool_result","content":"270\t    for target in chosen_targets:\n271\t        if has_protection_from(target, card):\n272\t            # Rollback: move card from stack zone back to hand\n273\t            stack_zone.remove(card)\n274\t            hand.add(card)\n275\t            raise CastingError(\n276\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n277\t            )\n278\t\n279\t    # Targets are stored on the StackObject (not the card) and passed\n280\t    # through the resolve pipeline via on_resolve(game, targets=...).\n281\t\n282\t    # 6. Mana check / payment (rollback on failure)\n283\t    # Ensure the card knows its controller so that cost_reduction() hooks\n284\t    # (e.g. Embercleave counting attacking creatures you control) see the\n285\t    # casting player, even for cards that were added to hand without an\n286\t    # explicit controller assignment.\n287\t    if card.controller is None:\n288\t        card.controller = player\n289\t    if alternative_cost is not None:\n290\t        # Alternative costs (e.g. miracle, CR 118.9) replace the printed mana\n291\t        # cost wholesale and are not subject to generic cost reduction.\n292\t        effective_cost = alternative_cost\n293\t    else:\n294\t        reduction = get_cost_reduction(game, card, player)\n295\t        effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n296\t\n297\t    if not player.mana_pool.can_pay(effective_cost):\n298\t        # Rollback: move card from stack zone back to hand\n299\t        stack_zone.remove(card)\n300\t        hand.add(card)\n301\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n302\t\n303\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n304\t    player.mana_pool.pay(effective_cost)\n305\t\n306\t    # Store colors of mana spent on the card for mechanics like Converge\n307\t    # that care about the colors used to cast the spell.\n308\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n309\t\n310\t    # Store the TOTAL amount of mana spent (converted, after cost reduction)\n311\t    # for mechanics that reimburse / count the mana paid to cast the spell\n312\t    # (e.g. Mana Sculpt). Additive and backward-compatible — defaults absent.\n313\t    card.mana_spent = effective_cost.cmc  # type: ignore[attr-defined]\n314\t\n315\t    # 7. Call on_cast hook\n316\t    card.on_cast(game)\n317\t\n318\t    # 8. Build on_resolve callback and push StackObject\n319\t    stack_obj = StackObject(\n320\t        source=card,\n321\t        controller=player,\n322\t        targets=chosen_targets,\n323\t        on_resolve=lambda g: None,  # replaced below\n324\t        is_spell=True,\n325\t    )\n326\t\n327\t    def _on_resolve(g: GameState) -> None:\n328\t        _resolve_spell(g, card, player, stack_obj)\n329\t\n330\t    stack_obj.on_resolve = _on_resolve\n331\t    game.stack.push(stack_obj)\n332\t\n333\t    # Casualty window (CR 702.153). This is a COMPLETE no-op unless some\n334\t    # permanent the CASTER controls advertises a ``grants_casualty_to(spell)``\n335\t    # capability for the just-cast spell. Only then is that permanent's\n336\t    # ``offer_casualty`` invoked. Keeping the hook fully gated means ordinary\n337\t    # casts (where nothing grants casualty) see zero behavioural change.\n338\t    _offer_casualty(game, player, stack_obj)\n339\t\n340\t\n341\tdef _offer_casualty(game: GameState, player: Player, stack_obj: StackObject) -> None:\n342\t    \"\"\"Offer casualty for the spell *stack_obj* just cast by *player*.\n343\t\n344\t    Gated so it does nothing unless some permanent *player* controls advertises"}]},"parent_tool_use_id":"toolu_01FhNfUVJpcxNHXwXyrc99xQ","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7