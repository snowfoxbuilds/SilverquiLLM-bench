{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PtpoD8EVunSuY7k5iPz6B9","type":"tool_result","content":"27\t\n28\tfrom __future__ import annotations\n29\t\n30\tfrom typing import Any\n31\t\n32\timport pytest\n33\t\n34\tfrom cards.sos.sos_13.card_impl import EmeritusOfTruceSwordsToPlowshares\n35\tfrom engine.card import Creature\n36\tfrom engine.types import CardType, Keyword, ManaCost, Zone\n37\tfrom test_utils import create_game\n38\t\n39\t\n40\t# ---------------------------------------------------------------------------\n41\t# Helpers\n42\t# ---------------------------------------------------------------------------\n43\t\n44\t\n45\tdef _make_card(game: Any, controller_index: int = 0) -> EmeritusOfTruceSwordsToPlowshares:\n46\t    \"\"\"Build the card owned/controlled by the given player and return it.\"\"\"\n47\t    player = game.players[controller_index]\n48\t    card = EmeritusOfTruceSwordsToPlowshares(owner=player, controller=player)\n49\t    return card\n50\t\n51\t\n52\tdef _battlefield_creatures(game: Any, player: Any) -> list[Any]:\n53\t    \"\"\"Return Creature objects on *player*'s battlefield.\"\"\"\n54\t    return [\n55\t        obj\n56\t        for obj in game.get_battlefield(player).get_all()\n57\t        if isinstance(obj, Creature)\n58\t    ]\n59\t\n60\t\n61\tdef _inkling_tokens(game: Any, player: Any) -> list[Any]:\n62\t    \"\"\"Return token creatures named 'Inkling' on *player*'s battlefield.\"\"\"\n63\t    out = []\n64\t    for obj in _battlefield_creatures(game, player):\n65\t        name = getattr(obj, \"name\", \"\")\n66\t        subtypes = getattr(obj, \"subtypes\", set())\n67\t        if \"Inkling\" in name or \"Inkling\" in subtypes:\n68\t            out.append(obj)\n69\t    return out\n70\t\n71\t\n72\tdef _fire_etb(game: Any, card: Any, target_player: Any) -> None:\n73\t    \"\"\"Resolve the card's enter-the-battlefield effect.\n74\t\n75\t    The card is placed on its controller's battlefield first (so SBA / zone\n76\t    checks see it), then its ETB is driven through whichever surface the\n77\t    implementation exposes.  ``chosen_targets`` is set to the target player,\n78\t    matching the engine's resolve-time contract for targeted effects.\n79\t    \"\"\"\n80\t    controller = card.controller\n81\t    game.get_battlefield(controller).add(card)\n82\t    card.chosen_targets = [target_player]\n83\t\n84\t    # Preferred path: register the ETB trigger, then fire the ETB event and\n85\t    # resolve the resulting stack object.\n86\t    from engine.events import EntersBattlefieldTriggeredEvent\n87\t\n88\t    if hasattr(card, \"register_triggers\"):\n89\t        card.register_triggers(game)\n90\t    fired = False\n91\t    try:\n92\t        game.trigger_manager.fire_event(\n93\t            game,\n94\t            EntersBattlefieldTriggeredEvent(\n95\t                permanent=card, controller=controller, creature=card\n96\t            ),\n97\t        )\n98\t    except Exception:\n99\t        fired = False\n100\t    else:\n101\t        fired = not game.stack.is_empty()\n102\t\n103\t    if fired:\n104\t        # Resolve all triggered abilities on the stack.\n105\t        while not game.stack.is_empty():\n106\t            obj = game.stack.pop()\n107\t            # Make the target player available to the resolving ability.\n108\t            if hasattr(obj, \"targets\") and not getattr(obj, \"targets\", None):\n109\t                obj.targets = [target_player]\n110\t            card.chosen_targets = [target_player]\n111\t            obj.on_resolve(game)\n112\t        return\n113\t\n114\t    # Fallback path: the implementation may expose the ETB as on_resolve.\n115\t    card.chosen_targets = [target_player]\n116\t    card.on_resolve(game)\n117\t\n118\t\n119\t# ---------------------------------------------------------------------------\n120\t# Static characteristics of the front face (Emeritus of Truce)\n121\t# ---------------------------------------------------------------------------\n122\t\n123\t\n124\tclass TestEmeritusProperties:\n125\t    \"\"\"The front face is a 3/3 white Cat Cleric costing {1}{W}{W}.\"\"\"\n126\t\n127\t    def test_is_creature(self) -> None:\n128\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n129\t        assert isinstance(card, Creature)\n130\t        assert CardType.CREATURE in card.card_types\n131\t\n132\t    def test_name(self) -> None:\n133\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n134\t        assert card.name == \"Emeritus of Truce // Swords to Plowshares\"\n135\t\n136\t    def test_mana_cost(self) -> None:\n137\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n138\t        assert card.mana_cost == ManaCost.parse(\"{1}{W}{W}\")\n139\t\n140\t    def test_power_toughness(self) -> None:\n141\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n142\t        assert card.base_power == 3\n143\t        assert card.base_toughness == 3\n144\t\n145\t    def test_creature_subtypes(self) -> None:\n146\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)"}]},"parent_tool_use_id":null,"session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"fb773da2-0d80-496b-ae4b-762fca51146d","timestamp":"2026-06-02T00:12:22.233Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/sos/sos_13/tests.py","content":"\nfrom __future__ import annotations\n\nfrom typing import Any\n\nimport pytest\n\nfrom cards.sos.sos_13.card_impl import EmeritusOfTruceSwordsToPlowshares\nfrom engine.card import Creature\nfrom engine.types import CardType, Keyword, ManaCost, Zone\nfrom test_utils import create_game\n\n\n# ---------------------------------------------------------------------------\n# Helpers\n# ---------------------------------------------------------------------------\n\n\ndef _make_card(game: Any, controller_index: int = 0) -> EmeritusOfTruceSwordsToPlowshares:\n    \"\"\"Build the card owned/controlled by the given player and return it.\"\"\"\n    player = game.players[controller_index]\n    card = EmeritusOfTruceSwordsToPlowshares(owner=player, controller=player)\n    return card\n\n\ndef _battlefield_creatures(game: Any, player: Any) -> list[Any]:\n    \"\"\"Return Creature objects on *player*'s battlefield.\"\"\"\n    return [\n        obj\n        for obj in game.get_battlefield(player).get_all()\n        if isinstance(obj, Creature)\n    ]\n\n\ndef _inkling_tokens(game: Any, player: Any) -> list[Any]:\n    \"\"\"Return token creatures named 'Inkling' on *player*'s battlefield.\"\"\"\n    out = []\n    for obj in _battlefield_creatures(game, player):\n        name = getattr(obj, \"name\", \"\")\n        subtypes = getattr(obj, \"subtypes\", set())\n        if \"Inkling\" in name or \"Inkling\" in subtypes:\n            out.append(obj)\n    return out\n\n\ndef _fire_etb(game: Any, card: Any, target_player: Any) -> None:\n    \"\"\"Resolve the card's enter-the-battlefield effect.\n\n    The card is placed on its controller's battlefield first (so SBA / zone\n    checks see it), then its ETB is driven through whichever surface the\n    implementation exposes.  ``chosen_targets`` is set to the target player,\n    matching the engine's resolve-time contract for targeted effects.\n    \"\"\"\n    controller = card.controller\n    game.get_battlefield(controller).add(card)\n    card.chosen_targets = [target_player]\n\n    # Preferred path: register the ETB trigger, then fire the ETB event and\n    # resolve the resulting stack object.\n    from engine.events import EntersBattlefieldTriggeredEvent\n\n    if hasattr(card, \"register_triggers\"):\n        card.register_triggers(game)\n    fired = False\n    try:\n        game.trigger_manager.fire_event(\n            game,\n            EntersBattlefieldTriggeredEvent(\n                permanent=card, controller=controller, creature=card\n            ),\n        )\n    except Exception:\n        fired = False\n    else:\n        fired = not game.stack.is_empty()\n\n    if fired:\n        # Resolve all triggered abilities on the stack.\n        while not game.stack.is_empty():\n            obj = game.stack.pop()\n            # Make the target player available to the resolving ability.\n            if hasattr(obj, \"targets\") and not getattr(obj, \"targets\", None):\n                obj.targets = [target_player]\n            card.chosen_targets = [target_player]\n            obj.on_resolve(game)\n        return\n\n    # Fallback path: the implementation may expose the ETB as on_resolve.\n    card.chosen_targets = [target_player]\n    card.on_resolve(game)\n\n\n# ---------------------------------------------------------------------------\n# Static characteristics of the front face (Emeritus of Truce)\n# ---------------------------------------------------------------------------\n\n\nclass TestEmeritusProperties:\n    \"\"\"The front face is a 3/3 white Cat Cleric costing {1}{W}{W}.\"\"\"\n\n    def test_is_creature(self) -> None:\n        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n        assert isinstance(card, Creature)\n        assert CardType.CREATURE in card.card_types\n\n    def test_name(self) -> None:\n        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n        assert card.name == \"Emeritus of Truce // Swords to Plowshares\"\n\n    def test_mana_cost(self) -> None:\n        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n        assert card.mana_cost == ManaCost.parse(\"{1}{W}{W}\")\n\n    def test_power_toughness(self) -> None:\n        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n        assert card.base_power == 3\n        assert card.base_toughness == 3\n\n    def test_creature_subtypes(self) -> None:\n        card = EmeritusOfTruceSwordsToPlowshares(owner=None)","numLines":120,"startLine":27,"totalLines":414}}}
