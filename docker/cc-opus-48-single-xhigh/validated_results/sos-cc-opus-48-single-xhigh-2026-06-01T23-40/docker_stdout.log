{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HY6Ms36PMYyHRpNK5pAWG2","type":"tool_result","content":"1\t\"\"\"Card implementation for Banishing Light.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom dataclasses import dataclass\n4\tfrom typing import TYPE_CHECKING, Any\n5\tfrom engine.card import ActivatedAbility, Creature, Enchantment\n6\tfrom engine.continuous_effects import ContinuousEffect, DURATION_PERMANENT, Layer, SubLayer\n7\tfrom engine.types import CardType, Keyword, ManaCost, TargetRequirement, Zone\n8\tfrom engine.events import LeavesBattlefieldTriggeredEvent\n9\tif TYPE_CHECKING:\n10\t    from engine.game_state import GameState\n11\t    from cards.registry import CardRegistry\n12\t\n13\tdef _is_on_battlefield(game: Any, obj: Any) -> bool:\n14\t    \"\"\"Check if *obj* is on any player's battlefield.\"\"\"\n15\t    for player in game.players:\n16\t        if game.get_battlefield(player).contains(obj):\n17\t            return True\n18\t    return False\n19\t\n20\tdef _nonland_opponent_targets(game: Any, controller: Any) -> list[Any]:\n21\t    \"\"\"Return all nonland permanents on opponents' battlefields.\"\"\"\n22\t    targets: list[Any] = []\n23\t    for player in game.players:\n24\t        if player is controller:\n25\t            continue\n26\t        for obj in game.get_battlefield(player).get_all():\n27\t            card_types = getattr(obj, 'card_types', set())\n28\t            if CardType.LAND not in card_types:\n29\t                targets.append(obj)\n30\t    return targets\n31\t\n32\tclass BanishingLight(Enchantment):\n33\t    \"\"\"Banishing Light — {2}{W} — Exile nonland permanent until this leaves.\n34\t\n35\t    When this enchantment enters, exile target nonland permanent an opponent\n36\t    controls until this enchantment leaves the battlefield.\n37\t\n38\t    FDN collector number 138.\n39\t    \"\"\"\n40\t\n41\t    def __init__(self, **kwargs: Any) -> None:\n42\t        kwargs.setdefault('name', 'Banishing Light')\n43\t        kwargs.setdefault('mana_cost', ManaCost.parse('{2}{W}'))\n44\t        kwargs.setdefault('rules_text', 'When this enchantment enters, exile target nonland permanent an opponent controls until this enchantment leaves the battlefield.')\n45\t        super().__init__(**kwargs)\n46\t        self._exiled_card: Any | None = None\n47\t        self._exiled_owner: Any | None = None\n48\t\n49\t    def get_targets(self, game: GameState) -> list[Any]:\n50\t        controller = self.controller or game.active_player\n51\t        targets = _nonland_opponent_targets(game, controller)\n52\t        if not targets:\n53\t            return []\n54\t        return [TargetRequirement(filter_fn=lambda obj, _c=controller: CardType.LAND not in getattr(obj, 'card_types', set()) and getattr(obj, 'controller', None) is not _c, description='nonland permanent an opponent controls', zone=Zone.BATTLEFIELD)]\n55\t\n56\t    def on_resolve(self, game: GameState) -> None:\n57\t        chosen = getattr(self, 'chosen_targets', None)\n58\t        target = chosen[0] if chosen else None\n59\t        if target is None:\n60\t            return\n61\t        if not _is_on_battlefield(game, target):\n62\t            return\n63\t        from engine.zones import move_to_zone\n64\t        self._exiled_card = target\n65\t        self._exiled_owner = getattr(target, 'owner', None) or getattr(target, 'controller', None)\n66\t        move_to_zone(game, target, Zone.BATTLEFIELD, Zone.EXILE)\n67\t\n68\t    def register_triggers(self, game: GameState) -> None:\n69\t        from engine.triggers import TriggerRegistration\n70\t        source = self\n71\t\n72\t        def _condition(game: Any, event: dict) -> bool:\n73\t            permanent = event.permanent\n74\t            return permanent is source\n75\t\n76\t        def _effect(game: GameState) -> None:\n77\t            card = source._exiled_card\n78\t            owner = source._exiled_owner\n79\t            if card is None or owner is None:\n80\t                return\n81\t            from engine.zones import move_to_zone\n82\t            card.controller = owner\n83\t            move_to_zone(game, card, Zone.EXILE, Zone.BATTLEFIELD)\n84\t            source._exiled_card = None\n85\t            source._exiled_owner = None\n86\t        controller = getattr(self, 'controller', None) or game.active_player\n87\t        game.trigger_manager.register(TriggerRegistration(event_type=LeavesBattlefieldTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=controller))\n88\t"}]},"parent_tool_use_id":"toolu_01AUSULf5a3mm3JkXCS2zBdz","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"b5cd29b7-2ee4-4556-b2dd-3e4781316193","timestamp":"2026-06-01T23:48:13.190Z","subagent_type":"Implementer","task_description":"Implement sos_1"}
