{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01T9G7JBpuAt5w47D2QVdGeZ","type":"tool_result","content":"152\t        p1 = game.players[0]\n153\t        # Library bottom -> top: deep, b (2), a (2). Top is `a`.\n154\t        deep = _creature(\"Deep Filler\", \"{9}\")\n155\t        a = _instant(\"Top A\", \"{1}{R}\")   # MV 2\n156\t        b = _sorcery(\"Top B\", \"{1}{R}\")   # MV 2\n157\t        _set_library(game, p1, [deep, b, a])\n158\t\n159\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n160\t        spell.on_resolve(game)\n161\t\n162\t        exiled = _exiled(game, p1)\n163\t        assert a in exiled and b in exiled\n164\t        assert deep not in exiled\n165\t        # Stops once total MV is 4 — does not over-exile.\n166\t        assert len(exiled) == 2\n167\t\n168\t    def test_single_high_value_card_stops_immediately(self) -> None:\n169\t        \"\"\"A single MV-4 card on top is enough; only it is exiled.\"\"\"\n170\t        game = create_game()\n171\t        p1 = game.players[0]\n172\t        big = _creature(\"Behemoth\", \"{4}\")     # MV 4\n173\t        rest = _instant(\"Untouched\", \"{1}\")\n174\t        _set_library(game, p1, [rest, big])    # big is on top\n175\t\n176\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n177\t        spell.on_resolve(game)\n178\t\n179\t        exiled = _exiled(game, p1)\n180\t        assert big in exiled\n181\t        assert rest not in exiled\n182\t        assert len(exiled) == 1\n183\t\n184\t    def test_total_mana_value_can_exceed_four(self) -> None:\n185\t        \"\"\"If the boundary card pushes the total past 4, that is fine —\n186\t        the loop only stops *after* reaching >= 4.\"\"\"\n187\t        game = create_game()\n188\t        p1 = game.players[0]\n189\t        a = _instant(\"A\", \"{2}\")   # MV 2\n190\t        b = _creature(\"B\", \"{5}\")  # MV 5 -> total 7 >= 4\n191\t        rest = _instant(\"Rest\", \"{1}\")\n192\t        _set_library(game, p1, [rest, b, a])   # top is `a`\n193\t\n194\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n195\t        spell.on_resolve(game)\n196\t\n197\t        exiled = _exiled(game, p1)\n198\t        assert a in exiled and b in exiled\n199\t        assert rest not in exiled\n200\t        assert len(exiled) == 2\n201\t\n202\t    def test_exact_three_one_drops_take_four_cards(self) -> None:\n203\t        \"\"\"Four MV-1 cards: must exile exactly four to reach total MV 4.\"\"\"\n204\t        game = create_game()\n205\t        p1 = game.players[0]\n206\t        ones = [_instant(f\"One{i}\", \"{1}\") for i in range(4)]\n207\t        spare = _instant(\"Spare\", \"{1}\")\n208\t        # Library bottom->top: spare, One3, One2, One1, One0 (One0 on top)\n209\t        _set_library(game, p1, [spare] + list(reversed(ones)))\n210\t\n211\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n212\t        spell.on_resolve(game)\n213\t\n214\t        exiled = _exiled(game, p1)\n215\t        for card in ones:\n216\t            assert card in exiled\n217\t        assert spare not in exiled\n218\t        assert len(exiled) == 4\n219\t\n220\t    def test_small_library_below_four_is_emptied(self) -> None:\n221\t        \"\"\"If the whole library totals < 4 MV, every card is exiled and the\n222\t        loop terminates without error.\"\"\"\n223\t        game = create_game()\n224\t        p1 = game.players[0]\n225\t        a = _instant(\"A\", \"{1}\")   # MV 1\n226\t        b = _instant(\"B\", \"{1}\")   # MV 1 -> total 2, never reaches 4\n227\t        _set_library(game, p1, [b, a])\n228\t\n229\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n230\t        spell.on_resolve(game)\n231\t\n232\t        exiled = _exiled(game, p1)\n233\t        assert a in exiled and b in exiled\n234\t        assert len(game.get_library(p1).get_all()) == 0\n235\t\n236\t    def test_empty_library_is_safe_noop(self) -> None:\n237\t        \"\"\"An empty library exiles nothing and does not raise.\"\"\"\n238\t        game = create_game()\n239\t        p1 = game.players[0]\n240\t        _set_library(game, p1, [])\n241\t\n242\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n243\t        spell.on_resolve(game)  # must not raise\n244\t\n245\t        assert len(_exiled(game, p1)) == 0\n246\t\n247\t    def test_zero_mana_value_card_does_not_stop_the_loop(self) -> None:\n248\t        \"\"\"A {0} card adds 0 to the total — the loop must keep exiling until\n249\t        the cumulative MV actually reaches 4.\"\"\"\n250\t        game = create_game()\n251\t        p1 = game.players[0]\n252\t        zero = _instant(\"Free Spell\", \"{0}\")  # MV 0\n253\t        four = _creature(\"Four Drop\", \"{4}\")  # MV 4\n254\t        rest = _instant(\"Rest\", \"{1}\")\n255\t        _set_library(game, p1, [rest, four, zero])  # zero on top\n256\t\n257\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n258\t        spell.on_resolve(game)\n259\t\n260\t        exiled = _exiled(game, p1)\n261\t        assert zero in exiled and four in exiled\n262\t        assert rest not in exiled\n263\t        assert len(exiled) == 2\n264\t\n265\t    def test_exiled_cards_leave_the_library(self) -> None:\n266\t        \"\"\"Cards moved to exile must no longer be in the library.\"\"\"\n267\t        game = create_game()\n268\t        p1 = game.players[0]\n269\t        a = _creature(\"A\", \"{4}\")\n270\t        rest = _instant(\"Rest\", \"{2}\")\n271\t        _set_library(game, p1, [rest, a])\n272\t\n273\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n274\t        spell.on_resolve(game)\n275\t\n276\t        assert not game.get_library(p1).contains(a)\n277\t        assert game.get_library(p1).contains(rest)\n278\t\n279\t\n280\t# ---------------------------------------------------------------------------\n281\t# Clause 2 — Cast any number of the exiled spells for free"}]},"parent_tool_use_id":"toolu_01XUFaNngQiH9GQk6NcaNa87","session_id":"7c2fbc8b