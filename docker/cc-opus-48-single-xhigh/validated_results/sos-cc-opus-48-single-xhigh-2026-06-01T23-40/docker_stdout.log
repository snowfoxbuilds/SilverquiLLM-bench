{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UMPi4scw2Xyy2Gg6qEuKrd","type":"tool_result","content":"1\t\"\"\"Casting and resolution pipeline for spells and lands.\n2\t\n3\tProvides the full flow from casting a spell or playing a land through\n4\tresolution:\n5\t\n6\t- :func:`cast_spell` — verify timing & legality → move hand to stack →\n7\t  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n8\t- :func:`play_land` — verify land play remaining → move hand to\n9\t  battlefield → decrement ``land_plays_remaining``.\n10\t- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n11\t  helpers used by the casting pipeline.\n12\t\n13\tResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\n14\tcreated by :func:`cast_spell`:\n15\t\n16\t- Call ``card.on_resolve(game)``.\n17\t- Permanents (creature / enchantment / artifact / planeswalker) move from\n18\t  the stack to the battlefield.\n19\t- Non-permanents (instant / sorcery) move to the graveyard.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import TYPE_CHECKING, Any\n25\t\n26\tfrom engine.card import CardImpl\n27\tfrom engine.stack import StackObject\n28\tfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\n29\tfrom engine.zones import move_zone\n30\t\n31\tif TYPE_CHECKING:\n32\t    from engine.game_state import GameState\n33\t    from engine.player import Player\n34\t\n35\t\n36\t# Card types that represent permanents — these go to the battlefield on resolve.\n37\t_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n38\t    CardType.CREATURE,\n39\t    CardType.ENCHANTMENT,\n40\t    CardType.ARTIFACT,\n41\t    CardType.PLANESWALKER,\n42\t})\n43\t\n44\t\n45\tclass CastingError(Exception):\n46\t    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n47\t\n48\t\n49\t# ------------------------------------------------------------------\n50\t# Timing helpers\n51\t# ------------------------------------------------------------------\n52\t\n53\tdef is_sorcery_speed(game: GameState, player: Player) -> bool:\n54\t    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n55\t\n56\t    Sorcery speed requires all of:\n57\t\n58\t    * *player* is the active player.\n59\t    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n60\t      ``POSTCOMBAT_MAIN``).\n61\t    * The stack is empty.\n62\t    \"\"\"\n63\t    if player is not game.active_player:\n64\t        return False\n65\t    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n66\t        return False\n67\t    if not game.stack.is_empty():\n68\t        return False\n69\t    return True\n70\t\n71\t\n72\tdef can_cast_at_instant_speed(card: CardImpl) -> bool:\n73\t    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n74\t\n75\t    A card has instant-speed timing if it is an instant or has the\n76\t    :attr:`~engine.types.Keyword.FLASH` keyword.\n77\t    \"\"\"\n78\t    if CardType.INSTANT in card.card_types:\n79\t        return True\n80\t    if Keyword.FLASH & card.keywords:\n81\t        return True\n82\t    return False\n83\t\n84\t\n85\t# ------------------------------------------------------------------\n86\t# Cost reduction\n87\t# ------------------------------------------------------------------\n88\t\n89\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n90\t    \"\"\"Return the generic mana reduction for casting *card*.\n91\t\n92\t    Queries ``card.cost_reduction(game)`` and clamps the result so that\n93\t    the generic portion of the mana cost cannot go below 0.\n94\t\n95\t    This is a simplified single-card self-reduction model.  Full MTG\n96\t    cost-reduction interactions (Trinisphere, multiple reductions from\n97\t    different sources) are deferred.\n98\t    \"\"\"\n99\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n100\t    # casting player even when the card was never explicitly assigned one.\n101\t    prev_controller = card.controller\n102\t    card.controller = controller\n103\t    raw = card.cost_reduction(game)\n104\t    # Restore previous controller in case the caller doesn't want a\n105\t    # side-effect (get_cost_reduction is a query, not a mutation).\n106\t    card.controller = prev_controller\n107\t    generic = card.mana_cost.generic if card.mana_cost else 0\n108\t    return max(0, min(raw, generic))\n109\t\n110\t\n111\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n112\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n113\t    new_generic = max(0, cost.generic - reduction)\n114\t    return ManaCost(\n115\t        generic=new_generic,\n116\t        pips=dict(cost.pips),\n117\t        x_count=cost.x_count,\n118\t        hybrid=list(cost.hybrid),\n119\t    )\n120\t\n121\t\n122\t# ------------------------------------------------------------------\n123\t# Cast spell\n124\t# ------------------------------------------------------------------\n125\t\n126\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n127\t    \"\"\"Cast *card* from *player*'s hand.\n128\t\n129\t    Pipeline\n130\t    --------\n131\t    1. **Timing check** — instants (and cards with flash) can be cast\n132\t       whenever the player has priority; everything else requires\n133\t       sorcery-speed timing.\n134\t    2. **can_cast** — ask the card whether it can legally be cast.\n135\t    3. **Hand check** — the card must be in the player's hand.\n136\t    4. **Move hand → stack zone** — remove the card from the hand and\n137\t       place it into the player's stack zone.\n138\t    5. **Choose targets** — if the card specifies targets (via\n139\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n140\t    6. **Mana check / payment** — the player's mana pool must be able to\n141\t       pay the card's mana cost.  If payment fails, the card is rolled\n142\t       back from the stack zone to the hand.\n143\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n144\t    8. **Push StackObject** — push a :class:`StackObject` whose\n145\t       ``on_resolve`` callback handles resolution.\n146\t\n147\t    Raises:\n148\t        CastingError: If any legality check fails.\n149\t    \"\"\"\n150\t    # 1. Timing\n151\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n152\t        raise CastingError(\n153\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n154\t        )\n155\t\n156\t    # 2. can_cast\n157\t    if not card.can_cast(game):\n158\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n159\t\n160\t    # 3. Hand check\n161\t    hand = game.get_hand(player)\n162\t    if not hand.contains(card):\n163\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n164\t\n165\t    # 4. Move card from hand to stack zone\n166\t    stack_zone = player.zones[Zone.STACK]\n167\t    hand.remove(card)\n168\t    stack_zone.add(card)\n169\t\n170\t    # Clear any stale colors_spent / mana_spent from a prior cast before\n171\t    # new payment.\n172\t    if hasattr(card, \"colors_spent\"):\n173\t        del card.colors_spent\n174\t    if hasattr(card, \"mana_spent\"):\n175\t        del card.mana_spent\n176\t\n177\t    # 5. Choose targets\n178\t    target_specs = card.get_targets(game)\n179\t    chosen_targets: list[Any] = []\n180\t    if target_specs:\n181\t        for spec in target_specs:\n182\t            target = player.choose_target(target_specs, spec)\n183\t            # Validate against filter_fn if the spec provides one\n184\t            filter_fn = getattr(spec, \"filter_fn\", None)\n185\t            if filter_fn is not None and target is not None:\n186\t                if not filter_fn(target):\n187\t                    stack_zone.remove(card)\n188\t                    hand.add(card)\n189\t                    raise CastingError(\n190\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n191\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n192\t                    )\n193\t            chosen_targets.append(target)\n194\t\n195\t    # 5b. Protection check — reject targets that have protection from this\n196\t    #     spell (the T in DEBT).\n197\t    from engine.protection import has_protection_from\n198\t\n199\t    for target in chosen_targets:\n200\t        if has_protection_from(target, card):\n201\t            # Rollback: move card from stack zone back to hand\n202\t            stack_zone.remove(card)\n203\t            hand.add(card)\n204\t            raise CastingError(\n205\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n206\t            )\n207\t\n208\t    # Targets are stored on the StackObject (not the card) and passed\n209\t    # through the resolve pipeline via on_resolve(game, targets=...).\n210\t\n211\t    # 6. Mana check / payment (rollback on failure)\n212\t    # Ensure the card knows its controller so that cost_reduction() hooks\n213\t    # (e.g. Embercleave counting attacking creatures you control) see the\n214\t    # casting player, even for cards that were added to hand without an\n215\t    # explicit controller assignment.\n216\t    if card.controller is None:\n217\t        card.controller = player\n218\t    reduction = get_cost_reduction(game, card, player)\n219\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n220\t\n221\t    if not player.mana_pool.can_pay(effective_cost):\n222\t        # Rollback: move card from stack zone back to hand\n223\t        stack_zone.remove(card)\n224\t        hand.add(card)\n225\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n226\t\n227\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n228\t    player.mana_pool.pay(effective_cost)\n229\t\n230\t    # Store colors of mana spent on the card for mechanics like Converge\n231\t    # that care about the colors used to cast the spell.\n232\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n233\t\n234\t    # Store the TOTAL amount of mana spent (converted, after cost reduction)\n235\t    # for mechanics that reimburse / count the mana paid to cast the spell\n236\t    # (e.g. Mana Sculpt). Additive and backward-compatible — defaults absent.\n237\t    card.mana_spent = effective_cost.cmc  # type: ignore[attr-defined]\n238\t\n239\t    # 7. Call on_cast hook\n240\t    card.on_cast(game)\n241\t\n242\t    # 8. Build on_resolve callback and push StackObject\n243\t    stack_obj = StackObject(\n244\t        source=card,\n245\t        controller=player,\n246\t        targets=chosen_targets,\n247\t        on_resolve=lambda g: None,  # replaced below\n248\t    )\n249\t\n250\t    def _on_resolve(g: GameState) -> None:\n251\t        _resolve_spell(g, card, player, stack_obj)\n252\t\n253\t    stack_obj.on_resolve = _on_resolve\n254\t    game.stack.push(stack_obj)\n255\t\n256\t\n257\t# ------------------------------------------------------------------\n258\t# Cast spell without paying mana cost (free-cast from any zone)\n259\t# ------------------------------------------------------------------\n260\t\n261\t\n262\tdef cast_spell_free(\n263\t    game: GameState,\n264\t    player: Player,\n265\t    card: CardImpl,\n266\t    from_zone: Zone,\n267\t) -> None:\n268\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n269\t\n270\t    This is used by effects that allow casting from zones other than hand\n271\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n272\t    or cascade.\n273\t\n274\t    Pipeline\n275\t    --------\n276\t    1. **can_cast** — ask the card whether it can legally be cast (same\n277\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n278\t    2. Move *card* from *from_zone* to the stack zone.\n279\t    3. Choose targets (if applicable) with validation and protection check.\n280\t    4. Call ``on_cast`` hook.\n281\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n282\t       resolution normally (permanents → battlefield, non-permanents →\n283\t       graveyard).\n284\t\n285\t    No timing check or mana payment is performed.  The spell goes on the\n286\t    stack and can be responded to normally (e.g. countered).\n287\t\n288\t    If targeting or other post-move checks fail, the card is rolled back\n289\t    to its source zone.\n290\t\n291\t    Parameters:\n292\t        game: The current game state.\n293\t        player: The player casting the spell.\n294\t        card: The card to cast.\n295\t        from_zone: The zone the card is currently in.\n296\t\n297\t    Raises:\n298\t        CastingError: If the card cannot be found in *from_zone* or\n299\t            legality checks fail.\n300\t    \"\"\"\n301\t    from engine.zones import move_to_zone\n302\t\n303\t    # Ensure controller is set\n304\t    card.controller = player\n305\t    if card.owner is None:\n306\t        card.owner = player\n307\t\n308\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n309\t    if not card.can_cast(game):\n310\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n311\t\n312\t    # 2. Locate card in source zone\n313\t    source_zone_container = player.zones[from_zone]\n314\t    if not source_zone_container.contains(card):\n315\t        # Try to find the card in any player's zone\n316\t        source_zone_container = None\n317\t        for p in game.players:\n318\t            z = p.zones[from_zone]\n319\t            if z.contains(card):\n320\t                source_zone_container = z\n321\t                break\n322\t\n323\t    if source_zone_container is None or not source_zone_container.contains(card):\n324\t        raise CastingError(\n325\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n326\t        )\n327\t\n328\t    # Move card from source zone to stack zone\n329\t    stack_zone = player.zones[Zone.STACK]\n330\t    source_zone_container.remove(card)\n331\t    stack_zone.add(card)\n332\t\n333\t    # 3. Choose targets (with rollback on failure)\n334\t    try:\n335\t        target_specs = card.get_targets(game)\n336\t        chosen_targets: list[Any] = []\n337\t        if target_specs:\n338\t            for spec in target_specs:\n339\t                target = player.choose_target(target_specs, spec)\n340\t                # Validate against filter_fn if the spec provides one\n341\t                filter_fn = getattr(spec, \"filter_fn\", None)\n342\t                if filter_fn is not None and target is not None:\n343\t                    if not filter_fn(target):\n344\t                        raise CastingError(\n345\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n346\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n347\t                        )\n348\t                chosen_targets.append(target)\n349\t\n350\t        # Protection check — reject targets that have protection from this spell\n351\t        from engine.protection import has_protection_from\n352\t\n353\t        for target in chosen_targets:\n354\t            if has_protection_from(target, card):\n355\t                raise CastingError(\n356\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n357\t                )\n358\t    except Exception as exc:\n359\t        # Rollback: move card from stack zone back to source zone\n360\t        stack_zone.remove(card)\n361\t        source_zone_container.add(card)\n362\t        raise CastingError(str(exc)) from exc\n363\t\n364\t    # Free casts pay no mana, so the total mana spent is 0.\n365\t    card.mana_spent = 0  # type: ignore[attr-defined]\n366\t\n367\t    # 4. Call on_cast hook\n368\t    card.on_cast(game)\n369\t\n370\t    # 5. Build on_resolve callback and push StackObject\n371\t    stack_obj = StackObject(\n372\t        source=card,\n373\t        controller=player,\n374\t        targets=chosen_targets,\n375\t        on_resolve=lambda g: None,  # replaced below\n376\t    )\n377\t\n378\t    def _on_resolve(g: GameState) -> None:\n379\t        _resolve_spell(g, card, player, stack_obj)\n380\t\n381\t    stack_obj.on_resolve = _on_resolve\n382\t    game.stack.push(stack_obj)\n383\t\n384\t\n385\t# ------------------------------------------------------------------\n386\t# Resolution (called when the stack pops)\n387\t# ------------------------------------------------------------------\n388\t\n389\tdef _resolve_spell(\n390\t    game: GameState,\n391\t    card: CardImpl,\n392\t    player: Player,\n393\t    stack_obj: StackObject,\n394\t) -> None:\n395\t    \"\"\"Resolve *card* cast by *player*.\n396\t\n397\t    1. Call ``card.on_resolve(game, targets=targets)``.\n398\t    2. Remove the card from the stack zone.\n399\t    3. If the card is a permanent type, move it to the battlefield via\n400\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n401\t       registration and the ETB event).\n402\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n403\t    \"\"\"\n404\t    from engine.zones import move_to_zone\n405\t\n406\t    # Read targets from the StackObject — the single source of truth.\n407\t    # Set chosen_targets on the card just before resolution so that\n408\t    # _get_chosen_target helpers (which read via getattr) work.\n409\t    targets = stack_obj.targets\n410\t    if targets is not None:\n411\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n412\t\n413\t    card.on_resolve(game)\n414\t\n415\t    if card.card_types & _PERMANENT_TYPES:\n416\t        # Move from stack to battlefield via move_to_zone, which handles\n417\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n418\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n419\t    else:\n420\t        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n421\t        # Some effects (e.g. The Dawning Archaic's free cast) attach a\n422\t        # per-spell replacement: \"If that spell would be put into your\n423\t        # graveyard, exile it instead.\" Honour that opt-in flag here.\n424\t        destination = Zone.GRAVEYARD\n425\t        if getattr(card, \"_exile_instead_of_graveyard\", False):\n426\t            destination = Zone.EXILE\n427\t            # One-shot replacement: clear the flag now that it has applied.\n428\t            try:\n429\t                del card._exile_instead_of_graveyard\n430\t            except AttributeError:  # pragma: no cover - defensive\n431\t                card._exile_instead_of_graveyard = False\n432\t        move_to_zone(game, card, Zone.STACK, destination)\n433\t\n434\t\n435\t# ------------------------------------------------------------------\n436\t# Play land (special action — does not use the stack)\n437\t# ------------------------------------------------------------------\n438\t\n439\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n440\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n441\t\n442\t    Requirements (all must hold):\n443\t\n444\t    * *land_card* has :attr:`CardType.LAND`.\n445\t    * *player* is the active player.\n446\t    * Current phase is a main phase.\n447\t    * The stack is empty.\n448\t    * ``player.land_plays_remaining > 0``.\n449\t    * The card is in the player's hand.\n450\t\n451\t    On success the card moves from hand to battlefield and\n452\t    ``land_plays_remaining`` is decremented.\n453\t\n454\t    Raises:\n455\t        CastingError: If any requirement is not met.\n456\t    \"\"\"\n457\t    # Must be a land\n458\t    if CardType.LAND not in land_card.card_types:\n459\t        raise CastingError(\n460\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n461\t        )\n462\t\n463\t    # Sorcery-speed timing (active player, main phase, stack empty)\n464\t    if not is_sorcery_speed(game, player):\n465\t        raise CastingError(\n466\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n467\t            \"during main phase with empty stack\"\n468\t        )\n469\t\n470\t    # Land plays remaining\n471\t    if player.land_plays_remaining <= 0:\n472\t        raise CastingError(\n473\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n474\t        )\n475\t\n476\t    # Card must be in hand\n477\t    hand = game.get_hand(player)\n478\t    if not hand.contains(land_card):\n479\t        raise CastingError(\n480\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n481\t        )\n482\t\n483\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n484\t    if land_card.owner is None:\n485\t        land_card.owner = player\n486\t    land_card.controller = player\n487\t\n488\t    # Move from hand to battlefield via move_to_zone, which fires\n489\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n490\t    from engine.zones import move_to_zone\n491\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n492\t\n493\t    # Decrement land plays\n494\t    player.land_plays_remaining -= 1\n495\t\n496\t\n497\tdef resolve_top(game: GameState) -> None:\n498\t    \"\"\"Resolve the top spell/ability on the stack.\n499\t\n500\t    Pops the top item from the stack, calls its on_resolve callback,\n501\t    then runs state-based actions.  If the stack is empty this is a no-op.\n502\t    \"\"\"\n503\t    if game.stack.is_empty():\n504\t        return\n505\t    from engine.state_based_actions import resolve_state_based_actions\n506\t\n507\t    obj = game.stack.pop()\n508\t    obj.on_resolve(game)\n509\t    resolve_state_based_actions(game)\n510\t"}]},"parent_tool_use_id":"toolu_0117GXqJ3qNucMV54hnuyWVy","session_id":"7c2fbc8b-9529-4254-888d-bbf9dd1c7145","uuid":"d930c169-1f9d-404e-9b2b-c4d70f806be4","timestamp":"2026-06-02T00:37:28.926Z","subagent_type":"Implementer","task_description":"Revise sos_57 spell/ability distinction"}
