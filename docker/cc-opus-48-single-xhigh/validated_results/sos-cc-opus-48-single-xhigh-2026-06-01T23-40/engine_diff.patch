+def _offer_miracle(game: GameState, player: Player, card: Any) -> None:
+    """Offer to cast *card* for a granted miracle cost at draw time.
+
+    Gated so it does nothing unless BOTH hold:
+
+    * ``card`` is *player*'s first card drawn this turn
+      (``player.cards_drawn_this_turn == 1``), and
+    * a permanent *player* controls advertises a ``grants_miracle_to(card)``
+      capability returning a non-``None`` :class:`~engine.types.ManaCost`.
+
+    When both hold, ``card.miracle_cost`` is stamped and the player is asked
+    (via ``choose_yes_no``) whether to cast it for the miracle cost. On yes,
+    the card is cast from hand via the alternative-cost casting surface.
+
+    The miracle "window" is modelled as an immediate at-draw offer rather than
+    the full reveal → triggered ability → cast-before-next-step sequence; this
+    is deterministic and sufficient for the engine.
+    """
+    # (a) First card drawn this turn.
+    if getattr(player, "cards_drawn_this_turn", 0) != 1:
+        return
+
+    # (b) A controlled permanent grants miracle to this card.
+    miracle_cost = None
+    battlefield = player.zones[Zone.BATTLEFIELD]
+    for permanent in battlefield.get_all():
+        grant = getattr(permanent, "grants_miracle_to", None)
+        if grant is None:
+            continue
+        cost = grant(card)
+        if cost is not None:
+            miracle_cost = cost
+            break
+
+    if miracle_cost is None:
+        return
+
+    # Stamp the granted miracle cost so it is observable on the card.
+    card.miracle_cost = miracle_cost  # type: ignore[attr-defined]
+
+    # "You may cast it for its miracle cost." Offer the controller the choice.
+    if not player.choose_yes_no(
+        f"Cast {getattr(card, 'name', 'this card')!r} for its miracle cost?"
+    ):
+        return
+
+    from engine.casting import CastingError, cast_spell
+
+    try:
+        cast_spell(game, player, card, alternative_cost=miracle_cost)
+    except CastingError:
+        # Could not pay / cast (e.g. insufficient mana) — leave the card in
+        # hand, no state change beyond the stamped miracle_cost.
+        return
+
+
