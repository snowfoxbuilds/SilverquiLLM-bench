--- a/deferred.py	1970-01-01 00:00:00.000000000 +0000
+++ b/deferred.py	2026-06-02 00:29:00.143051094 +0000
@@ -0,0 +1,62 @@
+"""Delivery of delayed / one-shot deferred effects.
+
+The engine schedules one-shot effects that should run "at the beginning of a
+player's next (precombat) main phase" on
+:attr:`GameState.main_phase_deferred_effects` via
+:meth:`GameState.schedule_main_phase_deferred_effect`.
+
+This module delivers those effects when the matching
+:class:`~engine.events.BeginningOfMainPhaseTriggeredEvent` fires.  Delivery is
+invoked from :meth:`engine.triggers.TriggerManager.fire_event` so that firing
+the event (the way tests fire ETB events) runs the scheduled callbacks directly
+and removes them — they are one-shot.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+from engine.events import BeginningOfMainPhaseTriggeredEvent
+
+if TYPE_CHECKING:
+    from engine.game_state import GameState
+
+
+def deliver_main_phase_deferred_effects(
+    game: GameState,
+    event: BeginningOfMainPhaseTriggeredEvent,
+) -> None:
+    """Run and remove any deferred effects matching *event*.
+
+    A scheduled effect matches when its ``controller`` is the event's
+    controller/player and (when the effect requested ``precombat``) the event
+    is for the precombat main phase.  Matching effects run exactly once and
+    are removed from the registry.
+    """
+    pending = getattr(game, "main_phase_deferred_effects", None)
+    if not pending:
+        return
+
+    target = getattr(event, "controller", None) or getattr(event, "player", None)
+    is_precombat = getattr(event, "precombat", True)
+
+    remaining: list[dict] = []
+    to_run: list[dict] = []
+    for entry in pending:
+        if entry.get("controller") is not target:
+            remaining.append(entry)
+            continue
+        if entry.get("precombat", True) and not is_precombat:
+            # Effect wants the precombat main phase but this is postcombat.
+            remaining.append(entry)
+            continue
+        to_run.append(entry)
+
+    # Replace the registry first so callbacks that schedule further effects
+    # are not clobbered.
+    game.main_phase_deferred_effects = remaining
+
+    for entry in to_run:
+        callback = entry.get("callback")
+        if callback is not None:
+            callback(game)
