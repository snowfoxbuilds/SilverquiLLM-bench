 # ---------------------------------------------------------------------------
+# Coin flips (CR 705)
+# ---------------------------------------------------------------------------
+
+def flip_coin(game: GameState, player: Any = None) -> bool:
+    """Flip a single coin (CR 705) and return ``True`` for heads.
+
+    The randomness is deterministic and injectable so that tests can force
+    outcomes. The injection points, checked in order, are:
+
+    1. ``game._forced_coin_flips`` — a list/deque of pre-seeded booleans (or
+       truthy/falsy values). When present and non-empty, the next value is
+       popped from the *front* and used as the result. This is the simplest
+       way for a test to force a known number of heads.
+    2. ``game.rng`` — a ``random.Random``-compatible object. When present, the
+       result is ``game.rng.random() < 0.5``. A test can set
+       ``game.rng = random.Random(seed)`` for reproducible flips.
+    3. Otherwise a module-level ``random`` call is used.
+
+    Parameters:
+        game: The current game state.
+        player: The player flipping the coin (informational; unused by the
+            default RNG but accepted for API symmetry / future hooks).
+
+    Returns:
+        ``True`` for heads, ``False`` for tails.
+    """
+    forced = getattr(game, "_forced_coin_flips", None)
+    if forced:
+        # Support both lists and collections.deque (popleft) for the queue.
+        if hasattr(forced, "popleft"):
+            value = forced.popleft()
+        else:
+            value = forced.pop(0)
+        return bool(value)
+
+    rng = getattr(game, "rng", None)
+    if rng is not None:
+        return rng.random() < 0.5
+
+    import random as _random
+
+    return _random.random() < 0.5
+
+
+def flip_coins(game: GameState, n: int, player: Any = None) -> int:
+    """Flip *n* coins and return the number that came up heads.
+
+    Uses :func:`flip_coin` for each flip, so the same deterministic injection
+    points apply (``game._forced_coin_flips`` then ``game.rng``). See
+    :func:`flip_coin` for how a test forces specific results.
+
+    Parameters:
+        game: The current game state.
+        n: The number of coins to flip (``n <= 0`` returns 0).
+        player: The player flipping the coins (informational).
+
+    Returns:
+        The number of heads across the *n* flips.
+    """
+    if n <= 0:
+        return 0
+    return sum(1 for _ in range(n) if flip_coin(game, player))
+
+
