+def _granted_cost_reduction(
+    game: GameState, card: CardImpl, controller: Player
+) -> int:
+    """Return the cost reduction *granted* to *card* by other permanents.
+
+    Sums reductions granted by permanents *controller* controls that
+    advertise the affinity-grant capability (mirrors the SOS 226
+    ``grants_casualty_to`` / SOS 201 ``grants_miracle_to`` cast-time hooks):
+
+    * ``grants_affinity_to(spell) -> bool`` — truthy if the permanent grants
+      affinity to *card* (e.g. only instants/sorceries).
+    * ``affinity_reduction(game) -> int`` — the reduction value granted.
+
+    Capability probing is ``getattr``-safe because most permanents define
+    neither method. When no controlled permanent grants affinity to *card*,
+    this returns 0 with NO state change — so the default reduction path and
+    all engine regression tests stay byte-for-byte equivalent in the absence
+    of a grantor.
+    """
+    if controller is None:
+        return 0
+
+    battlefield = controller.zones[Zone.BATTLEFIELD]
+    total = 0
+    for permanent in battlefield.get_all():
+        # The granting permanent never reduces its own cast (it is on the
+        # battlefield, not on the stack), but guard anyway so a permanent that
+        # somehow grants to itself does not double-count.
+        if permanent is card:
+            continue
+        grants = getattr(permanent, "grants_affinity_to", None)
+        if grants is None:
+            continue
+        if not grants(card):
+            continue
+        reduce_fn = getattr(permanent, "affinity_reduction", None)
+        if reduce_fn is None:
+            continue
+        amount = reduce_fn(game)
+        if amount:
+            total += amount
+    return total
+
