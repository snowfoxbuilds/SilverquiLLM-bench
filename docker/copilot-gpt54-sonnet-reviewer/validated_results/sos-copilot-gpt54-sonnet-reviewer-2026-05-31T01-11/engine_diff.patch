+def _get_battlefield_cost_reduction(
+    game: GameState,
+    card: CardImpl,
+    controller: Player,
+) -> int:
+    """Collect additive generic cost reductions from permanents you control."""
+    reduction = 0
+    for permanent in list(game.get_battlefield(controller).get_all()):
+        hook = getattr(permanent, "on_controller_spell_cost_reduction", None)
+        if not callable(hook):
+            continue
+        granted = hook(game, controller, card)
+        if isinstance(granted, int) and granted > 0:
+            reduction += granted
+    return reduction
+
+
+def _apply_battlefield_spell_cast_hooks(
+    game: GameState,
+    player: Player,
+    card: CardImpl,
+    stack_obj: StackObject,
+) -> None:
+    """Let battlefield permanents grant extra abilities to spells their controller casts."""
+    for permanent in list(game.get_battlefield(player).get_all()):
+        hook = getattr(permanent, "on_controller_cast_spell", None)
+        if callable(hook):
+            hook(game, player, card, stack_obj)
+
+
+def _finish_cast(
+    game: GameState,
+    player: Player,
+    card: CardImpl,
+    stack_obj: StackObject,
+) -> None:
+    """Push a cast spell, fire cast triggers, and apply battlefield-granted hooks."""
+    game.stack.push(stack_obj)
+    game.trigger_manager.fire_event(
+        game,
+        SpellCastTriggeredEvent(
+            spell=card,
+            player=player,
+            card=card,
+            controller=player,
+        ),
+    )
+    _apply_battlefield_spell_cast_hooks(game, player, card, stack_obj)
+
+
