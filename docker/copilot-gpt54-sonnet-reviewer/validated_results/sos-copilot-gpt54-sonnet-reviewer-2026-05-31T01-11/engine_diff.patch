+    def schedule_for_next_main_phase(
+        self,
+        controller: Player,
+        effect: Any,
+    ) -> None:
+        """Schedule *effect* to run at *controller*'s next main phase."""
+        if controller is self.active_player and self.phase == Phase.BEGINNING:
+            target_phase = Phase.PRECOMBAT_MAIN
+            require_future_turn = False
+        elif controller is self.active_player and self.phase in (
+            Phase.PRECOMBAT_MAIN,
+            Phase.COMBAT,
+        ):
+            target_phase = Phase.POSTCOMBAT_MAIN
+            require_future_turn = False
+        else:
+            target_phase = Phase.PRECOMBAT_MAIN
+            require_future_turn = True
+
+        self._queue_delayed_main_phase_action(
+            {
+                "controller": controller,
+                "effect": effect,
+                "scheduled_turn": self.turn_number,
+                "target_phase": target_phase,
+                "require_future_turn": require_future_turn,
+            }
+        )
+
+    def schedule_for_first_main_phase(
+        self,
+        controller: Player,
+        effect: Any,
+        *,
+        require_future_turn: bool = True,
+    ) -> None:
+        """Schedule *effect* for *controller*'s precombat main phase."""
+        self._queue_delayed_main_phase_action(
+            {
+                "controller": controller,
+                "effect": effect,
+                "scheduled_turn": self.turn_number,
+                "target_phase": Phase.PRECOMBAT_MAIN,
+                "require_future_turn": require_future_turn,
+            }
+        )
+
+    def _queue_delayed_main_phase_action(self, action: dict[str, Any]) -> None:
+        """Queue a delayed main-phase action safely during processing."""
+        if self._processing_delayed_main_phase_actions:
+            self._pending_delayed_main_phase_actions.append(action)
+            return
+        self._delayed_main_phase_actions.append(action)
+
+    def _process_delayed_main_phase_actions(self) -> None:
+        """Run any delayed actions due at the current main phase."""
+        if self.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):
+            return
+
+        current_actions = list(self._delayed_main_phase_actions)
+        remaining: list[dict[str, Any]] = []
+        self._processing_delayed_main_phase_actions = True
+        self._pending_delayed_main_phase_actions = []
+        try:
+            for action in current_actions:
+                if self.active_player is not action["controller"]:
+                    remaining.append(action)
+                    continue
+                if self.phase != action["target_phase"]:
+                    remaining.append(action)
+                    continue
+                if action["require_future_turn"] and self.turn_number <= action["scheduled_turn"]:
+                    remaining.append(action)
+                    continue
+                action["effect"](self)
+        finally:
+            self._processing_delayed_main_phase_actions = False
+            self._delayed_main_phase_actions = (
+                remaining + self._pending_delayed_main_phase_actions
+            )
+            self._pending_delayed_main_phase_actions = []
