+def surveil(game: GameState, player: Player, count: int) -> list[Any]:
+    """Look at the top *count* cards, optionally binning and reordering them."""
+    if count <= 0:
+        return []
+
+    library = player.zones[Zone.LIBRARY]
+    graveyard = player.zones[Zone.GRAVEYARD]
+    looked_at = list(library.top(min(count, len(library))))
+    if not looked_at:
+        return []
+
+    kept_top_to_bottom: list[Any] = []
+    for card in reversed(looked_at):
+        put_into_graveyard = player.choose_yes_no(
+            f"Surveil: Put {getattr(card, 'name', 'card')} into your graveyard?"
+        )
+        if put_into_graveyard:
+            library.remove(card)
+            graveyard.add(card)
+        else:
+            kept_top_to_bottom.append(card)
+
+    if len(kept_top_to_bottom) > 1 and hasattr(player, "choose_order"):
+        ordered = player.choose_order(
+            list(kept_top_to_bottom),
+            "Choose the order of cards to keep on top of your library",
+        )
+        if ordered is not None and set(ordered) == set(kept_top_to_bottom):
+            kept_top_to_bottom = list(ordered)
+
+    for card in kept_top_to_bottom:
+        if library.contains(card):
+            library.remove(card)
+    for card in reversed(kept_top_to_bottom):
+        library.add(card, position="top")
+
+    return list(kept_top_to_bottom)
