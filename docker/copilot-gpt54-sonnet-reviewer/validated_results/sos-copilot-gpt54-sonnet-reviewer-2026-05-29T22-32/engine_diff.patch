+def _choose_loyalty_targets(
+    game: GameState,
+    player: Any,
+    ability: LoyaltyAbilityInstance,
+) -> list[Any]:
+    """Choose loyalty-ability targets from its exposed targeting metadata."""
+    requirements = ability.get_targets(game)
+    if not requirements:
+        return []
+
+    if len(requirements) == 1 and (
+        ability.max_targets is None
+        or ability.max_targets != 1
+        or ability.min_targets != 1
+    ):
+        legal_targets = _legal_targets_for_requirement(game, requirements[0])
+        max_targets = len(legal_targets) if ability.max_targets is None else min(
+            ability.max_targets, len(legal_targets)
+        )
+        if max_targets < ability.min_targets:
+            raise AbilityError("Cannot activate loyalty ability — not enough legal targets")
+        if max_targets == 0:
+            return []
+
+        chosen_count = max_targets
+        if ability.min_targets != max_targets:
+            options = list(range(ability.min_targets, max_targets + 1))
+            chosen_count = player.choose(
+                options,
+                f"Choose number of {ability.target_description}s",
+            )
+            if chosen_count not in options:
+                raise AbilityError("Cannot activate loyalty ability — illegal target count chosen")
+
+        remaining = list(legal_targets)
+        chosen_targets: list[Any] = []
+        for _ in range(chosen_count):
+            chosen = player.choose_target(remaining, ability.target_description)
+            if not any(target is chosen for target in remaining):
+                raise AbilityError("Cannot activate loyalty ability — illegal target chosen")
+            chosen_targets.append(chosen)
+            remaining = [target for target in remaining if target is not chosen]
+        return chosen_targets
+
+    chosen_targets = []
+    for requirement in requirements:
+        legal_targets = _legal_targets_for_requirement(game, requirement)
+        if not legal_targets:
+            raise AbilityError("Cannot activate loyalty ability — no legal targets")
+        chosen = player.choose_target(legal_targets, getattr(requirement, "description", "target"))
+        if not any(target is chosen for target in legal_targets):
+            raise AbilityError("Cannot activate loyalty ability — illegal target chosen")
+        chosen_targets.append(chosen)
+    return chosen_targets
+
+
+def _legal_targets_for_requirement(game: GameState, requirement: Any) -> list[Any]:
+    """Enumerate legal loyalty-ability targets for a TargetRequirement-like object."""
+    zone = getattr(requirement, "zone", None)
+    candidates: list[Any] = []
+
+    if zone is None:
+        candidates = list(game.players)
+    elif zone == Zone.BATTLEFIELD:
+        for player in game.players:
+            candidates.extend(player.zones[Zone.BATTLEFIELD].get_all())
+    elif zone == Zone.GRAVEYARD:
+        for player in game.players:
+            candidates.extend(player.zones[Zone.GRAVEYARD].get_all())
+    elif zone == Zone.HAND:
+        for player in game.players:
+            candidates.extend(player.zones[Zone.HAND].get_all())
+    elif zone == Zone.LIBRARY:
+        for player in game.players:
+            candidates.extend(player.zones[Zone.LIBRARY].get_all())
+    elif zone == Zone.EXILE:
+        for player in game.players:
+            candidates.extend(player.zones[Zone.EXILE].get_all())
+    elif zone == Zone.STACK:
+        candidates = [obj.source for obj in game.stack.objects()]
+
+    filter_fn = getattr(requirement, "filter_fn", None)
+    if filter_fn is None:
+        return list(candidates)
+    return [candidate for candidate in candidates if filter_fn(candidate)]
