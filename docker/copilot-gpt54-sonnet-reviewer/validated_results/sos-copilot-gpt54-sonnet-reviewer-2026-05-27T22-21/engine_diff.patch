+def _derive_colors_from_mana_cost(mana_cost: ManaCost | None) -> set[Color]:
+    """Derive canonical card colors from a mana cost."""
+    if mana_cost is None:
+        return set()
+
+    colors: set[Color] = set()
+    mana_to_color = {
+        ManaType.WHITE: Color.WHITE,
+        ManaType.BLUE: Color.BLUE,
+        ManaType.BLACK: Color.BLACK,
+        ManaType.RED: Color.RED,
+        ManaType.GREEN: Color.GREEN,
+    }
+
+    for mana_type in getattr(mana_cost, "pips", {}):
+        color = mana_to_color.get(mana_type)
+        if color is not None:
+            colors.add(color)
+
+    for hybrid_symbol in getattr(mana_cost, "hybrid", []):
+        color_a = mana_to_color.get(hybrid_symbol.option_a)
+        if color_a is not None:
+            colors.add(color_a)
+        color_b = mana_to_color.get(hybrid_symbol.option_b)
+        if color_b is not None:
+            colors.add(color_b)
+
+    return colors
