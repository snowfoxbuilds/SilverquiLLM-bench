+def _select_loyalty_targets(
+    game: GameState,
+    player: Any,
+    ability: LoyaltyAbilityInstance,
+) -> list[Any]:
+    """Choose loyalty-ability targets using the shared normal activation flow."""
+    requirements = getattr(ability, "target_requirements", [])
+    if callable(requirements):
+        requirements = requirements(game, ability.source)
+    if not requirements:
+        return []
+
+    chosen_targets: list[Any] = []
+    for requirement in requirements:
+        chosen_targets.extend(_choose_targets_for_requirement(game, player, requirement))
+    return chosen_targets
+
+
+def _choose_targets_for_requirement(
+    game: GameState,
+    player: Any,
+    requirement: Any,
+) -> list[Any]:
+    """Choose and validate targets for one requirement entry."""
+    options_getter = getattr(requirement, "options_getter", None)
+    filter_fn = getattr(requirement, "filter_fn", None)
+    min_targets = max(0, int(getattr(requirement, "min_targets", 1)))
+    max_targets = max(min_targets, int(getattr(requirement, "max_targets", 1)))
+    allow_duplicates = bool(getattr(requirement, "allow_duplicates", False))
+
+    legal_options = None
+    if callable(options_getter):
+        legal_options = list(options_getter(game))
+        if filter_fn is not None:
+            legal_options = [option for option in legal_options if filter_fn(option)]
+
+    if min_targets == 1 and max_targets == 1:
+        target = player.choose_target(
+            legal_options if legal_options is not None else [],
+            requirement,
+        )
+        _validate_target_selection(
+            requirement,
+            [target],
+            legal_options=legal_options,
+            min_targets=min_targets,
+            max_targets=max_targets,
+            allow_duplicates=allow_duplicates,
+        )
+        return [target]
+
+    selection = player.choose(
+        legal_options if legal_options is not None else [],
+        getattr(requirement, "description", "Choose targets"),
+    )
+    normalized = _normalize_target_selection(selection)
+    _validate_target_selection(
+        requirement,
+        normalized,
+        legal_options=legal_options,
+        min_targets=min_targets,
+        max_targets=max_targets,
+        allow_duplicates=allow_duplicates,
+    )
+    return normalized
+
+
+def _normalize_target_selection(selection: Any) -> list[Any]:
+    """Normalize a target selection into a list."""
+    if selection is None:
+        return []
+    if isinstance(selection, list):
+        return list(selection)
+    if isinstance(selection, tuple):
+        return list(selection)
+    if isinstance(selection, set):
+        return list(selection)
+    return [selection]
+
+
+def _validate_target_selection(
+    requirement: Any,
+    targets: list[Any],
+    *,
+    legal_options: list[Any] | None,
+    min_targets: int,
+    max_targets: int,
+    allow_duplicates: bool,
+) -> None:
+    """Validate one chosen target group."""
+    if not min_targets <= len(targets) <= max_targets:
+        raise AbilityError(
+            f"Invalid target count for {getattr(requirement, 'description', 'ability')!r}"
+        )
+
+    if not allow_duplicates:
+        seen: set[int] = set()
+        for target in targets:
+            target_id = id(target)
+            if target_id in seen:
+                raise AbilityError("Duplicate targets are not allowed for this ability")
+            seen.add(target_id)
+
+    filter_fn = getattr(requirement, "filter_fn", None)
+    for target in targets:
+        if legal_options is not None and target not in legal_options:
+            raise AbilityError("Chosen target is not among the legal options")
+        if filter_fn is not None and not filter_fn(target):
+            raise AbilityError(
+                f"Chosen target does not satisfy filter: "
+                f"{getattr(requirement, 'description', '')}"
+            )
