+
+    def schedule_skip_next_turn(self, player: Player, count: int = 1) -> None:
+        """Schedule *player* to skip their next ``count`` turns."""
+        if count <= 0:
+            return
+        try:
+            player_index = self.players.index(player)
+        except ValueError:
+            return
+        self._skip_next_turns[player_index] = self._skip_next_turns.get(player_index, 0) + count
+
+    def get_scheduled_skipped_turns(self, player: Player) -> int:
+        """Return how many upcoming turns *player* is scheduled to skip."""
+        try:
+            player_index = self.players.index(player)
+        except ValueError:
+            return 0
+        return self._skip_next_turns.get(player_index, 0)
+
+    def _choose_next_active_player_index(self) -> int:
+        """Choose the next turn's active player, respecting extra and skipped turns."""
+        while True:
+            from_extra_turn = bool(self.extra_turns)
+            if from_extra_turn:
+                candidate = self.extra_turns.pop(0)
+            else:
+                candidate = self._normal_next_index
+                self._normal_next_index = 1 - self._normal_next_index
+
+            skipped = self._skip_next_turns.get(candidate, 0)
+            if skipped > 0:
+                self._skip_next_turns[candidate] = skipped - 1
+                continue
+
+            return candidate
