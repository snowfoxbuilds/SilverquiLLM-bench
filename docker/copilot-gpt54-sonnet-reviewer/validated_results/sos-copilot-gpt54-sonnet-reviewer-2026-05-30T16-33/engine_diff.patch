+    def record_card_draw(self, player: Player, card: Any) -> None:
+        """Track per-turn draw order and the current miracle draw window."""
+        draw_count = getattr(player, "cards_drawn_this_turn", 0) + 1
+        player.cards_drawn_this_turn = draw_count
+        card._drawn_turn_number = self.turn_number
+        card._drawn_by_player = player
+        card._is_first_card_drawn_this_turn = draw_count == 1
+
+    def is_miracle_draw_window(self, player: Player, card: Any) -> bool:
+        """Return ``True`` if *card* is still in the first-draw miracle window."""
+        if player is None or card is None:
+            return False
+        if not self.get_hand(player).contains(card):
+            return False
+        if getattr(card, "_drawn_by_player", None) is not player:
+            return False
+        if getattr(card, "_drawn_turn_number", None) != self.turn_number:
+            return False
+        return bool(getattr(card, "_is_first_card_drawn_this_turn", False))
+
+    def get_miracle_cost(self, player: Player, card: Any) -> "ManaCost | None":
+        """Return the current miracle cost available to *card*, if any."""
+        if not self.is_miracle_draw_window(player, card):
+            return None
+
+        for permanent in self.get_battlefield(player).get_all():
+            get_cost = getattr(permanent, "get_miracle_cost_for", None)
+            if not callable(get_cost):
+                continue
+            cost = get_cost(self, player, card)
+            if cost is not None:
+                return cost
+        return None
+
+    def can_cast_via_miracle(self, player: Player, card: Any) -> bool:
+        """Return whether *card* currently has a miracle alternate cost."""
+        return self.get_miracle_cost(player, card) is not None
+
+    def get_casualty_offers(self, player: Player, spell: Any) -> list[dict[str, Any]]:
+        """Return casualty grants currently applying to *spell* for *player*."""
+        offers: list[dict[str, Any]] = []
+        for permanent in self.get_battlefield(player).get_all():
+            get_value = getattr(permanent, "get_casualty_value_for", None)
+            if not callable(get_value):
+                continue
+            value = get_value(self, player, spell)
+            if value is None:
+                continue
+            metadata = getattr(permanent, "keyword_metadata", {}).get("Casualty", {})
+            minimum_power = metadata.get("minimum_power", value)
+            offers.append(
+                {
+                    "source": permanent,
+                    "amount": value,
+                    "minimum_power": minimum_power,
+                }
+            )
+        return offers
+
+    def get_affinity_reduction(self, player: Player, spell: Any) -> int:
+        """Return granted affinity-style generic reduction for *spell*."""
+        reduction = 0
+        for permanent in self.get_battlefield(player).get_all():
+            get_value = getattr(permanent, "get_affinity_reduction_for", None)
+            if not callable(get_value):
+                continue
+            value = get_value(self, player, spell)
+            if value is None:
+                continue
+            reduction += int(value)
+        return reduction
+
+    def get_casualty_candidates(self, player: Player, minimum_power: int) -> list[Any]:
+        """Return creatures *player* could sacrifice to satisfy casualty."""
+        candidates: list[Any] = []
+        for permanent in self.get_battlefield(player).get_all():
+            card_types = getattr(permanent, "card_types", set())
+            if CardType.CREATURE not in card_types:
+                continue
+            if getattr(permanent, "power", 0) < minimum_power:
+                continue
+            candidates.append(permanent)
+        return candidates
+
+    def choose_casualty_payment(
+        self,
+        player: Player,
+        spell: Any,
+        offers: list[dict[str, Any]] | None = None,
+    ) -> dict[str, Any] | None:
+        """Choose whether to pay a casualty cost for *spell*."""
+        available_offers = offers if offers is not None else self.get_casualty_offers(player, spell)
+        for offer in available_offers:
+            minimum_power = int(offer.get("minimum_power", 0))
+            candidates = self.get_casualty_candidates(player, minimum_power)
+            if not candidates:
+                continue
+            if not player.choose_yes_no(
+                f"Pay casualty {offer.get('amount', 0)} for {getattr(spell, 'name', 'spell')}?"
+            ):
+                continue
+            chosen = player.choose(
+                candidates,
+                f"Choose creature to sacrifice for casualty {offer.get('amount', 0)}",
+            )
+            if chosen not in candidates:
+                chosen = candidates[0]
+            return {
+                **offer,
+                "creature": chosen,
+                "paid": False,
+            }
+        return None
+
+    def pay_casualty_cost(self, player: Player, payment: dict[str, Any] | None) -> dict[str, Any] | None:
+        """Sacrifice the chosen casualty creature and mark the payment as paid."""
+        if payment is None:
+            return None
+        creature = payment.get("creature")
+        if creature is None:
+            return None
+        from engine.game import sacrifice
+
+        sacrifice(self, player, creature)
+        payment["paid"] = True
+        return payment
+
+    def schedule_for_next_main_phase(self, player: Player, callback: Any) -> None:
+        """Schedule *callback* for the next main phase of *player*.
+
+        The callback is invoked once as ``callback(game)`` the next time the
+        specified player becomes the active player during either main phase.
+        """
+        pending = getattr(self, "_next_main_phase_callbacks", None)
+        if pending is None:
+            pending = []
+            self._next_main_phase_callbacks = pending
+        pending.append({"player": player, "callback": callback})
+
+    def schedule_for_each_first_main_phase(self, player: Player, callback: Any) -> None:
+        """Schedule *callback* for each future first main phase of *player*.
+
+        The callback is invoked as ``callback(game)`` whenever *player* becomes
+        the active player during their precombat main phase. If the callback
+        returns ``False``, it is removed; any other return value keeps it.
+        """
+        self._first_main_phase_callbacks.append({"player": player, "callback": callback})
+
+    def _handle_delayed_main_phase_effects(self) -> None:
+        """Resolve delayed callbacks waiting for a player's next main phase."""
+        if self.phase in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):
+            pending = getattr(self, "_next_main_phase_callbacks", None)
+            if pending:
+                remaining: list[dict[str, Any]] = []
+                for item in pending:
+                    if item.get("player") is self.active_player:
+                        callback = item.get("callback")
+                        if callable(callback):
+                            callback(self)
+                    else:
+                        remaining.append(item)
+                self._next_main_phase_callbacks = remaining
+
+        if self.phase is not Phase.PRECOMBAT_MAIN:
+            return
+
+        if not self._first_main_phase_callbacks:
+            return
+
+        remaining_first_main: list[dict[str, Any]] = []
+        for item in self._first_main_phase_callbacks:
+            if item.get("player") is not self.active_player:
+                remaining_first_main.append(item)
+                continue
+
+            callback = item.get("callback")
+            keep = True
+            if callable(callback):
+                result = callback(self)
+                if result is False:
+                    keep = False
+            if keep:
+                remaining_first_main.append(item)
+
+        self._first_main_phase_callbacks = remaining_first_main
+
+    def _reset_cards_drawn_this_turn(self) -> None:
+        """Reset each player's per-turn draw count."""
+        for player in self.players:
+            player.cards_drawn_this_turn = 0
+
+    # ------------------------------------------------------------------
+    # Coin flips
+    # ------------------------------------------------------------------
+
+    def queue_coin_flip_results(self, results: list[bool]) -> None:
+        """Append scripted coin-flip results for deterministic tests."""
+        self._scripted_coin_flips.extend(bool(result) for result in results)
+
+    def flip_coin(self) -> bool:
+        """Return ``True`` for heads and ``False`` for tails.
+
+        Uses queued scripted results first for deterministic tests, then falls
+        back to pseudo-random flips.
+        """
+        if self._scripted_coin_flips:
+            result = self._scripted_coin_flips.pop(0)
+        else:
+            result = random.choice((True, False))
+        self.last_coin_flip_results.append(result)
+        return result
+
+    # ------------------------------------------------------------------
+    # Skip-next-turn support
