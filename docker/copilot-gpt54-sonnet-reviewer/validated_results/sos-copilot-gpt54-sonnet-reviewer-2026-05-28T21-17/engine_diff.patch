+def _grant_miracle_if_applicable(game: GameState, player: Player, card: Any) -> None:
+    """Grant miracle metadata to a newly drawn card when a battlefield effect allows it."""
+    if getattr(player, "cards_drawn_this_turn", 0) != 1:
+        return
+
+    battlefield = game.get_battlefield(player)
+    for permanent in battlefield.get_all():
+        miracle_cost_for = getattr(permanent, "miracle_cost_for", None)
+        if not callable(miracle_cost_for):
+            continue
+        miracle_cost = miracle_cost_for(game, player, card)
+        if miracle_cost is None:
+            continue
+        card._miracle_cost_override = miracle_cost
+        card._miracle_eligible = True
+        return
+
+
+def mill_cards(game: GameState, player: Player, count: int) -> list[Any]:
+    """Mill *count* cards from *player*'s library to graveyard in deterministic top-first order."""
+    from engine.zones import move_to_zone
+
+    if count <= 0:
+        return []
+
+    library = player.zones[Zone.LIBRARY]
+    milled: list[Any] = []
+    for _ in range(min(count, len(library))):
+        top_cards = library.top(1)
+        if not top_cards:
+            break
+        card = top_cards[0]
+        move_to_zone(game, card, Zone.LIBRARY, Zone.GRAVEYARD)
+        milled.append(card)
+    return milled
+
+
+def surveil(game: GameState, player: Player, count: int) -> list[Any]:
+    """Surveil *count* cards with deterministic keep-order choices.
+
+    Returns the cards that remained on top of the library in top-to-bottom
+    order after surveilling.
+    """
+    if count <= 0:
+        return []
+
+    library = player.zones[Zone.LIBRARY]
+    seen_cards = library.top(min(count, len(library)))
+    if not seen_cards:
+        return []
+
+    kept_cards: list[Any] = []
+    graveyard = player.zones[Zone.GRAVEYARD]
+
+    for card in reversed(seen_cards):
+        put_in_graveyard = player.choose_yes_no(
+            f"Surveil: Put {getattr(card, 'name', 'card')} into your graveyard?"
+        )
+        if put_in_graveyard:
+            library.remove(card)
+            graveyard.add(card)
+        else:
+            kept_cards.append(card)
+
+    if len(kept_cards) <= 1:
+        return kept_cards
+
+    if getattr(player, "remaining_choices", 0) < len(kept_cards):
+        return kept_cards
