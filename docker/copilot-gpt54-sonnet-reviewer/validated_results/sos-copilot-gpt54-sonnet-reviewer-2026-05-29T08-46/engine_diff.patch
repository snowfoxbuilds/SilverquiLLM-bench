+def _sba_planeswalker_zero_loyalty(game: GameState) -> bool:
+    """A planeswalker with loyalty 0 or less is put into its owner's graveyard."""
+    from engine.types import CardType
+    from engine.zones import move_to_zone
+
+    action_taken = False
+    to_remove: list[tuple[Player, Any]] = []
+    for player in game.players:
+        for obj in _battlefield(game, player).get_all():
+            if CardType.PLANESWALKER not in getattr(obj, "card_types", set()):
+                continue
+            if getattr(obj, "loyalty", 0) <= 0:
+                to_remove.append((player, obj))
+
+    for player, obj in to_remove:
+        controller = getattr(obj, "controller", player)
+        owner = getattr(obj, "owner", controller)
+        move_to_zone(
+            game,
+            obj,
+            Zone.BATTLEFIELD,
+            Zone.GRAVEYARD,
+            replacement_event=MoveToGraveyardReplacementEvent(
+                moving_card=obj,
+                destination="graveyard",
+                controller=controller,
+                owner=owner,
+            ),
+        )
+        action_taken = True
+    return action_taken
