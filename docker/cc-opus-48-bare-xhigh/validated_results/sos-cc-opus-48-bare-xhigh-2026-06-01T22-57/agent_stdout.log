{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J1qnHGL1sHZs5DbPG27SSJ","type":"tool_result","content":"1\t\"\"\"Card implementation for Uncharted Voyage.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Instant\n8\tfrom engine.types import CardType, ManaCost, TargetRequirement, Zone\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t\n13\t\n14\tclass UnchartedVoyage(Instant):\n15\t    \"\"\"Uncharted Voyage — {3}{U} — Instant.\n16\t\n17\t    Target creature's owner puts it on their choice of the top or bottom\n18\t    of their library.\n19\t    Surveil 1.\n20\t\n21\t    FDN collector number 53.\n22\t    \"\"\"\n23\t\n24\t    def __init__(self, **kwargs: Any) -> None:\n25\t        kwargs.setdefault(\"name\", \"Uncharted Voyage\")\n26\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{3}{U}\"))\n27\t        kwargs.setdefault(\n28\t            \"rules_text\",\n29\t            \"Target creature's owner puts it on their choice of the top or \"\n30\t            \"bottom of their library.\\nSurveil 1.\",\n31\t        )\n32\t        super().__init__(**kwargs)\n33\t\n34\t    def get_targets(self, game: \"GameState\") -> list:\n35\t        \"\"\"Target creature on the battlefield.\"\"\"\n36\t        return [\n37\t            TargetRequirement(\n38\t                filter_fn=lambda obj: CardType.CREATURE in getattr(obj, \"card_types\", set()),\n39\t                description=\"target creature\",\n40\t                zone=Zone.BATTLEFIELD,\n41\t            )\n42\t        ]\n43\t\n44\t    def on_resolve(self, game: \"GameState\") -> None:\n45\t        \"\"\"Put target creature on top or bottom of owner's library, then surveil 1.\"\"\"\n46\t        controller = self.controller\n47\t        if controller is None:\n48\t            return\n49\t\n50\t        # Get target creature\n51\t        chosen = getattr(self, \"chosen_targets\", None)\n52\t        target = chosen[0] if chosen else getattr(self, \"_resolve_target\", None)\n53\t\n54\t        # Single-target spell fizzles if target is illegal or left battlefield\n55\t        if target is None:\n56\t            return\n57\t        target_on_bf = False\n58\t        for player in game.players:\n59\t            bf = game.get_battlefield(player)\n60\t            if bf.contains(target):\n61\t                target_on_bf = True\n62\t                break\n63\t        if not target_on_bf:\n64\t            return\n65\t\n66\t        if target is not None:\n67\t            owner = getattr(target, \"owner\", None)\n68\t            if owner is not None:\n69\t                # Remove from battlefield\n70\t                for player in game.players:\n71\t                    bf = game.get_battlefield(player)\n72\t                    if bf.contains(target):\n73\t                        bf.remove(target)\n74\t                        break\n75\t                # Owner chooses top or bottom\n76\t                put_on_top = True\n77\t                if hasattr(owner, \"choose_yes_no\"):\n78\t                    put_on_top = owner.choose_yes_no(\n79\t                        f\"Put {getattr(target, 'name', 'creature')} on top of library? (No = bottom)\"\n80\t                    )\n81\t                library = owner.zones[Zone.LIBRARY]\n82\t                if put_on_top:\n83\t                    # Top of library is end of list\n84\t                    library.add(target)\n85\t                else:\n86\t                    # Bottom of library is start of list\n87\t                    library.add(target, position=\"bottom\")\n88\t\n89\t        # Surveil 1\n90\t        library = controller.zones[Zone.LIBRARY]\n91\t        lib_cards = list(library.get_all())\n92\t        if lib_cards:\n93\t            top_card = lib_cards[-1]  # Top is end of list\n94\t            put_in_gy = controller.choose_yes_no(\n95\t                f\"Surveil: Put {getattr(top_card, 'name', 'card')} into your graveyard?\"\n96\t            )\n97\t            if put_in_gy:\n98\t                library.remove(top_card)\n99\t                controller.zones[Zone.GRAVEYARD].add(top_card)\n100\t"}]},"parent_tool_use_id":null,"session_id":"21c621d1-2ff1-4c6e-baa9-3ddcfe6a3d2a","uuid":"bd219d39-9af1-4857-9605-9e6a09b9d650","timestamp":"2026-06-01T23:05:16.659Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_53/card_impl.py","content":"\"\"\"Card implementation for Uncharted Voyage.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import Instant\nfrom engine.types import CardType, ManaCost, TargetRequirement, Zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\nclass UnchartedVoyage(Instant):\n    \"\"\"Uncharted Voyage — {3}{U} — Instant.\n\n    Target creature's owner puts it on their choice of the top or bottom\n    of their library.\n    Surveil 1.\n\n    FDN collector number 53.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"Uncharted Voyage\")\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{3}{U}\"))\n        kwargs.setdefault(\n            \"rules_text\",\n            \"Target creature's owner puts it on their choice of the top or \"\n            \"bottom of their library.\\nSurveil 1.\",\n        )\n        super().__init__(**kwargs)\n\n    def get_targets(self, game: \"GameState\") -> list:\n        \"\"\"Target creature on the battlefield.\"\"\"\n        return [\n            TargetRequirement(\n                filter_fn=lambda obj: CardType.CREATURE in getattr(obj, \"card_types\", set()),\n                description=\"target creature\",\n                zone=Zone.BATTLEFIELD,\n            )\n        ]\n\n    def on_resolve(self, game: \"GameState\") -> None:\n        \"\"\"Put target creature on top or bottom of owner's library, then surveil 1.\"\"\"\n        controller = self.controller\n        if controller is None:\n            return\n\n        # Get target creature\n        chosen = getattr(self, \"chosen_targets\", None)\n        target = chosen[0] if chosen else getattr(self, \"_resolve_target\", None)\n\n        # Single-target spell fizzles if target is illegal or left battlefield\n        if target is None:\n            return\n        target_on_bf = False\n        for player in game.players:\n            bf = game.get_battlefield(player)\n            if bf.contains(target):\n                target_on_bf = True\n                break\n        if not target_on_bf:\n            return\n\n        if target is not None:\n            owner = getattr(target, \"owner\", None)\n            if owner is not None:\n                # Remove from battlefield\n                for player in game.players:\n                    bf = game.get_battlefield(player)\n                    if bf.contains(target):\n                        bf.remove(target)\n                        break\n                # Owner chooses top or bottom\n                put_on_top = True\n                if hasattr(owner, \"choose_yes_no\"):\n                    put_on_top = owner.choose_yes_no(\n                        f\"Put {getattr(target, 'name', 'creature')} on top of library? (No = bottom)\"\n                    )\n                library = owner.zones[Zone.LIBRARY]\n                if put_on_top:\n                    # Top of library is end of list\n                    library.add(target)\n                else:\n                    # Bottom of library is start of list\n                    library.add(target, position=\"bottom\")\n\n        # Surveil 1\n        library = controller.zones[Zone.LIBRARY]\n        lib_cards = list(library.get_all())\n        if lib_cards:\n            top_card = lib_cards[-1]  # Top is end of list\n            put_in_gy = controller.choose_yes_no(\n                f\"Surveil: Put {getattr(top_card, 'name', 'card')} into your graveyard?\"\n            )\n            if put_in_gy:\n                library.remove(top_card)\n                controller.zones[Zone.GRAVEYARD].add(top_card)\n","numLines":100,"startLine":1,"totalLines":100}}}
