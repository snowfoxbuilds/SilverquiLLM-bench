{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RJfmf4RAQ9XJ4bF4J5jmWp","type":"tool_result","content":"1\t\"\"\"Helpers for building simple creature card classes.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.types import Keyword, ManaCost\n9\t\n10\t\n11\tdef make_vanilla(\n12\t    name: str,\n13\t    cost_str: str,\n14\t    power: int,\n15\t    toughness: int,\n16\t    keywords: Keyword | None = None,\n17\t    creature_types: set[str] | None = None,\n18\t) -> type[Creature]:\n19\t    \"\"\"Create a :class:`~engine.card.Creature` subclass dynamically.\n20\t\n21\t    The returned class, when instantiated, produces a creature with the\n22\t    specified stats, mana cost, keywords, and creature subtypes.  The\n23\t    constructor accepts the standard ``name``/``owner``/``controller``\n24\t    keyword arguments (matching :meth:`CardRegistry.create_instance`'s\n25\t    call convention).\n26\t\n27\t    Args:\n28\t        name: Card name (used as the default ``name`` for instances and\n29\t            as the generated class name).\n30\t        cost_str: Mana cost string, e.g. ``\"{1}{G}\"``.\n31\t        power: Base power.\n32\t        toughness: Base toughness.\n33\t        keywords: Combined :class:`~engine.types.Keyword` flags, or\n34\t            ``None`` for vanilla creatures.\n35\t        creature_types: Set of creature-type subtype strings (e.g.\n36\t            ``{\"Bear\"}``).  ``None`` means no subtypes.\n37\t\n38\t    Returns:\n39\t        A new ``Creature`` subclass.\n40\t    \"\"\"\n41\t    _cost = ManaCost.parse(cost_str)\n42\t    _keywords = keywords if keywords is not None else Keyword(0)\n43\t    _subtypes = creature_types if creature_types is not None else set()\n44\t    _power = power\n45\t    _toughness = toughness\n46\t    _default_name = name\n47\t\n48\t    class _VanillaCreature(Creature):\n49\t        __doc__ = f\"{name} — {cost_str} {power}/{toughness}\"\n50\t\n51\t        def __init__(self, **kwargs: Any) -> None:\n52\t            kwargs.setdefault(\"name\", _default_name)\n53\t            kwargs.setdefault(\"mana_cost\", _cost)\n54\t            kwargs.setdefault(\"keywords\", _keywords)\n55\t            kwargs.setdefault(\"base_power\", _power)\n56\t            kwargs.setdefault(\"base_toughness\", _toughness)\n57\t            if _subtypes:\n58\t                kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | _subtypes\n59\t            super().__init__(**kwargs)\n60\t\n61\t    _VanillaCreature.__name__ = name.replace(\" \", \"\").replace(\",\", \"\").replace(\"'\", \"\")\n62\t    _VanillaCreature.__qualname__ = _VanillaCreature.__name__\n63\t\n64\t    return _VanillaCreature\n65\t"}]},"parent_tool_use_id":null,"session_id":"21c621d1-2ff1-4c6e-baa9-3ddcfe6a3d2a","uuid":"07821f6e-a865-431b-a466-e01a4ca13c5c","timestamp":"2026-06-01T22:59:07.542Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/creatures.py","content":"\"\"\"Helpers for building simple creature card classes.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any\n\nfrom engine.card import Creature\nfrom engine.types import Keyword, ManaCost\n\n\ndef make_vanilla(\n    name: str,\n    cost_str: str,\n    power: int,\n    toughness: int,\n    keywords: Keyword | None = None,\n    creature_types: set[str] | None = None,\n) -> type[Creature]:\n    \"\"\"Create a :class:`~engine.card.Creature` subclass dynamically.\n\n    The returned class, when instantiated, produces a creature with the\n    specified stats, mana cost, keywords, and creature subtypes.  The\n    constructor accepts the standard ``name``/``owner``/``controller``\n    keyword arguments (matching :meth:`CardRegistry.create_instance`'s\n    call convention).\n\n    Args:\n        name: Card name (used as the default ``name`` for instances and\n            as the generated class name).\n        cost_str: Mana cost string, e.g. ``\"{1}{G}\"``.\n        power: Base power.\n        toughness: Base toughness.\n        keywords: Combined :class:`~engine.types.Keyword` flags, or\n            ``None`` for vanilla creatures.\n        creature_types: Set of creature-type subtype strings (e.g.\n            ``{\"Bear\"}``).  ``None`` means no subtypes.\n\n    Returns:\n        A new ``Creature`` subclass.\n    \"\"\"\n    _cost = ManaCost.parse(cost_str)\n    _keywords = keywords if keywords is not None else Keyword(0)\n    _subtypes = creature_types if creature_types is not None else set()\n    _power = power\n    _toughness = toughness\n    _default_name = name\n\n    class _VanillaCreature(Creature):\n        __doc__ = f\"{name} — {cost_str} {power}/{toughness}\"\n\n        def __init__(self, **kwargs: Any) -> None:\n            kwargs.setdefault(\"name\", _default_name)\n            kwargs.setdefault(\"mana_cost\", _cost)\n            kwargs.setdefault(\"keywords\", _keywords)\n            kwargs.setdefault(\"base_power\", _power)\n            kwargs.setdefault(\"base_toughness\", _toughness)\n            if _subtypes:\n                kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | _subtypes\n            super().__init__(**kwargs)\n\n    _VanillaCreature.__name__ = name.replace(\" \", \"\").replace(\",\", \"\").replace(\"'\", \"\")\n    _VanillaCreature.__qualname__ = _VanillaCreature.__name__\n\n    return _VanillaCreature\n","numLines":65,"startLine":1,"totalLines":65}}}
