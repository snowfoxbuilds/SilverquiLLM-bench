{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EMEyGA3TFdgJM8HUASwMNX","type":"tool_result","content":"285\tdef cast_spell_free(\n286\t    game: GameState,\n287\t    player: Player,\n288\t    card: CardImpl,\n289\t    from_zone: Zone,\n290\t) -> None:\n291\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n292\t\n293\t    This is used by effects that allow casting from zones other than hand\n294\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n295\t    or cascade.\n296\t\n297\t    Pipeline\n298\t    --------\n299\t    1. **can_cast** — ask the card whether it can legally be cast (same\n300\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n301\t    2. Move *card* from *from_zone* to the stack zone.\n302\t    3. Choose targets (if applicable) with validation and protection check.\n303\t    4. Call ``on_cast`` hook.\n304\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n305\t       resolution normally (permanents → battlefield, non-permanents →\n306\t       graveyard).\n307\t\n308\t    No timing check or mana payment is performed.  The spell goes on the\n309\t    stack and can be responded to normally (e.g. countered).\n310\t\n311\t    If targeting or other post-move checks fail, the card is rolled back\n312\t    to its source zone.\n313\t\n314\t    Parameters:\n315\t        game: The current game state.\n316\t        player: The player casting the spell.\n317\t        card: The card to cast.\n318\t        from_zone: The zone the card is currently in.\n319\t\n320\t    Raises:\n321\t        CastingError: If the card cannot be found in *from_zone* or\n322\t            legality checks fail.\n323\t    \"\"\"\n324\t    from engine.zones import move_to_zone\n325\t\n326\t    # Ensure controller is set\n327\t    card.controller = player\n328\t    if card.owner is None:\n329\t        card.owner = player\n330\t\n331\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n332\t    if not card.can_cast(game):\n333\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n334\t\n335\t    # 2. Locate card in source zone\n336\t    source_zone_container = player.zones[from_zone]\n337\t    if not source_zone_container.contains(card):\n338\t        # Try to find the card in any player's zone\n339\t        source_zone_container = None\n340\t        for p in game.players:\n341\t            z = p.zones[from_zone]\n342\t            if z.contains(card):\n343\t                source_zone_container = z\n344\t                break\n345\t\n346\t    if source_zone_container is None or not source_zone_container.contains(card):\n347\t        raise CastingError(\n348\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n349\t        )\n350\t\n351\t    # Move card from source zone to stack zone\n352\t    stack_zone = player.zones[Zone.STACK]\n353\t    source_zone_container.remove(card)\n354\t    stack_zone.add(card)\n355\t\n356\t    # 3. Choose targets (with rollback on failure)\n357\t    try:\n358\t        target_specs = card.get_targets(game)\n359\t        chosen_targets: list[Any] = []\n360\t        if target_specs:\n361\t            for spec in target_specs:\n362\t                target = player.choose_target(target_specs, spec)\n363\t                # Validate against filter_fn if the spec provides one\n364\t                filter_fn = getattr(spec, \"filter_fn\", None)\n365\t                if filter_fn is not None and target is not None:\n366\t                    if not filter_fn(target):\n367\t                        raise CastingError(\n368\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n369\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n370\t                        )\n371\t                chosen_targets.append(target)\n372\t\n373\t        # Protection check — reject targets that have protection from this spell\n374\t        from engine.protection import has_protection_from\n375\t\n376\t        for target in chosen_targets:\n377\t            if has_protection_from(target, card):\n378\t                raise CastingError(\n379\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n380\t                )\n381\t    except Exception as exc:\n382\t        # Rollback: move card from stack zone back to source zone\n383\t        stack_zone.remove(card)\n384\t        source_zone_container.add(card)\n385\t        raise CastingError(str(exc)) from exc\n386\t\n387\t    # 4. Call on_cast hook\n388\t    card.on_cast(game)\n389\t\n390\t    # 5. Build on_resolve callback and push StackObject\n391\t    stack_obj = StackObject(\n392\t        source=card,\n393\t        controller=player,\n394\t        targets=chosen_targets,\n395\t        on_resolve=lambda g: None,  # replaced below\n396\t    )\n397\t\n398\t    def _on_resolve(g: GameState) -> None:\n399\t        _resolve_spell(g, card, player, stack_obj)\n400\t\n401\t    stack_obj.on_resolve = _on_resolve\n402\t    game.stack.push(stack_obj)\n403\t\n404\t\n405\t# ------------------------------------------------------------------\n406\t# Resolution (called when the stack pops)\n407\t# ------------------------------------------------------------------\n408\t\n409\tdef _resolve_spell(\n410\t    game: GameState,\n411\t    card: CardImpl,\n412\t    player: Player,\n413\t    stack_obj: StackObject,\n414\t) -> None:"}]},"parent_tool_use_id":null,"session_id":"21c621d1-2ff1-4c6e-baa9-3ddcfe6a3d2a","uuid":"190ec3b8-db06-40e0-810a-b4179b79f530","timestamp":"2026-06-01T23:34:53.691Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"def cast_spell_free(\n    game: GameState,\n    player: Player,\n    card: CardImpl,\n    from_zone: Zone,\n) -> None:\n    \"\"\"Cast *card* without paying its mana cost, using the stack.\n\n    This is used by effects that allow casting from zones other than hand\n    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n    or cascade.\n\n    Pipeline\n    --------\n    1. **can_cast** — ask the card whether it can legally be cast (same\n       legality as :func:`cast_spell`, minus mana/timing constraints).\n    2. Move *card* from *from_zone* to the stack zone.\n    3. Choose targets (if applicable) with validation and protection check.\n    4. Call ``on_cast`` hook.\n    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n       resolution normally (permanents → battlefield, non-permanents →\n       graveyard).\n\n    No timing check or mana payment is performed.  The spell goes on the\n    stack and can be responded to normally (e.g. countered).\n\n    If targeting or other post-move checks fail, the card is rolled back\n    to its source zone.\n\n    Parameters:\n        game: The current game state.\n        player: The player casting the spell.\n        card: The card to cast.\n        from_zone: The zone the card is currently in.\n\n    Raises:\n        CastingError: If the card cannot be found in *from_zone* or\n            legality checks fail.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Ensure controller is set\n    card.controller = player\n    if card.owner is None:\n        card.owner = player\n\n    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 2. Locate card in source zone\n    source_zone_container = player.zones[from_zone]\n    if not source_zone_container.contains(card):\n        # Try to find the card in any player's zone\n        source_zone_container = None\n        for p in game.players:\n            z = p.zones[from_zone]\n            if z.contains(card):\n                source_zone_container = z\n                break\n\n    if source_zone_container is None or not source_zone_container.contains(card):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n        )\n\n    # Move card from source zone to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    source_zone_container.remove(card)\n    stack_zone.add(card)\n\n    # 3. Choose targets (with rollback on failure)\n    try:\n        target_specs = card.get_targets(game)\n        chosen_targets: list[Any] = []\n        if target_specs:\n            for spec in target_specs:\n                target = player.choose_target(target_specs, spec)\n                # Validate against filter_fn if the spec provides one\n                filter_fn = getattr(spec, \"filter_fn\", None)\n                if filter_fn is not None and target is not None:\n                    if not filter_fn(target):\n                        raise CastingError(\n                            f\"Cannot cast {card.name!r} — chosen target does not \"\n                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                        )\n                chosen_targets.append(target)\n\n        # Protection check — reject targets that have protection from this spell\n        from engine.protection import has_protection_from\n\n        for target in chosen_targets:\n            if has_protection_from(target, card):\n                raise CastingError(\n                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n                )\n    except Exception as exc:\n        # Rollback: move card from stack zone back to source zone\n        stack_zone.remove(card)\n        source_zone_container.add(card)\n        raise CastingError(str(exc)) from exc\n\n    # 4. Call on_cast hook\n    card.on_cast(game)\n\n    # 5. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n\n# ------------------------------------------------------------------\n# Resolution (called when the stack pops)\n# ------------------------------------------------------------------\n\ndef _resolve_spell(\n    game: GameState,\n    card: CardImpl,\n    player: Player,\n    stack_obj: StackObject,\n) -> None:","numLines":130,"startLine":285,"totalLines":525}}}
