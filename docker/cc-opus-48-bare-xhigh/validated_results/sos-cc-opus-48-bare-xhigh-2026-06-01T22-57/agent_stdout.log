still a land.',\n51\t        )\n52\t        super().__init__(**kwargs)\n53\t        # Creature characteristics — inert until the land is animated.\n54\t        self.base_power: int = 0\n55\t        self.base_toughness: int = 0\n56\t        self.modified_power: int = 0\n57\t        self.modified_toughness: int = 0\n58\t        self.plus_one_counters: int = 0\n59\t        self.minus_one_counters: int = 0\n60\t        self.damage_marked: int = 0\n61\t        self.is_attacking: bool = False\n62\t        self.is_blocking: bool = False\n63\t        self.summoning_sick: bool = False\n64\t        self.is_token: bool = False\n65\t        self._animated: bool = False\n66\t        self._pump_registered: bool = False\n67\t\n68\t    # ------------------------------------------------------------------\n69\t    # Creature-like characteristics (only meaningful once animated)\n70\t    # ------------------------------------------------------------------\n71\t    @property\n72\t    def power(self) -> int:\n73\t        return self.modified_power + self.plus_one_counters - self.minus_one_counters\n74\t\n75\t    @property\n76\t    def toughness(self) -> int:\n77\t        return (\n78\t            self.modified_toughness + self.plus_one_counters - self.minus_one_counters\n79\t        )\n80\t\n81\t    def _reset_characteristics(self) -> None:\n82\t        super()._reset_characteristics()\n83\t        self.modified_power = self.base_power\n84\t        self.modified_toughness = self.base_toughness\n85\t\n86\t    # ------------------------------------------------------------------\n87\t    # Mana abilities\n88\t    # ------------------------------------------------------------------\n89\t    def get_mana_abilities(self) -> list[ManaAbility]:\n90\t        source = self\n91\t\n92\t        def _tap_only(game: \"GameState\", src: Any) -> bool:\n93\t            if getattr(src, \"is_tapped\", False):\n94\t                return False\n95\t            src.is_tapped = True\n96\t            return True\n97\t\n98\t        def _add_colorless(game: \"GameState\") -> None:\n99\t            controller = source.controller\n100\t            if controller is not None:\n101\t                controller.mana_pool.add(ManaType.COLORLESS, 1)\n102\t\n103\t        def _tap_and_pay_life(game: \"GameState\", src: Any) -> bool:\n104\t            if getattr(src, \"is_tapped\", False):\n105\t                return False\n106\t            controller = source.controller\n107\t            if controller is None or getattr(controller, \"life\", 0) < 1:\n108\t                return False\n109\t            src.is_tapped = True\n110\t            controller.life -= 1\n111\t            return True\n112\t\n113\t        def _add_any_color(game: \"GameState\") -> None:\n114\t            controller = source.controller\n115\t            if controller is None:\n116\t                return\n117\t            try:\n118\t                color = controller.choose(\n119\t                    list(_COLOR_MANA),\n120\t                    \"Choose a color of mana to add (instant/sorcery only)\",\n121\t                )\n122\t            except Exception:\n123\t                color = ManaType.BLUE\n124\t            if color not in _COLOR_MANA:\n125\t                color = ManaType.BLUE\n126\t            controller.mana_pool.add(color, 1)\n127\t            # Engine limitation: the \"spend only on instant/sorcery\" restriction\n128\t            # is not tracked by the mana pool, so it is not enforced here.\n129\t\n130\t        return [\n131\t            ManaAbility(\n132\t                cost=_tap_only,\n133\t                mana_produced=_add_colorless,\n134\t                description=\"{T}: Add {C}.\",\n135\t            ),\n136\t            ManaAbility(\n137\t                cost=_tap_and_pay_life,\n138\t                mana_produced=_add_any_color,\n139\t                description=\"{T}, Pay 1 life: Add one mana of any color. Spend \"\n140\t                \"this mana only to cast an instant or sorcery spell.\",\n141\t            ),\n142\t        ]\n143\t\n144\t    # ------------------------------------------------------------------\n145\t    # Activated ability — animate\n146\t    # ------------------------------------------------------------------\n147\t    def get_activated_abilities(self) -> list[ActivatedAbility]:\n148\t        source = self\n149\t\n150\t        def _cost(game: \"GameState\", src: Any) -> bool:\n151\t            controller = source.controller\n152\t            if controller is None:\n153\t                return False\n154\t            return controller.mana_pool.pay(ManaCost.parse(\"{5}\"))\n155\t\n156\t        def _effect(game: \"GameState\") -> None:\n157\t            if CardType.CREATURE in source.card_types:\n158\t                return  # already a creature\n159\t            source._animate(game)\n160\t\n161\t        return [\n162\t            ActivatedAbility(\n163\t                cost=_cost,\n164\t                effect=_effect,\n165\t                description=\"{5}: If this land isn't a creature, it becomes a \"\n166\t                \"2/4 Wizard creature that pumps when you cast instants and \"\n167\t                \"sorceries. It's still a land.\",\n168\t            )\n169\t        ]\n170\t\n171\t    # ------------------------------------------------------------------\n172\t    # Animation helpers\n173\t    # ------------------------------------------------------------------\n174\t    def _animate(self, game: \"GameState\") -> None:\n175\t        from engine.continuous_effects import (\n176\t            DURATION_PERMANENT,\n177\t            ContinuousEffect,\n178\t            Layer,\n179\t        )\n180\t\n181\t        self._animated = True\n182\t        self.base_power = 2\n183\t        self.base_toughness = 4\n184\t        self._apply_animation(game)\n185\t\n186\t        # Survive future apply_all/_reset cycles.\n187\t        game.effect_manager.add(\n188\t            ContinuousEffect(\n189\t                source=self,\n190\t                layer=Layer.TYPE,\n191\t                apply=self._apply_animation,\n192\t                duration=DURATION_PERMANENT,\n193\t            )\n194\t        )\n195\t        self._register_pump_trigger(game)\n196\t\n197\t    def _apply_animation(self, game: \"GameState\") -> None:\n198\t        self.card_types = set(self.card_types) | {CardType.CREATURE}\n199\t        self.subtypes = set(self.subtypes) | {\"Wizard\"}\n200\t        if self.modified_power < 2:\n201\t            self.modified_power = 2\n202\t        if self.modified_toughness < 4:\n203\t            self.modified_toughness = 4\n204\t\n205\t    def _register_pump_trigger(self, game: \"GameState\") -> None:\n206\t        if self._pump_registered:\n207\t            return\n208\t        self._pump_registered = True\n209\t\n210\t        from engine.events import SpellCastTriggeredEvent\n211\t        from engine.triggers import TriggerRegistration\n212\t\n213\t        source = self\n214\t        controller = getattr(self, \"controller\", None) or game.active_player\n215\t\n216\t        def _condition(game: \"GameState\", event: Any) -> bool:\n217\t            if CardType.CREATURE not in source.card_types:\n218\t                return False\n219\t            if getattr(event, \"controller\", None) is not source.controller:\n220\t                return False\n221\t            card = getattr(event, \"card\", None) or getattr(\n222\t                getattr(event, \"spell\", None), \"source\", None\n223\t            )\n224\t            return card is not None and _is_instant_or_sorcery(card)\n225\t\n226\t        def _effect(game: \"GameState\") -> None:\n227\t            from engine.continuous_effects import (\n228\t                DURATION_END_OF_TURN,\n229\t                ContinuousEffect,\n230\t                Layer,\n231\t                SubLayer,\n232\t            )\n233\t\n234\t            source.modified_power += 1\n235\t\n236\t            def _pump(game: \"GameState\") -> None:\n237\t                source.modified_power += 1\n238\t\n239\t            game.effect_manager.add(\n240\t                ContinuousEffect(\n241\t                    source=source,\n242\t                    layer=Layer.POWER_TOUGHNESS,\n243\t                    sublayer=SubLayer.MODIFY_PT,\n244\t                    apply=_pump,\n245\t                    duration=DURATION_END_OF_TURN,\n246\t                )\n247\t            )\n248\t\n249\t        game.trigger_manager.register(\n250\t            TriggerRegistration(\n251\t                event_type=SpellCastTriggeredEvent,\n252\t                condition=_condition,\n253\t                effect=_effect,\n254\t                source=self,\n255\t                controller=controller,\n256\t            )\n257\t        )\n258\t"}]},"parent_tool_use_id":null,"session_id":"21c621d1-2ff1-4c6e-baa9-3ddcfe6a3d2a","uuid":"11d9604d-9fb4-4704-b272-39896d70cbe2","timestamp":"2026-06-01T23:33:39.430Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/sos/sos_257/card_impl.py","content":"\"\"\"Card implementation for Great Hall of the Biblioplex.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import ActivatedAbility, Land, ManaAbility\nfrom engine.types import CardType, ManaCost, ManaType, Zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\n_COLOR_MANA = (\n    ManaType.WHITE,\n    ManaType.BLUE,\n    ManaType.BLACK,\n    ManaType.RED,\n    ManaType.GREEN,\n)\n\n\ndef _is_instant_or_sorcery(card: Any) -> bool:\n    types = getattr(card, \"card_types\", set())\n    return CardType.INSTANT in types or CardType.SORCERY in types\n\n\nclass GreatHallOfTheBiblioplex(Land):\n    \"\"\"Great Hall of the Biblioplex — Land.\n\n    {T}: Add {C}.\n    {T}, Pay 1 life: Add one mana of any color. Spend this mana only to cast\n    an instant or sorcery spell.\n    {5}: If this land isn't a creature, it becomes a 2/4 Wizard creature with\n    \"Whenever you cast an instant or sorcery spell, this creature gets +1/+0\n    until end of turn.\" It's still a land.\n\n    SOS collector number 257.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"Great Hall of the Biblioplex\")\n        kwargs.setdefault(\n            \"rules_text\",\n            \"{T}: Add {C}.\\n\"\n            \"{T}, Pay 1 life: Add one mana of any color. Spend this mana only \"\n            \"to cast an instant or sorcery spell.\\n\"\n            \"{5}: If this land isn't a creature, it becomes a 2/4 Wizard \"\n            'creature with \"Whenever you cast an instant or sorcery spell, '\n            'this creature gets +1/+0 until end of turn.\" It\\'s still a land.',\n        )\n        super().__init__(**kwargs)\n        # Creature characteristics — inert until the land is animated.\n        self.base_power: int = 0\n        self.base_toughness: int = 0\n        self.modified_power: int = 0\n        self.modified_toughness: int = 0\n        self.plus_one_counters: int = 0\n        self.minus_one_counters: int = 0\n        self.damage_marked: int = 0\n        self.is_attacking: bool = False\n        self.is_blocking: bool = False\n        self.summoning_sick: bool = False\n        self.is_token: bool = False\n        self._animated: bool = False\n        self._pump_registered: bool = False\n\n    # ------------------------------------------------------------------\n    # Creature-like characteristics (only meaningful once animated)\n    # ------------------------------------------------------------------\n    @property\n    def power(self) -> int:\n        return self.modified_power + self.plus_one_counters - self.minus_one_counters\n\n    @property\n    def toughness(self) -> int:\n        return (\n            self.modified_toughness + self.plus_one_counters - self.minus_one_counters\n        )\n\n    def _reset_characteristics(self) -> None:\n        super()._reset_characteristics()\n        self.modified_power = self.base_power\n        self.modified_toughness = self.base_toughness\n\n    # ------------------------------------------------------------------\n    # Mana abilities\n    # ------------------------------------------------------------------\n    def get_mana_abilities(self) -> list[ManaAbility]:\n        source = self\n\n        def _tap_only(game: \"GameState\", src: Any) -> bool:\n            if getattr(src, \"is_tapped\", False):\n                return False\n            src.is_tapped = True\n            return True\n\n        def _add_colorless(game: \"GameState\") -> None:\n            controller = source.controller\n            if controller is not None:\n                controller.mana_pool.add(ManaType.COLORLESS, 1)\n\n        def _tap_and_pay_life(game: \"GameState\", src: Any) -> bool:\n            if getattr(src, \"is_tapped\", False):\n                return False\n            controller = source.controller\n            if controller is None or getattr(controller, \"life\", 0) < 1:\n                return False\n            src.is_tapped = True\n            controller.life -= 1\n            return True\n\n        def _add_any_color(game: \"GameState\") -> None:\n            controller = source.controller\n            if controller is None:\n                return\n            try:\n                color = controller.choose(\n                    list(_COLOR_MANA),\n                    \"Choose a color of mana to add (instant/sorcery only)\",\n                )\n            except Exception:\n                color = ManaType.BLUE\n            if color not in _COLOR_MANA:\n                color = ManaType.BLUE\n            controller.mana_pool.add(color, 1)\n            # Engine limitation: the \"spend only on instant/sorcery\" restriction\n            # is not tracked by the mana pool, so it is not enforced here.\n\n        return [\n            ManaAbility(\n                cost=_tap_only,\n                mana_produced=_add_colorless,\n                description=\"{T}: Add {C}.\",\n            ),\n            ManaAbility(\n                cost=_tap_and_pay_life,\n                mana_produced=_add_any_color,\n                description=\"{T}, Pay 1 life: Add one mana of any color. Spend \"\n                \"this mana only to cast an instant or sorcery spell.\",\n            ),\n        ]\n\n    # ------------------------------------------------------------------\n    # Activated ability — animate\n    # ------------------------------------------------------------------\n    def get_activated_abilities(self) -> list[ActivatedAbility]:\n        source = self\n\n        def _cost(game: \"GameState\", src: Any) -> bool:\n            controller = source.controller\n            if controller is None:\n                return False\n            return controller.mana_pool.pay(ManaCost.parse(\"{5}\"))\n\n        def _effect(game: \"GameState\") -> None:\n            if CardType.CREATURE in source.card_types:\n                return  # already a creature\n            source._animate(game)\n\n        return [\n            ActivatedAbility(\n                cost=_cost,\n                effect=_effect,\n                description=\"{5}: If this land isn't a creature, it becomes a \"\n                \"2/4 Wizard creature that pumps when you cast instants and \"\n                \"sorceries. It's still a land.\",\n            )\n        ]\n\n    # ------------------------------------------------------------------\n    # Animation helpers\n    # ------------------------------------------------------------------\n    def _animate(self, game: \"GameState\") -> None:\n        from engine.continuous_effects import (\n            DURATION_PERMANENT,\n            ContinuousEffect,\n            Layer,\n        )\n\n        self._animated = True\n        self.base_power = 2\n        self.base_toughness = 4\n        self._apply_animation(game)\n\n        # Survive future apply_all/_reset cycles.\n        game.effect_manager.add(\n            ContinuousEffect(\n                source=self,\n                layer=Layer.TYPE,\n                apply=self._apply_animation,\n                duration=DURATION_PERMANENT,\n            )\n        )\n        self._register_pump_trigger(game)\n\n    def _apply_animation(self, game: \"GameState\") -> None:\n        self.card_types = set(self.card_types) | {CardType.CREATURE}\n        self.subtypes = set(self.subtypes) | {\"Wizard\"}\n        if self.modified_power < 2:\n            self.modified_power = 2\n        if self.modified_toughness < 4:\n            self.modified_toughness = 4\n\n    def _register_pump_trigger(self, game: \"GameState\") -> None:\n        if self._pump_registered:\n            return\n        self._pump_registered = True\n\n        from engine.events import SpellCastTriggeredEvent\n        from engine.triggers import TriggerRegistration\n\n        source = self\n        controller = getattr(self, \"controller\", None) or game.active_player\n\n        def _condition(game: \"GameState\", event: Any) -> bool:\n            if CardType.CREATURE not in source.card_types:\n                return False\n            if getattr(event, \"controller\", None) is not source.controller:\n                return False\n            card = getattr(event, \"card\", None) or getattr(\n                getattr(event, \"spell\", None), \"source\", None\n            )\n            return card is not None and _is_instant_or_sorcery(card)\n\n        def _effect(game: \"GameState\") -> None:\n            from engine.continuous_effects import (\n                DURATION_END_OF_TURN,\n                ContinuousEffect,\n                Layer,\n                SubLayer,\n            )\n\n            source.modified_power += 1\n\n            def _pump(game: \"GameState\") -> None:\n                source.modified_power += 1\n\n            game.effect_manager.add(\n                ContinuousEffect(\n                    source=source,\n                    layer=Layer.POWER_TOUGHNESS,\n                    sublayer=SubLayer.MODIFY_PT,\n                    apply=_pump,\n                    duration=DURATION_END_OF_TURN,\n                )\n            )\n\n        game.trigger_manager.register(\n            TriggerRegistration(\n                event_type=SpellCastTriggeredEvent,\n                condition=_condition,\n                effect=_effect,\n                source=self,\n                controller=controller,\n            )\n        )\n","numLines":258,"startLine":1,"totalLines":258}}}
