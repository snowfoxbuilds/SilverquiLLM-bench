{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Bkig5U9b7WyQ7KrQ9woMw9","type":"tool_result","content":"1\t\"\"\"Card implementation for Lorehold, the Historian.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.events import BeginningOfUpkeepTriggeredEvent, DrawsCardTriggeredEvent\n9\tfrom engine.types import CardType, Keyword, ManaCost, Supertype, Zone\n10\t\n11\tif TYPE_CHECKING:\n12\t    from engine.game_state import GameState\n13\t\n14\t\n15\tdef _is_instant_or_sorcery(card: Any) -> bool:\n16\t    types = getattr(card, \"card_types\", set())\n17\t    return CardType.INSTANT in types or CardType.SORCERY in types\n18\t\n19\t\n20\tdef _on_battlefield(game: \"GameState\", perm: Any) -> bool:\n21\t    controller = getattr(perm, \"controller\", None)\n22\t    if controller is None:\n23\t        return False\n24\t    return perm in controller.zones[Zone.BATTLEFIELD].get_all()\n25\t\n26\t\n27\tclass LoreholdTheHistorian(Creature):\n28\t    \"\"\"Lorehold, the Historian — {3}{R}{W} — 5/5 — Elder Dragon.\n29\t\n30\t    Flying, haste.\n31\t    Each instant and sorcery card in your hand has miracle {2}.\n32\t    At the beginning of each opponent's upkeep, you may discard a card. If you\n33\t    do, draw a card.\n34\t\n35\t    SOS collector number 201.\n36\t    \"\"\"\n37\t\n38\t    def __init__(self, **kwargs: Any) -> None:\n39\t        kwargs.setdefault(\"name\", \"Lorehold, the Historian\")\n40\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{3}{R}{W}\"))\n41\t        kwargs.setdefault(\"base_power\", 5)\n42\t        kwargs.setdefault(\"base_toughness\", 5)\n43\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.LEGENDARY}\n44\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Elder\", \"Dragon\"}\n45\t        kwargs.setdefault(\"keywords\", Keyword.FLYING | Keyword.HASTE)\n46\t        kwargs.setdefault(\n47\t            \"rules_text\",\n48\t            \"Flying, haste\\n\"\n49\t            \"Each instant and sorcery card in your hand has miracle {2}.\\n\"\n50\t            \"At the beginning of each opponent's upkeep, you may discard a \"\n51\t            \"card. If you do, draw a card.\",\n52\t        )\n53\t        super().__init__(**kwargs)\n54\t\n55\t    def register_triggers(self, game: \"GameState\") -> None:\n56\t        from engine.triggers import TriggerRegistration\n57\t\n58\t        source = self\n59\t        controller = getattr(self, \"controller\", None) or game.active_player\n60\t\n61\t        # --- Miracle {2} for instant/sorcery cards in hand ---\n62\t        def _miracle_condition(game: \"GameState\", event: DrawsCardTriggeredEvent) -> bool:\n63\t            if not _on_battlefield(game, source):\n64\t                return False\n65\t            ctrl = source.controller\n66\t            player = getattr(event, \"player\", None)\n67\t            if ctrl is None or player is not ctrl:\n68\t                return False\n69\t            turn = getattr(game, \"turn_number\", 0)\n70\t            first_this_turn = getattr(ctrl, \"_lorehold_miracle_turn\", None) != turn\n71\t            ctrl._lorehold_miracle_turn = turn\n72\t            if not first_this_turn:\n73\t                return False\n74\t            card = getattr(event, \"card\", None)\n75\t            if card is None or not _is_instant_or_sorcery(card):\n76\t                return False\n77\t            source._miracle_card = card\n78\t            return True\n79\t\n80\t        def _miracle_effect(game: \"GameState\") -> None:\n81\t            from engine.casting import cast_spell_free\n82\t\n83\t            card = getattr(source, \"_miracle_card\", None)\n84\t            source._miracle_card = None\n85\t            ctrl = source.controller\n86\t            if card is None or ctrl is None:\n87\t                return\n88\t            if card not in ctrl.zones[Zone