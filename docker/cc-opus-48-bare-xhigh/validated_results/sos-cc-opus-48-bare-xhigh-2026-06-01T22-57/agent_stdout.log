{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Tw2kzkxjjHgZarFdJJkEN6","type":"tool_result","content":"1\t\"\"\"Card implementation for Mana Sculpt.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Instant\n8\tfrom engine.types import CardType, ManaCost, ManaType, TargetRequirement, Zone\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t\n13\t\n14\tdef _get_chosen_target(card: Any) -> Any:\n15\t    \"\"\"Retrieve the first chosen target for a spell.\"\"\"\n16\t    chosen = getattr(card, \"chosen_targets\", None)\n17\t    if chosen:\n18\t        return chosen[0]\n19\t    return getattr(card, \"_resolve_target\", None)\n20\t\n21\t\n22\tdef _counter_spell(game: \"GameState\", stack_obj: Any) -> None:\n23\t    \"\"\"Counter a spell — remove from stack and move its card to the graveyard.\"\"\"\n24\t    from engine.stack import StackObject\n25\t\n26\t    if not isinstance(stack_obj, StackObject):\n27\t        return\n28\t\n29\t    card = stack_obj.source\n30\t    stack_items = game.stack._items  # noqa: SLF001\n31\t    found = False\n32\t    for i, item in enumerate(stack_items):\n33\t        if item is stack_obj:\n34\t            stack_items.pop(i)\n35\t            found = True\n36\t            break\n37\t\n38\t    if not found:\n39\t        return\n40\t\n41\t    controller = stack_obj.controller\n42\t    owner = getattr(card, \"owner\", controller)\n43\t\n44\t    if controller is not None:\n45\t        stack_zone = controller.zones[Zone.STACK]\n46\t        if stack_zone.contains(card):\n47\t            stack_zone.remove(card)\n48\t\n49\t    if owner is not None:\n50\t        owner.zones[Zone.GRAVEYARD].add(card)\n51\t\n52\t\n53\tdef _controls_wizard(player: Any) -> bool:\n54\t    \"\"\"Return ``True`` if *player* controls a creature with the Wizard subtype.\"\"\"\n55\t    if player is None:\n56\t        return False\n57\t    bf = player.zones[Zone.BATTLEFIELD]\n58\t    for obj in bf.get_all():\n59\t        if CardType.CREATURE not in getattr(obj, \"card_types\", set()):\n60\t            continue\n61\t        if \"Wizard\" in getattr(obj, \"subtypes\", set()):\n62\t            return True\n63\t    return False\n64\t\n65\t\n66\tdef _spell_mana_value(stack_obj: Any) -> int:\n67\t    \"\"\"Return the amount of mana spent to cast the spell on *stack_obj*.\n68\t\n69\t    Prefers the actual mana paid (``mana_spent``, recorded by the casting\n70\t    pipeline); falls back to the spell's mana value if that is unavailable.\n71\t    \"\"\"\n72\t    source = getattr(stack_obj, \"source\", None)\n73\t    amount = getattr(source, \"mana_spent\", None)\n74\t    if amount is not None:\n75\t        return int(amount)\n76\t    cost = getattr(source, \"mana_cost\", None)\n77\t    if cost is not None:\n78\t        return cost.cmc\n79\t    return 0\n80\t\n81\t\n82\tclass _DelayedManaSource:\n83\t    \"\"\"Lightweight identity object owning the delayed-mana trigger.\"\"\"\n84\t\n85\t    name = \"Mana Sculpt (delayed mana)\"\n86\t\n87\t\n88\tclass ManaSculpt(Instant):\n89\t    \"\"\"Mana Sculpt — {1}{U}{U} — Instant.\n90\t\n91\t    Counter target spell. If you control a Wizard, add an amount of {C}\n92\t    equal to the amount of mana spent to cast that spell at the beginning\n93\t    of your next main phase.\n94\t\n95\t    SOS collector number 57.\n96\t    \"\"\"\n97\t\n98\t    def __init__(self, **kwargs: Any) -> None:\n99\t        kwargs.setdefault(\"name\", \"Mana Sculpt\")\n100\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{U}{U}\"))\n101\t        kwargs.setdefault(\n102\t            \"rules_text\",\n103\t            \"Counter target spell. If you control a Wizard, add an amount \"\n104\t            \"of {C} equal to the amount of mana spent to cast that spell at \"\n105\t            \"the beginning of your next main phase.\",\n106\t        )\n107\t        super().__init__(**kwargs)\n108\t\n109\t    def can_cast(self, game: \"GameState\") -> bool:\n110\t        \"\"\"Cannot cast unless there's a spell on the stack to counter.\"\"\"\n111\t        for stack_obj in game.stack.objects():\n112\t            if stack_obj.source is self:\n113\t                continue\n114\t            if getattr(stack_obj, \"is_spell\", True):\n115\t                return True\n116\t        return False\n117\t\n118\t    def get_targets(self, game: \"GameState\") -> list[Any]:\n119\t        \"\"\"Target spell on the stack.\"\"\"\n120\t        return [\n121\t            TargetRequirement(\n122\t                filter_fn=lambda obj: obj is not self\n123\t                and getattr(obj, \"is_spell\", True),\n124\t                description=\"target spell\",\n125\t                zone=Zone.STACK,\n126\t            )\n127\t        ]\n128\t\n129\t    def on_resolve(self, game: \"GameState\") -> None:\n130\t        \"\"\"Counter the target spell; schedule delayed colorless mana.\"\"\"\n131\t        target = _get_chosen_target(self)\n132\t        if target is None:\n133\t            return\n134\t\n135\t        amount = _spell_mana_value(target)\n136\t        _counter_spell(game, target)\n137\t\n138\t        controller = self.controller\n139\t        if controller is None:\n140\t            return\n141\t        if not _controls_wizard(controller):\n142\t            return\n143\t        if amount <= 0:\n144\t            return\n145\t\n146\t        self._schedule_delayed_mana(game, controller, amount)\n147\t\n148\t    @staticmethod\n149\t    def _schedule_delayed_mana(\n150\t        game: \"GameState\", controller: Any, amount: int\n151\t    ) -> None:\n152\t        \"\"\"Register a one-shot trigger that adds {C} at the next main phase.\"\"\"\n153\t        from engine.events import BeginningOfMainPhaseTriggeredEvent\n154\t        from engine.triggers import TriggerRegistration\n155\t\n156\t        source = _DelayedManaSource()\n157\t\n158\t        def _condition(game: \"GameState\", event: Any) -> bool:\n159\t            return getattr(event, \"player\", None) is controller\n160\t\n161\t        def _effect(game: \"GameState\") -> None:\n162\t            controller.mana_pool.add(ManaType.COLORLESS, amount)\n163\t            game.trigger_manager.unregister(source)\n164\t\n165\t        game.trigger_manager.register(\n166\t            TriggerRegistration(\n167\t                event_type=BeginningOfMainPhaseTriggeredEvent,\n168\t                condition=_condition,\n169\t                effect=_effect,\n170\t                source=source,\n171\t                controller=controller,\n172\t            )\n173\t        )\n174\t"}]},"parent_tool_use_id":null,"session_id":"21c621d1-2ff1-4c6e-baa9-3ddcfe6a3d2a","uuid":"6ec36167-bcf5-4fe5-8087-7d4e064e5640","timestamp":"2026-06-01T23:33:36.115Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/sos/sos_57/card_impl.py","content":"\"\"\"Card implementation for Mana Sculpt.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import Instant\nfrom engine.types import CardType, ManaCost, ManaType, TargetRequirement, Zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\ndef _get_chosen_target(card: Any) -> Any:\n    \"\"\"Retrieve the first chosen target for a spell.\"\"\"\n    chosen = getattr(card, \"chosen_targets\", None)\n    if chosen:\n        return chosen[0]\n    return getattr(card, \"_resolve_target\", None)\n\n\ndef _counter_spell(game: \"GameState\", stack_obj: Any) -> None:\n    \"\"\"Counter a spell — remove from stack and move its card to the graveyard.\"\"\"\n    from engine.stack import StackObject\n\n    if not isinstance(stack_obj, StackObject):\n        return\n\n    card = stack_obj.source\n    stack_items = game.stack._items  # noqa: SLF001\n    found = False\n    for i, item in enumerate(stack_items):\n        if item is stack_obj:\n            stack_items.pop(i)\n            found = True\n            break\n\n    if not found:\n        return\n\n    controller = stack_obj.controller\n    owner = getattr(card, \"owner\", controller)\n\n    if controller is not None:\n        stack_zone = controller.zones[Zone.STACK]\n        if stack_zone.contains(card):\n            stack_zone.remove(card)\n\n    if owner is not None:\n        owner.zones[Zone.GRAVEYARD].add(card)\n\n\ndef _controls_wizard(player: Any) -> bool:\n    \"\"\"Return ``True`` if *player* controls a creature with the Wizard subtype.\"\"\"\n    if player is None:\n        return False\n    bf = player.zones[Zone.BATTLEFIELD]\n    for obj in bf.get_all():\n        if CardType.CREATURE not in getattr(obj, \"card_types\", set()):\n            continue\n        if \"Wizard\" in getattr(obj, \"subtypes\", set()):\n            return True\n    return False\n\n\ndef _spell_mana_value(stack_obj: Any) -> int:\n    \"\"\"Return the amount of mana spent to cast the spell on *stack_obj*.\n\n    Prefers the actual mana paid (``mana_spent``, recorded by the casting\n    pipeline); falls back to the spell's mana value if that is unavailable.\n    \"\"\"\n    source = getattr(stack_obj, \"source\", None)\n    amount = getattr(source, \"mana_spent\", None)\n    if amount is not None:\n        return int(amount)\n    cost = getattr(source, \"mana_cost\", None)\n    if cost is not None:\n        return cost.cmc\n    return 0\n\n\nclass _DelayedManaSource:\n    \"\"\"Lightweight identity object owning the delayed-mana trigger.\"\"\"\n\n    name = \"Mana Sculpt (delayed mana)\"\n\n\nclass ManaSculpt(Instant):\n    \"\"\"Mana Sculpt — {1}{U}{U} — Instant.\n\n    Counter target spell. If you control a Wizard, add an amount of {C}\n    equal to the amount of mana spent to cast that spell at the beginning\n    of your next main phase.\n\n    SOS collector number 57.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"Mana Sculpt\")\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{U}{U}\"))\n        kwargs.setdefault(\n            \"rules_text\",\n            \"Counter target spell. If you control a Wizard, add an amount \"\n            \"of {C} equal to the amount of mana spent to cast that spell at \"\n            \"the beginning of your next main phase.\",\n        )\n        super().__init__(**kwargs)\n\n    def can_cast(self, game: \"GameState\") -> bool:\n        \"\"\"Cannot cast unless there's a spell on the stack to counter.\"\"\"\n        for stack_obj in game.stack.objects():\n            if stack_obj.source is self:\n                continue\n            if getattr(stack_obj, \"is_spell\", True):\n                return True\n        return False\n\n    def get_targets(self, game: \"GameState\") -> list[Any]:\n        \"\"\"Target spell on the stack.\"\"\"\n        return [\n            TargetRequirement(\n                filter_fn=lambda obj: obj is not self\n                and getattr(obj, \"is_spell\", True),\n                description=\"target spell\",\n                zone=Zone.STACK,\n            )\n        ]\n\n    def on_resolve(self, game: \"GameState\") -> None:\n        \"\"\"Counter the target spell; schedule delayed colorless mana.\"\"\"\n        target = _get_chosen_target(self)\n        if target is None:\n            return\n\n        amount = _spell_mana_value(target)\n        _counter_spell(game, target)\n\n        controller = self.controller\n        if controller is None:\n            return\n        if not _controls_wizard(controller):\n            return\n        if amount <= 0:\n            return\n\n        self._schedule_delayed_mana(game, controller, amount)\n\n    @staticmethod\n    def _schedule_delayed_mana(\n        game: \"GameState\", controller: Any, amount: int\n    ) -> None:\n        \"\"\"Register a one-shot trigger that adds {C} at the next main phase.\"\"\"\n        from engine.events import BeginningOfMainPhaseTriggeredEvent\n        from engine.triggers import TriggerRegistration\n\n        source = _DelayedManaSource()\n\n        def _condition(game: \"GameState\", event: Any) -> bool:\n            return getattr(event, \"player\", None) is controller\n\n        def _effect(game: \"GameState\") -> None:\n            controller.mana_pool.add(ManaType.COLORLESS, amount)\n            game.trigger_manager.unregister(source)\n\n        game.trigger_manager.register(\n            TriggerRegistration(\n                event_type=BeginningOfMainPhaseTriggeredEvent,\n                condition=_condition,\n                effect=_effect,\n                source=source,\n                controller=controller,\n            )\n        )\n","numLines":174,"startLine":1,"totalLines":174}}}
