    return max(0, min(raw + granted, generic))"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16707,"cache_read_input_tokens":131448,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":16707},"output_tokens":38,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"21c621d1-2ff1-4c6e-baa9-3ddcfe6a3d2a","uuid":"7753b8a0-1af4-470a-9892-af04e0659e26","request_id":"req_011CbdPNMjTJAviCfUy5uKjs"}
