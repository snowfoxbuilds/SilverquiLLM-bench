{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WdmDPvkVzE6nRUZCwdkRwy","type":"tool_result","content":"1\t\"\"\"Card implementation for The Dawning Archaic.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.events import AttacksTriggeredEvent\n9\tfrom engine.types import CardType, Keyword, ManaCost, Supertype, Zone\n10\t\n11\tif TYPE_CHECKING:\n12\t    from engine.game_state import GameState\n13\t\n14\t\n15\tdef _is_instant_or_sorcery(card: Any) -> bool:\n16\t    types = getattr(card, \"card_types\", set())\n17\t    return CardType.INSTANT in types or CardType.SORCERY in types\n18\t\n19\t\n20\tdef _instant_sorcery_in_graveyard(player: Any) -> list[Any]:\n21\t    if player is None:\n22\t        return []\n23\t    gy = player.zones[Zone.GRAVEYARD]\n24\t    return [c for c in gy.get_all() if _is_instant_or_sorcery(c)]\n25\t\n26\t\n27\tclass TheDawningArchaic(Creature):\n28\t    \"\"\"The Dawning Archaic — {10} — 7/7 — Legendary Avatar.\n29\t\n30\t    This spell costs {1} less to cast for each instant and sorcery card in\n31\t    your graveyard.\n32\t    Reach.\n33\t    Whenever The Dawning Archaic attacks, you may cast target instant or\n34\t    sorcery card from your graveyard without paying its mana cost. If that\n35\t    spell would be put into your graveyard, exile it instead.\n36\t\n37\t    SOS collector number 1.\n38\t    \"\"\"\n39\t\n40\t    def __init__(self, **kwargs: Any) -> None:\n41\t        kwargs.setdefault(\"name\", \"The Dawning Archaic\")\n42\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{10}\"))\n43\t        kwargs.setdefault(\"base_power\", 7)\n44\t        kwargs.setdefault(\"base_toughness\", 7)\n45\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.LEGENDARY}\n46\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Avatar\"}\n47\t        kwargs.setdefault(\"keywords\", Keyword.REACH)\n48\t        kwargs.setdefault(\n49\t            \"rules_text\",\n50\t            \"This spell costs {1} less to cast for each instant and sorcery \"\n51\t            \"card in your graveyard.\\nReach\\n\"\n52\t            \"Whenever The Dawning Archaic attacks, you may cast target \"\n53\t            \"instant or sorcery card from your graveyard without paying its \"\n54\t            \"mana cost. If that spell would be put into your graveyard, \"\n55\t            \"exile it instead.\",\n56\t        )\n57\t        super().__init__(**kwargs)\n58\t\n59\t    def cost_reduction(self, game: \"GameState\") -> int:\n60\t        \"\"\"{1} less for each instant/sorcery card in your graveyard.\"\"\"\n61\t        return len(_instant_sorcery_in_graveyard(self.controller))\n62\t\n63\t    def register_triggers(self, game: \"GameState\") -> None:\n64\t        \"\"\"On attack, may free-cast an instant/sorcery from the graveyard.\"\"\"\n65\t        from engine.triggers import TriggerRegistration\n66\t\n67\t        source = self\n68\t        controller = getattr(self, \"controller\", None) or game.active_player\n69\t\n70\t        def _condition(game: \"GameState\", event: AttacksTriggeredEvent) -> bool:\n71\t            return getattr(event, \"creature\", None) is source\n72\t\n73\t        def _effect(game: \"GameState\") -> None:\n74\t            from engine.casting import cast_spell_free\n75\t\n76\t            controller = source.controller\n77\t            if controller is None:\n78\t                return\n79\t            candidates = _instant_sorcery_in_graveyard(controller)\n80\t            if not candidates:\n81\t                return\n82\t            if not controller.choose_yes_no(\n83\t                \"Cast an instant or sorcery from your graveyard for free?\"\n84\t            ):\n85\t                return\n86\t            chosen = controller.choose_card(\n87\t                candidates, \"Choose an instant or sorcery to cast from your graveyard\"\n88\t            )\n89\t            if chosen is None or chosen not in candidates:\n90\t                return\n91\t            # If this spell would hit the graveyard, exile it instead.\n92\t            chosen._replace_graveyard_with_exile = True\n93\t            try:\n94\t                cast_spell_free(game, controller, chosen, Zone.GRAVEYARD)\n95\t            except Exception:\n96\t                # Casting failed (e.g. no legal targets) — clear the flag.\n97\t                chosen._replace_graveyard_with_exile = False\n98\t\n99\t        game.trigger_manager.register(\n100\t            TriggerRegistration(\n101\t                event_type=AttacksTriggeredEvent,\n102\t                condition=_condition,\n103\t                effect=_effect,\n104\t                source=self,\n105\t                controller=controller,\n106\t            )\n107\t        )\n108\t"}]},"parent_tool_use_id":null,"session_id":"21c621d1-2ff1-4c6e-baa9-3ddcfe6a3d2a","uuid":"ce2a3097-91e2-46ae-8a9e-8476b71318a0","timestamp":"2026-06-01T23:33:36.302Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/sos/sos_1/card_impl.py","content":"\"\"\"Card implementation for The Dawning Archaic.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import Creature\nfrom engine.events import AttacksTriggeredEvent\nfrom engine.types import CardType, Keyword, ManaCost, Supertype, Zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\ndef _is_instant_or_sorcery(card: Any) -> bool:\n    types = getattr(card, \"card_types\", set())\n    return CardType.INSTANT in types or CardType.SORCERY in types\n\n\ndef _instant_sorcery_in_graveyard(player: Any) -> list[Any]:\n    if player is None:\n        return []\n    gy = player.zones[Zone.GRAVEYARD]\n    return [c for c in gy.get_all() if _is_instant_or_sorcery(c)]\n\n\nclass TheDawningArchaic(Creature):\n    \"\"\"The Dawning Archaic — {10} — 7/7 — Legendary Avatar.\n\n    This spell costs {1} less to cast for each instant and sorcery card in\n    your graveyard.\n    Reach.\n    Whenever The Dawning Archaic attacks, you may cast target instant or\n    sorcery card from your graveyard without paying its mana cost. If that\n    spell would be put into your graveyard, exile it instead.\n\n    SOS collector number 1.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"The Dawning Archaic\")\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{10}\"))\n        kwargs.setdefault(\"base_power\", 7)\n        kwargs.setdefault(\"base_toughness\", 7)\n        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.LEGENDARY}\n        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Avatar\"}\n        kwargs.setdefault(\"keywords\", Keyword.REACH)\n        kwargs.setdefault(\n            \"rules_text\",\n            \"This spell costs {1} less to cast for each instant and sorcery \"\n            \"card in your graveyard.\\nReach\\n\"\n            \"Whenever The Dawning Archaic attacks, you may cast target \"\n            \"instant or sorcery card from your graveyard without paying its \"\n            \"mana cost. If that spell would be put into your graveyard, \"\n            \"exile it instead.\",\n        )\n        super().__init__(**kwargs)\n\n    def cost_reduction(self, game: \"GameState\") -> int:\n        \"\"\"{1} less for each instant/sorcery card in your graveyard.\"\"\"\n        return len(_instant_sorcery_in_graveyard(self.controller))\n\n    def register_triggers(self, game: \"GameState\") -> None:\n        \"\"\"On attack, may free-cast an instant/sorcery from the graveyard.\"\"\"\n        from engine.triggers import TriggerRegistration\n\n        source = self\n        controller = getattr(self, \"controller\", None) or game.active_player\n\n        def _condition(game: \"GameState\", event: AttacksTriggeredEvent) -> bool:\n            return getattr(event, \"creature\", None) is source\n\n        def _effect(game: \"GameState\") -> None:\n            from engine.casting import cast_spell_free\n\n            controller = source.controller\n            if controller is None:\n                return\n            candidates = _instant_sorcery_in_graveyard(controller)\n            if not candidates:\n                return\n            if not controller.choose_yes_no(\n                \"Cast an instant or sorcery from your graveyard for free?\"\n            ):\n                return\n            chosen = controller.choose_card(\n                candidates, \"Choose an instant or sorcery to cast from your graveyard\"\n            )\n            if chosen is None or chosen not in candidates:\n                return\n            # If this spell would hit the graveyard, exile it instead.\n            chosen._replace_graveyard_with_exile = True\n            try:\n                cast_spell_free(game, controller, chosen, Zone.GRAVEYARD)\n            except Exception:\n                # Casting failed (e.g. no legal targets) — clear the flag.\n                chosen._replace_graveyard_with_exile = False\n\n        game.trigger_manager.register(\n            TriggerRegistration(\n                event_type=AttacksTriggeredEvent,\n                condition=_condition,\n                effect=_effect,\n                source=self,\n                controller=controller,\n            )\n        )\n","numLines":108,"startLine":1,"totalLines":108}}}
