+def _apply_casualty(
+    game: GameState,
+    card: CardImpl,
+    controller: Player,
+    stack_obj: StackObject,
+) -> None:
+    """Apply casualty if any permanent grants it to *card*.
+
+    Casualty N: as the spell is cast, its controller may sacrifice a
+    creature with power N or greater; when they do, a copy of the spell is
+    put onto the stack.  Only instants and sorceries are eligible here.
+
+    The casualty value is sourced from permanents that expose a
+    ``grants_casualty(game, card, controller) -> int`` hook (e.g. an Elder
+    Dragon granting casualty 1 to all your instant/sorcery spells).
+    """
+    if not (card.card_types & {CardType.INSTANT, CardType.SORCERY}):
+        return
+
+    n = 0
+    for permanent in list(controller.zones[Zone.BATTLEFIELD].get_all()):
+        hook = getattr(permanent, "grants_casualty", None)
+        if hook is None:
+            continue
+        n = max(n, hook(game, card, controller))
+
+    if n <= 0:
+        return
+
+    eligible = [
+        c for c in controller.zones[Zone.BATTLEFIELD].get_all()
+        if c is not card
+        and CardType.CREATURE in getattr(c, "card_types", set())
+        and getattr(c, "power", 0) >= n
+    ]
+    if not eligible:
+        return
+
+    if not controller.choose_yes_no(f"Pay casualty {n} (sacrifice a creature)?"):
+        return
+
+    chosen = controller.choose(
+        eligible, f"choose creature to sacrifice for casualty {n}"
+    )
+    if chosen is None or chosen not in eligible:
+        return
+
+    from engine.game import sacrifice
+    from engine.stack import copy_spell
+
+    sacrifice(game, controller, chosen)
+    copy_obj = copy_spell(game, stack_obj, controller)
+    game.stack.push(copy_obj)
+
 
