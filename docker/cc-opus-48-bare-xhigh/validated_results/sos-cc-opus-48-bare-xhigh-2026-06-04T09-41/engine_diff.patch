+def surveil(game: GameState, player: Player, n: int) -> list[Any]:
+    """Surveil *n* (CR 701.25): look at the top *n* cards of *player*'s
+    library, put any number into the graveyard and the rest back on top.
+
+    Each looked-at card is offered to the player (top-first) via
+    :meth:`Player.choose_yes_no`; ``True`` sends it to the graveyard.
+    Cards kept stay on top in their original relative order.
+
+    Returns the list of cards kept on top (top-first).
+    """
+    if n <= 0:
+        return []
+
+    library = player.zones[Zone.LIBRARY]
+    graveyard = player.zones[Zone.GRAVEYARD]
+
+    # ``top(n)`` is bottom-to-top; reverse so we examine the topmost first.
+    top_cards = list(reversed(library.top(n)))
+    kept: list[Any] = []
+    for card in top_cards:
+        to_graveyard = player.choose_yes_no(
+            f"Surveil: put {getattr(card, 'name', 'card')!r} into your graveyard?"
+        )
+        if to_graveyard:
+            library.remove(card)
+            graveyard.add(card)
+        else:
+            kept.append(card)
+    return kept
+
+
+def flip_coins(game: GameState, player: Player, n: int) -> int:
+    """Flip *n* coins for *player* and return the number that came up heads.
+
+    Coin results are obtained deterministically via :meth:`Player.choose`
+    (each flip offers ``[True, False]`` where ``True`` is heads), so scripted
+    players control the outcome.
+    """
+    heads = 0
+    for _ in range(max(0, n)):
+        result = player.choose([True, False], "flip a coin — is it heads?")
+        if result:
+            heads += 1
+    return heads
+
+
