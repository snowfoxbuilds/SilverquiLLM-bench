{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0129dBxsj6SP1cB1XXU1qM84","type":"tool_result","content":"1\t\"\"\"Card implementation for Rite of the Dragoncaller.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom dataclasses import dataclass\n4\tfrom typing import TYPE_CHECKING, Any\n5\tfrom engine.card import ActivatedAbility, Creature, Enchantment\n6\tfrom engine.continuous_effects import ContinuousEffect, DURATION_PERMANENT, Layer, SubLayer\n7\tfrom engine.types import CardType, Keyword, ManaCost, TargetRequirement, Zone\n8\tfrom engine.events import SpellCastTriggeredEvent\n9\tif TYPE_CHECKING:\n10\t    from engine.game_state import GameState\n11\t    from cards.registry import CardRegistry\n12\t\n13\tdef _is_on_battlefield(game: Any, obj: Any) -> bool:\n14\t    \"\"\"Check if *obj* is on any player's battlefield.\"\"\"\n15\t    for player in game.players:\n16\t        if game.get_battlefield(player).contains(obj):\n17\t            return True\n18\t    return False\n19\t\n20\tclass RiteOfTheDragoncaller(Enchantment):\n21\t    \"\"\"Rite of the Dragoncaller — {4}{R}{R} — Create 5/5 Dragon on spell cast.\n22\t\n23\t    Whenever you cast an instant or sorcery spell, create a 5/5 red Dragon\n24\t    creature token with flying.\n25\t\n26\t    FDN collector number 92.\n27\t    \"\"\"\n28\t\n29\t    def __init__(self, **kwargs: Any) -> None:\n30\t        kwargs.setdefault('name', 'Rite of the Dragoncaller')\n31\t        kwargs.setdefault('mana_cost', ManaCost.parse('{4}{R}{R}'))\n32\t        kwargs.setdefault('rules_text', 'Whenever you cast an instant or sorcery spell, create a 5/5 red Dragon creature token with flying.')\n33\t        super().__init__(**kwargs)\n34\t\n35\t    def on_resolve(self, game: GameState) -> None:\n36\t        pass\n37\t\n38\t    def register_triggers(self, game: GameState) -> None:\n39\t        from engine.triggers import TriggerRegistration\n40\t        from engine.game import create_token\n41\t        source = self\n42\t\n43\t        def _condition(game: Any, event: dict) -> bool:\n44\t            if not _is_on_battlefield(game, source):\n45\t                return False\n46\t            spell = event.spell\n47\t            if spell is None:\n48\t                return False\n49\t            controller = source.controller\n50\t            if controller is None:\n51\t                return False\n52\t            spell_controller = getattr(spell, 'controller', None)\n53\t            if spell_controller is not controller:\n54\t                return False\n55\t            card_types = getattr(spell, 'card_types', set())\n56\t            return CardType.INSTANT in card_types or CardType.SORCERY in card_types\n57\t\n58\t        def _effect(game: GameState) -> None:\n59\t            controller = source.controller\n60\t            if controller is None:\n61\t                return\n62\t            token = Creature(name='Dragon', subtypes={'Dragon'}, base_power=5, base_toughness=5, keywords=Keyword.FLYING)\n63\t            token.is_token = True\n64\t            create_token(game, controller, token)\n65\t        controller = getattr(self, 'controller', None) or game.active_player\n66\t        game.trigger_manager.register(TriggerRegistration(event_type=SpellCastTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=controller))\n67\t"}]},"parent_tool_use_id":null,"session_id":"735f529e-7bc8-4328-a211-d2f095818fd0","uuid":"3f61f2ed-9685-44a0-89a5-76f60edd63b5","timestamp":"2026-06-04T10:21:39.819Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_92/card_impl.py","content":"\"\"\"Card implementation for Rite of the Dragoncaller.\"\"\"\nfrom __future__ import annotations\nfrom dataclasses import dataclass\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import ActivatedAbility, Creature, Enchantment\nfrom engine.continuous_effects import ContinuousEffect, DURATION_PERMANENT, Layer, SubLayer\nfrom engine.types import CardType, Keyword, ManaCost, TargetRequirement, Zone\nfrom engine.events import SpellCastTriggeredEvent\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from cards.registry import CardRegistry\n\ndef _is_on_battlefield(game: Any, obj: Any) -> bool:\n    \"\"\"Check if *obj* is on any player's battlefield.\"\"\"\n    for player in game.players:\n        if game.get_battlefield(player).contains(obj):\n            return True\n    return False\n\nclass RiteOfTheDragoncaller(Enchantment):\n    \"\"\"Rite of the Dragoncaller — {4}{R}{R} — Create 5/5 Dragon on spell cast.\n\n    Whenever you cast an instant or sorcery spell, create a 5/5 red Dragon\n    creature token with flying.\n\n    FDN collector number 92.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Rite of the Dragoncaller')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{4}{R}{R}'))\n        kwargs.setdefault('rules_text', 'Whenever you cast an instant or sorcery spell, create a 5/5 red Dragon creature token with flying.')\n        super().__init__(**kwargs)\n\n    def on_resolve(self, game: GameState) -> None:\n        pass\n\n    def register_triggers(self, game: GameState) -> None:\n        from engine.triggers import TriggerRegistration\n        from engine.game import create_token\n        source = self\n\n        def _condition(game: Any, event: dict) -> bool:\n            if not _is_on_battlefield(game, source):\n                return False\n            spell = event.spell\n            if spell is None:\n                return False\n            controller = source.controller\n            if controller is None:\n                return False\n            spell_controller = getattr(spell, 'controller', None)\n            if spell_controller is not controller:\n                return False\n            card_types = getattr(spell, 'card_types', set())\n            return CardType.INSTANT in card_types or CardType.SORCERY in card_types\n\n        def _effect(game: GameState) -> None:\n            controller = source.controller\n            if controller is None:\n                return\n            token = Creature(name='Dragon', subtypes={'Dragon'}, base_power=5, base_toughness=5, keywords=Keyword.FLYING)\n            token.is_token = True\n            create_token(game, controller, token)\n        controller = getattr(self, 'controller', None) or game.active_player\n        game.trigger_manager.register(TriggerRegistration(event_type=SpellCastTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=controller))\n","numLines":67,"startLine":1,"totalLines":67}}}
