shuffle.\\n\"\n48\t            \"• Target creature you control fights target creature you don't control.\",\n49\t        )\n50\t        super().__init__(**kwargs)\n51\t        self.chosen_mode: int | None = None\n52\t\n53\t    def get_modes(self) -> list[Mode]:\n54\t        return [\n55\t            Mode(name=\"Land Search\", description=\"Search your library for a basic land card, reveal it, put it into your hand, then shuffle.\"),\n56\t            Mode(name=\"Fight\", description=\"Target creature you control fights target creature you don't control.\"),\n57\t        ]\n58\t\n59\t    def on_resolve(self, game: GameState) -> None:\n60\t        mode = self.chosen_mode\n61\t        if mode is None:\n62\t            return\n63\t        controller = _get_controller(self)\n64\t        if controller is None:\n65\t            return\n66\t        if mode == 0:\n67\t            # Search library for a basic land.\n68\t            from engine.types import Supertype\n69\t            library = controller.zones[Zone.LIBRARY]\n70\t            found = False\n71\t            for card in library.get_all():\n72\t                if (CardType.LAND in getattr(card, \"card_types\", set())\n73\t                        and Supertype.BASIC in getattr(card, \"supertypes\", set())):\n74\t                    library.remove(card)\n75\t                    controller.zones[Zone.HAND].add(card)\n76\t                    found = True\n77\t                    break\n78\t            library.shuffle()\n79\t        elif mode == 1:\n80\t            # Fight\n81\t            from engine.game import deal_damage\n82\t            targets = _get_targets(self)\n83\t            if len(targets) >= 2:\n84\t                a, b = targets[0], targets[1]\n85\t                deal_damage(game, a, b, getattr(a, \"power\", 0))\n86\t                deal_damage(game, b, a, getattr(b, \"power\", 0))\n87\t"}]},"parent_tool_use_id":null,"session_id":"735f529e-7bc8-4328-a211-d2f095818fd0","uuid":"f3ae555d-6ce4-4ba8-936a-1de1f