{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0172FqprJKz2HQNS3SwuMas8","type":"tool_result","content":"1\t\"\"\"Turn execution loop for the SilverquiLLM engine.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport warnings\n6\tfrom typing import TYPE_CHECKING\n7\t\n8\tif TYPE_CHECKING:\n9\t    from engine.game_state import GameState\n10\t\n11\tfrom engine.stack import priority_loop\n12\tfrom engine.types import Phase, Step, Zone\n13\t\n14\t\n15\t# Maximum hand size — players discard down to this during cleanup.\n16\tMAX_HAND_SIZE: int = 7\n17\t\n18\t\n19\t# Steps/phases where priority is given to players.\n20\t# In MTG, players do NOT receive priority during Untap and Cleanup (normally).\n21\t_NO_PRIORITY_STEPS: set[tuple[Phase, Step | None]] = {\n22\t    (Phase.BEGINNING, Step.UNTAP),\n23\t    (Phase.ENDING, Step.CLEANUP),\n24\t}\n25\t\n26\t\n27\tdef _do_untap_step(game: GameState) -> None:\n28\t    \"\"\"Perform untap step actions: untap all permanents controlled by the active player.\n29\t\n30\t    Per MTG rules, the active player untaps all permanents they control\n31\t    during their untap step. Summoning sickness is also cleared at this point.\n32\t    \"\"\"\n33\t    active = game.active_player\n34\t    bf = active.zones[Zone.BATTLEFIELD]\n35\t    for obj in bf.get_all():\n36\t        if hasattr(obj, \"is_tapped\"):\n37\t            obj.is_tapped = False\n38\t        if hasattr(obj, \"summoning_sick\"):\n39\t            obj.summoning_sick = False\n40\t\n41\t    # Reset land plays for the active player\n42\t    active.land_plays_remaining = 1\n43\t\n44\t    # Reset per-turn draw counts for all players (used by \"first card you\n45\t    # drew this turn\" effects such as miracle).\n46\t    for player in game.players:\n47\t        player.cards_drawn_this_turn = 0\n48\t\n49\t\n50\tdef _do_draw_step(game: GameState) -> None:\n51\t    \"\"\"Perform draw step actions: active player draws a card.\n52\t\n53\t    In a two-player game, the starting player (the player who takes\n54\t    turn 1) skips their draw step on that first turn.  This is per\n55\t    MTG comprehensive rules §103.7a.\n56\t    \"\"\"\n57\t    # The starting player skips their draw on turn 1.\n58\t    if game.turn_number == 1 and game.active_player_index == 0:\n59\t        return\n60\t\n61\t    from engine.game import draw_card\n62\t\n63\t    draw_card(game, game.active_player)\n64\t\n65\t\n66\tdef _do_combat_step(game: GameState, step: Step) -> None:\n67\t    \"\"\"Dispatch combat sub-steps to the appropriate combat functions.\n68\t\n69\t    Parameters:\n70\t        game: The current game state.\n71\t        step: The combat step to execute.\n72\t    \"\"\"\n73\t    from engine.combat import (\n74\t        combat_damage_step,\n75\t        declare_attackers_step,\n76\t        declare_blockers_step,\n77\t        end_combat_step,\n78\t    )\n79\t\n80\t    if step == Step.DECLARE_ATTACKERS:\n81\t        declare_attackers_step(game)\n82\t    elif step == Step.DECLARE_BLOCKERS:\n83\t        declare_blockers_step(game)\n84\t    elif step == Step.COMBAT_DAMAGE:\n85\t        combat_damage_step(game)\n86\t    elif step == Step.END_COMBAT:\n87\t        end_combat_step(game)\n88\t\n89\t\n90\tdef _do_cleanup_step(game: GameState) -> None:\n91\t    \"\"\"Perform the cleanup step (MTG rule §514).\n92\t\n93\t    The cleanup step executes the following actions in order:\n94\t\n95\t    1. Active player discards down to maximum hand size (7) using\n96\t       :meth:`Player.choose_card`.\n97\t    2. Remove all \"until end of turn\" continuous effects via\n98\t       :meth:`EffectManager.remove_expired`, then reapply remaining\n99\t       effects for a consistent game state.\n100\t    3. Clear damage marked on all creatures on the battlefield.\n101\t    4. Clear combat-related flags (``dealt_deathtouch_damage``,\n102\t       ``is_attacking``, ``is_blocking``) and reset the combat state.\n103\t    5. Empty all players' mana pools.\n104\t    6. Check state-based actions.\n105\t    7. If triggers fired during cleanup (e.g. from discarding), process\n106\t       them (give priority, resolve stack) and perform another cleanup step.\n107\t    \"\"\"\n108\t    from engine.game import discard as _discard\n109\t    from engine.player import ScriptExhaustedError\n110\t    from engine.state_based_actions import resolve_state_based_actions\n111\t\n112\t    # --- Step 1: Discard to hand size ---\n113\t    active = game.active_player\n114\t    hand = active.zones[Zone.HAND]\n115\t    while len(hand) > MAX_HAND_SIZE:\n116\t        cards_in_hand = hand.get_all()\n117\t        if not cards_in_hand:\n118\t            break  # safety guard\n119\t        try:\n120\t            chosen = active.choose_card(cards_in_hand, \"discard to hand size\")\n121\t        except (ScriptExhaustedError, NotImplementedError) as exc:\n122\t            # Player implementation doesn't support choose_card or script\n123\t            # was exhausted.  Discard deterministically from end.\n124\t            chosen = cards_in_hand[-1]\n125\t            exc_name = type(exc).__name__\n126\t            warnings.warn(\n127\t                f\"{exc_name} during cleanup discard for {active.name}; \"\n128\t                f\"auto-discarding {chosen.name}\"\n129\t            )\n130\t        if chosen is not None and hand.contains(chosen):\n131\t            _discard(game, active, chosen)\n132\t        else:\n133\t            # If choose_card returns something invalid, discard the last card\n134\t            # to avoid an infinite loop.\n135\t            _discard(game, active, cards_in_hand[-1])\n136\t\n137\t    # --- Step 2: Remove \"until end of turn\" continuous effects ---\n138\t    if hasattr(game, \"effect_manager\"):\n139\t        game.effect_manager.remove_expired(game)\n140\t        # Reapply remaining effects so the game state is consistent.\n141\t        game.effect_manager.apply_all(game)\n142\t\n143\t    # --- Step 3: Clear damage on all creatures ---\n144\t    for player in game.players:\n145\t        bf = player.zones[Zone.BATTLEFIELD]\n146\t        for obj in bf.get_all():\n147\t            if hasattr(obj, \"damage_marked\"):\n148\t                obj.damage_marked = 0\n149\t\n150\t    # --- Step 4: Clear combat flags ---\n151\t    for player in game.players:\n152\t        bf = player.zones[Zone.BATTLEFIELD]\n153\t        for obj in bf.get_all():\n154\t            if hasattr(obj, \"dealt_deathtouch_damage\"):\n155\t                obj.dealt_deathtouch_damage = False\n156\t            if hasattr(obj, \"is_attacking\"):\n157\t                obj.is_attacking = False\n158\t            if hasattr(obj, \"is_blocking\"):\n159\t                obj.is_blocking = False\n160\t    # Reset the CombatState itself.\n161\t    if hasattr(game, \"combat_state\"):\n162\t        game.combat_state.clear()\n163\t\n164\t    # --- Step 5: Empty mana pools ---\n165\t    game.empty_mana_pools()\n166\t\n167\t    # --- Step 6: Check state-based actions ---\n168\t    sba_happened = resolve_state_based_actions(game)\n169\t\n170\t    # --- Step 7: If SBAs were performed or triggers fired, process & repeat ---\n171\t    # Rule 514.3a: if state-based actions were performed or triggered abilities\n172\t    # triggered during cleanup, another cleanup step occurs.\n173\t    if sba_happened or not game.stack.is_empty():\n174\t        # Triggers were placed on the stack — give priority and resolve.\n175\t        priority_loop(game)\n176\t        # After resolving, perform another cleanup step (recursive).\n177\t        _do_cleanup_step(game)\n178\t\n179\t\n180\tdef run_turn(game: GameState) -> None:\n181\t    \"\"\"Execute a full turn, iterating through all phases/steps.\n182\t\n183\t    At each priority point (every phase/step except Untap and Cleanup),\n184\t    :func:`priority_loop` is called.  Turn-based actions are performed\n185\t    at the appropriate steps:\n186\t\n187\t    - **Untap**: Untap all permanents, clear summoning sickness, reset\n188\t      land plays.\n189\t    - **Draw**: Active player draws a card.\n190\t    - **Combat**: Delegate to combat system functions.\n191\t    - **Cleanup**: Clear damage, remove expired effects.\n192\t\n193\t    After the last step (Cleanup), the turn number is incremented and\n194\t    the active player swaps via :meth:`GameState.advance_phase`.\n195\t\n196\t    Parameters:\n197\t        game: The game state to advance through one complete turn.\n198\t    \"\"\"\n199\t    start_turn = game.turn_number\n200\t\n201\t    while game.turn_number == start_turn:\n202\t        current = (game.phase, game.step)\n203\t\n204\t        # Perform turn-based actions for the current step\n205\t        if current == (Phase.BEGINNING, Step.UNTAP):\n206\t            _do_untap_step(game)\n207\t        elif current == (Phase.BEGINNING, Step.UPKEEP):\n208\t            from engine.events import BeginningOfUpkeepTriggeredEvent\n209\t            game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n210\t        elif current == (Phase.BEGINNING, Step.DRAW):\n211\t            _do_draw_step(game)\n212\t        elif game.phase in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n213\t            from engine.events import BeginningOfMainPhaseTriggeredEvent\n214\t            game.trigger_manager.fire_event(\n215\t                game,\n216\t                BeginningOfMainPhaseTriggeredEvent(player=game.active_player),\n217\t            )\n218\t        elif game.phase == Phase.COMBAT and game.step is not None:\n219\t            _do_combat_step(game, game.step)\n220\t        elif current == (Phase.ENDING, Step.CLEANUP):\n221\t            _do_cleanup_step(game)\n222\t\n223\t        # Grant priority at this phase/step unless it's Untap or Cleanup.\n224\t        if current not in _NO_PRIORITY_STEPS:\n225\t            priority_loop(game)\n226\t\n227\t        # Advance to the next phase/step (or to next turn).\n228\t        game.advance_phase()\n229\t"}]},"parent_tool_use_id":null,"session_id":"735f529e-7bc8-4328-a211-d2f095818fd0","uuid":"81b7f169-6a8b-490d-b9f0-6eb5e96cf5cb","timestamp":"2026-06-04T10:30:34.065Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/turn.py","content":"\"\"\"Turn execution loop for the SilverquiLLM engine.\"\"\"\n\nfrom __future__ import annotations\n\nimport warnings\nfrom typing import TYPE_CHECKING\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\nfrom engine.stack import priority_loop\nfrom engine.types import Phase, Step, Zone\n\n\n# Maximum hand size — players discard down to this during cleanup.\nMAX_HAND_SIZE: int = 7\n\n\n# Steps/phases where priority is given to players.\n# In MTG, players do NOT receive priority during Untap and Cleanup (normally).\n_NO_PRIORITY_STEPS: set[tuple[Phase, Step | None]] = {\n    (Phase.BEGINNING, Step.UNTAP),\n    (Phase.ENDING, Step.CLEANUP),\n}\n\n\ndef _do_untap_step(game: GameState) -> None:\n    \"\"\"Perform untap step actions: untap all permanents controlled by the active player.\n\n    Per MTG rules, the active player untaps all permanents they control\n    during their untap step. Summoning sickness is also cleared at this point.\n    \"\"\"\n    active = game.active_player\n    bf = active.zones[Zone.BATTLEFIELD]\n    for obj in bf.get_all():\n        if hasattr(obj, \"is_tapped\"):\n            obj.is_tapped = False\n        if hasattr(obj, \"summoning_sick\"):\n            obj.summoning_sick = False\n\n    # Reset land plays for the active player\n    active.land_plays_remaining = 1\n\n    # Reset per-turn draw counts for all players (used by \"first card you\n    # drew this turn\" effects such as miracle).\n    for player in game.players:\n        player.cards_drawn_this_turn = 0\n\n\ndef _do_draw_step(game: GameState) -> None:\n    \"\"\"Perform draw step actions: active player draws a card.\n\n    In a two-player game, the starting player (the player who takes\n    turn 1) skips their draw step on that first turn.  This is per\n    MTG comprehensive rules §103.7a.\n    \"\"\"\n    # The starting player skips their draw on turn 1.\n    if game.turn_number == 1 and game.active_player_index == 0:\n        return\n\n    from engine.game import draw_card\n\n    draw_card(game, game.active_player)\n\n\ndef _do_combat_step(game: GameState, step: Step) -> None:\n    \"\"\"Dispatch combat sub-steps to the appropriate combat functions.\n\n    Parameters:\n        game: The current game state.\n        step: The combat step to execute.\n    \"\"\"\n    from engine.combat import (\n        combat_damage_step,\n        declare_attackers_step,\n        declare_blockers_step,\n        end_combat_step,\n    )\n\n    if step == Step.DECLARE_ATTACKERS:\n        declare_attackers_step(game)\n    elif step == Step.DECLARE_BLOCKERS:\n        declare_blockers_step(game)\n    elif step == Step.COMBAT_DAMAGE:\n        combat_damage_step(game)\n    elif step == Step.END_COMBAT:\n        end_combat_step(game)\n\n\ndef _do_cleanup_step(game: GameState) -> None:\n    \"\"\"Perform the cleanup step (MTG rule §514).\n\n    The cleanup step executes the following actions in order:\n\n    1. Active player discards down to maximum hand size (7) using\n       :meth:`Player.choose_card`.\n    2. Remove all \"until end of turn\" continuous effects via\n       :meth:`EffectManager.remove_expired`, then reapply remaining\n       effects for a consistent game state.\n    3. Clear damage marked on all creatures on the battlefield.\n    4. Clear combat-related flags (``dealt_deathtouch_damage``,\n       ``is_attacking``, ``is_blocking``) and reset the combat state.\n    5. Empty all players' mana pools.\n    6. Check state-based actions.\n    7. If triggers fired during cleanup (e.g. from discarding), process\n       them (give priority, resolve stack) and perform another cleanup step.\n    \"\"\"\n    from engine.game import discard as _discard\n    from engine.player import ScriptExhaustedError\n    from engine.state_based_actions import resolve_state_based_actions\n\n    # --- Step 1: Discard to hand size ---\n    active = game.active_player\n    hand = active.zones[Zone.HAND]\n    while len(hand) > MAX_HAND_SIZE:\n        cards_in_hand = hand.get_all()\n        if not cards_in_hand:\n            break  # safety guard\n        try:\n            chosen = active.choose_card(cards_in_hand, \"discard to hand size\")\n        except (ScriptExhaustedError, NotImplementedError) as exc:\n            # Player implementation doesn't support choose_card or script\n            # was exhausted.  Discard deterministically from end.\n            chosen = cards_in_hand[-1]\n            exc_name = type(exc).__name__\n            warnings.warn(\n                f\"{exc_name} during cleanup discard for {active.name}; \"\n                f\"auto-discarding {chosen.name}\"\n            )\n        if chosen is not None and hand.contains(chosen):\n            _discard(game, active, chosen)\n        else:\n            # If choose_card returns something invalid, discard the last card\n            # to avoid an infinite loop.\n            _discard(game, active, cards_in_hand[-1])\n\n    # --- Step 2: Remove \"until end of turn\" continuous effects ---\n    if hasattr(game, \"effect_manager\"):\n        game.effect_manager.remove_expired(game)\n        # Reapply remaining effects so the game state is consistent.\n        game.effect_manager.apply_all(game)\n\n    # --- Step 3: Clear damage on all creatures ---\n    for player in game.players:\n        bf = player.zones[Zone.BATTLEFIELD]\n        for obj in bf.get_all():\n            if hasattr(obj, \"damage_marked\"):\n                obj.damage_marked = 0\n\n    # --- Step 4: Clear combat flags ---\n    for player in game.players:\n        bf = player.zones[Zone.BATTLEFIELD]\n        for obj in bf.get_all():\n            if hasattr(obj, \"dealt_deathtouch_damage\"):\n                obj.dealt_deathtouch_damage = False\n            if hasattr(obj, \"is_attacking\"):\n                obj.is_attacking = False\n            if hasattr(obj, \"is_blocking\"):\n                obj.is_blocking = False\n    # Reset the CombatState itself.\n    if hasattr(game, \"combat_state\"):\n        game.combat_state.clear()\n\n    # --- Step 5: Empty mana pools ---\n    game.empty_mana_pools()\n\n    # --- Step 6: Check state-based actions ---\n    sba_happened = resolve_state_based_actions(game)\n\n    # --- Step 7: If SBAs were performed or triggers fired, process & repeat ---\n    # Rule 514.3a: if state-based actions were performed or triggered abilities\n    # triggered during cleanup, another cleanup step occurs.\n    if sba_happened or not game.stack.is_empty():\n        # Triggers were placed on the stack — give priority and resolve.\n        priority_loop(game)\n        # After resolving, perform another cleanup step (recursive).\n        _do_cleanup_step(game)\n\n\ndef run_turn(game: GameState) -> None:\n    \"\"\"Execute a full turn, iterating through all phases/steps.\n\n    At each priority point (every phase/step except Untap and Cleanup),\n    :func:`priority_loop` is called.  Turn-based actions are performed\n    at the appropriate steps:\n\n    - **Untap**: Untap all permanents, clear summoning sickness, reset\n      land plays.\n    - **Draw**: Active player draws a card.\n    - **Combat**: Delegate to combat system functions.\n    - **Cleanup**: Clear damage, remove expired effects.\n\n    After the last step (Cleanup), the turn number is incremented and\n    the active player swaps via :meth:`GameState.advance_phase`.\n\n    Parameters:\n        game: The game state to advance through one complete turn.\n    \"\"\"\n    start_turn = game.turn_number\n\n    while game.turn_number == start_turn:\n        current = (game.phase, game.step)\n\n        # Perform turn-based actions for the current step\n        if current == (Phase.BEGINNING, Step.UNTAP):\n            _do_untap_step(game)\n        elif current == (Phase.BEGINNING, Step.UPKEEP):\n            from engine.events import BeginningOfUpkeepTriggeredEvent\n            game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n        elif current == (Phase.BEGINNING, Step.DRAW):\n            _do_draw_step(game)\n        elif game.phase in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n            from engine.events import BeginningOfMainPhaseTriggeredEvent\n            game.trigger_manager.fire_event(\n                game,\n                BeginningOfMainPhaseTriggeredEvent(player=game.active_player),\n            )\n        elif game.phase == Phase.COMBAT and game.step is not None:\n            _do_combat_step(game, game.step)\n        elif current == (Phase.ENDING, Step.CLEANUP):\n            _do_cleanup_step(game)\n\n        # Grant priority at this phase/step unless it's Untap or Cleanup.\n        if current not in _NO_PRIORITY_STEPS:\n            priority_loop(game)\n\n        # Advance to the next phase/step (or to next turn).\n        game.advance_phase()\n","numLines":229,"startLine":1,"totalLines":229}}}
