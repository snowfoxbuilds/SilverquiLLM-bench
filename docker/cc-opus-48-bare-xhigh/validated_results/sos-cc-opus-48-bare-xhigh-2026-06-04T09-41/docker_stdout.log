{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Foi8uT9AHzP7Lh68dAZA1a","type":"tool_result","content":"1\t\"\"\"Card implementation for Apothecary Stomper.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom typing import TYPE_CHECKING, Any\n4\tfrom engine.card import Creature, Instant, Mode, Sorcery\n5\tfrom engine.continuous_effects import ContinuousEffect, DURATION_END_OF_TURN, Layer, SubLayer\n6\tfrom engine.types import CardType, Keyword, ManaCost, Zone\n7\tfrom engine.events import EntersBattlefieldTriggeredEvent\n8\tif TYPE_CHECKING:\n9\t    from engine.game_state import GameState\n10\t    from cards.registry import CardRegistry\n11\t\n12\tdef _get_controller(card: Any) -> Any:\n13\t    \"\"\"Return the controller of a card, or None.\"\"\"\n14\t    return getattr(card, 'controller', None)\n15\t\n16\tdef _get_target(card: Any) -> Any:\n17\t    \"\"\"Return the first chosen target or the _resolve_target fallback.\"\"\"\n18\t    chosen = getattr(card, 'chosen_targets', None)\n19\t    if chosen:\n20\t        return chosen[0]\n21\t    return getattr(card, '_resolve_target', None)\n22\t\n23\tdef _self_etb_condition(source: Any):\n24\t    \"\"\"Return a condition callable that matches only when *source* enters.\"\"\"\n25\t\n26\t    def _condition(game: Any, event: dict) -> bool:\n27\t        return event.permanent is source\n28\t    return _condition\n29\t\n30\tclass ApothecaryStomper(Creature):\n31\t    \"\"\"Apothecary Stomper — {4}{G}{G} — 4/4 — Elephant\n32\t\n33\t    Vigilance.\n34\t    When this creature enters, choose one —\n35\t    - Put two +1/+1 counters on target creature you control.\n36\t    - You gain 4 life.\n37\t\n38\t    FDN collector number 99.\n39\t    \"\"\"\n40\t\n41\t    def __init__(self, **kwargs: Any) -> None:\n42\t        kwargs.setdefault('name', 'Apothecary Stomper')\n43\t        kwargs.setdefault('mana_cost', ManaCost.parse('{4}{G}{G}'))\n44\t        kwargs.setdefault('base_power', 4)\n45\t        kwargs.setdefault('base_toughness', 4)\n46\t        kwargs.setdefault('subtypes', {'Elephant'})\n47\t        kwargs.setdefault('keywords', Keyword.VIGILANCE)\n48\t        super().__init__(**kwargs)\n49\t        self.chosen_mode: int | None = None\n50\t\n51\t    def get_modes(self) -> list[Mode]:\n52\t        return [Mode(name='Counters', description='Put two +1/+1 counters on target creature you control.'), Mode(name='Life', description='You gain 4 life.')]\n53\t\n54\t    def register_triggers(self, game: GameState) -> None:\n55\t        from engine.triggers import TriggerRegistration\n56\t\n57\t        def _etb_effect(g: GameState) -> None:\n58\t            controller = _get_controller(self)\n59\t            if controller is None:\n60\t                return\n61\t            mode = self.chosen_mode\n62\t            if mode is None:\n63\t                mode = 0\n64\t            if mode == 0:\n65\t                target = _get_target(self)\n66\t                if target is None:\n67\t                    target = self\n68\t                if hasattr(target, 'plus_one_counters'):\n69\t                    target.plus_one_counters += 2\n70\t                    target._base_plus_one_counters = target.plus_one_counters\n71\t            elif mode == 1:\n72\t                controller.life += 4\n73\t        reg = TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=_self_etb_condition(self), effect=_etb_effect, source=self, controller=self.controller or self.owner)\n74\t        game.trigger_manager.register(reg)\n75\t"}]},"parent_tool_use_id":null,"session_id":"735f529e-7bc8-4328-a211-d2f095818fd0","uuid":"d3a26a37-5931-4008-be23-918f78d9b760","timestamp":"2026-06-04T10:21:43.230Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_99/card_impl.py","content":"\"\"\"Card implementation for Apothecary Stomper.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import Creature, Instant, Mode, Sorcery\nfrom engine.continuous_effects import ContinuousEffect, DURATION_END_OF_TURN, Layer, SubLayer\nfrom engine.types import CardType, Keyword, ManaCost, Zone\nfrom engine.events import EntersBattlefieldTriggeredEvent\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from cards.registry import CardRegistry\n\ndef _get_controller(card: Any) -> Any:\n    \"\"\"Return the controller of a card, or None.\"\"\"\n    return getattr(card, 'controller', None)\n\ndef _get_target(card: Any) -> Any:\n    \"\"\"Return the first chosen target or the _resolve_target fallback.\"\"\"\n    chosen = getattr(card, 'chosen_targets', None)\n    if chosen:\n        return chosen[0]\n    return getattr(card, '_resolve_target', None)\n\ndef _self_etb_condition(source: Any):\n    \"\"\"Return a condition callable that matches only when *source* enters.\"\"\"\n\n    def _condition(game: Any, event: dict) -> bool:\n        return event.permanent is source\n    return _condition\n\nclass ApothecaryStomper(Creature):\n    \"\"\"Apothecary Stomper — {4}{G}{G} — 4/4 — Elephant\n\n    Vigilance.\n    When this creature enters, choose one —\n    - Put two +1/+1 counters on target creature you control.\n    - You gain 4 life.\n\n    FDN collector number 99.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Apothecary Stomper')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{4}{G}{G}'))\n        kwargs.setdefault('base_power', 4)\n        kwargs.setdefault('base_toughness', 4)\n        kwargs.setdefault('subtypes', {'Elephant'})\n        kwargs.setdefault('keywords', Keyword.VIGILANCE)\n        super().__init__(**kwargs)\n        self.chosen_mode: int | None = None\n\n    def get_modes(self) -> list[Mode]:\n        return [Mode(name='Counters', description='Put two +1/+1 counters on target creature you control.'), Mode(name='Life', description='You gain 4 life.')]\n\n    def register_triggers(self, game: GameState) -> None:\n        from engine.triggers import TriggerRegistration\n\n        def _etb_effect(g: GameState) -> None:\n            controller = _get_controller(self)\n            if controller is None:\n                return\n            mode = self.chosen_mode\n            if mode is None:\n                mode = 0\n            if mode == 0:\n                target = _get_target(self)\n                if target is None:\n                    target = self\n                if hasattr(target, 'plus_one_counters'):\n                    target.plus_one_counters += 2\n                    target._base_plus_one_counters = target.plus_one_counters\n            elif mode == 1:\n                controller.life += 4\n        reg = TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=_self_etb_condition(self), effect=_etb_effect, source=self, controller=self.controller or self.owner)\n        game.trigger_manager.register(reg)\n","numLines":75,"startLine":1,"totalLines":75}}}
