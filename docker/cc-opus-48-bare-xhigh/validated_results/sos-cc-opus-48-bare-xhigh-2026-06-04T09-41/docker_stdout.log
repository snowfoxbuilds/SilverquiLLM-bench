{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015SzRPdm1uM5ZaqVDMuCd7s","type":"tool_result","content":"1\t\"\"\"Mana pool and cost payment logic.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom engine.types import Color, HybridManaSymbol, ManaCost, ManaType\n6\t\n7\t# Map colored ManaTypes to their corresponding Color enum values.\n8\t_MANA_TO_COLOR: dict[ManaType, Color] = {\n9\t    ManaType.WHITE: Color.WHITE,\n10\t    ManaType.BLUE: Color.BLUE,\n11\t    ManaType.BLACK: Color.BLACK,\n12\t    ManaType.RED: Color.RED,\n13\t    ManaType.GREEN: Color.GREEN,\n14\t}\n15\t\n16\t\n17\tclass ManaPool:\n18\t    \"\"\"Tracks available mana for a player.\n19\t\n20\t    Internal storage uses a ``dict[ManaType, int]`` mapping each mana type\n21\t    to its current count.\n22\t    \"\"\"\n23\t\n24\t    def __init__(self) -> None:\n25\t        self._pool: dict[ManaType, int] = {mt: 0 for mt in ManaType}\n26\t        self._last_payment_colors: list[Color] = []\n27\t\n28\t    # ------------------------------------------------------------------\n29\t    # Basic operations\n30\t    # ------------------------------------------------------------------\n31\t\n32\t    def add(self, mana_type: ManaType, amount: int = 1) -> None:\n33\t        \"\"\"Add *amount* mana of the given type to the pool.\n34\t\n35\t        Parameters:\n36\t            mana_type: The type of mana to add.\n37\t            amount: How many mana to add (must be non-negative).\n38\t        \"\"\"\n39\t        if amount < 0:\n40\t            raise ValueError(f\"Cannot add negative mana: {amount}\")\n41\t        self._pool[mana_type] = self._pool.get(mana_type, 0) + amount\n42\t\n43\t    def empty(self) -> None:\n44\t        \"\"\"Clear the pool — happens at phase/step transitions.\"\"\"\n45\t        for mt in self._pool:\n46\t            self._pool[mt] = 0\n47\t\n48\t    def total(self) -> int:\n49\t        \"\"\"Return the total amount of mana in the pool across all types.\"\"\"\n50\t        return sum(self._pool.values())\n51\t\n52\t    def get(self, mana_type: ManaType) -> int:\n53\t        \"\"\"Return the amount of a specific mana type in the pool.\"\"\"\n54\t        return self._pool.get(mana_type, 0)\n55\t\n56\t    @property\n57\t    def last_payment_colors(self) -> list[Color]:\n58\t        \"\"\"Return the distinct colors of mana spent in the last :meth:`pay` call.\n59\t\n60\t        Colorless mana is not a color and is excluded.  The list is sorted\n61\t        by Color enum order for determinism.  Empty if no payment has been\n62\t        made or if all mana spent was colorless.\n63\t        \"\"\"\n64\t        return list(self._last_payment_colors)\n65\t\n66\t    # ------------------------------------------------------------------\n67\t    # Cost payment\n68\t    # ------------------------------------------------------------------\n69\t\n70\t    def can_pay(self, cost: ManaCost) -> bool:\n71\t        \"\"\"Check whether the pool can satisfy *cost*.\n72\t\n73\t        Generic mana can be paid by any type.  X is treated as 0 for\n74\t        ``can_pay`` unless explicitly set in the cost's generic component.\n75\t        Hybrid symbols can be paid with either option; this method uses\n76\t        backtracking to find a valid assignment.\n77\t\n78\t        Returns:\n79\t            True if the pool has enough mana to pay the cost.\n80\t        \"\"\"\n81\t        remaining: dict[ManaType, int] = dict(self._pool)\n82\t\n83\t        # Pay colored/colorless pips first.\n84\t        for mana_type, count in cost.pips.items():\n85\t            if remaining.get(mana_type, 0) < count:\n86\t                return False\n87\t            remaining[mana_type] = remaining.get(mana_type, 0) - count\n88\t\n89\t        # Solve hybrid symbols with backtracking.\n90\t        if cost.hybrid:\n91\t            if not self._can_pay_hybrid(remaining, list(cost.hybrid), 0, cost.generic):\n92\t                return False\n93\t            return True\n94\t\n95\t        # Then check generic — sum of all remaining mana must cover it.\n96\t        return sum(remaining.values()) >= cost.generic\n97\t\n98\t    def pay(self, cost: ManaCost, choices: dict[ManaType, int] | None = None) -> bool:\n99\t        \"\"\"Deduct mana from the pool to pay *cost*.\n100\t\n101\t        Parameters:\n102\t            cost: The mana cost to pay.\n103\t            choices: How to split the generic portion across mana types.\n104\t                If ``None``, auto-pay greedily: pay colored pips first,\n105\t                then hybrid symbols, then generic using colorless first,\n106\t                then excess colored.\n107\t\n108\t        Returns:\n109\t            True if payment succeeded, False if the pool has insufficient mana.\n110\t        \"\"\"\n111\t        if not self.can_pay(cost):\n112\t            return False\n113\t\n114\t        # Work on a copy so we can roll back on failure.\n115\t        working: dict[ManaType, int] = dict(self._pool)\n116\t\n117\t        # 1. Pay colored/colorless pips.\n118\t        for mana_type, count in cost.pips.items():\n119\t            working[mana_type] -= count\n120\t\n121\t        # 2. When explicit generic choices are provided, reserve that mana\n122\t        #    *before* solving hybrids so the solver doesn't steal it.\n123\t        generic_remaining = cost.generic\n124\t        if generic_remaining > 0 and choices is not None:\n125\t            # Reject negative choice amounts — they would create mana.\n126\t            if any(v < 0 for v in choices.values()):\n127\t                return False\n128\t            # Validate choices sum to generic cost.\n129\t            if sum(choices.values()) != generic_remaining:\n130\t                return False\n131\t            for mana_type, amount in choices.items():\n132\t                if working.get(mana_type, 0) < amount:\n133\t                    return False\n134\t                working[mana_type] -= amount\n135\t\n136\t        # 3. Pay hybrid symbols using backtracking to find a valid assignment.\n137\t        #    Generic choices (if any) have already been reserved above,\n138\t        #    so _solve_hybrid sees only the genuinely available mana.\n139\t        if cost.hybrid:\n140\t            generic_for_solver = generic_remaining if choices is None else 0\n141\t            hybrid_assignment = self._solve_hybrid(\n142\t                working, list(cost.hybrid), 0, generic_for_solver,\n143\t            )\n144\t            if hybrid_assignment is None:\n145\t                return False  # pragma: no cover – should not happen after can_pay\n146\t            for mt in hybrid_assignment:\n147\t                working[mt] = working.get(mt, 0) - 1\n148\t\n149\t        # 4. Pay generic cost (auto-pay path — choices already deducted above).\n150\t        if generic_remaining > 0 and choices is None:\n151\t            generic_remaining = self._auto_pay_generic(working, generic_remaining)\n152\t            if generic_remaining > 0:\n153\t                return False  # pragma: no cover – should not happen after can_pay\n154\t\n155\t        # Commit the payment.\n156\t        # Compute colors of mana spent by comparing old pool to new working pool.\n157\t        colors_spent: set[Color] = set()\n158\t        for mt, old_amount in self._pool.items():\n159\t            new_amount = working.get(mt, 0)\n160\t            if new_amount < old_amount and mt in _MANA_TO_COLOR:\n161\t                colors_spent.add(_MANA_TO_COLOR[mt])\n162\t        self._last_payment_colors = sorted(colors_spent, key=lambda c: c.value)\n163\t        self._pool = working\n164\t        return True\n165\t\n166\t    @staticmethod\n167\t    def _can_pay_hybrid(\n168\t        remaining: dict[ManaType, int],\n169\t        hybrids: list[HybridManaSymbol],\n170\t        idx: int,\n171\t        generic: int,\n172\t    ) -> bool:\n173\t        \"\"\"Recursively check if hybrid symbols + generic can be satisfied.\n174\t\n175\t        Uses backtracking: for each hybrid symbol, try option_a then option_b.\n176\t        After all hybrids are assigned, check that remaining mana covers generic.\n177\t        \"\"\"\n178\t        if idx >= len(hybrids):\n179\t            return sum(remaining.values()) >= generic\n180\t\n181\t        sym = hybrids[idx]\n182\t        for option in (sym.option_a, sym.option_b):\n183\t            if remaining.get(option, 0) > 0:\n184\t                remaining[option] -= 1\n185\t                if ManaPool._can_pay_hybrid(remaining, hybrids, idx + 1, generic):\n186\t                    remaining[option] += 1\n187\t                    return True\n188\t                remaining[option] += 1\n189\t        return False\n190\t\n191\t    @staticmethod\n192\t    def _solve_hybrid(\n193\t        remaining: dict[ManaType, int],\n194\t        hybrids: list[HybridManaSymbol],\n195\t        idx: int,\n196\t        generic: int,\n197\t    ) -> list[ManaType] | None:\n198\t        \"\"\"Find a valid assignment for hybrid symbols.\n199\t\n200\t        Returns a list of ManaType choices (one per hybrid symbol) or None\n201\t        if no valid assignment exists.\n202\t        \"\"\"\n203\t        if idx >= len(hybrids):\n204\t            if sum(remaining.values()) >= generic:\n205\t                return []\n206\t            return None\n207\t\n208\t        sym = hybrids[idx]\n209\t        for option in (sym.option_a, sym.option_b):\n210\t            if remaining.get(option, 0) > 0:\n211\t                remaining[option] -= 1\n212\t                result = ManaPool._solve_hybrid(remaining, hybrids, idx + 1, generic)\n213\t                if result is not None:\n214\t                    remaining[option] += 1\n215\t                    return [option] + result\n216\t                remaining[option] += 1\n217\t        return None\n218\t\n219\t    @staticmethod\n220\t    def _auto_pay_generic(working: dict[ManaType, int], amount: int) -> int:\n221\t        \"\"\"Deduct *amount* generic mana from *working*, preferring colorless.\n222\t\n223\t        Returns the remaining unpaid generic amount (0 on success).\n224\t        \"\"\"\n225\t        # Pay with colorless first.\n226\t        if working.get(ManaType.COLORLESS, 0) > 0:\n227\t            take = min(working[ManaType.COLORLESS], amount)\n228\t            working[ManaType.COLORLESS] -= take\n229\t            amount -= take\n230\t\n231\t        # Then pay with each colored type in enum order.\n232\t        for mt in ManaType:\n233\t            if mt is ManaType.COLORLESS:\n234\t                continue\n235\t            if amount <= 0:\n236\t                break\n237\t            if working.get(mt, 0) > 0:\n238\t                take = min(working[mt], amount)\n239\t                working[mt] -= take\n240\t                amount -= take\n241\t\n242\t        return amount\n243\t\n244\t    # ------------------------------------------------------------------\n245\t    # Dunder helpers\n246\t    # ------------------------------------------------------------------\n247\t\n248\t    def __repr__(self) -> str:\n249\t        non_zero = {mt.name: v for mt, v in self._pool.items() if v > 0}\n250\t        return f\"ManaPool({non_zero})\"\n251\t"}]},"parent_tool_use_id":null,"session_id":"735f529e-7bc8-4328-a211-d2f095818fd0","uuid":"4cd5fb53-ed63-4fae-a6f9-9302e8ff012b","timestamp":"2026-06-04T09:42:39.143Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/mana.py","content":"\"\"\"Mana pool and cost payment logic.\"\"\"\n\nfrom __future__ import annotations\n\nfrom engine.types import Color, HybridManaSymbol, ManaCost, ManaType\n\n# Map colored ManaTypes to their corresponding Color enum values.\n_MANA_TO_COLOR: dict[ManaType, Color] = {\n    ManaType.WHITE: Color.WHITE,\n    ManaType.BLUE: Color.BLUE,\n    ManaType.BLACK: Color.BLACK,\n    ManaType.RED: Color.RED,\n    ManaType.GREEN: Color.GREEN,\n}\n\n\nclass ManaPool:\n    \"\"\"Tracks available mana for a player.\n\n    Internal storage uses a ``dict[ManaType, int]`` mapping each mana type\n    to its current count.\n    \"\"\"\n\n    def __init__(self) -> None:\n        self._pool: dict[ManaType, int] = {mt: 0 for mt in ManaType}\n        self._last_payment_colors: list[Color] = []\n\n    # ------------------------------------------------------------------\n    # Basic operations\n    # ------------------------------------------------------------------\n\n    def add(self, mana_type: ManaType, amount: int = 1) -> None:\n        \"\"\"Add *amount* mana of the given type to the pool.\n\n        Parameters:\n            mana_type: The type of mana to add.\n            amount: How many mana to add (must be non-negative).\n        \"\"\"\n        if amount < 0:\n            raise ValueError(f\"Cannot add negative mana: {amount}\")\n        self._pool[mana_type] = self._pool.get(mana_type, 0) + amount\n\n    def empty(self) -> None:\n        \"\"\"Clear the pool — happens at phase/step transitions.\"\"\"\n        for mt in self._pool:\n            self._pool[mt] = 0\n\n    def total(self) -> int:\n        \"\"\"Return the total amount of mana in the pool across all types.\"\"\"\n        return sum(self._pool.values())\n\n    def get(self, mana_type: ManaType) -> int:\n        \"\"\"Return the amount of a specific mana type in the pool.\"\"\"\n        return self._pool.get(mana_type, 0)\n\n    @property\n    def last_payment_colors(self) -> list[Color]:\n        \"\"\"Return the distinct colors of mana spent in the last :meth:`pay` call.\n\n        Colorless mana is not a color and is excluded.  The list is sorted\n        by Color enum order for determinism.  Empty if no payment has been\n        made or if all mana spent was colorless.\n        \"\"\"\n        return list(self._last_payment_colors)\n\n    # ------------------------------------------------------------------\n    # Cost payment\n    # ------------------------------------------------------------------\n\n    def can_pay(self, cost: ManaCost) -> bool:\n        \"\"\"Check whether the pool can satisfy *cost*.\n\n        Generic mana can be paid by any type.  X is treated as 0 for\n        ``can_pay`` unless explicitly set in the cost's generic component.\n        Hybrid symbols can be paid with either option; this method uses\n        backtracking to find a valid assignment.\n\n        Returns:\n            True if the pool has enough mana to pay the cost.\n        \"\"\"\n        remaining: dict[ManaType, int] = dict(self._pool)\n\n        # Pay colored/colorless pips first.\n        for mana_type, count in cost.pips.items():\n            if remaining.get(mana_type, 0) < count:\n                return False\n            remaining[mana_type] = remaining.get(mana_type, 0) - count\n\n        # Solve hybrid symbols with backtracking.\n        if cost.hybrid:\n            if not self._can_pay_hybrid(remaining, list(cost.hybrid), 0, cost.generic):\n                return False\n            return True\n\n        # Then check generic — sum of all remaining mana must cover it.\n        return sum(remaining.values()) >= cost.generic\n\n    def pay(self, cost: ManaCost, choices: dict[ManaType, int] | None = None) -> bool:\n        \"\"\"Deduct mana from the pool to pay *cost*.\n\n        Parameters:\n            cost: The mana cost to pay.\n            choices: How to split the generic portion across mana types.\n                If ``None``, auto-pay greedily: pay colored pips first,\n                then hybrid symbols, then generic using colorless first,\n                then excess colored.\n\n        Returns:\n            True if payment succeeded, False if the pool has insufficient mana.\n        \"\"\"\n        if not self.can_pay(cost):\n            return False\n\n        # Work on a copy so we can roll back on failure.\n        working: dict[ManaType, int] = dict(self._pool)\n\n        # 1. Pay colored/colorless pips.\n        for mana_type, count in cost.pips.items():\n            working[mana_type] -= count\n\n        # 2. When explicit generic choices are provided, reserve that mana\n        #    *before* solving hybrids so the solver doesn't steal it.\n        generic_remaining = cost.generic\n        if generic_remaining > 0 and choices is not None:\n            # Reject negative choice amounts — they would create mana.\n            if any(v < 0 for v in choices.values()):\n                return False\n            # Validate choices sum to generic cost.\n            if sum(choices.values()) != generic_remaining:\n                return False\n            for mana_type, amount in choices.items():\n                if working.get(mana_type, 0) < amount:\n                    return False\n                working[mana_type] -= amount\n\n        # 3. Pay hybrid symbols using backtracking to find a valid assignment.\n        #    Generic choices (if any) have already been reserved above,\n        #    so _solve_hybrid sees only the genuinely available mana.\n        if cost.hybrid:\n            generic_for_solver = generic_remaining if choices is None else 0\n            hybrid_assignment = self._solve_hybrid(\n                working, list(cost.hybrid), 0, generic_for_solver,\n            )\n            if hybrid_assignment is None:\n                return False  # pragma: no cover – should not happen after can_pay\n            for mt in hybrid_assignment:\n                working[mt] = working.get(mt, 0) - 1\n\n        # 4. Pay generic cost (auto-pay path — choices already deducted above).\n        if generic_remaining > 0 and choices is None:\n            generic_remaining = self._auto_pay_generic(working, generic_remaining)\n            if generic_remaining > 0:\n                return False  # pragma: no cover – should not happen after can_pay\n\n        # Commit the payment.\n        # Compute colors of mana spent by comparing old pool to new working pool.\n        colors_spent: set[Color] = set()\n        for mt, old_amount in self._pool.items():\n            new_amount = working.get(mt, 0)\n            if new_amount < old_amount and mt in _MANA_TO_COLOR:\n                colors_spent.add(_MANA_TO_COLOR[mt])\n        self._last_payment_colors = sorted(colors_spent, key=lambda c: c.value)\n        self._pool = working\n        return True\n\n    @staticmethod\n    def _can_pay_hybrid(\n        remaining: dict[ManaType, int],\n        hybrids: list[HybridManaSymbol],\n        idx: int,\n        generic: int,\n    ) -> bool:\n        \"\"\"Recursively check if hybrid symbols + generic can be satisfied.\n\n        Uses backtracking: for each hybrid symbol, try option_a then option_b.\n        After all hybrids are assigned, check that remaining mana covers generic.\n        \"\"\"\n        if idx >= len(hybrids):\n            return sum(remaining.values()) >= generic\n\n        sym = hybrids[idx]\n        for option in (sym.option_a, sym.option_b):\n            if remaining.get(option, 0) > 0:\n                remaining[option] -= 1\n                if ManaPool._can_pay_hybrid(remaining, hybrids, idx + 1, generic):\n                    remaining[option] += 1\n                    return True\n                remaining[option] += 1\n        return False\n\n    @staticmethod\n    def _solve_hybrid(\n        remaining: dict[ManaType, int],\n        hybrids: list[HybridManaSymbol],\n        idx: int,\n        generic: int,\n    ) -> list[ManaType] | None:\n        \"\"\"Find a valid assignment for hybrid symbols.\n\n        Returns a list of ManaType choices (one per hybrid symbol) or None\n        if no valid assignment exists.\n        \"\"\"\n        if idx >= len(hybrids):\n            if sum(remaining.values()) >= generic:\n                return []\n            return None\n\n        sym = hybrids[idx]\n        for option in (sym.option_a, sym.option_b):\n            if remaining.get(option, 0) > 0:\n                remaining[option] -= 1\n                result = ManaPool._solve_hybrid(remaining, hybrids, idx + 1, generic)\n                if result is not None:\n                    remaining[option] += 1\n                    return [option] + result\n                remaining[option] += 1\n        return None\n\n    @staticmethod\n    def _auto_pay_generic(working: dict[ManaType, int], amount: int) -> int:\n        \"\"\"Deduct *amount* generic mana from *working*, preferring colorless.\n\n        Returns the remaining unpaid generic amount (0 on success).\n        \"\"\"\n        # Pay with colorless first.\n        if working.get(ManaType.COLORLESS, 0) > 0:\n            take = min(working[ManaType.COLORLESS], amount)\n            working[ManaType.COLORLESS] -= take\n            amount -= take\n\n        # Then pay with each colored type in enum order.\n        for mt in ManaType:\n            if mt is ManaType.COLORLESS:\n                continue\n            if amount <= 0:\n                break\n            if working.get(mt, 0) > 0:\n                take = min(working[mt], amount)\n                working[mt] -= take\n                amount -= take\n\n        return amount\n\n    # ------------------------------------------------------------------\n    # Dunder helpers\n    # ------------------------------------------------------------------\n\n    def __repr__(self) -> str:\n        non_zero = {mt.name: v for mt, v in self._pool.items() if v > 0}\n        return f\"ManaPool({non_zero})\"\n","numLines":251,"startLine":1,"totalLines":251}}}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01QfhjbnQN55GNz7PDzWsH7Y","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LQiPdDzv1cCjjyYG4uMhQk","name":"Read","input":{"file_path":"/workspace/engine/abilities.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4099,"cache_read_input_tokens":85531,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4099},"output_tokens":39,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"735f529e-7bc8-4328-a211-d2f095818fd0","uuid":"f84b99fe-c7bd-4a31-8c21-aef32c06f603","request_id":"req_011Cbi14Aob4wQeHNUZfSXns"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LQiPdDzv1cCjjyYG4uMhQk","type":"tool_result","content":"1\t\"\"\"Activated abilities system — tap-for-mana, loyalty abilities, and general\n2\tactivated abilities that go on the stack (or resolve immediately for mana\n3\tabilities).\n4\t\n5\tProvides:\n6\t\n7\t- :func:`activate_ability` — verify timing → pay costs → resolve immediately\n8\t  (mana abilities) or push to the stack (non-mana abilities).\n9\t- :func:`tap_cost` — generic tap-cost helper: checks ``not source.is_tapped``\n10\t  and taps the source.\n11\t- :class:`ActivatedAbilityInstance` — a runtime representation of an activated\n12\t  ability with source, controller, cost/effect callables, and metadata.\n13\t- :class:`LoyaltyAbilityInstance` — activated ability variant for planeswalker\n14\t  loyalty abilities with per-turn restriction and loyalty-counter cost.\n15\t\"\"\"\n16\t\n17\tfrom __future__ import annotations\n18\t\n19\tfrom dataclasses import dataclass, field\n20\tfrom typing import TYPE_CHECKING, Any, Callable\n21\t\n22\tfrom engine.casting import is_sorcery_speed\n23\tfrom engine.stack import StackObject\n24\t\n25\tif TYPE_CHECKING:\n26\t    from engine.game_state import GameState\n27\t    from engine.player import Player\n28\t\n29\t\n30\tclass AbilityError(Exception):\n31\t    \"\"\"Raised when an ability activation is illegal.\"\"\"\n32\t\n33\t\n34\t# ---------------------------------------------------------------------------\n35\t# Runtime ability representations\n36\t# ---------------------------------------------------------------------------\n37\t\n38\t@dataclass\n39\tclass ActivatedAbilityInstance:\n40\t    \"\"\"Runtime representation of an activated ability.\n41\t\n42\t    This captures everything needed to activate and resolve an ability:\n43\t    the source permanent, the controlling player, cost/effect callables,\n44\t    and whether the ability is a mana ability.\n45\t\n46\t    Attributes:\n47\t        source: The permanent that has this ability.\n48\t        controller: The player who controls the source.\n49\t        cost: A callable ``(game, source) -> bool`` that checks and pays\n50\t            the cost. Returns ``True`` if the cost was successfully paid,\n51\t            ``False`` otherwise.\n52\t        effect: A callable ``(game) -> None`` that applies the ability's\n53\t            effect when it resolves.\n54\t        is_mana_ability: Whether this is a mana ability (resolves\n55\t            immediately without using the stack).\n56\t        description: Human-readable description of the ability.\n57\t    \"\"\"\n58\t\n59\t    source: Any\n60\t    controller: Any  # Player\n61\t    cost: Callable[..., bool]\n62\t    effect: Callable[..., None]\n63\t    is_mana_ability: bool = False\n64\t    description: str = \"\"\n65\t\n66\t\n67\t@dataclass\n68\tclass LoyaltyAbilityInstance:\n69\t    \"\"\"Runtime representation of a planeswalker loyalty ability.\n70\t\n71\t    Loyalty abilities are activated abilities with special restrictions:\n72\t    they may only be activated at sorcery speed, and only once per turn\n73\t    per source (tracked via ``_activated_this_turn``).\n74\t\n75\t    The cost adjusts the loyalty counters on the source planeswalker.\n76\t\n77\t    Attributes:\n78\t        source: The planeswalker permanent.\n79\t        controller: The player who controls the planeswalker.\n80\t        loyalty_cost: The loyalty adjustment (positive for ``+N``,\n81\t            negative for ``−N``, zero for ``0``).\n82\t        effect: A callable ``(game) -> None`` for the ability's effect.\n83\t        description: Human-readable description.\n84\t    \"\"\"\n85\t\n86\t    source: Any\n87\t    controller: Any  # Player\n88\t    loyalty_cost: int = 0\n89\t    effect: Callable[..., None] = field(default=lambda _game: None)\n90\t    description: str = \"\"\n91\t\n92\t\n93\t# ---------------------------------------------------------------------------\n94\t# Per-turn loyalty tracking\n95\t# ---------------------------------------------------------------------------\n96\t\n97\t# Set of (object_id, turn_number) pairs that have already activated a\n98\t# loyalty ability this turn.  Callers should call\n99\t# ``clear_loyalty_tracking()`` at the start of each turn or manage the\n100\t# set externally.\n101\t_loyalty_activated_this_turn: set[tuple[int, int]] = set()\n102\t\n103\t\n104\tdef clear_loyalty_tracking() -> None:\n105\t    \"\"\"Clear the loyalty-activated-this-turn tracker.\n106\t\n107\t    Should be called at the start of each turn so that planeswalkers may\n108\t    activate loyalty abilities again.\n109\t    \"\"\"\n110\t    _loyalty_activated_this_turn.clear()\n111\t\n112\t\n113\tdef _has_activated_loyalty_this_turn(source: Any, turn_number: int) -> bool:\n114\t    \"\"\"Return ``True`` if *source* already used a loyalty ability this turn.\"\"\"\n115\t    obj_id = getattr(source, \"object_id\", id(source))\n116\t    return (obj_id, turn_number) in _loyalty_activated_this_turn\n117\t\n118\t\n119\tdef _mark_loyalty_activated(source: Any, turn_number: int) -> None:\n120\t    \"\"\"Record that *source* used a loyalty ability this turn.\"\"\"\n121\t    obj_id = getattr(source, \"object_id\", id(source))\n122\t    _loyalty_activated_this_turn.add((obj_id, turn_number))\n123\t\n124\t\n125\t# ---------------------------------------------------------------------------\n126\t# Tap cost helper\n127\t# ---------------------------------------------------------------------------\n128\t\n129\tdef tap_cost(game: GameState, source: Any) -> bool:\n130\t    \"\"\"Generic tap-cost function.\n131\t\n132\t    Checks that the source is not already tapped.  If untapped, taps it\n133\t    (sets ``source.is_tapped = True``) and returns ``True``.  If already\n134\t    tapped, returns ``False`` (cost cannot be paid).\n135\t\n136\t    Parameters:\n137\t        game: The current game state (unused here but kept for a\n138\t            consistent ``(game, source) -> bool`` cost signature).\n139\t        source: The permanent to tap.\n140\t\n141\t    Returns:\n142\t        ``True`` if the cost was successfully paid (source was untapped\n143\t        and is now tapped), ``False`` otherwise.\n144\t    \"\"\"\n145\t    if getattr(source, \"is_tapped\", False):\n146\t        return False\n147\t    source.is_tapped = True\n148\t    return True\n149\t\n150\t\n151\t# ---------------------------------------------------------------------------\n152\t# Activate ability — main entry point\n153\t# ---------------------------------------------------------------------------\n154\t\n155\tdef activate_ability(\n156\t    game: GameState,\n157\t    player: Any,  # Player\n158\t    ability: ActivatedAbilityInstance | LoyaltyAbilityInstance,\n159\t) -> None:\n160\t    \"\"\"Activate an ability.\n161\t\n162\t    Pipeline\n163\t    --------\n164\t    1. **Timing check** — mana abilities bypass timing entirely and\n165\t       resolve immediately.  Regular (non-mana) activated abilities\n166\t       can be activated whenever a player has priority (instant speed);\n167\t       priority enforcement is handled externally by\n168\t       ``priority_loop``, not here.  **Only loyalty abilities** carry\n169\t       a sorcery-speed restriction.\n170\t    2. **Pay costs** — invoke the ability's cost callable.  For loyalty\n171\t       abilities, adjust loyalty counters and enforce once-per-turn.\n172\t    3. **Resolve or push to stack** — mana abilities resolve\n173\t       immediately; all other abilities are pushed onto the game stack\n174\t       as :class:`StackObject` instances.\n175\t\n176\t    Parameters:\n177\t        game: The current game state.\n178\t        player: The player activating the ability.\n179\t        ability: The ability to activate (an\n180\t            :class:`ActivatedAbilityInstance` or\n181\t            :class:`LoyaltyAbilityInstance`).\n182\t\n183\t    Raises:\n184\t        AbilityError: If the activation is illegal (timing, cost, or\n185\t            once-per-turn restriction).\n186\t    \"\"\"\n187\t    if isinstance(ability, LoyaltyAbilityInstance):\n188\t        _activate_loyalty_ability(game, player, ability)\n189\t    elif isinstance(ability, ActivatedAbilityInstance):\n190\t        _activate_regular_ability(game, player, ability)\n191\t    else:\n192\t        raise AbilityError(f\"Unknown ability type: {type(ability)}\")\n193\t\n194\t\n195\t# ---------------------------------------------------------------------------\n196\t# Internal helpers\n197\t# ---------------------------------------------------------------------------\n198\t\n199\tdef _activate_regular_ability(\n200\t    game: GameState,\n201\t    player: Any,\n202\t    ability: ActivatedAbilityInstance,\n203\t) -> None:\n204\t    \"\"\"Activate a regular (non-loyalty) activated ability.\"\"\"\n205\t    # 1. Check \"can't activate\" restriction (e.g. Arrest).\n206\t    if getattr(ability.source, \"_cant_activate\", False):\n207\t        raise AbilityError(\n208\t            \"Cannot activate ability — source's activated abilities are suppressed\"\n209\t        )\n210\t\n211\t    # 2. Pay costs\n212\t    cost_paid = ability.cost(game, ability.source)\n213\t    if not cost_paid:\n214\t        raise AbilityError(\"Cannot activate ability — cost could not be paid\")\n215\t\n216\t    # 3. Resolve or push\n217\t    if ability.is_mana_ability:\n218\t        # Mana abilities resolve immediately without using the stack.\n219\t        ability.effect(game)\n220\t    else:\n221\t        # Push to stack for resolution.\n222\t        stack_obj = StackObject(\n223\t            source=ability.source,\n224\t            controller=player,\n225\t            on_resolve=ability.effect,\n226\t            is_mana_ability=False,\n227\t        )\n228\t        game.stack.push(stack_obj)\n229\t\n230\t\n231\tdef _activate_loyalty_ability(\n232\t    game: GameState,\n233\t    player: Any,\n234\t    ability: LoyaltyAbilityInstance,\n235\t) -> None:\n236\t    \"\"\"Activate a planeswalker loyalty ability.\"\"\"\n237\t    source = ability.source\n238\t\n239\t    # 1. Timing — loyalty abilities are sorcery speed only.\n240\t    if not is_sorcery_speed(game, player):\n241\t        raise AbilityError(\n242\t            \"Cannot activate loyalty ability — sorcery-speed timing not met\"\n243\t        )\n244\t\n245\t    # 2. Once-per-turn restriction.\n246\t    turn_number = getattr(game, \"turn_number\", 0)\n247\t    if _has_activated_loyalty_this_turn(source, turn_number):\n248\t        raise AbilityError(\n249\t            \"Cannot activate loyalty ability — already activated this turn\"\n250\t        )\n251\t\n252\t    # 3. Pay loyalty cost.\n253\t    current_loyalty = getattr(source, \"loyalty\", 0)\n254\t    new_loyalty = current_loyalty + ability.loyalty_cost\n255\t    if new_loyalty < 0:\n256\t        raise AbilityError(\n257\t            f\"Cannot activate loyalty ability — insufficient loyalty \"\n258\t            f\"(have {current_loyalty}, need {-ability.loyalty_cost})\"\n259\t        )\n260\t    source.loyalty = new_loyalty\n261\t\n262\t    # 4. Mark as activated this turn.\n263\t    _mark_loyalty_activated(source, turn_number)\n264\t\n265\t    # 5. Push to stack.\n266\t    stack_obj = StackObject(\n267\t        source=source,\n268\t        controller=player,\n269\t        on_resolve=ability.effect,\n270\t        is_mana_ability=False,\n271\t    )\n272\t    game.stack.push(stack_obj)\n273\t"}]},"parent_tool_use_id":null,"session_id":"735f529e-7bc8-4328-a211-d2f095818fd0","uuid":"65ec06b4-c3c6-4584-a955-3a7862407654","timestamp":"2026-06-04T09:42:41.884Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/abilities.py","content":"\"\"\"Activated abilities system — tap-for-mana, loyalty abilities, and general\nactivated abilities that go on the stack (or resolve immediately for mana\nabilities).\n\nProvides:\n\n- :func:`activate_ability` — verify timing → pay costs → resolve immediately\n  (mana abilities) or push to the stack (non-mana abilities).\n- :func:`tap_cost` — generic tap-cost helper: checks ``not source.is_tapped``\n  and taps the source.\n- :class:`ActivatedAbilityInstance` — a runtime representation of an activated\n  ability with source, controller, cost/effect callables, and metadata.\n- :class:`LoyaltyAbilityInstance` — activated ability variant for planeswalker\n  loyalty abilities with per-turn restriction and loyalty-counter cost.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom typing import TYPE_CHECKING, Any, Callable\n\nfrom engine.casting import is_sorcery_speed\nfrom engine.stack import StackObject\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\nclass AbilityError(Exception):\n    \"\"\"Raised when an ability activation is illegal.\"\"\"\n\n\n# ---------------------------------------------------------------------------\n# Runtime ability representations\n# ---------------------------------------------------------------------------\n\n@dataclass\nclass ActivatedAbilityInstance:\n    \"\"\"Runtime representation of an activated ability.\n\n    This captures everything needed to activate and resolve an ability:\n    the source permanent, the controlling player, cost/effect callables,\n    and whether the ability is a mana ability.\n\n    Attributes:\n        source: The permanent that has this ability.\n        controller: The player who controls the source.\n        cost: A callable ``(game, source) -> bool`` that checks and pays\n            the cost. Returns ``True`` if the cost was successfully paid,\n            ``False`` otherwise.\n        effect: A callable ``(game) -> None`` that applies the ability's\n            effect when it resolves.\n        is_mana_ability: Whether this is a mana ability (resolves\n            immediately without using the stack).\n        description: Human-readable description of the ability.\n    \"\"\"\n\n    source: Any\n    controller: Any  # Player\n    cost: Callable[..., bool]\n    effect: Callable[..., None]\n    is_mana_ability: bool = False\n    description: str = \"\"\n\n\n@dataclass\nclass LoyaltyAbilityInstance:\n    \"\"\"Runtime representation of a planeswalker loyalty ability.\n\n    Loyalty abilities are activated abilities with special restrictions:\n    they may only be activated at sorcery speed, and only once per turn\n    per source (tracked via ``_activated_this_turn``).\n\n    The cost adjusts the loyalty counters on the source planeswalker.\n\n    Attributes:\n        source: The planeswalker permanent.\n        controller: The player who controls the planeswalker.\n        loyalty_cost: The loyalty adjustment (positive for ``+N``,\n            negative for ``−N``, zero for ``0``).\n        effect: A callable ``(game) -> None`` for the ability's effect.\n        description: Human-readable description.\n    \"\"\"\n\n    source: Any\n    controller: Any  # Player\n    loyalty_cost: int = 0\n    effect: Callable[..., None] = field(default=lambda _game: None)\n    description: str = \"\"\n\n\n# ---------------------------------------------------------------------------\n# Per-turn loyalty tracking\n# ---------------------------------------------------------------------------\n\n# Set of (object_id, turn_number) pairs that have already activated a\n# loyalty ability this turn.  Callers should call\n# ``clear_loyalty_tracking()`` at the start of each turn or manage the\n# set externally.\n_loyalty_activated_this_turn: set[tuple[int, int]] = set()\n\n\ndef clear_loyalty_tracking() -> None:\n    \"\"\"Clear the loyalty-activated-this-turn tracker.\n\n    Should be called at the start of each turn so that planeswalkers may\n    activate loyalty abilities again.\n    \"\"\"\n    _loyalty_activated_this_turn.clear()\n\n\ndef _has_activated_loyalty_this_turn(source: Any, turn_number: int) -> bool:\n    \"\"\"Return ``True`` if *source* already used a loyalty ability this turn.\"\"\"\n    obj_id = getattr(source, \"object_id\", id(source))\n    return (obj_id, turn_number) in _loyalty_activated_this_turn\n\n\ndef _mark_loyalty_activated(source: Any, turn_number: int) -> None:\n    \"\"\"Record that *source* used a loyalty ability this turn.\"\"\"\n    obj_id = getattr(source, \"object_id\", id(source))\n    _loyalty_activated_this_turn.add((obj_id, turn_number))\n\n\n# ---------------------------------------------------------------------------\n# Tap cost helper\n# ---------------------------------------------------------------------------\n\ndef tap_cost(game: GameState, source: Any) -> bool:\n    \"\"\"Generic tap-cost function.\n\n    Checks that the source is not already tapped.  If untapped, taps it\n    (sets ``source.is_tapped = True``) and returns ``True``.  If already\n    tapped, returns ``False`` (cost cannot be paid).\n\n    Parameters:\n        game: The current game state (unused here but kept for a\n            consistent ``(game, source) -> bool`` cost signature).\n        source: The permanent to tap.\n\n    Returns:\n        ``True`` if the cost was successfully paid (source was untapped\n        and is now tapped), ``False`` otherwise.\n    \"\"\"\n    if getattr(source, \"is_tapped\", False):\n        return False\n    source.is_tapped = True\n    return True\n\n\n# ---------------------------------------------------------------------------\n# Activate ability — main entry point\n# ---------------------------------------------------------------------------\n\ndef activate_ability(\n    game: GameState,\n    player: Any,  # Player\n    ability: ActivatedAbilityInstance | LoyaltyAbilityInstance,\n) -> None:\n    \"\"\"Activate an ability.\n\n    Pipeline\n    --------\n    1. **Timing check** — mana abilities bypass timing entirely and\n       resolve immediately.  Regular (non-mana) activated abilities\n       can be activated whenever a player has priority (instant speed);\n       priority enforcement is handled externally by\n       ``priority_loop``, not here.  **Only loyalty abilities** carry\n       a sorcery-speed restriction.\n    2. **Pay costs** — invoke the ability's cost callable.  For loyalty\n       abilities, adjust loyalty counters and enforce once-per-turn.\n    3. **Resolve or push to stack** — mana abilities resolve\n       immediately; all other abilities are pushed onto the game stack\n       as :class:`StackObject` instances.\n\n    Parameters:\n        game: The current game state.\n        player: The player activating the ability.\n        ability: The ability to activate (an\n            :class:`ActivatedAbilityInstance` or\n            :class:`LoyaltyAbilityInstance`).\n\n    Raises:\n        AbilityError: If the activation is illegal (timing, cost, or\n            once-per-turn restriction).\n    \"\"\"\n    if isinstance(ability, LoyaltyAbilityInstance):\n        _activate_loyalty_ability(game, player, ability)\n    elif isinstance(ability, ActivatedAbilityInstance):\n        _activate_regular_ability(game, player, ability)\n    else:\n        raise AbilityError(f\"Unknown ability type: {type(ability)}\")\n\n\n# ---------------------------------------------------------------------------\n# Internal helpers\n# ---------------------------------------------------------------------------\n\ndef _activate_regular_ability(\n    game: GameState,\n    player: Any,\n    ability: ActivatedAbilityInstance,\n) -> None:\n    \"\"\"Activate a regular (non-loyalty) activated ability.\"\"\"\n    # 1. Check \"can't activate\" restriction (e.g. Arrest).\n    if getattr(ability.source, \"_cant_activate\", False):\n        raise AbilityError(\n            \"Cannot activate ability — source's activated abilities are suppressed\"\n        )\n\n    # 2. Pay costs\n    cost_paid = ability.cost(game, ability.source)\n    if not cost_paid:\n        raise AbilityError(\"Cannot activate ability — cost could not be paid\")\n\n    # 3. Resolve or push\n    if ability.is_mana_ability:\n        # Mana abilities resolve immediately without using the stack.\n        ability.effect(game)\n    else:\n        # Push to stack for resolution.\n        stack_obj = StackObject(\n            source=ability.source,\n            controller=player,\n            on_resolve=ability.effect,\n            is_mana_ability=False,\n        )\n        game.stack.push(stack_obj)\n\n\ndef _activate_loyalty_ability(\n    game: GameState,\n    player: Any,\n    ability: LoyaltyAbilityInstance,\n) -> None:\n    \"\"\"Activate a planeswalker loyalty ability.\"\"\"\n    source = ability.source\n\n    # 1. Timing — loyalty abilities are sorcery speed only.\n    if not is_sorcery_speed(game, player):\n        raise AbilityError(\n            \"Cannot activate loyalty ability — sorcery-speed timing not met\"\n        )\n\n    # 2. Once-per-turn restriction.\n    turn_number = getattr(game, \"turn_number\", 0)\n    if _has_activated_loyalty_this_turn(source, turn_number):\n        raise AbilityError(\n            \"Cannot activate loyalty ability — already activated this turn\"\n        )\n\n    # 3. Pay loyalty cost.\n    current_loyalty = getattr(source, \"loyalty\", 0)\n    new_loyalty = current_loyalty + ability.loyalty_cost\n    if new_loyalty < 0:\n        raise AbilityError(\n            f\"Cannot activate loyalty ability — insufficient loyalty \"\n            f\"(have {current_loyalty}, need {-ability.loyalty_cost})\"\n        )\n    source.loyalty = new_loyalty\n\n    # 4. Mark as activated this turn.\n    _mark_loyalty_activated(source, turn_number)\n\n    # 5. Push to stack.\n    stack_obj = StackObject(\n        source=source,\n        controller=player,\n        on_resolve=ability.effect,\n        is_mana_ability=False,\n    )\n    game.stack.push(stack_obj)\n","numLines":273,"startLine":1,"totalLines":273}}}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_0139jx3gFzoxWVyWDizxXgo6","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_016AayatF6DyXBZ3Aw2UTR94","name":"Read","input":{"file_path":"/workspace/engine/continuous_effects.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4150,"cache_read_input_tokens":89630,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4150},"output_tokens":44,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"735f529e-7bc8-4328-a211-d2f095818fd0","uuid":"f8dd3584-97d2-4b62-b4fa-3d5f268210cd","request_id":"req_011Cbi14NCSKWz2q96czUDj9"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016AayatF6DyXBZ3Aw2UTR94","type":"tool_result","content":"1\t\"\"\"Continuous effects and the 7-layer system.\n2\t\n3\tImplements the MTG layer system (rule 613) for applying continuous effects\n4\tin the correct order. Effects are applied in layer order, and within the\n5\tsame layer/sublayer, in timestamp order.\n6\t\n7\tPhase 1 scope:\n8\t  - Layers 4 (type-changing), 6 (ability granting/removing), 7c (P/T\n9\t    modifications), and 7d (P/T from counters) are fully functional.\n10\t  - Layers 1 (copy), 2 (control), 3 (text), and 5 (color) are stubs\n11\t    that iterate effects but delegate to their ``apply`` callables.\n12\t\"\"\"\n13\t\n14\tfrom __future__ import annotations\n15\t\n16\timport enum\n17\tfrom dataclasses import dataclass, field\n18\tfrom typing import TYPE_CHECKING, Any, Callable\n19\t\n20\tif TYPE_CHECKING:\n21\t    from engine.game_state import GameState\n22\t\n23\t\n24\tclass Layer(enum.IntEnum):\n25\t    \"\"\"The 7 layers for applying continuous effects (rule 613).\n26\t\n27\t    Using IntEnum so that effects are naturally sorted by layer order.\n28\t    \"\"\"\n29\t\n30\t    COPY = 1\n31\t    CONTROL = 2\n32\t    TEXT = 3\n33\t    TYPE = 4\n34\t    COLOR = 5\n35\t    ABILITY = 6\n36\t    POWER_TOUGHNESS = 7\n37\t\n38\t\n39\tclass SubLayer(enum.Enum):\n40\t    \"\"\"Sub-layers for layer 7 (power/toughness) effects.\n41\t\n42\t    Per rule 613.4:\n43\t      - 7a: Characteristic-defining abilities that set P/T.\n44\t      - 7b: Effects that set P/T to specific values.\n45\t      - 7c: Effects that modify P/T (e.g. +2/+2).\n46\t      - 7d: P/T changes from counters.\n47\t    \"\"\"\n48\t\n49\t    CHARACTERISTIC_DEFINING = \"7a\"\n50\t    SET_PT = \"7b\"\n51\t    MODIFY_PT = \"7c\"\n52\t    COUNTERS = \"7d\"\n53\t\n54\t\n55\t# Duration constants — sentinels for ContinuousEffect.duration.\n56\tDURATION_PERMANENT = -1\n57\t\"\"\"The effect lasts as long as its source is on the battlefield.\"\"\"\n58\t\n59\tDURATION_END_OF_TURN = 0\n60\t\"\"\"The effect lasts until end of turn (removed during cleanup).\"\"\"\n61\t\n62\t\n63\t@dataclass\n64\tclass ContinuousEffect:\n65\t    \"\"\"A single continuous effect in the layer system.\n66\t\n67\t    Attributes:\n68\t        source: The game object that creates this effect.\n69\t        layer: Which of the 7 layers this effect belongs to.\n70\t        sublayer: Sub-layer within layer 7 (``None`` for layers 1–6).\n71\t        apply: Callable ``(game: GameState) -> None`` that applies the effect.\n72\t        timestamp: Monotonically increasing integer for ordering effects\n73\t            within the same layer. Lower timestamp means earlier.\n74\t        duration: How long the effect lasts.  Use :data:`DURATION_PERMANENT`\n75\t            for static abilities, :data:`DURATION_END_OF_TURN` for until-EOT\n76\t            effects, or a positive integer representing the turn number\n77\t            on which the effect expires (removed when\n78\t            ``game.turn_number > duration``).\n79\t    \"\"\"\n80\t\n81\t    source: Any\n82\t    layer: Layer\n83\t    sublayer: SubLayer | None = None\n84\t    apply: Callable[..., Any] = field(default=lambda _game: None)\n85\t    timestamp: int = 0\n86\t    duration: int = DURATION_PERMANENT\n87\t\n88\t    def _sort_key(self) -> tuple[int, int, int]:\n89\t        \"\"\"Return a sort key: (layer, sublayer-ordinal, timestamp).\n90\t\n91\t        Effects are sorted first by layer, then by sublayer (for layer 7),\n92\t        then by timestamp within the same (layer, sublayer).\n93\t        \"\"\"\n94\t        sublayer_order = _SUBLAYER_ORDER.get(self.sublayer, 0) if self.sublayer else 0\n95\t        return (self.layer.value, sublayer_order, self.timestamp)\n96\t\n97\t\n98\t# Map SubLayer values to a numeric ordering so 7a < 7b < 7c < 7d.\n99\t_SUBLAYER_ORDER: dict[SubLayer, int] = {\n100\t    SubLayer.CHARACTERISTIC_DEFINING: 1,\n101\t    SubLayer.SET_PT: 2,\n102\t    SubLayer.MODIFY_PT: 3,\n103\t    SubLayer.COUNTERS: 4,\n104\t}\n105\t\n106\t\n107\tclass EffectManager:\n108\t    \"\"\"Manages all active continuous effects and applies them in layer order.\n109\t\n110\t    The manager holds a list of :class:`ContinuousEffect` objects and provides\n111\t    methods to add, remove expired effects, and apply them all to the game\n112\t    state in the correct layer/timestamp order.\n113\t    \"\"\"\n114\t\n115\t    def __init__(self) -> None:\n116\t        self._effects: list[ContinuousEffect] = []\n117\t        self._next_timestamp: int = 1\n118\t\n119\t    # ------------------------------------------------------------------\n120\t    # Public API\n121\t    # ------------------------------------------------------------------\n122\t\n123\t    def add(self, effect: ContinuousEffect) -> ContinuousEffect:\n124\t        \"\"\"Add a continuous effect, auto-assigning a timestamp if it's 0.\n125\t\n126\t        Args:\n127\t            effect: The effect to register.\n128\t\n129\t        Returns:\n130\t            The effect (with timestamp populated).\n131\t        \"\"\"\n132\t        if effect.timestamp == 0:\n133\t            effect.timestamp = self._next_timestamp\n134\t            self._next_timestamp += 1\n135\t        else:\n136\t            # Keep _next_timestamp ahead of any manually assigned timestamps.\n137\t            if effect.timestamp >= self._next_timestamp:\n138\t                self._next_timestamp = effect.timestamp + 1\n139\t        self._effects.append(effect)\n140\t        return effect\n141\t\n142\t    def remove(self, effect: ContinuousEffect) -> bool:\n143\t        \"\"\"Remove a specific effect by identity.\n144\t\n145\t        Returns:\n146\t            ``True`` if the effect was found and removed, ``False`` otherwise.\n147\t        \"\"\"\n148\t        for i, e in enumerate(self._effects):\n149\t            if e is effect:\n150\t                self._effects.pop(i)\n151\t                return True\n152\t        return False\n153\t\n154\t    def remove_expired(self, game: GameState) -> int:\n155\t        \"\"\"Remove effects whose duration has expired.\n156\t\n157\t        - ``DURATION_PERMANENT`` (−1): never expires automatically.\n158\t        - ``DURATION_END_OF_TURN`` (0): removed when this method is called\n159\t          (typically during the cleanup step).\n160\t        - Positive integer *n*: removed when ``game.turn_number > n``.\n161\t\n162\t        Args:\n163\t            game: The current game state (used for turn number).\n164\t\n165\t        Returns:\n166\t            The number of effects removed.\n167\t        \"\"\"\n168\t        before = len(self._effects)\n169\t        remaining: list[ContinuousEffect] = []\n170\t        for eff in self._effects:\n171\t            if eff.duration == DURATION_PERMANENT:\n172\t                remaining.append(eff)\n173\t            elif eff.duration == DURATION_END_OF_TURN:\n174\t                # End-of-turn effects are swept away.\n175\t                continue\n176\t            elif game.turn_number > eff.duration:\n177\t                # Turn-numbered expiry.\n178\t                continue\n179\t            else:\n180\t                remaining.append(eff)\n181\t        self._effects = remaining\n182\t        return before - len(self._effects)\n183\t\n184\t    def apply_all(self, game: GameState) -> None:\n185\t        \"\"\"Apply all active effects in layer order, then timestamp order.\n186\t\n187\t        Before applying, all objects on each player's battlefield are reset\n188\t        to their original (pre-effect) characteristics so that calling this\n189\t        method multiple times is idempotent.\n190\t\n191\t        Within each layer (and sublayer for layer 7), effects are applied\n192\t        in timestamp order.  This method should be called whenever the\n193\t        game state needs a fresh recalculation of continuous effects —\n194\t        for example, after state-based actions or any game event that\n195\t        could change the set of applicable effects.\n196\t        \"\"\"\n197\t        # Reset battlefield objects to their base characteristics so that\n198\t        # reapplying effects does not accumulate on top of stale mutations.\n199\t        self._reset_objects(game)\n200\t\n201\t        sorted_effects = sorted(self._effects, key=lambda e: e._sort_key())\n202\t        for effect in sorted_effects:\n203\t            effect.apply(game)\n204\t\n205\t    # ------------------------------------------------------------------\n206\t    # Internal helpers\n207\t    # ------------------------------------------------------------------\n208\t\n209\t    def _reset_objects(self, game: GameState) -> None:\n210\t        \"\"\"Reset all battlefield objects to their original characteristics.\n211\t\n212\t        Iterates over every player's battlefield and calls\n213\t        ``_reset_characteristics()`` on any object that supports it\n214\t        (i.e. :class:`~engine.card.CardImpl` and its subclasses).\n215\t        \"\"\"\n216\t        for player in game.players:\n217\t            for obj in game.get_battlefield(player).get_all():\n218\t                reset = getattr(obj, \"_reset_characteristics\", None)\n219\t                if callable(reset):\n220\t                    reset()\n221\t\n222\t    # ------------------------------------------------------------------\n223\t    # Query helpers\n224\t    # ------------------------------------------------------------------\n225\t\n226\t    @property\n227\t    def effects(self) -> list[ContinuousEffect]:\n228\t        \"\"\"Return a shallow copy of the current effects list.\"\"\"\n229\t        return list(self._effects)\n230\t\n231\t    def get_all(self) -> list[ContinuousEffect]:\n232\t        \"\"\"Return a shallow copy of the current effects list.\"\"\"\n233\t        return list(self._effects)\n234\t\n235\t    def get_effects_for_layer(self, layer: Layer) -> list[ContinuousEffect]:\n236\t        \"\"\"Return effects belonging to a specific layer, in timestamp order.\"\"\"\n237\t        return sorted(\n238\t            [e for e in self._effects if e.layer == layer],\n239\t            key=lambda e: e._sort_key(),\n240\t        )\n241\t\n242\t    def get_effects_by_source(self, source: Any) -> list[ContinuousEffect]:\n243\t        \"\"\"Return all effects created by a given source object.\"\"\"\n244\t        return [e for e in self._effects if e.source is source]\n245\t\n246\t    def clear(self) -> None:\n247\t        \"\"\"Remove all effects.\"\"\"\n248\t        self._effects.clear()\n249\t\n250\t    def __len__(self) -> int:\n251\t        return len(self._effects)\n252\t"}]},"parent_tool_use_id":null,"session_id":"735f529e-7bc8-4328-a211-d2f095818fd0","uuid":"9ce629b8-12aa-470c-b3e7-e9101789dd14","timestamp":"2026-06-04T09:42:46.676Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/continuous_effects.py","content":"\"\"\"Continuous effects and the 7-layer system.\n\nImplements the MTG layer system (rule 613) for applying continuous effects\nin the correct order. Effects are applied in layer order, and within the\nsame layer/sublayer, in timestamp order.\n\nPhase 1 scope:\n  - Layers 4 (type-changing), 6 (ability granting/removing), 7c (P/T\n    modifications), and 7d (P/T from counters) are fully functional.\n  - Layers 1 (copy), 2 (control), 3 (text), and 5 (color) are stubs\n    that iterate effects but delegate to their ``apply`` callables.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport enum\nfrom dataclasses import dataclass, field\nfrom typing import TYPE_CHECKING, Any, Callable\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\nclass Layer(enum.IntEnum):\n    \"\"\"The 7 layers for applying continuous effects (rule 613).\n\n    Using IntEnum so that effects are naturally sorted by layer order.\n    \"\"\"\n\n    COPY = 1\n    CONTROL = 2\n    TEXT = 3\n    TYPE = 4\n    COLOR = 5\n    ABILITY = 6\n    POWER_TOUGHNESS = 7\n\n\nclass SubLayer(enum.Enum):\n    \"\"\"Sub-layers for layer 7 (power/toughness) effects.\n\n    Per rule 613.4:\n      - 7a: Characteristic-defining abilities that set P/T.\n      - 7b: Effects that set P/T to specific values.\n      - 7c: Effects that modify P/T (e.g. +2/+2).\n      - 7d: P/T changes from counters.\n    \"\"\"\n\n    CHARACTERISTIC_DEFINING = \"7a\"\n    SET_PT = \"7b\"\n    MODIFY_PT = \"7c\"\n    COUNTERS = \"7d\"\n\n\n# Duration constants — sentinels for ContinuousEffect.duration.\nDURATION_PERMANENT = -1\n\"\"\"The effect lasts as long as its source is on the battlefield.\"\"\"\n\nDURATION_END_OF_TURN = 0\n\"\"\"The effect lasts until end of turn (removed during cleanup).\"\"\"\n\n\n@dataclass\nclass ContinuousEffect:\n    \"\"\"A single continuous effect in the layer system.\n\n    Attributes:\n        source: The game object that creates this effect.\n        layer: Which of the 7 layers this effect belongs to.\n        sublayer: Sub-layer within layer 7 (``None`` for layers 1–6).\n        apply: Callable ``(game: GameState) -> None`` that applies the effect.\n        timestamp: Monotonically increasing integer for ordering effects\n            within the same layer. Lower timestamp means earlier.\n        duration: How long the effect lasts.  Use :data:`DURATION_PERMANENT`\n            for static abilities, :data:`DURATION_END_OF_TURN` for until-EOT\n            effects, or a positive integer representing the turn number\n            on which the effect expires (removed when\n            ``game.turn_number > duration``).\n    \"\"\"\n\n    source: Any\n    layer: Layer\n    sublayer: SubLayer | None = None\n    apply: Callable[..., Any] = field(default=lambda _game: None)\n    timestamp: int = 0\n    duration: int = DURATION_PERMANENT\n\n    def _sort_key(self) -> tuple[int, int, int]:\n        \"\"\"Return a sort key: (layer, sublayer-ordinal, timestamp).\n\n        Effects are sorted first by layer, then by sublayer (for layer 7),\n        then by timestamp within the same (layer, sublayer).\n        \"\"\"\n        sublayer_order = _SUBLAYER_ORDER.get(self.sublayer, 0) if self.sublayer else 0\n        return (self.layer.value, sublayer_order, self.timestamp)\n\n\n# Map SubLayer values to a numeric ordering so 7a < 7b < 7c < 7d.\n_SUBLAYER_ORDER: dict[SubLayer, int] = {\n    SubLayer.CHARACTERISTIC_DEFINING: 1,\n    SubLayer.SET_PT: 2,\n    SubLayer.MODIFY_PT: 3,\n    SubLayer.COUNTERS: 4,\n}\n\n\nclass EffectManager:\n    \"\"\"Manages all active continuous effects and applies them in layer order.\n\n    The manager holds a list of :class:`ContinuousEffect` objects and provides\n    methods to add, remove expired effects, and apply them all to the game\n    state in the correct layer/timestamp order.\n    \"\"\"\n\n    def __init__(self) -> None:\n        self._effects: list[ContinuousEffect] = []\n        self._next_timestamp: int = 1\n\n    # ------------------------------------------------------------------\n    # Public API\n    # ------------------------------------------------------------------\n\n    def add(self, effect: ContinuousEffect) -> ContinuousEffect:\n        \"\"\"Add a continuous effect, auto-assigning a timestamp if it's 0.\n\n        Args:\n            effect: The effect to register.\n\n        Returns:\n            The effect (with timestamp populated).\n        \"\"\"\n        if effect.timestamp == 0:\n            effect.timestamp = self._next_timestamp\n            self._next_timestamp += 1\n        else:\n            # Keep _next_timestamp ahead of any manually assigned timestamps.\n            if effect.timestamp >= self._next_timestamp:\n                self._next_timestamp = effect.timestamp + 1\n        self._effects.append(effect)\n        return effect\n\n    def remove(self, effect: ContinuousEffect) -> bool:\n        \"\"\"Remove a specific effect by identity.\n\n        Returns:\n            ``True`` if the effect was found and removed, ``False`` otherwise.\n        \"\"\"\n        for i, e in enumerate(self._effects):\n            if e is effect:\n                self._effects.pop(i)\n                return True\n        return False\n\n    def remove_expired(self, game: GameState) -> int:\n        \"\"\"Remove effects whose duration has expired.\n\n        - ``DURATION_PERMANENT`` (−1): never expires automatically.\n        - ``DURATION_END_OF_TURN`` (0): removed when this method is called\n          (typically during the cleanup step).\n        - Positive integer *n*: removed when ``game.turn_number > n``.\n\n        Args:\n            game: The current game state (used for turn number).\n\n        Returns:\n            The number of effects removed.\n        \"\"\"\n        before = len(self._effects)\n        remaining: list[ContinuousEffect] = []\n        for eff in self._effects:\n            if eff.duration == DURATION_PERMANENT:\n                remaining.append(eff)\n            elif eff.duration == DURATION_END_OF_TURN:\n                # End-of-turn effects are swept away.\n                continue\n            elif game.turn_number > eff.duration:\n                # Turn-numbered expiry.\n                continue\n            else:\n                remaining.append(eff)\n        self._effects = remaining\n        return before - len(self._effects)\n\n    def apply_all(self, game: GameState) -> None:\n        \"\"\"Apply all active effects in layer order, then timestamp order.\n\n        Before applying, all objects on each player's battlefield are reset\n        to their original (pre-effect) characteristics so that calling this\n        method multiple times is idempotent.\n\n        Within each layer (and sublayer for layer 7), effects are applied\n        in timestamp order.  This method should be called whenever the\n        game state needs a fresh recalculation of continuous effects —\n        for example, after state-based actions or any game event that\n        could change the set of applicable effects.\n        \"\"\"\n        # Reset battlefield objects to their base characteristics so that\n        # reapplying effects does not accumulate on top of stale mutations.\n        self._reset_objects(game)\n\n        sorted_effects = sorted(self._effects, key=lambda e: e._sort_key())\n        for effect in sorted_effects:\n            effect.apply(game)\n\n    # ------------------------------------------------------------------\n    # Internal helpers\n    # ------------------------------------------------------------------\n\n    def _reset_objects(self, game: GameState) -> None:\n        \"\"\"Reset all battlefield objects to their original characteristics.\n\n        Iterates over every player's battlefield and calls\n        ``_reset_characteristics()`` on any object that supports it\n        (i.e. :class:`~engine.card.CardImpl` and its subclasses).\n        \"\"\"\n        for player in game.players:\n            for obj in game.get_battlefield(player).get_all():\n                reset = getattr(obj, \"_reset_characteristics\", None)\n                if callable(reset):\n                    reset()\n\n    # ------------------------------------------------------------------\n    # Query helpers\n    # ------------------------------------------------------------------\n\n    @property\n    def effects(self) -> list[ContinuousEffect]:\n        \"\"\"Return a shallow copy of the current effects list.\"\"\"\n        return list(self._effects)\n\n    def get_all(self) -> list[ContinuousEffect]:\n        \"\"\"Return a shallow copy of the current effects list.\"\"\"\n        return list(self._effects)\n\n    def get_effects_for_layer(self, layer: Layer) -> list[ContinuousEffect]:\n        \"\"\"Return effects belonging to a specific layer, in timestamp order.\"\"\"\n        return sorted(\n            [e for e in self._effects if e.layer == layer],\n            key=lambda e: e._sort_key(),\n        )\n\n    def get_effects_by_source(self, source: Any) -> list[ContinuousEffect]:\n        \"\"\"Return all effects created by a given source object.\"\"\"\n        return [e for e in self._effects if e.source is source]\n\n    def clear(self) -> None:\n        \"\"\"Remove all effects.\"\"\"\n        self._effects.clear()\n\n    def __len__(self) -> int:\n        return len(self._effects)\n","numLines":252,"startLine":1,"totalLines":252}}}
