{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01H65td3rppKEJxYkVsLscnU","type":"tool_result","content":"1\t\"\"\"Test utility helpers for engine validation and benchmark agents.\n2\t\n3\tProvides convenience functions for setting up game states, casting spells,\n4\tadvancing phases, and managing combat in tests.  Each function raises\n5\tdescriptive errors on failure.\n6\t\n7\tFunctions:\n8\t    create_game — convenience wrapper to create a GameState from card lists.\n9\t    set_board_state — directly set zone contents and player state.\n10\t    cast_spell — find card in hand by name, cast, and resolve.\n11\t    advance_to_phase — fast-forward game state to a given phase/step.\n12\t    declare_attackers — advance to combat and declare attackers by name.\n13\t    declare_blockers — assign blockers by name mapping.\n14\t\"\"\"\n15\t\n16\tfrom __future__ import annotations\n17\t\n18\tfrom typing import Any\n19\t\n20\tfrom engine.card import CardImpl, Creature\n21\tfrom engine.casting import cast_spell as _engine_cast_spell\n22\tfrom engine.combat import (\n23\t    CombatState,\n24\t    declare_attackers_step,\n25\t    declare_blockers_step,\n26\t)\n27\tfrom engine.game import create_game as _engine_create_game\n28\tfrom engine.game_state import GameState, _TURN_SEQUENCE\n29\tfrom engine.mana import ManaPool\n30\tfrom engine.player import DeterministicPlayer\n31\tfrom engine.stack import priority_loop\n32\tfrom engine.types import ManaType, Phase, Step, Zone\n33\t\n34\t\n35\tclass TestSetupError(Exception):\n36\t    \"\"\"Raised when a test utility function encounters an invalid setup.\"\"\"\n37\t\n38\t\n39\tdef card_colors(card: Any) -> set[str]:\n40\t    \"\"\"Return a card's colors as single-letter strings, derived from its mana cost.\n41\t\n42\t    Hybrid pips contribute both options. {C} and {X} contribute nothing.\n43\t    Returns an empty set for cards with no mana cost or only colorless/X pips.\n44\t    Used by audited tests that previously asserted against a non-existent\n45\t    ``card.colors`` attribute.\n46\t    \"\"\"\n47\t    colors: set[str] = set()\n48\t    cost = getattr(card, \"mana_cost\", None)\n49\t    if cost is None:\n50\t        return colors\n51\t    for mt in getattr(cost, \"pips\", {}):\n52\t        if mt != ManaType.COLORLESS:\n53\t            colors.add(mt.value)\n54\t    for hybrid in getattr(cost, \"hybrid\", []):\n55\t        if hybrid.option_a != ManaType.COLORLESS:\n56\t            colors.add(hybrid.option_a.value)\n57\t        if hybrid.option_b != ManaType.COLORLESS:\n58\t            colors.add(hybrid.option_b.value)\n59\t    return colors\n60\t\n61\t\n62\t# ---------------------------------------------------------------------------\n63\t# create_game\n64\t# ---------------------------------------------------------------------------\n65\t\n66\t\n67\tdef create_game(\n68\t    deck1: list[CardImpl] | None = None,\n69\t    deck2: list[CardImpl] | None = None,\n70\t    *,\n71\t    player1_name: str = \"Player1\",\n72\t    player2_name: str = \"Player2\",\n73\t    player1_life: int = 20,\n74\t    player2_life: int = 20,\n75\t    scripts: tuple[list[Any], list[Any]] | None = None,\n76\t) -> GameState:\n77\t    \"\"\"Create a new two-player game from card lists.\n78\t\n79\t    This is a convenience wrapper around :func:`engine.game.create_game`\n80\t    that automatically creates :class:`DeterministicPlayer` instances.\n81\t\n82\t    Parameters:\n83\t        deck1: Cards for player 1's deck.  Defaults to empty list.\n84\t        deck2: Cards for player 2's deck.  Defaults to empty list.\n85\t        player1_name: Display name for player 1.\n86\t        player2_name: Display name for player 2.\n87\t        player1_life: Starting life for player 1.\n88\t        player2_life: Starting life for player 2.\n89\t        scripts: Optional tuple of ``(script1, script2)`` for\n90\t            :class:`DeterministicPlayer`.  Defaults to empty lists.\n91\t\n92\t    Returns:\n93\t        A fully initialised :class:`GameState`.\n94\t\n95\t    Raises:\n96\t        TestSetupError: If the inputs are invalid.\n97\t    \"\"\"\n98\t    if deck1 is None:\n99\t        deck1 = []\n100\t    if deck2 is None:\n101\t        deck2 = []\n102\t\n103\t    script1: list[Any] = []\n104\t    script2: list[Any] = []\n105\t    if scripts is not None:\n106\t        script1, script2 = scripts\n107\t\n108\t    p1 = DeterministicPlayer(player1_name, script=script1, life=player1_life)\n109\t    p2 = DeterministicPlayer(player2_name, script=script2, life=player2_life)\n110\t\n111\t    game = _engine_create_game(p1, p2, deck1, deck2)\n112\t\n113\t    # When decks are empty (the convenience default), engine.game.create_game\n114\t    # attempts to draw 7 cards from each empty library, which sets the\n115\t    # drawn_from_empty_library loss flag.  Reset it for the convenience case.\n116\t    for player in game.players:\n117\t        if player.drawn_from_empty_library:\n118\t            player.drawn_from_empty_library = False\n119\t\n120\t    # engine.game.create_game hardcodes life=20; restore custom values.\n121\t    if player1_life != 20:\n122\t        game.players[0].life = player1_life\n123\t    if player2_life != 20:\n124\t        game.players[1].life = player2_life\n125\t\n126\t    return game\n127\t\n128\t\n129\t# ---------------------------------------------------------------------------\n130\t# set_board_state\n131\t# ---------------------------------------------------------------------------\n132\t\n133\t\n134\tdef set_board_state(\n135\t    game: GameState,\n136\t    player_index: int,\n137\t    *,\n138\t    battlefield: list[Any] | None = None,\n139\t    hand: list[Any] | None = None,\n140\t    graveyard: list[Any] | None = None,\n141\t    life: int | None = None,\n142\t    mana: dict[ManaType, int] | None = None,\n143\t) -> None:\n144\t    \"\"\"Directly set zone contents and player state for test setup.\n145\t\n146\t    Replaces the contents of the specified zones (only zones that are\n147\t    explicitly provided are modified — others are left unchanged).\n148\t\n149\t    For each card placed into a zone, ``owner`` and ``controller`` are\n150\t    set to the target player.\n151\t\n152\t    Parameters:\n153\t        game: The game state to modify.\n154\t        player_index: Index of the player (0 or 1).\n155\t        battlefield: Cards/permanents to place on the battlefield.\n156\t        hand: Cards to place in hand.\n157\t        graveyard: Cards to place in graveyard.\n158\t        life: Life total to set (or ``None`` to leave unchanged).\n159\t        mana: Mana to add to the player's pool.  Keys are\n160\t            :class:`ManaType`, values are amounts.\n161\t\n162\t    Raises:\n163\t        TestSetupError: If ``player_index`` is out of range.\n164\t    \"\"\"\n165\t    if player_index < 0 or player_index >= len(game.players):\n166\t        raise TestSetupError(\n167\t            f\"Invalid player_index {player_index} — game has \"\n168\t            f\"{len(game.players)} players (indices 0–{len(game.players) - 1})\"\n169\t        )\n170\t\n171\t    player = game.players[player_index]\n172\t\n173\t    if life is not None:\n174\t        player.life = life\n175\t\n176\t    if mana is not None:\n177\t        player.mana_pool.empty()\n178\t        for mana_type, amount in mana.items():\n179\t            player.mana_pool.add(mana_type, amount)\n180\t\n181\t    if battlefield is not None:\n182\t        _set_zone(game, player, Zone.BATTLEFIELD, battlefield)\n183\t\n184\t    if hand is not None:\n185\t        _set_zone(game, player, Zone.HAND, hand)\n186\t\n187\t    if graveyard is not None:\n188\t        _set_zone(game, player, Zone.GRAVEYARD, graveyard)\n189\t\n190\t\n191\tdef _set_zone(\n192\t    game: GameState,\n193\t    player: Any,\n194\t    zone: Zone,\n195\t    cards: list[Any],\n196\t) -> None:\n197\t    \"\"\"Replace a zone's contents with *cards*, assigning ownership.\"\"\"\n198\t    zone_container = player.zones[zone]\n199\t    # Clear existing contents\n200\t    for obj in zone_container.get_all():\n201\t        zone_container.remove(obj)\n202\t\n203\t    # Add new contents\n204\t    for card in cards:\n205\t        card.owner = player\n206\t        card.controller = player\n207\t        zone_container.add(card)\n208\t\n209\t\n210\t# ---------------------------------------------------------------------------\n211\t# cast_spell\n212\t# ---------------------------------------------------------------------------\n213\t\n214\t\n215\tdef cast_spell(\n216\t    game: GameState,\n217\t    player_index: int,\n218\t    card_name: str,\n219\t    targets: list[Any] | None = None,\n220\t) -> None:\n221\t    \"\"\"Find a card in hand by name, cast it, and pass priority until resolved.\n222\t\n223\t    The function:\n224\t    1. Locates the first card matching *card_name* in the player's hand.\n225\t    2. Sets up the game phase/priority for sorcery-speed casting if needed.\n226\t    3. Calls :func:`engine.casting.cast_spell`.\n227\t    4. Passes priority for both players so the spell resolves.\n228\t\n229\t    Parameters:\n230\t        game: The game state.\n231\t        player_index: Index of the casting player (0 or 1).\n232\t        card_name: Name of the card to find in hand.\n233\t        targets: Optional target list.  If provided, they are scripted\n234\t            into the player's DeterministicPlayer choices.\n235\t\n236\t    Raises:\n237\t        TestSetupError: If the card is not found in hand or casting fails.\n238\t    \"\"\"\n239\t    if player_index < 0 or player_index >= len(game.players):\n240\t        raise TestSetupError(\n241\t            f\"Invalid player_index {player_index} — game has \"\n242\t            f\"{len(game.players)} players\"\n243\t        )\n244\t\n245\t    player = game.players[player_index]\n246\t    hand = game.get_hand(player)\n247\t\n248\t    # Find the card by name\n249\t    card = None\n250\t    for obj in hand.get_all():\n251\t        if getattr(obj, \"name\", None) == card_name:\n252\t            card = obj\n253\t            break\n254\t\n255\t    if card is None:\n256\t        hand_names = [getattr(c, \"name\", repr(c)) for c in hand.get_all()]\n257\t        raise TestSetupError(\n258\t            f\"Card {card_name!r} not found in player {player_index}'s hand. \"\n259\t            f\"Hand contains: {hand_names}\"\n260\t        )\n261\t\n262\t    # Ensure sorcery-speed timing for non-instant spells\n263\t    from engine.types import CardType, Keyword\n264\t\n265\t    is_instant = CardType.INSTANT in getattr(card, \"card_types\", set())\n266\t    has_flash = Keyword.FLASH in getattr(card, \"keywords\", Keyword(0))\n267\t\n268\t    if not is_instant and not has_flash:\n269\t        # Set up sorcery-speed timing: active player, main phase, empty stack\n270\t        game.active_player_index = player_index\n271\t        game.priority_player_index = player_index\n272\t        if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n273\t            game.phase = Phase.PRECOMBAT_MAIN\n274\t            game.step = None\n275\t\n276\t    # Ensure the stack is empty for sorcery-speed\n277\t    if not game.stack.is_empty():\n278\t        raise TestSetupError(\n279\t            f\"Cannot cast {card_name!r} — stack is not empty\"\n280\t        )\n281\t\n282\t    # Script targets into the player's DeterministicPlayer choices so that\n283\t    # engine.casting.cast_spell -> player.choose_target() returns them.\n284\t    if targets and isinstance(player, DeterministicPlayer):\n285\t        for target in reversed(targets):\n286\t            player._script.appendleft(target)\n287\t\n288\t    try:\n289\t        _engine_cast_spell(game, player, card)\n290\t    except Exception as exc:\n291\t        raise TestSetupError(\n292\t            f\"Failed to cast {card_name!r}: {exc}\"\n293\t        ) from exc\n294\t\n295\t    # Pass priority for both players to resolve the spell\n296\t    _resolve_top_of_stack(game)\n297\t\n298\t\n299\tdef _resolve_top_of_stack(game: GameState) -> None:\n300\t    \"\"\"Resolve the top spell/ability on the stack by passing priority.\n301\t\n302\t    Both players pass priority so the top of the stack resolves.\n303\t    Repeats until the stack is empty.\n304\t    \"\"\"\n305\t    from engine.state_based_actions import resolve_state_based_actions\n306\t\n307\t    while not game.stack.is_empty():\n308\t        obj = game.stack.pop()\n309\t        obj.on_resolve(game)\n310\t        resolve_state_based_actions(game)\n311\t\n312\t\n313\t# ---------------------------------------------------------------------------\n314\t# advance_to_phase\n315\t# ---------------------------------------------------------------------------\n316\t\n317\t\n318\tdef advance_to_phase(\n319\t    game: GameState,\n320\t    phase: Phase,\n321\t    step: Step | None = None,\n322\t) -> None:\n323\t    \"\"\"Fast-forward the game state to the specified phase/step.\n324\t\n325\t    Advances by calling :meth:`GameState.advance_phase` until the target\n326\t    phase (and optionally step) is reached.  Priority is not granted during\n327\t    fast-forwarding — this is a direct state manipulation for test setup.\n328\t\n329\t    Parameters:\n330\t        game: The game state to advance.\n331\t        phase: The target phase.\n332\t        step: The target step (or ``None`` for main phases).\n333\t\n334\t    Raises:\n335\t        TestSetupError: If the target phase/step is not found within\n336\t            a full turn cycle (prevents infinite loops).\n337\t    \"\"\"\n338\t    target = (phase, step)\n339\t\n340\t    # Validate that (phase, step) is a valid combination\n341\t    valid_targets = {(p, s) for p, s in _TURN_SEQUENCE}\n342\t    if target not in valid_targets:\n343\t        raise TestSetupError(\n344\t            f\"Invalid phase/step combination: ({phase!r}, {step!r}). \"\n345\t            f\"Valid combinations: {sorted(valid_targets, key=lambda x: str(x))}\"\n346\t        )\n347\t\n348\t    # Already there?\n349\t    if (game.phase, game.step) == target:\n350\t        return\n351\t\n352\t    # Advance up to a full turn's worth of steps to prevent infinite loops\n353\t    max_advances = len(_TURN_SEQUENCE) + 1\n354\t    for _ in range(max_advances):\n355\t        game.advance_phase()\n356\t        if (game.phase, game.step) == target:\n357\t            return\n358\t\n359\t    raise TestSetupError(\n360\t        f\"Could not reach phase/step ({phase!r}, {step!r}) within \"\n361\t        f\"a full turn cycle. Current: ({game.phase!r}, {game.step!r})\"\n362\t    )\n363\t\n364\t\n365\t# ---------------------------------------------------------------------------\n366\t# declare_attackers\n367\t# ---------------------------------------------------------------------------\n368\t\n369\t\n370\tdef declare_attackers(\n371\t    game: GameState,\n372\t    attacker_names: list[str],\n373\t) -> None:\n374\t    \"\"\"Advance to combat and declare attackers by name.\n375\t\n376\t    1. Advances to the Declare Attackers step if not already there.\n377\t    2. Finds creatures on the active player's battlefield matching the\n378\t       given names.\n379\t    3. Scripts the active player's ``choose`` method to return those\n380\t       creatures.\n381\t    4. Calls :func:`engine.combat.declare_attackers_step`.\n382\t\n383\t    Parameters:\n384\t        game: The game state.\n385\t        attacker_names: Names of creatures to declare as attackers.\n386\t\n387\t    Raises:\n388\t        TestSetupError: If any named creature is not found on the\n389\t            active player's battlefield, or if the creature cannot attack.\n390\t    \"\"\"\n391\t    # Advance to declare attackers step\n392\t    if (game.phase, game.step) != (Phase.COMBAT, Step.DECLARE_ATTACKERS):\n393\t        advance_to_phase(game, Phase.COMBAT, Step.DECLARE_ATTACKERS)\n394\t\n395\t    active = game.active_player\n396\t    bf = game.get_battlefield(active)\n397\t\n398\t    # Resolve attacker names to objects\n399\t    attackers: list[Any] = []\n400\t    bf_objects = bf.get_all()\n401\t    for name in attacker_names:\n402\t        found = None\n403\t        for obj in bf_objects:\n404\t            if getattr(obj, \"name\", None) == name and obj not in attackers:\n405\t                found = obj\n406\t                break\n407\t        if found is None:\n408\t            bf_names = [getattr(c, \"name\", repr(c)) for c in bf_objects]\n409\t            raise TestSetupError(\n410\t                f\"Attacker {name!r} not found on active player's battlefield. \"\n411\t                f\"Battlefield contains: {bf_names}\"\n412\t            )\n413\t        attackers.append(found)\n414\t\n415\t    # Script the active player to choose these attackers\n416\t    if isinstance(active, DeterministicPlayer):\n417\t        active._script.appendleft(attackers)\n418\t    else:\n419\t        raise TestSetupError(\n420\t            \"declare_attackers requires active player to be a DeterministicPlayer\"\n421\t        )\n422\t\n423\t    game.combat_state.in_combat = True\n424\t    declare_attackers_step(game)\n425\t\n426\t\n427\t# ---------------------------------------------------------------------------\n428\t# declare_blockers\n429\t# ---------------------------------------------------------------------------\n430\t\n431\t\n432\tdef declare_blockers(\n433\t    game: GameState,\n434\t    assignments: dict[str, list[str]],\n435\t) -> None:\n436\t    \"\"\"Assign blockers by name mapping.\n437\t\n438\t    Parameters:\n439\t        game: The game state.\n440\t        assignments: A mapping of ``{\"attacker_name\": [\"blocker_name\", ...]}``.\n441\t            Each attacker on the active player's battlefield is matched by\n442\t            name, and each blocker on the defending player's battlefield is\n443\t            matched by name.\n444\t\n445\t    Raises:\n446\t        TestSetupError: If any named creature is not found.\n447\t    \"\"\"\n448\t    if (game.phase, game.step) != (Phase.COMBAT, Step.DECLARE_BLOCKERS):\n449\t        advance_to_phase(game, Phase.COMBAT, Step.DECLARE_BLOCKERS)\n450\t\n451\t    active = game.active_player\n452\t    defending = game.non_active_player\n453\t\n454\t    active_bf = game.get_battlefield(active)\n455\t    defending_bf = game.get_battlefield(defending)\n456\t\n457\t    active_objects = active_bf.get_all()\n458\t    defending_objects = defending_bf.get_all()\n459\t\n460\t    # Build mapping of blocker_obj → attacker_obj\n461\t    block_map: dict[Any, Any] = {}\n462\t\n463\t    for attacker_name, blocker_names in assignments.items():\n464\t        # Find attacker\n465\t        attacker = None\n466\t        for obj in active_objects:\n467\t            if getattr(obj, \"name\", None) == attacker_name:\n468\t                attacker = obj\n469\t                break\n470\t        if attacker is None:\n471\t            raise TestSetupError(\n472\t                f\"Attacker {attacker_name!r} not found on active player's battlefield. \"\n473\t                f\"Available: {[getattr(c, 'name', repr(c)) for c in active_objects]}\"\n474\t            )\n475\t\n476\t        for blocker_name in blocker_names:\n477\t            blocker = None\n478\t            for obj in defending_objects:\n479\t                if getattr(obj, \"name\", None) == blocker_name and obj not in block_map:\n480\t                    blocker = obj\n481\t                    break\n482\t            if blocker is None:\n483\t                raise TestSetupError(\n484\t                    f\"Blocker {blocker_name!r} not found on defending player's battlefield. \"\n485\t                    f\"Available: {[getattr(c, 'name', repr(c)) for c in defending_objects]}\"\n486\t                )\n487\t            block_map[blocker] = attacker\n488\t\n489\t    # Script the defending player to choose these block assignments\n490\t    if isinstance(defending, DeterministicPlayer):\n491\t        defending._script.appendleft(block_map)\n492\t    else:\n493\t        raise TestSetupError(\n494\t            \"declare_blockers requires defending player to be a DeterministicPlayer\"\n495\t        )\n496\t\n497\t    declare_blockers_step(game)\n498\t"}]},"parent_tool_use_id":null,"session_id":"735f529e-7bc8-4328-a211-d2f095818fd0","uuid":"13b81236-ee7b-438f-b2ef-80a37536f698","timestamp":"2026-06-04T09:48:00.108Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/test_utils.py","content":"\"\"\"Test utility helpers for engine validation and benchmark agents.\n\nProvides convenience functions for setting up game states, casting spells,\nadvancing phases, and managing combat in tests.  Each function raises\ndescriptive errors on failure.\n\nFunctions:\n    create_game — convenience wrapper to create a GameState from card lists.\n    set_board_state — directly set zone contents and player state.\n    cast_spell — find card in hand by name, cast, and resolve.\n    advance_to_phase — fast-forward game state to a given phase/step.\n    declare_attackers — advance to combat and declare attackers by name.\n    declare_blockers — assign blockers by name mapping.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any\n\nfrom engine.card import CardImpl, Creature\nfrom engine.casting import cast_spell as _engine_cast_spell\nfrom engine.combat import (\n    CombatState,\n    declare_attackers_step,\n    declare_blockers_step,\n)\nfrom engine.game import create_game as _engine_create_game\nfrom engine.game_state import GameState, _TURN_SEQUENCE\nfrom engine.mana import ManaPool\nfrom engine.player import DeterministicPlayer\nfrom engine.stack import priority_loop\nfrom engine.types import ManaType, Phase, Step, Zone\n\n\nclass TestSetupError(Exception):\n    \"\"\"Raised when a test utility function encounters an invalid setup.\"\"\"\n\n\ndef card_colors(card: Any) -> set[str]:\n    \"\"\"Return a card's colors as single-letter strings, derived from its mana cost.\n\n    Hybrid pips contribute both options. {C} and {X} contribute nothing.\n    Returns an empty set for cards with no mana cost or only colorless/X pips.\n    Used by audited tests that previously asserted against a non-existent\n    ``card.colors`` attribute.\n    \"\"\"\n    colors: set[str] = set()\n    cost = getattr(card, \"mana_cost\", None)\n    if cost is None:\n        return colors\n    for mt in getattr(cost, \"pips\", {}):\n        if mt != ManaType.COLORLESS:\n            colors.add(mt.value)\n    for hybrid in getattr(cost, \"hybrid\", []):\n        if hybrid.option_a != ManaType.COLORLESS:\n            colors.add(hybrid.option_a.value)\n        if hybrid.option_b != ManaType.COLORLESS:\n            colors.add(hybrid.option_b.value)\n    return colors\n\n\n# ---------------------------------------------------------------------------\n# create_game\n# ---------------------------------------------------------------------------\n\n\ndef create_game(\n    deck1: list[CardImpl] | None = None,\n    deck2: list[CardImpl] | None = None,\n    *,\n    player1_name: str = \"Player1\",\n    player2_name: str = \"Player2\",\n    player1_life: int = 20,\n    player2_life: int = 20,\n    scripts: tuple[list[Any], list[Any]] | None = None,\n) -> GameState:\n    \"\"\"Create a new two-player game from card lists.\n\n    This is a convenience wrapper around :func:`engine.game.create_game`\n    that automatically creates :class:`DeterministicPlayer` instances.\n\n    Parameters:\n        deck1: Cards for player 1's deck.  Defaults to empty list.\n        deck2: Cards for player 2's deck.  Defaults to empty list.\n        player1_name: Display name for player 1.\n        player2_name: Display name for player 2.\n        player1_life: Starting life for player 1.\n        player2_life: Starting life for player 2.\n        scripts: Optional tuple of ``(script1, script2)`` for\n            :class:`DeterministicPlayer`.  Defaults to empty lists.\n\n    Returns:\n        A fully initialised :class:`GameState`.\n\n    Raises:\n        TestSetupError: If the inputs are invalid.\n    \"\"\"\n    if deck1 is None:\n        deck1 = []\n    if deck2 is None:\n        deck2 = []\n\n    script1: list[Any] = []\n    script2: list[Any] = []\n    if scripts is not None:\n        script1, script2 = scripts\n\n    p1 = DeterministicPlayer(player1_name, script=script1, life=player1_life)\n    p2 = DeterministicPlayer(player2_name, script=script2, life=player2_life)\n\n    game = _engine_create_game(p1, p2, deck1, deck2)\n\n    # When decks are empty (the convenience default), engine.game.create_game\n    # attempts to draw 7 cards from each empty library, which sets the\n    # drawn_from_empty_library loss flag.  Reset it for the convenience case.\n    for player in game.players:\n        if player.drawn_from_empty_library:\n            player.drawn_from_empty_library = False\n\n    # engine.game.create_game hardcodes life=20; restore custom values.\n    if player1_life != 20:\n        game.players[0].life = player1_life\n    if player2_life != 20:\n        game.players[1].life = player2_life\n\n    return game\n\n\n# ---------------------------------------------------------------------------\n# set_board_state\n# ---------------------------------------------------------------------------\n\n\ndef set_board_state(\n    game: GameState,\n    player_index: int,\n    *,\n    battlefield: list[Any] | None = None,\n    hand: list[Any] | None = None,\n    graveyard: list[Any] | None = None,\n    life: int | None = None,\n    mana: dict[ManaType, int] | None = None,\n) -> None:\n    \"\"\"Directly set zone contents and player state for test setup.\n\n    Replaces the contents of the specified zones (only zones that are\n    explicitly provided are modified — others are left unchanged).\n\n    For each card placed into a zone, ``owner`` and ``controller`` are\n    set to the target player.\n\n    Parameters:\n        game: The game state to modify.\n        player_index: Index of the player (0 or 1).\n        battlefield: Cards/permanents to place on the battlefield.\n        hand: Cards to place in hand.\n        graveyard: Cards to place in graveyard.\n        life: Life total to set (or ``None`` to leave unchanged).\n        mana: Mana to add to the player's pool.  Keys are\n            :class:`ManaType`, values are amounts.\n\n    Raises:\n        TestSetupError: If ``player_index`` is out of range.\n    \"\"\"\n    if player_index < 0 or player_index >= len(game.players):\n        raise TestSetupError(\n            f\"Invalid player_index {player_index} — game has \"\n            f\"{len(game.players)} players (indices 0–{len(game.players) - 1})\"\n        )\n\n    player = game.players[player_index]\n\n    if life is not None:\n        player.life = life\n\n    if mana is not None:\n        player.mana_pool.empty()\n        for mana_type, amount in mana.items():\n            player.mana_pool.add(mana_type, amount)\n\n    if battlefield is not None:\n        _set_zone(game, player, Zone.BATTLEFIELD, battlefield)\n\n    if hand is not None:\n        _set_zone(game, player, Zone.HAND, hand)\n\n    if graveyard is not None:\n        _set_zone(game, player, Zone.GRAVEYARD, graveyard)\n\n\ndef _set_zone(\n    game: GameState,\n    player: Any,\n    zone: Zone,\n    cards: list[Any],\n) -> None:\n    \"\"\"Replace a zone's contents with *cards*, assigning ownership.\"\"\"\n    zone_container = player.zones[zone]\n    # Clear existing contents\n    for obj in zone_container.get_all():\n        zone_container.remove(obj)\n\n    # Add new contents\n    for card in cards:\n        card.owner = player\n        card.controller = player\n        zone_container.add(card)\n\n\n# ---------------------------------------------------------------------------\n# cast_spell\n# ---------------------------------------------------------------------------\n\n\ndef cast_spell(\n    game: GameState,\n    player_index: int,\n    card_name: str,\n    targets: list[Any] | None = None,\n) -> None:\n    \"\"\"Find a card in hand by name, cast it, and pass priority until resolved.\n\n    The function:\n    1. Locates the first card matching *card_name* in the player's hand.\n    2. Sets up the game phase/priority for sorcery-speed casting if needed.\n    3. Calls :func:`engine.casting.cast_spell`.\n    4. Passes priority for both players so the spell resolves.\n\n    Parameters:\n        game: The game state.\n        player_index: Index of the casting player (0 or 1).\n        card_name: Name of the card to find in hand.\n        targets: Optional target list.  If provided, they are scripted\n            into the player's DeterministicPlayer choices.\n\n    Raises:\n        TestSetupError: If the card is not found in hand or casting fails.\n    \"\"\"\n    if player_index < 0 or player_index >= len(game.players):\n        raise TestSetupError(\n            f\"Invalid player_index {player_index} — game has \"\n            f\"{len(game.players)} players\"\n        )\n\n    player = game.players[player_index]\n    hand = game.get_hand(player)\n\n    # Find the card by name\n    card = None\n    for obj in hand.get_all():\n        if getattr(obj, \"name\", None) == card_name:\n            card = obj\n            break\n\n    if card is None:\n        hand_names = [getattr(c, \"name\", repr(c)) for c in hand.get_all()]\n        raise TestSetupError(\n            f\"Card {card_name!r} not found in player {player_index}'s hand. \"\n            f\"Hand contains: {hand_names}\"\n        )\n\n    # Ensure sorcery-speed timing for non-instant spells\n    from engine.types import CardType, Keyword\n\n    is_instant = CardType.INSTANT in getattr(card, \"card_types\", set())\n    has_flash = Keyword.FLASH in getattr(card, \"keywords\", Keyword(0))\n\n    if not is_instant and not has_flash:\n        # Set up sorcery-speed timing: active player, main phase, empty stack\n        game.active_player_index = player_index\n        game.priority_player_index = player_index\n        if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n            game.phase = Phase.PRECOMBAT_MAIN\n            game.step = None\n\n    # Ensure the stack is empty for sorcery-speed\n    if not game.stack.is_empty():\n        raise TestSetupError(\n            f\"Cannot cast {card_name!r} — stack is not empty\"\n        )\n\n    # Script targets into the player's DeterministicPlayer choices so that\n    # engine.casting.cast_spell -> player.choose_target() returns them.\n    if targets and isinstance(player, DeterministicPlayer):\n        for target in reversed(targets):\n            player._script.appendleft(target)\n\n    try:\n        _engine_cast_spell(game, player, card)\n    except Exception as exc:\n        raise TestSetupError(\n            f\"Failed to cast {card_name!r}: {exc}\"\n        ) from exc\n\n    # Pass priority for both players to resolve the spell\n    _resolve_top_of_stack(game)\n\n\ndef _resolve_top_of_stack(game: GameState) -> None:\n    \"\"\"Resolve the top spell/ability on the stack by passing priority.\n\n    Both players pass priority so the top of the stack resolves.\n    Repeats until the stack is empty.\n    \"\"\"\n    from engine.state_based_actions import resolve_state_based_actions\n\n    while not game.stack.is_empty():\n        obj = game.stack.pop()\n        obj.on_resolve(game)\n        resolve_state_based_actions(game)\n\n\n# ---------------------------------------------------------------------------\n# advance_to_phase\n# ---------------------------------------------------------------------------\n\n\ndef advance_to_phase(\n    game: GameState,\n    phase: Phase,\n    step: Step | None = None,\n) -> None:\n    \"\"\"Fast-forward the game state to the specified phase/step.\n\n    Advances by calling :meth:`GameState.advance_phase` until the target\n    phase (and optionally step) is reached.  Priority is not granted during\n    fast-forwarding — this is a direct state manipulation for test setup.\n\n    Parameters:\n        game: The game state to advance.\n        phase: The target phase.\n        step: The target step (or ``None`` for main phases).\n\n    Raises:\n        TestSetupError: If the target phase/step is not found within\n            a full turn cycle (prevents infinite loops).\n    \"\"\"\n    target = (phase, step)\n\n    # Validate that (phase, step) is a valid combination\n    valid_targets = {(p, s) for p, s in _TURN_SEQUENCE}\n    if target not in valid_targets:\n        raise TestSetupError(\n            f\"Invalid phase/step combination: ({phase!r}, {step!r}). \"\n            f\"Valid combinations: {sorted(valid_targets, key=lambda x: str(x))}\"\n        )\n\n    # Already there?\n    if (game.phase, game.step) == target:\n        return\n\n    # Advance up to a full turn's worth of steps to prevent infinite loops\n    max_advances = len(_TURN_SEQUENCE) + 1\n    for _ in range(max_advances):\n        game.advance_phase()\n        if (game.phase, game.step) == target:\n            return\n\n    raise TestSetupError(\n        f\"Could not reach phase/step ({phase!r}, {step!r}) within \"\n        f\"a full turn cycle. Current: ({game.phase!r}, {game.step!r})\"\n    )\n\n\n# ---------------------------------------------------------------------------\n# declare_attackers\n# ---------------------------------------------------------------------------\n\n\ndef declare_attackers(\n    game: GameState,\n    attacker_names: list[str],\n) -> None:\n    \"\"\"Advance to combat and declare attackers by name.\n\n    1. Advances to the Declare Attackers step if not already there.\n    2. Finds creatures on the active player's battlefield matching the\n       given names.\n    3. Scripts the active player's ``choose`` method to return those\n       creatures.\n    4. Calls :func:`engine.combat.declare_attackers_step`.\n\n    Parameters:\n        game: The game state.\n        attacker_names: Names of creatures to declare as attackers.\n\n    Raises:\n        TestSetupError: If any named creature is not found on the\n            active player's battlefield, or if the creature cannot attack.\n    \"\"\"\n    # Advance to declare attackers step\n    if (game.phase, game.step) != (Phase.COMBAT, Step.DECLARE_ATTACKERS):\n        advance_to_phase(game, Phase.COMBAT, Step.DECLARE_ATTACKERS)\n\n    active = game.active_player\n    bf = game.get_battlefield(active)\n\n    # Resolve attacker names to objects\n    attackers: list[Any] = []\n    bf_objects = bf.get_all()\n    for name in attacker_names:\n        found = None\n        for obj in bf_objects:\n            if getattr(obj, \"name\", None) == name and obj not in attackers:\n                found = obj\n                break\n        if found is None:\n            bf_names = [getattr(c, \"name\", repr(c)) for c in bf_objects]\n            raise TestSetupError(\n                f\"Attacker {name!r} not found on active player's battlefield. \"\n                f\"Battlefield contains: {bf_names}\"\n            )\n        attackers.append(found)\n\n    # Script the active player to choose these attackers\n    if isinstance(active, DeterministicPlayer):\n        active._script.appendleft(attackers)\n    else:\n        raise TestSetupError(\n            \"declare_attackers requires active player to be a DeterministicPlayer\"\n        )\n\n    game.combat_state.in_combat = True\n    declare_attackers_step(game)\n\n\n# ---------------------------------------------------------------------------\n# declare_blockers\n# ---------------------------------------------------------------------------\n\n\ndef declare_blockers(\n    game: GameState,\n    assignments: dict[str, list[str]],\n) -> None:\n    \"\"\"Assign blockers by name mapping.\n\n    Parameters:\n        game: The game state.\n        assignments: A mapping of ``{\"attacker_name\": [\"blocker_name\", ...]}``.\n            Each attacker on the active player's battlefield is matched by\n            name, and each blocker on the defending player's battlefield is\n            matched by name.\n\n    Raises:\n        TestSetupError: If any named creature is not found.\n    \"\"\"\n    if (game.phase, game.step) != (Phase.COMBAT, Step.DECLARE_BLOCKERS):\n        advance_to_phase(game, Phase.COMBAT, Step.DECLARE_BLOCKERS)\n\n    active = game.active_player\n    defending = game.non_active_player\n\n    active_bf = game.get_battlefield(active)\n    defending_bf = game.get_battlefield(defending)\n\n    active_objects = active_bf.get_all()\n    defending_objects = defending_bf.get_all()\n\n    # Build mapping of blocker_obj → attacker_obj\n    block_map: dict[Any, Any] = {}\n\n    for attacker_name, blocker_names in assignments.items():\n        # Find attacker\n        attacker = None\n        for obj in active_objects:\n            if getattr(obj, \"name\", None) == attacker_name:\n                attacker = obj\n                break\n        if attacker is None:\n            raise TestSetupError(\n                f\"Attacker {attacker_name!r} not found on active player's battlefield. \"\n                f\"Available: {[getattr(c, 'name', repr(c)) for c in active_objects]}\"\n            )\n\n        for blocker_name in blocker_names:\n            blocker = None\n            for obj in defending_objects:\n                if getattr(obj, \"name\", None) == blocker_name and obj not in block_map:\n                    blocker = obj\n                    break\n            if blocker is None:\n                raise TestSetupError(\n                    f\"Blocker {blocker_name!r} not found on defending player's battlefield. \"\n                    f\"Available: {[getattr(c, 'name', repr(c)) for c in defending_objects]}\"\n                )\n            block_map[blocker] = attacker\n\n    # Script the defending player to choose these block assignments\n    if isinstance(defending, DeterministicPlayer):\n        defending._script.appendleft(block_map)\n    else:\n        raise TestSetupError(\n            \"declare_blockers requires defending player to be a DeterministicPlayer\"\n        )\n\n    declare_blockers_step(game)\n","numLines":498,"startLine":1,"totalLines":498}}}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_016FT2i9eMqi5rKfi2Wy9ocn","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_017VeMVRr5WV28kRhxpfct74","name":"Read","input":{"file_path":"/workspace/engine/state_based_actions.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2040,"cache_read_input_tokens":120587,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2040},"output_tokens":46,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"735f529e-7bc8-4328-a211-d2f095818fd0","uuid":"4e9f3cff-1947-4841-a670-1b94e1bcdc42","request_id":"req_011Cbi1TKNfZ45rYNgSp8t2s"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017VeMVRr5WV28kRhxpfct74","type":"tool_result","content":"1\t\"\"\"State-based actions checker and resolver.\n2\t\n3\tState-based actions (SBAs) are game rules that are checked and applied\n4\tautomatically whenever a player would receive priority.  They are checked\n5\trepeatedly until no more actions are taken, at which point triggered\n6\tabilities are placed on the stack.\n7\t\n8\tReferences: MTG Comprehensive Rules §704.\n9\t\"\"\"\n10\t\n11\tfrom __future__ import annotations\n12\t\n13\tfrom collections import defaultdict\n14\tfrom typing import TYPE_CHECKING, Any\n15\t\n16\tfrom engine.events import CreatureDiesReplacementEvent\n17\tfrom engine.types import CardType, Supertype, Zone\n18\tfrom engine.zones import ZoneContainer\n19\t\n20\tif TYPE_CHECKING:\n21\t    from engine.game_state import GameState\n22\t    from engine.player import Player\n23\t\n24\t\n25\t# ---------------------------------------------------------------------------\n26\t# Internal helpers\n27\t# ---------------------------------------------------------------------------\n28\t\n29\tdef _battlefield(game: GameState, player: Player) -> ZoneContainer:\n30\t    \"\"\"Return *player*'s battlefield zone.\"\"\"\n31\t    return player.zones[Zone.BATTLEFIELD]\n32\t\n33\t\n34\tdef _graveyard(game: GameState, player: Player) -> ZoneContainer:\n35\t    \"\"\"Return *player*'s graveyard zone.\"\"\"\n36\t    return player.zones[Zone.GRAVEYARD]\n37\t\n38\t\n39\tdef _move_to_graveyard(game: GameState, player: Player, obj: Any) -> None:\n40\t    \"\"\"Move *obj* from the battlefield to its owner's graveyard (or a\n41\t    replacement destination).\n42\t\n43\t    Delegates to :func:`~engine.zones.move_to_zone` which handles\n44\t    replacement effects, event firing (``LEAVES_BATTLEFIELD``,\n45\t    ``CREATURE_DIES``), and trigger/effect unregistration.\n46\t    \"\"\"\n47\t    from engine.zones import move_to_zone\n48\t\n49\t    bf = _battlefield(game, player)\n50\t    if bf.contains(obj):\n51\t        controller = getattr(obj, \"controller\", player)\n52\t        owner = getattr(obj, \"owner\", controller)\n53\t        move_to_zone(\n54\t            game,\n55\t            obj,\n56\t            Zone.BATTLEFIELD,\n57\t            Zone.GRAVEYARD,\n58\t            replacement_event=CreatureDiesReplacementEvent(\n59\t                creature=obj, destination=\"graveyard\",\n60\t                controller=controller, owner=owner,\n61\t            ),\n62\t        )\n63\t\n64\t\n65\t\n66\tdef _owner_of(game: GameState, obj: Any) -> Player:\n67\t    \"\"\"Return the owner of *obj*.\n68\t\n69\t    Falls back to checking which player's battlefield contains the object,\n70\t    then defaults to the first player.\n71\t    \"\"\"\n72\t    if hasattr(obj, \"owner\"):\n73\t        return obj.owner\n74\t    # Fallback: check each player's battlefield\n75\t    for player in game.players:\n76\t        if _battlefield(game, player).contains(obj):\n77\t            return player\n78\t    return game.players[0]\n79\t\n80\t\n81\t# ---------------------------------------------------------------------------\n82\t# Individual SBA checks\n83\t# ---------------------------------------------------------------------------\n84\t\n85\tdef _sba_player_life_zero(game: GameState) -> bool:\n86\t    \"\"\"A player with 0 or less life loses the game.\"\"\"\n87\t    action_taken = False\n88\t    for player in game.players:\n89\t        if player.life <= 0 and not player.has_lost:\n90\t            player.has_lost = True\n91\t            action_taken = True\n92\t    return action_taken\n93\t\n94\t\n95\tdef _sba_creature_zero_toughness(game: GameState) -> bool:\n96\t    \"\"\"A creature with toughness 0 or less is put into its owner's graveyard.\"\"\"\n97\t    action_taken = False\n98\t    to_remove: list[tuple[Player, Any]] = []\n99\t    for player in game.players:\n100\t        for obj in _battlefield(game, player).get_all():\n101\t            if hasattr(obj, \"toughness\") and obj.toughness <= 0:\n102\t                to_remove.append((player, obj))\n103\t    for player, obj in to_remove:\n104\t        _move_to_graveyard(game, player, obj)\n105\t        action_taken = True\n106\t    return action_taken\n107\t\n108\t\n109\tdef _sba_creature_lethal_damage(game: GameState) -> bool:\n110\t    \"\"\"A creature with lethal damage marked on it is destroyed (moved to graveyard).\n111\t\n112\t    Lethal damage means ``damage_marked >= toughness`` (rule 704.5g) or the\n113\t    creature has been dealt damage by a source with deathtouch and has any\n114\t    damage marked on it (rule 704.5h).  Creatures with the ``indestructible``\n115\t    keyword are skipped.\n116\t    \"\"\"\n117\t    action_taken = False\n118\t    to_remove: list[tuple[Player, Any]] = []\n119\t    for player in game.players:\n120\t        for obj in _battlefield(game, player).get_all():\n121\t            if not hasattr(obj, \"toughness\") or not hasattr(obj, \"damage_marked\"):\n122\t                continue\n123\t\n124\t            # Skip indestructible creatures\n125\t            if hasattr(obj, \"keywords\"):\n126\t                from engine.types import Keyword\n127\t\n128\t                if Keyword.INDESTRUCTIBLE in obj.keywords:\n129\t                    continue\n130\t\n131\t            lethal = obj.damage_marked >= obj.toughness\n132\t            # Rule 704.5h: creature dealt damage by a deathtouch source\n133\t            deathtouch_lethal = (\n134\t                getattr(obj, \"dealt_deathtouch_damage\", False)\n135\t                and obj.damage_marked > 0\n136\t            )\n137\t\n138\t            if lethal or deathtouch_lethal:\n139\t                to_remove.append((player, obj))\n140\t\n141\t    for player, obj in to_remove:\n142\t        _move_to_graveyard(game, player, obj)\n143\t        action_taken = True\n144\t    return action_taken\n145\t\n146\t\n147\tdef _sba_draw_from_empty_library(game: GameState) -> bool:\n148\t    \"\"\"A player who attempted to draw from an empty library loses the game.\"\"\"\n149\t    action_taken = False\n150\t    for player in game.players:\n151\t        if (\n152\t            hasattr(player, \"drawn_from_empty_library\")\n153\t            and player.drawn_from_empty_library\n154\t            and not player.has_lost\n155\t        ):\n156\t            player.has_lost = True\n157\t            action_taken = True\n158\t    return action_taken\n159\t\n160\t\n161\tdef _sba_legend_rule(game: GameState) -> bool:\n162\t    \"\"\"If a player controls 2+ legendaries with the same name, they choose one to keep.\n163\t\n164\t    The player is asked to choose which legendary permanent to keep via\n165\t    ``player.choose()``.  All others are moved to the graveyard.\n166\t    \"\"\"\n167\t    action_taken = False\n168\t    for player in game.players:\n169\t        bf = _battlefield(game, player)\n170\t        legendaries: dict[str, list[Any]] = defaultdict(list)\n171\t        for obj in bf.get_all():\n172\t            if (\n173\t                hasattr(obj, \"supertypes\")\n174\t                and Supertype.LEGENDARY in obj.supertypes\n175\t                and hasattr(obj, \"name\")\n176\t            ):\n177\t                legendaries[obj.name].append(obj)\n178\t        for name, objs in legendaries.items():\n179\t            if len(objs) >= 2:\n180\t                # Let the player choose which to keep\n181\t                keep = player.choose(objs, f\"legend rule: choose which {name!r} to keep\")\n182\t                for obj in objs:\n183\t                    if obj is not keep:\n184\t                        _move_to_graveyard(game, player, obj)\n185\t                action_taken = True\n186\t    return action_taken\n187\t\n188\t\n189\tdef _sba_token_not_on_battlefield(game: GameState) -> bool:\n190\t    \"\"\"Tokens that are not on the battlefield cease to exist (removed from game).\n191\t\n192\t    Checks all non-battlefield zones for tokens and removes them entirely.\n193\t    \"\"\"\n194\t    action_taken = False\n195\t    non_battlefield_zones = [\n196\t        Zone.HAND,\n197\t        Zone.GRAVEYARD,\n198\t        Zone.LIBRARY,\n199\t        Zone.EXILE,\n200\t        Zone.STACK,\n201\t        Zone.COMMAND,\n202\t    ]\n203\t    for player in game.players:\n204\t        for zone_type in non_battlefield_zones:\n205\t            zone = player.zones[zone_type]\n206\t            tokens = [\n207\t                obj\n208\t                for obj in zone.get_all()\n209\t                if hasattr(obj, \"is_token\") and obj.is_token\n210\t            ]\n211\t            for token in tokens:\n212\t                zone.remove(token)\n213\t                action_taken = True\n214\t    return action_taken\n215\t\n216\t\n217\tdef _attachment_illegal_due_to_protection(obj: Any) -> bool:\n218\t    \"\"\"Return ``True`` if *obj* (aura or equipment) is illegally attached due to protection.\"\"\"\n219\t    attached = getattr(obj, \"attached_to\", None)\n220\t    if attached is None:\n221\t        return False\n222\t    from engine.protection import has_protection_from\n223\t    return has_protection_from(attached, obj)\n224\t\n225\t\n226\tdef _sba_aura_unattached(game: GameState) -> bool:\n227\t    \"\"\"An Aura or Equipment not attached to a legal object is put into its\n228\t    owner's graveyard.\n229\t\n230\t    An attachment is considered illegally attached if:\n231\t    - It has an ``attached_to`` attribute that is ``None``, OR\n232\t    - The object it is attached to is no longer on the battlefield, OR\n233\t    - The enchanted/equipped permanent has protection from the attachment.\n234\t    \"\"\"\n235\t    action_taken = False\n236\t    to_remove: list[tuple[Player, Any]] = []\n237\t\n238\t    # Collect all objects on all battlefields for checking attachment legality\n239\t    all_on_battlefield: set[int] = set()\n240\t    for player in game.players:\n241\t        for obj in _battlefield(game, player).get_all():\n242\t            all_on_battlefield.add(id(obj))\n243\t\n244\t    to_unattach: list[Any] = []  # Equipment just becomes unattached\n245\t\n246\t    for player in game.players:\n247\t        for obj in _battlefield(game, player).get_all():\n248\t            is_aura = getattr(obj, \"is_aura\", False)\n249\t            is_equipment = getattr(obj, \"is_equipment\", False)\n250\t            if not hasattr(obj, \"attached_to\"):\n251\t                continue\n252\t            if is_aura:\n253\t                target = obj.attached_to\n254\t                if target is None or id(target) not in all_on_battlefield:\n255\t                    to_remove.append((player, obj))\n256\t                elif _attachment_illegal_due_to_protection(obj):\n257\t                    to_remove.append((player, obj))\n258\t            elif is_equipment:\n259\t                target = obj.attached_to\n260\t                if target is not None and _attachment_illegal_due_to_protection(obj):\n261\t                    to_unattach.append(obj)\n262\t\n263\t    for player, obj in to_remove:\n264\t        _move_to_graveyard(game, player, obj)\n265\t        action_taken = True\n266\t    for obj in to_unattach:\n267\t        obj.attached_to = None\n268\t        action_taken = True\n269\t    return action_taken\n270\t\n271\t\n272\tdef _sba_counter_annihilation(game: GameState) -> bool:\n273\t    \"\"\"+1/+1 and -1/-1 counters on the same permanent annihilate in pairs.\"\"\"\n274\t    action_taken = False\n275\t    for player in game.players:\n276\t        for obj in _battlefield(game, player).get_all():\n277\t            if (\n278\t                hasattr(obj, \"plus_one_counters\")\n279\t                and hasattr(obj, \"minus_one_counters\")\n280\t            ):\n281\t                plus = obj.plus_one_counters\n282\t                minus = obj.minus_one_counters\n283\t                if plus > 0 and minus > 0:\n284\t                    annihilate = min(plus, minus)\n285\t                    obj.plus_one_counters -= annihilate\n286\t                    obj.minus_one_counters -= annihilate\n287\t                    action_taken = True\n288\t    return action_taken\n289\t\n290\t\n291\t# ---------------------------------------------------------------------------\n292\t# Public API\n293\t# ---------------------------------------------------------------------------\n294\t\n295\tdef check_state_based_actions(game: GameState) -> bool:\n296\t    \"\"\"Perform a single pass of all state-based actions.\n297\t\n298\t    Returns ``True`` if any action was taken during this pass.  The caller\n299\t    should invoke this repeatedly until it returns ``False`` to ensure the\n300\t    game state is fully stable.\n301\t    \"\"\"\n302\t    action_taken = False\n303\t    # Player with 0 or less life loses\n304\t    action_taken = _sba_player_life_zero(game) or action_taken\n305\t    # Creature with toughness 0 or less → graveyard\n306\t    action_taken = _sba_creature_zero_toughness(game) or action_taken\n307\t    # Creature with lethal damage → destroyed\n308\t    action_taken = _sba_creature_lethal_damage(game) or action_taken\n309\t    # Player who drew from empty library loses\n310\t    action_taken = _sba_draw_from_empty_library(game) or action_taken\n311\t    # Legend rule\n312\t    action_taken = _sba_legend_rule(game) or action_taken\n313\t    # Token not on battlefield → ceases to exist\n314\t    action_taken = _sba_token_not_on_battlefield(game) or action_taken\n315\t    # Aura not attached to legal object → graveyard\n316\t    action_taken = _sba_aura_unattached(game) or action_taken\n317\t    # +1/+1 and -1/-1 counter annihilation\n318\t    action_taken = _sba_counter_annihilation(game) or action_taken\n319\t    return action_taken\n320\t\n321\t\n322\tdef resolve_state_based_actions(game: GameState) -> bool:\n323\t    \"\"\"Run state-based actions in a loop until no more actions are taken.\n324\t\n325\t    After each SBA stabilisation pass, any triggered abilities that were\n326\t    queued during processing are left on the stack.  Per MTG rule 704.3,\n327\t    the SBA loop must repeat if new triggers were placed on the stack\n328\t    (because those triggers may cause further SBAs when resolved, and\n329\t    the game state must be fully stable before a player receives priority).\n330\t\n331\t    The outer loop: repeat { run SBA passes until stable; record whether\n332\t    new triggers were pushed onto the stack during those passes } until\n333\t    no SBAs were performed **and** no new triggers were queued.\n334\t\n335\t    Returns ``True`` if any SBAs were performed during the entire process,\n336\t    ``False`` if the game state was already stable.\n337\t    \"\"\"\n338\t    any_performed = False\n339\t    while True:\n340\t        # Snapshot the stack size before SBA passes so we can detect new\n341\t        # triggers that were pushed during processing.\n342\t        stack_size_before = len(game.stack)\n343\t\n344\t        # Inner loop: run SBA checks until no more actions are taken.\n345\t        sba_this_round = False\n346\t        while check_state_based_actions(game):\n347\t            sba_this_round = True\n348\t            any_performed = True\n349\t\n350\t        # Detect whether any triggers were queued during this round.\n351\t        triggers_queued = len(game.stack) > stack_size_before\n352\t\n353\t        # If nothing happened this round (no SBAs and no new triggers),\n354\t        # the game state is fully stable.\n355\t        if not sba_this_round and not triggers_queued:\n356\t            break\n357\t\n358\t    return any_performed\n359\t"}]},"parent_tool_use_id":null,"session_id":"735f529e-7bc8-4328-a211-d2f095818fd0","uuid":"5686fddc-7dc5-47eb-9102-b22589c270d5","timestamp":"2026-06-04T09:48:00.217Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/state_based_actions.py","content":"\"\"\"State-based actions checker and resolver.\n\nState-based actions (SBAs) are game rules that are checked and applied\nautomatically whenever a player would receive priority.  They are checked\nrepeatedly until no more actions are taken, at which point triggered\nabilities are placed on the stack.\n\nReferences: MTG Comprehensive Rules §704.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections import defaultdict\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.events import CreatureDiesReplacementEvent\nfrom engine.types import CardType, Supertype, Zone\nfrom engine.zones import ZoneContainer\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n# ---------------------------------------------------------------------------\n# Internal helpers\n# ---------------------------------------------------------------------------\n\ndef _battlefield(game: GameState, player: Player) -> ZoneContainer:\n    \"\"\"Return *player*'s battlefield zone.\"\"\"\n    return player.zones[Zone.BATTLEFIELD]\n\n\ndef _graveyard(game: GameState, player: Player) -> ZoneContainer:\n    \"\"\"Return *player*'s graveyard zone.\"\"\"\n    return player.zones[Zone.GRAVEYARD]\n\n\ndef _move_to_graveyard(game: GameState, player: Player, obj: Any) -> None:\n    \"\"\"Move *obj* from the battlefield to its owner's graveyard (or a\n    replacement destination).\n\n    Delegates to :func:`~engine.zones.move_to_zone` which handles\n    replacement effects, event firing (``LEAVES_BATTLEFIELD``,\n    ``CREATURE_DIES``), and trigger/effect unregistration.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    bf = _battlefield(game, player)\n    if bf.contains(obj):\n        controller = getattr(obj, \"controller\", player)\n        owner = getattr(obj, \"owner\", controller)\n        move_to_zone(\n            game,\n            obj,\n            Zone.BATTLEFIELD,\n            Zone.GRAVEYARD,\n            replacement_event=CreatureDiesReplacementEvent(\n                creature=obj, destination=\"graveyard\",\n                controller=controller, owner=owner,\n            ),\n        )\n\n\n\ndef _owner_of(game: GameState, obj: Any) -> Player:\n    \"\"\"Return the owner of *obj*.\n\n    Falls back to checking which player's battlefield contains the object,\n    then defaults to the first player.\n    \"\"\"\n    if hasattr(obj, \"owner\"):\n        return obj.owner\n    # Fallback: check each player's battlefield\n    for player in game.players:\n        if _battlefield(game, player).contains(obj):\n            return player\n    return game.players[0]\n\n\n# ---------------------------------------------------------------------------\n# Individual SBA checks\n# ---------------------------------------------------------------------------\n\ndef _sba_player_life_zero(game: GameState) -> bool:\n    \"\"\"A player with 0 or less life loses the game.\"\"\"\n    action_taken = False\n    for player in game.players:\n        if player.life <= 0 and not player.has_lost:\n            player.has_lost = True\n            action_taken = True\n    return action_taken\n\n\ndef _sba_creature_zero_toughness(game: GameState) -> bool:\n    \"\"\"A creature with toughness 0 or less is put into its owner's graveyard.\"\"\"\n    action_taken = False\n    to_remove: list[tuple[Player, Any]] = []\n    for player in game.players:\n        for obj in _battlefield(game, player).get_all():\n            if hasattr(obj, \"toughness\") and obj.toughness <= 0:\n                to_remove.append((player, obj))\n    for player, obj in to_remove:\n        _move_to_graveyard(game, player, obj)\n        action_taken = True\n    return action_taken\n\n\ndef _sba_creature_lethal_damage(game: GameState) -> bool:\n    \"\"\"A creature with lethal damage marked on it is destroyed (moved to graveyard).\n\n    Lethal damage means ``damage_marked >= toughness`` (rule 704.5g) or the\n    creature has been dealt damage by a source with deathtouch and has any\n    damage marked on it (rule 704.5h).  Creatures with the ``indestructible``\n    keyword are skipped.\n    \"\"\"\n    action_taken = False\n    to_remove: list[tuple[Player, Any]] = []\n    for player in game.players:\n        for obj in _battlefield(game, player).get_all():\n            if not hasattr(obj, \"toughness\") or not hasattr(obj, \"damage_marked\"):\n                continue\n\n            # Skip indestructible creatures\n            if hasattr(obj, \"keywords\"):\n                from engine.types import Keyword\n\n                if Keyword.INDESTRUCTIBLE in obj.keywords:\n                    continue\n\n            lethal = obj.damage_marked >= obj.toughness\n            # Rule 704.5h: creature dealt damage by a deathtouch source\n            deathtouch_lethal = (\n                getattr(obj, \"dealt_deathtouch_damage\", False)\n                and obj.damage_marked > 0\n            )\n\n            if lethal or deathtouch_lethal:\n                to_remove.append((player, obj))\n\n    for player, obj in to_remove:\n        _move_to_graveyard(game, player, obj)\n        action_taken = True\n    return action_taken\n\n\ndef _sba_draw_from_empty_library(game: GameState) -> bool:\n    \"\"\"A player who attempted to draw from an empty library loses the game.\"\"\"\n    action_taken = False\n    for player in game.players:\n        if (\n            hasattr(player, \"drawn_from_empty_library\")\n            and player.drawn_from_empty_library\n            and not player.has_lost\n        ):\n            player.has_lost = True\n            action_taken = True\n    return action_taken\n\n\ndef _sba_legend_rule(game: GameState) -> bool:\n    \"\"\"If a player controls 2+ legendaries with the same name, they choose one to keep.\n\n    The player is asked to choose which legendary permanent to keep via\n    ``player.choose()``.  All others are moved to the graveyard.\n    \"\"\"\n    action_taken = False\n    for player in game.players:\n        bf = _battlefield(game, player)\n        legendaries: dict[str, list[Any]] = defaultdict(list)\n        for obj in bf.get_all():\n            if (\n                hasattr(obj, \"supertypes\")\n                and Supertype.LEGENDARY in obj.supertypes\n                and hasattr(obj, \"name\")\n            ):\n                legendaries[obj.name].append(obj)\n        for name, objs in legendaries.items():\n            if len(objs) >= 2:\n                # Let the player choose which to keep\n                keep = player.choose(objs, f\"legend rule: choose which {name!r} to keep\")\n                for obj in objs:\n                    if obj is not keep:\n                        _move_to_graveyard(game, player, obj)\n                action_taken = True\n    return action_taken\n\n\ndef _sba_token_not_on_battlefield(game: GameState) -> bool:\n    \"\"\"Tokens that are not on the battlefield cease to exist (removed from game).\n\n    Checks all non-battlefield zones for tokens and removes them entirely.\n    \"\"\"\n    action_taken = False\n    non_battlefield_zones = [\n        Zone.HAND,\n        Zone.GRAVEYARD,\n        Zone.LIBRARY,\n        Zone.EXILE,\n        Zone.STACK,\n        Zone.COMMAND,\n    ]\n    for player in game.players:\n        for zone_type in non_battlefield_zones:\n            zone = player.zones[zone_type]\n            tokens = [\n                obj\n                for obj in zone.get_all()\n                if hasattr(obj, \"is_token\") and obj.is_token\n            ]\n            for token in tokens:\n                zone.remove(token)\n                action_taken = True\n    return action_taken\n\n\ndef _attachment_illegal_due_to_protection(obj: Any) -> bool:\n    \"\"\"Return ``True`` if *obj* (aura or equipment) is illegally attached due to protection.\"\"\"\n    attached = getattr(obj, \"attached_to\", None)\n    if attached is None:\n        return False\n    from engine.protection import has_protection_from\n    return has_protection_from(attached, obj)\n\n\ndef _sba_aura_unattached(game: GameState) -> bool:\n    \"\"\"An Aura or Equipment not attached to a legal object is put into its\n    owner's graveyard.\n\n    An attachment is considered illegally attached if:\n    - It has an ``attached_to`` attribute that is ``None``, OR\n    - The object it is attached to is no longer on the battlefield, OR\n    - The enchanted/equipped permanent has protection from the attachment.\n    \"\"\"\n    action_taken = False\n    to_remove: list[tuple[Player, Any]] = []\n\n    # Collect all objects on all battlefields for checking attachment legality\n    all_on_battlefield: set[int] = set()\n    for player in game.players:\n        for obj in _battlefield(game, player).get_all():\n            all_on_battlefield.add(id(obj))\n\n    to_unattach: list[Any] = []  # Equipment just becomes unattached\n\n    for player in game.players:\n        for obj in _battlefield(game, player).get_all():\n            is_aura = getattr(obj, \"is_aura\", False)\n            is_equipment = getattr(obj, \"is_equipment\", False)\n            if not hasattr(obj, \"attached_to\"):\n                continue\n            if is_aura:\n                target = obj.attached_to\n                if target is None or id(target) not in all_on_battlefield:\n                    to_remove.append((player, obj))\n                elif _attachment_illegal_due_to_protection(obj):\n                    to_remove.append((player, obj))\n            elif is_equipment:\n                target = obj.attached_to\n                if target is not None and _attachment_illegal_due_to_protection(obj):\n                    to_unattach.append(obj)\n\n    for player, obj in to_remove:\n        _move_to_graveyard(game, player, obj)\n        action_taken = True\n    for obj in to_unattach:\n        obj.attached_to = None\n        action_taken = True\n    return action_taken\n\n\ndef _sba_counter_annihilation(game: GameState) -> bool:\n    \"\"\"+1/+1 and -1/-1 counters on the same permanent annihilate in pairs.\"\"\"\n    action_taken = False\n    for player in game.players:\n        for obj in _battlefield(game, player).get_all():\n            if (\n                hasattr(obj, \"plus_one_counters\")\n                and hasattr(obj, \"minus_one_counters\")\n            ):\n                plus = obj.plus_one_counters\n                minus = obj.minus_one_counters\n                if plus > 0 and minus > 0:\n                    annihilate = min(plus, minus)\n                    obj.plus_one_counters -= annihilate\n                    obj.minus_one_counters -= annihilate\n                    action_taken = True\n    return action_taken\n\n\n# ---------------------------------------------------------------------------\n# Public API\n# ---------------------------------------------------------------------------\n\ndef check_state_based_actions(game: GameState) -> bool:\n    \"\"\"Perform a single pass of all state-based actions.\n\n    Returns ``True`` if any action was taken during this pass.  The caller\n    should invoke this repeatedly until it returns ``False`` to ensure the\n    game state is fully stable.\n    \"\"\"\n    action_taken = False\n    # Player with 0 or less life loses\n    action_taken = _sba_player_life_zero(game) or action_taken\n    # Creature with toughness 0 or less → graveyard\n    action_taken = _sba_creature_zero_toughness(game) or action_taken\n    # Creature with lethal damage → destroyed\n    action_taken = _sba_creature_lethal_damage(game) or action_taken\n    # Player who drew from empty library loses\n    action_taken = _sba_draw_from_empty_library(game) or action_taken\n    # Legend rule\n    action_taken = _sba_legend_rule(game) or action_taken\n    # Token not on battlefield → ceases to exist\n    action_taken = _sba_token_not_on_battlefield(game) or action_taken\n    # Aura not attached to legal object → graveyard\n    action_taken = _sba_aura_unattached(game) or action_taken\n    # +1/+1 and -1/-1 counter annihilation\n    action_taken = _sba_counter_annihilation(game) or action_taken\n    return action_taken\n\n\ndef resolve_state_based_actions(game: GameState) -> bool:\n    \"\"\"Run state-based actions in a loop until no more actions are taken.\n\n    After each SBA stabilisation pass, any triggered abilities that were\n    queued during processing are left on the stack.  Per MTG rule 704.3,\n    the SBA loop must repeat if new triggers were placed on the stack\n    (because those triggers may cause further SBAs when resolved, and\n    the game state must be fully stable before a player receives priority).\n\n    The outer loop: repeat { run SBA passes until stable; record whether\n    new triggers were pushed onto the stack during those passes } until\n    no SBAs were performed **and** no new triggers were queued.\n\n    Returns ``True`` if any SBAs were performed during the entire process,\n    ``False`` if the game state was already stable.\n    \"\"\"\n    any_performed = False\n    while True:\n        # Snapshot the stack size before SBA passes so we can detect new\n        # triggers that were pushed during processing.\n        stack_size_before = len(game.stack)\n\n        # Inner loop: run SBA checks until no more actions are taken.\n        sba_this_round = False\n        while check_state_based_actions(game):\n            sba_this_round = True\n            any_performed = True\n\n        # Detect whether any triggers were queued during this round.\n        triggers_queued = len(game.stack) > stack_size_before\n\n        # If nothing happened this round (no SBAs and no new triggers),\n        # the game state is fully stable.\n        if not sba_this_round and not triggers_queued:\n            break\n\n    return any_performed\n","numLines":359,"startLine":1,"totalLines":359}}}
