{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019ngFtGo34BBxvDZ3juitV4","type":"tool_result","content":"126\t        generic=new_generic,\n127\t        pips=dict(cost.pips),\n128\t        x_count=cost.x_count,\n129\t        hybrid=list(cost.hybrid),\n130\t    )\n131\t\n132\t\n133\t# ------------------------------------------------------------------\n134\t# Cast spell\n135\t# ------------------------------------------------------------------\n136\t\n137\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n138\t    \"\"\"Cast *card* from *player*'s hand.\n139\t\n140\t    Pipeline\n141\t    --------\n142\t    1. **Timing check** — instants (and cards with flash) can be cast\n143\t       whenever the player has priority; everything else requires\n144\t       sorcery-speed timing.\n145\t    2. **can_cast** — ask the card whether it can legally be cast.\n146\t    3. **Hand check** — the card must be in the player's hand.\n147\t    4. **Move hand → stack zone** — remove the card from the hand and\n148\t       place it into the player's stack zone.\n149\t    5. **Choose targets** — if the card specifies targets (via\n150\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n151\t    6. **Mana check / payment** — the player's mana pool must be able to\n152\t       pay the card's mana cost.  If payment fails, the card is rolled\n153\t       back from the stack zone to the hand.\n154\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n155\t    8. **Push StackObject** — push a :class:`StackObject` whose\n156\t       ``on_resolve`` callback handles resolution.\n157\t\n158\t    Raises:\n159\t        CastingError: If any legality check fails.\n160\t    \"\"\"\n161\t    # 1. Timing\n162\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n163\t        raise CastingError(\n164\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n165\t        )\n166\t\n167\t    # 2. can_cast\n168\t    if not card.can_cast(game):\n169\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n170\t\n171\t    # 3. Hand check\n172\t    hand = game.get_hand(player)\n173\t    if not hand.contains(card):\n174\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n175\t\n176\t    # 4. Move card from hand to stack zone\n177\t    stack_zone = player.zones[Zone.STACK]\n178\t    hand.remove(card)\n179\t    stack_zone.add(card)\n180\t\n181\t    # Clear any stale colors_spent from a prior cast before new payment.\n182\t    if hasattr(card, \"colors_spent\"):\n183\t        del card.colors_spent\n184\t\n185\t    # 5. Choose targets\n186\t    target_specs = card.get_targets(game)\n187\t    chosen_targets: list[Any] = []\n188\t    if target_specs:\n189\t        for spec in target_specs:\n190\t            target = player.choose_target(target_specs, spec)\n191\t            # Validate against filter_fn if the spec provides one\n192\t            filter_fn = getattr(spec, \"filter_fn\", None)\n193\t            if filter_fn is not None and target is not None:\n194\t                if not filter_fn(target):\n195\t                    stack_zone.remove(card)\n196\t                    hand.add(card)\n197\t                    raise CastingError(\n198\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n199\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n200\t                    )\n201\t            chosen_targets.append(target)\n202\t\n203\t    # 5b. Protection check — reject targets that have protection from this\n204\t    #     spell (the T in DEBT).\n205\t    from engine.protection import has_protection_from\n206\t\n207\t    for target in chosen_targets:\n208\t        if has_protection_from(target, card):\n209\t            # Rollback: move card from stack zone back to hand\n210\t            stack_zone.remove(card)\n211\t            hand.add(card)\n212\t            raise CastingError(\n213\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n214\t            )\n215\t\n216\t    # Targets are stored on the StackObject (not the card) and passed\n217\t    # through the resolve pipeline via on_resolve(game, targets=...).\n218\t\n219\t    # 6. Mana check / payment (rollback on failure)\n220\t    # Ensure the card knows its controller so that cost_reduction() hooks\n221\t    # (e.g. Embercleave counting attacking creatures you control) see the\n222\t    # casting player, even for cards that were added to hand without an\n223\t    # explicit controller assignment.\n224\t    if card.controller is None:\n225\t        card.controller = player\n226\t    reduction = get_cost_reduction(game, card, player)\n227\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n228\t\n229\t    if not player.mana_pool.can_pay(effective_cost):\n230\t        # Rollback: move card from stack zone back to hand\n231\t        stack_zone.remove(card)\n232\t        hand.add(card)\n233\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n234\t\n235\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n236\t    total_before = player.mana_pool.total()\n237\t    player.mana_pool.pay(effective_cost)\n238\t    # Record total mana spent for mechanics that care (e.g. Mana Sculpt).\n239\t    card.mana_spent = total_before - player.mana_pool.total()  # type: ignore[attr-defined]\n240\t\n241\t    # Store colors of mana spent on the card for mechanics like Converge\n242\t    # that care about the colors used to cast the spell.\n243\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n244\t\n245\t    # 7. Call on_cast hook\n246\t    card.on_cast(game)\n247\t\n248\t    # 8. Build on_resolve callback and push StackObject\n249\t    stack_obj = StackObject(\n250\t        source=card,\n251\t        controller=player,\n252\t        targets=chosen_targets,\n253\t        on_resolve=lambda g: None,  # replaced below\n254\t    )\n255\t\n256\t    def _on_resolve(g: GameState) -> None:\n257\t        _resolve_spell(g, card, player, stack_obj)\n258\t\n259\t    stack_obj.on_resolve = _on_resolve\n260\t    game.stack.push(stack_obj)"}]},"parent_tool_use_id":null,"session_id":"735f529e-7bc8-4328-a211-d2f095818fd0","uuid":"379a05cb-5e3e-4c48-b610-6e8c2111c12a","timestamp":"2026-06-04T10:13:46.165Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"        generic=new_generic,\n        pips=dict(cost.pips),\n        x_count=cost.x_count,\n        hybrid=list(cost.hybrid),\n    )\n\n\n# ------------------------------------------------------------------\n# Cast spell\n# ------------------------------------------------------------------\n\ndef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n    \"\"\"Cast *card* from *player*'s hand.\n\n    Pipeline\n    --------\n    1. **Timing check** — instants (and cards with flash) can be cast\n       whenever the player has priority; everything else requires\n       sorcery-speed timing.\n    2. **can_cast** — ask the card whether it can legally be cast.\n    3. **Hand check** — the card must be in the player's hand.\n    4. **Move hand → stack zone** — remove the card from the hand and\n       place it into the player's stack zone.\n    5. **Choose targets** — if the card specifies targets (via\n       :meth:`CardImpl.get_targets`), the player is asked to choose.\n    6. **Mana check / payment** — the player's mana pool must be able to\n       pay the card's mana cost.  If payment fails, the card is rolled\n       back from the stack zone to the hand.\n    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n    8. **Push StackObject** — push a :class:`StackObject` whose\n       ``on_resolve`` callback handles resolution.\n\n    Raises:\n        CastingError: If any legality check fails.\n    \"\"\"\n    # 1. Timing\n    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n        )\n\n    # 2. can_cast\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 3. Hand check\n    hand = game.get_hand(player)\n    if not hand.contains(card):\n        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n\n    # 4. Move card from hand to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    hand.remove(card)\n    stack_zone.add(card)\n\n    # Clear any stale colors_spent from a prior cast before new payment.\n    if hasattr(card, \"colors_spent\"):\n        del card.colors_spent\n\n    # 5. Choose targets\n    target_specs = card.get_targets(game)\n    chosen_targets: list[Any] = []\n    if target_specs:\n        for spec in target_specs:\n            target = player.choose_target(target_specs, spec)\n            # Validate against filter_fn if the spec provides one\n            filter_fn = getattr(spec, \"filter_fn\", None)\n            if filter_fn is not None and target is not None:\n                if not filter_fn(target):\n                    stack_zone.remove(card)\n                    hand.add(card)\n                    raise CastingError(\n                        f\"Cannot cast {card.name!r} — chosen target does not \"\n                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                    )\n            chosen_targets.append(target)\n\n    # 5b. Protection check — reject targets that have protection from this\n    #     spell (the T in DEBT).\n    from engine.protection import has_protection_from\n\n    for target in chosen_targets:\n        if has_protection_from(target, card):\n            # Rollback: move card from stack zone back to hand\n            stack_zone.remove(card)\n            hand.add(card)\n            raise CastingError(\n                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n            )\n\n    # Targets are stored on the StackObject (not the card) and passed\n    # through the resolve pipeline via on_resolve(game, targets=...).\n\n    # 6. Mana check / payment (rollback on failure)\n    # Ensure the card knows its controller so that cost_reduction() hooks\n    # (e.g. Embercleave counting attacking creatures you control) see the\n    # casting player, even for cards that were added to hand without an\n    # explicit controller assignment.\n    if card.controller is None:\n        card.controller = player\n    reduction = get_cost_reduction(game, card, player)\n    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n\n    if not player.mana_pool.can_pay(effective_cost):\n        # Rollback: move card from stack zone back to hand\n        stack_zone.remove(card)\n        hand.add(card)\n        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n\n    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n    total_before = player.mana_pool.total()\n    player.mana_pool.pay(effective_cost)\n    # Record total mana spent for mechanics that care (e.g. Mana Sculpt).\n    card.mana_spent = total_before - player.mana_pool.total()  # type: ignore[attr-defined]\n\n    # Store colors of mana spent on the card for mechanics like Converge\n    # that care about the colors used to cast the spell.\n    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n\n    # 7. Call on_cast hook\n    card.on_cast(game)\n\n    # 8. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)","numLines":135,"startLine":126,"totalLines":591}}}
