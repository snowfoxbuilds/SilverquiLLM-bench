86\t            mana_cost=mana_cost,\n287\t            card_types=card_types,\n288\t            subtypes=subtypes,\n289\t            supertypes=supertypes,\n290\t            keywords=keywords,\n291\t            rules_text=rules_text,\n292\t            owner=owner,\n293\t            controller=controller,\n294\t        )\n295\t        self.base_power: int = base_power\n296\t        self.base_toughness: int = base_toughness\n297\t        self.modified_power: int = base_power\n298\t        self.modified_toughness: int = base_toughness\n299\t        self.damage_marked: int = 0\n300\t        self.is_tapped: bool = False\n301\t        self.summoning_sick: bool = True\n302\t        self.is_attacking: bool = False\n303\t        self.is_blocking: bool = False\n304\t        self.plus_one_counters: int = 0\n305\t        self.minus_one_counters: int = 0\n306\t        self.is_token: bool = False\n307\t        self.dealt_deathtouch_damage: bool = False\n308\t        self._base_plus_one_counters: int = 0\n309\t        self._base_minus_one_counters: int = 0\n310\t\n311\t    def _reset_characteristics(self) -> None:\n312\t        \"\"\"Reset creature characteristics to pre-effect values.\"\"\"\n313\t        super()._reset_characteristics()\n314\t        self.modified_power = self.base_power\n315\t        self.modified_toughness = self.base_toughness\n316\t        self.plus_one_counters = self._base_plus_one_counters\n317\t        self.minus_one_counters = self._base_minus_one_counters\n318\t        # Reset combat-restriction flags set by continuous effects (e.g. Pacifism).\n319\t        # These are reapplied by active effects during apply_all().\n320\t        self._cant_attack: bool = False\n321\t        self._cant_block: bool = False\n322\t        self._cant_be_blocked: bool = False\n323\t        self._cant_activate: bool = False\n324\t        self._max_attackers_blocked: int = 1\n325\t        # Clear granted protections so they are reapplied by active effects.\n326\t        if has