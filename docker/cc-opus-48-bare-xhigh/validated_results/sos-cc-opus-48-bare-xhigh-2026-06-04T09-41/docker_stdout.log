{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WQFKE6edknjtn6Hg5zfduD","type":"tool_result","content":"1\t\"\"\"Game setup, helper actions, and the full game loop.\n2\t\n3\tProvides the top-level functions for creating, running, and interacting with\n4\ta game of Magic: The Gathering:\n5\t\n6\t- :func:`create_game` — initialise a full game state for two players.\n7\t- Helper actions — module-level functions for common game operations\n8\t  (``deal_damage``, ``destroy``, ``sacrifice``, ``exile``, ``draw_card``,\n9\t  ``discard``, ``create_token``, ``add_counter``, ``remove_counter``,\n10\t  ``tap``, ``untap``).\n11\t- :func:`run_game` — execute turns until the game ends, returning the winner.\n12\t\"\"\"\n13\t\n14\tfrom __future__ import annotations\n15\t\n16\tfrom typing import TYPE_CHECKING, Any\n17\t\n18\tfrom engine.events import (\n19\t    CreatureDiesReplacementEvent,\n20\t    DealsDamageTriggeredEvent,\n21\t    DrawsCardTriggeredEvent,\n22\t    EntersBattlefieldTriggeredEvent,\n23\t    GainsLifeTriggeredEvent,\n24\t    LosesLifeTriggeredEvent,\n25\t    PermanentDestroyedReplacementEvent,\n26\t    SacrificeReplacementEvent,\n27\t)\n28\tfrom engine.game_state import GameState\n29\tfrom engine.turn import run_turn\n30\tfrom engine.types import Zone\n31\tfrom engine.zones import move_to_zone\n32\t\n33\tif TYPE_CHECKING:\n34\t    from engine.card import CardImpl, Creature\n35\t    from engine.player import Player\n36\t\n37\t\n38\t# Maximum number of turns before the game is considered a draw.\n39\t# Prevents infinite loops in deterministic or stuck game states.\n40\tMAX_TURNS: int = 1000\n41\t\n42\t\n43\t# ---------------------------------------------------------------------------\n44\t# Game creation\n45\t# ---------------------------------------------------------------------------\n46\t\n47\tdef create_game(\n48\t    player1: Player,\n49\t    player2: Player,\n50\t    deck1: list[CardImpl],\n51\t    deck2: list[CardImpl],\n52\t) -> GameState:\n53\t    \"\"\"Create and initialise a new two-player game.\n54\t\n55\t    Steps performed:\n56\t\n57\t    1. Set each player's life total to 20.\n58\t    2. Place *deck1* / *deck2* into the respective player's library zone.\n59\t    3. Shuffle each library.\n60\t    4. Draw 7 cards for each player.\n61\t    5. Set the active player to *player1*.\n62\t\n63\t    Card ownership is set so that each card's ``owner`` and ``controller``\n64\t    point to the player whose deck it came from.\n65\t\n66\t    Parameters:\n67\t        player1: The first player (goes first).\n68\t        player2: The second player.\n69\t        deck1: Cards comprising player1's deck.\n70\t        deck2: Cards comprising player2's deck.\n71\t\n72\t    Returns:\n73\t        A fully initialised :class:`GameState` ready for play.\n74\t    \"\"\"\n75\t    # 1. Set life totals\n76\t    player1.life = 20\n77\t    player2.life = 20\n78\t\n79\t    # 2. Place deck cards into libraries and set ownership\n80\t    library1 = player1.zones[Zone.LIBRARY]\n81\t    for card in deck1:\n82\t        card.owner = player1\n83\t        card.controller = player1\n84\t        library1.add(card)\n85\t\n86\t    library2 = player2.zones[Zone.LIBRARY]\n87\t    for card in deck2:\n88\t        card.owner = player2\n89\t        card.controller = player2\n90\t        library2.add(card)\n91\t\n92\t    # 3. Shuffle libraries\n93\t    library1.shuffle()\n94\t    library2.shuffle()\n95\t\n96\t    # Build the game state\n97\t    game = GameState([player1, player2])\n98\t\n99\t    # 4. Draw 7 cards each\n100\t    for _ in range(7):\n101\t        draw_card(game, player1)\n102\t    for _ in range(7):\n103\t        draw_card(game, player2)\n104\t\n105\t    # 5. Active player is player1 (index 0 — already the default)\n106\t    game.active_player_index = 0\n107\t    game.priority_player_index = 0\n108\t\n109\t    return game\n110\t\n111\t\n112\t# ---------------------------------------------------------------------------\n113\t# Common helper actions\n114\t# ---------------------------------------------------------------------------\n115\t\n116\tdef deal_damage(game: GameState, source: Any, target: Any, amount: int) -> None:"}]},"parent_tool_use_id":null,"session_id":"735f529e-7bc8-4328-a211-d2f095818fd0","uuid":"cceaaa64-fa2a-4d65-a976-4dc3cbcab68a","timestamp":"2026-06-04T10:07:53.405Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/game.py","content":"\"\"\"Game setup, helper actions, and the full game loop.\n\nProvides the top-level functions for creating, running, and interacting with\na game of Magic: The Gathering:\n\n- :func:`create_game` — initialise a full game state for two players.\n- Helper actions — module-level functions for common game operations\n  (``deal_damage``, ``destroy``, ``sacrifice``, ``exile``, ``draw_card``,\n  ``discard``, ``create_token``, ``add_counter``, ``remove_counter``,\n  ``tap``, ``untap``).\n- :func:`run_game` — execute turns until the game ends, returning the winner.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.events import (\n    CreatureDiesReplacementEvent,\n    DealsDamageTriggeredEvent,\n    DrawsCardTriggeredEvent,\n    EntersBattlefieldTriggeredEvent,\n    GainsLifeTriggeredEvent,\n    LosesLifeTriggeredEvent,\n    PermanentDestroyedReplacementEvent,\n    SacrificeReplacementEvent,\n)\nfrom engine.game_state import GameState\nfrom engine.turn import run_turn\nfrom engine.types import Zone\nfrom engine.zones import move_to_zone\n\nif TYPE_CHECKING:\n    from engine.card import CardImpl, Creature\n    from engine.player import Player\n\n\n# Maximum number of turns before the game is considered a draw.\n# Prevents infinite loops in deterministic or stuck game states.\nMAX_TURNS: int = 1000\n\n\n# ---------------------------------------------------------------------------\n# Game creation\n# ---------------------------------------------------------------------------\n\ndef create_game(\n    player1: Player,\n    player2: Player,\n    deck1: list[CardImpl],\n    deck2: list[CardImpl],\n) -> GameState:\n    \"\"\"Create and initialise a new two-player game.\n\n    Steps performed:\n\n    1. Set each player's life total to 20.\n    2. Place *deck1* / *deck2* into the respective player's library zone.\n    3. Shuffle each library.\n    4. Draw 7 cards for each player.\n    5. Set the active player to *player1*.\n\n    Card ownership is set so that each card's ``owner`` and ``controller``\n    point to the player whose deck it came from.\n\n    Parameters:\n        player1: The first player (goes first).\n        player2: The second player.\n        deck1: Cards comprising player1's deck.\n        deck2: Cards comprising player2's deck.\n\n    Returns:\n        A fully initialised :class:`GameState` ready for play.\n    \"\"\"\n    # 1. Set life totals\n    player1.life = 20\n    player2.life = 20\n\n    # 2. Place deck cards into libraries and set ownership\n    library1 = player1.zones[Zone.LIBRARY]\n    for card in deck1:\n        card.owner = player1\n        card.controller = player1\n        library1.add(card)\n\n    library2 = player2.zones[Zone.LIBRARY]\n    for card in deck2:\n        card.owner = player2\n        card.controller = player2\n        library2.add(card)\n\n    # 3. Shuffle libraries\n    library1.shuffle()\n    library2.shuffle()\n\n    # Build the game state\n    game = GameState([player1, player2])\n\n    # 4. Draw 7 cards each\n    for _ in range(7):\n        draw_card(game, player1)\n    for _ in range(7):\n        draw_card(game, player2)\n\n    # 5. Active player is player1 (index 0 — already the default)\n    game.active_player_index = 0\n    game.priority_player_index = 0\n\n    return game\n\n\n# ---------------------------------------------------------------------------\n# Common helper actions\n# ---------------------------------------------------------------------------\n\ndef deal_damage(game: GameState, source: Any, target: Any, amount: int) -> None:","numLines":116,"startLine":1,"totalLines":538}}}
