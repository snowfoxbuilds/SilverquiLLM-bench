{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EkqoyqsnBQttTB5Tc5jhjm","type":"tool_result","content":"1\t\"\"\"Casting and resolution pipeline for spells and lands.\n2\t\n3\tProvides the full flow from casting a spell or playing a land through\n4\tresolution:\n5\t\n6\t- :func:`cast_spell` — verify timing & legality → move hand to stack →\n7\t  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n8\t- :func:`play_land` — verify land play remaining → move hand to\n9\t  battlefield → decrement ``land_plays_remaining``.\n10\t- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n11\t  helpers used by the casting pipeline.\n12\t\n13\tResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\n14\tcreated by :func:`cast_spell`:\n15\t\n16\t- Call ``card.on_resolve(game)``.\n17\t- Permanents (creature / enchantment / artifact / planeswalker) move from\n18\t  the stack to the battlefield.\n19\t- Non-permanents (instant / sorcery) move to the graveyard.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import TYPE_CHECKING, Any\n25\t\n26\tfrom engine.card import CardImpl\n27\tfrom engine.stack import StackObject\n28\tfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\n29\tfrom engine.zones import move_zone\n30\t\n31\tif TYPE_CHECKING:\n32\t    from engine.game_state import GameState\n33\t    from engine.player import Player\n34\t\n35\t\n36\t# Card types that represent permanents — these go to the battlefield on resolve.\n37\t_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n38\t    CardType.CREATURE,\n39\t    CardType.ENCHANTMENT,\n40\t    CardType.ARTIFACT,\n41\t    CardType.PLANESWALKER,\n42\t})\n43\t\n44\t\n45\tclass CastingError(Exception):\n46\t    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n47\t\n48\t\n49\t# ------------------------------------------------------------------\n50\t# Timing helpers\n51\t# ------------------------------------------------------------------\n52\t\n53\tdef is_sorcery_speed(game: GameState, player: Player) -> bool:\n54\t    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n55\t\n56\t    Sorcery speed requires all of:\n57\t\n58\t    * *player* is the active player.\n59\t    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n60\t      ``POSTCOMBAT_MAIN``).\n61\t    * The stack is empty.\n62\t    \"\"\"\n63\t    if player is not game.active_player:\n64\t        return False\n65\t    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n66\t        return False\n67\t    if not game.stack.is_empty():\n68\t        return False\n69\t    return True\n70\t\n71\t\n72\tdef can_cast_at_instant_speed(card: CardImpl) -> bool:\n73\t    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n74\t\n75\t    A card has instant-speed timing if it is an instant or has the\n76\t    :attr:`~engine.types.Keyword.FLASH` keyword.\n77\t    \"\"\"\n78\t    if CardType.INSTANT in card.card_types:\n79\t        return True\n80\t    if Keyword.FLASH & card.keywords:\n81\t        return True\n82\t    return False\n83\t\n84\t\n85\t# ------------------------------------------------------------------\n86\t# Cost reduction\n87\t# ------------------------------------------------------------------\n88\t\n89\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n90\t    \"\"\"Return the generic mana reduction for casting *card*.\n91\t\n92\t    Queries ``card.cost_reduction(game)`` and clamps the result so that\n93\t    the generic portion of the mana cost cannot go below 0.\n94\t\n95\t    This is a simplified single-card self-reduction model.  Full MTG\n96\t    cost-reduction interactions (Trinisphere, multiple reductions from\n97\t    different sources) are deferred.\n98\t    \"\"\"\n99\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n100\t    # casting player even when the card was never explicitly assigned one.\n101\t    prev_controller = card.controller\n102\t    card.controller = controller\n103\t    raw = card.cost_reduction(game)\n104\t    # Restore previous controller in case the caller doesn't want a\n105\t    # side-effect (get_cost_reduction is a query, not a mutation).\n106\t    card.controller = prev_controller\n107\t\n108\t    # Add reductions granted by other permanents the controller controls\n109\t    # (e.g. an Elder Dragon granting affinity to all your instants/sorceries).\n110\t    for permanent in list(controller.zones[Zone.BATTLEFIELD].get_all()):\n111\t        if permanent is card:\n112\t            continue\n113\t        hook = getattr(permanent, \"static_cost_reduction\", None)\n114\t        if hook is None:\n115\t            continue\n116\t        raw += hook(game, card, controller)\n117\t\n118\t    generic = card.mana_cost.generic if card.mana_cost else 0\n119\t    return max(0, min(raw, generic))\n120\t\n121\t\n122\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n123\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n124\t    new_generic = max(0, cost.generic - reduction)\n125\t    return ManaCost(\n126\t        generic=new_generic,\n127\t        pips=dict(cost.pips),\n128\t        x_count=cost.x_count,\n129\t        hybrid=list(cost.hybrid),\n130\t    )\n131\t\n132\t\n133\t# ------------------------------------------------------------------\n134\t# Cast spell\n135\t# ------------------------------------------------------------------\n136\t\n137\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n138\t    \"\"\"Cast *card* from *player*'s hand.\n139\t\n140\t    Pipeline\n141\t    --------\n142\t    1. **Timing check** — instants (and cards with flash) can be cast\n143\t       whenever the player has priority; everything else requires\n144\t       sorcery-speed timing.\n145\t    2. **can_cast** — ask the card whether it can legally be cast.\n146\t    3. **Hand check** — the card must be in the player's hand.\n147\t    4. **Move hand → stack zone** — remove the card from the hand and\n148\t       place it into the player's stack zone.\n149\t    5. **Choose targets** — if the card specifies targets (via\n150\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n151\t    6. **Mana check / payment** — the player's mana pool must be able to\n152\t       pay the card's mana cost.  If payment fails, the card is rolled\n153\t       back from the stack zone to the hand.\n154\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n155\t    8. **Push StackObject** — push a :class:`StackObject` whose\n156\t       ``on_resolve`` callback handles resolution.\n157\t\n158\t    Raises:\n159\t        CastingError: If any legality check fails.\n160\t    \"\"\"\n161\t    # 1. Timing\n162\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n163\t        raise CastingError(\n164\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n165\t        )\n166\t\n167\t    # 2. can_cast\n168\t    if not card.can_cast(game):\n169\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n170\t\n171\t    # 3. Hand check\n172\t    hand = game.get_hand(player)\n173\t    if not hand.contains(card):\n174\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n175\t\n176\t    # 4. Move card from hand to stack zone\n177\t    stack_zone = player.zones[Zone.STACK]\n178\t    hand.remove(card)\n179\t    stack_zone.add(card)\n180\t\n181\t    # Clear any stale colors_spent from a prior cast before new payment.\n182\t    if hasattr(card, \"colors_spent\"):\n183\t        del card.colors_spent\n184\t\n185\t    # 5. Choose targets\n186\t    target_specs = card.get_targets(game)\n187\t    chosen_targets: list[Any] = []\n188\t    if target_specs:\n189\t        for spec in target_specs:\n190\t            target = player.choose_target(target_specs, spec)\n191\t            # Validate against filter_fn if the spec provides one\n192\t            filter_fn = getattr(spec, \"filter_fn\", None)\n193\t            if filter_fn is not None and target is not None:\n194\t                if not filter_fn(target):\n195\t                    stack_zone.remove(card)\n196\t                    hand.add(card)\n197\t                    raise CastingError(\n198\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n199\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n200\t                    )\n201\t            chosen_targets.append(target)\n202\t\n203\t    # 5b. Protection check — reject targets that have protection from this\n204\t    #     spell (the T in DEBT).\n205\t    from engine.protection import has_protection_from\n206\t\n207\t    for target in chosen_targets:\n208\t        if has_protection_from(target, card):\n209\t            # Rollback: move card from stack zone back to hand\n210\t            stack_zone.remove(card)\n211\t            hand.add(card)\n212\t            raise CastingError(\n213\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n214\t            )\n215\t\n216\t    # Targets are stored on the StackObject (not the card) and passed\n217\t    # through the resolve pipeline via on_resolve(game, targets=...).\n218\t\n219\t    # 6. Mana check / payment (rollback on failure)\n220\t    # Ensure the card knows its controller so that cost_reduction() hooks\n221\t    # (e.g. Embercleave counting attacking creatures you control) see the\n222\t    # casting player, even for cards that were added to hand without an\n223\t    # explicit controller assignment.\n224\t    if card.controller is None:\n225\t        card.controller = player\n226\t    reduction = get_cost_reduction(game, card, player)\n227\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n228\t\n229\t    if not player.mana_pool.can_pay(effective_cost):\n230\t        # Rollback: move card from stack zone back to hand\n231\t        stack_zone.remove(card)\n232\t        hand.add(card)\n233\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n234\t\n235\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n236\t    total_before = player.mana_pool.total()\n237\t    player.mana_pool.pay(effective_cost)\n238\t    # Record total mana spent for mechanics that care (e.g. Mana Sculpt).\n239\t    card.mana_spent = total_before - player.mana_pool.total()  # type: ignore[attr-defined]\n240\t\n241\t    # Store colors of mana spent on the card for mechanics like Converge\n242\t    # that care about the colors used to cast the spell.\n243\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n244\t\n245\t    # 7. Call on_cast hook\n246\t    card.on_cast(game)\n247\t\n248\t    # 8. Build on_resolve callback and push StackObject\n249\t    stack_obj = StackObject(\n250\t        source=card,\n251\t        controller=player,\n252\t        targets=chosen_targets,\n253\t        on_resolve=lambda g: None,  # replaced below\n254\t    )\n255\t\n256\t    def _on_resolve(g: GameState) -> None:\n257\t        _resolve_spell(g, card, player, stack_obj)\n258\t\n259\t    stack_obj.on_resolve = _on_resolve\n260\t    game.stack.push(stack_obj)\n261\t\n262\t    # Casualty: before the spell is announced as fully cast, additional-cost\n263\t    # grants (e.g. an Elder Dragon giving your spells casualty N) may copy it.\n264\t    _apply_casualty(game, card, player, stack_obj)\n265\t\n266\t    # Fire the spell-cast trigger (no-op when nothing is watching).\n267\t    from engine.events import SpellCastTriggeredEvent\n268\t\n269\t    game.trigger_manager.fire_event(\n270\t        game,\n271\t        SpellCastTriggeredEvent(\n272\t            spell=stack_obj, player=player, card=card, controller=player\n273\t        ),\n274\t    )\n275\t\n276\t\n277\t# ------------------------------------------------------------------\n278\t# Cast spell without paying mana cost (free-cast from any zone)\n279\t# ------------------------------------------------------------------\n280\t\n281\t\n282\tdef cast_spell_free(\n283\t    game: GameState,\n284\t    player: Player,\n285\t    card: CardImpl,\n286\t    from_zone: Zone,\n287\t) -> None:\n288\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n289\t\n290\t    This is used by effects that allow casting from zones other than hand\n291\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n292\t    or cascade.\n293\t\n294\t    Pipeline\n295\t    --------\n296\t    1. **can_cast** — ask the card whether it can legally be cast (same\n297\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n298\t    2. Move *card* from *from_zone* to the stack zone.\n299\t    3. Choose targets (if applicable) with validation and protection check.\n300\t    4. Call ``on_cast`` hook.\n301\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n302\t       resolution normally (permanents → battlefield, non-permanents →\n303\t       graveyard).\n304\t\n305\t    No timing check or mana payment is performed.  The spell goes on the\n306\t    stack and can be responded to normally (e.g. countered).\n307\t\n308\t    If targeting or other post-move checks fail, the card is rolled back\n309\t    to its source zone.\n310\t\n311\t    Parameters:\n312\t        game: The current game state.\n313\t        player: The player casting the spell.\n314\t        card: The card to cast.\n315\t        from_zone: The zone the card is currently in.\n316\t\n317\t    Raises:\n318\t        CastingError: If the card cannot be found in *from_zone* or\n319\t            legality checks fail.\n320\t    \"\"\"\n321\t    from engine.zones import move_to_zone\n322\t\n323\t    # Ensure controller is set\n324\t    card.controller = player\n325\t    if card.owner is None:\n326\t        card.owner = player\n327\t\n328\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n329\t    if not card.can_cast(game):\n330\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n331\t\n332\t    # 2. Locate card in source zone\n333\t    source_zone_container = player.zones[from_zone]\n334\t    if not source_zone_container.contains(card):\n335\t        # Try to find the card in any player's zone\n336\t        source_zone_container = None\n337\t        for p in game.players:\n338\t            z = p.zones[from_zone]\n339\t            if z.contains(card):\n340\t                source_zone_container = z\n341\t                break\n342\t\n343\t    if source_zone_container is None or not source_zone_container.contains(card):\n344\t        raise CastingError(\n345\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n346\t        )\n347\t\n348\t    # Move card from source zone to stack zone\n349\t    stack_zone = player.zones[Zone.STACK]\n350\t    source_zone_container.remove(card)\n351\t    stack_zone.add(card)\n352\t\n353\t    # 3. Choose targets (with rollback on failure)\n354\t    try:\n355\t        target_specs = card.get_targets(game)\n356\t        chosen_targets: list[Any] = []\n357\t        if target_specs:\n358\t            for spec in target_specs:\n359\t                target = player.choose_target(target_specs, spec)\n360\t                # Validate against filter_fn if the spec provides one\n361\t                filter_fn = getattr(spec, \"filter_fn\", None)\n362\t                if filter_fn is not None and target is not None:\n363\t                    if not filter_fn(target):\n364\t                        raise CastingError(\n365\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n366\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n367\t                        )\n368\t                chosen_targets.append(target)\n369\t\n370\t        # Protection check — reject targets that have protection from this spell\n371\t        from engine.protection import has_protection_from\n372\t\n373\t        for target in chosen_targets:\n374\t            if has_protection_from(target, card):\n375\t                raise CastingError(\n376\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n377\t                )\n378\t    except Exception as exc:\n379\t        # Rollback: move card from stack zone back to source zone\n380\t        stack_zone.remove(card)\n381\t        source_zone_container.add(card)\n382\t        raise CastingError(str(exc)) from exc\n383\t\n384\t    # No mana is paid for a free cast.\n385\t    card.mana_spent = 0  # type: ignore[attr-defined]\n386\t\n387\t    # 4. Call on_cast hook\n388\t    card.on_cast(game)\n389\t\n390\t    # 5. Build on_resolve callback and push StackObject\n391\t    stack_obj = StackObject(\n392\t        source=card,\n393\t        controller=player,\n394\t        targets=chosen_targets,\n395\t        on_resolve=lambda g: None,  # replaced below\n396\t    )\n397\t\n398\t    def _on_resolve(g: GameState) -> None:\n399\t        _resolve_spell(g, card, player, stack_obj)\n400\t\n401\t    stack_obj.on_resolve = _on_resolve\n402\t    game.stack.push(stack_obj)\n403\t\n404\t    # Casting for free still counts as casting — fire the cast trigger.\n405\t    from engine.events import SpellCastTriggeredEvent\n406\t\n407\t    game.trigger_manager.fire_event(\n408\t        game,\n409\t        SpellCastTriggeredEvent(\n410\t            spell=stack_obj, player=player, card=card, controller=player\n411\t        ),\n412\t    )\n413\t\n414\t\n415\t# ------------------------------------------------------------------\n416\t# Casualty (additional-cost grant: sacrifice a creature, copy the spell)\n417\t# ------------------------------------------------------------------\n418\t\n419\tdef _apply_casualty(\n420\t    game: GameState,\n421\t    card: CardImpl,\n422\t    controller: Player,\n423\t    stack_obj: StackObject,\n424\t) -> None:\n425\t    \"\"\"Apply casualty if any permanent grants it to *card*.\n426\t\n427\t    Casualty N: as the spell is cast, its controller may sacrifice a\n428\t    creature with power N or greater; when they do, a copy of the spell is\n429\t    put onto the stack.  Only instants and sorceries are eligible here.\n430\t\n431\t    The casualty value is sourced from permanents that expose a\n432\t    ``grants_casualty(game, card, controller) -> int`` hook (e.g. an Elder\n433\t    Dragon granting casualty 1 to all your instant/sorcery spells).\n434\t    \"\"\"\n435\t    if not (card.card_types & {CardType.INSTANT, CardType.SORCERY}):\n436\t        return\n437\t\n438\t    n = 0\n439\t    for permanent in list(controller.zones[Zone.BATTLEFIELD].get_all()):\n440\t        hook = getattr(permanent, \"grants_casualty\", None)\n441\t        if hook is None:\n442\t            continue\n443\t        n = max(n, hook(game, card, controller))\n444\t\n445\t    if n <= 0:\n446\t        return\n447\t\n448\t    eligible = [\n449\t        c for c in controller.zones[Zone.BATTLEFIELD].get_all()\n450\t        if c is not card\n451\t        and CardType.CREATURE in getattr(c, \"card_types\", set())\n452\t        and getattr(c, \"power\", 0) >= n\n453\t    ]\n454\t    if not eligible:\n455\t        return\n456\t\n457\t    if not controller.choose_yes_no(f\"Pay casualty {n} (sacrifice a creature)?\"):\n458\t        return\n459\t\n460\t    chosen = controller.choose(\n461\t        eligible, f\"choose creature to sacrifice for casualty {n}\"\n462\t    )\n463\t    if chosen is None or chosen not in eligible:\n464\t        return\n465\t\n466\t    from engine.game import sacrifice\n467\t    from engine.stack import copy_spell\n468\t\n469\t    sacrifice(game, controller, chosen)\n470\t    copy_obj = copy_spell(game, stack_obj, controller)\n471\t    game.stack.push(copy_obj)\n472\t\n473\t\n474\t# ------------------------------------------------------------------\n475\t# Resolution (called when the stack pops)\n476\t# ------------------------------------------------------------------\n477\t\n478\tdef _resolve_spell(\n479\t    game: GameState,\n480\t    card: CardImpl,\n481\t    player: Player,\n482\t    stack_obj: StackObject,\n483\t) -> None:\n484\t    \"\"\"Resolve *card* cast by *player*.\n485\t\n486\t    1. Call ``card.on_resolve(game, targets=targets)``.\n487\t    2. Remove the card from the stack zone.\n488\t    3. If the card is a permanent type, move it to the battlefield via\n489\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n490\t       registration and the ETB event).\n491\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n492\t    \"\"\"\n493\t    from engine.zones import move_to_zone\n494\t\n495\t    # Read targets from the StackObject — the single source of truth.\n496\t    # Set chosen_targets on the card just before resolution so that\n497\t    # _get_chosen_target helpers (which read via getattr) work.\n498\t    targets = stack_obj.targets\n499\t    if targets is not None:\n500\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n501\t\n502\t    card.on_resolve(game)\n503\t\n504\t    if card.card_types & _PERMANENT_TYPES:\n505\t        # Move from stack to battlefield via move_to_zone, which handles\n506\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n507\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n508\t    elif getattr(card, \"_exile_instead_of_graveyard\", False):\n509\t        # Some effects exile an instant/sorcery instead of using the graveyard.\n510\t        move_to_zone(game, card, Zone.STACK, Zone.EXILE)\n511\t    else:\n512\t        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n513\t        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n514\t\n515\t\n516\t# ------------------------------------------------------------------\n517\t# Play land (special action — does not use the stack)\n518\t# ------------------------------------------------------------------\n519\t\n520\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n521\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n522\t\n523\t    Requirements (all must hold):\n524\t\n525\t    * *land_card* has :attr:`CardType.LAND`.\n526\t    * *player* is the active player.\n527\t    * Current phase is a main phase.\n528\t    * The stack is empty.\n529\t    * ``player.land_plays_remaining > 0``.\n530\t    * The card is in the player's hand.\n531\t\n532\t    On success the card moves from hand to battlefield and\n533\t    ``land_plays_remaining`` is decremented.\n534\t\n535\t    Raises:\n536\t        CastingError: If any requirement is not met.\n537\t    \"\"\"\n538\t    # Must be a land\n539\t    if CardType.LAND not in land_card.card_types:\n540\t        raise CastingError(\n541\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n542\t        )\n543\t\n544\t    # Sorcery-speed timing (active player, main phase, stack empty)\n545\t    if not is_sorcery_speed(game, player):\n546\t        raise CastingError(\n547\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n548\t            \"during main phase with empty stack\"\n549\t        )\n550\t\n551\t    # Land plays remaining\n552\t    if player.land_plays_remaining <= 0:\n553\t        raise CastingError(\n554\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n555\t        )\n556\t\n557\t    # Card must be in hand\n558\t    hand = game.get_hand(player)\n559\t    if not hand.contains(land_card):\n560\t        raise CastingError(\n561\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n562\t        )\n563\t\n564\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n565\t    if land_card.owner is None:\n566\t        land_card.owner = player\n567\t    land_card.controller = player\n568\t\n569\t    # Move from hand to battlefield via move_to_zone, which fires\n570\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n571\t    from engine.zones import move_to_zone\n572\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n573\t\n574\t    # Decrement land plays\n575\t    player.land_plays_remaining -= 1\n576\t\n577\t\n578\tdef resolve_top(game: GameState) -> None:\n579\t    \"\"\"Resolve the top spell/ability on the stack.\n580\t\n581\t    Pops the top item from the stack, calls its on_resolve callback,\n582\t    then runs state-based actions.  If the stack is empty this is a no-op.\n583\t    \"\"\"\n584\t    if game.stack.is_empty():\n585\t        return\n586\t    from engine.state_based_actions import resolve_state_based_actions\n587\t\n588\t    obj = game.stack.pop()\n589\t    obj.on_resolve(game)\n590\t    resolve_state_based_actions(game)\n591\t"}]},"parent_tool_use_id":null,"session_id":"735f529e-7bc8-4328-a211-d2f095818fd0","uuid":"1f1e2e26-2041-401e-8022-7d9966a24d31","timestamp":"2026-06-04T10:15:46.819Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"\"\"\"Casting and resolution pipeline for spells and lands.\n\nProvides the full flow from casting a spell or playing a land through\nresolution:\n\n- :func:`cast_spell` — verify timing & legality → move hand to stack →\n  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n- :func:`play_land` — verify land play remaining → move hand to\n  battlefield → decrement ``land_plays_remaining``.\n- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n  helpers used by the casting pipeline.\n\nResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\ncreated by :func:`cast_spell`:\n\n- Call ``card.on_resolve(game)``.\n- Permanents (creature / enchantment / artifact / planeswalker) move from\n  the stack to the battlefield.\n- Non-permanents (instant / sorcery) move to the graveyard.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import CardImpl\nfrom engine.stack import StackObject\nfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\nfrom engine.zones import move_zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n# Card types that represent permanents — these go to the battlefield on resolve.\n_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n    CardType.CREATURE,\n    CardType.ENCHANTMENT,\n    CardType.ARTIFACT,\n    CardType.PLANESWALKER,\n})\n\n\nclass CastingError(Exception):\n    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n\n\n# ------------------------------------------------------------------\n# Timing helpers\n# ------------------------------------------------------------------\n\ndef is_sorcery_speed(game: GameState, player: Player) -> bool:\n    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n\n    Sorcery speed requires all of:\n\n    * *player* is the active player.\n    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n      ``POSTCOMBAT_MAIN``).\n    * The stack is empty.\n    \"\"\"\n    if player is not game.active_player:\n        return False\n    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n        return False\n    if not game.stack.is_empty():\n        return False\n    return True\n\n\ndef can_cast_at_instant_speed(card: CardImpl) -> bool:\n    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n\n    A card has instant-speed timing if it is an instant or has the\n    :attr:`~engine.types.Keyword.FLASH` keyword.\n    \"\"\"\n    if CardType.INSTANT in card.card_types:\n        return True\n    if Keyword.FLASH & card.keywords:\n        return True\n    return False\n\n\n# ------------------------------------------------------------------\n# Cost reduction\n# ------------------------------------------------------------------\n\ndef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n    \"\"\"Return the generic mana reduction for casting *card*.\n\n    Queries ``card.cost_reduction(game)`` and clamps the result so that\n    the generic portion of the mana cost cannot go below 0.\n\n    This is a simplified single-card self-reduction model.  Full MTG\n    cost-reduction interactions (Trinisphere, multiple reductions from\n    different sources) are deferred.\n    \"\"\"\n    # Ensure card.controller is set so the hook can reference \"you\" / the\n    # casting player even when the card was never explicitly assigned one.\n    prev_controller = card.controller\n    card.controller = controller\n    raw = card.cost_reduction(game)\n    # Restore previous controller in case the caller doesn't want a\n    # side-effect (get_cost_reduction is a query, not a mutation).\n    card.controller = prev_controller\n\n    # Add reductions granted by other permanents the controller controls\n    # (e.g. an Elder Dragon granting affinity to all your instants/sorceries).\n    for permanent in list(controller.zones[Zone.BATTLEFIELD].get_all()):\n        if permanent is card:\n            continue\n        hook = getattr(permanent, \"static_cost_reduction\", None)\n        if hook is None:\n            continue\n        raw += hook(game, card, controller)\n\n    generic = card.mana_cost.generic if card.mana_cost else 0\n    return max(0, min(raw, generic))\n\n\ndef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n    new_generic = max(0, cost.generic - reduction)\n    return ManaCost(\n        generic=new_generic,\n        pips=dict(cost.pips),\n        x_count=cost.x_count,\n        hybrid=list(cost.hybrid),\n    )\n\n\n# ------------------------------------------------------------------\n# Cast spell\n# ------------------------------------------------------------------\n\ndef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n    \"\"\"Cast *card* from *player*'s hand.\n\n    Pipeline\n    --------\n    1. **Timing check** — instants (and cards with flash) can be cast\n       whenever the player has priority; everything else requires\n       sorcery-speed timing.\n    2. **can_cast** — ask the card whether it can legally be cast.\n    3. **Hand check** — the card must be in the player's hand.\n    4. **Move hand → stack zone** — remove the card from the hand and\n       place it into the player's stack zone.\n    5. **Choose targets** — if the card specifies targets (via\n       :meth:`CardImpl.get_targets`), the player is asked to choose.\n    6. **Mana check / payment** — the player's mana pool must be able to\n       pay the card's mana cost.  If payment fails, the card is rolled\n       back from the stack zone to the hand.\n    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n    8. **Push StackObject** — push a :class:`StackObject` whose\n       ``on_resolve`` callback handles resolution.\n\n    Raises:\n        CastingError: If any legality check fails.\n    \"\"\"\n    # 1. Timing\n    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n        )\n\n    # 2. can_cast\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 3. Hand check\n    hand = game.get_hand(player)\n    if not hand.contains(card):\n        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n\n    # 4. Move card from hand to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    hand.remove(card)\n    stack_zone.add(card)\n\n    # Clear any stale colors_spent from a prior cast before new payment.\n    if hasattr(card, \"colors_spent\"):\n        del card.colors_spent\n\n    # 5. Choose targets\n    target_specs = card.get_targets(game)\n    chosen_targets: list[Any] = []\n    if target_specs:\n        for spec in target_specs:\n            target = player.choose_target(target_specs, spec)\n            # Validate against filter_fn if the spec provides one\n            filter_fn = getattr(spec, \"filter_fn\", None)\n            if filter_fn is not None and target is not None:\n                if not filter_fn(target):\n                    stack_zone.remove(card)\n                    hand.add(card)\n                    raise CastingError(\n                        f\"Cannot cast {card.name!r} — chosen target does not \"\n                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                    )\n            chosen_targets.append(target)\n\n    # 5b. Protection check — reject targets that have protection from this\n    #     spell (the T in DEBT).\n    from engine.protection import has_protection_from\n\n    for target in chosen_targets:\n        if has_protection_from(target, card):\n            # Rollback: move card from stack zone back to hand\n            stack_zone.remove(card)\n            hand.add(card)\n            raise CastingError(\n                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n            )\n\n    # Targets are stored on the StackObject (not the card) and passed\n    # through the resolve pipeline via on_resolve(game, targets=...).\n\n    # 6. Mana check / payment (rollback on failure)\n    # Ensure the card knows its controller so that cost_reduction() hooks\n    # (e.g. Embercleave counting attacking creatures you control) see the\n    # casting player, even for cards that were added to hand without an\n    # explicit controller assignment.\n    if card.controller is None:\n        card.controller = player\n    reduction = get_cost_reduction(game, card, player)\n    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n\n    if not player.mana_pool.can_pay(effective_cost):\n        # Rollback: move card from stack zone back to hand\n        stack_zone.remove(card)\n        hand.add(card)\n        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n\n    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n    total_before = player.mana_pool.total()\n    player.mana_pool.pay(effective_cost)\n    # Record total mana spent for mechanics that care (e.g. Mana Sculpt).\n    card.mana_spent = total_before - player.mana_pool.total()  # type: ignore[attr-defined]\n\n    # Store colors of mana spent on the card for mechanics like Converge\n    # that care about the colors used to cast the spell.\n    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n\n    # 7. Call on_cast hook\n    card.on_cast(game)\n\n    # 8. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n    # Casualty: before the spell is announced as fully cast, additional-cost\n    # grants (e.g. an Elder Dragon giving your spells casualty N) may copy it.\n    _apply_casualty(game, card, player, stack_obj)\n\n    # Fire the spell-cast trigger (no-op when nothing is watching).\n    from engine.events import SpellCastTriggeredEvent\n\n    game.trigger_manager.fire_event(\n        game,\n        SpellCastTriggeredEvent(\n            spell=stack_obj, player=player, card=card, controller=player\n        ),\n    )\n\n\n# ------------------------------------------------------------------\n# Cast spell without paying mana cost (free-cast from any zone)\n# ------------------------------------------------------------------\n\n\ndef cast_spell_free(\n    game: GameState,\n    player: Player,\n    card: CardImpl,\n    from_zone: Zone,\n) -> None:\n    \"\"\"Cast *card* without paying its mana cost, using the stack.\n\n    This is used by effects that allow casting from zones other than hand\n    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n    or cascade.\n\n    Pipeline\n    --------\n    1. **can_cast** — ask the card whether it can legally be cast (same\n       legality as :func:`cast_spell`, minus mana/timing constraints).\n    2. Move *card* from *from_zone* to the stack zone.\n    3. Choose targets (if applicable) with validation and protection check.\n    4. Call ``on_cast`` hook.\n    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n       resolution normally (permanents → battlefield, non-permanents →\n       graveyard).\n\n    No timing check or mana payment is performed.  The spell goes on the\n    stack and can be responded to normally (e.g. countered).\n\n    If targeting or other post-move checks fail, the card is rolled back\n    to its source zone.\n\n    Parameters:\n        game: The current game state.\n        player: The player casting the spell.\n        card: The card to cast.\n        from_zone: The zone the card is currently in.\n\n    Raises:\n        CastingError: If the card cannot be found in *from_zone* or\n            legality checks fail.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Ensure controller is set\n    card.controller = player\n    if card.owner is None:\n        card.owner = player\n\n    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 2. Locate card in source zone\n    source_zone_container = player.zones[from_zone]\n    if not source_zone_container.contains(card):\n        # Try to find the card in any player's zone\n        source_zone_container = None\n        for p in game.players:\n            z = p.zones[from_zone]\n            if z.contains(card):\n                source_zone_container = z\n                break\n\n    if source_zone_container is None or not source_zone_container.contains(card):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n        )\n\n    # Move card from source zone to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    source_zone_container.remove(card)\n    stack_zone.add(card)\n\n    # 3. Choose targets (with rollback on failure)\n    try:\n        target_specs = card.get_targets(game)\n        chosen_targets: list[Any] = []\n        if target_specs:\n            for spec in target_specs:\n                target = player.choose_target(target_specs, spec)\n                # Validate against filter_fn if the spec provides one\n                filter_fn = getattr(spec, \"filter_fn\", None)\n                if filter_fn is not None and target is not None:\n                    if not filter_fn(target):\n                        raise CastingError(\n                            f\"Cannot cast {card.name!r} — chosen target does not \"\n                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                        )\n                chosen_targets.append(target)\n\n        # Protection check — reject targets that have protection from this spell\n        from engine.protection import has_protection_from\n\n        for target in chosen_targets:\n            if has_protection_from(target, card):\n                raise CastingError(\n                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n                )\n    except Exception as exc:\n        # Rollback: move card from stack zone back to source zone\n        stack_zone.remove(card)\n        source_zone_container.add(card)\n        raise CastingError(str(exc)) from exc\n\n    # No mana is paid for a free cast.\n    card.mana_spent = 0  # type: ignore[attr-defined]\n\n    # 4. Call on_cast hook\n    card.on_cast(game)\n\n    # 5. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n    # Casting for free still counts as casting — fire the cast trigger.\n    from engine.events import SpellCastTriggeredEvent\n\n    game.trigger_manager.fire_event(\n        game,\n        SpellCastTriggeredEvent(\n            spell=stack_obj, player=player, card=card, controller=player\n        ),\n    )\n\n\n# ------------------------------------------------------------------\n# Casualty (additional-cost grant: sacrifice a creature, copy the spell)\n# ------------------------------------------------------------------\n\ndef _apply_casualty(\n    game: GameState,\n    card: CardImpl,\n    controller: Player,\n    stack_obj: StackObject,\n) -> None:\n    \"\"\"Apply casualty if any permanent grants it to *card*.\n\n    Casualty N: as the spell is cast, its controller may sacrifice a\n    creature with power N or greater; when they do, a copy of the spell is\n    put onto the stack.  Only instants and sorceries are eligible here.\n\n    The casualty value is sourced from permanents that expose a\n    ``grants_casualty(game, card, controller) -> int`` hook (e.g. an Elder\n    Dragon granting casualty 1 to all your instant/sorcery spells).\n    \"\"\"\n    if not (card.card_types & {CardType.INSTANT, CardType.SORCERY}):\n        return\n\n    n = 0\n    for permanent in list(controller.zones[Zone.BATTLEFIELD].get_all()):\n        hook = getattr(permanent, \"grants_casualty\", None)\n        if hook is None:\n            continue\n        n = max(n, hook(game, card, controller))\n\n    if n <= 0:\n        return\n\n    eligible = [\n        c for c in controller.zones[Zone.BATTLEFIELD].get_all()\n        if c is not card\n        and CardType.CREATURE in getattr(c, \"card_types\", set())\n        and getattr(c, \"power\", 0) >= n\n    ]\n    if not eligible:\n        return\n\n    if not controller.choose_yes_no(f\"Pay casualty {n} (sacrifice a creature)?\"):\n        return\n\n    chosen = controller.choose(\n        eligible, f\"choose creature to sacrifice for casualty {n}\"\n    )\n    if chosen is None or chosen not in eligible:\n        return\n\n    from engine.game import sacrifice\n    from engine.stack import copy_spell\n\n    sacrifice(game, controller, chosen)\n    copy_obj = copy_spell(game, stack_obj, controller)\n    game.stack.push(copy_obj)\n\n\n# ------------------------------------------------------------------\n# Resolution (called when the stack pops)\n# ------------------------------------------------------------------\n\ndef _resolve_spell(\n    game: GameState,\n    card: CardImpl,\n    player: Player,\n    stack_obj: StackObject,\n) -> None:\n    \"\"\"Resolve *card* cast by *player*.\n\n    1. Call ``card.on_resolve(game, targets=targets)``.\n    2. Remove the card from the stack zone.\n    3. If the card is a permanent type, move it to the battlefield via\n       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n       registration and the ETB event).\n    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Read targets from the StackObject — the single source of truth.\n    # Set chosen_targets on the card just before resolution so that\n    # _get_chosen_target helpers (which read via getattr) work.\n    targets = stack_obj.targets\n    if targets is not None:\n        card.chosen_targets = targets  # type: ignore[attr-defined]\n\n    card.on_resolve(game)\n\n    if card.card_types & _PERMANENT_TYPES:\n        # Move from stack to battlefield via move_to_zone, which handles\n        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n    elif getattr(card, \"_exile_instead_of_graveyard\", False):\n        # Some effects exile an instant/sorcery instead of using the graveyard.\n        move_to_zone(game, card, Zone.STACK, Zone.EXILE)\n    else:\n        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n\n\n# ------------------------------------------------------------------\n# Play land (special action — does not use the stack)\n# ------------------------------------------------------------------\n\ndef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n\n    Requirements (all must hold):\n\n    * *land_card* has :attr:`CardType.LAND`.\n    * *player* is the active player.\n    * Current phase is a main phase.\n    * The stack is empty.\n    * ``player.land_plays_remaining > 0``.\n    * The card is in the player's hand.\n\n    On success the card moves from hand to battlefield and\n    ``land_plays_remaining`` is decremented.\n\n    Raises:\n        CastingError: If any requirement is not met.\n    \"\"\"\n    # Must be a land\n    if CardType.LAND not in land_card.card_types:\n        raise CastingError(\n            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n        )\n\n    # Sorcery-speed timing (active player, main phase, stack empty)\n    if not is_sorcery_speed(game, player):\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — must be active player \"\n            \"during main phase with empty stack\"\n        )\n\n    # Land plays remaining\n    if player.land_plays_remaining <= 0:\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n        )\n\n    # Card must be in hand\n    hand = game.get_hand(player)\n    if not hand.contains(land_card):\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — card not in hand\"\n        )\n\n    # Ensure owner/controller are set so move_to_zone routes correctly.\n    if land_card.owner is None:\n        land_card.owner = player\n    land_card.controller = player\n\n    # Move from hand to battlefield via move_to_zone, which fires\n    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n    from engine.zones import move_to_zone\n    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n\n    # Decrement land plays\n    player.land_plays_remaining -= 1\n\n\ndef resolve_top(game: GameState) -> None:\n    \"\"\"Resolve the top spell/ability on the stack.\n\n    Pops the top item from the stack, calls its on_resolve callback,\n    then runs state-based actions.  If the stack is empty this is a no-op.\n    \"\"\"\n    if game.stack.is_empty():\n        return\n    from engine.state_based_actions import resolve_state_based_actions\n\n    obj = game.stack.pop()\n    obj.on_resolve(game)\n    resolve_state_based_actions(game)\n","numLines":591,"startLine":1,"totalLines":591}}}
