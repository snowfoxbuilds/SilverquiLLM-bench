{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014ZYyUR1GTkHBbmbic7aCCb","type":"tool_result","content":"240\t        # After countering, the spell should NOT be on the battlefield\n241\t        assert not game.get_battlefield(player).contains(spell)\n242\t\n243\t    def test_multiple_free_casts_all_go_on_stack(self):\n244\t        \"\"\"When multiple spells are cast for free, all should be on the stack.\n245\t\n246\t        This allows an opponent to counter any of them individually.\n247\t        \"\"\"\n248\t        game = _make_game()\n249\t        player = game.players[0]\n250\t        spell_a = Sorcery(name=\"Spell A\", mana_cost=ManaCost(generic=1))\n251\t        spell_b = Creature(\n252\t            name=\"Spell B\",\n253\t            mana_cost=ManaCost(generic=2),\n254\t            base_power=2, base_toughness=2,\n255\t        )\n256\t        _put_in_exile(game, 0, spell_a)\n257\t        _put_in_exile(game, 0, spell_b)\n258\t\n259\t        cast_spell_free(game, player, spell_a, from_zone=Zone.EXILE)\n260\t        cast_spell_free(game, player, spell_b, from_zone=Zone.EXILE)\n261\t\n262\t        assert len(game.stack) == 2\n263\t\n264\t    def test_countered_spell_does_not_resolve(self):\n265\t        \"\"\"A spell removed from the stack (countered) should not call on_resolve.\"\"\"\n266\t        game = _make_game()\n267\t        player = game.players[0]\n268\t        resolved_flag = []\n269\t\n270\t        class TrackerCreature(Creature):\n271\t            def on_resolve(self, game):\n272\t                resolved_flag.append(True)\n273\t\n274\t        critter = TrackerCreature(\n275\t            name=\"Tracker Beast\",\n276\t            mana_cost=ManaCost(generic=3, pips={ManaType.GREEN: 1}),\n277\t            base_power=4, base_toughness=4,\n278\t        )\n279\t        _put_in_exile(game, 0, critter)\n280\t\n281\t        cast_spell_free(game, player, critter, from_zone=Zone.EXILE)\n282\t\n283\t        # Counter it — just pop without calling on_resolve\n284\t        game.stack.pop()\n285\t\n286\t        assert resolved_flag == []\n287\t        assert not game.get_battlefield(player).contains(critter)\n288\t\n289\t\n290\t# ---------------------------------------------------------------------------\n291\t# Tests: Real counterspell integration\n292\t# ---------------------------------------------------------------------------\n293\t\n294\tclass TestCastSpellFreeCounteredByRealCounter:\n295\t    \"\"\"Integration tests using the engine's _counter_spell mechanic.\n296\t\n297\t    These prove that a Counterspell-style effect can properly target and\n298\t    counter a spell placed on the stack via cast_spell_free.\n299\t    \"\"\"\n300\t\n301\t    def test_counter_spell_removes_free_cast_from_stack_to_graveyard(self):\n302\t        \"\"\"_counter_spell targeting a free-cast spell removes it and moves card to graveyard.\"\"\"\n303\t        from cards.fdn.fdn_160.card_impl import _counter_spell\n304\t\n305\t        game = _make_game()\n306\t        player = game.players[0]\n307\t        spell = Sorcery(\n308\t            name=\"Explosive Vegetation\",\n309\t            mana_cost=ManaCost(generic=3, pips={ManaType.GREEN: 1}),\n310\t        )\n311\t        spell.owner = player\n312\t        _put_in_exile(game, 0, spell)\n313\t\n314\t        cast_spell_free(game, player, spell, from_zone=Zone.EXILE)\n315\t\n316\t        # The spell is on the stack\n317\t        assert not game.stack.is_empty()\n318\t        stack_obj = game.stack.peek()\n319\t        assert stack_obj.source is spell\n320\t\n321\t        # Use the real _counter_spell function to counter it\n322\t        _counter_spell(game, stack_obj)\n323\t\n324\t        # After countering: stack is empty, spell is in owner's graveyard\n325\t        assert game.stack.is_empty()\n326\t        assert game.get_graveyard(player).contains(spell)\n327\t        assert not game.get_battlefield(player).contains(spell)\n328\t\n329\t    def test_counter_spell_prevents_on_resolve_from_firing(self):\n330\t        \"\"\"A countered free-cast spell's on_resolve never executes.\"\"\"\n331\t        from cards.fdn.fdn_160.card_impl import _counter_spell\n332\t\n333\t        game = _make_game()\n334\t        player = game.players[0]\n335\t        resolved_flag = []\n336\t\n337\t        class TrackerSorcery(Sorcery):\n338\t            def on_resolve(self, game):\n339\t                resolved_flag.append(True)\n340\t\n341\t        spell = TrackerSorcery(\n342\t            name=\"Tracked Spell\",\n343\t            mana_cost=ManaCost(generic=2, pips={ManaType.BLUE: 1}),\n344\t        )\n345\t        spell.owner = player\n346\t        _put_in_exile(game, 0, spell)\n347\t\n348\t        cast_spell_free(game, player, spell, from_zone=Zone.EXILE)\n349\t        stack_obj = game.stack.peek()\n350\t\n351\t        # Counter it using the real counter mechanic\n352\t        _counter_spell(game, stack_obj)\n353\t\n354\t        # on_resolve should never have been called\n355\t        assert resolved_flag == []\n356\t\n357\t    def test_counter_creature_free_cast_prevents_battlefield_entry(self):\n358\t        \"\"\"A creature countered after cast_spell_free never enters the battlefield.\"\"\"\n359\t        from cards.fdn.fdn_160.card_impl import _counter_spell\n360\t\n361\t        game = _make_game()\n362\t        player = game.players[0]\n363\t        creature = Creature(\n364\t            name=\"Colossal Dreadmaw\",\n365\t            mana_cost=ManaCost(generic=4, pips={ManaType.GREEN: 2}),\n366\t            base_power=6, base_toughness=6,\n367\t        )\n368\t        creature.owner = player\n369\t        _put_in_exile(game, 0, creature)\n370\t\n371\t        cast_spell_free(game, player, creature, from_zone=Zone.EXILE)\n372\t        stack_obj = game.stack.peek()\n373\t\n374\t        _counter_spell(game, stack_obj)\n375\t\n376\t        # Creature should be in graveyard, not battlefield\n377\t        assert game.stack.is_empty()\n378\t        assert game.get_graveyard(player).contains(creature)\n379\t        assert not game.get_battlefield(player).contains(creature)\n380\t\n381\t    def test_counter_targets_specific_spell_among_multiple_on_stack(self):\n382\t        \"\"\"When multiple free-cast spells are on the stack, counter targets only one.\"\"\"\n383\t        from cards.fdn.fdn_160.card_impl import _counter_spell\n384\t\n385\t        game = _make_game()\n386\t        player = game.players[0]\n387\t\n388\t        spell_a = Sorcery(name=\"Spell A\", mana_cost=ManaCost(generic=1))\n389\t        spell_a.owner = player\n390\t        spell_b = Sorcery(name=\"Spell B\", mana_cost=ManaCost(generic=2))\n391\t        spell_b.owner = player\n392\t\n393\t        _put_in_exile(game, 0, spell_a)\n394\t        _put_in_exile(game, 0, spell_b)\n395\t\n396\t        cast_spell_free(game, player, spell_a, from_zone=Zone.EXILE)\n397\t        cast_spell_free(game, player, spell_b, from_zone=Zone.EXILE)\n398\t\n399\t        assert len(game.stack) == 2\n400\t\n401\t        # Counter only spell_a (the bottom spell)\n402\t        # Find its stack object\n403\t        all_objs = game.stack.objects()\n404\t        spell_a_obj = next(obj for obj in all_objs if obj.source is spell_a)\n405\t\n406\t        _counter_spell(game, spell_a_obj)\n407\t\n408\t        # Only spell_a countered; spell_b remains on stack\n409\t        assert len(game.stack) == 1\n410\t        assert game.stack.peek().source is spell_b\n411\t        assert game.get_graveyard(player).contains(spell_a)\n412\t        assert not game.get_graveyard(player).contains(spell_b)\n413\t"}]},"parent_tool_use_id":null,"session_id":"735f529e-7bc8-4328-a211-d2f095818fd0","uuid":"7c90ade7-4dcd-4e77-a0cc-1585e6e27953","timestamp":"2026-06-04T10:01:52.685Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine_tests/test_cast_spell_free.py","content":"        # After countering, the spell should NOT be on the battlefield\n        assert not game.get_battlefield(player).contains(spell)\n\n    def test_multiple_free_casts_all_go_on_stack(self):\n        \"\"\"When multiple spells are cast for free, all should be on the stack.\n\n        This allows an opponent to counter any of them individually.\n        \"\"\"\n        game = _make_game()\n        player = game.players[0]\n        spell_a = Sorcery(name=\"Spell A\", mana_cost=ManaCost(generic=1))\n        spell_b = Creature(\n            name=\"Spell B\",\n            mana_cost=ManaCost(generic=2),\n            base_power=2, base_toughness=2,\n        )\n        _put_in_exile(game, 0, spell_a)\n        _put_in_exile(game, 0, spell_b)\n\n        cast_spell_free(game, player, spell_a, from_zone=Zone.EXILE)\n        cast_spell_free(game, player, spell_b, from_zone=Zone.EXILE)\n\n        assert len(game.stack) == 2\n\n    def test_countered_spell_does_not_resolve(self):\n        \"\"\"A spell removed from the stack (countered) should not call on_resolve.\"\"\"\n        game = _make_game()\n        player = game.players[0]\n        resolved_flag = []\n\n        class TrackerCreature(Creature):\n            def on_resolve(self, game):\n                resolved_flag.append(True)\n\n        critter = TrackerCreature(\n            name=\"Tracker Beast\",\n            mana_cost=ManaCost(generic=3, pips={ManaType.GREEN: 1}),\n            base_power=4, base_toughness=4,\n        )\n        _put_in_exile(game, 0, critter)\n\n        cast_spell_free(game, player, critter, from_zone=Zone.EXILE)\n\n        # Counter it — just pop without calling on_resolve\n        game.stack.pop()\n\n        assert resolved_flag == []\n        assert not game.get_battlefield(player).contains(critter)\n\n\n# ---------------------------------------------------------------------------\n# Tests: Real counterspell integration\n# ---------------------------------------------------------------------------\n\nclass TestCastSpellFreeCounteredByRealCounter:\n    \"\"\"Integration tests using the engine's _counter_spell mechanic.\n\n    These prove that a Counterspell-style effect can properly target and\n    counter a spell placed on the stack via cast_spell_free.\n    \"\"\"\n\n    def test_counter_spell_removes_free_cast_from_stack_to_graveyard(self):\n        \"\"\"_counter_spell targeting a free-cast spell removes it and moves card to graveyard.\"\"\"\n        from cards.fdn.fdn_160.card_impl import _counter_spell\n\n        game = _make_game()\n        player = game.players[0]\n        spell = Sorcery(\n            name=\"Explosive Vegetation\",\n            mana_cost=ManaCost(generic=3, pips={ManaType.GREEN: 1}),\n        )\n        spell.owner = player\n        _put_in_exile(game, 0, spell)\n\n        cast_spell_free(game, player, spell, from_zone=Zone.EXILE)\n\n        # The spell is on the stack\n        assert not game.stack.is_empty()\n        stack_obj = game.stack.peek()\n        assert stack_obj.source is spell\n\n        # Use the real _counter_spell function to counter it\n        _counter_spell(game, stack_obj)\n\n        # After countering: stack is empty, spell is in owner's graveyard\n        assert game.stack.is_empty()\n        assert game.get_graveyard(player).contains(spell)\n        assert not game.get_battlefield(player).contains(spell)\n\n    def test_counter_spell_prevents_on_resolve_from_firing(self):\n        \"\"\"A countered free-cast spell's on_resolve never executes.\"\"\"\n        from cards.fdn.fdn_160.card_impl import _counter_spell\n\n        game = _make_game()\n        player = game.players[0]\n        resolved_flag = []\n\n        class TrackerSorcery(Sorcery):\n            def on_resolve(self, game):\n                resolved_flag.append(True)\n\n        spell = TrackerSorcery(\n            name=\"Tracked Spell\",\n            mana_cost=ManaCost(generic=2, pips={ManaType.BLUE: 1}),\n        )\n        spell.owner = player\n        _put_in_exile(game, 0, spell)\n\n        cast_spell_free(game, player, spell, from_zone=Zone.EXILE)\n        stack_obj = game.stack.peek()\n\n        # Counter it using the real counter mechanic\n        _counter_spell(game, stack_obj)\n\n        # on_resolve should never have been called\n        assert resolved_flag == []\n\n    def test_counter_creature_free_cast_prevents_battlefield_entry(self):\n        \"\"\"A creature countered after cast_spell_free never enters the battlefield.\"\"\"\n        from cards.fdn.fdn_160.card_impl import _counter_spell\n\n        game = _make_game()\n        player = game.players[0]\n        creature = Creature(\n            name=\"Colossal Dreadmaw\",\n            mana_cost=ManaCost(generic=4, pips={ManaType.GREEN: 2}),\n            base_power=6, base_toughness=6,\n        )\n        creature.owner = player\n        _put_in_exile(game, 0, creature)\n\n        cast_spell_free(game, player, creature, from_zone=Zone.EXILE)\n        stack_obj = game.stack.peek()\n\n        _counter_spell(game, stack_obj)\n\n        # Creature should be in graveyard, not battlefield\n        assert game.stack.is_empty()\n        assert game.get_graveyard(player).contains(creature)\n        assert not game.get_battlefield(player).contains(creature)\n\n    def test_counter_targets_specific_spell_among_multiple_on_stack(self):\n        \"\"\"When multiple free-cast spells are on the stack, counter targets only one.\"\"\"\n        from cards.fdn.fdn_160.card_impl import _counter_spell\n\n        game = _make_game()\n        player = game.players[0]\n\n        spell_a = Sorcery(name=\"Spell A\", mana_cost=ManaCost(generic=1))\n        spell_a.owner = player\n        spell_b = Sorcery(name=\"Spell B\", mana_cost=ManaCost(generic=2))\n        spell_b.owner = player\n\n        _put_in_exile(game, 0, spell_a)\n        _put_in_exile(game, 0, spell_b)\n\n        cast_spell_free(game, player, spell_a, from_zone=Zone.EXILE)\n        cast_spell_free(game, player, spell_b, from_zone=Zone.EXILE)\n\n        assert len(game.stack) == 2\n\n        # Counter only spell_a (the bottom spell)\n        # Find its stack object\n        all_objs = game.stack.objects()\n        spell_a_obj = next(obj for obj in all_objs if obj.source is spell_a)\n\n        _counter_spell(game, spell_a_obj)\n\n        # Only spell_a countered; spell_b remains on stack\n        assert len(game.stack) == 1\n        assert game.stack.peek().source is spell_b\n        assert game.get_graveyard(player).contains(spell_a)\n        assert not game.get_graveyard(player).contains(spell_b)\n","numLines":174,"startLine":240,"totalLines":413}}}
