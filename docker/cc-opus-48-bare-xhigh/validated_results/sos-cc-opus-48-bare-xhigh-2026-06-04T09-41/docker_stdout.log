{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0178NGVE5wSWcStLXrMXDZht","type":"tool_result","content":"1\t\"\"\"Combat system: declare attackers → declare blockers → damage → end combat.\n2\t\n3\tImplements the four substeps of the MTG combat phase:\n4\t\n5\t1. **Declare Attackers** — Active player chooses creatures to attack with.\n6\t   Attackers are tapped (unless they have vigilance).  Creatures with\n7\t   summoning sickness (without haste) or the defender keyword cannot attack.\n8\t\n9\t2. **Declare Blockers** — Defending player assigns blockers.  Creatures\n10\t   with flying can only be blocked by creatures with flying or reach.\n11\t   Creatures with menace require 2+ blockers.  The attacker's controller\n12\t   orders the blockers for damage assignment.\n13\t\n14\t3. **Combat Damage** — First strike / double strike creatures deal damage\n15\t   first, then state-based actions are checked, then normal damage.\n16\t   Trample excess goes to the defending player.  Lifelink heals the\n17\t   controller.  Deathtouch makes any nonzero damage lethal.  Unblocked\n18\t   attackers deal damage to the defending player.\n19\t\n20\t4. **End Combat** — Clear all combat state.\n21\t\n22\tReferences: MTG Comprehensive Rules §506–§511.\n23\t\"\"\"\n24\t\n25\tfrom __future__ import annotations\n26\t\n27\tfrom dataclasses import dataclass, field\n28\tfrom typing import TYPE_CHECKING, Any\n29\t\n30\tfrom engine.types import Keyword\n31\t\n32\tif TYPE_CHECKING:\n33\t    from engine.game_state import GameState\n34\t    from engine.player import Player\n35\t\n36\t\n37\t# ---------------------------------------------------------------------------\n38\t# CombatState — tracks all per-combat information\n39\t# ---------------------------------------------------------------------------\n40\t\n41\t@dataclass\n42\tclass CombatState:\n43\t    \"\"\"Tracks attackers, blockers, damage assignments, and block ordering.\n44\t\n45\t    Attributes:\n46\t        attackers: Mapping of attacking creature → defending player.\n47\t        blockers: Mapping of blocking creature → list of attackers it blocks.\n48\t        attacker_blockers: Mapping of attacking creature → ordered list of\n49\t            blockers assigned to it (order used for damage assignment).\n50\t        damage_assignments: Mapping of creature → list of\n51\t            ``(target, amount)`` tuples describing how damage is assigned.\n52\t        was_blocked: Set of attackers that were declared as blocked.  Per\n53\t            MTG rule 509.1h, once a creature is blocked it stays blocked\n54\t            even if all its blockers are removed before damage.\n55\t        in_combat: Whether the combat phase is currently active.\n56\t    \"\"\"\n57\t\n58\t    attackers: dict[Any, Player] = field(default_factory=dict)\n59\t    blockers: dict[Any, list[Any]] = field(default_factory=dict)\n60\t    attacker_blockers: dict[Any, list[Any]] = field(default_factory=dict)\n61\t    damage_assignments: dict[Any, list[tuple[Any, int]]] = field(default_factory=dict)\n62\t    was_blocked: set[Any] = field(default_factory=set)\n63\t    in_combat: bool = False\n64\t\n65\t    def clear(self) -> None:\n66\t        \"\"\"Reset all combat state.\"\"\"\n67\t        self.attackers.clear()\n68\t        self.blockers.clear()\n69\t        self.attacker_blockers.clear()\n70\t        self.damage_assignments.clear()\n71\t        self.was_blocked.clear()\n72\t        self.in_combat = False\n73\t\n74\t\n75\t# ---------------------------------------------------------------------------\n76\t# Helpers\n77\t# ---------------------------------------------------------------------------\n78\t\n79\tdef _can_attack(creature: Any) -> bool:\n80\t    \"\"\"Return ``True`` if *creature* is eligible to be declared as an attacker.\n81\t\n82\t    A creature cannot attack if:\n83\t    - It is already tapped.\n84\t    - It has the ``DEFENDER`` keyword.\n85\t    - It has summoning sickness (``summoning_sick``) and does not have ``HASTE``.\n86\t    - A continuous effect has set ``_cant_attack`` (e.g. Pacifism).\n87\t    \"\"\"\n88\t    if getattr(creature, \"is_tapped\", False):\n89\t        return False\n90\t\n91\t    # Check for \"can't attack\" restriction (set by continuous effects like Pacifism)\n92\t    if getattr(creature, \"_cant_attack\", False):\n93\t        return False\n94\t\n95\t    keywords = getattr(creature, \"keywords\", Keyword(0))\n96\t\n97\t    if Keyword.DEFENDER in keywords:\n98\t        return False\n99\t\n100\t    if getattr(creature, \"summoning_sick\", False) and Keyword.HASTE not in keywords:\n101\t        return False\n102\t\n103\t    return True\n104\t\n105\t\n106\tdef _can_block(blocker: Any, attacker: Any) -> bool:\n107\t    \"\"\"Return ``True`` if *blocker* can legally block *attacker*.\n108\t\n109\t    Checks:\n110\t    - If the blocker is tapped it cannot block.\n111\t    - A continuous effect has set ``_cant_block`` (e.g. Pacifism).\n112\t    - If the attacker has flying, the blocker must have flying or reach.\n113\t    \"\"\"\n114\t    if getattr(blocker, \"is_tapped\", False):\n115\t        return False\n116\t\n117\t    # Check for \"can't block\" restriction (set by continuous effects like Pacifism)\n118\t    if getattr(blocker, \"_cant_block\", False):\n119\t        return False\n120\t\n121\t    attacker_kw = getattr(attacker, \"keywords\", Keyword(0))\n122\t    blocker_kw = getattr(blocker, \"keywords\", Keyword(0))\n123\t\n124\t    # Flying check\n125\t    if Keyword.FLYING in attacker_kw:\n126\t        if Keyword.FLYING not in blocker_kw and Keyword.REACH not in blocker_kw:\n127\t            return False\n128\t\n129\t    # Protection check — attacker with protection from blocker can't be blocked\n130\t    from engine.protection import has_protection_from\n131\t\n132\t    if has_protection_from(attacker, blocker):\n133\t        return False\n134\t\n135\t    return True\n136\t\n137\t\n138\tdef _get_lethal_damage(creature: Any, attacker: Any | None = None) -> int:\n139\t    \"\"\"Return the amount of damage needed to lethally assign to *creature*.\n140\t\n141\t    If *attacker* has deathtouch, 1 damage is lethal.\n142\t    Otherwise it's ``toughness - damage_marked`` (at least 1).\n143\t    \"\"\"\n144\t    if attacker is not None:\n145\t        attacker_kw = getattr(attacker, \"keywords\", Keyword(0))\n146\t        if Keyword.DEATHTOUCH in attacker_kw:\n147\t            return 1\n148\t\n149\t    toughness = getattr(creature, \"toughness\", 0)\n150\t    damage_marked = getattr(creature, \"damage_marked\", 0)\n151\t    return max(1, toughness - damage_marked)\n152\t\n153\t\n154\tdef _deal_damage(\n155\t    source: Any,\n156\t    target: Any,\n157\t    amount: int,\n158\t    game: GameState,\n159\t    combat_state: CombatState,\n160\t) -> None:\n161\t    \"\"\"Apply *amount* damage from *source* to *target*.\n162\t\n163\t    If *target* is a player, reduces life.\n164\t    If *target* is a creature, marks damage on it.\n165\t    If *source* has lifelink, the controller gains that much life.\n166\t\n167\t    Protection prevents damage from sources with the protected-from quality.\n168\t    \"\"\"\n169\t    if amount <= 0:\n170\t        return\n171\t\n172\t    # Protection prevents damage (D in DEBT).\n173\t    from engine.protection import has_protection_from\n174\t\n175\t    if has_protection_from(target, source):\n176\t        return\n177\t\n178\t    # Record damage assignment\n179\t    if source not in combat_state.damage_assignments:\n180\t        combat_state.damage_assignments[source] = []\n181\t    combat_state.damage_assignments[source].append((target, amount))\n182\t\n183\t    # Apply damage\n184\t    if hasattr(target, \"life\"):\n185\t        # Target is a player\n186\t        target.life -= amount\n187\t    elif hasattr(target, \"damage_marked\"):\n188\t        # Target is a creature\n189\t        target.damage_marked += amount\n190\t\n191\t        # Track deathtouch damage for SBA rule 704.5h\n192\t        source_kw_dt = getattr(source, \"keywords\", Keyword(0))\n193\t        if Keyword.DEATHTOUCH in source_kw_dt:\n194\t            target.dealt_deathtouch_damage = True\n195\t\n196\t    # Lifelink: controller gains life equal to damage dealt\n197\t    source_kw = getattr(source, \"keywords\", Keyword(0))\n198\t    if Keyword.LIFELINK in source_kw:\n199\t        controller = getattr(source, \"controller\", None)\n200\t        if controller is not None and hasattr(controller, \"life\"):\n201\t            controller.life += amount\n202\t\n203\t\n204\t# ---------------------------------------------------------------------------\n205\t# Combat steps\n206\t# ---------------------------------------------------------------------------\n207\t\n208\tdef declare_attackers_step(game: GameState) -> None:\n209\t    \"\"\"Declare attackers step: active player chooses creatures to attack with.\n210\t\n211\t    The active player is asked (via :meth:`Player.choose`) to select a set\n212\t    of creatures to attack with.  Each chosen attacker is tapped (unless it\n213\t    has vigilance) and its ``is_attacking`` flag is set.\n214\t\n215\t    Parameters:\n216\t        game: The current game state.  ``game.combat_state`` must exist.\n217\t    \"\"\"\n218\t    combat = game.combat_state\n219\t    combat.in_combat = True\n220\t    active = game.active_player\n221\t    defending = game.non_active_player\n222\t\n223\t    # Gather legal attackers from the active player's battlefield\n224\t    from engine.types import Zone\n225\t    bf = active.zones[Zone.BATTLEFIELD]\n226\t    eligible = [\n227\t        c for c in bf.get_all()\n228\t        if hasattr(c, \"base_power\") and _can_attack(c)\n229\t    ]\n230\t\n231\t    if not eligible:\n232\t        return\n233\t\n234\t    # Active player chooses which creatures to attack with\n235\t    chosen = active.choose(eligible, \"declare attackers\")\n236\t\n237\t    # Normalize to a list\n238\t    if chosen is None:\n239\t        return\n240\t    if not isinstance(chosen, list):\n241\t        chosen = [chosen]\n242\t\n243\t    # Validate and register attackers\n244\t    for attacker in chosen:\n245\t        if attacker not in eligible:\n246\t            continue\n247\t        if not _can_attack(attacker):\n248\t            continue\n249\t\n250\t        combat.attackers[attacker] = defending\n251\t        combat.attacker_blockers[attacker] = []\n252\t        attacker.is_attacking = True\n253\t\n254\t        # Tap the attacker unless it has vigilance\n255\t        kw = getattr(attacker, \"keywords\", Keyword(0))\n256\t        if Keyword.VIGILANCE not in kw:\n257\t            attacker.is_tapped = True\n258\t\n259\t\n260\tdef declare_blockers_step(game: GameState) -> None:\n261\t    \"\"\"Declare blockers step: defending player assigns blockers.\n262\t\n263\t    The defending player is asked (via :meth:`Player.choose`) to assign\n264\t    blockers.  The expected format is a dict mapping blocker → attacker\n265\t    (or blocker → list of attackers for multi-blocking scenarios), but\n266\t    commonly blocker → attacker.\n267\t\n268\t    After blockers are assigned:\n269\t    - Menace check: attackers with menace must be blocked by 2+ creatures.\n270\t    - Flying/reach check is already handled by ``_can_block``.\n271\t    - The attacking player orders blockers for each attacker (for damage\n272\t      assignment).\n273\t\n274\t    Parameters:\n275\t        game: The current game state.\n276\t    \"\"\"\n277\t    combat = game.combat_state\n278\t\n279\t    if not combat.attackers:\n280\t        return\n281\t\n282\t    defending = game.non_active_player\n283\t    active = game.active_player\n284\t\n285\t    from engine.types import Zone\n286\t    bf_defending = defending.zones[Zone.BATTLEFIELD]\n287\t    eligible_blockers = [\n288\t        c for c in bf_defending.get_all()\n289\t        if hasattr(c, \"base_power\") and not getattr(c, \"is_tapped\", False)\n290\t    ]\n291\t\n292\t    if not eligible_blockers:\n293\t        return\n294\t\n295\t    # Defending player chooses block assignments\n296\t    # Expected format: dict mapping blocker → attacker (or list of attackers)\n297\t    block_assignments = defending.choose(\n298\t        eligible_blockers,\n299\t        \"declare blockers\",\n300\t    )\n301\t\n302\t    if block_assignments is None:\n303\t        return\n304\t\n305\t    if not isinstance(block_assignments, dict):\n306\t        return\n307\t\n308\t    # Process block assignments\n309\t    for blocker, target in block_assignments.items():\n310\t        # Validate that the blocker is in the eligible set\n311\t        if blocker not in eligible_blockers:\n312\t            continue\n313\t        targets = target if isinstance(target, list) else [target]\n314\t        valid_targets = []\n315\t        max_blocked = getattr(blocker, \"_max_attackers_blocked\", 1)\n316\t        for attacker in targets:\n317\t            if len(valid_targets) >= max_blocked:\n318\t                break\n319\t            if attacker in combat.attackers and _can_block(blocker, attacker):\n320\t                valid_targets.append(attacker)\n321\t        if valid_targets:\n322\t            combat.blockers[blocker] = valid_targets\n323\t            blocker.is_blocking = True\n324\t            for attacker in valid_targets:\n325\t                if attacker not in combat.attacker_blockers:\n326\t                    combat.attacker_blockers[attacker] = []\n327\t                combat.attacker_blockers[attacker].append(blocker)\n328\t\n329\t    # Menace check: attackers with menace that have fewer than 2 blockers\n330\t    # are treated as unblocked (remove the single blocker assignment).\n331\t    for attacker, blocker_list in list(combat.attacker_blockers.items()):\n332\t        kw = getattr(attacker, \"keywords\", Keyword(0))\n333\t        if Keyword.MENACE in kw and len(blocker_list) < 2 and len(blocker_list) > 0:\n334\t            # Illegal block — remove these blockers\n335\t            for b in blocker_list:\n336\t                if b in combat.blockers:\n337\t                    combat.blockers[b] = [\n338\t                        a for a in combat.blockers[b] if a is not attacker\n339\t                    ]\n340\t                    if not combat.blockers[b]:\n341\t                        del combat.blockers[b]\n342\t                        b.is_blocking = False\n343\t            combat.attacker_blockers[attacker] = []\n344\t\n345\t    # Mark attackers that have at least one blocker as \"was_blocked\".\n346\t    # Per MTG rule 509.1h, once a creature is blocked it remains blocked\n347\t    # even if all its blockers are removed before the damage step.\n348\t    for attacker, blocker_list in combat.attacker_blockers.items():\n349\t        if blocker_list:\n350\t            combat.was_blocked.add(attacker)\n351\t\n352\t    # Controller of each attacker orders the blockers for damage assignment\n353\t    for attacker, blocker_list in combat.attacker_blockers.items():\n354\t        if len(blocker_list) > 1:\n355\t            controller = getattr(attacker, \"controller\", active)\n356\t            ordered = controller.assign_damage_order(blocker_list)\n357\t            combat.attacker_blockers[attacker] = ordered\n358\t\n359\t\n360\tdef combat_damage_step(game: GameState) -> None:\n361\t    \"\"\"Combat damage step: deal combat damage.\n362\t\n363\t    Handles:\n364\t    - First strike / double strike creatures deal damage first.\n365\t    - State-based actions are checked between first-strike and normal damage.\n366\t    - Trample: excess damage over blocker toughness → defending player.\n367\t    - Lifelink: controller gains life equal to damage dealt.\n368\t    - Deathtouch: any damage is lethal (1 damage = lethal assignment).\n369\t    - Unblocked attackers deal damage to defending player.\n370\t\n371\t    Parameters:\n372\t        game: The current game state.\n373\t    \"\"\"\n374\t    from engine.state_based_actions import resolve_state_based_actions\n375\t\n376\t    combat = game.combat_state\n377\t\n378\t    if not combat.attackers:\n379\t        return\n380\t\n381\t    all_attackers = list(combat.attackers.keys())\n382\t\n383\t    # Determine if a first-strike damage sub-step is needed\n384\t    # Check both attackers and blockers for first strike / double strike\n385\t    all_blockers = set()\n386\t    for blocker_list in combat.attacker_blockers.values():\n387\t        all_blockers.update(blocker_list)\n388\t\n389\t    has_first_strike_step = any(\n390\t        Keyword.FIRST_STRIKE in getattr(c, \"keywords\", Keyword(0))\n391\t        or Keyword.DOUBLE_STRIKE in getattr(c, \"keywords\", Keyword(0))\n392\t        for c in list(all_attackers) + list(all_blockers)\n393\t    )\n394\t\n395\t    # --- First strike damage sub-step ---\n396\t    if has_first_strike_step:\n397\t        _assign_combat_damage(all_attackers, combat, game, is_first_strike=True)\n398\t        resolve_state_based_actions(game)\n399\t\n400\t    # --- Normal damage sub-step ---\n401\t    _assign_combat_damage(all_attackers, combat, game, is_first_strike=False)\n402\t    resolve_state_based_actions(game)\n403\t\n404\t\n405\tdef _assign_combat_damage(\n406\t    attackers: list[Any],\n407\t    combat: CombatState,\n408\t    game: GameState,\n409\t    *,\n410\t    is_first_strike: bool = False,\n411\t) -> None:\n412\t    \"\"\"Assign and deal combat damage for a set of attackers.\n413\t\n414\t    For each attacker:\n415\t    - If unblocked → damage to defending player.\n416\t    - If blocked → damage assigned to blockers in order.  With trample,\n417\t      excess damage goes to the defending player.\n418\t    - Blockers deal damage back to the attacker they block.\n419\t\n420\t    When *is_first_strike* is ``True``, only creatures with\n421\t    ``FIRST_STRIKE`` or ``DOUBLE_STRIKE`` deal damage (both attackers\n422\t    and blockers).  When ``False``, only creatures *without*\n423\t    ``FIRST_STRIKE`` deal damage (plus ``DOUBLE_STRIKE`` creatures,\n424\t    which participate in both steps).  Blockers that are no longer on\n425\t    the battlefield (e.g. killed by first-strike damage and removed by\n426\t    SBAs) are skipped.\n427\t    \"\"\"\n428\t    from engine.types import Zone\n429\t\n430\t    # Track which blockers have already dealt their damage this sub-step\n431\t    # (blockers only deal damage once even if blocking multiple attackers)\n432\t    blockers_dealt: set[int] = set()\n433\t\n434\t    for attacker in attackers:\n435\t        if attacker not in combat.attackers:\n436\t            continue\n437\t\n438\t        kw = getattr(attacker, \"keywords\", Keyword(0))\n439\t        has_first = Keyword.FIRST_STRIKE in kw\n440\t        has_double = Keyword.DOUBLE_STRIKE in kw\n441\t\n442\t        # Determine if this attacker deals damage in this sub-step\n443\t        if is_first_strike:\n444\t            attacker_deals = has_first or has_double\n445\t        else:\n446\t            attacker_deals = not has_first or has_double\n447\t\n448\t        # Skip if attacker is no longer on the battlefield\n449\t        if attacker_deals:\n450\t            controller = getattr(attacker, \"controller\", None)\n451\t            if controller is not None:\n452\t                bf = controller.zones[Zone.BATTLEFIELD]\n453\t                if not bf.contains(attacker):\n454\t                    attacker_deals = False\n455\t\n456\t        defending_player = combat.attackers[attacker]\n457\t        blocker_list = combat.attacker_blockers.get(attacker, [])\n458\t        attacker_kw = getattr(attacker, \"keywords\", Keyword(0))\n459\t\n460\t        if attacker_deals:\n461\t            power = getattr(attacker, \"power\", 0)\n462\t\n463\t            # Check if attacker was blocked.  Per MTG rule 509.1h, a blocked\n464\t            # creature stays blocked even if all its blockers are removed.\n465\t            is_blocked = attacker in combat.was_blocked\n466\t\n467\t            if not is_blocked and not blocker_list:\n468\t                # Truly unblocked → damage to defending player\n469\t                _deal_damage(attacker, defending_player, power, game, combat)\n470\t            elif is_blocked and not blocker_list:\n471\t                # Was blocked but all blockers removed.\n472\t                # Without trample: deals no damage.\n473\t                # With trample: all damage tramples to defending player.\n474\t                has_trample = Keyword.TRAMPLE in attacker_kw\n475\t                if has_trample:\n476\t                    _deal_damage(attacker, defending_player, power, game, combat)\n477\t                # else: no damage dealt\n478\t            else:\n479\t                # Blocked → assign damage to blockers in order\n480\t                has_trample = Keyword.TRAMPLE in attacker_kw\n481\t                remaining_damage = power\n482\t\n483\t                for i, blocker in enumerate(blocker_list):\n484\t                    if remaining_damage <= 0:\n485\t                        break\n486\t\n487\t                    lethal = _get_lethal_damage(blocker, attacker)\n488\t\n489\t                    if i < len(blocker_list) - 1:\n490\t                        # Not the last blocker — assign lethal damage\n491\t                        assign = min(lethal, remaining_damage)\n492\t                    else:\n493\t                        # Last blocker\n494\t                        if has_trample:\n495\t                            # With trample: assign lethal, rest tramples through\n496\t                            assign = min(lethal, remaining_damage)\n497\t                        else:\n498\t                            # Without trample: all remaining damage to last blocker\n499\t                            assign = remaining_damage\n500\t\n501\t                    _deal_damage(attacker, blocker, assign, game, combat)\n502\t                    remaining_damage -= assign\n503\t\n504\t                # Trample: excess damage to defending player\n505\t                if has_trample and remaining_damage > 0:\n506\t                    _deal_damage(attacker, defending_player, remaining_damage, game, combat)\n507\t\n508\t        # Blockers deal damage back to the attacker\n509\t        for blocker in blocker_list:\n510\t            if id(blocker) not in blockers_dealt:\n511\t                blocker_kw = getattr(blocker, \"keywords\", Keyword(0))\n512\t                blocker_has_first = Keyword.FIRST_STRIKE in blocker_kw\n513\t                blocker_has_double = Keyword.DOUBLE_STRIKE in blocker_kw\n514\t\n515\t                # Determine if this blocker deals damage in this sub-step\n516\t                if is_first_strike:\n517\t                    should_deal = blocker_has_first or blocker_has_double\n518\t                else:\n519\t                    should_deal = not blocker_has_first or blocker_has_double\n520\t\n521\t                # Skip if blocker is no longer on the battlefield\n522\t                if should_deal:\n523\t                    blocker_ctrl = getattr(blocker, \"controller\", None)\n524\t                    if blocker_ctrl is not None:\n525\t                        bf = blocker_ctrl.zones[Zone.BATTLEFIELD]\n526\t                        if not bf.contains(blocker):\n527\t                            should_deal = False\n528\t\n529\t                if should_deal:\n530\t                    blocker_power = getattr(blocker, \"power\", 0)\n531\t                    _deal_damage(blocker, attacker, blocker_power, game, combat)\n532\t                    blockers_dealt.add(id(blocker))\n533\t\n534\t\n535\tdef end_combat_step(game: GameState) -> None:\n536\t    \"\"\"End combat step: remove from combat and clear combat state.\n537\t\n538\t    Resets ``is_attacking`` and ``is_blocking`` flags on all creatures\n539\t    and clears the combat state.\n540\t\n541\t    Parameters:\n542\t        game: The current game state.\n543\t    \"\"\"\n544\t    combat = game.combat_state\n545\t\n546\t    # Clear combat flags on all attackers\n547\t    for attacker in combat.attackers:\n548\t        if hasattr(attacker, \"is_attacking\"):\n549\t            attacker.is_attacking = False\n550\t\n551\t    # Clear combat flags on all blockers\n552\t    for blocker in combat.blockers:\n553\t        if hasattr(blocker, \"is_blocking\"):\n554\t            blocker.is_blocking = False\n555\t\n556\t    combat.clear()\n557\t"}]},"parent_tool_use_id":null,"session_id":"735f529e-7bc8-4328-a211-d2f095818fd0","uuid":"6583a546-b543-44f4-bfe6-5d05f9a721d4","timestamp":"2026-06-04T09:46:53.286Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/combat.py","content":"\"\"\"Combat system: declare attackers → declare blockers → damage → end combat.\n\nImplements the four substeps of the MTG combat phase:\n\n1. **Declare Attackers** — Active player chooses creatures to attack with.\n   Attackers are tapped (unless they have vigilance).  Creatures with\n   summoning sickness (without haste) or the defender keyword cannot attack.\n\n2. **Declare Blockers** — Defending player assigns blockers.  Creatures\n   with flying can only be blocked by creatures with flying or reach.\n   Creatures with menace require 2+ blockers.  The attacker's controller\n   orders the blockers for damage assignment.\n\n3. **Combat Damage** — First strike / double strike creatures deal damage\n   first, then state-based actions are checked, then normal damage.\n   Trample excess goes to the defending player.  Lifelink heals the\n   controller.  Deathtouch makes any nonzero damage lethal.  Unblocked\n   attackers deal damage to the defending player.\n\n4. **End Combat** — Clear all combat state.\n\nReferences: MTG Comprehensive Rules §506–§511.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.types import Keyword\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n# ---------------------------------------------------------------------------\n# CombatState — tracks all per-combat information\n# ---------------------------------------------------------------------------\n\n@dataclass\nclass CombatState:\n    \"\"\"Tracks attackers, blockers, damage assignments, and block ordering.\n\n    Attributes:\n        attackers: Mapping of attacking creature → defending player.\n        blockers: Mapping of blocking creature → list of attackers it blocks.\n        attacker_blockers: Mapping of attacking creature → ordered list of\n            blockers assigned to it (order used for damage assignment).\n        damage_assignments: Mapping of creature → list of\n            ``(target, amount)`` tuples describing how damage is assigned.\n        was_blocked: Set of attackers that were declared as blocked.  Per\n            MTG rule 509.1h, once a creature is blocked it stays blocked\n            even if all its blockers are removed before damage.\n        in_combat: Whether the combat phase is currently active.\n    \"\"\"\n\n    attackers: dict[Any, Player] = field(default_factory=dict)\n    blockers: dict[Any, list[Any]] = field(default_factory=dict)\n    attacker_blockers: dict[Any, list[Any]] = field(default_factory=dict)\n    damage_assignments: dict[Any, list[tuple[Any, int]]] = field(default_factory=dict)\n    was_blocked: set[Any] = field(default_factory=set)\n    in_combat: bool = False\n\n    def clear(self) -> None:\n        \"\"\"Reset all combat state.\"\"\"\n        self.attackers.clear()\n        self.blockers.clear()\n        self.attacker_blockers.clear()\n        self.damage_assignments.clear()\n        self.was_blocked.clear()\n        self.in_combat = False\n\n\n# ---------------------------------------------------------------------------\n# Helpers\n# ---------------------------------------------------------------------------\n\ndef _can_attack(creature: Any) -> bool:\n    \"\"\"Return ``True`` if *creature* is eligible to be declared as an attacker.\n\n    A creature cannot attack if:\n    - It is already tapped.\n    - It has the ``DEFENDER`` keyword.\n    - It has summoning sickness (``summoning_sick``) and does not have ``HASTE``.\n    - A continuous effect has set ``_cant_attack`` (e.g. Pacifism).\n    \"\"\"\n    if getattr(creature, \"is_tapped\", False):\n        return False\n\n    # Check for \"can't attack\" restriction (set by continuous effects like Pacifism)\n    if getattr(creature, \"_cant_attack\", False):\n        return False\n\n    keywords = getattr(creature, \"keywords\", Keyword(0))\n\n    if Keyword.DEFENDER in keywords:\n        return False\n\n    if getattr(creature, \"summoning_sick\", False) and Keyword.HASTE not in keywords:\n        return False\n\n    return True\n\n\ndef _can_block(blocker: Any, attacker: Any) -> bool:\n    \"\"\"Return ``True`` if *blocker* can legally block *attacker*.\n\n    Checks:\n    - If the blocker is tapped it cannot block.\n    - A continuous effect has set ``_cant_block`` (e.g. Pacifism).\n    - If the attacker has flying, the blocker must have flying or reach.\n    \"\"\"\n    if getattr(blocker, \"is_tapped\", False):\n        return False\n\n    # Check for \"can't block\" restriction (set by continuous effects like Pacifism)\n    if getattr(blocker, \"_cant_block\", False):\n        return False\n\n    attacker_kw = getattr(attacker, \"keywords\", Keyword(0))\n    blocker_kw = getattr(blocker, \"keywords\", Keyword(0))\n\n    # Flying check\n    if Keyword.FLYING in attacker_kw:\n        if Keyword.FLYING not in blocker_kw and Keyword.REACH not in blocker_kw:\n            return False\n\n    # Protection check — attacker with protection from blocker can't be blocked\n    from engine.protection import has_protection_from\n\n    if has_protection_from(attacker, blocker):\n        return False\n\n    return True\n\n\ndef _get_lethal_damage(creature: Any, attacker: Any | None = None) -> int:\n    \"\"\"Return the amount of damage needed to lethally assign to *creature*.\n\n    If *attacker* has deathtouch, 1 damage is lethal.\n    Otherwise it's ``toughness - damage_marked`` (at least 1).\n    \"\"\"\n    if attacker is not None:\n        attacker_kw = getattr(attacker, \"keywords\", Keyword(0))\n        if Keyword.DEATHTOUCH in attacker_kw:\n            return 1\n\n    toughness = getattr(creature, \"toughness\", 0)\n    damage_marked = getattr(creature, \"damage_marked\", 0)\n    return max(1, toughness - damage_marked)\n\n\ndef _deal_damage(\n    source: Any,\n    target: Any,\n    amount: int,\n    game: GameState,\n    combat_state: CombatState,\n) -> None:\n    \"\"\"Apply *amount* damage from *source* to *target*.\n\n    If *target* is a player, reduces life.\n    If *target* is a creature, marks damage on it.\n    If *source* has lifelink, the controller gains that much life.\n\n    Protection prevents damage from sources with the protected-from quality.\n    \"\"\"\n    if amount <= 0:\n        return\n\n    # Protection prevents damage (D in DEBT).\n    from engine.protection import has_protection_from\n\n    if has_protection_from(target, source):\n        return\n\n    # Record damage assignment\n    if source not in combat_state.damage_assignments:\n        combat_state.damage_assignments[source] = []\n    combat_state.damage_assignments[source].append((target, amount))\n\n    # Apply damage\n    if hasattr(target, \"life\"):\n        # Target is a player\n        target.life -= amount\n    elif hasattr(target, \"damage_marked\"):\n        # Target is a creature\n        target.damage_marked += amount\n\n        # Track deathtouch damage for SBA rule 704.5h\n        source_kw_dt = getattr(source, \"keywords\", Keyword(0))\n        if Keyword.DEATHTOUCH in source_kw_dt:\n            target.dealt_deathtouch_damage = True\n\n    # Lifelink: controller gains life equal to damage dealt\n    source_kw = getattr(source, \"keywords\", Keyword(0))\n    if Keyword.LIFELINK in source_kw:\n        controller = getattr(source, \"controller\", None)\n        if controller is not None and hasattr(controller, \"life\"):\n            controller.life += amount\n\n\n# ---------------------------------------------------------------------------\n# Combat steps\n# ---------------------------------------------------------------------------\n\ndef declare_attackers_step(game: GameState) -> None:\n    \"\"\"Declare attackers step: active player chooses creatures to attack with.\n\n    The active player is asked (via :meth:`Player.choose`) to select a set\n    of creatures to attack with.  Each chosen attacker is tapped (unless it\n    has vigilance) and its ``is_attacking`` flag is set.\n\n    Parameters:\n        game: The current game state.  ``game.combat_state`` must exist.\n    \"\"\"\n    combat = game.combat_state\n    combat.in_combat = True\n    active = game.active_player\n    defending = game.non_active_player\n\n    # Gather legal attackers from the active player's battlefield\n    from engine.types import Zone\n    bf = active.zones[Zone.BATTLEFIELD]\n    eligible = [\n        c for c in bf.get_all()\n        if hasattr(c, \"base_power\") and _can_attack(c)\n    ]\n\n    if not eligible:\n        return\n\n    # Active player chooses which creatures to attack with\n    chosen = active.choose(eligible, \"declare attackers\")\n\n    # Normalize to a list\n    if chosen is None:\n        return\n    if not isinstance(chosen, list):\n        chosen = [chosen]\n\n    # Validate and register attackers\n    for attacker in chosen:\n        if attacker not in eligible:\n            continue\n        if not _can_attack(attacker):\n            continue\n\n        combat.attackers[attacker] = defending\n        combat.attacker_blockers[attacker] = []\n        attacker.is_attacking = True\n\n        # Tap the attacker unless it has vigilance\n        kw = getattr(attacker, \"keywords\", Keyword(0))\n        if Keyword.VIGILANCE not in kw:\n            attacker.is_tapped = True\n\n\ndef declare_blockers_step(game: GameState) -> None:\n    \"\"\"Declare blockers step: defending player assigns blockers.\n\n    The defending player is asked (via :meth:`Player.choose`) to assign\n    blockers.  The expected format is a dict mapping blocker → attacker\n    (or blocker → list of attackers for multi-blocking scenarios), but\n    commonly blocker → attacker.\n\n    After blockers are assigned:\n    - Menace check: attackers with menace must be blocked by 2+ creatures.\n    - Flying/reach check is already handled by ``_can_block``.\n    - The attacking player orders blockers for each attacker (for damage\n      assignment).\n\n    Parameters:\n        game: The current game state.\n    \"\"\"\n    combat = game.combat_state\n\n    if not combat.attackers:\n        return\n\n    defending = game.non_active_player\n    active = game.active_player\n\n    from engine.types import Zone\n    bf_defending = defending.zones[Zone.BATTLEFIELD]\n    eligible_blockers = [\n        c for c in bf_defending.get_all()\n        if hasattr(c, \"base_power\") and not getattr(c, \"is_tapped\", False)\n    ]\n\n    if not eligible_blockers:\n        return\n\n    # Defending player chooses block assignments\n    # Expected format: dict mapping blocker → attacker (or list of attackers)\n    block_assignments = defending.choose(\n        eligible_blockers,\n        \"declare blockers\",\n    )\n\n    if block_assignments is None:\n        return\n\n    if not isinstance(block_assignments, dict):\n        return\n\n    # Process block assignments\n    for blocker, target in block_assignments.items():\n        # Validate that the blocker is in the eligible set\n        if blocker not in eligible_blockers:\n            continue\n        targets = target if isinstance(target, list) else [target]\n        valid_targets = []\n        max_blocked = getattr(blocker, \"_max_attackers_blocked\", 1)\n        for attacker in targets:\n            if len(valid_targets) >= max_blocked:\n                break\n            if attacker in combat.attackers and _can_block(blocker, attacker):\n                valid_targets.append(attacker)\n        if valid_targets:\n            combat.blockers[blocker] = valid_targets\n            blocker.is_blocking = True\n            for attacker in valid_targets:\n                if attacker not in combat.attacker_blockers:\n                    combat.attacker_blockers[attacker] = []\n                combat.attacker_blockers[attacker].append(blocker)\n\n    # Menace check: attackers with menace that have fewer than 2 blockers\n    # are treated as unblocked (remove the single blocker assignment).\n    for attacker, blocker_list in list(combat.attacker_blockers.items()):\n        kw = getattr(attacker, \"keywords\", Keyword(0))\n        if Keyword.MENACE in kw and len(blocker_list) < 2 and len(blocker_list) > 0:\n            # Illegal block — remove these blockers\n            for b in blocker_list:\n                if b in combat.blockers:\n                    combat.blockers[b] = [\n                        a for a in combat.blockers[b] if a is not attacker\n                    ]\n                    if not combat.blockers[b]:\n                        del combat.blockers[b]\n                        b.is_blocking = False\n            combat.attacker_blockers[attacker] = []\n\n    # Mark attackers that have at least one blocker as \"was_blocked\".\n    # Per MTG rule 509.1h, once a creature is blocked it remains blocked\n    # even if all its blockers are removed before the damage step.\n    for attacker, blocker_list in combat.attacker_blockers.items():\n        if blocker_list:\n            combat.was_blocked.add(attacker)\n\n    # Controller of each attacker orders the blockers for damage assignment\n    for attacker, blocker_list in combat.attacker_blockers.items():\n        if len(blocker_list) > 1:\n            controller = getattr(attacker, \"controller\", active)\n            ordered = controller.assign_damage_order(blocker_list)\n            combat.attacker_blockers[attacker] = ordered\n\n\ndef combat_damage_step(game: GameState) -> None:\n    \"\"\"Combat damage step: deal combat damage.\n\n    Handles:\n    - First strike / double strike creatures deal damage first.\n    - State-based actions are checked between first-strike and normal damage.\n    - Trample: excess damage over blocker toughness → defending player.\n    - Lifelink: controller gains life equal to damage dealt.\n    - Deathtouch: any damage is lethal (1 damage = lethal assignment).\n    - Unblocked attackers deal damage to defending player.\n\n    Parameters:\n        game: The current game state.\n    \"\"\"\n    from engine.state_based_actions import resolve_state_based_actions\n\n    combat = game.combat_state\n\n    if not combat.attackers:\n        return\n\n    all_attackers = list(combat.attackers.keys())\n\n    # Determine if a first-strike damage sub-step is needed\n    # Check both attackers and blockers for first strike / double strike\n    all_blockers = set()\n    for blocker_list in combat.attacker_blockers.values():\n        all_blockers.update(blocker_list)\n\n    has_first_strike_step = any(\n        Keyword.FIRST_STRIKE in getattr(c, \"keywords\", Keyword(0))\n        or Keyword.DOUBLE_STRIKE in getattr(c, \"keywords\", Keyword(0))\n        for c in list(all_attackers) + list(all_blockers)\n    )\n\n    # --- First strike damage sub-step ---\n    if has_first_strike_step:\n        _assign_combat_damage(all_attackers, combat, game, is_first_strike=True)\n        resolve_state_based_actions(game)\n\n    # --- Normal damage sub-step ---\n    _assign_combat_damage(all_attackers, combat, game, is_first_strike=False)\n    resolve_state_based_actions(game)\n\n\ndef _assign_combat_damage(\n    attackers: list[Any],\n    combat: CombatState,\n    game: GameState,\n    *,\n    is_first_strike: bool = False,\n) -> None:\n    \"\"\"Assign and deal combat damage for a set of attackers.\n\n    For each attacker:\n    - If unblocked → damage to defending player.\n    - If blocked → damage assigned to blockers in order.  With trample,\n      excess damage goes to the defending player.\n    - Blockers deal damage back to the attacker they block.\n\n    When *is_first_strike* is ``True``, only creatures with\n    ``FIRST_STRIKE`` or ``DOUBLE_STRIKE`` deal damage (both attackers\n    and blockers).  When ``False``, only creatures *without*\n    ``FIRST_STRIKE`` deal damage (plus ``DOUBLE_STRIKE`` creatures,\n    which participate in both steps).  Blockers that are no longer on\n    the battlefield (e.g. killed by first-strike damage and removed by\n    SBAs) are skipped.\n    \"\"\"\n    from engine.types import Zone\n\n    # Track which blockers have already dealt their damage this sub-step\n    # (blockers only deal damage once even if blocking multiple attackers)\n    blockers_dealt: set[int] = set()\n\n    for attacker in attackers:\n        if attacker not in combat.attackers:\n            continue\n\n        kw = getattr(attacker, \"keywords\", Keyword(0))\n        has_first = Keyword.FIRST_STRIKE in kw\n        has_double = Keyword.DOUBLE_STRIKE in kw\n\n        # Determine if this attacker deals damage in this sub-step\n        if is_first_strike:\n            attacker_deals = has_first or has_double\n        else:\n            attacker_deals = not has_first or has_double\n\n        # Skip if attacker is no longer on the battlefield\n        if attacker_deals:\n            controller = getattr(attacker, \"controller\", None)\n            if controller is not None:\n                bf = controller.zones[Zone.BATTLEFIELD]\n                if not bf.contains(attacker):\n                    attacker_deals = False\n\n        defending_player = combat.attackers[attacker]\n        blocker_list = combat.attacker_blockers.get(attacker, [])\n        attacker_kw = getattr(attacker, \"keywords\", Keyword(0))\n\n        if attacker_deals:\n            power = getattr(attacker, \"power\", 0)\n\n            # Check if attacker was blocked.  Per MTG rule 509.1h, a blocked\n            # creature stays blocked even if all its blockers are removed.\n            is_blocked = attacker in combat.was_blocked\n\n            if not is_blocked and not blocker_list:\n                # Truly unblocked → damage to defending player\n                _deal_damage(attacker, defending_player, power, game, combat)\n            elif is_blocked and not blocker_list:\n                # Was blocked but all blockers removed.\n                # Without trample: deals no damage.\n                # With trample: all damage tramples to defending player.\n                has_trample = Keyword.TRAMPLE in attacker_kw\n                if has_trample:\n                    _deal_damage(attacker, defending_player, power, game, combat)\n                # else: no damage dealt\n            else:\n                # Blocked → assign damage to blockers in order\n                has_trample = Keyword.TRAMPLE in attacker_kw\n                remaining_damage = power\n\n                for i, blocker in enumerate(blocker_list):\n                    if remaining_damage <= 0:\n                        break\n\n                    lethal = _get_lethal_damage(blocker, attacker)\n\n                    if i < len(blocker_list) - 1:\n                        # Not the last blocker — assign lethal damage\n                        assign = min(lethal, remaining_damage)\n                    else:\n                        # Last blocker\n                        if has_trample:\n                            # With trample: assign lethal, rest tramples through\n                            assign = min(lethal, remaining_damage)\n                        else:\n                            # Without trample: all remaining damage to last blocker\n                            assign = remaining_damage\n\n                    _deal_damage(attacker, blocker, assign, game, combat)\n                    remaining_damage -= assign\n\n                # Trample: excess damage to defending player\n                if has_trample and remaining_damage > 0:\n                    _deal_damage(attacker, defending_player, remaining_damage, game, combat)\n\n        # Blockers deal damage back to the attacker\n        for blocker in blocker_list:\n            if id(blocker) not in blockers_dealt:\n                blocker_kw = getattr(blocker, \"keywords\", Keyword(0))\n                blocker_has_first = Keyword.FIRST_STRIKE in blocker_kw\n                blocker_has_double = Keyword.DOUBLE_STRIKE in blocker_kw\n\n                # Determine if this blocker deals damage in this sub-step\n                if is_first_strike:\n                    should_deal = blocker_has_first or blocker_has_double\n                else:\n                    should_deal = not blocker_has_first or blocker_has_double\n\n                # Skip if blocker is no longer on the battlefield\n                if should_deal:\n                    blocker_ctrl = getattr(blocker, \"controller\", None)\n                    if blocker_ctrl is not None:\n                        bf = blocker_ctrl.zones[Zone.BATTLEFIELD]\n                        if not bf.contains(blocker):\n                            should_deal = False\n\n                if should_deal:\n                    blocker_power = getattr(blocker, \"power\", 0)\n                    _deal_damage(blocker, attacker, blocker_power, game, combat)\n                    blockers_dealt.add(id(blocker))\n\n\ndef end_combat_step(game: GameState) -> None:\n    \"\"\"End combat step: remove from combat and clear combat state.\n\n    Resets ``is_attacking`` and ``is_blocking`` flags on all creatures\n    and clears the combat state.\n\n    Parameters:\n        game: The current game state.\n    \"\"\"\n    combat = game.combat_state\n\n    # Clear combat flags on all attackers\n    for attacker in combat.attackers:\n        if hasattr(attacker, \"is_attacking\"):\n            attacker.is_attacking = False\n\n    # Clear combat flags on all blockers\n    for blocker in combat.blockers:\n        if hasattr(blocker, \"is_blocking\"):\n            blocker.is_blocking = False\n\n    combat.clear()\n","numLines":557,"startLine":1,"totalLines":557}}}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01X8ZR6mZ8gz6vvp1gAVh7WE","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011Rz86amVYpEHks6k3KedL4","name":"Read","input":{"file_path":"/workspace/engine/card.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":13226,"cache_read_input_tokens":36978,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":13226},"output_tokens":56,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"735f529e-7bc8-4328-a211-d2f095818fd0","uuid":"c718e517-e24e-49ae-b1e3-7c3b063c9145","request_id":"req_011Cbi1NNaWQydwxbzSBVK2a"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011Rz86amVYpEHks6k3KedL4","type":"tool_result","content":"1\t\"\"\"Card base classes, CardImpl interface, and supporting dataclasses.\n2\t\n3\tProvides the core class hierarchy for all Magic: The Gathering card types:\n4\t\n5\t- ``GameObject`` — base for anything that can exist in zones.\n6\t- ``CardImpl(GameObject)`` — abstract card implementation with hooks for\n7\t  casting, resolution, targeting, triggers, and abilities.\n8\t- Concrete subclasses: ``Creature``, ``Instant``, ``Sorcery``,\n9\t  ``Enchantment``, ``Aura``, ``Artifact``, ``ArtifactCreature``,\n10\t  ``Planeswalker``, ``Land``.\n11\t- Supporting dataclasses: ``ActivatedAbility``, ``LoyaltyAbility``,\n12\t  ``ManaAbility``, ``ContinuousEffect``, ``Mode``.\n13\t\"\"\"\n14\t\n15\tfrom __future__ import annotations\n16\t\n17\tfrom dataclasses import dataclass\n18\tfrom typing import TYPE_CHECKING, Any, Callable\n19\t\n20\tfrom engine.types import CardType, Keyword, ManaCost, Supertype\n21\t\n22\tif TYPE_CHECKING:\n23\t    from engine.game_state import GameState\n24\t    from engine.player import Player\n25\t\n26\t\n27\t# ---------------------------------------------------------------------------\n28\t# Supporting dataclasses\n29\t# ---------------------------------------------------------------------------\n30\t\n31\t@dataclass\n32\tclass Mode:\n33\t    \"\"\"Represents a single mode of a modal spell or ability.\n34\t\n35\t    Attributes:\n36\t        name: Short label for this mode (e.g. ``\"Destroy target creature\"``).\n37\t        description: Detailed rules text for the mode.\n38\t    \"\"\"\n39\t\n40\t    name: str = \"\"\n41\t    description: str = \"\"\n42\t\n43\t\n44\t@dataclass\n45\tclass ActivatedAbility:\n46\t    \"\"\"An activated ability on a permanent.\n47\t\n48\t    Attributes:\n49\t        cost: A callable that checks/pays the cost given the game state.\n50\t        effect: A callable that applies the effect given the game state.\n51\t        description: Human-readable description of the ability.\n52\t    \"\"\"\n53\t\n54\t    cost: Callable[..., Any]\n55\t    effect: Callable[..., Any]\n56\t    description: str = \"\"\n57\t\n58\t\n59\t@dataclass\n60\tclass LoyaltyAbility:\n61\t    \"\"\"A planeswalker loyalty ability.\n62\t\n63\t    Attributes:\n64\t        loyalty_cost: The loyalty cost (positive for ``+``, negative for ``−``).\n65\t        effect: A callable that applies the ability's effect.\n66\t        description: Human-readable description.\n67\t    \"\"\"\n68\t\n69\t    loyalty_cost: int\n70\t    effect: Callable[..., Any]\n71\t    description: str = \"\"\n72\t\n73\t\n74\t@dataclass\n75\tclass ManaAbility:\n76\t    \"\"\"A mana ability (does not use the stack).\n77\t\n78\t    Attributes:\n79\t        cost: A callable that checks/pays the cost.\n80\t        mana_produced: A callable that returns the mana added.\n81\t        description: Human-readable description.\n82\t    \"\"\"\n83\t\n84\t    cost: Callable[..., Any]\n85\t    mana_produced: Callable[..., Any]\n86\t    description: str = \"\"\n87\t\n88\t\n89\t@dataclass\n90\tclass ContinuousEffect:\n91\t    \"\"\"A continuous effect applied by an enchantment or other source.\n92\t\n93\t    Attributes:\n94\t        apply: A callable that applies the effect to the game state.\n95\t        remove: A callable that removes the effect from the game state.\n96\t        description: Human-readable description.\n97\t    \"\"\"\n98\t\n99\t    apply: Callable[..., Any]\n100\t    remove: Callable[..., Any]\n101\t    description: str = \"\"\n102\t\n103\t\n104\t# ---------------------------------------------------------------------------\n105\t# GameObject — base class for zone-resident objects\n106\t# ---------------------------------------------------------------------------\n107\t\n108\tclass GameObject:\n109\t    \"\"\"Base class for anything that can exist in a zone.\n110\t\n111\t    Each instance receives a unique ``object_id`` via a class-level\n112\t    auto-incrementing counter.\n113\t\n114\t    Attributes:\n115\t        object_id: Unique integer identifier (auto-assigned).\n116\t        owner: The player who owns this object.\n117\t        controller: The player who currently controls this object.\n118\t    \"\"\"\n119\t\n120\t    _next_id: int = 1\n121\t\n122\t    def __init__(self, owner: Player | None = None, controller: Player | None = None) -> None:\n123\t        self.object_id: int = GameObject._next_id\n124\t        GameObject._next_id += 1\n125\t        self.owner: Player | None = owner\n126\t        self.controller: Player | None = controller if controller is not None else owner\n127\t\n128\t    @classmethod\n129\t    def reset_id_counter(cls) -> None:\n130\t        \"\"\"Reset the auto-incrementing counter (useful in tests).\"\"\"\n131\t        cls._next_id = 1\n132\t\n133\t\n134\t# ---------------------------------------------------------------------------\n135\t# CardImpl — abstract card implementation\n136\t# ---------------------------------------------------------------------------\n137\t\n138\tclass CardImpl(GameObject):\n139\t    \"\"\"Abstract base for all card implementations.\n140\t\n141\t    Subclasses should override the ``can_cast``, ``on_cast``, ``on_resolve``,\n142\t    and other hook methods to implement card-specific behaviour.\n143\t\n144\t    Attributes:\n145\t        name: Card name.\n146\t        mana_cost: The card's mana cost.\n147\t        card_types: Set of :class:`~engine.types.CardType` values.\n148\t        subtypes: Set of subtype strings (e.g. ``{\"Elf\", \"Warrior\"}``).\n149\t        supertypes: Set of :class:`~engine.types.Supertype` values.\n150\t        keywords: Combination of :class:`~engine.types.Keyword` flags.\n151\t        rules_text: The card's rules text string.\n152\t    \"\"\"\n153\t\n154\t    def __init__(\n155\t        self,\n156\t        name: str = \"\",\n157\t        mana_cost: ManaCost | None = None,\n158\t        card_types: set[CardType] | None = None,\n159\t        subtypes: set[str] | None = None,\n160\t        supertypes: set[Supertype] | None = None,\n161\t        keywords: Keyword | None = None,\n162\t        rules_text: str = \"\",\n163\t        owner: Player | None = None,\n164\t        controller: Player | None = None,\n165\t    ) -> None:\n166\t        super().__init__(owner=owner, controller=controller)\n167\t        self.name: str = name\n168\t        self.mana_cost: ManaCost = mana_cost if mana_cost is not None else ManaCost()\n169\t        self.card_types: set[CardType] = card_types if card_types is not None else set()\n170\t        self.subtypes: set[str] = subtypes if subtypes is not None else set()\n171\t        self.supertypes: set[Supertype] = supertypes if supertypes is not None else set()\n172\t        self.keywords: Keyword = keywords if keywords is not None else Keyword(0)\n173\t        self.rules_text: str = rules_text\n174\t        # Snapshot original characteristics for continuous-effect reset.\n175\t        self._original_card_types: frozenset[CardType] = frozenset(self.card_types)\n176\t        self._original_keywords: Keyword = self.keywords\n177\t\n178\t    # ------------------------------------------------------------------\n179\t    # Continuous-effect reset support\n180\t    # ------------------------------------------------------------------\n181\t\n182\t    def _reset_characteristics(self) -> None:\n183\t        \"\"\"Reset mutable characteristics to their original (pre-effect) values.\n184\t\n185\t        Called by :meth:`EffectManager.apply_all` before reapplying effects\n186\t        so that the recalculation is idempotent.\n187\t        \"\"\"\n188\t        self.card_types = set(self._original_card_types)\n189\t        self.keywords = self._original_keywords\n190\t\n191\t    # ------------------------------------------------------------------\n192\t    # Hook methods — override in subclasses / card definitions\n193\t    # ------------------------------------------------------------------\n194\t\n195\t    def can_cast(self, game: GameState) -> bool:\n196\t        \"\"\"Return ``True`` if this card can currently be cast.\"\"\"\n197\t        return True\n198\t\n199\t    def cost_reduction(self, game: GameState) -> int:\n200\t        \"\"\"Return the generic mana reduction for casting this card.\n201\t\n202\t        Override in subclasses to implement cost-reduction mechanics\n203\t        (e.g. Embercleave costs {1} less for each attacking creature).\n204\t        The returned value is clamped so that generic mana cannot go below 0.\n205\t        Only reduces generic mana — colored costs are never reduced.\n206\t\n207\t        Returns:\n208\t            Non-negative integer representing generic mana to subtract.\n209\t        \"\"\"\n210\t        return 0\n211\t\n212\t    def on_cast(self, game: GameState) -> None:\n213\t        \"\"\"Called when the card is cast (before it goes on the stack).\"\"\"\n214\t\n215\t    def on_resolve(self, game: GameState) -> None:\n216\t        \"\"\"Called when the spell resolves from the stack.\n217\t\n218\t        Targets are available via ``self.chosen_targets`` — set at\n219\t        resolve-time by :func:`~engine.casting._resolve_spell` from\n220\t        :attr:`StackObject.targets`, or directly by test code.\n221\t        \"\"\"\n222\t\n223\t    def get_targets(self, game: GameState) -> list[Any]:\n224\t        \"\"\"Return a list of legal targets for this card.\"\"\"\n225\t        return []\n226\t\n227\t    def register_triggers(self, game: GameState) -> None:\n228\t        \"\"\"Register any triggered abilities this card provides.\"\"\"\n229\t\n230\t    def register_replacement_effects(self, game: GameState) -> None:\n231\t        \"\"\"Register any replacement effects this card provides.\"\"\"\n232\t\n233\t    def get_activated_abilities(self) -> list[ActivatedAbility]:\n234\t        \"\"\"Return activated abilities this card provides.\"\"\"\n235\t        return []\n236\t\n237\t    def get_modes(self) -> list[Mode]:\n238\t        \"\"\"Return available modes for modal spells/abilities.\n239\t\n240\t        Non-modal cards return an empty list by default.\n241\t        \"\"\"\n242\t        return []\n243\t\n244\t\n245\t# ---------------------------------------------------------------------------\n246\t# Creature\n247\t# ---------------------------------------------------------------------------\n248\t\n249\tclass Creature(CardImpl):\n250\t    \"\"\"A creature card.\n251\t\n252\t    Attributes:\n253\t        base_power: The printed power value (rule 208.1). Immutable after init.\n254\t        base_toughness: The printed toughness value. Immutable after init.\n255\t        modified_power: Current power after continuous effects (Layer 7c), before counters.\n256\t            Reset to ``base_power`` each effect cycle; continuous effects write here.\n257\t        modified_toughness: Current toughness after continuous effects, before counters.\n258\t        damage_marked: Amount of damage currently marked on this creature.\n259\t        is_tapped: Whether the creature is tapped.\n260\t        summoning_sick: Whether the creature has summoning sickness.\n261\t        is_attacking: Combat flag — currently declared as an attacker.\n262\t        is_blocking: Combat flag — currently declared as a blocker.\n263\t        plus_one_counters: Number of +1/+1 counters.\n264\t        minus_one_counters: Number of -1/-1 counters.\n265\t        is_token: Whether this object is a token (for SBA checks).\n266\t    \"\"\"\n267\t\n268\t    def __init__(\n269\t        self,\n270\t        name: str = \"\",\n271\t        mana_cost: ManaCost | None = None,\n272\t        card_types: set[CardType] | None = None,\n273\t        subtypes: set[str] | None = None,\n274\t        supertypes: set[Supertype] | None = None,\n275\t        keywords: Keyword | None = None,\n276\t        rules_text: str = \"\",\n277\t        owner: Player | None = None,\n278\t        controller: Player | None = None,\n279\t        base_power: int = 0,\n280\t        base_toughness: int = 0,\n281\t    ) -> None:\n282\t        # Always include CREATURE in card_types.\n283\t        card_types = (card_types or set()) | {CardType.CREATURE}\n284\t        super().__init__(\n285\t            name=name,\n286\t            mana_cost=mana_cost,\n287\t            card_types=card_types,\n288\t            subtypes=subtypes,\n289\t            supertypes=supertypes,\n290\t            keywords=keywords,\n291\t            rules_text=rules_text,\n292\t            owner=owner,\n293\t            controller=controller,\n294\t        )\n295\t        self.base_power: int = base_power\n296\t        self.base_toughness: int = base_toughness\n297\t        self.modified_power: int = base_power\n298\t        self.modified_toughness: int = base_toughness\n299\t        self.damage_marked: int = 0\n300\t        self.is_tapped: bool = False\n301\t        self.summoning_sick: bool = True\n302\t        self.is_attacking: bool = False\n303\t        self.is_blocking: bool = False\n304\t        self.plus_one_counters: int = 0\n305\t        self.minus_one_counters: int = 0\n306\t        self.is_token: bool = False\n307\t        self.dealt_deathtouch_damage: bool = False\n308\t        self._base_plus_one_counters: int = 0\n309\t        self._base_minus_one_counters: int = 0\n310\t\n311\t    def _reset_characteristics(self) -> None:\n312\t        \"\"\"Reset creature characteristics to pre-effect values.\"\"\"\n313\t        super()._reset_characteristics()\n314\t        self.modified_power = self.base_power\n315\t        self.modified_toughness = self.base_toughness\n316\t        self.plus_one_counters = self._base_plus_one_counters\n317\t        self.minus_one_counters = self._base_minus_one_counters\n318\t        # Reset combat-restriction flags set by continuous effects (e.g. Pacifism).\n319\t        # These are reapplied by active effects during apply_all().\n320\t        self._cant_attack: bool = False\n321\t        self._cant_block: bool = False\n322\t        self._cant_be_blocked: bool = False\n323\t        self._cant_activate: bool = False\n324\t        self._max_attackers_blocked: int = 1\n325\t        # Clear granted protections so they are reapplied by active effects.\n326\t        if hasattr(self, \"protections\"):\n327\t            self.protections = []\n328\t\n329\t    @property\n330\t    def counters(self) -> dict[str, int]:\n331\t        \"\"\"Return a dict-like view of counters on this creature.\"\"\"\n332\t        result: dict[str, int] = {}\n333\t        if self.plus_one_counters > 0:\n334\t            result[\"+1/+1\"] = self.plus_one_counters\n335\t        if self.minus_one_counters > 0:\n336\t            result[\"-1/-1\"] = self.minus_one_counters\n337\t        return result\n338\t\n339\t    @property\n340\t    def power(self) -> int:\n341\t        \"\"\"Current power including counter modifications.\"\"\"\n342\t        return self.modified_power + self.plus_one_counters - self.minus_one_counters\n343\t\n344\t    @property\n345\t    def toughness(self) -> int:\n346\t        \"\"\"Current toughness including counter modifications.\"\"\"\n347\t        return self.modified_toughness + self.plus_one_counters - self.minus_one_counters\n348\t\n349\t\n350\t# ---------------------------------------------------------------------------\n351\t# Instant / Sorcery\n352\t# ---------------------------------------------------------------------------\n353\t\n354\tclass Instant(CardImpl):\n355\t    \"\"\"An instant spell — no extra fields beyond CardImpl.\"\"\"\n356\t\n357\t    def __init__(self, **kwargs: Any) -> None:\n358\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.INSTANT}\n359\t        super().__init__(**kwargs)\n360\t\n361\t\n362\tclass Sorcery(CardImpl):\n363\t    \"\"\"A sorcery spell — no extra fields beyond CardImpl.\"\"\"\n364\t\n365\t    def __init__(self, **kwargs: Any) -> None:\n366\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.SORCERY}\n367\t        super().__init__(**kwargs)\n368\t\n369\t\n370\t# ---------------------------------------------------------------------------\n371\t# Enchantment\n372\t# ---------------------------------------------------------------------------\n373\t\n374\tclass Enchantment(CardImpl):\n375\t    \"\"\"An enchantment card.\n376\t\n377\t    For auras, use the :class:`Aura` subclass which sets ``is_aura = True``.\n378\t    The base ``Enchantment`` class retains the ``attached_to`` attribute for\n379\t    backwards compatibility but marks ``is_aura = False`` so that state-based\n380\t    actions do not treat a non-aura enchantment as an unattached aura.\n381\t\n382\t    Attributes:\n383\t        attached_to: The object this enchantment is attached to (``None``\n384\t            if not an aura or not yet attached).\n385\t        is_aura: ``False`` for regular enchantments; ``True`` for auras.\n386\t    \"\"\"\n387\t\n388\t    is_aura: bool = False\n389\t\n390\t    def __init__(self, attached_to: Any | None = None, **kwargs: Any) -> None:\n391\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ENCHANTMENT}\n392\t        super().__init__(**kwargs)\n393\t        self.attached_to: Any | None = attached_to\n394\t\n395\t    def apply_continuous_effect(self, game: GameState) -> None:\n396\t        \"\"\"Apply the enchantment's continuous effect to the game.\"\"\"\n397\t\n398\t    def on_enchant(self, game: GameState) -> None:\n399\t        \"\"\"Called when this enchantment becomes attached to an object.\"\"\"\n400\t\n401\t    def on_detach(self, game: GameState) -> None:\n402\t        \"\"\"Called when this enchantment is detached from its object.\"\"\"\n403\t\n404\t\n405\tclass Aura(Enchantment):\n406\t    \"\"\"An Aura enchantment — attaches to a permanent on the battlefield.\n407\t\n408\t    Sets ``is_aura = True`` so that state-based actions correctly identify\n409\t    this as an aura (and move it to the graveyard when unattached).\n410\t\n411\t    Attributes:\n412\t        is_aura: Always ``True`` for auras.\n413\t    \"\"\"\n414\t\n415\t    is_aura: bool = True\n416\t\n417\t    def __init__(self, attached_to: Any | None = None, **kwargs: Any) -> None:\n418\t        super().__init__(attached_to=attached_to, **kwargs)\n419\t\n420\t\n421\t# ---------------------------------------------------------------------------\n422\t# Artifact / ArtifactCreature\n423\t# ---------------------------------------------------------------------------\n424\t\n425\tclass Artifact(CardImpl):\n426\t    \"\"\"An artifact card.\n427\t\n428\t    Attributes:\n429\t        is_tapped: Whether the artifact is currently tapped.\n430\t    \"\"\"\n431\t\n432\t    def __init__(self, **kwargs: Any) -> None:\n433\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ARTIFACT}\n434\t        super().__init__(**kwargs)\n435\t        self.is_tapped: bool = False\n436\t\n437\t\n438\tclass ArtifactCreature(Creature):\n439\t    \"\"\"An artifact creature — combines Artifact and Creature types.\n440\t\n441\t    Inherits creature combat stats and behaviour from :class:`Creature`.\n442\t    \"\"\"\n443\t\n444\t    def __init__(self, **kwargs: Any) -> None:\n445\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ARTIFACT, CardType.CREATURE}\n446\t        super().__init__(**kwargs)\n447\t\n448\t\n449\t# ---------------------------------------------------------------------------\n450\t# Planeswalker\n451\t# ---------------------------------------------------------------------------\n452\t\n453\tclass Planeswalker(CardImpl):\n454\t    \"\"\"A planeswalker card.\n455\t\n456\t    Attributes:\n457\t        starting_loyalty: The starting loyalty printed on the card.\n458\t        loyalty: Current loyalty counter value.\n459\t    \"\"\"\n460\t\n461\t    def __init__(\n462\t        self,\n463\t        starting_loyalty: int = 0,\n464\t        **kwargs: Any,\n465\t    ) -> None:\n466\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.PLANESWALKER}\n467\t        super().__init__(**kwargs)\n468\t        self.starting_loyalty: int = starting_loyalty\n469\t        self.loyalty: int = starting_loyalty\n470\t\n471\t    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n472\t        \"\"\"Return the planeswalker's loyalty abilities.\"\"\"\n473\t        return []\n474\t\n475\t\n476\t# ---------------------------------------------------------------------------\n477\t# Land\n478\t# ---------------------------------------------------------------------------\n479\t\n480\tclass Land(CardImpl):\n481\t    \"\"\"A land card.\n482\t\n483\t    Lands are not cast — they are played via a special action. ``can_cast``\n484\t    always returns ``False``.\n485\t\n486\t    Attributes:\n487\t        is_tapped: Whether the land is currently tapped.\n488\t    \"\"\"\n489\t\n490\t    def __init__(self, **kwargs: Any) -> None:\n491\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.LAND}\n492\t        super().__init__(**kwargs)\n493\t        self.is_tapped: bool = False\n494\t\n495\t    def can_cast(self, game: GameState) -> bool:\n496\t        \"\"\"Lands cannot be cast; they are played as a special action.\"\"\"\n497\t        return False\n498\t\n499\t    def get_mana_abilities(self) -> list[ManaAbility]:\n500\t        \"\"\"Return the land's mana abilities.\"\"\"\n501\t        return []\n502\t"}]},"parent_tool_use_id":null,"session_id":"735f529e-7bc8-4328-a211-d2f095818fd0","uuid":"001c6bea-603a-4389-b414-65a21f8be0e2","timestamp":"2026-06-04T09:46:53.347Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/card.py","content":"\"\"\"Card base classes, CardImpl interface, and supporting dataclasses.\n\nProvides the core class hierarchy for all Magic: The Gathering card types:\n\n- ``GameObject`` — base for anything that can exist in zones.\n- ``CardImpl(GameObject)`` — abstract card implementation with hooks for\n  casting, resolution, targeting, triggers, and abilities.\n- Concrete subclasses: ``Creature``, ``Instant``, ``Sorcery``,\n  ``Enchantment``, ``Aura``, ``Artifact``, ``ArtifactCreature``,\n  ``Planeswalker``, ``Land``.\n- Supporting dataclasses: ``ActivatedAbility``, ``LoyaltyAbility``,\n  ``ManaAbility``, ``ContinuousEffect``, ``Mode``.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom typing import TYPE_CHECKING, Any, Callable\n\nfrom engine.types import CardType, Keyword, ManaCost, Supertype\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n# ---------------------------------------------------------------------------\n# Supporting dataclasses\n# ---------------------------------------------------------------------------\n\n@dataclass\nclass Mode:\n    \"\"\"Represents a single mode of a modal spell or ability.\n\n    Attributes:\n        name: Short label for this mode (e.g. ``\"Destroy target creature\"``).\n        description: Detailed rules text for the mode.\n    \"\"\"\n\n    name: str = \"\"\n    description: str = \"\"\n\n\n@dataclass\nclass ActivatedAbility:\n    \"\"\"An activated ability on a permanent.\n\n    Attributes:\n        cost: A callable that checks/pays the cost given the game state.\n        effect: A callable that applies the effect given the game state.\n        description: Human-readable description of the ability.\n    \"\"\"\n\n    cost: Callable[..., Any]\n    effect: Callable[..., Any]\n    description: str = \"\"\n\n\n@dataclass\nclass LoyaltyAbility:\n    \"\"\"A planeswalker loyalty ability.\n\n    Attributes:\n        loyalty_cost: The loyalty cost (positive for ``+``, negative for ``−``).\n        effect: A callable that applies the ability's effect.\n        description: Human-readable description.\n    \"\"\"\n\n    loyalty_cost: int\n    effect: Callable[..., Any]\n    description: str = \"\"\n\n\n@dataclass\nclass ManaAbility:\n    \"\"\"A mana ability (does not use the stack).\n\n    Attributes:\n        cost: A callable that checks/pays the cost.\n        mana_produced: A callable that returns the mana added.\n        description: Human-readable description.\n    \"\"\"\n\n    cost: Callable[..., Any]\n    mana_produced: Callable[..., Any]\n    description: str = \"\"\n\n\n@dataclass\nclass ContinuousEffect:\n    \"\"\"A continuous effect applied by an enchantment or other source.\n\n    Attributes:\n        apply: A callable that applies the effect to the game state.\n        remove: A callable that removes the effect from the game state.\n        description: Human-readable description.\n    \"\"\"\n\n    apply: Callable[..., Any]\n    remove: Callable[..., Any]\n    description: str = \"\"\n\n\n# ---------------------------------------------------------------------------\n# GameObject — base class for zone-resident objects\n# ---------------------------------------------------------------------------\n\nclass GameObject:\n    \"\"\"Base class for anything that can exist in a zone.\n\n    Each instance receives a unique ``object_id`` via a class-level\n    auto-incrementing counter.\n\n    Attributes:\n        object_id: Unique integer identifier (auto-assigned).\n        owner: The player who owns this object.\n        controller: The player who currently controls this object.\n    \"\"\"\n\n    _next_id: int = 1\n\n    def __init__(self, owner: Player | None = None, controller: Player | None = None) -> None:\n        self.object_id: int = GameObject._next_id\n        GameObject._next_id += 1\n        self.owner: Player | None = owner\n        self.controller: Player | None = controller if controller is not None else owner\n\n    @classmethod\n    def reset_id_counter(cls) -> None:\n        \"\"\"Reset the auto-incrementing counter (useful in tests).\"\"\"\n        cls._next_id = 1\n\n\n# ---------------------------------------------------------------------------\n# CardImpl — abstract card implementation\n# ---------------------------------------------------------------------------\n\nclass CardImpl(GameObject):\n    \"\"\"Abstract base for all card implementations.\n\n    Subclasses should override the ``can_cast``, ``on_cast``, ``on_resolve``,\n    and other hook methods to implement card-specific behaviour.\n\n    Attributes:\n        name: Card name.\n        mana_cost: The card's mana cost.\n        card_types: Set of :class:`~engine.types.CardType` values.\n        subtypes: Set of subtype strings (e.g. ``{\"Elf\", \"Warrior\"}``).\n        supertypes: Set of :class:`~engine.types.Supertype` values.\n        keywords: Combination of :class:`~engine.types.Keyword` flags.\n        rules_text: The card's rules text string.\n    \"\"\"\n\n    def __init__(\n        self,\n        name: str = \"\",\n        mana_cost: ManaCost | None = None,\n        card_types: set[CardType] | None = None,\n        subtypes: set[str] | None = None,\n        supertypes: set[Supertype] | None = None,\n        keywords: Keyword | None = None,\n        rules_text: str = \"\",\n        owner: Player | None = None,\n        controller: Player | None = None,\n    ) -> None:\n        super().__init__(owner=owner, controller=controller)\n        self.name: str = name\n        self.mana_cost: ManaCost = mana_cost if mana_cost is not None else ManaCost()\n        self.card_types: set[CardType] = card_types if card_types is not None else set()\n        self.subtypes: set[str] = subtypes if subtypes is not None else set()\n        self.supertypes: set[Supertype] = supertypes if supertypes is not None else set()\n        self.keywords: Keyword = keywords if keywords is not None else Keyword(0)\n        self.rules_text: str = rules_text\n        # Snapshot original characteristics for continuous-effect reset.\n        self._original_card_types: frozenset[CardType] = frozenset(self.card_types)\n        self._original_keywords: Keyword = self.keywords\n\n    # ------------------------------------------------------------------\n    # Continuous-effect reset support\n    # ------------------------------------------------------------------\n\n    def _reset_characteristics(self) -> None:\n        \"\"\"Reset mutable characteristics to their original (pre-effect) values.\n\n        Called by :meth:`EffectManager.apply_all` before reapplying effects\n        so that the recalculation is idempotent.\n        \"\"\"\n        self.card_types = set(self._original_card_types)\n        self.keywords = self._original_keywords\n\n    # ------------------------------------------------------------------\n    # Hook methods — override in subclasses / card definitions\n    # ------------------------------------------------------------------\n\n    def can_cast(self, game: GameState) -> bool:\n        \"\"\"Return ``True`` if this card can currently be cast.\"\"\"\n        return True\n\n    def cost_reduction(self, game: GameState) -> int:\n        \"\"\"Return the generic mana reduction for casting this card.\n\n        Override in subclasses to implement cost-reduction mechanics\n        (e.g. Embercleave costs {1} less for each attacking creature).\n        The returned value is clamped so that generic mana cannot go below 0.\n        Only reduces generic mana — colored costs are never reduced.\n\n        Returns:\n            Non-negative integer representing generic mana to subtract.\n        \"\"\"\n        return 0\n\n    def on_cast(self, game: GameState) -> None:\n        \"\"\"Called when the card is cast (before it goes on the stack).\"\"\"\n\n    def on_resolve(self, game: GameState) -> None:\n        \"\"\"Called when the spell resolves from the stack.\n\n        Targets are available via ``self.chosen_targets`` — set at\n        resolve-time by :func:`~engine.casting._resolve_spell` from\n        :attr:`StackObject.targets`, or directly by test code.\n        \"\"\"\n\n    def get_targets(self, game: GameState) -> list[Any]:\n        \"\"\"Return a list of legal targets for this card.\"\"\"\n        return []\n\n    def register_triggers(self, game: GameState) -> None:\n        \"\"\"Register any triggered abilities this card provides.\"\"\"\n\n    def register_replacement_effects(self, game: GameState) -> None:\n        \"\"\"Register any replacement effects this card provides.\"\"\"\n\n    def get_activated_abilities(self) -> list[ActivatedAbility]:\n        \"\"\"Return activated abilities this card provides.\"\"\"\n        return []\n\n    def get_modes(self) -> list[Mode]:\n        \"\"\"Return available modes for modal spells/abilities.\n\n        Non-modal cards return an empty list by default.\n        \"\"\"\n        return []\n\n\n# ---------------------------------------------------------------------------\n# Creature\n# ---------------------------------------------------------------------------\n\nclass Creature(CardImpl):\n    \"\"\"A creature card.\n\n    Attributes:\n        base_power: The printed power value (rule 208.1). Immutable after init.\n        base_toughness: The printed toughness value. Immutable after init.\n        modified_power: Current power after continuous effects (Layer 7c), before counters.\n            Reset to ``base_power`` each effect cycle; continuous effects write here.\n        modified_toughness: Current toughness after continuous effects, before counters.\n        damage_marked: Amount of damage currently marked on this creature.\n        is_tapped: Whether the creature is tapped.\n        summoning_sick: Whether the creature has summoning sickness.\n        is_attacking: Combat flag — currently declared as an attacker.\n        is_blocking: Combat flag — currently declared as a blocker.\n        plus_one_counters: Number of +1/+1 counters.\n        minus_one_counters: Number of -1/-1 counters.\n        is_token: Whether this object is a token (for SBA checks).\n    \"\"\"\n\n    def __init__(\n        self,\n        name: str = \"\",\n        mana_cost: ManaCost | None = None,\n        card_types: set[CardType] | None = None,\n        subtypes: set[str] | None = None,\n        supertypes: set[Supertype] | None = None,\n        keywords: Keyword | None = None,\n        rules_text: str = \"\",\n        owner: Player | None = None,\n        controller: Player | None = None,\n        base_power: int = 0,\n        base_toughness: int = 0,\n    ) -> None:\n        # Always include CREATURE in card_types.\n        card_types = (card_types or set()) | {CardType.CREATURE}\n        super().__init__(\n            name=name,\n            mana_cost=mana_cost,\n            card_types=card_types,\n            subtypes=subtypes,\n            supertypes=supertypes,\n            keywords=keywords,\n            rules_text=rules_text,\n            owner=owner,\n            controller=controller,\n        )\n        self.base_power: int = base_power\n        self.base_toughness: int = base_toughness\n        self.modified_power: int = base_power\n        self.modified_toughness: int = base_toughness\n        self.damage_marked: int = 0\n        self.is_tapped: bool = False\n        self.summoning_sick: bool = True\n        self.is_attacking: bool = False\n        self.is_blocking: bool = False\n        self.plus_one_counters: int = 0\n        self.minus_one_counters: int = 0\n        self.is_token: bool = False\n        self.dealt_deathtouch_damage: bool = False\n        self._base_plus_one_counters: int = 0\n        self._base_minus_one_counters: int = 0\n\n    def _reset_characteristics(self) -> None:\n        \"\"\"Reset creature characteristics to pre-effect values.\"\"\"\n        super()._reset_characteristics()\n        self.modified_power = self.base_power\n        self.modified_toughness = self.base_toughness\n        self.plus_one_counters = self._base_plus_one_counters\n        self.minus_one_counters = self._base_minus_one_counters\n        # Reset combat-restriction flags set by continuous effects (e.g. Pacifism).\n        # These are reapplied by active effects during apply_all().\n        self._cant_attack: bool = False\n        self._cant_block: bool = False\n        self._cant_be_blocked: bool = False\n        self._cant_activate: bool = False\n        self._max_attackers_blocked: int = 1\n        # Clear granted protections so they are reapplied by active effects.\n        if hasattr(self, \"protections\"):\n            self.protections = []\n\n    @property\n    def counters(self) -> dict[str, int]:\n        \"\"\"Return a dict-like view of counters on this creature.\"\"\"\n        result: dict[str, int] = {}\n        if self.plus_one_counters > 0:\n            result[\"+1/+1\"] = self.plus_one_counters\n        if self.minus_one_counters > 0:\n            result[\"-1/-1\"] = self.minus_one_counters\n        return result\n\n    @property\n    def power(self) -> int:\n        \"\"\"Current power including counter modifications.\"\"\"\n        return self.modified_power + self.plus_one_counters - self.minus_one_counters\n\n    @property\n    def toughness(self) -> int:\n        \"\"\"Current toughness including counter modifications.\"\"\"\n        return self.modified_toughness + self.plus_one_counters - self.minus_one_counters\n\n\n# ---------------------------------------------------------------------------\n# Instant / Sorcery\n# ---------------------------------------------------------------------------\n\nclass Instant(CardImpl):\n    \"\"\"An instant spell — no extra fields beyond CardImpl.\"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.INSTANT}\n        super().__init__(**kwargs)\n\n\nclass Sorcery(CardImpl):\n    \"\"\"A sorcery spell — no extra fields beyond CardImpl.\"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.SORCERY}\n        super().__init__(**kwargs)\n\n\n# ---------------------------------------------------------------------------\n# Enchantment\n# ---------------------------------------------------------------------------\n\nclass Enchantment(CardImpl):\n    \"\"\"An enchantment card.\n\n    For auras, use the :class:`Aura` subclass which sets ``is_aura = True``.\n    The base ``Enchantment`` class retains the ``attached_to`` attribute for\n    backwards compatibility but marks ``is_aura = False`` so that state-based\n    actions do not treat a non-aura enchantment as an unattached aura.\n\n    Attributes:\n        attached_to: The object this enchantment is attached to (``None``\n            if not an aura or not yet attached).\n        is_aura: ``False`` for regular enchantments; ``True`` for auras.\n    \"\"\"\n\n    is_aura: bool = False\n\n    def __init__(self, attached_to: Any | None = None, **kwargs: Any) -> None:\n        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ENCHANTMENT}\n        super().__init__(**kwargs)\n        self.attached_to: Any | None = attached_to\n\n    def apply_continuous_effect(self, game: GameState) -> None:\n        \"\"\"Apply the enchantment's continuous effect to the game.\"\"\"\n\n    def on_enchant(self, game: GameState) -> None:\n        \"\"\"Called when this enchantment becomes attached to an object.\"\"\"\n\n    def on_detach(self, game: GameState) -> None:\n        \"\"\"Called when this enchantment is detached from its object.\"\"\"\n\n\nclass Aura(Enchantment):\n    \"\"\"An Aura enchantment — attaches to a permanent on the battlefield.\n\n    Sets ``is_aura = True`` so that state-based actions correctly identify\n    this as an aura (and move it to the graveyard when unattached).\n\n    Attributes:\n        is_aura: Always ``True`` for auras.\n    \"\"\"\n\n    is_aura: bool = True\n\n    def __init__(self, attached_to: Any | None = None, **kwargs: Any) -> None:\n        super().__init__(attached_to=attached_to, **kwargs)\n\n\n# ---------------------------------------------------------------------------\n# Artifact / ArtifactCreature\n# ---------------------------------------------------------------------------\n\nclass Artifact(CardImpl):\n    \"\"\"An artifact card.\n\n    Attributes:\n        is_tapped: Whether the artifact is currently tapped.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ARTIFACT}\n        super().__init__(**kwargs)\n        self.is_tapped: bool = False\n\n\nclass ArtifactCreature(Creature):\n    \"\"\"An artifact creature — combines Artifact and Creature types.\n\n    Inherits creature combat stats and behaviour from :class:`Creature`.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ARTIFACT, CardType.CREATURE}\n        super().__init__(**kwargs)\n\n\n# ---------------------------------------------------------------------------\n# Planeswalker\n# ---------------------------------------------------------------------------\n\nclass Planeswalker(CardImpl):\n    \"\"\"A planeswalker card.\n\n    Attributes:\n        starting_loyalty: The starting loyalty printed on the card.\n        loyalty: Current loyalty counter value.\n    \"\"\"\n\n    def __init__(\n        self,\n        starting_loyalty: int = 0,\n        **kwargs: Any,\n    ) -> None:\n        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.PLANESWALKER}\n        super().__init__(**kwargs)\n        self.starting_loyalty: int = starting_loyalty\n        self.loyalty: int = starting_loyalty\n\n    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n        \"\"\"Return the planeswalker's loyalty abilities.\"\"\"\n        return []\n\n\n# ---------------------------------------------------------------------------\n# Land\n# ---------------------------------------------------------------------------\n\nclass Land(CardImpl):\n    \"\"\"A land card.\n\n    Lands are not cast — they are played via a special action. ``can_cast``\n    always returns ``False``.\n\n    Attributes:\n        is_tapped: Whether the land is currently tapped.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.LAND}\n        super().__init__(**kwargs)\n        self.is_tapped: bool = False\n\n    def can_cast(self, game: GameState) -> bool:\n        \"\"\"Lands cannot be cast; they are played as a special action.\"\"\"\n        return False\n\n    def get_mana_abilities(self) -> list[ManaAbility]:\n        \"\"\"Return the land's mana abilities.\"\"\"\n        return []\n","numLines":502,"startLine":1,"totalLines":502}}}
