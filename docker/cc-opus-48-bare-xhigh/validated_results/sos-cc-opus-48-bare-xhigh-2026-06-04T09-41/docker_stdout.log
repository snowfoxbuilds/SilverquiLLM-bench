{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_0116vdWTyS7KbuJVVgWiYdra","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01RMRj9GLUw6zPk5FdrJaD8t","name":"Read","input":{"file_path":"/workspace/engine/casting.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":26096,"cache_read_input_tokens":18035,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":26096},"output_tokens":35,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"735f529e-7bc8-4328-a211-d2f095818fd0","uuid":"eb2977bf-c989-4f68-a77b-662250854ad2","request_id":"req_011Cbi1yPr8aouVd2tGJ7wUn"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RMRj9GLUw6zPk5FdrJaD8t","type":"tool_result","content":"1\t\"\"\"Casting and resolution pipeline for spells and lands.\n2\t\n3\tProvides the full flow from casting a spell or playing a land through\n4\tresolution:\n5\t\n6\t- :func:`cast_spell` — verify timing & legality → move hand to stack →\n7\t  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n8\t- :func:`play_land` — verify land play remaining → move hand to\n9\t  battlefield → decrement ``land_plays_remaining``.\n10\t- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n11\t  helpers used by the casting pipeline.\n12\t\n13\tResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\n14\tcreated by :func:`cast_spell`:\n15\t\n16\t- Call ``card.on_resolve(game)``.\n17\t- Permanents (creature / enchantment / artifact / planeswalker) move from\n18\t  the stack to the battlefield.\n19\t- Non-permanents (instant / sorcery) move to the graveyard.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import TYPE_CHECKING, Any\n25\t\n26\tfrom engine.card import CardImpl\n27\tfrom engine.stack import StackObject\n28\tfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\n29\tfrom engine.zones import move_zone\n30\t\n31\tif TYPE_CHECKING:\n32\t    from engine.game_state import GameState\n33\t    from engine.player import Player\n34\t\n35\t\n36\t# Card types that represent permanents — these go to the battlefield on resolve.\n37\t_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n38\t    CardType.CREATURE,\n39\t    CardType.ENCHANTMENT,\n40\t    CardType.ARTIFACT,\n41\t    CardType.PLANESWALKER,\n42\t})\n43\t\n44\t\n45\tclass CastingError(Exception):\n46\t    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n47\t\n48\t\n49\t# ------------------------------------------------------------------\n50\t# Timing helpers\n51\t# ------------------------------------------------------------------\n52\t\n53\tdef is_sorcery_speed(game: GameState, player: Player) -> bool:\n54\t    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n55\t\n56\t    Sorcery speed requires all of:\n57\t\n58\t    * *player* is the active player.\n59\t    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n60\t      ``POSTCOMBAT_MAIN``).\n61\t    * The stack is empty.\n62\t    \"\"\"\n63\t    if player is not game.active_player:\n64\t        return False\n65\t    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n66\t        return False\n67\t    if not game.stack.is_empty():\n68\t        return False\n69\t    return True\n70\t\n71\t\n72\tdef can_cast_at_instant_speed(card: CardImpl) -> bool:\n73\t    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n74\t\n75\t    A card has instant-speed timing if it is an instant or has the\n76\t    :attr:`~engine.types.Keyword.FLASH` keyword.\n77\t    \"\"\"\n78\t    if CardType.INSTANT in card.card_types:\n79\t        return True\n80\t    if Keyword.FLASH & card.keywords:\n81\t        return True\n82\t    return False\n83\t\n84\t\n85\t# ------------------------------------------------------------------\n86\t# Cost reduction\n87\t# ------------------------------------------------------------------\n88\t\n89\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n90\t    \"\"\"Return the generic mana reduction for casting *card*.\n91\t\n92\t    Queries ``card.cost_reduction(game)`` and clamps the result so that\n93\t    the generic portion of the mana cost cannot go below 0.\n94\t\n95\t    This is a simplified single-card self-reduction model.  Full MTG\n96\t    cost-reduction interactions (Trinisphere, multiple reductions from\n97\t    different sources) are deferred.\n98\t    \"\"\"\n99\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n100\t    # casting player even when the card was never explicitly assigned one.\n101\t    prev_controller = card.controller\n102\t    card.controller = controller\n103\t    raw = card.cost_reduction(game)\n104\t    # Restore previous controller in case the caller doesn't want a\n105\t    # side-effect (get_cost_reduction is a query, not a mutation).\n106\t    card.controller = prev_controller\n107\t    generic = card.mana_cost.generic if card.mana_cost else 0\n108\t    return max(0, min(raw, generic))\n109\t\n110\t\n111\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n112\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n113\t    new_generic = max(0, cost.generic - reduction)\n114\t    return ManaCost(\n115\t        generic=new_generic,\n116\t        pips=dict(cost.pips),\n117\t        x_count=cost.x_count,\n118\t        hybrid=list(cost.hybrid),\n119\t    )\n120\t\n121\t\n122\t# ------------------------------------------------------------------\n123\t# Cast spell\n124\t# ------------------------------------------------------------------\n125\t\n126\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n127\t    \"\"\"Cast *card* from *player*'s hand.\n128\t\n129\t    Pipeline\n130\t    --------\n131\t    1. **Timing check** — instants (and cards with flash) can be cast\n132\t       whenever the player has priority; everything else requires\n133\t       sorcery-speed timing.\n134\t    2. **can_cast** — ask the card whether it can legally be cast.\n135\t    3. **Hand check** — the card must be in the player's hand.\n136\t    4. **Move hand → stack zone** — remove the card from the hand and\n137\t       place it into the player's stack zone.\n138\t    5. **Choose targets** — if the card specifies targets (via\n139\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n140\t    6. **Mana check / payment** — the player's mana pool must be able to\n141\t       pay the card's mana cost.  If payment fails, the card is rolled\n142\t       back from the stack zone to the hand.\n143\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n144\t    8. **Push StackObject** — push a :class:`StackObject` whose\n145\t       ``on_resolve`` callback handles resolution.\n146\t\n147\t    Raises:\n148\t        CastingError: If any legality check fails.\n149\t    \"\"\"\n150\t    # 1. Timing\n151\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n152\t        raise CastingError(\n153\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n154\t        )\n155\t\n156\t    # 2. can_cast\n157\t    if not card.can_cast(game):\n158\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n159\t\n160\t    # 3. Hand check\n161\t    hand = game.get_hand(player)\n162\t    if not hand.contains(card):\n163\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n164\t\n165\t    # 4. Move card from hand to stack zone\n166\t    stack_zone = player.zones[Zone.STACK]\n167\t    hand.remove(card)\n168\t    stack_zone.add(card)\n169\t\n170\t    # Clear any stale colors_spent from a prior cast before new payment.\n171\t    if hasattr(card, \"colors_spent\"):\n172\t        del card.colors_spent\n173\t\n174\t    # 5. Choose targets\n175\t    target_specs = card.get_targets(game)\n176\t    chosen_targets: list[Any] = []\n177\t    if target_specs:\n178\t        for spec in target_specs:\n179\t            target = player.choose_target(target_specs, spec)\n180\t            # Validate against filter_fn if the spec provides one\n181\t            filter_fn = getattr(spec, \"filter_fn\", None)\n182\t            if filter_fn is not None and target is not None:\n183\t                if not filter_fn(target):\n184\t                    stack_zone.remove(card)\n185\t                    hand.add(card)\n186\t                    raise CastingError(\n187\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n188\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n189\t                    )\n190\t            chosen_targets.append(target)\n191\t\n192\t    # 5b. Protection check — reject targets that have protection from this\n193\t    #     spell (the T in DEBT).\n194\t    from engine.protection import has_protection_from\n195\t\n196\t    for target in chosen_targets:\n197\t        if has_protection_from(target, card):\n198\t            # Rollback: move card from stack zone back to hand\n199\t            stack_zone.remove(card)\n200\t            hand.add(card)\n201\t            raise CastingError(\n202\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n203\t            )\n204\t\n205\t    # Targets are stored on the StackObject (not the card) and passed\n206\t    # through the resolve pipeline via on_resolve(game, targets=...).\n207\t\n208\t    # 6. Mana check / payment (rollback on failure)\n209\t    # Ensure the card knows its controller so that cost_reduction() hooks\n210\t    # (e.g. Embercleave counting attacking creatures you control) see the\n211\t    # casting player, even for cards that were added to hand without an\n212\t    # explicit controller assignment.\n213\t    if card.controller is None:\n214\t        card.controller = player\n215\t    reduction = get_cost_reduction(game, card, player)\n216\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n217\t\n218\t    if not player.mana_pool.can_pay(effective_cost):\n219\t        # Rollback: move card from stack zone back to hand\n220\t        stack_zone.remove(card)\n221\t        hand.add(card)\n222\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n223\t\n224\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n225\t    player.mana_pool.pay(effective_cost)\n226\t\n227\t    # Store colors of mana spent on the card for mechanics like Converge\n228\t    # that care about the colors used to cast the spell.\n229\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n230\t\n231\t    # 7. Call on_cast hook\n232\t    card.on_cast(game)\n233\t\n234\t    # 8. Build on_resolve callback and push StackObject\n235\t    stack_obj = StackObject(\n236\t        source=card,\n237\t        controller=player,\n238\t        targets=chosen_targets,\n239\t        on_resolve=lambda g: None,  # replaced below\n240\t    )\n241\t\n242\t    def _on_resolve(g: GameState) -> None:\n243\t        _resolve_spell(g, card, player, stack_obj)\n244\t\n245\t    stack_obj.on_resolve = _on_resolve\n246\t    game.stack.push(stack_obj)\n247\t\n248\t\n249\t# ------------------------------------------------------------------\n250\t# Cast spell without paying mana cost (free-cast from any zone)\n251\t# ------------------------------------------------------------------\n252\t\n253\t\n254\tdef cast_spell_free(\n255\t    game: GameState,\n256\t    player: Player,\n257\t    card: CardImpl,\n258\t    from_zone: Zone,\n259\t) -> None:\n260\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n261\t\n262\t    This is used by effects that allow casting from zones other than hand\n263\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n264\t    or cascade.\n265\t\n266\t    Pipeline\n267\t    --------\n268\t    1. **can_cast** — ask the card whether it can legally be cast (same\n269\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n270\t    2. Move *card* from *from_zone* to the stack zone.\n271\t    3. Choose targets (if applicable) with validation and protection check.\n272\t    4. Call ``on_cast`` hook.\n273\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n274\t       resolution normally (permanents → battlefield, non-permanents →\n275\t       graveyard).\n276\t\n277\t    No timing check or mana payment is performed.  The spell goes on the\n278\t    stack and can be responded to normally (e.g. countered).\n279\t\n280\t    If targeting or other post-move checks fail, the card is rolled back\n281\t    to its source zone.\n282\t\n283\t    Parameters:\n284\t        game: The current game state.\n285\t        player: The player casting the spell.\n286\t        card: The card to cast.\n287\t        from_zone: The zone the card is currently in.\n288\t\n289\t    Raises:\n290\t        CastingError: If the card cannot be found in *from_zone* or\n291\t            legality checks fail.\n292\t    \"\"\"\n293\t    from engine.zones import move_to_zone\n294\t\n295\t    # Ensure controller is set\n296\t    card.controller = player\n297\t    if card.owner is None:\n298\t        card.owner = player\n299\t\n300\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n301\t    if not card.can_cast(game):\n302\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n303\t\n304\t    # 2. Locate card in source zone\n305\t    source_zone_container = player.zones[from_zone]\n306\t    if not source_zone_container.contains(card):\n307\t        # Try to find the card in any player's zone\n308\t        source_zone_container = None\n309\t        for p in game.players:\n310\t            z = p.zones[from_zone]\n311\t            if z.contains(card):\n312\t                source_zone_container = z\n313\t                break\n314\t\n315\t    if source_zone_container is None or not source_zone_container.contains(card):\n316\t        raise CastingError(\n317\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n318\t        )\n319\t\n320\t    # Move card from source zone to stack zone\n321\t    stack_zone = player.zones[Zone.STACK]\n322\t    source_zone_container.remove(card)\n323\t    stack_zone.add(card)\n324\t\n325\t    # 3. Choose targets (with rollback on failure)\n326\t    try:\n327\t        target_specs = card.get_targets(game)\n328\t        chosen_targets: list[Any] = []\n329\t        if target_specs:\n330\t            for spec in target_specs:\n331\t                target = player.choose_target(target_specs, spec)\n332\t                # Validate against filter_fn if the spec provides one\n333\t                filter_fn = getattr(spec, \"filter_fn\", None)\n334\t                if filter_fn is not None and target is not None:\n335\t                    if not filter_fn(target):\n336\t                        raise CastingError(\n337\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n338\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n339\t                        )\n340\t                chosen_targets.append(target)\n341\t\n342\t        # Protection check — reject targets that have protection from this spell\n343\t        from engine.protection import has_protection_from\n344\t\n345\t        for target in chosen_targets:\n346\t            if has_protection_from(target, card):\n347\t                raise CastingError(\n348\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n349\t                )\n350\t    except Exception as exc:\n351\t        # Rollback: move card from stack zone back to source zone\n352\t        stack_zone.remove(card)\n353\t        source_zone_container.add(card)\n354\t        raise CastingError(str(exc)) from exc\n355\t\n356\t    # 4. Call on_cast hook\n357\t    card.on_cast(game)\n358\t\n359\t    # 5. Build on_resolve callback and push StackObject\n360\t    stack_obj = StackObject(\n361\t        source=card,\n362\t        controller=player,\n363\t        targets=chosen_targets,\n364\t        on_resolve=lambda g: None,  # replaced below\n365\t    )\n366\t\n367\t    def _on_resolve(g: GameState) -> None:\n368\t        _resolve_spell(g, card, player, stack_obj)\n369\t\n370\t    stack_obj.on_resolve = _on_resolve\n371\t    game.stack.push(stack_obj)\n372\t\n373\t\n374\t# ------------------------------------------------------------------\n375\t# Resolution (called when the stack pops)\n376\t# ------------------------------------------------------------------\n377\t\n378\tdef _resolve_spell(\n379\t    game: GameState,\n380\t    card: CardImpl,\n381\t    player: Player,\n382\t    stack_obj: StackObject,\n383\t) -> None:\n384\t    \"\"\"Resolve *card* cast by *player*.\n385\t\n386\t    1. Call ``card.on_resolve(game, targets=targets)``.\n387\t    2. Remove the card from the stack zone.\n388\t    3. If the card is a permanent type, move it to the battlefield via\n389\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n390\t       registration and the ETB event).\n391\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n392\t    \"\"\"\n393\t    from engine.zones import move_to_zone\n394\t\n395\t    # Read targets from the StackObject — the single source of truth.\n396\t    # Set chosen_targets on the card just before resolution so that\n397\t    # _get_chosen_target helpers (which read via getattr) work.\n398\t    targets = stack_obj.targets\n399\t    if targets is not None:\n400\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n401\t\n402\t    card.on_resolve(game)\n403\t\n404\t    if card.card_types & _PERMANENT_TYPES:\n405\t        # Move from stack to battlefield via move_to_zone, which handles\n406\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n407\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n408\t    else:\n409\t        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n410\t        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n411\t\n412\t\n413\t# ------------------------------------------------------------------\n414\t# Play land (special action — does not use the stack)\n415\t# ------------------------------------------------------------------\n416\t\n417\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n418\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n419\t\n420\t    Requirements (all must hold):\n421\t\n422\t    * *land_card* has :attr:`CardType.LAND`.\n423\t    * *player* is the active player.\n424\t    * Current phase is a main phase.\n425\t    * The stack is empty.\n426\t    * ``player.land_plays_remaining > 0``.\n427\t    * The card is in the player's hand.\n428\t\n429\t    On success the card moves from hand to battlefield and\n430\t    ``land_plays_remaining`` is decremented.\n431\t\n432\t    Raises:\n433\t        CastingError: If any requirement is not met.\n434\t    \"\"\"\n435\t    # Must be a land\n436\t    if CardType.LAND not in land_card.card_types:\n437\t        raise CastingError(\n438\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n439\t        )\n440\t\n441\t    # Sorcery-speed timing (active player, main phase, stack empty)\n442\t    if not is_sorcery_speed(game, player):\n443\t        raise CastingError(\n444\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n445\t            \"during main phase with empty stack\"\n446\t        )\n447\t\n448\t    # Land plays remaining\n449\t    if player.land_plays_remaining <= 0:\n450\t        raise CastingError(\n451\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n452\t        )\n453\t\n454\t    # Card must be in hand\n455\t    hand = game.get_hand(player)\n456\t    if not hand.contains(land_card):\n457\t        raise CastingError(\n458\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n459\t        )\n460\t\n461\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n462\t    if land_card.owner is None:\n463\t        land_card.owner = player\n464\t    land_card.controller = player\n465\t\n466\t    # Move from hand to battlefield via move_to_zone, which fires\n467\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n468\t    from engine.zones import move_to_zone\n469\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n470\t\n471\t    # Decrement land plays\n472\t    player.land_plays_remaining -= 1\n473\t\n474\t\n475\tdef resolve_top(game: GameState) -> None:\n476\t    \"\"\"Resolve the top spell/ability on the stack.\n477\t\n478\t    Pops the top item from the stack, calls its on_resolve callback,\n479\t    then runs state-based actions.  If the stack is empty this is a no-op.\n480\t    \"\"\"\n481\t    if game.stack.is_empty():\n482\t        return\n483\t    from engine.state_based_actions import resolve_state_based_actions\n484\t\n485\t    obj = game.stack.pop()\n486\t    obj.on_resolve(game)\n487\t    resolve_state_based_actions(game)\n488\t"}]},"parent_tool_use_id":null,"session_id":"735f529e-7bc8-4328-a211-d2f095818fd0","uuid":"85530824-1cd7-44f0-9617-003b60f2aa55","timestamp":"2026-06-04T09:54:48.697Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"\"\"\"Casting and resolution pipeline for spells and lands.\n\nProvides the full flow from casting a spell or playing a land through\nresolution:\n\n- :func:`cast_spell` — verify timing & legality → move hand to stack →\n  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n- :func:`play_land` — verify land play remaining → move hand to\n  battlefield → decrement ``land_plays_remaining``.\n- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n  helpers used by the casting pipeline.\n\nResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\ncreated by :func:`cast_spell`:\n\n- Call ``card.on_resolve(game)``.\n- Permanents (creature / enchantment / artifact / planeswalker) move from\n  the stack to the battlefield.\n- Non-permanents (instant / sorcery) move to the graveyard.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import CardImpl\nfrom engine.stack import StackObject\nfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\nfrom engine.zones import move_zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n# Card types that represent permanents — these go to the battlefield on resolve.\n_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n    CardType.CREATURE,\n    CardType.ENCHANTMENT,\n    CardType.ARTIFACT,\n    CardType.PLANESWALKER,\n})\n\n\nclass CastingError(Exception):\n    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n\n\n# ------------------------------------------------------------------\n# Timing helpers\n# ------------------------------------------------------------------\n\ndef is_sorcery_speed(game: GameState, player: Player) -> bool:\n    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n\n    Sorcery speed requires all of:\n\n    * *player* is the active player.\n    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n      ``POSTCOMBAT_MAIN``).\n    * The stack is empty.\n    \"\"\"\n    if player is not game.active_player:\n        return False\n    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n        return False\n    if not game.stack.is_empty():\n        return False\n    return True\n\n\ndef can_cast_at_instant_speed(card: CardImpl) -> bool:\n    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n\n    A card has instant-speed timing if it is an instant or has the\n    :attr:`~engine.types.Keyword.FLASH` keyword.\n    \"\"\"\n    if CardType.INSTANT in card.card_types:\n        return True\n    if Keyword.FLASH & card.keywords:\n        return True\n    return False\n\n\n# ------------------------------------------------------------------\n# Cost reduction\n# ------------------------------------------------------------------\n\ndef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n    \"\"\"Return the generic mana reduction for casting *card*.\n\n    Queries ``card.cost_reduction(game)`` and clamps the result so that\n    the generic portion of the mana cost cannot go below 0.\n\n    This is a simplified single-card self-reduction model.  Full MTG\n    cost-reduction interactions (Trinisphere, multiple reductions from\n    different sources) are deferred.\n    \"\"\"\n    # Ensure card.controller is set so the hook can reference \"you\" / the\n    # casting player even when the card was never explicitly assigned one.\n    prev_controller = card.controller\n    card.controller = controller\n    raw = card.cost_reduction(game)\n    # Restore previous controller in case the caller doesn't want a\n    # side-effect (get_cost_reduction is a query, not a mutation).\n    card.controller = prev_controller\n    generic = card.mana_cost.generic if card.mana_cost else 0\n    return max(0, min(raw, generic))\n\n\ndef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n    new_generic = max(0, cost.generic - reduction)\n    return ManaCost(\n        generic=new_generic,\n        pips=dict(cost.pips),\n        x_count=cost.x_count,\n        hybrid=list(cost.hybrid),\n    )\n\n\n# ------------------------------------------------------------------\n# Cast spell\n# ------------------------------------------------------------------\n\ndef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n    \"\"\"Cast *card* from *player*'s hand.\n\n    Pipeline\n    --------\n    1. **Timing check** — instants (and cards with flash) can be cast\n       whenever the player has priority; everything else requires\n       sorcery-speed timing.\n    2. **can_cast** — ask the card whether it can legally be cast.\n    3. **Hand check** — the card must be in the player's hand.\n    4. **Move hand → stack zone** — remove the card from the hand and\n       place it into the player's stack zone.\n    5. **Choose targets** — if the card specifies targets (via\n       :meth:`CardImpl.get_targets`), the player is asked to choose.\n    6. **Mana check / payment** — the player's mana pool must be able to\n       pay the card's mana cost.  If payment fails, the card is rolled\n       back from the stack zone to the hand.\n    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n    8. **Push StackObject** — push a :class:`StackObject` whose\n       ``on_resolve`` callback handles resolution.\n\n    Raises:\n        CastingError: If any legality check fails.\n    \"\"\"\n    # 1. Timing\n    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n        )\n\n    # 2. can_cast\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 3. Hand check\n    hand = game.get_hand(player)\n    if not hand.contains(card):\n        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n\n    # 4. Move card from hand to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    hand.remove(card)\n    stack_zone.add(card)\n\n    # Clear any stale colors_spent from a prior cast before new payment.\n    if hasattr(card, \"colors_spent\"):\n        del card.colors_spent\n\n    # 5. Choose targets\n    target_specs = card.get_targets(game)\n    chosen_targets: list[Any] = []\n    if target_specs:\n        for spec in target_specs:\n            target = player.choose_target(target_specs, spec)\n            # Validate against filter_fn if the spec provides one\n            filter_fn = getattr(spec, \"filter_fn\", None)\n            if filter_fn is not None and target is not None:\n                if not filter_fn(target):\n                    stack_zone.remove(card)\n                    hand.add(card)\n                    raise CastingError(\n                        f\"Cannot cast {card.name!r} — chosen target does not \"\n                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                    )\n            chosen_targets.append(target)\n\n    # 5b. Protection check — reject targets that have protection from this\n    #     spell (the T in DEBT).\n    from engine.protection import has_protection_from\n\n    for target in chosen_targets:\n        if has_protection_from(target, card):\n            # Rollback: move card from stack zone back to hand\n            stack_zone.remove(card)\n            hand.add(card)\n            raise CastingError(\n                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n            )\n\n    # Targets are stored on the StackObject (not the card) and passed\n    # through the resolve pipeline via on_resolve(game, targets=...).\n\n    # 6. Mana check / payment (rollback on failure)\n    # Ensure the card knows its controller so that cost_reduction() hooks\n    # (e.g. Embercleave counting attacking creatures you control) see the\n    # casting player, even for cards that were added to hand without an\n    # explicit controller assignment.\n    if card.controller is None:\n        card.controller = player\n    reduction = get_cost_reduction(game, card, player)\n    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n\n    if not player.mana_pool.can_pay(effective_cost):\n        # Rollback: move card from stack zone back to hand\n        stack_zone.remove(card)\n        hand.add(card)\n        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n\n    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n    player.mana_pool.pay(effective_cost)\n\n    # Store colors of mana spent on the card for mechanics like Converge\n    # that care about the colors used to cast the spell.\n    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n\n    # 7. Call on_cast hook\n    card.on_cast(game)\n\n    # 8. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n\n# ------------------------------------------------------------------\n# Cast spell without paying mana cost (free-cast from any zone)\n# ------------------------------------------------------------------\n\n\ndef cast_spell_free(\n    game: GameState,\n    player: Player,\n    card: CardImpl,\n    from_zone: Zone,\n) -> None:\n    \"\"\"Cast *card* without paying its mana cost, using the stack.\n\n    This is used by effects that allow casting from zones other than hand\n    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n    or cascade.\n\n    Pipeline\n    --------\n    1. **can_cast** — ask the card whether it can legally be cast (same\n       legality as :func:`cast_spell`, minus mana/timing constraints).\n    2. Move *card* from *from_zone* to the stack zone.\n    3. Choose targets (if applicable) with validation and protection check.\n    4. Call ``on_cast`` hook.\n    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n       resolution normally (permanents → battlefield, non-permanents →\n       graveyard).\n\n    No timing check or mana payment is performed.  The spell goes on the\n    stack and can be responded to normally (e.g. countered).\n\n    If targeting or other post-move checks fail, the card is rolled back\n    to its source zone.\n\n    Parameters:\n        game: The current game state.\n        player: The player casting the spell.\n        card: The card to cast.\n        from_zone: The zone the card is currently in.\n\n    Raises:\n        CastingError: If the card cannot be found in *from_zone* or\n            legality checks fail.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Ensure controller is set\n    card.controller = player\n    if card.owner is None:\n        card.owner = player\n\n    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 2. Locate card in source zone\n    source_zone_container = player.zones[from_zone]\n    if not source_zone_container.contains(card):\n        # Try to find the card in any player's zone\n        source_zone_container = None\n        for p in game.players:\n            z = p.zones[from_zone]\n            if z.contains(card):\n                source_zone_container = z\n                break\n\n    if source_zone_container is None or not source_zone_container.contains(card):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n        )\n\n    # Move card from source zone to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    source_zone_container.remove(card)\n    stack_zone.add(card)\n\n    # 3. Choose targets (with rollback on failure)\n    try:\n        target_specs = card.get_targets(game)\n        chosen_targets: list[Any] = []\n        if target_specs:\n            for spec in target_specs:\n                target = player.choose_target(target_specs, spec)\n                # Validate against filter_fn if the spec provides one\n                filter_fn = getattr(spec, \"filter_fn\", None)\n                if filter_fn is not None and target is not None:\n                    if not filter_fn(target):\n                        raise CastingError(\n                            f\"Cannot cast {card.name!r} — chosen target does not \"\n                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                        )\n                chosen_targets.append(target)\n\n        # Protection check — reject targets that have protection from this spell\n        from engine.protection import has_protection_from\n\n        for target in chosen_targets:\n            if has_protection_from(target, card):\n                raise CastingError(\n                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n                )\n    except Exception as exc:\n        # Rollback: move card from stack zone back to source zone\n        stack_zone.remove(card)\n        source_zone_container.add(card)\n        raise CastingError(str(exc)) from exc\n\n    # 4. Call on_cast hook\n    card.on_cast(game)\n\n    # 5. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n\n# ------------------------------------------------------------------\n# Resolution (called when the stack pops)\n# ------------------------------------------------------------------\n\ndef _resolve_spell(\n    game: GameState,\n    card: CardImpl,\n    player: Player,\n    stack_obj: StackObject,\n) -> None:\n    \"\"\"Resolve *card* cast by *player*.\n\n    1. Call ``card.on_resolve(game, targets=targets)``.\n    2. Remove the card from the stack zone.\n    3. If the card is a permanent type, move it to the battlefield via\n       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n       registration and the ETB event).\n    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Read targets from the StackObject — the single source of truth.\n    # Set chosen_targets on the card just before resolution so that\n    # _get_chosen_target helpers (which read via getattr) work.\n    targets = stack_obj.targets\n    if targets is not None:\n        card.chosen_targets = targets  # type: ignore[attr-defined]\n\n    card.on_resolve(game)\n\n    if card.card_types & _PERMANENT_TYPES:\n        # Move from stack to battlefield via move_to_zone, which handles\n        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n    else:\n        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n\n\n# ------------------------------------------------------------------\n# Play land (special action — does not use the stack)\n# ------------------------------------------------------------------\n\ndef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n\n    Requirements (all must hold):\n\n    * *land_card* has :attr:`CardType.LAND`.\n    * *player* is the active player.\n    * Current phase is a main phase.\n    * The stack is empty.\n    * ``player.land_plays_remaining > 0``.\n    * The card is in the player's hand.\n\n    On success the card moves from hand to battlefield and\n    ``land_plays_remaining`` is decremented.\n\n    Raises:\n        CastingError: If any requirement is not met.\n    \"\"\"\n    # Must be a land\n    if CardType.LAND not in land_card.card_types:\n        raise CastingError(\n            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n        )\n\n    # Sorcery-speed timing (active player, main phase, stack empty)\n    if not is_sorcery_speed(game, player):\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — must be active player \"\n            \"during main phase with empty stack\"\n        )\n\n    # Land plays remaining\n    if player.land_plays_remaining <= 0:\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n        )\n\n    # Card must be in hand\n    hand = game.get_hand(player)\n    if not hand.contains(land_card):\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — card not in hand\"\n        )\n\n    # Ensure owner/controller are set so move_to_zone routes correctly.\n    if land_card.owner is None:\n        land_card.owner = player\n    land_card.controller = player\n\n    # Move from hand to battlefield via move_to_zone, which fires\n    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n    from engine.zones import move_to_zone\n    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n\n    # Decrement land plays\n    player.land_plays_remaining -= 1\n\n\ndef resolve_top(game: GameState) -> None:\n    \"\"\"Resolve the top spell/ability on the stack.\n\n    Pops the top item from the stack, calls its on_resolve callback,\n    then runs state-based actions.  If the stack is empty this is a no-op.\n    \"\"\"\n    if game.stack.is_empty():\n        return\n    from engine.state_based_actions import resolve_state_based_actions\n\n    obj = game.stack.pop()\n    obj.on_resolve(game)\n    resolve_state_based_actions(game)\n","numLines":488,"startLine":1,"totalLines":488}}}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_0116vdWTyS7KbuJVVgWiYdra","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01N3ZyU8DrA1eFHAhmNu2dpG","name":"Read","input":{"file_path":"/workspace/engine/combat.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":26096,"cache_read_input_tokens":18035,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":26096},"output_tokens":35,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"735f529e-7bc8-4328-a211-d2f095818fd0","uuid":"a251412e-1677-4f0b-97d6-5058b2cf29c9","request_id":"req_011Cbi1yPr8aouVd2tGJ7wUn"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N3ZyU8DrA1eFHAhmNu2dpG","type":"tool_result","content":"1\t\"\"\"Combat system: declare attackers → declare blockers → damage → end combat.\n2\t\n3\tImplements the four substeps of the MTG combat phase:\n4\t\n5\t1. **Declare Attackers** — Active player chooses creatures to attack with.\n6\t   Attackers are tapped (unless they have vigilance).  Creatures with\n7\t   summoning sickness (without haste) or the defender keyword cannot attack.\n8\t\n9\t2. **Declare Blockers** — Defending player assigns blockers.  Creatures\n10\t   with flying can only be blocked by creatures with flying or reach.\n11\t   Creatures with menace require 2+ blockers.  The attacker's controller\n12\t   orders the blockers for damage assignment.\n13\t\n14\t3. **Combat Damage** — First strike / double strike creatures deal damage\n15\t   first, then state-based actions are checked, then normal damage.\n16\t   Trample excess goes to the defending player.  Lifelink heals the\n17\t   controller.  Deathtouch makes any nonzero damage lethal.  Unblocked\n18\t   attackers deal damage to the defending player.\n19\t\n20\t4. **End Combat** — Clear all combat state.\n21\t\n22\tReferences: MTG Comprehensive Rules §506–§511.\n23\t\"\"\"\n24\t\n25\tfrom __future__ import annotations\n26\t\n27\tfrom dataclasses import dataclass, field\n28\tfrom typing import TYPE_CHECKING, Any\n29\t\n30\tfrom engine.types import Keyword\n31\t\n32\tif TYPE_CHECKING:\n33\t    from engine.game_state import GameState\n34\t    from engine.player import Player\n35\t\n36\t\n37\t# ---------------------------------------------------------------------------\n38\t# CombatState — tracks all per-combat information\n39\t# ---------------------------------------------------------------------------\n40\t\n41\t@dataclass\n42\tclass CombatState:\n43\t    \"\"\"Tracks attackers, blockers, damage assignments, and block ordering.\n44\t\n45\t    Attributes:\n46\t        attackers: Mapping of attacking creature → defending player.\n47\t        blockers: Mapping of blocking creature → list of attackers it blocks.\n48\t        attacker_blockers: Mapping of attacking creature → ordered list of\n49\t            blockers assigned to it (order used for damage assignment).\n50\t        damage_assignments: Mapping of creature → list of\n51\t            ``(target, amount)`` tuples describing how damage is assigned.\n52\t        was_blocked: Set of attackers that were declared as blocked.  Per\n53\t            MTG rule 509.1h, once a creature is blocked it stays blocked\n54\t            even if all its blockers are removed before damage.\n55\t        in_combat: Whether the combat phase is currently active.\n56\t    \"\"\"\n57\t\n58\t    attackers: dict[Any, Player] = field(default_factory=dict)\n59\t    blockers: dict[Any, list[Any]] = field(default_factory=dict)\n60\t    attacker_blockers: dict[Any, list[Any]] = field(default_factory=dict)\n61\t    damage_assignments: dict[Any, list[tuple[Any, int]]] = field(default_factory=dict)\n62\t    was_blocked: set[Any] = field(default_factory=set)\n63\t    in_combat: bool = False\n64\t\n65\t    def clear(self) -> None:\n66\t        \"\"\"Reset all combat state.\"\"\"\n67\t        self.attackers.clear()\n68\t        self.blockers.clear()\n69\t        self.attacker_blockers.clear()\n70\t        self.damage_assignments.clear()\n71\t        self.was_blocked.clear()\n72\t        self.in_combat = False\n73\t\n74\t\n75\t# ---------------------------------------------------------------------------\n76\t# Helpers\n77\t# ---------------------------------------------------------------------------\n78\t\n79\tdef _can_attack(creature: Any) -> bool:\n80\t    \"\"\"Return ``True`` if *creature* is eligible to be declared as an attacker.\n81\t\n82\t    A creature cannot attack if:\n83\t    - It is already tapped.\n84\t    - It has the ``DEFENDER`` keyword.\n85\t    - It has summoning sickness (``summoning_sick``) and does not have ``HASTE``.\n86\t    - A continuous effect has set ``_cant_attack`` (e.g. Pacifism).\n87\t    \"\"\"\n88\t    if getattr(creature, \"is_tapped\", False):\n89\t        return False\n90\t\n91\t    # Check for \"can't attack\" restriction (set by continuous effects like Pacifism)\n92\t    if getattr(creature, \"_cant_attack\", False):\n93\t        return False\n94\t\n95\t    keywords = getattr(creature, \"keywords\", Keyword(0))\n96\t\n97\t    if Keyword.DEFENDER in keywords:\n98\t        return False\n99\t\n100\t    if getattr(creature, \"summoning_sick\", False) and Keyword.HASTE not in keywords:\n101\t        return False\n102\t\n103\t    return True\n104\t\n105\t\n106\tdef _can_block(blocker: Any, attacker: Any) -> bool:\n107\t    \"\"\"Return ``True`` if *blocker* can legally block *attacker*.\n108\t\n109\t    Checks:\n110\t    - If the blocker is tapped it cannot block.\n111\t    - A continuous effect has set ``_cant_block`` (e.g. Pacifism).\n112\t    - If the attacker has flying, the blocker must have flying or reach.\n113\t    \"\"\"\n114\t    if getattr(blocker, \"is_tapped\", False):\n115\t        return False\n116\t\n117\t    # Check for \"can't block\" restriction (set by continuous effects like Pacifism)\n118\t    if getattr(blocker, \"_cant_block\", False):\n119\t        return False\n120\t\n121\t    attacker_kw = getattr(attacker, \"keywords\", Keyword(0))\n122\t    blocker_kw = getattr(blocker, \"keywords\", Keyword(0))\n123\t\n124\t    # Flying check\n125\t    if Keyword.FLYING in attacker_kw:\n126\t        if Keyword.FLYING not in blocker_kw and Keyword.REACH not in blocker_kw:\n127\t            return False\n128\t\n129\t    # Protection check — attacker with protection from blocker can't be blocked\n130\t    from engine.protection import has_protection_from\n131\t\n132\t    if has_protection_from(attacker, blocker):\n133\t        return False\n134\t\n135\t    return True\n136\t\n137\t\n138\tdef _get_lethal_damage(creature: Any, attacker: Any | None = None) -> int:\n139\t    \"\"\"Return the amount of damage needed to lethally assign to *creature*.\n140\t\n141\t    If *attacker* has deathtouch, 1 damage is lethal.\n142\t    Otherwise it's ``toughness - damage_marked`` (at least 1).\n143\t    \"\"\"\n144\t    if attacker is not None:\n145\t        attacker_kw = getattr(attacker, \"keywords\", Keyword(0))\n146\t        if Keyword.DEATHTOUCH in attacker_kw:\n147\t            return 1\n148\t\n149\t    toughness = getattr(creature, \"toughness\", 0)\n150\t    damage_marked = getattr(creature, \"damage_marked\", 0)\n151\t    return max(1, toughness - damage_marked)\n152\t\n153\t\n154\tdef _deal_damage(\n155\t    source: Any,\n156\t    target: Any,\n157\t    amount: int,\n158\t    game: GameState,\n159\t    combat_state: CombatState,\n160\t) -> None:\n161\t    \"\"\"Apply *amount* damage from *source* to *target*.\n162\t\n163\t    If *target* is a player, reduces life.\n164\t    If *target* is a creature, marks damage on it.\n165\t    If *source* has lifelink, the controller gains that much life.\n166\t\n167\t    Protection prevents damage from sources with the protected-from quality.\n168\t    \"\"\"\n169\t    if amount <= 0:\n170\t        return\n171\t\n172\t    # Protection prevents damage (D in DEBT).\n173\t    from engine.protection import has_protection_from\n174\t\n175\t    if has_protection_from(target, source):\n176\t        return\n177\t\n178\t    # Record damage assignment\n179\t    if source not in combat_state.damage_assignments:\n180\t        combat_state.damage_assignments[source] = []\n181\t    combat_state.damage_assignments[source].append((target, amount))\n182\t\n183\t    # Apply damage\n184\t    if hasattr(target, \"life\"):\n185\t        # Target is a player\n186\t        target.life -= amount\n187\t    elif hasattr(target, \"damage_marked\"):\n188\t        # Target is a creature\n189\t        target.damage_marked += amount\n190\t\n191\t        # Track deathtouch damage for SBA rule 704.5h\n192\t        source_kw_dt = getattr(source, \"keywords\", Keyword(0))\n193\t        if Keyword.DEATHTOUCH in source_kw_dt:\n194\t            target.dealt_deathtouch_damage = True\n195\t\n196\t    # Lifelink: controller gains life equal to damage dealt\n197\t    source_kw = getattr(source, \"keywords\", Keyword(0))\n198\t    if Keyword.LIFELINK in source_kw:\n199\t        controller = getattr(source, \"controller\", None)\n200\t        if controller is not None and hasattr(controller, \"life\"):\n201\t            controller.life += amount\n202\t\n203\t\n204\t# ---------------------------------------------------------------------------\n205\t# Combat steps\n206\t# ---------------------------------------------------------------------------\n207\t\n208\tdef declare_attackers_step(game: GameState) -> None:\n209\t    \"\"\"Declare attackers step: active player chooses creatures to attack with.\n210\t\n211\t    The active player is asked (via :meth:`Player.choose`) to select a set\n212\t    of creatures to attack with.  Each chosen attacker is tapped (unless it\n213\t    has vigilance) and its ``is_attacking`` flag is set.\n214\t\n215\t    Parameters:\n216\t        game: The current game state.  ``game.combat_state`` must exist.\n217\t    \"\"\"\n218\t    combat = game.combat_state\n219\t    combat.in_combat = True\n220\t    active = game.active_player\n221\t    defending = game.non_active_player\n222\t\n223\t    # Gather legal attackers from the active player's battlefield\n224\t    from engine.types import Zone\n225\t    bf = active.zones[Zone.BATTLEFIELD]\n226\t    eligible = [\n227\t        c for c in bf.get_all()\n228\t        if hasattr(c, \"base_power\") and _can_attack(c)\n229\t    ]\n230\t\n231\t    if not eligible:\n232\t        return\n233\t\n234\t    # Active player chooses which creatures to attack with\n235\t    chosen = active.choose(eligible, \"declare attackers\")\n236\t\n237\t    # Normalize to a list\n238\t    if chosen is None:\n239\t        return\n240\t    if not isinstance(chosen, list):\n241\t        chosen = [chosen]\n242\t\n243\t    # Validate and register attackers\n244\t    for attacker in chosen:\n245\t        if attacker not in eligible:\n246\t            continue\n247\t        if not _can_attack(attacker):\n248\t            continue\n249\t\n250\t        combat.attackers[attacker] = defending\n251\t        combat.attacker_blockers[attacker] = []\n252\t        attacker.is_attacking = True\n253\t\n254\t        # Tap the attacker unless it has vigilance\n255\t        kw = getattr(attacker, \"keywords\", Keyword(0))\n256\t        if Keyword.VIGILANCE not in kw:\n257\t            attacker.is_tapped = True\n258\t\n259\t\n260\tdef declare_blockers_step(game: GameState) -> None:\n261\t    \"\"\"Declare blockers step: defending player assigns blockers.\n262\t\n263\t    The defending player is asked (via :meth:`Player.choose`) to assign\n264\t    blockers.  The expected format is a dict mapping blocker → attacker\n265\t    (or blocker → list of attackers for multi-blocking scenarios), but\n266\t    commonly blocker → attacker.\n267\t\n268\t    After blockers are assigned:\n269\t    - Menace check: attackers with menace must be blocked by 2+ creatures.\n270\t    - Flying/reach check is already handled by ``_can_block``.\n271\t    - The attacking player orders blockers for each attacker (for damage\n272\t      assignment).\n273\t\n274\t    Parameters:\n275\t        game: The current game state.\n276\t    \"\"\"\n277\t    combat = game.combat_state\n278\t\n279\t    if not combat.attackers:\n280\t        return\n281\t\n282\t    defending = game.non_active_player\n283\t    active = game.active_player\n284\t\n285\t    from engine.types import Zone\n286\t    bf_defending = defending.zones[Zone.BATTLEFIELD]\n287\t    eligible_blockers = [\n288\t        c for c in bf_defending.get_all()\n289\t        if hasattr(c, \"base_power\") and not getattr(c, \"is_tapped\", False)\n290\t    ]\n291\t\n292\t    if not eligible_blockers:\n293\t        return\n294\t\n295\t    # Defending player chooses block assignments\n296\t    # Expected format: dict mapping blocker → attacker (or list of attackers)\n297\t    block_assignments = defending.choose(\n298\t        eligible_blockers,\n299\t        \"declare blockers\",\n300\t    )\n301\t\n302\t    if block_assignments is None:\n303\t        return\n304\t\n305\t    if not isinstance(block_assignments, dict):\n306\t        return\n307\t\n308\t    # Process block assignments\n309\t    for blocker, target in block_assignments.items():\n310\t        # Validate that the blocker is in the eligible set\n311\t        if blocker not in eligible_blockers:\n312\t            continue\n313\t        targets = target if isinstance(target, list) else [target]\n314\t        valid_targets = []\n315\t        max_blocked = getattr(blocker, \"_max_attackers_blocked\", 1)\n316\t        for attacker in targets:\n317\t            if len(valid_targets) >= max_blocked:\n318\t                break\n319\t            if attacker in combat.attackers and _can_block(blocker, attacker):\n320\t                valid_targets.append(attacker)\n321\t        if valid_targets:\n322\t            combat.blockers[blocker] = valid_targets\n323\t            blocker.is_blocking = True\n324\t            for attacker in valid_targets:\n325\t                if attacker not in combat.attacker_blockers:\n326\t                    combat.attacker_blockers[attacker] = []\n327\t                combat.attacker_blockers[attacker].append(blocker)\n328\t\n329\t    # Menace check: attackers with menace that have fewer than 2 blockers\n330\t    # are treated as unblocked (remove the single blocker assignment).\n331\t    for attacker, blocker_list in list(combat.attacker_blockers.items()):\n332\t        kw = getattr(attacker, \"keywords\", Keyword(0))\n333\t        if Keyword.MENACE in kw and len(blocker_list) < 2 and len(blocker_list) > 0:\n334\t            # Illegal block — remove these blockers\n335\t            for b in blocker_list:\n336\t                if b in combat.blockers:\n337\t                    combat.blockers[b] = [\n338\t                        a for a in combat.blockers[b] if a is not attacker\n339\t                    ]\n340\t                    if not combat.blockers[b]:\n341\t                        del combat.blockers[b]\n342\t                        b.is_blocking = False\n343\t            combat.attacker_blockers[attacker] = []\n344\t\n345\t    # Mark attackers that have at least one blocker as \"was_blocked\".\n346\t    # Per MTG rule 509.1h, once a creature is blocked it remains blocked\n347\t    # even if all its blockers are removed before the damage step.\n348\t    for attacker, blocker_list in combat.attacker_blockers.items():\n349\t        if blocker_list:\n350\t            combat.was_blocked.add(attacker)\n351\t\n352\t    # Controller of each attacker orders the blockers for damage assignment\n353\t    for attacker, blocker_list in combat.attacker_blockers.items():\n354\t        if len(blocker_list) > 1:\n355\t            controller = getattr(attacker, \"controller\", active)\n356\t            ordered = controller.assign_damage_order(blocker_list)\n357\t            combat.attacker_blockers[attacker] = ordered\n358\t\n359\t\n360\tdef combat_damage_step(game: GameState) -> None:\n361\t    \"\"\"Combat damage step: deal combat damage.\n362\t\n363\t    Handles:\n364\t    - First strike / double strike creatures deal damage first.\n365\t    - State-based actions are checked between first-strike and normal damage.\n366\t    - Trample: excess damage over blocker toughness → defending player.\n367\t    - Lifelink: controller gains life equal to damage dealt.\n368\t    - Deathtouch: any damage is lethal (1 damage = lethal assignment).\n369\t    - Unblocked attackers deal damage to defending player.\n370\t\n371\t    Parameters:\n372\t        game: The current game state.\n373\t    \"\"\"\n374\t    from engine.state_based_actions import resolve_state_based_actions\n375\t\n376\t    combat = game.combat_state\n377\t\n378\t    if not combat.attackers:\n379\t        return\n380\t\n381\t    all_attackers = list(combat.attackers.keys())\n382\t\n383\t    # Determine if a first-strike damage sub-step is needed\n384\t    # Check both attackers and blockers for first strike / double strike\n385\t    all_blockers = set()\n386\t    for blocker_list in combat.attacker_blockers.values():\n387\t        all_blockers.update(blocker_list)\n388\t\n389\t    has_first_strike_step = any(\n390\t        Keyword.FIRST_STRIKE in getattr(c, \"keywords\", Keyword(0))\n391\t        or Keyword.DOUBLE_STRIKE in getattr(c, \"keywords\", Keyword(0))\n392\t        for c in list(all_attackers) + list(all_blockers)\n393\t    )\n394\t\n395\t    # --- First strike damage sub-step ---\n396\t    if has_first_strike_step:\n397\t        _assign_combat_damage(all_attackers, combat, game, is_first_strike=True)\n398\t        resolve_state_based_actions(game)\n399\t\n400\t    # --- Normal damage sub-step ---\n401\t    _assign_combat_damage(all_attackers, combat, game, is_first_strike=False)\n402\t    resolve_state_based_actions(game)\n403\t\n404\t\n405\tdef _assign_combat_damage(\n406\t    attackers: list[Any],\n407\t    combat: CombatState,\n408\t    game: GameState,\n409\t    *,\n410\t    is_first_strike: bool = False,\n411\t) -> None:\n412\t    \"\"\"Assign and deal combat damage for a set of attackers.\n413\t\n414\t    For each attacker:\n415\t    - If unblocked → damage to defending player.\n416\t    - If blocked → damage assigned to blockers in order.  With trample,\n417\t      excess damage goes to the defending player.\n418\t    - Blockers deal damage back to the attacker they block.\n419\t\n420\t    When *is_first_strike* is ``True``, only creatures with\n421\t    ``FIRST_STRIKE`` or ``DOUBLE_STRIKE`` deal damage (both attackers\n422\t    and blockers).  When ``False``, only creatures *without*\n423\t    ``FIRST_STRIKE`` deal damage (plus ``DOUBLE_STRIKE`` creatures,\n424\t    which participate in both steps).  Blockers that are no longer on\n425\t    the battlefield (e.g. killed by first-strike damage and removed by\n426\t    SBAs) are skipped.\n427\t    \"\"\"\n428\t    from engine.types import Zone\n429\t\n430\t    # Track which blockers have already dealt their damage this sub-step\n431\t    # (blockers only deal damage once even if blocking multiple attackers)\n432\t    blockers_dealt: set[int] = set()\n433\t\n434\t    for attacker in attackers:\n435\t        if attacker not in combat.attackers:\n436\t            continue\n437\t\n438\t        kw = getattr(attacker, \"keywords\", Keyword(0))\n439\t        has_first = Keyword.FIRST_STRIKE in kw\n440\t        has_double = Keyword.DOUBLE_STRIKE in kw\n441\t\n442\t        # Determine if this attacker deals damage in this sub-step\n443\t        if is_first_strike:\n444\t            attacker_deals = has_first or has_double\n445\t        else:\n446\t            attacker_deals = not has_first or has_double\n447\t\n448\t        # Skip if attacker is no longer on the battlefield\n449\t        if attacker_deals:\n450\t            controller = getattr(attacker, \"controller\", None)\n451\t            if controller is not None:\n452\t                bf = controller.zones[Zone.BATTLEFIELD]\n453\t                if not bf.contains(attacker):\n454\t                    attacker_deals = False\n455\t\n456\t        defending_player = combat.attackers[attacker]\n457\t        blocker_list = combat.attacker_blockers.get(attacker, [])\n458\t        attacker_kw = getattr(attacker, \"keywords\", Keyword(0))\n459\t\n460\t        if attacker_deals:\n461\t            power = getattr(attacker, \"power\", 0)\n462\t\n463\t            # Check if attacker was blocked.  Per MTG rule 509.1h, a blocked\n464\t            # creature stays blocked even if all its blockers are removed.\n465\t            is_blocked = attacker in combat.was_blocked\n466\t\n467\t            if not is_blocked and not blocker_list:\n468\t                # Truly unblocked → damage to defending player\n469\t                _deal_damage(attacker, defending_player, power, game, combat)\n470\t            elif is_blocked and not blocker_list:\n471\t                # Was blocked but all blockers removed.\n472\t                # Without trample: deals no damage.\n473\t                # With trample: all damage tramples to defending player.\n474\t                has_trample = Keyword.TRAMPLE in attacker_kw\n475\t                if has_trample:\n476\t                    _deal_damage(attacker, defending_player, power, game, combat)\n477\t                # else: no damage dealt\n478\t            else:\n479\t                # Blocked → assign damage to blockers in order\n480\t                has_trample = Keyword.TRAMPLE in attacker_kw\n481\t                remaining_damage = power\n482\t\n483\t                for i, blocker in enumerate(blocker_list):\n484\t                    if remaining_damage <= 0:\n485\t                        break\n486\t\n487\t                    lethal = _get_lethal_damage(blocker, attacker)\n488\t\n489\t                    if i < len(blocker_list) - 1:\n490\t                        # Not the last blocker — assign lethal damage\n491\t                        assign = min(lethal, remaining_damage)\n492\t                    else:\n493\t                        # Last blocker\n494\t                        if has_trample:\n495\t                            # With trample: assign lethal, rest tramples through\n496\t                            assign = min(lethal, remaining_damage)\n497\t                        else:\n498\t                            # Without trample: all remaining damage to last blocker\n499\t                            assign = remaining_damage\n500\t\n501\t                    _deal_damage(attacker, blocker, assign, game, combat)\n502\t                    remaining_damage -= assign\n503\t\n504\t                # Trample: excess damage to defending player\n505\t                if has_trample and remaining_damage > 0:\n506\t                    _deal_damage(attacker, defending_player, remaining_damage, game, combat)\n507\t\n508\t        # Blockers deal damage back to the attacker\n509\t        for blocker in blocker_list:\n510\t            if id(blocker) not in blockers_dealt:\n511\t                blocker_kw = getattr(blocker, \"keywords\", Keyword(0))\n512\t                blocker_has_first = Keyword.FIRST_STRIKE in blocker_kw\n513\t                blocker_has_double = Keyword.DOUBLE_STRIKE in blocker_kw\n514\t\n515\t                # Determine if this blocker deals damage in this sub-step\n516\t                if is_first_strike:\n517\t                    should_deal = blocker_has_first or blocker_has_double\n518\t                else:\n519\t                    should_deal = not blocker_has_first or blocker_has_double\n520\t\n521\t                # Skip if blocker is no longer on the battlefield\n522\t                if should_deal:\n523\t                    blocker_ctrl = getattr(blocker, \"controller\", None)\n524\t                    if blocker_ctrl is not None:\n525\t                        bf = blocker_ctrl.zones[Zone.BATTLEFIELD]\n526\t                        if not bf.contains(blocker):\n527\t                            should_deal = False\n528\t\n529\t                if should_deal:\n530\t                    blocker_power = getattr(blocker, \"power\", 0)\n531\t                    _deal_damage(blocker, attacker, blocker_power, game, combat)\n532\t                    blockers_dealt.add(id(blocker))\n533\t\n534\t\n535\tdef end_combat_step(game: GameState) -> None:\n536\t    \"\"\"End combat step: remove from combat and clear combat state.\n537\t\n538\t    Resets ``is_attacking`` and ``is_blocking`` flags on all creatures\n539\t    and clears the combat state.\n540\t\n541\t    Parameters:\n542\t        game: The current game state.\n543\t    \"\"\"\n544\t    combat = game.combat_state\n545\t\n546\t    # Clear combat flags on all attackers\n547\t    for attacker in combat.attackers:\n548\t        if hasattr(attacker, \"is_attacking\"):\n549\t            attacker.is_attacking = False\n550\t\n551\t    # Clear combat flags on all blockers\n552\t    for blocker in combat.blockers:\n553\t        if hasattr(blocker, \"is_blocking\"):\n554\t            blocker.is_blocking = False\n555\t\n556\t    combat.clear()\n557\t"}]},"parent_tool_use_id":null,"session_id":"735f529e-7bc8-4328-a211-d2f095818fd0","uuid":"8b9930b8-ca61-47b3-8a19-2d30e4f3ae23","timestamp":"2026-06-04T09:54:48.946Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/combat.py","content":"\"\"\"Combat system: declare attackers → declare blockers → damage → end combat.\n\nImplements the four substeps of the MTG combat phase:\n\n1. **Declare Attackers** — Active player chooses creatures to attack with.\n   Attackers are tapped (unless they have vigilance).  Creatures with\n   summoning sickness (without haste) or the defender keyword cannot attack.\n\n2. **Declare Blockers** — Defending player assigns blockers.  Creatures\n   with flying can only be blocked by creatures with flying or reach.\n   Creatures with menace require 2+ blockers.  The attacker's controller\n   orders the blockers for damage assignment.\n\n3. **Combat Damage** — First strike / double strike creatures deal damage\n   first, then state-based actions are checked, then normal damage.\n   Trample excess goes to the defending player.  Lifelink heals the\n   controller.  Deathtouch makes any nonzero damage lethal.  Unblocked\n   attackers deal damage to the defending player.\n\n4. **End Combat** — Clear all combat state.\n\nReferences: MTG Comprehensive Rules §506–§511.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.types import Keyword\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n# ---------------------------------------------------------------------------\n# CombatState — tracks all per-combat information\n# ---------------------------------------------------------------------------\n\n@dataclass\nclass CombatState:\n    \"\"\"Tracks attackers, blockers, damage assignments, and block ordering.\n\n    Attributes:\n        attackers: Mapping of attacking creature → defending player.\n        blockers: Mapping of blocking creature → list of attackers it blocks.\n        attacker_blockers: Mapping of attacking creature → ordered list of\n            blockers assigned to it (order used for damage assignment).\n        damage_assignments: Mapping of creature → list of\n            ``(target, amount)`` tuples describing how damage is assigned.\n        was_blocked: Set of attackers that were declared as blocked.  Per\n            MTG rule 509.1h, once a creature is blocked it stays blocked\n            even if all its blockers are removed before damage.\n        in_combat: Whether the combat phase is currently active.\n    \"\"\"\n\n    attackers: dict[Any, Player] = field(default_factory=dict)\n    blockers: dict[Any, list[Any]] = field(default_factory=dict)\n    attacker_blockers: dict[Any, list[Any]] = field(default_factory=dict)\n    damage_assignments: dict[Any, list[tuple[Any, int]]] = field(default_factory=dict)\n    was_blocked: set[Any] = field(default_factory=set)\n    in_combat: bool = False\n\n    def clear(self) -> None:\n        \"\"\"Reset all combat state.\"\"\"\n        self.attackers.clear()\n        self.blockers.clear()\n        self.attacker_blockers.clear()\n        self.damage_assignments.clear()\n        self.was_blocked.clear()\n        self.in_combat = False\n\n\n# ---------------------------------------------------------------------------\n# Helpers\n# ---------------------------------------------------------------------------\n\ndef _can_attack(creature: Any) -> bool:\n    \"\"\"Return ``True`` if *creature* is eligible to be declared as an attacker.\n\n    A creature cannot attack if:\n    - It is already tapped.\n    - It has the ``DEFENDER`` keyword.\n    - It has summoning sickness (``summoning_sick``) and does not have ``HASTE``.\n    - A continuous effect has set ``_cant_attack`` (e.g. Pacifism).\n    \"\"\"\n    if getattr(creature, \"is_tapped\", False):\n        return False\n\n    # Check for \"can't attack\" restriction (set by continuous effects like Pacifism)\n    if getattr(creature, \"_cant_attack\", False):\n        return False\n\n    keywords = getattr(creature, \"keywords\", Keyword(0))\n\n    if Keyword.DEFENDER in keywords:\n        return False\n\n    if getattr(creature, \"summoning_sick\", False) and Keyword.HASTE not in keywords:\n        return False\n\n    return True\n\n\ndef _can_block(blocker: Any, attacker: Any) -> bool:\n    \"\"\"Return ``True`` if *blocker* can legally block *attacker*.\n\n    Checks:\n    - If the blocker is tapped it cannot block.\n    - A continuous effect has set ``_cant_block`` (e.g. Pacifism).\n    - If the attacker has flying, the blocker must have flying or reach.\n    \"\"\"\n    if getattr(blocker, \"is_tapped\", False):\n        return False\n\n    # Check for \"can't block\" restriction (set by continuous effects like Pacifism)\n    if getattr(blocker, \"_cant_block\", False):\n        return False\n\n    attacker_kw = getattr(attacker, \"keywords\", Keyword(0))\n    blocker_kw = getattr(blocker, \"keywords\", Keyword(0))\n\n    # Flying check\n    if Keyword.FLYING in attacker_kw:\n        if Keyword.FLYING not in blocker_kw and Keyword.REACH not in blocker_kw:\n            return False\n\n    # Protection check — attacker with protection from blocker can't be blocked\n    from engine.protection import has_protection_from\n\n    if has_protection_from(attacker, blocker):\n        return False\n\n    return True\n\n\ndef _get_lethal_damage(creature: Any, attacker: Any | None = None) -> int:\n    \"\"\"Return the amount of damage needed to lethally assign to *creature*.\n\n    If *attacker* has deathtouch, 1 damage is lethal.\n    Otherwise it's ``toughness - damage_marked`` (at least 1).\n    \"\"\"\n    if attacker is not None:\n        attacker_kw = getattr(attacker, \"keywords\", Keyword(0))\n        if Keyword.DEATHTOUCH in attacker_kw:\n            return 1\n\n    toughness = getattr(creature, \"toughness\", 0)\n    damage_marked = getattr(creature, \"damage_marked\", 0)\n    return max(1, toughness - damage_marked)\n\n\ndef _deal_damage(\n    source: Any,\n    target: Any,\n    amount: int,\n    game: GameState,\n    combat_state: CombatState,\n) -> None:\n    \"\"\"Apply *amount* damage from *source* to *target*.\n\n    If *target* is a player, reduces life.\n    If *target* is a creature, marks damage on it.\n    If *source* has lifelink, the controller gains that much life.\n\n    Protection prevents damage from sources with the protected-from quality.\n    \"\"\"\n    if amount <= 0:\n        return\n\n    # Protection prevents damage (D in DEBT).\n    from engine.protection import has_protection_from\n\n    if has_protection_from(target, source):\n        return\n\n    # Record damage assignment\n    if source not in combat_state.damage_assignments:\n        combat_state.damage_assignments[source] = []\n    combat_state.damage_assignments[source].append((target, amount))\n\n    # Apply damage\n    if hasattr(target, \"life\"):\n        # Target is a player\n        target.life -= amount\n    elif hasattr(target, \"damage_marked\"):\n        # Target is a creature\n        target.damage_marked += amount\n\n        # Track deathtouch damage for SBA rule 704.5h\n        source_kw_dt = getattr(source, \"keywords\", Keyword(0))\n        if Keyword.DEATHTOUCH in source_kw_dt:\n            target.dealt_deathtouch_damage = True\n\n    # Lifelink: controller gains life equal to damage dealt\n    source_kw = getattr(source, \"keywords\", Keyword(0))\n    if Keyword.LIFELINK in source_kw:\n        controller = getattr(source, \"controller\", None)\n        if controller is not None and hasattr(controller, \"life\"):\n            controller.life += amount\n\n\n# ---------------------------------------------------------------------------\n# Combat steps\n# ---------------------------------------------------------------------------\n\ndef declare_attackers_step(game: GameState) -> None:\n    \"\"\"Declare attackers step: active player chooses creatures to attack with.\n\n    The active player is asked (via :meth:`Player.choose`) to select a set\n    of creatures to attack with.  Each chosen attacker is tapped (unless it\n    has vigilance) and its ``is_attacking`` flag is set.\n\n    Parameters:\n        game: The current game state.  ``game.combat_state`` must exist.\n    \"\"\"\n    combat = game.combat_state\n    combat.in_combat = True\n    active = game.active_player\n    defending = game.non_active_player\n\n    # Gather legal attackers from the active player's battlefield\n    from engine.types import Zone\n    bf = active.zones[Zone.BATTLEFIELD]\n    eligible = [\n        c for c in bf.get_all()\n        if hasattr(c, \"base_power\") and _can_attack(c)\n    ]\n\n    if not eligible:\n        return\n\n    # Active player chooses which creatures to attack with\n    chosen = active.choose(eligible, \"declare attackers\")\n\n    # Normalize to a list\n    if chosen is None:\n        return\n    if not isinstance(chosen, list):\n        chosen = [chosen]\n\n    # Validate and register attackers\n    for attacker in chosen:\n        if attacker not in eligible:\n            continue\n        if not _can_attack(attacker):\n            continue\n\n        combat.attackers[attacker] = defending\n        combat.attacker_blockers[attacker] = []\n        attacker.is_attacking = True\n\n        # Tap the attacker unless it has vigilance\n        kw = getattr(attacker, \"keywords\", Keyword(0))\n        if Keyword.VIGILANCE not in kw:\n            attacker.is_tapped = True\n\n\ndef declare_blockers_step(game: GameState) -> None:\n    \"\"\"Declare blockers step: defending player assigns blockers.\n\n    The defending player is asked (via :meth:`Player.choose`) to assign\n    blockers.  The expected format is a dict mapping blocker → attacker\n    (or blocker → list of attackers for multi-blocking scenarios), but\n    commonly blocker → attacker.\n\n    After blockers are assigned:\n    - Menace check: attackers with menace must be blocked by 2+ creatures.\n    - Flying/reach check is already handled by ``_can_block``.\n    - The attacking player orders blockers for each attacker (for damage\n      assignment).\n\n    Parameters:\n        game: The current game state.\n    \"\"\"\n    combat = game.combat_state\n\n    if not combat.attackers:\n        return\n\n    defending = game.non_active_player\n    active = game.active_player\n\n    from engine.types import Zone\n    bf_defending = defending.zones[Zone.BATTLEFIELD]\n    eligible_blockers = [\n        c for c in bf_defending.get_all()\n        if hasattr(c, \"base_power\") and not getattr(c, \"is_tapped\", False)\n    ]\n\n    if not eligible_blockers:\n        return\n\n    # Defending player chooses block assignments\n    # Expected format: dict mapping blocker → attacker (or list of attackers)\n    block_assignments = defending.choose(\n        eligible_blockers,\n        \"declare blockers\",\n    )\n\n    if block_assignments is None:\n        return\n\n    if not isinstance(block_assignments, dict):\n        return\n\n    # Process block assignments\n    for blocker, target in block_assignments.items():\n        # Validate that the blocker is in the eligible set\n        if blocker not in eligible_blockers:\n            continue\n        targets = target if isinstance(target, list) else [target]\n        valid_targets = []\n        max_blocked = getattr(blocker, \"_max_attackers_blocked\", 1)\n        for attacker in targets:\n            if len(valid_targets) >= max_blocked:\n                break\n            if attacker in combat.attackers and _can_block(blocker, attacker):\n                valid_targets.append(attacker)\n        if valid_targets:\n            combat.blockers[blocker] = valid_targets\n            blocker.is_blocking = True\n            for attacker in valid_targets:\n                if attacker not in combat.attacker_blockers:\n                    combat.attacker_blockers[attacker] = []\n                combat.attacker_blockers[attacker].append(blocker)\n\n    # Menace check: attackers with menace that have fewer than 2 blockers\n    # are treated as unblocked (remove the single blocker assignment).\n    for attacker, blocker_list in list(combat.attacker_blockers.items()):\n        kw = getattr(attacker, \"keywords\", Keyword(0))\n        if Keyword.MENACE in kw and len(blocker_list) < 2 and len(blocker_list) > 0:\n            # Illegal block — remove these blockers\n            for b in blocker_list:\n                if b in combat.blockers:\n                    combat.blockers[b] = [\n                        a for a in combat.blockers[b] if a is not attacker\n                    ]\n                    if not combat.blockers[b]:\n                        del combat.blockers[b]\n                        b.is_blocking = False\n            combat.attacker_blockers[attacker] = []\n\n    # Mark attackers that have at least one blocker as \"was_blocked\".\n    # Per MTG rule 509.1h, once a creature is blocked it remains blocked\n    # even if all its blockers are removed before the damage step.\n    for attacker, blocker_list in combat.attacker_blockers.items():\n        if blocker_list:\n            combat.was_blocked.add(attacker)\n\n    # Controller of each attacker orders the blockers for damage assignment\n    for attacker, blocker_list in combat.attacker_blockers.items():\n        if len(blocker_list) > 1:\n            controller = getattr(attacker, \"controller\", active)\n            ordered = controller.assign_damage_order(blocker_list)\n            combat.attacker_blockers[attacker] = ordered\n\n\ndef combat_damage_step(game: GameState) -> None:\n    \"\"\"Combat damage step: deal combat damage.\n\n    Handles:\n    - First strike / double strike creatures deal damage first.\n    - State-based actions are checked between first-strike and normal damage.\n    - Trample: excess damage over blocker toughness → defending player.\n    - Lifelink: controller gains life equal to damage dealt.\n    - Deathtouch: any damage is lethal (1 damage = lethal assignment).\n    - Unblocked attackers deal damage to defending player.\n\n    Parameters:\n        game: The current game state.\n    \"\"\"\n    from engine.state_based_actions import resolve_state_based_actions\n\n    combat = game.combat_state\n\n    if not combat.attackers:\n        return\n\n    all_attackers = list(combat.attackers.keys())\n\n    # Determine if a first-strike damage sub-step is needed\n    # Check both attackers and blockers for first strike / double strike\n    all_blockers = set()\n    for blocker_list in combat.attacker_blockers.values():\n        all_blockers.update(blocker_list)\n\n    has_first_strike_step = any(\n        Keyword.FIRST_STRIKE in getattr(c, \"keywords\", Keyword(0))\n        or Keyword.DOUBLE_STRIKE in getattr(c, \"keywords\", Keyword(0))\n        for c in list(all_attackers) + list(all_blockers)\n    )\n\n    # --- First strike damage sub-step ---\n    if has_first_strike_step:\n        _assign_combat_damage(all_attackers, combat, game, is_first_strike=True)\n        resolve_state_based_actions(game)\n\n    # --- Normal damage sub-step ---\n    _assign_combat_damage(all_attackers, combat, game, is_first_strike=False)\n    resolve_state_based_actions(game)\n\n\ndef _assign_combat_damage(\n    attackers: list[Any],\n    combat: CombatState,\n    game: GameState,\n    *,\n    is_first_strike: bool = False,\n) -> None:\n    \"\"\"Assign and deal combat damage for a set of attackers.\n\n    For each attacker:\n    - If unblocked → damage to defending player.\n    - If blocked → damage assigned to blockers in order.  With trample,\n      excess damage goes to the defending player.\n    - Blockers deal damage back to the attacker they block.\n\n    When *is_first_strike* is ``True``, only creatures with\n    ``FIRST_STRIKE`` or ``DOUBLE_STRIKE`` deal damage (both attackers\n    and blockers).  When ``False``, only creatures *without*\n    ``FIRST_STRIKE`` deal damage (plus ``DOUBLE_STRIKE`` creatures,\n    which participate in both steps).  Blockers that are no longer on\n    the battlefield (e.g. killed by first-strike damage and removed by\n    SBAs) are skipped.\n    \"\"\"\n    from engine.types import Zone\n\n    # Track which blockers have already dealt their damage this sub-step\n    # (blockers only deal damage once even if blocking multiple attackers)\n    blockers_dealt: set[int] = set()\n\n    for attacker in attackers:\n        if attacker not in combat.attackers:\n            continue\n\n        kw = getattr(attacker, \"keywords\", Keyword(0))\n        has_first = Keyword.FIRST_STRIKE in kw\n        has_double = Keyword.DOUBLE_STRIKE in kw\n\n        # Determine if this attacker deals damage in this sub-step\n        if is_first_strike:\n            attacker_deals = has_first or has_double\n        else:\n            attacker_deals = not has_first or has_double\n\n        # Skip if attacker is no longer on the battlefield\n        if attacker_deals:\n            controller = getattr(attacker, \"controller\", None)\n            if controller is not None:\n                bf = controller.zones[Zone.BATTLEFIELD]\n                if not bf.contains(attacker):\n                    attacker_deals = False\n\n        defending_player = combat.attackers[attacker]\n        blocker_list = combat.attacker_blockers.get(attacker, [])\n        attacker_kw = getattr(attacker, \"keywords\", Keyword(0))\n\n        if attacker_deals:\n            power = getattr(attacker, \"power\", 0)\n\n            # Check if attacker was blocked.  Per MTG rule 509.1h, a blocked\n            # creature stays blocked even if all its blockers are removed.\n            is_blocked = attacker in combat.was_blocked\n\n            if not is_blocked and not blocker_list:\n                # Truly unblocked → damage to defending player\n                _deal_damage(attacker, defending_player, power, game, combat)\n            elif is_blocked and not blocker_list:\n                # Was blocked but all blockers removed.\n                # Without trample: deals no damage.\n                # With trample: all damage tramples to defending player.\n                has_trample = Keyword.TRAMPLE in attacker_kw\n                if has_trample:\n                    _deal_damage(attacker, defending_player, power, game, combat)\n                # else: no damage dealt\n            else:\n                # Blocked → assign damage to blockers in order\n                has_trample = Keyword.TRAMPLE in attacker_kw\n                remaining_damage = power\n\n                for i, blocker in enumerate(blocker_list):\n                    if remaining_damage <= 0:\n                        break\n\n                    lethal = _get_lethal_damage(blocker, attacker)\n\n                    if i < len(blocker_list) - 1:\n                        # Not the last blocker — assign lethal damage\n                        assign = min(lethal, remaining_damage)\n                    else:\n                        # Last blocker\n                        if has_trample:\n                            # With trample: assign lethal, rest tramples through\n                            assign = min(lethal, remaining_damage)\n                        else:\n                            # Without trample: all remaining damage to last blocker\n                            assign = remaining_damage\n\n                    _deal_damage(attacker, blocker, assign, game, combat)\n                    remaining_damage -= assign\n\n                # Trample: excess damage to defending player\n                if has_trample and remaining_damage > 0:\n                    _deal_damage(attacker, defending_player, remaining_damage, game, combat)\n\n        # Blockers deal damage back to the attacker\n        for blocker in blocker_list:\n            if id(blocker) not in blockers_dealt:\n                blocker_kw = getattr(blocker, \"keywords\", Keyword(0))\n                blocker_has_first = Keyword.FIRST_STRIKE in blocker_kw\n                blocker_has_double = Keyword.DOUBLE_STRIKE in blocker_kw\n\n                # Determine if this blocker deals damage in this sub-step\n                if is_first_strike:\n                    should_deal = blocker_has_first or blocker_has_double\n                else:\n                    should_deal = not blocker_has_first or blocker_has_double\n\n                # Skip if blocker is no longer on the battlefield\n                if should_deal:\n                    blocker_ctrl = getattr(blocker, \"controller\", None)\n                    if blocker_ctrl is not None:\n                        bf = blocker_ctrl.zones[Zone.BATTLEFIELD]\n                        if not bf.contains(blocker):\n                            should_deal = False\n\n                if should_deal:\n                    blocker_power = getattr(blocker, \"power\", 0)\n                    _deal_damage(blocker, attacker, blocker_power, game, combat)\n                    blockers_dealt.add(id(blocker))\n\n\ndef end_combat_step(game: GameState) -> None:\n    \"\"\"End combat step: remove from combat and clear combat state.\n\n    Resets ``is_attacking`` and ``is_blocking`` flags on all creatures\n    and clears the combat state.\n\n    Parameters:\n        game: The current game state.\n    \"\"\"\n    combat = game.combat_state\n\n    # Clear combat flags on all attackers\n    for attacker in combat.attackers:\n        if hasattr(attacker, \"is_attacking\"):\n            attacker.is_attacking = False\n\n    # Clear combat flags on all blockers\n    for blocker in combat.blockers:\n        if hasattr(blocker, \"is_blocking\"):\n            blocker.is_blocking = False\n\n    combat.clear()\n","numLines":557,"startLine":1,"totalLines":557}}}
