{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012yw7mmoXmHdHNczVjbS63v","type":"tool_result","content":"148\t        alternative_cost: If provided, pay this instead of the card's\n149\t            mana cost and skip normal cost reduction.  Used by alternative\n150\t            costs such as miracle.\n151\t        bypass_timing: If ``True``, skip the sorcery/instant timing check.\n152\t            Used by miracle (cast when drawn, regardless of timing).\n153\t\n154\t    Pipeline\n155\t    --------\n156\t    1. **Timing check** — instants (and cards with flash) can be cast\n157\t       whenever the player has priority; everything else requires\n158\t       sorcery-speed timing.\n159\t    2. **can_cast** — ask the card whether it can legally be cast.\n160\t    3. **Hand check** — the card must be in the player's hand.\n161\t    4. **Move hand → stack zone** — remove the card from the hand and\n162\t       place it into the player's stack zone.\n163\t    5. **Choose targets** — if the card specifies targets (via\n164\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n165\t    6. **Mana check / payment** — the player's mana pool must be able to\n166\t       pay the card's mana cost.  If payment fails, the card is rolled\n167\t       back from the stack zone to the hand.\n168\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n169\t    8. **Push StackObject** — push a :class:`StackObject` whose\n170\t       ``on_resolve`` callback handles resolution.\n171\t\n172\t    Raises:\n173\t        CastingError: If any legality check fails.\n174\t    \"\"\"\n175\t    # 1. Timing\n176\t    if (\n177\t        not bypass_timing\n178\t        and not can_cast_at_instant_speed(card)\n179\t        and not is_sorcery_speed(game, player)\n180\t    ):\n181\t        raise CastingError(\n182\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n183\t        )\n184\t\n185\t    # 2. can_cast\n186\t    if not card.can_cast(game):\n187\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n188\t\n189\t    # 3. Hand check\n190\t    hand = game.get_hand(player)\n191\t    if not hand.contains(card):\n192\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n193\t\n194\t    # 4. Move card from hand to stack zone\n195\t    stack_zone = player.zones[Zone.STACK]\n196\t    hand.remove(card)\n197\t    stack_zone.add(card)\n198\t\n199\t    # Clear any stale colors_spent from a prior cast before new payment.\n200\t    if hasattr(card, \"colors_spent\"):\n201\t        del card.colors_spent\n202\t\n203\t    # 5. Choose targets\n204\t    target_specs = card.get_targets(game)\n205\t    chosen_targets: list[Any] = []\n206\t    if target_specs:\n207\t        for spec in target_specs:\n208\t            target = player.choose_target(target_specs, spec)\n209\t            # Validate against filter_fn if the spec provides one\n210\t            filter_fn = getattr(spec, \"filter_fn\", None)\n211\t            if filter_fn is not None and target is not None:\n212\t                if not filter_fn(target):\n213\t                    stack_zone.remove(card)\n214\t                    hand.add(card)\n215\t                    raise CastingError(\n216\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n217\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n218\t                    )\n219\t            chosen_targets.append(target)\n220\t\n221\t    # 5b. Protection check — reject targets that have protection from this\n222\t    #     spell (the T in DEBT).\n223\t    from engine.protection import has_protection_from\n224\t\n225\t    for target in chosen_targets:\n226\t        if has_protection_from(target, card):\n227\t            # Rollback: move card from stack zone back to hand\n228\t            stack_zone.remove(card)\n229\t            hand.add(card)\n230\t            raise CastingError(\n231\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n232\t            )\n233\t\n234\t    # Targets are stored on the StackObject (not the card) and passed\n235\t    # through the resolve pipeline via on_resolve(game, targets=...).\n236\t\n237\t    # 6. Mana check / payment (rollback on failure)\n238\t    # Ensure the card knows its controller so that cost_reduction() hooks\n239\t    # (e.g. Embercleave counting attacking creatures you control) see the\n240\t    # casting player, even for cards that were added to hand without an\n241\t    # explicit controller assignment.\n242\t    if card.controller is None:\n243\t        card.controller = player\n244\t    if alternative_cost is not None:\n245\t        # An alternative cost (e.g. miracle) replaces the mana cost entirely\n246\t        # and is not subject to the card's normal cost reduction.\n247\t        effective_cost = alternative_cost\n248\t    else:\n249\t        reduction = get_cost_reduction(game, card, player)\n250\t        effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n251\t\n252\t    if not player.mana_pool.can_pay(effective_cost):\n253\t        # Rollback: move card from stack zone back to hand\n254\t        stack_zone.remove(card)\n255\t        hand.add(card)\n256\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n257\t"}]},"parent_tool_use_id":null,"session_id":"735f529e-7bc8-4328-a211-d2f095818fd0","uuid":"248f8910-3731-4f04-9350-dbdcf8786e73","timestamp":"2026-06-04T10:21:21.446Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"        alternative_cost: If provided, pay this instead of the card's\n            mana cost and skip normal cost reduction.  Used by alternative\n            costs such as miracle.\n        bypass_timing: If ``True``, skip the sorcery/instant timing check.\n            Used by miracle (cast when drawn, regardless of timing).\n\n    Pipeline\n    --------\n    1. **Timing check** — instants (and cards with flash) can be cast\n       whenever the player has priority; everything else requires\n       sorcery-speed timing.\n    2. **can_cast** — ask the card whether it can legally be cast.\n    3. **Hand check** — the card must be in the player's hand.\n    4. **Move hand → stack zone** — remove the card from the hand and\n       place it into the player's stack zone.\n    5. **Choose targets** — if the card specifies targets (via\n       :meth:`CardImpl.get_targets`), the player is asked to choose.\n    6. **Mana check / payment** — the player's mana pool must be able to\n       pay the card's mana cost.  If payment fails, the card is rolled\n       back from the stack zone to the hand.\n    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n    8. **Push StackObject** — push a :class:`StackObject` whose\n       ``on_resolve`` callback handles resolution.\n\n    Raises:\n        CastingError: If any legality check fails.\n    \"\"\"\n    # 1. Timing\n    if (\n        not bypass_timing\n        and not can_cast_at_instant_speed(card)\n        and not is_sorcery_speed(game, player)\n    ):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n        )\n\n    # 2. can_cast\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 3. Hand check\n    hand = game.get_hand(player)\n    if not hand.contains(card):\n        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n\n    # 4. Move card from hand to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    hand.remove(card)\n    stack_zone.add(card)\n\n    # Clear any stale colors_spent from a prior cast before new payment.\n    if hasattr(card, \"colors_spent\"):\n        del card.colors_spent\n\n    # 5. Choose targets\n    target_specs = card.get_targets(game)\n    chosen_targets: list[Any] = []\n    if target_specs:\n        for spec in target_specs:\n            target = player.choose_target(target_specs, spec)\n            # Validate against filter_fn if the spec provides one\n            filter_fn = getattr(spec, \"filter_fn\", None)\n            if filter_fn is not None and target is not None:\n                if not filter_fn(target):\n                    stack_zone.remove(card)\n                    hand.add(card)\n                    raise CastingError(\n                        f\"Cannot cast {card.name!r} — chosen target does not \"\n                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                    )\n            chosen_targets.append(target)\n\n    # 5b. Protection check — reject targets that have protection from this\n    #     spell (the T in DEBT).\n    from engine.protection import has_protection_from\n\n    for target in chosen_targets:\n        if has_protection_from(target, card):\n            # Rollback: move card from stack zone back to hand\n            stack_zone.remove(card)\n            hand.add(card)\n            raise CastingError(\n                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n            )\n\n    # Targets are stored on the StackObject (not the card) and passed\n    # through the resolve pipeline via on_resolve(game, targets=...).\n\n    # 6. Mana check / payment (rollback on failure)\n    # Ensure the card knows its controller so that cost_reduction() hooks\n    # (e.g. Embercleave counting attacking creatures you control) see the\n    # casting player, even for cards that were added to hand without an\n    # explicit controller assignment.\n    if card.controller is None:\n        card.controller = player\n    if alternative_cost is not None:\n        # An alternative cost (e.g. miracle) replaces the mana cost entirely\n        # and is not subject to the card's normal cost reduction.\n        effective_cost = alternative_cost\n    else:\n        reduction = get_cost_reduction(game, card, player)\n        effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n\n    if not player.mana_pool.can_pay(effective_cost):\n        # Rollback: move card from stack zone back to hand\n        stack_zone.remove(card)\n        hand.add(card)\n        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n","numLines":110,"startLine":148,"totalLines":614}}}
