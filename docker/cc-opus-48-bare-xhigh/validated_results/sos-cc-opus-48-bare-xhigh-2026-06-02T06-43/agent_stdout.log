{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012awBbmfivUUuk7adB5BnqM","type":"tool_result","content":"1\t\"\"\"Card implementation for Refute.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Instant\n8\tfrom engine.types import ManaCost, TargetRequirement, Zone\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t\n13\t\n14\tdef _get_chosen_target(card: Any, game: Any) -> Any:\n15\t    \"\"\"Retrieve the first chosen target for a spell.\"\"\"\n16\t    chosen = getattr(card, \"chosen_targets\", None)\n17\t    if chosen:\n18\t        return chosen[0]\n19\t    return getattr(card, \"_resolve_target\", None)\n20\t\n21\t\n22\tdef _counter_spell(game: \"GameState\", stack_obj: Any) -> None:\n23\t    \"\"\"Counter a spell — remove from stack and move card to graveyard.\"\"\"\n24\t    from engine.stack import StackObject\n25\t\n26\t    if not isinstance(stack_obj, StackObject):\n27\t        return\n28\t\n29\t    card = stack_obj.source\n30\t    stack_items = game.stack._items  # noqa: SLF001\n31\t    found = False\n32\t    for i, item in enumerate(stack_items):\n33\t        if item is stack_obj:\n34\t            stack_items.pop(i)\n35\t            found = True\n36\t            break\n37\t\n38\t    if not found:\n39\t        return\n40\t\n41\t    controller = stack_obj.controller\n42\t    owner = getattr(card, \"owner\", controller)\n43\t\n44\t    if controller is not None:\n45\t        stack_zone = controller.zones[Zone.STACK]\n46\t        if stack_zone.contains(card):\n47\t            stack_zone.remove(card)\n48\t\n49\t    if owner is not None:\n50\t        graveyard = owner.zones[Zone.GRAVEYARD]\n51\t        graveyard.add(card)\n52\t\n53\t\n54\tclass Refute(Instant):\n55\t    \"\"\"Refute — {1}{U}{U} — Instant.\n56\t\n57\t    Counter target spell. Draw a card, then discard a card.\n58\t\n59\t    FDN collector number 48.\n60\t    \"\"\"\n61\t\n62\t    def __init__(self, **kwargs: Any) -> None:\n63\t        kwargs.setdefault(\"name\", \"Refute\")\n64\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{U}{U}\"))\n65\t        kwargs.setdefault(\n66\t            \"rules_text\",\n67\t            \"Counter target spell. Draw a card, then discard a card.\",\n68\t        )\n69\t        super().__init__(**kwargs)\n70\t\n71\t    def can_cast(self, game: \"GameState\") -> bool:\n72\t        \"\"\"Cannot cast unless there's a spell on the stack to counter.\"\"\"\n73\t        from engine.stack import StackObject\n74\t\n75\t        for stack_obj in game.stack.objects():\n76\t            source = stack_obj.source\n77\t            if source is self:\n78\t                continue\n79\t            # Only target spells (not triggered/activated abilities)\n80\t            if getattr(stack_obj, \"is_spell\", True):\n81\t                return True\n82\t        return False\n83\t\n84\t    def get_targets(self, game: \"GameState\") -> list:\n85\t        \"\"\"Target spell on the stack.\"\"\"\n86\t        from engine.stack import StackObject\n87\t\n88\t        targets = []\n89\t        for stack_obj in game.stack.objects():\n90\t            source = stack_obj.source\n91\t            if source is self:\n92\t                continue\n93\t            if getattr(stack_obj, \"is_spell\", True):\n94\t                targets.append(stack_obj)\n95\t        if not targets:\n96\t            return []\n97\t        return [\n98\t            TargetRequirement(\n99\t                filter_fn=lambda obj: obj is not self and getattr(obj, \"is_spell\", True),\n100\t                description=\"target spell\",\n101\t                zone=Zone.STACK,\n102\t            )\n103\t        ]\n104\t\n105\t    def on_resolve(self, game: \"GameState\") -> None:\n106\t        \"\"\"Counter target spell, then draw a card, then discard a card.\"\"\"\n107\t        from engine.game import discard, draw_card\n108\t\n109\t        target = _get_chosen_target(self, game)\n110\t        # Single-target spell fizzles if target is illegal\n111\t        if target is None:\n112\t            return\n113\t        if target is not None:\n114\t            _counter_spell(game, target)\n115\t\n116\t        controller = self.controller\n117\t        if controller is None:\n118\t            return\n119\t\n120\t        # Draw a card\n121\t        draw_card(game, controller)\n122\t\n123\t        # Discard a card\n124\t        hand = controller.zones[Zone.HAND]\n125\t        cards_in_hand = list(hand.get_all())\n126\t        if cards_in_hand:\n127\t            try:\n128\t                chosen = controller.choose_card(\n129\t                    cards_in_hand, \"Choose a card to discard\"\n130\t                )\n131\t            except Exception:\n132\t                chosen = cards_in_hand[0] if cards_in_hand else None\n133\t            if chosen is not None:\n134\t                discard(game, controller, chosen)\n135\t"}]},"parent_tool_use_id":null,"session_id":"1995741a-49a1-4a45-a041-801f56ba31a7","uuid":"26de44da-f544-46d5-91d5-230fbb464d43","timestamp":"2026-06-02T06:57:20.229Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_48/card_impl.py","content":"\"\"\"Card implementation for Refute.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import Instant\nfrom engine.types import ManaCost, TargetRequirement, Zone\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\ndef _get_chosen_target(card: Any, game: Any) -> Any:\n    \"\"\"Retrieve the first chosen target for a spell.\"\"\"\n    chosen = getattr(card, \"chosen_targets\", None)\n    if chosen:\n        return chosen[0]\n    return getattr(card, \"_resolve_target\", None)\n\n\ndef _counter_spell(game: \"GameState\", stack_obj: Any) -> None:\n    \"\"\"Counter a spell — remove from stack and move card to graveyard.\"\"\"\n    from engine.stack import StackObject\n\n    if not isinstance(stack_obj, StackObject):\n        return\n\n    card = stack_obj.source\n    stack_items = game.stack._items  # noqa: SLF001\n    found = False\n    for i, item in enumerate(stack_items):\n        if item is stack_obj:\n            stack_items.pop(i)\n            found = True\n            break\n\n    if not found:\n        return\n\n    controller = stack_obj.controller\n    owner = getattr(card, \"owner\", controller)\n\n    if controller is not None:\n        stack_zone = controller.zones[Zone.STACK]\n        if stack_zone.contains(card):\n            stack_zone.remove(card)\n\n    if owner is not None:\n        graveyard = owner.zones[Zone.GRAVEYARD]\n        graveyard.add(card)\n\n\nclass Refute(Instant):\n    \"\"\"Refute — {1}{U}{U} — Instant.\n\n    Counter target spell. Draw a card, then discard a card.\n\n    FDN collector number 48.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"Refute\")\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{U}{U}\"))\n        kwargs.setdefault(\n            \"rules_text\",\n            \"Counter target spell. Draw a card, then discard a card.\",\n        )\n        super().__init__(**kwargs)\n\n    def can_cast(self, game: \"GameState\") -> bool:\n        \"\"\"Cannot cast unless there's a spell on the stack to counter.\"\"\"\n        from engine.stack import StackObject\n\n        for stack_obj in game.stack.objects():\n            source = stack_obj.source\n            if source is self:\n                continue\n            # Only target spells (not triggered/activated abilities)\n            if getattr(stack_obj, \"is_spell\", True):\n                return True\n        return False\n\n    def get_targets(self, game: \"GameState\") -> list:\n        \"\"\"Target spell on the stack.\"\"\"\n        from engine.stack import StackObject\n\n        targets = []\n        for stack_obj in game.stack.objects():\n            source = stack_obj.source\n            if source is self:\n                continue\n            if getattr(stack_obj, \"is_spell\", True):\n                targets.append(stack_obj)\n        if not targets:\n            return []\n        return [\n            TargetRequirement(\n                filter_fn=lambda obj: obj is not self and getattr(obj, \"is_spell\", True),\n                description=\"target spell\",\n                zone=Zone.STACK,\n            )\n        ]\n\n    def on_resolve(self, game: \"GameState\") -> None:\n        \"\"\"Counter target spell, then draw a card, then discard a card.\"\"\"\n        from engine.game import discard, draw_card\n\n        target = _get_chosen_target(self, game)\n        # Single-target spell fizzles if target is illegal\n        if target is None:\n            return\n        if target is not None:\n            _counter_spell(game, target)\n\n        controller = self.controller\n        if controller is None:\n            return\n\n        # Draw a card\n        draw_card(game, controller)\n\n        # Discard a card\n        hand = controller.zones[Zone.HAND]\n        cards_in_hand = list(hand.get_all())\n        if cards_in_hand:\n            try:\n                chosen = controller.choose_card(\n                    cards_in_hand, \"Choose a card to discard\"\n                )\n            except Exception:\n                chosen = cards_in_hand[0] if cards_in_hand else None\n            if chosen is not None:\n                discard(game, controller, chosen)\n","numLines":135,"startLine":1,"totalLines":135}}}
