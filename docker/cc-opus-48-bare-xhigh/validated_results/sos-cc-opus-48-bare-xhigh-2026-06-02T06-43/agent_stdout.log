{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y4eHNMx3UM4td5qxBPycT6","type":"tool_result","content":"225\t    # explicit controller assignment.\n226\t    if card.controller is None:\n227\t        card.controller = player\n228\t    reduction = get_cost_reduction(game, card, player)\n229\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n230\t\n231\t    if not player.mana_pool.can_pay(effective_cost):\n232\t        # Rollback: move card from stack zone back to hand\n233\t        stack_zone.remove(card)\n234\t        hand.add(card)\n235\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n236\t\n237\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n238\t    player.mana_pool.pay(effective_cost)\n239\t\n240\t    # Store colors of mana spent on the card for mechanics like Converge\n241\t    # that care about the colors used to cast the spell.\n242\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n243\t\n244\t    # 7. Call on_cast hook\n245\t    card.on_cast(game)\n246\t\n247\t    # 8. Build on_resolve callback and push StackObject\n248\t    stack_obj = StackObject(\n249\t        source=card,\n250\t        controller=player,\n251\t        targets=chosen_targets,\n252\t        on_resolve=lambda g: None,  # replaced below\n253\t    )\n254\t\n255\t    def _on_resolve(g: GameState) -> None:\n256\t        _resolve_spell(g, card, player, stack_obj)\n257\t\n258\t    stack_obj.on_resolve = _on_resolve\n259\t    game.stack.push(stack_obj)\n260\t\n261\t    # Fire the \"spell cast\" event so triggered abilities that watch for\n262\t    # casting (e.g. casualty grants, prowess-like effects) can respond.\n263\t    # Pushed after the spell so matching triggers resolve above it.\n264\t    from engine.events import SpellCastTriggeredEvent\n265\t\n266\t    game.trigger_manager.fire_event(\n267\t        game,\n268\t        SpellCastTriggeredEvent(spell=stack_obj, player=player, card=card, controller=player),\n269\t    )\n270\t\n271\t\n272\t# ------------------------------------------------------------------\n273\t# Cast spell without paying mana cost (free-cast from any zone)\n274\t# ------------------------------------------------------------------\n275\t\n276\t\n277\tdef cast_spell_free(\n278\t    game: GameState,\n279\t    player: Player,\n280\t    card: CardImpl,\n281\t    from_zone: Zone,\n282\t) -> None:\n283\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n284\t\n285\t    This is used by effects that allow casting from zones other than hand\n286\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n287\t    or cascade.\n288\t\n289\t    Pipeline\n290\t    --------\n291\t    1. **can_cast** — ask the card whether it can legally be cast (same\n292\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n293\t    2. Move *card* from *from_zone* to the stack zone.\n294\t    3. Choose targets (if applicable) with validation and protection check."}]},"parent_tool_use_id":null,"session_id":"1995741a-49a1-4a45-a041-801f56ba31a7","uuid":"fc8291d0-792e-4b84-812a-83f14a401af0","timestamp":"2026-06-02T07:01:23.071Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"    # explicit controller assignment.\n    if card.controller is None:\n        card.controller = player\n    reduction = get_cost_reduction(game, card, player)\n    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n\n    if not player.mana_pool.can_pay(effective_cost):\n        # Rollback: move card from stack zone back to hand\n        stack_zone.remove(card)\n        hand.add(card)\n        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n\n    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n    player.mana_pool.pay(effective_cost)\n\n    # Store colors of mana spent on the card for mechanics like Converge\n    # that care about the colors used to cast the spell.\n    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n\n    # 7. Call on_cast hook\n    card.on_cast(game)\n\n    # 8. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n    # Fire the \"spell cast\" event so triggered abilities that watch for\n    # casting (e.g. casualty grants, prowess-like effects) can respond.\n    # Pushed after the spell so matching triggers resolve above it.\n    from engine.events import SpellCastTriggeredEvent\n\n    game.trigger_manager.fire_event(\n        game,\n        SpellCastTriggeredEvent(spell=stack_obj, player=player, card=card, controller=player),\n    )\n\n\n# ------------------------------------------------------------------\n# Cast spell without paying mana cost (free-cast from any zone)\n# ------------------------------------------------------------------\n\n\ndef cast_spell_free(\n    game: GameState,\n    player: Player,\n    card: CardImpl,\n    from_zone: Zone,\n) -> None:\n    \"\"\"Cast *card* without paying its mana cost, using the stack.\n\n    This is used by effects that allow casting from zones other than hand\n    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n    or cascade.\n\n    Pipeline\n    --------\n    1. **can_cast** — ask the card whether it can legally be cast (same\n       legality as :func:`cast_spell`, minus mana/timing constraints).\n    2. Move *card* from *from_zone* to the stack zone.\n    3. Choose targets (if applicable) with validation and protection check.","numLines":70,"startLine":225,"totalLines":519}}}
