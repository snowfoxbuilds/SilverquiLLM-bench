{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012fbn3v7TanLpiQVUrrfMkB","type":"tool_result","content":"1\t\"\"\"Card implementation for Painful Quandary.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom dataclasses import dataclass\n4\tfrom typing import TYPE_CHECKING, Any\n5\tfrom engine.card import ActivatedAbility, Creature, Enchantment\n6\tfrom engine.continuous_effects import ContinuousEffect, DURATION_PERMANENT, Layer, SubLayer\n7\tfrom engine.types import CardType, Keyword, ManaCost, TargetRequirement, Zone\n8\tfrom engine.events import LosesLifeTriggeredEvent, SpellCastTriggeredEvent\n9\tif TYPE_CHECKING:\n10\t    from engine.game_state import GameState\n11\t    from cards.registry import CardRegistry\n12\t\n13\tdef _is_on_battlefield(game: Any, obj: Any) -> bool:\n14\t    \"\"\"Check if *obj* is on any player's battlefield.\"\"\"\n15\t    for player in game.players:\n16\t        if game.get_battlefield(player).contains(obj):\n17\t            return True\n18\t    return False\n19\t\n20\tclass PainfulQuandary(Enchantment):\n21\t    \"\"\"Painful Quandary — {3}{B}{B} — Opponent spell = lose 5 unless discard.\n22\t\n23\t    Whenever an opponent casts a spell, that player loses 5 life unless\n24\t    they discard a card.\n25\t\n26\t    FDN collector number 179.\n27\t    \"\"\"\n28\t\n29\t    def __init__(self, **kwargs: Any) -> None:\n30\t        kwargs.setdefault('name', 'Painful Quandary')\n31\t        kwargs.setdefault('mana_cost', ManaCost.parse('{3}{B}{B}'))\n32\t        kwargs.setdefault('rules_text', 'Whenever an opponent casts a spell, that player loses 5 life unless they discard a card.')\n33\t        super().__init__(**kwargs)\n34\t\n35\t    def on_resolve(self, game: GameState) -> None:\n36\t        pass\n37\t\n38\t    def register_triggers(self, game: GameState) -> None:\n39\t        from engine.triggers import TriggerRegistration\n40\t        source = self\n41\t\n42\t        def _condition(game: Any, event: dict) -> bool:\n43\t            if not _is_on_battlefield(game, source):\n44\t                return False\n45\t            spell = event.spell\n46\t            if spell is None:\n47\t                return False\n48\t            controller = source.controller\n49\t            if controller is None:\n50\t                return False\n51\t            spell_controller = getattr(spell, 'controller', None)\n52\t            return spell_controller is not controller\n53\t\n54\t        def _effect(game: GameState) -> None:\n55\t            controller = source.controller\n56\t            if controller is None:\n57\t                return\n58\t            from engine.game import deal_damage\n59\t            for player in game.players:\n60\t                if player is not controller:\n61\t                    player.life -= 5\n62\t                    game.trigger_manager.fire_event(game, LosesLifeTriggeredEvent(player=player, amount=5))\n63\t        controller = getattr(self, 'controller', None) or game.active_player\n64\t        game.trigger_manager.register(TriggerRegistration(event_type=SpellCastTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=controller))\n65\t"}]},"parent_tool_use_id":null,"session_id":"1995741a-49a1-4a45-a041-801f56ba31a7","uuid":"21c880fe-8976-4bd5-b36e-ca0e97233a6c","timestamp":"2026-06-02T07:01:53.576Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_179/card_impl.py","content":"\"\"\"Card implementation for Painful Quandary.\"\"\"\nfrom __future__ import annotations\nfrom dataclasses import dataclass\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import ActivatedAbility, Creature, Enchantment\nfrom engine.continuous_effects import ContinuousEffect, DURATION_PERMANENT, Layer, SubLayer\nfrom engine.types import CardType, Keyword, ManaCost, TargetRequirement, Zone\nfrom engine.events import LosesLifeTriggeredEvent, SpellCastTriggeredEvent\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from cards.registry import CardRegistry\n\ndef _is_on_battlefield(game: Any, obj: Any) -> bool:\n    \"\"\"Check if *obj* is on any player's battlefield.\"\"\"\n    for player in game.players:\n        if game.get_battlefield(player).contains(obj):\n            return True\n    return False\n\nclass PainfulQuandary(Enchantment):\n    \"\"\"Painful Quandary — {3}{B}{B} — Opponent spell = lose 5 unless discard.\n\n    Whenever an opponent casts a spell, that player loses 5 life unless\n    they discard a card.\n\n    FDN collector number 179.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault('name', 'Painful Quandary')\n        kwargs.setdefault('mana_cost', ManaCost.parse('{3}{B}{B}'))\n        kwargs.setdefault('rules_text', 'Whenever an opponent casts a spell, that player loses 5 life unless they discard a card.')\n        super().__init__(**kwargs)\n\n    def on_resolve(self, game: GameState) -> None:\n        pass\n\n    def register_triggers(self, game: GameState) -> None:\n        from engine.triggers import TriggerRegistration\n        source = self\n\n        def _condition(game: Any, event: dict) -> bool:\n            if not _is_on_battlefield(game, source):\n                return False\n            spell = event.spell\n            if spell is None:\n                return False\n            controller = source.controller\n            if controller is None:\n                return False\n            spell_controller = getattr(spell, 'controller', None)\n            return spell_controller is not controller\n\n        def _effect(game: GameState) -> None:\n            controller = source.controller\n            if controller is None:\n                return\n            from engine.game import deal_damage\n            for player in game.players:\n                if player is not controller:\n                    player.life -= 5\n                    game.trigger_manager.fire_event(game, LosesLifeTriggeredEvent(player=player, amount=5))\n        controller = getattr(self, 'controller', None) or game.active_player\n        game.trigger_manager.register(TriggerRegistration(event_type=SpellCastTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=controller))\n","numLines":65,"startLine":1,"totalLines":65}}}
