{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012Tyo2tnmhKWdxsRzHUbGzi","type":"tool_result","content":"1\t\"\"\"Tests for engine/abilities.py — Activated abilities system.\n2\t\n3\tCovers:\n4\t- ActivatedAbilityInstance dataclass construction and fields.\n5\t- LoyaltyAbilityInstance dataclass construction and fields.\n6\t- activate_ability: mana ability → resolves immediately (no stack), effect applied.\n7\t- activate_ability: non-mana ability → pushes StackObject to stack.\n8\t- tap_cost: succeeds when untapped, fails when already tapped, sets is_tapped.\n9\t- Timing checks: regular activated abilities work at instant speed (no sorcery restriction).\n10\t- Mana abilities bypass timing checks entirely (resolve immediately).\n11\t- Only loyalty abilities have sorcery-speed restriction.\n12\t- LoyaltyAbility: loyalty counter adjustment (+N, −N).\n13\t- LoyaltyAbility: once-per-turn restriction.\n14\t- LoyaltyAbility: once-per-turn resets after clear_loyalty_tracking.\n15\t- LoyaltyAbility: insufficient loyalty for −N cost → AbilityError.\n16\t- Cost payment failure → AbilityError, no stack entry.\n17\t- Integration: land tap-for-mana → mana added and card tapped.\n18\t- Multiple abilities on the same source.\n19\t- Edge cases: unknown ability type, zero loyalty cost, etc.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\timport pytest\n25\t\n26\tfrom engine.abilities import (\n27\t    AbilityError,\n28\t    ActivatedAbilityInstance,\n29\t    LoyaltyAbilityInstance,\n30\t    activate_ability,\n31\t    clear_loyalty_tracking,\n32\t    tap_cost,\n33\t)\n34\tfrom engine.card import Land, Planeswalker\n35\tfrom engine.game_state import GameState\n36\tfrom engine.mana import ManaPool\n37\tfrom engine.player import DeterministicPlayer\n38\tfrom engine.stack import StackObject\n39\tfrom engine.types import ManaType, Phase, Step\n40\t\n41\t\n42\t# ---------------------------------------------------------------------------\n43\t# Helpers / Fixtures\n44\t# ---------------------------------------------------------------------------\n45\t\n46\t\n47\t@pytest.fixture(autouse=True)\n48\tdef _reset_loyalty_tracker():\n49\t    \"\"\"Ensure the module-level loyalty tracker is clean for every test.\"\"\"\n50\t    clear_loyalty_tracking()\n51\t    yield\n52\t    clear_loyalty_tracking()\n53\t\n54\t\n55\tdef _make_game(\n56\t    *,\n57\t    p1_script: list | None = None,\n58\t    p2_script: list | None = None,\n59\t    phase: Phase = Phase.PRECOMBAT_MAIN,\n60\t    step: Step | None = None,\n61\t) -> GameState:\n62\t    \"\"\"Create a minimal 2-player GameState at the specified phase/step.\"\"\"\n63\t    p1 = DeterministicPlayer(\"Alice\", p1_script or [])\n64\t    p2 = DeterministicPlayer(\"Bob\", p2_script or [])\n65\t    game = GameState([p1, p2])\n66\t    game.phase = phase\n67\t    game.step = step\n68\t    return game\n69\t\n70\t\n71\tdef _sorcery_speed_game() -> GameState:\n72\t    \"\"\"Return a game where sorcery-speed timing is met for the active player.\"\"\"\n73\t    return _make_game(phase=Phase.PRECOMBAT_MAIN, step=None)\n74\t\n75\t\n76\tdef _instant_speed_game() -> GameState:\n77\t    \"\"\"Return a game where sorcery-speed timing is NOT met (combat phase).\"\"\"\n78\t    return _make_game(phase=Phase.COMBAT, step=Step.DECLARE_ATTACKERS)\n79\t\n80\t\n81\t# ---------------------------------------------------------------------------\n82\t# ActivatedAbilityInstance — construction\n83\t# ---------------------------------------------------------------------------\n84\t\n85\t\n86\tclass TestActivatedAbilityInstanceConstruction:\n87\t    \"\"\"ActivatedAbilityInstance dataclass stores all expected fields.\"\"\"\n88\t\n89\t    def test_fields_assigned(self):\n90\t        source = object()\n91\t        controller = DeterministicPlayer(\"Alice\", [])\n92\t        cost = lambda g, s: True\n93\t        effect = lambda g: None\n94\t        ability = ActivatedAbilityInstance(\n95\t            source=source,\n96\t            controller=controller,\n97\t            cost=cost,\n98\t            effect=effect,\n99\t            is_mana_ability=True,\n100\t            description=\"Tap for mana\",\n101\t        )\n102\t        assert ability.source is source\n103\t        assert ability.controller is controller\n104\t        assert ability.cost is cost\n105\t        assert ability.effect is effect\n106\t        assert ability.is_mana_ability is True\n107\t        assert ability.description == \"Tap for mana\"\n108\t\n109\t    def test_defaults(self):\n110\t        source = object()\n111\t        controller = DeterministicPlayer(\"Alice\", [])\n112\t        ability = ActivatedAbilityInstance(\n113\t            source=source,\n114\t            controller=controller,\n115\t            cost=lambda g, s: True,\n116\t            effect=lambda g: None,\n117\t        )\n118\t        assert ability.is_mana_ability is False\n119\t        assert ability.description == \"\"\n120\t\n121\t\n122\t# ---------------------------------------------------------------------------\n123\t# LoyaltyAbilityInstance — construction\n124\t# ---------------------------------------------------------------------------\n125\t\n126\t\n127\tclass TestLoyaltyAbilityInstanceConstruction:\n128\t    \"\"\"LoyaltyAbilityInstance dataclass stores all expected fields.\"\"\"\n129\t\n130\t    def test_fields_assigned(self):\n131\t        source = object()\n132\t        controller = DeterministicPlayer(\"Alice\", [])\n133\t        effect = lambda g: None\n134\t        ability = LoyaltyAbilityInstance(\n135\t            source=source,\n136\t            controller=controller,\n137\t            loyalty_cost=-3,\n138\t            effect=effect,\n139\t            description=\"Destroy target creature\",\n140\t        )\n141\t        assert ability.source is source\n142\t        assert ability.controller is controller\n143\t        assert ability.loyalty_cost == -3\n144\t        assert ability.effect is effect\n145\t        assert ability.description == \"Destroy target creature\"\n146\t\n147\t    def test_defaults(self):\n148\t        source = object()\n149\t        controller = DeterministicPlayer(\"Alice\", [])\n150\t        ability = LoyaltyAbilityInstance(\n151\t            source=source,\n152\t            controller=controller,\n153\t        )\n154\t        assert ability.loyalty_cost == 0\n155\t        assert ability.description == \"\"\n156\t        # default effect should be callable\n157\t        ability.effect(None)  # should not raise\n158\t\n159\t\n160\t# ---------------------------------------------------------------------------\n161\t# tap_cost helper\n162\t# ---------------------------------------------------------------------------\n163\t\n164\t\n165\tclass TestTapCost:\n166\t    \"\"\"tap_cost checks untapped state and sets is_tapped = True.\"\"\"\n167\t\n168\t    def test_untapped_source_returns_true(self):\n169\t        game = _sorcery_speed_game()\n170\t        source = Land(name=\"Forest\")\n171\t        assert source.is_tapped is False\n172\t        result = tap_cost(game, source)\n173\t        assert result is True\n174\t\n175\t    def test_untapped_source_becomes_tapped(self):\n176\t        game = _sorcery_speed_game()\n177\t        source = Land(name=\"Forest\")\n178\t        tap_cost(game, source)\n179\t        assert source.is_tapped is True\n180\t\n181\t    def test_already_tapped_source_returns_false(self):\n182\t        game = _sorcery_speed_game()\n183\t        source = Land(name=\"Forest\")\n184\t        source.is_tapped = True\n185\t        result = tap_cost(game, source)\n186\t        assert result is False\n187\t\n188\t    def test_already_tapped_source_stays_tapped(self):\n189\t        game = _sorcery_speed_game()\n190\t        source = Land(name=\"Forest\")\n191\t        source.is_tapped = True\n192\t        tap_cost(game, source)\n193\t        assert source.is_tapped is True\n194\t\n195\t    def test_source_without_is_tapped_attribute(self):\n196\t        \"\"\"Source with no is_tapped attribute is treated as untapped.\"\"\"\n197\t        game = _sorcery_speed_game()\n198\t\n199\t        class Bare:\n200\t            pass\n201\t\n202\t        source = Bare()\n203\t        result = tap_cost(game, source)\n204\t        assert result is True\n205\t        assert source.is_tapped is True\n206\t\n207\t\n208\t# ---------------------------------------------------------------------------\n209\t# activate_ability — mana ability (resolves immediately)\n210\t# ---------------------------------------------------------------------------\n211\t\n212\t\n213\tclass TestActivateManaAbility:\n214\t    \"\"\"Mana abilities resolve immediately without using the stack.\"\"\"\n215\t\n216\t    def test_mana_ability_does_not_push_to_stack(self):\n217\t        game = _sorcery_speed_game()\n218\t        player = game.players[0]\n219\t        source = Land(name=\"Forest\")\n220\t        effect_called = []\n221\t        ability = ActivatedAbilityInstance(\n222\t            source=source,\n223\t            controller=player,\n224\t            cost=lambda g, s: True,\n225\t            effect=lambda g: effect_called.append(True),\n226\t            is_mana_ability=True,\n227\t        )\n228\t        activate_ability(game, player, ability)\n229\t        assert game.stack.is_empty()\n230\t\n231\t    def test_mana_ability_effect_is_called_immediately(self):\n232\t        game = _sorcery_speed_game()\n233\t        player = game.players[0]\n234\t        source = Land(name=\"Forest\")\n235\t        effect_called = []\n236\t        ability = ActivatedAbilityInstance(\n237\t            source=source,\n238\t            controller=player,\n239\t            cost=lambda g, s: True,\n240\t            effect=lambda g: effect_called.append(True),\n241\t            is_mana_ability=True,\n242\t        )\n243\t        activate_ability(game, player, ability)\n244\t        assert len(effect_called) == 1\n245\t\n246\t    def test_mana_ability_bypasses_timing_check(self):\n247\t        \"\"\"Mana abilities can be activated even at non-sorcery-speed timing.\"\"\"\n248\t        game = _instant_speed_game()\n249\t        player = game.players[0]\n250\t        source = Land(name=\"Forest\")\n251\t        effect_called = []\n252\t        ability = ActivatedAbilityInstance(\n253\t            source=source,\n254\t            controller=player,\n255\t            cost=lambda g, s: True,\n256\t            effect=lambda g: effect_called.append(True),\n257\t            is_mana_ability=True,\n258\t        )\n259\t        # Should not raise — mana abilities ignore sorcery-speed timing.\n260\t        activate_ability(game, player, ability)\n261\t        assert len(effect_called) == 1\n262\t\n263\t    def test_mana_ability_during_non_active_player_turn(self):\n264\t        \"\"\"Mana abilities can be activated even by non-active player.\"\"\"\n265\t        game = _instant_speed_game()\n266\t        non_active = game.players[1]\n267\t        effect_called = []\n268\t        source = Land(name=\"Island\")\n269\t        ability = ActivatedAbilityInstance(\n270\t            source=source,\n271\t            controller=non_active,\n272\t            cost=lambda g, s: True,\n273\t            effect=lambda g: effect_called.append(True),\n274\t            is_mana_ability=True,\n275\t        )\n276\t        # Should not raise — mana abilities can be activated at any time.\n277\t        activate_ability(game, non_active, ability)\n278\t        assert len(effect_called) == 1\n279\t\n280\t    def test_mana_ability_cost_failure_raises(self):\n281\t        \"\"\"If the cost of a mana ability cannot be paid, AbilityError is raised.\"\"\"\n282\t        game = _sorcery_speed_game()\n283\t        player = game.players[0]\n284\t        source = Land(name=\"Forest\")\n285\t        source.is_tapped = True\n286\t        ability = ActivatedAbilityInstance(\n287\t            source=source,\n288\t            controller=player,\n289\t            cost=tap_cost,\n290\t            effect=lambda g: None,\n291\t            is_mana_ability=True,\n292\t        )\n293\t        with pytest.raises(AbilityError, match=\"cost could not be paid\"):\n294\t            activate_ability(game, player, ability)\n295\t\n296\t\n297\t# ---------------------------------------------------------------------------\n298\t# activate_ability — non-mana ability (pushes to stack)\n299\t# ---------------------------------------------------------------------------\n300\t\n301\t\n302\tclass TestActivateNonManaAbility:\n303\t    \"\"\"Non-mana activated abilities go on the stack.\"\"\"\n304\t\n305\t    def test_pushes_stack_object(self):\n306\t        game = _sorcery_speed_game()\n307\t        player = game.players[0]\n308\t        source = object()\n309\t        ability = ActivatedAbilityInstance(\n310\t            source=source,\n311\t            controller=player,\n312\t            cost=lambda g, s: True,\n313\t            effect=lambda g: None,\n314\t            is_mana_ability=False,\n315\t        )\n316\t        activate_ability(game, player, ability)\n317\t        assert not game.stack.is_empty()\n318\t\n319\t    def test_stack_object_has_correct_source(self):\n320\t        game = _sorcery_speed_game()\n321\t        player = game.players[0]\n322\t        source = object()\n323\t        ability = ActivatedAbilityInstance(\n324\t            source=source,\n325\t            controller=player,\n326\t            cost=lambda g, s: True,\n327\t            effect=lambda g: None,\n328\t        )\n329\t        activate_ability(game, player, ability)\n330\t        top = game.stack.peek()\n331\t        assert top is not None\n332\t        assert top.source is source\n333\t\n334\t    def test_stack_object_has_correct_controller(self):\n335\t        game = _sorcery_speed_game()\n336\t        player = game.players[0]\n337\t        ability = ActivatedAbilityInstance(\n338\t            source=object(),\n339\t            controller=player,\n340\t            cost=lambda g, s: True,\n341\t            effect=lambda g: None,\n342\t        )\n343\t        activate_ability(game, player, ability)\n344\t        top = game.stack.peek()\n345\t        assert top.controller is player\n346\t\n347\t    def test_stack_object_on_resolve_is_ability_effect(self):\n348\t        game = _sorcery_speed_game()\n349\t        player = game.players[0]\n350\t        resolved = []\n351\t        effect = lambda g: resolved.append(\"resolved\")\n352\t        ability = ActivatedAbilityInstance(\n353\t            source=object(),\n354\t            controller=player,\n355\t            cost=lambda g, s: True,\n356\t            effect=effect,\n357\t        )\n358\t        activate_ability(game, player, ability)\n359\t        top = game.stack.peek()\n360\t        top.on_resolve(game)\n361\t        assert resolved == [\"resolved\"]\n362\t\n363\t    def test_stack_object_is_not_mana_ability(self):\n364\t        game = _sorcery_speed_game()\n365\t        player = game.players[0]\n366\t        ability = ActivatedAbilityInstance(\n367\t            source=object(),\n368\t            controller=player,\n369\t            cost=lambda g, s: True,\n370\t            effect=lambda g: None,\n371\t        )\n372\t        activate_ability(game, player, ability)\n373\t        top = game.stack.peek()\n374\t        assert top.is_mana_ability is False\n375\t\n376\t    def test_effect_not_called_on_activation(self):\n377\t        \"\"\"Non-mana abilities effect should NOT be called immediately.\"\"\"\n378\t        game = _sorcery_speed_game()\n379\t        player = game.players[0]\n380\t        effect_called = []\n381\t        ability = ActivatedAbilityInstance(\n382\t            source=object(),\n383\t            controller=player,\n384\t            cost=lambda g, s: True,\n385\t            effect=lambda g: effect_called.append(True),\n386\t        )\n387\t        activate_ability(game, player, ability)\n388\t        assert len(effect_called) == 0\n389\t\n390\t\n391\t# ---------------------------------------------------------------------------\n392\t# Timing checks for non-mana abilities\n393\t# ---------------------------------------------------------------------------\n394\t\n395\t\n396\tclass TestNonManaAbilityTiming:\n397\t    \"\"\"Regular (non-mana) activated abilities work at instant speed.\n398\t\n399\t    They can be activated whenever a player has priority — during any\n400\t    phase/step, even with items on the stack.  Priority enforcement is\n401\t    handled externally by ``priority_loop``, not by ``activate_ability``.\n402\t    Only *loyalty* abilities carry a sorcery-speed restriction.\n403\t    \"\"\"\n404\t\n405\t    def test_allowed_during_combat(self):\n406\t        \"\"\"Regular abilities can be activated during combat (instant speed).\"\"\"\n407\t        game = _instant_speed_game()\n408\t        player = game.players[0]\n409\t        ability = ActivatedAbilityInstance(\n410\t            source=object(),\n411\t            controller=player,\n412\t            cost=lambda g, s: True,\n413\t            effect=lambda g: None,\n414\t            is_mana_ability=False,\n415\t        )\n416\t        # Should not raise — regular abilities are instant speed.\n417\t        activate_ability(game, player, ability)\n418\t        assert not game.stack.is_empty()\n419\t\n420\t    def test_allowed_when_stack_not_empty(self):\n421\t        \"\"\"Regular abilities can be activated even when the stack has items.\"\"\"\n422\t        game = _sorcery_speed_game()\n423\t        player = game.players[0]\n424\t        # Put something on the stack.\n425\t        game.stack.push(StackObject(source=object(), controller=player))\n426\t        ability = ActivatedAbilityInstance(\n427\t            source=object(),\n428\t            controller=player,\n429\t            cost=lambda g, s: True,\n430\t            effect=lambda g: None,\n431\t            is_mana_ability=False,\n432\t        )\n433\t        # Should not raise — regular abilities work at instant speed.\n434\t        activate_ability(game, player, ability)\n435\t        # Stack should now have 2 items (the existing one + the new ability).\n436\t        assert game.stack.peek() is not None\n437\t\n438\t    def test_allowed_for_non_active_player(self):\n439\t        \"\"\"Regular abilities can be activated by non-active player (with priority).\"\"\"\n440\t        game = _sorcery_speed_game()\n441\t        non_active = game.players[1]\n442\t        ability = ActivatedAbilityInstance(\n443\t            source=object(),\n444\t            controller=non_active,\n445\t            cost=lambda g, s: True,\n446\t            effect=lambda g: None,\n447\t            is_mana_ability=False,\n448\t        )\n449\t        # Should not raise — priority enforcement is external.\n450\t        activate_ability(game, non_active, ability)\n451\t        assert not game.stack.is_empty()\n452\t\n453\t    def test_allowed_during_end_step(self):\n454\t        \"\"\"Regular abilities can be activated during the end step.\"\"\"\n455\t        game = _make_game(phase=Phase.ENDING, step=Step.END)\n456\t        player = game.players[0]\n457\t        ability = ActivatedAbilityInstance(\n458\t            source=object(),\n459\t            controller=player,\n460\t            cost=lambda g, s: True,\n461\t            effect=lambda g: None,\n462\t            is_mana_ability=False,\n463\t        )\n464\t        activate_ability(game, player, ability)\n465\t        assert not game.stack.is_empty()\n466\t\n467\t\n468\t# ---------------------------------------------------------------------------\n469\t# Cost payment failure\n470\t# ---------------------------------------------------------------------------\n471\t\n472\t\n473\tclass TestCostPaymentFailure:\n474\t    \"\"\"If cost returns False, AbilityError is raised and nothing is pushed.\"\"\"\n475\t\n476\t    def test_cost_failure_raises_ability_error(self):\n477\t        game = _sorcery_speed_game()\n478\t        player = game.players[0]\n479\t        ability = ActivatedAbilityInstance(\n480\t            source=object(),\n481\t            controller=player,\n482\t            cost=lambda g, s: False,\n483\t            effect=lambda g: None,\n484\t        )\n485\t        with pytest.raises(AbilityError, match=\"cost could not be paid\"):\n486\t            activate_ability(game, player, ability)\n487\t\n488\t    def test_cost_failure_leaves_stack_empty(self):\n489\t        game = _sorcery_speed_game()\n490\t        player = game.players[0]\n491\t        ability = ActivatedAbilityInstance(\n492\t            source=object(),\n493\t            controller=player,\n494\t            cost=lambda g, s: False,\n495\t            effect=lambda g: None,\n496\t        )\n497\t        with pytest.raises(AbilityError):\n498\t            activate_ability(game, player, ability)\n499\t        assert game.stack.is_empty()\n500\t\n501\t    def test_cost_failure_effect_not_called(self):\n502\t        game = _sorcery_speed_game()\n503\t        player = game.players[0]\n504\t        effect_called = []\n505\t        ability = ActivatedAbilityInstance(\n506\t            source=object(),\n507\t            controller=player,\n508\t            cost=lambda g, s: False,\n509\t            effect=lambda g: effect_called.append(True),\n510\t        )\n511\t        with pytest.raises(AbilityError):\n512\t            activate_ability(game, player, ability)\n513\t        assert len(effect_called) == 0\n514\t\n515\t\n516\t# ---------------------------------------------------------------------------\n517\t# LoyaltyAbility — positive cost (+N)\n518\t# ---------------------------------------------------------------------------\n519\t\n520\t\n521\tclass TestLoyaltyAbilityPositiveCost:\n522\t    \"\"\"Loyalty ability with positive cost increases loyalty counters.\"\"\"\n523\t\n524\t    def test_positive_loyalty_cost_increases_loyalty(self):\n525\t        game = _sorcery_speed_game()\n526\t        player = game.players[0]\n527\t        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=3)\n528\t        ability = LoyaltyAbilityInstance(\n529\t            source=pw,\n530\t            controller=player,\n531\t            loyalty_cost=2,\n532\t            effect=lambda g: None,\n533\t        )\n534\t        activate_ability(game, player, ability)\n535\t        assert pw.loyalty == 5\n536\t\n537\t    def test_positive_cost_pushes_to_stack(self):\n538\t        game = _sorcery_speed_game()\n539\t        player = game.players[0]\n540\t        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=3)\n541\t        ability = LoyaltyAbilityInstance(\n542\t            source=pw,\n543\t            controller=player,\n544\t            loyalty_cost=1,\n545\t            effect=lambda g: None,\n546\t        )\n547\t        activate_ability(game, player, ability)\n548\t        assert not game.stack.is_empty()\n549\t\n550\t\n551\t# ---------------------------------------------------------------------------\n552\t# LoyaltyAbility — negative cost (−N)\n553\t# ---------------------------------------------------------------------------\n554\t\n555\t\n556\tclass TestLoyaltyAbilityNegativeCost:\n557\t    \"\"\"Loyalty ability with negative cost decreases loyalty counters.\"\"\"\n558\t\n559\t    def test_negative_loyalty_cost_decreases_loyalty(self):\n560\t        game = _sorcery_speed_game()\n561\t        player = game.players[0]\n562\t        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=5)\n563\t        ability = LoyaltyAbilityInstance(\n564\t            source=pw,\n565\t            controller=player,\n566\t            loyalty_cost=-3,\n567\t            effect=lambda g: None,\n568\t        )\n569\t        activate_ability(game, player, ability)\n570\t        assert pw.loyalty == 2\n571\t\n572\t    def test_negative_cost_exact_loyalty(self):\n573\t        \"\"\"Using -N when loyalty == N should succeed and set loyalty to 0.\"\"\"\n574\t        game = _sorcery_speed_game()\n575\t        player = game.players[0]\n576\t        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=4)\n577\t        ability = LoyaltyAbilityInstance(\n578\t            source=pw,\n579\t            controller=player,\n580\t            loyalty_cost=-4,\n581\t            effect=lambda g: None,\n582\t        )\n583\t        activate_ability(game, player, ability)\n584\t        assert pw.loyalty == 0\n585\t\n586\t    def test_insufficient_loyalty_raises(self):\n587\t        \"\"\"Cannot activate −N if source loyalty < N.\"\"\"\n588\t        game = _sorcery_speed_game()\n589\t        player = game.players[0]\n590\t        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=2)\n591\t        ability = LoyaltyAbilityInstance(\n592\t            source=pw,\n593\t            controller=player,\n594\t            loyalty_cost=-5,\n595\t            effect=lambda g: None,\n596\t        )\n597\t        with pytest.raises(AbilityError, match=\"insufficient loyalty\"):\n598\t            activate_ability(game, player, ability)\n599\t\n600\t    def test_insufficient_loyalty_no_stack_entry(self):\n601\t        game = _sorcery_speed_game()\n602\t        player = game.players[0]\n603\t        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=1)\n604\t        ability = LoyaltyAbilityInstance(\n605\t            source=pw,\n606\t            controller=player,\n607\t            loyalty_cost=-3,\n608\t            effect=lambda g: None,\n609\t        )\n610\t        with pytest.raises(AbilityError):\n611\t            activate_ability(game, player, ability)\n612\t        assert game.stack.is_empty()\n613\t\n614\t    def test_insufficient_loyalty_does_not_change_loyalty(self):\n615\t        game = _sorcery_speed_game()\n616\t        player = game.players[0]\n617\t        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=2)\n618\t        ability = LoyaltyAbilityInstance(\n619\t            source=pw,\n620\t            controller=player,\n621\t            loyalty_cost=-5,\n622\t            effect=lambda g: None,\n623\t        )\n624\t        with pytest.raises(AbilityError):\n625\t            activate_ability(game, player, ability)\n626\t        assert pw.loyalty == 2  # unchanged\n627\t\n628\t\n629\t# ---------------------------------------------------------------------------\n630\t# LoyaltyAbility — zero cost\n631\t# ---------------------------------------------------------------------------\n632\t\n633\t\n634\tclass TestLoyaltyAbilityZeroCost:\n635\t    \"\"\"Loyalty ability with zero cost leaves loyalty unchanged.\"\"\"\n636\t\n637\t    def test_zero_loyalty_cost_does_not_change_loyalty(self):\n638\t        game = _sorcery_speed_game()\n639\t        player = game.players[0]\n640\t        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=3)\n641\t        ability = LoyaltyAbilityInstance(\n642\t            source=pw,\n643\t            controller=player,\n644\t            loyalty_cost=0,\n645\t            effect=lambda g: None,\n646\t        )\n647\t        activate_ability(game, player, ability)\n648\t        assert pw.loyalty == 3\n649\t\n650\t\n651\t# ---------------------------------------------------------------------------\n652\t# LoyaltyAbility — once-per-turn restriction\n653\t# ---------------------------------------------------------------------------\n654\t\n655\t\n656\tclass TestLoyaltyOncePerTurn:\n657\t    \"\"\"Only one loyalty ability per source per turn.\"\"\"\n658\t\n659\t    def test_second_activation_same_turn_raises(self):\n660\t        game = _sorcery_speed_game()\n661\t        player = game.players[0]\n662\t        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=10)\n663\t        ability = LoyaltyAbilityInstance(\n664\t            source=pw,\n665\t            controller=player,\n666\t            loyalty_cost=1,\n667\t            effect=lambda g: None,\n668\t        )\n669\t        # First activation succeeds.\n670\t        activate_ability(game, player, ability)\n671\t        # Clear the stack so sorcery-speed check still passes.\n672\t        game.stack.pop()\n673\t        # Second activation should fail.\n674\t        with pytest.raises(AbilityError, match=\"already activated this turn\"):\n675\t            activate_ability(game, player, ability)\n676\t\n677\t    def test_second_activation_no_stack_entry(self):\n678\t        game = _sorcery_speed_game()\n679\t        player = game.players[0]\n680\t        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=10)\n681\t        ability = LoyaltyAbilityInstance(\n682\t            source=pw,\n683\t            controller=player,\n684\t            loyalty_cost=1,\n685\t            effect=lambda g: None,\n686\t        )\n687\t        activate_ability(game, player, ability)\n688\t        game.stack.pop()\n689\t        with pytest.raises(AbilityError):\n690\t            activate_ability(game, player, ability)\n691\t        assert game.stack.is_empty()\n692\t\n693\t    def test_clear_loyalty_tracking_allows_reactivation(self):\n694\t        \"\"\"Simulates a new turn by calling clear_loyalty_tracking.\"\"\"\n695\t        game = _sorcery_speed_game()\n696\t        player = game.players[0]\n697\t        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=10)\n698\t        ability = LoyaltyAbilityInstance(\n699\t            source=pw,\n700\t            controller=player,\n701\t            loyalty_cost=1,\n702\t            effect=lambda g: None,\n703\t        )\n704\t        activate_ability(game, player, ability)\n705\t        game.stack.pop()  # clear stack for sorcery-speed\n706\t        # Clearing the tracking simulates a new turn starting.\n707\t        clear_loyalty_tracking()\n708\t        # Now activation should succeed again.\n709\t        activate_ability(game, player, ability)\n710\t        assert not game.stack.is_empty()\n711\t\n712\t    def test_different_turn_number_allows_reactivation(self):\n713\t        \"\"\"Different turn number means the once-per-turn has reset.\"\"\"\n714\t        game = _sorcery_speed_game()\n715\t        player = game.players[0]\n716\t        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=10)\n717\t        ability = LoyaltyAbilityInstance(\n718\t            source=pw,\n719\t            controller=player,\n720\t            loyalty_cost=1,\n721\t            effect=lambda g: None,\n722\t        )\n723\t        game.turn_number = 1\n724\t        activate_ability(game, player, ability)\n725\t        game.stack.pop()\n726\t        # Advance to turn 2.\n727\t        game.turn_number = 2\n728\t        activate_ability(game, player, ability)\n729\t        assert not game.stack.is_empty()\n730\t\n731\t    def test_different_sources_allowed_same_turn(self):\n732\t        \"\"\"Two different planeswalkers can each activate once per turn.\"\"\"\n733\t        game = _sorcery_speed_game()\n734\t        player = game.players[0]\n735\t        pw1 = Planeswalker(name=\"Walker1\", starting_loyalty=5)\n736\t        pw2 = Planeswalker(name=\"Walker2\", starting_loyalty=5)\n737\t        ability1 = LoyaltyAbilityInstance(\n738\t            source=pw1,\n739\t            controller=player,\n740\t            loyalty_cost=1,\n741\t            effect=lambda g: None,\n742\t        )\n743\t        ability2 = LoyaltyAbilityInstance(\n744\t            source=pw2,\n745\t            controller=player,\n746\t            loyalty_cost=1,\n747\t            effect=lambda g: None,\n748\t        )\n749\t        activate_ability(game, player, ability1)\n750\t        game.stack.pop()  # clear stack\n751\t        activate_ability(game, player, ability2)\n752\t        assert not game.stack.is_empty()\n753\t\n754\t\n755\t# ---------------------------------------------------------------------------\n756\t# LoyaltyAbility — timing\n757\t# ---------------------------------------------------------------------------\n758\t\n759\t\n760\tclass TestLoyaltyAbilityTiming:\n761\t    \"\"\"Loyalty abilities require sorcery-speed timing.\"\"\"\n762\t\n763\t    def test_rejected_during_combat(self):\n764\t        game = _instant_speed_game()\n765\t        player = game.players[0]\n766\t        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=5)\n767\t        ability = LoyaltyAbilityInstance(\n768\t            source=pw,\n769\t            controller=player,\n770\t            loyalty_cost=1,\n771\t            effect=lambda g: None,\n772\t        )\n773\t        with pytest.raises(AbilityError, match=\"sorcery-speed\"):\n774\t            activate_ability(game, player, ability)\n775\t\n776\t    def test_rejected_for_non_active_player(self):\n777\t        game = _sorcery_speed_game()\n778\t        non_active = game.players[1]\n779\t        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=5)\n780\t        ability = LoyaltyAbilityInstance(\n781\t            source=pw,\n782\t            controller=non_active,\n783\t            loyalty_cost=1,\n784\t            effect=lambda g: None,\n785\t        )\n786\t        with pytest.raises(AbilityError, match=\"sorcery-speed\"):\n787\t            activate_ability(game, non_active, ability)\n788\t\n789\t\n790\t# ---------------------------------------------------------------------------\n791\t# Integration: land tap-for-mana\n792\t# ---------------------------------------------------------------------------\n793\t\n794\t\n795\tclass TestLandTapForMana:\n796\t    \"\"\"End-to-end: tap a land for mana → mana added and card tapped.\"\"\"\n797\t\n798\t    def test_land_tap_for_mana_adds_mana_and_taps(self):\n799\t        game = _sorcery_speed_game()\n800\t        player = game.players[0]\n801\t        forest = Land(name=\"Forest\")\n802\t        forest.is_tapped = False\n803\t\n804\t        def forest_effect(g: GameState) -> None:\n805\t            player.mana_pool.add(ManaType.GREEN, 1)\n806\t\n807\t        ability = ActivatedAbilityInstance(\n808\t            source=forest,\n809\t            controller=player,\n810\t            cost=tap_cost,\n811\t            effect=forest_effect,\n812\t            is_mana_ability=True,\n813\t            description=\"{T}: Add {G}\",\n814\t        )\n815\t        activate_ability(game, player, ability)\n816\t        assert forest.is_tapped is True\n817\t        assert player.mana_pool.get(ManaType.GREEN) == 1\n818\t\n819\t    def test_land_tap_for_mana_stack_remains_empty(self):\n820\t        game = _sorcery_speed_game()\n821\t        player = game.players[0]\n822\t        forest = Land(name=\"Forest\")\n823\t\n824\t        ability = ActivatedAbilityInstance(\n825\t            source=forest,\n826\t            controller=player,\n827\t            cost=tap_cost,\n828\t            effect=lambda g: player.mana_pool.add(ManaType.GREEN, 1),\n829\t            is_mana_ability=True,\n830\t        )\n831\t        activate_ability(game, player, ability)\n832\t        assert game.stack.is_empty()\n833\t\n834\t    def test_tapped_land_cannot_tap_for_mana(self):\n835\t        game = _sorcery_speed_game()\n836\t        player = game.players[0]\n837\t        forest = Land(name=\"Forest\")\n838\t        forest.is_tapped = True\n839\t\n840\t        ability = ActivatedAbilityInstance(\n841\t            source=forest,\n842\t            controller=player,\n843\t            cost=tap_cost,\n844\t            effect=lambda g: player.mana_pool.add(ManaType.GREEN, 1),\n845\t            is_mana_ability=True,\n846\t        )\n847\t        with pytest.raises(AbilityError, match=\"cost could not be paid\"):\n848\t            activate_ability(game, player, ability)\n849\t        # Mana pool should be unchanged.\n850\t        assert player.mana_pool.get(ManaType.GREEN) == 0\n851\t\n852\t    def test_land_tap_for_mana_at_instant_speed(self):\n853\t        \"\"\"Mana abilities can be activated during combat, etc.\"\"\"\n854\t        game = _instant_speed_game()\n855\t        player = game.players[0]\n856\t        island = Land(name=\"Island\")\n857\t\n858\t        ability = ActivatedAbilityInstance(\n859\t            source=island,\n860\t            controller=player,\n861\t            cost=tap_cost,\n862\t            effect=lambda g: player.mana_pool.add(ManaType.BLUE, 1),\n863\t            is_mana_ability=True,\n864\t        )\n865\t        activate_ability(game, player, ability)\n866\t        assert island.is_tapped is True\n867\t        assert player.mana_pool.get(ManaType.BLUE) == 1\n868\t\n869\t\n870\t# ---------------------------------------------------------------------------\n871\t# Multiple abilities on the same source\n872\t# ---------------------------------------------------------------------------\n873\t\n874\t\n875\tclass TestMultipleAbilitiesSameSource:\n876\t    \"\"\"Multiple abilities on a single permanent.\"\"\"\n877\t\n878\t    def test_activate_two_different_mana_abilities_on_same_source(self):\n879\t        \"\"\"Example: a dual land with two mana abilities (but requires two taps\n880\t        in real MTG — here we test that both abilities are independent).\"\"\"\n881\t        game = _sorcery_speed_game()\n882\t        player = game.players[0]\n883\t        dual_land = Land(name=\"DualLand\")\n884\t\n885\t        ability_green = ActivatedAbilityInstance(\n886\t            source=dual_land,\n887\t            controller=player,\n888\t            cost=tap_cost,\n889\t            effect=lambda g: player.mana_pool.add(ManaType.GREEN, 1),\n890\t            is_mana_ability=True,\n891\t        )\n892\t        ability_white = ActivatedAbilityInstance(\n893\t            source=dual_land,\n894\t            controller=player,\n895\t            cost=tap_cost,\n896\t            effect=lambda g: player.mana_pool.add(ManaType.WHITE, 1),\n897\t            is_mana_ability=True,\n898\t        )\n899\t        # First activation taps the land.\n900\t        activate_ability(game, player, ability_green)\n901\t        assert dual_land.is_tapped is True\n902\t        assert player.mana_pool.get(ManaType.GREEN) == 1\n903\t\n904\t        # Second activation fails because the land is already tapped.\n905\t        with pytest.raises(AbilityError, match=\"cost could not be paid\"):\n906\t            activate_ability(game, player, ability_white)\n907\t        # White mana should not have been added.\n908\t        assert player.mana_pool.get(ManaType.WHITE) == 0\n909\t\n910\t\n911\t# ---------------------------------------------------------------------------\n912\t# Unknown ability type\n913\t# ---------------------------------------------------------------------------\n914\t\n915\t\n916\tclass TestUnknownAbilityType:\n917\t    \"\"\"activate_ability rejects unknown ability types.\"\"\"\n918\t\n919\t    def test_unknown_type_raises(self):\n920\t        game = _sorcery_speed_game()\n921\t        player = game.players[0]\n922\t        with pytest.raises(AbilityError, match=\"Unknown ability type\"):\n923\t            activate_ability(game, player, \"not an ability\")  # type: ignore[arg-type]\n924\t\n925\t\n926\t# ---------------------------------------------------------------------------\n927\t# Loyalty stack object properties\n928\t# ---------------------------------------------------------------------------\n929\t\n930\t\n931\tclass TestLoyaltyStackObject:\n932\t    \"\"\"Verify the StackObject pushed by loyalty ability has correct properties.\"\"\"\n933\t\n934\t    def test_stack_object_source_is_planeswalker(self):\n935\t        game = _sorcery_speed_game()\n936\t        player = game.players[0]\n937\t        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=5)\n938\t        ability = LoyaltyAbilityInstance(\n939\t            source=pw,\n940\t            controller=player,\n941\t            loyalty_cost=1,\n942\t            effect=lambda g: None,\n943\t        )\n944\t        activate_ability(game, player, ability)\n945\t        top = game.stack.peek()\n946\t        assert top.source is pw\n947\t\n948\t    def test_stack_object_controller_is_player(self):\n949\t        game = _sorcery_speed_game()\n950\t        player = game.players[0]\n951\t        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=5)\n952\t        ability = LoyaltyAbilityInstance(\n953\t            source=pw,\n954\t            controller=player,\n955\t            loyalty_cost=1,\n956\t            effect=lambda g: None,\n957\t        )\n958\t        activate_ability(game, player, ability)\n959\t        top = game.stack.peek()\n960\t        assert top.controller is player\n961\t\n962\t    def test_stack_object_on_resolve_invokes_effect(self):\n963\t        game = _sorcery_speed_game()\n964\t        player = game.players[0]\n965\t        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=5)\n966\t        resolved = []\n967\t        ability = LoyaltyAbilityInstance(\n968\t            source=pw,\n969\t            controller=player,\n970\t            loyalty_cost=1,\n971\t            effect=lambda g: resolved.append(\"done\"),\n972\t        )\n973\t        activate_ability(game, player, ability)\n974\t        top = game.stack.peek()\n975\t        top.on_resolve(game)\n976\t        assert resolved == [\"done\"]\n977\t"}]},"parent_tool_use_id":null,"session_id":"1995741a-49a1-4a45-a041-801f56ba31a7","uuid":"e1d8b21e-45c2-4036-bcc6-449b716f8b63","timestamp":"2026-06-02T06:46:09.241Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine_tests/test_abilities.py","content":"\"\"\"Tests for engine/abilities.py — Activated abilities system.\n\nCovers:\n- ActivatedAbilityInstance dataclass construction and fields.\n- LoyaltyAbilityInstance dataclass construction and fields.\n- activate_ability: mana ability → resolves immediately (no stack), effect applied.\n- activate_ability: non-mana ability → pushes StackObject to stack.\n- tap_cost: succeeds when untapped, fails when already tapped, sets is_tapped.\n- Timing checks: regular activated abilities work at instant speed (no sorcery restriction).\n- Mana abilities bypass timing checks entirely (resolve immediately).\n- Only loyalty abilities have sorcery-speed restriction.\n- LoyaltyAbility: loyalty counter adjustment (+N, −N).\n- LoyaltyAbility: once-per-turn restriction.\n- LoyaltyAbility: once-per-turn resets after clear_loyalty_tracking.\n- LoyaltyAbility: insufficient loyalty for −N cost → AbilityError.\n- Cost payment failure → AbilityError, no stack entry.\n- Integration: land tap-for-mana → mana added and card tapped.\n- Multiple abilities on the same source.\n- Edge cases: unknown ability type, zero loyalty cost, etc.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport pytest\n\nfrom engine.abilities import (\n    AbilityError,\n    ActivatedAbilityInstance,\n    LoyaltyAbilityInstance,\n    activate_ability,\n    clear_loyalty_tracking,\n    tap_cost,\n)\nfrom engine.card import Land, Planeswalker\nfrom engine.game_state import GameState\nfrom engine.mana import ManaPool\nfrom engine.player import DeterministicPlayer\nfrom engine.stack import StackObject\nfrom engine.types import ManaType, Phase, Step\n\n\n# ---------------------------------------------------------------------------\n# Helpers / Fixtures\n# ---------------------------------------------------------------------------\n\n\n@pytest.fixture(autouse=True)\ndef _reset_loyalty_tracker():\n    \"\"\"Ensure the module-level loyalty tracker is clean for every test.\"\"\"\n    clear_loyalty_tracking()\n    yield\n    clear_loyalty_tracking()\n\n\ndef _make_game(\n    *,\n    p1_script: list | None = None,\n    p2_script: list | None = None,\n    phase: Phase = Phase.PRECOMBAT_MAIN,\n    step: Step | None = None,\n) -> GameState:\n    \"\"\"Create a minimal 2-player GameState at the specified phase/step.\"\"\"\n    p1 = DeterministicPlayer(\"Alice\", p1_script or [])\n    p2 = DeterministicPlayer(\"Bob\", p2_script or [])\n    game = GameState([p1, p2])\n    game.phase = phase\n    game.step = step\n    return game\n\n\ndef _sorcery_speed_game() -> GameState:\n    \"\"\"Return a game where sorcery-speed timing is met for the active player.\"\"\"\n    return _make_game(phase=Phase.PRECOMBAT_MAIN, step=None)\n\n\ndef _instant_speed_game() -> GameState:\n    \"\"\"Return a game where sorcery-speed timing is NOT met (combat phase).\"\"\"\n    return _make_game(phase=Phase.COMBAT, step=Step.DECLARE_ATTACKERS)\n\n\n# ---------------------------------------------------------------------------\n# ActivatedAbilityInstance — construction\n# ---------------------------------------------------------------------------\n\n\nclass TestActivatedAbilityInstanceConstruction:\n    \"\"\"ActivatedAbilityInstance dataclass stores all expected fields.\"\"\"\n\n    def test_fields_assigned(self):\n        source = object()\n        controller = DeterministicPlayer(\"Alice\", [])\n        cost = lambda g, s: True\n        effect = lambda g: None\n        ability = ActivatedAbilityInstance(\n            source=source,\n            controller=controller,\n            cost=cost,\n            effect=effect,\n            is_mana_ability=True,\n            description=\"Tap for mana\",\n        )\n        assert ability.source is source\n        assert ability.controller is controller\n        assert ability.cost is cost\n        assert ability.effect is effect\n        assert ability.is_mana_ability is True\n        assert ability.description == \"Tap for mana\"\n\n    def test_defaults(self):\n        source = object()\n        controller = DeterministicPlayer(\"Alice\", [])\n        ability = ActivatedAbilityInstance(\n            source=source,\n            controller=controller,\n            cost=lambda g, s: True,\n            effect=lambda g: None,\n        )\n        assert ability.is_mana_ability is False\n        assert ability.description == \"\"\n\n\n# ---------------------------------------------------------------------------\n# LoyaltyAbilityInstance — construction\n# ---------------------------------------------------------------------------\n\n\nclass TestLoyaltyAbilityInstanceConstruction:\n    \"\"\"LoyaltyAbilityInstance dataclass stores all expected fields.\"\"\"\n\n    def test_fields_assigned(self):\n        source = object()\n        controller = DeterministicPlayer(\"Alice\", [])\n        effect = lambda g: None\n        ability = LoyaltyAbilityInstance(\n            source=source,\n            controller=controller,\n            loyalty_cost=-3,\n            effect=effect,\n            description=\"Destroy target creature\",\n        )\n        assert ability.source is source\n        assert ability.controller is controller\n        assert ability.loyalty_cost == -3\n        assert ability.effect is effect\n        assert ability.description == \"Destroy target creature\"\n\n    def test_defaults(self):\n        source = object()\n        controller = DeterministicPlayer(\"Alice\", [])\n        ability = LoyaltyAbilityInstance(\n            source=source,\n            controller=controller,\n        )\n        assert ability.loyalty_cost == 0\n        assert ability.description == \"\"\n        # default effect should be callable\n        ability.effect(None)  # should not raise\n\n\n# ---------------------------------------------------------------------------\n# tap_cost helper\n# ---------------------------------------------------------------------------\n\n\nclass TestTapCost:\n    \"\"\"tap_cost checks untapped state and sets is_tapped = True.\"\"\"\n\n    def test_untapped_source_returns_true(self):\n        game = _sorcery_speed_game()\n        source = Land(name=\"Forest\")\n        assert source.is_tapped is False\n        result = tap_cost(game, source)\n        assert result is True\n\n    def test_untapped_source_becomes_tapped(self):\n        game = _sorcery_speed_game()\n        source = Land(name=\"Forest\")\n        tap_cost(game, source)\n        assert source.is_tapped is True\n\n    def test_already_tapped_source_returns_false(self):\n        game = _sorcery_speed_game()\n        source = Land(name=\"Forest\")\n        source.is_tapped = True\n        result = tap_cost(game, source)\n        assert result is False\n\n    def test_already_tapped_source_stays_tapped(self):\n        game = _sorcery_speed_game()\n        source = Land(name=\"Forest\")\n        source.is_tapped = True\n        tap_cost(game, source)\n        assert source.is_tapped is True\n\n    def test_source_without_is_tapped_attribute(self):\n        \"\"\"Source with no is_tapped attribute is treated as untapped.\"\"\"\n        game = _sorcery_speed_game()\n\n        class Bare:\n            pass\n\n        source = Bare()\n        result = tap_cost(game, source)\n        assert result is True\n        assert source.is_tapped is True\n\n\n# ---------------------------------------------------------------------------\n# activate_ability — mana ability (resolves immediately)\n# ---------------------------------------------------------------------------\n\n\nclass TestActivateManaAbility:\n    \"\"\"Mana abilities resolve immediately without using the stack.\"\"\"\n\n    def test_mana_ability_does_not_push_to_stack(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        source = Land(name=\"Forest\")\n        effect_called = []\n        ability = ActivatedAbilityInstance(\n            source=source,\n            controller=player,\n            cost=lambda g, s: True,\n            effect=lambda g: effect_called.append(True),\n            is_mana_ability=True,\n        )\n        activate_ability(game, player, ability)\n        assert game.stack.is_empty()\n\n    def test_mana_ability_effect_is_called_immediately(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        source = Land(name=\"Forest\")\n        effect_called = []\n        ability = ActivatedAbilityInstance(\n            source=source,\n            controller=player,\n            cost=lambda g, s: True,\n            effect=lambda g: effect_called.append(True),\n            is_mana_ability=True,\n        )\n        activate_ability(game, player, ability)\n        assert len(effect_called) == 1\n\n    def test_mana_ability_bypasses_timing_check(self):\n        \"\"\"Mana abilities can be activated even at non-sorcery-speed timing.\"\"\"\n        game = _instant_speed_game()\n        player = game.players[0]\n        source = Land(name=\"Forest\")\n        effect_called = []\n        ability = ActivatedAbilityInstance(\n            source=source,\n            controller=player,\n            cost=lambda g, s: True,\n            effect=lambda g: effect_called.append(True),\n            is_mana_ability=True,\n        )\n        # Should not raise — mana abilities ignore sorcery-speed timing.\n        activate_ability(game, player, ability)\n        assert len(effect_called) == 1\n\n    def test_mana_ability_during_non_active_player_turn(self):\n        \"\"\"Mana abilities can be activated even by non-active player.\"\"\"\n        game = _instant_speed_game()\n        non_active = game.players[1]\n        effect_called = []\n        source = Land(name=\"Island\")\n        ability = ActivatedAbilityInstance(\n            source=source,\n            controller=non_active,\n            cost=lambda g, s: True,\n            effect=lambda g: effect_called.append(True),\n            is_mana_ability=True,\n        )\n        # Should not raise — mana abilities can be activated at any time.\n        activate_ability(game, non_active, ability)\n        assert len(effect_called) == 1\n\n    def test_mana_ability_cost_failure_raises(self):\n        \"\"\"If the cost of a mana ability cannot be paid, AbilityError is raised.\"\"\"\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        source = Land(name=\"Forest\")\n        source.is_tapped = True\n        ability = ActivatedAbilityInstance(\n            source=source,\n            controller=player,\n            cost=tap_cost,\n            effect=lambda g: None,\n            is_mana_ability=True,\n        )\n        with pytest.raises(AbilityError, match=\"cost could not be paid\"):\n            activate_ability(game, player, ability)\n\n\n# ---------------------------------------------------------------------------\n# activate_ability — non-mana ability (pushes to stack)\n# ---------------------------------------------------------------------------\n\n\nclass TestActivateNonManaAbility:\n    \"\"\"Non-mana activated abilities go on the stack.\"\"\"\n\n    def test_pushes_stack_object(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        source = object()\n        ability = ActivatedAbilityInstance(\n            source=source,\n            controller=player,\n            cost=lambda g, s: True,\n            effect=lambda g: None,\n            is_mana_ability=False,\n        )\n        activate_ability(game, player, ability)\n        assert not game.stack.is_empty()\n\n    def test_stack_object_has_correct_source(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        source = object()\n        ability = ActivatedAbilityInstance(\n            source=source,\n            controller=player,\n            cost=lambda g, s: True,\n            effect=lambda g: None,\n        )\n        activate_ability(game, player, ability)\n        top = game.stack.peek()\n        assert top is not None\n        assert top.source is source\n\n    def test_stack_object_has_correct_controller(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        ability = ActivatedAbilityInstance(\n            source=object(),\n            controller=player,\n            cost=lambda g, s: True,\n            effect=lambda g: None,\n        )\n        activate_ability(game, player, ability)\n        top = game.stack.peek()\n        assert top.controller is player\n\n    def test_stack_object_on_resolve_is_ability_effect(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        resolved = []\n        effect = lambda g: resolved.append(\"resolved\")\n        ability = ActivatedAbilityInstance(\n            source=object(),\n            controller=player,\n            cost=lambda g, s: True,\n            effect=effect,\n        )\n        activate_ability(game, player, ability)\n        top = game.stack.peek()\n        top.on_resolve(game)\n        assert resolved == [\"resolved\"]\n\n    def test_stack_object_is_not_mana_ability(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        ability = ActivatedAbilityInstance(\n            source=object(),\n            controller=player,\n            cost=lambda g, s: True,\n            effect=lambda g: None,\n        )\n        activate_ability(game, player, ability)\n        top = game.stack.peek()\n        assert top.is_mana_ability is False\n\n    def test_effect_not_called_on_activation(self):\n        \"\"\"Non-mana abilities effect should NOT be called immediately.\"\"\"\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        effect_called = []\n        ability = ActivatedAbilityInstance(\n            source=object(),\n            controller=player,\n            cost=lambda g, s: True,\n            effect=lambda g: effect_called.append(True),\n        )\n        activate_ability(game, player, ability)\n        assert len(effect_called) == 0\n\n\n# ---------------------------------------------------------------------------\n# Timing checks for non-mana abilities\n# ---------------------------------------------------------------------------\n\n\nclass TestNonManaAbilityTiming:\n    \"\"\"Regular (non-mana) activated abilities work at instant speed.\n\n    They can be activated whenever a player has priority — during any\n    phase/step, even with items on the stack.  Priority enforcement is\n    handled externally by ``priority_loop``, not by ``activate_ability``.\n    Only *loyalty* abilities carry a sorcery-speed restriction.\n    \"\"\"\n\n    def test_allowed_during_combat(self):\n        \"\"\"Regular abilities can be activated during combat (instant speed).\"\"\"\n        game = _instant_speed_game()\n        player = game.players[0]\n        ability = ActivatedAbilityInstance(\n            source=object(),\n            controller=player,\n            cost=lambda g, s: True,\n            effect=lambda g: None,\n            is_mana_ability=False,\n        )\n        # Should not raise — regular abilities are instant speed.\n        activate_ability(game, player, ability)\n        assert not game.stack.is_empty()\n\n    def test_allowed_when_stack_not_empty(self):\n        \"\"\"Regular abilities can be activated even when the stack has items.\"\"\"\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        # Put something on the stack.\n        game.stack.push(StackObject(source=object(), controller=player))\n        ability = ActivatedAbilityInstance(\n            source=object(),\n            controller=player,\n            cost=lambda g, s: True,\n            effect=lambda g: None,\n            is_mana_ability=False,\n        )\n        # Should not raise — regular abilities work at instant speed.\n        activate_ability(game, player, ability)\n        # Stack should now have 2 items (the existing one + the new ability).\n        assert game.stack.peek() is not None\n\n    def test_allowed_for_non_active_player(self):\n        \"\"\"Regular abilities can be activated by non-active player (with priority).\"\"\"\n        game = _sorcery_speed_game()\n        non_active = game.players[1]\n        ability = ActivatedAbilityInstance(\n            source=object(),\n            controller=non_active,\n            cost=lambda g, s: True,\n            effect=lambda g: None,\n            is_mana_ability=False,\n        )\n        # Should not raise — priority enforcement is external.\n        activate_ability(game, non_active, ability)\n        assert not game.stack.is_empty()\n\n    def test_allowed_during_end_step(self):\n        \"\"\"Regular abilities can be activated during the end step.\"\"\"\n        game = _make_game(phase=Phase.ENDING, step=Step.END)\n        player = game.players[0]\n        ability = ActivatedAbilityInstance(\n            source=object(),\n            controller=player,\n            cost=lambda g, s: True,\n            effect=lambda g: None,\n            is_mana_ability=False,\n        )\n        activate_ability(game, player, ability)\n        assert not game.stack.is_empty()\n\n\n# ---------------------------------------------------------------------------\n# Cost payment failure\n# ---------------------------------------------------------------------------\n\n\nclass TestCostPaymentFailure:\n    \"\"\"If cost returns False, AbilityError is raised and nothing is pushed.\"\"\"\n\n    def test_cost_failure_raises_ability_error(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        ability = ActivatedAbilityInstance(\n            source=object(),\n            controller=player,\n            cost=lambda g, s: False,\n            effect=lambda g: None,\n        )\n        with pytest.raises(AbilityError, match=\"cost could not be paid\"):\n            activate_ability(game, player, ability)\n\n    def test_cost_failure_leaves_stack_empty(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        ability = ActivatedAbilityInstance(\n            source=object(),\n            controller=player,\n            cost=lambda g, s: False,\n            effect=lambda g: None,\n        )\n        with pytest.raises(AbilityError):\n            activate_ability(game, player, ability)\n        assert game.stack.is_empty()\n\n    def test_cost_failure_effect_not_called(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        effect_called = []\n        ability = ActivatedAbilityInstance(\n            source=object(),\n            controller=player,\n            cost=lambda g, s: False,\n            effect=lambda g: effect_called.append(True),\n        )\n        with pytest.raises(AbilityError):\n            activate_ability(game, player, ability)\n        assert len(effect_called) == 0\n\n\n# ---------------------------------------------------------------------------\n# LoyaltyAbility — positive cost (+N)\n# ---------------------------------------------------------------------------\n\n\nclass TestLoyaltyAbilityPositiveCost:\n    \"\"\"Loyalty ability with positive cost increases loyalty counters.\"\"\"\n\n    def test_positive_loyalty_cost_increases_loyalty(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=3)\n        ability = LoyaltyAbilityInstance(\n            source=pw,\n            controller=player,\n            loyalty_cost=2,\n            effect=lambda g: None,\n        )\n        activate_ability(game, player, ability)\n        assert pw.loyalty == 5\n\n    def test_positive_cost_pushes_to_stack(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=3)\n        ability = LoyaltyAbilityInstance(\n            source=pw,\n            controller=player,\n            loyalty_cost=1,\n            effect=lambda g: None,\n        )\n        activate_ability(game, player, ability)\n        assert not game.stack.is_empty()\n\n\n# ---------------------------------------------------------------------------\n# LoyaltyAbility — negative cost (−N)\n# ---------------------------------------------------------------------------\n\n\nclass TestLoyaltyAbilityNegativeCost:\n    \"\"\"Loyalty ability with negative cost decreases loyalty counters.\"\"\"\n\n    def test_negative_loyalty_cost_decreases_loyalty(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=5)\n        ability = LoyaltyAbilityInstance(\n            source=pw,\n            controller=player,\n            loyalty_cost=-3,\n            effect=lambda g: None,\n        )\n        activate_ability(game, player, ability)\n        assert pw.loyalty == 2\n\n    def test_negative_cost_exact_loyalty(self):\n        \"\"\"Using -N when loyalty == N should succeed and set loyalty to 0.\"\"\"\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=4)\n        ability = LoyaltyAbilityInstance(\n            source=pw,\n            controller=player,\n            loyalty_cost=-4,\n            effect=lambda g: None,\n        )\n        activate_ability(game, player, ability)\n        assert pw.loyalty == 0\n\n    def test_insufficient_loyalty_raises(self):\n        \"\"\"Cannot activate −N if source loyalty < N.\"\"\"\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=2)\n        ability = LoyaltyAbilityInstance(\n            source=pw,\n            controller=player,\n            loyalty_cost=-5,\n            effect=lambda g: None,\n        )\n        with pytest.raises(AbilityError, match=\"insufficient loyalty\"):\n            activate_ability(game, player, ability)\n\n    def test_insufficient_loyalty_no_stack_entry(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=1)\n        ability = LoyaltyAbilityInstance(\n            source=pw,\n            controller=player,\n            loyalty_cost=-3,\n            effect=lambda g: None,\n        )\n        with pytest.raises(AbilityError):\n            activate_ability(game, player, ability)\n        assert game.stack.is_empty()\n\n    def test_insufficient_loyalty_does_not_change_loyalty(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=2)\n        ability = LoyaltyAbilityInstance(\n            source=pw,\n            controller=player,\n            loyalty_cost=-5,\n            effect=lambda g: None,\n        )\n        with pytest.raises(AbilityError):\n            activate_ability(game, player, ability)\n        assert pw.loyalty == 2  # unchanged\n\n\n# ---------------------------------------------------------------------------\n# LoyaltyAbility — zero cost\n# ---------------------------------------------------------------------------\n\n\nclass TestLoyaltyAbilityZeroCost:\n    \"\"\"Loyalty ability with zero cost leaves loyalty unchanged.\"\"\"\n\n    def test_zero_loyalty_cost_does_not_change_loyalty(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=3)\n        ability = LoyaltyAbilityInstance(\n            source=pw,\n            controller=player,\n            loyalty_cost=0,\n            effect=lambda g: None,\n        )\n        activate_ability(game, player, ability)\n        assert pw.loyalty == 3\n\n\n# ---------------------------------------------------------------------------\n# LoyaltyAbility — once-per-turn restriction\n# ---------------------------------------------------------------------------\n\n\nclass TestLoyaltyOncePerTurn:\n    \"\"\"Only one loyalty ability per source per turn.\"\"\"\n\n    def test_second_activation_same_turn_raises(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=10)\n        ability = LoyaltyAbilityInstance(\n            source=pw,\n            controller=player,\n            loyalty_cost=1,\n            effect=lambda g: None,\n        )\n        # First activation succeeds.\n        activate_ability(game, player, ability)\n        # Clear the stack so sorcery-speed check still passes.\n        game.stack.pop()\n        # Second activation should fail.\n        with pytest.raises(AbilityError, match=\"already activated this turn\"):\n            activate_ability(game, player, ability)\n\n    def test_second_activation_no_stack_entry(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=10)\n        ability = LoyaltyAbilityInstance(\n            source=pw,\n            controller=player,\n            loyalty_cost=1,\n            effect=lambda g: None,\n        )\n        activate_ability(game, player, ability)\n        game.stack.pop()\n        with pytest.raises(AbilityError):\n            activate_ability(game, player, ability)\n        assert game.stack.is_empty()\n\n    def test_clear_loyalty_tracking_allows_reactivation(self):\n        \"\"\"Simulates a new turn by calling clear_loyalty_tracking.\"\"\"\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=10)\n        ability = LoyaltyAbilityInstance(\n            source=pw,\n            controller=player,\n            loyalty_cost=1,\n            effect=lambda g: None,\n        )\n        activate_ability(game, player, ability)\n        game.stack.pop()  # clear stack for sorcery-speed\n        # Clearing the tracking simulates a new turn starting.\n        clear_loyalty_tracking()\n        # Now activation should succeed again.\n        activate_ability(game, player, ability)\n        assert not game.stack.is_empty()\n\n    def test_different_turn_number_allows_reactivation(self):\n        \"\"\"Different turn number means the once-per-turn has reset.\"\"\"\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=10)\n        ability = LoyaltyAbilityInstance(\n            source=pw,\n            controller=player,\n            loyalty_cost=1,\n            effect=lambda g: None,\n        )\n        game.turn_number = 1\n        activate_ability(game, player, ability)\n        game.stack.pop()\n        # Advance to turn 2.\n        game.turn_number = 2\n        activate_ability(game, player, ability)\n        assert not game.stack.is_empty()\n\n    def test_different_sources_allowed_same_turn(self):\n        \"\"\"Two different planeswalkers can each activate once per turn.\"\"\"\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        pw1 = Planeswalker(name=\"Walker1\", starting_loyalty=5)\n        pw2 = Planeswalker(name=\"Walker2\", starting_loyalty=5)\n        ability1 = LoyaltyAbilityInstance(\n            source=pw1,\n            controller=player,\n            loyalty_cost=1,\n            effect=lambda g: None,\n        )\n        ability2 = LoyaltyAbilityInstance(\n            source=pw2,\n            controller=player,\n            loyalty_cost=1,\n            effect=lambda g: None,\n        )\n        activate_ability(game, player, ability1)\n        game.stack.pop()  # clear stack\n        activate_ability(game, player, ability2)\n        assert not game.stack.is_empty()\n\n\n# ---------------------------------------------------------------------------\n# LoyaltyAbility — timing\n# ---------------------------------------------------------------------------\n\n\nclass TestLoyaltyAbilityTiming:\n    \"\"\"Loyalty abilities require sorcery-speed timing.\"\"\"\n\n    def test_rejected_during_combat(self):\n        game = _instant_speed_game()\n        player = game.players[0]\n        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=5)\n        ability = LoyaltyAbilityInstance(\n            source=pw,\n            controller=player,\n            loyalty_cost=1,\n            effect=lambda g: None,\n        )\n        with pytest.raises(AbilityError, match=\"sorcery-speed\"):\n            activate_ability(game, player, ability)\n\n    def test_rejected_for_non_active_player(self):\n        game = _sorcery_speed_game()\n        non_active = game.players[1]\n        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=5)\n        ability = LoyaltyAbilityInstance(\n            source=pw,\n            controller=non_active,\n            loyalty_cost=1,\n            effect=lambda g: None,\n        )\n        with pytest.raises(AbilityError, match=\"sorcery-speed\"):\n            activate_ability(game, non_active, ability)\n\n\n# ---------------------------------------------------------------------------\n# Integration: land tap-for-mana\n# ---------------------------------------------------------------------------\n\n\nclass TestLandTapForMana:\n    \"\"\"End-to-end: tap a land for mana → mana added and card tapped.\"\"\"\n\n    def test_land_tap_for_mana_adds_mana_and_taps(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        forest = Land(name=\"Forest\")\n        forest.is_tapped = False\n\n        def forest_effect(g: GameState) -> None:\n            player.mana_pool.add(ManaType.GREEN, 1)\n\n        ability = ActivatedAbilityInstance(\n            source=forest,\n            controller=player,\n            cost=tap_cost,\n            effect=forest_effect,\n            is_mana_ability=True,\n            description=\"{T}: Add {G}\",\n        )\n        activate_ability(game, player, ability)\n        assert forest.is_tapped is True\n        assert player.mana_pool.get(ManaType.GREEN) == 1\n\n    def test_land_tap_for_mana_stack_remains_empty(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        forest = Land(name=\"Forest\")\n\n        ability = ActivatedAbilityInstance(\n            source=forest,\n            controller=player,\n            cost=tap_cost,\n            effect=lambda g: player.mana_pool.add(ManaType.GREEN, 1),\n            is_mana_ability=True,\n        )\n        activate_ability(game, player, ability)\n        assert game.stack.is_empty()\n\n    def test_tapped_land_cannot_tap_for_mana(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        forest = Land(name=\"Forest\")\n        forest.is_tapped = True\n\n        ability = ActivatedAbilityInstance(\n            source=forest,\n            controller=player,\n            cost=tap_cost,\n            effect=lambda g: player.mana_pool.add(ManaType.GREEN, 1),\n            is_mana_ability=True,\n        )\n        with pytest.raises(AbilityError, match=\"cost could not be paid\"):\n            activate_ability(game, player, ability)\n        # Mana pool should be unchanged.\n        assert player.mana_pool.get(ManaType.GREEN) == 0\n\n    def test_land_tap_for_mana_at_instant_speed(self):\n        \"\"\"Mana abilities can be activated during combat, etc.\"\"\"\n        game = _instant_speed_game()\n        player = game.players[0]\n        island = Land(name=\"Island\")\n\n        ability = ActivatedAbilityInstance(\n            source=island,\n            controller=player,\n            cost=tap_cost,\n            effect=lambda g: player.mana_pool.add(ManaType.BLUE, 1),\n            is_mana_ability=True,\n        )\n        activate_ability(game, player, ability)\n        assert island.is_tapped is True\n        assert player.mana_pool.get(ManaType.BLUE) == 1\n\n\n# ---------------------------------------------------------------------------\n# Multiple abilities on the same source\n# ---------------------------------------------------------------------------\n\n\nclass TestMultipleAbilitiesSameSource:\n    \"\"\"Multiple abilities on a single permanent.\"\"\"\n\n    def test_activate_two_different_mana_abilities_on_same_source(self):\n        \"\"\"Example: a dual land with two mana abilities (but requires two taps\n        in real MTG — here we test that both abilities are independent).\"\"\"\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        dual_land = Land(name=\"DualLand\")\n\n        ability_green = ActivatedAbilityInstance(\n            source=dual_land,\n            controller=player,\n            cost=tap_cost,\n            effect=lambda g: player.mana_pool.add(ManaType.GREEN, 1),\n            is_mana_ability=True,\n        )\n        ability_white = ActivatedAbilityInstance(\n            source=dual_land,\n            controller=player,\n            cost=tap_cost,\n            effect=lambda g: player.mana_pool.add(ManaType.WHITE, 1),\n            is_mana_ability=True,\n        )\n        # First activation taps the land.\n        activate_ability(game, player, ability_green)\n        assert dual_land.is_tapped is True\n        assert player.mana_pool.get(ManaType.GREEN) == 1\n\n        # Second activation fails because the land is already tapped.\n        with pytest.raises(AbilityError, match=\"cost could not be paid\"):\n            activate_ability(game, player, ability_white)\n        # White mana should not have been added.\n        assert player.mana_pool.get(ManaType.WHITE) == 0\n\n\n# ---------------------------------------------------------------------------\n# Unknown ability type\n# ---------------------------------------------------------------------------\n\n\nclass TestUnknownAbilityType:\n    \"\"\"activate_ability rejects unknown ability types.\"\"\"\n\n    def test_unknown_type_raises(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        with pytest.raises(AbilityError, match=\"Unknown ability type\"):\n            activate_ability(game, player, \"not an ability\")  # type: ignore[arg-type]\n\n\n# ---------------------------------------------------------------------------\n# Loyalty stack object properties\n# ---------------------------------------------------------------------------\n\n\nclass TestLoyaltyStackObject:\n    \"\"\"Verify the StackObject pushed by loyalty ability has correct properties.\"\"\"\n\n    def test_stack_object_source_is_planeswalker(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=5)\n        ability = LoyaltyAbilityInstance(\n            source=pw,\n            controller=player,\n            loyalty_cost=1,\n            effect=lambda g: None,\n        )\n        activate_ability(game, player, ability)\n        top = game.stack.peek()\n        assert top.source is pw\n\n    def test_stack_object_controller_is_player(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=5)\n        ability = LoyaltyAbilityInstance(\n            source=pw,\n            controller=player,\n            loyalty_cost=1,\n            effect=lambda g: None,\n        )\n        activate_ability(game, player, ability)\n        top = game.stack.peek()\n        assert top.controller is player\n\n    def test_stack_object_on_resolve_invokes_effect(self):\n        game = _sorcery_speed_game()\n        player = game.players[0]\n        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=5)\n        resolved = []\n        ability = LoyaltyAbilityInstance(\n            source=pw,\n            controller=player,\n            loyalty_cost=1,\n            effect=lambda g: resolved.append(\"done\"),\n        )\n        activate_ability(game, player, ability)\n        top = game.stack.peek()\n        top.on_resolve(game)\n        assert resolved == [\"done\"]\n","numLines":977,"startLine":1,"totalLines":977}}}
