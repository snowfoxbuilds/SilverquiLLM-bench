{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011whYzg1RXBfEcKhuarVtHf","type":"tool_result","content":"396\t    # Fire the \"spell cast\" event (free casts are still casts).\n397\t    from engine.events import SpellCastTriggeredEvent\n398\t\n399\t    game.trigger_manager.fire_event(\n400\t        game,\n401\t        SpellCastTriggeredEvent(spell=stack_obj, player=player, card=card, controller=player),\n402\t    )\n403\t\n404\t\n405\t# ------------------------------------------------------------------\n406\t# Resolution (called when the stack pops)\n407\t# ------------------------------------------------------------------\n408\t\n409\tdef _resolve_spell(\n410\t    game: GameState,\n411\t    card: CardImpl,\n412\t    player: Player,\n413\t    stack_obj: StackObject,\n414\t) -> None:\n415\t    \"\"\"Resolve *card* cast by *player*.\n416\t\n417\t    1. Call ``card.on_resolve(game, targets=targets)``.\n418\t    2. Remove the card from the stack zone.\n419\t    3. If the card is a permanent type, move it to the battlefield via\n420\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n421\t       registration and the ETB event).\n422\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n423\t    \"\"\"\n424\t    from engine.zones import move_to_zone\n425\t\n426\t    # Read targets from the StackObject — the single source of truth.\n427\t    # Set chosen_targets on the card just before resolution so that\n428\t    # _get_chosen_target helpers (which read via getattr) work.\n429\t    targets = stack_obj.targets\n430\t    if targets is not None:\n431\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n432\t\n433\t    card.on_resolve(game)\n434\t\n435\t    if card.card_types & _PERMANENT_TYPES:\n436\t        # Move from stack to battlefield via move_to_zone, which handles\n437\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n438\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n439\t    else:\n440\t        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n441\t        # A card may request that this resolution-time graveyard move be\n442\t        # replaced by exile (e.g. \"if this spell would be put into your\n443\t        # graveyard, exile it instead\").\n444\t        dest = Zone.GRAVEYARD\n445\t        if getattr(card, \"replace_graveyard_with_exile\", False):\n446\t            dest = Zone.EXILE\n447\t        move_to_zone(game, card, Zone.STACK, dest)\n448\t\n449\t\n450\t# ------------------------------------------------------------------\n451\t# Play land (special action — does not use the stack)\n452\t# ------------------------------------------------------------------\n453\t\n454\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n455\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n456\t\n457\t    Requirements (all must hold):\n458\t\n459\t    * *land_card* has :attr:`CardType.LAND`.\n460\t    * *player* is the active player.\n461\t    * Current phase is a main phase.\n462\t    * The stack is empty.\n463\t    * ``player.land_plays_remaining > 0``.\n464\t    * The card is in the player's hand.\n465\t\n466\t    On success the card moves from hand to battlefield and\n467\t    ``land_plays_remaining`` is decremented.\n468\t\n469\t    Raises:\n470\t        CastingError: If any requirement is not met.\n471\t    \"\"\"\n472\t    # Must be a land\n473\t    if CardType.LAND not in land_card.card_types:\n474\t        raise CastingError(\n475\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n476\t        )\n477\t\n478\t    # Sorcery-speed timing (active player, main phase, stack empty)\n479\t    if not is_sorcery_speed(game, player):\n480\t        raise CastingError(\n481\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n482\t            \"during main phase with empty stack\"\n483\t        )\n484\t\n485\t    # Land plays remaining"}]},"parent_tool_use_id":null,"session_id":"1995741a-49a1-4a45-a041-801f56ba31a7","uuid":"9e34dbbb-0998-4a9f-9c38-fd0846f99cc0","timestamp":"2026-06-02T07:19:34.543Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"    # Fire the \"spell cast\" event (free casts are still casts).\n    from engine.events import SpellCastTriggeredEvent\n\n    game.trigger_manager.fire_event(\n        game,\n        SpellCastTriggeredEvent(spell=stack_obj, player=player, card=card, controller=player),\n    )\n\n\n# ------------------------------------------------------------------\n# Resolution (called when the stack pops)\n# ------------------------------------------------------------------\n\ndef _resolve_spell(\n    game: GameState,\n    card: CardImpl,\n    player: Player,\n    stack_obj: StackObject,\n) -> None:\n    \"\"\"Resolve *card* cast by *player*.\n\n    1. Call ``card.on_resolve(game, targets=targets)``.\n    2. Remove the card from the stack zone.\n    3. If the card is a permanent type, move it to the battlefield via\n       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n       registration and the ETB event).\n    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Read targets from the StackObject — the single source of truth.\n    # Set chosen_targets on the card just before resolution so that\n    # _get_chosen_target helpers (which read via getattr) work.\n    targets = stack_obj.targets\n    if targets is not None:\n        card.chosen_targets = targets  # type: ignore[attr-defined]\n\n    card.on_resolve(game)\n\n    if card.card_types & _PERMANENT_TYPES:\n        # Move from stack to battlefield via move_to_zone, which handles\n        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n    else:\n        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n        # A card may request that this resolution-time graveyard move be\n        # replaced by exile (e.g. \"if this spell would be put into your\n        # graveyard, exile it instead\").\n        dest = Zone.GRAVEYARD\n        if getattr(card, \"replace_graveyard_with_exile\", False):\n            dest = Zone.EXILE\n        move_to_zone(game, card, Zone.STACK, dest)\n\n\n# ------------------------------------------------------------------\n# Play land (special action — does not use the stack)\n# ------------------------------------------------------------------\n\ndef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n\n    Requirements (all must hold):\n\n    * *land_card* has :attr:`CardType.LAND`.\n    * *player* is the active player.\n    * Current phase is a main phase.\n    * The stack is empty.\n    * ``player.land_plays_remaining > 0``.\n    * The card is in the player's hand.\n\n    On success the card moves from hand to battlefield and\n    ``land_plays_remaining`` is decremented.\n\n    Raises:\n        CastingError: If any requirement is not met.\n    \"\"\"\n    # Must be a land\n    if CardType.LAND not in land_card.card_types:\n        raise CastingError(\n            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n        )\n\n    # Sorcery-speed timing (active player, main phase, stack empty)\n    if not is_sorcery_speed(game, player):\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — must be active player \"\n            \"during main phase with empty stack\"\n        )\n\n    # Land plays remaining","numLines":90,"startLine":396,"totalLines":525}}}
