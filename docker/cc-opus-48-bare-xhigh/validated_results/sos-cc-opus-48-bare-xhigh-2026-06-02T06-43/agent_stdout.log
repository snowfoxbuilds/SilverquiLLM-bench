{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EnM1HfhyWKzxnwJBMkaZKk","type":"tool_result","content":"120\t    generic = card.mana_cost.generic if card.mana_cost else 0\n121\t    return max(0, min(raw, generic))\n122\t\n123\t\n124\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n125\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n126\t    new_generic = max(0, cost.generic - reduction)\n127\t    return ManaCost(\n128\t        generic=new_generic,\n129\t        pips=dict(cost.pips),\n130\t        x_count=cost.x_count,\n131\t        hybrid=list(cost.hybrid),\n132\t    )\n133\t\n134\t\n135\t# ------------------------------------------------------------------\n136\t# Cast spell\n137\t# ------------------------------------------------------------------\n138\t\n139\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n140\t    \"\"\"Cast *card* from *player*'s hand.\n141\t\n142\t    Pipeline\n143\t    --------\n144\t    1. **Timing check** — instants (and cards with flash) can be cast\n145\t       whenever the player has priority; everything else requires\n146\t       sorcery-speed timing.\n147\t    2. **can_cast** — ask the card whether it can legally be cast.\n148\t    3. **Hand check** — the card must be in the player's hand.\n149\t    4. **Move hand → stack zone** — remove the card from the hand and\n150\t       place it into the player's stack zone.\n151\t    5. **Choose targets** — if the card specifies targets (via\n152\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n153\t    6. **Mana check / payment** — the player's mana pool must be able to\n154\t       pay the card's mana cost.  If payment fails, the card is rolled\n155\t       back from the stack zone to the hand.\n156\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n157\t    8. **Push StackObject** — push a :class:`StackObject` whose\n158\t       ``on_resolve`` callback handles resolution.\n159\t"}]},"parent_tool_use_id":null,"session_id":"1995741a-49a1-4a45-a041-801f56ba31a7","uuid":"e6f9d53c-8892-4c14-8db8-bd2d381d2cc9","timestamp":"2026-06-02T07:05:12.527Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"    generic = card.mana_cost.generic if card.mana_cost else 0\n    return max(0, min(raw, generic))\n\n\ndef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n    new_generic = max(0, cost.generic - reduction)\n    return ManaCost(\n        generic=new_generic,\n        pips=dict(cost.pips),\n        x_count=cost.x_count,\n        hybrid=list(cost.hybrid),\n    )\n\n\n# ------------------------------------------------------------------\n# Cast spell\n# ------------------------------------------------------------------\n\ndef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n    \"\"\"Cast *card* from *player*'s hand.\n\n    Pipeline\n    --------\n    1. **Timing check** — instants (and cards with flash) can be cast\n       whenever the player has priority; everything else requires\n       sorcery-speed timing.\n    2. **can_cast** — ask the card whether it can legally be cast.\n    3. **Hand check** — the card must be in the player's hand.\n    4. **Move hand → stack zone** — remove the card from the hand and\n       place it into the player's stack zone.\n    5. **Choose targets** — if the card specifies targets (via\n       :meth:`CardImpl.get_targets`), the player is asked to choose.\n    6. **Mana check / payment** — the player's mana pool must be able to\n       pay the card's mana cost.  If payment fails, the card is rolled\n       back from the stack zone to the hand.\n    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n    8. **Push StackObject** — push a :class:`StackObject` whose\n       ``on_resolve`` callback handles resolution.\n","numLines":40,"startLine":120,"totalLines":519}}}
