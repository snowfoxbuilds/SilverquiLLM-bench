{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FLwqdp3VzArV2FAuzK4MyJ","type":"tool_result","content":"429\t    targets = stack_obj.targets\n430\t    if targets is not None:\n431\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n432\t\n433\t    card.on_resolve(game)\n434\t\n435\t    if card.card_types & _PERMANENT_TYPES:\n436\t        # Move from stack to battlefield via move_to_zone, which handles\n437\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n438\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n439\t    else:\n440\t        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n441\t        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n442\t\n443\t\n444\t# ------------------------------------------------------------------\n445\t# Play land (special action — does not use the stack)\n446\t# ------------------------------------------------------------------\n447\t\n448\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n449\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n450\t\n451\t    Requirements (all must hold):\n452\t\n453\t    * *land_card* has :attr:`CardType.LAND`.\n454\t    * *player* is the active player.\n455\t    * Current phase is a main phase.\n456\t    * The stack is empty.\n457\t    * ``player.land_plays_remaining > 0``.\n458\t    * The card is in the player's hand.\n459\t\n460\t    On success the card moves from hand to battlefield and\n461\t    ``land_plays_remaining`` is decremented.\n462\t\n463\t    Raises:\n464\t        CastingError: If any requirement is not met.\n465\t    \"\"\"\n466\t    # Must be a land\n467\t    if CardType.LAND not in land_card.card_types:\n468\t        raise CastingError(\n469\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n470\t        )\n471\t\n472\t    # Sorcery-speed timing (active player, main phase, stack empty)\n473\t    if not is_sorcery_speed(game, player):\n474\t        raise CastingError(\n475\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n476\t            \"during main phase with empty stack\"\n477\t        )\n478\t\n479\t    # Land plays remaining\n480\t    if player.land_plays_remaining <= 0:\n481\t        raise CastingError(\n482\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n483\t        )\n484\t\n485\t    # Card must be in hand\n486\t    hand = game.get_hand(player)\n487\t    if not hand.contains(land_card):\n488\t        raise CastingError(\n489\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n490\t        )\n491\t\n492\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n493\t    if land_card.owner is None:\n494\t        land_card.owner = player\n495\t    land_card.controller = player\n496\t\n497\t    # Move from hand to battlefield via move_to_zone, which fires\n498\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n499\t    from engine.zones import move_to_zone\n500\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n501\t\n502\t    # Decrement land plays\n503\t    player.land_plays_remaining -= 1\n504\t\n505\t\n506\tdef resolve_top(game: GameState) -> None:\n507\t    \"\"\"Resolve the top spell/ability on the stack.\n508\t"}]},"parent_tool_use_id":null,"session_id":"1995741a-49a1-4a45-a041-801f56ba31a7","uuid":"92c2af93-caea-42c9-abac-5575e6f2aafc","timestamp":"2026-06-02T07:06:18.772Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"    targets = stack_obj.targets\n    if targets is not None:\n        card.chosen_targets = targets  # type: ignore[attr-defined]\n\n    card.on_resolve(game)\n\n    if card.card_types & _PERMANENT_TYPES:\n        # Move from stack to battlefield via move_to_zone, which handles\n        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n    else:\n        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n\n\n# ------------------------------------------------------------------\n# Play land (special action — does not use the stack)\n# ------------------------------------------------------------------\n\ndef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n\n    Requirements (all must hold):\n\n    * *land_card* has :attr:`CardType.LAND`.\n    * *player* is the active player.\n    * Current phase is a main phase.\n    * The stack is empty.\n    * ``player.land_plays_remaining > 0``.\n    * The card is in the player's hand.\n\n    On success the card moves from hand to battlefield and\n    ``land_plays_remaining`` is decremented.\n\n    Raises:\n        CastingError: If any requirement is not met.\n    \"\"\"\n    # Must be a land\n    if CardType.LAND not in land_card.card_types:\n        raise CastingError(\n            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n        )\n\n    # Sorcery-speed timing (active player, main phase, stack empty)\n    if not is_sorcery_speed(game, player):\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — must be active player \"\n            \"during main phase with empty stack\"\n        )\n\n    # Land plays remaining\n    if player.land_plays_remaining <= 0:\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n        )\n\n    # Card must be in hand\n    hand = game.get_hand(player)\n    if not hand.contains(land_card):\n        raise CastingError(\n            f\"Cannot play land {land_card.name!r} — card not in hand\"\n        )\n\n    # Ensure owner/controller are set so move_to_zone routes correctly.\n    if land_card.owner is None:\n        land_card.owner = player\n    land_card.controller = player\n\n    # Move from hand to battlefield via move_to_zone, which fires\n    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n    from engine.zones import move_to_zone\n    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n\n    # Decrement land plays\n    player.land_plays_remaining -= 1\n\n\ndef resolve_top(game: GameState) -> None:\n    \"\"\"Resolve the top spell/ability on the stack.\n","numLines":80,"startLine":429,"totalLines":519}}}
