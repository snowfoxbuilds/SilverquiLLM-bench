{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015UEJuZWFUz4221oRE9N1aE","type":"tool_result","content":"277\tdef cast_spell_free(\n278\t    game: GameState,\n279\t    player: Player,\n280\t    card: CardImpl,\n281\t    from_zone: Zone,\n282\t) -> None:\n283\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n284\t\n285\t    This is used by effects that allow casting from zones other than hand\n286\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n287\t    or cascade.\n288\t\n289\t    Pipeline\n290\t    --------\n291\t    1. **can_cast** — ask the card whether it can legally be cast (same\n292\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n293\t    2. Move *card* from *from_zone* to the stack zone.\n294\t    3. Choose targets (if applicable) with validation and protection check.\n295\t    4. Call ``on_cast`` hook.\n296\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n297\t       resolution normally (permanents → battlefield, non-permanents →\n298\t       graveyard).\n299\t\n300\t    No timing check or mana payment is performed.  The spell goes on the\n301\t    stack and can be responded to normally (e.g. countered).\n302\t\n303\t    If targeting or other post-move checks fail, the card is rolled back\n304\t    to its source zone.\n305\t\n306\t    Parameters:\n307\t        game: The current game state.\n308\t        player: The player casting the spell.\n309\t        card: The card to cast.\n310\t        from_zone: The zone the card is currently in.\n311\t\n312\t    Raises:\n313\t        CastingError: If the card cannot be found in *from_zone* or\n314\t            legality checks fail.\n315\t    \"\"\"\n316\t    from engine.zones import move_to_zone\n317\t\n318\t    # Ensure controller is set\n319\t    card.controller = player\n320\t    if card.owner is None:\n321\t        card.owner = player\n322\t\n323\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n324\t    if not card.can_cast(game):\n325\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n326\t\n327\t    # 2. Locate card in source zone\n328\t    source_zone_container = player.zones[from_zone]\n329\t    if not source_zone_container.contains(card):\n330\t        # Try to find the card in any player's zone\n331\t        source_zone_container = None\n332\t        for p in game.players:\n333\t            z = p.zones[from_zone]\n334\t            if z.contains(card):\n335\t                source_zone_container = z\n336\t                break\n337\t\n338\t    if source_zone_container is None or not source_zone_container.contains(card):\n339\t        raise CastingError(\n340\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n341\t        )\n342\t\n343\t    # Move card from source zone to stack zone\n344\t    stack_zone = player.zones[Zone.STACK]\n345\t    source_zone_container.remove(card)\n346\t    stack_zone.add(card)\n347\t\n348\t    # 3. Choose targets (with rollback on failure)\n349\t    try:\n350\t        target_specs = card.get_targets(game)\n351\t        chosen_targets: list[Any] = []\n352\t        if target_specs:\n353\t            for spec in target_specs:\n354\t                target = player.choose_target(target_specs, spec)\n355\t                # Validate against filter_fn if the spec provides one\n356\t                filter_fn = getattr(spec, \"filter_fn\", None)\n357\t                if filter_fn is not None and target is not None:\n358\t                    if not filter_fn(target):\n359\t                        raise CastingError(\n360\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n361\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n362\t                        )\n363\t                chosen_targets.append(target)\n364\t\n365\t        # Protection check — reject targets that have protection from this spell\n366\t        from engine.protection import has_protection_from\n367\t\n368\t        for target in chosen_targets:\n369\t            if has_protection_from(target, card):\n370\t                raise CastingError(\n371\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n372\t                )\n373\t    except Exception as exc:\n374\t        # Rollback: move card from stack zone back to source zone\n375\t        stack_zone.remove(card)\n376\t        source_zone_container.add(card)\n377\t        raise CastingError(str(exc)) from exc\n378\t\n379\t    # 4. Call on_cast hook\n380\t    card.on_cast(game)\n381\t\n382\t    # 5. Build on_resolve callback and push StackObject\n383\t    stack_obj = StackObject(\n384\t        source=card,\n385\t        controller=player,\n386\t        targets=chosen_targets,\n387\t        on_resolve=lambda g: None,  # replaced below\n388\t    )\n389\t\n390\t    def _on_resolve(g: GameState) -> None:\n391\t        _resolve_spell(g, card, player, stack_obj)\n392\t\n393\t    stack_obj.on_resolve = _on_resolve\n394\t    game.stack.push(stack_obj)\n395\t\n396\t    # Fire the \"spell cast\" event (free casts are still casts)."}]},"parent_tool_use_id":null,"session_id":"1995741a-49a1-4a45-a041-801f56ba31a7","uuid":"d54a1153-067a-4c48-b0f7-262b8bcfdce3","timestamp":"2026-06-02T07:19:26.191Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"def cast_spell_free(\n    game: GameState,\n    player: Player,\n    card: CardImpl,\n    from_zone: Zone,\n) -> None:\n    \"\"\"Cast *card* without paying its mana cost, using the stack.\n\n    This is used by effects that allow casting from zones other than hand\n    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n    or cascade.\n\n    Pipeline\n    --------\n    1. **can_cast** — ask the card whether it can legally be cast (same\n       legality as :func:`cast_spell`, minus mana/timing constraints).\n    2. Move *card* from *from_zone* to the stack zone.\n    3. Choose targets (if applicable) with validation and protection check.\n    4. Call ``on_cast`` hook.\n    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n       resolution normally (permanents → battlefield, non-permanents →\n       graveyard).\n\n    No timing check or mana payment is performed.  The spell goes on the\n    stack and can be responded to normally (e.g. countered).\n\n    If targeting or other post-move checks fail, the card is rolled back\n    to its source zone.\n\n    Parameters:\n        game: The current game state.\n        player: The player casting the spell.\n        card: The card to cast.\n        from_zone: The zone the card is currently in.\n\n    Raises:\n        CastingError: If the card cannot be found in *from_zone* or\n            legality checks fail.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Ensure controller is set\n    card.controller = player\n    if card.owner is None:\n        card.owner = player\n\n    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 2. Locate card in source zone\n    source_zone_container = player.zones[from_zone]\n    if not source_zone_container.contains(card):\n        # Try to find the card in any player's zone\n        source_zone_container = None\n        for p in game.players:\n            z = p.zones[from_zone]\n            if z.contains(card):\n                source_zone_container = z\n                break\n\n    if source_zone_container is None or not source_zone_container.contains(card):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n        )\n\n    # Move card from source zone to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    source_zone_container.remove(card)\n    stack_zone.add(card)\n\n    # 3. Choose targets (with rollback on failure)\n    try:\n        target_specs = card.get_targets(game)\n        chosen_targets: list[Any] = []\n        if target_specs:\n            for spec in target_specs:\n                target = player.choose_target(target_specs, spec)\n                # Validate against filter_fn if the spec provides one\n                filter_fn = getattr(spec, \"filter_fn\", None)\n                if filter_fn is not None and target is not None:\n                    if not filter_fn(target):\n                        raise CastingError(\n                            f\"Cannot cast {card.name!r} — chosen target does not \"\n                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                        )\n                chosen_targets.append(target)\n\n        # Protection check — reject targets that have protection from this spell\n        from engine.protection import has_protection_from\n\n        for target in chosen_targets:\n            if has_protection_from(target, card):\n                raise CastingError(\n                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n                )\n    except Exception as exc:\n        # Rollback: move card from stack zone back to source zone\n        stack_zone.remove(card)\n        source_zone_container.add(card)\n        raise CastingError(str(exc)) from exc\n\n    # 4. Call on_cast hook\n    card.on_cast(game)\n\n    # 5. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n    # Fire the \"spell cast\" event (free casts are still casts).","numLines":120,"startLine":277,"totalLines":525}}}
