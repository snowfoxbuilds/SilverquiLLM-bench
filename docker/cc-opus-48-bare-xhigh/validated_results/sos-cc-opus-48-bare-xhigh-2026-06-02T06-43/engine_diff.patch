+def flip_coin(game: GameState, player: Player | None = None) -> bool:
+    """Flip a single coin, returning ``True`` for heads.
+
+    Provides a deterministic seam for testing: if ``game._scripted_coin_flips``
+    is a non-empty list, the next predetermined result is popped (FIFO) and
+    coerced to ``bool``.  Otherwise a real random flip is used.
+
+    Parameters:
+        game: The current game state.
+        player: The player flipping the coin (unused by the default
+            implementation; accepted for a consistent signature).
+
+    Returns:
+        ``True`` for heads, ``False`` for tails.
+    """
+    scripted = getattr(game, "_scripted_coin_flips", None)
+    if scripted:
+        return bool(scripted.pop(0))
+    import random
+
+    return random.choice([True, False])
+
