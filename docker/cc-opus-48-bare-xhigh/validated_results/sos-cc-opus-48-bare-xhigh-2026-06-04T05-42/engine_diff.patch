+    Trigger effects are historically ``(game) -> None`` callables.  Some
+    newer effects also want the firing event (e.g. casualty needs the cast
+    spell; miracle needs the drawn card).  This inspects the signature so
+    both forms are supported without breaking existing one-argument effects.
+    """
+    try:
+        sig = inspect.signature(effect)
+    except (ValueError, TypeError):
+        return False
+    positional = [
+        p
+        for p in sig.parameters.values()
+        if p.kind
+        in (
+            inspect.Parameter.POSITIONAL_ONLY,
+            inspect.Parameter.POSITIONAL_OR_KEYWORD,
+            inspect.Parameter.VAR_POSITIONAL,
+        )
+    ]
+    if any(p.kind == inspect.Parameter.VAR_POSITIONAL for p in positional):
+        return True
+    return len(positional) >= 2
