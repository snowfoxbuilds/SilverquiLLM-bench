se_power\", 5)\n        kwargs.setdefault(\"base_toughness\", 5)\n        kwargs.setdefault(\"keywords\", Keyword.FLYING | Keyword.DEATHTOUCH)\n        kwargs.setdefault(\n            \"rules_text\",\n            \"Affinity for creatures\\n\"\n            \"Flying, deathtouch.\\n\"\n            \"Instant and sorcery spells you cast have affinity for creatures.\",\n        )\n        super().__init__(**kwargs)\n        self.colors = [\"B\", \"G\"]\n\n    def cost_reduction(self, game: \"GameState\") -> int:\n        \"\"\"Affinity for creatures: {1} less per creature you control.\"\"\"\n        return _creature_count(game, self.controller)\n\n    def static_cost_reduction(\n        self, game: \"GameState\", spell: Any, controller: \"Player\"\n    ) -> int:\n        \"\"\"Grant affinity for creatures to instants/sorceries you cast.\"\"\"\n        if self.controller is not controller:\n            return 0\n        types = getattr(spell, \"card_types\", set())\n        if CardType.INSTANT in types or CardType.SORCERY in types:\n            return _creature_count(game, controller)\n        return 0\n","structuredPatch":[{"oldStart":2,"oldLines":15,"newStart":2,"newLines":66,"lines":[" "," from __future__ import annotations"," ","-from engine.card import CardImpl","+from typing import TYPE_CHECKING, Any"," ","-from typing import TYPE_CHECKING","+from engine.card import Creature","+from engine.types import CardType, Keyword, ManaCost, Supertype"," "," if TYPE_CHECKING:","     from engine.game_state import GameState","+    from engine.player import Player"," "," ","-class WitherbloomTheBalancer(CardImpl):","-    \"\"\"TODO: Implement Witherbloom, the Balancer.\"\"\"","+def _creature_count(game: \"GameState\", controller: \"Player\") -> int:","+    \"\"\"Count creatures *controller* controls on the battlefield.\"\"\"","+    if controller is None:","+        return 0","+    count = 0","+    for obj in game.get_battlefield(controller).get_all():","+        if CardType.CREATU