{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011LE3HsA15k7ZxxFWQSvAf1","type":"tool_result","content":"1\t\"\"\"Triggered abilities system — event-driven trigger registration and firing.\n2\t\n3\tProvides the core mechanism for registering triggered abilities and firing\n4\tevents that push matching triggers onto the stack:\n5\t\n6\t- :class:`TriggerRegistration` — dataclass describing a single trigger.\n7\t- :class:`TriggerManager` — central registry for triggers with APNAP-ordered\n8\t  event firing.\n9\t\n10\tEvent types live in :mod:`engine.events` as typed dataclasses.\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\timport inspect\n16\tfrom dataclasses import dataclass, field\n17\tfrom typing import TYPE_CHECKING, Any, Callable\n18\t\n19\tfrom engine.events import TriggeredEvent\n20\tfrom engine.stack import StackObject\n21\t\n22\t\n23\tdef _effect_accepts_event(effect: Callable[..., None]) -> bool:\n24\t    \"\"\"Return ``True`` if *effect* can be called as ``effect(game, event)``.\n25\t\n26\t    Trigger effects are historically ``(game) -> None`` callables.  Some\n27\t    newer effects also want the firing event (e.g. casualty needs the cast\n28\t    spell; miracle needs the drawn card).  This inspects the signature so\n29\t    both forms are supported without breaking existing one-argument effects.\n30\t    \"\"\"\n31\t    try:\n32\t        sig = inspect.signature(effect)\n33\t    except (ValueError, TypeError):\n34\t        return False\n35\t    positional = [\n36\t        p\n37\t        for p in sig.parameters.values()\n38\t        if p.kind\n39\t        in (\n40\t            inspect.Parameter.POSITIONAL_ONLY,\n41\t            inspect.Parameter.POSITIONAL_OR_KEYWORD,\n42\t            inspect.Parameter.VAR_POSITIONAL,\n43\t        )\n44\t    ]\n45\t    if any(p.kind == inspect.Parameter.VAR_POSITIONAL for p in positional):\n46\t        return True\n47\t    return len(positional) >= 2\n48\t\n49\tif TYPE_CHECKING:\n50\t    from engine.game_state import GameState\n51\t    from engine.player import Player\n52\t\n53\t\n54\t@dataclass\n55\tclass TriggerRegistration:\n56\t    \"\"\"Describes a single triggered ability.\n57\t\n58\t    Attributes:\n59\t        event_type: The event class (or a base class) this trigger watches.\n60\t            The trigger fires for any fired event that is an instance of\n61\t            this class, including instances of subclasses.\n62\t        condition: Optional callable ``(game, event) -> bool`` that must\n63\t            return ``True`` for the trigger to fire.  ``None`` means the\n64\t            trigger always fires for its event type.\n65\t        effect: Callable ``(game) -> None`` executed when the trigger\n66\t            resolves (becomes the :attr:`StackObject.on_resolve` callback).\n67\t        source: The game object (card / permanent) that owns this trigger.\n68\t        controller: The player who controls the source at the time of\n69\t            registration.\n70\t    \"\"\"\n71\t\n72\t    event_type: type[TriggeredEvent]\n73\t    condition: Callable[..., bool] | None\n74\t    effect: Callable[..., None]\n75\t    source: Any\n76\t    controller: Player\n77\t\n78\t\n79\tclass TriggerManager:\n80\t    \"\"\"Central registry for triggered abilities.\n81\t\n82\t    Triggers are registered when a permanent enters the battlefield (or\n83\t    via other game actions) and unregistered when the source leaves.\n84\t\n85\t    :meth:`fire_event` checks all registered triggers of a matching\n86\t    event type, evaluates their conditions, and pushes matching triggers\n87\t    onto the game stack as :class:`StackObject` instances.  Triggers are\n88\t    ordered according to APNAP (Active Player, Non-Active Player):\n89\t\n90\t    * Active player's triggers are pushed first (end up on the bottom\n91\t      of the batch).\n92\t    * Non-active player's triggers are pushed second (end up on top).\n93\t    * Within the same player, triggers are pushed in registration order\n94\t      (controller would normally choose; for now we use registration\n95\t      order as a deterministic default).\n96\t    \"\"\"\n97\t\n98\t    def __init__(self) -> None:\n99\t        self._triggers: list[TriggerRegistration] = []\n100\t\n101\t    def register(self, trigger: TriggerRegistration) -> None:\n102\t        \"\"\"Register a triggered ability.\"\"\"\n103\t        self._triggers.append(trigger)\n104\t\n105\t    def unregister(self, source: Any) -> None:\n106\t        \"\"\"Remove all triggers registered by *source* (identity-based).\"\"\"\n107\t        self._triggers = [t for t in self._triggers if t.source is not source]\n108\t\n109\t    def fire_event(self, game: GameState, event: TriggeredEvent) -> None:\n110\t        \"\"\"Fire an event and push all matching triggers onto the stack.\n111\t\n112\t        Parameters:\n113\t            game: The current game state.\n114\t            event: The typed event object.  Triggers registered for the\n115\t                event's class or any of its parent classes will fire.\n116\t\n117\t        Matching triggers are pushed in APNAP order:\n118\t\n119\t        1. Active player's matching triggers (in registration order).\n120\t        2. Non-active player's matching triggers (in registration order).\n121\t        \"\"\"\n122\t        matching: list[TriggerRegistration] = []\n123\t        for trigger in self._triggers:\n124\t            if not isinstance(event, trigger.event_type):\n125\t                continue\n126\t            if trigger.condition is not None:\n127\t                if not trigger.condition(game, event):\n128\t                    continue\n129\t            matching.append(trigger)\n130\t\n131\t        if not matching:\n132\t            return\n133\t\n134\t        active_player = game.active_player\n135\t        active_triggers: list[TriggerRegistration] = []\n136\t        non_active_triggers: list[TriggerRegistration] = []\n137\t\n138\t        for trigger in matching:\n139\t            if trigger.controller is active_player:\n140\t                active_triggers.append(trigger)\n141\t            else:\n142\t                non_active_triggers.append(trigger)\n143\t\n144\t        ordered = active_triggers + non_active_triggers\n145\t\n146\t        for trigger in ordered:\n147\t            effect = trigger.effect\n148\t            if _effect_accepts_event(effect):\n149\t                # Bind the firing event so the effect can read it at resolve.\n150\t                def _on_resolve(g: GameState, _effect=effect, _event=event) -> None:\n151\t                    _effect(g, _event)\n152\t\n153\t                resolve_cb: Callable[..., None] = _on_resolve\n154\t            else:\n155\t                resolve_cb = effect\n156\t            stack_obj = StackObject(\n157\t                source=trigger.source,\n158\t                controller=trigger.controller,\n159\t                on_resolve=resolve_cb,\n160\t            )\n161\t            game.stack.push(stack_obj)\n162\t\n163\t    def get_triggers(self) -> list[TriggerRegistration]:\n164\t        \"\"\"Return a shallow copy of all registered triggers.\"\"\"\n165\t        return list(self._triggers)\n166\t\n167\t    def get_triggers_for_source(self, source: Any) -> list[TriggerRegistration]:\n168\t        \"\"\"Return all triggers registered by *source* (identity-based).\"\"\"\n169\t        return [t for t in self._triggers if t.source is source]\n170\t\n171\t    def clear(self) -> None:\n172\t        \"\"\"Remove all registered triggers.\"\"\"\n173\t        self._triggers.clear()\n174\t"}]},"parent_tool_use_id":null,"session_id":"f8a3aed6-12f8-4341-9631-2336f98abe5d","uuid":"d95c7f4c-42bb-4c54-814c-1005d9d054e6","timestamp":"2026-06-04T06:57:52.024Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/triggers.py","content":"\"\"\"Triggered abilities system — event-driven trigger registration and firing.\n\nProvides the core mechanism for registering triggered abilities and firing\nevents that push matching triggers onto the stack:\n\n- :class:`TriggerRegistration` — dataclass describing a single trigger.\n- :class:`TriggerManager` — central registry for triggers with APNAP-ordered\n  event firing.\n\nEvent types live in :mod:`engine.events` as typed dataclasses.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport inspect\nfrom dataclasses import dataclass, field\nfrom typing import TYPE_CHECKING, Any, Callable\n\nfrom engine.events import TriggeredEvent\nfrom engine.stack import StackObject\n\n\ndef _effect_accepts_event(effect: Callable[..., None]) -> bool:\n    \"\"\"Return ``True`` if *effect* can be called as ``effect(game, event)``.\n\n    Trigger effects are historically ``(game) -> None`` callables.  Some\n    newer effects also want the firing event (e.g. casualty needs the cast\n    spell; miracle needs the drawn card).  This inspects the signature so\n    both forms are supported without breaking existing one-argument effects.\n    \"\"\"\n    try:\n        sig = inspect.signature(effect)\n    except (ValueError, TypeError):\n        return False\n    positional = [\n        p\n        for p in sig.parameters.values()\n        if p.kind\n        in (\n            inspect.Parameter.POSITIONAL_ONLY,\n            inspect.Parameter.POSITIONAL_OR_KEYWORD,\n            inspect.Parameter.VAR_POSITIONAL,\n        )\n    ]\n    if any(p.kind == inspect.Parameter.VAR_POSITIONAL for p in positional):\n        return True\n    return len(positional) >= 2\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n@dataclass\nclass TriggerRegistration:\n    \"\"\"Describes a single triggered ability.\n\n    Attributes:\n        event_type: The event class (or a base class) this trigger watches.\n            The trigger fires for any fired event that is an instance of\n            this class, including instances of subclasses.\n        condition: Optional callable ``(game, event) -> bool`` that must\n            return ``True`` for the trigger to fire.  ``None`` means the\n            trigger always fires for its event type.\n        effect: Callable ``(game) -> None`` executed when the trigger\n            resolves (becomes the :attr:`StackObject.on_resolve` callback).\n        source: The game object (card / permanent) that owns this trigger.\n        controller: The player who controls the source at the time of\n            registration.\n    \"\"\"\n\n    event_type: type[TriggeredEvent]\n    condition: Callable[..., bool] | None\n    effect: Callable[..., None]\n    source: Any\n    controller: Player\n\n\nclass TriggerManager:\n    \"\"\"Central registry for triggered abilities.\n\n    Triggers are registered when a permanent enters the battlefield (or\n    via other game actions) and unregistered when the source leaves.\n\n    :meth:`fire_event` checks all registered triggers of a matching\n    event type, evaluates their conditions, and pushes matching triggers\n    onto the game stack as :class:`StackObject` instances.  Triggers are\n    ordered according to APNAP (Active Player, Non-Active Player):\n\n    * Active player's triggers are pushed first (end up on the bottom\n      of the batch).\n    * Non-active player's triggers are pushed second (end up on top).\n    * Within the same player, triggers are pushed in registration order\n      (controller would normally choose; for now we use registration\n      order as a deterministic default).\n    \"\"\"\n\n    def __init__(self) -> None:\n        self._triggers: list[TriggerRegistration] = []\n\n    def register(self, trigger: TriggerRegistration) -> None:\n        \"\"\"Register a triggered ability.\"\"\"\n        self._triggers.append(trigger)\n\n    def unregister(self, source: Any) -> None:\n        \"\"\"Remove all triggers registered by *source* (identity-based).\"\"\"\n        self._triggers = [t for t in self._triggers if t.source is not source]\n\n    def fire_event(self, game: GameState, event: TriggeredEvent) -> None:\n        \"\"\"Fire an event and push all matching triggers onto the stack.\n\n        Parameters:\n            game: The current game state.\n            event: The typed event object.  Triggers registered for the\n                event's class or any of its parent classes will fire.\n\n        Matching triggers are pushed in APNAP order:\n\n        1. Active player's matching triggers (in registration order).\n        2. Non-active player's matching triggers (in registration order).\n        \"\"\"\n        matching: list[TriggerRegistration] = []\n        for trigger in self._triggers:\n            if not isinstance(event, trigger.event_type):\n                continue\n            if trigger.condition is not None:\n                if not trigger.condition(game, event):\n                    continue\n            matching.append(trigger)\n\n        if not matching:\n            return\n\n        active_player = game.active_player\n        active_triggers: list[TriggerRegistration] = []\n        non_active_triggers: list[TriggerRegistration] = []\n\n        for trigger in matching:\n            if trigger.controller is active_player:\n                active_triggers.append(trigger)\n            else:\n                non_active_triggers.append(trigger)\n\n        ordered = active_triggers + non_active_triggers\n\n        for trigger in ordered:\n            effect = trigger.effect\n            if _effect_accepts_event(effect):\n                # Bind the firing event so the effect can read it at resolve.\n                def _on_resolve(g: GameState, _effect=effect, _event=event) -> None:\n                    _effect(g, _event)\n\n                resolve_cb: Callable[..., None] = _on_resolve\n            else:\n                resolve_cb = effect\n            stack_obj = StackObject(\n                source=trigger.source,\n                controller=trigger.controller,\n                on_resolve=resolve_cb,\n            )\n            game.stack.push(stack_obj)\n\n    def get_triggers(self) -> list[TriggerRegistration]:\n        \"\"\"Return a shallow copy of all registered triggers.\"\"\"\n        return list(self._triggers)\n\n    def get_triggers_for_source(self, source: Any) -> list[TriggerRegistration]:\n        \"\"\"Return all triggers registered by *source* (identity-based).\"\"\"\n        return [t for t in self._triggers if t.source is source]\n\n    def clear(self) -> None:\n        \"\"\"Remove all registered triggers.\"\"\"\n        self._triggers.clear()\n","numLines":174,"startLine":1,"totalLines":174}}}
