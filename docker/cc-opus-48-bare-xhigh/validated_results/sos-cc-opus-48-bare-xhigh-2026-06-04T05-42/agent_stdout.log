       if event.player is not ctrl:\n42\t                return False\n43\t            current_turn = getattr(game, 'turn_number', 0)\n44\t            if getattr(source, '_vanguard_surveil_on_turn', -1) == current_turn:\n45\t                return False\n46\t            return True\n47\t\n48\t        def _gain_life_effect(game: 'GameState') -> None:\n49\t            source._vanguard_surveil_on_turn = getattr(game, 'turn_number', 0)\n50\t            ctrl = getattr(source, 'controller', None)\n51\t            if ctrl is None:\n52\t                return\n53\t            from engine.types import Zone\n54\t            library = ctrl.zones[Zone.LIBRARY]\n55\t            cards = list(library.get_all())\n56\t            if not cards:\n57\t                return\n58\t            top_card = cards[-1]\n59\t            put_in_gy = ctrl.choose_yes_no(f\"Surveil 1: Put {getattr(top_card, 'name', 'card')} into your graveyard?\")\n60\t            if put_in_gy:\n61\t                library.remove(top_card)\n62\t                ctrl.zones[Zone.GRAVEYARD].add(top_card)\n63\t        game.trigger_manager.register(TriggerRegistration(event_type=GainsLifeTriggeredEvent, condition=_gain_life_condition, effect=_gain_life_effect, source=self, controller=controller))\n64\t"}]},"parent_tool_use_id":null,"session_id":"f8a3aed6-12f8-4341-9631-2336f98abe5d","uuid":"c595bb82-34d1-427d-b03b-69e6ffaf75d4","timestamp":"2026-06-04T06:24:37.139Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_28/card_impl.py","content":"\"\"\"Card implementation for Vanguard Seraph.\"\"\"\nfrom __future__ import annotations\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import Creature\nfrom engine.types import CardType, Keyword, ManaCost\nfrom engine.events import GainsLifeTriggeredEvent\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\nclass VanguardSeraph(Creature):\n    \"\"\"Vanguard Seraph — {3}{W} — 3/3 — Angel Warrior — Flying.\n\n    Whenever you gain 