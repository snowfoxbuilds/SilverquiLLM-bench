{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VKpiSrfdxSB2R5oo1EYSCL","type":"tool_result","content":"1\t\"\"\"Card implementation for Great Hall of the Biblioplex.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import ActivatedAbility, Land, ManaAbility\n8\tfrom engine.types import CardType, ManaCost, ManaType\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t\n13\t\n14\tclass GreatHallOfTheBiblioplex(Land):\n15\t    \"\"\"Great Hall of the Biblioplex — Land.\n16\t\n17\t    {T}: Add {C}.\n18\t    {T}, Pay 1 life: Add one mana of any color. Spend this mana only to\n19\t    cast an instant or sorcery spell.\n20\t    {5}: If this land isn't a creature, it becomes a 2/4 Wizard creature\n21\t    with \"Whenever you cast an instant or sorcery spell, this creature gets\n22\t    +1/+0 until end of turn.\" It's still a land.\n23\t\n24\t    SOS collector number 257.\n25\t    \"\"\"\n26\t\n27\t    def __init__(self, **kwargs: Any) -> None:\n28\t        kwargs.setdefault(\"name\", \"Great Hall of the Biblioplex\")\n29\t        kwargs.setdefault(\n30\t            \"rules_text\",\n31\t            \"{T}: Add {C}.\\n\"\n32\t            \"{T}, Pay 1 life: Add one mana of any color. Spend this mana \"\n33\t            \"only to cast an instant or sorcery spell.\\n\"\n34\t            \"{5}: If this land isn't a creature, it becomes a 2/4 Wizard \"\n35\t            'creature with \"Whenever you cast an instant or sorcery spell, '\n36\t            'this creature gets +1/+0 until end of turn.\" It\\'s still a land.',\n37\t        )\n38\t        super().__init__(**kwargs)\n39\t        self._is_animated: bool = False\n40\t\n41\t    # ------------------------------------------------------------------\n42\t    # Power / toughness — only meaningful once animated.  Defined as\n43\t    # properties so combat can read them, but ``base_power`` is left unset\n44\t    # until animation so the land is not a legal attacker beforehand.\n45\t    # ------------------------------------------------------------------\n46\t    @property\n47\t    def power(self) -> int:\n48\t        return (\n49\t            getattr(self, \"modified_power\", 0)\n50\t            + getattr(self, \"plus_one_counters\", 0)\n51\t            - getattr(self, \"minus_one_counters\", 0)\n52\t        )\n53\t\n54\t    @property\n55\t    def toughness(self) -> int:\n56\t        return (\n57\t            getattr(self, \"modified_toughness\", 0)\n58\t            + getattr(self, \"plus_one_counters\", 0)\n59\t            - getattr(self, \"minus_one_counters\", 0)\n60\t        )\n61\t\n62\t    def _reset_characteristics(self) -> None:\n63\t        super()._reset_characteristics()\n64\t        if getattr(self, \"_is_animated\", False):\n65\t            self.modified_power = self.base_power\n66\t            self.modified_toughness = self.base_toughness\n67\t            self.plus_one_counters = getattr(self, \"_base_plus_one_counters\", 0)\n68\t            self.minus_one_counters = getattr(self, \"_base_minus_one_counters\", 0)\n69\t\n70\t    # ------------------------------------------------------------------\n71\t    # Mana abilities\n72\t    # ------------------------------------------------------------------\n73\t    def get_mana_abilities(self) -> list[ManaAbility]:\n74\t        source = self\n75\t\n76\t        def _tap_cost(game: Any, src: Any) -> bool:\n77\t            if getattr(src, \"is_tapped\", False):\n78\t                return False\n79\t            src.is_tapped = True\n80\t            return True\n81\t\n82\t        def _tap_pay_life_cost(game: Any, src: Any) -> bool:\n83\t            controller = src.controller\n84\t            if controller is None or getattr(src, \"is_tapped\", False):\n85\t                return False\n86\t            if getattr(controller, \"life\", 0) < 1:\n87\t                return False\n88\t            src.is_tapped = True\n89\t            controller.life -= 1\n90\t            return True\n91\t\n92\t        def _colorless_effect(game: Any) -> None:\n93\t            controller = source.controller\n94\t            if controller is not None:\n95\t                controller.mana_pool.add(ManaType.COLORLESS, 1)\n96\t\n97\t        def _any_color_effect(game: Any) -> None:\n98\t            # ENGINE LIMITATION: the engine has no concept of \"spend this mana\n99\t            # only to cast an instant or sorcery spell\", so the restriction is\n100\t            # not enforced — the mana is produced as ordinary mana.\n101\t            from engine.player import ScriptExhaustedError\n102\t\n103\t            controller = source.controller\n104\t            if controller is None:\n105\t                return\n106\t            options = [\n107\t                ManaType.WHITE,\n108\t                ManaType.BLUE,\n109\t                ManaType.BLACK,\n110\t                ManaType.RED,\n111\t                ManaType.GREEN,\n112\t            ]\n113\t            try:\n114\t                chosen = controller.choose(options, \"choose a color of mana\")\n115\t            except (ScriptExhaustedError, NotImplementedError):\n116\t                chosen = ManaType.WHITE\n117\t            if chosen not in options:\n118\t                chosen = ManaType.WHITE\n119\t            controller.mana_pool.add(chosen, 1)\n120\t\n121\t        return [\n122\t            ManaAbility(\n123\t                cost=_tap_cost,\n124\t                mana_produced=_colorless_effect,\n125\t                description=\"{T}: Add {C}.\",\n126\t            ),\n127\t            ManaAbility(\n128\t                cost=_tap_pay_life_cost,\n129\t                mana_produced=_any_color_effect,\n130\t                description=\"{T}, Pay 1 life: Add one mana of any color \"\n131\t                \"(restricted to instants/sorceries).\",\n132\t            ),\n133\t        ]\n134\t\n135\t    # ------------------------------------------------------------------\n136\t    # Activated ability — {5}: animate into a 2/4 Wizard creature\n137\t    # ------------------------------------------------------------------\n138\t    def get_activated_abilities(self) -> list[ActivatedAbility]:\n139\t        source = self\n140\t\n141\t        def _animate_cost(game: Any, src: Any) -> bool:\n142\t            controller = src.controller\n143\t            if controller is None:\n144\t                return False\n145\t            cost = ManaCost.parse(\"{5}\")\n146\t            if not controller.mana_pool.can_pay(cost):\n147\t                return False\n148\t            controller.mana_pool.pay(cost)\n149\t            return True\n150\t\n151\t        def _animate_effect(game: Any) -> None:\n152\t            if getattr(source, \"_is_animated\", False):\n153\t                return\n154\t            source._animate(game)\n155\t\n156\t        return [\n157\t            ActivatedAbility(\n158\t                cost=_animate_cost,\n159\t                effect=_animate_effect,\n160\t                description=\"{5}: If this land isn't a creature, it becomes a \"\n161\t                \"2/4 Wizard creature. It's still a land.\",\n162\t            )\n163\t        ]\n164\t\n165\t    def _animate(self, game: \"GameState\") -> None:\n166\t        from engine.continuous_effects import (\n167\t            DURATION_PERMANENT,\n168\t            ContinuousEffect,\n169\t            Layer,\n170\t        )\n171\t        from engine.events import SpellCastTriggeredEvent\n172\t        from engine.triggers import TriggerRegistration\n173\t\n174\t        self._is_animated = True\n175\t        self.base_power = 2\n176\t        self.base_toughness = 4\n177\t        self.modified_power = 2\n178\t        self.modified_toughness = 4\n179\t        self.damage_marked = 0\n180\t        self.is_attacking = False\n181\t        self.is_blocking = False\n182\t        self.plus_one_counters = 0\n183\t        self.minus_one_counters = 0\n184\t        self._base_plus_one_counters = 0\n185\t        self._base_minus_one_counters = 0\n186\t        # A land that's been under your control acts as though it has no\n187\t        # summoning sickness once animated (the common man-land case).\n188\t        self.summoning_sick = False\n189\t\n190\t        source = self\n191\t\n192\t        def _type_apply(g: \"GameState\") -> None:\n193\t            source.card_types.add(CardType.CREATURE)\n194\t            source.subtypes.add(\"Wizard\")\n195\t\n196\t        game.effect_manager.add(\n197\t            ContinuousEffect(\n198\t                source=source,\n199\t                layer=Layer.TYPE,\n200\t                apply=_type_apply,\n201\t                duration=DURATION_PERMANENT,\n202\t            )\n203\t        )\n204\t\n205\t        def _pump_condition(\n206\t            g: \"GameState\", event: SpellCastTriggeredEvent\n207\t        ) -> bool:\n208\t            if not getattr(source, \"_is_animated\", False):\n209\t                return False\n210\t            if getattr(event, \"controller\", None) is not source.controller:\n211\t                return False\n212\t            card = getattr(event, \"card\", None)\n213\t            if card is None:\n214\t                return False\n215\t            types = getattr(card, \"card_types\", set())\n216\t            return CardType.INSTANT in types or CardType.SORCERY in types\n217\t\n218\t        def _pump_effect(g: \"GameState\") -> None:\n219\t            from engine.continuous_effects import (\n220\t                DURATION_END_OF_TURN,\n221\t                ContinuousEffect as _CE,\n222\t                Layer as _Layer,\n223\t                SubLayer as _SubLayer,\n224\t            )\n225\t\n226\t            def _apply(gg: \"GameState\") -> None:\n227\t                source.modified_power = (\n228\t                    getattr(source, \"modified_power\", source.base_power) + 1\n229\t                )\n230\t\n231\t            g.effect_manager.add(\n232\t                _CE(\n233\t                    source=source,\n234\t                    layer=_Layer.POWER_TOUGHNESS,\n235\t                    sublayer=_SubLayer.MODIFY_PT,\n236\t                    apply=_apply,\n237\t                    duration=DURATION_END_OF_TURN,\n238\t                )\n239\t            )\n240\t            g.effect_manager.apply_all(g)\n241\t\n242\t        game.trigger_manager.register(\n243\t            TriggerRegistration(\n244\t                event_type=SpellCastTriggeredEvent,\n245\t                condition=_pump_condition,\n246\t                effect=_pump_effect,\n247\t                source=source,\n248\t                controller=source.controller,\n249\t            )\n250\t        )\n251\t\n252\t        # Apply the type-changing effect immediately so the land is a creature.\n253\t        game.effect_manager.apply_all(game)\n254\t"}]},"parent_tool_use_id":null,"session_id":"f8a3aed6-12f8-4341-9631-2336f98abe5d","uuid":"07f434cf-5eb3-40c0-a207-836248be3eb6","timestamp":"2026-06-04T07:05:26.365Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/sos/sos_257/card_impl.py","content":"\"\"\"Card implementation for Great Hall of the Biblioplex.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.card import ActivatedAbility, Land, ManaAbility\nfrom engine.types import CardType, ManaCost, ManaType\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n\nclass GreatHallOfTheBiblioplex(Land):\n    \"\"\"Great Hall of the Biblioplex — Land.\n\n    {T}: Add {C}.\n    {T}, Pay 1 life: Add one mana of any color. Spend this mana only to\n    cast an instant or sorcery spell.\n    {5}: If this land isn't a creature, it becomes a 2/4 Wizard creature\n    with \"Whenever you cast an instant or sorcery spell, this creature gets\n    +1/+0 until end of turn.\" It's still a land.\n\n    SOS collector number 257.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"Great Hall of the Biblioplex\")\n        kwargs.setdefault(\n            \"rules_text\",\n            \"{T}: Add {C}.\\n\"\n            \"{T}, Pay 1 life: Add one mana of any color. Spend this mana \"\n            \"only to cast an instant or sorcery spell.\\n\"\n            \"{5}: If this land isn't a creature, it becomes a 2/4 Wizard \"\n            'creature with \"Whenever you cast an instant or sorcery spell, '\n            'this creature gets +1/+0 until end of turn.\" It\\'s still a land.',\n        )\n        super().__init__(**kwargs)\n        self._is_animated: bool = False\n\n    # ------------------------------------------------------------------\n    # Power / toughness — only meaningful once animated.  Defined as\n    # properties so combat can read them, but ``base_power`` is left unset\n    # until animation so the land is not a legal attacker beforehand.\n    # ------------------------------------------------------------------\n    @property\n    def power(self) -> int:\n        return (\n            getattr(self, \"modified_power\", 0)\n            + getattr(self, \"plus_one_counters\", 0)\n            - getattr(self, \"minus_one_counters\", 0)\n        )\n\n    @property\n    def toughness(self) -> int:\n        return (\n            getattr(self, \"modified_toughness\", 0)\n            + getattr(self, \"plus_one_counters\", 0)\n            - getattr(self, \"minus_one_counters\", 0)\n        )\n\n    def _reset_characteristics(self) -> None:\n        super()._reset_characteristics()\n        if getattr(self, \"_is_animated\", False):\n            self.modified_power = self.base_power\n            self.modified_toughness = self.base_toughness\n            self.plus_one_counters = getattr(self, \"_base_plus_one_counters\", 0)\n            self.minus_one_counters = getattr(self, \"_base_minus_one_counters\", 0)\n\n    # ------------------------------------------------------------------\n    # Mana abilities\n    # ------------------------------------------------------------------\n    def get_mana_abilities(self) -> list[ManaAbility]:\n        source = self\n\n        def _tap_cost(game: Any, src: Any) -> bool:\n            if getattr(src, \"is_tapped\", False):\n                return False\n            src.is_tapped = True\n            return True\n\n        def _tap_pay_life_cost(game: Any, src: Any) -> bool:\n            controller = src.controller\n            if controller is None or getattr(src, \"is_tapped\", False):\n                return False\n            if getattr(controller, \"life\", 0) < 1:\n                return False\n            src.is_tapped = True\n            controller.life -= 1\n            return True\n\n        def _colorless_effect(game: Any) -> None:\n            controller = source.controller\n            if controller is not None:\n                controller.mana_pool.add(ManaType.COLORLESS, 1)\n\n        def _any_color_effect(game: Any) -> None:\n            # ENGINE LIMITATION: the engine has no concept of \"spend this mana\n            # only to cast an instant or sorcery spell\", so the restriction is\n            # not enforced — the mana is produced as ordinary mana.\n            from engine.player import ScriptExhaustedError\n\n            controller = source.controller\n            if controller is None:\n                return\n            options = [\n                ManaType.WHITE,\n                ManaType.BLUE,\n                ManaType.BLACK,\n                ManaType.RED,\n                ManaType.GREEN,\n            ]\n            try:\n                chosen = controller.choose(options, \"choose a color of mana\")\n            except (ScriptExhaustedError, NotImplementedError):\n                chosen = ManaType.WHITE\n            if chosen not in options:\n                chosen = ManaType.WHITE\n            controller.mana_pool.add(chosen, 1)\n\n        return [\n            ManaAbility(\n                cost=_tap_cost,\n                mana_produced=_colorless_effect,\n                description=\"{T}: Add {C}.\",\n            ),\n            ManaAbility(\n                cost=_tap_pay_life_cost,\n                mana_produced=_any_color_effect,\n                description=\"{T}, Pay 1 life: Add one mana of any color \"\n                \"(restricted to instants/sorceries).\",\n            ),\n        ]\n\n    # ------------------------------------------------------------------\n    # Activated ability — {5}: animate into a 2/4 Wizard creature\n    # ------------------------------------------------------------------\n    def get_activated_abilities(self) -> list[ActivatedAbility]:\n        source = self\n\n        def _animate_cost(game: Any, src: Any) -> bool:\n            controller = src.controller\n            if controller is None:\n                return False\n            cost = ManaCost.parse(\"{5}\")\n            if not controller.mana_pool.can_pay(cost):\n                return False\n            controller.mana_pool.pay(cost)\n            return True\n\n        def _animate_effect(game: Any) -> None:\n            if getattr(source, \"_is_animated\", False):\n                return\n            source._animate(game)\n\n        return [\n            ActivatedAbility(\n                cost=_animate_cost,\n                effect=_animate_effect,\n                description=\"{5}: If this land isn't a creature, it becomes a \"\n                \"2/4 Wizard creature. It's still a land.\",\n            )\n        ]\n\n    def _animate(self, game: \"GameState\") -> None:\n        from engine.continuous_effects import (\n            DURATION_PERMANENT,\n            ContinuousEffect,\n            Layer,\n        )\n        from engine.events import SpellCastTriggeredEvent\n        from engine.triggers import TriggerRegistration\n\n        self._is_animated = True\n        self.base_power = 2\n        self.base_toughness = 4\n        self.modified_power = 2\n        self.modified_toughness = 4\n        self.damage_marked = 0\n        self.is_attacking = False\n        self.is_blocking = False\n        self.plus_one_counters = 0\n        self.minus_one_counters = 0\n        self._base_plus_one_counters = 0\n        self._base_minus_one_counters = 0\n        # A land that's been under your control acts as though it has no\n        # summoning sickness once animated (the common man-land case).\n        self.summoning_sick = False\n\n        source = self\n\n        def _type_apply(g: \"GameState\") -> None:\n            source.card_types.add(CardType.CREATURE)\n            source.subtypes.add(\"Wizard\")\n\n        game.effect_manager.add(\n            ContinuousEffect(\n                source=source,\n                layer=Layer.TYPE,\n                apply=_type_apply,\n                duration=DURATION_PERMANENT,\n            )\n        )\n\n        def _pump_condition(\n            g: \"GameState\", event: SpellCastTriggeredEvent\n        ) -> bool:\n            if not getattr(source, \"_is_animated\", False):\n                return False\n            if getattr(event, \"controller\", None) is not source.controller:\n                return False\n            card = getattr(event, \"card\", None)\n            if card is None:\n                return False\n            types = getattr(card, \"card_types\", set())\n            return CardType.INSTANT in types or CardType.SORCERY in types\n\n        def _pump_effect(g: \"GameState\") -> None:\n            from engine.continuous_effects import (\n                DURATION_END_OF_TURN,\n                ContinuousEffect as _CE,\n                Layer as _Layer,\n                SubLayer as _SubLayer,\n            )\n\n            def _apply(gg: \"GameState\") -> None:\n                source.modified_power = (\n                    getattr(source, \"modified_power\", source.base_power) + 1\n                )\n\n            g.effect_manager.add(\n                _CE(\n                    source=source,\n                    layer=_Layer.POWER_TOUGHNESS,\n                    sublayer=_SubLayer.MODIFY_PT,\n                    apply=_apply,\n                    duration=DURATION_END_OF_TURN,\n                )\n            )\n            g.effect_manager.apply_all(g)\n\n        game.trigger_manager.register(\n            TriggerRegistration(\n                event_type=SpellCastTriggeredEvent,\n                condition=_pump_condition,\n                effect=_pump_effect,\n                source=source,\n                controller=source.controller,\n            )\n        )\n\n        # Apply the type-changing effect immediately so the land is a creature.\n        game.effect_manager.apply_all(game)\n","numLines":254,"startLine":1,"totalLines":254}}}
