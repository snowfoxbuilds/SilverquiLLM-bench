{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JJuNhNwAgmyX1MCjr8ZXa2","type":"tool_result","content":"1\t\"\"\"Reference test for FDN 142 — Healer's Hawk.\n2\t\n3\tIllustrative test covering **blocker declaration / blocking restrictions**.\n4\tHealer's Hawk is a 1/1 with Flying + Lifelink. The flying keyword\n5\trestricts which creatures can legally block it: per the rules, a flying\n6\tattacker can only be blocked by creatures with flying or reach. The\n7\tengine encodes this in :func:`engine.combat._can_block`.\n8\t\"\"\"\n9\t\n10\tfrom __future__ import annotations\n11\t\n12\tfrom cards.fdn.fdn_142.card_impl import HealersHawk\n13\tfrom engine.card import Creature\n14\tfrom engine.combat import _can_block\n15\tfrom engine.types import Keyword, ManaCost\n16\t\n17\t\n18\tclass TestHealersHawkProperties:\n19\t    \"\"\"Static card data should match the FDN 142 spec.\"\"\"\n20\t\n21\t    def test_is_creature(self) -> None:\n22\t        assert isinstance(HealersHawk(owner=None), Creature)\n23\t\n24\t    def test_name(self) -> None:\n25\t        assert HealersHawk(owner=None).name == \"Healer's Hawk\"\n26\t\n27\t    def test_mana_cost(self) -> None:\n28\t        assert HealersHawk(owner=None).mana_cost == ManaCost.parse(\"{W}\")\n29\t\n30\t    def test_power_toughness(self) -> None:\n31\t        card = HealersHawk(owner=None)\n32\t        assert card.base_power == 1\n33\t        assert card.base_toughness == 1\n34\t\n35\t    def test_has_flying_and_lifelink(self) -> None:\n36\t        kw = HealersHawk(owner=None).keywords\n37\t        assert Keyword.FLYING in kw\n38\t        assert Keyword.LIFELINK in kw\n39\t\n40\t\n41\tclass TestHealersHawkBlockerRules:\n42\t    \"\"\"Flying restricts which creatures can legally block this attacker.\"\"\"\n43\t\n44\t    @staticmethod\n45\t    def _ground_creature() -> Creature:\n46\t        c = Creature(name=\"Ground Bear\", base_power=2, base_toughness=2)\n47\t        c.keywords = Keyword(0)\n48\t        c.is_tapped = False\n49\t        return c\n50\t\n51\t    @staticmethod\n52\t    def _flying_creature() -> Creature:\n53\t        c = Creature(name=\"Air Bear\", base_power=2, base_toughness=2)\n54\t        c.keywords = Keyword.FLYING\n55\t        c.is_tapped = False\n56\t        return c\n57\t\n58\t    @staticmethod\n59\t    def _reach_creature() -> Creature:\n60\t        c = Creature(name=\"Spider\", base_power=1, base_toughness=4)\n61\t        c.keywords = Keyword.REACH\n62\t        c.is_tapped = False\n63\t        return c\n64\t\n65\t    def test_ground_creature_cannot_block_flying_attacker(self) -> None:\n66\t        attacker = HealersHawk(owner=None)\n67\t        blocker = self._ground_creature()\n68\t        assert _can_block(blocker, attacker) is False\n69\t\n70\t    def test_flying_blocker_can_block_flying_attacker(self) -> None:\n71\t        attacker = HealersHawk(owner=None)\n72\t        blocker = self._flying_creature()\n73\t        assert _can_block(blocker, attacker) is True\n74\t\n75\t    def test_reach_blocker_can_block_flying_attacker(self) -> None:\n76\t        attacker = HealersHawk(owner=None)\n77\t        blocker = self._reach_creature()\n78\t        assert _can_block(blocker, attacker) is True\n79\t\n80\t    def test_tapped_creature_cannot_block(self) -> None:\n81\t        \"\"\"Tapped creatures cannot be declared as blockers at all.\"\"\"\n82\t        attacker = HealersHawk(owner=None)\n83\t        blocker = self._flying_creature()\n84\t        blocker.is_tapped = True\n85\t        assert _can_block(blocker, attacker) is False\n86\t"}]},"parent_tool_use_id":null,"session_id":"f8a3aed6-12f8-4341-9631-2336f98abe5d","uuid":"920af4e2-a863-4506-9d7d-2be4bc8e1fdb","timestamp":"2026-06-04T06:54:31.001Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_142/tests.py","content":"\"\"\"Reference test for FDN 142 — Healer's Hawk.\n\nIllustrative test covering **blocker declaration / blocking restrictions**.\nHealer's Hawk is a 1/1 with Flying + Lifelink. The flying keyword\nrestricts which creatures can legally block it: per the rules, a flying\nattacker can only be blocked by creatures with flying or reach. The\nengine encodes this in :func:`engine.combat._can_block`.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom cards.fdn.fdn_142.card_impl import HealersHawk\nfrom engine.card import Creature\nfrom engine.combat import _can_block\nfrom engine.types import Keyword, ManaCost\n\n\nclass TestHealersHawkProperties:\n    \"\"\"Static card data should match the FDN 142 spec.\"\"\"\n\n    def test_is_creature(self) -> None:\n        assert isinstance(HealersHawk(owner=None), Creature)\n\n    def test_name(self) -> None:\n        assert HealersHawk(owner=None).name == \"Healer's Hawk\"\n\n    def test_mana_cost(self) -> None:\n        assert HealersHawk(owner=None).mana_cost == ManaCost.parse(\"{W}\")\n\n    def test_power_toughness(self) -> None:\n        card = HealersHawk(owner=None)\n        assert card.base_power == 1\n        assert card.base_toughness == 1\n\n    def test_has_flying_and_lifelink(self) -> None:\n        kw = HealersHawk(owner=None).keywords\n        assert Keyword.FLYING in kw\n        assert Keyword.LIFELINK in kw\n\n\nclass TestHealersHawkBlockerRules:\n    \"\"\"Flying restricts which creatures can legally block this attacker.\"\"\"\n\n    @staticmethod\n    def _ground_creature() -> Creature:\n        c = Creature(name=\"Ground Bear\", base_power=2, base_toughness=2)\n        c.keywords = Keyword(0)\n        c.is_tapped = False\n        return c\n\n    @staticmethod\n    def _flying_creature() -> Creature:\n        c = Creature(name=\"Air Bear\", base_power=2, base_toughness=2)\n        c.keywords = Keyword.FLYING\n        c.is_tapped = False\n        return c\n\n    @staticmethod\n    def _reach_creature() -> Creature:\n        c = Creature(name=\"Spider\", base_power=1, base_toughness=4)\n        c.keywords = Keyword.REACH\n        c.is_tapped = False\n        return c\n\n    def test_ground_creature_cannot_block_flying_attacker(self) -> None:\n        attacker = HealersHawk(owner=None)\n        blocker = self._ground_creature()\n        assert _can_block(blocker, attacker) is False\n\n    def test_flying_blocker_can_block_flying_attacker(self) -> None:\n        attacker = HealersHawk(owner=None)\n        blocker = self._flying_creature()\n        assert _can_block(blocker, attacker) is True\n\n    def test_reach_blocker_can_block_flying_attacker(self) -> None:\n        attacker = HealersHawk(owner=None)\n        blocker = self._reach_creature()\n        assert _can_block(blocker, attacker) is True\n\n    def test_tapped_creature_cannot_block(self) -> None:\n        \"\"\"Tapped creatures cannot be declared as blockers at all.\"\"\"\n        attacker = HealersHawk(owner=None)\n        blocker = self._flying_creature()\n        blocker.is_tapped = True\n        assert _can_block(blocker, attacker) is False\n","numLines":86,"startLine":1,"totalLines":86}}}
