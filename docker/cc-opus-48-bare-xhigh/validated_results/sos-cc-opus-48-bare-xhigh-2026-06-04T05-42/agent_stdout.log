{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DPnuDyLzEKjDfhSybQfMxJ","type":"tool_result","content":"230\t\n231\t    if not eligible:\n232\t        return\n233\t\n234\t    # Active player chooses which creatures to attack with\n235\t    chosen = active.choose(eligible, \"declare attackers\")\n236\t\n237\t    # Normalize to a list\n238\t    if chosen is None:\n239\t        return\n240\t    if not isinstance(chosen, list):\n241\t        chosen = [chosen]\n242\t\n243\t    # Validate and register attackers\n244\t    declared: list[Any] = []\n245\t    for attacker in chosen:\n246\t        if attacker not in eligible:\n247\t            continue\n248\t        if not _can_attack(attacker):\n249\t            continue\n250\t\n251\t        combat.attackers[attacker] = defending\n252\t        combat.attacker_blockers[attacker] = []\n253\t        attacker.is_attacking = True\n254\t        declared.append(attacker)\n255\t\n256\t        # Tap the attacker unless it has vigilance\n257\t        kw = getattr(attacker, \"keywords\", Keyword(0))\n258\t        if Keyword.VIGILANCE not in kw:\n259\t            attacker.is_tapped = True\n260\t\n261\t    # Fire an \"attacks\" event for each declared attacker so triggered\n262\t    # abilities (e.g. \"Whenever ~ attacks, ...\") can respond.  Fired after\n263\t    # all attackers are declared so every is_attacking flag is set.\n264\t    if declared:\n265\t        from engine.events import AttacksTriggeredEvent\n266\t\n267\t        for attacker in declared:\n268\t            game.trigger_manager.fire_event(\n269\t                game,\n270\t                AttacksTriggeredEvent(creature=attacker, attacker=attacker),\n271\t            )\n272\t\n273\t\n274\tdef declare_blockers_step(game: GameState) -> None:\n275\t    \"\"\"Declare blockers step: defending player assigns blockers.\n276\t\n277\t    The defending player is asked (via :meth:`Player.choose`) to assign\n278\t    blockers.  The expected format is a dict 