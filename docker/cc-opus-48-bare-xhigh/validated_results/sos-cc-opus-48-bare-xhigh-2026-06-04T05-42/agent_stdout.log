{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SyARSoATQtgx2B1AzBZZQx","type":"tool_result","content":"1\t\"\"\"State-based actions checker and resolver.\n2\t\n3\tState-based actions (SBAs) are game rules that are checked and applied\n4\tautomatically whenever a player would receive priority.  They are checked\n5\trepeatedly until no more actions are taken, at which point triggered\n6\tabilities are placed on the stack.\n7\t\n8\tReferences: MTG Comprehensive Rules §704.\n9\t\"\"\"\n10\t\n11\tfrom __future__ import annotations\n12\t\n13\tfrom collections import defaultdict\n14\tfrom typing import TYPE_CHECKING, Any\n15\t\n16\tfrom engine.events import CreatureDiesReplacementEvent\n17\tfrom engine.types import CardType, Supertype, Zone\n18\tfrom engine.zones import ZoneContainer\n19\t\n20\tif TYPE_CHECKING:\n21\t    from engine.game_state import GameState\n22\t    from engine.player import Player\n23\t\n24\t\n25\t# ---------------------------------------------------------------------------\n26\t# Internal helpers\n27\t# ---------------------------------------------------------------------------\n28\t\n29\tdef _battlefield(game: GameState, player: Player) -> ZoneContainer:\n30\t    \"\"\"Return *player*'s battlefield zone.\"\"\"\n31\t    return player.zones[Zone.BATTLEFIELD]\n32\t\n33\t\n34\tdef _graveyard(game: GameState, player: Player) -> ZoneContainer:\n35\t    \"\"\"Return *player*'s graveyard zone.\"\"\"\n36\t    return player.zones[Zone.GRAVEYARD]\n37\t\n38\t\n39\tdef _move_to_graveyard(game: GameState, player: Player, obj: Any) -> None:\n40\t    \"\"\"Move *obj* from the battlefield to its owner's graveyard (or a\n41\t    replacement destination).\n42\t\n43\t    Delegates to :func:`~engine.zones.move_to_zone` which handles\n44\t    replacement effects, event firing (``LEAVES_BATTLEFIELD``,\n45\t    ``CREATURE_DIES``), and trigger/effect unregistration.\n46\t    \"\"\"\n47\t    from engine.zones import move_to_zone\n48\t\n49\t    bf = _battlefield(game, player)\n50\t    if bf.contains(obj):\n51\t        controller = getattr(obj, \"controller\", player)\n52\t        owner = getattr(obj, \"owner\", controller)\n53\t        move_to_zone(\n54\t            game,\n55\t            obj,\n56\t            Zone.BATTLEFIELD,\n57\t            Zone.GRAVEYARD,\n58\t            replacement_event=CreatureDiesReplacementEvent(\n59\t                creature=obj, destination=\"graveyard\",\n60\t                controller=controller, owner=owner,\n61\t            ),\n62\t        )\n63\t\n64\t\n65\t\n66\tdef _owner_of(game: GameState, obj: Any) -> Player:\n67\t    \"\"\"Return the owner of *obj*.\n68\t\n69\t    Falls back to checking which player's battlefield contains the object,\n70\t    then defaults to the first player.\n71\t    \"\"\"\n72\t    if hasattr(obj, \"owner\"):\n73\t        return obj.owner\n74\t    # Fallback: check each player's battlefield\n75\t    for player in game.players:\n76\t        if _battlefield(game, player).contains(obj):\n77\t            return player\n78\t    return game.players[0]\n79\t\n80\t\n81\t# ---------------------------------------------------------------------------\n82\t# Individual SBA checks\n83\t# ---------------------------------------------------------------------------\n84\t\n85\tdef _sba_player_life_zero(game: GameState) -> bool:\n86\t    \"\"\"A player with 0 or less life loses the game.\"\"\"\n87\t    action_taken = False\n88\t    for player in game.players:\n89\t        if player.life <= 0 and not player.has_lost:\n90\t            player.has_lost = True\n91\t            action_taken = True\n92\t    return action_taken\n93\t\n94\t\n95\tdef _sba_creature_zero_toughness(game: GameState) -> bool:\n96\t    \"\"\"A creature with toughness 0 or less is put into its owner's graveyard.\"\"\"\n97\t    action_taken = False\n98\t    to_remove: list[tuple[Player, Any]] = []\n99\t    for player in game.players:\n100\t        for obj in _battlefield(game, player).get_all():\n101\t            if hasattr(obj, \"toughness\") and obj.toughness <= 0:\n102\t                to_remove.append((player, obj))\n103\t    for player, obj in to_remove:\n104\t        _move_to_graveyard(game, player, obj)\n105\t        action_taken = True\n106\t    return action_taken\n107\t\n108\t\n109\tdef _sba_creature_lethal_damage(game: GameState) -> bool:\n110\t    \"\"\"A creature with lethal damage marked on it is destroyed (moved to graveyard).\n111\t\n112\t    Lethal damage means ``damage_marked >= toughness`` (rule 704.5g) or the\n113\t    creature has been dealt damage by a source with deathtouch and has any\n114\t    damage marked on it (rule 704.5h).  Creatures with the ``indestructible``\n115\t    keyword are skipped.\n116\t    \"\"\"\n117\t    action_taken = False\n118\t    to_remove: list[tuple[Player, Any]] = []\n119\t    for player in game.players:\n120\t        for obj in _battlefield(game, player).get_all():\n121\t            if not hasattr(obj, \"toughness\") or not hasattr(obj, \"damage_marked\"):\n122\t                continue\n123\t\n124\t            # Skip indestructible creatures\n125\t            if hasattr(obj, \"keywords\"):\n126\t                from engine.types import Keyword\n127\t\n128\t                if Keyword.INDESTRUCTIBLE in obj.keywords:\n129\t                    continue\n130\t\n131\t            lethal = obj.damage_marked >= obj.toughness\n132\t            # Rule 704.5h: creature dealt damage by a deathtouch source\n133\t            deathtouch_lethal = (\n134\t                getattr(obj, \"dealt_deathtouch_damage\", False)\n135\t                and obj.damage_marked > 0\n136\t            )\n137\t\n138\t            if lethal or deathtouch_lethal:\n139\t                to_remove.append((player, obj))\n140\t\n141\t    for player, obj in to_remove:\n142\t        _move_to_graveyard(game, player, obj)\n143\t        action_taken = True\n144\t    return action_taken\n145\t\n146\t\n147\tdef _sba_draw_from_empty_library(game: GameState) -> bool:\n148\t    \"\"\"A player who attempted to draw from an empty library loses the game.\"\"\"\n149\t    action_taken = False\n150\t    for player in game.players:\n151\t        if (\n152\t            hasattr(player, \"drawn_from_empty_library\")\n153\t            and player.drawn_from_empty_library\n154\t            and not player.has_lost\n155\t        ):\n156\t            player.has_lost = True\n157\t            action_taken = True\n158\t    return action_taken\n159\t\n160\t\n161\tdef _sba_legend_rule(game: GameState) -> bool:\n162\t    \"\"\"If a player controls 2+ legendaries with the same name, they choose one to keep.\n163\t\n164\t    The player is asked to choose which legendary permanent to keep via\n165\t    ``player.choose()``.  All others are moved to the graveyard.\n166\t    \"\"\"\n167\t    action_taken = False\n168\t    for player in game.players:\n169\t        bf = _battlefield(game, player)\n170\t        legendaries: dict[str, list[Any]] = defaultdict(list)\n171\t        for obj in bf.get_all():\n172\t            if (\n173\t                hasattr(obj, \"supertypes\")\n174\t                and Supertype.LEGENDARY in obj.supertypes\n175\t                and hasattr(obj, \"name\")\n176\t            ):\n177\t                legendaries[obj.name].append(obj)\n178\t        for name, objs in legendaries.items():\n179\t            if len(objs) >= 2:\n180\t                # Let the player choose which to keep\n181\t                keep = player.choose(objs, f\"legend rule: choose which {name!r} to keep\")\n182\t                for obj in objs:\n183\t                    if obj is not keep:\n184\t                        _move_to_graveyard(game, player, obj)\n185\t                action_taken = True\n186\t    return action_taken\n187\t\n188\t\n189\tdef _sba_token_not_on_battlefield(game: GameState) -> bool:\n190\t    \"\"\"Tokens that are not on the battlefield cease to exist (removed from game).\n191\t\n192\t    Checks all non-battlefield zones for tokens and removes them entirely.\n193\t    \"\"\"\n194\t    action_taken = False\n195\t    non_battlefield_zones = [\n196\t        Zone.HAND,\n197\t        Zone.GRAVEYARD,\n198\t        Zone.LIBRARY,\n199\t        Zone.EXILE,\n200\t        Zone.STACK,\n201\t        Zone.COMMAND,\n202\t    ]\n203\t    for player in game.players:\n204\t        for zone_type in non_battlefield_zones:\n205\t            zone = player.zones[zone_type]\n206\t            tokens = [\n207\t                obj\n208\t                for obj in zone.get_all()\n209\t                if hasattr(obj, \"is_token\") and obj.is_token\n210\t            ]\n211\t            for token in tokens:\n212\t                zone.remove(token)\n213\t                action_taken = True\n214\t    return action_taken\n215\t\n216\t\n217\tdef _attachment_illegal_due_to_protection(obj: Any) -> bool:\n218\t    \"\"\"Return ``True`` if *obj* (aura or equipment) is illegally attached due to protection.\"\"\"\n219\t    attached = getattr(obj, \"attached_to\", None)\n220\t    if attached is None:\n221\t        return False\n222\t    from engine.protection import has_protection_from\n223\t    return has_protection_from(attached, obj)\n224\t\n225\t\n226\tdef _sba_aura_unattached(game: GameState) -> bool:\n227\t    \"\"\"An Aura or Equipment not attached to a legal object is put into its\n228\t    owner's graveyard.\n229\t\n230\t    An attachment is considered illegally attached if:\n231\t    - It has an ``attached_to`` attribute that is ``None``, OR\n232\t    - The object it is attached to is no longer on the battlefield, OR\n233\t    - The enchanted/equipped permanent has protection from the attachment.\n234\t    \"\"\"\n235\t    action_taken = False\n236\t    to_remove: list[tuple[Player, Any]] = []\n237\t\n238\t    # Collect all objects on all battlefields for checking attachment legality\n239\t    all_on_battlefield: set[int] = set()\n240\t    for player in game.players:\n241\t        for obj in _battlefield(game, player).get_all():\n242\t            all_on_battlefield.add(id(obj))\n243\t\n244\t    to_unattach: list[Any] = []  # Equipment just becomes unattached\n245\t\n246\t    for player in game.players:\n247\t        for obj in _battlefield(game, player).get_all():\n248\t            is_aura = getattr(obj, \"is_aura\", False)\n249\t            is_equipment = getattr(obj, \"is_equipment\", False)\n250\t            if not hasattr(obj, \"attached_to\"):\n251\t                continue\n252\t            if is_aura:\n253\t                target = obj.attached_to\n254\t                if target is None or id(target) not in all_on_battlefield:\n255\t                    to_remove.append((player, obj))\n256\t                elif _attachment_illegal_due_to_protection(obj):\n257\t                    to_remove.append((player, obj))\n258\t            elif is_equipment:\n259\t                target = obj.attached_to\n260\t                if target is not None and _attachment_illegal_due_to_protection(obj):\n261\t                    to_unattach.append(obj)\n262\t\n263\t    for player, obj in to_remove:\n264\t        _move_to_graveyard(game, player, obj)\n265\t        action_taken = True\n266\t    for obj in to_unattach:\n267\t        obj.attached_to = None\n268\t        action_taken = True\n269\t    return action_taken\n270\t\n271\t\n272\tdef _sba_counter_annihilation(game: GameState) -> bool:\n273\t    \"\"\"+1/+1 and -1/-1 counters on the same permanent annihilate in pairs.\"\"\"\n274\t    action_taken = False\n275\t    for player in game.players:\n276\t        for obj in _battlefield(game, player).get_all():\n277\t            if (\n278\t                hasattr(obj, \"plus_one_counters\")\n279\t                and hasattr(obj, \"minus_one_counters\")\n280\t            ):\n281\t                plus = obj.plus_one_counters\n282\t                minus = obj.minus_one_counters\n283\t                if plus > 0 and minus > 0:\n284\t                    annihilate = min(plus, minus)\n285\t                    obj.plus_one_counters -= annihilate\n286\t                    obj.minus_one_counters -= annihilate\n287\t                    action_taken = True\n288\t    return action_taken\n289\t\n290\t\n291\t# ---------------------------------------------------------------------------\n292\t# Public API\n293\t# ---------------------------------------------------------------------------\n294\t\n295\tdef check_state_based_actions(game: GameState) -> bool:\n296\t    \"\"\"Perform a single pass of all state-based actions.\n297\t\n298\t    Returns ``True`` if any action was taken during this pass.  The caller\n299\t    should invoke this repeatedly until it returns ``False`` to ensure the\n300\t    game state is fully stable.\n301\t    \"\"\"\n302\t    action_taken = False\n303\t    # Player with 0 or less life loses\n304\t    action_taken = _sba_player_life_zero(game) or action_taken\n305\t    # Creature with toughness 0 or less → graveyard\n306\t    action_taken = _sba_creature_zero_toughness(game) or action_taken\n307\t    # Creature with lethal damage → destroyed\n308\t    action_taken = _sba_creature_lethal_damage(game) or action_taken\n309\t    # Player who drew from empty library loses\n310\t    action_taken = _sba_draw_from_empty_library(game) or action_taken\n311\t    # Legend rule\n312\t    action_taken = _sba_legend_rule(game) or action_taken\n313\t    # Token not on battlefield → ceases to exist\n314\t    action_taken = _sba_token_not_on_battlefield(game) or action_taken\n315\t    # Aura not attached to legal object → graveyard\n316\t    action_taken = _sba_aura_unattached(game) or action_taken\n317\t    # +1/+1 and -1/-1 counter annihilation\n318\t    action_taken = _sba_counter_annihilation(game) or action_taken\n319\t    return action_taken\n320\t\n321\t\n322\tdef resolve_state_based_actions(game: GameState) -> bool:\n323\t    \"\"\"Run state-based actions in a loop until no more actions are taken.\n324\t\n325\t    After each SBA stabilisation pass, any triggered abilities that were\n326\t    queued during processing are left on the stack.  Per MTG rule 704.3,\n327\t    the SBA loop must repeat if new triggers were placed on the stack\n328\t    (because those triggers may cause further SBAs when resolved, and\n329\t    the game state must be fully stable before a player receives priority).\n330\t\n331\t    The outer loop: repeat { run SBA passes until stable; record whether\n332\t    new triggers were pushed onto the stack during those passes } until\n333\t    no SBAs were performed **and** no new triggers were queued.\n334\t\n335\t    Returns ``True`` if any SBAs were performed during the entire process,\n336\t    ``False`` if the game state was already stable.\n337\t    \"\"\"\n338\t    any_performed = False\n339\t    while True:\n340\t        # Snapshot the stack size before SBA passes so we can detect new\n341\t        # triggers that were pushed during processing.\n342\t        stack_size_before = len(game.stack)\n343\t\n344\t        # Inner loop: run SBA checks until no more actions are taken.\n345\t        sba_this_round = False\n346\t        while check_state_based_actions(game):\n347\t            sba_this_round = True\n348\t            any_performed = True\n349\t\n350\t        # Detect whether any triggers were queued during this round.\n351\t        triggers_queued = len(game.stack) > stack_size_before\n352\t\n353\t        # If nothing happened this round (no SBAs and no new triggers),\n354\t        # the game state is fully stable.\n355\t        if not sba_this_round and not triggers_queued:\n356\t            break\n357\t\n358\t    return any_performed\n359\t"}]},"parent_tool_use_id":null,"session_id":"f8a3aed6-12f8-4341-9631-2336f98abe5d","uuid":"2acce19c-155f-46a1-b2ef-7424ac256630","timestamp":"2026-06-04T05:43:42.289Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/state_based_actions.py","content":"\"\"\"State-based actions checker and resolver.\n\nState-based actions (SBAs) are game rules that are checked and applied\nautomatically whenever a player would receive priority.  They are checked\nrepeatedly until no more actions are taken, at which point triggered\nabilities are placed on the stack.\n\nReferences: MTG Comprehensive Rules §704.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections import defaultdict\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.events import CreatureDiesReplacementEvent\nfrom engine.types import CardType, Supertype, Zone\nfrom engine.zones import ZoneContainer\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n# ---------------------------------------------------------------------------\n# Internal helpers\n# ---------------------------------------------------------------------------\n\ndef _battlefield(game: GameState, player: Player) -> ZoneContainer:\n    \"\"\"Return *player*'s battlefield zone.\"\"\"\n    return player.zones[Zone.BATTLEFIELD]\n\n\ndef _graveyard(game: GameState, player: Player) -> ZoneContainer:\n    \"\"\"Return *player*'s graveyard zone.\"\"\"\n    return player.zones[Zone.GRAVEYARD]\n\n\ndef _move_to_graveyard(game: GameState, player: Player, obj: Any) -> None:\n    \"\"\"Move *obj* from the battlefield to its owner's graveyard (or a\n    replacement destination).\n\n    Delegates to :func:`~engine.zones.move_to_zone` which handles\n    replacement effects, event firing (``LEAVES_BATTLEFIELD``,\n    ``CREATURE_DIES``), and trigger/effect unregistration.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    bf = _battlefield(game, player)\n    if bf.contains(obj):\n        controller = getattr(obj, \"controller\", player)\n        owner = getattr(obj, \"owner\", controller)\n        move_to_zone(\n            game,\n            obj,\n            Zone.BATTLEFIELD,\n            Zone.GRAVEYARD,\n            replacement_event=CreatureDiesReplacementEvent(\n                creature=obj, destination=\"graveyard\",\n                controller=controller, owner=owner,\n            ),\n        )\n\n\n\ndef _owner_of(game: GameState, obj: Any) -> Player:\n    \"\"\"Return the owner of *obj*.\n\n    Falls back to checking which player's battlefield contains the object,\n    then defaults to the first player.\n    \"\"\"\n    if hasattr(obj, \"owner\"):\n        return obj.owner\n    # Fallback: check each player's battlefield\n    for player in game.players:\n        if _battlefield(game, player).contains(obj):\n            return player\n    return game.players[0]\n\n\n# ---------------------------------------------------------------------------\n# Individual SBA checks\n# ---------------------------------------------------------------------------\n\ndef _sba_player_life_zero(game: GameState) -> bool:\n    \"\"\"A player with 0 or less life loses the game.\"\"\"\n    action_taken = False\n    for player in game.players:\n        if player.life <= 0 and not player.has_lost:\n            player.has_lost = True\n            action_taken = True\n    return action_taken\n\n\ndef _sba_creature_zero_toughness(game: GameState) -> bool:\n    \"\"\"A creature with toughness 0 or less is put into its owner's graveyard.\"\"\"\n    action_taken = False\n    to_remove: list[tuple[Player, Any]] = []\n    for player in game.players:\n        for obj in _battlefield(game, player).get_all():\n            if hasattr(obj, \"toughness\") and obj.toughness <= 0:\n                to_remove.append((player, obj))\n    for player, obj in to_remove:\n        _move_to_graveyard(game, player, obj)\n        action_taken = True\n    return action_taken\n\n\ndef _sba_creature_lethal_damage(game: GameState) -> bool:\n    \"\"\"A creature with lethal damage marked on it is destroyed (moved to graveyard).\n\n    Lethal damage means ``damage_marked >= toughness`` (rule 704.5g) or the\n    creature has been dealt damage by a source with deathtouch and has any\n    damage marked on it (rule 704.5h).  Creatures with the ``indestructible``\n    keyword are skipped.\n    \"\"\"\n    action_taken = False\n    to_remove: list[tuple[Player, Any]] = []\n    for player in game.players:\n        for obj in _battlefield(game, player).get_all():\n            if not hasattr(obj, \"toughness\") or not hasattr(obj, \"damage_marked\"):\n                continue\n\n            # Skip indestructible creatures\n            if hasattr(obj, \"keywords\"):\n                from engine.types import Keyword\n\n                if Keyword.INDESTRUCTIBLE in obj.keywords:\n                    continue\n\n            lethal = obj.damage_marked >= obj.toughness\n            # Rule 704.5h: creature dealt damage by a deathtouch source\n            deathtouch_lethal = (\n                getattr(obj, \"dealt_deathtouch_damage\", False)\n                and obj.damage_marked > 0\n            )\n\n            if lethal or deathtouch_lethal:\n                to_remove.append((player, obj))\n\n    for player, obj in to_remove:\n        _move_to_graveyard(game, player, obj)\n        action_taken = True\n    return action_taken\n\n\ndef _sba_draw_from_empty_library(game: GameState) -> bool:\n    \"\"\"A player who attempted to draw from an empty library loses the game.\"\"\"\n    action_taken = False\n    for player in game.players:\n        if (\n            hasattr(player, \"drawn_from_empty_library\")\n            and player.drawn_from_empty_library\n            and not player.has_lost\n        ):\n            player.has_lost = True\n            action_taken = True\n    return action_taken\n\n\ndef _sba_legend_rule(game: GameState) -> bool:\n    \"\"\"If a player controls 2+ legendaries with the same name, they choose one to keep.\n\n    The player is asked to choose which legendary permanent to keep via\n    ``player.choose()``.  All others are moved to the graveyard.\n    \"\"\"\n    action_taken = False\n    for player in game.players:\n        bf = _battlefield(game, player)\n        legendaries: dict[str, list[Any]] = defaultdict(list)\n        for obj in bf.get_all():\n            if (\n                hasattr(obj, \"supertypes\")\n                and Supertype.LEGENDARY in obj.supertypes\n                and hasattr(obj, \"name\")\n            ):\n                legendaries[obj.name].append(obj)\n        for name, objs in legendaries.items():\n            if len(objs) >= 2:\n                # Let the player choose which to keep\n                keep = player.choose(objs, f\"legend rule: choose which {name!r} to keep\")\n                for obj in objs:\n                    if obj is not keep:\n                        _move_to_graveyard(game, player, obj)\n                action_taken = True\n    return action_taken\n\n\ndef _sba_token_not_on_battlefield(game: GameState) -> bool:\n    \"\"\"Tokens that are not on the battlefield cease to exist (removed from game).\n\n    Checks all non-battlefield zones for tokens and removes them entirely.\n    \"\"\"\n    action_taken = False\n    non_battlefield_zones = [\n        Zone.HAND,\n        Zone.GRAVEYARD,\n        Zone.LIBRARY,\n        Zone.EXILE,\n        Zone.STACK,\n        Zone.COMMAND,\n    ]\n    for player in game.players:\n        for zone_type in non_battlefield_zones:\n            zone = player.zones[zone_type]\n            tokens = [\n                obj\n                for obj in zone.get_all()\n                if hasattr(obj, \"is_token\") and obj.is_token\n            ]\n            for token in tokens:\n                zone.remove(token)\n                action_taken = True\n    return action_taken\n\n\ndef _attachment_illegal_due_to_protection(obj: Any) -> bool:\n    \"\"\"Return ``True`` if *obj* (aura or equipment) is illegally attached due to protection.\"\"\"\n    attached = getattr(obj, \"attached_to\", None)\n    if attached is None:\n        return False\n    from engine.protection import has_protection_from\n    return has_protection_from(attached, obj)\n\n\ndef _sba_aura_unattached(game: GameState) -> bool:\n    \"\"\"An Aura or Equipment not attached to a legal object is put into its\n    owner's graveyard.\n\n    An attachment is considered illegally attached if:\n    - It has an ``attached_to`` attribute that is ``None``, OR\n    - The object it is attached to is no longer on the battlefield, OR\n    - The enchanted/equipped permanent has protection from the attachment.\n    \"\"\"\n    action_taken = False\n    to_remove: list[tuple[Player, Any]] = []\n\n    # Collect all objects on all battlefields for checking attachment legality\n    all_on_battlefield: set[int] = set()\n    for player in game.players:\n        for obj in _battlefield(game, player).get_all():\n            all_on_battlefield.add(id(obj))\n\n    to_unattach: list[Any] = []  # Equipment just becomes unattached\n\n    for player in game.players:\n        for obj in _battlefield(game, player).get_all():\n            is_aura = getattr(obj, \"is_aura\", False)\n            is_equipment = getattr(obj, \"is_equipment\", False)\n            if not hasattr(obj, \"attached_to\"):\n                continue\n            if is_aura:\n                target = obj.attached_to\n                if target is None or id(target) not in all_on_battlefield:\n                    to_remove.append((player, obj))\n                elif _attachment_illegal_due_to_protection(obj):\n                    to_remove.append((player, obj))\n            elif is_equipment:\n                target = obj.attached_to\n                if target is not None and _attachment_illegal_due_to_protection(obj):\n                    to_unattach.append(obj)\n\n    for player, obj in to_remove:\n        _move_to_graveyard(game, player, obj)\n        action_taken = True\n    for obj in to_unattach:\n        obj.attached_to = None\n        action_taken = True\n    return action_taken\n\n\ndef _sba_counter_annihilation(game: GameState) -> bool:\n    \"\"\"+1/+1 and -1/-1 counters on the same permanent annihilate in pairs.\"\"\"\n    action_taken = False\n    for player in game.players:\n        for obj in _battlefield(game, player).get_all():\n            if (\n                hasattr(obj, \"plus_one_counters\")\n                and hasattr(obj, \"minus_one_counters\")\n            ):\n                plus = obj.plus_one_counters\n                minus = obj.minus_one_counters\n                if plus > 0 and minus > 0:\n                    annihilate = min(plus, minus)\n                    obj.plus_one_counters -= annihilate\n                    obj.minus_one_counters -= annihilate\n                    action_taken = True\n    return action_taken\n\n\n# ---------------------------------------------------------------------------\n# Public API\n# ---------------------------------------------------------------------------\n\ndef check_state_based_actions(game: GameState) -> bool:\n    \"\"\"Perform a single pass of all state-based actions.\n\n    Returns ``True`` if any action was taken during this pass.  The caller\n    should invoke this repeatedly until it returns ``False`` to ensure the\n    game state is fully stable.\n    \"\"\"\n    action_taken = False\n    # Player with 0 or less life loses\n    action_taken = _sba_player_life_zero(game) or action_taken\n    # Creature with toughness 0 or less → graveyard\n    action_taken = _sba_creature_zero_toughness(game) or action_taken\n    # Creature with lethal damage → destroyed\n    action_taken = _sba_creature_lethal_damage(game) or action_taken\n    # Player who drew from empty library loses\n    action_taken = _sba_draw_from_empty_library(game) or action_taken\n    # Legend rule\n    action_taken = _sba_legend_rule(game) or action_taken\n    # Token not on battlefield → ceases to exist\n    action_taken = _sba_token_not_on_battlefield(game) or action_taken\n    # Aura not attached to legal object → graveyard\n    action_taken = _sba_aura_unattached(game) or action_taken\n    # +1/+1 and -1/-1 counter annihilation\n    action_taken = _sba_counter_annihilation(game) or action_taken\n    return action_taken\n\n\ndef resolve_state_based_actions(game: GameState) -> bool:\n    \"\"\"Run state-based actions in a loop until no more actions are taken.\n\n    After each SBA stabilisation pass, any triggered abilities that were\n    queued during processing are left on the stack.  Per MTG rule 704.3,\n    the SBA loop must repeat if new triggers were placed on the stack\n    (because those triggers may cause further SBAs when resolved, and\n    the game state must be fully stable before a player receives priority).\n\n    The outer loop: repeat { run SBA passes until stable; record whether\n    new triggers were pushed onto the stack during those passes } until\n    no SBAs were performed **and** no new triggers were queued.\n\n    Returns ``True`` if any SBAs were performed during the entire process,\n    ``False`` if the game state was already stable.\n    \"\"\"\n    any_performed = False\n    while True:\n        # Snapshot the stack size before SBA passes so we can detect new\n        # triggers that were pushed during processing.\n        stack_size_before = len(game.stack)\n\n        # Inner loop: run SBA checks until no more actions are taken.\n        sba_this_round = False\n        while check_state_based_actions(game):\n            sba_this_round = True\n            any_performed = True\n\n        # Detect whether any triggers were queued during this round.\n        triggers_queued = len(game.stack) > stack_size_before\n\n        # If nothing happened this round (no SBAs and no new triggers),\n        # the game state is fully stable.\n        if not sba_this_round and not triggers_queued:\n            break\n\n    return any_performed\n","numLines":359,"startLine":1,"totalLines":359}}}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01Gcd1XVVKUSshFUWFkG8xMD","type":"message","role":"assistant","content":[{"type":"text","text":"Now let me read combat.py, basic_lands.py, test_utils, and look at FDN example cards with tests."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5678,"cache_read_input_tokens":107780,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5678},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"f8a3aed6-12f8-4341-9631-2336f98abe5d","uuid":"22592da3-63e2-4c5e-859c-e4c7871e9e50","request_id":"req_011CbhgqLVngDSx1Zsv6qyJS"}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01Gcd1XVVKUSshFUWFkG8xMD","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MzmKesNQ3iXxtrw1vkzM88","name":"Read","input":{"file_path":"/workspace/engine/combat.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5678,"cache_read_input_tokens":107780,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5678},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"f8a3aed6-12f8-4341-9631-2336f98abe5d","uuid":"5eee1d21-d9e2-4bed-914b-db2d55c7313d","request_id":"req_011CbhgqLVngDSx1Zsv6qyJS"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MzmKesNQ3iXxtrw1vkzM88","type":"tool_result","content":"1\t\"\"\"Combat system: declare attackers → declare blockers → damage → end combat.\n2\t\n3\tImplements the four substeps of the MTG combat phase:\n4\t\n5\t1. **Declare Attackers** — Active player chooses creatures to attack with.\n6\t   Attackers are tapped (unless they have vigilance).  Creatures with\n7\t   summoning sickness (without haste) or the defender keyword cannot attack.\n8\t\n9\t2. **Declare Blockers** — Defending player assigns blockers.  Creatures\n10\t   with flying can only be blocked by creatures with flying or reach.\n11\t   Creatures with menace require 2+ blockers.  The attacker's controller\n12\t   orders the blockers for damage assignment.\n13\t\n14\t3. **Combat Damage** — First strike / double strike creatures deal damage\n15\t   first, then state-based actions are checked, then normal damage.\n16\t   Trample excess goes to the defending player.  Lifelink heals the\n17\t   controller.  Deathtouch makes any nonzero damage lethal.  Unblocked\n18\t   attackers deal damage to the defending player.\n19\t\n20\t4. **End Combat** — Clear all combat state.\n21\t\n22\tReferences: MTG Comprehensive Rules §506–§511.\n23\t\"\"\"\n24\t\n25\tfrom __future__ import annotations\n26\t\n27\tfrom dataclasses import dataclass, field\n28\tfrom typing import TYPE_CHECKING, Any\n29\t\n30\tfrom engine.types import Keyword\n31\t\n32\tif TYPE_CHECKING:\n33\t    from engine.game_state import GameState\n34\t    from engine.player import Player\n35\t\n36\t\n37\t# ---------------------------------------------------------------------------\n38\t# CombatState — tracks all per-combat information\n39\t# ---------------------------------------------------------------------------\n40\t\n41\t@dataclass\n42\tclass CombatState:\n43\t    \"\"\"Tracks attackers, blockers, damage assignments, and block ordering.\n44\t\n45\t    Attributes:\n46\t        attackers: Mapping of attacking creature → defending player.\n47\t        blockers: Mapping of blocking creature → list of attackers it blocks.\n48\t        attacker_blockers: Mapping of attacking creature → ordered list of\n49\t            blockers assigned to it (order used for damage assignment).\n50\t        damage_assignments: Mapping of creature → list of\n51\t            ``(target, amount)`` tuples describing how damage is assigned.\n52\t        was_blocked: Set of attackers that were declared as blocked.  Per\n53\t            MTG rule 509.1h, once a creature is blocked it stays blocked\n54\t            even if all its blockers are removed before damage.\n55\t        in_combat: Whether the combat phase is currently active.\n56\t    \"\"\"\n57\t\n58\t    attackers: dict[Any, Player] = field(default_factory=dict)\n59\t    blockers: dict[Any, list[Any]] = field(default_factory=dict)\n60\t    attacker_blockers: dict[Any, list[Any]] = field(default_factory=dict)\n61\t    damage_assignments: dict[Any, list[tuple[Any, int]]] = field(default_factory=dict)\n62\t    was_blocked: set[Any] = field(default_factory=set)\n63\t    in_combat: bool = False\n64\t\n65\t    def clear(self) -> None:\n66\t        \"\"\"Reset all combat state.\"\"\"\n67\t        self.attackers.clear()\n68\t        self.blockers.clear()\n69\t        self.attacker_blockers.clear()\n70\t        self.damage_assignments.clear()\n71\t        self.was_blocked.clear()\n72\t        self.in_combat = False\n73\t\n74\t\n75\t# ---------------------------------------------------------------------------\n76\t# Helpers\n77\t# ---------------------------------------------------------------------------\n78\t\n79\tdef _can_attack(creature: Any) -> bool:\n80\t    \"\"\"Return ``True`` if *creature* is eligible to be declared as an attacker.\n81\t\n82\t    A creature cannot attack if:\n83\t    - It is already tapped.\n84\t    - It has the ``DEFENDER`` keyword.\n85\t    - It has summoning sickness (``summoning_sick``) and does not have ``HASTE``.\n86\t    - A continuous effect has set ``_cant_attack`` (e.g. Pacifism).\n87\t    \"\"\"\n88\t    if getattr(creature, \"is_tapped\", False):\n89\t        return False\n90\t\n91\t    # Check for \"can't attack\" restriction (set by continuous effects like Pacifism)\n92\t    if getattr(creature, \"_cant_attack\", False):\n93\t        return False\n94\t\n95\t    keywords = getattr(creature, \"keywords\", Keyword(0))\n96\t\n97\t    if Keyword.DEFENDER in keywords:\n98\t        return False\n99\t\n100\t    if getattr(creature, \"summoning_sick\", False) and Keyword.HASTE not in keywords:\n101\t        return False\n102\t\n103\t    return True\n104\t\n105\t\n106\tdef _can_block(blocker: Any, attacker: Any) -> bool:\n107\t    \"\"\"Return ``True`` if *blocker* can legally block *attacker*.\n108\t\n109\t    Checks:\n110\t    - If the blocker is tapped it cannot block.\n111\t    - A continuous effect has set ``_cant_block`` (e.g. Pacifism).\n112\t    - If the attacker has flying, the blocker must have flying or reach.\n113\t    \"\"\"\n114\t    if getattr(blocker, \"is_tapped\", False):\n115\t        return False\n116\t\n117\t    # Check for \"can't block\" restriction (set by continuous effects like Pacifism)\n118\t    if getattr(blocker, \"_cant_block\", False):\n119\t        return False\n120\t\n121\t    attacker_kw = getattr(attacker, \"keywords\", Keyword(0))\n122\t    blocker_kw = getattr(blocker, \"keywords\", Keyword(0))\n123\t\n124\t    # Flying check\n125\t    if Keyword.FLYING in attacker_kw:\n126\t        if Keyword.FLYING not in blocker_kw and Keyword.REACH not in blocker_kw:\n127\t            return False\n128\t\n129\t    # Protection check — attacker with protection from blocker can't be blocked\n130\t    from engine.protection import has_protection_from\n131\t\n132\t    if has_protection_from(attacker, blocker):\n133\t        return False\n134\t\n135\t    return True\n136\t\n137\t\n138\tdef _get_lethal_damage(creature: Any, attacker: Any | None = None) -> int:\n139\t    \"\"\"Return the amount of damage needed to lethally assign to *creature*.\n140\t\n141\t    If *attacker* has deathtouch, 1 damage is lethal.\n142\t    Otherwise it's ``toughness - damage_marked`` (at least 1).\n143\t    \"\"\"\n144\t    if attacker is not None:\n145\t        attacker_kw = getattr(attacker, \"keywords\", Keyword(0))\n146\t        if Keyword.DEATHTOUCH in attacker_kw:\n147\t            return 1\n148\t\n149\t    toughness = getattr(creature, \"toughness\", 0)\n150\t    damage_marked = getattr(creature, \"damage_marked\", 0)\n151\t    return max(1, toughness - damage_marked)\n152\t\n153\t\n154\tdef _deal_damage(\n155\t    source: Any,\n156\t    target: Any,\n157\t    amount: int,\n158\t    game: GameState,\n159\t    combat_state: CombatState,\n160\t) -> None:\n161\t    \"\"\"Apply *amount* damage from *source* to *target*.\n162\t\n163\t    If *target* is a player, reduces life.\n164\t    If *target* is a creature, marks damage on it.\n165\t    If *source* has lifelink, the controller gains that much life.\n166\t\n167\t    Protection prevents damage from sources with the protected-from quality.\n168\t    \"\"\"\n169\t    if amount <= 0:\n170\t        return\n171\t\n172\t    # Protection prevents damage (D in DEBT).\n173\t    from engine.protection import has_protection_from\n174\t\n175\t    if has_protection_from(target, source):\n176\t        return\n177\t\n178\t    # Record damage assignment\n179\t    if source not in combat_state.damage_assignments:\n180\t        combat_state.damage_assignments[source] = []\n181\t    combat_state.damage_assignments[source].append((target, amount))\n182\t\n183\t    # Apply damage\n184\t    if hasattr(target, \"life\"):\n185\t        # Target is a player\n186\t        target.life -= amount\n187\t    elif hasattr(target, \"damage_marked\"):\n188\t        # Target is a creature\n189\t        target.damage_marked += amount\n190\t\n191\t        # Track deathtouch damage for SBA rule 704.5h\n192\t        source_kw_dt = getattr(source, \"keywords\", Keyword(0))\n193\t        if Keyword.DEATHTOUCH in source_kw_dt:\n194\t            target.dealt_deathtouch_damage = True\n195\t\n196\t    # Lifelink: controller gains life equal to damage dealt\n197\t    source_kw = getattr(source, \"keywords\", Keyword(0))\n198\t    if Keyword.LIFELINK in source_kw:\n199\t        controller = getattr(source, \"controller\", None)\n200\t        if controller is not None and hasattr(controller, \"life\"):\n201\t            controller.life += amount\n202\t\n203\t\n204\t# ---------------------------------------------------------------------------\n205\t# Combat steps\n206\t# ---------------------------------------------------------------------------\n207\t\n208\tdef declare_attackers_step(game: GameState) -> None:\n209\t    \"\"\"Declare attackers step: active player chooses creatures to attack with.\n210\t\n211\t    The active player is asked (via :meth:`Player.choose`) to select a set\n212\t    of creatures to attack with.  Each chosen attacker is tapped (unless it\n213\t    has vigilance) and its ``is_attacking`` flag is set.\n214\t\n215\t    Parameters:\n216\t        game: The current game state.  ``game.combat_state`` must exist.\n217\t    \"\"\"\n218\t    combat = game.combat_state\n219\t    combat.in_combat = True\n220\t    active = game.active_player\n221\t    defending = game.non_active_player\n222\t\n223\t    # Gather legal attackers from the active player's battlefield\n224\t    from engine.types import Zone\n225\t    bf = active.zones[Zone.BATTLEFIELD]\n226\t    eligible = [\n227\t        c for c in bf.get_all()\n228\t        if hasattr(c, \"base_power\") and _can_attack(c)\n229\t    ]\n230\t\n231\t    if not eligible:\n232\t        return\n233\t\n234\t    # Active player chooses which creatures to attack with\n235\t    chosen = active.choose(eligible, \"declare attackers\")\n236\t\n237\t    # Normalize to a list\n238\t    if chosen is None:\n239\t        return\n240\t    if not isinstance(chosen, list):\n241\t        chosen = [chosen]\n242\t\n243\t    # Validate and register attackers\n244\t    for attacker in chosen:\n245\t        if attacker not in eligible:\n246\t            continue\n247\t        if not _can_attack(attacker):\n248\t            continue\n249\t\n250\t        combat.attackers[attacker] = defending\n251\t        combat.attacker_blockers[attacker] = []\n252\t        attacker.is_attacking = True\n253\t\n254\t        # Tap the attacker unless it has vigilance\n255\t        kw = getattr(attacker, \"keywords\", Keyword(0))\n256\t        if Keyword.VIGILANCE not in kw:\n257\t            attacker.is_tapped = True\n258\t\n259\t\n260\tdef declare_blockers_step(game: GameState) -> None:\n261\t    \"\"\"Declare blockers step: defending player assigns blockers.\n262\t\n263\t    The defending player is asked (via :meth:`Player.choose`) to assign\n264\t    blockers.  The expected format is a dict mapping blocker → attacker\n265\t    (or blocker → list of attackers for multi-blocking scenarios), but\n266\t    commonly blocker → attacker.\n267\t\n268\t    After blockers are assigned:\n269\t    - Menace check: attackers with menace must be blocked by 2+ creatures.\n270\t    - Flying/reach check is already handled by ``_can_block``.\n271\t    - The attacking player orders blockers for each attacker (for damage\n272\t      assignment).\n273\t\n274\t    Parameters:\n275\t        game: The current game state.\n276\t    \"\"\"\n277\t    combat = game.combat_state\n278\t\n279\t    if not combat.attackers:\n280\t        return\n281\t\n282\t    defending = game.non_active_player\n283\t    active = game.active_player\n284\t\n285\t    from engine.types import Zone\n286\t    bf_defending = defending.zones[Zone.BATTLEFIELD]\n287\t    eligible_blockers = [\n288\t        c for c in bf_defending.get_all()\n289\t        if hasattr(c, \"base_power\") and not getattr(c, \"is_tapped\", False)\n290\t    ]\n291\t\n292\t    if not eligible_blockers:\n293\t        return\n294\t\n295\t    # Defending player chooses block assignments\n296\t    # Expected format: dict mapping blocker → attacker (or list of attackers)\n297\t    block_assignments = defending.choose(\n298\t        eligible_blockers,\n299\t        \"declare blockers\",\n300\t    )\n301\t\n302\t    if block_assignments is None:\n303\t        return\n304\t\n305\t    if not isinstance(block_assignments, dict):\n306\t        return\n307\t\n308\t    # Process block assignments\n309\t    for blocker, target in block_assignments.items():\n310\t        # Validate that the blocker is in the eligible set\n311\t        if blocker not in eligible_blockers:\n312\t            continue\n313\t        targets = target if isinstance(target, list) else [target]\n314\t        valid_targets = []\n315\t        max_blocked = getattr(blocker, \"_max_attackers_blocked\", 1)\n316\t        for attacker in targets:\n317\t            if len(valid_targets) >= max_blocked:\n318\t                break\n319\t            if attacker in combat.attackers and _can_block(blocker, attacker):\n320\t                valid_targets.append(attacker)\n321\t        if valid_targets:\n322\t            combat.blockers[blocker] = valid_targets\n323\t            blocker.is_blocking = True\n324\t            for attacker in valid_targets:\n325\t                if attacker not in combat.attacker_blockers:\n326\t                    combat.attacker_blockers[attacker] = []\n327\t                combat.attacker_blockers[attacker].append(blocker)\n328\t\n329\t    # Menace check: attackers with menace that have fewer than 2 blockers\n330\t    # are treated as unblocked (remove the single blocker assignment).\n331\t    for attacker, blocker_list in list(combat.attacker_blockers.items()):\n332\t        kw = getattr(attacker, \"keywords\", Keyword(0))\n333\t        if Keyword.MENACE in kw and len(blocker_list) < 2 and len(blocker_list) > 0:\n334\t            # Illegal block — remove these blockers\n335\t            for b in blocker_list:\n336\t                if b in combat.blockers:\n337\t                    combat.blockers[b] = [\n338\t                        a for a in combat.blockers[b] if a is not attacker\n339\t                    ]\n340\t                    if not combat.blockers[b]:\n341\t                        del combat.blockers[b]\n342\t                        b.is_blocking = False\n343\t            combat.attacker_blockers[attacker] = []\n344\t\n345\t    # Mark attackers that have at least one blocker as \"was_blocked\".\n346\t    # Per MTG rule 509.1h, once a creature is blocked it remains blocked\n347\t    # even if all its blockers are removed before the damage step.\n348\t    for attacker, blocker_list in combat.attacker_blockers.items():\n349\t        if blocker_list:\n350\t            combat.was_blocked.add(attacker)\n351\t\n352\t    # Controller of each attacker orders the blockers for damage assignment\n353\t    for attacker, blocker_list in combat.attacker_blockers.items():\n354\t        if len(blocker_list) > 1:\n355\t            controller = getattr(attacker, \"controller\", active)\n356\t            ordered = controller.assign_damage_order(blocker_list)\n357\t            combat.attacker_blockers[attacker] = ordered\n358\t\n359\t\n360\tdef combat_damage_step(game: GameState) -> None:\n361\t    \"\"\"Combat damage step: deal combat damage.\n362\t\n363\t    Handles:\n364\t    - First strike / double strike creatures deal damage first.\n365\t    - State-based actions are checked between first-strike and normal damage.\n366\t    - Trample: excess damage over blocker toughness → defending player.\n367\t    - Lifelink: controller gains life equal to damage dealt.\n368\t    - Deathtouch: any damage is lethal (1 damage = lethal assignment).\n369\t    - Unblocked attackers deal damage to defending player.\n370\t\n371\t    Parameters:\n372\t        game: The current game state.\n373\t    \"\"\"\n374\t    from engine.state_based_actions import resolve_state_based_actions\n375\t\n376\t    combat = game.combat_state\n377\t\n378\t    if not combat.attackers:\n379\t        return\n380\t\n381\t    all_attackers = list(combat.attackers.keys())\n382\t\n383\t    # Determine if a first-strike damage sub-step is needed\n384\t    # Check both attackers and blockers for first strike / double strike\n385\t    all_blockers = set()\n386\t    for blocker_list in combat.attacker_blockers.values():\n387\t        all_blockers.update(blocker_list)\n388\t\n389\t    has_first_strike_step = any(\n390\t        Keyword.FIRST_STRIKE in getattr(c, \"keywords\", Keyword(0))\n391\t        or Keyword.DOUBLE_STRIKE in getattr(c, \"keywords\", Keyword(0))\n392\t        for c in list(all_attackers) + list(all_blockers)\n393\t    )\n394\t\n395\t    # --- First strike damage sub-step ---\n396\t    if has_first_strike_step:\n397\t        _assign_combat_damage(all_attackers, combat, game, is_first_strike=True)\n398\t        resolve_state_based_actions(game)\n399\t\n400\t    # --- Normal damage sub-step ---\n401\t    _assign_combat_damage(all_attackers, combat, game, is_first_strike=False)\n402\t    resolve_state_based_actions(game)\n403\t\n404\t\n405\tdef _assign_combat_damage(\n406\t    attackers: list[Any],\n407\t    combat: CombatState,\n408\t    game: GameState,\n409\t    *,\n410\t    is_first_strike: bool = False,\n411\t) -> None:\n412\t    \"\"\"Assign and deal combat damage for a set of attackers.\n413\t\n414\t    For each attacker:\n415\t    - If unblocked → damage to defending player.\n416\t    - If blocked → damage assigned to blockers in order.  With trample,\n417\t      excess damage goes to the defending player.\n418\t    - Blockers deal damage back to the attacker they block.\n419\t\n420\t    When *is_first_strike* is ``True``, only creatures with\n421\t    ``FIRST_STRIKE`` or ``DOUBLE_STRIKE`` deal damage (both attackers\n422\t    and blockers).  When ``False``, only creatures *without*\n423\t    ``FIRST_STRIKE`` deal damage (plus ``DOUBLE_STRIKE`` creatures,\n424\t    which participate in both steps).  Blockers that are no longer on\n425\t    the battlefield (e.g. killed by first-strike damage and removed by\n426\t    SBAs) are skipped.\n427\t    \"\"\"\n428\t    from engine.types import Zone\n429\t\n430\t    # Track which blockers have already dealt their damage this sub-step\n431\t    # (blockers only deal damage once even if blocking multiple attackers)\n432\t    blockers_dealt: set[int] = set()\n433\t\n434\t    for attacker in attackers:\n435\t        if attacker not in combat.attackers:\n436\t            continue\n437\t\n438\t        kw = getattr(attacker, \"keywords\", Keyword(0))\n439\t        has_first = Keyword.FIRST_STRIKE in kw\n440\t        has_double = Keyword.DOUBLE_STRIKE in kw\n441\t\n442\t        # Determine if this attacker deals damage in this sub-step\n443\t        if is_first_strike:\n444\t            attacker_deals = has_first or has_double\n445\t        else:\n446\t            attacker_deals = not has_first or has_double\n447\t\n448\t        # Skip if attacker is no longer on the battlefield\n449\t        if attacker_deals:\n450\t            controller = getattr(attacker, \"controller\", None)\n451\t            if controller is not None:\n452\t                bf = controller.zones[Zone.BATTLEFIELD]\n453\t                if not bf.contains(attacker):\n454\t                    attacker_deals = False\n455\t\n456\t        defending_player = combat.attackers[attacker]\n457\t        blocker_list = combat.attacker_blockers.get(attacker, [])\n458\t        attacker_kw = getattr(attacker, \"keywords\", Keyword(0))\n459\t\n460\t        if attacker_deals:\n461\t            power = getattr(attacker, \"power\", 0)\n462\t\n463\t            # Check if attacker was blocked.  Per MTG rule 509.1h, a blocked\n464\t            # creature stays blocked even if all its blockers are removed.\n465\t            is_blocked = attacker in combat.was_blocked\n466\t\n467\t            if not is_blocked and not blocker_list:\n468\t                # Truly unblocked → damage to defending player\n469\t                _deal_damage(attacker, defending_player, power, game, combat)\n470\t            elif is_blocked and not blocker_list:\n471\t                # Was blocked but all blockers removed.\n472\t                # Without trample: deals no damage.\n473\t                # With trample: all damage tramples to defending player.\n474\t                has_trample = Keyword.TRAMPLE in attacker_kw\n475\t                if has_trample:\n476\t                    _deal_damage(attacker, defending_player, power, game, combat)\n477\t                # else: no damage dealt\n478\t            else:\n479\t                # Blocked → assign damage to blockers in order\n480\t                has_trample = Keyword.TRAMPLE in attacker_kw\n481\t                remaining_damage = power\n482\t\n483\t                for i, blocker in enumerate(blocker_list):\n484\t                    if remaining_damage <= 0:\n485\t                        break\n486\t\n487\t                    lethal = _get_lethal_damage(blocker, attacker)\n488\t\n489\t                    if i < len(blocker_list) - 1:\n490\t                        # Not the last blocker — assign lethal damage\n491\t                        assign = min(lethal, remaining_damage)\n492\t                    else:\n493\t                        # Last blocker\n494\t                        if has_trample:\n495\t                            # With trample: assign lethal, rest tramples through\n496\t                            assign = min(lethal, remaining_damage)\n497\t                        else:\n498\t                            # Without trample: all remaining damage to last blocker\n499\t                            assign = remaining_damage\n500\t\n501\t                    _deal_damage(attacker, blocker, assign, game, combat)\n502\t                    remaining_damage -= assign\n503\t\n504\t                # Trample: excess damage to defending player\n505\t                if has_trample and remaining_damage > 0:\n506\t                    _deal_damage(attacker, defending_player, remaining_damage, game, combat)\n507\t\n508\t        # Blockers deal damage back to the attacker\n509\t        for blocker in blocker_list:\n510\t            if id(blocker) not in blockers_dealt:\n511\t                blocker_kw = getattr(blocker, \"keywords\", Keyword(0))\n512\t                blocker_has_first = Keyword.FIRST_STRIKE in blocker_kw\n513\t                blocker_has_double = Keyword.DOUBLE_STRIKE in blocker_kw\n514\t\n515\t                # Determine if this blocker deals damage in this sub-step\n516\t                if is_first_strike:\n517\t                    should_deal = blocker_has_first or blocker_has_double\n518\t                else:\n519\t                    should_deal = not blocker_has_first or blocker_has_double\n520\t\n521\t                # Skip if blocker is no longer on the battlefield\n522\t                if should_deal:\n523\t                    blocker_ctrl = getattr(blocker, \"controller\", None)\n524\t                    if blocker_ctrl is not None:\n525\t                        bf = blocker_ctrl.zones[Zone.BATTLEFIELD]\n526\t                        if not bf.contains(blocker):\n527\t                            should_deal = False\n528\t\n529\t                if should_deal:\n530\t                    blocker_power = getattr(blocker, \"power\", 0)\n531\t                    _deal_damage(blocker, attacker, blocker_power, game, combat)\n532\t                    blockers_dealt.add(id(blocker))\n533\t\n534\t\n535\tdef end_combat_step(game: GameState) -> None:\n536\t    \"\"\"End combat step: remove from combat and clear combat state.\n537\t\n538\t    Resets ``is_attacking`` and ``is_blocking`` flags on all creatures\n539\t    and clears the combat state.\n540\t\n541\t    Parameters:\n542\t        game: The current game state.\n543\t    \"\"\"\n544\t    combat = game.combat_state\n545\t\n546\t    # Clear combat flags on all attackers\n547\t    for attacker in combat.attackers:\n548\t        if hasattr(attacker, \"is_attacking\"):\n549\t            attacker.is_attacking = False\n550\t\n551\t    # Clear combat flags on all blockers\n552\t    for blocker in combat.blockers:\n553\t        if hasattr(blocker, \"is_blocking\"):\n554\t            blocker.is_blocking = False\n555\t\n556\t    combat.clear()\n557\t"}]},"parent_tool_use_id":null,"session_id":"f8a3aed6-12f8-4341-9631-2336f98abe5d","uuid":"0f2944c9-b467-48be-b07b-353df6d78591","timestamp":"2026-06-04T05:43:45.635Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/combat.py","content":"\"\"\"Combat system: declare attackers → declare blockers → damage → end combat.\n\nImplements the four substeps of the MTG combat phase:\n\n1. **Declare Attackers** — Active player chooses creatures to attack with.\n   Attackers are tapped (unless they have vigilance).  Creatures with\n   summoning sickness (without haste) or the defender keyword cannot attack.\n\n2. **Declare Blockers** — Defending player assigns blockers.  Creatures\n   with flying can only be blocked by creatures with flying or reach.\n   Creatures with menace require 2+ blockers.  The attacker's controller\n   orders the blockers for damage assignment.\n\n3. **Combat Damage** — First strike / double strike creatures deal damage\n   first, then state-based actions are checked, then normal damage.\n   Trample excess goes to the defending player.  Lifelink heals the\n   controller.  Deathtouch makes any nonzero damage lethal.  Unblocked\n   attackers deal damage to the defending player.\n\n4. **End Combat** — Clear all combat state.\n\nReferences: MTG Comprehensive Rules §506–§511.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.types import Keyword\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n# ---------------------------------------------------------------------------\n# CombatState — tracks all per-combat information\n# ---------------------------------------------------------------------------\n\n@dataclass\nclass CombatState:\n    \"\"\"Tracks attackers, blockers, damage assignments, and block ordering.\n\n    Attributes:\n        attackers: Mapping of attacking creature → defending player.\n        blockers: Mapping of blocking creature → list of attackers it blocks.\n        attacker_blockers: Mapping of attacking creature → ordered list of\n            blockers assigned to it (order used for damage assignment).\n        damage_assignments: Mapping of creature → list of\n            ``(target, amount)`` tuples describing how damage is assigned.\n        was_blocked: Set of attackers that were declared as blocked.  Per\n            MTG rule 509.1h, once a creature is blocked it stays blocked\n            even if all its blockers are removed before damage.\n        in_combat: Whether the combat phase is currently active.\n    \"\"\"\n\n    attackers: dict[Any, Player] = field(default_factory=dict)\n    blockers: dict[Any, list[Any]] = field(default_factory=dict)\n    attacker_blockers: dict[Any, list[Any]] = field(default_factory=dict)\n    damage_assignments: dict[Any, list[tuple[Any, int]]] = field(default_factory=dict)\n    was_blocked: set[Any] = field(default_factory=set)\n    in_combat: bool = False\n\n    def clear(self) -> None:\n        \"\"\"Reset all combat state.\"\"\"\n        self.attackers.clear()\n        self.blockers.clear()\n        self.attacker_blockers.clear()\n        self.damage_assignments.clear()\n        self.was_blocked.clear()\n        self.in_combat = False\n\n\n# ---------------------------------------------------------------------------\n# Helpers\n# ---------------------------------------------------------------------------\n\ndef _can_attack(creature: Any) -> bool:\n    \"\"\"Return ``True`` if *creature* is eligible to be declared as an attacker.\n\n    A creature cannot attack if:\n    - It is already tapped.\n    - It has the ``DEFENDER`` keyword.\n    - It has summoning sickness (``summoning_sick``) and does not have ``HASTE``.\n    - A continuous effect has set ``_cant_attack`` (e.g. Pacifism).\n    \"\"\"\n    if getattr(creature, \"is_tapped\", False):\n        return False\n\n    # Check for \"can't attack\" restriction (set by continuous effects like Pacifism)\n    if getattr(creature, \"_cant_attack\", False):\n        return False\n\n    keywords = getattr(creature, \"keywords\", Keyword(0))\n\n    if Keyword.DEFENDER in keywords:\n        return False\n\n    if getattr(creature, \"summoning_sick\", False) and Keyword.HASTE not in keywords:\n        return False\n\n    return True\n\n\ndef _can_block(blocker: Any, attacker: Any) -> bool:\n    \"\"\"Return ``True`` if *blocker* can legally block *attacker*.\n\n    Checks:\n    - If the blocker is tapped it cannot block.\n    - A continuous effect has set ``_cant_block`` (e.g. Pacifism).\n    - If the attacker has flying, the blocker must have flying or reach.\n    \"\"\"\n    if getattr(blocker, \"is_tapped\", False):\n        return False\n\n    # Check for \"can't block\" restriction (set by continuous effects like Pacifism)\n    if getattr(blocker, \"_cant_block\", False):\n        return False\n\n    attacker_kw = getattr(attacker, \"keywords\", Keyword(0))\n    blocker_kw = getattr(blocker, \"keywords\", Keyword(0))\n\n    # Flying check\n    if Keyword.FLYING in attacker_kw:\n        if Keyword.FLYING not in blocker_kw and Keyword.REACH not in blocker_kw:\n            return False\n\n    # Protection check — attacker with protection from blocker can't be blocked\n    from engine.protection import has_protection_from\n\n    if has_protection_from(attacker, blocker):\n        return False\n\n    return True\n\n\ndef _get_lethal_damage(creature: Any, attacker: Any | None = None) -> int:\n    \"\"\"Return the amount of damage needed to lethally assign to *creature*.\n\n    If *attacker* has deathtouch, 1 damage is lethal.\n    Otherwise it's ``toughness - damage_marked`` (at least 1).\n    \"\"\"\n    if attacker is not None:\n        attacker_kw = getattr(attacker, \"keywords\", Keyword(0))\n        if Keyword.DEATHTOUCH in attacker_kw:\n            return 1\n\n    toughness = getattr(creature, \"toughness\", 0)\n    damage_marked = getattr(creature, \"damage_marked\", 0)\n    return max(1, toughness - damage_marked)\n\n\ndef _deal_damage(\n    source: Any,\n    target: Any,\n    amount: int,\n    game: GameState,\n    combat_state: CombatState,\n) -> None:\n    \"\"\"Apply *amount* damage from *source* to *target*.\n\n    If *target* is a player, reduces life.\n    If *target* is a creature, marks damage on it.\n    If *source* has lifelink, the controller gains that much life.\n\n    Protection prevents damage from sources with the protected-from quality.\n    \"\"\"\n    if amount <= 0:\n        return\n\n    # Protection prevents damage (D in DEBT).\n    from engine.protection import has_protection_from\n\n    if has_protection_from(target, source):\n        return\n\n    # Record damage assignment\n    if source not in combat_state.damage_assignments:\n        combat_state.damage_assignments[source] = []\n    combat_state.damage_assignments[source].append((target, amount))\n\n    # Apply damage\n    if hasattr(target, \"life\"):\n        # Target is a player\n        target.life -= amount\n    elif hasattr(target, \"damage_marked\"):\n        # Target is a creature\n        target.damage_marked += amount\n\n        # Track deathtouch damage for SBA rule 704.5h\n        source_kw_dt = getattr(source, \"keywords\", Keyword(0))\n        if Keyword.DEATHTOUCH in source_kw_dt:\n            target.dealt_deathtouch_damage = True\n\n    # Lifelink: controller gains life equal to damage dealt\n    source_kw = getattr(source, \"keywords\", Keyword(0))\n    if Keyword.LIFELINK in source_kw:\n        controller = getattr(source, \"controller\", None)\n        if controller is not None and hasattr(controller, \"life\"):\n            controller.life += amount\n\n\n# ---------------------------------------------------------------------------\n# Combat steps\n# ---------------------------------------------------------------------------\n\ndef declare_attackers_step(game: GameState) -> None:\n    \"\"\"Declare attackers step: active player chooses creatures to attack with.\n\n    The active player is asked (via :meth:`Player.choose`) to select a set\n    of creatures to attack with.  Each chosen attacker is tapped (unless it\n    has vigilance) and its ``is_attacking`` flag is set.\n\n    Parameters:\n        game: The current game state.  ``game.combat_state`` must exist.\n    \"\"\"\n    combat = game.combat_state\n    combat.in_combat = True\n    active = game.active_player\n    defending = game.non_active_player\n\n    # Gather legal attackers from the active player's battlefield\n    from engine.types import Zone\n    bf = active.zones[Zone.BATTLEFIELD]\n    eligible = [\n        c for c in bf.get_all()\n        if hasattr(c, \"base_power\") and _can_attack(c)\n    ]\n\n    if not eligible:\n        return\n\n    # Active player chooses which creatures to attack with\n    chosen = active.choose(eligible, \"declare attackers\")\n\n    # Normalize to a list\n    if chosen is None:\n        return\n    if not isinstance(chosen, list):\n        chosen = [chosen]\n\n    # Validate and register attackers\n    for attacker in chosen:\n        if attacker not in eligible:\n            continue\n        if not _can_attack(attacker):\n            continue\n\n        combat.attackers[attacker] = defending\n        combat.attacker_blockers[attacker] = []\n        attacker.is_attacking = True\n\n        # Tap the attacker unless it has vigilance\n        kw = getattr(attacker, \"keywords\", Keyword(0))\n        if Keyword.VIGILANCE not in kw:\n            attacker.is_tapped = True\n\n\ndef declare_blockers_step(game: GameState) -> None:\n    \"\"\"Declare blockers step: defending player assigns blockers.\n\n    The defending player is asked (via :meth:`Player.choose`) to assign\n    blockers.  The expected format is a dict mapping blocker → attacker\n    (or blocker → list of attackers for multi-blocking scenarios), but\n    commonly blocker → attacker.\n\n    After blockers are assigned:\n    - Menace check: attackers with menace must be blocked by 2+ creatures.\n    - Flying/reach check is already handled by ``_can_block``.\n    - The attacking player orders blockers for each attacker (for damage\n      assignment).\n\n    Parameters:\n        game: The current game state.\n    \"\"\"\n    combat = game.combat_state\n\n    if not combat.attackers:\n        return\n\n    defending = game.non_active_player\n    active = game.active_player\n\n    from engine.types import Zone\n    bf_defending = defending.zones[Zone.BATTLEFIELD]\n    eligible_blockers = [\n        c for c in bf_defending.get_all()\n        if hasattr(c, \"base_power\") and not getattr(c, \"is_tapped\", False)\n    ]\n\n    if not eligible_blockers:\n        return\n\n    # Defending player chooses block assignments\n    # Expected format: dict mapping blocker → attacker (or list of attackers)\n    block_assignments = defending.choose(\n        eligible_blockers,\n        \"declare blockers\",\n    )\n\n    if block_assignments is None:\n        return\n\n    if not isinstance(block_assignments, dict):\n        return\n\n    # Process block assignments\n    for blocker, target in block_assignments.items():\n        # Validate that the blocker is in the eligible set\n        if blocker not in eligible_blockers:\n            continue\n        targets = target if isinstance(target, list) else [target]\n        valid_targets = []\n        max_blocked = getattr(blocker, \"_max_attackers_blocked\", 1)\n        for attacker in targets:\n            if len(valid_targets) >= max_blocked:\n                break\n            if attacker in combat.attackers and _can_block(blocker, attacker):\n                valid_targets.append(attacker)\n        if valid_targets:\n            combat.blockers[blocker] = valid_targets\n            blocker.is_blocking = True\n            for attacker in valid_targets:\n                if attacker not in combat.attacker_blockers:\n                    combat.attacker_blockers[attacker] = []\n                combat.attacker_blockers[attacker].append(blocker)\n\n    # Menace check: attackers with menace that have fewer than 2 blockers\n    # are treated as unblocked (remove the single blocker assignment).\n    for attacker, blocker_list in list(combat.attacker_blockers.items()):\n        kw = getattr(attacker, \"keywords\", Keyword(0))\n        if Keyword.MENACE in kw and len(blocker_list) < 2 and len(blocker_list) > 0:\n            # Illegal block — remove these blockers\n            for b in blocker_list:\n                if b in combat.blockers:\n                    combat.blockers[b] = [\n                        a for a in combat.blockers[b] if a is not attacker\n                    ]\n                    if not combat.blockers[b]:\n                        del combat.blockers[b]\n                        b.is_blocking = False\n            combat.attacker_blockers[attacker] = []\n\n    # Mark attackers that have at least one blocker as \"was_blocked\".\n    # Per MTG rule 509.1h, once a creature is blocked it remains blocked\n    # even if all its blockers are removed before the damage step.\n    for attacker, blocker_list in combat.attacker_blockers.items():\n        if blocker_list:\n            combat.was_blocked.add(attacker)\n\n    # Controller of each attacker orders the blockers for damage assignment\n    for attacker, blocker_list in combat.attacker_blockers.items():\n        if len(blocker_list) > 1:\n            controller = getattr(attacker, \"controller\", active)\n            ordered = controller.assign_damage_order(blocker_list)\n            combat.attacker_blockers[attacker] = ordered\n\n\ndef combat_damage_step(game: GameState) -> None:\n    \"\"\"Combat damage step: deal combat damage.\n\n    Handles:\n    - First strike / double strike creatures deal damage first.\n    - State-based actions are checked between first-strike and normal damage.\n    - Trample: excess damage over blocker toughness → defending player.\n    - Lifelink: controller gains life equal to damage dealt.\n    - Deathtouch: any damage is lethal (1 damage = lethal assignment).\n    - Unblocked attackers deal damage to defending player.\n\n    Parameters:\n        game: The current game state.\n    \"\"\"\n    from engine.state_based_actions import resolve_state_based_actions\n\n    combat = game.combat_state\n\n    if not combat.attackers:\n        return\n\n    all_attackers = list(combat.attackers.keys())\n\n    # Determine if a first-strike damage sub-step is needed\n    # Check both attackers and blockers for first strike / double strike\n    all_blockers = set()\n    for blocker_list in combat.attacker_blockers.values():\n        all_blockers.update(blocker_list)\n\n    has_first_strike_step = any(\n        Keyword.FIRST_STRIKE in getattr(c, \"keywords\", Keyword(0))\n        or Keyword.DOUBLE_STRIKE in getattr(c, \"keywords\", Keyword(0))\n        for c in list(all_attackers) + list(all_blockers)\n    )\n\n    # --- First strike damage sub-step ---\n    if has_first_strike_step:\n        _assign_combat_damage(all_attackers, combat, game, is_first_strike=True)\n        resolve_state_based_actions(game)\n\n    # --- Normal damage sub-step ---\n    _assign_combat_damage(all_attackers, combat, game, is_first_strike=False)\n    resolve_state_based_actions(game)\n\n\ndef _assign_combat_damage(\n    attackers: list[Any],\n    combat: CombatState,\n    game: GameState,\n    *,\n    is_first_strike: bool = False,\n) -> None:\n    \"\"\"Assign and deal combat damage for a set of attackers.\n\n    For each attacker:\n    - If unblocked → damage to defending player.\n    - If blocked → damage assigned to blockers in order.  With trample,\n      excess damage goes to the defending player.\n    - Blockers deal damage back to the attacker they block.\n\n    When *is_first_strike* is ``True``, only creatures with\n    ``FIRST_STRIKE`` or ``DOUBLE_STRIKE`` deal damage (both attackers\n    and blockers).  When ``False``, only creatures *without*\n    ``FIRST_STRIKE`` deal damage (plus ``DOUBLE_STRIKE`` creatures,\n    which participate in both steps).  Blockers that are no longer on\n    the battlefield (e.g. killed by first-strike damage and removed by\n    SBAs) are skipped.\n    \"\"\"\n    from engine.types import Zone\n\n    # Track which blockers have already dealt their damage this sub-step\n    # (blockers only deal damage once even if blocking multiple attackers)\n    blockers_dealt: set[int] = set()\n\n    for attacker in attackers:\n        if attacker not in combat.attackers:\n            continue\n\n        kw = getattr(attacker, \"keywords\", Keyword(0))\n        has_first = Keyword.FIRST_STRIKE in kw\n        has_double = Keyword.DOUBLE_STRIKE in kw\n\n        # Determine if this attacker deals damage in this sub-step\n        if is_first_strike:\n            attacker_deals = has_first or has_double\n        else:\n            attacker_deals = not has_first or has_double\n\n        # Skip if attacker is no longer on the battlefield\n        if attacker_deals:\n            controller = getattr(attacker, \"controller\", None)\n            if controller is not None:\n                bf = controller.zones[Zone.BATTLEFIELD]\n                if not bf.contains(attacker):\n                    attacker_deals = False\n\n        defending_player = combat.attackers[attacker]\n        blocker_list = combat.attacker_blockers.get(attacker, [])\n        attacker_kw = getattr(attacker, \"keywords\", Keyword(0))\n\n        if attacker_deals:\n            power = getattr(attacker, \"power\", 0)\n\n            # Check if attacker was blocked.  Per MTG rule 509.1h, a blocked\n            # creature stays blocked even if all its blockers are removed.\n            is_blocked = attacker in combat.was_blocked\n\n            if not is_blocked and not blocker_list:\n                # Truly unblocked → damage to defending player\n                _deal_damage(attacker, defending_player, power, game, combat)\n            elif is_blocked and not blocker_list:\n                # Was blocked but all blockers removed.\n                # Without trample: deals no damage.\n                # With trample: all damage tramples to defending player.\n                has_trample = Keyword.TRAMPLE in attacker_kw\n                if has_trample:\n                    _deal_damage(attacker, defending_player, power, game, combat)\n                # else: no damage dealt\n            else:\n                # Blocked → assign damage to blockers in order\n                has_trample = Keyword.TRAMPLE in attacker_kw\n                remaining_damage = power\n\n                for i, blocker in enumerate(blocker_list):\n                    if remaining_damage <= 0:\n                        break\n\n                    lethal = _get_lethal_damage(blocker, attacker)\n\n                    if i < len(blocker_list) - 1:\n                        # Not the last blocker — assign lethal damage\n                        assign = min(lethal, remaining_damage)\n                    else:\n                        # Last blocker\n                        if has_trample:\n                            # With trample: assign lethal, rest tramples through\n                            assign = min(lethal, remaining_damage)\n                        else:\n                            # Without trample: all remaining damage to last blocker\n                            assign = remaining_damage\n\n                    _deal_damage(attacker, blocker, assign, game, combat)\n                    remaining_damage -= assign\n\n                # Trample: excess damage to defending player\n                if has_trample and remaining_damage > 0:\n                    _deal_damage(attacker, defending_player, remaining_damage, game, combat)\n\n        # Blockers deal damage back to the attacker\n        for blocker in blocker_list:\n            if id(blocker) not in blockers_dealt:\n                blocker_kw = getattr(blocker, \"keywords\", Keyword(0))\n                blocker_has_first = Keyword.FIRST_STRIKE in blocker_kw\n                blocker_has_double = Keyword.DOUBLE_STRIKE in blocker_kw\n\n                # Determine if this blocker deals damage in this sub-step\n                if is_first_strike:\n                    should_deal = blocker_has_first or blocker_has_double\n                else:\n                    should_deal = not blocker_has_first or blocker_has_double\n\n                # Skip if blocker is no longer on the battlefield\n                if should_deal:\n                    blocker_ctrl = getattr(blocker, \"controller\", None)\n                    if blocker_ctrl is not None:\n                        bf = blocker_ctrl.zones[Zone.BATTLEFIELD]\n                        if not bf.contains(blocker):\n                            should_deal = False\n\n                if should_deal:\n                    blocker_power = getattr(blocker, \"power\", 0)\n                    _deal_damage(blocker, attacker, blocker_power, game, combat)\n                    blockers_dealt.add(id(blocker))\n\n\ndef end_combat_step(game: GameState) -> None:\n    \"\"\"End combat step: remove from combat and clear combat state.\n\n    Resets ``is_attacking`` and ``is_blocking`` flags on all creatures\n    and clears the combat state.\n\n    Parameters:\n        game: The current game state.\n    \"\"\"\n    combat = game.combat_state\n\n    # Clear combat flags on all attackers\n    for attacker in combat.attackers:\n        if hasattr(attacker, \"is_attacking\"):\n            attacker.is_attacking = False\n\n    # Clear combat flags on all blockers\n    for blocker in combat.blockers:\n        if hasattr(blocker, \"is_blocking\"):\n            blocker.is_blocking = False\n\n    combat.clear()\n","numLines":557,"startLine":1,"totalLines":557}}}
