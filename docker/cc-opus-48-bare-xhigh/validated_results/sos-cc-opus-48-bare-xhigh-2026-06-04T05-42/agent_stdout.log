{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018uL9Tpkz4YM2dVuvdULfxy","type":"tool_result","content":"136\t# ------------------------------------------------------------------\n137\t\n138\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n139\t    \"\"\"Cast *card* from *player*'s hand.\n140\t\n141\t    Pipeline\n142\t    --------\n143\t    1. **Timing check** — instants (and cards with flash) can be cast\n144\t       whenever the player has priority; everything else requires\n145\t       sorcery-speed timing.\n146\t    2. **can_cast** — ask the card whether it can legally be cast.\n147\t    3. **Hand check** — the card must be in the player's hand.\n148\t    4. **Move hand → stack zone** — remove the card from the hand and\n149\t       place it into the player's stack zone.\n150\t    5. **Choose targets** — if the card specifies targets (via\n151\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n152\t    6. **Mana check / payment** — the player's mana pool must be able to\n153\t       pay the card's mana cost.  If payment fails, the card is rolled\n154\t       back from the stack zone to the hand.\n155\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n156\t    8. **Push StackObject** — push a :class:`StackObject` whose\n157\t       ``on_resolve`` callback handles resolution.\n158\t\n159\t    Raises:\n160\t        CastingError: If any legality check fails.\n161\t    \"\"\"\n162\t    # 1. Timing\n163\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n164\t        raise CastingError(\n165\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n166\t        )\n167\t\n168\t    # 2. can_cast\n169\t    if not card.can_cast(game):\n170\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n171\t\n172\t    # 3. Hand check\n173\t    hand = game.get_hand(player)\n174\t    if not hand.contains(card):\n175\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n176\t\n177\t    # 4. Move card from hand to stack zone\n178\t    stack_zone = player.zones[Zone.STACK]\n179\t    hand.remove(card)\n180\t    stack_zone.add(card)\n181\t\n182\t    # Clear any stale colors_spent from a prior cast before new payment.\n183\t    if hasattr(card, \"colors_spent\"):\n184\t        del card.colors_spent\n185\t\n186\t    # 5. Choose targets\n187\t    target_specs = card.get_targets(game)\n188\t    chosen_targets: list[Any] = []\n189\t    if target_specs:\n190\t        for spec in target_specs:\n191\t            target = player.choose_target(target_specs, spec)\n192\t            # Validate against filter_fn if the spec provides one\n193\t            filter_fn = getattr(spec, \"filter_fn\", None)\n194\t            if filter_fn is not None and target is not None:\n195\t                if not filter_fn(target):\n196\t                    stack_zone.remove(card)\n197\t                    hand.add(card)\n198\t                    raise CastingError(\n199\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n200\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n201\t                    )\n202\t            chosen_targets.append(target)\n203\t\n204\t    # 5b. Protection check — reject targets that have protection from this\n205\t    #     spell (the T in DEBT).\n206\t    from engine.protection import has_protection_from\n207\t\n208\t    for target in chosen_targets:\n209\t        if has_protection_from(target, card):\n210\t            # Rollback: move card from stack zone back to hand\n211\t            stack_zone.remove(card)\n212\t            hand.add(card)\n213\t            raise CastingError(\n214\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n215\t            )\n216\t\n217\t    # Targets are stored on the StackObject (not the card) and passed\n218\t    # through the resolve pipeline via on_resolve(game, targets=...).\n219\t\n220\t    # 6. Mana check / payment (rollback on failure)\n221\t    # Ensure the card knows its controller so that cost_reduction() hooks\n222\t    # (e.g. Embercleave counting attacking creatures you control) see the\n223\t    # casting player, even for cards that were added to hand without an\n224\t    # explicit controller assignment.\n225\t    if card.controller is None:\n226\t        card.controller = player\n227\t    reduction = get_cost_reduction(game, card, player)\n228\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n229\t\n230\t    if not player.mana_pool.can_pay(effective_cost):\n231\t        # Rollback: move card from stack zone back to hand\n232\t        stack_zone.remove(card)\n233\t        hand.add(card)\n234\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n235\t\n236\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n237\t    pool_total_before = player.mana_pool.total()\n238\t    player.mana_pool.pay(effective_cost)\n239\t\n240\t    # Store colors of mana spent on the card for mechanics like Converge\n241\t    # that care about the colors used to cast the spell.\n242\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n243\t    # Record the total quantity of mana spent to cast this spell (for\n244\t    # mechanics like Mana Sculpt that care about mana spent, not colors).\n245\t    card.mana_spent = pool_total_before - player.mana_pool.total()  # type: ignore[attr-defined]\n246\t\n247\t    # 7. Call on_cast hook\n248\t    card.on_cast(game)\n249\t\n250\t    # 8. Build on_resolve callback and push StackObject\n251\t    stack_obj = StackObject(\n252\t        source=card,\n253\t        controller=player,\n254\t        targets=chosen_targets,\n255\t        on_resolve=lambda g: None,  # replaced below\n256\t    )\n257\t\n258\t    def _on_resolve(g: GameState) -> None:\n259\t        _resolve_spell(g, card, player, stack_obj)\n260\t\n261\t    stack_obj.on_resolve = _on_resolve\n262\t    game.stack.push(stack_obj)\n263\t\n264\t    # 9. Fire the spell-cast event so triggered abilities (e.g. casualty,\n265\t    #    prowess-like triggers) that watch for cast spells can respond.\n266\t    from engine.events import SpellCastTriggeredEvent\n267\t\n268\t    game.trigger_manager.fire_event(\n269\t        game,\n270\t        SpellCastTriggeredEvent(\n271\t            spell=stack_obj, player=player, card=card, controller=player\n272\t        ),\n273\t    )\n274\t\n275\t\n276\t# ------------------------------------------------------------------\n277\t# Cast spell without paying mana cost (free-cast from any zone)\n278\t# ------------------------------------------------------------------\n279\t\n280\t\n281\tdef cast_spell_free(\n282\t    game: GameState,\n283\t    player: Player,\n284\t    card: CardImpl,\n285\t    from_zone: Zone,\n286\t) -> None:\n287\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n288\t\n289\t    This is used by effects that allow casting from zones other than hand\n290\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n291\t    or cascade.\n292\t\n293\t    Pipeline\n294\t    --------\n295\t    1. **can_cast** — ask the card whether it can legally be cast (same\n296\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n297\t    2. Move *card* from *from_zone* to the stack zone.\n298\t    3. Choose targets (if applicable) with validation and protection check.\n299\t    4. Call ``on_cast`` hook.\n300\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n301\t       resolution normally (permanents → battlefield, non-permanents →\n302\t       graveyard).\n303\t\n304\t    No timing check or mana payment is performed.  The spell goes on the\n305\t    stack and can be responded to normally (e.g. countered).\n306\t\n307\t    If targeting or other post-move checks fail, the card is rolled back\n308\t    to its source zone.\n309\t\n310\t    Parameters:\n311\t        game: The current game state.\n312\t        player: The player casting the spell.\n313\t        card: The card to cast.\n314\t        from_zone: The zone the card is currently in.\n315\t\n316\t    Raises:\n317\t        CastingError: If the card cannot be found in *from_zone* or\n318\t            legality checks fail.\n319\t    \"\"\"\n320\t    from engine.zones import move_to_zone\n321\t\n322\t    # Ensure controller is set\n323\t    card.controller = player\n324\t    if card.owner is None:\n325\t        card.owner = player\n326\t\n327\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n328\t    if not card.can_cast(game):\n329\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n330\t\n331\t    # 2. Locate card in source zone\n332\t    source_zone_container = player.zones[from_zone]\n333\t    if not source_zone_container.contains(card):\n334\t        # Try to find the card in any player's zone\n335\t        source_zone_container = None\n336\t        for p in game.players:\n337\t            z = p.zones[from_zone]\n338\t            if z.contains(card):\n339\t                source_zone_container = z\n340\t                break\n341\t\n342\t    if source_zone_container is None or not source_zone_container.contains(card):\n343\t        raise CastingError(\n344\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n345\t        )\n346\t\n347\t    # Move card from source zone to stack zone\n348\t    stack_zone = player.zones[Zone.STACK]\n349\t    source_zone_container.remove(card)\n350\t    stack_zone.add(card)\n351\t\n352\t    # 3. Choose targets (with rollback on failure)\n353\t    try:\n354\t        target_specs = card.get_targets(game)\n355\t        chosen_targets: list[Any] = []\n356\t        if target_specs:\n357\t            for spec in target_specs:\n358\t                target = player.choose_target(target_specs, spec)\n359\t                # Validate against filter_fn if the spec provides one\n360\t                filter_fn = getattr(spec, \"filter_fn\", None)\n361\t                if filter_fn is not None and target is not None:\n362\t                    if not filter_fn(target):\n363\t                        raise CastingError(\n364\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n365\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n366\t                        )\n367\t                chosen_targets.append(target)\n368\t\n369\t        # Protection check — reject targets that have protection from this spell\n370\t        from engine.protection import has_protection_from\n371\t\n372\t        for target in chosen_targets:\n373\t            if has_protection_from(target, card):\n374\t                raise CastingError(\n375\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n376\t                )\n377\t    except Exception as exc:\n378\t        # Rollback: move card from stack zone back to source zone\n379\t        stack_zone.remove(card)\n380\t        source_zone_container.add(card)\n381\t        raise CastingError(str(exc)) from exc\n382\t\n383\t    # 4. Call on_cast hook\n384\t    card.mana_spent = 0  # type: ignore[attr-defined]\n385\t    card.on_cast(game)\n386\t\n387\t    # 5. Build on_resolve callback and push StackObject\n388\t    stack_obj = StackObject(\n389\t        source=card,\n390\t        controller=player,\n391\t        targets=chosen_targets,\n392\t        on_resolve=lambda g: None,  # replaced below\n393\t    )\n394\t\n395\t    def _on_resolve(g: GameState) -> None:\n396\t        _resolve_spell(g, card, player, stack_obj)\n397\t\n398\t    stack_obj.on_resolve = _on_resolve\n399\t    game.stack.push(stack_obj)\n400\t\n401\t    # 6. Fire the spell-cast event so triggered abilities can respond.\n402\t    from engine.events import SpellCastTriggeredEvent\n403\t\n404\t    game.trigger_manager.fire_event(\n405\t        game,\n406\t        SpellCastTriggeredEvent(\n407\t            spell=stack_obj, player=player, card=card, controller=player\n408\t        ),\n409\t    )\n410\t\n411\t\n412\t# ------------------------------------------------------------------\n413\t# Resolution (called when the stack pops)\n414\t# ------------------------------------------------------------------\n415\t\n416\tdef _resolve_spell(\n417\t    game: GameState,\n418\t    card: CardImpl,\n419\t    player: Player,\n420\t    stack_obj: StackObject,\n421\t) -> None:\n422\t    \"\"\"Resolve *card* cast by *player*.\n423\t\n424\t    1. Call ``card.on_resolve(game, targets=targets)``.\n425\t    2. Remove the card from the stack zone.\n426\t    3. If the card is a permanent type, move it to the battlefield via\n427\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n428\t       registration and the ETB event).\n429\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n430\t    \"\"\"\n431\t    from engine.zones import move_to_zone\n432\t\n433\t    # Read targets from the StackObject — the single source of truth.\n434\t    # Set chosen_targets on the card just before resolution so that\n435\t    # _get_chosen_target helpers (which read via getattr) work.\n436\t    targets = stack_obj.targets\n437\t    if targets is not None:\n438\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n439\t\n440\t    card.on_resolve(game)\n441\t\n442\t    if card.card_types & _PERMANENT_TYPES:\n443\t        # Move from stack to battlefield via move_to_zone, which handles\n444\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n445\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n446\t    else:\n447\t        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n448\t        # Some effects (e.g. The Dawning Archaic casting a spell from your\n449\t        # graveyard) replace that graveyard move with exile.  The stack→\n450\t        # graveyard transition does not consult the replacement system, so\n451\t        # we honor an explicit per-card flag here.\n452\t        dest = (\n453\t            Zone.EXILE\n454\t            if getattr(card, \"_exile_instead_of_graveyard\", False)\n455\t            else Zone.GRAVEYARD\n456\t        )\n457\t        move_to_zone(game, card, Zone.STACK, dest)\n458\t\n459\t\n460\t# ------------------------------------------------------------------\n461\t# Play land (special action — does not use the stack)\n462\t# ------------------------------------------------------------------\n463\t\n464\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n465\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n466\t\n467\t    Requirements (all must hold):\n468\t\n469\t    * *land_card* has :attr:`CardType.LAND`.\n470\t    * *player* is the active player.\n471\t    * Current phase is a main phase.\n472\t    * The stack is empty.\n473\t    * ``player.land_plays_remaining > 0``.\n474\t    * The card is in the player's hand.\n475\t"}]},"parent_tool_use_id":null,"session_id":"f8a3aed6-12f8-4341-9631-2336f98abe5d","uuid":"4950bf98-cd67-432e-acab-76c6cc240a9c","timestamp":"2026-06-04T06:42:14.980Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/casting.py","content":"# ------------------------------------------------------------------\n\ndef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n    \"\"\"Cast *card* from *player*'s hand.\n\n    Pipeline\n    --------\n    1. **Timing check** — instants (and cards with flash) can be cast\n       whenever the player has priority; everything else requires\n       sorcery-speed timing.\n    2. **can_cast** — ask the card whether it can legally be cast.\n    3. **Hand check** — the card must be in the player's hand.\n    4. **Move hand → stack zone** — remove the card from the hand and\n       place it into the player's stack zone.\n    5. **Choose targets** — if the card specifies targets (via\n       :meth:`CardImpl.get_targets`), the player is asked to choose.\n    6. **Mana check / payment** — the player's mana pool must be able to\n       pay the card's mana cost.  If payment fails, the card is rolled\n       back from the stack zone to the hand.\n    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n    8. **Push StackObject** — push a :class:`StackObject` whose\n       ``on_resolve`` callback handles resolution.\n\n    Raises:\n        CastingError: If any legality check fails.\n    \"\"\"\n    # 1. Timing\n    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n        )\n\n    # 2. can_cast\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 3. Hand check\n    hand = game.get_hand(player)\n    if not hand.contains(card):\n        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n\n    # 4. Move card from hand to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    hand.remove(card)\n    stack_zone.add(card)\n\n    # Clear any stale colors_spent from a prior cast before new payment.\n    if hasattr(card, \"colors_spent\"):\n        del card.colors_spent\n\n    # 5. Choose targets\n    target_specs = card.get_targets(game)\n    chosen_targets: list[Any] = []\n    if target_specs:\n        for spec in target_specs:\n            target = player.choose_target(target_specs, spec)\n            # Validate against filter_fn if the spec provides one\n            filter_fn = getattr(spec, \"filter_fn\", None)\n            if filter_fn is not None and target is not None:\n                if not filter_fn(target):\n                    stack_zone.remove(card)\n                    hand.add(card)\n                    raise CastingError(\n                        f\"Cannot cast {card.name!r} — chosen target does not \"\n                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                    )\n            chosen_targets.append(target)\n\n    # 5b. Protection check — reject targets that have protection from this\n    #     spell (the T in DEBT).\n    from engine.protection import has_protection_from\n\n    for target in chosen_targets:\n        if has_protection_from(target, card):\n            # Rollback: move card from stack zone back to hand\n            stack_zone.remove(card)\n            hand.add(card)\n            raise CastingError(\n                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n            )\n\n    # Targets are stored on the StackObject (not the card) and passed\n    # through the resolve pipeline via on_resolve(game, targets=...).\n\n    # 6. Mana check / payment (rollback on failure)\n    # Ensure the card knows its controller so that cost_reduction() hooks\n    # (e.g. Embercleave counting attacking creatures you control) see the\n    # casting player, even for cards that were added to hand without an\n    # explicit controller assignment.\n    if card.controller is None:\n        card.controller = player\n    reduction = get_cost_reduction(game, card, player)\n    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n\n    if not player.mana_pool.can_pay(effective_cost):\n        # Rollback: move card from stack zone back to hand\n        stack_zone.remove(card)\n        hand.add(card)\n        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n\n    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n    pool_total_before = player.mana_pool.total()\n    player.mana_pool.pay(effective_cost)\n\n    # Store colors of mana spent on the card for mechanics like Converge\n    # that care about the colors used to cast the spell.\n    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n    # Record the total quantity of mana spent to cast this spell (for\n    # mechanics like Mana Sculpt that care about mana spent, not colors).\n    card.mana_spent = pool_total_before - player.mana_pool.total()  # type: ignore[attr-defined]\n\n    # 7. Call on_cast hook\n    card.on_cast(game)\n\n    # 8. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n    # 9. Fire the spell-cast event so triggered abilities (e.g. casualty,\n    #    prowess-like triggers) that watch for cast spells can respond.\n    from engine.events import SpellCastTriggeredEvent\n\n    game.trigger_manager.fire_event(\n        game,\n        SpellCastTriggeredEvent(\n            spell=stack_obj, player=player, card=card, controller=player\n        ),\n    )\n\n\n# ------------------------------------------------------------------\n# Cast spell without paying mana cost (free-cast from any zone)\n# ------------------------------------------------------------------\n\n\ndef cast_spell_free(\n    game: GameState,\n    player: Player,\n    card: CardImpl,\n    from_zone: Zone,\n) -> None:\n    \"\"\"Cast *card* without paying its mana cost, using the stack.\n\n    This is used by effects that allow casting from zones other than hand\n    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n    or cascade.\n\n    Pipeline\n    --------\n    1. **can_cast** — ask the card whether it can legally be cast (same\n       legality as :func:`cast_spell`, minus mana/timing constraints).\n    2. Move *card* from *from_zone* to the stack zone.\n    3. Choose targets (if applicable) with validation and protection check.\n    4. Call ``on_cast`` hook.\n    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n       resolution normally (permanents → battlefield, non-permanents →\n       graveyard).\n\n    No timing check or mana payment is performed.  The spell goes on the\n    stack and can be responded to normally (e.g. countered).\n\n    If targeting or other post-move checks fail, the card is rolled back\n    to its source zone.\n\n    Parameters:\n        game: The current game state.\n        player: The player casting the spell.\n        card: The card to cast.\n        from_zone: The zone the card is currently in.\n\n    Raises:\n        CastingError: If the card cannot be found in *from_zone* or\n            legality checks fail.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Ensure controller is set\n    card.controller = player\n    if card.owner is None:\n        card.owner = player\n\n    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n    if not card.can_cast(game):\n        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n\n    # 2. Locate card in source zone\n    source_zone_container = player.zones[from_zone]\n    if not source_zone_container.contains(card):\n        # Try to find the card in any player's zone\n        source_zone_container = None\n        for p in game.players:\n            z = p.zones[from_zone]\n            if z.contains(card):\n                source_zone_container = z\n                break\n\n    if source_zone_container is None or not source_zone_container.contains(card):\n        raise CastingError(\n            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n        )\n\n    # Move card from source zone to stack zone\n    stack_zone = player.zones[Zone.STACK]\n    source_zone_container.remove(card)\n    stack_zone.add(card)\n\n    # 3. Choose targets (with rollback on failure)\n    try:\n        target_specs = card.get_targets(game)\n        chosen_targets: list[Any] = []\n        if target_specs:\n            for spec in target_specs:\n                target = player.choose_target(target_specs, spec)\n                # Validate against filter_fn if the spec provides one\n                filter_fn = getattr(spec, \"filter_fn\", None)\n                if filter_fn is not None and target is not None:\n                    if not filter_fn(target):\n                        raise CastingError(\n                            f\"Cannot cast {card.name!r} — chosen target does not \"\n                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n                        )\n                chosen_targets.append(target)\n\n        # Protection check — reject targets that have protection from this spell\n        from engine.protection import has_protection_from\n\n        for target in chosen_targets:\n            if has_protection_from(target, card):\n                raise CastingError(\n                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n                )\n    except Exception as exc:\n        # Rollback: move card from stack zone back to source zone\n        stack_zone.remove(card)\n        source_zone_container.add(card)\n        raise CastingError(str(exc)) from exc\n\n    # 4. Call on_cast hook\n    card.mana_spent = 0  # type: ignore[attr-defined]\n    card.on_cast(game)\n\n    # 5. Build on_resolve callback and push StackObject\n    stack_obj = StackObject(\n        source=card,\n        controller=player,\n        targets=chosen_targets,\n        on_resolve=lambda g: None,  # replaced below\n    )\n\n    def _on_resolve(g: GameState) -> None:\n        _resolve_spell(g, card, player, stack_obj)\n\n    stack_obj.on_resolve = _on_resolve\n    game.stack.push(stack_obj)\n\n    # 6. Fire the spell-cast event so triggered abilities can respond.\n    from engine.events import SpellCastTriggeredEvent\n\n    game.trigger_manager.fire_event(\n        game,\n        SpellCastTriggeredEvent(\n            spell=stack_obj, player=player, card=card, controller=player\n        ),\n    )\n\n\n# ------------------------------------------------------------------\n# Resolution (called when the stack pops)\n# ------------------------------------------------------------------\n\ndef _resolve_spell(\n    game: GameState,\n    card: CardImpl,\n    player: Player,\n    stack_obj: StackObject,\n) -> None:\n    \"\"\"Resolve *card* cast by *player*.\n\n    1. Call ``card.on_resolve(game, targets=targets)``.\n    2. Remove the card from the stack zone.\n    3. If the card is a permanent type, move it to the battlefield via\n       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n       registration and the ETB event).\n    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n    \"\"\"\n    from engine.zones import move_to_zone\n\n    # Read targets from the StackObject — the single source of truth.\n    # Set chosen_targets on the card just before resolution so that\n    # _get_chosen_target helpers (which read via getattr) work.\n    targets = stack_obj.targets\n    if targets is not None:\n        card.chosen_targets = targets  # type: ignore[attr-defined]\n\n    card.on_resolve(game)\n\n    if card.card_types & _PERMANENT_TYPES:\n        # Move from stack to battlefield via move_to_zone, which handles\n        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n    else:\n        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n        # Some effects (e.g. The Dawning Archaic casting a spell from your\n        # graveyard) replace that graveyard move with exile.  The stack→\n        # graveyard transition does not consult the replacement system, so\n        # we honor an explicit per-card flag here.\n        dest = (\n            Zone.EXILE\n            if getattr(card, \"_exile_instead_of_graveyard\", False)\n            else Zone.GRAVEYARD\n        )\n        move_to_zone(game, card, Zone.STACK, dest)\n\n\n# ------------------------------------------------------------------\n# Play land (special action — does not use the stack)\n# ------------------------------------------------------------------\n\ndef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n\n    Requirements (all must hold):\n\n    * *land_card* has :attr:`CardType.LAND`.\n    * *player* is the active player.\n    * Current phase is a main phase.\n    * The stack is empty.\n    * ``player.land_plays_remaining > 0``.\n    * The card is in the player's hand.\n","numLines":340,"startLine":136,"totalLines":535}}}
