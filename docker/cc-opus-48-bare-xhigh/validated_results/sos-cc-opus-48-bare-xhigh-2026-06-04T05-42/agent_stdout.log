{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016QmeUaziyjitjAuiD4mPYq","type":"tool_result","content":"1\t\"\"\"Card implementation for Sower of Chaos.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\timport random\n5\tfrom typing import TYPE_CHECKING, Any\n6\tfrom engine.card import ActivatedAbility, ArtifactCreature, Creature, ManaAbility\n7\tfrom engine.types import CardType, Keyword, ManaCost, ManaType, Supertype, Zone\n8\tif TYPE_CHECKING:\n9\t    from engine.game_state import GameState\n10\t\n11\t    from cards.registry import CardRegistry\n12\t\n13\tclass SowerOfChaos(Creature):\n14\t    \"\"\"Sower of Chaos — {3}{R} — 4/3 — Devil\n15\t\n16\t    {2}{R}: Target creature can't block this turn.\n17\t\n18\t    FDN collector number 95.\n19\t    \"\"\"\n20\t\n21\t    def __init__(self, **kwargs: Any) -> None:\n22\t        kwargs.setdefault(\"name\", \"Sower of Chaos\")\n23\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{3}{R}\"))\n24\t        kwargs.setdefault(\"subtypes\", {\"Devil\"})\n25\t        kwargs.setdefault(\"base_power\", 4)\n26\t        kwargs.setdefault(\"base_toughness\", 3)\n27\t        kwargs.setdefault(\n28\t            \"rules_text\",\n29\t            \"{2}{R}: Target creature can't block this turn.\",\n30\t        )\n31\t        super().__init__(**kwargs)\n32\t\n33\t    def get_activated_abilities(self) -> list[ActivatedAbility]:\n34\t        source = self\n35\t\n36\t        def _cost(game: Any, src: Any) -> bool:\n37\t            controller = src.controller\n38\t            if controller is None:\n39\t                return False\n40\t            if controller.mana_pool.total() < 3:\n41\t                return False\n42\t            # Need at least 1 red\n43\t            if controller.mana_pool.get(ManaType.RED) < 1:\n44\t                return False\n45\t            controller.mana_pool.pay(ManaCost.parse(\"{2}{R}\"))\n46\t            return True\n47\t\n48\t        def _effect(game: Any) -> None:\n49\t            target = getattr(source, \"_current_target\", None)\n50\t            if target is not None:\n51\t                target._cant_block = True\n52\t\n53\t        return [ActivatedAbility(\n54\t            cost=_cost,\n55\t            effect=_effect,\n56\t            description=\"{2}{R}: Target creature can't block this turn.\",\n57\t        )]\n58\t"}]},"parent_tool_use_id":null,"session_id":"f8a3aed6-12f8-4341-9631-2336f98abe5d","uuid":"99853651-792b-4236-acd0-7f6cba01abce","timestamp":"2026-06-04T06:09:36.158Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/cards/fdn/fdn_95/card_impl.py","content":"\"\"\"Card implementation for Sower of Chaos.\"\"\"\n\nfrom __future__ import annotations\nimport random\nfrom typing import TYPE_CHECKING, Any\nfrom engine.card import ActivatedAbility, ArtifactCreature, Creature, ManaAbility\nfrom engine.types import CardType, Keyword, ManaCost, ManaType, Supertype, Zone\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\n    from cards.registry import CardRegistry\n\nclass SowerOfChaos(Creature):\n    \"\"\"Sower of Chaos — {3}{R} — 4/3 — Devil\n\n    {2}{R}: Target creature can't block this turn.\n\n    FDN collector number 95.\n    \"\"\"\n\n    def __init__(self, **kwargs: Any) -> None:\n        kwargs.setdefault(\"name\", \"Sower of Chaos\")\n        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{3}{R}\"))\n        kwargs.setdefault(\"subtypes\", {\"Devil\"})\n        kwargs.setdefault(\"base_power\", 4)\n        kwargs.setdefault(\"base_toughness\", 3)\n        kwargs.setdefault(\n            \"rules_text\",\n            \"{2}{R}: Target creature can't block this turn.\",\n        )\n        super().__init__(**kwargs)\n\n    def get_activated_abilities(self) -> list[ActivatedAbility]:\n        source = self\n\n        def _cost(game: Any, src: Any) -> bool:\n            controller = src.controller\n            if controller is None:\n                return False\n            if controller.mana_pool.total() < 3:\n                return False\n            # Need at least 1 red\n            if controller.mana_pool.get(ManaType.RED) < 1:\n                return False\n            controller.mana_pool.pay(ManaCost.parse(\"{2}{R}\"))\n            return True\n\n        def _effect(game: Any) -> None:\n            target = getattr(source, \"_current_target\", None)\n            if target is not None:\n                target._cant_block = True\n\n        return [ActivatedAbility(\n            cost=_cost,\n            effect=_effect,\n            description=\"{2}{R}: Target creature can't block this turn.\",\n        )]\n","numLines":58,"startLine":1,"totalLines":58}}}
