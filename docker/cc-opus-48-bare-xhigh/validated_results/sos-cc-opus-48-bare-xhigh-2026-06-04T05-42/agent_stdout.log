{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BZmTETJJD2R7ZBwgYob5Up","type":"tool_result","content":"1\t\"\"\"Typed event objects for triggered abilities and replacement effects.\n2\t\n3\tTriggered events are passed to :meth:`TriggerManager.fire_event` and\n4\tforwarded to trigger condition callables.\n5\t\n6\tReplacement events are passed to :meth:`ReplacementManager.apply` and\n7\tforwarded to replacement condition/replacement callables.  Subclassing\n8\tencodes event-type hierarchy so a replacement registered for a parent\n9\ttype (e.g. ``MoveToGraveyardReplacementEvent``) also fires for\n10\tsubtypes (e.g. ``CreatureDiesReplacementEvent``).\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\tfrom dataclasses import dataclass\n16\tfrom typing import Any\n17\t\n18\t\n19\t# ---------------------------------------------------------------------------\n20\t# Triggered events\n21\t# ---------------------------------------------------------------------------\n22\t\n23\t@dataclass\n24\tclass TriggeredEvent:\n25\t    \"\"\"Base class for all triggered-ability events.\"\"\"\n26\t\n27\t\n28\t@dataclass\n29\tclass EntersBattlefieldTriggeredEvent(TriggeredEvent):\n30\t    permanent: Any = None\n31\t    controller: Any = None\n32\t    card: Any = None\n33\t    creature: Any = None\n34\t\n35\t\n36\t@dataclass\n37\tclass LeavesBattlefieldTriggeredEvent(TriggeredEvent):\n38\t    permanent: Any = None\n39\t    controller: Any = None\n40\t\n41\t\n42\t@dataclass\n43\tclass DealsDamageTriggeredEvent(TriggeredEvent):\n44\t    source: Any = None\n45\t    target: Any = None\n46\t    amount: int = 0\n47\t    is_combat: bool = False\n48\t    combat: bool = False\n49\t\n50\t\n51\t@dataclass\n52\tclass LosesLifeTriggeredEvent(TriggeredEvent):\n53\t    player: Any = None\n54\t    amount: int = 0\n55\t\n56\t\n57\t@dataclass\n58\tclass GainsLifeTriggeredEvent(TriggeredEvent):\n59\t    player: Any = None\n60\t    amount: int = 0\n61\t\n62\t\n63\t@dataclass\n64\tclass DrawsCardTriggeredEvent(TriggeredEvent):\n65\t    player: Any = None\n66\t    card: Any = None\n67\t\n68\t\n69\t@dataclass\n70\tclass BeginningOfUpkeepTriggeredEvent(TriggeredEvent):\n71\t    pass\n72\t\n73\t\n74\t@dataclass\n75\tclass BeginningOfCombatTriggeredEvent(TriggeredEvent):\n76\t    pass\n77\t\n78\t\n79\t@dataclass\n80\tclass EndOfTurnTriggeredEvent(TriggeredEvent):\n81\t    pass\n82\t\n83\t\n84\t@dataclass\n85\tclass EndStepTriggeredEvent(TriggeredEvent):\n86\t    player: Any = None\n87\t\n88\t\n89\t@dataclass\n90\tclass MainPhaseBeganTriggeredEvent(TriggeredEvent):\n91\t    player: Any = None\n92\t\n93\t\n94\t@dataclass\n95\tclass CreatureDiesTriggeredEvent(TriggeredEvent):\n96\t    creature: Any = None\n97\t    controller: Any = None\n98\t    owner: Any = None\n99\t\n100\t\n101\t@dataclass\n102\tclass SpellCastTriggeredEvent(TriggeredEvent):\n103\t    spell: Any = None\n104\t    player: Any = None\n105\t    card: Any = None\n106\t    controller: Any = None\n107\t\n108\t\n109\t@dataclass\n110\tclass AttacksTriggeredEvent(TriggeredEvent):\n111\t    creature: Any = None\n112\t    attacker: Any = None\n113\t\n114\t\n115\t@dataclass\n116\tclass BlocksTriggeredEvent(TriggeredEvent):\n117\t    creature: Any = None\n118\t\n119\t\n120\t@dataclass\n121\tclass CounterAddedTriggeredEvent(TriggeredEvent):\n122\t    permanent: Any = None\n123\t    counter_type: Any = None\n124\t    amount: int = 0\n125\t\n126\t\n127\t# ---------------------------------------------------------------------------\n128\t# Replacement events\n129\t# ---------------------------------------------------------------------------\n130\t\n131\t@dataclass\n132\tclass ReplacementEvent:\n133\t    \"\"\"Base class for all replacement-effect events.\"\"\"\n134\t\n135\t\n136\t@dataclass\n137\tclass MoveToGraveyardReplacementEvent(ReplacementEvent):\n138\t    \"\"\"Any permanent moving to a graveyard.\n139\t\n140\t    Subclass this for specific causes (destruction, sacrifice, etc.).\n141\t    A replacement registered for this type also fires for all subtypes.\n142\t\n143\t    ``destination`` may be mutated by a replacement to redirect the\n144\t    permanent to a different zone (``\"exile\"``, ``\"library\"``, ``\"hand\"``).\n145\t    Set ``prevented = True`` to signal that the replacement handled the\n146\t    zone move itself and the engine should skip its own move.\n147\t    \"\"\"\n148\t\n149\t    destination: str = \"graveyard\"\n150\t    controller: Any = None\n151\t    owner: Any = None\n152\t    prevented: bool = False\n153\t\n154\t    @property\n155\t    def card(self) -> Any:\n156\t        \"\"\"The object moving to the graveyard (overridden by subclasses).\"\"\"\n157\t        return None\n158\t\n159\t\n160\t@dataclass\n161\tclass CreatureDiesReplacementEvent(MoveToGraveyardReplacementEvent):\n162\t    \"\"\"A creature going to the graveyard via destruction or lethal damage.\"\"\"\n163\t\n164\t    creature: Any = None\n165\t\n166\t    @property\n167\t    def card(self) -> Any:\n168\t        return self.creature\n169\t\n170\t\n171\t@dataclass\n172\tclass PermanentDestroyedReplacementEvent(MoveToGraveyardReplacementEvent):\n173\t    \"\"\"A non-creature permanent going to the graveyard via destruction.\"\"\"\n174\t\n175\t    permanent: Any = None\n176\t\n177\t    @property\n178\t    def card(self) -> Any:\n179\t        return self.permanent\n180\t\n181\t\n182\t@dataclass\n183\tclass SacrificeReplacementEvent(MoveToGraveyardReplacementEvent):\n184\t    \"\"\"A permanent going to the graveyard via sacrifice.\"\"\"\n185\t\n186\t    permanent: Any = None\n187\t\n188\t    @property\n189\t    def card(self) -> Any:\n190\t        return self.permanent\n191\t\n192\t\n193\t@dataclass\n194\tclass CreateTokenReplacementEvent(ReplacementEvent):\n195\t    \"\"\"An effect about to create one or more tokens.\"\"\"\n196\t\n197\t    player: Any = None\n198\t    count: int = 1\n199\t\n200\t\n201\t@dataclass\n202\tclass AddCounterReplacementEvent(ReplacementEvent):\n203\t    \"\"\"An effect about to add one or more counters to a permanent.\"\"\"\n204\t\n205\t    permanent: Any = None\n206\t    amount: int = 1\n207\t"}]},"parent_tool_use_id":null,"session_id":"f8a3aed6-12f8-4341-9631-2336f98abe5d","uuid":"4d29f78d-e490-40d9-b1d7-c9b39fa217ab","timestamp":"2026-06-04T06:56:53.689Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/events.py","content":"\"\"\"Typed event objects for triggered abilities and replacement effects.\n\nTriggered events are passed to :meth:`TriggerManager.fire_event` and\nforwarded to trigger condition callables.\n\nReplacement events are passed to :meth:`ReplacementManager.apply` and\nforwarded to replacement condition/replacement callables.  Subclassing\nencodes event-type hierarchy so a replacement registered for a parent\ntype (e.g. ``MoveToGraveyardReplacementEvent``) also fires for\nsubtypes (e.g. ``CreatureDiesReplacementEvent``).\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom typing import Any\n\n\n# ---------------------------------------------------------------------------\n# Triggered events\n# ---------------------------------------------------------------------------\n\n@dataclass\nclass TriggeredEvent:\n    \"\"\"Base class for all triggered-ability events.\"\"\"\n\n\n@dataclass\nclass EntersBattlefieldTriggeredEvent(TriggeredEvent):\n    permanent: Any = None\n    controller: Any = None\n    card: Any = None\n    creature: Any = None\n\n\n@dataclass\nclass LeavesBattlefieldTriggeredEvent(TriggeredEvent):\n    permanent: Any = None\n    controller: Any = None\n\n\n@dataclass\nclass DealsDamageTriggeredEvent(TriggeredEvent):\n    source: Any = None\n    target: Any = None\n    amount: int = 0\n    is_combat: bool = False\n    combat: bool = False\n\n\n@dataclass\nclass LosesLifeTriggeredEvent(TriggeredEvent):\n    player: Any = None\n    amount: int = 0\n\n\n@dataclass\nclass GainsLifeTriggeredEvent(TriggeredEvent):\n    player: Any = None\n    amount: int = 0\n\n\n@dataclass\nclass DrawsCardTriggeredEvent(TriggeredEvent):\n    player: Any = None\n    card: Any = None\n\n\n@dataclass\nclass BeginningOfUpkeepTriggeredEvent(TriggeredEvent):\n    pass\n\n\n@dataclass\nclass BeginningOfCombatTriggeredEvent(TriggeredEvent):\n    pass\n\n\n@dataclass\nclass EndOfTurnTriggeredEvent(TriggeredEvent):\n    pass\n\n\n@dataclass\nclass EndStepTriggeredEvent(TriggeredEvent):\n    player: Any = None\n\n\n@dataclass\nclass MainPhaseBeganTriggeredEvent(TriggeredEvent):\n    player: Any = None\n\n\n@dataclass\nclass CreatureDiesTriggeredEvent(TriggeredEvent):\n    creature: Any = None\n    controller: Any = None\n    owner: Any = None\n\n\n@dataclass\nclass SpellCastTriggeredEvent(TriggeredEvent):\n    spell: Any = None\n    player: Any = None\n    card: Any = None\n    controller: Any = None\n\n\n@dataclass\nclass AttacksTriggeredEvent(TriggeredEvent):\n    creature: Any = None\n    attacker: Any = None\n\n\n@dataclass\nclass BlocksTriggeredEvent(TriggeredEvent):\n    creature: Any = None\n\n\n@dataclass\nclass CounterAddedTriggeredEvent(TriggeredEvent):\n    permanent: Any = None\n    counter_type: Any = None\n    amount: int = 0\n\n\n# ---------------------------------------------------------------------------\n# Replacement events\n# ---------------------------------------------------------------------------\n\n@dataclass\nclass ReplacementEvent:\n    \"\"\"Base class for all replacement-effect events.\"\"\"\n\n\n@dataclass\nclass MoveToGraveyardReplacementEvent(ReplacementEvent):\n    \"\"\"Any permanent moving to a graveyard.\n\n    Subclass this for specific causes (destruction, sacrifice, etc.).\n    A replacement registered for this type also fires for all subtypes.\n\n    ``destination`` may be mutated by a replacement to redirect the\n    permanent to a different zone (``\"exile\"``, ``\"library\"``, ``\"hand\"``).\n    Set ``prevented = True`` to signal that the replacement handled the\n    zone move itself and the engine should skip its own move.\n    \"\"\"\n\n    destination: str = \"graveyard\"\n    controller: Any = None\n    owner: Any = None\n    prevented: bool = False\n\n    @property\n    def card(self) -> Any:\n        \"\"\"The object moving to the graveyard (overridden by subclasses).\"\"\"\n        return None\n\n\n@dataclass\nclass CreatureDiesReplacementEvent(MoveToGraveyardReplacementEvent):\n    \"\"\"A creature going to the graveyard via destruction or lethal damage.\"\"\"\n\n    creature: Any = None\n\n    @property\n    def card(self) -> Any:\n        return self.creature\n\n\n@dataclass\nclass PermanentDestroyedReplacementEvent(MoveToGraveyardReplacementEvent):\n    \"\"\"A non-creature permanent going to the graveyard via destruction.\"\"\"\n\n    permanent: Any = None\n\n    @property\n    def card(self) -> Any:\n        return self.permanent\n\n\n@dataclass\nclass SacrificeReplacementEvent(MoveToGraveyardReplacementEvent):\n    \"\"\"A permanent going to the graveyard via sacrifice.\"\"\"\n\n    permanent: Any = None\n\n    @property\n    def card(self) -> Any:\n        return self.permanent\n\n\n@dataclass\nclass CreateTokenReplacementEvent(ReplacementEvent):\n    \"\"\"An effect about to create one or more tokens.\"\"\"\n\n    player: Any = None\n    count: int = 1\n\n\n@dataclass\nclass AddCounterReplacementEvent(ReplacementEvent):\n    \"\"\"An effect about to add one or more counters to a permanent.\"\"\"\n\n    permanent: Any = None\n    amount: int = 1\n","numLines":207,"startLine":1,"totalLines":207}}}
