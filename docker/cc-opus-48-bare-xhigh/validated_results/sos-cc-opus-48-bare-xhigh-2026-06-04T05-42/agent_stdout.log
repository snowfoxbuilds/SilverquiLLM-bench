f __init__(self, **kwargs):\n34-        kwargs.setdefault(\"name\", 'The Dawning Archaic')\n35-        kwargs.setdefault(\"mana_cost\", ManaCost.parse('{10}'))\n36-        kwargs.setdefault(\"card_types\", {CardType.CREATURE})\n37-        kwargs.setdefault(\"subtypes\", {'Avatar'})\n38-        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n39-        kwargs.setdefault(\"base_power\", 7)\n40-        kwargs.setdefault(\"base_toughness\", 7)\n41-        super().__init__(**kwargs)\n42-\n43-\n44-class RancorousArchaic(Creature):\n45-    \"\"\"Stub for Rancorous Archaic.\"\"\"\n--\n179:class EmeritusOfTruceSwordsToPlowshares(Creature):\n180-    \"\"\"Stub for Emeritus of Truce // Swords to Plowshares.\"\"\"\n181-\n182-    def __init__(self, **kwargs):\n183-        kwargs.setdefault(\"name\", 'Emeritus of Truce // Swords to Plowshares')\n184-        kwargs.setdefault(\"mana_cost\", ManaCost.parse('{1}{W}{W}'))\n185-        kwargs.setdefault(\"card_types\", {CardType.CREATURE})\n186-        kwargs.setdefault(\"subtypes\", {'Cat', 'Cleric'})\n187-        kwargs.setdefault(\"base_power\", 3)\n188-        kwargs.setdefault(\"base_toughness\", 3)\n189-        super().__init__(**kwargs)\n190-        self.colors = ['W']\n191-\n192-\n193-class EnnisDebateModerator(Creature):\n194-    \"\"\"Stub for Ennis, Debate Moderator.\"\"\"\n--\n1249:class RalZarekGuestLecturer(Planeswalker):\n1250-    \"\"\"Stub for Ral Zarek, Guest Lecturer.\"\"\"\n1251-\n1252-    def __init__(self, **kwargs):\n1253-        kwargs.setdefault(\"name\", 'Ral Zarek, Guest Lecturer')\n1254-        kwargs.setdefault(\"mana_cost\", ManaCost.parse('{1}{B}{B}'))\n1255-        kwargs.setdefault(\"card_types\", {CardType.PLANESWALKER})\n1256-        kwargs.setdefault(\"subtypes\", {'Ral'})\n1257-        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n1258-        kwargs.setdefault(\"starting_loyalty\", 3)\n1259-        super().__init__(**kwargs)\n1260-        self.colors = ['B']\n1261-\n1262-\n1263-class ScathingShadelockVenomousWords(Creature):\n1264-    \"\"\"Stub for Scathing Shadelock // Venomous Words.\"\"\"\n--\n1538:class ImprovisationCapstone(Sorcery):\n1539-    \"\"\"Stub for Improvisation Capstone.\"\"\"\n1540-\n1541-    def __init__(self, **kwargs):\n1542-        kwargs.setdefault(\"name\", 'Improvisation Capstone')\n1543-        kwargs.setdefault(\"mana_cost\", ManaCost.parse('{5}{R}{R}'))\n1544-        kwargs.setdefault(\"card_types\", {CardType.SORCERY})\n1545-        kwargs.setdefault(\"subtypes\", {'Lesson'})\n1546-        super().__init__(**kwargs)\n1547-        self.colors = ['R']\n1548-\n1549-\n1550-class LivingHistory(Enchantment):\n1551-    \"\"\"Stub for Living History.\"\"\"\n1552-\n1553-    def __init__(self, **kwargs):\n--\n3284:class GreatHallOfTheBiblioplex(Land):\n3285-    \"\"\"Stub for Great Hall of the Biblioplex.\"\"\"\n3286-\n3287-    def __init__(self, **kwargs):\n3288-        kwargs.setdefault(\"name\", 'Great Hall of the Biblioplex')\n3289-        kwargs.setdefault(\"mana_cost\", ManaCost())\n3290-        kwargs.setdefault(\"card_types\", {CardType.LAND})\n3291-        super().__init__(**kwargs)\n3292-\n3293-\n3294-class ParadoxGardens(Land):\n3295-    \"\"\"Stub for Paradox Gardens.\"\"\"\n3296-\n3297-    def __init__(self, **kwargs):\n3298-        kwargs.setdefault(\"name\", 'Paradox Gardens')\n3299-        kwargs.setdefault(\"mana_cost\", ManaCost())","numLines":84}}
