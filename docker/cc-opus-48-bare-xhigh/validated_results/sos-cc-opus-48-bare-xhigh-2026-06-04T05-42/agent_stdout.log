{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KipaxuRzzN439YGhWFxWL6","type":"tool_result","content":"1\t\"\"\"Activated abilities system — tap-for-mana, loyalty abilities, and general\n2\tactivated abilities that go on the stack (or resolve immediately for mana\n3\tabilities).\n4\t\n5\tProvides:\n6\t\n7\t- :func:`activate_ability` — verify timing → pay costs → resolve immediately\n8\t  (mana abilities) or push to the stack (non-mana abilities).\n9\t- :func:`tap_cost` — generic tap-cost helper: checks ``not source.is_tapped``\n10\t  and taps the source.\n11\t- :class:`ActivatedAbilityInstance` — a runtime representation of an activated\n12\t  ability with source, controller, cost/effect callables, and metadata.\n13\t- :class:`LoyaltyAbilityInstance` — activated ability variant for planeswalker\n14\t  loyalty abilities with per-turn restriction and loyalty-counter cost.\n15\t\"\"\"\n16\t\n17\tfrom __future__ import annotations\n18\t\n19\tfrom dataclasses import dataclass, field\n20\tfrom typing import TYPE_CHECKING, Any, Callable\n21\t\n22\tfrom engine.casting import is_sorcery_speed\n23\tfrom engine.stack import StackObject\n24\t\n25\tif TYPE_CHECKING:\n26\t    from engine.game_state import GameState\n27\t    from engine.player import Player\n28\t\n29\t\n30\tclass AbilityError(Exception):\n31\t    \"\"\"Raised when an ability activation is illegal.\"\"\"\n32\t\n33\t\n34\t# ---------------------------------------------------------------------------\n35\t# Runtime ability representations\n36\t# ---------------------------------------------------------------------------\n37\t\n38\t@dataclass\n39\tclass ActivatedAbilityInstance:\n40\t    \"\"\"Runtime representation of an activated ability.\n41\t\n42\t    This captures everything needed to activate and resolve an ability:\n43\t    the source permanent, the controlling player, cost/effect callables,\n44\t    and whether the ability is a mana ability.\n45\t\n46\t    Attributes:\n47\t        source: The permanent that has this ability.\n48\t        controller: The player who controls the source.\n49\t        cost: A callable ``(game, source) -> bool`` that checks and pays\n50\t            the cost. Returns ``True`` if the cost was successfully paid,\n51\t            ``False`` otherwise.\n52\t        effect: A callable ``(game) -> None`` that applies the ability's\n53\t            effect when it resolves.\n54\t        is_mana_ability: Whether this is a mana ability (resolves\n55\t            immediately without using the stack).\n56\t        description: Human-readable description of the ability.\n57\t    \"\"\"\n58\t\n59\t    source: Any\n60\t    controller: Any  # Player\n61\t    cost: Callable[..., bool]\n62\t    effect: Callable[..., None]\n63\t    is_mana_ability: bool = False\n64\t    description: str = \"\"\n65\t\n66\t\n67\t@dataclass\n68\tclass LoyaltyAbilityInstance:\n69\t    \"\"\"Runtime representation of a planeswalker loyalty ability.\n70\t\n71\t    Loyalty abilities are activated abilities with special restrictions:\n72\t    they may only be activated at sorcery speed, and only once per turn\n73\t    per source (tracked via ``_activated_this_turn``).\n74\t\n75\t    The cost adjusts the loyalty counters on the source planeswalker.\n76\t\n77\t    Attributes:\n78\t        source: The planeswalker permanent.\n79\t        controller: The player who controls the planeswalker.\n80\t        loyalty_cost: The loyalty adjustment (positive for ``+N``,\n81\t            negative for ``−N``, zero for ``0``).\n82\t        effect: A callable ``(game) -> None`` for the ability's effect.\n83\t        description: Human-readable description.\n84\t    \"\"\"\n85\t\n86\t    source: Any\n87\t    controller: Any  # Player\n88\t    loyalty_cost: int = 0\n89\t    effect: Callable[..., None] = field(default=lambda _game: None)\n90\t    description: str = \"\"\n91\t\n92\t\n93\t# ---------------------------------------------------------------------------\n94\t# Per-turn loyalty tracking\n95\t# ---------------------------------------------------------------------------\n96\t\n97\t# Set of (object_id, turn_number) pairs that have already activated a\n98\t# loyalty ability this turn.  Callers should call\n99\t# ``clear_loyalty_tracking()`` at the start of each turn or manage the\n100\t# set externally.\n101\t_loyalty_activated_this_turn: set[tuple[int, int]] = set()\n102\t\n103\t\n104\tdef clear_loyalty_tracking() -> None:\n105\t    \"\"\"Clear the loyalty-activated-this-turn tracker.\n106\t\n107\t    Should be called at the start of each turn so that planeswalkers may\n108\t    activate loyalty abilities again.\n109\t    \"\"\"\n110\t    _loyalty_activated_this_turn.clear()\n111\t\n112\t\n113\tdef _has_activated_loyalty_this_turn(source: Any, turn_number: int) -> bool:\n114\t    \"\"\"Return ``True`` if *source* already used a loyalty ability this turn.\"\"\"\n115\t    obj_id = getattr(source, \"object_id\", id(source))\n116\t    return (obj_id, turn_number) in _loyalty_activated_this_turn\n117\t\n118\t\n119\tdef _mark_loyalty_activated(source: Any, turn_number: int) -> None:\n120\t    \"\"\"Record that *source* used a loyalty ability this turn.\"\"\"\n121\t    obj_id = getattr(source, \"object_id\", id(source))\n122\t    _loyalty_activated_this_turn.add((obj_id, turn_number))\n123\t\n124\t\n125\t# ---------------------------------------------------------------------------\n126\t# Tap cost helper\n127\t# ---------------------------------------------------------------------------\n128\t\n129\tdef tap_cost(game: GameState, source: Any) -> bool:\n130\t    \"\"\"Generic tap-cost function.\n131\t\n132\t    Checks that the source is not already tapped.  If untapped, taps it\n133\t    (sets ``source.is_tapped = True``) and returns ``True``.  If already\n134\t    tapped, returns ``False`` (cost cannot be paid).\n135\t\n136\t    Parameters:\n137\t        game: The current game state (unused here but kept for a\n138\t            consistent ``(game, source) -> bool`` cost signature).\n139\t        source: The permanent to tap.\n140\t\n141\t    Returns:\n142\t        ``True`` if the cost was successfully paid (source was untapped\n143\t        and is now tapped), ``False`` otherwise.\n144\t    \"\"\"\n145\t    if getattr(source, \"is_tapped\", False):\n146\t        return False\n147\t    source.is_tapped = True\n148\t    return True\n149\t\n150\t\n151\t# ---------------------------------------------------------------------------\n152\t# Activate ability — main entry point\n153\t# ---------------------------------------------------------------------------\n154\t\n155\tdef activate_ability(\n156\t    game: GameState,\n157\t    player: Any,  # Player\n158\t    ability: ActivatedAbilityInstance | LoyaltyAbilityInstance,\n159\t) -> None:\n160\t    \"\"\"Activate an ability.\n161\t\n162\t    Pipeline\n163\t    --------\n164\t    1. **Timing check** — mana abilities bypass timing entirely and\n165\t       resolve immediately.  Regular (non-mana) activated abilities\n166\t       can be activated whenever a player has priority (instant speed);\n167\t       priority enforcement is handled externally by\n168\t       ``priority_loop``, not here.  **Only loyalty abilities** carry\n169\t       a sorcery-speed restriction.\n170\t    2. **Pay costs** — invoke the ability's cost callable.  For loyalty\n171\t       abilities, adjust loyalty counters and enforce once-per-turn.\n172\t    3. **Resolve or push to stack** — mana abilities resolve\n173\t       immediately; all other abilities are pushed onto the game stack\n174\t       as :class:`StackObject` instances.\n175\t\n176\t    Parameters:\n177\t        game: The current game state.\n178\t        player: The player activating the ability.\n179\t        ability: The ability to activate (an\n180\t            :class:`ActivatedAbilityInstance` or\n181\t            :class:`LoyaltyAbilityInstance`).\n182\t\n183\t    Raises:\n184\t        AbilityError: If the activation is illegal (timing, cost, or\n185\t            once-per-turn restriction).\n186\t    \"\"\"\n187\t    if isinstance(ability, LoyaltyAbilityInstance):\n188\t        _activate_loyalty_ability(game, player, ability)\n189\t    elif isinstance(ability, ActivatedAbilityInstance):\n190\t        _activate_regular_ability(game, player, ability)\n191\t    else:\n192\t        raise AbilityError(f\"Unknown ability type: {type(ability)}\")\n193\t\n194\t\n195\t# ---------------------------------------------------------------------------\n196\t# Internal helpers\n197\t# ---------------------------------------------------------------------------\n198\t\n199\tdef _activate_regular_ability(\n200\t    game: GameState,\n201\t    player: Any,\n202\t    ability: ActivatedAbilityInstance,\n203\t) -> None:\n204\t    \"\"\"Activate a regular (non-loyalty) activated ability.\"\"\"\n205\t    # 1. Check \"can't activate\" restriction (e.g. Arrest).\n206\t    if getattr(ability.source, \"_cant_activate\", False):\n207\t        raise AbilityError(\n208\t            \"Cannot activate ability — source's activated abilities are suppressed\"\n209\t        )\n210\t\n211\t    # 2. Pay costs\n212\t    cost_paid = ability.cost(game, ability.source)\n213\t    if not cost_paid:\n214\t        raise AbilityError(\"Cannot activate ability — cost could not be paid\")\n215\t\n216\t    # 3. Resolve or push\n217\t    if ability.is_mana_ability:\n218\t        # Mana abilities resolve immediately without using the stack.\n219\t        ability.effect(game)\n220\t    else:\n221\t        # Push to stack for resolution.\n222\t        stack_obj = StackObject(\n223\t            source=ability.source,\n224\t            controller=player,\n225\t            on_resolve=ability.effect,\n226\t            is_mana_ability=False,\n227\t        )\n228\t        game.stack.push(stack_obj)\n229\t\n230\t\n231\tdef _activate_loyalty_ability(\n232\t    game: GameState,\n233\t    player: Any,\n234\t    ability: LoyaltyAbilityInstance,\n235\t) -> None:\n236\t    \"\"\"Activate a planeswalker loyalty ability.\"\"\"\n237\t    source = ability.source\n238\t\n239\t    # 1. Timing — loyalty abilities are sorcery speed only.\n240\t    if not is_sorcery_speed(game, player):\n241\t        raise AbilityError(\n242\t            \"Cannot activate loyalty ability — sorcery-speed timing not met\"\n243\t        )\n244\t\n245\t    # 2. Once-per-turn restriction.\n246\t    turn_number = getattr(game, \"turn_number\", 0)\n247\t    if _has_activated_loyalty_this_turn(source, turn_number):\n248\t        raise AbilityError(\n249\t            \"Cannot activate loyalty ability — already activated this turn\"\n250\t        )\n251\t\n252\t    # 3. Pay loyalty cost.\n253\t    current_loyalty = getattr(source, \"loyalty\", 0)\n254\t    new_loyalty = current_loyalty + ability.loyalty_cost\n255\t    if new_loyalty < 0:\n256\t        raise AbilityError(\n257\t            f\"Cannot activate loyalty ability — insufficient loyalty \"\n258\t            f\"(have {current_loyalty}, need {-ability.loyalty_cost})\"\n259\t        )\n260\t    source.loyalty = new_loyalty\n261\t\n262\t    # 4. Mark as activated this turn.\n263\t    _mark_loyalty_activated(source, turn_number)\n264\t\n265\t    # 5. Push to stack.\n266\t    stack_obj = StackObject(\n267\t        source=source,\n268\t        controller=player,\n269\t        on_resolve=ability.effect,\n270\t        is_mana_ability=False,\n271\t    )\n272\t    game.stack.push(stack_obj)\n273\t"}]},"parent_tool_use_id":null,"session_id":"f8a3aed6-12f8-4341-9631-2336f98abe5d","uuid":"5e369f1c-df3e-4f22-a972-e3c231d6e59b","timestamp":"2026-06-04T05:47:35.743Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/abilities.py","content":"\"\"\"Activated abilities system — tap-for-mana, loyalty abilities, and general\nactivated abilities that go on the stack (or resolve immediately for mana\nabilities).\n\nProvides:\n\n- :func:`activate_ability` — verify timing → pay costs → resolve immediately\n  (mana abilities) or push to the stack (non-mana abilities).\n- :func:`tap_cost` — generic tap-cost helper: checks ``not source.is_tapped``\n  and taps the source.\n- :class:`ActivatedAbilityInstance` — a runtime representation of an activated\n  ability with source, controller, cost/effect callables, and metadata.\n- :class:`LoyaltyAbilityInstance` — activated ability variant for planeswalker\n  loyalty abilities with per-turn restriction and loyalty-counter cost.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom typing import TYPE_CHECKING, Any, Callable\n\nfrom engine.casting import is_sorcery_speed\nfrom engine.stack import StackObject\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\nclass AbilityError(Exception):\n    \"\"\"Raised when an ability activation is illegal.\"\"\"\n\n\n# ---------------------------------------------------------------------------\n# Runtime ability representations\n# ---------------------------------------------------------------------------\n\n@dataclass\nclass ActivatedAbilityInstance:\n    \"\"\"Runtime representation of an activated ability.\n\n    This captures everything needed to activate and resolve an ability:\n    the source permanent, the controlling player, cost/effect callables,\n    and whether the ability is a mana ability.\n\n    Attributes:\n        source: The permanent that has this ability.\n        controller: The player who controls the source.\n        cost: A callable ``(game, source) -> bool`` that checks and pays\n            the cost. Returns ``True`` if the cost was successfully paid,\n            ``False`` otherwise.\n        effect: A callable ``(game) -> None`` that applies the ability's\n            effect when it resolves.\n        is_mana_ability: Whether this is a mana ability (resolves\n            immediately without using the stack).\n        description: Human-readable description of the ability.\n    \"\"\"\n\n    source: Any\n    controller: Any  # Player\n    cost: Callable[..., bool]\n    effect: Callable[..., None]\n    is_mana_ability: bool = False\n    description: str = \"\"\n\n\n@dataclass\nclass LoyaltyAbilityInstance:\n    \"\"\"Runtime representation of a planeswalker loyalty ability.\n\n    Loyalty abilities are activated abilities with special restrictions:\n    they may only be activated at sorcery speed, and only once per turn\n    per source (tracked via ``_activated_this_turn``).\n\n    The cost adjusts the loyalty counters on the source planeswalker.\n\n    Attributes:\n        source: The planeswalker permanent.\n        controller: The player who controls the planeswalker.\n        loyalty_cost: The loyalty adjustment (positive for ``+N``,\n            negative for ``−N``, zero for ``0``).\n        effect: A callable ``(game) -> None`` for the ability's effect.\n        description: Human-readable description.\n    \"\"\"\n\n    source: Any\n    controller: Any  # Player\n    loyalty_cost: int = 0\n    effect: Callable[..., None] = field(default=lambda _game: None)\n    description: str = \"\"\n\n\n# ---------------------------------------------------------------------------\n# Per-turn loyalty tracking\n# ---------------------------------------------------------------------------\n\n# Set of (object_id, turn_number) pairs that have already activated a\n# loyalty ability this turn.  Callers should call\n# ``clear_loyalty_tracking()`` at the start of each turn or manage the\n# set externally.\n_loyalty_activated_this_turn: set[tuple[int, int]] = set()\n\n\ndef clear_loyalty_tracking() -> None:\n    \"\"\"Clear the loyalty-activated-this-turn tracker.\n\n    Should be called at the start of each turn so that planeswalkers may\n    activate loyalty abilities again.\n    \"\"\"\n    _loyalty_activated_this_turn.clear()\n\n\ndef _has_activated_loyalty_this_turn(source: Any, turn_number: int) -> bool:\n    \"\"\"Return ``True`` if *source* already used a loyalty ability this turn.\"\"\"\n    obj_id = getattr(source, \"object_id\", id(source))\n    return (obj_id, turn_number) in _loyalty_activated_this_turn\n\n\ndef _mark_loyalty_activated(source: Any, turn_number: int) -> None:\n    \"\"\"Record that *source* used a loyalty ability this turn.\"\"\"\n    obj_id = getattr(source, \"object_id\", id(source))\n    _loyalty_activated_this_turn.add((obj_id, turn_number))\n\n\n# ---------------------------------------------------------------------------\n# Tap cost helper\n# ---------------------------------------------------------------------------\n\ndef tap_cost(game: GameState, source: Any) -> bool:\n    \"\"\"Generic tap-cost function.\n\n    Checks that the source is not already tapped.  If untapped, taps it\n    (sets ``source.is_tapped = True``) and returns ``True``.  If already\n    tapped, returns ``False`` (cost cannot be paid).\n\n    Parameters:\n        game: The current game state (unused here but kept for a\n            consistent ``(game, source) -> bool`` cost signature).\n        source: The permanent to tap.\n\n    Returns:\n        ``True`` if the cost was successfully paid (source was untapped\n        and is now tapped), ``False`` otherwise.\n    \"\"\"\n    if getattr(source, \"is_tapped\", False):\n        return False\n    source.is_tapped = True\n    return True\n\n\n# ---------------------------------------------------------------------------\n# Activate ability — main entry point\n# ---------------------------------------------------------------------------\n\ndef activate_ability(\n    game: GameState,\n    player: Any,  # Player\n    ability: ActivatedAbilityInstance | LoyaltyAbilityInstance,\n) -> None:\n    \"\"\"Activate an ability.\n\n    Pipeline\n    --------\n    1. **Timing check** — mana abilities bypass timing entirely and\n       resolve immediately.  Regular (non-mana) activated abilities\n       can be activated whenever a player has priority (instant speed);\n       priority enforcement is handled externally by\n       ``priority_loop``, not here.  **Only loyalty abilities** carry\n       a sorcery-speed restriction.\n    2. **Pay costs** — invoke the ability's cost callable.  For loyalty\n       abilities, adjust loyalty counters and enforce once-per-turn.\n    3. **Resolve or push to stack** — mana abilities resolve\n       immediately; all other abilities are pushed onto the game stack\n       as :class:`StackObject` instances.\n\n    Parameters:\n        game: The current game state.\n        player: The player activating the ability.\n        ability: The ability to activate (an\n            :class:`ActivatedAbilityInstance` or\n            :class:`LoyaltyAbilityInstance`).\n\n    Raises:\n        AbilityError: If the activation is illegal (timing, cost, or\n            once-per-turn restriction).\n    \"\"\"\n    if isinstance(ability, LoyaltyAbilityInstance):\n        _activate_loyalty_ability(game, player, ability)\n    elif isinstance(ability, ActivatedAbilityInstance):\n        _activate_regular_ability(game, player, ability)\n    else:\n        raise AbilityError(f\"Unknown ability type: {type(ability)}\")\n\n\n# ---------------------------------------------------------------------------\n# Internal helpers\n# ---------------------------------------------------------------------------\n\ndef _activate_regular_ability(\n    game: GameState,\n    player: Any,\n    ability: ActivatedAbilityInstance,\n) -> None:\n    \"\"\"Activate a regular (non-loyalty) activated ability.\"\"\"\n    # 1. Check \"can't activate\" restriction (e.g. Arrest).\n    if getattr(ability.source, \"_cant_activate\", False):\n        raise AbilityError(\n            \"Cannot activate ability — source's activated abilities are suppressed\"\n        )\n\n    # 2. Pay costs\n    cost_paid = ability.cost(game, ability.source)\n    if not cost_paid:\n        raise AbilityError(\"Cannot activate ability — cost could not be paid\")\n\n    # 3. Resolve or push\n    if ability.is_mana_ability:\n        # Mana abilities resolve immediately without using the stack.\n        ability.effect(game)\n    else:\n        # Push to stack for resolution.\n        stack_obj = StackObject(\n            source=ability.source,\n            controller=player,\n            on_resolve=ability.effect,\n            is_mana_ability=False,\n        )\n        game.stack.push(stack_obj)\n\n\ndef _activate_loyalty_ability(\n    game: GameState,\n    player: Any,\n    ability: LoyaltyAbilityInstance,\n) -> None:\n    \"\"\"Activate a planeswalker loyalty ability.\"\"\"\n    source = ability.source\n\n    # 1. Timing — loyalty abilities are sorcery speed only.\n    if not is_sorcery_speed(game, player):\n        raise AbilityError(\n            \"Cannot activate loyalty ability — sorcery-speed timing not met\"\n        )\n\n    # 2. Once-per-turn restriction.\n    turn_number = getattr(game, \"turn_number\", 0)\n    if _has_activated_loyalty_this_turn(source, turn_number):\n        raise AbilityError(\n            \"Cannot activate loyalty ability — already activated this turn\"\n        )\n\n    # 3. Pay loyalty cost.\n    current_loyalty = getattr(source, \"loyalty\", 0)\n    new_loyalty = current_loyalty + ability.loyalty_cost\n    if new_loyalty < 0:\n        raise AbilityError(\n            f\"Cannot activate loyalty ability — insufficient loyalty \"\n            f\"(have {current_loyalty}, need {-ability.loyalty_cost})\"\n        )\n    source.loyalty = new_loyalty\n\n    # 4. Mark as activated this turn.\n    _mark_loyalty_activated(source, turn_number)\n\n    # 5. Push to stack.\n    stack_obj = StackObject(\n        source=source,\n        controller=player,\n        on_resolve=ability.effect,\n        is_mana_ability=False,\n    )\n    game.stack.push(stack_obj)\n","numLines":273,"startLine":1,"totalLines":273}}}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01CHVV13nUnivhzRu881ZSw4","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01E2UhLmWYb7FV7LGKDFYFCf","name":"Read","input":{"file_path":"/workspace/engine/turn.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10606,"cache_read_input_tokens":62057,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10606},"output_tokens":51,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"f8a3aed6-12f8-4341-9631-2336f98abe5d","uuid":"29eed2b0-bb15-49b6-ac54-3f19f2fddfd6","request_id":"req_011Cbhh8G1dgfH5d5dJ5C5wx"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E2UhLmWYb7FV7LGKDFYFCf","type":"tool_result","content":"1\t\"\"\"Turn execution loop for the SilverquiLLM engine.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport warnings\n6\tfrom typing import TYPE_CHECKING\n7\t\n8\tif TYPE_CHECKING:\n9\t    from engine.game_state import GameState\n10\t\n11\tfrom engine.stack import priority_loop\n12\tfrom engine.types import Phase, Step, Zone\n13\t\n14\t\n15\t# Maximum hand size — players discard down to this during cleanup.\n16\tMAX_HAND_SIZE: int = 7\n17\t\n18\t\n19\t# Steps/phases where priority is given to players.\n20\t# In MTG, players do NOT receive priority during Untap and Cleanup (normally).\n21\t_NO_PRIORITY_STEPS: set[tuple[Phase, Step | None]] = {\n22\t    (Phase.BEGINNING, Step.UNTAP),\n23\t    (Phase.ENDING, Step.CLEANUP),\n24\t}\n25\t\n26\t\n27\tdef _do_untap_step(game: GameState) -> None:\n28\t    \"\"\"Perform untap step actions: untap all permanents controlled by the active player.\n29\t\n30\t    Per MTG rules, the active player untaps all permanents they control\n31\t    during their untap step. Summoning sickness is also cleared at this point.\n32\t    \"\"\"\n33\t    active = game.active_player\n34\t    bf = active.zones[Zone.BATTLEFIELD]\n35\t    for obj in bf.get_all():\n36\t        if hasattr(obj, \"is_tapped\"):\n37\t            obj.is_tapped = False\n38\t        if hasattr(obj, \"summoning_sick\"):\n39\t            obj.summoning_sick = False\n40\t\n41\t    # Reset land plays for the active player\n42\t    active.land_plays_remaining = 1\n43\t\n44\t\n45\tdef _do_draw_step(game: GameState) -> None:\n46\t    \"\"\"Perform draw step actions: active player draws a card.\n47\t\n48\t    In a two-player game, the starting player (the player who takes\n49\t    turn 1) skips their draw step on that first turn.  This is per\n50\t    MTG comprehensive rules §103.7a.\n51\t    \"\"\"\n52\t    # The starting player skips their draw on turn 1.\n53\t    if game.turn_number == 1 and game.active_player_index == 0:\n54\t        return\n55\t\n56\t    from engine.game import draw_card\n57\t\n58\t    draw_card(game, game.active_player)\n59\t\n60\t\n61\tdef _do_combat_step(game: GameState, step: Step) -> None:\n62\t    \"\"\"Dispatch combat sub-steps to the appropriate combat functions.\n63\t\n64\t    Parameters:\n65\t        game: The current game state.\n66\t        step: The combat step to execute.\n67\t    \"\"\"\n68\t    from engine.combat import (\n69\t        combat_damage_step,\n70\t        declare_attackers_step,\n71\t        declare_blockers_step,\n72\t        end_combat_step,\n73\t    )\n74\t\n75\t    if step == Step.DECLARE_ATTACKERS:\n76\t        declare_attackers_step(game)\n77\t    elif step == Step.DECLARE_BLOCKERS:\n78\t        declare_blockers_step(game)\n79\t    elif step == Step.COMBAT_DAMAGE:\n80\t        combat_damage_step(game)\n81\t    elif step == Step.END_COMBAT:\n82\t        end_combat_step(game)\n83\t\n84\t\n85\tdef _do_cleanup_step(game: GameState) -> None:\n86\t    \"\"\"Perform the cleanup step (MTG rule §514).\n87\t\n88\t    The cleanup step executes the following actions in order:\n89\t\n90\t    1. Active player discards down to maximum hand size (7) using\n91\t       :meth:`Player.choose_card`.\n92\t    2. Remove all \"until end of turn\" continuous effects via\n93\t       :meth:`EffectManager.remove_expired`, then reapply remaining\n94\t       effects for a consistent game state.\n95\t    3. Clear damage marked on all creatures on the battlefield.\n96\t    4. Clear combat-related flags (``dealt_deathtouch_damage``,\n97\t       ``is_attacking``, ``is_blocking``) and reset the combat state.\n98\t    5. Empty all players' mana pools.\n99\t    6. Check state-based actions.\n100\t    7. If triggers fired during cleanup (e.g. from discarding), process\n101\t       them (give priority, resolve stack) and perform another cleanup step.\n102\t    \"\"\"\n103\t    from engine.game import discard as _discard\n104\t    from engine.player import ScriptExhaustedError\n105\t    from engine.state_based_actions import resolve_state_based_actions\n106\t\n107\t    # --- Step 1: Discard to hand size ---\n108\t    active = game.active_player\n109\t    hand = active.zones[Zone.HAND]\n110\t    while len(hand) > MAX_HAND_SIZE:\n111\t        cards_in_hand = hand.get_all()\n112\t        if not cards_in_hand:\n113\t            break  # safety guard\n114\t        try:\n115\t            chosen = active.choose_card(cards_in_hand, \"discard to hand size\")\n116\t        except (ScriptExhaustedError, NotImplementedError) as exc:\n117\t            # Player implementation doesn't support choose_card or script\n118\t            # was exhausted.  Discard deterministically from end.\n119\t            chosen = cards_in_hand[-1]\n120\t            exc_name = type(exc).__name__\n121\t            warnings.warn(\n122\t                f\"{exc_name} during cleanup discard for {active.name}; \"\n123\t                f\"auto-discarding {chosen.name}\"\n124\t            )\n125\t        if chosen is not None and hand.contains(chosen):\n126\t            _discard(game, active, chosen)\n127\t        else:\n128\t            # If choose_card returns something invalid, discard the last card\n129\t            # to avoid an infinite loop.\n130\t            _discard(game, active, cards_in_hand[-1])\n131\t\n132\t    # --- Step 2: Remove \"until end of turn\" continuous effects ---\n133\t    if hasattr(game, \"effect_manager\"):\n134\t        game.effect_manager.remove_expired(game)\n135\t        # Reapply remaining effects so the game state is consistent.\n136\t        game.effect_manager.apply_all(game)\n137\t\n138\t    # --- Step 3: Clear damage on all creatures ---\n139\t    for player in game.players:\n140\t        bf = player.zones[Zone.BATTLEFIELD]\n141\t        for obj in bf.get_all():\n142\t            if hasattr(obj, \"damage_marked\"):\n143\t                obj.damage_marked = 0\n144\t\n145\t    # --- Step 4: Clear combat flags ---\n146\t    for player in game.players:\n147\t        bf = player.zones[Zone.BATTLEFIELD]\n148\t        for obj in bf.get_all():\n149\t            if hasattr(obj, \"dealt_deathtouch_damage\"):\n150\t                obj.dealt_deathtouch_damage = False\n151\t            if hasattr(obj, \"is_attacking\"):\n152\t                obj.is_attacking = False\n153\t            if hasattr(obj, \"is_blocking\"):\n154\t                obj.is_blocking = False\n155\t    # Reset the CombatState itself.\n156\t    if hasattr(game, \"combat_state\"):\n157\t        game.combat_state.clear()\n158\t\n159\t    # --- Step 5: Empty mana pools ---\n160\t    game.empty_mana_pools()\n161\t\n162\t    # --- Step 6: Check state-based actions ---\n163\t    sba_happened = resolve_state_based_actions(game)\n164\t\n165\t    # --- Step 7: If SBAs were performed or triggers fired, process & repeat ---\n166\t    # Rule 514.3a: if state-based actions were performed or triggered abilities\n167\t    # triggered during cleanup, another cleanup step occurs.\n168\t    if sba_happened or not game.stack.is_empty():\n169\t        # Triggers were placed on the stack — give priority and resolve.\n170\t        priority_loop(game)\n171\t        # After resolving, perform another cleanup step (recursive).\n172\t        _do_cleanup_step(game)\n173\t\n174\t\n175\tdef run_turn(game: GameState) -> None:\n176\t    \"\"\"Execute a full turn, iterating through all phases/steps.\n177\t\n178\t    At each priority point (every phase/step except Untap and Cleanup),\n179\t    :func:`priority_loop` is called.  Turn-based actions are performed\n180\t    at the appropriate steps:\n181\t\n182\t    - **Untap**: Untap all permanents, clear summoning sickness, reset\n183\t      land plays.\n184\t    - **Draw**: Active player draws a card.\n185\t    - **Combat**: Delegate to combat system functions.\n186\t    - **Cleanup**: Clear damage, remove expired effects.\n187\t\n188\t    After the last step (Cleanup), the turn number is incremented and\n189\t    the active player swaps via :meth:`GameState.advance_phase`.\n190\t\n191\t    Parameters:\n192\t        game: The game state to advance through one complete turn.\n193\t    \"\"\"\n194\t    start_turn = game.turn_number\n195\t\n196\t    while game.turn_number == start_turn:\n197\t        current = (game.phase, game.step)\n198\t\n199\t        # Perform turn-based actions for the current step\n200\t        if current == (Phase.BEGINNING, Step.UNTAP):\n201\t            _do_untap_step(game)\n202\t        elif current == (Phase.BEGINNING, Step.UPKEEP):\n203\t            from engine.events import BeginningOfUpkeepTriggeredEvent\n204\t            game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n205\t        elif current == (Phase.BEGINNING, Step.DRAW):\n206\t            _do_draw_step(game)\n207\t        elif game.phase == Phase.COMBAT and game.step is not None:\n208\t            _do_combat_step(game, game.step)\n209\t        elif current == (Phase.ENDING, Step.CLEANUP):\n210\t            _do_cleanup_step(game)\n211\t\n212\t        # Grant priority at this phase/step unless it's Untap or Cleanup.\n213\t        if current not in _NO_PRIORITY_STEPS:\n214\t            priority_loop(game)\n215\t\n216\t        # Advance to the next phase/step (or to next turn).\n217\t        game.advance_phase()\n218\t"}]},"parent_tool_use_id":null,"session_id":"f8a3aed6-12f8-4341-9631-2336f98abe5d","uuid":"a8e326c8-e8af-4c20-9388-90b688c6218f","timestamp":"2026-06-04T05:47:36.181Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/turn.py","content":"\"\"\"Turn execution loop for the SilverquiLLM engine.\"\"\"\n\nfrom __future__ import annotations\n\nimport warnings\nfrom typing import TYPE_CHECKING\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n\nfrom engine.stack import priority_loop\nfrom engine.types import Phase, Step, Zone\n\n\n# Maximum hand size — players discard down to this during cleanup.\nMAX_HAND_SIZE: int = 7\n\n\n# Steps/phases where priority is given to players.\n# In MTG, players do NOT receive priority during Untap and Cleanup (normally).\n_NO_PRIORITY_STEPS: set[tuple[Phase, Step | None]] = {\n    (Phase.BEGINNING, Step.UNTAP),\n    (Phase.ENDING, Step.CLEANUP),\n}\n\n\ndef _do_untap_step(game: GameState) -> None:\n    \"\"\"Perform untap step actions: untap all permanents controlled by the active player.\n\n    Per MTG rules, the active player untaps all permanents they control\n    during their untap step. Summoning sickness is also cleared at this point.\n    \"\"\"\n    active = game.active_player\n    bf = active.zones[Zone.BATTLEFIELD]\n    for obj in bf.get_all():\n        if hasattr(obj, \"is_tapped\"):\n            obj.is_tapped = False\n        if hasattr(obj, \"summoning_sick\"):\n            obj.summoning_sick = False\n\n    # Reset land plays for the active player\n    active.land_plays_remaining = 1\n\n\ndef _do_draw_step(game: GameState) -> None:\n    \"\"\"Perform draw step actions: active player draws a card.\n\n    In a two-player game, the starting player (the player who takes\n    turn 1) skips their draw step on that first turn.  This is per\n    MTG comprehensive rules §103.7a.\n    \"\"\"\n    # The starting player skips their draw on turn 1.\n    if game.turn_number == 1 and game.active_player_index == 0:\n        return\n\n    from engine.game import draw_card\n\n    draw_card(game, game.active_player)\n\n\ndef _do_combat_step(game: GameState, step: Step) -> None:\n    \"\"\"Dispatch combat sub-steps to the appropriate combat functions.\n\n    Parameters:\n        game: The current game state.\n        step: The combat step to execute.\n    \"\"\"\n    from engine.combat import (\n        combat_damage_step,\n        declare_attackers_step,\n        declare_blockers_step,\n        end_combat_step,\n    )\n\n    if step == Step.DECLARE_ATTACKERS:\n        declare_attackers_step(game)\n    elif step == Step.DECLARE_BLOCKERS:\n        declare_blockers_step(game)\n    elif step == Step.COMBAT_DAMAGE:\n        combat_damage_step(game)\n    elif step == Step.END_COMBAT:\n        end_combat_step(game)\n\n\ndef _do_cleanup_step(game: GameState) -> None:\n    \"\"\"Perform the cleanup step (MTG rule §514).\n\n    The cleanup step executes the following actions in order:\n\n    1. Active player discards down to maximum hand size (7) using\n       :meth:`Player.choose_card`.\n    2. Remove all \"until end of turn\" continuous effects via\n       :meth:`EffectManager.remove_expired`, then reapply remaining\n       effects for a consistent game state.\n    3. Clear damage marked on all creatures on the battlefield.\n    4. Clear combat-related flags (``dealt_deathtouch_damage``,\n       ``is_attacking``, ``is_blocking``) and reset the combat state.\n    5. Empty all players' mana pools.\n    6. Check state-based actions.\n    7. If triggers fired during cleanup (e.g. from discarding), process\n       them (give priority, resolve stack) and perform another cleanup step.\n    \"\"\"\n    from engine.game import discard as _discard\n    from engine.player import ScriptExhaustedError\n    from engine.state_based_actions import resolve_state_based_actions\n\n    # --- Step 1: Discard to hand size ---\n    active = game.active_player\n    hand = active.zones[Zone.HAND]\n    while len(hand) > MAX_HAND_SIZE:\n        cards_in_hand = hand.get_all()\n        if not cards_in_hand:\n            break  # safety guard\n        try:\n            chosen = active.choose_card(cards_in_hand, \"discard to hand size\")\n        except (ScriptExhaustedError, NotImplementedError) as exc:\n            # Player implementation doesn't support choose_card or script\n            # was exhausted.  Discard deterministically from end.\n            chosen = cards_in_hand[-1]\n            exc_name = type(exc).__name__\n            warnings.warn(\n                f\"{exc_name} during cleanup discard for {active.name}; \"\n                f\"auto-discarding {chosen.name}\"\n            )\n        if chosen is not None and hand.contains(chosen):\n            _discard(game, active, chosen)\n        else:\n            # If choose_card returns something invalid, discard the last card\n            # to avoid an infinite loop.\n            _discard(game, active, cards_in_hand[-1])\n\n    # --- Step 2: Remove \"until end of turn\" continuous effects ---\n    if hasattr(game, \"effect_manager\"):\n        game.effect_manager.remove_expired(game)\n        # Reapply remaining effects so the game state is consistent.\n        game.effect_manager.apply_all(game)\n\n    # --- Step 3: Clear damage on all creatures ---\n    for player in game.players:\n        bf = player.zones[Zone.BATTLEFIELD]\n        for obj in bf.get_all():\n            if hasattr(obj, \"damage_marked\"):\n                obj.damage_marked = 0\n\n    # --- Step 4: Clear combat flags ---\n    for player in game.players:\n        bf = player.zones[Zone.BATTLEFIELD]\n        for obj in bf.get_all():\n            if hasattr(obj, \"dealt_deathtouch_damage\"):\n                obj.dealt_deathtouch_damage = False\n            if hasattr(obj, \"is_attacking\"):\n                obj.is_attacking = False\n            if hasattr(obj, \"is_blocking\"):\n                obj.is_blocking = False\n    # Reset the CombatState itself.\n    if hasattr(game, \"combat_state\"):\n        game.combat_state.clear()\n\n    # --- Step 5: Empty mana pools ---\n    game.empty_mana_pools()\n\n    # --- Step 6: Check state-based actions ---\n    sba_happened = resolve_state_based_actions(game)\n\n    # --- Step 7: If SBAs were performed or triggers fired, process & repeat ---\n    # Rule 514.3a: if state-based actions were performed or triggered abilities\n    # triggered during cleanup, another cleanup step occurs.\n    if sba_happened or not game.stack.is_empty():\n        # Triggers were placed on the stack — give priority and resolve.\n        priority_loop(game)\n        # After resolving, perform another cleanup step (recursive).\n        _do_cleanup_step(game)\n\n\ndef run_turn(game: GameState) -> None:\n    \"\"\"Execute a full turn, iterating through all phases/steps.\n\n    At each priority point (every phase/step except Untap and Cleanup),\n    :func:`priority_loop` is called.  Turn-based actions are performed\n    at the appropriate steps:\n\n    - **Untap**: Untap all permanents, clear summoning sickness, reset\n      land plays.\n    - **Draw**: Active player draws a card.\n    - **Combat**: Delegate to combat system functions.\n    - **Cleanup**: Clear damage, remove expired effects.\n\n    After the last step (Cleanup), the turn number is incremented and\n    the active player swaps via :meth:`GameState.advance_phase`.\n\n    Parameters:\n        game: The game state to advance through one complete turn.\n    \"\"\"\n    start_turn = game.turn_number\n\n    while game.turn_number == start_turn:\n        current = (game.phase, game.step)\n\n        # Perform turn-based actions for the current step\n        if current == (Phase.BEGINNING, Step.UNTAP):\n            _do_untap_step(game)\n        elif current == (Phase.BEGINNING, Step.UPKEEP):\n            from engine.events import BeginningOfUpkeepTriggeredEvent\n            game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n        elif current == (Phase.BEGINNING, Step.DRAW):\n            _do_draw_step(game)\n        elif game.phase == Phase.COMBAT and game.step is not None:\n            _do_combat_step(game, game.step)\n        elif current == (Phase.ENDING, Step.CLEANUP):\n            _do_cleanup_step(game)\n\n        # Grant priority at this phase/step unless it's Untap or Cleanup.\n        if current not in _NO_PRIORITY_STEPS:\n            priority_loop(game)\n\n        # Advance to the next phase/step (or to next turn).\n        game.advance_phase()\n","numLines":218,"startLine":1,"totalLines":218}}}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01CHVV13nUnivhzRu881ZSw4","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01FLmqiNvvXFTTynWvjebTMt","name":"Read","input":{"file_path":"/workspace/engine/combat.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10606,"cache_read_input_tokens":62057,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10606},"output_tokens":51,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"f8a3aed6-12f8-4341-9631-2336f98abe5d","uuid":"25dc181f-f648-4c56-8da7-1fb72ec5446d","request_id":"req_011Cbhh8G1dgfH5d5dJ5C5wx"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FLmqiNvvXFTTynWvjebTMt","type":"tool_result","content":"1\t\"\"\"Combat system: declare attackers → declare blockers → damage → end combat.\n2\t\n3\tImplements the four substeps of the MTG combat phase:\n4\t\n5\t1. **Declare Attackers** — Active player chooses creatures to attack with.\n6\t   Attackers are tapped (unless they have vigilance).  Creatures with\n7\t   summoning sickness (without haste) or the defender keyword cannot attack.\n8\t\n9\t2. **Declare Blockers** — Defending player assigns blockers.  Creatures\n10\t   with flying can only be blocked by creatures with flying or reach.\n11\t   Creatures with menace require 2+ blockers.  The attacker's controller\n12\t   orders the blockers for damage assignment.\n13\t\n14\t3. **Combat Damage** — First strike / double strike creatures deal damage\n15\t   first, then state-based actions are checked, then normal damage.\n16\t   Trample excess goes to the defending player.  Lifelink heals the\n17\t   controller.  Deathtouch makes any nonzero damage lethal.  Unblocked\n18\t   attackers deal damage to the defending player.\n19\t\n20\t4. **End Combat** — Clear all combat state.\n21\t\n22\tReferences: MTG Comprehensive Rules §506–§511.\n23\t\"\"\"\n24\t\n25\tfrom __future__ import annotations\n26\t\n27\tfrom dataclasses import dataclass, field\n28\tfrom typing import TYPE_CHECKING, Any\n29\t\n30\tfrom engine.types import Keyword\n31\t\n32\tif TYPE_CHECKING:\n33\t    from engine.game_state import GameState\n34\t    from engine.player import Player\n35\t\n36\t\n37\t# ---------------------------------------------------------------------------\n38\t# CombatState — tracks all per-combat information\n39\t# ---------------------------------------------------------------------------\n40\t\n41\t@dataclass\n42\tclass CombatState:\n43\t    \"\"\"Tracks attackers, blockers, damage assignments, and block ordering.\n44\t\n45\t    Attributes:\n46\t        attackers: Mapping of attacking creature → defending player.\n47\t        blockers: Mapping of blocking creature → list of attackers it blocks.\n48\t        attacker_blockers: Mapping of attacking creature → ordered list of\n49\t            blockers assigned to it (order used for damage assignment).\n50\t        damage_assignments: Mapping of creature → list of\n51\t            ``(target, amount)`` tuples describing how damage is assigned.\n52\t        was_blocked: Set of attackers that were declared as blocked.  Per\n53\t            MTG rule 509.1h, once a creature is blocked it stays blocked\n54\t            even if all its blockers are removed before damage.\n55\t        in_combat: Whether the combat phase is currently active.\n56\t    \"\"\"\n57\t\n58\t    attackers: dict[Any, Player] = field(default_factory=dict)\n59\t    blockers: dict[Any, list[Any]] = field(default_factory=dict)\n60\t    attacker_blockers: dict[Any, list[Any]] = field(default_factory=dict)\n61\t    damage_assignments: dict[Any, list[tuple[Any, int]]] = field(default_factory=dict)\n62\t    was_blocked: set[Any] = field(default_factory=set)\n63\t    in_combat: bool = False\n64\t\n65\t    def clear(self) -> None:\n66\t        \"\"\"Reset all combat state.\"\"\"\n67\t        self.attackers.clear()\n68\t        self.blockers.clear()\n69\t        self.attacker_blockers.clear()\n70\t        self.damage_assignments.clear()\n71\t        self.was_blocked.clear()\n72\t        self.in_combat = False\n73\t\n74\t\n75\t# ---------------------------------------------------------------------------\n76\t# Helpers\n77\t# ---------------------------------------------------------------------------\n78\t\n79\tdef _can_attack(creature: Any) -> bool:\n80\t    \"\"\"Return ``True`` if *creature* is eligible to be declared as an attacker.\n81\t\n82\t    A creature cannot attack if:\n83\t    - It is already tapped.\n84\t    - It has the ``DEFENDER`` keyword.\n85\t    - It has summoning sickness (``summoning_sick``) and does not have ``HASTE``.\n86\t    - A continuous effect has set ``_cant_attack`` (e.g. Pacifism).\n87\t    \"\"\"\n88\t    if getattr(creature, \"is_tapped\", False):\n89\t        return False\n90\t\n91\t    # Check for \"can't attack\" restriction (set by continuous effects like Pacifism)\n92\t    if getattr(creature, \"_cant_attack\", False):\n93\t        return False\n94\t\n95\t    keywords = getattr(creature, \"keywords\", Keyword(0))\n96\t\n97\t    if Keyword.DEFENDER in keywords:\n98\t        return False\n99\t\n100\t    if getattr(creature, \"summoning_sick\", False) and Keyword.HASTE not in keywords:\n101\t        return False\n102\t\n103\t    return True\n104\t\n105\t\n106\tdef _can_block(blocker: Any, attacker: Any) -> bool:\n107\t    \"\"\"Return ``True`` if *blocker* can legally block *attacker*.\n108\t\n109\t    Checks:\n110\t    - If the blocker is tapped it cannot block.\n111\t    - A continuous effect has set ``_cant_block`` (e.g. Pacifism).\n112\t    - If the attacker has flying, the blocker must have flying or reach.\n113\t    \"\"\"\n114\t    if getattr(blocker, \"is_tapped\", False):\n115\t        return False\n116\t\n117\t    # Check for \"can't block\" restriction (set by continuous effects like Pacifism)\n118\t    if getattr(blocker, \"_cant_block\", False):\n119\t        return False\n120\t\n121\t    attacker_kw = getattr(attacker, \"keywords\", Keyword(0))\n122\t    blocker_kw = getattr(blocker, \"keywords\", Keyword(0))\n123\t\n124\t    # Flying check\n125\t    if Keyword.FLYING in attacker_kw:\n126\t        if Keyword.FLYING not in blocker_kw and Keyword.REACH not in blocker_kw:\n127\t            return False\n128\t\n129\t    # Protection check — attacker with protection from blocker can't be blocked\n130\t    from engine.protection import has_protection_from\n131\t\n132\t    if has_protection_from(attacker, blocker):\n133\t        return False\n134\t\n135\t    return True\n136\t\n137\t\n138\tdef _get_lethal_damage(creature: Any, attacker: Any | None = None) -> int:\n139\t    \"\"\"Return the amount of damage needed to lethally assign to *creature*.\n140\t\n141\t    If *attacker* has deathtouch, 1 damage is lethal.\n142\t    Otherwise it's ``toughness - damage_marked`` (at least 1).\n143\t    \"\"\"\n144\t    if attacker is not None:\n145\t        attacker_kw = getattr(attacker, \"keywords\", Keyword(0))\n146\t        if Keyword.DEATHTOUCH in attacker_kw:\n147\t            return 1\n148\t\n149\t    toughness = getattr(creature, \"toughness\", 0)\n150\t    damage_marked = getattr(creature, \"damage_marked\", 0)\n151\t    return max(1, toughness - damage_marked)\n152\t\n153\t\n154\tdef _deal_damage(\n155\t    source: Any,\n156\t    target: Any,\n157\t    amount: int,\n158\t    game: GameState,\n159\t    combat_state: CombatState,\n160\t) -> None:\n161\t    \"\"\"Apply *amount* damage from *source* to *target*.\n162\t\n163\t    If *target* is a player, reduces life.\n164\t    If *target* is a creature, marks damage on it.\n165\t    If *source* has lifelink, the controller gains that much life.\n166\t\n167\t    Protection prevents damage from sources with the protected-from quality.\n168\t    \"\"\"\n169\t    if amount <= 0:\n170\t        return\n171\t\n172\t    # Protection prevents damage (D in DEBT).\n173\t    from engine.protection import has_protection_from\n174\t\n175\t    if has_protection_from(target, source):\n176\t        return\n177\t\n178\t    # Record damage assignment\n179\t    if source not in combat_state.damage_assignments:\n180\t        combat_state.damage_assignments[source] = []\n181\t    combat_state.damage_assignments[source].append((target, amount))\n182\t\n183\t    # Apply damage\n184\t    if hasattr(target, \"life\"):\n185\t        # Target is a player\n186\t        target.life -= amount\n187\t    elif hasattr(target, \"damage_marked\"):\n188\t        # Target is a creature\n189\t        target.damage_marked += amount\n190\t\n191\t        # Track deathtouch damage for SBA rule 704.5h\n192\t        source_kw_dt = getattr(source, \"keywords\", Keyword(0))\n193\t        if Keyword.DEATHTOUCH in source_kw_dt:\n194\t            target.dealt_deathtouch_damage = True\n195\t\n196\t    # Lifelink: controller gains life equal to damage dealt\n197\t    source_kw = getattr(source, \"keywords\", Keyword(0))\n198\t    if Keyword.LIFELINK in source_kw:\n199\t        controller = getattr(source, \"controller\", None)\n200\t        if controller is not None and hasattr(controller, \"life\"):\n201\t            controller.life += amount\n202\t\n203\t\n204\t# ---------------------------------------------------------------------------\n205\t# Combat steps\n206\t# ---------------------------------------------------------------------------\n207\t\n208\tdef declare_attackers_step(game: GameState) -> None:\n209\t    \"\"\"Declare attackers step: active player chooses creatures to attack with.\n210\t\n211\t    The active player is asked (via :meth:`Player.choose`) to select a set\n212\t    of creatures to attack with.  Each chosen attacker is tapped (unless it\n213\t    has vigilance) and its ``is_attacking`` flag is set.\n214\t\n215\t    Parameters:\n216\t        game: The current game state.  ``game.combat_state`` must exist.\n217\t    \"\"\"\n218\t    combat = game.combat_state\n219\t    combat.in_combat = True\n220\t    active = game.active_player\n221\t    defending = game.non_active_player\n222\t\n223\t    # Gather legal attackers from the active player's battlefield\n224\t    from engine.types import Zone\n225\t    bf = active.zones[Zone.BATTLEFIELD]\n226\t    eligible = [\n227\t        c for c in bf.get_all()\n228\t        if hasattr(c, \"base_power\") and _can_attack(c)\n229\t    ]\n230\t\n231\t    if not eligible:\n232\t        return\n233\t\n234\t    # Active player chooses which creatures to attack with\n235\t    chosen = active.choose(eligible, \"declare attackers\")\n236\t\n237\t    # Normalize to a list\n238\t    if chosen is None:\n239\t        return\n240\t    if not isinstance(chosen, list):\n241\t        chosen = [chosen]\n242\t\n243\t    # Validate and register attackers\n244\t    for attacker in chosen:\n245\t        if attacker not in eligible:\n246\t            continue\n247\t        if not _can_attack(attacker):\n248\t            continue\n249\t\n250\t        combat.attackers[attacker] = defending\n251\t        combat.attacker_blockers[attacker] = []\n252\t        attacker.is_attacking = True\n253\t\n254\t        # Tap the attacker unless it has vigilance\n255\t        kw = getattr(attacker, \"keywords\", Keyword(0))\n256\t        if Keyword.VIGILANCE not in kw:\n257\t            attacker.is_tapped = True\n258\t\n259\t\n260\tdef declare_blockers_step(game: GameState) -> None:\n261\t    \"\"\"Declare blockers step: defending player assigns blockers.\n262\t\n263\t    The defending player is asked (via :meth:`Player.choose`) to assign\n264\t    blockers.  The expected format is a dict mapping blocker → attacker\n265\t    (or blocker → list of attackers for multi-blocking scenarios), but\n266\t    commonly blocker → attacker.\n267\t\n268\t    After blockers are assigned:\n269\t    - Menace check: attackers with menace must be blocked by 2+ creatures.\n270\t    - Flying/reach check is already handled by ``_can_block``.\n271\t    - The attacking player orders blockers for each attacker (for damage\n272\t      assignment).\n273\t\n274\t    Parameters:\n275\t        game: The current game state.\n276\t    \"\"\"\n277\t    combat = game.combat_state\n278\t\n279\t    if not combat.attackers:\n280\t        return\n281\t\n282\t    defending = game.non_active_player\n283\t    active = game.active_player\n284\t\n285\t    from engine.types import Zone\n286\t    bf_defending = defending.zones[Zone.BATTLEFIELD]\n287\t    eligible_blockers = [\n288\t        c for c in bf_defending.get_all()\n289\t        if hasattr(c, \"base_power\") and not getattr(c, \"is_tapped\", False)\n290\t    ]\n291\t\n292\t    if not eligible_blockers:\n293\t        return\n294\t\n295\t    # Defending player chooses block assignments\n296\t    # Expected format: dict mapping blocker → attacker (or list of attackers)\n297\t    block_assignments = defending.choose(\n298\t        eligible_blockers,\n299\t        \"declare blockers\",\n300\t    )\n301\t\n302\t    if block_assignments is None:\n303\t        return\n304\t\n305\t    if not isinstance(block_assignments, dict):\n306\t        return\n307\t\n308\t    # Process block assignments\n309\t    for blocker, target in block_assignments.items():\n310\t        # Validate that the blocker is in the eligible set\n311\t        if blocker not in eligible_blockers:\n312\t            continue\n313\t        targets = target if isinstance(target, list) else [target]\n314\t        valid_targets = []\n315\t        max_blocked = getattr(blocker, \"_max_attackers_blocked\", 1)\n316\t        for attacker in targets:\n317\t            if len(valid_targets) >= max_blocked:\n318\t                break\n319\t            if attacker in combat.attackers and _can_block(blocker, attacker):\n320\t                valid_targets.append(attacker)\n321\t        if valid_targets:\n322\t            combat.blockers[blocker] = valid_targets\n323\t            blocker.is_blocking = True\n324\t            for attacker in valid_targets:\n325\t                if attacker not in combat.attacker_blockers:\n326\t                    combat.attacker_blockers[attacker] = []\n327\t                combat.attacker_blockers[attacker].append(blocker)\n328\t\n329\t    # Menace check: attackers with menace that have fewer than 2 blockers\n330\t    # are treated as unblocked (remove the single blocker assignment).\n331\t    for attacker, blocker_list in list(combat.attacker_blockers.items()):\n332\t        kw = getattr(attacker, \"keywords\", Keyword(0))\n333\t        if Keyword.MENACE in kw and len(blocker_list) < 2 and len(blocker_list) > 0:\n334\t            # Illegal block — remove these blockers\n335\t            for b in blocker_list:\n336\t                if b in combat.blockers:\n337\t                    combat.blockers[b] = [\n338\t                        a for a in combat.blockers[b] if a is not attacker\n339\t                    ]\n340\t                    if not combat.blockers[b]:\n341\t                        del combat.blockers[b]\n342\t                        b.is_blocking = False\n343\t            combat.attacker_blockers[attacker] = []\n344\t\n345\t    # Mark attackers that have at least one blocker as \"was_blocked\".\n346\t    # Per MTG rule 509.1h, once a creature is blocked it remains blocked\n347\t    # even if all its blockers are removed before the damage step.\n348\t    for attacker, blocker_list in combat.attacker_blockers.items():\n349\t        if blocker_list:\n350\t            combat.was_blocked.add(attacker)\n351\t\n352\t    # Controller of each attacker orders the blockers for damage assignment\n353\t    for attacker, blocker_list in combat.attacker_blockers.items():\n354\t        if len(blocker_list) > 1:\n355\t            controller = getattr(attacker, \"controller\", active)\n356\t            ordered = controller.assign_damage_order(blocker_list)\n357\t            combat.attacker_blockers[attacker] = ordered\n358\t\n359\t\n360\tdef combat_damage_step(game: GameState) -> None:\n361\t    \"\"\"Combat damage step: deal combat damage.\n362\t\n363\t    Handles:\n364\t    - First strike / double strike creatures deal damage first.\n365\t    - State-based actions are checked between first-strike and normal damage.\n366\t    - Trample: excess damage over blocker toughness → defending player.\n367\t    - Lifelink: controller gains life equal to damage dealt.\n368\t    - Deathtouch: any damage is lethal (1 damage = lethal assignment).\n369\t    - Unblocked attackers deal damage to defending player.\n370\t\n371\t    Parameters:\n372\t        game: The current game state.\n373\t    \"\"\"\n374\t    from engine.state_based_actions import resolve_state_based_actions\n375\t\n376\t    combat = game.combat_state\n377\t\n378\t    if not combat.attackers:\n379\t        return\n380\t\n381\t    all_attackers = list(combat.attackers.keys())\n382\t\n383\t    # Determine if a first-strike damage sub-step is needed\n384\t    # Check both attackers and blockers for first strike / double strike\n385\t    all_blockers = set()\n386\t    for blocker_list in combat.attacker_blockers.values():\n387\t        all_blockers.update(blocker_list)\n388\t\n389\t    has_first_strike_step = any(\n390\t        Keyword.FIRST_STRIKE in getattr(c, \"keywords\", Keyword(0))\n391\t        or Keyword.DOUBLE_STRIKE in getattr(c, \"keywords\", Keyword(0))\n392\t        for c in list(all_attackers) + list(all_blockers)\n393\t    )\n394\t\n395\t    # --- First strike damage sub-step ---\n396\t    if has_first_strike_step:\n397\t        _assign_combat_damage(all_attackers, combat, game, is_first_strike=True)\n398\t        resolve_state_based_actions(game)\n399\t\n400\t    # --- Normal damage sub-step ---\n401\t    _assign_combat_damage(all_attackers, combat, game, is_first_strike=False)\n402\t    resolve_state_based_actions(game)\n403\t\n404\t\n405\tdef _assign_combat_damage(\n406\t    attackers: list[Any],\n407\t    combat: CombatState,\n408\t    game: GameState,\n409\t    *,\n410\t    is_first_strike: bool = False,\n411\t) -> None:\n412\t    \"\"\"Assign and deal combat damage for a set of attackers.\n413\t\n414\t    For each attacker:\n415\t    - If unblocked → damage to defending player.\n416\t    - If blocked → damage assigned to blockers in order.  With trample,\n417\t      excess damage goes to the defending player.\n418\t    - Blockers deal damage back to the attacker they block.\n419\t\n420\t    When *is_first_strike* is ``True``, only creatures with\n421\t    ``FIRST_STRIKE`` or ``DOUBLE_STRIKE`` deal damage (both attackers\n422\t    and blockers).  When ``False``, only creatures *without*\n423\t    ``FIRST_STRIKE`` deal damage (plus ``DOUBLE_STRIKE`` creatures,\n424\t    which participate in both steps).  Blockers that are no longer on\n425\t    the battlefield (e.g. killed by first-strike damage and removed by\n426\t    SBAs) are skipped.\n427\t    \"\"\"\n428\t    from engine.types import Zone\n429\t\n430\t    # Track which blockers have already dealt their damage this sub-step\n431\t    # (blockers only deal damage once even if blocking multiple attackers)\n432\t    blockers_dealt: set[int] = set()\n433\t\n434\t    for attacker in attackers:\n435\t        if attacker not in combat.attackers:\n436\t            continue\n437\t\n438\t        kw = getattr(attacker, \"keywords\", Keyword(0))\n439\t        has_first = Keyword.FIRST_STRIKE in kw\n440\t        has_double = Keyword.DOUBLE_STRIKE in kw\n441\t\n442\t        # Determine if this attacker deals damage in this sub-step\n443\t        if is_first_strike:\n444\t            attacker_deals = has_first or has_double\n445\t        else:\n446\t            attacker_deals = not has_first or has_double\n447\t\n448\t        # Skip if attacker is no longer on the battlefield\n449\t        if attacker_deals:\n450\t            controller = getattr(attacker, \"controller\", None)\n451\t            if controller is not None:\n452\t                bf = controller.zones[Zone.BATTLEFIELD]\n453\t                if not bf.contains(attacker):\n454\t                    attacker_deals = False\n455\t\n456\t        defending_player = combat.attackers[attacker]\n457\t        blocker_list = combat.attacker_blockers.get(attacker, [])\n458\t        attacker_kw = getattr(attacker, \"keywords\", Keyword(0))\n459\t\n460\t        if attacker_deals:\n461\t            power = getattr(attacker, \"power\", 0)\n462\t\n463\t            # Check if attacker was blocked.  Per MTG rule 509.1h, a blocked\n464\t            # creature stays blocked even if all its blockers are removed.\n465\t            is_blocked = attacker in combat.was_blocked\n466\t\n467\t            if not is_blocked and not blocker_list:\n468\t                # Truly unblocked → damage to defending player\n469\t                _deal_damage(attacker, defending_player, power, game, combat)\n470\t            elif is_blocked and not blocker_list:\n471\t                # Was blocked but all blockers removed.\n472\t                # Without trample: deals no damage.\n473\t                # With trample: all damage tramples to defending player.\n474\t                has_trample = Keyword.TRAMPLE in attacker_kw\n475\t                if has_trample:\n476\t                    _deal_damage(attacker, defending_player, power, game, combat)\n477\t                # else: no damage dealt\n478\t            else:\n479\t                # Blocked → assign damage to blockers in order\n480\t                has_trample = Keyword.TRAMPLE in attacker_kw\n481\t                remaining_damage = power\n482\t\n483\t                for i, blocker in enumerate(blocker_list):\n484\t                    if remaining_damage <= 0:\n485\t                        break\n486\t\n487\t                    lethal = _get_lethal_damage(blocker, attacker)\n488\t\n489\t                    if i < len(blocker_list) - 1:\n490\t                        # Not the last blocker — assign lethal damage\n491\t                        assign = min(lethal, remaining_damage)\n492\t                    else:\n493\t                        # Last blocker\n494\t                        if has_trample:\n495\t                            # With trample: assign lethal, rest tramples through\n496\t                            assign = min(lethal, remaining_damage)\n497\t                        else:\n498\t                            # Without trample: all remaining damage to last blocker\n499\t                            assign = remaining_damage\n500\t\n501\t                    _deal_damage(attacker, blocker, assign, game, combat)\n502\t                    remaining_damage -= assign\n503\t\n504\t                # Trample: excess damage to defending player\n505\t                if has_trample and remaining_damage > 0:\n506\t                    _deal_damage(attacker, defending_player, remaining_damage, game, combat)\n507\t\n508\t        # Blockers deal damage back to the attacker\n509\t        for blocker in blocker_list:\n510\t            if id(blocker) not in blockers_dealt:\n511\t                blocker_kw = getattr(blocker, \"keywords\", Keyword(0))\n512\t                blocker_has_first = Keyword.FIRST_STRIKE in blocker_kw\n513\t                blocker_has_double = Keyword.DOUBLE_STRIKE in blocker_kw\n514\t\n515\t                # Determine if this blocker deals damage in this sub-step\n516\t                if is_first_strike:\n517\t                    should_deal = blocker_has_first or blocker_has_double\n518\t                else:\n519\t                    should_deal = not blocker_has_first or blocker_has_double\n520\t\n521\t                # Skip if blocker is no longer on the battlefield\n522\t                if should_deal:\n523\t                    blocker_ctrl = getattr(blocker, \"controller\", None)\n524\t                    if blocker_ctrl is not None:\n525\t                        bf = blocker_ctrl.zones[Zone.BATTLEFIELD]\n526\t                        if not bf.contains(blocker):\n527\t                            should_deal = False\n528\t\n529\t                if should_deal:\n530\t                    blocker_power = getattr(blocker, \"power\", 0)\n531\t                    _deal_damage(blocker, attacker, blocker_power, game, combat)\n532\t                    blockers_dealt.add(id(blocker))\n533\t\n534\t\n535\tdef end_combat_step(game: GameState) -> None:\n536\t    \"\"\"End combat step: remove from combat and clear combat state.\n537\t\n538\t    Resets ``is_attacking`` and ``is_blocking`` flags on all creatures\n539\t    and clears the combat state.\n540\t\n541\t    Parameters:\n542\t        game: The current game state.\n543\t    \"\"\"\n544\t    combat = game.combat_state\n545\t\n546\t    # Clear combat flags on all attackers\n547\t    for attacker in combat.attackers:\n548\t        if hasattr(attacker, \"is_attacking\"):\n549\t            attacker.is_attacking = False\n550\t\n551\t    # Clear combat flags on all blockers\n552\t    for blocker in combat.blockers:\n553\t        if hasattr(blocker, \"is_blocking\"):\n554\t            blocker.is_blocking = False\n555\t\n556\t    combat.clear()\n557\t"}]},"parent_tool_use_id":null,"session_id":"f8a3aed6-12f8-4341-9631-2336f98abe5d","uuid":"e27aa557-b821-4ff6-a01f-27ad85c59b86","timestamp":"2026-06-04T05:47:36.334Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/engine/combat.py","content":"\"\"\"Combat system: declare attackers → declare blockers → damage → end combat.\n\nImplements the four substeps of the MTG combat phase:\n\n1. **Declare Attackers** — Active player chooses creatures to attack with.\n   Attackers are tapped (unless they have vigilance).  Creatures with\n   summoning sickness (without haste) or the defender keyword cannot attack.\n\n2. **Declare Blockers** — Defending player assigns blockers.  Creatures\n   with flying can only be blocked by creatures with flying or reach.\n   Creatures with menace require 2+ blockers.  The attacker's controller\n   orders the blockers for damage assignment.\n\n3. **Combat Damage** — First strike / double strike creatures deal damage\n   first, then state-based actions are checked, then normal damage.\n   Trample excess goes to the defending player.  Lifelink heals the\n   controller.  Deathtouch makes any nonzero damage lethal.  Unblocked\n   attackers deal damage to the defending player.\n\n4. **End Combat** — Clear all combat state.\n\nReferences: MTG Comprehensive Rules §506–§511.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom typing import TYPE_CHECKING, Any\n\nfrom engine.types import Keyword\n\nif TYPE_CHECKING:\n    from engine.game_state import GameState\n    from engine.player import Player\n\n\n# ---------------------------------------------------------------------------\n# CombatState — tracks all per-combat information\n# ---------------------------------------------------------------------------\n\n@dataclass\nclass CombatState:\n    \"\"\"Tracks attackers, blockers, damage assignments, and block ordering.\n\n    Attributes:\n        attackers: Mapping of attacking creature → defending player.\n        blockers: Mapping of blocking creature → list of attackers it blocks.\n        attacker_blockers: Mapping of attacking creature → ordered list of\n            blockers assigned to it (order used for damage assignment).\n        damage_assignments: Mapping of creature → list of\n            ``(target, amount)`` tuples describing how damage is assigned.\n        was_blocked: Set of attackers that were declared as blocked.  Per\n            MTG rule 509.1h, once a creature is blocked it stays blocked\n            even if all its blockers are removed before damage.\n        in_combat: Whether the combat phase is currently active.\n    \"\"\"\n\n    attackers: dict[Any, Player] = field(default_factory=dict)\n    blockers: dict[Any, list[Any]] = field(default_factory=dict)\n    attacker_blockers: dict[Any, list[Any]] = field(default_factory=dict)\n    damage_assignments: dict[Any, list[tuple[Any, int]]] = field(default_factory=dict)\n    was_blocked: set[Any] = field(default_factory=set)\n    in_combat: bool = False\n\n    def clear(self) -> None:\n        \"\"\"Reset all combat state.\"\"\"\n        self.attackers.clear()\n        self.blockers.clear()\n        self.attacker_blockers.clear()\n        self.damage_assignments.clear()\n        self.was_blocked.clear()\n        self.in_combat = False\n\n\n# ---------------------------------------------------------------------------\n# Helpers\n# ---------------------------------------------------------------------------\n\ndef _can_attack(creature: Any) -> bool:\n    \"\"\"Return ``True`` if *creature* is eligible to be declared as an attacker.\n\n    A creature cannot attack if:\n    - It is already tapped.\n    - It has the ``DEFENDER`` keyword.\n    - It has summoning sickness (``summoning_sick``) and does not have ``HASTE``.\n    - A continuous effect has set ``_cant_attack`` (e.g. Pacifism).\n    \"\"\"\n    if getattr(creature, \"is_tapped\", False):\n        return False\n\n    # Check for \"can't attack\" restriction (set by continuous effects like Pacifism)\n    if getattr(creature, \"_cant_attack\", False):\n        return False\n\n    keywords = getattr(creature, \"keywords\", Keyword(0))\n\n    if Keyword.DEFENDER in keywords:\n        return False\n\n    if getattr(creature, \"summoning_sick\", False) and Keyword.HASTE not in keywords:\n        return False\n\n    return True\n\n\ndef _can_block(blocker: Any, attacker: Any) -> bool:\n    \"\"\"Return ``True`` if *blocker* can legally block *attacker*.\n\n    Checks:\n    - If the blocker is tapped it cannot block.\n    - A continuous effect has set ``_cant_block`` (e.g. Pacifism).\n    - If the attacker has flying, the blocker must have flying or reach.\n    \"\"\"\n    if getattr(blocker, \"is_tapped\", False):\n        return False\n\n    # Check for \"can't block\" restriction (set by continuous effects like Pacifism)\n    if getattr(blocker, \"_cant_block\", False):\n        return False\n\n    attacker_kw = getattr(attacker, \"keywords\", Keyword(0))\n    blocker_kw = getattr(blocker, \"keywords\", Keyword(0))\n\n    # Flying check\n    if Keyword.FLYING in attacker_kw:\n        if Keyword.FLYING not in blocker_kw and Keyword.REACH not in blocker_kw:\n            return False\n\n    # Protection check — attacker with protection from blocker can't be blocked\n    from engine.protection import has_protection_from\n\n    if has_protection_from(attacker, blocker):\n        return False\n\n    return True\n\n\ndef _get_lethal_damage(creature: Any, attacker: Any | None = None) -> int:\n    \"\"\"Return the amount of damage needed to lethally assign to *creature*.\n\n    If *attacker* has deathtouch, 1 damage is lethal.\n    Otherwise it's ``toughness - damage_marked`` (at least 1).\n    \"\"\"\n    if attacker is not None:\n        attacker_kw = getattr(attacker, \"keywords\", Keyword(0))\n        if Keyword.DEATHTOUCH in attacker_kw:\n            return 1\n\n    toughness = getattr(creature, \"toughness\", 0)\n    damage_marked = getattr(creature, \"damage_marked\", 0)\n    return max(1, toughness - damage_marked)\n\n\ndef _deal_damage(\n    source: Any,\n    target: Any,\n    amount: int,\n    game: GameState,\n    combat_state: CombatState,\n) -> None:\n    \"\"\"Apply *amount* damage from *source* to *target*.\n\n    If *target* is a player, reduces life.\n    If *target* is a creature, marks damage on it.\n    If *source* has lifelink, the controller gains that much life.\n\n    Protection prevents damage from sources with the protected-from quality.\n    \"\"\"\n    if amount <= 0:\n        return\n\n    # Protection prevents damage (D in DEBT).\n    from engine.protection import has_protection_from\n\n    if has_protection_from(target, source):\n        return\n\n    # Record damage assignment\n    if source not in combat_state.damage_assignments:\n        combat_state.damage_assignments[source] = []\n    combat_state.damage_assignments[source].append((target, amount))\n\n    # Apply damage\n    if hasattr(target, \"life\"):\n        # Target is a player\n        target.life -= amount\n    elif hasattr(target, \"damage_marked\"):\n        # Target is a creature\n        target.damage_marked += amount\n\n        # Track deathtouch damage for SBA rule 704.5h\n        source_kw_dt = getattr(source, \"keywords\", Keyword(0))\n        if Keyword.DEATHTOUCH in source_kw_dt:\n            target.dealt_deathtouch_damage = True\n\n    # Lifelink: controller gains life equal to damage dealt\n    source_kw = getattr(source, \"keywords\", Keyword(0))\n    if Keyword.LIFELINK in source_kw:\n        controller = getattr(source, \"controller\", None)\n        if controller is not None and hasattr(controller, \"life\"):\n            controller.life += amount\n\n\n# ---------------------------------------------------------------------------\n# Combat steps\n# ---------------------------------------------------------------------------\n\ndef declare_attackers_step(game: GameState) -> None:\n    \"\"\"Declare attackers step: active player chooses creatures to attack with.\n\n    The active player is asked (via :meth:`Player.choose`) to select a set\n    of creatures to attack with.  Each chosen attacker is tapped (unless it\n    has vigilance) and its ``is_attacking`` flag is set.\n\n    Parameters:\n        game: The current game state.  ``game.combat_state`` must exist.\n    \"\"\"\n    combat = game.combat_state\n    combat.in_combat = True\n    active = game.active_player\n    defending = game.non_active_player\n\n    # Gather legal attackers from the active player's battlefield\n    from engine.types import Zone\n    bf = active.zones[Zone.BATTLEFIELD]\n    eligible = [\n        c for c in bf.get_all()\n        if hasattr(c, \"base_power\") and _can_attack(c)\n    ]\n\n    if not eligible:\n        return\n\n    # Active player chooses which creatures to attack with\n    chosen = active.choose(eligible, \"declare attackers\")\n\n    # Normalize to a list\n    if chosen is None:\n        return\n    if not isinstance(chosen, list):\n        chosen = [chosen]\n\n    # Validate and register attackers\n    for attacker in chosen:\n        if attacker not in eligible:\n            continue\n        if not _can_attack(attacker):\n            continue\n\n        combat.attackers[attacker] = defending\n        combat.attacker_blockers[attacker] = []\n        attacker.is_attacking = True\n\n        # Tap the attacker unless it has vigilance\n        kw = getattr(attacker, \"keywords\", Keyword(0))\n        if Keyword.VIGILANCE not in kw:\n            attacker.is_tapped = True\n\n\ndef declare_blockers_step(game: GameState) -> None:\n    \"\"\"Declare blockers step: defending player assigns blockers.\n\n    The defending player is asked (via :meth:`Player.choose`) to assign\n    blockers.  The expected format is a dict mapping blocker → attacker\n    (or blocker → list of attackers for multi-blocking scenarios), but\n    commonly blocker → attacker.\n\n    After blockers are assigned:\n    - Menace check: attackers with menace must be blocked by 2+ creatures.\n    - Flying/reach check is already handled by ``_can_block``.\n    - The attacking player orders blockers for each attacker (for damage\n      assignment).\n\n    Parameters:\n        game: The current game state.\n    \"\"\"\n    combat = game.combat_state\n\n    if not combat.attackers:\n        return\n\n    defending = game.non_active_player\n    active = game.active_player\n\n    from engine.types import Zone\n    bf_defending = defending.zones[Zone.BATTLEFIELD]\n    eligible_blockers = [\n        c for c in bf_defending.get_all()\n        if hasattr(c, \"base_power\") and not getattr(c, \"is_tapped\", False)\n    ]\n\n    if not eligible_blockers:\n        return\n\n    # Defending player chooses block assignments\n    # Expected format: dict mapping blocker → attacker (or list of attackers)\n    block_assignments = defending.choose(\n        eligible_blockers,\n        \"declare blockers\",\n    )\n\n    if block_assignments is None:\n        return\n\n    if not isinstance(block_assignments, dict):\n        return\n\n    # Process block assignments\n    for blocker, target in block_assignments.items():\n        # Validate that the blocker is in the eligible set\n        if blocker not in eligible_blockers:\n            continue\n        targets = target if isinstance(target, list) else [target]\n        valid_targets = []\n        max_blocked = getattr(blocker, \"_max_attackers_blocked\", 1)\n        for attacker in targets:\n            if len(valid_targets) >= max_blocked:\n                break\n            if attacker in combat.attackers and _can_block(blocker, attacker):\n                valid_targets.append(attacker)\n        if valid_targets:\n            combat.blockers[blocker] = valid_targets\n            blocker.is_blocking = True\n            for attacker in valid_targets:\n                if attacker not in combat.attacker_blockers:\n                    combat.attacker_blockers[attacker] = []\n                combat.attacker_blockers[attacker].append(blocker)\n\n    # Menace check: attackers with menace that have fewer than 2 blockers\n    # are treated as unblocked (remove the single blocker assignment).\n    for attacker, blocker_list in list(combat.attacker_blockers.items()):\n        kw = getattr(attacker, \"keywords\", Keyword(0))\n        if Keyword.MENACE in kw and len(blocker_list) < 2 and len(blocker_list) > 0:\n            # Illegal block — remove these blockers\n            for b in blocker_list:\n                if b in combat.blockers:\n                    combat.blockers[b] = [\n                        a for a in combat.blockers[b] if a is not attacker\n                    ]\n                    if not combat.blockers[b]:\n                        del combat.blockers[b]\n                        b.is_blocking = False\n            combat.attacker_blockers[attacker] = []\n\n    # Mark attackers that have at least one blocker as \"was_blocked\".\n    # Per MTG rule 509.1h, once a creature is blocked it remains blocked\n    # even if all its blockers are removed before the damage step.\n    for attacker, blocker_list in combat.attacker_blockers.items():\n        if blocker_list:\n            combat.was_blocked.add(attacker)\n\n    # Controller of each attacker orders the blockers for damage assignment\n    for attacker, blocker_list in combat.attacker_blockers.items():\n        if len(blocker_list) > 1:\n            controller = getattr(attacker, \"controller\", active)\n            ordered = controller.assign_damage_order(blocker_list)\n            combat.attacker_blockers[attacker] = ordered\n\n\ndef combat_damage_step(game: GameState) -> None:\n    \"\"\"Combat damage step: deal combat damage.\n\n    Handles:\n    - First strike / double strike creatures deal damage first.\n    - State-based actions are checked between first-strike and normal damage.\n    - Trample: excess damage over blocker toughness → defending player.\n    - Lifelink: controller gains life equal to damage dealt.\n    - Deathtouch: any damage is lethal (1 damage = lethal assignment).\n    - Unblocked attackers deal damage to defending player.\n\n    Parameters:\n        game: The current game state.\n    \"\"\"\n    from engine.state_based_actions import resolve_state_based_actions\n\n    combat = game.combat_state\n\n    if not combat.attackers:\n        return\n\n    all_attackers = list(combat.attackers.keys())\n\n    # Determine if a first-strike damage sub-step is needed\n    # Check both attackers and blockers for first strike / double strike\n    all_blockers = set()\n    for blocker_list in combat.attacker_blockers.values():\n        all_blockers.update(blocker_list)\n\n    has_first_strike_step = any(\n        Keyword.FIRST_STRIKE in getattr(c, \"keywords\", Keyword(0))\n        or Keyword.DOUBLE_STRIKE in getattr(c, \"keywords\", Keyword(0))\n        for c in list(all_attackers) + list(all_blockers)\n    )\n\n    # --- First strike damage sub-step ---\n    if has_first_strike_step:\n        _assign_combat_damage(all_attackers, combat, game, is_first_strike=True)\n        resolve_state_based_actions(game)\n\n    # --- Normal damage sub-step ---\n    _assign_combat_damage(all_attackers, combat, game, is_first_strike=False)\n    resolve_state_based_actions(game)\n\n\ndef _assign_combat_damage(\n    attackers: list[Any],\n    combat: CombatState,\n    game: GameState,\n    *,\n    is_first_strike: bool = False,\n) -> None:\n    \"\"\"Assign and deal combat damage for a set of attackers.\n\n    For each attacker:\n    - If unblocked → damage to defending player.\n    - If blocked → damage assigned to blockers in order.  With trample,\n      excess damage goes to the defending player.\n    - Blockers deal damage back to the attacker they block.\n\n    When *is_first_strike* is ``True``, only creatures with\n    ``FIRST_STRIKE`` or ``DOUBLE_STRIKE`` deal damage (both attackers\n    and blockers).  When ``False``, only creatures *without*\n    ``FIRST_STRIKE`` deal damage (plus ``DOUBLE_STRIKE`` creatures,\n    which participate in both steps).  Blockers that are no longer on\n    the battlefield (e.g. killed by first-strike damage and removed by\n    SBAs) are skipped.\n    \"\"\"\n    from engine.types import Zone\n\n    # Track which blockers have already dealt their damage this sub-step\n    # (blockers only deal damage once even if blocking multiple attackers)\n    blockers_dealt: set[int] = set()\n\n    for attacker in attackers:\n        if attacker not in combat.attackers:\n            continue\n\n        kw = getattr(attacker, \"keywords\", Keyword(0))\n        has_first = Keyword.FIRST_STRIKE in kw\n        has_double = Keyword.DOUBLE_STRIKE in kw\n\n        # Determine if this attacker deals damage in this sub-step\n        if is_first_strike:\n            attacker_deals = has_first or has_double\n        else:\n            attacker_deals = not has_first or has_double\n\n        # Skip if attacker is no longer on the battlefield\n        if attacker_deals:\n            controller = getattr(attacker, \"controller\", None)\n            if controller is not None:\n                bf = controller.zones[Zone.BATTLEFIELD]\n                if not bf.contains(attacker):\n                    attacker_deals = False\n\n        defending_player = combat.attackers[attacker]\n        blocker_list = combat.attacker_blockers.get(attacker, [])\n        attacker_kw = getattr(attacker, \"keywords\", Keyword(0))\n\n        if attacker_deals:\n            power = getattr(attacker, \"power\", 0)\n\n            # Check if attacker was blocked.  Per MTG rule 509.1h, a blocked\n            # creature stays blocked even if all its blockers are removed.\n            is_blocked = attacker in combat.was_blocked\n\n            if not is_blocked and not blocker_list:\n                # Truly unblocked → damage to defending player\n                _deal_damage(attacker, defending_player, power, game, combat)\n            elif is_blocked and not blocker_list:\n                # Was blocked but all blockers removed.\n                # Without trample: deals no damage.\n                # With trample: all damage tramples to defending player.\n                has_trample = Keyword.TRAMPLE in attacker_kw\n                if has_trample:\n                    _deal_damage(attacker, defending_player, power, game, combat)\n                # else: no damage dealt\n            else:\n                # Blocked → assign damage to blockers in order\n                has_trample = Keyword.TRAMPLE in attacker_kw\n                remaining_damage = power\n\n                for i, blocker in enumerate(blocker_list):\n                    if remaining_damage <= 0:\n                        break\n\n                    lethal = _get_lethal_damage(blocker, attacker)\n\n                    if i < len(blocker_list) - 1:\n                        # Not the last blocker — assign lethal damage\n                        assign = min(lethal, remaining_damage)\n                    else:\n                        # Last blocker\n                        if has_trample:\n                            # With trample: assign lethal, rest tramples through\n                            assign = min(lethal, remaining_damage)\n                        else:\n                            # Without trample: all remaining damage to last blocker\n                            assign = remaining_damage\n\n                    _deal_damage(attacker, blocker, assign, game, combat)\n                    remaining_damage -= assign\n\n                # Trample: excess damage to defending player\n                if has_trample and remaining_damage > 0:\n                    _deal_damage(attacker, defending_player, remaining_damage, game, combat)\n\n        # Blockers deal damage back to the attacker\n        for blocker in blocker_list:\n            if id(blocker) not in blockers_dealt:\n                blocker_kw = getattr(blocker, \"keywords\", Keyword(0))\n                blocker_has_first = Keyword.FIRST_STRIKE in blocker_kw\n                blocker_has_double = Keyword.DOUBLE_STRIKE in blocker_kw\n\n                # Determine if this blocker deals damage in this sub-step\n                if is_first_strike:\n                    should_deal = blocker_has_first or blocker_has_double\n                else:\n                    should_deal = not blocker_has_first or blocker_has_double\n\n                # Skip if blocker is no longer on the battlefield\n                if should_deal:\n                    blocker_ctrl = getattr(blocker, \"controller\", None)\n                    if blocker_ctrl is not None:\n                        bf = blocker_ctrl.zones[Zone.BATTLEFIELD]\n                        if not bf.contains(blocker):\n                            should_deal = False\n\n                if should_deal:\n                    blocker_power = getattr(blocker, \"power\", 0)\n                    _deal_damage(blocker, attacker, blocker_power, game, combat)\n                    blockers_dealt.add(id(blocker))\n\n\ndef end_combat_step(game: GameState) -> None:\n    \"\"\"End combat step: remove from combat and clear combat state.\n\n    Resets ``is_attacking`` and ``is_blocking`` flags on all creatures\n    and clears the combat state.\n\n    Parameters:\n        game: The current game state.\n    \"\"\"\n    combat = game.combat_state\n\n    # Clear combat flags on all attackers\n    for attacker in combat.attackers:\n        if hasattr(attacker, \"is_attacking\"):\n            attacker.is_attacking = False\n\n    # Clear combat flags on all blockers\n    for blocker in combat.blockers:\n        if hasattr(blocker, \"is_blocking\"):\n            blocker.is_blocking = False\n\n    combat.clear()\n","numLines":557,"startLine":1,"totalLines":557}}}
