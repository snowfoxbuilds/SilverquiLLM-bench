+# ------------------------------------------------------------------
+# Cast spell for a specified alternative cost (e.g. miracle)
+# ------------------------------------------------------------------
+
+
+def cast_spell_alternative(
+    game: GameState,
+    player: Player,
+    card: CardImpl,
+    from_zone: Zone,
+    alternative_cost: ManaCost,
+) -> None:
+    """Cast *card* by paying *alternative_cost* instead of its mana cost.
+
+    This is the entry point for alternative-cost casts such as miracle, where a
+    card is cast "by paying [cost] rather than its mana cost" (rule 702.94a).
+    It mirrors :func:`cast_spell` (legality, target choice, mana payment, the
+    ``on_cast`` hook, and pushing a :class:`StackObject`) but:
+
+    * the card may come from any *from_zone* (not just the hand), and
+    * mana payment uses *alternative_cost* rather than ``card.mana_cost``.
+
+    No timing or sorcery-speed check is performed here — the caller (a miracle
+    window, etc.) is responsible for invoking this only at a legal time. The
+    spell is placed on the stack and can be responded to normally.
+
+    Raises:
+        CastingError: If legality fails or the player cannot pay
+            *alternative_cost* (the card is rolled back to *from_zone*).
+    """
+    # Ensure controller/owner are set.
+    card.controller = player
+    if card.owner is None:
+        card.owner = player
+
+    # 1. can_cast legality.
+    if not card.can_cast(game):
+        raise CastingError(f"Cannot cast {card.name!r} — can_cast returned False")
+
+    # 2. Locate the card in its source zone.
+    source_zone_container = player.zones[from_zone]
+    if not source_zone_container.contains(card):
+        source_zone_container = None
+        for p in game.players:
+            z = p.zones[from_zone]
+            if z.contains(card):
+                source_zone_container = z
+                break
+    if source_zone_container is None or not source_zone_container.contains(card):
+        raise CastingError(
+            f"Cannot cast {card.name!r} — card not found in {from_zone.name}"
+        )
+
+    # Move card from source zone to the stack zone.
+    stack_zone = player.zones[Zone.STACK]
+    source_zone_container.remove(card)
+    stack_zone.add(card)
+
+    # Clear stale colors_spent before new payment.
+    if hasattr(card, "colors_spent"):
+        del card.colors_spent
+
+    # 3. Choose targets (with rollback on failure).
+    try:
+        target_specs = card.get_targets(game)
+        chosen_targets: list[Any] = []
+        if target_specs:
+            for spec in target_specs:
+                target = player.choose_target(target_specs, spec)
+                filter_fn = getattr(spec, "filter_fn", None)
+                if filter_fn is not None and target is not None:
+                    if not filter_fn(target):
+                        raise CastingError(
+                            f"Cannot cast {card.name!r} — chosen target does not "
+                            f"satisfy filter: {getattr(spec, 'description', '')}"
+                        )
+                chosen_targets.append(target)
+
+        from engine.protection import has_protection_from
+
+        for target in chosen_targets:
+            if has_protection_from(target, card):
+                raise CastingError(
+                    f"Cannot cast {card.name!r} — target has protection from this spell"
+                )
+    except Exception as exc:
+        stack_zone.remove(card)
+        source_zone_container.add(card)
+        raise CastingError(str(exc)) from exc
+
+    # 4. Mana check / payment against the alternative cost (rollback on failure).
+    if not player.mana_pool.can_pay(alternative_cost):
+        stack_zone.remove(card)
+        source_zone_container.add(card)
+        raise CastingError(
+            f"Cannot cast {card.name!r} — insufficient mana for alternative cost"
+        )
+
+    player.mana_pool.pay(alternative_cost)
+    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]
+    card.mana_spent = alternative_cost.cmc  # type: ignore[attr-defined]
+
+    # 5. Call on_cast hook.
+    card.on_cast(game)
+
+    # 6. Push StackObject.
+    stack_obj = StackObject(
+        source=card,
+        controller=player,
         targets=chosen_targets,
         on_resolve=lambda g: None,  # replaced below
     )
