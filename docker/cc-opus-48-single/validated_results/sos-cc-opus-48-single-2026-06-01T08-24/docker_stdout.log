{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KM7MGKRP27SURqd6m7Rqeb","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_120/card_impl.py b/cards/sos/sos_120/card_impl.py\n2\tindex fd0c1f4..9c184d0 100644\n3\t--- a/cards/sos/sos_120/card_impl.py\n4\t+++ b/cards/sos/sos_120/card_impl.py\n5\t@@ -1,16 +1,171 @@\n6\t-\"\"\"Card implementation for Improvisation Capstone.\"\"\"\n7\t+\"\"\"Card implementation for Improvisation Capstone (SOS 120).\"\"\"\n8\t \n9\t from __future__ import annotations\n10\t \n11\t-from engine.card import CardImpl\n12\t+from typing import TYPE_CHECKING, Any\n13\t \n14\t-from typing import TYPE_CHECKING\n15\t+from engine.card import Sorcery\n16\t+from engine.types import CardType, ManaCost, Zone\n17\t \n18\t if TYPE_CHECKING:\n19\t     from engine.game_state import GameState\n20\t \n21\t \n22\t-class ImprovisationCapstone(CardImpl):\n23\t-    \"\"\"TODO: Implement Improvisation Capstone.\"\"\"\n24\t+def _is_castable_spell(card: Any) -> bool:\n25\t+    \"\"\"Return ``True`` if *card* can be cast as a spell (instant or sorcery).\n26\t \n27\t-    pass\n28\t+    Lands are never spells, and permanents like creatures/enchantments would\n29\t+    require timing/legality the free-cast among-exiled clause does not model\n30\t+    here, so we restrict the free-cast to instants and sorceries.\n31\t+    \"\"\"\n32\t+    types = getattr(card, \"card_types\", set()) or set()\n33\t+    return CardType.INSTANT in types or CardType.SORCERY in types\n34\t+\n35\t+\n36\t+def _mana_value(card: Any) -> int:\n37\t+    \"\"\"Return the mana value (cmc) of *card*, defaulting to 0.\"\"\"\n38\t+    cost = getattr(card, \"mana_cost\", None)\n39\t+    if cost is None:\n40\t+        return 0\n41\t+    return getattr(cost, \"cmc\", 0)\n42\t+\n43\t+\n44\t+class ImprovisationCapstone(Sorcery):\n45\t+    \"\"\"Improvisation Capstone — {5}{R}{R} — Sorcery — Lesson.\n46\t+\n47\t+    Exile cards from the top of your library until you exile cards with total\n48\t+    mana value 4 or greater. You may cast any number of spells from among them\n49\t+    without paying their mana costs.\n50\t+\n51\t+    Paradigm (Then exile this spell. After you first resolve a spell with this\n52\t+    name, you may cast a copy of it from exile without paying its mana cost at\n53\t+    the beginning of each of your first main phases.)\n54\t+\n55\t+    SOS collector number 120.\n56\t+    \"\"\"\n57\t+\n58\t+    def __init__(self, **kwargs: Any) -> None:\n59\t+        kwargs.setdefault(\"name\", \"Improvisation Capstone\")\n60\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{5}{R}{R}\"))\n61\t+        kwargs.setdefault(\"subtypes\", {\"Lesson\"})\n62\t+        kwargs.setdefault(\n63\t+            \"rules_text\",\n64\t+            \"Exile cards from the top of your library until you exile cards \"\n65\t+            \"with total mana value 4 or greater. You may cast any number of \"\n66\t+            \"spells from among them without paying their mana costs.\\n\"\n67\t+            \"Paradigm (Then exile this spell. After you first resolve a spell \"\n68\t+            \"with this name, you may cast a copy of it from exile without \"\n69\t+            \"paying its mana cost at the beginning of each of your first main \"\n70\t+            \"phases.)\",\n71\t+        )\n72\t+        super().__init__(**kwargs)\n73\t+\n74\t+    def on_resolve(self, game: \"GameState\") -> None:\n75\t+        \"\"\"Exile from the top of the library to total MV >= 4, then free-cast.\n76\t+\n77\t+        The Paradigm \"exile this spell / recurring copy-cast from exile\" clause\n78\t+        is NOT implemented here — see the UNVERIFIED marker below.\n79\t+        \"\"\"\n80\t+        controller = getattr(self, \"controller\", None) or getattr(self, \"owner\", None)\n81\t+        if controller is None:\n82\t+            return\n83\t+\n84\t+        exiled = self._exile_until_total_four(game, controller)\n85\t+        self._free_cast_among(game, controller, exiled)\n86\t+\n87\t+        # UNVERIFIED: Paradigm (exile this spell; after first resolving a spell\n88\t+        # with this name, cast a copy of it from exile without paying its mana\n89\t+        # cost at the beginning of each of your first main phases) — requires\n90\t+        # copy-from-exile engine support (same gap marked UNVERIFIED for sos_13)\n91\t+        # plus a recurring name-keyed delayed trigger. No engine surface exists\n92\t+        # to model this without a large, fragile feature, so it is omitted.\n93\t+\n94\t+    # ------------------------------------------------------------------\n95\t+    # Exile-until-total-MV-4\n96\t+    # ------------------------------------------------------------------\n97\t+\n98\t+    def _exile_until_total_four(\n99\t+        self, game: \"GameState\", controller: Any\n100\t+    ) -> list[Any]:\n101\t+        \"\"\"Exile cards from the top of *controller*'s library until the running\n102\t+        total mana value reaches 4 or greater. Returns the exiled cards.\"\"\"\n103\t+        from engine.game import exile as _exile\n104\t+\n105\t+        library = game.get_library(controller)\n106\t+        exiled: list[Any] = []\n107\t+        total = 0\n108\t+        # Top of library is the last element of the internal list.\n109\t+        while total < 4 and len(library) > 0:\n110\t+            top_cards = library.top(1)\n111\t+            if not top_cards:\n112\t+                break\n113\t+            card = top_cards[-1]\n114\t+            total += _mana_value(card)\n115\t+            _exile(game, card)\n116\t+            exiled.append(card)\n117\t+        return exiled\n118\t+\n119\t+    # ------------------------------------------------------------------\n120\t+    # Free-cast among the exiled cards\n121\t+    # ------------------------------------------------------------------\n122\t+\n123\t+    def _free_cast_among(\n124\t+        self, game: \"GameState\", controller: Any, exiled: list[Any]\n125\t+    ) -> None:\n126\t+        \"\"\"Offer the controller to free-cast any number of the exiled spells.\n127\t+\n128\t+        The \"may cast any number\" is modeled as a loop: each iteration asks the\n129\t+        controller whether to cast another spell and, if so, which one. The loop\n130\t+        ends when the controller declines or no castable spells remain.\n131\t+        \"\"\"\n132\t+        from engine.casting import cast_spell_free\n133\t+\n134\t+        while True:\n135\t+            exile_zone = game.get_exile(controller)\n136\t+            candidates = [\n137\t+                c\n138\t+                for c in exiled\n139\t+                if _is_castable_spell(c) and exile_zone.contains(c)\n140\t+            ]\n141\t+            if not candidates:\n142\t+                return\n143\t+\n144\t+            if not self._wants_to_cast(controller):\n145\t+                return\n146\t+\n147\t+            choice = self._choose_spell(controller, candidates)\n148\t+            if choice is None or not exile_zone.contains(choice):\n149\t+                return\n150\t+\n151\t+            try:\n152\t+                cast_spell_free(game, controller, choice, Zone.EXILE)\n153\t+            except Exception:\n154\t+                # If a particular spell cannot be cast, stop rather than raise.\n155\t+                return\n156\t+\n157\t+    def _wants_to_cast(self, controller: Any) -> bool:\n158\t+        \"\"\"Ask the controller whether to free-cast another spell.\n159\t+\n160\t+        Defaults to ``False`` (decline) when the player has no decision method,\n161\t+        so resolution never blocks or raises in headless contexts.\n162\t+        \"\"\"\n163\t+        choose_yes_no = getattr(controller, \"choose_yes_no\", None)\n164\t+        if choose_yes_no is None:\n165\t+            return False\n166\t+        try:\n167\t+            return bool(choose_yes_no(\"Cast a spell from among the exiled cards?\"))\n168\t+        except Exception:\n169\t+            return False\n170\t+\n171\t+    def _choose_spell(self, controller: Any, candidates: list[Any]) -> Any:\n172\t+        \"\"\"Ask the controller which exiled spell to free-cast.\"\"\"\n173\t+        choose_card = getattr(controller, \"choose_card\", None)\n174\t+        if choose_card is None:\n175\t+            return None\n176\t+        try:\n177\t+            selection = choose_card(candidates, \"Choose a spell to cast for free\")\n178\t+        except Exception:\n179\t+            return None\n180\t+        if selection in candidates:\n181\t+            return selection\n182\t+        return None\n183\t"}]},"parent_tool_use_id":"toolu_017AGMNzioYKWCAQpAoWPvcJ","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"ccf82c4a-b468-4c9b-9e65-9c64a065226b","timestamp":"2026-06-01T09:32:52.368Z","subagent_type":"Reviewer","task_description":"Review sos_120"}
