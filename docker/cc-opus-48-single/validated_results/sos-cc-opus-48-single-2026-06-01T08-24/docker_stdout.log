{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MkpdCSRTjCkqLNz1eZLMuH","type":"tool_result","content":"1\t\"\"\"Tests for SOS 201 — Lorehold, the Historian.\n2\t\n3\tLorehold, the Historian is a {3}{R}{W} Legendary Creature — Elder Dragon,\n4\t5/5, with:\n5\t\n6\t1. **Flying, haste** — evergreen keywords (both in ``engine.types.Keyword``).\n7\t2. **Miracle granting** — \"Each instant and sorcery card in your hand has\n8\t   miracle {2}.\" Miracle is NOT in the ``Keyword`` enum (and per KEY_DECISIONS\n9\t   we must not extend that enum), so the card models it as a custom mechanic.\n10\t   The tests here exercise the *granting contract*: a queryable miracle cost of\n11\t   {2} for instants/sorceries in the controller's hand, and no miracle for\n12\t   non-instant/non-sorcery cards or for cards outside the controller's hand.\n13\t   The \"cast it when you draw it, if it's the first card you drew this turn\"\n14\t   timing has no engine surface and is recorded in ``untestable.json``.\n15\t3. **Opponent-upkeep loot trigger** — \"At the beginning of each opponent's\n16\t   upkeep, you may discard a card. If you do, draw a card.\" Modeled via\n17\t   ``register_triggers`` watching ``BeginningOfUpkeepTriggeredEvent`` with a\n18\t   condition that fires only when an opponent is the active player.\n19\t\n20\tThese tests define the TDD contract; ``card_impl.py`` is a stub, so they are\n21\texpected to fail until the card is implemented.\n22\t\"\"\"\n23\t\n24\tfrom __future__ import annotations\n25\t\n26\tfrom typing import Any\n27\t\n28\tfrom cards.sos.sos_201.card_impl import LoreholdTheHistorian\n29\tfrom engine.card import Creature, Instant, Sorcery\n30\tfrom engine.events import BeginningOfUpkeepTriggeredEvent\n31\tfrom engine.game import draw_card\n32\tfrom engine.triggers import TriggerRegistration\n33\tfrom engine.types import CardType, Keyword, ManaCost, ManaType, Supertype, Zone\n34\tfrom test_utils import create_game, set_board_state\n35\t\n36\t\n37\t# ---------------------------------------------------------------------------\n38\t# Helpers\n39\t# ---------------------------------------------------------------------------\n40\t\n41\t\n42\tdef _instant(name: str = \"Test Instant\") -> Instant:\n43\t    return Instant(name=name, mana_cost=ManaCost.parse(\"{1}{U}\"))\n44\t\n45\t\n46\tdef _sorcery(name: str = \"Test Sorcery\") -> Sorcery:\n47\t    return Sorcery(name=name, mana_cost=ManaCost.parse(\"{2}{R}\"))\n48\t\n49\t\n50\tdef _vanilla_creature(name: str = \"Grizzly Bears\") -> Creature:\n51\t    c = Creature(name=name, base_power=2, base_toughness=2)\n52\t    c.card_types = {CardType.CREATURE}\n53\t    return c\n54\t\n55\t\n56\tdef _filler_hand_card(name: str = \"Spare Card\") -> Sorcery:\n57\t    \"\"\"A discardable card so the loot trigger always has something to pitch.\"\"\"\n58\t    return Sorcery(name=name, mana_cost=ManaCost.parse(\"{1}\"))\n59\t\n60\t\n61\tdef _miracle_cost(card_obj: LoreholdTheHistorian, game: Any, target: Any) -> Any:\n62\t    \"\"\"Query Lorehold's granted miracle cost for *target*.\n63\t\n64\t    The implementation may expose this contract under any of a few reasonable\n65\t    names; this helper probes them so the tests stay decoupled from the exact\n66\t    method spelling while still asserting the {2} miracle grant.\n67\t    \"\"\"\n68\t    for attr in (\"get_miracle_cost\", \"miracle_cost_for\", \"granted_miracle_cost\"):\n69\t        fn = getattr(card_obj, attr, None)\n70\t        if callable(fn):\n71\t            return fn(game, target)\n72\t    raise AssertionError(\n73\t        \"Lorehold must expose a miracle-cost query \"\n74\t        \"(get_miracle_cost/miracle_cost_for/granted_miracle_cost)\"\n75\t    )\n76\t\n77\t\n78\t# ---------------------------------------------------------------------------\n79\t# Static card data\n80\t# ---------------------------------------------------------------------------\n81\t\n82\t\n83\tclass TestLoreholdProperties:\n84\t    \"\"\"Static card data should match the SOS 201 spec.\"\"\"\n85\t\n86\t    def test_is_creature(self) -> None:\n87\t        assert isinstance(LoreholdTheHistorian(owner=None), Creature)\n88\t\n89\t    def test_name(self) -> None:\n90\t        assert LoreholdTheHistorian(owner=None).name == \"Lorehold, the Historian\"\n91\t\n92\t    def test_mana_cost(self) -> None:\n93\t        assert LoreholdTheHistorian(owner=None).mana_cost == ManaCost.parse(\"{3}{R}{W}\")\n94\t\n95\t    def test_power_toughness(self) -> None:\n96\t        card = LoreholdTheHistorian(owner=None)\n97\t        assert card.base_power == 5\n98\t        assert card.base_toughness == 5\n99\t\n100\t    def test_is_legendary(self) -> None:\n101\t        assert Supertype.LEGENDARY in LoreholdTheHistorian(owner=None).supertypes\n102\t\n103\t    def test_is_elder_dragon(self) -> None:\n104\t        subtypes = LoreholdTheHistorian(owner=None).subtypes\n105\t        assert \"Elder\" in subtypes\n106\t        assert \"Dragon\" in subtypes\n107\t\n108\t    def test_has_flying(self) -> None:\n109\t        assert Keyword.FLYING in LoreholdTheHistorian(owner=None).keywords\n110\t\n111\t    def test_has_haste(self) -> None:\n112\t        assert Keyword.HASTE in LoreholdTheHistorian(owner=None).keywords\n113\t\n114\t    def test_is_red_white(self) -> None:\n115\t        \"\"\"Cost {3}{R}{W} — the card has both a red and a white pip.\"\"\"\n116\t        pips = LoreholdTheHistorian(owner=None).mana_cost.pips\n117\t        from engine.types import ManaType\n118\t\n119\t        assert pips.get(ManaType.RED, 0) >= 1\n120\t        assert pips.get(ManaType.WHITE, 0) >= 1\n121\t\n122\t\n123\t# ---------------------------------------------------------------------------\n124\t# Miracle granting\n125\t# ---------------------------------------------------------------------------\n126\t\n127\t\n128\tclass TestLoreholdMiracleGrant:\n129\t    \"\"\"Each instant and sorcery card in your hand has miracle {2}.\"\"\"\n130\t\n131\t    def test_instant_in_your_hand_gets_miracle_two(self) -> None:\n132\t        game = create_game()\n133\t        p1 = game.players[0]\n134\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n135\t        spell = _instant(\"Lightning Helix\")\n136\t        set_board_state(game, 0, battlefield=[lorehold], hand=[spell])\n137\t        cost = _miracle_cost(lorehold, game, spell)\n138\t        assert cost == ManaCost.parse(\"{2}\")\n139\t\n140\t    def test_sorcery_in_your_hand_gets_miracle_two(self) -> None:\n141\t        game = create_game()\n142\t        p1 = game.players[0]\n143\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n144\t        spell = _sorcery(\"Reconstruct History\")\n145\t        set_board_state(game, 0, battlefield=[lorehold], hand=[spell])\n146\t        cost = _miracle_cost(lorehold, game, spell)\n147\t        assert cost == ManaCost.parse(\"{2}\")\n148\t\n149\t    def test_creature_in_your_hand_gets_no_miracle(self) -> None:\n150\t        \"\"\"Miracle is granted only to instants and sorceries.\"\"\"\n151\t        game = create_game()\n152\t        p1 = game.players[0]\n153\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n154\t        creature = _vanilla_creature(\"Hill Giant\")\n155\t        set_board_state(game, 0, battlefield=[lorehold], hand=[creature])\n156\t        assert _miracle_cost(lorehold, game, creature) is None\n157\t\n158\t    def test_opponent_hand_spell_gets_no_miracle(self) -> None:\n159\t        \"\"\"The grant is restricted to cards in YOUR hand only.\"\"\"\n160\t        game = create_game()\n161\t        p1 = game.players[0]\n162\t        p2 = game.players[1]\n163\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n164\t        opp_spell = _instant(\"Opponent Bolt\")\n165\t        set_board_state(game, 0, battlefield=[lorehold])\n166\t        set_board_state(game, 1, hand=[opp_spell])\n167\t        assert _miracle_cost(lorehold, game, opp_spell) is None\n168\t\n169\t    def test_spell_in_graveyard_gets_no_miracle(self) -> None:\n170\t        \"\"\"Only cards in hand are granted miracle, not other zones.\"\"\"\n171\t        game = create_game()\n172\t        p1 = game.players[0]\n173\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n174\t        gy_spell = _instant(\"Graveyard Bolt\")\n175\t        set_board_state(game, 0, battlefield=[lorehold], graveyard=[gy_spell])\n176\t        assert _miracle_cost(lorehold, game, gy_spell) is None\n177\t\n178\t\n179\t# ---------------------------------------------------------------------------\n180\t# Opponent-upkeep loot trigger — registration\n181\t# ---------------------------------------------------------------------------\n182\t\n183\t\n184\tclass TestLoreholdLootTriggerRegistration:\n185\t    \"\"\"register_triggers wires a BeginningOfUpkeepTriggeredEvent trigger.\"\"\"\n186\t\n187\t    def test_registers_one_upkeep_trigger(self) -> None:\n188\t        game = create_game()\n189\t        p1 = game.players[0]\n190\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n191\t        before = len(game.trigger_manager.get_triggers())\n192\t        lorehold.register_triggers(game)\n193\t        after = len(game.trigger_manager.get_triggers())\n194\t        assert after - before == 1\n195\t\n196\t    def test_registered_trigger_watches_upkeep_event(self) -> None:\n197\t        game = create_game()\n198\t        p1 = game.players[0]\n199\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n200\t        lorehold.register_triggers(game)\n201\t        regs = game.trigger_manager.get_triggers_for_source(lorehold)\n202\t        assert len(regs) == 1\n203\t        reg = regs[0]\n204\t        assert isinstance(reg, TriggerRegistration)\n205\t        assert reg.event_type is BeginningOfUpkeepTriggeredEvent\n206\t\n207\t    def test_trigger_fires_on_opponent_upkeep(self) -> None:\n208\t        \"\"\"Condition is satisfied when an opponent is the active player.\"\"\"\n209\t        game = create_game()\n210\t        p1 = game.players[0]\n211\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n212\t        set_board_state(game, 0, battlefield=[lorehold])\n213\t        lorehold.register_triggers(game)\n214\t        reg = game.trigger_manager.get_triggers_for_source(lorehold)[0]\n215\t        # Opponent (player index 1) is the active player.\n216\t        game.active_player_index = 1\n217\t        if reg.condition is None:\n218\t            return\n219\t        assert reg.condition(game, BeginningOfUpkeepTriggeredEvent()) is True\n220\t\n221\t    def test_trigger_does_not_fire_on_own_upkeep(self) -> None:\n222\t        \"\"\"\"each opponent's upkeep\" — not the controller's own upkeep.\"\"\"\n223\t        game = create_game()\n224\t        p1 = game.players[0]\n225\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n226\t        set_board_state(game, 0, battlefield=[lorehold])\n227\t        lorehold.register_triggers(game)\n228\t        reg = game.trigger_manager.get_triggers_for_source(lorehold)[0]\n229\t        # Controller (player index 0) is the active player.\n230\t        game.active_player_index = 0\n231\t        if reg.condition is None:\n232\t            # An always-fire trigger would be wrong here; force a real check.\n233\t            raise AssertionError(\n234\t                \"Loot trigger must distinguish opponent upkeep from own upkeep\"\n235\t            )\n236\t        assert reg.condition(game, BeginningOfUpkeepTriggeredEvent()) is False\n237\t\n238\t\n239\t# ---------------------------------------------------------------------------\n240\t# Opponent-upkeep loot trigger — effect\n241\t# ---------------------------------------------------------------------------\n242\t\n243\t\n244\tdef _fire_opponent_upkeep(game: Any, lorehold: LoreholdTheHistorian) -> int:\n245\t    \"\"\"Register Lorehold's triggers, fire an opponent's upkeep, and resolve.\n246\t\n247\t    Returns the number of objects that were pushed onto the stack by the\n248\t    upkeep event — so tests can assert the loot trigger actually fired (a\n249\t    stub that registers nothing pushes zero and the assertion fails).\n250\t    \"\"\"\n251\t    lorehold.register_triggers(game)\n252\t    game.active_player_index = 1  # opponent is active\n253\t    game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n254\t    pushed = len(game.stack.objects())\n255\t    while not game.stack.is_empty():\n256\t        game.stack.pop().on_resolve(game)\n257\t    return pushed\n258\t\n259\t\n260\tclass TestLoreholdLootEffect:\n261\t    \"\"\"you may discard a card; if you do, draw a card.\"\"\"\n262\t\n263\t    def test_discard_then_draw_keeps_hand_size(self) -> None:\n264\t        \"\"\"Looting one card: hand size net-zero (pitch one, draw one).\"\"\"\n265\t        game = create_game()\n266\t        p1 = game.players[0]\n267\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n268\t        pitch = _filler_hand_card(\"Pitch Me\")\n269\t        library_card = _sorcery(\"Top of Library\")\n270\t        set_board_state(game, 0, battlefield=[lorehold], hand=[pitch])\n271\t        # Seed the library so the draw has a card to find.\n272\t        p1.zones[Zone.LIBRARY].add(library_card)\n273\t        # Script: choose to discard (yes), then choose which card to pitch.\n274\t        p1._script.appendleft(pitch)\n275\t        p1._script.appendleft(True)\n276\t\n277\t        before = len(game.get_hand(p1).get_all())\n278\t        pushed = _fire_opponent_upkeep(game, lorehold)\n279\t        after = len(game.get_hand(p1).get_all())\n280\t        # The loot trigger must actually fire on the opponent's upkeep.\n281\t        assert pushed >= 1\n282\t        # Net-zero: one discarded, one drawn.\n283\t        assert after == before\n284\t        assert game.get_graveyard(p1).contains(pitch)\n285\t        assert game.get_hand(p1).contains(library_card)\n286\t\n287\t    def test_discard_card_goes_to_graveyard(self) -> None:\n288\t        \"\"\"The discarded card ends up in the controller's graveyard.\"\"\"\n289\t        game = create_game()\n290\t        p1 = game.players[0]\n291\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n292\t        pitch = _filler_hand_card(\"Pitch Me\")\n293\t        library_card = _sorcery(\"Top of Library\")\n294\t        set_board_state(game, 0, battlefield=[lorehold], hand=[pitch])\n295\t        p1.zones[Zone.LIBRARY].add(library_card)\n296\t        p1._script.appendleft(pitch)\n297\t        p1._script.appendleft(True)\n298\t\n299\t        _fire_opponent_upkeep(game, lorehold)\n300\t        assert game.get_graveyard(p1).contains(pitch)\n301\t\n302\t    def test_drawn_card_enters_hand(self) -> None:\n303\t        \"\"\"The looted draw moves the top library card into hand.\"\"\"\n304\t        game = create_game()\n305\t        p1 = game.players[0]\n306\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n307\t        pitch = _filler_hand_card(\"Pitch Me\")\n308\t        library_card = _sorcery(\"Top of Library\")\n309\t        set_board_state(game, 0, battlefield=[lorehold], hand=[pitch])\n310\t        p1.zones[Zone.LIBRARY].add(library_card)\n311\t        p1._script.appendleft(pitch)\n312\t        p1._script.appendleft(True)\n313\t\n314\t        _fire_opponent_upkeep(game, lorehold)\n315\t        assert game.get_hand(p1).contains(library_card)\n316\t        assert not p1.zones[Zone.LIBRARY].contains(library_card)\n317\t\n318\t    def test_declining_discard_draws_nothing(self) -> None:\n319\t        \"\"\"\"you may discard\" — declining means no discard and no draw.\"\"\"\n320\t        game = create_game()\n321\t        p1 = game.players[0]\n322\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n323\t        pitch = _filler_hand_card(\"Keep Me\")\n324\t        library_card = _sorcery(\"Top of Library\")\n325\t        set_board_state(game, 0, battlefield=[lorehold], hand=[pitch])\n326\t        p1.zones[Zone.LIBRARY].add(library_card)\n327\t        # Script: decline (no).\n328\t        p1._script.appendleft(False)\n329\t\n330\t        pushed = _fire_opponent_upkeep(game, lorehold)\n331\t        # The trigger must still fire on the opponent's upkeep (it is a \"may\").\n332\t        assert pushed >= 1\n333\t        # Card kept in hand, library untouched (no draw), nothing discarded.\n334\t        assert game.get_hand(p1).contains(pitch)\n335\t        assert p1.zones[Zone.LIBRARY].contains(library_card)\n336\t        assert not game.get_graveyard(p1).contains(pitch)\n337\t\n338\t    def test_empty_hand_is_a_noop(self) -> None:\n339\t        \"\"\"With no card to discard, the trigger does nothing and does not raise.\"\"\"\n340\t        game = create_game()\n341\t        p1 = game.players[0]\n342\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n343\t        library_card = _sorcery(\"Top of Library\")\n344\t        set_board_state(game, 0, battlefield=[lorehold], hand=[])\n345\t        p1.zones[Zone.LIBRARY].add(library_card)\n346\t        # Decline (or there is simply nothing to discard).\n347\t        p1._script.appendleft(False)\n348\t\n349\t        pushed = _fire_opponent_upkeep(game, lorehold)\n350\t        # The trigger still fires on the opponent's upkeep even with an empty hand.\n351\t        assert pushed >= 1\n352\t        # No discard happened and no card was drawn.\n353\t        assert p1.zones[Zone.LIBRARY].contains(library_card)\n354\t        assert len(game.get_hand(p1).get_all()) == 0\n355\t\n356\t\n357\t# ---------------------------------------------------------------------------\n358\t# Dynamic miracle draw-window\n359\t# ---------------------------------------------------------------------------\n360\t\n361\t\n362\tdef _setup_lorehold_with_library_top(\n363\t    top_card: Any,\n364\t    *,\n365\t    on_battlefield: bool = True,\n366\t    mana: int = 2,\n367\t    drawn_already: int = 0,\n368\t) -> tuple[Any, Any, LoreholdTheHistorian | None]:\n369\t    \"\"\"Build a game where *top_card* is the top of player 0's library.\n370\t\n371\t    The miracle window draws the first card of the turn into hand and then\n372\t    offers to cast it for {2}; the controller therefore needs at least 2 mana\n373\t    in pool to actually pay the miracle cost. ``drawn_already`` seeds\n374\t    ``cards_drawn_this_turn`` so a test can simulate a second (non-first) draw.\n375\t\n376\t    Returns ``(game, player0, lorehold_or_None)``. When ``on_battlefield`` is\n377\t    False, no Lorehold is created/registered, so no miracle grant is active.\n378\t    \"\"\"\n379\t    game = create_game()\n380\t    p1 = game.players[0]\n381\t    lorehold: LoreholdTheHistorian | None = None\n382\t\n383\t    if on_battlefield:\n384\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n385\t        set_board_state(\n386\t            game, 0, battlefield=[lorehold], hand=[], mana={ManaType.COLORLESS: mana}\n387\t        )\n388\t        # Wiring up triggers also registers the dynamic miracle grant.\n389\t        lorehold.register_triggers(game)\n390\t    else:\n391\t        set_board_state(\n392\t            game, 0, battlefield=[], hand=[], mana={ManaType.COLORLESS: mana}\n393\t        )\n394\t\n395\t    # Make sure ownership is set for the library card, then put it on top.\n396\t    top_card.owner = p1\n397\t    top_card.controller = p1\n398\t    p1.zones[Zone.LIBRARY].add(top_card)\n399\t    p1.cards_drawn_this_turn = drawn_already\n400\t    return game, p1, lorehold\n401\t\n402\t\n403\tdef _on_stack(game: Any, card: Any) -> bool:\n404\t    \"\"\"Return ``True`` if *card* is currently a spell on the stack.\"\"\"\n405\t    return any(obj.source is card for obj in game.stack.objects())\n406\t\n407\t\n408\tclass TestLoreholdMiracleDrawWindow:\n409\t    \"\"\"The dynamic half of miracle — cast the first card drawn this turn for {2}.\n410\t\n411\t    \"(You may cast a card for its miracle cost when you draw it if it's the\n412\t    first card you drew this turn.)\" These tests drive ``engine.game.draw_card``\n413\t    directly and script the controller's ``choose_yes_no`` answer to exercise the\n414\t    engine's additive miracle draw-window (``GameState.fire_miracle_window`` →\n415\t    ``engine.casting.cast_spell_alternative``).\n416\t    \"\"\"\n417\t\n418\t    def test_first_drawn_instant_offered_miracle_cast_for_two(self) -> None:\n419\t        \"\"\"Drawing an instant as the first card of the turn casts it for {2}.\"\"\"\n420\t        spell = Instant(name=\"Lightning Bolt\", mana_cost=ManaCost.parse(\"{R}\"))\n421\t        game, p1, _ = _setup_lorehold_with_library_top(spell, mana=2)\n422\t        # Accept the miracle offer.\n423\t        p1._script.appendleft(True)\n424\t\n425\t        drawn = draw_card(game, p1)\n426\t\n427\t        assert drawn is spell\n428\t        # The spell was cast: it left the hand and is on the stack as a spell.\n429\t        assert _on_stack(game, spell)\n430\t        assert not game.get_hand(p1).contains(spell)\n431\t        # The miracle {2} was paid from the pool (started with 2 generic mana).\n432\t        assert p1.mana_pool.total() == 0\n433\t\n434\t    def test_first_drawn_sorcery_offered_miracle_cast_for_two(self) -> None:\n435\t        \"\"\"A sorcery first-drawn under Lorehold is also castable for {2}.\"\"\"\n436\t        spell = Sorcery(name=\"Reconstruct History\", mana_cost=ManaCost.parse(\"{2}{R}\"))\n437\t        game, p1, _ = _setup_lorehold_with_library_top(spell, mana=2)\n438\t        p1._script.appendleft(True)\n439\t\n440\t        draw_card(game, p1)\n441\t\n442\t        assert _on_stack(game, spell)\n443\t        assert not game.get_hand(p1).contains(spell)\n444\t\n445\t    def test_miracle_cast_resolves_to_graveyard(self) -> None:\n446\t        \"\"\"The miracle-cast spell resolves normally (instant → graveyard).\"\"\"\n447\t        spell = Instant(name=\"Lightning Bolt\", mana_cost=ManaCost.parse(\"{R}\"))\n448\t        game, p1, _ = _setup_lorehold_with_library_top(spell, mana=2)\n449\t        p1._script.appendleft(True)\n450\t\n451\t        draw_card(game, p1)\n452\t        # Resolve the spell off the stack.\n453\t        while not game.stack.is_empty():\n454\t            game.stack.pop().on_resolve(game)\n455\t\n456\t        assert game.get_graveyard(p1).contains(spell)\n457\t        assert not game.get_hand(p1).contains(spell)\n458\t\n459\t    def test_declining_keeps_first_drawn_spell_in_hand(self) -> None:\n460\t        \"\"\"\"You MAY cast\" — declining leaves the drawn instant in hand, uncast.\"\"\"\n461\t        spell = Instant(name=\"Lightning Bolt\", mana_cost=ManaCost.parse(\"{R}\"))\n462\t        game, p1, _ = _setup_lorehold_with_library_top(spell, mana=2)\n463\t        # Decline the miracle offer.\n464\t        p1._script.appendleft(False)\n465\t\n466\t        draw_card(game, p1)\n467\t\n468\t        assert game.stack.is_empty()\n469\t        assert game.get_hand(p1).contains(spell)\n470\t        # Declining costs no mana.\n471\t        assert p1.mana_pool.total() == 2\n472\t\n473\t    def test_second_draw_same_turn_gets_no_miracle_window(self) -> None:\n474\t        \"\"\"Only the FIRST card drawn this turn gets a miracle window.\"\"\"\n475\t        spell = Instant(name=\"Lightning Bolt\", mana_cost=ManaCost.parse(\"{R}\"))\n476\t        # cards_drawn_this_turn already 1 → this draw is the second of the turn.\n477\t        game, p1, _ = _setup_lorehold_with_library_top(\n478\t            spell, mana=2, drawn_already=1\n479\t        )\n480\t        # No miracle should be offered, so no yes/no answer is consumed. If the\n481\t        # window wrongly fired, the script would be exhausted and raise.\n482\t\n483\t        draw_card(game, p1)\n484\t\n485\t        # No miracle window: the spell stays in hand and the stack is empty.\n486\t        assert game.stack.is_empty()\n487\t        assert game.get_hand(p1).contains(spell)\n488\t        assert p1.mana_pool.total() == 2\n489\t\n490\t    def test_first_drawn_creature_gets_no_miracle_window(self) -> None:\n491\t        \"\"\"Miracle is granted only to instants/sorceries — not creatures.\"\"\"\n492\t        creature = _vanilla_creature(\"Hill Giant\")\n493\t        game, p1, _ = _setup_lorehold_with_library_top(creature, mana=2)\n494\t        # No miracle should be offered for a creature, so no answer is scripted.\n495\t\n496\t        drawn = draw_card(game, p1)\n497\t\n498\t        assert drawn is creature\n499\t        assert game.stack.is_empty()\n500\t        assert game.get_hand(p1).contains(creature)\n501\t        assert p1.mana_pool.total() == 2\n502\t\n503\t    def test_no_lorehold_means_no_miracle_window(self) -> None:\n504\t        \"\"\"Without Lorehold's grant, drawing an instant fires no miracle window.\"\"\"\n505\t        spell = Instant(name=\"Lightning Bolt\", mana_cost=ManaCost.parse(\"{R}\"))\n506\t        game, p1, lorehold = _setup_lorehold_with_library_top(\n507\t            spell, on_battlefield=False, mana=2\n508\t        )\n509\t        assert lorehold is None\n510\t        # No grant registered, so no yes/no answer is scripted.\n511\t\n512\t        draw_card(game, p1)\n513\t\n514\t        assert game.stack.is_empty()\n515\t        assert game.get_hand(p1).contains(spell)\n516\t        assert p1.mana_pool.total() == 2\n517\t"}]},"parent_tool_use_id":"toolu_01PzUQHDyTL3F6xPfuQoCZ2o","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"daf179d5-75c8-48fa-bcd1-526c894e047c","timestamp":"2026-06-01T09:45:11.015Z","subagent_type":"Reviewer","task_description":"Review sos_201"}
