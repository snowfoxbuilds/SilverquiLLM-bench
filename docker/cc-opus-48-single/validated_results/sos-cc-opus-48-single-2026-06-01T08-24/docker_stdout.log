 non-additive changes to\n  the cast path, DO NOT force it. Leave the cast pipeline untouched and mark the\n  integration `# UNVERIFIED: <requirement> — <reason>` in\n  `cards/sos/sos_226/card_impl.py`. The card-local `apply_casualty` helper already\n  fully models the behavior for testing.\n\n## Constraints\n- Make ALL tests pass; do NOT modify tests.\n- Engine changes ADDITIVE only; after ANY engine change run `pytest engine_tests/`\n  and keep it green. Do NOT add Keyword enum members. Do NOT touch engine_tests/ or\n  FDN tests. Clean up any temp files (no FILES_MODIFIED.json.tmp left behind).\n- Prefer a green engine_tests/ suite and correct helper behavior over pipeline\n  completeness.\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2121,"cache_read_input_tokens":112227,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2121},"output_tokens":42,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"8fe65770-0279-4fcb-af3e-d958e502779c","request_id":"req_011CbcLJCkVc7BJFcG7CN39f"}
