is on any player's battlefield.\"\"\"\n49\t+    for player in getattr(game, \"players\", []) or []:\n50\t+        try:\n51\t+            if game.get_battlefield(player).contains(obj):\n52\t+                return True\n53\t+        except Exception:\n54\t+            continue\n55\t+    return False\n56\t+\n57\t+\n58\t+class WitherbloomTheBalancer(Creature):\n59\t+    \"\"\"Witherbloom, the Balancer — {6}{B}{G} — 5/5 — Legendary Creature — Elder Dragon.\n60\t+\n61\t+    - Affinity for creatures (this spell costs {1} less to cast for each creature\n62\t+      you control). Only the generic portion of the cost is reduced.\n63\t+    - Flying, deathtouch.\n64\t+    - Instant and sorcery spells you cast have affinity for creatures.\n65\t+\n66\t+    SOS collector number 245.\n67\t+    \"\"\"\n68\t+\n69\t+    def __init__(self, **kwargs: Any) -> None:\n70\t+        kwargs.setdefault(\"name\", \"Witherbloom, the Balancer\")\n71\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{6}{B}{G}\"))\n72\t+        kwargs.setdefault(\"subtypes\", {\"Elder\", \"Dragon\"})\n73\t+        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n74\t+        kwargs.setdefault(\"keywords\", Keyword.FLYING | Keyword.DEATHTOUCH)\n75\t+        kwargs.setdefault(\"base_power\", 5)\n76\t+        kwargs.setdefault(\"base_toughness\", 5)\n77\t+        kwargs.setdefault(\n78\t+            \"rules_text\",\n79\t+            \"Affinity for creatures (This spell costs {1} less to cast for each \"\n80\t+            \"creature you control.)\\nFlying, deathtouch\\nInstant and sorcery \"\n81\t+            \"spells you cast have affinity for creatures.\",\n82\t+        )\n83\t+        super().__init__(**kwargs)\n84\t+\n85\t+    # ------------------------------------------------------------------\n86\t+    # Affinity for creatures — reduces this spell's own cost\n87\t+    # ------------------------------------------------------------------\n88\t+\n89\t+    def cost_reduction(self, game: \"GameState\") -> int:\n90\t+        \"\"\"Reduce generic mana by 1 for each creature you control.\n91\t+\n92\t+        Counts creatures the controller controls on the battlefield. While this\n93\t+        card is being cast it is on the stack (not the battlefield), so it never\n94\t+        counts itself — matching \"for each creature you control\".\n95\t+        \"\"\"\n96\t+        controller = getattr(self, \"controller\", None) or getattr(self, \"owner\", None)\n97\t+        return _count_creatures(game, controller)\n98\t+\n99\t+    # ------------------------------------------------------------------\n100\t+    # No targets — Witherbloom's abilities are static; casting it as a\n101\t+    # creature must not demand a target.\n102\t+    # ------------------------------------------------------------------\n103\t+\n104\t+    def get_targets(self, game: \"GameState\") -> list[Any]:\n105\t+        \"\"\"Witherbloom is a vanilla-cast permanent; it advertises no targets.\"\"\"\n106\t+        return []\n107\t+\n108\t+    # ------------------------------------------------------------------\n109\t+    # Granted affinity — \"Instant and sorcery spells you cast have affinity\n110\t+    # for creatures.\" Registered as a game-level spell cost reducer that the\n111\t+    # casting pipeline (engine.casting.get_cost_reduction) sums alongside each\n112\t+    # spell's own cost_reduction() hook.\n113\t+    # ------------------------------------------------------------------\n114\t+\n115\t+    def register_triggers(self, game: \"GameState\") -> None:\n116\t+        \"\"\"Register the granted-affinity cost reducer while on the battlefield.\"\"\"\n117\t+        source = self\n118\t+\n119\t+        def _predicate(g: Any, card: Any, controller: Any) -> bool:\n120\t+            # Applies only to the controller's OTHER instant/sorcery spells,\n121\t+            # and only while Witherbloom is on the battlefield.\n122\t+            if card is source:\n123\t+                return False\n124\t+            if not _is_instant_or_sorcery(card):\n125\t+                return False\n126\t+            owner_controller = getattr(source, \"controller\", None) or getattr(\n127\t+                source, \"owner\", None\n128\t+            )\n129\t+            if owner_controller is None or controller is not owner_controller:\n130\t+                return False\n131\t+            return _is_on_battlefield(g, source)\n132\t+\n133\t+        def _amount(g: Any, card: Any, controller: Any) -> int:\n134\t+            # Affinity for creatures: {1} less per creature the controller\n135\t+            # controls. Clamping to the spell's generic is handled centrally.\n136\t+            return _count_creatures(g, controller)\n137\t+\n138\t+        register = getattr(game, \"register_spell_cost_reducer\", None)\n139\t+        if register is not None:\n140\t+            register(_predicate, _amount, source=source)\n141\tdiff --git a/engine/casting.py b/engine/casting.py\n142\tindex cc69d05..74f46e7 100644\n143\t--- a/engine/casting.py\n144\t+++ b/engine/casting.py\n145\t@@ -101,6 +101,18 @@ def get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> i\n146\t     prev_controller = card.controller\n147\t     card.controller = controller\n148\t     raw = card.cost_reduction(game)\n149\t+    # Add any external game-level reducers (e.g. a permanent granting\n150\t+    # \"affinity for creatures\" to the controller's other instant/sorcery\n151\t+    # spells). Strict no-op when the registry is empty, so existing\n152\t+    # cost-reduction tests are unaffected.\n153\t+    external = 0\n154\t+    reducer_hook = getattr(game, \"spell_cost_reduction_from_reducers\", None)\n155\t+    if reducer_hook is not None:\n156\t+        try:\n157\t+            external = int(reducer_hook(card, controller))\n158\t+        except Exception:\n159\t+            external = 0\n160\t+    raw += external\n161\t     # Restore previous controller in case the caller doesn't want a\n162\t     # side-effect (get_cost_reduction is a query, not a mutation).\n163\t     card.controller = prev_controller\n164\tdiff --git a/engine/game_state.py b/engine/game_state.py\n165\tindex 235db33..c519e54 100644\n166\t--- a/engine/game_state.py\n167\t+++ b/engine/game_state.py\n168\t@@ -87,6 +87,16 @@ class GameState:\n169\t         # miracle draw-window (fired from ``engine.game.draw_card``) is a strict\n170\t         # no-op unless a card such as Lorehold registers a grant.\n171\t         self._miracle_grants: list[dict[str, Any]] = []\n172\t+        # Additive game-level spell cost-reduction registry. Each entry is a\n173\t+        # dict with a ``predicate`` callable ``(game, card, controller) -> bool``\n174\t+        # and an ``amount`` callable ``(game, card, controller) -> int`` plus a\n175\t+        # ``source`` for cleanup. Empty by default, so\n176\t+        # ``engine.casting.get_cost_reduction`` adds zero external reduction and\n177\t+        # existing casting / cost-reduction tests are strictly unaffected. A\n178\t+        # permanent (e.g. Witherbloom, the Balancer) registers a reducer to grant\n179\t+        # \"affinity for creatures\" to the controller's other instant/sorcery\n180\t+        # spells while it is on the battlefield.\n181\t+        self.spell_cost_reducers: list[dict[str, Any]] = []\n182\t \n183\t     # ------------------------------------------------------------------\n184\t     # Player properties\n185\t@@ -209,6 +219,68 @@ class GameState:\n186\t                 return\n187\t             return\n188\t \n189\t+    # ------------------------------------------------------------------\n190\t+    # Spell cost-reduction registry (additive — no-op unless registered)\n191\t+    # ------------------------------------------------------------------\n192\t+\n193\t+    def register_spell_cost_reducer(\n194\t+        self,\n195\t+        predicate: Any,\n196\t+        amount: Any,\n197\t+        *,\n198\t+        source: Any = None,\n199\t+    ) -> None:\n200\t+        \"\"\"Register a game-level generic cost reducer for spells.\n201\t+\n202\t+        *predicate* is a callable ``(game, card, controller) -> bool`` that\n203\t+        returns ``True`` when this reducer applies to *card* being cast by\n204\t+        *controller*. *amount* is a callable ``(game, card, controller) -> int``\n205\t+        returning the generic mana reduction to grant.\n206\t+\n207\t+        The reducer is summed by :meth:`spell_cost_reduction_from_reducers`\n208\t+        (consulted by :func:`engine.casting.get_cost_reduction`) alongside the\n209\t+        spell's own ``cost_reduction()`` hook. ``source`` is used by\n210\t+        :meth:`unregister_spell_cost_reducer` for cleanup. With no registered\n211\t+        reducers the registry is a strict no-op.\n212\t+        \"\"\"\n213\t+        self.spell_cost_reducers.append(\n214\t+            {\"predicate\": predicate, \"amount\": amount, \"source\": source}\n215\t+        )\n216\t+\n217\t+    def unregister_spell_cost_reducer(self, source: Any) -> None:\n218\t+        \"\"\"Remove all spell cost reducers registered by *source* (identity-based).\"\"\"\n219\t+        self.spell_cost_reducers = [\n220\t+            r for r in self.spell_cost_reducers if r.get(\"source\") is not source\n221\t+        ]\n222\t+\n223\t+    def spell_cost_reduction_from_reducers(\n224\t+        self, card: Any, controller: Any\n225\t+    ) -> int:\n226\t+        \"\"\"Return the summed generic reduction from registered reducers.\n227\t+\n228\t+        Each registered reducer whose ``predicate`` returns ``True`` for\n229\t+        (*card*, *controller*) contributes its ``amount``. Returns 0 when the\n230\t+        registry is empty or no reducer applies, so it is a strict no-op for\n231\t+        spells that no external source reduces.\n232\t+        \"\"\"\n233\t+        if not self.spell_cost_reducers:\n234\t+            return 0\n235\t+        total = 0\n236\t+        for entry in list(self.spell_cost_reducers):\n237\t+            predicate = entry.get(\"predicate\")\n238\t+            amount = entry.get(\"amount\")\n239\t+            if predicate is None or amount is None:\n240\t+                continue\n241\t+            try:\n242\t+                if not predicate(self, card, controller):\n243\t+                    continue\n244\t+                value = int(amount(self, card, controller))\n245\t+            except Exception:\n246\t+                continue\n247\t+            if value > 0:\n248\t+                total += value\n249\t+        return total\n250\t+\n251\t     # ------------------------------------------------------------------\n252\t     # Phase/step progression\n253\t     # ------------------------------------------------------------------\n254\t"}]},"parent_tool_use_id":"toolu_01GUc1mLLu3Wf7w47XGpBpB8","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"84b4dd4d-fc36-477a-8a2a-b41df3cb1d6f","timestamp":"2026-06-01T10:10:48.265Z","subagent_type":"Implementer","task_description":"Revise sos_245 per review"}
