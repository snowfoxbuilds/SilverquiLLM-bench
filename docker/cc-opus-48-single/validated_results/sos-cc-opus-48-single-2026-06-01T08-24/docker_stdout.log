et()) | {\"Ral\"}\n44\t+        kwargs.setdefault(\n45\t+            \"rules_text\",\n46\t+            \"+1: Surveil 2.\\n\"\n47\t+            \"-1: Any number of target players each discard a card.\\n\"\n48\t+            \"-2: Return target creature card with mana value 3 or less from \"\n49\t+            \"your graveyard to the battlefield.\\n\"\n50\t+            \"-7: Flip five coins. Target opponent skips their next X turns, \"\n51\t+            \"where X is the number of coins that came up heads.\",\n52\t+        )\n53\t+        super().__init__(**kwargs)\n54\t+        # Set by the resolution pipeline / tests to supply the ability's target.\n55\t+        self.chosen_targets: list[Any] = []\n56\t+        self._resolve_target: Any = None\n57\t+\n58\t+    # ------------------------------------------------------------------\n59\t+    # Loyalty abilities\n60\t+    # ------------------------------------------------------------------\n61\t+\n62\t+    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n63\t+        pw = self\n64\t+\n65\t+        def _plus1(game: \"GameState\") -> None:\n66\t+            \"\"\"+1: Surveil 2.\"\"\"\n67\t+            controller = pw.controller\n68\t+            if controller is None:\n69\t+                return\n70\t+            library = game.get_library(controller)\n71\t+            graveyard = game.get_graveyard(controller)\n72\t+            # Top of the library is the END of the internal list. Surveil 2\n73\t+            # examines the top two cards one at a time (topmost first).\n74\t+            for _ in range(2):\n75\t+                cards = library.get_all()\n76\t+                if not cards:\n77\t+                    break\n78\t+                top_card = cards[-1]\n79\t+                to_graveyard = controller.choose_yes_no(\n80\t+                    f\"Surveil: put {getattr(top_card, 'name', 'card')} into \"\n81\t+                    \"your graveyard?\"\n82\t+                )\n83\t+                if to_graveyard:\n84\t+                    library.remove(top_card)\n85\t+                    graveyard.add(top_card)\n86\t+                # If kept on top, leave it where it is; the next iteration\n87\t+                # would re-examine the same card, so stop after a kept card to\n88\t+                # honour Surveil's \"rest back on top in any order\" semantics.\n89\t+                else:\n90\t+                    break\n91\t+\n92\t+        def _minus1(game: \"GameState\") -> None:\n93\t+            \"\"\"−1: Any number of target players each discard a card.\"\"\"\n94\t+            from engine.game import discard\n95\t+\n96\t+            targets = list(getattr(pw, \"chosen_targets\", []) or [])\n97\t+            for player in targets:\n98\t+                hand = game.get_hand(player)\n99\t+                cards = hand.get_all()\n100\t+                if not cards:\n101\t+                    continue\n102\t+                chosen = player.choose_card(cards, \"Choose a card to discard\")\n103\t+                if chosen is None:\n104\t+                    continue\n105\t+                discard(game, player, chosen)\n106\t+\n107\t+        def _minus2(game: \"GameState\") -> None:\n108\t+            \"\"\"−2: Reanimate a creature card with mana value 3 or less from\n109\t+            your graveyard.\"\"\"\n110\t+            from engine.zones import move_to_zone\n111\t+\n112\t+            controller = pw.controller\n113\t+            if controller is None:\n114\t+                return\n115\t+            target = pw._chosen_single_target()\n116\t+            if target is None:\n117\t+                return\n118\t+            # Must be a creature card.\n119\t+            if CardType.CREATURE not in getattr(target, \"card_types\", set()):\n120\t+                return\n121\t+            # Mana value must be 3 or less.\n122\t+            mana_cost = getattr(target, \"mana_cost\", None)\n123\t+            mana_value = getattr(mana_cost, \"cmc\", 0) if mana_cost is not None else 0\n124\t+            if mana_value > 3:\n125\t+                return\n126\t+            # Must be in YOUR (the controller's) graveyard.\n127\t+            graveyard = game.get_graveyard(controller)\n128\t+            if not graveyard.contains(target):\n129\t+                return\n130\t+            target.controller = controller\n131\t+            move_to_zone(game, target, Zone.GRAVEYARD, Zone.BATTLEFIELD)\n132\t+\n133\t+        def _minus7(game: \"GameState\") -> None:\n134\t+            \"\"\"−7: Flip five coins. Target opponent skips their next X turns,\n135\t+            where X is the number of coins that came up heads.\"\"\"\n136\t+            target = pw._chosen_single_target()\n137\t+            heads = 0\n138\t+            flipper = pw.controller\n139\t+            for _ in range(5):\n140\t+                if game.flip_coin(flipper):\n141\t+                    heads += 1\n142\t+            if target is None:\n143\t+                return\n144\t+            # Target opponent skips their next X turns.\n145\t+            if hasattr(target, \"skipped_turns\"):\n146\t+                target.skipped_turns += heads\n147\t+\n148\t+        return [\n149\t+            LoyaltyAbility(\n150\t+                loyalty_cost=+1,\n151\t+                effect=_plus1,\n152\t+                description=\"+1: Surveil 2.\",\n153\t+            ),\n154\t+            LoyaltyAbility(\n155\t+                loyalty_cost=-1,\n156\t+                effect=_minus1,\n157\t+                description=\"-1: Any number of target players each discard a card.\",\n158\t+            ),\n159\t+            LoyaltyAbility(\n160\t+                loyalty_cost=-2,\n161\t+                effect=_minus2,\n162\t+                description=\"-2: Return target creature card with mana value 3 \"\n163\t+                \"or less from your graveyard to the battlefield.\",\n164\t+            ),\n165\t+            LoyaltyAbility(\n166\t+                loyalty_cost=-7,\n167\t+                effect=_minus7,\n168\t+                description=\"-7: Flip five coins. Target opponent skips their \"\n169\t+                \"next X turns, where X is the number of coins that came up heads.\",\n170\t+            ),\n171\t+        ]\n172\t+\n173\t+    # ------------------------------------------------------------------\n174\t+    # Helpers\n175\t+    # ------------------------------------------------------------------\n176\t+\n177\t+    def _chosen_single_target(self) -> Any:\n178\t+        \"\"\"Return the single chosen target for an ability, if any.\"\"\"\n179\t+        chosen = getattr(self, \"chosen_targets\", None)\n180\t+        if chosen:\n181\t+            return chosen[0]\n182\t+        return getattr(self, \"_resolve_target\", None)\n183\t+\n184\t+    def get_targets(self, game: \"GameState\") -> list[Any]:\n185\t+        \"\"\"Loyalty-ability targets are chosen by the ability, not the card.\n186\t+\n187\t+        Returning ``[]`` keeps the casting pipeline from requiring a target\n188\t+        for the planeswalker itself (cf. KEY_DECISIONS get_targets convention).\n189\t+        \"\"\"\n190\t+        return []\n191\tdiff --git a/engine/game_state.py b/engine/game_state.py\n192\tindex e5b3506..b429cd8 100644\n193\t--- a/engine/game_state.py\n194\t+++ b/engine/game_state.py\n195\t@@ -157,12 +157,67 @@ class GameState:\n196\t             else:\n197\t                 self.active_player_index = self._normal_next_index\n198\t                 self._normal_next_index = 1 - self._normal_next_index\n199\t+            # Skip-turn support: if the player who would become active has\n200\t+            # queued skipped turns, consume one and hand the turn to the other\n201\t+            # player instead. Default skipped_turns == 0 makes this a no-op, so\n202\t+            # existing turn rotation is unaffected.\n203\t+            self._apply_skipped_turns()\n204\t             self.priority_player_index = self.active_player_index\n205\t             self.phase = _TURN_SEQUENCE[0][0]\n206\t             self.step = _TURN_SEQUENCE[0][1]\n207\t \n208\t         self.empty_mana_pools()\n209\t \n210\t+    def _apply_skipped_turns(self) -> None:\n211\t+        \"\"\"Skip the active player's turn(s) if they have ``skipped_turns`` queued.\n212\t+\n213\t+        Additive turn-skip support. When the player just rotated to as active\n214\t+        has ``skipped_turns > 0``, decrement it and pass the turn to the other\n215\t+        player (advancing the normal rotation so the skipped player does not\n216\t+        immediately regain it). Loops to handle consecutive skips. Bounded by\n217\t+        the number of players with queued skips so it always terminates.\n218\t+\n219\t+        Default ``skipped_turns == 0`` for all players makes this a no-op.\n220\t+        \"\"\"\n221\t+        # Guard: nothing to do if no player has queued skips.\n222\t+        guard = 0\n223\t+        max_iterations = sum(\n224\t+            max(0, getattr(p, \"skipped_turns\", 0)) for p in self.players\n225\t+        ) + len(self.players)\n226\t+        while getattr(self.active_player, \"skipped_turns\", 0) > 0:\n227\t+            self.active_player.skipped_turns -= 1\n228\t+            self.turn_number += 1\n229\t+            self.active_player_index = self._normal_next_index\n230\t+            self._normal_next_index = 1 - self._normal_next_index\n231\t+            guard += 1\n232\t+            if guard > max_iterations:\n233\t+                break\n234\t+\n235\t+    def flip_coin(self, player: Player | None = None) -> bool:\n236\t+        \"\"\"Flip a coin, returning ``True`` for heads.\n237\t+\n238\t+        Deterministic in tests: if *player* is a scripted player, the result is\n239\t+        read from its choice script via ``choose_yes_no`` so a test can force a\n240\t+        known sequence of heads/tails. Falls back to real randomness when no\n241\t+        scriptable player is available.\n242\t+\n243\t+        Parameters:\n244\t+            player: The player flipping (whose script supplies the result in\n245\t+                tests). May be ``None``.\n246\t+\n247\t+        Returns:\n248\t+            ``True`` for heads, ``False`` for tails.\n249\t+        \"\"\"\n250\t+        if player is not None and hasattr(player, \"_script\"):\n251\t+            # Scripted player: pull the next answer if one is queued, otherwise\n252\t+            # fall through to randomness so resolution never raises mid-flip.\n253\t+            script = getattr(player, \"_script\", None)\n254\t+            if script:\n255\t+                return bool(player.choose_yes_no(\"Flip a coin (heads?)\"))\n256\t+        import random\n257\t+\n258\t+        return random.choice((True, False))\n259\t+\n260\t     def empty_mana_pools(self) -> None:\n261\t         \"\"\"Empty all players' mana pools — called on each phase/step transition.\"\"\"\n262\t         for player in self.players:\n263\tdiff --git a/engine/player.py b/engine/player.py\n264\tindex 9d66c29..7501e5f 100644\n265\t--- a/engine/player.py\n266\t+++ b/engine/player.py\n267\t@@ -35,6 +35,10 @@ class Player(ABC):\n268\t         self.has_lost: bool = False\n269\t         self.land_plays_remaining: int = 1\n270\t         self.drawn_from_empty_library: bool = False\n271\t+        # Number of this player's upcoming turns that are skipped. Defaults to\n272\t+        # 0 (no-op) so existing turn rotation is unaffected. Consulted by\n273\t+        # GameState.advance_phase when rotating to a new active player.\n274\t+        self.skipped_turns: int = 0\n275\t \n276\t     @abstractmethod\n277\t     def choose_target(self, options: Any, requirement: Any) -> Any:\n278\t"}]},"parent_tool_use_id":"toolu_01PySzzbrAYznBkWFA71GV2i","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"2ba36aaf-c3af-44b0-a148-28c18b1e9e2b","timestamp":"2026-06-01T09:24:53.011Z","subagent_type":"Reviewer","task_description":"Review sos_97"}
