{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QLCBHxo3J32vV2dkZ4y7FU","type":"tool_result","content":"1\t\"\"\"Card implementation for An Offer You Can't Refuse.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Instant\n8\tfrom engine.types import CardType, ManaCost, TargetRequirement, Zone\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t\n13\t\n14\tdef _get_chosen_target(card: Any, game: Any) -> Any:\n15\t    \"\"\"Retrieve the first chosen target for a spell.\"\"\"\n16\t    chosen = getattr(card, \"chosen_targets\", None)\n17\t    if chosen:\n18\t        return chosen[0]\n19\t    return getattr(card, \"_resolve_target\", None)\n20\t\n21\t\n22\tdef _counter_spell(game: \"GameState\", stack_obj: Any) -> None:\n23\t    \"\"\"Counter a spell — remove from stack and move card to graveyard.\"\"\"\n24\t    from engine.stack import StackObject\n25\t\n26\t    if not isinstance(stack_obj, StackObject):\n27\t        return\n28\t\n29\t    card = stack_obj.source\n30\t    stack_items = game.stack._items  # noqa: SLF001\n31\t    found = False\n32\t    for i, item in enumerate(stack_items):\n33\t        if item is stack_obj:\n34\t            stack_items.pop(i)\n35\t            found = True\n36\t            break\n37\t\n38\t    if not found:\n39\t        return\n40\t\n41\t    controller = stack_obj.controller\n42\t    owner = getattr(card, \"owner\", controller)\n43\t\n44\t    if controller is not None:\n45\t        stack_zone = controller.zones[Zone.STACK]\n46\t        if stack_zone.contains(card):\n47\t            stack_zone.remove(card)\n48\t\n49\t    if owner is not None:\n50\t        graveyard = owner.zones[Zone.GRAVEYARD]\n51\t        graveyard.add(card)\n52\t\n53\t\n54\tclass AnOfferYouCantRefuse(Instant):\n55\t    \"\"\"An Offer You Can't Refuse — {U} — Instant.\n56\t\n57\t    Counter target noncreature spell. Its controller creates two Treasure\n58\t    tokens.\n59\t\n60\t    FDN collector number 160.\n61\t    \"\"\"\n62\t\n63\t    def __init__(self, **kwargs: Any) -> None:\n64\t        kwargs.setdefault(\"name\", \"An Offer You Can't Refuse\")\n65\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{U}\"))\n66\t        kwargs.setdefault(\n67\t            \"rules_text\",\n68\t            \"Counter target noncreature spell. Its controller creates two \"\n69\t            \"Treasure tokens.\",\n70\t        )\n71\t        super().__init__(**kwargs)\n72\t\n73\t    def can_cast(self, game: \"GameState\") -> bool:\n74\t        \"\"\"Cannot cast unless there's a noncreature spell on the stack.\"\"\"\n75\t        from engine.types import CardType\n76\t\n77\t        for stack_obj in game.stack.objects():\n78\t            source = stack_obj.source\n79\t            if source is self:\n80\t                continue\n81\t            card_types = getattr(source, \"card_types\", set())\n82\t            # Must be a spell (has spell card types) and not a creature\n83\t            is_spell = bool(card_types - {CardType.LAND})\n84\t            if is_spell and CardType.CREATURE not in card_types:\n85\t                return True\n86\t        return False\n87\t\n88\t    def get_targets(self, game: \"GameState\") -> list:\n89\t        \"\"\"Target noncreature spell on the stack.\"\"\"\n90\t        from engine.types import CardType\n91\t\n92\t        def _filter(obj: Any) -> bool:\n93\t            if obj is self:\n94\t                return False\n95\t            source = getattr(obj, \"source\", obj)\n96\t            card_types = getattr(source, \"card_types\", set())\n97\t            # Must be a spell (has spell card types, not just a land) and noncreature\n98\t            is_spell = bool(card_types - {CardType.LAND})\n99\t            return is_spell and CardType.CREATURE not in card_types\n100\t\n101\t        return [\n102\t            TargetRequirement(\n103\t                filter_fn=_filter,\n104\t                description=\"target noncreature spell\",\n105\t                zone=Zone.STACK,\n106\t            )\n107\t        ]\n108\t\n109\t    def on_resolve(self, game: \"GameState\") -> None:\n110\t        \"\"\"Counter target noncreature spell, give its controller two Treasure tokens.\"\"\"\n111\t        from engine.game import create_token\n112\t        from engine.card import Creature\n113\t\n114\t        target = _get_chosen_target(self, game)\n115\t        if target is None:\n116\t            return\n117\t\n118\t        # Get the controller of the countered spell before countering\n119\t        spell_controller = getattr(target, \"controller\", None)\n120\t\n121\t        _counter_spell(game, target)\n122\t\n123\t        # Create two Treasure tokens for the spell's controller\n124\t        if spell_controller is not None:\n125\t            for _ in range(2):\n126\t                from engine.card import CardImpl\n127\t                treasure = CardImpl(\n128\t                    name=\"Treasure\",\n129\t                    mana_cost=ManaCost(generic=0),\n130\t                    rules_text=\"{T}, Sacrifice this token: Add one mana of any color.\",\n131\t                )\n132\t                treasure.card_types = {CardType.ARTIFACT}\n133\t                treasure.subtypes = {\"Treasure\"}\n134\t                treasure.is_token = True\n135\t                create_token(game, spell_controller, treasure)\n136\t"}]},"parent_tool_use_id":"toolu_01Um2fPsqJ5WALztNU1xs4f6","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"9b569976-d883-48f4-b2a2-51ab8c1e8ea8","timestamp":"2026-06-01T09:06:56.136Z","subagent_type":"Reviewer","task_description":"Review sos_57"}
