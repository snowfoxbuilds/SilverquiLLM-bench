{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GYQmAbnJRJScKunNecpVEG","type":"tool_result","content":"240\t# ---------------------------------------------------------------------------\n241\t\n242\t\n243\tdef _fire_opponent_upkeep(game: Any, lorehold: LoreholdTheHistorian) -> None:\n244\t    \"\"\"Register Lorehold's triggers and fire an opponent's upkeep event.\"\"\"\n245\t    lorehold.register_triggers(game)\n246\t    game.active_player_index = 1  # opponent is active\n247\t    game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n248\t    while not game.stack.is_empty():\n249\t        game.stack.pop().on_resolve(game)\n250\t\n251\t\n252\tclass TestLoreholdLootEffect:\n253\t    \"\"\"you may discard a card; if you do, draw a card.\"\"\"\n254\t\n255\t    def test_discard_then_draw_keeps_hand_size(self) -> None:\n256\t        \"\"\"Looting one card: hand size net-zero (pitch one, draw one).\"\"\"\n257\t        game = create_game()\n258\t        p1 = game.players[0]\n259\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n260\t        pitch = _filler_hand_card(\"Pitch Me\")\n261\t        library_card = _sorcery(\"Top of Library\")\n262\t        set_board_state(game, 0, battlefield=[lorehold], hand=[pitch])\n263\t        # Seed the library so the draw has a card to find.\n264\t        p1.zones[Zone.LIBRARY].add(library_card)\n265\t        # Script: choose to discard (yes), then choose which card to pitch.\n266\t        p1._script.appendleft(pitch)\n267\t        p1._script.appendleft(True)\n268\t\n269\t        before = len(game.get_hand(p1).get_all())\n270\t        _fire_opponent_upkeep(game, lorehold)\n271\t        after = len(game.get_hand(p1).get_all())\n272\t        assert after == before\n273\t\n274\t    def test_discard_card_goes_to_graveyard(self) -> None:\n275\t        \"\"\"The discarded card ends up in the controller's graveyard.\"\"\"\n276\t        game = create_game()\n277\t        p1 = game.players[0]\n278\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n279\t        pitch = _filler_hand_card(\"Pitch Me\")\n280\t        library_card = _sorcery(\"Top of Library\")\n281\t        set_board_state(game, 0, battlefield=[lorehold], hand=[pitch])\n282\t        p1.zones[Zone.LIBRARY].add(library_card)\n283\t        p1._script.appendleft(pitch)\n284\t        p1._script.appendleft(True)\n285\t\n286\t        _fire_opponent_upkeep(game, lorehold)\n287\t        assert game.get_graveyard(p1).contains(pitch)\n288\t\n289\t    def test_drawn_card_enters_hand(self) -> None:\n290\t        \"\"\"The looted draw moves the top library card into hand.\"\"\"\n291\t        game = create_game()\n292\t        p1 = game.players[0]\n293\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n294\t        pitch = _filler_hand_card(\"Pitch Me\")\n295\t        library_card = _sorcery(\"Top of Library\")\n296\t        set_board_state(game, 0, battlefield=[lorehold], hand=[pitch])\n297\t        p1.zones[Zone.LIBRARY].add(library_card)\n298\t        p1._script.appendleft(pitch)\n299\t        p1._script.appendleft(True)\n300\t\n301\t        _fire_opponent_upkeep(game, lorehold)\n302\t        assert game.get_hand(p1).contains(library_card)\n303\t        assert not p1.zones[Zone.LIBRARY].contains(library_card)\n304\t\n305\t    def test_declining_discard_draws_nothing(self) -> None:\n306\t        \"\"\"\"you may discard\" — declining means no discard and no draw.\"\"\"\n307\t        game = create_game()\n308\t        p1 = game.players[0]\n309\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n310\t        pitch = _filler_hand_card(\"Keep Me\")\n311\t        library_card = _sorcery(\"Top of Library\")\n312\t        set_board_state(game, 0, battlefield=[lorehold], hand=[pitch])\n313\t        p1.zones[Zone.LIBRARY].add(library_card)\n314\t        # Script: decline (no)."}]},"parent_tool_use_id":"toolu_012dceDh3xorVVFv4Ptv6oen","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"b7cf0f85-59a6-477b-a7da-b1afb51edf34","timestamp":"2026-06-01T09:36:16.877Z","subagent_type":"Tester","task_description":"Write tests for sos_201"}
