{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01REACee9R7SkEgTseCdX8w5","type":"tool_result","content":"1\t\"\"\"Tests for SOS 97 — Ral Zarek, Guest Lecturer.\n2\t\n3\tRal Zarek, Guest Lecturer is a {1}{B}{B} Legendary Planeswalker — Ral with\n4\tstarting loyalty 3 and four loyalty abilities:\n5\t\n6\t1. ``+1: Surveil 2.`` — look at the top two cards of your library, then put\n7\t   any number of them into your graveyard and the rest back on top in any\n8\t   order.\n9\t2. ``−1: Any number of target players each discard a card.``\n10\t3. ``−2: Return target creature card with mana value 3 or less from your\n11\t   graveyard to the battlefield.``\n12\t4. ``−7: Flip five coins. Target opponent skips their next X turns, where X is\n13\t   the number of coins that came up heads.``\n14\t\n15\tThese define the TDD contract; ``card_impl.py`` is a stub, so the behavioural\n16\ttests are expected to fail until the card is implemented.\n17\t\n18\tConventions followed (cf. fdn_134 Ajani planeswalker, fdn_53 surveil):\n19\t- Loyalty abilities are exposed via ``get_loyalty_abilities()`` returning\n20\t  ``LoyaltyAbility`` dataclasses (``loyalty_cost`` + ``effect(game)``).\n21\t- A loyalty ability's target is supplied to the effect via the planeswalker's\n22\t  ``chosen_targets`` / ``_resolve_target`` attribute (per Ajani's pattern).\n23\t- Surveil: the top of the library is the END of the zone list; the controller\n24\t  uses ``choose_yes_no`` to decide whether each examined card goes to the\n25\t  graveyard.\n26\t\"\"\"\n27\t\n28\tfrom __future__ import annotations\n29\t\n30\tfrom cards.sos.sos_97.card_impl import RalZarekGuestLecturer\n31\tfrom engine.card import Creature, Instant, LoyaltyAbility, Planeswalker\n32\tfrom engine.types import (\n33\t    CardType,\n34\t    ManaCost,\n35\t    Supertype,\n36\t    Zone,\n37\t)\n38\tfrom test_utils import create_game, set_board_state\n39\t\n40\t\n41\t# ---------------------------------------------------------------------------\n42\t# Helpers\n43\t# ---------------------------------------------------------------------------\n44\t\n45\t\n46\tdef _creature(name: str, cost: str) -> Creature:\n47\t    \"\"\"A vanilla creature card with the given mana cost string.\"\"\"\n48\t    c = Creature(name=name, mana_cost=ManaCost.parse(cost), base_power=2, base_toughness=2)\n49\t    return c\n50\t\n51\t\n52\tdef _instant(name: str = \"Test Instant\") -> Instant:\n53\t    return Instant(name=name, mana_cost=ManaCost.parse(\"{1}{U}\"))\n54\t\n55\t\n56\tdef _ability_by_cost(card: RalZarekGuestLecturer, cost: int) -> LoyaltyAbility:\n57\t    \"\"\"Return the loyalty ability whose loyalty_cost matches *cost*.\"\"\"\n58\t    for ab in card.get_loyalty_abilities():\n59\t        if ab.loyalty_cost == cost:\n60\t            return ab\n61\t    raise AssertionError(f\"No loyalty ability with loyalty_cost {cost}\")\n62\t\n63\t\n64\t# ---------------------------------------------------------------------------\n65\t# Static card data\n66\t# ---------------------------------------------------------------------------\n67\t\n68\t\n69\tclass TestRalProperties:\n70\t    \"\"\"Static card data should match the SOS 97 spec.\"\"\"\n71\t\n72\t    def test_is_planeswalker(self) -> None:\n73\t        card = RalZarekGuestLecturer(owner=None)\n74\t        assert isinstance(card, Planeswalker)\n75\t        assert CardType.PLANESWALKER in card.card_types\n76\t\n77\t    def test_name(self) -> None:\n78\t        assert RalZarekGuestLecturer(owner=None).name == \"Ral Zarek, Guest Lecturer\"\n79\t\n80\t    def test_mana_cost(self) -> None:\n81\t        assert RalZarekGuestLecturer(owner=None).mana_cost == ManaCost.parse(\"{1}{B}{B}\")\n82\t\n83\t    def test_is_legendary(self) -> None:\n84\t        assert Supertype.LEGENDARY in RalZarekGuestLecturer(owner=None).supertypes\n85\t\n86\t    def test_is_ral_subtype(self) -> None:\n87\t        assert \"Ral\" in RalZarekGuestLecturer(owner=None).subtypes\n88\t\n89\t    def test_starting_loyalty_is_three(self) -> None:\n90\t        card = RalZarekGuestLecturer(owner=None)\n91\t        assert card.starting_loyalty == 3\n92\t        assert card.loyalty == 3\n93\t\n94\t\n95\t# ---------------------------------------------------------------------------\n96\t# Loyalty ability declaration\n97\t# ---------------------------------------------------------------------------\n98\t\n99\t\n100\tclass TestRalLoyaltyAbilityDeclaration:\n101\t    \"\"\"get_loyalty_abilities() should expose all four printed abilities.\"\"\"\n102\t\n103\t    def test_returns_four_abilities(self) -> None:\n104\t        abilities = RalZarekGuestLecturer(owner=None).get_loyalty_abilities()\n105\t        assert len(abilities) == 4\n106\t\n107\t    def test_each_is_loyalty_ability(self) -> None:\n108\t        for ab in RalZarekGuestLecturer(owner=None).get_loyalty_abilities():\n109\t            assert isinstance(ab, LoyaltyAbility)\n110\t\n111\t    def test_loyalty_costs_match_spec(self) -> None:\n112\t        costs = sorted(\n113\t            ab.loyalty_cost\n114\t            for ab in RalZarekGuestLecturer(owner=None).get_loyalty_abilities()\n115\t        )\n116\t        assert costs == [-7, -2, -1, 1]\n117\t\n118\t\n119\t# ---------------------------------------------------------------------------\n120\t# +1: Surveil 2\n121\t# ---------------------------------------------------------------------------\n122\t\n123\t\n124\tclass TestRalSurveil:\n125\t    \"\"\"+1: Surveil 2 — examine the top two cards, put any number into the\n126\t    graveyard, the rest back on top.\"\"\"\n127\t\n128\t    def test_surveil_puts_both_chosen_cards_into_graveyard(self) -> None:\n129\t        game = create_game()\n130\t        p1 = game.players[0]\n131\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n132\t        top1, top2 = _instant(\"Top1\"), _instant(\"Top2\")\n133\t        # Library order: deeper cards first, top of library is the LAST element.\n134\t        set_board_state(game, 0, battlefield=[card])\n135\t        lib = game.get_library(p1)\n136\t        for c in [_instant(\"Deep\"), top2, top1]:\n137\t            c.owner = p1\n138\t            c.controller = p1\n139\t            lib.add(c)\n140\t        # Script controller to put BOTH examined cards into the graveyard.\n141\t        p1._script.extend([True, True])\n142\t        _ability_by_cost(card, +1).effect(game)\n143\t        gy = game.get_graveyard(p1).get_all()\n144\t        assert top1 in gy\n145\t        assert top2 in gy\n146\t\n147\t    def test_surveil_keeps_cards_on_top_when_declined(self) -> None:\n148\t        game = create_game()\n149\t        p1 = game.players[0]\n150\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n151\t        top1, top2 = _instant(\"Top1\"), _instant(\"Top2\")\n152\t        set_board_state(game, 0, battlefield=[card])\n153\t        lib = game.get_library(p1)\n154\t        for c in [_instant(\"Deep\"), top2, top1]:\n155\t            c.owner = p1\n156\t            c.controller = p1\n157\t            lib.add(c)\n158\t        before = len(lib.get_all())\n159\t        # Decline to bin either card.\n160\t        p1._script.extend([False, False])\n161\t        _ability_by_cost(card, +1).effect(game)\n162\t        # No cards left the library; graveyard is unchanged.\n163\t        assert len(game.get_library(p1).get_all()) == before\n164\t        assert len(game.get_graveyard(p1).get_all()) == 0\n165\t\n166\t    def test_surveil_with_fewer_than_two_cards_does_not_raise(self) -> None:\n167\t        \"\"\"A near-empty library (one card) must not crash Surveil 2.\"\"\"\n168\t        game = create_game()\n169\t        p1 = game.players[0]\n170\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n171\t        set_board_state(game, 0, battlefield=[card])\n172\t        lib = game.get_library(p1)\n173\t        only = _instant(\"Only\")\n174\t        only.owner = p1\n175\t        only.controller = p1\n176\t        lib.add(only)\n177\t        # Provide a generous answer queue; effect should examine only one card.\n178\t        p1._script.extend([False, False])\n179\t        _ability_by_cost(card, +1).effect(game)\n180\t        # Card stays in the library since it was not binned.\n181\t        assert game.get_library(p1).contains(only)\n182\t\n183\t    def test_surveil_empty_library_does_not_raise(self) -> None:\n184\t        game = create_game()\n185\t        p1 = game.players[0]\n186\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n187\t        set_board_state(game, 0, battlefield=[card])\n188\t        # Empty library — nothing to surveil.\n189\t        _ability_by_cost(card, +1).effect(game)\n190\t        assert len(game.get_graveyard(p1).get_all()) == 0\n191\t\n192\t\n193\t# ---------------------------------------------------------------------------\n194\t# -1: Any number of target players each discard a card\n195\t# ---------------------------------------------------------------------------\n196\t\n197\t\n198\tclass TestRalDiscard:\n199\t    \"\"\"−1: Any number of target players each discard a card.\"\"\"\n200\t\n201\t    def test_targeted_player_discards_a_card(self) -> None:\n202\t        game = create_game()\n203\t        p1, p2 = game.players\n204\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n205\t        victim_card = _instant(\"Doomed\")\n206\t        set_board_state(game, 0, battlefield=[card])\n207\t        set_board_state(game, 1, hand=[victim_card])\n208\t        # Opponent will be made to choose which card to discard.\n209\t        p2._script.append(victim_card)\n210\t        card.chosen_targets = [p2]\n211\t        card._resolve_target = p2\n212\t        _ability_by_cost(card, -1).effect(game)\n213\t        assert not game.get_hand(p2).contains(victim_card)\n214\t        assert game.get_graveyard(p2).contains(victim_card)\n215\t\n216\t    def test_no_targets_is_a_noop(self) -> None:\n217\t        \"\"\"With zero chosen target players, nobody discards and nothing raises.\"\"\"\n218\t        game = create_game()\n219\t        p1, p2 = game.players\n220\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n221\t        kept = _instant(\"Kept\")\n222\t        set_board_state(game, 0, battlefield=[card])\n223\t        set_board_state(game, 1, hand=[kept])\n224\t        card.chosen_targets = []\n225\t        _ability_by_cost(card, -1).effect(game)\n226\t        assert game.get_hand(p2).contains(kept)\n227\t\n228\t    def test_targeted_player_with_empty_hand_does_not_raise(self) -> None:\n229\t        game = create_game()\n230\t        p1, p2 = game.players\n231\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n232\t        set_board_state(game, 0, battlefield=[card])\n233\t        set_board_state(game, 1, hand=[])\n234\t        card.chosen_targets = [p2]\n235\t        card._resolve_target = p2\n236\t        _ability_by_cost(card, -1).effect(game)\n237\t        assert len(game.get_hand(p2).get_all()) == 0\n238\t\n239\t\n240\t# ---------------------------------------------------------------------------\n241\t# -2: Reanimate a low-mana-value creature from your graveyard\n242\t# ---------------------------------------------------------------------------\n243\t\n244\t\n245\tclass TestRalReanimate:\n246\t    \"\"\"−2: Return target creature card with mana value 3 or less from your\n247\t    graveyard to the battlefield.\"\"\"\n248\t\n249\t    def test_returns_low_mv_creature_to_battlefield(self) -> None:\n250\t        game = create_game()\n251\t        p1 = game.players[0]\n252\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n253\t        target = _creature(\"Goblin\", \"{1}{R}\")  # mana value 2\n254\t        set_board_state(game, 0, battlefield=[card], graveyard=[target])\n255\t        card.chosen_targets = [target]\n256\t        card._resolve_target = target\n257\t        _ability_by_cost(card, -2).effect(game)\n258\t        assert game.get_battlefield(p1).contains(target)\n259\t        assert not game.get_graveyard(p1).contains(target)\n260\t\n261\t    def test_mv_exactly_three_is_legal(self) -> None:\n262\t        game = create_game()\n263\t        p1 = game.players[0]\n264\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n265\t        target = _creature(\"Bear Cavalry\", \"{1}{B}{B}\")  # mana value 3\n266\t        set_board_state(game, 0, battlefield=[card], graveyard=[target])\n267\t        card.chosen_targets = [target]\n268\t        card._resolve_target = target\n269\t        _ability_by_cost(card, -2).effect(game)\n270\t        assert game.get_battlefield(p1).contains(target)\n271\t\n272\t    def test_target_filter_rejects_high_mv_creature(self) -> None:\n273\t        \"\"\"A creature with mana value 4+ is not a legal target for the −2.\"\"\"\n274\t        game = create_game()\n275\t        p1 = game.players[0]\n276\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n277\t        big = _creature(\"Dragon\", \"{2}{R}{R}\")  # mana value 4\n278\t        # Resolve the −2 with the big creature as the (illegal) chosen target.\n279\t        set_board_state(game, 0, battlefield=[card], graveyard=[big])\n280\t        card.chosen_targets = [big]\n281\t        card._resolve_target = big\n282\t        _ability_by_cost(card, -2).effect(game)\n283\t        # An mv-4 creature must NOT be reanimated.\n284\t        assert not game.get_battlefield(p1).contains(big)\n285\t        assert game.get_graveyard(p1).contains(big)\n286\t\n287\t    def test_target_filter_rejects_noncreature(self) -> None:\n288\t        \"\"\"A noncreature card (e.g. an instant) is not a legal target.\"\"\"\n289\t        game = create_game()\n290\t        p1 = game.players[0]\n291\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n292\t        spell = _instant(\"Bolt\")  # mana value 2 but not a creature\n293\t        set_board_state(game, 0, battlefield=[card], graveyard=[spell])\n294\t        card.chosen_targets = [spell]\n295\t        card._resolve_target = spell\n296\t        _ability_by_cost(card, -2).effect(game)\n297\t        assert not game.get_battlefield(p1).contains(spell)\n298\t        assert game.get_graveyard(p1).contains(spell)\n299\t\n300\t    def test_only_your_graveyard(self) -> None:\n301\t        \"\"\"A low-mv creature in the OPPONENT's graveyard is not a legal target.\"\"\"\n302\t        game = create_game()\n303\t        p1, p2 = game.players\n304\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n305\t        opp_creature = _creature(\"Their Goblin\", \"{R}\")  # mana value 1\n306\t        opp_creature.owner = p2\n307\t        opp_creature.controller = p2\n308\t        set_board_state(game, 0, battlefield=[card])\n309\t        set_board_state(game, 1, graveyard=[opp_creature])\n310\t        card.chosen_targets = [opp_creature]\n311\t        card._resolve_target = opp_creature\n312\t        _ability_by_cost(card, -2).effect(game)\n313\t        # It must not enter your battlefield.\n314\t        assert not game.get_battlefield(p1).contains(opp_creature)\n315\t\n316\t    def test_no_target_chosen_is_a_noop(self) -> None:\n317\t        game = create_game()\n318\t        p1 = game.players[0]\n319\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n320\t        creature = _creature(\"Goblin\", \"{R}\")\n321\t        set_board_state(game, 0, battlefield=[card], graveyard=[creature])\n322\t        # No chosen target.\n323\t        _ability_by_cost(card, -2).effect(game)\n324\t        assert game.get_graveyard(p1).contains(creature)\n325\t        assert not game.get_battlefield(p1).contains(creature)\n326\t\n327\t\n328\t# ---------------------------------------------------------------------------\n329\t# -7: Ultimate (coin flips + skip turns)\n330\t# ---------------------------------------------------------------------------\n331\t\n332\t\n333\tclass TestRalUltimate:\n334\t    \"\"\"−7: Flip five coins. Target opponent skips their next X turns.\n335\t\n336\t    The randomness (five coin flips) and the turn-skipping mechanic are not\n337\t    backed by the engine's deterministic API (see untestable.json). What we\n338\t    can verify here is that the ultimate is declared with the right loyalty\n339\t    cost and that resolving it never raises.\"\"\"\n340\t\n341\t    def test_ultimate_loyalty_cost_is_minus_seven(self) -> None:\n342\t        ab = _ability_by_cost(RalZarekGuestLecturer(owner=None), -7)\n343\t        assert ab.loyalty_cost == -7\n344\t\n345\t    def test_ultimate_resolution_does_not_raise(self) -> None:\n346\t        game = create_game()\n347\t        p1, p2 = game.players\n348\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n349\t        set_board_state(game, 0, battlefield=[card])\n350\t        card.chosen_targets = [p2]\n351\t        card._resolve_target = p2\n352\t        # Should not raise regardless of how coins land.\n353\t        _ability_by_cost(card, -7).effect(game)\n354\t"}]},"parent_tool_use_id":"toolu_01EVQk5wqb73SzprdJXKMZAu","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"8af1a1fc-38b4-4900-ab10-b94a2b8ba275","timestamp":"2026-06-01T09:18:37.830Z","subagent_type":"Implementer","task_description":"Implement sos_97"}
