{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01USDwuTHuAL4vLZ1GgXPbBr","type":"tool_result","content":"1\t\"\"\"Tests for SOS 1 — The Dawning Archaic.\n2\t\n3\tThe Dawning Archaic is a {10} Legendary Creature — Avatar, 7/7, with:\n4\t\n5\t1. **Cost reduction** — \"This spell costs {1} less to cast for each instant and\n6\t   sorcery card in your graveyard.\" Modeled via the ``cost_reduction(game)``\n7\t   hook (only generic mana is reduced).\n8\t2. **Reach** keyword.\n9\t3. **Attack trigger** — \"Whenever The Dawning Archaic attacks, you may cast\n10\t   target instant or sorcery card from your graveyard without paying its mana\n11\t   cost. If that spell would be put into your graveyard, exile it instead.\"\n12\t   Modeled via ``register_triggers`` watching ``AttacksTriggeredEvent``.\n13\t\n14\tThese tests define the TDD contract; ``card_impl.py`` is a stub, so they are\n15\texpected to fail until the card is implemented.\n16\t\"\"\"\n17\t\n18\tfrom __future__ import annotations\n19\t\n20\tfrom cards.sos.sos_1.card_impl import TheDawningArchaic\n21\tfrom engine.card import Creature, Instant, Sorcery\n22\tfrom engine.events import AttacksTriggeredEvent\n23\tfrom engine.triggers import TriggerRegistration\n24\tfrom engine.types import (\n25\t    CardType,\n26\t    Keyword,\n27\t    ManaCost,\n28\t    Supertype,\n29\t    Zone,\n30\t)\n31\tfrom test_utils import create_game, set_board_state\n32\t\n33\t\n34\t# ---------------------------------------------------------------------------\n35\t# Helpers\n36\t# ---------------------------------------------------------------------------\n37\t\n38\t\n39\tdef _instant(name: str = \"Test Instant\") -> Instant:\n40\t    \"\"\"A vanilla instant card with a nonzero mana cost.\"\"\"\n41\t    return Instant(name=name, mana_cost=ManaCost.parse(\"{1}{U}\"))\n42\t\n43\t\n44\tdef _sorcery(name: str = \"Test Sorcery\") -> Sorcery:\n45\t    \"\"\"A vanilla sorcery card with a nonzero mana cost.\"\"\"\n46\t    return Sorcery(name=name, mana_cost=ManaCost.parse(\"{2}{R}\"))\n47\t\n48\t\n49\tdef _vanilla_creature(name: str = \"Grizzly Bears\") -> Creature:\n50\t    c = Creature(name=name, base_power=2, base_toughness=2)\n51\t    c.card_types = {CardType.CREATURE}\n52\t    return c\n53\t\n54\t\n55\t# ---------------------------------------------------------------------------\n56\t# Static card data\n57\t# ---------------------------------------------------------------------------\n58\t\n59\t\n60\tclass TestTheDawningArchaicProperties:\n61\t    \"\"\"Static card data should match the SOS 1 spec.\"\"\"\n62\t\n63\t    def test_is_creature(self) -> None:\n64\t        assert isinstance(TheDawningArchaic(owner=None), Creature)\n65\t\n66\t    def test_name(self) -> None:\n67\t        assert TheDawningArchaic(owner=None).name == \"The Dawning Archaic\"\n68\t\n69\t    def test_mana_cost(self) -> None:\n70\t        assert TheDawningArchaic(owner=None).mana_cost == ManaCost.parse(\"{10}\")\n71\t\n72\t    def test_power_toughness(self) -> None:\n73\t        card = TheDawningArchaic(owner=None)\n74\t        assert card.base_power == 7\n75\t        assert card.base_toughness == 7\n76\t\n77\t    def test_is_legendary(self) -> None:\n78\t        assert Supertype.LEGENDARY in TheDawningArchaic(owner=None).supertypes\n79\t\n80\t    def test_is_avatar(self) -> None:\n81\t        assert \"Avatar\" in TheDawningArchaic(owner=None).subtypes\n82\t\n83\t    def test_has_reach(self) -> None:\n84\t        assert Keyword.REACH in TheDawningArchaic(owner=None).keywords\n85\t\n86\t    def test_is_colorless(self) -> None:\n87\t        \"\"\"Cost is {10} generic only — the creature has no colored pips.\"\"\"\n88\t        card = TheDawningArchaic(owner=None)\n89\t        assert card.mana_cost.pips == {}\n90\t\n91\t\n92\t# ---------------------------------------------------------------------------\n93\t# Cost reduction\n94\t# ---------------------------------------------------------------------------\n95\t\n96\t\n97\tclass TestTheDawningArchaicCostReduction:\n98\t    \"\"\"Costs {1} less for each instant and sorcery card in your graveyard.\"\"\"\n99\t\n100\t    def test_no_reduction_with_empty_graveyard(self) -> None:\n101\t        game = create_game()\n102\t        p1 = game.players[0]\n103\t        card = TheDawningArchaic(owner=p1, controller=p1)\n104\t        assert card.cost_reduction(game) == 0\n105\t\n106\t    def test_one_instant_reduces_by_one(self) -> None:\n107\t        game = create_game()\n108\t        p1 = game.players[0]\n109\t        set_board_state(game, 0, graveyard=[_instant()])\n110\t        card = TheDawningArchaic(owner=p1, controller=p1)\n111\t        assert card.cost_reduction(game) == 1\n112\t\n113\t    def test_one_sorcery_reduces_by_one(self) -> None:\n114\t        game = create_game()\n115\t        p1 = game.players[0]\n116\t        set_board_state(game, 0, graveyard=[_sorcery()])\n117\t        card = TheDawningArchaic(owner=p1, controller=p1)\n118\t        assert card.cost_reduction(game) == 1\n119\t\n120\t    def test_mixed_instants_and_sorceries_sum(self) -> None:\n121\t        game = create_game()\n122\t        p1 = game.players[0]\n123\t        set_board_state(\n124\t            game,\n125\t            0,\n126\t            graveyard=[_instant(\"I1\"), _instant(\"I2\"), _sorcery(\"S1\")],\n127\t        )\n128\t        card = TheDawningArchaic(owner=p1, controller=p1)\n129\t        assert card.cost_reduction(game) == 3\n130\t\n131\t    def test_noninstant_nonsorcery_cards_do_not_reduce(self) -> None:\n132\t        \"\"\"Creatures and other cards in the graveyard do not reduce the cost.\"\"\"\n133\t        game = create_game()\n134\t        p1 = game.players[0]\n135\t        set_board_state(game, 0, graveyard=[_vanilla_creature(), _vanilla_creature(\"Ogre\")])\n136\t        card = TheDawningArchaic(owner=p1, controller=p1)\n137\t        assert card.cost_reduction(game) == 0\n138\t\n139\t    def test_only_your_graveyard_counts(self) -> None:\n140\t        \"\"\"Instants/sorceries in the opponent's graveyard must not reduce cost.\"\"\"\n141\t        game = create_game()\n142\t        p1 = game.players[0]\n143\t        # Opponent's graveyard full of spells.\n144\t        set_board_state(game, 1, graveyard=[_instant(), _sorcery(), _instant(\"X\")])\n145\t        # Your graveyard has just one spell.\n146\t        set_board_state(game, 0, graveyard=[_sorcery(\"Mine\")])\n147\t        card = TheDawningArchaic(owner=p1, controller=p1)\n148\t        assert card.cost_reduction(game) == 1\n149\t\n150\t\n151\t# ---------------------------------------------------------------------------\n152\t# Attack trigger registration\n153\t# ---------------------------------------------------------------------------\n154\t\n155\t\n156\tclass TestTheDawningArchaicTriggerRegistration:\n157\t    \"\"\"register_triggers wires an AttacksTriggeredEvent trigger.\"\"\"\n158\t\n159\t    def test_registers_one_attack_trigger(self) -> None:\n160\t        game = create_game()\n161\t        p1 = game.players[0]\n162\t        card = TheDawningArchaic(owner=p1, controller=p1)\n163\t        before = len(game.trigger_manager.get_triggers())\n164\t        card.register_triggers(game)\n165\t        after = len(game.trigger_manager.get_triggers())\n166\t        assert after - before == 1\n167\t\n168\t    def test_registered_trigger_watches_attacks_event(self) -> None:\n169\t        game = create_game()\n170\t        p1 = game.players[0]\n171\t        card = TheDawningArchaic(owner=p1, controller=p1)\n172\t        card.register_triggers(game)\n173\t        regs = game.trigger_manager.get_triggers_for_source(card)\n174\t        assert len(regs) == 1\n175\t        reg = regs[0]\n176\t        assert isinstance(reg, TriggerRegistration)\n177\t        assert reg.event_type is AttacksTriggeredEvent\n178\t\n179\t    def test_trigger_condition_matches_self_attacking(self) -> None:\n180\t        \"\"\"The trigger's condition should fire only when this card attacks.\"\"\"\n181\t        game = create_game()\n182\t        p1 = game.players[0]\n183\t        card = TheDawningArchaic(owner=p1, controller=p1)\n184\t        card.register_triggers(game)\n185\t        reg = game.trigger_manager.get_triggers_for_source(card)[0]\n186\t        if reg.condition is None:\n187\t            # An always-fire trigger is acceptable; the effect must self-guard.\n188\t            return\n189\t        event = AttacksTriggeredEvent(creature=card, attacker=card)\n190\t        assert reg.condition(game, event) is True\n191\t\n192\t    def test_trigger_condition_ignores_other_attacker(self) -> None:\n193\t        \"\"\"A different creature attacking must not satisfy the condition.\"\"\"\n194\t        game = create_game()\n195\t        p1 = game.players[0]\n196\t        card = TheDawningArchaic(owner=p1, controller=p1)\n197\t        card.register_triggers(game)\n198\t        reg = game.trigger_manager.get_triggers_for_source(card)[0]\n199\t        if reg.condition is None:\n200\t            return\n201\t        other = _vanilla_creature()\n202\t        event = AttacksTriggeredEvent(creature=other, attacker=other)\n203\t        assert reg.condition(game, event) is False\n204\t\n205\t\n206\t# ---------------------------------------------------------------------------\n207\t# Attack-trigger targeting\n208\t# ---------------------------------------------------------------------------\n209\t\n210\t\n211\tclass TestTheDawningArchaicTargeting:\n212\t    \"\"\"The attack trigger targets an instant or sorcery in your graveyard.\"\"\"\n213\t\n214\t    def test_get_targets_advertises_graveyard_zone(self) -> None:\n215\t        game = create_game()\n216\t        p1 = game.players[0]\n217\t        card = TheDawningArchaic(owner=p1, controller=p1)\n218\t        reqs = card.get_targets(game)\n219\t        assert isinstance(reqs, list)\n220\t        assert len(reqs) == 1\n221\t        assert reqs[0].zone == Zone.GRAVEYARD\n222\t\n223\t    def test_target_filter_accepts_instant(self) -> None:\n224\t        game = create_game()\n225\t        p1 = game.players[0]\n226\t        card = TheDawningArchaic(owner=p1, controller=p1)\n227\t        req = card.get_targets(game)[0]\n228\t        assert req.filter_fn(_instant()) is True\n229\t\n230\t    def test_target_filter_accepts_sorcery(self) -> None:\n231\t        game = create_game()\n232\t        p1 = game.players[0]\n233\t        card = TheDawningArchaic(owner=p1, controller=p1)\n234\t        req = card.get_targets(game)[0]\n235\t        assert req.filter_fn(_sorcery()) is True\n236\t\n237\t    def test_target_filter_rejects_creature(self) -> None:\n238\t        \"\"\"A creature card in the graveyard is not a legal target.\"\"\"\n239\t        game = create_game()\n240\t        p1 = game.players[0]\n241\t        card = TheDawningArchaic(owner=p1, controller=p1)\n242\t        req = card.get_targets(game)[0]\n243\t        assert req.filter_fn(_vanilla_creature()) is False\n244\t\n245\t\n246\t# ---------------------------------------------------------------------------\n247\t# Attack-trigger effect: free cast from graveyard\n248\t# ---------------------------------------------------------------------------\n249\t\n250\t\n251\tdef _fire_attack_trigger(game, card) -> None:\n252\t    \"\"\"Register the card's triggers and fire an attack event for it.\"\"\"\n253\t    card.register_triggers(game)\n254\t    game.trigger_manager.fire_event(\n255\t        game, AttacksTriggeredEvent(creature=card, attacker=card)\n256\t    )\n257\t\n258\t\n259\tclass TestTheDawningArchaicFreeCast:\n260\t    \"\"\"The attack trigger casts a targeted instant/sorcery from the graveyard\n261\t    without paying its mana cost.\"\"\"\n262\t\n263\t    def test_targeted_spell_leaves_graveyard_when_cast(self) -> None:\n264\t        game = create_game()\n265\t        p1 = game.players[0]\n266\t        game.active_player_index = 0\n267\t        archaic = TheDawningArchaic(owner=p1, controller=p1)\n268\t        spell = _sorcery(\"Lava Spike\")\n269\t        set_board_state(game, 0, battlefield=[archaic], graveyard=[spell])\n270\t        # Direct the chosen target to the spell.\n271\t        archaic.chosen_targets = [spell]\n272\t\n273\t        _fire_attack_trigger(game, archaic)\n274\t        # Resolve the trigger on the stack.\n275\t        while not game.stack.is_empty():\n276\t            game.stack.pop().on_resolve(game)\n277\t\n278\t        # The spell should no longer be sitting in the graveyard — it was put\n279\t        # on the stack (free-cast) and resolved out of the graveyard.\n280\t        assert not game.get_graveyard(p1).contains(spell)\n281\t\n282\t    def test_no_mana_required_for_free_cast(self) -> None:\n283\t        \"\"\"The controller pays nothing — an empty mana pool still casts.\"\"\"\n284\t        game = create_game()\n285\t        p1 = game.players[0]\n286\t        game.active_player_index = 0\n287\t        archaic = TheDawningArchaic(owner=p1, controller=p1)\n288\t        spell = _sorcery(\"Lava Spike\")\n289\t        set_board_state(game, 0, battlefield=[archaic], graveyard=[spell], mana={})\n290\t        archaic.chosen_targets = [spell]\n291\t\n292\t        _fire_attack_trigger(game, archaic)\n293\t        while not game.stack.is_empty():\n294\t            game.stack.pop().on_resolve(game)\n295\t\n296\t        # With no mana available, the spell still left the graveyard,\n297\t        # proving the cast did not require mana payment.\n298\t        assert not game.get_graveyard(p1).contains(spell)\n299\t\n300\t\n301\t# ---------------------------------------------------------------------------\n302\t# Replacement: exile instead of graveyard\n303\t# ---------------------------------------------------------------------------\n304\t\n305\t\n306\tclass TestTheDawningArchaicExileReplacement:\n307\t    \"\"\"\"If that spell would be put into your graveyard, exile it instead.\"\n308\t\n309\t    After a free-cast instant/sorcery resolves, it should end up in exile,\n310\t    not back in the graveyard.\n311\t    \"\"\"\n312\t\n313\t    def test_free_cast_spell_is_exiled_after_resolution(self) -> None:\n314\t        game = create_game()\n315\t        p1 = game.players[0]\n316\t        game.active_player_index = 0\n317\t        archaic = TheDawningArchaic(owner=p1, controller=p1)\n318\t        spell = _sorcery(\"Lava Spike\")\n319\t        set_board_state(game, 0, battlefield=[archaic], graveyard=[spell])\n320\t        archaic.chosen_targets = [spell]\n321\t\n322\t        _fire_attack_trigger(game, archaic)\n323\t        # Resolve the trigger (free-cast) and then the spell itself.\n324\t        while not game.stack.is_empty():\n325\t            game.stack.pop().on_resolve(game)\n326\t\n327\t        # The replacement redirects the post-resolution move to exile.\n328\t        assert game.players[0].zones[Zone.EXILE].contains(spell)\n329\t        assert not game.get_graveyard(p1).contains(spell)\n330\t\n331\t\n332\t# ---------------------------------------------------------------------------\n333\t# No-op / edge cases\n334\t# ---------------------------------------------------------------------------\n335\t\n336\t\n337\tclass TestTheDawningArchaicNoOp:\n338\t    \"\"\"Defensive cases: no legal target, no chosen target.\"\"\"\n339\t\n340\t    def test_no_target_chosen_is_a_noop(self) -> None:\n341\t        \"\"\"Firing the trigger without a chosen target must not raise and must\n342\t        not move any card out of the graveyard.\"\"\"\n343\t        game = create_game()\n344\t        p1 = game.players[0]\n345\t        game.active_player_index = 0\n346\t        archaic = TheDawningArchaic(owner=p1, controller=p1)\n347\t        spell = _sorcery(\"Lava Spike\")\n348\t        set_board_state(game, 0, battlefield=[archaic], graveyard=[spell])\n349\t        # No chosen_targets set.\n350\t\n351\t        _fire_attack_trigger(game, archaic)\n352\t        while not game.stack.is_empty():\n353\t            game.stack.pop().on_resolve(game)\n354\t\n355\t        # Nothing chosen → the spell stays in the graveyard.\n356\t        assert game.get_graveyard(p1).contains(spell)\n357\t\n358\t    def test_empty_graveyard_no_targets_available(self) -> None:\n359\t        \"\"\"With no instants/sorceries in the graveyard, no legal targets.\"\"\"\n360\t        game = create_game()\n361\t        p1 = game.players[0]\n362\t        archaic = TheDawningArchaic(owner=p1, controller=p1)\n363\t        set_board_state(game, 0, battlefield=[archaic], graveyard=[])\n364\t        req = archaic.get_targets(game)[0]\n365\t        # The filter still describes instant-or-sorcery, but no card in the\n366\t        # (empty) graveyard satisfies it.\n367\t        gy = game.get_graveyard(p1).get_all()\n368\t        legal = [c for c in gy if req.filter_fn(c)]\n369\t        assert legal == []\n370\t"}]},"parent_tool_use_id":"toolu_01NFRPvSxWwFBmgyfa4TCZrp","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"4d8665be-0e8b-43ae-b576-5cadaebd932f","timestamp":"2026-06-01T08:32:31.119Z","subagent_type":"Implementer","task_description":"Revise sos_1 per review"}
