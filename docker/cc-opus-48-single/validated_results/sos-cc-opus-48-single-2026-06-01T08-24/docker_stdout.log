{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016TWavFWjqCT9jaLvhdWHMk","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_201/card_impl.py b/cards/sos/sos_201/card_impl.py\n2\tindex 7b52d28..356d1cd 100644\n3\t--- a/cards/sos/sos_201/card_impl.py\n4\t+++ b/cards/sos/sos_201/card_impl.py\n5\t@@ -1,16 +1,194 @@\n6\t-\"\"\"Card implementation for Lorehold, the Historian.\"\"\"\n7\t+\"\"\"Card implementation for Lorehold, the Historian (SOS 201).\"\"\"\n8\t \n9\t from __future__ import annotations\n10\t \n11\t-from engine.card import CardImpl\n12\t+from typing import TYPE_CHECKING, Any\n13\t \n14\t-from typing import TYPE_CHECKING\n15\t+from engine.card import Creature\n16\t+from engine.types import CardType, Keyword, ManaCost, Supertype\n17\t \n18\t if TYPE_CHECKING:\n19\t     from engine.game_state import GameState\n20\t \n21\t \n22\t-class LoreholdTheHistorian(CardImpl):\n23\t-    \"\"\"TODO: Implement Lorehold, the Historian.\"\"\"\n24\t+# The granted miracle cost — \"miracle {2}\".\n25\t+_MIRACLE_COST_STR = \"{2}\"\n26\t \n27\t-    pass\n28\t+\n29\t+def _is_instant_or_sorcery(card: Any) -> bool:\n30\t+    \"\"\"Return ``True`` if *card* is an instant or sorcery card.\"\"\"\n31\t+    types = getattr(card, \"card_types\", set())\n32\t+    return CardType.INSTANT in types or CardType.SORCERY in types\n33\t+\n34\t+\n35\t+class LoreholdTheHistorian(Creature):\n36\t+    \"\"\"Lorehold, the Historian — {3}{R}{W} — 5/5 Legendary Creature — Elder Dragon.\n37\t+\n38\t+    - Flying, haste.\n39\t+    - Each instant and sorcery card in your hand has miracle {2}.\n40\t+      (You may cast a card for its miracle cost when you draw it if it's the\n41\t+      first card you drew this turn.)\n42\t+    - At the beginning of each opponent's upkeep, you may discard a card. If\n43\t+      you do, draw a card.\n44\t+\n45\t+    SOS collector number 201.\n46\t+    \"\"\"\n47\t+\n48\t+    def __init__(self, **kwargs: Any) -> None:\n49\t+        kwargs.setdefault(\"name\", \"Lorehold, the Historian\")\n50\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{3}{R}{W}\"))\n51\t+        kwargs.setdefault(\"subtypes\", {\"Elder\", \"Dragon\"})\n52\t+        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n53\t+        kwargs.setdefault(\"keywords\", Keyword.FLYING | Keyword.HASTE)\n54\t+        kwargs.setdefault(\"base_power\", 5)\n55\t+        kwargs.setdefault(\"base_toughness\", 5)\n56\t+        kwargs.setdefault(\n57\t+            \"rules_text\",\n58\t+            \"Flying, haste\\n\"\n59\t+            \"Each instant and sorcery card in your hand has miracle {2}. \"\n60\t+            \"(You may cast a card for its miracle cost when you draw it if it's \"\n61\t+            \"the first card you drew this turn.)\\n\"\n62\t+            \"At the beginning of each opponent's upkeep, you may discard a \"\n63\t+            \"card. If you do, draw a card.\",\n64\t+        )\n65\t+        super().__init__(**kwargs)\n66\t+\n67\t+    # ------------------------------------------------------------------\n68\t+    # Miracle granting (static half)\n69\t+    # ------------------------------------------------------------------\n70\t+\n71\t+    def _controller(self) -> Any:\n72\t+        return getattr(self, \"controller\", None) or getattr(self, \"owner\", None)\n73\t+\n74\t+    def get_miracle_cost(self, game: \"GameState\", card: Any) -> ManaCost | None:\n75\t+        \"\"\"Return the granted miracle cost for *card*, or ``None``.\n76\t+\n77\t+        \"Each instant and sorcery card in your hand has miracle {2}.\" The grant\n78\t+        is restricted to instants/sorceries that are in *Lorehold's controller's*\n79\t+        hand. Anything else (wrong type, wrong zone, wrong controller) gets no\n80\t+        miracle and returns ``None``.\n81\t+        \"\"\"\n82\t+        controller = self._controller()\n83\t+        if controller is None:\n84\t+            return None\n85\t+        if not _is_instant_or_sorcery(card):\n86\t+            return None\n87\t+        hand = game.get_hand(controller)\n88\t+        if not hand.contains(card):\n89\t+            return None\n90\t+        return ManaCost.parse(_MIRACLE_COST_STR)\n91\t+\n92\t+    # ------------------------------------------------------------------\n93\t+    # Dynamic miracle window — \"cast it when you draw it, first card this turn\"\n94\t+    # ------------------------------------------------------------------\n95\t+\n96\t+    def register_miracle_window(self, game: \"GameState\") -> None:\n97\t+        \"\"\"Register Lorehold's miracle grant with the engine draw-window hook.\n98\t+\n99\t+        While Lorehold is on the battlefield, the first instant/sorcery its\n100\t+        controller draws each turn may be cast for the granted miracle cost\n101\t+        ({2}). This routes through the additive\n102\t+        ``engine.casting.cast_spell_alternative`` entry point and the\n103\t+        ``engine.game`` miracle draw-window registry, both of which are no-ops\n104\t+        when no grant is registered.\n105\t+        \"\"\"\n106\t+        register = getattr(game, \"register_miracle_grant\", None)\n107\t+        if register is None:\n108\t+            return\n109\t+\n110\t+        source = self\n111\t+        controller = self._controller()\n112\t+\n113\t+        def _grant(g: \"GameState\", drawing_player: Any, drawn_card: Any) -> Any:\n114\t+            # Only the controller's own first draw, only instants/sorceries,\n115\t+            # and only while Lorehold is on the battlefield.\n116\t+            if controller is None or drawing_player is not controller:\n117\t+                return None\n118\t+            battlefield = g.get_battlefield(controller)\n119\t+            if not battlefield.contains(source):\n120\t+                return None\n121\t+            if not _is_instant_or_sorcery(drawn_card):\n122\t+                return None\n123\t+            return ManaCost.parse(_MIRACLE_COST_STR)\n124\t+\n125\t+        register(_grant, source=source, controller=controller)\n126\t+\n127\t+    # ------------------------------------------------------------------\n128\t+    # Opponent-upkeep loot trigger\n129\t+    # ------------------------------------------------------------------\n130\t+\n131\t+    def register_triggers(self, game: \"GameState\") -> None:\n132\t+        \"\"\"Register the opponent-upkeep loot trigger.\n133\t+\n134\t+        \"At the beginning of each opponent's upkeep, you may discard a card. If\n135\t+        you do, draw a card.\" The engine's ``BeginningOfUpkeepTriggeredEvent``\n136\t+        carries no player field and fires for the active player's upkeep, so the\n137\t+        opponent-vs-self distinction lives in the trigger's ``condition`` and is\n138\t+        keyed off ``game.active_player`` (the controller's own upkeep does not\n139\t+        fire this).\n140\t+        \"\"\"\n141\t+        from engine.events import BeginningOfUpkeepTriggeredEvent\n142\t+        from engine.triggers import TriggerRegistration\n143\t+\n144\t+        source = self\n145\t+        controller = self._controller() or game.active_player\n146\t+\n147\t+        # Also wire up the dynamic miracle window when triggers register\n148\t+        # (typically as the permanent enters the battlefield).\n149\t+        self.register_miracle_window(game)\n150\t+\n151\t+        def _condition(g: Any, event: Any) -> bool:\n152\t+            # Fires only on an opponent's upkeep — i.e. when the active player\n153\t+            # is someone other than Lorehold's controller.\n154\t+            return getattr(g, \"active_player\", None) is not controller\n155\t+\n156\t+        def _effect(g: \"GameState\") -> None:\n157\t+            source._loot(g, controller)\n158\t+\n159\t+        game.trigger_manager.register(\n160\t+            TriggerRegistration(\n161\t+                event_type=BeginningOfUpkeepTriggeredEvent,\n162\t+                condition=_condition,\n163\t+                effect=_effect,\n164\t+                source=self,\n165\t+                controller=controller,\n166\t+            )\n167\t+        )\n168\t+\n169\t+    def _loot(self, game: \"GameState\", controller: Any) -> None:\n170\t+        \"\"\"\"you may discard a card; if you do, draw a card.\" \"\"\"\n171\t+        from engine.game import discard, draw_card\n172\t+\n173\t+        if controller is None:\n174\t+            return\n175\t+\n176\t+        hand = game.get_hand(controller)\n177\t+        hand_cards = list(hand.get_all())\n178\t+\n179\t+        # \"you may discard\" — ask the controller. Even with an empty hand we\n180\t+        # still consult so a declining script answer is consumed cleanly; but\n181\t+        # an empty hand simply can't discard, so it's a no-op.\n182\t+        choose_yes_no = getattr(controller, \"choose_yes_no\", None)\n183\t+        wants = False\n184\t+        if choose_yes_no is not None:\n185\t+            try:\n186\t+                wants = bool(choose_yes_no(\"Discard a card to draw a card?\"))\n187\t+            except Exception:\n188\t+                wants = False\n189\t+\n190\t+        if not wants or not hand_cards:\n191\t+            return\n192\t+\n193\t+        # Choose which card to discard.\n194\t+        choose_card = getattr(controller, \"choose_card\", None)\n195\t+        pitch = None\n196\t+        if choose_card is not None:\n197\t+            try:\n198\t+                pitch = choose_card(hand_cards, \"Choose a card to discard\")\n199\t+            except Exception:\n200\t+                pitch = None\n201\t+        if pitch is None or not hand.contains(pitch):\n202\t+            return\n203\t+\n204\t+        discard(game, controller, pitch)\n205\t+        draw_card(game, controller)\n206\tdiff --git a/engine/casting.py b/engine/casting.py\n207\tindex b044394..cc69d05 100644\n208\t--- a/engine/casting.py\n209\t+++ b/engine/casting.py\n210\t@@ -376,6 +376,126 @@ def cast_spell_free(\n211\t     game.stack.push(stack_obj)\n212\t \n213\t \n214\t+# ------------------------------------------------------------------\n215\t+# Cast spell for a specified alternative cost (e.g. miracle)\n216\t+# ------------------------------------------------------------------\n217\t+\n218\t+\n219\t+def cast_spell_alternative(\n220\t+    game: GameState,\n221\t+    player: Player,\n222\t+    card: CardImpl,\n223\t+    from_zone: Zone,\n224\t+    alternative_cost: ManaCost,\n225\t+) -> None:\n226\t+    \"\"\"Cast *card* by paying *alternative_cost* instead of its mana cost.\n227\t+\n228\t+    This is the entry point for alternative-cost casts such as miracle, where a\n229\t+    card is cast \"by paying [cost] rather than its mana cost\" (rule 702.94a).\n230\t+    It mirrors :func:`cast_spell` (legality, target choice, mana payment, the\n231\t+    ``on_cast`` hook, and pushing a :class:`StackObject`) but:\n232\t+\n233\t+    * the card may come from any *from_zone* (not just the hand), and\n234\t+    * mana payment uses *alternative_cost* rather than ``card.mana_cost``.\n235\t+\n236\t+    No timing or sorcery-speed check is performed here — the caller (a miracle\n237\t+    window, etc.) is responsible for invoking this only at a legal time. The\n238\t+    spell is placed on the stack and can be responded to normally.\n239\t+\n240\t+    Raises:\n241\t+        CastingError: If legality fails or the player cannot pay\n242\t+            *alternative_cost* (the card is rolled back to *from_zone*).\n243\t+    \"\"\"\n244\t+    # Ensure controller/owner are set.\n245\t+    card.controller = player\n246\t+    if card.owner is None:\n247\t+        card.owner = player\n248\t+\n249\t+    # 1. can_cast legality.\n250\t+    if not card.can_cast(game):\n251\t+        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n252\t+\n253\t+    # 2. Locate the card in its source zone.\n254\t+    source_zone_container = player.zones[from_zone]\n255\t+    if not source_zone_container.contains(card):\n256\t+        source_zone_container = None\n257\t+        for p in game.players:\n258\t+            z = p.zones[from_zone]\n259\t+            if z.contains(card):\n260\t+                source_zone_container = z\n261\t+                break\n262\t+    if source_zone_container is None or not source_zone_container.contains(card):\n263\t+        raise CastingError(\n264\t+            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n265\t+        )\n266\t+\n267\t+    # Move card from source zone to the stack zone.\n268\t+    stack_zone = player.zones[Zone.STACK]\n269\t+    source_zone_container.remove(card)\n270\t+    stack_zone.add(card)\n271\t+\n272\t+    # Clear stale colors_spent before new payment.\n273\t+    if hasattr(card, \"colors_spent\"):\n274\t+        del card.colors_spent\n275\t+\n276\t+    # 3. Choose targets (with rollback on failure).\n277\t+    try:\n278\t+        target_specs = card.get_targets(game)\n279\t+        chosen_targets: list[Any] = []\n280\t+        if target_specs:\n281\t+            for spec in target_specs:\n282\t+                target = player.choose_target(target_specs, spec)\n283\t+                filter_fn = getattr(spec, \"filter_fn\", None)\n284\t+                if filter_fn is not None and target is not None:\n285\t+                    if not filter_fn(target):\n286\t+                        raise CastingError(\n287\t+                            f\"Cannot cast {card.name!r} — chosen target does not \"\n288\t+                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n289\t+                        )\n290\t+                chosen_targets.append(target)\n291\t+\n292\t+        from engine.protection import has_protection_from\n293\t+\n294\t+        for target in chosen_targets:\n295\t+            if has_protection_from(target, card):\n296\t+                raise CastingError(\n297\t+                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n298\t+                )\n299\t+    except Exception as exc:\n300\t+        stack_zone.remove(card)\n301\t+        source_zone_container.add(card)\n302\t+        raise CastingError(str(exc)) from exc\n303\t+\n304\t+    # 4. Mana check / payment against the alternative cost (rollback on failure).\n305\t+    if not player.mana_pool.can_pay(alternative_cost):\n306\t+        stack_zone.remove(card)\n307\t+        source_zone_container.add(card)\n308\t+        raise CastingError(\n309\t+            f\"Cannot cast {card.name!r} — insufficient mana for alternative cost\"\n310\t+        )\n311\t+\n312\t+    player.mana_pool.pay(alternative_cost)\n313\t+    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n314\t+    card.mana_spent = alternative_cost.cmc  # type: ignore[attr-defined]\n315\t+\n316\t+    # 5. Call on_cast hook.\n317\t+    card.on_cast(game)\n318\t+\n319\t+    # 6. Push StackObject.\n320\t+    stack_obj = StackObject(\n321\t+        source=card,\n322\t+        controller=player,\n323\t+        targets=chosen_targets,\n324\t+        on_resolve=lambda g: None,  # replaced below\n325\t+    )\n326\t+\n327\t+    def _on_resolve(g: GameState) -> None:\n328\t+        _resolve_spell(g, card, player, stack_obj)\n329\t+\n330\t+    stack_obj.on_resolve = _on_resolve\n331\t+    game.stack.push(stack_obj)\n332\t+\n333\t+\n334\t # ------------------------------------------------------------------\n335\t # Resolution (called when the stack pops)\n336\t # ------------------------------------------------------------------\n337\tdiff --git a/engine/game.py b/engine/game.py\n338\tindex 46e4195..1846fa4 100644\n339\t--- a/engine/game.py\n340\t+++ b/engine/game.py\n341\t@@ -324,6 +324,7 @@ def draw_card(game: GameState, player: Player) -> Any | None:\n342\t     if not hasattr(player, \"cards_drawn_this_turn\"):\n343\t         player.cards_drawn_this_turn = 0\n344\t     player.cards_drawn_this_turn += 1\n345\t+    is_first_draw_this_turn = player.cards_drawn_this_turn == 1\n346\t \n347\t     # Fire trigger (only if game has a trigger_manager — may not during setup)\n348\t     if hasattr(game, \"trigger_manager\"):\n349\t@@ -332,6 +333,15 @@ def draw_card(game: GameState, player: Player) -> Any | None:\n350\t             DrawsCardTriggeredEvent(player=player, card=card),\n351\t         )\n352\t \n353\t+    # Miracle window (rule 702.94): if this is the first card the player has\n354\t+    # drawn this turn, offer a miracle cast for it. This is a strict no-op when\n355\t+    # no miracle grant is registered (the default), so normal draws are\n356\t+    # unaffected.\n357\t+    if is_first_draw_this_turn:\n358\t+        fire_window = getattr(game, \"fire_miracle_window\", None)\n359\t+        if callable(fire_window):\n360\t+            fire_window(player, card)\n361\t+\n362\t     return card\n363\t \n364\t \n365\tdiff --git a/engine/game_state.py b/engine/game_state.py\n366\tindex b429cd8..235db33 100644\n367\t--- a/engine/game_state.py\n368\t+++ b/engine/game_state.py\n369\t@@ -81,6 +81,12 @@ class GameState:\n370\t         # normal rotation.  When extras are exhausted the game picks up\n371\t         # from _normal_next_index.\n372\t         self._normal_next_index: int = 1\n373\t+        # Additive miracle support (rule 702.94). Each entry is a dict with a\n374\t+        # ``grant`` callable ``(game, player, drawn_card) -> ManaCost | None``\n375\t+        # plus ``source``/``controller`` for cleanup. Empty by default, so the\n376\t+        # miracle draw-window (fired from ``engine.game.draw_card``) is a strict\n377\t+        # no-op unless a card such as Lorehold registers a grant.\n378\t+        self._miracle_grants: list[dict[str, Any]] = []\n379\t \n380\t     # ------------------------------------------------------------------\n381\t     # Player properties\n382\t@@ -125,6 +131,84 @@ class GameState:\n383\t         \"\"\"Return the exile zone for *player*.\"\"\"\n384\t         return player.zones[Zone.EXILE]\n385\t \n386\t+    # ------------------------------------------------------------------\n387\t+    # Miracle support (additive — no-op unless a grant is registered)\n388\t+    # ------------------------------------------------------------------\n389\t+\n390\t+    def register_miracle_grant(\n391\t+        self,\n392\t+        grant: Any,\n393\t+        *,\n394\t+        source: Any = None,\n395\t+        controller: Any = None,\n396\t+    ) -> None:\n397\t+        \"\"\"Register a miracle grant (rule 702.94).\n398\t+\n399\t+        *grant* is a callable ``(game, player, drawn_card) -> ManaCost | None``\n400\t+        that returns the cost the *drawn_card* may be cast for via miracle (or\n401\t+        ``None`` if this grant does not apply). The grant is consulted by\n402\t+        :meth:`fire_miracle_window`, fired from ``engine.game.draw_card`` when a\n403\t+        player draws the first card of their turn. ``source`` is used by\n404\t+        :meth:`unregister_miracle_grant` for cleanup.\n405\t+        \"\"\"\n406\t+        self._miracle_grants.append(\n407\t+            {\"grant\": grant, \"source\": source, \"controller\": controller}\n408\t+        )\n409\t+\n410\t+    def unregister_miracle_grant(self, source: Any) -> None:\n411\t+        \"\"\"Remove all miracle grants registered by *source* (identity-based).\"\"\"\n412\t+        self._miracle_grants = [\n413\t+            g for g in self._miracle_grants if g.get(\"source\") is not source\n414\t+        ]\n415\t+\n416\t+    def fire_miracle_window(self, player: Player, drawn_card: Any) -> None:\n417\t+        \"\"\"Offer a miracle cast for *drawn_card* (the first card drawn this turn).\n418\t+\n419\t+        Consults every registered miracle grant; the first grant that returns a\n420\t+        cost offers *player* the option to cast *drawn_card* for that cost via\n421\t+        :func:`engine.casting.cast_spell_alternative`. With no registered grants\n422\t+        this is a strict no-op, so normal draws are unaffected.\n423\t+        \"\"\"\n424\t+        if not self._miracle_grants:\n425\t+            return\n426\t+\n427\t+        for entry in list(self._miracle_grants):\n428\t+            grant = entry.get(\"grant\")\n429\t+            if grant is None:\n430\t+                continue\n431\t+            try:\n432\t+                cost = grant(self, player, drawn_card)\n433\t+            except Exception:\n434\t+                cost = None\n435\t+            if cost is None:\n436\t+                continue\n437\t+\n438\t+            # \"you may cast it\" — ask the player.\n439\t+            choose_yes_no = getattr(player, \"choose_yes_no\", None)\n440\t+            wants = False\n441\t+            if choose_yes_no is not None:\n442\t+                try:\n443\t+                    wants = bool(\n444\t+                        choose_yes_no(\n445\t+                            f\"Cast {getattr(drawn_card, 'name', drawn_card)!r} \"\n446\t+                            \"for its miracle cost?\"\n447\t+                        )\n448\t+                    )\n449\t+                except Exception:\n450\t+                    wants = False\n451\t+            if not wants:\n452\t+                return\n453\t+\n454\t+            from engine.casting import CastingError, cast_spell_alternative\n455\t+\n456\t+            try:\n457\t+                cast_spell_alternative(\n458\t+                    self, player, drawn_card, Zone.HAND, cost\n459\t+                )\n460\t+            except CastingError:\n461\t+                return\n462\t+            return\n463\t+\n464\t     # ------------------------------------------------------------------\n465\t     # Phase/step progression\n466\t     # ------------------------------------------------------------------\n467\t"}]},"parent_tool_use_id":"toolu_01PzUQHDyTL3F6xPfuQoCZ2o","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"5d59fb8b-ff2e-4384-89c3-a03f8de10bda","timestamp":"2026-06-01T09:45:02.642Z","subagent_type":"Reviewer","task_descrip