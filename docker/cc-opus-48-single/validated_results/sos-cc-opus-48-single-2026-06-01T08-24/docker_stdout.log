{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RzNksoXUiNvY9T29uX4eeA","type":"tool_result","content":"1\t\"\"\"Tests for SOS 257 — Great Hall of the Biblioplex.\n2\t\n3\tTDD red-phase contract for a utility land with:\n4\t\n5\t1. ``{T}: Add {C}.`` — a plain colorless mana ability.\n6\t2. ``{T}, Pay 1 life: Add one mana of any color. Spend this mana only to\n7\t   cast an instant or sorcery spell.`` — a life-paying any-color mana\n8\t   ability restricted to instants/sorceries.\n9\t3. ``{5}: If this land isn't a creature, it becomes a 2/4 Wizard creature\n10\t   with \"Whenever you cast an instant or sorcery spell, this creature gets\n11\t   +1/+0 until end of turn.\" It's still a land.``\n12\t\n13\tThe card is a :class:`engine.card.Land`. Mana abilities are exposed through\n14\t``get_mana_abilities()`` (cost signature ``(game, source) -> bool``, effect\n15\tsignature ``mana_produced(game) -> None``); the animate ability is exposed\n16\tthrough ``get_activated_abilities()`` (an :class:`ActivatedAbility` with a\n17\t``cost(game, source) -> bool`` and ``effect(game) -> None``).\n18\t\"\"\"\n19\t\n20\tfrom __future__ import annotations\n21\t\n22\tfrom cards.sos.sos_257.card_impl import GreatHallOfTheBiblioplex\n23\tfrom engine.card import ActivatedAbility, Land, ManaAbility\n24\tfrom engine.types import CardType, ManaType\n25\tfrom test_utils import create_game, set_board_state\n26\t\n27\t\n28\tdef _hall(game, player_index: int = 0) -> GreatHallOfTheBiblioplex:\n29\t    \"\"\"Return a Hall controlled by the indexed player, on its battlefield.\"\"\"\n30\t    player = game.players[player_index]\n31\t    card = GreatHallOfTheBiblioplex(owner=player, controller=player)\n32\t    set_board_state(game, player_index, battlefield=[card])\n33\t    return card\n34\t\n35\t\n36\tclass TestGreatHallProperties:\n37\t    \"\"\"Static card data should match the SOS 257 spec.\"\"\"\n38\t\n39\t    def test_is_land(self) -> None:\n40\t        assert isinstance(GreatHallOfTheBiblioplex(owner=None), Land)\n41\t\n42\t    def test_name(self) -> None:\n43\t        assert GreatHallOfTheBiblioplex(owner=None).name == \"Great Hall of the Biblioplex\"\n44\t\n45\t    def test_is_land_card_type(self) -> None:\n46\t        assert CardType.LAND in GreatHallOfTheBiblioplex(owner=None).card_types\n47\t\n48\t    def test_not_creature_by_default(self) -> None:\n49\t        \"\"\"A freshly-made Hall is a plain land, not yet a creature.\"\"\"\n50\t        assert CardType.CREATURE not in GreatHallOfTheBiblioplex(owner=None).card_types\n51\t\n52\t    def test_land_cannot_be_cast(self) -> None:\n53\t        game = create_game()\n54\t        assert GreatHallOfTheBiblioplex(owner=None).can_cast(game) is False\n55\t\n56\t\n57\tclass TestGreatHallManaAbilities:\n58\t    \"\"\"get_mana_abilities() advertises both mana abilities.\"\"\"\n59\t\n60\t    def test_returns_two_mana_abilities(self) -> None:\n61\t        abilities = GreatHallOfTheBiblioplex(owner=None).get_mana_abilities()\n62\t        assert isinstance(abilities, list)\n63\t        assert len(abilities) == 2\n64\t\n65\t    def test_all_are_mana_ability_instances(self) -> None:\n66\t        for ab in GreatHallOfTheBiblioplex(owner=None).get_mana_abilities():\n67\t            assert isinstance(ab, ManaAbility)\n68\t\n69\t\n70\tclass TestColorlessManaAbility:\n71\t    \"\"\"{T}: Add {C}.\"\"\"\n72\t\n73\t    def test_taps_and_adds_colorless(self) -> None:\n74\t        game = create_game()\n75\t        card = _hall(game, 0)\n76\t        ability = card.get_mana_abilities()[0]\n77\t        assert ability.cost(game, card) is True\n78\t        assert card.is_tapped is True\n79\t        ability.mana_produced(game)\n80\t        assert game.players[0].mana_pool.get(ManaType.COLORLESS) == 1\n81\t\n82\t    def test_colorless_ability_cannot_be_used_while_tapped(self) -> None:\n83\t        game = create_game()\n84\t        card = _hall(game, 0)\n85\t        card.is_tapped = True\n86\t        ability = card.get_mana_abilities()[0]\n87\t        assert ability.cost(game, card) is False\n88\t\n89\t    def test_colorless_ability_does_not_cost_life(self) -> None:\n90\t        game = create_game()\n91\t        card = _hall(game, 0)\n92\t        before = game.players[0].life\n93\t        ability = card.get_mana_abilities()[0]\n94\t        ability.cost(game, card)\n95\t        assert game.players[0].life == before\n96\t\n97\t\n98\tclass TestAnyColorManaAbility:\n99\t    \"\"\"{T}, Pay 1 life: Add one mana of any color (instant/sorcery only).\"\"\"\n100\t\n101\t    def test_taps_and_pays_one_life(self) -> None:\n102\t        game = create_game()\n103\t        card = _hall(game, 0)\n104\t        before = game.players[0].life\n105\t        ability = card.get_mana_abilities()[1]\n106\t        assert ability.cost(game, card) is True\n107\t        assert card.is_tapped is True\n108\t        assert game.players[0].life == before - 1\n109\t\n110\t    def test_produces_one_mana(self) -> None:\n111\t        \"\"\"Resolving the any-color ability adds exactly one mana to the pool.\"\"\"\n112\t        game = create_game()\n113\t        card = _hall(game, 0)\n114\t        ability = card.get_mana_abilities()[1]\n115\t        ability.cost(game, card)\n116\t        before_total = game.players[0].mana_pool.total()\n117\t        ability.mana_produced(game)\n118\t        assert game.players[0].mana_pool.total() == before_total + 1\n119\t\n120\t    def test_can_produce_a_colored_mana(self) -> None:\n121\t        \"\"\"The ability can produce a colored mana (any of the five colors).\"\"\"\n122\t        game = create_game()\n123\t        card = _hall(game, 0)\n124\t        ability = card.get_mana_abilities()[1]\n125\t        ability.cost(game, card)\n126\t        ability.mana_produced(game)\n127\t        pool = game.players[0].mana_pool\n128\t        colored = sum(\n129\t            pool.get(mt)\n130\t            for mt in (\n131\t                ManaType.WHITE,\n132\t                ManaType.BLUE,\n133\t                ManaType.BLACK,\n134\t                ManaType.RED,\n135\t                ManaType.GREEN,\n136\t            )\n137\t        )\n138\t        assert colored == 1\n139\t\n140\t    def test_any_color_ability_cannot_be_used_while_tapped(self) -> None:\n141\t        game = create_game()\n142\t        card = _hall(game, 0)\n143\t        card.is_tapped = True\n144\t        before = game.players[0].life\n145\t        ability = card.get_mana_abilities()[1]\n146\t        assert ability.cost(game, card) is False\n147\t        # A failed cost must not drain life.\n148\t        assert game.players[0].life == before\n149\t\n150\t\n151\tclass TestAnimateAbility:\n152\t    \"\"\"{5}: become a 2/4 Wizard creature.\"\"\"\n153\t\n154\t    def test_returns_one_activated_ability(self) -> None:\n155\t        abilities = GreatHallOfTheBiblioplex(owner=None).get_activated_abilities()\n156\t        assert isinstance(abilities, list)\n157\t        assert len(abilities) == 1\n158\t        assert isinstance(abilities[0], ActivatedAbility)\n159\t\n160\t    def test_cost_requires_five_generic_mana(self) -> None:\n161\t        \"\"\"With fewer than 5 mana available the cost cannot be paid.\"\"\"\n162\t        game = create_game()\n163\t        card = _hall(game, 0)\n164\t        set_board_state(game, 0, mana={ManaType.COLORLESS: 4})\n165\t        ability = card.get_activated_abilities()[0]\n166\t        assert ability.cost(game, card) is False\n167\t\n168\t    def test_cost_pays_five_generic_mana(self) -> None:\n169\t        game = create_game()\n170\t        card = _hall(game, 0)\n171\t        set_board_state(game, 0, mana={ManaType.COLORLESS: 5})\n172\t        ability = card.get_activated_abilities()[0]\n173\t        assert ability.cost(game, card) is True\n174\t        assert game.players[0].mana_pool.total() == 0\n175\t\n176\t    def test_effect_makes_it_a_creature(self) -> None:\n177\t        game = create_game()\n178\t        card = _hall(game, 0)\n179\t        ability = card.get_activated_abilities()[0]\n180\t        ability.effect(game)\n181\t        assert CardType.CREATURE in card.card_types\n182\t\n183\t    def test_effect_sets_two_four_power_toughness(self) -> None:\n184\t        game = create_game()\n185\t        card = _hall(game, 0)\n186\t        ability = card.get_activated_abilities()[0]\n187\t        ability.effect(game)\n188\t        assert card.power == 2\n189\t        assert card.toughness == 4\n190\t\n191\t    def test_effect_adds_wizard_subtype(self) -> None:\n192\t        game = create_game()\n193\t        card = _hall(game, 0)\n194\t        ability = card.get_activated_abilities()[0]\n195\t        ability.effect(game)\n196\t        assert \"Wizard\" in card.subtypes\n197\t\n198\t    def test_remains_a_land_after_animation(self) -> None:\n199\t        \"\"\"\"It's still a land.\" — LAND type is retained.\"\"\"\n200\t        game = create_game()\n201\t        card = _hall(game, 0)\n202\t        ability = card.get_activated_abilities()[0]\n203\t        ability.effect(game)\n204\t        assert CardType.LAND in card.card_types\n205\t\n206\t    def test_animation_is_noop_when_already_a_creature(self) -> None:\n207\t        \"\"\"\"If this land isn't a creature\" — second activation must not\n208\t        stack a second animation (it stays 2/4, not 4/8).\"\"\"\n209\t        game = create_game()\n210\t        card = _hall(game, 0)\n211\t        ability = card.get_activated_abilities()[0]\n212\t        ability.effect(game)\n213\t        # Already a creature now; activating again should be a no-op.\n214\t        ability.effect(game)\n215\t        assert card.power == 2\n216\t        assert card.toughness == 4\n217\t\n218\t\n219\tclass TestAnimatedProwessTrigger:\n220\t    \"\"\"The animated creature gets +1/+0 whenever its controller casts an\n221\t    instant or sorcery spell.\"\"\"\n222\t\n223\t    @staticmethod\n224\t    def _fire_spell_cast(game, controller) -> None:\n225\t        \"\"\"Fire a SpellCastTriggeredEvent for an instant the controller casts\n226\t        and resolve every triggered ability it puts on the stack.\"\"\"\n227\t        from engine.card import Instant\n228\t        from engine.events import SpellCastTriggeredEvent\n229\t\n230\t        spell = Instant(name=\"Test Bolt\", owner=controller, controller=controller)\n231\t        game.trigger_manager.fire_event(\n232\t            game,\n233\t            SpellCastTriggeredEvent(\n234\t                spell=spell,\n235\t                card=spell,\n236\t                player=controller,\n237\t                controller=controller,\n238\t            ),\n239\t        )\n240\t        while not game.stack.is_empty():\n241\t            game.stack.pop().on_resolve(game)\n242\t        if hasattr(game, \"effect_manager\") and hasattr(game.effect_manager, \"apply_all\"):\n243\t            game.effect_manager.apply_all(game)\n244\t\n245\t    def test_casting_instant_pumps_animated_creature(self) -> None:\n246\t        game = create_game()\n247\t        card = _hall(game, 0)\n248\t        ability = card.get_activated_abilities()[0]\n249\t        ability.effect(game)\n250\t        card.register_triggers(game)\n251\t\n252\t        base_power = card.power\n253\t        base_toughness = card.toughness\n254\t        self._fire_spell_cast(game, game.players[0])\n255\t        # +1/+0 until end of turn.\n256\t        assert card.power == base_power + 1\n257\t        assert card.toughness == base_toughness\n258\t\n259\t    def test_animated_creature_pumps_once_per_spell(self) -> None:\n260\t        \"\"\"Two instants cast in a turn give +2/+0 cumulatively (one trigger\n261\t        each).\"\"\"\n262\t        game = create_game()\n263\t        card = _hall(game, 0)\n264\t        ability = card.get_activated_abilities()[0]\n265\t        ability.effect(game)\n266\t        card.register_triggers(game)\n267\t\n268\t        base_power = card.power\n269\t        self._fire_spell_cast(game, game.players[0])\n270\t        self._fire_spell_cast(game, game.players[0])\n271\t        assert card.power == base_power + 2\n272\t\n273\t    def test_no_pump_before_animation(self) -> None:\n274\t        \"\"\"Before becoming a creature, the land's prowess-style trigger must\n275\t        not fire / must leave it a non-creature with no power bonus.\"\"\"\n276\t        game = create_game()\n277\t        card = _hall(game, 0)\n278\t        # Do NOT animate. Register triggers as a battlefield permanent.\n279\t        card.register_triggers(game)\n280\t        self._fire_spell_cast(game, game.players[0])\n281\t        # Still a non-creature land.\n282\t        assert CardType.CREATURE not in card.card_types\n283\t"}]},"parent_tool_use_id":"toolu_01TE9thFw8in75t2FnPd8KSA","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"24f240df-bdf0-4204-bc43-61753a1067fa","timestamp":"2026-06-01T10:20:39.781Z","subagent_type":"Reviewer","task_description":"Review sos_257"}
