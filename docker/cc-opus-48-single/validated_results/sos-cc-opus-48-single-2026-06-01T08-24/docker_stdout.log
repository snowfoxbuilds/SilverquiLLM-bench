{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017CcNdHrE2GtyXcaX6PyxZ5","type":"tool_result","content":"1\t\"\"\"Tests for SOS 245 — Witherbloom, the Balancer.\n2\t\n3\tWitherbloom, the Balancer is a {6}{B}{G} Legendary Creature — Elder Dragon,\n4\t5/5, with:\n5\t\n6\t1. **Affinity for creatures** — \"This spell costs {1} less to cast for each\n7\t   creature you control.\" Modeled via the ``cost_reduction(game)`` hook (only\n8\t   the generic portion of the cost is reduced; the {B}{G} pips never are).\n9\t2. **Flying** and **Deathtouch** keywords.\n10\t3. **Granted affinity** — \"Instant and sorcery spells you cast have affinity\n11\t   for creatures.\" The engine has no central cost-reduction registry, so (as\n12\t   with FDN 159's analogous \"cost {1} less\" clause) the granting is modeled via\n13\t   a marker the casting system can consult. These tests assert what is\n14\t   observable; the granting plumbing is recorded in untestable.json.\n15\t\n16\tThese tests define the TDD contract; ``card_impl.py`` is a stub, so they are\n17\texpected to fail until the card is implemented.\n18\t\"\"\"\n19\t\n20\tfrom __future__ import annotations\n21\t\n22\tfrom cards.sos.sos_245.card_impl import WitherbloomTheBalancer\n23\tfrom engine.card import Creature\n24\tfrom engine.combat import _can_block, _get_lethal_damage\n25\tfrom engine.types import (\n26\t    CardType,\n27\t    Keyword,\n28\t    ManaCost,\n29\t    ManaType,\n30\t    Supertype,\n31\t    Zone,\n32\t)\n33\tfrom test_utils import create_game, set_board_state\n34\t\n35\t\n36\t# ---------------------------------------------------------------------------\n37\t# Helpers\n38\t# ---------------------------------------------------------------------------\n39\t\n40\t\n41\tdef _bear(name: str = \"Grizzly Bears\") -> Creature:\n42\t    \"\"\"A vanilla 2/2 creature with no keywords.\"\"\"\n43\t    c = Creature(name=name, base_power=2, base_toughness=2)\n44\t    c.card_types = {CardType.CREATURE}\n45\t    c.keywords = Keyword(0)\n46\t    return c\n47\t\n48\t\n49\t# ---------------------------------------------------------------------------\n50\t# Static card data\n51\t# ---------------------------------------------------------------------------\n52\t\n53\t\n54\tclass TestWitherbloomProperties:\n55\t    \"\"\"Static card data should match the SOS 245 spec.\"\"\"\n56\t\n57\t    def test_is_creature(self) -> None:\n58\t        assert isinstance(WitherbloomTheBalancer(owner=None), Creature)\n59\t        assert CardType.CREATURE in WitherbloomTheBalancer(owner=None).card_types\n60\t\n61\t    def test_name(self) -> None:\n62\t        assert WitherbloomTheBalancer(owner=None).name == \"Witherbloom, the Balancer\"\n63\t\n64\t    def test_mana_cost(self) -> None:\n65\t        assert WitherbloomTheBalancer(owner=None).mana_cost == ManaCost.parse(\"{6}{B}{G}\")\n66\t\n67\t    def test_power_toughness(self) -> None:\n68\t        card = WitherbloomTheBalancer(owner=None)\n69\t        assert card.base_power == 5\n70\t        assert card.base_toughness == 5\n71\t\n72\t    def test_is_legendary(self) -> None:\n73\t        assert Supertype.LEGENDARY in WitherbloomTheBalancer(owner=None).supertypes\n74\t\n75\t    def test_is_elder_dragon(self) -> None:\n76\t        subtypes = WitherbloomTheBalancer(owner=None).subtypes\n77\t        assert \"Dragon\" in subtypes\n78\t        assert \"Elder\" in subtypes\n79\t\n80\t\n81\t# ---------------------------------------------------------------------------\n82\t# Keywords (printed)\n83\t# ---------------------------------------------------------------------------\n84\t\n85\t\n86\tclass TestWitherbloomKeywords:\n87\t    \"\"\"Flying and Deathtouch are printed on the card.\"\"\"\n88\t\n89\t    def test_has_flying(self) -> None:\n90\t        assert Keyword.FLYING in WitherbloomTheBalancer(owner=None).keywords\n91\t\n92\t    def test_has_deathtouch(self) -> None:\n93\t        assert Keyword.DEATHTOUCH in WitherbloomTheBalancer(owner=None).keywords\n94\t\n95\t    def test_does_not_have_unrelated_keyword(self) -> None:\n96\t        # Sanity: it should not pick up keywords it doesn't have.\n97\t        assert Keyword.TRAMPLE not in WitherbloomTheBalancer(owner=None).keywords\n98\t\n99\t\n100\t# ---------------------------------------------------------------------------\n101\t# Affinity for creatures (cost reduction on its own cast)\n102\t# ---------------------------------------------------------------------------\n103\t\n104\t\n105\tclass TestWitherbloomAffinity:\n106\t    \"\"\"cost_reduction reduces generic mana by 1 per creature you control.\"\"\"\n107\t\n108\t    def test_no_creatures_no_reduction(self) -> None:\n109\t        game = create_game()\n110\t        p1 = game.players[0]\n111\t        card = WitherbloomTheBalancer(owner=p1, controller=p1)\n112\t        assert card.cost_reduction(game) == 0\n113\t\n114\t    def test_reduction_equals_creature_count(self) -> None:\n115\t        game = create_game()\n116\t        p1 = game.players[0]\n117\t        set_board_state(game, 0, battlefield=[_bear(\"A\"), _bear(\"B\"), _bear(\"C\")])\n118\t        card = WitherbloomTheBalancer(owner=p1, controller=p1)\n119\t        assert card.cost_reduction(game) == 3\n120\t\n121\t    def test_self_counts_when_on_battlefield_does_not_inflate(self) -> None:\n122\t        \"\"\"Reduction counts creatures the controller controls; with exactly\n123\t        two other creatures the reduction is 2.\"\"\"\n124\t        game = create_game()\n125\t        p1 = game.players[0]\n126\t        set_board_state(game, 0, battlefield=[_bear(\"A\"), _bear(\"B\")])\n127\t        card = WitherbloomTheBalancer(owner=p1, controller=p1)\n128\t        assert card.cost_reduction(game) == 2\n129\t\n130\t    def test_only_counts_creatures(self) -> None:\n131\t        \"\"\"Non-creature permanents do not contribute to affinity for creatures.\"\"\"\n132\t        from engine.card import Artifact, Enchantment\n133\t\n134\t        game = create_game()\n135\t        p1 = game.players[0]\n136\t        artifact = Artifact(name=\"Mind Stone\")\n137\t        enchantment = Enchantment(name=\"Random Aura\")\n138\t        set_board_state(game, 0, battlefield=[_bear(\"A\"), artifact, enchantment])\n139\t        card = WitherbloomTheBalancer(owner=p1, controller=p1)\n140\t        assert card.cost_reduction(game) == 1\n141\t\n142\t    def test_only_counts_your_creatures(self) -> None:\n143\t        \"\"\"Opponent's creatures do not reduce the cost.\"\"\"\n144\t        game = create_game()\n145\t        p1 = game.players[0]\n146\t        set_board_state(game, 0, battlefield=[_bear(\"Mine A\"), _bear(\"Mine B\")])\n147\t        set_board_state(game, 1, battlefield=[_bear(\"Theirs A\"), _bear(\"Theirs B\"),\n148\t                                              _bear(\"Theirs C\")])\n149\t        card = WitherbloomTheBalancer(owner=p1, controller=p1)\n150\t        assert card.cost_reduction(game) == 2\n151\t\n152\t    def test_reduction_clamped_to_generic_via_pipeline(self) -> None:\n153\t        \"\"\"Even with many creatures, only the {6} generic is reducible — the\n154\t        {B}{G} pips remain. get_cost_reduction clamps the raw value to 6.\"\"\"\n155\t        from engine.casting import get_cost_reduction\n156\t\n157\t        game = create_game()\n158\t        p1 = game.players[0]\n159\t        set_board_state(game, 0, battlefield=[_bear(f\"Bear{i}\") for i in range(9)])\n160\t        card = WitherbloomTheBalancer(owner=p1, controller=p1)\n161\t        # Raw cost_reduction is 9, but clamped to the {6} generic.\n162\t        assert get_cost_reduction(game, card, p1) == 6\n163\t\n164\t\n165\t# ---------------------------------------------------------------------------\n166\t# Casting with affinity (integration through the cast pipeline)\n167\t# ---------------------------------------------------------------------------\n168\t\n169\t\n170\tclass TestWitherbloomCastingWithAffinity:\n171\t    \"\"\"The reduced cost is what the cast pipeline charges.\"\"\"\n172\t\n173\t    def test_cast_with_three_creatures_pays_reduced_generic(self) -> None:\n174\t        \"\"\"With 3 creatures, {6}{B}{G} → {3}{B}{G}. Player with 3 generic +\n175\t        B + G casts successfully and the spell hits the stack.\"\"\"\n176\t        from engine.casting import cast_spell\n177\t\n178\t        game = create_game()\n179\t        p1 = game.players[0]\n180\t        game.active_player_index = 0\n181\t        game.priority_player_index = 0\n182\t        set_board_state(game, 0, battlefield=[_bear(\"A\"), _bear(\"B\"), _bear(\"C\")])\n183\t\n184\t        card = WitherbloomTheBalancer(owner=p1, controller=p1)\n185\t        game.get_hand(p1).add(card)\n186\t        set_board_state(\n187\t            game,\n188\t            0,\n189\t            mana={ManaType.COLORLESS: 3, ManaType.BLACK: 1, ManaType.GREEN: 1},\n190\t        )\n191\t\n192\t        cast_spell(game, p1, card)\n193\t        assert not game.stack.is_empty()\n194\t\n195\t    def test_cast_without_enough_mana_for_reduced_cost_fails(self) -> None:\n196\t        \"\"\"With only 1 creature the reduction is just 1; {5}{B}{G} cannot be\n197\t        paid with {3}{B}{G} worth of mana.\"\"\"\n198\t        import pytest\n199\t        from engine.casting import cast_spell, CastingError\n200\t\n201\t        game = create_game()\n202\t        p1 = game.players[0]\n203\t        game.active_player_index = 0\n204\t        game.priority_player_index = 0\n205\t        set_board_state(game, 0, battlefield=[_bear(\"A\")])\n206\t\n207\t        card = WitherbloomTheBalancer(owner=p1, controller=p1)\n208\t        game.get_hand(p1).add(card)\n209\t        set_board_state(\n210\t            game,\n211\t            0,\n212\t            mana={ManaType.COLORLESS: 3, ManaType.BLACK: 1, ManaType.GREEN: 1},\n213\t        )\n214\t\n215\t        with pytest.raises(CastingError):\n216\t            cast_spell(game, p1, card)\n217\t\n218\t    def test_colored_pips_never_reduced(self) -> None:\n219\t        \"\"\"Affinity cannot pay the {B}{G}: with 8 creatures and only colorless\n220\t        mana, the cast fails because the colored pips remain unpaid.\"\"\"\n221\t        import pytest\n222\t        from engine.casting import cast_spell, CastingError\n223\t\n224\t        game = create_game()\n225\t        p1 = game.players[0]\n226\t        game.active_player_index = 0\n227\t        game.priority_player_index = 0\n228\t        set_board_state(game, 0, battlefield=[_bear(f\"B{i}\") for i in range(8)])\n229\t\n230\t        card = WitherbloomTheBalancer(owner=p1, controller=p1)\n231\t        game.get_hand(p1).add(card)\n232\t        # Plenty of colorless, but no black/green for the pips.\n233\t        set_board_state(game, 0, mana={ManaType.COLORLESS: 10})\n234\t\n235\t        with pytest.raises(CastingError):\n236\t            cast_spell(game, p1, card)\n237\t\n238\t\n239\t# ---------------------------------------------------------------------------\n240\t# Flying — combat blocking restriction\n241\t# ---------------------------------------------------------------------------\n242\t\n243\t\n244\tclass TestWitherbloomFlying:\n245\t    \"\"\"Flying restricts which creatures can legally block this attacker.\"\"\"\n246\t\n247\t    def test_ground_creature_cannot_block(self) -> None:\n248\t        attacker = WitherbloomTheBalancer(owner=None)\n249\t        blocker = _bear(\"Ground\")\n250\t        assert _can_block(blocker, attacker) is False\n251\t\n252\t    def test_flying_blocker_can_block(self) -> None:\n253\t        attacker = WitherbloomTheBalancer(owner=None)\n254\t        blocker = _bear(\"Air\")\n255\t        blocker.keywords = Keyword.FLYING\n256\t        assert _can_block(blocker, attacker) is True\n257\t\n258\t    def test_reach_blocker_can_block(self) -> None:\n259\t        attacker = WitherbloomTheBalancer(owner=None)\n260\t        blocker = _bear(\"Spider\")\n261\t        blocker.keywords = Keyword.REACH\n262\t        assert _can_block(blocker, attacker) is True\n263\t\n264\t\n265\t# ---------------------------------------------------------------------------\n266\t# Deathtouch — lethal damage\n267\t# ---------------------------------------------------------------------------\n268\t\n269\t\n270\tclass TestWitherbloomDeathtouch:\n271\t    \"\"\"Deathtouch makes any nonzero damage from Witherbloom lethal.\"\"\"\n272\t\n273\t    def test_one_damage_is_lethal_against_high_toughness(self) -> None:\n274\t        attacker = WitherbloomTheBalancer(owner=None)\n275\t        big = _bear(\"Big Wall\")\n276\t        big.modified_toughness = 10\n277\t        # With deathtouch, only 1 damage is needed to be lethal.\n278\t        assert _get_lethal_damage(big, attacker) == 1\n279\t\n280\t    def test_without_deathtouch_lethal_is_toughness(self) -> None:\n281\t        \"\"\"Control: a non-deathtouch attacker needs full toughness in damage.\"\"\"\n282\t        plain = _bear(\"Plain\")\n283\t        big = _bear(\"Big Wall\")\n284\t        big.modified_toughness = 10\n285\t        assert _get_lethal_damage(big, plain) == 10\n286\t\n287\t\n288\t# ---------------------------------------------------------------------------\n289\t# Granted affinity to instants/sorceries (best-effort observable contract)\n290\t# ---------------------------------------------------------------------------\n291\t\n292\t\n293\tclass TestWitherbloomGrantsAffinity:\n294\t    \"\"\"\"Instant and sorcery spells you cast have affinity for creatures.\"\n295\t\n296\t    The engine has no central cost-reduction registry (see FDN 159), so the\n297\t    grant is exercised here only at the level the engine can observe:\n298\t    register_triggers/register_replacement_effects must not raise, and any\n299\t    marker the card sets must reference its controller. The actual cost\n300\t    reduction of *other* spells is recorded in untestable.json.\n301\t    \"\"\"\n302\t\n303\t    def test_register_triggers_does_not_raise(self) -> None:\n304\t        game = create_game()\n305\t        p1 = game.players[0]\n306\t        card = WitherbloomTheBalancer(owner=p1, controller=p1)\n307\t        # Must not raise when wiring up the granted-affinity machinery.\n308\t        card.register_triggers(game)\n309\t\n310\t    def test_card_advertises_no_spell_targets(self) -> None:\n311\t        \"\"\"Witherbloom is a vanilla-cast permanent (its abilities are static),\n312\t        so get_targets must be empty — casting it must not demand a target.\"\"\"\n313\t        game = create_game()\n314\t        p1 = game.players[0]\n315\t        card = WitherbloomTheBalancer(owner=p1, controller=p1)\n316\t        assert card.get_targets(game) == []\n317\t"}]},"parent_tool_use_id":"toolu_01Y8yGfyN1K4izYt6a4vpeSv","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"96cd743c-e939-44d3-9802-23457bf3db82","timestamp":"2026-06-01T09:58:46.667Z","subagent_type":"Implementer","task_description":"Implement sos_245"}
