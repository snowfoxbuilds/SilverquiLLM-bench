{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0195A9CEhofgRHKPi5Qrw8DR","type":"tool_result","content":"1\t\"\"\"Card implementation for The Dawning Archaic (SOS 1).\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.types import CardType, Keyword, ManaCost, Supertype, TargetRequirement, Zone\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t\n13\t\n14\tdef _is_instant_or_sorcery(card: Any) -> bool:\n15\t    \"\"\"Return ``True`` if *card* is an instant or sorcery card.\"\"\"\n16\t    types = getattr(card, \"card_types\", set())\n17\t    return CardType.INSTANT in types or CardType.SORCERY in types\n18\t\n19\t\n20\tclass TheDawningArchaic(Creature):\n21\t    \"\"\"The Dawning Archaic — {10} — 7/7 — Legendary Creature — Avatar.\n22\t\n23\t    - This spell costs {1} less to cast for each instant and sorcery card in\n24\t      your graveyard.\n25\t    - Reach.\n26\t    - Whenever The Dawning Archaic attacks, you may cast target instant or\n27\t      sorcery card from your graveyard without paying its mana cost. If that\n28\t      spell would be put into your graveyard, exile it instead.\n29\t\n30\t    SOS collector number 1.\n31\t    \"\"\"\n32\t\n33\t    def __init__(self, **kwargs: Any) -> None:\n34\t        kwargs.setdefault(\"name\", \"The Dawning Archaic\")\n35\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{10}\"))\n36\t        kwargs.setdefault(\"subtypes\", {\"Avatar\"})\n37\t        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n38\t        kwargs.setdefault(\"keywords\", Keyword.REACH)\n39\t        kwargs.setdefault(\"base_power\", 7)\n40\t        kwargs.setdefault(\"base_toughness\", 7)\n41\t        kwargs.setdefault(\n42\t            \"rules_text\",\n43\t            \"This spell costs {1} less to cast for each instant and sorcery \"\n44\t            \"card in your graveyard.\\nReach\\nWhenever The Dawning Archaic \"\n45\t            \"attacks, you may cast target instant or sorcery card from your \"\n46\t            \"graveyard without paying its mana cost. If that spell would be \"\n47\t            \"put into your graveyard, exile it instead.\",\n48\t        )\n49\t        super().__init__(**kwargs)\n50\t\n51\t    # ------------------------------------------------------------------\n52\t    # Cost reduction\n53\t    # ------------------------------------------------------------------\n54\t\n55\t    def cost_reduction(self, game: \"GameState\") -> int:\n56\t        \"\"\"Reduce generic mana by 1 for each instant/sorcery in your graveyard.\"\"\"\n57\t        controller = getattr(self, \"controller\", None) or getattr(self, \"owner\", None)\n58\t        if controller is None:\n59\t            return 0\n60\t        graveyard = game.get_graveyard(controller)\n61\t        return sum(1 for card in graveyard.get_all() if _is_instant_or_sorcery(card))\n62\t\n63\t    # ------------------------------------------------------------------\n64\t    # Targeting (for the attack trigger)\n65\t    # ------------------------------------------------------------------\n66\t\n67\t    def _graveyard_target_requirement(self) -> \"TargetRequirement\":\n68\t        \"\"\"Build the attack trigger's graveyard instant/sorcery requirement.\"\"\"\n69\t        return TargetRequirement(\n70\t            filter_fn=_is_instant_or_sorcery,\n71\t            description=\"target instant or sorcery card in your graveyard\",\n72\t            zone=Zone.GRAVEYARD,\n73\t        )\n74\t\n75\t    def _is_being_cast_as_creature(self, game: \"GameState\") -> bool:\n76\t        \"\"\"Return ``True`` while this card sits in a STACK zone.\n77\t\n78\t        The casting pipeline (``cast_spell`` / ``cast_spell_free``) moves the\n79\t        card into the player's STACK zone *before* it queries ``get_targets``.\n80\t        The Dawning Archaic's only targeting belongs to its attack trigger, not\n81\t        to the creature spell itself, so while the creature spell is on the\n82\t        stack we must advertise *no* targets — otherwise the cast pipeline would\n83\t        wrongly force a graveyard instant/sorcery target (and could raise\n84\t        ``CastingError`` on an empty graveyard).\n85\t        \"\"\"\n86\t        for player in getattr(game, \"players\", []) or []:\n87\t            try:\n88\t                stack_zone = player.zones[Zone.STACK]\n89\t            except (KeyError, AttributeError):\n90\t                continue\n91\t            if stack_zone.contains(self):\n92\t                return True\n93\t        return False\n94\t\n95\t    def get_targets(self, game: \"GameState\") -> list[Any]:\n96\t        \"\"\"Targets for this object.\n97\t\n98\t        The creature spell itself has no targets. The graveyard instant/sorcery\n99\t        requirement belongs to the attack trigger only; it is advertised here so\n100\t        the trigger's free-cast can reuse the standard targeting machinery, but\n101\t        it is suppressed while the creature spell is being cast (i.e. while this\n102\t        card is in the STACK zone).\n103\t        \"\"\"\n104\t        if self._is_being_cast_as_creature(game):\n105\t            return []\n106\t        return [self._graveyard_target_requirement()]\n107\t\n108\t    # ------------------------------------------------------------------\n109\t    # Attack trigger\n110\t    # ------------------------------------------------------------------\n111\t\n112\t    def register_triggers(self, game: \"GameState\") -> None:\n113\t        \"\"\"Register the attack trigger that free-casts from the graveyard.\"\"\"\n114\t        from engine.events import AttacksTriggeredEvent\n115\t        from engine.triggers import TriggerRegistration\n116\t\n117\t        source = self\n118\t        controller = getattr(self, \"controller\", None) or game.active_player\n119\t\n120\t        def _condition(game: Any, event: Any) -> bool:\n121\t            return getattr(event, \"creature\", None) is source\n122\t\n123\t        def _effect(game: \"GameState\") -> None:\n124\t            source._free_cast_from_graveyard(game)\n125\t\n126\t        game.trigger_manager.register(\n127\t            TriggerRegistration(\n128\t                event_type=AttacksTriggeredEvent,\n129\t                condition=_condition,\n130\t                effect=_effect,\n131\t                source=self,\n132\t                controller=controller,\n133\t            )\n134\t        )\n135\t\n136\t    def _free_cast_from_graveyard(self, game: \"GameState\") -> None:\n137\t        \"\"\"Cast the chosen instant/sorcery from the graveyard for free.\n138\t\n139\t        The \"may\" is modeled by whether a legal target is available/chosen: with\n140\t        no legal target the ability does nothing. The spell, if it would be put\n141\t        into the graveyard after resolving, is exiled instead.\n142\t\n143\t        Target selection precedence:\n144\t\n145\t        1. If ``chosen_targets`` was pre-populated (e.g. by arbitrated tests),\n146\t           use the first legal instant/sorcery there.\n147\t        2. Otherwise actively ask the controller to choose one of the legal\n148\t           graveyard instant/sorcery cards (live play), so the ability is not a\n149\t           no-op outside of the test harness.\n150\t        \"\"\"\n151\t        from engine.casting import cast_spell_free\n152\t\n153\t        controller = getattr(self, \"controller\", None) or getattr(self, \"owner\", None)\n154\t        if controller is None:\n155\t            return\n156\t\n157\t        graveyard = game.get_graveyard(controller)\n158\t        legal = [c for c in graveyard.get_all() if _is_instant_or_sorcery(c)]\n159\t        if not legal:\n160\t            return\n161\t\n162\t        target = self._select_free_cast_target(controller, legal)\n163\t        if target is None or not graveyard.contains(target):\n164\t            return\n165\t\n166\t        cast_spell_free(game, controller, target, Zone.GRAVEYARD)\n167\t\n168\t        # Capture the spell's stack object directly by matching its source,\n169\t        # rather than assuming it is the very top of the stack.\n170\t        stack_obj = None\n171\t        for obj in game.stack.objects():\n172\t            if getattr(obj, \"source\", None) is target:\n173\t                stack_obj = obj\n174\t                break\n175\t        if stack_obj is None:\n176\t            return\n177\t\n178\t        # Redirect the spell's post-resolution move from graveyard to exile.\n179\t        original_resolve = stack_obj.on_resolve\n180\t\n181\t        def _resolve_then_exile(g: \"GameState\") -> None:\n182\t            gy = g.get_graveyard(controller)\n183\t            original_resolve(g)\n184\t            # If resolution put the spell into the graveyard, exile it.\n185\t            if gy.contains(target):\n186\t                from engine.game import exile as _exile\n187\t\n188\t                _exile(g, target)\n189\t\n190\t        stack_obj.on_resolve = _resolve_then_exile\n191\t\n192\t    def _select_free_cast_target(self, controller: Any, legal: list[Any]) -> Any:\n193\t        \"\"\"Pick the instant/sorcery to free-cast.\n194\t\n195\t        Honour a pre-set ``chosen_targets`` first (tests / arbitration). If none\n196\t        is set, ask the controller to choose among the legal options so the\n197\t        ability works in live play. Returns ``None`` if the player declines or\n198\t        no legal choice is made (the trigger is a \"may\").\n199\t        \"\"\"\n200\t        chosen = getattr(self, \"chosen_targets\", None)\n201\t        if chosen:\n202\t            for candidate in chosen:\n203\t                if candidate is not None and _is_instant_or_sorcery(candidate):\n204\t                    return candidate\n205\t            return None\n206\t\n207\t        requirement = self._graveyard_target_requirement()\n208\t        choose_target = getattr(controller, \"choose_target\", None)\n209\t        if choose_target is None:\n210\t            return None\n211\t        try:\n212\t            selection = choose_target(legal, requirement)\n213\t        except Exception:\n214\t            return None\n215\t        if selection is not None and _is_instant_or_sorcery(selection):\n216\t            return selection\n217\t        return None\n218\t"}]},"parent_tool_use_id":"toolu_01SJbUvcnfTXvMNc9n6DiuY5","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"4511c565-5542-4205-ab20-6ee53f986eab","timestamp":"2026-06-01T08:55:53.260Z","subagent_type":"Tester","task_description":"Write tests for sos_57"}
