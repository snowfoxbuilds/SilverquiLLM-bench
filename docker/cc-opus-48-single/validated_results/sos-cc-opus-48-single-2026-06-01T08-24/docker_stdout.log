{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014K3SuT3fXPn3W6G9iB61GQ","type":"tool_result","content":"1\t\"\"\"Tests for SOS 201 — Lorehold, the Historian.\n2\t\n3\tLorehold, the Historian is a {3}{R}{W} Legendary Creature — Elder Dragon,\n4\t5/5, with:\n5\t\n6\t1. **Flying, haste** — evergreen keywords (both in ``engine.types.Keyword``).\n7\t2. **Miracle granting** — \"Each instant and sorcery card in your hand has\n8\t   miracle {2}.\" Miracle is NOT in the ``Keyword`` enum (and per KEY_DECISIONS\n9\t   we must not extend that enum), so the card models it as a custom mechanic.\n10\t   The tests here exercise the *granting contract*: a queryable miracle cost of\n11\t   {2} for instants/sorceries in the controller's hand, and no miracle for\n12\t   non-instant/non-sorcery cards or for cards outside the controller's hand.\n13\t   The \"cast it when you draw it, if it's the first card you drew this turn\"\n14\t   timing has no engine surface and is recorded in ``untestable.json``.\n15\t3. **Opponent-upkeep loot trigger** — \"At the beginning of each opponent's\n16\t   upkeep, you may discard a card. If you do, draw a card.\" Modeled via\n17\t   ``register_triggers`` watching ``BeginningOfUpkeepTriggeredEvent`` with a\n18\t   condition that fires only when an opponent is the active player.\n19\t\n20\tThese tests define the TDD contract; ``card_impl.py`` is a stub, so they are\n21\texpected to fail until the card is implemented.\n22\t\"\"\"\n23\t\n24\tfrom __future__ import annotations\n25\t\n26\tfrom typing import Any\n27\t\n28\tfrom cards.sos.sos_201.card_impl import LoreholdTheHistorian\n29\tfrom engine.card import Creature, Instant, Sorcery\n30\tfrom engine.events import BeginningOfUpkeepTriggeredEvent\n31\tfrom engine.triggers import TriggerRegistration\n32\tfrom engine.types import CardType, Keyword, ManaCost, Supertype, Zone\n33\tfrom test_utils import create_game, set_board_state\n34\t\n35\t\n36\t# ---------------------------------------------------------------------------\n37\t# Helpers\n38\t# ---------------------------------------------------------------------------\n39\t\n40\t\n41\tdef _instant(name: str = \"Test Instant\") -> Instant:\n42\t    return Instant(name=name, mana_cost=ManaCost.parse(\"{1}{U}\"))\n43\t\n44\t\n45\tdef _sorcery(name: str = \"Test Sorcery\") -> Sorcery:\n46\t    return Sorcery(name=name, mana_cost=ManaCost.parse(\"{2}{R}\"))\n47\t\n48\t\n49\tdef _vanilla_creature(name: str = \"Grizzly Bears\") -> Creature:\n50\t    c = Creature(name=name, base_power=2, base_toughness=2)\n51\t    c.card_types = {CardType.CREATURE}\n52\t    return c\n53\t\n54\t\n55\tdef _filler_hand_card(name: str = \"Spare Card\") -> Sorcery:\n56\t    \"\"\"A discardable card so the loot trigger always has something to pitch.\"\"\"\n57\t    return Sorcery(name=name, mana_cost=ManaCost.parse(\"{1}\"))\n58\t\n59\t\n60\tdef _miracle_cost(card_obj: LoreholdTheHistorian, game: Any, target: Any) -> Any:\n61\t    \"\"\"Query Lorehold's granted miracle cost for *target*.\n62\t\n63\t    The implementation may expose this contract under any of a few reasonable\n64\t    names; this helper probes them so the tests stay decoupled from the exact\n65\t    method spelling while still asserting the {2} miracle grant.\n66\t    \"\"\"\n67\t    for attr in (\"get_miracle_cost\", \"miracle_cost_for\", \"granted_miracle_cost\"):\n68\t        fn = getattr(card_obj, attr, None)\n69\t        if callable(fn):\n70\t            return fn(game, target)\n71\t    raise AssertionError(\n72\t        \"Lorehold must expose a miracle-cost query \"\n73\t        \"(get_miracle_cost/miracle_cost_for/granted_miracle_cost)\"\n74\t    )\n75\t\n76\t\n77\t# ---------------------------------------------------------------------------\n78\t# Static card data\n79\t# ---------------------------------------------------------------------------\n80\t\n81\t\n82\tclass TestLoreholdProperties:\n83\t    \"\"\"Static card data should match the SOS 201 spec.\"\"\"\n84\t\n85\t    def test_is_creature(self) -> None:\n86\t        assert isinstance(LoreholdTheHistorian(owner=None), Creature)\n87\t\n88\t    def test_name(self) -> None:\n89\t        assert LoreholdTheHistorian(owner=None).name == \"Lorehold, the Historian\"\n90\t\n91\t    def test_mana_cost(self) -> None:\n92\t        assert LoreholdTheHistorian(owner=None).mana_cost == ManaCost.parse(\"{3}{R}{W}\")\n93\t\n94\t    def test_power_toughness(self) -> None:\n95\t        card = LoreholdTheHistorian(owner=None)\n96\t        assert card.base_power == 5\n97\t        assert card.base_toughness == 5\n98\t\n99\t    def test_is_legendary(self) -> None:\n100\t        assert Supertype.LEGENDARY in LoreholdTheHistorian(owner=None).supertypes\n101\t\n102\t    def test_is_elder_dragon(self) -> None:\n103\t        subtypes = LoreholdTheHistorian(owner=None).subtypes\n104\t        assert \"Elder\" in subtypes\n105\t        assert \"Dragon\" in subtypes\n106\t\n107\t    def test_has_flying(self) -> None:\n108\t        assert Keyword.FLYING in LoreholdTheHistorian(owner=None).keywords\n109\t\n110\t    def test_has_haste(self) -> None:\n111\t        assert Keyword.HASTE in LoreholdTheHistorian(owner=None).keywords\n112\t\n113\t    def test_is_red_white(self) -> None:\n114\t        \"\"\"Cost {3}{R}{W} — the card has both a red and a white pip.\"\"\"\n115\t        pips = LoreholdTheHistorian(owner=None).mana_cost.pips\n116\t        from engine.types import ManaType\n117\t\n118\t        assert pips.get(ManaType.RED, 0) >= 1\n119\t        assert pips.get(ManaType.WHITE, 0) >= 1\n120\t\n121\t\n122\t# ---------------------------------------------------------------------------\n123\t# Miracle granting\n124\t# ---------------------------------------------------------------------------\n125\t\n126\t\n127\tclass TestLoreholdMiracleGrant:\n128\t    \"\"\"Each instant and sorcery card in your hand has miracle {2}.\"\"\"\n129\t\n130\t    def test_instant_in_your_hand_gets_miracle_two(self) -> None:\n131\t        game = create_game()\n132\t        p1 = game.players[0]\n133\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n134\t        spell = _instant(\"Lightning Helix\")\n135\t        set_board_state(game, 0, battlefield=[lorehold], hand=[spell])\n136\t        cost = _miracle_cost(lorehold, game, spell)\n137\t        assert cost == ManaCost.parse(\"{2}\")\n138\t\n139\t    def test_sorcery_in_your_hand_gets_miracle_two(self) -> None:\n140\t        game = create_game()\n141\t        p1 = game.players[0]\n142\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n143\t        spell = _sorcery(\"Reconstruct History\")\n144\t        set_board_state(game, 0, battlefield=[lorehold], hand=[spell])\n145\t        cost = _miracle_cost(lorehold, game, spell)\n146\t        assert cost == ManaCost.parse(\"{2}\")\n147\t\n148\t    def test_creature_in_your_hand_gets_no_miracle(self) -> None:\n149\t        \"\"\"Miracle is granted only to instants and sorceries.\"\"\"\n150\t        game = create_game()\n151\t        p1 = game.players[0]\n152\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n153\t        creature = _vanilla_creature(\"Hill Giant\")\n154\t        set_board_state(game, 0, battlefield=[lorehold], hand=[creature])\n155\t        assert _miracle_cost(lorehold, game, creature) is None\n156\t\n157\t    def test_opponent_hand_spell_gets_no_miracle(self) -> None:\n158\t        \"\"\"The grant is restricted to cards in YOUR hand only.\"\"\"\n159\t        game = create_game()\n160\t        p1 = game.players[0]\n161\t        p2 = game.players[1]\n162\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n163\t        opp_spell = _instant(\"Opponent Bolt\")\n164\t        set_board_state(game, 0, battlefield=[lorehold])\n165\t        set_board_state(game, 1, hand=[opp_spell])\n166\t        assert _miracle_cost(lorehold, game, opp_spell) is None\n167\t\n168\t    def test_spell_in_graveyard_gets_no_miracle(self) -> None:\n169\t        \"\"\"Only cards in hand are granted miracle, not other zones.\"\"\"\n170\t        game = create_game()\n171\t        p1 = game.players[0]\n172\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n173\t        gy_spell = _instant(\"Graveyard Bolt\")\n174\t        set_board_state(game, 0, battlefield=[lorehold], graveyard=[gy_spell])\n175\t        assert _miracle_cost(lorehold, game, gy_spell) is None\n176\t\n177\t\n178\t# ---------------------------------------------------------------------------\n179\t# Opponent-upkeep loot trigger — registration\n180\t# ---------------------------------------------------------------------------\n181\t\n182\t\n183\tclass TestLoreholdLootTriggerRegistration:\n184\t    \"\"\"register_triggers wires a BeginningOfUpkeepTriggeredEvent trigger.\"\"\"\n185\t\n186\t    def test_registers_one_upkeep_trigger(self) -> None:\n187\t        game = create_game()\n188\t        p1 = game.players[0]\n189\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n190\t        before = len(game.trigger_manager.get_triggers())\n191\t        lorehold.register_triggers(game)\n192\t        after = len(game.trigger_manager.get_triggers())\n193\t        assert after - before == 1\n194\t\n195\t    def test_registered_trigger_watches_upkeep_event(self) -> None:\n196\t        game = create_game()\n197\t        p1 = game.players[0]\n198\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n199\t        lorehold.register_triggers(game)\n200\t        regs = game.trigger_manager.get_triggers_for_source(lorehold)\n201\t        assert len(regs) == 1\n202\t        reg = regs[0]\n203\t        assert isinstance(reg, TriggerRegistration)\n204\t        assert reg.event_type is BeginningOfUpkeepTriggeredEvent\n205\t\n206\t    def test_trigger_fires_on_opponent_upkeep(self) -> None:\n207\t        \"\"\"Condition is satisfied when an opponent is the active player.\"\"\"\n208\t        game = create_game()\n209\t        p1 = game.players[0]\n210\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n211\t        set_board_state(game, 0, battlefield=[lorehold])\n212\t        lorehold.register_triggers(game)\n213\t        reg = game.trigger_manager.get_triggers_for_source(lorehold)[0]\n214\t        # Opponent (player index 1) is the active player.\n215\t        game.active_player_index = 1\n216\t        if reg.condition is None:\n217\t            return\n218\t        assert reg.condition(game, BeginningOfUpkeepTriggeredEvent()) is True\n219\t\n220\t    def test_trigger_does_not_fire_on_own_upkeep(self) -> None:\n221\t        \"\"\"\"each opponent's upkeep\" — not the controller's own upkeep.\"\"\"\n222\t        game = create_game()\n223\t        p1 = game.players[0]\n224\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n225\t        set_board_state(game, 0, battlefield=[lorehold])\n226\t        lorehold.register_triggers(game)\n227\t        reg = game.trigger_manager.get_triggers_for_source(lorehold)[0]\n228\t        # Controller (player index 0) is the active player.\n229\t        game.active_player_index = 0\n230\t        if reg.condition is None:\n231\t            # An always-fire trigger would be wrong here; force a real check.\n232\t            raise AssertionError(\n233\t                \"Loot trigger must distinguish opponent upkeep from own upkeep\"\n234\t            )\n235\t        assert reg.condition(game, BeginningOfUpkeepTriggeredEvent()) is False\n236\t\n237\t\n238\t# ---------------------------------------------------------------------------\n239\t# Opponent-upkeep loot trigger — effect\n240\t# ---------------------------------------------------------------------------\n241\t\n242\t\n243\tdef _fire_opponent_upkeep(game: Any, lorehold: LoreholdTheHistorian) -> int:\n244\t    \"\"\"Register Lorehold's triggers, fire an opponent's upkeep, and resolve.\n245\t\n246\t    Returns the number of objects that were pushed onto the stack by the\n247\t    upkeep event — so tests can assert the loot trigger actually fired (a\n248\t    stub that registers nothing pushes zero and the assertion fails).\n249\t    \"\"\"\n250\t    lorehold.register_triggers(game)\n251\t    game.active_player_index = 1  # opponent is active\n252\t    game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n253\t    pushed = len(game.stack.objects())\n254\t    while not game.stack.is_empty():\n255\t        game.stack.pop().on_resolve(game)\n256\t    return pushed\n257\t\n258\t\n259\tclass TestLoreholdLootEffect:\n260\t    \"\"\"you may discard a card; if you do, draw a card.\"\"\"\n261\t\n262\t    def test_discard_then_draw_keeps_hand_size(self) -> None:\n263\t        \"\"\"Looting one card: hand size net-zero (pitch one, draw one).\"\"\"\n264\t        game = create_game()\n265\t        p1 = game.players[0]\n266\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n267\t        pitch = _filler_hand_card(\"Pitch Me\")\n268\t        library_card = _sorcery(\"Top of Library\")\n269\t        set_board_state(game, 0, battlefield=[lorehold], hand=[pitch])\n270\t        # Seed the library so the draw has a card to find.\n271\t        p1.zones[Zone.LIBRARY].add(library_card)\n272\t        # Script: choose to discard (yes), then choose which card to pitch.\n273\t        p1._script.appendleft(pitch)\n274\t        p1._script.appendleft(True)\n275\t\n276\t        before = len(game.get_hand(p1).get_all())\n277\t        pushed = _fire_opponent_upkeep(game, lorehold)\n278\t        after = len(game.get_hand(p1).get_all())\n279\t        # The loot trigger must actually fire on the opponent's upkeep.\n280\t        assert pushed >= 1\n281\t        # Net-zero: one discarded, one drawn.\n282\t        assert after == before\n283\t        assert game.get_graveyard(p1).contains(pitch)\n284\t        assert game.get_hand(p1).contains(library_card)\n285\t\n286\t    def test_discard_card_goes_to_graveyard(self) -> None:\n287\t        \"\"\"The discarded card ends up in the controller's graveyard.\"\"\"\n288\t        game = create_game()\n289\t        p1 = game.players[0]\n290\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n291\t        pitch = _filler_hand_card(\"Pitch Me\")\n292\t        library_card = _sorcery(\"Top of Library\")\n293\t        set_board_state(game, 0, battlefield=[lorehold], hand=[pitch])\n294\t        p1.zones[Zone.LIBRARY].add(library_card)\n295\t        p1._script.appendleft(pitch)\n296\t        p1._script.appendleft(True)\n297\t\n298\t        _fire_opponent_upkeep(game, lorehold)\n299\t        assert game.get_graveyard(p1).contains(pitch)\n300\t\n301\t    def test_drawn_card_enters_hand(self) -> None:\n302\t        \"\"\"The looted draw moves the top library card into hand.\"\"\"\n303\t        game = create_game()\n304\t        p1 = game.players[0]\n305\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n306\t        pitch = _filler_hand_card(\"Pitch Me\")\n307\t        library_card = _sorcery(\"Top of Library\")\n308\t        set_board_state(game, 0, battlefield=[lorehold], hand=[pitch])\n309\t        p1.zones[Zone.LIBRARY].add(library_card)\n310\t        p1._script.appendleft(pitch)\n311\t        p1._script.appendleft(True)\n312\t\n313\t        _fire_opponent_upkeep(game, lorehold)\n314\t        assert game.get_hand(p1).contains(library_card)\n315\t        assert not p1.zones[Zone.LIBRARY].contains(library_card)\n316\t\n317\t    def test_declining_discard_draws_nothing(self) -> None:\n318\t        \"\"\"\"you may discard\" — declining means no discard and no draw.\"\"\"\n319\t        game = create_game()\n320\t        p1 = game.players[0]\n321\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n322\t        pitch = _filler_hand_card(\"Keep Me\")\n323\t        library_card = _sorcery(\"Top of Library\")\n324\t        set_board_state(game, 0, battlefield=[lorehold], hand=[pitch])\n325\t        p1.zones[Zone.LIBRARY].add(library_card)\n326\t        # Script: decline (no).\n327\t        p1._script.appendleft(False)\n328\t\n329\t        pushed = _fire_opponent_upkeep(game, lorehold)\n330\t        # The trigger must still fire on the opponent's upkeep (it is a \"may\").\n331\t        assert pushed >= 1\n332\t        # Card kept in hand, library untouched (no draw), nothing discarded.\n333\t        assert game.get_hand(p1).contains(pitch)\n334\t        assert p1.zones[Zone.LIBRARY].contains(library_card)\n335\t        assert not game.get_graveyard(p1).contains(pitch)\n336\t\n337\t    def test_empty_hand_is_a_noop(self) -> None:\n338\t        \"\"\"With no card to discard, the trigger does nothing and does not raise.\"\"\"\n339\t        game = create_game()\n340\t        p1 = game.players[0]\n341\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n342\t        library_card = _sorcery(\"Top of Library\")\n343\t        set_board_state(game, 0, battlefield=[lorehold], hand=[])\n344\t        p1.zones[Zone.LIBRARY].add(library_card)\n345\t        # Decline (or there is simply nothing to discard).\n346\t        p1._script.appendleft(False)\n347\t\n348\t        pushed = _fire_opponent_upkeep(game, lorehold)\n349\t        # The trigger still fires on the opponent's upkeep even with an empty hand.\n350\t        assert pushed >= 1\n351\t        # No discard happened and no card was drawn.\n352\t        assert p1.zones[Zone.LIBRARY].contains(library_card)\n353\t        assert len(game.get_hand(p1).get_all()) == 0\n354\t"}]},"parent_tool_use_id":"toolu_01EsetUBrXacwixHmPHKwsvR","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"e138311c-f37c-4349-9397-873fc1992059","timestamp":"2026-06-01T09:38:23.329Z","subagent_type":"Implementer","task_description":"Implement sos_201"}
