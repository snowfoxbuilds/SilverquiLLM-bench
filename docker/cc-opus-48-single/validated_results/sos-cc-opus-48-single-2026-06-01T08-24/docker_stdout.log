{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M1qSGGko5YqWqJCotVhSeT","type":"tool_result","content":"1\t\"\"\"Tests for SOS 120 — Improvisation Capstone.\n2\t\n3\tImprovisation Capstone is a ``{5}{R}{R}`` Sorcery — Lesson:\n4\t\n5\t    \"Exile cards from the top of your library until you exile cards with total\n6\t    mana value 4 or greater. You may cast any number of spells from among them\n7\t    without paying their mana costs.\n8\t    Paradigm (Then exile this spell. After you first resolve a spell with this\n9\t    name, you may cast a copy of it from exile without paying its mana cost at\n10\t    the beginning of each of your first main phases.)\"\n11\t\n12\tThese tests define the TDD contract; ``card_impl.py`` is a stub, so they are\n13\texpected to fail until the card is implemented (TDD red phase).\n14\t\n15\tCoverage notes\n16\t--------------\n17\t* **Static data** — sorcery type, name, ``{5}{R}{R}`` mana cost, red, the\n18\t  ``Lesson`` subtype.\n19\t* **Exile-until-MV-4** — ``on_resolve`` exiles cards from the top of the\n20\t  controller's library, accumulating their total mana value, and stops as soon\n21\t  as the cumulative total reaches 4 or greater. It must not over-exile, must\n22\t  stop on the exact card that crosses the threshold, and must handle a single\n23\t  high-MV card and a library too small to reach 4.\n24\t* **Free-cast among exiled cards** — spells among the exiled cards may be cast\n25\t  for free (no mana paid). At least one castable spell is exercised end to end.\n26\t\n27\tThe **Paradigm** clause is recorded in ``untestable.json``: \"Paradigm\" is not a\n28\tmember of ``engine.types.Keyword`` (the enum is frozen at 16 members and\n29\t``engine_tests/`` is authoritative), and the delayed \"cast a copy from exile at\n30\tthe beginning of each of your first main phases\" machinery has no engine surface\n31\tto assert against. The exile-this-spell sub-clause and the recurring copy-cast\n32\tare therefore left to the implementer's discretion and not contract-tested here.\n33\t\"\"\"\n34\t\n35\tfrom __future__ import annotations\n36\t\n37\tfrom typing import Any\n38\t\n39\tfrom cards.sos.sos_120.card_impl import ImprovisationCapstone\n40\tfrom engine.card import Creature, Instant, Sorcery\n41\tfrom engine.types import CardType, ManaCost, ManaType, Zone\n42\tfrom test_utils import create_game, set_board_state\n43\t\n44\t\n45\t# ---------------------------------------------------------------------------\n46\t# Helpers\n47\t# ---------------------------------------------------------------------------\n48\t\n49\t\n50\tdef _sorcery(name: str, cost: str) -> Sorcery:\n51\t    \"\"\"A vanilla sorcery with the given parsed mana cost.\"\"\"\n52\t    return Sorcery(name=name, mana_cost=ManaCost.parse(cost))\n53\t\n54\t\n55\tdef _instant(name: str, cost: str) -> Instant:\n56\t    return Instant(name=name, mana_cost=ManaCost.parse(cost))\n57\t\n58\t\n59\tdef _creature(name: str, cost: str, power: int = 1, toughness: int = 1) -> Creature:\n60\t    c = Creature(\n61\t        name=name,\n62\t        mana_cost=ManaCost.parse(cost),\n63\t        base_power=power,\n64\t        base_toughness=toughness,\n65\t    )\n66\t    return c\n67\t\n68\t\n69\tdef _set_library(game: Any, player_index: int, cards: list[Any]) -> None:\n70\t    \"\"\"Place *cards* into a player's library, top-of-library = LAST in the list.\n71\t\n72\t    The engine's :class:`ZoneContainer` treats index ``-1`` as the *top* of the\n73\t    zone (``add`` appends, ``top(n)`` returns the last n). So to make ``cards``\n74\t    read as a top-to-bottom ordering, we add them in reverse: the first element\n75\t    of *cards* ends up on top.\n76\t    \"\"\"\n77\t    player = game.players[player_index]\n78\t    library = player.zones[Zone.LIBRARY]\n79\t    for obj in library.get_all():\n80\t        library.remove(obj)\n81\t    for card in reversed(cards):\n82\t        card.owner = player\n83\t        card.controller = player\n84\t        library.add(card)\n85\t\n86\t\n87\tdef _exiled(game: Any, player: Any) -> list[Any]:\n88\t    return game.get_exile(player).get_all()\n89\t\n90\t\n91\t# ---------------------------------------------------------------------------\n92\t# Static card data\n93\t# ---------------------------------------------------------------------------\n94\t\n95\t\n96\tclass TestImprovisationCapstoneProperties:\n97\t    \"\"\"Static card data should match the SOS 120 spec.\"\"\"\n98\t\n99\t    def test_is_sorcery(self) -> None:\n100\t        assert isinstance(ImprovisationCapstone(owner=None), Sorcery)\n101\t\n102\t    def test_card_type_includes_sorcery(self) -> None:\n103\t        assert CardType.SORCERY in ImprovisationCapstone(owner=None).card_types\n104\t\n105\t    def test_name(self) -> None:\n106\t        assert ImprovisationCapstone(owner=None).name == \"Improvisation Capstone\"\n107\t\n108\t    def test_mana_cost(self) -> None:\n109\t        assert ImprovisationCapstone(owner=None).mana_cost == ManaCost.parse(\"{5}{R}{R}\")\n110\t\n111\t    def test_is_red(self) -> None:\n112\t        cost = ImprovisationCapstone(owner=None).mana_cost\n113\t        assert cost.pips.get(ManaType.RED, 0) == 2\n114\t        assert cost.generic == 5\n115\t\n116\t    def test_has_lesson_subtype(self) -> None:\n117\t        assert \"Lesson\" in ImprovisationCapstone(owner=None).subtypes\n118\t\n119\t\n120\t# ---------------------------------------------------------------------------\n121\t# Exile-from-library until total mana value >= 4\n122\t# ---------------------------------------------------------------------------\n123\t\n124\t\n125\tclass TestImprovisationCapstoneExileUntilFour:\n126\t    \"\"\"on_resolve exiles from the top of the library until the cumulative mana\n127\t    value of the exiled cards reaches 4 or greater.\"\"\"\n128\t\n129\t    def test_exiles_until_total_mv_reaches_four(self) -> None:\n130\t        \"\"\"Three 2-MV cards: exiling the first two (2+2=4) reaches the threshold\n131\t        exactly; the third stays in the library.\"\"\"\n132\t        game = create_game()\n133\t        p1 = game.players[0]\n134\t        capstone = ImprovisationCapstone(owner=p1, controller=p1)\n135\t\n136\t        top = _sorcery(\"Two A\", \"{1}{R}\")   # MV 2\n137\t        mid = _sorcery(\"Two B\", \"{1}{R}\")   # MV 2\n138\t        bottom = _sorcery(\"Two C\", \"{1}{R}\")  # MV 2\n139\t        _set_library(game, 0, [top, mid, bottom])\n140\t\n141\t        capstone.on_resolve(game)\n142\t\n143\t        exiled = _exiled(game, p1)\n144\t        assert top in exiled\n145\t        assert mid in exiled\n146\t        # Threshold reached at 4 — do not exile beyond it.\n147\t        assert bottom not in exiled\n148\t        assert game.get_library(p1).contains(bottom)\n149\t\n150\t    def test_total_mana_value_of_exiled_is_at_least_four(self) -> None:\n151\t        \"\"\"Whatever the library composition, the exiled pile sums to >= 4 once a\n152\t        sufficient total is available.\"\"\"\n153\t        game = create_game()\n154\t        p1 = game.players[0]\n155\t        capstone = ImprovisationCapstone(owner=p1, controller=p1)\n156\t\n157\t        _set_library(\n158\t            game,\n159\t            0,\n160\t            [\n161\t                _sorcery(\"One\", \"{R}\"),       # MV 1\n162\t                _sorcery(\"One Two\", \"{1}{R}\"),  # MV 2\n163\t                _sorcery(\"One Three\", \"{2}{R}\"),  # MV 3 (cumulative 6 -> stop)\n164\t                _sorcery(\"Extra\", \"{R}\"),     # MV 1\n165\t            ],\n166\t        )\n167\t\n168\t        capstone.on_resolve(game)\n169\t\n170\t        total = sum(c.mana_cost.cmc for c in _exiled(game, p1))\n171\t        assert total >= 4\n172\t\n173\t    def test_stops_on_card_that_crosses_threshold(self) -> None:\n174\t        \"\"\"1 + 1 + 3 = 5 crosses 4 on the third card. Exactly three cards are\n175\t        exiled; the fourth remains.\"\"\"\n176\t        game = create_game()\n177\t        p1 = game.players[0]\n178\t        capstone = ImprovisationCapstone(owner=p1, controller=p1)\n179\t\n180\t        a = _sorcery(\"One A\", \"{R}\")        # MV 1 (cum 1)\n181\t        b = _sorcery(\"One B\", \"{R}\")        # MV 1 (cum 2)\n182\t        c = _sorcery(\"Three C\", \"{2}{R}\")   # MV 3 (cum 5 -> stop)\n183\t        d = _sorcery(\"One D\", \"{R}\")        # MV 1 (untouched)\n184\t        _set_library(game, 0, [a, b, c, d])\n185\t\n186\t        capstone.on_resolve(game)\n187\t\n188\t        exiled = _exiled(game, p1)\n189\t        assert a in exiled and b in exiled and c in exiled\n190\t        assert d not in exiled\n191\t        assert game.get_library(p1).contains(d)\n192\t\n193\t    def test_single_high_mv_card_stops_immediately(self) -> None:\n194\t        \"\"\"A single MV-4 card on top satisfies the threshold by itself; only it\n195\t        is exiled.\"\"\"\n196\t        game = create_game()\n197\t        p1 = game.players[0]\n198\t        capstone = ImprovisationCapstone(owner=p1, controller=p1)\n199\t\n200\t        big = _sorcery(\"Big\", \"{3}{R}\")     # MV 4\n201\t        rest = _sorcery(\"Rest\", \"{R}\")      # MV 1\n202\t        _set_library(game, 0, [big, rest])\n203\t\n204\t        capstone.on_resolve(game)\n205\t\n206\t        exiled = _exiled(game, p1)\n207\t        assert big in exiled\n208\t        assert rest not in exiled\n209\t\n210\t    def test_exiles_from_top_of_library(self) -> None:\n211\t        \"\"\"Cards are taken from the TOP of the library, not the bottom.\"\"\"\n212\t        game = create_game()\n213\t        p1 = game.players[0]\n214\t        capstone = ImprovisationCapstone(owner=p1, controller=p1)\n215\t\n216\t        top = _sorcery(\"Top\", \"{3}{R}\")     # MV 4 (top of library)\n217\t        bottom = _sorcery(\"Bottom\", \"{R}\")  # MV 1 (bottom of library)\n218\t        _set_library(game, 0, [top, bottom])\n219\t\n220\t        capstone.on_resolve(game)\n221\t\n222\t        exiled = _exiled(game, p1)\n223\t        assert top in exiled\n224\t        assert bottom not in exiled\n225\t\n226\t    def test_small_library_exiles_everything_without_raising(self) -> None:\n227\t        \"\"\"If the library can never reach total MV 4, every card is exiled and\n228\t        resolution does not raise.\"\"\"\n229\t        game = create_game()\n230\t        p1 = game.players[0]\n231\t        capstone = ImprovisationCapstone(owner=p1, controller=p1)\n232\t\n233\t        a = _sorcery(\"Lo A\", \"{R}\")  # MV 1\n234\t        b = _sorcery(\"Lo B\", \"{R}\")  # MV 1\n235\t        _set_library(game, 0, [a, b])\n236\t\n237\t        capstone.on_resolve(game)\n238\t\n239\t        exiled = _exiled(game, p1)\n240\t        assert a in exiled and b in exiled\n241\t        assert len(game.get_library(p1)) == 0\n242\t\n243\t    def test_empty_library_is_a_noop(self) -> None:\n244\t        \"\"\"An empty library exiles nothing and does not raise.\"\"\"\n245\t        game = create_game()\n246\t        p1 = game.players[0]\n247\t        capstone = ImprovisationCapstone(owner=p1, controller=p1)\n248\t        _set_library(game, 0, [])\n249\t\n250\t        capstone.on_resolve(game)\n251\t\n252\t        assert len(_exiled(game, p1)) == 0\n253\t\n254\t    def test_uses_controllers_library_not_opponents(self) -> None:\n255\t        \"\"\"\"Your library\" is the controller's library; the opponent's library\n256\t        is never touched.\"\"\"\n257\t        game = create_game()\n258\t        p1 = game.players[0]\n259\t        p2 = game.players[1]\n260\t        capstone = ImprovisationCapstone(owner=p1, controller=p1)\n261\t\n262\t        mine = _sorcery(\"Mine\", \"{3}{R}\")    # MV 4\n263\t        theirs = _sorcery(\"Theirs\", \"{3}{R}\")  # MV 4\n264\t        _set_library(game, 0, [mine])\n265\t        _set_library(game, 1, [theirs])\n266\t\n267\t        capstone.on_resolve(game)\n268\t\n269\t        assert mine in _exiled(game, p1)\n270\t        # Opponent's library and exile are untouched.\n271\t        assert game.get_library(p2).contains(theirs)\n272\t        assert theirs not in _exiled(game, p2)\n273\t        assert theirs not in _exiled(game, p1)\n274\t\n275\t\n276\t# ---------------------------------------------------------------------------\n277\t# Free-cast among the exiled cards\n278\t# ---------------------------------------------------------------------------\n279\t\n280\t\n281\tclass TestImprovisationCapstoneFreeCast:\n282\t    \"\"\"\"You may cast any number of spells from among them without paying their\n283\t    mana costs.\" The exiled spells may be cast for free.\"\"\"\n284\t\n285\t    def test_castable_spell_among_exiles_can_be_cast_for_free(self) -> None:\n286\t        \"\"\"An exiled instant/sorcery is cast without the controller spending any\n287\t        mana — it leaves exile and ends up resolved (in the graveyard).\"\"\"\n288\t        game = create_game()\n289\t        p1 = game.players[0]\n290\t        capstone = ImprovisationCapstone(owner=p1, controller=p1)\n291\t\n292\t        # Controller has no mana at all; a free cast must still go through.\n293\t        set_board_state(game, 0, mana={})\n294\t\n295\t        spell = _sorcery(\"Free Bolt\", \"{2}{R}\")  # MV 3\n296\t        topper = _sorcery(\"Topper\", \"{R}\")       # MV 1 (cum 4 -> stop)\n297\t        _set_library(game, 0, [spell, topper])\n298\t\n299\t        # The \"may\" cast is exercised by scripting a yes/choice for the spell.\n300\t        p1._script.appendleft(spell)\n301\t        p1._script.appendleft(True)\n302\t\n303\t        capstone.on_resolve(game)\n304\t        # Resolve anything the free cast pushed onto the stack.\n305\t        from engine.state_based_actions import resolve_state_based_actions\n306\t\n307\t        while not game.stack.is_empty():\n308\t            obj = game.stack.pop()\n309\t            obj.on_resolve(game)\n310\t            resolve_state_based_actions(game)\n311\t\n312\t        # The spell was exiled off the top of the library, then free-cast: it\n313\t        # is no longer in the library, no longer in exile, and (having resolved)\n314\t        # is now in the graveyard — all without the controller paying any mana.\n315\t        assert not game.get_library(p1).contains(spell)\n316\t        assert spell not in _exiled(game, p1)\n317\t        assert game.get_graveyard(p1).contains(spell)\n318\t        assert p1.mana_pool.get(ManaType.RED) == 0\n319\t\n320\t    def test_resolution_does_not_raise_when_no_spells_to_cast(self) -> None:\n321\t        \"\"\"If the only exiled cards are non-spell permanents (no instants or\n322\t        sorceries to free-cast), resolution still completes without raising and\n323\t        still exiles to threshold.\"\"\"\n324\t        game = create_game()\n325\t        p1 = game.players[0]\n326\t        capstone = ImprovisationCapstone(owner=p1, controller=p1)\n327\t\n328\t        # Lands are never cast — they are not spells; exile to threshold via\n329\t        # creatures that the controller declines / cannot free-cast meaningfully.\n330\t        big = _creature(\"Beast\", \"{3}{R}\", power=4, toughness=4)  # MV 4\n331\t        _set_library(game, 0, [big])\n332\t\n333\t        capstone.on_resolve(game)\n334\t\n335\t        assert big in _exiled(game, p1)\n336\t"}]},"parent_tool_use_id":"toolu_017AGMNzioYKWCAQpAoWPvcJ","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"23a41b02-10a1-4815-b79f-fbcb4140ed84","timestamp":"2026-06-01T09:32:58.634Z","subagent_type":"Reviewer","task_description":"Review sos_120"}
