{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016puqtcRxApsBp6h2F4fhGC","type":"tool_result","content":"1\t\"\"\"Central game state and turn/phase/step progression.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import Any\n6\t\n7\tfrom engine.combat import CombatState\n8\tfrom engine.continuous_effects import EffectManager\n9\tfrom engine.player import Player\n10\tfrom engine.replacement_effects import ReplacementManager\n11\tfrom engine.stack import Stack\n12\tfrom engine.triggers import TriggerManager\n13\tfrom engine.types import Phase, Step, Zone\n14\tfrom engine.zones import ZoneContainer\n15\t\n16\t# Ordered list of (Phase, Step | None) representing a full MTG turn.\n17\t_TURN_SEQUENCE: list[tuple[Phase, Step | None]] = [\n18\t    # Beginning phase\n19\t    (Phase.BEGINNING, Step.UNTAP),\n20\t    (Phase.BEGINNING, Step.UPKEEP),\n21\t    (Phase.BEGINNING, Step.DRAW),\n22\t    # Precombat main phase\n23\t    (Phase.PRECOMBAT_MAIN, None),\n24\t    # Combat phase\n25\t    (Phase.COMBAT, Step.BEGIN_COMBAT),\n26\t    (Phase.COMBAT, Step.DECLARE_ATTACKERS),\n27\t    (Phase.COMBAT, Step.DECLARE_BLOCKERS),\n28\t    (Phase.COMBAT, Step.COMBAT_DAMAGE),\n29\t    (Phase.COMBAT, Step.END_COMBAT),\n30\t    # Postcombat main phase\n31\t    (Phase.POSTCOMBAT_MAIN, None),\n32\t    # Ending phase\n33\t    (Phase.ENDING, Step.END),\n34\t    (Phase.ENDING, Step.CLEANUP),\n35\t]\n36\t\n37\t\n38\tclass GameState:\n39\t    \"\"\"Central game-state object tracking all mutable game information.\n40\t\n41\t    Attributes:\n42\t        players: The list of players in the game.\n43\t        active_player_index: Index of the current active player.\n44\t        priority_player_index: Index of the player who currently has priority.\n45\t        phase: Current phase of the turn.\n46\t        step: Current step within the phase (``None`` for main phases).\n47\t        turn_number: The current turn number (1-indexed).\n48\t        stack: The game stack for spells and abilities.\n49\t        trigger_manager: Central registry for triggered abilities.\n50\t        replacement_manager: Central registry for replacement effects.\n51\t        effect_manager: Manager for continuous effects and the layer system.\n52\t        is_game_over: Whether the game has ended.\n53\t        winner: The winning player, or ``None`` if the game is ongoing / draw.\n54\t    \"\"\"\n55\t\n56\t    def __init__(self, players: list[Player]) -> None:\n57\t        if len(players) < 2:\n58\t            raise ValueError(\"GameState requires at least 2 players\")\n59\t        if len(players) > 2:\n60\t            raise ValueError(\"GameState supports exactly 2 players\")\n61\t\n62\t        self.players: list[Player] = players\n63\t        self.active_player_index: int = 0\n64\t        self.priority_player_index: int = 0\n65\t        self.phase: Phase = Phase.BEGINNING\n66\t        self.step: Step | None = Step.UNTAP\n67\t        self.turn_number: int = 1\n68\t        self.stack: Stack = Stack()\n69\t        self.trigger_manager: TriggerManager = TriggerManager()\n70\t        self.replacement_manager: ReplacementManager = ReplacementManager()\n71\t        self.effect_manager: EffectManager = EffectManager()\n72\t        self.combat_state: CombatState = CombatState()\n73\t        self.is_game_over: bool = False\n74\t        self.winner: Player | None = None\n75\t        # ENGINE LIMITATION: Extra turns queue (FIFO of player seat indices).\n76\t        # Complex interactions ('skip your next turn', multiple extra turns\n77\t        # from different sources) are not fully handled.\n78\t        self.extra_turns: list[int] = []\n79\t        # Tracks normal turn rotation independently of extra turns.\n80\t        # Extra turns are truly *inserted* — they don't advance the\n81\t        # normal rotation.  When extras are exhausted the game picks up\n82\t        # from _normal_next_index.\n83\t        self._normal_next_index: int = 1\n84\t        # Additive miracle support (rule 702.94). Each entry is a dict with a\n85\t        # ``grant`` callable ``(game, player, drawn_card) -> ManaCost | None``\n86\t        # plus ``source``/``controller`` for cleanup. Empty by default, so the\n87\t        # miracle draw-window (fired from ``engine.game.draw_card``) is a strict\n88\t        # no-op unless a card such as Lorehold registers a grant.\n89\t        self._miracle_grants: list[dict[str, Any]] = []\n90\t\n91\t    # ------------------------------------------------------------------\n92\t    # Player properties\n93\t    # ------------------------------------------------------------------\n94\t\n95\t    @property\n96\t    def active_player(self) -> Player:\n97\t        \"\"\"Return the currently active player.\"\"\"\n98\t        return self.players[self.active_player_index]\n99\t\n100\t    @property\n101\t    def priority_player(self) -> Player:\n102\t        \"\"\"Return the player who currently has priority.\"\"\"\n103\t        return self.players[self.priority_player_index]\n104\t\n105\t    @property\n106\t    def non_active_player(self) -> Player:\n107\t        \"\"\"Return the non-active player (2-player assumption for v1).\"\"\"\n108\t        return self.players[1 - self.active_player_index]\n109\t\n110\t    # ------------------------------------------------------------------\n111\t    # Zone accessors\n112\t    # ------------------------------------------------------------------\n113\t\n114\t    def get_battlefield(self, player: Player) -> ZoneContainer:\n115\t        \"\"\"Return the battlefield zone for *player*.\"\"\"\n116\t        return player.zones[Zone.BATTLEFIELD]\n117\t\n118\t    def get_hand(self, player: Player) -> ZoneContainer:\n119\t        \"\"\"Return the hand zone for *player*.\"\"\"\n120\t        return player.zones[Zone.HAND]\n121\t\n122\t    def get_graveyard(self, player: Player) -> ZoneContainer:\n123\t        \"\"\"Return the graveyard zone for *player*.\"\"\"\n124\t        return player.zones[Zone.GRAVEYARD]\n125\t\n126\t    def get_library(self, player: Player) -> ZoneContainer:\n127\t        \"\"\"Return the library zone for *player*.\"\"\"\n128\t        return player.zones[Zone.LIBRARY]\n129\t\n130\t    def get_exile(self, player: Player) -> ZoneContainer:\n131\t        \"\"\"Return the exile zone for *player*.\"\"\"\n132\t        return player.zones[Zone.EXILE]\n133\t\n134\t    # ------------------------------------------------------------------\n135\t    # Miracle support (additive — no-op unless a grant is registered)\n136\t    # ------------------------------------------------------------------\n137\t\n138\t    def register_miracle_grant(\n139\t        self,\n140\t        grant: Any,\n141\t        *,\n142\t        source: Any = None,\n143\t        controller: Any = None,\n144\t    ) -> None:\n145\t        \"\"\"Register a miracle grant (rule 702.94).\n146\t\n147\t        *grant* is a callable ``(game, player, drawn_card) -> ManaCost | None``\n148\t        that returns the cost the *drawn_card* may be cast for via miracle (or\n149\t        ``None`` if this grant does not apply). The grant is consulted by\n150\t        :meth:`fire_miracle_window`, fired from ``engine.game.draw_card`` when a\n151\t        player draws the first card of their turn. ``source`` is used by\n152\t        :meth:`unregister_miracle_grant` for cleanup.\n153\t        \"\"\"\n154\t        self._miracle_grants.append(\n155\t            {\"grant\": grant, \"source\": source, \"controller\": controller}\n156\t        )\n157\t\n158\t    def unregister_miracle_grant(self, source: Any) -> None:\n159\t        \"\"\"Remove all miracle grants registered by *source* (identity-based).\"\"\"\n160\t        self._miracle_grants = [\n161\t            g for g in self._miracle_grants if g.get(\"source\") is not source\n162\t        ]\n163\t\n164\t    def fire_miracle_window(self, player: Player, drawn_card: Any) -> None:\n165\t        \"\"\"Offer a miracle cast for *drawn_card* (the first card drawn this turn).\n166\t\n167\t        Consults every registered miracle grant; the first grant that returns a\n168\t        cost offers *player* the option to cast *drawn_card* for that cost via\n169\t        :func:`engine.casting.cast_spell_alternative`. With no registered grants\n170\t        this is a strict no-op, so normal draws are unaffected.\n171\t        \"\"\"\n172\t        if not self._miracle_grants:\n173\t            return\n174\t\n175\t        for entry in list(self._miracle_grants):\n176\t            grant = entry.get(\"grant\")\n177\t            if grant is None:\n178\t                continue\n179\t            try:\n180\t                cost = grant(self, player, drawn_card)\n181\t            except Exception:\n182\t                cost = None\n183\t            if cost is None:\n184\t                continue\n185\t\n186\t            # \"you may cast it\" — ask the player.\n187\t            choose_yes_no = getattr(player, \"choose_yes_no\", None)\n188\t            wants = False\n189\t            if choose_yes_no is not None:\n190\t                try:\n191\t                    wants = bool(\n192\t                        choose_yes_no(\n193\t                            f\"Cast {getattr(drawn_card, 'name', drawn_card)!r} \"\n194\t                            \"for its miracle cost?\"\n195\t                        )\n196\t                    )\n197\t                except Exception:\n198\t                    wants = False\n199\t            if not wants:\n200\t                return\n201\t\n202\t            from engine.casting import CastingError, cast_spell_alternative\n203\t\n204\t            try:\n205\t                cast_spell_alternative(\n206\t                    self, player, drawn_card, Zone.HAND, cost\n207\t                )\n208\t            except CastingError:\n209\t                return\n210\t            return\n211\t\n212\t    # ------------------------------------------------------------------\n213\t    # Phase/step progression\n214\t    # ------------------------------------------------------------------\n215\t\n216\t    def advance_phase(self) -> None:\n217\t        \"\"\"Advance to the next phase/step in MTG turn order.\n218\t\n219\t        At the end of CLEANUP, the turn number is incremented and the\n220\t        active player swaps (2-player assumption).  Mana pools are\n221\t        emptied on every transition.\n222\t        \"\"\"\n223\t        current = (self.phase, self.step)\n224\t        idx = _TURN_SEQUENCE.index(current)\n225\t\n226\t        if idx + 1 < len(_TURN_SEQUENCE):\n227\t            # Move to next phase/step within the same turn.\n228\t            next_phase, next_step = _TURN_SEQUENCE[idx + 1]\n229\t            self.phase = next_phase\n230\t            self.step = next_step\n231\t            self._fire_beginning_of_main_phase()\n232\t        else:\n233\t            # End of turn — wrap around.\n234\t            self.turn_number += 1\n235\t            if self.extra_turns:\n236\t                # ENGINE LIMITATION: Extra turns queue (FIFO). Pop the\n237\t                # next player seat index; that player gets the next turn.\n238\t                # Normal rotation is NOT advanced — extra turns are\n239\t                # inserted before the normal next turn.\n240\t                self.active_player_index = self.extra_turns.pop(0)\n241\t            else:\n242\t                self.active_player_index = self._normal_next_index\n243\t                self._normal_next_index = 1 - self._normal_next_index\n244\t            # Skip-turn support: if the player who would become active has\n245\t            # queued skipped turns, consume one and hand the turn to the other\n246\t            # player instead. Default skipped_turns == 0 makes this a no-op, so\n247\t            # existing turn rotation is unaffected.\n248\t            self._apply_skipped_turns()\n249\t            self.priority_player_index = self.active_player_index\n250\t            self.phase = _TURN_SEQUENCE[0][0]\n251\t            self.step = _TURN_SEQUENCE[0][1]\n252\t\n253\t        self.empty_mana_pools()\n254\t\n255\t    def _apply_skipped_turns(self) -> None:\n256\t        \"\"\"Skip the active player's turn(s) if they have ``skipped_turns`` queued.\n257\t\n258\t        Additive turn-skip support. When the player just rotated to as active\n259\t        has ``skipped_turns > 0``, decrement it and pass the turn to the other\n260\t        player (advancing the normal rotation so the skipped player does not\n261\t        immediately regain it). Loops to handle consecutive skips. Bounded by\n262\t        the number of players with queued skips so it always terminates.\n263\t\n264\t        Default ``skipped_turns == 0`` for all players makes this a no-op.\n265\t        \"\"\"\n266\t        # Guard: nothing to do if no player has queued skips.\n267\t        guard = 0\n268\t        max_iterations = sum(\n269\t            max(0, getattr(p, \"skipped_turns\", 0)) for p in self.players\n270\t        ) + len(self.players)\n271\t        while getattr(self.active_player, \"skipped_turns\", 0) > 0:\n272\t            self.active_player.skipped_turns -= 1\n273\t            self.turn_number += 1\n274\t            self.active_player_index = self._normal_next_index\n275\t            self._normal_next_index = 1 - self._normal_next_index\n276\t            guard += 1\n277\t            if guard > max_iterations:\n278\t                break\n279\t\n280\t    def flip_coin(self, player: Player | None = None) -> bool:\n281\t        \"\"\"Flip a coin, returning ``True`` for heads.\n282\t\n283\t        Deterministic in tests: if *player* is a scripted player, the result is\n284\t        read from its choice script via ``choose_yes_no`` so a test can force a\n285\t        known sequence of heads/tails. Falls back to real randomness when no\n286\t        scriptable player is available.\n287\t\n288\t        Parameters:\n289\t            player: The player flipping (whose script supplies the result in\n290\t                tests). May be ``None``.\n291\t\n292\t        Returns:\n293\t            ``True`` for heads, ``False`` for tails.\n294\t        \"\"\"\n295\t        if player is not None and hasattr(player, \"_script\"):\n296\t            # Scripted player: pull the next answer if one is queued, otherwise\n297\t            # fall through to randomness so resolution never raises mid-flip.\n298\t            script = getattr(player, \"_script\", None)\n299\t            if script:\n300\t                return bool(player.choose_yes_no(\"Flip a coin (heads?)\"))\n301\t        import random\n302\t\n303\t        return random.choice((True, False))\n304\t\n305\t    def empty_mana_pools(self) -> None:\n306\t        \"\"\"Empty all players' mana pools — called on each phase/step transition.\"\"\"\n307\t        for player in self.players:\n308\t            player.mana_pool.empty()\n309\t\n310\t    def _fire_beginning_of_main_phase(self) -> None:\n311\t        \"\"\"Fire ``BeginningOfMainPhaseTriggeredEvent`` if we just entered a main phase.\n312\t\n313\t        Additive hook used by delayed \"at the beginning of your next main\n314\t        phase\" triggers (e.g. Mana Sculpt's {C} bonus).  Safe no-op when the\n315\t        current phase is not a main phase.\n316\t        \"\"\"\n317\t        if self.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n318\t            return\n319\t        from engine.events import BeginningOfMainPhaseTriggeredEvent\n320\t\n321\t        self.trigger_manager.fire_event(\n322\t            self,\n323\t            BeginningOfMainPhaseTriggeredEvent(\n324\t                player=self.active_player, phase=self.phase\n325\t            ),\n326\t        )\n327\t"}]},"parent_tool_use_id":"toolu_01Y8yGfyN1K4izYt6a4vpeSv","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"ffbca824-df91-4b04-aa5c-9da5ae7872a8","timestamp":"2026-06-01T09:58:55.185Z","subagent_type":"Implementer","task_description":"Implement sos_245"}
