{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UfXpyJvCfu7CmsC7HbQegK","type":"tool_result","content":"1\t\"\"\"Reference test for FDN 13 — Fleeting Flight.\n2\t\n3\tIllustrative test covering **target selection / validation**. Fleeting\n4\tFlight is a targeted instant: ``get_targets()`` returns a\n5\t``TargetRequirement`` describing what is legal, and the cast pipeline\n6\tpopulates ``chosen_targets`` with the player's selection. ``on_resolve``\n7\treads ``chosen_targets`` and applies the effect to the chosen target.\n8\t\"\"\"\n9\t\n10\tfrom __future__ import annotations\n11\t\n12\tfrom cards.fdn.fdn_13.card_impl import FleetingFlight\n13\tfrom engine.card import Creature, Instant\n14\tfrom engine.types import (\n15\t    CardType,\n16\t    Keyword,\n17\t    ManaCost,\n18\t    TargetRequirement,\n19\t    Zone,\n20\t)\n21\tfrom test_utils import create_game\n22\t\n23\t\n24\tclass TestFleetingFlightProperties:\n25\t    \"\"\"Static card data should match the FDN 13 spec.\"\"\"\n26\t\n27\t    def test_is_instant(self) -> None:\n28\t        assert isinstance(FleetingFlight(owner=None), Instant)\n29\t\n30\t    def test_name(self) -> None:\n31\t        assert FleetingFlight(owner=None).name == \"Fleeting Flight\"\n32\t\n33\t    def test_mana_cost(self) -> None:\n34\t        assert FleetingFlight(owner=None).mana_cost == ManaCost.parse(\"{W}\")\n35\t\n36\t\n37\tclass TestFleetingFlightTargeting:\n38\t    \"\"\"get_targets() advertises a single creature target on the battlefield.\"\"\"\n39\t\n40\t    def test_returns_single_target_requirement(self) -> None:\n41\t        game = create_game()\n42\t        reqs = FleetingFlight(owner=None).get_targets(game)\n43\t        assert isinstance(reqs, list)\n44\t        assert len(reqs) == 1\n45\t        assert isinstance(reqs[0], TargetRequirement)\n46\t\n47\t    def test_target_zone_is_battlefield(self) -> None:\n48\t        game = create_game()\n49\t        req = FleetingFlight(owner=None).get_targets(game)[0]\n50\t        assert req.zone == Zone.BATTLEFIELD\n51\t\n52\t    def test_target_filter_accepts_creature(self) -> None:\n53\t        \"\"\"The filter must accept creatures and reject non-creatures.\"\"\"\n54\t        game = create_game()\n55\t        req = FleetingFlight(owner=None).get_targets(game)[0]\n56\t\n57\t        creature = Creature(name=\"Test Bear\", base_power=2, base_toughness=2)\n58\t        creature.card_types = {CardType.CREATURE}\n59\t        non_creature = Creature(name=\"Not a creature\")  # no card_types\n60\t        non_creature.card_types = set()\n61\t\n62\t        assert req.filter_fn(creature) is True\n63\t        assert req.filter_fn(non_creature) is False\n64\t\n65\t\n66\tclass TestFleetingFlightResolution:\n67\t    \"\"\"on_resolve reads chosen_targets and applies the effect.\"\"\"\n68\t\n69\t    def test_no_target_is_a_noop(self) -> None:\n70\t        game = create_game()\n71\t        p1 = game.players[0]\n72\t        spell = FleetingFlight(owner=p1, controller=p1)\n73\t        # chosen_targets is unset — resolution must not raise.\n74\t        spell.on_resolve(game)\n75\t\n76\t    def test_chosen_target_receives_counter_and_flying(self) -> None:\n77\t        game = create_game()\n78\t        p1 = game.players[0]\n79\t\n80\t        # Put a vanilla bear on the battlefield as the target.\n81\t        bear = Creature(\n82\t            name=\"Grizzly Bears\",\n83\t            owner=p1,\n84\t            controller=p1,\n85\t            base_power=2,\n86\t            base_toughness=2,\n87\t        )\n88\t        bear.card_types = {CardType.CREATURE}\n89\t        game.get_battlefield(p1).add(bear)\n90\t\n91\t        spell = FleetingFlight(owner=p1, controller=p1)\n92\t        # The cast pipeline would set chosen_targets; we set it directly\n93\t        # to validate that on_resolve reads it correctly.\n94\t        spell.chosen_targets = [bear]\n95\t        before = bear.plus_one_counters\n96\t        spell.on_resolve(game)\n97\t        # +1/+1 counter applied to the chosen target.\n98\t        assert bear.plus_one_counters == before + 1\n99\t        # Damage-prevention flag set per the card's \"prevent all combat\n100\t        # damage\" clause.\n101\t        assert bear.combat_damage_prevented is True\n102\t"}]},"parent_tool_use_id":"toolu_015YjqSJ8qf6KKiKFJ4NXToW","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"45624a39-a381-4d87-8966-fcb0a9cc5816","timestamp":"2026-06-01T09:48:10.827Z","subagent_type":"Tester","task_description":"Write tests for sos_226"}
