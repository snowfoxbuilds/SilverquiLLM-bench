{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012t6cfpug3bTZNa1WeABJr9","type":"tool_result","content":"130\t    def get_exile(self, player: Player) -> ZoneContainer:\n131\t        \"\"\"Return the exile zone for *player*.\"\"\"\n132\t        return player.zones[Zone.EXILE]\n133\t\n134\t    # ------------------------------------------------------------------\n135\t    # Miracle support (additive — no-op unless a grant is registered)\n136\t    # ------------------------------------------------------------------\n137\t\n138\t    def register_miracle_grant(\n139\t        self,\n140\t        grant: Any,\n141\t        *,\n142\t        source: Any = None,\n143\t        controller: Any = None,\n144\t    ) -> None:\n145\t        \"\"\"Register a miracle grant (rule 702.94).\n146\t\n147\t        *grant* is a callable ``(game, player, drawn_card) -> ManaCost | None``\n148\t        that returns the cost the *drawn_card* may be cast for via miracle (or\n149\t        ``None`` if this grant does not apply). The grant is consulted by\n150\t        :meth:`fire_miracle_window`, fired from ``engine.game.draw_card`` when a\n151\t        player draws the first card of their turn. ``source`` is used by\n152\t        :meth:`unregister_miracle_grant` for cleanup.\n153\t        \"\"\"\n154\t        self._miracle_grants.append(\n155\t            {\"grant\": grant, \"source\": source, \"controller\": controller}\n156\t        )\n157\t\n158\t    def unregister_miracle_grant(self, source: Any) -> None:\n159\t        \"\"\"Remove all miracle grants registered by *source* (identity-based).\"\"\"\n160\t        self._miracle_grants = [\n161\t            g for g in self._miracle_grants if g.get(\"source\") is not source\n162\t        ]\n163\t\n164\t    def fire_miracle_window(self, player: Player, drawn_card: Any) -> None:\n165\t        \"\"\"Offer a miracle cast for *drawn_card* (the first card drawn this turn).\n166\t\n167\t        Consults every registered miracle grant; the first grant that returns a\n168\t        cost offers *player* the option to cast *drawn_card* for that cost via\n169\t        :func:`engine.casting.cast_spell_alternative`. With no registered grants\n170\t        this is a strict no-op, so normal draws are unaffected.\n171\t        \"\"\"\n172\t        if not self._miracle_grants:\n173\t            return\n174\t\n175\t        for entry in list(self._miracle_grants):\n176\t            grant = entry.get(\"grant\")\n177\t            if grant is None:\n178\t                continue\n179\t            try:\n180\t                cost = grant(self, player, drawn_card)\n181\t            except Exception:\n182\t                cost = None\n183\t            if cost is None:\n184\t                continue\n185\t\n186\t            # \"you may cast it\" — ask the player.\n187\t            choose_yes_no = getattr(player, \"choose_yes_no\", None)\n188\t            wants = False\n189\t            if choose_yes_no is not None:\n190\t                try:\n191\t                    wants = bool(\n192\t                        choose_yes_no(\n193\t                            f\"Cast {getattr(drawn_card, 'name', drawn_card)!r} \"\n194\t                            \"for its miracle cost?\"\n195\t                        )\n196\t                    )\n197\t                except Exception:\n198\t                    wants = False\n199\t            if not wants:\n200\t                return\n201\t\n202\t            from engine.casting import CastingError, cast_spell_alternative\n203\t\n204\t            try:\n205\t                cast_spell_alternative(\n206\t                    self, player, drawn_card, Zone.HAND, cost\n207\t                )\n208\t            except CastingError:\n209\t                return\n210\t            return\n211\t\n212\t    # ------------------------------------------------------------------\n213\t    # Phase/step progression\n214\t    # ------------------------------------------------------------------\n215\t\n216\t    def advance_phase(self) -> None:\n217\t        \"\"\"Advance to the next phase/step in MTG turn order.\n218\t\n219\t        At the end of CLEANUP, the turn number is incremented and the"}]},"parent_tool_use_id":"toolu_0138E7VkeFj65rLGAvBcgNVS","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"78c9753f-04b0-4822-8c75-a65ae624fe32","timestamp":"2026-06-01T09:42:42.443Z","subagent_type":"Tester","task_description":"Extend sos_201 tests for miracle"}
