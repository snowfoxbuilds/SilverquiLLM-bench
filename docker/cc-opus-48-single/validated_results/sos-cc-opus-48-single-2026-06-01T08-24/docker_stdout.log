{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BWmUdf1WMbFf6i11DcQ15G","type":"tool_result","content":"1\t\"\"\"Card implementation for Embercleave.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom typing import TYPE_CHECKING, Any\n4\tfrom engine.card import ActivatedAbility, Artifact, Creature, Enchantment, Instant, ManaAbility, Sorcery\n5\tfrom engine.continuous_effects import ContinuousEffect, DURATION_END_OF_TURN, DURATION_PERMANENT, Layer, SubLayer\n6\tfrom engine.types import CardType, Color, HybridManaSymbol, Keyword, ManaCost, ManaType, Supertype, Zone\n7\tfrom engine.events import EntersBattlefieldTriggeredEvent\n8\tif TYPE_CHECKING:\n9\t    from engine.game_state import GameState\n10\t    from cards.registry import CardRegistry\n11\t\n12\tdef _is_on_battlefield(game: Any, card: Any) -> bool:\n13\t    \"\"\"Check if *card* is on any player's battlefield.\"\"\"\n14\t    for player in game.players:\n15\t        if game.get_battlefield(player).contains(card):\n16\t            return True\n17\t    return False\n18\t\n19\tclass Embercleave(Artifact):\n20\t    \"\"\"Embercleave — {4}{R}{R} — Legendary Artifact — Equipment\n21\t\n22\t    Flash\n23\t    This spell costs {1} less to cast for each attacking creature you\n24\t    control.\n25\t    When Embercleave enters the battlefield, attach it to target creature\n26\t    you control.\n27\t    Equipped creature gets +1/+1 and has double strike and trample.\n28\t    Equip {3}\n29\t\n30\t    SPG collector number 77.\n31\t    \"\"\"\n32\t\n33\t    def __init__(self, **kwargs: Any) -> None:\n34\t        kwargs.setdefault('name', 'Embercleave')\n35\t        kwargs.setdefault('mana_cost', ManaCost.parse('{4}{R}{R}'))\n36\t        kwargs.setdefault('subtypes', set())\n37\t        kwargs['subtypes'] = (kwargs.get('subtypes') or set()) | {'Equipment'}\n38\t        kwargs.setdefault('supertypes', set())\n39\t        kwargs['supertypes'] = (kwargs.get('supertypes') or set()) | {Supertype.LEGENDARY}\n40\t        kwargs.setdefault('keywords', Keyword.FLASH)\n41\t        kwargs.setdefault('rules_text', 'Flash\\nThis spell costs {1} less to cast for each attacking creature you control.\\nWhen Embercleave enters the battlefield, attach it to target creature you control.\\nEquipped creature gets +1/+1 and has double strike and trample.\\nEquip {3}')\n42\t        super().__init__(**kwargs)\n43\t        self.attached_to: Any | None = None\n44\t        self._effect_ref: ContinuousEffect | None = None\n45\t\n46\t    def cost_reduction(self, game: Any) -> int:\n47\t        \"\"\"Cost {1} less for each attacking creature you control.\"\"\"\n48\t        controller = self.controller or self.owner\n49\t        if controller is None:\n50\t            return 0\n51\t        count = 0\n52\t        bf = game.get_battlefield(controller)\n53\t        for perm in bf.get_all():\n54\t            if CardType.CREATURE in getattr(perm, 'card_types', set()) and getattr(perm, 'is_attacking', False):\n55\t                count += 1\n56\t        return count\n57\t\n58\t    def equip(self, target: Any, game: Any) -> None:\n59\t        \"\"\"Attach Embercleave to *target* creature.\"\"\"\n60\t        self.attached_to = target\n61\t        self._register_effect(game)\n62\t\n63\t    def _register_effect(self, game: Any) -> None:\n64\t        equip_ref = self\n65\t\n66\t        def _apply_keywords(g: Any) -> None:\n67\t            if not _is_on_battlefield(g, equip_ref):\n68\t                return\n69\t            creature = equip_ref.attached_to\n70\t            if creature is None or not _is_on_battlefield(g, creature):\n71\t                return\n72\t            creature.keywords = creature.keywords | Keyword.DOUBLE_STRIKE | Keyword.TRAMPLE\n73\t\n74\t        def _apply_pt(g: Any) -> None:\n75\t            if not _is_on_battlefield(g, equip_ref):\n76\t                return\n77\t            creature = equip_ref.attached_to\n78\t            if creature is None or not _is_on_battlefield(g, creature):\n79\t                return\n80\t            creature.modified_power += 1\n81\t            creature.modified_toughness += 1\n82\t        if self._effect_ref is None:\n83\t            effect_kw = ContinuousEffect(source=equip_ref, layer=Layer.ABILITY, sublayer=None, apply=_apply_keywords, duration=DURATION_PERMANENT)\n84\t            game.effect_manager.add(effect_kw)\n85\t            effect_pt = ContinuousEffect(source=equip_ref, layer=Layer.POWER_TOUGHNESS, sublayer=SubLayer.MODIFY_PT, apply=_apply_pt, duration=DURATION_PERMANENT)\n86\t            self._effect_ref = game.effect_manager.add(effect_pt)\n87\t\n88\t    def _do_etb_attach(self, game: Any) -> None:\n89\t        \"\"\"Perform the ETB attach — find a creature you control and equip it.\"\"\"\n90\t        controller = self.controller or self.owner\n91\t        if controller is None:\n92\t            return\n93\t        bf = game.get_battlefield(controller)\n94\t        creatures = [c for c in bf.get_all() if CardType.CREATURE in getattr(c, 'card_types', set())]\n95\t        if creatures:\n96\t            target = creatures[0]\n97\t            self.equip(target, game)\n98\t\n99\t    def on_resolve(self, game: Any) -> None:\n100\t        \"\"\"When Embercleave resolves, it enters the battlefield and attaches.\"\"\"\n101\t        self._do_etb_attach(game)\n102\t\n103\t    def register_triggers(self, game: Any) -> None:\n104\t        from engine.triggers import TriggerRegistration\n105\t        source = self\n106\t\n107\t        def _etb_condition(g: Any, event: dict) -> bool:\n108\t            return event.permanent is source\n109\t\n110\t        def _etb_effect(g: Any) -> None:\n111\t            source._do_etb_attach(g)\n112\t        reg = TriggerRegistration(event_type=EntersBattlefieldTriggeredEvent, condition=_etb_condition, effect=_etb_effect, source=self, controller=source.controller or source.owner)\n113\t        game.trigger_manager.register(reg)\n114\t\n115\t    def get_activated_abilities(self) -> list[ActivatedAbility]:\n116\t        source = self\n117\t\n118\t        def _cost(game: Any, src: Any) -> bool:\n119\t            controller = getattr(src, 'controller', None)\n120\t            if controller is None:\n121\t                return False\n122\t            cost = ManaCost(generic=3)\n123\t            if not controller.mana_pool.can_pay(cost):\n124\t                return False\n125\t            controller.mana_pool.pay(cost)\n126\t            return True\n127\t\n128\t        def _effect(game: Any) -> None:\n129\t            target = getattr(source, '_current_target', None)\n130\t            if target is not None:\n131\t                source.equip(target, game)\n132\t        return [ActivatedAbility(cost=_cost, effect=_effect, description='Equip {3} (sorcery speed)')]\n133\t"}]},"parent_tool_use_id":"toolu_01XD2FdaWwdM2D8M6HaFcj1t","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"4033c1a7-678b-4796-8a17-7ab06b528afb","timestamp":"2026-06-01T08:25:36.305Z","subagent_type":"Tester","task_description":"Write tests for sos_1"}
