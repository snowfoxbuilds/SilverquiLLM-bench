{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01ND2s5UmwQP1KNVvLBHpqiq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DxaBQENgNyqrTbRGAk6CwB","name":"Read","input":{"file_path":"/workspace/engine/casting.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10463,"cache_read_input_tokens":12792,"cache_creation":{"ephemeral_5m_input_tokens":10463,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01HwcPhRpe1q2HYXdHiQNaBQ","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"5d222794-3e38-40d1-93fa-962d8c6295a8","request_id":"req_011CbcMM3iUSxZjStAWmgM5y","subagent_type":"Tester","task_description":"Extend sos_245 tests for registry"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DxaBQENgNyqrTbRGAk6CwB","type":"tool_result","content":"1\t\"\"\"Casting and resolution pipeline for spells and lands.\n2\t\n3\tProvides the full flow from casting a spell or playing a land through\n4\tresolution:\n5\t\n6\t- :func:`cast_spell` — verify timing & legality → move hand to stack →\n7\t  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n8\t- :func:`play_land` — verify land play remaining → move hand to\n9\t  battlefield → decrement ``land_plays_remaining``.\n10\t- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n11\t  helpers used by the casting pipeline.\n12\t\n13\tResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\n14\tcreated by :func:`cast_spell`:\n15\t\n16\t- Call ``card.on_resolve(game)``.\n17\t- Permanents (creature / enchantment / artifact / planeswalker) move from\n18\t  the stack to the battlefield.\n19\t- Non-permanents (instant / sorcery) move to the graveyard.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import TYPE_CHECKING, Any\n25\t\n26\tfrom engine.card import CardImpl\n27\tfrom engine.stack import StackObject\n28\tfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\n29\tfrom engine.zones import move_zone\n30\t\n31\tif TYPE_CHECKING:\n32\t    from engine.game_state import GameState\n33\t    from engine.player import Player\n34\t\n35\t\n36\t# Card types that represent permanents — these go to the battlefield on resolve.\n37\t_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n38\t    CardType.CREATURE,\n39\t    CardType.ENCHANTMENT,\n40\t    CardType.ARTIFACT,\n41\t    CardType.PLANESWALKER,\n42\t})\n43\t\n44\t\n45\tclass CastingError(Exception):\n46\t    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n47\t\n48\t\n49\t# ------------------------------------------------------------------\n50\t# Timing helpers\n51\t# ------------------------------------------------------------------\n52\t\n53\tdef is_sorcery_speed(game: GameState, player: Player) -> bool:\n54\t    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n55\t\n56\t    Sorcery speed requires all of:\n57\t\n58\t    * *player* is the active player.\n59\t    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n60\t      ``POSTCOMBAT_MAIN``).\n61\t    * The stack is empty.\n62\t    \"\"\"\n63\t    if player is not game.active_player:\n64\t        return False\n65\t    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n66\t        return False\n67\t    if not game.stack.is_empty():\n68\t        return False\n69\t    return True\n70\t\n71\t\n72\tdef can_cast_at_instant_speed(card: CardImpl) -> bool:\n73\t    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n74\t\n75\t    A card has instant-speed timing if it is an instant or has the\n76\t    :attr:`~engine.types.Keyword.FLASH` keyword.\n77\t    \"\"\"\n78\t    if CardType.INSTANT in card.card_types:\n79\t        return True\n80\t    if Keyword.FLASH & card.keywords:\n81\t        return True\n82\t    return False\n83\t\n84\t\n85\t# ------------------------------------------------------------------\n86\t# Cost reduction\n87\t# ------------------------------------------------------------------\n88\t\n89\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n90\t    \"\"\"Return the generic mana reduction for casting *card*.\n91\t\n92\t    Queries ``card.cost_reduction(game)`` and clamps the result so that\n93\t    the generic portion of the mana cost cannot go below 0.\n94\t\n95\t    This is a simplified single-card self-reduction model.  Full MTG\n96\t    cost-reduction interactions (Trinisphere, multiple reductions from\n97\t    different sources) are deferred.\n98\t    \"\"\"\n99\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n100\t    # casting player even when the card was never explicitly assigned one.\n101\t    prev_controller = card.controller\n102\t    card.controller = controller\n103\t    raw = card.cost_reduction(game)\n104\t    # Add any external game-level reducers (e.g. a permanent granting\n105\t    # \"affinity for creatures\" to the controller's other instant/sorcery\n106\t    # spells). Strict no-op when the registry is empty, so existing\n107\t    # cost-reduction tests are unaffected.\n108\t    external = 0\n109\t    reducer_hook = getattr(game, \"spell_cost_reduction_from_reducers\", None)\n110\t    if reducer_hook is not None:\n111\t        try:\n112\t            external = int(reducer_hook(card, controller))\n113\t        except Exception:\n114\t            external = 0\n115\t    raw += external\n116\t    # Restore previous controller in case the caller doesn't want a\n117\t    # side-effect (get_cost_reduction is a query, not a mutation).\n118\t    card.controller = prev_controller\n119\t    generic = card.mana_cost.generic if card.mana_cost else 0\n120\t    return max(0, min(raw, generic))\n121\t\n122\t\n123\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n124\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n125\t    new_generic = max(0, cost.generic - reduction)\n126\t    return ManaCost(\n127\t        generic=new_generic,\n128\t        pips=dict(cost.pips),\n129\t        x_count=cost.x_count,\n130\t        hybrid=list(cost.hybrid),\n131\t    )\n132\t\n133\t\n134\t# ------------------------------------------------------------------\n135\t# Cast spell\n136\t# ------------------------------------------------------------------\n137\t\n138\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n139\t    \"\"\"Cast *card* from *player*'s hand.\n140\t\n141\t    Pipeline\n142\t    --------\n143\t    1. **Timing check** — instants (and cards with flash) can be cast\n144\t       whenever the player has priority; everything else requires\n145\t       sorcery-speed timing.\n146\t    2. **can_cast** — ask the card whether it can legally be cast.\n147\t    3. **Hand check** — the card must be in the player's hand.\n148\t    4. **Move hand → stack zone** — remove the card from the hand and\n149\t       place it into the player's stack zone.\n150\t    5. **Choose targets** — if the card specifies targets (via\n151\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n152\t    6. **Mana check / payment** — the player's mana pool must be able to\n153\t       pay the card's mana cost.  If payment fails, the card is rolled\n154\t       back from the stack zone to the hand.\n155\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n156\t    8. **Push StackObject** — push a :class:`StackObject` whose\n157\t       ``on_resolve`` callback handles resolution.\n158\t\n159\t    Raises:\n160\t        CastingError: If any legality check fails.\n161\t    \"\"\"\n162\t    # 1. Timing\n163\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n164\t        raise CastingError(\n165\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n166\t        )\n167\t\n168\t    # 2. can_cast\n169\t    if not card.can_cast(game):\n170\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n171\t\n172\t    # 3. Hand check\n173\t    hand = game.get_hand(player)\n174\t    if not hand.contains(card):\n175\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n176\t\n177\t    # 4. Move card from hand to stack zone\n178\t    stack_zone = player.zones[Zone.STACK]\n179\t    hand.remove(card)\n180\t    stack_zone.add(card)\n181\t\n182\t    # Clear any stale colors_spent from a prior cast before new payment.\n183\t    if hasattr(card, \"colors_spent\"):\n184\t        del card.colors_spent\n185\t\n186\t    # 5. Choose targets\n187\t    target_specs = card.get_targets(game)\n188\t    chosen_targets: list[Any] = []\n189\t    if target_specs:\n190\t        for spec in target_specs:\n191\t            target = player.choose_target(target_specs, spec)\n192\t            # Validate against filter_fn if the spec provides one\n193\t            filter_fn = getattr(spec, \"filter_fn\", None)\n194\t            if filter_fn is not None and target is not None:\n195\t                if not filter_fn(target):\n196\t                    stack_zone.remove(card)\n197\t                    hand.add(card)\n198\t                    raise CastingError(\n199\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n200\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n201\t                    )\n202\t            chosen_targets.append(target)\n203\t\n204\t    # 5b. Protection check — reject targets that have protection from this\n205\t    #     spell (the T in DEBT).\n206\t    from engine.protection import has_protection_from\n207\t\n208\t    for target in chosen_targets:\n209\t        if has_protection_from(target, card):\n210\t            # Rollback: move card from stack zone back to hand\n211\t            stack_zone.remove(card)\n212\t            hand.add(card)\n213\t            raise CastingError(\n214\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n215\t            )\n216\t\n217\t    # Targets are stored on the StackObject (not the card) and passed\n218\t    # through the resolve pipeline via on_resolve(game, targets=...).\n219\t\n220\t    # 6. Mana check / payment (rollback on failure)\n221\t    # Ensure the card knows its controller so that cost_reduction() hooks\n222\t    # (e.g. Embercleave counting attacking creatures you control) see the\n223\t    # casting player, even for cards that were added to hand without an\n224\t    # explicit controller assignment.\n225\t    if card.controller is None:\n226\t        card.controller = player\n227\t    reduction = get_cost_reduction(game, card, player)\n228\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n229\t\n230\t    if not player.mana_pool.can_pay(effective_cost):\n231\t        # Rollback: move card from stack zone back to hand\n232\t        stack_zone.remove(card)\n233\t        hand.add(card)\n234\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n235\t\n236\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n237\t    player.mana_pool.pay(effective_cost)\n238\t\n239\t    # Store colors of mana spent on the card for mechanics like Converge\n240\t    # that care about the colors used to cast the spell.\n241\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n242\t\n243\t    # Record the total quantity of mana paid to cast this spell, for\n244\t    # mechanics like Mana Sculpt that add {C} equal to the mana spent.\n245\t    # X is included via its contribution to the effective cost's mana value.\n246\t    card.mana_spent = effective_cost.cmc  # type: ignore[attr-defined]\n247\t\n248\t    # 7. Call on_cast hook\n249\t    card.on_cast(game)\n250\t\n251\t    # 8. Build on_resolve callback and push StackObject\n252\t    stack_obj = StackObject(\n253\t        source=card,\n254\t        controller=player,\n255\t        targets=chosen_targets,\n256\t        on_resolve=lambda g: None,  # replaced below\n257\t    )\n258\t\n259\t    def _on_resolve(g: GameState) -> None:\n260\t        _resolve_spell(g, card, player, stack_obj)\n261\t\n262\t    stack_obj.on_resolve = _on_resolve\n263\t    game.stack.push(stack_obj)\n264\t\n265\t\n266\t# ------------------------------------------------------------------\n267\t# Cast spell without paying mana cost (free-cast from any zone)\n268\t# ------------------------------------------------------------------\n269\t\n270\t\n271\tdef cast_spell_free(\n272\t    game: GameState,\n273\t    player: Player,\n274\t    card: CardImpl,\n275\t    from_zone: Zone,\n276\t) -> None:\n277\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n278\t\n279\t    This is used by effects that allow casting from zones other than hand\n280\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n281\t    or cascade.\n282\t\n283\t    Pipeline\n284\t    --------\n285\t    1. **can_cast** — ask the card whether it can legally be cast (same\n286\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n287\t    2. Move *card* from *from_zone* to the stack zone.\n288\t    3. Choose targets (if applicable) with validation and protection check.\n289\t    4. Call ``on_cast`` hook.\n290\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n291\t       resolution normally (permanents → battlefield, non-permanents →\n292\t       graveyard).\n293\t\n294\t    No timing check or mana payment is performed.  The spell goes on the\n295\t    stack and can be responded to normally (e.g. countered).\n296\t\n297\t    If targeting or other post-move checks fail, the card is rolled back\n298\t    to its source zone.\n299\t\n300\t    Parameters:\n301\t        game: The current game state.\n302\t        player: The player casting the spell.\n303\t        card: The card to cast.\n304\t        from_zone: The zone the card is currently in.\n305\t\n306\t    Raises:\n307\t        CastingError: If the card cannot be found in *from_zone* or\n308\t            legality checks fail.\n309\t    \"\"\"\n310\t    from engine.zones import move_to_zone\n311\t\n312\t    # Ensure controller is set\n313\t    card.controller = player\n314\t    if card.owner is None:\n315\t        card.owner = player\n316\t\n317\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n318\t    if not card.can_cast(game):\n319\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n320\t\n321\t    # 2. Locate card in source zone\n322\t    source_zone_container = player.zones[from_zone]\n323\t    if not source_zone_container.contains(card):\n324\t        # Try to find the card in any player's zone\n325\t        source_zone_container = None\n326\t        for p in game.players:\n327\t            z = p.zones[from_zone]\n328\t            if z.contains(card):\n329\t                source_zone_container = z\n330\t                break\n331\t\n332\t    if source_zone_container is None or not source_zone_container.contains(card):\n333\t        raise CastingError(\n334\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n335\t        )\n336\t\n337\t    # Move card from source zone to stack zone\n338\t    stack_zone = player.zones[Zone.STACK]\n339\t    source_zone_container.remove(card)\n340\t    stack_zone.add(card)\n341\t\n342\t    # 3. Choose targets (with rollback on failure)\n343\t    try:\n344\t        target_specs = card.get_targets(game)\n345\t        chosen_targets: list[Any] = []\n346\t        if target_specs:\n347\t            for spec in target_specs:\n348\t                target = player.choose_target(target_specs, spec)\n349\t                # Validate against filter_fn if the spec provides one\n350\t                filter_fn = getattr(spec, \"filter_fn\", None)\n351\t                if filter_fn is not None and target is not None:\n352\t                    if not filter_fn(target):\n353\t                        raise CastingError(\n354\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n355\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n356\t                        )\n357\t                chosen_targets.append(target)\n358\t\n359\t        # Protection check — reject targets that have protection from this spell\n360\t        from engine.protection import has_protection_from\n361\t\n362\t        for target in chosen_targets:\n363\t            if has_protection_from(target, card):\n364\t                raise CastingError(\n365\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n366\t                )\n367\t    except Exception as exc:\n368\t        # Rollback: move card from stack zone back to source zone\n369\t        stack_zone.remove(card)\n370\t        source_zone_container.add(card)\n371\t        raise CastingError(str(exc)) from exc\n372\t\n373\t    # 4. Call on_cast hook\n374\t    card.on_cast(game)\n375\t\n376\t    # 5. Build on_resolve callback and push StackObject\n377\t    stack_obj = StackObject(\n378\t        source=card,\n379\t        controller=player,\n380\t        targets=chosen_targets,\n381\t        on_resolve=lambda g: None,  # replaced below\n382\t    )\n383\t\n384\t    def _on_resolve(g: GameState) -> None:\n385\t        _resolve_spell(g, card, player, stack_obj)\n386\t\n387\t    stack_obj.on_resolve = _on_resolve\n388\t    game.stack.push(stack_obj)\n389\t\n390\t\n391\t# ------------------------------------------------------------------\n392\t# Cast spell for a specified alternative cost (e.g. miracle)\n393\t# ------------------------------------------------------------------\n394\t\n395\t\n396\tdef cast_spell_alternative(\n397\t    game: GameState,\n398\t    player: Player,\n399\t    card: CardImpl,\n400\t    from_zone: Zone,\n401\t    alternative_cost: ManaCost,\n402\t) -> None:\n403\t    \"\"\"Cast *card* by paying *alternative_cost* instead of its mana cost.\n404\t\n405\t    This is the entry point for alternative-cost casts such as miracle, where a\n406\t    card is cast \"by paying [cost] rather than its mana cost\" (rule 702.94a).\n407\t    It mirrors :func:`cast_spell` (legality, target choice, mana payment, the\n408\t    ``on_cast`` hook, and pushing a :class:`StackObject`) but:\n409\t\n410\t    * the card may come from any *from_zone* (not just the hand), and\n411\t    * mana payment uses *alternative_cost* rather than ``card.mana_cost``.\n412\t\n413\t    No timing or sorcery-speed check is performed here — the caller (a miracle\n414\t    window, etc.) is responsible for invoking this only at a legal time. The\n415\t    spell is placed on the stack and can be responded to normally.\n416\t\n417\t    Raises:\n418\t        CastingError: If legality fails or the player cannot pay\n419\t            *alternative_cost* (the card is rolled back to *from_zone*).\n420\t    \"\"\"\n421\t    # Ensure controller/owner are set.\n422\t    card.controller = player\n423\t    if card.owner is None:\n424\t        card.owner = player\n425\t\n426\t    # 1. can_cast legality.\n427\t    if not card.can_cast(game):\n428\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n429\t\n430\t    # 2. Locate the card in its source zone.\n431\t    source_zone_container = player.zones[from_zone]\n432\t    if not source_zone_container.contains(card):\n433\t        source_zone_container = None\n434\t        for p in game.players:\n435\t            z = p.zones[from_zone]\n436\t            if z.contains(card):\n437\t                source_zone_container = z\n438\t                break\n439\t    if source_zone_container is None or not source_zone_container.contains(card):\n440\t        raise CastingError(\n441\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n442\t        )\n443\t\n444\t    # Move card from source zone to the stack zone.\n445\t    stack_zone = player.zones[Zone.STACK]\n446\t    source_zone_container.remove(card)\n447\t    stack_zone.add(card)\n448\t\n449\t    # Clear stale colors_spent before new payment.\n450\t    if hasattr(card, \"colors_spent\"):\n451\t        del card.colors_spent\n452\t\n453\t    # 3. Choose targets (with rollback on failure).\n454\t    try:\n455\t        target_specs = card.get_targets(game)\n456\t        chosen_targets: list[Any] = []\n457\t        if target_specs:\n458\t            for spec in target_specs:\n459\t                target = player.choose_target(target_specs, spec)\n460\t                filter_fn = getattr(spec, \"filter_fn\", None)\n461\t                if filter_fn is not None and target is not None:\n462\t                    if not filter_fn(target):\n463\t                        raise CastingError(\n464\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n465\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n466\t                        )\n467\t                chosen_targets.append(target)\n468\t\n469\t        from engine.protection import has_protection_from\n470\t\n471\t        for target in chosen_targets:\n472\t            if has_protection_from(target, card):\n473\t                raise CastingError(\n474\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n475\t                )\n476\t    except Exception as exc:\n477\t        stack_zone.remove(card)\n478\t        source_zone_container.add(card)\n479\t        raise CastingError(str(exc)) from exc\n480\t\n481\t    # 4. Mana check / payment against the alternative cost (rollback on failure).\n482\t    if not player.mana_pool.can_pay(alternative_cost):\n483\t        stack_zone.remove(card)\n484\t        source_zone_container.add(card)\n485\t        raise CastingError(\n486\t            f\"Cannot cast {card.name!r} — insufficient mana for alternative cost\"\n487\t        )\n488\t\n489\t    player.mana_pool.pay(alternative_cost)\n490\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n491\t    card.mana_spent = alternative_cost.cmc  # type: ignore[attr-defined]\n492\t\n493\t    # 5. Call on_cast hook.\n494\t    card.on_cast(game)\n495\t\n496\t    # 6. Push StackObject.\n497\t    stack_obj = StackObject(\n498\t        source=card,\n499\t        controller=player,\n500\t        targets=chosen_targets,\n501\t        on_resolve=lambda g: None,  # replaced below\n502\t    )\n503\t\n504\t    def _on_resolve(g: GameState) -> None:\n505\t        _resolve_spell(g, card, player, stack_obj)\n506\t\n507\t    stack_obj.on_resolve = _on_resolve\n508\t    game.stack.push(stack_obj)\n509\t\n510\t\n511\t# ------------------------------------------------------------------\n512\t# Resolution (called when the stack pops)\n513\t# ------------------------------------------------------------------\n514\t\n515\tdef _resolve_spell(\n516\t    game: GameState,\n517\t    card: CardImpl,\n518\t    player: Player,\n519\t    stack_obj: StackObject,\n520\t) -> None:\n521\t    \"\"\"Resolve *card* cast by *player*.\n522\t\n523\t    1. Call ``card.on_resolve(game, targets=targets)``.\n524\t    2. Remove the card from the stack zone.\n525\t    3. If the card is a permanent type, move it to the battlefield via\n526\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n527\t       registration and the ETB event).\n528\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n529\t    \"\"\"\n530\t    from engine.zones import move_to_zone\n531\t\n532\t    # Read targets from the StackObject — the single source of truth.\n533\t    # Set chosen_targets on the card just before resolution so that\n534\t    # _get_chosen_target helpers (which read via getattr) work.\n535\t    targets = stack_obj.targets\n536\t    if targets is not None:\n537\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n538\t\n539\t    card.on_resolve(game)\n540\t\n541\t    if card.card_types & _PERMANENT_TYPES:\n542\t        # Move from stack to battlefield via move_to_zone, which handles\n543\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n544\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n545\t    else:\n546\t        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n547\t        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n548\t\n549\t\n550\t# ------------------------------------------------------------------\n551\t# Play land (special action — does not use the stack)\n552\t# ------------------------------------------------------------------\n553\t\n554\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n555\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n556\t\n557\t    Requirements (all must hold):\n558\t\n559\t    * *land_card* has :attr:`CardType.LAND`.\n560\t    * *player* is the active player.\n561\t    * Current phase is a main phase.\n562\t    * The stack is empty.\n563\t    * ``player.land_plays_remaining > 0``.\n564\t    * The card is in the player's hand.\n565\t\n566\t    On success the card moves from hand to battlefield and\n567\t    ``land_plays_remaining`` is decremented.\n568\t\n569\t    Raises:\n570\t        CastingError: If any requirement is not met.\n571\t    \"\"\"\n572\t    # Must be a land\n573\t    if CardType.LAND not in land_card.card_types:\n574\t        raise CastingError(\n575\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n576\t        )\n577\t\n578\t    # Sorcery-speed timing (active player, main phase, stack empty)\n579\t    if not is_sorcery_speed(game, player):\n580\t        raise CastingError(\n581\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n582\t            \"during main phase with empty stack\"\n583\t        )\n584\t\n585\t    # Land plays remaining\n586\t    if player.land_plays_remaining <= 0:\n587\t        raise CastingError(\n588\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n589\t        )\n590\t\n591\t    # Card must be in hand\n592\t    hand = game.get_hand(player)\n593\t    if not hand.contains(land_card):\n594\t        raise CastingError(\n595\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n596\t        )\n597\t\n598\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n599\t    if land_card.owner is None:\n600\t        land_card.owner = player\n601\t    land_card.controller = player\n602\t\n603\t    # Move from hand to battlefield via move_to_zone, which fires\n604\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n605\t    from engine.zones import move_to_zone\n606\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n607\t\n608\t    # Decrement land plays\n609\t    player.land_plays_remaining -= 1\n610\t\n611\t\n612\tdef resolve_top(game: GameState) -> None:\n613\t    \"\"\"Resolve the top spell/ability on the stack.\n614\t\n615\t    Pops the top item from the stack, calls its on_resolve callback,\n616\t    then runs state-based actions.  If the stack is empty this is a no-op.\n617\t    \"\"\"\n618\t    if game.stack.is_empty():\n619\t        return\n620\t    from engine.state_based_actions import resolve_state_based_actions\n621\t\n622\t    obj = game.stack.pop()\n623\t    obj.on_resolve(game)\n624\t    resolve_state_based_actions(game)\n625\t"}]},"parent_tool_use_id":"toolu_01HwcPhRpe1q2HYXdHiQNaBQ","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"0c361e9d-afbf-4c9f-9061-bbede8a60d10","timestamp":"2026-06-01T10:05:15.699Z","subagent_type":"Tester","task_description":"Extend sos_245 tests for registry"}
