{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QbuKywmdN6PtUcYEmsmgz4","type":"tool_result","content":"1\t\"\"\"Tests for SOS 226 — Silverquill, the Disputant.\n2\t\n3\tSilverquill, the Disputant is a {2}{W}{B} Legendary Creature — Elder Dragon,\n4\t4/4, with:\n5\t\n6\t1. **Flying** and **Vigilance** keywords.\n7\t2. A static ability: \"Each instant and sorcery spell you cast has casualty 1.\n8\t   (As you cast that spell, you may sacrifice a creature with power 1 or\n9\t   greater. When you do, copy the spell and you may choose new targets for the\n10\t   copy.)\"\n11\t\n12\tThe Flying/Vigilance and static-data requirements are verified with hard\n13\tassertions. The casualty-granting ability is modeled by the implementation as a\n14\tpublic helper the casting machinery (or a test) can drive, because the base\n15\tcasting pipeline (``engine/casting.py``) has no casualty hook. We assert against\n16\tthat helper's observable contract:\n17\t\n18\t* a casualty value of 1 is advertised,\n19\t* only the controller's instant / sorcery spells qualify (creatures and the\n20\t  opponent's spells do not),\n21\t* a creature with power >= 1 is a legal casualty sacrifice (power 0 is not),\n22\t* applying casualty sacrifices the chosen creature AND puts a copy of the spell\n23\t  on the stack (optionally with new targets).\n24\t\n25\tThe deep \"as you cast that spell\" pipeline integration is recorded in\n26\t``untestable.json`` where the engine offers no surface to drive it.\n27\t\n28\t``card_impl.py`` is a stub, so every test here is expected to FAIL until the\n29\tcard is implemented (TDD red phase).\n30\t\"\"\"\n31\t\n32\tfrom __future__ import annotations\n33\t\n34\tfrom typing import Any\n35\t\n36\tfrom cards.sos.sos_226.card_impl import SilverquillTheDisputant\n37\tfrom engine.card import Creature, Instant, Sorcery\n38\tfrom engine.stack import StackObject\n39\tfrom engine.types import (\n40\t    CardType,\n41\t    Color,\n42\t    Keyword,\n43\t    ManaCost,\n44\t    Supertype,\n45\t)\n46\tfrom test_utils import create_game, set_board_state\n47\t\n48\t\n49\t# ---------------------------------------------------------------------------\n50\t# Helpers\n51\t# ---------------------------------------------------------------------------\n52\t\n53\t\n54\tdef _instant(name: str = \"Test Instant\", controller: Any = None) -> Instant:\n55\t    \"\"\"A vanilla instant card with a nonzero mana cost.\"\"\"\n56\t    spell = Instant(name=name, mana_cost=ManaCost.parse(\"{1}{U}\"))\n57\t    if controller is not None:\n58\t        spell.controller = controller\n59\t        spell.owner = controller\n60\t    return spell\n61\t\n62\t\n63\tdef _sorcery(name: str = \"Test Sorcery\", controller: Any = None) -> Sorcery:\n64\t    \"\"\"A vanilla sorcery card with a nonzero mana cost.\"\"\"\n65\t    spell = Sorcery(name=name, mana_cost=ManaCost.parse(\"{2}{R}\"))\n66\t    if controller is not None:\n67\t        spell.controller = controller\n68\t        spell.owner = controller\n69\t    return spell\n70\t\n71\t\n72\tdef _creature(name: str = \"Grizzly Bears\", power: int = 2, controller: Any = None) -> Creature:\n73\t    c = Creature(name=name, base_power=power, base_toughness=2)\n74\t    c.card_types = {CardType.CREATURE}\n75\t    if controller is not None:\n76\t        c.controller = controller\n77\t        c.owner = controller\n78\t    return c\n79\t\n80\t\n81\tdef _spell_stack_object(spell: Any, controller: Any) -> StackObject:\n82\t    \"\"\"Wrap *spell* in a StackObject controlled by *controller*.\"\"\"\n83\t    return StackObject(source=spell, controller=controller, targets=[])\n84\t\n85\t\n86\t# ---------------------------------------------------------------------------\n87\t# Static card data\n88\t# ---------------------------------------------------------------------------\n89\t\n90\t\n91\tclass TestSilverquillProperties:\n92\t    \"\"\"Static card data should match the SOS 226 spec.\"\"\"\n93\t\n94\t    def test_is_creature(self) -> None:\n95\t        assert isinstance(SilverquillTheDisputant(owner=None), Creature)\n96\t\n97\t    def test_name(self) -> None:\n98\t        assert SilverquillTheDisputant(owner=None).name == \"Silverquill, the Disputant\"\n99\t\n100\t    def test_mana_cost(self) -> None:\n101\t        assert SilverquillTheDisputant(owner=None).mana_cost == ManaCost.parse(\"{2}{W}{B}\")\n102\t\n103\t    def test_power_toughness(self) -> None:\n104\t        card = SilverquillTheDisputant(owner=None)\n105\t        assert card.base_power == 4\n106\t        assert card.base_toughness == 4\n107\t\n108\t    def test_is_legendary(self) -> None:\n109\t        assert Supertype.LEGENDARY in SilverquillTheDisputant(owner=None).supertypes\n110\t\n111\t    def test_is_elder_dragon(self) -> None:\n112\t        subtypes = SilverquillTheDisputant(owner=None).subtypes\n113\t        assert {\"Elder\", \"Dragon\"} <= subtypes\n114\t\n115\t    def test_has_flying(self) -> None:\n116\t        assert Keyword.FLYING in SilverquillTheDisputant(owner=None).keywords\n117\t\n118\t    def test_has_vigilance(self) -> None:\n119\t        assert Keyword.VIGILANCE in SilverquillTheDisputant(owner=None).keywords\n120\t\n121\t    def test_colors_are_white_and_black(self) -> None:\n122\t        card = SilverquillTheDisputant(owner=None)\n123\t        assert card.colors == {Color.WHITE, Color.BLACK}\n124\t\n125\t\n126\t# ---------------------------------------------------------------------------\n127\t# Casualty value\n128\t# ---------------------------------------------------------------------------\n129\t\n130\t\n131\tclass TestSilverquillCasualtyValue:\n132\t    \"\"\"The granted ability is casualty 1 (sacrifice one creature, one copy).\"\"\"\n133\t\n134\t    def test_casualty_value_is_one(self) -> None:\n135\t        card = SilverquillTheDisputant(owner=None)\n136\t        assert getattr(card, \"casualty_value\", None) == 1\n137\t\n138\t\n139\t# ---------------------------------------------------------------------------\n140\t# Which spells get casualty (scope of \"instant and sorcery spell you cast\")\n141\t# ---------------------------------------------------------------------------\n142\t\n143\t\n144\tclass TestSilverquillCasualtyScope:\n145\t    \"\"\"Casualty is granted only to the controller's instant & sorcery spells.\"\"\"\n146\t\n147\t    def test_your_instant_qualifies(self) -> None:\n148\t        game = create_game()\n149\t        p1 = game.players[0]\n150\t        card = SilverquillTheDisputant(owner=p1, controller=p1)\n151\t        set_board_state(game, 0, battlefield=[card])\n152\t        spell = _instant(controller=p1)\n153\t        assert card.grants_casualty_to(game, spell) is True\n154\t\n155\t    def test_your_sorcery_qualifies(self) -> None:\n156\t        game = create_game()\n157\t        p1 = game.players[0]\n158\t        card = SilverquillTheDisputant(owner=p1, controller=p1)\n159\t        set_board_state(game, 0, battlefield=[card])\n160\t        spell = _sorcery(controller=p1)\n161\t        assert card.grants_casualty_to(game, spell) is True\n162\t\n163\t    def test_your_creature_spell_does_not_qualify(self) -> None:\n164\t        \"\"\"A creature spell is neither instant nor sorcery — no casualty.\"\"\"\n165\t        game = create_game()\n166\t        p1 = game.players[0]\n167\t        card = SilverquillTheDisputant(owner=p1, controller=p1)\n168\t        set_board_state(game, 0, battlefield=[card])\n169\t        creature_spell = _creature(controller=p1)\n170\t        assert card.grants_casualty_to(game, creature_spell) is False\n171\t\n172\t    def test_opponent_instant_does_not_qualify(self) -> None:\n173\t        \"\"\"Only spells *you* cast get casualty; an opponent's instant doesn't.\"\"\"\n174\t        game = create_game()\n175\t        p1 = game.players[0]\n176\t        p2 = game.players[1]\n177\t        card = SilverquillTheDisputant(owner=p1, controller=p1)\n178\t        set_board_state(game, 0, battlefield=[card])\n179\t        opp_spell = _instant(controller=p2)\n180\t        assert card.grants_casualty_to(game, opp_spell) is False\n181\t\n182\t\n183\t# ---------------------------------------------------------------------------\n184\t# Casualty sacrifice legality (power 1 or greater)\n185\t# ---------------------------------------------------------------------------\n186\t\n187\t\n188\tclass TestSilverquillCasualtySacrificeLegality:\n189\t    \"\"\"A creature you control with power >= 1 may be sacrificed for casualty.\"\"\"\n190\t\n191\t    def test_power_two_creature_is_legal_sacrifice(self) -> None:\n192\t        card = SilverquillTheDisputant(owner=None)\n193\t        assert card.is_valid_casualty_sacrifice(_creature(power=2)) is True\n194\t\n195\t    def test_power_one_creature_is_legal_sacrifice(self) -> None:\n196\t        card = SilverquillTheDisputant(owner=None)\n197\t        assert card.is_valid_casualty_sacrifice(_creature(power=1)) is True\n198\t\n199\t    def test_power_zero_creature_is_not_legal_sacrifice(self) -> None:\n200\t        card = SilverquillTheDisputant(owner=None)\n201\t        assert card.is_valid_casualty_sacrifice(_creature(name=\"Wall\", power=0)) is False\n202\t\n203\t    def test_noncreature_is_not_legal_sacrifice(self) -> None:\n204\t        \"\"\"A non-creature permanent cannot be sacrificed for casualty.\"\"\"\n205\t        from engine.card import Enchantment\n206\t\n207\t        card = SilverquillTheDisputant(owner=None)\n208\t        ench = Enchantment(name=\"Pacifism\")\n209\t        assert card.is_valid_casualty_sacrifice(ench) is False\n210\t\n211\t\n212\t# ---------------------------------------------------------------------------\n213\t# Applying casualty: sacrifice + copy the spell\n214\t# ---------------------------------------------------------------------------\n215\t\n216\t\n217\tclass TestSilverquillCasualtyResolution:\n218\t    \"\"\"Paying casualty sacrifices the creature and copies the spell.\"\"\"\n219\t\n220\t    def test_sacrifice_moves_creature_to_graveyard(self) -> None:\n221\t        game = create_game()\n222\t        p1 = game.players[0]\n223\t        card = SilverquillTheDisputant(owner=p1, controller=p1)\n224\t        fodder = _creature(name=\"Fodder\", power=1, controller=p1)\n225\t        set_board_state(game, 0, battlefield=[card, fodder])\n226\t\n227\t        spell = _instant(controller=p1)\n228\t        stack_obj = _spell_stack_object(spell, p1)\n229\t        game.stack.push(stack_obj)\n230\t\n231\t        card.apply_casualty(game, stack_obj, fodder)\n232\t\n233\t        # The sacrificed creature leaves the battlefield for the graveyard.\n234\t        assert not game.get_battlefield(p1).contains(fodder)\n235\t        assert game.get_graveyard(p1).contains(fodder)\n236\t\n237\t    def test_copy_is_added_to_the_stack(self) -> None:\n238\t        game = create_game()\n239\t        p1 = game.players[0]\n240\t        card = SilverquillTheDisputant(owner=p1, controller=p1)\n241\t        fodder = _creature(name=\"Fodder\", power=1, controller=p1)\n242\t        set_board_state(game, 0, battlefield=[card, fodder])\n243\t\n244\t        spell = _instant(controller=p1)\n245\t        stack_obj = _spell_stack_object(spell, p1)\n246\t        game.stack.push(stack_obj)\n247\t        before = len(game.stack)\n248\t\n249\t        card.apply_casualty(game, stack_obj, fodder)\n250\t\n251\t        # Casualty 1 places exactly one copy of the spell on the stack.\n252\t        assert len(game.stack) == before + 1\n253\t\n254\t    def test_copy_is_a_distinct_object_from_original(self) -> None:\n255\t        \"\"\"The copy must be an independent stack object, not the original.\"\"\"\n256\t        game = create_game()\n257\t        p1 = game.players[0]\n258\t        card = SilverquillTheDisputant(owner=p1, controller=p1)\n259\t        fodder = _creature(name=\"Fodder\", power=1, controller=p1)\n260\t        set_board_state(game, 0, battlefield=[card, fodder])\n261\t\n262\t        spell = _instant(controller=p1)\n263\t        stack_obj = _spell_stack_object(spell, p1)\n264\t        game.stack.push(stack_obj)\n265\t\n266\t        card.apply_casualty(game, stack_obj, fodder)\n267\t\n268\t        top = game.stack.peek()\n269\t        assert top is not stack_obj\n270\t        # The copy reproduces the same underlying spell (by name), as a\n271\t        # separate source object.\n272\t        assert top.source is not spell\n273\t        assert getattr(top.source, \"name\", None) == spell.name\n274\t\n275\t    def test_copy_can_choose_new_targets(self) -> None:\n276\t        \"\"\"\"you may choose new targets for the copy\" — when new targets are\n277\t        supplied, the copy carries them rather than the original's targets.\"\"\"\n278\t        game = create_game()\n279\t        p1 = game.players[0]\n280\t        p2 = game.players[1]\n281\t        card = SilverquillTheDisputant(owner=p1, controller=p1)\n282\t        fodder = _creature(name=\"Fodder\", power=1, controller=p1)\n283\t        original_target = _creature(name=\"OrigTarget\", controller=p2)\n284\t        new_target = _creature(name=\"NewTarget\", controller=p2)\n285\t        set_board_state(game, 0, battlefield=[card, fodder])\n286\t        set_board_state(game, 1, battlefield=[original_target, new_target])\n287\t\n288\t        spell = _instant(controller=p1)\n289\t        stack_obj = _spell_stack_object(spell, p1)\n290\t        stack_obj.targets = [original_target]\n291\t        game.stack.push(stack_obj)\n292\t\n293\t        card.apply_casualty(game, stack_obj, fodder, new_targets=[new_target])\n294\t\n295\t        top = game.stack.peek()\n296\t        assert top.targets == [new_target]\n297\t\n298\t    def test_copy_controlled_by_caster(self) -> None:\n299\t        \"\"\"The copy is controlled by the spell's controller (you).\"\"\"\n300\t        game = create_game()\n301\t        p1 = game.players[0]\n302\t        card = SilverquillTheDisputant(owner=p1, controller=p1)\n303\t        fodder = _creature(name=\"Fodder\", power=1, controller=p1)\n304\t        set_board_state(game, 0, battlefield=[card, fodder])\n305\t\n306\t        spell = _sorcery(controller=p1)\n307\t        stack_obj = _spell_stack_object(spell, p1)\n308\t        game.stack.push(stack_obj)\n309\t\n310\t        card.apply_casualty(game, stack_obj, fodder)\n311\t\n312\t        top = game.stack.peek()\n313\t        assert top.controller is p1\n314\t"}]},"parent_tool_use_id":"toolu_01XTP7k3qVx6bF6TgihrKkLV","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"facc5654-3046-4c26-a5a2-1ff1ce02e597","timestamp":"2026-06-01T09:51:54.909Z","subagent_type":"Implementer","task_description":"Implement sos_226"}
