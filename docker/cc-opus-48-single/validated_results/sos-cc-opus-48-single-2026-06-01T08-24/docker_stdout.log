{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015a2BUdo91hAThwwAjaUw9D","type":"tool_result","content":"1\t\"\"\"Tests for SOS 245 — Witherbloom, the Balancer.\n2\t\n3\tWitherbloom, the Balancer is a {6}{B}{G} Legendary Creature — Elder Dragon,\n4\t5/5, with:\n5\t\n6\t1. **Affinity for creatures** — \"This spell costs {1} less to cast for each\n7\t   creature you control.\" Modeled via the ``cost_reduction(game)`` hook (only\n8\t   the generic portion of the cost is reduced; the {B}{G} pips never are).\n9\t2. **Flying** and **Deathtouch** keywords.\n10\t3. **Granted affinity** — \"Instant and sorcery spells you cast have affinity\n11\t   for creatures.\" The engine has no central cost-reduction registry, so (as\n12\t   with FDN 159's analogous \"cost {1} less\" clause) the granting is modeled via\n13\t   a marker the casting system can consult. These tests assert what is\n14\t   observable; the granting plumbing is recorded in untestable.json.\n15\t\n16\tThese tests define the TDD contract; ``card_impl.py`` is a stub, so they are\n17\texpected to fail until the card is implemented.\n18\t\"\"\"\n19\t\n20\tfrom __future__ import annotations\n21\t\n22\tfrom cards.sos.sos_245.card_impl import WitherbloomTheBalancer\n23\tfrom engine.card import Creature\n24\tfrom engine.combat import _can_block, _get_lethal_damage\n25\tfrom engine.types import (\n26\t    CardType,\n27\t    Keyword,\n28\t    ManaCost,\n29\t    ManaType,\n30\t    Phase,\n31\t    Supertype,\n32\t    Zone,\n33\t)\n34\tfrom test_utils import create_game, set_board_state\n35\t\n36\t\n37\t# ---------------------------------------------------------------------------\n38\t# Helpers\n39\t# ---------------------------------------------------------------------------\n40\t\n41\t\n42\tdef _bear(name: str = \"Grizzly Bears\") -> Creature:\n43\t    \"\"\"A vanilla 2/2 creature with no keywords.\"\"\"\n44\t    c = Creature(name=name, base_power=2, base_toughness=2)\n45\t    c.card_types = {CardType.CREATURE}\n46\t    c.keywords = Keyword(0)\n47\t    return c\n48\t\n49\t\n50\t# ---------------------------------------------------------------------------\n51\t# Static card data\n52\t# ---------------------------------------------------------------------------\n53\t\n54\t\n55\tclass TestWitherbloomProperties:\n56\t    \"\"\"Static card data should match the SOS 245 spec.\"\"\"\n57\t\n58\t    def test_is_creature(self) -> None:\n59\t        assert isinstance(WitherbloomTheBalancer(owner=None), Creature)\n60\t        assert CardType.CREATURE in WitherbloomTheBalancer(owner=None).card_types\n61\t\n62\t    def test_name(self) -> None:\n63\t        assert WitherbloomTheBalancer(owner=None).name == \"Witherbloom, the Balancer\"\n64\t\n65\t    def test_mana_cost(self) -> None:\n66\t        assert WitherbloomTheBalancer(owner=None).mana_cost == ManaCost.parse(\"{6}{B}{G}\")\n67\t\n68\t    def test_power_toughness(self) -> None:\n69\t        card = WitherbloomTheBalancer(owner=None)\n70\t        assert card.base_power == 5\n71\t        assert card.base_toughness == 5\n72\t\n73\t    def test_is_legendary(self) -> None:\n74\t        assert Supertype.LEGENDARY in WitherbloomTheBalancer(owner=None).supertypes\n75\t\n76\t    def test_is_elder_dragon(self) -> None:\n77\t        subtypes = WitherbloomTheBalancer(owner=None).subtypes\n78\t        assert \"Dragon\" in subtypes\n79\t        assert \"Elder\" in subtypes\n80\t\n81\t\n82\t# ---------------------------------------------------------------------------\n83\t# Keywords (printed)\n84\t# ---------------------------------------------------------------------------\n85\t\n86\t\n87\tclass TestWitherbloomKeywords:\n88\t    \"\"\"Flying and Deathtouch are printed on the card.\"\"\"\n89\t\n90\t    def test_has_flying(self) -> None:\n91\t        assert Keyword.FLYING in WitherbloomTheBalancer(owner=None).keywords\n92\t\n93\t    def test_has_deathtouch(self) -> None:\n94\t        assert Keyword.DEATHTOUCH in WitherbloomTheBalancer(owner=None).keywords\n95\t\n96\t    def test_does_not_have_unrelated_keyword(self) -> None:\n97\t        # Sanity: it should not pick up keywords it doesn't have.\n98\t        assert Keyword.TRAMPLE not in WitherbloomTheBalancer(owner=None).keywords\n99\t\n100\t\n101\t# ---------------------------------------------------------------------------\n102\t# Affinity for creatures (cost reduction on its own cast)\n103\t# ---------------------------------------------------------------------------\n104\t\n105\t\n106\tclass TestWitherbloomAffinity:\n107\t    \"\"\"cost_reduction reduces generic mana by 1 per creature you control.\"\"\"\n108\t\n109\t    def test_no_creatures_no_reduction(self) -> None:\n110\t        game = create_game()\n111\t        p1 = game.players[0]\n112\t        card = WitherbloomTheBalancer(owner=p1, controller=p1)\n113\t        assert card.cost_reduction(game) == 0\n114\t\n115\t    def test_reduction_equals_creature_count(self) -> None:\n116\t        game = create_game()\n117\t        p1 = game.players[0]\n118\t        set_board_state(game, 0, battlefield=[_bear(\"A\"), _bear(\"B\"), _bear(\"C\")])\n119\t        card = WitherbloomTheBalancer(owner=p1, controller=p1)\n120\t        assert card.cost_reduction(game) == 3\n121\t\n122\t    def test_self_counts_when_on_battlefield_does_not_inflate(self) -> None:\n123\t        \"\"\"Reduction counts creatures the controller controls; with exactly\n124\t        two other creatures the reduction is 2.\"\"\"\n125\t        game = create_game()\n126\t        p1 = game.players[0]\n127\t        set_board_state(game, 0, battlefield=[_bear(\"A\"), _bear(\"B\")])\n128\t        card = WitherbloomTheBalancer(owner=p1, controller=p1)\n129\t        assert card.cost_reduction(game) == 2\n130\t\n131\t    def test_only_counts_creatures(self) -> None:\n132\t        \"\"\"Non-creature permanents do not contribute to affinity for creatures.\"\"\"\n133\t        from engine.card import Artifact, Enchantment\n134\t\n135\t        game = create_game()\n136\t        p1 = game.players[0]\n137\t        artifact = Artifact(name=\"Mind Stone\")\n138\t        enchantment = Enchantment(name=\"Random Aura\")\n139\t        set_board_state(game, 0, battlefield=[_bear(\"A\"), artifact, enchantment])\n140\t        card = WitherbloomTheBalancer(owner=p1, controller=p1)\n141\t        assert card.cost_reduction(game) == 1\n142\t\n143\t    def test_only_counts_your_creatures(self) -> None:\n144\t        \"\"\"Opponent's creatures do not reduce the cost.\"\"\"\n145\t        game = create_game()\n146\t        p1 = game.players[0]\n147\t        set_board_state(game, 0, battlefield=[_bear(\"Mine A\"), _bear(\"Mine B\")])\n148\t        set_board_state(game, 1, battlefield=[_bear(\"Theirs A\"), _bear(\"Theirs B\"),\n149\t                                              _bear(\"Theirs C\")])\n150\t        card = WitherbloomTheBalancer(owner=p1, controller=p1)\n151\t        assert card.cost_reduction(game) == 2\n152\t\n153\t    def test_reduction_clamped_to_generic_via_pipeline(self) -> None:\n154\t        \"\"\"Even with many creatures, only the {6} generic is reducible — the\n155\t        {B}{G} pips remain. get_cost_reduction clamps the raw value to 6.\"\"\"\n156\t        from engine.casting import get_cost_reduction\n157\t\n158\t        game = create_game()\n159\t        p1 = game.players[0]\n160\t        set_board_state(game, 0, battlefield=[_bear(f\"Bear{i}\") for i in range(9)])\n161\t        card = WitherbloomTheBalancer(owner=p1, controller=p1)\n162\t        # Raw cost_reduction is 9, but clamped to the {6} generic.\n163\t        assert get_cost_reduction(game, card, p1) == 6\n164\t\n165\t\n166\t# ---------------------------------------------------------------------------\n167\t# Casting with affinity (integration through the cast pipeline)\n168\t# ---------------------------------------------------------------------------\n169\t\n170\t\n171\tclass TestWitherbloomCastingWithAffinity:\n172\t    \"\"\"The reduced cost is what the cast pipeline charges.\"\"\"\n173\t\n174\t    def test_cast_with_three_creatures_pays_reduced_generic(self) -> None:\n175\t        \"\"\"With 3 creatures, {6}{B}{G} → {3}{B}{G}. Player with 3 generic +\n176\t        B + G casts successfully and the spell hits the stack.\"\"\"\n177\t        from engine.casting import cast_spell\n178\t\n179\t        game = create_game()\n180\t        p1 = game.players[0]\n181\t        game.active_player_index = 0\n182\t        game.priority_player_index = 0\n183\t        # Witherbloom is a (non-flash) creature, so it can only be cast at\n184\t        # sorcery speed. create_game() starts in Phase.BEGINNING, where the\n185\t        # cast would be rejected; move to a main phase first.\n186\t        game.phase = Phase.PRECOMBAT_MAIN\n187\t        game.step = None\n188\t        set_board_state(game, 0, battlefield=[_bear(\"A\"), _bear(\"B\"), _bear(\"C\")])\n189\t\n190\t        card = WitherbloomTheBalancer(owner=p1, controller=p1)\n191\t        game.get_hand(p1).add(card)\n192\t        set_board_state(\n193\t            game,\n194\t            0,\n195\t            mana={ManaType.COLORLESS: 3, ManaType.BLACK: 1, ManaType.GREEN: 1},\n196\t        )\n197\t\n198\t        cast_spell(game, p1, card)\n199\t        assert not game.stack.is_empty()\n200\t\n201\t    def test_cast_without_enough_mana_for_reduced_cost_fails(self) -> None:\n202\t        \"\"\"With only 1 creature the reduction is just 1; {5}{B}{G} cannot be\n203\t        paid with {3}{B}{G} worth of mana.\"\"\"\n204\t        import pytest\n205\t        from engine.casting import cast_spell, CastingError\n206\t\n207\t        game = create_game()\n208\t        p1 = game.players[0]\n209\t        game.active_player_index = 0\n210\t        game.priority_player_index = 0\n211\t        set_board_state(game, 0, battlefield=[_bear(\"A\")])\n212\t\n213\t        card = WitherbloomTheBalancer(owner=p1, controller=p1)\n214\t        game.get_hand(p1).add(card)\n215\t        set_board_state(\n216\t            game,\n217\t            0,\n218\t            mana={ManaType.COLORLESS: 3, ManaType.BLACK: 1, ManaType.GREEN: 1},\n219\t        )\n220\t\n221\t        with pytest.raises(CastingError):\n222\t            cast_spell(game, p1, card)\n223\t\n224\t    def test_colored_pips_never_reduced(self) -> None:\n225\t        \"\"\"Affinity cannot pay the {B}{G}: with 8 creatures and only colorless\n226\t        mana, the cast fails because the colored pips remain unpaid.\"\"\"\n227\t        import pytest\n228\t        from engine.casting import cast_spell, CastingError\n229\t\n230\t        game = create_game()\n231\t        p1 = game.players[0]\n232\t        game.active_player_index = 0\n233\t        game.priority_player_index = 0\n234\t        set_board_state(game, 0, battlefield=[_bear(f\"B{i}\") for i in range(8)])\n235\t\n236\t        card = WitherbloomTheBalancer(owner=p1, controller=p1)\n237\t        game.get_hand(p1).add(card)\n238\t        # Plenty of colorless, but no black/green for the pips.\n239\t        set_board_state(game, 0, mana={ManaType.COLORLESS: 10})\n240\t\n241\t        with pytest.raises(CastingError):\n242\t            cast_spell(game, p1, card)\n243\t\n244\t\n245\t# ---------------------------------------------------------------------------\n246\t# Flying — combat blocking restriction\n247\t# ---------------------------------------------------------------------------\n248\t\n249\t\n250\tclass TestWitherbloomFlying:\n251\t    \"\"\"Flying restricts which creatures can legally block this attacker.\"\"\"\n252\t\n253\t    def test_ground_creature_cannot_block(self) -> None:\n254\t        attacker = WitherbloomTheBalancer(owner=None)\n255\t        blocker = _bear(\"Ground\")\n256\t        assert _can_block(blocker, attacker) is False\n257\t\n258\t    def test_flying_blocker_can_block(self) -> None:\n259\t        attacker = WitherbloomTheBalancer(owner=None)\n260\t        blocker = _bear(\"Air\")\n261\t        blocker.keywords = Keyword.FLYING\n262\t        assert _can_block(blocker, attacker) is True\n263\t\n264\t    def test_reach_blocker_can_block(self) -> None:\n265\t        attacker = WitherbloomTheBalancer(owner=None)\n266\t        blocker = _bear(\"Spider\")\n267\t        blocker.keywords = Keyword.REACH\n268\t        assert _can_block(blocker, attacker) is True\n269\t\n270\t\n271\t# ---------------------------------------------------------------------------\n272\t# Deathtouch — lethal damage\n273\t# ---------------------------------------------------------------------------\n274\t\n275\t\n276\tclass TestWitherbloomDeathtouch:\n277\t    \"\"\"Deathtouch makes any nonzero damage from Witherbloom lethal.\"\"\"\n278\t\n279\t    def test_one_damage_is_lethal_against_high_toughness(self) -> None:\n280\t        attacker = WitherbloomTheBalancer(owner=None)\n281\t        big = _bear(\"Big Wall\")\n282\t        big.modified_toughness = 10\n283\t        # With deathtouch, only 1 damage is needed to be lethal.\n284\t        assert _get_lethal_damage(big, attacker) == 1\n285\t\n286\t    def test_without_deathtouch_lethal_is_toughness(self) -> None:\n287\t        \"\"\"Control: a non-deathtouch attacker needs full toughness in damage.\"\"\"\n288\t        plain = _bear(\"Plain\")\n289\t        big = _bear(\"Big Wall\")\n290\t        big.modified_toughness = 10\n291\t        assert _get_lethal_damage(big, plain) == 10\n292\t\n293\t\n294\t# ---------------------------------------------------------------------------\n295\t# Granted affinity to instants/sorceries (best-effort observable contract)\n296\t# ---------------------------------------------------------------------------\n297\t\n298\t\n299\tclass TestWitherbloomGrantsAffinity:\n300\t    \"\"\"\"Instant and sorcery spells you cast have affinity for creatures.\"\n301\t\n302\t    The engine has no central cost-reduction registry (see FDN 159), so the\n303\t    grant is exercised here only at the level the engine can observe:\n304\t    register_triggers/register_replacement_effects must not raise, and any\n305\t    marker the card sets must reference its controller. The actual cost\n306\t    reduction of *other* spells is recorded in untestable.json.\n307\t    \"\"\"\n308\t\n309\t    def test_register_triggers_does_not_raise(self) -> None:\n310\t        game = create_game()\n311\t        p1 = game.players[0]\n312\t        card = WitherbloomTheBalancer(owner=p1, controller=p1)\n313\t        # Must not raise when wiring up the granted-affinity machinery.\n314\t        card.register_triggers(game)\n315\t\n316\t    def test_card_advertises_no_spell_targets(self) -> None:\n317\t        \"\"\"Witherbloom is a vanilla-cast permanent (its abilities are static),\n318\t        so get_targets must be empty — casting it must not demand a target.\"\"\"\n319\t        game = create_game()\n320\t        p1 = game.players[0]\n321\t        card = WitherbloomTheBalancer(owner=p1, controller=p1)\n322\t        assert card.get_targets(game) == []\n323\t\n324\t\n325\t# ---------------------------------------------------------------------------\n326\t# Granted affinity — cost-reduction registry (engine now BUILT)\n327\t# ---------------------------------------------------------------------------\n328\t#\n329\t# \"Instant and sorcery spells you cast have affinity for creatures.\" The\n330\t# engine now exposes a game-level cost-reduction registry\n331\t# (GameState.spell_cost_reducers + register/unregister/\n332\t# spell_cost_reduction_from_reducers), summed by\n333\t# engine.casting.get_cost_reduction alongside each spell's own\n334\t# cost_reduction() hook. Witherbloom registers a reducer (in register_triggers)\n335\t# that grants affinity-for-creatures to its controller's OTHER instant/sorcery\n336\t# spells while it is on the battlefield. These tests exercise that grant on a\n337\t# SEPARATE spell — the behavior previously recorded in untestable.json.\n338\t\n339\t\n340\tdef _test_instant(name: str = \"Test Bolt\", generic: int = 4, color: str = \"R\"):\n341\t    \"\"\"A vanilla instant with a generic-heavy cost (default ``{4}{R}``).\n342\t\n343\t    Used as the *other* instant/sorcery spell whose cost Witherbloom's granted\n344\t    affinity should reduce. Kept deliberately simple — no abilities, no\n345\t    cost_reduction() hook of its own — so any reduction observed comes purely\n346\t    from the registry.\n347\t    \"\"\"\n348\t    from engine.card import Instant\n349\t    from engine.types import ManaCost\n350\t\n351\t    return Instant(name=name, mana_cost=ManaCost.parse(f\"{{{generic}}}{{{color}}}\"))\n352\t\n353\t\n354\tdef _test_sorcery(name: str = \"Test Bolt Sorcery\", generic: int = 4, color: str = \"R\"):\n355\t    \"\"\"A vanilla sorcery counterpart to :func:`_test_instant`.\"\"\"\n356\t    from engine.card import Sorcery\n357\t    from engine.types import ManaCost\n358\t\n359\t    return Sorcery(name=name, mana_cost=ManaCost.parse(f\"{{{generic}}}{{{color}}}\"))\n360\t\n361\t\n362\tdef _witherbloom_on_battlefield(game, player, *, creatures):\n363\t    \"\"\"Put Witherbloom + *creatures* on *player*'s battlefield and wire up the\n364\t    granted-affinity reducer.\n365\t\n366\t    ``set_board_state`` drops cards straight into the zone without firing the\n367\t    normal ETB plumbing, so the reducer Witherbloom registers in\n368\t    ``register_triggers`` must be activated explicitly here — mirroring what\n369\t    ``move_to_zone`` does when a permanent actually enters the battlefield.\n370\t    \"\"\"\n371\t    wb = WitherbloomTheBalancer(owner=player, controller=player)\n372\t    set_board_state(\n373\t        game,\n374\t        game.players.index(player),\n375\t        battlefield=[wb] + list(creatures),\n376\t    )\n377\t    wb.register_triggers(game)\n378\t    return wb\n379\t\n380\t\n381\tclass TestWitherbloomGrantsAffinityRegistry:\n382\t    \"\"\"Granted affinity reduces the controller's OTHER instant/sorcery spells\n383\t    via the engine's spell cost-reduction registry.\"\"\"\n384\t\n385\t    def test_separate_instant_reduced_by_creature_count(self) -> None:\n386\t        \"\"\"With Witherbloom + 3 bears on the battlefield, a separate {6}{R}\n387\t        instant the controller casts has its generic reduced by 4 — the bears\n388\t        AND Witherbloom itself all count as creatures you control.\"\"\"\n389\t        from engine.casting import get_cost_reduction\n390\t\n391\t        game = create_game()\n392\t        p1 = game.players[0]\n393\t        game.phase = Phase.PRECOMBAT_MAIN\n394\t        game.step = None\n395\t        bears = [_bear(\"A\"), _bear(\"B\"), _bear(\"C\")]\n396\t        _witherbloom_on_battlefield(game, p1, creatures=bears)\n397\t\n398\t        bolt = _test_instant(generic=6)\n399\t        bolt.controller = p1\n400\t        bolt.owner = p1\n401\t        # 3 bears + Witherbloom = 4 creatures -> generic reduced by 4\n402\t        # (within the {6} generic, no clamp).\n403\t        assert get_cost_reduction(game, bolt, p1) == 4\n404\t\n405\t    def test_separate_sorcery_reduced_by_creature_count(self) -> None:\n406\t        \"\"\"The grant applies to sorceries too, not just instants.\"\"\"\n407\t        from engine.casting import get_cost_reduction\n408\t\n409\t        game = create_game()\n410\t        p1 = game.players[0]\n411\t        game.phase = Phase.PRECOMBAT_MAIN\n412\t        game.step = None\n413\t        bears = [_bear(\"A\"), _bear(\"B\")]\n414\t        _witherbloom_on_battlefield(game, p1, creatures=bears)\n415\t\n416\t        sorc = _test_sorcery(generic=6)\n417\t        sorc.controller = p1\n418\t        sorc.owner = p1\n419\t        # 2 bears + Witherbloom = 3 creatures -> reduction 3.\n420\t        assert get_cost_reduction(game, sorc, p1) == 3\n421\t\n422\t    def test_reduction_tracks_creature_count_changes(self) -> None:\n423\t        \"\"\"The granted affinity scales with the controller's creature count:\n424\t        adding a creature increases the reduction.\"\"\"\n425\t        from engine.casting import get_cost_reduction\n426\t\n427\t        game = create_game()\n428\t        p1 = game.players[0]\n429\t        game.phase = Phase.PRECOMBAT_MAIN\n430\t        game.step = None\n431\t        wb = _witherbloom_on_battlefield(game, p1, creatures=[_bear(\"A\")])\n432\t\n433\t        bolt = _test_instant(generic=6)\n434\t        bolt.controller = p1\n435\t        bolt.owner = p1\n436\t        # 1 bear + Witherbloom = 2 creatures -> reduction 2.\n437\t        assert get_cost_reduction(game, bolt, p1) == 2\n438\t\n439\t        # Add two more bears alongside Witherbloom; 3 bears + Witherbloom = 4.\n440\t        set_board_state(game, 0, battlefield=[wb, _bear(\"A\"), _bear(\"B\"), _bear(\"C\")])\n441\t        assert get_cost_reduction(game, bolt, p1) == 4\n442\t\n443\t    def test_clamped_when_creature_count_exceeds_generic(self) -> None:\n444\t        \"\"\"Affinity reduces only the generic — with 6 creatures a {2}{R} spell\n445\t        drops to {0}{R} (clamped at 0), never below.\"\"\"\n446\t        from engine.casting import get_cost_reduction\n447\t\n448\t        game = create_game()\n449\t        p1 = game.players[0]\n450\t        game.phase = Phase.PRECOMBAT_MAIN\n451\t        game.step = None\n452\t        bears = [_bear(f\"Bear{i}\") for i in range(6)]\n453\t        _witherbloom_on_battlefield(game, p1, creatures=bears)\n454\t\n455\t        bolt = _test_instant(generic=2)\n456\t        bolt.controller = p1\n457\t        bolt.owner = p1\n458\t        # 6 creatures, but only {2} generic is reducible -> clamped to 2.\n459\t        assert get_cost_reduction(game, bolt, p1) == 2\n460\t\n461\t    def test_witherbloom_does_not_reduce_its_own_spell_via_registry(self) -> None:\n462\t        \"\"\"The registered reducer excludes Witherbloom itself — a second\n463\t        Witherbloom being cast is reduced only by its own affinity hook, not\n464\t        doubled by the registry.\"\"\"\n465\t        from engine.casting import get_cost_reduction\n466\t\n467\t        game = create_game()\n468\t        p1 = game.players[0]\n469\t        game.phase = Phase.PRECOMBAT_MAIN\n470\t        game.step = None\n471\t        bears = [_bear(\"A\"), _bear(\"B\")]\n472\t        _witherbloom_on_battlefield(game, p1, creatures=bears)\n473\t\n474\t        # A different Witherbloom copy being cast: its own cost_reduction()\n475\t        # counts the 2 bears (the battlefield Witherbloom is a creature too,\n476\t        # so 3 creatures total), but the registry's predicate skips\n477\t        # instant/sorcery only — a creature spell gets no registry bonus.\n478\t        second = WitherbloomTheBalancer(owner=p1, controller=p1)\n479\t        reduction = get_cost_reduction(game, second, p1)\n480\t        # 3 creatures you control (2 bears + the battlefield Witherbloom) ->\n481\t        # reduction 3 from its OWN hook; the registry adds nothing for a\n482\t        # creature spell. Clamped within the {6} generic.\n483\t        assert reduction == 3\n484\t\n485\t    def test_opponent_instant_not_reduced(self) -> None:\n486\t        \"\"\"The grant is \"spells YOU cast\" — an opponent's instant gets no\n487\t        reduction even with Witherbloom + creatures on the controller's side.\"\"\"\n488\t        from engine.casting import get_cost_reduction\n489\t\n490\t        game = create_game()\n491\t        p1 = game.players[0]\n492\t        p2 = game.players[1]\n493\t        game.phase = Phase.PRECOMBAT_MAIN\n494\t        game.step = None\n495\t        bears = [_bear(\"A\"), _bear(\"B\"), _bear(\"C\")]\n496\t        _witherbloom_on_battlefield(game, p1, creatures=bears)\n497\t\n498\t        opp_bolt = _test_instant(name=\"Opp Bolt\", generic=4)\n499\t        opp_bolt.controller = p2\n500\t        opp_bolt.owner = p2\n501\t        # p2 is not Witherbloom's controller -> no granted affinity.\n502\t        assert get_cost_reduction(game, opp_bolt, p2) == 0\n503\t\n504\t    def test_creature_spell_not_reduced_by_grant(self) -> None:\n505\t        \"\"\"The grant applies to instant/sorcery spells only — a separate\n506\t        creature spell the controller casts gets no registry reduction.\"\"\"\n507\t        from engine.casting import get_cost_reduction\n508\t        from engine.types import ManaCost\n509\t\n510\t        game = create_game()\n511\t        p1 = game.players[0]\n512\t        game.phase = Phase.PRECOMBAT_MAIN\n513\t        game.step = None\n514\t        bears = [_bear(\"A\"), _bear(\"B\"), _bear(\"C\")]\n515\t        _witherbloom_on_battlefield(game, p1, creatures=bears)\n516\t\n517\t        plain_creature = Creature(\n518\t            name=\"Hill Giant\", base_power=3, base_toughness=3,\n519\t            mana_cost=ManaCost.parse(\"{4}{R}\"),\n520\t        )\n521\t        plain_creature.card_types = {CardType.CREATURE}\n522\t        plain_creature.controller = p1\n523\t        plain_creature.owner = p1\n524\t        # A vanilla creature has no cost_reduction() hook of its own and the\n525\t        # registry skips non-instant/sorcery spells -> no reduction.\n526\t        assert get_cost_reduction(game, plain_creature, p1) == 0\n527\t\n528\t    def test_no_reduction_without_witherbloom_on_battlefield(self) -> None:\n529\t        \"\"\"Registry no-op: without Witherbloom in play, the same {4}{R} instant\n530\t        gets no affinity reduction even with creatures on the battlefield.\"\"\"\n531\t        from engine.casting import get_cost_reduction\n532\t\n533\t        game = create_game()\n534\t        p1 = game.players[0]\n535\t        game.phase = Phase.PRECOMBAT_MAIN\n536\t        game.step = None\n537\t        # Creatures but NO Witherbloom -> no reducer registered.\n538\t        set_board_state(game, 0, battlefield=[_bear(\"A\"), _bear(\"B\"), _bear(\"C\")])\n539\t\n540\t        bolt = _test_instant(generic=4)\n541\t        bolt.controller = p1\n542\t        bolt.owner = p1\n543\t        assert get_cost_reduction(game, bolt, p1) == 0\n544\t\n545\t    def test_unregister_removes_grant(self) -> None:\n546\t        \"\"\"After Witherbloom's reducer is unregistered (e.g. it leaves the\n547\t        battlefield), the controller's instant gets no further reduction.\"\"\"\n548\t        from engine.casting import get_cost_reduction\n549\t\n550\t        game = create_game()\n551\t        p1 = game.players[0]\n552\t        game.phase = Phase.PRECOMBAT_MAIN\n553\t        game.step = None\n554\t        bears = [_bear(\"A\"), _bear(\"B\"), _bear(\"C\")]\n555\t        wb = _witherbloom_on_battlefield(game, p1, creatures=bears)\n556\t\n557\t        bolt = _test_instant(generic=6)\n558\t        bolt.controller = p1\n559\t        bolt.owner = p1\n560\t        # 3 bears + Witherbloom = 4 creatures -> reduction 4.\n561\t        assert get_cost_reduction(game, bolt, p1) == 4\n562\t\n563\t        game.unregister_spell_cost_reducer(wb)\n564\t        assert get_cost_reduction(game, bolt, p1) == 0\n565\t\n566\t    def test_cast_separate_instant_pays_reduced_cost(self) -> None:\n567\t        \"\"\"End-to-end: with Witherbloom + 3 bears (4 creatures), the controller\n568\t        casts a separate {6}{R} instant for {2}{R} and it reaches the stack.\"\"\"\n569\t        from engine.casting import cast_spell\n570\t\n571\t        game = create_game()\n572\t        p1 = game.players[0]\n573\t        game.active_player_index = 0\n574\t        game.priority_player_index = 0\n575\t        game.phase = Phase.PRECOMBAT_MAIN\n576\t        game.step = None\n577\t        bears = [_bear(\"A\"), _bear(\"B\"), _bear(\"C\")]\n578\t        _witherbloom_on_battlefield(game, p1, creatures=bears)\n579\t\n580\t        bolt = _test_instant(generic=6)\n581\t        game.get_hand(p1).add(bolt)\n582\t        bolt.controller = p1\n583\t        bolt.owner = p1\n584\t        # {6}{R} reduced by 4 -> {2}{R}: exactly 2 colorless + 1 red pays it.\n585\t        set_board_state(\n586\t            game,\n587\t            0,\n588\t            mana={ManaType.COLORLESS: 2, ManaType.RED: 1},\n589\t        )\n590\t\n591\t        cast_spell(game, p1, bolt)\n592\t        assert not game.stack.is_empty()\n593\t"}]},"parent_tool_use_id":"toolu_01GUc1mLLu3Wf7w47XGpBpB8","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"5a87e965-1c6f-413c-ae88-dd1f2de93e24","timestamp":"2026-06-01T10:10:52.442Z","subagent_type":"Implementer","task_description":"Revise sos_245 per review"}
