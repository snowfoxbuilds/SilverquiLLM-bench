{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RPZSCK8fPVYqchtiKDeQCm","type":"tool_result","content":"1\t\"\"\"Card implementation for The Dawning Archaic (SOS 1).\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.types import CardType, Keyword, ManaCost, Supertype, TargetRequirement, Zone\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t\n13\t\n14\tdef _is_instant_or_sorcery(card: Any) -> bool:\n15\t    \"\"\"Return ``True`` if *card* is an instant or sorcery card.\"\"\"\n16\t    types = getattr(card, \"card_types\", set())\n17\t    return CardType.INSTANT in types or CardType.SORCERY in types\n18\t\n19\t\n20\tclass TheDawningArchaic(Creature):\n21\t    \"\"\"The Dawning Archaic — {10} — 7/7 — Legendary Creature — Avatar.\n22\t\n23\t    - This spell costs {1} less to cast for each instant and sorcery card in\n24\t      your graveyard.\n25\t    - Reach.\n26\t    - Whenever The Dawning Archaic attacks, you may cast target instant or\n27\t      sorcery card from your graveyard without paying its mana cost. If that\n28\t      spell would be put into your graveyard, exile it instead.\n29\t\n30\t    SOS collector number 1.\n31\t    \"\"\"\n32\t\n33\t    def __init__(self, **kwargs: Any) -> None:\n34\t        kwargs.setdefault(\"name\", \"The Dawning Archaic\")\n35\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{10}\"))\n36\t        kwargs.setdefault(\"subtypes\", {\"Avatar\"})\n37\t        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n38\t        kwargs.setdefault(\"keywords\", Keyword.REACH)\n39\t        kwargs.setdefault(\"base_power\", 7)\n40\t        kwargs.setdefault(\"base_toughness\", 7)\n41\t        kwargs.setdefault(\n42\t            \"rules_text\",\n43\t            \"This spell costs {1} less to cast for each instant and sorcery \"\n44\t            \"card in your graveyard.\\nReach\\nWhenever The Dawning Archaic \"\n45\t            \"attacks, you may cast target instant or sorcery card from your \"\n46\t            \"graveyard without paying its mana cost. If that spell would be \"\n47\t            \"put into your graveyard, exile it instead.\",\n48\t        )\n49\t        super().__init__(**kwargs)\n50\t\n51\t    # ------------------------------------------------------------------\n52\t    # Cost reduction\n53\t    # ------------------------------------------------------------------\n54\t\n55\t    def cost_reduction(self, game: \"GameState\") -> int:\n56\t        \"\"\"Reduce generic mana by 1 for each instant/sorcery in your graveyard.\"\"\"\n57\t        controller = getattr(self, \"controller\", None) or getattr(self, \"owner\", None)\n58\t        if controller is None:\n59\t            return 0\n60\t        graveyard = game.get_graveyard(controller)\n61\t        return sum(1 for card in graveyard.get_all() if _is_instant_or_sorcery(card))\n62\t\n63\t    # ------------------------------------------------------------------\n64\t    # Targeting (for the attack trigger)\n65\t    # ------------------------------------------------------------------\n66\t\n67\t    def get_targets(self, game: \"GameState\") -> list[Any]:\n68\t        \"\"\"Target an instant or sorcery card in your graveyard.\"\"\"\n69\t        return [\n70\t            TargetRequirement(\n71\t                filter_fn=_is_instant_or_sorcery,\n72\t                description=\"target instant or sorcery card in your graveyard\",\n73\t                zone=Zone.GRAVEYARD,\n74\t            )\n75\t        ]\n76\t\n77\t    # ------------------------------------------------------------------\n78\t    # Attack trigger\n79\t    # ------------------------------------------------------------------\n80\t\n81\t    def register_triggers(self, game: \"GameState\") -> None:\n82\t        \"\"\"Register the attack trigger that free-casts from the graveyard.\"\"\"\n83\t        from engine.events import AttacksTriggeredEvent\n84\t        from engine.triggers import TriggerRegistration\n85\t\n86\t        source = self\n87\t        controller = getattr(self, \"controller\", None) or game.active_player\n88\t\n89\t        def _condition(game: Any, event: Any) -> bool:\n90\t            return getattr(event, \"creature\", None) is source\n91\t\n92\t        def _effect(game: \"GameState\") -> None:\n93\t            source._free_cast_from_graveyard(game)\n94\t\n95\t        game.trigger_manager.register(\n96\t            TriggerRegistration(\n97\t                event_type=AttacksTriggeredEvent,\n98\t                condition=_condition,\n99\t                effect=_effect,\n100\t                source=self,\n101\t                controller=controller,\n102\t            )\n103\t        )\n104\t\n105\t    def _free_cast_from_graveyard(self, game: \"GameState\") -> None:\n106\t        \"\"\"Cast the chosen instant/sorcery from the graveyard for free.\n107\t\n108\t        The \"may\" is modeled by whether a legal target was chosen: with no\n109\t        chosen target the ability does nothing. The spell, if it would be put\n110\t        into the graveyard after resolving, is exiled instead.\n111\t        \"\"\"\n112\t        from engine.casting import cast_spell_free\n113\t\n114\t        controller = getattr(self, \"controller\", None) or getattr(self, \"owner\", None)\n115\t        if controller is None:\n116\t            return\n117\t\n118\t        chosen = getattr(self, \"chosen_targets\", None)\n119\t        target = None\n120\t        if chosen:\n121\t            for candidate in chosen:\n122\t                if candidate is not None and _is_instant_or_sorcery(candidate):\n123\t                    target = candidate\n124\t                    break\n125\t        if target is None:\n126\t            return\n127\t\n128\t        # The target must be in the controller's graveyard.\n129\t        if not game.get_graveyard(controller).contains(target):\n130\t            return\n131\t\n132\t        cast_spell_free(game, controller, target, Zone.GRAVEYARD)\n133\t\n134\t        # Redirect the spell's post-resolution move from graveyard to exile.\n135\t        stack_obj = game.stack.peek()\n136\t        if stack_obj is not None and stack_obj.source is target:\n137\t            original_resolve = stack_obj.on_resolve\n138\t\n139\t            def _resolve_then_exile(g: \"GameState\") -> None:\n140\t                gy = g.get_graveyard(controller)\n141\t                original_resolve(g)\n142\t                # If resolution put the spell into the graveyard, exile it.\n143\t                if gy.contains(target):\n144\t                    from engine.game import exile as _exile\n145\t\n146\t                    _exile(g, target)\n147\t\n148\t            stack_obj.on_resolve = _resolve_then_exile\n149\t"}]},"parent_tool_use_id":"toolu_01NFRPvSxWwFBmgyfa4TCZrp","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"3b91813a-363c-4d35-8c69-dfa9839901f2","timestamp":"2026-06-01T08:33:09.703Z","subagent_type":"Implementer","task_description":"Revise sos_1 per review"}
