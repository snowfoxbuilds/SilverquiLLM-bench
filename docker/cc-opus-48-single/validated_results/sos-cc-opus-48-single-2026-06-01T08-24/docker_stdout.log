{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YGWg8F3Nv57xv59MRJ1du3","type":"tool_result","content":"1\t\"\"\"Tests for SOS 57 — Mana Sculpt.\n2\t\n3\tMana Sculpt is a ``{1}{U}{U}`` Instant:\n4\t\n5\t    \"Counter target spell. If you control a Wizard, add an amount of {C} equal\n6\t    to the amount of mana spent to cast that spell at the beginning of your\n7\t    next main phase.\"\n8\t\n9\tThese tests define the TDD contract; ``card_impl.py`` is a stub, so they are\n10\texpected to fail until the card is implemented.\n11\t\n12\tCoverage notes\n13\t--------------\n14\t* **Static data** — instant type, name, mana cost, blue color.\n15\t* **Targeting** — ``get_targets()`` advertises a single spell target that lives\n16\t  in the STACK zone; the filter accepts spells (instants/sorceries) and rejects\n17\t  non-spell objects.\n18\t* **Counter** — when Mana Sculpt resolves with a chosen target spell on the\n19\t  stack, that spell is countered: removed from the stack and placed into its\n20\t  owner's graveyard. No-target resolution is a no-op.\n21\t\n22\tThe delayed ``{C}`` clause (\"If you control a Wizard … at the beginning of your\n23\tnext main phase\") depends on engine surface that does not exist (no\n24\tbeginning-of-main-phase trigger event, and the engine does not record the\n25\tamount of mana spent to cast a given stack spell). Those sub-clauses are\n26\trecorded in ``untestable.json``. The Wizard *gate* is still exercised here at\n27\tthe level the card can express it: countering itself must work identically\n28\twhether or not a Wizard is controlled, and the presence/absence of a Wizard\n29\tmust not change the counter outcome.\n30\t\"\"\"\n31\t\n32\tfrom __future__ import annotations\n33\t\n34\tfrom typing import Any\n35\t\n36\tfrom cards.sos.sos_57.card_impl import ManaSculpt\n37\tfrom engine.card import Creature, Instant, Sorcery\n38\tfrom engine.stack import StackObject\n39\tfrom engine.types import CardType, ManaCost, TargetRequirement, Zone\n40\tfrom test_utils import create_game, set_board_state\n41\t\n42\t\n43\t# ---------------------------------------------------------------------------\n44\t# Helpers\n45\t# ---------------------------------------------------------------------------\n46\t\n47\t\n48\tdef _spell_on_stack(game: Any, player: Any, card: Any) -> StackObject:\n49\t    \"\"\"Place *card* into *player*'s STACK zone and push a matching StackObject.\n50\t\n51\t    Returns the pushed StackObject so tests can assert it leaves the stack.\n52\t    \"\"\"\n53\t    card.owner = player\n54\t    card.controller = player\n55\t    player.zones[Zone.STACK].add(card)\n56\t    obj = StackObject(source=card, controller=player)\n57\t    game.stack.push(obj)\n58\t    return obj\n59\t\n60\t\n61\tdef _vanilla_sorcery(name: str = \"Lava Spike\") -> Sorcery:\n62\t    c = Sorcery(name=name, mana_cost=ManaCost.parse(\"{R}\"))\n63\t    return c\n64\t\n65\t\n66\tdef _vanilla_instant(name: str = \"Opt\") -> Instant:\n67\t    c = Instant(name=name, mana_cost=ManaCost.parse(\"{U}\"))\n68\t    return c\n69\t\n70\t\n71\tdef _wizard(name: str = \"Merfolk Wizard\") -> Creature:\n72\t    c = Creature(name=name, base_power=1, base_toughness=1, subtypes={\"Merfolk\", \"Wizard\"})\n73\t    c.card_types = {CardType.CREATURE}\n74\t    return c\n75\t\n76\t\n77\tdef _non_wizard(name: str = \"Grizzly Bears\") -> Creature:\n78\t    c = Creature(name=name, base_power=2, base_toughness=2, subtypes={\"Bear\"})\n79\t    c.card_types = {CardType.CREATURE}\n80\t    return c\n81\t\n82\t\n83\t# ---------------------------------------------------------------------------\n84\t# Static card data\n85\t# ---------------------------------------------------------------------------\n86\t\n87\t\n88\tclass TestManaSculptProperties:\n89\t    \"\"\"Static card data should match the SOS 57 spec.\"\"\"\n90\t\n91\t    def test_is_instant(self) -> None:\n92\t        assert isinstance(ManaSculpt(owner=None), Instant)\n93\t\n94\t    def test_card_type_includes_instant(self) -> None:\n95\t        assert CardType.INSTANT in ManaSculpt(owner=None).card_types\n96\t\n97\t    def test_name(self) -> None:\n98\t        assert ManaSculpt(owner=None).name == \"Mana Sculpt\"\n99\t\n100\t    def test_mana_cost(self) -> None:\n101\t        assert ManaSculpt(owner=None).mana_cost == ManaCost.parse(\"{1}{U}{U}\")\n102\t\n103\t    def test_is_blue(self) -> None:\n104\t        \"\"\"Cost has two blue pips and one generic.\"\"\"\n105\t        from engine.types import ManaType\n106\t\n107\t        cost = ManaSculpt(owner=None).mana_cost\n108\t        assert cost.pips.get(ManaType.BLUE, 0) == 2\n109\t        assert cost.generic == 1\n110\t\n111\t\n112\t# ---------------------------------------------------------------------------\n113\t# Targeting — \"Counter target spell\"\n114\t# ---------------------------------------------------------------------------\n115\t\n116\t\n117\tclass TestManaSculptTargeting:\n118\t    \"\"\"get_targets() advertises a single spell target in the STACK zone.\"\"\"\n119\t\n120\t    def test_returns_single_target_requirement(self) -> None:\n121\t        game = create_game()\n122\t        reqs = ManaSculpt(owner=None).get_targets(game)\n123\t        assert isinstance(reqs, list)\n124\t        assert len(reqs) == 1\n125\t        assert isinstance(reqs[0], TargetRequirement)\n126\t\n127\t    def test_target_zone_is_stack(self) -> None:\n128\t        game = create_game()\n129\t        req = ManaSculpt(owner=None).get_targets(game)[0]\n130\t        assert req.zone == Zone.STACK\n131\t\n132\t    def test_filter_accepts_sorcery_spell(self) -> None:\n133\t        game = create_game()\n134\t        req = ManaSculpt(owner=None).get_targets(game)[0]\n135\t        assert req.filter_fn(_vanilla_sorcery()) is True\n136\t\n137\t    def test_filter_accepts_instant_spell(self) -> None:\n138\t        game = create_game()\n139\t        req = ManaSculpt(owner=None).get_targets(game)[0]\n140\t        assert req.filter_fn(_vanilla_instant()) is True\n141\t\n142\t    def test_filter_rejects_non_spell(self) -> None:\n143\t        \"\"\"A permanent / non-spell object is not a legal 'target spell'.\"\"\"\n144\t        game = create_game()\n145\t        req = ManaSculpt(owner=None).get_targets(game)[0]\n146\t\n147\t        class _NotASpell:\n148\t            card_types: set = set()\n149\t\n150\t        assert req.filter_fn(_NotASpell()) is False\n151\t\n152\t\n153\t# ---------------------------------------------------------------------------\n154\t# Counter target spell\n155\t# ---------------------------------------------------------------------------\n156\t\n157\t\n158\tclass TestManaSculptCounter:\n159\t    \"\"\"On resolution, the targeted spell is countered (stack → graveyard).\"\"\"\n160\t\n161\t    def test_countered_spell_leaves_the_stack(self) -> None:\n162\t        game = create_game()\n163\t        caster = game.players[0]\n164\t        opponent = game.players[1]\n165\t        target_spell = _vanilla_sorcery(\"Lava Spike\")\n166\t        obj = _spell_on_stack(game, opponent, target_spell)\n167\t\n168\t        sculpt = ManaSculpt(owner=caster, controller=caster)\n169\t        sculpt.chosen_targets = [target_spell]\n170\t        sculpt.on_resolve(game)\n171\t\n172\t        # The countered spell's StackObject must no longer be on the stack.\n173\t        assert obj not in game.stack.objects()\n174\t        assert not opponent.zones[Zone.STACK].contains(target_spell)\n175\t\n176\t    def test_countered_spell_goes_to_owner_graveyard(self) -> None:\n177\t        game = create_game()\n178\t        caster = game.players[0]\n179\t        opponent = game.players[1]\n180\t        target_spell = _vanilla_sorcery(\"Lava Spike\")\n181\t        _spell_on_stack(game, opponent, target_spell)\n182\t\n183\t        sculpt = ManaSculpt(owner=caster, controller=caster)\n184\t        sculpt.chosen_targets = [target_spell]\n185\t        sculpt.on_resolve(game)\n186\t\n187\t        # A countered spell goes to its owner's graveyard.\n188\t        assert game.get_graveyard(opponent).contains(target_spell)\n189\t\n190\t    def test_countered_spell_does_not_resolve_its_effect(self) -> None:\n191\t        \"\"\"The countered spell's on_resolve must not run.\"\"\"\n192\t        game = create_game()\n193\t        caster = game.players[0]\n194\t        opponent = game.players[1]\n195\t\n196\t        resolved = {\"ran\": False}\n197\t\n198\t        class _Marker(Sorcery):\n199\t            def on_resolve(self, g: Any) -> None:\n200\t                resolved[\"ran\"] = True\n201\t\n202\t        target_spell = _Marker(name=\"Marker\", mana_cost=ManaCost.parse(\"{R}\"))\n203\t        _spell_on_stack(game, opponent, target_spell)\n204\t\n205\t        sculpt = ManaSculpt(owner=caster, controller=caster)\n206\t        sculpt.chosen_targets = [target_spell]\n207\t        sculpt.on_resolve(game)\n208\t\n209\t        assert resolved[\"ran\"] is False\n210\t\n211\t    def test_no_target_is_a_noop(self) -> None:\n212\t        \"\"\"With no chosen target, resolution must not raise and must not\n213\t        remove anything from the stack.\"\"\"\n214\t        game = create_game()\n215\t        caster = game.players[0]\n216\t        opponent = game.players[1]\n217\t        target_spell = _vanilla_sorcery(\"Lava Spike\")\n218\t        _spell_on_stack(game, opponent, target_spell)\n219\t\n220\t        sculpt = ManaSculpt(owner=caster, controller=caster)\n221\t        # chosen_targets left unset.\n222\t        sculpt.on_resolve(game)\n223\t\n224\t        # Untouched: the spell stays on the stack.\n225\t        assert opponent.zones[Zone.STACK].contains(target_spell)\n226\t        assert not game.get_graveyard(opponent).contains(target_spell)\n227\t\n228\t    def test_none_target_is_a_noop(self) -> None:\n229\t        \"\"\"An explicit ``[None]`` target list (no legal target chosen) is a\n230\t        no-op rather than a crash.\"\"\"\n231\t        game = create_game()\n232\t        caster = game.players[0]\n233\t        opponent = game.players[1]\n234\t        target_spell = _vanilla_sorcery(\"Lava Spike\")\n235\t        _spell_on_stack(game, opponent, target_spell)\n236\t\n237\t        sculpt = ManaSculpt(owner=caster, controller=caster)\n238\t        sculpt.chosen_targets = [None]\n239\t        sculpt.on_resolve(game)\n240\t\n241\t        assert opponent.zones[Zone.STACK].contains(target_spell)\n242\t\n243\t\n244\t# ---------------------------------------------------------------------------\n245\t# Wizard gate — counter behavior is independent of the bonus clause\n246\t# ---------------------------------------------------------------------------\n247\t\n248\t\n249\tclass TestManaSculptWizardGateDoesNotAffectCounter:\n250\t    \"\"\"The 'If you control a Wizard' clause governs only the bonus {C}; the\n251\t    counter itself happens regardless of whether a Wizard is controlled.\"\"\"\n252\t\n253\t    def test_counters_even_without_a_wizard(self) -> None:\n254\t        game = create_game()\n255\t        caster = game.players[0]\n256\t        opponent = game.players[1]\n257\t        # Caster controls a non-Wizard creature only.\n258\t        set_board_state(game, 0, battlefield=[_non_wizard()])\n259\t        target_spell = _vanilla_sorcery(\"Lava Spike\")\n260\t        _spell_on_stack(game, opponent, target_spell)\n261\t\n262\t        sculpt = ManaSculpt(owner=caster, controller=caster)\n263\t        sculpt.chosen_targets = [target_spell]\n264\t        sculpt.on_resolve(game)\n265\t\n266\t        assert game.get_graveyard(opponent).contains(target_spell)\n267\t\n268\t    def test_counters_when_controlling_a_wizard(self) -> None:\n269\t        game = create_game()\n270\t        caster = game.players[0]\n271\t        opponent = game.players[1]\n272\t        set_board_state(game, 0, battlefield=[_wizard()])\n273\t        target_spell = _vanilla_sorcery(\"Lava Spike\")\n274\t        _spell_on_stack(game, opponent, target_spell)\n275\t\n276\t        sculpt = ManaSculpt(owner=caster, controller=caster)\n277\t        sculpt.chosen_targets = [target_spell]\n278\t        sculpt.on_resolve(game)\n279\t\n280\t        assert game.get_graveyard(opponent).contains(target_spell)\n281\t"}]},"parent_tool_use_id":"toolu_015rJSnz1LezCJNzSZuKfbai","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"55d8097f-ad89-472c-b322-9e78300c5337","timestamp":"2026-06-01T09:02:09.562Z","subagent_type":"Tester","task_description":"Extend sos_57 tests for C bonus"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QFhE9zA5BqNQmaUosuZt62","type":"tool_result","content":"1\t\"\"\"Card implementation for Mana Sculpt (SOS 57).\n2\t\n3\t    \"Counter target spell. If you control a Wizard, add an amount of {C} equal\n4\t    to the amount of mana spent to cast that spell at the beginning of your\n5\t    next main phase.\"\n6\t\n7\tThe counter half is fully implemented and tested.  The delayed Wizard {C}\n8\tbonus is built on top of two ADDITIVE engine capabilities:\n9\t\n10\t* ``engine.events.BeginningOfMainPhaseTriggeredEvent`` — fired from\n11\t  ``GameState.advance_phase`` whenever a main phase begins.\n12\t* ``card.mana_spent`` — total mana paid to cast a spell, recorded by\n13\t  ``engine.casting.cast_spell``.\n14\t\"\"\"\n15\t\n16\tfrom __future__ import annotations\n17\t\n18\tfrom typing import TYPE_CHECKING, Any\n19\t\n20\tfrom engine.card import Instant\n21\tfrom engine.types import CardType, ManaCost, ManaType, TargetRequirement, Zone\n22\t\n23\tif TYPE_CHECKING:\n24\t    from engine.game_state import GameState\n25\t\n26\t\n27\t# Card types that count as a \"spell\" while on the stack.\n28\t_SPELL_TYPES = {\n29\t    CardType.INSTANT,\n30\t    CardType.SORCERY,\n31\t    CardType.CREATURE,\n32\t    CardType.ARTIFACT,\n33\t    CardType.ENCHANTMENT,\n34\t    CardType.PLANESWALKER,\n35\t}\n36\t\n37\t\n38\tdef _is_spell(obj: Any) -> bool:\n39\t    \"\"\"Return ``True`` if *obj* (a card or stack object) is a spell.\n40\t\n41\t    Accepts either the card directly or a ``StackObject`` wrapping a card.\n42\t    \"\"\"\n43\t    source = getattr(obj, \"source\", obj)\n44\t    card_types = getattr(source, \"card_types\", set())\n45\t    return bool(card_types & _SPELL_TYPES)\n46\t\n47\t\n48\tdef _find_stack_object(game: GameState, card: Any) -> Any:\n49\t    \"\"\"Return the StackObject whose ``source`` is *card*, or ``None``.\"\"\"\n50\t    from engine.stack import StackObject\n51\t\n52\t    if isinstance(card, StackObject):\n53\t        return card\n54\t    for stack_obj in game.stack.objects():\n55\t        if stack_obj.source is card:\n56\t            return stack_obj\n57\t    return None\n58\t\n59\t\n60\tdef _counter_spell(game: GameState, stack_obj: Any) -> Any:\n61\t    \"\"\"Counter the spell represented by *stack_obj*.\n62\t\n63\t    Removes the StackObject from the stack, moves its source card from the\n64\t    controller's STACK zone to its owner's graveyard, and never runs the\n65\t    spell's ``on_resolve``.  Returns the countered card (or ``None``).\n66\t    \"\"\"\n67\t    from engine.stack import StackObject\n68\t\n69\t    if not isinstance(stack_obj, StackObject):\n70\t        return None\n71\t\n72\t    card = stack_obj.source\n73\t\n74\t    # Remove the StackObject from the stack; fizzle if it is no longer there.\n75\t    stack_items = game.stack._items  # noqa: SLF001\n76\t    found = False\n77\t    for i, item in enumerate(stack_items):\n78\t        if item is stack_obj:\n79\t            stack_items.pop(i)\n80\t            found = True\n81\t            break\n82\t    if not found:\n83\t        return None\n84\t\n85\t    controller = stack_obj.controller\n86\t    owner = getattr(card, \"owner\", controller)\n87\t\n88\t    if controller is not None:\n89\t        stack_zone = controller.zones[Zone.STACK]\n90\t        if stack_zone.contains(card):\n91\t            stack_zone.remove(card)\n92\t\n93\t    if owner is not None:\n94\t        owner.zones[Zone.GRAVEYARD].add(card)\n95\t\n96\t    return card\n97\t\n98\t\n99\tdef _controls_wizard(game: GameState, player: Any) -> bool:\n100\t    \"\"\"Return ``True`` if *player* controls a creature with the Wizard subtype.\"\"\"\n101\t    if player is None:\n102\t        return False\n103\t    for perm in game.get_battlefield(player).get_all():\n104\t        subtypes = getattr(perm, \"subtypes\", set())\n105\t        if \"Wizard\" in subtypes:\n106\t            return True\n107\t    return False\n108\t\n109\t\n110\tclass ManaSculpt(Instant):\n111\t    \"\"\"Mana Sculpt — {1}{U}{U} — Counter target spell with a Wizard {C} bonus.\"\"\"\n112\t\n113\t    def __init__(self, **kwargs: Any) -> None:\n114\t        kwargs.setdefault(\"name\", \"Mana Sculpt\")\n115\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{U}{U}\"))\n116\t        kwargs.setdefault(\n117\t            \"rules_text\",\n118\t            \"Counter target spell. If you control a Wizard, add an amount of \"\n119\t            \"{C} equal to the amount of mana spent to cast that spell at the \"\n120\t            \"beginning of your next main phase.\",\n121\t        )\n122\t        super().__init__(**kwargs)\n123\t        self.chosen_targets: list[Any] = []\n124\t\n125\t    def get_targets(self, game: GameState) -> list[Any]:\n126\t        \"\"\"Advertise a single \"target spell\" requirement in the STACK zone.\"\"\"\n127\t        # While this spell is itself on the stack being cast, don't advertise\n128\t        # a self-target requirement (KEY_DECISIONS sos_1 convention).\n129\t        return [\n130\t            TargetRequirement(\n131\t                filter_fn=_is_spell,\n132\t                description=\"target spell\",\n133\t                zone=Zone.STACK,\n134\t            )\n135\t        ]\n136\t\n137\t    def on_resolve(self, game: GameState) -> None:\n138\t        \"\"\"Counter the chosen spell; queue the Wizard {C} bonus if applicable.\"\"\"\n139\t        chosen = getattr(self, \"chosen_targets\", None)\n140\t        if not chosen:\n141\t            return\n142\t        target = chosen[0]\n143\t        if target is None:\n144\t            return\n145\t\n146\t        stack_obj = _find_stack_object(game, target)\n147\t        if stack_obj is None:\n148\t            return\n149\t\n150\t        # Record the mana spent on the countered spell BEFORE it leaves the\n151\t        # stack, for the delayed {C} bonus.\n152\t        countered_card = stack_obj.source\n153\t        mana_spent = int(getattr(countered_card, \"mana_spent\", 0) or 0)\n154\t\n155\t        countered = _counter_spell(game, stack_obj)\n156\t        if countered is None:\n157\t            return\n158\t\n159\t        # --- Wizard {C} bonus (delayed to your next main phase) ---\n160\t        controller = self.controller\n161\t        if _controls_wizard(game, controller) and mana_spent > 0:\n162\t            self._register_mana_bonus(game, controller, mana_spent)\n163\t\n164\t    def _register_mana_bonus(\n165\t        self, game: GameState, controller: Any, amount: int\n166\t    ) -> None:\n167\t        \"\"\"Register a one-shot delayed trigger that adds {C} at the next main phase.\n168\t\n169\t        Uses the additive ``BeginningOfMainPhaseTriggeredEvent`` engine hook.\n170\t        \"\"\"\n171\t        from engine.events import BeginningOfMainPhaseTriggeredEvent\n172\t        from engine.triggers import TriggerRegistration\n173\t\n174\t        fired = {\"done\": False}\n175\t\n176\t        def _condition(g: GameState, event: Any) -> bool:\n177\t            if fired[\"done\"]:\n178\t                return False\n179\t            return getattr(event, \"player\", None) is controller\n180\t\n181\t        def _effect(g: GameState) -> None:\n182\t            if fired[\"done\"]:\n183\t                return\n184\t            fired[\"done\"] = True\n185\t            controller.mana_pool.add(ManaType.COLORLESS, amount)\n186\t            # One-shot: remove this delayed trigger after it resolves.\n187\t            g.trigger_manager.unregister(self)\n188\t\n189\t        game.trigger_manager.register(\n190\t            TriggerRegistration(\n191\t                event_type=BeginningOfMainPhaseTriggeredEvent,\n192\t                condition=_condition,\n193\t                effect=_effect,\n194\t                source=self,\n195\t                controller=controller,\n196\t            )\n197\t        )\n198\t"}]},"parent_tool_use_id":"toolu_015rJSnz1LezCJNzSZuKfbai","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"70bf26b4-e666-4a47-a59e-39333255b112","timestamp":"2026-06-01T09:02:09.562Z","subagent_type":"Tester","task_description":"Extend sos_57 tests for C bonus"}
{"type":"system","subtype":"task_progress","task_id":"a3680cfc1fc4e5129","tool_use_id":"toolu_015rJSnz1LezCJNzSZuKfbai","description":"Reading engine/events.py","subagent_type":"Tester","usage":{"total_tokens":24618,"tool_uses":6,"duration_ms":6572},"last_tool_name":"Read","uuid":"52e6be4b-a712-4b5a-a559-e4a9d6a0272e","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e"}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01GSYZV9A1BHsgZFAnV6zM9u","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0177P5o4iPmJ3E3JGwDhhtxR","name":"Read","input":{"file_path":"/workspace/engine/events.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11905,"cache_read_input_tokens":12695,"cache_creation":{"ephemeral_5m_input_tokens":11905,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_015rJSnz1LezCJNzSZuKfbai","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"32d56e68-0794-4c2c-8663-e9b8bdd54a2f","request_id":"req_011CbcGYKeQNJtrg2u4dNnsx","subagent_type":"Tester","task_description":"Extend sos_57 tests for C bonus"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0177P5o4iPmJ3E3JGwDhhtxR","type":"tool_result","content":"1\t\"\"\"Typed event objects for triggered abilities and replacement effects.\n2\t\n3\tTriggered events are passed to :meth:`TriggerManager.fire_event` and\n4\tforwarded to trigger condition callables.\n5\t\n6\tReplacement events are passed to :meth:`ReplacementManager.apply` and\n7\tforwarded to replacement condition/replacement callables.  Subclassing\n8\tencodes event-type hierarchy so a replacement registered for a parent\n9\ttype (e.g. ``MoveToGraveyardReplacementEvent``) also fires for\n10\tsubtypes (e.g. ``CreatureDiesReplacementEvent``).\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\tfrom dataclasses import dataclass\n16\tfrom typing import Any\n17\t\n18\t\n19\t# ---------------------------------------------------------------------------\n20\t# Triggered events\n21\t# ---------------------------------------------------------------------------\n22\t\n23\t@dataclass\n24\tclass TriggeredEvent:\n25\t    \"\"\"Base class for all triggered-ability events.\"\"\"\n26\t\n27\t\n28\t@dataclass\n29\tclass EntersBattlefieldTriggeredEvent(TriggeredEvent):\n30\t    permanent: Any = None\n31\t    controller: Any = None\n32\t    card: Any = None\n33\t    creature: Any = None\n34\t\n35\t\n36\t@dataclass\n37\tclass LeavesBattlefieldTriggeredEvent(TriggeredEvent):\n38\t    permanent: Any = None\n39\t    controller: Any = None\n40\t\n41\t\n42\t@dataclass\n43\tclass DealsDamageTriggeredEvent(TriggeredEvent):\n44\t    source: Any = None\n45\t    target: Any = None\n46\t    amount: int = 0\n47\t    is_combat: bool = False\n48\t    combat: bool = False\n49\t\n50\t\n51\t@dataclass\n52\tclass LosesLifeTriggeredEvent(TriggeredEvent):\n53\t    player: Any = None\n54\t    amount: int = 0\n55\t\n56\t\n57\t@dataclass\n58\tclass GainsLifeTriggeredEvent(TriggeredEvent):\n59\t    player: Any = None\n60\t    amount: int = 0\n61\t\n62\t\n63\t@dataclass\n64\tclass DrawsCardTriggeredEvent(TriggeredEvent):\n65\t    player: Any = None\n66\t    card: Any = None\n67\t\n68\t\n69\t@dataclass\n70\tclass BeginningOfUpkeepTriggeredEvent(TriggeredEvent):\n71\t    pass\n72\t\n73\t\n74\t@dataclass\n75\tclass BeginningOfCombatTriggeredEvent(TriggeredEvent):\n76\t    pass\n77\t\n78\t\n79\t@dataclass\n80\tclass BeginningOfMainPhaseTriggeredEvent(TriggeredEvent):\n81\t    \"\"\"Fired at the start of each main phase (precombat or postcombat).\n82\t\n83\t    ``player`` is the active player whose main phase is beginning.  ``phase``\n84\t    is the :class:`~engine.types.Phase` value of the main phase that started,\n85\t    so a delayed \"at the beginning of your next main phase\" trigger can match\n86\t    either precombat or postcombat.\n87\t    \"\"\"\n88\t\n89\t    player: Any = None\n90\t    phase: Any = None\n91\t\n92\t\n93\t@dataclass\n94\tclass EndOfTurnTriggeredEvent(TriggeredEvent):\n95\t    pass\n96\t\n97\t\n98\t@dataclass\n99\tclass EndStepTriggeredEvent(TriggeredEvent):\n100\t    player: Any = None\n101\t\n102\t\n103\t@dataclass\n104\tclass CreatureDiesTriggeredEvent(TriggeredEvent):\n105\t    creature: Any = None\n106\t    controller: Any = None\n107\t    owner: Any = None\n108\t\n109\t\n110\t@dataclass\n111\tclass SpellCastTriggeredEvent(TriggeredEvent):\n112\t    spell: Any = None\n113\t    player: Any = None\n114\t    card: Any = None\n115\t    controller: Any = None\n116\t\n117\t\n118\t@dataclass\n119\tclass AttacksTriggeredEvent(TriggeredEvent):\n120\t    creature: Any = None\n121\t    attacker: Any = None\n122\t\n123\t\n124\t@dataclass\n125\tclass BlocksTriggeredEvent(TriggeredEvent):\n126\t    creature: Any = None\n127\t\n128\t\n129\t@dataclass\n130\tclass CounterAddedTriggeredEvent(TriggeredEvent):\n131\t    permanent: Any = None\n132\t    counter_type: Any = None\n133\t    amount: int = 0\n134\t\n135\t\n136\t# ---------------------------------------------------------------------------\n137\t# Replacement events\n138\t# ---------------------------------------------------------------------------\n139\t\n140\t@dataclass\n141\tclass ReplacementEvent:\n142\t    \"\"\"Base class for all replacement-effect events.\"\"\"\n143\t\n144\t\n145\t@dataclass\n146\tclass MoveToGraveyardReplacementEvent(ReplacementEvent):\n147\t    \"\"\"Any permanent moving to a graveyard.\n148\t\n149\t    Subclass this for specific causes (destruction, sacrifice, etc.).\n150\t    A replacement registered for this type also fires for all subtypes.\n151\t\n152\t    ``destination`` may be mutated by a replacement to redirect the\n153\t    permanent to a different zone (``\"exile\"``, ``\"library\"``, ``\"hand\"``).\n154\t    Set ``prevented = True`` to signal that the replacement handled the\n155\t    zone move itself and the engine should skip its own move.\n156\t    \"\"\"\n157\t\n158\t    destination: str = \"graveyard\"\n159\t    controller: Any = None\n160\t    owner: Any = None\n161\t    prevented: bool = False\n162\t\n163\t    @property\n164\t    def card(self) -> Any:\n165\t        \"\"\"The object moving to the graveyard (overridden by subclasses).\"\"\"\n166\t        return None\n167\t\n168\t\n169\t@dataclass\n170\tclass CreatureDiesReplacementEvent(MoveToGraveyardReplacementEvent):\n171\t    \"\"\"A creature going to the graveyard via destruction or lethal damage.\"\"\"\n172\t\n173\t    creature: Any = None\n174\t\n175\t    @property\n176\t    def card(self) -> Any:\n177\t        return self.creature\n178\t\n179\t\n180\t@dataclass\n181\tclass PermanentDestroyedReplacementEvent(MoveToGraveyardReplacementEvent):\n182\t    \"\"\"A non-creature permanent going to the graveyard via destruction.\"\"\"\n183\t\n184\t    permanent: Any = None\n185\t\n186\t    @property\n187\t    def card(self) -> Any:\n188\t        return self.permanent\n189\t\n190\t\n191\t@dataclass\n192\tclass SacrificeReplacementEvent(MoveToGraveyardReplacementEvent):\n193\t    \"\"\"A permanent going to the graveyard via sacrifice.\"\"\"\n194\t\n195\t    permanent: Any = None\n196\t\n197\t    @property\n198\t    def card(self) -> Any:\n199\t        return self.permanent\n200\t\n201\t\n202\t@dataclass\n203\tclass CreateTokenReplacementEvent(ReplacementEvent):\n204\t    \"\"\"An effect about to create one or more tokens.\"\"\"\n205\t\n206\t    player: Any = None\n207\t    count: int = 1\n208\t\n209\t\n210\t@dataclass\n211\tclass AddCounterReplacementEvent(ReplacementEvent):\n212\t    \"\"\"An effect about to add one or more counters to a permanent.\"\"\"\n213\t\n214\t    permanent: Any = None\n215\t    amount: int = 1\n216\t"}]},"parent_tool_use_id":"toolu_015rJSnz1LezCJNzSZuKfbai","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"a1451e78-56ea-4292-971a-f620c612f629","timestamp":"2026-06-01T09:02:12.243Z","subagent_type":"Tester","task_description":"Extend sos_57 tests for C bonus"}
{"type":"system","subtype":"task_progress","task_id":"a3680cfc1fc4e5129","tool_use_id":"toolu_015rJSnz1LezCJNzSZuKfbai","description":"Reading engine/casting.py","subagent_type":"Tester","usage":{"total_tokens":24623,"tool_uses":7,"duration_ms":7044},"last_tool_name":"Read","uuid":"25b8c511-0969-4336-b291-cc4b113b4c97","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e"}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01GSYZV9A1BHsgZFAnV6zM9u","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_016anXhi3aZ6Lva6YqQLc4HD","name":"Read","input":{"file_path":"/workspace/engine/casting.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11905,"cache_read_input_tokens":12695,"cache_creation":{"ephemeral_5m_input_tokens":11905,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_015rJSnz1LezCJNzSZuKfbai","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"c11c347b-37d7-4adc-9efd-2b163cea71a6","request_id":"req_011CbcGYKeQNJtrg2u4dNnsx","subagent_type":"Tester","task_description":"Extend sos_57 tests for C bonus"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016anXhi3aZ6Lva6YqQLc4HD","type":"tool_result","content":"1\t\"\"\"Casting and resolution pipeline for spells and lands.\n2\t\n3\tProvides the full flow from casting a spell or playing a land through\n4\tresolution:\n5\t\n6\t- :func:`cast_spell` — verify timing & legality → move hand to stack →\n7\t  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n8\t- :func:`play_land` — verify land play remaining → move hand to\n9\t  battlefield → decrement ``land_plays_remaining``.\n10\t- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n11\t  helpers used by the casting pipeline.\n12\t\n13\tResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\n14\tcreated by :func:`cast_spell`:\n15\t\n16\t- Call ``card.on_resolve(game)``.\n17\t- Permanents (creature / enchantment / artifact / planeswalker) move from\n18\t  the stack to the battlefield.\n19\t- Non-permanents (instant / sorcery) move to the graveyard.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import TYPE_CHECKING, Any\n25\t\n26\tfrom engine.card import CardImpl\n27\tfrom engine.stack import StackObject\n28\tfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\n29\tfrom engine.zones import move_zone\n30\t\n31\tif TYPE_CHECKING:\n32\t    from engine.game_state import GameState\n33\t    from engine.player import Player\n34\t\n35\t\n36\t# Card types that represent permanents — these go to the battlefield on resolve.\n37\t_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n38\t    CardType.CREATURE,\n39\t    CardType.ENCHANTMENT,\n40\t    CardType.ARTIFACT,\n41\t    CardType.PLANESWALKER,\n42\t})\n43\t\n44\t\n45\tclass CastingError(Exception):\n46\t    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n47\t\n48\t\n49\t# ------------------------------------------------------------------\n50\t# Timing helpers\n51\t# ------------------------------------------------------------------\n52\t\n53\tdef is_sorcery_speed(game: GameState, player: Player) -> bool:\n54\t    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n55\t\n56\t    Sorcery speed requires all of:\n57\t\n58\t    * *player* is the active player.\n59\t    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n60\t      ``POSTCOMBAT_MAIN``).\n61\t    * The stack is empty.\n62\t    \"\"\"\n63\t    if player is not game.active_player:\n64\t        return False\n65\t    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n66\t        return False\n67\t    if not game.stack.is_empty():\n68\t        return False\n69\t    return True\n70\t\n71\t\n72\tdef can_cast_at_instant_speed(card: CardImpl) -> bool:\n73\t    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n74\t\n75\t    A card has instant-speed timing if it is an instant or has the\n76\t    :attr:`~engine.types.Keyword.FLASH` keyword.\n77\t    \"\"\"\n78\t    if CardType.INSTANT in card.card_types:\n79\t        return True\n80\t    if Keyword.FLASH & card.keywords:\n81\t        return True\n82\t    return False\n83\t\n84\t\n85\t# ------------------------------------------------------------------\n86\t# Cost reduction\n87\t# ------------------------------------------------------------------\n88\t\n89\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n90\t    \"\"\"Return the generic mana reduction for casting *card*.\n91\t\n92\t    Queries ``card.cost_reduction(game)`` and clamps the result so that\n93\t    the generic portion of the mana cost cannot go below 0.\n94\t\n95\t    This is a simplified single-card self-reduction model.  Full MTG\n96\t    cost-reduction interactions (Trinisphere, multiple reductions from\n97\t    different sources) are deferred.\n98\t    \"\"\"\n99\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n100\t    # casting player even when the card was never explicitly assigned one.\n101\t    prev_controller = card.controller\n102\t    card.controller = controller\n103\t    raw = card.cost_reduction(game)\n104\t    # Restore previous controller in case the caller doesn't want a\n105\t    # side-effect (get_cost_reduction is a query, not a mutation).\n106\t    card.controller = prev_controller\n107\t    generic = card.mana_cost.generic if card.mana_cost else 0\n108\t    return max(0, min(raw, generic))\n109\t\n110\t\n111\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n112\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n113\t    new_generic = max(0, cost.generic - reduction)\n114\t    return ManaCost(\n115\t        generic=new_generic,\n116\t        pips=dict(cost.pips),\n117\t        x_count=cost.x_count,\n118\t        hybrid=list(cost.hybrid),\n119\t    )\n120\t\n121\t\n122\t# ------------------------------------------------------------------\n123\t# Cast spell\n124\t# ------------------------------------------------------------------\n125\t\n126\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n127\t    \"\"\"Cast *card* from *player*'s hand.\n128\t\n129\t    Pipeline\n130\t    --------\n131\t    1. **Timing check** — instants (and cards with flash) can be cast\n132\t       whenever the player has priority; everything else requires\n133\t       sorcery-speed timing.\n134\t    2. **can_cast** — ask the card whether it can legally be cast.\n135\t    3. **Hand check** — the card must be in the player's hand.\n136\t    4. **Move hand → stack zone** — remove the card from the hand and\n137\t       place it into the player's stack zone.\n138\t    5. **Choose targets** — if the card specifies targets (via\n139\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n140\t    6. **Mana check / payment** — the player's mana pool must be able to\n141\t       pay the card's mana cost.  If payment fails, the card is rolled\n142\t       back from the stack zone to the hand.\n143\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n144\t    8. **Push StackObject** — push a :class:`StackObject` whose\n145\t       ``on_resolve`` callback handles resolution.\n146\t\n147\t    Raises:\n148\t        CastingError: If any legality check fails.\n149\t    \"\"\"\n150\t    # 1. Timing\n151\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n152\t        raise CastingError(\n153\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n154\t        )\n155\t\n156\t    # 2. can_cast\n157\t    if not card.can_cast(game):\n158\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n159\t\n160\t    # 3. Hand check\n161\t    hand = game.get_hand(player)\n162\t    if not hand.contains(card):\n163\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n164\t\n165\t    # 4. Move card from hand to stack zone\n166\t    stack_zone = player.zones[Zone.STACK]\n167\t    hand.remove(card)\n168\t    stack_zone.add(card)\n169\t\n170\t    # Clear any stale colors_spent from a prior cast before new payment.\n171\t    if hasattr(card, \"colors_spent\"):\n172\t        del card.colors_spent\n173\t\n174\t    # 5. Choose targets\n175\t    target_specs = card.get_targets(game)\n176\t    chosen_targets: list[Any] = []\n177\t    if target_specs:\n178\t        for spec in target_specs:\n179\t            target = player.choose_target(target_specs, spec)\n180\t            # Validate against filter_fn if the spec provides one\n181\t            filter_fn = getattr(spec, \"filter_fn\", None)\n182\t            if filter_fn is not None and target is not None:\n183\t                if not filter_fn(target):\n184\t                    stack_zone.remove(card)\n185\t                    hand.add(card)\n186\t                    raise CastingError(\n187\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n188\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n189\t                    )\n190\t            chosen_targets.append(target)\n191\t\n192\t    # 5b. Protection check — reject targets that have protection from this\n193\t    #     spell (the T in DEBT).\n194\t    from engine.protection import has_protection_from\n195\t\n196\t    for target in chosen_targets:\n197\t        if has_protection_from(target, card):\n198\t            # Rollback: move card from stack zone back to hand\n199\t            stack_zone.remove(card)\n200\t            hand.add(card)\n201\t            raise CastingError(\n202\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n203\t            )\n204\t\n205\t    # Targets are stored on the StackObject (not the card) and passed\n206\t    # through the resolve pipeline via on_resolve(game, targets=...).\n207\t\n208\t    # 6. Mana check / payment (rollback on failure)\n209\t    # Ensure the card knows its controller so that cost_reduction() hooks\n210\t    # (e.g. Embercleave counting attacking creatures you control) see the\n211\t    # casting player, even for cards that were added to hand without an\n212\t    # explicit controller assignment.\n213\t    if card.controller is None:\n214\t        card.controller = player\n215\t    reduction = get_cost_reduction(game, card, player)\n216\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n217\t\n218\t    if not player.mana_pool.can_pay(effective_cost):\n219\t        # Rollback: move card from stack zone back to hand\n220\t        stack_zone.remove(card)\n221\t        hand.add(card)\n222\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n223\t\n224\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n225\t    player.mana_pool.pay(effective_cost)\n226\t\n227\t    # Store colors of mana spent on the card for mechanics like Converge\n228\t    # that care about the colors used to cast the spell.\n229\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n230\t\n231\t    # Record the total quantity of mana paid to cast this spell, for\n232\t    # mechanics like Mana Sculpt that add {C} equal to the mana spent.\n233\t    # X is included via its contribution to the effective cost's mana value.\n234\t    card.mana_spent = effective_cost.cmc  # type: ignore[attr-defined]\n235\t\n236\t    # 7. Call on_cast hook\n237\t    card.on_cast(game)\n238\t\n239\t    # 8. Build on_resolve callback and push StackObject\n240\t    stack_obj = StackObject(\n241\t        source=card,\n242\t        controller=player,\n243\t        targets=chosen_targets,\n244\t        on_resolve=lambda g: None,  # replaced below\n245\t    )\n246\t\n247\t    def _on_resolve(g: GameState) -> None:\n248\t        _resolve_spell(g, card, player, stack_obj)\n249\t\n250\t    stack_obj.on_resolve = _on_resolve\n251\t    game.stack.push(stack_obj)\n252\t\n253\t\n254\t# ------------------------------------------------------------------\n255\t# Cast spell without paying mana cost (free-cast from any zone)\n256\t# ------------------------------------------------------------------\n257\t\n258\t\n259\tdef cast_spell_free(\n260\t    game: GameState,\n261\t    player: Player,\n262\t    card: CardImpl,\n263\t    from_zone: Zone,\n264\t) -> None:\n265\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n266\t\n267\t    This is used by effects that allow casting from zones other than hand\n268\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n269\t    or cascade.\n270\t\n271\t    Pipeline\n272\t    --------\n273\t    1. **can_cast** — ask the card whether it can legally be cast (same\n274\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n275\t    2. Move *card* from *from_zone* to the stack zone.\n276\t    3. Choose targets (if applicable) with validation and protection check.\n277\t    4. Call ``on_cast`` hook.\n278\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n279\t       resolution normally (permanents → battlefield, non-permanents →\n280\t       graveyard).\n281\t\n282\t    No timing check or mana payment is performed.  The spell goes on the\n283\t    stack and can be responded to normally (e.g. countered).\n284\t\n285\t    If targeting or other post-move checks fail, the card is rolled back\n286\t    to its source zone.\n287\t\n288\t    Parameters:\n289\t        game: The current game state.\n290\t        player: The player casting the spell.\n291\t        card: The card to cast.\n292\t        from_zone: The zone the card is currently in.\n293\t\n294\t    Raises:\n295\t        CastingError: If the card cannot be found in *from_zone* or\n296\t            legality checks fail.\n297\t    \"\"\"\n298\t    from engine.zones import move_to_zone\n299\t\n300\t    # Ensure controller is set\n301\t    card.controller = player\n302\t    if card.owner is None:\n303\t        card.owner = player\n304\t\n305\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n306\t    if not card.can_cast(game):\n307\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n308\t\n309\t    # 2. Locate card in source zone\n310\t    source_zone_container = player.zones[from_zone]\n311\t    if not source_zone_container.contains(card):\n312\t        # Try to find the card in any player's zone\n313\t        source_zone_container = None\n314\t        for p in game.players:\n315\t            z = p.zones[from_zone]\n316\t            if z.contains(card):\n317\t                source_zone_container = z\n318\t                break\n319\t\n320\t    if source_zone_container is None or not source_zone_container.contains(card):\n321\t        raise CastingError(\n322\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n323\t        )\n324\t\n325\t    # Move card from source zone to stack zone\n326\t    stack_zone = player.zones[Zone.STACK]\n327\t    source_zone_container.remove(card)\n328\t    stack_zone.add(card)\n329\t\n330\t    # 3. Choose targets (with rollback on failure)\n331\t    try:\n332\t        target_specs = card.get_targets(game)\n333\t        chosen_targets: list[Any] = []\n334\t        if target_specs:\n335\t            for spec in target_specs:\n336\t                target = player.choose_target(target_specs, spec)\n337\t                # Validate against filter_fn if the spec provides one\n338\t                filter_fn = getattr(spec, \"filter_fn\", None)\n339\t                if filter_fn is not None and target is not None:\n340\t                    if not filter_fn(target):\n341\t                        raise CastingError(\n342\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n343\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n344\t                        )\n345\t                chosen_targets.append(target)\n346\t\n347\t        # Protection check — reject targets that have protection from this spell\n348\t        from engine.protection import has_protection_from\n349\t\n350\t        for target in chosen_targets:\n351\t            if has_protection_from(target, card):\n352\t                raise CastingError(\n353\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n354\t                )\n355\t    except Exception as exc:\n356\t        # Rollback: move card from stack zone back to source zone\n357\t        stack_zone.remove(card)\n358\t        source_zone_container.add(card)\n359\t        raise CastingError(str(exc)) from exc\n360\t\n361\t    # 4. Call on_cast hook\n362\t    card.on_cast(game)\n363\t\n364\t    # 5. Build on_resolve callback and push StackObject\n365\t    stack_obj = StackObject(\n366\t        source=card,\n367\t        controller=player,\n368\t        targets=chosen_targets,\n369\t        on_resolve=lambda g: None,  # replaced below\n370\t    )\n371\t\n372\t    def _on_resolve(g: GameState) -> None:\n373\t        _resolve_spell(g, card, player, stack_obj)\n374\t\n375\t    stack_obj.on_resolve = _on_resolve\n376\t    game.stack.push(stack_obj)\n377\t\n378\t\n379\t# ------------------------------------------------------------------\n380\t# Resolution (called when the stack pops)\n381\t# ------------------------------------------------------------------\n382\t\n383\tdef _resolve_spell(\n384\t    game: GameState,\n385\t    card: CardImpl,\n386\t    player: Player,\n387\t    stack_obj: StackObject,\n388\t) -> None:\n389\t    \"\"\"Resolve *card* cast by *player*.\n390\t\n391\t    1. Call ``card.on_resolve(game, targets=targets)``.\n392\t    2. Remove the card from the stack zone.\n393\t    3. If the card is a permanent type, move it to the battlefield via\n394\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n395\t       registration and the ETB event).\n396\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n397\t    \"\"\"\n398\t    from engine.zones import move_to_zone\n399\t\n400\t    # Read targets from the StackObject — the single source of truth.\n401\t    # Set chosen_targets on the card just before resolution so that\n402\t    # _get_chosen_target helpers (which read via getattr) work.\n403\t    targets = stack_obj.targets\n404\t    if targets is not None:\n405\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n406\t\n407\t    card.on_resolve(game)\n408\t\n409\t    if card.card_types & _PERMANENT_TYPES:\n410\t        # Move from stack to battlefield via move_to_zone, which handles\n411\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n412\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n413\t    else:\n414\t        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n415\t        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n416\t\n417\t\n418\t# ------------------------------------------------------------------\n419\t# Play land (special action — does not use the stack)\n420\t# ------------------------------------------------------------------\n421\t\n422\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n423\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n424\t\n425\t    Requirements (all must hold):\n426\t\n427\t    * *land_card* has :attr:`CardType.LAND`.\n428\t    * *player* is the active player.\n429\t    * Current phase is a main phase.\n430\t    * The stack is empty.\n431\t    * ``player.land_plays_remaining > 0``.\n432\t    * The card is in the player's hand.\n433\t\n434\t    On success the card moves from hand to battlefield and\n435\t    ``land_plays_remaining`` is decremented.\n436\t\n437\t    Raises:\n438\t        CastingError: If any requirement is not met.\n439\t    \"\"\"\n440\t    # Must be a land\n441\t    if CardType.LAND not in land_card.card_types:\n442\t        raise CastingError(\n443\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n444\t        )\n445\t\n446\t    # Sorcery-speed timing (active player, main phase, stack empty)\n447\t    if not is_sorcery_speed(game, player):\n448\t        raise CastingError(\n449\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n450\t            \"during main phase with empty stack\"\n451\t        )\n452\t\n453\t    # Land plays remaining\n454\t    if player.land_plays_remaining <= 0:\n455\t        raise CastingError(\n456\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n457\t        )\n458\t\n459\t    # Card must be in hand\n460\t    hand = game.get_hand(player)\n461\t    if not hand.contains(land_card):\n462\t        raise CastingError(\n463\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n464\t        )\n465\t\n466\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n467\t    if land_card.owner is None:\n468\t        land_card.owner = player\n469\t    land_card.controller = player\n470\t\n471\t    # Move from hand to battlefield via move_to_zone, which fires\n472\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n473\t    from engine.zones import move_to_zone\n474\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n475\t\n476\t    # Decrement land plays\n477\t    player.land_plays_remaining -= 1\n478\t\n479\t\n480\tdef resolve_top(game: GameState) -> None:\n481\t    \"\"\"Resolve the top spell/ability on the stack.\n482\t\n483\t    Pops the top item from the stack, calls its on_resolve callback,\n484\t    then runs state-based actions.  If the stack is empty this is a no-op.\n485\t    \"\"\"\n486\t    if game.stack.is_empty():\n487\t        return\n488\t    from engine.state_based_actions import resolve_state_based_actions\n489\t\n490\t    obj = game.stack.pop()\n491\t    obj.on_resolve(game)\n492\t    resolve_state_based_actions(game)\n493\t"}]},"parent_tool_use_id":"toolu_015rJSnz1LezCJNzSZuKfbai","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"10da3563-f877-4b6e-8b09-e0efdc294671","timestamp":"2026-06-01T09:02:12.712Z","subagent_type":"Tester","task_description":"Extend sos_57 tests for C bonus"}
