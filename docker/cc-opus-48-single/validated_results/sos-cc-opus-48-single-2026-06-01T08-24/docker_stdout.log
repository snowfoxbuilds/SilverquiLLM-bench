{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017QAFrQ53LugpBAXnnPytzq","type":"tool_result","content":"1\t\"\"\"Central game state and turn/phase/step progression.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import Any\n6\t\n7\tfrom engine.combat import CombatState\n8\tfrom engine.continuous_effects import EffectManager\n9\tfrom engine.player import Player\n10\tfrom engine.replacement_effects import ReplacementManager\n11\tfrom engine.stack import Stack\n12\tfrom engine.triggers import TriggerManager\n13\tfrom engine.types import Phase, Step, Zone\n14\tfrom engine.zones import ZoneContainer\n15\t\n16\t# Ordered list of (Phase, Step | None) representing a full MTG turn.\n17\t_TURN_SEQUENCE: list[tuple[Phase, Step | None]] = [\n18\t    # Beginning phase\n19\t    (Phase.BEGINNING, Step.UNTAP),\n20\t    (Phase.BEGINNING, Step.UPKEEP),\n21\t    (Phase.BEGINNING, Step.DRAW),\n22\t    # Precombat main phase\n23\t    (Phase.PRECOMBAT_MAIN, None),\n24\t    # Combat phase\n25\t    (Phase.COMBAT, Step.BEGIN_COMBAT),\n26\t    (Phase.COMBAT, Step.DECLARE_ATTACKERS),\n27\t    (Phase.COMBAT, Step.DECLARE_BLOCKERS),\n28\t    (Phase.COMBAT, Step.COMBAT_DAMAGE),\n29\t    (Phase.COMBAT, Step.END_COMBAT),\n30\t    # Postcombat main phase\n31\t    (Phase.POSTCOMBAT_MAIN, None),\n32\t    # Ending phase\n33\t    (Phase.ENDING, Step.END),\n34\t    (Phase.ENDING, Step.CLEANUP),\n35\t]\n36\t\n37\t\n38\tclass GameState:\n39\t    \"\"\"Central game-state object tracking all mutable game information.\n40\t\n41\t    Attributes:\n42\t        players: The list of players in the game.\n43\t        active_player_index: Index of the current active player.\n44\t        priority_player_index: Index of the player who currently has priority.\n45\t        phase: Current phase of the turn.\n46\t        step: Current step within the phase (``None`` for main phases).\n47\t        turn_number: The current turn number (1-indexed).\n48\t        stack: The game stack for spells and abilities.\n49\t        trigger_manager: Central registry for triggered abilities.\n50\t        replacement_manager: Central registry for replacement effects.\n51\t        effect_manager: Manager for continuous effects and the layer system.\n52\t        is_game_over: Whether the game has ended.\n53\t        winner: The winning player, or ``None`` if the game is ongoing / draw.\n54\t    \"\"\"\n55\t\n56\t    def __init__(self, players: list[Player]) -> None:\n57\t        if len(players) < 2:\n58\t            raise ValueError(\"GameState requires at least 2 players\")\n59\t        if len(players) > 2:\n60\t            raise ValueError(\"GameState supports exactly 2 players\")\n61\t\n62\t        self.players: list[Player] = players\n63\t        self.active_player_index: int = 0\n64\t        self.priority_player_index: int = 0\n65\t        self.phase: Phase = Phase.BEGINNING\n66\t        self.step: Step | None = Step.UNTAP\n67\t        self.turn_number: int = 1\n68\t        self.stack: Stack = Stack()\n69\t        self.trigger_manager: TriggerManager = TriggerManager()\n70\t        self.replacement_manager: ReplacementManager = ReplacementManager()\n71\t        self.effect_manager: EffectManager = EffectManager()\n72\t        self.combat_state: CombatState = CombatState()\n73\t        self.is_game_over: bool = False\n74\t        self.winner: Player | None = None\n75\t        # ENGINE LIMITATION: Extra turns queue (FIFO of player seat indices).\n76\t        # Complex interactions ('skip your next turn', multiple extra turns\n77\t        # from different sources) are not fully handled.\n78\t        self.extra_turns: list[int] = []\n79\t        # Tracks normal turn rotation independently of extra turns.\n80\t        # Extra turns are truly *inserted* — they don't advance the\n81\t        # normal rotation.  When extras are exhausted the game picks up\n82\t        # from _normal_next_index.\n83\t        self._normal_next_index: int = 1\n84\t\n85\t    # ------------------------------------------------------------------\n86\t    # Player properties\n87\t    # ------------------------------------------------------------------\n88\t\n89\t    @property\n90\t    def active_player(self) -> Player:\n91\t        \"\"\"Return the currently active player.\"\"\"\n92\t        return self.players[self.active_player_index]\n93\t\n94\t    @property\n95\t    def priority_player(self) -> Player:\n96\t        \"\"\"Return the player who currently has priority.\"\"\"\n97\t        return self.players[self.priority_player_index]\n98\t\n99\t    @property\n100\t    def non_active_player(self) -> Player:\n101\t        \"\"\"Return the non-active player (2-player assumption for v1).\"\"\"\n102\t        return self.players[1 - self.active_player_index]\n103\t\n104\t    # ------------------------------------------------------------------\n105\t    # Zone accessors\n106\t    # ------------------------------------------------------------------\n107\t\n108\t    def get_battlefield(self, player: Player) -> ZoneContainer:\n109\t        \"\"\"Return the battlefield zone for *player*.\"\"\"\n110\t        return player.zones[Zone.BATTLEFIELD]\n111\t\n112\t    def get_hand(self, player: Player) -> ZoneContainer:\n113\t        \"\"\"Return the hand zone for *player*.\"\"\"\n114\t        return player.zones[Zone.HAND]\n115\t\n116\t    def get_graveyard(self, player: Player) -> ZoneContainer:\n117\t        \"\"\"Return the graveyard zone for *player*.\"\"\"\n118\t        return player.zones[Zone.GRAVEYARD]\n119\t\n120\t    def get_library(self, player: Player) -> ZoneContainer:\n121\t        \"\"\"Return the library zone for *player*.\"\"\"\n122\t        return player.zones[Zone.LIBRARY]\n123\t\n124\t    def get_exile(self, player: Player) -> ZoneContainer:\n125\t        \"\"\"Return the exile zone for *player*.\"\"\"\n126\t        return player.zones[Zone.EXILE]\n127\t\n128\t    # ------------------------------------------------------------------\n129\t    # Phase/step progression\n130\t    # ------------------------------------------------------------------\n131\t\n132\t    def advance_phase(self) -> None:\n133\t        \"\"\"Advance to the next phase/step in MTG turn order.\n134\t\n135\t        At the end of CLEANUP, the turn number is incremented and the\n136\t        active player swaps (2-player assumption).  Mana pools are\n137\t        emptied on every transition.\n138\t        \"\"\"\n139\t        current = (self.phase, self.step)\n140\t        idx = _TURN_SEQUENCE.index(current)\n141\t\n142\t        if idx + 1 < len(_TURN_SEQUENCE):\n143\t            # Move to next phase/step within the same turn.\n144\t            next_phase, next_step = _TURN_SEQUENCE[idx + 1]\n145\t            self.phase = next_phase\n146\t            self.step = next_step\n147\t            self._fire_beginning_of_main_phase()\n148\t        else:\n149\t            # End of turn — wrap around.\n150\t            self.turn_number += 1\n151\t            if self.extra_turns:\n152\t                # ENGINE LIMITATION: Extra turns queue (FIFO). Pop the\n153\t                # next player seat index; that player gets the next turn.\n154\t                # Normal rotation is NOT advanced — extra turns are\n155\t                # inserted before the normal next turn.\n156\t                self.active_player_index = self.extra_turns.pop(0)\n157\t            else:\n158\t                self.active_player_index = self._normal_next_index\n159\t                self._normal_next_index = 1 - self._normal_next_index\n160\t            self.priority_player_index = self.active_player_index\n161\t            self.phase = _TURN_SEQUENCE[0][0]\n162\t            self.step = _TURN_SEQUENCE[0][1]\n163\t\n164\t        self.empty_mana_pools()\n165\t\n166\t    def empty_mana_pools(self) -> None:\n167\t        \"\"\"Empty all players' mana pools — called on each phase/step transition.\"\"\"\n168\t        for player in self.players:\n169\t            player.mana_pool.empty()\n170\t\n171\t    def _fire_beginning_of_main_phase(self) -> None:\n172\t        \"\"\"Fire ``BeginningOfMainPhaseTriggeredEvent`` if we just entered a main phase.\n173\t\n174\t        Additive hook used by delayed \"at the beginning of your next main\n175\t        phase\" triggers (e.g. Mana Sculpt's {C} bonus).  Safe no-op when the\n176\t        current phase is not a main phase.\n177\t        \"\"\"\n178\t        if self.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n179\t            return\n180\t        from engine.events import BeginningOfMainPhaseTriggeredEvent\n181\t\n182\t        self.trigger_manager.fire_event(\n183\t            self,\n184\t            BeginningOfMainPhaseTriggeredEvent(\n185\t                player=self.active_player, phase=self.phase\n186\t            ),\n187\t        )\n188\t"}]},"parent_tool_use_id":"toolu_01Um2fPsqJ5WALztNU1xs4f6","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"40ba0818-213e-43a4-aa3d-e763f3244ef1","timestamp":"2026-06-01T09:06:17.406Z","subagent_type":"Reviewer","task_description":"Review sos_57"}
