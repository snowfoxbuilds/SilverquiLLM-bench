{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UhLeWQ5Cm3qRp9mcVu726y","type":"tool_result","content":"440\t    def test_clamped_when_creature_count_exceeds_generic(self) -> None:\n441\t        \"\"\"Affinity reduces only the generic — with 6 creatures a {2}{R} spell\n442\t        drops to {0}{R} (clamped at 0), never below.\"\"\"\n443\t        from engine.casting import get_cost_reduction\n444\t\n445\t        game = create_game()\n446\t        p1 = game.players[0]\n447\t        game.phase = Phase.PRECOMBAT_MAIN\n448\t        game.step = None\n449\t        bears = [_bear(f\"Bear{i}\") for i in range(6)]\n450\t        _witherbloom_on_battlefield(game, p1, creatures=bears)\n451\t\n452\t        bolt = _test_instant(generic=2)\n453\t        bolt.controller = p1\n454\t        bolt.owner = p1\n455\t        # 6 creatures, but only {2} generic is reducible -> clamped to 2.\n456\t        assert get_cost_reduction(game, bolt, p1) == 2\n457\t\n458\t    def test_witherbloom_does_not_reduce_its_own_spell_via_registry(self) -> None:\n459\t        \"\"\"The registered reducer excludes Witherbloom itself — a second\n460\t        Witherbloom being cast is reduced only by its own affinity hook, not\n461\t        doubled by the registry.\"\"\"\n462\t        from engine.casting import get_cost_reduction\n463\t\n464\t        game = create_game()\n465\t        p1 = game.players[0]\n466\t        game.phase = Phase.PRECOMBAT_MAIN\n467\t        game.step = None\n468\t        bears = [_bear(\"A\"), _bear(\"B\")]\n469\t        _witherbloom_on_battlefield(game, p1, creatures=bears)\n470\t\n471\t        # A different Witherbloom copy being cast: its own cost_reduction()\n472\t        # counts the 2 bears (the battlefield Witherbloom is a creature too,\n473\t        # so 3 creatures total), but the registry's predicate skips\n474\t        # instant/sorcery only — a creature spell gets no registry bonus.\n475\t        second = WitherbloomTheBalancer(owner=p1, controller=p1)\n476\t        reduction = get_cost_reduction(game, second, p1)\n477\t        # 3 creatures you control (2 bears + the battlefield Witherbloom) ->\n478\t        # reduction 3 from its OWN hook; the registry adds nothing for a\n479\t        # creature spell. Clamped within the {6} generic.\n480\t        assert reduction == 3\n481\t\n482\t    def test_opponent_instant_not_reduced(self) -> None:\n483\t        \"\"\"The grant is \"spells YOU cast\" — an opponent's instant gets no\n484\t        reduction even with Witherbloom + creatures on the controller's side.\"\"\"\n485\t        from engine.casting import get_cost_reduction\n486\t\n487\t        game = create_game()\n488\t        p1 = game.players[0]\n489\t        p2 = game.players[1]\n490\t        game.phase = Phase.PRECOMBAT_MAIN\n491\t        game.step = None\n492\t        bears = [_bear(\"A\"), _bear(\"B\"), _bear(\"C\")]\n493\t        _witherbloom_on_battlefield(game, p1, creatures=bears)\n494\t\n495\t        opp_bolt = _test_instant(name=\"Opp Bolt\", generic=4)\n496\t        opp_bolt.controller = p2\n497\t        opp_bolt.owner = p2\n498\t        # p2 is not Witherbloom's controller -> no granted affinity.\n499\t        assert get_cost_reduction(game, opp_bolt, p2) == 0\n500\t\n501\t    def test_creature_spell_not_reduced_by_grant(self) -> None:\n502\t        \"\"\"The grant applies to instant/sorcery spells only — a separate\n503\t        creature spell the controller casts gets no registry reduction.\"\"\"\n504\t        from engine.casting import get_cost_reduction\n505\t        from engine.types import ManaCost\n506\t\n507\t        game = create_game()\n508\t        p1 = game.players[0]\n509\t        game.phase = Phase.PRECOMBAT_MAIN\n510\t        game.step = None\n511\t        bears = [_bear(\"A\"), _bear(\"B\"), _bear(\"C\")]\n512\t        _witherbloom_on_battlefield(game, p1, creatures=bears)\n513\t\n514\t        plain_creature = Creature(\n515\t            name=\"Hill Giant\", base_power=3, base_toughness=3,\n516\t            mana_cost=ManaCost.parse(\"{4}{R}\"),\n517\t        )\n518\t        plain_creature.card_types = {CardType.CREATURE}\n519\t        plain_creature.controller = p1\n520\t        plain_creature.owner = p1\n521\t        # A vanilla creature has no cost_reduction() hook of its own and the\n522\t        # registry skips non-instant/sorcery spells -> no reduction.\n523\t        assert get_cost_reduction(game, plain_creature, p1) == 0\n524\t\n525\t    def test_no_reduction_without_witherbloom_on_battlefield(self) -> None:\n526\t        \"\"\"Registry no-op: without Witherbloom in play, the same {4}{R} instant\n527\t        gets no affinity reduction even with creatures on the battlefield.\"\"\"\n528\t        from engine.casting import get_cost_reduction\n529\t\n530\t        game = create_game()\n531\t        p1 = game.players[0]\n532\t        game.phase = Phase.PRECOMBAT_MAIN\n533\t        game.step = None\n534\t        # Creatures but NO Witherbloom -> no reducer registered.\n535\t        set_board_state(game, 0, battlefield=[_bear(\"A\"), _bear(\"B\"), _bear(\"C\")])\n536\t\n537\t        bolt = _test_instant(generic=4)\n538\t        bolt.controller = p1\n539\t        bolt.owner = p1\n540\t        assert get_cost_reduction(game, bolt, p1) == 0\n541\t\n542\t    def test_unregister_removes_grant(self) -> None:\n543\t        \"\"\"After Witherbloom's reducer is unregistered (e.g. it leaves the\n544\t        battlefield), the controller's instant gets no further reduction.\"\"\"\n545\t        from engine.casting import get_cost_reduction\n546\t\n547\t        game = create_game()\n548\t        p1 = game.players[0]\n549\t        game.phase = Phase.PRECOMBAT_MAIN\n550\t        game.step = None\n551\t        bears = [_bear(\"A\"), _bear(\"B\"), _bear(\"C\")]\n552\t        wb = _witherbloom_on_battlefield(game, p1, creatures=bears)\n553\t\n554\t        bolt = _test_instant(generic=4)\n555\t        bolt.controller = p1\n556\t        bolt.owner = p1\n557\t        assert get_cost_reduction(game, bolt, p1) == 3\n558\t\n559\t        game.unregister_spell_cost_reducer(wb)"}]},"parent_tool_use_id":"toolu_01HwcPhRpe1q2HYXdHiQNaBQ","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"ce295e5f-b7d7-4137-aa8e-46b16d916fc6","timestamp":"2026-06-01T10:06:45.809Z","subagent_type":"Tester","task_description":"Extend sos_245 tests for registry"}
