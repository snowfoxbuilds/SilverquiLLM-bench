{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015h7EUgRRE4qpucNM66DtVs","type":"tool_result","content":"1\t\"\"\"Tests for SOS 13 — Emeritus of Truce // Swords to Plowshares.\n2\t\n3\tEmeritus of Truce is the creature face of a split / modal card:\n4\t\n5\t    Emeritus of Truce — {1}{W}{W} — 3/3 — Creature — Cat Cleric\n6\t      When this creature enters, target player creates a 1/1 white and\n7\t      black Inkling creature token with flying. Then if an opponent\n8\t      controls more creatures than you, this creature becomes prepared.\n9\t      (While it's prepared, you may cast a copy of its spell. Doing so\n10\t      unprepares it.)\n11\t\n12\t    Swords to Plowshares — {W} — Instant  (the \"spell\" side)\n13\t      Exile target creature. Its controller gains life equal to its power.\n14\t\n15\tThese tests are written in the TDD red phase — the implementation stub is\n16\tempty, so every behavioural test should fail until the card is built.\n17\t\n18\tThe tests focus on observable behaviour that the engine can express today:\n19\t- static card data for the creature face,\n20\t- the enters-the-battlefield Inkling token (its colors, flying, P/T, and\n21\t  the fact that it is created under the *chosen target player's* control),\n22\t- the conditional \"becomes prepared\" check that depends on relative\n23\t  creature counts.\n24\t\n25\tBehaviours that the current engine surface cannot express (the ``Prepared``\n26\tkeyword as a first-class flag, casting a copy of the spell side, and the\n27\t``Swords to Plowshares`` instant face itself) are recorded in\n28\t``untestable.json`` rather than asserted here.\n29\t\"\"\"\n30\t\n31\tfrom __future__ import annotations\n32\t\n33\tfrom typing import Any\n34\t\n35\tfrom cards.sos.sos_13.card_impl import EmeritusOfTruceSwordsToPlowshares\n36\tfrom engine.card import Creature\n37\tfrom engine.types import CardType, ManaCost\n38\tfrom test_utils import create_game, set_board_state\n39\t\n40\t\n41\tdef _make_card(owner: Any = None, controller: Any = None) -> EmeritusOfTruceSwordsToPlowshares:\n42\t    return EmeritusOfTruceSwordsToPlowshares(owner=owner, controller=controller)\n43\t\n44\t\n45\tdef _inkling_tokens(game: Any, player: Any) -> list[Any]:\n46\t    \"\"\"Return every Inkling token currently on *player*'s battlefield.\"\"\"\n47\t    bf = game.get_battlefield(player)\n48\t    result = []\n49\t    for obj in bf.get_all():\n50\t        subtypes = getattr(obj, \"subtypes\", set()) or set()\n51\t        if \"Inkling\" in subtypes:\n52\t            result.append(obj)\n53\t    return result\n54\t\n55\t\n56\tdef _resolve_etb(card: Any, game: Any) -> None:\n57\t    \"\"\"Drive the enters-the-battlefield effect.\n58\t\n59\t    The reference converge card (FDN 205) models an ``When this creature\n60\t    enters`` ability inside ``on_resolve``, so we call that first. If the\n61\t    implementation instead routes the ETB through a registered trigger, we\n62\t    fall back to firing an EntersBattlefieldTriggeredEvent and resolving the\n63\t    stack so the test is robust to either contract.\n64\t    \"\"\"\n65\t    card.on_resolve(game)\n66\t    if not game.stack.is_empty():\n67\t        _drain_stack(game)\n68\t        return\n69\t    # If on_resolve was a no-op (trigger-based contract), try the trigger path.\n70\t    from engine.events import EntersBattlefieldTriggeredEvent\n71\t\n72\t    card.register_triggers(game)\n73\t    game.trigger_manager.fire_event(\n74\t        game,\n75\t        EntersBattlefieldTriggeredEvent(\n76\t            permanent=card, controller=card.controller, creature=card, card=card\n77\t        ),\n78\t    )\n79\t    _drain_stack(game)\n80\t\n81\t\n82\tdef _drain_stack(game: Any) -> None:\n83\t    from engine.state_based_actions import resolve_state_based_actions\n84\t\n85\t    while not game.stack.is_empty():\n86\t        obj = game.stack.pop()\n87\t        obj.on_resolve(game)\n88\t        resolve_state_based_actions(game)\n89\t\n90\t\n91\t# ---------------------------------------------------------------------------\n92\t# Static card data (creature face)\n93\t# ---------------------------------------------------------------------------\n94\t\n95\t\n96\tclass TestEmeritusProperties:\n97\t    \"\"\"Static card data should match the SOS 13 spec (creature face).\"\"\"\n98\t\n99\t    def test_is_creature(self) -> None:\n100\t        card = _make_card()\n101\t        assert isinstance(card, Creature)\n102\t        assert CardType.CREATURE in card.card_types\n103\t\n104\t    def test_name(self) -> None:\n105\t        assert _make_card().name == \"Emeritus of Truce // Swords to Plowshares\"\n106\t\n107\t    def test_creature_face_mana_cost(self) -> None:\n108\t        # The permanent face is the {1}{W}{W} creature.\n109\t        assert _make_card().mana_cost == ManaCost.parse(\"{1}{W}{W}\")\n110\t\n111\t    def test_power_toughness(self) -> None:\n112\t        card = _make_card()\n113\t        assert card.base_power == 3\n114\t        assert card.base_toughness == 3\n115\t\n116\t    def test_subtypes_cat_cleric(self) -> None:\n117\t        subtypes = _make_card().subtypes\n118\t        assert \"Cat\" in subtypes\n119\t        assert \"Cleric\" in subtypes\n120\t\n121\t    def test_is_white(self) -> None:\n122\t        # {1}{W}{W} is mono-white.\n123\t        from test_utils import card_colors\n124\t\n125\t        assert card_colors(_make_card()) == {\"W\"}\n126\t\n127\t\n128\t# ---------------------------------------------------------------------------\n129\t# Enters-the-battlefield Inkling token\n130\t# ---------------------------------------------------------------------------\n131\t\n132\t\n133\tclass TestEmeritusInklingToken:\n134\t    \"\"\"ETB creates a 1/1 white & black Inkling with flying for a target player.\"\"\"\n135\t\n136\t    def test_etb_creates_one_inkling_for_chosen_player(self) -> None:\n137\t        game = create_game()\n138\t        p1 = game.players[0]\n139\t        card = _make_card(owner=p1, controller=p1)\n140\t        game.get_battlefield(p1).add(card)\n141\t        # Controller targets themselves to receive the token.\n142\t        card.chosen_targets = [p1]\n143\t\n144\t        before = len(_inkling_tokens(game, p1))\n145\t        _resolve_etb(card, game)\n146\t        after = len(_inkling_tokens(game, p1))\n147\t        assert after - before == 1\n148\t\n149\t    def test_inkling_is_one_one(self) -> None:\n150\t        game = create_game()\n151\t        p1 = game.players[0]\n152\t        card = _make_card(owner=p1, controller=p1)\n153\t        game.get_battlefield(p1).add(card)\n154\t        card.chosen_targets = [p1]\n155\t\n156\t        _resolve_etb(card, game)\n157\t        tokens = _inkling_tokens(game, p1)\n158\t        assert len(tokens) == 1\n159\t        tok = tokens[0]\n160\t        assert tok.base_power == 1\n161\t        assert tok.base_toughness == 1\n162\t\n163\t    def test_inkling_has_flying(self) -> None:\n164\t        from engine.types import Keyword\n165\t\n166\t        game = create_game()\n167\t        p1 = game.players[0]\n168\t        card = _make_card(owner=p1, controller=p1)\n169\t        game.get_battlefield(p1).add(card)\n170\t        card.chosen_targets = [p1]\n171\t\n172\t        _resolve_etb(card, game)\n173\t        tok = _inkling_tokens(game, p1)[0]\n174\t        assert Keyword.FLYING in tok.keywords\n175\t\n176\t    def test_inkling_is_white_and_black(self) -> None:\n177\t        game = create_game()\n178\t        p1 = game.players[0]\n179\t        card = _make_card(owner=p1, controller=p1)\n180\t        game.get_battlefield(p1).add(card)\n181\t        card.chosen_targets = [p1]\n182\t\n183\t        _resolve_etb(card, game)\n184\t        tok = _inkling_tokens(game, p1)[0]\n185\t        colors = getattr(tok, \"colors\", None)\n186\t        assert colors is not None, \"Inkling token should expose its colors\"\n187\t        color_values = {getattr(c, \"value\", c) for c in colors}\n188\t        assert \"W\" in color_values\n189\t        assert \"B\" in color_values\n190\t\n191\t    def test_inkling_is_a_token(self) -> None:\n192\t        game = create_game()\n193\t        p1 = game.players[0]\n194\t        card = _make_card(owner=p1, controller=p1)\n195\t        game.get_battlefield(p1).add(card)\n196\t        card.chosen_targets = [p1]\n197\t\n198\t        _resolve_etb(card, game)\n199\t        tok = _inkling_tokens(game, p1)[0]\n200\t        assert tok.is_token is True\n201\t\n202\t    def test_token_created_for_targeted_opponent_not_controller(self) -> None:\n203\t        \"\"\"\"target player\" — the token enters under the *chosen* player's\n204\t        control, which may be an opponent, not necessarily the card's\n205\t        controller.\"\"\"\n206\t        game = create_game()\n207\t        p1 = game.players[0]\n208\t        p2 = game.players[1]\n209\t        card = _make_card(owner=p1, controller=p1)\n210\t        game.get_battlefield(p1).add(card)\n211\t        # Controller (p1) chooses the opponent (p2) as the target player.\n212\t        card.chosen_targets = [p2]\n213\t\n214\t        _resolve_etb(card, game)\n215\t        assert len(_inkling_tokens(game, p2)) == 1\n216\t        assert len(_inkling_tokens(game, p1)) == 0\n217\t\n218\t\n219\t# ---------------------------------------------------------------------------\n220\t# Targeting contract\n221\t# ---------------------------------------------------------------------------\n222\t\n223\t\n224\tclass TestEmeritusTargeting:\n225\t    \"\"\"The creature spell itself takes no targets when cast.\n226\t\n227\t    The \"target player\" belongs to the enters-the-battlefield triggered\n228\t    ability, not to the creature spell. Following the sos_1 convention, the\n229\t    creature face must not advertise that target via the card-level\n230\t    ``get_targets`` while it is being cast (i.e. while in a STACK zone),\n231\t    otherwise the cast pipeline wrongly consumes a target.\n232\t    \"\"\"\n233\t\n234\t    def test_no_targets_while_on_stack(self) -> None:\n235\t        from engine.types import Zone\n236\t\n237\t        game = create_game()\n238\t        p1 = game.players[0]\n239\t        card = _make_card(owner=p1, controller=p1)\n240\t        # Simulate the cast pipeline placing the card in the STACK zone.\n241\t        p1.zones[Zone.STACK].add(card)\n242\t        assert card.get_targets(game) == []\n243\t\n244\t\n245\t# ---------------------------------------------------------------------------\n246\t# Conditional \"becomes prepared\"\n247\t# ---------------------------------------------------------------------------\n248\t\n249\t\n250\tclass TestEmeritusBecomesPrepared:\n251\t    \"\"\"\"Then if an opponent controls more creatures than you, this creature\n252\t    becomes prepared.\" The conditional must be evaluated against relative\n253\t    creature counts after the token is created.\n254\t\n255\t    The engine has no first-class ``Prepared`` keyword/flag, so the contract\n256\t    exposes the result via an ``is_prepared`` boolean on the card (defaulting\n257\t    to ``False``). These tests assert the conditional toggles that flag in the\n258\t    right direction; the actual copy-casting machinery is recorded as\n259\t    untestable.\n260\t    \"\"\"\n261\t\n262\t    def test_not_prepared_by_default(self) -> None:\n263\t        card = _make_card()\n264\t        assert getattr(card, \"is_prepared\", False) is False\n265\t\n266\t    def test_becomes_prepared_when_opponent_has_more_creatures(self) -> None:\n267\t        game = create_game()\n268\t        p1 = game.players[0]\n269\t        p2 = game.players[1]\n270\t        card = _make_card(owner=p1, controller=p1)\n271\t        set_board_state(game, 0, battlefield=[card])\n272\t        # Opponent controls two creatures; controller controls only Emeritus.\n273\t        opp_a = Creature(name=\"Bear A\", base_power=2, base_toughness=2)\n274\t        opp_b = Creature(name=\"Bear B\", base_power=2, base_toughness=2)\n275\t        set_board_state(game, 1, battlefield=[opp_a, opp_b])\n276\t        # Token goes to opponent here so opponent ends with 3 creatures > p1's 1.\n277\t        card.chosen_targets = [p1]\n278\t\n279\t        _resolve_etb(card, game)\n280\t        assert getattr(card, \"is_prepared\", False) is True\n281\t\n282\t    def test_not_prepared_when_counts_equal(self) -> None:\n283\t        game = create_game()\n284\t        p1 = game.players[0]\n285\t        p2 = game.players[1]\n286\t        card = _make_card(owner=p1, controller=p1)\n287\t        bear_you = Creature(name=\"Your Bear\", base_power=2, base_toughness=2)\n288\t        set_board_state(game, 0, battlefield=[card, bear_you])\n289\t        opp_a = Creature(name=\"Opp Bear\", base_power=2, base_toughness=2)\n290\t        set_board_state(game, 1, battlefield=[opp_a])\n291\t        # You target yourself, so after the token you have 3 vs opponent's 1.\n292\t        card.chosen_targets = [p1]\n293\t\n294\t        _resolve_etb(card, game)\n295\t        # Opponent does NOT control more creatures than you -> not prepared.\n296\t        assert getattr(card, \"is_prepared\", False) is False\n297\t\n298\t    def test_not_prepared_when_you_have_more_creatures(self) -> None:\n299\t        game = create_game()\n300\t        p1 = game.players[0]\n301\t        p2 = game.players[1]\n302\t        card = _make_card(owner=p1, controller=p1)\n303\t        bear1 = Creature(name=\"Your Bear 1\", base_power=2, base_toughness=2)\n304\t        bear2 = Creature(name=\"Your Bear 2\", base_power=2, base_toughness=2)\n305\t        set_board_state(game, 0, battlefield=[card, bear1, bear2])\n306\t        set_board_state(game, 1, battlefield=[])\n307\t        card.chosen_targets = [p1]\n308\t\n309\t        _resolve_etb(card, game)\n310\t        assert getattr(card, \"is_prepared\", False) is False\n311\t\n312\t\n313\t# ---------------------------------------------------------------------------\n314\t# Robustness\n315\t# ---------------------------------------------------------------------------\n316\t\n317\t\n318\tclass TestEmeritusRobustness:\n319\t    \"\"\"Resolution must not raise on degenerate inputs.\"\"\"\n320\t\n321\t    def test_resolve_without_chosen_target_does_not_raise(self) -> None:\n322\t        game = create_game()\n323\t        p1 = game.players[0]\n324\t        card = _make_card(owner=p1, controller=p1)\n325\t        game.get_battlefield(p1).add(card)\n326\t        # No chosen_targets set — resolution must not crash.\n327\t        card.on_resolve(game)\n328\t"}]},"parent_tool_use_id":"toolu_01F9yafmNtMYgjRqYhvsF8zA","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"6495b1da-ea6c-4809-b3a1-345f45d65bbf","timestamp":"2026-06-01T08:52:57.791Z","subagent_type":"Reviewer","task_description":"Review sos_13"}
