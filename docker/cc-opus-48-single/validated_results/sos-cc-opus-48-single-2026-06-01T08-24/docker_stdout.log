{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01V47iNhozwCQTJQRnfSyz5b","type":"tool_result","content":"1\t\"\"\"Reference test for FDN 215 — Bushwhack.\n2\t\n3\tIllustrative test covering **modal-choice / mode selection** mechanics.\n4\tBushwhack is a \"Choose one\" sorcery; the active mode is recorded on the\n5\tcard as ``chosen_mode`` (an int index into ``get_modes()``) and\n6\t``on_resolve`` dispatches on that value.\n7\t\"\"\"\n8\t\n9\tfrom __future__ import annotations\n10\t\n11\tfrom cards.fdn.fdn_215.card_impl import Bushwhack\n12\tfrom engine.card import Mode, Sorcery\n13\tfrom engine.types import CardType, ManaCost, Supertype, Zone\n14\tfrom test_utils import create_game\n15\t\n16\t\n17\tclass TestBushwhackProperties:\n18\t    \"\"\"Static card data should match the FDN 215 spec.\"\"\"\n19\t\n20\t    def test_is_sorcery(self) -> None:\n21\t        card = Bushwhack(owner=None)\n22\t        assert isinstance(card, Sorcery)\n23\t\n24\t    def test_name(self) -> None:\n25\t        assert Bushwhack(owner=None).name == \"Bushwhack\"\n26\t\n27\t    def test_mana_cost(self) -> None:\n28\t        assert Bushwhack(owner=None).mana_cost == ManaCost.parse(\"{G}\")\n29\t\n30\t\n31\tclass TestBushwhackModalDeclaration:\n32\t    \"\"\"get_modes() should declare exactly two modes.\"\"\"\n33\t\n34\t    def test_returns_two_modes(self) -> None:\n35\t        modes = Bushwhack(owner=None).get_modes()\n36\t        assert len(modes) == 2\n37\t\n38\t    def test_each_mode_is_mode_instance(self) -> None:\n39\t        modes = Bushwhack(owner=None).get_modes()\n40\t        for m in modes:\n41\t            assert isinstance(m, Mode)\n42\t\n43\t\n44\tclass TestBushwhackModeSelection:\n45\t    \"\"\"chosen_mode drives the on_resolve branch.\"\"\"\n46\t\n47\t    def test_chosen_mode_defaults_to_none(self) -> None:\n48\t        card = Bushwhack(owner=None)\n49\t        assert card.chosen_mode is None\n50\t\n51\t    def test_chosen_mode_zero_runs_land_search(self) -> None:\n52\t        \"\"\"Mode 0 = search library for a basic land. With no basic lands\n53\t        in the library, the search no-ops but does not raise.\"\"\"\n54\t        from engine.card import CardImpl\n55\t\n56\t        game = create_game()\n57\t        p1 = game.players[0]\n58\t        # Library is empty — search will find nothing but should not crash.\n59\t        card = Bushwhack(owner=p1, controller=p1)\n60\t        card.chosen_mode = 0\n61\t        card.on_resolve(game)\n62\t        # No card moved to hand.\n63\t        assert len(p1.zones[Zone.HAND].get_all()) == 0\n64\t\n65\t    def test_chosen_mode_one_runs_fight_branch(self) -> None:\n66\t        \"\"\"Mode 1 = fight. With no chosen_targets, the fight branch no-ops.\"\"\"\n67\t        game = create_game()\n68\t        p1 = game.players[0]\n69\t        card = Bushwhack(owner=p1, controller=p1)\n70\t        card.chosen_mode = 1\n71\t        # No chosen_targets — fight branch exits without dealing damage.\n72\t        card.on_resolve(game)\n73\t\n74\t    def test_no_mode_skips_resolution(self) -> None:\n75\t        \"\"\"When chosen_mode is None, on_resolve returns immediately.\"\"\"\n76\t        game = create_game()\n77\t        p1 = game.players[0]\n78\t        card = Bushwhack(owner=p1, controller=p1)\n79\t        # chosen_mode left as None.\n80\t        card.on_resolve(game)\n81\t        assert len(p1.zones[Zone.HAND].get_all()) == 0\n82\t"}]},"parent_tool_use_id":"toolu_015YjqSJ8qf6KKiKFJ4NXToW","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"861cc0cd-0129-4596-8a6c-5e07a9b28026","timestamp":"2026-06-01T09:48:11.176Z","subagent_type":"Tester","task_description":"Write tests for sos_226"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Xbx2jZWieH3A4pFupup9MH","type":"tool_result","content":"1\t# Test Utilities API Reference\n2\t\n3\tHelper functions for writing card tests. Import from `test_utils`.\n4\t\n5\t## Functions\n6\t\n7\t### `create_game`\n8\t\n9\t`create_game(deck1=None, deck2=None, *, player1_life=20, player2_life=20, scripts=None) -> GameState`\n10\t\n11\tCreate a two-player game with `DeterministicPlayer` instances. Decks default to empty lists.\n12\t\n13\t```python\n14\tfrom test_utils import create_game\n15\tgame = create_game(player1_life=25)\n16\t```\n17\t\n18\t### `set_board_state`\n19\t\n20\t`set_board_state(game, player_index, *, battlefield=None, hand=None, graveyard=None, life=None, mana=None) -> None`\n21\t\n22\tSet zone contents and player state. Only zones explicitly provided are modified.\n23\t\n24\t- **hand / battlefield / graveyard** — `list` of card objects.\n25\t- **mana** — `dict[ManaType, int]`.\n26\t\n27\t```python\n28\tfrom test_utils import create_game, set_board_state\n29\tfrom engine.types import ManaType\n30\tfrom cards.fdn.fdn_13.card_impl import FleetingFlight\n31\tfrom engine.card import Creature\n32\t\n33\tgame = create_game()\n34\tset_board_state(game, 0, hand=[FleetingFlight(owner=None)], mana={ManaType.WHITE: 2})\n35\tbear = Creature(name=\"Grizzly Bears\", base_power=2, base_toughness=2)\n36\tset_board_state(game, 1, battlefield=[bear], life=15)\n37\t```\n38\t\n39\t### `cast_spell`\n40\t\n41\t`cast_spell(game, player_index, card_name, targets=None) -> None`\n42\t\n43\tFind a card in hand by name, cast it, and resolve. Sets sorcery-speed timing automatically.\n44\t\n45\t```python\n46\tfrom test_utils import create_game, set_board_state, cast_spell\n47\tfrom engine.types import ManaType\n48\tfrom cards.fdn.fdn_13.card_impl import FleetingFlight\n49\t\n50\tgame = create_game()\n51\tset_board_state(game, 0, hand=[FleetingFlight(owner=None)], mana={ManaType.WHITE: 2})\n52\tcast_spell(game, 0, \"Fleeting Flight\")\n53\t```\n54\t\n55\t### `advance_to_phase`\n56\t\n57\t`advance_to_phase(game, phase, step=None) -> None`\n58\t\n59\tFast-forward to the specified phase/step without granting priority.\n60\t\n61\t```python\n62\tfrom test_utils import create_game, advance_to_phase\n63\tfrom engine.types import Phase, Step\n64\t\n65\tgame = create_game()\n66\tadvance_to_phase(game, Phase.COMBAT, Step.DECLARE_ATTACKERS)\n67\t```\n68\t\n69\t### `declare_attackers`\n70\t\n71\t`declare_attackers(game, attacker_names) -> None`\n72\t\n73\tAdvance to combat and declare creatures as attackers by name from the active player's battlefield.\n74\t\n75\t```python\n76\tfrom test_utils import create_game, set_board_state, declare_attackers\n77\tfrom engine.card import Creature\n78\t\n79\tgame = create_game()\n80\tbear = Creature(name=\"Grizzly Bears\", base_power=2, base_toughness=2)\n81\tset_board_state(game, 0, battlefield=[bear])\n82\tdeclare_attackers(game, [\"Grizzly Bears\"])\n83\t```\n84\t\n85\t### `declare_blockers`\n86\t\n87\t`declare_blockers(game, assignments) -> None`\n88\t\n89\tAssign blockers by name mapping: `{\"attacker_name\": [\"blocker_name\", ...]}`.\n90\t\n91\t```python\n92\tfrom test_utils import create_game, set_board_state, declare_attackers, declare_blockers\n93\tfrom engine.card import Creature\n94\t\n95\tgame = create_game()\n96\tbear = Creature(name=\"Grizzly Bears\", base_power=2, base_toughness=2)\n97\twall = Creature(name=\"Wall of Wood\", base_power=0, base_toughness=3)\n98\tset_board_state(game, 0, battlefield=[bear])\n99\tset_board_state(game, 1, battlefield=[wall])\n100\tdeclare_attackers(game, [\"Grizzly Bears\"])\n101\tdeclare_blockers(game, {\"Grizzly Bears\": [\"Wall of Wood\"]})\n102\t```\n103\t\n104\t## Test Structure\n105\t\n106\t```python\n107\timport pytest\n108\tfrom test_utils import create_game, set_board_state, cast_spell\n109\tfrom cards.sos.sos_1.card_impl import TheDawningArchaic\n110\tfrom engine.types import ManaType\n111\t\n112\tclass TestTheDawningArchaic:\n113\t    def test_basic_cast(self):\n114\t        game = create_game()\n115\t        set_board_state(game, 0, hand=[TheDawningArchaic(owner=None)],\n116\t                        mana={ManaType.COLORLESS: 10})\n117\t        cast_spell(game, 0, \"The Dawning Archaic\")\n118\t        assert game.players[0].life == 20\n119\t```\n120\t\n121\t## Constraints\n122\t\n123\t- **Max 30 tests per card.**\n124\t- Import helpers from `test_utils`.\n125\t- Import card implementations from `cards.sos.sos_<N>.card_impl` (SOS cards you\n126\t  are building) or `cards.fdn.fdn_<N>.card_impl` (FDN reference cards).\n127\t"}]},"parent_tool_use_id":"toolu_015YjqSJ8qf6KKiKFJ4NXToW","session_id":"eb6f4bd5-6767-4f31-a917-ac0bdc13b45e","uuid":"c3c9e006-716e-4fbc-b61d-24c8f1418674","timestamp":"2026-06-01T09:48:11.177Z","subagent_type":"Tester","task_description":"Write tests for sos_226"}
