{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QR4K9Ub5qUX7a1k8fLGtdk","type":"tool_result","content":"1\t\"\"\"Tests for SOS 201 — Lorehold, the Historian.\n2\t\n3\tLorehold, the Historian ({3}{R}{W} Legendary Creature — Elder Dragon, 5/5)\n4\thas three distinct pieces of behaviour, each covered by its own test class:\n5\t\n6\t1. **Static card data** — name, mana cost, colors, P/T, legendary supertype,\n7\t   Elder Dragon subtypes, and the Flying + Haste keyword set.\n8\t\n9\t2. **Miracle granting** — \"Each instant and sorcery card in your hand has\n10\t   miracle {2}.\" The engine has no native ``miracle`` keyword, so this is the\n11\t   SOS-specific surface the implementer must expose.  These tests probe the\n12\t   observable contract: a method/attribute that reports the miracle cost\n13\t   ({2}) of the controller's hand instants/sorceries while Lorehold is on the\n14\t   battlefield, and that the grant is scoped to instants/sorceries in *your*\n15\t   hand (not creatures, not opponents' hands).  Where the engine genuinely\n16\t   lacks the surface to assert deeper behaviour (the actual draw-step miracle\n17\t   cast), the requirement is recorded in untestable.json.\n18\t\n19\t3. **Opponent-upkeep loot trigger** — \"At the beginning of each opponent's\n20\t   upkeep, you may discard a card. If you do, draw a card.\"  Modelled via\n21\t   ``register_triggers`` wiring a ``BeginningOfUpkeepTriggeredEvent`` trigger\n22\t   whose condition fires only on an opponent's upkeep (when the active player\n23\t   is not the controller), and whose effect optionally discards-then-draws.\n24\t\n25\tThese are TDD red-phase tests: the stub at ``card_impl.py`` is empty, so\n26\teverything here is expected to fail until the card is implemented.\n27\t\"\"\"\n28\t\n29\tfrom __future__ import annotations\n30\t\n31\tfrom typing import Any\n32\t\n33\tfrom cards.sos.sos_201.card_impl import LoreholdTheHistorian\n34\tfrom engine.card import Creature, Instant, Sorcery\n35\tfrom engine.events import BeginningOfUpkeepTriggeredEvent\n36\tfrom engine.types import (\n37\t    CardType,\n38\t    Color,\n39\t    Keyword,\n40\t    ManaCost,\n41\t    Supertype,\n42\t    Zone,\n43\t)\n44\tfrom test_utils import create_game, set_board_state\n45\t\n46\t\n47\t# ---------------------------------------------------------------------------\n48\t# Card factories for hand / graveyard setup\n49\t# ---------------------------------------------------------------------------\n50\t\n51\t\n52\tdef _instant(name: str = \"Test Bolt\") -> Instant:\n53\t    \"\"\"A vanilla instant card for hand setup.\"\"\"\n54\t    return Instant(name=name, mana_cost=ManaCost.parse(\"{R}\"))\n55\t\n56\t\n57\tdef _sorcery(name: str = \"Test Divination\") -> Sorcery:\n58\t    \"\"\"A vanilla sorcery card for hand setup.\"\"\"\n59\t    return Sorcery(name=name, mana_cost=ManaCost.parse(\"{2}{U}\"))\n60\t\n61\t\n62\tdef _vanilla_creature(name: str = \"Grizzly Bears\") -> Creature:\n63\t    \"\"\"A vanilla creature card (not an instant/sorcery).\"\"\"\n64\t    return Creature(name=name, base_power=2, base_toughness=2)\n65\t\n66\t\n67\tdef _lorehold(game: Any) -> LoreholdTheHistorian:\n68\t    \"\"\"Lorehold owned/controlled by player 0.\"\"\"\n69\t    p1 = game.players[0]\n70\t    return LoreholdTheHistorian(owner=p1, controller=p1)\n71\t\n72\t\n73\t# ---------------------------------------------------------------------------\n74\t# 1. Static card data\n75\t# ---------------------------------------------------------------------------\n76\t\n77\t\n78\tclass TestLoreholdProperties:\n79\t    \"\"\"Static card data should match the SOS 201 spec.\"\"\"\n80\t\n81\t    def test_is_creature(self) -> None:\n82\t        card = LoreholdTheHistorian(owner=None)\n83\t        assert isinstance(card, Creature)\n84\t        assert CardType.CREATURE in card.card_types\n85\t\n86\t    def test_name(self) -> None:\n87\t        assert LoreholdTheHistorian(owner=None).name == \"Lorehold, the Historian\"\n88\t\n89\t    def test_mana_cost(self) -> None:\n90\t        assert LoreholdTheHistorian(owner=None).mana_cost == ManaCost.parse(\"{3}{R}{W}\")\n91\t\n92\t    def test_power_toughness(self) -> None:\n93\t        card = LoreholdTheHistorian(owner=None)\n94\t        assert card.base_power == 5\n95\t        assert card.base_toughness == 5\n96\t\n97\t    def test_is_legendary(self) -> None:\n98\t        assert Supertype.LEGENDARY in LoreholdTheHistorian(owner=None).supertypes\n99\t\n100\t    def test_is_elder_dragon(self) -> None:\n101\t        card = LoreholdTheHistorian(owner=None)\n102\t        assert {\"Elder\", \"Dragon\"} <= card.subtypes\n103\t\n104\t    def test_colors_are_red_and_white(self) -> None:\n105\t        card = LoreholdTheHistorian(owner=None)\n106\t        assert card.colors == {Color.RED, Color.WHITE}\n107\t\n108\t    def test_has_flying(self) -> None:\n109\t        assert Keyword.FLYING in LoreholdTheHistorian(owner=None).keywords\n110\t\n111\t    def test_has_haste(self) -> None:\n112\t        assert Keyword.HASTE in LoreholdTheHistorian(owner=None).keywords\n113\t\n114\t    def test_no_extraneous_keywords(self) -> None:\n115\t        # Guard against an over-broad keyword grant: only Flying + Haste.\n116\t        kw = LoreholdTheHistorian(owner=None).keywords\n117\t        assert kw == (Keyword.FLYING | Keyword.HASTE)\n118\t\n119\t\n120\t# ---------------------------------------------------------------------------\n121\t# 2. Miracle granting — \"Each instant and sorcery card in your hand has\n122\t#    miracle {2}.\"\n123\t# ---------------------------------------------------------------------------\n124\t\n125\t\n126\tclass TestLoreholdMiracleGrant:\n127\t    \"\"\"The controller's hand instants/sorceries should report a miracle cost\n128\t    of {2} while Lorehold is on the battlefield.\n129\t\n130\t    The grant surface is whatever the implementer exposes.  We probe the two\n131\t    most plausible observable shapes and accept either:\n132\t      * a method ``miracle_cost(game, card)`` on Lorehold returning a ManaCost\n133\t        (or None for non-qualifying cards), or\n134\t      * a ``card.miracle_cost`` attribute set on the affected hand cards.\n135\t    A test helper resolves whichever exists.\n136\t    \"\"\"\n137\t\n138\t    MIRACLE = ManaCost.parse(\"{2}\")\n139\t\n140\t    @staticmethod\n141\t    def _miracle_cost_of(lorehold: Any, game: Any, card: Any) -> Any:\n142\t        \"\"\"Return the miracle cost the implementation assigns to *card*.\n143\t\n144\t        Tries Lorehold.miracle_cost(game, card) first, then a per-card\n145\t        ``miracle_cost`` attribute.  Returns None if neither is present.\n146\t        \"\"\"\n147\t        fn = getattr(lorehold, \"miracle_cost\", None)\n148\t        if callable(fn):\n149\t            return fn(game, card)\n150\t        return getattr(card, \"miracle_cost\", None)\n151\t\n152\t    def test_hand_instant_has_miracle_two(self) -> None:\n153\t        game = create_game()\n154\t        p1 = game.players[0]\n155\t        card = _lorehold(game)\n156\t        bolt = _instant(\"Hand Bolt\")\n157\t        set_board_state(game, 0, battlefield=[card], hand=[bolt])\n158\t        cost = self._miracle_cost_of(card, game, bolt)\n159\t        assert cost == self.MIRACLE\n160\t\n161\t    def test_hand_sorcery_has_miracle_two(self) -> None:\n162\t        game = create_game()\n163\t        p1 = game.players[0]\n164\t        card = _lorehold(game)\n165\t        sorc = _sorcery(\"Hand Sorcery\")\n166\t        set_board_state(game, 0, battlefield=[card], hand=[sorc])\n167\t        cost = self._miracle_cost_of(card, game, sorc)\n168\t        assert cost == self.MIRACLE\n169\t\n170\t    def test_hand_creature_does_not_get_miracle(self) -> None:\n171\t        \"\"\"Only instant and sorcery cards gain miracle — not creatures.\"\"\"\n172\t        game = create_game()\n173\t        card = _lorehold(game)\n174\t        bear = _vanilla_creature(\"Hand Bear\")\n175\t        set_board_state(game, 0, battlefield=[card], hand=[bear])\n176\t        cost = self._miracle_cost_of(card, game, bear)\n177\t        assert cost in (None, ManaCost()) or cost != self.MIRACLE\n178\t\n179\t    def test_opponent_hand_instant_does_not_get_miracle(self) -> None:\n180\t        \"\"\"'in your hand' — an instant in an opponent's hand is unaffected.\"\"\"\n181\t        game = create_game()\n182\t        card = _lorehold(game)\n183\t        set_board_state(game, 0, battlefield=[card])\n184\t        opp_bolt = _instant(\"Opp Bolt\")\n185\t        set_board_state(game, 1, hand=[opp_bolt])\n186\t        cost = self._miracle_cost_of(card, game, opp_bolt)\n187\t        assert cost in (None, ManaCost()) or cost != self.MIRACLE\n188\t\n189\t\n190\t# ---------------------------------------------------------------------------\n191\t# 3. Opponent-upkeep loot trigger registration\n192\t# ---------------------------------------------------------------------------\n193\t\n194\t\n195\tclass TestLoreholdUpkeepTriggerRegistration:\n196\t    \"\"\"register_triggers wires a BeginningOfUpkeepTriggeredEvent trigger keyed\n197\t    to opponents' upkeeps.\"\"\"\n198\t\n199\t    def test_registers_one_trigger(self) -> None:\n200\t        game = create_game()\n201\t        card = _lorehold(game)\n202\t        before = len(game.trigger_manager.get_triggers_for_source(card))\n203\t        card.register_triggers(game)\n204\t        after = len(game.trigger_manager.get_triggers_for_source(card))\n205\t        assert after - before == 1\n206\t\n207\t    def test_trigger_watches_upkeep_event(self) -> None:\n208\t        game = create_game()\n209\t        card = _lorehold(game)\n210\t        card.register_triggers(game)\n211\t        regs = game.trigger_manager.get_triggers_for_source(card)\n212\t        assert len(regs) == 1\n213\t        assert regs[0].event_type is BeginningOfUpkeepTriggeredEvent\n214\t\n215\t    def test_trigger_controller_is_card_controller(self) -> None:\n216\t        game = create_game()\n217\t        p1 = game.players[0]\n218\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n219\t        card.register_triggers(game)\n220\t        reg = game.trigger_manager.get_triggers_for_source(card)[0]\n221\t        assert reg.controller is p1\n222\t\n223\t    def test_trigger_fires_on_opponents_upkeep(self) -> None:\n224\t        \"\"\"The trigger must fire when the active player (whose upkeep it is) is\n225\t        an opponent of the controller.\"\"\"\n226\t        game = create_game()\n227\t        p1 = game.players[0]\n228\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n229\t        card.register_triggers(game)\n230\t        reg = game.trigger_manager.get_triggers_for_source(card)[0]\n231\t        if reg.condition is None:\n232\t            raise AssertionError(\n233\t                \"Upkeep trigger must be scoped to opponents' upkeeps, not all upkeeps\"\n234\t            )\n235\t        # Opponent (player index 1) is the active player whose upkeep begins.\n236\t        game.active_player_index = 1\n237\t        event = BeginningOfUpkeepTriggeredEvent()\n238\t        assert reg.condition(game, event) is True\n239\t\n240\t    def test_trigger_does_not_fire_on_own_upkeep(self) -> None:\n241\t        \"\"\"The trigger is 'each opponent's upkeep' — not the controller's.\"\"\"\n242\t        game = create_game()\n243\t        p1 = game.players[0]\n244\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n245\t        card.register_triggers(game)\n246\t        reg = game.trigger_manager.get_triggers_for_source(card)[0]\n247\t        if reg.condition is None:\n248\t            raise AssertionError(\n249\t                \"Upkeep trigger must be scoped to opponents' upkeeps, not all upkeeps\"\n250\t            )\n251\t        # Controller (player index 0) is the active player.\n252\t        game.active_player_index = 0\n253\t        event = BeginningOfUpkeepTriggeredEvent()\n254\t        assert reg.condition(game, event) is False\n255\t\n256\t\n257\t# ---------------------------------------------------------------------------\n258\t# 3b. Opponent-upkeep loot trigger effect — discard then draw\n259\t# ---------------------------------------------------------------------------\n260\t\n261\t\n262\tclass TestLoreholdUpkeepTriggerFires:\n263\t    \"\"\"Firing the event on an opponent's upkeep pushes the trigger onto the\n264\t    stack; firing on the controller's own upkeep does not.\"\"\"\n265\t\n266\t    def _setup(self) -> tuple[Any, Any, LoreholdTheHistorian]:\n267\t        game = create_game()\n268\t        p1 = game.players[0]\n269\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n270\t        set_board_state(game, 0, battlefield=[card])\n271\t        card.register_triggers(game)\n272\t        return game, p1, card\n273\t\n274\t    def test_opponent_upkeep_event_pushes_trigger(self) -> None:\n275\t        game, p1, card = self._setup()\n276\t        game.active_player_index = 1\n277\t        assert game.stack.is_empty()\n278\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n279\t        assert not game.stack.is_empty()\n280\t\n281\t    def test_own_upkeep_event_does_not_push_trigger(self) -> None:\n282\t        game, p1, card = self._setup()\n283\t        game.active_player_index = 0\n284\t        assert game.stack.is_empty()\n285\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n286\t        assert game.stack.is_empty()\n287\t\n288\t\n289\tclass TestLoreholdLootEffect:\n290\t    \"\"\"Resolving the trigger: 'you may discard a card. If you do, draw a card.'\n291\t\n292\t    The controller's optionality is driven by ``choose_yes_no`` and the card to\n293\t    discard by ``choose_card`` (DeterministicPlayer script).  We resolve the\n294\t    trigger StackObject directly to observe the discard + draw.\n295\t    \"\"\"\n296\t\n297\t    def _build(self, scripts, *, hand, library):\n298\t        \"\"\"Build a game with Lorehold on player 0's battlefield, player 0 the\n299\t        controller, with a scripted hand and a library to draw from.  Player 1\n300\t        is the active player (opponent's upkeep).\"\"\"\n301\t        game = create_game(scripts=scripts)\n302\t        p1 = game.players[0]\n303\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n304\t        set_board_state(game, 0, battlefield=[card], hand=hand)\n305\t        # Seed the controller's library so a draw has something to find.\n306\t        lib = game.get_library(p1)\n307\t        for obj in lib.get_all():\n308\t            lib.remove(obj)\n309\t        for c in library:\n310\t            c.owner = p1\n311\t            c.controller = p1\n312\t            lib.add(c)\n313\t        card.register_triggers(game)\n314\t        game.active_player_index = 1\n315\t        return game, p1, card\n316\t\n317\t    def _fire_and_resolve(self, game, card):\n318\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n319\t        assert not game.stack.is_empty(), \"opponent upkeep trigger should be on stack\"\n320\t        trigger_obj = game.stack.pop()\n321\t        trigger_obj.on_resolve(game)\n322\t\n323\t    def test_yes_discards_chosen_card_and_draws(self) -> None:\n324\t        \"\"\"Choosing 'yes' discards the chosen card and then draws one.\"\"\"\n325\t        discard_me = _instant(\"Discard Me\")\n326\t        draw_me = _vanilla_creature(\"Draw Me\")\n327\t        # Script: choose_yes_no -> True, choose_card -> the card to discard.\n328\t        game, p1, card = self._build(\n329\t            scripts=([True, discard_me], []),\n330\t            hand=[discard_me],\n331\t            library=[draw_me],\n332\t        )\n333\t\n334\t        self._fire_and_resolve(game, card)\n335\t\n336\t        gy = game.get_graveyard(p1)\n337\t        hand = game.get_hand(p1)\n338\t        assert gy.contains(discard_me), \"chosen card should be discarded to graveyard\"\n339\t        assert hand.contains(draw_me), \"controller should have drawn the top library card\"\n340\t        assert not hand.contains(discard_me), \"discarded card must leave the hand\"\n341\t\n342\t    def test_yes_is_net_neutral_hand_size(self) -> None:\n343\t        \"\"\"Discard one, draw one — hand size is unchanged after a 'yes'.\"\"\"\n344\t        discard_me = _instant(\"Discard Me\")\n345\t        draw_me = _sorcery(\"Draw Me\")\n346\t        game, p1, card = self._build(\n347\t            scripts=([True, discard_me], []),\n348\t            hand=[discard_me],\n349\t            library=[draw_me],\n350\t        )\n351\t\n352\t        self._fire_and_resolve(game, card)\n353\t\n354\t        assert len(game.get_hand(p1).get_all()) == 1\n355\t\n356\t    def test_no_does_not_discard_or_draw(self) -> None:\n357\t        \"\"\"'you may' — declining leaves the hand and library untouched.\"\"\"\n358\t        keep_me = _instant(\"Keep Me\")\n359\t        draw_me = _vanilla_creature(\"Draw Me\")\n360\t        # Script: choose_yes_no -> False.  No choose_card / draw should happen.\n361\t        game, p1, card = self._build(\n362\t            scripts=([False], []),\n363\t            hand=[keep_me],\n364\t            library=[draw_me],\n365\t        )\n366\t\n367\t        self._fire_and_resolve(game, card)\n368\t\n369\t        hand = game.get_hand(p1)\n370\t        gy = game.get_graveyard(p1)\n371\t        assert hand.contains(keep_me), \"declined loot should keep the card in hand\"\n372\t        assert not gy.contains(keep_me), \"nothing should be discarded on 'no'\"\n373\t        assert not hand.contains(draw_me), \"no draw should happen on 'no'\"\n374\t        assert len(hand.get_all()) == 1\n375\t\n376\t    def test_empty_hand_does_not_draw(self) -> None:\n377\t        \"\"\"'If you do' — with no card to discard, no draw occurs.\n378\t\n379\t        With an empty hand the player cannot discard, so the conditional draw\n380\t        must not fire.  An empty script proves no prompt forces a discard that\n381\t        cannot be paid.\n382\t        \"\"\"\n383\t        draw_me = _vanilla_creature(\"Draw Me\")\n384\t        # Yes to the \"you may\", but the hand is empty so the discard can't be\n385\t        # made; the draw is therefore skipped.  Allow either an immediate \"no\"\n386\t        # from an empty-hand guard (empty script) or a single yes/no prompt.\n387\t        game, p1, card = self._build(\n388\t            scripts=([False], []),\n389\t            hand=[],\n390\t            library=[draw_me],\n391\t        )\n392\t\n393\t        self._fire_and_resolve(game, card)\n394\t\n395\t        hand = game.get_hand(p1)\n396\t        assert not hand.contains(draw_me), \"no discard means no draw\"\n397\t        assert len(hand.get_all()) == 0\n398\t"}]},"parent_tool_use_id":"toolu_01NAkxZQxxK3TN7Tazw7TR79","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"fca62e62-6c7b-41ab-b5cf-2597b8daf0f0","timestamp":"2026-06-01T11:35:23.561Z","subagent_type":"Implementer","task_description":"Implement sos_201"}
