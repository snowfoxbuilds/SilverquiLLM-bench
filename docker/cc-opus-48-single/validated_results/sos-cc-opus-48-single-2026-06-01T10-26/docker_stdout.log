{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EGfGkok46DdXjWZgVbsMZm","type":"tool_result","content":"1\t\"\"\"Card implementation for Emeritus of Truce // Swords to Plowshares.\n2\t\n3\tFront face: **Emeritus of Truce** — ``{1}{W}{W}`` white Creature — Cat Cleric,\n4\t3/3, with the SOS-specific **Prepared** keyword.\n5\t\n6\t    When this creature enters, target player creates a 1/1 white and black\n7\t    Inkling creature token with flying. Then if an opponent controls more\n8\t    creatures than you, this creature becomes prepared. (While it's prepared,\n9\t    you may cast a copy of its spell. Doing so unprepares it.)\n10\t\n11\tThe prepare spell (inset face) is **Swords to Plowshares** — a ``{W}`` instant:\n12\t\n13\t    Exile target creature. Its controller gains life equal to its power.\n14\t\n15\tTestable contract exposed by this implementation\n16\t------------------------------------------------\n17\t* ``card.is_prepared`` — bool, starts ``False``; becomes ``True`` only when an\n18\t  opponent controls strictly more creatures than the controller after the ETB.\n19\t  (The Prepared mechanic is surfaced via this attribute and the rules text\n20\t  rather than a ``Keyword`` enum member, since the engine's keyword set is\n21\t  pinned by an authoritative regression test.)\n22\t* ``card.prepare_spell`` (also aliased as ``prepared_spell`` / ``other_face``)\n23\t  — a :class:`SwordsToPlowshares` instance (name ``\"Swords to Plowshares\"``,\n24\t  cost ``{W}``).\n25\t* ``card.register_triggers(game)`` registers a self-only ETB trigger watching\n26\t  :class:`EntersBattlefieldTriggeredEvent`. Resolving it creates a 1/1 flying\n27\t  white+black Inkling token for the chosen target player and conditionally sets\n28\t  ``is_prepared``.\n29\t* Casting the prepared copy is driven by\n30\t  :func:`engine.casting.cast_prepared_spell` (or the convenience method\n31\t  :meth:`EmeritusOfTruceSwordsToPlowshares.cast_prepare_copy`): it puts a copy\n32\t  of Swords to Plowshares on the stack and clears ``is_prepared``. Resolving the\n33\t  copy exiles the target creature and gives its controller life equal to its\n34\t  power.\n35\t\"\"\"\n36\t\n37\tfrom __future__ import annotations\n38\t\n39\tfrom typing import TYPE_CHECKING, Any\n40\t\n41\tfrom engine.card import Creature, Instant\n42\tfrom engine.types import CardType, Color, Keyword, ManaCost, Zone\n43\t\n44\tif TYPE_CHECKING:\n45\t    from engine.game_state import GameState\n46\t\n47\t\n48\tdef _self_etb_condition(source: Any):\n49\t    \"\"\"Return a condition callable matching only when *source* enters.\"\"\"\n50\t\n51\t    def _condition(game: Any, event: Any) -> bool:\n52\t        return getattr(event, \"permanent\", None) is source\n53\t\n54\t    return _condition\n55\t\n56\t\n57\tclass SwordsToPlowshares(Instant):\n58\t    \"\"\"Swords to Plowshares — {W} instant (the prepare spell / inset face).\n59\t\n60\t    Exile target creature. Its controller gains life equal to its power.\n61\t    \"\"\"\n62\t\n63\t    def __init__(self, **kwargs: Any) -> None:\n64\t        kwargs.setdefault(\"name\", \"Swords to Plowshares\")\n65\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{W}\"))\n66\t        kwargs.setdefault(\"colors\", {Color.WHITE})\n67\t        kwargs.setdefault(\n68\t            \"rules_text\",\n69\t            \"Exile target creature. Its controller gains life equal to its power.\",\n70\t        )\n71\t        super().__init__(**kwargs)\n72\t        self.chosen_targets: list[Any] = []\n73\t\n74\t    def get_targets(self, game: GameState) -> list[Any]:\n75\t        \"\"\"Target a creature on the battlefield.\"\"\"\n76\t        from engine.types import TargetRequirement\n77\t\n78\t        def _is_creature(obj: Any) -> bool:\n79\t            return CardType.CREATURE in getattr(obj, \"card_types\", set())\n80\t\n81\t        return [\n82\t            TargetRequirement(\n83\t                filter_fn=_is_creature,\n84\t                description=\"target creature\",\n85\t                zone=Zone.BATTLEFIELD,\n86\t            )\n87\t        ]\n88\t\n89\t    def on_resolve(self, game: GameState) -> None:\n90\t        \"\"\"Exile the target creature; its controller gains life = its power.\"\"\"\n91\t        from engine.game import exile\n92\t\n93\t        targets = getattr(self, \"chosen_targets\", None) or []\n94\t        target = targets[0] if targets else None\n95\t        if target is None:\n96\t            return\n97\t\n98\t        # Capture power and controller before the creature leaves the battlefield.\n99\t        power = getattr(target, \"power\", getattr(target, \"base_power\", 0))\n100\t        target_controller = getattr(target, \"controller\", None)\n101\t\n102\t        exile(game, target)\n103\t\n104\t        if target_controller is not None and hasattr(target_controller, \"life\") and power > 0:\n105\t            target_controller.life += power\n106\t\n107\t\n108\tclass EmeritusOfTruceSwordsToPlowshares(Creature):\n109\t    \"\"\"Emeritus of Truce // Swords to Plowshares — SOS 13.\n110\t\n111\t    {1}{W}{W} white Creature — Cat Cleric, 3/3, Prepared.\n112\t    \"\"\"\n113\t\n114\t    def __init__(self, **kwargs: Any) -> None:\n115\t        kwargs.setdefault(\"name\", \"Emeritus of Truce // Swords to Plowshares\")\n116\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{W}{W}\"))\n117\t        kwargs.setdefault(\"subtypes\", {\"Cat\", \"Cleric\"})\n118\t        kwargs.setdefault(\"base_power\", 3)\n119\t        kwargs.setdefault(\"base_toughness\", 3)\n120\t        kwargs.setdefault(\"colors\", {Color.WHITE})\n121\t        kwargs.setdefault(\n122\t            \"rules_text\",\n123\t            \"When this creature enters, target player creates a 1/1 white and \"\n124\t            \"black Inkling creature token with flying. Then if an opponent \"\n125\t            \"controls more creatures than you, this creature becomes prepared. \"\n126\t            \"(While it's prepared, you may cast a copy of its spell. Doing so \"\n127\t            \"unprepares it.)\",\n128\t        )\n129\t        super().__init__(**kwargs)\n130\t        # Prepared designation — starts cleared; only the ETB conditional sets it.\n131\t        self.is_prepared: bool = False\n132\t        # The inset prepare spell (Swords to Plowshares).\n133\t        self.prepare_spell: SwordsToPlowshares = SwordsToPlowshares(\n134\t            owner=self.owner, controller=self.controller\n135\t        )\n136\t\n137\t    # Aliases so test code can discover the prepare spell under several names.\n138\t    @property\n139\t    def prepared_spell(self) -> SwordsToPlowshares:\n140\t        return self.prepare_spell\n141\t\n142\t    @property\n143\t    def other_face(self) -> SwordsToPlowshares:\n144\t        return self.prepare_spell\n145\t\n146\t    # ------------------------------------------------------------------\n147\t    # ETB trigger\n148\t    # ------------------------------------------------------------------\n149\t\n150\t    def register_triggers(self, game: GameState) -> None:\n151\t        from engine.events import EntersBattlefieldTriggeredEvent\n152\t        from engine.triggers import TriggerRegistration\n153\t\n154\t        source = self\n155\t        controller = getattr(self, \"controller\", None) or game.active_player\n156\t\n157\t        def _effect(game: GameState) -> None:\n158\t            self._etb_effect(game)\n159\t\n160\t        game.trigger_manager.register(\n161\t            TriggerRegistration(\n162\t                event_type=EntersBattlefieldTriggeredEvent,\n163\t                condition=_self_etb_condition(self),\n164\t                effect=_effect,\n165\t                source=self,\n166\t                controller=controller,\n167\t            )\n168\t        )\n169\t\n170\t    def _etb_effect(self, game: GameState) -> None:\n171\t        \"\"\"ETB: target player creates the Inkling, then conditional prepare.\"\"\"\n172\t        from engine.game import create_token\n173\t\n174\t        controller = getattr(self, \"controller\", None) or game.active_player\n175\t\n176\t        # \"target player creates ...\" — ask the controller to choose a player.\n177\t        target_player = self._choose_target_player(game, controller)\n178\t\n179\t        # Create a 1/1 white and black Inkling creature token with flying.\n180\t        token = Creature(\n181\t            name=\"Inkling\",\n182\t            subtypes={\"Inkling\"},\n183\t            keywords=Keyword.FLYING,\n184\t            base_power=1,\n185\t            base_toughness=1,\n186\t            colors={Color.WHITE, Color.BLACK},\n187\t            owner=target_player,\n188\t            controller=target_player,\n189\t        )\n190\t        create_token(game, target_player, token)\n191\t\n192\t        # \"Then if an opponent controls more creatures than you, this creature\n193\t        # becomes prepared.\" Strict comparison; this creature counts for \"you\".\n194\t        if self._opponent_controls_more_creatures(game, controller):\n195\t            self.is_prepared = True\n196\t\n197\t    def _choose_target_player(self, game: GameState, controller: Any) -> Any:\n198\t        \"\"\"Choose the target player for the token (defaults to controller).\"\"\"\n199\t        from engine.types import TargetRequirement\n200\t\n201\t        chooser = controller\n202\t        choose_target = getattr(chooser, \"choose_target\", None)\n203\t        if choose_target is None:\n204\t            return controller\n205\t        spec = TargetRequirement(\n206\t            filter_fn=lambda obj: hasattr(obj, \"life\"),\n207\t            description=\"target player\",\n208\t            zone=Zone.BATTLEFIELD,\n209\t        )\n210\t        try:\n211\t            chosen = chooser.choose_target(list(game.players), spec)\n212\t        except Exception:\n213\t            return controller\n214\t        # Only honour the choice if it is actually a player object.\n215\t        if chosen in game.players:\n216\t            return chosen\n217\t        return controller\n218\t\n219\t    @staticmethod\n220\t    def _count_creatures(game: GameState, player: Any) -> int:\n221\t        bf = game.get_battlefield(player)\n222\t        return sum(\n223\t            1\n224\t            for obj in bf.get_all()\n225\t            if CardType.CREATURE in getattr(obj, \"card_types\", set())\n226\t        )\n227\t\n228\t    def _opponent_controls_more_creatures(self, game: GameState, controller: Any) -> bool:\n229\t        mine = self._count_creatures(game, controller)\n230\t        for opp in game.players:\n231\t            if opp is controller:\n232\t                continue\n233\t            if self._count_creatures(game, opp) > mine:\n234\t                return True\n235\t        return False\n236\t\n237\t    # ------------------------------------------------------------------\n238\t    # Prepared cast loop\n239\t    # ------------------------------------------------------------------\n240\t\n241\t    def cast_prepare_copy(self, game: GameState, targets: list[Any] | None = None):\n242\t        \"\"\"Cast a copy of the prepare spell while prepared (convenience wrapper).\n243\t\n244\t        Delegates to :func:`engine.casting.cast_prepared_spell`. Casting clears\n245\t        ``is_prepared``. Returns the resulting :class:`StackObject` (or ``None``\n246\t        if not prepared).\n247\t        \"\"\"\n248\t        from engine.casting import cast_prepared_spell\n249\t\n250\t        return cast_prepared_spell(game, self, targets=targets)\n251\t"}]},"parent_tool_use_id":"toolu_013ffgW39vf6im3ZxEXD7SZE","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"752d0bcc-b1fe-4053-b0cf-da6b2144caa0","timestamp":"2026-06-01T11:31:52.244Z","subagent_type":"Tester","task_description":"Write tests for sos_201"}
