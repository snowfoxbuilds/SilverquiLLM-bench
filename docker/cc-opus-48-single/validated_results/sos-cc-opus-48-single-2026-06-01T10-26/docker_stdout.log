{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C4iF74LRAS6TysGTtvdxgT","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_245/card_impl.py b/cards/sos/sos_245/card_impl.py\n2\tindex b860d8c..52af242 100644\n3\t--- a/cards/sos/sos_245/card_impl.py\n4\t+++ b/cards/sos/sos_245/card_impl.py\n5\t@@ -1,16 +1,122 @@\n6\t-\"\"\"Card implementation for Witherbloom, the Balancer.\"\"\"\n7\t+\"\"\"Card implementation for Witherbloom, the Balancer (SOS 245).\n8\t+\n9\t+Witherbloom is a {6}{B}{G} 5/5 Legendary Elder Dragon with:\n10\t+\n11\t+* **Affinity for creatures** — \"This spell costs {1} less to cast for each\n12\t+  creature you control.\" (a self cost reduction, modelled via\n13\t+  :meth:`cost_reduction`).\n14\t+* **Flying, deathtouch** (evergreen keywords).\n15\t+* \"Instant and sorcery spells you cast have affinity for creatures.\" (a static\n16\t+  grant of the same affinity to the controller's instant/sorcery spells while\n17\t+  Witherbloom is on the battlefield).\n18\t+\n19\t+Affinity is intentionally NOT a :class:`~engine.types.Keyword` enum member (the\n20\t+enum is pinned at 16 members by ``engine_tests/test_types.py``); it is surfaced\n21\t+through the cost-reduction hook plus rules text.\n22\t+\n23\t+The granted affinity (ability #3) reaches the engine through the additive\n24\t+``affinity_for_creatures_grant(game, spell, controller)`` grant method, which\n25\t+``engine.casting.get_cost_reduction`` consults for any spell being cast.  The\n26\t+grant is scoped (controller-only, instant/sorcery only, only while Witherbloom\n27\t+is on the battlefield) and is non-sticky / derived dynamically, mirroring the\n28\t+miracle grant model in ``engine/miracle.py``.\n29\t+\"\"\"\n30\t \n31\t from __future__ import annotations\n32\t \n33\t-from engine.card import CardImpl\n34\t+from typing import TYPE_CHECKING, Any\n35\t \n36\t-from typing import TYPE_CHECKING\n37\t+from engine.card import Creature\n38\t+from engine.types import CardType, Color, Keyword, ManaCost, Supertype\n39\t \n40\t if TYPE_CHECKING:\n41\t     from engine.game_state import GameState\n42\t+    from engine.player import Player\n43\t+\n44\t+\n45\t+def _count_creatures_controlled(game: Any, controller: Any) -> int:\n46\t+    \"\"\"Return the number of creatures *controller* controls on the battlefield.\"\"\"\n47\t+    if controller is None:\n48\t+        return 0\n49\t+    count = 0\n50\t+    for obj in game.get_battlefield(controller).get_all():\n51\t+        if CardType.CREATURE in getattr(obj, \"card_types\", set()):\n52\t+            count += 1\n53\t+    return count\n54\t+\n55\t+\n56\t+class WitherbloomTheBalancer(Creature):\n57\t+    \"\"\"Witherbloom, the Balancer — {6}{B}{G} 5/5 Legendary Elder Dragon.\n58\t+\n59\t+    Affinity for creatures.  Flying, deathtouch.  Instant and sorcery spells\n60\t+    you cast have affinity for creatures.\n61\t+\n62\t+    SOS collector number 245.\n63\t+    \"\"\"\n64\t+\n65\t+    def __init__(self, **kwargs: Any) -> None:\n66\t+        kwargs.setdefault(\"name\", \"Witherbloom, the Balancer\")\n67\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{6}{B}{G}\"))\n68\t+        kwargs.setdefault(\"base_power\", 5)\n69\t+        kwargs.setdefault(\"base_toughness\", 5)\n70\t+        kwargs.setdefault(\"subtypes\", {\"Elder\", \"Dragon\"})\n71\t+        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n72\t+        kwargs.setdefault(\"keywords\", Keyword.FLYING | Keyword.DEATHTOUCH)\n73\t+        kwargs.setdefault(\"colors\", {Color.BLACK, Color.GREEN})\n74\t+        kwargs.setdefault(\n75\t+            \"rules_text\",\n76\t+            \"Affinity for creatures (This spell costs {1} less to cast for \"\n77\t+            \"each creature you control.)\\n\"\n78\t+            \"Flying, deathtouch\\n\"\n79\t+            \"Instant and sorcery spells you cast have affinity for creatures.\",\n80\t+        )\n81\t+        super().__init__(**kwargs)\n82\t+\n83\t+    # ------------------------------------------------------------------\n84\t+    # Own Affinity for creatures (self cost reduction)\n85\t+    # ------------------------------------------------------------------\n86\t+    def cost_reduction(self, game: \"GameState\") -> int:\n87\t+        \"\"\"Affinity for creatures: reduce by {1} for each creature you control.\n88\t+\n89\t+        Counts every creature the controller controls on the battlefield —\n90\t+        including Witherbloom itself once it is on the battlefield, but\n91\t+        excluding opponents' creatures and noncreature permanents.  The engine\n92\t+        clamps the result to the generic portion of the mana cost.\n93\t+        \"\"\"\n94\t+        return _count_creatures_controlled(game, self.controller)\n95\t+\n96\t+    # ------------------------------------------------------------------\n97\t+    # Granted affinity — instant/sorcery spells you cast (ability #3)\n98\t+    # ------------------------------------------------------------------\n99\t+    def affinity_for_creatures_grant(\n100\t+        self, game: \"GameState\", spell: Any, controller: \"Player\"\n101\t+    ) -> int:\n102\t+        \"\"\"Grant affinity for creatures to *controller*'s instant/sorcery spells.\n103\t+\n104\t+        Returns the generic reduction (number of creatures *controller*\n105\t+        controls) to apply to *spell*, or 0 when the grant does not apply.\n106\t+\n107\t+        The grant is scoped:\n108\t \n109\t+        * Witherbloom must be on the battlefield (this method is only consulted\n110\t+          for permanents on a battlefield, but we guard defensively).\n111\t+        * Only *Witherbloom's* controller's spells qualify.\n112\t+        * Only instant and sorcery spells qualify (not creature / other spells).\n113\t \n114\t-class WitherbloomTheBalancer(CardImpl):\n115\t-    \"\"\"TODO: Implement Witherbloom, the Balancer.\"\"\"\n116\t+        ``engine.casting.get_cost_reduction`` clamps the returned value to the\n117\t+        spell's generic mana cost.\n118\t+        \"\"\"\n119\t+        own_controller = self.controller\n120\t+        if own_controller is None or controller is None:\n121\t+            return 0\n122\t+        if controller is not own_controller:\n123\t+            return 0\n124\t+        spell_types = getattr(spell, \"card_types\", set())\n125\t+        if not spell_types & {CardType.INSTANT, CardType.SORCERY}:\n126\t+            return 0\n127\t+        return _count_creatures_controlled(game, controller)\n128\t \n129\t-    pass\n130\t+    def on_resolve(self, game: GameState) -> None:\n131\t+        # Witherbloom is a creature permanent; its abilities are static, so\n132\t+        # resolution itself is a no-op (the permanent simply enters play).\n133\t+        pass\n134\tdiff --git a/engine/casting.py b/engine/casting.py\n135\tindex 89dfa79..8a6c750 100644\n136\t--- a/engine/casting.py\n137\t+++ b/engine/casting.py\n138\t@@ -104,10 +104,52 @@ def get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> i\n139\t     # Restore previous controller in case the caller doesn't want a\n140\t     # side-effect (get_cost_reduction is a query, not a mutation).\n141\t     card.controller = prev_controller\n142\t+    # Additively fold in any granted reductions from permanents on the\n143\t+    # battlefield that dynamically grant cost reduction to *controller*'s\n144\t+    # spells (e.g. Witherbloom granting affinity for creatures to the\n145\t+    # controller's instant/sorcery spells).  The grant is derived dynamically\n146\t+    # from the active granters, so it only applies while the granter is in\n147\t+    # play and is never sticky.\n148\t+    raw += _granted_cost_reduction(game, card, controller)\n149\t     generic = card.mana_cost.generic if card.mana_cost else 0\n150\t     return max(0, min(raw, generic))\n151\t \n152\t \n153\t+def _granted_cost_reduction(\n154\t+    game: GameState, card: CardImpl, controller: Player\n155\t+) -> int:\n156\t+    \"\"\"Return the extra generic reduction *controller*'s battlefield grants to *card*.\n157\t+\n158\t+    Consults every permanent on *controller*'s battlefield that exposes a\n159\t+    callable ``affinity_for_creatures_grant(game, card, controller)`` method\n160\t+    (an additive, dynamically-derived grant surface analogous to the miracle\n161\t+    grant in :mod:`engine.miracle`).  Each grant returns the generic reduction\n162\t+    it confers on *card* (0 when it does not apply); the results are summed.\n163\t+\n164\t+    This is additive to the card's own ``cost_reduction`` so a spell that both\n165\t+    has its own affinity *and* is granted one is not double-counted by the\n166\t+    grant path: grant methods scope themselves to the controller's spells and\n167\t+    return their own count, and a card's intrinsic ``cost_reduction`` is read\n168\t+    separately above.  In the current single-source SOS model only one such\n169\t+    granter exists, so no inter-grant double counting occurs.\n170\t+    \"\"\"\n171\t+    if controller is None:\n172\t+        return 0\n173\t+    total = 0\n174\t+    for permanent in game.get_battlefield(controller).get_all():\n175\t+        grant = getattr(permanent, \"affinity_for_creatures_grant\", None)\n176\t+        if not callable(grant):\n177\t+            continue\n178\t+        try:\n179\t+            amount = grant(game, card, controller)\n180\t+        except TypeError:\n181\t+            # Not a (game, card, controller) grant method — skip defensively.\n182\t+            continue\n183\t+        if amount:\n184\t+            total += int(amount)\n185\t+    return total\n186\t+\n187\t+\n188\t def _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n189\t     \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n190\t     new_generic = max(0, cost.generic - reduction)\n191\t"}]},"parent_tool_use_id":"toolu_018LVqqkhmpevT52yENkiaDb","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"36ec2a79-fb57-420d-be4d-bc49aa3ea402","timestamp":"2026-06-01T12:09:43.135Z","subagent_type":"Reviewer","task_description":"Review sos_245 implementation"}
