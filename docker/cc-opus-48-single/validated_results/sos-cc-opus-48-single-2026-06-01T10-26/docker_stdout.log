{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SFxWSn39Y2CC7Dsd6ZsSAU","type":"tool_result","content":"1\t\"\"\"Tests for SOS 245 — Witherbloom, the Balancer.\n2\t\n3\tWitherbloom is a {6}{B}{G} Legendary Elder Dragon (5/5) with:\n4\t\n5\t* **Affinity for creatures** — \"This spell costs {1} less to cast for each\n6\t  creature you control.\" (a self cost reduction)\n7\t* **Flying, deathtouch** (evergreen keywords)\n8\t* \"Instant and sorcery spells you cast have affinity for creatures.\" (a static\n9\t  grant of the same affinity to the controller's instant/sorcery spells while\n10\t  Witherbloom is on the battlefield)\n11\t\n12\tThe cost-reduction model the engine exposes is ``CardImpl.cost_reduction(game)``\n13\t(the generic reduction for casting that card), consumed by\n14\t``engine.casting.get_cost_reduction`` which clamps the result to the generic\n15\tportion of the mana cost. These tests pin:\n16\t\n17\t* Static card data (name, cost, types, P/T, supertype, subtypes, keywords,\n18\t  colors).\n19\t* Witherbloom's own Affinity for creatures (counts creatures you control,\n20\t  including itself; clamped to generic; opponent creatures excluded).\n21\t* The granted affinity to the controller's instant/sorcery spells, observed\n22\t  through the real ``cast_spell`` pipeline (the spell's ``mana_spent`` is\n23\t  reduced by the number of creatures the controller controls) and through the\n24\t  canonical ``get_cost_reduction`` query. Scope: only the controller's\n25\t  instant/sorcery spells, only while Witherbloom is on the battlefield.\n26\t\n27\tTDD red phase — the stub is empty, so every assertion below is expected to fail\n28\tuntil Witherbloom is implemented.\n29\t\"\"\"\n30\t\n31\tfrom __future__ import annotations\n32\t\n33\tfrom typing import Any\n34\t\n35\tfrom cards.sos.sos_245.card_impl import WitherbloomTheBalancer\n36\tfrom engine.card import Creature, Instant, Sorcery\n37\tfrom engine.casting import cast_spell as engine_cast_spell, get_cost_reduction\n38\tfrom engine.types import (\n39\t    CardType,\n40\t    Color,\n41\t    Keyword,\n42\t    ManaCost,\n43\t    ManaType,\n44\t    Phase,\n45\t    Supertype,\n46\t    Zone,\n47\t)\n48\tfrom test_utils import create_game, set_board_state\n49\t\n50\t\n51\t# ---------------------------------------------------------------------------\n52\t# Helpers\n53\t# ---------------------------------------------------------------------------\n54\t\n55\tdef _witherbloom(owner=None, controller=None) -> WitherbloomTheBalancer:\n56\t    return WitherbloomTheBalancer(owner=owner, controller=controller)\n57\t\n58\t\n59\tdef _bear(name: str = \"Grizzly Bears\", power: int = 2, toughness: int = 2) -> Creature:\n60\t    return Creature(name=name, base_power=power, base_toughness=toughness)\n61\t\n62\t\n63\tdef _instant(name: str = \"Big Instant\", cost: str = \"{6}{B}\") -> Instant:\n64\t    return Instant(name=name, mana_cost=ManaCost.parse(cost))\n65\t\n66\t\n67\tdef _sorcery(name: str = \"Big Sorcery\", cost: str = \"{6}{G}\") -> Sorcery:\n68\t    return Sorcery(name=name, mana_cost=ManaCost.parse(cost))\n69\t\n70\t\n71\tdef _ready_for_cast(game) -> None:\n72\t    \"\"\"Put the game in a state where player 0 may cast a spell.\"\"\"\n73\t    game.active_player_index = 0\n74\t    game.priority_player_index = 0\n75\t    game.phase = Phase.PRECOMBAT_MAIN\n76\t    game.step = None\n77\t\n78\t\n79\t# ---------------------------------------------------------------------------\n80\t# Static card data\n81\t# ---------------------------------------------------------------------------\n82\t\n83\tclass TestWitherbloomProperties:\n84\t    \"\"\"Static characteristics must match the SOS 245 spec.\"\"\"\n85\t\n86\t    def test_is_creature(self) -> None:\n87\t        assert isinstance(_witherbloom(), Creature)\n88\t\n89\t    def test_name(self) -> None:\n90\t        assert _witherbloom().name == \"Witherbloom, the Balancer\"\n91\t\n92\t    def test_mana_cost(self) -> None:\n93\t        assert _witherbloom().mana_cost == ManaCost.parse(\"{6}{B}{G}\")\n94\t\n95\t    def test_power_toughness(self) -> None:\n96\t        card = _witherbloom()\n97\t        assert card.base_power == 5\n98\t        assert card.base_toughness == 5\n99\t\n100\t    def test_is_legendary(self) -> None:\n101\t        assert Supertype.LEGENDARY in _witherbloom().supertypes\n102\t\n103\t    def test_elder_dragon_subtypes(self) -> None:\n104\t        subtypes = _witherbloom().subtypes\n105\t        assert \"Dragon\" in subtypes\n106\t        assert \"Elder\" in subtypes\n107\t\n108\t    def test_has_flying(self) -> None:\n109\t        assert Keyword.FLYING in _witherbloom().keywords\n110\t\n111\t    def test_has_deathtouch(self) -> None:\n112\t        assert Keyword.DEATHTOUCH in _witherbloom().keywords\n113\t\n114\t    def test_is_black_and_green(self) -> None:\n115\t        colors = _witherbloom().colors\n116\t        assert Color.BLACK in colors\n117\t        assert Color.GREEN in colors\n118\t\n119\t    def test_not_other_colors(self) -> None:\n120\t        colors = _witherbloom().colors\n121\t        assert Color.WHITE not in colors\n122\t        assert Color.BLUE not in colors\n123\t        assert Color.RED not in colors\n124\t\n125\t\n126\t# ---------------------------------------------------------------------------\n127\t# Witherbloom's own Affinity for creatures (self cost reduction)\n128\t# ---------------------------------------------------------------------------\n129\t\n130\tclass TestWitherbloomSelfAffinity:\n131\t    \"\"\"Witherbloom costs {1} less for each creature you control.\"\"\"\n132\t\n133\t    def test_no_creatures_no_reduction(self) -> None:\n134\t        game = create_game()\n135\t        p1 = game.players[0]\n136\t        card = _witherbloom(owner=p1, controller=p1)\n137\t        # Empty battlefield -> no reduction.\n138\t        assert card.cost_reduction(game) == 0\n139\t\n140\t    def test_reduction_counts_creatures_you_control(self) -> None:\n141\t        game = create_game()\n142\t        p1 = game.players[0]\n143\t        card = _witherbloom(owner=p1, controller=p1)\n144\t        set_board_state(game, 0, battlefield=[_bear(), _bear(\"Bear Two\")])\n145\t        # Two other creatures you control -> reduction of 2.\n146\t        card.controller = p1\n147\t        assert card.cost_reduction(game) == 2\n148\t\n149\t    def test_reduction_counts_itself_when_on_battlefield(self) -> None:\n150\t        \"\"\"While Witherbloom is on the battlefield with one other creature,\n151\t        the affinity reduction counts both creatures you control.\"\"\"\n152\t        game = create_game()\n153\t        p1 = game.players[0]\n154\t        card = _witherbloom(owner=p1, controller=p1)\n155\t        set_board_state(game, 0, battlefield=[card, _bear()])\n156\t        assert card.cost_reduction(game) == 2\n157\t\n158\t    def test_opponent_creatures_excluded(self) -> None:\n159\t        game = create_game()\n160\t        p1 = game.players[0]\n161\t        card = _witherbloom(owner=p1, controller=p1)\n162\t        set_board_state(game, 0, battlefield=[_bear()])\n163\t        set_board_state(game, 1, battlefield=[_bear(\"Enemy Bear\"), _bear(\"Enemy Two\")])\n164\t        card.controller = p1\n165\t        # Only the single creature you control counts.\n166\t        assert card.cost_reduction(game) == 1\n167\t\n168\t    def test_noncreature_permanents_not_counted(self) -> None:\n169\t        \"\"\"Affinity for *creatures* must not count noncreature permanents.\"\"\"\n170\t        from engine.card import CardImpl\n171\t\n172\t        game = create_game()\n173\t        p1 = game.players[0]\n174\t        card = _witherbloom(owner=p1, controller=p1)\n175\t        artifact = CardImpl(\n176\t            name=\"Some Artifact\",\n177\t            mana_cost=ManaCost.parse(\"{2}\"),\n178\t            card_types={CardType.ARTIFACT},\n179\t        )\n180\t        set_board_state(game, 0, battlefield=[_bear(), artifact])\n181\t        card.controller = p1\n182\t        # Only the one creature counts; the artifact does not.\n183\t        assert card.cost_reduction(game) == 1\n184\t\n185\t    def test_get_cost_reduction_clamped_to_generic(self) -> None:\n186\t        \"\"\"The reduction can never reduce below the generic portion; with more\n187\t        creatures than the {6} generic, the engine clamps the reduction to 6.\"\"\"\n188\t        game = create_game()\n189\t        p1 = game.players[0]\n190\t        card = _witherbloom(owner=p1, controller=p1)\n191\t        creatures = [_bear(f\"Bear {i}\") for i in range(8)]\n192\t        set_board_state(game, 0, battlefield=[card] + creatures)\n193\t        # 9 creatures controlled, but generic is only {6}.\n194\t        reduction = get_cost_reduction(game, card, p1)\n195\t        assert reduction == 6\n196\t\n197\t    def test_get_cost_reduction_matches_creature_count_under_generic(self) -> None:\n198\t        game = create_game()\n199\t        p1 = game.players[0]\n200\t        card = _witherbloom(owner=p1, controller=p1)\n201\t        set_board_state(game, 0, battlefield=[card, _bear(), _bear(\"Bear Two\")])\n202\t        # 3 creatures controlled, well under {6} generic -> reduction of 3.\n203\t        assert get_cost_reduction(game, card, p1) == 3\n204\t\n205\t\n206\t# ---------------------------------------------------------------------------\n207\t# Granted affinity — instant/sorcery spells you cast\n208\t# ---------------------------------------------------------------------------\n209\t\n210\tclass TestWitherbloomGrantedAffinity:\n211\t    \"\"\"Instant and sorcery spells you cast have affinity for creatures while\n212\t    Witherbloom is on the battlefield.\"\"\"\n213\t\n214\t    def test_instant_cost_reduced_through_real_cast(self) -> None:\n215\t        \"\"\"Casting your own instant while Witherbloom + creatures are out pays\n216\t        less mana (mana_spent reflects the affinity reduction).\"\"\"\n217\t        game = create_game()\n218\t        p1 = game.players[0]\n219\t        wither = _witherbloom(owner=p1, controller=p1)\n220\t        set_board_state(game, 0, battlefield=[wither, _bear(), _bear(\"Bear Two\")])\n221\t        _ready_for_cast(game)\n222\t\n223\t        spell = _instant(cost=\"{6}{B}\")  # generic 6, one black pip\n224\t        set_board_state(game, 0, hand=[spell])\n225\t        # Plenty of mana so the cast always succeeds regardless of reduction.\n226\t        p1.mana_pool.add(ManaType.BLACK, 1)\n227\t        p1.mana_pool.add(ManaType.COLORLESS, 10)\n228\t\n229\t        engine_cast_spell(game, p1, spell)\n230\t\n231\t        # Three creatures controlled -> {6} generic reduced by 3 -> pays 3+1 = 4.\n232\t        assert spell.mana_spent == 4\n233\t\n234\t    def test_sorcery_cost_reduced_through_real_cast(self) -> None:\n235\t        \"\"\"Sorceries you cast also gain affinity for creatures.\"\"\"\n236\t        game = create_game()\n237\t        p1 = game.players[0]\n238\t        wither = _witherbloom(owner=p1, controller=p1)\n239\t        set_board_state(game, 0, battlefield=[wither, _bear()])\n240\t        _ready_for_cast(game)\n241\t\n242\t        spell = _sorcery(cost=\"{6}{G}\")\n243\t        set_board_state(game, 0, hand=[spell])\n244\t        p1.mana_pool.add(ManaType.GREEN, 1)\n245\t        p1.mana_pool.add(ManaType.COLORLESS, 10)\n246\t\n247\t        engine_cast_spell(game, p1, spell)\n248\t\n249\t        # Two creatures controlled (Witherbloom + bear) -> 6 - 2 = 4 generic;\n250\t        # plus the {G} pip -> 5 mana spent.\n251\t        assert spell.mana_spent == 5\n252\t\n253\t    def test_granted_reduction_visible_via_get_cost_reduction(self) -> None:\n254\t        \"\"\"The granted affinity is visible through the canonical\n255\t        get_cost_reduction query for a controller instant while Witherbloom is\n256\t        on the battlefield.\"\"\"\n257\t        game = create_game()\n258\t        p1 = game.players[0]\n259\t        wither = _witherbloom(owner=p1, controller=p1)\n260\t        set_board_state(game, 0, battlefield=[wither, _bear(), _bear(\"Bear Two\")])\n261\t\n262\t        spell = _instant(cost=\"{6}{B}\")\n263\t        spell.owner = p1\n264\t        # 3 creatures controlled -> reduction of 3.\n265\t        assert get_cost_reduction(game, spell, p1) == 3\n266\t\n267\t    def test_no_reduction_without_witherbloom_on_battlefield(self) -> None:\n268\t        \"\"\"Without Witherbloom on the battlefield, a plain instant gets no\n269\t        affinity reduction even with creatures present.\"\"\"\n270\t        game = create_game()\n271\t        p1 = game.players[0]\n272\t        set_board_state(game, 0, battlefield=[_bear(), _bear(\"Bear Two\")])\n273\t\n274\t        spell = _instant(cost=\"{6}{B}\")\n275\t        spell.owner = p1\n276\t        assert get_cost_reduction(game, spell, p1) == 0\n277\t\n278\t    def test_opponent_spell_not_granted_affinity(self) -> None:\n279\t        \"\"\"Witherbloom only grants affinity to *your* instant/sorcery spells.\n280\t        An opponent's instant gets no reduction from your Witherbloom.\"\"\"\n281\t        game = create_game()\n282\t        p1 = game.players[0]\n283\t        p2 = game.players[1]\n284\t        wither = _witherbloom(owner=p1, controller=p1)\n285\t        set_board_state(game, 0, battlefield=[wither, _bear(), _bear(\"Bear Two\")])\n286\t        # Opponent also controls creatures, but they don't matter here.\n287\t        set_board_state(game, 1, battlefield=[_bear(\"Enemy Bear\")])\n288\t\n289\t        opp_spell = _instant(name=\"Opp Instant\", cost=\"{6}{B}\")\n290\t        opp_spell.owner = p2\n291\t        # The opponent's spell is not \"a spell you cast\" from Witherbloom's\n292\t        # controller's perspective, so no reduction.\n293\t        assert get_cost_reduction(game, opp_spell, p2) == 0\n294\t\n295\t    def test_creature_spell_not_granted_affinity(self) -> None:\n296\t        \"\"\"The grant is restricted to instant and sorcery spells — a creature\n297\t        spell you cast gets no affinity from Witherbloom.\"\"\"\n298\t        game = create_game()\n299\t        p1 = game.players[0]\n300\t        wither = _witherbloom(owner=p1, controller=p1)\n301\t        set_board_state(game, 0, battlefield=[wither, _bear(), _bear(\"Bear Two\")])\n302\t\n303\t        creature_spell = Creature(\n304\t            name=\"Vanilla Beast\",\n305\t            mana_cost=ManaCost.parse(\"{6}{G}\"),\n306\t            base_power=4,\n307\t            base_toughness=4,\n308\t        )\n309\t        creature_spell.owner = p1\n310\t        assert get_cost_reduction(game, creature_spell, p1) == 0\n311\t\n312\t    def test_granted_reduction_clamped_to_generic(self) -> None:\n313\t        \"\"\"The granted affinity is also clamped to the spell's generic cost.\"\"\"\n314\t        game = create_game()\n315\t        p1 = game.players[0]\n316\t        wither = _witherbloom(owner=p1, controller=p1)\n317\t        creatures = [_bear(f\"Bear {i}\") for i in range(5)]\n318\t        set_board_state(game, 0, battlefield=[wither] + creatures)\n319\t\n320\t        # Generic of {2}{B} is only 2, but 6 creatures are controlled.\n321\t        spell = _instant(cost=\"{2}{B}\")\n322\t        spell.owner = p1\n323\t        assert get_cost_reduction(game, spell, p1) == 2\n324\t"}]},"parent_tool_use_id":"toolu_01EXUd8sdvZTu54EM9DsV9js","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"4f1afd99-73c6-4eb4-bbf7-3ea4be42b29d","timestamp":"2026-06-01T12:07:16.055Z","subagent_type":"Implementer","task_description":"Implement sos_245"}
