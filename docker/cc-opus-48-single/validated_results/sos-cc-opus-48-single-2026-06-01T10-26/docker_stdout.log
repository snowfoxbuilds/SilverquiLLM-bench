{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VZNz2aJxc1RBufpoHTdKHe","type":"tool_result","content":"1\t\"\"\"Tests for SOS 57 — Mana Sculpt.\n2\t\n3\tMana Sculpt ({1}{U}{U} Instant):\n4\t\n5\t    Counter target spell. If you control a Wizard, add an amount of {C}\n6\t    equal to the amount of mana spent to cast that spell at the beginning\n7\t    of your next main phase.\n8\t\n9\tThe card has three observable obligations:\n10\t\n11\t1. **Static data** — name, mana cost ({1}{U}{U}), instant type, blue color.\n12\t2. **Counter target spell** — the targeted spell is removed from the stack\n13\t   and put into its owner's graveyard; it never resolves.\n14\t3. **Conditional delayed mana** — *only* if the controller controls a Wizard\n15\t   when Mana Sculpt resolves, a delayed effect is set up that adds colorless\n16\t   mana equal to the mana spent on the countered spell at the beginning of\n17\t   the controller's next main phase. With no Wizard, no such effect occurs.\n18\t\n19\tThe engine ships no built-in counter mechanism, no per-spell \"mana spent\"\n20\ttracking, and no begin-of-main-phase trigger firing, so the implementation\n21\tmust provide these. These tests drive the observable contract: stack/zone\n22\tmovement for the counter, and the presence/absence + colorless amount of\n23\tthe delayed mana effect keyed on Wizard control.\n24\t\n25\tTDD red-phase: the stub at ``card_impl.py`` is empty, so everything here is\n26\texpected to fail until the card is implemented.\n27\t\"\"\"\n28\t\n29\tfrom __future__ import annotations\n30\t\n31\tfrom typing import Any\n32\t\n33\timport pytest\n34\t\n35\tfrom cards.sos.sos_57.card_impl import ManaSculpt\n36\tfrom engine.card import CardImpl, Creature, Instant, Sorcery\n37\tfrom engine.stack import StackObject\n38\tfrom engine.types import CardType, Color, ManaCost, ManaType, TargetRequirement, Zone\n39\tfrom test_utils import create_game, set_board_state\n40\t\n41\t\n42\t# ---------------------------------------------------------------------------\n43\t# Helpers\n44\t# ---------------------------------------------------------------------------\n45\t\n46\t\n47\tdef _wizard(name: str = \"Test Wizard\") -> Creature:\n48\t    \"\"\"A 1/1 creature with the Wizard subtype.\"\"\"\n49\t    return Creature(\n50\t        name=name,\n51\t        mana_cost=ManaCost.parse(\"{U}\"),\n52\t        base_power=1,\n53\t        base_toughness=1,\n54\t        subtypes={\"Wizard\"},\n55\t    )\n56\t\n57\t\n58\tdef _non_wizard(name: str = \"Grizzly Bears\") -> Creature:\n59\t    \"\"\"A vanilla 2/2 Bear (no Wizard subtype).\"\"\"\n60\t    return Creature(\n61\t        name=name,\n62\t        mana_cost=ManaCost.parse(\"{1}{G}\"),\n63\t        base_power=2,\n64\t        base_toughness=2,\n65\t        subtypes={\"Bear\"},\n66\t    )\n67\t\n68\t\n69\tdef _victim_spell(name: str = \"Lightning Bolt\", cost: str = \"{R}\") -> Instant:\n70\t    \"\"\"A throwaway spell to be countered.\"\"\"\n71\t    return Instant(name=name, mana_cost=ManaCost.parse(cost))\n72\t\n73\t\n74\tdef _put_spell_on_stack(game: Any, caster: Any, card: CardImpl) -> StackObject:\n75\t    \"\"\"Place *card* on the stack as a spell controlled by *caster*.\n76\t\n77\t    Mirrors the post-cast state: the card lives in the caster's STACK zone\n78\t    and a StackObject referencing it sits on the game stack with an\n79\t    ``on_resolve`` that would put it into its owner's graveyard.\n80\t    \"\"\"\n81\t    card.owner = caster\n82\t    card.controller = caster\n83\t    caster.zones[Zone.STACK].add(card)\n84\t\n85\t    resolved = {\"flag\": False}\n86\t\n87\t    def _resolve(g: Any) -> None:\n88\t        # If this ever runs, the spell was NOT countered.\n89\t        resolved[\"flag\"] = True\n90\t        caster.zones[Zone.STACK].remove(card)\n91\t        caster.zones[Zone.GRAVEYARD].add(card)\n92\t\n93\t    obj = StackObject(source=card, controller=caster, on_resolve=_resolve)\n94\t    obj.targets = []\n95\t    game.stack.push(obj)\n96\t    return obj\n97\t\n98\t\n99\t# ---------------------------------------------------------------------------\n100\t# Static card data\n101\t# ---------------------------------------------------------------------------\n102\t\n103\t\n104\tclass TestManaSculptProperties:\n105\t    \"\"\"Static card data should match the SOS 57 spec.\"\"\"\n106\t\n107\t    def test_name(self) -> None:\n108\t        assert ManaSculpt(owner=None).name == \"Mana Sculpt\"\n109\t\n110\t    def test_is_instant(self) -> None:\n111\t        card = ManaSculpt(owner=None)\n112\t        assert isinstance(card, Instant)\n113\t        assert CardType.INSTANT in card.card_types\n114\t\n115\t    def test_mana_cost(self) -> None:\n116\t        assert ManaSculpt(owner=None).mana_cost == ManaCost.parse(\"{1}{U}{U}\")\n117\t\n118\t    def test_is_blue(self) -> None:\n119\t        card = ManaSculpt(owner=None)\n120\t        assert Color.BLUE in card.colors\n121\t\n122\t    def test_not_a_creature(self) -> None:\n123\t        assert CardType.CREATURE not in ManaSculpt(owner=None).card_types\n124\t\n125\t\n126\t# ---------------------------------------------------------------------------\n127\t# Targeting — \"Counter target spell\"\n128\t# ---------------------------------------------------------------------------\n129\t\n130\t\n131\tclass TestManaSculptTargeting:\n132\t    \"\"\"get_targets() advertises a single 'target spell' requirement.\"\"\"\n133\t\n134\t    def test_returns_one_target_requirement(self) -> None:\n135\t        game = create_game()\n136\t        p1 = game.players[0]\n137\t        card = ManaSculpt(owner=p1, controller=p1)\n138\t        reqs = card.get_targets(game)\n139\t        assert isinstance(reqs, list)\n140\t        assert len(reqs) == 1\n141\t        assert isinstance(reqs[0], TargetRequirement)\n142\t\n143\t    def test_target_requirement_uses_stack_zone(self) -> None:\n144\t        \"\"\"A spell lives on the stack, so the requirement must look there.\"\"\"\n145\t        game = create_game()\n146\t        p1 = game.players[0]\n147\t        card = ManaSculpt(owner=p1, controller=p1)\n148\t        req = card.get_targets(game)[0]\n149\t        assert req.zone == Zone.STACK\n150\t\n151\t    def test_filter_accepts_an_instant_spell(self) -> None:\n152\t        game = create_game()\n153\t        p1, p2 = game.players\n154\t        card = ManaSculpt(owner=p1, controller=p1)\n155\t        req = card.get_targets(game)[0]\n156\t        victim = _victim_spell()\n157\t        assert req.filter_fn(victim) is True\n158\t\n159\t    def test_filter_accepts_a_sorcery_spell(self) -> None:\n160\t        game = create_game()\n161\t        p1 = game.players[0]\n162\t        card = ManaSculpt(owner=p1, controller=p1)\n163\t        req = card.get_targets(game)[0]\n164\t        sorc = Sorcery(name=\"Divination\", mana_cost=ManaCost.parse(\"{2}{U}\"))\n165\t        assert req.filter_fn(sorc) is True\n166\t\n167\t    def test_filter_rejects_a_player(self) -> None:\n168\t        \"\"\"'target spell' is not 'any target' — players are not legal.\"\"\"\n169\t        game = create_game()\n170\t        p1, p2 = game.players\n171\t        card = ManaSculpt(owner=p1, controller=p1)\n172\t        req = card.get_targets(game)[0]\n173\t        assert req.filter_fn(p1) is False\n174\t        assert req.filter_fn(p2) is False\n175\t\n176\t\n177\t# ---------------------------------------------------------------------------\n178\t# Counter resolution\n179\t# ---------------------------------------------------------------------------\n180\t\n181\t\n182\tclass TestManaSculptCounter:\n183\t    \"\"\"on_resolve counters the targeted spell: removes it from the stack and\n184\t    puts it into its owner's graveyard, and the spell never resolves.\"\"\"\n185\t\n186\t    def test_targeted_spell_leaves_the_stack(self) -> None:\n187\t        game = create_game()\n188\t        p1, p2 = game.players\n189\t        victim = _victim_spell()\n190\t        victim_obj = _put_spell_on_stack(game, p2, victim)\n191\t\n192\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n193\t        sculpt.chosen_targets = [victim]\n194\t        sculpt.on_resolve(game)\n195\t\n196\t        assert victim_obj not in game.stack.objects()\n197\t        assert not p2.zones[Zone.STACK].contains(victim)\n198\t\n199\t    def test_countered_spell_goes_to_owners_graveyard(self) -> None:\n200\t        game = create_game()\n201\t        p1, p2 = game.players\n202\t        victim = _victim_spell()\n203\t        _put_spell_on_stack(game, p2, victim)\n204\t\n205\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n206\t        sculpt.chosen_targets = [victim]\n207\t        sculpt.on_resolve(game)\n208\t\n209\t        assert p2.zones[Zone.GRAVEYARD].contains(victim)\n210\t\n211\t    def test_countered_spell_does_not_resolve(self) -> None:\n212\t        \"\"\"A countered spell's on_resolve callback must never fire.\"\"\"\n213\t        game = create_game()\n214\t        p1, p2 = game.players\n215\t        victim = _victim_spell()\n216\t        victim_obj = _put_spell_on_stack(game, p2, victim)\n217\t\n218\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n219\t        sculpt.chosen_targets = [victim]\n220\t        sculpt.on_resolve(game)\n221\t\n222\t        # The counter removes the victim's StackObject, so its resolve\n223\t        # callback can never fire.  Confirm the spell is no longer pending on\n224\t        # the stack and never reached the battlefield.\n225\t        assert victim_obj not in game.stack.objects()\n226\t        assert not p2.zones[Zone.BATTLEFIELD].contains(victim)\n227\t\n228\t    def test_no_target_resolution_is_safe_noop(self) -> None:\n229\t        \"\"\"If the spell has no legal target (none chosen), resolution must not\n230\t        raise and must not affect the stack.\"\"\"\n231\t        game = create_game()\n232\t        p1 = game.players[0]\n233\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n234\t        sculpt.chosen_targets = []\n235\t        # Should not raise.\n236\t        sculpt.on_resolve(game)\n237\t        assert game.stack.is_empty()\n238\t\n239\t\n240\t# ---------------------------------------------------------------------------\n241\t# Conditional delayed mana — \"If you control a Wizard ...\"\n242\t# ---------------------------------------------------------------------------\n243\t\n244\t\n245\tclass TestManaSculptWizardConditional:\n246\t    \"\"\"The colorless-mana payoff is conditional on controlling a Wizard when\n247\t    Mana Sculpt resolves.  We observe the conditional by inspecting whether a\n248\t    delayed effect (a registered trigger) is created on resolution.\"\"\"\n249\t\n250\t    def _triggers_for(self, game: Any, source: Any) -> list[Any]:\n251\t        return game.trigger_manager.get_triggers_for_source(source)\n252\t\n253\t    def test_no_wizard_sets_up_no_delayed_mana_effect(self) -> None:\n254\t        \"\"\"With no Wizard controlled, the spell only counters — no delayed\n255\t        mana trigger is registered for it.\"\"\"\n256\t        game = create_game()\n257\t        p1, p2 = game.players\n258\t        # p1 controls a non-Wizard creature only.\n259\t        set_board_state(game, 0, battlefield=[_non_wizard()])\n260\t        victim = _victim_spell()\n261\t        _put_spell_on_stack(game, p2, victim)\n262\t\n263\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n264\t        sculpt.chosen_targets = [victim]\n265\t        before = len(game.trigger_manager.get_triggers())\n266\t        sculpt.on_resolve(game)\n267\t        after = len(game.trigger_manager.get_triggers())\n268\t\n269\t        # No new delayed trigger should have been registered.\n270\t        assert after == before\n271\t        # And the counter still happened.\n272\t        assert p2.zones[Zone.GRAVEYARD].contains(victim)\n273\t\n274\t    def test_wizard_control_sets_up_a_delayed_mana_effect(self) -> None:\n275\t        \"\"\"With a Wizard controlled, resolution registers a delayed trigger\n276\t        (for the 'beginning of your next main phase' mana payoff).\"\"\"\n277\t        game = create_game()\n278\t        p1, p2 = game.players\n279\t        set_board_state(game, 0, battlefield=[_wizard()])\n280\t        victim = _victim_spell()\n281\t        _put_spell_on_stack(game, p2, victim)\n282\t\n283\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n284\t        sculpt.chosen_targets = [victim]\n285\t        before = len(game.trigger_manager.get_triggers())\n286\t        sculpt.on_resolve(game)\n287\t        after = len(game.trigger_manager.get_triggers())\n288\t\n289\t        assert after - before == 1\n290\t\n291\t    def test_delayed_effect_controlled_by_mana_sculpt_caster(self) -> None:\n292\t        \"\"\"The delayed mana effect belongs to Mana Sculpt's controller — they\n293\t        are the player who gets the {C}.\"\"\"\n294\t        game = create_game()\n295\t        p1, p2 = game.players\n296\t        set_board_state(game, 0, battlefield=[_wizard()])\n297\t        victim = _victim_spell()\n298\t        _put_spell_on_stack(game, p2, victim)\n299\t\n300\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n301\t        sculpt.chosen_targets = [victim]\n302\t        sculpt.on_resolve(game)\n303\t\n304\t        new_triggers = [\n305\t            t\n306\t            for t in game.trigger_manager.get_triggers()\n307\t            if t.controller is p1\n308\t        ]\n309\t        assert len(new_triggers) >= 1\n310\t\n311\t\n312\t# ---------------------------------------------------------------------------\n313\t# Delayed mana amount + payoff\n314\t# ---------------------------------------------------------------------------\n315\t\n316\t\n317\tclass TestManaSculptManaPayoff:\n318\t    \"\"\"When the delayed effect fires (controller's next main phase), it adds\n319\t    colorless mana equal to the amount of mana spent on the countered spell.\n320\t\n321\t    We drive the payoff by firing the registered trigger's effect directly and\n322\t    observing the controller's mana pool gain colorless mana.\"\"\"\n323\t\n324\t    def _resolve_delayed_effect(self, game: Any, source: Any) -> None:\n325\t        \"\"\"Find and run the delayed effect registered by *source*.\"\"\"\n326\t        triggers = game.trigger_manager.get_triggers_for_source(source)\n327\t        assert triggers, \"expected a delayed trigger registered by Mana Sculpt\"\n328\t        for t in triggers:\n329\t            t.effect(game)\n330\t\n331\t    def test_payoff_adds_colorless_equal_to_mana_spent(self) -> None:\n332\t        \"\"\"A 3-mana spell countered → 3 colorless added to controller's pool.\"\"\"\n333\t        game = create_game()\n334\t        p1, p2 = game.players\n335\t        set_board_state(game, 0, battlefield=[_wizard()])\n336\t        # A spell whose mana value / mana spent is 3 ({1}{U}{U}).\n337\t        victim = _victim_spell(name=\"Cancel\", cost=\"{1}{U}{U}\")\n338\t        _put_spell_on_stack(game, p2, victim)\n339\t\n340\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n341\t        sculpt.chosen_targets = [victim]\n342\t        p1.mana_pool.empty()\n343\t        sculpt.on_resolve(game)\n344\t\n345\t        self._resolve_delayed_effect(game, sculpt)\n346\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 3\n347\t\n348\t    def test_payoff_amount_scales_with_spell_cost(self) -> None:\n349\t        \"\"\"A 1-mana spell countered → only 1 colorless added.\"\"\"\n350\t        game = create_game()\n351\t        p1, p2 = game.players\n352\t        set_board_state(game, 0, battlefield=[_wizard()])\n353\t        victim = _victim_spell(name=\"Lightning Bolt\", cost=\"{R}\")\n354\t        _put_spell_on_stack(game, p2, victim)\n355\t\n356\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n357\t        sculpt.chosen_targets = [victim]\n358\t        p1.mana_pool.empty()\n359\t        sculpt.on_resolve(game)\n360\t\n361\t        self._resolve_delayed_effect(game, sculpt)\n362\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 1\n363\t\n364\t    def test_payoff_mana_is_colorless_not_colored(self) -> None:\n365\t        \"\"\"The added mana is {C} — no colored mana is produced.\"\"\"\n366\t        game = create_game()\n367\t        p1, p2 = game.players\n368\t        set_board_state(game, 0, battlefield=[_wizard()])\n369\t        victim = _victim_spell(name=\"Cancel\", cost=\"{1}{U}{U}\")\n370\t        _put_spell_on_stack(game, p2, victim)\n371\t\n372\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n373\t        sculpt.chosen_targets = [victim]\n374\t        p1.mana_pool.empty()\n375\t        sculpt.on_resolve(game)\n376\t\n377\t        self._resolve_delayed_effect(game, sculpt)\n378\t        for mt in (\n379\t            ManaType.WHITE,\n380\t            ManaType.BLUE,\n381\t            ManaType.BLACK,\n382\t            ManaType.RED,\n383\t            ManaType.GREEN,\n384\t        ):\n385\t            assert p1.mana_pool.get(mt) == 0\n386\t"}]},"parent_tool_use_id":"toolu_0144yyhQJidrLDrPv1Gwwc7v","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"f04fe147-9153-4aeb-8671-9ac8b42d09ef","timestamp":"2026-06-01T11:06:19.650Z","subagent_type":"Tester","task_description":"Extend tests for sos_57"}
