{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RcoBtft8EP8LUjEApPDkQm","type":"tool_result","content":"1\t\"\"\"Card implementation for Lorehold, the Historian (SOS 201).\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.events import BeginningOfUpkeepTriggeredEvent\n9\tfrom engine.types import CardType, Keyword, ManaCost, Supertype\n10\t\n11\tif TYPE_CHECKING:\n12\t    from engine.game_state import GameState\n13\t\n14\t\n15\t# Card types that gain miracle from Lorehold's static ability.\n16\t_INSTANT_OR_SORCERY = frozenset({CardType.INSTANT, CardType.SORCERY})\n17\t\n18\t# The miracle cost Lorehold grants: {2}.\n19\t_MIRACLE_COST = ManaCost.parse(\"{2}\")\n20\t\n21\t\n22\tdef _is_instant_or_sorcery(card: Any) -> bool:\n23\t    \"\"\"Return ``True`` if *card* is an instant or sorcery card.\"\"\"\n24\t    return bool(getattr(card, \"card_types\", set()) & _INSTANT_OR_SORCERY)\n25\t\n26\t\n27\tclass LoreholdTheHistorian(Creature):\n28\t    \"\"\"Lorehold, the Historian — {3}{R}{W} — Legendary Creature — Elder Dragon.\n29\t\n30\t    Flying, haste\n31\t    Each instant and sorcery card in your hand has miracle {2}. (You may cast a\n32\t    card for its miracle cost when you draw it if it's the first card you drew\n33\t    this turn.)\n34\t    At the beginning of each opponent's upkeep, you may discard a card. If you\n35\t    do, draw a card.\n36\t\n37\t    SOS collector number 201.\n38\t    \"\"\"\n39\t\n40\t    def __init__(self, **kwargs: Any) -> None:\n41\t        kwargs.setdefault(\"name\", \"Lorehold, the Historian\")\n42\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{3}{R}{W}\"))\n43\t        kwargs.setdefault(\"subtypes\", {\"Elder\", \"Dragon\"})\n44\t        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n45\t        kwargs.setdefault(\"keywords\", Keyword.FLYING | Keyword.HASTE)\n46\t        kwargs.setdefault(\"base_power\", 5)\n47\t        kwargs.setdefault(\"base_toughness\", 5)\n48\t        kwargs.setdefault(\n49\t            \"rules_text\",\n50\t            \"Flying, haste\\n\"\n51\t            \"Each instant and sorcery card in your hand has miracle {2}. \"\n52\t            \"(You may cast a card for its miracle cost when you draw it if \"\n53\t            \"it's the first card you drew this turn.)\\n\"\n54\t            \"At the beginning of each opponent's upkeep, you may discard a \"\n55\t            \"card. If you do, draw a card.\",\n56\t        )\n57\t        super().__init__(**kwargs)\n58\t\n59\t    # ------------------------------------------------------------------\n60\t    # Miracle grant — \"Each instant and sorcery card in your hand has\n61\t    # miracle {2}.\"\n62\t    # ------------------------------------------------------------------\n63\t\n64\t    def miracle_cost(self, game: \"GameState\", card: Any) -> \"ManaCost | None\":\n65\t        \"\"\"Return the miracle cost Lorehold grants to *card*, or ``None``.\n66\t\n67\t        The grant is scoped to instant/sorcery cards that are in *this card's\n68\t        controller's hand* while Lorehold is in play; everything else (other\n69\t        card types, cards in an opponent's hand) gets ``None``.\n70\t\n71\t        As a side effect, the engine-level ``miracle_cost`` attribute is\n72\t        stamped onto qualifying cards so the engine's draw-time miracle hook\n73\t        (``engine.miracle.offer_miracle``) can offer the alternative cost when\n74\t        such a card is drawn.\n75\t        \"\"\"\n76\t        from engine.miracle import set_miracle_cost\n77\t\n78\t        controller = getattr(self, \"controller\", None) or getattr(self, \"owner\", None)\n79\t        if self._grants_miracle_to(game, card, controller):\n80\t            set_miracle_cost(card, _MIRACLE_COST)\n81\t            return _MIRACLE_COST\n82\t        return None\n83\t\n84\t    def _grants_miracle_to(\n85\t        self, game: \"GameState\", card: Any, controller: Any\n86\t    ) -> bool:\n87\t        \"\"\"Return ``True`` if Lorehold grants miracle to *card* right now.\"\"\"\n88\t        if controller is None:\n89\t            return False\n90\t        if not _is_instant_or_sorcery(card):\n91\t            return False\n92\t        # \"in your hand\": the card must be in the controller's hand.\n93\t        hand = game.get_hand(controller)\n94\t        return hand.contains(card)\n95\t\n96\t    def apply_miracle_grant(self, game: \"GameState\") -> None:\n97\t        \"\"\"Stamp miracle {2} onto every qualifying card in the controller's hand.\n98\t\n99\t        Convenience for callers (and the engine) that want to refresh the grant\n100\t        across the whole hand at once — e.g. after Lorehold enters or after the\n101\t        controller draws.  Idempotent.\n102\t        \"\"\"\n103\t        controller = getattr(self, \"controller\", None) or getattr(self, \"owner\", None)\n104\t        if controller is None:\n105\t            return\n106\t        for card in game.get_hand(controller).get_all():\n107\t            self.miracle_cost(game, card)\n108\t\n109\t    # ------------------------------------------------------------------\n110\t    # Opponent-upkeep loot trigger\n111\t    # ------------------------------------------------------------------\n112\t\n113\t    def register_triggers(self, game: \"GameState\") -> None:\n114\t        \"\"\"Register the 'each opponent's upkeep' optional loot trigger.\n115\t\n116\t        ``BeginningOfUpkeepTriggeredEvent`` carries no player field, so the\n117\t        condition reads ``game.active_player`` (the player whose upkeep it is)\n118\t        and fires only when that player is NOT the controller.\n119\t        \"\"\"\n120\t        from engine.triggers import TriggerRegistration\n121\t\n122\t        controller = getattr(self, \"controller\", None) or getattr(self, \"owner\", None)\n123\t\n124\t        def _condition(g: \"GameState\", event: BeginningOfUpkeepTriggeredEvent) -> bool:\n125\t            # Fire only on an OPPONENT's upkeep (active player != controller).\n126\t            return g.active_player is not controller\n127\t\n128\t        def _effect(g: \"GameState\") -> None:\n129\t            _loot(g, controller)\n130\t\n131\t        game.trigger_manager.register(\n132\t            TriggerRegistration(\n133\t                event_type=BeginningOfUpkeepTriggeredEvent,\n134\t                condition=_condition,\n135\t                effect=_effect,\n136\t                source=self,\n137\t                controller=controller,\n138\t            )\n139\t        )\n140\t\n141\t\n142\tdef _loot(game: \"GameState\", controller: Any) -> None:\n143\t    \"\"\"Resolve \"you may discard a card. If you do, draw a card.\"\n144\t\n145\t    Contract for the deterministic test pipeline:\n146\t\n147\t    * ``controller.choose_yes_no`` drives the optional \"you may\" clause —\n148\t      script ``True`` to loot, ``False`` to decline.\n149\t    * ``controller.choose_card`` selects the card to discard.\n150\t    * The draw happens only if a card was actually discarded (\"If you do\").\n151\t      With an empty hand there is nothing to discard, so the draw is skipped\n152\t      regardless of the yes/no answer.\n153\t    \"\"\"\n154\t    from engine.game import discard, draw_card\n155\t\n156\t    if controller is None:\n157\t        return\n158\t\n159\t    hand = game.get_hand(controller)\n160\t    cards = hand.get_all()\n161\t    # \"If you do\" is conditional on actually discarding; with no card to\n162\t    # discard, nothing happens (and we don't prompt for a draw).\n163\t    if not cards:\n164\t        return\n165\t\n166\t    if hasattr(controller, \"choose_yes_no\"):\n167\t        if not controller.choose_yes_no(\"Discard a card to draw a card?\"):\n168\t            return\n169\t\n170\t    chosen = controller.choose_card(cards, \"card to discard\")\n171\t    if chosen is None or not hand.contains(chosen):\n172\t        return\n173\t\n174\t    discard(game, controller, chosen)\n175\t    # Discard succeeded — draw a card.\n176\t    draw_card(game, controller)\n177\t"}]},"parent_tool_use_id":"toolu_019Mbmw3oikAhHtz8Xfv7wgN","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"a3b38e28-7b86-482f-84ab-57880354a4c3","timestamp":"2026-06-01T11:40:02.238Z","subagent_type":"Tester","task_description":"Extend tests for sos_201"}
