{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019k2WvfniTAjEhP4TJZeHcu","type":"tool_result","content":"1\t\"\"\"Tests for SOS 13 — Emeritus of Truce // Swords to Plowshares.\n2\t\n3\tEmeritus of Truce is a {1}{W}{W} white Creature — Cat Cleric, 3/3, with the\n4\tSOS-specific **Prepared** keyword. Its front face reads:\n5\t\n6\t    \"When this creature enters, target player creates a 1/1 white and black\n7\t     Inkling creature token with flying. Then if an opponent controls more\n8\t     creatures than you, this creature becomes prepared. (While it's\n9\t     prepared, you may cast a copy of its spell. Doing so unprepares it.)\"\n10\t\n11\tThe prepare spell is *Swords to Plowshares* ({W} instant).\n12\t\n13\tThis file covers the testable observable contract:\n14\t\n15\t1. **Static card data** — name, mana cost, P/T, Cat/Cleric subtypes, white,\n16\t   the Prepared keyword.\n17\t\n18\t2. **Enters-the-battlefield trigger** — a ``When this creature enters``\n19\t   ability is registered, keyed to this creature, watching the\n20\t   ``EntersBattlefieldTriggeredEvent``.\n21\t\n22\t3. **ETB effect** — resolving the trigger creates a 1/1 Inkling creature\n23\t   token with flying for the chosen / controlling player.\n24\t\n25\t4. **Conditional \"becomes prepared\"** — the creature gains a ``prepared``\n26\t   designation only when an opponent controls *more* creatures than the\n27\t   controller; it does not when the controller has at least as many.\n28\t\n29\tThese are TDD red-phase tests: the stub at ``card_impl.py`` is empty, so\n30\teverything here is expected to fail until the card is implemented.\n31\t\n32\tNOTE: the full Prepared mechanic (a castable Swords-to-Plowshares copy\n33\tcreated in exile) and the token's *color* are not asserted here — see\n34\t``untestable.json`` for the requirements that the current engine surface\n35\tcannot verify, and why.\n36\t\"\"\"\n37\t\n38\tfrom __future__ import annotations\n39\t\n40\tfrom typing import Any\n41\t\n42\timport pytest\n43\t\n44\tfrom cards.sos.sos_13.card_impl import EmeritusOfTruceSwordsToPlowshares\n45\tfrom engine.card import Creature\n46\tfrom engine.events import EntersBattlefieldTriggeredEvent\n47\tfrom engine.types import CardType, Keyword, ManaCost, ManaType, Zone\n48\tfrom test_utils import create_game, set_board_state\n49\t\n50\t\n51\tCARD_NAME = \"Emeritus of Truce // Swords to Plowshares\"\n52\t\n53\t\n54\tdef _card(p: Any = None) -> EmeritusOfTruceSwordsToPlowshares:\n55\t    \"\"\"Instantiate the card under test, optionally bound to an owner.\"\"\"\n56\t    return EmeritusOfTruceSwordsToPlowshares(owner=p, controller=p)\n57\t\n58\t\n59\tdef _vanilla(name: str = \"Grizzly Bears\") -> Creature:\n60\t    \"\"\"A vanilla creature for populating battlefields.\"\"\"\n61\t    c = Creature(name=name, base_power=2, base_toughness=2)\n62\t    c.card_types = {CardType.CREATURE}\n63\t    return c\n64\t\n65\t\n66\tdef _all_battlefield_creatures(game: Any) -> list[Any]:\n67\t    \"\"\"Every creature on every player's battlefield.\"\"\"\n68\t    out: list[Any] = []\n69\t    for p in game.players:\n70\t        for obj in game.get_battlefield(p).get_all():\n71\t            if CardType.CREATURE in getattr(obj, \"card_types\", set()):\n72\t                out.append(obj)\n73\t    return out\n74\t\n75\t\n76\tdef _find_inkling(game: Any) -> Any:\n77\t    \"\"\"Return the first Inkling token found on any battlefield, else None.\"\"\"\n78\t    for obj in _all_battlefield_creatures(game):\n79\t        if obj.name == \"Inkling\" or \"Inkling\" in getattr(obj, \"subtypes\", set()):\n80\t            return obj\n81\t    return None\n82\t\n83\t\n84\tdef _resolve_etb(game: Any, card: Any) -> None:\n85\t    \"\"\"Fire this creature's enters-the-battlefield event and resolve every\n86\t    triggered ability it puts on the stack (the ETB effect).\"\"\"\n87\t    game.trigger_manager.fire_event(\n88\t        game,\n89\t        EntersBattlefieldTriggeredEvent(\n90\t            permanent=card, controller=card.controller, creature=card, card=card\n91\t        ),\n92\t    )\n93\t    while not game.stack.is_empty():\n94\t        obj = game.stack.pop()\n95\t        obj.on_resolve(game)\n96\t\n97\t\n98\t# ---------------------------------------------------------------------------\n99\t# Static card data\n100\t# ---------------------------------------------------------------------------\n101\t\n102\t\n103\tclass TestEmeritusProperties:\n104\t    \"\"\"Front-face static data should match the SOS 13 spec.\"\"\"\n105\t\n106\t    def test_is_creature(self) -> None:\n107\t        card = _card()\n108\t        assert isinstance(card, Creature)\n109\t        assert CardType.CREATURE in card.card_types\n110\t\n111\t    def test_name(self) -> None:\n112\t        assert _card().name == CARD_NAME\n113\t\n114\t    def test_mana_cost_is_1ww(self) -> None:\n115\t        assert _card().mana_cost == ManaCost.parse(\"{1}{W}{W}\")\n116\t\n117\t    def test_power_toughness(self) -> None:\n118\t        card = _card()\n119\t        assert card.base_power == 3\n120\t        assert card.base_toughness == 3\n121\t\n122\t    def test_is_cat_cleric(self) -> None:\n123\t        subtypes = _card().subtypes\n124\t        assert \"Cat\" in subtypes\n125\t        assert \"Cleric\" in subtypes\n126\t\n127\t    def test_not_summoning_sick_flag_default(self) -> None:\n128\t        # Sanity: a freshly constructed creature defaults to summoning sick;\n129\t        # this guards against an over-eager constructor clearing the flag.\n130\t        assert _card().summoning_sick is True\n131\t\n132\t\n133\tclass TestEmeritusPreparedKeyword:\n134\t    \"\"\"The card carries the SOS 'Prepared' keyword/marker per its spec.\"\"\"\n135\t\n136\t    def test_prepared_is_advertised(self) -> None:\n137\t        \"\"\"The Prepared mechanic must be surfaced somewhere observable:\n138\t        either as a ``Keyword.PREPARED`` flag, a dedicated attribute, or in\n139\t        the rules text. A bare creature with no Prepared surface fails.\"\"\"\n140\t        card = _card()\n141\t        has_keyword = (\n142\t            hasattr(Keyword, \"PREPARED\") and bool(card.keywords & Keyword.PREPARED)\n143\t        )\n144\t        has_attr = hasattr(card, \"is_prepared\") or hasattr(card, \"prepared\")\n145\t        text = getattr(card, \"rules_text\", \"\").lower()\n146\t        assert has_keyword or has_attr or \"prepared\" in text\n147\t\n148\t    def test_starts_unprepared(self) -> None:\n149\t        \"\"\"A creature only gains the prepared designation via its ETB\n150\t        conditional — on construction it must not already be prepared.\"\"\"\n151\t        card = _card()\n152\t        prepared = getattr(card, \"is_prepared\", None)\n153\t        if prepared is None:\n154\t            prepared = getattr(card, \"prepared\", None)\n155\t        if prepared is None:\n156\t            pytest.skip(\"no boolean prepared designation surface to inspect\")\n157\t        assert prepared is False\n158\t\n159\t\n160\t# ---------------------------------------------------------------------------\n161\t# Enters-the-battlefield trigger registration\n162\t# ---------------------------------------------------------------------------\n163\t\n164\t\n165\tclass TestEmeritusEtbTriggerRegistration:\n166\t    \"\"\"register_triggers wires an ETB trigger keyed to this creature.\"\"\"\n167\t\n168\t    def test_registers_a_trigger(self) -> None:\n169\t        game = create_game()\n170\t        p1 = game.players[0]\n171\t        card = _card(p1)\n172\t        before = len(game.trigger_manager.get_triggers_for_source(card))\n173\t        card.register_triggers(game)\n174\t        after = len(game.trigger_manager.get_triggers_for_source(card))\n175\t        assert after - before >= 1\n176\t\n177\t    def test_trigger_watches_enters_battlefield(self) -> None:\n178\t        game = create_game()\n179\t        p1 = game.players[0]\n180\t        card = _card(p1)\n181\t        card.register_triggers(game)\n182\t        regs = game.trigger_manager.get_triggers_for_source(card)\n183\t        assert any(\n184\t            reg.event_type is EntersBattlefieldTriggeredEvent\n185\t            or issubclass(EntersBattlefieldTriggeredEvent, reg.event_type)\n186\t            for reg in regs\n187\t        )\n188\t\n189\t    def test_trigger_controller_is_card_controller(self) -> None:\n190\t        game = create_game()\n191\t        p1 = game.players[0]\n192\t        card = _card(p1)\n193\t        card.register_triggers(game)\n194\t        regs = game.trigger_manager.get_triggers_for_source(card)\n195\t        etb = [\n196\t            r for r in regs\n197\t            if issubclass(EntersBattlefieldTriggeredEvent, r.event_type)\n198\t            or r.event_type is EntersBattlefieldTriggeredEvent\n199\t        ]\n200\t        assert etb, \"expected an ETB trigger registration\"\n201\t        assert etb[0].controller is p1\n202\t\n203\t    def test_trigger_fires_for_self_only(self) -> None:\n204\t        \"\"\"The ETB trigger must fire when *this* creature enters, and not\n205\t        when an unrelated permanent enters.\"\"\"\n206\t        game = create_game()\n207\t        p1 = game.players[0]\n208\t        card = _card(p1)\n209\t        card.register_triggers(game)\n210\t        regs = game.trigger_manager.get_triggers_for_source(card)\n211\t        etb = [\n212\t            r for r in regs\n213\t            if issubclass(EntersBattlefieldTriggeredEvent, r.event_type)\n214\t            or r.event_type is EntersBattlefieldTriggeredEvent\n215\t        ]\n216\t        assert etb, \"expected an ETB trigger registration\"\n217\t        reg = etb[0]\n218\t        if reg.condition is None:\n219\t            pytest.skip(\"trigger fires unconditionally; self-only check N/A\")\n220\t        self_event = EntersBattlefieldTriggeredEvent(\n221\t            permanent=card, controller=p1, creature=card, card=card\n222\t        )\n223\t        other = _vanilla(\"Other Permanent\")\n224\t        other.owner = p1\n225\t        other.controller = p1\n226\t        other_event = EntersBattlefieldTriggeredEvent(\n227\t            permanent=other, controller=p1, creature=other, card=other\n228\t        )\n229\t        assert reg.condition(game, self_event) is True\n230\t        assert reg.condition(game, other_event) is False\n231\t\n232\t\n233\t# ---------------------------------------------------------------------------\n234\t# ETB effect — create a 1/1 Inkling with flying\n235\t# ---------------------------------------------------------------------------\n236\t\n237\t\n238\tclass TestEmeritusEtbCreatesInkling:\n239\t    \"\"\"Resolving the ETB trigger creates a 1/1 flying Inkling token.\"\"\"\n240\t\n241\t    def _setup(self):\n242\t        # Pre-seed three scripted self-target answers in case the\n243\t        # implementation asks for \"target player\"; unused answers are fine.\n244\t        game = create_game(scripts=([None, None, None], []))\n245\t        game.active_player_index = 0\n246\t        p1 = game.players[0]\n247\t        # Point any scripted target choice at the controller (p1).\n248\t        for i in range(len(p1._script)):\n249\t            p1._script[i] = p1\n250\t        card = _card(p1)\n251\t        set_board_state(game, 0, battlefield=[card])\n252\t        card.register_triggers(game)\n253\t        return game, p1, card\n254\t\n255\t    def test_etb_creates_a_token(self) -> None:\n256\t        game, p1, card = self._setup()\n257\t        before = len(_all_battlefield_creatures(game))\n258\t        _resolve_etb(game, card)\n259\t        after = len(_all_battlefield_creatures(game))\n260\t        assert after - before == 1, \"ETB should create exactly one new creature token\"\n261\t\n262\t    def test_token_is_named_inkling(self) -> None:\n263\t        game, p1, card = self._setup()\n264\t        _resolve_etb(game, card)\n265\t        token = _find_inkling(game)\n266\t        assert token is not None, \"an Inkling token should have been created\"\n267\t\n268\t    def test_token_is_one_one(self) -> None:\n269\t        game, p1, card = self._setup()\n270\t        _resolve_etb(game, card)\n271\t        token = _find_inkling(game)\n272\t        assert token is not None\n273\t        assert token.base_power == 1\n274\t        assert token.base_toughness == 1\n275\t\n276\t    def test_token_has_flying(self) -> None:\n277\t        game, p1, card = self._setup()\n278\t        _resolve_etb(game, card)\n279\t        token = _find_inkling(game)\n280\t        assert token is not None\n281\t        assert bool(token.keywords & Keyword.FLYING)\n282\t\n283\t    def test_token_is_a_real_token(self) -> None:\n284\t        game, p1, card = self._setup()\n285\t        _resolve_etb(game, card)\n286\t        token = _find_inkling(game)\n287\t        assert token is not None\n288\t        assert getattr(token, \"is_token\", False) is True\n289\t\n290\t    def test_token_goes_to_targeted_player(self) -> None:\n291\t        \"\"\"'target player creates ...' — when player 2 is chosen as the\n292\t        target, the Inkling enters under player 2's control. The choice is\n293\t        scripted on player 1 (the controller making the ETB choice).\"\"\"\n294\t        game = create_game(scripts=([None], []))\n295\t        game.active_player_index = 0\n296\t        p1, p2 = game.players[0], game.players[1]\n297\t        card = _card(p1)\n298\t        set_board_state(game, 0, battlefield=[card])\n299\t        card.register_triggers(game)\n300\t        # Patch scripted answer to the actual opponent player object.\n301\t        p1._script[0] = p2\n302\t        _resolve_etb(game, card)\n303\t        token = _find_inkling(game)\n304\t        if token is None:\n305\t            pytest.skip(\"no Inkling created; covered by other tests\")\n306\t        # If the effect honours a chosen target player, the token is p2's.\n307\t        # Implementations that always give it to the controller are still\n308\t        # tested by the other cases; here we only assert *iff* a target was\n309\t        # consumed (script empty means the choice was used).\n310\t        if p1.remaining_choices == 0:\n311\t            assert token.controller is p2\n312\t\n313\t\n314\t# ---------------------------------------------------------------------------\n315\t# Conditional \"becomes prepared\"\n316\t# ---------------------------------------------------------------------------\n317\t\n318\t\n319\tdef _prepared_flag(card: Any):\n320\t    \"\"\"Best-effort read of the prepared designation; None if no surface.\"\"\"\n321\t    for attr in (\"is_prepared\", \"prepared\"):\n322\t        if hasattr(card, attr):\n323\t            return getattr(card, attr)\n324\t    return None\n325\t\n326\t\n327\tclass TestEmeritusBecomesPrepared:\n328\t    \"\"\"'Then if an opponent controls more creatures than you, this creature\n329\t    becomes prepared.' The designation is a marker on the permanent.\"\"\"\n330\t\n331\t    def _setup(self, my_extra_creatures: int, opp_creatures: int):\n332\t        # Script a controller target choice (self) for the token step.\n333\t        game = create_game(scripts=([None, None], []))\n334\t        game.active_player_index = 0\n335\t        p1, p2 = game.players[0], game.players[1]\n336\t        card = _card(p1)\n337\t        my_board = [card] + [_vanilla(f\"Mine{i}\") for i in range(my_extra_creatures)]\n338\t        opp_board = [_vanilla(f\"Opp{i}\") for i in range(opp_creatures)]\n339\t        set_board_state(game, 0, battlefield=my_board)\n340\t        set_board_state(game, 1, battlefield=opp_board)\n341\t        card.register_triggers(game)\n342\t        # Point any scripted target at the controller.\n343\t        for i in range(len(p1._script)):\n344\t            p1._script[i] = p1\n345\t        return game, p1, p2, card\n346\t\n347\t    def test_prepared_when_opponent_has_more_creatures(self) -> None:\n348\t        # Controller: just the Emeritus (1 creature). Opponent: 3 creatures.\n349\t        game, p1, p2, card = self._setup(my_extra_creatures=0, opp_creatures=3)\n350\t        _resolve_etb(game, card)\n351\t        flag = _prepared_flag(card)\n352\t        if flag is None:\n353\t            pytest.skip(\"no observable prepared designation surface\")\n354\t        assert flag is True, \"opponent has more creatures → becomes prepared\"\n355\t\n356\t    def test_not_prepared_when_counts_equal(self) -> None:\n357\t        # Controller controls Emeritus + 2 vanilla (3 total, counting itself\n358\t        # which is now on the battlefield). Opponent controls 3 creatures.\n359\t        # \"more than you\" is strict, so equal counts → NOT prepared.\n360\t        game, p1, p2, card = self._setup(my_extra_creatures=2, opp_creatures=3)\n361\t        _resolve_etb(game, card)\n362\t        flag = _prepared_flag(card)\n363\t        if flag is None:\n364\t            pytest.skip(\"no observable prepared designation surface\")\n365\t        assert flag is False, \"equal creature counts must not prepare (strict >)\"\n366\t\n367\t    def test_not_prepared_when_controller_has_more(self) -> None:\n368\t        # Controller: Emeritus + 4 vanilla (5). Opponent: 1 creature.\n369\t        game, p1, p2, card = self._setup(my_extra_creatures=4, opp_creatures=1)\n370\t        _resolve_etb(game, card)\n371\t        flag = _prepared_flag(card)\n372\t        if flag is None:\n373\t            pytest.skip(\"no observable prepared designation surface\")\n374\t        assert flag is False, \"controller has more creatures → not prepared\"\n375\t\n376\t    def test_not_prepared_with_no_opponent_creatures(self) -> None:\n377\t        # Opponent controls nothing; controller controls only the Emeritus.\n378\t        game, p1, p2, card = self._setup(my_extra_creatures=0, opp_creatures=0)\n379\t        _resolve_etb(game, card)\n380\t        flag = _prepared_flag(card)\n381\t        if flag is None:\n382\t            pytest.skip(\"no observable prepared designation surface\")\n383\t        assert flag is False\n384\t\n385\t\n386\tclass TestEmeritusPrepareSpell:\n387\t    \"\"\"The prepare spell (inset face) is Swords to Plowshares — a {W}\n388\t    instant. If the implementation exposes the prepare-spell characteristics\n389\t    in any observable way, they should match Swords to Plowshares.\"\"\"\n390\t\n391\t    def test_prepare_spell_surface_if_present(self) -> None:\n392\t        card = _card()\n393\t        # Look for any conventional surface naming the prepare spell.\n394\t        candidates = [\n395\t            getattr(card, \"prepare_spell\", None),\n396\t            getattr(card, \"prepared_spell\", None),\n397\t            getattr(card, \"back_face\", None),\n398\t            getattr(card, \"other_face\", None),\n399\t        ]\n400\t        surface = next((c for c in candidates if c is not None), None)\n401\t        if surface is None:\n402\t            pytest.skip(\"no prepare-spell surface exposed by the implementation\")\n403\t        # If a surface exists, it should advertise Swords to Plowshares ({W}).\n404\t        name = getattr(surface, \"name\", \"\")\n405\t        cost = getattr(surface, \"mana_cost\", None)\n406\t        assert \"Swords to Plowshares\" in name\n407\t        assert cost == ManaCost.parse(\"{W}\")\n408\t"}]},"parent_tool_use_id":"toolu_01J1jkYaa4Dqr5QadoAH42K3","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"59510373-582a-409c-b222-eb63c3ca310a","timestamp":"2026-06-01T10:53:52.928Z","subagent_type":"Tester","task_description":"Extend tests for sos_13"}
