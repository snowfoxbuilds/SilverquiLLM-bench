{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GAotnYgfNVm27b2YhmZfR6","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_1/card_impl.py b/cards/sos/sos_1/card_impl.py\n2\tindex 6f6280e..157f2f7 100644\n3\t--- a/cards/sos/sos_1/card_impl.py\n4\t+++ b/cards/sos/sos_1/card_impl.py\n5\t@@ -1,16 +1,180 @@\n6\t-\"\"\"Card implementation for The Dawning Archaic.\"\"\"\n7\t+\"\"\"Card implementation for The Dawning Archaic (SOS 1).\"\"\"\n8\t \n9\t from __future__ import annotations\n10\t \n11\t-from engine.card import CardImpl\n12\t+from typing import TYPE_CHECKING, Any\n13\t \n14\t-from typing import TYPE_CHECKING\n15\t+from engine.card import Creature\n16\t+from engine.events import AttacksTriggeredEvent\n17\t+from engine.types import CardType, Keyword, ManaCost, Supertype\n18\t \n19\t if TYPE_CHECKING:\n20\t     from engine.game_state import GameState\n21\t \n22\t \n23\t-class TheDawningArchaic(CardImpl):\n24\t-    \"\"\"TODO: Implement The Dawning Archaic.\"\"\"\n25\t+# Card types that count toward The Dawning Archaic's cost reduction.\n26\t+_INSTANT_OR_SORCERY = frozenset({CardType.INSTANT, CardType.SORCERY})\n27\t \n28\t-    pass\n29\t+\n30\t+def _is_instant_or_sorcery(card: Any) -> bool:\n31\t+    \"\"\"Return ``True`` if *card* is an instant or sorcery card.\"\"\"\n32\t+    return bool(getattr(card, \"card_types\", set()) & _INSTANT_OR_SORCERY)\n33\t+\n34\t+\n35\t+class TheDawningArchaic(Creature):\n36\t+    \"\"\"The Dawning Archaic — {10} — 7/7 — Legendary Creature — Avatar.\n37\t+\n38\t+    This spell costs {1} less to cast for each instant and sorcery card in\n39\t+    your graveyard.\n40\t+    Reach\n41\t+    Whenever The Dawning Archaic attacks, you may cast target instant or\n42\t+    sorcery card from your graveyard without paying its mana cost.  If that\n43\t+    spell would be put into your graveyard, exile it instead.\n44\t+\n45\t+    SOS collector number 1.\n46\t+    \"\"\"\n47\t+\n48\t+    def __init__(self, **kwargs: Any) -> None:\n49\t+        kwargs.setdefault(\"name\", \"The Dawning Archaic\")\n50\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{10}\"))\n51\t+        kwargs.setdefault(\"subtypes\", {\"Avatar\"})\n52\t+        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n53\t+        kwargs.setdefault(\"keywords\", Keyword.REACH)\n54\t+        kwargs.setdefault(\"base_power\", 7)\n55\t+        kwargs.setdefault(\"base_toughness\", 7)\n56\t+        kwargs.setdefault(\n57\t+            \"rules_text\",\n58\t+            \"This spell costs {1} less to cast for each instant and sorcery \"\n59\t+            \"card in your graveyard.\\nReach\\nWhenever The Dawning Archaic \"\n60\t+            \"attacks, you may cast target instant or sorcery card from your \"\n61\t+            \"graveyard without paying its mana cost. If that spell would be \"\n62\t+            \"put into your graveyard, exile it instead.\",\n63\t+        )\n64\t+        super().__init__(**kwargs)\n65\t+\n66\t+    # ------------------------------------------------------------------\n67\t+    # Cost reduction\n68\t+    # ------------------------------------------------------------------\n69\t+\n70\t+    def cost_reduction(self, game: GameState) -> int:\n71\t+        \"\"\"Return {1} per instant/sorcery card in the controller's graveyard.\n72\t+\n73\t+        Reports the raw per-card count; ``engine.casting.get_cost_reduction``\n74\t+        clamps it to the printed generic at payment time.\n75\t+        \"\"\"\n76\t+        controller = getattr(self, \"controller\", None) or getattr(self, \"owner\", None)\n77\t+        if controller is None:\n78\t+            return 0\n79\t+        graveyard = game.get_graveyard(controller)\n80\t+        return sum(1 for card in graveyard.get_all() if _is_instant_or_sorcery(card))\n81\t+\n82\t+    # ------------------------------------------------------------------\n83\t+    # Attack trigger\n84\t+    # ------------------------------------------------------------------\n85\t+\n86\t+    def register_triggers(self, game: GameState) -> None:\n87\t+        \"\"\"Register the 'whenever ~ attacks' free-cast-from-graveyard trigger.\"\"\"\n88\t+        from engine.triggers import TriggerRegistration\n89\t+\n90\t+        source = self\n91\t+        controller = getattr(self, \"controller\", None) or game.active_player\n92\t+\n93\t+        def _condition(game: Any, event: AttacksTriggeredEvent) -> bool:\n94\t+            return event.creature is source\n95\t+\n96\t+        def _effect(game: GameState) -> None:\n97\t+            _cast_from_graveyard(game, source)\n98\t+\n99\t+        game.trigger_manager.register(\n100\t+            TriggerRegistration(\n101\t+                event_type=AttacksTriggeredEvent,\n102\t+                condition=_condition,\n103\t+                effect=_effect,\n104\t+                source=self,\n105\t+                controller=controller,\n106\t+            )\n107\t+        )\n108\t+\n109\t+\n110\t+def _cast_from_graveyard(game: GameState, source: Any) -> None:\n111\t+    \"\"\"Resolve the attack trigger: optionally free-cast a graveyard spell.\n112\t+\n113\t+    Contract exposed for the deterministic test pipeline:\n114\t+\n115\t+    * ``controller.choose_yes_no`` is asked first (the \"you may\" clause).\n116\t+      Script ``True`` to cast, ``False`` to decline.\n117\t+    * If casting, ``controller.choose_card`` selects the target instant or\n118\t+      sorcery from the controller's graveyard.\n119\t+    * The chosen spell is cast for free via\n120\t+      :func:`engine.casting.cast_spell_free` from the graveyard, and is\n121\t+      flagged (``card._exile_if_goes_to_graveyard = True``) so the engine\n122\t+      exiles it instead of putting it into the graveyard on resolution —\n123\t+      registered through the replacement-effect machinery.\n124\t+    \"\"\"\n125\t+    from engine.casting import cast_spell_free, CastingError\n126\t+    from engine.types import Zone\n127\t+\n128\t+    controller = getattr(source, \"controller\", None)\n129\t+    if controller is None:\n130\t+        return\n131\t+\n132\t+    graveyard = game.get_graveyard(controller)\n133\t+    candidates = [c for c in graveyard.get_all() if _is_instant_or_sorcery(c)]\n134\t+    if not candidates:\n135\t+        return\n136\t+\n137\t+    # \"you may\" — ask whether to use the ability.\n138\t+    if not controller.choose_yes_no(\n139\t+        \"Cast an instant or sorcery from your graveyard for free?\"\n140\t+    ):\n141\t+        return\n142\t+\n143\t+    target = controller.choose_card(\n144\t+        candidates, \"target instant or sorcery card in your graveyard\"\n145\t+    )\n146\t+    if target is None or not graveyard.contains(target):\n147\t+        return\n148\t+\n149\t+    # Register the \"exile instead of graveyard\" replacement for this spell\n150\t+    # before casting it, using the engine's replacement-effect machinery.\n151\t+    _register_exile_replacement(game, target, controller)\n152\t+\n153\t+    try:\n154\t+        cast_spell_free(game, controller, target, Zone.GRAVEYARD)\n155\t+    except CastingError:\n156\t+        # Could not be cast (e.g. illegal target choices) — clean up the\n157\t+        # replacement so it does not linger.\n158\t+        game.replacement_manager.unregister(target)\n159\t+        if hasattr(target, \"_exile_if_goes_to_graveyard\"):\n160\t+            del target._exile_if_goes_to_graveyard\n161\t+\n162\t+\n163\t+def _register_exile_replacement(game: GameState, spell: Any, controller: Any) -> None:\n164\t+    \"\"\"Register a replacement: if *spell* would go to a graveyard, exile it.\n165\t+\n166\t+    Uses ``engine.replacement_effects.ReplacementEffect`` keyed to the\n167\t+    spell as source.  The replacement self-unregisters after firing once.\n168\t+    \"\"\"\n169\t+    from engine.events import SpellToGraveyardReplacementEvent\n170\t+    from engine.replacement_effects import ReplacementEffect\n171\t+\n172\t+    spell._exile_if_goes_to_graveyard = True\n173\t+\n174\t+    def _condition(game: Any, event: SpellToGraveyardReplacementEvent) -> bool:\n175\t+        return event.spell is spell and event.destination == \"graveyard\"\n176\t+\n177\t+    def _replacement(\n178\t+        game: Any, event: SpellToGraveyardReplacementEvent\n179\t+    ) -> SpellToGraveyardReplacementEvent:\n180\t+        event.destination = \"exile\"\n181\t+        return event\n182\t+\n183\t+    game.replacement_manager.register(\n184\t+        ReplacementEffect(\n185\t+            event_type=SpellToGraveyardReplacementEvent,\n186\t+            source=spell,\n187\t+            condition=_condition,\n188\t+            replacement=_replacement,\n189\t+            controller=controller,\n190\t+        )\n191\t+    )\n192\tdiff --git a/engine/casting.py b/engine/casting.py\n193\tindex 5d8acca..0d85692 100644\n194\t--- a/engine/casting.py\n195\t+++ b/engine/casting.py\n196\t@@ -406,8 +406,48 @@ def _resolve_spell(\n197\t         # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n198\t         move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n199\t     else:\n200\t-        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n201\t-        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n202\t+        # Instant/sorcery: the spell would be put into its owner's graveyard.\n203\t+        # Consult replacement effects so that effects such as \"if that spell\n204\t+        # would be put into your graveyard, exile it instead\" can redirect\n205\t+        # the destination zone.\n206\t+        dest_zone = _resolve_spell_graveyard_destination(game, card)\n207\t+        move_to_zone(game, card, Zone.STACK, dest_zone)\n208\t+        # Clean up any spell-specific exile replacement / flag now that the\n209\t+        # spell has left the stack.\n210\t+        game.replacement_manager.unregister(card)\n211\t+        if hasattr(card, \"_exile_if_goes_to_graveyard\"):\n212\t+            del card._exile_if_goes_to_graveyard\n213\t+\n214\t+\n215\t+# Destination string → Zone for spell graveyard-replacement redirection.\n216\t+_SPELL_DESTINATION_ZONE_MAP: dict[str, Zone] = {\n217\t+    \"graveyard\": Zone.GRAVEYARD,\n218\t+    \"exile\": Zone.EXILE,\n219\t+    \"hand\": Zone.HAND,\n220\t+    \"library\": Zone.LIBRARY,\n221\t+}\n222\t+\n223\t+\n224\t+def _resolve_spell_graveyard_destination(game: GameState, card: CardImpl) -> Zone:\n225\t+    \"\"\"Return the zone an instant/sorcery should move to on resolution.\n226\t+\n227\t+    Builds a :class:`~engine.events.SpellToGraveyardReplacementEvent` and runs\n228\t+    it through the replacement manager so replacement effects can redirect the\n229\t+    spell (e.g. exile instead of graveyard).  Defaults to the graveyard.\n230\t+    \"\"\"\n231\t+    from engine.events import SpellToGraveyardReplacementEvent\n232\t+\n233\t+    controller = getattr(card, \"controller\", None)\n234\t+    owner = getattr(card, \"owner\", None) or controller\n235\t+    event = SpellToGraveyardReplacementEvent(\n236\t+        destination=\"graveyard\",\n237\t+        controller=controller,\n238\t+        owner=owner,\n239\t+        spell=card,\n240\t+    )\n241\t+    event = game.replacement_manager.apply(game, event)\n242\t+    destination_str = getattr(event, \"destination\", \"graveyard\")\n243\t+    return _SPELL_DESTINATION_ZONE_MAP.get(destination_str, Zone.GRAVEYARD)\n244\t \n245\t \n246\t # ------------------------------------------------------------------\n247\tdiff --git a/engine/events.py b/engine/events.py\n248\tindex 9f38fa2..516698d 100644\n249\t--- a/engine/events.py\n250\t+++ b/engine/events.py\n251\t@@ -185,6 +185,25 @@ class SacrificeReplacementEvent(MoveToGraveyardReplacementEvent):\n252\t         return self.permanent\n253\t \n254\t \n255\t+@dataclass\n256\t+class SpellToGraveyardReplacementEvent(MoveToGraveyardReplacementEvent):\n257\t+    \"\"\"An instant or sorcery spell about to move from the stack to a graveyard.\n258\t+\n259\t+    Fired by the casting-resolution pipeline (:func:`engine.casting._resolve_spell`)\n260\t+    before a non-permanent spell is put into its owner's graveyard, so that\n261\t+    replacement effects (e.g. \"if that spell would be put into your graveyard,\n262\t+    exile it instead\") can redirect the destination.\n263\t+\n264\t+    A replacement may set ``destination`` to ``\"exile\"`` (etc.) to redirect.\n265\t+    \"\"\"\n266\t+\n267\t+    spell: Any = None\n268\t+\n269\t+    @property\n270\t+    def card(self) -> Any:\n271\t+        return self.spell\n272\t+\n273\t+\n274\t @dataclass\n275\t class CreateTokenReplacementEvent(ReplacementEvent):\n276\t     \"\"\"An effect about to create one or more tokens.\"\"\"\n277\t"}]},"parent_tool_use_id":"toolu_01MRY82KonETwUZYSCufVUm1","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"9e8c571c-7c57-4916-865c-476e702f9265","timestamp":"2026-06-01T10:35:52.645Z","subagent_type":"Reviewer","task_description":"Review sos_1 implementation"}
