{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NbaUfg9fkrndoTmooQsXXs","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_97/card_impl.py b/cards/sos/sos_97/card_impl.py\n2\tindex df568b7..41bb3ee 100644\n3\t--- a/cards/sos/sos_97/card_impl.py\n4\t+++ b/cards/sos/sos_97/card_impl.py\n5\t@@ -1,16 +1,133 @@\n6\t-\"\"\"Card implementation for Ral Zarek, Guest Lecturer.\"\"\"\n7\t+\"\"\"Card implementation for Ral Zarek, Guest Lecturer (SOS 97).\"\"\"\n8\t \n9\t from __future__ import annotations\n10\t \n11\t-from engine.card import CardImpl\n12\t+from typing import TYPE_CHECKING, Any\n13\t \n14\t-from typing import TYPE_CHECKING\n15\t+from engine.card import LoyaltyAbility, Planeswalker\n16\t+from engine.types import CardType, ManaCost, Supertype, Zone\n17\t \n18\t if TYPE_CHECKING:\n19\t     from engine.game_state import GameState\n20\t \n21\t \n22\t-class RalZarekGuestLecturer(CardImpl):\n23\t-    \"\"\"TODO: Implement Ral Zarek, Guest Lecturer.\"\"\"\n24\t+class RalZarekGuestLecturer(Planeswalker):\n25\t+    \"\"\"Ral Zarek, Guest Lecturer — {1}{B}{B} — Legendary Planeswalker — Ral.\n26\t \n27\t-    pass\n28\t+    Starting loyalty 3.\n29\t+\n30\t+    +1: Surveil 2.\n31\t+    -1: Any number of target players each discard a card.\n32\t+    -2: Return target creature card with mana value 3 or less from your\n33\t+        graveyard to the battlefield.\n34\t+    -7: Flip five coins. Target opponent skips their next X turns, where X is\n35\t+        the number of coins that came up heads.\n36\t+    \"\"\"\n37\t+\n38\t+    def __init__(self, **kwargs: Any) -> None:\n39\t+        kwargs.setdefault(\"name\", \"Ral Zarek, Guest Lecturer\")\n40\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{B}{B}\"))\n41\t+        kwargs.setdefault(\"starting_loyalty\", 3)\n42\t+        kwargs.setdefault(\"supertypes\", set())\n43\t+        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.LEGENDARY}\n44\t+        kwargs.setdefault(\"subtypes\", set())\n45\t+        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Ral\"}\n46\t+        kwargs.setdefault(\n47\t+            \"rules_text\",\n48\t+            \"+1: Surveil 2.\\n\"\n49\t+            \"-1: Any number of target players each discard a card.\\n\"\n50\t+            \"-2: Return target creature card with mana value 3 or less from \"\n51\t+            \"your graveyard to the battlefield.\\n\"\n52\t+            \"-7: Flip five coins. Target opponent skips their next X turns, \"\n53\t+            \"where X is the number of coins that came up heads.\",\n54\t+        )\n55\t+        super().__init__(**kwargs)\n56\t+\n57\t+    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n58\t+        pw = self\n59\t+\n60\t+        def _plus1(game: Any) -> None:\n61\t+            # Surveil 2.\n62\t+            from engine.game import surveil\n63\t+\n64\t+            controller = pw.controller\n65\t+            if controller is None:\n66\t+                return\n67\t+            surveil(game, controller, 2)\n68\t+\n69\t+        def _minus1(game: Any) -> None:\n70\t+            # Any number of target players each discard a card.\n71\t+            from engine.game import discard\n72\t+\n73\t+            targets = getattr(pw, \"_resolve_targets\", None)\n74\t+            if targets is None:\n75\t+                single = getattr(pw, \"_resolve_target\", None)\n76\t+                targets = [single] if single is not None else []\n77\t+            for player in targets:\n78\t+                if player is None:\n79\t+                    continue\n80\t+                hand = game.get_hand(player)\n81\t+                cards = hand.get_all()\n82\t+                if not cards:\n83\t+                    continue\n84\t+                try:\n85\t+                    chosen = player.choose_card(cards, \"Choose a card to discard\")\n86\t+                except Exception:\n87\t+                    chosen = cards[0]\n88\t+                if chosen is None:\n89\t+                    chosen = cards[0]\n90\t+                discard(game, player, chosen)\n91\t+\n92\t+        def _minus2(game: Any) -> None:\n93\t+            # Return target creature card with mana value 3 or less from your\n94\t+            # graveyard to the battlefield.\n95\t+            from engine.zones import move_to_zone\n96\t+\n97\t+            controller = pw.controller\n98\t+            target = getattr(pw, \"_resolve_target\", None)\n99\t+            if controller is None or target is None:\n100\t+                return\n101\t+            if CardType.CREATURE not in getattr(target, \"card_types\", set()):\n102\t+                return\n103\t+            if getattr(target.mana_cost, \"cmc\", 0) > 3:\n104\t+                return\n105\t+            graveyard = game.get_graveyard(controller)\n106\t+            if not graveyard.contains(target):\n107\t+                return\n108\t+            move_to_zone(game, target, Zone.GRAVEYARD, Zone.BATTLEFIELD)\n109\t+\n110\t+        def _minus7(game: Any) -> None:\n111\t+            # Flip five coins. Target opponent skips their next X turns, where\n112\t+            # X is the number of coins that came up heads.\n113\t+            from engine.game import flip_coin, skip_turns\n114\t+\n115\t+            target = getattr(pw, \"_resolve_target\", None)\n116\t+            if target is None:\n117\t+                return\n118\t+            heads = sum(1 for _ in range(5) if flip_coin())\n119\t+            skip_turns(game, target, heads)\n120\t+\n121\t+        return [\n122\t+            LoyaltyAbility(\n123\t+                loyalty_cost=+1,\n124\t+                effect=_plus1,\n125\t+                description=\"+1: Surveil 2.\",\n126\t+            ),\n127\t+            LoyaltyAbility(\n128\t+                loyalty_cost=-1,\n129\t+                effect=_minus1,\n130\t+                description=\"-1: Any number of target players each discard a card.\",\n131\t+            ),\n132\t+            LoyaltyAbility(\n133\t+                loyalty_cost=-2,\n134\t+                effect=_minus2,\n135\t+                description=\"-2: Return target creature card with mana value 3 \"\n136\t+                \"or less from your graveyard to the battlefield.\",\n137\t+            ),\n138\t+            LoyaltyAbility(\n139\t+                loyalty_cost=-7,\n140\t+                effect=_minus7,\n141\t+                description=\"-7: Flip five coins. Target opponent skips their \"\n142\t+                \"next X turns, where X is the number of heads.\",\n143\t+            ),\n144\t+        ]\n145\tdiff --git a/engine/game.py b/engine/game.py\n146\tindex 46e4195..295803e 100644\n147\t--- a/engine/game.py\n148\t+++ b/engine/game.py\n149\t@@ -350,6 +350,86 @@ def discard(game: GameState, player: Player, card: Any) -> None:\n150\t     move_to_zone(game, card, Zone.HAND, Zone.GRAVEYARD)\n151\t \n152\t \n153\t+def surveil(game: GameState, player: Player, amount: int) -> None:\n154\t+    \"\"\"Surveil *amount* (rule 701.43) for *player*.\n155\t+\n156\t+    Look at the top *amount* cards of *player*'s library, then for each (from\n157\t+    the top down) the player decides whether to keep it on top of the library\n158\t+    or put it into the graveyard.  Cards kept on top retain their relative\n159\t+    order.\n160\t+\n161\t+    The decision is driven by ``player.choose_yes_no`` — ``True`` keeps the\n162\t+    card on top, ``False`` puts it into the graveyard.\n163\t+\n164\t+    Parameters:\n165\t+        game: The current game state.\n166\t+        player: The player surveilling.\n167\t+        amount: The number of cards to look at.\n168\t+    \"\"\"\n169\t+    if amount <= 0:\n170\t+        return\n171\t+\n172\t+    library = game.get_library(player)\n173\t+    # ``top(n)`` returns bottom→top order; reverse so we process from the\n174\t+    # top of the library downward (the order the player looks at them).\n175\t+    looked_at = list(reversed(library.top(amount)))\n176\t+\n177\t+    keep_on_top: list[Any] = []\n178\t+    for card in looked_at:\n179\t+        keep = True\n180\t+        if hasattr(player, \"choose_yes_no\"):\n181\t+            keep = player.choose_yes_no(f\"Keep {getattr(card, 'name', card)!r} on top?\")\n182\t+        if keep:\n183\t+            keep_on_top.append(card)\n184\t+        else:\n185\t+            move_to_zone(game, card, Zone.LIBRARY, Zone.GRAVEYARD)\n186\t+\n187\t+    # Re-place the kept cards on top, preserving their original top-down order\n188\t+    # (so the previous top card remains on top).\n189\t+    for card in reversed(keep_on_top):\n190\t+        if library.contains(card):\n191\t+            library.remove(card)\n192\t+    for card in reversed(keep_on_top):\n193\t+        library.add(card, position=\"top\")\n194\t+\n195\t+\n196\t+def flip_coin(game: GameState | None = None) -> bool:\n197\t+    \"\"\"Flip a coin (rule 705).  Returns ``True`` for heads, ``False`` for tails.\n198\t+\n199\t+    Uses the :mod:`random` module so tests can force the outcome by patching\n200\t+    ``random.random`` / ``random.choice`` / ``random.randint``.\n201\t+    \"\"\"\n202\t+    import random\n203\t+\n204\t+    return random.random() < 0.5\n205\t+\n206\t+\n207\t+def skip_turns(game: GameState, player: Player, count: int) -> None:\n208\t+    \"\"\"Record that *player* skips their next *count* turns.\n209\t+\n210\t+    The engine has no full turn-skip execution path; this surfaces the\n211\t+    recorded count both on the player (``player.skipped_turns``) and on the\n212\t+    game keyed by seat index (``game.skipped_turns[seat]``) so it is\n213\t+    observable.\n214\t+\n215\t+    Parameters:\n216\t+        game: The current game state.\n217\t+        player: The player who will skip turns.\n218\t+        count: Number of turns to skip (clamped to non-negative).\n219\t+    \"\"\"\n220\t+    count = max(0, count)\n221\t+    player.skipped_turns = getattr(player, \"skipped_turns\", 0) + count\n222\t+\n223\t+    if not hasattr(game, \"skipped_turns\") or game.skipped_turns is None:\n224\t+        game.skipped_turns = {}\n225\t+    try:\n226\t+        seat = game.players.index(player)\n227\t+    except ValueError:\n228\t+        seat = None\n229\t+    if seat is not None:\n230\t+        game.skipped_turns[seat] = game.skipped_turns.get(seat, 0) + count\n231\t+\n232\t+\n233\t def create_token(game: GameState, player: Player, token: Any) -> None:\n234\t     \"\"\"Create a token on the battlefield under *player*'s control.\n235\t \n236\t"}]},"parent_tool_use_id":"toolu_014cHGGqFoHmHis5WwMogErK","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"41ffdf11-1795-4afd-b22f-c4e469352834","timestamp":"2026-06-01T11:18:55.072Z","subagent_type":"Reviewer","task_description":"Review sos_97 implementation"}
