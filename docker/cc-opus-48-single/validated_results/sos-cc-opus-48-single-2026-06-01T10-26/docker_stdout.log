{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01JU4zeWJ2kyFMWGw4K9krvv","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01CQuiFhukRaydaHWdJgr1zF","name":"Read","input":{"file_path":"/workspace/engine/casting.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14819,"cache_read_input_tokens":12996,"cache_creation":{"ephemeral_5m_input_tokens":14819,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01YLHhg3L6wmRAMxiCoeYbvX","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"74e93e3a-4dc4-4cef-b29b-50574226bffe","request_id":"req_011CbcXVa3VrKhXro16ZNZSJ","subagent_type":"Tester","task_description":"Extend tests for sos_257"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CQuiFhukRaydaHWdJgr1zF","type":"tool_result","content":"1\t\"\"\"Casting and resolution pipeline for spells and lands.\n2\t\n3\tProvides the full flow from casting a spell or playing a land through\n4\tresolution:\n5\t\n6\t- :func:`cast_spell` — verify timing & legality → move hand to stack →\n7\t  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n8\t- :func:`play_land` — verify land play remaining → move hand to\n9\t  battlefield → decrement ``land_plays_remaining``.\n10\t- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n11\t  helpers used by the casting pipeline.\n12\t\n13\tResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\n14\tcreated by :func:`cast_spell`:\n15\t\n16\t- Call ``card.on_resolve(game)``.\n17\t- Permanents (creature / enchantment / artifact / planeswalker) move from\n18\t  the stack to the battlefield.\n19\t- Non-permanents (instant / sorcery) move to the graveyard.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import TYPE_CHECKING, Any\n25\t\n26\tfrom engine.card import CardImpl\n27\tfrom engine.stack import StackObject\n28\tfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\n29\tfrom engine.zones import move_zone\n30\t\n31\tif TYPE_CHECKING:\n32\t    from engine.game_state import GameState\n33\t    from engine.player import Player\n34\t\n35\t\n36\t# Card types that represent permanents — these go to the battlefield on resolve.\n37\t_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n38\t    CardType.CREATURE,\n39\t    CardType.ENCHANTMENT,\n40\t    CardType.ARTIFACT,\n41\t    CardType.PLANESWALKER,\n42\t})\n43\t\n44\t\n45\tclass CastingError(Exception):\n46\t    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n47\t\n48\t\n49\t# ------------------------------------------------------------------\n50\t# Timing helpers\n51\t# ------------------------------------------------------------------\n52\t\n53\tdef is_sorcery_speed(game: GameState, player: Player) -> bool:\n54\t    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n55\t\n56\t    Sorcery speed requires all of:\n57\t\n58\t    * *player* is the active player.\n59\t    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n60\t      ``POSTCOMBAT_MAIN``).\n61\t    * The stack is empty.\n62\t    \"\"\"\n63\t    if player is not game.active_player:\n64\t        return False\n65\t    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n66\t        return False\n67\t    if not game.stack.is_empty():\n68\t        return False\n69\t    return True\n70\t\n71\t\n72\tdef can_cast_at_instant_speed(card: CardImpl) -> bool:\n73\t    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n74\t\n75\t    A card has instant-speed timing if it is an instant or has the\n76\t    :attr:`~engine.types.Keyword.FLASH` keyword.\n77\t    \"\"\"\n78\t    if CardType.INSTANT in card.card_types:\n79\t        return True\n80\t    if Keyword.FLASH & card.keywords:\n81\t        return True\n82\t    return False\n83\t\n84\t\n85\t# ------------------------------------------------------------------\n86\t# Cost reduction\n87\t# ------------------------------------------------------------------\n88\t\n89\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n90\t    \"\"\"Return the generic mana reduction for casting *card*.\n91\t\n92\t    Queries ``card.cost_reduction(game)`` and clamps the result so that\n93\t    the generic portion of the mana cost cannot go below 0.\n94\t\n95\t    This is a simplified single-card self-reduction model.  Full MTG\n96\t    cost-reduction interactions (Trinisphere, multiple reductions from\n97\t    different sources) are deferred.\n98\t    \"\"\"\n99\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n100\t    # casting player even when the card was never explicitly assigned one.\n101\t    prev_controller = card.controller\n102\t    card.controller = controller\n103\t    raw = card.cost_reduction(game)\n104\t    # Restore previous controller in case the caller doesn't want a\n105\t    # side-effect (get_cost_reduction is a query, not a mutation).\n106\t    card.controller = prev_controller\n107\t    # Additively fold in any granted reductions from permanents on the\n108\t    # battlefield that dynamically grant cost reduction to *controller*'s\n109\t    # spells (e.g. Witherbloom granting affinity for creatures to the\n110\t    # controller's instant/sorcery spells).  The grant is derived dynamically\n111\t    # from the active granters, so it only applies while the granter is in\n112\t    # play and is never sticky.\n113\t    raw += _granted_cost_reduction(game, card, controller)\n114\t    generic = card.mana_cost.generic if card.mana_cost else 0\n115\t    return max(0, min(raw, generic))\n116\t\n117\t\n118\tdef _granted_cost_reduction(\n119\t    game: GameState, card: CardImpl, controller: Player\n120\t) -> int:\n121\t    \"\"\"Return the extra generic reduction *controller*'s battlefield grants to *card*.\n122\t\n123\t    Consults every permanent on *controller*'s battlefield that exposes a\n124\t    callable ``affinity_for_creatures_grant(game, card, controller)`` method\n125\t    (an additive, dynamically-derived grant surface analogous to the miracle\n126\t    grant in :mod:`engine.miracle`).  Each grant returns the generic reduction\n127\t    it confers on *card* (0 when it does not apply); the results are summed.\n128\t\n129\t    This is additive to the card's own ``cost_reduction`` so a spell that both\n130\t    has its own affinity *and* is granted one is not double-counted by the\n131\t    grant path: grant methods scope themselves to the controller's spells and\n132\t    return their own count, and a card's intrinsic ``cost_reduction`` is read\n133\t    separately above.  In the current single-source SOS model only one such\n134\t    granter exists, so no inter-grant double counting occurs.\n135\t    \"\"\"\n136\t    if controller is None:\n137\t        return 0\n138\t    total = 0\n139\t    for permanent in game.get_battlefield(controller).get_all():\n140\t        grant = getattr(permanent, \"affinity_for_creatures_grant\", None)\n141\t        if not callable(grant):\n142\t            continue\n143\t        try:\n144\t            amount = grant(game, card, controller)\n145\t        except TypeError:\n146\t            # Not a (game, card, controller) grant method — skip defensively.\n147\t            continue\n148\t        if amount:\n149\t            total += int(amount)\n150\t    return total\n151\t\n152\t\n153\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n154\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n155\t    new_generic = max(0, cost.generic - reduction)\n156\t    return ManaCost(\n157\t        generic=new_generic,\n158\t        pips=dict(cost.pips),\n159\t        x_count=cost.x_count,\n160\t        hybrid=list(cost.hybrid),\n161\t    )\n162\t\n163\t\n164\t# ------------------------------------------------------------------\n165\t# Cast spell\n166\t# ------------------------------------------------------------------\n167\t\n168\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n169\t    \"\"\"Cast *card* from *player*'s hand.\n170\t\n171\t    Pipeline\n172\t    --------\n173\t    1. **Timing check** — instants (and cards with flash) can be cast\n174\t       whenever the player has priority; everything else requires\n175\t       sorcery-speed timing.\n176\t    2. **can_cast** — ask the card whether it can legally be cast.\n177\t    3. **Hand check** — the card must be in the player's hand.\n178\t    4. **Move hand → stack zone** — remove the card from the hand and\n179\t       place it into the player's stack zone.\n180\t    5. **Choose targets** — if the card specifies targets (via\n181\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n182\t    6. **Mana check / payment** — the player's mana pool must be able to\n183\t       pay the card's mana cost.  If payment fails, the card is rolled\n184\t       back from the stack zone to the hand.\n185\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n186\t    8. **Push StackObject** — push a :class:`StackObject` whose\n187\t       ``on_resolve`` callback handles resolution.\n188\t\n189\t    Raises:\n190\t        CastingError: If any legality check fails.\n191\t    \"\"\"\n192\t    # 1. Timing\n193\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n194\t        raise CastingError(\n195\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n196\t        )\n197\t\n198\t    # 2. can_cast\n199\t    if not card.can_cast(game):\n200\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n201\t\n202\t    # 3. Hand check\n203\t    hand = game.get_hand(player)\n204\t    if not hand.contains(card):\n205\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n206\t\n207\t    # 4. Move card from hand to stack zone\n208\t    stack_zone = player.zones[Zone.STACK]\n209\t    hand.remove(card)\n210\t    stack_zone.add(card)\n211\t\n212\t    # Clear any stale colors_spent from a prior cast before new payment.\n213\t    if hasattr(card, \"colors_spent\"):\n214\t        del card.colors_spent\n215\t\n216\t    # 5. Choose targets\n217\t    target_specs = card.get_targets(game)\n218\t    chosen_targets: list[Any] = []\n219\t    if target_specs:\n220\t        for spec in target_specs:\n221\t            target = player.choose_target(target_specs, spec)\n222\t            # Validate against filter_fn if the spec provides one\n223\t            filter_fn = getattr(spec, \"filter_fn\", None)\n224\t            if filter_fn is not None and target is not None:\n225\t                if not filter_fn(target):\n226\t                    stack_zone.remove(card)\n227\t                    hand.add(card)\n228\t                    raise CastingError(\n229\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n230\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n231\t                    )\n232\t            chosen_targets.append(target)\n233\t\n234\t    # 5b. Protection check — reject targets that have protection from this\n235\t    #     spell (the T in DEBT).\n236\t    from engine.protection import has_protection_from\n237\t\n238\t    for target in chosen_targets:\n239\t        if has_protection_from(target, card):\n240\t            # Rollback: move card from stack zone back to hand\n241\t            stack_zone.remove(card)\n242\t            hand.add(card)\n243\t            raise CastingError(\n244\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n245\t            )\n246\t\n247\t    # Targets are stored on the StackObject (not the card) and passed\n248\t    # through the resolve pipeline via on_resolve(game, targets=...).\n249\t\n250\t    # 6. Mana check / payment (rollback on failure)\n251\t    # Ensure the card knows its controller so that cost_reduction() hooks\n252\t    # (e.g. Embercleave counting attacking creatures you control) see the\n253\t    # casting player, even for cards that were added to hand without an\n254\t    # explicit controller assignment.\n255\t    if card.controller is None:\n256\t        card.controller = player\n257\t    reduction = get_cost_reduction(game, card, player)\n258\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n259\t\n260\t    if not player.mana_pool.can_pay(effective_cost):\n261\t        # Rollback: move card from stack zone back to hand\n262\t        stack_zone.remove(card)\n263\t        hand.add(card)\n264\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n265\t\n266\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n267\t    player.mana_pool.pay(effective_cost)\n268\t\n269\t    # Store colors of mana spent on the card for mechanics like Converge\n270\t    # that care about the colors used to cast the spell.\n271\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n272\t\n273\t    # Record the TOTAL amount of mana spent to cast this spell (rule 107.7).\n274\t    # Unlike the printed mana value, this reflects actual mana paid, so X\n275\t    # spells / cost-reduced spells diverge from CMC.  Effects such as Mana\n276\t    # Sculpt read this at resolution.\n277\t    card.mana_spent = player.mana_pool.last_payment_total  # type: ignore[attr-defined]\n278\t\n279\t    # 7. Call on_cast hook\n280\t    card.on_cast(game)\n281\t\n282\t    # 8. Build on_resolve callback and push StackObject\n283\t    stack_obj = StackObject(\n284\t        source=card,\n285\t        controller=player,\n286\t        targets=chosen_targets,\n287\t        on_resolve=lambda g: None,  # replaced below\n288\t    )\n289\t\n290\t    def _on_resolve(g: GameState) -> None:\n291\t        _resolve_spell(g, card, player, stack_obj)\n292\t\n293\t    stack_obj.on_resolve = _on_resolve\n294\t    game.stack.push(stack_obj)\n295\t\n296\t    # Fire the \"when you cast this spell\" event so cast-time grants (casualty\n297\t    # and other \"whenever you cast ...\" triggers) can observe a real cast.\n298\t    # The spell is already on the stack, matching MTG timing where such\n299\t    # triggers are put on the stack above the spell that caused them.\n300\t    _fire_spell_cast_event(game, player, card)\n301\t\n302\t\n303\tdef _fire_spell_cast_event(game: GameState, player: Player, card: CardImpl) -> None:\n304\t    \"\"\"Fire :class:`~engine.events.SpellCastTriggeredEvent` for a cast spell.\n305\t\n306\t    Additive hook used by the casting pipeline so \"whenever you cast a(n)\n307\t    instant/sorcery spell\" and casualty-style cast-time grants can trigger.\n308\t    Safe no-op if the game has no ``trigger_manager``.\n309\t    \"\"\"\n310\t    trigger_manager = getattr(game, \"trigger_manager\", None)\n311\t    if trigger_manager is None:\n312\t        return\n313\t    from engine.events import SpellCastTriggeredEvent\n314\t\n315\t    trigger_manager.fire_event(\n316\t        game,\n317\t        SpellCastTriggeredEvent(\n318\t            spell=card, player=player, card=card, controller=player\n319\t        ),\n320\t    )\n321\t\n322\t\n323\t# ------------------------------------------------------------------\n324\t# Cast spell without paying mana cost (free-cast from any zone)\n325\t# ------------------------------------------------------------------\n326\t\n327\t\n328\tdef cast_spell_free(\n329\t    game: GameState,\n330\t    player: Player,\n331\t    card: CardImpl,\n332\t    from_zone: Zone,\n333\t) -> None:\n334\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n335\t\n336\t    This is used by effects that allow casting from zones other than hand\n337\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n338\t    or cascade.\n339\t\n340\t    Pipeline\n341\t    --------\n342\t    1. **can_cast** — ask the card whether it can legally be cast (same\n343\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n344\t    2. Move *card* from *from_zone* to the stack zone.\n345\t    3. Choose targets (if applicable) with validation and protection check.\n346\t    4. Call ``on_cast`` hook.\n347\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n348\t       resolution normally (permanents → battlefield, non-permanents →\n349\t       graveyard).\n350\t\n351\t    No timing check or mana payment is performed.  The spell goes on the\n352\t    stack and can be responded to normally (e.g. countered).\n353\t\n354\t    If targeting or other post-move checks fail, the card is rolled back\n355\t    to its source zone.\n356\t\n357\t    Parameters:\n358\t        game: The current game state.\n359\t        player: The player casting the spell.\n360\t        card: The card to cast.\n361\t        from_zone: The zone the card is currently in.\n362\t\n363\t    Raises:\n364\t        CastingError: If the card cannot be found in *from_zone* or\n365\t            legality checks fail.\n366\t    \"\"\"\n367\t    from engine.zones import move_to_zone\n368\t\n369\t    # Ensure controller is set\n370\t    card.controller = player\n371\t    if card.owner is None:\n372\t        card.owner = player\n373\t\n374\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n375\t    if not card.can_cast(game):\n376\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n377\t\n378\t    # 2. Locate card in source zone\n379\t    source_zone_container = player.zones[from_zone]\n380\t    if not source_zone_container.contains(card):\n381\t        # Try to find the card in any player's zone\n382\t        source_zone_container = None\n383\t        for p in game.players:\n384\t            z = p.zones[from_zone]\n385\t            if z.contains(card):\n386\t                source_zone_container = z\n387\t                break\n388\t\n389\t    if source_zone_container is None or not source_zone_container.contains(card):\n390\t        raise CastingError(\n391\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n392\t        )\n393\t\n394\t    # Move card from source zone to stack zone\n395\t    stack_zone = player.zones[Zone.STACK]\n396\t    source_zone_container.remove(card)\n397\t    stack_zone.add(card)\n398\t\n399\t    # 3. Choose targets (with rollback on failure)\n400\t    try:\n401\t        target_specs = card.get_targets(game)\n402\t        chosen_targets: list[Any] = []\n403\t        if target_specs:\n404\t            for spec in target_specs:\n405\t                target = player.choose_target(target_specs, spec)\n406\t                # Validate against filter_fn if the spec provides one\n407\t                filter_fn = getattr(spec, \"filter_fn\", None)\n408\t                if filter_fn is not None and target is not None:\n409\t                    if not filter_fn(target):\n410\t                        raise CastingError(\n411\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n412\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n413\t                        )\n414\t                chosen_targets.append(target)\n415\t\n416\t        # Protection check — reject targets that have protection from this spell\n417\t        from engine.protection import has_protection_from\n418\t\n419\t        for target in chosen_targets:\n420\t            if has_protection_from(target, card):\n421\t                raise CastingError(\n422\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n423\t                )\n424\t    except Exception as exc:\n425\t        # Rollback: move card from stack zone back to source zone\n426\t        stack_zone.remove(card)\n427\t        source_zone_container.add(card)\n428\t        raise CastingError(str(exc)) from exc\n429\t\n430\t    # 4. Call on_cast hook\n431\t    card.on_cast(game)\n432\t\n433\t    # 5. Build on_resolve callback and push StackObject\n434\t    stack_obj = StackObject(\n435\t        source=card,\n436\t        controller=player,\n437\t        targets=chosen_targets,\n438\t        on_resolve=lambda g: None,  # replaced below\n439\t    )\n440\t\n441\t    def _on_resolve(g: GameState) -> None:\n442\t        _resolve_spell(g, card, player, stack_obj)\n443\t\n444\t    stack_obj.on_resolve = _on_resolve\n445\t    game.stack.push(stack_obj)\n446\t\n447\t\n448\t# ------------------------------------------------------------------\n449\t# Cast spell paying an alternative cost (e.g. miracle)\n450\t# ------------------------------------------------------------------\n451\t\n452\t\n453\tdef cast_spell_alternative(\n454\t    game: GameState,\n455\t    player: Player,\n456\t    card: CardImpl,\n457\t    alternative_cost: ManaCost,\n458\t    from_zone: Zone = Zone.HAND,\n459\t) -> None:\n460\t    \"\"\"Cast *card* paying *alternative_cost* instead of its mana cost.\n461\t\n462\t    Used by alternative-cost mechanics such as **miracle** (rule 702.94),\n463\t    where the spell is cast \"by paying [cost] rather than its mana cost\".\n464\t    The alternative cost is paid as a normal mana cost from *player*'s pool.\n465\t\n466\t    Unlike :func:`cast_spell` this skips the normal sorcery-speed/instant\n467\t    timing check (miracle casts happen at draw time, outside normal timing),\n468\t    but otherwise mirrors the cast pipeline: ``can_cast`` legality, target\n469\t    choice/validation, mana payment (with rollback on failure), the\n470\t    ``on_cast`` hook, and pushing a resolving :class:`StackObject`.\n471\t\n472\t    Note: cost reduction (``get_cost_reduction``) is intentionally NOT applied\n473\t    to *alternative_cost* — unlike :func:`cast_spell`, an alternative cost such\n474\t    as miracle is paid exactly as printed.  Callers that want a reduction on an\n475\t    alternative cost must fold it into *alternative_cost* before calling.\n476\t\n477\t    Parameters:\n478\t        game: The current game state.\n479\t        player: The player casting the spell.\n480\t        card: The card to cast (must be in *from_zone*).\n481\t        alternative_cost: The :class:`ManaCost` to pay instead of\n482\t            ``card.mana_cost``.\n483\t        from_zone: The zone the card is currently in (default hand).\n484\t\n485\t    Raises:\n486\t        CastingError: If any legality check fails or mana cannot be paid.\n487\t    \"\"\"\n488\t    if card.controller is None:\n489\t        card.controller = player\n490\t    if card.owner is None:\n491\t        card.owner = player\n492\t\n493\t    # can_cast legality (timing is intentionally skipped for miracle casts).\n494\t    if not card.can_cast(game):\n495\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n496\t\n497\t    source_zone = player.zones[from_zone]\n498\t    if not source_zone.contains(card):\n499\t        raise CastingError(\n500\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n501\t        )\n502\t\n503\t    stack_zone = player.zones[Zone.STACK]\n504\t    source_zone.remove(card)\n505\t    stack_zone.add(card)\n506\t\n507\t    if hasattr(card, \"colors_spent\"):\n508\t        del card.colors_spent\n509\t\n510\t    # Choose targets (with rollback to the source zone on failure).\n511\t    try:\n512\t        target_specs = card.get_targets(game)\n513\t        chosen_targets: list[Any] = []\n514\t        if target_specs:\n515\t            for spec in target_specs:\n516\t                target = player.choose_target(target_specs, spec)\n517\t                filter_fn = getattr(spec, \"filter_fn\", None)\n518\t                if filter_fn is not None and target is not None:\n519\t                    if not filter_fn(target):\n520\t                        raise CastingError(\n521\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n522\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n523\t                        )\n524\t                chosen_targets.append(target)\n525\t\n526\t        from engine.protection import has_protection_from\n527\t\n528\t        for target in chosen_targets:\n529\t            if has_protection_from(target, card):\n530\t                raise CastingError(\n531\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n532\t                )\n533\t    except Exception as exc:\n534\t        stack_zone.remove(card)\n535\t        source_zone.add(card)\n536\t        raise CastingError(str(exc)) from exc\n537\t\n538\t    # Pay the alternative cost (rollback on failure).\n539\t    if not player.mana_pool.can_pay(alternative_cost):\n540\t        stack_zone.remove(card)\n541\t        source_zone.add(card)\n542\t        raise CastingError(\n543\t            f\"Cannot cast {card.name!r} — insufficient mana for alternative cost\"\n544\t        )\n545\t    player.mana_pool.pay(alternative_cost)\n546\t\n547\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n548\t    card.mana_spent = player.mana_pool.last_payment_total  # type: ignore[attr-defined]\n549\t\n550\t    card.on_cast(game)\n551\t\n552\t    stack_obj = StackObject(\n553\t        source=card,\n554\t        controller=player,\n555\t        targets=chosen_targets,\n556\t        on_resolve=lambda g: None,  # replaced below\n557\t    )\n558\t\n559\t    def _on_resolve(g: GameState) -> None:\n560\t        _resolve_spell(g, card, player, stack_obj)\n561\t\n562\t    stack_obj.on_resolve = _on_resolve\n563\t    game.stack.push(stack_obj)\n564\t\n565\t\n566\t# ------------------------------------------------------------------\n567\t# Resolution (called when the stack pops)\n568\t# ------------------------------------------------------------------\n569\t\n570\tdef _resolve_spell(\n571\t    game: GameState,\n572\t    card: CardImpl,\n573\t    player: Player,\n574\t    stack_obj: StackObject,\n575\t) -> None:\n576\t    \"\"\"Resolve *card* cast by *player*.\n577\t\n578\t    1. Call ``card.on_resolve(game, targets=targets)``.\n579\t    2. Remove the card from the stack zone.\n580\t    3. If the card is a permanent type, move it to the battlefield via\n581\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n582\t       registration and the ETB event).\n583\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n584\t    \"\"\"\n585\t    from engine.zones import move_to_zone\n586\t\n587\t    # Read targets from the StackObject — the single source of truth.\n588\t    # Set chosen_targets on the card just before resolution so that\n589\t    # _get_chosen_target helpers (which read via getattr) work.\n590\t    targets = stack_obj.targets\n591\t    if targets is not None:\n592\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n593\t\n594\t    card.on_resolve(game)\n595\t\n596\t    if card.card_types & _PERMANENT_TYPES:\n597\t        # Move from stack to battlefield via move_to_zone, which handles\n598\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n599\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n600\t    else:\n601\t        # Instant/sorcery: the spell would be put into its owner's graveyard.\n602\t        # Consult replacement effects so that effects such as \"if that spell\n603\t        # would be put into your graveyard, exile it instead\" can redirect\n604\t        # the destination zone.\n605\t        dest_zone = _resolve_spell_graveyard_destination(game, card)\n606\t        move_to_zone(game, card, Zone.STACK, dest_zone)\n607\t        # Clean up any spell-specific exile replacement / flag now that the\n608\t        # spell has left the stack.\n609\t        game.replacement_manager.unregister(card)\n610\t        if hasattr(card, \"_exile_if_goes_to_graveyard\"):\n611\t            del card._exile_if_goes_to_graveyard\n612\t\n613\t\n614\t# Destination string → Zone for spell graveyard-replacement redirection.\n615\t_SPELL_DESTINATION_ZONE_MAP: dict[str, Zone] = {\n616\t    \"graveyard\": Zone.GRAVEYARD,\n617\t    \"exile\": Zone.EXILE,\n618\t    \"hand\": Zone.HAND,\n619\t    \"library\": Zone.LIBRARY,\n620\t}\n621\t\n622\t\n623\tdef _resolve_spell_graveyard_destination(game: GameState, card: CardImpl) -> Zone:\n624\t    \"\"\"Return the zone an instant/sorcery should move to on resolution.\n625\t\n626\t    Builds a :class:`~engine.events.SpellToGraveyardReplacementEvent` and runs\n627\t    it through the replacement manager so replacement effects can redirect the\n628\t    spell (e.g. exile instead of graveyard).  Defaults to the graveyard.\n629\t    \"\"\"\n630\t    from engine.events import SpellToGraveyardReplacementEvent\n631\t\n632\t    controller = getattr(card, \"controller\", None)\n633\t    owner = getattr(card, \"owner\", None) or controller\n634\t    event = SpellToGraveyardReplacementEvent(\n635\t        destination=\"graveyard\",\n636\t        controller=controller,\n637\t        owner=owner,\n638\t        spell=card,\n639\t    )\n640\t    event = game.replacement_manager.apply(game, event)\n641\t    destination_str = getattr(event, \"destination\", \"graveyard\")\n642\t    return _SPELL_DESTINATION_ZONE_MAP.get(destination_str, Zone.GRAVEYARD)\n643\t\n644\t\n645\t# ------------------------------------------------------------------\n646\t# Play land (special action — does not use the stack)\n647\t# ------------------------------------------------------------------\n648\t\n649\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n650\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n651\t\n652\t    Requirements (all must hold):\n653\t\n654\t    * *land_card* has :attr:`CardType.LAND`.\n655\t    * *player* is the active player.\n656\t    * Current phase is a main phase.\n657\t    * The stack is empty.\n658\t    * ``player.land_plays_remaining > 0``.\n659\t    * The card is in the player's hand.\n660\t\n661\t    On success the card moves from hand to battlefield and\n662\t    ``land_plays_remaining`` is decremented.\n663\t\n664\t    Raises:\n665\t        CastingError: If any requirement is not met.\n666\t    \"\"\"\n667\t    # Must be a land\n668\t    if CardType.LAND not in land_card.card_types:\n669\t        raise CastingError(\n670\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n671\t        )\n672\t\n673\t    # Sorcery-speed timing (active player, main phase, stack empty)\n674\t    if not is_sorcery_speed(game, player):\n675\t        raise CastingError(\n676\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n677\t            \"during main phase with empty stack\"\n678\t        )\n679\t\n680\t    # Land plays remaining\n681\t    if player.land_plays_remaining <= 0:\n682\t        raise CastingError(\n683\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n684\t        )\n685\t\n686\t    # Card must be in hand\n687\t    hand = game.get_hand(player)\n688\t    if not hand.contains(land_card):\n689\t        raise CastingError(\n690\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n691\t        )\n692\t\n693\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n694\t    if land_card.owner is None:\n695\t        land_card.owner = player\n696\t    land_card.controller = player\n697\t\n698\t    # Move from hand to battlefield via move_to_zone, which fires\n699\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n700\t    from engine.zones import move_to_zone\n701\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n702\t\n703\t    # Decrement land plays\n704\t    player.land_plays_remaining -= 1\n705\t\n706\t\n707\tdef cast_prepared_spell(\n708\t    game: GameState,\n709\t    permanent: Any,\n710\t    targets: list[Any] | None = None,\n711\t) -> StackObject | None:\n712\t    \"\"\"Cast a copy of *permanent*'s prepare spell while it is prepared.\n713\t\n714\t    This implements the SOS **Prepared** mechanic\n715\t    (rules text: \"While it's prepared, you may cast a copy of its spell.\n716\t    Doing so unprepares it.\").\n717\t\n718\t    A prepared permanent exposes:\n719\t\n720\t    * a truthy ``is_prepared`` flag, and\n721\t    * a ``prepare_spell`` attribute — a :class:`~engine.card.CardImpl` (the\n722\t      inset spell, e.g. Swords to Plowshares).\n723\t\n724\t    This helper creates a *copy* of that prepare spell, places it in the\n725\t    controller's exile zone, casts it for free (no mana cost) onto the stack,\n726\t    and clears the permanent's prepared designation. The returned\n727\t    :class:`StackObject` can be resolved to apply the prepare spell's effect.\n728\t\n729\t    Parameters:\n730\t        game: The current game state.\n731\t        permanent: The prepared permanent (must have ``is_prepared`` truthy\n732\t            and a ``prepare_spell``).\n733\t        targets: Optional explicit targets for the copy. If provided, they\n734\t            are scripted into the controller's choices so the copy resolves\n735\t            against them.\n736\t\n737\t    Returns:\n738\t        The :class:`StackObject` for the prepare-spell copy, or ``None`` if\n739\t        *permanent* is not prepared / exposes no prepare spell.\n740\t    \"\"\"\n741\t    import copy as _copy\n742\t\n743\t    if not getattr(permanent, \"is_prepared\", False):\n744\t        return None\n745\t    prepare_spell = getattr(permanent, \"prepare_spell\", None)\n746\t    if prepare_spell is None:\n747\t        return None\n748\t\n749\t    controller = getattr(permanent, \"controller\", None) or game.active_player\n750\t\n751\t    # Build a fresh copy of the prepare spell so the original face stays put.\n752\t    spell_copy = _copy.copy(prepare_spell)\n753\t    # Give the copy a unique identity & clean target state.\n754\t    from engine.card import GameObject as _GameObject\n755\t\n756\t    spell_copy.object_id = _GameObject._next_id\n757\t    _GameObject._next_id += 1\n758\t    spell_copy.controller = controller\n759\t    spell_copy.owner = controller\n760\t    if hasattr(spell_copy, \"chosen_targets\"):\n761\t        spell_copy.chosen_targets = []\n762\t\n763\t    # Casting unprepares the permanent (rule text: \"Doing so unprepares it.\").\n764\t    permanent.is_prepared = False\n765\t\n766\t    # Place the copy in exile so it is cast \"from exile\" like a real copy.\n767\t    exile_zone = controller.zones[Zone.EXILE]\n768\t    exile_zone.add(spell_copy)\n769\t\n770\t    stack_before = len(game.stack)\n771\t\n772\t    # Script the explicit targets so cast_spell_free's target choices resolve.\n773\t    if targets:\n774\t        appendleft = getattr(getattr(controller, \"_script\", None), \"appendleft\", None)\n775\t        if appendleft is not None:\n776\t            for target in reversed(targets):\n777\t                controller._script.appendleft(target)\n778\t\n779\t    cast_spell_free(game, controller, spell_copy, Zone.EXILE)\n780\t\n781\t    if len(game.stack) > stack_before:\n782\t        return game.stack.peek()\n783\t    return None\n784\t\n785\t\n786\tdef resolve_top(game: GameState) -> None:\n787\t    \"\"\"Resolve the top spell/ability on the stack.\n788\t\n789\t    Pops the top item from the stack, calls its on_resolve callback,\n790\t    then runs state-based actions.  If the stack is empty this is a no-op.\n791\t    \"\"\"\n792\t    if game.stack.is_empty():\n793\t        return\n794\t    from engine.state_based_actions import resolve_state_based_actions\n795\t\n796\t    obj = game.stack.pop()\n797\t    obj.on_resolve(game)\n798\t    resolve_state_based_actions(game)\n799\t"}]},"parent_tool_use_id":"toolu_01YLHhg3L6wmRAMxiCoeYbvX","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"02fae87c-2f37-4e43-a94a-10f2f59b5a4b","timestamp":"2026-06-01T12:18:18.630Z","subagent_type":"Tester","task_description":"Extend tests for sos_257"}
