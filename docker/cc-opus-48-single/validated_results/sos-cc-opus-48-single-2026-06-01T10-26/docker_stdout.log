{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WTkPfwihmXiWLSHBQxRbfs","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_257/card_impl.py b/cards/sos/sos_257/card_impl.py\n2\tindex e5f8e2f..6e57b09 100644\n3\t--- a/cards/sos/sos_257/card_impl.py\n4\t+++ b/cards/sos/sos_257/card_impl.py\n5\t@@ -1,16 +1,326 @@\n6\t-\"\"\"Card implementation for Great Hall of the Biblioplex.\"\"\"\n7\t+\"\"\"Card implementation for Great Hall of the Biblioplex (SOS 257).\n8\t+\n9\t+Great Hall of the Biblioplex is a colorless Land with three abilities:\n10\t+\n11\t+  {T}: Add {C}.\n12\t+  {T}, Pay 1 life: Add one mana of any color. Spend this mana only to cast\n13\t+      an instant or sorcery spell.\n14\t+  {5}: If this land isn't a creature, it becomes a 2/4 Wizard creature with\n15\t+      \"Whenever you cast an instant or sorcery spell, this creature gets\n16\t+      +1/+0 until end of turn.\" It's still a land.\n17\t+\n18\t+Animation is modelled with the continuous-effect layer system:\n19\t+  * Layer 4 (TYPE): add CREATURE to ``card_types`` (LAND is retained) and add\n20\t+    the \"Wizard\" subtype.\n21\t+  * Layer 7b (SET_PT): set ``modified_power``/``modified_toughness`` to 2/4.\n22\t+\n23\t+The granted \"Whenever you cast an instant or sorcery spell, this creature gets\n24\t++1/+0 until end of turn\" trigger is registered through the spell-cast trigger\n25\t+machinery (``SpellCastTriggeredEvent``, now fired by ``engine.casting.cast_spell``).\n26\t+It is controller-scoped and only fires while the permanent is actually a\n27\t+creature (CREATURE in ``card_types``); each qualifying instant/sorcery the\n28\t+controller casts registers a Layer 7c +1/+0 ``DURATION_END_OF_TURN`` continuous\n29\t+effect, so the animated creature's POWER increases by 1 per cast and resets at\n30\t+end of turn (the cleanup step sweeps the until-end-of-turn effects).\n31\t+\"\"\"\n32\t \n33\t from __future__ import annotations\n34\t \n35\t-from engine.card import CardImpl\n36\t+from typing import TYPE_CHECKING, Any\n37\t \n38\t-from typing import TYPE_CHECKING\n39\t+from engine.card import ActivatedAbility, Land, ManaAbility\n40\t+from engine.continuous_effects import (\n41\t+    ContinuousEffect,\n42\t+    DURATION_END_OF_TURN,\n43\t+    DURATION_PERMANENT,\n44\t+    Layer,\n45\t+    SubLayer,\n46\t+)\n47\t+from engine.types import CardType, ManaCost, ManaType\n48\t \n49\t if TYPE_CHECKING:\n50\t     from engine.game_state import GameState\n51\t \n52\t \n53\t-class GreatHallOfTheBiblioplex(CardImpl):\n54\t-    \"\"\"TODO: Implement Great Hall of the Biblioplex.\"\"\"\n55\t+def _is_on_battlefield(game: Any, obj: Any) -> bool:\n56\t+    \"\"\"Return ``True`` if *obj* is on any player's battlefield.\"\"\"\n57\t+    for player in game.players:\n58\t+        if game.get_battlefield(player).contains(obj):\n59\t+            return True\n60\t+    return False\n61\t+\n62\t+\n63\t+# The five colors a player may produce with the any-color ability.\n64\t+_COLOR_OPTIONS = [\n65\t+    ManaType.WHITE,\n66\t+    ManaType.BLUE,\n67\t+    ManaType.BLACK,\n68\t+    ManaType.RED,\n69\t+    ManaType.GREEN,\n70\t+]\n71\t+\n72\t+\n73\t+class GreatHallOfTheBiblioplex(Land):\n74\t+    \"\"\"Great Hall of the Biblioplex — Land.\n75\t+\n76\t+    SOS collector number 257.\n77\t+    \"\"\"\n78\t+\n79\t+    def __init__(self, **kwargs: Any) -> None:\n80\t+        kwargs.setdefault(\"name\", \"Great Hall of the Biblioplex\")\n81\t+        kwargs.setdefault(\n82\t+            \"rules_text\",\n83\t+            \"{T}: Add {C}.\\n\"\n84\t+            \"{T}, Pay 1 life: Add one mana of any color. Spend this mana only \"\n85\t+            \"to cast an instant or sorcery spell.\\n\"\n86\t+            \"{5}: If this land isn't a creature, it becomes a 2/4 Wizard \"\n87\t+            'creature with \"Whenever you cast an instant or sorcery spell, '\n88\t+            'this creature gets +1/+0 until end of turn.\" It\\'s still a land.',\n89\t+        )\n90\t+        super().__init__(**kwargs)\n91\t+        # Creature characteristics granted only while animated.  Lands have no\n92\t+        # P/T by default; these mirror the Creature surface so the test (and\n93\t+        # combat) can read ``card.power`` / ``card.toughness`` once animated.\n94\t+        self.base_power: int = 0\n95\t+        self.base_toughness: int = 0\n96\t+        self.modified_power: int = 0\n97\t+        self.modified_toughness: int = 0\n98\t+        self.summoning_sick: bool = True\n99\t+        # Snapshot the printed (non-creature) subtypes for reset.\n100\t+        self._original_subtypes: frozenset[str] = frozenset(self.subtypes)\n101\t+        # Reference to the permanent animation effects so re-activation is a\n102\t+        # no-op (the \"If this land isn't a creature\" guard).\n103\t+        self._animation_effects: list[Any] = []\n104\t+        self._cast_trigger_registered: bool = False\n105\t+\n106\t+    # ------------------------------------------------------------------\n107\t+    # Power / toughness surface (only meaningful while animated)\n108\t+    # ------------------------------------------------------------------\n109\t+    @property\n110\t+    def power(self) -> int:\n111\t+        \"\"\"Current power (0 unless animated; continuous effects set it).\"\"\"\n112\t+        return self.modified_power\n113\t+\n114\t+    @property\n115\t+    def toughness(self) -> int:\n116\t+        \"\"\"Current toughness (0 unless animated; continuous effects set it).\"\"\"\n117\t+        return self.modified_toughness\n118\t+\n119\t+    def _reset_characteristics(self) -> None:\n120\t+        \"\"\"Reset to printed (non-creature) characteristics before reapply.\n121\t+\n122\t+        ``Land._reset_characteristics`` only resets ``card_types`` and\n123\t+        ``keywords``; the animation also touches ``subtypes`` and P/T, so we\n124\t+        reset those here so ``EffectManager.apply_all`` stays idempotent.\n125\t+        \"\"\"\n126\t+        super()._reset_characteristics()\n127\t+        self.subtypes = set(self._original_subtypes)\n128\t+        self.modified_power = self.base_power\n129\t+        self.modified_toughness = self.base_toughness\n130\t+\n131\t+    # ------------------------------------------------------------------\n132\t+    # Mana abilities\n133\t+    # ------------------------------------------------------------------\n134\t+    def get_mana_abilities(self) -> list[ManaAbility]:\n135\t+        source = self\n136\t+\n137\t+        def _tap_cost(game: Any, src: Any) -> bool:\n138\t+            if getattr(src, \"is_tapped\", False):\n139\t+                return False\n140\t+            src.is_tapped = True\n141\t+            return True\n142\t+\n143\t+        def _tap_pay_life_cost(game: Any, src: Any) -> bool:\n144\t+            # A tapped source cannot pay the tap cost; do NOT drain life on a\n145\t+            # failed activation.\n146\t+            if getattr(src, \"is_tapped\", False):\n147\t+                return False\n148\t+            controller = src.controller\n149\t+            if controller is None:\n150\t+                return False\n151\t+            src.is_tapped = True\n152\t+            controller.life -= 1\n153\t+            return True\n154\t+\n155\t+        def _colorless_effect(game: Any) -> None:\n156\t+            controller = source.controller\n157\t+            if controller is not None:\n158\t+                controller.mana_pool.add(ManaType.COLORLESS, 1)\n159\t+\n160\t+        def _any_color_effect(game: Any) -> None:\n161\t+            # UNVERIFIED: \"spend this mana only to cast an instant or sorcery spell\" — engine has no mana spend-restriction surface (matches FDN 267 Secluded Courtyard limitation).\n162\t+            controller = source.controller\n163\t+            if controller is None:\n164\t+                return\n165\t+            chosen = controller.choose(\n166\t+                list(_COLOR_OPTIONS),\n167\t+                \"Choose a color of mana to produce\",\n168\t+            )\n169\t+            controller.mana_pool.add(chosen, 1)\n170\t+\n171\t+        return [\n172\t+            ManaAbility(\n173\t+                cost=_tap_cost,\n174\t+                mana_produced=_colorless_effect,\n175\t+                description=\"{T}: Add {C}.\",\n176\t+            ),\n177\t+            ManaAbility(\n178\t+                cost=_tap_pay_life_cost,\n179\t+                mana_produced=_any_color_effect,\n180\t+                description=\"{T}, Pay 1 life: Add one mana of any color.\",\n181\t+            ),\n182\t+        ]\n183\t+\n184\t+    # ------------------------------------------------------------------\n185\t+    # {5}: animation activated ability\n186\t+    # ------------------------------------------------------------------\n187\t+    def get_activated_abilities(self) -> list[ActivatedAbility]:\n188\t+        source = self\n189\t+\n190\t+        def _cost(game: Any, src: Any) -> bool:\n191\t+            controller = src.controller\n192\t+            if controller is None:\n193\t+                return False\n194\t+            return controller.mana_pool.pay(ManaCost(generic=5))\n195\t+\n196\t+        def _effect(game: Any) -> None:\n197\t+            source._animate(game)\n198\t+\n199\t+        return [\n200\t+            ActivatedAbility(\n201\t+                cost=_cost,\n202\t+                effect=_effect,\n203\t+                description=(\n204\t+                    \"{5}: If this land isn't a creature, it becomes a 2/4 \"\n205\t+                    \"Wizard creature. It's still a land.\"\n206\t+                ),\n207\t+            ),\n208\t+        ]\n209\t+\n210\t+    # ------------------------------------------------------------------\n211\t+    # Animation\n212\t+    # ------------------------------------------------------------------\n213\t+    def _animate(self, game: GameState) -> None:\n214\t+        \"\"\"Become a 2/4 Wizard creature (still a land), guarding re-animation.\n215\t+\n216\t+        \"If this land isn't a creature, it becomes ...\" — if it is already a\n217\t+        creature (animation effects already registered), this is a no-op so the\n218\t+        P/T does not stack.\n219\t+        \"\"\"\n220\t+        if CardType.CREATURE in self.card_types or self._animation_effects:\n221\t+            return\n222\t+\n223\t+        card = self\n224\t+\n225\t+        def _apply_type(game: GameState) -> None:\n226\t+            if not _is_on_battlefield(game, card):\n227\t+                return\n228\t+            card.card_types = set(card.card_types) | {CardType.CREATURE}\n229\t+            card.subtypes = set(card.subtypes) | {\"Wizard\"}\n230\t+\n231\t+        def _apply_pt(game: GameState) -> None:\n232\t+            if not _is_on_battlefield(game, card):\n233\t+                return\n234\t+            if CardType.CREATURE not in card.card_types:\n235\t+                return\n236\t+            card.modified_power = 2\n237\t+            card.modified_toughness = 4\n238\t+\n239\t+        type_effect = ContinuousEffect(\n240\t+            source=self,\n241\t+            layer=Layer.TYPE,\n242\t+            sublayer=None,\n243\t+            apply=_apply_type,\n244\t+            duration=DURATION_PERMANENT,\n245\t+        )\n246\t+        pt_effect = ContinuousEffect(\n247\t+            source=self,\n248\t+            layer=Layer.POWER_TOUGHNESS,\n249\t+            sublayer=SubLayer.SET_PT,\n250\t+            apply=_apply_pt,\n251\t+            duration=DURATION_PERMANENT,\n252\t+        )\n253\t+        self._animation_effects = [\n254\t+            game.effect_manager.add(type_effect),\n255\t+            game.effect_manager.add(pt_effect),\n256\t+        ]\n257\t+        # Apply immediately so the type is live before any further queries.\n258\t+        game.effect_manager.apply_all(game)\n259\t+        # Ensure the granted cast trigger is registered (once).\n260\t+        self._register_cast_trigger(game)\n261\t+\n262\t+    # ------------------------------------------------------------------\n263\t+    # Granted \"whenever you cast an instant or sorcery spell\" trigger\n264\t+    # ------------------------------------------------------------------\n265\t+    def register_triggers(self, game: GameState) -> None:\n266\t+        # Register up-front so animation that happens after the permanent is\n267\t+        # already tracked still benefits; the condition gates on being a\n268\t+        # creature, so it is inert until animated.\n269\t+        self._register_cast_trigger(game)\n270\t+\n271\t+    def _register_cast_trigger(self, game: GameState) -> None:\n272\t+        if self._cast_trigger_registered:\n273\t+            return\n274\t+        trigger_manager = getattr(game, \"trigger_manager\", None)\n275\t+        if trigger_manager is None:\n276\t+            return\n277\t+        from engine.events import SpellCastTriggeredEvent\n278\t+        from engine.triggers import TriggerRegistration\n279\t+\n280\t+        source = self\n281\t+\n282\t+        def _condition(game: Any, event: Any) -> bool:\n283\t+            # Only while animated (a creature) and on the battlefield.\n284\t+            if CardType.CREATURE not in source.card_types:\n285\t+                return False\n286\t+            if not _is_on_battlefield(game, source):\n287\t+                return False\n288\t+            controller = source.controller\n289\t+            if controller is None:\n290\t+                return False\n291\t+            spell = getattr(event, \"spell\", None) or getattr(event, \"card\", None)\n292\t+            if spell is None:\n293\t+                return False\n294\t+            # Only the controller's own instant/sorcery spells.\n295\t+            caster = getattr(event, \"controller\", None) or getattr(event, \"player\", None)\n296\t+            spell_controller = getattr(spell, \"controller\", None)\n297\t+            if caster is not controller and spell_controller is not controller:\n298\t+                return False\n299\t+            card_types = getattr(spell, \"card_types\", set())\n300\t+            return bool(card_types & {CardType.INSTANT, CardType.SORCERY})\n301\t+\n302\t+        def _effect(game: GameState) -> None:\n303\t+            source._pump_until_end_of_turn(game)\n304\t+\n305\t+        controller = getattr(self, \"controller\", None) or game.active_player\n306\t+        trigger_manager.register(\n307\t+            TriggerRegistration(\n308\t+                event_type=SpellCastTriggeredEvent,\n309\t+                condition=_condition,\n310\t+                effect=_effect,\n311\t+                source=self,\n312\t+                controller=controller,\n313\t+            )\n314\t+        )\n315\t+        self._cast_trigger_registered = True\n316\t+\n317\t+    def _pump_until_end_of_turn(self, game: GameState) -> None:\n318\t+        \"\"\"Give this creature +1/+0 until end of turn (per qualifying cast).\"\"\"\n319\t+        card = self\n320\t+\n321\t+        def _apply_pump(game: GameState) -> None:\n322\t+            if not _is_on_battlefield(game, card):\n323\t+                return\n324\t+            if CardType.CREATURE not in card.card_types:\n325\t+                return\n326\t+            card.modified_power += 1\n327\t \n328\t-    pass\n329\t+        pump = ContinuousEffect(\n330\t+            source=self,\n331\t+            layer=Layer.POWER_TOUGHNESS,\n332\t+            sublayer=SubLayer.MODIFY_PT,\n333\t+            apply=_apply_pump,\n334\t+            duration=DURATION_END_OF_TURN,\n335\t+        )\n336\t+        game.effect_manager.add(pump)\n337\t+        game.effect_manager.apply_all(game)\n338\t"}]},"parent_tool_use_id":"toolu_01TCJkS1BqPzZYwv1y2apFTa","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"fd261878-2604-405c-8c91-d3efbd39c69d","timestamp":"2026-06-01T12:21:10.443Z","subagent_type":"Reviewer","task_description":"Review sos_257 implementation"}
