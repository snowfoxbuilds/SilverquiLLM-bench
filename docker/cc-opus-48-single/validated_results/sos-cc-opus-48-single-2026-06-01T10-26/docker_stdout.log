{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ASZpNhDNhiPawtnKkd9SPh","type":"tool_result","content":"1\t\"\"\"Zone containers for managing game objects across game zones.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport random\n6\tfrom typing import TYPE_CHECKING, Any\n7\t\n8\tfrom engine.types import CardType, Zone\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t\n13\t\n14\tclass IllegalMoveError(Exception):\n15\t    \"\"\"Raised when a zone move is illegal (e.g. object not found in source zone).\"\"\"\n16\t\n17\t\n18\tclass ZoneContainer:\n19\t    \"\"\"Wraps an ordered list of game-object references for a single zone.\n20\t\n21\t    Internal list convention: index 0 is the *bottom*, index -1 is the *top*.\n22\t    This matches the intuitive model where ``add(obj, position=\"top\")``\n23\t    appends, and ``top(n)`` returns the last *n* items.\n24\t    \"\"\"\n25\t\n26\t    def __init__(self) -> None:\n27\t        self._objects: list[Any] = []\n28\t\n29\t    # ------------------------------------------------------------------\n30\t    # Mutators\n31\t    # ------------------------------------------------------------------\n32\t\n33\t    def add(self, obj: Any, position: str = \"top\") -> None:\n34\t        \"\"\"Add *obj* to this zone.\n35\t\n36\t        Parameters:\n37\t            obj: The game object to add.\n38\t            position: ``\"top\"`` (default) appends to the end of the internal\n39\t                list; ``\"bottom\"`` inserts at position 0.\n40\t        \"\"\"\n41\t        if position == \"top\":\n42\t            self._objects.append(obj)\n43\t        elif position == \"bottom\":\n44\t            self._objects.insert(0, obj)\n45\t        else:\n46\t            raise ValueError(f\"Invalid position: {position!r}; expected 'top' or 'bottom'\")\n47\t\n48\t    def remove(self, obj: Any) -> None:\n49\t        \"\"\"Remove *obj* from this zone (identity-based lookup).\n50\t\n51\t        Raises:\n52\t            ValueError: If *obj* is not in the zone.\n53\t        \"\"\"\n54\t        for i, item in enumerate(self._objects):\n55\t            if item is obj:\n56\t                del self._objects[i]\n57\t                return\n58\t        raise ValueError(f\"{obj!r} not in zone\")\n59\t\n60\t    def shuffle(self) -> None:\n61\t        \"\"\"Randomly shuffle the contents of this zone (used for libraries).\"\"\"\n62\t        random.shuffle(self._objects)\n63\t\n64\t    # ------------------------------------------------------------------\n65\t    # Queries\n66\t    # ------------------------------------------------------------------\n67\t\n68\t    def contains(self, obj: Any) -> bool:\n69\t        \"\"\"Return ``True`` if *obj* is in this zone (identity-based lookup).\"\"\"\n70\t        return any(item is obj for item in self._objects)\n71\t\n72\t    def get_all(self) -> list[Any]:\n73\t        \"\"\"Return a shallow copy of all objects in order (bottom → top).\"\"\"\n74\t        return list(self._objects)\n75\t\n76\t    def top(self, n: int) -> list[Any]:\n77\t        \"\"\"Return the top *n* items (last *n* in the internal list).\n78\t\n79\t        If *n* >= len, returns all items.  Order is bottom-to-top (same\n80\t        orientation as the internal list).\n81\t        \"\"\"\n82\t        if n <= 0:\n83\t            return []\n84\t        return self._objects[-n:]\n85\t\n86\t    def bottom(self, n: int) -> list[Any]:\n87\t        \"\"\"Return the bottom *n* items (first *n* in the internal list).\n88\t\n89\t        If *n* >= len, returns all items.\n90\t        \"\"\"\n91\t        if n <= 0:\n92\t            return []\n93\t        return self._objects[:n]\n94\t\n95\t    def __len__(self) -> int:\n96\t        return len(self._objects)\n97\t\n98\t    def __repr__(self) -> str:\n99\t        return f\"ZoneContainer({self._objects!r})\"\n100\t\n101\t\n102\tclass Zones:\n103\t    \"\"\"Per-player collection mapping each :class:`Zone` to a :class:`ZoneContainer`.\"\"\"\n104\t\n105\t    def __init__(self, zones: dict[Zone, ZoneContainer]) -> None:\n106\t        self._zones = zones\n107\t\n108\t    @classmethod\n109\t    def new_player(cls) -> Zones:\n110\t        \"\"\"Create a fresh set of empty zones for a player.\"\"\"\n111\t        return cls({zone: ZoneContainer() for zone in Zone})\n112\t\n113\t    def __getitem__(self, zone: Zone) -> ZoneContainer:\n114\t        return self._zones[zone]\n115\t\n116\t    def __contains__(self, zone: Zone) -> bool:\n117\t        return zone in self._zones\n118\t\n119\t    def __repr__(self) -> str:\n120\t        return f\"Zones({self._zones!r})\"\n121\t\n122\t\n123\tdef move_zone(\n124\t    obj: Any,\n125\t    from_zone: ZoneContainer,\n126\t    to_zone: ZoneContainer,\n127\t    position: str = \"top\",\n128\t) -> None:\n129\t    \"\"\"Move *obj* from *from_zone* to *to_zone*.\n130\t\n131\t    Parameters:\n132\t        obj: The game object to move.\n133\t        from_zone: Source :class:`ZoneContainer`.\n134\t        to_zone: Destination :class:`ZoneContainer`.\n135\t        position: ``\"top\"`` (default), ``\"bottom\"``, or ``\"shuffle\"``\n136\t            (add then shuffle the destination).\n137\t\n138\t    Raises:\n139\t        IllegalMoveError: If *obj* is not in *from_zone*.\n140\t    \"\"\"\n141\t    # Moving an object to the same zone it's already in is a no-op.\n142\t    if from_zone is to_zone:\n143\t        return\n144\t\n145\t    if not from_zone.contains(obj):\n146\t        raise IllegalMoveError(\n147\t            f\"Object {obj!r} not found in source zone\"\n148\t        )\n149\t\n150\t    # Validate position *before* mutating either zone so that an invalid\n151\t    # position does not leave the object removed from the source without\n152\t    # being added to the destination.\n153\t    if position not in (\"top\", \"bottom\", \"shuffle\"):\n154\t        raise ValueError(f\"Invalid position: {position!r}; expected 'top', 'bottom', or 'shuffle'\")\n155\t\n156\t    from_zone.remove(obj)\n157\t\n158\t    # Clear transient casting metadata when a card changes zones so that\n159\t    # stale data (e.g. colors_spent from a previous cast) does not leak.\n160\t    if hasattr(obj, \"colors_spent\"):\n161\t        del obj.colors_spent\n162\t\n163\t    if position == \"shuffle\":\n164\t        to_zone.add(obj, position=\"top\")\n165\t        to_zone.shuffle()\n166\t    else:\n167\t        to_zone.add(obj, position=position)\n168\t\n169\t\n170\t# Mapping from replacement-effect destination strings to Zone enum values.\n171\t_DESTINATION_ZONE_MAP: dict[str, Zone] = {\n172\t    \"graveyard\": Zone.GRAVEYARD,\n173\t    \"exile\": Zone.EXILE,\n174\t    \"hand\": Zone.HAND,\n175\t    \"library\": Zone.LIBRARY,\n176\t}\n177\t\n178\t\n179\tdef move_to_zone(\n180\t    game: GameState,\n181\t    card: Any,\n182\t    from_zone: Zone,\n183\t    to_zone: Zone,\n184\t    *,\n185\t    replacement_event: Any | None = None,\n186\t) -> None:\n187\t    \"\"\"High-level zone transition with trigger/replacement-effect hooks.\n188\t\n189\t    Centralises the bookkeeping that was previously duplicated across\n190\t    ``destroy()``, ``sacrifice()``, ``exile()``, ``create_token()``,\n191\t    ``_move_to_graveyard()`` (SBAs), and ``_resolve_spell()`` (casting).\n192\t\n193\t    Steps:\n194\t    1. Consult replacement effects for zone-change redirection (if\n195\t       *replacement_event* is supplied and the card is leaving the\n196\t       battlefield).  The replacement may change the destination zone\n197\t       (e.g. exile instead of graveyard) or set ``prevented = True`` to\n198\t       signal that it handled the zone move directly.\n199\t    2. Remove *card* from the source zone.\n200\t    3. Add *card* to the (possibly redirected) destination zone.\n201\t    4. If leaving the battlefield:\n202\t       a. Fire ``LeavesBattlefieldTriggeredEvent``.\n203\t       b. Fire ``CreatureDiesTriggeredEvent`` if the card is a creature\n204\t          **and** the final destination is the graveyard.\n205\t       c. Unregister triggers and replacement effects (fires happen\n206\t          **before** unregister so self-referencing triggers still match).\n207\t    5. If entering the battlefield:\n208\t       a. Register triggers (``register_triggers``) and replacement\n209\t          effects (``register_replacement_effects``).\n210\t       b. Fire ``EntersBattlefieldTriggeredEvent``.\n211\t\n212\t    Parameters:\n213\t        game: The current game state.\n214\t        card: The game object being moved.\n215\t        from_zone: The :class:`Zone` the card is currently in.\n216\t        to_zone: The intended destination :class:`Zone`.\n217\t        replacement_event: Optional typed replacement-event object\n218\t            (e.g. ``CreatureDiesReplacementEvent``).  When ``None``,\n219\t            no replacement effects are consulted (useful for simple\n220\t            moves like casting resolution or exile-from-graveyard).\n221\t    \"\"\"\n222\t    from engine.events import (\n223\t        CreatureDiesTriggeredEvent,\n224\t        EntersBattlefieldTriggeredEvent,\n225\t        LeavesBattlefieldTriggeredEvent,\n226\t    )\n227\t\n228\t    controller = getattr(card, \"controller\", None)\n229\t    owner = getattr(card, \"owner\", controller)\n230\t\n231\t    leaving_battlefield = from_zone == Zone.BATTLEFIELD\n232\t    entering_battlefield = to_zone == Zone.BATTLEFIELD\n233\t\n234\t    # --- Determine the source player for zone lookup ---\n235\t    # When leaving the battlefield, use the controller's zone.\n236\t    # For other zones (hand, graveyard, etc.), use the owner's zone.\n237\t    if leaving_battlefield:\n238\t        source_player = controller\n239\t    else:\n240\t        source_player = owner\n241\t\n242\t    # Fallback: search all players for the zone containing the card.\n243\t    # Also triggered when the inferred player's zone doesn't contain the card\n244\t    # (e.g. discarding a card that's in a different player's hand than its owner).\n245\t    if source_player is None or not source_player.zones[from_zone].contains(card):\n246\t        for player in game.players:\n247\t            if player.zones[from_zone].contains(card):\n248\t                source_player = player\n249\t                break\n250\t\n251\t    if source_player is None:\n252\t        return  # Card not found anywhere\n253\t\n254\t    source_container = source_player.zones[from_zone]\n255\t    if not source_container.contains(card):\n256\t        return  # Safety: card not in any player's zone\n257\t\n258\t    if owner is None:\n259\t        owner = source_player\n260\t\n261\t    # --- Replacement effects (zone-change redirection) ---\n262\t    dest_zone = to_zone\n263\t    if replacement_event is not None and leaving_battlefield:\n264\t        replacement_event = game.replacement_manager.apply(game, replacement_event)\n265\t        if getattr(replacement_event, \"prevented\", False):\n266\t            return\n267\t        destination_str = getattr(replacement_event, \"destination\", \"graveyard\")\n268\t        dest_zone = _DESTINATION_ZONE_MAP.get(destination_str, to_zone)\n269\t\n270\t    # --- Perform the zone move ---\n271\t    source_container.remove(card)\n272\t\n273\t    # Determine the destination player (always the owner for graveyard/exile/hand/library).\n274\t    if entering_battlefield:\n275\t        dest_player = controller if controller is not None else owner\n276\t    else:\n277\t        dest_player = owner\n278\t\n279\t    dest_player.zones[dest_zone].add(card)\n280\t\n281\t    # --- Leaving battlefield hooks ---\n282\t    if leaving_battlefield:\n283\t        card_types = getattr(card, \"card_types\", set())\n284\t        is_creature = CardType.CREATURE in card_types\n285\t\n286\t        # Fire events BEFORE unregistering (KEY_DECISIONS convention).\n287\t        game.trigger_manager.fire_event(\n288\t            game,\n289\t            LeavesBattlefieldTriggeredEvent(permanent=card, controller=controller),\n290\t        )\n291\t        if is_creature and dest_zone == Zone.GRAVEYARD:\n292\t            game.trigger_manager.fire_event(\n293\t                game,\n294\t                CreatureDiesTriggeredEvent(creature=card, controller=controller, owner=owner),\n295\t            )\n296\t\n297\t        # Now unregister triggers and replacement effects.\n298\t        game.trigger_manager.unregister(card)\n299\t        game.replacement_manager.unregister(card)\n300\t\n301\t    # --- Entering battlefield hooks ---\n302\t    if entering_battlefield:\n303\t        # Fire the ENTERS_BATTLEFIELD event *before* registering the card's\n304\t        # own triggers so that a permanent's ETB trigger does not\n305\t        # retroactively trigger off its own entry.  Other already-registered\n306\t        # triggers that watch for ENTERS_BATTLEFIELD will still fire.\n307\t        game.trigger_manager.fire_event(\n308\t            game,\n309\t            EntersBattlefieldTriggeredEvent(\n310\t                permanent=card,\n311\t                controller=controller if controller is not None else owner,\n312\t            ),\n313\t        )\n314\t        if hasattr(card, \"register_triggers\"):\n315\t            card.register_triggers(game)\n316\t        if hasattr(card, \"register_replacement_effects\"):\n317\t            card.register_replacement_effects(game)\n318\t\n319\t\n320\t# Destination string → Zone for replacement-effect zone redirection.\n321\t_DESTINATION_ZONE_MAP: dict[str, Zone] = {\n322\t    \"graveyard\": Zone.GRAVEYARD,\n323\t    \"exile\": Zone.EXILE,\n324\t    \"hand\": Zone.HAND,\n325\t    \"library\": Zone.LIBRARY,\n326\t}\n327\t"}]},"parent_tool_use_id":"toolu_0131x3Q5CoF8oe17FvLyvBg1","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"2b0b3dd1-4a11-4559-bb0e-d31b46afa89b","timestamp":"2026-06-01T11:16:06.393Z","subagent_type":"Implementer","task_description":"Implement sos_97"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EuqHjpypFUdk6dMw9kaMuN","type":"tool_result","content":"1\t\"\"\"Test utility helpers for engine validation and benchmark agents.\n2\t\n3\tProvides convenience functions for setting up game states, casting spells,\n4\tadvancing phases, and managing combat in tests.  Each function raises\n5\tdescriptive errors on failure.\n6\t\n7\tFunctions:\n8\t    create_game — convenience wrapper to create a GameState from card lists.\n9\t    set_board_state — directly set zone contents and player state.\n10\t    cast_spell — find card in hand by name, cast, and resolve.\n11\t    advance_to_phase — fast-forward game state to a given phase/step.\n12\t    declare_attackers — advance to combat and declare attackers by name.\n13\t    declare_blockers — assign blockers by name mapping.\n14\t\"\"\"\n15\t\n16\tfrom __future__ import annotations\n17\t\n18\tfrom typing import Any\n19\t\n20\tfrom engine.card import CardImpl, Creature\n21\tfrom engine.casting import cast_spell as _engine_cast_spell\n22\tfrom engine.combat import (\n23\t    CombatState,\n24\t    declare_attackers_step,\n25\t    declare_blockers_step,\n26\t)\n27\tfrom engine.game import create_game as _engine_create_game\n28\tfrom engine.game_state import GameState, _TURN_SEQUENCE\n29\tfrom engine.mana import ManaPool\n30\tfrom engine.player import DeterministicPlayer\n31\tfrom engine.stack import priority_loop\n32\tfrom engine.types import ManaType, Phase, Step, Zone\n33\t\n34\t\n35\tclass TestSetupError(Exception):\n36\t    \"\"\"Raised when a test utility function encounters an invalid setup.\"\"\"\n37\t\n38\t\n39\tdef card_colors(card: Any) -> set[str]:\n40\t    \"\"\"Return a card's colors as single-letter strings, derived from its mana cost.\n41\t\n42\t    Hybrid pips contribute both options. {C} and {X} contribute nothing.\n43\t    Returns an empty set for cards with no mana cost or only colorless/X pips.\n44\t    Used by audited tests that previously asserted against a non-existent\n45\t    ``card.colors`` attribute.\n46\t    \"\"\"\n47\t    colors: set[str] = set()\n48\t    cost = getattr(card, \"mana_cost\", None)\n49\t    if cost is None:\n50\t        return colors\n51\t    for mt in getattr(cost, \"pips\", {}):\n52\t        if mt != ManaType.COLORLESS:\n53\t            colors.add(mt.value)\n54\t    for hybrid in getattr(cost, \"hybrid\", []):\n55\t        if hybrid.option_a != ManaType.COLORLESS:\n56\t            colors.add(hybrid.option_a.value)\n57\t        if hybrid.option_b != ManaType.COLORLESS:\n58\t            colors.add(hybrid.option_b.value)\n59\t    return colors\n60\t\n61\t\n62\t# ---------------------------------------------------------------------------\n63\t# create_game\n64\t# ---------------------------------------------------------------------------\n65\t\n66\t\n67\tdef create_game(\n68\t    deck1: list[CardImpl] | None = None,\n69\t    deck2: list[CardImpl] | None = None,\n70\t    *,\n71\t    player1_name: str = \"Player1\",\n72\t    player2_name: str = \"Player2\",\n73\t    player1_life: int = 20,\n74\t    player2_life: int = 20,\n75\t    scripts: tuple[list[Any], list[Any]] | None = None,\n76\t) -> GameState:\n77\t    \"\"\"Create a new two-player game from card lists.\n78\t\n79\t    This is a convenience wrapper around :func:`engine.game.create_game`\n80\t    that automatically creates :class:`DeterministicPlayer` instances.\n81\t\n82\t    Parameters:\n83\t        deck1: Cards for player 1's deck.  Defaults to empty list.\n84\t        deck2: Cards for player 2's deck.  Defaults to empty list.\n85\t        player1_name: Display name for player 1.\n86\t        player2_name: Display name for player 2.\n87\t        player1_life: Starting life for player 1.\n88\t        player2_life: Starting life for player 2.\n89\t        scripts: Optional tuple of ``(script1, script2)`` for\n90\t            :class:`DeterministicPlayer`.  Defaults to empty lists.\n91\t\n92\t    Returns:\n93\t        A fully initialised :class:`GameState`.\n94\t\n95\t    Raises:\n96\t        TestSetupError: If the inputs are invalid.\n97\t    \"\"\"\n98\t    if deck1 is None:\n99\t        deck1 = []\n100\t    if deck2 is None:\n101\t        deck2 = []\n102\t\n103\t    script1: list[Any] = []\n104\t    script2: list[Any] = []\n105\t    if scripts is not None:\n106\t        script1, script2 = scripts\n107\t\n108\t    p1 = DeterministicPlayer(player1_name, script=script1, life=player1_life)\n109\t    p2 = DeterministicPlayer(player2_name, script=script2, life=player2_life)\n110\t\n111\t    game = _engine_create_game(p1, p2, deck1, deck2)\n112\t\n113\t    # When decks are empty (the convenience default), engine.game.create_game\n114\t    # attempts to draw 7 cards from each empty library, which sets the\n115\t    # drawn_from_empty_library loss flag.  Reset it for the convenience case.\n116\t    for player in game.players:\n117\t        if player.drawn_from_empty_library:\n118\t            player.drawn_from_empty_library = False\n119\t\n120\t    # engine.game.create_game hardcodes life=20; restore custom values.\n121\t    if player1_life != 20:\n122\t        game.players[0].life = player1_life\n123\t    if player2_life != 20:\n124\t        game.players[1].life = player2_life\n125\t\n126\t    return game\n127\t\n128\t\n129\t# ---------------------------------------------------------------------------\n130\t# set_board_state\n131\t# ---------------------------------------------------------------------------\n132\t\n133\t\n134\tdef set_board_state(\n135\t    game: GameState,\n136\t    player_index: int,\n137\t    *,\n138\t    battlefield: list[Any] | None = None,\n139\t    hand: list[Any] | None = None,\n140\t    graveyard: list[Any] | None = None,\n141\t    life: int | None = None,\n142\t    mana: dict[ManaType, int] | None = None,\n143\t) -> None:\n144\t    \"\"\"Directly set zone contents and player state for test setup.\n145\t\n146\t    Replaces the contents of the specified zones (only zones that are\n147\t    explicitly provided are modified — others are left unchanged).\n148\t\n149\t    For each card placed into a zone, ``owner`` and ``controller`` are\n150\t    set to the target player.\n151\t\n152\t    Parameters:\n153\t        game: The game state to modify.\n154\t        player_index: Index of the player (0 or 1).\n155\t        battlefield: Cards/permanents to place on the battlefield.\n156\t        hand: Cards to place in hand.\n157\t        graveyard: Cards to place in graveyard.\n158\t        life: Life total to set (or ``None`` to leave unchanged).\n159\t        mana: Mana to add to the player's pool.  Keys are\n160\t            :class:`ManaType`, values are amounts.\n161\t\n162\t    Raises:\n163\t        TestSetupError: If ``player_index`` is out of range.\n164\t    \"\"\"\n165\t    if player_index < 0 or player_index >= len(game.players):\n166\t        raise TestSetupError(\n167\t            f\"Invalid player_index {player_index} — game has \"\n168\t            f\"{len(game.players)} players (indices 0–{len(game.players) - 1})\"\n169\t        )\n170\t\n171\t    player = game.players[player_index]\n172\t\n173\t    if life is not None:\n174\t        player.life = life\n175\t\n176\t    if mana is not None:\n177\t        player.mana_pool.empty()\n178\t        for mana_type, amount in mana.items():\n179\t            player.mana_pool.add(mana_type, amount)\n180\t\n181\t    if battlefield is not None:\n182\t        _set_zone(game, player, Zone.BATTLEFIELD, battlefield)\n183\t\n184\t    if hand is not None:\n185\t        _set_zone(game, player, Zone.HAND, hand)\n186\t\n187\t    if graveyard is not None:\n188\t        _set_zone(game, player, Zone.GRAVEYARD, graveyard)\n189\t\n190\t\n191\tdef _set_zone(\n192\t    game: GameState,\n193\t    player: Any,\n194\t    zone: Zone,\n195\t    cards: list[Any],\n196\t) -> None:\n197\t    \"\"\"Replace a zone's contents with *cards*, assigning ownership.\"\"\"\n198\t    zone_container = player.zones[zone]\n199\t    # Clear existing contents\n200\t    for obj in zone_container.get_all():\n201\t        zone_container.remove(obj)\n202\t\n203\t    # Add new contents\n204\t    for card in cards:\n205\t        card.owner = player\n206\t        card.controller = player\n207\t        zone_container.add(card)\n208\t\n209\t\n210\t# ---------------------------------------------------------------------------\n211\t# cast_spell\n212\t# ---------------------------------------------------------------------------\n213\t\n214\t\n215\tdef cast_spell(\n216\t    game: GameState,\n217\t    player_index: int,\n218\t    card_name: str,\n219\t    targets: list[Any] | None = None,\n220\t) -> None:\n221\t    \"\"\"Find a card in hand by name, cast it, and pass priority until resolved.\n222\t\n223\t    The function:\n224\t    1. Locates the first card matching *card_name* in the player's hand.\n225\t    2. Sets up the game phase/priority for sorcery-speed casting if needed.\n226\t    3. Calls :func:`engine.casting.cast_spell`.\n227\t    4. Passes priority for both players so the spell resolves.\n228\t\n229\t    Parameters:\n230\t        game: The game state.\n231\t        player_index: Index of the casting player (0 or 1).\n232\t        card_name: Name of the card to find in hand.\n233\t        targets: Optional target list.  If provided, they are scripted\n234\t            into the player's DeterministicPlayer choices.\n235\t\n236\t    Raises:\n237\t        TestSetupError: If the card is not found in hand or casting fails.\n238\t    \"\"\"\n239\t    if player_index < 0 or player_index >= len(game.players):\n240\t        raise TestSetupError(\n241\t            f\"Invalid player_index {player_index} — game has \"\n242\t            f\"{len(game.players)} players\"\n243\t        )\n244\t\n245\t    player = game.players[player_index]\n246\t    hand = game.get_hand(player)\n247\t\n248\t    # Find the card by name\n249\t    card = None\n250\t    for obj in hand.get_all():\n251\t        if getattr(obj, \"name\", None) == card_name:\n252\t            card = obj\n253\t            break\n254\t\n255\t    if card is None:\n256\t        hand_names = [getattr(c, \"name\", repr(c)) for c in hand.get_all()]\n257\t        raise TestSetupError(\n258\t            f\"Card {card_name!r} not found in player {player_index}'s hand. \"\n259\t            f\"Hand contains: {hand_names}\"\n260\t        )\n261\t\n262\t    # Ensure sorcery-speed timing for non-instant spells\n263\t    from engine.types import CardType, Keyword\n264\t\n265\t    is_instant = CardType.INSTANT in getattr(card, \"card_types\", set())\n266\t    has_flash = Keyword.FLASH in getattr(card, \"keywords\", Keyword(0))\n267\t\n268\t    if not is_instant and not has_flash:\n269\t        # Set up sorcery-speed timing: active player, main phase, empty stack\n270\t        game.active_player_index = player_index\n271\t        game.priority_player_index = player_index\n272\t        if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n273\t            game.phase = Phase.PRECOMBAT_MAIN\n274\t            game.step = None\n275\t\n276\t    # Ensure the stack is empty for sorcery-speed\n277\t    if not game.stack.is_empty():\n278\t        raise TestSetupError(\n279\t            f\"Cannot cast {card_name!r} — stack is not empty\"\n280\t        )\n281\t\n282\t    # Script targets into the player's DeterministicPlayer choices so that\n283\t    # engine.casting.cast_spell -> player.choose_target() returns them.\n284\t    if targets and isinstance(player, DeterministicPlayer):\n285\t        for target in reversed(targets):\n286\t            player._script.appendleft(target)\n287\t\n288\t    try:\n289\t        _engine_cast_spell(game, player, card)\n290\t    except Exception as exc:\n291\t        raise TestSetupError(\n292\t            f\"Failed to cast {card_name!r}: {exc}\"\n293\t        ) from exc\n294\t\n295\t    # Pass priority for both players to resolve the spell\n296\t    _resolve_top_of_stack(game)\n297\t\n298\t\n299\tdef _resolve_top_of_stack(game: GameState) -> None:\n300\t    \"\"\"Resolve the top spell/ability on the stack by passing priority.\n301\t\n302\t    Both players pass priority so the top of the stack resolves.\n303\t    Repeats until the stack is empty.\n304\t    \"\"\"\n305\t    from engine.state_based_actions import resolve_state_based_actions\n306\t\n307\t    while not game.stack.is_empty():\n308\t        obj = game.stack.pop()\n309\t        obj.on_resolve(game)\n310\t        resolve_state_based_actions(game)\n311\t\n312\t\n313\t# ---------------------------------------------------------------------------\n314\t# advance_to_phase\n315\t# ---------------------------------------------------------------------------\n316\t\n317\t\n318\tdef advance_to_phase(\n319\t    game: GameState,\n320\t    phase: Phase,\n321\t    step: Step | None = None,\n322\t) -> None:\n323\t    \"\"\"Fast-forward the game state to the specified phase/step.\n324\t\n325\t    Advances by calling :meth:`GameState.advance_phase` until the target\n326\t    phase (and optionally step) is reached.  Priority is not granted during\n327\t    fast-forwarding — this is a direct state manipulation for test setup.\n328\t\n329\t    Parameters:\n330\t        game: The game state to advance.\n331\t        phase: The target phase.\n332\t        step: The target step (or ``None`` for main phases).\n333\t\n334\t    Raises:\n335\t        TestSetupError: If the target phase/step is not found within\n336\t            a full turn cycle (prevents infinite loops).\n337\t    \"\"\"\n338\t    target = (phase, step)\n339\t\n340\t    # Validate that (phase, step) is a valid combination\n341\t    valid_targets = {(p, s) for p, s in _TURN_SEQUENCE}\n342\t    if target not in valid_targets:\n343\t        raise TestSetupError(\n344\t            f\"Invalid phase/step combination: ({phase!r}, {step!r}). \"\n345\t            f\"Valid combinations: {sorted(valid_targets, key=lambda x: str(x))}\"\n346\t        )\n347\t\n348\t    # Already there?\n349\t    if (game.phase, game.step) == target:\n350\t        return\n351\t\n352\t    # Advance up to a full turn's worth of steps to prevent infinite loops\n353\t    max_advances = len(_TURN_SEQUENCE) + 1\n354\t    for _ in range(max_advances):\n355\t        game.advance_phase()\n356\t        if (game.phase, game.step) == target:\n357\t            return\n358\t\n359\t    raise TestSetupError(\n360\t        f\"Could not reach phase/step ({phase!r}, {step!r}) within \"\n361\t        f\"a full turn cycle. Current: ({game.phase!r}, {game.step!r})\"\n362\t    )\n363\t\n364\t\n365\t# ---------------------------------------------------------------------------\n366\t# declare_attackers\n367\t# ---------------------------------------------------------------------------\n368\t\n369\t\n370\tdef declare_attackers(\n371\t    game: GameState,\n372\t    attacker_names: list[str],\n373\t) -> None:\n374\t    \"\"\"Advance to combat and declare attackers by name.\n375\t\n376\t    1. Advances to the Declare Attackers step if not already there.\n377\t    2. Finds creatures on the active player's battlefield matching the\n378\t       given names.\n379\t    3. Scripts the active player's ``choose`` method to return those\n380\t       creatures.\n381\t    4. Calls :func:`engine.combat.declare_attackers_step`.\n382\t\n383\t    Parameters:\n384\t        game: The game state.\n385\t        attacker_names: Names of creatures to declare as attackers.\n386\t\n387\t    Raises:\n388\t        TestSetupError: If any named creature is not found on the\n389\t            active player's battlefield, or if the creature cannot attack.\n390\t    \"\"\"\n391\t    # Advance to declare attackers step\n392\t    if (game.phase, game.step) != (Phase.COMBAT, Step.DECLARE_ATTACKERS):\n393\t        advance_to_phase(game, Phase.COMBAT, Step.DECLARE_ATTACKERS)\n394\t\n395\t    active = game.active_player\n396\t    bf = game.get_battlefield(active)\n397\t\n398\t    # Resolve attacker names to objects\n399\t    attackers: list[Any] = []\n400\t    bf_objects = bf.get_all()\n401\t    for name in attacker_names:\n402\t        found = None\n403\t        for obj in bf_objects:\n404\t            if getattr(obj, \"name\", None) == name and obj not in attackers:\n405\t                found = obj\n406\t                break\n407\t        if found is None:\n408\t            bf_names = [getattr(c, \"name\", repr(c)) for c in bf_objects]\n409\t            raise TestSetupError(\n410\t                f\"Attacker {name!r} not found on active player's battlefield. \"\n411\t                f\"Battlefield contains: {bf_names}\"\n412\t            )\n413\t        attackers.append(found)\n414\t\n415\t    # Script the active player to choose these attackers\n416\t    if isinstance(active, DeterministicPlayer):\n417\t        active._script.appendleft(attackers)\n418\t    else:\n419\t        raise TestSetupError(\n420\t            \"declare_attackers requires active player to be a DeterministicPlayer\"\n421\t        )\n422\t\n423\t    game.combat_state.in_combat = True\n424\t    declare_attackers_step(game)\n425\t\n426\t\n427\t# ---------------------------------------------------------------------------\n428\t# declare_blockers\n429\t# ---------------------------------------------------------------------------\n430\t\n431\t\n432\tdef declare_blockers(\n433\t    game: GameState,\n434\t    assignments: dict[str, list[str]],\n435\t) -> None:\n436\t    \"\"\"Assign blockers by name mapping.\n437\t\n438\t    Parameters:\n439\t        game: The game state.\n440\t        assignments: A mapping of ``{\"attacker_name\": [\"blocker_name\", ...]}``.\n441\t            Each attacker on the active player's battlefield is matched by\n442\t            name, and each blocker on the defending player's battlefield is\n443\t            matched by name.\n444\t\n445\t    Raises:\n446\t        TestSetupError: If any named creature is not found.\n447\t    \"\"\"\n448\t    if (game.phase, game.step) != (Phase.COMBAT, Step.DECLARE_BLOCKERS):\n449\t        advance_to_phase(game, Phase.COMBAT, Step.DECLARE_BLOCKERS)\n450\t\n451\t    active = game.active_player\n452\t    defending = game.non_active_player\n453\t\n454\t    active_bf = game.get_battlefield(active)\n455\t    defending_bf = game.get_battlefield(defending)\n456\t\n457\t    active_objects = active_bf.get_all()\n458\t    defending_objects = defending_bf.get_all()\n459\t\n460\t    # Build mapping of blocker_obj → attacker_obj\n461\t    block_map: dict[Any, Any] = {}\n462\t\n463\t    for attacker_name, blocker_names in assignments.items():\n464\t        # Find attacker\n465\t        attacker = None\n466\t        for obj in active_objects:\n467\t            if getattr(obj, \"name\", None) == attacker_name:\n468\t                attacker = obj\n469\t                break\n470\t        if attacker is None:\n471\t            raise TestSetupError(\n472\t                f\"Attacker {attacker_name!r} not found on active player's battlefield. \"\n473\t                f\"Available: {[getattr(c, 'name', repr(c)) for c in active_objects]}\"\n474\t            )\n475\t\n476\t        for blocker_name in blocker_names:\n477\t            blocker = None\n478\t            for obj in defending_objects:\n479\t                if getattr(obj, \"name\", None) == blocker_name and obj not in block_map:\n480\t                    blocker = obj\n481\t                    break\n482\t            if blocker is None:\n483\t                raise TestSetupError(\n484\t                    f\"Blocker {blocker_name!r} not found on defending player's battlefield. \"\n485\t                    f\"Available: {[getattr(c, 'name', repr(c)) for c in defending_objects]}\"\n486\t                )\n487\t            block_map[blocker] = attacker\n488\t\n489\t    # Script the defending player to choose these block assignments\n490\t    if isinstance(defending, DeterministicPlayer):\n491\t        defending._script.appendleft(block_map)\n492\t    else:\n493\t        raise TestSetupError(\n494\t            \"declare_blockers requires defending player to be a DeterministicPlayer\"\n495\t        )\n496\t\n497\t    declare_blockers_step(game)\n498\t"}]},"parent_tool_use_id":"toolu_0131x3Q5CoF8oe17FvLyvBg1","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"9e467831-af7f-4f34-81bc-14eb7012d432","timestamp":"2026-06-01T11:16:06.393Z","subagent_type":"Implementer","task_description":"Implement sos_97"}
{"type":"system","subtype":"task_progress","task_id":"a7311c677a0424777","tool_use_id":"toolu_0131x3Q5CoF8oe17FvLyvBg1","description":"Reading engine/player.py","subagent_type":"Implementer","usage":{"total_tokens":51120,"tool_uses":11,"duration_ms":21842},"last_tool_name":"Read","uuid":"75cd4ff3-9862-4e3b-b704-ec961b5169b8","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445"}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01G7YkXQZaRmoJoQ5nAugvQm","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KW9BV2VuZ1SnCPPArVuG2L","name":"Read","input":{"file_path":"/workspace/engine/player.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12329,"cache_read_input_tokens":38691,"cache_creation":{"ephemeral_5m_input_tokens":12329,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_0131x3Q5CoF8oe17FvLyvBg1","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"89a7ee8f-efce-400c-a424-993429c02b8a","request_id":"req_011CbcSkkSeyXgEQBeTCqVTL","subagent_type":"Implementer","task_description":"Implement sos_97"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KW9BV2VuZ1SnCPPArVuG2L","type":"tool_result","content":"1\t\"\"\"Player interface and deterministic test player implementation.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom abc import ABC, abstractmethod\n6\tfrom collections import deque\n7\tfrom typing import Any\n8\t\n9\tfrom engine.mana import ManaPool\n10\tfrom engine.zones import Zones\n11\t\n12\t\n13\tclass ScriptExhaustedError(Exception):\n14\t    \"\"\"Raised when a DeterministicPlayer's script runs out of predetermined answers.\"\"\"\n15\t\n16\t\n17\tclass Player(ABC):\n18\t    \"\"\"Abstract base class for all players in the game.\n19\t\n20\t    Attributes:\n21\t        name: The player's display name.\n22\t        life: Current life total (default 20).\n23\t        zones: Per-player zone containers.\n24\t        mana_pool: The player's mana pool (forward ref; initialized to None until ManaPool is implemented).\n25\t        has_lost: Whether this player has lost the game.\n26\t        land_plays_remaining: Number of land plays remaining this turn.\n27\t        drawn_from_empty_library: Whether this player attempted to draw from an empty library.\n28\t    \"\"\"\n29\t\n30\t    def __init__(self, name: str, life: int = 20) -> None:\n31\t        self.name: str = name\n32\t        self.life: int = life\n33\t        self.zones: Zones = Zones.new_player()\n34\t        self.mana_pool: ManaPool = ManaPool()\n35\t        self.has_lost: bool = False\n36\t        self.land_plays_remaining: int = 1\n37\t        self.drawn_from_empty_library: bool = False\n38\t\n39\t    @abstractmethod\n40\t    def choose_target(self, options: Any, requirement: Any) -> Any:\n41\t        \"\"\"Choose a target from the available options given a requirement.\n42\t\n43\t        Parameters:\n44\t            options: The available targets to choose from.\n45\t            requirement: The targeting requirement to satisfy.\n46\t\n47\t        Returns:\n48\t            The chosen target.\n49\t        \"\"\"\n50\t\n51\t    @abstractmethod\n52\t    def choose(self, options: Any, description: str) -> Any:\n53\t        \"\"\"Choose from a list of options.\n54\t\n55\t        Parameters:\n56\t            options: The available choices.\n57\t            description: Human-readable description of the choice.\n58\t\n59\t        Returns:\n60\t            The chosen option.\n61\t        \"\"\"\n62\t\n63\t    @abstractmethod\n64\t    def choose_yes_no(self, prompt: str) -> bool:\n65\t        \"\"\"Make a yes/no decision.\n66\t\n67\t        Parameters:\n68\t            prompt: Human-readable prompt for the decision.\n69\t\n70\t        Returns:\n71\t            True for yes, False for no.\n72\t        \"\"\"\n73\t\n74\t    @abstractmethod\n75\t    def assign_damage_order(self, attackers_or_blockers: Any) -> list[Any]:\n76\t        \"\"\"Assign a damage ordering to attackers or blockers.\n77\t\n78\t        Parameters:\n79\t            attackers_or_blockers: The creatures to order.\n80\t\n81\t        Returns:\n82\t            An ordered list representing the damage assignment order.\n83\t        \"\"\"\n84\t\n85\t    @abstractmethod\n86\t    def choose_card(self, cards: Any, description: str) -> Any:\n87\t        \"\"\"Choose a card from a collection.\n88\t\n89\t        Parameters:\n90\t            cards: The available cards to choose from.\n91\t            description: Human-readable description of why a card is being chosen.\n92\t\n93\t        Returns:\n94\t            The chosen card.\n95\t        \"\"\"\n96\t\n97\t\n98\tclass DeterministicPlayer(Player):\n99\t    \"\"\"A scripted player for testing that returns predetermined answers.\n100\t\n101\t    Each abstract method call pops the next answer from the front of the\n102\t    script queue. Raises :class:`ScriptExhaustedError` if the script is empty\n103\t    when a choice is requested.\n104\t    \"\"\"\n105\t\n106\t    def __init__(self, name: str, script: list[Any], life: int = 20) -> None:\n107\t        super().__init__(name, life)\n108\t        self._script: deque[Any] = deque(script)\n109\t\n110\t    def _pop(self) -> Any:\n111\t        \"\"\"Pop the next scripted answer from the queue.\n112\t\n113\t        Raises:\n114\t            ScriptExhaustedError: If the script has no remaining answers.\n115\t        \"\"\"\n116\t        if not self._script:\n117\t            raise ScriptExhaustedError(\n118\t                f\"Player {self.name!r} script exhausted — no more predetermined answers\"\n119\t            )\n120\t        return self._script.popleft()\n121\t\n122\t    @property\n123\t    def remaining_choices(self) -> int:\n124\t        \"\"\"Return the number of scripted answers remaining.\"\"\"\n125\t        return len(self._script)\n126\t\n127\t    def choose_target(self, options: Any, requirement: Any) -> Any:\n128\t        \"\"\"Return the next scripted target choice.\"\"\"\n129\t        return self._pop()\n130\t\n131\t    def choose(self, options: Any, description: str) -> Any:\n132\t        \"\"\"Return the next scripted choice.\"\"\"\n133\t        return self._pop()\n134\t\n135\t    def choose_yes_no(self, prompt: str) -> bool:\n136\t        \"\"\"Return the next scripted yes/no decision.\"\"\"\n137\t        return self._pop()\n138\t\n139\t    def assign_damage_order(self, attackers_or_blockers: Any) -> list[Any]:\n140\t        \"\"\"Return the next scripted damage ordering.\"\"\"\n141\t        return self._pop()\n142\t\n143\t    def choose_card(self, cards: Any, description: str) -> Any:\n144\t        \"\"\"Return the next scripted card choice.\"\"\"\n145\t        return self._pop()\n146\t"}]},"parent_tool_use_id":"toolu_0131x3Q5CoF8oe17FvLyvBg1","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"fbd4e558-d612-45a7-81a2-5dbff5f5f7a4","timestamp":"2026-06-01T11:16:09.638Z","subagent_type":"Implementer","task_description":"Implement sos_97"}
{"type":"system","subtype":"task_progress","task_id":"a7311c677a0424777","tool_use_id":"toolu_0131x3Q5CoF8oe17FvLyvBg1","description":"Reading engine/abilities.py","subagent_type":"Implementer","usage":{"total_tokens":51128,"tool_uses":12,"duration_ms":22025},"last_tool_name":"Read","uuid":"32de0e6c-a55e-423a-b575-0fcd0c72a0c8","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445"}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01G7YkXQZaRmoJoQ5nAugvQm","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0126MmiZLvx7x2zfynMhzP1r","name":"Read","input":{"file_path":"/workspace/engine/abilities.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12329,"cache_read_input_tokens":38691,"cache_creation":{"ephemeral_5m_input_tokens":12329,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_0131x3Q5CoF8oe17FvLyvBg1","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"0e6908da-1736-4221-b8ab-2c7ba1abd35e","request_id":"req_011CbcSkkSeyXgEQBeTCqVTL","subagent_type":"Implementer","task_description":"Implement sos_97"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0126MmiZLvx7x2zfynMhzP1r","type":"tool_result","content":"1\t\"\"\"Activated abilities system — tap-for-mana, loyalty abilities, and general\n2\tactivated abilities that go on the stack (or resolve immediately for mana\n3\tabilities).\n4\t\n5\tProvides:\n6\t\n7\t- :func:`activate_ability` — verify timing → pay costs → resolve immediately\n8\t  (mana abilities) or push to the stack (non-mana abilities).\n9\t- :func:`tap_cost` — generic tap-cost helper: checks ``not source.is_tapped``\n10\t  and taps the source.\n11\t- :class:`ActivatedAbilityInstance` — a runtime representation of an activated\n12\t  ability with source, controller, cost/effect callables, and metadata.\n13\t- :class:`LoyaltyAbilityInstance` — activated ability variant for planeswalker\n14\t  loyalty abilities with per-turn restriction and loyalty-counter cost.\n15\t\"\"\"\n16\t\n17\tfrom __future__ import annotations\n18\t\n19\tfrom dataclasses import dataclass, field\n20\tfrom typing import TYPE_CHECKING, Any, Callable\n21\t\n22\tfrom engine.casting import is_sorcery_speed\n23\tfrom engine.stack import StackObject\n24\t\n25\tif TYPE_CHECKING:\n26\t    from engine.game_state import GameState\n27\t    from engine.player import Player\n28\t\n29\t\n30\tclass AbilityError(Exception):\n31\t    \"\"\"Raised when an ability activation is illegal.\"\"\"\n32\t\n33\t\n34\t# ---------------------------------------------------------------------------\n35\t# Runtime ability representations\n36\t# ---------------------------------------------------------------------------\n37\t\n38\t@dataclass\n39\tclass ActivatedAbilityInstance:\n40\t    \"\"\"Runtime representation of an activated ability.\n41\t\n42\t    This captures everything needed to activate and resolve an ability:\n43\t    the source permanent, the controlling player, cost/effect callables,\n44\t    and whether the ability is a mana ability.\n45\t\n46\t    Attributes:\n47\t        source: The permanent that has this ability.\n48\t        controller: The player who controls the source.\n49\t        cost: A callable ``(game, source) -> bool`` that checks and pays\n50\t            the cost. Returns ``True`` if the cost was successfully paid,\n51\t            ``False`` otherwise.\n52\t        effect: A callable ``(game) -> None`` that applies the ability's\n53\t            effect when it resolves.\n54\t        is_mana_ability: Whether this is a mana ability (resolves\n55\t            immediately without using the stack).\n56\t        description: Human-readable description of the ability.\n57\t    \"\"\"\n58\t\n59\t    source: Any\n60\t    controller: Any  # Player\n61\t    cost: Callable[..., bool]\n62\t    effect: Callable[..., None]\n63\t    is_mana_ability: bool = False\n64\t    description: str = \"\"\n65\t\n66\t\n67\t@dataclass\n68\tclass LoyaltyAbilityInstance:\n69\t    \"\"\"Runtime representation of a planeswalker loyalty ability.\n70\t\n71\t    Loyalty abilities are activated abilities with special restrictions:\n72\t    they may only be activated at sorcery speed, and only once per turn\n73\t    per source (tracked via ``_activated_this_turn``).\n74\t\n75\t    The cost adjusts the loyalty counters on the source planeswalker.\n76\t\n77\t    Attributes:\n78\t        source: The planeswalker permanent.\n79\t        controller: The player who controls the planeswalker.\n80\t        loyalty_cost: The loyalty adjustment (positive for ``+N``,\n81\t            negative for ``−N``, zero for ``0``).\n82\t        effect: A callable ``(game) -> None`` for the ability's effect.\n83\t        description: Human-readable description.\n84\t    \"\"\"\n85\t\n86\t    source: Any\n87\t    controller: Any  # Player\n88\t    loyalty_cost: int = 0\n89\t    effect: Callable[..., None] = field(default=lambda _game: None)\n90\t    description: str = \"\"\n91\t\n92\t\n93\t# ---------------------------------------------------------------------------\n94\t# Per-turn loyalty tracking\n95\t# ---------------------------------------------------------------------------\n96\t\n97\t# Set of (object_id, turn_number) pairs that have already activated a\n98\t# loyalty ability this turn.  Callers should call\n99\t# ``clear_loyalty_tracking()`` at the start of each turn or manage the\n100\t# set externally.\n101\t_loyalty_activated_this_turn: set[tuple[int, int]] = set()\n102\t\n103\t\n104\tdef clear_loyalty_tracking() -> None:\n105\t    \"\"\"Clear the loyalty-activated-this-turn tracker.\n106\t\n107\t    Should be called at the start of each turn so that planeswalkers may\n108\t    activate loyalty abilities again.\n109\t    \"\"\"\n110\t    _loyalty_activated_this_turn.clear()\n111\t\n112\t\n113\tdef _has_activated_loyalty_this_turn(source: Any, turn_number: int) -> bool:\n114\t    \"\"\"Return ``True`` if *source* already used a loyalty ability this turn.\"\"\"\n115\t    obj_id = getattr(source, \"object_id\", id(source))\n116\t    return (obj_id, turn_number) in _loyalty_activated_this_turn\n117\t\n118\t\n119\tdef _mark_loyalty_activated(source: Any, turn_number: int) -> None:\n120\t    \"\"\"Record that *source* used a loyalty ability this turn.\"\"\"\n121\t    obj_id = getattr(source, \"object_id\", id(source))\n122\t    _loyalty_activated_this_turn.add((obj_id, turn_number))\n123\t\n124\t\n125\t# ---------------------------------------------------------------------------\n126\t# Tap cost helper\n127\t# ---------------------------------------------------------------------------\n128\t\n129\tdef tap_cost(game: GameState, source: Any) -> bool:\n130\t    \"\"\"Generic tap-cost function.\n131\t\n132\t    Checks that the source is not already tapped.  If untapped, taps it\n133\t    (sets ``source.is_tapped = True``) and returns ``True``.  If already\n134\t    tapped, returns ``False`` (cost cannot be paid).\n135\t\n136\t    Parameters:\n137\t        game: The current game state (unused here but kept for a\n138\t            consistent ``(game, source) -> bool`` cost signature).\n139\t        source: The permanent to tap.\n140\t\n141\t    Returns:\n142\t        ``True`` if the cost was successfully paid (source was untapped\n143\t        and is now tapped), ``False`` otherwise.\n144\t    \"\"\"\n145\t    if getattr(source, \"is_tapped\", False):\n146\t        return False\n147\t    source.is_tapped = True\n148\t    return True\n149\t\n150\t\n151\t# ---------------------------------------------------------------------------\n152\t# Activate ability — main entry point\n153\t# ---------------------------------------------------------------------------\n154\t\n155\tdef activate_ability(\n156\t    game: GameState,\n157\t    player: Any,  # Player\n158\t    ability: ActivatedAbilityInstance | LoyaltyAbilityInstance,\n159\t) -> None:\n160\t    \"\"\"Activate an ability.\n161\t\n162\t    Pipeline\n163\t    --------\n164\t    1. **Timing check** — mana abilities bypass timing entirely and\n165\t       resolve immediately.  Regular (non-mana) activated abilities\n166\t       can be activated whenever a player has priority (instant speed);\n167\t       priority enforcement is handled externally by\n168\t       ``priority_loop``, not here.  **Only loyalty abilities** carry\n169\t       a sorcery-speed restriction.\n170\t    2. **Pay costs** — invoke the ability's cost callable.  For loyalty\n171\t       abilities, adjust loyalty counters and enforce once-per-turn.\n172\t    3. **Resolve or push to stack** — mana abilities resolve\n173\t       immediately; all other abilities are pushed onto the game stack\n174\t       as :class:`StackObject` instances.\n175\t\n176\t    Parameters:\n177\t        game: The current game state.\n178\t        player: The player activating the ability.\n179\t        ability: The ability to activate (an\n180\t            :class:`ActivatedAbilityInstance` or\n181\t            :class:`LoyaltyAbilityInstance`).\n182\t\n183\t    Raises:\n184\t        AbilityError: If the activation is illegal (timing, cost, or\n185\t            once-per-turn restriction).\n186\t    \"\"\"\n187\t    if isinstance(ability, LoyaltyAbilityInstance):\n188\t        _activate_loyalty_ability(game, player, ability)\n189\t    elif isinstance(ability, ActivatedAbilityInstance):\n190\t        _activate_regular_ability(game, player, ability)\n191\t    else:\n192\t        raise AbilityError(f\"Unknown ability type: {type(ability)}\")\n193\t\n194\t\n195\t# ---------------------------------------------------------------------------\n196\t# Internal helpers\n197\t# ---------------------------------------------------------------------------\n198\t\n199\tdef _activate_regular_ability(\n200\t    game: GameState,\n201\t    player: Any,\n202\t    ability: ActivatedAbilityInstance,\n203\t) -> None:\n204\t    \"\"\"Activate a regular (non-loyalty) activated ability.\"\"\"\n205\t    # 1. Check \"can't activate\" restriction (e.g. Arrest).\n206\t    if getattr(ability.source, \"_cant_activate\", False):\n207\t        raise AbilityError(\n208\t            \"Cannot activate ability — source's activated abilities are suppressed\"\n209\t        )\n210\t\n211\t    # 2. Pay costs\n212\t    cost_paid = ability.cost(game, ability.source)\n213\t    if not cost_paid:\n214\t        raise AbilityError(\"Cannot activate ability — cost could not be paid\")\n215\t\n216\t    # 3. Resolve or push\n217\t    if ability.is_mana_ability:\n218\t        # Mana abilities resolve immediately without using the stack.\n219\t        ability.effect(game)\n220\t    else:\n221\t        # Push to stack for resolution.\n222\t        stack_obj = StackObject(\n223\t            source=ability.source,\n224\t            controller=player,\n225\t            on_resolve=ability.effect,\n226\t            is_mana_ability=False,\n227\t        )\n228\t        game.stack.push(stack_obj)\n229\t\n230\t\n231\tdef _activate_loyalty_ability(\n232\t    game: GameState,\n233\t    player: Any,\n234\t    ability: LoyaltyAbilityInstance,\n235\t) -> None:\n236\t    \"\"\"Activate a planeswalker loyalty ability.\"\"\"\n237\t    source = ability.source\n238\t\n239\t    # 1. Timing — loyalty abilities are sorcery speed only.\n240\t    if not is_sorcery_speed(game, player):\n241\t        raise AbilityError(\n242\t            \"Cannot activate loyalty ability — sorcery-speed timing not met\"\n243\t        )\n244\t\n245\t    # 2. Once-per-turn restriction.\n246\t    turn_number = getattr(game, \"turn_number\", 0)\n247\t    if _has_activated_loyalty_this_turn(source, turn_number):\n248\t        raise AbilityError(\n249\t            \"Cannot activate loyalty ability — already activated this turn\"\n250\t        )\n251\t\n252\t    # 3. Pay loyalty cost.\n253\t    current_loyalty = getattr(source, \"loyalty\", 0)\n254\t    new_loyalty = current_loyalty + ability.loyalty_cost\n255\t    if new_loyalty < 0:\n256\t        raise AbilityError(\n257\t            f\"Cannot activate loyalty ability — insufficient loyalty \"\n258\t            f\"(have {current_loyalty}, need {-ability.loyalty_cost})\"\n259\t        )\n260\t    source.loyalty = new_loyalty\n261\t\n262\t    # 4. Mark as activated this turn.\n263\t    _mark_loyalty_activated(source, turn_number)\n264\t\n265\t    # 5. Push to stack.\n266\t    stack_obj = StackObject(\n267\t        source=source,\n268\t        controller=player,\n269\t        on_resolve=ability.effect,\n270\t        is_mana_ability=False,\n271\t    )\n272\t    game.stack.push(stack_obj)\n273\t"}]},"parent_tool_use_id":"toolu_0131x3Q5CoF8oe17FvLyvBg1","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"f1caff54-1afe-44e9-a1c4-ec78869750b1","timestamp":"2026-06-01T11:16:09.821Z","subagent_type":"Implementer","task_description":"Implement sos_97"}
