{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N45sWDTzdVkjgs2b5iYbZw","type":"tool_result","content":"1\t\"\"\"Tests for SOS 120 — Improvisation Capstone.\n2\t\n3\tImprovisation Capstone ({5}{R}{R} Sorcery — Lesson) has two pieces of\n4\tbehaviour:\n5\t\n6\t1. **Main effect** — \"Exile cards from the top of your library until you\n7\t   exile cards with total mana value 4 or greater. You may cast any number\n8\t   of spells from among them without paying their mana costs.\"\n9\t\n10\t2. **Paradigm** — \"Then exile this spell. After you first resolve a spell\n11\t   with this name, you may cast a copy of it from exile without paying its\n12\t   mana cost at the beginning of each of your first main phases.\"\n13\t\n14\tThese are TDD red-phase tests: the stub at ``card_impl.py`` is empty, so\n15\teverything here is expected to fail until the card is implemented.\n16\t\n17\tContract assumptions (mirroring established SOS conventions in\n18\t``cards/sos/sos_1`` and ``cards/sos/sos_57``):\n19\t\n20\t* The card exposes ``on_resolve(game)`` which reads its ``controller``.\n21\t* The main effect exiles cards off the top of the controller's library\n22\t  (``game.get_library`` — top is the last element) one at a time until the\n23\t  *total mana value* of the exiled cards reaches 4 or more.\n24\t* For each spell among the exiled cards, the controller is asked\n25\t  ``choose_yes_no`` whether to free-cast it (the \"you may cast any number\"\n26\t  clause).  Casting uses the engine free-cast pipeline (no mana paid).\n27\t\"\"\"\n28\t\n29\tfrom __future__ import annotations\n30\t\n31\tfrom typing import Any\n32\t\n33\tfrom cards.sos.sos_120.card_impl import ImprovisationCapstone\n34\tfrom engine.card import CardImpl, Creature, Instant, Sorcery\n35\tfrom engine.types import CardType, ManaCost, ManaType, Zone\n36\tfrom test_utils import create_game, set_board_state\n37\t\n38\t\n39\t# ---------------------------------------------------------------------------\n40\t# Helpers\n41\t# ---------------------------------------------------------------------------\n42\t\n43\t\n44\tdef _instant(name: str, cost: str) -> Instant:\n45\t    return Instant(name=name, mana_cost=ManaCost.parse(cost))\n46\t\n47\t\n48\tdef _sorcery(name: str, cost: str) -> Sorcery:\n49\t    return Sorcery(name=name, mana_cost=ManaCost.parse(cost))\n50\t\n51\t\n52\tdef _land(name: str = \"Mountain\") -> CardImpl:\n53\t    \"\"\"A zero-mana-value 'card' used to test mana-value accumulation.\"\"\"\n54\t    return CardImpl(name=name, mana_cost=ManaCost.parse(\"{0}\"), card_types={CardType.LAND})\n55\t\n56\t\n57\tdef _set_library_top_down(game: Any, player_index: int, top_down: list[Any]) -> None:\n58\t    \"\"\"Place *top_down* into the player's library so that ``top_down[0]`` is the\n59\t    top card.  The library's internal order is bottom->top (top == last element),\n60\t    so we add cards in reversed order.\n61\t    \"\"\"\n62\t    player = game.players[player_index]\n63\t    library = game.get_library(player)\n64\t    for obj in library.get_all():\n65\t        library.remove(obj)\n66\t    for obj in reversed(top_down):\n67\t        obj.owner = player\n68\t        obj.controller = player\n69\t        library.add(obj)  # default position=\"top\" appends to end\n70\t\n71\t\n72\tdef _capstone_on_battlefield_resolving(game: Any, controller: Any) -> ImprovisationCapstone:\n73\t    \"\"\"Return a Capstone whose controller is set, ready to call on_resolve.\"\"\"\n74\t    card = ImprovisationCapstone(owner=controller, controller=controller)\n75\t    return card\n76\t\n77\t\n78\t# ---------------------------------------------------------------------------\n79\t# Static card data\n80\t# ---------------------------------------------------------------------------\n81\t\n82\t\n83\tclass TestImprovisationCapstoneProperties:\n84\t    def test_name(self) -> None:\n85\t        assert ImprovisationCapstone(owner=None).name == \"Improvisation Capstone\"\n86\t\n87\t    def test_is_sorcery(self) -> None:\n88\t        card = ImprovisationCapstone(owner=None)\n89\t        assert isinstance(card, Sorcery)\n90\t        assert CardType.SORCERY in card.card_types\n91\t\n92\t    def test_mana_cost(self) -> None:\n93\t        card = ImprovisationCapstone(owner=None)\n94\t        assert card.mana_cost == ManaCost.parse(\"{5}{R}{R}\")\n95\t\n96\t    def test_mana_value_is_seven(self) -> None:\n97\t        assert ImprovisationCapstone(owner=None).mana_cost.cmc == 7\n98\t\n99\t    def test_is_lesson(self) -> None:\n100\t        assert \"Lesson\" in ImprovisationCapstone(owner=None).subtypes\n101\t\n102\t    def test_is_red(self) -> None:\n103\t        from engine.types import Color\n104\t\n105\t        assert Color.RED in ImprovisationCapstone(owner=None).colors\n106\t\n107\t    def test_not_a_creature(self) -> None:\n108\t        card = ImprovisationCapstone(owner=None)\n109\t        assert CardType.CREATURE not in card.card_types\n110\t\n111\t    def test_rules_text_mentions_paradigm(self) -> None:\n112\t        text = ImprovisationCapstone(owner=None).rules_text.lower()\n113\t        assert \"paradigm\" in text\n114\t\n115\t\n116\t# ---------------------------------------------------------------------------\n117\t# Main effect: exile from top until total mana value >= 4\n118\t# ---------------------------------------------------------------------------\n119\t\n120\t\n121\tclass TestImprovisationCapstoneExileUntilFour:\n122\t    \"\"\"Resolving the spell exiles cards off the top of the library until the\n123\t    cumulative mana value of the exiled cards is 4 or greater.\"\"\"\n124\t\n125\t    def test_exiles_until_total_mana_value_at_least_four(self) -> None:\n126\t        # Top-down: three {2} cards. After the first two (2+2=4) the threshold\n127\t        # is met, so exactly two cards should be exiled.\n128\t        game = create_game(scripts=([False, False, False], []))\n129\t        p1 = game.players[0]\n130\t        a = _sorcery(\"Two A\", \"{2}\")\n131\t        b = _sorcery(\"Two B\", \"{2}\")\n132\t        c = _sorcery(\"Two C\", \"{2}\")\n133\t        _set_library_top_down(game, 0, [a, b, c])\n134\t        card = _capstone_on_battlefield_resolving(game, p1)\n135\t\n136\t        card.on_resolve(game)\n137\t\n138\t        exile = game.get_exile(p1)\n139\t        assert exile.contains(a)\n140\t        assert exile.contains(b)\n141\t        assert not exile.contains(c), \"should stop once total MV reaches 4\"\n142\t\n143\t    def test_stops_as_soon_as_threshold_reached_single_big_card(self) -> None:\n144\t        # A single {4} card meets the threshold by itself; only one exiled.\n145\t        game = create_game(scripts=([False], []))\n146\t        p1 = game.players[0]\n147\t        big = _sorcery(\"Big Four\", \"{4}\")\n148\t        rest = _sorcery(\"Untouched\", \"{1}\")\n149\t        _set_library_top_down(game, 0, [big, rest])\n150\t        card = _capstone_on_battlefield_resolving(game, p1)\n151\t\n152\t        card.on_resolve(game)\n153\t\n154\t        exile = game.get_exile(p1)\n155\t        assert exile.contains(big)\n156\t        assert not exile.contains(rest)\n157\t\n158\t    def test_exact_threshold_of_four_stops(self) -> None:\n159\t        # Top card has MV exactly 4 -> exiled; the next card is left alone.\n160\t        game = create_game(scripts=([False], []))\n161\t        p1 = game.players[0]\n162\t        four = _instant(\"Exactly Four\", \"{3}{R}\")\n163\t        nxt = _instant(\"Next\", \"{1}\")\n164\t        _set_library_top_down(game, 0, [four, nxt])\n165\t        card = _capstone_on_battlefield_resolving(game, p1)\n166\t\n167\t        card.on_resolve(game)\n168\t\n169\t        exile = game.get_exile(p1)\n170\t        assert exile.contains(four)\n171\t        assert not exile.contains(nxt)\n172\t\n173\t    def test_zero_mana_value_cards_do_not_satisfy_threshold(self) -> None:\n174\t        # Three zero-MV lands then a {4}: must keep exiling past the lands\n175\t        # until the cumulative MV reaches 4.\n176\t        game = create_game(scripts=([False], []))\n177\t        p1 = game.players[0]\n178\t        l1 = _land(\"Land A\")\n179\t        l2 = _land(\"Land B\")\n180\t        l3 = _land(\"Land C\")\n181\t        payoff = _sorcery(\"Payoff\", \"{4}\")\n182\t        tail = _sorcery(\"Tail\", \"{1}\")\n183\t        _set_library_top_down(game, 0, [l1, l2, l3, payoff, tail])\n184\t        card = _capstone_on_battlefield_resolving(game, p1)\n185\t\n186\t        card.on_resolve(game)\n187\t\n188\t        exile = game.get_exile(p1)\n189\t        assert exile.contains(l1)\n190\t        assert exile.contains(l2)\n191\t        assert exile.contains(l3)\n192\t        assert exile.contains(payoff), \"must keep exiling until MV>=4 is reached\"\n193\t        assert not exile.contains(tail)\n194\t\n195\t    def test_exiled_cards_leave_the_library(self) -> None:\n196\t        game = create_game(scripts=([False, False], []))\n197\t        p1 = game.players[0]\n198\t        a = _sorcery(\"Two A\", \"{2}\")\n199\t        b = _sorcery(\"Two B\", \"{2}\")\n200\t        keep = _sorcery(\"Stay\", \"{1}\")\n201\t        _set_library_top_down(game, 0, [a, b, keep])\n202\t        card = _capstone_on_battlefield_resolving(game, p1)\n203\t\n204\t        card.on_resolve(game)\n205\t\n206\t        library = game.get_library(p1)\n207\t        assert not library.contains(a)\n208\t        assert not library.contains(b)\n209\t        assert library.contains(keep), \"untouched cards remain in the library\"\n210\t\n211\t    def test_empty_library_is_safe_noop(self) -> None:\n212\t        # No cards to exile -> resolving must not raise and must not prompt.\n213\t        game = create_game(scripts=([], []))\n214\t        p1 = game.players[0]\n215\t        _set_library_top_down(game, 0, [])\n216\t        card = _capstone_on_battlefield_resolving(game, p1)\n217\t\n218\t        card.on_resolve(game)  # must not raise / must not consume a script entry\n219\t\n220\t        assert len(game.get_exile(p1)) == 0\n221\t\n222\t    def test_library_smaller_than_threshold_exiles_all(self) -> None:\n223\t        # Only one {2} card in the library; threshold never reached but the\n224\t        # effect exiles what it can and stops (no infinite loop / no crash).\n225\t        game = create_game(scripts=([False], []))\n226\t        p1 = game.players[0]\n227\t        only = _sorcery(\"Only\", \"{2}\")\n228\t        _set_library_top_down(game, 0, [only])\n229\t        card = _capstone_on_battlefield_resolving(game, p1)\n230\t\n231\t        card.on_resolve(game)\n232\t\n233\t        assert game.get_exile(p1).contains(only)\n234\t        assert len(game.get_library(p1)) == 0\n235\t\n236\t\n237\t# ---------------------------------------------------------------------------\n238\t# Main effect: optional free cast of exiled spells\n239\t# ---------------------------------------------------------------------------\n240\t\n241\t\n242\tclass TestImprovisationCapstoneFreeCast:\n243\t    \"\"\"The controller \"may cast any number of spells from among\" the exiled\n244\t    cards without paying their mana costs.\"\"\"\n245\t\n246\t    def test_yes_casts_an_exiled_spell_onto_the_stack(self) -> None:\n247\t        # One {4} spell exiled; controller says \"yes\" to casting it.\n248\t        game = create_game(scripts=([True], []))\n249\t        p1 = game.players[0]\n250\t        game.active_player_index = 0\n251\t        spell = _sorcery(\"Free Cast Me\", \"{4}\")\n252\t        _set_library_top_down(game, 0, [spell])\n253\t        card = _capstone_on_battlefield_resolving(game, p1)\n254\t\n255\t        card.on_resolve(game)\n256\t\n257\t        # The spell should have moved out of exile onto the stack (free cast).\n258\t        assert p1.zones[Zone.STACK].contains(spell)\n259\t        assert not game.get_exile(p1).contains(spell)\n260\t\n261\t    def test_free_cast_pays_no_mana(self) -> None:\n262\t        game = create_game(scripts=([True], []))\n263\t        p1 = game.players[0]\n264\t        game.active_player_index = 0\n265\t        p1.mana_pool.empty()\n266\t        spell = _sorcery(\"Free Cast Me\", \"{4}\")\n267\t        _set_library_top_down(game, 0, [spell])\n268\t        card = _capstone_on_battlefield_resolving(game, p1)\n269\t\n270\t        card.on_resolve(game)\n271\t\n272\t        # The spell was actually cast (left exile, now on the stack) ...\n273\t        assert p1.zones[Zone.STACK].contains(spell), \"the exiled spell should be cast\"\n274\t        assert not game.get_exile(p1).contains(spell)\n275\t        # ... and no mana was spent or produced doing so.\n276\t        assert p1.mana_pool.total() == 0, \"casting from among exile must pay no mana\"\n277\t\n278\t    def test_no_casts_leaves_spell_in_exile(self) -> None:\n279\t        # Declining the optional cast leaves the exiled card in exile.\n280\t        game = create_game(scripts=([False], []))\n281\t        p1 = game.players[0]\n282\t        spell = _sorcery(\"Decline Me\", \"{4}\")\n283\t        _set_library_top_down(game, 0, [spell])\n284\t        card = _capstone_on_battlefield_resolving(game, p1)\n285\t\n286\t        card.on_resolve(game)\n287\t\n288\t        assert game.get_exile(p1).contains(spell)\n289\t        assert game.stack.is_empty()\n290\t\n291\t    def test_can_cast_multiple_exiled_spells(self) -> None:\n292\t        # Two {2} spells exiled (total MV 4). Saying yes to both casts both.\n293\t        game = create_game(scripts=([True, True], []))\n294\t        p1 = game.players[0]\n295\t        game.active_player_index = 0\n296\t        s1 = _sorcery(\"Spell One\", \"{2}\")\n297\t        s2 = _sorcery(\"Spell Two\", \"{2}\")\n298\t        _set_library_top_down(game, 0, [s1, s2])\n299\t        card = _capstone_on_battlefield_resolving(game, p1)\n300\t\n301\t        card.on_resolve(game)\n302\t\n303\t        library = game.get_library(p1)\n304\t        exile = game.get_exile(p1)\n305\t        # Both were exiled off the top (so they left the library) ...\n306\t        assert not library.contains(s1)\n307\t        assert not library.contains(s2)\n308\t        # ... and both were cast (left exile); neither remains in exile.\n309\t        assert not exile.contains(s1)\n310\t        assert not exile.contains(s2)\n311\t        # At least one of them should be observable on the stack as a cast spell.\n312\t        on_stack = [\n313\t            obj for obj in p1.zones[Zone.STACK].get_all() if obj in (s1, s2)\n314\t        ]\n315\t        assert len(on_stack) >= 1, \"casting multiple spells should put them on the stack\"\n316\t\n317\t    def test_lands_among_exiled_cards_are_not_offered_as_spells(self) -> None:\n318\t        # \"cast any number of spells\" — lands are not spells, so a land among\n319\t        # the exiled cards must not consume a yes/no prompt and stays in exile.\n320\t        # Script has a single entry for the one castable spell.\n321\t        game = create_game(scripts=([True], []))\n322\t        p1 = game.players[0]\n323\t        game.active_player_index = 0\n324\t        land = _land(\"Exiled Land\")\n325\t        spell = _sorcery(\"Payoff Spell\", \"{4}\")\n326\t        _set_library_top_down(game, 0, [land, spell])\n327\t        card = _capstone_on_battlefield_resolving(game, p1)\n328\t\n329\t        card.on_resolve(game)\n330\t\n331\t        exile = game.get_exile(p1)\n332\t        # The land cannot be cast and remains exiled; the spell was cast.\n333\t        assert exile.contains(land)\n334\t        assert not exile.contains(spell)\n335\t\n336\t\n337\t# ---------------------------------------------------------------------------\n338\t# Paradigm: the spell exiles itself instead of going to the graveyard\n339\t# ---------------------------------------------------------------------------\n340\t\n341\t\n342\tclass TestImprovisationCapstoneParadigmSelfExile:\n343\t    \"\"\"Paradigm: \"Then exile this spell.\" — after resolving, the Capstone\n344\t    itself is exiled rather than put into the graveyard, so it can be\n345\t    recast later from exile.\"\"\"\n346\t\n347\t    def test_resolved_capstone_is_exiled_not_in_graveyard(self) -> None:\n348\t        # Drive a full free-cast resolution through the engine pipeline so the\n349\t        # stack->zone move happens, then assert the spell ends up in exile.\n350\t        from engine.casting import cast_spell_free\n351\t\n352\t        game = create_game(scripts=([False], []))\n353\t        p1 = game.players[0]\n354\t        game.active_player_index = 0\n355\t        # Put a single low-value card in the library so resolution is simple.\n356\t        filler = _sorcery(\"Filler\", \"{4}\")\n357\t        _set_library_top_down(game, 0, [filler])\n358\t\n359\t        card = ImprovisationCapstone(owner=p1, controller=p1)\n360\t        # Place the Capstone in the hand and free-cast it so the engine routes\n361\t        # its stack->graveyard move through replacement effects (Paradigm\n362\t        # should redirect it to exile).\n363\t        set_board_state(game, 0, hand=[card])\n364\t        card.register_replacement_effects(game)\n365\t        cast_spell_free(game, p1, card, Zone.HAND)\n366\t        # Resolve the Capstone spell itself.\n367\t        stack_obj = game.stack.pop()\n368\t        stack_obj.on_resolve(game)\n369\t\n370\t        assert game.get_exile(p1).contains(card), (\n371\t            \"Paradigm should exile the spell instead of sending it to the graveyard\"\n372\t        )\n373\t        assert not game.get_graveyard(p1).contains(card)\n374\t\n375\t\n376\t# ---------------------------------------------------------------------------\n377\t# Paradigm: recast a copy at the beginning of each first main phase\n378\t# ---------------------------------------------------------------------------\n379\t\n380\t\n381\tclass TestImprovisationCapstoneParadigmRecast:\n382\t    \"\"\"Paradigm sets up a begin-of-(first)-main-phase trigger that lets the\n383\t    controller cast a copy of the spell from exile for free.  Following the\n384\t    sos_57 convention, the delayed/recurring ability is wired through the\n385\t    trigger manager keyed to ``BeginningOfMainPhaseTriggeredEvent``.\"\"\"\n386\t\n387\t    def test_resolution_registers_a_begin_of_main_phase_trigger(self) -> None:\n388\t        from engine.events import BeginningOfMainPhaseTriggeredEvent\n389\t\n390\t        game = create_game(scripts=([False], []))\n391\t        p1 = game.players[0]\n392\t        game.active_player_index = 0\n393\t        filler = _sorcery(\"Filler\", \"{4}\")\n394\t        _set_library_top_down(game, 0, [filler])\n395\t        card = _capstone_on_battlefield_resolving(game, p1)\n396\t\n397\t        before = len(game.trigger_manager.get_triggers_for_source(card))\n398\t        card.on_resolve(game)\n399\t        regs = game.trigger_manager.get_triggers_for_source(card)\n400\t        after = len(regs)\n401\t\n402\t        assert after - before >= 1, \"Paradigm must register a recurring trigger\"\n403\t        assert any(\n404\t            r.event_type is BeginningOfMainPhaseTriggeredEvent for r in regs\n405\t        ), \"the Paradigm trigger must watch BeginningOfMainPhaseTriggeredEvent\"\n406\t\n407\t    def test_paradigm_trigger_controller_is_the_capstone_controller(self) -> None:\n408\t        from engine.events import BeginningOfMainPhaseTriggeredEvent\n409\t\n410\t        game = create_game(scripts=([False], []))\n411\t        p1 = game.players[0]\n412\t        game.active_player_index = 0\n413\t        filler = _sorcery(\"Filler\", \"{4}\")\n414\t        _set_library_top_down(game, 0, [filler])\n415\t        card = _capstone_on_battlefield_resolving(game, p1)\n416\t\n417\t        card.on_resolve(game)\n418\t        regs = [\n419\t            r\n420\t            for r in game.trigger_manager.get_triggers_for_source(card)\n421\t            if r.event_type is BeginningOfMainPhaseTriggeredEvent\n422\t        ]\n423\t        assert regs, \"expected a begin-of-main-phase trigger\"\n424\t        assert regs[0].controller is p1\n425\t\n426\t    def test_paradigm_trigger_only_fires_for_controllers_main_phase(self) -> None:\n427\t        # The trigger condition must reject another player's main phase\n428\t        # (\"the beginning of each of your first main phases\").\n429\t        from engine.events import BeginningOfMainPhaseTriggeredEvent\n430\t        from engine.types import Phase\n431\t\n432\t        game = create_game(scripts=([False], []))\n433\t        p1 = game.players[0]\n434\t        p2 = game.players[1]\n435\t        game.active_player_index = 0\n436\t        filler = _sorcery(\"Filler\", \"{4}\")\n437\t        _set_library_top_down(game, 0, [filler])\n438\t        card = _capstone_on_battlefield_resolving(game, p1)\n439\t\n440\t        card.on_resolve(game)\n441\t        regs = [\n442\t            r\n443\t            for r in game.trigger_manager.get_triggers_for_source(card)\n444\t            if r.event_type is BeginningOfMainPhaseTriggeredEvent\n445\t        ]\n446\t        assert regs, \"expected a begin-of-main-phase trigger\"\n447\t        reg = regs[0]\n448\t        if reg.condition is None:\n449\t            raise AssertionError(\n450\t                \"Paradigm trigger must be conditioned on the controller's main phase\"\n451\t            )\n452\t        opp_event = BeginningOfMainPhaseTriggeredEvent(\n453\t            player=p2, phase=Phase.PRECOMBAT_MAIN\n454\t        )\n455\t        assert reg.condition(game, opp_event) is False\n456\t"}]},"parent_tool_use_id":"toolu_01FtrFyqD3oNPonppRCGoUAu","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"1d48c144-0622-4057-857a-9266b5cb3fb1","timestamp":"2026-06-01T11:26:53.515Z","subagent_type":"Implementer","task_description":"Implement sos_120"}
