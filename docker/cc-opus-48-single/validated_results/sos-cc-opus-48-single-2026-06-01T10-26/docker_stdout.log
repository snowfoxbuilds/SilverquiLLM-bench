{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01PensCJGZKdCyE3Qk7ZSgMj","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01FpLdwgpS433QPY9kRGiTZ1","name":"Read","input":{"file_path":"/workspace/engine/casting.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8331,"cache_read_input_tokens":26772,"cache_creation":{"ephemeral_5m_input_tokens":8331,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01VHujhzSrizXureD9tNErgr","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"bec54e2f-a757-4ea8-b4bb-db7231cfd704","request_id":"req_011CbcVJLy9SV9duBwHkRXhS","subagent_type":"Tester","task_description":"Write tests for sos_226"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FpLdwgpS433QPY9kRGiTZ1","type":"tool_result","content":"1\t\"\"\"Casting and resolution pipeline for spells and lands.\n2\t\n3\tProvides the full flow from casting a spell or playing a land through\n4\tresolution:\n5\t\n6\t- :func:`cast_spell` — verify timing & legality → move hand to stack →\n7\t  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n8\t- :func:`play_land` — verify land play remaining → move hand to\n9\t  battlefield → decrement ``land_plays_remaining``.\n10\t- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n11\t  helpers used by the casting pipeline.\n12\t\n13\tResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\n14\tcreated by :func:`cast_spell`:\n15\t\n16\t- Call ``card.on_resolve(game)``.\n17\t- Permanents (creature / enchantment / artifact / planeswalker) move from\n18\t  the stack to the battlefield.\n19\t- Non-permanents (instant / sorcery) move to the graveyard.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import TYPE_CHECKING, Any\n25\t\n26\tfrom engine.card import CardImpl\n27\tfrom engine.stack import StackObject\n28\tfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\n29\tfrom engine.zones import move_zone\n30\t\n31\tif TYPE_CHECKING:\n32\t    from engine.game_state import GameState\n33\t    from engine.player import Player\n34\t\n35\t\n36\t# Card types that represent permanents — these go to the battlefield on resolve.\n37\t_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n38\t    CardType.CREATURE,\n39\t    CardType.ENCHANTMENT,\n40\t    CardType.ARTIFACT,\n41\t    CardType.PLANESWALKER,\n42\t})\n43\t\n44\t\n45\tclass CastingError(Exception):\n46\t    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n47\t\n48\t\n49\t# ------------------------------------------------------------------\n50\t# Timing helpers\n51\t# ------------------------------------------------------------------\n52\t\n53\tdef is_sorcery_speed(game: GameState, player: Player) -> bool:\n54\t    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n55\t\n56\t    Sorcery speed requires all of:\n57\t\n58\t    * *player* is the active player.\n59\t    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n60\t      ``POSTCOMBAT_MAIN``).\n61\t    * The stack is empty.\n62\t    \"\"\"\n63\t    if player is not game.active_player:\n64\t        return False\n65\t    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n66\t        return False\n67\t    if not game.stack.is_empty():\n68\t        return False\n69\t    return True\n70\t\n71\t\n72\tdef can_cast_at_instant_speed(card: CardImpl) -> bool:\n73\t    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n74\t\n75\t    A card has instant-speed timing if it is an instant or has the\n76\t    :attr:`~engine.types.Keyword.FLASH` keyword.\n77\t    \"\"\"\n78\t    if CardType.INSTANT in card.card_types:\n79\t        return True\n80\t    if Keyword.FLASH & card.keywords:\n81\t        return True\n82\t    return False\n83\t\n84\t\n85\t# ------------------------------------------------------------------\n86\t# Cost reduction\n87\t# ------------------------------------------------------------------\n88\t\n89\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n90\t    \"\"\"Return the generic mana reduction for casting *card*.\n91\t\n92\t    Queries ``card.cost_reduction(game)`` and clamps the result so that\n93\t    the generic portion of the mana cost cannot go below 0.\n94\t\n95\t    This is a simplified single-card self-reduction model.  Full MTG\n96\t    cost-reduction interactions (Trinisphere, multiple reductions from\n97\t    different sources) are deferred.\n98\t    \"\"\"\n99\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n100\t    # casting player even when the card was never explicitly assigned one.\n101\t    prev_controller = card.controller\n102\t    card.controller = controller\n103\t    raw = card.cost_reduction(game)\n104\t    # Restore previous controller in case the caller doesn't want a\n105\t    # side-effect (get_cost_reduction is a query, not a mutation).\n106\t    card.controller = prev_controller\n107\t    generic = card.mana_cost.generic if card.mana_cost else 0\n108\t    return max(0, min(raw, generic))\n109\t\n110\t\n111\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n112\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n113\t    new_generic = max(0, cost.generic - reduction)\n114\t    return ManaCost(\n115\t        generic=new_generic,\n116\t        pips=dict(cost.pips),\n117\t        x_count=cost.x_count,\n118\t        hybrid=list(cost.hybrid),\n119\t    )\n120\t\n121\t\n122\t# ------------------------------------------------------------------\n123\t# Cast spell\n124\t# ------------------------------------------------------------------\n125\t\n126\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n127\t    \"\"\"Cast *card* from *player*'s hand.\n128\t\n129\t    Pipeline\n130\t    --------\n131\t    1. **Timing check** — instants (and cards with flash) can be cast\n132\t       whenever the player has priority; everything else requires\n133\t       sorcery-speed timing.\n134\t    2. **can_cast** — ask the card whether it can legally be cast.\n135\t    3. **Hand check** — the card must be in the player's hand.\n136\t    4. **Move hand → stack zone** — remove the card from the hand and\n137\t       place it into the player's stack zone.\n138\t    5. **Choose targets** — if the card specifies targets (via\n139\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n140\t    6. **Mana check / payment** — the player's mana pool must be able to\n141\t       pay the card's mana cost.  If payment fails, the card is rolled\n142\t       back from the stack zone to the hand.\n143\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n144\t    8. **Push StackObject** — push a :class:`StackObject` whose\n145\t       ``on_resolve`` callback handles resolution.\n146\t\n147\t    Raises:\n148\t        CastingError: If any legality check fails.\n149\t    \"\"\"\n150\t    # 1. Timing\n151\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n152\t        raise CastingError(\n153\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n154\t        )\n155\t\n156\t    # 2. can_cast\n157\t    if not card.can_cast(game):\n158\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n159\t\n160\t    # 3. Hand check\n161\t    hand = game.get_hand(player)\n162\t    if not hand.contains(card):\n163\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n164\t\n165\t    # 4. Move card from hand to stack zone\n166\t    stack_zone = player.zones[Zone.STACK]\n167\t    hand.remove(card)\n168\t    stack_zone.add(card)\n169\t\n170\t    # Clear any stale colors_spent from a prior cast before new payment.\n171\t    if hasattr(card, \"colors_spent\"):\n172\t        del card.colors_spent\n173\t\n174\t    # 5. Choose targets\n175\t    target_specs = card.get_targets(game)\n176\t    chosen_targets: list[Any] = []\n177\t    if target_specs:\n178\t        for spec in target_specs:\n179\t            target = player.choose_target(target_specs, spec)\n180\t            # Validate against filter_fn if the spec provides one\n181\t            filter_fn = getattr(spec, \"filter_fn\", None)\n182\t            if filter_fn is not None and target is not None:\n183\t                if not filter_fn(target):\n184\t                    stack_zone.remove(card)\n185\t                    hand.add(card)\n186\t                    raise CastingError(\n187\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n188\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n189\t                    )\n190\t            chosen_targets.append(target)\n191\t\n192\t    # 5b. Protection check — reject targets that have protection from this\n193\t    #     spell (the T in DEBT).\n194\t    from engine.protection import has_protection_from\n195\t\n196\t    for target in chosen_targets:\n197\t        if has_protection_from(target, card):\n198\t            # Rollback: move card from stack zone back to hand\n199\t            stack_zone.remove(card)\n200\t            hand.add(card)\n201\t            raise CastingError(\n202\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n203\t            )\n204\t\n205\t    # Targets are stored on the StackObject (not the card) and passed\n206\t    # through the resolve pipeline via on_resolve(game, targets=...).\n207\t\n208\t    # 6. Mana check / payment (rollback on failure)\n209\t    # Ensure the card knows its controller so that cost_reduction() hooks\n210\t    # (e.g. Embercleave counting attacking creatures you control) see the\n211\t    # casting player, even for cards that were added to hand without an\n212\t    # explicit controller assignment.\n213\t    if card.controller is None:\n214\t        card.controller = player\n215\t    reduction = get_cost_reduction(game, card, player)\n216\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n217\t\n218\t    if not player.mana_pool.can_pay(effective_cost):\n219\t        # Rollback: move card from stack zone back to hand\n220\t        stack_zone.remove(card)\n221\t        hand.add(card)\n222\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n223\t\n224\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n225\t    player.mana_pool.pay(effective_cost)\n226\t\n227\t    # Store colors of mana spent on the card for mechanics like Converge\n228\t    # that care about the colors used to cast the spell.\n229\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n230\t\n231\t    # Record the TOTAL amount of mana spent to cast this spell (rule 107.7).\n232\t    # Unlike the printed mana value, this reflects actual mana paid, so X\n233\t    # spells / cost-reduced spells diverge from CMC.  Effects such as Mana\n234\t    # Sculpt read this at resolution.\n235\t    card.mana_spent = player.mana_pool.last_payment_total  # type: ignore[attr-defined]\n236\t\n237\t    # 7. Call on_cast hook\n238\t    card.on_cast(game)\n239\t\n240\t    # 8. Build on_resolve callback and push StackObject\n241\t    stack_obj = StackObject(\n242\t        source=card,\n243\t        controller=player,\n244\t        targets=chosen_targets,\n245\t        on_resolve=lambda g: None,  # replaced below\n246\t    )\n247\t\n248\t    def _on_resolve(g: GameState) -> None:\n249\t        _resolve_spell(g, card, player, stack_obj)\n250\t\n251\t    stack_obj.on_resolve = _on_resolve\n252\t    game.stack.push(stack_obj)\n253\t\n254\t\n255\t# ------------------------------------------------------------------\n256\t# Cast spell without paying mana cost (free-cast from any zone)\n257\t# ------------------------------------------------------------------\n258\t\n259\t\n260\tdef cast_spell_free(\n261\t    game: GameState,\n262\t    player: Player,\n263\t    card: CardImpl,\n264\t    from_zone: Zone,\n265\t) -> None:\n266\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n267\t\n268\t    This is used by effects that allow casting from zones other than hand\n269\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n270\t    or cascade.\n271\t\n272\t    Pipeline\n273\t    --------\n274\t    1. **can_cast** — ask the card whether it can legally be cast (same\n275\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n276\t    2. Move *card* from *from_zone* to the stack zone.\n277\t    3. Choose targets (if applicable) with validation and protection check.\n278\t    4. Call ``on_cast`` hook.\n279\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n280\t       resolution normally (permanents → battlefield, non-permanents →\n281\t       graveyard).\n282\t\n283\t    No timing check or mana payment is performed.  The spell goes on the\n284\t    stack and can be responded to normally (e.g. countered).\n285\t\n286\t    If targeting or other post-move checks fail, the card is rolled back\n287\t    to its source zone.\n288\t\n289\t    Parameters:\n290\t        game: The current game state.\n291\t        player: The player casting the spell.\n292\t        card: The card to cast.\n293\t        from_zone: The zone the card is currently in.\n294\t\n295\t    Raises:\n296\t        CastingError: If the card cannot be found in *from_zone* or\n297\t            legality checks fail.\n298\t    \"\"\"\n299\t    from engine.zones import move_to_zone\n300\t\n301\t    # Ensure controller is set\n302\t    card.controller = player\n303\t    if card.owner is None:\n304\t        card.owner = player\n305\t\n306\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n307\t    if not card.can_cast(game):\n308\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n309\t\n310\t    # 2. Locate card in source zone\n311\t    source_zone_container = player.zones[from_zone]\n312\t    if not source_zone_container.contains(card):\n313\t        # Try to find the card in any player's zone\n314\t        source_zone_container = None\n315\t        for p in game.players:\n316\t            z = p.zones[from_zone]\n317\t            if z.contains(card):\n318\t                source_zone_container = z\n319\t                break\n320\t\n321\t    if source_zone_container is None or not source_zone_container.contains(card):\n322\t        raise CastingError(\n323\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n324\t        )\n325\t\n326\t    # Move card from source zone to stack zone\n327\t    stack_zone = player.zones[Zone.STACK]\n328\t    source_zone_container.remove(card)\n329\t    stack_zone.add(card)\n330\t\n331\t    # 3. Choose targets (with rollback on failure)\n332\t    try:\n333\t        target_specs = card.get_targets(game)\n334\t        chosen_targets: list[Any] = []\n335\t        if target_specs:\n336\t            for spec in target_specs:\n337\t                target = player.choose_target(target_specs, spec)\n338\t                # Validate against filter_fn if the spec provides one\n339\t                filter_fn = getattr(spec, \"filter_fn\", None)\n340\t                if filter_fn is not None and target is not None:\n341\t                    if not filter_fn(target):\n342\t                        raise CastingError(\n343\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n344\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n345\t                        )\n346\t                chosen_targets.append(target)\n347\t\n348\t        # Protection check — reject targets that have protection from this spell\n349\t        from engine.protection import has_protection_from\n350\t\n351\t        for target in chosen_targets:\n352\t            if has_protection_from(target, card):\n353\t                raise CastingError(\n354\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n355\t                )\n356\t    except Exception as exc:\n357\t        # Rollback: move card from stack zone back to source zone\n358\t        stack_zone.remove(card)\n359\t        source_zone_container.add(card)\n360\t        raise CastingError(str(exc)) from exc\n361\t\n362\t    # 4. Call on_cast hook\n363\t    card.on_cast(game)\n364\t\n365\t    # 5. Build on_resolve callback and push StackObject\n366\t    stack_obj = StackObject(\n367\t        source=card,\n368\t        controller=player,\n369\t        targets=chosen_targets,\n370\t        on_resolve=lambda g: None,  # replaced below\n371\t    )\n372\t\n373\t    def _on_resolve(g: GameState) -> None:\n374\t        _resolve_spell(g, card, player, stack_obj)\n375\t\n376\t    stack_obj.on_resolve = _on_resolve\n377\t    game.stack.push(stack_obj)\n378\t\n379\t\n380\t# ------------------------------------------------------------------\n381\t# Cast spell paying an alternative cost (e.g. miracle)\n382\t# ------------------------------------------------------------------\n383\t\n384\t\n385\tdef cast_spell_alternative(\n386\t    game: GameState,\n387\t    player: Player,\n388\t    card: CardImpl,\n389\t    alternative_cost: ManaCost,\n390\t    from_zone: Zone = Zone.HAND,\n391\t) -> None:\n392\t    \"\"\"Cast *card* paying *alternative_cost* instead of its mana cost.\n393\t\n394\t    Used by alternative-cost mechanics such as **miracle** (rule 702.94),\n395\t    where the spell is cast \"by paying [cost] rather than its mana cost\".\n396\t    The alternative cost is paid as a normal mana cost from *player*'s pool.\n397\t\n398\t    Unlike :func:`cast_spell` this skips the normal sorcery-speed/instant\n399\t    timing check (miracle casts happen at draw time, outside normal timing),\n400\t    but otherwise mirrors the cast pipeline: ``can_cast`` legality, target\n401\t    choice/validation, mana payment (with rollback on failure), the\n402\t    ``on_cast`` hook, and pushing a resolving :class:`StackObject`.\n403\t\n404\t    Note: cost reduction (``get_cost_reduction``) is intentionally NOT applied\n405\t    to *alternative_cost* — unlike :func:`cast_spell`, an alternative cost such\n406\t    as miracle is paid exactly as printed.  Callers that want a reduction on an\n407\t    alternative cost must fold it into *alternative_cost* before calling.\n408\t\n409\t    Parameters:\n410\t        game: The current game state.\n411\t        player: The player casting the spell.\n412\t        card: The card to cast (must be in *from_zone*).\n413\t        alternative_cost: The :class:`ManaCost` to pay instead of\n414\t            ``card.mana_cost``.\n415\t        from_zone: The zone the card is currently in (default hand).\n416\t\n417\t    Raises:\n418\t        CastingError: If any legality check fails or mana cannot be paid.\n419\t    \"\"\"\n420\t    if card.controller is None:\n421\t        card.controller = player\n422\t    if card.owner is None:\n423\t        card.owner = player\n424\t\n425\t    # can_cast legality (timing is intentionally skipped for miracle casts).\n426\t    if not card.can_cast(game):\n427\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n428\t\n429\t    source_zone = player.zones[from_zone]\n430\t    if not source_zone.contains(card):\n431\t        raise CastingError(\n432\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n433\t        )\n434\t\n435\t    stack_zone = player.zones[Zone.STACK]\n436\t    source_zone.remove(card)\n437\t    stack_zone.add(card)\n438\t\n439\t    if hasattr(card, \"colors_spent\"):\n440\t        del card.colors_spent\n441\t\n442\t    # Choose targets (with rollback to the source zone on failure).\n443\t    try:\n444\t        target_specs = card.get_targets(game)\n445\t        chosen_targets: list[Any] = []\n446\t        if target_specs:\n447\t            for spec in target_specs:\n448\t                target = player.choose_target(target_specs, spec)\n449\t                filter_fn = getattr(spec, \"filter_fn\", None)\n450\t                if filter_fn is not None and target is not None:\n451\t                    if not filter_fn(target):\n452\t                        raise CastingError(\n453\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n454\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n455\t                        )\n456\t                chosen_targets.append(target)\n457\t\n458\t        from engine.protection import has_protection_from\n459\t\n460\t        for target in chosen_targets:\n461\t            if has_protection_from(target, card):\n462\t                raise CastingError(\n463\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n464\t                )\n465\t    except Exception as exc:\n466\t        stack_zone.remove(card)\n467\t        source_zone.add(card)\n468\t        raise CastingError(str(exc)) from exc\n469\t\n470\t    # Pay the alternative cost (rollback on failure).\n471\t    if not player.mana_pool.can_pay(alternative_cost):\n472\t        stack_zone.remove(card)\n473\t        source_zone.add(card)\n474\t        raise CastingError(\n475\t            f\"Cannot cast {card.name!r} — insufficient mana for alternative cost\"\n476\t        )\n477\t    player.mana_pool.pay(alternative_cost)\n478\t\n479\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n480\t    card.mana_spent = player.mana_pool.last_payment_total  # type: ignore[attr-defined]\n481\t\n482\t    card.on_cast(game)\n483\t\n484\t    stack_obj = StackObject(\n485\t        source=card,\n486\t        controller=player,\n487\t        targets=chosen_targets,\n488\t        on_resolve=lambda g: None,  # replaced below\n489\t    )\n490\t\n491\t    def _on_resolve(g: GameState) -> None:\n492\t        _resolve_spell(g, card, player, stack_obj)\n493\t\n494\t    stack_obj.on_resolve = _on_resolve\n495\t    game.stack.push(stack_obj)\n496\t\n497\t\n498\t# ------------------------------------------------------------------\n499\t# Resolution (called when the stack pops)\n500\t# ------------------------------------------------------------------\n501\t\n502\tdef _resolve_spell(\n503\t    game: GameState,\n504\t    card: CardImpl,\n505\t    player: Player,\n506\t    stack_obj: StackObject,\n507\t) -> None:\n508\t    \"\"\"Resolve *card* cast by *player*.\n509\t\n510\t    1. Call ``card.on_resolve(game, targets=targets)``.\n511\t    2. Remove the card from the stack zone.\n512\t    3. If the card is a permanent type, move it to the battlefield via\n513\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n514\t       registration and the ETB event).\n515\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n516\t    \"\"\"\n517\t    from engine.zones import move_to_zone\n518\t\n519\t    # Read targets from the StackObject — the single source of truth.\n520\t    # Set chosen_targets on the card just before resolution so that\n521\t    # _get_chosen_target helpers (which read via getattr) work.\n522\t    targets = stack_obj.targets\n523\t    if targets is not None:\n524\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n525\t\n526\t    card.on_resolve(game)\n527\t\n528\t    if card.card_types & _PERMANENT_TYPES:\n529\t        # Move from stack to battlefield via move_to_zone, which handles\n530\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n531\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n532\t    else:\n533\t        # Instant/sorcery: the spell would be put into its owner's graveyard.\n534\t        # Consult replacement effects so that effects such as \"if that spell\n535\t        # would be put into your graveyard, exile it instead\" can redirect\n536\t        # the destination zone.\n537\t        dest_zone = _resolve_spell_graveyard_destination(game, card)\n538\t        move_to_zone(game, card, Zone.STACK, dest_zone)\n539\t        # Clean up any spell-specific exile replacement / flag now that the\n540\t        # spell has left the stack.\n541\t        game.replacement_manager.unregister(card)\n542\t        if hasattr(card, \"_exile_if_goes_to_graveyard\"):\n543\t            del card._exile_if_goes_to_graveyard\n544\t\n545\t\n546\t# Destination string → Zone for spell graveyard-replacement redirection.\n547\t_SPELL_DESTINATION_ZONE_MAP: dict[str, Zone] = {\n548\t    \"graveyard\": Zone.GRAVEYARD,\n549\t    \"exile\": Zone.EXILE,\n550\t    \"hand\": Zone.HAND,\n551\t    \"library\": Zone.LIBRARY,\n552\t}\n553\t\n554\t\n555\tdef _resolve_spell_graveyard_destination(game: GameState, card: CardImpl) -> Zone:\n556\t    \"\"\"Return the zone an instant/sorcery should move to on resolution.\n557\t\n558\t    Builds a :class:`~engine.events.SpellToGraveyardReplacementEvent` and runs\n559\t    it through the replacement manager so replacement effects can redirect the\n560\t    spell (e.g. exile instead of graveyard).  Defaults to the graveyard.\n561\t    \"\"\"\n562\t    from engine.events import SpellToGraveyardReplacementEvent\n563\t\n564\t    controller = getattr(card, \"controller\", None)\n565\t    owner = getattr(card, \"owner\", None) or controller\n566\t    event = SpellToGraveyardReplacementEvent(\n567\t        destination=\"graveyard\",\n568\t        controller=controller,\n569\t        owner=owner,\n570\t        spell=card,\n571\t    )\n572\t    event = game.replacement_manager.apply(game, event)\n573\t    destination_str = getattr(event, \"destination\", \"graveyard\")\n574\t    return _SPELL_DESTINATION_ZONE_MAP.get(destination_str, Zone.GRAVEYARD)\n575\t\n576\t\n577\t# ------------------------------------------------------------------\n578\t# Play land (special action — does not use the stack)\n579\t# ------------------------------------------------------------------\n580\t\n581\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n582\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n583\t\n584\t    Requirements (all must hold):\n585\t\n586\t    * *land_card* has :attr:`CardType.LAND`.\n587\t    * *player* is the active player.\n588\t    * Current phase is a main phase.\n589\t    * The stack is empty.\n590\t    * ``player.land_plays_remaining > 0``.\n591\t    * The card is in the player's hand.\n592\t\n593\t    On success the card moves from hand to battlefield and\n594\t    ``land_plays_remaining`` is decremented.\n595\t\n596\t    Raises:\n597\t        CastingError: If any requirement is not met.\n598\t    \"\"\"\n599\t    # Must be a land\n600\t    if CardType.LAND not in land_card.card_types:\n601\t        raise CastingError(\n602\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n603\t        )\n604\t\n605\t    # Sorcery-speed timing (active player, main phase, stack empty)\n606\t    if not is_sorcery_speed(game, player):\n607\t        raise CastingError(\n608\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n609\t            \"during main phase with empty stack\"\n610\t        )\n611\t\n612\t    # Land plays remaining\n613\t    if player.land_plays_remaining <= 0:\n614\t        raise CastingError(\n615\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n616\t        )\n617\t\n618\t    # Card must be in hand\n619\t    hand = game.get_hand(player)\n620\t    if not hand.contains(land_card):\n621\t        raise CastingError(\n622\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n623\t        )\n624\t\n625\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n626\t    if land_card.owner is None:\n627\t        land_card.owner = player\n628\t    land_card.controller = player\n629\t\n630\t    # Move from hand to battlefield via move_to_zone, which fires\n631\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n632\t    from engine.zones import move_to_zone\n633\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n634\t\n635\t    # Decrement land plays\n636\t    player.land_plays_remaining -= 1\n637\t\n638\t\n639\tdef cast_prepared_spell(\n640\t    game: GameState,\n641\t    permanent: Any,\n642\t    targets: list[Any] | None = None,\n643\t) -> StackObject | None:\n644\t    \"\"\"Cast a copy of *permanent*'s prepare spell while it is prepared.\n645\t\n646\t    This implements the SOS **Prepared** mechanic\n647\t    (rules text: \"While it's prepared, you may cast a copy of its spell.\n648\t    Doing so unprepares it.\").\n649\t\n650\t    A prepared permanent exposes:\n651\t\n652\t    * a truthy ``is_prepared`` flag, and\n653\t    * a ``prepare_spell`` attribute — a :class:`~engine.card.CardImpl` (the\n654\t      inset spell, e.g. Swords to Plowshares).\n655\t\n656\t    This helper creates a *copy* of that prepare spell, places it in the\n657\t    controller's exile zone, casts it for free (no mana cost) onto the stack,\n658\t    and clears the permanent's prepared designation. The returned\n659\t    :class:`StackObject` can be resolved to apply the prepare spell's effect.\n660\t\n661\t    Parameters:\n662\t        game: The current game state.\n663\t        permanent: The prepared permanent (must have ``is_prepared`` truthy\n664\t            and a ``prepare_spell``).\n665\t        targets: Optional explicit targets for the copy. If provided, they\n666\t            are scripted into the controller's choices so the copy resolves\n667\t            against them.\n668\t\n669\t    Returns:\n670\t        The :class:`StackObject` for the prepare-spell copy, or ``None`` if\n671\t        *permanent* is not prepared / exposes no prepare spell.\n672\t    \"\"\"\n673\t    import copy as _copy\n674\t\n675\t    if not getattr(permanent, \"is_prepared\", False):\n676\t        return None\n677\t    prepare_spell = getattr(permanent, \"prepare_spell\", None)\n678\t    if prepare_spell is None:\n679\t        return None\n680\t\n681\t    controller = getattr(permanent, \"controller\", None) or game.active_player\n682\t\n683\t    # Build a fresh copy of the prepare spell so the original face stays put.\n684\t    spell_copy = _copy.copy(prepare_spell)\n685\t    # Give the copy a unique identity & clean target state.\n686\t    from engine.card import GameObject as _GameObject\n687\t\n688\t    spell_copy.object_id = _GameObject._next_id\n689\t    _GameObject._next_id += 1\n690\t    spell_copy.controller = controller\n691\t    spell_copy.owner = controller\n692\t    if hasattr(spell_copy, \"chosen_targets\"):\n693\t        spell_copy.chosen_targets = []\n694\t\n695\t    # Casting unprepares the permanent (rule text: \"Doing so unprepares it.\").\n696\t    permanent.is_prepared = False\n697\t\n698\t    # Place the copy in exile so it is cast \"from exile\" like a real copy.\n699\t    exile_zone = controller.zones[Zone.EXILE]\n700\t    exile_zone.add(spell_copy)\n701\t\n702\t    stack_before = len(game.stack)\n703\t\n704\t    # Script the explicit targets so cast_spell_free's target choices resolve.\n705\t    if targets:\n706\t        appendleft = getattr(getattr(controller, \"_script\", None), \"appendleft\", None)\n707\t        if appendleft is not None:\n708\t            for target in reversed(targets):\n709\t                controller._script.appendleft(target)\n710\t\n711\t    cast_spell_free(game, controller, spell_copy, Zone.EXILE)\n712\t\n713\t    if len(game.stack) > stack_before:\n714\t        return game.stack.peek()\n715\t    return None\n716\t\n717\t\n718\tdef resolve_top(game: GameState) -> None:\n719\t    \"\"\"Resolve the top spell/ability on the stack.\n720\t\n721\t    Pops the top item from the stack, calls its on_resolve callback,\n722\t    then runs state-based actions.  If the stack is empty this is a no-op.\n723\t    \"\"\"\n724\t    if game.stack.is_empty():\n725\t        return\n726\t    from engine.state_based_actions import resolve_state_based_actions\n727\t\n728\t    obj = game.stack.pop()\n729\t    obj.on_resolve(game)\n730\t    resolve_state_based_actions(game)\n731\t"}]},"parent_tool_use_id":"toolu_01VHujhzSrizXureD9tNErgr","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"580fafca-5aeb-4aae-a807-626273193935","timestamp":"2026-06-01T11:49:31.935Z","subagent_type":"Tester","task_description":"Write tests for sos_226"}
