{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KiL2YvYh4EHLkVXXfQQH8d","type":"tool_result","content":"120\t    if granted is not None:\n121\t        set_miracle_cost(card, granted)\n122\t        return granted\n123\t\n124\t    # No active granter: drop any stale stamp so the grant is not sticky.\n125\t    if get_miracle_cost(card) is not None:\n126\t        clear_miracle_cost(card)\n127\t    return None\n128\t\n129\t\n130\tdef is_first_draw_this_turn(player: \"Player\") -> bool:\n131\t    \"\"\"Return ``True`` if at most one card has been drawn by *player* this turn.\n132\t\n133\t    Miracle keys off \"the first card you've drawn this turn\".  The draw helper\n134\t    (:func:`engine.game.draw_card`) increments ``player.cards_drawn_this_turn``\n135\t    *before* firing the draw trigger, so when this is evaluated at draw time the\n136\t    counter reads ``1`` for the first draw of the turn.\n137\t    \"\"\"\n138\t    count = getattr(player, \"cards_drawn_this_turn\", 0)\n139\t    return count <= 1\n140\t\n141\t\n142\tdef can_miracle_cast(player: \"Player\", card: Any) -> bool:\n143\t    \"\"\"Return ``True`` if *card* may be miracle-cast as it is drawn.\n144\t\n145\t    Requires both that *card* carries an assigned miracle cost and that it is\n146\t    the first card *player* has drawn this turn.\n147\t    \"\"\"\n148\t    if get_miracle_cost(card) is None:\n149\t        return False\n150\t    return is_first_draw_this_turn(player)\n151\t\n152\t\n153\tdef offer_miracle(game: \"GameState\", player: \"Player\", card: Any) -> bool:\n154\t    \"\"\"Draw-time miracle hook — offer to cast the just-drawn *card* for miracle.\n155\t\n156\t    Returns ``True`` if the card was miracle-cast (put on the stack), ``False``\n157\t    otherwise.  No-op (returns ``False``) when the card has no miracle cost or\n158\t    it is not the first card drawn this turn.\n159\t\n160\t    The optionality is driven by ``player.choose_yes_no`` (the \"you may\"\n161\t    clause).  On a yes, the card is cast for its miracle cost via the\n162\t    alternative-cost cast path.\n163\t\n164\t    The miracle cost is derived DYNAMICALLY from the grants active right now\n165\t    (see :func:`derive_miracle_cost`), so a naturally-drawn card gets the offer\n166\t    with no manual pre-stamping, and a stale stamp left over from a granter that\n167\t    has since left play does NOT produce an offer.\n168\t    \"\"\"\n169\t    cost = derive_miracle_cost(game, player, card)\n170\t    if cost is None:\n171\t        return False\n172\t    if not is_first_draw_this_turn(player):\n173\t        return False\n174\t\n175\t    name = getattr(card, \"name\", \"card\")\n176\t    if hasattr(player, \"choose_yes_no\"):\n177\t        if not player.choose_yes_no(f\"Cast {name!r} for its miracle cost?\"):\n178\t            return False\n179\t"}]},"parent_tool_use_id":"toolu_015Db1w2LmRhkJgHeDaM9a5T","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"95461455-7ae7-4c08-90fa-c7e463b0dff2","timestamp":"2026-06-01T11:46:57.749Z","subagent_type":"Implementer","task_description":"Revise sos_201 implementation"}
