{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_011guPnaGy6kv9saPx2Dhqw3","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01W1HFi57WwRDd9HmAVykghd","name":"Read","input":{"file_path":"/workspace/engine/game.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11299,"cache_read_input_tokens":50002,"cache_creation":{"ephemeral_5m_input_tokens":11299,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_012rXFMpMiUxgBU3maGZJedn","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"2a76302e-f8f6-4ac1-9f4f-f1c12b43fc71","request_id":"req_011CbcTKngm4ebbPdhrcXmk6","subagent_type":"Tester","task_description":"Write tests for sos_120"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W1HFi57WwRDd9HmAVykghd","type":"tool_result","content":"1\t\"\"\"Game setup, helper actions, and the full game loop.\n2\t\n3\tProvides the top-level functions for creating, running, and interacting with\n4\ta game of Magic: The Gathering:\n5\t\n6\t- :func:`create_game` — initialise a full game state for two players.\n7\t- Helper actions — module-level functions for common game operations\n8\t  (``deal_damage``, ``destroy``, ``sacrifice``, ``exile``, ``draw_card``,\n9\t  ``discard``, ``create_token``, ``add_counter``, ``remove_counter``,\n10\t  ``tap``, ``untap``).\n11\t- :func:`run_game` — execute turns until the game ends, returning the winner.\n12\t\"\"\"\n13\t\n14\tfrom __future__ import annotations\n15\t\n16\tfrom typing import TYPE_CHECKING, Any\n17\t\n18\tfrom engine.events import (\n19\t    CreatureDiesReplacementEvent,\n20\t    DealsDamageTriggeredEvent,\n21\t    DrawsCardTriggeredEvent,\n22\t    EntersBattlefieldTriggeredEvent,\n23\t    GainsLifeTriggeredEvent,\n24\t    LosesLifeTriggeredEvent,\n25\t    PermanentDestroyedReplacementEvent,\n26\t    SacrificeReplacementEvent,\n27\t)\n28\tfrom engine.game_state import GameState\n29\tfrom engine.turn import run_turn\n30\tfrom engine.types import Zone\n31\tfrom engine.zones import move_to_zone\n32\t\n33\tif TYPE_CHECKING:\n34\t    from engine.card import CardImpl, Creature\n35\t    from engine.player import Player\n36\t\n37\t\n38\t# Maximum number of turns before the game is considered a draw.\n39\t# Prevents infinite loops in deterministic or stuck game states.\n40\tMAX_TURNS: int = 1000\n41\t\n42\t\n43\t# ---------------------------------------------------------------------------\n44\t# Game creation\n45\t# ---------------------------------------------------------------------------\n46\t\n47\tdef create_game(\n48\t    player1: Player,\n49\t    player2: Player,\n50\t    deck1: list[CardImpl],\n51\t    deck2: list[CardImpl],\n52\t) -> GameState:\n53\t    \"\"\"Create and initialise a new two-player game.\n54\t\n55\t    Steps performed:\n56\t\n57\t    1. Set each player's life total to 20.\n58\t    2. Place *deck1* / *deck2* into the respective player's library zone.\n59\t    3. Shuffle each library.\n60\t    4. Draw 7 cards for each player.\n61\t    5. Set the active player to *player1*.\n62\t\n63\t    Card ownership is set so that each card's ``owner`` and ``controller``\n64\t    point to the player whose deck it came from.\n65\t\n66\t    Parameters:\n67\t        player1: The first player (goes first).\n68\t        player2: The second player.\n69\t        deck1: Cards comprising player1's deck.\n70\t        deck2: Cards comprising player2's deck.\n71\t\n72\t    Returns:\n73\t        A fully initialised :class:`GameState` ready for play.\n74\t    \"\"\"\n75\t    # 1. Set life totals\n76\t    player1.life = 20\n77\t    player2.life = 20\n78\t\n79\t    # 2. Place deck cards into libraries and set ownership\n80\t    library1 = player1.zones[Zone.LIBRARY]\n81\t    for card in deck1:\n82\t        card.owner = player1\n83\t        card.controller = player1\n84\t        library1.add(card)\n85\t\n86\t    library2 = player2.zones[Zone.LIBRARY]\n87\t    for card in deck2:\n88\t        card.owner = player2\n89\t        card.controller = player2\n90\t        library2.add(card)\n91\t\n92\t    # 3. Shuffle libraries\n93\t    library1.shuffle()\n94\t    library2.shuffle()\n95\t\n96\t    # Build the game state\n97\t    game = GameState([player1, player2])\n98\t\n99\t    # 4. Draw 7 cards each\n100\t    for _ in range(7):\n101\t        draw_card(game, player1)\n102\t    for _ in range(7):\n103\t        draw_card(game, player2)\n104\t\n105\t    # 5. Active player is player1 (index 0 — already the default)\n106\t    game.active_player_index = 0\n107\t    game.priority_player_index = 0\n108\t\n109\t    return game\n110\t\n111\t\n112\t# ---------------------------------------------------------------------------\n113\t# Common helper actions\n114\t# ---------------------------------------------------------------------------\n115\t\n116\tdef deal_damage(game: GameState, source: Any, target: Any, amount: int) -> None:\n117\t    \"\"\"Deal *amount* damage from *source* to *target*.\n118\t\n119\t    If *target* has a ``life`` attribute (i.e. is a player), life is reduced.\n120\t    If *target* has a ``damage_marked`` attribute (i.e. is a creature),\n121\t    damage is marked on it.\n122\t\n123\t    Fires :attr:`EventType.DEALS_DAMAGE` via the trigger manager.\n124\t\n125\t    Parameters:\n126\t        game: The current game state.\n127\t        source: The object dealing the damage.\n128\t        target: The player or creature receiving the damage.\n129\t        amount: The amount of damage to deal (must be > 0 to have effect).\n130\t    \"\"\"\n131\t    if amount <= 0:\n132\t        return\n133\t\n134\t    from engine.protection import has_protection_from\n135\t    from engine.types import Keyword\n136\t\n137\t    # Protection prevents damage from sources with the protected-from quality.\n138\t    if has_protection_from(target, source):\n139\t        return\n140\t\n141\t    if hasattr(target, \"life\"):\n142\t        # Target is a player\n143\t        target.life -= amount\n144\t        # Fire damage trigger\n145\t        game.trigger_manager.fire_event(\n146\t            game,\n147\t            DealsDamageTriggeredEvent(source=source, target=target, amount=amount),\n148\t        )\n149\t        # Fire loses-life trigger\n150\t        game.trigger_manager.fire_event(\n151\t            game,\n152\t            LosesLifeTriggeredEvent(player=target, amount=amount),\n153\t        )\n154\t    elif hasattr(target, \"damage_marked\"):\n155\t        # Target is a creature\n156\t        target.damage_marked += amount\n157\t\n158\t        # Track deathtouch damage for SBA rule 704.5h\n159\t        source_kw = getattr(source, \"keywords\", Keyword(0))\n160\t        if Keyword.DEATHTOUCH in source_kw:\n161\t            target.dealt_deathtouch_damage = True\n162\t\n163\t        # Fire damage trigger\n164\t        game.trigger_manager.fire_event(\n165\t            game,\n166\t            DealsDamageTriggeredEvent(source=source, target=target, amount=amount),\n167\t        )\n168\t\n169\t    # Lifelink: controller of source gains life equal to damage dealt\n170\t    source_kw = getattr(source, \"keywords\", Keyword(0))\n171\t    if Keyword.LIFELINK in source_kw:\n172\t        controller = getattr(source, \"controller\", None)\n173\t        if controller is not None and hasattr(controller, \"life\"):\n174\t            controller.life += amount\n175\t\n176\t\n177\tdef destroy(game: GameState, permanent: Any) -> None:\n178\t    \"\"\"Destroy *permanent* — move it from the battlefield to its owner's graveyard.\n179\t\n180\t    Respects replacement effects via :func:`move_to_zone`.\n181\t    Creatures with the ``INDESTRUCTIBLE`` keyword are not destroyed.\n182\t\n183\t    Parameters:\n184\t        game: The current game state.\n185\t        permanent: The permanent to destroy.\n186\t    \"\"\"\n187\t    from engine.types import Keyword\n188\t\n189\t    # Indestructible permanents cannot be destroyed\n190\t    kw = getattr(permanent, \"keywords\", Keyword(0))\n191\t    if Keyword.INDESTRUCTIBLE in kw:\n192\t        return\n193\t\n194\t    controller = getattr(permanent, \"controller\", None)\n195\t    if controller is None:\n196\t        # Fallback: find which player's battlefield contains it\n197\t        for player in game.players:\n198\t            bf = game.get_battlefield(player)\n199\t            if bf.contains(permanent):\n200\t                controller = player\n201\t                break\n202\t    if controller is None:\n203\t        return\n204\t\n205\t    bf = game.get_battlefield(controller)\n206\t    if not bf.contains(permanent):\n207\t        return\n208\t\n209\t    from engine.types import CardType\n210\t\n211\t    card_types = getattr(permanent, \"card_types\", set())\n212\t    is_creature = CardType.CREATURE in card_types\n213\t    owner = getattr(permanent, \"owner\", controller)\n214\t\n215\t    if is_creature:\n216\t        repl_event: CreatureDiesReplacementEvent | PermanentDestroyedReplacementEvent = (\n217\t            CreatureDiesReplacementEvent(\n218\t                creature=permanent, destination=\"graveyard\",\n219\t                controller=controller, owner=owner,\n220\t            )\n221\t        )\n222\t    else:\n223\t        repl_event = PermanentDestroyedReplacementEvent(\n224\t            permanent=permanent, destination=\"graveyard\",\n225\t            controller=controller, owner=owner,\n226\t        )\n227\t\n228\t    move_to_zone(\n229\t        game,\n230\t        permanent,\n231\t        Zone.BATTLEFIELD,\n232\t        Zone.GRAVEYARD,\n233\t        replacement_event=repl_event,\n234\t    )\n235\t\n236\t\n237\tdef sacrifice(game: GameState, player: Player, permanent: Any) -> None:\n238\t    \"\"\"Sacrifice *permanent* — move it from the battlefield to its owner's graveyard.\n239\t\n240\t    Sacrificing cannot be prevented by indestructible or regeneration, but\n241\t    replacement effects that modify zone changes (e.g. \"if this would be\n242\t    put into a graveyard, exile it instead\") still apply via\n243\t    :func:`move_to_zone`.\n244\t\n245\t    Parameters:\n246\t        game: The current game state.\n247\t        player: The player performing the sacrifice.\n248\t        permanent: The permanent to sacrifice.\n249\t    \"\"\"\n250\t    bf = game.get_battlefield(player)\n251\t    if not bf.contains(permanent):\n252\t        return\n253\t\n254\t    owner = getattr(permanent, \"owner\", player)\n255\t    move_to_zone(\n256\t        game,\n257\t        permanent,\n258\t        Zone.BATTLEFIELD,\n259\t        Zone.GRAVEYARD,\n260\t        replacement_event=SacrificeReplacementEvent(\n261\t            permanent=permanent, destination=\"graveyard\",\n262\t            controller=player, owner=owner,\n263\t        ),\n264\t    )\n265\t\n266\t\n267\tdef exile(game: GameState, obj: Any) -> None:\n268\t    \"\"\"Exile *obj* — move it to its owner's exile zone.\n269\t\n270\t    Works for objects on the battlefield, in the graveyard, on the stack,\n271\t    or in hand.\n272\t\n273\t    Parameters:\n274\t        game: The current game state.\n275\t        obj: The game object to exile.\n276\t    \"\"\"\n277\t    # Find which zone the object is currently in\n278\t    source_zone_type = None\n279\t    for player in game.players:\n280\t        for zone_type in Zone:\n281\t            zone = player.zones[zone_type]\n282\t            if zone.contains(obj):\n283\t                source_zone_type = zone_type\n284\t                break\n285\t        if source_zone_type is not None:\n286\t            break\n287\t\n288\t    if source_zone_type is None:\n289\t        return\n290\t\n291\t    move_to_zone(game, obj, source_zone_type, Zone.EXILE)\n292\t\n293\t\n294\tdef draw_card(game: GameState, player: Player) -> Any | None:\n295\t    \"\"\"Draw a card for *player* — move the top card of library to hand.\n296\t\n297\t    If the library is empty, sets ``player.drawn_from_empty_library = True``\n298\t    (SBAs will handle the game loss).\n299\t\n300\t    Fires :attr:`EventType.DRAWS_CARD` via the trigger manager.\n301\t\n302\t    Parameters:\n303\t        game: The current game state.\n304\t        player: The player drawing a card.\n305\t\n306\t    Returns:\n307\t        The drawn card, or ``None`` if the library was empty.\n308\t    \"\"\"\n309\t    library = player.zones[Zone.LIBRARY]\n310\t\n311\t    if len(library) == 0:\n312\t        player.drawn_from_empty_library = True\n313\t        return None\n314\t\n315\t    # Top of library is the last element (index -1)\n316\t    cards = library.top(1)\n317\t    card = cards[0]\n318\t    library.remove(card)\n319\t\n320\t    hand = player.zones[Zone.HAND]\n321\t    hand.add(card)\n322\t\n323\t    # Track cards drawn this turn\n324\t    if not hasattr(player, \"cards_drawn_this_turn\"):\n325\t        player.cards_drawn_this_turn = 0\n326\t    player.cards_drawn_this_turn += 1\n327\t\n328\t    # Fire trigger (only if game has a trigger_manager — may not during setup)\n329\t    if hasattr(game, \"trigger_manager\"):\n330\t        game.trigger_manager.fire_event(\n331\t            game,\n332\t            DrawsCardTriggeredEvent(player=player, card=card),\n333\t        )\n334\t\n335\t    return card\n336\t\n337\t\n338\tdef discard(game: GameState, player: Player, card: Any) -> None:\n339\t    \"\"\"Discard *card* from *player*'s hand to the owner's graveyard.\n340\t\n341\t    Parameters:\n342\t        game: The current game state.\n343\t        player: The player discarding.\n344\t        card: The card to discard (must be in the player's hand).\n345\t    \"\"\"\n346\t    hand = game.get_hand(player)\n347\t    if not hand.contains(card):\n348\t        return\n349\t\n350\t    move_to_zone(game, card, Zone.HAND, Zone.GRAVEYARD)\n351\t\n352\t\n353\tdef surveil(game: GameState, player: Player, amount: int) -> None:\n354\t    \"\"\"Surveil *amount* (rule 701.43) for *player*.\n355\t\n356\t    Look at the top *amount* cards of *player*'s library, then for each (from\n357\t    the top down) the player decides whether to keep it on top of the library\n358\t    or put it into the graveyard.  Cards kept on top retain their relative\n359\t    order.\n360\t\n361\t    The decision is driven by ``player.choose_yes_no`` — ``True`` keeps the\n362\t    card on top, ``False`` puts it into the graveyard.\n363\t\n364\t    Parameters:\n365\t        game: The current game state.\n366\t        player: The player surveilling.\n367\t        amount: The number of cards to look at.\n368\t    \"\"\"\n369\t    if amount <= 0:\n370\t        return\n371\t\n372\t    library = game.get_library(player)\n373\t    # ``top(n)`` returns bottom→top order; reverse so we process from the\n374\t    # top of the library downward (the order the player looks at them).\n375\t    looked_at = list(reversed(library.top(amount)))\n376\t\n377\t    keep_on_top: list[Any] = []\n378\t    for card in looked_at:\n379\t        keep = True\n380\t        if hasattr(player, \"choose_yes_no\"):\n381\t            keep = player.choose_yes_no(f\"Keep {getattr(card, 'name', card)!r} on top?\")\n382\t        if keep:\n383\t            keep_on_top.append(card)\n384\t        else:\n385\t            move_to_zone(game, card, Zone.LIBRARY, Zone.GRAVEYARD)\n386\t\n387\t    # Re-place the kept cards on top, preserving their original top-down order\n388\t    # (so the previous top card remains on top).\n389\t    for card in reversed(keep_on_top):\n390\t        if library.contains(card):\n391\t            library.remove(card)\n392\t    for card in reversed(keep_on_top):\n393\t        library.add(card, position=\"top\")\n394\t\n395\t\n396\tdef flip_coin(game: GameState | None = None) -> bool:\n397\t    \"\"\"Flip a coin (rule 705).  Returns ``True`` for heads, ``False`` for tails.\n398\t\n399\t    Uses the :mod:`random` module so tests can force the outcome by patching\n400\t    ``random.random`` / ``random.choice`` / ``random.randint``.\n401\t\n402\t    The optional ``game`` parameter is currently unused; it is accepted for\n403\t    signature symmetry with the other ``engine.game`` helpers so callers can\n404\t    pass the game state uniformly.\n405\t    \"\"\"\n406\t    import random\n407\t\n408\t    return random.random() < 0.5\n409\t\n410\t\n411\tdef skip_turns(game: GameState, player: Player, count: int) -> None:\n412\t    \"\"\"Record that *player* skips their next *count* turns.\n413\t\n414\t    The engine has no full turn-skip execution path; this surfaces the\n415\t    recorded count both on the player (``player.skipped_turns``) and on the\n416\t    game keyed by seat index (``game.skipped_turns[seat]``) so it is\n417\t    observable.\n418\t\n419\t    Parameters:\n420\t        game: The current game state.\n421\t        player: The player who will skip turns.\n422\t        count: Number of turns to skip (clamped to non-negative).\n423\t    \"\"\"\n424\t    count = max(0, count)\n425\t    player.skipped_turns = getattr(player, \"skipped_turns\", 0) + count\n426\t\n427\t    if not hasattr(game, \"skipped_turns\") or game.skipped_turns is None:\n428\t        game.skipped_turns = {}\n429\t    try:\n430\t        seat = game.players.index(player)\n431\t    except ValueError:\n432\t        seat = None\n433\t    if seat is not None:\n434\t        game.skipped_turns[seat] = game.skipped_turns.get(seat, 0) + count\n435\t\n436\t\n437\tdef create_token(game: GameState, player: Player, token: Any) -> None:\n438\t    \"\"\"Create a token on the battlefield under *player*'s control.\n439\t\n440\t    Sets ``is_token = True`` on the token, along with ``owner`` and\n441\t    ``controller``.  Uses :func:`move_to_zone` for entering-battlefield\n442\t    hooks (trigger/replacement-effect registration and ETB event).\n443\t\n444\t    Parameters:\n445\t        game: The current game state.\n446\t        player: The player who controls the token.\n447\t        token: The token object to place on the battlefield.\n448\t    \"\"\"\n449\t    token.is_token = True\n450\t    token.owner = player\n451\t    token.controller = player\n452\t\n453\t    # Tokens don't come from an existing zone — add directly and fire hooks.\n454\t    # Ordering matches move_to_zone: fire ETB *before* registering the token's\n455\t    # own triggers so a token's ETB trigger doesn't self-fire on entry.\n456\t    battlefield = game.get_battlefield(player)\n457\t    battlefield.add(token)\n458\t\n459\t    game.trigger_manager.fire_event(\n460\t        game,\n461\t        EntersBattlefieldTriggeredEvent(permanent=token, controller=player),\n462\t    )\n463\t\n464\t    # Register triggers/replacement effects after the ETB event.\n465\t    if hasattr(token, \"register_triggers\"):\n466\t        token.register_triggers(game)\n467\t    if hasattr(token, \"register_replacement_effects\"):\n468\t        token.register_replacement_effects(game)\n469\t\n470\t\n471\tdef add_counter(\n472\t    game: GameState,\n473\t    permanent: Any,\n474\t    counter_type: str,\n475\t    amount: int = 1,\n476\t) -> None:\n477\t    \"\"\"Add *amount* counters of *counter_type* to *permanent*.\n478\t\n479\t    Supports ``\"+1/+1\"`` and ``\"-1/-1\"`` counter types via the\n480\t    ``plus_one_counters`` / ``minus_one_counters`` attributes.  For other\n481\t    counter types, uses a generic ``counters`` dict.\n482\t\n483\t    Parameters:\n484\t        game: The current game state.\n485\t        permanent: The permanent to add counters to.\n486\t        counter_type: The type of counter (e.g. ``\"+1/+1\"``, ``\"-1/-1\"``,\n487\t            ``\"loyalty\"``, ``\"charge\"``).\n488\t        amount: Number of counters to add (default 1).\n489\t    \"\"\"\n490\t    if amount <= 0:\n491\t        return\n492\t\n493\t    if counter_type == \"+1/+1\" and hasattr(permanent, \"plus_one_counters\"):\n494\t        permanent.plus_one_counters += amount\n495\t    elif counter_type == \"-1/-1\" and hasattr(permanent, \"minus_one_counters\"):\n496\t        permanent.minus_one_counters += amount\n497\t    elif counter_type == \"loyalty\" and hasattr(permanent, \"loyalty\"):\n498\t        permanent.loyalty += amount\n499\t    else:\n500\t        # Generic counter storage\n501\t        if not hasattr(permanent, \"counters\"):\n502\t            permanent.counters = {}\n503\t        permanent.counters[counter_type] = permanent.counters.get(counter_type, 0) + amount\n504\t\n505\t\n506\tdef remove_counter(\n507\t    game: GameState,\n508\t    permanent: Any,\n509\t    counter_type: str,\n510\t    amount: int = 1,\n511\t) -> None:\n512\t    \"\"\"Remove *amount* counters of *counter_type* from *permanent*.\n513\t\n514\t    Will not reduce below zero.\n515\t\n516\t    Parameters:\n517\t        game: The current game state.\n518\t        permanent: The permanent to remove counters from.\n519\t        counter_type: The type of counter to remove.\n520\t        amount: Number of counters to remove (default 1).\n521\t    \"\"\"\n522\t    if amount <= 0:\n523\t        return\n524\t\n525\t    if counter_type == \"+1/+1\" and hasattr(permanent, \"plus_one_counters\"):\n526\t        permanent.plus_one_counters = max(0, permanent.plus_one_counters - amount)\n527\t    elif counter_type == \"-1/-1\" and hasattr(permanent, \"minus_one_counters\"):\n528\t        permanent.minus_one_counters = max(0, permanent.minus_one_counters - amount)\n529\t    elif counter_type == \"loyalty\" and hasattr(permanent, \"loyalty\"):\n530\t        permanent.loyalty = max(0, permanent.loyalty - amount)\n531\t    else:\n532\t        if hasattr(permanent, \"counters\") and counter_type in permanent.counters:\n533\t            permanent.counters[counter_type] = max(\n534\t                0, permanent.counters[counter_type] - amount\n535\t            )\n536\t\n537\t\n538\tdef tap(game: GameState, permanent: Any) -> None:\n539\t    \"\"\"Tap *permanent* — set ``is_tapped = True``.\n540\t\n541\t    Parameters:\n542\t        game: The current game state.\n543\t        permanent: The permanent to tap.\n544\t    \"\"\"\n545\t    if hasattr(permanent, \"is_tapped\"):\n546\t        permanent.is_tapped = True\n547\t\n548\t\n549\tdef untap(game: GameState, permanent: Any) -> None:\n550\t    \"\"\"Untap *permanent* — set ``is_tapped = False``.\n551\t\n552\t    Parameters:\n553\t        game: The current game state.\n554\t        permanent: The permanent to untap.\n555\t    \"\"\"\n556\t    if hasattr(permanent, \"is_tapped\"):\n557\t        permanent.is_tapped = False\n558\t\n559\t\n560\t# ---------------------------------------------------------------------------\n561\t# Game loop\n562\t# ---------------------------------------------------------------------------\n563\t\n564\tdef run_game(game: GameState) -> Player | None:\n565\t    \"\"\"Run the game loop until the game ends.\n566\t\n567\t    Executes :func:`~engine.turn.run_turn` in a loop, checking\n568\t    :attr:`GameState.is_game_over` after each turn.  State-based actions\n569\t    are resolved before and after each turn to catch game-ending conditions\n570\t    even when the priority loop auto-passes.\n571\t\n572\t    Includes a safety limit of :data:`MAX_TURNS` to prevent infinite loops\n573\t    in deterministic or stuck game states.\n574\t\n575\t    Parameters:\n576\t        game: The game state to run.\n577\t\n578\t    Returns:\n579\t        The winning player, or ``None`` if the game ended in a draw (or\n580\t        hit the turn limit).\n581\t    \"\"\"\n582\t    from engine.state_based_actions import resolve_state_based_actions\n583\t\n584\t    while not game.is_game_over and game.turn_number <= MAX_TURNS:\n585\t        # Check SBAs before the turn (catches pre-existing conditions)\n586\t        resolve_state_based_actions(game)\n587\t        _check_game_over(game)\n588\t        if game.is_game_over:\n589\t            break\n590\t\n591\t        run_turn(game)\n592\t\n593\t        # Check SBAs after the turn\n594\t        resolve_state_based_actions(game)\n595\t        _check_game_over(game)\n596\t\n597\t    return game.winner\n598\t\n599\t\n600\tdef _check_game_over(game: GameState) -> None:\n601\t    \"\"\"Check whether the game has ended and update ``game.is_game_over`` / ``game.winner``.\n602\t\n603\t    The game ends when:\n604\t    - One player has lost (``has_lost``): the other player wins.\n605\t    - Both players have lost: the game is a draw (``winner = None``).\n606\t    - The turn limit is exceeded: the game is a draw.\n607\t    \"\"\"\n608\t    lost_players = [p for p in game.players if p.has_lost]\n609\t\n610\t    if len(lost_players) == len(game.players):\n611\t        # All players have lost — draw\n612\t        game.is_game_over = True\n613\t        game.winner = None\n614\t    elif len(lost_players) == 1:\n615\t        # One player lost — the other wins\n616\t        game.is_game_over = True\n617\t        game.winner = [p for p in game.players if not p.has_lost][0]\n618\t    elif game.turn_number > MAX_TURNS:\n619\t        # Turn limit exceeded — draw\n620\t        game.is_game_over = True\n621\t        game.winner = None\n622\t"}]},"parent_tool_use_id":"toolu_012rXFMpMiUxgBU3maGZJedn","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"e444f416-1ed0-428b-8bd2-9b046f26856b","timestamp":"2026-06-01T11:23:37.925Z","subagent_type":"Tester","task_description":"Write tests for sos_120"}
