{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AbfRY7QYhcHhqcL4of4m5k","type":"tool_result","content":"1\t\"\"\"Tests for SOS 257 — Great Hall of the Biblioplex.\n2\t\n3\tGreat Hall of the Biblioplex is a Land with three abilities:\n4\t\n5\t  {T}: Add {C}.\n6\t  {T}, Pay 1 life: Add one mana of any color. Spend this mana only to cast\n7\t      an instant or sorcery spell.\n8\t  {5}: If this land isn't a creature, it becomes a 2/4 Wizard creature with\n9\t      \"Whenever you cast an instant or sorcery spell, this creature gets\n10\t      +1/+0 until end of turn.\" It's still a land.\n11\t\n12\tThese TDD-red tests describe the observable contract:\n13\t\n14\t  * static card data (Land, no mana cost, no P/T, colorless),\n15\t  * the two mana abilities ({C}, and any-color for 1 life),\n16\t  * the {5} animation ability (becomes a 2/4 Wizard creature that is\n17\t    still a Land), and\n18\t  * the \"isn't a creature\" guard on the animation.\n19\t\n20\tThe engine has no surface for enforcing the \"spend this mana only to cast an\n21\tinstant or sorcery spell\" restriction (see Secluded Courtyard / FDN 267, which\n22\tdocuments the same limitation); that requirement is recorded in\n23\t``untestable.json`` rather than asserted here.\n24\t\"\"\"\n25\t\n26\tfrom __future__ import annotations\n27\t\n28\tfrom cards.sos.sos_257.card_impl import GreatHallOfTheBiblioplex\n29\tfrom engine.card import Land, ManaAbility, ActivatedAbility\n30\tfrom engine.types import CardType, ManaCost, ManaType\n31\tfrom test_utils import create_game, set_board_state\n32\t\n33\t\n34\t# ---------------------------------------------------------------------------\n35\t# Static card data\n36\t# ---------------------------------------------------------------------------\n37\t\n38\tclass TestGreatHallProperties:\n39\t    \"\"\"Static characteristics must match the SOS 257 spec.\"\"\"\n40\t\n41\t    def test_name(self) -> None:\n42\t        assert GreatHallOfTheBiblioplex(owner=None).name == \"Great Hall of the Biblioplex\"\n43\t\n44\t    def test_is_land(self) -> None:\n45\t        assert isinstance(GreatHallOfTheBiblioplex(owner=None), Land)\n46\t\n47\t    def test_has_land_card_type(self) -> None:\n48\t        card = GreatHallOfTheBiblioplex(owner=None)\n49\t        assert CardType.LAND in card.card_types\n50\t\n51\t    def test_is_not_a_creature_by_default(self) -> None:\n52\t        \"\"\"Before activating the {5} ability it is a plain (non-creature) land.\"\"\"\n53\t        card = GreatHallOfTheBiblioplex(owner=None)\n54\t        assert CardType.CREATURE not in card.card_types\n55\t\n56\t    def test_has_no_mana_cost(self) -> None:\n57\t        \"\"\"Lands have no mana cost.\"\"\"\n58\t        assert GreatHallOfTheBiblioplex(owner=None).mana_cost == ManaCost()\n59\t\n60\t    def test_is_colorless(self) -> None:\n61\t        \"\"\"No colored pips anywhere -> colorless.\"\"\"\n62\t        assert GreatHallOfTheBiblioplex(owner=None).colors == set()\n63\t\n64\t    def test_cannot_be_cast(self) -> None:\n65\t        \"\"\"Lands are played, not cast.\"\"\"\n66\t        game = create_game()\n67\t        card = GreatHallOfTheBiblioplex(owner=game.players[0])\n68\t        assert card.can_cast(game) is False\n69\t\n70\t\n71\t# ---------------------------------------------------------------------------\n72\t# Mana abilities\n73\t# ---------------------------------------------------------------------------\n74\t\n75\tclass TestGreatHallManaAbilities:\n76\t    \"\"\"The land exposes two mana abilities: {C}, and any-color for 1 life.\"\"\"\n77\t\n78\t    def test_exposes_two_mana_abilities(self) -> None:\n79\t        card = GreatHallOfTheBiblioplex(owner=None)\n80\t        abilities = card.get_mana_abilities()\n81\t        assert len(abilities) == 2\n82\t        for a in abilities:\n83\t            assert isinstance(a, ManaAbility)\n84\t\n85\t    def test_colorless_ability_adds_one_colorless(self) -> None:\n86\t        game = create_game()\n87\t        p1 = game.players[0]\n88\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n89\t        set_board_state(game, 0, battlefield=[card])\n90\t        ability = card.get_mana_abilities()[0]\n91\t        assert ability.cost(game, card) is True\n92\t        ability.mana_produced(game)\n93\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 1\n94\t\n95\t    def test_colorless_ability_taps_the_land(self) -> None:\n96\t        game = create_game()\n97\t        p1 = game.players[0]\n98\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n99\t        set_board_state(game, 0, battlefield=[card])\n100\t        ability = card.get_mana_abilities()[0]\n101\t        assert card.is_tapped is False\n102\t        ability.cost(game, card)\n103\t        assert card.is_tapped is True\n104\t\n105\t    def test_colorless_ability_cost_fails_when_tapped(self) -> None:\n106\t        game = create_game()\n107\t        p1 = game.players[0]\n108\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n109\t        card.is_tapped = True\n110\t        set_board_state(game, 0, battlefield=[card])\n111\t        ability = card.get_mana_abilities()[0]\n112\t        assert ability.cost(game, card) is False\n113\t\n114\t    def test_any_color_ability_pays_one_life(self) -> None:\n115\t        game = create_game()\n116\t        p1 = game.players[0]\n117\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n118\t        set_board_state(game, 0, battlefield=[card], life=20)\n119\t        # Second ability: {T}, Pay 1 life: Add one mana of any color.\n120\t        ability = card.get_mana_abilities()[1]\n121\t        # Script the color choice (engine asks controller.choose).\n122\t        p1._script.appendleft(ManaType.BLUE)\n123\t        assert ability.cost(game, card) is True\n124\t        assert p1.life == 19\n125\t\n126\t    def test_any_color_ability_adds_chosen_color(self) -> None:\n127\t        game = create_game()\n128\t        p1 = game.players[0]\n129\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n130\t        set_board_state(game, 0, battlefield=[card], life=20)\n131\t        ability = card.get_mana_abilities()[1]\n132\t        p1._script.appendleft(ManaType.RED)\n133\t        ability.cost(game, card)\n134\t        ability.mana_produced(game)\n135\t        assert p1.mana_pool.get(ManaType.RED) == 1\n136\t\n137\t    def test_any_color_ability_taps_the_land(self) -> None:\n138\t        game = create_game()\n139\t        p1 = game.players[0]\n140\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n141\t        set_board_state(game, 0, battlefield=[card], life=20)\n142\t        ability = card.get_mana_abilities()[1]\n143\t        p1._script.appendleft(ManaType.GREEN)\n144\t        ability.cost(game, card)\n145\t        assert card.is_tapped is True\n146\t\n147\t    def test_any_color_ability_cost_fails_when_tapped(self) -> None:\n148\t        game = create_game()\n149\t        p1 = game.players[0]\n150\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n151\t        card.is_tapped = True\n152\t        set_board_state(game, 0, battlefield=[card], life=20)\n153\t        ability = card.get_mana_abilities()[1]\n154\t        assert ability.cost(game, card) is False\n155\t        # A failed activation must not drain life.\n156\t        assert p1.life == 20\n157\t\n158\t\n159\t# ---------------------------------------------------------------------------\n160\t# {5}: animation ability\n161\t# ---------------------------------------------------------------------------\n162\t\n163\tclass TestGreatHallAnimation:\n164\t    \"\"\"{5}: becomes a 2/4 Wizard creature, still a land.\"\"\"\n165\t\n166\t    def _animate(self, game, card):\n167\t        \"\"\"Pay {5} and apply the animation activated ability's effect.\"\"\"\n168\t        ability = card.get_activated_abilities()[0]\n169\t        # Cost callable should consume 5 generic mana from the controller.\n170\t        assert ability.cost(game, card) is True\n171\t        ability.effect(game)\n172\t\n173\t    def test_exposes_one_activated_ability(self) -> None:\n174\t        card = GreatHallOfTheBiblioplex(owner=None)\n175\t        abilities = card.get_activated_abilities()\n176\t        assert len(abilities) == 1\n177\t        assert isinstance(abilities[0], ActivatedAbility)\n178\t\n179\t    def test_animation_cost_consumes_five_generic_mana(self) -> None:\n180\t        game = create_game()\n181\t        p1 = game.players[0]\n182\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n183\t        set_board_state(game, 0, battlefield=[card], mana={ManaType.COLORLESS: 5})\n184\t        ability = card.get_activated_abilities()[0]\n185\t        assert ability.cost(game, card) is True\n186\t        assert p1.mana_pool.total() == 0\n187\t\n188\t    def test_animation_cost_fails_without_mana(self) -> None:\n189\t        game = create_game()\n190\t        p1 = game.players[0]\n191\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n192\t        set_board_state(game, 0, battlefield=[card], mana={ManaType.COLORLESS: 4})\n193\t        ability = card.get_activated_abilities()[0]\n194\t        assert ability.cost(game, card) is False\n195\t\n196\t    def test_becomes_a_creature(self) -> None:\n197\t        game = create_game()\n198\t        p1 = game.players[0]\n199\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n200\t        set_board_state(game, 0, battlefield=[card], mana={ManaType.COLORLESS: 5})\n201\t        self._animate(game, card)\n202\t        game.effect_manager.apply_all(game)\n203\t        assert CardType.CREATURE in card.card_types\n204\t\n205\t    def test_is_still_a_land_after_animation(self) -> None:\n206\t        game = create_game()\n207\t        p1 = game.players[0]\n208\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n209\t        set_board_state(game, 0, battlefield=[card], mana={ManaType.COLORLESS: 5})\n210\t        self._animate(game, card)\n211\t        game.effect_manager.apply_all(game)\n212\t        assert CardType.LAND in card.card_types\n213\t\n214\t    def test_becomes_two_four(self) -> None:\n215\t        game = create_game()\n216\t        p1 = game.players[0]\n217\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n218\t        set_board_state(game, 0, battlefield=[card], mana={ManaType.COLORLESS: 5})\n219\t        self._animate(game, card)\n220\t        game.effect_manager.apply_all(game)\n221\t        assert card.power == 2\n222\t        assert card.toughness == 4\n223\t\n224\t    def test_becomes_a_wizard(self) -> None:\n225\t        game = create_game()\n226\t        p1 = game.players[0]\n227\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n228\t        set_board_state(game, 0, battlefield=[card], mana={ManaType.COLORLESS: 5})\n229\t        self._animate(game, card)\n230\t        game.effect_manager.apply_all(game)\n231\t        assert \"Wizard\" in card.subtypes\n232\t\n233\t    def test_animation_guarded_when_already_a_creature(self) -> None:\n234\t        \"\"\"The {5} ability does nothing extra if the land is already a creature.\n235\t\n236\t        Applying the animation twice must not double the P/T or otherwise\n237\t        stack (\"If this land isn't a creature, it becomes...\").\n238\t        \"\"\"\n239\t        game = create_game()\n240\t        p1 = game.players[0]\n241\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n242\t        set_board_state(game, 0, battlefield=[card], mana={ManaType.COLORLESS: 10})\n243\t        self._animate(game, card)\n244\t        game.effect_manager.apply_all(game)\n245\t        # Second activation while it is already a creature.\n246\t        self._animate(game, card)\n247\t        game.effect_manager.apply_all(game)\n248\t        assert card.power == 2\n249\t        assert card.toughness == 4\n250\t"}]},"parent_tool_use_id":"toolu_01DqRHg8PRQF4DMAnkhcGpdm","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"9d021459-8f78-4845-9607-e46f0297ed41","timestamp":"2026-06-01T12:14:45.431Z","subagent_type":"Implementer","task_description":"Implement sos_257"}
