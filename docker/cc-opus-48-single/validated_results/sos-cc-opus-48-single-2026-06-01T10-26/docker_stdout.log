{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ue6fu3KbKPjAd7eBMMbwZ3","type":"tool_result","content":"408\t    card.on_resolve(game)\n409\t\n410\t    if card.card_types & _PERMANENT_TYPES:\n411\t        # Move from stack to battlefield via move_to_zone, which handles\n412\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n413\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n414\t    else:\n415\t        # Instant/sorcery: the spell would be put into its owner's graveyard.\n416\t        # Consult replacement effects so that effects such as \"if that spell\n417\t        # would be put into your graveyard, exile it instead\" can redirect\n418\t        # the destination zone.\n419\t        dest_zone = _resolve_spell_graveyard_destination(game, card)\n420\t        move_to_zone(game, card, Zone.STACK, dest_zone)\n421\t        # Clean up any spell-specific exile replacement / flag now that the\n422\t        # spell has left the stack.\n423\t        game.replacement_manager.unregister(card)\n424\t        if hasattr(card, \"_exile_if_goes_to_graveyard\"):\n425\t            del card._exile_if_goes_to_graveyard\n426\t\n427\t\n428\t# Destination string → Zone for spell graveyard-replacement redirection.\n429\t_SPELL_DESTINATION_ZONE_MAP: dict[str, Zone] = {\n430\t    \"graveyard\": Zone.GRAVEYARD,\n431\t    \"exile\": Zone.EXILE,\n432\t    \"hand\": Zone.HAND,\n433\t    \"library\": Zone.LIBRARY,\n434\t}\n435\t\n436\t\n437\tdef _resolve_spell_graveyard_destination(game: GameState, card: CardImpl) -> Zone:\n438\t    \"\"\"Return the zone an instant/sorcery should move to on resolution.\n439\t\n440\t    Builds a :class:`~engine.events.SpellToGraveyardReplacementEvent` and runs\n441\t    it through the replacement manager so replacement effects can redirect the\n442\t    spell (e.g. exile instead of graveyard).  Defaults to the graveyard.\n443\t    \"\"\"\n444\t    from engine.events import SpellToGraveyardReplacementEvent\n445\t\n446\t    controller = getattr(card, \"controller\", None)\n447\t    owner = getattr(card, \"owner\", None) or controller\n448\t    event = SpellToGraveyardReplacementEvent(\n449\t        destination=\"graveyard\",\n450\t        controller=controller,\n451\t        owner=owner,\n452\t        spell=card,\n453\t    )\n454\t    event = game.replacement_manager.apply(game, event)\n455\t    destination_str = getattr(event, \"destination\", \"graveyard\")\n456\t    return _SPELL_DESTINATION_ZONE_MAP.get(destination_str, Zone.GRAVEYARD)\n457\t\n458\t\n459\t# ------------------------------------------------------------------\n460\t# Play land (special action — does not use the stack)\n461\t# ------------------------------------------------------------------\n462\t\n463\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n464\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n465\t\n466\t    Requirements (all must hold):\n467\t\n468\t    * *land_card* has :attr:`CardType.LAND`.\n469\t    * *player* is the active player.\n470\t    * Current phase is a main phase.\n471\t    * The stack is empty.\n472\t    * ``player.land_plays_remaining > 0``.\n473\t    * The card is in the player's hand.\n474\t\n475\t    On success the card moves from hand to battlefield and\n476\t    ``land_plays_remaining`` is decremented.\n477\t\n478\t    Raises:\n479\t        CastingError: If any requirement is not met.\n480\t    \"\"\"\n481\t    # Must be a land\n482\t    if CardType.LAND not in land_card.card_types:\n483\t        raise CastingError(\n484\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n485\t        )\n486\t\n487\t    # Sorcery-speed timing (active player, main phase, stack empty)\n488\t    if not is_sorcery_speed(game, player):\n489\t        raise CastingError(\n490\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n491\t            \"during main phase with empty stack\"\n492\t        )\n493\t\n494\t    # Land plays remaining\n495\t    if player.land_plays_remaining <= 0:\n496\t        raise CastingError(\n497\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\""}]},"parent_tool_use_id":"toolu_01FtrFyqD3oNPonppRCGoUAu","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"4479977c-9e72-452e-85b2-36f747cd0869","timestamp":"2026-06-01T11:28:23.572Z","subagent_type":"Implementer","task_description":"Implement sos_120"}
