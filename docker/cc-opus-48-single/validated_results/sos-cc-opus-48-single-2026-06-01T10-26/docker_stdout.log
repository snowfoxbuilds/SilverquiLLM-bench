{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01MUwTogMKgTwKrKmYHm3bNB","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01HwLT93fEPmeRyMeq4ozNSZ","name":"Read","input":{"file_path":"/workspace/test_utils.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15134,"cache_read_input_tokens":12890,"cache_creation":{"ephemeral_5m_input_tokens":15134,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_019Mbmw3oikAhHtz8Xfv7wgN","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"1698f887-1d63-4ab8-9674-5f448bb41d67","request_id":"req_011CbcUafc9Wsws8fYjeU8un","subagent_type":"Tester","task_description":"Extend tests for sos_201"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HwLT93fEPmeRyMeq4ozNSZ","type":"tool_result","content":"1\t\"\"\"Test utility helpers for engine validation and benchmark agents.\n2\t\n3\tProvides convenience functions for setting up game states, casting spells,\n4\tadvancing phases, and managing combat in tests.  Each function raises\n5\tdescriptive errors on failure.\n6\t\n7\tFunctions:\n8\t    create_game — convenience wrapper to create a GameState from card lists.\n9\t    set_board_state — directly set zone contents and player state.\n10\t    cast_spell — find card in hand by name, cast, and resolve.\n11\t    advance_to_phase — fast-forward game state to a given phase/step.\n12\t    declare_attackers — advance to combat and declare attackers by name.\n13\t    declare_blockers — assign blockers by name mapping.\n14\t\"\"\"\n15\t\n16\tfrom __future__ import annotations\n17\t\n18\tfrom typing import Any\n19\t\n20\tfrom engine.card import CardImpl, Creature\n21\tfrom engine.casting import cast_spell as _engine_cast_spell\n22\tfrom engine.combat import (\n23\t    CombatState,\n24\t    declare_attackers_step,\n25\t    declare_blockers_step,\n26\t)\n27\tfrom engine.game import create_game as _engine_create_game\n28\tfrom engine.game_state import GameState, _TURN_SEQUENCE\n29\tfrom engine.mana import ManaPool\n30\tfrom engine.player import DeterministicPlayer\n31\tfrom engine.stack import priority_loop\n32\tfrom engine.types import ManaType, Phase, Step, Zone\n33\t\n34\t\n35\tclass TestSetupError(Exception):\n36\t    \"\"\"Raised when a test utility function encounters an invalid setup.\"\"\"\n37\t\n38\t\n39\tdef card_colors(card: Any) -> set[str]:\n40\t    \"\"\"Return a card's colors as single-letter strings, derived from its mana cost.\n41\t\n42\t    Hybrid pips contribute both options. {C} and {X} contribute nothing.\n43\t    Returns an empty set for cards with no mana cost or only colorless/X pips.\n44\t    Used by audited tests that previously asserted against a non-existent\n45\t    ``card.colors`` attribute.\n46\t    \"\"\"\n47\t    colors: set[str] = set()\n48\t    cost = getattr(card, \"mana_cost\", None)\n49\t    if cost is None:\n50\t        return colors\n51\t    for mt in getattr(cost, \"pips\", {}):\n52\t        if mt != ManaType.COLORLESS:\n53\t            colors.add(mt.value)\n54\t    for hybrid in getattr(cost, \"hybrid\", []):\n55\t        if hybrid.option_a != ManaType.COLORLESS:\n56\t            colors.add(hybrid.option_a.value)\n57\t        if hybrid.option_b != ManaType.COLORLESS:\n58\t            colors.add(hybrid.option_b.value)\n59\t    return colors\n60\t\n61\t\n62\t# ---------------------------------------------------------------------------\n63\t# create_game\n64\t# ---------------------------------------------------------------------------\n65\t\n66\t\n67\tdef create_game(\n68\t    deck1: list[CardImpl] | None = None,\n69\t    deck2: list[CardImpl] | None = None,\n70\t    *,\n71\t    player1_name: str = \"Player1\",\n72\t    player2_name: str = \"Player2\",\n73\t    player1_life: int = 20,\n74\t    player2_life: int = 20,\n75\t    scripts: tuple[list[Any], list[Any]] | None = None,\n76\t) -> GameState:\n77\t    \"\"\"Create a new two-player game from card lists.\n78\t\n79\t    This is a convenience wrapper around :func:`engine.game.create_game`\n80\t    that automatically creates :class:`DeterministicPlayer` instances.\n81\t\n82\t    Parameters:\n83\t        deck1: Cards for player 1's deck.  Defaults to empty list.\n84\t        deck2: Cards for player 2's deck.  Defaults to empty list.\n85\t        player1_name: Display name for player 1.\n86\t        player2_name: Display name for player 2.\n87\t        player1_life: Starting life for player 1.\n88\t        player2_life: Starting life for player 2.\n89\t        scripts: Optional tuple of ``(script1, script2)`` for\n90\t            :class:`DeterministicPlayer`.  Defaults to empty lists.\n91\t\n92\t    Returns:\n93\t        A fully initialised :class:`GameState`.\n94\t\n95\t    Raises:\n96\t        TestSetupError: If the inputs are invalid.\n97\t    \"\"\"\n98\t    if deck1 is None:\n99\t        deck1 = []\n100\t    if deck2 is None:\n101\t        deck2 = []\n102\t\n103\t    script1: list[Any] = []\n104\t    script2: list[Any] = []\n105\t    if scripts is not None:\n106\t        script1, script2 = scripts\n107\t\n108\t    p1 = DeterministicPlayer(player1_name, script=script1, life=player1_life)\n109\t    p2 = DeterministicPlayer(player2_name, script=script2, life=player2_life)\n110\t\n111\t    game = _engine_create_game(p1, p2, deck1, deck2)\n112\t\n113\t    # When decks are empty (the convenience default), engine.game.create_game\n114\t    # attempts to draw 7 cards from each empty library, which sets the\n115\t    # drawn_from_empty_library loss flag.  Reset it for the convenience case.\n116\t    for player in game.players:\n117\t        if player.drawn_from_empty_library:\n118\t            player.drawn_from_empty_library = False\n119\t\n120\t    # engine.game.create_game hardcodes life=20; restore custom values.\n121\t    if player1_life != 20:\n122\t        game.players[0].life = player1_life\n123\t    if player2_life != 20:\n124\t        game.players[1].life = player2_life\n125\t\n126\t    return game\n127\t\n128\t\n129\t# ---------------------------------------------------------------------------\n130\t# set_board_state\n131\t# ---------------------------------------------------------------------------\n132\t\n133\t\n134\tdef set_board_state(\n135\t    game: GameState,\n136\t    player_index: int,\n137\t    *,\n138\t    battlefield: list[Any] | None = None,\n139\t    hand: list[Any] | None = None,\n140\t    graveyard: list[Any] | None = None,\n141\t    life: int | None = None,\n142\t    mana: dict[ManaType, int] | None = None,\n143\t) -> None:\n144\t    \"\"\"Directly set zone contents and player state for test setup.\n145\t\n146\t    Replaces the contents of the specified zones (only zones that are\n147\t    explicitly provided are modified — others are left unchanged).\n148\t\n149\t    For each card placed into a zone, ``owner`` and ``controller`` are\n150\t    set to the target player.\n151\t\n152\t    Parameters:\n153\t        game: The game state to modify.\n154\t        player_index: Index of the player (0 or 1).\n155\t        battlefield: Cards/permanents to place on the battlefield.\n156\t        hand: Cards to place in hand.\n157\t        graveyard: Cards to place in graveyard.\n158\t        life: Life total to set (or ``None`` to leave unchanged).\n159\t        mana: Mana to add to the player's pool.  Keys are\n160\t            :class:`ManaType`, values are amounts.\n161\t\n162\t    Raises:\n163\t        TestSetupError: If ``player_index`` is out of range.\n164\t    \"\"\"\n165\t    if player_index < 0 or player_index >= len(game.players):\n166\t        raise TestSetupError(\n167\t            f\"Invalid player_index {player_index} — game has \"\n168\t            f\"{len(game.players)} players (indices 0–{len(game.players) - 1})\"\n169\t        )\n170\t\n171\t    player = game.players[player_index]\n172\t\n173\t    if life is not None:\n174\t        player.life = life\n175\t\n176\t    if mana is not None:\n177\t        player.mana_pool.empty()\n178\t        for mana_type, amount in mana.items():\n179\t            player.mana_pool.add(mana_type, amount)\n180\t\n181\t    if battlefield is not None:\n182\t        _set_zone(game, player, Zone.BATTLEFIELD, battlefield)\n183\t\n184\t    if hand is not None:\n185\t        _set_zone(game, player, Zone.HAND, hand)\n186\t\n187\t    if graveyard is not None:\n188\t        _set_zone(game, player, Zone.GRAVEYARD, graveyard)\n189\t\n190\t\n191\tdef _set_zone(\n192\t    game: GameState,\n193\t    player: Any,\n194\t    zone: Zone,\n195\t    cards: list[Any],\n196\t) -> None:\n197\t    \"\"\"Replace a zone's contents with *cards*, assigning ownership.\"\"\"\n198\t    zone_container = player.zones[zone]\n199\t    # Clear existing contents\n200\t    for obj in zone_container.get_all():\n201\t        zone_container.remove(obj)\n202\t\n203\t    # Add new contents\n204\t    for card in cards:\n205\t        card.owner = player\n206\t        card.controller = player\n207\t        zone_container.add(card)\n208\t\n209\t\n210\t# ---------------------------------------------------------------------------\n211\t# cast_spell\n212\t# ---------------------------------------------------------------------------\n213\t\n214\t\n215\tdef cast_spell(\n216\t    game: GameState,\n217\t    player_index: int,\n218\t    card_name: str,\n219\t    targets: list[Any] | None = None,\n220\t) -> None:\n221\t    \"\"\"Find a card in hand by name, cast it, and pass priority until resolved.\n222\t\n223\t    The function:\n224\t    1. Locates the first card matching *card_name* in the player's hand.\n225\t    2. Sets up the game phase/priority for sorcery-speed casting if needed.\n226\t    3. Calls :func:`engine.casting.cast_spell`.\n227\t    4. Passes priority for both players so the spell resolves.\n228\t\n229\t    Parameters:\n230\t        game: The game state.\n231\t        player_index: Index of the casting player (0 or 1).\n232\t        card_name: Name of the card to find in hand.\n233\t        targets: Optional target list.  If provided, they are scripted\n234\t            into the player's DeterministicPlayer choices.\n235\t\n236\t    Raises:\n237\t        TestSetupError: If the card is not found in hand or casting fails.\n238\t    \"\"\"\n239\t    if player_index < 0 or player_index >= len(game.players):\n240\t        raise TestSetupError(\n241\t            f\"Invalid player_index {player_index} — game has \"\n242\t            f\"{len(game.players)} players\"\n243\t        )\n244\t\n245\t    player = game.players[player_index]\n246\t    hand = game.get_hand(player)\n247\t\n248\t    # Find the card by name\n249\t    card = None\n250\t    for obj in hand.get_all():\n251\t        if getattr(obj, \"name\", None) == card_name:\n252\t            card = obj\n253\t            break\n254\t\n255\t    if card is None:\n256\t        hand_names = [getattr(c, \"name\", repr(c)) for c in hand.get_all()]\n257\t        raise TestSetupError(\n258\t            f\"Card {card_name!r} not found in player {player_index}'s hand. \"\n259\t            f\"Hand contains: {hand_names}\"\n260\t        )\n261\t\n262\t    # Ensure sorcery-speed timing for non-instant spells\n263\t    from engine.types import CardType, Keyword\n264\t\n265\t    is_instant = CardType.INSTANT in getattr(card, \"card_types\", set())\n266\t    has_flash = Keyword.FLASH in getattr(card, \"keywords\", Keyword(0))\n267\t\n268\t    if not is_instant and not has_flash:\n269\t        # Set up sorcery-speed timing: active player, main phase, empty stack\n270\t        game.active_player_index = player_index\n271\t        game.priority_player_index = player_index\n272\t        if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n273\t            game.phase = Phase.PRECOMBAT_MAIN\n274\t            game.step = None\n275\t\n276\t    # Ensure the stack is empty for sorcery-speed\n277\t    if not game.stack.is_empty():\n278\t        raise TestSetupError(\n279\t            f\"Cannot cast {card_name!r} — stack is not empty\"\n280\t        )\n281\t\n282\t    # Script targets into the player's DeterministicPlayer choices so that\n283\t    # engine.casting.cast_spell -> player.choose_target() returns them.\n284\t    if targets and isinstance(player, DeterministicPlayer):\n285\t        for target in reversed(targets):\n286\t            player._script.appendleft(target)\n287\t\n288\t    try:\n289\t        _engine_cast_spell(game, player, card)\n290\t    except Exception as exc:\n291\t        raise TestSetupError(\n292\t            f\"Failed to cast {card_name!r}: {exc}\"\n293\t        ) from exc\n294\t\n295\t    # Pass priority for both players to resolve the spell\n296\t    _resolve_top_of_stack(game)\n297\t\n298\t\n299\tdef _resolve_top_of_stack(game: GameState) -> None:\n300\t    \"\"\"Resolve the top spell/ability on the stack by passing priority.\n301\t\n302\t    Both players pass priority so the top of the stack resolves.\n303\t    Repeats until the stack is empty.\n304\t    \"\"\"\n305\t    from engine.state_based_actions import resolve_state_based_actions\n306\t\n307\t    while not game.stack.is_empty():\n308\t        obj = game.stack.pop()\n309\t        obj.on_resolve(game)\n310\t        resolve_state_based_actions(game)\n311\t\n312\t\n313\t# ---------------------------------------------------------------------------\n314\t# advance_to_phase\n315\t# ---------------------------------------------------------------------------\n316\t\n317\t\n318\tdef advance_to_phase(\n319\t    game: GameState,\n320\t    phase: Phase,\n321\t    step: Step | None = None,\n322\t) -> None:\n323\t    \"\"\"Fast-forward the game state to the specified phase/step.\n324\t\n325\t    Advances by calling :meth:`GameState.advance_phase` until the target\n326\t    phase (and optionally step) is reached.  Priority is not granted during\n327\t    fast-forwarding — this is a direct state manipulation for test setup.\n328\t\n329\t    Parameters:\n330\t        game: The game state to advance.\n331\t        phase: The target phase.\n332\t        step: The target step (or ``None`` for main phases).\n333\t\n334\t    Raises:\n335\t        TestSetupError: If the target phase/step is not found within\n336\t            a full turn cycle (prevents infinite loops).\n337\t    \"\"\"\n338\t    target = (phase, step)\n339\t\n340\t    # Validate that (phase, step) is a valid combination\n341\t    valid_targets = {(p, s) for p, s in _TURN_SEQUENCE}\n342\t    if target not in valid_targets:\n343\t        raise TestSetupError(\n344\t            f\"Invalid phase/step combination: ({phase!r}, {step!r}). \"\n345\t            f\"Valid combinations: {sorted(valid_targets, key=lambda x: str(x))}\"\n346\t        )\n347\t\n348\t    # Already there?\n349\t    if (game.phase, game.step) == target:\n350\t        return\n351\t\n352\t    # Advance up to a full turn's worth of steps to prevent infinite loops\n353\t    max_advances = len(_TURN_SEQUENCE) + 1\n354\t    for _ in range(max_advances):\n355\t        game.advance_phase()\n356\t        if (game.phase, game.step) == target:\n357\t            return\n358\t\n359\t    raise TestSetupError(\n360\t        f\"Could not reach phase/step ({phase!r}, {step!r}) within \"\n361\t        f\"a full turn cycle. Current: ({game.phase!r}, {game.step!r})\"\n362\t    )\n363\t\n364\t\n365\t# ---------------------------------------------------------------------------\n366\t# declare_attackers\n367\t# ---------------------------------------------------------------------------\n368\t\n369\t\n370\tdef declare_attackers(\n371\t    game: GameState,\n372\t    attacker_names: list[str],\n373\t) -> None:\n374\t    \"\"\"Advance to combat and declare attackers by name.\n375\t\n376\t    1. Advances to the Declare Attackers step if not already there.\n377\t    2. Finds creatures on the active player's battlefield matching the\n378\t       given names.\n379\t    3. Scripts the active player's ``choose`` method to return those\n380\t       creatures.\n381\t    4. Calls :func:`engine.combat.declare_attackers_step`.\n382\t\n383\t    Parameters:\n384\t        game: The game state.\n385\t        attacker_names: Names of creatures to declare as attackers.\n386\t\n387\t    Raises:\n388\t        TestSetupError: If any named creature is not found on the\n389\t            active player's battlefield, or if the creature cannot attack.\n390\t    \"\"\"\n391\t    # Advance to declare attackers step\n392\t    if (game.phase, game.step) != (Phase.COMBAT, Step.DECLARE_ATTACKERS):\n393\t        advance_to_phase(game, Phase.COMBAT, Step.DECLARE_ATTACKERS)\n394\t\n395\t    active = game.active_player\n396\t    bf = game.get_battlefield(active)\n397\t\n398\t    # Resolve attacker names to objects\n399\t    attackers: list[Any] = []\n400\t    bf_objects = bf.get_all()\n401\t    for name in attacker_names:\n402\t        found = None\n403\t        for obj in bf_objects:\n404\t            if getattr(obj, \"name\", None) == name and obj not in attackers:\n405\t                found = obj\n406\t                break\n407\t        if found is None:\n408\t            bf_names = [getattr(c, \"name\", repr(c)) for c in bf_objects]\n409\t            raise TestSetupError(\n410\t                f\"Attacker {name!r} not found on active player's battlefield. \"\n411\t                f\"Battlefield contains: {bf_names}\"\n412\t            )\n413\t        attackers.append(found)\n414\t\n415\t    # Script the active player to choose these attackers\n416\t    if isinstance(active, DeterministicPlayer):\n417\t        active._script.appendleft(attackers)\n418\t    else:\n419\t        raise TestSetupError(\n420\t            \"declare_attackers requires active player to be a DeterministicPlayer\"\n421\t        )\n422\t\n423\t    game.combat_state.in_combat = True\n424\t    declare_attackers_step(game)\n425\t\n426\t\n427\t# ---------------------------------------------------------------------------\n428\t# declare_blockers\n429\t# ---------------------------------------------------------------------------\n430\t\n431\t\n432\tdef declare_blockers(\n433\t    game: GameState,\n434\t    assignments: dict[str, list[str]],\n435\t) -> None:\n436\t    \"\"\"Assign blockers by name mapping.\n437\t\n438\t    Parameters:\n439\t        game: The game state.\n440\t        assignments: A mapping of ``{\"attacker_name\": [\"blocker_name\", ...]}``.\n441\t            Each attacker on the active player's battlefield is matched by\n442\t            name, and each blocker on the defending player's battlefield is\n443\t            matched by name.\n444\t\n445\t    Raises:\n446\t        TestSetupError: If any named creature is not found.\n447\t    \"\"\"\n448\t    if (game.phase, game.step) != (Phase.COMBAT, Step.DECLARE_BLOCKERS):\n449\t        advance_to_phase(game, Phase.COMBAT, Step.DECLARE_BLOCKERS)\n450\t\n451\t    active = game.active_player\n452\t    defending = game.non_active_player\n453\t\n454\t    active_bf = game.get_battlefield(active)\n455\t    defending_bf = game.get_battlefield(defending)\n456\t\n457\t    active_objects = active_bf.get_all()\n458\t    defending_objects = defending_bf.get_all()\n459\t\n460\t    # Build mapping of blocker_obj → attacker_obj\n461\t    block_map: dict[Any, Any] = {}\n462\t\n463\t    for attacker_name, blocker_names in assignments.items():\n464\t        # Find attacker\n465\t        attacker = None\n466\t        for obj in active_objects:\n467\t            if getattr(obj, \"name\", None) == attacker_name:\n468\t                attacker = obj\n469\t                break\n470\t        if attacker is None:\n471\t            raise TestSetupError(\n472\t                f\"Attacker {attacker_name!r} not found on active player's battlefield. \"\n473\t                f\"Available: {[getattr(c, 'name', repr(c)) for c in active_objects]}\"\n474\t            )\n475\t\n476\t        for blocker_name in blocker_names:\n477\t            blocker = None\n478\t            for obj in defending_objects:\n479\t                if getattr(obj, \"name\", None) == blocker_name and obj not in block_map:\n480\t                    blocker = obj\n481\t                    break\n482\t            if blocker is None:\n483\t                raise TestSetupError(\n484\t                    f\"Blocker {blocker_name!r} not found on defending player's battlefield. \"\n485\t                    f\"Available: {[getattr(c, 'name', repr(c)) for c in defending_objects]}\"\n486\t                )\n487\t            block_map[blocker] = attacker\n488\t\n489\t    # Script the defending player to choose these block assignments\n490\t    if isinstance(defending, DeterministicPlayer):\n491\t        defending._script.appendleft(block_map)\n492\t    else:\n493\t        raise TestSetupError(\n494\t            \"declare_blockers requires defending player to be a DeterministicPlayer\"\n495\t        )\n496\t\n497\t    declare_blockers_step(game)\n498\t"}]},"parent_tool_use_id":"toolu_019Mbmw3oikAhHtz8Xfv7wgN","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"4701cc5c-a3a6-4832-9b9c-0ae63fef181c","timestamp":"2026-06-01T11:40:07.746Z","subagent_type":"Tester","task_description":"Extend tests for sos_201"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017SFWrrkpDn5KUBvKWxnNwz","type":"tool_result","content":"1\t\"\"\"Casting and resolution pipeline for spells and lands.\n2\t\n3\tProvides the full flow from casting a spell or playing a land through\n4\tresolution:\n5\t\n6\t- :func:`cast_spell` — verify timing & legality → move hand to stack →\n7\t  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n8\t- :func:`play_land` — verify land play remaining → move hand to\n9\t  battlefield → decrement ``land_plays_remaining``.\n10\t- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n11\t  helpers used by the casting pipeline.\n12\t\n13\tResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\n14\tcreated by :func:`cast_spell`:\n15\t\n16\t- Call ``card.on_resolve(game)``.\n17\t- Permanents (creature / enchantment / artifact / planeswalker) move from\n18\t  the stack to the battlefield.\n19\t- Non-permanents (instant / sorcery) move to the graveyard.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import TYPE_CHECKING, Any\n25\t\n26\tfrom engine.card import CardImpl\n27\tfrom engine.stack import StackObject\n28\tfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\n29\tfrom engine.zones import move_zone\n30\t\n31\tif TYPE_CHECKING:\n32\t    from engine.game_state import GameState\n33\t    from engine.player import Player\n34\t\n35\t\n36\t# Card types that represent permanents — these go to the battlefield on resolve.\n37\t_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n38\t    CardType.CREATURE,\n39\t    CardType.ENCHANTMENT,\n40\t    CardType.ARTIFACT,\n41\t    CardType.PLANESWALKER,\n42\t})\n43\t\n44\t\n45\tclass CastingError(Exception):\n46\t    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n47\t\n48\t\n49\t# ------------------------------------------------------------------\n50\t# Timing helpers\n51\t# ------------------------------------------------------------------\n52\t\n53\tdef is_sorcery_speed(game: GameState, player: Player) -> bool:\n54\t    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n55\t\n56\t    Sorcery speed requires all of:\n57\t\n58\t    * *player* is the active player.\n59\t    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n60\t      ``POSTCOMBAT_MAIN``).\n61\t    * The stack is empty.\n62\t    \"\"\"\n63\t    if player is not game.active_player:\n64\t        return False\n65\t    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n66\t        return False\n67\t    if not game.stack.is_empty():\n68\t        return False\n69\t    return True\n70\t\n71\t\n72\tdef can_cast_at_instant_speed(card: CardImpl) -> bool:\n73\t    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n74\t\n75\t    A card has instant-speed timing if it is an instant or has the\n76\t    :attr:`~engine.types.Keyword.FLASH` keyword.\n77\t    \"\"\"\n78\t    if CardType.INSTANT in card.card_types:\n79\t        return True\n80\t    if Keyword.FLASH & card.keywords:\n81\t        return True\n82\t    return False\n83\t\n84\t\n85\t# ------------------------------------------------------------------\n86\t# Cost reduction\n87\t# ------------------------------------------------------------------\n88\t\n89\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n90\t    \"\"\"Return the generic mana reduction for casting *card*.\n91\t\n92\t    Queries ``card.cost_reduction(game)`` and clamps the result so that\n93\t    the generic portion of the mana cost cannot go below 0.\n94\t\n95\t    This is a simplified single-card self-reduction model.  Full MTG\n96\t    cost-reduction interactions (Trinisphere, multiple reductions from\n97\t    different sources) are deferred.\n98\t    \"\"\"\n99\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n100\t    # casting player even when the card was never explicitly assigned one.\n101\t    prev_controller = card.controller\n102\t    card.controller = controller\n103\t    raw = card.cost_reduction(game)\n104\t    # Restore previous controller in case the caller doesn't want a\n105\t    # side-effect (get_cost_reduction is a query, not a mutation).\n106\t    card.controller = prev_controller\n107\t    generic = card.mana_cost.generic if card.mana_cost else 0\n108\t    return max(0, min(raw, generic))\n109\t\n110\t\n111\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n112\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n113\t    new_generic = max(0, cost.generic - reduction)\n114\t    return ManaCost(\n115\t        generic=new_generic,\n116\t        pips=dict(cost.pips),\n117\t        x_count=cost.x_count,\n118\t        hybrid=list(cost.hybrid),\n119\t    )\n120\t\n121\t\n122\t# ------------------------------------------------------------------\n123\t# Cast spell\n124\t# ------------------------------------------------------------------\n125\t\n126\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n127\t    \"\"\"Cast *card* from *player*'s hand.\n128\t\n129\t    Pipeline\n130\t    --------\n131\t    1. **Timing check** — instants (and cards with flash) can be cast\n132\t       whenever the player has priority; everything else requires\n133\t       sorcery-speed timing.\n134\t    2. **can_cast** — ask the card whether it can legally be cast.\n135\t    3. **Hand check** — the card must be in the player's hand.\n136\t    4. **Move hand → stack zone** — remove the card from the hand and\n137\t       place it into the player's stack zone.\n138\t    5. **Choose targets** — if the card specifies targets (via\n139\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n140\t    6. **Mana check / payment** — the player's mana pool must be able to\n141\t       pay the card's mana cost.  If payment fails, the card is rolled\n142\t       back from the stack zone to the hand.\n143\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n144\t    8. **Push StackObject** — push a :class:`StackObject` whose\n145\t       ``on_resolve`` callback handles resolution.\n146\t\n147\t    Raises:\n148\t        CastingError: If any legality check fails.\n149\t    \"\"\"\n150\t    # 1. Timing\n151\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n152\t        raise CastingError(\n153\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n154\t        )\n155\t\n156\t    # 2. can_cast\n157\t    if not card.can_cast(game):\n158\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n159\t\n160\t    # 3. Hand check\n161\t    hand = game.get_hand(player)\n162\t    if not hand.contains(card):\n163\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n164\t\n165\t    # 4. Move card from hand to stack zone\n166\t    stack_zone = player.zones[Zone.STACK]\n167\t    hand.remove(card)\n168\t    stack_zone.add(card)\n169\t\n170\t    # Clear any stale colors_spent from a prior cast before new payment.\n171\t    if hasattr(card, \"colors_spent\"):\n172\t        del card.colors_spent\n173\t\n174\t    # 5. Choose targets\n175\t    target_specs = card.get_targets(game)\n176\t    chosen_targets: list[Any] = []\n177\t    if target_specs:\n178\t        for spec in target_specs:\n179\t            target = player.choose_target(target_specs, spec)\n180\t            # Validate against filter_fn if the spec provides one\n181\t            filter_fn = getattr(spec, \"filter_fn\", None)\n182\t            if filter_fn is not None and target is not None:\n183\t                if not filter_fn(target):\n184\t                    stack_zone.remove(card)\n185\t                    hand.add(card)\n186\t                    raise CastingError(\n187\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n188\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n189\t                    )\n190\t            chosen_targets.append(target)\n191\t\n192\t    # 5b. Protection check — reject targets that have protection from this\n193\t    #     spell (the T in DEBT).\n194\t    from engine.protection import has_protection_from\n195\t\n196\t    for target in chosen_targets:\n197\t        if has_protection_from(target, card):\n198\t            # Rollback: move card from stack zone back to hand\n199\t            stack_zone.remove(card)\n200\t            hand.add(card)\n201\t            raise CastingError(\n202\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n203\t            )\n204\t\n205\t    # Targets are stored on the StackObject (not the card) and passed\n206\t    # through the resolve pipeline via on_resolve(game, targets=...).\n207\t\n208\t    # 6. Mana check / payment (rollback on failure)\n209\t    # Ensure the card knows its controller so that cost_reduction() hooks\n210\t    # (e.g. Embercleave counting attacking creatures you control) see the\n211\t    # casting player, even for cards that were added to hand without an\n212\t    # explicit controller assignment.\n213\t    if card.controller is None:\n214\t        card.controller = player\n215\t    reduction = get_cost_reduction(game, card, player)\n216\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n217\t\n218\t    if not player.mana_pool.can_pay(effective_cost):\n219\t        # Rollback: move card from stack zone back to hand\n220\t        stack_zone.remove(card)\n221\t        hand.add(card)\n222\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n223\t\n224\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n225\t    player.mana_pool.pay(effective_cost)\n226\t\n227\t    # Store colors of mana spent on the card for mechanics like Converge\n228\t    # that care about the colors used to cast the spell.\n229\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n230\t\n231\t    # Record the TOTAL amount of mana spent to cast this spell (rule 107.7).\n232\t    # Unlike the printed mana value, this reflects actual mana paid, so X\n233\t    # spells / cost-reduced spells diverge from CMC.  Effects such as Mana\n234\t    # Sculpt read this at resolution.\n235\t    card.mana_spent = player.mana_pool.last_payment_total  # type: ignore[attr-defined]\n236\t\n237\t    # 7. Call on_cast hook\n238\t    card.on_cast(game)\n239\t\n240\t    # 8. Build on_resolve callback and push StackObject\n241\t    stack_obj = StackObject(\n242\t        source=card,\n243\t        controller=player,\n244\t        targets=chosen_targets,\n245\t        on_resolve=lambda g: None,  # replaced below\n246\t    )\n247\t\n248\t    def _on_resolve(g: GameState) -> None:\n249\t        _resolve_spell(g, card, player, stack_obj)\n250\t\n251\t    stack_obj.on_resolve = _on_resolve\n252\t    game.stack.push(stack_obj)\n253\t\n254\t\n255\t# ------------------------------------------------------------------\n256\t# Cast spell without paying mana cost (free-cast from any zone)\n257\t# ------------------------------------------------------------------\n258\t\n259\t\n260\tdef cast_spell_free(\n261\t    game: GameState,\n262\t    player: Player,\n263\t    card: CardImpl,\n264\t    from_zone: Zone,\n265\t) -> None:\n266\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n267\t\n268\t    This is used by effects that allow casting from zones other than hand\n269\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n270\t    or cascade.\n271\t\n272\t    Pipeline\n273\t    --------\n274\t    1. **can_cast** — ask the card whether it can legally be cast (same\n275\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n276\t    2. Move *card* from *from_zone* to the stack zone.\n277\t    3. Choose targets (if applicable) with validation and protection check.\n278\t    4. Call ``on_cast`` hook.\n279\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n280\t       resolution normally (permanents → battlefield, non-permanents →\n281\t       graveyard).\n282\t\n283\t    No timing check or mana payment is performed.  The spell goes on the\n284\t    stack and can be responded to normally (e.g. countered).\n285\t\n286\t    If targeting or other post-move checks fail, the card is rolled back\n287\t    to its source zone.\n288\t\n289\t    Parameters:\n290\t        game: The current game state.\n291\t        player: The player casting the spell.\n292\t        card: The card to cast.\n293\t        from_zone: The zone the card is currently in.\n294\t\n295\t    Raises:\n296\t        CastingError: If the card cannot be found in *from_zone* or\n297\t            legality checks fail.\n298\t    \"\"\"\n299\t    from engine.zones import move_to_zone\n300\t\n301\t    # Ensure controller is set\n302\t    card.controller = player\n303\t    if card.owner is None:\n304\t        card.owner = player\n305\t\n306\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n307\t    if not card.can_cast(game):\n308\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n309\t\n310\t    # 2. Locate card in source zone\n311\t    source_zone_container = player.zones[from_zone]\n312\t    if not source_zone_container.contains(card):\n313\t        # Try to find the card in any player's zone\n314\t        source_zone_container = None\n315\t        for p in game.players:\n316\t            z = p.zones[from_zone]\n317\t            if z.contains(card):\n318\t                source_zone_container = z\n319\t                break\n320\t\n321\t    if source_zone_container is None or not source_zone_container.contains(card):\n322\t        raise CastingError(\n323\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n324\t        )\n325\t\n326\t    # Move card from source zone to stack zone\n327\t    stack_zone = player.zones[Zone.STACK]\n328\t    source_zone_container.remove(card)\n329\t    stack_zone.add(card)\n330\t\n331\t    # 3. Choose targets (with rollback on failure)\n332\t    try:\n333\t        target_specs = card.get_targets(game)\n334\t        chosen_targets: list[Any] = []\n335\t        if target_specs:\n336\t            for spec in target_specs:\n337\t                target = player.choose_target(target_specs, spec)\n338\t                # Validate against filter_fn if the spec provides one\n339\t                filter_fn = getattr(spec, \"filter_fn\", None)\n340\t                if filter_fn is not None and target is not None:\n341\t                    if not filter_fn(target):\n342\t                        raise CastingError(\n343\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n344\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n345\t                        )\n346\t                chosen_targets.append(target)\n347\t\n348\t        # Protection check — reject targets that have protection from this spell\n349\t        from engine.protection import has_protection_from\n350\t\n351\t        for target in chosen_targets:\n352\t            if has_protection_from(target, card):\n353\t                raise CastingError(\n354\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n355\t                )\n356\t    except Exception as exc:\n357\t        # Rollback: move card from stack zone back to source zone\n358\t        stack_zone.remove(card)\n359\t        source_zone_container.add(card)\n360\t        raise CastingError(str(exc)) from exc\n361\t\n362\t    # 4. Call on_cast hook\n363\t    card.on_cast(game)\n364\t\n365\t    # 5. Build on_resolve callback and push StackObject\n366\t    stack_obj = StackObject(\n367\t        source=card,\n368\t        controller=player,\n369\t        targets=chosen_targets,\n370\t        on_resolve=lambda g: None,  # replaced below\n371\t    )\n372\t\n373\t    def _on_resolve(g: GameState) -> None:\n374\t        _resolve_spell(g, card, player, stack_obj)\n375\t\n376\t    stack_obj.on_resolve = _on_resolve\n377\t    game.stack.push(stack_obj)\n378\t\n379\t\n380\t# ------------------------------------------------------------------\n381\t# Cast spell paying an alternative cost (e.g. miracle)\n382\t# ------------------------------------------------------------------\n383\t\n384\t\n385\tdef cast_spell_alternative(\n386\t    game: GameState,\n387\t    player: Player,\n388\t    card: CardImpl,\n389\t    alternative_cost: ManaCost,\n390\t    from_zone: Zone = Zone.HAND,\n391\t) -> None:\n392\t    \"\"\"Cast *card* paying *alternative_cost* instead of its mana cost.\n393\t\n394\t    Used by alternative-cost mechanics such as **miracle** (rule 702.94),\n395\t    where the spell is cast \"by paying [cost] rather than its mana cost\".\n396\t    The alternative cost is paid as a normal mana cost from *player*'s pool.\n397\t\n398\t    Unlike :func:`cast_spell` this skips the normal sorcery-speed/instant\n399\t    timing check (miracle casts happen at draw time, outside normal timing),\n400\t    but otherwise mirrors the cast pipeline: ``can_cast`` legality, target\n401\t    choice/validation, mana payment (with rollback on failure), the\n402\t    ``on_cast`` hook, and pushing a resolving :class:`StackObject`.\n403\t\n404\t    Parameters:\n405\t        game: The current game state.\n406\t        player: The player casting the spell.\n407\t        card: The card to cast (must be in *from_zone*).\n408\t        alternative_cost: The :class:`ManaCost` to pay instead of\n409\t            ``card.mana_cost``.\n410\t        from_zone: The zone the card is currently in (default hand).\n411\t\n412\t    Raises:\n413\t        CastingError: If any legality check fails or mana cannot be paid.\n414\t    \"\"\"\n415\t    if card.controller is None:\n416\t        card.controller = player\n417\t    if card.owner is None:\n418\t        card.owner = player\n419\t\n420\t    # can_cast legality (timing is intentionally skipped for miracle casts).\n421\t    if not card.can_cast(game):\n422\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n423\t\n424\t    source_zone = player.zones[from_zone]\n425\t    if not source_zone.contains(card):\n426\t        raise CastingError(\n427\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n428\t        )\n429\t\n430\t    stack_zone = player.zones[Zone.STACK]\n431\t    source_zone.remove(card)\n432\t    stack_zone.add(card)\n433\t\n434\t    if hasattr(card, \"colors_spent\"):\n435\t        del card.colors_spent\n436\t\n437\t    # Choose targets (with rollback to the source zone on failure).\n438\t    try:\n439\t        target_specs = card.get_targets(game)\n440\t        chosen_targets: list[Any] = []\n441\t        if target_specs:\n442\t            for spec in target_specs:\n443\t                target = player.choose_target(target_specs, spec)\n444\t                filter_fn = getattr(spec, \"filter_fn\", None)\n445\t                if filter_fn is not None and target is not None:\n446\t                    if not filter_fn(target):\n447\t                        raise CastingError(\n448\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n449\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n450\t                        )\n451\t                chosen_targets.append(target)\n452\t\n453\t        from engine.protection import has_protection_from\n454\t\n455\t        for target in chosen_targets:\n456\t            if has_protection_from(target, card):\n457\t                raise CastingError(\n458\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n459\t                )\n460\t    except Exception as exc:\n461\t        stack_zone.remove(card)\n462\t        source_zone.add(card)\n463\t        raise CastingError(str(exc)) from exc\n464\t\n465\t    # Pay the alternative cost (rollback on failure).\n466\t    if not player.mana_pool.can_pay(alternative_cost):\n467\t        stack_zone.remove(card)\n468\t        source_zone.add(card)\n469\t        raise CastingError(\n470\t            f\"Cannot cast {card.name!r} — insufficient mana for alternative cost\"\n471\t        )\n472\t    player.mana_pool.pay(alternative_cost)\n473\t\n474\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n475\t    card.mana_spent = player.mana_pool.last_payment_total  # type: ignore[attr-defined]\n476\t\n477\t    card.on_cast(game)\n478\t\n479\t    stack_obj = StackObject(\n480\t        source=card,\n481\t        controller=player,\n482\t        targets=chosen_targets,\n483\t        on_resolve=lambda g: None,  # replaced below\n484\t    )\n485\t\n486\t    def _on_resolve(g: GameState) -> None:\n487\t        _resolve_spell(g, card, player, stack_obj)\n488\t\n489\t    stack_obj.on_resolve = _on_resolve\n490\t    game.stack.push(stack_obj)\n491\t\n492\t\n493\t# ------------------------------------------------------------------\n494\t# Resolution (called when the stack pops)\n495\t# ------------------------------------------------------------------\n496\t\n497\tdef _resolve_spell(\n498\t    game: GameState,\n499\t    card: CardImpl,\n500\t    player: Player,\n501\t    stack_obj: StackObject,\n502\t) -> None:\n503\t    \"\"\"Resolve *card* cast by *player*.\n504\t\n505\t    1. Call ``card.on_resolve(game, targets=targets)``.\n506\t    2. Remove the card from the stack zone.\n507\t    3. If the card is a permanent type, move it to the battlefield via\n508\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n509\t       registration and the ETB event).\n510\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n511\t    \"\"\"\n512\t    from engine.zones import move_to_zone\n513\t\n514\t    # Read targets from the StackObject — the single source of truth.\n515\t    # Set chosen_targets on the card just before resolution so that\n516\t    # _get_chosen_target helpers (which read via getattr) work.\n517\t    targets = stack_obj.targets\n518\t    if targets is not None:\n519\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n520\t\n521\t    card.on_resolve(game)\n522\t\n523\t    if card.card_types & _PERMANENT_TYPES:\n524\t        # Move from stack to battlefield via move_to_zone, which handles\n525\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n526\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n527\t    else:\n528\t        # Instant/sorcery: the spell would be put into its owner's graveyard.\n529\t        # Consult replacement effects so that effects such as \"if that spell\n530\t        # would be put into your graveyard, exile it instead\" can redirect\n531\t        # the destination zone.\n532\t        dest_zone = _resolve_spell_graveyard_destination(game, card)\n533\t        move_to_zone(game, card, Zone.STACK, dest_zone)\n534\t        # Clean up any spell-specific exile replacement / flag now that the\n535\t        # spell has left the stack.\n536\t        game.replacement_manager.unregister(card)\n537\t        if hasattr(card, \"_exile_if_goes_to_graveyard\"):\n538\t            del card._exile_if_goes_to_graveyard\n539\t\n540\t\n541\t# Destination string → Zone for spell graveyard-replacement redirection.\n542\t_SPELL_DESTINATION_ZONE_MAP: dict[str, Zone] = {\n543\t    \"graveyard\": Zone.GRAVEYARD,\n544\t    \"exile\": Zone.EXILE,\n545\t    \"hand\": Zone.HAND,\n546\t    \"library\": Zone.LIBRARY,\n547\t}\n548\t\n549\t\n550\tdef _resolve_spell_graveyard_destination(game: GameState, card: CardImpl) -> Zone:\n551\t    \"\"\"Return the zone an instant/sorcery should move to on resolution.\n552\t\n553\t    Builds a :class:`~engine.events.SpellToGraveyardReplacementEvent` and runs\n554\t    it through the replacement manager so replacement effects can redirect the\n555\t    spell (e.g. exile instead of graveyard).  Defaults to the graveyard.\n556\t    \"\"\"\n557\t    from engine.events import SpellToGraveyardReplacementEvent\n558\t\n559\t    controller = getattr(card, \"controller\", None)\n560\t    owner = getattr(card, \"owner\", None) or controller\n561\t    event = SpellToGraveyardReplacementEvent(\n562\t        destination=\"graveyard\",\n563\t        controller=controller,\n564\t        owner=owner,\n565\t        spell=card,\n566\t    )\n567\t    event = game.replacement_manager.apply(game, event)\n568\t    destination_str = getattr(event, \"destination\", \"graveyard\")\n569\t    return _SPELL_DESTINATION_ZONE_MAP.get(destination_str, Zone.GRAVEYARD)\n570\t\n571\t\n572\t# ------------------------------------------------------------------\n573\t# Play land (special action — does not use the stack)\n574\t# ------------------------------------------------------------------\n575\t\n576\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n577\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n578\t\n579\t    Requirements (all must hold):\n580\t\n581\t    * *land_card* has :attr:`CardType.LAND`.\n582\t    * *player* is the active player.\n583\t    * Current phase is a main phase.\n584\t    * The stack is empty.\n585\t    * ``player.land_plays_remaining > 0``.\n586\t    * The card is in the player's hand.\n587\t\n588\t    On success the card moves from hand to battlefield and\n589\t    ``land_plays_remaining`` is decremented.\n590\t\n591\t    Raises:\n592\t        CastingError: If any requirement is not met.\n593\t    \"\"\"\n594\t    # Must be a land\n595\t    if CardType.LAND not in land_card.card_types:\n596\t        raise CastingError(\n597\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n598\t        )\n599\t\n600\t    # Sorcery-speed timing (active player, main phase, stack empty)\n601\t    if not is_sorcery_speed(game, player):\n602\t        raise CastingError(\n603\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n604\t            \"during main phase with empty stack\"\n605\t        )\n606\t\n607\t    # Land plays remaining\n608\t    if player.land_plays_remaining <= 0:\n609\t        raise CastingError(\n610\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n611\t        )\n612\t\n613\t    # Card must be in hand\n614\t    hand = game.get_hand(player)\n615\t    if not hand.contains(land_card):\n616\t        raise CastingError(\n617\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n618\t        )\n619\t\n620\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n621\t    if land_card.owner is None:\n622\t        land_card.owner = player\n623\t    land_card.controller = player\n624\t\n625\t    # Move from hand to battlefield via move_to_zone, which fires\n626\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n627\t    from engine.zones import move_to_zone\n628\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n629\t\n630\t    # Decrement land plays\n631\t    player.land_plays_remaining -= 1\n632\t\n633\t\n634\tdef cast_prepared_spell(\n635\t    game: GameState,\n636\t    permanent: Any,\n637\t    targets: list[Any] | None = None,\n638\t) -> StackObject | None:\n639\t    \"\"\"Cast a copy of *permanent*'s prepare spell while it is prepared.\n640\t\n641\t    This implements the SOS **Prepared** mechanic\n642\t    (rules text: \"While it's prepared, you may cast a copy of its spell.\n643\t    Doing so unprepares it.\").\n644\t\n645\t    A prepared permanent exposes:\n646\t\n647\t    * a truthy ``is_prepared`` flag, and\n648\t    * a ``prepare_spell`` attribute — a :class:`~engine.card.CardImpl` (the\n649\t      inset spell, e.g. Swords to Plowshares).\n650\t\n651\t    This helper creates a *copy* of that prepare spell, places it in the\n652\t    controller's exile zone, casts it for free (no mana cost) onto the stack,\n653\t    and clears the permanent's prepared designation. The returned\n654\t    :class:`StackObject` can be resolved to apply the prepare spell's effect.\n655\t\n656\t    Parameters:\n657\t        game: The current game state.\n658\t        permanent: The prepared permanent (must have ``is_prepared`` truthy\n659\t            and a ``prepare_spell``).\n660\t        targets: Optional explicit targets for the copy. If provided, they\n661\t            are scripted into the controller's choices so the copy resolves\n662\t            against them.\n663\t\n664\t    Returns:\n665\t        The :class:`StackObject` for the prepare-spell copy, or ``None`` if\n666\t        *permanent* is not prepared / exposes no prepare spell.\n667\t    \"\"\"\n668\t    import copy as _copy\n669\t\n670\t    if not getattr(permanent, \"is_prepared\", False):\n671\t        return None\n672\t    prepare_spell = getattr(permanent, \"prepare_spell\", None)\n673\t    if prepare_spell is None:\n674\t        return None\n675\t\n676\t    controller = getattr(permanent, \"controller\", None) or game.active_player\n677\t\n678\t    # Build a fresh copy of the prepare spell so the original face stays put.\n679\t    spell_copy = _copy.copy(prepare_spell)\n680\t    # Give the copy a unique identity & clean target state.\n681\t    from engine.card import GameObject as _GameObject\n682\t\n683\t    spell_copy.object_id = _GameObject._next_id\n684\t    _GameObject._next_id += 1\n685\t    spell_copy.controller = controller\n686\t    spell_copy.owner = controller\n687\t    if hasattr(spell_copy, \"chosen_targets\"):\n688\t        spell_copy.chosen_targets = []\n689\t\n690\t    # Casting unprepares the permanent (rule text: \"Doing so unprepares it.\").\n691\t    permanent.is_prepared = False\n692\t\n693\t    # Place the copy in exile so it is cast \"from exile\" like a real copy.\n694\t    exile_zone = controller.zones[Zone.EXILE]\n695\t    exile_zone.add(spell_copy)\n696\t\n697\t    stack_before = len(game.stack)\n698\t\n699\t    # Script the explicit targets so cast_spell_free's target choices resolve.\n700\t    if targets:\n701\t        appendleft = getattr(getattr(controller, \"_script\", None), \"appendleft\", None)\n702\t        if appendleft is not None:\n703\t            for target in reversed(targets):\n704\t                controller._script.appendleft(target)\n705\t\n706\t    cast_spell_free(game, controller, spell_copy, Zone.EXILE)\n707\t\n708\t    if len(game.stack) > stack_before:\n709\t        return game.stack.peek()\n710\t    return None\n711\t\n712\t\n713\tdef resolve_top(game: GameState) -> None:\n714\t    \"\"\"Resolve the top spell/ability on the stack.\n715\t\n716\t    Pops the top item from the stack, calls its on_resolve callback,\n717\t    then runs state-based actions.  If the stack is empty this is a no-op.\n718\t    \"\"\"\n719\t    if game.stack.is_empty():\n720\t        return\n721\t    from engine.state_based_actions import resolve_state_based_actions\n722\t\n723\t    obj = game.stack.pop()\n724\t    obj.on_resolve(game)\n725\t    resolve_state_based_actions(game)\n726\t"}]},"parent_tool_use_id":"toolu_019Mbmw3oikAhHtz8Xfv7wgN","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"05845e01-e4f2-4e20-ab3e-0e5993573b2f","timestamp":"2026-06-01T11:40:07.849Z","subagent_type":"Tester","task_description":"Extend tests for sos_201"}
