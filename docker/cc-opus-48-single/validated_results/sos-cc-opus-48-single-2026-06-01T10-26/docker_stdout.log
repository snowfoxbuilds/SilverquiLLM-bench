{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MYFcJXoFeFi6q5tDSUmtvq","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_57/card_impl.py b/cards/sos/sos_57/card_impl.py\n2\tindex 732a555..7356ee4 100644\n3\t--- a/cards/sos/sos_57/card_impl.py\n4\t+++ b/cards/sos/sos_57/card_impl.py\n5\t@@ -1,16 +1,188 @@\n6\t-\"\"\"Card implementation for Mana Sculpt.\"\"\"\n7\t+\"\"\"Card implementation for Mana Sculpt (SOS 57).\"\"\"\n8\t \n9\t from __future__ import annotations\n10\t \n11\t-from engine.card import CardImpl\n12\t+from typing import TYPE_CHECKING, Any\n13\t \n14\t-from typing import TYPE_CHECKING\n15\t+from engine.card import Instant\n16\t+from engine.types import CardType, ManaCost, ManaType, TargetRequirement, Zone\n17\t \n18\t if TYPE_CHECKING:\n19\t     from engine.game_state import GameState\n20\t \n21\t \n22\t-class ManaSculpt(CardImpl):\n23\t-    \"\"\"TODO: Implement Mana Sculpt.\"\"\"\n24\t+# Card types that identify an object on the stack as a \"spell\".\n25\t+_SPELL_TYPES = frozenset(\n26\t+    {\n27\t+        CardType.INSTANT,\n28\t+        CardType.SORCERY,\n29\t+        CardType.CREATURE,\n30\t+        CardType.ENCHANTMENT,\n31\t+        CardType.ARTIFACT,\n32\t+        CardType.PLANESWALKER,\n33\t+    }\n34\t+)\n35\t \n36\t-    pass\n37\t+\n38\t+def _is_spell(obj: Any) -> bool:\n39\t+    \"\"\"Return ``True`` if *obj* is a castable spell (not a player/permanent-only).\n40\t+\n41\t+    \"Target spell\" is not \"any target\": players are illegal, and the object\n42\t+    must carry spell card types.\n43\t+    \"\"\"\n44\t+    if obj is None:\n45\t+        return False\n46\t+    # Players expose ``life`` — reject them (\"target spell\" excludes players).\n47\t+    if hasattr(obj, \"life\"):\n48\t+        return False\n49\t+    card_types = getattr(obj, \"card_types\", None)\n50\t+    if not card_types:\n51\t+        return False\n52\t+    return bool(card_types & _SPELL_TYPES)\n53\t+\n54\t+\n55\t+def _controls_wizard(game: \"GameState\", player: Any) -> bool:\n56\t+    \"\"\"Return ``True`` if *player* controls a creature with the Wizard subtype.\"\"\"\n57\t+    if player is None:\n58\t+        return False\n59\t+    battlefield = player.zones[Zone.BATTLEFIELD]\n60\t+    for obj in battlefield.get_all():\n61\t+        subtypes = getattr(obj, \"subtypes\", set()) or set()\n62\t+        if \"Wizard\" in subtypes:\n63\t+            return True\n64\t+    return False\n65\t+\n66\t+\n67\t+def _mana_spent_on(spell: Any) -> int:\n68\t+    \"\"\"Return the amount of mana spent to cast *spell*.\n69\t+\n70\t+    Prefers the engine-recorded ``mana_spent`` (the actual total mana paid;\n71\t+    see :attr:`engine.mana.ManaPool.last_payment_total`). Falls back to the\n72\t+    printed mana value when the spell was not cast through the normal\n73\t+    payment pipeline (e.g. placed on the stack directly in tests).\n74\t+    \"\"\"\n75\t+    recorded = getattr(spell, \"mana_spent\", None)\n76\t+    if recorded is not None:\n77\t+        return int(recorded)\n78\t+    cost = getattr(spell, \"mana_cost\", None)\n79\t+    if cost is not None:\n80\t+        return int(cost.cmc)\n81\t+    return 0\n82\t+\n83\t+\n84\t+def _counter_spell(game: \"GameState\", target_spell: Any) -> None:\n85\t+    \"\"\"Counter *target_spell*: remove its StackObject and move it to the\n86\t+    owner's graveyard. The spell never resolves.\"\"\"\n87\t+    stack_items = game.stack._items  # noqa: SLF001\n88\t+    stack_obj = None\n89\t+    for item in list(stack_items):\n90\t+        if getattr(item, \"source\", None) is target_spell:\n91\t+            stack_obj = item\n92\t+            break\n93\t+    if stack_obj is None:\n94\t+        return\n95\t+\n96\t+    stack_items.remove(stack_obj)\n97\t+\n98\t+    owner = getattr(target_spell, \"owner\", None) or getattr(stack_obj, \"controller\", None)\n99\t+    controller = getattr(stack_obj, \"controller\", None) or owner\n100\t+\n101\t+    # Remove the card from whatever STACK zone it lives in.\n102\t+    if controller is not None and controller.zones[Zone.STACK].contains(target_spell):\n103\t+        controller.zones[Zone.STACK].remove(target_spell)\n104\t+    elif owner is not None and owner.zones[Zone.STACK].contains(target_spell):\n105\t+        owner.zones[Zone.STACK].remove(target_spell)\n106\t+\n107\t+    # A countered spell is put into its owner's graveyard.\n108\t+    if owner is not None:\n109\t+        owner.zones[Zone.GRAVEYARD].add(target_spell)\n110\t+\n111\t+\n112\t+class ManaSculpt(Instant):\n113\t+    \"\"\"Mana Sculpt — {1}{U}{U} — Instant.\n114\t+\n115\t+    Counter target spell. If you control a Wizard, add an amount of {C} equal\n116\t+    to the amount of mana spent to cast that spell at the beginning of your\n117\t+    next main phase.\n118\t+\n119\t+    SOS collector number 57.\n120\t+    \"\"\"\n121\t+\n122\t+    def __init__(self, **kwargs: Any) -> None:\n123\t+        kwargs.setdefault(\"name\", \"Mana Sculpt\")\n124\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{U}{U}\"))\n125\t+        kwargs.setdefault(\n126\t+            \"rules_text\",\n127\t+            \"Counter target spell. If you control a Wizard, add an amount of \"\n128\t+            \"{C} equal to the amount of mana spent to cast that spell at the \"\n129\t+            \"beginning of your next main phase.\",\n130\t+        )\n131\t+        super().__init__(**kwargs)\n132\t+        self.chosen_targets: list[Any] = []\n133\t+\n134\t+    def get_targets(self, game: \"GameState\") -> list[TargetRequirement]:\n135\t+        \"\"\"Advertise a single 'target spell' requirement on the stack.\"\"\"\n136\t+        return [\n137\t+            TargetRequirement(\n138\t+                filter_fn=_is_spell,\n139\t+                description=\"target spell\",\n140\t+                zone=Zone.STACK,\n141\t+            )\n142\t+        ]\n143\t+\n144\t+    def on_resolve(self, game: \"GameState\") -> None:\n145\t+        \"\"\"Counter the targeted spell, then (if a Wizard is controlled) set up\n146\t+        the delayed colorless-mana payoff.\"\"\"\n147\t+        chosen = getattr(self, \"chosen_targets\", None) or []\n148\t+        if not chosen:\n149\t+            # No legal target chosen — safe no-op.\n150\t+            return\n151\t+        target_spell = chosen[0]\n152\t+        if target_spell is None:\n153\t+            return\n154\t+\n155\t+        # Capture the amount of mana spent before the spell leaves the stack.\n156\t+        mana_spent = _mana_spent_on(target_spell)\n157\t+\n158\t+        _counter_spell(game, target_spell)\n159\t+\n160\t+        controller = self.controller\n161\t+        if controller is None:\n162\t+            return\n163\t+\n164\t+        # \"If you control a Wizard\" — checked at resolution.\n165\t+        if not _controls_wizard(game, controller):\n166\t+            return\n167\t+\n168\t+        self._register_delayed_mana(game, controller, mana_spent)\n169\t+\n170\t+    def _register_delayed_mana(\n171\t+        self, game: \"GameState\", controller: Any, amount: int\n172\t+    ) -> None:\n173\t+        \"\"\"Register a delayed trigger that adds ``amount`` {C} to *controller*'s\n174\t+        pool at the beginning of their next main phase.\"\"\"\n175\t+        from engine.events import BeginningOfMainPhaseTriggeredEvent\n176\t+        from engine.triggers import TriggerRegistration\n177\t+\n178\t+        fired = {\"done\": False}\n179\t+\n180\t+        def _condition(g: \"GameState\", event: Any) -> bool:\n181\t+            if fired[\"done\"]:\n182\t+                return False\n183\t+            return getattr(event, \"player\", None) is controller\n184\t+\n185\t+        def _effect(g: \"GameState\") -> None:\n186\t+            fired[\"done\"] = True\n187\t+            controller.mana_pool.add(ManaType.COLORLESS, amount)\n188\t+            # One-shot: remove this delayed effect once it has fired.\n189\t+            g.trigger_manager.unregister(self)\n190\t+\n191\t+        game.trigger_manager.register(\n192\t+            TriggerRegistration(\n193\t+                event_type=BeginningOfMainPhaseTriggeredEvent,\n194\t+                condition=_condition,\n195\t+                effect=_effect,\n196\t+                source=self,\n197\t+                controller=controller,\n198\t+            )\n199\t+        )\n200\tdiff --git a/engine/casting.py b/engine/casting.py\n201\tindex 0c7706e..09eb2ec 100644\n202\t--- a/engine/casting.py\n203\t+++ b/engine/casting.py\n204\t@@ -228,6 +228,12 @@ def cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n205\t     # that care about the colors used to cast the spell.\n206\t     card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n207\t \n208\t+    # Record the TOTAL amount of mana spent to cast this spell (rule 107.7).\n209\t+    # Unlike the printed mana value, this reflects actual mana paid, so X\n210\t+    # spells / cost-reduced spells diverge from CMC.  Effects such as Mana\n211\t+    # Sculpt read this at resolution.\n212\t+    card.mana_spent = player.mana_pool.last_payment_total  # type: ignore[attr-defined]\n213\t+\n214\t     # 7. Call on_cast hook\n215\t     card.on_cast(game)\n216\t \n217\tdiff --git a/engine/events.py b/engine/events.py\n218\tindex 516698d..f5df508 100644\n219\t--- a/engine/events.py\n220\t+++ b/engine/events.py\n221\t@@ -71,6 +71,20 @@ class BeginningOfUpkeepTriggeredEvent(TriggeredEvent):\n222\t     pass\n223\t \n224\t \n225\t+@dataclass\n226\t+class BeginningOfMainPhaseTriggeredEvent(TriggeredEvent):\n227\t+    \"\"\"Fired at the start of each main phase (precombat and postcombat).\n228\t+\n229\t+    Mirrors :class:`BeginningOfUpkeepTriggeredEvent`.  ``player`` is the\n230\t+    active player whose main phase is beginning, and ``phase`` is the\n231\t+    :class:`~engine.types.Phase` value (``PRECOMBAT_MAIN`` / ``POSTCOMBAT_MAIN``)\n232\t+    so triggers can distinguish the two main phases when needed.\n233\t+    \"\"\"\n234\t+\n235\t+    player: Any = None\n236\t+    phase: Any = None\n237\t+\n238\t+\n239\t @dataclass\n240\t class BeginningOfCombatTriggeredEvent(TriggeredEvent):\n241\t     pass\n242\tdiff --git a/engine/mana.py b/engine/mana.py\n243\tindex a112892..e092a70 100644\n244\t--- a/engine/mana.py\n245\t+++ b/engine/mana.py\n246\t@@ -24,6 +24,7 @@ class ManaPool:\n247\t     def __init__(self) -> None:\n248\t         self._pool: dict[ManaType, int] = {mt: 0 for mt in ManaType}\n249\t         self._last_payment_colors: list[Color] = []\n250\t+        self._last_payment_total: int = 0\n251\t \n252\t     # ------------------------------------------------------------------\n253\t     # Basic operations\n254\t@@ -63,6 +64,19 @@ class ManaPool:\n255\t         \"\"\"\n256\t         return list(self._last_payment_colors)\n257\t \n258\t+    @property\n259\t+    def last_payment_total(self) -> int:\n260\t+        \"\"\"Return the TOTAL quantity of mana spent in the last :meth:`pay` call.\n261\t+\n262\t+        Unlike :attr:`last_payment_colors` (which records only the *distinct*\n263\t+        colors), this counts every mana paid — colored and colorless alike —\n264\t+        and so reflects the *amount of mana spent* to pay the cost (rule 107.7,\n265\t+        \"amount of mana spent\").  This diverges from a spell's printed mana\n266\t+        value when X spells, additional costs, or cost reductions are involved.\n267\t+        Reset to ``0`` until the first payment.\n268\t+        \"\"\"\n269\t+        return self._last_payment_total\n270\t+\n271\t     # ------------------------------------------------------------------\n272\t     # Cost payment\n273\t     # ------------------------------------------------------------------\n274\t@@ -155,11 +169,15 @@ class ManaPool:\n275\t         # Commit the payment.\n276\t         # Compute colors of mana spent by comparing old pool to new working pool.\n277\t         colors_spent: set[Color] = set()\n278\t+        total_spent = 0\n279\t         for mt, old_amount in self._pool.items():\n280\t             new_amount = working.get(mt, 0)\n281\t-            if new_amount < old_amount and mt in _MANA_TO_COLOR:\n282\t-                colors_spent.add(_MANA_TO_COLOR[mt])\n283\t+            if new_amount < old_amount:\n284\t+                total_spent += old_amount - new_amount\n285\t+                if mt in _MANA_TO_COLOR:\n286\t+                    colors_spent.add(_MANA_TO_COLOR[mt])\n287\t         self._last_payment_colors = sorted(colors_spent, key=lambda c: c.value)\n288\t+        self._last_payment_total = total_spent\n289\t         self._pool = working\n290\t         return True\n291\t \n292\tdiff --git a/engine/turn.py b/engine/turn.py\n293\tindex e400349..b063788 100644\n294\t--- a/engine/turn.py\n295\t+++ b/engine/turn.py\n296\t@@ -204,6 +204,14 @@ def run_turn(game: GameState) -> None:\n297\t             game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n298\t         elif current == (Phase.BEGINNING, Step.DRAW):\n299\t             _do_draw_step(game)\n300\t+        elif game.phase in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN) and game.step is None:\n301\t+            from engine.events import BeginningOfMainPhaseTriggeredEvent\n302\t+            game.trigger_manager.fire_event(\n303\t+                game,\n304\t+                BeginningOfMainPhaseTriggeredEvent(\n305\t+                    player=game.active_player, phase=game.phase\n306\t+                ),\n307\t+            )\n308\t         elif game.phase == Phase.COMBAT and game.step is not None:\n309\t             _do_combat_step(game, game.step)\n310\t         elif current == (Phase.ENDING, Step.CLEANUP):\n311\t"}]},"parent_tool_use_id":"toolu_01YX96JwUDnYdbiNK5bRA6Ni","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"94762edc-e909-4866-8614-32c6bad68e5e","timestamp":"2026-06-01T11:09:25.066Z","subagent_type":"Reviewer","task_description":"Review sos_57 implementation"}
