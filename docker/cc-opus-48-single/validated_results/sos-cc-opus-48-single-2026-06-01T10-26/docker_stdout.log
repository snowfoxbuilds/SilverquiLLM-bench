{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LWf91D5FnFJJMPeyzMbcKN","type":"tool_result","content":"1\t\"\"\"Card base classes, CardImpl interface, and supporting dataclasses.\n2\t\n3\tProvides the core class hierarchy for all Magic: The Gathering card types:\n4\t\n5\t- ``GameObject`` — base for anything that can exist in zones.\n6\t- ``CardImpl(GameObject)`` — abstract card implementation with hooks for\n7\t  casting, resolution, targeting, triggers, and abilities.\n8\t- Concrete subclasses: ``Creature``, ``Instant``, ``Sorcery``,\n9\t  ``Enchantment``, ``Aura``, ``Artifact``, ``ArtifactCreature``,\n10\t  ``Planeswalker``, ``Land``.\n11\t- Supporting dataclasses: ``ActivatedAbility``, ``LoyaltyAbility``,\n12\t  ``ManaAbility``, ``ContinuousEffect``, ``Mode``.\n13\t\"\"\"\n14\t\n15\tfrom __future__ import annotations\n16\t\n17\tfrom dataclasses import dataclass\n18\tfrom typing import TYPE_CHECKING, Any, Callable\n19\t\n20\tfrom engine.types import CardType, Color, Keyword, ManaCost, ManaType, Supertype\n21\t\n22\tif TYPE_CHECKING:\n23\t    from engine.game_state import GameState\n24\t    from engine.player import Player\n25\t\n26\t\n27\t# ---------------------------------------------------------------------------\n28\t# Supporting dataclasses\n29\t# ---------------------------------------------------------------------------\n30\t\n31\t@dataclass\n32\tclass Mode:\n33\t    \"\"\"Represents a single mode of a modal spell or ability.\n34\t\n35\t    Attributes:\n36\t        name: Short label for this mode (e.g. ``\"Destroy target creature\"``).\n37\t        description: Detailed rules text for the mode.\n38\t    \"\"\"\n39\t\n40\t    name: str = \"\"\n41\t    description: str = \"\"\n42\t\n43\t\n44\t@dataclass\n45\tclass ActivatedAbility:\n46\t    \"\"\"An activated ability on a permanent.\n47\t\n48\t    Attributes:\n49\t        cost: A callable that checks/pays the cost given the game state.\n50\t        effect: A callable that applies the effect given the game state.\n51\t        description: Human-readable description of the ability.\n52\t    \"\"\"\n53\t\n54\t    cost: Callable[..., Any]\n55\t    effect: Callable[..., Any]\n56\t    description: str = \"\"\n57\t\n58\t\n59\t@dataclass\n60\tclass LoyaltyAbility:\n61\t    \"\"\"A planeswalker loyalty ability.\n62\t\n63\t    Attributes:\n64\t        loyalty_cost: The loyalty cost (positive for ``+``, negative for ``−``).\n65\t        effect: A callable that applies the ability's effect.\n66\t        description: Human-readable description.\n67\t    \"\"\"\n68\t\n69\t    loyalty_cost: int\n70\t    effect: Callable[..., Any]\n71\t    description: str = \"\"\n72\t\n73\t\n74\t@dataclass\n75\tclass ManaAbility:\n76\t    \"\"\"A mana ability (does not use the stack).\n77\t\n78\t    Attributes:\n79\t        cost: A callable that checks/pays the cost.\n80\t        mana_produced: A callable that returns the mana added.\n81\t        description: Human-readable description.\n82\t    \"\"\"\n83\t\n84\t    cost: Callable[..., Any]\n85\t    mana_produced: Callable[..., Any]\n86\t    description: str = \"\"\n87\t\n88\t\n89\t@dataclass\n90\tclass ContinuousEffect:\n91\t    \"\"\"A continuous effect applied by an enchantment or other source.\n92\t\n93\t    Attributes:\n94\t        apply: A callable that applies the effect to the game state.\n95\t        remove: A callable that removes the effect from the game state.\n96\t        description: Human-readable description.\n97\t    \"\"\"\n98\t\n99\t    apply: Callable[..., Any]\n100\t    remove: Callable[..., Any]\n101\t    description: str = \"\"\n102\t\n103\t\n104\t_MANA_TYPE_TO_COLOR: dict[ManaType, Color] = {\n105\t    ManaType.WHITE: Color.WHITE,\n106\t    ManaType.BLUE: Color.BLUE,\n107\t    ManaType.BLACK: Color.BLACK,\n108\t    ManaType.RED: Color.RED,\n109\t    ManaType.GREEN: Color.GREEN,\n110\t}\n111\t\n112\t\n113\tdef _colors_from_mana_cost(cost: ManaCost) -> set[Color]:\n114\t    \"\"\"Derive the set of :class:`~engine.types.Color` from a mana cost.\n115\t\n116\t    Colored pips contribute their color; hybrid symbols contribute both of\n117\t    their (non-colorless) options. Generic, ``{C}``, and ``{X}`` contribute\n118\t    nothing. Returns an empty set for a colorless / costless object.\n119\t    \"\"\"\n120\t    colors: set[Color] = set()\n121\t    for mana_type in getattr(cost, \"pips\", {}):\n122\t        color = _MANA_TYPE_TO_COLOR.get(mana_type)\n123\t        if color is not None:\n124\t            colors.add(color)\n125\t    for hybrid in getattr(cost, \"hybrid\", []):\n126\t        for option in (hybrid.option_a, hybrid.option_b):\n127\t            color = _MANA_TYPE_TO_COLOR.get(option)\n128\t            if color is not None:\n129\t                colors.add(color)\n130\t    return colors\n131\t\n132\t\n133\t# ---------------------------------------------------------------------------\n134\t# GameObject — base class for zone-resident objects\n135\t# ---------------------------------------------------------------------------\n136\t\n137\tclass GameObject:\n138\t    \"\"\"Base class for anything that can exist in a zone.\n139\t\n140\t    Each instance receives a unique ``object_id`` via a class-level\n141\t    auto-incrementing counter.\n142\t\n143\t    Attributes:\n144\t        object_id: Unique integer identifier (auto-assigned).\n145\t        owner: The player who owns this object.\n146\t        controller: The player who currently controls this object.\n147\t    \"\"\"\n148\t\n149\t    _next_id: int = 1\n150\t\n151\t    def __init__(self, owner: Player | None = None, controller: Player | None = None) -> None:\n152\t        self.object_id: int = GameObject._next_id\n153\t        GameObject._next_id += 1\n154\t        self.owner: Player | None = owner\n155\t        self.controller: Player | None = controller if controller is not None else owner\n156\t\n157\t    @classmethod\n158\t    def reset_id_counter(cls) -> None:\n159\t        \"\"\"Reset the auto-incrementing counter (useful in tests).\"\"\"\n160\t        cls._next_id = 1\n161\t\n162\t\n163\t# ---------------------------------------------------------------------------\n164\t# CardImpl — abstract card implementation\n165\t# ---------------------------------------------------------------------------\n166\t\n167\tclass CardImpl(GameObject):\n168\t    \"\"\"Abstract base for all card implementations.\n169\t\n170\t    Subclasses should override the ``can_cast``, ``on_cast``, ``on_resolve``,\n171\t    and other hook methods to implement card-specific behaviour.\n172\t\n173\t    Attributes:\n174\t        name: Card name.\n175\t        mana_cost: The card's mana cost.\n176\t        card_types: Set of :class:`~engine.types.CardType` values.\n177\t        subtypes: Set of subtype strings (e.g. ``{\"Elf\", \"Warrior\"}``).\n178\t        supertypes: Set of :class:`~engine.types.Supertype` values.\n179\t        keywords: Combination of :class:`~engine.types.Keyword` flags.\n180\t        rules_text: The card's rules text string.\n181\t    \"\"\"\n182\t\n183\t    def __init__(\n184\t        self,\n185\t        name: str = \"\",\n186\t        mana_cost: ManaCost | None = None,\n187\t        card_types: set[CardType] | None = None,\n188\t        subtypes: set[str] | None = None,\n189\t        supertypes: set[Supertype] | None = None,\n190\t        keywords: Keyword | None = None,\n191\t        rules_text: str = \"\",\n192\t        owner: Player | None = None,\n193\t        controller: Player | None = None,\n194\t        colors: set[Color] | None = None,\n195\t    ) -> None:\n196\t        super().__init__(owner=owner, controller=controller)\n197\t        self.name: str = name\n198\t        self.mana_cost: ManaCost = mana_cost if mana_cost is not None else ManaCost()\n199\t        self.card_types: set[CardType] = card_types if card_types is not None else set()\n200\t        self.subtypes: set[str] = subtypes if subtypes is not None else set()\n201\t        self.supertypes: set[Supertype] = supertypes if supertypes is not None else set()\n202\t        self.keywords: Keyword = keywords if keywords is not None else Keyword(0)\n203\t        self.rules_text: str = rules_text\n204\t        # Color identity of this object (rule 105). When ``colors`` is given\n205\t        # explicitly (e.g. for tokens, which have no mana cost) it is used\n206\t        # verbatim; otherwise colors are derived from the mana cost's pips.\n207\t        # Stored as a set of :class:`~engine.types.Color`.\n208\t        self.colors: set[Color] = (\n209\t            set(colors) if colors is not None\n210\t            else _colors_from_mana_cost(self.mana_cost)\n211\t        )\n212\t        # Snapshot original characteristics for continuous-effect reset.\n213\t        self._original_card_types: frozenset[CardType] = frozenset(self.card_types)\n214\t        self._original_keywords: Keyword = self.keywords\n215\t\n216\t    # ------------------------------------------------------------------\n217\t    # Continuous-effect reset support\n218\t    # ------------------------------------------------------------------\n219\t\n220\t    def _reset_characteristics(self) -> None:\n221\t        \"\"\"Reset mutable characteristics to their original (pre-effect) values.\n222\t\n223\t        Called by :meth:`EffectManager.apply_all` before reapplying effects\n224\t        so that the recalculation is idempotent.\n225\t        \"\"\"\n226\t        self.card_types = set(self._original_card_types)\n227\t        self.keywords = self._original_keywords\n228\t\n229\t    # ------------------------------------------------------------------\n230\t    # Hook methods — override in subclasses / card definitions\n231\t    # ------------------------------------------------------------------\n232\t\n233\t    def can_cast(self, game: GameState) -> bool:\n234\t        \"\"\"Return ``True`` if this card can currently be cast.\"\"\"\n235\t        return True\n236\t\n237\t    def cost_reduction(self, game: GameState) -> int:\n238\t        \"\"\"Return the generic mana reduction for casting this card.\n239\t\n240\t        Override in subclasses to implement cost-reduction mechanics\n241\t        (e.g. Embercleave costs {1} less for each attacking creature).\n242\t        The returned value is clamped so that generic mana cannot go below 0.\n243\t        Only reduces generic mana — colored costs are never reduced.\n244\t\n245\t        Returns:\n246\t            Non-negative integer representing generic mana to subtract.\n247\t        \"\"\"\n248\t        return 0\n249\t\n250\t    def on_cast(self, game: GameState) -> None:\n251\t        \"\"\"Called when the card is cast (before it goes on the stack).\"\"\"\n252\t\n253\t    def on_resolve(self, game: GameState) -> None:\n254\t        \"\"\"Called when the spell resolves from the stack.\n255\t\n256\t        Targets are available via ``self.chosen_targets`` — set at\n257\t        resolve-time by :func:`~engine.casting._resolve_spell` from\n258\t        :attr:`StackObject.targets`, or directly by test code.\n259\t        \"\"\"\n260\t\n261\t    def get_targets(self, game: GameState) -> list[Any]:\n262\t        \"\"\"Return a list of legal targets for this card.\"\"\"\n263\t        return []\n264\t\n265\t    def register_triggers(self, game: GameState) -> None:\n266\t        \"\"\"Register any triggered abilities this card provides.\"\"\"\n267\t\n268\t    def register_replacement_effects(self, game: GameState) -> None:\n269\t        \"\"\"Register any replacement effects this card provides.\"\"\"\n270\t\n271\t    def get_activated_abilities(self) -> list[ActivatedAbility]:\n272\t        \"\"\"Return activated abilities this card provides.\"\"\"\n273\t        return []\n274\t\n275\t    def get_modes(self) -> list[Mode]:\n276\t        \"\"\"Return available modes for modal spells/abilities.\n277\t\n278\t        Non-modal cards return an empty list by default.\n279\t        \"\"\"\n280\t        return []\n281\t\n282\t\n283\t# ---------------------------------------------------------------------------\n284\t# Creature\n285\t# ---------------------------------------------------------------------------\n286\t\n287\tclass Creature(CardImpl):\n288\t    \"\"\"A creature card.\n289\t\n290\t    Attributes:\n291\t        base_power: The printed power value (rule 208.1). Immutable after init.\n292\t        base_toughness: The printed toughness value. Immutable after init.\n293\t        modified_power: Current power after continuous effects (Layer 7c), before counters.\n294\t            Reset to ``base_power`` each effect cycle; continuous effects write here.\n295\t        modified_toughness: Current toughness after continuous effects, before counters.\n296\t        damage_marked: Amount of damage currently marked on this creature.\n297\t        is_tapped: Whether the creature is tapped.\n298\t        summoning_sick: Whether the creature has summoning sickness.\n299\t        is_attacking: Combat flag — currently declared as an attacker.\n300\t        is_blocking: Combat flag — currently declared as a blocker.\n301\t        plus_one_counters: Number of +1/+1 counters.\n302\t        minus_one_counters: Number of -1/-1 counters.\n303\t        is_token: Whether this object is a token (for SBA checks).\n304\t    \"\"\"\n305\t\n306\t    def __init__(\n307\t        self,\n308\t        name: str = \"\",\n309\t        mana_cost: ManaCost | None = None,\n310\t        card_types: set[CardType] | None = None,\n311\t        subtypes: set[str] | None = None,\n312\t        supertypes: set[Supertype] | None = None,\n313\t        keywords: Keyword | None = None,\n314\t        rules_text: str = \"\",\n315\t        owner: Player | None = None,\n316\t        controller: Player | None = None,\n317\t        base_power: int = 0,\n318\t        base_toughness: int = 0,\n319\t        colors: set[Color] | None = None,\n320\t    ) -> None:\n321\t        # Always include CREATURE in card_types.\n322\t        card_types = (card_types or set()) | {CardType.CREATURE}\n323\t        super().__init__(\n324\t            name=name,\n325\t            mana_cost=mana_cost,\n326\t            card_types=card_types,\n327\t            subtypes=subtypes,\n328\t            supertypes=supertypes,\n329\t            keywords=keywords,\n330\t            rules_text=rules_text,\n331\t            owner=owner,\n332\t            controller=controller,\n333\t            colors=colors,\n334\t        )\n335\t        self.base_power: int = base_power\n336\t        self.base_toughness: int = base_toughness\n337\t        self.modified_power: int = base_power\n338\t        self.modified_toughness: int = base_toughness\n339\t        self.damage_marked: int = 0\n340\t        self.is_tapped: bool = False\n341\t        self.summoning_sick: bool = True\n342\t        self.is_attacking: bool = False\n343\t        self.is_blocking: bool = False\n344\t        self.plus_one_counters: int = 0\n345\t        self.minus_one_counters: int = 0\n346\t        self.is_token: bool = False\n347\t        self.dealt_deathtouch_damage: bool = False\n348\t        self._base_plus_one_counters: int = 0\n349\t        self._base_minus_one_counters: int = 0\n350\t\n351\t    def _reset_characteristics(self) -> None:\n352\t        \"\"\"Reset creature characteristics to pre-effect values.\"\"\"\n353\t        super()._reset_characteristics()\n354\t        self.modified_power = self.base_power\n355\t        self.modified_toughness = self.base_toughness\n356\t        self.plus_one_counters = self._base_plus_one_counters\n357\t        self.minus_one_counters = self._base_minus_one_counters\n358\t        # Reset combat-restriction flags set by continuous effects (e.g. Pacifism).\n359\t        # These are reapplied by active effects during apply_all().\n360\t        self._cant_attack: bool = False\n361\t        self._cant_block: bool = False\n362\t        self._cant_be_blocked: bool = False\n363\t        self._cant_activate: bool = False\n364\t        self._max_attackers_blocked: int = 1\n365\t        # Clear granted protections so they are reapplied by active effects.\n366\t        if hasattr(self, \"protections\"):\n367\t            self.protections = []\n368\t\n369\t    @property\n370\t    def counters(self) -> dict[str, int]:\n371\t        \"\"\"Return a dict-like view of counters on this creature.\"\"\"\n372\t        result: dict[str, int] = {}\n373\t        if self.plus_one_counters > 0:\n374\t            result[\"+1/+1\"] = self.plus_one_counters\n375\t        if self.minus_one_counters > 0:\n376\t            result[\"-1/-1\"] = self.minus_one_counters\n377\t        return result\n378\t\n379\t    @property\n380\t    def power(self) -> int:\n381\t        \"\"\"Current power including counter modifications.\"\"\"\n382\t        return self.modified_power + self.plus_one_counters - self.minus_one_counters\n383\t\n384\t    @property\n385\t    def toughness(self) -> int:\n386\t        \"\"\"Current toughness including counter modifications.\"\"\"\n387\t        return self.modified_toughness + self.plus_one_counters - self.minus_one_counters\n388\t\n389\t\n390\t# ---------------------------------------------------------------------------\n391\t# Instant / Sorcery\n392\t# ---------------------------------------------------------------------------\n393\t\n394\tclass Instant(CardImpl):\n395\t    \"\"\"An instant spell — no extra fields beyond CardImpl.\"\"\"\n396\t\n397\t    def __init__(self, **kwargs: Any) -> None:\n398\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.INSTANT}\n399\t        super().__init__(**kwargs)\n400\t\n401\t\n402\tclass Sorcery(CardImpl):\n403\t    \"\"\"A sorcery spell — no extra fields beyond CardImpl.\"\"\"\n404\t\n405\t    def __init__(self, **kwargs: Any) -> None:\n406\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.SORCERY}\n407\t        super().__init__(**kwargs)\n408\t\n409\t\n410\t# ---------------------------------------------------------------------------\n411\t# Enchantment\n412\t# ---------------------------------------------------------------------------\n413\t\n414\tclass Enchantment(CardImpl):\n415\t    \"\"\"An enchantment card.\n416\t\n417\t    For auras, use the :class:`Aura` subclass which sets ``is_aura = True``.\n418\t    The base ``Enchantment`` class retains the ``attached_to`` attribute for\n419\t    backwards compatibility but marks ``is_aura = False`` so that state-based\n420\t    actions do not treat a non-aura enchantment as an unattached aura.\n421\t\n422\t    Attributes:\n423\t        attached_to: The object this enchantment is attached to (``None``\n424\t            if not an aura or not yet attached).\n425\t        is_aura: ``False`` for regular enchantments; ``True`` for auras.\n426\t    \"\"\"\n427\t\n428\t    is_aura: bool = False\n429\t\n430\t    def __init__(self, attached_to: Any | None = None, **kwargs: Any) -> None:\n431\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ENCHANTMENT}\n432\t        super().__init__(**kwargs)\n433\t        self.attached_to: Any | None = attached_to\n434\t\n435\t    def apply_continuous_effect(self, game: GameState) -> None:\n436\t        \"\"\"Apply the enchantment's continuous effect to the game.\"\"\"\n437\t\n438\t    def on_enchant(self, game: GameState) -> None:\n439\t        \"\"\"Called when this enchantment becomes attached to an object.\"\"\"\n440\t\n441\t    def on_detach(self, game: GameState) -> None:\n442\t        \"\"\"Called when this enchantment is detached from its object.\"\"\"\n443\t\n444\t\n445\tclass Aura(Enchantment):\n446\t    \"\"\"An Aura enchantment — attaches to a permanent on the battlefield.\n447\t\n448\t    Sets ``is_aura = True`` so that state-based actions correctly identify\n449\t    this as an aura (and move it to the graveyard when unattached).\n450\t\n451\t    Attributes:\n452\t        is_aura: Always ``True`` for auras.\n453\t    \"\"\"\n454\t\n455\t    is_aura: bool = True\n456\t\n457\t    def __init__(self, attached_to: Any | None = None, **kwargs: Any) -> None:\n458\t        super().__init__(attached_to=attached_to, **kwargs)\n459\t\n460\t\n461\t# ---------------------------------------------------------------------------\n462\t# Artifact / ArtifactCreature\n463\t# ---------------------------------------------------------------------------\n464\t\n465\tclass Artifact(CardImpl):\n466\t    \"\"\"An artifact card.\n467\t\n468\t    Attributes:\n469\t        is_tapped: Whether the artifact is currently tapped.\n470\t    \"\"\"\n471\t\n472\t    def __init__(self, **kwargs: Any) -> None:\n473\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ARTIFACT}\n474\t        super().__init__(**kwargs)\n475\t        self.is_tapped: bool = False\n476\t\n477\t\n478\tclass ArtifactCreature(Creature):\n479\t    \"\"\"An artifact creature — combines Artifact and Creature types.\n480\t\n481\t    Inherits creature combat stats and behaviour from :class:`Creature`.\n482\t    \"\"\"\n483\t\n484\t    def __init__(self, **kwargs: Any) -> None:\n485\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ARTIFACT, CardType.CREATURE}\n486\t        super().__init__(**kwargs)\n487\t\n488\t\n489\t# ---------------------------------------------------------------------------\n490\t# Planeswalker\n491\t# ---------------------------------------------------------------------------\n492\t\n493\tclass Planeswalker(CardImpl):\n494\t    \"\"\"A planeswalker card.\n495\t\n496\t    Attributes:\n497\t        starting_loyalty: The starting loyalty printed on the card.\n498\t        loyalty: Current loyalty counter value.\n499\t    \"\"\"\n500\t\n501\t    def __init__(\n502\t        self,\n503\t        starting_loyalty: int = 0,\n504\t        **kwargs: Any,\n505\t    ) -> None:\n506\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.PLANESWALKER}\n507\t        super().__init__(**kwargs)\n508\t        self.starting_loyalty: int = starting_loyalty\n509\t        self.loyalty: int = starting_loyalty\n510\t\n511\t    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n512\t        \"\"\"Return the planeswalker's loyalty abilities.\"\"\"\n513\t        return []\n514\t\n515\t\n516\t# ---------------------------------------------------------------------------\n517\t# Land\n518\t# ---------------------------------------------------------------------------\n519\t\n520\tclass Land(CardImpl):\n521\t    \"\"\"A land card.\n522\t\n523\t    Lands are not cast — they are played via a special action. ``can_cast``\n524\t    always returns ``False``.\n525\t\n526\t    Attributes:\n527\t        is_tapped: Whether the land is currently tapped.\n528\t    \"\"\"\n529\t\n530\t    def __init__(self, **kwargs: Any) -> None:\n531\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.LAND}\n532\t        super().__init__(**kwargs)\n533\t        self.is_tapped: bool = False\n534\t\n535\t    def can_cast(self, game: GameState) -> bool:\n536\t        \"\"\"Lands cannot be cast; they are played as a special action.\"\"\"\n537\t        return False\n538\t\n539\t    def get_mana_abilities(self) -> list[ManaAbility]:\n540\t        \"\"\"Return the land's mana abilities.\"\"\"\n541\t        return []\n542\t"}]},"parent_tool_use_id":"toolu_01NAkxZQxxK3TN7Tazw7TR79","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"b8d4fa0a-ea98-4150-b538-0d5479f33669","timestamp":"2026-06-01T11:35:26.964Z","subagent_type":"Implementer","task_description":"Implement sos_201"}
