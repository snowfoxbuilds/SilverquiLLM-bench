{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WYTEgp7eJ1k8m1t1E6PQot","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_120/card_impl.py b/cards/sos/sos_120/card_impl.py\n2\tindex fd0c1f4..6b1d52a 100644\n3\t--- a/cards/sos/sos_120/card_impl.py\n4\t+++ b/cards/sos/sos_120/card_impl.py\n5\t@@ -1,16 +1,226 @@\n6\t-\"\"\"Card implementation for Improvisation Capstone.\"\"\"\n7\t+\"\"\"Card implementation for Improvisation Capstone (SOS 120).\"\"\"\n8\t \n9\t from __future__ import annotations\n10\t \n11\t-from engine.card import CardImpl\n12\t+from typing import TYPE_CHECKING, Any\n13\t \n14\t-from typing import TYPE_CHECKING\n15\t+from engine.card import Sorcery\n16\t+from engine.types import CardType, ManaCost\n17\t \n18\t if TYPE_CHECKING:\n19\t     from engine.game_state import GameState\n20\t \n21\t \n22\t-class ImprovisationCapstone(CardImpl):\n23\t-    \"\"\"TODO: Implement Improvisation Capstone.\"\"\"\n24\t+# Non-land card types that identify an object as a castable \"spell\".\n25\t+_SPELL_TYPES = frozenset(\n26\t+    {\n27\t+        CardType.INSTANT,\n28\t+        CardType.SORCERY,\n29\t+        CardType.CREATURE,\n30\t+        CardType.ENCHANTMENT,\n31\t+        CardType.ARTIFACT,\n32\t+        CardType.PLANESWALKER,\n33\t+    }\n34\t+)\n35\t \n36\t-    pass\n37\t+_PARADIGM_REMINDER = (\n38\t+    \"Paradigm (Then exile this spell. After you first resolve a spell with \"\n39\t+    \"this name, you may cast a copy of it from exile without paying its mana \"\n40\t+    \"cost at the beginning of each of your first main phases.)\"\n41\t+)\n42\t+\n43\t+\n44\t+def _mana_value(card: Any) -> int:\n45\t+    \"\"\"Return the mana value (cmc) of *card*, defaulting to 0.\"\"\"\n46\t+    cost = getattr(card, \"mana_cost\", None)\n47\t+    if cost is None:\n48\t+        return 0\n49\t+    return int(getattr(cost, \"cmc\", 0) or 0)\n50\t+\n51\t+\n52\t+def _is_spell(obj: Any) -> bool:\n53\t+    \"\"\"Return ``True`` if *obj* is a castable spell (not a land/player).\"\"\"\n54\t+    if obj is None:\n55\t+        return False\n56\t+    if hasattr(obj, \"life\"):\n57\t+        return False\n58\t+    card_types = getattr(obj, \"card_types\", None)\n59\t+    if not card_types:\n60\t+        return False\n61\t+    return bool(card_types & _SPELL_TYPES)\n62\t+\n63\t+\n64\t+class ImprovisationCapstone(Sorcery):\n65\t+    \"\"\"Improvisation Capstone — {5}{R}{R} — Sorcery — Lesson.\n66\t+\n67\t+    Exile cards from the top of your library until you exile cards with total\n68\t+    mana value 4 or greater. You may cast any number of spells from among them\n69\t+    without paying their mana costs.\n70\t+    Paradigm (Then exile this spell. After you first resolve a spell with this\n71\t+    name, you may cast a copy of it from exile without paying its mana cost at\n72\t+    the beginning of each of your first main phases.)\n73\t+\n74\t+    SOS collector number 120.\n75\t+    \"\"\"\n76\t+\n77\t+    def __init__(self, **kwargs: Any) -> None:\n78\t+        kwargs.setdefault(\"name\", \"Improvisation Capstone\")\n79\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{5}{R}{R}\"))\n80\t+        kwargs.setdefault(\"subtypes\", {\"Lesson\"})\n81\t+        kwargs.setdefault(\n82\t+            \"rules_text\",\n83\t+            \"Exile cards from the top of your library until you exile cards \"\n84\t+            \"with total mana value 4 or greater. You may cast any number of \"\n85\t+            \"spells from among them without paying their mana costs.\\n\"\n86\t+            + _PARADIGM_REMINDER,\n87\t+        )\n88\t+        super().__init__(**kwargs)\n89\t+\n90\t+    # ------------------------------------------------------------------\n91\t+    # Paradigm: self-exile instead of graveyard\n92\t+    # ------------------------------------------------------------------\n93\t+\n94\t+    def register_replacement_effects(self, game: \"GameState\") -> None:\n95\t+        \"\"\"Paradigm: \"Then exile this spell.\" — redirect this spell's\n96\t+        stack->graveyard move to exile, using the sos_1 convention.\"\"\"\n97\t+        from engine.events import SpellToGraveyardReplacementEvent\n98\t+        from engine.replacement_effects import ReplacementEffect\n99\t+\n100\t+        # Idempotent: only register the self-exile replacement once, so that\n101\t+        # both the engine (on battlefield entry / explicit call) and our own\n102\t+        # ``on_resolve`` can request it without stacking duplicates.\n103\t+        if getattr(self, \"_paradigm_exile_registered\", False):\n104\t+            return\n105\t+        self._paradigm_exile_registered = True\n106\t+\n107\t+        spell = self\n108\t+\n109\t+        def _condition(g: Any, event: SpellToGraveyardReplacementEvent) -> bool:\n110\t+            return event.spell is spell and event.destination == \"graveyard\"\n111\t+\n112\t+        def _replacement(\n113\t+            g: Any, event: SpellToGraveyardReplacementEvent\n114\t+        ) -> SpellToGraveyardReplacementEvent:\n115\t+            event.destination = \"exile\"\n116\t+            return event\n117\t+\n118\t+        controller = getattr(self, \"controller\", None) or getattr(self, \"owner\", None)\n119\t+        game.replacement_manager.register(\n120\t+            ReplacementEffect(\n121\t+                event_type=SpellToGraveyardReplacementEvent,\n122\t+                source=spell,\n123\t+                condition=_condition,\n124\t+                replacement=_replacement,\n125\t+                controller=controller,\n126\t+            )\n127\t+        )\n128\t+\n129\t+    # ------------------------------------------------------------------\n130\t+    # Main resolution\n131\t+    # ------------------------------------------------------------------\n132\t+\n133\t+    def on_resolve(self, game: \"GameState\") -> None:\n134\t+        controller = getattr(self, \"controller\", None) or getattr(self, \"owner\", None)\n135\t+        if controller is None:\n136\t+            return\n137\t+\n138\t+        exiled = self._exile_until_total_mv(game, controller, threshold=4)\n139\t+        self._offer_free_casts(game, controller, exiled)\n140\t+        # Paradigm: ensure this spell exiles itself instead of hitting the\n141\t+        # graveyard, and set up the recurring recast-from-exile trigger.\n142\t+        self.register_replacement_effects(game)\n143\t+        self._register_paradigm_recast(game, controller)\n144\t+\n145\t+    def _exile_until_total_mv(\n146\t+        self, game: \"GameState\", controller: Any, threshold: int\n147\t+    ) -> list[Any]:\n148\t+        \"\"\"Exile cards off the top of *controller*'s library one at a time\n149\t+        until their cumulative mana value reaches *threshold*. Returns the\n150\t+        list of exiled cards.\"\"\"\n151\t+        library = game.get_library(controller)\n152\t+        exile = game.get_exile(controller)\n153\t+        exiled: list[Any] = []\n154\t+        total = 0\n155\t+        while total < threshold and len(library) > 0:\n156\t+            # Top of library is the last element.\n157\t+            top = library.get_all()[-1]\n158\t+            library.remove(top)\n159\t+            exile.add(top)\n160\t+            exiled.append(top)\n161\t+            total += _mana_value(top)\n162\t+        return exiled\n163\t+\n164\t+    def _offer_free_casts(\n165\t+        self, game: \"GameState\", controller: Any, exiled: list[Any]\n166\t+    ) -> None:\n167\t+        \"\"\"For each spell among *exiled*, ask the controller whether to cast\n168\t+        it for free (no mana paid). Lands are not offered.\"\"\"\n169\t+        from engine.casting import cast_spell_free, CastingError\n170\t+        from engine.types import Zone\n171\t+\n172\t+        exile = game.get_exile(controller)\n173\t+        for card in exiled:\n174\t+            if not _is_spell(card):\n175\t+                continue\n176\t+            if not exile.contains(card):\n177\t+                continue\n178\t+            if not controller.choose_yes_no(\n179\t+                f\"Cast {getattr(card, 'name', 'spell')!r} for free from exile?\"\n180\t+            ):\n181\t+                continue\n182\t+            try:\n183\t+                cast_spell_free(game, controller, card, Zone.EXILE)\n184\t+            except CastingError:\n185\t+                # Could not be cast — leave it in exile.\n186\t+                continue\n187\t+\n188\t+    # ------------------------------------------------------------------\n189\t+    # Paradigm: recast a copy at the beginning of each first main phase\n190\t+    # ------------------------------------------------------------------\n191\t+\n192\t+    def _register_paradigm_recast(self, game: \"GameState\", controller: Any) -> None:\n193\t+        \"\"\"Register the recurring begin-of-(first)-main-phase trigger that\n194\t+        lets the controller cast a copy of this spell from exile for free\n195\t+        (sos_57 begin-of-main-phase convention).\"\"\"\n196\t+        from engine.events import BeginningOfMainPhaseTriggeredEvent\n197\t+        from engine.triggers import TriggerRegistration\n198\t+\n199\t+        source = self\n200\t+\n201\t+        def _condition(g: Any, event: Any) -> bool:\n202\t+            return getattr(event, \"player\", None) is controller\n203\t+\n204\t+        def _effect(g: \"GameState\") -> None:\n205\t+            _recast_copy_from_exile(g, source, controller)\n206\t+\n207\t+        game.trigger_manager.register(\n208\t+            TriggerRegistration(\n209\t+                event_type=BeginningOfMainPhaseTriggeredEvent,\n210\t+                condition=_condition,\n211\t+                effect=_effect,\n212\t+                source=self,\n213\t+                controller=controller,\n214\t+            )\n215\t+        )\n216\t+\n217\t+\n218\t+def _recast_copy_from_exile(game: \"GameState\", source: Any, controller: Any) -> None:\n219\t+    \"\"\"Paradigm payoff: optionally cast a copy of *source* from exile without\n220\t+    paying its mana cost. No-op if the source is not in exile or the player\n221\t+    declines.\"\"\"\n222\t+    from engine.casting import cast_spell_free, CastingError\n223\t+    from engine.types import Zone\n224\t+\n225\t+    if controller is None:\n226\t+        return\n227\t+    exile = game.get_exile(controller)\n228\t+    if not exile.contains(source):\n229\t+        return\n230\t+    if not controller.choose_yes_no(\n231\t+        \"Cast a copy of Improvisation Capstone from exile for free?\"\n232\t+    ):\n233\t+        return\n234\t+    try:\n235\t+        cast_spell_free(game, controller, source, Zone.EXILE)\n236\t+    except CastingError:\n237\t+        return\n238\t"}]},"parent_tool_use_id":"toolu_0194AK5hQNxBUeswbmqVEoQM","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"e9379a2e-dd21-4003-9b00-ecdff3b68c1d","timestamp":"2026-06-01T11:29:43.268Z","subagent_type":"Reviewer","task_description":"Review sos_120 implementation"}
