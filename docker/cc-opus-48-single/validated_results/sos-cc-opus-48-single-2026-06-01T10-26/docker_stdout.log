{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016qWARqusUtCexrfU8swBqn","type":"tool_result","content":"1\tdiff --git a/FILES_MODIFIED.json b/FILES_MODIFIED.json\n2\tindex b941af4..b253877 100644\n3\t--- a/FILES_MODIFIED.json\n4\t+++ b/FILES_MODIFIED.json\n5\t@@ -65,6 +65,37 @@\n6\t         }\n7\t       ]\n8\t     },\n9\t+    {\n10\t+      \"card\": \"sos_201\",\n11\t+      \"tests\": [\n12\t+        {\n13\t+          \"path\": \"cards/sos/sos_201/tests.py\",\n14\t+          \"summary\": \"tests for sos_201 Lorehold, the Historian: static data, miracle {2} grant scoping on hand instants/sorceries, and opponent-upkeep loot trigger registration/firing/resolution\"\n15\t+        }\n16\t+      ],\n17\t+      \"implementation\": [\n18\t+        {\n19\t+          \"path\": \"cards/sos/sos_201/card_impl.py\",\n20\t+          \"summary\": \"Lorehold, the Historian: 5/5 flying haste; miracle_cost({2}) grant to controller-hand instants/sorceries; opponent-upkeep optional discard-then-draw loot trigger\"\n21\t+        },\n22\t+        {\n23\t+          \"path\": \"engine/miracle.py\",\n24\t+          \"summary\": \"new additive miracle surface: set/clear/get miracle cost, first-draw gating, can_miracle_cast, and draw-time offer_miracle hook\"\n25\t+        },\n26\t+        {\n27\t+          \"path\": \"engine/casting.py\",\n28\t+          \"summary\": \"added cast_spell_alternative paying an alternative (miracle) cost instead of the mana cost, skipping timing\"\n29\t+        },\n30\t+        {\n31\t+          \"path\": \"engine/game.py\",\n32\t+          \"summary\": \"draw_card offers a miracle cast for cards with an assigned miracle cost after the draw trigger fires\"\n33\t+        },\n34\t+        {\n35\t+          \"path\": \"engine/turn.py\",\n36\t+          \"summary\": \"untap step resets cards_drawn_this_turn for all players so miracle first-draw gating resets each turn\"\n37\t+        }\n38\t+      ]\n39\t+    },\n40\t     {\n41\t       \"card\": \"sos_4\",\n42\t       \"tests\": [\n43\tdiff --git a/cards/sos/sos_201/card_impl.py b/cards/sos/sos_201/card_impl.py\n44\tindex 7b52d28..d0a2560 100644\n45\t--- a/cards/sos/sos_201/card_impl.py\n46\t+++ b/cards/sos/sos_201/card_impl.py\n47\t@@ -1,16 +1,176 @@\n48\t-\"\"\"Card implementation for Lorehold, the Historian.\"\"\"\n49\t+\"\"\"Card implementation for Lorehold, the Historian (SOS 201).\"\"\"\n50\t \n51\t from __future__ import annotations\n52\t \n53\t-from engine.card import CardImpl\n54\t+from typing import TYPE_CHECKING, Any\n55\t \n56\t-from typing import TYPE_CHECKING\n57\t+from engine.card import Creature\n58\t+from engine.events import BeginningOfUpkeepTriggeredEvent\n59\t+from engine.types import CardType, Keyword, ManaCost, Supertype\n60\t \n61\t if TYPE_CHECKING:\n62\t     from engine.game_state import GameState\n63\t \n64\t \n65\t-class LoreholdTheHistorian(CardImpl):\n66\t-    \"\"\"TODO: Implement Lorehold, the Historian.\"\"\"\n67\t+# Card types that gain miracle from Lorehold's static ability.\n68\t+_INSTANT_OR_SORCERY = frozenset({CardType.INSTANT, CardType.SORCERY})\n69\t \n70\t-    pass\n71\t+# The miracle cost Lorehold grants: {2}.\n72\t+_MIRACLE_COST = ManaCost.parse(\"{2}\")\n73\t+\n74\t+\n75\t+def _is_instant_or_sorcery(card: Any) -> bool:\n76\t+    \"\"\"Return ``True`` if *card* is an instant or sorcery card.\"\"\"\n77\t+    return bool(getattr(card, \"card_types\", set()) & _INSTANT_OR_SORCERY)\n78\t+\n79\t+\n80\t+class LoreholdTheHistorian(Creature):\n81\t+    \"\"\"Lorehold, the Historian — {3}{R}{W} — Legendary Creature — Elder Dragon.\n82\t+\n83\t+    Flying, haste\n84\t+    Each instant and sorcery card in your hand has miracle {2}. (You may cast a\n85\t+    card for its miracle cost when you draw it if it's the first card you drew\n86\t+    this turn.)\n87\t+    At the beginning of each opponent's upkeep, you may discard a card. If you\n88\t+    do, draw a card.\n89\t+\n90\t+    SOS collector number 201.\n91\t+    \"\"\"\n92\t+\n93\t+    def __init__(self, **kwargs: Any) -> None:\n94\t+        kwargs.setdefault(\"name\", \"Lorehold, the Historian\")\n95\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{3}{R}{W}\"))\n96\t+        kwargs.setdefault(\"subtypes\", {\"Elder\", \"Dragon\"})\n97\t+        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n98\t+        kwargs.setdefault(\"keywords\", Keyword.FLYING | Keyword.HASTE)\n99\t+        kwargs.setdefault(\"base_power\", 5)\n100\t+        kwargs.setdefault(\"base_toughness\", 5)\n101\t+        kwargs.setdefault(\n102\t+            \"rules_text\",\n103\t+            \"Flying, haste\\n\"\n104\t+            \"Each instant and sorcery card in your hand has miracle {2}. \"\n105\t+            \"(You may cast a card for its miracle cost when you draw it if \"\n106\t+            \"it's the first card you drew this turn.)\\n\"\n107\t+            \"At the beginning of each opponent's upkeep, you may discard a \"\n108\t+            \"card. If you do, draw a card.\",\n109\t+        )\n110\t+        super().__init__(**kwargs)\n111\t+\n112\t+    # ------------------------------------------------------------------\n113\t+    # Miracle grant — \"Each instant and sorcery card in your hand has\n114\t+    # miracle {2}.\"\n115\t+    # ------------------------------------------------------------------\n116\t+\n117\t+    def miracle_cost(self, game: \"GameState\", card: Any) -> \"ManaCost | None\":\n118\t+        \"\"\"Return the miracle cost Lorehold grants to *card*, or ``None``.\n119\t+\n120\t+        The grant is scoped to instant/sorcery cards that are in *this card's\n121\t+        controller's hand* while Lorehold is in play; everything else (other\n122\t+        card types, cards in an opponent's hand) gets ``None``.\n123\t+\n124\t+        As a side effect, the engine-level ``miracle_cost`` attribute is\n125\t+        stamped onto qualifying cards so the engine's draw-time miracle hook\n126\t+        (``engine.miracle.offer_miracle``) can offer the alternative cost when\n127\t+        such a card is drawn.\n128\t+        \"\"\"\n129\t+        from engine.miracle import set_miracle_cost\n130\t+\n131\t+        controller = getattr(self, \"controller\", None) or getattr(self, \"owner\", None)\n132\t+        if self._grants_miracle_to(game, card, controller):\n133\t+            set_miracle_cost(card, _MIRACLE_COST)\n134\t+            return _MIRACLE_COST\n135\t+        return None\n136\t+\n137\t+    def _grants_miracle_to(\n138\t+        self, game: \"GameState\", card: Any, controller: Any\n139\t+    ) -> bool:\n140\t+        \"\"\"Return ``True`` if Lorehold grants miracle to *card* right now.\"\"\"\n141\t+        if controller is None:\n142\t+            return False\n143\t+        if not _is_instant_or_sorcery(card):\n144\t+            return False\n145\t+        # \"in your hand\": the card must be in the controller's hand.\n146\t+        hand = game.get_hand(controller)\n147\t+        return hand.contains(card)\n148\t+\n149\t+    def apply_miracle_grant(self, game: \"GameState\") -> None:\n150\t+        \"\"\"Stamp miracle {2} onto every qualifying card in the controller's hand.\n151\t+\n152\t+        Convenience for callers (and the engine) that want to refresh the grant\n153\t+        across the whole hand at once — e.g. after Lorehold enters or after the\n154\t+        controller draws.  Idempotent.\n155\t+        \"\"\"\n156\t+        controller = getattr(self, \"controller\", None) or getattr(self, \"owner\", None)\n157\t+        if controller is None:\n158\t+            return\n159\t+        for card in game.get_hand(controller).get_all():\n160\t+            self.miracle_cost(game, card)\n161\t+\n162\t+    # ------------------------------------------------------------------\n163\t+    # Opponent-upkeep loot trigger\n164\t+    # ------------------------------------------------------------------\n165\t+\n166\t+    def register_triggers(self, game: \"GameState\") -> None:\n167\t+        \"\"\"Register the 'each opponent's upkeep' optional loot trigger.\n168\t+\n169\t+        ``BeginningOfUpkeepTriggeredEvent`` carries no player field, so the\n170\t+        condition reads ``game.active_player`` (the player whose upkeep it is)\n171\t+        and fires only when that player is NOT the controller.\n172\t+        \"\"\"\n173\t+        from engine.triggers import TriggerRegistration\n174\t+\n175\t+        controller = getattr(self, \"controller\", None) or getattr(self, \"owner\", None)\n176\t+\n177\t+        def _condition(g: \"GameState\", event: BeginningOfUpkeepTriggeredEvent) -> bool:\n178\t+            # Fire only on an OPPONENT's upkeep (active player != controller).\n179\t+            return g.active_player is not controller\n180\t+\n181\t+        def _effect(g: \"GameState\") -> None:\n182\t+            _loot(g, controller)\n183\t+\n184\t+        game.trigger_manager.register(\n185\t+            TriggerRegistration(\n186\t+                event_type=BeginningOfUpkeepTriggeredEvent,\n187\t+                condition=_condition,\n188\t+                effect=_effect,\n189\t+                source=self,\n190\t+                controller=controller,\n191\t+            )\n192\t+        )\n193\t+\n194\t+\n195\t+def _loot(game: \"GameState\", controller: Any) -> None:\n196\t+    \"\"\"Resolve \"you may discard a card. If you do, draw a card.\"\n197\t+\n198\t+    Contract for the deterministic test pipeline:\n199\t+\n200\t+    * ``controller.choose_yes_no`` drives the optional \"you may\" clause —\n201\t+      script ``True`` to loot, ``False`` to decline.\n202\t+    * ``controller.choose_card`` selects the card to discard.\n203\t+    * The draw happens only if a card was actually discarded (\"If you do\").\n204\t+      With an empty hand there is nothing to discard, so the draw is skipped\n205\t+      regardless of the yes/no answer.\n206\t+    \"\"\"\n207\t+    from engine.game import discard, draw_card\n208\t+\n209\t+    if controller is None:\n210\t+        return\n211\t+\n212\t+    hand = game.get_hand(controller)\n213\t+    cards = hand.get_all()\n214\t+    # \"If you do\" is conditional on actually discarding; with no card to\n215\t+    # discard, nothing happens (and we don't prompt for a draw).\n216\t+    if not cards:\n217\t+        return\n218\t+\n219\t+    if hasattr(controller, \"choose_yes_no\"):\n220\t+        if not controller.choose_yes_no(\"Discard a card to draw a card?\"):\n221\t+            return\n222\t+\n223\t+    chosen = controller.choose_card(cards, \"card to discard\")\n224\t+    if chosen is None or not hand.contains(chosen):\n225\t+        return\n226\t+\n227\t+    discard(game, controller, chosen)\n228\t+    # Discard succeeded — draw a card.\n229\t+    draw_card(game, controller)\n230\tdiff --git a/engine/casting.py b/engine/casting.py\n231\tindex 09eb2ec..5ddced8 100644\n232\t--- a/engine/casting.py\n233\t+++ b/engine/casting.py\n234\t@@ -377,6 +377,119 @@ def cast_spell_free(\n235\t     game.stack.push(stack_obj)\n236\t \n237\t \n238\t+# ------------------------------------------------------------------\n239\t+# Cast spell paying an alternative cost (e.g. miracle)\n240\t+# ------------------------------------------------------------------\n241\t+\n242\t+\n243\t+def cast_spell_alternative(\n244\t+    game: GameState,\n245\t+    player: Player,\n246\t+    card: CardImpl,\n247\t+    alternative_cost: ManaCost,\n248\t+    from_zone: Zone = Zone.HAND,\n249\t+) -> None:\n250\t+    \"\"\"Cast *card* paying *alternative_cost* instead of its mana cost.\n251\t+\n252\t+    Used by alternative-cost mechanics such as **miracle** (rule 702.94),\n253\t+    where the spell is cast \"by paying [cost] rather than its mana cost\".\n254\t+    The alternative cost is paid as a normal mana cost from *player*'s pool.\n255\t+\n256\t+    Unlike :func:`cast_spell` this skips the normal sorcery-speed/instant\n257\t+    timing check (miracle casts happen at draw time, outside normal timing),\n258\t+    but otherwise mirrors the cast pipeline: ``can_cast`` legality, target\n259\t+    choice/validation, mana payment (with rollback on failure), the\n260\t+    ``on_cast`` hook, and pushing a resolving :class:`StackObject`.\n261\t+\n262\t+    Parameters:\n263\t+        game: The current game state.\n264\t+        player: The player casting the spell.\n265\t+        card: The card to cast (must be in *from_zone*).\n266\t+        alternative_cost: The :class:`ManaCost` to pay instead of\n267\t+            ``card.mana_cost``.\n268\t+        from_zone: The zone the card is currently in (default hand).\n269\t+\n270\t+    Raises:\n271\t+        CastingError: If any legality check fails or mana cannot be paid.\n272\t+    \"\"\"\n273\t+    if card.controller is None:\n274\t+        card.controller = player\n275\t+    if card.owner is None:\n276\t+        card.owner = player\n277\t+\n278\t+    # can_cast legality (timing is intentionally skipped for miracle casts).\n279\t+    if not card.can_cast(game):\n280\t+        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n281\t+\n282\t+    source_zone = player.zones[from_zone]\n283\t+    if not source_zone.contains(card):\n284\t+        raise CastingError(\n285\t+            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n286\t+        )\n287\t+\n288\t+    stack_zone = player.zones[Zone.STACK]\n289\t+    source_zone.remove(card)\n290\t+    stack_zone.add(card)\n291\t+\n292\t+    if hasattr(card, \"colors_spent\"):\n293\t+        del card.colors_spent\n294\t+\n295\t+    # Choose targets (with rollback to the source zone on failure).\n296\t+    try:\n297\t+        target_specs = card.get_targets(game)\n298\t+        chosen_targets: list[Any] = []\n299\t+        if target_specs:\n300\t+            for spec in target_specs:\n301\t+                target = player.choose_target(target_specs, spec)\n302\t+                filter_fn = getattr(spec, \"filter_fn\", None)\n303\t+                if filter_fn is not None and target is not None:\n304\t+                    if not filter_fn(target):\n305\t+                        raise CastingError(\n306\t+                            f\"Cannot cast {card.name!r} — chosen target does not \"\n307\t+                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n308\t+                        )\n309\t+                chosen_targets.append(target)\n310\t+\n311\t+        from engine.protection import has_protection_from\n312\t+\n313\t+        for target in chosen_targets:\n314\t+            if has_protection_from(target, card):\n315\t+                raise CastingError(\n316\t+                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n317\t+                )\n318\t+    except Exception as exc:\n319\t+        stack_zone.remove(card)\n320\t+        source_zone.add(card)\n321\t+        raise CastingError(str(exc)) from exc\n322\t+\n323\t+    # Pay the alternative cost (rollback on failure).\n324\t+    if not player.mana_pool.can_pay(alternative_cost):\n325\t+        stack_zone.remove(card)\n326\t+        source_zone.add(card)\n327\t+        raise CastingError(\n328\t+            f\"Cannot cast {card.name!r} — insufficient mana for alternative cost\"\n329\t+        )\n330\t+    player.mana_pool.pay(alternative_cost)\n331\t+\n332\t+    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n333\t+    card.mana_spent = player.mana_pool.last_payment_total  # type: ignore[attr-defined]\n334\t+\n335\t+    card.on_cast(game)\n336\t+\n337\t+    stack_obj = StackObject(\n338\t+        source=card,\n339\t+        controller=player,\n340\t+        targets=chosen_targets,\n341\t+        on_resolve=lambda g: None,  # replaced below\n342\t+    )\n343\t+\n344\t+    def _on_resolve(g: GameState) -> None:\n345\t+        _resolve_spell(g, card, player, stack_obj)\n346\t+\n347\t+    stack_obj.on_resolve = _on_resolve\n348\t+    game.stack.push(stack_obj)\n349\t+\n350\t+\n351\t # ------------------------------------------------------------------\n352\t # Resolution (called when the stack pops)\n353\t # ------------------------------------------------------------------\n354\tdiff --git a/engine/game.py b/engine/game.py\n355\tindex 32a04ea..8344fc9 100644\n356\t--- a/engine/game.py\n357\t+++ b/engine/game.py\n358\t@@ -332,6 +332,14 @@ def draw_card(game: GameState, player: Player) -> Any | None:\n359\t             DrawsCardTriggeredEvent(player=player, card=card),\n360\t         )\n361\t \n362\t+    # Miracle (rule 702.94): when this is the first card drawn this turn and\n363\t+    # the card carries an assigned miracle cost, offer to cast it for that\n364\t+    # cost as an alternative cost.  No-op for cards without a miracle cost.\n365\t+    from engine.miracle import get_miracle_cost, offer_miracle\n366\t+\n367\t+    if get_miracle_cost(card) is not None:\n368\t+        offer_miracle(game, player, card)\n369\t+\n370\t     return card\n371\t \n372\t \n373\tdiff --git a/engine/miracle.py b/engine/miracle.py\n374\tnew file mode 100644\n375\tindex 0000000..1c00d47\n376\t--- /dev/null\n377\t+++ b/engine/miracle.py\n378\t@@ -0,0 +1,124 @@\n379\t+\"\"\"Miracle mechanic support (rule 702.94) — additive engine surface.\n380\t+\n381\t+Miracle is a static ability linked to a triggered ability:\n382\t+\n383\t+    \"Miracle [cost]\" means \"You may reveal this card from your hand as you\n384\t+    draw it if it's the first card you've drawn this turn. When you reveal\n385\t+    this card this way, you may cast it by paying [cost] rather than its\n386\t+    mana cost.\"\n387\t+\n388\t+The engine has no native ``miracle`` keyword (and the :class:`~engine.types.Keyword`\n389\t+enum is pinned at 16 members by ``engine_tests/test_types.py``), so miracle is\n390\t+surfaced via a per-card ``miracle_cost`` attribute and a small set of helper\n391\t+functions here instead of a flag.\n392\t+\n393\t+Contract exposed to cards / tests\n394\t+----------------------------------\n395\t+\n396\t+* :func:`set_miracle_cost` — stamp a :class:`~engine.types.ManaCost` (the\n397\t+  miracle/alternative cost) onto a card and mark it ``has_miracle = True``.\n398\t+* :func:`clear_miracle_cost` — remove the stamp (used when the granting\n399\t+  source leaves the battlefield / the card leaves the hand).\n400\t+* :func:`get_miracle_cost` — read the assigned miracle cost (``None`` if the\n401\t+  card has no miracle).\n402\t+* :func:`is_first_draw_this_turn` — first-card-drawn-this-turn gating, reading\n403\t+  the ``player.cards_drawn_this_turn`` counter the draw step maintains.\n404\t+* :func:`can_miracle_cast` — ``True`` iff the just-drawn card has a miracle\n405\t+  cost AND it is the first card drawn this turn.\n406\t+* :func:`offer_miracle` — the draw-time hook: if the card may be miracle-cast\n407\t+  and the controller says yes (``choose_yes_no``), cast it for the miracle\n408\t+  cost as an alternative cost via :func:`engine.casting.cast_spell_alternative`.\n409\t+\n410\t+The miracle cost is paid as a normal mana cost (just a *different* cost), so\n411\t+the alternative-cost cast path pays from the player's mana pool.\n412\t+\"\"\"\n413\t+\n414\t+from __future__ import annotations\n415\t+\n416\t+from typing import TYPE_CHECKING, Any\n417\t+\n418\t+if TYPE_CHECKING:\n419\t+    from engine.game_state import GameState\n420\t+    from engine.player import Player\n421\t+    from engine.types import ManaCost\n422\t+\n423\t+\n424\t+# Attribute name used to stamp the miracle cost onto a card.\n425\t+_MIRACLE_COST_ATTR = \"miracle_cost\"\n426\t+\n427\t+\n428\t+def set_miracle_cost(card: Any, cost: \"ManaCost\") -> None:\n429\t+    \"\"\"Assign *cost* as *card*'s miracle (alternative) cost.\n430\t+\n431\t+    Sets both ``card.miracle_cost`` and a ``card.has_miracle`` boolean flag\n432\t+    so callers can detect the grant without a ``None`` comparison.\n433\t+    \"\"\"\n434\t+    setattr(card, _MIRACLE_COST_ATTR, cost)\n435\t+    card.has_miracle = True\n436\t+\n437\t+\n438\t+def clear_miracle_cost(card: Any) -> None:\n439\t+    \"\"\"Remove any miracle cost previously assigned to *card*.\"\"\"\n440\t+    if hasattr(card, _MIRACLE_COST_ATTR):\n441\t+        try:\n442\t+            delattr(card, _MIRACLE_COST_ATTR)\n443\t+        except AttributeError:\n444\t+            setattr(card, _MIRACLE_COST_ATTR, None)\n445\t+    card.has_miracle = False\n446\t+\n447\t+\n448\t+def get_miracle_cost(card: Any) -> \"ManaCost | None\":\n449\t+    \"\"\"Return *card*'s assigned miracle cost, or ``None`` if it has none.\"\"\"\n450\t+    return getattr(card, _MIRACLE_COST_ATTR, None)\n451\t+\n452\t+\n453\t+def is_first_draw_this_turn(player: \"Player\") -> bool:\n454\t+    \"\"\"Return ``True`` if at most one card has been drawn by *player* this turn.\n455\t+\n456\t+    Miracle keys off \"the first card you've drawn this turn\".  The draw helper\n457\t+    (:func:`engine.game.draw_card`) increments ``player.cards_drawn_this_turn``\n458\t+    *before* firing the draw trigger, so when this is evaluated at draw time the\n459\t+    counter reads ``1`` for the first draw of the turn.\n460\t+    \"\"\"\n461\t+    count = getattr(player, \"cards_drawn_this_turn\", 0)\n462\t+    return count <= 1\n463\t+\n464\t+\n465\t+def can_miracle_cast(player: \"Player\", card: Any) -> bool:\n466\t+    \"\"\"Return ``True`` if *card* may be miracle-cast as it is drawn.\n467\t+\n468\t+    Requires both that *card* carries an assigned miracle cost and that it is\n469\t+    the first card *player* has drawn this turn.\n470\t+    \"\"\"\n471\t+    if get_miracle_cost(card) is None:\n472\t+        return False\n473\t+    return is_first_draw_this_turn(player)\n474\t+\n475\t+\n476\t+def offer_miracle(game: \"GameState\", player: \"Player\", card: Any) -> bool:\n477\t+    \"\"\"Draw-time miracle hook — offer to cast the just-drawn *card* for miracle.\n478\t+\n479\t+    Returns ``True`` if the card was miracle-cast (put on the stack), ``False``\n480\t+    otherwise.  No-op (returns ``False``) when the card has no miracle cost or\n481\t+    it is not the first card drawn this turn.\n482\t+\n483\t+    The optionality is driven by ``player.choose_yes_no`` (the \"you may\"\n484\t+    clause).  On a yes, the card is cast for its miracle cost via the\n485\t+    alternative-cost cast path.\n486\t+    \"\"\"\n487\t+    if not can_miracle_cast(player, card):\n488\t+        return False\n489\t+\n490\t+    cost = get_miracle_cost(card)\n491\t+    name = getattr(card, \"name\", \"card\")\n492\t+    if hasattr(player, \"choose_yes_no\"):\n493\t+        if not player.choose_yes_no(f\"Cast {name!r} for its miracle cost?\"):\n494\t+            return False\n495\t+\n496\t+    from engine.casting import cast_spell_alternative, CastingError\n497\t+\n498\t+    try:\n499\t+        cast_spell_alternative(game, player, card, cost)\n500\t+    except CastingError:\n501\t+        return False\n502\t+    return True\n503\tdiff --git a/engine/turn.py b/engine/turn.py\n504\tindex b063788..ddaba2b 100644\n505\t--- a/engine/turn.py\n506\t+++ b/engine/turn.py\n507\t@@ -41,6 +41,11 @@ def _do_untap_step(game: GameState) -> None:\n508\t     # Reset land plays for the active player\n509\t     active.land_plays_remaining = 1\n510\t \n511\t+    # Reset the per-turn draw counter for ALL players so the miracle\n512\t+    # \"first card drawn this turn\" gating (rule 702.94) resets each turn.\n513\t+    for player in game.players:\n514\t+        player.cards_drawn_this_turn = 0\n515\t+\n516\t \n517\t def _do_draw_step(game: GameState) -> None:\n518\t     \"\"\"Perform draw step actions: active player draws a card.\n519\t"}]},"parent_tool_use_id":"toolu_015Db1w2LmRhkJgHeDaM9a5T","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"5d591afe-b463-4e79-9cee-762c964073b3","timestamp":"2026-06-01T11:44:37.539Z","subagent_type":"Implementer","task_description":"Revise sos_201 implementation"}
