{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_011QYEzsHmHCZJCCCt6jSJ4L","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_019v8qFjPy42HAtAuMdL7A7s","name":"Read","input":{"file_path":"/workspace/cards/sos/sos_201/tests.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1562,"cache_read_input_tokens":11605,"cache_creation":{"ephemeral_5m_input_tokens":1562,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_015Db1w2LmRhkJgHeDaM9a5T","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"cf6d3e74-acce-416b-a01a-d08ddf18798f","request_id":"req_011CbcUv6hHyTrQgZ8MhsfAJ","subagent_type":"Implementer","task_description":"Revise sos_201 implementation"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017cv8NG5r6rUA7JamPkGNCj","type":"tool_result","content":"1\t\"\"\"Card implementation for Lorehold, the Historian (SOS 201).\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.events import BeginningOfUpkeepTriggeredEvent\n9\tfrom engine.types import CardType, Keyword, ManaCost, Supertype\n10\t\n11\tif TYPE_CHECKING:\n12\t    from engine.game_state import GameState\n13\t\n14\t\n15\t# Card types that gain miracle from Lorehold's static ability.\n16\t_INSTANT_OR_SORCERY = frozenset({CardType.INSTANT, CardType.SORCERY})\n17\t\n18\t# The miracle cost Lorehold grants: {2}.\n19\t_MIRACLE_COST = ManaCost.parse(\"{2}\")\n20\t\n21\t\n22\tdef _is_instant_or_sorcery(card: Any) -> bool:\n23\t    \"\"\"Return ``True`` if *card* is an instant or sorcery card.\"\"\"\n24\t    return bool(getattr(card, \"card_types\", set()) & _INSTANT_OR_SORCERY)\n25\t\n26\t\n27\tclass LoreholdTheHistorian(Creature):\n28\t    \"\"\"Lorehold, the Historian — {3}{R}{W} — Legendary Creature — Elder Dragon.\n29\t\n30\t    Flying, haste\n31\t    Each instant and sorcery card in your hand has miracle {2}. (You may cast a\n32\t    card for its miracle cost when you draw it if it's the first card you drew\n33\t    this turn.)\n34\t    At the beginning of each opponent's upkeep, you may discard a card. If you\n35\t    do, draw a card.\n36\t\n37\t    SOS collector number 201.\n38\t    \"\"\"\n39\t\n40\t    def __init__(self, **kwargs: Any) -> None:\n41\t        kwargs.setdefault(\"name\", \"Lorehold, the Historian\")\n42\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{3}{R}{W}\"))\n43\t        kwargs.setdefault(\"subtypes\", {\"Elder\", \"Dragon\"})\n44\t        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n45\t        kwargs.setdefault(\"keywords\", Keyword.FLYING | Keyword.HASTE)\n46\t        kwargs.setdefault(\"base_power\", 5)\n47\t        kwargs.setdefault(\"base_toughness\", 5)\n48\t        kwargs.setdefault(\n49\t            \"rules_text\",\n50\t            \"Flying, haste\\n\"\n51\t            \"Each instant and sorcery card in your hand has miracle {2}. \"\n52\t            \"(You may cast a card for its miracle cost when you draw it if \"\n53\t            \"it's the first card you drew this turn.)\\n\"\n54\t            \"At the beginning of each opponent's upkeep, you may discard a \"\n55\t            \"card. If you do, draw a card.\",\n56\t        )\n57\t        super().__init__(**kwargs)\n58\t\n59\t    # ------------------------------------------------------------------\n60\t    # Miracle grant — \"Each instant and sorcery card in your hand has\n61\t    # miracle {2}.\"\n62\t    # ------------------------------------------------------------------\n63\t\n64\t    def miracle_cost(self, game: \"GameState\", card: Any) -> \"ManaCost | None\":\n65\t        \"\"\"Return the miracle cost Lorehold grants to *card*, or ``None``.\n66\t\n67\t        The grant is scoped to instant/sorcery cards that are in *this card's\n68\t        controller's hand* while Lorehold is in play; everything else (other\n69\t        card types, cards in an opponent's hand) gets ``None``.\n70\t\n71\t        As a side effect, the engine-level ``miracle_cost`` attribute is\n72\t        stamped onto qualifying cards so the engine's draw-time miracle hook\n73\t        (``engine.miracle.offer_miracle``) can offer the alternative cost when\n74\t        such a card is drawn.\n75\t        \"\"\"\n76\t        from engine.miracle import set_miracle_cost\n77\t\n78\t        controller = getattr(self, \"controller\", None) or getattr(self, \"owner\", None)\n79\t        if self._grants_miracle_to(game, card, controller):\n80\t            set_miracle_cost(card, _MIRACLE_COST)\n81\t            return _MIRACLE_COST\n82\t        return None\n83\t\n84\t    def _grants_miracle_to(\n85\t        self, game: \"GameState\", card: Any, controller: Any\n86\t    ) -> bool:\n87\t        \"\"\"Return ``True`` if Lorehold grants miracle to *card* right now.\"\"\"\n88\t        if controller is None:\n89\t            return False\n90\t        if not _is_instant_or_sorcery(card):\n91\t            return False\n92\t        # \"in your hand\": the card must be in the controller's hand.\n93\t        hand = game.get_hand(controller)\n94\t        return hand.contains(card)\n95\t\n96\t    def apply_miracle_grant(self, game: \"GameState\") -> None:\n97\t        \"\"\"Stamp miracle {2} onto every qualifying card in the controller's hand.\n98\t\n99\t        Convenience for callers (and the engine) that want to refresh the grant\n100\t        across the whole hand at once — e.g. after Lorehold enters or after the\n101\t        controller draws.  Idempotent.\n102\t        \"\"\"\n103\t        controller = getattr(self, \"controller\", None) or getattr(self, \"owner\", None)\n104\t        if controller is None:\n105\t            return\n106\t        for card in game.get_hand(controller).get_all():\n107\t            self.miracle_cost(game, card)\n108\t\n109\t    # ------------------------------------------------------------------\n110\t    # Opponent-upkeep loot trigger\n111\t    # ------------------------------------------------------------------\n112\t\n113\t    def register_triggers(self, game: \"GameState\") -> None:\n114\t        \"\"\"Register the 'each opponent's upkeep' optional loot trigger.\n115\t\n116\t        ``BeginningOfUpkeepTriggeredEvent`` carries no player field, so the\n117\t        condition reads ``game.active_player`` (the player whose upkeep it is)\n118\t        and fires only when that player is NOT the controller.\n119\t        \"\"\"\n120\t        from engine.triggers import TriggerRegistration\n121\t\n122\t        controller = getattr(self, \"controller\", None) or getattr(self, \"owner\", None)\n123\t\n124\t        def _condition(g: \"GameState\", event: BeginningOfUpkeepTriggeredEvent) -> bool:\n125\t            # Fire only on an OPPONENT's upkeep (active player != controller).\n126\t            return g.active_player is not controller\n127\t\n128\t        def _effect(g: \"GameState\") -> None:\n129\t            _loot(g, controller)\n130\t\n131\t        game.trigger_manager.register(\n132\t            TriggerRegistration(\n133\t                event_type=BeginningOfUpkeepTriggeredEvent,\n134\t                condition=_condition,\n135\t                effect=_effect,\n136\t                source=self,\n137\t                controller=controller,\n138\t            )\n139\t        )\n140\t\n141\t\n142\tdef _loot(game: \"GameState\", controller: Any) -> None:\n143\t    \"\"\"Resolve \"you may discard a card. If you do, draw a card.\"\n144\t\n145\t    Contract for the deterministic test pipeline:\n146\t\n147\t    * ``controller.choose_yes_no`` drives the optional \"you may\" clause —\n148\t      script ``True`` to loot, ``False`` to decline.\n149\t    * ``controller.choose_card`` selects the card to discard.\n150\t    * The draw happens only if a card was actually discarded (\"If you do\").\n151\t      With an empty hand there is nothing to discard, so the draw is skipped\n152\t      regardless of the yes/no answer.\n153\t    \"\"\"\n154\t    from engine.game import discard, draw_card\n155\t\n156\t    if controller is None:\n157\t        return\n158\t\n159\t    hand = game.get_hand(controller)\n160\t    cards = hand.get_all()\n161\t    # \"If you do\" is conditional on actually discarding; with no card to\n162\t    # discard, nothing happens (and we don't prompt for a draw).\n163\t    if not cards:\n164\t        return\n165\t\n166\t    if hasattr(controller, \"choose_yes_no\"):\n167\t        if not controller.choose_yes_no(\"Discard a card to draw a card?\"):\n168\t            return\n169\t\n170\t    chosen = controller.choose_card(cards, \"card to discard\")\n171\t    if chosen is None or not hand.contains(chosen):\n172\t        return\n173\t\n174\t    discard(game, controller, chosen)\n175\t    # Discard succeeded — draw a card.\n176\t    draw_card(game, controller)\n177\t"}]},"parent_tool_use_id":"toolu_015Db1w2LmRhkJgHeDaM9a5T","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"a669e23e-3c36-4e09-9689-0defe8faaf80","timestamp":"2026-06-01T11:44:31.175Z","subagent_type":"Implementer","task_description":"Revise sos_201 implementation"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019v8qFjPy42HAtAuMdL7A7s","type":"tool_result","content":"1\t\"\"\"Tests for SOS 201 — Lorehold, the Historian.\n2\t\n3\tLorehold, the Historian ({3}{R}{W} Legendary Creature — Elder Dragon, 5/5)\n4\thas three distinct pieces of behaviour, each covered by its own test class:\n5\t\n6\t1. **Static card data** — name, mana cost, colors, P/T, legendary supertype,\n7\t   Elder Dragon subtypes, and the Flying + Haste keyword set.\n8\t\n9\t2. **Miracle granting** — \"Each instant and sorcery card in your hand has\n10\t   miracle {2}.\" The engine has no native ``miracle`` keyword, so this is the\n11\t   SOS-specific surface the implementer must expose.  These tests probe the\n12\t   observable contract: a method/attribute that reports the miracle cost\n13\t   ({2}) of the controller's hand instants/sorceries while Lorehold is on the\n14\t   battlefield, and that the grant is scoped to instants/sorceries in *your*\n15\t   hand (not creatures, not opponents' hands).  Where the engine genuinely\n16\t   lacks the surface to assert deeper behaviour (the actual draw-step miracle\n17\t   cast), the requirement is recorded in untestable.json.\n18\t\n19\t3. **Opponent-upkeep loot trigger** — \"At the beginning of each opponent's\n20\t   upkeep, you may discard a card. If you do, draw a card.\"  Modelled via\n21\t   ``register_triggers`` wiring a ``BeginningOfUpkeepTriggeredEvent`` trigger\n22\t   whose condition fires only on an opponent's upkeep (when the active player\n23\t   is not the controller), and whose effect optionally discards-then-draws.\n24\t\n25\tThese are TDD red-phase tests: the stub at ``card_impl.py`` is empty, so\n26\teverything here is expected to fail until the card is implemented.\n27\t\"\"\"\n28\t\n29\tfrom __future__ import annotations\n30\t\n31\tfrom typing import Any\n32\t\n33\tfrom cards.sos.sos_201.card_impl import LoreholdTheHistorian\n34\tfrom engine.card import Creature, Instant, Sorcery\n35\tfrom engine.events import BeginningOfUpkeepTriggeredEvent\n36\tfrom engine.game import draw_card\n37\tfrom engine.miracle import get_miracle_cost\n38\tfrom engine.types import (\n39\t    CardType,\n40\t    Color,\n41\t    Keyword,\n42\t    ManaCost,\n43\t    ManaType,\n44\t    Supertype,\n45\t    Zone,\n46\t)\n47\tfrom test_utils import create_game, set_board_state\n48\t\n49\t\n50\t# ---------------------------------------------------------------------------\n51\t# Card factories for hand / graveyard setup\n52\t# ---------------------------------------------------------------------------\n53\t\n54\t\n55\tdef _instant(name: str = \"Test Bolt\") -> Instant:\n56\t    \"\"\"A vanilla instant card for hand setup.\"\"\"\n57\t    return Instant(name=name, mana_cost=ManaCost.parse(\"{R}\"))\n58\t\n59\t\n60\tdef _sorcery(name: str = \"Test Divination\") -> Sorcery:\n61\t    \"\"\"A vanilla sorcery card for hand setup.\"\"\"\n62\t    return Sorcery(name=name, mana_cost=ManaCost.parse(\"{2}{U}\"))\n63\t\n64\t\n65\tdef _vanilla_creature(name: str = \"Grizzly Bears\") -> Creature:\n66\t    \"\"\"A vanilla creature card (not an instant/sorcery).\"\"\"\n67\t    return Creature(name=name, base_power=2, base_toughness=2)\n68\t\n69\t\n70\tdef _lorehold(game: Any) -> LoreholdTheHistorian:\n71\t    \"\"\"Lorehold owned/controlled by player 0.\"\"\"\n72\t    p1 = game.players[0]\n73\t    return LoreholdTheHistorian(owner=p1, controller=p1)\n74\t\n75\t\n76\t# ---------------------------------------------------------------------------\n77\t# 1. Static card data\n78\t# ---------------------------------------------------------------------------\n79\t\n80\t\n81\tclass TestLoreholdProperties:\n82\t    \"\"\"Static card data should match the SOS 201 spec.\"\"\"\n83\t\n84\t    def test_is_creature(self) -> None:\n85\t        card = LoreholdTheHistorian(owner=None)\n86\t        assert isinstance(card, Creature)\n87\t        assert CardType.CREATURE in card.card_types\n88\t\n89\t    def test_name(self) -> None:\n90\t        assert LoreholdTheHistorian(owner=None).name == \"Lorehold, the Historian\"\n91\t\n92\t    def test_mana_cost(self) -> None:\n93\t        assert LoreholdTheHistorian(owner=None).mana_cost == ManaCost.parse(\"{3}{R}{W}\")\n94\t\n95\t    def test_power_toughness(self) -> None:\n96\t        card = LoreholdTheHistorian(owner=None)\n97\t        assert card.base_power == 5\n98\t        assert card.base_toughness == 5\n99\t\n100\t    def test_is_legendary(self) -> None:\n101\t        assert Supertype.LEGENDARY in LoreholdTheHistorian(owner=None).supertypes\n102\t\n103\t    def test_is_elder_dragon(self) -> None:\n104\t        card = LoreholdTheHistorian(owner=None)\n105\t        assert {\"Elder\", \"Dragon\"} <= card.subtypes\n106\t\n107\t    def test_colors_are_red_and_white(self) -> None:\n108\t        card = LoreholdTheHistorian(owner=None)\n109\t        assert card.colors == {Color.RED, Color.WHITE}\n110\t\n111\t    def test_has_flying(self) -> None:\n112\t        assert Keyword.FLYING in LoreholdTheHistorian(owner=None).keywords\n113\t\n114\t    def test_has_haste(self) -> None:\n115\t        assert Keyword.HASTE in LoreholdTheHistorian(owner=None).keywords\n116\t\n117\t    def test_no_extraneous_keywords(self) -> None:\n118\t        # Guard against an over-broad keyword grant: only Flying + Haste.\n119\t        kw = LoreholdTheHistorian(owner=None).keywords\n120\t        assert kw == (Keyword.FLYING | Keyword.HASTE)\n121\t\n122\t\n123\t# ---------------------------------------------------------------------------\n124\t# 2. Miracle granting — \"Each instant and sorcery card in your hand has\n125\t#    miracle {2}.\"\n126\t# ---------------------------------------------------------------------------\n127\t\n128\t\n129\tclass TestLoreholdMiracleGrant:\n130\t    \"\"\"The controller's hand instants/sorceries should report a miracle cost\n131\t    of {2} while Lorehold is on the battlefield.\n132\t\n133\t    The grant surface is whatever the implementer exposes.  We probe the two\n134\t    most plausible observable shapes and accept either:\n135\t      * a method ``miracle_cost(game, card)`` on Lorehold returning a ManaCost\n136\t        (or None for non-qualifying cards), or\n137\t      * a ``card.miracle_cost`` attribute set on the affected hand cards.\n138\t    A test helper resolves whichever exists.\n139\t    \"\"\"\n140\t\n141\t    MIRACLE = ManaCost.parse(\"{2}\")\n142\t\n143\t    @staticmethod\n144\t    def _miracle_cost_of(lorehold: Any, game: Any, card: Any) -> Any:\n145\t        \"\"\"Return the miracle cost the implementation assigns to *card*.\n146\t\n147\t        Tries Lorehold.miracle_cost(game, card) first, then a per-card\n148\t        ``miracle_cost`` attribute.  Returns None if neither is present.\n149\t        \"\"\"\n150\t        fn = getattr(lorehold, \"miracle_cost\", None)\n151\t        if callable(fn):\n152\t            return fn(game, card)\n153\t        return getattr(card, \"miracle_cost\", None)\n154\t\n155\t    def test_hand_instant_has_miracle_two(self) -> None:\n156\t        game = create_game()\n157\t        p1 = game.players[0]\n158\t        card = _lorehold(game)\n159\t        bolt = _instant(\"Hand Bolt\")\n160\t        set_board_state(game, 0, battlefield=[card], hand=[bolt])\n161\t        cost = self._miracle_cost_of(card, game, bolt)\n162\t        assert cost == self.MIRACLE\n163\t\n164\t    def test_hand_sorcery_has_miracle_two(self) -> None:\n165\t        game = create_game()\n166\t        p1 = game.players[0]\n167\t        card = _lorehold(game)\n168\t        sorc = _sorcery(\"Hand Sorcery\")\n169\t        set_board_state(game, 0, battlefield=[card], hand=[sorc])\n170\t        cost = self._miracle_cost_of(card, game, sorc)\n171\t        assert cost == self.MIRACLE\n172\t\n173\t    def test_hand_creature_does_not_get_miracle(self) -> None:\n174\t        \"\"\"Only instant and sorcery cards gain miracle — not creatures.\"\"\"\n175\t        game = create_game()\n176\t        card = _lorehold(game)\n177\t        bear = _vanilla_creature(\"Hand Bear\")\n178\t        set_board_state(game, 0, battlefield=[card], hand=[bear])\n179\t        cost = self._miracle_cost_of(card, game, bear)\n180\t        assert cost in (None, ManaCost()) or cost != self.MIRACLE\n181\t\n182\t    def test_opponent_hand_instant_does_not_get_miracle(self) -> None:\n183\t        \"\"\"'in your hand' — an instant in an opponent's hand is unaffected.\"\"\"\n184\t        game = create_game()\n185\t        card = _lorehold(game)\n186\t        set_board_state(game, 0, battlefield=[card])\n187\t        opp_bolt = _instant(\"Opp Bolt\")\n188\t        set_board_state(game, 1, hand=[opp_bolt])\n189\t        cost = self._miracle_cost_of(card, game, opp_bolt)\n190\t        assert cost in (None, ManaCost()) or cost != self.MIRACLE\n191\t\n192\t\n193\t# ---------------------------------------------------------------------------\n194\t# 3. Opponent-upkeep loot trigger registration\n195\t# ---------------------------------------------------------------------------\n196\t\n197\t\n198\tclass TestLoreholdUpkeepTriggerRegistration:\n199\t    \"\"\"register_triggers wires a BeginningOfUpkeepTriggeredEvent trigger keyed\n200\t    to opponents' upkeeps.\"\"\"\n201\t\n202\t    def test_registers_one_trigger(self) -> None:\n203\t        game = create_game()\n204\t        card = _lorehold(game)\n205\t        before = len(game.trigger_manager.get_triggers_for_source(card))\n206\t        card.register_triggers(game)\n207\t        after = len(game.trigger_manager.get_triggers_for_source(card))\n208\t        assert after - before == 1\n209\t\n210\t    def test_trigger_watches_upkeep_event(self) -> None:\n211\t        game = create_game()\n212\t        card = _lorehold(game)\n213\t        card.register_triggers(game)\n214\t        regs = game.trigger_manager.get_triggers_for_source(card)\n215\t        assert len(regs) == 1\n216\t        assert regs[0].event_type is BeginningOfUpkeepTriggeredEvent\n217\t\n218\t    def test_trigger_controller_is_card_controller(self) -> None:\n219\t        game = create_game()\n220\t        p1 = game.players[0]\n221\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n222\t        card.register_triggers(game)\n223\t        reg = game.trigger_manager.get_triggers_for_source(card)[0]\n224\t        assert reg.controller is p1\n225\t\n226\t    def test_trigger_fires_on_opponents_upkeep(self) -> None:\n227\t        \"\"\"The trigger must fire when the active player (whose upkeep it is) is\n228\t        an opponent of the controller.\"\"\"\n229\t        game = create_game()\n230\t        p1 = game.players[0]\n231\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n232\t        card.register_triggers(game)\n233\t        reg = game.trigger_manager.get_triggers_for_source(card)[0]\n234\t        if reg.condition is None:\n235\t            raise AssertionError(\n236\t                \"Upkeep trigger must be scoped to opponents' upkeeps, not all upkeeps\"\n237\t            )\n238\t        # Opponent (player index 1) is the active player whose upkeep begins.\n239\t        game.active_player_index = 1\n240\t        event = BeginningOfUpkeepTriggeredEvent()\n241\t        assert reg.condition(game, event) is True\n242\t\n243\t    def test_trigger_does_not_fire_on_own_upkeep(self) -> None:\n244\t        \"\"\"The trigger is 'each opponent's upkeep' — not the controller's.\"\"\"\n245\t        game = create_game()\n246\t        p1 = game.players[0]\n247\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n248\t        card.register_triggers(game)\n249\t        reg = game.trigger_manager.get_triggers_for_source(card)[0]\n250\t        if reg.condition is None:\n251\t            raise AssertionError(\n252\t                \"Upkeep trigger must be scoped to opponents' upkeeps, not all upkeeps\"\n253\t            )\n254\t        # Controller (player index 0) is the active player.\n255\t        game.active_player_index = 0\n256\t        event = BeginningOfUpkeepTriggeredEvent()\n257\t        assert reg.condition(game, event) is False\n258\t\n259\t\n260\t# ---------------------------------------------------------------------------\n261\t# 3b. Opponent-upkeep loot trigger effect — discard then draw\n262\t# ---------------------------------------------------------------------------\n263\t\n264\t\n265\tclass TestLoreholdUpkeepTriggerFires:\n266\t    \"\"\"Firing the event on an opponent's upkeep pushes the trigger onto the\n267\t    stack; firing on the controller's own upkeep does not.\"\"\"\n268\t\n269\t    def _setup(self) -> tuple[Any, Any, LoreholdTheHistorian]:\n270\t        game = create_game()\n271\t        p1 = game.players[0]\n272\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n273\t        set_board_state(game, 0, battlefield=[card])\n274\t        card.register_triggers(game)\n275\t        return game, p1, card\n276\t\n277\t    def test_opponent_upkeep_event_pushes_trigger(self) -> None:\n278\t        game, p1, card = self._setup()\n279\t        game.active_player_index = 1\n280\t        assert game.stack.is_empty()\n281\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n282\t        assert not game.stack.is_empty()\n283\t\n284\t    def test_own_upkeep_event_does_not_push_trigger(self) -> None:\n285\t        game, p1, card = self._setup()\n286\t        game.active_player_index = 0\n287\t        assert game.stack.is_empty()\n288\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n289\t        assert game.stack.is_empty()\n290\t\n291\t\n292\tclass TestLoreholdLootEffect:\n293\t    \"\"\"Resolving the trigger: 'you may discard a card. If you do, draw a card.'\n294\t\n295\t    The controller's optionality is driven by ``choose_yes_no`` and the card to\n296\t    discard by ``choose_card`` (DeterministicPlayer script).  We resolve the\n297\t    trigger StackObject directly to observe the discard + draw.\n298\t    \"\"\"\n299\t\n300\t    def _build(self, scripts, *, hand, library):\n301\t        \"\"\"Build a game with Lorehold on player 0's battlefield, player 0 the\n302\t        controller, with a scripted hand and a library to draw from.  Player 1\n303\t        is the active player (opponent's upkeep).\"\"\"\n304\t        game = create_game(scripts=scripts)\n305\t        p1 = game.players[0]\n306\t        card = LoreholdTheHistorian(owner=p1, controller=p1)\n307\t        set_board_state(game, 0, battlefield=[card], hand=hand)\n308\t        # Seed the controller's library so a draw has something to find.\n309\t        lib = game.get_library(p1)\n310\t        for obj in lib.get_all():\n311\t            lib.remove(obj)\n312\t        for c in library:\n313\t            c.owner = p1\n314\t            c.controller = p1\n315\t            lib.add(c)\n316\t        card.register_triggers(game)\n317\t        game.active_player_index = 1\n318\t        return game, p1, card\n319\t\n320\t    def _fire_and_resolve(self, game, card):\n321\t        game.trigger_manager.fire_event(game, BeginningOfUpkeepTriggeredEvent())\n322\t        assert not game.stack.is_empty(), \"opponent upkeep trigger should be on stack\"\n323\t        trigger_obj = game.stack.pop()\n324\t        trigger_obj.on_resolve(game)\n325\t\n326\t    def test_yes_discards_chosen_card_and_draws(self) -> None:\n327\t        \"\"\"Choosing 'yes' discards the chosen card and then draws one.\"\"\"\n328\t        discard_me = _instant(\"Discard Me\")\n329\t        draw_me = _vanilla_creature(\"Draw Me\")\n330\t        # Script: choose_yes_no -> True, choose_card -> the card to discard.\n331\t        game, p1, card = self._build(\n332\t            scripts=([True, discard_me], []),\n333\t            hand=[discard_me],\n334\t            library=[draw_me],\n335\t        )\n336\t\n337\t        self._fire_and_resolve(game, card)\n338\t\n339\t        gy = game.get_graveyard(p1)\n340\t        hand = game.get_hand(p1)\n341\t        assert gy.contains(discard_me), \"chosen card should be discarded to graveyard\"\n342\t        assert hand.contains(draw_me), \"controller should have drawn the top library card\"\n343\t        assert not hand.contains(discard_me), \"discarded card must leave the hand\"\n344\t\n345\t    def test_yes_is_net_neutral_hand_size(self) -> None:\n346\t        \"\"\"Discard one, draw one — hand size is unchanged after a 'yes'.\"\"\"\n347\t        discard_me = _instant(\"Discard Me\")\n348\t        draw_me = _sorcery(\"Draw Me\")\n349\t        game, p1, card = self._build(\n350\t            scripts=([True, discard_me], []),\n351\t            hand=[discard_me],\n352\t            library=[draw_me],\n353\t        )\n354\t\n355\t        self._fire_and_resolve(game, card)\n356\t\n357\t        assert len(game.get_hand(p1).get_all()) == 1\n358\t\n359\t    def test_no_does_not_discard_or_draw(self) -> None:\n360\t        \"\"\"'you may' — declining leaves the hand and library untouched.\"\"\"\n361\t        keep_me = _instant(\"Keep Me\")\n362\t        draw_me = _vanilla_creature(\"Draw Me\")\n363\t        # Script: choose_yes_no -> False.  No choose_card / draw should happen.\n364\t        game, p1, card = self._build(\n365\t            scripts=([False], []),\n366\t            hand=[keep_me],\n367\t            library=[draw_me],\n368\t        )\n369\t\n370\t        self._fire_and_resolve(game, card)\n371\t\n372\t        hand = game.get_hand(p1)\n373\t        gy = game.get_graveyard(p1)\n374\t        assert hand.contains(keep_me), \"declined loot should keep the card in hand\"\n375\t        assert not gy.contains(keep_me), \"nothing should be discarded on 'no'\"\n376\t        assert not hand.contains(draw_me), \"no draw should happen on 'no'\"\n377\t        assert len(hand.get_all()) == 1\n378\t\n379\t    def test_empty_hand_does_not_draw(self) -> None:\n380\t        \"\"\"'If you do' — with no card to discard, no draw occurs.\n381\t\n382\t        With an empty hand the player cannot discard, so the conditional draw\n383\t        must not fire.  An empty script proves no prompt forces a discard that\n384\t        cannot be paid.\n385\t        \"\"\"\n386\t        draw_me = _vanilla_creature(\"Draw Me\")\n387\t        # Yes to the \"you may\", but the hand is empty so the discard can't be\n388\t        # made; the draw is therefore skipped.  Allow either an immediate \"no\"\n389\t        # from an empty-hand guard (empty script) or a single yes/no prompt.\n390\t        game, p1, card = self._build(\n391\t            scripts=([False], []),\n392\t            hand=[],\n393\t            library=[draw_me],\n394\t        )\n395\t\n396\t        self._fire_and_resolve(game, card)\n397\t\n398\t        hand = game.get_hand(p1)\n399\t        assert not hand.contains(draw_me), \"no discard means no draw\"\n400\t        assert len(hand.get_all()) == 0\n401\t\n402\t\n403\t# ---------------------------------------------------------------------------\n404\t# 2b. Miracle draw-time cast — end-to-end through engine.game.draw_card.\n405\t#\n406\t# Previously recorded as untestable (no engine surface).  The implementer\n407\t# added engine/miracle.py + engine.casting.cast_spell_alternative + a draw-time\n408\t# hook in engine.game.draw_card gated on cards_drawn_this_turn, so the full\n409\t# \"reveal/cast on first draw\" contract is now observable.\n410\t# ---------------------------------------------------------------------------\n411\t\n412\t\n413\tclass TestLoreholdMiracleDrawCast:\n414\t    \"\"\"With Lorehold in play, drawing a stamped instant/sorcery as the FIRST\n415\t    card of the turn offers a miracle cast for {2} (paid out of the mana pool),\n416\t    putting the spell on the stack instead of leaving it in hand.\n417\t\n418\t    These tests exercise the real engine path: a card stamped via\n419\t    ``Lorehold.miracle_cost`` is placed on top of the library, then drawn with\n420\t    ``engine.game.draw_card``, which fires the miracle hook.\n421\t    \"\"\"\n422\t\n423\t    MIRACLE = ManaCost.parse(\"{2}\")\n424\t\n425\t    def _build(self, *, scripts, top_card, controller_mana=None):\n426\t        \"\"\"Game with Lorehold on player 0's battlefield (controller = p0), a\n427\t        ``top_card`` placed on top of player 0's library and stamped with\n428\t        Lorehold's miracle cost, and an optional starting mana pool.\n429\t\n430\t        Returns ``(game, p1, lorehold, top_card)``.\n431\t        \"\"\"\n432\t        game = create_game(scripts=scripts)\n433\t        p1 = game.players[0]\n434\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n435\t        set_board_state(game, 0, battlefield=[lorehold])\n436\t        if controller_mana is not None:\n437\t            set_board_state(game, 0, mana=controller_mana)\n438\t\n439\t        # Seed the library with exactly the cards we want, top_card on top.\n440\t        lib = game.get_library(p1)\n441\t        for obj in lib.get_all():\n442\t            lib.remove(obj)\n443\t        top_card.owner = p1\n444\t        top_card.controller = p1\n445\t        lib.add(top_card)\n446\t\n447\t        # Reset the per-turn draw counter so this draw counts as the first.\n448\t        p1.cards_drawn_this_turn = 0\n449\t\n450\t        # Stamp the miracle cost the way Lorehold's static ability does: the\n451\t        # card is about to be drawn into the controller's hand, so we mirror\n452\t        # the engine's grant by stamping it directly.  (miracle_cost() itself\n453\t        # only stamps cards already in hand; the draw-time hook reads the stamp\n454\t        # off the just-drawn card.)\n455\t        from engine.miracle import set_miracle_cost\n456\t\n457\t        set_miracle_cost(top_card, self.MIRACLE)\n458\t        return game, p1, lorehold, top_card\n459\t\n460\t    def test_first_draw_yes_casts_for_miracle_cost(self) -> None:\n461\t        \"\"\"First card drawn + scripted 'yes' + {2} available → the spell is put\n462\t        on the stack (cast), not left in hand.\"\"\"\n463\t        bolt = _instant(\"Miracle Bolt\")\n464\t        game, p1, lorehold, bolt = self._build(\n465\t            scripts=([True], []),\n466\t            top_card=bolt,\n467\t            controller_mana={ManaType.COLORLESS: 2},\n468\t        )\n469\t\n470\t        assert game.stack.is_empty()\n471\t        drawn = draw_card(game, p1)\n472\t\n473\t        assert drawn is bolt\n474\t        # Cast: the spell is on the stack and has left the hand.\n475\t        assert not game.stack.is_empty(), \"miracle 'yes' should put the spell on the stack\"\n476\t        assert game.stack.peek().source is bolt\n477\t        assert not game.get_hand(p1).contains(bolt), \"miracle-cast card leaves the hand\"\n478\t\n479\t    def test_first_draw_yes_pays_two_not_full_cost(self) -> None:\n480\t        \"\"\"The miracle cast pays {2} from the pool, NOT the card's full mana\n481\t        cost.  Starting with exactly {2}, the pool is empty afterward.\"\"\"\n482\t        # Full cost is {2}{U} (3 mana) — but we supply only {2}, proving the\n483\t        # alternative cost is what's paid.\n484\t        sorc = _sorcery(\"Miracle Sorcery\")  # mana_cost {2}{U}\n485\t        game, p1, lorehold, sorc = self._build(\n486\t            scripts=([True], []),\n487\t            top_card=sorc,\n488\t            controller_mana={ManaType.COLORLESS: 2},\n489\t        )\n490\t\n491\t        draw_card(game, p1)\n492\t\n493\t        assert not game.stack.is_empty(), \"spell should be cast for its miracle cost\"\n494\t        assert p1.mana_pool.total() == 0, \"exactly {2} should have been spent\"\n495\t\n496\t    def test_first_draw_no_leaves_card_in_hand(self) -> None:\n497\t        \"\"\"Declining the 'you may' leaves the card in hand (normal draw).\"\"\"\n498\t        bolt = _instant(\"Declined Bolt\")\n499\t        game, p1, lorehold, bolt = self._build(\n500\t            scripts=([False], []),\n501\t            top_card=bolt,\n502\t            controller_mana={ManaType.COLORLESS: 2},\n503\t        )\n504\t\n505\t        drawn = draw_card(game, p1)\n506\t\n507\t        assert drawn is bolt\n508\t        assert game.stack.is_empty(), \"declining miracle should not put anything on the stack\"\n509\t        assert game.get_hand(p1).contains(bolt), \"declined card stays in hand\"\n510\t        assert p1.mana_pool.total() == 2, \"no mana spent when miracle is declined\"\n511\t\n512\t    def test_not_first_draw_does_not_offer_miracle(self) -> None:\n513\t        \"\"\"First-card gating: when the drawn card is NOT the first card drawn\n514\t        this turn, no miracle cast is offered even with mana available.\n515\t\n516\t        We pre-set ``cards_drawn_this_turn`` to a non-zero value so that the\n517\t        draw under test is the SECOND draw of the turn; the gate must suppress\n518\t        the offer (the spell stays in hand, no mana spent, stack empty).\n519\t        \"\"\"\n520\t        bolt = _instant(\"Late Bolt\")\n521\t        # No scripted yes/no answer at all — if the hook wrongly fired it would\n522\t        # raise ScriptExhaustedError, which makes a regression loud.\n523\t        game, p1, lorehold, bolt = self._build(\n524\t            scripts=([], []),\n525\t            top_card=bolt,\n526\t            controller_mana={ManaType.COLORLESS: 2},\n527\t        )\n528\t        # Simulate that a card was already drawn this turn; draw_card will\n529\t        # increment to 2, so this is not the first draw.\n530\t        p1.cards_drawn_this_turn = 1\n531\t\n532\t        drawn = draw_card(game, p1)\n533\t\n534\t        assert drawn is bolt\n535\t        assert game.stack.is_empty(), \"non-first draw must not offer/cast miracle\"\n536\t        assert game.get_hand(p1).contains(bolt), \"card stays in hand when gate blocks\"\n537\t        assert p1.mana_pool.total() == 2, \"no mana spent when gate blocks the offer\"\n538\t\n539\t    def test_first_draw_yes_without_mana_keeps_card_in_hand(self) -> None:\n540\t        \"\"\"If the controller says yes but cannot pay {2}, the cast fails\n541\t        gracefully and the card remains in hand (no exception, stack empty).\"\"\"\n542\t        bolt = _instant(\"Broke Bolt\")\n543\t        game, p1, lorehold, bolt = self._build(\n544\t            scripts=([True], []),\n545\t            top_card=bolt,\n546\t            controller_mana=None,  # empty pool\n547\t        )\n548\t\n549\t        drawn = draw_card(game, p1)\n550\t\n551\t        assert drawn is bolt\n552\t        assert game.stack.is_empty(), \"no mana → no cast on the stack\"\n553\t        assert game.get_hand(p1).contains(bolt), \"unpayable miracle leaves card in hand\"\n554\t\n555\t    def test_stamp_is_readable_via_engine_helper(self) -> None:\n556\t        \"\"\"Sanity check on the shared contract: the miracle stamp Lorehold sets\n557\t        on a hand card is the same {2} the draw-time hook reads via\n558\t        ``engine.miracle.get_miracle_cost``.\"\"\"\n559\t        game = create_game()\n560\t        p1 = game.players[0]\n561\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n562\t        bolt = _instant(\"Stamp Bolt\")\n563\t        set_board_state(game, 0, battlefield=[lorehold], hand=[bolt])\n564\t\n565\t        # Lorehold's static ability stamps the hand card.\n566\t        lorehold.miracle_cost(game, bolt)\n567\t\n568\t        assert get_miracle_cost(bolt) == self.MIRACLE\n569\t"}]},"parent_tool_use_id":"toolu_015Db1w2LmRhkJgHeDaM9a5T","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"2b6257fe-d9e8-400a-a975-d9b2f052f044","timestamp":"2026-06-01T11:44:31.176Z","subagent_type":"Implementer","task_description":"Revise sos_201 implementation"}
