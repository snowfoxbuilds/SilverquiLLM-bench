{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GDNwsvaaW2rEZkRpz8opyp","type":"tool_result","content":"1\t\"\"\"Tests for SOS 97 — Ral Zarek, Guest Lecturer.\n2\t\n3\tRal Zarek, Guest Lecturer is a Legendary Planeswalker — Ral with starting\n4\tloyalty 3 and four loyalty abilities:\n5\t\n6\t  +1: Surveil 2.\n7\t  -1: Any number of target players each discard a card.\n8\t  -2: Return target creature card with mana value 3 or less from your\n9\t      graveyard to the battlefield.\n10\t  -7: Flip five coins. Target opponent skips their next X turns, where X is\n11\t      the number of coins that came up heads.\n12\t\n13\tThese tests follow the planeswalker reference convention in\n14\t``cards/fdn/fdn_134`` (loyalty abilities are obtained via\n15\t``get_loyalty_abilities()`` and resolved by calling ``ability.effect(game)``;\n16\tthe per-ability target is supplied on the planeswalker via ``_resolve_target``\n17\t/ a chosen-targets attribute the Implementer reads).\n18\t\n19\tTDD red phase — the implementation stub is empty, so these are expected to\n20\tfail until the card is implemented.\n21\t\"\"\"\n22\t\n23\tfrom __future__ import annotations\n24\t\n25\tfrom typing import Any\n26\t\n27\timport pytest\n28\t\n29\tfrom cards.sos.sos_97.card_impl import RalZarekGuestLecturer\n30\tfrom engine.card import Creature, LoyaltyAbility, Planeswalker\n31\tfrom engine.types import CardType, ManaCost, ManaType, Supertype, Zone\n32\tfrom test_utils import create_game, set_board_state\n33\t\n34\t\n35\t# ---------------------------------------------------------------------------\n36\t# Helpers\n37\t# ---------------------------------------------------------------------------\n38\t\n39\tdef _make_pw(owner: Any = None, controller: Any = None) -> RalZarekGuestLecturer:\n40\t    return RalZarekGuestLecturer(owner=owner, controller=controller)\n41\t\n42\t\n43\tdef _abilities(pw: RalZarekGuestLecturer) -> list[LoyaltyAbility]:\n44\t    return pw.get_loyalty_abilities()\n45\t\n46\t\n47\tdef _ability_with_cost(pw: RalZarekGuestLecturer, cost: int) -> LoyaltyAbility:\n48\t    for ab in _abilities(pw):\n49\t        if ab.loyalty_cost == cost:\n50\t            return ab\n51\t    raise AssertionError(f\"No loyalty ability with cost {cost}\")\n52\t\n53\t\n54\tdef _set_target(pw: RalZarekGuestLecturer, target: Any) -> None:\n55\t    \"\"\"Supply the single-target a loyalty ability reads.\n56\t\n57\t    The fdn_134 reference reads ``_resolve_target``; some sos cards use\n58\t    ``chosen_targets``. Set both so the test stays robust to whichever the\n59\t    Implementer follows.\n60\t    \"\"\"\n61\t    pw._resolve_target = target\n62\t    pw.chosen_targets = [target] if target is not None else []\n63\t\n64\t\n65\tdef _set_targets(pw: RalZarekGuestLecturer, targets: list[Any]) -> None:\n66\t    \"\"\"Supply a multi-target list (for the −1 'any number of players').\"\"\"\n67\t    pw._resolve_targets = list(targets)\n68\t    pw.chosen_targets = list(targets)\n69\t    pw._resolve_target = targets[0] if targets else None\n70\t\n71\t\n72\tdef _bear(name: str = \"Grizzly Bears\", power: int = 2, toughness: int = 2,\n73\t          cost: str = \"{1}{G}\") -> Creature:\n74\t    return Creature(\n75\t        name=name,\n76\t        base_power=power,\n77\t        base_toughness=toughness,\n78\t        mana_cost=ManaCost.parse(cost),\n79\t    )\n80\t\n81\t\n82\t# ---------------------------------------------------------------------------\n83\t# Static card data\n84\t# ---------------------------------------------------------------------------\n85\t\n86\tclass TestRalZarekProperties:\n87\t    def test_is_planeswalker_subclass(self) -> None:\n88\t        assert isinstance(_make_pw(), Planeswalker)\n89\t\n90\t    def test_name(self) -> None:\n91\t        assert _make_pw().name == \"Ral Zarek, Guest Lecturer\"\n92\t\n93\t    def test_mana_cost(self) -> None:\n94\t        assert _make_pw().mana_cost == ManaCost.parse(\"{1}{B}{B}\")\n95\t\n96\t    def test_is_planeswalker_card_type(self) -> None:\n97\t        assert CardType.PLANESWALKER in _make_pw().card_types\n98\t\n99\t    def test_is_legendary(self) -> None:\n100\t        pw = _make_pw()\n101\t        # Legendary may be modelled via supertypes or card_types.\n102\t        legendary = (\n103\t            Supertype.LEGENDARY in getattr(pw, \"supertypes\", set())\n104\t            or CardType.LEGENDARY in pw.card_types\n105\t        )\n106\t        assert legendary\n107\t\n108\t    def test_subtype_ral(self) -> None:\n109\t        assert \"Ral\" in _make_pw().subtypes\n110\t\n111\t    def test_starting_loyalty_is_three(self) -> None:\n112\t        pw = _make_pw()\n113\t        assert pw.starting_loyalty == 3\n114\t        assert pw.loyalty == 3\n115\t\n116\t\n117\t# ---------------------------------------------------------------------------\n118\t# Loyalty ability declaration\n119\t# ---------------------------------------------------------------------------\n120\t\n121\tclass TestRalZarekLoyaltyAbilities:\n122\t    def test_declares_four_abilities(self) -> None:\n123\t        assert len(_abilities(_make_pw())) == 4\n124\t\n125\t    def test_loyalty_costs(self) -> None:\n126\t        costs = sorted(ab.loyalty_cost for ab in _abilities(_make_pw()))\n127\t        assert costs == [-7, -2, -1, +1]\n128\t\n129\t    def test_each_is_loyalty_ability(self) -> None:\n130\t        for ab in _abilities(_make_pw()):\n131\t            assert isinstance(ab, LoyaltyAbility)\n132\t\n133\t\n134\t# ---------------------------------------------------------------------------\n135\t# +1: Surveil 2\n136\t# ---------------------------------------------------------------------------\n137\t\n138\tclass TestRalZarekPlusOneSurveil:\n139\t    def _setup(self):\n140\t        game = create_game()\n141\t        controller = game.players[0]\n142\t        pw = _make_pw(owner=controller, controller=controller)\n143\t        set_board_state(game, 0, battlefield=[pw])\n144\t        return game, controller, pw\n145\t\n146\t    def test_surveil_keeps_top_cards_on_top(self) -> None:\n147\t        \"\"\"With a yes/keep script, top two stay on top of the library and\n148\t        none are milled to the graveyard.\"\"\"\n149\t        game, controller, pw = self._setup()\n150\t        lib = game.get_library(controller)\n151\t        top = _bear(\"Top Card\")\n152\t        second = _bear(\"Second Card\")\n153\t        third = _bear(\"Third Card\")\n154\t        # add() pushes to top, so add third first to keep top/second on top.\n155\t        for c in (third, second, top):\n156\t            c.owner = controller\n157\t            lib.add(c)\n158\t        controller._script.extend([True, True])  # keep both on top\n159\t\n160\t        _ability_with_cost(pw, +1).effect(game)\n161\t\n162\t        gy = game.get_graveyard(controller)\n163\t        assert gy.contains(top) is False\n164\t        assert gy.contains(second) is False\n165\t        assert lib.contains(top)\n166\t        assert lib.contains(second)\n167\t\n168\t    def test_surveil_can_mill_cards_to_graveyard(self) -> None:\n169\t        \"\"\"Surveil 2 lets the controller put looked-at cards into the\n170\t        graveyard; a 'put to graveyard' choice moves them there.\"\"\"\n171\t        game, controller, pw = self._setup()\n172\t        lib = game.get_library(controller)\n173\t        a = _bear(\"Card A\")\n174\t        b = _bear(\"Card B\")\n175\t        for c in (b, a):\n176\t            c.owner = controller\n177\t            lib.add(c)\n178\t        # Script both surveil decisions as \"to graveyard\".\n179\t        controller._script.extend([False, False])\n180\t\n181\t        _ability_with_cost(pw, +1).effect(game)\n182\t\n183\t        gy = game.get_graveyard(controller)\n184\t        assert gy.contains(a)\n185\t        assert gy.contains(b)\n186\t\n187\t    def test_surveil_looks_at_only_top_two(self) -> None:\n188\t        \"\"\"Surveil 2 never touches the third card from the top.\"\"\"\n189\t        game, controller, pw = self._setup()\n190\t        lib = game.get_library(controller)\n191\t        a = _bear(\"Card A\")\n192\t        b = _bear(\"Card B\")\n193\t        c = _bear(\"Card C\")\n194\t        for card in (c, b, a):\n195\t            card.owner = controller\n196\t            lib.add(card)\n197\t        controller._script.extend([False, False])  # mill both looked at\n198\t\n199\t        _ability_with_cost(pw, +1).effect(game)\n200\t\n201\t        # Third card is untouched — still in library, not graveyard.\n202\t        assert lib.contains(c)\n203\t        assert game.get_graveyard(controller).contains(c) is False\n204\t\n205\t\n206\t# ---------------------------------------------------------------------------\n207\t# -1: Any number of target players each discard a card\n208\t# ---------------------------------------------------------------------------\n209\t\n210\tclass TestRalZarekMinusOneDiscard:\n211\t    def _setup(self):\n212\t        game = create_game()\n213\t        controller, opponent = game.players[0], game.players[1]\n214\t        pw = _make_pw(owner=controller, controller=controller)\n215\t        set_board_state(game, 0, battlefield=[pw])\n216\t        return game, controller, opponent, pw\n217\t\n218\t    def test_targeted_opponent_discards_a_card(self) -> None:\n219\t        game, controller, opponent, pw = self._setup()\n220\t        card = _bear(\"Discardable\")\n221\t        set_board_state(game, 1, hand=[card])\n222\t        # opponent chooses which card to discard\n223\t        opponent._script.append(card)\n224\t        _set_targets(pw, [opponent])\n225\t\n226\t        _ability_with_cost(pw, -1).effect(game)\n227\t\n228\t        assert game.get_hand(opponent).contains(card) is False\n229\t        assert game.get_graveyard(opponent).contains(card)\n230\t\n231\t    def test_multiple_targets_each_discard(self) -> None:\n232\t        game, controller, opponent, pw = self._setup()\n233\t        c1 = _bear(\"C1\")\n234\t        c2 = _bear(\"C2\")\n235\t        set_board_state(game, 0, battlefield=[pw], hand=[c1])\n236\t        set_board_state(game, 1, hand=[c2])\n237\t        controller._script.append(c1)\n238\t        opponent._script.append(c2)\n239\t        _set_targets(pw, [controller, opponent])\n240\t\n241\t        _ability_with_cost(pw, -1).effect(game)\n242\t\n243\t        assert game.get_hand(controller).contains(c1) is False\n244\t        assert game.get_graveyard(controller).contains(c1)\n245\t        assert game.get_hand(opponent).contains(c2) is False\n246\t        assert game.get_graveyard(opponent).contains(c2)\n247\t\n248\t    def test_zero_targets_is_a_no_op(self) -> None:\n249\t        \"\"\"'Any number' allows choosing zero players — nothing is discarded.\"\"\"\n250\t        game, controller, opponent, pw = self._setup()\n251\t        card = _bear(\"Stays\")\n252\t        set_board_state(game, 1, hand=[card])\n253\t        _set_targets(pw, [])\n254\t\n255\t        _ability_with_cost(pw, -1).effect(game)\n256\t\n257\t        assert game.get_hand(opponent).contains(card)\n258\t\n259\t    def test_targeted_player_with_empty_hand_does_not_crash(self) -> None:\n260\t        game, controller, opponent, pw = self._setup()\n261\t        set_board_state(game, 1, hand=[])\n262\t        _set_targets(pw, [opponent])\n263\t\n264\t        # Should not raise even though there's nothing to discard.\n265\t        _ability_with_cost(pw, -1).effect(game)\n266\t\n267\t        assert len(game.get_hand(opponent).get_all()) == 0\n268\t\n269\t\n270\t# ---------------------------------------------------------------------------\n271\t# -2: Return target creature (mv <= 3) from your graveyard to battlefield\n272\t# ---------------------------------------------------------------------------\n273\t\n274\tclass TestRalZarekMinusTwoReanimate:\n275\t    def _setup(self):\n276\t        game = create_game()\n277\t        controller, opponent = game.players[0], game.players[1]\n278\t        pw = _make_pw(owner=controller, controller=controller)\n279\t        set_board_state(game, 0, battlefield=[pw])\n280\t        return game, controller, opponent, pw\n281\t\n282\t    def test_returns_low_mv_creature_to_battlefield(self) -> None:\n283\t        game, controller, opponent, pw = self._setup()\n284\t        creature = _bear(\"Cheap Beast\", cost=\"{1}{G}\")  # mv 2\n285\t        set_board_state(game, 0, battlefield=[pw], graveyard=[creature])\n286\t        _set_target(pw, creature)\n287\t\n288\t        _ability_with_cost(pw, -2).effect(game)\n289\t\n290\t        assert game.get_battlefield(controller).contains(creature)\n291\t        assert game.get_graveyard(controller).contains(creature) is False\n292\t\n293\t    def test_mv_exactly_three_is_eligible(self) -> None:\n294\t        game, controller, opponent, pw = self._setup()\n295\t        creature = _bear(\"Three Drop\", cost=\"{1}{G}{G}\")  # mv 3\n296\t        set_board_state(game, 0, battlefield=[pw], graveyard=[creature])\n297\t        _set_target(pw, creature)\n298\t\n299\t        _ability_with_cost(pw, -2).effect(game)\n300\t\n301\t        assert game.get_battlefield(controller).contains(creature)\n302\t\n303\t    def test_no_target_is_a_no_op(self) -> None:\n304\t        game, controller, opponent, pw = self._setup()\n305\t        creature = _bear(\"Stays Dead\", cost=\"{1}{G}\")\n306\t        set_board_state(game, 0, battlefield=[pw], graveyard=[creature])\n307\t        _set_target(pw, None)\n308\t\n309\t        _ability_with_cost(pw, -2).effect(game)\n310\t\n311\t        # Not returned because no target was chosen.\n312\t        assert game.get_graveyard(controller).contains(creature)\n313\t        assert game.get_battlefield(controller).contains(creature) is False\n314\t\n315\t\n316\t# ---------------------------------------------------------------------------\n317\t# -7: Flip five coins; opponent skips next X turns (X = heads).\n318\t# ---------------------------------------------------------------------------\n319\t\n320\tclass TestRalZarekUltimate:\n321\t    def _setup(self):\n322\t        game = create_game()\n323\t        controller, opponent = game.players[0], game.players[1]\n324\t        pw = _make_pw(owner=controller, controller=controller)\n325\t        set_board_state(game, 0, battlefield=[pw])\n326\t        pw.loyalty = 7\n327\t        return game, controller, opponent, pw\n328\t\n329\t    def _patch_coins(self, monkeypatch, heads_count: int) -> None:\n330\t        \"\"\"Force exactly five coin flips with ``heads_count`` heads.\n331\t\n332\t        Patches random.random/randint/choice so the result is deterministic\n333\t        regardless of which the Implementer uses to flip coins.\n334\t        \"\"\"\n335\t        import random as _random\n336\t\n337\t        results = [True] * heads_count + [False] * (5 - heads_count)\n338\t        seq = list(results)\n339\t\n340\t        def fake_choice(opts):\n341\t            return seq.pop(0) if seq else False\n342\t\n343\t        def fake_randint(a, b):\n344\t            return 1 if (seq.pop(0) if seq else False) else 0\n345\t\n346\t        def fake_random():\n347\t            return 0.0 if (seq.pop(0) if seq else False) else 0.9\n348\t\n349\t        monkeypatch.setattr(_random, \"choice\", fake_choice, raising=False)\n350\t        monkeypatch.setattr(_random, \"randint\", fake_randint, raising=False)\n351\t        monkeypatch.setattr(_random, \"random\", fake_random, raising=False)\n352\t\n353\t    def test_three_heads_skips_three_turns(self, monkeypatch) -> None:\n354\t        game, controller, opponent, pw = self._setup()\n355\t        self._patch_coins(monkeypatch, heads_count=3)\n356\t        _set_target(pw, opponent)\n357\t\n358\t        _ability_with_cost(pw, -7).effect(game)\n359\t\n360\t        opp_index = game.players.index(opponent)\n361\t        skips = getattr(opponent, \"skipped_turns\", None)\n362\t        if skips is None:\n363\t            skips = getattr(game, \"skipped_turns\", {}).get(opp_index)\n364\t        assert skips == 3\n365\t\n366\t    def test_zero_heads_skips_no_turns(self, monkeypatch) -> None:\n367\t        game, controller, opponent, pw = self._setup()\n368\t        self._patch_coins(monkeypatch, heads_count=0)\n369\t        _set_target(pw, opponent)\n370\t\n371\t        _ability_with_cost(pw, -7).effect(game)\n372\t\n373\t        opp_index = game.players.index(opponent)\n374\t        skips = getattr(opponent, \"skipped_turns\", None)\n375\t        if skips is None:\n376\t            skips = getattr(game, \"skipped_turns\", {}).get(opp_index, 0)\n377\t        assert (skips or 0) == 0\n378\t\n379\t    def test_five_heads_skips_five_turns(self, monkeypatch) -> None:\n380\t        game, controller, opponent, pw = self._setup()\n381\t        self._patch_coins(monkeypatch, heads_count=5)\n382\t        _set_target(pw, opponent)\n383\t\n384\t        _ability_with_cost(pw, -7).effect(game)\n385\t\n386\t        opp_index = game.players.index(opponent)\n387\t        skips = getattr(opponent, \"skipped_turns\", None)\n388\t        if skips is None:\n389\t            skips = getattr(game, \"skipped_turns\", {}).get(opp_index)\n390\t        assert skips == 5\n391\t\n392\t    def test_ultimate_targets_an_opponent(self, monkeypatch) -> None:\n393\t        \"\"\"The skip count must be applied to the targeted opponent, not the\n394\t        controller.\"\"\"\n395\t        game, controller, opponent, pw = self._setup()\n396\t        self._patch_coins(monkeypatch, heads_count=2)\n397\t        _set_target(pw, opponent)\n398\t\n399\t        _ability_with_cost(pw, -7).effect(game)\n400\t\n401\t        ctrl_index = game.players.index(controller)\n402\t        ctrl_skips = getattr(controller, \"skipped_turns\", None)\n403\t        if ctrl_skips is None:\n404\t            ctrl_skips = getattr(game, \"skipped_turns\", {}).get(ctrl_index, 0)\n405\t        assert (ctrl_skips or 0) == 0\n406\t\n407\t\n408\t# ---------------------------------------------------------------------------\n409\t# Loyalty cost payment via the activation pipeline\n410\t# ---------------------------------------------------------------------------\n411\t\n412\tclass TestRalZarekLoyaltyCosts:\n413\t    def test_plus_one_raises_loyalty(self) -> None:\n414\t        \"\"\"Activating +1 through the engine pipeline raises loyalty 3 -> 4.\"\"\"\n415\t        from engine.abilities import (\n416\t            LoyaltyAbilityInstance,\n417\t            activate_ability,\n418\t            clear_loyalty_tracking,\n419\t        )\n420\t        from engine.types import Phase\n421\t\n422\t        game = create_game()\n423\t        controller = game.players[0]\n424\t        pw = _make_pw(owner=controller, controller=controller)\n425\t        set_board_state(game, 0, battlefield=[pw])\n426\t        # Give the controller library cards so Surveil 2 has something to look at.\n427\t        lib = game.get_library(controller)\n428\t        for c in (_bear(\"L2\"), _bear(\"L1\")):\n429\t            c.owner = controller\n430\t            lib.add(c)\n431\t        controller._script.extend([True, True])  # keep both on top\n432\t        clear_loyalty_tracking()\n433\t        game.phase = Phase.PRECOMBAT_MAIN\n434\t        game.step = None\n435\t        game.active_player_index = 0\n436\t        game.priority_player_index = 0\n437\t\n438\t        plus = _ability_with_cost(pw, +1)\n439\t        inst = LoyaltyAbilityInstance(\n440\t            source=pw,\n441\t            controller=controller,\n442\t            loyalty_cost=plus.loyalty_cost,\n443\t            effect=plus.effect,\n444\t        )\n445\t        activate_ability(game, controller, inst)\n446\t        assert pw.loyalty == 4\n447\t\n448\t    def test_minus_seven_requires_seven_loyalty(self) -> None:\n449\t        \"\"\"At starting loyalty 3 the ultimate cannot be paid; the engine's\n450\t        loyalty-cost guard should reject it.\"\"\"\n451\t        from engine.abilities import (\n452\t            AbilityError,\n453\t            LoyaltyAbilityInstance,\n454\t            activate_ability,\n455\t            clear_loyalty_tracking,\n456\t        )\n457\t        from engine.types import Phase, Step\n458\t\n459\t        game = create_game()\n460\t        controller = game.players[0]\n461\t        pw = _make_pw(owner=controller, controller=controller)\n462\t        set_board_state(game, 0, battlefield=[pw])\n463\t        clear_loyalty_tracking()\n464\t        game.phase = Phase.PRECOMBAT_MAIN\n465\t        game.step = None\n466\t        game.priority_player_index = 0\n467\t        ult = _ability_with_cost(pw, -7)\n468\t        inst = LoyaltyAbilityInstance(\n469\t            source=pw,\n470\t            controller=controller,\n471\t            loyalty_cost=ult.loyalty_cost,\n472\t            effect=ult.effect,\n473\t        )\n474\t        with pytest.raises(AbilityError):\n475\t            activate_ability(game, controller, inst)\n476\t"}]},"parent_tool_use_id":"toolu_01BjxkzZ6oUYxDmJcFLGTGw8","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"e9775828-8eef-4230-89fb-5b85aa2ec2c2","timestamp":"2026-06-01T11:20:09.646Z","subagent_type":"Implementer","task_description":"Revise sos_97 implementation"}
