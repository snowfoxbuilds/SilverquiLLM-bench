{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XUCGLrUsBwLUKSEGCabp6o","type":"tool_result","content":"1\t\"\"\"Zone containers for managing game objects across game zones.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport random\n6\tfrom typing import TYPE_CHECKING, Any\n7\t\n8\tfrom engine.types import CardType, Zone\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t\n13\t\n14\tclass IllegalMoveError(Exception):\n15\t    \"\"\"Raised when a zone move is illegal (e.g. object not found in source zone).\"\"\"\n16\t\n17\t\n18\tclass ZoneContainer:\n19\t    \"\"\"Wraps an ordered list of game-object references for a single zone.\n20\t\n21\t    Internal list convention: index 0 is the *bottom*, index -1 is the *top*.\n22\t    This matches the intuitive model where ``add(obj, position=\"top\")``\n23\t    appends, and ``top(n)`` returns the last *n* items.\n24\t    \"\"\"\n25\t\n26\t    def __init__(self) -> None:\n27\t        self._objects: list[Any] = []\n28\t\n29\t    # ------------------------------------------------------------------\n30\t    # Mutators\n31\t    # ------------------------------------------------------------------\n32\t\n33\t    def add(self, obj: Any, position: str = \"top\") -> None:\n34\t        \"\"\"Add *obj* to this zone.\n35\t\n36\t        Parameters:\n37\t            obj: The game object to add.\n38\t            position: ``\"top\"`` (default) appends to the end of the internal\n39\t                list; ``\"bottom\"`` inserts at position 0.\n40\t        \"\"\"\n41\t        if position == \"top\":\n42\t            self._objects.append(obj)\n43\t        elif position == \"bottom\":\n44\t            self._objects.insert(0, obj)\n45\t        else:\n46\t            raise ValueError(f\"Invalid position: {position!r}; expected 'top' or 'bottom'\")\n47\t\n48\t    def remove(self, obj: Any) -> None:\n49\t        \"\"\"Remove *obj* from this zone (identity-based lookup).\n50\t\n51\t        Raises:\n52\t            ValueError: If *obj* is not in the zone.\n53\t        \"\"\"\n54\t        for i, item in enumerate(self._objects):\n55\t            if item is obj:\n56\t                del self._objects[i]\n57\t                return\n58\t        raise ValueError(f\"{obj!r} not in zone\")\n59\t\n60\t    def shuffle(self) -> None:\n61\t        \"\"\"Randomly shuffle the contents of this zone (used for libraries).\"\"\"\n62\t        random.shuffle(self._objects)\n63\t\n64\t    # ------------------------------------------------------------------\n65\t    # Queries\n66\t    # ------------------------------------------------------------------\n67\t\n68\t    def contains(self, obj: Any) -> bool:\n69\t        \"\"\"Return ``True`` if *obj* is in this zone (identity-based lookup).\"\"\"\n70\t        return any(item is obj for item in self._objects)\n71\t\n72\t    def get_all(self) -> list[Any]:\n73\t        \"\"\"Return a shallow copy of all objects in order (bottom → top).\"\"\"\n74\t        return list(self._objects)\n75\t\n76\t    def top(self, n: int) -> list[Any]:\n77\t        \"\"\"Return the top *n* items (last *n* in the internal list).\n78\t\n79\t        If *n* >= len, returns all items.  Order is bottom-to-top (same\n80\t        orientation as the internal list).\n81\t        \"\"\"\n82\t        if n <= 0:\n83\t            return []\n84\t        return self._objects[-n:]\n85\t\n86\t    def bottom(self, n: int) -> list[Any]:\n87\t        \"\"\"Return the bottom *n* items (first *n* in the internal list).\n88\t\n89\t        If *n* >= len, returns all items.\n90\t        \"\"\"\n91\t        if n <= 0:\n92\t            return []\n93\t        return self._objects[:n]\n94\t\n95\t    def __len__(self) -> int:\n96\t        return len(self._objects)\n97\t\n98\t    def __repr__(self) -> str:\n99\t        return f\"ZoneContainer({self._objects!r})\"\n100\t\n101\t\n102\tclass Zones:\n103\t    \"\"\"Per-player collection mapping each :class:`Zone` to a :class:`ZoneContainer`.\"\"\"\n104\t\n105\t    def __init__(self, zones: dict[Zone, ZoneContainer]) -> None:\n106\t        self._zones = zones\n107\t\n108\t    @classmethod\n109\t    def new_player(cls) -> Zones:\n110\t        \"\"\"Create a fresh set of empty zones for a player.\"\"\"\n111\t        return cls({zone: ZoneContainer() for zone in Zone})\n112\t\n113\t    def __getitem__(self, zone: Zone) -> ZoneContainer:\n114\t        return self._zones[zone]\n115\t\n116\t    def __contains__(self, zone: Zone) -> bool:\n117\t        return zone in self._zones\n118\t\n119\t    def __repr__(self) -> str:\n120\t        return f\"Zones({self._zones!r})\"\n121\t\n122\t\n123\tdef move_zone(\n124\t    obj: Any,\n125\t    from_zone: ZoneContainer,\n126\t    to_zone: ZoneContainer,\n127\t    position: str = \"top\",\n128\t) -> None:\n129\t    \"\"\"Move *obj* from *from_zone* to *to_zone*.\n130\t\n131\t    Parameters:\n132\t        obj: The game object to move.\n133\t        from_zone: Source :class:`ZoneContainer`.\n134\t        to_zone: Destination :class:`ZoneContainer`.\n135\t        position: ``\"top\"`` (default), ``\"bottom\"``, or ``\"shuffle\"``\n136\t            (add then shuffle the destination).\n137\t\n138\t    Raises:\n139\t        IllegalMoveError: If *obj* is not in *from_zone*.\n140\t    \"\"\"\n141\t    # Moving an object to the same zone it's already in is a no-op.\n142\t    if from_zone is to_zone:\n143\t        return\n144\t\n145\t    if not from_zone.contains(obj):\n146\t        raise IllegalMoveError(\n147\t            f\"Object {obj!r} not found in source zone\"\n148\t        )\n149\t\n150\t    # Validate position *before* mutating either zone so that an invalid\n151\t    # position does not leave the object removed from the source without\n152\t    # being added to the destination.\n153\t    if position not in (\"top\", \"bottom\", \"shuffle\"):\n154\t        raise ValueError(f\"Invalid position: {position!r}; expected 'top', 'bottom', or 'shuffle'\")\n155\t\n156\t    from_zone.remove(obj)\n157\t\n158\t    # Clear transient casting metadata when a card changes zones so that\n159\t    # stale data (e.g. colors_spent from a previous cast) does not leak.\n160\t    if hasattr(obj, \"colors_spent\"):\n161\t        del obj.colors_spent\n162\t\n163\t    if position == \"shuffle\":\n164\t        to_zone.add(obj, position=\"top\")\n165\t        to_zone.shuffle()\n166\t    else:\n167\t        to_zone.add(obj, position=position)\n168\t\n169\t\n170\t# Mapping from replacement-effect destination strings to Zone enum values.\n171\t_DESTINATION_ZONE_MAP: dict[str, Zone] = {\n172\t    \"graveyard\": Zone.GRAVEYARD,\n173\t    \"exile\": Zone.EXILE,\n174\t    \"hand\": Zone.HAND,\n175\t    \"library\": Zone.LIBRARY,\n176\t}\n177\t\n178\t\n179\tdef move_to_zone(\n180\t    game: GameState,\n181\t    card: Any,\n182\t    from_zone: Zone,\n183\t    to_zone: Zone,\n184\t    *,\n185\t    replacement_event: Any | None = None,\n186\t) -> None:\n187\t    \"\"\"High-level zone transition with trigger/replacement-effect hooks.\n188\t\n189\t    Centralises the bookkeeping that was previously duplicated across\n190\t    ``destroy()``, ``sacrifice()``, ``exile()``, ``create_token()``,\n191\t    ``_move_to_graveyard()`` (SBAs), and ``_resolve_spell()`` (casting).\n192\t\n193\t    Steps:\n194\t    1. Consult replacement effects for zone-change redirection (if\n195\t       *replacement_event* is supplied and the card is leaving the\n196\t       battlefield).  The replacement may change the destination zone\n197\t       (e.g. exile instead of graveyard) or set ``prevented = True`` to\n198\t       signal that it handled the zone move directly.\n199\t    2. Remove *card* from the source zone.\n200\t    3. Add *card* to the (possibly redirected) destination zone.\n201\t    4. If leaving the battlefield:\n202\t       a. Fire ``LeavesBattlefieldTriggeredEvent``.\n203\t       b. Fire ``CreatureDiesTriggeredEvent`` if the card is a creature\n204\t          **and** the final destination is the graveyard.\n205\t       c. Unregister triggers and replacement effects (fires happen\n206\t          **before** unregister so self-referencing triggers still match).\n207\t    5. If entering the battlefield:\n208\t       a. Register triggers (``register_triggers``) and replacement\n209\t          effects (``register_replacement_effects``).\n210\t       b. Fire ``EntersBattlefieldTriggeredEvent``.\n211\t\n212\t    Parameters:\n213\t        game: The current game state.\n214\t        card: The game object being moved.\n215\t        from_zone: The :class:`Zone` the card is currently in.\n216\t        to_zone: The intended destination :class:`Zone`.\n217\t        replacement_event: Optional typed replacement-event object\n218\t            (e.g. ``CreatureDiesReplacementEvent``).  When ``None``,\n219\t            no replacement effects are consulted (useful for simple\n220\t            moves like casting resolution or exile-from-graveyard).\n221\t    \"\"\"\n222\t    from engine.events import (\n223\t        CreatureDiesTriggeredEvent,\n224\t        EntersBattlefieldTriggeredEvent,\n225\t        LeavesBattlefieldTriggeredEvent,\n226\t    )\n227\t\n228\t    controller = getattr(card, \"controller\", None)\n229\t    owner = getattr(card, \"owner\", controller)\n230\t\n231\t    leaving_battlefield = from_zone == Zone.BATTLEFIELD\n232\t    entering_battlefield = to_zone == Zone.BATTLEFIELD\n233\t\n234\t    # --- Determine the source player for zone lookup ---\n235\t    # When leaving the battlefield, use the controller's zone.\n236\t    # For other zones (hand, graveyard, etc.), use the owner's zone.\n237\t    if leaving_battlefield:\n238\t        source_player = controller\n239\t    else:\n240\t        source_player = owner\n241\t\n242\t    # Fallback: search all players for the zone containing the card.\n243\t    # Also triggered when the inferred player's zone doesn't contain the card\n244\t    # (e.g. discarding a card that's in a different player's hand than its owner).\n245\t    if source_player is None or not source_player.zones[from_zone].contains(card):\n246\t        for player in game.players:\n247\t            if player.zones[from_zone].contains(card):\n248\t                source_player = player\n249\t                break\n250\t\n251\t    if source_player is None:\n252\t        return  # Card not found anywhere\n253\t\n254\t    source_container = source_player.zones[from_zone]\n255\t    if not source_container.contains(card):\n256\t        return  # Safety: card not in any player's zone\n257\t\n258\t    if owner is None:\n259\t        owner = source_player\n260\t\n261\t    # --- Replacement effects (zone-change redirection) ---\n262\t    dest_zone = to_zone\n263\t    if replacement_event is not None and leaving_battlefield:\n264\t        replacement_event = game.replacement_manager.apply(game, replacement_event)\n265\t        if getattr(replacement_event, \"prevented\", False):\n266\t            return\n267\t        destination_str = getattr(replacement_event, \"destination\", \"graveyard\")\n268\t        dest_zone = _DESTINATION_ZONE_MAP.get(destination_str, to_zone)\n269\t\n270\t    # --- Perform the zone move ---\n271\t    source_container.remove(card)\n272\t\n273\t    # Determine the destination player (always the owner for graveyard/exile/hand/library).\n274\t    if entering_battlefield:\n275\t        dest_player = controller if controller is not None else owner\n276\t    else:\n277\t        dest_player = owner\n278\t\n279\t    dest_player.zones[dest_zone].add(card)\n280\t\n281\t    # --- Leaving battlefield hooks ---\n282\t    if leaving_battlefield:\n283\t        card_types = getattr(card, \"card_types\", set())\n284\t        is_creature = CardType.CREATURE in card_types\n285\t\n286\t        # Fire events BEFORE unregistering (KEY_DECISIONS convention).\n287\t        game.trigger_manager.fire_event(\n288\t            game,\n289\t            LeavesBattlefieldTriggeredEvent(permanent=card, controller=controller),\n290\t        )\n291\t        if is_creature and dest_zone == Zone.GRAVEYARD:\n292\t            game.trigger_manager.fire_event(\n293\t                game,\n294\t                CreatureDiesTriggeredEvent(creature=card, controller=controller, owner=owner),\n295\t            )\n296\t\n297\t        # Now unregister triggers and replacement effects.\n298\t        game.trigger_manager.unregister(card)\n299\t        game.replacement_manager.unregister(card)\n300\t\n301\t    # --- Entering battlefield hooks ---\n302\t    if entering_battlefield:\n303\t        # Fire the ENTERS_BATTLEFIELD event *before* registering the card's\n304\t        # own triggers so that a permanent's ETB trigger does not\n305\t        # retroactively trigger off its own entry.  Other already-registered\n306\t        # triggers that watch for ENTERS_BATTLEFIELD will still fire.\n307\t        game.trigger_manager.fire_event(\n308\t            game,\n309\t            EntersBattlefieldTriggeredEvent(\n310\t                permanent=card,\n311\t                controller=controller if controller is not None else owner,\n312\t            ),\n313\t        )\n314\t        if hasattr(card, \"register_triggers\"):\n315\t            card.register_triggers(game)\n316\t        if hasattr(card, \"register_replacement_effects\"):\n317\t            card.register_replacement_effects(game)\n318\t\n319\t\n320\t# Destination string → Zone for replacement-effect zone redirection.\n321\t_DESTINATION_ZONE_MAP: dict[str, Zone] = {\n322\t    \"graveyard\": Zone.GRAVEYARD,\n323\t    \"exile\": Zone.EXILE,\n324\t    \"hand\": Zone.HAND,\n325\t    \"library\": Zone.LIBRARY,\n326\t}\n327\t"}]},"parent_tool_use_id":"toolu_014cHGGqFoHmHis5WwMogErK","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"35d8e4a1-aaca-4c8e-8984-437f281cd872","timestamp":"2026-06-01T11:19:04.112Z","subagent_type":"Reviewer","task_description":"Review sos_97 implementation"}
