{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013CQD1XHtDoGBzcFCm8wCAe","type":"tool_result","content":"1\t\"\"\"Card implementation for Ral Zarek, Guest Lecturer (SOS 97).\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import LoyaltyAbility, Planeswalker\n8\tfrom engine.types import CardType, ManaCost, Supertype, Zone\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t\n13\t\n14\tclass RalZarekGuestLecturer(Planeswalker):\n15\t    \"\"\"Ral Zarek, Guest Lecturer — {1}{B}{B} — Legendary Planeswalker — Ral.\n16\t\n17\t    Starting loyalty 3.\n18\t\n19\t    +1: Surveil 2.\n20\t    -1: Any number of target players each discard a card.\n21\t    -2: Return target creature card with mana value 3 or less from your\n22\t        graveyard to the battlefield.\n23\t    -7: Flip five coins. Target opponent skips their next X turns, where X is\n24\t        the number of coins that came up heads.\n25\t    \"\"\"\n26\t\n27\t    def __init__(self, **kwargs: Any) -> None:\n28\t        kwargs.setdefault(\"name\", \"Ral Zarek, Guest Lecturer\")\n29\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{B}{B}\"))\n30\t        kwargs.setdefault(\"starting_loyalty\", 3)\n31\t        kwargs.setdefault(\"supertypes\", set())\n32\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.LEGENDARY}\n33\t        kwargs.setdefault(\"subtypes\", set())\n34\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Ral\"}\n35\t        kwargs.setdefault(\n36\t            \"rules_text\",\n37\t            \"+1: Surveil 2.\\n\"\n38\t            \"-1: Any number of target players each discard a card.\\n\"\n39\t            \"-2: Return target creature card with mana value 3 or less from \"\n40\t            \"your graveyard to the battlefield.\\n\"\n41\t            \"-7: Flip five coins. Target opponent skips their next X turns, \"\n42\t            \"where X is the number of coins that came up heads.\",\n43\t        )\n44\t        super().__init__(**kwargs)\n45\t\n46\t    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n47\t        pw = self\n48\t\n49\t        def _plus1(game: Any) -> None:\n50\t            # Surveil 2.\n51\t            from engine.game import surveil\n52\t\n53\t            controller = pw.controller\n54\t            if controller is None:\n55\t                return\n56\t            surveil(game, controller, 2)\n57\t\n58\t        def _minus1(game: Any) -> None:\n59\t            # Any number of target players each discard a card.\n60\t            from engine.game import discard\n61\t\n62\t            targets = getattr(pw, \"_resolve_targets\", None)\n63\t            if targets is None:\n64\t                single = getattr(pw, \"_resolve_target\", None)\n65\t                targets = [single] if single is not None else []\n66\t            for player in targets:\n67\t                if player is None:\n68\t                    continue\n69\t                hand = game.get_hand(player)\n70\t                cards = hand.get_all()\n71\t                if not cards:\n72\t                    continue\n73\t                try:\n74\t                    chosen = player.choose_card(cards, \"Choose a card to discard\")\n75\t                except Exception:\n76\t                    chosen = cards[0]\n77\t                if chosen is None:\n78\t                    chosen = cards[0]\n79\t                discard(game, player, chosen)\n80\t\n81\t        def _minus2(game: Any) -> None:\n82\t            # Return target creature card with mana value 3 or less from your\n83\t            # graveyard to the battlefield.\n84\t            from engine.zones import move_to_zone\n85\t\n86\t            controller = pw.controller\n87\t            target = getattr(pw, \"_resolve_target\", None)\n88\t            if controller is None or target is None:\n89\t                return\n90\t            if CardType.CREATURE not in getattr(target, \"card_types\", set()):\n91\t                return\n92\t            if getattr(target.mana_cost, \"cmc\", 0) > 3:\n93\t                return\n94\t            graveyard = game.get_graveyard(controller)\n95\t            if not graveyard.contains(target):\n96\t                return\n97\t            move_to_zone(game, target, Zone.GRAVEYARD, Zone.BATTLEFIELD)\n98\t\n99\t        def _minus7(game: Any) -> None:\n100\t            # Flip five coins. Target opponent skips their next X turns, where\n101\t            # X is the number of coins that came up heads.\n102\t            from engine.game import flip_coin, skip_turns\n103\t\n104\t            target = getattr(pw, \"_resolve_target\", None)\n105\t            if target is None:\n106\t                return\n107\t            heads = sum(1 for _ in range(5) if flip_coin())\n108\t            skip_turns(game, target, heads)\n109\t\n110\t        return [\n111\t            LoyaltyAbility(\n112\t                loyalty_cost=+1,\n113\t                effect=_plus1,\n114\t                description=\"+1: Surveil 2.\",\n115\t            ),\n116\t            LoyaltyAbility(\n117\t                loyalty_cost=-1,\n118\t                effect=_minus1,\n119\t                description=\"-1: Any number of target players each discard a card.\",\n120\t            ),\n121\t            LoyaltyAbility(\n122\t                loyalty_cost=-2,\n123\t                effect=_minus2,\n124\t                description=\"-2: Return target creature card with mana value 3 \"\n125\t                \"or less from your graveyard to the battlefield.\",\n126\t            ),\n127\t            LoyaltyAbility(\n128\t                loyalty_cost=-7,\n129\t                effect=_minus7,\n130\t                description=\"-7: Flip five coins. Target opponent skips their \"\n131\t                \"next X turns, where X is the number of heads.\",\n132\t            ),\n133\t        ]\n134\t"}]},"parent_to