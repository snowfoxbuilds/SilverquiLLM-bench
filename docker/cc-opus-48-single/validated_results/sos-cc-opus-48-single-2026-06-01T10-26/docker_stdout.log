{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ph1trfyqwAn4JHa4VL2Uqu","type":"tool_result","content":"1\t\"\"\"Card implementation for Great Hall of the Biblioplex (SOS 257).\n2\t\n3\tGreat Hall of the Biblioplex is a colorless Land with three abilities:\n4\t\n5\t  {T}: Add {C}.\n6\t  {T}, Pay 1 life: Add one mana of any color. Spend this mana only to cast\n7\t      an instant or sorcery spell.\n8\t  {5}: If this land isn't a creature, it becomes a 2/4 Wizard creature with\n9\t      \"Whenever you cast an instant or sorcery spell, this creature gets\n10\t      +1/+0 until end of turn.\" It's still a land.\n11\t\n12\tAnimation is modelled with the continuous-effect layer system:\n13\t  * Layer 4 (TYPE): add CREATURE to ``card_types`` (LAND is retained) and add\n14\t    the \"Wizard\" subtype.\n15\t  * Layer 7b (SET_PT): set ``modified_power``/``modified_toughness`` to 2/4.\n16\t\n17\tThe granted \"Whenever you cast an instant or sorcery spell, this creature gets\n18\t+1/+0 until end of turn\" trigger is registered through the spell-cast trigger\n19\tmachinery (``SpellCastTriggeredEvent``, now fired by ``engine.casting.cast_spell``).\n20\tIt is controller-scoped and only fires while the permanent is actually a\n21\tcreature (CREATURE in ``card_types``); each qualifying instant/sorcery the\n22\tcontroller casts registers a Layer 7c +1/+0 ``DURATION_END_OF_TURN`` continuous\n23\teffect, so the animated creature's POWER increases by 1 per cast and resets at\n24\tend of turn (the cleanup step sweeps the until-end-of-turn effects).\n25\t\"\"\"\n26\t\n27\tfrom __future__ import annotations\n28\t\n29\tfrom typing import TYPE_CHECKING, Any\n30\t\n31\tfrom engine.card import ActivatedAbility, Land, ManaAbility\n32\tfrom engine.continuous_effects import (\n33\t    ContinuousEffect,\n34\t    DURATION_END_OF_TURN,\n35\t    DURATION_PERMANENT,\n36\t    Layer,\n37\t    SubLayer,\n38\t)\n39\tfrom engine.types import CardType, ManaCost, ManaType\n40\t\n41\tif TYPE_CHECKING:\n42\t    from engine.game_state import GameState\n43\t\n44\t\n45\tdef _is_on_battlefield(game: Any, obj: Any) -> bool:\n46\t    \"\"\"Return ``True`` if *obj* is on any player's battlefield.\"\"\"\n47\t    for player in game.players:\n48\t        if game.get_battlefield(player).contains(obj):\n49\t            return True\n50\t    return False\n51\t\n52\t\n53\t# The five colors a player may produce with the any-color ability.\n54\t_COLOR_OPTIONS = [\n55\t    ManaType.WHITE,\n56\t    ManaType.BLUE,\n57\t    ManaType.BLACK,\n58\t    ManaType.RED,\n59\t    ManaType.GREEN,\n60\t]\n61\t\n62\t\n63\tclass GreatHallOfTheBiblioplex(Land):\n64\t    \"\"\"Great Hall of the Biblioplex — Land.\n65\t\n66\t    SOS collector number 257.\n67\t    \"\"\"\n68\t\n69\t    def __init__(self, **kwargs: Any) -> None:\n70\t        kwargs.setdefault(\"name\", \"Great Hall of the Biblioplex\")\n71\t        kwargs.setdefault(\n72\t            \"rules_text\",\n73\t            \"{T}: Add {C}.\\n\"\n74\t            \"{T}, Pay 1 life: Add one mana of any color. Spend this mana only \"\n75\t            \"to cast an instant or sorcery spell.\\n\"\n76\t            \"{5}: If this land isn't a creature, it becomes a 2/4 Wizard \"\n77\t            'creature with \"Whenever you cast an instant or sorcery spell, '\n78\t            'this creature gets +1/+0 until end of turn.\" It\\'s still a land.',\n79\t        )\n80\t        super().__init__(**kwargs)\n81\t        # Creature characteristics granted only while animated.  Lands have no\n82\t        # P/T by default; these mirror the Creature surface so the test (and\n83\t        # combat) can read ``card.power`` / ``card.toughness`` once animated.\n84\t        self.base_power: int = 0\n85\t        self.base_toughness: int = 0\n86\t        self.modified_power: int = 0\n87\t        self.modified_toughness: int = 0\n88\t        self.summoning_sick: bool = True\n89\t        # Snapshot the printed (non-creature) subtypes for reset.\n90\t        self._original_subtypes: frozenset[str] = frozenset(self.subtypes)\n91\t        # Reference to the permanent animation effects so re-activation is a\n92\t        # no-op (the \"If this land isn't a creature\" guard).\n93\t        self._animation_effects: list[Any] = []\n94\t        self._cast_trigger_registered: bool = False\n95\t\n96\t    # ------------------------------------------------------------------\n97\t    # Power / toughness surface (only meaningful while animated)\n98\t    # ------------------------------------------------------------------\n99\t    @property\n100\t    def power(self) -> int:\n101\t        \"\"\"Current power (0 unless animated; continuous effects set it).\"\"\"\n102\t        return self.modified_power\n103\t\n104\t    @property\n105\t    def toughness(self) -> int:\n106\t        \"\"\"Current toughness (0 unless animated; continuous effects set it).\"\"\"\n107\t        return self.modified_toughness\n108\t\n109\t    def _reset_characteristics(self) -> None:\n110\t        \"\"\"Reset to printed (non-creature) characteristics before reapply.\n111\t\n112\t        ``Land._reset_characteristics`` only resets ``card_types`` and\n113\t        ``keywords``; the animation also touches ``subtypes`` and P/T, so we\n114\t        reset those here so ``EffectManager.apply_all`` stays idempotent.\n115\t        \"\"\"\n116\t        super()._reset_characteristics()\n117\t        self.subtypes = set(self._original_subtypes)\n118\t        self.modified_power = self.base_power\n119\t        self.modified_toughness = self.base_toughness\n120\t\n121\t    # ------------------------------------------------------------------\n122\t    # Mana abilities\n123\t    # ------------------------------------------------------------------\n124\t    def get_mana_abilities(self) -> list[ManaAbility]:\n125\t        source = self\n126\t\n127\t        def _tap_cost(game: Any, src: Any) -> bool:\n128\t            if getattr(src, \"is_tapped\", False):\n129\t                return False\n130\t            src.is_tapped = True\n131\t            return True\n132\t\n133\t        def _tap_pay_life_cost(game: Any, src: Any) -> bool:\n134\t            # A tapped source cannot pay the tap cost; do NOT drain life on a\n135\t            # failed activation.\n136\t            if getattr(src, \"is_tapped\", False):\n137\t                return False\n138\t            controller = src.controller\n139\t            if controller is None:\n140\t                return False\n141\t            src.is_tapped = True\n142\t            controller.life -= 1\n143\t            return True\n144\t\n145\t        def _colorless_effect(game: Any) -> None:\n146\t            controller = source.controller\n147\t            if controller is not None:\n148\t                controller.mana_pool.add(ManaType.COLORLESS, 1)\n149\t\n150\t        def _any_color_effect(game: Any) -> None:\n151\t            # UNVERIFIED: \"spend this mana only to cast an instant or sorcery spell\" — engine has no mana spend-restriction surface (matches FDN 267 Secluded Courtyard limitation).\n152\t            controller = source.controller\n153\t            if controller is None:\n154\t                return\n155\t            chosen = controller.choose(\n156\t                list(_COLOR_OPTIONS),\n157\t                \"Choose a color of mana to produce\",\n158\t            )\n159\t            controller.mana_pool.add(chosen, 1)\n160\t\n161\t        return [\n162\t            ManaAbility(\n163\t                cost=_tap_cost,\n164\t                mana_produced=_colorless_effect,\n165\t                description=\"{T}: Add {C}.\",\n166\t            ),\n167\t            ManaAbility(\n168\t                cost=_tap_pay_life_cost,\n169\t                mana_produced=_any_color_effect,\n170\t                description=\"{T}, Pay 1 life: Add one mana of any color.\",\n171\t            ),\n172\t        ]\n173\t\n174\t    # ------------------------------------------------------------------\n175\t    # {5}: animation activated ability\n176\t    # ------------------------------------------------------------------\n177\t    def get_activated_abilities(self) -> list[ActivatedAbility]:\n178\t        source = self\n179\t\n180\t        def _cost(game: Any, src: Any) -> bool:\n181\t            controller = src.controller\n182\t            if controller is None:\n183\t                return False\n184\t            return controller.mana_pool.pay(ManaCost(generic=5))\n185\t\n186\t        def _effect(game: Any) -> None:\n187\t            source._animate(game)\n188\t\n189\t        return [\n190\t            ActivatedAbility(\n191\t                cost=_cost,\n192\t                effect=_effect,\n193\t                description=(\n194\t                    \"{5}: If this land isn't a creature, it becomes a 2/4 \"\n195\t                    \"Wizard creature. It's still a land.\"\n196\t                ),\n197\t            ),\n198\t        ]\n199\t\n200\t    # ------------------------------------------------------------------\n201\t    # Animation\n202\t    # ------------------------------------------------------------------\n203\t    def _animate(self, game: GameState) -> None:\n204\t        \"\"\"Become a 2/4 Wizard creature (still a land), guarding re-animation.\n205\t\n206\t        \"If this land isn't a creature, it becomes ...\" — if it is already a\n207\t        creature (animation effects already registered), this is a no-op so the\n208\t        P/T does not stack.\n209\t        \"\"\"\n210\t        if CardType.CREATURE in self.card_types or self._animation_effects:\n211\t            return\n212\t\n213\t        card = self\n214\t\n215\t        def _apply_type(game: GameState) -> None:\n216\t            if not _is_on_battlefield(game, card):\n217\t                return\n218\t            card.card_types = set(card.card_types) | {CardType.CREATURE}\n219\t            card.subtypes = set(card.subtypes) | {\"Wizard\"}\n220\t\n221\t        def _apply_pt(game: GameState) -> None:\n222\t            if not _is_on_battlefield(game, card):\n223\t                return\n224\t            if CardType.CREATURE not in card.card_types:\n225\t                return\n226\t            card.modified_power = 2\n227\t            card.modified_toughness = 4\n228\t\n229\t        type_effect = ContinuousEffect(\n230\t            source=self,\n231\t            layer=Layer.TYPE,\n232\t            sublayer=None,\n233\t            apply=_apply_type,\n234\t            duration=DURATION_PERMANENT,\n235\t        )\n236\t        pt_effect = ContinuousEffect(\n237\t            source=self,\n238\t            layer=Layer.POWER_TOUGHNESS,\n239\t            sublayer=SubLayer.SET_PT,\n240\t            apply=_apply_pt,\n241\t            duration=DURATION_PERMANENT,\n242\t        )\n243\t        self._animation_effects = [\n244\t            game.effect_manager.add(type_effect),\n245\t            game.effect_manager.add(pt_effect),\n246\t        ]\n247\t        # Apply immediately so the type is live before any further queries.\n248\t        game.effect_manager.apply_all(game)\n249\t        # Ensure the granted cast trigger is registered (once).\n250\t        self._register_cast_trigger(game)\n251\t\n252\t    # ------------------------------------------------------------------\n253\t    # Granted \"whenever you cast an instant or sorcery spell\" trigger\n254\t    # ------------------------------------------------------------------\n255\t    def register_triggers(self, game: GameState) -> None:\n256\t        # Register up-front so animation that happens after the permanent is\n257\t        # already tracked still benefits; the condition gates on being a\n258\t        # creature, so it is inert until animated.\n259\t        self._register_cast_trigger(game)\n260\t\n261\t    def _register_cast_trigger(self, game: GameState) -> None:\n262\t        if self._cast_trigger_registered:\n263\t            return\n264\t        trigger_manager = getattr(game, \"trigger_manager\", None)\n265\t        if trigger_manager is None:\n266\t            return\n267\t        from engine.events import SpellCastTriggeredEvent\n268\t        from engine.triggers import TriggerRegistration\n269\t\n270\t        source = self\n271\t\n272\t        def _condition(game: Any, event: Any) -> bool:\n273\t            # Only while animated (a creature) and on the battlefield.\n274\t            if CardType.CREATURE not in source.card_types:\n275\t                return False\n276\t            if not _is_on_battlefield(game, source):\n277\t                return False\n278\t            controller = source.controller\n279\t            if controller is None:\n280\t                return False\n281\t            spell = getattr(event, \"spell\", None) or getattr(event, \"card\", None)\n282\t            if spell is None:\n283\t                return False\n284\t            # Only the controller's own instant/sorcery spells.\n285\t            caster = getattr(event, \"controller\", None) or getattr(event, \"player\", None)\n286\t            spell_controller = getattr(spell, \"controller\", None)\n287\t            if caster is not controller and spell_controller is not controller:\n288\t                return False\n289\t            card_types = getattr(spell, \"card_types\", set())\n290\t            return bool(card_types & {CardType.INSTANT, CardType.SORCERY})\n291\t\n292\t        def _effect(game: GameState) -> None:\n293\t            source._pump_until_end_of_turn(game)\n294\t\n295\t        controller = getattr(self, \"controller\", None) or game.active_player\n296\t        trigger_manager.register(\n297\t            TriggerRegistration(\n298\t                event_type=SpellCastTriggeredEvent,\n299\t                condition=_condition,\n300\t                effect=_effect,\n301\t                source=self,\n302\t                controller=controller,\n303\t            )\n304\t        )\n305\t        self._cast_trigger_registered = True\n306\t\n307\t    def _pump_until_end_of_turn(self, game: GameState) -> None:\n308\t        \"\"\"Give this creature +1/+0 until end of turn (per qualifying cast).\"\"\"\n309\t        card = self\n310\t\n311\t        def _apply_pump(game: GameState) -> None:\n312\t            if not _is_on_battlefield(game, card):\n313\t                return\n314\t            if CardType.CREATURE not in card.card_types:\n315\t                return\n316\t            card.modified_power += 1\n317\t\n318\t        pump = ContinuousEffect(\n319\t            source=self,\n320\t            layer=Layer.POWER_TOUGHNESS,\n321\t            sublayer=SubLayer.MODIFY_PT,\n322\t            apply=_apply_pump,\n323\t            duration=DURATION_END_OF_TURN,\n324\t        )\n325\t        game.effect_manager.add(pump)\n326\t        game.effect_manager.apply_all(game)\n327\t"}]},"parent_tool_use_id":"toolu_01YLHhg3L6wmRAMxiCoeYbvX","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"167cfc4e-83e3-4680-bb48-75073cd8bb57","timestamp":"2026-06-01T12:18:12.055Z","subagent_type":"Tester","task_description":"Extend tests for sos_257"}
