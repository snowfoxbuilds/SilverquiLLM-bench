{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01TUJnBKmh5943qjCQcRCK1r","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01W1DSCGFsDNaeRfiAn3DuP2","name":"Read","input":{"file_path":"/workspace/engine/casting.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10745,"cache_read_input_tokens":25283,"cache_creation":{"ephemeral_5m_input_tokens":10745,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_012rXFMpMiUxgBU3maGZJedn","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"b2cc524b-cca1-4dfc-ae15-3bbc0d5fec7c","request_id":"req_011CbcTK32Sg6aPtZryECsDS","subagent_type":"Tester","task_description":"Write tests for sos_120"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W1DSCGFsDNaeRfiAn3DuP2","type":"tool_result","content":"1\t\"\"\"Casting and resolution pipeline for spells and lands.\n2\t\n3\tProvides the full flow from casting a spell or playing a land through\n4\tresolution:\n5\t\n6\t- :func:`cast_spell` — verify timing & legality → move hand to stack →\n7\t  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n8\t- :func:`play_land` — verify land play remaining → move hand to\n9\t  battlefield → decrement ``land_plays_remaining``.\n10\t- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n11\t  helpers used by the casting pipeline.\n12\t\n13\tResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\n14\tcreated by :func:`cast_spell`:\n15\t\n16\t- Call ``card.on_resolve(game)``.\n17\t- Permanents (creature / enchantment / artifact / planeswalker) move from\n18\t  the stack to the battlefield.\n19\t- Non-permanents (instant / sorcery) move to the graveyard.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import TYPE_CHECKING, Any\n25\t\n26\tfrom engine.card import CardImpl\n27\tfrom engine.stack import StackObject\n28\tfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\n29\tfrom engine.zones import move_zone\n30\t\n31\tif TYPE_CHECKING:\n32\t    from engine.game_state import GameState\n33\t    from engine.player import Player\n34\t\n35\t\n36\t# Card types that represent permanents — these go to the battlefield on resolve.\n37\t_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n38\t    CardType.CREATURE,\n39\t    CardType.ENCHANTMENT,\n40\t    CardType.ARTIFACT,\n41\t    CardType.PLANESWALKER,\n42\t})\n43\t\n44\t\n45\tclass CastingError(Exception):\n46\t    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n47\t\n48\t\n49\t# ------------------------------------------------------------------\n50\t# Timing helpers\n51\t# ------------------------------------------------------------------\n52\t\n53\tdef is_sorcery_speed(game: GameState, player: Player) -> bool:\n54\t    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n55\t\n56\t    Sorcery speed requires all of:\n57\t\n58\t    * *player* is the active player.\n59\t    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n60\t      ``POSTCOMBAT_MAIN``).\n61\t    * The stack is empty.\n62\t    \"\"\"\n63\t    if player is not game.active_player:\n64\t        return False\n65\t    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n66\t        return False\n67\t    if not game.stack.is_empty():\n68\t        return False\n69\t    return True\n70\t\n71\t\n72\tdef can_cast_at_instant_speed(card: CardImpl) -> bool:\n73\t    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n74\t\n75\t    A card has instant-speed timing if it is an instant or has the\n76\t    :attr:`~engine.types.Keyword.FLASH` keyword.\n77\t    \"\"\"\n78\t    if CardType.INSTANT in card.card_types:\n79\t        return True\n80\t    if Keyword.FLASH & card.keywords:\n81\t        return True\n82\t    return False\n83\t\n84\t\n85\t# ------------------------------------------------------------------\n86\t# Cost reduction\n87\t# ------------------------------------------------------------------\n88\t\n89\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n90\t    \"\"\"Return the generic mana reduction for casting *card*.\n91\t\n92\t    Queries ``card.cost_reduction(game)`` and clamps the result so that\n93\t    the generic portion of the mana cost cannot go below 0.\n94\t\n95\t    This is a simplified single-card self-reduction model.  Full MTG\n96\t    cost-reduction interactions (Trinisphere, multiple reductions from\n97\t    different sources) are deferred.\n98\t    \"\"\"\n99\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n100\t    # casting player even when the card was never explicitly assigned one.\n101\t    prev_controller = card.controller\n102\t    card.controller = controller\n103\t    raw = card.cost_reduction(game)\n104\t    # Restore previous controller in case the caller doesn't want a\n105\t    # side-effect (get_cost_reduction is a query, not a mutation).\n106\t    card.controller = prev_controller\n107\t    generic = card.mana_cost.generic if card.mana_cost else 0\n108\t    return max(0, min(raw, generic))\n109\t\n110\t\n111\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n112\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n113\t    new_generic = max(0, cost.generic - reduction)\n114\t    return ManaCost(\n115\t        generic=new_generic,\n116\t        pips=dict(cost.pips),\n117\t        x_count=cost.x_count,\n118\t        hybrid=list(cost.hybrid),\n119\t    )\n120\t\n121\t\n122\t# ------------------------------------------------------------------\n123\t# Cast spell\n124\t# ------------------------------------------------------------------\n125\t\n126\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n127\t    \"\"\"Cast *card* from *player*'s hand.\n128\t\n129\t    Pipeline\n130\t    --------\n131\t    1. **Timing check** — instants (and cards with flash) can be cast\n132\t       whenever the player has priority; everything else requires\n133\t       sorcery-speed timing.\n134\t    2. **can_cast** — ask the card whether it can legally be cast.\n135\t    3. **Hand check** — the card must be in the player's hand.\n136\t    4. **Move hand → stack zone** — remove the card from the hand and\n137\t       place it into the player's stack zone.\n138\t    5. **Choose targets** — if the card specifies targets (via\n139\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n140\t    6. **Mana check / payment** — the player's mana pool must be able to\n141\t       pay the card's mana cost.  If payment fails, the card is rolled\n142\t       back from the stack zone to the hand.\n143\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n144\t    8. **Push StackObject** — push a :class:`StackObject` whose\n145\t       ``on_resolve`` callback handles resolution.\n146\t\n147\t    Raises:\n148\t        CastingError: If any legality check fails.\n149\t    \"\"\"\n150\t    # 1. Timing\n151\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n152\t        raise CastingError(\n153\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n154\t        )\n155\t\n156\t    # 2. can_cast\n157\t    if not card.can_cast(game):\n158\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n159\t\n160\t    # 3. Hand check\n161\t    hand = game.get_hand(player)\n162\t    if not hand.contains(card):\n163\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n164\t\n165\t    # 4. Move card from hand to stack zone\n166\t    stack_zone = player.zones[Zone.STACK]\n167\t    hand.remove(card)\n168\t    stack_zone.add(card)\n169\t\n170\t    # Clear any stale colors_spent from a prior cast before new payment.\n171\t    if hasattr(card, \"colors_spent\"):\n172\t        del card.colors_spent\n173\t\n174\t    # 5. Choose targets\n175\t    target_specs = card.get_targets(game)\n176\t    chosen_targets: list[Any] = []\n177\t    if target_specs:\n178\t        for spec in target_specs:\n179\t            target = player.choose_target(target_specs, spec)\n180\t            # Validate against filter_fn if the spec provides one\n181\t            filter_fn = getattr(spec, \"filter_fn\", None)\n182\t            if filter_fn is not None and target is not None:\n183\t                if not filter_fn(target):\n184\t                    stack_zone.remove(card)\n185\t                    hand.add(card)\n186\t                    raise CastingError(\n187\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n188\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n189\t                    )\n190\t            chosen_targets.append(target)\n191\t\n192\t    # 5b. Protection check — reject targets that have protection from this\n193\t    #     spell (the T in DEBT).\n194\t    from engine.protection import has_protection_from\n195\t\n196\t    for target in chosen_targets:\n197\t        if has_protection_from(target, card):\n198\t            # Rollback: move card from stack zone back to hand\n199\t            stack_zone.remove(card)\n200\t            hand.add(card)\n201\t            raise CastingError(\n202\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n203\t            )\n204\t\n205\t    # Targets are stored on the StackObject (not the card) and passed\n206\t    # through the resolve pipeline via on_resolve(game, targets=...).\n207\t\n208\t    # 6. Mana check / payment (rollback on failure)\n209\t    # Ensure the card knows its controller so that cost_reduction() hooks\n210\t    # (e.g. Embercleave counting attacking creatures you control) see the\n211\t    # casting player, even for cards that were added to hand without an\n212\t    # explicit controller assignment.\n213\t    if card.controller is None:\n214\t        card.controller = player\n215\t    reduction = get_cost_reduction(game, card, player)\n216\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n217\t\n218\t    if not player.mana_pool.can_pay(effective_cost):\n219\t        # Rollback: move card from stack zone back to hand\n220\t        stack_zone.remove(card)\n221\t        hand.add(card)\n222\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n223\t\n224\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n225\t    player.mana_pool.pay(effective_cost)\n226\t\n227\t    # Store colors of mana spent on the card for mechanics like Converge\n228\t    # that care about the colors used to cast the spell.\n229\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n230\t\n231\t    # Record the TOTAL amount of mana spent to cast this spell (rule 107.7).\n232\t    # Unlike the printed mana value, this reflects actual mana paid, so X\n233\t    # spells / cost-reduced spells diverge from CMC.  Effects such as Mana\n234\t    # Sculpt read this at resolution.\n235\t    card.mana_spent = player.mana_pool.last_payment_total  # type: ignore[attr-defined]\n236\t\n237\t    # 7. Call on_cast hook\n238\t    card.on_cast(game)\n239\t\n240\t    # 8. Build on_resolve callback and push StackObject\n241\t    stack_obj = StackObject(\n242\t        source=card,\n243\t        controller=player,\n244\t        targets=chosen_targets,\n245\t        on_resolve=lambda g: None,  # replaced below\n246\t    )\n247\t\n248\t    def _on_resolve(g: GameState) -> None:\n249\t        _resolve_spell(g, card, player, stack_obj)\n250\t\n251\t    stack_obj.on_resolve = _on_resolve\n252\t    game.stack.push(stack_obj)\n253\t\n254\t\n255\t# ------------------------------------------------------------------\n256\t# Cast spell without paying mana cost (free-cast from any zone)\n257\t# ------------------------------------------------------------------\n258\t\n259\t\n260\tdef cast_spell_free(\n261\t    game: GameState,\n262\t    player: Player,\n263\t    card: CardImpl,\n264\t    from_zone: Zone,\n265\t) -> None:\n266\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n267\t\n268\t    This is used by effects that allow casting from zones other than hand\n269\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n270\t    or cascade.\n271\t\n272\t    Pipeline\n273\t    --------\n274\t    1. **can_cast** — ask the card whether it can legally be cast (same\n275\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n276\t    2. Move *card* from *from_zone* to the stack zone.\n277\t    3. Choose targets (if applicable) with validation and protection check.\n278\t    4. Call ``on_cast`` hook.\n279\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n280\t       resolution normally (permanents → battlefield, non-permanents →\n281\t       graveyard).\n282\t\n283\t    No timing check or mana payment is performed.  The spell goes on the\n284\t    stack and can be responded to normally (e.g. countered).\n285\t\n286\t    If targeting or other post-move checks fail, the card is rolled back\n287\t    to its source zone.\n288\t\n289\t    Parameters:\n290\t        game: The current game state.\n291\t        player: The player casting the spell.\n292\t        card: The card to cast.\n293\t        from_zone: The zone the card is currently in.\n294\t\n295\t    Raises:\n296\t        CastingError: If the card cannot be found in *from_zone* or\n297\t            legality checks fail.\n298\t    \"\"\"\n299\t    from engine.zones import move_to_zone\n300\t\n301\t    # Ensure controller is set\n302\t    card.controller = player\n303\t    if card.owner is None:\n304\t        card.owner = player\n305\t\n306\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n307\t    if not card.can_cast(game):\n308\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n309\t\n310\t    # 2. Locate card in source zone\n311\t    source_zone_container = player.zones[from_zone]\n312\t    if not source_zone_container.contains(card):\n313\t        # Try to find the card in any player's zone\n314\t        source_zone_container = None\n315\t        for p in game.players:\n316\t            z = p.zones[from_zone]\n317\t            if z.contains(card):\n318\t                source_zone_container = z\n319\t                break\n320\t\n321\t    if source_zone_container is None or not source_zone_container.contains(card):\n322\t        raise CastingError(\n323\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n324\t        )\n325\t\n326\t    # Move card from source zone to stack zone\n327\t    stack_zone = player.zones[Zone.STACK]\n328\t    source_zone_container.remove(card)\n329\t    stack_zone.add(card)\n330\t\n331\t    # 3. Choose targets (with rollback on failure)\n332\t    try:\n333\t        target_specs = card.get_targets(game)\n334\t        chosen_targets: list[Any] = []\n335\t        if target_specs:\n336\t            for spec in target_specs:\n337\t                target = player.choose_target(target_specs, spec)\n338\t                # Validate against filter_fn if the spec provides one\n339\t                filter_fn = getattr(spec, \"filter_fn\", None)\n340\t                if filter_fn is not None and target is not None:\n341\t                    if not filter_fn(target):\n342\t                        raise CastingError(\n343\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n344\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n345\t                        )\n346\t                chosen_targets.append(target)\n347\t\n348\t        # Protection check — reject targets that have protection from this spell\n349\t        from engine.protection import has_protection_from\n350\t\n351\t        for target in chosen_targets:\n352\t            if has_protection_from(target, card):\n353\t                raise CastingError(\n354\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n355\t                )\n356\t    except Exception as exc:\n357\t        # Rollback: move card from stack zone back to source zone\n358\t        stack_zone.remove(card)\n359\t        source_zone_container.add(card)\n360\t        raise CastingError(str(exc)) from exc\n361\t\n362\t    # 4. Call on_cast hook\n363\t    card.on_cast(game)\n364\t\n365\t    # 5. Build on_resolve callback and push StackObject\n366\t    stack_obj = StackObject(\n367\t        source=card,\n368\t        controller=player,\n369\t        targets=chosen_targets,\n370\t        on_resolve=lambda g: None,  # replaced below\n371\t    )\n372\t\n373\t    def _on_resolve(g: GameState) -> None:\n374\t        _resolve_spell(g, card, player, stack_obj)\n375\t\n376\t    stack_obj.on_resolve = _on_resolve\n377\t    game.stack.push(stack_obj)\n378\t\n379\t\n380\t# ------------------------------------------------------------------\n381\t# Resolution (called when the stack pops)\n382\t# ------------------------------------------------------------------\n383\t\n384\tdef _resolve_spell(\n385\t    game: GameState,\n386\t    card: CardImpl,\n387\t    player: Player,\n388\t    stack_obj: StackObject,\n389\t) -> None:\n390\t    \"\"\"Resolve *card* cast by *player*.\n391\t\n392\t    1. Call ``card.on_resolve(game, targets=targets)``.\n393\t    2. Remove the card from the stack zone.\n394\t    3. If the card is a permanent type, move it to the battlefield via\n395\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n396\t       registration and the ETB event).\n397\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n398\t    \"\"\"\n399\t    from engine.zones import move_to_zone\n400\t\n401\t    # Read targets from the StackObject — the single source of truth.\n402\t    # Set chosen_targets on the card just before resolution so that\n403\t    # _get_chosen_target helpers (which read via getattr) work.\n404\t    targets = stack_obj.targets\n405\t    if targets is not None:\n406\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n407\t\n408\t    card.on_resolve(game)\n409\t\n410\t    if card.card_types & _PERMANENT_TYPES:\n411\t        # Move from stack to battlefield via move_to_zone, which handles\n412\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n413\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n414\t    else:\n415\t        # Instant/sorcery: the spell would be put into its owner's graveyard.\n416\t        # Consult replacement effects so that effects such as \"if that spell\n417\t        # would be put into your graveyard, exile it instead\" can redirect\n418\t        # the destination zone.\n419\t        dest_zone = _resolve_spell_graveyard_destination(game, card)\n420\t        move_to_zone(game, card, Zone.STACK, dest_zone)\n421\t        # Clean up any spell-specific exile replacement / flag now that the\n422\t        # spell has left the stack.\n423\t        game.replacement_manager.unregister(card)\n424\t        if hasattr(card, \"_exile_if_goes_to_graveyard\"):\n425\t            del card._exile_if_goes_to_graveyard\n426\t\n427\t\n428\t# Destination string → Zone for spell graveyard-replacement redirection.\n429\t_SPELL_DESTINATION_ZONE_MAP: dict[str, Zone] = {\n430\t    \"graveyard\": Zone.GRAVEYARD,\n431\t    \"exile\": Zone.EXILE,\n432\t    \"hand\": Zone.HAND,\n433\t    \"library\": Zone.LIBRARY,\n434\t}\n435\t\n436\t\n437\tdef _resolve_spell_graveyard_destination(game: GameState, card: CardImpl) -> Zone:\n438\t    \"\"\"Return the zone an instant/sorcery should move to on resolution.\n439\t\n440\t    Builds a :class:`~engine.events.SpellToGraveyardReplacementEvent` and runs\n441\t    it through the replacement manager so replacement effects can redirect the\n442\t    spell (e.g. exile instead of graveyard).  Defaults to the graveyard.\n443\t    \"\"\"\n444\t    from engine.events import SpellToGraveyardReplacementEvent\n445\t\n446\t    controller = getattr(card, \"controller\", None)\n447\t    owner = getattr(card, \"owner\", None) or controller\n448\t    event = SpellToGraveyardReplacementEvent(\n449\t        destination=\"graveyard\",\n450\t        controller=controller,\n451\t        owner=owner,\n452\t        spell=card,\n453\t    )\n454\t    event = game.replacement_manager.apply(game, event)\n455\t    destination_str = getattr(event, \"destination\", \"graveyard\")\n456\t    return _SPELL_DESTINATION_ZONE_MAP.get(destination_str, Zone.GRAVEYARD)\n457\t\n458\t\n459\t# ------------------------------------------------------------------\n460\t# Play land (special action — does not use the stack)\n461\t# ------------------------------------------------------------------\n462\t\n463\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n464\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n465\t\n466\t    Requirements (all must hold):\n467\t\n468\t    * *land_card* has :attr:`CardType.LAND`.\n469\t    * *player* is the active player.\n470\t    * Current phase is a main phase.\n471\t    * The stack is empty.\n472\t    * ``player.land_plays_remaining > 0``.\n473\t    * The card is in the player's hand.\n474\t\n475\t    On success the card moves from hand to battlefield and\n476\t    ``land_plays_remaining`` is decremented.\n477\t\n478\t    Raises:\n479\t        CastingError: If any requirement is not met.\n480\t    \"\"\"\n481\t    # Must be a land\n482\t    if CardType.LAND not in land_card.card_types:\n483\t        raise CastingError(\n484\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n485\t        )\n486\t\n487\t    # Sorcery-speed timing (active player, main phase, stack empty)\n488\t    if not is_sorcery_speed(game, player):\n489\t        raise CastingError(\n490\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n491\t            \"during main phase with empty stack\"\n492\t        )\n493\t\n494\t    # Land plays remaining\n495\t    if player.land_plays_remaining <= 0:\n496\t        raise CastingError(\n497\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n498\t        )\n499\t\n500\t    # Card must be in hand\n501\t    hand = game.get_hand(player)\n502\t    if not hand.contains(land_card):\n503\t        raise CastingError(\n504\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n505\t        )\n506\t\n507\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n508\t    if land_card.owner is None:\n509\t        land_card.owner = player\n510\t    land_card.controller = player\n511\t\n512\t    # Move from hand to battlefield via move_to_zone, which fires\n513\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n514\t    from engine.zones import move_to_zone\n515\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n516\t\n517\t    # Decrement land plays\n518\t    player.land_plays_remaining -= 1\n519\t\n520\t\n521\tdef cast_prepared_spell(\n522\t    game: GameState,\n523\t    permanent: Any,\n524\t    targets: list[Any] | None = None,\n525\t) -> StackObject | None:\n526\t    \"\"\"Cast a copy of *permanent*'s prepare spell while it is prepared.\n527\t\n528\t    This implements the SOS **Prepared** mechanic\n529\t    (rules text: \"While it's prepared, you may cast a copy of its spell.\n530\t    Doing so unprepares it.\").\n531\t\n532\t    A prepared permanent exposes:\n533\t\n534\t    * a truthy ``is_prepared`` flag, and\n535\t    * a ``prepare_spell`` attribute — a :class:`~engine.card.CardImpl` (the\n536\t      inset spell, e.g. Swords to Plowshares).\n537\t\n538\t    This helper creates a *copy* of that prepare spell, places it in the\n539\t    controller's exile zone, casts it for free (no mana cost) onto the stack,\n540\t    and clears the permanent's prepared designation. The returned\n541\t    :class:`StackObject` can be resolved to apply the prepare spell's effect.\n542\t\n543\t    Parameters:\n544\t        game: The current game state.\n545\t        permanent: The prepared permanent (must have ``is_prepared`` truthy\n546\t            and a ``prepare_spell``).\n547\t        targets: Optional explicit targets for the copy. If provided, they\n548\t            are scripted into the controller's choices so the copy resolves\n549\t            against them.\n550\t\n551\t    Returns:\n552\t        The :class:`StackObject` for the prepare-spell copy, or ``None`` if\n553\t        *permanent* is not prepared / exposes no prepare spell.\n554\t    \"\"\"\n555\t    import copy as _copy\n556\t\n557\t    if not getattr(permanent, \"is_prepared\", False):\n558\t        return None\n559\t    prepare_spell = getattr(permanent, \"prepare_spell\", None)\n560\t    if prepare_spell is None:\n561\t        return None\n562\t\n563\t    controller = getattr(permanent, \"controller\", None) or game.active_player\n564\t\n565\t    # Build a fresh copy of the prepare spell so the original face stays put.\n566\t    spell_copy = _copy.copy(prepare_spell)\n567\t    # Give the copy a unique identity & clean target state.\n568\t    from engine.card import GameObject as _GameObject\n569\t\n570\t    spell_copy.object_id = _GameObject._next_id\n571\t    _GameObject._next_id += 1\n572\t    spell_copy.controller = controller\n573\t    spell_copy.owner = controller\n574\t    if hasattr(spell_copy, \"chosen_targets\"):\n575\t        spell_copy.chosen_targets = []\n576\t\n577\t    # Casting unprepares the permanent (rule text: \"Doing so unprepares it.\").\n578\t    permanent.is_prepared = False\n579\t\n580\t    # Place the copy in exile so it is cast \"from exile\" like a real copy.\n581\t    exile_zone = controller.zones[Zone.EXILE]\n582\t    exile_zone.add(spell_copy)\n583\t\n584\t    stack_before = len(game.stack)\n585\t\n586\t    # Script the explicit targets so cast_spell_free's target choices resolve.\n587\t    if targets:\n588\t        appendleft = getattr(getattr(controller, \"_script\", None), \"appendleft\", None)\n589\t        if appendleft is not None:\n590\t            for target in reversed(targets):\n591\t                controller._script.appendleft(target)\n592\t\n593\t    cast_spell_free(game, controller, spell_copy, Zone.EXILE)\n594\t\n595\t    if len(game.stack) > stack_before:\n596\t        return game.stack.peek()\n597\t    return None\n598\t\n599\t\n600\tdef resolve_top(game: GameState) -> None:\n601\t    \"\"\"Resolve the top spell/ability on the stack.\n602\t\n603\t    Pops the top item from the stack, calls its on_resolve callback,\n604\t    then runs state-based actions.  If the stack is empty this is a no-op.\n605\t    \"\"\"\n606\t    if game.stack.is_empty():\n607\t        return\n608\t    from engine.state_based_actions import resolve_state_based_actions\n609\t\n610\t    obj = game.stack.pop()\n611\t    obj.on_resolve(game)\n612\t    resolve_state_based_actions(game)\n613\t"}]},"parent_tool_use_id":"toolu_012rXFMpMiUxgBU3maGZJedn","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"233518cf-b761-499e-b1c5-d54c109090b6","timestamp":"2026-06-01T11:23:29.072Z","subagent_type":"Tester","task_description":"Write tests for sos_120"}
{"type":"system","subtype":"task_progress","task_id":"aa3126577ecaf2c29","tool_use_id":"toolu_012rXFMpMiUxgBU3maGZJedn","description":"Reading cards/sos/sos_57/card_impl.py","subagent_type":"Tester","usage":{"total_tokens":50218,"tool_uses":14,"duration_ms":24440},"last_tool_name":"Read","uuid":"e40b27b4-ee47-4d8a-b99f-7dc286f4c69a","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445"}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_013Pdbqhtmez3W7hWjqFacdE","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01VFK2LVxJiPSP22CqFvEW9p","name":"Read","input":{"file_path":"/workspace/cards/sos/sos_57/card_impl.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":13974,"cache_read_input_tokens":36028,"cache_creation":{"ephemeral_5m_input_tokens":13974,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_012rXFMpMiUxgBU3maGZJedn","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"13a805ad-ba2b-4270-9df5-42b19593ff2a","request_id":"req_011CbcTKQ6i9q6rEZGExbAoM","subagent_type":"Tester","task_description":"Write tests for sos_120"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VFK2LVxJiPSP22CqFvEW9p","type":"tool_result","content":"1\t\"\"\"Card implementation for Mana Sculpt (SOS 57).\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Instant\n8\tfrom engine.types import CardType, ManaCost, ManaType, TargetRequirement, Zone\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t\n13\t\n14\t# Card types that identify an object on the stack as a \"spell\".\n15\t_SPELL_TYPES = frozenset(\n16\t    {\n17\t        CardType.INSTANT,\n18\t        CardType.SORCERY,\n19\t        CardType.CREATURE,\n20\t        CardType.ENCHANTMENT,\n21\t        CardType.ARTIFACT,\n22\t        CardType.PLANESWALKER,\n23\t    }\n24\t)\n25\t\n26\t\n27\tdef _is_spell(obj: Any) -> bool:\n28\t    \"\"\"Return ``True`` if *obj* is a castable spell (not a player/permanent-only).\n29\t\n30\t    \"Target spell\" is not \"any target\": players are illegal, and the object\n31\t    must carry spell card types.\n32\t    \"\"\"\n33\t    if obj is None:\n34\t        return False\n35\t    # Players expose ``life`` — reject them (\"target spell\" excludes players).\n36\t    if hasattr(obj, \"life\"):\n37\t        return False\n38\t    card_types = getattr(obj, \"card_types\", None)\n39\t    if not card_types:\n40\t        return False\n41\t    return bool(card_types & _SPELL_TYPES)\n42\t\n43\t\n44\tdef _controls_wizard(game: \"GameState\", player: Any) -> bool:\n45\t    \"\"\"Return ``True`` if *player* controls a creature with the Wizard subtype.\"\"\"\n46\t    if player is None:\n47\t        return False\n48\t    battlefield = player.zones[Zone.BATTLEFIELD]\n49\t    for obj in battlefield.get_all():\n50\t        subtypes = getattr(obj, \"subtypes\", set()) or set()\n51\t        if \"Wizard\" in subtypes:\n52\t            return True\n53\t    return False\n54\t\n55\t\n56\tdef _mana_spent_on(spell: Any) -> int:\n57\t    \"\"\"Return the amount of mana spent to cast *spell*.\n58\t\n59\t    Prefers the engine-recorded ``mana_spent`` (the actual total mana paid;\n60\t    see :attr:`engine.mana.ManaPool.last_payment_total`). Falls back to the\n61\t    printed mana value when the spell was not cast through the normal\n62\t    payment pipeline (e.g. placed on the stack directly in tests).\n63\t    \"\"\"\n64\t    recorded = getattr(spell, \"mana_spent\", None)\n65\t    if recorded is not None:\n66\t        return int(recorded)\n67\t    cost = getattr(spell, \"mana_cost\", None)\n68\t    if cost is not None:\n69\t        return int(cost.cmc)\n70\t    return 0\n71\t\n72\t\n73\tdef _counter_spell(game: \"GameState\", target_spell: Any) -> None:\n74\t    \"\"\"Counter *target_spell*: remove its StackObject and move it to the\n75\t    owner's graveyard. The spell never resolves.\"\"\"\n76\t    stack_items = game.stack._items  # noqa: SLF001\n77\t    stack_obj = None\n78\t    for item in list(stack_items):\n79\t        if getattr(item, \"source\", None) is target_spell:\n80\t            stack_obj = item\n81\t            break\n82\t    if stack_obj is None:\n83\t        return\n84\t\n85\t    stack_items.remove(stack_obj)\n86\t\n87\t    owner = getattr(target_spell, \"owner\", None) or getattr(stack_obj, \"controller\", None)\n88\t    controller = getattr(stack_obj, \"controller\", None) or owner\n89\t\n90\t    # Remove the card from whatever STACK zone it lives in.\n91\t    if controller is not None and controller.zones[Zone.STACK].contains(target_spell):\n92\t        controller.zones[Zone.STACK].remove(target_spell)\n93\t    elif owner is not None and owner.zones[Zone.STACK].contains(target_spell):\n94\t        owner.zones[Zone.STACK].remove(target_spell)\n95\t\n96\t    # A countered spell is put into its owner's graveyard.\n97\t    if owner is not None:\n98\t        owner.zones[Zone.GRAVEYARD].add(target_spell)\n99\t\n100\t\n101\tclass ManaSculpt(Instant):\n102\t    \"\"\"Mana Sculpt — {1}{U}{U} — Instant.\n103\t\n104\t    Counter target spell. If you control a Wizard, add an amount of {C} equal\n105\t    to the amount of mana spent to cast that spell at the beginning of your\n106\t    next main phase.\n107\t\n108\t    SOS collector number 57.\n109\t    \"\"\"\n110\t\n111\t    def __init__(self, **kwargs: Any) -> None:\n112\t        kwargs.setdefault(\"name\", \"Mana Sculpt\")\n113\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{U}{U}\"))\n114\t        kwargs.setdefault(\n115\t            \"rules_text\",\n116\t            \"Counter target spell. If you control a Wizard, add an amount of \"\n117\t            \"{C} equal to the amount of mana spent to cast that spell at the \"\n118\t            \"beginning of your next main phase.\",\n119\t        )\n120\t        super().__init__(**kwargs)\n121\t        self.chosen_targets: list[Any] = []\n122\t\n123\t    def get_targets(self, game: \"GameState\") -> list[TargetRequirement]:\n124\t        \"\"\"Advertise a single 'target spell' requirement on the stack.\"\"\"\n125\t        return [\n126\t            TargetRequirement(\n127\t                filter_fn=_is_spell,\n128\t                description=\"target spell\",\n129\t                zone=Zone.STACK,\n130\t            )\n131\t        ]\n132\t\n133\t    def on_resolve(self, game: \"GameState\") -> None:\n134\t        \"\"\"Counter the targeted spell, then (if a Wizard is controlled) set up\n135\t        the delayed colorless-mana payoff.\"\"\"\n136\t        chosen = getattr(self, \"chosen_targets\", None) or []\n137\t        if not chosen:\n138\t            # No legal target chosen — safe no-op.\n139\t            return\n140\t        target_spell = chosen[0]\n141\t        if target_spell is None:\n142\t            return\n143\t\n144\t        # Capture the amount of mana spent before the spell leaves the stack.\n145\t        mana_spent = _mana_spent_on(target_spell)\n146\t\n147\t        _counter_spell(game, target_spell)\n148\t\n149\t        controller = self.controller\n150\t        if controller is None:\n151\t            return\n152\t\n153\t        # \"If you control a Wizard\" — checked at resolution.\n154\t        if not _controls_wizard(game, controller):\n155\t            return\n156\t\n157\t        self._register_delayed_mana(game, controller, mana_spent)\n158\t\n159\t    def _register_delayed_mana(\n160\t        self, game: \"GameState\", controller: Any, amount: int\n161\t    ) -> None:\n162\t        \"\"\"Register a delayed trigger that adds ``amount`` {C} to *controller*'s\n163\t        pool at the beginning of their next main phase.\"\"\"\n164\t        from engine.events import BeginningOfMainPhaseTriggeredEvent\n165\t        from engine.triggers import TriggerRegistration\n166\t\n167\t        fired = {\"done\": False}\n168\t\n169\t        def _condition(g: \"GameState\", event: Any) -> bool:\n170\t            if fired[\"done\"]:\n171\t                return False\n172\t            return getattr(event, \"player\", None) is controller\n173\t\n174\t        def _effect(g: \"GameState\") -> None:\n175\t            fired[\"done\"] = True\n176\t            controller.mana_pool.add(ManaType.COLORLESS, amount)\n177\t            # One-shot: remove this delayed effect once it has fired.\n178\t            g.trigger_manager.unregister(self)\n179\t\n180\t        game.trigger_manager.register(\n181\t            TriggerRegistration(\n182\t                event_type=BeginningOfMainPhaseTriggeredEvent,\n183\t                condition=_condition,\n184\t                effect=_effect,\n185\t                source=self,\n186\t                controller=controller,\n187\t            )\n188\t        )\n189\t"}]},"parent_tool_use_id":"toolu_012rXFMpMiUxgBU3maGZJedn","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"6022f2aa-68ba-4509-82f5-43bea73777b3","timestamp":"2026-06-01T11:23:34.348Z","subagent_type":"Tester","task_description":"Write tests for sos_120"}
{"type":"system","subtype":"task_progress","task_id":"aa3126577ecaf2c29","tool_use_id":"toolu_012rXFMpMiUxgBU3maGZJedn","description":"Reading engine/card.py","subagent_type":"Tester","usage":{"total_tokens":50226,"tool_uses":15,"duration_ms":24647},"last_tool_name":"Read","uuid":"566bcb97-b483-4ef3-8f70-0eed9bb112a3","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445"}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_013Pdbqhtmez3W7hWjqFacdE","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_016GpJy3Ai6ec1o3gQEFyk4o","name":"Read","input":{"file_path":"/workspace/engine/card.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":13974,"cache_read_input_tokens":36028,"cache_creation":{"ephemeral_5m_input_tokens":13974,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_012rXFMpMiUxgBU3maGZJedn","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"bd1b9d60-6c68-4411-80f6-fa49f2646950","request_id":"req_011CbcTKQ6i9q6rEZGExbAoM","subagent_type":"Tester","task_description":"Write tests for sos_120"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016GpJy3Ai6ec1o3gQEFyk4o","type":"tool_result","content":"1\t\"\"\"Card base classes, CardImpl interface, and supporting dataclasses.\n2\t\n3\tProvides the core class hierarchy for all Magic: The Gathering card types:\n4\t\n5\t- ``GameObject`` — base for anything that can exist in zones.\n6\t- ``CardImpl(GameObject)`` — abstract card implementation with hooks for\n7\t  casting, resolution, targeting, triggers, and abilities.\n8\t- Concrete subclasses: ``Creature``, ``Instant``, ``Sorcery``,\n9\t  ``Enchantment``, ``Aura``, ``Artifact``, ``ArtifactCreature``,\n10\t  ``Planeswalker``, ``Land``.\n11\t- Supporting dataclasses: ``ActivatedAbility``, ``LoyaltyAbility``,\n12\t  ``ManaAbility``, ``ContinuousEffect``, ``Mode``.\n13\t\"\"\"\n14\t\n15\tfrom __future__ import annotations\n16\t\n17\tfrom dataclasses import dataclass\n18\tfrom typing import TYPE_CHECKING, Any, Callable\n19\t\n20\tfrom engine.types import CardType, Color, Keyword, ManaCost, ManaType, Supertype\n21\t\n22\tif TYPE_CHECKING:\n23\t    from engine.game_state import GameState\n24\t    from engine.player import Player\n25\t\n26\t\n27\t# ---------------------------------------------------------------------------\n28\t# Supporting dataclasses\n29\t# ---------------------------------------------------------------------------\n30\t\n31\t@dataclass\n32\tclass Mode:\n33\t    \"\"\"Represents a single mode of a modal spell or ability.\n34\t\n35\t    Attributes:\n36\t        name: Short label for this mode (e.g. ``\"Destroy target creature\"``).\n37\t        description: Detailed rules text for the mode.\n38\t    \"\"\"\n39\t\n40\t    name: str = \"\"\n41\t    description: str = \"\"\n42\t\n43\t\n44\t@dataclass\n45\tclass ActivatedAbility:\n46\t    \"\"\"An activated ability on a permanent.\n47\t\n48\t    Attributes:\n49\t        cost: A callable that checks/pays the cost given the game state.\n50\t        effect: A callable that applies the effect given the game state.\n51\t        description: Human-readable description of the ability.\n52\t    \"\"\"\n53\t\n54\t    cost: Callable[..., Any]\n55\t    effect: Callable[..., Any]\n56\t    description: str = \"\"\n57\t\n58\t\n59\t@dataclass\n60\tclass LoyaltyAbility:\n61\t    \"\"\"A planeswalker loyalty ability.\n62\t\n63\t    Attributes:\n64\t        loyalty_cost: The loyalty cost (positive for ``+``, negative for ``−``).\n65\t        effect: A callable that applies the ability's effect.\n66\t        description: Human-readable description.\n67\t    \"\"\"\n68\t\n69\t    loyalty_cost: int\n70\t    effect: Callable[..., Any]\n71\t    description: str = \"\"\n72\t\n73\t\n74\t@dataclass\n75\tclass ManaAbility:\n76\t    \"\"\"A mana ability (does not use the stack).\n77\t\n78\t    Attributes:\n79\t        cost: A callable that checks/pays the cost.\n80\t        mana_produced: A callable that returns the mana added.\n81\t        description: Human-readable description.\n82\t    \"\"\"\n83\t\n84\t    cost: Callable[..., Any]\n85\t    mana_produced: Callable[..., Any]\n86\t    description: str = \"\"\n87\t\n88\t\n89\t@dataclass\n90\tclass ContinuousEffect:\n91\t    \"\"\"A continuous effect applied by an enchantment or other source.\n92\t\n93\t    Attributes:\n94\t        apply: A callable that applies the effect to the game state.\n95\t        remove: A callable that removes the effect from the game state.\n96\t        description: Human-readable description.\n97\t    \"\"\"\n98\t\n99\t    apply: Callable[..., Any]\n100\t    remove: Callable[..., Any]\n101\t    description: str = \"\"\n102\t\n103\t\n104\t_MANA_TYPE_TO_COLOR: dict[ManaType, Color] = {\n105\t    ManaType.WHITE: Color.WHITE,\n106\t    ManaType.BLUE: Color.BLUE,\n107\t    ManaType.BLACK: Color.BLACK,\n108\t    ManaType.RED: Color.RED,\n109\t    ManaType.GREEN: Color.GREEN,\n110\t}\n111\t\n112\t\n113\tdef _colors_from_mana_cost(cost: ManaCost) -> set[Color]:\n114\t    \"\"\"Derive the set of :class:`~engine.types.Color` from a mana cost.\n115\t\n116\t    Colored pips contribute their color; hybrid symbols contribute both of\n117\t    their (non-colorless) options. Generic, ``{C}``, and ``{X}`` contribute\n118\t    nothing. Returns an empty set for a colorless / costless object.\n119\t    \"\"\"\n120\t    colors: set[Color] = set()\n121\t    for mana_type in getattr(cost, \"pips\", {}):\n122\t        color = _MANA_TYPE_TO_COLOR.get(mana_type)\n123\t        if color is not None:\n124\t            colors.add(color)\n125\t    for hybrid in getattr(cost, \"hybrid\", []):\n126\t        for option in (hybrid.option_a, hybrid.option_b):\n127\t            color = _MANA_TYPE_TO_COLOR.get(option)\n128\t            if color is not None:\n129\t                colors.add(color)\n130\t    return colors\n131\t\n132\t\n133\t# ---------------------------------------------------------------------------\n134\t# GameObject — base class for zone-resident objects\n135\t# ---------------------------------------------------------------------------\n136\t\n137\tclass GameObject:\n138\t    \"\"\"Base class for anything that can exist in a zone.\n139\t\n140\t    Each instance receives a unique ``object_id`` via a class-level\n141\t    auto-incrementing counter.\n142\t\n143\t    Attributes:\n144\t        object_id: Unique integer identifier (auto-assigned).\n145\t        owner: The player who owns this object.\n146\t        controller: The player who currently controls this object.\n147\t    \"\"\"\n148\t\n149\t    _next_id: int = 1\n150\t\n151\t    def __init__(self, owner: Player | None = None, controller: Player | None = None) -> None:\n152\t        self.object_id: int = GameObject._next_id\n153\t        GameObject._next_id += 1\n154\t        self.owner: Player | None = owner\n155\t        self.controller: Player | None = controller if controller is not None else owner\n156\t\n157\t    @classmethod\n158\t    def reset_id_counter(cls) -> None:\n159\t        \"\"\"Reset the auto-incrementing counter (useful in tests).\"\"\"\n160\t        cls._next_id = 1\n161\t\n162\t\n163\t# ---------------------------------------------------------------------------\n164\t# CardImpl — abstract card implementation\n165\t# ---------------------------------------------------------------------------\n166\t\n167\tclass CardImpl(GameObject):\n168\t    \"\"\"Abstract base for all card implementations.\n169\t\n170\t    Subclasses should override the ``can_cast``, ``on_cast``, ``on_resolve``,\n171\t    and other hook methods to implement card-specific behaviour.\n172\t\n173\t    Attributes:\n174\t        name: Card name.\n175\t        mana_cost: The card's mana cost.\n176\t        card_types: Set of :class:`~engine.types.CardType` values.\n177\t        subtypes: Set of subtype strings (e.g. ``{\"Elf\", \"Warrior\"}``).\n178\t        supertypes: Set of :class:`~engine.types.Supertype` values.\n179\t        keywords: Combination of :class:`~engine.types.Keyword` flags.\n180\t        rules_text: The card's rules text string.\n181\t    \"\"\"\n182\t\n183\t    def __init__(\n184\t        self,\n185\t        name: str = \"\",\n186\t        mana_cost: ManaCost | None = None,\n187\t        card_types: set[CardType] | None = None,\n188\t        subtypes: set[str] | None = None,\n189\t        supertypes: set[Supertype] | None = None,\n190\t        keywords: Keyword | None = None,\n191\t        rules_text: str = \"\",\n192\t        owner: Player | None = None,\n193\t        controller: Player | None = None,\n194\t        colors: set[Color] | None = None,\n195\t    ) -> None:\n196\t        super().__init__(owner=owner, controller=controller)\n197\t        self.name: str = name\n198\t        self.mana_cost: ManaCost = mana_cost if mana_cost is not None else ManaCost()\n199\t        self.card_types: set[CardType] = card_types if card_types is not None else set()\n200\t        self.subtypes: set[str] = subtypes if subtypes is not None else set()\n201\t        self.supertypes: set[Supertype] = supertypes if supertypes is not None else set()\n202\t        self.keywords: Keyword = keywords if keywords is not None else Keyword(0)\n203\t        self.rules_text: str = rules_text\n204\t        # Color identity of this object (rule 105). When ``colors`` is given\n205\t        # explicitly (e.g. for tokens, which have no mana cost) it is used\n206\t        # verbatim; otherwise colors are derived from the mana cost's pips.\n207\t        # Stored as a set of :class:`~engine.types.Color`.\n208\t        self.colors: set[Color] = (\n209\t            set(colors) if colors is not None\n210\t            else _colors_from_mana_cost(self.mana_cost)\n211\t        )\n212\t        # Snapshot original characteristics for continuous-effect reset.\n213\t        self._original_card_types: frozenset[CardType] = frozenset(self.card_types)\n214\t        self._original_keywords: Keyword = self.keywords\n215\t\n216\t    # ------------------------------------------------------------------\n217\t    # Continuous-effect reset support\n218\t    # ------------------------------------------------------------------\n219\t\n220\t    def _reset_characteristics(self) -> None:\n221\t        \"\"\"Reset mutable characteristics to their original (pre-effect) values.\n222\t\n223\t        Called by :meth:`EffectManager.apply_all` before reapplying effects\n224\t        so that the recalculation is idempotent.\n225\t        \"\"\"\n226\t        self.card_types = set(self._original_card_types)\n227\t        self.keywords = self._original_keywords\n228\t\n229\t    # ------------------------------------------------------------------\n230\t    # Hook methods — override in subclasses / card definitions\n231\t    # ------------------------------------------------------------------\n232\t\n233\t    def can_cast(self, game: GameState) -> bool:\n234\t        \"\"\"Return ``True`` if this card can currently be cast.\"\"\"\n235\t        return True\n236\t\n237\t    def cost_reduction(self, game: GameState) -> int:\n238\t        \"\"\"Return the generic mana reduction for casting this card.\n239\t\n240\t        Override in subclasses to implement cost-reduction mechanics\n241\t        (e.g. Embercleave costs {1} less for each attacking creature).\n242\t        The returned value is clamped so that generic mana cannot go below 0.\n243\t        Only reduces generic mana — colored costs are never reduced.\n244\t\n245\t        Returns:\n246\t            Non-negative integer representing generic mana to subtract.\n247\t        \"\"\"\n248\t        return 0\n249\t\n250\t    def on_cast(self, game: GameState) -> None:\n251\t        \"\"\"Called when the card is cast (before it goes on the stack).\"\"\"\n252\t\n253\t    def on_resolve(self, game: GameState) -> None:\n254\t        \"\"\"Called when the spell resolves from the stack.\n255\t\n256\t        Targets are available via ``self.chosen_targets`` — set at\n257\t        resolve-time by :func:`~engine.casting._resolve_spell` from\n258\t        :attr:`StackObject.targets`, or directly by test code.\n259\t        \"\"\"\n260\t\n261\t    def get_targets(self, game: GameState) -> list[Any]:\n262\t        \"\"\"Return a list of legal targets for this card.\"\"\"\n263\t        return []\n264\t\n265\t    def register_triggers(self, game: GameState) -> None:\n266\t        \"\"\"Register any triggered abilities this card provides.\"\"\"\n267\t\n268\t    def register_replacement_effects(self, game: GameState) -> None:\n269\t        \"\"\"Register any replacement effects this card provides.\"\"\"\n270\t\n271\t    def get_activated_abilities(self) -> list[ActivatedAbility]:\n272\t        \"\"\"Return activated abilities this card provides.\"\"\"\n273\t        return []\n274\t\n275\t    def get_modes(self) -> list[Mode]:\n276\t        \"\"\"Return available modes for modal spells/abilities.\n277\t\n278\t        Non-modal cards return an empty list by default.\n279\t        \"\"\"\n280\t        return []\n281\t\n282\t\n283\t# ---------------------------------------------------------------------------\n284\t# Creature\n285\t# ---------------------------------------------------------------------------\n286\t\n287\tclass Creature(CardImpl):\n288\t    \"\"\"A creature card.\n289\t\n290\t    Attributes:\n291\t        base_power: The printed power value (rule 208.1). Immutable after init.\n292\t        base_toughness: The printed toughness value. Immutable after init.\n293\t        modified_power: Current power after continuous effects (Layer 7c), before counters.\n294\t            Reset to ``base_power`` each effect cycle; continuous effects write here.\n295\t        modified_toughness: Current toughness after continuous effects, before counters.\n296\t        damage_marked: Amount of damage currently marked on this creature.\n297\t        is_tapped: Whether the creature is tapped.\n298\t        summoning_sick: Whether the creature has summoning sickness.\n299\t        is_attacking: Combat flag — currently declared as an attacker.\n300\t        is_blocking: Combat flag — currently declared as a blocker.\n301\t        plus_one_counters: Number of +1/+1 counters.\n302\t        minus_one_counters: Number of -1/-1 counters.\n303\t        is_token: Whether this object is a token (for SBA checks).\n304\t    \"\"\"\n305\t\n306\t    def __init__(\n307\t        self,\n308\t        name: str = \"\",\n309\t        mana_cost: ManaCost | None = None,\n310\t        card_types: set[CardType] | None = None,\n311\t        subtypes: set[str] | None = None,\n312\t        supertypes: set[Supertype] | None = None,\n313\t        keywords: Keyword | None = None,\n314\t        rules_text: str = \"\",\n315\t        owner: Player | None = None,\n316\t        controller: Player | None = None,\n317\t        base_power: int = 0,\n318\t        base_toughness: int = 0,\n319\t        colors: set[Color] | None = None,\n320\t    ) -> None:\n321\t        # Always include CREATURE in card_types.\n322\t        card_types = (card_types or set()) | {CardType.CREATURE}\n323\t        super().__init__(\n324\t            name=name,\n325\t            mana_cost=mana_cost,\n326\t            card_types=card_types,\n327\t            subtypes=subtypes,\n328\t            supertypes=supertypes,\n329\t            keywords=keywords,\n330\t            rules_text=rules_text,\n331\t            owner=owner,\n332\t            controller=controller,\n333\t            colors=colors,\n334\t        )\n335\t        self.base_power: int = base_power\n336\t        self.base_toughness: int = base_toughness\n337\t        self.modified_power: int = base_power\n338\t        self.modified_toughness: int = base_toughness\n339\t        self.damage_marked: int = 0\n340\t        self.is_tapped: bool = False\n341\t        self.summoning_sick: bool = True\n342\t        self.is_attacking: bool = False\n343\t        self.is_blocking: bool = False\n344\t        self.plus_one_counters: int = 0\n345\t        self.minus_one_counters: int = 0\n346\t        self.is_token: bool = False\n347\t        self.dealt_deathtouch_damage: bool = False\n348\t        self._base_plus_one_counters: int = 0\n349\t        self._base_minus_one_counters: int = 0\n350\t\n351\t    def _reset_characteristics(self) -> None:\n352\t        \"\"\"Reset creature characteristics to pre-effect values.\"\"\"\n353\t        super()._reset_characteristics()\n354\t        self.modified_power = self.base_power\n355\t        self.modified_toughness = self.base_toughness\n356\t        self.plus_one_counters = self._base_plus_one_counters\n357\t        self.minus_one_counters = self._base_minus_one_counters\n358\t        # Reset combat-restriction flags set by continuous effects (e.g. Pacifism).\n359\t        # These are reapplied by active effects during apply_all().\n360\t        self._cant_attack: bool = False\n361\t        self._cant_block: bool = False\n362\t        self._cant_be_blocked: bool = False\n363\t        self._cant_activate: bool = False\n364\t        self._max_attackers_blocked: int = 1\n365\t        # Clear granted protections so they are reapplied by active effects.\n366\t        if hasattr(self, \"protections\"):\n367\t            self.protections = []\n368\t\n369\t    @property\n370\t    def counters(self) -> dict[str, int]:\n371\t        \"\"\"Return a dict-like view of counters on this creature.\"\"\"\n372\t        result: dict[str, int] = {}\n373\t        if self.plus_one_counters > 0:\n374\t            result[\"+1/+1\"] = self.plus_one_counters\n375\t        if self.minus_one_counters > 0:\n376\t            result[\"-1/-1\"] = self.minus_one_counters\n377\t        return result\n378\t\n379\t    @property\n380\t    def power(self) -> int:\n381\t        \"\"\"Current power including counter modifications.\"\"\"\n382\t        return self.modified_power + self.plus_one_counters - self.minus_one_counters\n383\t\n384\t    @property\n385\t    def toughness(self) -> int:\n386\t        \"\"\"Current toughness including counter modifications.\"\"\"\n387\t        return self.modified_toughness + self.plus_one_counters - self.minus_one_counters\n388\t\n389\t\n390\t# ---------------------------------------------------------------------------\n391\t# Instant / Sorcery\n392\t# ---------------------------------------------------------------------------\n393\t\n394\tclass Instant(CardImpl):\n395\t    \"\"\"An instant spell — no extra fields beyond CardImpl.\"\"\"\n396\t\n397\t    def __init__(self, **kwargs: Any) -> None:\n398\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.INSTANT}\n399\t        super().__init__(**kwargs)\n400\t\n401\t\n402\tclass Sorcery(CardImpl):\n403\t    \"\"\"A sorcery spell — no extra fields beyond CardImpl.\"\"\"\n404\t\n405\t    def __init__(self, **kwargs: Any) -> None:\n406\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.SORCERY}\n407\t        super().__init__(**kwargs)\n408\t\n409\t\n410\t# ---------------------------------------------------------------------------\n411\t# Enchantment\n412\t# ---------------------------------------------------------------------------\n413\t\n414\tclass Enchantment(CardImpl):\n415\t    \"\"\"An enchantment card.\n416\t\n417\t    For auras, use the :class:`Aura` subclass which sets ``is_aura = True``.\n418\t    The base ``Enchantment`` class retains the ``attached_to`` attribute for\n419\t    backwards compatibility but marks ``is_aura = False`` so that state-based\n420\t    actions do not treat a non-aura enchantment as an unattached aura.\n421\t\n422\t    Attributes:\n423\t        attached_to: The object this enchantment is attached to (``None``\n424\t            if not an aura or not yet attached).\n425\t        is_aura: ``False`` for regular enchantments; ``True`` for auras.\n426\t    \"\"\"\n427\t\n428\t    is_aura: bool = False\n429\t\n430\t    def __init__(self, attached_to: Any | None = None, **kwargs: Any) -> None:\n431\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ENCHANTMENT}\n432\t        super().__init__(**kwargs)\n433\t        self.attached_to: Any | None = attached_to\n434\t\n435\t    def apply_continuous_effect(self, game: GameState) -> None:\n436\t        \"\"\"Apply the enchantment's continuous effect to the game.\"\"\"\n437\t\n438\t    def on_enchant(self, game: GameState) -> None:\n439\t        \"\"\"Called when this enchantment becomes attached to an object.\"\"\"\n440\t\n441\t    def on_detach(self, game: GameState) -> None:\n442\t        \"\"\"Called when this enchantment is detached from its object.\"\"\"\n443\t\n444\t\n445\tclass Aura(Enchantment):\n446\t    \"\"\"An Aura enchantment — attaches to a permanent on the battlefield.\n447\t\n448\t    Sets ``is_aura = True`` so that state-based actions correctly identify\n449\t    this as an aura (and move it to the graveyard when unattached).\n450\t\n451\t    Attributes:\n452\t        is_aura: Always ``True`` for auras.\n453\t    \"\"\"\n454\t\n455\t    is_aura: bool = True\n456\t\n457\t    def __init__(self, attached_to: Any | None = None, **kwargs: Any) -> None:\n458\t        super().__init__(attached_to=attached_to, **kwargs)\n459\t\n460\t\n461\t# ---------------------------------------------------------------------------\n462\t# Artifact / ArtifactCreature\n463\t# ---------------------------------------------------------------------------\n464\t\n465\tclass Artifact(CardImpl):\n466\t    \"\"\"An artifact card.\n467\t\n468\t    Attributes:\n469\t        is_tapped: Whether the artifact is currently tapped.\n470\t    \"\"\"\n471\t\n472\t    def __init__(self, **kwargs: Any) -> None:\n473\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ARTIFACT}\n474\t        super().__init__(**kwargs)\n475\t        self.is_tapped: bool = False\n476\t\n477\t\n478\tclass ArtifactCreature(Creature):\n479\t    \"\"\"An artifact creature — combines Artifact and Creature types.\n480\t\n481\t    Inherits creature combat stats and behaviour from :class:`Creature`.\n482\t    \"\"\"\n483\t\n484\t    def __init__(self, **kwargs: Any) -> None:\n485\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.ARTIFACT, CardType.CREATURE}\n486\t        super().__init__(**kwargs)\n487\t\n488\t\n489\t# ---------------------------------------------------------------------------\n490\t# Planeswalker\n491\t# ---------------------------------------------------------------------------\n492\t\n493\tclass Planeswalker(CardImpl):\n494\t    \"\"\"A planeswalker card.\n495\t\n496\t    Attributes:\n497\t        starting_loyalty: The starting loyalty printed on the card.\n498\t        loyalty: Current loyalty counter value.\n499\t    \"\"\"\n500\t\n501\t    def __init__(\n502\t        self,\n503\t        starting_loyalty: int = 0,\n504\t        **kwargs: Any,\n505\t    ) -> None:\n506\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.PLANESWALKER}\n507\t        super().__init__(**kwargs)\n508\t        self.starting_loyalty: int = starting_loyalty\n509\t        self.loyalty: int = starting_loyalty\n510\t\n511\t    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n512\t        \"\"\"Return the planeswalker's loyalty abilities.\"\"\"\n513\t        return []\n514\t\n515\t\n516\t# ---------------------------------------------------------------------------\n517\t# Land\n518\t# ---------------------------------------------------------------------------\n519\t\n520\tclass Land(CardImpl):\n521\t    \"\"\"A land card.\n522\t\n523\t    Lands are not cast — they are played via a special action. ``can_cast``\n524\t    always returns ``False``.\n525\t\n526\t    Attributes:\n527\t        is_tapped: Whether the land is currently tapped.\n528\t    \"\"\"\n529\t\n530\t    def __init__(self, **kwargs: Any) -> None:\n531\t        kwargs[\"card_types\"] = (kwargs.get(\"card_types\") or set()) | {CardType.LAND}\n532\t        super().__init__(**kwargs)\n533\t        self.is_tapped: bool = False\n534\t\n535\t    def can_cast(self, game: GameState) -> bool:\n536\t        \"\"\"Lands cannot be cast; they are played as a special action.\"\"\"\n537\t        return False\n538\t\n539\t    def get_mana_abilities(self) -> list[ManaAbility]:\n540\t        \"\"\"Return the land's mana abilities.\"\"\"\n541\t        return []\n542\t"}]},"parent_tool_use_id":"toolu_012rXFMpMiUxgBU3maGZJedn","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"3b14d558-e22d-4e80-ad97-090d1e3f711a","timestamp":"2026-06-01T11:23:34.553Z","subagent_type":"Tester","task_description":"Write tests for sos_120"}
