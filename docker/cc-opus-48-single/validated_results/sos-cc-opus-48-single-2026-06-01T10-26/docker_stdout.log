{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BzyQH7tFriHd3kJV7ZePLM","type":"tool_result","content":"1\t\"\"\"Card implementation for Secluded Courtyard.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Land, ManaAbility\n8\tfrom engine.types import ManaCost, ManaType\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t\n13\t\n14\tclass SecludedCourtyard(Land):\n15\t    \"\"\"Secluded Courtyard — Land\n16\t\n17\t    As this land enters, choose a creature type.\n18\t    {T}: Add {C}.\n19\t    {T}: Add one mana of any color. Spend this mana only to cast a creature\n20\t    spell of the chosen type or activate an ability of a creature source of\n21\t    the chosen type.\n22\t\n23\t    FDN collector number 267.\n24\t    \"\"\"\n25\t\n26\t    def __init__(self, **kwargs: Any) -> None:\n27\t        kwargs.setdefault(\"name\", \"Secluded Courtyard\")\n28\t        kwargs.setdefault(\n29\t            \"rules_text\",\n30\t            \"As this land enters, choose a creature type.\\n\"\n31\t            \"{T}: Add {C}.\\n\"\n32\t            \"{T}: Add one mana of any color. Spend this mana only to cast \"\n33\t            \"a creature spell of the chosen type or activate an ability of \"\n34\t            \"a creature source of the chosen type.\",\n35\t        )\n36\t        super().__init__(**kwargs)\n37\t        self.chosen_creature_type: str | None = None\n38\t\n39\t    def on_resolve(self, game: Any) -> None:\n40\t        \"\"\"As this land enters, choose a creature type.\n41\t\n42\t        Note: play_land() should ideally call this method (or an equivalent\n43\t        on_enter hook) so the choice is recorded during normal land play.\n44\t        The engine currently does not invoke on_resolve() for lands, so\n45\t        callers must trigger this explicitly.\n46\t        \"\"\"\n47\t        controller = self.controller\n48\t        if controller is not None:\n49\t            # Use controller.choose to pick a creature type.\n50\t            # Signature: choose(options, description)\n51\t            creature_types = [\n52\t                \"Human\", \"Elf\", \"Goblin\", \"Wizard\", \"Soldier\",\n53\t                \"Zombie\", \"Merfolk\", \"Angel\", \"Dragon\", \"Vampire\",\n54\t                \"Beast\", \"Elemental\", \"Knight\", \"Warrior\", \"Rogue\",\n55\t                \"Cleric\", \"Shaman\", \"Druid\", \"Spirit\", \"Demon\",\n56\t                \"Bird\", \"Cat\", \"Dog\", \"Dinosaur\", \"Sliver\",\n57\t            ]\n58\t            choice = controller.choose(\n59\t                creature_types,\n60\t                \"Choose a creature type for Secluded Courtyard\",\n61\t            )\n62\t            self.chosen_creature_type = choice\n63\t\n64\t    def get_mana_abilities(self) -> list[ManaAbility]:\n65\t        source = self\n66\t\n67\t        def _tap_cost(game: Any, src: Any) -> bool:\n68\t            if getattr(src, \"is_tapped\", False):\n69\t                return False\n70\t            src.is_tapped = True\n71\t            return True\n72\t\n73\t        def _colorless_effect(game: Any) -> None:\n74\t            controller = source.controller\n75\t            if controller is not None:\n76\t                controller.mana_pool.add(ManaType.COLORLESS, 1)\n77\t\n78\t        def _any_color_effect(game: Any) -> None:\n79\t            # ENGINE LIMITATION: The engine does not support conditional mana\n80\t            # spending restrictions. This should only be usable to cast creature\n81\t            # spells of the chosen type or activate abilities of creature sources\n82\t            # of the chosen type. The restriction is not enforced here.\n83\t            controller = source.controller\n84\t            if controller is not None:\n85\t                # Produce one mana of any color. Let the controller choose.\n86\t                color_options = [\n87\t                    ManaType.WHITE, ManaType.BLUE, ManaType.BLACK,\n88\t                    ManaType.RED, ManaType.GREEN,\n89\t                ]\n90\t                chosen_color = controller.choose(\n91\t                    color_options,\n92\t                    \"Choose a color of mana to produce\",\n93\t                )\n94\t                controller.mana_pool.add(chosen_color, 1)\n95\t\n96\t        return [\n97\t            ManaAbility(\n98\t                cost=_tap_cost,\n99\t                mana_produced=_colorless_effect,\n100\t                description=\"{T}: Add {C}.\",\n101\t            ),\n102\t            ManaAbility(\n103\t                cost=_tap_cost,\n104\t                mana_produced=_any_color_effect,\n105\t                description=\"{T}: Add one mana of any color (restricted).\",\n106\t            ),\n107\t        ]\n108\t"}]},"parent_tool_use_id":"toolu_01DqRHg8PRQF4DMAnkhcGpdm","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"2b168e05-624a-4e03-9e41-4fc1166c4bd1","timestamp":"2026-06-01T12:14:49.082Z","subagent_type":"Implementer","task_description":"Implement sos_257"}
