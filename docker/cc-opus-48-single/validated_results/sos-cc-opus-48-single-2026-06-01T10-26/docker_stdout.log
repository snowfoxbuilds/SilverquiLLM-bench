{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019aCS1Wj3n7T2mNRJa6L3UD","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_226/card_impl.py b/cards/sos/sos_226/card_impl.py\n2\tindex a3ef6eb..2a175a5 100644\n3\t--- a/cards/sos/sos_226/card_impl.py\n4\t+++ b/cards/sos/sos_226/card_impl.py\n5\t@@ -1,16 +1,240 @@\n6\t-\"\"\"Card implementation for Silverquill, the Disputant.\"\"\"\n7\t+\"\"\"Card implementation for Silverquill, the Disputant (SOS 226).\n8\t+\n9\t+Silverquill is a {2}{W}{B} 4/4 Legendary Elder Dragon with Flying and\n10\t+Vigilance.  Its payoff line grants **casualty 1** to every instant and\n11\t+sorcery spell its controller casts:\n12\t+\n13\t+    \"Each instant and sorcery spell you cast has casualty 1. (As you cast\n14\t+     that spell, you may sacrifice a creature with power 1 or greater. When\n15\t+     you do, copy the spell and you may choose new targets for the copy.)\"\n16\t+\n17\t+Casualty (rule 702.153) has no dedicated engine surface, so the grant is\n18\t+modelled through the existing cast-trigger machinery: a\n19\t+:class:`~engine.events.SpellCastTriggeredEvent` trigger scoped to the\n20\t+controller's own instant/sorcery spells (and only while Silverquill is on\n21\t+the battlefield).  Resolving the trigger offers the optional casualty\n22\t+sacrifice (``choose_yes_no``), selects a power>=1 creature (``choose_card``\n23\t+when more than one is eligible, else auto-selected), sacrifices it via\n24\t+:func:`engine.game.sacrifice`, then copies the spell via\n25\t+:func:`engine.stack.copy_spell` (optionally choosing new targets for the\n26\t+copy).\n27\t+\n28\t+``SpellCastTriggeredEvent`` is now fired by ``engine.casting.cast_spell``\n29\t+itself (additive engine change), so the same wiring also fires when a spell\n30\t+is cast through the normal pipeline.\n31\t+\"\"\"\n32\t \n33\t from __future__ import annotations\n34\t \n35\t-from engine.card import CardImpl\n36\t+from typing import TYPE_CHECKING, Any\n37\t \n38\t-from typing import TYPE_CHECKING\n39\t+from engine.card import Creature\n40\t+from engine.types import CardType, Color, Keyword, ManaCost, Supertype\n41\t \n42\t if TYPE_CHECKING:\n43\t     from engine.game_state import GameState\n44\t \n45\t \n46\t-class SilverquillTheDisputant(CardImpl):\n47\t-    \"\"\"TODO: Implement Silverquill, the Disputant.\"\"\"\n48\t+def _is_on_battlefield(game: Any, obj: Any) -> bool:\n49\t+    \"\"\"Return ``True`` if *obj* is on any player's battlefield.\"\"\"\n50\t+    for player in game.players:\n51\t+        if game.get_battlefield(player).contains(obj):\n52\t+            return True\n53\t+    return False\n54\t+\n55\t+\n56\t+class SilverquillTheDisputant(Creature):\n57\t+    \"\"\"Silverquill, the Disputant — {2}{W}{B} 4/4 Legendary Elder Dragon.\n58\t+\n59\t+    Flying, vigilance.  Each instant and sorcery spell you cast has\n60\t+    casualty 1.\n61\t+\n62\t+    SOS collector number 226.\n63\t+    \"\"\"\n64\t+\n65\t+    def __init__(self, **kwargs: Any) -> None:\n66\t+        kwargs.setdefault(\"name\", \"Silverquill, the Disputant\")\n67\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{2}{W}{B}\"))\n68\t+        kwargs.setdefault(\"base_power\", 4)\n69\t+        kwargs.setdefault(\"base_toughness\", 4)\n70\t+        kwargs.setdefault(\"subtypes\", {\"Elder\", \"Dragon\"})\n71\t+        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n72\t+        kwargs.setdefault(\"keywords\", Keyword.FLYING | Keyword.VIGILANCE)\n73\t+        kwargs.setdefault(\"colors\", {Color.WHITE, Color.BLACK})\n74\t+        kwargs.setdefault(\n75\t+            \"rules_text\",\n76\t+            \"Flying, vigilance\\n\"\n77\t+            \"Each instant and sorcery spell you cast has casualty 1. (As you \"\n78\t+            \"cast that spell, you may sacrifice a creature with power 1 or \"\n79\t+            \"greater. When you do, copy the spell and you may choose new \"\n80\t+            \"targets for the copy.)\",\n81\t+        )\n82\t+        super().__init__(**kwargs)\n83\t+\n84\t+    # ------------------------------------------------------------------\n85\t+    # Casualty grant — wired through the spell-cast trigger machinery.\n86\t+    # ------------------------------------------------------------------\n87\t+    def register_triggers(self, game: GameState) -> None:\n88\t+        from engine.events import SpellCastTriggeredEvent\n89\t+        from engine.triggers import TriggerRegistration\n90\t+\n91\t+        source = self\n92\t+\n93\t+        def _spell_from_event(event: Any) -> Any:\n94\t+            return getattr(event, \"spell\", None) or getattr(event, \"card\", None)\n95\t+\n96\t+        def _condition(game: Any, event: Any) -> bool:\n97\t+            # Static ability only functions while Silverquill is on the battlefield.\n98\t+            if not _is_on_battlefield(game, source):\n99\t+                return False\n100\t+            controller = getattr(source, \"controller\", None)\n101\t+            if controller is None:\n102\t+                return False\n103\t+            spell = _spell_from_event(event)\n104\t+            if spell is None:\n105\t+                return False\n106\t+            # Only spells YOU cast qualify.\n107\t+            caster = getattr(event, \"controller\", None) or getattr(event, \"player\", None)\n108\t+            spell_controller = getattr(spell, \"controller\", None)\n109\t+            if caster is not controller and spell_controller is not controller:\n110\t+                return False\n111\t+            # Only instant and sorcery spells get casualty.\n112\t+            card_types = getattr(spell, \"card_types\", set())\n113\t+            if not card_types & {CardType.INSTANT, CardType.SORCERY}:\n114\t+                return False\n115\t+            # Stash the spell so the effect can copy the right object.\n116\t+            source._casualty_spell = spell\n117\t+            return True\n118\t+\n119\t+        def _effect(game: GameState) -> None:\n120\t+            self._resolve_casualty(game)\n121\t+\n122\t+        controller = getattr(self, \"controller\", None) or game.active_player\n123\t+        game.trigger_manager.register(\n124\t+            TriggerRegistration(\n125\t+                event_type=SpellCastTriggeredEvent,\n126\t+                condition=_condition,\n127\t+                effect=_effect,\n128\t+                source=self,\n129\t+                controller=controller,\n130\t+            )\n131\t+        )\n132\t+\n133\t+    # ------------------------------------------------------------------\n134\t+    # Casualty resolution\n135\t+    # ------------------------------------------------------------------\n136\t+    def _resolve_casualty(self, game: GameState) -> None:\n137\t+        \"\"\"Offer the casualty sacrifice and, if paid, copy the spell.\n138\t+\n139\t+        Contract (rule 702.153 modelled as a \"when you cast\" trigger):\n140\t+\n141\t+        * Optional via ``controller.choose_yes_no``.\n142\t+        * Sacrifice target chosen via ``controller.choose_card`` among\n143\t+          creatures with power >= 1 the controller controls (auto-selected\n144\t+          when exactly one is eligible).  A 0-power creature is never\n145\t+          eligible; with no eligible creature there is no sacrifice and no\n146\t+          copy.\n147\t+        * The chosen creature is sacrificed via :func:`engine.game.sacrifice`.\n148\t+        * The spell is copied via :func:`engine.stack.copy_spell`; the\n149\t+          controller may choose new targets for the copy.\n150\t+        \"\"\"\n151\t+        from engine.game import sacrifice\n152\t+        from engine.stack import StackObject, copy_spell\n153\t+\n154\t+        controller = getattr(self, \"controller\", None)\n155\t+        spell = getattr(self, \"_casualty_spell\", None)\n156\t+        # Clear stash so a later trigger does not reuse a stale spell.\n157\t+        self._casualty_spell = None\n158\t+        if controller is None or spell is None:\n159\t+            return\n160\t+\n161\t+        # Eligible sacrifices: creatures the controller controls with\n162\t+        # power >= 1.  Silverquill itself is excluded as the casualty\n163\t+        # sacrifice candidate so the grant operates on the controller's\n164\t+        # other creatures.\n165\t+        eligible = [\n166\t+            c\n167\t+            for c in game.get_battlefield(controller).get_all()\n168\t+            if c is not self\n169\t+            and CardType.CREATURE in getattr(c, \"card_types\", set())\n170\t+            and getattr(c, \"power\", 0) >= 1\n171\t+        ]\n172\t+        if not eligible:\n173\t+            return\n174\t+\n175\t+        # Optional (\"you may\").\n176\t+        if not controller.choose_yes_no(\n177\t+            \"Pay casualty 1 — sacrifice a creature with power 1 or greater?\"\n178\t+        ):\n179\t+            return\n180\t+\n181\t+        if len(eligible) == 1:\n182\t+            chosen = eligible[0]\n183\t+        else:\n184\t+            chosen = controller.choose_card(\n185\t+                eligible, \"Choose a creature to sacrifice for casualty\"\n186\t+            )\n187\t+        if chosen is None or chosen not in eligible:\n188\t+            return\n189\t+\n190\t+        sacrifice(game, controller, chosen)\n191\t+\n192\t+        # Locate (or synthesise) the original spell's StackObject so we can\n193\t+        # copy it.  When cast through the normal pipeline the spell has a live\n194\t+        # StackObject on the game stack; otherwise wrap the spell directly.\n195\t+        original_so = None\n196\t+        for so in game.stack.objects():\n197\t+            if so.source is spell:\n198\t+                original_so = so\n199\t+                break\n200\t+        if original_so is None:\n201\t+            original_so = StackObject(\n202\t+                source=spell,\n203\t+                controller=controller,\n204\t+                targets=list(getattr(spell, \"chosen_targets\", []) or []),\n205\t+            )\n206\t+\n207\t+        new_targets = self._choose_new_targets(game, controller, original_so)\n208\t+        copy_obj = copy_spell(game, original_so, controller, new_targets)\n209\t+        game.stack.push(copy_obj)\n210\t+\n211\t+    @staticmethod\n212\t+    def _choose_new_targets(\n213\t+        game: GameState, controller: Any, original_so: Any\n214\t+    ) -> list[Any] | None:\n215\t+        \"\"\"Optionally choose new targets for the casualty copy.\n216\t+\n217\t+        Returns ``None`` to keep the original targets (the default), or a new\n218\t+        list of targets when the controller elects to re-target.  Mirrors the\n219\t+        FDN copy-with-new-targets convention (FDN 248).\n220\t+        \"\"\"\n221\t+        if not original_so.targets:\n222\t+            return None\n223\t+        spell = original_so.source\n224\t+        get_targets = getattr(spell, \"get_targets\", None)\n225\t+        if get_targets is None:\n226\t+            return None\n227\t+        if not controller.choose_yes_no(\n228\t+            f\"Choose new targets for the copy of {getattr(spell, 'name', 'the spell')}?\"\n229\t+        ):\n230\t+            return None\n231\t+\n232\t+        requirements = get_targets(game) or []\n233\t+        new_targets: list[Any] = []\n234\t+        for req in requirements:\n235\t+            filter_fn = getattr(req, \"filter_fn\", None)\n236\t+            legal: list[Any] = []\n237\t+            for p in game.players:\n238\t+                for obj in game.get_battlefield(p).get_all():\n239\t+                    if filter_fn is None or filter_fn(obj):\n240\t+                        legal.append(obj)\n241\t+                if filter_fn is None or filter_fn(p):\n242\t+                    legal.append(p)\n243\t+            if legal:\n244\t+                new_targets.append(controller.choose_target(legal, req))\n245\t+        return new_targets or None\n246\t \n247\t-    pass\n248\t+    def on_resolve(self, game: GameState) -> None:\n249\t+        # Silverquill is a creature permanent; its grant is a static ability\n250\t+        # handled via register_triggers, so resolution itself is a no-op.\n251\t+        pass\n252\tdiff --git a/engine/casting.py b/engine/casting.py\n253\tindex 97505a4..89dfa79 100644\n254\t--- a/engine/casting.py\n255\t+++ b/engine/casting.py\n256\t@@ -251,6 +251,32 @@ def cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n257\t     stack_obj.on_resolve = _on_resolve\n258\t     game.stack.push(stack_obj)\n259\t \n260\t+    # Fire the \"when you cast this spell\" event so cast-time grants (casualty\n261\t+    # and other \"whenever you cast ...\" triggers) can observe a real cast.\n262\t+    # The spell is already on the stack, matching MTG timing where such\n263\t+    # triggers are put on the stack above the spell that caused them.\n264\t+    _fire_spell_cast_event(game, player, card)\n265\t+\n266\t+\n267\t+def _fire_spell_cast_event(game: GameState, player: Player, card: CardImpl) -> None:\n268\t+    \"\"\"Fire :class:`~engine.events.SpellCastTriggeredEvent` for a cast spell.\n269\t+\n270\t+    Additive hook used by the casting pipeline so \"whenever you cast a(n)\n271\t+    instant/sorcery spell\" and casualty-style cast-time grants can trigger.\n272\t+    Safe no-op if the game has no ``trigger_manager``.\n273\t+    \"\"\"\n274\t+    trigger_manager = getattr(game, \"trigger_manager\", None)\n275\t+    if trigger_manager is None:\n276\t+        return\n277\t+    from engine.events import SpellCastTriggeredEvent\n278\t+\n279\t+    trigger_manager.fire_event(\n280\t+        game,\n281\t+        SpellCastTriggeredEvent(\n282\t+            spell=card, player=player, card=card, controller=player\n283\t+        ),\n284\t+    )\n285\t+\n286\t \n287\t # ------------------------------------------------------------------\n288\t # Cast spell without paying mana cost (free-cast from any zone)\n289\t"}]},"parent_tool_use_id":"toolu