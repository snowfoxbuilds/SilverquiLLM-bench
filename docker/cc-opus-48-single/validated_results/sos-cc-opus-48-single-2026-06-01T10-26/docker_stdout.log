{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XHoK8BmGtHsutJLYacfb8b","type":"tool_result","content":"1\t\"\"\"Tests for end-of-turn cleanup step (engine/turn.py :: _do_cleanup_step).\n2\t\n3\tVerifies:\n4\t- Active player discards to maximum hand size (7).\n5\t- Player with <=7 cards does not discard.\n6\t- \"Until end of turn\" continuous effects are removed during cleanup.\n7\t- Damage marked on creatures is cleared to 0.\n8\t- Combat flags (dealt_deathtouch_damage, is_attacking, is_blocking) are cleared.\n9\t- CombatState is cleared.\n10\t- All players' mana pools are emptied.\n11\t- SBAs are checked after effects expire (creature with lethal damage dies).\n12\t- If triggers fire during cleanup, another cleanup step occurs.\n13\t- Integration: Giant Growth (+3/+3 EOT) reverts after cleanup.\n14\t- Integration: 2 damage on a 3/3 is cleared — creature survives cleanup.\n15\t\"\"\"\n16\t\n17\tfrom __future__ import annotations\n18\t\n19\timport pytest\n20\t\n21\tfrom engine.card import CardImpl, Creature\n22\tfrom engine.combat import CombatState\n23\tfrom engine.continuous_effects import (\n24\t    ContinuousEffect,\n25\t    DURATION_END_OF_TURN,\n26\t    DURATION_PERMANENT,\n27\t    Layer,\n28\t    SubLayer,\n29\t)\n30\tfrom engine.game_state import GameState\n31\tfrom engine.mana import ManaPool\n32\tfrom engine.player import DeterministicPlayer\n33\tfrom engine.turn import _do_cleanup_step, MAX_HAND_SIZE\n34\tfrom engine.types import CardType, Keyword, ManaType, Phase, Step, Zone\n35\t\n36\t\n37\t# ---------------------------------------------------------------------------\n38\t# Helpers\n39\t# ---------------------------------------------------------------------------\n40\t\n41\t\n42\tdef _make_card(name: str = \"TestCard\") -> CardImpl:\n43\t    \"\"\"Create a minimal card for testing.\"\"\"\n44\t    return CardImpl(name=name)\n45\t\n46\t\n47\tdef _make_creature(\n48\t    name: str = \"Bear\",\n49\t    base_power: int = 2,\n50\t    base_toughness: int = 2,\n51\t    keywords: Keyword | None = None,\n52\t) -> Creature:\n53\t    \"\"\"Create a creature for testing.\"\"\"\n54\t    return Creature(\n55\t        name=name,\n56\t        base_power=base_power,\n57\t        base_toughness=base_toughness,\n58\t        keywords=keywords,\n59\t    )\n60\t\n61\t\n62\tdef _make_game(\n63\t    p1_script: list | None = None,\n64\t    p2_script: list | None = None,\n65\t) -> tuple[GameState, DeterministicPlayer, DeterministicPlayer]:\n66\t    \"\"\"Create a bare game state for cleanup tests.\"\"\"\n67\t    p1 = DeterministicPlayer(\"Alice\", p1_script or [])\n68\t    p2 = DeterministicPlayer(\"Bob\", p2_script or [])\n69\t    game = GameState([p1, p2])\n70\t    return game, p1, p2\n71\t\n72\t\n73\tdef _place_on_battlefield(game: GameState, player: DeterministicPlayer, obj) -> None:\n74\t    \"\"\"Place an object on a player's battlefield, setting ownership.\"\"\"\n75\t    obj.owner = player\n76\t    obj.controller = player\n77\t    player.zones[Zone.BATTLEFIELD].add(obj)\n78\t\n79\t\n80\tdef _place_in_hand(game: GameState, player: DeterministicPlayer, obj) -> None:\n81\t    \"\"\"Place a card in a player's hand, setting ownership.\"\"\"\n82\t    obj.owner = player\n83\t    obj.controller = player\n84\t    player.zones[Zone.HAND].add(obj)\n85\t\n86\t\n87\t# ===========================================================================\n88\t# Discard to hand size\n89\t# ===========================================================================\n90\t\n91\t\n92\tclass TestDiscardToHandSize:\n93\t    \"\"\"Tests for cleanup step 1: discard down to max hand size.\"\"\"\n94\t\n95\t    def test_discard_from_8_to_7(self) -> None:\n96\t        \"\"\"Player with 8 cards in hand discards 1 to reach 7.\"\"\"\n97\t        cards = [_make_card(f\"Card_{i}\") for i in range(8)]\n98\t        # Script: choose the first card in the list for discard\n99\t        game, p1, p2 = _make_game(p1_script=[cards[0]])\n100\t        for card in cards:\n101\t            _place_in_hand(game, p1, card)\n102\t\n103\t        _do_cleanup_step(game)\n104\t\n105\t        assert len(p1.zones[Zone.HAND]) == MAX_HAND_SIZE\n106\t\n107\t    def test_discard_from_10_to_7(self) -> None:\n108\t        \"\"\"Player with 10 cards in hand discards 3 to reach 7.\"\"\"\n109\t        cards = [_make_card(f\"Card_{i}\") for i in range(10)]\n110\t        # Need to script 3 discard choices\n111\t        game, p1, p2 = _make_game(p1_script=[cards[0], cards[1], cards[2]])\n112\t        for card in cards:\n113\t            _place_in_hand(game, p1, card)\n114\t\n115\t        _do_cleanup_step(game)\n116\t\n117\t        assert len(p1.zones[Zone.HAND]) == MAX_HAND_SIZE\n118\t\n119\t    def test_discarded_cards_go_to_graveyard(self) -> None:\n120\t        \"\"\"Discarded cards during cleanup go to the player's graveyard.\"\"\"\n121\t        cards = [_make_card(f\"Card_{i}\") for i in range(8)]\n122\t        game, p1, p2 = _make_game(p1_script=[cards[0]])\n123\t        for card in cards:\n124\t            _place_in_hand(game, p1, card)\n125\t\n126\t        _do_cleanup_step(game)\n127\t\n128\t        graveyard = p1.zones[Zone.GRAVEYARD]\n129\t        assert graveyard.contains(cards[0])\n130\t\n131\t    def test_exactly_7_cards_no_discard(self) -> None:\n132\t        \"\"\"Player with exactly 7 cards does NOT discard.\"\"\"\n133\t        cards = [_make_card(f\"Card_{i}\") for i in range(7)]\n134\t        game, p1, p2 = _make_game()\n135\t        for card in cards:\n136\t            _place_in_hand(game, p1, card)\n137\t\n138\t        _do_cleanup_step(game)\n139\t\n140\t        assert len(p1.zones[Zone.HAND]) == 7\n141\t\n142\t    def test_fewer_than_7_cards_no_discard(self) -> None:\n143\t        \"\"\"Player with fewer than 7 cards does NOT discard.\"\"\"\n144\t        cards = [_make_card(f\"Card_{i}\") for i in range(3)]\n145\t        game, p1, p2 = _make_game()\n146\t        for card in cards:\n147\t            _place_in_hand(game, p1, card)\n148\t\n149\t        _do_cleanup_step(game)\n150\t\n151\t        assert len(p1.zones[Zone.HAND]) == 3\n152\t\n153\t    def test_only_active_player_discards(self) -> None:\n154\t        \"\"\"Only the active player discards during cleanup, not the non-active player.\"\"\"\n155\t        # P1 is active (default), P2 has 9 cards — P2 should NOT discard\n156\t        cards_p2 = [_make_card(f\"P2Card_{i}\") for i in range(9)]\n157\t        game, p1, p2 = _make_game()\n158\t        for card in cards_p2:\n159\t            _place_in_hand(game, p2, card)\n160\t\n161\t        _do_cleanup_step(game)\n162\t\n163\t        # P2 should still have 9 cards since they're not the active player\n164\t        assert len(p2.zones[Zone.HAND]) == 9\n165\t\n166\t    def test_chosen_card_is_the_one_discarded(self) -> None:\n167\t        \"\"\"The specific card returned by choose_card is discarded.\"\"\"\n168\t        cards = [_make_card(f\"Card_{i}\") for i in range(8)]\n169\t        # Player chooses to discard the last card\n170\t        game, p1, p2 = _make_game(p1_script=[cards[7]])\n171\t        for card in cards:\n172\t            _place_in_hand(game, p1, card)\n173\t\n174\t        _do_cleanup_step(game)\n175\t\n176\t        hand = p1.zones[Zone.HAND]\n177\t        assert not hand.contains(cards[7])\n178\t        graveyard = p1.zones[Zone.GRAVEYARD]\n179\t        assert graveyard.contains(cards[7])\n180\t\n181\t\n182\t# ===========================================================================\n183\t# EOT effect removal\n184\t# ===========================================================================\n185\t\n186\t\n187\tclass TestEOTEffectRemoval:\n188\t    \"\"\"Tests for cleanup step 2: remove 'until end of turn' effects.\"\"\"\n189\t\n190\t    def test_eot_effect_removed(self) -> None:\n191\t        \"\"\"A DURATION_END_OF_TURN effect is removed during cleanup.\"\"\"\n192\t        game, p1, p2 = _make_game()\n193\t        creature = _make_creature(\"Bear\", 2, 2)\n194\t        _place_on_battlefield(game, p1, creature)\n195\t\n196\t        # Add an EOT effect that gives +3/+3\n197\t        effect = ContinuousEffect(\n198\t            source=creature,\n199\t            layer=Layer.POWER_TOUGHNESS,\n200\t            sublayer=SubLayer.MODIFY_PT,\n201\t            apply=lambda g: setattr(creature, \"modified_power\", creature.base_power + 3)\n202\t            or setattr(creature, \"modified_toughness\", creature.base_toughness + 3),\n203\t            duration=DURATION_END_OF_TURN,\n204\t        )\n205\t        game.effect_manager.add(effect)\n206\t        # Apply once to verify effect is active\n207\t        game.effect_manager.apply_all(game)\n208\t        assert creature.modified_power == 5\n209\t\n210\t        _do_cleanup_step(game)\n211\t\n212\t        # After cleanup, the effect should be removed and P/T reverted\n213\t        assert creature.modified_power == 2\n214\t        assert creature.modified_toughness == 2\n215\t\n216\t    def test_permanent_effect_not_removed(self) -> None:\n217\t        \"\"\"A DURATION_PERMANENT effect survives cleanup.\"\"\"\n218\t        game, p1, p2 = _make_game()\n219\t        creature = _make_creature(\"Bear\", 2, 2)\n220\t        _place_on_battlefield(game, p1, creature)\n221\t\n222\t        # Add a permanent effect\n223\t        effect = ContinuousEffect(\n224\t            source=creature,\n225\t            layer=Layer.POWER_TOUGHNESS,\n226\t            sublayer=SubLayer.MODIFY_PT,\n227\t            apply=lambda g: setattr(creature, \"modified_power\", creature.base_power + 1)\n228\t            or setattr(creature, \"modified_toughness\", creature.base_toughness + 1),\n229\t            duration=DURATION_PERMANENT,\n230\t        )\n231\t        game.effect_manager.add(effect)\n232\t        game.effect_manager.apply_all(game)\n233\t        assert creature.modified_power == 3\n234\t\n235\t        _do_cleanup_step(game)\n236\t\n237\t        # Permanent effect remains — P/T should still be boosted\n238\t        assert creature.modified_power == 3\n239\t        assert creature.modified_toughness == 3\n240\t\n241\t    def test_multiple_eot_effects_all_removed(self) -> None:\n242\t        \"\"\"Multiple EOT effects are all removed during a single cleanup.\"\"\"\n243\t        game, p1, p2 = _make_game()\n244\t        c1 = _make_creature(\"Bear1\", 2, 2)\n245\t        c2 = _make_creature(\"Bear2\", 3, 3)\n246\t        _place_on_battlefield(game, p1, c1)\n247\t        _place_on_battlefield(game, p1, c2)\n248\t\n249\t        effect1 = ContinuousEffect(\n250\t            source=c1,\n251\t            layer=Layer.POWER_TOUGHNESS,\n252\t            sublayer=SubLayer.MODIFY_PT,\n253\t            apply=lambda g: setattr(c1, \"modified_power\", c1.base_power + 2),\n254\t            duration=DURATION_END_OF_TURN,\n255\t        )\n256\t        effect2 = ContinuousEffect(\n257\t            source=c2,\n258\t            layer=Layer.POWER_TOUGHNESS,\n259\t            sublayer=SubLayer.MODIFY_PT,\n260\t            apply=lambda g: setattr(c2, \"modified_power\", c2.base_power + 2),\n261\t            duration=DURATION_END_OF_TURN,\n262\t        )\n263\t        game.effect_manager.add(effect1)\n264\t        game.effect_manager.add(effect2)\n265\t\n266\t        _do_cleanup_step(game)\n267\t\n268\t        assert c1.modified_power == 2\n269\t        assert c2.modified_power == 3\n270\t\n271\t    def test_effects_reapplied_after_removal(self) -> None:\n272\t        \"\"\"After removing expired effects, remaining effects are reapplied correctly.\"\"\"\n273\t        game, p1, p2 = _make_game()\n274\t        creature = _make_creature(\"Bear\", 2, 2)\n275\t        _place_on_battlefield(game, p1, creature)\n276\t\n277\t        # One permanent effect (+1/+1) and one EOT effect (+3/+3)\n278\t        perm_effect = ContinuousEffect(\n279\t            source=creature,\n280\t            layer=Layer.POWER_TOUGHNESS,\n281\t            sublayer=SubLayer.MODIFY_PT,\n282\t            apply=lambda g: setattr(creature, \"modified_power\", creature.base_power + 1)\n283\t            or setattr(creature, \"modified_toughness\", creature.base_toughness + 1),\n284\t            duration=DURATION_PERMANENT,\n285\t        )\n286\t        eot_effect = ContinuousEffect(\n287\t            source=creature,\n288\t            layer=Layer.POWER_TOUGHNESS,\n289\t            sublayer=SubLayer.MODIFY_PT,\n290\t            apply=lambda g: setattr(creature, \"modified_power\", creature.modified_power + 3)\n291\t            or setattr(creature, \"modified_toughness\", creature.modified_toughness + 3),\n292\t            duration=DURATION_END_OF_TURN,\n293\t        )\n294\t        game.effect_manager.add(perm_effect)\n295\t        game.effect_manager.add(eot_effect)\n296\t\n297\t        _do_cleanup_step(game)\n298\t\n299\t        # Only permanent effect remains: 2 + 1 = 3\n300\t        assert creature.modified_power == 3\n301\t        assert creature.modified_toughness == 3\n302\t\n303\t\n304\t# ===========================================================================\n305\t# Damage clearing\n306\t# ===========================================================================\n307\t\n308\t\n309\tclass TestDamageClearing:\n310\t    \"\"\"Tests for cleanup step 3: clear damage marked on creatures.\"\"\"\n311\t\n312\t    def test_damage_cleared_to_zero(self) -> None:\n313\t        \"\"\"Creature with damage_marked has it cleared to 0 during cleanup.\"\"\"\n314\t        game, p1, p2 = _make_game()\n315\t        creature = _make_creature(\"Bear\", 2, 3)\n316\t        _place_on_battlefield(game, p1, creature)\n317\t        creature.damage_marked = 2\n318\t\n319\t        _do_cleanup_step(game)\n320\t\n321\t        assert creature.damage_marked == 0\n322\t\n323\t    def test_damage_cleared_on_all_players_creatures(self) -> None:\n324\t        \"\"\"Damage is cleared on creatures belonging to ALL players, not just active.\"\"\"\n325\t        game, p1, p2 = _make_game()\n326\t        c1 = _make_creature(\"Bear1\", 2, 3)\n327\t        c2 = _make_creature(\"Bear2\", 2, 4)\n328\t        _place_on_battlefield(game, p1, c1)\n329\t        _place_on_battlefield(game, p2, c2)\n330\t        c1.damage_marked = 2\n331\t        c2.damage_marked = 3\n332\t\n333\t        _do_cleanup_step(game)\n334\t\n335\t        assert c1.damage_marked == 0\n336\t        assert c2.damage_marked == 0\n337\t\n338\t    def test_damage_cleared_creature_survives(self) -> None:\n339\t        \"\"\"A creature with non-lethal damage survives after damage is cleared.\"\"\"\n340\t        game, p1, p2 = _make_game()\n341\t        creature = _make_creature(\"Hill Giant\", 3, 3)\n342\t        _place_on_battlefield(game, p1, creature)\n343\t        creature.damage_marked = 2  # Non-lethal\n344\t\n345\t        _do_cleanup_step(game)\n346\t\n347\t        # Creature should still be on battlefield\n348\t        bf = p1.zones[Zone.BATTLEFIELD]\n349\t        assert bf.contains(creature)\n350\t        assert creature.damage_marked == 0\n351\t\n352\t\n353\t# ===========================================================================\n354\t# Combat flag clearing\n355\t# ===========================================================================\n356\t\n357\t\n358\tclass TestCombatFlagClearing:\n359\t    \"\"\"Tests for cleanup step 4: clear combat-related flags.\"\"\"\n360\t\n361\t    def test_dealt_deathtouch_damage_cleared(self) -> None:\n362\t        \"\"\"dealt_deathtouch_damage is set to False during cleanup.\"\"\"\n363\t        game, p1, p2 = _make_game()\n364\t        creature = _make_creature(\"Bear\", 2, 2)\n365\t        _place_on_battlefield(game, p1, creature)\n366\t        creature.dealt_deathtouch_damage = True\n367\t\n368\t        _do_cleanup_step(game)\n369\t\n370\t        assert creature.dealt_deathtouch_damage is False\n371\t\n372\t    def test_is_attacking_cleared(self) -> None:\n373\t        \"\"\"is_attacking flag is cleared during cleanup.\"\"\"\n374\t        game, p1, p2 = _make_game()\n375\t        creature = _make_creature(\"Bear\", 2, 2)\n376\t        _place_on_battlefield(game, p1, creature)\n377\t        creature.is_attacking = True\n378\t\n379\t        _do_cleanup_step(game)\n380\t\n381\t        assert creature.is_attacking is False\n382\t\n383\t    def test_is_blocking_cleared(self) -> None:\n384\t        \"\"\"is_blocking flag is cleared during cleanup.\"\"\"\n385\t        game, p1, p2 = _make_game()\n386\t        creature = _make_creature(\"Bear\", 2, 2)\n387\t        _place_on_battlefield(game, p2, creature)\n388\t        creature.is_blocking = True\n389\t\n390\t        _do_cleanup_step(game)\n391\t\n392\t        assert creature.is_blocking is False\n393\t\n394\t    def test_combat_state_cleared(self) -> None:\n395\t        \"\"\"CombatState itself is cleared (attackers, was_blocked, in_combat).\"\"\"\n396\t        game, p1, p2 = _make_game()\n397\t        creature = _make_creature(\"Bear\", 2, 2)\n398\t        _place_on_battlefield(game, p1, creature)\n399\t\n400\t        # Simulate active combat state\n401\t        game.combat_state.in_combat = True\n402\t        game.combat_state.attackers[creature] = p2\n403\t        game.combat_state.was_blocked.add(creature)\n404\t\n405\t        _do_cleanup_step(game)\n406\t\n407\t        assert game.combat_state.in_combat is False\n408\t        assert len(game.combat_state.attackers) == 0\n409\t        assert len(game.combat_state.was_blocked) == 0\n410\t\n411\t\n412\t# ===========================================================================\n413\t# Mana pool emptying\n414\t# ===========================================================================\n415\t\n416\t\n417\tclass TestManaPoolEmptying:\n418\t    \"\"\"Tests for cleanup step 5: empty all players' mana pools.\"\"\"\n419\t\n420\t    def test_active_player_mana_emptied(self) -> None:\n421\t        \"\"\"Active player's mana pool is emptied during cleanup.\"\"\"\n422\t        game, p1, p2 = _make_game()\n423\t        p1.mana_pool.add(ManaType.GREEN, 3)\n424\t        p1.mana_pool.add(ManaType.RED, 2)\n425\t\n426\t        _do_cleanup_step(game)\n427\t\n428\t        assert p1.mana_pool.total() == 0\n429\t\n430\t    def test_non_active_player_mana_emptied(self) -> None:\n431\t        \"\"\"Non-active player's mana pool is also emptied during cleanup.\"\"\"\n432\t        game, p1, p2 = _make_game()\n433\t        p2.mana_pool.add(ManaType.BLUE, 5)\n434\t\n435\t        _do_cleanup_step(game)\n436\t\n437\t        assert p2.mana_pool.total() == 0\n438\t\n439\t    def test_all_mana_types_emptied(self) -> None:\n440\t        \"\"\"All mana types (WUBRG + colorless) are emptied.\"\"\"\n441\t        game, p1, p2 = _make_game()\n442\t        p1.mana_pool.add(ManaType.WHITE, 1)\n443\t        p1.mana_pool.add(ManaType.BLUE, 1)\n444\t        p1.mana_pool.add(ManaType.BLACK, 1)\n445\t        p1.mana_pool.add(ManaType.RED, 1)\n446\t        p1.mana_pool.add(ManaType.GREEN, 1)\n447\t        p1.mana_pool.add(ManaType.COLORLESS, 1)\n448\t\n449\t        _do_cleanup_step(game)\n450\t\n451\t        for mt in ManaType:\n452\t            assert p1.mana_pool.get(mt) == 0\n453\t\n454\t\n455\t# ===========================================================================\n456\t# SBA check during cleanup\n457\t# ===========================================================================\n458\t\n459\t\n460\tclass TestSBACheckDuringCleanup:\n461\t    \"\"\"Tests for cleanup step 6: state-based actions are checked.\"\"\"\n462\t\n463\t    def test_creature_dies_after_eot_buff_expires(self) -> None:\n464\t        \"\"\"A creature that only survives due to an EOT buff dies when the buff expires.\n465\t\n466\t        Example: 1/1 creature with Giant Growth (+3/+3 EOT) has taken 3 damage.\n467\t        During cleanup, the buff expires making it a 1/1 with 3 damage → dies via SBA.\n468\t        \"\"\"\n469\t        game, p1, p2 = _make_game()\n470\t        creature = _make_creature(\"Soldier\", 1, 1)\n471\t        _place_on_battlefield(game, p1, creature)\n472\t\n473\t        # Simulate Giant Growth: temporarily make it 4/4\n474\t        effect = ContinuousEffect(\n475\t            source=creature,\n476\t            layer=Layer.POWER_TOUGHNESS,\n477\t            sublayer=SubLayer.MODIFY_PT,\n478\t            apply=lambda g: setattr(creature, \"modified_power\", creature.base_power + 3)\n479\t            or setattr(creature, \"modified_toughness\", creature.base_toughness + 3),\n480\t            duration=DURATION_END_OF_TURN,\n481\t        )\n482\t        game.effect_manager.add(effect)\n483\t        game.effect_manager.apply_all(game)\n484\t        # While buffed, creature takes 3 damage (survivable at 4 toughness)\n485\t        creature.damage_marked = 3\n486\t\n487\t        _do_cleanup_step(game)\n488\t\n489\t        # After cleanup: effect expires → toughness back to 1, but damage is cleared\n490\t        # to 0 in step 3. So actually the creature would survive since damage clears\n491\t        # before SBAs. Let's verify it's on battlefield still.\n492\t        bf = p1.zones[Zone.BATTLEFIELD]\n493\t        # Damage is cleared in step 3 (before SBA check in step 6),\n494\t        # so the creature should survive as a 1/1 with 0 damage.\n495\t        assert bf.contains(creature)\n496\t        assert creature.damage_marked == 0\n497\t        assert creature.modified_power == 1\n498\t        assert creature.modified_toughness == 1\n499\t\n500\t    def test_zero_toughness_creature_dies_after_eot_buff_expires(self) -> None:\n501\t        \"\"\"A creature whose toughness drops to 0 after EOT buff expires dies via SBA.\n502\t\n503\t        A 0/1 base creature with an EOT +0/+2 buff → cleanup removes buff → 0/1 stays.\n504\t        But a creature that has its toughness SET to 0 by buff removal dies.\n505\t        Let's make a -1 toughness scenario: creature has base 2/1 and -1/-1 counter,\n506\t        kept alive by a +0/+1 EOT buff. When buff expires: toughness = 1 - 1 = 0 → dies.\n507\t        \"\"\"\n508\t        game, p1, p2 = _make_game()\n509\t        creature = _make_creature(\"Weakling\", 2, 1)\n510\t        _place_on_battlefield(game, p1, creature)\n511\t        # Give it a -1/-1 counter (would make it 1/0 without help)\n512\t        creature.minus_one_counters = 1\n513\t        creature._base_minus_one_counters = 1\n514\t\n515\t        # EOT buff that gives +0/+1 toughness to keep it alive\n516\t        effect = ContinuousEffect(\n517\t            source=creature,\n518\t            layer=Layer.POWER_TOUGHNESS,\n519\t            sublayer=SubLayer.MODIFY_PT,\n520\t            apply=lambda g: setattr(creature, \"modified_toughness\", creature.base_toughness + 1),\n521\t            duration=DURATION_END_OF_TURN,\n522\t        )\n523\t        game.effect_manager.add(effect)\n524\t        game.effect_manager.apply_all(game)\n525\t        # With buff: toughness = (1+1) - 1 = 1, alive\n526\t        assert creature.toughness == 1\n527\t\n528\t        _do_cleanup_step(game)\n529\t\n530\t        # After cleanup: buff removed → toughness = 1 - 1 = 0 → SBA kills it\n531\t        bf = p1.zones[Zone.BATTLEFIELD]\n532\t        assert not bf.contains(creature)\n533\t        graveyard = p1.zones[Zone.GRAVEYARD]\n534\t        assert graveyard.contains(creature)\n535\t\n536\t\n537\t# ===========================================================================\n538\t# Integration tests\n539\t# ===========================================================================\n540\t\n541\t\n542\tclass TestCleanupIntegration:\n543\t    \"\"\"Integration tests verifying full cleanup behavior with realistic scenarios.\"\"\"\n544\t\n545\t    def test_giant_growth_reverts_after_cleanup(self) -> None:\n546\t        \"\"\"Giant Growth (+3/+3 until EOT) on a 2/2 Bear → cleanup → reverts to 2/2.\n547\t\n548\t        This is the canonical test from the TODO: \"Giant Growth a creature →\n549\t        advance to cleanup → verify P/T reverts.\"\n550\t        \"\"\"\n551\t        game, p1, p2 = _make_game()\n552\t        bear = _make_creature(\"Bear\", 2, 2)\n553\t        _place_on_battlefield(game, p1, bear)\n554\t\n555\t        # Simulate Giant Growth: +3/+3 until end of turn\n556\t        def giant_growth_apply(g):\n557\t            bear.modified_power = bear.base_power + 3\n558\t            bear.modified_toughness = bear.base_toughness + 3\n559\t\n560\t        effect = ContinuousEffect(\n561\t            source=bear,\n562\t            layer=Layer.POWER_TOUGHNESS,\n563\t            sublayer=SubLayer.MODIFY_PT,\n564\t            apply=giant_growth_apply,\n565\t            duration=DURATION_END_OF_TURN,\n566\t        )\n567\t        game.effect_manager.add(effect)\n568\t        game.effect_manager.apply_all(game)\n569\t\n570\t        # Verify the buff is active\n571\t        assert bear.power == 5\n572\t        assert bear.toughness == 5\n573\t\n574\t        _do_cleanup_step(game)\n575\t\n576\t        # After cleanup, the creature should revert to its original stats\n577\t        assert bear.power == 2\n578\t        assert bear.toughness == 2\n579\t\n580\t    def test_damage_on_3_3_cleared_creature_alive(self) -> None:\n581\t        \"\"\"Deal 2 damage to a 3/3 → cleanup → damage cleared, creature alive.\n582\t\n583\t        This is the canonical test from the TODO: \"Deal 2 damage to 3/3 →\n584\t        cleanup → verify damage cleared.\"\n585\t        \"\"\"\n586\t        game, p1, p2 = _make_game()\n587\t        hill_giant = _make_creature(\"Hill Giant\", 3, 3)\n588\t        _place_on_battlefield(game, p1, hill_giant)\n589\t\n590\t        # Simulate taking 2 damage\n591\t        hill_giant.damage_marked = 2\n592\t\n593\t        _do_cleanup_step(game)\n594\t\n595\t        # Creature should be alive with 0 damage\n596\t        bf = p1.zones[Zone.BATTLEFIELD]\n597\t        assert bf.contains(hill_giant)\n598\t        assert hill_giant.damage_marked == 0\n599\t\n600\t    def test_full_cleanup_all_steps_execute(self) -> None:\n601\t        \"\"\"Verify that all cleanup steps execute together in a realistic scenario.\n602\t\n603\t        Scenario: Active player has 8 cards, a creature with damage, mana in pool,\n604\t        creature with combat flags, and an EOT effect.\n605\t        \"\"\"\n606\t        # Create 8 cards in hand for P1\n607\t        cards = [_make_card(f\"Card_{i}\") for i in range(8)]\n608\t        game, p1, p2 = _make_game(p1_script=[cards[0]])\n609\t        for card in cards:\n610\t            _place_in_hand(game, p1, card)\n611\t\n612\t        # Creature with damage and combat flags\n613\t        creature = _make_creature(\"Bear\", 2, 3)\n614\t        _place_on_battlefield(game, p1, creature)\n615\t        creature.damage_marked = 1\n616\t        creature.is_attacking = True\n617\t        creature.dealt_deathtouch_damage = True\n618\t\n619\t        # Mana in pool\n620\t        p1.mana_pool.add(ManaType.GREEN, 3)\n621\t\n622\t        # EOT effect\n623\t        effect = ContinuousEffect(\n624\t            source=creature,\n625\t            layer=Layer.POWER_TOUGHNESS,\n626\t            sublayer=SubLayer.MODIFY_PT,\n627\t            apply=lambda g: setattr(creature, \"modified_power\", creature.base_power + 2),\n628\t            duration=DURATION_END_OF_TURN,\n629\t        )\n630\t        game.effect_manager.add(effect)\n631\t        game.effect_manager.apply_all(game)\n632\t\n633\t        _do_cleanup_step(game)\n634\t\n635\t        # All cleanup effects verified:\n636\t        assert len(p1.zones[Zone.HAND]) == MAX_HAND_SIZE  # Discarded to 7\n637\t        assert creature.damage_marked == 0  # Damage cleared\n638\t        assert creature.is_attacking is False  # Combat flag cleared\n639\t        assert creature.dealt_deathtouch_damage is False  # Deathtouch flag cleared\n640\t        assert p1.mana_pool.total() == 0  # Mana emptied\n641\t        assert creature.modified_power == 2  # EOT effect removed\n642\t\n643\t    def test_max_hand_size_constant_is_7(self) -> None:\n644\t        \"\"\"MAX_HAND_SIZE is defined as 7.\"\"\"\n645\t        assert MAX_HAND_SIZE == 7\n646\t\n647\t\n648\t# ===========================================================================\n649\t# Rule 514.3a — Re-cleanup loop\n650\t# ===========================================================================\n651\t\n652\t\n653\tclass TestReCleanupLoop:\n654\t    \"\"\"Tests for rule 514.3a: if SBAs are performed or triggered abilities\n655\t    fire during cleanup, another cleanup step occurs after resolving.\"\"\"\n656\t\n657\t    def test_sba_during_cleanup_triggers_recleanup(self) -> None:\n658\t        \"\"\"A creature that dies from SBA during cleanup causes a re-cleanup.\n659\t\n660\t        Scenario: A 2/1 creature kept alive by an EOT +0/+1 buff.\n661\t        When cleanup removes the buff, toughness drops to 1 and the creature\n662\t        has a -1/-1 counter → effective toughness 0 → SBA kills it.\n663\t        The re-cleanup should then clear damage on remaining creatures, etc.\n664\t\n665\t        We verify the SBA fires (creature goes to graveyard) AND that\n666\t        the re-cleanup properly clears damage on a *second* creature that\n667\t        only exists to prove the second cleanup pass ran.\n668\t        \"\"\"\n669\t        game, p1, p2 = _make_game()\n670\t\n671\t        # Creature #1: 2/1 with -1/-1 counter, kept alive by EOT +0/+1\n672\t        doomed = _make_creature(\"Doomed\", 2, 1)\n673\t        _place_on_battlefield(game, p1, doomed)\n674\t        doomed.minus_one_counters = 1\n675\t        doomed._base_minus_one_counters = 1\n676\t\n677\t        effect = ContinuousEffect(\n678\t            source=doomed,\n679\t            layer=Layer.POWER_TOUGHNESS,\n680\t            sublayer=SubLayer.MODIFY_PT,\n681\t            apply=lambda g: setattr(doomed, \"modified_toughness\", doomed.base_toughness + 1),\n682\t            duration=DURATION_END_OF_TURN,\n683\t        )\n684\t        game.effect_manager.add(effect)\n685\t        game.effect_manager.apply_all(game)\n686\t        assert doomed.toughness == 1  # (1+1) - 1 = 1, alive\n687\t\n688\t        # Creature #2: survives first cleanup, gets damage marked.\n689\t        # The first cleanup clears its damage, but the SBA from doomed dying\n690\t        # triggers a second cleanup. We mark damage on survivor *after*\n691\t        # the first cleanup's step 3 by using a trick: we mark damage high\n692\t        # enough that it wouldn't survive without the second cleanup clearing it.\n693\t        # Actually, simpler approach: verify that the second cleanup occurred\n694\t        # by checking that mana added *during* cleanup processing gets cleared.\n695\t        survivor = _make_creature(\"Survivor\", 3, 3)\n696\t        _place_on_battlefield(game, p1, survivor)\n697\t        survivor.damage_marked = 1  # Non-lethal\n698\t\n699\t        _do_cleanup_step(game)\n700\t\n701\t        # Doomed creature should be dead (SBA from toughness 0)\n702\t        assert not p1.zones[Zone.BATTLEFIELD].contains(doomed)\n703\t        assert p1.zones[Zone.GRAVEYARD].contains(doomed)\n704\t\n705\t        # Survivor should still be alive with damage cleared\n706\t        assert p1.zones[Zone.BATTLEFIELD].contains(survivor)\n707\t        assert survivor.damage_marked == 0\n708\t\n709\t    def test_stack_trigger_during_cleanup_causes_recleanup(self) -> None:\n710\t        \"\"\"If something is on the stack during cleanup, priority_loop is called\n711\t        and then another cleanup step occurs.\n712\t\n713\t        We manually push an item onto the stack before cleanup to simulate\n714\t        a triggered ability. The priority_loop should resolve it, and then\n715\t        a second cleanup should run (clearing mana, damage, etc. again).\n716\t        \"\"\"\n717\t        from engine.stack import StackObject\n718\t\n719\t        game, p1, p2 = _make_game()\n720\t        resolved = []\n721\t\n722\t        # Push a triggered ability onto the stack that records its resolution\n723\t        trigger = StackObject(\n724\t            source=None,\n725\t            controller=p1,\n726\t            on_resolve=lambda g: resolved.append(\"trigger_resolved\"),\n727\t        )\n728\t        game.stack.push(trigger)\n729\t\n730\t        # Both players need to pass priority for the stack to resolve.\n731\t        # P1 passes, P2 passes → trigger resolves.\n732\t        p1._script.extend([\"pass\"])\n733\t        p2._script.extend([\"pass\"])\n734\t\n735\t        # Place a creature with damage to verify re-cleanup clears it\n736\t        creature = _make_creature(\"Bear\", 2, 3)\n737\t        _place_on_battlefield(game, p1, creature)\n738\t        creature.damage_marked = 1\n739\t\n740\t        _do_cleanup_step(game)\n741\t\n742\t        # Trigger should have been resolved\n743\t        assert \"trigger_resolved\" in resolved\n744\t\n745\t        # Re-cleanup should have cleared damage again\n746\t        assert creature.damage_marked == 0\n747\t\n748\t    def test_no_recleanup_when_no_sba_and_empty_stack(self) -> None:\n749\t        \"\"\"When cleanup doesn't trigger SBAs and the stack is empty,\n750\t        no extra cleanup step occurs (no infinite loop).\"\"\"\n751\t        game, p1, p2 = _make_game()\n752\t        creature = _make_creature(\"Bear\", 2, 3)\n753\t        _place_on_battlefield(game, p1, creature)\n754\t        creature.damage_marked = 1\n755\t\n756\t        # This should complete without hanging (no infinite recursion)\n757\t        _do_cleanup_step(game)\n758\t\n759\t        assert creature.damage_marked == 0\n760\t        assert p1.zones[Zone.BATTLEFIELD].contains(creature)\n761\t\n762\t\n763\t# ===========================================================================\n764\t# DeterministicPlayer discard fallback\n765\t# ===========================================================================\n766\t\n767\t\n768\tclass TestDeterministicPlayerDiscard:\n769\t    \"\"\"Tests verifying that cleanup discard works when DeterministicPlayer's\n770\t    script is exhausted — the fallback should discard from the end of hand.\"\"\"\n771\t\n772\t    def test_discard_without_script_falls_back_to_last_card(self) -> None:\n773\t        \"\"\"Player with 9 cards and NO scripted choices still discards to 7.\n774\t\n775\t        When choose_card raises ScriptExhaustedError, the cleanup code\n776\t        falls back to discarding the last card in hand deterministically.\n777\t        \"\"\"\n778\t        cards = [_make_card(f\"Card_{i}\") for i in range(9)]\n779\t        # Empty script — choose_card will raise ScriptExhaustedError\n780\t        game, p1, p2 = _make_game(p1_script=[])\n781\t        for card in cards:\n782\t            _place_in_hand(game, p1, card)\n783\t\n784\t        _do_cleanup_step(game)\n785\t\n786\t        assert len(p1.zones[Zone.HAND]) == MAX_HAND_SIZE\n787\t\n788\t    def test_discard_fallback_sends_cards_to_graveyard(self) -> None:\n789\t        \"\"\"Deterministic fallback discards go to graveyard, not lost.\"\"\"\n790\t        cards = [_make_card(f\"Card_{i}\") for i in range(9)]\n791\t        game, p1, p2 = _make_game(p1_script=[])\n792\t        for card in cards:\n793\t            _place_in_hand(game, p1, card)\n794\t\n795\t        _do_cleanup_step(game)\n796\t\n797\t        # 2 cards should be in graveyard (9 - 7 = 2)\n798\t        assert len(p1.zones[Zone.GRAVEYARD]) == 2\n799\t\n800\t    def test_discard_partial_script_then_fallback(self) -> None:\n801\t        \"\"\"Player with 10 cards and only 1 scripted choice: first discard uses\n802\t        the script, remaining 2 use the deterministic fallback.\"\"\"\n803\t        cards = [_make_card(f\"Card_{i}\") for i in range(10)]\n804\t        # Script has only 1 choice (for the first discard)\n805\t        game, p1, p2 = _make_game(p1_script=[cards[0]])\n806\t        for card in cards:\n807\t            _place_in_hand(game, p1, card)\n808\t\n809\t        _do_cleanup_step(game)\n810\t\n811\t        # Should still end up at 7 cards\n812\t        assert len(p1.zones[Zone.HAND]) == MAX_HAND_SIZE\n813\t        # The scripted choice (cards[0]) should be in graveyard\n814\t        assert p1.zones[Zone.GRAVEYARD].contains(cards[0])\n815\t        # Total discards = 3\n816\t        assert len(p1.zones[Zone.GRAVEYARD]) == 3\n817\t\n818\t    def test_discard_large_hand_without_script(self) -> None:\n819\t        \"\"\"Player with 15 cards and no script discards 8 cards to reach 7.\"\"\"\n820\t        cards = [_make_card(f\"Card_{i}\") for i in range(15)]\n821\t        game, p1, p2 = _make_game(p1_script=[])\n822\t        for card in cards:\n823\t            _place_in_hand(game, p1, card)\n824\t\n825\t        _do_cleanup_step(game)\n826\t\n827\t        assert len(p1.zones[Zone.HAND]) == MAX_HAND_SIZE\n828\t        assert len(p1.zones[Zone.GRAVEYARD]) == 8\n829\t\n830\t\n831\t# ===========================================================================\n832\t# Edge cases\n833\t# ===========================================================================\n834\t\n835\t\n836\tclass TestCleanupEdgeCases:\n837\t    \"\"\"Edge case tests for cleanup step.\"\"\"\n838\t\n839\t    def test_no_creatures_on_battlefield(self) -> None:\n840\t        \"\"\"Cleanup succeeds when no creatures are on the battlefield.\n841\t\n842\t        Damage clearing is a no-op, combat flag clearing is a no-op,\n843\t        SBA check finds nothing. Verify no errors and mana is still cleared.\n844\t        \"\"\"\n845\t        game, p1, p2 = _make_game()\n846\t        # No creatures — just mana to empty\n847\t        p1.mana_pool.add(ManaType.RED, 2)\n848\t\n849\t        _do_cleanup_step(game)\n850\t\n851\t        assert p1.mana_pool.total() == 0\n852\t        assert len(p1.zones[Zone.BATTLEFIELD]) == 0\n853\t\n854\t    def test_mana_pool_already_empty(self) -> None:\n855\t        \"\"\"Cleanup succeeds when all mana pools are already empty.\"\"\"\n856\t        game, p1, p2 = _make_game()\n857\t        # Mana pools are empty by default\n858\t        assert p1.mana_pool.total() == 0\n859\t        assert p2.mana_pool.total() == 0\n860\t\n861\t        _do_cleanup_step(game)\n862\t\n863\t        assert p1.mana_pool.total() == 0\n864\t        assert p2.mana_pool.total() == 0\n865\t\n866\t    def test_empty_battlefield_and_empty_hand(self) -> None:\n867\t        \"\"\"Cleanup works with completely empty board state — no creatures,\n868\t        no cards in hand, no mana, nothing to discard.\"\"\"\n869\t        game, p1, p2 = _make_game()\n870\t\n871\t        _do_cleanup_step(game)\n872\t\n873\t        assert len(p1.zones[Zone.HAND]) == 0\n874\t        assert len(p1.zones[Zone.BATTLEFIELD]) == 0\n875\t        assert p1.mana_pool.total() == 0\n876\t\n877\t    def test_zero_cards_in_hand_no_discard(self) -> None:\n878\t        \"\"\"Player with 0 cards in hand: discard step is a no-op.\"\"\"\n879\t        game, p1, p2 = _make_game()\n880\t        assert len(p1.zones[Zone.HAND]) == 0\n881\t\n882\t        _do_cleanup_step(game)\n883\t\n884\t        assert len(p1.zones[Zone.HAND]) == 0\n885\t        assert len(p1.zones[Zone.GRAVEYARD]) == 0\n886\t\n887\t    def test_non_creature_permanent_damage_attr_cleared(self) -> None:\n888\t        \"\"\"If a non-creature permanent somehow has damage_marked, it's still cleared.\n889\t\n890\t        The cleanup code iterates all battlefield objects with damage_marked,\n891\t        not just creatures.\n892\t        \"\"\"\n893\t        game, p1, p2 = _make_game()\n894\t        artifact = _make_card(\"Artifact\")\n895\t        artifact.damage_marked = 5  # Unusual but possible\n896\t        _place_on_battlefield(game, p1, artifact)\n897\t\n898\t        _do_cleanup_step(game)\n899\t\n900\t        assert artifact.damage_marked == 0\n901\t"}]},"parent_tool_use_id":"toolu_01YLHhg3L6wmRAMxiCoeYbvX","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"5037ce55-7058-4ca0-ac1e-49793cc5ad1e","timestamp":"2026-06-01T12:18:33.519Z","subagent_type":"Tester","task_description":"Extend tests for sos_257"}
