{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_015vsVwyYbQ82pNi5NV34KJy","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01SwKL1vL5vZu6e6U1UA3ssY","name":"Read","input":{"file_path":"/workspace/engine/stack.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16130,"cache_read_input_tokens":12787,"cache_creation":{"ephemeral_5m_input_tokens":16130,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01NGPgShq7ufcrA89j3njWbF","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"a1f9efc8-917c-4994-81b3-acbd0c48bf2f","request_id":"req_011CbcW7eTRpFz46W6S6ws5X","subagent_type":"Tester","task_description":"Extend tests for sos_226"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SwKL1vL5vZu6e6U1UA3ssY","type":"tool_result","content":"1\t\"\"\"The spell/ability stack with LIFO resolution and priority passing.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport copy\n6\tfrom dataclasses import dataclass, field\n7\tfrom typing import TYPE_CHECKING, Any, Callable\n8\t\n9\tif TYPE_CHECKING:\n10\t    from engine.game_state import GameState\n11\t    from engine.player import Player\n12\t\n13\t\n14\t@dataclass\n15\tclass StackObject:\n16\t    \"\"\"An object on the stack representing a spell or ability.\n17\t\n18\t    Attributes:\n19\t        source: The card or ability that created this stack object.\n20\t        controller: The player who controls this stack object.\n21\t        targets: The chosen targets for the spell/ability.\n22\t        on_resolve: Callback invoked when this object resolves.\n23\t        is_mana_ability: Whether this is a mana ability (resolves immediately).\n24\t    \"\"\"\n25\t\n26\t    source: Any\n27\t    controller: Player\n28\t    targets: list[Any] = field(default_factory=list)\n29\t    on_resolve: Callable[[GameState], None] = field(default=lambda _game: None)\n30\t    is_mana_ability: bool = False\n31\t\n32\t\n33\tclass Stack:\n34\t    \"\"\"The game stack — a LIFO structure for spells and abilities.\n35\t\n36\t    The internal list stores objects with the last element being the top\n37\t    of the stack (most recently pushed).\n38\t    \"\"\"\n39\t\n40\t    def __init__(self) -> None:\n41\t        self._items: list[StackObject] = []\n42\t\n43\t    def push(self, obj: StackObject) -> None:\n44\t        \"\"\"Push *obj* onto the top of the stack.\"\"\"\n45\t        self._items.append(obj)\n46\t\n47\t    def pop(self) -> StackObject:\n48\t        \"\"\"Remove and return the top object from the stack.\n49\t\n50\t        Raises:\n51\t            IndexError: If the stack is empty.\n52\t        \"\"\"\n53\t        return self._items.pop()\n54\t\n55\t    def peek(self) -> StackObject | None:\n56\t        \"\"\"Return the top object without removing it, or ``None`` if empty.\"\"\"\n57\t        return self._items[-1] if self._items else None\n58\t\n59\t    def __len__(self) -> int:\n60\t        \"\"\"Return the number of objects on the stack.\"\"\"\n61\t        return len(self._items)\n62\t\n63\t    def is_empty(self) -> bool:\n64\t        \"\"\"Return ``True`` if the stack contains no objects.\"\"\"\n65\t        return len(self._items) == 0\n66\t\n67\t    def objects(self) -> list[StackObject]:\n68\t        \"\"\"Return all stack objects ordered from top to bottom.\"\"\"\n69\t        return list(reversed(self._items))\n70\t\n71\t\n72\tdef copy_spell(\n73\t    game: GameState,\n74\t    original: StackObject,\n75\t    controller: Player,\n76\t    new_targets: list[Any] | None = None,\n77\t) -> StackObject:\n78\t    \"\"\"Create a copy of a spell on the stack (for storm and similar effects).\n79\t\n80\t    Shallow-copies the source card so the copy has independent state\n81\t    (chosen_targets, etc.) while sharing class method bindings.  Binds\n82\t    on_resolve to call the copied card's on_resolve directly — no zone\n83\t    movement, which is correct for spell copies.\n84\t\n85\t    Args:\n86\t        game: The current game state.\n87\t        original: The StackObject being copied.\n88\t        controller: The player who controls the copy.\n89\t        new_targets: Optional replacement targets.  If ``None``, the\n90\t            original's target list is cloned.\n91\t\n92\t    Returns:\n93\t        A new StackObject representing the copy ready to be pushed.\n94\t    \"\"\"\n95\t    copied_card = copy.copy(original.source)\n96\t    copied_card.controller = controller\n97\t    copied_card.owner = getattr(original.source, \"owner\", controller)\n98\t\n99\t    targets = new_targets if new_targets is not None else list(original.targets)\n100\t\n101\t    copy_obj = StackObject(\n102\t        source=copied_card,\n103\t        controller=controller,\n104\t        targets=targets,\n105\t    )\n106\t\n107\t    def _copy_resolve(g: GameState) -> None:\n108\t        copied_card.chosen_targets = copy_obj.targets\n109\t        copied_card.on_resolve(g)\n110\t\n111\t    copy_obj.on_resolve = _copy_resolve\n112\t    return copy_obj\n113\t\n114\t\n115\tdef check_state_based_actions(game: GameState) -> None:\n116\t    \"\"\"Check and perform all state-based actions until the game state is stable.\n117\t\n118\t    This is a convenience wrapper around\n119\t    :func:`engine.state_based_actions.resolve_state_based_actions` that\n120\t    maintains the original ``-> None`` call-site contract used by\n121\t    :func:`priority_loop`.  For the single-pass boolean API, import\n122\t    :func:`~engine.state_based_actions.check_state_based_actions` directly\n123\t    from :mod:`engine.state_based_actions`.\n124\t    \"\"\"\n125\t    from engine.state_based_actions import resolve_state_based_actions\n126\t\n127\t    resolve_state_based_actions(game)\n128\t\n129\t\n130\tdef _get_legal_actions(game: GameState, player: Player) -> list[Any]:\n131\t    \"\"\"Return the legal actions available to *player*.\n132\t\n133\t    Placeholder — returns an empty list until spells/abilities are\n134\t    implemented in later items.\n135\t    \"\"\"\n136\t    return []\n137\t\n138\t\n139\tdef _handle_priority(game: GameState, player: Player) -> bool:\n140\t    \"\"\"Give priority to *player* and let them act or pass.\n141\t\n142\t    Returns ``True`` if the player passed priority, ``False`` if they\n143\t    took an action (in which case the priority loop restarts).\n144\t\n145\t    When the stack is non-empty, the player is always asked via\n146\t    :meth:`Player.choose` so they can respond.  When the stack is empty\n147\t    and no legal actions exist, the player auto-passes.\n148\t    \"\"\"\n149\t    actions = _get_legal_actions(game, player)\n150\t\n151\t    # Auto-pass when there is nothing to respond to and no actions.\n152\t    if not actions and game.stack.is_empty():\n153\t        return True\n154\t\n155\t    options = actions + [\"pass\"]\n156\t    choice = player.choose(options, \"priority: choose action or pass\")\n157\t\n158\t    if choice == \"pass\":\n159\t        return True\n160\t\n161\t    # Mana abilities resolve immediately without using the stack.\n162\t    if isinstance(choice, StackObject) and choice.is_mana_ability:\n163\t        choice.on_resolve(game)\n164\t        return False\n165\t\n166\t    # Regular spell / ability — push onto the stack.\n167\t    if isinstance(choice, StackObject):\n168\t        game.stack.push(choice)\n169\t\n170\t    return False\n171\t\n172\t\n173\tdef priority_loop(game: GameState) -> None:\n174\t    \"\"\"Run the priority-passing loop for the current phase/step.\n175\t\n176\t    Flow\n177\t    ----\n178\t    1. Active player gets priority.  They may play spells/abilities\n179\t       (pushed to stack) or pass.\n180\t    2. When a player takes an action they **retain** priority (MTG rule:\n181\t       the player who just acted gets to respond first).\n182\t    3. When a player passes, priority moves to the other player.\n183\t    4. If both players pass in succession with the stack **non-empty**,\n184\t       the top of the stack is resolved (``pop`` → ``on_resolve(game)``),\n185\t       state-based actions are checked, and the active player receives\n186\t       priority again.\n187\t    5. If both players pass with the stack **empty**, return (the game\n188\t       advances to the next phase/step).\n189\t\n190\t    ``game.priority_player_index`` is kept in sync throughout so that\n191\t    :pyattr:`GameState.priority_player` always reflects who currently\n192\t    holds priority.\n193\t\n194\t    Player decisions come from :meth:`Player.choose`.  When no legal\n195\t    actions exist and the stack is empty, the player auto-passes without\n196\t    being asked.\n197\t    \"\"\"\n198\t    while True:\n199\t        # Active player receives priority at the start of each\n200\t        # resolution round.\n201\t        current_index = game.active_player_index\n202\t        game.priority_player_index = current_index\n203\t        consecutive_passes = 0\n204\t\n205\t        while consecutive_passes < 2:\n206\t            player = game.players[current_index]\n207\t            game.priority_player_index = current_index\n208\t\n209\t            passed = _handle_priority(game, player)\n210\t\n211\t            if passed:\n212\t                consecutive_passes += 1\n213\t                # Priority moves to the other player.\n214\t                current_index = 1 - current_index\n215\t            else:\n216\t                # Player took an action — they retain priority.\n217\t                consecutive_passes = 0\n218\t\n219\t        # Both players passed consecutively.\n220\t        if game.stack.is_empty():\n221\t            return  # Advance to next phase/step\n222\t\n223\t        # Resolve top of stack (LIFO).\n224\t        obj = game.stack.pop()\n225\t        obj.on_resolve(game)\n226\t        check_state_based_actions(game)\n227\t        # Active player receives priority again — outer loop continues.\n228\t"}]},"parent_tool_use_id":"toolu_01NGPgShq7ufcrA89j3njWbF","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"b189e641-38df-4e87-be79-d28ff948f4eb","timestamp":"2026-06-01T12:00:13.676Z","subagent_type":"Tester","task_description":"Extend tests for sos_226"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X7Rq2KoZ2e3fJFynRjXGeC","type":"tool_result","content":"1\t\"\"\"Casting and resolution pipeline for spells and lands.\n2\t\n3\tProvides the full flow from casting a spell or playing a land through\n4\tresolution:\n5\t\n6\t- :func:`cast_spell` — verify timing & legality → move hand to stack →\n7\t  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n8\t- :func:`play_land` — verify land play remaining → move hand to\n9\t  battlefield → decrement ``land_plays_remaining``.\n10\t- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n11\t  helpers used by the casting pipeline.\n12\t\n13\tResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\n14\tcreated by :func:`cast_spell`:\n15\t\n16\t- Call ``card.on_resolve(game)``.\n17\t- Permanents (creature / enchantment / artifact / planeswalker) move from\n18\t  the stack to the battlefield.\n19\t- Non-permanents (instant / sorcery) move to the graveyard.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import TYPE_CHECKING, Any\n25\t\n26\tfrom engine.card import CardImpl\n27\tfrom engine.stack import StackObject\n28\tfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\n29\tfrom engine.zones import move_zone\n30\t\n31\tif TYPE_CHECKING:\n32\t    from engine.game_state import GameState\n33\t    from engine.player import Player\n34\t\n35\t\n36\t# Card types that represent permanents — these go to the battlefield on resolve.\n37\t_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n38\t    CardType.CREATURE,\n39\t    CardType.ENCHANTMENT,\n40\t    CardType.ARTIFACT,\n41\t    CardType.PLANESWALKER,\n42\t})\n43\t\n44\t\n45\tclass CastingError(Exception):\n46\t    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n47\t\n48\t\n49\t# ------------------------------------------------------------------\n50\t# Timing helpers\n51\t# ------------------------------------------------------------------\n52\t\n53\tdef is_sorcery_speed(game: GameState, player: Player) -> bool:\n54\t    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n55\t\n56\t    Sorcery speed requires all of:\n57\t\n58\t    * *player* is the active player.\n59\t    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n60\t      ``POSTCOMBAT_MAIN``).\n61\t    * The stack is empty.\n62\t    \"\"\"\n63\t    if player is not game.active_player:\n64\t        return False\n65\t    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n66\t        return False\n67\t    if not game.stack.is_empty():\n68\t        return False\n69\t    return True\n70\t\n71\t\n72\tdef can_cast_at_instant_speed(card: CardImpl) -> bool:\n73\t    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n74\t\n75\t    A card has instant-speed timing if it is an instant or has the\n76\t    :attr:`~engine.types.Keyword.FLASH` keyword.\n77\t    \"\"\"\n78\t    if CardType.INSTANT in card.card_types:\n79\t        return True\n80\t    if Keyword.FLASH & card.keywords:\n81\t        return True\n82\t    return False\n83\t\n84\t\n85\t# ------------------------------------------------------------------\n86\t# Cost reduction\n87\t# ------------------------------------------------------------------\n88\t\n89\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n90\t    \"\"\"Return the generic mana reduction for casting *card*.\n91\t\n92\t    Queries ``card.cost_reduction(game)`` and clamps the result so that\n93\t    the generic portion of the mana cost cannot go below 0.\n94\t\n95\t    This is a simplified single-card self-reduction model.  Full MTG\n96\t    cost-reduction interactions (Trinisphere, multiple reductions from\n97\t    different sources) are deferred.\n98\t    \"\"\"\n99\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n100\t    # casting player even when the card was never explicitly assigned one.\n101\t    prev_controller = card.controller\n102\t    card.controller = controller\n103\t    raw = card.cost_reduction(game)\n104\t    # Restore previous controller in case the caller doesn't want a\n105\t    # side-effect (get_cost_reduction is a query, not a mutation).\n106\t    card.controller = prev_controller\n107\t    generic = card.mana_cost.generic if card.mana_cost else 0\n108\t    return max(0, min(raw, generic))\n109\t\n110\t\n111\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n112\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n113\t    new_generic = max(0, cost.generic - reduction)\n114\t    return ManaCost(\n115\t        generic=new_generic,\n116\t        pips=dict(cost.pips),\n117\t        x_count=cost.x_count,\n118\t        hybrid=list(cost.hybrid),\n119\t    )\n120\t\n121\t\n122\t# ------------------------------------------------------------------\n123\t# Cast spell\n124\t# ------------------------------------------------------------------\n125\t\n126\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n127\t    \"\"\"Cast *card* from *player*'s hand.\n128\t\n129\t    Pipeline\n130\t    --------\n131\t    1. **Timing check** — instants (and cards with flash) can be cast\n132\t       whenever the player has priority; everything else requires\n133\t       sorcery-speed timing.\n134\t    2. **can_cast** — ask the card whether it can legally be cast.\n135\t    3. **Hand check** — the card must be in the player's hand.\n136\t    4. **Move hand → stack zone** — remove the card from the hand and\n137\t       place it into the player's stack zone.\n138\t    5. **Choose targets** — if the card specifies targets (via\n139\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n140\t    6. **Mana check / payment** — the player's mana pool must be able to\n141\t       pay the card's mana cost.  If payment fails, the card is rolled\n142\t       back from the stack zone to the hand.\n143\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n144\t    8. **Push StackObject** — push a :class:`StackObject` whose\n145\t       ``on_resolve`` callback handles resolution.\n146\t\n147\t    Raises:\n148\t        CastingError: If any legality check fails.\n149\t    \"\"\"\n150\t    # 1. Timing\n151\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n152\t        raise CastingError(\n153\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n154\t        )\n155\t\n156\t    # 2. can_cast\n157\t    if not card.can_cast(game):\n158\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n159\t\n160\t    # 3. Hand check\n161\t    hand = game.get_hand(player)\n162\t    if not hand.contains(card):\n163\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n164\t\n165\t    # 4. Move card from hand to stack zone\n166\t    stack_zone = player.zones[Zone.STACK]\n167\t    hand.remove(card)\n168\t    stack_zone.add(card)\n169\t\n170\t    # Clear any stale colors_spent from a prior cast before new payment.\n171\t    if hasattr(card, \"colors_spent\"):\n172\t        del card.colors_spent\n173\t\n174\t    # 5. Choose targets\n175\t    target_specs = card.get_targets(game)\n176\t    chosen_targets: list[Any] = []\n177\t    if target_specs:\n178\t        for spec in target_specs:\n179\t            target = player.choose_target(target_specs, spec)\n180\t            # Validate against filter_fn if the spec provides one\n181\t            filter_fn = getattr(spec, \"filter_fn\", None)\n182\t            if filter_fn is not None and target is not None:\n183\t                if not filter_fn(target):\n184\t                    stack_zone.remove(card)\n185\t                    hand.add(card)\n186\t                    raise CastingError(\n187\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n188\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n189\t                    )\n190\t            chosen_targets.append(target)\n191\t\n192\t    # 5b. Protection check — reject targets that have protection from this\n193\t    #     spell (the T in DEBT).\n194\t    from engine.protection import has_protection_from\n195\t\n196\t    for target in chosen_targets:\n197\t        if has_protection_from(target, card):\n198\t            # Rollback: move card from stack zone back to hand\n199\t            stack_zone.remove(card)\n200\t            hand.add(card)\n201\t            raise CastingError(\n202\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n203\t            )\n204\t\n205\t    # Targets are stored on the StackObject (not the card) and passed\n206\t    # through the resolve pipeline via on_resolve(game, targets=...).\n207\t\n208\t    # 6. Mana check / payment (rollback on failure)\n209\t    # Ensure the card knows its controller so that cost_reduction() hooks\n210\t    # (e.g. Embercleave counting attacking creatures you control) see the\n211\t    # casting player, even for cards that were added to hand without an\n212\t    # explicit controller assignment.\n213\t    if card.controller is None:\n214\t        card.controller = player\n215\t    reduction = get_cost_reduction(game, card, player)\n216\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n217\t\n218\t    if not player.mana_pool.can_pay(effective_cost):\n219\t        # Rollback: move card from stack zone back to hand\n220\t        stack_zone.remove(card)\n221\t        hand.add(card)\n222\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n223\t\n224\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n225\t    player.mana_pool.pay(effective_cost)\n226\t\n227\t    # Store colors of mana spent on the card for mechanics like Converge\n228\t    # that care about the colors used to cast the spell.\n229\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n230\t\n231\t    # Record the TOTAL amount of mana spent to cast this spell (rule 107.7).\n232\t    # Unlike the printed mana value, this reflects actual mana paid, so X\n233\t    # spells / cost-reduced spells diverge from CMC.  Effects such as Mana\n234\t    # Sculpt read this at resolution.\n235\t    card.mana_spent = player.mana_pool.last_payment_total  # type: ignore[attr-defined]\n236\t\n237\t    # 7. Call on_cast hook\n238\t    card.on_cast(game)\n239\t\n240\t    # 8. Build on_resolve callback and push StackObject\n241\t    stack_obj = StackObject(\n242\t        source=card,\n243\t        controller=player,\n244\t        targets=chosen_targets,\n245\t        on_resolve=lambda g: None,  # replaced below\n246\t    )\n247\t\n248\t    def _on_resolve(g: GameState) -> None:\n249\t        _resolve_spell(g, card, player, stack_obj)\n250\t\n251\t    stack_obj.on_resolve = _on_resolve\n252\t    game.stack.push(stack_obj)\n253\t\n254\t    # Fire the \"when you cast this spell\" event so cast-time grants (casualty\n255\t    # and other \"whenever you cast ...\" triggers) can observe a real cast.\n256\t    # The spell is already on the stack, matching MTG timing where such\n257\t    # triggers are put on the stack above the spell that caused them.\n258\t    _fire_spell_cast_event(game, player, card)\n259\t\n260\t\n261\tdef _fire_spell_cast_event(game: GameState, player: Player, card: CardImpl) -> None:\n262\t    \"\"\"Fire :class:`~engine.events.SpellCastTriggeredEvent` for a cast spell.\n263\t\n264\t    Additive hook used by the casting pipeline so \"whenever you cast a(n)\n265\t    instant/sorcery spell\" and casualty-style cast-time grants can trigger.\n266\t    Safe no-op if the game has no ``trigger_manager``.\n267\t    \"\"\"\n268\t    trigger_manager = getattr(game, \"trigger_manager\", None)\n269\t    if trigger_manager is None:\n270\t        return\n271\t    from engine.events import SpellCastTriggeredEvent\n272\t\n273\t    trigger_manager.fire_event(\n274\t        game,\n275\t        SpellCastTriggeredEvent(\n276\t            spell=card, player=player, card=card, controller=player\n277\t        ),\n278\t    )\n279\t\n280\t\n281\t# ------------------------------------------------------------------\n282\t# Cast spell without paying mana cost (free-cast from any zone)\n283\t# ------------------------------------------------------------------\n284\t\n285\t\n286\tdef cast_spell_free(\n287\t    game: GameState,\n288\t    player: Player,\n289\t    card: CardImpl,\n290\t    from_zone: Zone,\n291\t) -> None:\n292\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n293\t\n294\t    This is used by effects that allow casting from zones other than hand\n295\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n296\t    or cascade.\n297\t\n298\t    Pipeline\n299\t    --------\n300\t    1. **can_cast** — ask the card whether it can legally be cast (same\n301\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n302\t    2. Move *card* from *from_zone* to the stack zone.\n303\t    3. Choose targets (if applicable) with validation and protection check.\n304\t    4. Call ``on_cast`` hook.\n305\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n306\t       resolution normally (permanents → battlefield, non-permanents →\n307\t       graveyard).\n308\t\n309\t    No timing check or mana payment is performed.  The spell goes on the\n310\t    stack and can be responded to normally (e.g. countered).\n311\t\n312\t    If targeting or other post-move checks fail, the card is rolled back\n313\t    to its source zone.\n314\t\n315\t    Parameters:\n316\t        game: The current game state.\n317\t        player: The player casting the spell.\n318\t        card: The card to cast.\n319\t        from_zone: The zone the card is currently in.\n320\t\n321\t    Raises:\n322\t        CastingError: If the card cannot be found in *from_zone* or\n323\t            legality checks fail.\n324\t    \"\"\"\n325\t    from engine.zones import move_to_zone\n326\t\n327\t    # Ensure controller is set\n328\t    card.controller = player\n329\t    if card.owner is None:\n330\t        card.owner = player\n331\t\n332\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n333\t    if not card.can_cast(game):\n334\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n335\t\n336\t    # 2. Locate card in source zone\n337\t    source_zone_container = player.zones[from_zone]\n338\t    if not source_zone_container.contains(card):\n339\t        # Try to find the card in any player's zone\n340\t        source_zone_container = None\n341\t        for p in game.players:\n342\t            z = p.zones[from_zone]\n343\t            if z.contains(card):\n344\t                source_zone_container = z\n345\t                break\n346\t\n347\t    if source_zone_container is None or not source_zone_container.contains(card):\n348\t        raise CastingError(\n349\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n350\t        )\n351\t\n352\t    # Move card from source zone to stack zone\n353\t    stack_zone = player.zones[Zone.STACK]\n354\t    source_zone_container.remove(card)\n355\t    stack_zone.add(card)\n356\t\n357\t    # 3. Choose targets (with rollback on failure)\n358\t    try:\n359\t        target_specs = card.get_targets(game)\n360\t        chosen_targets: list[Any] = []\n361\t        if target_specs:\n362\t            for spec in target_specs:\n363\t                target = player.choose_target(target_specs, spec)\n364\t                # Validate against filter_fn if the spec provides one\n365\t                filter_fn = getattr(spec, \"filter_fn\", None)\n366\t                if filter_fn is not None and target is not None:\n367\t                    if not filter_fn(target):\n368\t                        raise CastingError(\n369\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n370\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n371\t                        )\n372\t                chosen_targets.append(target)\n373\t\n374\t        # Protection check — reject targets that have protection from this spell\n375\t        from engine.protection import has_protection_from\n376\t\n377\t        for target in chosen_targets:\n378\t            if has_protection_from(target, card):\n379\t                raise CastingError(\n380\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n381\t                )\n382\t    except Exception as exc:\n383\t        # Rollback: move card from stack zone back to source zone\n384\t        stack_zone.remove(card)\n385\t        source_zone_container.add(card)\n386\t        raise CastingError(str(exc)) from exc\n387\t\n388\t    # 4. Call on_cast hook\n389\t    card.on_cast(game)\n390\t\n391\t    # 5. Build on_resolve callback and push StackObject\n392\t    stack_obj = StackObject(\n393\t        source=card,\n394\t        controller=player,\n395\t        targets=chosen_targets,\n396\t        on_resolve=lambda g: None,  # replaced below\n397\t    )\n398\t\n399\t    def _on_resolve(g: GameState) -> None:\n400\t        _resolve_spell(g, card, player, stack_obj)\n401\t\n402\t    stack_obj.on_resolve = _on_resolve\n403\t    game.stack.push(stack_obj)\n404\t\n405\t\n406\t# ------------------------------------------------------------------\n407\t# Cast spell paying an alternative cost (e.g. miracle)\n408\t# ------------------------------------------------------------------\n409\t\n410\t\n411\tdef cast_spell_alternative(\n412\t    game: GameState,\n413\t    player: Player,\n414\t    card: CardImpl,\n415\t    alternative_cost: ManaCost,\n416\t    from_zone: Zone = Zone.HAND,\n417\t) -> None:\n418\t    \"\"\"Cast *card* paying *alternative_cost* instead of its mana cost.\n419\t\n420\t    Used by alternative-cost mechanics such as **miracle** (rule 702.94),\n421\t    where the spell is cast \"by paying [cost] rather than its mana cost\".\n422\t    The alternative cost is paid as a normal mana cost from *player*'s pool.\n423\t\n424\t    Unlike :func:`cast_spell` this skips the normal sorcery-speed/instant\n425\t    timing check (miracle casts happen at draw time, outside normal timing),\n426\t    but otherwise mirrors the cast pipeline: ``can_cast`` legality, target\n427\t    choice/validation, mana payment (with rollback on failure), the\n428\t    ``on_cast`` hook, and pushing a resolving :class:`StackObject`.\n429\t\n430\t    Note: cost reduction (``get_cost_reduction``) is intentionally NOT applied\n431\t    to *alternative_cost* — unlike :func:`cast_spell`, an alternative cost such\n432\t    as miracle is paid exactly as printed.  Callers that want a reduction on an\n433\t    alternative cost must fold it into *alternative_cost* before calling.\n434\t\n435\t    Parameters:\n436\t        game: The current game state.\n437\t        player: The player casting the spell.\n438\t        card: The card to cast (must be in *from_zone*).\n439\t        alternative_cost: The :class:`ManaCost` to pay instead of\n440\t            ``card.mana_cost``.\n441\t        from_zone: The zone the card is currently in (default hand).\n442\t\n443\t    Raises:\n444\t        CastingError: If any legality check fails or mana cannot be paid.\n445\t    \"\"\"\n446\t    if card.controller is None:\n447\t        card.controller = player\n448\t    if card.owner is None:\n449\t        card.owner = player\n450\t\n451\t    # can_cast legality (timing is intentionally skipped for miracle casts).\n452\t    if not card.can_cast(game):\n453\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n454\t\n455\t    source_zone = player.zones[from_zone]\n456\t    if not source_zone.contains(card):\n457\t        raise CastingError(\n458\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n459\t        )\n460\t\n461\t    stack_zone = player.zones[Zone.STACK]\n462\t    source_zone.remove(card)\n463\t    stack_zone.add(card)\n464\t\n465\t    if hasattr(card, \"colors_spent\"):\n466\t        del card.colors_spent\n467\t\n468\t    # Choose targets (with rollback to the source zone on failure).\n469\t    try:\n470\t        target_specs = card.get_targets(game)\n471\t        chosen_targets: list[Any] = []\n472\t        if target_specs:\n473\t            for spec in target_specs:\n474\t                target = player.choose_target(target_specs, spec)\n475\t                filter_fn = getattr(spec, \"filter_fn\", None)\n476\t                if filter_fn is not None and target is not None:\n477\t                    if not filter_fn(target):\n478\t                        raise CastingError(\n479\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n480\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n481\t                        )\n482\t                chosen_targets.append(target)\n483\t\n484\t        from engine.protection import has_protection_from\n485\t\n486\t        for target in chosen_targets:\n487\t            if has_protection_from(target, card):\n488\t                raise CastingError(\n489\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n490\t                )\n491\t    except Exception as exc:\n492\t        stack_zone.remove(card)\n493\t        source_zone.add(card)\n494\t        raise CastingError(str(exc)) from exc\n495\t\n496\t    # Pay the alternative cost (rollback on failure).\n497\t    if not player.mana_pool.can_pay(alternative_cost):\n498\t        stack_zone.remove(card)\n499\t        source_zone.add(card)\n500\t        raise CastingError(\n501\t            f\"Cannot cast {card.name!r} — insufficient mana for alternative cost\"\n502\t        )\n503\t    player.mana_pool.pay(alternative_cost)\n504\t\n505\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n506\t    card.mana_spent = player.mana_pool.last_payment_total  # type: ignore[attr-defined]\n507\t\n508\t    card.on_cast(game)\n509\t\n510\t    stack_obj = StackObject(\n511\t        source=card,\n512\t        controller=player,\n513\t        targets=chosen_targets,\n514\t        on_resolve=lambda g: None,  # replaced below\n515\t    )\n516\t\n517\t    def _on_resolve(g: GameState) -> None:\n518\t        _resolve_spell(g, card, player, stack_obj)\n519\t\n520\t    stack_obj.on_resolve = _on_resolve\n521\t    game.stack.push(stack_obj)\n522\t\n523\t\n524\t# ------------------------------------------------------------------\n525\t# Resolution (called when the stack pops)\n526\t# ------------------------------------------------------------------\n527\t\n528\tdef _resolve_spell(\n529\t    game: GameState,\n530\t    card: CardImpl,\n531\t    player: Player,\n532\t    stack_obj: StackObject,\n533\t) -> None:\n534\t    \"\"\"Resolve *card* cast by *player*.\n535\t\n536\t    1. Call ``card.on_resolve(game, targets=targets)``.\n537\t    2. Remove the card from the stack zone.\n538\t    3. If the card is a permanent type, move it to the battlefield via\n539\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n540\t       registration and the ETB event).\n541\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n542\t    \"\"\"\n543\t    from engine.zones import move_to_zone\n544\t\n545\t    # Read targets from the StackObject — the single source of truth.\n546\t    # Set chosen_targets on the card just before resolution so that\n547\t    # _get_chosen_target helpers (which read via getattr) work.\n548\t    targets = stack_obj.targets\n549\t    if targets is not None:\n550\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n551\t\n552\t    card.on_resolve(game)\n553\t\n554\t    if card.card_types & _PERMANENT_TYPES:\n555\t        # Move from stack to battlefield via move_to_zone, which handles\n556\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n557\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n558\t    else:\n559\t        # Instant/sorcery: the spell would be put into its owner's graveyard.\n560\t        # Consult replacement effects so that effects such as \"if that spell\n561\t        # would be put into your graveyard, exile it instead\" can redirect\n562\t        # the destination zone.\n563\t        dest_zone = _resolve_spell_graveyard_destination(game, card)\n564\t        move_to_zone(game, card, Zone.STACK, dest_zone)\n565\t        # Clean up any spell-specific exile replacement / flag now that the\n566\t        # spell has left the stack.\n567\t        game.replacement_manager.unregister(card)\n568\t        if hasattr(card, \"_exile_if_goes_to_graveyard\"):\n569\t            del card._exile_if_goes_to_graveyard\n570\t\n571\t\n572\t# Destination string → Zone for spell graveyard-replacement redirection.\n573\t_SPELL_DESTINATION_ZONE_MAP: dict[str, Zone] = {\n574\t    \"graveyard\": Zone.GRAVEYARD,\n575\t    \"exile\": Zone.EXILE,\n576\t    \"hand\": Zone.HAND,\n577\t    \"library\": Zone.LIBRARY,\n578\t}\n579\t\n580\t\n581\tdef _resolve_spell_graveyard_destination(game: GameState, card: CardImpl) -> Zone:\n582\t    \"\"\"Return the zone an instant/sorcery should move to on resolution.\n583\t\n584\t    Builds a :class:`~engine.events.SpellToGraveyardReplacementEvent` and runs\n585\t    it through the replacement manager so replacement effects can redirect the\n586\t    spell (e.g. exile instead of graveyard).  Defaults to the graveyard.\n587\t    \"\"\"\n588\t    from engine.events import SpellToGraveyardReplacementEvent\n589\t\n590\t    controller = getattr(card, \"controller\", None)\n591\t    owner = getattr(card, \"owner\", None) or controller\n592\t    event = SpellToGraveyardReplacementEvent(\n593\t        destination=\"graveyard\",\n594\t        controller=controller,\n595\t        owner=owner,\n596\t        spell=card,\n597\t    )\n598\t    event = game.replacement_manager.apply(game, event)\n599\t    destination_str = getattr(event, \"destination\", \"graveyard\")\n600\t    return _SPELL_DESTINATION_ZONE_MAP.get(destination_str, Zone.GRAVEYARD)\n601\t\n602\t\n603\t# ------------------------------------------------------------------\n604\t# Play land (special action — does not use the stack)\n605\t# ------------------------------------------------------------------\n606\t\n607\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n608\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n609\t\n610\t    Requirements (all must hold):\n611\t\n612\t    * *land_card* has :attr:`CardType.LAND`.\n613\t    * *player* is the active player.\n614\t    * Current phase is a main phase.\n615\t    * The stack is empty.\n616\t    * ``player.land_plays_remaining > 0``.\n617\t    * The card is in the player's hand.\n618\t\n619\t    On success the card moves from hand to battlefield and\n620\t    ``land_plays_remaining`` is decremented.\n621\t\n622\t    Raises:\n623\t        CastingError: If any requirement is not met.\n624\t    \"\"\"\n625\t    # Must be a land\n626\t    if CardType.LAND not in land_card.card_types:\n627\t        raise CastingError(\n628\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n629\t        )\n630\t\n631\t    # Sorcery-speed timing (active player, main phase, stack empty)\n632\t    if not is_sorcery_speed(game, player):\n633\t        raise CastingError(\n634\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n635\t            \"during main phase with empty stack\"\n636\t        )\n637\t\n638\t    # Land plays remaining\n639\t    if player.land_plays_remaining <= 0:\n640\t        raise CastingError(\n641\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n642\t        )\n643\t\n644\t    # Card must be in hand\n645\t    hand = game.get_hand(player)\n646\t    if not hand.contains(land_card):\n647\t        raise CastingError(\n648\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n649\t        )\n650\t\n651\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n652\t    if land_card.owner is None:\n653\t        land_card.owner = player\n654\t    land_card.controller = player\n655\t\n656\t    # Move from hand to battlefield via move_to_zone, which fires\n657\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n658\t    from engine.zones import move_to_zone\n659\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n660\t\n661\t    # Decrement land plays\n662\t    player.land_plays_remaining -= 1\n663\t\n664\t\n665\tdef cast_prepared_spell(\n666\t    game: GameState,\n667\t    permanent: Any,\n668\t    targets: list[Any] | None = None,\n669\t) -> StackObject | None:\n670\t    \"\"\"Cast a copy of *permanent*'s prepare spell while it is prepared.\n671\t\n672\t    This implements the SOS **Prepared** mechanic\n673\t    (rules text: \"While it's prepared, you may cast a copy of its spell.\n674\t    Doing so unprepares it.\").\n675\t\n676\t    A prepared permanent exposes:\n677\t\n678\t    * a truthy ``is_prepared`` flag, and\n679\t    * a ``prepare_spell`` attribute — a :class:`~engine.card.CardImpl` (the\n680\t      inset spell, e.g. Swords to Plowshares).\n681\t\n682\t    This helper creates a *copy* of that prepare spell, places it in the\n683\t    controller's exile zone, casts it for free (no mana cost) onto the stack,\n684\t    and clears the permanent's prepared designation. The returned\n685\t    :class:`StackObject` can be resolved to apply the prepare spell's effect.\n686\t\n687\t    Parameters:\n688\t        game: The current game state.\n689\t        permanent: The prepared permanent (must have ``is_prepared`` truthy\n690\t            and a ``prepare_spell``).\n691\t        targets: Optional explicit targets for the copy. If provided, they\n692\t            are scripted into the controller's choices so the copy resolves\n693\t            against them.\n694\t\n695\t    Returns:\n696\t        The :class:`StackObject` for the prepare-spell copy, or ``None`` if\n697\t        *permanent* is not prepared / exposes no prepare spell.\n698\t    \"\"\"\n699\t    import copy as _copy\n700\t\n701\t    if not getattr(permanent, \"is_prepared\", False):\n702\t        return None\n703\t    prepare_spell = getattr(permanent, \"prepare_spell\", None)\n704\t    if prepare_spell is None:\n705\t        return None\n706\t\n707\t    controller = getattr(permanent, \"controller\", None) or game.active_player\n708\t\n709\t    # Build a fresh copy of the prepare spell so the original face stays put.\n710\t    spell_copy = _copy.copy(prepare_spell)\n711\t    # Give the copy a unique identity & clean target state.\n712\t    from engine.card import GameObject as _GameObject\n713\t\n714\t    spell_copy.object_id = _GameObject._next_id\n715\t    _GameObject._next_id += 1\n716\t    spell_copy.controller = controller\n717\t    spell_copy.owner = controller\n718\t    if hasattr(spell_copy, \"chosen_targets\"):\n719\t        spell_copy.chosen_targets = []\n720\t\n721\t    # Casting unprepares the permanent (rule text: \"Doing so unprepares it.\").\n722\t    permanent.is_prepared = False\n723\t\n724\t    # Place the copy in exile so it is cast \"from exile\" like a real copy.\n725\t    exile_zone = controller.zones[Zone.EXILE]\n726\t    exile_zone.add(spell_copy)\n727\t\n728\t    stack_before = len(game.stack)\n729\t\n730\t    # Script the explicit targets so cast_spell_free's target choices resolve.\n731\t    if targets:\n732\t        appendleft = getattr(getattr(controller, \"_script\", None), \"appendleft\", None)\n733\t        if appendleft is not None:\n734\t            for target in reversed(targets):\n735\t                controller._script.appendleft(target)\n736\t\n737\t    cast_spell_free(game, controller, spell_copy, Zone.EXILE)\n738\t\n739\t    if len(game.stack) > stack_before:\n740\t        return game.stack.peek()\n741\t    return None\n742\t\n743\t\n744\tdef resolve_top(game: GameState) -> None:\n745\t    \"\"\"Resolve the top spell/ability on the stack.\n746\t\n747\t    Pops the top item from the stack, calls its on_resolve callback,\n748\t    then runs state-based actions.  If the stack is empty this is a no-op.\n749\t    \"\"\"\n750\t    if game.stack.is_empty():\n751\t        return\n752\t    from engine.state_based_actions import resolve_state_based_actions\n753\t\n754\t    obj = game.stack.pop()\n755\t    obj.on_resolve(game)\n756\t    resolve_state_based_actions(game)\n757\t"}]},"parent_tool_use_id":"toolu_01NGPgShq7ufcrA89j3njWbF","session_id":"5ed3988e-944a-4908-bc92-4f8937d76445","uuid":"52f5f5aa-139f-4e0b-9237-2a64b87461b8","timestamp":"2026-06-01T12:00:13.766Z","subagent_type":"Tester","task_description":"Extend tests for sos_226"}
