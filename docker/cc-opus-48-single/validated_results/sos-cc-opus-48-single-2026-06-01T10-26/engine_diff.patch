+def surveil(game: GameState, player: Player, amount: int) -> None:
+    """Surveil *amount* (rule 701.43) for *player*.
+
+    Look at the top *amount* cards of *player*'s library, then for each (from
+    the top down) the player decides whether to keep it on top of the library
+    or put it into the graveyard.  Cards kept on top retain their relative
+    order.
+
+    The decision is driven by ``player.choose_yes_no`` — ``True`` keeps the
+    card on top, ``False`` puts it into the graveyard.
+
+    Parameters:
+        game: The current game state.
+        player: The player surveilling.
+        amount: The number of cards to look at.
+    """
+    if amount <= 0:
+        return
+
+    library = game.get_library(player)
+    # ``top(n)`` returns bottom→top order; reverse so we process from the
+    # top of the library downward (the order the player looks at them).
+    looked_at = list(reversed(library.top(amount)))
+
+    keep_on_top: list[Any] = []
+    for card in looked_at:
+        keep = True
+        if hasattr(player, "choose_yes_no"):
+            keep = player.choose_yes_no(f"Keep {getattr(card, 'name', card)!r} on top?")
+        if keep:
+            keep_on_top.append(card)
+        else:
+            move_to_zone(game, card, Zone.LIBRARY, Zone.GRAVEYARD)
+
+    # Re-place the kept cards on top, preserving their original top-down order
+    # (so the previous top card remains on top).
+    for card in reversed(keep_on_top):
+        if library.contains(card):
+            library.remove(card)
+    for card in reversed(keep_on_top):
+        library.add(card, position="top")
+
+
+def flip_coin(game: GameState | None = None) -> bool:
+    """Flip a coin (rule 705).  Returns ``True`` for heads, ``False`` for tails.
+
+    Uses the :mod:`random` module so tests can force the outcome by patching
+    ``random.random`` / ``random.choice`` / ``random.randint``.
+
+    The optional ``game`` parameter is currently unused; it is accepted for
+    signature symmetry with the other ``engine.game`` helpers so callers can
+    pass the game state uniformly.
+    """
+    import random
+
+    return random.random() < 0.5
+
+
+def skip_turns(game: GameState, player: Player, count: int) -> None:
+    """Record that *player* skips their next *count* turns.
+
+    The engine has no full turn-skip execution path; this surfaces the
+    recorded count both on the player (``player.skipped_turns``) and on the
+    game keyed by seat index (``game.skipped_turns[seat]``) so it is
+    observable.
+
+    Parameters:
+        game: The current game state.
+        player: The player who will skip turns.
+        count: Number of turns to skip (clamped to non-negative).
+    """
+    count = max(0, count)
+    player.skipped_turns = getattr(player, "skipped_turns", 0) + count
+
+    if not hasattr(game, "skipped_turns") or game.skipped_turns is None:
+        game.skipped_turns = {}
+    try:
+        seat = game.players.index(player)
+    except ValueError:
+        seat = None
+    if seat is not None:
+        game.skipped_turns[seat] = game.skipped_turns.get(seat, 0) + count
+
