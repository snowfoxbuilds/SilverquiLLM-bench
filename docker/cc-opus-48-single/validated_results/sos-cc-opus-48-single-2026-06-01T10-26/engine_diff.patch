+def _colors_from_mana_cost(cost: ManaCost) -> set[Color]:
+    """Derive the set of :class:`~engine.types.Color` from a mana cost.
+
+    Colored pips contribute their color; hybrid symbols contribute both of
+    their (non-colorless) options. Generic, ``{C}``, and ``{X}`` contribute
+    nothing. Returns an empty set for a colorless / costless object.
+    """
+    colors: set[Color] = set()
+    for mana_type in getattr(cost, "pips", {}):
+        color = _MANA_TYPE_TO_COLOR.get(mana_type)
+        if color is not None:
+            colors.add(color)
+    for hybrid in getattr(cost, "hybrid", []):
+        for option in (hybrid.option_a, hybrid.option_b):
+            color = _MANA_TYPE_TO_COLOR.get(option)
+            if color is not None:
+                colors.add(color)
+    return colors
+
