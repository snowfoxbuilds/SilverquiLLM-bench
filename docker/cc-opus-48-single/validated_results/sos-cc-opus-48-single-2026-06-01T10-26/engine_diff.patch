+def _granted_cost_reduction(
+    game: GameState, card: CardImpl, controller: Player
+) -> int:
+    """Return the extra generic reduction *controller*'s battlefield grants to *card*.
+
+    Consults every permanent on *controller*'s battlefield that exposes a
+    callable ``affinity_for_creatures_grant(game, card, controller)`` method
+    (an additive, dynamically-derived grant surface analogous to the miracle
+    grant in :mod:`engine.miracle`).  Each grant returns the generic reduction
+    it confers on *card* (0 when it does not apply); the results are summed.
+
+    This is additive to the card's own ``cost_reduction`` so a spell that both
+    has its own affinity *and* is granted one is not double-counted by the
+    grant path: grant methods scope themselves to the controller's spells and
+    return their own count, and a card's intrinsic ``cost_reduction`` is read
+    separately above.  In the current single-source SOS model only one such
+    granter exists, so no inter-grant double counting occurs.
+    """
+    if controller is None:
+        return 0
+    total = 0
+    for permanent in game.get_battlefield(controller).get_all():
+        grant = getattr(permanent, "affinity_for_creatures_grant", None)
+        if not callable(grant):
+            continue
+        try:
+            amount = grant(game, card, controller)
+        except TypeError:
+            # Not a (game, card, controller) grant method — skip defensively.
+            continue
+        if amount:
+            total += int(amount)
+    return total
+
