+def cast_prepared_spell(
+    game: GameState,
+    permanent: Any,
+    targets: list[Any] | None = None,
+) -> StackObject | None:
+    """Cast a copy of *permanent*'s prepare spell while it is prepared.
+
+    This implements the SOS **Prepared** mechanic
+    (rules text: "While it's prepared, you may cast a copy of its spell.
+    Doing so unprepares it.").
+
+    A prepared permanent exposes:
+
+    * a truthy ``is_prepared`` flag, and
+    * a ``prepare_spell`` attribute — a :class:`~engine.card.CardImpl` (the
+      inset spell, e.g. Swords to Plowshares).
+
+    This helper creates a *copy* of that prepare spell, places it in the
+    controller's exile zone, casts it for free (no mana cost) onto the stack,
+    and clears the permanent's prepared designation. The returned
+    :class:`StackObject` can be resolved to apply the prepare spell's effect.
+
+    Parameters:
+        game: The current game state.
+        permanent: The prepared permanent (must have ``is_prepared`` truthy
+            and a ``prepare_spell``).
+        targets: Optional explicit targets for the copy. If provided, they
+            are scripted into the controller's choices so the copy resolves
+            against them.
+
+    Returns:
+        The :class:`StackObject` for the prepare-spell copy, or ``None`` if
+        *permanent* is not prepared / exposes no prepare spell.
+    """
+    import copy as _copy
+
+    if not getattr(permanent, "is_prepared", False):
+        return None
+    prepare_spell = getattr(permanent, "prepare_spell", None)
+    if prepare_spell is None:
+        return None
+
+    controller = getattr(permanent, "controller", None) or game.active_player
+
+    # Build a fresh copy of the prepare spell so the original face stays put.
+    spell_copy = _copy.copy(prepare_spell)
+    # Give the copy a unique identity & clean target state.
+    from engine.card import GameObject as _GameObject
+
+    spell_copy.object_id = _GameObject._next_id
+    _GameObject._next_id += 1
+    spell_copy.controller = controller
+    spell_copy.owner = controller
+    if hasattr(spell_copy, "chosen_targets"):
+        spell_copy.chosen_targets = []
+
+    # Casting unprepares the permanent (rule text: "Doing so unprepares it.").
+    permanent.is_prepared = False
+
+    # Place the copy in exile so it is cast "from exile" like a real copy.
+    exile_zone = controller.zones[Zone.EXILE]
+    exile_zone.add(spell_copy)
+
+    stack_before = len(game.stack)
+
+    # Script the explicit targets so cast_spell_free's target choices resolve.
+    if targets:
+        appendleft = getattr(getattr(controller, "_script", None), "appendleft", None)
+        if appendleft is not None:
+            for target in reversed(targets):
+                controller._script.appendleft(target)
+
+    cast_spell_free(game, controller, spell_copy, Zone.EXILE)
+
+    if len(game.stack) > stack_before:
+        return game.stack.peek()
+    return None
+
