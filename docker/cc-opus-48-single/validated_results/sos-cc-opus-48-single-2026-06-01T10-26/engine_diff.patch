diff -ruN a/miracle.py b/miracle.py
--- a/miracle.py	1970-01-01 00:00:00.000000000 +0000
+++ b/miracle.py	2026-06-01 11:47:15.900538318 +0000
@@ -0,0 +1,209 @@
+"""Miracle mechanic support (rule 702.94) — additive engine surface.
+
+Miracle is a static ability linked to a triggered ability:
+
+    "Miracle [cost]" means "You may reveal this card from your hand as you
+    draw it if it's the first card you've drawn this turn. When you reveal
+    this card this way, you may cast it by paying [cost] rather than its
+    mana cost."
+
+The engine has no native ``miracle`` keyword (and the :class:`~engine.types.Keyword`
+enum is pinned at 16 members by ``engine_tests/test_types.py``), so miracle is
+surfaced via a per-card ``miracle_cost`` attribute and a small set of helper
+functions here instead of a flag.
+
+Contract exposed to cards / tests
+----------------------------------
+
+* :func:`set_miracle_cost` — stamp a :class:`~engine.types.ManaCost` (the
+  miracle/alternative cost) onto a card and mark it ``has_miracle = True``.
+* :func:`clear_miracle_cost` — remove the stamp (used when the granting
+  source leaves the battlefield / the card leaves the hand).
+* :func:`get_miracle_cost` — read the assigned miracle cost (``None`` if the
+  card has no miracle).
+* :func:`is_first_draw_this_turn` — first-card-drawn-this-turn gating, reading
+  the ``player.cards_drawn_this_turn`` counter the draw step maintains.
+* :func:`can_miracle_cast` — ``True`` iff the just-drawn card has a miracle
+  cost AND it is the first card drawn this turn.
+* :func:`derive_miracle_cost` — DYNAMICALLY compute the miracle cost a just-drawn
+  card has *right now*, by consulting active grants (permanents on the drawer's
+  battlefield that expose a ``miracle_cost(game, card)`` grant method, e.g. a
+  Lorehold). This is what makes miracle fire on a naturally-drawn card with no
+  manual pre-stamping, and what makes the grant non-sticky: when no granter
+  applies the derived cost is ``None`` even if a stale stamp is present.
+* :func:`offer_miracle` — the draw-time hook: if the card may be miracle-cast
+  and the controller says yes (``choose_yes_no``), cast it for the miracle
+  cost as an alternative cost via :func:`engine.casting.cast_spell_alternative`.
+
+The miracle cost is paid as a normal mana cost (just a *different* cost), so
+the alternative-cost cast path pays from the player's mana pool.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any
+
+if TYPE_CHECKING:
+    from engine.game_state import GameState
+    from engine.player import Player
+    from engine.types import ManaCost
+
+
+# Attribute name used to stamp the miracle cost onto a card.
+_MIRACLE_COST_ATTR = "miracle_cost"
+
+
+def set_miracle_cost(card: Any, cost: "ManaCost") -> None:
+    """Assign *cost* as *card*'s miracle (alternative) cost.
+
+    Sets both ``card.miracle_cost`` and a ``card.has_miracle`` boolean flag
+    so callers can detect the grant without a ``None`` comparison.
+    """
+    setattr(card, _MIRACLE_COST_ATTR, cost)
+    card.has_miracle = True
+
+
+def clear_miracle_cost(card: Any) -> None:
+    """Remove any miracle cost previously assigned to *card*."""
+    if hasattr(card, _MIRACLE_COST_ATTR):
+        try:
+            delattr(card, _MIRACLE_COST_ATTR)
+        except AttributeError:
+            setattr(card, _MIRACLE_COST_ATTR, None)
+    card.has_miracle = False
+
+
+def get_miracle_cost(card: Any) -> "ManaCost | None":
+    """Return *card*'s assigned miracle cost, or ``None`` if it has none."""
+    return getattr(card, _MIRACLE_COST_ATTR, None)
+
+
+def derive_miracle_cost(
+    game: "GameState", player: "Player", card: Any
+) -> "ManaCost | None":
+    """Dynamically compute the miracle cost *card* has *right now* for *player*.
+
+    This is the authoritative, non-sticky source of a card's miracle cost at
+    draw time.  It consults the active grants in play rather than relying solely
+    on a pre-applied (and potentially stale) stamp:
+
+    * Every permanent on *player*'s battlefield that exposes a callable
+      ``miracle_cost(game, card)`` grant method is asked whether it grants a
+      miracle cost to *card* (e.g. Lorehold grants ``{2}`` to instant/sorcery
+      cards in its controller's hand).  The first non-``None`` result wins.
+    * If a grant applies, the stamp is (re)synchronised onto the card via
+      :func:`set_miracle_cost` so downstream readers stay consistent, and the
+      cost is returned.
+    * If NO grant applies, any previously-applied stamp is cleared via
+      :func:`clear_miracle_cost` and ``None`` is returned.  This is what makes
+      the grant end when the granter leaves play (or the card leaves the hand):
+      a card stamped earlier no longer offers miracle once no granter is active.
+
+    The drawn *card* is in *player*'s hand at draw time, so battlefield grants
+    scoped to "instant/sorcery cards in your hand" (like Lorehold's) see it.
+    """
+    granted: "ManaCost | None" = None
+    battlefield = game.get_battlefield(player)
+    for permanent in battlefield.get_all():
+        grant = getattr(permanent, _MIRACLE_COST_ATTR, None)
+        if not callable(grant):
+            continue
+        try:
+            cost = grant(game, card)
+        except TypeError:
+            # Not a (game, card) grant method — skip defensively.
+            continue
+        if cost is not None:
+            granted = cost
+            break
+
+    if granted is not None:
+        set_miracle_cost(card, granted)
+        return granted
+
+    # No active granter: drop any stale stamp so the grant is not sticky.
+    if get_miracle_cost(card) is not None:
+        clear_miracle_cost(card)
+    return None
+
+
+def _is_active_player(game: "GameState", player: "Player") -> bool:
+    """Return ``True`` if *player* is the game's current active player.
+
+    Miracle's offer is presented on the drawing player's own turn (their draw
+    step or a draw effect they control on their turn).  Draws taken during
+    another player's turn (e.g. a loot effect resolving on an opponent's
+    upkeep) are not offered a miracle cast here.  When the game exposes no
+    active-player information we conservatively treat the draw as eligible.
+    """
+    active = getattr(game, "active_player", None)
+    if active is None:
+        return True
+    return active is player
+
+
+def is_first_draw_this_turn(player: "Player") -> bool:
+    """Return ``True`` if at most one card has been drawn by *player* this turn.
+
+    Miracle keys off "the first card you've drawn this turn".  The draw helper
+    (:func:`engine.game.draw_card`) increments ``player.cards_drawn_this_turn``
+    *before* firing the draw trigger, so when this is evaluated at draw time the
+    counter reads ``1`` for the first draw of the turn.
+    """
+    count = getattr(player, "cards_drawn_this_turn", 0)
+    return count <= 1
+
+
+def can_miracle_cast(player: "Player", card: Any) -> bool:
+    """Return ``True`` if *card* may be miracle-cast as it is drawn.
+
+    Requires both that *card* carries an assigned miracle cost and that it is
+    the first card *player* has drawn this turn.
+    """
+    if get_miracle_cost(card) is None:
+        return False
+    return is_first_draw_this_turn(player)
+
+
+def offer_miracle(game: "GameState", player: "Player", card: Any) -> bool:
+    """Draw-time miracle hook — offer to cast the just-drawn *card* for miracle.
+
+    Returns ``True`` if the card was miracle-cast (put on the stack), ``False``
+    otherwise.  No-op (returns ``False``) when the card has no miracle cost or
+    it is not the first card drawn this turn.
+
+    The optionality is driven by ``player.choose_yes_no`` (the "you may"
+    clause).  On a yes, the card is cast for its miracle cost via the
+    alternative-cost cast path.
+
+    The miracle cost is derived DYNAMICALLY from the grants active right now
+    (see :func:`derive_miracle_cost`), so a naturally-drawn card gets the offer
+    with no manual pre-stamping, and a stale stamp left over from a granter that
+    has since left play does NOT produce an offer.
+
+    The offer is scoped to the *active player*'s own draw (their draw step / a
+    draw effect on their turn).  Draws taken on another player's turn — e.g. a
+    looting effect that resolves during an opponent's upkeep — do not present a
+    miracle offer here.
+    """
+    if not _is_active_player(game, player):
+        return False
+
+    cost = derive_miracle_cost(game, player, card)
+    if cost is None:
+        return False
+    if not is_first_draw_this_turn(player):
+        return False
+
+    name = getattr(card, "name", "card")
+    if hasattr(player, "choose_yes_no"):
+        if not player.choose_yes_no(f"Cast {name!r} for its miracle cost?"):
+            return False
+
+    from engine.casting import cast_spell_alternative, CastingError
+
+    try:
+        cast_spell_alternative(game, player, card, cost)
+    except CastingError:
+        return False
+    return True
