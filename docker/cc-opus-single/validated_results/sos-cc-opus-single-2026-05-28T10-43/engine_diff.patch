--- a/card.py	2026-05-25 16:43:11.728292087 +0000
+++ b/card.py	2026-05-28 12:22:53.783972959 +0000
@@ -204,10 +204,23 @@
         The returned value is clamped so that generic mana cannot go below 0.
         Only reduces generic mana — colored costs are never reduced.
 
+        The base implementation aggregates any external cost-reduction
+        grants registered on the game state (e.g. affinity for creatures
+        granted by another permanent).  Subclasses that override should
+        call ``super().cost_reduction(game)`` and add their own reduction
+        on top if they also benefit from external grants.
+
         Returns:
             Non-negative integer representing generic mana to subtract.
         """
-        return 0
+        # Check for external cost-reduction grants registered on the game.
+        grants = getattr(game, "_cost_reduction_grants", None)
+        if not grants:
+            return 0
+        total = 0
+        for grant_fn in grants:
+            total += grant_fn(game, self)
+        return total
 
     def on_cast(self, game: GameState) -> None:
         """Called when the card is cast (before it goes on the stack)."""
diff -ruN a/casting.py b/casting.py
--- a/casting.py	2026-05-25 16:43:11.728292087 +0000
+++ b/casting.py	2026-05-28 11:49:35.477639348 +0000
@@ -406,8 +406,22 @@
         # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.
         move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)
     else:
-        # Instant/sorcery: move from stack to graveyard via move_to_zone.
-        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)
+        # Check for exile-instead replacement (e.g. The Dawning Archaic:
+        # "If that spell would be put into your graveyard, exile it instead.")
+        exile_instead = getattr(card, "_dawning_archaic_exile", False)
+        # Also check for Paradigm exile-instead marker.
+        paradigm_exile = getattr(card, "_paradigm_exile", False)
+        if exile_instead:
+            # Clean up the flag before moving
+            del card._dawning_archaic_exile
+            move_to_zone(game, card, Zone.STACK, Zone.EXILE)
+        elif paradigm_exile:
+            # Paradigm: exile this spell instead of putting it in graveyard.
+            del card._paradigm_exile
+            move_to_zone(game, card, Zone.STACK, Zone.EXILE)
+        else:
+            # Instant/sorcery: move from stack to graveyard via move_to_zone.
+            move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)
 
 
