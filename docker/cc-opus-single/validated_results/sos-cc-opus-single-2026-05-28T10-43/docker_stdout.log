{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XTvaNTvECcJZVw2CDiEvQZ","type":"tool_result","content":"1\tdiff --git a/RUN_DECISIONS.md b/RUN_DECISIONS.md\n2\tindex b0bcb0a..07efb4f 100644\n3\t--- a/RUN_DECISIONS.md\n4\t+++ b/RUN_DECISIONS.md\n5\t@@ -2,3 +2,13 @@\n6\t \n7\t Decisions made during this run only. Before the run ends, migrate anything worth preserving into `KEY_DECISIONS.md`.\n8\t \n9\t+## sos_57: Partial coverage accepted for mana-spent tracking\n10\t+- The engine doesn't track total mana spent per spell; tests approximate using CMC.\n11\t+- This is correct for standard spells; edge cases with X-costs or cost modifications may differ.\n12\t+- Accepted as partial coverage (option b). UNVERIFIED marker to be added if applicable.\n13\t+\n14\t+## sos_97: Coin flip and skip turns — handed to Implementer\n15\t+- No engine coin flip API or skip_turns attribute exists yet.\n16\t+- Tests monkey-patch random; Implementer should build whatever is needed and tests should be able to cover it.\n17\t+- Option (a): Implementer builds the infrastructure; Tester may be re-invoked if needed.\n18\t+\n19\tdiff --git a/cards/sos/sos_120/card_impl.py b/cards/sos/sos_120/card_impl.py\n20\tindex fd0c1f4..310e58d 100644\n21\t--- a/cards/sos/sos_120/card_impl.py\n22\t+++ b/cards/sos/sos_120/card_impl.py\n23\t@@ -2,15 +2,165 @@\n24\t \n25\t from __future__ import annotations\n26\t \n27\t-from engine.card import CardImpl\n28\t+from typing import TYPE_CHECKING, Any\n29\t \n30\t-from typing import TYPE_CHECKING\n31\t+from engine.card import Sorcery\n32\t+from engine.types import CardType, ManaCost, Zone\n33\t+from engine.events import TriggeredEvent\n34\t+from engine.triggers import TriggerRegistration\n35\t \n36\t if TYPE_CHECKING:\n37\t     from engine.game_state import GameState\n38\t \n39\t \n40\t-class ImprovisationCapstone(CardImpl):\n41\t-    \"\"\"TODO: Implement Improvisation Capstone.\"\"\"\n42\t+class ImprovisationCapstone(Sorcery):\n43\t+    \"\"\"Improvisation Capstone -- {5}{R}{R} -- Sorcery -- Lesson.\n44\t \n45\t-    pass\n46\t+    Exile cards from the top of your library until you exile cards with\n47\t+    total mana value 4 or greater. You may cast any number of spells\n48\t+    from among them without paying their mana costs.\n49\t+\n50\t+    Paradigm (Then exile this spell. After you first resolve a spell\n51\t+    with this name, you may cast a copy of it from exile without paying\n52\t+    its mana cost at the beginning of each of your first main phases.)\n53\t+\n54\t+    SOS collector number 120.\n55\t+    \"\"\"\n56\t+\n57\t+    def __init__(self, **kwargs: Any) -> None:\n58\t+        kwargs.setdefault(\"name\", \"Improvisation Capstone\")\n59\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{5}{R}{R}\"))\n60\t+        kwargs.setdefault(\"subtypes\", {\"Lesson\"})\n61\t+        kwargs.setdefault(\n62\t+            \"rules_text\",\n63\t+            \"Exile cards from the top of your library until you exile cards \"\n64\t+            \"with total mana value 4 or greater. You may cast any number of \"\n65\t+            \"spells from among them without paying their mana costs.\\n\"\n66\t+            \"Paradigm (Then exile this spell. After you first resolve a spell \"\n67\t+            \"with this name, you may cast a copy of it from exile without \"\n68\t+            \"paying its mana cost at the beginning of each of your first \"\n69\t+            \"main phases.)\",\n70\t+        )\n71\t+        super().__init__(**kwargs)\n72\t+\n73\t+    def on_resolve(self, game: GameState) -> None:\n74\t+        \"\"\"Resolve: exile from library, free-cast, then Paradigm.\"\"\"\n75\t+        controller = self.controller or self.owner\n76\t+        if controller is None:\n77\t+            return\n78\t+\n79\t+        # --- Main effect: exile from top of library until total MV >= 4 ---\n80\t+        library = game.get_library(controller)\n81\t+        exile = game.get_exile(controller)\n82\t+        exiled_cards: list[Any] = []\n83\t+        total_mv = 0\n84\t+\n85\t+        while len(library) > 0 and total_mv < 4:\n86\t+            # Take from the top of the library (last element)\n87\t+            top_cards = library.top(1)\n88\t+            if not top_cards:\n89\t+                break\n90\t+            card = top_cards[0]\n91\t+            library.remove(card)\n92\t+            exile.add(card)\n93\t+            exiled_cards.append(card)\n94\t+            # Add the card's mana value to the running total\n95\t+            card_cost = getattr(card, \"mana_cost\", None)\n96\t+            if card_cost is not None:\n97\t+                total_mv += card_cost.cmc\n98\t+\n99\t+        # --- Free-cast from among exiled cards ---\n100\t+        # For each non-land exiled card, ask the controller whether to cast it\n101\t+        for card in exiled_cards:\n102\t+            card_types = getattr(card, \"card_types\", set())\n103\t+            # Lands cannot be cast (they are not spells)\n104\t+            if CardType.LAND in card_types:\n105\t+                continue\n106\t+\n107\t+            # Ask the player whether they want to cast this spell\n108\t+            try:\n109\t+                wants_to_cast = controller.choose_yes_no(\n110\t+                    f\"Cast {getattr(card, 'name', 'card')} without paying its mana cost?\"\n111\t+                )\n112\t+            except Exception:\n113\t+                continue\n114\t+\n115\t+            if not wants_to_cast:\n116\t+                continue\n117\t+\n118\t+            # Cast the spell: resolve it immediately (simplified free-cast)\n119\t+            # Remove from exile first\n120\t+            if exile.contains(card):\n121\t+                exile.remove(card)\n122\t+\n123\t+            # Set controller/owner\n124\t+            card.controller = controller\n125\t+            if card.owner is None:\n126\t+                card.owner = controller\n127\t+\n128\t+            # Resolve the spell\n129\t+            card.on_resolve(game)\n130\t+\n131\t+            # Determine where the card goes after resolution\n132\t+            permanent_types = {\n133\t+                CardType.CREATURE, CardType.ENCHANTMENT,\n134\t+                CardType.ARTIFACT, CardType.PLANESWALKER\n135\t+            }\n136\t+            if card_types & permanent_types:\n137\t+                # Permanents go to the battlefield\n138\t+                battlefield = game.get_battlefield(controller)\n139\t+                battlefield.add(card)\n140\t+            else:\n141\t+                # Non-permanents (instant/sorcery) go to the graveyard\n142\t+                graveyard = game.get_graveyard(controller)\n143\t+                graveyard.add(card)\n144\t+\n145\t+        # --- Paradigm ---\n146\t+        # 1. Exile this spell (set marker for _resolve_spell in casting pipeline)\n147\t+        self._paradigm_exile = True  # type: ignore[attr-defined]\n148\t+\n149\t+        # Also directly move self from stack to exile if we can find it on the stack\n150\t+        stack_zone = controller.zones.get(Zone.STACK, None) if hasattr(controller.zones, 'get') else None\n151\t+        if stack_zone is None:\n152\t+            try:\n153\t+                stack_zone = controller.zones[Zone.STACK]\n154\t+            except Exception:\n155\t+                stack_zone = None\n156\t+\n157\t+        if stack_zone is not None and stack_zone.contains(self):\n158\t+            stack_zone.remove(self)\n159\t+            exile.add(self)\n160\t+\n161\t+        # 2. Register a delayed trigger for Paradigm (only on first resolution)\n162\t+        # Use a game-level tracker to ensure we only register once per card name\n163\t+        if not hasattr(game, \"_paradigm_registered\"):\n164\t+            game._paradigm_registered = set()  # type: ignore[attr-defined]\n165\t+\n166\t+        card_name = self.name\n167\t+        if card_name not in game._paradigm_registered:  # type: ignore[attr-defined]\n168\t+            game._paradigm_registered.add(card_name)  # type: ignore[attr-defined]\n169\t+\n170\t+            paradigm_controller = controller\n171\t+\n172\t+            def _paradigm_condition(g: GameState, event: Any) -> bool:\n173\t+                \"\"\"Fire at the beginning of controller's precombat main phase.\"\"\"\n174\t+                from engine.types import Phase\n175\t+                active = getattr(g, \"active_player\", None)\n176\t+                phase = getattr(g, \"phase\", None)\n177\t+                if active is not paradigm_controller:\n178\t+                    return False\n179\t+                return phase == Phase.PRECOMBAT_MAIN\n180\t+\n181\t+            def _paradigm_effect(g: GameState) -> None:\n182\t+                \"\"\"Cast a copy of Improvisation Capstone from exile.\"\"\"\n183\t+                # This is a delayed trigger effect; implementation is simplified\n184\t+                pass\n185\t+\n186\t+            trigger_reg = TriggerRegistration(\n187\t+                event_type=TriggeredEvent,\n188\t+                condition=_paradigm_condition,\n189\t+                effect=_paradigm_effect,\n190\t+                source=self,\n191\t+                controller=controller,\n192\t+            )\n193\t+            game.trigger_manager.register(trigger_reg)\n194\tdiff --git a/engine/casting.py b/engine/casting.py\n195\tindex a7d8ca3..25596ff 100644\n196\t--- a/engine/casting.py\n197\t+++ b/engine/casting.py\n198\t@@ -409,10 +409,16 @@ def _resolve_spell(\n199\t         # Check for exile-instead replacement (e.g. The Dawning Archaic:\n200\t         # \"If that spell would be put into your graveyard, exile it instead.\")\n201\t         exile_instead = getattr(card, \"_dawning_archaic_exile\", False)\n202\t+        # Also check for Paradigm exile-instead marker.\n203\t+        paradigm_exile = getattr(card, \"_paradigm_exile\", False)\n204\t         if exile_instead:\n205\t             # Clean up the flag before moving\n206\t             del card._dawning_archaic_exile\n207\t             move_to_zone(game, card, Zone.STACK, Zone.EXILE)\n208\t+        elif paradigm_exile:\n209\t+            # Paradigm: exile this spell instead of putting it in graveyard.\n210\t+            del card._paradigm_exile\n211\t+            move_to_zone(game, card, Zone.STACK, Zone.EXILE)\n212\t         else:\n213\t             # Instant/sorcery: move from stack to graveyard via move_to_zone.\n214\t             move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n215\tdiff --git a/run_manifest.json b/run_manifest.json\n216\tindex f6735dd..a8459cf 100644\n217\t--- a/run_manifest.json\n218\t+++ b/run_manifest.json\n219\t@@ -1,6 +1,8 @@\n220\t {\n221\t-  \"benchmark_set\": \"sos\",\n222\t-  \"cards\": [\n223\t+  \"timeout_seconds\": 360000,\n224\t+  \"deadline_utc\": \"2026-06-01T14:43:01Z\",\n225\t+  \"docker_image\": \"silverquillm-cc-opus-single:latest\",\n226\t+  \"card_filter\": [\n227\t     \"1\",\n228\t     \"4\",\n229\t     \"13\",\n230\t@@ -11,5 +13,6 @@\n231\t     \"226\",\n232\t     \"245\",\n233\t     \"257\"\n234\t-  ]\n235\t-}\n236\t\\ No newline at end of file\n237\t+  ],\n238\t+  \"benchmark_set\": \"sos\"\n239\t+}\n240\t"}]},"parent_tool_use_id":"toolu_01AdrYPRBDk5FiWYHm9Vqurq","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f","uuid":"a689f6d9-d1e1-46d3-9f8c-31bc2bd98eb1","timestamp":"2026-05-28T11:51:08.070Z","subagent_type":"Reviewer","task_description":"Review sos_120 implementation"}
