{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013EN19MJuex8hMBbvCebRhM","type":"tool_result","content":"1\t\"\"\"Tests for SOS 57 — Mana Sculpt.\n2\t\n3\tMana Sculpt is an instant costing {1}{U}{U} that reads:\n4\t  \"Counter target spell. If you control a Wizard, add an amount of {C}\n5\t   equal to the amount of mana spent to cast that spell at the beginning\n6\t   of your next main phase.\"\n7\t\n8\tRequirements tested:\n9\t  - Static properties (name, mana cost, card type)\n10\t  - Targeting: targets a spell on the stack\n11\t  - Counter effect: removes the targeted spell from the stack to graveyard\n12\t  - Wizard check: delayed mana trigger only fires when a Wizard is controlled\n13\t  - Delayed trigger adds {C} equal to mana spent on the countered spell\n14\t  - No mana added if no Wizard is controlled\n15\t  - Fizzle behavior when target is missing\n16\t\"\"\"\n17\t\n18\tfrom __future__ import annotations\n19\t\n20\tfrom typing import Any\n21\t\n22\tfrom cards.sos.sos_57.card_impl import ManaSculpt\n23\tfrom engine.card import Creature, Instant\n24\tfrom engine.stack import StackObject\n25\tfrom engine.types import (\n26\t    CardType,\n27\t    Keyword,\n28\t    ManaCost,\n29\t    ManaType,\n30\t    Phase,\n31\t    TargetRequirement,\n32\t    Zone,\n33\t)\n34\tfrom test_utils import create_game, set_board_state\n35\t\n36\t\n37\t# ---------------------------------------------------------------------------\n38\t# Helper to create a Wizard creature\n39\t# ---------------------------------------------------------------------------\n40\t\n41\tdef _make_wizard(name: str = \"Test Wizard\", owner: Any = None) -> Creature:\n42\t    \"\"\"Create a simple Wizard creature for testing.\"\"\"\n43\t    c = Creature(\n44\t        name=name,\n45\t        owner=owner,\n46\t        base_power=1,\n47\t        base_toughness=1,\n48\t        subtypes={\"Human\", \"Wizard\"},\n49\t    )\n50\t    return c\n51\t\n52\t\n53\tdef _make_dummy_spell(name: str = \"Dummy Spell\", mana_cost_str: str = \"{2}{R}\",\n54\t                      owner: Any = None) -> Instant:\n55\t    \"\"\"Create a dummy instant to serve as the target spell on the stack.\"\"\"\n56\t    spell = Instant(\n57\t        name=name,\n58\t        owner=owner,\n59\t        mana_cost=ManaCost.parse(mana_cost_str),\n60\t    )\n61\t    return spell\n62\t\n63\t\n64\tdef _put_spell_on_stack(game: Any, player_index: int, spell: Any) -> StackObject:\n65\t    \"\"\"Place a spell onto the stack and return its StackObject.\n66\t\n67\t    This simulates the casting pipeline without paying mana.\n68\t    \"\"\"\n69\t    player = game.players[player_index]\n70\t    spell.owner = player\n71\t    spell.controller = player\n72\t\n73\t    # Add the card to the player's stack zone\n74\t    player.zones[Zone.STACK].add(spell)\n75\t\n76\t    # Create and push a StackObject\n77\t    stack_obj = StackObject(\n78\t        source=spell,\n79\t        controller=player,\n80\t        targets=[],\n81\t        on_resolve=lambda g: spell.on_resolve(g),\n82\t    )\n83\t    game.stack.push(stack_obj)\n84\t    return stack_obj\n85\t\n86\t\n87\t# ===========================================================================\n88\t# Tests\n89\t# ===========================================================================\n90\t\n91\t\n92\tclass TestManaSculptProperties:\n93\t    \"\"\"Static card data should match the SOS 57 spec.\"\"\"\n94\t\n95\t    def test_is_instant(self) -> None:\n96\t        card = ManaSculpt(owner=None)\n97\t        assert isinstance(card, Instant)\n98\t\n99\t    def test_name(self) -> None:\n100\t        card = ManaSculpt(owner=None)\n101\t        assert card.name == \"Mana Sculpt\"\n102\t\n103\t    def test_mana_cost(self) -> None:\n104\t        card = ManaSculpt(owner=None)\n105\t        assert card.mana_cost == ManaCost.parse(\"{1}{U}{U}\")\n106\t\n107\t    def test_card_type_includes_instant(self) -> None:\n108\t        card = ManaSculpt(owner=None)\n109\t        assert CardType.INSTANT in card.card_types\n110\t\n111\t\n112\tclass TestManaSculptTargeting:\n113\t    \"\"\"get_targets() should advertise a single spell target on the stack.\"\"\"\n114\t\n115\t    def test_returns_target_requirement_when_spell_on_stack(self) -> None:\n116\t        game = create_game()\n117\t        p2 = game.players[1]\n118\t\n119\t        dummy = _make_dummy_spell(owner=p2)\n120\t        _put_spell_on_stack(game, 1, dummy)\n121\t\n122\t        card = ManaSculpt(owner=game.players[0])\n123\t        reqs = card.get_targets(game)\n124\t        assert isinstance(reqs, list)\n125\t        assert len(reqs) >= 1\n126\t        assert isinstance(reqs[0], TargetRequirement)\n127\t\n128\t    def test_target_zone_is_stack(self) -> None:\n129\t        game = create_game()\n130\t        p2 = game.players[1]\n131\t\n132\t        dummy = _make_dummy_spell(owner=p2)\n133\t        _put_spell_on_stack(game, 1, dummy)\n134\t\n135\t        card = ManaSculpt(owner=game.players[0])\n136\t        reqs = card.get_targets(game)\n137\t        assert reqs[0].zone == Zone.STACK\n138\t\n139\t    def test_cannot_cast_with_empty_stack(self) -> None:\n140\t        \"\"\"can_cast should return False when there are no spells to counter.\"\"\"\n141\t        game = create_game()\n142\t        card = ManaSculpt(owner=game.players[0])\n143\t        assert card.can_cast(game) is False\n144\t\n145\t    def test_can_cast_with_spell_on_stack(self) -> None:\n146\t        \"\"\"can_cast should return True when there is a spell on the stack.\"\"\"\n147\t        game = create_game()\n148\t        dummy = _make_dummy_spell(owner=game.players[1])\n149\t        _put_spell_on_stack(game, 1, dummy)\n150\t\n151\t        card = ManaSculpt(owner=game.players[0])\n152\t        # Mana Sculpt itself should not be on the stack for this check\n153\t        assert card.can_cast(game) is True\n154\t\n155\t\n156\tclass TestManaSculptCounterEffect:\n157\t    \"\"\"on_resolve should counter the targeted spell.\"\"\"\n158\t\n159\t    def test_countered_spell_goes_to_graveyard(self) -> None:\n160\t        \"\"\"The countered spell's card should end up in its owner's graveyard.\"\"\"\n161\t        game = create_game()\n162\t        p1 = game.players[0]\n163\t        p2 = game.players[1]\n164\t\n165\t        dummy = _make_dummy_spell(name=\"Lightning Bolt\", mana_cost_str=\"{R}\", owner=p2)\n166\t        stack_obj = _put_spell_on_stack(game, 1, dummy)\n167\t\n168\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n169\t        sculpt.chosen_targets = [stack_obj]\n170\t        sculpt.on_resolve(game)\n171\t\n172\t        # The countered spell should be in the owner's graveyard\n173\t        gy = game.get_graveyard(p2)\n174\t        gy_cards = gy.get_all()\n175\t        assert any(c is dummy for c in gy_cards), (\n176\t            \"Countered spell should be in owner's graveyard\"\n177\t        )\n178\t\n179\t    def test_countered_spell_removed_from_stack(self) -> None:\n180\t        \"\"\"After countering, the targeted spell should no longer be on the stack.\"\"\"\n181\t        game = create_game()\n182\t        p1 = game.players[0]\n183\t        p2 = game.players[1]\n184\t\n185\t        dummy = _make_dummy_spell(owner=p2)\n186\t        stack_obj = _put_spell_on_stack(game, 1, dummy)\n187\t\n188\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n189\t        sculpt.chosen_targets = [stack_obj]\n190\t        sculpt.on_resolve(game)\n191\t\n192\t        # The stack should no longer contain the countered spell\n193\t        for item in game.stack._items:\n194\t            assert item is not stack_obj, (\n195\t                \"Countered StackObject should be removed from the stack\"\n196\t            )\n197\t\n198\t    def test_no_target_is_a_noop(self) -> None:\n199\t        \"\"\"If chosen_targets is empty or unset, resolution should not raise.\"\"\"\n200\t        game = create_game()\n201\t        p1 = game.players[0]\n202\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n203\t        # No chosen_targets set — should be safe\n204\t        sculpt.on_resolve(game)\n205\t\n206\t\n207\tclass TestManaSculptWizardCheck:\n208\t    \"\"\"The Wizard condition determines whether the delayed mana trigger fires.\"\"\"\n209\t\n210\t    def test_no_wizard_no_mana_added(self) -> None:\n211\t        \"\"\"Without a Wizard on the battlefield, no colorless mana should be added.\"\"\"\n212\t        game = create_game()\n213\t        p1 = game.players[0]\n214\t        p2 = game.players[1]\n215\t\n216\t        # No Wizard on p1's battlefield\n217\t        dummy = _make_dummy_spell(name=\"Big Spell\", mana_cost_str=\"{4}{R}\", owner=p2)\n218\t        stack_obj = _put_spell_on_stack(game, 1, dummy)\n219\t\n220\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n221\t        sculpt.chosen_targets = [stack_obj]\n222\t        sculpt.on_resolve(game)\n223\t\n224\t        # Advance to next main phase — no mana should appear\n225\t        initial_colorless = p1.mana_pool.get(ManaType.COLORLESS)\n226\t        # Try to trigger any delayed triggers by advancing phase\n227\t        game.phase = Phase.PRECOMBAT_MAIN\n228\t        game.step = None\n229\t        # Even after going to a main phase, no mana should be added since\n230\t        # no Wizard was controlled\n231\t        # The mana pool should not have increased\n232\t        assert p1.mana_pool.get(ManaType.COLORLESS) == initial_colorless\n233\t\n234\t    def test_with_wizard_triggers_mana_production(self) -> None:\n235\t        \"\"\"With a Wizard controlled, resolution should set up a delayed trigger\n236\t        that adds colorless mana equal to the countered spell's mana cost.\"\"\"\n237\t        game = create_game()\n238\t        p1 = game.players[0]\n239\t        p2 = game.players[1]\n240\t\n241\t        # Put a Wizard on p1's battlefield\n242\t        wizard = _make_wizard(owner=p1)\n243\t        set_board_state(game, 0, battlefield=[wizard])\n244\t\n245\t        # Put a spell costing {2}{R} (CMC=3 / total mana spent = 3) on the stack\n246\t        dummy = _make_dummy_spell(name=\"Expensive Spell\", mana_cost_str=\"{2}{R}\", owner=p2)\n247\t        stack_obj = _put_spell_on_stack(game, 1, dummy)\n248\t\n249\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n250\t        sculpt.chosen_targets = [stack_obj]\n251\t        sculpt.on_resolve(game)\n252\t\n253\t        # The delayed trigger should have been created. We need to check that\n254\t        # either: (a) a trigger was registered that will fire at next main phase,\n255\t        # or (b) the mana gets added when we advance to the next main phase.\n256\t        # We verify by checking that something changed (trigger registered or\n257\t        # mana was directly queued).\n258\t        triggers_before = len(game.trigger_manager.get_triggers())\n259\t        # There should be at least one trigger registered or some delayed\n260\t        # mechanism stored.\n261\t        # This test verifies the implementation creates a delayed mechanism.\n262\t        # Since the implementation doesn't exist yet, this will fail (TDD red).\n263\t        assert (\n264\t            triggers_before > 0\n265\t            or hasattr(sculpt, \"_delayed_mana\")\n266\t            or hasattr(p1, \"_delayed_mana_sculpt\")\n267\t        ), \"A delayed trigger or mana mechanism should be set up when Wizard is controlled\"\n268\t\n269\t\n270\tclass TestManaSculptDelayedMana:\n271\t    \"\"\"The delayed trigger should add {C} equal to the mana spent on the\n272\t    countered spell at the beginning of the controller's next main phase.\"\"\"\n273\t\n274\t    def test_mana_amount_equals_countered_spell_cmc(self) -> None:\n275\t        \"\"\"Colorless mana added should equal the mana spent to cast the\n276\t        countered spell. We approximate 'mana spent' as the spell's CMC.\"\"\"\n277\t        game = create_game()\n278\t        p1 = game.players[0]\n279\t        p2 = game.players[1]\n280\t\n281\t        wizard = _make_wizard(owner=p1)\n282\t        set_board_state(game, 0, battlefield=[wizard])\n283\t\n284\t        # Spell costs {3}{U}{U} — CMC = 5\n285\t        dummy = _make_dummy_spell(name=\"Big Blue\", mana_cost_str=\"{3}{U}{U}\", owner=p2)\n286\t        stack_obj = _put_spell_on_stack(game, 1, dummy)\n287\t\n288\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n289\t        sculpt.chosen_targets = [stack_obj]\n290\t\n291\t        initial_colorless = p1.mana_pool.get(ManaType.COLORLESS)\n292\t        sculpt.on_resolve(game)\n293\t\n294\t        # Now simulate the beginning of p1's next main phase.\n295\t        # Set up so p1 is the active player at precombat main.\n296\t        game.active_player_index = 0\n297\t        game.phase = Phase.PRECOMBAT_MAIN\n298\t        game.step = None\n299\t\n300\t        # Fire any registered triggers for the main phase beginning.\n301\t        # The implementation should register a delayed trigger that fires here.\n302\t        from engine.events import TriggeredEvent\n303\t\n304\t        # Try firing a generic phase-beginning event or check directly.\n305\t        # Process any triggers on the stack.\n306\t        while not game.stack.is_empty():\n307\t            obj = game.stack.pop()\n308\t            obj.on_resolve(game)\n309\t\n310\t        # After the delayed trigger resolves, colorless mana should increase by 5\n311\t        final_colorless = p1.mana_pool.get(ManaType.COLORLESS)\n312\t        assert final_colorless == initial_colorless + 5, (\n313\t            f\"Expected {initial_colorless + 5} colorless mana, got {final_colorless}\"\n314\t        )\n315\t\n316\t    def test_mana_amount_for_cheap_spell(self) -> None:\n317\t        \"\"\"A one-mana spell should yield 1 colorless mana.\"\"\"\n318\t        game = create_game()\n319\t        p1 = game.players[0]\n320\t        p2 = game.players[1]\n321\t\n322\t        wizard = _make_wizard(owner=p1)\n323\t        set_board_state(game, 0, battlefield=[wizard])\n324\t\n325\t        # Spell costs {R} — CMC = 1\n326\t        dummy = _make_dummy_spell(name=\"Shock\", mana_cost_str=\"{R}\", owner=p2)\n327\t        stack_obj = _put_spell_on_stack(game, 1, dummy)\n328\t\n329\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n330\t        sculpt.chosen_targets = [stack_obj]\n331\t\n332\t        initial_colorless = p1.mana_pool.get(ManaType.COLORLESS)\n333\t        sculpt.on_resolve(game)\n334\t\n335\t        # Advance to next main phase\n336\t        game.active_player_index = 0\n337\t        game.phase = Phase.PRECOMBAT_MAIN\n338\t        game.step = None\n339\t\n340\t        while not game.stack.is_empty():\n341\t            obj = game.stack.pop()\n342\t            obj.on_resolve(game)\n343\t\n344\t        final_colorless = p1.mana_pool.get(ManaType.COLORLESS)\n345\t        assert final_colorless == initial_colorless + 1\n346\t\n347\t    def test_mana_is_colorless(self) -> None:\n348\t        \"\"\"The mana added should be specifically colorless ({C}), not any color.\"\"\"\n349\t        game = create_game()\n350\t        p1 = game.players[0]\n351\t        p2 = game.players[1]\n352\t\n353\t        wizard = _make_wizard(owner=p1)\n354\t        set_board_state(game, 0, battlefield=[wizard])\n355\t\n356\t        dummy = _make_dummy_spell(name=\"Test\", mana_cost_str=\"{1}{G}\", owner=p2)\n357\t        stack_obj = _put_spell_on_stack(game, 1, dummy)\n358\t\n359\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n360\t        sculpt.chosen_targets = [stack_obj]\n361\t\n362\t        # Record all mana types before resolution\n363\t        mana_before = {mt: p1.mana_pool.get(mt) for mt in ManaType}\n364\t        sculpt.on_resolve(game)\n365\t\n366\t        # Advance to main phase\n367\t        game.active_player_index = 0\n368\t        game.phase = Phase.PRECOMBAT_MAIN\n369\t        game.step = None\n370\t\n371\t        while not game.stack.is_empty():\n372\t            obj = game.stack.pop()\n373\t            obj.on_resolve(game)\n374\t\n375\t        # Only colorless should have changed\n376\t        for mt in ManaType:\n377\t            if mt == ManaType.COLORLESS:\n378\t                assert p1.mana_pool.get(mt) == mana_before[mt] + 2, (\n379\t                    f\"Expected colorless mana to increase by 2 (CMC of {{1}}{{G}})\"\n380\t                )\n381\t            else:\n382\t                assert p1.mana_pool.get(mt) == mana_before[mt], (\n383\t                    f\"Non-colorless mana type {mt} should not change\"\n384\t                )\n385\t\n386\t\n387\tclass TestManaSculptEdgeCases:\n388\t    \"\"\"Edge cases and special interactions.\"\"\"\n389\t\n390\t    def test_wizard_leaves_before_resolve_no_mana(self) -> None:\n391\t        \"\"\"If the Wizard leaves the battlefield before Mana Sculpt resolves,\n392\t        no delayed mana trigger should be created (condition checked on resolve).\"\"\"\n393\t        game = create_game()\n394\t        p1 = game.players[0]\n395\t        p2 = game.players[1]\n396\t\n397\t        # Wizard exists on battlefield for setup\n398\t        wizard = _make_wizard(owner=p1)\n399\t        set_board_state(game, 0, battlefield=[wizard])\n400\t\n401\t        dummy = _make_dummy_spell(name=\"Target\", mana_cost_str=\"{3}\", owner=p2)\n402\t        stack_obj = _put_spell_on_stack(game, 1, dummy)\n403\t\n404\t        # Remove wizard before resolve\n405\t        bf = game.get_battlefield(p1)\n406\t        bf.remove(wizard)\n407\t\n408\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n409\t        sculpt.chosen_targets = [stack_obj]\n410\t        sculpt.on_resolve(game)\n411\t\n412\t        # No delayed trigger should fire — no mana at next main phase\n413\t        initial_colorless = p1.mana_pool.get(ManaType.COLORLESS)\n414\t        game.active_player_index = 0\n415\t        game.phase = Phase.PRECOMBAT_MAIN\n416\t        game.step = None\n417\t\n418\t        while not game.stack.is_empty():\n419\t            obj = game.stack.pop()\n420\t            obj.on_resolve(game)\n421\t\n422\t        assert p1.mana_pool.get(ManaType.COLORLESS) == initial_colorless\n423\t\n424\t    def test_spell_still_countered_even_without_wizard(self) -> None:\n425\t        \"\"\"The spell should be countered regardless of whether a Wizard is controlled.\n426\t        The Wizard only matters for the mana bonus.\"\"\"\n427\t        game = create_game()\n428\t        p1 = game.players[0]\n429\t        p2 = game.players[1]\n430\t\n431\t        # No Wizard on battlefield\n432\t        dummy = _make_dummy_spell(name=\"Target Spell\", mana_cost_str=\"{2}{B}\", owner=p2)\n433\t        stack_obj = _put_spell_on_stack(game, 1, dummy)\n434\t\n435\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n436\t        sculpt.chosen_targets = [stack_obj]\n437\t        sculpt.on_resolve(game)\n438\t\n439\t        # Spell should be countered (in graveyard)\n440\t        gy = game.get_graveyard(p2)\n441\t        assert any(c is dummy for c in gy.get_all()), (\n442\t            \"Spell should be countered even without a Wizard\"\n443\t        )\n444\t\n445\t    def test_counter_creature_spell(self) -> None:\n446\t        \"\"\"Mana Sculpt can counter any spell, not just instants/sorceries.\n447\t        Verify it works on a creature spell.\"\"\"\n448\t        game = create_game()\n449\t        p1 = game.players[0]\n450\t        p2 = game.players[1]\n451\t\n452\t        bear = Creature(\n453\t            name=\"Grizzly Bears\",\n454\t            owner=p2,\n455\t            controller=p2,\n456\t            base_power=2,\n457\t            base_toughness=2,\n458\t            mana_cost=ManaCost.parse(\"{1}{G}\"),\n459\t        )\n460\t        stack_obj = _put_spell_on_stack(game, 1, bear)\n461\t\n462\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n463\t        sculpt.chosen_targets = [stack_obj]\n464\t        sculpt.on_resolve(game)\n465\t\n466\t        # Bear should be countered — in graveyard, not on battlefield\n467\t        gy = game.get_graveyard(p2)\n468\t        assert any(c is bear for c in gy.get_all()), (\n469\t            \"Creature spell should be countered\"\n470\t        )\n471\t        bf = game.get_battlefield(p2)\n472\t        assert not any(c is bear for c in bf.get_all()), (\n473\t            \"Creature should not be on the battlefield after being countered\"\n474\t        )\n475\t\n476\t    def test_zero_cost_spell_yields_zero_mana(self) -> None:\n477\t        \"\"\"If the countered spell costs {0}, the delayed mana amount is 0.\"\"\"\n478\t        game = create_game()\n479\t        p1 = game.players[0]\n480\t        p2 = game.players[1]\n481\t\n482\t        wizard = _make_wizard(owner=p1)\n483\t        set_board_state(game, 0, battlefield=[wizard])\n484\t\n485\t        # A zero-cost spell (like Ornithopter as an instant for testing)\n486\t        zero_spell = Instant(\n487\t            name=\"Zero Cost\",\n488\t            owner=p2,\n489\t            mana_cost=ManaCost(generic=0, pips={}),\n490\t        )\n491\t        stack_obj = _put_spell_on_stack(game, 1, zero_spell)\n492\t\n493\t        sculpt = ManaSculpt(owner=p1, controller=p1)\n494\t        sculpt.chosen_targets = [stack_obj]\n495\t\n496\t        initial_colorless = p1.mana_pool.get(ManaType.COLORLESS)\n497\t        sculpt.on_resolve(game)\n498\t\n499\t        game.active_player_index = 0\n500\t        game.phase = Phase.PRECOMBAT_MAIN\n501\t        game.step = None\n502\t\n503\t        while not game.stack.is_empty():\n504\t            obj = game.stack.pop()\n505\t            obj.on_resolve(game)\n506\t\n507\t        # Should still be the same — zero mana produced\n508\t        assert p1.mana_pool.get(ManaType.COLORLESS) == initial_colorless\n509\t"}]},"parent_tool_use_id":"toolu_01CFVEaPR9TWhqHp3c8QBkd1","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f","uuid":"170013c7-ec42-4762-b46b-2d4d7ac07ff5","timestamp":"2026-05-28T11:30:18.805Z","subagent_type":"Implementer","task_description":"Revise sos_57 per review"}
