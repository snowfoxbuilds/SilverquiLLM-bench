{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LSEzTUFh3UryHFNiMxg76F","type":"tool_result","content":"1\t\"\"\"Card implementation for Fake Your Own Death.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom typing import TYPE_CHECKING, Any\n4\tfrom engine.card import CardImpl, Instant, Creature\n5\tfrom engine.continuous_effects import ContinuousEffect, DURATION_END_OF_TURN, Layer, SubLayer\n6\tfrom engine.types import CardType, ManaCost, TargetRequirement, Zone\n7\tfrom engine.events import CreatureDiesTriggeredEvent, EndOfTurnTriggeredEvent\n8\tif TYPE_CHECKING:\n9\t    from engine.game_state import GameState\n10\t\n11\tclass FakeYourOwnDeath(Instant):\n12\t    \"\"\"Fake Your Own Death — {1}{B} — Instant.\n13\t\n14\t    Until end of turn, target creature gets +2/+0 and gains \"When this\n15\t    creature dies, return it to the battlefield tapped under its owner's\n16\t    control and you create a Treasure token.\"\n17\t\n18\t    FDN collector number 174.\n19\t    \"\"\"\n20\t\n21\t    def __init__(self, **kwargs: Any) -> None:\n22\t        kwargs.setdefault('name', 'Fake Your Own Death')\n23\t        kwargs.setdefault('mana_cost', ManaCost.parse('{1}{B}'))\n24\t        kwargs.setdefault('rules_text', 'Until end of turn, target creature gets +2/+0 and gains \"When this creature dies, return it to the battlefield tapped under its owner\\'s control and you create a Treasure token.\"')\n25\t        super().__init__(**kwargs)\n26\t\n27\t    def get_targets(self, game: 'GameState') -> list:\n28\t        \"\"\"Target creature on the battlefield.\"\"\"\n29\t        return [TargetRequirement(filter_fn=lambda obj: CardType.CREATURE in getattr(obj, 'card_types', set()), description='target creature', zone=Zone.BATTLEFIELD)]\n30\t\n31\t    def on_resolve(self, game: 'GameState') -> None:\n32\t        \"\"\"Apply +2/+0 and death trigger until end of turn.\"\"\"\n33\t        from engine.game import create_token\n34\t        from engine.zones import move_to_zone\n35\t        from engine.triggers import TriggerRegistration\n36\t        chosen = getattr(self, 'chosen_targets', None)\n37\t        target = chosen[0] if chosen else None\n38\t        if target is None:\n39\t            return\n40\t        still_valid = False\n41\t        for player in game.players:\n42\t            if game.get_battlefield(player).contains(target):\n43\t                if CardType.CREATURE in getattr(target, 'card_types', set()):\n44\t                    still_valid = True\n45\t                    break\n46\t        if not still_valid:\n47\t            return\n48\t        creature_ref = target\n49\t        spell_controller = self.controller\n50\t\n51\t        def _apply_buff(game: Any) -> None:\n52\t            creature_ref.modified_power += 2\n53\t        game.effect_manager.add(ContinuousEffect(source=self, layer=Layer.POWER_TOUGHNESS, sublayer=SubLayer.MODIFY_PT, apply=_apply_buff, duration=DURATION_END_OF_TURN))\n54\t\n55\t        def _death_condition(game: Any, event: dict) -> bool:\n56\t            return event.creature is creature_ref\n57\t\n58\t        def _death_effect(game: 'GameState') -> None:\n59\t            owner = getattr(creature_ref, 'owner', spell_controller)\n60\t            move_to_zone(game, creature_ref, Zone.GRAVEYARD, Zone.BATTLEFIELD)\n61\t            creature_ref.is_tapped = True\n62\t            creature_ref.controller = owner\n63\t            if spell_controller is not None:\n64\t                treasure = CardImpl(name='Treasure', mana_cost=ManaCost(generic=0), rules_text='{T}, Sacrifice this token: Add one mana of any color.')\n65\t                treasure.card_types = {CardType.ARTIFACT}\n66\t                treasure.subtypes = {'Treasure'}\n67\t                treasure.is_token = True\n68\t                create_token(game, spell_controller, treasure)\n69\t        controller = getattr(self, 'controller', None) or game.active_player\n70\t\n71\t        class _DeathTriggerSentinel:\n72\t            pass\n73\t        sentinel = _DeathTriggerSentinel()\n74\t        game.trigger_manager.register(TriggerRegistration(event_type=CreatureDiesTriggeredEvent, condition=_death_condition, effect=_death_effect, source=sentinel, controller=controller))\n75\t        _sentinel_ref = sentinel\n76\t\n77\t        def _eot_cleanup_condition(game: Any, event: dict) -> bool:\n78\t            return True\n79\t\n80\t        def _eot_cleanup_effect(game: 'GameState') -> None:\n81\t            game.trigger_manager.unregister(_sentinel_ref)\n82\t        if hasattr(EventType, 'END_OF_TURN'):\n83\t            game.trigger_manager.register(TriggerRegistration(event_type=EndOfTurnTriggeredEvent, condition=_eot_cleanup_condition, effect=_eot_cleanup_effect, source=sentinel, controller=controller))\n84\t"}]},"parent_tool_use_id":"toolu_01H6edwdD9h9cdEHviTEV25h","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f","uuid":"3238bc82-48d4-402b-a48d-b560613ecd68","timestamp":"2026-05-28T11:07:52.628Z","subagent_type":"Implementer","task_description":"Implement sos_13"}
