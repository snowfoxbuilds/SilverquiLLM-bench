{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019PvxaruihoCgcpTfPQJWrw","type":"tool_result","content":"1\t\"\"\"Card implementation for Witherbloom, the Balancer.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.types import CardType, Keyword, ManaCost, Supertype\n9\t\n10\tif TYPE_CHECKING:\n11\t    from engine.game_state import GameState\n12\t\n13\t\n14\tdef _count_creatures(game: \"GameState\", player: Any) -> int:\n15\t    \"\"\"Count the number of creatures a player controls on the battlefield.\"\"\"\n16\t    bf = game.get_battlefield(player)\n17\t    count = 0\n18\t    for obj in bf.get_all():\n19\t        card_types = getattr(obj, \"card_types\", set())\n20\t        if CardType.CREATURE in card_types:\n21\t            count += 1\n22\t    return count\n23\t\n24\t\n25\tclass WitherbloomTheBalancer(Creature):\n26\t    \"\"\"Witherbloom, the Balancer -- {6}{B}{G} -- 5/5 Elder Dragon.\n27\t\n28\t    Affinity for creatures (This spell costs {1} less to cast for each\n29\t    creature you control.)\n30\t    Flying, deathtouch\n31\t    Instant and sorcery spells you cast have affinity for creatures.\n32\t\n33\t    SOS collector number 245.\n34\t    \"\"\"\n35\t\n36\t    def __init__(self, **kwargs: Any) -> None:\n37\t        kwargs.setdefault(\"name\", \"Witherbloom, the Balancer\")\n38\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{6}{B}{G}\"))\n39\t        kwargs.setdefault(\"base_power\", 5)\n40\t        kwargs.setdefault(\"base_toughness\", 5)\n41\t        kwargs.setdefault(\"supertypes\", set())\n42\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.LEGENDARY}\n43\t        kwargs.setdefault(\"subtypes\", set())\n44\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Elder\", \"Dragon\"}\n45\t        kwargs.setdefault(\"keywords\", Keyword(0))\n46\t        kwargs[\"keywords\"] = kwargs[\"keywords\"] | Keyword.FLYING | Keyword.DEATHTOUCH\n47\t        kwargs.setdefault(\n48\t            \"rules_text\",\n49\t            \"Affinity for creatures\\n\"\n50\t            \"Flying, deathtouch\\n\"\n51\t            \"Instant and sorcery spells you cast have affinity for creatures.\",\n52\t        )\n53\t        super().__init__(**kwargs)\n54\t\n55\t    # ------------------------------------------------------------------\n56\t    # Self affinity -- Affinity for creatures\n57\t    # ------------------------------------------------------------------\n58\t\n59\t    def cost_reduction(self, game: \"GameState\") -> int:\n60\t        \"\"\"Return the number of creatures the controller controls.\n61\t\n62\t        Affinity for creatures: this spell costs {1} less to cast for\n63\t        each creature you control. Returns the raw count; the engine's\n64\t        get_cost_reduction() clamps to generic cost.\n65\t        \"\"\"\n66\t        player = self.controller or self.owner\n67\t        if player is None:\n68\t            return 0\n69\t        return _count_creatures(game, player)\n70\t\n71\t    # ------------------------------------------------------------------\n72\t    # Grants affinity to instant and sorcery spells\n73\t    # ------------------------------------------------------------------\n74\t\n75\t    def _affinity_grant(self, game: \"GameState\", card: Any) -> int:\n76\t        \"\"\"Cost reduction grant for instants/sorceries cast by controller.\n77\t\n78\t        Returns the number of creatures the controller controls, but only\n79\t        if the card is an instant or sorcery controlled by the same player\n80\t        who controls Witherbloom.\n81\t        \"\"\"\n82\t        # Only grant affinity to instants and sorceries\n83\t        card_types = getattr(card, \"card_types\", set())\n84\t        if CardType.INSTANT not in card_types and CardType.SORCERY not in card_types:\n85\t            return 0\n86\t        # Only grant to spells controlled by our controller\n87\t        card_controller = getattr(card, \"controller\", None)\n88\t        our_controller = self.controller or self.owner\n89\t        if card_controller is None or our_controller is None:\n90\t            return 0\n91\t        if card_controller is not our_controller:\n92\t            return 0\n93\t        return _count_creatures(game, our_controller)\n94\t\n95\t    def register_triggers(self, game: \"GameState\") -> None:\n96\t        \"\"\"Register the affinity-granting effect for instants/sorceries.\n97\t\n98\t        Adds a cost reduction grant to the game state so that instants\n99\t        and sorceries cast by the controller get affinity for creatures.\n100\t        \"\"\"\n101\t        # Store reference to the grant function for later unregistration\n102\t        self._affinity_grant_fn = lambda g, c: self._affinity_grant(g, c)\n103\t\n104\t        # Register the cost reduction grant on the game state\n105\t        grants = getattr(game, \"_cost_reduction_grants\", None)\n106\t        if grants is None:\n107\t            game._cost_reduction_grants = []\n108\t            grants = game._cost_reduction_grants\n109\t        grants.append(self._affinity_grant_fn)\n110\t\n111\t    def _unregister_grants(self, game: \"GameState\") -> None:\n112\t        \"\"\"Remove the affinity grant when Witherbloom leaves the battlefield.\"\"\"\n113\t        grant_fn = getattr(self, \"_affinity_grant_fn\", None)\n114\t        if grant_fn is None:\n115\t            return\n116\t        grants = getattr(game, \"_cost_reduction_grants\", None)\n117\t        if grants is not None and grant_fn in grants:\n118\t            grants.remove(grant_fn)\n119\t"}]},"parent_tool_use_id":"toolu_013QMfyNeNrzXeXfbK67fwMN","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f","uuid":"f7f1dc04-b401-486f-b060-f5aba71731b8","timestamp":"2026-05-28T12:25:02.201Z","subagent_type":"Reviewer","task_description":"Review sos_245 implementation"}
