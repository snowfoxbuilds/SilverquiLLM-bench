{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017s2wKwskGnpkjJEYcKXErF","type":"tool_result","content":"1\t\"\"\"Tests for SOS 97 -- Ral Zarek, Guest Lecturer.\n2\t\n3\tRal Zarek, Guest Lecturer is a Legendary Planeswalker -- Ral.\n4\tCost: {1}{B}{B}, Starting Loyalty: 3.\n5\t\n6\tAbilities:\n7\t  +1: Surveil 2.\n8\t  -1: Any number of target players each discard a card.\n9\t  -2: Return target creature card with mana value 3 or less from your\n10\t      graveyard to the battlefield.\n11\t  -7: Flip five coins. Target opponent skips their next X turns, where X\n12\t      is the number of coins that came up heads.\n13\t\"\"\"\n14\t\n15\tfrom __future__ import annotations\n16\t\n17\timport pytest\n18\t\n19\tfrom cards.sos.sos_97.card_impl import RalZarekGuestLecturer\n20\tfrom engine.card import Creature, LoyaltyAbility, Planeswalker\n21\tfrom engine.types import (\n22\t    CardType,\n23\t    ManaCost,\n24\t    ManaType,\n25\t    Supertype,\n26\t    Zone,\n27\t)\n28\tfrom test_utils import create_game, set_board_state\n29\t\n30\t\n31\t# ---------------------------------------------------------------------------\n32\t# Static properties\n33\t# ---------------------------------------------------------------------------\n34\t\n35\t\n36\tclass TestRalZarekProperties:\n37\t    \"\"\"Verify static card data matches the SOS 97 spec.\"\"\"\n38\t\n39\t    def test_is_planeswalker(self) -> None:\n40\t        card = RalZarekGuestLecturer(owner=None)\n41\t        assert isinstance(card, Planeswalker)\n42\t\n43\t    def test_name(self) -> None:\n44\t        card = RalZarekGuestLecturer(owner=None)\n45\t        assert card.name == \"Ral Zarek, Guest Lecturer\"\n46\t\n47\t    def test_mana_cost(self) -> None:\n48\t        card = RalZarekGuestLecturer(owner=None)\n49\t        assert card.mana_cost == ManaCost.parse(\"{1}{B}{B}\")\n50\t\n51\t    def test_starting_loyalty(self) -> None:\n52\t        card = RalZarekGuestLecturer(owner=None)\n53\t        assert card.starting_loyalty == 3\n54\t        assert card.loyalty == 3\n55\t\n56\t    def test_is_legendary(self) -> None:\n57\t        card = RalZarekGuestLecturer(owner=None)\n58\t        assert Supertype.LEGENDARY in card.supertypes\n59\t\n60\t    def test_has_planeswalker_type(self) -> None:\n61\t        card = RalZarekGuestLecturer(owner=None)\n62\t        assert CardType.PLANESWALKER in card.card_types\n63\t\n64\t    def test_subtype_ral(self) -> None:\n65\t        card = RalZarekGuestLecturer(owner=None)\n66\t        assert \"Ral\" in card.subtypes\n67\t\n68\t\n69\t# ---------------------------------------------------------------------------\n70\t# Loyalty abilities structure\n71\t# ---------------------------------------------------------------------------\n72\t\n73\t\n74\tclass TestRalZarekLoyaltyAbilities:\n75\t    \"\"\"get_loyalty_abilities() should return exactly four abilities\n76\t    with the correct loyalty costs.\"\"\"\n77\t\n78\t    def test_returns_four_abilities(self) -> None:\n79\t        card = RalZarekGuestLecturer(owner=None)\n80\t        abilities = card.get_loyalty_abilities()\n81\t        assert isinstance(abilities, list)\n82\t        assert len(abilities) == 4\n83\t\n84\t    def test_all_are_loyalty_abilities(self) -> None:\n85\t        card = RalZarekGuestLecturer(owner=None)\n86\t        for ab in card.get_loyalty_abilities():\n87\t            assert isinstance(ab, LoyaltyAbility)\n88\t\n89\t    def test_first_ability_is_plus_one(self) -> None:\n90\t        card = RalZarekGuestLecturer(owner=None)\n91\t        abilities = card.get_loyalty_abilities()\n92\t        assert abilities[0].loyalty_cost == +1\n93\t\n94\t    def test_second_ability_is_minus_one(self) -> None:\n95\t        card = RalZarekGuestLecturer(owner=None)\n96\t        abilities = card.get_loyalty_abilities()\n97\t        assert abilities[1].loyalty_cost == -1\n98\t\n99\t    def test_third_ability_is_minus_two(self) -> None:\n100\t        card = RalZarekGuestLecturer(owner=None)\n101\t        abilities = card.get_loyalty_abilities()\n102\t        assert abilities[2].loyalty_cost == -2\n103\t\n104\t    def test_fourth_ability_is_minus_seven(self) -> None:\n105\t        card = RalZarekGuestLecturer(owner=None)\n106\t        abilities = card.get_loyalty_abilities()\n107\t        assert abilities[3].loyalty_cost == -7\n108\t\n109\t\n110\t# ---------------------------------------------------------------------------\n111\t# +1: Surveil 2\n112\t# ---------------------------------------------------------------------------\n113\t\n114\t\n115\tclass TestRalZarekSurveil:\n116\t    \"\"\"The +1 ability should surveil 2 -- look at the top 2 cards of the\n117\t    controller's library, putting any number into the graveyard and the\n118\t    rest back on top in any order.\"\"\"\n119\t\n120\t    def _make_game_with_ral(self):\n121\t        \"\"\"Create a game with Ral on p1's battlefield and library cards.\"\"\"\n122\t        game = create_game()\n123\t        p1 = game.players[0]\n124\t        ral = RalZarekGuestLecturer(owner=p1, controller=p1)\n125\t        ral.loyalty = 3\n126\t        set_board_state(game, 0, battlefield=[ral])\n127\t\n128\t        # Put known cards in the library\n129\t        card_a = Creature(name=\"Card A\", owner=p1, base_power=1, base_toughness=1)\n130\t        card_b = Creature(name=\"Card B\", owner=p1, base_power=2, base_toughness=2)\n131\t        card_c = Creature(name=\"Card C\", owner=p1, base_power=3, base_toughness=3)\n132\t        set_board_state(game, 0, hand=[])\n133\t        lib = game.get_library(p1)\n134\t        # Clear library and add cards: C on bottom, B, A on top\n135\t        for obj in lib.get_all():\n136\t            lib.remove(obj)\n137\t        lib.add(card_c)\n138\t        lib.add(card_b)\n139\t        lib.add(card_a)\n140\t        return game, ral, p1, card_a, card_b\n141\t\n142\t    def test_surveil_puts_cards_in_graveyard(self) -> None:\n143\t        \"\"\"When surveil 2, both cards can be put into the graveyard.\"\"\"\n144\t        game, ral, p1, card_a, card_b = self._make_game_with_ral()\n145\t        lib_before = len(game.get_library(p1))\n146\t        gy_before = len(game.get_graveyard(p1))\n147\t\n148\t        abilities = ral.get_loyalty_abilities()\n149\t        plus_one = abilities[0]\n150\t        # Script player choices to put both cards in graveyard\n151\t        p1._script.extend([card_a, card_b])  # choose both for graveyard\n152\t        plus_one.effect(game)\n153\t\n154\t        # After surveil 2, library should have lost 2 cards that went to GY\n155\t        lib_after = len(game.get_library(p1))\n156\t        gy_after = len(game.get_graveyard(p1))\n157\t        # At least some cards should have moved -- either to GY or back to library\n158\t        assert lib_after <= lib_before\n159\t\n160\t    def test_surveil_with_fewer_cards_than_surveil_count(self) -> None:\n161\t        \"\"\"Surveil with only 1 card in library should not error.\"\"\"\n162\t        game = create_game()\n163\t        p1 = game.players[0]\n164\t        ral = RalZarekGuestLecturer(owner=p1, controller=p1)\n165\t        ral.loyalty = 3\n166\t        set_board_state(game, 0, battlefield=[ral])\n167\t\n168\t        single_card = Creature(name=\"Only Card\", owner=p1, base_power=1, base_toughness=1)\n169\t        lib = game.get_library(p1)\n170\t        for obj in lib.get_all():\n171\t            lib.remove(obj)\n172\t        lib.add(single_card)\n173\t        set_board_state(game, 0, hand=[])\n174\t\n175\t        abilities = ral.get_loyalty_abilities()\n176\t        p1._script.extend([single_card])  # put the one card into GY\n177\t        # Should not raise even though library has fewer than 2 cards\n178\t        plus_one = abilities[0]\n179\t        plus_one.effect(game)\n180\t\n181\t\n182\t# ---------------------------------------------------------------------------\n183\t# -1: Any number of target players each discard a card\n184\t# ---------------------------------------------------------------------------\n185\t\n186\t\n187\tclass TestRalZarekDiscard:\n188\t    \"\"\"The -1 ability: any number of target players each discard a card.\"\"\"\n189\t\n190\t    def _make_game_with_ral_and_hands(self):\n191\t        game = create_game()\n192\t        p1 = game.players[0]\n193\t        p2 = game.players[1]\n194\t        ral = RalZarekGuestLecturer(owner=p1, controller=p1)\n195\t        ral.loyalty = 3\n196\t        set_board_state(game, 0, battlefield=[ral])\n197\t\n198\t        card_in_p1_hand = Creature(name=\"P1 Card\", owner=p1, base_power=1, base_toughness=1)\n199\t        card_in_p2_hand = Creature(name=\"P2 Card\", owner=p2, base_power=2, base_toughness=2)\n200\t        set_board_state(game, 0, hand=[card_in_p1_hand])\n201\t        set_board_state(game, 1, hand=[card_in_p2_hand])\n202\t        return game, ral, p1, p2, card_in_p1_hand, card_in_p2_hand\n203\t\n204\t    def test_opponent_discards_a_card(self) -> None:\n205\t        \"\"\"Targeting the opponent should cause them to discard a card.\"\"\"\n206\t        game, ral, p1, p2, _, card_p2 = self._make_game_with_ral_and_hands()\n207\t        abilities = ral.get_loyalty_abilities()\n208\t        minus_one = abilities[1]\n209\t\n210\t        # Script: choose p2 as target, p2 chooses which card to discard\n211\t        p2._script.extend([card_p2])  # opponent chooses card to discard\n212\t        ral.chosen_targets = [p2]\n213\t        minus_one.effect(game)\n214\t\n215\t        assert len(game.get_hand(p2).get_all()) == 0\n216\t        gy_cards = game.get_graveyard(p2).get_all()\n217\t        assert any(getattr(c, \"name\", \"\") == \"P2 Card\" for c in gy_cards)\n218\t\n219\t    def test_both_players_discard(self) -> None:\n220\t        \"\"\"Targeting both players should make each discard a card.\"\"\"\n221\t        game, ral, p1, p2, card_p1, card_p2 = self._make_game_with_ral_and_hands()\n222\t        abilities = ral.get_loyalty_abilities()\n223\t        minus_one = abilities[1]\n224\t\n225\t        # Script discard choices for both players\n226\t        p1._script.extend([card_p1])\n227\t        p2._script.extend([card_p2])\n228\t        ral.chosen_targets = [p1, p2]\n229\t        minus_one.effect(game)\n230\t\n231\t        assert len(game.get_hand(p1).get_all()) == 0\n232\t        assert len(game.get_hand(p2).get_all()) == 0\n233\t\n234\t    def test_targeting_zero_players_is_allowed(self) -> None:\n235\t        \"\"\"Targeting zero players (empty target list) should be a no-op.\"\"\"\n236\t        game, ral, p1, p2, _, _ = self._make_game_with_ral_and_hands()\n237\t        abilities = ral.get_loyalty_abilities()\n238\t        minus_one = abilities[1]\n239\t\n240\t        ral.chosen_targets = []\n241\t        minus_one.effect(game)\n242\t\n243\t        # Hands should be unchanged\n244\t        assert len(game.get_hand(p1).get_all()) == 1\n245\t        assert len(game.get_hand(p2).get_all()) == 1\n246\t\n247\t    def test_player_with_empty_hand_no_error(self) -> None:\n248\t        \"\"\"A targeted player with no cards in hand should not raise an error.\"\"\"\n249\t        game = create_game()\n250\t        p1 = game.players[0]\n251\t        p2 = game.players[1]\n252\t        ral = RalZarekGuestLecturer(owner=p1, controller=p1)\n253\t        ral.loyalty = 3\n254\t        set_board_state(game, 0, battlefield=[ral])\n255\t        set_board_state(game, 1, hand=[])  # empty hand\n256\t\n257\t        abilities = ral.get_loyalty_abilities()\n258\t        minus_one = abilities[1]\n259\t        ral.chosen_targets = [p2]\n260\t        # Should not raise\n261\t        minus_one.effect(game)\n262\t\n263\t        assert len(game.get_hand(p2).get_all()) == 0\n264\t\n265\t\n266\t# ---------------------------------------------------------------------------\n267\t# -2: Return target creature card with mana value 3 or less from your\n268\t#     graveyard to the battlefield\n269\t# ---------------------------------------------------------------------------\n270\t\n271\t\n272\tclass TestRalZarekReanimate:\n273\t    \"\"\"The -2 ability returns a creature with MV <= 3 from the graveyard\n274\t    to the battlefield.\"\"\"\n275\t\n276\t    def _make_game_with_ral_and_graveyard(self):\n277\t        game = create_game()\n278\t        p1 = game.players[0]\n279\t        ral = RalZarekGuestLecturer(owner=p1, controller=p1)\n280\t        ral.loyalty = 5  # enough for -2\n281\t        set_board_state(game, 0, battlefield=[ral])\n282\t        return game, ral, p1\n283\t\n284\t    def test_returns_creature_to_battlefield(self) -> None:\n285\t        \"\"\"A creature with MV <= 3 in the graveyard moves to the battlefield.\"\"\"\n286\t        game, ral, p1 = self._make_game_with_ral_and_graveyard()\n287\t\n288\t        # MV 2 creature in graveyard\n289\t        bear = Creature(\n290\t            name=\"Grizzly Bears\", owner=p1, controller=p1,\n291\t            base_power=2, base_toughness=2,\n292\t            mana_cost=ManaCost.parse(\"{1}{G}\"),\n293\t        )\n294\t        set_board_state(game, 0, graveyard=[bear])\n295\t\n296\t        abilities = ral.get_loyalty_abilities()\n297\t        minus_two = abilities[2]\n298\t        ral.chosen_targets = [bear]\n299\t        minus_two.effect(game)\n300\t\n301\t        bf_objects = game.get_battlefield(p1).get_all()\n302\t        assert any(obj is bear for obj in bf_objects), \\\n303\t            \"The creature should have moved from graveyard to battlefield.\"\n304\t        gy_objects = game.get_graveyard(p1).get_all()\n305\t        assert all(obj is not bear for obj in gy_objects), \\\n306\t            \"The creature should no longer be in the graveyard.\"\n307\t\n308\t    def test_creature_with_mv_3_is_valid(self) -> None:\n309\t        \"\"\"A creature with mana value exactly 3 is a valid target.\"\"\"\n310\t        game, ral, p1 = self._make_game_with_ral_and_graveyard()\n311\t\n312\t        creature_mv3 = Creature(\n313\t            name=\"MV3 Creature\", owner=p1, controller=p1,\n314\t            base_power=3, base_toughness=3,\n315\t            mana_cost=ManaCost.parse(\"{2}{B}\"),\n316\t        )\n317\t        set_board_state(game, 0, graveyard=[creature_mv3])\n318\t\n319\t        abilities = ral.get_loyalty_abilities()\n320\t        minus_two = abilities[2]\n321\t        ral.chosen_targets = [creature_mv3]\n322\t        minus_two.effect(game)\n323\t\n324\t        bf = game.get_battlefield(p1).get_all()\n325\t        assert any(obj is creature_mv3 for obj in bf)\n326\t\n327\t    def test_creature_with_mv_0_is_valid(self) -> None:\n328\t        \"\"\"A creature with mana value 0 is a valid target.\"\"\"\n329\t        game, ral, p1 = self._make_game_with_ral_and_graveyard()\n330\t\n331\t        token_like = Creature(\n332\t            name=\"Zero Cost\", owner=p1, controller=p1,\n333\t            base_power=0, base_toughness=1,\n334\t            mana_cost=ManaCost(generic=0),\n335\t        )\n336\t        set_board_state(game, 0, graveyard=[token_like])\n337\t\n338\t        abilities = ral.get_loyalty_abilities()\n339\t        minus_two = abilities[2]\n340\t        ral.chosen_targets = [token_like]\n341\t        minus_two.effect(game)\n342\t\n343\t        bf = game.get_battlefield(p1).get_all()\n344\t        assert any(obj is token_like for obj in bf)\n345\t\n346\t    def test_no_target_is_noop(self) -> None:\n347\t        \"\"\"If no target is set, the ability should not raise.\"\"\"\n348\t        game, ral, p1 = self._make_game_with_ral_and_graveyard()\n349\t        set_board_state(game, 0, graveyard=[])\n350\t\n351\t        abilities = ral.get_loyalty_abilities()\n352\t        minus_two = abilities[2]\n353\t        ral.chosen_targets = []\n354\t        # Should not raise\n355\t        minus_two.effect(game)\n356\t\n357\t    def test_graveyard_targeting_filter(self) -> None:\n358\t        \"\"\"The targeting requirement should filter for creatures in the\n359\t        graveyard with MV <= 3.\"\"\"\n360\t        game = create_game()\n361\t        p1 = game.players[0]\n362\t        ral = RalZarekGuestLecturer(owner=p1, controller=p1)\n363\t\n364\t        mv2_creature = Creature(\n365\t            name=\"Small Creature\", base_power=1, base_toughness=1,\n366\t            mana_cost=ManaCost.parse(\"{1}{B}\"),\n367\t        )\n368\t        mv2_creature.card_types = {CardType.CREATURE}\n369\t\n370\t        mv5_creature = Creature(\n371\t            name=\"Big Creature\", base_power=5, base_toughness=5,\n372\t            mana_cost=ManaCost.parse(\"{3}{B}{B}\"),\n373\t        )\n374\t        mv5_creature.card_types = {CardType.CREATURE}\n375\t\n376\t        # Check that get_targets advertises graveyard filtering\n377\t        targets = ral.get_targets(game)\n378\t        # The third ability (index 2) should have a targeting requirement\n379\t        # that filters creatures with MV <= 3 in the graveyard.\n380\t        # Implementation may also use per-ability get_targets.\n381\t        # We verify the filter accepts MV<=3 creatures and rejects MV>3.\n382\t        found_gy_req = False\n383\t        for req in targets:\n384\t            if req.zone == Zone.GRAVEYARD:\n385\t                found_gy_req = True\n386\t                assert req.filter_fn(mv2_creature) is True\n387\t                assert req.filter_fn(mv5_creature) is False\n388\t                break\n389\t\n390\t        if not found_gy_req and len(targets) == 0:\n391\t            # Alternative: per-ability targeting -- test by direct ability invocation\n392\t            # (covered by other tests in this class)\n393\t            pass\n394\t\n395\t\n396\t# ---------------------------------------------------------------------------\n397\t# -7: Flip five coins. Target opponent skips their next X turns\n398\t# ---------------------------------------------------------------------------\n399\t\n400\t\n401\tclass TestRalZarekUltimate:\n402\t    \"\"\"The -7 ability flips five coins and the target opponent skips\n403\t    their next X turns (X = heads count).\"\"\"\n404\t\n405\t    def _make_game_with_ral_at_7(self):\n406\t        game = create_game()\n407\t        p1 = game.players[0]\n408\t        p2 = game.players[1]\n409\t        ral = RalZarekGuestLecturer(owner=p1, controller=p1)\n410\t        ral.loyalty = 7\n411\t        set_board_state(game, 0, battlefield=[ral])\n412\t        return game, ral, p1, p2\n413\t\n414\t    def test_all_heads_skips_five_turns(self) -> None:\n415\t        \"\"\"If all 5 coins come up heads, opponent skips 5 turns.\"\"\"\n416\t        import random\n417\t        game, ral, p1, p2 = self._make_game_with_ral_at_7()\n418\t\n419\t        abilities = ral.get_loyalty_abilities()\n420\t        ultimate = abilities[3]\n421\t        ral.chosen_targets = [p2]\n422\t\n423\t        # Monkey-patch random to always return heads\n424\t        old_choice = random.choice\n425\t        old_randint = random.randint\n426\t        try:\n427\t            random.choice = lambda seq: seq[0]  # always first = heads\n428\t            random.randint = lambda a, b: 1  # 1 = heads\n429\t            ultimate.effect(game)\n430\t        finally:\n431\t            random.choice = old_choice\n432\t            random.randint = old_randint\n433\t\n434\t        # Opponent should skip 5 turns -- check via extra_turns or skip_turns\n435\t        # The engine uses game.extra_turns for extra turn tracking.\n436\t        # For skipping turns, the implementation should track skipped turns\n437\t        # either on the player or game state.\n438\t        skip_count = getattr(p2, \"skip_turns\", 0)\n439\t        # Alternative: check if game uses some other mechanism\n440\t        if skip_count == 0:\n441\t            # Maybe the implementation uses extra_turns for p1 instead\n442\t            # (giving p1 extra turns is equivalent to opponent \"skipping\")\n443\t            p1_extra_turns = sum(\n444\t                1 for t in game.extra_turns\n445\t                if t == 0  # p1 index\n446\t            )\n447\t            assert p1_extra_turns == 5 or skip_count == 5, \\\n448\t                \"Opponent should skip 5 turns (all heads).\"\n449\t        else:\n450\t            assert skip_count == 5\n451\t\n452\t    def test_all_tails_skips_zero_turns(self) -> None:\n453\t        \"\"\"If all 5 coins come up tails, opponent skips 0 turns.\"\"\"\n454\t        import random\n455\t        game, ral, p1, p2 = self._make_game_with_ral_at_7()\n456\t\n457\t        abilities = ral.get_loyalty_abilities()\n458\t        ultimate = abilities[3]\n459\t        ral.chosen_targets = [p2]\n460\t\n461\t        old_choice = random.choice\n462\t        old_randint = random.randint\n463\t        try:\n464\t            random.choice = lambda seq: seq[-1]  # always last = tails\n465\t            random.randint = lambda a, b: 0  # 0 = tails\n466\t            ultimate.effect(game)\n467\t        finally:\n468\t            random.choice = old_choice\n469\t            random.randint = old_randint\n470\t\n471\t        # Zero turns skipped -- no extra turns and no skip marker\n472\t        skip_count = getattr(p2, \"skip_turns\", 0)\n473\t        p1_extra = sum(1 for t in game.extra_turns if t == 0)\n474\t        assert skip_count == 0 or p1_extra == 0, \\\n475\t            \"With all tails, no turns should be skipped.\"\n476\t\n477\t    def test_no_target_is_noop(self) -> None:\n478\t        \"\"\"If there is no target, the ability should not crash.\"\"\"\n479\t        game, ral, p1, p2 = self._make_game_with_ral_at_7()\n480\t\n481\t        abilities = ral.get_loyalty_abilities()\n482\t        ultimate = abilities[3]\n483\t        ral.chosen_targets = []\n484\t        # Should not raise\n485\t        ultimate.effect(game)\n486\t"}]},"parent_tool_use_id":"toolu_01FDMEtpQ3ZvLTtxxDBywmQp","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f","uuid":"f6c2f139-3e3e-4d89-bd1c-73fb1d450c72","timestamp":"2026-05-28T11:41:10.628Z","subagent_type":"Reviewer","task_description":"Review sos_97 implementation"}
