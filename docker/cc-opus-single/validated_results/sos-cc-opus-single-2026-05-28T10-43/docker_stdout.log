{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RW9ErBYjJSkXcohCqVGs9L","type":"tool_result","content":"1\t\"\"\"Tests for SOS 201 — Lorehold, the Historian.\n2\t\n3\tCard spec:\n4\t  Name: Lorehold, the Historian\n5\t  Mana cost: {3}{R}{W}\n6\t  Type: Legendary Creature — Elder Dragon\n7\t  Oracle text:\n8\t    Flying, haste\n9\t    Each instant and sorcery card in your hand has miracle {2}.\n10\t    At the beginning of each opponent's upkeep, you may discard a card.\n11\t    If you do, draw a card.\n12\t  Power/Toughness: 5/5\n13\t  Keywords: Flying, Haste\n14\t\"\"\"\n15\t\n16\tfrom __future__ import annotations\n17\t\n18\timport pytest\n19\t\n20\tfrom cards.sos.sos_201.card_impl import LoreholdTheHistorian\n21\tfrom engine.card import Creature, Instant, Sorcery\n22\tfrom engine.events import (\n23\t    BeginningOfUpkeepTriggeredEvent,\n24\t    DrawsCardTriggeredEvent,\n25\t)\n26\tfrom engine.triggers import TriggerRegistration\n27\tfrom engine.types import (\n28\t    CardType,\n29\t    Keyword,\n30\t    ManaCost,\n31\t    ManaType,\n32\t    Supertype,\n33\t    Zone,\n34\t)\n35\tfrom test_utils import create_game, set_board_state\n36\t\n37\t\n38\t# ---------------------------------------------------------------------------\n39\t# Static properties\n40\t# ---------------------------------------------------------------------------\n41\t\n42\t\n43\tclass TestLoreholdProperties:\n44\t    \"\"\"Static card data should match the SOS 201 spec.\"\"\"\n45\t\n46\t    def test_is_creature(self) -> None:\n47\t        card = LoreholdTheHistorian(owner=None)\n48\t        assert isinstance(card, Creature)\n49\t\n50\t    def test_name(self) -> None:\n51\t        card = LoreholdTheHistorian(owner=None)\n52\t        assert card.name == \"Lorehold, the Historian\"\n53\t\n54\t    def test_mana_cost(self) -> None:\n55\t        card = LoreholdTheHistorian(owner=None)\n56\t        assert card.mana_cost == ManaCost.parse(\"{3}{R}{W}\")\n57\t\n58\t    def test_power_toughness(self) -> None:\n59\t        card = LoreholdTheHistorian(owner=None)\n60\t        assert card.base_power == 5\n61\t        assert card.base_toughness == 5\n62\t\n63\t    def test_has_flying(self) -> None:\n64\t        card = LoreholdTheHistorian(owner=None)\n65\t        assert Keyword.FLYING in card.keywords\n66\t\n67\t    def test_has_haste(self) -> None:\n68\t        card = LoreholdTheHistorian(owner=None)\n69\t        assert Keyword.HASTE in card.keywords\n70\t\n71\t    def test_legendary_supertype(self) -> None:\n72\t        card = LoreholdTheHistorian(owner=None)\n73\t        assert Supertype.LEGENDARY in card.supertypes\n74\t\n75\t    def test_elder_dragon_subtypes(self) -> None:\n76\t        card = LoreholdTheHistorian(owner=None)\n77\t        assert \"Elder\" in card.subtypes\n78\t        assert \"Dragon\" in card.subtypes\n79\t\n80\t\n81\t# ---------------------------------------------------------------------------\n82\t# Miracle granting — instants and sorceries in hand get miracle {2}\n83\t# ---------------------------------------------------------------------------\n84\t\n85\t\n86\tclass TestLoreholdMiracleGrant:\n87\t    \"\"\"Each instant and sorcery card in your hand has miracle {2}.\n88\t\n89\t    Lorehold grants the miracle keyword ability to all instant and sorcery\n90\t    cards in the controller's hand. This is a continuous/static ability that\n91\t    should be checkable on cards in hand while Lorehold is on the battlefield.\n92\t    \"\"\"\n93\t\n94\t    def test_instant_in_hand_has_miracle(self) -> None:\n95\t        \"\"\"An instant card in the controller's hand should have miracle {2}\n96\t        when Lorehold is on the battlefield.\"\"\"\n97\t        game = create_game()\n98\t        p1 = game.players[0]\n99\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n100\t        instant = Instant(name=\"Test Bolt\", owner=p1, controller=p1,\n101\t                          mana_cost=ManaCost.parse(\"{R}\"))\n102\t\n103\t        set_board_state(game, 0, battlefield=[lorehold], hand=[instant])\n104\t        lorehold.register_triggers(game)\n105\t\n106\t        # The instant in hand should have a miracle cost of {2}\n107\t        miracle_cost = getattr(instant, \"miracle_cost\", None)\n108\t        assert miracle_cost is not None, \"Instant in hand should have miracle_cost\"\n109\t        assert miracle_cost == ManaCost.parse(\"{2}\") or miracle_cost == 2\n110\t\n111\t    def test_sorcery_in_hand_has_miracle(self) -> None:\n112\t        \"\"\"A sorcery card in the controller's hand should have miracle {2}\n113\t        when Lorehold is on the battlefield.\"\"\"\n114\t        game = create_game()\n115\t        p1 = game.players[0]\n116\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n117\t        sorcery = Sorcery(name=\"Test Divination\", owner=p1, controller=p1,\n118\t                          mana_cost=ManaCost.parse(\"{2}{U}\"))\n119\t\n120\t        set_board_state(game, 0, battlefield=[lorehold], hand=[sorcery])\n121\t        lorehold.register_triggers(game)\n122\t\n123\t        miracle_cost = getattr(sorcery, \"miracle_cost\", None)\n124\t        assert miracle_cost is not None, \"Sorcery in hand should have miracle_cost\"\n125\t        assert miracle_cost == ManaCost.parse(\"{2}\") or miracle_cost == 2\n126\t\n127\t    def test_creature_in_hand_does_not_get_miracle(self) -> None:\n128\t        \"\"\"Non-instant/sorcery cards should NOT get miracle from Lorehold.\"\"\"\n129\t        game = create_game()\n130\t        p1 = game.players[0]\n131\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n132\t        creature = Creature(name=\"Grizzly Bears\", owner=p1, controller=p1,\n133\t                            base_power=2, base_toughness=2)\n134\t\n135\t        set_board_state(game, 0, battlefield=[lorehold], hand=[creature])\n136\t        lorehold.register_triggers(game)\n137\t\n138\t        miracle_cost = getattr(creature, \"miracle_cost\", None)\n139\t        assert miracle_cost is None, \"Creature should not get miracle from Lorehold\"\n140\t\n141\t    def test_opponent_instants_do_not_get_miracle(self) -> None:\n142\t        \"\"\"Instants in the opponent's hand should NOT get miracle from Lorehold.\"\"\"\n143\t        game = create_game()\n144\t        p1 = game.players[0]\n145\t        p2 = game.players[1]\n146\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n147\t        opp_instant = Instant(name=\"Opponent Bolt\", owner=p2, controller=p2,\n148\t                              mana_cost=ManaCost.parse(\"{R}\"))\n149\t\n150\t        set_board_state(game, 0, battlefield=[lorehold])\n151\t        set_board_state(game, 1, hand=[opp_instant])\n152\t        lorehold.register_triggers(game)\n153\t\n154\t        miracle_cost = getattr(opp_instant, \"miracle_cost\", None)\n155\t        assert miracle_cost is None, \"Opponent's instant should not get miracle\"\n156\t\n157\t\n158\t# ---------------------------------------------------------------------------\n159\t# Miracle trigger — first card drawn this turn can be cast for miracle cost\n160\t# ---------------------------------------------------------------------------\n161\t\n162\t\n163\tclass TestLoreholdMiracleTrigger:\n164\t    \"\"\"The miracle mechanic allows casting a drawn instant/sorcery for {2}\n165\t    if it is the first card drawn this turn. Per rule 702.94a, when a card\n166\t    with miracle is drawn as the first card of the turn, the player may\n167\t    reveal it and cast it for the miracle cost.\n168\t    \"\"\"\n169\t\n170\t    def test_miracle_trigger_on_first_draw_of_instant(self) -> None:\n171\t        \"\"\"When the first card drawn this turn is an instant with miracle\n172\t        (granted by Lorehold), a miracle trigger should fire or the card\n173\t        should become castable for {2}.\"\"\"\n174\t        game = create_game()\n175\t        p1 = game.players[0]\n176\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n177\t\n178\t        instant = Instant(name=\"Miracle Bolt\", owner=p1, controller=p1,\n179\t                          mana_cost=ManaCost.parse(\"{3}{R}\"))\n180\t\n181\t        set_board_state(game, 0, battlefield=[lorehold])\n182\t        lorehold.register_triggers(game)\n183\t\n184\t        # Put the instant on top of library\n185\t        game.get_library(p1).add(instant)\n186\t\n187\t        # Reset cards drawn tracker\n188\t        if hasattr(p1, \"cards_drawn_this_turn\"):\n189\t            p1.cards_drawn_this_turn = 0\n190\t\n191\t        # Draw the card (first card this turn)\n192\t        from engine.game import draw_card\n193\t        drawn = draw_card(game, p1)\n194\t\n195\t        assert drawn is instant, \"Should have drawn the instant\"\n196\t\n197\t        # After drawing, there should be a miracle opportunity:\n198\t        # either a trigger on the stack or the card should be flagged\n199\t        # for miracle casting at cost {2}\n200\t        miracle_available = (\n201\t            not game.stack.is_empty()\n202\t            or getattr(instant, \"_miracle_revealed\", False)\n203\t            or getattr(instant, \"miracle_triggered\", False)\n204\t        )\n205\t        assert miracle_available, (\n206\t            \"Drawing an instant as first card should create miracle opportunity\"\n207\t        )\n208\t\n209\t    def test_no_miracle_on_second_draw(self) -> None:\n210\t        \"\"\"Miracle only triggers on the FIRST card drawn each turn.\n211\t        A second drawn card should not get a miracle trigger.\"\"\"\n212\t        game = create_game()\n213\t        p1 = game.players[0]\n214\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n215\t\n216\t        first_card = Instant(name=\"First Draw\", owner=p1, controller=p1,\n217\t                             mana_cost=ManaCost.parse(\"{R}\"))\n218\t        second_card = Instant(name=\"Second Draw\", owner=p1, controller=p1,\n219\t                              mana_cost=ManaCost.parse(\"{U}\"))\n220\t\n221\t        set_board_state(game, 0, battlefield=[lorehold])\n222\t        lorehold.register_triggers(game)\n223\t\n224\t        # Put both cards on top of library (second_card on top)\n225\t        game.get_library(p1).add(first_card)\n226\t        game.get_library(p1).add(second_card)\n227\t\n228\t        # Reset\n229\t        if hasattr(p1, \"cards_drawn_this_turn\"):\n230\t            p1.cards_drawn_this_turn = 0\n231\t\n232\t        from engine.game import draw_card\n233\t\n234\t        # First draw — miracle eligible\n235\t        draw_card(game, p1)\n236\t\n237\t        # Clear any stack objects from first draw miracle\n238\t        while not game.stack.is_empty():\n239\t            game.stack.pop()\n240\t\n241\t        stack_before = len(game.stack)\n242\t\n243\t        # Second draw — should NOT miracle\n244\t        drawn2 = draw_card(game, p1)\n245\t        assert drawn2 is first_card\n246\t\n247\t        # No new miracle trigger on stack for the second draw\n248\t        miracle_triggered_second = (\n249\t            getattr(first_card, \"_miracle_revealed\", False)\n250\t            or getattr(first_card, \"miracle_triggered\", False)\n251\t        )\n252\t        # The second card drawn should not have miracle triggered\n253\t        assert not miracle_triggered_second or len(game.stack) == stack_before, (\n254\t            \"Second card drawn this turn should not get miracle trigger\"\n255\t        )\n256\t\n257\t    def test_miracle_not_triggered_for_creature_draw(self) -> None:\n258\t        \"\"\"When the first card drawn is a creature (not an instant or\n259\t        sorcery), miracle should NOT trigger even though Lorehold is on\n260\t        the battlefield.\"\"\"\n261\t        game = create_game()\n262\t        p1 = game.players[0]\n263\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n264\t\n265\t        creature = Creature(name=\"Bear Draw\", owner=p1, controller=p1,\n266\t                            base_power=2, base_toughness=2)\n267\t\n268\t        set_board_state(game, 0, battlefield=[lorehold])\n269\t        lorehold.register_triggers(game)\n270\t\n271\t        game.get_library(p1).add(creature)\n272\t\n273\t        if hasattr(p1, \"cards_drawn_this_turn\"):\n274\t            p1.cards_drawn_this_turn = 0\n275\t\n276\t        from engine.game import draw_card\n277\t        stack_before = len(game.stack)\n278\t        draw_card(game, p1)\n279\t\n280\t        # Creature should not trigger miracle\n281\t        miracle_on_creature = (\n282\t            getattr(creature, \"_miracle_revealed\", False)\n283\t            or getattr(creature, \"miracle_triggered\", False)\n284\t        )\n285\t        assert not miracle_on_creature, (\n286\t            \"Creature should not get miracle trigger\"\n287\t        )\n288\t\n289\t\n290\t# ---------------------------------------------------------------------------\n291\t# Upkeep trigger — discard to draw (looting) at opponent's upkeep\n292\t# ---------------------------------------------------------------------------\n293\t\n294\t\n295\tclass TestLoreholdUpkeepTrigger:\n296\t    \"\"\"At the beginning of each opponent's upkeep, you may discard a card.\n297\t    If you do, draw a card.\n298\t\n299\t    This is a triggered ability that triggers at the beginning of each\n300\t    opponent's upkeep, offering the controller a may-discard-then-draw.\n301\t    \"\"\"\n302\t\n303\t    def test_registers_upkeep_trigger(self) -> None:\n304\t        \"\"\"Lorehold should register a triggered ability that watches for\n305\t        the beginning of upkeep events.\"\"\"\n306\t        game = create_game()\n307\t        p1 = game.players[0]\n308\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n309\t\n310\t        before_count = len(game.trigger_manager.get_triggers())\n311\t        lorehold.register_triggers(game)\n312\t        after_count = len(game.trigger_manager.get_triggers())\n313\t\n314\t        assert after_count > before_count, (\n315\t            \"Lorehold should register at least one trigger\"\n316\t        )\n317\t\n318\t    def test_trigger_fires_on_opponent_upkeep(self) -> None:\n319\t        \"\"\"The looting trigger should fire when the opponent's upkeep\n320\t        begins (Lorehold's controller is not the active player).\"\"\"\n321\t        game = create_game()\n322\t        p1 = game.players[0]\n323\t        p2 = game.players[1]\n324\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n325\t\n326\t        set_board_state(game, 0, battlefield=[lorehold])\n327\t        lorehold.register_triggers(game)\n328\t\n329\t        # Set active player to opponent (p2)\n330\t        game.active_player_index = 1\n331\t\n332\t        # Fire the upkeep event\n333\t        game.trigger_manager.fire_event(\n334\t            game, BeginningOfUpkeepTriggeredEvent()\n335\t        )\n336\t\n337\t        # There should be a trigger on the stack\n338\t        assert not game.stack.is_empty(), (\n339\t            \"Trigger should fire on opponent's upkeep\"\n340\t        )\n341\t\n342\t    def test_trigger_does_not_fire_on_own_upkeep(self) -> None:\n343\t        \"\"\"The trigger says 'each opponent's upkeep', so it should NOT\n344\t        fire during the controller's own upkeep.\"\"\"\n345\t        game = create_game()\n346\t        p1 = game.players[0]\n347\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n348\t\n349\t        set_board_state(game, 0, battlefield=[lorehold])\n350\t        lorehold.register_triggers(game)\n351\t\n352\t        # Active player is p1 (Lorehold's controller)\n353\t        game.active_player_index = 0\n354\t\n355\t        game.trigger_manager.fire_event(\n356\t            game, BeginningOfUpkeepTriggeredEvent()\n357\t        )\n358\t\n359\t        # No trigger should be on the stack\n360\t        assert game.stack.is_empty(), (\n361\t            \"Trigger should NOT fire on controller's own upkeep\"\n362\t        )\n363\t\n364\t    def test_upkeep_discard_then_draw(self) -> None:\n365\t        \"\"\"When the trigger resolves and the player chooses 'yes' to\n366\t        discard, they discard a card then draw a card.\"\"\"\n367\t        game = create_game(scripts=([True], []))  # p1 says \"yes\" to may\n368\t        p1 = game.players[0]\n369\t        p2 = game.players[1]\n370\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n371\t\n372\t        # Give p1 a card in hand to discard\n373\t        discard_card = Instant(name=\"Fodder\", owner=p1, controller=p1,\n374\t                               mana_cost=ManaCost.parse(\"{R}\"))\n375\t        # Put a card in library to draw\n376\t        draw_target = Sorcery(name=\"Reward\", owner=p1, controller=p1,\n377\t                              mana_cost=ManaCost.parse(\"{U}\"))\n378\t\n379\t        set_board_state(game, 0, battlefield=[lorehold], hand=[discard_card])\n380\t        game.get_library(p1).add(draw_target)\n381\t        lorehold.register_triggers(game)\n382\t\n383\t        # Simulate opponent's upkeep\n384\t        game.active_player_index = 1\n385\t\n386\t        game.trigger_manager.fire_event(\n387\t            game, BeginningOfUpkeepTriggeredEvent()\n388\t        )\n389\t\n390\t        # Resolve the trigger\n391\t        assert not game.stack.is_empty(), \"Trigger should be on stack\"\n392\t        trigger = game.stack.pop()\n393\t        trigger.on_resolve(game)\n394\t\n395\t        # The discard_card should have moved to graveyard\n396\t        hand_cards = game.get_hand(p1).get_all()\n397\t        graveyard_cards = game.get_graveyard(p1).get_all()\n398\t\n399\t        hand_names = [getattr(c, \"name\", \"\") for c in hand_cards]\n400\t        graveyard_names = [getattr(c, \"name\", \"\") for c in graveyard_cards]\n401\t\n402\t        assert \"Fodder\" not in hand_names, (\n403\t            \"Discarded card should not be in hand\"\n404\t        )\n405\t        assert \"Fodder\" in graveyard_names, (\n406\t            \"Discarded card should be in graveyard\"\n407\t        )\n408\t        # Should have drawn a card\n409\t        assert \"Reward\" in hand_names, (\n410\t            \"Should have drawn a card after discarding\"\n411\t        )\n412\t\n413\t    def test_upkeep_decline_discard(self) -> None:\n414\t        \"\"\"When the trigger resolves and the player declines ('no'),\n415\t        no cards are discarded and no cards are drawn.\"\"\"\n416\t        game = create_game(scripts=([False], []))  # p1 says \"no\"\n417\t        p1 = game.players[0]\n418\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n419\t\n420\t        hand_card = Instant(name=\"Keep Me\", owner=p1, controller=p1,\n421\t                            mana_cost=ManaCost.parse(\"{R}\"))\n422\t        lib_card = Sorcery(name=\"Stay In Library\", owner=p1, controller=p1,\n423\t                           mana_cost=ManaCost.parse(\"{U}\"))\n424\t\n425\t        set_board_state(game, 0, battlefield=[lorehold], hand=[hand_card])\n426\t        game.get_library(p1).add(lib_card)\n427\t        lorehold.register_triggers(game)\n428\t\n429\t        game.active_player_index = 1\n430\t\n431\t        game.trigger_manager.fire_event(\n432\t            game, BeginningOfUpkeepTriggeredEvent()\n433\t        )\n434\t\n435\t        assert not game.stack.is_empty()\n436\t        trigger = game.stack.pop()\n437\t        trigger.on_resolve(game)\n438\t\n439\t        # Hand should still contain the original card\n440\t        hand_names = [getattr(c, \"name\", \"\") for c in game.get_hand(p1).get_all()]\n441\t        assert \"Keep Me\" in hand_names, \"Card should remain in hand when declining\"\n442\t        # Library card should still be in library\n443\t        assert game.get_library(p1).contains(lib_card), (\n444\t            \"Library card should remain when declining discard\"\n445\t        )\n446\t\n447\t    def test_upkeep_no_cards_in_hand_no_discard(self) -> None:\n448\t        \"\"\"If the player has no cards in hand, the may ability should\n449\t        effectively do nothing (no discard possible, so no draw).\"\"\"\n450\t        game = create_game(scripts=([True], []))\n451\t        p1 = game.players[0]\n452\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n453\t\n454\t        lib_card = Instant(name=\"Library Card\", owner=p1, controller=p1)\n455\t\n456\t        set_board_state(game, 0, battlefield=[lorehold], hand=[])\n457\t        game.get_library(p1).add(lib_card)\n458\t        lorehold.register_triggers(game)\n459\t\n460\t        game.active_player_index = 1\n461\t\n462\t        game.trigger_manager.fire_event(\n463\t            game, BeginningOfUpkeepTriggeredEvent()\n464\t        )\n465\t\n466\t        # Even if trigger fires, with no cards in hand, nothing happens\n467\t        if not game.stack.is_empty():\n468\t            trigger = game.stack.pop()\n469\t            trigger.on_resolve(game)\n470\t\n471\t        # Library card should still be there (no draw without discard)\n472\t        assert game.get_library(p1).contains(lib_card), (\n473\t            \"Should not draw if no card was discarded\"\n474\t        )\n475\t\n476\t    def test_upkeep_trigger_source_is_lorehold(self) -> None:\n477\t        \"\"\"The registered trigger's source should be the Lorehold card.\"\"\"\n478\t        game = create_game()\n479\t        p1 = game.players[0]\n480\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n481\t\n482\t        lorehold.register_triggers(game)\n483\t\n484\t        triggers = game.trigger_manager.get_triggers_for_source(lorehold)\n485\t        assert len(triggers) >= 1, (\n486\t            \"At least one trigger should be registered with Lorehold as source\"\n487\t        )\n488\t\n489\t    def test_upkeep_trigger_controller_is_lorehold_controller(self) -> None:\n490\t        \"\"\"The trigger's controller should be Lorehold's controller.\"\"\"\n491\t        game = create_game()\n492\t        p1 = game.players[0]\n493\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n494\t\n495\t        lorehold.register_triggers(game)\n496\t\n497\t        triggers = game.trigger_manager.get_triggers_for_source(lorehold)\n498\t        upkeep_triggers = [\n499\t            t for t in triggers\n500\t            if t.event_type is BeginningOfUpkeepTriggeredEvent\n501\t        ]\n502\t        assert len(upkeep_triggers) >= 1\n503\t        assert upkeep_triggers[0].controller is p1\n504\t\n505\t\n506\t# ---------------------------------------------------------------------------\n507\t# ETB / Battlefield integration\n508\t# ---------------------------------------------------------------------------\n509\t\n510\t\n511\tclass TestLoreholdBattlefield:\n512\t    \"\"\"Integration tests: Lorehold entering the battlefield should\n513\t    register its triggers properly, and leaving should unregister them.\"\"\"\n514\t\n515\t    def test_enters_battlefield_registers_triggers(self) -> None:\n516\t        \"\"\"When Lorehold enters the battlefield via move_to_zone,\n517\t        triggers should be registered.\"\"\"\n518\t        from engine.zones import move_to_zone\n519\t        game = create_game()\n520\t        p1 = game.players[0]\n521\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n522\t\n523\t        # Put in hand first\n524\t        game.get_hand(p1).add(lorehold)\n525\t\n526\t        triggers_before = len(game.trigger_manager.get_triggers())\n527\t        # Simulate moving to battlefield (ETB hooks fire)\n528\t        move_to_zone(game, lorehold, Zone.HAND, Zone.BATTLEFIELD)\n529\t        triggers_after = len(game.trigger_manager.get_triggers())\n530\t\n531\t        assert triggers_after > triggers_before, (\n532\t            \"Triggers should be registered when Lorehold enters battlefield\"\n533\t        )\n534\t\n535\t    def test_leaves_battlefield_unregisters_triggers(self) -> None:\n536\t        \"\"\"When Lorehold leaves the battlefield, its triggers should be\n537\t        unregistered.\"\"\"\n538\t        from engine.zones import move_to_zone\n539\t        game = create_game()\n540\t        p1 = game.players[0]\n541\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n542\t\n543\t        # Place on battlefield\n544\t        set_board_state(game, 0, battlefield=[lorehold])\n545\t        lorehold.register_triggers(game)\n546\t\n547\t        triggers_registered = len(\n548\t            game.trigger_manager.get_triggers_for_source(lorehold)\n549\t        )\n550\t        assert triggers_registered > 0\n551\t\n552\t        # Remove from battlefield (simulate destruction)\n553\t        move_to_zone(game, lorehold, Zone.BATTLEFIELD, Zone.GRAVEYARD)\n554\t\n555\t        triggers_remaining = len(\n556\t            game.trigger_manager.get_triggers_for_source(lorehold)\n557\t        )\n558\t        assert triggers_remaining == 0, (\n559\t            \"All Lorehold triggers should be unregistered after leaving battlefield\"\n560\t        )\n561\t"}]},"parent_tool_use_id":"toolu_01P6jyPE8dsZrUZigVRM6nUZ","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f","uuid":"5c778ab7-1edd-457d-a7b5-0cd6597db24d","timestamp":"2026-05-28T12:03:20.493Z","subagent_type":"Reviewer","task_description":"Review sos_201 implementation"}
