{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GPzWZtQSWTtV2dP4nofB1H","type":"tool_result","content":"1\t\"\"\"Card implementation for Fanatical Firebrand.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\timport random\n5\tfrom typing import TYPE_CHECKING, Any\n6\tfrom engine.card import ActivatedAbility, ArtifactCreature, Creature, ManaAbility\n7\tfrom engine.types import CardType, Keyword, ManaCost, ManaType, Supertype, Zone\n8\tif TYPE_CHECKING:\n9\t    from engine.game_state import GameState\n10\t\n11\t    from cards.registry import CardRegistry\n12\t\n13\tclass FanaticalFirebrand(Creature):\n14\t    \"\"\"Fanatical Firebrand — {R} — 1/1 — Goblin Pirate\n15\t\n16\t    Haste\n17\t    {T}, Sacrifice this creature: It deals 1 damage to any target.\n18\t\n19\t    FDN collector number 195.\n20\t    \"\"\"\n21\t\n22\t    def __init__(self, **kwargs: Any) -> None:\n23\t        kwargs.setdefault(\"name\", \"Fanatical Firebrand\")\n24\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{R}\"))\n25\t        kwargs.setdefault(\"subtypes\", {\"Goblin\", \"Pirate\"})\n26\t        kwargs.setdefault(\"keywords\", Keyword.HASTE)\n27\t        kwargs.setdefault(\"base_power\", 1)\n28\t        kwargs.setdefault(\"base_toughness\", 1)\n29\t        kwargs.setdefault(\n30\t            \"rules_text\",\n31\t            \"Haste\\n{T}, Sacrifice this creature: It deals 1 damage to \"\n32\t            \"any target.\",\n33\t        )\n34\t        super().__init__(**kwargs)\n35\t\n36\t    def get_activated_abilities(self) -> list[ActivatedAbility]:\n37\t        source = self\n38\t\n39\t        def _cost(game: Any, src: Any) -> bool:\n40\t            if getattr(src, \"is_tapped\", False):\n41\t                return False\n42\t            src.is_tapped = True\n43\t            # Sacrifice self\n44\t            controller = src.controller\n45\t            if controller is None:\n46\t                return False\n47\t            from engine.game import sacrifice\n48\t            sacrifice(game, controller, src)\n49\t            return True\n50\t\n51\t        def _effect(game: Any) -> None:\n52\t            from engine.game import deal_damage\n53\t\n54\t            target = getattr(source, \"_current_target\", None)\n55\t            if target is not None:\n56\t                deal_damage(game, source, target, 1)\n57\t\n58\t        return [ActivatedAbility(\n59\t            cost=_cost,\n60\t            effect=_effect,\n61\t            description=\"{T}, Sacrifice this creature: It deals 1 damage \"\n62\t            \"to any target.\",\n63\t        )]\n64\t"}]},"parent_tool_use_id":"toolu_011NbDezPsYjeanH3N5rN4tp","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f","uuid":"70255e87-047f-4dd9-8b2a-777ee61d3f42","timestamp":"2026-05-28T11:00:20.652Z","subagent_type":"Reviewer","task_description":"Review sos_4 implementation"}
