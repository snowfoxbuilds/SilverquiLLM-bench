{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YKTb6fnbxcqr8qF6Tj19UX","type":"tool_result","content":"1\t\"\"\"Card implementation for The Dawning Archaic.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.types import CardType, Keyword, ManaCost, Supertype, Zone\n9\tfrom engine.events import AttacksTriggeredEvent\n10\t\n11\tif TYPE_CHECKING:\n12\t    from engine.game_state import GameState\n13\t\n14\t\n15\tclass TheDawningArchaic(Creature):\n16\t    \"\"\"The Dawning Archaic -- {10} -- 7/7 -- Legendary Creature - Avatar.\n17\t\n18\t    This spell costs {1} less to cast for each instant and sorcery card\n19\t    in your graveyard.\n20\t    Reach\n21\t    Whenever The Dawning Archaic attacks, you may cast target instant or\n22\t    sorcery card from your graveyard without paying its mana cost. If that\n23\t    spell would be put into your graveyard, exile it instead.\n24\t\n25\t    SOS collector number 1.\n26\t    \"\"\"\n27\t\n28\t    def __init__(self, **kwargs: Any) -> None:\n29\t        kwargs.setdefault(\"name\", \"The Dawning Archaic\")\n30\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{10}\"))\n31\t        kwargs.setdefault(\"subtypes\", {\"Avatar\"})\n32\t        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n33\t        kwargs.setdefault(\"keywords\", Keyword.REACH)\n34\t        kwargs.setdefault(\"base_power\", 7)\n35\t        kwargs.setdefault(\"base_toughness\", 7)\n36\t        kwargs.setdefault(\n37\t            \"rules_text\",\n38\t            \"This spell costs {1} less to cast for each instant and sorcery \"\n39\t            \"card in your graveyard.\\n\"\n40\t            \"Reach\\n\"\n41\t            \"Whenever The Dawning Archaic attacks, you may cast target instant \"\n42\t            \"or sorcery card from your graveyard without paying its mana cost. \"\n43\t            \"If that spell would be put into your graveyard, exile it instead.\",\n44\t        )\n45\t        super().__init__(**kwargs)\n46\t\n47\t    # ------------------------------------------------------------------\n48\t    # Cost reduction\n49\t    # ------------------------------------------------------------------\n50\t\n51\t    def cost_reduction(self, game: GameState) -> int:\n52\t        \"\"\"Return the number of instant and sorcery cards in owner's graveyard.\n53\t\n54\t        This spell costs {1} less to cast for each instant and sorcery card\n55\t        in your graveyard. Returns the raw count; the engine clamps generic\n56\t        mana to >= 0 in get_cost_reduction().\n57\t        \"\"\"\n58\t        # Use controller (the caster) to determine \"your graveyard\".\n59\t        # Fall back to owner if controller is not set.\n60\t        player = self.controller or self.owner\n61\t        if player is None:\n62\t            return 0\n63\t        graveyard = game.get_graveyard(player)\n64\t        count = 0\n65\t        for card in graveyard.get_all():\n66\t            card_types = getattr(card, \"card_types\", set())\n67\t            if CardType.INSTANT in card_types or CardType.SORCERY in card_types:\n68\t                count += 1\n69\t        return count\n70\t\n71\t    # ------------------------------------------------------------------\n72\t    # Attack trigger\n73\t    # ------------------------------------------------------------------\n74\t\n75\t    def register_triggers(self, game: GameState) -> None:\n76\t        \"\"\"Register the attack trigger for casting from graveyard.\"\"\"\n77\t        from engine.triggers import TriggerRegistration\n78\t        from engine.casting import cast_spell_free\n79\t\n80\t        source = self\n81\t        controller = getattr(self, \"controller\", None) or game.active_player\n82\t\n83\t        def _condition(game: Any, event: AttacksTriggeredEvent) -> bool:\n84\t            \"\"\"Only fire when The Dawning Archaic itself attacks.\"\"\"\n85\t            return event.creature is source\n86\t\n87\t        def _effect(game: GameState) -> None:\n88\t            \"\"\"You may cast target instant or sorcery from your graveyard\n89\t            without paying its mana cost. If that spell would be put into\n90\t            your graveyard, exile it instead.\"\"\"\n91\t            ctrl = getattr(source, \"controller\", None)\n92\t            if ctrl is None:\n93\t                return\n94\t\n95\t            # Find valid targets: instant or sorcery cards in controller's graveyard\n96\t            graveyard = game.get_graveyard(ctrl)\n97\t            valid_targets = []\n98\t            for card in graveyard.get_all():\n99\t                card_types = getattr(card, \"card_types\", set())\n100\t                if CardType.INSTANT in card_types or CardType.SORCERY in card_types:\n101\t                    valid_targets.append(card)\n102\t\n103\t            if not valid_targets:\n104\t                return\n105\t\n106\t            # Let the player choose a target\n107\t            try:\n108\t                chosen = ctrl.choose(valid_targets, \"Choose target instant or sorcery card from your graveyard\")\n109\t            except Exception:\n110\t                return\n111\t\n112\t            if chosen is None:\n113\t                return\n114\t\n115\t            # Verify the chosen card is actually a valid target\n116\t            chosen_types = getattr(chosen, \"card_types\", set())\n117\t            if CardType.INSTANT not in chosen_types and CardType.SORCERY not in chosen_types:\n118\t                return\n119\t\n120\t            # \"You may cast\" -- ask if the player wants to cast it\n121\t            try:\n122\t                wants_to_cast = ctrl.choose_yes_no(\n123\t                    f\"Cast {getattr(chosen, 'name', 'card')} without paying its mana cost?\"\n124\t                )\n125\t            except Exception:\n126\t                return\n127\t\n128\t            if not wants_to_cast:\n129\t                return\n130\t\n131\t            # Mark the card for exile replacement: if it would go to\n132\t            # graveyard after resolution, exile it instead.\n133\t            chosen._dawning_archaic_exile = True  # type: ignore[attr-defined]\n134\t\n135\t            # Cast the spell from the graveyard without paying mana cost\n136\t            try:\n137\t                cast_spell_free(game, ctrl, chosen, Zone.GRAVEYARD)\n138\t            except Exception:\n139\t                # Clean up the marker if casting fails\n140\t                if hasattr(chosen, \"_dawning_archaic_exile\"):\n141\t                    del chosen._dawning_archaic_exile\n142\t                return\n143\t\n144\t        game.trigger_manager.register(\n145\t            TriggerRegistration(\n146\t                event_type=AttacksTriggeredEvent,\n147\t                condition=_condition,\n148\t                effect=_effect,\n149\t                source=self,\n150\t                controller=controller,\n151\t            )\n152\t        )\n153\t"}]},"parent_tool_use_id":"toolu_013QMfyNeNrzXeXfbK67fwMN","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f","uuid":"b648142a-1dae-442c-baf3-b04c1fd5bdb6","timestamp":"2026-05-28T12:25:22.323Z","subagent_type":"Reviewer","task_description":"Review sos_245 implementation"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DgnZht3mfsFedQ19RLg3JB","type":"tool_result","content":"1\t\"\"\"Tests for cost-reduction hook in the casting pipeline.\n2\t\n3\tCovers:\n4\t- CardImpl.cost_reduction() default returns 0\n5\t- get_cost_reduction returns the card's cost_reduction clamped to generic mana\n6\t- _apply_cost_reduction creates a new ManaCost with reduced generic\n7\t- Reduction cannot go below 0 generic (colored costs are never reduced)\n8\t- Zero reduction leaves cost unchanged\n9\t- Reduction exactly equal to generic → generic becomes 0\n10\t- Reduction exceeding generic → generic floors at 0\n11\t- Integration with cast_spell: reduced cost is used for payment\n12\t- Cost reduction hook is invoked during the casting pipeline\n13\t\"\"\"\n14\t\n15\tfrom __future__ import annotations\n16\t\n17\timport pytest\n18\t\n19\tfrom engine.card import CardImpl, Creature, Instant\n20\tfrom engine.casting import (\n21\t    CastingError,\n22\t    _apply_cost_reduction,\n23\t    get_cost_reduction,\n24\t    cast_spell,\n25\t)\n26\tfrom engine.game_state import GameState\n27\tfrom engine.player import DeterministicPlayer\n28\tfrom engine.types import CardType, ManaCost, ManaType, Phase, Step\n29\t\n30\t\n31\t# ---------------------------------------------------------------------------\n32\t# Helpers\n33\t# ---------------------------------------------------------------------------\n34\t\n35\tdef _make_game(\n36\t    *,\n37\t    phase: Phase = Phase.PRECOMBAT_MAIN,\n38\t    step: Step | None = None,\n39\t) -> GameState:\n40\t    p1 = DeterministicPlayer(\"P1\", life=20, script=[])\n41\t    p2 = DeterministicPlayer(\"P2\", life=20, script=[])\n42\t    game = GameState(players=[p1, p2])\n43\t    game.phase = phase\n44\t    if step is not None:\n45\t        game.step = step\n46\t    return game\n47\t\n48\t\n49\tclass ReducedCostCreature(Creature):\n50\t    \"\"\"A creature with {4}{R}{R} that gets a fixed reduction.\"\"\"\n51\t\n52\t    def __init__(self, reduction: int = 3) -> None:\n53\t        super().__init__(\n54\t            name=\"Test Reduced Creature\",\n55\t            mana_cost=ManaCost.parse(\"{4}{R}{R}\"),\n56\t            base_power=4,\n57\t            base_toughness=4,\n58\t        )\n59\t        self._reduction = reduction\n60\t\n61\t    def cost_reduction(self, game: GameState) -> int:\n62\t        return self._reduction\n63\t\n64\t\n65\tclass ReducedCostInstant(Instant):\n66\t    \"\"\"An instant with {3}{U} that gets a fixed reduction.\"\"\"\n67\t\n68\t    def __init__(self, reduction: int = 2) -> None:\n69\t        super().__init__(\n70\t            name=\"Test Reduced Instant\",\n71\t            mana_cost=ManaCost.parse(\"{3}{U}\"),\n72\t        )\n73\t        self._reduction = reduction\n74\t\n75\t    def cost_reduction(self, game: GameState) -> int:\n76\t        return self._reduction\n77\t\n78\t\n79\t# ---------------------------------------------------------------------------\n80\t# Unit tests: CardImpl.cost_reduction default\n81\t# ---------------------------------------------------------------------------\n82\t\n83\tclass TestCostReductionDefault:\n84\t    \"\"\"The base CardImpl.cost_reduction() must return 0.\"\"\"\n85\t\n86\t    def test_creature_default_cost_reduction_is_zero(self):\n87\t        game = _make_game()\n88\t        card = Creature(\n89\t            name=\"Vanilla Bear\",\n90\t            mana_cost=ManaCost.parse(\"{1}{G}\"),\n91\t            base_power=2,\n92\t            base_toughness=2,\n93\t        )\n94\t        assert card.cost_reduction(game) == 0\n95\t\n96\t    def test_instant_default_cost_reduction_is_zero(self):\n97\t        game = _make_game()\n98\t        card = Instant(name=\"Zap\", mana_cost=ManaCost.parse(\"{R}\"))\n99\t        assert card.cost_reduction(game) == 0\n100\t\n101\t\n102\t# ---------------------------------------------------------------------------\n103\t# Unit tests: get_cost_reduction\n104\t# ---------------------------------------------------------------------------\n105\t\n106\tclass TestGetCostReduction:\n107\t    \"\"\"Tests for the get_cost_reduction helper.\"\"\"\n108\t\n109\t    def test_default_card_has_zero_reduction(self):\n110\t        game = _make_game()\n111\t        card = Creature(\n112\t            name=\"Vanilla\",\n113\t            mana_cost=ManaCost.parse(\"{2}{G}\"),\n114\t            base_power=2,\n115\t            base_toughness=2,\n116\t        )\n117\t        assert get_cost_reduction(game, card, game.players[0]) == 0\n118\t\n119\t    def test_card_with_reduction_of_3(self):\n120\t        \"\"\"Embercleave scenario: {4}{R}{R} with reduction 3 → returns 3.\"\"\"\n121\t        game = _make_game()\n122\t        card = ReducedCostCreature(reduction=3)\n123\t        assert get_cost_reduction(game, card, game.players[0]) == 3\n124\t\n125\t    def test_reduction_clamped_to_generic(self):\n126\t        \"\"\"Reduction cannot exceed the generic portion of the cost.\"\"\"\n127\t        game = _make_game()\n128\t        card = ReducedCostCreature(reduction=10)\n129\t        # Generic is 4, so reduction is clamped to 4\n130\t        assert get_cost_reduction(game, card, game.players[0]) == 4\n131\t\n132\t    def test_reduction_exactly_equals_generic(self):\n133\t        \"\"\"Reduction == generic → returns generic (reduces it to 0).\"\"\"\n134\t        game = _make_game()\n135\t        card = ReducedCostCreature(reduction=4)\n136\t        assert get_cost_reduction(game, card, game.players[0]) == 4\n137\t\n138\t    def test_negative_reduction_clamped_to_zero(self):\n139\t        \"\"\"Negative reduction values are treated as 0.\"\"\"\n140\t        game = _make_game()\n141\t        card = ReducedCostCreature(reduction=-1)\n142\t        assert get_cost_reduction(game, card, game.players[0]) == 0\n143\t\n144\t    def test_reduction_on_card_with_no_generic_mana(self):\n145\t        \"\"\"A card like {R}{R} with no generic → reduction is 0.\"\"\"\n146\t        game = _make_game()\n147\t\n148\t        class PureColoredCreature(Creature):\n149\t            def __init__(self):\n150\t                super().__init__(\n151\t                    name=\"Pure Red\",\n152\t                    mana_cost=ManaCost.parse(\"{R}{R}\"),\n153\t                    base_power=2,\n154\t                    base_toughness=1,\n155\t                )\n156\t\n157\t            def cost_reduction(self, game):\n158\t                return 5\n159\t\n160\t        card = PureColoredCreature()\n161\t        # Generic is 0, so even a reduction of 5 is clamped to 0\n162\t        assert get_cost_reduction(game, card, game.players[0]) == 0\n163\t\n164\t\n165\t# ---------------------------------------------------------------------------\n166\t# Unit tests: _apply_cost_reduction\n167\t# ---------------------------------------------------------------------------\n168\t\n169\tclass TestApplyCostReduction:\n170\t    \"\"\"Tests for _apply_cost_reduction.\"\"\"\n171\t\n172\t    def test_reduce_generic_by_3(self):\n173\t        \"\"\"{4}{R}{R} with reduction 3 → {1}{R}{R}.\"\"\"\n174\t        cost = ManaCost.parse(\"{4}{R}{R}\")\n175\t        reduced = _apply_cost_reduction(cost, 3)\n176\t        assert reduced.generic == 1\n177\t        assert reduced.pips == {ManaType.RED: 2}\n178\t\n179\t    def test_reduce_generic_to_zero(self):\n180\t        \"\"\"{4}{R}{R} with reduction 4 → {0}{R}{R} = {R}{R}.\"\"\"\n181\t        cost = ManaCost.parse(\"{4}{R}{R}\")\n182\t        reduced = _apply_cost_reduction(cost, 4)\n183\t        assert reduced.generic == 0\n184\t        assert reduced.pips == {ManaType.RED: 2}\n185\t\n186\t    def test_zero_reduction_leaves_cost_unchanged(self):\n187\t        cost = ManaCost.parse(\"{4}{R}{R}\")\n188\t        reduced = _apply_cost_reduction(cost, 0)\n189\t        assert reduced.generic == 4\n190\t        assert reduced.pips == {ManaType.RED: 2}\n191\t\n192\t    def test_original_cost_not_mutated(self):\n193\t        \"\"\"_apply_cost_reduction must not mutate the original cost.\"\"\"\n194\t        cost = ManaCost.parse(\"{4}{R}{R}\")\n195\t        _apply_cost_reduction(cost, 3)\n196\t        assert cost.generic == 4\n197\t\n198\t    def test_reduction_beyond_generic_floors_at_zero(self):\n199\t        \"\"\"{1}{R} with reduction 5 → {R} (generic can't go negative).\"\"\"\n200\t        cost = ManaCost.parse(\"{1}{R}\")\n201\t        reduced = _apply_cost_reduction(cost, 5)\n202\t        assert reduced.generic == 0\n203\t        assert reduced.pips == {ManaType.RED: 1}\n204\t\n205\t    def test_colored_pips_never_reduced(self):\n206\t        \"\"\"{2}{W}{U} with reduction 2 → {W}{U}. Colored pips stay.\"\"\"\n207\t        cost = ManaCost.parse(\"{2}{W}{U}\")\n208\t        reduced = _apply_cost_reduction(cost, 2)\n209\t        assert reduced.generic == 0\n210\t        assert reduced.pips[ManaType.WHITE] == 1\n211\t        assert reduced.pips[ManaType.BLUE] == 1\n212\t\n213\t    def test_colored_pips_preserved_when_reduction_exceeds_generic(self):\n214\t        \"\"\"{1}{B}{B}{B} with reduction 99 → {B}{B}{B}.\"\"\"\n215\t        cost = ManaCost.parse(\"{1}{B}{B}{B}\")\n216\t        reduced = _apply_cost_reduction(cost, 99)\n217\t        assert reduced.generic == 0\n218\t        assert reduced.pips[ManaType.BLACK] == 3\n219\t\n220\t\n221\t# ---------------------------------------------------------------------------\n222\t# Integration tests: cast_spell with cost reduction\n223\t# ---------------------------------------------------------------------------\n224\t\n225\tclass TestCastSpellWithReduction:\n226\t    \"\"\"Integration: cast_spell uses the cost reduction hook.\"\"\"\n227\t\n228\t    def test_cast_with_reduction_succeeds_with_exact_mana(self):\n229\t        \"\"\"Card costs {4}{R}{R}, reduction 3 → effective {1}{R}{R}.\n230\t        Player has 1 generic + 2 red = 3 total mana, should succeed.\"\"\"\n231\t        game = _make_game()\n232\t        p1 = game.players[0]\n233\t        card = ReducedCostCreature(reduction=3)\n234\t        card.owner = p1\n235\t        card.controller = p1\n236\t        game.get_hand(p1).add(card)\n237\t\n238\t        # Add exactly enough mana for reduced cost: {1}{R}{R}\n239\t        p1.mana_pool.add(ManaType.COLORLESS, 1)\n240\t        p1.mana_pool.add(ManaType.RED, 2)\n241\t\n242\t        cast_spell(game, p1, card)\n243\t        # Card should be on the stack now (as a StackObject)\n244\t        assert not game.stack.is_empty()\n245\t\n246\t    def test_cast_with_zero_reduction_needs_full_cost(self):\n247\t        \"\"\"Card with 0 reduction needs full {4}{R}{R} = 6 mana.\"\"\"\n248\t        game = _make_game()\n249\t        p1 = game.players[0]\n250\t        card = ReducedCostCreature(reduction=0)\n251\t        card.owner = p1\n252\t        card.controller = p1\n253\t        game.get_hand(p1).add(card)\n254\t\n255\t        # Only 3 mana — not enough for full cost\n256\t        p1.mana_pool.add(ManaType.COLORLESS, 1)\n257\t        p1.mana_pool.add(ManaType.RED, 2)\n258\t\n259\t        with pytest.raises(CastingError):\n260\t            cast_spell(game, p1, card)\n261\t\n262\t    def test_cast_with_full_reduction_only_needs_colored(self):\n263\t        \"\"\"Reduction == generic → only colored pips needed.\n264\t        {4}{R}{R} with reduction 4 → {R}{R}.\"\"\"\n265\t        game = _make_game()\n266\t        p1 = game.players[0]\n267\t        card = ReducedCostCreature(reduction=4)\n268\t        card.owner = p1\n269\t        card.controller = p1\n270\t        game.get_hand(p1).add(card)\n271\t\n272\t        # Only 2 red mana — enough when generic is fully reduced\n273\t        p1.mana_pool.add(ManaType.RED, 2)\n274\t\n275\t        cast_spell(game, p1, card)\n276\t        assert not game.stack.is_empty()\n277\t\n278\t    def test_mana_pool_drained_by_reduced_cost(self):\n279\t        \"\"\"After casting with reduction, mana pool should have leftover mana.\"\"\"\n280\t        game = _make_game()\n281\t        p1 = game.players[0]\n282\t        card = ReducedCostCreature(reduction=3)\n283\t        card.owner = p1\n284\t        card.controller = p1\n285\t        game.get_hand(p1).add(card)\n286\t\n287\t        # Give 5 mana total: 3 colorless + 2 red\n288\t        # Reduced cost is {1}{R}{R} = 3 mana → should have 2 colorless left\n289\t        p1.mana_pool.add(ManaType.COLORLESS, 3)\n290\t        p1.mana_pool.add(ManaType.RED, 2)\n291\t\n292\t        cast_spell(game, p1, card)\n293\t        # 2 colorless should remain (3 - 1 = 2)\n294\t        assert p1.mana_pool.get(ManaType.COLORLESS) == 2\n295\t"}]},"parent_tool_use_id":"toolu_013QMfyNeNrzXeXfbK67fwMN","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f","uuid":"29a3d517-dc64-4d1d-84f8-e15b2b376c92","timestamp":"2026-05-28T12:25:22.322Z","subagent_type":"Reviewer","task_description":"Review sos_245 implementation"}
