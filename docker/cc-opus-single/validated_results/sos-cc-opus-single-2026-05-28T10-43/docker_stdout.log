{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019g4bNMZAqJtgk846MqBetP","type":"tool_result","content":"1\t\"\"\"Card implementation for Vivien Reid.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\tfrom typing import TYPE_CHECKING, Any\n5\tfrom engine.card import Creature, LoyaltyAbility, Planeswalker\n6\tfrom engine.types import CardType, Keyword, ManaCost, ManaType, Supertype, Zone\n7\tif TYPE_CHECKING:\n8\t    from engine.game_state import GameState\n9\t    from engine.player import Player\n10\t\n11\t    from cards.registry import CardRegistry\n12\t\n13\t\n14\tclass VivienReid(Planeswalker):\n15\t    \"\"\"Vivien Reid — {3}{G}{G} — 5 loyalty.\n16\t\n17\t    +1: Look at the top four cards. May reveal a creature or land and put\n18\t        it into your hand. Rest on bottom in random order.\n19\t    −3: Destroy target artifact, enchantment, or creature with flying.\n20\t    −8: Emblem — creatures you control get +2/+2 and have vigilance,\n21\t        trample, and indestructible.\n22\t    \"\"\"\n23\t\n24\t    def __init__(self, **kwargs: Any) -> None:\n25\t        kwargs.setdefault(\"name\", \"Vivien Reid\")\n26\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{3}{G}{G}\"))\n27\t        kwargs.setdefault(\"starting_loyalty\", 5)\n28\t        kwargs.setdefault(\"supertypes\", set())\n29\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.LEGENDARY}\n30\t        kwargs.setdefault(\"subtypes\", set())\n31\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Vivien\"}\n32\t        kwargs.setdefault(\n33\t            \"rules_text\",\n34\t            \"+1: Look at the top four cards of your library. You may reveal a \"\n35\t            \"creature or land card from among them and put it into your hand. \"\n36\t            \"Put the rest on the bottom of your library in a random order.\\n\"\n37\t            \"−3: Destroy target artifact, enchantment, or creature with flying.\\n\"\n38\t            \"−8: You get an emblem with \\\"Creatures you control get +2/+2 and have \"\n39\t            \"vigilance, trample, and indestructible.\\\"\",\n40\t        )\n41\t        super().__init__(**kwargs)\n42\t\n43\t    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n44\t        pw = self\n45\t\n46\t        def _plus1(game: Any) -> None:\n47\t            \"\"\"Look at top 4 cards, may reveal a creature or land to hand.\"\"\"\n48\t            import random\n49\t\n50\t            controller = pw.controller\n51\t            if controller is None:\n52\t                return\n53\t\n54\t            library = controller.zones[Zone.LIBRARY]\n55\t            hand = controller.zones[Zone.HAND]\n56\t            if len(library) == 0:\n57\t                return\n58\t\n59\t            # Get top 4 cards (top = end of list)\n60\t            all_cards = library.get_all()\n61\t            count = min(4, len(all_cards))\n62\t            top_cards = all_cards[-count:]\n63\t\n64\t            # Find creature or land cards among the top cards\n65\t            eligible = [\n66\t                card for card in top_cards\n67\t                if CardType.CREATURE in getattr(card, \"card_types\", set())\n68\t                or CardType.LAND in getattr(card, \"card_types\", set())\n69\t            ]\n70\t\n71\t            # Let the controller choose one (optional — \"you may\")\n72\t            found = None\n73\t            if eligible:\n74\t                try:\n75\t                    chosen = controller.choose_card(\n76\t                        eligible, \"You may reveal a creature or land card\"\n77\t                    )\n78\t                except Exception:\n79\t                    # Fallback: pick the first eligible card\n80\t                    chosen = eligible[0]\n81\t                # Controller may decline (None means no choice)\n82\t                if chosen is not None and chosen in eligible:\n83\t                    found = chosen\n84\t\n85\t            # Put the chosen card into hand\n86\t            if found is not None:\n87\t                library.remove(found)\n88\t                hand.add(found)\n89\t                top_cards = [c for c in top_cards if c is not found]\n90\t\n91\t            # Put the rest on the bottom in random order\n92\t            remaining = [c for c in top_cards if library.contains(c)]\n93\t            for c in remaining:\n94\t                library.remove(c)\n95\t            random.shuffle(remaining)\n96\t            for c in remaining:\n97\t                library.add(c, position=\"bottom\")\n98\t\n99\t        def _minus3(game: Any) -> None:\n100\t            \"\"\"Destroy target artifact, enchantment, or creature with flying.\n101\t\n102\t            Uses lazy target validation at resolution time.\n103\t            \"\"\"\n104\t            from engine.game import destroy\n105\t\n106\t            target = getattr(pw, \"_resolve_target\", None)\n107\t            if target is None:\n108\t                return\n109\t\n110\t            # Lazy filter: revalidate target at resolution\n111\t            card_types = getattr(target, \"card_types\", set())\n112\t            keywords = getattr(target, \"keywords\", Keyword(0))\n113\t            is_legal = (\n114\t                CardType.ARTIFACT in card_types\n115\t                or CardType.ENCHANTMENT in card_types\n116\t                or (CardType.CREATURE in card_types and Keyword.FLYING in keywords)\n117\t            )\n118\t            if is_legal:\n119\t                destroy(game, target)\n120\t\n121\t        def _minus8(game: Any) -> None:\n122\t            \"\"\"Emblem — creatures you control get +2/+2, vigilance, trample, indestructible.\"\"\"\n123\t            from engine.continuous_effects import (\n124\t                ContinuousEffect,\n125\t                DURATION_PERMANENT,\n126\t                Layer,\n127\t                SubLayer,\n128\t            )\n129\t\n130\t            controller = pw.controller\n131\t            if controller is None:\n132\t                return\n133\t\n134\t            # Create a sentinel emblem source that won't be removed\n135\t            emblem = type(\"Emblem\", (), {\"name\": \"Vivien Reid Emblem\"})()\n136\t\n137\t            # Register continuous effect for P/T boost (Layer 7c)\n138\t            def _apply_pt(game: Any) -> None:\n139\t                \"\"\"Give creatures controlled by emblem owner +2/+2.\"\"\"\n140\t                bf = game.get_battlefield(controller)\n141\t                for obj in bf.get_all():\n142\t                    if CardType.CREATURE in getattr(obj, \"card_types\", set()):\n143\t                        obj.modified_power += 2\n144\t                        obj.modified_toughness += 2\n145\t\n146\t            game.effect_manager.add(ContinuousEffect(\n147\t                source=emblem,\n148\t                layer=Layer.POWER_TOUGHNESS,\n149\t                sublayer=SubLayer.MODIFY_PT,\n150\t                apply=_apply_pt,\n151\t                duration=DURATION_PERMANENT,\n152\t            ))\n153\t\n154\t            # Register continuous effect for keywords (Layer 6)\n155\t            def _apply_keywords(game: Any) -> None:\n156\t                \"\"\"Give creatures controlled by emblem owner vigilance, trample, indestructible.\"\"\"\n157\t                bf = game.get_battlefield(controller)\n158\t                for obj in bf.get_all():\n159\t                    if CardType.CREATURE in getattr(obj, \"card_types\", set()):\n160\t                        obj.keywords = (\n161\t                            getattr(obj, \"keywords\", Keyword(0))\n162\t                            | Keyword.VIGILANCE\n163\t                            | Keyword.TRAMPLE\n164\t                            | Keyword.INDESTRUCTIBLE\n165\t                        )\n166\t\n167\t            game.effect_manager.add(ContinuousEffect(\n168\t                source=emblem,\n169\t                layer=Layer.ABILITY,\n170\t                sublayer=None,\n171\t                apply=_apply_keywords,\n172\t                duration=DURATION_PERMANENT,\n173\t            ))\n174\t\n175\t        return [\n176\t            LoyaltyAbility(\n177\t                loyalty_cost=+1,\n178\t                effect=_plus1,\n179\t                description=\"+1: Look at top 4, may reveal creature or land to hand.\",\n180\t            ),\n181\t            LoyaltyAbility(\n182\t                loyalty_cost=-3,\n183\t                effect=_minus3,\n184\t                description=\"−3: Destroy target artifact, enchantment, or creature with flying.\",\n185\t            ),\n186\t            LoyaltyAbility(\n187\t                loyalty_cost=-8,\n188\t                effect=_minus8,\n189\t                description=\"−8: Emblem — creatures get +2/+2, vigilance, trample, indestructible.\",\n190\t            ),\n191\t        ]\n192\t"}]},"parent_tool_use_id":"toolu_019NH15HbfnxSs1UumsdQhpQ","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f","uuid":"7bcf57d1-5a93-4545-a370-223a7e027b91","timestamp":"2026-05-28T11:37:47.909Z","subagent_type":"Implementer","task_description":"Implement sos_97"}
