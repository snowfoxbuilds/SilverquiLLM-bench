{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TgzvqGi8BhXso2qATQKPyT","type":"tool_result","content":"1\t\"\"\"Card implementation for The Dawning Archaic.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.types import CardType, Keyword, ManaCost, Supertype, Zone\n9\tfrom engine.events import AttacksTriggeredEvent\n10\t\n11\tif TYPE_CHECKING:\n12\t    from engine.game_state import GameState\n13\t\n14\t\n15\tclass TheDawningArchaic(Creature):\n16\t    \"\"\"The Dawning Archaic -- {10} -- 7/7 -- Legendary Creature - Avatar.\n17\t\n18\t    This spell costs {1} less to cast for each instant and sorcery card\n19\t    in your graveyard.\n20\t    Reach\n21\t    Whenever The Dawning Archaic attacks, you may cast target instant or\n22\t    sorcery card from your graveyard without paying its mana cost. If that\n23\t    spell would be put into your graveyard, exile it instead.\n24\t\n25\t    SOS collector number 1.\n26\t    \"\"\"\n27\t\n28\t    def __init__(self, **kwargs: Any) -> None:\n29\t        kwargs.setdefault(\"name\", \"The Dawning Archaic\")\n30\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{10}\"))\n31\t        kwargs.setdefault(\"subtypes\", {\"Avatar\"})\n32\t        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n33\t        kwargs.setdefault(\"keywords\", Keyword.REACH)\n34\t        kwargs.setdefault(\"base_power\", 7)\n35\t        kwargs.setdefault(\"base_toughness\", 7)\n36\t        kwargs.setdefault(\n37\t            \"rules_text\",\n38\t            \"This spell costs {1} less to cast for each instant and sorcery \"\n39\t            \"card in your graveyard.\\n\"\n40\t            \"Reach\\n\"\n41\t            \"Whenever The Dawning Archaic attacks, you may cast target instant \"\n42\t            \"or sorcery card from your graveyard without paying its mana cost. \"\n43\t            \"If that spell would be put into your graveyard, exile it instead.\",\n44\t        )\n45\t        super().__init__(**kwargs)\n46\t\n47\t    # ------------------------------------------------------------------\n48\t    # Cost reduction\n49\t    # ------------------------------------------------------------------\n50\t\n51\t    def cost_reduction(self, game: GameState) -> int:\n52\t        \"\"\"Return the number of instant and sorcery cards in owner's graveyard.\n53\t\n54\t        This spell costs {1} less to cast for each instant and sorcery card\n55\t        in your graveyard. Returns the raw count; the engine clamps generic\n56\t        mana to >= 0 in get_cost_reduction().\n57\t        \"\"\"\n58\t        # Use controller (the caster) to determine \"your graveyard\".\n59\t        # Fall back to owner if controller is not set.\n60\t        player = self.controller or self.owner\n61\t        if player is None:\n62\t            return 0\n63\t        graveyard = game.get_graveyard(player)\n64\t        count = 0\n65\t        for card in graveyard.get_all():\n66\t            card_types = getattr(card, \"card_types\", set())\n67\t            if CardType.INSTANT in card_types or CardType.SORCERY in card_types:\n68\t                count += 1\n69\t        return count\n70\t\n71\t    # ------------------------------------------------------------------\n72\t    # Attack trigger\n73\t    # ------------------------------------------------------------------\n74\t\n75\t    def register_triggers(self, game: GameState) -> None:\n76\t        \"\"\"Register the attack trigger for casting from graveyard.\"\"\"\n77\t        from engine.triggers import TriggerRegistration\n78\t        from engine.casting import cast_spell_free\n79\t\n80\t        source = self\n81\t        controller = getattr(self, \"controller\", None) or game.active_player\n82\t\n83\t        def _condition(game: Any, event: AttacksTriggeredEvent) -> bool:\n84\t            \"\"\"Only fire when The Dawning Archaic itself attacks.\"\"\"\n85\t            return event.creature is source\n86\t\n87\t        def _effect(game: GameState) -> None:\n88\t            \"\"\"You may cast target instant or sorcery from your graveyard\n89\t            without paying its mana cost. If that spell would be put into\n90\t            your graveyard, exile it instead.\"\"\"\n91\t            ctrl = getattr(source, \"controller\", None)\n92\t            if ctrl is None:\n93\t                return\n94\t\n95\t            # Find valid targets: instant or sorcery cards in controller's graveyard\n96\t            graveyard = game.get_graveyard(ctrl)\n97\t            valid_targets = []\n98\t            for card in graveyard.get_all():\n99\t                card_types = getattr(card, \"card_types\", set())\n100\t                if CardType.INSTANT in card_types or CardType.SORCERY in card_types:\n101\t                    valid_targets.append(card)\n102\t\n103\t            if not valid_targets:\n104\t                return\n105\t\n106\t            # Let the player choose a target\n107\t            try:\n108\t                chosen = ctrl.choose(valid_targets, \"Choose target instant or sorcery card from your graveyard\")\n109\t            except Exception:\n110\t                return\n111\t\n112\t            if chosen is None:\n113\t                return\n114\t\n115\t            # Verify the chosen card is actually a valid target\n116\t            chosen_types = getattr(chosen, \"card_types\", set())\n117\t            if CardType.INSTANT not in chosen_types and CardType.SORCERY not in chosen_types:\n118\t                return\n119\t\n120\t            # \"You may cast\" -- ask if the player wants to cast it\n121\t            try:\n122\t                wants_to_cast = ctrl.choose_yes_no(\n123\t                    f\"Cast {getattr(chosen, 'name', 'card')} without paying its mana cost?\"\n124\t                )\n125\t            except Exception:\n126\t                return\n127\t\n128\t            if not wants_to_cast:\n129\t                return\n130\t\n131\t            # Mark the card for exile replacement: if it would go to\n132\t            # graveyard after resolution, exile it instead.\n133\t            chosen._dawning_archaic_exile = True  # type: ignore[attr-defined]\n134\t\n135\t            # Cast the spell from the graveyard without paying mana cost\n136\t            try:\n137\t                cast_spell_free(game, ctrl, chosen, Zone.GRAVEYARD)\n138\t            except Exception:\n139\t                # Clean up the marker if casting fails\n140\t                if hasattr(chosen, \"_dawning_archaic_exile\"):\n141\t                    del chosen._dawning_archaic_exile\n142\t                return\n143\t\n144\t        game.trigger_manager.register(\n145\t            TriggerRegistration(\n146\t                event_type=AttacksTriggeredEvent,\n147\t                condition=_condition,\n148\t                effect=_effect,\n149\t                source=self,\n150\t                controller=controller,\n151\t            )\n152\t        )\n153\t"}]},"parent_tool_use_id":"toolu_01ECf9bUEWLU7PNK51Pzvwdr","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f","uuid":"dea97630-9ae5-4e28-9fac-634855f6db49","timestamp":"2026-05-28T12:17:20.689Z","subagent_type":"Tester","task_description":"Write tests for sos_245"}
