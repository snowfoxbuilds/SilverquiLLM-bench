{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VHYRw1TUhasD31omNkcCb7","type":"tool_result","content":"1\t\"\"\"Card implementation for Silverquill, the Disputant.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.events import SpellCastTriggeredEvent\n9\tfrom engine.stack import copy_spell\n10\tfrom engine.triggers import TriggerRegistration\n11\tfrom engine.types import CardType, Keyword, ManaCost, Supertype\n12\t\n13\tif TYPE_CHECKING:\n14\t    from engine.game_state import GameState\n15\t\n16\t\n17\tclass SilverquillTheDisputant(Creature):\n18\t    \"\"\"Silverquill, the Disputant -- {2}{W}{B} -- 4/4 Elder Dragon.\n19\t\n20\t    Flying, vigilance\n21\t    Each instant and sorcery spell you cast has casualty 1.\n22\t    (As you cast that spell, you may sacrifice a creature with power 1\n23\t    or greater. When you do, copy the spell and you may choose new\n24\t    targets for the copy.)\n25\t    \"\"\"\n26\t\n27\t    # Casualty threshold: sacrifice a creature with power >= casualty_n\n28\t    casualty_n: int = 1\n29\t\n30\t    def __init__(self, **kwargs: Any) -> None:\n31\t        kwargs.setdefault(\"name\", \"Silverquill, the Disputant\")\n32\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{2}{W}{B}\"))\n33\t        kwargs.setdefault(\"base_power\", 4)\n34\t        kwargs.setdefault(\"base_toughness\", 4)\n35\t        kwargs.setdefault(\"supertypes\", set())\n36\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.LEGENDARY}\n37\t        kwargs.setdefault(\"subtypes\", set())\n38\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Elder\", \"Dragon\"}\n39\t        kwargs.setdefault(\"keywords\", Keyword(0))\n40\t        kwargs[\"keywords\"] = kwargs[\"keywords\"] | Keyword.FLYING | Keyword.VIGILANCE\n41\t        kwargs.setdefault(\n42\t            \"rules_text\",\n43\t            \"Flying, vigilance\\n\"\n44\t            \"Each instant and sorcery spell you cast has casualty 1.\",\n45\t        )\n46\t        super().__init__(**kwargs)\n47\t\n48\t    def can_pay_casualty(self, game: GameState, creature: Any) -> bool:\n49\t        \"\"\"Check whether *creature* is a valid sacrifice for casualty 1.\n50\t\n51\t        A creature is valid if its power is >= self.casualty_n (which is 1).\n52\t        \"\"\"\n53\t        power = getattr(creature, \"power\", getattr(creature, \"base_power\", 0))\n54\t        return power >= self.casualty_n\n55\t\n56\t    def register_triggers(self, game: GameState) -> None:\n57\t        \"\"\"Register the casualty-granting trigger.\n58\t\n59\t        Watches for SpellCastTriggeredEvent. When the controller casts an\n60\t        instant or sorcery, if casualty was paid (the spell has\n61\t        ``_casualty_paid = True`` and ``_casualty_sacrificed`` set), the\n62\t        sacrificed creature is moved to the graveyard and a copy of the\n63\t        spell is placed on the stack.\n64\t        \"\"\"\n65\t        controller = self.controller\n66\t        silverquill = self\n67\t\n68\t        # Shared queue between condition and effect closures.\n69\t        # When the condition matches, it appends the spell reference;\n70\t        # when the effect resolves, it pops the reference.  This ensures\n71\t        # the effect always operates on the exact spell that triggered it,\n72\t        # even when multiple instants/sorceries are on the stack.\n73\t        _pending_spells: list[Any] = []\n74\t\n75\t        def _casualty_condition(game: GameState, event: SpellCastTriggeredEvent) -> bool:\n76\t            \"\"\"Match only instants/sorceries cast by the controller.\"\"\"\n77\t            # Must be cast by the controller of Silverquill\n78\t            if event.controller is not controller:\n79\t                return False\n80\t            # Must be an instant or sorcery\n81\t            spell = event.spell\n82\t            card_types = getattr(spell, \"card_types\", set())\n83\t            if CardType.INSTANT not in card_types and CardType.SORCERY not in card_types:\n84\t                return False\n85\t            # Capture the spell reference for the effect closure\n86\t            _pending_spells.append(spell)\n87\t            return True\n88\t\n89\t        def _casualty_effect(game: GameState) -> None:\n90\t            \"\"\"If casualty was paid, sacrifice the creature and copy the spell.\"\"\"\n91\t            # Retrieve the specific spell that triggered this effect\n92\t            if not _pending_spells:\n93\t                return\n94\t            spell = _pending_spells.pop(0)\n95\t\n96\t            # Check if casualty was actually paid for this spell\n97\t            if not getattr(spell, \"_casualty_paid\", False):\n98\t                return\n99\t\n100\t            # Sacrifice the creature (move to graveyard)\n101\t            sacrificed = getattr(spell, \"_casualty_sacrificed\", None)\n102\t            if sacrificed is not None:\n103\t                bf = game.get_battlefield(controller)\n104\t                if bf.contains(sacrificed):\n105\t                    bf.remove(sacrificed)\n106\t                    gy = game.get_graveyard(controller)\n107\t                    gy.add(sacrificed)\n108\t\n109\t            # Find the stack object for this specific spell\n110\t            original_stack_obj = None\n111\t            for stack_obj in game.stack.objects():\n112\t                if stack_obj.source is spell:\n113\t                    original_stack_obj = stack_obj\n114\t                    break\n115\t\n116\t            if original_stack_obj is None:\n117\t                return\n118\t\n119\t            # Copy the spell onto the stack\n120\t            copy_obj = copy_spell(game, original_stack_obj, controller)\n121\t            game.stack.push(copy_obj)\n122\t\n123\t        game.trigger_manager.register(TriggerRegistration(\n124\t            event_type=SpellCastTriggeredEvent,\n125\t            condition=_casualty_condition,\n126\t            effect=_casualty_effect,\n127\t            source=silverquill,\n128\t            controller=controller,\n129\t        ))\n130\t"}]},"parent_tool_use_id":"toolu_01Cpu7m9TYeeqcwsVuhYLt6R","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f","uuid":"df40eb3b-8e33-4e5a-a784-93e4ace6a208","timestamp":"2026-05-28T12:21:39.388Z","subagent_type":"Implementer","task_description":"Implement sos_245"}
