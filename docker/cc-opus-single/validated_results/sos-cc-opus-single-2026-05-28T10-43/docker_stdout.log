{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JtNHTF8zK9FSg9PqTkcG3b","type":"tool_result","content":"1\t\"\"\"Card implementation for Extravagant Replication.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom typing import TYPE_CHECKING, Any\n4\tfrom engine.card import Enchantment\n5\tfrom engine.types import CardType, ManaCost, Zone\n6\tfrom engine.events import BeginningOfUpkeepTriggeredEvent\n7\tif TYPE_CHECKING:\n8\t    from engine.game_state import GameState\n9\t\n10\tclass ExtravagantReplication(Enchantment):\n11\t    \"\"\"Extravagant Replication — {4}{U}{U} — Enchantment.\n12\t\n13\t    At the beginning of your upkeep, create a token that's a copy of\n14\t    another target nonland permanent you control.\n15\t\n16\t    FDN collector number 154.\n17\t    \"\"\"\n18\t\n19\t    def __init__(self, **kwargs: Any) -> None:\n20\t        kwargs.setdefault('name', 'Extravagant Replication')\n21\t        kwargs.setdefault('mana_cost', ManaCost.parse('{4}{U}{U}'))\n22\t        kwargs.setdefault('rules_text', \"At the beginning of your upkeep, create a token that's a copy of another target nonland permanent you control.\")\n23\t        super().__init__(**kwargs)\n24\t\n25\t    def register_triggers(self, game: 'GameState') -> None:\n26\t        \"\"\"Register upkeep trigger to copy a nonland permanent.\"\"\"\n27\t        from engine.game import create_token\n28\t        from engine.triggers import TriggerRegistration\n29\t        source = self\n30\t        controller = getattr(self, 'controller', None) or game.active_player\n31\t\n32\t        def _condition(game: Any, event: dict) -> bool:\n33\t            ctrl = getattr(source, 'controller', None)\n34\t            return game.active_player is ctrl\n35\t\n36\t        def _effect(game: 'GameState') -> None:\n37\t            ctrl = getattr(source, 'controller', None)\n38\t            if ctrl is None:\n39\t                return\n40\t            bf = game.get_battlefield(ctrl)\n41\t            candidates = []\n42\t            for obj in bf.get_all():\n43\t                if obj is source:\n44\t                    continue\n45\t                card_types = getattr(obj, 'card_types', set())\n46\t                if CardType.LAND in card_types and len(card_types) == 1:\n47\t                    continue\n48\t                if CardType.LAND not in card_types:\n49\t                    candidates.append(obj)\n50\t            if not candidates:\n51\t                return\n52\t            try:\n53\t                chosen = ctrl.choose_card(candidates, 'Choose a nonland permanent to copy')\n54\t            except Exception:\n55\t                chosen = candidates[0] if candidates else None\n56\t            if chosen is None:\n57\t                return\n58\t            import copy\n59\t            token = copy.copy(chosen)\n60\t            token.is_token = True\n61\t            create_token(game, ctrl, token)\n62\t        game.trigger_manager.register(TriggerRegistration(event_type=BeginningOfUpkeepTriggeredEvent, condition=_condition, effect=_effect, source=self, controller=controller))\n63\t"}]},"parent_tool_use_id":"toolu_01H6edwdD9h9cdEHviTEV25h","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f","uuid":"734816c4-3a02-4b28-9b39-1e093dd6ddaa","timestamp":"2026-05-28T11:07:49.002Z","subagent_type":"Implementer","task_description":"Implement sos_13"}
