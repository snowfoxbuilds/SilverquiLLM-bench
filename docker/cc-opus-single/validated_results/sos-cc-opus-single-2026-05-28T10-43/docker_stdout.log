{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BgzoxKoBfiZktJDpm8kf6r","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_120/card_impl.py b/cards/sos/sos_120/card_impl.py\n2\tindex fd0c1f4..b2ebbcc 100644\n3\t--- a/cards/sos/sos_120/card_impl.py\n4\t+++ b/cards/sos/sos_120/card_impl.py\n5\t@@ -2,15 +2,197 @@\n6\t \n7\t from __future__ import annotations\n8\t \n9\t-from engine.card import CardImpl\n10\t+from typing import TYPE_CHECKING, Any\n11\t \n12\t-from typing import TYPE_CHECKING\n13\t+from engine.card import Sorcery\n14\t+from engine.types import CardType, ManaCost, Zone\n15\t+from engine.events import TriggeredEvent\n16\t+from engine.triggers import TriggerRegistration\n17\t \n18\t if TYPE_CHECKING:\n19\t     from engine.game_state import GameState\n20\t \n21\t \n22\t-class ImprovisationCapstone(CardImpl):\n23\t-    \"\"\"TODO: Implement Improvisation Capstone.\"\"\"\n24\t+class ImprovisationCapstone(Sorcery):\n25\t+    \"\"\"Improvisation Capstone -- {5}{R}{R} -- Sorcery -- Lesson.\n26\t \n27\t-    pass\n28\t+    Exile cards from the top of your library until you exile cards with\n29\t+    total mana value 4 or greater. You may cast any number of spells\n30\t+    from among them without paying their mana costs.\n31\t+\n32\t+    Paradigm (Then exile this spell. After you first resolve a spell\n33\t+    with this name, you may cast a copy of it from exile without paying\n34\t+    its mana cost at the beginning of each of your first main phases.)\n35\t+\n36\t+    SOS collector number 120.\n37\t+    \"\"\"\n38\t+\n39\t+    def __init__(self, **kwargs: Any) -> None:\n40\t+        kwargs.setdefault(\"name\", \"Improvisation Capstone\")\n41\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{5}{R}{R}\"))\n42\t+        kwargs.setdefault(\"subtypes\", {\"Lesson\"})\n43\t+        kwargs.setdefault(\n44\t+            \"rules_text\",\n45\t+            \"Exile cards from the top of your library until you exile cards \"\n46\t+            \"with total mana value 4 or greater. You may cast any number of \"\n47\t+            \"spells from among them without paying their mana costs.\\n\"\n48\t+            \"Paradigm (Then exile this spell. After you first resolve a spell \"\n49\t+            \"with this name, you may cast a copy of it from exile without \"\n50\t+            \"paying its mana cost at the beginning of each of your first \"\n51\t+            \"main phases.)\",\n52\t+        )\n53\t+        super().__init__(**kwargs)\n54\t+\n55\t+    def on_resolve(self, game: GameState) -> None:\n56\t+        \"\"\"Resolve: exile from library, free-cast, then Paradigm.\"\"\"\n57\t+        controller = self.controller or self.owner\n58\t+        if controller is None:\n59\t+            return\n60\t+\n61\t+        # --- Main effect: exile from top of library until total MV >= 4 ---\n62\t+        library = game.get_library(controller)\n63\t+        exile = game.get_exile(controller)\n64\t+        exiled_cards: list[Any] = []\n65\t+        total_mv = 0\n66\t+\n67\t+        while len(library) > 0 and total_mv < 4:\n68\t+            # Take from the top of the library (last element)\n69\t+            top_cards = library.top(1)\n70\t+            if not top_cards:\n71\t+                break\n72\t+            card = top_cards[0]\n73\t+            library.remove(card)\n74\t+            exile.add(card)\n75\t+            exiled_cards.append(card)\n76\t+            # Add the card's mana value to the running total\n77\t+            card_cost = getattr(card, \"mana_cost\", None)\n78\t+            if card_cost is not None:\n79\t+                total_mv += card_cost.cmc\n80\t+\n81\t+        # --- Free-cast from among exiled cards ---\n82\t+        # For each non-land exiled card, ask the controller whether to cast it\n83\t+        for card in exiled_cards:\n84\t+            card_types = getattr(card, \"card_types\", set())\n85\t+            # Lands cannot be cast (they are not spells)\n86\t+            if CardType.LAND in card_types:\n87\t+                continue\n88\t+\n89\t+            # Ask the player whether they want to cast this spell\n90\t+            try:\n91\t+                wants_to_cast = controller.choose_yes_no(\n92\t+                    f\"Cast {getattr(card, 'name', 'card')} without paying its mana cost?\"\n93\t+                )\n94\t+            except Exception:\n95\t+                continue\n96\t+\n97\t+            if not wants_to_cast:\n98\t+                continue\n99\t+\n100\t+            # Cast the spell: resolve it immediately (simplified free-cast)\n101\t+            # Remove from exile first\n102\t+            if exile.contains(card):\n103\t+                exile.remove(card)\n104\t+\n105\t+            # Set controller/owner\n106\t+            card.controller = controller\n107\t+            if card.owner is None:\n108\t+                card.owner = controller\n109\t+\n110\t+            # Resolve the spell\n111\t+            card.on_resolve(game)\n112\t+\n113\t+            # Determine where the card goes after resolution\n114\t+            permanent_types = {\n115\t+                CardType.CREATURE, CardType.ENCHANTMENT,\n116\t+                CardType.ARTIFACT, CardType.PLANESWALKER\n117\t+            }\n118\t+            if card_types & permanent_types:\n119\t+                # Permanents go to the battlefield\n120\t+                battlefield = game.get_battlefield(controller)\n121\t+                battlefield.add(card)\n122\t+            else:\n123\t+                # Non-permanents (instant/sorcery) go to the graveyard\n124\t+                graveyard = game.get_graveyard(controller)\n125\t+                graveyard.add(card)\n126\t+\n127\t+        # --- Paradigm ---\n128\t+        # 1. Exile this spell (set marker for _resolve_spell in casting pipeline)\n129\t+        #    The _paradigm_exile flag tells _resolve_spell to move the card\n130\t+        #    from stack to exile instead of stack to graveyard, consistent with\n131\t+        #    the _dawning_archaic_exile pattern from sos_1.\n132\t+        self._paradigm_exile = True  # type: ignore[attr-defined]\n133\t+\n134\t+        # 2. Register a delayed trigger for Paradigm (only on first resolution)\n135\t+        # Use a game-level tracker to ensure we only register once per card name\n136\t+        if not hasattr(game, \"_paradigm_registered\"):\n137\t+            game._paradigm_registered = set()  # type: ignore[attr-defined]\n138\t+\n139\t+        card_name = self.name\n140\t+        if card_name not in game._paradigm_registered:  # type: ignore[attr-defined]\n141\t+            game._paradigm_registered.add(card_name)  # type: ignore[attr-defined]\n142\t+\n143\t+            paradigm_controller = controller\n144\t+            paradigm_source = self\n145\t+\n146\t+            def _paradigm_condition(g: GameState, event: Any) -> bool:\n147\t+                \"\"\"Fire at the beginning of controller's precombat main phase.\"\"\"\n148\t+                from engine.types import Phase\n149\t+                active = getattr(g, \"active_player\", None)\n150\t+                phase = getattr(g, \"phase\", None)\n151\t+                if active is not paradigm_controller:\n152\t+                    return False\n153\t+                return phase == Phase.PRECOMBAT_MAIN\n154\t+\n155\t+            def _paradigm_effect(g: GameState) -> None:\n156\t+                \"\"\"Cast a copy of Improvisation Capstone from exile for free.\n157\t+\n158\t+                Finds the exiled original, creates a shallow copy, and offers\n159\t+                the controller a free-cast.  The copy resolves immediately\n160\t+                using the simplified free-cast pipeline (same as the main\n161\t+                effect's free-cast of exiled spells).\n162\t+                \"\"\"\n163\t+                import copy as _copy\n164\t+\n165\t+                ctrl = paradigm_controller\n166\t+                if ctrl is None:\n167\t+                    return\n168\t+\n169\t+                # Find an Improvisation Capstone in exile\n170\t+                exile_zone = g.get_exile(ctrl)\n171\t+                original = None\n172\t+                for c in exile_zone.get_all():\n173\t+                    if getattr(c, \"name\", \"\") == \"Improvisation Capstone\":\n174\t+                        original = c\n175\t+                        break\n176\t+\n177\t+                if original is None:\n178\t+                    return\n179\t+\n180\t+                # Ask the controller whether they want to cast the copy\n181\t+                try:\n182\t+                    wants_to_cast = ctrl.choose_yes_no(\n183\t+                        \"Cast a copy of Improvisation Capstone from exile \"\n184\t+                        \"without paying its mana cost?\"\n185\t+                    )\n186\t+                except Exception:\n187\t+                    return\n188\t+\n189\t+                if not wants_to_cast:\n190\t+                    return\n191\t+\n192\t+                # Create a copy of the card\n193\t+                copied = _copy.copy(original)\n194\t+                copied.controller = ctrl\n195\t+                copied.owner = ctrl\n196\t+\n197\t+                # Resolve the copy immediately (simplified free-cast)\n198\t+                copied.on_resolve(g)\n199\t+\n200\t+            trigger_reg = TriggerRegistration(\n201\t+                event_type=TriggeredEvent,\n202\t+                condition=_paradigm_condition,\n203\t+                effect=_paradigm_effect,\n204\t+                source=self,\n205\t+                controller=controller,\n206\t+            )\n207\t+            game.trigger_manager.register(trigger_reg)\n208\t"}]},"parent_tool_use_id":"toolu_014vHCnVAnQfkea4yrVkDgBL","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f","uuid":"f3d3d57d-b56e-4204-8986-b396efefcf55","timestamp":"2026-05-28T11:55:55.895Z","subagent_type":"Implementer","task_description":"Revise sos_120 per review"}
