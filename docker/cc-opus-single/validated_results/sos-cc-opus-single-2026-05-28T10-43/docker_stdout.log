lementer should build whatever is needed and tests should be able to cover it.\n43\t+- Option (a): Implementer builds the infrastructure; Tester may be re-invoked if needed.\n44\t+\n45\tdiff --git a/cards/sos/sos_257/card_impl.py b/cards/sos/sos_257/card_impl.py\n46\tindex e5f8e2f..fa7d786 100644\n47\t--- a/cards/sos/sos_257/card_impl.py\n48\t+++ b/cards/sos/sos_257/card_impl.py\n49\t@@ -2,15 +2,190 @@\n50\t \n51\t from __future__ import annotations\n52\t \n53\t-from engine.card import CardImpl\n54\t+from typing import TYPE_CHECKING, Any\n55\t \n56\t-from typing import TYPE_CHECKING\n57\t+from engine.card import ActivatedAbility, Land, ManaAbility\n58\t+from engine.events import SpellCastTriggeredEvent\n59\t+from engine.triggers import TriggerRegistration\n60\t+from engine.types import CardType, ManaCost, ManaType\n61\t \n62\t if TYPE_CHECKING:\n63\t     from engine.game_state import GameState\n64\t \n65\t \n66\t-class GreatHallOfTheBiblioplex(CardImpl):\n67\t-    \"\"\"TODO: Implement Great Hall of the Biblioplex.\"\"\"\n68\t+class GreatHallOfTheBiblioplex(Land):\n69\t+    \"\"\"Great Hall of the Biblioplex -- Land\n70\t \n71\t-    pass\n72\t+    {T}: Add {C}.\n73\t+    {T}, Pay 1 life: Add one mana of any color. Spend this mana only to cast\n74\t+    an instant or sorcery spell.\n75\t+    {5}: If this land isn't a creature, it becomes a 2/4 Wizard creature with\n76\t+    \"Whenever you cast an instant or sorcery spell, this creature gets +1/+0\n77\t+    until end of turn.\" It's still a land.\n78\t+\n79\t+    SOS collector number 257.\n80\t+    \"\"\"\n81\t+\n82\t+    def __init__(self, **kwargs: Any) -> None:\n83\t+        kwargs.setdefault(\"name\", \"Great Hall of the Biblioplex\")\n84\t+        kwargs.setdefault(\n85\t+            \"rules_text\",\n86\t+            \"{T}: Add {C}.\\n\"\n87\t+            \"{T}, Pay 1 life: Add one mana of any color. Spend this mana \"\n88\t+            \"only to cast an instant or sorcery spell.\\n\"\n89\t+            \"{5}: If this land isn't a creature, it becomes a 2/4 Wizard \"\n90\t+            \"creature with \\\"Whenever you cast an instant or sorcery spell, \"\n91\t+            \"this creature gets +1/+0 until end of turn.\\\" It's still a land.\",\n92\t+        )\n93\t+        super().__init__(**kwargs)\n94\t+        # Creature stats when animated\n95\t+        self._is_animated: bool = False\n96\t+        self._power_bonus: int = 0\n97\t+\n98\t+    # ------------------------------------------------------------------\n99\t+    # Properties for creature stats after animation\n100\t+    # ------------------------------------------------------------------\n101\t+\n102\t+    @property\n103\t+    def power(self) -> int:\n104\t+        \"\"\"Current power (only meaningful when animated).\"\"\"\n105\t+        if self._is_animated:\n106\t+            return 2 + self._power_bonus\n107\t+        return None  # type: ignore[return-value]\n108\t+\n109\t+    @property\n110\t+    def toughness(self) -> int:\n111\t+        \"\"\"Current toughness (only meaningful when animated).\"\"\"\n112\t+        if self._is_animated:\n113\t+            return 4\n114\t+        return None  # type: ignore[return-value]\n115\t+\n116\t+    @property\n117\t+    def base_power(self) -> int | None:\n118\t+        if self._is_animated:\n119\t+            return 2\n120\t+        return None\n121\t+\n122\t+    @property\n123\t+    def base_toughness(self) -> int | None:\n124\t+        if self._is_animated:\n125\t+            return 4\n126\t+        return None\n127\t+\n128\t+    # ------------------------------------------------------------------\n129\t+    # Mana abilities\n130\t+    # ------------------------------------------------------------------\n131\t+\n132\t+    def get_mana_abilities(self) -> list[ManaAbility]:\n133\t+        source = self\n134\t+\n135\t+        def _colorless_tap_cost(game: Any) -> bool:\n136\t+            if source.is_tapped:\n137\t+                return False\n138\t+            source.is_tapped = True\n139\t+            return True\n140\t+\n141\t+        def _colorless_mana_produced(game: Any) -> None:\n142\t+            controller = source.controller\n143\t+            if controller is not None:\n144\t+                controller.mana_pool.add(ManaType.COLORLESS, 1)\n145\t+\n146\t+        def _any_color_tap_cost(game: Any) -> bool:\n147\t+            if source.is_tapped:\n148\t+                return False\n149\t+            controller = source.controller\n150\t+            if controller is None or controller.life < 1:\n151\t+                return False\n152\t+            source.is_tapped = True\n153\t+            controller.life -= 1\n154\t+            return True\n155\t+\n156\t+        def _any_color_mana_produced(game: Any) -> None:\n157\t+            # ENGINE LIMITATION: The engine does not support conditional mana\n158\t+            # spending restrictions. This should only be usable to cast\n159\t+            # instant or sorcery spells. The restriction is not enforced here.\n160\t+            controller = source.controller\n161\t+            if controller is not None:\n162\t+                color_options = [\n163\t+                    ManaType.WHITE, ManaType.BLUE, ManaType.BLACK,\n164\t+                    ManaType.RED, ManaType.GREEN,\n165\t+                ]\n166\t+                chosen_color = controller.choose(\n167\t+                    color_options,\n168\t+                    \"Choose a color of mana to produce\",\n169\t+                )\n170\t+                controller.mana_pool.add(chosen_color, 1)\n171\t+\n172\t+        return [\n173\t+            ManaAbility(\n174\t+                cost=_colorless_tap_cost,\n175\t+                mana_produced=_colorless_mana_produced,\n176\t+                description=\"{T}: Add {C}.\",\n177\t+            ),\n178\t+            ManaAbility(\n179\t+                cost=_any_color_tap_cost,\n180\t+                mana_produced=_any_color_mana_produced,\n181\t+                description=\"{T}, Pay 1 life: Add one mana of any color.\",\n182\t+            ),\n183\t+        ]\n184\t+\n185\t+    # ------------------------------------------------------------------\n186\t+    # Activated abilities\n187\t+    # ------------------------------------------------------------------\n188\t+\n189\t+    def get_activated_abilities(self) -> list[ActivatedAbility]:\n190\t+        source = self\n191\t+\n192\t+        def _animate_cost(game: Any) -> bool:\n193\t+            controller = source.controller\n194\t+            if controller is None:\n195\t+                return False\n196\t+            cost = ManaCost(generic=5)\n197\t+            if not controller.mana_pool.can_pay(cost):\n198\t+                return False\n199\t+            controller.mana_pool.pay(cost)\n200\t+            return True\n201\t+\n202\t+        def _animate_effect(game: Any) -> None:\n203\t+            # \"If this land isn't a creature...\"\n204\t+            if CardType.CREATURE in source.card_types:\n205\t+                return\n206\t+            # It becomes a 2/4 Wizard creature. It's still a land.\n207\t+            source.card_types.add(CardType.CREATURE)\n208\t+            source.subtypes.add(\"Wizard\")\n209\t+            source._is_animated = True\n210\t+            source._power_bonus = 0\n211\t+\n212\t+            # Register the triggered ability:\n213\t+            # \"Whenever you cast an instant or sorcery spell, this creature\n214\t+            #  gets +1/+0 until end of turn.\"\n215\t+            def _spell_cast_condition(game: Any, event: Any) -> bool:\n216\t+                # Must be controlled by the same player\n217\t+                if event.controller is not source.controller:\n218\t+                    return False\n219\t+                spell = event.spell\n220\t+                if spell is None:\n221\t+                    return False\n222\t+                spell_types = getattr(spell, \"card_types\", set())\n223\t+                return (CardType.INSTANT in spell_types or\n224\t+                        CardType.SORCERY in spell_types)\n225\t+\n226\t+            def _pump_effect(game: Any) -> None:\n227\t+                source._power_bonus += 1\n228\t+\n229\t+            trigger = TriggerRegistration(\n230\t+                event_type=SpellCastTriggeredEvent,\n231\t+                condition=_spell_cast_condition,\n232\t+                effect=_pump_effect,\n233\t+                source=source,\n234\t+                controller=source.controller,\n235\t+            )\n236\t+            game.trigger_manager.register(trigger)\n237\t+\n238\t+        return [\n239\t+            ActivatedAbility(\n240\t+                cost=_animate_cost,\n241\t+                effect=_animate_effect,\n242\t+                description=\"{5}: Animate into 2/4 Wizard creature.\",\n243\t+            ),\n244\t+        ]\n245\tdiff --git a/run_manifest.json b/run_manifest.json\n246\tindex f6735dd..a8459cf 100644\n247\t--- a/run_manifest.json\n248\t+++ b/run_manifest.json\n249\t@@ -1,6 +1,8 @@\n250\t {\n251\t-  \"benchmark_set\": \"sos\",\n252\t-  \"cards\": [\n253\t+  \"timeout_seconds\": 360000,\n254\t+  \"deadline_utc\": \"2026-06-01T14:43:01Z\",\n255\t+  \"docker_image\": \"silverquillm-cc-opus-single:latest\",\n256\t+  \"card_filter\": [\n257\t     \"1\",\n258\t     \"4\",\n259\t     \"13\",\n260\t@@ -11,5 +13,6 @@\n261\t     \"226\",\n262\t     \"245\",\n263\t     \"257\"\n264\t-  ]\n265\t-}\n266\t\\ No newline at end of file\n267\t+  ],\n268\t+  \"benchmark_set\": \"sos\"\n269\t+}\n270\t"}]},"parent_tool_use_id":"toolu_01C2BAF6ShCuGXBYCTxncvgX","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f","uuid":"389c8522-029a-4814-be8a-1d90ccd4f80a","timestamp":"2026-05-28T12:34:53.391Z","subagent_type":"Reviewer","task_description":"Review sos_257 implementation"}
