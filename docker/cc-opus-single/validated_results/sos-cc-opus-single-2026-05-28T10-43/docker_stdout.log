{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Nz9Ejr5kTucqhnKgUhLq1s","type":"tool_result","content":"1\t\"\"\"Tests for SOS 13 — Emeritus of Truce // Swords to Plowshares.\n2\t\n3\tEmeritus of Truce is a preparation card:\n4\t  Front face: Creature — Cat Cleric, {1}{W}{W}, 3/3\n5\t  Prepare spell: Swords to Plowshares, Instant, {W}\n6\t\n7\tOracle text (front face):\n8\t  \"When this creature enters, target player creates a 1/1 white and\n9\t  black Inkling creature token with flying. Then if an opponent controls\n10\t  more creatures than you, this creature becomes prepared. (While it's\n11\t  prepared, you may cast a copy of its spell. Doing so unprepares it.)\"\n12\t\n13\tRequirements tested:\n14\t  1. Static properties (name, mana cost, P/T, subtypes, creature type).\n15\t  2. ETB trigger registration for the enters-the-battlefield ability.\n16\t  3. ETB effect: target player creates a 1/1 white+black Inkling token\n17\t     with flying.\n18\t  4. Prepared condition: after token creation, becomes prepared if an\n19\t     opponent controls more creatures than the controller.\n20\t  5. Prepared designation attribute tracking.\n21\t\"\"\"\n22\t\n23\tfrom __future__ import annotations\n24\t\n25\tfrom cards.sos.sos_13.card_impl import EmeritusOfTruceSwordsToPlowshares\n26\tfrom engine.card import Creature, Instant\n27\tfrom engine.events import EntersBattlefieldTriggeredEvent\n28\tfrom engine.types import CardType, Keyword, ManaCost, ManaType, TargetRequirement, Zone\n29\tfrom test_utils import create_game, set_board_state\n30\t\n31\t\n32\t# ---------------------------------------------------------------------------\n33\t# Static properties\n34\t# ---------------------------------------------------------------------------\n35\t\n36\tclass TestEmeritusStaticProperties:\n37\t    \"\"\"Static card data should match the SOS 13 spec.\"\"\"\n38\t\n39\t    def test_is_creature(self) -> None:\n40\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n41\t        assert isinstance(card, Creature)\n42\t\n43\t    def test_name(self) -> None:\n44\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n45\t        assert card.name == \"Emeritus of Truce // Swords to Plowshares\"\n46\t\n47\t    def test_mana_cost(self) -> None:\n48\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n49\t        assert card.mana_cost == ManaCost.parse(\"{1}{W}{W}\")\n50\t\n51\t    def test_power(self) -> None:\n52\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n53\t        assert card.base_power == 3\n54\t\n55\t    def test_toughness(self) -> None:\n56\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n57\t        assert card.base_toughness == 3\n58\t\n59\t    def test_subtypes_include_cat_and_cleric(self) -> None:\n60\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n61\t        assert \"Cat\" in card.subtypes\n62\t        assert \"Cleric\" in card.subtypes\n63\t\n64\t    def test_has_creature_card_type(self) -> None:\n65\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n66\t        assert CardType.CREATURE in card.card_types\n67\t\n68\t\n69\t# ---------------------------------------------------------------------------\n70\t# ETB trigger registration\n71\t# ---------------------------------------------------------------------------\n72\t\n73\tclass TestEmeritusETBTriggerRegistration:\n74\t    \"\"\"register_triggers must wire an ETB trigger through trigger_manager.\"\"\"\n75\t\n76\t    def test_registers_at_least_one_trigger(self) -> None:\n77\t        game = create_game()\n78\t        p1 = game.players[0]\n79\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n80\t        before = len(game.trigger_manager.get_triggers())\n81\t        card.register_triggers(game)\n82\t        after = len(game.trigger_manager.get_triggers())\n83\t        assert after > before\n84\t\n85\t    def test_registered_trigger_watches_etb_event(self) -> None:\n86\t        game = create_game()\n87\t        p1 = game.players[0]\n88\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n89\t        card.register_triggers(game)\n90\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n91\t        assert len(triggers) >= 1\n92\t        etb_trigger = triggers[0]\n93\t        assert etb_trigger.event_type is EntersBattlefieldTriggeredEvent\n94\t\n95\t    def test_trigger_condition_fires_only_for_self(self) -> None:\n96\t        \"\"\"The ETB trigger should fire when this creature itself enters,\n97\t        not when some other creature enters.\"\"\"\n98\t        game = create_game()\n99\t        p1 = game.players[0]\n100\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n101\t        card.register_triggers(game)\n102\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n103\t        etb_trigger = triggers[0]\n104\t        # Condition should match when the entering permanent is self.\n105\t        self_event = EntersBattlefieldTriggeredEvent(\n106\t            permanent=card, controller=p1\n107\t        )\n108\t        assert etb_trigger.condition is None or etb_trigger.condition(game, self_event)\n109\t        # Condition should NOT match when some other creature enters.\n110\t        other = Creature(name=\"Bear\", owner=p1, controller=p1, base_power=2, base_toughness=2)\n111\t        other_event = EntersBattlefieldTriggeredEvent(\n112\t            permanent=other, controller=p1\n113\t        )\n114\t        if etb_trigger.condition is not None:\n115\t            assert etb_trigger.condition(game, other_event) is False\n116\t\n117\t\n118\t# ---------------------------------------------------------------------------\n119\t# ETB effect — Inkling token creation\n120\t# ---------------------------------------------------------------------------\n121\t\n122\tclass TestEmeritusInklingTokenCreation:\n123\t    \"\"\"When the ETB trigger resolves, the target player creates a 1/1\n124\t    white and black Inkling creature token with flying.\"\"\"\n125\t\n126\t    def _setup_and_fire_etb(self, game, controller, target_player):\n127\t        \"\"\"Put the card on battlefield, register triggers, and fire its\n128\t        ETB effect directly.\"\"\"\n129\t        card = EmeritusOfTruceSwordsToPlowshares(\n130\t            owner=controller, controller=controller\n131\t        )\n132\t        game.get_battlefield(controller).add(card)\n133\t        card.register_triggers(game)\n134\t\n135\t        # Find the ETB trigger and resolve its effect directly.\n136\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n137\t        etb_trigger = triggers[0]\n138\t\n139\t        # Set chosen_targets on the card so the effect knows which\n140\t        # player receives the token.\n141\t        card.chosen_targets = [target_player]\n142\t\n143\t        etb_trigger.effect(game)\n144\t        return card\n145\t\n146\t    def test_controller_gets_inkling_when_self_is_target(self) -> None:\n147\t        game = create_game()\n148\t        p1 = game.players[0]\n149\t        bf_before = len(game.get_battlefield(p1).get_all())\n150\t        # Card is already on battlefield from _setup; count its own addition\n151\t        self._setup_and_fire_etb(game, p1, p1)\n152\t        bf_after = game.get_battlefield(p1).get_all()\n153\t        # There should be at least one new token besides the card itself.\n154\t        tokens = [\n155\t            obj for obj in bf_after\n156\t            if getattr(obj, \"is_token\", False)\n157\t        ]\n158\t        assert len(tokens) >= 1\n159\t\n160\t    def test_opponent_gets_inkling_when_opponent_is_target(self) -> None:\n161\t        game = create_game()\n162\t        p1 = game.players[0]\n163\t        p2 = game.players[1]\n164\t        bf_before = len(game.get_battlefield(p2).get_all())\n165\t        self._setup_and_fire_etb(game, p1, p2)\n166\t        bf_after = game.get_battlefield(p2).get_all()\n167\t        tokens = [\n168\t            obj for obj in bf_after\n169\t            if getattr(obj, \"is_token\", False)\n170\t        ]\n171\t        assert len(tokens) >= 1\n172\t\n173\t    def test_inkling_token_is_creature(self) -> None:\n174\t        game = create_game()\n175\t        p1 = game.players[0]\n176\t        self._setup_and_fire_etb(game, p1, p1)\n177\t        tokens = [\n178\t            obj for obj in game.get_battlefield(p1).get_all()\n179\t            if getattr(obj, \"is_token\", False)\n180\t        ]\n181\t        assert len(tokens) >= 1\n182\t        token = tokens[0]\n183\t        assert isinstance(token, Creature)\n184\t\n185\t    def test_inkling_token_is_one_one(self) -> None:\n186\t        game = create_game()\n187\t        p1 = game.players[0]\n188\t        self._setup_and_fire_etb(game, p1, p1)\n189\t        tokens = [\n190\t            obj for obj in game.get_battlefield(p1).get_all()\n191\t            if getattr(obj, \"is_token\", False)\n192\t        ]\n193\t        assert len(tokens) >= 1\n194\t        token = tokens[0]\n195\t        assert token.base_power == 1\n196\t        assert token.base_toughness == 1\n197\t\n198\t    def test_inkling_token_has_flying(self) -> None:\n199\t        game = create_game()\n200\t        p1 = game.players[0]\n201\t        self._setup_and_fire_etb(game, p1, p1)\n202\t        tokens = [\n203\t            obj for obj in game.get_battlefield(p1).get_all()\n204\t            if getattr(obj, \"is_token\", False)\n205\t        ]\n206\t        assert len(tokens) >= 1\n207\t        token = tokens[0]\n208\t        assert Keyword.FLYING in token.keywords\n209\t\n210\t    def test_inkling_token_has_inkling_subtype(self) -> None:\n211\t        game = create_game()\n212\t        p1 = game.players[0]\n213\t        self._setup_and_fire_etb(game, p1, p1)\n214\t        tokens = [\n215\t            obj for obj in game.get_battlefield(p1).get_all()\n216\t            if getattr(obj, \"is_token\", False)\n217\t        ]\n218\t        assert len(tokens) >= 1\n219\t        token = tokens[0]\n220\t        assert \"Inkling\" in token.subtypes\n221\t\n222\t    def test_inkling_token_name(self) -> None:\n223\t        \"\"\"Token should be named 'Inkling'.\"\"\"\n224\t        game = create_game()\n225\t        p1 = game.players[0]\n226\t        self._setup_and_fire_etb(game, p1, p1)\n227\t        tokens = [\n228\t            obj for obj in game.get_battlefield(p1).get_all()\n229\t            if getattr(obj, \"is_token\", False)\n230\t        ]\n231\t        assert len(tokens) >= 1\n232\t        token = tokens[0]\n233\t        assert token.name == \"Inkling\"\n234\t\n235\t\n236\t# ---------------------------------------------------------------------------\n237\t# Prepared condition check\n238\t# ---------------------------------------------------------------------------\n239\t\n240\tclass TestEmeritusPreparedCondition:\n241\t    \"\"\"After creating the Inkling token, the card becomes prepared if\n242\t    an opponent controls more creatures than the controller.\"\"\"\n243\t\n244\t    def test_becomes_prepared_when_opponent_has_more_creatures(self) -> None:\n245\t        \"\"\"Opponent controls more creatures than controller =>\n246\t        card should become prepared.\"\"\"\n247\t        game = create_game()\n248\t        p1 = game.players[0]\n249\t        p2 = game.players[1]\n250\t\n251\t        # Give opponent several creatures so they control more.\n252\t        for i in range(3):\n253\t            bear = Creature(\n254\t                name=f\"Bear {i}\", owner=p2, controller=p2,\n255\t                base_power=2, base_toughness=2,\n256\t            )\n257\t            game.get_battlefield(p2).add(bear)\n258\t\n259\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n260\t        game.get_battlefield(p1).add(card)\n261\t        card.register_triggers(game)\n262\t\n263\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n264\t        etb_trigger = triggers[0]\n265\t        # Target self (p1) so Inkling goes to p1.\n266\t        card.chosen_targets = [p1]\n267\t        etb_trigger.effect(game)\n268\t\n269\t        # After ETB, p1 has: card + Inkling = 2 creatures.\n270\t        # p2 has 3 bears => opponent has more => should be prepared.\n271\t        assert getattr(card, \"is_prepared\", False) is True or \\\n272\t               getattr(card, \"prepared\", False) is True\n273\t\n274\t    def test_not_prepared_when_controller_has_equal_or_more_creatures(self) -> None:\n275\t        \"\"\"Controller has >= creatures as opponent => card should NOT\n276\t        become prepared.\"\"\"\n277\t        game = create_game()\n278\t        p1 = game.players[0]\n279\t        p2 = game.players[1]\n280\t\n281\t        # Give controller extra creatures so they have at least as many.\n282\t        for i in range(3):\n283\t            bear = Creature(\n284\t                name=f\"Bear {i}\", owner=p1, controller=p1,\n285\t                base_power=2, base_toughness=2,\n286\t            )\n287\t            game.get_battlefield(p1).add(bear)\n288\t\n289\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n290\t        game.get_battlefield(p1).add(card)\n291\t        card.register_triggers(game)\n292\t\n293\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n294\t        etb_trigger = triggers[0]\n295\t        card.chosen_targets = [p1]\n296\t        etb_trigger.effect(game)\n297\t\n298\t        # p1: 3 bears + card + Inkling = 5 creatures.\n299\t        # p2: 0 creatures => controller has more => NOT prepared.\n300\t        is_prep = getattr(card, \"is_prepared\", False) or \\\n301\t                  getattr(card, \"prepared\", False)\n302\t        assert is_prep is False\n303\t\n304\t    def test_not_prepared_when_opponent_has_fewer_creatures(self) -> None:\n305\t        \"\"\"Opponent has fewer creatures => card should NOT become prepared.\"\"\"\n306\t        game = create_game()\n307\t        p1 = game.players[0]\n308\t        p2 = game.players[1]\n309\t\n310\t        # p2 has one creature, p1 will have card + Inkling = 2.\n311\t        bear = Creature(\n312\t            name=\"Bear\", owner=p2, controller=p2,\n313\t            base_power=2, base_toughness=2,\n314\t        )\n315\t        game.get_battlefield(p2).add(bear)\n316\t\n317\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n318\t        game.get_battlefield(p1).add(card)\n319\t        card.register_triggers(game)\n320\t\n321\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n322\t        etb_trigger = triggers[0]\n323\t        card.chosen_targets = [p1]\n324\t        etb_trigger.effect(game)\n325\t\n326\t        # p1: card + Inkling = 2, p2: 1 bear => not strictly more.\n327\t        is_prep = getattr(card, \"is_prepared\", False) or \\\n328\t                  getattr(card, \"prepared\", False)\n329\t        assert is_prep is False\n330\t\n331\t    def test_prepared_accounts_for_inkling_given_to_opponent(self) -> None:\n332\t        \"\"\"When the Inkling token goes to the opponent, the creature count\n333\t        comparison should include that token on the opponent's side.\"\"\"\n334\t        game = create_game()\n335\t        p1 = game.players[0]\n336\t        p2 = game.players[1]\n337\t\n338\t        # p2 starts with 1 creature. Token also goes to p2 => p2 has 2.\n339\t        bear = Creature(\n340\t            name=\"Bear\", owner=p2, controller=p2,\n341\t            base_power=2, base_toughness=2,\n342\t        )\n343\t        game.get_battlefield(p2).add(bear)\n344\t\n345\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n346\t        game.get_battlefield(p1).add(card)\n347\t        card.register_triggers(game)\n348\t\n349\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n350\t        etb_trigger = triggers[0]\n351\t        # Target opponent so Inkling goes to p2.\n352\t        card.chosen_targets = [p2]\n353\t        etb_trigger.effect(game)\n354\t\n355\t        # p1: card = 1 creature. p2: bear + Inkling = 2 => opponent has more.\n356\t        assert getattr(card, \"is_prepared\", False) is True or \\\n357\t               getattr(card, \"prepared\", False) is True\n358\t\n359\t\n360\t# ---------------------------------------------------------------------------\n361\t# Prepared designation attribute\n362\t# ---------------------------------------------------------------------------\n363\t\n364\tclass TestEmeritusPreparedDesignation:\n365\t    \"\"\"The card should track a 'prepared' or 'is_prepared' designation\n366\t    attribute that starts as False and can be toggled.\"\"\"\n367\t\n368\t    def test_starts_not_prepared(self) -> None:\n369\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n370\t        is_prep = getattr(card, \"is_prepared\", False) or \\\n371\t                  getattr(card, \"prepared\", False)\n372\t        assert is_prep is False\n373\t\n374\t\n375\t# ---------------------------------------------------------------------------\n376\t# ETB targeting\n377\t# ---------------------------------------------------------------------------\n378\t\n379\tclass TestEmeritusTargeting:\n380\t    \"\"\"The ETB trigger targets a player. The card implementation should\n381\t    support targeting requirements or chosen_targets for player selection.\"\"\"\n382\t\n383\t    def test_etb_target_is_player(self) -> None:\n384\t        \"\"\"The ETB ability targets 'target player', meaning it should\n385\t        accept any player as a valid target.\"\"\"\n386\t        game = create_game()\n387\t        p1 = game.players[0]\n388\t        p2 = game.players[1]\n389\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n390\t\n391\t        # If get_targets is implemented, it should return a requirement\n392\t        # for a player target. If not, chosen_targets must be settable.\n393\t        targets = card.get_targets(game)\n394\t        if targets:\n395\t            req = targets[0]\n396\t            assert isinstance(req, TargetRequirement)\n397\t        else:\n398\t            # Even without get_targets, chosen_targets must be accepted.\n399\t            card.chosen_targets = [p2]\n400\t            assert card.chosen_targets == [p2]\n401\t\n402\t\n403\t# ---------------------------------------------------------------------------\n404\t# Full cast integration\n405\t# ---------------------------------------------------------------------------\n406\t\n407\tclass TestEmeritusCastAndResolve:\n408\t    \"\"\"Test casting the creature via cast_spell and verifying the ETB fires.\"\"\"\n409\t\n410\t    def test_cast_creates_inkling_token(self) -> None:\n411\t        \"\"\"Casting Emeritus of Truce should trigger the ETB and create\n412\t        an Inkling token for the target player.\"\"\"\n413\t        from test_utils import cast_spell\n414\t\n415\t        game = create_game()\n416\t        p1 = game.players[0]\n417\t        p2 = game.players[1]\n418\t\n419\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1)\n420\t        set_board_state(\n421\t            game, 0,\n422\t            hand=[card],\n423\t            mana={ManaType.WHITE: 3, ManaType.COLORLESS: 1},\n424\t        )\n425\t\n426\t        # Script the target choice (p1 targets self to get the token).\n427\t        cast_spell(game, 0, \"Emeritus of Truce // Swords to Plowshares\",\n428\t                   targets=[p1])\n429\t\n430\t        # The card should be on the battlefield.\n431\t        bf = game.get_battlefield(p1).get_all()\n432\t        card_on_bf = [\n433\t            obj for obj in bf\n434\t            if getattr(obj, \"name\", \"\") == \"Emeritus of Truce // Swords to Plowshares\"\n435\t        ]\n436\t        assert len(card_on_bf) >= 1\n437\t\n438\t        # An Inkling token should be on p1's battlefield.\n439\t        tokens = [\n440\t            obj for obj in bf\n441\t            if getattr(obj, \"is_token\", False)\n442\t        ]\n443\t        assert len(tokens) >= 1\n444\t        token = tokens[0]\n445\t        assert token.base_power == 1\n446\t        assert token.base_toughness == 1\n447\t        assert Keyword.FLYING in token.keywords\n448\t\n449\t\n450\t# ---------------------------------------------------------------------------\n451\t# Prepare spell — Swords to Plowshares effect\n452\t# ---------------------------------------------------------------------------\n453\t\n454\tclass TestSwordsToPlowsharesEffect:\n455\t    \"\"\"When the card is prepared and the Swords to Plowshares prepare\n456\t    spell is cast, it should: exile target creature, and its controller\n457\t    gains life equal to its power.\n458\t\n459\t    The prepare mechanic (per oracle reminder text): while prepared, the\n460\t    controller may cast a copy of the prepare spell. Doing so unprepares\n461\t    the creature.\n462\t    \"\"\"\n463\t\n464\t    def _make_prepared_emeritus(self, game, controller):\n465\t        \"\"\"Place an Emeritus on the battlefield and mark it prepared.\"\"\"\n466\t        card = EmeritusOfTruceSwordsToPlowshares(\n467\t            owner=controller, controller=controller\n468\t        )\n469\t        game.get_battlefield(controller).add(card)\n470\t        card.is_prepared = True\n471\t        return card\n472\t\n473\t    def test_prepare_spell_exiles_target_creature(self) -> None:\n474\t        \"\"\"Swords to Plowshares should exile the target creature,\n475\t        removing it from the battlefield.\"\"\"\n476\t        game = create_game()\n477\t        p1 = game.players[0]\n478\t        p2 = game.players[1]\n479\t\n480\t        card = self._make_prepared_emeritus(game, p1)\n481\t\n482\t        # Place a target creature on the opponent's battlefield.\n483\t        target = Creature(\n484\t            name=\"Grizzly Bears\", owner=p2, controller=p2,\n485\t            base_power=2, base_toughness=2,\n486\t        )\n487\t        game.get_battlefield(p2).add(target)\n488\t\n489\t        # Resolve the prepare spell effect.\n490\t        card.resolve_prepare_spell(game, target)\n491\t\n492\t        # The target should no longer be on the battlefield.\n493\t        bf_p2 = game.get_battlefield(p2).get_all()\n494\t        target_on_bf = [\n495\t            obj for obj in bf_p2\n496\t            if getattr(obj, \"name\", \"\") == \"Grizzly Bears\"\n497\t        ]\n498\t        assert len(target_on_bf) == 0, (\n499\t            \"Target creature should be exiled from the battlefield\"\n500\t        )\n501\t\n502\t    def test_prepare_spell_moves_target_to_exile_zone(self) -> None:\n503\t        \"\"\"The exiled creature should end up in its owner's exile zone.\"\"\"\n504\t        game = create_game()\n505\t        p1 = game.players[0]\n506\t        p2 = game.players[1]\n507\t\n508\t        card = self._make_prepared_emeritus(game, p1)\n509\t\n510\t        target = Creature(\n511\t            name=\"Grizzly Bears\", owner=p2, controller=p2,\n512\t            base_power=2, base_toughness=2,\n513\t        )\n514\t        game.get_battlefield(p2).add(target)\n515\t\n516\t        card.resolve_prepare_spell(game, target)\n517\t\n518\t        # The target should be in the exile zone.\n519\t        exile_p2 = game.get_exile(p2).get_all()\n520\t        exiled = [\n521\t            obj for obj in exile_p2\n522\t            if getattr(obj, \"name\", \"\") == \"Grizzly Bears\"\n523\t        ]\n524\t        assert len(exiled) >= 1, (\n525\t            \"Target creature should be in the exile zone\"\n526\t        )\n527\t\n528\t    def test_prepare_spell_controller_gains_life_equal_to_power(self) -> None:\n529\t        \"\"\"The exiled creature's controller gains life equal to its power.\"\"\"\n530\t        game = create_game()\n531\t        p1 = game.players[0]\n532\t        p2 = game.players[1]\n533\t\n534\t        card = self._make_prepared_emeritus(game, p1)\n535\t\n536\t        # Target creature has power 4.\n537\t        target = Creature(\n538\t            name=\"Hill Giant\", owner=p2, controller=p2,\n539\t            base_power=4, base_toughness=3,\n540\t        )\n541\t        game.get_battlefield(p2).add(target)\n542\t\n543\t        life_before = p2.life\n544\t        card.resolve_prepare_spell(game, target)\n545\t\n546\t        # p2 (the controller of the exiled creature) should gain 4 life.\n547\t        assert p2.life == life_before + 4, (\n548\t            f\"Controller should gain life equal to creature's power (4), \"\n549\t            f\"but life went from {life_before} to {p2.life}\"\n550\t        )\n551\t\n552\t    def test_prepare_spell_zero_power_creature_no_life_gain(self) -> None:\n553\t        \"\"\"Exiling a 0-power creature grants 0 life (no change).\"\"\"\n554\t        game = create_game()\n555\t        p1 = game.players[0]\n556\t        p2 = game.players[1]\n557\t\n558\t        card = self._make_prepared_emeritus(game, p1)\n559\t\n560\t        target = Creature(\n561\t            name=\"Wall of Air\", owner=p2, controller=p2,\n562\t            base_power=0, base_toughness=5,\n563\t        )\n564\t        game.get_battlefield(p2).add(target)\n565\t\n566\t        life_before = p2.life\n567\t        card.resolve_prepare_spell(game, target)\n568\t\n569\t        assert p2.life == life_before, (\n570\t            \"Zero-power creature should grant zero life\"\n571\t        )\n572\t\n573\t    def test_prepare_spell_unprepares_after_casting(self) -> None:\n574\t        \"\"\"After casting the prepare spell, the creature should become\n575\t        unprepared (is_prepared = False).\"\"\"\n576\t        game = create_game()\n577\t        p1 = game.players[0]\n578\t        p2 = game.players[1]\n579\t\n580\t        card = self._make_prepared_emeritus(game, p1)\n581\t        assert card.is_prepared is True\n582\t\n583\t        target = Creature(\n584\t            name=\"Grizzly Bears\", owner=p2, controller=p2,\n585\t            base_power=2, base_toughness=2,\n586\t        )\n587\t        game.get_battlefield(p2).add(target)\n588\t\n589\t        card.resolve_prepare_spell(game, target)\n590\t\n591\t        assert card.is_prepared is False, (\n592\t            \"Creature should be unprepared after casting the prepare spell\"\n593\t        )\n594\t\n595\t    def test_prepare_spell_can_target_own_creature(self) -> None:\n596\t        \"\"\"Swords to Plowshares can target any creature, including\n597\t        the controller's own creatures.\"\"\"\n598\t        game = create_game()\n599\t        p1 = game.players[0]\n600\t\n601\t        card = self._make_prepared_emeritus(game, p1)\n602\t\n603\t        # Target the controller's own creature.\n604\t        own_creature = Creature(\n605\t            name=\"Savannah Lions\", owner=p1, controller=p1,\n606\t            base_power=2, base_toughness=1,\n607\t        )\n608\t        game.get_battlefield(p1).add(own_creature)\n609\t\n610\t        life_before = p1.life\n611\t        card.resolve_prepare_spell(game, own_creature)\n612\t\n613\t        # Own creature should be exiled.\n614\t        bf_p1 = game.get_battlefield(p1).get_all()\n615\t        lions_on_bf = [\n616\t            obj for obj in bf_p1\n617\t            if getattr(obj, \"name\", \"\") == \"Savannah Lions\"\n618\t        ]\n619\t        assert len(lions_on_bf) == 0, (\n620\t            \"Own creature should be exiled from the battlefield\"\n621\t        )\n622\t\n623\t        # Controller (p1) gains life equal to the creature's power (2).\n624\t        assert p1.life == life_before + 2, (\n625\t            f\"Controller of exiled creature gains life equal to its power, \"\n626\t            f\"expected {life_before + 2}, got {p1.life}\"\n627\t        )\n628\t"}]},"parent_tool_use_id":"toolu_01G5PjHgHnPkrLeY7jb5LTQd","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f","uuid":"928f977d-264d-44d0-9b6e-0be714aee668","timestamp":"2026-05-28T11:17:05.338Z","subagent_type":"Implementer","task_description":"Implement sos_13 prepare spell"}
