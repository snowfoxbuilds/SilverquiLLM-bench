{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_018fB4omWD3EjF3VvHaLNXfr","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01TbU8zmvk9Qj2H21et96BQ6","name":"Read","input":{"file_path":"/workspace/engine/casting.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":5451,"cache_read_input_tokens":22679,"cache_creation":{"ephemeral_5m_input_tokens":5451,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01TAUth1vzYjstFkMSuV9Fdg","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f","uuid":"5f3a8280-e12d-4b4f-8a00-6901b93cbfa1","request_id":"req_011CbUsv67E6tnqtV3jSgDJK","subagent_type":"Tester","task_description":"Write tests for sos_57"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TbU8zmvk9Qj2H21et96BQ6","type":"tool_result","content":"1\t\"\"\"Casting and resolution pipeline for spells and lands.\n2\t\n3\tProvides the full flow from casting a spell or playing a land through\n4\tresolution:\n5\t\n6\t- :func:`cast_spell` — verify timing & legality → move hand to stack →\n7\t  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n8\t- :func:`play_land` — verify land play remaining → move hand to\n9\t  battlefield → decrement ``land_plays_remaining``.\n10\t- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n11\t  helpers used by the casting pipeline.\n12\t\n13\tResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\n14\tcreated by :func:`cast_spell`:\n15\t\n16\t- Call ``card.on_resolve(game)``.\n17\t- Permanents (creature / enchantment / artifact / planeswalker) move from\n18\t  the stack to the battlefield.\n19\t- Non-permanents (instant / sorcery) move to the graveyard.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import TYPE_CHECKING, Any\n25\t\n26\tfrom engine.card import CardImpl\n27\tfrom engine.stack import StackObject\n28\tfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\n29\tfrom engine.zones import move_zone\n30\t\n31\tif TYPE_CHECKING:\n32\t    from engine.game_state import GameState\n33\t    from engine.player import Player\n34\t\n35\t\n36\t# Card types that represent permanents — these go to the battlefield on resolve.\n37\t_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n38\t    CardType.CREATURE,\n39\t    CardType.ENCHANTMENT,\n40\t    CardType.ARTIFACT,\n41\t    CardType.PLANESWALKER,\n42\t})\n43\t\n44\t\n45\tclass CastingError(Exception):\n46\t    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n47\t\n48\t\n49\t# ------------------------------------------------------------------\n50\t# Timing helpers\n51\t# ------------------------------------------------------------------\n52\t\n53\tdef is_sorcery_speed(game: GameState, player: Player) -> bool:\n54\t    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n55\t\n56\t    Sorcery speed requires all of:\n57\t\n58\t    * *player* is the active player.\n59\t    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n60\t      ``POSTCOMBAT_MAIN``).\n61\t    * The stack is empty.\n62\t    \"\"\"\n63\t    if player is not game.active_player:\n64\t        return False\n65\t    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n66\t        return False\n67\t    if not game.stack.is_empty():\n68\t        return False\n69\t    return True\n70\t\n71\t\n72\tdef can_cast_at_instant_speed(card: CardImpl) -> bool:\n73\t    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n74\t\n75\t    A card has instant-speed timing if it is an instant or has the\n76\t    :attr:`~engine.types.Keyword.FLASH` keyword.\n77\t    \"\"\"\n78\t    if CardType.INSTANT in card.card_types:\n79\t        return True\n80\t    if Keyword.FLASH & card.keywords:\n81\t        return True\n82\t    return False\n83\t\n84\t\n85\t# ------------------------------------------------------------------\n86\t# Cost reduction\n87\t# ------------------------------------------------------------------\n88\t\n89\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n90\t    \"\"\"Return the generic mana reduction for casting *card*.\n91\t\n92\t    Queries ``card.cost_reduction(game)`` and clamps the result so that\n93\t    the generic portion of the mana cost cannot go below 0.\n94\t\n95\t    This is a simplified single-card self-reduction model.  Full MTG\n96\t    cost-reduction interactions (Trinisphere, multiple reductions from\n97\t    different sources) are deferred.\n98\t    \"\"\"\n99\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n100\t    # casting player even when the card was never explicitly assigned one.\n101\t    prev_controller = card.controller\n102\t    card.controller = controller\n103\t    raw = card.cost_reduction(game)\n104\t    # Restore previous controller in case the caller doesn't want a\n105\t    # side-effect (get_cost_reduction is a query, not a mutation).\n106\t    card.controller = prev_controller\n107\t    generic = card.mana_cost.generic if card.mana_cost else 0\n108\t    return max(0, min(raw, generic))\n109\t\n110\t\n111\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n112\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n113\t    new_generic = max(0, cost.generic - reduction)\n114\t    return ManaCost(\n115\t        generic=new_generic,\n116\t        pips=dict(cost.pips),\n117\t        x_count=cost.x_count,\n118\t        hybrid=list(cost.hybrid),\n119\t    )\n120\t\n121\t\n122\t# ------------------------------------------------------------------\n123\t# Cast spell\n124\t# ------------------------------------------------------------------\n125\t\n126\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n127\t    \"\"\"Cast *card* from *player*'s hand.\n128\t\n129\t    Pipeline\n130\t    --------\n131\t    1. **Timing check** — instants (and cards with flash) can be cast\n132\t       whenever the player has priority; everything else requires\n133\t       sorcery-speed timing.\n134\t    2. **can_cast** — ask the card whether it can legally be cast.\n135\t    3. **Hand check** — the card must be in the player's hand.\n136\t    4. **Move hand → stack zone** — remove the card from the hand and\n137\t       place it into the player's stack zone.\n138\t    5. **Choose targets** — if the card specifies targets (via\n139\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n140\t    6. **Mana check / payment** — the player's mana pool must be able to\n141\t       pay the card's mana cost.  If payment fails, the card is rolled\n142\t       back from the stack zone to the hand.\n143\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n144\t    8. **Push StackObject** — push a :class:`StackObject` whose\n145\t       ``on_resolve`` callback handles resolution.\n146\t\n147\t    Raises:\n148\t        CastingError: If any legality check fails.\n149\t    \"\"\"\n150\t    # 1. Timing\n151\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n152\t        raise CastingError(\n153\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n154\t        )\n155\t\n156\t    # 2. can_cast\n157\t    if not card.can_cast(game):\n158\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n159\t\n160\t    # 3. Hand check\n161\t    hand = game.get_hand(player)\n162\t    if not hand.contains(card):\n163\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n164\t\n165\t    # 4. Move card from hand to stack zone\n166\t    stack_zone = player.zones[Zone.STACK]\n167\t    hand.remove(card)\n168\t    stack_zone.add(card)\n169\t\n170\t    # Clear any stale colors_spent from a prior cast before new payment.\n171\t    if hasattr(card, \"colors_spent\"):\n172\t        del card.colors_spent\n173\t\n174\t    # 5. Choose targets\n175\t    target_specs = card.get_targets(game)\n176\t    chosen_targets: list[Any] = []\n177\t    if target_specs:\n178\t        for spec in target_specs:\n179\t            target = player.choose_target(target_specs, spec)\n180\t            # Validate against filter_fn if the spec provides one\n181\t            filter_fn = getattr(spec, \"filter_fn\", None)\n182\t            if filter_fn is not None and target is not None:\n183\t                if not filter_fn(target):\n184\t                    stack_zone.remove(card)\n185\t                    hand.add(card)\n186\t                    raise CastingError(\n187\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n188\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n189\t                    )\n190\t            chosen_targets.append(target)\n191\t\n192\t    # 5b. Protection check — reject targets that have protection from this\n193\t    #     spell (the T in DEBT).\n194\t    from engine.protection import has_protection_from\n195\t\n196\t    for target in chosen_targets:\n197\t        if has_protection_from(target, card):\n198\t            # Rollback: move card from stack zone back to hand\n199\t            stack_zone.remove(card)\n200\t            hand.add(card)\n201\t            raise CastingError(\n202\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n203\t            )\n204\t\n205\t    # Targets are stored on the StackObject (not the card) and passed\n206\t    # through the resolve pipeline via on_resolve(game, targets=...).\n207\t\n208\t    # 6. Mana check / payment (rollback on failure)\n209\t    # Ensure the card knows its controller so that cost_reduction() hooks\n210\t    # (e.g. Embercleave counting attacking creatures you control) see the\n211\t    # casting player, even for cards that were added to hand without an\n212\t    # explicit controller assignment.\n213\t    if card.controller is None:\n214\t        card.controller = player\n215\t    reduction = get_cost_reduction(game, card, player)\n216\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n217\t\n218\t    if not player.mana_pool.can_pay(effective_cost):\n219\t        # Rollback: move card from stack zone back to hand\n220\t        stack_zone.remove(card)\n221\t        hand.add(card)\n222\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n223\t\n224\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n225\t    player.mana_pool.pay(effective_cost)\n226\t\n227\t    # Store colors of mana spent on the card for mechanics like Converge\n228\t    # that care about the colors used to cast the spell.\n229\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n230\t\n231\t    # 7. Call on_cast hook\n232\t    card.on_cast(game)\n233\t\n234\t    # 8. Build on_resolve callback and push StackObject\n235\t    stack_obj = StackObject(\n236\t        source=card,\n237\t        controller=player,\n238\t        targets=chosen_targets,\n239\t        on_resolve=lambda g: None,  # replaced below\n240\t    )\n241\t\n242\t    def _on_resolve(g: GameState) -> None:\n243\t        _resolve_spell(g, card, player, stack_obj)\n244\t\n245\t    stack_obj.on_resolve = _on_resolve\n246\t    game.stack.push(stack_obj)\n247\t\n248\t\n249\t# ------------------------------------------------------------------\n250\t# Cast spell without paying mana cost (free-cast from any zone)\n251\t# ------------------------------------------------------------------\n252\t\n253\t\n254\tdef cast_spell_free(\n255\t    game: GameState,\n256\t    player: Player,\n257\t    card: CardImpl,\n258\t    from_zone: Zone,\n259\t) -> None:\n260\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n261\t\n262\t    This is used by effects that allow casting from zones other than hand\n263\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n264\t    or cascade.\n265\t\n266\t    Pipeline\n267\t    --------\n268\t    1. **can_cast** — ask the card whether it can legally be cast (same\n269\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n270\t    2. Move *card* from *from_zone* to the stack zone.\n271\t    3. Choose targets (if applicable) with validation and protection check.\n272\t    4. Call ``on_cast`` hook.\n273\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n274\t       resolution normally (permanents → battlefield, non-permanents →\n275\t       graveyard).\n276\t\n277\t    No timing check or mana payment is performed.  The spell goes on the\n278\t    stack and can be responded to normally (e.g. countered).\n279\t\n280\t    If targeting or other post-move checks fail, the card is rolled back\n281\t    to its source zone.\n282\t\n283\t    Parameters:\n284\t        game: The current game state.\n285\t        player: The player casting the spell.\n286\t        card: The card to cast.\n287\t        from_zone: The zone the card is currently in.\n288\t\n289\t    Raises:\n290\t        CastingError: If the card cannot be found in *from_zone* or\n291\t            legality checks fail.\n292\t    \"\"\"\n293\t    from engine.zones import move_to_zone\n294\t\n295\t    # Ensure controller is set\n296\t    card.controller = player\n297\t    if card.owner is None:\n298\t        card.owner = player\n299\t\n300\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n301\t    if not card.can_cast(game):\n302\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n303\t\n304\t    # 2. Locate card in source zone\n305\t    source_zone_container = player.zones[from_zone]\n306\t    if not source_zone_container.contains(card):\n307\t        # Try to find the card in any player's zone\n308\t        source_zone_container = None\n309\t        for p in game.players:\n310\t            z = p.zones[from_zone]\n311\t            if z.contains(card):\n312\t                source_zone_container = z\n313\t                break\n314\t\n315\t    if source_zone_container is None or not source_zone_container.contains(card):\n316\t        raise CastingError(\n317\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n318\t        )\n319\t\n320\t    # Move card from source zone to stack zone\n321\t    stack_zone = player.zones[Zone.STACK]\n322\t    source_zone_container.remove(card)\n323\t    stack_zone.add(card)\n324\t\n325\t    # 3. Choose targets (with rollback on failure)\n326\t    try:\n327\t        target_specs = card.get_targets(game)\n328\t        chosen_targets: list[Any] = []\n329\t        if target_specs:\n330\t            for spec in target_specs:\n331\t                target = player.choose_target(target_specs, spec)\n332\t                # Validate against filter_fn if the spec provides one\n333\t                filter_fn = getattr(spec, \"filter_fn\", None)\n334\t                if filter_fn is not None and target is not None:\n335\t                    if not filter_fn(target):\n336\t                        raise CastingError(\n337\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n338\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n339\t                        )\n340\t                chosen_targets.append(target)\n341\t\n342\t        # Protection check — reject targets that have protection from this spell\n343\t        from engine.protection import has_protection_from\n344\t\n345\t        for target in chosen_targets:\n346\t            if has_protection_from(target, card):\n347\t                raise CastingError(\n348\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n349\t                )\n350\t    except Exception as exc:\n351\t        # Rollback: move card from stack zone back to source zone\n352\t        stack_zone.remove(card)\n353\t        source_zone_container.add(card)\n354\t        raise CastingError(str(exc)) from exc\n355\t\n356\t    # 4. Call on_cast hook\n357\t    card.on_cast(game)\n358\t\n359\t    # 5. Build on_resolve callback and push StackObject\n360\t    stack_obj = StackObject(\n361\t        source=card,\n362\t        controller=player,\n363\t        targets=chosen_targets,\n364\t        on_resolve=lambda g: None,  # replaced below\n365\t    )\n366\t\n367\t    def _on_resolve(g: GameState) -> None:\n368\t        _resolve_spell(g, card, player, stack_obj)\n369\t\n370\t    stack_obj.on_resolve = _on_resolve\n371\t    game.stack.push(stack_obj)\n372\t\n373\t\n374\t# ------------------------------------------------------------------\n375\t# Resolution (called when the stack pops)\n376\t# ------------------------------------------------------------------\n377\t\n378\tdef _resolve_spell(\n379\t    game: GameState,\n380\t    card: CardImpl,\n381\t    player: Player,\n382\t    stack_obj: StackObject,\n383\t) -> None:\n384\t    \"\"\"Resolve *card* cast by *player*.\n385\t\n386\t    1. Call ``card.on_resolve(game, targets=targets)``.\n387\t    2. Remove the card from the stack zone.\n388\t    3. If the card is a permanent type, move it to the battlefield via\n389\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n390\t       registration and the ETB event).\n391\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n392\t    \"\"\"\n393\t    from engine.zones import move_to_zone\n394\t\n395\t    # Read targets from the StackObject — the single source of truth.\n396\t    # Set chosen_targets on the card just before resolution so that\n397\t    # _get_chosen_target helpers (which read via getattr) work.\n398\t    targets = stack_obj.targets\n399\t    if targets is not None:\n400\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n401\t\n402\t    card.on_resolve(game)\n403\t\n404\t    if card.card_types & _PERMANENT_TYPES:\n405\t        # Move from stack to battlefield via move_to_zone, which handles\n406\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n407\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n408\t    else:\n409\t        # Check for exile-instead replacement (e.g. The Dawning Archaic:\n410\t        # \"If that spell would be put into your graveyard, exile it instead.\")\n411\t        exile_instead = getattr(card, \"_dawning_archaic_exile\", False)\n412\t        if exile_instead:\n413\t            # Clean up the flag before moving\n414\t            del card._dawning_archaic_exile\n415\t            move_to_zone(game, card, Zone.STACK, Zone.EXILE)\n416\t        else:\n417\t            # Instant/sorcery: move from stack to graveyard via move_to_zone.\n418\t            move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n419\t\n420\t\n421\t# ------------------------------------------------------------------\n422\t# Play land (special action — does not use the stack)\n423\t# ------------------------------------------------------------------\n424\t\n425\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n426\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n427\t\n428\t    Requirements (all must hold):\n429\t\n430\t    * *land_card* has :attr:`CardType.LAND`.\n431\t    * *player* is the active player.\n432\t    * Current phase is a main phase.\n433\t    * The stack is empty.\n434\t    * ``player.land_plays_remaining > 0``.\n435\t    * The card is in the player's hand.\n436\t\n437\t    On success the card moves from hand to battlefield and\n438\t    ``land_plays_remaining`` is decremented.\n439\t\n440\t    Raises:\n441\t        CastingError: If any requirement is not met.\n442\t    \"\"\"\n443\t    # Must be a land\n444\t    if CardType.LAND not in land_card.card_types:\n445\t        raise CastingError(\n446\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n447\t        )\n448\t\n449\t    # Sorcery-speed timing (active player, main phase, stack empty)\n450\t    if not is_sorcery_speed(game, player):\n451\t        raise CastingError(\n452\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n453\t            \"during main phase with empty stack\"\n454\t        )\n455\t\n456\t    # Land plays remaining\n457\t    if player.land_plays_remaining <= 0:\n458\t        raise CastingError(\n459\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n460\t        )\n461\t\n462\t    # Card must be in hand\n463\t    hand = game.get_hand(player)\n464\t    if not hand.contains(land_card):\n465\t        raise CastingError(\n466\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n467\t        )\n468\t\n469\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n470\t    if land_card.owner is None:\n471\t        land_card.owner = player\n472\t    land_card.controller = player\n473\t\n474\t    # Move from hand to battlefield via move_to_zone, which fires\n475\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n476\t    from engine.zones import move_to_zone\n477\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n478\t\n479\t    # Decrement land plays\n480\t    player.land_plays_remaining -= 1\n481\t\n482\t\n483\tdef resolve_top(game: GameState) -> None:\n484\t    \"\"\"Resolve the top spell/ability on the stack.\n485\t\n486\t    Pops the top item from the stack, calls its on_resolve callback,\n487\t    then runs state-based actions.  If the stack is empty this is a no-op.\n488\t    \"\"\"\n489\t    if game.stack.is_empty():\n490\t        return\n491\t    from engine.state_based_actions import resolve_state_based_actions\n492\t\n493\t    obj = game.stack.pop()\n494\t    obj.on_resolve(game)\n495\t    resolve_state_based_actions(game)\n496\t"}]},"parent_tool_use_id":"toolu_01TAUth1vzYjstFkMSuV9Fdg","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f","uuid":"79f78692-6b84-407b-aa76-61e97d1db3d0","timestamp":"2026-05-28T11:21:22.112Z","subagent_type":"Tester","task_description":"Write tests for sos_57"}
{"type":"system","subtype":"task_progress","task_id":"a0afd6e5c064ebe51","tool_use_id":"toolu_01TAUth1vzYjstFkMSuV9Fdg","description":"Reading engine/mana.py","subagent_type":"Tester","usage":{"total_tokens":28210,"tool_uses":15,"duration_ms":20714},"last_tool_name":"Read","uuid":"fb9b224e-5e3b-433b-8f92-c3da54428be9","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f"}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_018fB4omWD3EjF3VvHaLNXfr","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MnBZBNRLcHZZFzRKaaxRbJ","name":"Read","input":{"file_path":"/workspace/engine/mana.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":5451,"cache_read_input_tokens":22679,"cache_creation":{"ephemeral_5m_input_tokens":5451,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01TAUth1vzYjstFkMSuV9Fdg","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f","uuid":"3782d4ad-0824-4958-8374-d4d58c937547","request_id":"req_011CbUsv67E6tnqtV3jSgDJK","subagent_type":"Tester","task_description":"Write tests for sos_57"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MnBZBNRLcHZZFzRKaaxRbJ","type":"tool_result","content":"1\t\"\"\"Mana pool and cost payment logic.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom engine.types import Color, HybridManaSymbol, ManaCost, ManaType\n6\t\n7\t# Map colored ManaTypes to their corresponding Color enum values.\n8\t_MANA_TO_COLOR: dict[ManaType, Color] = {\n9\t    ManaType.WHITE: Color.WHITE,\n10\t    ManaType.BLUE: Color.BLUE,\n11\t    ManaType.BLACK: Color.BLACK,\n12\t    ManaType.RED: Color.RED,\n13\t    ManaType.GREEN: Color.GREEN,\n14\t}\n15\t\n16\t\n17\tclass ManaPool:\n18\t    \"\"\"Tracks available mana for a player.\n19\t\n20\t    Internal storage uses a ``dict[ManaType, int]`` mapping each mana type\n21\t    to its current count.\n22\t    \"\"\"\n23\t\n24\t    def __init__(self) -> None:\n25\t        self._pool: dict[ManaType, int] = {mt: 0 for mt in ManaType}\n26\t        self._last_payment_colors: list[Color] = []\n27\t\n28\t    # ------------------------------------------------------------------\n29\t    # Basic operations\n30\t    # ------------------------------------------------------------------\n31\t\n32\t    def add(self, mana_type: ManaType, amount: int = 1) -> None:\n33\t        \"\"\"Add *amount* mana of the given type to the pool.\n34\t\n35\t        Parameters:\n36\t            mana_type: The type of mana to add.\n37\t            amount: How many mana to add (must be non-negative).\n38\t        \"\"\"\n39\t        if amount < 0:\n40\t            raise ValueError(f\"Cannot add negative mana: {amount}\")\n41\t        self._pool[mana_type] = self._pool.get(mana_type, 0) + amount\n42\t\n43\t    def empty(self) -> None:\n44\t        \"\"\"Clear the pool — happens at phase/step transitions.\"\"\"\n45\t        for mt in self._pool:\n46\t            self._pool[mt] = 0\n47\t\n48\t    def total(self) -> int:\n49\t        \"\"\"Return the total amount of mana in the pool across all types.\"\"\"\n50\t        return sum(self._pool.values())\n51\t\n52\t    def get(self, mana_type: ManaType) -> int:\n53\t        \"\"\"Return the amount of a specific mana type in the pool.\"\"\"\n54\t        return self._pool.get(mana_type, 0)\n55\t\n56\t    @property\n57\t    def last_payment_colors(self) -> list[Color]:\n58\t        \"\"\"Return the distinct colors of mana spent in the last :meth:`pay` call.\n59\t\n60\t        Colorless mana is not a color and is excluded.  The list is sorted\n61\t        by Color enum order for determinism.  Empty if no payment has been\n62\t        made or if all mana spent was colorless.\n63\t        \"\"\"\n64\t        return list(self._last_payment_colors)\n65\t\n66\t    # ------------------------------------------------------------------\n67\t    # Cost payment\n68\t    # ------------------------------------------------------------------\n69\t\n70\t    def can_pay(self, cost: ManaCost) -> bool:\n71\t        \"\"\"Check whether the pool can satisfy *cost*.\n72\t\n73\t        Generic mana can be paid by any type.  X is treated as 0 for\n74\t        ``can_pay`` unless explicitly set in the cost's generic component.\n75\t        Hybrid symbols can be paid with either option; this method uses\n76\t        backtracking to find a valid assignment.\n77\t\n78\t        Returns:\n79\t            True if the pool has enough mana to pay the cost.\n80\t        \"\"\"\n81\t        remaining: dict[ManaType, int] = dict(self._pool)\n82\t\n83\t        # Pay colored/colorless pips first.\n84\t        for mana_type, count in cost.pips.items():\n85\t            if remaining.get(mana_type, 0) < count:\n86\t                return False\n87\t            remaining[mana_type] = remaining.get(mana_type, 0) - count\n88\t\n89\t        # Solve hybrid symbols with backtracking.\n90\t        if cost.hybrid:\n91\t            if not self._can_pay_hybrid(remaining, list(cost.hybrid), 0, cost.generic):\n92\t                return False\n93\t            return True\n94\t\n95\t        # Then check generic — sum of all remaining mana must cover it.\n96\t        return sum(remaining.values()) >= cost.generic\n97\t\n98\t    def pay(self, cost: ManaCost, choices: dict[ManaType, int] | None = None) -> bool:\n99\t        \"\"\"Deduct mana from the pool to pay *cost*.\n100\t\n101\t        Parameters:\n102\t            cost: The mana cost to pay.\n103\t            choices: How to split the generic portion across mana types.\n104\t                If ``None``, auto-pay greedily: pay colored pips first,\n105\t                then hybrid symbols, then generic using colorless first,\n106\t                then excess colored.\n107\t\n108\t        Returns:\n109\t            True if payment succeeded, False if the pool has insufficient mana.\n110\t        \"\"\"\n111\t        if not self.can_pay(cost):\n112\t            return False\n113\t\n114\t        # Work on a copy so we can roll back on failure.\n115\t        working: dict[ManaType, int] = dict(self._pool)\n116\t\n117\t        # 1. Pay colored/colorless pips.\n118\t        for mana_type, count in cost.pips.items():\n119\t            working[mana_type] -= count\n120\t\n121\t        # 2. When explicit generic choices are provided, reserve that mana\n122\t        #    *before* solving hybrids so the solver doesn't steal it.\n123\t        generic_remaining = cost.generic\n124\t        if generic_remaining > 0 and choices is not None:\n125\t            # Reject negative choice amounts — they would create mana.\n126\t            if any(v < 0 for v in choices.values()):\n127\t                return False\n128\t            # Validate choices sum to generic cost.\n129\t            if sum(choices.values()) != generic_remaining:\n130\t                return False\n131\t            for mana_type, amount in choices.items():\n132\t                if working.get(mana_type, 0) < amount:\n133\t                    return False\n134\t                working[mana_type] -= amount\n135\t\n136\t        # 3. Pay hybrid symbols using backtracking to find a valid assignment.\n137\t        #    Generic choices (if any) have already been reserved above,\n138\t        #    so _solve_hybrid sees only the genuinely available mana.\n139\t        if cost.hybrid:\n140\t            generic_for_solver = generic_remaining if choices is None else 0\n141\t            hybrid_assignment = self._solve_hybrid(\n142\t                working, list(cost.hybrid), 0, generic_for_solver,\n143\t            )\n144\t            if hybrid_assignment is None:\n145\t                return False  # pragma: no cover – should not happen after can_pay\n146\t            for mt in hybrid_assignment:\n147\t                working[mt] = working.get(mt, 0) - 1\n148\t\n149\t        # 4. Pay generic cost (auto-pay path — choices already deducted above).\n150\t        if generic_remaining > 0 and choices is None:\n151\t            generic_remaining = self._auto_pay_generic(working, generic_remaining)\n152\t            if generic_remaining > 0:\n153\t                return False  # pragma: no cover – should not happen after can_pay\n154\t\n155\t        # Commit the payment.\n156\t        # Compute colors of mana spent by comparing old pool to new working pool.\n157\t        colors_spent: set[Color] = set()\n158\t        for mt, old_amount in self._pool.items():\n159\t            new_amount = working.get(mt, 0)\n160\t            if new_amount < old_amount and mt in _MANA_TO_COLOR:\n161\t                colors_spent.add(_MANA_TO_COLOR[mt])\n162\t        self._last_payment_colors = sorted(colors_spent, key=lambda c: c.value)\n163\t        self._pool = working\n164\t        return True\n165\t\n166\t    @staticmethod\n167\t    def _can_pay_hybrid(\n168\t        remaining: dict[ManaType, int],\n169\t        hybrids: list[HybridManaSymbol],\n170\t        idx: int,\n171\t        generic: int,\n172\t    ) -> bool:\n173\t        \"\"\"Recursively check if hybrid symbols + generic can be satisfied.\n174\t\n175\t        Uses backtracking: for each hybrid symbol, try option_a then option_b.\n176\t        After all hybrids are assigned, check that remaining mana covers generic.\n177\t        \"\"\"\n178\t        if idx >= len(hybrids):\n179\t            return sum(remaining.values()) >= generic\n180\t\n181\t        sym = hybrids[idx]\n182\t        for option in (sym.option_a, sym.option_b):\n183\t            if remaining.get(option, 0) > 0:\n184\t                remaining[option] -= 1\n185\t                if ManaPool._can_pay_hybrid(remaining, hybrids, idx + 1, generic):\n186\t                    remaining[option] += 1\n187\t                    return True\n188\t                remaining[option] += 1\n189\t        return False\n190\t\n191\t    @staticmethod\n192\t    def _solve_hybrid(\n193\t        remaining: dict[ManaType, int],\n194\t        hybrids: list[HybridManaSymbol],\n195\t        idx: int,\n196\t        generic: int,\n197\t    ) -> list[ManaType] | None:\n198\t        \"\"\"Find a valid assignment for hybrid symbols.\n199\t\n200\t        Returns a list of ManaType choices (one per hybrid symbol) or None\n201\t        if no valid assignment exists.\n202\t        \"\"\"\n203\t        if idx >= len(hybrids):\n204\t            if sum(remaining.values()) >= generic:\n205\t                return []\n206\t            return None\n207\t\n208\t        sym = hybrids[idx]\n209\t        for option in (sym.option_a, sym.option_b):\n210\t            if remaining.get(option, 0) > 0:\n211\t                remaining[option] -= 1\n212\t                result = ManaPool._solve_hybrid(remaining, hybrids, idx + 1, generic)\n213\t                if result is not None:\n214\t                    remaining[option] += 1\n215\t                    return [option] + result\n216\t                remaining[option] += 1\n217\t        return None\n218\t\n219\t    @staticmethod\n220\t    def _auto_pay_generic(working: dict[ManaType, int], amount: int) -> int:\n221\t        \"\"\"Deduct *amount* generic mana from *working*, preferring colorless.\n222\t\n223\t        Returns the remaining unpaid generic amount (0 on success).\n224\t        \"\"\"\n225\t        # Pay with colorless first.\n226\t        if working.get(ManaType.COLORLESS, 0) > 0:\n227\t            take = min(working[ManaType.COLORLESS], amount)\n228\t            working[ManaType.COLORLESS] -= take\n229\t            amount -= take\n230\t\n231\t        # Then pay with each colored type in enum order.\n232\t        for mt in ManaType:\n233\t            if mt is ManaType.COLORLESS:\n234\t                continue\n235\t            if amount <= 0:\n236\t                break\n237\t            if working.get(mt, 0) > 0:\n238\t                take = min(working[mt], amount)\n239\t                working[mt] -= take\n240\t                amount -= take\n241\t\n242\t        return amount\n243\t\n244\t    # ------------------------------------------------------------------\n245\t    # Dunder helpers\n246\t    # ------------------------------------------------------------------\n247\t\n248\t    def __repr__(self) -> str:\n249\t        non_zero = {mt.name: v for mt, v in self._pool.items() if v > 0}\n250\t        return f\"ManaPool({non_zero})\"\n251\t"}]},"parent_tool_use_id":"toolu_01TAUth1vzYjstFkMSuV9Fdg","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f","uuid":"6072029a-0a87-43b8-b56f-eb0f9e5ae67c","timestamp":"2026-05-28T11:21:22.273Z","subagent_type":"Tester","task_description":"Write tests for sos_57"}
