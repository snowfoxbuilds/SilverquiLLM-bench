{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FGJT4qsW7rhYbb88Agezwp","type":"tool_result","content":"1\t\"\"\"Card implementation for Emeritus of Truce // Swords to Plowshares.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.events import EntersBattlefieldTriggeredEvent\n9\tfrom engine.types import CardType, Keyword, ManaCost, TargetRequirement, Zone\n10\t\n11\tif TYPE_CHECKING:\n12\t    from engine.game_state import GameState\n13\t\n14\t\n15\tclass EmeritusOfTruceSwordsToPlowshares(Creature):\n16\t    \"\"\"Emeritus of Truce // Swords to Plowshares — {1}{W}{W} — 3/3.\n17\t\n18\t    Creature — Cat Cleric\n19\t\n20\t    When this creature enters, target player creates a 1/1 white and\n21\t    black Inkling creature token with flying. Then if an opponent controls\n22\t    more creatures than you, this creature becomes prepared.\n23\t\n24\t    Prepare spell: Swords to Plowshares — {W} — Instant\n25\t    Exile target creature. Its controller gains life equal to its power.\n26\t\n27\t    SOS collector number 13.\n28\t    \"\"\"\n29\t\n30\t    def __init__(self, **kwargs: Any) -> None:\n31\t        kwargs.setdefault(\"name\", \"Emeritus of Truce // Swords to Plowshares\")\n32\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{W}{W}\"))\n33\t        kwargs.setdefault(\"subtypes\", {\"Cat\", \"Cleric\"})\n34\t        kwargs.setdefault(\"base_power\", 3)\n35\t        kwargs.setdefault(\"base_toughness\", 3)\n36\t        kwargs.setdefault(\n37\t            \"rules_text\",\n38\t            \"When this creature enters, target player creates a 1/1 white \"\n39\t            \"and black Inkling creature token with flying. Then if an \"\n40\t            \"opponent controls more creatures than you, this creature \"\n41\t            \"becomes prepared.\",\n42\t        )\n43\t        super().__init__(**kwargs)\n44\t        self.is_prepared: bool = False\n45\t\n46\t    def get_targets(self, game: GameState) -> list[Any]:\n47\t        \"\"\"Target player for the ETB ability.\"\"\"\n48\t        return [\n49\t            TargetRequirement(\n50\t                filter_fn=lambda obj: hasattr(obj, \"life\"),\n51\t                description=\"target player\",\n52\t                zone=Zone.BATTLEFIELD,\n53\t            )\n54\t        ]\n55\t\n56\t    def on_resolve(self, game: GameState) -> None:\n57\t        \"\"\"Schedule the ETB effect on the stack for after the creature enters.\n58\t\n59\t        The engine fires the ETB event before registering the card's own\n60\t        triggers (by design, to avoid self-referencing), so self-ETB\n61\t        effects must be pushed onto the stack from on_resolve.  The\n62\t        stack object resolves after the creature has moved to the\n63\t        battlefield, so creature counts are correct for the prepared\n64\t        check.\n65\t        \"\"\"\n66\t        from engine.stack import StackObject\n67\t\n68\t        source = self\n69\t\n70\t        def _etb_callback(g: GameState) -> None:\n71\t            _do_etb_effect(g, source)\n72\t\n73\t        stack_obj = StackObject(\n74\t            source=self,\n75\t            controller=self.controller or self.owner,\n76\t            on_resolve=_etb_callback,\n77\t        )\n78\t        game.stack.push(stack_obj)\n79\t\n80\t    def resolve_prepare_spell(self, game: GameState, target: Any) -> None:\n81\t        \"\"\"Resolve the Swords to Plowshares prepare spell.\n82\t\n83\t        Exile target creature. Its controller gains life equal to its power.\n84\t        Then this creature becomes unprepared.\n85\t        \"\"\"\n86\t        from engine.zones import move_to_zone\n87\t\n88\t        # Record the creature's power and controller before moving.\n89\t        creature_power = getattr(target, \"base_power\", 0)\n90\t        creature_controller = getattr(target, \"controller\", None) or getattr(target, \"owner\", None)\n91\t\n92\t        # Exile the target creature (move from battlefield to exile).\n93\t        move_to_zone(game, target, Zone.BATTLEFIELD, Zone.EXILE)\n94\t\n95\t        # Its controller gains life equal to its power.\n96\t        if creature_controller is not None and creature_power > 0:\n97\t            creature_controller.life += creature_power\n98\t\n99\t        # Casting the prepare spell unprepares this creature.\n100\t        self.is_prepared = False\n101\t\n102\t    def register_triggers(self, game: GameState) -> None:\n103\t        \"\"\"Register the ETB trigger for Inkling token creation and prepared check.\n104\t\n105\t        This trigger fires when the creature re-enters the battlefield\n106\t        (e.g. after being flickered).  The initial ETB on cast is handled\n107\t        by on_resolve pushing a stack object.\n108\t        \"\"\"\n109\t        from engine.triggers import TriggerRegistration\n110\t\n111\t        source = self\n112\t        controller = getattr(self, \"controller\", None) or game.active_player\n113\t\n114\t        def _condition(game: Any, event: EntersBattlefieldTriggeredEvent) -> bool:\n115\t            \"\"\"Only fire when this creature itself enters the battlefield.\"\"\"\n116\t            return event.permanent is source\n117\t\n118\t        def _effect(game: GameState) -> None:\n119\t            _do_etb_effect(game, source)\n120\t\n121\t        game.trigger_manager.register(\n122\t            TriggerRegistration(\n123\t                event_type=EntersBattlefieldTriggeredEvent,\n124\t                condition=_condition,\n125\t                effect=_effect,\n126\t                source=self,\n127\t                controller=controller,\n128\t            )\n129\t        )\n130\t\n131\t\n132\tdef _do_etb_effect(game: Any, source: EmeritusOfTruceSwordsToPlowshares) -> None:\n133\t    \"\"\"Execute the ETB effect: create Inkling token, then check prepared.\n134\t\n135\t    Creates a 1/1 white+black Inkling creature token with flying for the\n136\t    target player, then sets is_prepared if an opponent controls more\n137\t    creatures than the controller.\n138\t    \"\"\"\n139\t    from engine.game import create_token\n140\t\n141\t    ctrl = getattr(source, \"controller\", None)\n142\t    if ctrl is None:\n143\t        return\n144\t\n145\t    # Determine the target player from chosen_targets.\n146\t    chosen = getattr(source, \"chosen_targets\", None)\n147\t    target_player = chosen[0] if chosen else ctrl\n148\t\n149\t    # Create a 1/1 white+black Inkling creature token with flying.\n150\t    inkling = Creature(\n151\t        name=\"Inkling\",\n152\t        base_power=1,\n153\t        base_toughness=1,\n154\t        subtypes={\"Inkling\"},\n155\t        keywords=Keyword.FLYING,\n156\t        owner=target_player,\n157\t        controller=target_player,\n158\t    )\n159\t    inkling.is_token = True\n160\t    create_token(game, target_player, inkling)\n161\t\n162\t    # Check prepared condition: if any opponent controls more creatures\n163\t    # than the controller.\n164\t    ctrl_creatures = _count_creatures(game, ctrl)\n165\t    for player in game.players:\n166\t        if player is ctrl:\n167\t            continue\n168\t        opp_creatures = _count_creatures(game, player)\n169\t        if opp_creatures > ctrl_creatures:\n170\t            source.is_prepared = True\n171\t            break\n172\t\n173\t\n174\tdef _count_creatures(game: Any, player: Any) -> int:\n175\t    \"\"\"Count the number of creatures on a player's battlefield.\"\"\"\n176\t    bf = game.get_battlefield(player)\n177\t    count = 0\n178\t    for obj in bf.get_all():\n179\t        card_types = getattr(obj, \"card_types\", set())\n180\t        if CardType.CREATURE in card_types:\n181\t            count += 1\n182\t    return count\n183\t"}]},"parent_tool_use_id":"toolu_015Hp8FW1YywKgAsGmTU27Am","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f","uuid":"d490171b-246d-4680-8278-c239815567ba","timestamp":"2026-05-28T11:18:53.038Z","subagent_type":"Reviewer","task_description":"Review sos_13 implementation"}
