{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XzBpNTK17WFfKnDVkSgTTs","type":"tool_result","content":"1\tdiff --git a/FILES_MODIFIED.json b/FILES_MODIFIED.json\n2\tindex 0d45b55..14866a9 100644\n3\t--- a/FILES_MODIFIED.json\n4\t+++ b/FILES_MODIFIED.json\n5\t@@ -19,6 +19,21 @@\n6\t         }\n7\t       ]\n8\t     },\n9\t+    {\n10\t+      \"card\": \"sos_13\",\n11\t+      \"tests\": [\n12\t+        {\n13\t+          \"path\": \"cards/sos/sos_13/tests.py\",\n14\t+          \"summary\": \"Tests for Emeritus of Truce: static properties, ETB trigger, Inkling token creation, prepared condition, targeting, cast integration, and Swords to Plowshares prepare spell effect (exile creature, life gain, unprepare)\"\n15\t+        }\n16\t+      ],\n17\t+      \"implementation\": [\n18\t+        {\n19\t+          \"path\": \"cards/sos/sos_13/card_impl.py\",\n20\t+          \"summary\": \"EmeritusOfTruceSwordsToPlowshares with ETB Inkling token, prepared designation, and resolve_prepare_spell for Swords to Plowshares exile + life gain effect\"\n21\t+        }\n22\t+      ]\n23\t+    },\n24\t     {\n25\t       \"card\": \"sos_4\",\n26\t       \"tests\": [\n27\tdiff --git a/cards/sos/sos_13/card_impl.py b/cards/sos/sos_13/card_impl.py\n28\tindex 765fb45..f2f2ab6 100644\n29\t--- a/cards/sos/sos_13/card_impl.py\n30\t+++ b/cards/sos/sos_13/card_impl.py\n31\t@@ -2,15 +2,181 @@\n32\t \n33\t from __future__ import annotations\n34\t \n35\t-from engine.card import CardImpl\n36\t+from typing import TYPE_CHECKING, Any\n37\t \n38\t-from typing import TYPE_CHECKING\n39\t+from engine.card import Creature\n40\t+from engine.events import EntersBattlefieldTriggeredEvent\n41\t+from engine.types import CardType, Keyword, ManaCost, TargetRequirement, Zone\n42\t \n43\t if TYPE_CHECKING:\n44\t     from engine.game_state import GameState\n45\t \n46\t \n47\t-class EmeritusOfTruceSwordsToPlowshares(CardImpl):\n48\t-    \"\"\"TODO: Implement Emeritus of Truce // Swords to Plowshares.\"\"\"\n49\t+class EmeritusOfTruceSwordsToPlowshares(Creature):\n50\t+    \"\"\"Emeritus of Truce // Swords to Plowshares — {1}{W}{W} — 3/3.\n51\t \n52\t-    pass\n53\t+    Creature — Cat Cleric\n54\t+\n55\t+    When this creature enters, target player creates a 1/1 white and\n56\t+    black Inkling creature token with flying. Then if an opponent controls\n57\t+    more creatures than you, this creature becomes prepared.\n58\t+\n59\t+    Prepare spell: Swords to Plowshares — {W} — Instant\n60\t+    Exile target creature. Its controller gains life equal to its power.\n61\t+\n62\t+    SOS collector number 13.\n63\t+    \"\"\"\n64\t+\n65\t+    def __init__(self, **kwargs: Any) -> None:\n66\t+        kwargs.setdefault(\"name\", \"Emeritus of Truce // Swords to Plowshares\")\n67\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{W}{W}\"))\n68\t+        kwargs.setdefault(\"subtypes\", {\"Cat\", \"Cleric\"})\n69\t+        kwargs.setdefault(\"base_power\", 3)\n70\t+        kwargs.setdefault(\"base_toughness\", 3)\n71\t+        kwargs.setdefault(\n72\t+            \"rules_text\",\n73\t+            \"When this creature enters, target player creates a 1/1 white \"\n74\t+            \"and black Inkling creature token with flying. Then if an \"\n75\t+            \"opponent controls more creatures than you, this creature \"\n76\t+            \"becomes prepared.\",\n77\t+        )\n78\t+        super().__init__(**kwargs)\n79\t+        self.is_prepared: bool = False\n80\t+\n81\t+    def get_targets(self, game: GameState) -> list[Any]:\n82\t+        \"\"\"Target player for the ETB ability.\"\"\"\n83\t+        return [\n84\t+            TargetRequirement(\n85\t+                filter_fn=lambda obj: hasattr(obj, \"life\"),\n86\t+                description=\"target player\",\n87\t+                zone=Zone.BATTLEFIELD,\n88\t+            )\n89\t+        ]\n90\t+\n91\t+    def on_resolve(self, game: GameState) -> None:\n92\t+        \"\"\"Schedule the ETB effect on the stack for after the creature enters.\n93\t+\n94\t+        The engine fires the ETB event before registering the card's own\n95\t+        triggers (by design, to avoid self-referencing), so self-ETB\n96\t+        effects must be pushed onto the stack from on_resolve.  The\n97\t+        stack object resolves after the creature has moved to the\n98\t+        battlefield, so creature counts are correct for the prepared\n99\t+        check.\n100\t+        \"\"\"\n101\t+        from engine.stack import StackObject\n102\t+\n103\t+        source = self\n104\t+\n105\t+        def _etb_callback(g: GameState) -> None:\n106\t+            _do_etb_effect(g, source)\n107\t+\n108\t+        stack_obj = StackObject(\n109\t+            source=self,\n110\t+            controller=self.controller or self.owner,\n111\t+            on_resolve=_etb_callback,\n112\t+        )\n113\t+        game.stack.push(stack_obj)\n114\t+\n115\t+    def resolve_prepare_spell(self, game: GameState, target: Any) -> None:\n116\t+        \"\"\"Resolve the Swords to Plowshares prepare spell.\n117\t+\n118\t+        Exile target creature. Its controller gains life equal to its power.\n119\t+        Then this creature becomes unprepared.\n120\t+        \"\"\"\n121\t+        from engine.zones import move_to_zone\n122\t+\n123\t+        # Record the creature's power and controller before moving.\n124\t+        creature_power = getattr(target, \"base_power\", 0)\n125\t+        creature_controller = getattr(target, \"controller\", None) or getattr(target, \"owner\", None)\n126\t+\n127\t+        # Exile the target creature (move from battlefield to exile).\n128\t+        move_to_zone(game, target, Zone.BATTLEFIELD, Zone.EXILE)\n129\t+\n130\t+        # Its controller gains life equal to its power.\n131\t+        if creature_controller is not None and creature_power > 0:\n132\t+            creature_controller.life += creature_power\n133\t+\n134\t+        # Casting the prepare spell unprepares this creature.\n135\t+        self.is_prepared = False\n136\t+\n137\t+    def register_triggers(self, game: GameState) -> None:\n138\t+        \"\"\"Register the ETB trigger for Inkling token creation and prepared check.\n139\t+\n140\t+        This trigger fires when the creature re-enters the battlefield\n141\t+        (e.g. after being flickered).  The initial ETB on cast is handled\n142\t+        by on_resolve pushing a stack object.\n143\t+        \"\"\"\n144\t+        from engine.triggers import TriggerRegistration\n145\t+\n146\t+        source = self\n147\t+        controller = getattr(self, \"controller\", None) or game.active_player\n148\t+\n149\t+        def _condition(game: Any, event: EntersBattlefieldTriggeredEvent) -> bool:\n150\t+            \"\"\"Only fire when this creature itself enters the battlefield.\"\"\"\n151\t+            return event.permanent is source\n152\t+\n153\t+        def _effect(game: GameState) -> None:\n154\t+            _do_etb_effect(game, source)\n155\t+\n156\t+        game.trigger_manager.register(\n157\t+            TriggerRegistration(\n158\t+                event_type=EntersBattlefieldTriggeredEvent,\n159\t+                condition=_condition,\n160\t+                effect=_effect,\n161\t+                source=self,\n162\t+                controller=controller,\n163\t+            )\n164\t+        )\n165\t+\n166\t+\n167\t+def _do_etb_effect(game: Any, source: EmeritusOfTruceSwordsToPlowshares) -> None:\n168\t+    \"\"\"Execute the ETB effect: create Inkling token, then check prepared.\n169\t+\n170\t+    Creates a 1/1 white+black Inkling creature token with flying for the\n171\t+    target player, then sets is_prepared if an opponent controls more\n172\t+    creatures than the controller.\n173\t+    \"\"\"\n174\t+    from engine.game import create_token\n175\t+\n176\t+    ctrl = getattr(source, \"controller\", None)\n177\t+    if ctrl is None:\n178\t+        return\n179\t+\n180\t+    # Determine the target player from chosen_targets.\n181\t+    chosen = getattr(source, \"chosen_targets\", None)\n182\t+    target_player = chosen[0] if chosen else ctrl\n183\t+\n184\t+    # Create a 1/1 white+black Inkling creature token with flying.\n185\t+    inkling = Creature(\n186\t+        name=\"Inkling\",\n187\t+        base_power=1,\n188\t+        base_toughness=1,\n189\t+        subtypes={\"Inkling\"},\n190\t+        keywords=Keyword.FLYING,\n191\t+        owner=target_player,\n192\t+        controller=target_player,\n193\t+    )\n194\t+    inkling.is_token = True\n195\t+    create_token(game, target_player, inkling)\n196\t+\n197\t+    # Check prepared condition: if any opponent controls more creatures\n198\t+    # than the controller.\n199\t+    ctrl_creatures = _count_creatures(game, ctrl)\n200\t+    for player in game.players:\n201\t+        if player is ctrl:\n202\t+            continue\n203\t+        opp_creatures = _count_creatures(game, player)\n204\t+        if opp_creatures > ctrl_creatures:\n205\t+            source.is_prepared = True\n206\t+            break\n207\t+\n208\t+\n209\t+def _count_creatures(game: Any, player: Any) -> int:\n210\t+    \"\"\"Count the number of creatures on a player's battlefield.\"\"\"\n211\t+    bf = game.get_battlefield(player)\n212\t+    count = 0\n213\t+    for obj in bf.get_all():\n214\t+        card_types = getattr(obj, \"card_types\", set())\n215\t+        if CardType.CREATURE in card_types:\n216\t+            count += 1\n217\t+    return count\n218\t"}]},"parent_tool_use_id":"toolu_015Hp8FW1YywKgAsGmTU27Am","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f","uuid":"5812d524-a21b-4a52-b197-7f9925ef6991","timestamp":"2026-05-28T11:18:48.133Z","subagent_type":"Reviewer","task_description":"Review sos_13 implementation"}
