{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013RyTv7zsQopZfk1Bf1PaAM","type":"tool_result","content":"1\t\"\"\"Card implementation for Great Hall of the Biblioplex.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import ActivatedAbility, Land, ManaAbility\n8\tfrom engine.continuous_effects import (\n9\t    ContinuousEffect,\n10\t    DURATION_END_OF_TURN,\n11\t    Layer,\n12\t    SubLayer,\n13\t)\n14\tfrom engine.events import SpellCastTriggeredEvent\n15\tfrom engine.triggers import TriggerRegistration\n16\tfrom engine.types import CardType, ManaCost, ManaType\n17\t\n18\tif TYPE_CHECKING:\n19\t    from engine.game_state import GameState\n20\t\n21\t\n22\tclass GreatHallOfTheBiblioplex(Land):\n23\t    \"\"\"Great Hall of the Biblioplex -- Land\n24\t\n25\t    {T}: Add {C}.\n26\t    {T}, Pay 1 life: Add one mana of any color. Spend this mana only to cast\n27\t    an instant or sorcery spell.\n28\t    {5}: If this land isn't a creature, it becomes a 2/4 Wizard creature with\n29\t    \"Whenever you cast an instant or sorcery spell, this creature gets +1/+0\n30\t    until end of turn.\" It's still a land.\n31\t\n32\t    SOS collector number 257.\n33\t    \"\"\"\n34\t\n35\t    def __init__(self, **kwargs: Any) -> None:\n36\t        kwargs.setdefault(\"name\", \"Great Hall of the Biblioplex\")\n37\t        kwargs.setdefault(\n38\t            \"rules_text\",\n39\t            \"{T}: Add {C}.\\n\"\n40\t            \"{T}, Pay 1 life: Add one mana of any color. Spend this mana \"\n41\t            \"only to cast an instant or sorcery spell.\\n\"\n42\t            \"{5}: If this land isn't a creature, it becomes a 2/4 Wizard \"\n43\t            \"creature with \\\"Whenever you cast an instant or sorcery spell, \"\n44\t            \"this creature gets +1/+0 until end of turn.\\\" It's still a land.\",\n45\t        )\n46\t        super().__init__(**kwargs)\n47\t        # Creature stats when animated\n48\t        self._is_animated: bool = False\n49\t        self._power_bonus: int = 0\n50\t\n51\t    # ------------------------------------------------------------------\n52\t    # Continuous-effect reset support\n53\t    # ------------------------------------------------------------------\n54\t\n55\t    def _reset_characteristics(self) -> None:\n56\t        \"\"\"Reset mutable characteristics, including power bonus.\"\"\"\n57\t        super()._reset_characteristics()\n58\t        self._power_bonus = 0\n59\t\n60\t    # ------------------------------------------------------------------\n61\t    # Properties for creature stats after animation\n62\t    # ------------------------------------------------------------------\n63\t\n64\t    @property\n65\t    def power(self) -> int:\n66\t        \"\"\"Current power (only meaningful when animated).\"\"\"\n67\t        if self._is_animated:\n68\t            return 2 + self._power_bonus\n69\t        return None  # type: ignore[return-value]\n70\t\n71\t    @property\n72\t    def toughness(self) -> int:\n73\t        \"\"\"Current toughness (only meaningful when animated).\"\"\"\n74\t        if self._is_animated:\n75\t            return 4\n76\t        return None  # type: ignore[return-value]\n77\t\n78\t    @property\n79\t    def base_power(self) -> int | None:\n80\t        if self._is_animated:\n81\t            return 2\n82\t        return None\n83\t\n84\t    @property\n85\t    def base_toughness(self) -> int | None:\n86\t        if self._is_animated:\n87\t            return 4\n88\t        return None\n89\t\n90\t    # ------------------------------------------------------------------\n91\t    # Mana abilities\n92\t    # ------------------------------------------------------------------\n93\t\n94\t    def get_mana_abilities(self) -> list[ManaAbility]:\n95\t        source = self\n96\t\n97\t        def _colorless_tap_cost(game: Any) -> bool:\n98\t            if source.is_tapped:\n99\t                return False\n100\t            source.is_tapped = True\n101\t            return True\n102\t\n103\t        def _colorless_mana_produced(game: Any) -> None:\n104\t            controller = source.controller\n105\t            if controller is not None:\n106\t                controller.mana_pool.add(ManaType.COLORLESS, 1)\n107\t\n108\t        def _any_color_tap_cost(game: Any) -> bool:\n109\t            if source.is_tapped:\n110\t                return False\n111\t            controller = source.controller\n112\t            if controller is None or controller.life < 1:\n113\t                return False\n114\t            source.is_tapped = True\n115\t            controller.life -= 1\n116\t            return True\n117\t\n118\t        def _any_color_mana_produced(game: Any) -> None:\n119\t            # ENGINE LIMITATION: The engine does not support conditional mana\n120\t            # spending restrictions. This should only be usable to cast\n121\t            # instant or sorcery spells. The restriction is not enforced here.\n122\t            controller = source.controller\n123\t            if controller is not None:\n124\t                color_options = [\n125\t                    ManaType.WHITE, ManaType.BLUE, ManaType.BLACK,\n126\t                    ManaType.RED, ManaType.GREEN,\n127\t                ]\n128\t                chosen_color = controller.choose(\n129\t                    color_options,\n130\t                    \"Choose a color of mana to produce\",\n131\t                )\n132\t                controller.mana_pool.add(chosen_color, 1)\n133\t\n134\t        return [\n135\t            ManaAbility(\n136\t                cost=_colorless_tap_cost,\n137\t                mana_produced=_colorless_mana_produced,\n138\t                description=\"{T}: Add {C}.\",\n139\t            ),\n140\t            ManaAbility(\n141\t                cost=_any_color_tap_cost,\n142\t                mana_produced=_any_color_mana_produced,\n143\t                description=\"{T}, Pay 1 life: Add one mana of any color.\",\n144\t            ),\n145\t        ]\n146\t\n147\t    # ------------------------------------------------------------------\n148\t    # Activated abilities\n149\t    # ------------------------------------------------------------------\n150\t\n151\t    def get_activated_abilities(self) -> list[ActivatedAbility]:\n152\t        source = self\n153\t\n154\t        def _animate_cost(game: Any) -> bool:\n155\t            controller = source.controller\n156\t            if controller is None:\n157\t                return False\n158\t            cost = ManaCost(generic=5)\n159\t            if not controller.mana_pool.can_pay(cost):\n160\t                return False\n161\t            controller.mana_pool.pay(cost)\n162\t            return True\n163\t\n164\t        def _animate_effect(game: Any) -> None:\n165\t            # \"If this land isn't a creature...\"\n166\t            if CardType.CREATURE in source.card_types:\n167\t                return\n168\t            # It becomes a 2/4 Wizard creature. It's still a land.\n169\t            source.card_types.add(CardType.CREATURE)\n170\t            source.subtypes.add(\"Wizard\")\n171\t            source._is_animated = True\n172\t            source._power_bonus = 0\n173\t\n174\t            # Register the triggered ability:\n175\t            # \"Whenever you cast an instant or sorcery spell, this creature\n176\t            #  gets +1/+0 until end of turn.\"\n177\t            def _spell_cast_condition(game: Any, event: Any) -> bool:\n178\t                # Must be controlled by the same player\n179\t                if event.controller is not source.controller:\n180\t                    return False\n181\t                spell = event.spell\n182\t                if spell is None:\n183\t                    return False\n184\t                spell_types = getattr(spell, \"card_types\", set())\n185\t                return (CardType.INSTANT in spell_types or\n186\t                        CardType.SORCERY in spell_types)\n187\t\n188\t            def _pump_effect(game: Any) -> None:\n189\t                # Register a ContinuousEffect with DURATION_END_OF_TURN\n190\t                # so the +1/+0 bonus resets at end of turn.\n191\t                def _apply_pump(_game: Any) -> None:\n192\t                    source._power_bonus += 1\n193\t\n194\t                effect = ContinuousEffect(\n195\t                    source=source,\n196\t                    layer=Layer.POWER_TOUGHNESS,\n197\t                    sublayer=SubLayer.MODIFY_PT,\n198\t                    apply=_apply_pump,\n199\t                    duration=DURATION_END_OF_TURN,\n200\t                )\n201\t                game.effect_manager.add(effect)\n202\t                # Apply immediately so the bonus is visible right away\n203\t                # (without requiring a full apply_all cycle).\n204\t                _apply_pump(game)\n205\t\n206\t            trigger = TriggerRegistration(\n207\t                event_type=SpellCastTriggeredEvent,\n208\t                condition=_spell_cast_condition,\n209\t                effect=_pump_effect,\n210\t                source=source,\n211\t                controller=source.controller,\n212\t            )\n213\t            game.trigger_manager.register(trigger)\n214\t\n215\t        return [\n216\t            ActivatedAbility(\n217\t                cost=_animate_cost,\n218\t                effect=_animate_effect,\n219\t                description=\"{5}: Animate into 2/4 Wizard creature.\",\n220\t            ),\n221\t        ]\n222\t"}]},"parent_tool_use_id":"toolu_01Nfa1k1jZWBdGqMH5oBDtQt","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f","uuid":"04302599-6a44-4e5d-964b-708b586f5195","timestamp":"2026-05-28T12:39:07.521Z","subagent_type":"Implementer","task_description":"Revise sos_257 per review"}
