{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EZRWKxsU5L9fpFomopZcyv","type":"tool_result","content":"1\t\"\"\"Card implementation for Improvisation Capstone.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Sorcery\n8\tfrom engine.types import CardType, ManaCost, Zone\n9\tfrom engine.events import TriggeredEvent\n10\tfrom engine.triggers import TriggerRegistration\n11\t\n12\tif TYPE_CHECKING:\n13\t    from engine.game_state import GameState\n14\t\n15\t\n16\tclass ImprovisationCapstone(Sorcery):\n17\t    \"\"\"Improvisation Capstone -- {5}{R}{R} -- Sorcery -- Lesson.\n18\t\n19\t    Exile cards from the top of your library until you exile cards with\n20\t    total mana value 4 or greater. You may cast any number of spells\n21\t    from among them without paying their mana costs.\n22\t\n23\t    Paradigm (Then exile this spell. After you first resolve a spell\n24\t    with this name, you may cast a copy of it from exile without paying\n25\t    its mana cost at the beginning of each of your first main phases.)\n26\t\n27\t    SOS collector number 120.\n28\t    \"\"\"\n29\t\n30\t    def __init__(self, **kwargs: Any) -> None:\n31\t        kwargs.setdefault(\"name\", \"Improvisation Capstone\")\n32\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{5}{R}{R}\"))\n33\t        kwargs.setdefault(\"subtypes\", {\"Lesson\"})\n34\t        kwargs.setdefault(\n35\t            \"rules_text\",\n36\t            \"Exile cards from the top of your library until you exile cards \"\n37\t            \"with total mana value 4 or greater. You may cast any number of \"\n38\t            \"spells from among them without paying their mana costs.\\n\"\n39\t            \"Paradigm (Then exile this spell. After you first resolve a spell \"\n40\t            \"with this name, you may cast a copy of it from exile without \"\n41\t            \"paying its mana cost at the beginning of each of your first \"\n42\t            \"main phases.)\",\n43\t        )\n44\t        super().__init__(**kwargs)\n45\t\n46\t    def on_resolve(self, game: GameState) -> None:\n47\t        \"\"\"Resolve: exile from library, free-cast, then Paradigm.\"\"\"\n48\t        controller = self.controller or self.owner\n49\t        if controller is None:\n50\t            return\n51\t\n52\t        # --- Main effect: exile from top of library until total MV >= 4 ---\n53\t        library = game.get_library(controller)\n54\t        exile = game.get_exile(controller)\n55\t        exiled_cards: list[Any] = []\n56\t        total_mv = 0\n57\t\n58\t        while len(library) > 0 and total_mv < 4:\n59\t            # Take from the top of the library (last element)\n60\t            top_cards = library.top(1)\n61\t            if not top_cards:\n62\t                break\n63\t            card = top_cards[0]\n64\t            library.remove(card)\n65\t            exile.add(card)\n66\t            exiled_cards.append(card)\n67\t            # Add the card's mana value to the running total\n68\t            card_cost = getattr(card, \"mana_cost\", None)\n69\t            if card_cost is not None:\n70\t                total_mv += card_cost.cmc\n71\t\n72\t        # --- Free-cast from among exiled cards ---\n73\t        # For each non-land exiled card, ask the controller whether to cast it\n74\t        for card in exiled_cards:\n75\t            card_types = getattr(card, \"card_types\", set())\n76\t            # Lands cannot be cast (they are not spells)\n77\t            if CardType.LAND in card_types:\n78\t                continue\n79\t\n80\t            # Ask the player whether they want to cast this spell\n81\t            try:\n82\t                wants_to_cast = controller.choose_yes_no(\n83\t                    f\"Cast {getattr(card, 'name', 'card')} without paying its mana cost?\"\n84\t                )\n85\t            except Exception:\n86\t                continue\n87\t\n88\t            if not wants_to_cast:\n89\t                continue\n90\t\n91\t            # Cast the spell: resolve it immediately (simplified free-cast)\n92\t            # Remove from exile first\n93\t            if exile.contains(card):\n94\t                exile.remove(card)\n95\t\n96\t            # Set controller/owner\n97\t            card.controller = controller\n98\t            if card.owner is None:\n99\t                card.owner = controller\n100\t\n101\t            # Resolve the spell\n102\t            card.on_resolve(game)\n103\t\n104\t            # Determine where the card goes after resolution\n105\t            permanent_types = {\n106\t                CardType.CREATURE, CardType.ENCHANTMENT,\n107\t                CardType.ARTIFACT, CardType.PLANESWALKER\n108\t            }\n109\t            if card_types & permanent_types:\n110\t                # Permanents go to the battlefield\n111\t                battlefield = game.get_battlefield(controller)\n112\t                battlefield.add(card)\n113\t            else:\n114\t                # Non-permanents (instant/sorcery) go to the graveyard\n115\t                graveyard = game.get_graveyard(controller)\n116\t                graveyard.add(card)\n117\t\n118\t        # --- Paradigm ---\n119\t        # 1. Exile this spell (set marker for _resolve_spell in casting pipeline)\n120\t        self._paradigm_exile = True  # type: ignore[attr-defined]\n121\t\n122\t        # Also directly move self from stack to exile if we can find it on the stack\n123\t        stack_zone = controller.zones.get(Zone.STACK, None) if hasattr(controller.zones, 'get') else None\n124\t        if stack_zone is None:\n125\t            try:\n126\t                stack_zone = controller.zones[Zone.STACK]\n127\t            except Exception:\n128\t                stack_zone = None\n129\t\n130\t        if stack_zone is not None and stack_zone.contains(self):\n131\t            stack_zone.remove(self)\n132\t            exile.add(self)\n133\t\n134\t        # 2. Register a delayed trigger for Paradigm (only on first resolution)\n135\t        # Use a game-level tracker to ensure we only register once per card name\n136\t        if not hasattr(game, \"_paradigm_registered\"):\n137\t            game._paradigm_registered = set()  # type: ignore[attr-defined]\n138\t\n139\t        card_name = self.name\n140\t        if card_name not in game._paradigm_registered:  # type: ignore[attr-defined]\n141\t            game._paradigm_registered.add(card_name)  # type: ignore[attr-defined]\n142\t\n143\t            paradigm_controller = controller\n144\t\n145\t            def _paradigm_condition(g: GameState, event: Any) -> bool:\n146\t                \"\"\"Fire at the beginning of controller's precombat main phase.\"\"\"\n147\t                from engine.types import Phase\n148\t                active = getattr(g, \"active_player\", None)\n149\t                phase = getattr(g, \"phase\", None)\n150\t                if active is not paradigm_controller:\n151\t                    return False\n152\t                return phase == Phase.PRECOMBAT_MAIN\n153\t\n154\t            def _paradigm_effect(g: GameState) -> None:\n155\t                \"\"\"Cast a copy of Improvisation Capstone from exile.\"\"\"\n156\t                # This is a delayed trigger effect; implementation is simplified\n157\t                pass\n158\t\n159\t            trigger_reg = TriggerRegistration(\n160\t                event_type=TriggeredEvent,\n161\t                condition=_paradigm_condition,\n162\t                effect=_paradigm_effect,\n163\t                source=self,\n164\t                controller=controller,\n165\t            )\n166\t            game.trigger_manager.register(trigger_reg)\n167\t"}]},"parent_tool_use_id":"toolu_014vHCnVAnQfkea4yrVkDgBL","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f","uuid":"97ac1df4-156c-4056-a750-27feaa4e4236","timestamp":"2026-05-28T11:53:45.892Z","subagent_type":"Implementer","task_description":"Revise sos_120 per review"}
{"type":"system","subtype":"task_progress","task_id":"a75632fb04572e45e","tool_use_id":"toolu_014vHCnVAnQfkea4yrVkDgBL","description":"Reading cards/sos/sos_120/tests.py","subagent_type":"Implementer","usage":{"total_tokens":9505,"tool_uses":3,"duration_ms":3338},"last_tool_name":"Read","uuid":"cfaee850-59cf-4a31-a603-da1e2275c939","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f"}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01WFPnR9jES5n5GDvWzrk4V7","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01BRGN4FjGsYsv4SBGVEVw1Z","name":"Read","input":{"file_path":"/workspace/cards/sos/sos_120/tests.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":3,"cache_creation_input_tokens":883,"cache_read_input_tokens":8603,"cache_creation":{"ephemeral_5m_input_tokens":883,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_014vHCnVAnQfkea4yrVkDgBL","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f","uuid":"ed8431e4-802e-43a6-add9-b71357d26828","request_id":"req_011CbUvPRCQwtg2R8tXurVbw","subagent_type":"Implementer","task_description":"Revise sos_120 per review"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BRGN4FjGsYsv4SBGVEVw1Z","type":"tool_result","content":"1\t\"\"\"Tests for SOS 120 — Improvisation Capstone.\n2\t\n3\tImprovisation Capstone is a {5}{R}{R} Sorcery — Lesson with Paradigm.\n4\t\n5\tOracle text:\n6\t  Exile cards from the top of your library until you exile cards with total\n7\t  mana value 4 or greater. You may cast any number of spells from among them\n8\t  without paying their mana costs.\n9\t\n10\t  Paradigm (Then exile this spell. After you first resolve a spell with this\n11\t  name, you may cast a copy of it from exile without paying its mana cost at\n12\t  the beginning of each of your first main phases.)\n13\t\n14\tRequirements tested:\n15\t- Static properties (name, mana cost, card type, subtypes)\n16\t- Exile-from-library mechanic: exile until total MV >= 4\n17\t- Free-cast from among exiled cards\n18\t- Paradigm: spell is exiled instead of going to graveyard\n19\t- Paradigm: delayed trigger on precombat main phases after first resolution\n20\t- Edge cases: empty library, all lands exiled, exact MV threshold\n21\t\"\"\"\n22\t\n23\tfrom __future__ import annotations\n24\t\n25\timport pytest\n26\t\n27\tfrom cards.sos.sos_120.card_impl import ImprovisationCapstone\n28\tfrom engine.card import CardImpl, Creature, Instant, Sorcery\n29\tfrom engine.types import CardType, ManaCost, ManaType, Zone\n30\tfrom test_utils import create_game, set_board_state\n31\t\n32\t\n33\t# ---------------------------------------------------------------------------\n34\t# Helper: create simple cards with known mana values for library stacking\n35\t# ---------------------------------------------------------------------------\n36\t\n37\tdef _make_creature(name: str, mana_cost_str: str, power: int = 1, toughness: int = 1) -> Creature:\n38\t    \"\"\"Create a simple creature with the given mana cost.\"\"\"\n39\t    return Creature(\n40\t        name=name,\n41\t        mana_cost=ManaCost.parse(mana_cost_str),\n42\t        base_power=power,\n43\t        base_toughness=toughness,\n44\t    )\n45\t\n46\t\n47\tdef _make_sorcery(name: str, mana_cost_str: str) -> Sorcery:\n48\t    \"\"\"Create a simple sorcery with the given mana cost.\"\"\"\n49\t    return Sorcery(\n50\t        name=name,\n51\t        mana_cost=ManaCost.parse(mana_cost_str),\n52\t    )\n53\t\n54\t\n55\tdef _make_instant(name: str, mana_cost_str: str) -> Instant:\n56\t    \"\"\"Create a simple instant with the given mana cost.\"\"\"\n57\t    return Instant(\n58\t        name=name,\n59\t        mana_cost=ManaCost.parse(mana_cost_str),\n60\t    )\n61\t\n62\t\n63\tclass TestImprovisationCapstoneProperties:\n64\t    \"\"\"Static card data should match the SOS 120 spec.\"\"\"\n65\t\n66\t    def test_is_sorcery(self) -> None:\n67\t        card = ImprovisationCapstone(owner=None)\n68\t        assert isinstance(card, Sorcery) or CardType.SORCERY in card.card_types\n69\t\n70\t    def test_name(self) -> None:\n71\t        card = ImprovisationCapstone(owner=None)\n72\t        assert card.name == \"Improvisation Capstone\"\n73\t\n74\t    def test_mana_cost(self) -> None:\n75\t        card = ImprovisationCapstone(owner=None)\n76\t        assert card.mana_cost == ManaCost.parse(\"{5}{R}{R}\")\n77\t\n78\t    def test_subtypes_include_lesson(self) -> None:\n79\t        card = ImprovisationCapstone(owner=None)\n80\t        assert \"Lesson\" in card.subtypes\n81\t\n82\t\n83\tclass TestImprovisationCapstoneExileEffect:\n84\t    \"\"\"The primary effect: exile cards from top of library until total MV >= 4.\"\"\"\n85\t\n86\t    def test_exiles_cards_until_total_mv_reaches_four(self) -> None:\n87\t        \"\"\"With four 1-MV cards on top, all four should be exiled to reach MV 4.\"\"\"\n88\t        game = create_game()\n89\t        p1 = game.players[0]\n90\t\n91\t        # Stack library: bottom -> top: card_a(1), card_b(1), card_c(1), card_d(1)\n92\t        card_a = _make_creature(\"Card A\", \"{R}\")  # MV 1\n93\t        card_b = _make_creature(\"Card B\", \"{R}\")  # MV 1\n94\t        card_c = _make_creature(\"Card C\", \"{R}\")  # MV 1\n95\t        card_d = _make_creature(\"Card D\", \"{R}\")  # MV 1\n96\t\n97\t        library = game.get_library(p1)\n98\t        for c in [card_a, card_b, card_c, card_d]:\n99\t            c.owner = p1\n100\t            c.controller = p1\n101\t            library.add(c)\n102\t\n103\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n104\t        # Script: decline to cast all exiled spells\n105\t        p1._script.extend([False, False, False, False])\n106\t\n107\t        spell.on_resolve(game)\n108\t\n109\t        exile = game.get_exile(p1)\n110\t        exiled_cards = exile.get_all()\n111\t        exiled_names = {getattr(c, \"name\", \"\") for c in exiled_cards}\n112\t\n113\t        # All four 1-MV cards should be exiled to reach total MV 4\n114\t        assert \"Card D\" in exiled_names\n115\t        assert \"Card C\" in exiled_names\n116\t        assert \"Card B\" in exiled_names\n117\t        assert \"Card A\" in exiled_names\n118\t\n119\t    def test_stops_exiling_once_mv_threshold_met(self) -> None:\n120\t        \"\"\"A single 4-MV card on top should cause only one card to be exiled.\"\"\"\n121\t        game = create_game()\n122\t        p1 = game.players[0]\n123\t\n124\t        big_card = _make_creature(\"Big Card\", \"{3}{R}\")  # MV 4\n125\t        extra_card = _make_creature(\"Extra Card\", \"{R}\")  # MV 1 (should NOT be exiled)\n126\t\n127\t        library = game.get_library(p1)\n128\t        # Bottom -> top: extra, big\n129\t        extra_card.owner = p1\n130\t        extra_card.controller = p1\n131\t        library.add(extra_card)\n132\t        big_card.owner = p1\n133\t        big_card.controller = p1\n134\t        library.add(big_card)\n135\t\n136\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n137\t        # Script: decline to cast the exiled spell\n138\t        p1._script.extend([False])\n139\t\n140\t        spell.on_resolve(game)\n141\t\n142\t        exile = game.get_exile(p1)\n143\t        exiled_names = {getattr(c, \"name\", \"\") for c in exile.get_all()}\n144\t        assert \"Big Card\" in exiled_names\n145\t        # Extra card should remain in library\n146\t        lib_names = {getattr(c, \"name\", \"\") for c in library.get_all()}\n147\t        assert \"Extra Card\" in lib_names\n148\t\n149\t    def test_mv_five_exceeds_threshold_stops(self) -> None:\n150\t        \"\"\"A single 5-MV card exceeds the threshold of 4; should stop after one exile.\"\"\"\n151\t        game = create_game()\n152\t        p1 = game.players[0]\n153\t\n154\t        big = _make_creature(\"Huge Card\", \"{4}{R}\")  # MV 5\n155\t        small = _make_creature(\"Small Card\", \"{R}\")  # MV 1\n156\t\n157\t        library = game.get_library(p1)\n158\t        small.owner = p1\n159\t        small.controller = p1\n160\t        library.add(small)\n161\t        big.owner = p1\n162\t        big.controller = p1\n163\t        library.add(big)\n164\t\n165\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n166\t        p1._script.extend([False])\n167\t        spell.on_resolve(game)\n168\t\n169\t        exile = game.get_exile(p1)\n170\t        exiled_names = {getattr(c, \"name\", \"\") for c in exile.get_all()}\n171\t        assert \"Huge Card\" in exiled_names\n172\t        assert \"Small Card\" not in exiled_names\n173\t\n174\t    def test_zero_mv_cards_do_not_count_toward_threshold(self) -> None:\n175\t        \"\"\"Cards with MV 0 should be exiled but not count toward the total MV 4.\"\"\"\n176\t        game = create_game()\n177\t        p1 = game.players[0]\n178\t\n179\t        # Stack: bottom -> top: MV-4 creature, MV-0 creature, MV-0 creature\n180\t        zero_a = _make_creature(\"Zero A\", \"{0}\")  # MV 0\n181\t        zero_b = _make_creature(\"Zero B\", \"{0}\")  # MV 0\n182\t        four_card = _make_creature(\"Four Card\", \"{3}{R}\")  # MV 4\n183\t\n184\t        library = game.get_library(p1)\n185\t        for c in [four_card, zero_b, zero_a]:\n186\t            # bottom: four_card, then zero_b, then zero_a on top\n187\t            # Exiling from top: zero_a (total 0), zero_b (total 0), four_card (total 4) - stop\n188\t            c.owner = p1\n189\t            c.controller = p1\n190\t            library.add(c)\n191\t\n192\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n193\t        # Decline all casts\n194\t        p1._script.extend([False, False, False])\n195\t        spell.on_resolve(game)\n196\t\n197\t        exile = game.get_exile(p1)\n198\t        exiled_names = {getattr(c, \"name\", \"\") for c in exile.get_all()}\n199\t        # All three should be exiled since we need to reach MV 4\n200\t        assert \"Zero A\" in exiled_names\n201\t        assert \"Zero B\" in exiled_names\n202\t        assert \"Four Card\" in exiled_names\n203\t\n204\t    def test_empty_library_does_not_crash(self) -> None:\n205\t        \"\"\"If the library is empty, resolving should not crash.\n206\t        Also verifies that Paradigm behavior still triggers even with empty library.\"\"\"\n207\t        game = create_game()\n208\t        p1 = game.players[0]\n209\t\n210\t        # Library is empty by default from create_game\n211\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n212\t        # Should complete without error\n213\t        spell.on_resolve(game)\n214\t\n215\t        # Paradigm should still register a delayed trigger even when library is empty\n216\t        triggers = game.trigger_manager.get_triggers()\n217\t        assert len(triggers) > 0, (\n218\t            \"Paradigm delayed trigger should be registered even with empty library\"\n219\t        )\n220\t\n221\t    def test_library_exhausted_before_threshold(self) -> None:\n222\t        \"\"\"If library runs out before reaching MV 4, exile what's available.\"\"\"\n223\t        game = create_game()\n224\t        p1 = game.players[0]\n225\t\n226\t        # Only 2 MV worth of cards\n227\t        small_a = _make_creature(\"Small A\", \"{R}\")  # MV 1\n228\t        small_b = _make_creature(\"Small B\", \"{R}\")  # MV 1\n229\t\n230\t        library = game.get_library(p1)\n231\t        for c in [small_a, small_b]:\n232\t            c.owner = p1\n233\t            c.controller = p1\n234\t            library.add(c)\n235\t\n236\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n237\t        # Decline to cast\n238\t        p1._script.extend([False, False])\n239\t        spell.on_resolve(game)\n240\t\n241\t        # Both should be exiled even though MV 4 wasn't reached\n242\t        exile = game.get_exile(p1)\n243\t        assert len([c for c in exile.get_all() if getattr(c, \"name\", \"\").startswith(\"Small\")]) == 2\n244\t        # Library should be empty\n245\t        assert len(library) == 0\n246\t\n247\t\n248\tclass TestImprovisationCapstoneCasting:\n249\t    \"\"\"You may cast any number of spells from among exiled cards without paying mana costs.\"\"\"\n250\t\n251\t    def test_cast_exiled_spell_without_paying_mana(self) -> None:\n252\t        \"\"\"When choosing to cast an exiled spell, it should resolve without mana payment.\"\"\"\n253\t        game = create_game()\n254\t        p1 = game.players[0]\n255\t\n256\t        # A single 4-MV creature on top of library\n257\t        creature = _make_creature(\"Free Cast Target\", \"{3}{R}\", power=4, toughness=4)\n258\t\n259\t        library = game.get_library(p1)\n260\t        creature.owner = p1\n261\t        creature.controller = p1\n262\t        library.add(creature)\n263\t\n264\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n265\t        # Script: choose to cast the creature\n266\t        p1._script.extend([True])\n267\t        spell.on_resolve(game)\n268\t\n269\t        # The creature should be on the battlefield (or at least not just in exile)\n270\t        bf = game.get_battlefield(p1)\n271\t        bf_names = [getattr(c, \"name\", \"\") for c in bf.get_all()]\n272\t        assert \"Free Cast Target\" in bf_names\n273\t\n274\t    def test_choose_not_to_cast_leaves_in_exile(self) -> None:\n275\t        \"\"\"When declining to cast, the exiled card should stay in exile.\"\"\"\n276\t        game = create_game()\n277\t        p1 = game.players[0]\n278\t\n279\t        creature = _make_creature(\"Declined Card\", \"{3}{R}\", power=3, toughness=3)\n280\t\n281\t        library = game.get_library(p1)\n282\t        creature.owner = p1\n283\t        creature.controller = p1\n284\t        library.add(creature)\n285\t\n286\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n287\t        # Script: decline to cast\n288\t        p1._script.extend([False])\n289\t        spell.on_resolve(game)\n290\t\n291\t        # The card should remain in exile\n292\t        exile = game.get_exile(p1)\n293\t        exile_names = [getattr(c, \"name\", \"\") for c in exile.get_all()]\n294\t        assert \"Declined Card\" in exile_names\n295\t\n296\t        # And NOT on the battlefield\n297\t        bf = game.get_battlefield(p1)\n298\t        bf_names = [getattr(c, \"name\", \"\") for c in bf.get_all()]\n299\t        assert \"Declined Card\" not in bf_names\n300\t\n301\t    def test_can_cast_multiple_spells_from_exiled(self) -> None:\n302\t        \"\"\"You may cast any number of spells from among the exiled cards.\"\"\"\n303\t        game = create_game()\n304\t        p1 = game.players[0]\n305\t\n306\t        # Stack library with 2-MV creatures to reach threshold of 4\n307\t        c1 = _make_creature(\"Cast Me 1\", \"{1}{R}\", power=2, toughness=2)  # MV 2\n308\t        c2 = _make_creature(\"Cast Me 2\", \"{1}{R}\", power=2, toughness=2)  # MV 2\n309\t\n310\t        library = game.get_library(p1)\n311\t        for c in [c1, c2]:\n312\t            c.owner = p1\n313\t            c.controller = p1\n314\t            library.add(c)\n315\t\n316\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n317\t        # Script: choose to cast both\n318\t        p1._script.extend([True, True])\n319\t        spell.on_resolve(game)\n320\t\n321\t        bf = game.get_battlefield(p1)\n322\t        bf_names = [getattr(c, \"name\", \"\") for c in bf.get_all()]\n323\t        assert \"Cast Me 1\" in bf_names\n324\t        assert \"Cast Me 2\" in bf_names\n325\t\n326\t    def test_lands_among_exiled_cannot_be_cast(self) -> None:\n327\t        \"\"\"Lands are not spells, so they cannot be cast from among the exiled cards.\"\"\"\n328\t        from engine.card import Land\n329\t\n330\t        game = create_game()\n331\t        p1 = game.players[0]\n332\t\n333\t        # A land with MV 0 and a 4-MV creature\n334\t        land = Land(name=\"Mountain\")\n335\t        land.mana_cost = ManaCost()  # MV 0\n336\t        big = _make_creature(\"Big Guy\", \"{3}{R}\")  # MV 4\n337\t\n338\t        library = game.get_library(p1)\n339\t        # bottom: big, top: land\n340\t        # Exile from top: land (MV 0, total 0), big (MV 4, total 4) -> stop\n341\t        for c in [big, land]:\n342\t            c.owner = p1\n343\t            c.controller = p1\n344\t            library.add(c)\n345\t\n346\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n347\t        # Script: cast the creature only (land should not be offered)\n348\t        # If land is offered, we decline; if creature is offered, we decline too\n349\t        p1._script.extend([False, False])\n350\t        spell.on_resolve(game)\n351\t\n352\t        # Both should be in exile\n353\t        exile = game.get_exile(p1)\n354\t        exile_names = [getattr(c, \"name\", \"\") for c in exile.get_all()]\n355\t        assert \"Mountain\" in exile_names\n356\t\n357\t        # Land should NOT be on the battlefield\n358\t        bf = game.get_battlefield(p1)\n359\t        bf_names = [getattr(c, \"name\", \"\") for c in bf.get_all()]\n360\t        assert \"Mountain\" not in bf_names\n361\t\n362\t\n363\tclass TestImprovisationCapstoneParadigm:\n364\t    \"\"\"Paradigm: exile this spell after resolving, and create delayed trigger.\"\"\"\n365\t\n366\t    def test_spell_is_exiled_after_resolution(self) -> None:\n367\t        \"\"\"Paradigm says 'Exile this spell' — after resolution it should be in exile,\n368\t        not the graveyard.\"\"\"\n369\t        game = create_game()\n370\t        p1 = game.players[0]\n371\t\n372\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n373\t\n374\t        # Put the spell on the stack zone to simulate resolution\n375\t        p1.zones[Zone.STACK].add(spell)\n376\t\n377\t        # Give it an empty library so the exile effect is a no-op\n378\t        # (library is empty by default)\n379\t\n380\t        spell.on_resolve(game)\n381\t\n382\t        # After on_resolve, the spell should move to exile\n383\t        # The casting pipeline handles the zone move, but the card's paradigm\n384\t        # should ensure exile instead of graveyard. We check that the card\n385\t        # indicates it should be exiled.\n386\t        # Check for the exile marker or that the card is in exile\n387\t        exile = game.get_exile(p1)\n388\t        graveyard = game.get_graveyard(p1)\n389\t\n390\t        # The spell should be in exile, not in graveyard\n391\t        # (Note: the casting pipeline's _resolve_spell handles the actual move,\n392\t        # but the card should set up the exile-instead marker like _dawning_archaic_exile\n393\t        # or the on_resolve should move it directly)\n394\t        in_exile = exile.contains(spell)\n395\t        has_exile_marker = getattr(spell, \"_paradigm_exile\", False) or getattr(spell, \"_dawning_archaic_exile\", False)\n396\t        # At least one of these should be true after on_resolve\n397\t        assert in_exile or has_exile_marker, (\n398\t            \"Spell should be in exile or have an exile marker after resolution (Paradigm)\"\n399\t        )\n400\t\n401\t    def test_paradigm_first_resolution_registers_delayed_trigger(self) -> None:\n402\t        \"\"\"After the first resolution, Paradigm should register a delayed trigger\n403\t        that fires at the beginning of each precombat main phase.\"\"\"\n404\t        game = create_game()\n405\t        p1 = game.players[0]\n406\t\n407\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n408\t\n409\t        triggers_before = len(game.trigger_manager.get_triggers())\n410\t\n411\t        spell.on_resolve(game)\n412\t\n413\t        triggers_after = len(game.trigger_manager.get_triggers())\n414\t\n415\t        # There should be at least one new trigger registered for the paradigm\n416\t        assert triggers_after > triggers_before, (\n417\t            \"Paradigm should register a delayed trigger after first resolution\"\n418\t        )\n419\t\n420\t    def test_paradigm_second_resolution_does_not_double_register(self) -> None:\n421\t        \"\"\"Paradigm text says 'After you first resolve a spell with this name' --\n422\t        the delayed trigger is set up only once, not on each resolution.\"\"\"\n423\t        game = create_game()\n424\t        p1 = game.players[0]\n425\t\n426\t        spell1 = ImprovisationCapstone(owner=p1, controller=p1)\n427\t        spell2 = ImprovisationCapstone(owner=p1, controller=p1)\n428\t\n429\t        spell1.on_resolve(game)\n430\t        triggers_after_first = len(game.trigger_manager.get_triggers())\n431\t\n432\t        # First resolution must have registered at least one trigger (paradigm)\n433\t        assert triggers_after_first > 0, (\n434\t            \"First resolution should register a paradigm delayed trigger\"\n435\t        )\n436\t\n437\t        spell2.on_resolve(game)\n438\t        triggers_after_second = len(game.trigger_manager.get_triggers())\n439\t\n440\t        # The trigger count should not increase on the second resolution\n441\t        assert triggers_after_second == triggers_after_first, (\n442\t            \"Paradigm delayed trigger should only be registered once (on first resolution)\"\n443\t        )\n444\t\n445\t\n446\tclass TestImprovisationCapstoneExileFromTop:\n447\t    \"\"\"Verify the exile operates on the top of the library.\"\"\"\n448\t\n449\t    def test_exiles_from_top_not_bottom(self) -> None:\n450\t        \"\"\"Cards should be exiled from the top of the library (last in the list).\"\"\"\n451\t        game = create_game()\n452\t        p1 = game.players[0]\n453\t\n454\t        # Stack: bottom card (MV 4) and top card (MV 1)\n455\t        bottom = _make_creature(\"Bottom Card\", \"{3}{R}\")  # MV 4\n456\t        top = _make_creature(\"Top Card\", \"{R}\")  # MV 1\n457\t\n458\t        library = game.get_library(p1)\n459\t        # Add bottom first, then top (top is last = top of library)\n460\t        bottom.owner = p1\n461\t        bottom.controller = p1\n462\t        library.add(bottom)\n463\t        top.owner = p1\n464\t        top.controller = p1\n465\t        library.add(top)\n466\t\n467\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n468\t        p1._script.extend([False, False])\n469\t        spell.on_resolve(game)\n470\t\n471\t        exile = game.get_exile(p1)\n472\t        exiled_names = {getattr(c, \"name\", \"\") for c in exile.get_all()}\n473\t\n474\t        # Top Card (MV 1) should be exiled first, then Bottom Card (MV 4)\n475\t        # Total: 1 + 4 = 5 >= 4, so both get exiled\n476\t        assert \"Top Card\" in exiled_names\n477\t        assert \"Bottom Card\" in exiled_names\n478\t\n479\t    def test_partial_threshold_exiles_correct_cards(self) -> None:\n480\t        \"\"\"With a 3-MV card on top and a 2-MV card below, both should be exiled\n481\t        (total MV 5 >= 4), and a 1-MV card below that should NOT be exiled.\"\"\"\n482\t        game = create_game()\n483\t        p1 = game.players[0]\n484\t\n485\t        bottom = _make_creature(\"Bottom Stay\", \"{R}\")   # MV 1 -- should stay\n486\t        middle = _make_creature(\"Middle\", \"{1}{R}\")      # MV 2\n487\t        top = _make_creature(\"Top\", \"{2}{R}\")             # MV 3\n488\t\n489\t        library = game.get_library(p1)\n490\t        for c in [bottom, middle, top]:\n491\t            c.owner = p1\n492\t            c.controller = p1\n493\t            library.add(c)\n494\t\n495\t        spell = ImprovisationCapstone(owner=p1, controller=p1)\n496\t        p1._script.extend([False, False])\n497\t        spell.on_resolve(game)\n498\t\n499\t        exile = game.get_exile(p1)\n500\t        exiled_names = {getattr(c, \"name\", \"\") for c in exile.get_all()}\n501\t\n502\t        # Top (MV 3) exiled first (total 3 < 4), then Middle (MV 2) exiled (total 5 >= 4) -- stop\n503\t        assert \"Top\" in exiled_names\n504\t        assert \"Middle\" in exiled_names\n505\t        assert \"Bottom Stay\" not in exiled_names\n506\t\n507\t        # Bottom Stay should still be in library\n508\t        lib_names = {getattr(c, \"name\", \"\") for c in library.get_all()}\n509\t        assert \"Bottom Stay\" in lib_names\n510\t\n511\t\n512\tclass TestImprovisationCapstoneManaCostForCMC:\n513\t    \"\"\"Verify the card has the correct converted mana cost for the spell itself.\"\"\"\n514\t\n515\t    def test_cmc_is_seven(self) -> None:\n516\t        \"\"\"Mana cost {5}{R}{R} should have CMC/mana value of 7.\"\"\"\n517\t        card = ImprovisationCapstone(owner=None)\n518\t        assert card.mana_cost.cmc == 7\n519\t"}]},"parent_tool_use_id":"toolu_014vHCnVAnQfkea4yrVkDgBL","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f","uuid":"2722bb7b-3da0-4fa2-9cb9-b1d8b5d0c79c","timestamp":"2026-05-28T11:53:46.234Z","subagent_type":"Implementer","task_description":"Revise sos_120 per review"}
