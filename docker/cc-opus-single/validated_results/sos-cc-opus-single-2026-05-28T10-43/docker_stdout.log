{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Pp87LrekjGAWaSn7hsDLb9","type":"tool_result","content":"1\t\"\"\"Card implementation for Emeritus of Truce // Swords to Plowshares.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.events import EntersBattlefieldTriggeredEvent\n9\tfrom engine.types import CardType, Keyword, ManaCost, TargetRequirement, Zone\n10\t\n11\tif TYPE_CHECKING:\n12\t    from engine.game_state import GameState\n13\t\n14\t\n15\tclass EmeritusOfTruceSwordsToPlowshares(Creature):\n16\t    \"\"\"Emeritus of Truce // Swords to Plowshares — {1}{W}{W} — 3/3.\n17\t\n18\t    Creature — Cat Cleric\n19\t\n20\t    When this creature enters, target player creates a 1/1 white and\n21\t    black Inkling creature token with flying. Then if an opponent controls\n22\t    more creatures than you, this creature becomes prepared.\n23\t\n24\t    Prepare spell: Swords to Plowshares — {W} — Instant\n25\t    Exile target creature. Its controller gains life equal to its power.\n26\t\n27\t    SOS collector number 13.\n28\t    \"\"\"\n29\t\n30\t    def __init__(self, **kwargs: Any) -> None:\n31\t        kwargs.setdefault(\"name\", \"Emeritus of Truce // Swords to Plowshares\")\n32\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{W}{W}\"))\n33\t        kwargs.setdefault(\"subtypes\", {\"Cat\", \"Cleric\"})\n34\t        kwargs.setdefault(\"base_power\", 3)\n35\t        kwargs.setdefault(\"base_toughness\", 3)\n36\t        kwargs.setdefault(\n37\t            \"rules_text\",\n38\t            \"When this creature enters, target player creates a 1/1 white \"\n39\t            \"and black Inkling creature token with flying. Then if an \"\n40\t            \"opponent controls more creatures than you, this creature \"\n41\t            \"becomes prepared.\",\n42\t        )\n43\t        super().__init__(**kwargs)\n44\t        self.is_prepared: bool = False\n45\t\n46\t    def get_targets(self, game: GameState) -> list[Any]:\n47\t        \"\"\"Target player for the ETB ability.\"\"\"\n48\t        return [\n49\t            TargetRequirement(\n50\t                filter_fn=lambda obj: hasattr(obj, \"life\"),\n51\t                description=\"target player\",\n52\t                zone=Zone.BATTLEFIELD,\n53\t            )\n54\t        ]\n55\t\n56\t    def on_resolve(self, game: GameState) -> None:\n57\t        \"\"\"Schedule the ETB effect on the stack for after the creature enters.\n58\t\n59\t        The engine fires the ETB event before registering the card's own\n60\t        triggers (by design, to avoid self-referencing), so self-ETB\n61\t        effects must be pushed onto the stack from on_resolve.  The\n62\t        stack object resolves after the creature has moved to the\n63\t        battlefield, so creature counts are correct for the prepared\n64\t        check.\n65\t        \"\"\"\n66\t        from engine.stack import StackObject\n67\t\n68\t        source = self\n69\t\n70\t        def _etb_callback(g: GameState) -> None:\n71\t            _do_etb_effect(g, source)\n72\t\n73\t        stack_obj = StackObject(\n74\t            source=self,\n75\t            controller=self.controller or self.owner,\n76\t            on_resolve=_etb_callback,\n77\t        )\n78\t        game.stack.push(stack_obj)\n79\t\n80\t    def register_triggers(self, game: GameState) -> None:\n81\t        \"\"\"Register the ETB trigger for Inkling token creation and prepared check.\n82\t\n83\t        This trigger fires when the creature re-enters the battlefield\n84\t        (e.g. after being flickered).  The initial ETB on cast is handled\n85\t        by on_resolve pushing a stack object.\n86\t        \"\"\"\n87\t        from engine.triggers import TriggerRegistration\n88\t\n89\t        source = self\n90\t        controller = getattr(self, \"controller\", None) or game.active_player\n91\t\n92\t        def _condition(game: Any, event: EntersBattlefieldTriggeredEvent) -> bool:\n93\t            \"\"\"Only fire when this creature itself enters the battlefield.\"\"\"\n94\t            return event.permanent is source\n95\t\n96\t        def _effect(game: GameState) -> None:\n97\t            _do_etb_effect(game, source)\n98\t\n99\t        game.trigger_manager.register(\n100\t            TriggerRegistration(\n101\t                event_type=EntersBattlefieldTriggeredEvent,\n102\t                condition=_condition,\n103\t                effect=_effect,\n104\t                source=self,\n105\t                controller=controller,\n106\t            )\n107\t        )\n108\t\n109\t\n110\tdef _do_etb_effect(game: Any, source: EmeritusOfTruceSwordsToPlowshares) -> None:\n111\t    \"\"\"Execute the ETB effect: create Inkling token, then check prepared.\n112\t\n113\t    Creates a 1/1 white+black Inkling creature token with flying for the\n114\t    target player, then sets is_prepared if an opponent controls more\n115\t    creatures than the controller.\n116\t    \"\"\"\n117\t    from engine.game import create_token\n118\t\n119\t    ctrl = getattr(source, \"controller\", None)\n120\t    if ctrl is None:\n121\t        return\n122\t\n123\t    # Determine the target player from chosen_targets.\n124\t    chosen = getattr(source, \"chosen_targets\", None)\n125\t    target_player = chosen[0] if chosen else ctrl\n126\t\n127\t    # Create a 1/1 white+black Inkling creature token with flying.\n128\t    inkling = Creature(\n129\t        name=\"Inkling\",\n130\t        base_power=1,\n131\t        base_toughness=1,\n132\t        subtypes={\"Inkling\"},\n133\t        keywords=Keyword.FLYING,\n134\t        owner=target_player,\n135\t        controller=target_player,\n136\t    )\n137\t    inkling.is_token = True\n138\t    create_token(game, target_player, inkling)\n139\t\n140\t    # Check prepared condition: if any opponent controls more creatures\n141\t    # than the controller.\n142\t    ctrl_creatures = _count_creatures(game, ctrl)\n143\t    for player in game.players:\n144\t        if player is ctrl:\n145\t            continue\n146\t        opp_creatures = _count_creatures(game, player)\n147\t        if opp_creatures > ctrl_creatures:\n148\t            source.is_prepared = True\n149\t            break\n150\t\n151\t\n152\tdef _count_creatures(game: Any, player: Any) -> int:\n153\t    \"\"\"Count the number of creatures on a player's battlefield.\"\"\"\n154\t    bf = game.get_battlefield(player)\n155\t    count = 0\n156\t    for obj in bf.get_all():\n157\t        card_types = getattr(obj, \"card_types\", set())\n158\t        if CardType.CREATURE in card_types:\n159\t            count += 1\n160\t    return count\n161\t"}]},"parent_tool_use_id":"toolu_01G5PjHgHnPkrLeY7jb5LTQd","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f","uuid":"711c93bd-c7f2-45a8-b071-dfb1c9d35929","timestamp":"2026-05-28T11:17:05.833Z","subagent_type":"Implementer","task_description":"Implement sos_13 prepare spell"}
