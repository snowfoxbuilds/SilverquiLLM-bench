{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VUixRHFJuukxrjvCA8vPkC","type":"tool_result","content":"1\t\"\"\"Tests for SOS 226 -- Silverquill, the Disputant.\n2\t\n3\tSilverquill, the Disputant is a 4/4 Legendary Creature -- Elder Dragon\n4\tcosting {2}{W}{B} with Flying and Vigilance.\n5\t\n6\tOracle text:\n7\t    Flying, vigilance\n8\t    Each instant and sorcery spell you cast has casualty 1.\n9\t    (As you cast that spell, you may sacrifice a creature with power 1\n10\t    or greater. When you do, copy the spell and you may choose new\n11\t    targets for the copy.)\n12\t\n13\tCasualty 1 is granted to every instant and sorcery spell the controller\n14\tcasts while Silverquill is on the battlefield.  Paying casualty means\n15\tsacrificing a creature with power >= 1 as an additional cost; doing so\n16\ttriggers a copy of the spell being placed on the stack.\n17\t\"\"\"\n18\t\n19\tfrom __future__ import annotations\n20\t\n21\tfrom cards.sos.sos_226.card_impl import SilverquillTheDisputant\n22\tfrom engine.card import Creature, Instant, Sorcery\n23\tfrom engine.events import SpellCastTriggeredEvent\n24\tfrom engine.stack import StackObject, copy_spell\n25\tfrom engine.triggers import TriggerRegistration\n26\tfrom engine.types import (\n27\t    CardType,\n28\t    Keyword,\n29\t    ManaCost,\n30\t    ManaType,\n31\t    Supertype,\n32\t    Zone,\n33\t)\n34\tfrom test_utils import create_game, set_board_state\n35\t\n36\t\n37\t# ---------------------------------------------------------------------------\n38\t# Static Properties\n39\t# ---------------------------------------------------------------------------\n40\t\n41\t\n42\tclass TestSilverquillProperties:\n43\t    \"\"\"Static card data should match the SOS 226 spec.\"\"\"\n44\t\n45\t    def test_is_creature(self) -> None:\n46\t        card = SilverquillTheDisputant(owner=None)\n47\t        assert isinstance(card, Creature)\n48\t\n49\t    def test_name(self) -> None:\n50\t        card = SilverquillTheDisputant(owner=None)\n51\t        assert card.name == \"Silverquill, the Disputant\"\n52\t\n53\t    def test_mana_cost(self) -> None:\n54\t        card = SilverquillTheDisputant(owner=None)\n55\t        assert card.mana_cost == ManaCost.parse(\"{2}{W}{B}\")\n56\t\n57\t    def test_power_toughness(self) -> None:\n58\t        card = SilverquillTheDisputant(owner=None)\n59\t        assert card.base_power == 4\n60\t        assert card.base_toughness == 4\n61\t\n62\t    def test_has_flying(self) -> None:\n63\t        card = SilverquillTheDisputant(owner=None)\n64\t        assert Keyword.FLYING in card.keywords\n65\t\n66\t    def test_has_vigilance(self) -> None:\n67\t        card = SilverquillTheDisputant(owner=None)\n68\t        assert Keyword.VIGILANCE in card.keywords\n69\t\n70\t    def test_is_legendary(self) -> None:\n71\t        card = SilverquillTheDisputant(owner=None)\n72\t        assert Supertype.LEGENDARY in card.supertypes\n73\t\n74\t    def test_subtypes_include_elder_and_dragon(self) -> None:\n75\t        card = SilverquillTheDisputant(owner=None)\n76\t        assert \"Elder\" in card.subtypes\n77\t        assert \"Dragon\" in card.subtypes\n78\t\n79\t\n80\t# ---------------------------------------------------------------------------\n81\t# Trigger Registration -- Casualty granting\n82\t# ---------------------------------------------------------------------------\n83\t\n84\t\n85\tclass TestSilverquillCasualtyRegistration:\n86\t    \"\"\"When Silverquill enters the battlefield it should register trigger(s)\n87\t    that grant casualty 1 to instant and sorcery spells the controller casts.\n88\t\n89\t    Casualty is implemented as: when the controller casts an instant or\n90\t    sorcery, if they choose to pay casualty (sacrifice a creature with\n91\t    power >= 1), the spell is copied on the stack.\n92\t    \"\"\"\n93\t\n94\t    def test_registers_trigger_on_battlefield(self) -> None:\n95\t        \"\"\"Silverquill should register at least one trigger when it enters\n96\t        the battlefield (a SpellCastTriggeredEvent watcher).\"\"\"\n97\t        game = create_game()\n98\t        p1 = game.players[0]\n99\t        card = SilverquillTheDisputant(owner=p1, controller=p1)\n100\t        before = len(game.trigger_manager.get_triggers())\n101\t        card.register_triggers(game)\n102\t        after = len(game.trigger_manager.get_triggers())\n103\t        assert after > before\n104\t\n105\t    def test_registered_trigger_watches_spell_cast_event(self) -> None:\n106\t        \"\"\"The trigger should be watching for SpellCastTriggeredEvent so\n107\t        that it fires when the controller casts an instant or sorcery.\"\"\"\n108\t        game = create_game()\n109\t        p1 = game.players[0]\n110\t        card = SilverquillTheDisputant(owner=p1, controller=p1)\n111\t        card.register_triggers(game)\n112\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n113\t        spell_cast_triggers = [\n114\t            t for t in triggers\n115\t            if t.event_type is SpellCastTriggeredEvent\n116\t        ]\n117\t        assert len(spell_cast_triggers) >= 1\n118\t\n119\t    def test_trigger_source_is_silverquill(self) -> None:\n120\t        \"\"\"The registered trigger's source must be the Silverquill card itself.\"\"\"\n121\t        game = create_game()\n122\t        p1 = game.players[0]\n123\t        card = SilverquillTheDisputant(owner=p1, controller=p1)\n124\t        card.register_triggers(game)\n125\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n126\t        assert len(triggers) >= 1\n127\t        assert all(t.source is card for t in triggers)\n128\t\n129\t\n130\t# ---------------------------------------------------------------------------\n131\t# Casualty Condition -- only instants and sorceries\n132\t# ---------------------------------------------------------------------------\n133\t\n134\t\n135\tclass TestSilverquillCasualtyCondition:\n136\t    \"\"\"The casualty trigger should only fire for instant and sorcery spells\n137\t    cast by the controller, not for creature/enchantment/artifact spells,\n138\t    and not for spells cast by the opponent.\"\"\"\n139\t\n140\t    def _setup_silverquill_on_battlefield(self):\n141\t        \"\"\"Helper: create game with Silverquill on p1's battlefield,\n142\t        triggers registered.\"\"\"\n143\t        game = create_game()\n144\t        p1 = game.players[0]\n145\t        card = SilverquillTheDisputant(owner=p1, controller=p1)\n146\t        set_board_state(game, 0, battlefield=[card])\n147\t        card.register_triggers(game)\n148\t        return game, p1, card\n149\t\n150\t    def test_trigger_fires_for_instant_spell_by_controller(self) -> None:\n151\t        \"\"\"An instant cast by the controller should match the casualty trigger\n152\t        condition.\"\"\"\n153\t        game, p1, sq = self._setup_silverquill_on_battlefield()\n154\t        triggers = game.trigger_manager.get_triggers_for_source(sq)\n155\t        spell_trigger = next(\n156\t            t for t in triggers\n157\t            if t.event_type is SpellCastTriggeredEvent\n158\t        )\n159\t        instant_spell = Instant(name=\"Test Bolt\", owner=p1, controller=p1)\n160\t        event = SpellCastTriggeredEvent(\n161\t            spell=instant_spell, player=p1, card=instant_spell, controller=p1\n162\t        )\n163\t        # Condition should pass for an instant cast by the controller\n164\t        if spell_trigger.condition is not None:\n165\t            assert spell_trigger.condition(game, event) is True\n166\t\n167\t    def test_trigger_fires_for_sorcery_spell_by_controller(self) -> None:\n168\t        \"\"\"A sorcery cast by the controller should match the casualty trigger\n169\t        condition.\"\"\"\n170\t        game, p1, sq = self._setup_silverquill_on_battlefield()\n171\t        triggers = game.trigger_manager.get_triggers_for_source(sq)\n172\t        spell_trigger = next(\n173\t            t for t in triggers\n174\t            if t.event_type is SpellCastTriggeredEvent\n175\t        )\n176\t        sorcery_spell = Sorcery(name=\"Test Sorcery\", owner=p1, controller=p1)\n177\t        event = SpellCastTriggeredEvent(\n178\t            spell=sorcery_spell, player=p1, card=sorcery_spell, controller=p1\n179\t        )\n180\t        if spell_trigger.condition is not None:\n181\t            assert spell_trigger.condition(game, event) is True\n182\t\n183\t    def test_trigger_does_not_fire_for_creature_spell(self) -> None:\n184\t        \"\"\"A creature spell should NOT trigger the casualty granting.\"\"\"\n185\t        game, p1, sq = self._setup_silverquill_on_battlefield()\n186\t        triggers = game.trigger_manager.get_triggers_for_source(sq)\n187\t        spell_trigger = next(\n188\t            t for t in triggers\n189\t            if t.event_type is SpellCastTriggeredEvent\n190\t        )\n191\t        creature_spell = Creature(\n192\t            name=\"Test Bear\", owner=p1, controller=p1,\n193\t            base_power=2, base_toughness=2,\n194\t        )\n195\t        event = SpellCastTriggeredEvent(\n196\t            spell=creature_spell, player=p1, card=creature_spell, controller=p1\n197\t        )\n198\t        if spell_trigger.condition is not None:\n199\t            assert spell_trigger.condition(game, event) is False\n200\t\n201\t    def test_trigger_does_not_fire_for_opponent_spell(self) -> None:\n202\t        \"\"\"An instant or sorcery cast by the opponent should NOT trigger\n203\t        the casualty granted by this Silverquill.\"\"\"\n204\t        game, p1, sq = self._setup_silverquill_on_battlefield()\n205\t        p2 = game.players[1]\n206\t        triggers = game.trigger_manager.get_triggers_for_source(sq)\n207\t        spell_trigger = next(\n208\t            t for t in triggers\n209\t            if t.event_type is SpellCastTriggeredEvent\n210\t        )\n211\t        opponent_spell = Instant(name=\"Opponent Bolt\", owner=p2, controller=p2)\n212\t        event = SpellCastTriggeredEvent(\n213\t            spell=opponent_spell, player=p2, card=opponent_spell, controller=p2\n214\t        )\n215\t        if spell_trigger.condition is not None:\n216\t            assert spell_trigger.condition(game, event) is False\n217\t\n218\t\n219\t# ---------------------------------------------------------------------------\n220\t# Casualty Effect -- sacrifice + copy\n221\t# ---------------------------------------------------------------------------\n222\t\n223\t\n224\tclass TestSilverquillCasualtyEffect:\n225\t    \"\"\"When casualty is paid (a creature with power >= 1 is sacrificed),\n226\t    the spell should be copied on the stack.  When casualty is not paid,\n227\t    no copy is created.\"\"\"\n228\t\n229\t    def _setup_with_sacrificable_creature(self):\n230\t        \"\"\"Helper: game with Silverquill and a 1/1 token on p1's battlefield.\"\"\"\n231\t        game = create_game()\n232\t        p1 = game.players[0]\n233\t        sq = SilverquillTheDisputant(owner=p1, controller=p1)\n234\t        token = Creature(\n235\t            name=\"Inkling Token\", owner=p1, controller=p1,\n236\t            base_power=1, base_toughness=1,\n237\t        )\n238\t        token.is_token = True\n239\t        set_board_state(game, 0, battlefield=[sq, token])\n240\t        sq.register_triggers(game)\n241\t        return game, p1, sq, token\n242\t\n243\t    def test_casualty_paid_creates_copy_on_stack(self) -> None:\n244\t        \"\"\"When casualty is paid (a creature with power >= 1 is sacrificed),\n245\t        the spell should be copied and put on the stack.\"\"\"\n246\t        game, p1, sq, token = self._setup_with_sacrificable_creature()\n247\t\n248\t        # Create an instant spell and put it on the stack\n249\t        bolt = Instant(name=\"Test Bolt\", owner=p1, controller=p1)\n250\t        stack_obj = StackObject(\n251\t            source=bolt, controller=p1, targets=[],\n252\t            on_resolve=lambda g: None,\n253\t        )\n254\t        game.stack.push(stack_obj)\n255\t\n256\t        # Mark that casualty was paid for this spell by sacrificing the token\n257\t        bolt._casualty_paid = True\n258\t        bolt._casualty_sacrificed = token\n259\t\n260\t        # Fire the spell-cast event\n261\t        event = SpellCastTriggeredEvent(\n262\t            spell=bolt, player=p1, card=bolt, controller=p1\n263\t        )\n264\t        stack_before = len(game.stack)\n265\t        game.trigger_manager.fire_event(game, event)\n266\t\n267\t        # The trigger should have pushed something on the stack (the copy\n268\t        # trigger or the actual copy).\n269\t        assert len(game.stack) > stack_before\n270\t\n271\t    def test_no_sacrifice_no_copy(self) -> None:\n272\t        \"\"\"When casualty is NOT paid (no creature sacrificed), the spell\n273\t        should not be copied.\n274\t\n275\t        This requires that Silverquill's trigger is actually registered\n276\t        and that the trigger or its effect correctly no-ops when casualty\n277\t        is not paid.\n278\t        \"\"\"\n279\t        game, p1, sq, token = self._setup_with_sacrificable_creature()\n280\t\n281\t        # Verify the trigger is actually registered (guards against\n282\t        # vacuous pass from stub).\n283\t        triggers = game.trigger_manager.get_triggers_for_source(sq)\n284\t        assert len(triggers) >= 1, (\n285\t            \"Silverquill must register at least one trigger for casualty\"\n286\t        )\n287\t\n288\t        bolt = Instant(name=\"Test Bolt\", owner=p1, controller=p1)\n289\t        stack_obj = StackObject(\n290\t            source=bolt, controller=p1, targets=[],\n291\t            on_resolve=lambda g: None,\n292\t        )\n293\t        game.stack.push(stack_obj)\n294\t\n295\t        # Casualty not paid -- no _casualty_paid flag\n296\t        event = SpellCastTriggeredEvent(\n297\t            spell=bolt, player=p1, card=bolt, controller=p1\n298\t        )\n299\t\n300\t        # Fire the event -- even if the trigger fires, its condition/effect\n301\t        # should check whether casualty was actually paid.\n302\t        # The trigger's condition should reject this event because casualty\n303\t        # was not paid.  If condition is None, the trigger effect itself\n304\t        # should check and be a no-op.\n305\t        stack_count_before = len(game.stack)\n306\t        game.trigger_manager.fire_event(game, event)\n307\t\n308\t        # At most the trigger itself might be pushed, but when it resolves\n309\t        # it should not add a copy if casualty wasn't paid.\n310\t        # We resolve any triggers that were pushed.\n311\t        while len(game.stack) > stack_count_before:\n312\t            obj = game.stack.pop()\n313\t            obj.on_resolve(game)\n314\t\n315\t        # No extra copies should remain on the stack\n316\t        assert len(game.stack) == stack_count_before\n317\t\n318\t\n319\t# ---------------------------------------------------------------------------\n320\t# Casualty Power Threshold\n321\t# ---------------------------------------------------------------------------\n322\t\n323\t\n324\tclass TestSilverquillCasualtyPowerThreshold:\n325\t    \"\"\"Casualty 1 requires sacrificing a creature with power 1 or greater.\n326\t    A creature with power 0 should not satisfy the casualty requirement.\"\"\"\n327\t\n328\t    def test_creature_with_power_zero_cannot_pay_casualty(self) -> None:\n329\t        \"\"\"A creature with power 0 should not be valid for casualty 1.\"\"\"\n330\t        game = create_game()\n331\t        p1 = game.players[0]\n332\t        sq = SilverquillTheDisputant(owner=p1, controller=p1)\n333\t        zero_power = Creature(\n334\t            name=\"Zero Token\", owner=p1, controller=p1,\n335\t            base_power=0, base_toughness=1,\n336\t        )\n337\t        set_board_state(game, 0, battlefield=[sq, zero_power])\n338\t        sq.register_triggers(game)\n339\t\n340\t        # The implementation should expose some way to validate casualty\n341\t        # eligibility. The creature with power 0 should not be acceptable\n342\t        # for casualty 1.  This tests the card's casualty validation logic.\n343\t        # If the card uses a helper method, attribute, or checks in the\n344\t        # trigger condition, we verify a power-0 creature is rejected.\n345\t        can_pay = getattr(sq, \"can_pay_casualty\", None)\n346\t        if can_pay is not None:\n347\t            assert can_pay(game, zero_power) is False\n348\t        else:\n349\t            # Alternative: check that the casualty N value is set to 1\n350\t            casualty_n = getattr(sq, \"casualty_n\", None)\n351\t            assert casualty_n == 1\n352\t\n353\t    def test_creature_with_power_one_can_pay_casualty(self) -> None:\n354\t        \"\"\"A creature with power exactly 1 should be valid for casualty 1.\"\"\"\n355\t        game = create_game()\n356\t        p1 = game.players[0]\n357\t        sq = SilverquillTheDisputant(owner=p1, controller=p1)\n358\t        one_power = Creature(\n359\t            name=\"Token\", owner=p1, controller=p1,\n360\t            base_power=1, base_toughness=1,\n361\t        )\n362\t        set_board_state(game, 0, battlefield=[sq, one_power])\n363\t        sq.register_triggers(game)\n364\t\n365\t        can_pay = getattr(sq, \"can_pay_casualty\", None)\n366\t        if can_pay is not None:\n367\t            assert can_pay(game, one_power) is True\n368\t        else:\n369\t            casualty_n = getattr(sq, \"casualty_n\", None)\n370\t            assert casualty_n == 1\n371\t\n372\t    def test_creature_with_power_greater_than_one_can_pay_casualty(self) -> None:\n373\t        \"\"\"A creature with power > 1 should be valid for casualty 1.\"\"\"\n374\t        game = create_game()\n375\t        p1 = game.players[0]\n376\t        sq = SilverquillTheDisputant(owner=p1, controller=p1)\n377\t        big_creature = Creature(\n378\t            name=\"Big Bear\", owner=p1, controller=p1,\n379\t            base_power=5, base_toughness=5,\n380\t        )\n381\t        set_board_state(game, 0, battlefield=[sq, big_creature])\n382\t        sq.register_triggers(game)\n383\t\n384\t        can_pay = getattr(sq, \"can_pay_casualty\", None)\n385\t        if can_pay is not None:\n386\t            assert can_pay(game, big_creature) is True\n387\t        else:\n388\t            casualty_n = getattr(sq, \"casualty_n\", None)\n389\t            assert casualty_n == 1\n390\t\n391\t\n392\t# ---------------------------------------------------------------------------\n393\t# Casualty sacrificed creature goes to graveyard\n394\t# ---------------------------------------------------------------------------\n395\t\n396\t\n397\tclass TestSilverquillCasualtySacrifice:\n398\t    \"\"\"When a creature is sacrificed for casualty, it should be moved to\n399\t    the graveyard (i.e., it is no longer on the battlefield).\"\"\"\n400\t\n401\t    def test_sacrificed_creature_leaves_battlefield(self) -> None:\n402\t        \"\"\"The creature sacrificed to pay casualty should no longer be\n403\t        on the battlefield after the sacrifice.\"\"\"\n404\t        game = create_game()\n405\t        p1 = game.players[0]\n406\t        sq = SilverquillTheDisputant(owner=p1, controller=p1)\n407\t        token = Creature(\n408\t            name=\"Sac Target\", owner=p1, controller=p1,\n409\t            base_power=2, base_toughness=2,\n410\t        )\n411\t        set_board_state(game, 0, battlefield=[sq, token])\n412\t        sq.register_triggers(game)\n413\t\n414\t        # Put an instant on the stack and simulate casualty payment\n415\t        bolt = Instant(name=\"Test Bolt\", owner=p1, controller=p1)\n416\t        bolt._casualty_paid = True\n417\t        bolt._casualty_sacrificed = token\n418\t\n419\t        stack_obj = StackObject(\n420\t            source=bolt, controller=p1, targets=[],\n421\t            on_resolve=lambda g: None,\n422\t        )\n423\t        game.stack.push(stack_obj)\n424\t\n425\t        event = SpellCastTriggeredEvent(\n426\t            spell=bolt, player=p1, card=bolt, controller=p1\n427\t        )\n428\t        game.trigger_manager.fire_event(game, event)\n429\t\n430\t        # Resolve any trigger effects\n431\t        while len(game.stack) > 1:\n432\t            obj = game.stack.pop()\n433\t            obj.on_resolve(game)\n434\t\n435\t        # The token should have been sacrificed (moved to graveyard)\n436\t        bf = game.get_battlefield(p1)\n437\t        bf_names = [getattr(c, \"name\", \"\") for c in bf.get_all()]\n438\t        # Token should NOT be on the battlefield after casualty payment\n439\t        # (it was either sacrificed as part of the trigger effect or\n440\t        # as part of the casting cost).  The exact mechanism depends on\n441\t        # implementation but the token must leave the battlefield.\n442\t        assert \"Sac Target\" not in bf_names or token not in bf.get_all()\n443\t\n444\t\n445\t# ---------------------------------------------------------------------------\n446\t# Edge: Silverquill leaves battlefield -- triggers unregistered\n447\t# ---------------------------------------------------------------------------\n448\t\n449\t\n450\tclass TestSilverquillLeavesPlay:\n451\t    \"\"\"When Silverquill leaves the battlefield, its triggers should be\n452\t    unregistered so that subsequent instant/sorcery casts do NOT get\n453\t    casualty 1.\"\"\"\n454\t\n455\t    def test_triggers_unregistered_on_leave(self) -> None:\n456\t        \"\"\"After Silverquill leaves the battlefield, no triggers from it\n457\t        should remain in the trigger manager.\"\"\"\n458\t        game = create_game()\n459\t        p1 = game.players[0]\n460\t        sq = SilverquillTheDisputant(owner=p1, controller=p1)\n461\t        set_board_state(game, 0, battlefield=[sq])\n462\t        sq.register_triggers(game)\n463\t\n464\t        # Verify triggers exist\n465\t        assert len(game.trigger_manager.get_triggers_for_source(sq)) >= 1\n466\t\n467\t        # Now unregister (as would happen when the creature leaves)\n468\t        game.trigger_manager.unregister(sq)\n469\t\n470\t        # Triggers should be gone\n471\t        assert len(game.trigger_manager.get_triggers_for_source(sq)) == 0\n472\t"}]},"parent_tool_use_id":"toolu_01BR2UP9tdVW1CTKcxECQaLo","session_id":"61c1c383-66ff-4b43-bc55-e6e3182b632f","uuid":"16f9b581-ec89-44fa-bdd8-d3d234fff148","timestamp":"2026-05-28T12:14:06.950Z","subagent_type":"Implementer","task_description":"Revise sos_226 per review"}
