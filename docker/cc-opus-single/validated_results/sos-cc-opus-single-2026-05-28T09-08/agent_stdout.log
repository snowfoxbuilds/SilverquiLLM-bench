{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017fxTRENBXzMBsakmaQmQrW","type":"tool_result","content":"1\t\"\"\"Tests for SOS 257 — Great Hall of the Biblioplex.\n2\t\n3\tGreat Hall of the Biblioplex is a Land with three abilities:\n4\t1. {T}: Add {C}.\n5\t2. {T}, Pay 1 life: Add one mana of any color. Spend this mana only to\n6\t   cast an instant or sorcery spell.\n7\t3. {5}: If this land isn't a creature, it becomes a 2/4 Wizard creature\n8\t   with \"Whenever you cast an instant or sorcery spell, this creature\n9\t   gets +1/+0 until end of turn.\" It's still a land.\n10\t\"\"\"\n11\t\n12\tfrom __future__ import annotations\n13\t\n14\timport pytest\n15\t\n16\tfrom cards.sos.sos_257.card_impl import GreatHallOfTheBiblioplex\n17\tfrom engine.card import ActivatedAbility, Land, ManaAbility\n18\tfrom engine.events import SpellCastTriggeredEvent\n19\tfrom engine.triggers import TriggerRegistration\n20\tfrom engine.types import CardType, Keyword, ManaCost, ManaType, Zone\n21\tfrom test_utils import create_game, set_board_state\n22\t\n23\t\n24\t# ---------------------------------------------------------------------------\n25\t# Static properties\n26\t# ---------------------------------------------------------------------------\n27\t\n28\t\n29\tclass TestGreatHallProperties:\n30\t    \"\"\"Static card data should match the SOS 257 spec.\"\"\"\n31\t\n32\t    def test_is_land(self) -> None:\n33\t        card = GreatHallOfTheBiblioplex(owner=None)\n34\t        assert isinstance(card, Land)\n35\t\n36\t    def test_name(self) -> None:\n37\t        card = GreatHallOfTheBiblioplex(owner=None)\n38\t        assert card.name == \"Great Hall of the Biblioplex\"\n39\t\n40\t    def test_card_type_land(self) -> None:\n41\t        card = GreatHallOfTheBiblioplex(owner=None)\n42\t        assert CardType.LAND in card.card_types\n43\t\n44\t    def test_no_mana_cost(self) -> None:\n45\t        \"\"\"Lands have no mana cost.\"\"\"\n46\t        card = GreatHallOfTheBiblioplex(owner=None)\n47\t        assert card.mana_cost == ManaCost()\n48\t\n49\t    def test_cannot_be_cast(self) -> None:\n50\t        \"\"\"Lands cannot be cast (they are played as a special action).\"\"\"\n51\t        game = create_game()\n52\t        card = GreatHallOfTheBiblioplex(owner=game.players[0])\n53\t        assert card.can_cast(game) is False\n54\t\n55\t\n56\t# ---------------------------------------------------------------------------\n57\t# Mana ability 1: {T}: Add {C}\n58\t# ---------------------------------------------------------------------------\n59\t\n60\t\n61\tclass TestColorlessManaAbility:\n62\t    \"\"\"The first mana ability taps for one colorless mana.\"\"\"\n63\t\n64\t    def test_has_colorless_mana_ability(self) -> None:\n65\t        \"\"\"get_mana_abilities should include a {T}: Add {C} ability.\"\"\"\n66\t        card = GreatHallOfTheBiblioplex(owner=None)\n67\t        abilities = card.get_mana_abilities()\n68\t        assert len(abilities) >= 1\n69\t        assert any(isinstance(a, ManaAbility) for a in abilities)\n70\t\n71\t    def test_colorless_ability_taps_land(self) -> None:\n72\t        \"\"\"Activating the colorless mana ability should tap the land.\"\"\"\n73\t        game = create_game()\n74\t        p1 = game.players[0]\n75\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n76\t        card.is_tapped = False\n77\t        game.get_battlefield(p1).add(card)\n78\t\n79\t        abilities = card.get_mana_abilities()\n80\t        # Find the colorless ability (first one)\n81\t        colorless_ability = abilities[0]\n82\t        # Pay cost: should tap the land\n83\t        result = colorless_ability.cost(game, card)\n84\t        assert result is True\n85\t        assert card.is_tapped is True\n86\t\n87\t    def test_colorless_ability_adds_colorless_mana(self) -> None:\n88\t        \"\"\"The colorless mana ability should add {C} to the controller's pool.\"\"\"\n89\t        game = create_game()\n90\t        p1 = game.players[0]\n91\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n92\t        card.is_tapped = False\n93\t        game.get_battlefield(p1).add(card)\n94\t\n95\t        abilities = card.get_mana_abilities()\n96\t        colorless_ability = abilities[0]\n97\t        # Pay cost\n98\t        colorless_ability.cost(game, card)\n99\t        # Produce mana\n100\t        colorless_ability.mana_produced(game)\n101\t        assert p1.mana_pool.get(ManaType.COLORLESS) >= 1\n102\t\n103\t    def test_colorless_ability_fails_when_tapped(self) -> None:\n104\t        \"\"\"Cannot activate if the land is already tapped.\"\"\"\n105\t        game = create_game()\n106\t        p1 = game.players[0]\n107\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n108\t        card.is_tapped = True\n109\t        game.get_battlefield(p1).add(card)\n110\t\n111\t        abilities = card.get_mana_abilities()\n112\t        colorless_ability = abilities[0]\n113\t        result = colorless_ability.cost(game, card)\n114\t        assert result is False\n115\t\n116\t\n117\t# ---------------------------------------------------------------------------\n118\t# Mana ability 2: {T}, Pay 1 life: Add one mana of any color.\n119\t# ---------------------------------------------------------------------------\n120\t\n121\t\n122\tclass TestAnyColorManaAbility:\n123\t    \"\"\"The second mana ability taps and pays 1 life for any color mana.\"\"\"\n124\t\n125\t    def test_has_any_color_mana_ability(self) -> None:\n126\t        \"\"\"get_mana_abilities should include a second ability for any color.\"\"\"\n127\t        card = GreatHallOfTheBiblioplex(owner=None)\n128\t        abilities = card.get_mana_abilities()\n129\t        assert len(abilities) >= 2\n130\t\n131\t    def test_any_color_ability_taps_and_pays_life(self) -> None:\n132\t        \"\"\"Activating the any-color ability should tap the land and cost 1 life.\"\"\"\n133\t        game = create_game()\n134\t        p1 = game.players[0]\n135\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n136\t        card.is_tapped = False\n137\t        game.get_battlefield(p1).add(card)\n138\t        starting_life = p1.life\n139\t\n140\t        abilities = card.get_mana_abilities()\n141\t        any_color_ability = abilities[1]\n142\t        result = any_color_ability.cost(game, card)\n143\t        assert result is True\n144\t        assert card.is_tapped is True\n145\t        assert p1.life == starting_life - 1\n146\t\n147\t    def test_any_color_ability_produces_colored_mana(self) -> None:\n148\t        \"\"\"The any-color ability should add one mana of a chosen color.\"\"\"\n149\t        game = create_game()\n150\t        p1 = game.players[0]\n151\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n152\t        card.is_tapped = False\n153\t        game.get_battlefield(p1).add(card)\n154\t\n155\t        abilities = card.get_mana_abilities()\n156\t        any_color_ability = abilities[1]\n157\t        any_color_ability.cost(game, card)\n158\t        # Produce mana (the player chooses a color)\n159\t        any_color_ability.mana_produced(game)\n160\t        # At least one colored mana should have been added\n161\t        total = p1.mana_pool.total()\n162\t        assert total >= 1\n163\t\n164\t    def test_any_color_ability_fails_when_tapped(self) -> None:\n165\t        \"\"\"Cannot activate if the land is already tapped.\"\"\"\n166\t        game = create_game()\n167\t        p1 = game.players[0]\n168\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n169\t        card.is_tapped = True\n170\t        game.get_battlefield(p1).add(card)\n171\t\n172\t        abilities = card.get_mana_abilities()\n173\t        any_color_ability = abilities[1]\n174\t        result = any_color_ability.cost(game, card)\n175\t        assert result is False\n176\t\n177\t\n178\t# ---------------------------------------------------------------------------\n179\t# Activated ability: {5}: Animate to 2/4 Wizard creature\n180\t# ---------------------------------------------------------------------------\n181\t\n182\t\n183\tclass TestAnimateAbility:\n184\t    \"\"\"The {5} ability turns the land into a 2/4 Wizard creature (still a land).\"\"\"\n185\t\n186\t    def test_has_activated_ability(self) -> None:\n187\t        \"\"\"get_activated_abilities should include the animate ability.\"\"\"\n188\t        card = GreatHallOfTheBiblioplex(owner=None)\n189\t        abilities = card.get_activated_abilities()\n190\t        assert len(abilities) >= 1\n191\t        assert any(isinstance(a, ActivatedAbility) for a in abilities)\n192\t\n193\t    def test_animate_makes_creature(self) -> None:\n194\t        \"\"\"After activation, the land should have the CREATURE card type.\"\"\"\n195\t        game = create_game()\n196\t        p1 = game.players[0]\n197\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n198\t        card.is_tapped = False\n199\t        game.get_battlefield(p1).add(card)\n200\t        set_board_state(game, 0, mana={ManaType.COLORLESS: 5})\n201\t\n202\t        abilities = card.get_activated_abilities()\n203\t        animate_ability = abilities[0]\n204\t        animate_ability.cost(game, card)\n205\t        animate_ability.effect(game)\n206\t\n207\t        assert CardType.CREATURE in card.card_types\n208\t\n209\t    def test_animate_still_land(self) -> None:\n210\t        \"\"\"After animation, the card should still be a land.\"\"\"\n211\t        game = create_game()\n212\t        p1 = game.players[0]\n213\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n214\t        card.is_tapped = False\n215\t        game.get_battlefield(p1).add(card)\n216\t        set_board_state(game, 0, mana={ManaType.COLORLESS: 5})\n217\t\n218\t        abilities = card.get_activated_abilities()\n219\t        animate_ability = abilities[0]\n220\t        animate_ability.cost(game, card)\n221\t        animate_ability.effect(game)\n222\t\n223\t        assert CardType.LAND in card.card_types\n224\t\n225\t    def test_animate_power_toughness(self) -> None:\n226\t        \"\"\"Animated land should be a 2/4.\"\"\"\n227\t        game = create_game()\n228\t        p1 = game.players[0]\n229\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n230\t        card.is_tapped = False\n231\t        game.get_battlefield(p1).add(card)\n232\t        set_board_state(game, 0, mana={ManaType.COLORLESS: 5})\n233\t\n234\t        abilities = card.get_activated_abilities()\n235\t        animate_ability = abilities[0]\n236\t        animate_ability.cost(game, card)\n237\t        animate_ability.effect(game)\n238\t\n239\t        assert card.base_power == 2 or getattr(card, \"power\", None) == 2\n240\t        assert card.base_toughness == 4 or getattr(card, \"toughness\", None) == 4\n241\t\n242\t    def test_animate_wizard_subtype(self) -> None:\n243\t        \"\"\"Animated land should have the Wizard subtype.\"\"\"\n244\t        game = create_game()\n245\t        p1 = game.players[0]\n246\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n247\t        card.is_tapped = False\n248\t        game.get_battlefield(p1).add(card)\n249\t        set_board_state(game, 0, mana={ManaType.COLORLESS: 5})\n250\t\n251\t        abilities = card.get_activated_abilities()\n252\t        animate_ability = abilities[0]\n253\t        animate_ability.cost(game, card)\n254\t        animate_ability.effect(game)\n255\t\n256\t        assert \"Wizard\" in card.subtypes\n257\t\n258\t    def test_animate_does_nothing_if_already_creature(self) -> None:\n259\t        \"\"\"If the land is already a creature, the ability should not re-animate.\"\"\"\n260\t        game = create_game()\n261\t        p1 = game.players[0]\n262\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n263\t        card.is_tapped = False\n264\t        game.get_battlefield(p1).add(card)\n265\t        set_board_state(game, 0, mana={ManaType.COLORLESS: 10})\n266\t\n267\t        abilities = card.get_activated_abilities()\n268\t        animate_ability = abilities[0]\n269\t\n270\t        # Animate the first time\n271\t        animate_ability.cost(game, card)\n272\t        animate_ability.effect(game)\n273\t        assert CardType.CREATURE in card.card_types\n274\t\n275\t        # Pre-set creature card type - try to animate again\n276\t        # The \"if this land isn't a creature\" condition should prevent changes\n277\t        p1.mana_pool.add(ManaType.COLORLESS, 5)\n278\t        power_before = getattr(card, \"base_power\", None) or getattr(card, \"power\", None)\n279\t        animate_ability.cost(game, card)\n280\t        animate_ability.effect(game)\n281\t        power_after = getattr(card, \"base_power\", None) or getattr(card, \"power\", None)\n282\t        # Should remain the same\n283\t        assert power_after == power_before\n284\t\n285\t\n286\t# ---------------------------------------------------------------------------\n287\t# Triggered ability: Whenever you cast an instant or sorcery spell,\n288\t# this creature gets +1/+0 until end of turn\n289\t# ---------------------------------------------------------------------------\n290\t\n291\t\n292\tclass TestAnimateTriggeredAbility:\n293\t    \"\"\"After animation, casting an instant or sorcery gives +1/+0.\"\"\"\n294\t\n295\t    def _animate_card(self, game, card):\n296\t        \"\"\"Helper to activate the animate ability.\"\"\"\n297\t        abilities = card.get_activated_abilities()\n298\t        animate_ability = abilities[0]\n299\t        animate_ability.cost(game, card)\n300\t        animate_ability.effect(game)\n301\t\n302\t    def test_animate_registers_trigger(self) -> None:\n303\t        \"\"\"After animation, a SpellCastTriggeredEvent trigger should be registered.\"\"\"\n304\t        game = create_game()\n305\t        p1 = game.players[0]\n306\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n307\t        card.is_tapped = False\n308\t        game.get_battlefield(p1).add(card)\n309\t        set_board_state(game, 0, mana={ManaType.COLORLESS: 5})\n310\t\n311\t        self._animate_card(game, card)\n312\t\n313\t        # Check that a trigger for SpellCastTriggeredEvent is registered\n314\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n315\t        spell_cast_triggers = [\n316\t            t for t in triggers\n317\t            if t.event_type is SpellCastTriggeredEvent\n318\t        ]\n319\t        assert len(spell_cast_triggers) >= 1\n320\t\n321\t    def test_trigger_fires_for_instant(self) -> None:\n322\t        \"\"\"Casting an instant should fire the trigger and grant +1/+0.\"\"\"\n323\t        game = create_game()\n324\t        p1 = game.players[0]\n325\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n326\t        card.is_tapped = False\n327\t        game.get_battlefield(p1).add(card)\n328\t        set_board_state(game, 0, mana={ManaType.COLORLESS: 5})\n329\t\n330\t        self._animate_card(game, card)\n331\t        base_power = getattr(card, \"power\", None) or getattr(card, \"base_power\", 2)\n332\t\n333\t        # Simulate casting an instant by firing the event\n334\t        from engine.card import Instant\n335\t        spell = Instant(name=\"Test Instant\", owner=p1, controller=p1)\n336\t        event = SpellCastTriggeredEvent(\n337\t            spell=spell, player=p1, card=spell, controller=p1\n338\t        )\n339\t        game.trigger_manager.fire_event(game, event)\n340\t\n341\t        # The trigger should push something onto the stack\n342\t        assert len(game.stack) >= 1\n343\t\n344\t        # Resolve the trigger\n345\t        stack_obj = game.stack.pop()\n346\t        stack_obj.on_resolve(game)\n347\t\n348\t        # Card should have +1/+0\n349\t        new_power = getattr(card, \"power\", None) or getattr(card, \"modified_power\", None)\n350\t        assert new_power is not None\n351\t        assert new_power >= base_power + 1\n352\t\n353\t    def test_trigger_fires_for_sorcery(self) -> None:\n354\t        \"\"\"Casting a sorcery should also fire the trigger.\"\"\"\n355\t        game = create_game()\n356\t        p1 = game.players[0]\n357\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n358\t        card.is_tapped = False\n359\t        game.get_battlefield(p1).add(card)\n360\t        set_board_state(game, 0, mana={ManaType.COLORLESS: 5})\n361\t\n362\t        self._animate_card(game, card)\n363\t        base_power = getattr(card, \"power\", None) or getattr(card, \"base_power\", 2)\n364\t\n365\t        from engine.card import Sorcery\n366\t        spell = Sorcery(name=\"Test Sorcery\", owner=p1, controller=p1)\n367\t        event = SpellCastTriggeredEvent(\n368\t            spell=spell, player=p1, card=spell, controller=p1\n369\t        )\n370\t        game.trigger_manager.fire_event(game, event)\n371\t\n372\t        assert len(game.stack) >= 1\n373\t        stack_obj = game.stack.pop()\n374\t        stack_obj.on_resolve(game)\n375\t\n376\t        new_power = getattr(card, \"power\", None) or getattr(card, \"modified_power\", None)\n377\t        assert new_power is not None\n378\t        assert new_power >= base_power + 1\n379\t\n380\t    def test_trigger_does_not_fire_for_creature_spell(self) -> None:\n381\t        \"\"\"Casting a creature spell should NOT fire the trigger.\"\"\"\n382\t        game = create_game()\n383\t        p1 = game.players[0]\n384\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n385\t        card.is_tapped = False\n386\t        game.get_battlefield(p1).add(card)\n387\t        set_board_state(game, 0, mana={ManaType.COLORLESS: 5})\n388\t\n389\t        self._animate_card(game, card)\n390\t\n391\t        from engine.card import Creature\n392\t        creature_spell = Creature(\n393\t            name=\"Test Creature\", owner=p1, controller=p1,\n394\t            base_power=2, base_toughness=2\n395\t        )\n396\t        event = SpellCastTriggeredEvent(\n397\t            spell=creature_spell, player=p1, card=creature_spell, controller=p1\n398\t        )\n399\t        stack_len_before = len(game.stack)\n400\t        game.trigger_manager.fire_event(game, event)\n401\t        # No new stack object for the creature spell\n402\t        assert len(game.stack) == stack_len_before\n403\t\n404\t    def test_trigger_stacks_multiple_casts(self) -> None:\n405\t        \"\"\"Multiple instant/sorcery casts should each give +1/+0.\"\"\"\n406\t        game = create_game()\n407\t        p1 = game.players[0]\n408\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n409\t        card.is_tapped = False\n410\t        game.get_battlefield(p1).add(card)\n411\t        set_board_state(game, 0, mana={ManaType.COLORLESS: 5})\n412\t\n413\t        self._animate_card(game, card)\n414\t        base_power = getattr(card, \"power\", None) or getattr(card, \"base_power\", 2)\n415\t\n416\t        from engine.card import Instant\n417\t        # Cast two instants\n418\t        for i in range(2):\n419\t            spell = Instant(name=f\"Test Instant {i}\", owner=p1, controller=p1)\n420\t            event = SpellCastTriggeredEvent(\n421\t                spell=spell, player=p1, card=spell, controller=p1\n422\t            )\n423\t            game.trigger_manager.fire_event(game, event)\n424\t            stack_obj = game.stack.pop()\n425\t            stack_obj.on_resolve(game)\n426\t\n427\t        new_power = getattr(card, \"power\", None) or getattr(card, \"modified_power\", None)\n428\t        assert new_power is not None\n429\t        assert new_power >= base_power + 2\n430\t\n431\t    def test_trigger_only_fires_for_controllers_spells(self) -> None:\n432\t        \"\"\"The trigger should only fire for spells cast by the land's controller.\"\"\"\n433\t        game = create_game()\n434\t        p1 = game.players[0]\n435\t        p2 = game.players[1]\n436\t        card = GreatHallOfTheBiblioplex(owner=p1, controller=p1)\n437\t        card.is_tapped = False\n438\t        game.get_battlefield(p1).add(card)\n439\t        set_board_state(game, 0, mana={ManaType.COLORLESS: 5})\n440\t\n441\t        self._animate_card(game, card)\n442\t\n443\t        from engine.card import Instant\n444\t        # Opponent casts a spell\n445\t        opponent_spell = Instant(name=\"Opponent Spell\", owner=p2, controller=p2)\n446\t        event = SpellCastTriggeredEvent(\n447\t            spell=opponent_spell, player=p2, card=opponent_spell, controller=p2\n448\t        )\n449\t        stack_len_before = len(game.stack)\n450\t        game.trigger_manager.fire_event(game, event)\n451\t        # Should not fire for opponent's spell\n452\t        assert len(game.stack) == stack_len_before\n453\t"}]},"parent_tool_use_id":"toolu_01NknuYhrT6SeWVSra9VpGbd","session_id":"1fe34661-6a3c-4b16-8a42-0f618466dfcb","uuid":"c6820310-15b5-4e42-88f2-c68aee5d3dca","timestamp":"2026-05-28T10:40:36.834Z","subagent_type":"Implementer","task_description":"Revise sos_257 per review"}
