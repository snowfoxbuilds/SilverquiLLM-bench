{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Gxs5ELxzPPWhKYVcmYn9G3","type":"tool_result","content":"1\t\"\"\"Card implementation for Mana Sculpt.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Instant\n8\tfrom engine.triggers import TriggerRegistration\n9\tfrom engine.events import TriggeredEvent\n10\tfrom engine.types import CardType, ManaCost, ManaType, TargetRequirement, Zone\n11\t\n12\tif TYPE_CHECKING:\n13\t    from engine.game_state import GameState\n14\t\n15\t\n16\tclass ManaSculpt(Instant):\n17\t    \"\"\"Mana Sculpt -- {1}{U}{U} -- Instant.\n18\t\n19\t    Counter target spell. If you control a Wizard, add an amount of {C}\n20\t    equal to the amount of mana spent to cast that spell at the beginning\n21\t    of your next main phase.\n22\t\n23\t    SOS collector number 57.\n24\t    \"\"\"\n25\t\n26\t    def __init__(self, **kwargs: Any) -> None:\n27\t        kwargs.setdefault(\"name\", \"Mana Sculpt\")\n28\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{U}{U}\"))\n29\t        kwargs.setdefault(\n30\t            \"rules_text\",\n31\t            \"Counter target spell. If you control a Wizard, add an amount \"\n32\t            \"of {C} equal to the amount of mana spent to cast that spell \"\n33\t            \"at the beginning of your next main phase.\",\n34\t        )\n35\t        super().__init__(**kwargs)\n36\t\n37\t    # ------------------------------------------------------------------\n38\t    # Targeting -- target spell on the stack\n39\t    # ------------------------------------------------------------------\n40\t\n41\t    def get_targets(self, game: \"GameState\") -> list[Any]:\n42\t        \"\"\"Target a spell (any object on the stack).\"\"\"\n43\t        return [\n44\t            TargetRequirement(\n45\t                filter_fn=lambda obj: True,\n46\t                description=\"target spell\",\n47\t                zone=Zone.STACK,\n48\t            )\n49\t        ]\n50\t\n51\t    # ------------------------------------------------------------------\n52\t    # Resolution\n53\t    # ------------------------------------------------------------------\n54\t\n55\t    def on_resolve(self, game: \"GameState\") -> None:\n56\t        \"\"\"Counter the target spell; if we control a Wizard, set up a\n57\t        delayed trigger for a mana rebate of {C} equal to the countered\n58\t        spell's CMC.\"\"\"\n59\t        chosen = getattr(self, \"chosen_targets\", None)\n60\t        if not chosen:\n61\t            return\n62\t\n63\t        target_spell = chosen[0]\n64\t        if target_spell is None:\n65\t            return\n66\t\n67\t        controller = self.controller if self.controller is not None else self.owner\n68\t        if controller is None:\n69\t            return\n70\t\n71\t        # Capture mana spent (CMC of the countered spell) before moving it\n72\t        mana_spent = getattr(target_spell, \"mana_cost\", None)\n73\t        rebate_amount = mana_spent.cmc if mana_spent is not None else 0\n74\t\n75\t        # Counter the spell: move it from the stack zone to its owner's graveyard\n76\t        spell_owner = getattr(target_spell, \"owner\", None)\n77\t        if spell_owner is not None:\n78\t            # Remove from the stack zone\n79\t            if spell_owner.zones[Zone.STACK].contains(target_spell):\n80\t                spell_owner.zones[Zone.STACK].remove(target_spell)\n81\t            # Put into the owner's graveyard\n82\t            spell_owner.zones[Zone.GRAVEYARD].add(target_spell)\n83\t\n84\t        # Check if the controller controls a Wizard\n85\t        if not self._controls_wizard(game, controller):\n86\t            return\n87\t\n88\t        # Register a delayed trigger for the mana rebate\n89\t        source = self\n90\t        amount = rebate_amount\n91\t\n92\t        def _effect(game: \"GameState\") -> None:\n93\t            \"\"\"Add {C} equal to the countered spell's CMC to the controller's pool.\"\"\"\n94\t            if amount > 0:\n95\t                controller.mana_pool.add(ManaType.COLORLESS, amount)\n96\t\n97\t        trigger = TriggerRegistration(\n98\t            event_type=TriggeredEvent,\n99\t            condition=None,\n100\t            effect=_effect,\n101\t            source=source,\n102\t            controller=controller,\n103\t        )\n104\t        game.trigger_manager.register(trigger)\n105\t\n106\t    # ------------------------------------------------------------------\n107\t    # Helpers\n108\t    # ------------------------------------------------------------------\n109\t\n110\t    @staticmethod\n111\t    def _controls_wizard(game: \"GameState\", player: Any) -> bool:\n112\t        \"\"\"Return True if *player* controls a permanent with the Wizard subtype.\"\"\"\n113\t        battlefield = game.get_battlefield(player)\n114\t        for obj in battlefield.get_all():\n115\t            subtypes = getattr(obj, \"subtypes\", set())\n116\t            if \"Wizard\" in subtypes:\n117\t                return True\n118\t        return False\n119\t"}]},"parent_tool_use_id":"toolu_014ZpL5s6be1noWnejL4M88x","session_id":"1fe34661-6a3c-4b16-8a42-0f618466dfcb","uuid":"2b6fe5a0-fe90-4da3-8cfb-1b6e79ea09fc","timestamp":"2026-05-28T09:44:01.911Z","subagent_type":"Reviewer","task_description":"Review sos_57 implementation"}
