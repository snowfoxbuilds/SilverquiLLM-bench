{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Kq3mTt1RsVMy5ZNhBgSwrD","type":"tool_result","content":"1\t\"\"\"Tests for SOS 57 — Mana Sculpt.\n2\t\n3\tMana Sculpt is a {1}{U}{U} Instant:\n4\t  Counter target spell. If you control a Wizard, add an amount of {C}\n5\t  equal to the amount of mana spent to cast that spell at the beginning\n6\t  of your next main phase.\n7\t\n8\tRequirements tested:\n9\t1. Static properties: name, mana cost, card type (Instant).\n10\t2. Targeting: targets a spell on the stack.\n11\t3. Counter effect: on_resolve counters (removes from stack) the targeted spell.\n12\t4. Wizard conditional: checks if controller has a Wizard on the battlefield.\n13\t5. Mana rebate: delayed trigger adds {C} equal to mana spent on the countered\n14\t   spell at the beginning of the controller's next main phase.\n15\t6. Edge cases: no Wizard means no mana rebate; no target is a no-op;\n16\t   countered spell goes to its owner's graveyard.\n17\t\"\"\"\n18\t\n19\tfrom __future__ import annotations\n20\t\n21\tfrom cards.sos.sos_57.card_impl import ManaSculpt\n22\tfrom engine.card import Creature, Instant, Sorcery\n23\tfrom engine.stack import StackObject\n24\tfrom engine.types import (\n25\t    CardType,\n26\t    Keyword,\n27\t    ManaCost,\n28\t    ManaType,\n29\t    TargetRequirement,\n30\t    Zone,\n31\t)\n32\tfrom test_utils import create_game, set_board_state\n33\t\n34\t\n35\t# ---------------------------------------------------------------------------\n36\t# Helpers\n37\t# ---------------------------------------------------------------------------\n38\t\n39\tdef _make_wizard(owner=None, controller=None):\n40\t    \"\"\"Create a simple Wizard creature for testing the Wizard condition.\"\"\"\n41\t    wiz = Creature(\n42\t        name=\"Test Wizard\",\n43\t        owner=owner,\n44\t        controller=controller,\n45\t        base_power=1,\n46\t        base_toughness=1,\n47\t        subtypes={\"Human\", \"Wizard\"},\n48\t    )\n49\t    return wiz\n50\t\n51\t\n52\tdef _make_spell_on_stack(game, player, name=\"Target Spell\", mana_cost_str=\"{2}{R}\"):\n53\t    \"\"\"Create a dummy Instant, place it on the stack, and return a StackObject\n54\t    representing it.  The card's mana_cost.cmc represents total mana spent.\"\"\"\n55\t    spell_card = Instant(\n56\t        name=name,\n57\t        owner=player,\n58\t        controller=player,\n59\t        mana_cost=ManaCost.parse(mana_cost_str),\n60\t    )\n61\t    # Simulate being on the stack\n62\t    player.zones[Zone.STACK].add(spell_card)\n63\t    stack_obj = StackObject(\n64\t        source=spell_card,\n65\t        controller=player,\n66\t        targets=[],\n67\t        on_resolve=lambda g: None,\n68\t    )\n69\t    game.stack.push(stack_obj)\n70\t    return spell_card, stack_obj\n71\t\n72\t\n73\t# ---------------------------------------------------------------------------\n74\t# Static properties\n75\t# ---------------------------------------------------------------------------\n76\t\n77\t\n78\tclass TestManaSculptProperties:\n79\t    \"\"\"Static card data should match the SOS 57 spec.\"\"\"\n80\t\n81\t    def test_is_instant(self) -> None:\n82\t        card = ManaSculpt(owner=None)\n83\t        assert isinstance(card, Instant)\n84\t\n85\t    def test_name(self) -> None:\n86\t        card = ManaSculpt(owner=None)\n87\t        assert card.name == \"Mana Sculpt\"\n88\t\n89\t    def test_mana_cost(self) -> None:\n90\t        card = ManaSculpt(owner=None)\n91\t        assert card.mana_cost == ManaCost.parse(\"{1}{U}{U}\")\n92\t\n93\t    def test_has_instant_card_type(self) -> None:\n94\t        card = ManaSculpt(owner=None)\n95\t        assert CardType.INSTANT in card.card_types\n96\t\n97\t\n98\t# ---------------------------------------------------------------------------\n99\t# Targeting\n100\t# ---------------------------------------------------------------------------\n101\t\n102\t\n103\tclass TestManaSculptTargeting:\n104\t    \"\"\"get_targets() should advertise a single target requirement that\n105\t    targets a spell (an object on the stack).\"\"\"\n106\t\n107\t    def test_returns_at_least_one_target_requirement(self) -> None:\n108\t        game = create_game()\n109\t        card = ManaSculpt(owner=None)\n110\t        reqs = card.get_targets(game)\n111\t        assert isinstance(reqs, list)\n112\t        assert len(reqs) >= 1\n113\t\n114\t    def test_target_requirement_is_target_requirement_type(self) -> None:\n115\t        game = create_game()\n116\t        card = ManaSculpt(owner=None)\n117\t        reqs = card.get_targets(game)\n118\t        assert isinstance(reqs[0], TargetRequirement)\n119\t\n120\t    def test_target_zone_is_stack(self) -> None:\n121\t        \"\"\"Counter target spell means targeting something on the stack.\"\"\"\n122\t        game = create_game()\n123\t        card = ManaSculpt(owner=None)\n124\t        reqs = card.get_targets(game)\n125\t        req = reqs[0]\n126\t        assert req.zone == Zone.STACK\n127\t\n128\t    def test_target_filter_accepts_spell(self) -> None:\n129\t        \"\"\"The filter should accept a spell (card with instant/sorcery type).\"\"\"\n130\t        game = create_game()\n131\t        card = ManaSculpt(owner=None)\n132\t        reqs = card.get_targets(game)\n133\t        req = reqs[0]\n134\t\n135\t        spell = Instant(name=\"Lightning Bolt\")\n136\t        # A spell on the stack should be a valid target\n137\t        assert req.filter_fn(spell) is True\n138\t\n139\t    def test_target_filter_accepts_sorcery_spell(self) -> None:\n140\t        \"\"\"The filter should accept a sorcery spell.\"\"\"\n141\t        game = create_game()\n142\t        card = ManaSculpt(owner=None)\n143\t        reqs = card.get_targets(game)\n144\t        req = reqs[0]\n145\t\n146\t        spell = Sorcery(name=\"Divination\")\n147\t        assert req.filter_fn(spell) is True\n148\t\n149\t    def test_target_filter_accepts_creature_spell(self) -> None:\n150\t        \"\"\"Counter target spell can counter any spell, including creatures.\"\"\"\n151\t        game = create_game()\n152\t        card = ManaSculpt(owner=None)\n153\t        reqs = card.get_targets(game)\n154\t        req = reqs[0]\n155\t\n156\t        creature_spell = Creature(name=\"Bear\", base_power=2, base_toughness=2)\n157\t        assert req.filter_fn(creature_spell) is True\n158\t\n159\t\n160\t# ---------------------------------------------------------------------------\n161\t# Counter effect — on_resolve\n162\t# ---------------------------------------------------------------------------\n163\t\n164\t\n165\tclass TestManaSculptCounterEffect:\n166\t    \"\"\"on_resolve should counter (remove from stack) the targeted spell.\"\"\"\n167\t\n168\t    def test_countered_spell_goes_to_graveyard(self) -> None:\n169\t        \"\"\"When Mana Sculpt resolves, the targeted spell should be moved\n170\t        to its owner's graveyard (standard counterspell behavior).\"\"\"\n171\t        game = create_game()\n172\t        p1 = game.players[0]\n173\t        p2 = game.players[1]\n174\t\n175\t        target_spell = Instant(\n176\t            name=\"Lightning Bolt\",\n177\t            owner=p2,\n178\t            controller=p2,\n179\t            mana_cost=ManaCost.parse(\"{R}\"),\n180\t        )\n181\t        # Put the target spell in p2's stack zone\n182\t        p2.zones[Zone.STACK].add(target_spell)\n183\t\n184\t        card = ManaSculpt(owner=p1, controller=p1)\n185\t        card.chosen_targets = [target_spell]\n186\t        card.on_resolve(game)\n187\t\n188\t        # The countered spell should be in p2's graveyard\n189\t        assert p2.zones[Zone.GRAVEYARD].contains(target_spell)\n190\t\n191\t    def test_countered_spell_removed_from_stack_zone(self) -> None:\n192\t        \"\"\"After countering, the spell should no longer be in the stack zone.\"\"\"\n193\t        game = create_game()\n194\t        p1 = game.players[0]\n195\t        p2 = game.players[1]\n196\t\n197\t        target_spell = Instant(\n198\t            name=\"Counterspell Target\",\n199\t            owner=p2,\n200\t            controller=p2,\n201\t            mana_cost=ManaCost.parse(\"{1}{U}\"),\n202\t        )\n203\t        p2.zones[Zone.STACK].add(target_spell)\n204\t\n205\t        card = ManaSculpt(owner=p1, controller=p1)\n206\t        card.chosen_targets = [target_spell]\n207\t        card.on_resolve(game)\n208\t\n209\t        # The spell should no longer be on the stack\n210\t        assert not p2.zones[Zone.STACK].contains(target_spell)\n211\t\n212\t    def test_no_target_is_noop(self) -> None:\n213\t        \"\"\"When chosen_targets is empty or not set, on_resolve should not raise.\"\"\"\n214\t        game = create_game()\n215\t        p1 = game.players[0]\n216\t        card = ManaSculpt(owner=p1, controller=p1)\n217\t        # No chosen_targets set\n218\t        card.on_resolve(game)\n219\t\n220\t    def test_empty_chosen_targets_does_not_raise(self) -> None:\n221\t        \"\"\"Empty chosen_targets list should not crash.\"\"\"\n222\t        game = create_game()\n223\t        p1 = game.players[0]\n224\t        card = ManaSculpt(owner=p1, controller=p1)\n225\t        card.chosen_targets = []\n226\t        card.on_resolve(game)\n227\t\n228\t\n229\t# ---------------------------------------------------------------------------\n230\t# Wizard conditional — no Wizard, no mana rebate\n231\t# ---------------------------------------------------------------------------\n232\t\n233\t\n234\tclass TestManaSculptWithoutWizard:\n235\t    \"\"\"Without a Wizard on the battlefield, Mana Sculpt should still counter\n236\t    the spell but should NOT produce any delayed mana trigger.\"\"\"\n237\t\n238\t    def test_counter_works_without_wizard(self) -> None:\n239\t        \"\"\"The spell is still countered even without a Wizard.\"\"\"\n240\t        game = create_game()\n241\t        p1 = game.players[0]\n242\t        p2 = game.players[1]\n243\t\n244\t        target_spell = Instant(\n245\t            name=\"Target\",\n246\t            owner=p2,\n247\t            controller=p2,\n248\t            mana_cost=ManaCost.parse(\"{2}{R}\"),\n249\t        )\n250\t        p2.zones[Zone.STACK].add(target_spell)\n251\t\n252\t        # No Wizard on p1's battlefield\n253\t        card = ManaSculpt(owner=p1, controller=p1)\n254\t        card.chosen_targets = [target_spell]\n255\t        card.on_resolve(game)\n256\t\n257\t        assert p2.zones[Zone.GRAVEYARD].contains(target_spell)\n258\t\n259\t    def test_no_delayed_trigger_without_wizard(self) -> None:\n260\t        \"\"\"Without a Wizard, no delayed trigger should be registered for\n261\t        the mana rebate. We verify by checking that no triggers were\n262\t        added to the trigger_manager during resolution.\"\"\"\n263\t        game = create_game()\n264\t        p1 = game.players[0]\n265\t        p2 = game.players[1]\n266\t\n267\t        target_spell = Instant(\n268\t            name=\"Target\",\n269\t            owner=p2,\n270\t            controller=p2,\n271\t            mana_cost=ManaCost.parse(\"{2}{R}\"),\n272\t        )\n273\t        p2.zones[Zone.STACK].add(target_spell)\n274\t\n275\t        # No Wizard on battlefield\n276\t        card = ManaSculpt(owner=p1, controller=p1)\n277\t        card.chosen_targets = [target_spell]\n278\t\n279\t        triggers_before = len(game.trigger_manager.get_triggers())\n280\t        card.on_resolve(game)\n281\t        triggers_after = len(game.trigger_manager.get_triggers())\n282\t\n283\t        # No new triggers should have been registered\n284\t        assert triggers_after == triggers_before\n285\t\n286\t\n287\t# ---------------------------------------------------------------------------\n288\t# Wizard conditional — with Wizard, mana rebate\n289\t# ---------------------------------------------------------------------------\n290\t\n291\t\n292\tclass TestManaSculptWithWizard:\n293\t    \"\"\"When the controller controls a Wizard, Mana Sculpt should set up a\n294\t    delayed trigger to add {C} equal to the mana spent to cast the\n295\t    countered spell at the beginning of the controller's next main phase.\"\"\"\n296\t\n297\t    def test_counter_still_works_with_wizard(self) -> None:\n298\t        \"\"\"The countering effect should work the same with a Wizard.\"\"\"\n299\t        game = create_game()\n300\t        p1 = game.players[0]\n301\t        p2 = game.players[1]\n302\t\n303\t        wizard = _make_wizard(owner=p1, controller=p1)\n304\t        game.get_battlefield(p1).add(wizard)\n305\t\n306\t        target_spell = Instant(\n307\t            name=\"Target\",\n308\t            owner=p2,\n309\t            controller=p2,\n310\t            mana_cost=ManaCost.parse(\"{2}{R}\"),\n311\t        )\n312\t        p2.zones[Zone.STACK].add(target_spell)\n313\t\n314\t        card = ManaSculpt(owner=p1, controller=p1)\n315\t        card.chosen_targets = [target_spell]\n316\t        card.on_resolve(game)\n317\t\n318\t        assert p2.zones[Zone.GRAVEYARD].contains(target_spell)\n319\t\n320\t    def test_delayed_trigger_registered_with_wizard(self) -> None:\n321\t        \"\"\"With a Wizard on the battlefield, resolving Mana Sculpt should\n322\t        register a delayed trigger (or equivalent mechanism) for the mana\n323\t        rebate.\"\"\"\n324\t        game = create_game()\n325\t        p1 = game.players[0]\n326\t        p2 = game.players[1]\n327\t\n328\t        wizard = _make_wizard(owner=p1, controller=p1)\n329\t        game.get_battlefield(p1).add(wizard)\n330\t\n331\t        target_spell = Instant(\n332\t            name=\"Target\",\n333\t            owner=p2,\n334\t            controller=p2,\n335\t            mana_cost=ManaCost.parse(\"{2}{R}\"),\n336\t        )\n337\t        p2.zones[Zone.STACK].add(target_spell)\n338\t\n339\t        card = ManaSculpt(owner=p1, controller=p1)\n340\t        card.chosen_targets = [target_spell]\n341\t\n342\t        triggers_before = len(game.trigger_manager.get_triggers())\n343\t        card.on_resolve(game)\n344\t        triggers_after = len(game.trigger_manager.get_triggers())\n345\t\n346\t        # A delayed trigger should have been registered\n347\t        assert triggers_after > triggers_before\n348\t\n349\t    def test_mana_rebate_amount_matches_spell_cmc(self) -> None:\n350\t        \"\"\"The amount of {C} added should equal the mana spent to cast\n351\t        the countered spell. For a spell with mana cost {2}{R} (CMC 3),\n352\t        the rebate should be 3 colorless mana.\n353\t\n354\t        We verify by resolving the delayed trigger and checking the mana pool.\n355\t        \"\"\"\n356\t        game = create_game()\n357\t        p1 = game.players[0]\n358\t        p2 = game.players[1]\n359\t\n360\t        wizard = _make_wizard(owner=p1, controller=p1)\n361\t        game.get_battlefield(p1).add(wizard)\n362\t\n363\t        # Spell that cost 3 total mana to cast\n364\t        target_spell = Instant(\n365\t            name=\"Expensive Spell\",\n366\t            owner=p2,\n367\t            controller=p2,\n368\t            mana_cost=ManaCost.parse(\"{2}{R}\"),\n369\t        )\n370\t        p2.zones[Zone.STACK].add(target_spell)\n371\t\n372\t        card = ManaSculpt(owner=p1, controller=p1)\n373\t        card.chosen_targets = [target_spell]\n374\t        card.on_resolve(game)\n375\t\n376\t        # Find and resolve the delayed trigger\n377\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n378\t        assert len(triggers) >= 1, \"Expected at least one delayed trigger\"\n379\t\n380\t        # Simulate the trigger firing and resolving\n381\t        trigger = triggers[0]\n382\t        # The trigger effect should add mana to p1's pool\n383\t        colorless_before = p1.mana_pool.get(ManaType.COLORLESS)\n384\t        trigger.effect(game)\n385\t\n386\t        colorless_after = p1.mana_pool.get(ManaType.COLORLESS)\n387\t        # Should have gained 3 colorless mana (CMC of {2}{R})\n388\t        assert colorless_after - colorless_before == 3\n389\t\n390\t    def test_mana_rebate_for_one_mana_spell(self) -> None:\n391\t        \"\"\"Countering a 1-mana spell should give a rebate of 1 colorless.\"\"\"\n392\t        game = create_game()\n393\t        p1 = game.players[0]\n394\t        p2 = game.players[1]\n395\t\n396\t        wizard = _make_wizard(owner=p1, controller=p1)\n397\t        game.get_battlefield(p1).add(wizard)\n398\t\n399\t        target_spell = Instant(\n400\t            name=\"Shock\",\n401\t            owner=p2,\n402\t            controller=p2,\n403\t            mana_cost=ManaCost.parse(\"{R}\"),\n404\t        )\n405\t        p2.zones[Zone.STACK].add(target_spell)\n406\t\n407\t        card = ManaSculpt(owner=p1, controller=p1)\n408\t        card.chosen_targets = [target_spell]\n409\t        card.on_resolve(game)\n410\t\n411\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n412\t        assert len(triggers) >= 1\n413\t\n414\t        trigger = triggers[0]\n415\t        colorless_before = p1.mana_pool.get(ManaType.COLORLESS)\n416\t        trigger.effect(game)\n417\t\n418\t        colorless_after = p1.mana_pool.get(ManaType.COLORLESS)\n419\t        assert colorless_after - colorless_before == 1\n420\t\n421\t    def test_mana_rebate_for_expensive_spell(self) -> None:\n422\t        \"\"\"Countering a 6-mana spell should yield 6 colorless mana.\"\"\"\n423\t        game = create_game()\n424\t        p1 = game.players[0]\n425\t        p2 = game.players[1]\n426\t\n427\t        wizard = _make_wizard(owner=p1, controller=p1)\n428\t        game.get_battlefield(p1).add(wizard)\n429\t\n430\t        target_spell = Sorcery(\n431\t            name=\"Big Spell\",\n432\t            owner=p2,\n433\t            controller=p2,\n434\t            mana_cost=ManaCost.parse(\"{4}{U}{U}\"),\n435\t        )\n436\t        p2.zones[Zone.STACK].add(target_spell)\n437\t\n438\t        card = ManaSculpt(owner=p1, controller=p1)\n439\t        card.chosen_targets = [target_spell]\n440\t        card.on_resolve(game)\n441\t\n442\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n443\t        assert len(triggers) >= 1\n444\t\n445\t        trigger = triggers[0]\n446\t        colorless_before = p1.mana_pool.get(ManaType.COLORLESS)\n447\t        trigger.effect(game)\n448\t\n449\t        colorless_after = p1.mana_pool.get(ManaType.COLORLESS)\n450\t        assert colorless_after - colorless_before == 6\n451\t\n452\t    def test_mana_rebate_adds_colorless(self) -> None:\n453\t        \"\"\"The mana added should be colorless ({C}), not any colored type.\"\"\"\n454\t        game = create_game()\n455\t        p1 = game.players[0]\n456\t        p2 = game.players[1]\n457\t\n458\t        wizard = _make_wizard(owner=p1, controller=p1)\n459\t        game.get_battlefield(p1).add(wizard)\n460\t\n461\t        target_spell = Instant(\n462\t            name=\"Bolt\",\n463\t            owner=p2,\n464\t            controller=p2,\n465\t            mana_cost=ManaCost.parse(\"{R}\"),\n466\t        )\n467\t        p2.zones[Zone.STACK].add(target_spell)\n468\t\n469\t        card = ManaSculpt(owner=p1, controller=p1)\n470\t        card.chosen_targets = [target_spell]\n471\t        card.on_resolve(game)\n472\t\n473\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n474\t        assert len(triggers) >= 1\n475\t\n476\t        # Snapshot all mana types before trigger fires\n477\t        mana_before = {mt: p1.mana_pool.get(mt) for mt in ManaType}\n478\t        trigger = triggers[0]\n479\t        trigger.effect(game)\n480\t        mana_after = {mt: p1.mana_pool.get(mt) for mt in ManaType}\n481\t\n482\t        # Only colorless should change\n483\t        for mt in ManaType:\n484\t            if mt == ManaType.COLORLESS:\n485\t                assert mana_after[mt] > mana_before[mt]\n486\t            else:\n487\t                assert mana_after[mt] == mana_before[mt], (\n488\t                    f\"Non-colorless mana type {mt} changed unexpectedly\"\n489\t                )\n490\t\n491\t\n492\t# ---------------------------------------------------------------------------\n493\t# Wizard detection — various Wizard subtypes\n494\t# ---------------------------------------------------------------------------\n495\t\n496\t\n497\tclass TestManaSculptWizardDetection:\n498\t    \"\"\"The card checks if 'you control a Wizard'. This should check for the\n499\t    Wizard creature subtype on any permanent on the controller's battlefield.\"\"\"\n500\t\n501\t    def test_wizard_subtype_detected(self) -> None:\n502\t        \"\"\"A creature with the Wizard subtype should satisfy the condition.\"\"\"\n503\t        game = create_game()\n504\t        p1 = game.players[0]\n505\t        p2 = game.players[1]\n506\t\n507\t        wizard = _make_wizard(owner=p1, controller=p1)\n508\t        game.get_battlefield(p1).add(wizard)\n509\t\n510\t        target_spell = Instant(\n511\t            name=\"Target\",\n512\t            owner=p2,\n513\t            controller=p2,\n514\t            mana_cost=ManaCost.parse(\"{1}\"),\n515\t        )\n516\t        p2.zones[Zone.STACK].add(target_spell)\n517\t\n518\t        card = ManaSculpt(owner=p1, controller=p1)\n519\t        card.chosen_targets = [target_spell]\n520\t\n521\t        triggers_before = len(game.trigger_manager.get_triggers())\n522\t        card.on_resolve(game)\n523\t        triggers_after = len(game.trigger_manager.get_triggers())\n524\t\n525\t        # Wizard was present, so a delayed trigger should be created\n526\t        assert triggers_after > triggers_before\n527\t\n528\t    def test_non_wizard_creature_does_not_trigger_rebate(self) -> None:\n529\t        \"\"\"A creature without Wizard subtype should not enable the rebate.\"\"\"\n530\t        game = create_game()\n531\t        p1 = game.players[0]\n532\t        p2 = game.players[1]\n533\t\n534\t        # A non-Wizard creature\n535\t        bear = Creature(\n536\t            name=\"Bear\",\n537\t            owner=p1,\n538\t            controller=p1,\n539\t            base_power=2,\n540\t            base_toughness=2,\n541\t            subtypes={\"Bear\"},\n542\t        )\n543\t        game.get_battlefield(p1).add(bear)\n544\t\n545\t        target_spell = Instant(\n546\t            name=\"Target\",\n547\t            owner=p2,\n548\t            controller=p2,\n549\t            mana_cost=ManaCost.parse(\"{1}\"),\n550\t        )\n551\t        p2.zones[Zone.STACK].add(target_spell)\n552\t\n553\t        card = ManaSculpt(owner=p1, controller=p1)\n554\t        card.chosen_targets = [target_spell]\n555\t\n556\t        triggers_before = len(game.trigger_manager.get_triggers())\n557\t        card.on_resolve(game)\n558\t        triggers_after = len(game.trigger_manager.get_triggers())\n559\t\n560\t        assert triggers_after == triggers_before\n561\t\n562\t    def test_opponent_wizard_does_not_count(self) -> None:\n563\t        \"\"\"A Wizard controlled by the opponent should NOT enable the rebate.\"\"\"\n564\t        game = create_game()\n565\t        p1 = game.players[0]\n566\t        p2 = game.players[1]\n567\t\n568\t        # Wizard on opponent's battlefield\n569\t        opp_wizard = _make_wizard(owner=p2, controller=p2)\n570\t        game.get_battlefield(p2).add(opp_wizard)\n571\t\n572\t        target_spell = Instant(\n573\t            name=\"Target\",\n574\t            owner=p2,\n575\t            controller=p2,\n576\t            mana_cost=ManaCost.parse(\"{2}\"),\n577\t        )\n578\t        p2.zones[Zone.STACK].add(target_spell)\n579\t\n580\t        card = ManaSculpt(owner=p1, controller=p1)\n581\t        card.chosen_targets = [target_spell]\n582\t\n583\t        triggers_before = len(game.trigger_manager.get_triggers())\n584\t        card.on_resolve(game)\n585\t        triggers_after = len(game.trigger_manager.get_triggers())\n586\t\n587\t        # No rebate because the Wizard is the opponent's\n588\t        assert triggers_after == triggers_before\n589\t\n590\t\n591\t# ---------------------------------------------------------------------------\n592\t# Edge case — countering a zero-mana spell\n593\t# ---------------------------------------------------------------------------\n594\t\n595\t\n596\tclass TestManaSculptZeroManaSpell:\n597\t    \"\"\"Countering a spell with CMC 0 should produce 0 colorless mana rebate.\"\"\"\n598\t\n599\t    def test_zero_cmc_spell_gives_zero_mana(self) -> None:\n600\t        \"\"\"A 0-cost spell yields a rebate of 0 colorless mana.\"\"\"\n601\t        game = create_game()\n602\t        p1 = game.players[0]\n603\t        p2 = game.players[1]\n604\t\n605\t        wizard = _make_wizard(owner=p1, controller=p1)\n606\t        game.get_battlefield(p1).add(wizard)\n607\t\n608\t        # A zero-cost spell (like Ornithopter, conceptually)\n609\t        target_spell = Instant(\n610\t            name=\"Free Spell\",\n611\t            owner=p2,\n612\t            controller=p2,\n613\t            mana_cost=ManaCost(generic=0, pips={}),\n614\t        )\n615\t        p2.zones[Zone.STACK].add(target_spell)\n616\t\n617\t        card = ManaSculpt(owner=p1, controller=p1)\n618\t        card.chosen_targets = [target_spell]\n619\t        card.on_resolve(game)\n620\t\n621\t        # Even with a Wizard, zero mana spent means zero mana rebate.\n622\t        # The trigger may or may not be registered for a 0-mana spell,\n623\t        # but if it fires, no mana should be added.\n624\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n625\t        if triggers:\n626\t            colorless_before = p1.mana_pool.get(ManaType.COLORLESS)\n627\t            triggers[0].effect(game)\n628\t            colorless_after = p1.mana_pool.get(ManaType.COLORLESS)\n629\t            assert colorless_after == colorless_before\n630\t"}]},"parent_tool_use_id":"toolu_01X21EtQANp7R1Yef6Rzo6SM","session_id":"1fe34661-6a3c-4b16-8a42-0f618466dfcb","uuid":"81bedd7c-7f46-4227-ba9c-7a65c7b6f9dc","timestamp":"2026-05-28T09:42:13.747Z","subagent_type":"Implemente