{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RdwArPRmYacU4VTAGZM8CC","type":"tool_result","content":"1\t\"\"\"Tests for SOS 120 -- Improvisation Capstone.\n2\t\n3\tImprovisation Capstone is a {5}{R}{R} Sorcery -- Lesson with Paradigm.\n4\t\n5\tOracle text:\n6\t    Exile cards from the top of your library until you exile cards with\n7\t    total mana value 4 or greater. You may cast any number of spells from\n8\t    among them without paying their mana costs.\n9\t\n10\t    Paradigm (Then exile this spell. After you first resolve a spell with\n11\t    this name, you may cast a copy of it from exile without paying its\n12\t    mana cost at the beginning of each of your first main phases.)\n13\t\n14\tRequirements tested:\n15\t1. Static properties: name, mana cost, card type (Sorcery), subtype (Lesson),\n16\t   colors (red), mana value (7).\n17\t2. Main effect -- exile from library until total MV >= 4.\n18\t3. Main effect -- castable spells among exiled cards.\n19\t4. Paradigm -- self-exile after resolution.\n20\t5. Paradigm -- delayed trigger registration for recurring cast at main phase.\n21\t6. Edge cases: empty library, single high-MV card, all zero-MV cards.\n22\t\"\"\"\n23\t\n24\tfrom __future__ import annotations\n25\t\n26\tfrom typing import Any\n27\t\n28\timport pytest\n29\t\n30\tfrom cards.sos.sos_120.card_impl import ImprovisationCapstone\n31\tfrom engine.card import CardImpl, Creature, Instant, Sorcery\n32\tfrom engine.events import BeginningOfMainPhaseTriggeredEvent\n33\tfrom engine.types import (\n34\t    CardType,\n35\t    ManaCost,\n36\t    ManaType,\n37\t    Zone,\n38\t)\n39\tfrom test_utils import create_game, set_board_state\n40\t\n41\t\n42\t# ---------------------------------------------------------------------------\n43\t# Helpers\n44\t# ---------------------------------------------------------------------------\n45\t\n46\t\n47\tdef _make_library_card(name: str, mana_cost_str: str, owner: Any = None) -> Instant:\n48\t    \"\"\"Create a simple instant card with a given mana cost for library stocking.\"\"\"\n49\t    return Instant(\n50\t        name=name,\n51\t        mana_cost=ManaCost.parse(mana_cost_str),\n52\t        owner=owner,\n53\t    )\n54\t\n55\t\n56\tdef _make_creature_card(\n57\t    name: str, mana_cost_str: str, power: int = 1, toughness: int = 1, owner: Any = None\n58\t) -> Creature:\n59\t    \"\"\"Create a creature card with a given mana cost for library stocking.\"\"\"\n60\t    return Creature(\n61\t        name=name,\n62\t        mana_cost=ManaCost.parse(mana_cost_str),\n63\t        base_power=power,\n64\t        base_toughness=toughness,\n65\t        owner=owner,\n66\t    )\n67\t\n68\t\n69\tdef _setup_with_library(library_cards: list[Any]) -> tuple:\n70\t    \"\"\"Create game, put Improvisation Capstone in hand, stock library.\n71\t\n72\t    Returns (game, player, capstone).\n73\t    Library cards are added bottom-to-top (last element = top of library).\n74\t    \"\"\"\n75\t    game = create_game()\n76\t    p1 = game.players[0]\n77\t    capstone = ImprovisationCapstone(owner=p1, controller=p1)\n78\t\n79\t    # Set up the library -- cards are added top-first, so reverse for\n80\t    # bottom-to-top ordering within the ZoneContainer (last = top).\n81\t    library = p1.zones[Zone.LIBRARY]\n82\t    # Clear existing library\n83\t    for obj in library.get_all():\n84\t        library.remove(obj)\n85\t    # Add cards: last in list = top of library\n86\t    for card in library_cards:\n87\t        card.owner = p1\n88\t        card.controller = p1\n89\t        library.add(card)\n90\t\n91\t    return game, p1, capstone\n92\t\n93\t\n94\t# ---------------------------------------------------------------------------\n95\t# Static properties\n96\t# ---------------------------------------------------------------------------\n97\t\n98\t\n99\tclass TestImprovisationCapstoneProperties:\n100\t    \"\"\"Static card data should match the SOS 120 spec.\"\"\"\n101\t\n102\t    def test_is_sorcery(self) -> None:\n103\t        card = ImprovisationCapstone(owner=None)\n104\t        assert isinstance(card, Sorcery)\n105\t\n106\t    def test_name(self) -> None:\n107\t        assert ImprovisationCapstone(owner=None).name == \"Improvisation Capstone\"\n108\t\n109\t    def test_mana_cost(self) -> None:\n110\t        assert ImprovisationCapstone(owner=None).mana_cost == ManaCost.parse(\"{5}{R}{R}\")\n111\t\n112\t    def test_has_sorcery_card_type(self) -> None:\n113\t        card = ImprovisationCapstone(owner=None)\n114\t        assert CardType.SORCERY in card.card_types\n115\t\n116\t    def test_has_lesson_subtype(self) -> None:\n117\t        card = ImprovisationCapstone(owner=None)\n118\t        assert \"Lesson\" in card.subtypes\n119\t\n120\t    def test_mana_value_is_seven(self) -> None:\n121\t        \"\"\"The converted mana cost / mana value should be 7 ({5}{R}{R}).\"\"\"\n122\t        card = ImprovisationCapstone(owner=None)\n123\t        assert card.mana_cost.cmc == 7\n124\t\n125\t    def test_color_is_red(self) -> None:\n126\t        \"\"\"The card's mana cost should include red pips.\"\"\"\n127\t        card = ImprovisationCapstone(owner=None)\n128\t        assert ManaType.RED in card.mana_cost.pips\n129\t\n130\t\n131\t# ---------------------------------------------------------------------------\n132\t# Main effect -- exile cards from library until total MV >= 4\n133\t# ---------------------------------------------------------------------------\n134\t\n135\t\n136\tclass TestImprovisationCapstoneExileFromLibrary:\n137\t    \"\"\"Exile cards from the top of your library until you exile cards with\n138\t    total mana value 4 or greater.\"\"\"\n139\t\n140\t    def test_exiles_cards_until_total_mv_four_or_greater(self) -> None:\n141\t        \"\"\"With a library of [MV1, MV1, MV2, MV3], should exile cards\n142\t        from top until the running total reaches 4+.\"\"\"\n143\t        # Library top-to-bottom: MV3 (top), MV2, MV1, MV1 (bottom)\n144\t        c1 = _make_library_card(\"Spell A\", \"{1}\")        # MV 1\n145\t        c2 = _make_library_card(\"Spell B\", \"{1}\")        # MV 1\n146\t        c3 = _make_library_card(\"Spell C\", \"{1}{U}\")     # MV 2\n147\t        c4 = _make_library_card(\"Spell D\", \"{2}{R}\")     # MV 3\n148\t        # top of library = c4 (last added)\n149\t        game, p1, capstone = _setup_with_library([c1, c2, c3, c4])\n150\t\n151\t        capstone.on_resolve(game)\n152\t\n153\t        exile = game.get_exile(p1)\n154\t        # The spell should exile from top: c4 (MV 3, total=3 < 4), then\n155\t        # c3 (MV 2, total=5 >= 4). So at least c4 and c3 should be exiled.\n156\t        exiled = exile.get_all()\n157\t        # Check total MV of exiled library cards (excluding capstone itself)\n158\t        exiled_lib_cards = [c for c in exiled if c is not capstone]\n159\t        total_mv = sum(\n160\t            getattr(c, \"mana_cost\", ManaCost()).cmc for c in exiled_lib_cards\n161\t        )\n162\t        assert total_mv >= 4, (\n163\t            f\"Expected total MV of exiled cards >= 4, got {total_mv}\"\n164\t        )\n165\t\n166\t    def test_single_card_with_mv_four_stops_immediately(self) -> None:\n167\t        \"\"\"If the top card has MV >= 4, only that one card should be exiled\n168\t        from library.\"\"\"\n169\t        big = _make_library_card(\"Big Spell\", \"{3}{R}\")  # MV 4\n170\t        filler = _make_library_card(\"Filler\", \"{1}\")      # MV 1\n171\t        game, p1, capstone = _setup_with_library([filler, big])\n172\t\n173\t        lib_before = len(p1.zones[Zone.LIBRARY])\n174\t        capstone.on_resolve(game)\n175\t\n176\t        # big was on top, MV=4 >= 4, so only 1 card exiled from library\n177\t        lib_after = len(p1.zones[Zone.LIBRARY])\n178\t        exiled_from_lib = lib_before - lib_after\n179\t        assert exiled_from_lib == 1, (\n180\t            f\"Expected exactly 1 card exiled from library, got {exiled_from_lib}\"\n181\t        )\n182\t\n183\t    def test_multiple_small_cards_exiled_until_threshold(self) -> None:\n184\t        \"\"\"Multiple MV-1 cards should be exiled one by one until total >= 4.\"\"\"\n185\t        cards = [_make_library_card(f\"Small {i}\", \"{1}\") for i in range(6)]\n186\t        game, p1, capstone = _setup_with_library(cards)\n187\t\n188\t        capstone.on_resolve(game)\n189\t\n190\t        exile = game.get_exile(p1)\n191\t        exiled_lib = [c for c in exile.get_all() if c is not capstone]\n192\t        total_mv = sum(\n193\t            getattr(c, \"mana_cost\", ManaCost()).cmc for c in exiled_lib\n194\t        )\n195\t        assert total_mv >= 4\n196\t        # Should have exiled exactly 4 MV-1 cards to reach total MV 4\n197\t        assert len(exiled_lib) == 4, (\n198\t            f\"Expected 4 cards exiled (4 x MV1), got {len(exiled_lib)}\"\n199\t        )\n200\t\n201\t    def test_cards_are_exiled_not_put_elsewhere(self) -> None:\n202\t        \"\"\"Exiled library cards should be in the exile zone, not graveyard or hand.\"\"\"\n203\t        c1 = _make_library_card(\"Card A\", \"{2}{R}\")  # MV 3\n204\t        c2 = _make_library_card(\"Card B\", \"{1}\")      # MV 1\n205\t        game, p1, capstone = _setup_with_library([c2, c1])\n206\t\n207\t        capstone.on_resolve(game)\n208\t\n209\t        exile = game.get_exile(p1)\n210\t        exiled_lib = [c for c in exile.get_all() if c is not capstone]\n211\t        # At least some cards should be in exile\n212\t        assert len(exiled_lib) > 0\n213\t        # None should be in graveyard (they were exiled, not milled)\n214\t        gy = game.get_graveyard(p1)\n215\t        for c in exiled_lib:\n216\t            assert not gy.contains(c), f\"{c.name} should not be in graveyard\"\n217\t\n218\t\n219\t# ---------------------------------------------------------------------------\n220\t# Main effect -- casting exiled spells for free\n221\t# ---------------------------------------------------------------------------\n222\t\n223\t\n224\tclass TestImprovisationCapstoneFreeCast:\n225\t    \"\"\"You may cast any number of spells from among the exiled cards\n226\t    without paying their mana costs.\"\"\"\n227\t\n228\t    def test_exiled_spells_are_castable_for_free(self) -> None:\n229\t        \"\"\"After exiling, the implementation should cast (or make available\n230\t        to cast) spells from among the exiled cards without paying mana.\n231\t        We verify that spells resolve even with an empty mana pool.\"\"\"\n232\t        # Two instants, MV 2 each: will need 2 to reach MV 4\n233\t        spell_a = Instant(\n234\t            name=\"Free Cast A\",\n235\t            mana_cost=ManaCost.parse(\"{1}{R}\"),\n236\t        )\n237\t        spell_b = Instant(\n238\t            name=\"Free Cast B\",\n239\t            mana_cost=ManaCost.parse(\"{1}{U}\"),\n240\t        )\n241\t        game, p1, capstone = _setup_with_library([spell_a, spell_b])\n242\t\n243\t        # Empty mana pool -- should still work (free cast)\n244\t        p1.mana_pool.empty()\n245\t\n246\t        capstone.on_resolve(game)\n247\t\n248\t        # Resolve anything on the stack from the free casts\n249\t        while not game.stack.is_empty():\n250\t            obj = game.stack.pop()\n251\t            obj.on_resolve(game)\n252\t\n253\t        # The exiled spells should have been cast. They might end up in\n254\t        # graveyard or exile depending on implementation. The key test is\n255\t        # that the resolve completes without error (no mana needed).\n256\t\n257\t    def test_creature_among_exiled_cards_can_be_cast(self) -> None:\n258\t        \"\"\"Non-instant/sorcery permanents among exiled cards should also\n259\t        be castable (the oracle says 'any number of spells').\"\"\"\n260\t        bear = Creature(\n261\t            name=\"Free Bear\",\n262\t            mana_cost=ManaCost.parse(\"{3}{G}\"),  # MV 4\n263\t            base_power=4,\n264\t            base_toughness=4,\n265\t        )\n266\t        game, p1, capstone = _setup_with_library([bear])\n267\t\n268\t        p1.mana_pool.empty()\n269\t        capstone.on_resolve(game)\n270\t\n271\t        # Resolve free-cast\n272\t        while not game.stack.is_empty():\n273\t            obj = game.stack.pop()\n274\t            obj.on_resolve(game)\n275\t\n276\t        # The creature should be on the battlefield (was cast for free)\n277\t        bf = game.get_battlefield(p1)\n278\t        bf_names = [getattr(c, \"name\", \"\") for c in bf.get_all()]\n279\t        assert \"Free Bear\" in bf_names, (\n280\t            f\"Expected Free Bear on battlefield, found: {bf_names}\"\n281\t        )\n282\t\n283\t\n284\t# ---------------------------------------------------------------------------\n285\t# Paradigm -- self-exile after resolution\n286\t# ---------------------------------------------------------------------------\n287\t\n288\t\n289\tclass TestImprovisationCapstoneParadigmExile:\n290\t    \"\"\"Paradigm means the spell itself is exiled after resolution,\n291\t    not put into the graveyard.\"\"\"\n292\t\n293\t    def test_spell_is_exiled_after_resolution(self) -> None:\n294\t        \"\"\"After on_resolve, the capstone itself should be in the exile zone.\"\"\"\n295\t        filler = _make_library_card(\"Filler\", \"{3}{R}\")  # MV 4\n296\t        game, p1, capstone = _setup_with_library([filler])\n297\t\n298\t        # Put the capstone somewhere the implementation can find it\n299\t        # (it might be on the stack or in hand during resolution).\n300\t        p1.zones[Zone.STACK].add(capstone)\n301\t\n302\t        capstone.on_resolve(game)\n303\t\n304\t        exile = game.get_exile(p1)\n305\t        assert exile.contains(capstone), (\n306\t            \"Paradigm requires the spell to be exiled after resolution\"\n307\t        )\n308\t\n309\t    def test_spell_not_in_graveyard_after_resolution(self) -> None:\n310\t        \"\"\"After resolution, the capstone should NOT be in the graveyard.\"\"\"\n311\t        filler = _make_library_card(\"Filler\", \"{3}{R}\")  # MV 4\n312\t        game, p1, capstone = _setup_with_library([filler])\n313\t\n314\t        p1.zones[Zone.STACK].add(capstone)\n315\t        capstone.on_resolve(game)\n316\t\n317\t        gy = game.get_graveyard(p1)\n318\t        assert not gy.contains(capstone), (\n319\t            \"Paradigm: spell should be exiled, not go to graveyard\"\n320\t        )\n321\t\n322\t\n323\t# ---------------------------------------------------------------------------\n324\t# Paradigm -- delayed trigger for recurring copy\n325\t# ---------------------------------------------------------------------------\n326\t\n327\t\n328\tclass TestImprovisationCapstoneParadigmRecurrence:\n329\t    \"\"\"After you first resolve a spell with this name, you may cast a copy\n330\t    of it from exile without paying its mana cost at the beginning of\n331\t    each of your first main phases.\"\"\"\n332\t\n333\t    def test_paradigm_registers_delayed_trigger_after_first_resolution(self) -> None:\n334\t        \"\"\"After the first resolution, a delayed trigger should be registered\n335\t        that watches for BeginningOfMainPhaseTriggeredEvent.\"\"\"\n336\t        filler = _make_library_card(\"Filler\", \"{3}{R}\")\n337\t        game, p1, capstone = _setup_with_library([filler])\n338\t        p1.zones[Zone.STACK].add(capstone)\n339\t\n340\t        triggers_before = len(game.trigger_manager.get_triggers())\n341\t        capstone.on_resolve(game)\n342\t        triggers_after = len(game.trigger_manager.get_triggers())\n343\t\n344\t        assert triggers_after > triggers_before, (\n345\t            \"Paradigm should register a delayed trigger after first resolution\"\n346\t        )\n347\t\n348\t    def test_paradigm_trigger_fires_at_main_phase(self) -> None:\n349\t        \"\"\"The paradigm trigger should respond to BeginningOfMainPhaseTriggeredEvent\n350\t        for the controller.\"\"\"\n351\t        filler = _make_library_card(\"Filler\", \"{3}{R}\")\n352\t        game, p1, capstone = _setup_with_library([filler])\n353\t        p1.zones[Zone.STACK].add(capstone)\n354\t\n355\t        capstone.on_resolve(game)\n356\t\n357\t        # Fire a main phase event for the controller\n358\t        event = BeginningOfMainPhaseTriggeredEvent(player=p1)\n359\t        game.trigger_manager.fire_event(game, event)\n360\t\n361\t        # Should have pushed something onto the stack\n362\t        assert not game.stack.is_empty(), (\n363\t            \"Paradigm trigger should push a copy/effect onto the stack \"\n364\t            \"at the beginning of main phase\"\n365\t        )\n366\t\n367\t    def test_paradigm_trigger_does_not_fire_for_opponent(self) -> None:\n368\t        \"\"\"The paradigm recurrence should only trigger for the controller,\n369\t        not the opponent.\"\"\"\n370\t        filler = _make_library_card(\"Filler\", \"{3}{R}\")\n371\t        game, p1, capstone = _setup_with_library([filler])\n372\t        p2 = game.players[1]\n373\t        p1.zones[Zone.STACK].add(capstone)\n374\t\n375\t        capstone.on_resolve(game)\n376\t\n377\t        # Fire a main phase event for the opponent\n378\t        event = BeginningOfMainPhaseTriggeredEvent(player=p2)\n379\t        stack_before = len(game.stack)\n380\t        game.trigger_manager.fire_event(game, event)\n381\t        stack_after = len(game.stack)\n382\t\n383\t        assert stack_after == stack_before, (\n384\t            \"Paradigm trigger should not fire for the opponent's main phase\"\n385\t        )\n386\t\n387\t    def test_paradigm_creates_copy_in_exile(self) -> None:\n388\t        \"\"\"When the paradigm trigger resolves, it should create a copy of the\n389\t        spell in exile that can be cast.\"\"\"\n390\t        filler = _make_library_card(\"Filler\", \"{3}{R}\")\n391\t        game, p1, capstone = _setup_with_library([filler])\n392\t        p1.zones[Zone.STACK].add(capstone)\n393\t\n394\t        capstone.on_resolve(game)\n395\t\n396\t        # Fire main phase and resolve the trigger\n397\t        event = BeginningOfMainPhaseTriggeredEvent(player=p1)\n398\t        game.trigger_manager.fire_event(game, event)\n399\t\n400\t        # Resolve the paradigm trigger\n401\t        if not game.stack.is_empty():\n402\t            trigger_obj = game.stack.pop()\n403\t            trigger_obj.on_resolve(game)\n404\t\n405\t        # There should be an Improvisation Capstone copy in exile or\n406\t        # something on the stack from the paradigm copy\n407\t        exile = game.get_exile(p1)\n408\t        exile_names = [getattr(c, \"name\", \"\") for c in exile.get_all()]\n409\t        capstone_count = exile_names.count(\"Improvisation Capstone\")\n410\t        # The original is in exile + potentially a copy\n411\t        # OR the copy was cast and is on the stack\n412\t        has_copy = capstone_count >= 1 or not game.stack.is_empty()\n413\t        assert has_copy, (\n414\t            \"Paradigm should create a castable copy; \"\n415\t            f\"exile has: {exile_names}, stack size: {len(game.stack)}\"\n416\t        )\n417\t\n418\t\n419\t# ---------------------------------------------------------------------------\n420\t# Edge cases\n421\t# ---------------------------------------------------------------------------\n422\t\n423\t\n424\tclass TestImprovisationCapstoneEdgeCases:\n425\t    \"\"\"Edge cases and boundary conditions.\"\"\"\n426\t\n427\t    def test_empty_library_does_not_crash(self) -> None:\n428\t        \"\"\"If the library is empty, on_resolve should not crash.\"\"\"\n429\t        game, p1, capstone = _setup_with_library([])\n430\t\n431\t        p1.zones[Zone.STACK].add(capstone)\n432\t        # Should not raise\n433\t        capstone.on_resolve(game)\n434\t\n435\t    def test_library_with_insufficient_total_mv(self) -> None:\n436\t        \"\"\"If the entire library has total MV < 4, all cards should be\n437\t        exiled and no crash should occur.\"\"\"\n438\t        cards = [_make_library_card(f\"Tiny {i}\", \"{1}\") for i in range(3)]\n439\t        # Total MV = 3 (< 4), entire library gets exiled\n440\t        game, p1, capstone = _setup_with_library(cards)\n441\t        p1.zones[Zone.STACK].add(capstone)\n442\t\n443\t        capstone.on_resolve(game)\n444\t\n445\t        # Library should be empty (all cards exiled)\n446\t        assert len(p1.zones[Zone.LIBRARY]) == 0, (\n447\t            \"With insufficient total MV, entire library should be exiled\"\n448\t        )\n449\t\n450\t    def test_zero_mv_cards_are_counted(self) -> None:\n451\t        \"\"\"Cards with MV 0 (like tokens or lands with no mana cost)\n452\t        contribute 0 to the running total but are still exiled.\"\"\"\n453\t        # 3 MV-0 cards then 1 MV-4 card on top\n454\t        zero_cards = [\n455\t            Creature(name=f\"Zero {i}\", base_power=1, base_toughness=1)\n456\t            for i in range(3)\n457\t        ]\n458\t        big = _make_library_card(\"Big One\", \"{3}{R}\")  # MV 4\n459\t        # Library (bottom to top): zero_0, zero_1, zero_2, big\n460\t        game, p1, capstone = _setup_with_library(zero_cards + [big])\n461\t        p1.zones[Zone.STACK].add(capstone)\n462\t\n463\t        capstone.on_resolve(game)\n464\t\n465\t        exile = game.get_exile(p1)\n466\t        exiled_lib = [c for c in exile.get_all() if c is not capstone]\n467\t\n468\t        # big alone has MV 4, so at minimum big should be exiled\n469\t        exiled_names = [getattr(c, \"name\", \"\") for c in exiled_lib]\n470\t        assert \"Big One\" in exiled_names, (\n471\t            f\"The MV-4 card should be exiled; found: {exiled_names}\"\n472\t        )\n473\t\n474\t    def test_on_resolve_with_no_castable_spells(self) -> None:\n475\t        \"\"\"If all exiled cards are lands (not castable as spells), the\n476\t        resolution should still complete without error.\"\"\"\n477\t        from engine.card import Land\n478\t\n479\t        lands = [\n480\t            Land(name=f\"Fancy Land {i}\")\n481\t            for i in range(5)\n482\t        ]\n483\t        # Lands have MV 0, so the entire library gets exiled\n484\t        # without ever reaching MV 4\n485\t        game, p1, capstone = _setup_with_library(lands)\n486\t        p1.zones[Zone.STACK].add(capstone)\n487\t\n488\t        # Should not crash even with no castable spells\n489\t        capstone.on_resolve(game)\n490\t"}]},"parent_tool_use_id":"toolu_01BBQptWsM57uJ5kEiw8L9Hs","session_id":"1fe34661-6a3c-4b16-8a42-0f618466dfcb","uuid":"3dc77ce8-def2-465d-8696-c7a80254482f","timestamp":"2026-05-28T10:00:47.429Z","subagent_type":"Implementer","task_description":"Implement sos_120"}
