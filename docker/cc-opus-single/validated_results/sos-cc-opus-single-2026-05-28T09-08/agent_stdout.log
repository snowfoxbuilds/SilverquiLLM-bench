sed_actions.py:285:                    obj.plus_one_counters -= annihilate\nengine/state_based_actions.py:286:                    obj.minus_one_counters -= annihilate\nengine/state_based_actions.py:317:    # +1/+1 and -1/-1 counter annihilation\nengine/state_based_actions.py:318:    action_taken = _sba_counter_annihilation(game) or action_taken\nengine/card.py:112:    auto-incrementing counter.\nengine/card.py:129:    def reset_id_counter(cls) -> None:\nengine/card.py:130:        \"\"\"Reset the auto-incrementing counter (useful in tests).\"\"\"\nengine/card.py:255:        modified_power: Current power after continuous effects (Layer 7c), before counters.\nengine/card.py:257:        modified_toughness: Current toughness after continuous effects, before counters.\nengine/card.py:263:        plus_one_counters: Number of +1/+1 counters.\nengine/card.py:264:        minus_one_counters: Number of -1/-1 counters.\nengine/card.py:304:        self.plus_one_counters: int = 0\nengine/card.py:305:        self.minus_one_counters: int = 0\nengine/card.py:308:        self._base_plus_one_counters: int = 0\nengine/card.py:309:        self._base_minus_one_counters: int = 0\nengine/card.py:316:        self.plus_one_counters = self._base_plus_one_counters\nengine/card.py:317:        self.minus_one_counters = self._base_minus_one_counters\nengine/card.py:330:    def counters(self) -> dict[str, int]:\nengine/card.py:331:        \"\"\"Return a dict-like view of counters on this creature.\"\"\"\nengine/card.py:333:        if self.plus_one_counters > 0:\nengine/card.py:334:            result[\"+1/+1\"] = self.plus_one_counters\nengine/card.py:335:        if self.minus_one_counters > 0:\nengine/card.py:336:            result[\"-1/-1\"] = self.minus_one_counters\nengine/card.py:341:        \"\"\"Current power including counter modifications.\"\"\"\nengine/card.py:342:        return self.modified_power + self.plus_one_counters - self.minus_one_counters\nengine/card.py:346:        \"\"\"Current