\t          \"path\": \"cards/sos/sos_245/tests.py\",\n83\t          \"summary\": \"tests for sos_245 Witherbloom the Balancer: static properties, self affinity for creatures, granting affinity to instants/sorceries, casting pipeline integration, edge cases\"\n84\t        }\n85\t      ],\n86\t      \"implementation\": [\n87\t        {\n88\t          \"path\": \"cards/sos/sos_245/card_impl.py\",\n89\t          \"summary\": \"Witherbloom the Balancer creature with self affinity for creatures via cost_reduction, external cost-reduction provider for instants/sorceries\"\n90\t        },\n91\t        {\n92\t          \"path\": \"engine/casting.py\",\n93\t          \"summary\": \"Extended get_cost_reduction to sum external cost-reduction providers from game state\"\n94\t        },\n95\t        {\n96\t          \"path\": \"engine/game_state.py\",\n97\t          \"summary\": \"Added _cost_reduction_providers list for external cost reduction registration\"\n98\t        },\n99\t        {\n100\t          \"path\": \"engine/zones.py\",\n101\t          \"summary\": \"Added cleanup of cost-reduction providers when permanent leaves battlefield\"\n102\t        }\n103\t      ]\n104\t    },\n105\t    {\n106\t      \"card\": \"sos_4\",\n107\t      \"tests\": [\n108\t        {\n109\t          \"path\": \"cards/sos/sos_4/tests.py\",\n110\t          \"summary\": \"tests for sos_4 Together as One: static properties, targeting (player + any target), converge colors_spent, draw X, deal X damage, gain X life, zero colors edge case, no targets edge case, Color list format\"\n111\t        }\n112\t      ],\n113\t      \"implementation\": [\n114\t        {\n115\t          \"path\": \"cards/sos/sos_4/card_impl.py\",\n116\t          \"summary\": \"Together as One sorcery with converge: colors_spent tracking (int or Color list), two target requirements, on_resolve draws X for target player, deals X damage to any target, controller gains X life with GainsLifeTriggeredEvent\"\n117\t        }\n118\t   