{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015pDksAJwYKBhPmbMsfGRZw","type":"tool_result","content":"1\t\"\"\"Card implementation for The Dawning Archaic.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.events import AttacksTriggeredEvent\n9\tfrom engine.triggers import TriggerRegistration\n10\tfrom engine.types import (\n11\t    CardType,\n12\t    Keyword,\n13\t    ManaCost,\n14\t    Supertype,\n15\t    TargetRequirement,\n16\t    Zone,\n17\t)\n18\t\n19\tif TYPE_CHECKING:\n20\t    from engine.game_state import GameState\n21\t\n22\t\n23\tdef _is_instant_or_sorcery(card: Any) -> bool:\n24\t    \"\"\"Return True if *card* is an instant or sorcery.\"\"\"\n25\t    card_types = getattr(card, \"card_types\", set())\n26\t    return CardType.INSTANT in card_types or CardType.SORCERY in card_types\n27\t\n28\t\n29\tclass TheDawningArchaic(Creature):\n30\t    \"\"\"The Dawning Archaic -- {10} -- Legendary Creature -- Avatar -- 7/7.\n31\t\n32\t    This spell costs {1} less to cast for each instant and sorcery card\n33\t    in your graveyard.\n34\t\n35\t    Reach\n36\t\n37\t    Whenever The Dawning Archaic attacks, you may cast target instant or\n38\t    sorcery card from your graveyard without paying its mana cost. If\n39\t    that spell would be put into your graveyard, exile it instead.\n40\t\n41\t    SOS collector number 1.\n42\t    \"\"\"\n43\t\n44\t    def __init__(self, **kwargs: Any) -> None:\n45\t        kwargs.setdefault(\"name\", \"The Dawning Archaic\")\n46\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{10}\"))\n47\t        kwargs.setdefault(\"subtypes\", {\"Avatar\"})\n48\t        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n49\t        kwargs.setdefault(\"keywords\", Keyword.REACH)\n50\t        kwargs.setdefault(\"base_power\", 7)\n51\t        kwargs.setdefault(\"base_toughness\", 7)\n52\t        kwargs.setdefault(\n53\t            \"rules_text\",\n54\t            \"This spell costs {1} less to cast for each instant and sorcery \"\n55\t            \"card in your graveyard.\\nReach\\nWhenever The Dawning Archaic \"\n56\t            \"attacks, you may cast target instant or sorcery card from your \"\n57\t            \"graveyard without paying its mana cost. If that spell would be \"\n58\t            \"put into your graveyard, exile it instead.\",\n59\t        )\n60\t        super().__init__(**kwargs)\n61\t\n62\t    # ------------------------------------------------------------------\n63\t    # Cost reduction\n64\t    # ------------------------------------------------------------------\n65\t\n66\t    def cost_reduction(self, game: GameState) -> int:\n67\t        \"\"\"Return the number of instants and sorceries in controller's graveyard.\"\"\"\n68\t        controller = self.controller\n69\t        if controller is None:\n70\t            controller = self.owner\n71\t        if controller is None:\n72\t            return 0\n73\t\n74\t        graveyard = game.get_graveyard(controller)\n75\t        count = 0\n76\t        for card in graveyard.get_all():\n77\t            if _is_instant_or_sorcery(card):\n78\t                count += 1\n79\t        return count\n80\t\n81\t    # ------------------------------------------------------------------\n82\t    # Targeting (for the attack trigger)\n83\t    # ------------------------------------------------------------------\n84\t\n85\t    def get_targets(self, game: GameState) -> list[Any]:\n86\t        \"\"\"Return target requirement: instant or sorcery card in graveyard.\"\"\"\n87\t        return [\n88\t            TargetRequirement(\n89\t                filter_fn=_is_instant_or_sorcery,\n90\t                description=\"target instant or sorcery card in your graveyard\",\n91\t                zone=Zone.GRAVEYARD,\n92\t            )\n93\t        ]\n94\t\n95\t    # ------------------------------------------------------------------\n96\t    # Attack trigger\n97\t    # ------------------------------------------------------------------\n98\t\n99\t    def register_triggers(self, game: GameState) -> None:\n100\t        \"\"\"Register the attack trigger for this creature.\"\"\"\n101\t        source = self\n102\t\n103\t        def _condition(game: GameState, event: AttacksTriggeredEvent) -> bool:\n104\t            \"\"\"Only trigger when this creature attacks.\"\"\"\n105\t            return event.creature is source or event.attacker is source\n106\t\n107\t        def _effect(game: GameState) -> None:\n108\t            \"\"\"Cast target instant or sorcery from graveyard for free.\n109\t\n110\t            The target is read from source.chosen_targets (set by the\n111\t            test or by the engine's targeting pipeline).\n112\t            \"\"\"\n113\t            chosen = getattr(source, \"chosen_targets\", None)\n114\t            if not chosen:\n115\t                return\n116\t\n117\t            target_card = chosen[0] if isinstance(chosen, list) else chosen\n118\t            if target_card is None:\n119\t                return\n120\t\n121\t            # Verify the target is still an instant or sorcery\n122\t            if not _is_instant_or_sorcery(target_card):\n123\t                return\n124\t\n125\t            controller = source.controller\n126\t            if controller is None:\n127\t                controller = source.owner\n128\t            if controller is None:\n129\t                return\n130\t\n131\t            # Verify the target is still in the graveyard\n132\t            graveyard = game.get_graveyard(controller)\n133\t            if not graveyard.contains(target_card):\n134\t                return\n135\t\n136\t            # Mark this card so the exile-instead-of-graveyard replacement\n137\t            # applies only to it.\n138\t            target_card._dawning_archaic_free_cast = True  # type: ignore[attr-defined]\n139\t\n140\t            # Cast the spell for free from graveyard.\n141\t            # We remove it from the graveyard and put it on the stack,\n142\t            # then push a StackObject to resolve it.\n143\t            from engine.stack import StackObject\n144\t\n145\t            graveyard.remove(target_card)\n146\t\n147\t            # Set controller/owner for the cast spell\n148\t            target_card.controller = controller\n149\t            if target_card.owner is None:\n150\t                target_card.owner = controller\n151\t\n152\t            # Put on the stack zone\n153\t            stack_zone = controller.zones[Zone.STACK]\n154\t            stack_zone.add(target_card)\n155\t\n156\t            # Build a StackObject for the free-cast spell\n157\t            def _spell_resolve(g: GameState) -> None:\n158\t                \"\"\"Resolve the free-cast spell, then exile it instead of graveyard.\"\"\"\n159\t                # Call the spell's own on_resolve\n160\t                target_card.on_resolve(g)\n161\t\n162\t                # Move from stack to exile (instead of graveyard)\n163\t                if stack_zone.contains(target_card):\n164\t                    stack_zone.remove(target_card)\n165\t\n166\t                owner = target_card.owner if target_card.owner is not None else controller\n167\t                exile_zone = g.get_exile(owner)\n168\t                exile_zone.add(target_card)\n169\t\n170\t                # Clean up the marker\n171\t                if hasattr(target_card, \"_dawning_archaic_free_cast\"):\n172\t                    del target_card._dawning_archaic_free_cast\n173\t\n174\t            spell_stack_obj = StackObject(\n175\t                source=target_card,\n176\t                controller=controller,\n177\t                targets=[],\n178\t                on_resolve=_spell_resolve,\n179\t            )\n180\t            game.stack.push(spell_stack_obj)\n181\t\n182\t        controller = self.controller if self.controller is not None else self.owner\n183\t        if controller is None:\n184\t            return\n185\t\n186\t        trigger = TriggerRegistration(\n187\t            event_type=AttacksTriggeredEvent,\n188\t            condition=_condition,\n189\t            effect=_effect,\n190\t            source=self,\n191\t            controller=controller,\n192\t        )\n193\t        game.trigger_manager.register(trigger)\n194\t"}]},"parent_tool_use_id":"toolu_01BEmxcq5vooxXnzUgasuEfg","session_id":"1fe34661-6a3c-4b16-8a42-0f618466dfcb","uuid":"df4145e9-b781-4e35-8d56-aaba0a4c12fa","timestamp":"2026-05-28T09:18:46.242Z","subagent_type":"Implementer","task_description":"Revise sos_1 per review"}
