{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J5yxssbnFe7NLXSgVQqTdt","type":"tool_result","content":"1\t\"\"\"Tests for SOS 201 — Lorehold, the Historian.\n2\t\n3\tLorehold, the Historian is a {3}{R}{W} Legendary Creature — Elder Dragon (5/5)\n4\twith Flying, Haste.\n5\t\n6\tRequirements tested:\n7\t1. Static properties: name, mana cost, power/toughness, types, supertypes,\n8\t   subtypes, keywords.\n9\t2. Miracle granting: \"Each instant and sorcery card in your hand has miracle {2}.\"\n10\t   Instants and sorceries in the controller's hand should gain miracle with\n11\t   cost {2}. Creatures and other card types should not gain miracle.\n12\t3. Opponent's upkeep trigger: \"At the beginning of each opponent's upkeep,\n13\t   you may discard a card. If you do, draw a card.\" This is a looting trigger\n14\t   that fires at the beginning of each opponent's upkeep.\n15\t\"\"\"\n16\t\n17\tfrom __future__ import annotations\n18\t\n19\tfrom typing import Any\n20\t\n21\tfrom cards.sos.sos_201.card_impl import LoreholdTheHistorian\n22\tfrom engine.card import Creature, Instant, Sorcery, Enchantment\n23\tfrom engine.events import (\n24\t    BeginningOfUpkeepTriggeredEvent,\n25\t    DrawsCardTriggeredEvent,\n26\t)\n27\tfrom engine.triggers import TriggerRegistration\n28\tfrom engine.types import (\n29\t    CardType,\n30\t    Keyword,\n31\t    ManaCost,\n32\t    ManaType,\n33\t    Supertype,\n34\t    Zone,\n35\t)\n36\tfrom test_utils import create_game, set_board_state\n37\t\n38\t\n39\t# ---------------------------------------------------------------------------\n40\t# Static properties\n41\t# ---------------------------------------------------------------------------\n42\t\n43\t\n44\tclass TestLoreholdTheHistorianProperties:\n45\t    \"\"\"Static card data should match the SOS 201 spec.\"\"\"\n46\t\n47\t    def test_is_creature(self) -> None:\n48\t        card = LoreholdTheHistorian(owner=None)\n49\t        assert isinstance(card, Creature)\n50\t\n51\t    def test_name(self) -> None:\n52\t        assert LoreholdTheHistorian(owner=None).name == \"Lorehold, the Historian\"\n53\t\n54\t    def test_mana_cost(self) -> None:\n55\t        assert LoreholdTheHistorian(owner=None).mana_cost == ManaCost.parse(\"{3}{R}{W}\")\n56\t\n57\t    def test_power_toughness(self) -> None:\n58\t        card = LoreholdTheHistorian(owner=None)\n59\t        assert card.base_power == 5\n60\t        assert card.base_toughness == 5\n61\t\n62\t    def test_is_legendary(self) -> None:\n63\t        card = LoreholdTheHistorian(owner=None)\n64\t        assert Supertype.LEGENDARY in card.supertypes\n65\t\n66\t    def test_has_elder_dragon_subtypes(self) -> None:\n67\t        card = LoreholdTheHistorian(owner=None)\n68\t        assert \"Elder\" in card.subtypes\n69\t        assert \"Dragon\" in card.subtypes\n70\t\n71\t    def test_has_flying(self) -> None:\n72\t        card = LoreholdTheHistorian(owner=None)\n73\t        assert Keyword.FLYING in card.keywords\n74\t\n75\t    def test_has_haste(self) -> None:\n76\t        card = LoreholdTheHistorian(owner=None)\n77\t        assert Keyword.HASTE in card.keywords\n78\t\n79\t    def test_has_creature_type(self) -> None:\n80\t        card = LoreholdTheHistorian(owner=None)\n81\t        assert CardType.CREATURE in card.card_types\n82\t\n83\t\n84\t# ---------------------------------------------------------------------------\n85\t# Miracle granting — instants and sorceries in hand get miracle {2}\n86\t# ---------------------------------------------------------------------------\n87\t\n88\t\n89\tclass TestLoreholdMiracleGranting:\n90\t    \"\"\"Each instant and sorcery card in your hand has miracle {2}.\n91\t\n92\t    This is a static ability on Lorehold. While Lorehold is on the\n93\t    battlefield, every instant and sorcery card in the controller's hand\n94\t    should have miracle with cost {2}. Non-instant/sorcery cards should\n95\t    not gain miracle.\n96\t    \"\"\"\n97\t\n98\t    def test_instant_in_hand_gains_miracle(self) -> None:\n99\t        \"\"\"An instant card in the controller's hand should have miracle.\"\"\"\n100\t        game = create_game()\n101\t        p1 = game.players[0]\n102\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n103\t        game.get_battlefield(p1).add(lorehold)\n104\t        lorehold.register_triggers(game)\n105\t\n106\t        bolt = Instant(name=\"Lightning Bolt\", owner=p1, controller=p1,\n107\t                       mana_cost=ManaCost.parse(\"{R}\"))\n108\t        set_board_state(game, 0, hand=[bolt])\n109\t\n110\t        # The instant should now have a miracle cost attribute\n111\t        miracle_cost = getattr(bolt, \"miracle_cost\", None)\n112\t        assert miracle_cost is not None, (\n113\t            \"Instant in hand should have miracle_cost when Lorehold is on battlefield\"\n114\t        )\n115\t        assert miracle_cost == ManaCost.parse(\"{2}\"), (\n116\t            f\"Miracle cost should be {{2}}, got {miracle_cost}\"\n117\t        )\n118\t\n119\t    def test_sorcery_in_hand_gains_miracle(self) -> None:\n120\t        \"\"\"A sorcery card in the controller's hand should have miracle.\"\"\"\n121\t        game = create_game()\n122\t        p1 = game.players[0]\n123\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n124\t        game.get_battlefield(p1).add(lorehold)\n125\t        lorehold.register_triggers(game)\n126\t\n127\t        div = Sorcery(name=\"Divination\", owner=p1, controller=p1,\n128\t                      mana_cost=ManaCost.parse(\"{2}{U}\"))\n129\t        set_board_state(game, 0, hand=[div])\n130\t\n131\t        miracle_cost = getattr(div, \"miracle_cost\", None)\n132\t        assert miracle_cost is not None, (\n133\t            \"Sorcery in hand should have miracle_cost when Lorehold is on battlefield\"\n134\t        )\n135\t        assert miracle_cost == ManaCost.parse(\"{2}\"), (\n136\t            f\"Miracle cost should be {{2}}, got {miracle_cost}\"\n137\t        )\n138\t\n139\t    def test_creature_in_hand_does_not_gain_miracle(self) -> None:\n140\t        \"\"\"A creature card in the controller's hand should NOT have miracle.\"\"\"\n141\t        game = create_game()\n142\t        p1 = game.players[0]\n143\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n144\t        game.get_battlefield(p1).add(lorehold)\n145\t        lorehold.register_triggers(game)\n146\t\n147\t        bear = Creature(name=\"Grizzly Bears\", owner=p1, controller=p1,\n148\t                        base_power=2, base_toughness=2)\n149\t        set_board_state(game, 0, hand=[bear])\n150\t\n151\t        miracle_cost = getattr(bear, \"miracle_cost\", None)\n152\t        assert miracle_cost is None, (\n153\t            \"Creature in hand should NOT have miracle_cost\"\n154\t        )\n155\t\n156\t    def test_enchantment_in_hand_does_not_gain_miracle(self) -> None:\n157\t        \"\"\"An enchantment card in hand should NOT have miracle.\"\"\"\n158\t        game = create_game()\n159\t        p1 = game.players[0]\n160\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n161\t        game.get_battlefield(p1).add(lorehold)\n162\t        lorehold.register_triggers(game)\n163\t\n164\t        ench = Enchantment(name=\"Pacifism\", owner=p1, controller=p1,\n165\t                           mana_cost=ManaCost.parse(\"{1}{W}\"))\n166\t        set_board_state(game, 0, hand=[ench])\n167\t\n168\t        miracle_cost = getattr(ench, \"miracle_cost\", None)\n169\t        assert miracle_cost is None, (\n170\t            \"Enchantment in hand should NOT have miracle_cost\"\n171\t        )\n172\t\n173\t    def test_miracle_cost_is_two_generic(self) -> None:\n174\t        \"\"\"The miracle cost should be exactly {2} (two generic mana).\"\"\"\n175\t        game = create_game()\n176\t        p1 = game.players[0]\n177\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n178\t        game.get_battlefield(p1).add(lorehold)\n179\t        lorehold.register_triggers(game)\n180\t\n181\t        expensive = Instant(name=\"Expensive Spell\", owner=p1, controller=p1,\n182\t                            mana_cost=ManaCost.parse(\"{5}{U}{U}\"))\n183\t        set_board_state(game, 0, hand=[expensive])\n184\t\n185\t        miracle_cost = getattr(expensive, \"miracle_cost\", None)\n186\t        assert miracle_cost is not None\n187\t        expected = ManaCost.parse(\"{2}\")\n188\t        assert miracle_cost == expected, (\n189\t            f\"Miracle cost should be {{2}} (generic 2), got {miracle_cost}\"\n190\t        )\n191\t\n192\t    def test_opponent_instants_do_not_gain_miracle(self) -> None:\n193\t        \"\"\"Only the Lorehold controller's hand should gain miracle, not\n194\t        the opponent's.\"\"\"\n195\t        game = create_game()\n196\t        p1 = game.players[0]\n197\t        p2 = game.players[1]\n198\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n199\t        game.get_battlefield(p1).add(lorehold)\n200\t        lorehold.register_triggers(game)\n201\t\n202\t        # Put an instant in the opponent's hand\n203\t        opp_bolt = Instant(name=\"Opponent Bolt\", owner=p2, controller=p2,\n204\t                           mana_cost=ManaCost.parse(\"{R}\"))\n205\t        set_board_state(game, 1, hand=[opp_bolt])\n206\t\n207\t        miracle_cost = getattr(opp_bolt, \"miracle_cost\", None)\n208\t        assert miracle_cost is None, (\n209\t            \"Opponent's instant should NOT gain miracle from Lorehold\"\n210\t        )\n211\t\n212\t\n213\t# ---------------------------------------------------------------------------\n214\t# Opponent's upkeep trigger — registration\n215\t# ---------------------------------------------------------------------------\n216\t\n217\t\n218\tclass TestLoreholdUpkeepTriggerRegistration:\n219\t    \"\"\"At the beginning of each opponent's upkeep, you may discard a card.\n220\t    If you do, draw a card.\n221\t\n222\t    The trigger should be registered when Lorehold enters the battlefield.\n223\t    \"\"\"\n224\t\n225\t    def test_registers_trigger(self) -> None:\n226\t        \"\"\"register_triggers should register at least one trigger.\"\"\"\n227\t        game = create_game()\n228\t        p1 = game.players[0]\n229\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n230\t        game.get_battlefield(p1).add(lorehold)\n231\t\n232\t        before_count = len(game.trigger_manager.get_triggers())\n233\t        lorehold.register_triggers(game)\n234\t        after_count = len(game.trigger_manager.get_triggers())\n235\t\n236\t        assert after_count > before_count, (\n237\t            \"register_triggers should add at least one trigger\"\n238\t        )\n239\t\n240\t    def test_registered_trigger_watches_upkeep_event(self) -> None:\n241\t        \"\"\"The registered trigger should watch for BeginningOfUpkeepTriggeredEvent.\"\"\"\n242\t        game = create_game()\n243\t        p1 = game.players[0]\n244\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n245\t        game.get_battlefield(p1).add(lorehold)\n246\t        lorehold.register_triggers(game)\n247\t\n248\t        triggers = game.trigger_manager.get_triggers_for_source(lorehold)\n249\t        upkeep_triggers = [\n250\t            t for t in triggers\n251\t            if t.event_type is BeginningOfUpkeepTriggeredEvent\n252\t        ]\n253\t        assert len(upkeep_triggers) >= 1, (\n254\t            \"Should have at least one trigger watching BeginningOfUpkeepTriggeredEvent\"\n255\t        )\n256\t\n257\t\n258\t# ---------------------------------------------------------------------------\n259\t# Opponent's upkeep trigger — condition\n260\t# ---------------------------------------------------------------------------\n261\t\n262\t\n263\tclass TestLoreholdUpkeepTriggerCondition:\n264\t    \"\"\"The upkeep trigger should fire only at the beginning of an opponent's\n265\t    upkeep, not the controller's own upkeep.\"\"\"\n266\t\n267\t    def test_trigger_fires_on_opponent_upkeep(self) -> None:\n268\t        \"\"\"The trigger should fire when the active player is the opponent\n269\t        (i.e. it's the opponent's upkeep).\"\"\"\n270\t        game = create_game()\n271\t        p1 = game.players[0]\n272\t        p2 = game.players[1]\n273\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n274\t        game.get_battlefield(p1).add(lorehold)\n275\t        lorehold.register_triggers(game)\n276\t\n277\t        # Set p2 (opponent) as the active player\n278\t        game.active_player_index = 1\n279\t\n280\t        triggers = game.trigger_manager.get_triggers_for_source(lorehold)\n281\t        upkeep_triggers = [\n282\t            t for t in triggers\n283\t            if t.event_type is BeginningOfUpkeepTriggeredEvent\n284\t        ]\n285\t        assert len(upkeep_triggers) >= 1\n286\t\n287\t        event = BeginningOfUpkeepTriggeredEvent()\n288\t        trigger = upkeep_triggers[0]\n289\t        if trigger.condition is not None:\n290\t            result = trigger.condition(game, event)\n291\t            assert result is True, (\n292\t                \"Trigger should fire on opponent's upkeep\"\n293\t            )\n294\t\n295\t    def test_trigger_does_not_fire_on_own_upkeep(self) -> None:\n296\t        \"\"\"The trigger should NOT fire when the active player is the\n297\t        Lorehold controller (own upkeep, not opponent's).\"\"\"\n298\t        game = create_game()\n299\t        p1 = game.players[0]\n300\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n301\t        game.get_battlefield(p1).add(lorehold)\n302\t        lorehold.register_triggers(game)\n303\t\n304\t        # Set p1 (controller) as the active player — it's p1's own upkeep\n305\t        game.active_player_index = 0\n306\t\n307\t        triggers = game.trigger_manager.get_triggers_for_source(lorehold)\n308\t        upkeep_triggers = [\n309\t            t for t in triggers\n310\t            if t.event_type is BeginningOfUpkeepTriggeredEvent\n311\t        ]\n312\t        assert len(upkeep_triggers) >= 1\n313\t\n314\t        event = BeginningOfUpkeepTriggeredEvent()\n315\t        trigger = upkeep_triggers[0]\n316\t        if trigger.condition is not None:\n317\t            result = trigger.condition(game, event)\n318\t            assert result is False, (\n319\t                \"Trigger should NOT fire on the controller's own upkeep\"\n320\t            )\n321\t        else:\n322\t            # If there's no condition, the trigger fires on every upkeep,\n323\t            # which is incorrect for \"each opponent's upkeep\"\n324\t            assert False, (\n325\t                \"Trigger should have a condition to restrict to opponent's upkeep\"\n326\t            )\n327\t\n328\t\n329\t# ---------------------------------------------------------------------------\n330\t# Opponent's upkeep trigger — effect (looting: discard then draw)\n331\t# ---------------------------------------------------------------------------\n332\t\n333\t\n334\tclass TestLoreholdUpkeepTriggerEffect:\n335\t    \"\"\"When the upkeep trigger resolves, the Lorehold controller may discard\n336\t    a card. If they do, they draw a card. This is a 'you may' (optional)\n337\t    discard-then-draw (looting) effect.\"\"\"\n338\t\n339\t    def test_looting_discards_a_card(self) -> None:\n340\t        \"\"\"When choosing to discard, a card should move from hand to graveyard.\"\"\"\n341\t        game = create_game(scripts=([True, None], []))\n342\t        p1 = game.players[0]\n343\t        p2 = game.players[1]\n344\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n345\t        game.get_battlefield(p1).add(lorehold)\n346\t        lorehold.register_triggers(game)\n347\t\n348\t        # Give p1 a card in hand to discard and a card in library to draw\n349\t        discard_card = Instant(name=\"Discard Me\", owner=p1, controller=p1)\n350\t        draw_card = Instant(name=\"Draw Me\", owner=p1, controller=p1)\n351\t        set_board_state(game, 0, hand=[discard_card])\n352\t        game.get_library(p1).add(draw_card)\n353\t\n354\t        # Set opponent as active player\n355\t        game.active_player_index = 1\n356\t\n357\t        # Fire the upkeep event\n358\t        event = BeginningOfUpkeepTriggeredEvent()\n359\t        game.trigger_manager.fire_event(game, event)\n360\t\n361\t        # Resolve the triggered ability\n362\t        if not game.stack.is_empty():\n363\t            stack_obj = game.stack.pop()\n364\t            stack_obj.on_resolve(game)\n365\t\n366\t        # The discarded card should be in the graveyard\n367\t        assert game.get_graveyard(p1).contains(discard_card), (\n368\t            \"Discarded card should be in the graveyard\"\n369\t        )\n370\t\n371\t    def test_looting_draws_a_card_after_discard(self) -> None:\n372\t        \"\"\"After discarding, the controller should draw a card.\"\"\"\n373\t        game = create_game(scripts=([True, None], []))\n374\t        p1 = game.players[0]\n375\t        p2 = game.players[1]\n376\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n377\t        game.get_battlefield(p1).add(lorehold)\n378\t        lorehold.register_triggers(game)\n379\t\n380\t        # Give p1 a card in hand to discard\n381\t        discard_card = Instant(name=\"Discard Me\", owner=p1, controller=p1)\n382\t        draw_card = Instant(name=\"Draw Me\", owner=p1, controller=p1)\n383\t        set_board_state(game, 0, hand=[discard_card])\n384\t        game.get_library(p1).add(draw_card)\n385\t\n386\t        # Set opponent as active player\n387\t        game.active_player_index = 1\n388\t\n389\t        # Fire the upkeep event\n390\t        event = BeginningOfUpkeepTriggeredEvent()\n391\t        game.trigger_manager.fire_event(game, event)\n392\t\n393\t        # Resolve the triggered ability\n394\t        if not game.stack.is_empty():\n395\t            stack_obj = game.stack.pop()\n396\t            stack_obj.on_resolve(game)\n397\t\n398\t        # p1 should have drawn a card (the draw card should be in hand)\n399\t        assert game.get_hand(p1).contains(draw_card), (\n400\t            \"Controller should have drawn a card after discarding\"\n401\t        )\n402\t\n403\t    def test_may_choose_not_to_discard(self) -> None:\n404\t        \"\"\"The discard is optional ('you may'). If the controller chooses\n405\t        not to discard, no discard or draw occurs.\"\"\"\n406\t        game = create_game(scripts=([False], []))\n407\t        p1 = game.players[0]\n408\t        p2 = game.players[1]\n409\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n410\t        game.get_battlefield(p1).add(lorehold)\n411\t        lorehold.register_triggers(game)\n412\t\n413\t        hand_card = Instant(name=\"Keep Me\", owner=p1, controller=p1)\n414\t        draw_card = Instant(name=\"Library Card\", owner=p1, controller=p1)\n415\t        set_board_state(game, 0, hand=[hand_card])\n416\t        game.get_library(p1).add(draw_card)\n417\t\n418\t        # Set opponent as active player\n419\t        game.active_player_index = 1\n420\t\n421\t        # Fire the upkeep event\n422\t        event = BeginningOfUpkeepTriggeredEvent()\n423\t        game.trigger_manager.fire_event(game, event)\n424\t\n425\t        # Resolve the triggered ability (player says \"no\")\n426\t        if not game.stack.is_empty():\n427\t            stack_obj = game.stack.pop()\n428\t            stack_obj.on_resolve(game)\n429\t\n430\t        # Hand should still contain the original card (not discarded)\n431\t        assert game.get_hand(p1).contains(hand_card), (\n432\t            \"Card should remain in hand when choosing not to discard\"\n433\t        )\n434\t        # Should NOT have drawn a card\n435\t        assert not game.get_hand(p1).contains(draw_card), (\n436\t            \"Should not draw a card when declining to discard\"\n437\t        )\n438\t\n439\t    def test_empty_hand_no_discard_no_draw(self) -> None:\n440\t        \"\"\"With an empty hand, the controller cannot discard, so no draw\n441\t        should occur either. The trigger should resolve without error.\"\"\"\n442\t        game = create_game(scripts=([False], []))\n443\t        p1 = game.players[0]\n444\t        p2 = game.players[1]\n445\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n446\t        game.get_battlefield(p1).add(lorehold)\n447\t        lorehold.register_triggers(game)\n448\t\n449\t        draw_card = Instant(name=\"Library Card\", owner=p1, controller=p1)\n450\t        set_board_state(game, 0, hand=[])\n451\t        game.get_library(p1).add(draw_card)\n452\t\n453\t        # Set opponent as active player\n454\t        game.active_player_index = 1\n455\t\n456\t        # Fire the upkeep event\n457\t        event = BeginningOfUpkeepTriggeredEvent()\n458\t        game.trigger_manager.fire_event(game, event)\n459\t\n460\t        # Resolve the triggered ability — should not crash\n461\t        if not game.stack.is_empty():\n462\t            stack_obj = game.stack.pop()\n463\t            stack_obj.on_resolve(game)\n464\t\n465\t        # Library card should still be in library (no draw happened)\n466\t        assert game.get_library(p1).contains(draw_card), (\n467\t            \"Should not draw when hand is empty and no discard can occur\"\n468\t        )\n469\t\n470\t\n471\t# ---------------------------------------------------------------------------\n472\t# Edge cases\n473\t# ---------------------------------------------------------------------------\n474\t\n475\t\n476\tclass TestLoreholdEdgeCases:\n477\t    \"\"\"Edge cases and boundary conditions for Lorehold, the Historian.\"\"\"\n478\t\n479\t    def test_multiple_instants_all_gain_miracle(self) -> None:\n480\t        \"\"\"All instant/sorcery cards in hand should gain miracle, not just one.\"\"\"\n481\t        game = create_game()\n482\t        p1 = game.players[0]\n483\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n484\t        game.get_battlefield(p1).add(lorehold)\n485\t        lorehold.register_triggers(game)\n486\t\n487\t        bolt = Instant(name=\"Lightning Bolt\", owner=p1, controller=p1,\n488\t                       mana_cost=ManaCost.parse(\"{R}\"))\n489\t        shock = Instant(name=\"Shock\", owner=p1, controller=p1,\n490\t                        mana_cost=ManaCost.parse(\"{R}\"))\n491\t        divination = Sorcery(name=\"Divination\", owner=p1, controller=p1,\n492\t                             mana_cost=ManaCost.parse(\"{2}{U}\"))\n493\t        set_board_state(game, 0, hand=[bolt, shock, divination])\n494\t\n495\t        for card in [bolt, shock, divination]:\n496\t            miracle_cost = getattr(card, \"miracle_cost\", None)\n497\t            assert miracle_cost is not None, (\n498\t                f\"{card.name} should have miracle_cost\"\n499\t            )\n500\t            assert miracle_cost == ManaCost.parse(\"{2}\"), (\n501\t                f\"{card.name} miracle cost should be {{2}}, got {miracle_cost}\"\n502\t            )\n503\t\n504\t    def test_mixed_hand_only_instants_sorceries_gain_miracle(self) -> None:\n505\t        \"\"\"In a mixed hand, only instants/sorceries should gain miracle.\"\"\"\n506\t        game = create_game()\n507\t        p1 = game.players[0]\n508\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n509\t        game.get_battlefield(p1).add(lorehold)\n510\t        lorehold.register_triggers(game)\n511\t\n512\t        bolt = Instant(name=\"Lightning Bolt\", owner=p1, controller=p1,\n513\t                       mana_cost=ManaCost.parse(\"{R}\"))\n514\t        bear = Creature(name=\"Grizzly Bears\", owner=p1, controller=p1,\n515\t                        base_power=2, base_toughness=2)\n516\t        div = Sorcery(name=\"Divination\", owner=p1, controller=p1,\n517\t                      mana_cost=ManaCost.parse(\"{2}{U}\"))\n518\t        set_board_state(game, 0, hand=[bolt, bear, div])\n519\t\n520\t        # Instants/sorceries get miracle\n521\t        assert getattr(bolt, \"miracle_cost\", None) is not None\n522\t        assert getattr(div, \"miracle_cost\", None) is not None\n523\t        # Creatures do not\n524\t        assert getattr(bear, \"miracle_cost\", None) is None\n525\t\n526\t    def test_trigger_fires_event_onto_stack(self) -> None:\n527\t        \"\"\"When the opponent's upkeep begins, the trigger should push\n528\t        something onto the stack.\"\"\"\n529\t        game = create_game()\n530\t        p1 = game.players[0]\n531\t        p2 = game.players[1]\n532\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n533\t        game.get_battlefield(p1).add(lorehold)\n534\t        lorehold.register_triggers(game)\n535\t\n536\t        # Set opponent as active player\n537\t        game.active_player_index = 1\n538\t\n539\t        assert game.stack.is_empty()\n540\t\n541\t        event = BeginningOfUpkeepTriggeredEvent()\n542\t        game.trigger_manager.fire_event(game, event)\n543\t\n544\t        assert not game.stack.is_empty(), (\n545\t            \"Upkeep trigger should push an ability onto the stack\"\n546\t        )\n547\t\n548\t    def test_trigger_controller_is_lorehold_controller(self) -> None:\n549\t        \"\"\"The registered trigger's controller should be the Lorehold controller.\"\"\"\n550\t        game = create_game()\n551\t        p1 = game.players[0]\n552\t        lorehold = LoreholdTheHistorian(owner=p1, controller=p1)\n553\t        game.get_battlefield(p1).add(lorehold)\n554\t        lorehold.register_triggers(game)\n555\t\n556\t        triggers = game.trigger_manager.get_triggers_for_source(lorehold)\n557\t        upkeep_triggers = [\n558\t            t for t in triggers\n559\t            if t.event_type is BeginningOfUpkeepTriggeredEvent\n560\t        ]\n561\t        assert len(upkeep_triggers) >= 1\n562\t        assert upkeep_triggers[0].controller is p1, (\n563\t            \"Trigger controller should be the Lorehold controller\"\n564\t        )\n565\t"}]},"parent_tool_use_id":"toolu_01LxNx53rTAeE5hJxNfLZLEC","session_id":"1fe34661-6a3c-4b16-8a42-0f618466dfcb","uuid":"c9b701fc-443a-4a2b-835d-84b622ac3592","timestamp":"2026-05-28T10:10:23.110Z","subagent_type":"Implementer","task_description":"Implement sos_201"}
