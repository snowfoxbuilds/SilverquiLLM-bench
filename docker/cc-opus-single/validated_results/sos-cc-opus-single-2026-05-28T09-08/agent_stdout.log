{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RWC6ktFsdMuD885iH293K4","type":"tool_result","content":"1\t\"\"\"Card implementation for Emeritus of Truce // Swords to Plowshares.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.events import EntersBattlefieldTriggeredEvent\n9\tfrom engine.triggers import TriggerRegistration\n10\tfrom engine.types import CardType, Keyword, ManaCost, TargetRequirement, Zone\n11\t\n12\tif TYPE_CHECKING:\n13\t    from engine.game_state import GameState\n14\t    from engine.player import Player\n15\t\n16\t\n17\tdef _is_player(obj: Any) -> bool:\n18\t    \"\"\"Return True if *obj* is a Player instance.\"\"\"\n19\t    from engine.player import Player as PlayerCls\n20\t    return isinstance(obj, PlayerCls)\n21\t\n22\t\n23\tclass EmeritusOfTruceSwordsToPlowshares(Creature):\n24\t    \"\"\"Emeritus of Truce // Swords to Plowshares\n25\t\n26\t    {1}{W}{W} Creature -- Cat Cleric -- 3/3\n27\t\n28\t    When this creature enters, target player creates a 1/1 white and black\n29\t    Inkling creature token with flying. Then if an opponent controls more\n30\t    creatures than you, this creature becomes prepared.\n31\t\n32\t    (While it's prepared, you may cast a copy of its spell. Doing so\n33\t    unprepares it.)\n34\t\n35\t    The prepare spell is Swords to Plowshares ({W} Instant):\n36\t    Exile target creature. Its controller gains life equal to its power.\n37\t\n38\t    SOS collector number 13.\n39\t    \"\"\"\n40\t\n41\t    def __init__(self, **kwargs: Any) -> None:\n42\t        kwargs.setdefault(\"name\", \"Emeritus of Truce\")\n43\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{W}{W}\"))\n44\t        kwargs.setdefault(\"subtypes\", {\"Cat\", \"Cleric\"})\n45\t        kwargs.setdefault(\"keywords\", Keyword(0))\n46\t        kwargs.setdefault(\"base_power\", 3)\n47\t        kwargs.setdefault(\"base_toughness\", 3)\n48\t        kwargs.setdefault(\n49\t            \"rules_text\",\n50\t            \"When this creature enters, target player creates a 1/1 white \"\n51\t            \"and black Inkling creature token with flying. Then if an \"\n52\t            \"opponent controls more creatures than you, this creature \"\n53\t            \"becomes prepared.\",\n54\t        )\n55\t        super().__init__(**kwargs)\n56\t        self.is_prepared: bool = False\n57\t\n58\t    # ------------------------------------------------------------------\n59\t    # Targeting -- target player for ETB\n60\t    # ------------------------------------------------------------------\n61\t\n62\t    def get_targets(self, game: GameState) -> list[Any]:\n63\t        \"\"\"Return a target requirement for a player (any player).\"\"\"\n64\t        return [\n65\t            TargetRequirement(\n66\t                filter_fn=_is_player,\n67\t                description=\"target player\",\n68\t                zone=Zone.BATTLEFIELD,\n69\t            )\n70\t        ]\n71\t\n72\t    # ------------------------------------------------------------------\n73\t    # ETB trigger registration\n74\t    # ------------------------------------------------------------------\n75\t\n76\t    def register_triggers(self, game: GameState) -> None:\n77\t        \"\"\"Register the ETB trigger for this creature.\"\"\"\n78\t        source = self\n79\t\n80\t        def _condition(game: GameState, event: EntersBattlefieldTriggeredEvent) -> bool:\n81\t            \"\"\"Only trigger when this creature enters the battlefield.\"\"\"\n82\t            return event.permanent is source\n83\t\n84\t        def _effect(game: GameState) -> None:\n85\t            \"\"\"Create Inkling token and check prepared condition.\"\"\"\n86\t            source.on_resolve(game)\n87\t\n88\t        controller = self.controller if self.controller is not None else self.owner\n89\t        if controller is None:\n90\t            return\n91\t\n92\t        trigger = TriggerRegistration(\n93\t            event_type=EntersBattlefieldTriggeredEvent,\n94\t            condition=_condition,\n95\t            effect=_effect,\n96\t            source=self,\n97\t            controller=controller,\n98\t        )\n99\t        game.trigger_manager.register(trigger)\n100\t\n101\t    # ------------------------------------------------------------------\n102\t    # Resolution -- create Inkling token, check prepared condition\n103\t    # ------------------------------------------------------------------\n104\t\n105\t    def on_resolve(self, game: GameState) -> None:\n106\t        \"\"\"Create a 1/1 Inkling token with flying for the target player.\n107\t\n108\t        Then check if any opponent controls more creatures than the\n109\t        controller. If so, this creature becomes prepared.\n110\t        \"\"\"\n111\t        from engine.game import create_token\n112\t\n113\t        chosen = getattr(self, \"chosen_targets\", None)\n114\t        if not chosen:\n115\t            return\n116\t\n117\t        target_player = chosen[0]\n118\t        if target_player is None:\n119\t            return\n120\t\n121\t        # Verify the target is a player\n122\t        if not _is_player(target_player):\n123\t            return\n124\t\n125\t        controller = self.controller if self.controller is not None else self.owner\n126\t        if controller is None:\n127\t            return\n128\t\n129\t        # Create a 1/1 white and black Inkling creature token with flying\n130\t        token = Creature(\n131\t            name=\"Inkling\",\n132\t            subtypes={\"Inkling\"},\n133\t            keywords=Keyword.FLYING,\n134\t            base_power=1,\n135\t            base_toughness=1,\n136\t            owner=target_player,\n137\t            controller=target_player,\n138\t        )\n139\t        # Set colors on the token (white and black)\n140\t        token.colors = [\"W\", \"B\"]\n141\t\n142\t        create_token(game, target_player, token)\n143\t\n144\t        # Check prepared condition: if any opponent controls more creatures\n145\t        # than the controller, this creature becomes prepared.\n146\t        my_creatures = self._count_creatures(game, controller)\n147\t        for player in game.players:\n148\t            if player is not controller:\n149\t                opp_creatures = self._count_creatures(game, player)\n150\t                if opp_creatures > my_creatures:\n151\t                    self.is_prepared = True\n152\t                    return\n153\t\n154\t    # ------------------------------------------------------------------\n155\t    # Helpers\n156\t    # ------------------------------------------------------------------\n157\t\n158\t    @staticmethod\n159\t    def _count_creatures(game: GameState, player: Any) -> int:\n160\t        \"\"\"Count the number of creatures a player controls on the battlefield.\"\"\"\n161\t        battlefield = game.get_battlefield(player)\n162\t        count = 0\n163\t        for obj in battlefield.get_all():\n164\t            if CardType.CREATURE in getattr(obj, \"card_types\", set()):\n165\t                count += 1\n166\t        return count\n167\t"}]},"parent_tool_use_id":"toolu_01RSxdPURqSEmkgi1J5XTBqG","session_id":"1fe34661-6a3c-4b16-8a42-0f618466dfcb","uuid":"a58f21bd-9458-4cfc-8f7a-2fcc5b4ede89","timestamp":"2026-05-28T09:37:01.965Z","subagent_type":"Reviewer","task_description":"Review sos_13 implementation"}
