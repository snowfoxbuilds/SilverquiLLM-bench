{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PzgAxDDK7MQBxBVLHkQgDH","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_120/card_impl.py b/cards/sos/sos_120/card_impl.py\n2\tindex fd0c1f4..79b3d37 100644\n3\t--- a/cards/sos/sos_120/card_impl.py\n4\t+++ b/cards/sos/sos_120/card_impl.py\n5\t@@ -2,15 +2,266 @@\n6\t \n7\t from __future__ import annotations\n8\t \n9\t-from engine.card import CardImpl\n10\t+import copy\n11\t+from typing import TYPE_CHECKING, Any\n12\t \n13\t-from typing import TYPE_CHECKING\n14\t+from engine.card import CardImpl, Creature, Instant, Land, Sorcery\n15\t+from engine.events import BeginningOfMainPhaseTriggeredEvent\n16\t+from engine.stack import StackObject\n17\t+from engine.triggers import TriggerRegistration\n18\t+from engine.types import CardType, ManaCost, Zone\n19\t \n20\t if TYPE_CHECKING:\n21\t     from engine.game_state import GameState\n22\t \n23\t \n24\t-class ImprovisationCapstone(CardImpl):\n25\t-    \"\"\"TODO: Implement Improvisation Capstone.\"\"\"\n26\t+class ImprovisationCapstone(Sorcery):\n27\t+    \"\"\"Improvisation Capstone -- {5}{R}{R} -- Sorcery -- Lesson.\n28\t \n29\t-    pass\n30\t+    Exile cards from the top of your library until you exile cards with\n31\t+    total mana value 4 or greater. You may cast any number of spells\n32\t+    from among them without paying their mana costs.\n33\t+\n34\t+    Paradigm (Then exile this spell. After you first resolve a spell\n35\t+    with this name, you may cast a copy of it from exile without paying\n36\t+    its mana cost at the beginning of each of your first main phases.)\n37\t+\n38\t+    SOS collector number 120.\n39\t+    \"\"\"\n40\t+\n41\t+    def __init__(self, **kwargs: Any) -> None:\n42\t+        kwargs.setdefault(\"name\", \"Improvisation Capstone\")\n43\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{5}{R}{R}\"))\n44\t+        kwargs.setdefault(\"subtypes\", {\"Lesson\"})\n45\t+        kwargs.setdefault(\n46\t+            \"rules_text\",\n47\t+            \"Exile cards from the top of your library until you exile cards \"\n48\t+            \"with total mana value 4 or greater. You may cast any number of \"\n49\t+            \"spells from among them without paying their mana costs.\\n\"\n50\t+            \"Paradigm (Then exile this spell. After you first resolve a spell \"\n51\t+            \"with this name, you may cast a copy of it from exile without \"\n52\t+            \"paying its mana cost at the beginning of each of your first \"\n53\t+            \"main phases.)\",\n54\t+        )\n55\t+        super().__init__(**kwargs)\n56\t+\n57\t+    # ------------------------------------------------------------------\n58\t+    # Resolution\n59\t+    # ------------------------------------------------------------------\n60\t+\n61\t+    def on_resolve(self, game: \"GameState\") -> None:\n62\t+        \"\"\"Resolve Improvisation Capstone:\n63\t+\n64\t+        1. Exile cards from the top of library until total MV >= 4.\n65\t+        2. Cast any number of non-land spells from among them for free.\n66\t+        3. Paradigm: exile self, register delayed trigger for recurrence.\n67\t+        \"\"\"\n68\t+        controller = self.controller if self.controller is not None else self.owner\n69\t+        if controller is None:\n70\t+            # Still need to handle paradigm self-exile even with no controller\n71\t+            return\n72\t+\n73\t+        # --- Step 1: Exile from library until total MV >= 4 ---\n74\t+        exiled_cards = self._exile_from_library(game, controller)\n75\t+\n76\t+        # --- Step 2: Free-cast spells from among exiled cards ---\n77\t+        self._free_cast_exiled(game, controller, exiled_cards)\n78\t+\n79\t+        # --- Step 3: Paradigm -- self-exile ---\n80\t+        self._paradigm_self_exile(game, controller)\n81\t+\n82\t+        # --- Step 4: Paradigm -- register delayed trigger for recurrence ---\n83\t+        self._paradigm_register_recurrence(game, controller)\n84\t+\n85\t+    # ------------------------------------------------------------------\n86\t+    # Internal helpers\n87\t+    # ------------------------------------------------------------------\n88\t+\n89\t+    def _exile_from_library(\n90\t+        self, game: \"GameState\", controller: Any\n91\t+    ) -> list[Any]:\n92\t+        \"\"\"Exile cards from top of library until total MV >= 4.\n93\t+\n94\t+        Returns the list of cards exiled from the library.\n95\t+        \"\"\"\n96\t+        library = controller.zones[Zone.LIBRARY]\n97\t+        exile = game.get_exile(controller)\n98\t+        exiled: list[Any] = []\n99\t+        total_mv = 0\n100\t+\n101\t+        while len(library) > 0 and total_mv < 4:\n102\t+            # Top of library is the last element\n103\t+            top_cards = library.top(1)\n104\t+            if not top_cards:\n105\t+                break\n106\t+            card = top_cards[0]\n107\t+            library.remove(card)\n108\t+            exile.add(card)\n109\t+            exiled.append(card)\n110\t+\n111\t+            card_cost = getattr(card, \"mana_cost\", None)\n112\t+            if card_cost is not None:\n113\t+                total_mv += card_cost.cmc\n114\t+            # Cards with no mana_cost contribute 0\n115\t+\n116\t+        return exiled\n117\t+\n118\t+    def _free_cast_exiled(\n119\t+        self, game: \"GameState\", controller: Any, exiled_cards: list[Any]\n120\t+    ) -> None:\n121\t+        \"\"\"Cast any number of spells from among the exiled cards for free.\n122\t+\n123\t+        Lands are not spells and cannot be cast this way.  Cards remain in\n124\t+        exile until their StackObject resolves -- this matches the MTG rule\n125\t+        that a spell moves from its zone to the stack when cast and then to\n126\t+        its destination on resolution.\n127\t+        \"\"\"\n128\t+        exile = game.get_exile(controller)\n129\t+\n130\t+        for card in exiled_cards:\n131\t+            # Lands cannot be cast as spells\n132\t+            if isinstance(card, Land):\n133\t+                continue\n134\t+            card_types = getattr(card, \"card_types\", set())\n135\t+            if CardType.LAND in card_types:\n136\t+                continue\n137\t+\n138\t+            # Set up ownership/control for the free cast\n139\t+            card.controller = controller\n140\t+            if card.owner is None:\n141\t+                card.owner = controller\n142\t+\n143\t+            # For creatures, push a StackObject that resolves to battlefield\n144\t+            if CardType.CREATURE in card_types:\n145\t+                def _make_creature_resolve(c: Any) -> Any:\n146\t+                    def _resolve(g: \"GameState\") -> None:\n147\t+                        # Remove from exile when the spell resolves\n148\t+                        ex = g.get_exile(controller)\n149\t+                        if ex.contains(c):\n150\t+                            ex.remove(c)\n151\t+                        c.on_resolve(g)\n152\t+                        bf = g.get_battlefield(controller)\n153\t+                        bf.add(c)\n154\t+                        c.summoning_sick = True\n155\t+                        if hasattr(c, \"register_triggers\"):\n156\t+                            c.register_triggers(g)\n157\t+                        if hasattr(c, \"register_replacement_effects\"):\n158\t+                            c.register_replacement_effects(g)\n159\t+                    return _resolve\n160\t+\n161\t+                stack_obj = StackObject(\n162\t+                    source=card,\n163\t+                    controller=controller,\n164\t+                    targets=[],\n165\t+                    on_resolve=_make_creature_resolve(card),\n166\t+                )\n167\t+                game.stack.push(stack_obj)\n168\t+            elif CardType.INSTANT in card_types or CardType.SORCERY in card_types or isinstance(card, (Instant, Sorcery)):\n169\t+                # For instants/sorceries, push to stack; on resolve go to graveyard\n170\t+                def _make_spell_resolve(c: Any) -> Any:\n171\t+                    def _resolve(g: \"GameState\") -> None:\n172\t+                        # Remove from exile when the spell resolves\n173\t+                        ex = g.get_exile(controller)\n174\t+                        if ex.contains(c):\n175\t+                            ex.remove(c)\n176\t+                        c.on_resolve(g)\n177\t+                        gy = g.get_graveyard(controller)\n178\t+                        gy.add(c)\n179\t+                    return _resolve\n180\t+\n181\t+                stack_obj = StackObject(\n182\t+                    source=card,\n183\t+                    controller=controller,\n184\t+                    targets=[],\n185\t+                    on_resolve=_make_spell_resolve(card),\n186\t+                )\n187\t+                game.stack.push(stack_obj)\n188\t+            else:\n189\t+                # For other permanents (enchantments, artifacts, planeswalkers),\n190\t+                # push to stack; on resolve go to battlefield like creatures\n191\t+                def _make_permanent_resolve(c: Any) -> Any:\n192\t+                    def _resolve(g: \"GameState\") -> None:\n193\t+                        # Remove from exile when the spell resolves\n194\t+                        ex = g.get_exile(controller)\n195\t+                        if ex.contains(c):\n196\t+                            ex.remove(c)\n197\t+                        c.on_resolve(g)\n198\t+                        bf = g.get_battlefield(controller)\n199\t+                        bf.add(c)\n200\t+                        if hasattr(c, \"register_triggers\"):\n201\t+                            c.register_triggers(g)\n202\t+                        if hasattr(c, \"register_replacement_effects\"):\n203\t+                            c.register_replacement_effects(g)\n204\t+                    return _resolve\n205\t+\n206\t+                stack_obj = StackObject(\n207\t+                    source=card,\n208\t+                    controller=controller,\n209\t+                    targets=[],\n210\t+                    on_resolve=_make_permanent_resolve(card),\n211\t+                )\n212\t+                game.stack.push(stack_obj)\n213\t+\n214\t+    def _paradigm_self_exile(self, game: \"GameState\", controller: Any) -> None:\n215\t+        \"\"\"Paradigm: exile this spell after resolution (instead of graveyard).\n216\t+\n217\t+        Looks for self on the stack zone and moves to exile.\n218\t+        \"\"\"\n219\t+        exile = game.get_exile(controller)\n220\t+\n221\t+        # Try to find and remove self from the stack zone\n222\t+        stack_zone = controller.zones[Zone.STACK]\n223\t+        if stack_zone.contains(self):\n224\t+            stack_zone.remove(self)\n225\t+\n226\t+        # Add to exile if not already there\n227\t+        if not exile.contains(self):\n228\t+            exile.add(self)\n229\t+\n230\t+    def _paradigm_register_recurrence(\n231\t+        self, game: \"GameState\", controller: Any\n232\t+    ) -> None:\n233\t+        \"\"\"Paradigm: register a delayed trigger that fires at the beginning\n234\t+        of each of the controller's first main phases, creating a copy of\n235\t+        this spell that can be cast for free.\n236\t+        \"\"\"\n237\t+        source = self\n238\t+        capstone_controller = controller\n239\t+\n240\t+        def _condition(game: \"GameState\", event: BeginningOfMainPhaseTriggeredEvent) -> bool:\n241\t+            \"\"\"Only fire for the controller's main phase.\"\"\"\n242\t+            return getattr(event, \"player\", None) is capstone_controller\n243\t+\n244\t+        def _effect(game: \"GameState\") -> None:\n245\t+            \"\"\"Create a copy of Improvisation Capstone and put it on the stack\n246\t+            (or in exile for casting). The copy has the same on_resolve logic.\"\"\"\n247\t+            # Create a copy of the capstone\n248\t+            capstone_copy = ImprovisationCapstone(\n249\t+                owner=capstone_controller,\n250\t+                controller=capstone_controller,\n251\t+            )\n252\t+\n253\t+            # Put the copy on the stack as a free-cast spell.\n254\t+            # IMPORTANT: Only run the exile-from-library and free-cast steps,\n255\t+            # NOT the paradigm self-exile and trigger registration.  Otherwise\n256\t+            # each copy would register another trigger, causing exponential growth.\n257\t+            def _copy_resolve(g: \"GameState\") -> None:\n258\t+                exiled = capstone_copy._exile_from_library(g, capstone_controller)\n259\t+                capstone_copy._free_cast_exiled(g, capstone_controller, exiled)\n260\t+\n261\t+            stack_obj = StackObject(\n262\t+                source=capstone_copy,\n263\t+                controller=capstone_controller,\n264\t+                targets=[],\n265\t+                on_resolve=_copy_resolve,\n266\t+            )\n267\t+            game.stack.push(stack_obj)\n268\t+\n269\t+        trigger = TriggerRegistration(\n270\t+            event_type=BeginningOfMainPhaseTriggeredEvent,\n271\t+            condition=_condition,\n272\t+            effect=_effect,\n273\t+            source=source,\n274\t+            controller=capstone_controller,\n275\t+        )\n276\t+        game.trigger_manager.register(trigger)\n277\t"}]},"parent_tool_use_id":"toolu_013kGVzSYUhNgLJ9L6CnZfuC","session_id":"1fe34661-6a3c-4b16-8a42-0f618466dfcb","uuid":"b6e0d01d-6a2a-43c0-a0bf-ec1db2a7dbd3","timestamp":"2026-05-28T10:06:42.645Z","subagent_type":"Implementer","task_description":"Revise sos_120 per review"}
