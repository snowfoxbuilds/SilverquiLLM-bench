{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017JLk6WftU7KaarS4RiuLNL","type":"tool_result","content":"1\t\"\"\"Card implementation for Burst Lightning.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\tfrom typing import TYPE_CHECKING, Any\n5\tfrom engine.card import Instant, Sorcery\n6\tfrom engine.continuous_effects import (\n7\t    ContinuousEffect,\n8\t    DURATION_END_OF_TURN,\n9\t    Layer,\n10\t    SubLayer,\n11\t)\n12\tfrom engine.types import CardType, ManaCost, TargetRequirement, Zone\n13\tif TYPE_CHECKING:\n14\t    from engine.game_state import GameState\n15\t\n16\t    from cards.registry import CardRegistry\n17\t\n18\tdef _get_chosen_target(card: Any, game: Any) -> Any:\n19\t    \"\"\"Retrieve the first chosen target for a spell.\n20\t\n21\t    Looks for ``chosen_targets`` (set by :func:`cast_spell` during the\n22\t    real casting pipeline) first, then falls back to the test-backdoor\n23\t    attribute ``_resolve_target``.\n24\t    \"\"\"\n25\t    # Real pipeline: targets stored by cast_spell on the card\n26\t    chosen = getattr(card, \"chosen_targets\", None)\n27\t    if chosen:\n28\t        return chosen[0]\n29\t    # Test backdoor: attribute set directly by test code\n30\t    return getattr(card, \"_resolve_target\", None)\n31\t\n32\tclass BurstLightning(Instant):\n33\t    \"\"\"Burst Lightning — {R} — Deal 2 damage to any target (base mode).\n34\t\n35\t    Kicker {4} is not implemented; always deals 2 damage.\n36\t    \"\"\"\n37\t\n38\t    def __init__(self, **kwargs: Any) -> None:\n39\t        kwargs.setdefault(\"name\", \"Burst Lightning\")\n40\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{R}\"))\n41\t        kwargs.setdefault(\n42\t            \"rules_text\",\n43\t            \"Kicker {4}\\n\"\n44\t            \"Burst Lightning deals 2 damage to any target. \"\n45\t            \"If this spell was kicked, it deals 4 damage instead.\",\n46\t        )\n47\t        super().__init__(**kwargs)\n48\t\n49\t    def get_targets(self, game: GameState) -> list[Any]:\n50\t        \"\"\"Any target: any creature on the battlefield or any player.\"\"\"\n51\t        targets: list[Any] = []\n52\t        for player in game.players:\n53\t            targets.append(player)\n54\t            for obj in game.get_battlefield(player).get_all():\n55\t                if CardType.CREATURE in getattr(obj, \"card_types\", set()):\n56\t                    targets.append(obj)\n57\t        return [\n58\t            TargetRequirement(\n59\t                filter_fn=lambda obj: CardType.CREATURE in getattr(obj, \"card_types\", set()) or hasattr(obj, \"life\"),\n60\t                description=\"any target\",\n61\t                zone=Zone.BATTLEFIELD,\n62\t            )\n63\t        ]\n64\t\n65\t    def on_resolve(self, game: GameState) -> None:\n66\t        \"\"\"Deal 2 damage to the chosen target (base, unkicked).\"\"\"\n67\t        from engine.game import deal_damage\n68\t\n69\t        target = _get_chosen_target(self, game)\n70\t        if target is not None:\n71\t            deal_damage(game, self, target, 2)\n72\t"}]},"parent_tool_use_id":"toolu_01YK3sAhTenQdHp7jtu2hapu","session_id":"1fe34661-6a3c-4b16-8a42-0f618466dfcb","uuid":"03046e9c-4ef0-4b69-a254-7e70f22c526f","timestamp":"2026-05-28T09:28:33.478Z","subagent_type":"Reviewer","task_description":"Review sos_4 implementation"}
