{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012uw4Fw29aehUxvgaw1PwKi","type":"tool_result","content":"1\t\"\"\"Card implementation for Progenitus.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom typing import TYPE_CHECKING, Any\n4\tfrom engine.card import Creature\n5\tfrom engine.protection import ProtectionAbility\n6\tfrom engine.events import MoveToGraveyardReplacementEvent\n7\tfrom engine.replacement_effects import ReplacementEffect\n8\tfrom engine.types import ManaCost, Supertype, Zone\n9\tif TYPE_CHECKING:\n10\t    from engine.game_state import GameState\n11\t\n12\tclass Progenitus(Creature):\n13\t    \"\"\"Progenitus — {W}{W}{U}{U}{B}{B}{R}{R}{G}{G} — 10/10 — Legendary Hydra Avatar.\n14\t\n15\t    Protection from everything.\n16\t    If Progenitus would be put into a graveyard from anywhere, reveal\n17\t    Progenitus and shuffle it into its owner's library instead.\n18\t\n19\t    FDN collector number 244.\n20\t    \"\"\"\n21\t\n22\t    def __init__(self, **kwargs: Any) -> None:\n23\t        kwargs.setdefault('name', 'Progenitus')\n24\t        kwargs.setdefault('mana_cost', ManaCost.parse('{W}{W}{U}{U}{B}{B}{R}{R}{G}{G}'))\n25\t        kwargs.setdefault('subtypes', {'Hydra', 'Avatar'})\n26\t        kwargs.setdefault('supertypes', {Supertype.LEGENDARY})\n27\t        kwargs.setdefault('base_power', 10)\n28\t        kwargs.setdefault('base_toughness', 10)\n29\t        kwargs.setdefault('rules_text', \"Protection from everything\\nIf Progenitus would be put into a graveyard from anywhere, reveal Progenitus and shuffle it into its owner's library instead.\")\n30\t        super().__init__(**kwargs)\n31\t        self._init_protection()\n32\t\n33\t    def _init_protection(self) -> None:\n34\t        \"\"\"Set up protection from everything. Called from __init__ and\n35\t        can be re-invoked after characteristic resets.\"\"\"\n36\t        self.protections = [ProtectionAbility(quality='everything', predicate=lambda source: True)]\n37\t\n38\t    def _reset_characteristics(self) -> None:\n39\t        \"\"\"Override to reapply protection from everything after reset.\"\"\"\n40\t        super()._reset_characteristics()\n41\t        self._init_protection()\n42\t\n43\t    def register_replacement_effects(self, game: 'GameState') -> None:\n44\t        \"\"\"Register graveyard-shuffle replacement effect.\n45\t\n46\t        Registers a single :class:`~engine.events.MoveToGraveyardReplacementEvent`\n47\t        handler; the engine's zone-move pipeline dispatches subclass events\n48\t        (creature_dies, sacrifice, etc.) to this parent-type handler automatically.\n49\t        \"\"\"\n50\t        source = self\n51\t\n52\t        def _condition(game: Any, event: dict) -> bool:\n53\t            return event.card is source\n54\t\n55\t        def _replacement(game: Any, event: dict) -> dict:\n56\t            owner = getattr(source, 'owner', None)\n57\t            if owner is not None:\n58\t                library = owner.zones[Zone.LIBRARY]\n59\t                library.add(source)\n60\t                library.shuffle()\n61\t            event.prevented = True\n62\t            return event\n63\t        controller = getattr(self, 'controller', None)\n64\t        game.replacement_manager.register(ReplacementEffect(event_type=MoveToGraveyardReplacementEvent, source=self, condition=_condition, replacement=_replacement, controller=controller))\n65\t"}]},"parent_tool_use_id":"toolu_01GmsndJiRpYV9ifKJBLLPN6","session_id":"1fe34661-6a3c-4b16-8a42-0f618466dfcb","uuid":"3001e7ba-fe2d-4522-8508-b2dd8de707e2","timestamp":"2026-05-28T09:35:15.482Z","subagent_type":"Implementer","task_description":"Implement sos_13"}
