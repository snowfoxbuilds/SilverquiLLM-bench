{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AYt8FWvd2JvX2dktcr8R9M","type":"tool_result","content":"1\t\"\"\"Tests for SOS 97 — Ral Zarek, Guest Lecturer.\n2\t\n3\tRal Zarek, Guest Lecturer is a {1}{B}{B} Legendary Planeswalker — Ral\n4\twith starting loyalty 3.\n5\t\n6\tRequirements tested:\n7\t1. Static properties: name, mana cost, card types, supertypes, subtypes, starting loyalty.\n8\t2. Loyalty abilities: four abilities at +1, -1, -2, -7.\n9\t3. +1: Surveil 2 — look at top 2 cards of library, put any number into\n10\t   graveyard and rest on top in any order.\n11\t4. -1: Any number of target players each discard a card.\n12\t5. -2: Return target creature card with mana value 3 or less from your\n13\t   graveyard to the battlefield.\n14\t6. -7: Flip five coins. Target opponent skips their next X turns, where\n15\t   X is the number of coins that came up heads.\n16\t\"\"\"\n17\t\n18\tfrom __future__ import annotations\n19\t\n20\tfrom typing import Any\n21\t\n22\tfrom cards.sos.sos_97.card_impl import RalZarekGuestLecturer\n23\tfrom engine.card import Creature, Instant, LoyaltyAbility, Planeswalker\n24\tfrom engine.types import (\n25\t    CardType,\n26\t    ManaCost,\n27\t    ManaType,\n28\t    Supertype,\n29\t    Zone,\n30\t)\n31\tfrom test_utils import create_game, set_board_state\n32\t\n33\t\n34\t# ---------------------------------------------------------------------------\n35\t# Static properties\n36\t# ---------------------------------------------------------------------------\n37\t\n38\t\n39\tclass TestRalZarekProperties:\n40\t    \"\"\"Static card data should match the SOS 97 spec.\"\"\"\n41\t\n42\t    def test_is_planeswalker(self) -> None:\n43\t        card = RalZarekGuestLecturer(owner=None)\n44\t        assert isinstance(card, Planeswalker)\n45\t\n46\t    def test_name(self) -> None:\n47\t        assert RalZarekGuestLecturer(owner=None).name == \"Ral Zarek, Guest Lecturer\"\n48\t\n49\t    def test_mana_cost(self) -> None:\n50\t        assert RalZarekGuestLecturer(owner=None).mana_cost == ManaCost.parse(\"{1}{B}{B}\")\n51\t\n52\t    def test_starting_loyalty(self) -> None:\n53\t        card = RalZarekGuestLecturer(owner=None)\n54\t        assert card.starting_loyalty == 3\n55\t\n56\t    def test_initial_loyalty_equals_starting(self) -> None:\n57\t        card = RalZarekGuestLecturer(owner=None)\n58\t        assert card.loyalty == 3\n59\t\n60\t    def test_is_legendary(self) -> None:\n61\t        card = RalZarekGuestLecturer(owner=None)\n62\t        assert Supertype.LEGENDARY in card.supertypes\n63\t\n64\t    def test_has_ral_subtype(self) -> None:\n65\t        card = RalZarekGuestLecturer(owner=None)\n66\t        assert \"Ral\" in card.subtypes\n67\t\n68\t    def test_has_planeswalker_card_type(self) -> None:\n69\t        card = RalZarekGuestLecturer(owner=None)\n70\t        assert CardType.PLANESWALKER in card.card_types\n71\t\n72\t\n73\t# ---------------------------------------------------------------------------\n74\t# Loyalty abilities — structure\n75\t# ---------------------------------------------------------------------------\n76\t\n77\t\n78\tclass TestRalZarekLoyaltyAbilities:\n79\t    \"\"\"get_loyalty_abilities should return four LoyaltyAbility objects\n80\t    with the correct loyalty costs.\"\"\"\n81\t\n82\t    def test_returns_four_abilities(self) -> None:\n83\t        card = RalZarekGuestLecturer(owner=None)\n84\t        abilities = card.get_loyalty_abilities()\n85\t        assert isinstance(abilities, list)\n86\t        assert len(abilities) == 4\n87\t\n88\t    def test_all_are_loyalty_abilities(self) -> None:\n89\t        card = RalZarekGuestLecturer(owner=None)\n90\t        abilities = card.get_loyalty_abilities()\n91\t        for ability in abilities:\n92\t            assert isinstance(ability, LoyaltyAbility)\n93\t\n94\t    def test_loyalty_costs_are_correct(self) -> None:\n95\t        card = RalZarekGuestLecturer(owner=None)\n96\t        abilities = card.get_loyalty_abilities()\n97\t        costs = [a.loyalty_cost for a in abilities]\n98\t        assert costs == [1, -1, -2, -7]\n99\t\n100\t\n101\t# ---------------------------------------------------------------------------\n102\t# +1: Surveil 2\n103\t# ---------------------------------------------------------------------------\n104\t\n105\t\n106\tclass TestRalZarekSurveil:\n107\t    \"\"\"+1: Surveil 2 — look at top 2 cards, put any number into graveyard,\n108\t    rest on top of library.\"\"\"\n109\t\n110\t    def test_surveil_moves_cards_from_library(self) -> None:\n111\t        \"\"\"After activating +1, cards should move from library to either\n112\t        graveyard or remain on top of library. The total across both zones\n113\t        should account for the 2 cards surveiled.\"\"\"\n114\t        game = create_game()\n115\t        p1 = game.players[0]\n116\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n117\t\n118\t        # Set up library with known cards\n119\t        card_a = Creature(name=\"Card A\", owner=p1, controller=p1,\n120\t                          base_power=1, base_toughness=1)\n121\t        card_b = Creature(name=\"Card B\", owner=p1, controller=p1,\n122\t                          base_power=2, base_toughness=2)\n123\t        card_c = Creature(name=\"Card C\", owner=p1, controller=p1,\n124\t                          base_power=3, base_toughness=3)\n125\t        # Library bottom to top: card_c (bottom), card_a, card_b (top)\n126\t        p1.zones[Zone.LIBRARY]._objects.clear()\n127\t        p1.zones[Zone.LIBRARY].add(card_c)\n128\t        p1.zones[Zone.LIBRARY].add(card_a)\n129\t        p1.zones[Zone.LIBRARY].add(card_b)\n130\t\n131\t        lib_before = len(p1.zones[Zone.LIBRARY])\n132\t        gy_before = len(p1.zones[Zone.GRAVEYARD])\n133\t\n134\t        abilities = card.get_loyalty_abilities()\n135\t        plus_one = abilities[0]\n136\t        assert plus_one.loyalty_cost == 1\n137\t        plus_one.effect(game)\n138\t\n139\t        lib_after = len(p1.zones[Zone.LIBRARY])\n140\t        gy_after = len(p1.zones[Zone.GRAVEYARD])\n141\t\n142\t        # The 2 surveiled cards should either remain in library or go to GY.\n143\t        # Some must have moved (simplified surveil puts all to GY) OR stayed.\n144\t        # At minimum, the total should be consistent:\n145\t        assert lib_after + gy_after == lib_before + gy_before\n146\t\n147\t    def test_surveil_with_fewer_than_two_cards_in_library(self) -> None:\n148\t        \"\"\"Surveil 2 with only 1 card in library should not crash and should\n149\t        surveil that 1 card.\"\"\"\n150\t        game = create_game()\n151\t        p1 = game.players[0]\n152\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n153\t\n154\t        single_card = Creature(name=\"Single\", owner=p1, controller=p1,\n155\t                               base_power=1, base_toughness=1)\n156\t        p1.zones[Zone.LIBRARY]._objects.clear()\n157\t        p1.zones[Zone.LIBRARY].add(single_card)\n158\t\n159\t        abilities = card.get_loyalty_abilities()\n160\t        plus_one = abilities[0]\n161\t        # Should not raise even with only 1 card\n162\t        plus_one.effect(game)\n163\t\n164\t    def test_surveil_with_empty_library(self) -> None:\n165\t        \"\"\"Surveil 2 with an empty library should be a no-op and not crash.\"\"\"\n166\t        game = create_game()\n167\t        p1 = game.players[0]\n168\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n169\t\n170\t        p1.zones[Zone.LIBRARY]._objects.clear()\n171\t        assert len(p1.zones[Zone.LIBRARY]) == 0\n172\t\n173\t        abilities = card.get_loyalty_abilities()\n174\t        plus_one = abilities[0]\n175\t        # Should not raise\n176\t        plus_one.effect(game)\n177\t        assert len(p1.zones[Zone.GRAVEYARD]) == 0\n178\t\n179\t\n180\t# ---------------------------------------------------------------------------\n181\t# -1: Any number of target players each discard a card\n182\t# ---------------------------------------------------------------------------\n183\t\n184\t\n185\tclass TestRalZarekDiscard:\n186\t    \"\"\"-1: Any number of target players each discard a card.\"\"\"\n187\t\n188\t    def test_discard_single_player(self) -> None:\n189\t        \"\"\"When targeting one player, that player should discard a card.\"\"\"\n190\t        game = create_game()\n191\t        p1 = game.players[0]\n192\t        p2 = game.players[1]\n193\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n194\t\n195\t        # Give p2 a card in hand\n196\t        hand_card = Creature(name=\"Hand Bear\", owner=p2, controller=p2,\n197\t                             base_power=2, base_toughness=2)\n198\t        set_board_state(game, 1, hand=[hand_card])\n199\t\n200\t        hand_before = len(p2.zones[Zone.HAND])\n201\t        assert hand_before == 1\n202\t\n203\t        abilities = card.get_loyalty_abilities()\n204\t        minus_one = abilities[1]\n205\t        assert minus_one.loyalty_cost == -1\n206\t\n207\t        # Set up targeting — target p2\n208\t        card.chosen_targets = [p2]\n209\t        card._resolve_targets = [p2]\n210\t        minus_one.effect(game)\n211\t\n212\t        hand_after = len(p2.zones[Zone.HAND])\n213\t        assert hand_after == hand_before - 1\n214\t\n215\t    def test_discard_both_players(self) -> None:\n216\t        \"\"\"When targeting both players, each should discard a card.\"\"\"\n217\t        game = create_game()\n218\t        p1 = game.players[0]\n219\t        p2 = game.players[1]\n220\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n221\t\n222\t        p1_card = Creature(name=\"P1 Card\", owner=p1, controller=p1,\n223\t                           base_power=1, base_toughness=1)\n224\t        p2_card = Creature(name=\"P2 Card\", owner=p2, controller=p2,\n225\t                           base_power=1, base_toughness=1)\n226\t        set_board_state(game, 0, hand=[p1_card])\n227\t        set_board_state(game, 1, hand=[p2_card])\n228\t\n229\t        p1_hand_before = len(p1.zones[Zone.HAND])\n230\t        p2_hand_before = len(p2.zones[Zone.HAND])\n231\t\n232\t        abilities = card.get_loyalty_abilities()\n233\t        minus_one = abilities[1]\n234\t        card.chosen_targets = [p1, p2]\n235\t        card._resolve_targets = [p1, p2]\n236\t        minus_one.effect(game)\n237\t\n238\t        assert len(p1.zones[Zone.HAND]) == p1_hand_before - 1\n239\t        assert len(p2.zones[Zone.HAND]) == p2_hand_before - 1\n240\t\n241\t    def test_discard_player_with_empty_hand(self) -> None:\n242\t        \"\"\"Targeting a player with an empty hand should not crash.\"\"\"\n243\t        game = create_game()\n244\t        p1 = game.players[0]\n245\t        p2 = game.players[1]\n246\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n247\t\n248\t        set_board_state(game, 1, hand=[])\n249\t        assert len(p2.zones[Zone.HAND]) == 0\n250\t\n251\t        abilities = card.get_loyalty_abilities()\n252\t        minus_one = abilities[1]\n253\t        card.chosen_targets = [p2]\n254\t        card._resolve_targets = [p2]\n255\t        # Should not raise\n256\t        minus_one.effect(game)\n257\t\n258\t\n259\t# ---------------------------------------------------------------------------\n260\t# -2: Return target creature card with mana value 3 or less from graveyard\n261\t# ---------------------------------------------------------------------------\n262\t\n263\t\n264\tclass TestRalZarekReanimate:\n265\t    \"\"\"-2: Return target creature card with mana value 3 or less from your\n266\t    graveyard to the battlefield.\"\"\"\n267\t\n268\t    def test_returns_creature_to_battlefield(self) -> None:\n269\t        \"\"\"A creature with MV <= 3 in the graveyard should be moved to the\n270\t        battlefield when the -2 ability resolves.\"\"\"\n271\t        game = create_game()\n272\t        p1 = game.players[0]\n273\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n274\t\n275\t        # Creature with MV 2 in graveyard\n276\t        bear = Creature(name=\"Grizzly Bears\", owner=p1, controller=p1,\n277\t                        mana_cost=ManaCost.parse(\"{1}{G}\"),\n278\t                        base_power=2, base_toughness=2)\n279\t        set_board_state(game, 0, graveyard=[bear])\n280\t\n281\t        assert p1.zones[Zone.GRAVEYARD].contains(bear)\n282\t        assert not game.get_battlefield(p1).contains(bear)\n283\t\n284\t        abilities = card.get_loyalty_abilities()\n285\t        minus_two = abilities[2]\n286\t        assert minus_two.loyalty_cost == -2\n287\t\n288\t        card.chosen_targets = [bear]\n289\t        card._resolve_target = bear\n290\t        minus_two.effect(game)\n291\t\n292\t        # Bear should now be on the battlefield\n293\t        assert game.get_battlefield(p1).contains(bear)\n294\t        # Bear should no longer be in the graveyard\n295\t        assert not p1.zones[Zone.GRAVEYARD].contains(bear)\n296\t\n297\t    def test_returns_creature_with_mv_exactly_three(self) -> None:\n298\t        \"\"\"A creature with mana value exactly 3 should be a valid target.\"\"\"\n299\t        game = create_game()\n300\t        p1 = game.players[0]\n301\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n302\t\n303\t        mv3_creature = Creature(name=\"MV3 Creature\", owner=p1, controller=p1,\n304\t                                mana_cost=ManaCost.parse(\"{1}{B}{B}\"),\n305\t                                base_power=3, base_toughness=3)\n306\t        set_board_state(game, 0, graveyard=[mv3_creature])\n307\t\n308\t        abilities = card.get_loyalty_abilities()\n309\t        minus_two = abilities[2]\n310\t        card.chosen_targets = [mv3_creature]\n311\t        card._resolve_target = mv3_creature\n312\t        minus_two.effect(game)\n313\t\n314\t        assert game.get_battlefield(p1).contains(mv3_creature)\n315\t\n316\t    def test_returns_creature_with_mv_zero(self) -> None:\n317\t        \"\"\"A creature with mana value 0 should be a valid target (MV <= 3).\"\"\"\n318\t        game = create_game()\n319\t        p1 = game.players[0]\n320\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n321\t\n322\t        token_like = Creature(name=\"Zero MV\", owner=p1, controller=p1,\n323\t                              base_power=1, base_toughness=1)\n324\t        # No mana_cost set, so MV = 0\n325\t        set_board_state(game, 0, graveyard=[token_like])\n326\t\n327\t        abilities = card.get_loyalty_abilities()\n328\t        minus_two = abilities[2]\n329\t        card.chosen_targets = [token_like]\n330\t        card._resolve_target = token_like\n331\t        minus_two.effect(game)\n332\t\n333\t        assert game.get_battlefield(p1).contains(token_like)\n334\t\n335\t    def test_get_targets_returns_graveyard_requirement(self) -> None:\n336\t        \"\"\"get_targets should include a target requirement for creature cards\n337\t        in the graveyard with mana value 3 or less.\"\"\"\n338\t        game = create_game()\n339\t        p1 = game.players[0]\n340\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n341\t\n342\t        targets = card.get_targets(game)\n343\t        assert isinstance(targets, list)\n344\t        # There should be at least one target requirement\n345\t        assert len(targets) >= 1\n346\t\n347\t    def test_target_filter_accepts_creature_mv_le_3(self) -> None:\n348\t        \"\"\"The target filter for -2 should accept creature cards with MV <= 3.\"\"\"\n349\t        game = create_game()\n350\t        p1 = game.players[0]\n351\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n352\t\n353\t        targets = card.get_targets(game)\n354\t        # Find the graveyard requirement (for -2 ability)\n355\t        gy_reqs = [r for r in targets if r.zone == Zone.GRAVEYARD]\n356\t        assert len(gy_reqs) >= 1\n357\t\n358\t        req = gy_reqs[0]\n359\t        bear = Creature(name=\"Bear\", mana_cost=ManaCost.parse(\"{1}{G}\"),\n360\t                        base_power=2, base_toughness=2)\n361\t        assert req.filter_fn(bear) is True\n362\t\n363\t    def test_target_filter_rejects_creature_mv_gt_3(self) -> None:\n364\t        \"\"\"The target filter for -2 should reject creature cards with MV > 3.\"\"\"\n365\t        game = create_game()\n366\t        p1 = game.players[0]\n367\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n368\t\n369\t        targets = card.get_targets(game)\n370\t        gy_reqs = [r for r in targets if r.zone == Zone.GRAVEYARD]\n371\t        assert len(gy_reqs) >= 1\n372\t\n373\t        req = gy_reqs[0]\n374\t        big_creature = Creature(name=\"Big\", mana_cost=ManaCost.parse(\"{2}{B}{B}\"),\n375\t                                base_power=4, base_toughness=4)\n376\t        assert req.filter_fn(big_creature) is False\n377\t\n378\t    def test_target_filter_rejects_non_creature(self) -> None:\n379\t        \"\"\"The target filter for -2 should reject non-creature cards even with\n380\t        low mana value.\"\"\"\n381\t        game = create_game()\n382\t        p1 = game.players[0]\n383\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n384\t\n385\t        targets = card.get_targets(game)\n386\t        gy_reqs = [r for r in targets if r.zone == Zone.GRAVEYARD]\n387\t        assert len(gy_reqs) >= 1\n388\t\n389\t        req = gy_reqs[0]\n390\t        bolt = Instant(name=\"Bolt\", mana_cost=ManaCost.parse(\"{R}\"))\n391\t        assert req.filter_fn(bolt) is False\n392\t\n393\t    def test_reanimate_empty_graveyard_no_crash(self) -> None:\n394\t        \"\"\"Activating -2 with no valid target in graveyard should not crash.\"\"\"\n395\t        game = create_game()\n396\t        p1 = game.players[0]\n397\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n398\t\n399\t        set_board_state(game, 0, graveyard=[])\n400\t\n401\t        abilities = card.get_loyalty_abilities()\n402\t        minus_two = abilities[2]\n403\t        card.chosen_targets = []\n404\t        card._resolve_target = None\n405\t        # Should not raise\n406\t        minus_two.effect(game)\n407\t\n408\t\n409\t# ---------------------------------------------------------------------------\n410\t# -7: Flip five coins, opponent skips X turns\n411\t# ---------------------------------------------------------------------------\n412\t\n413\t\n414\tclass TestRalZarekUltimate:\n415\t    \"\"\"-7: Flip five coins. Target opponent skips their next X turns,\n416\t    where X is the number of coins that came up heads.\"\"\"\n417\t\n418\t    def test_ultimate_loyalty_cost(self) -> None:\n419\t        \"\"\"The ultimate ability should have loyalty cost -7.\"\"\"\n420\t        card = RalZarekGuestLecturer(owner=None)\n421\t        abilities = card.get_loyalty_abilities()\n422\t        assert abilities[3].loyalty_cost == -7\n423\t\n424\t    def test_ultimate_skips_opponent_turns(self) -> None:\n425\t        \"\"\"After resolving -7, the opponent should have some turns skipped.\n426\t        We verify by checking the extra_turns queue or a skip_turns counter\n427\t        on the opponent player.\"\"\"\n428\t        game = create_game()\n429\t        p1 = game.players[0]\n430\t        p2 = game.players[1]\n431\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n432\t\n433\t        card.chosen_targets = [p2]\n434\t        card._resolve_target = p2\n435\t        card._resolve_targets = [p2]\n436\t\n437\t        abilities = card.get_loyalty_abilities()\n438\t        ultimate = abilities[3]\n439\t        ultimate.effect(game)\n440\t\n441\t        # After the ultimate resolves, some turn-skipping mechanism should\n442\t        # have been applied to p2. The exact mechanism depends on\n443\t        # implementation — could be:\n444\t        # (a) p2.skip_turns > 0  (a skip counter)\n445\t        # (b) game.extra_turns is populated with p1 turns\n446\t        # (c) some other state change\n447\t        # We check for any sign of turn-skipping.\n448\t        has_skip_counter = getattr(p2, \"skip_turns\", 0) > 0\n449\t        has_skip_next = getattr(p2, \"skip_next_turns\", 0) > 0\n450\t        has_extra_turns = len(game.extra_turns) > 0\n451\t        assert has_skip_counter or has_skip_next or has_extra_turns, (\n452\t            \"After resolving -7, some turn-skipping mechanism should be set \"\n453\t            \"on the opponent or in the game state\"\n454\t        )\n455\t\n456\t    def test_ultimate_with_no_heads_skips_zero_turns(self) -> None:\n457\t        \"\"\"If all 5 coin flips come up tails (0 heads), the opponent skips\n458\t        0 turns — effectively a no-op for turn skipping.\"\"\"\n459\t        game = create_game()\n460\t        p1 = game.players[0]\n461\t        p2 = game.players[1]\n462\t        card = RalZarekGuestLecturer(owner=p1, controller=p1)\n463\t\n464\t        card.chosen_targets = [p2]\n465\t        card._resolve_target = p2\n466\t        card._resolve_targets = [p2]\n467\t\n468\t        # Monkey-patch the coin flip to always return tails\n469\t        import random\n470\t        original_choice = random.choice\n471\t        original_randint = random.randint\n472\t        try:\n473\t            # Try patching various randomness approaches\n474\t            random.choice = lambda seq: seq[1] if len(seq) > 1 else seq[0]  # type: ignore[assignment]\n475\t            random.randint = lambda a, b: 0  # type: ignore[assignment]\n476\t\n477\t            abilities = card.get_loyalty_abilities()\n478\t            ultimate = abilities[3]\n479\t\n480\t            # Also try setting a deterministic coin result attribute\n481\t            card._coin_results = [False, False, False, False, False]\n482\t\n483\t            ultimate.effect(game)\n484\t        finally:\n485\t            random.choice = original_choice  # type: ignore[assignment]\n486\t            random.randint = original_randint  # type: ignore[assignment]\n487\t\n488\t        # With 0 heads, turn skipping should be 0 or absent\n489\t        skip_count = getattr(p2, \"skip_turns\", 0) + getattr(p2, \"skip_next_turns\", 0)\n490\t        extra = len(game.extra_turns)\n491\t        # Zero heads means zero turns skipped — the total effect should be 0\n492\t        # (or at least no more than what was there before).\n493\t        # This test primarily ensures the ability doesn't crash with 0 heads.\n494\t"}]},"parent_tool_use_id":"toolu_01VMNsWLapgFBmu6Up6EteGZ","session_id":"1fe34661-6a3c-4b16-8a42-0f618466dfcb","uuid":"ae2e8f74-fb6a-4316-9124-379182e9ed7b","timestamp":"2026-05-28T09:51:13.378Z","subagent_type":"Implementer","task_description":"Implement sos_97"}
