{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XcNzDGdUNwoF33cxPswbMz","type":"tool_result","content":"1\t\"\"\"Central game state and turn/phase/step progression.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import Any\n6\t\n7\tfrom engine.combat import CombatState\n8\tfrom engine.continuous_effects import EffectManager\n9\tfrom engine.player import Player\n10\tfrom engine.replacement_effects import ReplacementManager\n11\tfrom engine.stack import Stack\n12\tfrom engine.triggers import TriggerManager\n13\tfrom engine.types import Phase, Step, Zone\n14\tfrom engine.zones import ZoneContainer\n15\t\n16\t# Ordered list of (Phase, Step | None) representing a full MTG turn.\n17\t_TURN_SEQUENCE: list[tuple[Phase, Step | None]] = [\n18\t    # Beginning phase\n19\t    (Phase.BEGINNING, Step.UNTAP),\n20\t    (Phase.BEGINNING, Step.UPKEEP),\n21\t    (Phase.BEGINNING, Step.DRAW),\n22\t    # Precombat main phase\n23\t    (Phase.PRECOMBAT_MAIN, None),\n24\t    # Combat phase\n25\t    (Phase.COMBAT, Step.BEGIN_COMBAT),\n26\t    (Phase.COMBAT, Step.DECLARE_ATTACKERS),\n27\t    (Phase.COMBAT, Step.DECLARE_BLOCKERS),\n28\t    (Phase.COMBAT, Step.COMBAT_DAMAGE),\n29\t    (Phase.COMBAT, Step.END_COMBAT),\n30\t    # Postcombat main phase\n31\t    (Phase.POSTCOMBAT_MAIN, None),\n32\t    # Ending phase\n33\t    (Phase.ENDING, Step.END),\n34\t    (Phase.ENDING, Step.CLEANUP),\n35\t]\n36\t\n37\t\n38\tclass GameState:\n39\t    \"\"\"Central game-state object tracking all mutable game information.\n40\t\n41\t    Attributes:\n42\t        players: The list of players in the game.\n43\t        active_player_index: Index of the current active player.\n44\t        priority_player_index: Index of the player who currently has priority.\n45\t        phase: Current phase of the turn.\n46\t        step: Current step within the phase (``None`` for main phases).\n47\t        turn_number: The current turn number (1-indexed).\n48\t        stack: The game stack for spells and abilities.\n49\t        trigger_manager: Central registry for triggered abilities.\n50\t        replacement_manager: Central registry for replacement effects.\n51\t        effect_manager: Manager for continuous effects and the layer system.\n52\t        is_game_over: Whether the game has ended.\n53\t        winner: The winning player, or ``None`` if the game is ongoing / draw.\n54\t    \"\"\"\n55\t\n56\t    def __init__(self, players: list[Player]) -> None:\n57\t        if len(players) < 2:\n58\t            raise ValueError(\"GameState requires at least 2 players\")\n59\t        if len(players) > 2:\n60\t            raise ValueError(\"GameState supports exactly 2 players\")\n61\t\n62\t        self.players: list[Player] = players\n63\t        self.active_player_index: int = 0\n64\t        self.priority_player_index: int = 0\n65\t        self.phase: Phase = Phase.BEGINNING\n66\t        self.step: Step | None = Step.UNTAP\n67\t        self.turn_number: int = 1\n68\t        self.stack: Stack = Stack()\n69\t        self.trigger_manager: TriggerManager = TriggerManager()\n70\t        self.replacement_manager: ReplacementManager = ReplacementManager()\n71\t        self.effect_manager: EffectManager = EffectManager()\n72\t        self.combat_state: CombatState = CombatState()\n73\t        self.is_game_over: bool = False\n74\t        self.winner: Player | None = None\n75\t        # ENGINE LIMITATION: Extra turns queue (FIFO of player seat indices).\n76\t        # Complex interactions ('skip your next turn', multiple extra turns\n77\t        # from different sources) are not fully handled.\n78\t        self.extra_turns: list[int] = []\n79\t        # Tracks normal turn rotation independently of extra turns.\n80\t        # Extra turns are truly *inserted* — they don't advance the\n81\t        # normal rotation.  When extras are exhausted the game picks up\n82\t        # from _normal_next_index.\n83\t        self._normal_next_index: int = 1\n84\t        # External cost-reduction providers registered by permanents that\n85\t        # grant cost reduction to other spells (e.g. \"Instant and sorcery\n86\t        # spells you cast have affinity for creatures\").  Each entry is a\n87\t        # dict with 'source' (the permanent) and 'provider' (a callable\n88\t        # ``(game, card, controller) -> int`` returning the raw reduction\n89\t        # amount for a given spell/controller pair).\n90\t        self._cost_reduction_providers: list[dict] = []\n91\t\n92\t    # ------------------------------------------------------------------\n93\t    # Player properties\n94\t    # ------------------------------------------------------------------\n95\t\n96\t    @property\n97\t    def active_player(self) -> Player:\n98\t        \"\"\"Return the currently active player.\"\"\"\n99\t        return self.players[self.active_player_index]\n100\t\n101\t    @property\n102\t    def priority_player(self) -> Player:\n103\t        \"\"\"Return the player who currently has priority.\"\"\"\n104\t        return self.players[self.priority_player_index]\n105\t\n106\t    @property\n107\t    def non_active_player(self) -> Player:\n108\t        \"\"\"Return the non-active player (2-player assumption for v1).\"\"\"\n109\t        return self.players[1 - self.active_player_index]\n110\t\n111\t    # ------------------------------------------------------------------\n112\t    # Zone accessors\n113\t    # ------------------------------------------------------------------\n114\t\n115\t    def get_battlefield(self, player: Player) -> ZoneContainer:\n116\t        \"\"\"Return the battlefield zone for *player*.\"\"\"\n117\t        return player.zones[Zone.BATTLEFIELD]\n118\t\n119\t    def get_hand(self, player: Player) -> ZoneContainer:\n120\t        \"\"\"Return the hand zone for *player*.\"\"\"\n121\t        return player.zones[Zone.HAND]\n122\t\n123\t    def get_graveyard(self, player: Player) -> ZoneContainer:\n124\t        \"\"\"Return the graveyard zone for *player*.\"\"\"\n125\t        return player.zones[Zone.GRAVEYARD]\n126\t\n127\t    def get_library(self, player: Player) -> ZoneContainer:\n128\t        \"\"\"Return the library zone for *player*.\"\"\"\n129\t        return player.zones[Zone.LIBRARY]\n130\t\n131\t    def get_exile(self, player: Player) -> ZoneContainer:\n132\t        \"\"\"Return the exile zone for *player*.\"\"\"\n133\t        return player.zones[Zone.EXILE]\n134\t\n135\t    # ------------------------------------------------------------------\n136\t    # Phase/step progression\n137\t    # ------------------------------------------------------------------\n138\t\n139\t    def advance_phase(self) -> None:\n140\t        \"\"\"Advance to the next phase/step in MTG turn order.\n141\t\n142\t        At the end of CLEANUP, the turn number is incremented and the\n143\t        active player swaps (2-player assumption).  Mana pools are\n144\t        emptied on every transition.\n145\t        \"\"\"\n146\t        current = (self.phase, self.step)\n147\t        idx = _TURN_SEQUENCE.index(current)\n148\t\n149\t        if idx + 1 < len(_TURN_SEQUENCE):\n150\t            # Move to next phase/step within the same turn.\n151\t            next_phase, next_step = _TURN_SEQUENCE[idx + 1]\n152\t            self.phase = next_phase\n153\t            self.step = next_step\n154\t        else:\n155\t            # End of turn — wrap around.\n156\t            self.turn_number += 1\n157\t            if self.extra_turns:\n158\t                # ENGINE LIMITATION: Extra turns queue (FIFO). Pop the\n159\t                # next player seat index; that player gets the next turn.\n160\t                # Normal rotation is NOT advanced — extra turns are\n161\t                # inserted before the normal next turn.\n162\t                self.active_player_index = self.extra_turns.pop(0)\n163\t            else:\n164\t                self.active_player_index = self._normal_next_index\n165\t                self._normal_next_index = 1 - self._normal_next_index\n166\t            self.priority_player_index = self.active_player_index\n167\t            self.phase = _TURN_SEQUENCE[0][0]\n168\t            self.step = _TURN_SEQUENCE[0][1]\n169\t\n170\t        self.empty_mana_pools()\n171\t\n172\t    def empty_mana_pools(self) -> None:\n173\t        \"\"\"Empty all players' mana pools — called on each phase/step transition.\"\"\"\n174\t        for player in self.players:\n175\t            player.mana_pool.empty()\n176\t"}]},"parent_tool_use_id":"toolu_01AJCZBiRc2QcPpZDHD6Jxhu","session_id":"1fe34661-6a3c-4b16-8a42-0f618466dfcb","uuid":"bfa07a48-fab7-4fb5-9de8-de9cb8f480a0","timestamp":"2026-05-28T10:36:15.119Z","subagent_type":"Implementer","task_description":"Implement sos_257"}
