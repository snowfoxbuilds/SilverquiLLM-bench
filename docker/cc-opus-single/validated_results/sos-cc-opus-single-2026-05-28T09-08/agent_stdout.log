{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014kUfUbsVEusmDPJs6kne3e","type":"tool_result","content":"1\t\"\"\"Tests for SOS 245 — Witherbloom, the Balancer.\n2\t\n3\tWitherbloom, the Balancer is a {6}{B}{G} Legendary Creature — Elder Dragon\n4\twith 5/5, flying, deathtouch.\n5\t\n6\tOracle text:\n7\t  \"Affinity for creatures (This spell costs {1} less to cast for each creature\n8\t  you control.)\n9\t  Flying, deathtouch\n10\t  Instant and sorcery spells you cast have affinity for creatures.\"\n11\t\n12\tRequirements tested:\n13\t1. Static properties: name, mana cost, power/toughness, types, supertypes, subtypes, keywords.\n14\t2. Affinity for creatures (self): cost_reduction returns the number of creatures the controller controls.\n15\t3. Flying and deathtouch keywords.\n16\t4. Granting affinity for creatures to controller's instants and sorceries.\n17\t5. Edge cases: no creatures, only opponent creatures, Witherbloom counts as a creature.\n18\t\"\"\"\n19\t\n20\tfrom __future__ import annotations\n21\t\n22\timport pytest\n23\tfrom cards.sos.sos_245.card_impl import WitherbloomTheBalancer\n24\tfrom engine.card import Creature, Instant, Sorcery, Enchantment\n25\tfrom engine.events import SpellCastTriggeredEvent\n26\tfrom engine.triggers import TriggerRegistration\n27\tfrom engine.types import (\n28\t    CardType,\n29\t    Keyword,\n30\t    ManaCost,\n31\t    ManaType,\n32\t    Supertype,\n33\t    Zone,\n34\t)\n35\tfrom test_utils import create_game, set_board_state\n36\t\n37\t\n38\t# ---------------------------------------------------------------------------\n39\t# Helper factories\n40\t# ---------------------------------------------------------------------------\n41\t\n42\t\n43\tdef _make_witherbloom(owner=None, controller=None):\n44\t    \"\"\"Create a Witherbloom, the Balancer instance.\"\"\"\n45\t    return WitherbloomTheBalancer(owner=owner, controller=controller)\n46\t\n47\t\n48\tdef _make_creature(name=\"Grizzly Bears\", owner=None, controller=None, power=2, toughness=2):\n49\t    \"\"\"Create a vanilla creature.\"\"\"\n50\t    return Creature(\n51\t        name=name,\n52\t        owner=owner,\n53\t        controller=controller,\n54\t        base_power=power,\n55\t        base_toughness=toughness,\n56\t    )\n57\t\n58\t\n59\tdef _make_instant(name=\"Lightning Bolt\", owner=None, controller=None):\n60\t    \"\"\"Create a simple instant spell.\"\"\"\n61\t    return Instant(\n62\t        name=name,\n63\t        mana_cost=ManaCost.parse(\"{4}{R}\"),\n64\t        owner=owner,\n65\t        controller=controller,\n66\t        rules_text=\"Deal 3 damage to any target.\",\n67\t    )\n68\t\n69\t\n70\tdef _make_sorcery(name=\"Divination\", owner=None, controller=None):\n71\t    \"\"\"Create a simple sorcery spell.\"\"\"\n72\t    return Sorcery(\n73\t        name=name,\n74\t        mana_cost=ManaCost.parse(\"{5}{U}\"),\n75\t        owner=owner,\n76\t        controller=controller,\n77\t        rules_text=\"Draw two cards.\",\n78\t    )\n79\t\n80\t\n81\t# ===========================================================================\n82\t# Static Properties\n83\t# ===========================================================================\n84\t\n85\t\n86\tclass TestWitherbloomProperties:\n87\t    \"\"\"Static card data should match the SOS 245 spec.\"\"\"\n88\t\n89\t    def test_is_creature(self) -> None:\n90\t        card = _make_witherbloom()\n91\t        assert isinstance(card, Creature)\n92\t\n93\t    def test_name(self) -> None:\n94\t        card = _make_witherbloom()\n95\t        assert card.name == \"Witherbloom, the Balancer\"\n96\t\n97\t    def test_mana_cost(self) -> None:\n98\t        card = _make_witherbloom()\n99\t        assert card.mana_cost == ManaCost.parse(\"{6}{B}{G}\")\n100\t\n101\t    def test_mana_value_is_eight(self) -> None:\n102\t        card = _make_witherbloom()\n103\t        assert card.mana_cost.cmc == 8\n104\t\n105\t    def test_card_type_creature(self) -> None:\n106\t        card = _make_witherbloom()\n107\t        assert CardType.CREATURE in card.card_types\n108\t\n109\t    def test_supertype_legendary(self) -> None:\n110\t        card = _make_witherbloom()\n111\t        assert Supertype.LEGENDARY in card.supertypes\n112\t\n113\t    def test_subtypes_elder_dragon(self) -> None:\n114\t        card = _make_witherbloom()\n115\t        assert \"Elder\" in card.subtypes\n116\t        assert \"Dragon\" in card.subtypes\n117\t\n118\t    def test_power_toughness(self) -> None:\n119\t        card = _make_witherbloom()\n120\t        assert card.base_power == 5\n121\t        assert card.base_toughness == 5\n122\t\n123\t    def test_has_flying(self) -> None:\n124\t        card = _make_witherbloom()\n125\t        assert Keyword.FLYING in card.keywords\n126\t\n127\t    def test_has_deathtouch(self) -> None:\n128\t        card = _make_witherbloom()\n129\t        assert Keyword.DEATHTOUCH in card.keywords\n130\t\n131\t\n132\t# ===========================================================================\n133\t# Affinity for creatures (self — Witherbloom's own cost reduction)\n134\t# ===========================================================================\n135\t\n136\t\n137\tclass TestWitherbloomSelfAffinity:\n138\t    \"\"\"Witherbloom costs {1} less to cast for each creature you control.\n139\t\n140\t    The cost_reduction method should return the count of creatures the\n141\t    controller controls on the battlefield.\"\"\"\n142\t\n143\t    def test_no_creatures_no_reduction(self) -> None:\n144\t        \"\"\"With no creatures on the battlefield, cost_reduction returns 0.\"\"\"\n145\t        game = create_game()\n146\t        p1 = game.players[0]\n147\t        card = _make_witherbloom(owner=p1, controller=p1)\n148\t        # No creatures on the battlefield\n149\t        reduction = card.cost_reduction(game)\n150\t        assert reduction == 0\n151\t\n152\t    def test_one_creature_reduces_by_one(self) -> None:\n153\t        \"\"\"One creature on the battlefield reduces cost by 1.\"\"\"\n154\t        game = create_game()\n155\t        p1 = game.players[0]\n156\t        card = _make_witherbloom(owner=p1, controller=p1)\n157\t        bear = _make_creature(owner=p1, controller=p1)\n158\t        set_board_state(game, 0, battlefield=[bear])\n159\t        reduction = card.cost_reduction(game)\n160\t        assert reduction == 1\n161\t\n162\t    def test_three_creatures_reduces_by_three(self) -> None:\n163\t        \"\"\"Three creatures on the battlefield reduces cost by 3.\"\"\"\n164\t        game = create_game()\n165\t        p1 = game.players[0]\n166\t        card = _make_witherbloom(owner=p1, controller=p1)\n167\t        creatures = [\n168\t            _make_creature(name=f\"Bear_{i}\", owner=p1, controller=p1)\n169\t            for i in range(3)\n170\t        ]\n171\t        set_board_state(game, 0, battlefield=creatures)\n172\t        reduction = card.cost_reduction(game)\n173\t        assert reduction == 3\n174\t\n175\t    def test_six_creatures_reduces_by_six(self) -> None:\n176\t        \"\"\"Six creatures fully reduce the generic mana portion ({6}).\"\"\"\n177\t        game = create_game()\n178\t        p1 = game.players[0]\n179\t        card = _make_witherbloom(owner=p1, controller=p1)\n180\t        creatures = [\n181\t            _make_creature(name=f\"Bear_{i}\", owner=p1, controller=p1)\n182\t            for i in range(6)\n183\t        ]\n184\t        set_board_state(game, 0, battlefield=creatures)\n185\t        reduction = card.cost_reduction(game)\n186\t        assert reduction == 6\n187\t\n188\t    def test_opponent_creatures_do_not_count(self) -> None:\n189\t        \"\"\"Only the controller's creatures count for affinity, not opponent's.\"\"\"\n190\t        game = create_game()\n191\t        p1 = game.players[0]\n192\t        p2 = game.players[1]\n193\t        card = _make_witherbloom(owner=p1, controller=p1)\n194\t        # Put creatures only on opponent's battlefield\n195\t        bear = _make_creature(owner=p2, controller=p2)\n196\t        set_board_state(game, 1, battlefield=[bear])\n197\t        reduction = card.cost_reduction(game)\n198\t        assert reduction == 0\n199\t\n200\t    def test_non_creature_permanents_do_not_count(self) -> None:\n201\t        \"\"\"Enchantments and other non-creature permanents should not count.\"\"\"\n202\t        game = create_game()\n203\t        p1 = game.players[0]\n204\t        card = _make_witherbloom(owner=p1, controller=p1)\n205\t        enchantment = Enchantment(\n206\t            name=\"Test Enchantment\",\n207\t            owner=p1,\n208\t            controller=p1,\n209\t        )\n210\t        set_board_state(game, 0, battlefield=[enchantment])\n211\t        reduction = card.cost_reduction(game)\n212\t        assert reduction == 0\n213\t\n214\t    def test_excess_creatures_beyond_generic_cost(self) -> None:\n215\t        \"\"\"Affinity returns the full creature count even if it exceeds\n216\t        the generic cost. Clamping happens in the casting pipeline,\n217\t        not in cost_reduction itself.\"\"\"\n218\t        game = create_game()\n219\t        p1 = game.players[0]\n220\t        card = _make_witherbloom(owner=p1, controller=p1)\n221\t        creatures = [\n222\t            _make_creature(name=f\"Bear_{i}\", owner=p1, controller=p1)\n223\t            for i in range(10)\n224\t        ]\n225\t        set_board_state(game, 0, battlefield=creatures)\n226\t        reduction = card.cost_reduction(game)\n227\t        # Should return 10 (the full creature count); clamping to 6 generic\n228\t        # mana is done by get_cost_reduction, not by cost_reduction itself.\n229\t        assert reduction >= 6\n230\t\n231\t\n232\t# ===========================================================================\n233\t# Granting affinity to instants and sorceries\n234\t# ===========================================================================\n235\t\n236\t\n237\tclass TestWitherbloomGrantsAffinityToInstants:\n238\t    \"\"\"'Instant and sorcery spells you cast have affinity for creatures.'\n239\t\n240\t    When Witherbloom is on the battlefield, the controller's instant\n241\t    and sorcery spells should have their cost reduced by the number\n242\t    of creatures the controller controls.\n243\t\n244\t    The implementation may use a continuous effect, a trigger-based\n245\t    approach, or modify cost_reduction on the spells. We test the\n246\t    observable outcome: the cost is reduced.\"\"\"\n247\t\n248\t    def _setup_with_witherbloom_on_battlefield(self):\n249\t        \"\"\"Create a game with Witherbloom on the battlefield, triggers\n250\t        registered, and return (game, p1, p2, witherbloom).\"\"\"\n251\t        game = create_game()\n252\t        p1 = game.players[0]\n253\t        p2 = game.players[1]\n254\t        witherbloom = _make_witherbloom(owner=p1, controller=p1)\n255\t        game.get_battlefield(p1).add(witherbloom)\n256\t        witherbloom.register_triggers(game)\n257\t        witherbloom.register_replacement_effects(game)\n258\t        return game, p1, p2, witherbloom\n259\t\n260\t    def test_instant_gets_cost_reduction_from_creatures(self) -> None:\n261\t        \"\"\"An instant spell cast by Witherbloom's controller should have\n262\t        its cost reduced by the number of creatures that controller controls.\"\"\"\n263\t        game, p1, p2, witherbloom = self._setup_with_witherbloom_on_battlefield()\n264\t\n265\t        # Place creatures on the battlefield (Witherbloom itself is one)\n266\t        bears = [\n267\t            _make_creature(name=f\"Bear_{i}\", owner=p1, controller=p1)\n268\t            for i in range(2)\n269\t        ]\n270\t        for bear in bears:\n271\t            game.get_battlefield(p1).add(bear)\n272\t\n273\t        # 3 total creatures (Witherbloom + 2 bears)\n274\t        bolt = _make_instant(name=\"Lightning Bolt\", owner=p1, controller=p1)\n275\t\n276\t        # The instant should get affinity for creatures.\n277\t        # Test via cost_reduction on the instant itself (if the implementation\n278\t        # modifies the card's cost_reduction method) or via the casting pipeline.\n279\t        from engine.casting import get_cost_reduction\n280\t        bolt.controller = p1\n281\t        reduction = get_cost_reduction(game, bolt, p1)\n282\t\n283\t        # Expected: reduction of 3 (Witherbloom + 2 bears), clamped to generic cost\n284\t        # bolt's mana cost is {4}{R}, so generic is 4\n285\t        assert reduction == 3\n286\t\n287\t    def test_sorcery_gets_cost_reduction_from_creatures(self) -> None:\n288\t        \"\"\"A sorcery spell cast by Witherbloom's controller should have\n289\t        its cost reduced by the number of creatures that controller controls.\"\"\"\n290\t        game, p1, p2, witherbloom = self._setup_with_witherbloom_on_battlefield()\n291\t\n292\t        bears = [\n293\t            _make_creature(name=f\"Bear_{i}\", owner=p1, controller=p1)\n294\t            for i in range(2)\n295\t        ]\n296\t        for bear in bears:\n297\t            game.get_battlefield(p1).add(bear)\n298\t\n299\t        # 3 total creatures (Witherbloom + 2 bears)\n300\t        divination = _make_sorcery(name=\"Divination\", owner=p1, controller=p1)\n301\t\n302\t        from engine.casting import get_cost_reduction\n303\t        divination.controller = p1\n304\t        reduction = get_cost_reduction(game, divination, p1)\n305\t\n306\t        # divination's mana cost is {5}{U}, generic is 5\n307\t        assert reduction == 3\n308\t\n309\t    def test_creature_spell_does_not_get_affinity(self) -> None:\n310\t        \"\"\"Creature spells cast by the controller should NOT get affinity\n311\t        from Witherbloom (only instants and sorceries).\"\"\"\n312\t        game, p1, p2, witherbloom = self._setup_with_witherbloom_on_battlefield()\n313\t\n314\t        bears = [\n315\t            _make_creature(name=f\"Bear_{i}\", owner=p1, controller=p1)\n316\t            for i in range(2)\n317\t        ]\n318\t        for bear in bears:\n319\t            game.get_battlefield(p1).add(bear)\n320\t\n321\t        # A creature spell should not benefit from the affinity granting\n322\t        new_creature = Creature(\n323\t            name=\"Big Creature\",\n324\t            mana_cost=ManaCost.parse(\"{5}\"),\n325\t            owner=p1,\n326\t            controller=p1,\n327\t            base_power=5,\n328\t            base_toughness=5,\n329\t        )\n330\t        from engine.casting import get_cost_reduction\n331\t        reduction = get_cost_reduction(game, new_creature, p1)\n332\t        assert reduction == 0\n333\t\n334\t    def test_opponent_instant_does_not_get_affinity(self) -> None:\n335\t        \"\"\"Opponent's instants should NOT get affinity from our Witherbloom.\"\"\"\n336\t        game, p1, p2, witherbloom = self._setup_with_witherbloom_on_battlefield()\n337\t\n338\t        bears = [\n339\t            _make_creature(name=f\"Bear_{i}\", owner=p1, controller=p1)\n340\t            for i in range(2)\n341\t        ]\n342\t        for bear in bears:\n343\t            game.get_battlefield(p1).add(bear)\n344\t\n345\t        # Opponent's instant\n346\t        opp_bolt = _make_instant(name=\"Opp Bolt\", owner=p2, controller=p2)\n347\t        from engine.casting import get_cost_reduction\n348\t        reduction = get_cost_reduction(game, opp_bolt, p2)\n349\t        assert reduction == 0\n350\t\n351\t    def test_affinity_counts_witherbloom_itself(self) -> None:\n352\t        \"\"\"Witherbloom is a creature, so it counts toward its own affinity\n353\t        and also toward the affinity it grants to instants/sorceries.\"\"\"\n354\t        game, p1, p2, witherbloom = self._setup_with_witherbloom_on_battlefield()\n355\t\n356\t        # Only Witherbloom is on the battlefield (1 creature)\n357\t        bolt = _make_instant(name=\"Test Bolt\", owner=p1, controller=p1)\n358\t        from engine.casting import get_cost_reduction\n359\t        reduction = get_cost_reduction(game, bolt, p1)\n360\t\n361\t        # 1 creature (Witherbloom), so reduction should be 1\n362\t        assert reduction == 1\n363\t\n364\t    def test_affinity_clamped_to_generic_cost(self) -> None:\n365\t        \"\"\"The affinity reduction cannot reduce below 0 generic mana.\n366\t        This is handled by get_cost_reduction clamping.\"\"\"\n367\t        game, p1, p2, witherbloom = self._setup_with_witherbloom_on_battlefield()\n368\t\n369\t        # Add many creatures\n370\t        many_creatures = [\n371\t            _make_creature(name=f\"Bear_{i}\", owner=p1, controller=p1)\n372\t            for i in range(10)\n373\t        ]\n374\t        for bear in many_creatures:\n375\t            game.get_battlefield(p1).add(bear)\n376\t\n377\t        # 11 total creatures (Witherbloom + 10 bears)\n378\t        # Bolt costs {4}{R}, generic is 4\n379\t        bolt = _make_instant(name=\"Test Bolt\", owner=p1, controller=p1)\n380\t        from engine.casting import get_cost_reduction\n381\t        reduction = get_cost_reduction(game, bolt, p1)\n382\t\n383\t        # Clamped to 4 (the generic mana cost of the bolt)\n384\t        assert reduction == 4\n385\t\n386\t    def test_no_creatures_no_reduction_for_instant(self) -> None:\n387\t        \"\"\"With no creatures on the battlefield, an instant gets no reduction.\n388\t        Witherbloom must be on the battlefield for this to apply, but if\n389\t        it's somehow not a creature, the count would be zero.\"\"\"\n390\t        game = create_game()\n391\t        p1 = game.players[0]\n392\t        # Witherbloom is NOT on the battlefield in this test\n393\t        bolt = _make_instant(name=\"Test Bolt\", owner=p1, controller=p1)\n394\t        from engine.casting import get_cost_reduction\n395\t        reduction = get_cost_reduction(game, bolt, p1)\n396\t        assert reduction == 0\n397\t\n398\t\n399\t# ===========================================================================\n400\t# Affinity for self — interaction with the casting pipeline\n401\t# ===========================================================================\n402\t\n403\t\n404\tclass TestWitherbloomCastingWithAffinity:\n405\t    \"\"\"Test that Witherbloom's own affinity works through the casting pipeline.\"\"\"\n406\t\n407\t    def test_witherbloom_castable_with_fewer_mana_when_creatures_exist(self) -> None:\n408\t        \"\"\"With 3 creatures on the battlefield, Witherbloom should cost\n409\t        {3}{B}{G} effectively (6 generic reduced by 3).\"\"\"\n410\t        game = create_game()\n411\t        p1 = game.players[0]\n412\t        witherbloom = _make_witherbloom(owner=p1, controller=p1)\n413\t\n414\t        # 3 creatures on the battlefield\n415\t        creatures = [\n416\t            _make_creature(name=f\"Bear_{i}\", owner=p1, controller=p1)\n417\t            for i in range(3)\n418\t        ]\n419\t        set_board_state(game, 0, battlefield=creatures)\n420\t\n421\t        from engine.casting import get_cost_reduction, _apply_cost_reduction\n422\t        reduction = get_cost_reduction(game, witherbloom, p1)\n423\t        effective = _apply_cost_reduction(witherbloom.mana_cost, reduction)\n424\t\n425\t        # Generic should be 6 - 3 = 3, plus {B}{G}\n426\t        assert effective.generic == 3\n427\t        assert effective.pips.get(ManaType.BLACK, 0) == 1\n428\t        assert effective.pips.get(ManaType.GREEN, 0) == 1\n429\t\n430\t    def test_witherbloom_free_generic_with_six_creatures(self) -> None:\n431\t        \"\"\"With 6 creatures on the battlefield, the generic portion is\n432\t        fully reduced. Only {B}{G} remains.\"\"\"\n433\t        game = create_game()\n434\t        p1 = game.players[0]\n435\t        witherbloom = _make_witherbloom(owner=p1, controller=p1)\n436\t\n437\t        creatures = [\n438\t            _make_creature(name=f\"Bear_{i}\", owner=p1, controller=p1)\n439\t            for i in range(6)\n440\t        ]\n441\t        set_board_state(game, 0, battlefield=creatures)\n442\t\n443\t        from engine.casting import get_cost_reduction, _apply_cost_reduction\n444\t        reduction = get_cost_reduction(game, witherbloom, p1)\n445\t        effective = _apply_cost_reduction(witherbloom.mana_cost, reduction)\n446\t\n447\t        # Generic should be 0, only colored pips remain\n448\t        assert effective.generic == 0\n449\t        assert effective.pips.get(ManaType.BLACK, 0) == 1\n450\t        assert effective.pips.get(ManaType.GREEN, 0) == 1\n451\t\n452\t\n453\t# ===========================================================================\n454\t# Edge cases\n455\t# ===========================================================================\n456\t\n457\t\n458\tclass TestWitherbloomEdgeCases:\n459\t    \"\"\"Edge cases and boundary conditions.\"\"\"\n460\t\n461\t    def test_witherbloom_on_battlefield_counts_itself_for_own_spells(self) -> None:\n462\t        \"\"\"When Witherbloom is already on the battlefield, it counts itself\n463\t        as a creature for the affinity it grants to instants/sorceries.\"\"\"\n464\t        game = create_game()\n465\t        p1 = game.players[0]\n466\t        witherbloom = _make_witherbloom(owner=p1, controller=p1)\n467\t        game.get_battlefield(p1).add(witherbloom)\n468\t        witherbloom.register_triggers(game)\n469\t\n470\t        bolt = _make_instant(name=\"Bolt\", owner=p1, controller=p1)\n471\t        from engine.casting import get_cost_reduction\n472\t        reduction = get_cost_reduction(game, bolt, p1)\n473\t        # Witherbloom itself is 1 creature\n474\t        assert reduction >= 1\n475\t\n476\t    def test_multiple_witherblooms_stack_affinity_on_self(self) -> None:\n477\t        \"\"\"If a second copy of Witherbloom were somehow on the battlefield,\n478\t        the self-affinity should still count all creatures (non-legendary\n479\t        rule aside). We test that counting is done at query time.\"\"\"\n480\t        game = create_game()\n481\t        p1 = game.players[0]\n482\t        # Just test that cost_reduction counts creatures dynamically\n483\t        w1 = _make_witherbloom(owner=p1, controller=p1)\n484\t        bear = _make_creature(owner=p1, controller=p1)\n485\t        set_board_state(game, 0, battlefield=[bear])\n486\t\n487\t        reduction_before = w1.cost_reduction(game)\n488\t        bear2 = _make_creature(name=\"Bear2\", owner=p1, controller=p1)\n489\t        game.get_battlefield(p1).add(bear2)\n490\t        reduction_after = w1.cost_reduction(game)\n491\t\n492\t        assert reduction_after == reduction_before + 1\n493\t"}]},"parent_tool_use_id":"toolu_01GS61Azx6HQbWwjw52LWJRE","session_id":"1fe34661-6a3c-4b16-8a42-0f618466dfcb","uuid":"bbf87f89-5867-4e8a-aa5d-98a18fbce838","timestamp":"2026-05-28T10:28:02.180Z","subagent_type":"Implementer","task_description":"Implement sos_245"}
