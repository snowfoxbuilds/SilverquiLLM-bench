{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018aP8B565iooR2oUijQUjZG","type":"tool_result","content":"1\t\"\"\"Tests for SOS 226 — Silverquill, the Disputant.\n2\t\n3\tSilverquill, the Disputant is a {2}{W}{B} Legendary Creature — Elder Dragon\n4\twith 4/4, flying, vigilance.\n5\t\n6\tOracle text: \"Flying, vigilance\n7\tEach instant and sorcery spell you cast has casualty 1. (As you cast that\n8\tspell, you may sacrifice a creature with power 1 or greater. When you do,\n9\tcopy the spell and you may choose new targets for the copy.)\"\n10\t\n11\tTest coverage:\n12\t- Static card properties (name, cost, types, subtypes, supertypes, P/T, keywords)\n13\t- Casualty 1 granting: triggers on controller's instant/sorcery spell cast\n14\t- Casualty optional sacrifice mechanic\n15\t- Spell copy creation on casualty payment\n16\t- Restriction: only controller's instants/sorceries\n17\t- Restriction: not opponent's spells\n18\t- Restriction: not creature/enchantment/etc. spells\n19\t- Power >= 1 requirement for sacrificed creature\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\timport pytest\n25\tfrom cards.sos.sos_226.card_impl import SilverquillTheDisputant\n26\tfrom engine.card import Creature, Instant, Sorcery\n27\tfrom engine.events import SpellCastTriggeredEvent\n28\tfrom engine.triggers import TriggerRegistration\n29\tfrom engine.types import (\n30\t    CardType,\n31\t    Keyword,\n32\t    ManaCost,\n33\t    ManaType,\n34\t    Supertype,\n35\t    Zone,\n36\t)\n37\tfrom test_utils import create_game, set_board_state\n38\t\n39\t\n40\t# ---------------------------------------------------------------------------\n41\t# Helper factories\n42\t# ---------------------------------------------------------------------------\n43\t\n44\tdef _make_silverquill(owner=None, controller=None):\n45\t    \"\"\"Create a Silverquill, the Disputant instance.\"\"\"\n46\t    return SilverquillTheDisputant(owner=owner, controller=controller)\n47\t\n48\t\n49\tdef _make_bear(name=\"Grizzly Bears\", owner=None, controller=None, power=2, toughness=2):\n50\t    \"\"\"Create a vanilla creature token for sacrifice fodder.\"\"\"\n51\t    c = Creature(\n52\t        name=name,\n53\t        owner=owner,\n54\t        controller=controller,\n55\t        base_power=power,\n56\t        base_toughness=toughness,\n57\t    )\n58\t    c.is_token = False\n59\t    return c\n60\t\n61\t\n62\tdef _make_instant(name=\"Test Bolt\", owner=None, controller=None):\n63\t    \"\"\"Create a simple instant spell.\"\"\"\n64\t    return Instant(\n65\t        name=name,\n66\t        mana_cost=ManaCost.parse(\"{R}\"),\n67\t        owner=owner,\n68\t        controller=controller,\n69\t        rules_text=\"Deal 3 damage to any target.\",\n70\t    )\n71\t\n72\t\n73\tdef _make_sorcery(name=\"Test Divination\", owner=None, controller=None):\n74\t    \"\"\"Create a simple sorcery spell.\"\"\"\n75\t    return Sorcery(\n76\t        name=name,\n77\t        mana_cost=ManaCost.parse(\"{2}{U}\"),\n78\t        owner=owner,\n79\t        controller=controller,\n80\t        rules_text=\"Draw two cards.\",\n81\t    )\n82\t\n83\t\n84\t# ===========================================================================\n85\t# Static Properties\n86\t# ===========================================================================\n87\t\n88\t\n89\tclass TestSilverquillProperties:\n90\t    \"\"\"Static card data should match the SOS 226 spec.\"\"\"\n91\t\n92\t    def test_is_creature(self) -> None:\n93\t        card = _make_silverquill()\n94\t        assert isinstance(card, Creature)\n95\t\n96\t    def test_name(self) -> None:\n97\t        card = _make_silverquill()\n98\t        assert card.name == \"Silverquill, the Disputant\"\n99\t\n100\t    def test_mana_cost(self) -> None:\n101\t        card = _make_silverquill()\n102\t        assert card.mana_cost == ManaCost.parse(\"{2}{W}{B}\")\n103\t\n104\t    def test_mana_value_is_four(self) -> None:\n105\t        card = _make_silverquill()\n106\t        assert card.mana_cost.cmc == 4\n107\t\n108\t    def test_card_type_creature(self) -> None:\n109\t        card = _make_silverquill()\n110\t        assert CardType.CREATURE in card.card_types\n111\t\n112\t    def test_supertype_legendary(self) -> None:\n113\t        card = _make_silverquill()\n114\t        assert Supertype.LEGENDARY in card.supertypes\n115\t\n116\t    def test_subtypes_elder_dragon(self) -> None:\n117\t        card = _make_silverquill()\n118\t        assert \"Elder\" in card.subtypes\n119\t        assert \"Dragon\" in card.subtypes\n120\t\n121\t    def test_power_toughness(self) -> None:\n122\t        card = _make_silverquill()\n123\t        assert card.base_power == 4\n124\t        assert card.base_toughness == 4\n125\t\n126\t    def test_has_flying(self) -> None:\n127\t        card = _make_silverquill()\n128\t        assert Keyword.FLYING in card.keywords\n129\t\n130\t    def test_has_vigilance(self) -> None:\n131\t        card = _make_silverquill()\n132\t        assert Keyword.VIGILANCE in card.keywords\n133\t\n134\t\n135\t# ===========================================================================\n136\t# Trigger Registration (Casualty granting)\n137\t# ===========================================================================\n138\t\n139\t\n140\tclass TestSilverquillTriggerRegistration:\n141\t    \"\"\"Silverquill must register a triggered ability that watches for\n142\t    SpellCastTriggeredEvent to implement the casualty 1 granting.\"\"\"\n143\t\n144\t    def test_registers_trigger_on_battlefield(self) -> None:\n145\t        \"\"\"When Silverquill enters the battlefield, it should register\n146\t        at least one trigger for spell-cast events.\"\"\"\n147\t        game = create_game()\n148\t        p1 = game.players[0]\n149\t        card = _make_silverquill(owner=p1, controller=p1)\n150\t        game.get_battlefield(p1).add(card)\n151\t        before_count = len(game.trigger_manager.get_triggers())\n152\t        card.register_triggers(game)\n153\t        after_count = len(game.trigger_manager.get_triggers())\n154\t        assert after_count > before_count\n155\t\n156\t    def test_registered_trigger_watches_spell_cast_event(self) -> None:\n157\t        \"\"\"The trigger should watch SpellCastTriggeredEvent.\"\"\"\n158\t        game = create_game()\n159\t        p1 = game.players[0]\n160\t        card = _make_silverquill(owner=p1, controller=p1)\n161\t        game.get_battlefield(p1).add(card)\n162\t        card.register_triggers(game)\n163\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n164\t        assert len(triggers) >= 1\n165\t        spell_cast_triggers = [\n166\t            t for t in triggers\n167\t            if t.event_type is SpellCastTriggeredEvent\n168\t        ]\n169\t        assert len(spell_cast_triggers) >= 1\n170\t\n171\t    def test_trigger_source_is_silverquill(self) -> None:\n172\t        \"\"\"The registered trigger's source must be the Silverquill card.\"\"\"\n173\t        game = create_game()\n174\t        p1 = game.players[0]\n175\t        card = _make_silverquill(owner=p1, controller=p1)\n176\t        game.get_battlefield(p1).add(card)\n177\t        card.register_triggers(game)\n178\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n179\t        assert all(t.source is card for t in triggers)\n180\t\n181\t    def test_trigger_controller_is_silverquill_controller(self) -> None:\n182\t        \"\"\"The registered trigger's controller must be Silverquill's controller.\"\"\"\n183\t        game = create_game()\n184\t        p1 = game.players[0]\n185\t        card = _make_silverquill(owner=p1, controller=p1)\n186\t        game.get_battlefield(p1).add(card)\n187\t        card.register_triggers(game)\n188\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n189\t        assert all(t.controller is p1 for t in triggers)\n190\t\n191\t\n192\t# ===========================================================================\n193\t# Casualty Condition — Only controller's instants/sorceries\n194\t# ===========================================================================\n195\t\n196\t\n197\tclass TestSilverquillCasualtyCondition:\n198\t    \"\"\"The casualty trigger should only fire for the controller's\n199\t    instant and sorcery spells, not for opponent's spells or\n200\t    non-instant/sorcery spells.\"\"\"\n201\t\n202\t    def _setup_with_trigger(self):\n203\t        \"\"\"Set up a game with Silverquill on the battlefield and its\n204\t        trigger registered. Returns (game, p1, p2, silverquill, trigger).\"\"\"\n205\t        game = create_game()\n206\t        p1 = game.players[0]\n207\t        p2 = game.players[1]\n208\t        card = _make_silverquill(owner=p1, controller=p1)\n209\t        game.get_battlefield(p1).add(card)\n210\t        card.register_triggers(game)\n211\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n212\t        spell_cast_triggers = [\n213\t            t for t in triggers\n214\t            if t.event_type is SpellCastTriggeredEvent\n215\t        ]\n216\t        assert len(spell_cast_triggers) >= 1\n217\t        trigger = spell_cast_triggers[0]\n218\t        return game, p1, p2, card, trigger\n219\t\n220\t    def test_condition_true_for_controller_instant(self) -> None:\n221\t        \"\"\"Casualty trigger should match controller's instant spells.\"\"\"\n222\t        game, p1, p2, silverquill, trigger = self._setup_with_trigger()\n223\t        instant = _make_instant(owner=p1, controller=p1)\n224\t        event = SpellCastTriggeredEvent(\n225\t            spell=instant, player=p1, card=instant, controller=p1,\n226\t        )\n227\t        # Condition should be true (or None meaning always fires)\n228\t        if trigger.condition is not None:\n229\t            assert trigger.condition(game, event) is True\n230\t        # If condition is None, it always fires, which is still valid\n231\t\n232\t    def test_condition_true_for_controller_sorcery(self) -> None:\n233\t        \"\"\"Casualty trigger should match controller's sorcery spells.\"\"\"\n234\t        game, p1, p2, silverquill, trigger = self._setup_with_trigger()\n235\t        sorcery = _make_sorcery(owner=p1, controller=p1)\n236\t        event = SpellCastTriggeredEvent(\n237\t            spell=sorcery, player=p1, card=sorcery, controller=p1,\n238\t        )\n239\t        if trigger.condition is not None:\n240\t            assert trigger.condition(game, event) is True\n241\t\n242\t    def test_condition_false_for_opponent_instant(self) -> None:\n243\t        \"\"\"Casualty trigger should NOT match opponent's spells.\"\"\"\n244\t        game, p1, p2, silverquill, trigger = self._setup_with_trigger()\n245\t        instant = _make_instant(owner=p2, controller=p2)\n246\t        event = SpellCastTriggeredEvent(\n247\t            spell=instant, player=p2, card=instant, controller=p2,\n248\t        )\n249\t        if trigger.condition is not None:\n250\t            assert trigger.condition(game, event) is False\n251\t        else:\n252\t            # If condition is None, the trigger fires for everything,\n253\t            # which is wrong -- it should only fire for controller's spells.\n254\t            pytest.fail(\n255\t                \"Casualty trigger has no condition — it would fire for \"\n256\t                \"opponent's spells, which violates the card's text.\"\n257\t            )\n258\t\n259\t    def test_condition_false_for_controller_creature_spell(self) -> None:\n260\t        \"\"\"Casualty trigger should NOT match non-instant/sorcery spells.\"\"\"\n261\t        game, p1, p2, silverquill, trigger = self._setup_with_trigger()\n262\t        creature = Creature(\n263\t            name=\"Test Creature\",\n264\t            owner=p1,\n265\t            controller=p1,\n266\t            base_power=3,\n267\t            base_toughness=3,\n268\t        )\n269\t        event = SpellCastTriggeredEvent(\n270\t            spell=creature, player=p1, card=creature, controller=p1,\n271\t        )\n272\t        if trigger.condition is not None:\n273\t            assert trigger.condition(game, event) is False\n274\t        else:\n275\t            pytest.fail(\n276\t                \"Casualty trigger has no condition — it would fire for \"\n277\t                \"creature spells, which violates the card's text.\"\n278\t            )\n279\t\n280\t\n281\t# ===========================================================================\n282\t# Casualty Mechanic — Sacrifice and Copy\n283\t# ===========================================================================\n284\t\n285\t\n286\tclass TestSilverquillCasualtyEffect:\n287\t    \"\"\"When casualty is paid (a creature with power >= 1 is sacrificed),\n288\t    the spell on the stack should be copied.\"\"\"\n289\t\n290\t    def test_casualty_paid_creates_copy_on_stack(self) -> None:\n291\t        \"\"\"When the casualty trigger resolves and a creature was\n292\t        sacrificed, a copy of the spell should be pushed onto the stack.\"\"\"\n293\t        game = create_game()\n294\t        p1 = game.players[0]\n295\t        silverquill = _make_silverquill(owner=p1, controller=p1)\n296\t        game.get_battlefield(p1).add(silverquill)\n297\t        silverquill.register_triggers(game)\n298\t\n299\t        # Place a sacrifice fodder creature on the battlefield\n300\t        fodder = _make_bear(name=\"Sac Fodder\", owner=p1, controller=p1)\n301\t        game.get_battlefield(p1).add(fodder)\n302\t\n303\t        # Create an instant spell and simulate it being on the stack\n304\t        instant = _make_instant(name=\"Lightning Bolt\", owner=p1, controller=p1)\n305\t        from engine.stack import StackObject\n306\t        spell_stack_obj = StackObject(\n307\t            source=instant,\n308\t            controller=p1,\n309\t            targets=[],\n310\t            on_resolve=lambda g: None,\n311\t        )\n312\t        game.stack.push(spell_stack_obj)\n313\t\n314\t        # Fire the SpellCastTriggeredEvent — the trigger effect should\n315\t        # offer casualty and, if paid, push a copy on the stack.\n316\t        # For testing, we script the player to choose to pay casualty\n317\t        # (choose \"yes\" and then choose the creature to sacrifice).\n318\t        from engine.player import DeterministicPlayer\n319\t        if isinstance(p1, DeterministicPlayer):\n320\t            # Script: yes to pay casualty, select the fodder creature,\n321\t            # and optionally \"no\" to choosing new targets\n322\t            p1._script.extend([True, fodder, False])\n323\t\n324\t        event = SpellCastTriggeredEvent(\n325\t            spell=instant, player=p1, card=instant, controller=p1,\n326\t        )\n327\t        game.trigger_manager.fire_event(game, event)\n328\t\n329\t        # The trigger should have been pushed onto the stack. Resolve it.\n330\t        initial_stack_size = len(game.stack)\n331\t        # There should be the original spell + the trigger on the stack\n332\t        assert len(game.stack) >= 2, (\n333\t            f\"Expected at least 2 items on stack (original spell + trigger), \"\n334\t            f\"but found {len(game.stack)}\"\n335\t        )\n336\t\n337\t        # Pop and resolve the trigger (top of stack)\n338\t        trigger_obj = game.stack.pop()\n339\t        trigger_obj.on_resolve(game)\n340\t\n341\t        # After resolving the trigger, if casualty was paid:\n342\t        # - The fodder creature should have been sacrificed (not on battlefield)\n343\t        # - A copy of the spell should be on the stack\n344\t        bf_creatures = [\n345\t            c for c in game.get_battlefield(p1).get_all()\n346\t            if c is fodder\n347\t        ]\n348\t        assert len(bf_creatures) == 0, (\n349\t            \"Sacrificed creature should no longer be on the battlefield\"\n350\t        )\n351\t\n352\t        # The stack should have at least the original spell plus the copy\n353\t        stack_items = game.stack.objects()\n354\t        # At least 2 items: the original spell and the copy\n355\t        assert len(stack_items) >= 2, (\n356\t            f\"Expected at least 2 items on stack (original + copy), \"\n357\t            f\"found {len(stack_items)}\"\n358\t        )\n359\t\n360\t    def test_casualty_declined_no_copy(self) -> None:\n361\t        \"\"\"When the player declines to pay casualty, no copy is created\n362\t        and no creature is sacrificed.\"\"\"\n363\t        game = create_game()\n364\t        p1 = game.players[0]\n365\t        silverquill = _make_silverquill(owner=p1, controller=p1)\n366\t        game.get_battlefield(p1).add(silverquill)\n367\t        silverquill.register_triggers(game)\n368\t\n369\t        fodder = _make_bear(name=\"Sac Fodder\", owner=p1, controller=p1)\n370\t        game.get_battlefield(p1).add(fodder)\n371\t\n372\t        instant = _make_instant(name=\"Lightning Bolt\", owner=p1, controller=p1)\n373\t        from engine.stack import StackObject\n374\t        spell_stack_obj = StackObject(\n375\t            source=instant,\n376\t            controller=p1,\n377\t            targets=[],\n378\t            on_resolve=lambda g: None,\n379\t        )\n380\t        game.stack.push(spell_stack_obj)\n381\t\n382\t        from engine.player import DeterministicPlayer\n383\t        if isinstance(p1, DeterministicPlayer):\n384\t            # Script: no, decline to pay casualty\n385\t            p1._script.extend([False])\n386\t\n387\t        event = SpellCastTriggeredEvent(\n388\t            spell=instant, player=p1, card=instant, controller=p1,\n389\t        )\n390\t        game.trigger_manager.fire_event(game, event)\n391\t\n392\t        # Resolve the trigger\n393\t        if len(game.stack) >= 2:\n394\t            trigger_obj = game.stack.pop()\n395\t            trigger_obj.on_resolve(game)\n396\t\n397\t        # The fodder creature should still be on the battlefield\n398\t        bf_creatures = [\n399\t            c for c in game.get_battlefield(p1).get_all()\n400\t            if c is fodder\n401\t        ]\n402\t        assert len(bf_creatures) == 1, (\n403\t            \"Creature should NOT be sacrificed when casualty is declined\"\n404\t        )\n405\t\n406\t        # Stack should only have the original spell\n407\t        assert len(game.stack) == 1, (\n408\t            f\"No copy should be on the stack when casualty is declined, \"\n409\t            f\"but stack has {len(game.stack)} items\"\n410\t        )\n411\t\n412\t    def test_sacrificed_creature_goes_to_graveyard(self) -> None:\n413\t        \"\"\"The creature sacrificed for casualty should end up in its\n414\t        owner's graveyard.\"\"\"\n415\t        game = create_game()\n416\t        p1 = game.players[0]\n417\t        silverquill = _make_silverquill(owner=p1, controller=p1)\n418\t        game.get_battlefield(p1).add(silverquill)\n419\t        silverquill.register_triggers(game)\n420\t\n421\t        fodder = _make_bear(name=\"Sac Fodder\", owner=p1, controller=p1)\n422\t        game.get_battlefield(p1).add(fodder)\n423\t\n424\t        instant = _make_instant(name=\"Lightning Bolt\", owner=p1, controller=p1)\n425\t        from engine.stack import StackObject\n426\t        spell_stack_obj = StackObject(\n427\t            source=instant,\n428\t            controller=p1,\n429\t            targets=[],\n430\t            on_resolve=lambda g: None,\n431\t        )\n432\t        game.stack.push(spell_stack_obj)\n433\t\n434\t        from engine.player import DeterministicPlayer\n435\t        if isinstance(p1, DeterministicPlayer):\n436\t            p1._script.extend([True, fodder, False])\n437\t\n438\t        event = SpellCastTriggeredEvent(\n439\t            spell=instant, player=p1, card=instant, controller=p1,\n440\t        )\n441\t        game.trigger_manager.fire_event(game, event)\n442\t\n443\t        # Resolve the trigger\n444\t        if len(game.stack) >= 2:\n445\t            trigger_obj = game.stack.pop()\n446\t            trigger_obj.on_resolve(game)\n447\t\n448\t        # Sacrificed creature should be in the graveyard\n449\t        gy = game.get_graveyard(p1)\n450\t        assert gy.contains(fodder), (\n451\t            \"Sacrificed creature should be in the owner's graveyard\"\n452\t        )\n453\t\n454\t\n455\t# ===========================================================================\n456\t# Casualty power requirement\n457\t# ===========================================================================\n458\t\n459\t\n460\tclass TestSilverquillCasualtyPowerRequirement:\n461\t    \"\"\"Casualty 1 requires sacrificing a creature with power >= 1.\n462\t    A creature with power 0 should not be a valid sacrifice target.\"\"\"\n463\t\n464\t    def test_creature_with_zero_power_not_valid_sacrifice(self) -> None:\n465\t        \"\"\"A creature with power 0 cannot be sacrificed for casualty 1.\"\"\"\n466\t        game = create_game()\n467\t        p1 = game.players[0]\n468\t        silverquill = _make_silverquill(owner=p1, controller=p1)\n469\t        game.get_battlefield(p1).add(silverquill)\n470\t        silverquill.register_triggers(game)\n471\t\n472\t        # Zero-power creature should not be a valid casualty sacrifice\n473\t        zero_power = _make_bear(\n474\t            name=\"Wall\",\n475\t            owner=p1,\n476\t            controller=p1,\n477\t            power=0,\n478\t            toughness=3,\n479\t        )\n480\t        game.get_battlefield(p1).add(zero_power)\n481\t\n482\t        instant = _make_instant(name=\"Lightning Bolt\", owner=p1, controller=p1)\n483\t        from engine.stack import StackObject\n484\t        spell_stack_obj = StackObject(\n485\t            source=instant,\n486\t            controller=p1,\n487\t            targets=[],\n488\t            on_resolve=lambda g: None,\n489\t        )\n490\t        game.stack.push(spell_stack_obj)\n491\t\n492\t        from engine.player import DeterministicPlayer\n493\t        if isinstance(p1, DeterministicPlayer):\n494\t            # Script: yes to pay casualty, but the only creature\n495\t            # available has power 0. Depending on implementation,\n496\t            # either the sacrifice is rejected or the wall is not offered.\n497\t            # We attempt to sacrifice it; the implementation should\n498\t            # either skip the wall or reject the payment.\n499\t            p1._script.extend([True, zero_power, False])\n500\t\n501\t        event = SpellCastTriggeredEvent(\n502\t            spell=instant, player=p1, card=instant, controller=p1,\n503\t        )\n504\t        game.trigger_manager.fire_event(game, event)\n505\t\n506\t        # Resolve trigger if pushed\n507\t        stack_count_before = len(game.stack)\n508\t        while len(game.stack) > 1:\n509\t            top = game.stack.pop()\n510\t            top.on_resolve(game)\n511\t\n512\t        # The zero-power creature should still be on the battlefield\n513\t        # (not sacrificed) because it doesn't meet the power requirement\n514\t        bf_creatures = [\n515\t            c for c in game.get_battlefield(p1).get_all()\n516\t            if c is zero_power\n517\t        ]\n518\t        assert len(bf_creatures) == 1, (\n519\t            \"Zero-power creature should NOT be sacrificed for casualty 1\"\n520\t        )\n521\t\n522\t    def test_creature_with_power_one_valid_sacrifice(self) -> None:\n523\t        \"\"\"A creature with power exactly 1 meets the casualty 1 requirement.\"\"\"\n524\t        game = create_game()\n525\t        p1 = game.players[0]\n526\t        silverquill = _make_silverquill(owner=p1, controller=p1)\n527\t        game.get_battlefield(p1).add(silverquill)\n528\t        silverquill.register_triggers(game)\n529\t\n530\t        one_power = _make_bear(\n531\t            name=\"Soldier Token\",\n532\t            owner=p1,\n533\t            controller=p1,\n534\t            power=1,\n535\t            toughness=1,\n536\t        )\n537\t        game.get_battlefield(p1).add(one_power)\n538\t\n539\t        instant = _make_instant(name=\"Lightning Bolt\", owner=p1, controller=p1)\n540\t        from engine.stack import StackObject\n541\t        spell_stack_obj = StackObject(\n542\t            source=instant,\n543\t            controller=p1,\n544\t            targets=[],\n545\t            on_resolve=lambda g: None,\n546\t        )\n547\t        game.stack.push(spell_stack_obj)\n548\t\n549\t        from engine.player import DeterministicPlayer\n550\t        if isinstance(p1, DeterministicPlayer):\n551\t            p1._script.extend([True, one_power, False])\n552\t\n553\t        event = SpellCastTriggeredEvent(\n554\t            spell=instant, player=p1, card=instant, controller=p1,\n555\t        )\n556\t        game.trigger_manager.fire_event(game, event)\n557\t\n558\t        # Resolve trigger\n559\t        while len(game.stack) > 1:\n560\t            top = game.stack.pop()\n561\t            top.on_resolve(game)\n562\t\n563\t        # The power-1 creature should have been sacrificed\n564\t        bf_creatures = [\n565\t            c for c in game.get_battlefield(p1).get_all()\n566\t            if c is one_power\n567\t        ]\n568\t        assert len(bf_creatures) == 0, (\n569\t            \"Power-1 creature should be sacrificed for casualty 1\"\n570\t        )\n571\t\n572\t\n573\t# ===========================================================================\n574\t# Silverquill itself can be sacrificed for casualty\n575\t# ===========================================================================\n576\t\n577\t\n578\tclass TestSilverquillSelfSacrifice:\n579\t    \"\"\"Silverquill (power 4) can itself be a valid sacrifice target for\n580\t    casualty 1 if the controller chooses it.\"\"\"\n581\t\n582\t    def test_silverquill_is_valid_sacrifice_target(self) -> None:\n583\t        \"\"\"Silverquill has power 4 >= 1, so it meets casualty 1 requirement.\"\"\"\n584\t        game = create_game()\n585\t        p1 = game.players[0]\n586\t        silverquill = _make_silverquill(owner=p1, controller=p1)\n587\t        game.get_battlefield(p1).add(silverquill)\n588\t        silverquill.register_triggers(game)\n589\t\n590\t        instant = _make_instant(name=\"Lightning Bolt\", owner=p1, controller=p1)\n591\t        from engine.stack import StackObject\n592\t        spell_stack_obj = StackObject(\n593\t            source=instant,\n594\t            controller=p1,\n595\t            targets=[],\n596\t            on_resolve=lambda g: None,\n597\t        )\n598\t        game.stack.push(spell_stack_obj)\n599\t\n600\t        from engine.player import DeterministicPlayer\n601\t        if isinstance(p1, DeterministicPlayer):\n602\t            # Choose to sacrifice Silverquill itself\n603\t            p1._script.extend([True, silverquill, False])\n604\t\n605\t        event = SpellCastTriggeredEvent(\n606\t            spell=instant, player=p1, card=instant, controller=p1,\n607\t        )\n608\t        game.trigger_manager.fire_event(game, event)\n609\t\n610\t        # Resolve trigger\n611\t        while len(game.stack) > 1:\n612\t            top = game.stack.pop()\n613\t            top.on_resolve(game)\n614\t\n615\t        # Silverquill should have been sacrificed\n616\t        bf_cards = [\n617\t            c for c in game.get_battlefield(p1).get_all()\n618\t            if c is silverquill\n619\t        ]\n620\t        assert len(bf_cards) == 0, (\n621\t            \"Silverquill should be sacrificed when chosen as casualty target\"\n622\t        )\n623\t\n624\t\n625\t# ===========================================================================\n626\t# No creatures to sacrifice — casualty cannot be paid\n627\t# ===========================================================================\n628\t\n629\t\n630\tclass TestSilverquillNoCasualtyCandidates:\n631\t    \"\"\"When the controller has no eligible creatures to sacrifice,\n632\t    casualty cannot be paid and no copy is made.\"\"\"\n633\t\n634\t    def test_no_creatures_to_sacrifice_no_copy(self) -> None:\n635\t        \"\"\"When no eligible creatures exist, no copy should be created.\"\"\"\n636\t        game = create_game()\n637\t        p1 = game.players[0]\n638\t        silverquill = _make_silverquill(owner=p1, controller=p1)\n639\t        game.get_battlefield(p1).add(silverquill)\n640\t        silverquill.register_triggers(game)\n641\t        # Note: Silverquill itself could be sacrificed. But we test with\n642\t        # only zero-power creatures available.\n643\t        zero_power = _make_bear(\n644\t            name=\"Wall\",\n645\t            owner=p1,\n646\t            controller=p1,\n647\t            power=0,\n648\t            toughness=4,\n649\t        )\n650\t        # Remove silverquill from BF to have only zero-power creatures\n651\t        game.get_battlefield(p1).remove(silverquill)\n652\t        game.get_battlefield(p1).add(zero_power)\n653\t\n654\t        instant = _make_instant(name=\"Lightning Bolt\", owner=p1, controller=p1)\n655\t        from engine.stack import StackObject\n656\t        spell_stack_obj = StackObject(\n657\t            source=instant,\n658\t            controller=p1,\n659\t            targets=[],\n660\t            on_resolve=lambda g: None,\n661\t        )\n662\t        game.stack.push(spell_stack_obj)\n663\t\n664\t        from engine.player import DeterministicPlayer\n665\t        if isinstance(p1, DeterministicPlayer):\n666\t            # Even if the player wants to sacrifice, there's no valid target\n667\t            # Script: try to pay but fail\n668\t            p1._script.extend([True, False])\n669\t\n670\t        event = SpellCastTriggeredEvent(\n671\t            spell=instant, player=p1, card=instant, controller=p1,\n672\t        )\n673\t\n674\t        # Since Silverquill is not on the battlefield, the trigger should\n675\t        # not even be registered. Let's re-register with it on the bf.\n676\t        game.get_battlefield(p1).add(silverquill)\n677\t        silverquill.register_triggers(game)\n678\t\n679\t        game.trigger_manager.fire_event(game, event)\n680\t\n681\t        # Resolve all triggers\n682\t        while len(game.stack) > 1:\n683\t            top = game.stack.pop()\n684\t            top.on_resolve(game)\n685\t\n686\t        # Stack should only have the original spell (no copy)\n687\t        assert len(game.stack) == 1, (\n688\t            f\"No copy should exist when no valid creature can be sacrificed, \"\n689\t            f\"stack has {len(game.stack)} items\"\n690\t        )\n691\t"}]},"parent_tool_use_id":"toolu_01RaVWivbMoyZB1n31Cq7Ufj","session_id":"1fe34661-6a3c-4b16-8a42-0f618466dfcb","uuid":"c76d148e-5fbe-4912-80f3-362e3ee801cd","timestamp":"2026-05-28T10:25:22.497Z","subagent_type":"Tester","task_description":"Write tests for sos_245"}
