{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RPiJTvu8kDAFendsHFn8Kt","type":"tool_result","content":"1\t\"\"\"Tests for SOS 13 — Emeritus of Truce // Swords to Plowshares.\n2\t\n3\tEmeritus of Truce is a {1}{W}{W} Creature — Cat Cleric (3/3) with Prepared.\n4\t\n5\tOracle text:\n6\t  When this creature enters, target player creates a 1/1 white and black\n7\t  Inkling creature token with flying. Then if an opponent controls more\n8\t  creatures than you, this creature becomes prepared.\n9\t  (While it's prepared, you may cast a copy of its spell. Doing so\n10\t  unprepares it.)\n11\t\n12\tThe prepare spell is Swords to Plowshares ({W} Instant).\n13\t\n14\tRequirements tested:\n15\t1. Static properties: name, mana cost, power/toughness, types, subtypes.\n16\t2. Is a Creature.\n17\t3. ETB trigger: registers a trigger on EntersBattlefieldTriggeredEvent.\n18\t4. ETB targeting: get_targets returns a target requirement for a player.\n19\t5. Token creation: target player gets a 1/1 white and black Inkling creature\n20\t   token with flying.\n21\t6. Prepared condition: becomes prepared if an opponent controls more creatures.\n22\t7. Does NOT become prepared if opponent has same or fewer creatures.\n23\t8. Edge cases: no chosen target, self-targeting, opponent targeting.\n24\t\"\"\"\n25\t\n26\tfrom __future__ import annotations\n27\t\n28\tfrom cards.sos.sos_13.card_impl import EmeritusOfTruceSwordsToPlowshares\n29\tfrom engine.card import Creature, Instant\n30\tfrom engine.events import EntersBattlefieldTriggeredEvent\n31\tfrom engine.triggers import TriggerRegistration\n32\tfrom engine.types import (\n33\t    CardType,\n34\t    Keyword,\n35\t    ManaCost,\n36\t    TargetRequirement,\n37\t    Zone,\n38\t)\n39\tfrom test_utils import create_game, set_board_state\n40\t\n41\t\n42\t# ---------------------------------------------------------------------------\n43\t# Static properties\n44\t# ---------------------------------------------------------------------------\n45\t\n46\t\n47\tclass TestEmeritusOfTruceProperties:\n48\t    \"\"\"Static card data should match the SOS 13 spec.\"\"\"\n49\t\n50\t    def test_is_creature(self) -> None:\n51\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n52\t        assert isinstance(card, Creature)\n53\t\n54\t    def test_name(self) -> None:\n55\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n56\t        assert card.name == \"Emeritus of Truce\"\n57\t\n58\t    def test_mana_cost(self) -> None:\n59\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n60\t        assert card.mana_cost == ManaCost.parse(\"{1}{W}{W}\")\n61\t\n62\t    def test_power_toughness(self) -> None:\n63\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n64\t        assert card.base_power == 3\n65\t        assert card.base_toughness == 3\n66\t\n67\t    def test_has_creature_type(self) -> None:\n68\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n69\t        assert CardType.CREATURE in card.card_types\n70\t\n71\t    def test_has_cat_cleric_subtypes(self) -> None:\n72\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n73\t        assert \"Cat\" in card.subtypes\n74\t        assert \"Cleric\" in card.subtypes\n75\t\n76\t\n77\t# ---------------------------------------------------------------------------\n78\t# ETB trigger — registration\n79\t# ---------------------------------------------------------------------------\n80\t\n81\t\n82\tclass TestEmeritusOfTruceETBTriggerRegistration:\n83\t    \"\"\"When this creature enters, the ETB trigger should be registered.\"\"\"\n84\t\n85\t    def test_registers_etb_trigger(self) -> None:\n86\t        \"\"\"register_triggers should register at least one\n87\t        EntersBattlefieldTriggeredEvent trigger.\"\"\"\n88\t        game = create_game()\n89\t        p1 = game.players[0]\n90\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n91\t        game.get_battlefield(p1).add(card)\n92\t\n93\t        before_count = len(game.trigger_manager.get_triggers())\n94\t        card.register_triggers(game)\n95\t        after_count = len(game.trigger_manager.get_triggers())\n96\t\n97\t        assert after_count > before_count\n98\t\n99\t    def test_registered_trigger_watches_etb_event(self) -> None:\n100\t        \"\"\"The registered trigger should watch for\n101\t        EntersBattlefieldTriggeredEvent.\"\"\"\n102\t        game = create_game()\n103\t        p1 = game.players[0]\n104\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n105\t        game.get_battlefield(p1).add(card)\n106\t        card.register_triggers(game)\n107\t\n108\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n109\t        etb_triggers = [\n110\t            t for t in triggers\n111\t            if t.event_type is EntersBattlefieldTriggeredEvent\n112\t        ]\n113\t        assert len(etb_triggers) >= 1\n114\t\n115\t    def test_trigger_condition_matches_self_entering(self) -> None:\n116\t        \"\"\"The trigger condition should match when this creature enters.\"\"\"\n117\t        game = create_game()\n118\t        p1 = game.players[0]\n119\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n120\t        game.get_battlefield(p1).add(card)\n121\t        card.register_triggers(game)\n122\t\n123\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n124\t        etb_triggers = [\n125\t            t for t in triggers\n126\t            if t.event_type is EntersBattlefieldTriggeredEvent\n127\t        ]\n128\t        assert len(etb_triggers) >= 1\n129\t\n130\t        event = EntersBattlefieldTriggeredEvent(\n131\t            permanent=card, controller=p1\n132\t        )\n133\t        trigger = etb_triggers[0]\n134\t        if trigger.condition is not None:\n135\t            assert trigger.condition(game, event) is True\n136\t\n137\t    def test_trigger_condition_does_not_match_other_permanent(self) -> None:\n138\t        \"\"\"The trigger should NOT fire when a different permanent enters.\"\"\"\n139\t        game = create_game()\n140\t        p1 = game.players[0]\n141\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n142\t        game.get_battlefield(p1).add(card)\n143\t        card.register_triggers(game)\n144\t\n145\t        other = Creature(\n146\t            name=\"Other Creature\", owner=p1, controller=p1,\n147\t            base_power=2, base_toughness=2,\n148\t        )\n149\t\n150\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n151\t        etb_triggers = [\n152\t            t for t in triggers\n153\t            if t.event_type is EntersBattlefieldTriggeredEvent\n154\t        ]\n155\t        assert len(etb_triggers) >= 1\n156\t\n157\t        event = EntersBattlefieldTriggeredEvent(\n158\t            permanent=other, controller=p1\n159\t        )\n160\t        trigger = etb_triggers[0]\n161\t        if trigger.condition is not None:\n162\t            assert trigger.condition(game, event) is False\n163\t\n164\t\n165\t# ---------------------------------------------------------------------------\n166\t# ETB targeting — target player\n167\t# ---------------------------------------------------------------------------\n168\t\n169\t\n170\tclass TestEmeritusOfTruceTargeting:\n171\t    \"\"\"get_targets() should advertise a target requirement for a player.\"\"\"\n172\t\n173\t    def test_returns_at_least_one_target_requirement(self) -> None:\n174\t        game = create_game()\n175\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n176\t        reqs = card.get_targets(game)\n177\t        assert isinstance(reqs, list)\n178\t        assert len(reqs) >= 1\n179\t\n180\t    def test_target_requirement_is_valid_type(self) -> None:\n181\t        game = create_game()\n182\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n183\t        reqs = card.get_targets(game)\n184\t        assert isinstance(reqs[0], TargetRequirement)\n185\t\n186\t    def test_target_accepts_player(self) -> None:\n187\t        \"\"\"The target requirement should accept a player object.\"\"\"\n188\t        game = create_game()\n189\t        card = EmeritusOfTruceSwordsToPlowshares(owner=None)\n190\t        reqs = card.get_targets(game)\n191\t        req = reqs[0]\n192\t        assert req.filter_fn(game.players[0]) is True\n193\t        assert req.filter_fn(game.players[1]) is True\n194\t\n195\t\n196\t# ---------------------------------------------------------------------------\n197\t# Token creation — Inkling token properties\n198\t# ---------------------------------------------------------------------------\n199\t\n200\t\n201\tclass TestEmeritusOfTruceTokenCreation:\n202\t    \"\"\"When the ETB trigger resolves, the target player creates a 1/1\n203\t    white and black Inkling creature token with flying.\"\"\"\n204\t\n205\t    def test_target_player_gets_token(self) -> None:\n206\t        \"\"\"The targeted player should receive one creature token on the\n207\t        battlefield.\"\"\"\n208\t        game = create_game()\n209\t        p1 = game.players[0]\n210\t        p2 = game.players[1]\n211\t\n212\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n213\t        game.get_battlefield(p1).add(card)\n214\t\n215\t        bf_before = len(game.get_battlefield(p2).get_all())\n216\t\n217\t        # Simulate the ETB trigger resolving with p2 as the target.\n218\t        card.chosen_targets = [p2]\n219\t        card.on_resolve(game)\n220\t\n221\t        bf_after = len(game.get_battlefield(p2).get_all())\n222\t        assert bf_after - bf_before == 1, \\\n223\t            \"Target player should receive exactly one token\"\n224\t\n225\t    def test_token_is_creature(self) -> None:\n226\t        \"\"\"The created token should be a Creature.\"\"\"\n227\t        game = create_game()\n228\t        p1 = game.players[0]\n229\t        p2 = game.players[1]\n230\t\n231\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n232\t        game.get_battlefield(p1).add(card)\n233\t        card.chosen_targets = [p2]\n234\t        card.on_resolve(game)\n235\t\n236\t        tokens = [\n237\t            obj for obj in game.get_battlefield(p2).get_all()\n238\t            if isinstance(obj, Creature) and getattr(obj, \"is_token\", False)\n239\t        ]\n240\t        assert len(tokens) >= 1, \"Expected at least one creature token\"\n241\t\n242\t    def test_token_is_inkling(self) -> None:\n243\t        \"\"\"The token should have the Inkling creature subtype.\"\"\"\n244\t        game = create_game()\n245\t        p1 = game.players[0]\n246\t        p2 = game.players[1]\n247\t\n248\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n249\t        game.get_battlefield(p1).add(card)\n250\t        card.chosen_targets = [p2]\n251\t        card.on_resolve(game)\n252\t\n253\t        tokens = [\n254\t            obj for obj in game.get_battlefield(p2).get_all()\n255\t            if isinstance(obj, Creature) and getattr(obj, \"is_token\", False)\n256\t        ]\n257\t        assert len(tokens) >= 1\n258\t        token = tokens[0]\n259\t        assert \"Inkling\" in getattr(token, \"subtypes\", set()), \\\n260\t            \"Token should have Inkling subtype\"\n261\t\n262\t    def test_token_power_toughness(self) -> None:\n263\t        \"\"\"The token should be 1/1.\"\"\"\n264\t        game = create_game()\n265\t        p1 = game.players[0]\n266\t        p2 = game.players[1]\n267\t\n268\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n269\t        game.get_battlefield(p1).add(card)\n270\t        card.chosen_targets = [p2]\n271\t        card.on_resolve(game)\n272\t\n273\t        tokens = [\n274\t            obj for obj in game.get_battlefield(p2).get_all()\n275\t            if isinstance(obj, Creature) and getattr(obj, \"is_token\", False)\n276\t        ]\n277\t        assert len(tokens) >= 1\n278\t        token = tokens[0]\n279\t        assert token.base_power == 1\n280\t        assert token.base_toughness == 1\n281\t\n282\t    def test_token_has_flying(self) -> None:\n283\t        \"\"\"The token should have the flying keyword.\"\"\"\n284\t        game = create_game()\n285\t        p1 = game.players[0]\n286\t        p2 = game.players[1]\n287\t\n288\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n289\t        game.get_battlefield(p1).add(card)\n290\t        card.chosen_targets = [p2]\n291\t        card.on_resolve(game)\n292\t\n293\t        tokens = [\n294\t            obj for obj in game.get_battlefield(p2).get_all()\n295\t            if isinstance(obj, Creature) and getattr(obj, \"is_token\", False)\n296\t        ]\n297\t        assert len(tokens) >= 1\n298\t        token = tokens[0]\n299\t        assert Keyword.FLYING in token.keywords, \\\n300\t            \"Token should have flying\"\n301\t\n302\t    def test_controller_can_target_self_for_token(self) -> None:\n303\t        \"\"\"The controller can target themselves to receive the token.\"\"\"\n304\t        game = create_game()\n305\t        p1 = game.players[0]\n306\t\n307\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n308\t        game.get_battlefield(p1).add(card)\n309\t\n310\t        bf_before = len(game.get_battlefield(p1).get_all())\n311\t\n312\t        card.chosen_targets = [p1]\n313\t        card.on_resolve(game)\n314\t\n315\t        bf_after = len(game.get_battlefield(p1).get_all())\n316\t        # The Emeritus itself + 1 token\n317\t        assert bf_after - bf_before == 1, \\\n318\t            \"Controller should get exactly one token when targeting self\"\n319\t\n320\t\n321\t# ---------------------------------------------------------------------------\n322\t# Prepared condition — opponent controls more creatures\n323\t# ---------------------------------------------------------------------------\n324\t\n325\t\n326\tclass TestEmeritusOfTrucePreparedCondition:\n327\t    \"\"\"After the token is created, if an opponent controls more creatures\n328\t    than you, this creature becomes prepared.\"\"\"\n329\t\n330\t    def test_becomes_prepared_when_opponent_has_more_creatures(self) -> None:\n331\t        \"\"\"When opponent controls more creatures than the controller,\n332\t        Emeritus should become prepared.\"\"\"\n333\t        game = create_game()\n334\t        p1 = game.players[0]\n335\t        p2 = game.players[1]\n336\t\n337\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n338\t        game.get_battlefield(p1).add(card)\n339\t\n340\t        # Opponent has several creatures\n341\t        for i in range(3):\n342\t            bear = Creature(\n343\t                name=f\"Bear{i}\", owner=p2, controller=p2,\n344\t                base_power=2, base_toughness=2,\n345\t            )\n346\t            game.get_battlefield(p2).add(bear)\n347\t\n348\t        # Target opponent for the token (they get +1 creature, doesn't help us)\n349\t        # P1 has: Emeritus (1 creature)\n350\t        # P2 has: 3 bears + 1 token = 4 creatures\n351\t        card.chosen_targets = [p2]\n352\t        card.on_resolve(game)\n353\t\n354\t        assert getattr(card, \"is_prepared\", False) is True, \\\n355\t            \"Emeritus should be prepared when opponent has more creatures\"\n356\t\n357\t    def test_not_prepared_when_controller_has_equal_creatures(self) -> None:\n358\t        \"\"\"When controller has equal or more creatures, should NOT become\n359\t        prepared.\"\"\"\n360\t        game = create_game()\n361\t        p1 = game.players[0]\n362\t        p2 = game.players[1]\n363\t\n364\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n365\t        game.get_battlefield(p1).add(card)\n366\t\n367\t        # P1 also has another creature\n368\t        extra = Creature(\n369\t            name=\"Extra\", owner=p1, controller=p1,\n370\t            base_power=2, base_toughness=2,\n371\t        )\n372\t        game.get_battlefield(p1).add(extra)\n373\t\n374\t        # P2 has 1 creature\n375\t        opp_bear = Creature(\n376\t            name=\"Opp Bear\", owner=p2, controller=p2,\n377\t            base_power=2, base_toughness=2,\n378\t        )\n379\t        game.get_battlefield(p2).add(opp_bear)\n380\t\n381\t        # Target self — P1 gets the token\n382\t        # P1: Emeritus + Extra + Token = 3\n383\t        # P2: Opp Bear = 1\n384\t        card.chosen_targets = [p1]\n385\t        card.on_resolve(game)\n386\t\n387\t        assert getattr(card, \"is_prepared\", False) is False, \\\n388\t            \"Emeritus should NOT be prepared when controller has >= creatures\"\n389\t\n390\t    def test_not_prepared_when_controller_has_more_creatures(self) -> None:\n391\t        \"\"\"Definitely not prepared when controller has strictly more.\"\"\"\n392\t        game = create_game()\n393\t        p1 = game.players[0]\n394\t        p2 = game.players[1]\n395\t\n396\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n397\t        game.get_battlefield(p1).add(card)\n398\t\n399\t        # Add more creatures for p1\n400\t        for i in range(3):\n401\t            extra = Creature(\n402\t                name=f\"P1Creature{i}\", owner=p1, controller=p1,\n403\t                base_power=2, base_toughness=2,\n404\t            )\n405\t            game.get_battlefield(p1).add(extra)\n406\t\n407\t        # P2 has no creatures at all; target p2 for token\n408\t        # After resolve: P1 = 4 creatures, P2 = 1 token\n409\t        card.chosen_targets = [p2]\n410\t        card.on_resolve(game)\n411\t\n412\t        assert getattr(card, \"is_prepared\", False) is False, \\\n413\t            \"Emeritus should NOT be prepared when controller has more creatures\"\n414\t\n415\t    def test_becomes_prepared_targeting_self_opponent_still_has_more(self) -> None:\n416\t        \"\"\"Targeting self for the token but opponent still has more creatures.\"\"\"\n417\t        game = create_game()\n418\t        p1 = game.players[0]\n419\t        p2 = game.players[1]\n420\t\n421\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n422\t        game.get_battlefield(p1).add(card)\n423\t\n424\t        # Opponent has 4 creatures\n425\t        for i in range(4):\n426\t            opp = Creature(\n427\t                name=f\"OppCreature{i}\", owner=p2, controller=p2,\n428\t                base_power=2, base_toughness=2,\n429\t            )\n430\t            game.get_battlefield(p2).add(opp)\n431\t\n432\t        # Target self: P1 gets Emeritus + Token = 2, P2 has 4\n433\t        card.chosen_targets = [p1]\n434\t        card.on_resolve(game)\n435\t\n436\t        assert getattr(card, \"is_prepared\", False) is True, \\\n437\t            \"Should be prepared even when targeting self if opponent still has more\"\n438\t\n439\t\n440\t# ---------------------------------------------------------------------------\n441\t# Edge cases\n442\t# ---------------------------------------------------------------------------\n443\t\n444\t\n445\tclass TestEmeritusOfTruceEdgeCases:\n446\t    \"\"\"Edge cases and boundary conditions.\"\"\"\n447\t\n448\t    def test_on_resolve_no_chosen_targets_does_not_crash(self) -> None:\n449\t        \"\"\"If there are no chosen targets, on_resolve should be a no-op.\"\"\"\n450\t        game = create_game()\n451\t        p1 = game.players[0]\n452\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n453\t        game.get_battlefield(p1).add(card)\n454\t        # No chosen_targets set\n455\t        card.on_resolve(game)\n456\t\n457\t    def test_on_resolve_empty_chosen_targets_does_not_crash(self) -> None:\n458\t        \"\"\"If chosen_targets is empty, on_resolve should be a no-op.\"\"\"\n459\t        game = create_game()\n460\t        p1 = game.players[0]\n461\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n462\t        game.get_battlefield(p1).add(card)\n463\t        card.chosen_targets = []\n464\t        card.on_resolve(game)\n465\t\n466\t    def test_opponent_has_no_creatures_token_given_to_opponent(self) -> None:\n467\t        \"\"\"When only the token is on the opponent's side, the opponent has\n468\t        1 creature and the controller has 1 (Emeritus). Not prepared since\n469\t        opponent does NOT have MORE (equal is not more).\"\"\"\n470\t        game = create_game()\n471\t        p1 = game.players[0]\n472\t        p2 = game.players[1]\n473\t\n474\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n475\t        game.get_battlefield(p1).add(card)\n476\t\n477\t        # No creatures on either side except Emeritus\n478\t        # Target p2: P1 = 1 (Emeritus), P2 = 1 (token)\n479\t        card.chosen_targets = [p2]\n480\t        card.on_resolve(game)\n481\t\n482\t        # P2 has only the token, P1 has Emeritus. Equal -> not prepared.\n483\t        assert getattr(card, \"is_prepared\", False) is False, \\\n484\t            \"Equal creature counts should not trigger prepared\"\n485\t\n486\t    def test_token_on_opponent_side_tips_balance(self) -> None:\n487\t        \"\"\"If giving the token to the opponent causes them to have more\n488\t        creatures, the card becomes prepared.\"\"\"\n489\t        game = create_game()\n490\t        p1 = game.players[0]\n491\t        p2 = game.players[1]\n492\t\n493\t        card = EmeritusOfTruceSwordsToPlowshares(owner=p1, controller=p1)\n494\t        game.get_battlefield(p1).add(card)\n495\t\n496\t        # Opponent has 1 creature already\n497\t        opp_bear = Creature(\n498\t            name=\"Opp Bear\", owner=p2, controller=p2,\n499\t            base_power=2, base_toughness=2,\n500\t        )\n501\t        game.get_battlefield(p2).add(opp_bear)\n502\t\n503\t        # Target p2: P1 = 1 (Emeritus), P2 = 1 bear + 1 token = 2\n504\t        card.chosen_targets = [p2]\n505\t        card.on_resolve(game)\n506\t\n507\t        assert getattr(card, \"is_prepared\", False) is True, \\\n508\t            \"Giving token to opponent causing them to have more should prepare\"\n509\t"}]},"parent_tool_use_id":"toolu_01GmsndJiRpYV9ifKJBLLPN6","session_id":"1fe34661-6a3c-4b16-8a42-0f618466dfcb","uuid":"ea149522-4b9b-40f5-8127-8955ee5d8dd6","timestamp":"2026-05-28T09:34:52.450Z","subagent_type":"Implementer","task_description":"Implement sos_13"}
