{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014VbGZxvSKUyb5J414UMYBu","type":"tool_result","content":"1\t\"\"\"Card implementation for Lorehold, the Historian.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.events import BeginningOfUpkeepTriggeredEvent\n9\tfrom engine.triggers import TriggerRegistration\n10\tfrom engine.types import CardType, Keyword, ManaCost, Supertype\n11\t\n12\tif TYPE_CHECKING:\n13\t    from engine.game_state import GameState\n14\t\n15\t\n16\tdef _is_instant_or_sorcery(card: Any) -> bool:\n17\t    \"\"\"Return True if *card* is an instant or sorcery.\"\"\"\n18\t    card_types = getattr(card, \"card_types\", set())\n19\t    return CardType.INSTANT in card_types or CardType.SORCERY in card_types\n20\t\n21\t\n22\tclass _MiracleHandZoneProxy:\n23\t    \"\"\"Wraps a ZoneContainer for the controller's hand to auto-apply miracle_cost\n24\t    to instants/sorceries when they are added, and auto-remove it on removal.\n25\t\n26\t    This proxy delegates all attribute access to the underlying ZoneContainer\n27\t    but intercepts ``add`` and ``remove`` to manage the ``miracle_cost`` attribute\n28\t    on cards that are instants or sorceries belonging to the Lorehold controller.\n29\t    \"\"\"\n30\t\n31\t    def __init__(self, real_zone: Any, controller: Any, miracle_cost: ManaCost) -> None:\n32\t        object.__setattr__(self, \"_real_zone\", real_zone)\n33\t        object.__setattr__(self, \"_controller\", controller)\n34\t        object.__setattr__(self, \"_miracle_cost\", miracle_cost)\n35\t\n36\t    def add(self, obj: Any, position: str = \"top\") -> None:\n37\t        \"\"\"Add card to zone, applying miracle_cost if it's an instant/sorcery.\"\"\"\n38\t        self._real_zone.add(obj, position)\n39\t        if _is_instant_or_sorcery(obj):\n40\t            obj.miracle_cost = self._miracle_cost\n41\t\n42\t    def remove(self, obj: Any) -> None:\n43\t        \"\"\"Remove card from zone, cleaning up miracle_cost.\"\"\"\n44\t        self._real_zone.remove(obj)\n45\t        if hasattr(obj, \"miracle_cost\") and _is_instant_or_sorcery(obj):\n46\t            del obj.miracle_cost\n47\t\n48\t    def __getattr__(self, name: str) -> Any:\n49\t        return getattr(self._real_zone, name)\n50\t\n51\t    def __len__(self) -> int:\n52\t        return len(self._real_zone)\n53\t\n54\t    def __repr__(self) -> str:\n55\t        return repr(self._real_zone)\n56\t\n57\t\n58\tclass LoreholdTheHistorian(Creature):\n59\t    \"\"\"Lorehold, the Historian -- {3}{R}{W} -- Legendary Creature -- Elder Dragon -- 5/5.\n60\t\n61\t    Flying, haste\n62\t    Each instant and sorcery card in your hand has miracle {2}.\n63\t    At the beginning of each opponent's upkeep, you may discard a card.\n64\t    If you do, draw a card.\n65\t\n66\t    SOS collector number 201.\n67\t    \"\"\"\n68\t\n69\t    def __init__(self, **kwargs: Any) -> None:\n70\t        kwargs.setdefault(\"name\", \"Lorehold, the Historian\")\n71\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{3}{R}{W}\"))\n72\t        kwargs.setdefault(\"subtypes\", {\"Elder\", \"Dragon\"})\n73\t        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n74\t        kwargs.setdefault(\"keywords\", Keyword.FLYING | Keyword.HASTE)\n75\t        kwargs.setdefault(\"base_power\", 5)\n76\t        kwargs.setdefault(\"base_toughness\", 5)\n77\t        kwargs.setdefault(\n78\t            \"rules_text\",\n79\t            \"Flying, haste\\n\"\n80\t            \"Each instant and sorcery card in your hand has miracle {2}. \"\n81\t            \"(You may cast a card for its miracle cost when you draw it if \"\n82\t            \"it's the first card you drew this turn.)\\n\"\n83\t            \"At the beginning of each opponent's upkeep, you may discard a \"\n84\t            \"card. If you do, draw a card.\",\n85\t        )\n86\t        super().__init__(**kwargs)\n87\t\n88\t    # ------------------------------------------------------------------\n89\t    # Miracle granting + Upkeep trigger registration\n90\t    # ------------------------------------------------------------------\n91\t\n92\t    def register_triggers(self, game: GameState) -> None:\n93\t        \"\"\"Register miracle granting and the opponent's upkeep loot trigger.\"\"\"\n94\t        controller = self.controller if self.controller is not None else self.owner\n95\t        if controller is None:\n96\t            return\n97\t\n98\t        miracle_cost = ManaCost.parse(\"{2}\")\n99\t\n100\t        # --- Miracle granting: wrap the controller's hand zone ---\n101\t        # Install a proxy on the hand zone that auto-applies miracle_cost\n102\t        # to instants/sorceries when they enter the hand.\n103\t        from engine.types import Zone\n104\t\n105\t        hand_zone = controller.zones[Zone.HAND]\n106\t\n107\t        # Only wrap if not already wrapped (avoid double-wrapping).\n108\t        if not isinstance(hand_zone, _MiracleHandZoneProxy):\n109\t            proxy = _MiracleHandZoneProxy(hand_zone, controller, miracle_cost)\n110\t            controller.zones._zones[Zone.HAND] = proxy\n111\t\n112\t            # Also apply miracle_cost to any instants/sorceries already in hand.\n113\t            for card in hand_zone.get_all():\n114\t                if _is_instant_or_sorcery(card):\n115\t                    card.miracle_cost = miracle_cost\n116\t\n117\t        # --- Opponent's upkeep trigger ---\n118\t        source = self\n119\t\n120\t        def _upkeep_condition(game: GameState, event: BeginningOfUpkeepTriggeredEvent) -> bool:\n121\t            \"\"\"Fire only on an opponent's upkeep (active player is not the controller).\"\"\"\n122\t            return game.active_player is not controller\n123\t\n124\t        def _upkeep_effect(game: GameState) -> None:\n125\t            \"\"\"May discard a card. If you do, draw a card.\"\"\"\n126\t            from engine.game import discard, draw_card\n127\t\n128\t            # Check if the controller has cards in hand\n129\t            player_hand = game.get_hand(controller)\n130\t            if len(player_hand) == 0:\n131\t                # Cannot discard, so nothing happens\n132\t                # Still consume the \"may\" choice if scripted\n133\t                try:\n134\t                    chose_to_discard = controller.choose_yes_no(\n135\t                        \"Discard a card to draw a card?\"\n136\t                    )\n137\t                except Exception:\n138\t                    return\n139\t                return\n140\t\n141\t            # Ask the controller if they want to discard\n142\t            chose_to_discard = controller.choose_yes_no(\n143\t                \"Discard a card to draw a card?\"\n144\t            )\n145\t            if not chose_to_discard:\n146\t                return\n147\t\n148\t            # Choose a card to discard\n149\t            hand_cards = player_hand.get_all()\n150\t            if not hand_cards:\n151\t                return\n152\t\n153\t            # Use choose_card for selecting which card to discard\n154\t            # If there is only one card, discard it automatically\n155\t            if len(hand_cards) == 1:\n156\t                card_to_discard = hand_cards[0]\n157\t            else:\n158\t                card_to_discard = controller.choose_card(\n159\t                    hand_cards, \"Choose a card to discard\"\n160\t                )\n161\t\n162\t            discard(game, controller, card_to_discard)\n163\t            draw_card(game, controller)\n164\t\n165\t        trigger = TriggerRegistration(\n166\t            event_type=BeginningOfUpkeepTriggeredEvent,\n167\t            condition=_upkeep_condition,\n168\t            effect=_upkeep_effect,\n169\t            source=self,\n170\t            controller=controller,\n171\t        )\n172\t        game.trigger_manager.register(trigger)\n173\t"}]},"parent_tool_use_id":"toolu_01PhCWgoY7pb2bTKbXnzjmdZ","session_id":"1fe34661-6a3c-4b16-8a42-0f618466dfcb","uuid":"28bb0a4e-5739-4120-bfff-72a78a31da81","timestamp":"2026-05-28T10:13:15.863Z","subagent_type":"Reviewer","task_description":"Review sos_201 implementation"}
