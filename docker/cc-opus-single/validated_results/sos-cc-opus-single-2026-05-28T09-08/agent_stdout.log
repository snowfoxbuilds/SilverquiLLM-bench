{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016NYyuAJLioW1qTcJ9UDGUb","type":"tool_result","content":"1\tdiff --git a/cards/sos/sos_57/card_impl.py b/cards/sos/sos_57/card_impl.py\n2\tindex 732a555..d4fc076 100644\n3\t--- a/cards/sos/sos_57/card_impl.py\n4\t+++ b/cards/sos/sos_57/card_impl.py\n5\t@@ -2,15 +2,117 @@\n6\t \n7\t from __future__ import annotations\n8\t \n9\t-from engine.card import CardImpl\n10\t+from typing import TYPE_CHECKING, Any\n11\t \n12\t-from typing import TYPE_CHECKING\n13\t+from engine.card import Instant\n14\t+from engine.triggers import TriggerRegistration\n15\t+from engine.events import TriggeredEvent\n16\t+from engine.types import CardType, ManaCost, ManaType, TargetRequirement, Zone\n17\t \n18\t if TYPE_CHECKING:\n19\t     from engine.game_state import GameState\n20\t \n21\t \n22\t-class ManaSculpt(CardImpl):\n23\t-    \"\"\"TODO: Implement Mana Sculpt.\"\"\"\n24\t+class ManaSculpt(Instant):\n25\t+    \"\"\"Mana Sculpt -- {1}{U}{U} -- Instant.\n26\t \n27\t-    pass\n28\t+    Counter target spell. If you control a Wizard, add an amount of {C}\n29\t+    equal to the amount of mana spent to cast that spell at the beginning\n30\t+    of your next main phase.\n31\t+\n32\t+    SOS collector number 57.\n33\t+    \"\"\"\n34\t+\n35\t+    def __init__(self, **kwargs: Any) -> None:\n36\t+        kwargs.setdefault(\"name\", \"Mana Sculpt\")\n37\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{U}{U}\"))\n38\t+        kwargs.setdefault(\n39\t+            \"rules_text\",\n40\t+            \"Counter target spell. If you control a Wizard, add an amount \"\n41\t+            \"of {C} equal to the amount of mana spent to cast that spell \"\n42\t+            \"at the beginning of your next main phase.\",\n43\t+        )\n44\t+        super().__init__(**kwargs)\n45\t+\n46\t+    # ------------------------------------------------------------------\n47\t+    # Targeting -- target spell on the stack\n48\t+    # ------------------------------------------------------------------\n49\t+\n50\t+    def get_targets(self, game: \"GameState\") -> list[Any]:\n51\t+        \"\"\"Target a spell (any object on the stack).\"\"\"\n52\t+        return [\n53\t+            TargetRequirement(\n54\t+                filter_fn=lambda obj: True,\n55\t+                description=\"target spell\",\n56\t+                zone=Zone.STACK,\n57\t+            )\n58\t+        ]\n59\t+\n60\t+    # ------------------------------------------------------------------\n61\t+    # Resolution\n62\t+    # ------------------------------------------------------------------\n63\t+\n64\t+    def on_resolve(self, game: \"GameState\") -> None:\n65\t+        \"\"\"Counter the target spell; if we control a Wizard, set up a\n66\t+        delayed trigger for a mana rebate of {C} equal to the countered\n67\t+        spell's CMC.\"\"\"\n68\t+        chosen = getattr(self, \"chosen_targets\", None)\n69\t+        if not chosen:\n70\t+            return\n71\t+\n72\t+        target_spell = chosen[0]\n73\t+        if target_spell is None:\n74\t+            return\n75\t+\n76\t+        controller = self.controller if self.controller is not None else self.owner\n77\t+        if controller is None:\n78\t+            return\n79\t+\n80\t+        # Capture mana spent (CMC of the countered spell) before moving it\n81\t+        mana_spent = getattr(target_spell, \"mana_cost\", None)\n82\t+        rebate_amount = mana_spent.cmc if mana_spent is not None else 0\n83\t+\n84\t+        # Counter the spell: move it from the stack zone to its owner's graveyard\n85\t+        spell_owner = getattr(target_spell, \"owner\", None)\n86\t+        if spell_owner is not None:\n87\t+            # Remove from the stack zone\n88\t+            if spell_owner.zones[Zone.STACK].contains(target_spell):\n89\t+                spell_owner.zones[Zone.STACK].remove(target_spell)\n90\t+            # Put into the owner's graveyard\n91\t+            spell_owner.zones[Zone.GRAVEYARD].add(target_spell)\n92\t+\n93\t+        # Check if the controller controls a Wizard\n94\t+        if not self._controls_wizard(game, controller):\n95\t+            return\n96\t+\n97\t+        # Register a delayed trigger for the mana rebate\n98\t+        source = self\n99\t+        amount = rebate_amount\n100\t+\n101\t+        def _effect(game: \"GameState\") -> None:\n102\t+            \"\"\"Add {C} equal to the countered spell's CMC to the controller's pool.\"\"\"\n103\t+            if amount > 0:\n104\t+                controller.mana_pool.add(ManaType.COLORLESS, amount)\n105\t+\n106\t+        trigger = TriggerRegistration(\n107\t+            event_type=TriggeredEvent,\n108\t+            condition=None,\n109\t+            effect=_effect,\n110\t+            source=source,\n111\t+            controller=controller,\n112\t+        )\n113\t+        game.trigger_manager.register(trigger)\n114\t+\n115\t+    # ------------------------------------------------------------------\n116\t+    # Helpers\n117\t+    # ------------------------------------------------------------------\n118\t+\n119\t+    @staticmethod\n120\t+    def _controls_wizard(game: \"GameState\", player: Any) -> bool:\n121\t+        \"\"\"Return True if *player* controls a permanent with the Wizard subtype.\"\"\"\n122\t+        battlefield = game.get_battlefield(player)\n123\t+        for obj in battlefield.get_all():\n124\t+            subtypes = getattr(obj, \"subtypes\", set())\n125\t+            if \"Wizard\" in subtypes:\n126\t+                return True\n127\t+        return False\n128\t"}]},"parent_tool_use_id":"toolu_014ZpL5s6be1noWnejL4M88x","session_id":"1fe34661-6a3c-4b16-8a42-0f618466dfcb","uuid":"99bc82f2-aea9-4bea-9229-7b500cbeba0f","timestamp":"2026-05-28T09:44:28.690Z","subagent_type":"Reviewer","task_description":"Review sos_57 implementation"}
