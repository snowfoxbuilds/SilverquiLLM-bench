r number 97.\n50\t+    \"\"\"\n51\t+\n52\t+    def __init__(self, **kwargs: Any) -> None:\n53\t+        kwargs.setdefault(\"name\", \"Ral Zarek, Guest Lecturer\")\n54\t+        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{B}{B}\"))\n55\t+        kwargs.setdefault(\"starting_loyalty\", 3)\n56\t+        kwargs.setdefault(\"supertypes\", set())\n57\t+        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.LEGENDARY}\n58\t+        kwargs.setdefault(\"subtypes\", set())\n59\t+        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Ral\"}\n60\t+        kwargs.setdefault(\n61\t+            \"rules_text\",\n62\t+            \"+1: Surveil 2.\\n\"\n63\t+            \"−1: Any number of target players each discard a card.\\n\"\n64\t+            \"−2: Return target creature card with mana value 3 or less \"\n65\t+            \"from your graveyard to the battlefield.\\n\"\n66\t+            \"−7: Flip five coins. Target opponent skips their next X turns, \"\n67\t+            \"where X is the number of coins that came up heads.\",\n68\t+        )\n69\t+        super().__init__(**kwargs)\n70\t+\n71\t+    # ------------------------------------------------------------------\n72\t+    # Targeting (for -2 ability)\n73\t+    # ------------------------------------------------------------------\n74\t+\n75\t+    def get_targets(self, game: GameState) -> list[Any]:\n76\t+        \"\"\"Return target requirements.\n77\t+\n78\t+        The -2 ability targets a creature card with mana value 3 or less\n79\t+        in the controller's graveyard.\n80\t+        \"\"\"\n81\t+        return [\n82\t+            TargetRequirement(\n83\t+                filter_fn=_is_creature_mv_le_3,\n84\t+                description=\"target creature card with mana value 3 or less in your graveyard\",\n85\t+                zone=Zone.GRAVEYARD,\n86\t+            )\n87\t+        ]\n88\t+\n89\t+    # ------------------------------------------------------------------\n90\t+    # Loyalty abilities\n91\t+    # ------------------------------------------------------------------\n92\t+\n93\t+    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n94\t+        pw = self\n95\t+\n96\t+        def _plus1_surveil(game: GameState) -> None:\n97\t+            \"\"\"+1: Surveil 2 -- look at top 2 cards, put any number into\n98\t+            graveyard, rest on top of library in any order.\n99\t+\n100\t+            Default implementation puts all surveiled cards into the graveyard.\n101\t+            \"\"\"\n102\t+            controller = pw.controller\n103\t+            if controller is None:\n104\t+                return\n105\t+\n106\t+            library = controller.zones[Zone.LIBRARY]\n107\t+            count = min(2, len(library))\n108\t+            if count == 0:\n109\t+                return\n110\t+\n111\t+            # Get the top N cards (last N in the list)\n112\t+            surveiled = library.top(count)\n113\t+            # Move all to graveyard (simplified surveil)\n114\t+            graveyard = controller.zones[Zone.GRAVEYARD]\n115\t+            for card in surveiled:\n116\t+                library.remove(card)\n117\t+                graveyard.add(card)\n118\t+\n119\t+        def _minus1_discard(game: GameState) -> None:\n120\t+            \"\"\"-1: Any number of target players each discard a card.\"\"\"\n121\t+            from engine.game import discard\n122\t+\n123\t+            targets = getattr(pw, \"_resolve_targets\", None) or getattr(pw, \"chosen_targets\", None) or []\n124\t+            for player in targets:\n125\t+                if player is None:\n126\t+                    continue\n127\t+                hand = player.zones[Zone.HAND]\n128\t+                cards_in_hand = hand.get_all()\n129\t+                if cards_in_hand:\n130\t+                    # Discard the last card in hand (simplified choice)\n131\t+                    card_to_discard = cards_in_hand[-1]\n132\t+                    discard(game, player, card_to_discard)\n133\t+\n134\t+        def _minus2_reanimate(game: GameState) -> None:\n135\t+            \"\"\"-2: Return target creature card with MV <= 3 from graveyard\n136\t+            to the battlefield.\"\"\"\n137\t+            target = getattr(pw, \"_resolve_target\", None)\n138\t+            if target is None:\n139\t+                chosen = getattr(pw, \"chosen_targets\", None)\n140\t+                if chosen:\n141\t+                    target = chosen[0]\n142\t+            if target is None:\n143\t+                return\n144\t+\n145\t+            controller = pw.controller\n146\t+            if controller is None:\n147\t+                return\n148\t+\n149\t+            graveyard = controller.zones[Zone.GRAVEYARD]\n150\t+            if not graveyard.contains(target):\n151\t+                return\n152\t+\n153\t+            # Move from graveyard to battlefield (high-level move fires ETB events)\n154\t+            from engine.zones import move_to_zone\n155\t+            move_to_zone(game, target, Zone.GRAVEYARD, Zone.BATTLEFIELD)\n156\t+\n157\t+            # Ensure controller is set on the reanimated creature\n158\t+            target.controller = controller\n159\t+\n160\t+        def _minus7_ultimate(game: GameState) -> None:\n161\t+            \"\"\"-7: Flip five coins. Target opponent skips their next X turns,\n162\t+            where X is the number of coins that came up heads.\"\"\"\n163\t+            target = getattr(pw, \"_resolve_target\", None)\n164\t+            if target is None:\n165\t+                targets = getattr(pw, \"_resolve_targets\", None) or getattr(pw, \"chosen_targets\", None) or []\n166\t+                if targets:\n167\t+                    target = targets[0]\n168\t+            if target is None:\n169\t+                return\n170\t+\n171\t+            # Determine coin flip results\n172\t+            coin_results = getattr(pw, \"_coin_results\", None)\n173\t+            if coin_results is not None:\n174\t+                heads_count = sum(1 for r in coin_results if r)\n175\t+            else:\n176\t+                heads_count = 0\n177\t+                for _ in range(5):\n178\t+                    if random.choice([True, False]):\n179\t+                        heads_count += 1\n180\t+\n181\t+            # Apply turn-skipping to the target opponent\n182\t+            if heads_count > 0:\n183\t+                if not hasattr(target, \"skip_turns\"):\n184\t+                    target.skip_turns = 0\n185\t+                target.skip_turns += heads_count\n186\t+\n187\t+        return [\n188\t+            LoyaltyAbility(\n189\t+                loyalty_cost=1,\n190\t+                effect=_plus1_surveil,\n191\t+                description=\"+1: Surveil 2.\",\n192\t+            ),\n193\t+            LoyaltyAbility(\n194\t+                loyalty_cost=-1,\n195\t+                effect=_minus1_discard,\n196\t+                description=\"−1: Any number of target players each discard a card.\",\n197\t+            ),\n198\t+            LoyaltyAbility(\n199\t+                loyalty_cost=-2,\n200\t+                effect=_minus2_reanimate,\n201\t+                description=\"−2: Return target creature card with mana value 3 or less from your graveyard to the battlefield.\",\n202\t+            ),\n203\t+            LoyaltyAbility(\n204\t+                loyalty_cost=-7,\n205\t+                effect=_minus7_ultimate,\n206\t+                description=\"−7: Flip five coins. Target opponent skips their next X turns, where X is the number of coins that came up heads.\",\n207\t+            ),\n208\t+        ]\n209\t"}]},"parent_tool_use_id":"toolu_01XT1rPHAvAWPtR7g7nJVFmE","session_id":"1fe34661-6a3c-4b16-8a42-0f618466dfcb","uuid":"7b52773a-a79a-41ac-b4b1-15c667d8201f","timestamp":"2026-05-28T09:56:26.037Z","subagent_type":"Implementer","task_description":"Revise sos_97 per review"}
