{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Bc3xyiAXNB8LwQHfJRj5Rt","type":"tool_result","content":"1\t\"\"\"Card implementation for Ral Zarek, Guest Lecturer.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport random\n6\tfrom typing import TYPE_CHECKING, Any\n7\t\n8\tfrom engine.card import Creature, LoyaltyAbility, Planeswalker\n9\tfrom engine.types import CardType, ManaCost, Supertype, TargetRequirement, Zone\n10\t\n11\tif TYPE_CHECKING:\n12\t    from engine.game_state import GameState\n13\t\n14\t\n15\tdef _is_creature_mv_le_3(card: Any) -> bool:\n16\t    \"\"\"Return True if *card* is a creature card with mana value 3 or less.\"\"\"\n17\t    card_types = getattr(card, \"card_types\", set())\n18\t    if CardType.CREATURE not in card_types:\n19\t        return False\n20\t    mana_cost = getattr(card, \"mana_cost\", None)\n21\t    if mana_cost is None:\n22\t        # No mana cost means MV 0\n23\t        return True\n24\t    cmc = getattr(mana_cost, \"cmc\", 0)\n25\t    return cmc <= 3\n26\t\n27\t\n28\tclass RalZarekGuestLecturer(Planeswalker):\n29\t    \"\"\"Ral Zarek, Guest Lecturer -- {1}{B}{B} -- Legendary Planeswalker -- Ral\n30\t\n31\t    Starting loyalty 3.\n32\t\n33\t    +1: Surveil 2.\n34\t    -1: Any number of target players each discard a card.\n35\t    -2: Return target creature card with mana value 3 or less from your\n36\t        graveyard to the battlefield.\n37\t    -7: Flip five coins. Target opponent skips their next X turns, where\n38\t        X is the number of coins that came up heads.\n39\t\n40\t    SOS collector number 97.\n41\t    \"\"\"\n42\t\n43\t    def __init__(self, **kwargs: Any) -> None:\n44\t        kwargs.setdefault(\"name\", \"Ral Zarek, Guest Lecturer\")\n45\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{1}{B}{B}\"))\n46\t        kwargs.setdefault(\"starting_loyalty\", 3)\n47\t        kwargs.setdefault(\"supertypes\", set())\n48\t        kwargs[\"supertypes\"] = (kwargs.get(\"supertypes\") or set()) | {Supertype.LEGENDARY}\n49\t        kwargs.setdefault(\"subtypes\", set())\n50\t        kwargs[\"subtypes\"] = (kwargs.get(\"subtypes\") or set()) | {\"Ral\"}\n51\t        kwargs.setdefault(\n52\t            \"rules_text\",\n53\t            \"+1: Surveil 2.\\n\"\n54\t            \"−1: Any number of target players each discard a card.\\n\"\n55\t            \"−2: Return target creature card with mana value 3 or less \"\n56\t            \"from your graveyard to the battlefield.\\n\"\n57\t            \"−7: Flip five coins. Target opponent skips their next X turns, \"\n58\t            \"where X is the number of coins that came up heads.\",\n59\t        )\n60\t        super().__init__(**kwargs)\n61\t\n62\t    # ------------------------------------------------------------------\n63\t    # Targeting (for -2 ability)\n64\t    # ------------------------------------------------------------------\n65\t\n66\t    def get_targets(self, game: GameState) -> list[Any]:\n67\t        \"\"\"Return target requirements.\n68\t\n69\t        The -2 ability targets a creature card with mana value 3 or less\n70\t        in the controller's graveyard.\n71\t        \"\"\"\n72\t        return [\n73\t            TargetRequirement(\n74\t                filter_fn=_is_creature_mv_le_3,\n75\t                description=\"target creature card with mana value 3 or less in your graveyard\",\n76\t                zone=Zone.GRAVEYARD,\n77\t            )\n78\t        ]\n79\t\n80\t    # ------------------------------------------------------------------\n81\t    # Loyalty abilities\n82\t    # ------------------------------------------------------------------\n83\t\n84\t    def get_loyalty_abilities(self) -> list[LoyaltyAbility]:\n85\t        pw = self\n86\t\n87\t        def _plus1_surveil(game: GameState) -> None:\n88\t            \"\"\"+1: Surveil 2 -- look at top 2 cards, put any number into\n89\t            graveyard, rest on top of library in any order.\n90\t\n91\t            Default implementation puts all surveiled cards into the graveyard.\n92\t            \"\"\"\n93\t            controller = pw.controller\n94\t            if controller is None:\n95\t                return\n96\t\n97\t            library = controller.zones[Zone.LIBRARY]\n98\t            count = min(2, len(library))\n99\t            if count == 0:\n100\t                return\n101\t\n102\t            # Get the top N cards (last N in the list)\n103\t            surveiled = library.top(count)\n104\t            # Move all to graveyard (simplified surveil)\n105\t            graveyard = controller.zones[Zone.GRAVEYARD]\n106\t            for card in surveiled:\n107\t                library.remove(card)\n108\t                graveyard.add(card)\n109\t\n110\t        def _minus1_discard(game: GameState) -> None:\n111\t            \"\"\"-1: Any number of target players each discard a card.\"\"\"\n112\t            from engine.game import discard\n113\t\n114\t            targets = getattr(pw, \"_resolve_targets\", None) or getattr(pw, \"chosen_targets\", None) or []\n115\t            for player in targets:\n116\t                if player is None:\n117\t                    continue\n118\t                hand = player.zones[Zone.HAND]\n119\t                cards_in_hand = hand.get_all()\n120\t                if cards_in_hand:\n121\t                    # Discard the last card in hand (simplified choice)\n122\t                    card_to_discard = cards_in_hand[-1]\n123\t                    discard(game, player, card_to_discard)\n124\t\n125\t        def _minus2_reanimate(game: GameState) -> None:\n126\t            \"\"\"-2: Return target creature card with MV <= 3 from graveyard\n127\t            to the battlefield.\"\"\"\n128\t            target = getattr(pw, \"_resolve_target\", None)\n129\t            if target is None:\n130\t                chosen = getattr(pw, \"chosen_targets\", None)\n131\t                if chosen:\n132\t                    target = chosen[0]\n133\t            if target is None:\n134\t                return\n135\t\n136\t            controller = pw.controller\n137\t            if controller is None:\n138\t                return\n139\t\n140\t            graveyard = controller.zones[Zone.GRAVEYARD]\n141\t            if not graveyard.contains(target):\n142\t                return\n143\t\n144\t            # Move from graveyard to battlefield\n145\t            from engine.zones import move_zone\n146\t            battlefield = game.get_battlefield(controller)\n147\t            move_zone(target, graveyard, battlefield)\n148\t\n149\t            # Set controller on the reanimated creature\n150\t            target.controller = controller\n151\t\n152\t        def _minus7_ultimate(game: GameState) -> None:\n153\t            \"\"\"-7: Flip five coins. Target opponent skips their next X turns,\n154\t            where X is the number of coins that came up heads.\"\"\"\n155\t            target = getattr(pw, \"_resolve_target\", None)\n156\t            if target is None:\n157\t                targets = getattr(pw, \"_resolve_targets\", None) or getattr(pw, \"chosen_targets\", None) or []\n158\t                if targets:\n159\t                    target = targets[0]\n160\t            if target is None:\n161\t                return\n162\t\n163\t            # Determine coin flip results\n164\t            coin_results = getattr(pw, \"_coin_results\", None)\n165\t            if coin_results is not None:\n166\t                heads_count = sum(1 for r in coin_results if r)\n167\t            else:\n168\t                heads_count = 0\n169\t                for _ in range(5):\n170\t                    if random.choice([True, False]):\n171\t                        heads_count += 1\n172\t\n173\t            # Apply turn-skipping to the target opponent\n174\t            if heads_count > 0:\n175\t                if not hasattr(target, \"skip_turns\"):\n176\t                    target.skip_turns = 0\n177\t                target.skip_turns += heads_count\n178\t\n179\t        return [\n180\t            LoyaltyAbility(\n181\t                loyalty_cost=1,\n182\t                effect=_plus1_surveil,\n183\t                description=\"+1: Surveil 2.\",\n184\t            ),\n185\t            LoyaltyAbility(\n186\t                loyalty_cost=-1,\n187\t                effect=_minus1_discard,\n188\t                description=\"−1: Any number of target players each discard a card.\",\n189\t            ),\n190\t            LoyaltyAbility(\n191\t                loyalty_cost=-2,\n192\t                effect=_minus2_reanimate,\n193\t                description=\"−2: Return target creature card with mana value 3 or less from your graveyard to the battlefield.\",\n194\t            ),\n195\t            LoyaltyAbility(\n196\t                loyalty_cost=-7,\n197\t                effect=_minus7_ultimate,\n198\t                description=\"−7: Flip five coins. Target opponent skips their next X turns, where X is the number of coins that came up heads.\",\n199\t            ),\n200\t        ]\n201\t"}]},"parent_tool_use_id":"toolu_01GrmWnu9DHQeBxsFqSJEsVC","session_id":"1fe34661-6a3c-4b16-8a42-0f618466dfcb","uuid":"0d152452-fc5c-4056-aff2-159424c970a6","timestamp":"2026-05-28T09:53:17.007Z","subagent_type":"Reviewer","task_description":"Review sos_97 implementation"}
