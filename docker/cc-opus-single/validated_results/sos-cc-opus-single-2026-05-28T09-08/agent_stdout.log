nchant creature, land, or planeswalker\",\ncards/fdn/fdn_156/card_impl.py:91:        return bool(_creature_land_planeswalker_targets(game))\ncards/fdn/fdn_156/card_impl.py:101:        # Revalidate that target is still a creature, land, or planeswalker.\ncards/fdn/fdn_156/card_impl.py:103:        if not (ctypes & {CardType.CREATURE, CardType.LAND, CardType.PLANESWALKER}):\ncards/fdn/fdn_274/card_impl.py:11:class Island(CardImpl):\ncards/fdn/fdn_133/card_spec.json:5:  \"oracle_text\": \"{T}: Add {C}.\\n{4}: This land becomes a 3/3 creature with vigilance and all creature types. It's still a land.\",\ncards/fdn/fdn_39/card_impl.py:13:    Landfall — Whenever a land you control enters, tap target creature an\ncards/fdn/fdn_39/card_impl.py:25:        kwargs.setdefault('rules_text', 'Landfall — Whenever a land you control enters, tap target creature an opponent controls and put a stun counter on it.')\ncards/fdn/fdn_39/card_impl.py:29:        \"\"\"Register landfall trigger: tap + stun counter on opponent creature.\"\"\"\ncards/fdn/fdn_107/card_impl.py:27:        kwargs.setdefault('rules_text', 'Trample\\nThis creature enters with a +1/+1 counter on it.\\nLandfall — Whenever a land you control enters, double the number of +1/+1 counters on this creature.')\ncards/fdn/fdn_39/card_spec.json:5:  \"oracle_text\": \"Landfall — Whenever a land you control enters, tap target creature an opponent controls and put a stun counter on it. (If a permanent with a stun counter would become untapped, remove one from it instead.)\",\ncards/fdn/fdn_107/card_spec.json:5:  \"oracle_text\": \"Trample (This creature can deal excess combat damage to the player or planeswalker it's attacking.)\\nThis creature enters with a +1/+1 counter on it.\\nLandfall — Whenever a land you control enters, double the number of +1/+1 counters on this creature.\","}]},"parent_tool_use_id":"toolu_01HNsRt9vvRNEj2p2fsNqzt3","session_id":"1fe34661-6a3c-4b16-8a42-0f618466dfcb","uuid":"4dc9e17c-d8de-482e-a540-cac861f65