{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015h2t4bPJqrPa6dp21joG4k","type":"tool_result","content":"249\t# ------------------------------------------------------------------\n250\t# Cast spell without paying mana cost (free-cast from any zone)\n251\t# ------------------------------------------------------------------\n252\t\n253\t\n254\tdef cast_spell_free(\n255\t    game: GameState,\n256\t    player: Player,\n257\t    card: CardImpl,\n258\t    from_zone: Zone,\n259\t) -> None:\n260\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n261\t\n262\t    This is used by effects that allow casting from zones other than hand\n263\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n264\t    or cascade.\n265\t\n266\t    Pipeline\n267\t    --------\n268\t    1. **can_cast** — ask the card whether it can legally be cast (same\n269\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n270\t    2. Move *card* from *from_zone* to the stack zone.\n271\t    3. Choose targets (if applicable) with validation and protection check.\n272\t    4. Call ``on_cast`` hook.\n273\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n274\t       resolution normally (permanents → battlefield, non-permanents →\n275\t       graveyard).\n276\t\n277\t    No timing check or mana payment is performed.  The spell goes on the\n278\t    stack and can be responded to normally (e.g. countered).\n279\t\n280\t    If targeting or other post-move checks fail, the card is rolled back\n281\t    to its source zone.\n282\t\n283\t    Parameters:\n284\t        game: The current game state.\n285\t        player: The player casting the spell.\n286\t        card: The card to cast.\n287\t        from_zone: The zone the card is currently in.\n288\t\n289\t    Raises:\n290\t        CastingError: If the card cannot be found in *from_zone* or\n291\t            legality checks fail.\n292\t    \"\"\"\n293\t    from engine.zones import move_to_zone\n294\t\n295\t    # Ensure controller is set\n296\t    card.controller = player\n297\t    if card.owner is None:\n298\t        card.owner = player\n299\t\n300\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n301\t    if not card.can_cast(game):\n302\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n303\t\n304\t    # 2. Locate card in source zone\n305\t    source_zone_container = player.zones[from_zone]\n306\t    if not source_zone_container.contains(card):\n307\t        # Try to find the card in any player's zone\n308\t        source_zone_container = None\n309\t        for p in game.players:\n310\t            z = p.zones[from_zone]\n311\t            if z.contains(card):\n312\t                source_zone_container = z\n313\t                break\n314\t\n315\t    if source_zone_container is None or not source_zone_container.contains(card):\n316\t        raise CastingError(\n317\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n318\t        )\n319\t\n320\t    # Move card from source zone to stack zone\n321\t    stack_zone = player.zones[Zone.STACK]\n322\t    source_zone_container.remove(card)\n323\t    stack_zone.add(card)\n324\t\n325\t    # 3. Choose targets (with rollback on failure)\n326\t    try:\n327\t        target_specs = card.get_targets(game)\n328\t        chosen_targets: list[Any] = []\n329\t        if target_specs:\n330\t            for spec in target_specs:\n331\t                target = player.choose_target(target_specs, spec)\n332\t                # Validate against filter_fn if the spec provides one\n333\t                filter_fn = getattr(spec, \"filter_fn\", None)\n334\t                if filter_fn is not None and target is not None:\n335\t                    if not filter_fn(target):\n336\t                        raise CastingError(\n337\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n338\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n339\t                        )\n340\t                chosen_targets.append(target)\n341\t\n342\t        # Protection check — reject targets that have protection from this spell\n343\t        from engine.protection import has_protection_from\n344\t\n345\t        for target in chosen_targets:\n346\t            if has_protection_from(target, card):\n347\t                raise CastingError(\n348\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\""}]},"parent_tool_use_id":"toolu_01Y7Qz4pTXecHCahQvRW24SL","session_id":"1fe34661-6a3c-4b16-8a42-0f618466dfcb","uuid":"d4c4b2ae-085a-4d9b-996e-a21f7f26151d","timestamp":"2026-05-28T09:22:44.030Z","subagent_type":"Tester","task_description":"Write tests for sos_4"}
