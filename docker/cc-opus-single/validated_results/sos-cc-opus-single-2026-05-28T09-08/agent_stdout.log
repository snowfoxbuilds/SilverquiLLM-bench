{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011d6ZkRvXtyQ9UKVenQqTAx","type":"tool_result","content":"1\t\"\"\"Card implementation for Great Hall of the Biblioplex.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import ActivatedAbility, Land, ManaAbility\n8\tfrom engine.continuous_effects import (\n9\t    ContinuousEffect,\n10\t    DURATION_END_OF_TURN,\n11\t    Layer,\n12\t    SubLayer,\n13\t)\n14\tfrom engine.events import SpellCastTriggeredEvent\n15\tfrom engine.triggers import TriggerRegistration\n16\tfrom engine.types import CardType, ManaCost, ManaType\n17\t\n18\tif TYPE_CHECKING:\n19\t    from engine.game_state import GameState\n20\t\n21\t\n22\tclass GreatHallOfTheBiblioplex(Land):\n23\t    \"\"\"Great Hall of the Biblioplex -- Land.\n24\t\n25\t    {T}: Add {C}.\n26\t    {T}, Pay 1 life: Add one mana of any color. Spend this mana only to\n27\t    cast an instant or sorcery spell.\n28\t    {5}: If this land isn't a creature, it becomes a 2/4 Wizard creature\n29\t    with \"Whenever you cast an instant or sorcery spell, this creature\n30\t    gets +1/+0 until end of turn.\" It's still a land.\n31\t\n32\t    SOS collector number 257.\n33\t    \"\"\"\n34\t\n35\t    def __init__(self, **kwargs: Any) -> None:\n36\t        kwargs.setdefault(\"name\", \"Great Hall of the Biblioplex\")\n37\t        kwargs.setdefault(\"mana_cost\", ManaCost())\n38\t        kwargs.setdefault(\n39\t            \"rules_text\",\n40\t            \"{T}: Add {C}.\\n\"\n41\t            \"{T}, Pay 1 life: Add one mana of any color. Spend this mana \"\n42\t            \"only to cast an instant or sorcery spell.\\n\"\n43\t            \"{5}: If this land isn't a creature, it becomes a 2/4 Wizard \"\n44\t            'creature with \"Whenever you cast an instant or sorcery spell, '\n45\t            'this creature gets +1/+0 until end of turn.\" It\\'s still a land.',\n46\t        )\n47\t        super().__init__(**kwargs)\n48\t        # Creature attributes (set when animated)\n49\t        self._is_animated: bool = False\n50\t        self.base_power: int = 0\n51\t        self.base_toughness: int = 0\n52\t        self.modified_power: int = 0\n53\t        self.modified_toughness: int = 0\n54\t        self.subtypes: set[str] = kwargs.get(\"subtypes\", set()) or set()\n55\t\n56\t    # ------------------------------------------------------------------\n57\t    # Properties for creature power/toughness (mimic Creature interface)\n58\t    # ------------------------------------------------------------------\n59\t\n60\t    @property\n61\t    def power(self) -> int:\n62\t        \"\"\"Current power (includes modified_power from continuous effects).\"\"\"\n63\t        return self.modified_power\n64\t\n65\t    @property\n66\t    def toughness(self) -> int:\n67\t        \"\"\"Current toughness.\"\"\"\n68\t        return self.modified_toughness\n69\t\n70\t    # ------------------------------------------------------------------\n71\t    # Mana abilities\n72\t    # ------------------------------------------------------------------\n73\t\n74\t    def get_mana_abilities(self) -> list[ManaAbility]:\n75\t        \"\"\"Return the land's two mana abilities.\"\"\"\n76\t        card = self\n77\t\n78\t        # Ability 1: {T}: Add {C}\n79\t        def colorless_cost(game: GameState, source: Any) -> bool:\n80\t            if card.is_tapped:\n81\t                return False\n82\t            card.is_tapped = True\n83\t            return True\n84\t\n85\t        def colorless_mana_produced(game: GameState) -> None:\n86\t            controller = card.controller\n87\t            if controller is not None:\n88\t                controller.mana_pool.add(ManaType.COLORLESS, 1)\n89\t\n90\t        colorless_ability = ManaAbility(\n91\t            cost=colorless_cost,\n92\t            mana_produced=colorless_mana_produced,\n93\t            description=\"{T}: Add {C}.\",\n94\t        )\n95\t\n96\t        # Ability 2: {T}, Pay 1 life: Add one mana of any color\n97\t        def any_color_cost(game: GameState, source: Any) -> bool:\n98\t            if card.is_tapped:\n99\t                return False\n100\t            controller = card.controller\n101\t            if controller is None:\n102\t                return False\n103\t            card.is_tapped = True\n104\t            controller.life -= 1\n105\t            return True\n106\t\n107\t        def any_color_mana_produced(game: GameState) -> None:\n108\t            controller = card.controller\n109\t            if controller is None:\n110\t                return\n111\t            # Default to adding WHITE mana (the player would normally choose)\n112\t            controller.mana_pool.add(ManaType.WHITE, 1)\n113\t\n114\t        any_color_ability = ManaAbility(\n115\t            cost=any_color_cost,\n116\t            mana_produced=any_color_mana_produced,\n117\t            description=\"{T}, Pay 1 life: Add one mana of any color.\",\n118\t        )\n119\t\n120\t        return [colorless_ability, any_color_ability]\n121\t\n122\t    # ------------------------------------------------------------------\n123\t    # Activated ability: {5} animate\n124\t    # ------------------------------------------------------------------\n125\t\n126\t    def get_activated_abilities(self) -> list[ActivatedAbility]:\n127\t        \"\"\"Return the {5} animate ability.\"\"\"\n128\t        card = self\n129\t\n130\t        def animate_cost(game: GameState, source: Any) -> bool:\n131\t            controller = card.controller\n132\t            if controller is None:\n133\t                return False\n134\t            cost = ManaCost(generic=5)\n135\t            return controller.mana_pool.pay(cost)\n136\t\n137\t        def animate_effect(game: GameState) -> None:\n138\t            # \"If this land isn't a creature\" check\n139\t            if CardType.CREATURE in card.card_types:\n140\t                return\n141\t\n142\t            # Add CREATURE type (still a land)\n143\t            card.card_types.add(CardType.CREATURE)\n144\t            card._original_card_types = frozenset(card.card_types)\n145\t\n146\t            # Set P/T\n147\t            card.base_power = 2\n148\t            card.base_toughness = 4\n149\t            card.modified_power = 2\n150\t            card.modified_toughness = 4\n151\t\n152\t            # Add Wizard subtype\n153\t            card.subtypes.add(\"Wizard\")\n154\t\n155\t            # Mark as animated\n156\t            card._is_animated = True\n157\t\n158\t            # Register the spell-cast trigger\n159\t            _register_spell_trigger(game, card)\n160\t\n161\t        return [\n162\t            ActivatedAbility(\n163\t                cost=animate_cost,\n164\t                effect=animate_effect,\n165\t                description=(\n166\t                    \"{5}: If this land isn't a creature, it becomes a 2/4 \"\n167\t                    \"Wizard creature. It's still a land.\"\n168\t                ),\n169\t            )\n170\t        ]\n171\t\n172\t\n173\tdef _register_spell_trigger(game: GameState, card: GreatHallOfTheBiblioplex) -> None:\n174\t    \"\"\"Register the 'whenever you cast an instant or sorcery' trigger.\"\"\"\n175\t    # Avoid duplicates\n176\t    game.trigger_manager.unregister(card)\n177\t\n178\t    controller = card.controller if card.controller is not None else card.owner\n179\t    if controller is None:\n180\t        return\n181\t\n182\t    def _condition(g: GameState, event: SpellCastTriggeredEvent) -> bool:\n183\t        \"\"\"Only fire for the controller's instant/sorcery spells.\"\"\"\n184\t        if event.controller is not controller:\n185\t            return False\n186\t        spell_types = getattr(event.spell, \"card_types\", set())\n187\t        return CardType.INSTANT in spell_types or CardType.SORCERY in spell_types\n188\t\n189\t    def _pump_effect(g: GameState) -> None:\n190\t        \"\"\"Give the animated land +1/+0 until end of turn.\"\"\"\n191\t        # Directly modify the power and also register a continuous effect\n192\t        # so the pump persists through effect recalculations.\n193\t        card.modified_power += 1\n194\t\n195\t        def _apply_pump(game: GameState) -> None:\n196\t            # Only apply if the card is still on the battlefield\n197\t            for p in game.players:\n198\t                if game.get_battlefield(p).contains(card):\n199\t                    card.modified_power += 1\n200\t                    return\n201\t\n202\t        g.effect_manager.add(ContinuousEffect(\n203\t            source=card,\n204\t            layer=Layer.POWER_TOUGHNESS,\n205\t            sublayer=SubLayer.MODIFY_PT,\n206\t            apply=_apply_pump,\n207\t            duration=DURATION_END_OF_TURN,\n208\t        ))\n209\t\n210\t    trigger = TriggerRegistration(\n211\t        event_type=SpellCastTriggeredEvent,\n212\t        condition=_condition,\n213\t        effect=_pump_effect,\n214\t        source=card,\n215\t        controller=controller,\n216\t    )\n217\t    game.trigger_manager.register(trigger)\n218\t"}]},"parent_tool_use_id":"toolu_0161GfsJrvQwHK2xZfhhxMCo","session_id":"1fe34661-6a3c-4b16-8a42-0f618466dfcb","uuid":"601914ae-412e-4700-93af-3daddb7c356a","timestamp":"2026-05-28T10:38:30.008Z","subagent_type":"Reviewer","task_description":"Review sos_257 implementation"}
