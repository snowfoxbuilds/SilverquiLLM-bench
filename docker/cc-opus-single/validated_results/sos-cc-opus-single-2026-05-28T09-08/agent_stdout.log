{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KCQJx3u9vTssMMVUzEnGKQ","type":"tool_result","content":"1\t\"\"\"Tests for SOS 1 — The Dawning Archaic.\n2\t\n3\tThe Dawning Archaic is a {10} Legendary Creature — Avatar with 7/7 and Reach.\n4\t\n5\tRequirements tested:\n6\t1. Static properties: name, mana cost, power/toughness, types, supertypes, keywords.\n7\t2. Cost reduction: costs {1} less for each instant and sorcery card in your graveyard.\n8\t3. Reach keyword.\n9\t4. Attack trigger: \"Whenever The Dawning Archaic attacks, you may cast target instant\n10\t   or sorcery card from your graveyard without paying its mana cost.\"\n11\t5. Replacement clause: \"If that spell would be put into your graveyard, exile it instead.\"\n12\t\"\"\"\n13\t\n14\tfrom __future__ import annotations\n15\t\n16\tfrom typing import Any\n17\t\n18\tfrom cards.sos.sos_1.card_impl import TheDawningArchaic\n19\tfrom engine.card import Creature, Instant, Sorcery\n20\tfrom engine.events import AttacksTriggeredEvent\n21\tfrom engine.triggers import TriggerRegistration\n22\tfrom engine.types import (\n23\t    CardType,\n24\t    Keyword,\n25\t    ManaCost,\n26\t    ManaType,\n27\t    Supertype,\n28\t    Zone,\n29\t)\n30\tfrom test_utils import create_game, set_board_state\n31\t\n32\t\n33\t# ---------------------------------------------------------------------------\n34\t# Static properties\n35\t# ---------------------------------------------------------------------------\n36\t\n37\t\n38\tclass TestTheDawningArchaicProperties:\n39\t    \"\"\"Static card data should match the SOS 1 spec.\"\"\"\n40\t\n41\t    def test_is_creature(self) -> None:\n42\t        card = TheDawningArchaic(owner=None)\n43\t        assert isinstance(card, Creature)\n44\t\n45\t    def test_name(self) -> None:\n46\t        assert TheDawningArchaic(owner=None).name == \"The Dawning Archaic\"\n47\t\n48\t    def test_mana_cost(self) -> None:\n49\t        assert TheDawningArchaic(owner=None).mana_cost == ManaCost.parse(\"{10}\")\n50\t\n51\t    def test_power_toughness(self) -> None:\n52\t        card = TheDawningArchaic(owner=None)\n53\t        assert card.base_power == 7\n54\t        assert card.base_toughness == 7\n55\t\n56\t    def test_is_legendary(self) -> None:\n57\t        card = TheDawningArchaic(owner=None)\n58\t        assert Supertype.LEGENDARY in card.supertypes\n59\t\n60\t    def test_has_avatar_subtype(self) -> None:\n61\t        card = TheDawningArchaic(owner=None)\n62\t        assert \"Avatar\" in card.subtypes\n63\t\n64\t    def test_has_reach(self) -> None:\n65\t        card = TheDawningArchaic(owner=None)\n66\t        assert Keyword.REACH in card.keywords\n67\t\n68\t    def test_has_creature_type(self) -> None:\n69\t        card = TheDawningArchaic(owner=None)\n70\t        assert CardType.CREATURE in card.card_types\n71\t\n72\t\n73\t# ---------------------------------------------------------------------------\n74\t# Cost reduction\n75\t# ---------------------------------------------------------------------------\n76\t\n77\t\n78\tclass TestTheDawningArchaicCostReduction:\n79\t    \"\"\"This spell costs {1} less for each instant and sorcery card in your graveyard.\"\"\"\n80\t\n81\t    def test_one_instant_in_graveyard_reduces_by_one(self) -> None:\n82\t        \"\"\"One instant in graveyard should reduce cost by 1.\"\"\"\n83\t        game = create_game()\n84\t        p1 = game.players[0]\n85\t        card = TheDawningArchaic(owner=p1, controller=p1)\n86\t\n87\t        bolt = Instant(name=\"Lightning Bolt\", owner=p1, controller=p1)\n88\t        set_board_state(game, 0, graveyard=[bolt])\n89\t\n90\t        reduction = card.cost_reduction(game)\n91\t        assert reduction == 1\n92\t\n93\t    def test_one_sorcery_in_graveyard_reduces_by_one(self) -> None:\n94\t        \"\"\"One sorcery in graveyard should reduce cost by 1.\"\"\"\n95\t        game = create_game()\n96\t        p1 = game.players[0]\n97\t        card = TheDawningArchaic(owner=p1, controller=p1)\n98\t\n99\t        divination = Sorcery(name=\"Divination\", owner=p1, controller=p1)\n100\t        set_board_state(game, 0, graveyard=[divination])\n101\t\n102\t        reduction = card.cost_reduction(game)\n103\t        assert reduction == 1\n104\t\n105\t    def test_multiple_instants_and_sorceries(self) -> None:\n106\t        \"\"\"Multiple instants and sorceries should each reduce cost by 1.\"\"\"\n107\t        game = create_game()\n108\t        p1 = game.players[0]\n109\t        card = TheDawningArchaic(owner=p1, controller=p1)\n110\t\n111\t        bolt = Instant(name=\"Lightning Bolt\", owner=p1, controller=p1)\n112\t        shock = Instant(name=\"Shock\", owner=p1, controller=p1)\n113\t        divination = Sorcery(name=\"Divination\", owner=p1, controller=p1)\n114\t        set_board_state(game, 0, graveyard=[bolt, shock, divination])\n115\t\n116\t        reduction = card.cost_reduction(game)\n117\t        assert reduction == 3\n118\t\n119\t    def test_creatures_in_graveyard_do_not_reduce_cost(self) -> None:\n120\t        \"\"\"Creature cards in graveyard should not count toward reduction.\"\"\"\n121\t        game = create_game()\n122\t        p1 = game.players[0]\n123\t        card = TheDawningArchaic(owner=p1, controller=p1)\n124\t\n125\t        bear = Creature(name=\"Grizzly Bears\", owner=p1, controller=p1,\n126\t                        base_power=2, base_toughness=2)\n127\t        set_board_state(game, 0, graveyard=[bear])\n128\t\n129\t        reduction = card.cost_reduction(game)\n130\t        assert reduction == 0\n131\t\n132\t    def test_mixed_card_types_only_counts_instants_sorceries(self) -> None:\n133\t        \"\"\"Only instant and sorcery cards count, not creatures or other types.\"\"\"\n134\t        game = create_game()\n135\t        p1 = game.players[0]\n136\t        card = TheDawningArchaic(owner=p1, controller=p1)\n137\t\n138\t        bolt = Instant(name=\"Lightning Bolt\", owner=p1, controller=p1)\n139\t        bear = Creature(name=\"Grizzly Bears\", owner=p1, controller=p1,\n140\t                        base_power=2, base_toughness=2)\n141\t        divination = Sorcery(name=\"Divination\", owner=p1, controller=p1)\n142\t        set_board_state(game, 0, graveyard=[bolt, bear, divination])\n143\t\n144\t        reduction = card.cost_reduction(game)\n145\t        assert reduction == 2\n146\t\n147\t    def test_opponent_graveyard_does_not_count(self) -> None:\n148\t        \"\"\"Only the controller's graveyard should be counted.\"\"\"\n149\t        game = create_game()\n150\t        p1 = game.players[0]\n151\t        p2 = game.players[1]\n152\t        card = TheDawningArchaic(owner=p1, controller=p1)\n153\t\n154\t        # Put instants in opponent's graveyard, not controller's\n155\t        bolt = Instant(name=\"Lightning Bolt\", owner=p2, controller=p2)\n156\t        set_board_state(game, 1, graveyard=[bolt])\n157\t\n158\t        reduction = card.cost_reduction(game)\n159\t        assert reduction == 0\n160\t\n161\t    def test_reduction_up_to_ten(self) -> None:\n162\t        \"\"\"With 10+ instants/sorceries, the cost reduction should be at least 10\n163\t        (the full generic cost), making it castable for free.\"\"\"\n164\t        game = create_game()\n165\t        p1 = game.players[0]\n166\t        card = TheDawningArchaic(owner=p1, controller=p1)\n167\t\n168\t        gy_cards = []\n169\t        for i in range(10):\n170\t            gy_cards.append(Instant(name=f\"Spell_{i}\", owner=p1, controller=p1))\n171\t        set_board_state(game, 0, graveyard=gy_cards)\n172\t\n173\t        reduction = card.cost_reduction(game)\n174\t        assert reduction == 10\n175\t\n176\t\n177\t# ---------------------------------------------------------------------------\n178\t# Attack trigger — registration\n179\t# ---------------------------------------------------------------------------\n180\t\n181\t\n182\tclass TestTheDawningArchaicTriggerRegistration:\n183\t    \"\"\"Whenever The Dawning Archaic attacks, the trigger should be registered.\"\"\"\n184\t\n185\t    def test_registers_attack_trigger(self) -> None:\n186\t        \"\"\"register_triggers should register at least one AttacksTriggeredEvent trigger.\"\"\"\n187\t        game = create_game()\n188\t        p1 = game.players[0]\n189\t        card = TheDawningArchaic(owner=p1, controller=p1)\n190\t        game.get_battlefield(p1).add(card)\n191\t\n192\t        before_count = len(game.trigger_manager.get_triggers())\n193\t        card.register_triggers(game)\n194\t        after_count = len(game.trigger_manager.get_triggers())\n195\t\n196\t        assert after_count > before_count\n197\t\n198\t    def test_registered_trigger_watches_attacks_event(self) -> None:\n199\t        \"\"\"The registered trigger should watch for AttacksTriggeredEvent.\"\"\"\n200\t        game = create_game()\n201\t        p1 = game.players[0]\n202\t        card = TheDawningArchaic(owner=p1, controller=p1)\n203\t        game.get_battlefield(p1).add(card)\n204\t        card.register_triggers(game)\n205\t\n206\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n207\t        attack_triggers = [\n208\t            t for t in triggers if t.event_type is AttacksTriggeredEvent\n209\t        ]\n210\t        assert len(attack_triggers) >= 1\n211\t\n212\t    def test_trigger_condition_matches_self_attacking(self) -> None:\n213\t        \"\"\"The trigger condition should match when this creature attacks.\"\"\"\n214\t        game = create_game()\n215\t        p1 = game.players[0]\n216\t        card = TheDawningArchaic(owner=p1, controller=p1)\n217\t        game.get_battlefield(p1).add(card)\n218\t        card.register_triggers(game)\n219\t\n220\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n221\t        attack_triggers = [\n222\t            t for t in triggers if t.event_type is AttacksTriggeredEvent\n223\t        ]\n224\t        assert len(attack_triggers) >= 1\n225\t\n226\t        # Build an event where this creature attacks\n227\t        event = AttacksTriggeredEvent(creature=card, attacker=card)\n228\t        trigger = attack_triggers[0]\n229\t        if trigger.condition is not None:\n230\t            assert trigger.condition(game, event) is True\n231\t\n232\t    def test_trigger_condition_does_not_match_other_creature(self) -> None:\n233\t        \"\"\"The trigger should NOT fire when a different creature attacks.\"\"\"\n234\t        game = create_game()\n235\t        p1 = game.players[0]\n236\t        card = TheDawningArchaic(owner=p1, controller=p1)\n237\t        game.get_battlefield(p1).add(card)\n238\t        card.register_triggers(game)\n239\t\n240\t        other = Creature(name=\"Other Creature\", owner=p1, controller=p1,\n241\t                         base_power=2, base_toughness=2)\n242\t\n243\t        triggers = game.trigger_manager.get_triggers_for_source(card)\n244\t        attack_triggers = [\n245\t            t for t in triggers if t.event_type is AttacksTriggeredEvent\n246\t        ]\n247\t        assert len(attack_triggers) >= 1\n248\t\n249\t        event = AttacksTriggeredEvent(creature=other, attacker=other)\n250\t        trigger = attack_triggers[0]\n251\t        if trigger.condition is not None:\n252\t            assert trigger.condition(game, event) is False\n253\t\n254\t\n255\t# ---------------------------------------------------------------------------\n256\t# Attack trigger — targeting (instant/sorcery in graveyard)\n257\t# ---------------------------------------------------------------------------\n258\t\n259\t\n260\tclass TestTheDawningArchaicAttackTriggerTargeting:\n261\t    \"\"\"The attack trigger targets an instant or sorcery card in the graveyard.\"\"\"\n262\t\n263\t    def test_get_targets_returns_at_least_one_requirement(self) -> None:\n264\t        \"\"\"get_targets should return at least one target requirement for the\n265\t        attack trigger (targeting an instant or sorcery in the graveyard).\"\"\"\n266\t        game = create_game()\n267\t        p1 = game.players[0]\n268\t        card = TheDawningArchaic(owner=p1, controller=p1)\n269\t\n270\t        targets = card.get_targets(game)\n271\t        assert isinstance(targets, list)\n272\t        assert len(targets) >= 1, \"Expected at least one target requirement\"\n273\t\n274\t    def test_get_targets_zone_is_graveyard(self) -> None:\n275\t        \"\"\"The target requirement should specify the graveyard zone.\"\"\"\n276\t        game = create_game()\n277\t        p1 = game.players[0]\n278\t        card = TheDawningArchaic(owner=p1, controller=p1)\n279\t\n280\t        targets = card.get_targets(game)\n281\t        assert len(targets) >= 1\n282\t        req = targets[0]\n283\t        assert req.zone == Zone.GRAVEYARD\n284\t\n285\t    def test_get_targets_filter_accepts_instant(self) -> None:\n286\t        \"\"\"The target filter should accept instant cards.\"\"\"\n287\t        game = create_game()\n288\t        p1 = game.players[0]\n289\t        card = TheDawningArchaic(owner=p1, controller=p1)\n290\t\n291\t        targets = card.get_targets(game)\n292\t        assert len(targets) >= 1\n293\t        req = targets[0]\n294\t\n295\t        bolt = Instant(name=\"Lightning Bolt\")\n296\t        assert req.filter_fn(bolt) is True\n297\t\n298\t    def test_get_targets_filter_accepts_sorcery(self) -> None:\n299\t        \"\"\"The target filter should accept sorcery cards.\"\"\"\n300\t        game = create_game()\n301\t        p1 = game.players[0]\n302\t        card = TheDawningArchaic(owner=p1, controller=p1)\n303\t\n304\t        targets = card.get_targets(game)\n305\t        assert len(targets) >= 1\n306\t        req = targets[0]\n307\t\n308\t        div = Sorcery(name=\"Divination\")\n309\t        assert req.filter_fn(div) is True\n310\t\n311\t    def test_get_targets_filter_rejects_creature(self) -> None:\n312\t        \"\"\"The target filter should reject creature cards.\"\"\"\n313\t        game = create_game()\n314\t        p1 = game.players[0]\n315\t        card = TheDawningArchaic(owner=p1, controller=p1)\n316\t\n317\t        targets = card.get_targets(game)\n318\t        assert len(targets) >= 1\n319\t        req = targets[0]\n320\t\n321\t        bear = Creature(name=\"Bear\", base_power=2, base_toughness=2)\n322\t        assert req.filter_fn(bear) is False\n323\t\n324\t\n325\t# ---------------------------------------------------------------------------\n326\t# Attack trigger — effect (free cast from graveyard)\n327\t# ---------------------------------------------------------------------------\n328\t\n329\t\n330\tclass TestTheDawningArchaicFreeCast:\n331\t    \"\"\"When the attack trigger resolves, you may cast the targeted instant or\n332\t    sorcery from your graveyard without paying its mana cost.\"\"\"\n333\t\n334\t    def test_attack_trigger_casts_spell_from_graveyard(self) -> None:\n335\t        \"\"\"When the trigger resolves with a valid target in graveyard,\n336\t        that spell should be cast (moved from graveyard).\"\"\"\n337\t        game = create_game()\n338\t        p1 = game.players[0]\n339\t        card = TheDawningArchaic(owner=p1, controller=p1)\n340\t        game.get_battlefield(p1).add(card)\n341\t        card.register_triggers(game)\n342\t\n343\t        # Put an instant in the graveyard\n344\t        bolt = Instant(name=\"Lightning Bolt\", owner=p1, controller=p1,\n345\t                       mana_cost=ManaCost.parse(\"{R}\"))\n346\t        set_board_state(game, 0, graveyard=[bolt])\n347\t\n348\t        # Verify it is in the graveyard before trigger fires\n349\t        assert game.get_graveyard(p1).contains(bolt)\n350\t\n351\t        # Fire the attack event for this creature\n352\t        event = AttacksTriggeredEvent(creature=card, attacker=card)\n353\t        game.trigger_manager.fire_event(game, event)\n354\t\n355\t        # Resolve the triggered ability from the stack\n356\t        if not game.stack.is_empty():\n357\t            # The trigger effect should interact with the graveyard spell.\n358\t            # After resolving, the bolt should no longer be in the graveyard\n359\t            # (it was cast and should end up exiled per the replacement clause,\n360\t            # or at minimum no longer in the graveyard).\n361\t            stack_obj = game.stack.pop()\n362\t            # Set up target for the trigger effect\n363\t            stack_obj.source.chosen_targets = [bolt] if hasattr(stack_obj, 'source') else None\n364\t            stack_obj.on_resolve(game)\n365\t\n366\t            # The bolt should no longer be in the graveyard\n367\t            # (it was either cast and exiled, or moved to stack/exile)\n368\t            graveyard_contains_bolt = game.get_graveyard(p1).contains(bolt)\n369\t            exile_contains_bolt = game.get_exile(p1).contains(bolt)\n370\t            # The bolt should either be exiled or on the stack (being cast)\n371\t            assert not graveyard_contains_bolt or exile_contains_bolt\n372\t\n373\t    def test_free_cast_does_not_require_mana(self) -> None:\n374\t        \"\"\"The spell should be castable without paying mana even though the\n375\t        player's mana pool may be empty.\"\"\"\n376\t        game = create_game()\n377\t        p1 = game.players[0]\n378\t        card = TheDawningArchaic(owner=p1, controller=p1)\n379\t        game.get_battlefield(p1).add(card)\n380\t        card.register_triggers(game)\n381\t\n382\t        # Expensive spell in graveyard, no mana in pool\n383\t        spell = Sorcery(name=\"Expensive Spell\", owner=p1, controller=p1,\n384\t                        mana_cost=ManaCost.parse(\"{8}\"))\n385\t        set_board_state(game, 0, graveyard=[spell], mana={})\n386\t\n387\t        # Verify mana pool is empty\n388\t        assert p1.mana_pool.can_pay(ManaCost.parse(\"{1}\")) is False\n389\t\n390\t        # Fire the attack event\n391\t        event = AttacksTriggeredEvent(creature=card, attacker=card)\n392\t        game.trigger_manager.fire_event(game, event)\n393\t\n394\t        # Resolve the trigger\n395\t        if not game.stack.is_empty():\n396\t            stack_obj = game.stack.pop()\n397\t            # The trigger resolves and casts the spell for free\n398\t            # This should not raise even with empty mana pool\n399\t            if hasattr(stack_obj, 'source'):\n400\t                stack_obj.source.chosen_targets = [spell]\n401\t            stack_obj.on_resolve(game)\n402\t\n403\t\n404\t# ---------------------------------------------------------------------------\n405\t# Replacement — exile instead of graveyard\n406\t# ---------------------------------------------------------------------------\n407\t\n408\t\n409\tclass TestTheDawningArchaicExileReplacement:\n410\t    \"\"\"If the free-cast spell would be put into your graveyard, exile it instead.\"\"\"\n411\t\n412\t    def test_cast_spell_goes_to_exile_not_graveyard(self) -> None:\n413\t        \"\"\"After the free-cast resolves, the instant/sorcery should end up\n414\t        in exile, not the graveyard.\"\"\"\n415\t        game = create_game()\n416\t        p1 = game.players[0]\n417\t        card = TheDawningArchaic(owner=p1, controller=p1)\n418\t        game.get_battlefield(p1).add(card)\n419\t        card.register_triggers(game)\n420\t\n421\t        bolt = Instant(name=\"Lightning Bolt\", owner=p1, controller=p1,\n422\t                       mana_cost=ManaCost.parse(\"{R}\"))\n423\t        set_board_state(game, 0, graveyard=[bolt])\n424\t\n425\t        # Fire the attack event\n426\t        event = AttacksTriggeredEvent(creature=card, attacker=card)\n427\t        game.trigger_manager.fire_event(game, event)\n428\t\n429\t        # Resolve the triggered ability (which casts the spell)\n430\t        if not game.stack.is_empty():\n431\t            stack_obj = game.stack.pop()\n432\t            if hasattr(stack_obj, 'source'):\n433\t                stack_obj.source.chosen_targets = [bolt]\n434\t            stack_obj.on_resolve(game)\n435\t\n436\t        # Resolve any spell that got cast onto the stack\n437\t        while not game.stack.is_empty():\n438\t            top = game.stack.pop()\n439\t            top.on_resolve(game)\n440\t\n441\t        # The spell should be in exile, NOT in graveyard\n442\t        assert game.get_exile(p1).contains(bolt), \\\n443\t            \"The free-cast spell should be exiled instead of going to graveyard\"\n444\t        assert not game.get_graveyard(p1).contains(bolt), \\\n445\t            \"The free-cast spell should NOT return to the graveyard\"\n446\t\n447\t    def test_normal_spells_still_go_to_graveyard(self) -> None:\n448\t        \"\"\"The exile-instead-of-graveyard effect only applies to the spell\n449\t        cast via this trigger, not to all instants/sorceries everywhere.\"\"\"\n450\t        game = create_game()\n451\t        p1 = game.players[0]\n452\t        card = TheDawningArchaic(owner=p1, controller=p1)\n453\t        game.get_battlefield(p1).add(card)\n454\t        card.register_triggers(game)\n455\t\n456\t        # A separately cast spell (not via the trigger) should still go to GY\n457\t        normal_bolt = Instant(name=\"Normal Bolt\", owner=p1, controller=p1,\n458\t                              mana_cost=ManaCost.parse(\"{R}\"))\n459\t        set_board_state(game, 0, hand=[normal_bolt],\n460\t                        mana={ManaType.RED: 1})\n461\t\n462\t        # Cast the spell normally via the hand\n463\t        from test_utils import cast_spell\n464\t        cast_spell(game, 0, \"Normal Bolt\")\n465\t\n466\t        # Normal spell should go to graveyard, not exile\n467\t        assert game.get_graveyard(p1).contains(normal_bolt), \\\n468\t            \"A normally-cast spell should go to the graveyard\"\n469\t\n470\t\n471\t# ---------------------------------------------------------------------------\n472\t# Edge cases\n473\t# ---------------------------------------------------------------------------\n474\t\n475\t\n476\tclass TestTheDawningArchaicEdgeCases:\n477\t    \"\"\"Edge cases and boundary conditions.\"\"\"\n478\t\n479\t    def test_empty_graveyard_no_valid_target(self) -> None:\n480\t        \"\"\"With no instants or sorceries in graveyard, the trigger should\n481\t        have no valid targets and should not crash.\"\"\"\n482\t        game = create_game()\n483\t        p1 = game.players[0]\n484\t        card = TheDawningArchaic(owner=p1, controller=p1)\n485\t        game.get_battlefield(p1).add(card)\n486\t        card.register_triggers(game)\n487\t\n488\t        # Graveyard is empty\n489\t        set_board_state(game, 0, graveyard=[])\n490\t\n491\t        # Fire the attack event — should not crash\n492\t        event = AttacksTriggeredEvent(creature=card, attacker=card)\n493\t        game.trigger_manager.fire_event(game, event)\n494\t\n495\t        # If trigger was added to stack, resolve it without targets\n496\t        if not game.stack.is_empty():\n497\t            stack_obj = game.stack.pop()\n498\t            # Resolving with no valid target should be safe\n499\t            stack_obj.on_resolve(game)\n500\t\n501\t    def test_graveyard_with_only_creatures_no_valid_target(self) -> None:\n502\t        \"\"\"If the graveyard only has creatures (no instants/sorceries),\n503\t        the trigger should have no valid targets.\"\"\"\n504\t        game = create_game()\n505\t        p1 = game.players[0]\n506\t        card = TheDawningArchaic(owner=p1, controller=p1)\n507\t        game.get_battlefield(p1).add(card)\n508\t        card.register_triggers(game)\n509\t\n510\t        bear = Creature(name=\"Bear\", owner=p1, controller=p1,\n511\t                        base_power=2, base_toughness=2)\n512\t        set_board_state(game, 0, graveyard=[bear])\n513\t\n514\t        # Fire the attack event — should not crash\n515\t        event = AttacksTriggeredEvent(creature=card, attacker=card)\n516\t        game.trigger_manager.fire_event(game, event)\n517\t\n518\t        if not game.stack.is_empty():\n519\t            stack_obj = game.stack.pop()\n520\t            stack_obj.on_resolve(game)\n521\t\n522\t        # Bear should still be in graveyard (untouched)\n523\t        assert game.get_graveyard(p1).contains(bear)\n524\t\n525\t"}]},"parent_tool_use_id":"toolu_01BEmxcq5vooxXnzUgasuEfg","session_id":"1fe34661-6a3c-4b16-8a42-0f618466dfcb","uuid":"167e94c7-5178-453f-afa5-df1e9f46ae1a","timestamp":"2026-05-28T09:18:46.735Z","subagent_type":"Implementer","task_description":"Revise sos_1 per review"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Gfg3CVgLJVW6dZnjmi9AWm","type":"tool_result","content":"1\t\"\"\"Casting and resolution pipeline for spells and lands.\n2\t\n3\tProvides the full flow from casting a spell or playing a land through\n4\tresolution:\n5\t\n6\t- :func:`cast_spell` — verify timing & legality → move hand to stack →\n7\t  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n8\t- :func:`play_land` — verify land play remaining → move hand to\n9\t  battlefield → decrement ``land_plays_remaining``.\n10\t- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n11\t  helpers used by the casting pipeline.\n12\t\n13\tResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\n14\tcreated by :func:`cast_spell`:\n15\t\n16\t- Call ``card.on_resolve(game)``.\n17\t- Permanents (creature / enchantment / artifact / planeswalker) move from\n18\t  the stack to the battlefield.\n19\t- Non-permanents (instant / sorcery) move to the graveyard.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import TYPE_CHECKING, Any\n25\t\n26\tfrom engine.card import CardImpl\n27\tfrom engine.stack import StackObject\n28\tfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\n29\tfrom engine.zones import move_zone\n30\t\n31\tif TYPE_CHECKING:\n32\t    from engine.game_state import GameState\n33\t    from engine.player import Player\n34\t\n35\t\n36\t# Card types that represent permanents — these go to the battlefield on resolve.\n37\t_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n38\t    CardType.CREATURE,\n39\t    CardType.ENCHANTMENT,\n40\t    CardType.ARTIFACT,\n41\t    CardType.PLANESWALKER,\n42\t})\n43\t\n44\t\n45\tclass CastingError(Exception):\n46\t    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n47\t\n48\t\n49\t# ------------------------------------------------------------------\n50\t# Timing helpers\n51\t# ------------------------------------------------------------------\n52\t\n53\tdef is_sorcery_speed(game: GameState, player: Player) -> bool:\n54\t    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n55\t\n56\t    Sorcery speed requires all of:\n57\t\n58\t    * *player* is the active player.\n59\t    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n60\t      ``POSTCOMBAT_MAIN``).\n61\t    * The stack is empty.\n62\t    \"\"\"\n63\t    if player is not game.active_player:\n64\t        return False\n65\t    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n66\t        return False\n67\t    if not game.stack.is_empty():\n68\t        return False\n69\t    return True\n70\t\n71\t\n72\tdef can_cast_at_instant_speed(card: CardImpl) -> bool:\n73\t    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n74\t\n75\t    A card has instant-speed timing if it is an instant or has the\n76\t    :attr:`~engine.types.Keyword.FLASH` keyword.\n77\t    \"\"\"\n78\t    if CardType.INSTANT in card.card_types:\n79\t        return True\n80\t    if Keyword.FLASH & card.keywords:\n81\t        return True\n82\t    return False\n83\t\n84\t\n85\t# ------------------------------------------------------------------\n86\t# Cost reduction\n87\t# ------------------------------------------------------------------\n88\t\n89\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n90\t    \"\"\"Return the generic mana reduction for casting *card*.\n91\t\n92\t    Queries ``card.cost_reduction(game)`` and clamps the result so that\n93\t    the generic portion of the mana cost cannot go below 0.\n94\t\n95\t    This is a simplified single-card self-reduction model.  Full MTG\n96\t    cost-reduction interactions (Trinisphere, multiple reductions from\n97\t    different sources) are deferred.\n98\t    \"\"\"\n99\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n100\t    # casting player even when the card was never explicitly assigned one.\n101\t    prev_controller = card.controller\n102\t    card.controller = controller\n103\t    raw = card.cost_reduction(game)\n104\t    # Restore previous controller in case the caller doesn't want a\n105\t    # side-effect (get_cost_reduction is a query, not a mutation).\n106\t    card.controller = prev_controller\n107\t    generic = card.mana_cost.generic if card.mana_cost else 0\n108\t    return max(0, min(raw, generic))\n109\t\n110\t\n111\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n112\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n113\t    new_generic = max(0, cost.generic - reduction)\n114\t    return ManaCost(\n115\t        generic=new_generic,\n116\t        pips=dict(cost.pips),\n117\t        x_count=cost.x_count,\n118\t        hybrid=list(cost.hybrid),\n119\t    )\n120\t\n121\t\n122\t# ------------------------------------------------------------------\n123\t# Cast spell\n124\t# ------------------------------------------------------------------\n125\t\n126\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n127\t    \"\"\"Cast *card* from *player*'s hand.\n128\t\n129\t    Pipeline\n130\t    --------\n131\t    1. **Timing check** — instants (and cards with flash) can be cast\n132\t       whenever the player has priority; everything else requires\n133\t       sorcery-speed timing.\n134\t    2. **can_cast** — ask the card whether it can legally be cast.\n135\t    3. **Hand check** — the card must be in the player's hand.\n136\t    4. **Move hand → stack zone** — remove the card from the hand and\n137\t       place it into the player's stack zone.\n138\t    5. **Choose targets** — if the card specifies targets (via\n139\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n140\t    6. **Mana check / payment** — the player's mana pool must be able to\n141\t       pay the card's mana cost.  If payment fails, the card is rolled\n142\t       back from the stack zone to the hand.\n143\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n144\t    8. **Push StackObject** — push a :class:`StackObject` whose\n145\t       ``on_resolve`` callback handles resolution.\n146\t\n147\t    Raises:\n148\t        CastingError: If any legality check fails.\n149\t    \"\"\"\n150\t    # 1. Timing\n151\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n152\t        raise CastingError(\n153\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n154\t        )\n155\t\n156\t    # 2. can_cast\n157\t    if not card.can_cast(game):\n158\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n159\t\n160\t    # 3. Hand check\n161\t    hand = game.get_hand(player)\n162\t    if not hand.contains(card):\n163\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n164\t\n165\t    # 4. Move card from hand to stack zone\n166\t    stack_zone = player.zones[Zone.STACK]\n167\t    hand.remove(card)\n168\t    stack_zone.add(card)\n169\t\n170\t    # Clear any stale colors_spent from a prior cast before new payment.\n171\t    if hasattr(card, \"colors_spent\"):\n172\t        del card.colors_spent\n173\t\n174\t    # 5. Choose targets\n175\t    target_specs = card.get_targets(game)\n176\t    chosen_targets: list[Any] = []\n177\t    if target_specs:\n178\t        for spec in target_specs:\n179\t            target = player.choose_target(target_specs, spec)\n180\t            # Validate against filter_fn if the spec provides one\n181\t            filter_fn = getattr(spec, \"filter_fn\", None)\n182\t            if filter_fn is not None and target is not None:\n183\t                if not filter_fn(target):\n184\t                    stack_zone.remove(card)\n185\t                    hand.add(card)\n186\t                    raise CastingError(\n187\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n188\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n189\t                    )\n190\t            chosen_targets.append(target)\n191\t\n192\t    # 5b. Protection check — reject targets that have protection from this\n193\t    #     spell (the T in DEBT).\n194\t    from engine.protection import has_protection_from\n195\t\n196\t    for target in chosen_targets:\n197\t        if has_protection_from(target, card):\n198\t            # Rollback: move card from stack zone back to hand\n199\t            stack_zone.remove(card)\n200\t            hand.add(card)\n201\t            raise CastingError(\n202\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n203\t            )\n204\t\n205\t    # Targets are stored on the StackObject (not the card) and passed\n206\t    # through the resolve pipeline via on_resolve(game, targets=...).\n207\t\n208\t    # 6. Mana check / payment (rollback on failure)\n209\t    # Ensure the card knows its controller so that cost_reduction() hooks\n210\t    # (e.g. Embercleave counting attacking creatures you control) see the\n211\t    # casting player, even for cards that were added to hand without an\n212\t    # explicit controller assignment.\n213\t    if card.controller is None:\n214\t        card.controller = player\n215\t    reduction = get_cost_reduction(game, card, player)\n216\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n217\t\n218\t    if not player.mana_pool.can_pay(effective_cost):\n219\t        # Rollback: move card from stack zone back to hand\n220\t        stack_zone.remove(card)\n221\t        hand.add(card)\n222\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n223\t\n224\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n225\t    player.mana_pool.pay(effective_cost)\n226\t\n227\t    # Store colors of mana spent on the card for mechanics like Converge\n228\t    # that care about the colors used to cast the spell.\n229\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n230\t\n231\t    # 7. Call on_cast hook\n232\t    card.on_cast(game)\n233\t\n234\t    # 8. Build on_resolve callback and push StackObject\n235\t    stack_obj = StackObject(\n236\t        source=card,\n237\t        controller=player,\n238\t        targets=chosen_targets,\n239\t        on_resolve=lambda g: None,  # replaced below\n240\t    )\n241\t\n242\t    def _on_resolve(g: GameState) -> None:\n243\t        _resolve_spell(g, card, player, stack_obj)\n244\t\n245\t    stack_obj.on_resolve = _on_resolve\n246\t    game.stack.push(stack_obj)\n247\t\n248\t\n249\t# ------------------------------------------------------------------\n250\t# Cast spell without paying mana cost (free-cast from any zone)\n251\t# ------------------------------------------------------------------\n252\t\n253\t\n254\tdef cast_spell_free(\n255\t    game: GameState,\n256\t    player: Player,\n257\t    card: CardImpl,\n258\t    from_zone: Zone,\n259\t) -> None:\n260\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n261\t\n262\t    This is used by effects that allow casting from zones other than hand\n263\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n264\t    or cascade.\n265\t\n266\t    Pipeline\n267\t    --------\n268\t    1. **can_cast** — ask the card whether it can legally be cast (same\n269\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n270\t    2. Move *card* from *from_zone* to the stack zone.\n271\t    3. Choose targets (if applicable) with validation and protection check.\n272\t    4. Call ``on_cast`` hook.\n273\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n274\t       resolution normally (permanents → battlefield, non-permanents →\n275\t       graveyard).\n276\t\n277\t    No timing check or mana payment is performed.  The spell goes on the\n278\t    stack and can be responded to normally (e.g. countered).\n279\t\n280\t    If targeting or other post-move checks fail, the card is rolled back\n281\t    to its source zone.\n282\t\n283\t    Parameters:\n284\t        game: The current game state.\n285\t        player: The player casting the spell.\n286\t        card: The card to cast.\n287\t        from_zone: The zone the card is currently in.\n288\t\n289\t    Raises:\n290\t        CastingError: If the card cannot be found in *from_zone* or\n291\t            legality checks fail.\n292\t    \"\"\"\n293\t    from engine.zones import move_to_zone\n294\t\n295\t    # Ensure controller is set\n296\t    card.controller = player\n297\t    if card.owner is None:\n298\t        card.owner = player\n299\t\n300\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n301\t    if not card.can_cast(game):\n302\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n303\t\n304\t    # 2. Locate card in source zone\n305\t    source_zone_container = player.zones[from_zone]\n306\t    if not source_zone_container.contains(card):\n307\t        # Try to find the card in any player's zone\n308\t        source_zone_container = None\n309\t        for p in game.players:\n310\t            z = p.zones[from_zone]\n311\t            if z.contains(card):\n312\t                source_zone_container = z\n313\t                break\n314\t\n315\t    if source_zone_container is None or not source_zone_container.contains(card):\n316\t        raise CastingError(\n317\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n318\t        )\n319\t\n320\t    # Move card from source zone to stack zone\n321\t    stack_zone = player.zones[Zone.STACK]\n322\t    source_zone_container.remove(card)\n323\t    stack_zone.add(card)\n324\t\n325\t    # 3. Choose targets (with rollback on failure)\n326\t    try:\n327\t        target_specs = card.get_targets(game)\n328\t        chosen_targets: list[Any] = []\n329\t        if target_specs:\n330\t            for spec in target_specs:\n331\t                target = player.choose_target(target_specs, spec)\n332\t                # Validate against filter_fn if the spec provides one\n333\t                filter_fn = getattr(spec, \"filter_fn\", None)\n334\t                if filter_fn is not None and target is not None:\n335\t                    if not filter_fn(target):\n336\t                        raise CastingError(\n337\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n338\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n339\t                        )\n340\t                chosen_targets.append(target)\n341\t\n342\t        # Protection check — reject targets that have protection from this spell\n343\t        from engine.protection import has_protection_from\n344\t\n345\t        for target in chosen_targets:\n346\t            if has_protection_from(target, card):\n347\t                raise CastingError(\n348\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n349\t                )\n350\t    except Exception as exc:\n351\t        # Rollback: move card from stack zone back to source zone\n352\t        stack_zone.remove(card)\n353\t        source_zone_container.add(card)\n354\t        raise CastingError(str(exc)) from exc\n355\t\n356\t    # 4. Call on_cast hook\n357\t    card.on_cast(game)\n358\t\n359\t    # 5. Build on_resolve callback and push StackObject\n360\t    stack_obj = StackObject(\n361\t        source=card,\n362\t        controller=player,\n363\t        targets=chosen_targets,\n364\t        on_resolve=lambda g: None,  # replaced below\n365\t    )\n366\t\n367\t    def _on_resolve(g: GameState) -> None:\n368\t        _resolve_spell(g, card, player, stack_obj)\n369\t\n370\t    stack_obj.on_resolve = _on_resolve\n371\t    game.stack.push(stack_obj)\n372\t\n373\t\n374\t# ------------------------------------------------------------------\n375\t# Resolution (called when the stack pops)\n376\t# ------------------------------------------------------------------\n377\t\n378\tdef _resolve_spell(\n379\t    game: GameState,\n380\t    card: CardImpl,\n381\t    player: Player,\n382\t    stack_obj: StackObject,\n383\t) -> None:\n384\t    \"\"\"Resolve *card* cast by *player*.\n385\t\n386\t    1. Call ``card.on_resolve(game, targets=targets)``.\n387\t    2. Remove the card from the stack zone.\n388\t    3. If the card is a permanent type, move it to the battlefield via\n389\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n390\t       registration and the ETB event).\n391\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n392\t    \"\"\"\n393\t    from engine.zones import move_to_zone\n394\t\n395\t    # Read targets from the StackObject — the single source of truth.\n396\t    # Set chosen_targets on the card just before resolution so that\n397\t    # _get_chosen_target helpers (which read via getattr) work.\n398\t    targets = stack_obj.targets\n399\t    if targets is not None:\n400\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n401\t\n402\t    card.on_resolve(game)\n403\t\n404\t    if card.card_types & _PERMANENT_TYPES:\n405\t        # Move from stack to battlefield via move_to_zone, which handles\n406\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n407\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n408\t    else:\n409\t        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n410\t        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n411\t\n412\t\n413\t# ------------------------------------------------------------------\n414\t# Play land (special action — does not use the stack)\n415\t# ------------------------------------------------------------------\n416\t\n417\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n418\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n419\t\n420\t    Requirements (all must hold):\n421\t\n422\t    * *land_card* has :attr:`CardType.LAND`.\n423\t    * *player* is the active player.\n424\t    * Current phase is a main phase.\n425\t    * The stack is empty.\n426\t    * ``player.land_plays_remaining > 0``.\n427\t    * The card is in the player's hand.\n428\t\n429\t    On success the card moves from hand to battlefield and\n430\t    ``land_plays_remaining`` is decremented.\n431\t\n432\t    Raises:\n433\t        CastingError: If any requirement is not met.\n434\t    \"\"\"\n435\t    # Must be a land\n436\t    if CardType.LAND not in land_card.card_types:\n437\t        raise CastingError(\n438\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n439\t        )\n440\t\n441\t    # Sorcery-speed timing (active player, main phase, stack empty)\n442\t    if not is_sorcery_speed(game, player):\n443\t        raise CastingError(\n444\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n445\t            \"during main phase with empty stack\"\n446\t        )\n447\t\n448\t    # Land plays remaining\n449\t    if player.land_plays_remaining <= 0:\n450\t        raise CastingError(\n451\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n452\t        )\n453\t\n454\t    # Card must be in hand\n455\t    hand = game.get_hand(player)\n456\t    if not hand.contains(land_card):\n457\t        raise CastingError(\n458\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n459\t        )\n460\t\n461\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n462\t    if land_card.owner is None:\n463\t        land_card.owner = player\n464\t    land_card.controller = player\n465\t\n466\t    # Move from hand to battlefield via move_to_zone, which fires\n467\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n468\t    from engine.zones import move_to_zone\n469\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n470\t\n471\t    # Decrement land plays\n472\t    player.land_plays_remaining -= 1\n473\t\n474\t\n475\tdef resolve_top(game: GameState) -> None:\n476\t    \"\"\"Resolve the top spell/ability on the stack.\n477\t\n478\t    Pops the top item from the stack, calls its on_resolve callback,\n479\t    then runs state-based actions.  If the stack is empty this is a no-op.\n480\t    \"\"\"\n481\t    if game.stack.is_empty():\n482\t        return\n483\t    from engine.state_based_actions import resolve_state_based_actions\n484\t\n485\t    obj = game.stack.pop()\n486\t    obj.on_resolve(game)\n487\t    resolve_state_based_actions(game)\n488\t"}]},"parent_tool_use_id":"toolu_01BEmxcq5vooxXnzUgasuEfg","session_id":"1fe34661-6a3c-4b16-8a42-0f618466dfcb","uuid":"5db66346-f536-40cb-b87d-2161de32bff7","timestamp":"2026-05-28T09:18:46.736Z","subagent_type":"Implementer","task_description":"Revise sos_1 per review"}
