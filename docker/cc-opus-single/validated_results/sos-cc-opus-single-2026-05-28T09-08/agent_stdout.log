{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FvH5sRSEdDXAT2dbbMPUS7","type":"tool_result","content":"1\t\"\"\"Card implementation for Improvisation Capstone.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport copy\n6\tfrom typing import TYPE_CHECKING, Any\n7\t\n8\tfrom engine.card import CardImpl, Creature, Instant, Land, Sorcery\n9\tfrom engine.events import BeginningOfMainPhaseTriggeredEvent\n10\tfrom engine.stack import StackObject\n11\tfrom engine.triggers import TriggerRegistration\n12\tfrom engine.types import CardType, ManaCost, Zone\n13\t\n14\tif TYPE_CHECKING:\n15\t    from engine.game_state import GameState\n16\t\n17\t\n18\tclass ImprovisationCapstone(Sorcery):\n19\t    \"\"\"Improvisation Capstone -- {5}{R}{R} -- Sorcery -- Lesson.\n20\t\n21\t    Exile cards from the top of your library until you exile cards with\n22\t    total mana value 4 or greater. You may cast any number of spells\n23\t    from among them without paying their mana costs.\n24\t\n25\t    Paradigm (Then exile this spell. After you first resolve a spell\n26\t    with this name, you may cast a copy of it from exile without paying\n27\t    its mana cost at the beginning of each of your first main phases.)\n28\t\n29\t    SOS collector number 120.\n30\t    \"\"\"\n31\t\n32\t    def __init__(self, **kwargs: Any) -> None:\n33\t        kwargs.setdefault(\"name\", \"Improvisation Capstone\")\n34\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{5}{R}{R}\"))\n35\t        kwargs.setdefault(\"subtypes\", {\"Lesson\"})\n36\t        kwargs.setdefault(\n37\t            \"rules_text\",\n38\t            \"Exile cards from the top of your library until you exile cards \"\n39\t            \"with total mana value 4 or greater. You may cast any number of \"\n40\t            \"spells from among them without paying their mana costs.\\n\"\n41\t            \"Paradigm (Then exile this spell. After you first resolve a spell \"\n42\t            \"with this name, you may cast a copy of it from exile without \"\n43\t            \"paying its mana cost at the beginning of each of your first \"\n44\t            \"main phases.)\",\n45\t        )\n46\t        super().__init__(**kwargs)\n47\t\n48\t    # ------------------------------------------------------------------\n49\t    # Resolution\n50\t    # ------------------------------------------------------------------\n51\t\n52\t    def on_resolve(self, game: \"GameState\") -> None:\n53\t        \"\"\"Resolve Improvisation Capstone:\n54\t\n55\t        1. Exile cards from the top of library until total MV >= 4.\n56\t        2. Cast any number of non-land spells from among them for free.\n57\t        3. Paradigm: exile self, register delayed trigger for recurrence.\n58\t        \"\"\"\n59\t        controller = self.controller if self.controller is not None else self.owner\n60\t        if controller is None:\n61\t            # Still need to handle paradigm self-exile even with no controller\n62\t            return\n63\t\n64\t        # --- Step 1: Exile from library until total MV >= 4 ---\n65\t        exiled_cards = self._exile_from_library(game, controller)\n66\t\n67\t        # --- Step 2: Free-cast spells from among exiled cards ---\n68\t        self._free_cast_exiled(game, controller, exiled_cards)\n69\t\n70\t        # --- Step 3: Paradigm -- self-exile ---\n71\t        self._paradigm_self_exile(game, controller)\n72\t\n73\t        # --- Step 4: Paradigm -- register delayed trigger for recurrence ---\n74\t        self._paradigm_register_recurrence(game, controller)\n75\t\n76\t    # ------------------------------------------------------------------\n77\t    # Internal helpers\n78\t    # ------------------------------------------------------------------\n79\t\n80\t    def _exile_from_library(\n81\t        self, game: \"GameState\", controller: Any\n82\t    ) -> list[Any]:\n83\t        \"\"\"Exile cards from top of library until total MV >= 4.\n84\t\n85\t        Returns the list of cards exiled from the library.\n86\t        \"\"\"\n87\t        library = controller.zones[Zone.LIBRARY]\n88\t        exile = game.get_exile(controller)\n89\t        exiled: list[Any] = []\n90\t        total_mv = 0\n91\t\n92\t        while len(library) > 0 and total_mv < 4:\n93\t            # Top of library is the last element\n94\t            top_cards = library.top(1)\n95\t            if not top_cards:\n96\t                break\n97\t            card = top_cards[0]\n98\t            library.remove(card)\n99\t            exile.add(card)\n100\t            exiled.append(card)\n101\t\n102\t            card_cost = getattr(card, \"mana_cost\", None)\n103\t            if card_cost is not None:\n104\t                total_mv += card_cost.cmc\n105\t            # Cards with no mana_cost contribute 0\n106\t\n107\t        return exiled\n108\t\n109\t    def _free_cast_exiled(\n110\t        self, game: \"GameState\", controller: Any, exiled_cards: list[Any]\n111\t    ) -> None:\n112\t        \"\"\"Cast any number of spells from among the exiled cards for free.\n113\t\n114\t        Lands are not spells and cannot be cast this way.  Cards remain in\n115\t        exile until their StackObject resolves -- this matches the MTG rule\n116\t        that a spell moves from its zone to the stack when cast and then to\n117\t        its destination on resolution.\n118\t        \"\"\"\n119\t        exile = game.get_exile(controller)\n120\t\n121\t        for card in exiled_cards:\n122\t            # Lands cannot be cast as spells\n123\t            if isinstance(card, Land):\n124\t                continue\n125\t            card_types = getattr(card, \"card_types\", set())\n126\t            if CardType.LAND in card_types:\n127\t                continue\n128\t\n129\t            # Set up ownership/control for the free cast\n130\t            card.controller = controller\n131\t            if card.owner is None:\n132\t                card.owner = controller\n133\t\n134\t            # For creatures, push a StackObject that resolves to battlefield\n135\t            if CardType.CREATURE in card_types:\n136\t                def _make_creature_resolve(c: Any) -> Any:\n137\t                    def _resolve(g: \"GameState\") -> None:\n138\t                        # Remove from exile when the spell resolves\n139\t                        ex = g.get_exile(controller)\n140\t                        if ex.contains(c):\n141\t                            ex.remove(c)\n142\t                        c.on_resolve(g)\n143\t                        bf = g.get_battlefield(controller)\n144\t                        bf.add(c)\n145\t                        c.summoning_sick = True\n146\t                        if hasattr(c, \"register_triggers\"):\n147\t                            c.register_triggers(g)\n148\t                        if hasattr(c, \"register_replacement_effects\"):\n149\t                            c.register_replacement_effects(g)\n150\t                    return _resolve\n151\t\n152\t                stack_obj = StackObject(\n153\t                    source=card,\n154\t                    controller=controller,\n155\t                    targets=[],\n156\t                    on_resolve=_make_creature_resolve(card),\n157\t                )\n158\t                game.stack.push(stack_obj)\n159\t            elif CardType.INSTANT in card_types or CardType.SORCERY in card_types or isinstance(card, (Instant, Sorcery)):\n160\t                # For instants/sorceries, push to stack; on resolve go to graveyard\n161\t                def _make_spell_resolve(c: Any) -> Any:\n162\t                    def _resolve(g: \"GameState\") -> None:\n163\t                        # Remove from exile when the spell resolves\n164\t                        ex = g.get_exile(controller)\n165\t                        if ex.contains(c):\n166\t                            ex.remove(c)\n167\t                        c.on_resolve(g)\n168\t                        gy = g.get_graveyard(controller)\n169\t                        gy.add(c)\n170\t                    return _resolve\n171\t\n172\t                stack_obj = StackObject(\n173\t                    source=card,\n174\t                    controller=controller,\n175\t                    targets=[],\n176\t                    on_resolve=_make_spell_resolve(card),\n177\t                )\n178\t                game.stack.push(stack_obj)\n179\t            else:\n180\t                # For other permanents (enchantments, artifacts, planeswalkers),\n181\t                # push to stack; on resolve go to battlefield like creatures\n182\t                def _make_permanent_resolve(c: Any) -> Any:\n183\t                    def _resolve(g: \"GameState\") -> None:\n184\t                        # Remove from exile when the spell resolves\n185\t                        ex = g.get_exile(controller)\n186\t                        if ex.contains(c):\n187\t                            ex.remove(c)\n188\t                        c.on_resolve(g)\n189\t                        bf = g.get_battlefield(controller)\n190\t                        bf.add(c)\n191\t                        if hasattr(c, \"register_triggers\"):\n192\t                            c.register_triggers(g)\n193\t                        if hasattr(c, \"register_replacement_effects\"):\n194\t                            c.register_replacement_effects(g)\n195\t                    return _resolve\n196\t\n197\t                stack_obj = StackObject(\n198\t                    source=card,\n199\t                    controller=controller,\n200\t                    targets=[],\n201\t                    on_resolve=_make_permanent_resolve(card),\n202\t                )\n203\t                game.stack.push(stack_obj)\n204\t\n205\t    def _paradigm_self_exile(self, game: \"GameState\", controller: Any) -> None:\n206\t        \"\"\"Paradigm: exile this spell after resolution (instead of graveyard).\n207\t\n208\t        Looks for self on the stack zone and moves to exile.\n209\t        \"\"\"\n210\t        exile = game.get_exile(controller)\n211\t\n212\t        # Try to find and remove self from the stack zone\n213\t        stack_zone = controller.zones[Zone.STACK]\n214\t        if stack_zone.contains(self):\n215\t            stack_zone.remove(self)\n216\t\n217\t        # Add to exile if not already there\n218\t        if not exile.contains(self):\n219\t            exile.add(self)\n220\t\n221\t    def _paradigm_register_recurrence(\n222\t        self, game: \"GameState\", controller: Any\n223\t    ) -> None:\n224\t        \"\"\"Paradigm: register a delayed trigger that fires at the beginning\n225\t        of each of the controller's first main phases, creating a copy of\n226\t        this spell that can be cast for free.\n227\t        \"\"\"\n228\t        source = self\n229\t        capstone_controller = controller\n230\t\n231\t        def _condition(game: \"GameState\", event: BeginningOfMainPhaseTriggeredEvent) -> bool:\n232\t            \"\"\"Only fire for the controller's main phase.\"\"\"\n233\t            return getattr(event, \"player\", None) is capstone_controller\n234\t\n235\t        def _effect(game: \"GameState\") -> None:\n236\t            \"\"\"Create a copy of Improvisation Capstone and put it on the stack\n237\t            (or in exile for casting). The copy has the same on_resolve logic.\"\"\"\n238\t            # Create a copy of the capstone\n239\t            capstone_copy = ImprovisationCapstone(\n240\t                owner=capstone_controller,\n241\t                controller=capstone_controller,\n242\t            )\n243\t\n244\t            # Put the copy on the stack as a free-cast spell.\n245\t            # IMPORTANT: Only run the exile-from-library and free-cast steps,\n246\t            # NOT the paradigm self-exile and trigger registration.  Otherwise\n247\t            # each copy would register another trigger, causing exponential growth.\n248\t            def _copy_resolve(g: \"GameState\") -> None:\n249\t                exiled = capstone_copy._exile_from_library(g, capstone_controller)\n250\t                capstone_copy._free_cast_exiled(g, capstone_controller, exiled)\n251\t\n252\t            stack_obj = StackObject(\n253\t                source=capstone_copy,\n254\t                controller=capstone_controller,\n255\t                targets=[],\n256\t                on_resolve=_copy_resolve,\n257\t            )\n258\t            game.stack.push(stack_obj)\n259\t\n260\t        trigger = TriggerRegistration(\n261\t            event_type=BeginningOfMainPhaseTriggeredEvent,\n262\t            condition=_condition,\n263\t            effect=_effect,\n264\t            source=source,\n265\t            controller=capstone_controller,\n266\t        )\n267\t        game.trigger_manager.register(trigger)\n268\t"}]},"parent_tool_use_id":"toolu_013kGVzSYUhNgLJ9L6CnZfuC","session_id":"1fe34661-6a3c-4b16-8a42-0f618466dfcb","uuid":"d52f89d0-848d-4cec-9c86-016783fdc830","timestamp":"2026-05-28T10:06:39.675Z","subagent_type":"Implementer","task_description":"Revise sos_120 per review"}
