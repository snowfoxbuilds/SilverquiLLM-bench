{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Utp2nCnfgaewArS3zFcroC","type":"tool_result","content":"1\t\"\"\"Card implementation for The Dawning Archaic.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom typing import TYPE_CHECKING, Any\n6\t\n7\tfrom engine.card import Creature\n8\tfrom engine.events import AttacksTriggeredEvent\n9\tfrom engine.triggers import TriggerRegistration\n10\tfrom engine.types import (\n11\t    CardType,\n12\t    Keyword,\n13\t    ManaCost,\n14\t    Supertype,\n15\t    TargetRequirement,\n16\t    Zone,\n17\t)\n18\t\n19\tif TYPE_CHECKING:\n20\t    from engine.game_state import GameState\n21\t\n22\t\n23\tdef _is_instant_or_sorcery(card: Any) -> bool:\n24\t    \"\"\"Return True if *card* is an instant or sorcery.\"\"\"\n25\t    card_types = getattr(card, \"card_types\", set())\n26\t    return CardType.INSTANT in card_types or CardType.SORCERY in card_types\n27\t\n28\t\n29\tclass TheDawningArchaic(Creature):\n30\t    \"\"\"The Dawning Archaic -- {10} -- Legendary Creature -- Avatar -- 7/7.\n31\t\n32\t    This spell costs {1} less to cast for each instant and sorcery card\n33\t    in your graveyard.\n34\t\n35\t    Reach\n36\t\n37\t    Whenever The Dawning Archaic attacks, you may cast target instant or\n38\t    sorcery card from your graveyard without paying its mana cost. If\n39\t    that spell would be put into your graveyard, exile it instead.\n40\t\n41\t    SOS collector number 1.\n42\t    \"\"\"\n43\t\n44\t    def __init__(self, **kwargs: Any) -> None:\n45\t        kwargs.setdefault(\"name\", \"The Dawning Archaic\")\n46\t        kwargs.setdefault(\"mana_cost\", ManaCost.parse(\"{10}\"))\n47\t        kwargs.setdefault(\"subtypes\", {\"Avatar\"})\n48\t        kwargs.setdefault(\"supertypes\", {Supertype.LEGENDARY})\n49\t        kwargs.setdefault(\"keywords\", Keyword.REACH)\n50\t        kwargs.setdefault(\"base_power\", 7)\n51\t        kwargs.setdefault(\"base_toughness\", 7)\n52\t        kwargs.setdefault(\n53\t            \"rules_text\",\n54\t            \"This spell costs {1} less to cast for each instant and sorcery \"\n55\t            \"card in your graveyard.\\nReach\\nWhenever The Dawning Archaic \"\n56\t            \"attacks, you may cast target instant or sorcery card from your \"\n57\t            \"graveyard without paying its mana cost. If that spell would be \"\n58\t            \"put into your graveyard, exile it instead.\",\n59\t        )\n60\t        super().__init__(**kwargs)\n61\t\n62\t    # ------------------------------------------------------------------\n63\t    # Cost reduction\n64\t    # ------------------------------------------------------------------\n65\t\n66\t    def cost_reduction(self, game: GameState) -> int:\n67\t        \"\"\"Return the number of instants and sorceries in controller's graveyard.\"\"\"\n68\t        controller = self.controller\n69\t        if controller is None:\n70\t            controller = self.owner\n71\t        if controller is None:\n72\t            return 0\n73\t\n74\t        graveyard = game.get_graveyard(controller)\n75\t        count = 0\n76\t        for card in graveyard.get_all():\n77\t            if _is_instant_or_sorcery(card):\n78\t                count += 1\n79\t        return count\n80\t\n81\t    # ------------------------------------------------------------------\n82\t    # Targeting (for the attack trigger)\n83\t    # ------------------------------------------------------------------\n84\t\n85\t    def get_targets(self, game: GameState) -> list[Any]:\n86\t        \"\"\"Return target requirements for the attack trigger.\n87\t\n88\t        When The Dawning Archaic is being cast (i.e. it is on the stack),\n89\t        it should NOT require any targets — it is a creature spell.  The\n90\t        targeting below is only for the attack-trigger ability.  We detect\n91\t        the casting context by checking whether *self* is currently in\n92\t        the controller's stack zone (the casting pipeline moves the card\n93\t        there before calling ``get_targets``).\n94\t        \"\"\"\n95\t        # Guard: if the card is on the stack (being cast), return no targets.\n96\t        controller = self.controller if self.controller is not None else self.owner\n97\t        if controller is not None and hasattr(controller, \"zones\"):\n98\t            try:\n99\t                stack_zone = controller.zones[Zone.STACK]\n100\t                if stack_zone.contains(self):\n101\t                    return []\n102\t            except (KeyError, AttributeError):\n103\t                pass\n104\t\n105\t        return [\n106\t            TargetRequirement(\n107\t                filter_fn=_is_instant_or_sorcery,\n108\t                description=\"target instant or sorcery card in your graveyard\",\n109\t                zone=Zone.GRAVEYARD,\n110\t            )\n111\t        ]\n112\t\n113\t    # ------------------------------------------------------------------\n114\t    # Attack trigger\n115\t    # ------------------------------------------------------------------\n116\t\n117\t    def register_triggers(self, game: GameState) -> None:\n118\t        \"\"\"Register the attack trigger for this creature.\"\"\"\n119\t        source = self\n120\t\n121\t        def _condition(game: GameState, event: AttacksTriggeredEvent) -> bool:\n122\t            \"\"\"Only trigger when this creature attacks.\"\"\"\n123\t            return event.creature is source or event.attacker is source\n124\t\n125\t        def _effect(game: GameState) -> None:\n126\t            \"\"\"Cast target instant or sorcery from graveyard for free.\n127\t\n128\t            The target is read from source.chosen_targets (set by the\n129\t            test or by the engine's targeting pipeline).\n130\t            \"\"\"\n131\t            chosen = getattr(source, \"chosen_targets\", None)\n132\t            if not chosen:\n133\t                return\n134\t\n135\t            target_card = chosen[0] if isinstance(chosen, list) else chosen\n136\t            if target_card is None:\n137\t                return\n138\t\n139\t            # Verify the target is still an instant or sorcery\n140\t            if not _is_instant_or_sorcery(target_card):\n141\t                return\n142\t\n143\t            controller = source.controller\n144\t            if controller is None:\n145\t                controller = source.owner\n146\t            if controller is None:\n147\t                return\n148\t\n149\t            # Verify the target is still in the graveyard\n150\t            graveyard = game.get_graveyard(controller)\n151\t            if not graveyard.contains(target_card):\n152\t                return\n153\t\n154\t            # Mark this card so the exile-instead-of-graveyard replacement\n155\t            # applies only to it.\n156\t            target_card._dawning_archaic_free_cast = True  # type: ignore[attr-defined]\n157\t\n158\t            # Cast the spell for free from graveyard.\n159\t            # We remove it from the graveyard and put it on the stack,\n160\t            # then push a StackObject to resolve it.\n161\t            from engine.stack import StackObject\n162\t\n163\t            graveyard.remove(target_card)\n164\t\n165\t            # Set controller/owner for the cast spell\n166\t            target_card.controller = controller\n167\t            if target_card.owner is None:\n168\t                target_card.owner = controller\n169\t\n170\t            # Put on the stack zone\n171\t            stack_zone = controller.zones[Zone.STACK]\n172\t            stack_zone.add(target_card)\n173\t\n174\t            # Build a StackObject for the free-cast spell\n175\t            def _spell_resolve(g: GameState) -> None:\n176\t                \"\"\"Resolve the free-cast spell, then exile it instead of graveyard.\"\"\"\n177\t                # Call the spell's own on_resolve\n178\t                target_card.on_resolve(g)\n179\t\n180\t                # Move from stack to exile (instead of graveyard)\n181\t                if stack_zone.contains(target_card):\n182\t                    stack_zone.remove(target_card)\n183\t\n184\t                owner = target_card.owner if target_card.owner is not None else controller\n185\t                exile_zone = g.get_exile(owner)\n186\t                exile_zone.add(target_card)\n187\t\n188\t                # Clean up the marker\n189\t                if hasattr(target_card, \"_dawning_archaic_free_cast\"):\n190\t                    del target_card._dawning_archaic_free_cast\n191\t\n192\t            spell_stack_obj = StackObject(\n193\t                source=target_card,\n194\t                controller=controller,\n195\t                targets=[],\n196\t                on_resolve=_spell_resolve,\n197\t            )\n198\t            game.stack.push(spell_stack_obj)\n199\t\n200\t        controller = self.controller if self.controller is not None else self.owner\n201\t        if controller is None:\n202\t            return\n203\t\n204\t        trigger = TriggerRegistration(\n205\t            event_type=AttacksTriggeredEvent,\n206\t            condition=_condition,\n207\t            effect=_effect,\n208\t            source=self,\n209\t            controller=controller,\n210\t        )\n211\t        game.trigger_manager.register(trigger)\n212\t"}]},"parent_tool_use_id":"toolu_01GmsndJiRpYV9ifKJBLLPN6","session_id":"1fe34661-6a3c-4b16-8a42-0f618466dfcb","uuid":"dfad6afb-8e8c-4c19-a2c3-c7bdd1fce60a","timestamp":"2026-05-28T09:35:18.472Z","subagent_type":"Implementer","task_description":"Implement sos_13"}
