{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LbQ8uyses4CRdKghQSEsp2","type":"tool_result","content":"1\t\"\"\"Casting and resolution pipeline for spells and lands.\n2\t\n3\tProvides the full flow from casting a spell or playing a land through\n4\tresolution:\n5\t\n6\t- :func:`cast_spell` — verify timing & legality → move hand to stack →\n7\t  choose targets → pay costs → call ``on_cast`` → push :class:`StackObject`.\n8\t- :func:`play_land` — verify land play remaining → move hand to\n9\t  battlefield → decrement ``land_plays_remaining``.\n10\t- :func:`is_sorcery_speed` / :func:`can_cast_at_instant_speed` — timing\n11\t  helpers used by the casting pipeline.\n12\t\n13\tResolution is embedded in the :class:`StackObject` ``on_resolve`` callback\n14\tcreated by :func:`cast_spell`:\n15\t\n16\t- Call ``card.on_resolve(game)``.\n17\t- Permanents (creature / enchantment / artifact / planeswalker) move from\n18\t  the stack to the battlefield.\n19\t- Non-permanents (instant / sorcery) move to the graveyard.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\tfrom typing import TYPE_CHECKING, Any\n25\t\n26\tfrom engine.card import CardImpl\n27\tfrom engine.stack import StackObject\n28\tfrom engine.types import CardType, Keyword, ManaCost, Phase, Zone\n29\tfrom engine.zones import move_zone\n30\t\n31\tif TYPE_CHECKING:\n32\t    from engine.game_state import GameState\n33\t    from engine.player import Player\n34\t\n35\t\n36\t# Card types that represent permanents — these go to the battlefield on resolve.\n37\t_PERMANENT_TYPES: frozenset[CardType] = frozenset({\n38\t    CardType.CREATURE,\n39\t    CardType.ENCHANTMENT,\n40\t    CardType.ARTIFACT,\n41\t    CardType.PLANESWALKER,\n42\t})\n43\t\n44\t\n45\tclass CastingError(Exception):\n46\t    \"\"\"Raised when a spell cast or land play is illegal.\"\"\"\n47\t\n48\t\n49\t# ------------------------------------------------------------------\n50\t# Timing helpers\n51\t# ------------------------------------------------------------------\n52\t\n53\tdef is_sorcery_speed(game: GameState, player: Player) -> bool:\n54\t    \"\"\"Return ``True`` if sorcery-speed timing is met for *player*.\n55\t\n56\t    Sorcery speed requires all of:\n57\t\n58\t    * *player* is the active player.\n59\t    * The current phase is a main phase (``PRECOMBAT_MAIN`` or\n60\t      ``POSTCOMBAT_MAIN``).\n61\t    * The stack is empty.\n62\t    \"\"\"\n63\t    if player is not game.active_player:\n64\t        return False\n65\t    if game.phase not in (Phase.PRECOMBAT_MAIN, Phase.POSTCOMBAT_MAIN):\n66\t        return False\n67\t    if not game.stack.is_empty():\n68\t        return False\n69\t    return True\n70\t\n71\t\n72\tdef can_cast_at_instant_speed(card: CardImpl) -> bool:\n73\t    \"\"\"Return ``True`` if *card* may be cast at instant speed.\n74\t\n75\t    A card has instant-speed timing if it is an instant or has the\n76\t    :attr:`~engine.types.Keyword.FLASH` keyword.\n77\t    \"\"\"\n78\t    if CardType.INSTANT in card.card_types:\n79\t        return True\n80\t    if Keyword.FLASH & card.keywords:\n81\t        return True\n82\t    return False\n83\t\n84\t\n85\t# ------------------------------------------------------------------\n86\t# Cost reduction\n87\t# ------------------------------------------------------------------\n88\t\n89\tdef get_cost_reduction(game: GameState, card: CardImpl, controller: Player) -> int:\n90\t    \"\"\"Return the generic mana reduction for casting *card*.\n91\t\n92\t    Queries ``card.cost_reduction(game)`` and clamps the result so that\n93\t    the generic portion of the mana cost cannot go below 0.\n94\t\n95\t    Also consults any external cost-reduction providers registered on the\n96\t    game state (e.g. permanents that grant affinity or flat cost reduction\n97\t    to other spells).  External reductions are summed with the card's own\n98\t    ``cost_reduction`` and the total is clamped to the generic cost.\n99\t    \"\"\"\n100\t    # Ensure card.controller is set so the hook can reference \"you\" / the\n101\t    # casting player even when the card was never explicitly assigned one.\n102\t    prev_controller = card.controller\n103\t    card.controller = controller\n104\t    raw = card.cost_reduction(game)\n105\t\n106\t    # Sum external cost-reduction providers (e.g. permanents granting\n107\t    # affinity for creatures to instants/sorceries).\n108\t    for entry in getattr(game, \"_cost_reduction_providers\", []):\n109\t        provider = entry[\"provider\"]\n110\t        raw += provider(game, card, controller)\n111\t\n112\t    # Restore previous controller in case the caller doesn't want a\n113\t    # side-effect (get_cost_reduction is a query, not a mutation).\n114\t    card.controller = prev_controller\n115\t    generic = card.mana_cost.generic if card.mana_cost else 0\n116\t    return max(0, min(raw, generic))\n117\t\n118\t\n119\tdef _apply_cost_reduction(cost: ManaCost, reduction: int) -> ManaCost:\n120\t    \"\"\"Return a new :class:`ManaCost` with *reduction* subtracted from generic.\"\"\"\n121\t    new_generic = max(0, cost.generic - reduction)\n122\t    return ManaCost(\n123\t        generic=new_generic,\n124\t        pips=dict(cost.pips),\n125\t        x_count=cost.x_count,\n126\t        hybrid=list(cost.hybrid),\n127\t    )\n128\t\n129\t\n130\t# ------------------------------------------------------------------\n131\t# Cast spell\n132\t# ------------------------------------------------------------------\n133\t\n134\tdef cast_spell(game: GameState, player: Player, card: CardImpl) -> None:\n135\t    \"\"\"Cast *card* from *player*'s hand.\n136\t\n137\t    Pipeline\n138\t    --------\n139\t    1. **Timing check** — instants (and cards with flash) can be cast\n140\t       whenever the player has priority; everything else requires\n141\t       sorcery-speed timing.\n142\t    2. **can_cast** — ask the card whether it can legally be cast.\n143\t    3. **Hand check** — the card must be in the player's hand.\n144\t    4. **Move hand → stack zone** — remove the card from the hand and\n145\t       place it into the player's stack zone.\n146\t    5. **Choose targets** — if the card specifies targets (via\n147\t       :meth:`CardImpl.get_targets`), the player is asked to choose.\n148\t    6. **Mana check / payment** — the player's mana pool must be able to\n149\t       pay the card's mana cost.  If payment fails, the card is rolled\n150\t       back from the stack zone to the hand.\n151\t    7. **Call on_cast** — invoke the card's ``on_cast`` hook.\n152\t    8. **Push StackObject** — push a :class:`StackObject` whose\n153\t       ``on_resolve`` callback handles resolution.\n154\t\n155\t    Raises:\n156\t        CastingError: If any legality check fails.\n157\t    \"\"\"\n158\t    # 1. Timing\n159\t    if not can_cast_at_instant_speed(card) and not is_sorcery_speed(game, player):\n160\t        raise CastingError(\n161\t            f\"Cannot cast {card.name!r} — sorcery-speed timing not met\"\n162\t        )\n163\t\n164\t    # 2. can_cast\n165\t    if not card.can_cast(game):\n166\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n167\t\n168\t    # 3. Hand check\n169\t    hand = game.get_hand(player)\n170\t    if not hand.contains(card):\n171\t        raise CastingError(f\"Cannot cast {card.name!r} — card not in hand\")\n172\t\n173\t    # 4. Move card from hand to stack zone\n174\t    stack_zone = player.zones[Zone.STACK]\n175\t    hand.remove(card)\n176\t    stack_zone.add(card)\n177\t\n178\t    # Clear any stale colors_spent from a prior cast before new payment.\n179\t    if hasattr(card, \"colors_spent\"):\n180\t        del card.colors_spent\n181\t\n182\t    # 5. Choose targets\n183\t    target_specs = card.get_targets(game)\n184\t    chosen_targets: list[Any] = []\n185\t    if target_specs:\n186\t        for spec in target_specs:\n187\t            target = player.choose_target(target_specs, spec)\n188\t            # Validate against filter_fn if the spec provides one\n189\t            filter_fn = getattr(spec, \"filter_fn\", None)\n190\t            if filter_fn is not None and target is not None:\n191\t                if not filter_fn(target):\n192\t                    stack_zone.remove(card)\n193\t                    hand.add(card)\n194\t                    raise CastingError(\n195\t                        f\"Cannot cast {card.name!r} — chosen target does not \"\n196\t                        f\"satisfy filter: {getattr(spec, 'description', '')}\"\n197\t                    )\n198\t            chosen_targets.append(target)\n199\t\n200\t    # 5b. Protection check — reject targets that have protection from this\n201\t    #     spell (the T in DEBT).\n202\t    from engine.protection import has_protection_from\n203\t\n204\t    for target in chosen_targets:\n205\t        if has_protection_from(target, card):\n206\t            # Rollback: move card from stack zone back to hand\n207\t            stack_zone.remove(card)\n208\t            hand.add(card)\n209\t            raise CastingError(\n210\t                f\"Cannot cast {card.name!r} — target has protection from this spell\"\n211\t            )\n212\t\n213\t    # Targets are stored on the StackObject (not the card) and passed\n214\t    # through the resolve pipeline via on_resolve(game, targets=...).\n215\t\n216\t    # 6. Mana check / payment (rollback on failure)\n217\t    # Ensure the card knows its controller so that cost_reduction() hooks\n218\t    # (e.g. Embercleave counting attacking creatures you control) see the\n219\t    # casting player, even for cards that were added to hand without an\n220\t    # explicit controller assignment.\n221\t    if card.controller is None:\n222\t        card.controller = player\n223\t    reduction = get_cost_reduction(game, card, player)\n224\t    effective_cost = _apply_cost_reduction(card.mana_cost, reduction) if reduction > 0 else card.mana_cost\n225\t\n226\t    if not player.mana_pool.can_pay(effective_cost):\n227\t        # Rollback: move card from stack zone back to hand\n228\t        stack_zone.remove(card)\n229\t        hand.add(card)\n230\t        raise CastingError(f\"Cannot cast {card.name!r} — insufficient mana\")\n231\t\n232\t    # TODO: Phase 3 — support player choice for generic mana payment to optimize Converge color count\n233\t    player.mana_pool.pay(effective_cost)\n234\t\n235\t    # Store colors of mana spent on the card for mechanics like Converge\n236\t    # that care about the colors used to cast the spell.\n237\t    card.colors_spent = list(player.mana_pool.last_payment_colors)  # type: ignore[attr-defined]\n238\t\n239\t    # 7. Call on_cast hook\n240\t    card.on_cast(game)\n241\t\n242\t    # 8. Build on_resolve callback and push StackObject\n243\t    stack_obj = StackObject(\n244\t        source=card,\n245\t        controller=player,\n246\t        targets=chosen_targets,\n247\t        on_resolve=lambda g: None,  # replaced below\n248\t    )\n249\t\n250\t    def _on_resolve(g: GameState) -> None:\n251\t        _resolve_spell(g, card, player, stack_obj)\n252\t\n253\t    stack_obj.on_resolve = _on_resolve\n254\t    game.stack.push(stack_obj)\n255\t\n256\t\n257\t# ------------------------------------------------------------------\n258\t# Cast spell without paying mana cost (free-cast from any zone)\n259\t# ------------------------------------------------------------------\n260\t\n261\t\n262\tdef cast_spell_free(\n263\t    game: GameState,\n264\t    player: Player,\n265\t    card: CardImpl,\n266\t    from_zone: Zone,\n267\t) -> None:\n268\t    \"\"\"Cast *card* without paying its mana cost, using the stack.\n269\t\n270\t    This is used by effects that allow casting from zones other than hand\n271\t    (e.g. exile) without paying mana costs — such as Etali, Primal Storm\n272\t    or cascade.\n273\t\n274\t    Pipeline\n275\t    --------\n276\t    1. **can_cast** — ask the card whether it can legally be cast (same\n277\t       legality as :func:`cast_spell`, minus mana/timing constraints).\n278\t    2. Move *card* from *from_zone* to the stack zone.\n279\t    3. Choose targets (if applicable) with validation and protection check.\n280\t    4. Call ``on_cast`` hook.\n281\t    5. Push a :class:`StackObject` whose ``on_resolve`` callback handles\n282\t       resolution normally (permanents → battlefield, non-permanents →\n283\t       graveyard).\n284\t\n285\t    No timing check or mana payment is performed.  The spell goes on the\n286\t    stack and can be responded to normally (e.g. countered).\n287\t\n288\t    If targeting or other post-move checks fail, the card is rolled back\n289\t    to its source zone.\n290\t\n291\t    Parameters:\n292\t        game: The current game state.\n293\t        player: The player casting the spell.\n294\t        card: The card to cast.\n295\t        from_zone: The zone the card is currently in.\n296\t\n297\t    Raises:\n298\t        CastingError: If the card cannot be found in *from_zone* or\n299\t            legality checks fail.\n300\t    \"\"\"\n301\t    from engine.zones import move_to_zone\n302\t\n303\t    # Ensure controller is set\n304\t    card.controller = player\n305\t    if card.owner is None:\n306\t        card.owner = player\n307\t\n308\t    # 1. can_cast legality (same as cast_spell but skipping mana/timing)\n309\t    if not card.can_cast(game):\n310\t        raise CastingError(f\"Cannot cast {card.name!r} — can_cast returned False\")\n311\t\n312\t    # 2. Locate card in source zone\n313\t    source_zone_container = player.zones[from_zone]\n314\t    if not source_zone_container.contains(card):\n315\t        # Try to find the card in any player's zone\n316\t        source_zone_container = None\n317\t        for p in game.players:\n318\t            z = p.zones[from_zone]\n319\t            if z.contains(card):\n320\t                source_zone_container = z\n321\t                break\n322\t\n323\t    if source_zone_container is None or not source_zone_container.contains(card):\n324\t        raise CastingError(\n325\t            f\"Cannot cast {card.name!r} — card not found in {from_zone.name}\"\n326\t        )\n327\t\n328\t    # Move card from source zone to stack zone\n329\t    stack_zone = player.zones[Zone.STACK]\n330\t    source_zone_container.remove(card)\n331\t    stack_zone.add(card)\n332\t\n333\t    # 3. Choose targets (with rollback on failure)\n334\t    try:\n335\t        target_specs = card.get_targets(game)\n336\t        chosen_targets: list[Any] = []\n337\t        if target_specs:\n338\t            for spec in target_specs:\n339\t                target = player.choose_target(target_specs, spec)\n340\t                # Validate against filter_fn if the spec provides one\n341\t                filter_fn = getattr(spec, \"filter_fn\", None)\n342\t                if filter_fn is not None and target is not None:\n343\t                    if not filter_fn(target):\n344\t                        raise CastingError(\n345\t                            f\"Cannot cast {card.name!r} — chosen target does not \"\n346\t                            f\"satisfy filter: {getattr(spec, 'description', '')}\"\n347\t                        )\n348\t                chosen_targets.append(target)\n349\t\n350\t        # Protection check — reject targets that have protection from this spell\n351\t        from engine.protection import has_protection_from\n352\t\n353\t        for target in chosen_targets:\n354\t            if has_protection_from(target, card):\n355\t                raise CastingError(\n356\t                    f\"Cannot cast {card.name!r} — target has protection from this spell\"\n357\t                )\n358\t    except Exception as exc:\n359\t        # Rollback: move card from stack zone back to source zone\n360\t        stack_zone.remove(card)\n361\t        source_zone_container.add(card)\n362\t        raise CastingError(str(exc)) from exc\n363\t\n364\t    # 4. Call on_cast hook\n365\t    card.on_cast(game)\n366\t\n367\t    # 5. Build on_resolve callback and push StackObject\n368\t    stack_obj = StackObject(\n369\t        source=card,\n370\t        controller=player,\n371\t        targets=chosen_targets,\n372\t        on_resolve=lambda g: None,  # replaced below\n373\t    )\n374\t\n375\t    def _on_resolve(g: GameState) -> None:\n376\t        _resolve_spell(g, card, player, stack_obj)\n377\t\n378\t    stack_obj.on_resolve = _on_resolve\n379\t    game.stack.push(stack_obj)\n380\t\n381\t\n382\t# ------------------------------------------------------------------\n383\t# Resolution (called when the stack pops)\n384\t# ------------------------------------------------------------------\n385\t\n386\tdef _resolve_spell(\n387\t    game: GameState,\n388\t    card: CardImpl,\n389\t    player: Player,\n390\t    stack_obj: StackObject,\n391\t) -> None:\n392\t    \"\"\"Resolve *card* cast by *player*.\n393\t\n394\t    1. Call ``card.on_resolve(game, targets=targets)``.\n395\t    2. Remove the card from the stack zone.\n396\t    3. If the card is a permanent type, move it to the battlefield via\n397\t       :func:`~engine.zones.move_to_zone` (which handles trigger/effect\n398\t       registration and the ETB event).\n399\t    4. Otherwise (instant / sorcery), move it to the owner's graveyard.\n400\t    \"\"\"\n401\t    from engine.zones import move_to_zone\n402\t\n403\t    # Read targets from the StackObject — the single source of truth.\n404\t    # Set chosen_targets on the card just before resolution so that\n405\t    # _get_chosen_target helpers (which read via getattr) work.\n406\t    targets = stack_obj.targets\n407\t    if targets is not None:\n408\t        card.chosen_targets = targets  # type: ignore[attr-defined]\n409\t\n410\t    card.on_resolve(game)\n411\t\n412\t    if card.card_types & _PERMANENT_TYPES:\n413\t        # Move from stack to battlefield via move_to_zone, which handles\n414\t        # trigger/replacement-effect registration and ENTERS_BATTLEFIELD event.\n415\t        move_to_zone(game, card, Zone.STACK, Zone.BATTLEFIELD)\n416\t    else:\n417\t        # Instant/sorcery: move from stack to graveyard via move_to_zone.\n418\t        move_to_zone(game, card, Zone.STACK, Zone.GRAVEYARD)\n419\t\n420\t\n421\t# ------------------------------------------------------------------\n422\t# Play land (special action — does not use the stack)\n423\t# ------------------------------------------------------------------\n424\t\n425\tdef play_land(game: GameState, player: Player, land_card: CardImpl) -> None:\n426\t    \"\"\"Play *land_card* from *player*'s hand onto the battlefield.\n427\t\n428\t    Requirements (all must hold):\n429\t\n430\t    * *land_card* has :attr:`CardType.LAND`.\n431\t    * *player* is the active player.\n432\t    * Current phase is a main phase.\n433\t    * The stack is empty.\n434\t    * ``player.land_plays_remaining > 0``.\n435\t    * The card is in the player's hand.\n436\t\n437\t    On success the card moves from hand to battlefield and\n438\t    ``land_plays_remaining`` is decremented.\n439\t\n440\t    Raises:\n441\t        CastingError: If any requirement is not met.\n442\t    \"\"\"\n443\t    # Must be a land\n444\t    if CardType.LAND not in land_card.card_types:\n445\t        raise CastingError(\n446\t            f\"Cannot play {land_card.name!r} as a land — not a land card\"\n447\t        )\n448\t\n449\t    # Sorcery-speed timing (active player, main phase, stack empty)\n450\t    if not is_sorcery_speed(game, player):\n451\t        raise CastingError(\n452\t            f\"Cannot play land {land_card.name!r} — must be active player \"\n453\t            \"during main phase with empty stack\"\n454\t        )\n455\t\n456\t    # Land plays remaining\n457\t    if player.land_plays_remaining <= 0:\n458\t        raise CastingError(\n459\t            f\"Cannot play land {land_card.name!r} — no land plays remaining\"\n460\t        )\n461\t\n462\t    # Card must be in hand\n463\t    hand = game.get_hand(player)\n464\t    if not hand.contains(land_card):\n465\t        raise CastingError(\n466\t            f\"Cannot play land {land_card.name!r} — card not in hand\"\n467\t        )\n468\t\n469\t    # Ensure owner/controller are set so move_to_zone routes correctly.\n470\t    if land_card.owner is None:\n471\t        land_card.owner = player\n472\t    land_card.controller = player\n473\t\n474\t    # Move from hand to battlefield via move_to_zone, which fires\n475\t    # ENTERS_BATTLEFIELD and registers triggers/replacement effects.\n476\t    from engine.zones import move_to_zone\n477\t    move_to_zone(game, land_card, Zone.HAND, Zone.BATTLEFIELD)\n478\t\n479\t    # Decrement land plays\n480\t    player.land_plays_remaining -= 1\n481\t\n482\t\n483\tdef resolve_top(game: GameState) -> None:\n484\t    \"\"\"Resolve the top spell/ability on the stack.\n485\t\n486\t    Pops the top item from the stack, calls its on_resolve callback,\n487\t    then runs state-based actions.  If the stack is empty this is a no-op.\n488\t    \"\"\"\n489\t    if game.stack.is_empty():\n490\t        return\n491\t    from engine.state_based_actions import resolve_state_based_actions\n492\t\n493\t    obj = game.stack.pop()\n494\t    obj.on_resolve(game)\n495\t    resolve_state_based_actions(game)\n496\t"}]},"parent_tool_use_id":"toolu_01EQsQV6bKSgGXoWTWADzHzM","session_id":"1fe34661-6a3c-4b16-8a42-0f618466dfcb","uuid":"391a0df4-00fd-4af6-9daa-9097584e4103","timestamp":"2026-05-28T10:31:12.214Z","subagent_type":"Reviewer","task_description":"Review sos_245 implementation"}
