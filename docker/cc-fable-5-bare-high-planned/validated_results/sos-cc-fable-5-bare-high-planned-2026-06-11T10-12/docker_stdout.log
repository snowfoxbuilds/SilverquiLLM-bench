{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_01PgGDFZ4MJzt4Ud3WChySJT","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01BG5DN3gdeAvYboEgFTSBoB","name":"Bash","input":{"command":"python3 - <<'EOF'\n# Throwaway smoke (sos_120): a Paradigm copy-cast is a *cast* — it triggers\n# spell-cast watchers (e.g. an animated Great Hall pump), and the copy's own\n# resolution doesn't double-register the paradigm trigger.\nfrom cards.sos.sos_120.card_impl import ImprovisationCapstone\nfrom engine.casting import resolve_top\nfrom engine.events import BeginningOfPrecombatMainTriggeredEvent, SpellCastTriggeredEvent\nfrom engine.triggers import TriggerRegistration\nfrom engine.types import ManaType, Phase, Zone\nfrom test_utils import advance_to_phase, create_game, cast_spell, set_board_state\n\ngame = create_game()\np1 = game.players[0]\ncap = ImprovisationCapstone(owner=p1)\nset_board_state(game, 0, hand=[cap], mana={ManaType.RED: 2, ManaType.COLORLESS: 5})\ncasts = []\ngame.trigger_manager.register(TriggerRegistration(\n    event_type=SpellCastTriggeredEvent,\n    condition=lambda g, e: casts.append(e.card.name) or False,\n    effect=lambda g: None, source=object(), controller=p1))\ncast_spell(game, 0, \"Improvisation Capstone\")\nassert casts == [\"Improvisation Capstone\"], casts\n\nadvance_to_phase(game, Phase.POSTCOMBAT_MAIN)\nadvance_to_phase(game, Phase.PRECOMBAT_MAIN)   # turn 2 (p2)\nadvance_to_phase(game, Phase.POSTCOMBAT_MAIN)\nadvance_to_phase(game, Phase.PRECOMBAT_MAIN)   # turn 3 (p1)\np1._script.append(True)\nresolve_top(game)  # paradigm trigger -> copy pushed + cast event fired\nassert casts == [\"Improvisation Capstone\", \"Improvisation Capstone\"], casts\nresolve_top(game)  # copy resolves (empty library, nothing to exile)\n# paradigm trigger registered exactly once\nn = sum(1 for t in game.trigger_manager.get_triggers()\n        if t.event_type is BeginningOfPrecombatMainTriggeredEvent and t.source is not None and getattr(t.source, \"name\", \"\") == \"Improvisation Capstone\")\nassert n == 1, n\nprint(\"smoke OK: copy-cast fires cast event; no double paradigm registration\")\nEOF\npython3 -m pytest engine_tests/ -q 2>&1 | tail -1","description":"Smoke checks for sos_120 and guard"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":167,"cache_read_input_tokens":237237,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":167},"output_tokens":68,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"98b35815-b35f-4b80-bf9f-66c04f25a22f","uuid":"f15c00c2-9154-456b-befa-9dbfe320301c","request_id":"req_011CbwL6LhDg5ns8fXHFtjg4"}
