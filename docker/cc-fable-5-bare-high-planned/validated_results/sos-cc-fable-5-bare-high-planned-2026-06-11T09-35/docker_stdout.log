t.extend([junk, True])\ngame3.trigger_manager.fire_event(game3, BeginningOfUpkeepTriggeredEvent())\n_resolve_all(game3)\nassert p1.life == 22 and p1.zones[Zone.GRAVEYARD].contains(zap2)\nprint('loot-miracle OK')\n\" && python3 -m pytest engine_tests/ cards/ -q 2>&1 | tail -1","description":"Smoke checks sos_201"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":3000,"cache_creation_input_tokens":559,"cache_read_input_tokens":268099,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":559},"output_tokens":45,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2cbc3e54-8234-4118-a40c-c107afe702c2","uuid":"71576721-2ac2-423b-b130-e194f17e6ec9","request_id":"req_011CbwHZeyxWUyTr5qLngJkU"}
