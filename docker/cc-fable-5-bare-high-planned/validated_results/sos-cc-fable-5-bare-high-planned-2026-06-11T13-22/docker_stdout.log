eswalker(name=\"TestWalker\", starting_loyalty=5)\n566:            loyalty_cost=-3,\n570:        assert pw.loyalty == 2\n572:    def test_negative_cost_exact_loyalty(self):\n573:        \"\"\"Using -N when loyalty == N should succeed and set loyalty to 0.\"\"\"\n576:        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=4)\n580:            loyalty_cost=-4,\n584:        assert pw.loyalty == 0\n586:    def test_insufficient_loyalty_raises(self):\n587:        \"\"\"Cannot activate −N if source loyalty < N.\"\"\"\n590:        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=2)\n594:            loyalty_cost=-5,\n597:        with pytest.raises(AbilityError, match=\"insufficient loyalty\"):\n600:    def test_insufficient_loyalty_no_stack_entry(self):\n603:        pw = Planeswalker(name=\"TestWalker\", starting_loyalty=1)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
