kGuestLecturer()\nclass EtbWatcher(Creature):\n    def __init__(self, **kw):\n        kw.setdefault(\"name\", \"Watcher\"); kw.setdefault(\"mana_cost\", ManaCost.parse(\"{2}\"))\n        kw.setdefault(\"base_power\", 2); kw.setdefault(\"base_toughness\", 2)\n        super().__init__(**kw)\n    def register_triggers(self, game):\n        self.registered = True\nw = EtbWatcher()\nset_board_state(game2, 0, battlefield=[pw2], graveyard=[w])\ngame2.phase = Phase.PRECOMBAT_MAIN; game2.step = None\nab2 = pw2.get_loyalty_abilities()[2]\nactivate_ability(game2, q1, LoyaltyAbilityInstance(source=pw2, controller=q1,\n    loyalty_cost=ab2.loyalty_cost, effect=ab2.effect, targets=[w]))\npriority_loop(game2)\nassert q1.zones[Zone.BATTLEFIELD].contains(w)\nassert getattr(w, \"registered\", False), \"ETB registration must run on reanimation\"\nprint(\"sos_97 smoke OK: X=0 skips nothing; reanimation goes through move_to_zone hooks\")\nEOF","description":"Smoke check sos_97 edge cases"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":221,"cache_read_input_tokens":287452,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":221},"output_tokens":57,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"48c64ad6-6cc1-42f5-b9d5-9bf108646c5b","uuid":"3ddc31e8-80c6-46c0-8d7d-a0bdd549c3c3","request_id":"req_011CbwbWi5FpFvhD2bDPHSCQ"}
