-    from engine.combat import (
-        combat_damage_step,
-        declare_attackers_step,
-        declare_blockers_step,
-        end_combat_step,
-    )
-
-    if step == Step.DECLARE_ATTACKERS:
-        declare_attackers_step(game)
-    elif step == Step.DECLARE_BLOCKERS:
