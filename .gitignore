.env
.workspace/
__pycache__/
*.egg-info/
.ruff_cache/
dist/
build/
*.pyc
config.yaml
replay_page*


# Scryfall cache data
data/sets/*.json
# ...except the pinned HOB Draft Set: it is the committed, contamination-fresh
# source every HOB benchmark derives its pool from (scripts/fetch_hob_set.py).
!data/sets/hob.json
.review-venv/
dist-review/
data/replays/*
!data/replays/golden/

.opencode

venv/

.DS_Store

docker/*/results/
# Contract Run artifacts (job dir, driver repo, workspace_final, evidence):
# runs/<candidate>/<run-id>/ — heavy, never committed; records go to the
# results repo.
runs/

aggregated_results.csv

validation.json

benchmarks/*/analysis/*.json
benchmarks/*/analysis/*.md

# Batch queue: batch files are the operator's desired state (commit them or not,
# your call); the scheduler's observed state and its lock are local.
batches/state/
batches/.scheduler.lock
