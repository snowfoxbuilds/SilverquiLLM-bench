.env
.workspace/
__pycache__/
*.egg-info/
.ruff_cache/
dist/
build/
*.pyc
config.yaml
replay_page*


# Scryfall cache data
data/sets/*.json
# ...except the pinned HOB Draft Set: it is the committed, contamination-fresh
# source every HOB benchmark derives its pool from (scripts/fetch_hob_set.py).
!data/sets/hob.json
.review-venv/
dist-review/
data/replays/*
!data/replays/golden/

.opencode

venv/

.DS_Store

docker/*/results/
# Contract Run artifacts (job dir, driver repo, workspace_final, evidence):
# runs/<candidate>/<run-id>/ — heavy, never committed; records go to the
# results repo.
runs/

aggregated_results.csv

validation.json

benchmarks/*/analysis/*.json
benchmarks/*/analysis/*.md

# Batch queue: batch files and the scheduler's committed observed state
# (batches/state/<id>.json — portable, no host-local data) are tracked; the
# operator commits state checkpoints. The lock, the host-local runtime
# metadata (container name, pid, hostname of the run in flight) and the
# atomic-write temp files are never committed.
batches/.scheduler.lock
batches/runtime/
batches/state/.*

# Promotion staging (candidates/.promote-<slug>-<nonce>/) is removed before
# promote exits; when that removal fails, the loud error keeps the tree for
# inspection — it may hold the very content promotion refused (a rejected
# credential value included), so it is never committed.
candidates/.promote-*
